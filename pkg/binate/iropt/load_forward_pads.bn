package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/std/cmp"
import "pkg/std/table"
import "pkg/std/vec"

// Fault-pad dominance for load-forwarding: a slot whose cleanup pad loads it is
// forwarded only if its single store dominates every fault point that lands in
// that pad, so the pad provably reads the stored value.

// padFaultSites lists, for each fault pad, the fault points in f.Blocks that land
// in it: blks[p][k] / poss[p][k] is the block index / position of the k-th op
// whose PadBlock is f.FaultPads[p].
type padFaultSites struct {
	blks @[]@[]int
	poss @[]@[]int
}

// buildPadFaultSites collects every pad's fault points in one pass over f.Blocks
// (pads are matched by pointer identity: a `@Block` and a faulting op's `*Block`
// back-ref bit_cast to the same payload address).
func buildPadFaultSites(f @ir.Func) @padFaultSites {
	var np int = len(f.FaultPads)
	var ps @padFaultSites = make(padFaultSites)
	ps.blks = make_slice(@[]int, np)
	ps.poss = make_slice(@[]int, np)
	if np == 0 {
		return ps
	}
	var padIdx @table.Table[int, int, ir.AddrHasher, cmp.Default[int]] = table.NewTable[int, int,
			ir.AddrHasher, cmp.Default[int]](
					ir.AddrHasher{}, cmp.Default[int]{})
	for pi := 0; pi < np; pi++ {
		padIdx.Put(bit_cast(int, f.FaultPads[pi]), pi)
	}
	var blks @[]@vec.Vec[int] = make_slice(@vec.Vec[int], np)
	var poss @[]@vec.Vec[int] = make_slice(@vec.Vec[int], np)
	for pi := 0; pi < np; pi++ {
		blks[pi] = vec.New[int]()
		poss[pi] = vec.New[int]()
	}
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var pad *ir.Block = blk.Instrs[ii].PadBlock
			if pad == nil {
				continue
			}
			var pi int
			var ok bool
			pi, ok = padIdx.Get(bit_cast(int, pad))
			if ok {
				blks[pi].Push(bi)
				poss[pi].Push(ii)
			}
		}
	}
	for pi := 0; pi < np; pi++ {
		ps.blks[pi] = blks[pi].Items()
		ps.poss[pi] = poss[pi].Items()
	}
	return ps
}

// storeDominatesPad reports whether the store at (storeBlk, storePos) dominates
// every fault point that lands in pad P = f.FaultPads[padIdx] — each faulting op
// in f.Blocks whose PadBlock is P (see buildPadFaultSites).  Required so the pad's forwarded
// load provably reads the stored value, not the zero-filled slot.  Returns false
// (bail) if P has no locatable fault point, or any is not dominated.
func storeDominatesPad(ps @padFaultSites, d @DomInfo, storeBlk int, storePos int, padIdx int) bool {
	var blks @[]int = ps.blks[padIdx]
	var poss @[]int = ps.poss[padIdx]
	for k := 0; k < len(blks); k++ {
		if blks[k] == storeBlk {
			if poss[k] <= storePos {
				return false // fault point at/before the store
			}
		} else if !d.Dominates(storeBlk, blks[k]) {
			return false
		}
	}
	return len(blks) > 0
}
