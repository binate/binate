package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/std/cmp"
import "pkg/std/table"
import "pkg/std/vec"

// Fault-pad dominance for load-forwarding: a slot whose cleanup pad loads it is
// forwarded only if its single store dominates every fault point from which that
// pad can run, so the pad provably reads the stored value.  A pad block runs for
// its own fault points and for those of every pad block that jumps or branches
// into it: an inlined callee's pad chains into its call site's pad, and a
// multi-block pad's later blocks are entered from its first.

// padFaultSites lists, for each fault pad block, the fault points in f.Blocks that
// land in it directly — blks[p][k] / poss[p][k] is the block index / position of
// the k-th op whose PadBlock is f.FaultPads[p] — and preds[p], the pad blocks that
// jump or branch to it.  mark / stamp are storeDominatesPad's visited set — a pad
// block p was visited by the current query when mark[p] == stamp — and work its
// stack of pad blocks still to visit.
type padFaultSites struct {
	blks  @[]@[]int
	poss  @[]@[]int
	preds @[]@[]int
	mark  @[]int
	stamp int
	work  @vec.Vec[int]
}

// buildPadFaultSites collects every pad block's direct fault points in one pass over
// f.Blocks, and the pad-to-pad edges from each pad block's terminator (pads are
// matched by pointer identity: a `@Block` and a faulting op's `*Block` back-ref
// bit_cast to the same payload address).
func buildPadFaultSites(f @ir.Func) @padFaultSites {
	var np int = len(f.FaultPads)
	var ps @padFaultSites = make(padFaultSites)
	ps.blks = make_slice(@[]int, np)
	ps.poss = make_slice(@[]int, np)
	ps.preds = make_slice(@[]int, np)
	ps.mark = make_slice(int, np)
	ps.work = vec.New[int]()
	if np == 0 {
		return ps
	}
	var padIdx @table.Table[int, int, ir.AddrHasher, cmp.Default[int]] = table.NewTable[int, int,
			ir.AddrHasher, cmp.Default[int]](
					ir.AddrHasher{}, cmp.Default[int]{})
	for pi := 0; pi < np; pi++ {
		padIdx.Put(bit_cast(int, f.FaultPads[pi]), pi)
	}
	var blks @[]@vec.Vec[int] = make_slice(@vec.Vec[int], np)
	var poss @[]@vec.Vec[int] = make_slice(@vec.Vec[int], np)
	for pi := 0; pi < np; pi++ {
		blks[pi] = vec.New[int]()
		poss[pi] = vec.New[int]()
	}
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var pad *ir.Block = blk.Instrs[ii].PadBlock
			if pad == nil {
				continue
			}
			var pi int
			var ok bool
			pi, ok = padIdx.Get(bit_cast(int, pad))
			if ok {
				blks[pi].Push(bi)
				poss[pi].Push(ii)
			}
		}
	}
	// The pad-to-pad edges, every way the VM enters one pad block from another: a
	// terminator's targets inside FaultPads, the next pad block when a pad block ends
	// without a terminator (the VM runs into the block after it, as VM lowering lays
	// FaultPads out), and a fault op inside a pad block landing in another.
	var preds @[]@vec.Vec[int] = make_slice(@vec.Vec[int], np)
	for pi := 0; pi < np; pi++ {
		preds[pi] = vec.New[int]()
	}
	for pi := 0; pi < np; pi++ {
		var pad @ir.Block = f.FaultPads[pi]
		for ii := 0; ii < len(pad.Instrs); ii++ {
			var tp int = padIndexOf(padIdx, pad.Instrs[ii].PadBlock)
			if tp >= 0 {
				preds[tp].Push(pi)
			}
		}
		var n int = len(pad.Instrs)
		if n == 0 || !isBlockTerminator(pad.Instrs[n - 1].Op) {
			if pi + 1 < np {
				preds[pi + 1].Push(pi)
			}
			continue
		}
		var term @ir.Instr = pad.Instrs[n - 1]
		var t1 int = padIndexOf(padIdx, term.Block1)
		var t2 int = padIndexOf(padIdx, term.Block2)
		if t1 >= 0 {
			preds[t1].Push(pi)
		}
		if t2 >= 0 && t2 != t1 {
			preds[t2].Push(pi)
		}
	}
	for pi := 0; pi < np; pi++ {
		ps.blks[pi] = blks[pi].Items()
		ps.poss[pi] = poss[pi].Items()
		ps.preds[pi] = preds[pi].Items()
	}
	return ps
}

// isBlockTerminator reports whether op ends a block without running into the next:
// a jump, a branch, a return, an unwind or an unreachable.
func isBlockTerminator(op int) bool {
	return op == iropcode.OP_JUMP || op == iropcode.OP_BRANCH || op == iropcode.OP_RETURN ||
			op == iropcode.OP_UNWIND_RETURN || op == iropcode.OP_UNREACHABLE
}

// padIndexOf returns the FaultPads index padIdx records for block b, or -1 when b
// is nil or not a fault pad block.
func padIndexOf(padIdx @table.Table[int, int, ir.AddrHasher, cmp.Default[int]], b *ir.Block) int {
	if b == nil {
		return -1
	}
	var pi int
	var ok bool
	pi, ok = padIdx.Get(bit_cast(int, b))
	if !ok {
		return -1
	}
	return pi
}

// storeDominatesPad reports whether the store at (storeBlk, storePos) dominates
// every fault point from which pad block P = f.FaultPads[padIdx] can run: P's own
// fault points and, transitively, those of every pad block that enters P (see
// buildPadFaultSites).  Required so the pad's forwarded load provably reads the
// stored value, not the zero-filled slot.  A pad block no fault point reaches —
// every op that landed in it removed, as an inlined call's is when its callee has
// no fault op of its own — never runs, so any store dominates it.
func storeDominatesPad(ps @padFaultSites, d @DomInfo, storeBlk int, storePos int, padIdx int) bool {
	ps.stamp = ps.stamp + 1
	for ps.work.Len() > 0 {
		_, _ = ps.work.Pop() // left over by a query that returned early
	}
	ps.work.Push(padIdx)
	for ps.work.Len() > 0 {
		var p int
		p, _ = ps.work.Pop()
		if ps.mark[p] == ps.stamp {
			continue
		}
		ps.mark[p] = ps.stamp
		var blks @[]int = ps.blks[p]
		var poss @[]int = ps.poss[p]
		for k := 0; k < len(blks); k++ {
			if blks[k] == storeBlk {
				if poss[k] <= storePos {
					return false // fault point at/before the store
				}
			} else if !d.Dominates(storeBlk, blks[k]) {
				return false
			}
		}
		for k := 0; k < len(ps.preds[p]); k++ {
			ps.work.Push(ps.preds[p][k])
		}
	}
	return true
}
