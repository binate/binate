package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for load-forwarding's pad fault-site table (load_forward_pads.bn).

// entry: c0, c1, bounds-check(c0, c1) -> pad; jump next.  next: bounds-check -> pad;
// return.  pad2 has no fault point.
func padSitesFunc() (@ir.Func, @ir.Block, @ir.Block) {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var next @ir.Block = ir.AddBlock(f, "next")
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	irbuild.EmitUnwindReturn(pad)
	var pad2 @ir.Block = ir.AddFaultPad(f, "pad2")
	irbuild.EmitUnwindReturn(pad2)
	var c0 @ir.Instr = irbuild.EmitConstInt(entry, 0, types.TypInt())
	var c1 @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	irbuild.EmitBoundsCheck(entry, c0, c1)
	entry.Instrs[2].PadBlock = pad
	irbuild.EmitJump(entry, next)
	irbuild.EmitBoundsCheck(next, c0, c1)
	next.Instrs[0].PadBlock = pad
	irbuild.EmitReturn(next, noArgs)
	return f, pad, pad2
}

func TestPadFaultSitesCollected() testing.TestResult {
	var f @ir.Func
	var pad @ir.Block
	var pad2 @ir.Block
	f, pad, pad2 = padSitesFunc()
	var ps @padFaultSites = buildPadFaultSites(f)
	if len(ps.blks) != 2 { return fail("one entry per fault pad") }
	if len(ps.blks[0]) != 2 { return fail("pad has two fault points") }
	if ps.blks[0][0] != 0 || ps.poss[0][0] != 2 { return fail("first fault point at entry[2]") }
	if ps.blks[0][1] != 1 || ps.poss[0][1] != 0 { return fail("second fault point at next[0]") }
	if len(ps.blks[1]) != 0 { return fail("pad2 has no fault point") }
	if pad == nil || pad2 == nil { return fail("setup") }
	return ""
}

func TestStoreDominatesPad() testing.TestResult {
	var f @ir.Func
	var pad @ir.Block
	var pad2 @ir.Block
	f, pad, pad2 = padSitesFunc()
	var ps @padFaultSites = buildPadFaultSites(f)
	var d @DomInfo = ComputeDom(f)
	if !storeDominatesPad(ps, d, 0, 1, 0) {
		return fail("a store at entry[1] precedes both fault points")
	}
	if storeDominatesPad(ps, d, 0, 2, 0) {
		return fail("a store at entry[2] is not before entry[2]'s fault")
	}
	if storeDominatesPad(ps, d, 1, 0, 0) {
		return fail("a store in next does not dominate entry's fault")
	}
	if !storeDominatesPad(ps, d, 0, 0, 1) {
		return fail("a pad no fault point reaches never runs, so any store dominates it")
	}
	if pad == nil || pad2 == nil { return fail("setup") }
	return ""
}

// entry: c0, c1, bounds-check -> padA; jump next.  next: c2, bounds-check -> padB;
// return.  padA jumps to padB (as an inlined callee's pad chains into its call
// site's), padB jumps to padC (a later block of the same pad), and padD is entered
// from nowhere.  FaultPads order: padB, padC, padA, padD.
func padChainFunc() @ir.Func {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var next @ir.Block = ir.AddBlock(f, "next")
	var padB @ir.Block = ir.AddFaultPad(f, "padB")
	var padC @ir.Block = ir.AddFaultPad(f, "padC")
	var padA @ir.Block = ir.AddFaultPad(f, "padA")
	var padD @ir.Block = ir.AddFaultPad(f, "padD")
	irbuild.EmitJump(padA, padB)
	irbuild.EmitJump(padB, padC)
	irbuild.EmitUnwindReturn(padC)
	irbuild.EmitUnwindReturn(padD)
	var c0 @ir.Instr = irbuild.EmitConstInt(entry, 0, types.TypInt())
	var c1 @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	irbuild.EmitBoundsCheck(entry, c0, c1)
	entry.Instrs[2].PadBlock = padA
	irbuild.EmitJump(entry, next)
	_ = irbuild.EmitConstInt(next, 2, types.TypInt())
	irbuild.EmitBoundsCheck(next, c0, c1)
	next.Instrs[1].PadBlock = padB
	irbuild.EmitReturn(next, noArgs)
	return f
}

// A pad block runs for the fault points of the pad blocks entering it too: a store
// that dominates padB's own fault point but not that of padA, which chains into
// padB, does not dominate padB; padC, with no fault point of its own, is dominated
// when the fault points reaching it through padB are; padD, reached by none,
// never runs, so any store dominates it.
func TestStoreDominatesPadThroughChains() testing.TestResult {
	var f @ir.Func = padChainFunc()
	var ps @padFaultSites = buildPadFaultSites(f)
	var d @DomInfo = ComputeDom(f)
	if len(ps.preds[0]) != 1 || ps.preds[0][0] != 2 { return fail("padA enters padB") }
	if len(ps.preds[1]) != 1 || ps.preds[1][0] != 0 { return fail("padB enters padC") }
	if storeDominatesPad(ps, d, 1, 0, 0) {
		return fail("a store in next does not dominate padA's fault point, which reaches padB")
	}
	if !storeDominatesPad(ps, d, 0, 1, 0) { return fail("a store at entry[1] dominates padB") }
	if !storeDominatesPad(ps, d, 0, 1, 1) {
		return fail("padC is dominated when every fault point reaching it through padB is")
	}
	if storeDominatesPad(ps, d, 1, 0, 1) { return fail("nor padC by a store padA's fault precedes") }
	if !storeDominatesPad(ps, d, 1, 0, 3) { return fail("padD, which never runs, is dominated") }
	return ""
}

// entry: c0, c1, bounds-check -> padE; return.  padE branches to padF or padG,
// which both jump to padH (the null-guard diamond of a branching RefDec), and padH
// unwinds.  FaultPads order: padE, padF, padG, padH.
func padDiamondFunc() @ir.Func {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var padE @ir.Block = ir.AddFaultPad(f, "padE")
	var padF @ir.Block = ir.AddFaultPad(f, "padF")
	var padG @ir.Block = ir.AddFaultPad(f, "padG")
	var padH @ir.Block = ir.AddFaultPad(f, "padH")
	irbuild.EmitBranch(padE, irbuild.EmitConstBool(padE, true), padF, padG)
	irbuild.EmitJump(padF, padH)
	irbuild.EmitJump(padG, padH)
	irbuild.EmitUnwindReturn(padH)
	var c0 @ir.Instr = irbuild.EmitConstInt(entry, 0, types.TypInt())
	var c1 @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	irbuild.EmitBoundsCheck(entry, c0, c1)
	entry.Instrs[2].PadBlock = padE
	irbuild.EmitReturn(entry, noArgs)
	return f
}

// A branch's two targets are each entered from the branching pad block, and a block
// both arms jump to is entered from each: padH runs for padE's fault point, which
// a store at entry[1] dominates and one at entry[2] does not.
func TestStoreDominatesPadThroughBranches() testing.TestResult {
	var f @ir.Func = padDiamondFunc()
	var ps @padFaultSites = buildPadFaultSites(f)
	var d @DomInfo = ComputeDom(f)
	if len(ps.preds[1]) != 1 || ps.preds[1][0] != 0 || len(ps.preds[2]) != 1 || ps.preds[2][0] != 0 {
		return fail("padE enters both padF and padG")
	}
	if len(ps.preds[3]) != 2 { return fail("padF and padG both enter padH") }
	if !storeDominatesPad(ps, d, 0, 1, 3) { return fail("a store at entry[1] dominates padH") }
	if storeDominatesPad(ps, d, 0, 2, 3) { return fail("a store at entry[2] does not dominate padH") }
	if !storeDominatesPad(ps, d, 0, 1, 2) {
		return fail("nor does the earlier query's walk hide padG")
	}
	return ""
}

// The VM also enters a pad block from one that ends without a terminator (it runs
// into the next) and at a fault op inside another pad block: here padJ ends without
// one and runs into padK, whose bounds check lands in padL, so padL runs for
// entry's fault point.  FaultPads order: padJ, padK, padL.
func TestPadFaultSitesFallThroughAndNestedFault() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var padJ @ir.Block = ir.AddFaultPad(f, "padJ")
	var padK @ir.Block = ir.AddFaultPad(f, "padK")
	var padL @ir.Block = ir.AddFaultPad(f, "padL")
	_ = irbuild.EmitConstInt(padJ, 0, types.TypInt())
	var k0 @ir.Instr = irbuild.EmitConstInt(padK, 0, types.TypInt())
	var k1 @ir.Instr = irbuild.EmitConstInt(padK, 1, types.TypInt())
	irbuild.EmitBoundsCheck(padK, k0, k1)
	padK.Instrs[2].PadBlock = padL
	irbuild.EmitUnwindReturn(padK)
	irbuild.EmitUnwindReturn(padL)
	var c0 @ir.Instr = irbuild.EmitConstInt(entry, 0, types.TypInt())
	var c1 @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	irbuild.EmitBoundsCheck(entry, c0, c1)
	entry.Instrs[2].PadBlock = padJ
	irbuild.EmitReturn(entry, noArgs)
	var ps @padFaultSites = buildPadFaultSites(f)
	if len(ps.preds[1]) != 1 || ps.preds[1][0] != 0 { return fail("padJ runs into padK") }
	if len(ps.preds[2]) != 1 || ps.preds[2][0] != 1 {
		return fail("padK's bounds check lands in padL")
	}
	var d @DomInfo = ComputeDom(f)
	if storeDominatesPad(ps, d, 0, 2, 2) { return fail("padL runs from entry's fault point") }
	if !storeDominatesPad(ps, d, 0, 1, 2) { return fail("a store at entry[1] dominates padL") }
	return ""
}
