package "pkg/binate/iropt"

import "pkg/binate/ir"

import "pkg/stdx/slices"

// Loop-nesting analysis over a finalized func's CFG, built on the dominance
// data in dom.bn.  ComputeLoopDepths is a static execution-frequency proxy for
// heuristics (e.g. the native register allocator's spill cost), and
// ComputeLoopHeaders marks the loop entries (e.g. for code alignment) — neither
// is a correctness input, so an imprecise answer only biases a heuristic, it
// cannot miscompile.

// ComputeLoopHeaders reports, per position in f.Blocks, whether the block is a
// loop header: the head h of some back-edge b->h, i.e. an edge whose head
// dominates its tail.  A block unreachable from the entry is never a header.
func ComputeLoopHeaders(f @ir.Func) @[]bool {
	return loopHeaders(ComputeDom(f))
}

// loopHeaders is ComputeLoopHeaders over already-computed dominance data.
func loopHeaders(d @DomInfo) @[]bool {
	var n int = d.NumBlocks
	var isHeader @[]bool = make_slice(bool, n)
	for b := 0; b < n; b++ {
		if d.PostNum[b] < 0 {
			continue // unreachable from entry
		}
		for k := 0; k < len(d.Succs[b]); k++ {
			var s int = d.Succs[b][k]
			if d.Dominates(s, b) {
				isHeader[s] = true
			}
		}
	}
	return isHeader
}

// ComputeLoopDepths returns each block's loop-nesting depth (0 = outside every
// loop), indexed by position in f.Blocks.  A block unreachable from the entry
// gets depth 0.
//
// Loops are the natural loops of the CFG's back-edges — an edge b->h whose head
// h dominates its tail b.  The natural loop of such a back-edge is h plus every
// block that reaches a latch b without passing through h (a backward walk over
// predecessors, bounded by domination by h).  A block's depth is the number of
// distinct loop headers whose loop body contains it, so properly-nested loops
// accumulate (a block two loops deep gets depth 2).  Multiple back-edges into
// the same header are unioned into one loop (counted once).
func ComputeLoopDepths(f @ir.Func) @[]int {
	var d @DomInfo = ComputeDom(f)
	var n int = d.NumBlocks
	var depth @[]int = make_slice(int, n)
	if n == 0 {
		return depth
	}
	var isHeader @[]bool = loopHeaders(d)
	// For each header, compute the union of its back-edges' natural loops and
	// bump the depth of every block in that union once.
	for h := 0; h < n; h++ {
		if !isHeader[h] {
			continue
		}
		var inLoop @[]bool = make_slice(bool, n)
		inLoop[h] = true
		var stack @[]int
		// Seed with every latch: a block b with a b->h edge that h dominates.
		for b := 0; b < n; b++ {
			if d.PostNum[b] < 0 {
				continue
			}
			if !d.Dominates(h, b) {
				continue
			}
			var latch bool = false
			for k := 0; k < len(d.Succs[b]); k++ {
				if d.Succs[b][k] == h {
					latch = true
				}
			}
			if latch && !inLoop[b] {
				inLoop[b] = true
				stack = slices.Append[int](stack, b)
			}
		}
		// Backward reach from the latches over predecessors, staying within the
		// header's dominance region (so the walk never escapes above h); h itself
		// is already marked, so it stops the walk.
		for len(stack) > 0 {
			var m int = stack[len(stack) - 1]
			stack = stack[0:len(stack) - 1]
			for k := 0; k < len(d.Preds[m]); k++ {
				var p int = d.Preds[m][k]
				if !inLoop[p] && d.Dominates(h, p) {
					inLoop[p] = true
					stack = slices.Append[int](stack, p)
				}
			}
		}
		for bb := 0; bb < n; bb++ {
			if inLoop[bb] {
				depth[bb] = depth[bb] + 1
			}
		}
	}
	return depth
}
