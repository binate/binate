package "pkg/binate/iropt"

import "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for ComputeLoopDepths (loops.bn) on hand-built CFGs.  Uses noParams /
// noResults / oneRet from the sibling dom_test.bn (same package).

// A single counted loop: entry -> header; header branches to body or exit; body
// jumps back to header (the back-edge).  Header and body are inside the loop
// (depth 1); entry and exit are outside it (depth 0).
func TestComputeLoopDepthsSimpleLoop() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry") // 0
	var header @ir.Block = ir.AddBlock(f, "header") // 1
	var body @ir.Block = ir.AddBlock(f, "body") // 2
	var exit @ir.Block = ir.AddBlock(f, "exit") // 3
	entry.EmitJump(header)
	var cond @ir.Instr = header.EmitConstBool(true)
	header.EmitBranch(cond, body, exit)
	body.EmitJump(header) // back-edge
	var r @ir.Instr = exit.EmitConstInt(0, types.TypInt())
	exit.EmitReturn(oneRet(r))

	var depth @[]int = ComputeLoopDepths(f)
	if len(depth) != 4 {
		return "expected one depth per block"
	}
	if depth[0] != 0 {
		return "entry must be outside the loop (depth 0)"
	}
	if depth[1] != 1 {
		return "the loop header must be depth 1"
	}
	if depth[2] != 1 {
		return "the loop body must be depth 1"
	}
	if depth[3] != 0 {
		return "the exit must be outside the loop (depth 0)"
	}
	return ""
}

// Nested loops: an inner loop inside an outer loop.  The inner header/body are
// depth 2; the outer header and the outer latch are depth 1.
func TestComputeLoopDepthsNested() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry") // 0
	var outerH @ir.Block = ir.AddBlock(f, "outerH") // 1
	var innerH @ir.Block = ir.AddBlock(f, "innerH") // 2
	var innerBody @ir.Block = ir.AddBlock(f, "innerBody") // 3
	var outerLatch @ir.Block = ir.AddBlock(f, "outerLatch") // 4
	var exit @ir.Block = ir.AddBlock(f, "exit") // 5
	entry.EmitJump(outerH)
	var c1 @ir.Instr = outerH.EmitConstBool(true)
	outerH.EmitBranch(c1, innerH, exit)
	var c2 @ir.Instr = innerH.EmitConstBool(true)
	innerH.EmitBranch(c2, innerBody, outerLatch)
	innerBody.EmitJump(innerH) // inner back-edge
	outerLatch.EmitJump(outerH) // outer back-edge
	var r @ir.Instr = exit.EmitConstInt(0, types.TypInt())
	exit.EmitReturn(oneRet(r))

	var depth @[]int = ComputeLoopDepths(f)
	if depth[0] != 0 {
		return "entry must be depth 0"
	}
	if depth[1] != 1 {
		return "outer header must be depth 1"
	}
	if depth[2] != 2 {
		return "inner header must be depth 2 (inside both loops)"
	}
	if depth[3] != 2 {
		return "inner body must be depth 2"
	}
	if depth[4] != 1 {
		return "outer latch must be depth 1"
	}
	if depth[5] != 0 {
		return "exit must be depth 0"
	}
	return ""
}

// Straight-line control flow has no back-edges: every block is depth 0.
func TestComputeLoopDepthsNoLoops() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry") // 0
	var mid @ir.Block = ir.AddBlock(f, "mid") // 1
	var exit @ir.Block = ir.AddBlock(f, "exit") // 2
	entry.EmitJump(mid)
	mid.EmitJump(exit)
	var r @ir.Instr = exit.EmitConstInt(0, types.TypInt())
	exit.EmitReturn(oneRet(r))

	var depth @[]int = ComputeLoopDepths(f)
	if depth[0] != 0 || depth[1] != 0 || depth[2] != 0 {
		return "straight-line code must have every block at depth 0"
	}
	return ""
}
