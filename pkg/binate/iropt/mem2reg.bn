package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/std/vec"

import "pkg/binate/iropcode"
import "pkg/binate/types"

// Non-managed scalar SSA promotion (mem2reg) — the first OP_PHI producer.
//
// Promotes function-local non-managed scalar memory slots (an OP_ALLOC of
// int / float / bool / raw-pointer whose address never escapes) to SSA values +
// OP_PHI, so their loads/stores vanish and the value flows directly.  The
// phis are consumed downstream by the LLVM backend (natively) and, for the
// VM + native backends, by iropt.EliminatePhis (which destructs them to copies).
//
// Scoping to non-managed scalars sidesteps the whole refcount-hazard family
// AND the fault-pad hazard (pads only touch managed locals).  The promotable
// type set is EXACTLY what EliminatePhis' assertScalarPhi accepts, since we
// emit the phis it lowers.

// promoteFuncScalars promotes all eligible scalar slots in one function.
func promoteFuncScalars(f @ir.Func) {
	if len(f.Blocks) == 0 {
		return
	}
	// Prune unreachable blocks first: gen leaves benign orphan blocks (an
	// if.merge / switch.exit whose arms all terminate) that still branch into
	// their continuation.  If that continuation becomes a phi-block, the phi —
	// filled only from reachable predecessors — would have fewer entries than
	// the LLVM backend's CFG predecessor count (it emits every block), which
	// the LLVM verifier rejects.  Removing the whole unreachable set dangles no
	// kept terminator (no reachable block targets an unreachable one), so it is
	// a sound precondition that also drops the offending orphan->merge edges.
	pruneUnreachableBlocks(f)
	if !hasPromotableAlloca(f) {
		return
	}

	var d @DomInfo = ComputeDom(f)
	var n int = d.NumBlocks
	var domChildren @[]@[]int = buildDomChildren(d)
	// Every value's reads, indexed once: each alloca's escape check, its stores'
	// blocks and its rename walk then visit the alloca's own uses rather than every
	// instruction, which would cost the alloca count times the instruction count.
	// The analysis below creates phis and zero constants but inserts nothing, so
	// the index stays exact until applyPromotion.
	var ui @useIndex = buildUseIndex(f)

	// Global accumulators, applied in one mutation phase after all analysis so
	// the CFG (blocks + terminators — untouched by promotion) stays stable and
	// every alloca is analyzed against the original IR.
	var gPhi @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
	var gPhiBlock @vec.Vec[int] = vec.New[int]()
	var gReplID @vec.Vec[int] = vec.New[int]()
	var gReplVal @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
	var gGroundLoad @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
	var gGroundVal @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
	var gZeroVal @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
	var gDeletedAlloca @vec.Vec[int] = vec.New[int]()
	var promotedAny bool = false

	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @ir.Instr = blk.Instrs[ii]
			if !isPromotableAlloca(instr) {
				continue
			}
			var uses @[]valueUse = ui.usesOf(instr)
			if allocaEscapes(instr, uses) {
				continue
			}
			var defBlocks @[]int = allocaDefBlocks(uses)
			var res @m2rResult = analyzeAlloca(f, d, domChildren, n, instr, defBlocks, uses)
			if !res.ok {
				continue
			}
			// Merge this alloca's promotion into the global accumulators.
			for b := 0; b < n; b++ {
				if res.phiOfBlock[b] != nil {
					gPhi.Push(res.phiOfBlock[b])
					gPhiBlock.Push(b)
				}
			}
			for k := 0; k < len(res.replIDs); k++ {
				gReplID.Push(res.replIDs[k])
				gReplVal.Push(res.replVals[k])
			}
			for k := 0; k < len(res.groundLoads); k++ {
				gGroundLoad.Push(res.groundLoads[k])
				gGroundVal.Push(res.groundVals[k])
			}
			if res.zeroVal != nil {
				gZeroVal.Push(res.zeroVal)
			}
			gDeletedAlloca.Push(instr.ID)
			promotedAny = true
		}
	}

	if !promotedAny {
		return
	}

	applyPromotion(f, n, gPhi.Items(), gPhiBlock.Items(), gReplID.Items(), gReplVal.Items(),
			gGroundLoad.Items(), gGroundVal.Items(), gZeroVal.Items(), gDeletedAlloca.Items())
	assertPromotion(f, d, gPhi.Items(), gPhiBlock.Items())
}

// isPromotableAlloca reports whether instr is an OP_ALLOC of a non-managed
// scalar type EliminatePhis can lower a phi of: int, float, bool, or a raw
// pointer.  Managed / aggregate slots are excluded.
func isPromotableAlloca(instr @ir.Instr) bool {
	if instr.Op != iropcode.OP_ALLOC {
		return false
	}
	// isScalarPromotableType (sroa_transform.bn) is the shared promotable-type
	// predicate — SROA consults the same one so its field-promotability gate
	// matches exactly what mem2reg will promote.
	return isScalarPromotableType(instr.TypeArg)
}

// hasPromotableAlloca reports whether any instruction of f's blocks is a
// promotable alloca, so a function with none skips the dominator tree and the use
// index.
func hasPromotableAlloca(f @ir.Func) bool {
	for bi := 0; bi < len(f.Blocks); bi++ {
		for ii := 0; ii < len(f.Blocks[bi].Instrs); ii++ {
			if isPromotableAlloca(f.Blocks[bi].Instrs[ii]) { return true }
		}
	}
	return false
}

// allocaEscapes reports whether alloca a, whose reads are uses, is used as
// anything other than the address (Args[0]) of a plain OP_LOAD / OP_STORE, or by
// a load or store that reinterprets the slot's bits (accessReinterpretsSlot).
// Over-broad by design: ANY other appearance — as a store's value (Args[1]), any
// operand of any other op, a phi entry, or ANY appearance inside FaultPads — pins
// the slot unpromotable.  A scalar slot never legitimately appears in a pad;
// treating any pad appearance as escape is a belt-and-suspenders that essentially
// never fires.
func allocaEscapes(a @ir.Instr, uses @[]valueUse) bool {
	for i := 0; i < len(uses); i++ {
		if uses[i].inPad { return true }
		var instr @ir.Instr = uses[i].user
		if instr == a { continue } // the alloca definition itself is not a use
		var k int = uses[i].argIdx
		if k < 0 { return true } // a phi entry
		var okLoad bool = instr.Op == iropcode.OP_LOAD && k == 0
		var okStore bool = instr.Op == iropcode.OP_STORE && k == 0
		if !okLoad && !okStore {
			return true
		}
		var none @ir.Instr
		if okLoad && accessReinterpretsSlot(a.TypeArg, instr.Typ, none) {
			return true
		}
		if okStore && len(instr.Args) > 1 && instr.Args[1] != nil &&
				accessReinterpretsSlot(a.TypeArg, instr.Args[1].Typ, instr.Args[1]) {
			return true
		}
	}
	return false
}

// accessReinterpretsSlot reports whether a load of type accTyp from a slot of type
// slotTyp, or a store of value v (of type accTyp) to it, reads the slot's bits as a
// different kind of value: a float access to a non-float slot, a non-float access
// to a float slot, or a float of another width.  Promotion forwards the stored
// value to the load, grounding a looser type with a numeric OP_CAST
// (needsGrounding) — right for an untyped-int constant, wrong for these, where
// memory semantics are a bit reinterpretation — so such a slot stays in memory.
//
// An untyped float constant is a 64-bit value, so storing one into a float64 slot
// stores the same bits (irgen leaves the constant untyped when the widths already
// agree, and converts it for a float32 slot).  That store is accepted: a phi of
// the slot carries the constant as it is, and a load it reaches becomes a typed
// copy of the constant (applyPromotion).  Any other untyped-float access is
// rejected.
func accessReinterpretsSlot(slotTyp @types.Type, accTyp @types.Type, v @ir.Instr) bool {
	var st @types.Type = types.StripWrappers(slotTyp)
	var at @types.Type = types.StripWrappers(accTyp)
	if st == nil || at == nil {
		return st != nil && st.Kind == types.TYP_FLOAT
	}
	if at.Kind == types.TYP_UNTYPED_FLOAT {
		return !(st.Kind == types.TYP_FLOAT && st.Width == 64 && v != nil &&
				v.Op == iropcode.OP_CONST_FLOAT)
	}
	var slotFloat bool = st.Kind == types.TYP_FLOAT
	var accFloat bool = at.Kind == types.TYP_FLOAT
	if slotFloat != accFloat {
		return true
	}
	return slotFloat && at.Width != st.Width
}

// allocaDefBlocks returns the indices, ascending and deduped, of the blocks
// holding a store to the alloca whose reads are uses (which run in block order).
func allocaDefBlocks(uses @[]valueUse) @[]int {
	var out @vec.Vec[int] = vec.New[int]()
	for i := 0; i < len(uses); i++ {
		if uses[i].inPad || uses[i].argIdx != 0 || uses[i].user.Op != iropcode.OP_STORE { continue }
		var b int = uses[i].blockIdx
		if out.Len() == 0 || out.Get(out.Len() - 1) != b { out.Push(b) }
	}
	return out.Items()
}

// assertPromotion fails loud if a placed phi is malformed: its entry set must be
// exactly its block's CFG predecessors (one entry per predecessor, each a
// distinct real predecessor — the orphan-phi class the reachable-block prune
// prevents), and it must be a phi EliminatePhis can lower.  This is the first phi
// producer, so a wrong-code phi here would poison every backend.  (The
// no-surviving-use check lives in applyPromotion, which holds the id views.)
func assertPromotion(f @ir.Func, d @DomInfo, gPhi @[]@ir.Instr, gPhiBlock @[]int) {
	for i := 0; i < len(gPhi); i++ {
		var phi @ir.Instr = gPhi[i]
		var b int = gPhiBlock[i]
		if len(phi.Phis) != len(d.Preds[b]) {
			panic("mem2reg: phi entry count disagrees with CFG predecessor count")
		}
		assertPhiEntriesArePreds(f, d, phi, b)
		assertScalarPhi(phi)
	}
}

// assertPhiEntriesArePreds panics unless every phi entry's Block is a distinct
// real predecessor of block b — so a correct count can't hide a duplicated or
// foreign predecessor edge.
func assertPhiEntriesArePreds(f @ir.Func, d @DomInfo, phi @ir.Instr, b int) {
	for i := 0; i < len(phi.Phis); i++ {
		var pi int = irbuild.BlockIndexIn(f, phi.Phis[i].Block)
		if pi < 0 || !intContains(d.Preds[b], pi) {
			panic("mem2reg: phi entry block is not a predecessor")
		}
		for j := i + 1; j < len(phi.Phis); j++ {
			if phi.Phis[j].Block == phi.Phis[i].Block {
				panic("mem2reg: phi has a duplicate predecessor entry")
			}
		}
	}
}

// intContains reports whether s contains v.
func intContains(s @[]int, v int) bool {
	for i := 0; i < len(s); i++ {
		if s[i] == v {
			return true
		}
	}
	return false
}

// pruneUnreachableBlocks removes blocks not reachable from the entry
// (f.Blocks[0]).  Sound because no reachable block's terminator targets an
// unreachable block, so removing the whole unreachable set dangles no kept
// terminator.  FaultPads are off f.Blocks and untouched.
func pruneUnreachableBlocks(f @ir.Func) {
	var n int = len(f.Blocks)
	if n == 0 {
		return
	}
	var reachable @[]bool = make_slice(bool, n)
	var stack @vec.Vec[int] = vec.New[int]()
	reachable[0] = true
	stack.Push(0)
	for stack.Len() > 0 {
		var b int
		b, _ = stack.Pop()
		var blk @ir.Block = f.Blocks[b]
		var ni int = len(blk.Instrs)
		if ni == 0 {
			continue
		}
		var term @ir.Instr = blk.Instrs[ni - 1]
		pushIfUnvisited(f, term.Block1, reachable, stack)
		pushIfUnvisited(f, term.Block2, reachable, stack)
	}
	var anyDead bool = false
	for i := 0; i < n; i++ {
		if !reachable[i] {
			anyDead = true
		}
	}
	if !anyDead {
		return
	}
	var kept @vec.Vec[@ir.Block] = vec.New[@ir.Block]()
	for i := 0; i < n; i++ {
		if reachable[i] {
			kept.Push(f.Blocks[i])
		}
	}
	f.Blocks = kept.Items()
}

// pushIfUnvisited marks succ reachable and pushes it onto stack if it is a real,
// not-yet-visited block of f.
func pushIfUnvisited(f @ir.Func, succ *ir.Block, reachable @[]bool, stack @vec.Vec[int]) {
	if succ == nil {
		return
	}
	var si int = irbuild.BlockIndexIn(f, succ)
	if si < 0 || reachable[si] {
		return
	}
	reachable[si] = true
	stack.Push(si)
}
