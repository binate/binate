package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Unit tests for the shared apply/rewrite layer (mem2reg_apply.bn).  The whole-
// transform behavior (promote + delete + rewrite, incl. the fault-pad rebuild for
// a store-forwarded managed-pointer slot) is exercised end-to-end by the mem2reg
// and load-forward tests; these cover the pure building blocks in isolation.

// chaseRepl follows the promoted-load -> reaching-value map transitively and stops
// at a value with no mapping (a `var x = y = z` chain collapses to z).
func TestApplyChaseReplTransitive() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	var b @ir.Instr = irbuild.EmitConstInt(entry, 2, types.TypInt())
	var c @ir.Instr = irbuild.EmitConstInt(entry, 3, types.TypInt())
	var cap int = f.NextID
	var repl @[]@ir.Instr
	for i := 0; i < cap; i++ {
		var none @ir.Instr
		repl = slices.Append[@ir.Instr](repl, none)
	}
	// Chain a -> b -> c; c is terminal (no mapping).
	repl[a.ID] = b
	repl[b.ID] = c
	if chaseRepl(a, repl, cap) != c {
		return fail("chaseRepl should follow a->b->c to the terminal c")
	}
	if chaseRepl(b, repl, cap) != c {
		return fail("chaseRepl should follow b->c")
	}
	if chaseRepl(c, repl, cap) != c {
		return fail("a value with no mapping chases to itself")
	}
	return ""
}

// instrIsDeleted reports an OP_ALLOC that is in the deleted set, and any load/store
// whose pointer operand is such an alloca — but not an unrelated instruction, nor a
// load of a live alloca.
func TestApplyInstrIsDeleted() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var dead @ir.Instr = irbuild.EmitAlloc(entry, types.TypInt())
	var live @ir.Instr = irbuild.EmitAlloc(entry, types.TypInt())
	var deadLoad @ir.Instr = irbuild.EmitLoad(entry, dead, types.TypInt())
	var liveLoad @ir.Instr = irbuild.EmitLoad(entry, live, types.TypInt())
	var k @ir.Instr = irbuild.EmitConstInt(entry, 7, types.TypInt())
	var cap int = f.NextID
	var del @[]bool
	for i := 0; i < cap; i++ {
		del = slices.Append[bool](del, false)
	}
	del[dead.ID] = true

	if !instrIsDeleted(dead, del, cap) {
		return fail("the deleted alloca itself must be reported deleted")
	}
	if !instrIsDeleted(deadLoad, del, cap) {
		return fail("a load of the deleted alloca must be reported deleted")
	}
	if instrIsDeleted(live, del, cap) {
		return fail("a live alloca must not be reported deleted")
	}
	if instrIsDeleted(liveLoad, del, cap) {
		return fail("a load of a live alloca must not be reported deleted")
	}
	if instrIsDeleted(k, del, cap) {
		return fail("an unrelated instruction must not be reported deleted")
	}
	return ""
}
