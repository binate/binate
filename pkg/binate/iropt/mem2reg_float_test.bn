package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for promoting FLOAT slots (mem2reg.bn) and for the gate that keeps a slot
// whose loads or stores reinterpret its bits in memory (accessReinterpretsSlot).

// A straight-line float `store; load` promotes to the stored value.
func TestMem2regFloatPromoted() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitAlloc(entry, types.TypFloat64())
	var c @ir.Instr = irbuild.EmitConstFloat(entry, "1.5", types.TypFloat64())
	irbuild.EmitStore(entry, x, c)
	var v @ir.Instr = irbuild.EmitLoad(entry, x, types.TypFloat64())
	irbuild.EmitReturn(entry, oneRet(v))

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 ||
			countOp(f, iropcode.OP_STORE) != 0 {
		return fail("float: the slot should be promoted")
	}
	if lastInstr(entry).Args[0] != c {
		return fail("float: the return should read the stored constant")
	}
	return ""
}

// A loop-carried float32 gets a float32 header phi, read by the step and by the
// exit.
func TestMem2regFloatLoopPhi() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var x @ir.Instr = irbuild.EmitAlloc(pre, types.TypFloat32())
	irbuild.EmitStore(pre, x, irbuild.EmitConstFloat(pre, "0", types.TypFloat32()))
	irbuild.EmitJump(pre, header)
	irbuild.EmitBranch(header, irbuild.EmitConstBool(header, true), body, exit)
	var cur @ir.Instr = irbuild.EmitLoad(body, x, types.TypFloat32())
	var step @ir.Instr = irbuild.EmitBinop(body, iropcode.OP_ADD, cur,
			irbuild.EmitConstFloat(body, "0.5", types.TypFloat32()), types.TypFloat32())
	irbuild.EmitStore(body, x, step)
	irbuild.EmitJump(body, header)
	var r @ir.Instr = irbuild.EmitLoad(exit, x, types.TypFloat32())
	irbuild.EmitReturn(exit, oneRet(r))

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 {
		return fail("float loop: the slot should be promoted")
	}
	var phi @ir.Instr = firstPhi(header)
	if phi == nil || len(phi.Phis) != 2 {
		return fail("float loop: expected a two-entry header phi")
	}
	var pt @types.Type = types.StripWrappers(phi.Typ)
	if pt == nil || pt.Kind != types.TYP_FLOAT || pt.Width != 32 {
		return fail("float loop: the header phi should be float32")
	}
	if step.Args[0] != phi || lastInstr(exit).Args[0] != phi {
		return fail("float loop: the step and the exit should read the header phi")
	}
	return ""
}

// A float slot read before any store forwards a float zero of the slot's type.
func TestMem2regFloatUndefLoadIsFloatZero() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitAlloc(entry, types.TypFloat64())
	var v @ir.Instr = irbuild.EmitLoad(entry, x, types.TypFloat64())
	irbuild.EmitReturn(entry, oneRet(v))

	promoteFuncScalars(f)

	var rv @ir.Instr = lastInstr(entry).Args[0]
	if countOp(f, iropcode.OP_LOAD) != 0 || rv.Op != iropcode.OP_CONST_FLOAT {
		return fail("float undef load: should forward an OP_CONST_FLOAT zero")
	}
	var rt @types.Type = types.StripWrappers(rv.Typ)
	if rt == nil || rt.Kind != types.TYP_FLOAT || rt.Width != 64 {
		return fail("float undef load: the zero should have the slot's type")
	}
	return ""
}

// expectSlotKept runs mem2reg and fails with msg unless the one slot, its store and
// its load all survive.
func expectSlotKept(f @ir.Func, msg @[]char) testing.TestResult {
	promoteFuncScalars(f)
	if countOp(f, iropcode.OP_ALLOC) != 1 || countOp(f, iropcode.OP_STORE) != 1 ||
			countOp(f, iropcode.OP_LOAD) != 1 {
		return fail(msg)
	}
	return ""
}

// A float slot read back as an int64 reinterprets its bits, so it stays in memory
// (forwarding would ground it with a numeric cast).
func TestMem2regFloatSlotIntLoadKept() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitAlloc(entry, types.TypFloat64())
	irbuild.EmitStore(entry, x, irbuild.EmitConstFloat(entry, "1.5", types.TypFloat64()))
	var v @ir.Instr = irbuild.EmitLoad(entry, x, types.TypInt64())
	irbuild.EmitReturn(entry, oneRet(v))
	return expectSlotKept(f, "a float slot loaded as an int must stay in memory")
}

// An int slot holding a stored float value stays in memory.  (int32 and float32:
// an int32 slot is promotable on every target, so the gate itself decides.)
func TestMem2regIntSlotFloatStoreKept() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitAlloc(entry, types.TypInt32())
	irbuild.EmitStore(entry, x, irbuild.EmitConstFloat(entry, "1.5", types.TypFloat32()))
	var v @ir.Instr = irbuild.EmitLoad(entry, x, types.TypInt32())
	irbuild.EmitReturn(entry, oneRet(v))
	return expectSlotKept(f, "an int slot stored a float must stay in memory")
}

// A float32 slot loaded as a float64 reads the wrong width, so it stays in memory.
func TestMem2regFloatWidthMismatchKept() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitAlloc(entry, types.TypFloat32())
	irbuild.EmitStore(entry, x, irbuild.EmitConstFloat(entry, "1.5", types.TypFloat32()))
	var v @ir.Instr = irbuild.EmitLoad(entry, x, types.TypFloat64())
	irbuild.EmitReturn(entry, oneRet(v))
	return expectSlotKept(f, "a float32 slot loaded as a float64 must stay in memory")
}

// An untyped float constant stored into a float64 slot is the same 64-bit value:
// the slot promotes, and the load becomes a float64 copy of the constant (not a
// cast).
func TestMem2regFloatUntypedConstIntoFloat64Promoted() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitAlloc(entry, types.TypFloat64())
	irbuild.EmitStore(entry, x, irbuild.EmitConstFloat(entry, "2.5", types.TypUntypedFloat()))
	var v @ir.Instr = irbuild.EmitLoad(entry, x, types.TypFloat64())
	irbuild.EmitReturn(entry, oneRet(v))

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 ||
			countOp(f, iropcode.OP_CAST) != 0 {
		return fail("untyped into float64: the slot should promote with no cast")
	}
	var rv @ir.Instr = lastInstr(entry).Args[0]
	var rt @types.Type = types.StripWrappers(rv.Typ)
	if rv.Op != iropcode.OP_CONST_FLOAT || rt == nil || rt.Kind != types.TYP_FLOAT || rt.Width != 64 ||
			len(rv.StrVal) != 3 || rv.StrVal[0] != '2' {
		return fail("untyped into float64: the load should become a float64 constant 2.5")
	}
	return ""
}

// An untyped float constant stored into a float32 slot would reach a float32 phi
// or copy as a 64-bit value, so the slot stays in memory.  (irgen converts such a
// constant before the store; this pins the gate itself.)
func TestMem2regFloatUntypedStoreKept() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitAlloc(entry, types.TypFloat32())
	irbuild.EmitStore(entry, x, irbuild.EmitConstFloat(entry, "1.5", types.TypUntypedFloat()))
	var v @ir.Instr = irbuild.EmitLoad(entry, x, types.TypFloat32())
	irbuild.EmitReturn(entry, oneRet(v))
	return expectSlotKept(f, "a float slot stored an untyped float must stay in memory")
}
