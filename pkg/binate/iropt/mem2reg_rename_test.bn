package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the per-alloca SSA-construction core (mem2reg_rename.bn): phi
// placement (IteratedDF), the dominator-tree rename, and type grounding
// (needsGrounding).  Shared helpers (firstPhi, lastInstr) live in
// mem2reg_test.bn; countOp lives in ir_test.bn.

// A diamond `if c { x=1 } else { x=2 }; return x` promotes to a 2-entry phi at
// the merge, and the return uses it.
func TestMem2regDiamond() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var elseB @ir.Block = ir.AddBlock(f, "else")
	var merge @ir.Block = ir.AddBlock(f, "merge")
	var x @ir.Instr = irbuild.EmitAlloc(entry, types.TypInt())
	irbuild.EmitStore(entry, x, irbuild.EmitConstInt(entry, 0, types.TypInt()))
	irbuild.EmitBranch(entry, irbuild.EmitConstBool(entry, true), thenB, elseB)
	irbuild.EmitStore(thenB, x, irbuild.EmitConstInt(thenB, 1, types.TypInt()))
	irbuild.EmitJump(thenB, merge)
	irbuild.EmitStore(elseB, x, irbuild.EmitConstInt(elseB, 2, types.TypInt()))
	irbuild.EmitJump(elseB, merge)
	var v @ir.Instr = irbuild.EmitLoad(merge, x, types.TypInt())
	irbuild.EmitReturn(merge, oneRet(v))

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 ||
			countOp(f, iropcode.OP_STORE) != 0 {
		return fail("diamond: alloca/load/store should be gone")
	}
	if countOp(f, iropcode.OP_PHI) != 1 {
		return fail("diamond: exactly one phi expected")
	}
	var phi @ir.Instr = firstPhi(merge)
	if phi == nil || len(phi.Phis) != 2 {
		return fail("diamond: the merge phi should have 2 entries")
	}
	if lastInstr(merge).Args[0] != phi {
		return fail("diamond: return should use the phi")
	}
	return ""
}

// A reducible loop with an induction store on the back-edge promotes to a
// header phi (init value from the preheader, stepped value from the latch).
func TestMem2regLoop() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var i @ir.Instr = irbuild.EmitAlloc(pre, types.TypInt())
	irbuild.EmitStore(pre, i, irbuild.EmitConstInt(pre, 0, types.TypInt()))
	irbuild.EmitJump(pre, header)
	irbuild.EmitBranch(header, irbuild.EmitConstBool(header, true), body, exit)
	var cur @ir.Instr = irbuild.EmitLoad(body, i, types.TypInt())
	var inc @ir.Instr = irbuild.EmitBinop(body, iropcode.OP_ADD, cur,
			irbuild.EmitConstInt(body, 1, types.TypInt()), types.TypInt())
	irbuild.EmitStore(body, i, inc)
	irbuild.EmitJump(body, header)
	var r @ir.Instr = irbuild.EmitLoad(exit, i, types.TypInt())
	irbuild.EmitReturn(exit, oneRet(r))

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 ||
			countOp(f, iropcode.OP_STORE) != 0 {
		return fail("loop: alloca/load/store should be gone")
	}
	if countOp(f, iropcode.OP_PHI) != 1 {
		return fail("loop: exactly one header phi expected")
	}
	var phi @ir.Instr = firstPhi(header)
	if phi == nil || len(phi.Phis) != 2 {
		return fail("loop: the header phi should have 2 entries (pre + latch)")
	}
	// The increment's operand was the load, now rewritten to the phi.
	if inc.Args[0] != phi {
		return fail("loop: the step should read the header phi")
	}
	// The exit return reads the header phi (last stored value at loop exit).
	if lastInstr(exit).Args[0] != phi {
		return fail("loop: the exit return should read the header phi")
	}
	return ""
}

// The diamond phi's entries reference the exact stored values (not just the
// right count).
func TestMem2regDiamondPhiOperandValues() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var elseB @ir.Block = ir.AddBlock(f, "else")
	var merge @ir.Block = ir.AddBlock(f, "merge")
	var x @ir.Instr = irbuild.EmitAlloc(entry, types.TypInt())
	irbuild.EmitStore(entry, x, irbuild.EmitConstInt(entry, 0, types.TypInt()))
	irbuild.EmitBranch(entry, irbuild.EmitConstBool(entry, true), thenB, elseB)
	var one @ir.Instr = irbuild.EmitConstInt(thenB, 1, types.TypInt())
	irbuild.EmitStore(thenB, x, one)
	irbuild.EmitJump(thenB, merge)
	var two @ir.Instr = irbuild.EmitConstInt(elseB, 2, types.TypInt())
	irbuild.EmitStore(elseB, x, two)
	irbuild.EmitJump(elseB, merge)
	var v @ir.Instr = irbuild.EmitLoad(merge, x, types.TypInt())
	irbuild.EmitReturn(merge, oneRet(v))

	promoteFuncScalars(f)

	var phi @ir.Instr = firstPhi(merge)
	if phi == nil || len(phi.Phis) != 2 {
		return fail("phi-values: expected a 2-entry merge phi")
	}
	var sawThen bool = false
	var sawElse bool = false
	for i := 0; i < len(phi.Phis); i++ {
		if phi.Phis[i].Block == thenB && phi.Phis[i].Val == one {
			sawThen = true
		}
		if phi.Phis[i].Block == elseB && phi.Phis[i].Val == two {
			sawElse = true
		}
	}
	if !sawThen || !sawElse {
		return fail("phi-values: each arm's entry must carry that arm's stored const")
	}
	return ""
}

// `var x = y` with both promoted exercises the transitive repl chase: x's load
// resolves through y's load to y's stored const.
func TestMem2regTransitiveChase() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var y @ir.Instr = irbuild.EmitAlloc(entry, types.TypInt())
	var seven @ir.Instr = irbuild.EmitConstInt(entry, 7, types.TypInt())
	irbuild.EmitStore(entry, y, seven)
	var x @ir.Instr = irbuild.EmitAlloc(entry, types.TypInt())
	var ytmp @ir.Instr = irbuild.EmitLoad(entry, y, types.TypInt())
	irbuild.EmitStore(entry, x, ytmp)
	var xval @ir.Instr = irbuild.EmitLoad(entry, x, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(xval))

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 {
		return fail("chase: both slots should promote away")
	}
	if lastInstr(entry).Args[0] != seven {
		return fail("chase: x's load must resolve through y's load to the const")
	}
	return ""
}

// A load whose reaching value has a looser type (an untyped-int Signed=false
// const into a signed int64 slot) is grounded: the load becomes an OP_CAST to
// its own type in place (id/type preserved), NOT deleted — so a downstream
// signedness-sensitive op still reads the slot type.  Without this the compare
// would flip signed->unsigned (see conformance matrix/scalar-diff/cmp/64/signed).
func TestMem2regGroundsLooserType() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitAlloc(entry, types.TypInt64())
	irbuild.EmitStore(entry, x, irbuild.EmitConstInt(entry, 0, types.TypUntypedInt()))
	var v @ir.Instr = irbuild.EmitLoad(entry, x, types.TypInt64())
	irbuild.EmitReturn(entry, oneRet(v))

	var loadID int = v.ID
	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_STORE) != 0 {
		return fail("grounding: alloca/store still promoted away")
	}
	// The load survives as an OP_CAST carrying the load's (signed) type.
	if v.Op != iropcode.OP_CAST {
		return fail("grounding: the mismatched-type load should become an OP_CAST")
	}
	if v.ID != loadID {
		return fail("grounding: the cast must keep the load's id")
	}
	if unwrapReprSigned(v.Typ) != true {
		return fail("grounding: the cast must carry the signed slot type")
	}
	if lastInstr(entry).Args[0] != v {
		return fail("grounding: the return should still read the (now-cast) value")
	}
	return ""
}

// unwrapReprSigned reports the Signed flag of t's representation (for the
// grounding assertion).
func unwrapReprSigned(t @types.Type) bool {
	var r @types.Type = ir.PeelToRepr(t)
	if r == nil {
		return false
	}
	return r.Signed
}

// A matching-type reaching value forwards directly (no grounding cast).
func TestMem2regNoGroundMatchingType() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitAlloc(entry, types.TypInt64())
	irbuild.EmitStore(entry, x, irbuild.EmitConstInt64(entry, 7, types.TypInt64()))
	var v @ir.Instr = irbuild.EmitLoad(entry, x, types.TypInt64())
	irbuild.EmitReturn(entry, oneRet(v))

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 ||
			countOp(f, iropcode.OP_CAST) != 0 {
		return fail("no-ground: a matching-type value should forward with no cast")
	}
	return ""
}
