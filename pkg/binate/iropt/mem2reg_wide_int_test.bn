package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for promoting an int wider than the target word (an int64 / uint64 on a
// 32-bit target) — a two-word value its backend copies as a pair.

// int64LoopFunc builds `x := alloca T; x = 0; loop { x = x + 1 }; return x` with T
// the given int type, and returns the func, its loop header and the step.
func int64LoopFunc(t @types.Type) (@ir.Func, @ir.Block, @ir.Instr) {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var x @ir.Instr = irbuild.EmitAlloc(pre, t)
	irbuild.EmitStore(pre, x, irbuild.EmitConstInt64(pre, 0, t))
	irbuild.EmitJump(pre, header)
	irbuild.EmitBranch(header, irbuild.EmitConstBool(header, true), body, exit)
	var cur @ir.Instr = irbuild.EmitLoad(body, x, t)
	var step @ir.Instr = irbuild.EmitBinop(body, iropcode.OP_ADD, cur,
			irbuild.EmitConstInt64(body, 1, t), t)
	irbuild.EmitStore(body, x, step)
	irbuild.EmitJump(body, header)
	irbuild.EmitReturn(exit, oneRet(irbuild.EmitLoad(exit, x, t)))
	return f, header, step
}

// On a 32-bit target a loop-carried int64 and uint64 promote to a header phi of
// their own type, read by the step.
func TestMem2regInt64PromotedOn32BitTarget() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	setTgt(4)
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt64()
	ts[1] = types.TypUint64()
	var msg testing.TestResult = ""
	for i := 0; i < len(ts) && len(msg) == 0; i++ {
		var f @ir.Func
		var header @ir.Block
		var step @ir.Instr
		f, header, step = int64LoopFunc(ts[i])
		promoteFuncScalars(f)
		var phi @ir.Instr = firstPhi(header)
		if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 {
			msg = "32-bit target: a 64-bit int slot should promote"
		} else if phi == nil || types.StripWrappers(phi.Typ).Width != 64 || step.Args[0] != phi {
			msg = "32-bit target: the step should read a 64-bit header phi"
		}
	}
	types.SetTarget(saved)
	return msg
}

// On a 32-bit target EliminatePhis lowers an int64 phi to copies carrying the
// phi's int64 type (each backend moves it as a pair), with no panic.
func TestEliminatePhisInt64On32BitTarget() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	setTgt(4)
	var f @ir.Func
	var header @ir.Block
	var step @ir.Instr
	f, header, step = int64LoopFunc(types.TypInt64())
	promoteFuncScalars(f)
	var phi @ir.Instr = firstPhi(header)
	var phiID int = -1
	if phi != nil { phiID = phi.ID }
	EliminatePhis(f)
	var copies int = 0
	var typed bool = true
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if ins.Op == iropcode.OP_COPY && ins.ID == phiID {
				copies = copies + 1
				var ct @types.Type = types.StripWrappers(ins.Typ)
				typed = typed && ct != nil && ct.Kind == types.TYP_INT && ct.Width == 64
			}
		}
	}
	types.SetTarget(saved)
	if phiID < 0 || copies != 2 {
		return "32-bit target: an int64 phi should become one copy per incoming edge"
	}
	if !typed {
		return "32-bit target: each copy should carry the phi's int64 type"
	}
	if step.Args[0].ID != phiID {
		return "32-bit target: the step should still read the phi's id"
	}
	return ""
}
