package "pkg/binate/iropt"

import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// The whitelist: reads, address computation and register arithmetic write
// nothing; stores, calls and refcount operations are barriers.
func TestOpWritesNothing() testing.TestResult {
	if !OpWritesNothing(iropcode.OP_LOAD) || !OpWritesNothing(iropcode.OP_EXTRACT) ||
			!OpWritesNothing(iropcode.OP_ADD) || !OpWritesNothing(iropcode.OP_GET_FIELD_PTR) {
		return fail("reads, address computation and arithmetic write nothing")
	}
	if OpWritesNothing(iropcode.OP_STORE) || OpWritesNothing(iropcode.OP_CALL) ||
			OpWritesNothing(iropcode.OP_REFDEC) || OpWritesNothing(iropcode.OP_REFINC) {
		return fail("stores, calls and refcount operations are barriers")
	}
	return ""
}
