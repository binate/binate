package "pkg/binate/iropt"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/stdx/slices"

// ============================================================
// IR optimization passes
// ============================================================

// RunOptPasses runs the IR-level optimization passes gated by opt level `level`
// (0 = none, the default).  It is invoked at every lowering boundary — bnc's
// compileModuleVia and its --emit-llvm path, and (once wired) the interpreter's
// lowering path — on the FINALIZED module (after any main-entry / init-dispatcher
// synthesis), so every consumer (the LLVM backend, the native backends, and the
// bytecode VM) sees the same optimized IR from one transform.
//
// The pass list is a plain ordered sequence of calls (no pass-object framework):
// simplest thing that works, and trivially BUILDER-clean.  Passes must be
// idempotent-safe to skip re-running (each lowering boundary runs this once per
// module).
func RunOptPasses(m @ir.Module, level int) {
	if level < 1 {
		return
	}
	// -O1+: within-package function inlining — run FIRST so inlined bodies then
	// get mem2reg + load-forwarding + BCE like any other code.
	inlineCalls(m)
	// -O1+: scalar replacement of non-managed struct aggregates (SROA) — split
	// eligible struct locals into per-field slots so mem2reg (next) can promote
	// the fields, collapsing the field-by-field stack copies the native backends
	// emit.  Runs after inlining (so inlined bodies are covered) and before
	// mem2reg (which promotes the field slots SROA exposes).
	runSroa(m)
	// -O1+: non-managed scalar SSA promotion (mem2reg) — the OP_PHI producer,
	// run first so later passes and the backends see the promoted SSA form.
	promoteScalars(m)
	// -O1+: load-forwarding — coalesce redundant loads of a single-store slot
	// (aggregates too), so e.g. a slice's length loads share one SSA value.
	forwardLoads(m)
	// -O1+: algebraic-identity simplification + dead-constant elimination — fold
	// the `add C,0` / `add V,0` copies IR-gen and mem2reg leave behind, so a
	// named-constant divisor/multiplier reaches the backends as an OP_CONST_INT
	// (enabling constant-divisor strength reduction on named constants) and the
	// dead copies stop being emitted.
	simplifyIdentities(m)
	// -O1+: elide OP_DIV_CHECK guards on a provably-safe constant divisor.  Runs
	// after mem2reg + load-forwarding + simplifyIdentities so a divisor that is a
	// single-store local (e.g. `var d int = K; ... x % d`) or a folded named
	// constant is seen as the constant, not a load — that is what removes the
	// divide-fault CALL from a hot `% K` loop.
	elideSafeDivChecks(m)
	// -O1+: constant-index bounds-check elimination.
	bceConstIndex(m)
	// -O1+: loop bounds-check elimination for induction-variable accesses (needs
	// the mem2reg induction phi and load-forwarding's coalesced length loads).
	bceLoop(m)
	// -O1+: redundant bounds-check elimination — drop a check dominated by an
	// equivalent one (a slot indexed repeatedly, e.g. seed[0] read/write/read).
	bceRedundant(m)
}

// bceConstIndex removes OP_BOUNDS_CHECK(index, length) instructions that are
// provably in-bounds at compile time — index and length are both integer
// constants with 0 <= index < length.
//
// Soundness: a constant length operand can ONLY be a fixed array length.  Every
// bounds check funnels through gen_access.bn's one EmitBoundsCheck site, whose
// length is EmitConstInt(<array length>) for an array (a true, fixed extent) or
// a runtime EmitSliceLen for a slice/managed-slice.  So a const-int length means
// an array access, and index < length then genuinely proves in-bounds.  Slice
// accesses never qualify (their length is not a constant).
//
// The check enforces BOTH bounds on a SIGNED index (rt.BoundsCheck / the VM's
// BC_BOUNDS_CHECK abort on index < 0 || index >= length), so a constant index is
// dropped only when 0 <= index < length.  Every other case is KEPT — crucially a
// constant index that is OUT of range (index < 0 or index >= length): that is a
// genuine runtime fault the program must still take (conformance 310/311/314).
func bceConstIndex(m @ir.Module) {
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @ir.Func = m.Funcs[fi]
		for bi := 0; bi < len(f.Blocks); bi++ {
			bceBlock(f.Blocks[bi])
		}
	}
}

// bceBlock drops the statically-safe OP_BOUNDS_CHECKs from a single block.  It
// scans first and only rebuilds blk.Instrs when at least one check is removable,
// so the common case (nothing to remove) does no allocation.  Rebuilding repoints
// blk.Instrs (the sole view backends and the VM read) at a fresh backing; the old
// backing stays alive via blk.InstrsVec, which still owns every original
// instruction — so a removed check is simply unreachable, not freed early.
//
// CAUTION: the removal lives ONLY in blk.Instrs; blk.InstrsVec is left unpruned.
// That is safe because opt runs as the last mutation before the backend reads
// blk.Instrs — but a future pass that calls addInstr on an already-optimized
// block would reset blk.Instrs = InstrsVec.Items() and resurrect the removed
// checks.  Any new mutating pass must run BEFORE this one, or prune InstrsVec too.
//
// FAULT PADS (VM path): a removed OP_BOUNDS_CHECK's recoverable-fault cleanup pad
// stays in Func.FaultPads (BCE does not prune it), so the VM lowers it as dead
// bytecode.  That is safe: the VM builds its FaultTable by scanning blk.Instrs for
// ops carrying a .PadBlock and mapping the FAULTING OP's pc to its pad — the
// removed check is no longer in blk.Instrs, so nothing maps to the orphaned pad
// and it is never branched to.  (The compiled backends ignore Func.FaultPads
// entirely.)  A later pass could also drop the orphaned pad to save the dead
// bytecode; not needed for correctness.
func bceBlock(blk @ir.Block) {
	var anyRemovable bool = false
	for i := 0; i < len(blk.Instrs); i++ {
		if boundsCheckIsConstSafe(blk.Instrs[i]) {
			anyRemovable = true
		}
	}
	if !anyRemovable {
		return
	}
	var kept @[]@ir.Instr
	for i := 0; i < len(blk.Instrs); i++ {
		if !boundsCheckIsConstSafe(blk.Instrs[i]) {
			kept = slices.Append[@ir.Instr](kept, blk.Instrs[i])
		}
	}
	blk.Instrs = kept
}

// boundsCheckIsConstSafe reports whether `instr` is an OP_BOUNDS_CHECK whose
// index and length operands are both integer constants with 0 <= index < length
// — i.e. statically in-bounds, so the check can be dropped.
func boundsCheckIsConstSafe(instr @ir.Instr) bool {
	if instr.Op != iropcode.OP_BOUNDS_CHECK {
		return false
	}
	if len(instr.Args) < 2 {
		return false
	}
	var idxInstr @ir.Instr = instr.Args[0]
	var lenInstr @ir.Instr = instr.Args[1]
	if idxInstr.Op != iropcode.OP_CONST_INT {
		return false
	}
	if lenInstr.Op != iropcode.OP_CONST_INT {
		return false
	}
	var index int64 = idxInstr.IntVal
	var length int64 = lenInstr.IntVal
	if index < 0 {
		return false
	}
	if index >= length {
		return false
	}
	return true
}

// elideSafeDivChecks removes OP_DIV_CHECK guards whose divisor is a compile-time
// constant that cannot fault the divide.  DivCheck traps only on a zero divisor
// (divide-by-zero) and, for a signed divide, on the INT_MIN / -1 overflow; a
// nonzero constant divisor — not -1 when signed — can trigger neither, so the
// guard and its runtime CALL are dead.
//
// Runs AFTER promoteScalars (mem2reg) + forwardLoads: a divisor that is a
// single-store local — e.g. fasta's `var im int = 139968; ... % im` — is only a
// constant once the load is forwarded, so the elision must see the post-mem2reg
// IR.  Literal divisors (`x / 3`) are already OP_CONST_INT from IR-gen and are
// covered too.
//
// Like bceConstIndex, the removal lives ONLY in blk.Instrs (blk.InstrsVec is left
// unpruned), and a removed check's recoverable-fault pad stays orphaned in
// Func.FaultPads as dead VM bytecode — safe because opt is the last mutation
// before the backends / VM read blk.Instrs, and the VM builds its FaultTable by
// scanning blk.Instrs (nothing maps to or branches to an orphaned pad).  See
// bceBlock's caveats for the full argument.
func elideSafeDivChecks(m @ir.Module) {
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @ir.Func = m.Funcs[fi]
		for bi := 0; bi < len(f.Blocks); bi++ {
			elideDivChecksInBlock(f.Blocks[bi])
		}
	}
}

// elideDivChecksInBlock drops the const-safe OP_DIV_CHECKs from a single block.
// Mirrors bceBlock: scan first, and only rebuild blk.Instrs (repointing it at a
// fresh backing, old backing retained by blk.InstrsVec) when at least one check
// is removable, so the common case allocates nothing.
func elideDivChecksInBlock(blk @ir.Block) {
	var anyRemovable bool = false
	for i := 0; i < len(blk.Instrs); i++ {
		if divCheckIsConstSafe(blk.Instrs[i]) {
			anyRemovable = true
		}
	}
	if !anyRemovable {
		return
	}
	var kept @[]@ir.Instr
	for i := 0; i < len(blk.Instrs); i++ {
		if !divCheckIsConstSafe(blk.Instrs[i]) {
			kept = slices.Append[@ir.Instr](kept, blk.Instrs[i])
		}
	}
	blk.Instrs = kept
}

// divCheckIsConstSafe reports whether instr is an OP_DIV_CHECK whose divisor
// (Args[1]) is a compile-time integer constant that cannot fault: nonzero and,
// for a signed divide (BoolVal true), not -1.
//
// The divisor operand may sit behind ONE cast, which is peeled to reach the
// underlying OP_CONST_INT.  Peeling exactly one level is always sound here,
// because every cast that can be the OUTER cast on Args[1] is value-preserving
// for the zero / -1 test:
//   - EmitDivCheck widens the divisor to 64-bit via ensureInt64ForCheck, an
//     integer sext/zext (preserves 0 and a signed -1);
//   - mem2reg, forwarding a single-store local, retypes an untyped-int constant
//     to the local's integer type — a same-value retype (this is fasta's `im`);
//   - a user narrowing int->int cast can NOT be the outer cast: a divisor
//     narrower than 64-bit gets the widening ensureInt64ForCheck cast layered on
//     TOP, so the user cast is INNER and a single peel lands on it (an OP_CAST,
//     not a constant) and keeps the guard; and nothing narrows TO a >=64-bit type;
//   - a float->int cast leaves an OP_CONST_FLOAT operand, which the OP_CONST_INT
//     test below rejects, keeping the guard.
// The underlying IntVal therefore reads directly in the operation's terms.
func divCheckIsConstSafe(instr @ir.Instr) bool {
	if instr.Op != iropcode.OP_DIV_CHECK {
		return false
	}
	if len(instr.Args) < 2 {
		return false
	}
	var divisor @ir.Instr = instr.Args[1]
	if divisor.Op == iropcode.OP_CAST && len(divisor.Args) == 1 {
		divisor = divisor.Args[0]
	}
	if divisor.Op != iropcode.OP_CONST_INT {
		return false
	}
	if divisor.IntVal == cast(int64, 0) {
		return false
	}
	if instr.BoolVal && divisor.IntVal == cast(int64, 0 - 1) {
		return false
	}
	return true
}
