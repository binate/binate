package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Package-level zero-value slices for fixture construction.
var noParams @[]@ir.Param

var noResults @[]@types.Type

var noArgs @[]@ir.Instr

var noFields @[]@types.Field

func countOp(fn @ir.Func, op int) int {
	var n int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var b @ir.Block = fn.Blocks[i]
		for j := 0; j < len(b.Instrs); j++ {
			if b.Instrs[j].Op == op {
				n = n + 1
			}
		}
	}
	return n
}

// countOpInFunc counts instructions with op across all of fn's blocks.
func countOpInFunc(fn @ir.Func, op int) int {
	var n int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @ir.Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == op { n = n + 1 }
		}
	}
	return n
}

func fail(msg @[]char) testing.TestResult {
	return msg
}

func seq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
