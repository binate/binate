package "pkg/binate/iropt"

import "pkg/binate/irutil"

// The optimization-pass table: OptConfig construction and the pass names that
// bnc / bni's -f<name> / -fno-<name> flags use.

// LevelOptConfig returns the configuration optimization level `level` implies:
// 0 (or below) runs no pass; every level >= 1 runs every pass.
func LevelOptConfig(level int) OptConfig {
	var c OptConfig
	c.InlineThreshold = DEFAULT_INLINE_THRESHOLD
	if level >= 1 {
		for p := 0; p < NUM_OPT_PASSES; p++ {
			c = WithOptPass(c, p, true)
		}
	}
	return c
}

// WithOptPass returns c with pass p switched on (on) or off.  An out-of-range p
// leaves c unchanged.
func WithOptPass(c OptConfig, p int, on bool) OptConfig {
	if p < 0 || p >= NUM_OPT_PASSES {
		return c
	}
	var bit uint = cast(uint, 1) << cast(uint, p)
	if on {
		c.Passes = c.Passes | bit
	} else {
		c.Passes = c.Passes & ~bit
	}
	return c
}

// OptPassEnabled reports whether c runs pass p.
func OptPassEnabled(c OptConfig, p int) bool {
	if p < 0 || p >= NUM_OPT_PASSES {
		return false
	}
	return (c.Passes & (cast(uint, 1) << cast(uint, p))) != 0
}

// OptPassName returns pass p's stable name, or "" for an out-of-range p.
func OptPassName(p int) *[]readonly char {
	switch p {
	case PASS_INLINE:
		return "inline"
	case PASS_SROA:
		return "sroa"
	case PASS_MEM2REG:
		return "mem2reg"
	case PASS_DEAD_PHI:
		return "dead-phi"
	case PASS_LOAD_FWD:
		return "load-fwd"
	case PASS_FIELD_LOAD_FWD:
		return "field-load-fwd"
	case PASS_SIMPLIFY:
		return "simplify"
	case PASS_DIV_CHECK_ELIM:
		return "div-check-elim"
	case PASS_BCE_CONST:
		return "bce-const"
	case PASS_BCE_LOOP:
		return "bce-loop"
	case PASS_BCE_REDUNDANT:
		return "bce-redundant"
	case PASS_LICM:
		return "licm"
	case PASS_FUSE_MADD:
		return "fuse-madd"
	}
	return ""
}

// OptPassByName returns the PASS_* value named `name`, or -1 if none is.
func OptPassByName(name *[]readonly char) int {
	for p := 0; p < NUM_OPT_PASSES; p++ {
		if irutil.Streq(OptPassName(p), name) {
			return p
		}
	}
	return -1
}
