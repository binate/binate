package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/builtins/testing"

// Tests for the pass table and OptConfig (pass_config.bn) and RunOptConfig's
// per-pass gating (opt.bn).

func TestLevelOptConfig() testing.TestResult {
	var c0 OptConfig = LevelOptConfig(0)
	if c0.Passes != 0 { return fail("level 0 must enable no pass") }
	if c0.InlineThreshold != DEFAULT_INLINE_THRESHOLD { return fail("level 0: default threshold") }
	for level := 1; level <= 3; level++ {
		var c OptConfig = LevelOptConfig(level)
		for p := 0; p < NUM_OPT_PASSES; p++ {
			if !OptPassEnabled(c, p) { return fail("levels 1-3 must enable every pass") }
		}
	}
	return ""
}

func TestWithOptPassTogglesOneBit() testing.TestResult {
	var c OptConfig = WithOptPass(LevelOptConfig(1), PASS_LICM, false)
	for p := 0; p < NUM_OPT_PASSES; p++ {
		if OptPassEnabled(c, p) != (p != PASS_LICM) { return fail("only licm should be off") }
	}
	c = WithOptPass(c, PASS_LICM, true)
	if c.Passes != LevelOptConfig(1).Passes { return fail("re-enabling licm should restore -O1") }
	var unchanged OptConfig = WithOptPass(c, NUM_OPT_PASSES, false)
	if unchanged.Passes != c.Passes { return fail("an out-of-range pass must be ignored") }
	if OptPassEnabled(c, -1) || OptPassEnabled(c, NUM_OPT_PASSES) {
		return fail("an out-of-range pass is never enabled")
	}
	return ""
}

func TestOptPassNamesRoundTrip() testing.TestResult {
	for p := 0; p < NUM_OPT_PASSES; p++ {
		var name *[]readonly char = OptPassName(p)
		if len(name) == 0 { return fail("every pass needs a name") }
		if OptPassByName(name) != p { return fail("OptPassByName(OptPassName(p)) != p") }
	}
	if OptPassByName("no-such-pass") != -1 { return fail("unknown name must map to -1") }
	if len(OptPassName(NUM_OPT_PASSES)) != 0 { return fail("out-of-range pass has no name") }
	if NUM_OPT_PASSES > 32 { return fail("OptConfig.Passes is a 32-bit-safe uint mask") }
	for p := 0; p < NUM_OPT_PASSES; p++ {
		var n *[]readonly char = OptPassName(p)
		// -fno-<X> for a pass named "no-<X>" would collide with -fno-<X>'s own flag.
		if len(n) >= 3 && n[0] == 'n' && n[1] == 'o' && n[2] == '-' {
			return fail("a pass name must not start with no-")
		}
	}
	return ""
}

// A config with only bce-const runs just that pass: a statically-safe check goes.
func TestRunOptConfigSinglePass() testing.TestResult {
	var m @ir.Module = bceModuleWith(3, 10)
	var b @ir.Block = m.Funcs[0].Blocks[0]
	RunOptConfig(m, WithOptPass(LevelOptConfig(0), PASS_BCE_CONST, true))
	if countBoundsChecks(b) != 0 { return fail("-fbce-const alone should remove the safe check") }
	return ""
}

// Every pass but bce-const leaves the same check in place.
func TestRunOptConfigAllButOnePass() testing.TestResult {
	var m @ir.Module = bceModuleWith(3, 10)
	var b @ir.Block = m.Funcs[0].Blocks[0]
	RunOptConfig(m, WithOptPass(LevelOptConfig(1), PASS_BCE_CONST, false))
	if countBoundsChecks(b) != 1 { return fail("-fno-bce-const must keep the check") }
	return ""
}

// The VM's set: every pass except inline, sroa, licm and fuse-madd.
func TestVMOptConfigSet() testing.TestResult {
	var c OptConfig = VMOptConfig()
	for p := 0; p < NUM_OPT_PASSES; p++ {
		var out bool = p == PASS_INLINE || p == PASS_SROA || p == PASS_LICM || p == PASS_FUSE_MADD
		if OptPassEnabled(c, p) == out { return fail("VMOptConfig: wrong pass membership") }
	}
	if c.InlineThreshold != DEFAULT_INLINE_THRESHOLD { return fail("VMOptConfig: default threshold") }
	return ""
}

// RunOptConfigFunc optimizes one function and marks it; a marked function is
// not optimized again, and a config that runs nothing leaves it unmarked.
func TestRunOptConfigFuncRunsOnce() testing.TestResult {
	var m @ir.Module = bceModuleWith(3, 10)
	var f @ir.Func = m.Funcs[0]
	var b @ir.Block = f.Blocks[0]
	RunOptConfigFunc(f, LevelOptConfig(0))
	if f.Optimized { return fail("a config that runs nothing must not mark the function") }
	RunOptConfigFunc(f, WithOptPass(LevelOptConfig(0), PASS_SIMPLIFY, true))
	if !f.Optimized { return fail("the function must be marked optimized") }
	RunOptConfigFunc(f, WithOptPass(LevelOptConfig(0), PASS_BCE_CONST, true))
	if countBoundsChecks(b) != 1 { return fail("an optimized function must not be optimized again") }
	return ""
}

// RunOptConfigFunc runs the per-function passes on its own: bce-const removes
// the safe check without the module-level driver.
func TestRunOptConfigFuncSinglePass() testing.TestResult {
	var m @ir.Module = bceModuleWith(3, 10)
	var b @ir.Block = m.Funcs[0].Blocks[0]
	RunOptConfigFunc(m.Funcs[0], WithOptPass(LevelOptConfig(0), PASS_BCE_CONST, true))
	if countBoundsChecks(b) != 0 {
		return fail("RunOptConfigFunc with bce-const should remove the safe check")
	}
	return ""
}
