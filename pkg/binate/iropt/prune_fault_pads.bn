package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/std/cmp"
import "pkg/std/table"
import "pkg/std/vec"

// Fault-pad pruning.  A pass that drops blocks from Func.Blocks (mem2reg's
// unreachable-block prune, branch folding and jump threading, through
// removeUnreachableBlocks) drops with them the fault pads (Func.FaultPads) that
// nothing left can enter: such a pad never runs, and it can read values of the
// dropped blocks, as a pad releases the managed values live at its fault point (a
// call's result, a local declared there).
//
// The VM runs a pad block, and only the VM runs one, when the remaining code enters
// it: from an instruction whose fault lands in it (ir.Instr.PadBlock -- an op of
// Func.Blocks, or of a pad block), from a jump or branch to it (a pad's cleanup can
// branch, and an inlined callee's pad jumps on into its call site's pad), and from
// the block laid out just before it when that block ends without a terminator: VM
// lowering places the pads after Func.Blocks, in their order, and runs from a block
// into the next.  A pad kept keeps its place, so each of these still enters it.  The
// last way is modelled conservatively: a block of Func.Blocks without a terminator is
// invalid IR (irbuild's verifier reports it), and VM lowering appends blocks to
// Func.Blocks after this prune (phi elimination's edge splits, each ending in a jump),
// so keeping the first pad whenever the last block here has none keeps at most a pad
// that never runs.

// pruneFaultPads drops from f.FaultPads every pad block that the code of f.Blocks
// cannot enter, directly or through pad blocks it enters, and keeps the rest in
// their order.  A pad dropped stays allocated as long as f (ir.Func.AddedBlocks).
func pruneFaultPads(f @ir.Func) {
	var np int = len(f.FaultPads)
	if np == 0 { return }
	var idx @table.Table[int, int, ir.AddrHasher, cmp.Default[int]] = table.NewTable[int, int,
			ir.AddrHasher, cmp.Default[int]](
					ir.AddrHasher{}, cmp.Default[int]{})
	for pi := 0; pi < np; pi++ { idx.Put(bit_cast(int, f.FaultPads[pi]), pi) }
	var reached @[]bool = make_slice(bool, np)
	var work @vec.Vec[int] = vec.New[int]()
	for bi := 0; bi < len(f.Blocks); bi++ { reachPadsNamedIn(f.Blocks[bi], idx, reached, work) }
	if len(f.Blocks) > 0 && runsIntoNext(f.Blocks[len(f.Blocks) - 1]) {
		reachPad(0, reached, work)
	}
	for work.Len() > 0 {
		var pi int
		pi, _ = work.Pop()
		reachPadsNamedIn(f.FaultPads[pi], idx, reached, work)
		if pi + 1 < np && runsIntoNext(f.FaultPads[pi]) { reachPad(pi + 1, reached, work) }
	}
	var kept @vec.Vec[@ir.Block] = vec.New[@ir.Block]()
	for pi := 0; pi < np; pi++ {
		if reached[pi] { kept.Push(f.FaultPads[pi]) }
	}
	if kept.Len() == np { return }
	f.FaultPadsVec = kept
	f.FaultPads = kept.Items()
}

// reachPadsNamedIn reaches each pad of f that an instruction of b names, as the pad
// its fault lands in or as a jump or branch target; idx maps a pad's address to its
// index in f.FaultPads.
func reachPadsNamedIn(b @ir.Block, idx @table.Table[int, int, ir.AddrHasher, cmp.Default[int]],
		reached @[]bool, work @vec.Vec[int]) {
	for ii := 0; ii < len(b.Instrs); ii++ {
		var ins @ir.Instr = b.Instrs[ii]
		reachNamedPad(ins.PadBlock, idx, reached, work)
		reachNamedPad(ins.Block1, idx, reached, work)
		reachNamedPad(ins.Block2, idx, reached, work)
	}
}

// reachNamedPad reaches target when it is one of the pads idx maps.
func reachNamedPad(target *ir.Block, idx @table.Table[int, int, ir.AddrHasher, cmp.Default[int]],
		reached @[]bool, work @vec.Vec[int]) {
	if target == nil { return }
	var pi int
	var ok bool
	pi, ok = idx.Get(bit_cast(int, target))
	if ok { reachPad(pi, reached, work) }
}

// reachPad marks pad pi reached and queues its instructions to be walked, unless it is
// reached already.
func reachPad(pi int, reached @[]bool, work @vec.Vec[int]) {
	if reached[pi] { return }
	reached[pi] = true
	work.Push(pi)
}

// runsIntoNext reports whether b ends without a terminator, so the VM runs from it into
// the block laid out after it.
func runsIntoNext(b @ir.Block) bool {
	var n int = len(b.Instrs)
	return n == 0 || !isBlockTerminator(b.Instrs[n - 1].Op)
}
