package "pkg/binate/iropt"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for fault-pad pruning (prune_fault_pads.bn), on its own and in the three
// passes that drop blocks.

// checkInto emits into b a bounds check of the constants 0 and 1 whose fault lands in
// pad.
func checkInto(b @ir.Block, pad @ir.Block) {
	var c0 @ir.Instr = irbuild.EmitConstInt(b, 0, types.TypInt())
	var c1 @ir.Instr = irbuild.EmitConstInt(b, 1, types.TypInt())
	irbuild.EmitBoundsCheck(b, c0, c1)
	b.Instrs[len(b.Instrs) - 1].PadBlock = pad
}

// padsAre reports whether f.FaultPads is exactly want, in order.
func padsAre(f @ir.Func, want @[]@ir.Block) bool {
	if len(f.FaultPads) != len(want) { return false }
	for i := 0; i < len(want); i++ {
		if f.FaultPads[i] != want[i] { return false }
	}
	return true
}

// padsMsg returns msg followed by f.FaultPads' labels, for a failure message.
func padsMsg(msg *[]readonly char, f @ir.Func) @[]char {
	var s @[]char = buf.Concat(msg, "; FaultPads:")
	for i := 0; i < len(f.FaultPads); i++ { s = buf.Concat(buf.Concat(s, " "), f.FaultPads[i].Label) }
	return s
}

// pads2 returns the list (a, b).
func pads2(a @ir.Block, b @ir.Block) @[]@ir.Block {
	var r @[]@ir.Block = make_slice(@ir.Block, 2)
	r[0] = a
	r[1] = b
	return r
}

// A pad is kept when the code of f.Blocks enters it, directly or through pads it
// enters -- by a fault landing in it (padA, and padE, where a fault op of padC lands),
// a jump to it (padB) or by running into it from the pad before it, which ends with no
// terminator (padC) -- and the kept pads keep their order.  A pad nothing enters (padO)
// is dropped, and so is one entered only from such a pad (padP).  FaultPads order:
// padO, padA, padP, padB, padC, padE.
func TestPruneFaultPadsKeepsWhatCodeEnters() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var padO @ir.Block = ir.AddFaultPad(f, "padO")
	var padA @ir.Block = ir.AddFaultPad(f, "padA")
	var padP @ir.Block = ir.AddFaultPad(f, "padP")
	var padB @ir.Block = ir.AddFaultPad(f, "padB")
	var padC @ir.Block = ir.AddFaultPad(f, "padC")
	var padE @ir.Block = ir.AddFaultPad(f, "padE")
	checkInto(entry, padA)
	irbuild.EmitReturn(entry, noArgs)
	irbuild.EmitJump(padO, padP)
	irbuild.EmitUnwindReturn(padP)
	irbuild.EmitJump(padA, padB)
	_ = irbuild.EmitConstInt(padB, 0, types.TypInt())
	checkInto(padC, padE)
	irbuild.EmitUnwindReturn(padC)
	irbuild.EmitUnwindReturn(padE)
	pruneFaultPads(f)
	var want @[]@ir.Block = make_slice(@ir.Block, 4)
	want[0] = padA
	want[1] = padB
	want[2] = padC
	want[3] = padE
	if !padsAre(f, want) {
		return fail(padsMsg("padA, padB, padC and padE are kept, in order; padO and padP go", f))
	}
	if f.FaultPadsVec == nil || f.FaultPadsVec.Len() != 4 {
		return fail("FaultPads' builder holds the four pads kept")
	}
	var pads @[]@ir.Block = f.FaultPads
	var items @[]@ir.Block = f.FaultPadsVec.Items()
	if &pads[0] != &items[0] { return fail("FaultPads stays the view of its builder") }
	var again @ir.Block = ir.AddFaultPad(f, "padN")
	if len(f.FaultPads) != 5 || f.FaultPads[4] != again {
		return fail(padsMsg("a pad added after follows them", f))
	}
	return ""
}

// The pads kept keep their order in f.FaultPads, not the order the code reaches them
// in: the entry's fault lands in padY, which jumps to padX, laid out before it, and padO,
// between them, is dropped.  FaultPads order: padX, padO, padY.
func TestPruneFaultPadsKeepsListOrder() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var padX @ir.Block = ir.AddFaultPad(f, "padX")
	var padO @ir.Block = ir.AddFaultPad(f, "padO")
	var padY @ir.Block = ir.AddFaultPad(f, "padY")
	checkInto(entry, padY)
	irbuild.EmitReturn(entry, noArgs)
	irbuild.EmitUnwindReturn(padX)
	irbuild.EmitUnwindReturn(padO)
	irbuild.EmitJump(padY, padX)
	pruneFaultPads(f)
	if !padsAre(f, pads2(padX, padY)) {
		return fail(padsMsg("padX and padY are kept, padX first as in FaultPads; padO goes", f))
	}
	return ""
}

// The last block of f.Blocks, when it ends with no terminator, runs into the first pad,
// which is kept; a function every pad of which is entered keeps them all.
func TestPruneFaultPadsLastBlockRunsIntoFirstPad() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var padF @ir.Block = ir.AddFaultPad(f, "padF")
	var padG @ir.Block = ir.AddFaultPad(f, "padG")
	_ = irbuild.EmitConstInt(entry, 0, types.TypInt())
	irbuild.EmitJump(padF, padG)
	irbuild.EmitUnwindReturn(padG)
	pruneFaultPads(f)
	if !padsAre(f, pads2(padF, padG)) {
		return fail(padsMsg("padF, run into from entry, and padG are kept", f))
	}
	return ""
}

// mem2reg's prune of the blocks the entry does not reach drops the pad only the dropped
// block's faults land in, and keeps the pad the entry's fault lands in, which one of the
// dropped block's faults lands in too (fault points share a pad).
func TestMem2regPruneDropsOrphanedPad() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var dead @ir.Block = ir.AddBlock(f, "dead")
	var padDead @ir.Block = ir.AddFaultPad(f, "padDead")
	var padLive @ir.Block = ir.AddFaultPad(f, "padLive")
	irbuild.EmitUnwindReturn(padDead)
	irbuild.EmitUnwindReturn(padLive)
	checkInto(entry, padLive)
	irbuild.EmitReturn(entry, noArgs)
	checkInto(dead, padDead)
	checkInto(dead, padLive)
	irbuild.EmitReturn(dead, noArgs)
	promoteFuncScalars(f)
	if len(f.Blocks) != 1 || f.Blocks[0] != entry { return fail("mem2reg drops the dead block") }
	if len(f.FaultPads) != 1 || f.FaultPads[0] != padLive {
		return fail(padsMsg("mem2reg drops padDead with the dead block and keeps padLive", f))
	}
	return ""
}

// Branch folding drops the pad only the arm a constant branch no longer takes reached,
// and keeps the pad of the arm it takes, which a fault of the arm not taken lands in too.
func TestFoldBranchDropsOrphanedPad() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var taken @ir.Block = ir.AddBlock(f, "taken")
	var gone @ir.Block = ir.AddBlock(f, "gone")
	var padLive @ir.Block = ir.AddFaultPad(f, "padLive")
	var padDead @ir.Block = ir.AddFaultPad(f, "padDead")
	irbuild.EmitUnwindReturn(padLive)
	irbuild.EmitUnwindReturn(padDead)
	irbuild.EmitBranch(entry, irbuild.EmitConstBool(entry, true), taken, gone)
	checkInto(taken, padLive)
	irbuild.EmitReturn(taken, noArgs)
	checkInto(gone, padDead)
	checkInto(gone, padLive)
	irbuild.EmitReturn(gone, noArgs)
	foldBranchesFunc(f, false)
	if len(f.Blocks) != 2 || f.Blocks[1] != taken { return fail("the fold drops the arm not taken") }
	if len(f.FaultPads) != 1 || f.FaultPads[0] != padLive {
		return fail(padsMsg("the fold drops padDead with the arm and keeps padLive", f))
	}
	return ""
}

// Jump threading, which drops the blocks no path reaches once it has threaded the jumps,
// drops the pad only such a block's fault lands in, and keeps the pad of the block it
// threads to, which that block's other fault lands in too -- also once the block threaded
// to is merged into the entry.
func TestThreadJumpsDropsOrphanedPad() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var hop @ir.Block = ir.AddBlock(f, "hop")
	var body @ir.Block = ir.AddBlock(f, "body")
	var dead @ir.Block = ir.AddBlock(f, "dead")
	var padDead @ir.Block = ir.AddFaultPad(f, "padDead")
	var padLive @ir.Block = ir.AddFaultPad(f, "padLive")
	irbuild.EmitUnwindReturn(padDead)
	irbuild.EmitUnwindReturn(padLive)
	irbuild.EmitJump(entry, hop)
	irbuild.EmitJump(hop, body)
	checkInto(body, padLive)
	irbuild.EmitReturn(body, noArgs)
	checkInto(dead, padDead)
	checkInto(dead, padLive)
	irbuild.EmitReturn(dead, noArgs)
	threadJumpsFunc(f)
	if len(f.Blocks) != 1 || f.Blocks[0] != entry {
		return fail("threading drops hop and dead, and merges body into the entry")
	}
	if len(f.FaultPads) != 1 || f.FaultPads[0] != padLive {
		return fail(padsMsg("threading drops padDead with dead and keeps padLive", f))
	}
	return ""
}
