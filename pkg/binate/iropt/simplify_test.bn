package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// foldIntCastValue implements the cast value semantics: low width bits,
// sign/zero-extended.
func TestFoldIntCastValue() testing.TestResult {
	// Widening keeps the value.
	if foldIntCastValue(cast(int64, 7), types.TypInt64()) != cast(int64, 7) {
		return "widen 7 to int64"
	}
	if foldIntCastValue(cast(int64, -7), types.TypInt64()) != cast(int64, -7) {
		return "widen -7 to int64"
	}
	// Narrow to int8: 200 (0xC8) has bit 7 set → sign-extends to -56.
	if foldIntCastValue(cast(int64, 200), types.TypInt8()) != cast(int64, -56) {
		return "narrow 200 to int8 = -56"
	}
	// Narrow to uint8: zero-extends → 200.
	if foldIntCastValue(cast(int64, 200), types.TypUint8()) != cast(int64, 200) {
		return "narrow 200 to uint8 = 200"
	}
	// Narrow drops the high word.
	if foldIntCastValue(cast(int64, 4294967301), types.TypInt32()) != cast(int64, 5) {
		return "narrow 0x100000005 to int32 = 5"
	}
	// Signedness reinterpret: int -1 → uint32 low bits = 0xFFFFFFFF.
	if foldIntCastValue(cast(int64, -1), types.TypUint32()) != cast(int64, 4294967295) {
		return "cast -1 to uint32 = 4294967295"
	}
	return ""
}

func mkConstInt(v int64) @ir.Instr {
	var c @ir.Instr = make(ir.Instr)
	c.Op = iropcode.OP_CONST_INT
	c.IntVal = v
	c.Typ = types.TypInt()
	return c
}

func mkBinop(op int, a @ir.Instr, b @ir.Instr) @ir.Instr {
	var r @ir.Instr = make(ir.Instr)
	r.Op = op
	r.Typ = types.TypInt()
	r.Args = make_slice(@ir.Instr, 2)
	r.Args[0] = a
	r.Args[1] = b
	return r
}

// identityReplacement returns the surviving operand for algebraic identities and
// nil otherwise; commuted forms fold only where the op is commutative.
func TestIdentityReplacement() testing.TestResult {
	var x @ir.Instr = make(ir.Instr)
	x.ID = 1
	x.Op = iropcode.OP_PARAM
	x.Typ = types.TypInt()
	var c0 @ir.Instr = mkConstInt(cast(int64, 0))
	var c1 @ir.Instr = mkConstInt(cast(int64, 1))
	if identityReplacement(mkBinop(iropcode.OP_ADD, x, c0)) != x {
		return "add x,0 = x"
	}
	if identityReplacement(mkBinop(iropcode.OP_ADD, c0, x)) != x {
		return "add 0,x = x (commuted)"
	}
	if identityReplacement(mkBinop(iropcode.OP_SUB, x, c0)) != x {
		return "sub x,0 = x"
	}
	// sub is NOT commutative: sub 0,x must NOT fold.
	if identityReplacement(mkBinop(iropcode.OP_SUB, c0, x)) != nil {
		return "sub 0,x must not fold"
	}
	if identityReplacement(mkBinop(iropcode.OP_MUL, x, c1)) != x {
		return "mul x,1 = x"
	}
	if identityReplacement(mkBinop(iropcode.OP_SHL, x, c0)) != x {
		return "shl x,0 = x"
	}
	// shl is NOT commutative: shl 0,x must NOT fold.
	if identityReplacement(mkBinop(iropcode.OP_SHL, c0, x)) != nil {
		return "shl 0,x must not fold"
	}
	// add x,1 is not an identity.
	if identityReplacement(mkBinop(iropcode.OP_ADD, x, c1)) != nil {
		return "add x,1 is not an identity"
	}
	return ""
}

// foldCastConst mutates OP_CAST(OP_CONST_INT) into OP_CONST_INT in place.
func TestFoldCastConst() testing.TestResult {
	var c @ir.Instr = mkConstInt(cast(int64, 139968))
	var castIns @ir.Instr = make(ir.Instr)
	castIns.Op = iropcode.OP_CAST
	castIns.Typ = types.TypInt()
	castIns.Args = make_slice(@ir.Instr, 1)
	castIns.Args[0] = c
	if !foldCastConst(castIns) {
		return "should fold OP_CAST of const"
	}
	if castIns.Op != iropcode.OP_CONST_INT {
		return "cast should become OP_CONST_INT"
	}
	if castIns.IntVal != cast(int64, 139968) {
		return "folded value should be 139968"
	}
	if len(castIns.Args) != 0 {
		return "folded const should have no args"
	}
	// A narrowing cast folds to the truncated value.
	var big @ir.Instr = mkConstInt(cast(int64, 200))
	var narrow @ir.Instr = make(ir.Instr)
	narrow.Op = iropcode.OP_CAST
	narrow.Typ = types.TypInt8()
	narrow.Args = make_slice(@ir.Instr, 1)
	narrow.Args[0] = big
	if !foldCastConst(narrow) || narrow.IntVal != cast(int64, -56) {
		return "narrowing cast 200->int8 should fold to -56"
	}
	// A cast of a non-const must NOT fold.
	var v @ir.Instr = make(ir.Instr)
	v.ID = 9
	v.Op = iropcode.OP_PARAM
	v.Typ = types.TypInt()
	var castV @ir.Instr = make(ir.Instr)
	castV.Op = iropcode.OP_CAST
	castV.Typ = types.TypInt()
	castV.Args = make_slice(@ir.Instr, 1)
	castV.Args[0] = v
	if foldCastConst(castV) {
		return "cast of a non-const must not fold"
	}
	return ""
}
