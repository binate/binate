package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for extract sinking (sink_extract.bn).

// sinkStructType builds a struct with n int fields f0..f(n-1).
func sinkStructType(n int) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		var fd @types.Field = make(types.Field)
		fd.Name = "f"
		fd.Type = types.TypInt()
		fields[i] = fd
	}
	return types.MakeStructType("S", fields)
}

// indexIn returns the index of ins in blk, or -1.
func indexIn(blk @ir.Block, ins @ir.Instr) int {
	for i := 0; i < len(blk.Instrs); i++ {
		if blk.Instrs[i] == ins { return i }
	}
	return -1
}

// sinkReturn ends blk with a void return.
func sinkReturn(blk @ir.Block) {
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(blk, noRet)
}

// Three fields read together, then used one at a time: each extract moves to
// just before its use, so only one field is in flight at a time.
func TestSinkExtractsToFirstUse() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = sinkStructType(3)
	var x @ir.Instr = irbuild.EmitAlloc(entry, st)
	var ld @ir.Instr = irbuild.EmitLoad(entry, x, st)
	var e0 @ir.Instr = irbuild.EmitExtract(entry, ld, 0, types.TypInt())
	var e1 @ir.Instr = irbuild.EmitExtract(entry, ld, 1, types.TypInt())
	var e2 @ir.Instr = irbuild.EmitExtract(entry, ld, 2, types.TypInt())
	var t0 @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, e0, e0, types.TypInt())
	var t1 @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, e1, t0, types.TypInt())
	var t2 @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, e2, t1, types.TypInt())
	irbuild.EmitStore(entry, x, irbuild.EmitConstNil(entry, st))
	_ = t2
	sinkReturn(entry)

	sinkExtractsFunc(f)

	if indexIn(entry, e0) + 1 != indexIn(entry, t0) {
		return fail("f0 should sit just before its use")
	}
	if indexIn(entry, e1) + 1 != indexIn(entry, t1) {
		return fail("f1 should sit just before its use")
	}
	if indexIn(entry, e2) + 1 != indexIn(entry, t2) {
		return fail("f2 should sit just before its use")
	}
	if indexIn(entry, ld) + 1 != indexIn(entry, e0) { return fail("the load should stay in place") }
	if len(entry.Instrs) != 11 { return fail("sinking must neither add nor drop instructions") }
	return ""
}

// An extract never moves past an instruction that may write memory: a backend
// may read the field straight from the load's source, which a store in between
// could change.
func TestSinkExtractStopsAtStore() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = sinkStructType(2)
	var x @ir.Instr = irbuild.EmitAlloc(entry, st)
	var y @ir.Instr = irbuild.EmitAlloc(entry, types.TypInt())
	var ld @ir.Instr = irbuild.EmitLoad(entry, x, st)
	var e0 @ir.Instr = irbuild.EmitExtract(entry, ld, 0, types.TypInt())
	var one @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	irbuild.EmitStore(entry, y, one)
	var t0 @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, e0, one, types.TypInt())
	irbuild.EmitStore(entry, y, t0)
	sinkReturn(entry)

	sinkExtractsFunc(f)

	var store int = -1
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_STORE && store < 0 { store = i }
	}
	if indexIn(entry, e0) > store { return fail("the extract must not cross the store") }
	if indexIn(entry, e0) + 1 != store { return fail("the extract should sink up to the store") }
	return ""
}

// A use in another block pins the extract where it is.
func TestSinkExtractPinnedByOtherBlockUse() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var next @ir.Block = ir.AddBlock(f, "next")
	var st @types.Type = sinkStructType(2)
	var x @ir.Instr = irbuild.EmitAlloc(entry, st)
	var ld @ir.Instr = irbuild.EmitLoad(entry, x, st)
	var e0 @ir.Instr = irbuild.EmitExtract(entry, ld, 0, types.TypInt())
	var one @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	var t0 @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, e0, one, types.TypInt())
	irbuild.EmitJump(entry, next)
	var t1 @ir.Instr = irbuild.EmitBinop(next, iropcode.OP_ADD, e0, t0, types.TypInt())
	_ = t1
	sinkReturn(next)

	sinkExtractsFunc(f)

	if indexIn(entry, e0) != indexIn(entry, ld) + 1 {
		return fail("an extract used in another block must stay in place")
	}
	return ""
}

// An extract of an extract: both sink, the inner one ahead of the outer, and
// both ahead of the use.
func TestSinkExtractChain() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var inner @types.Type = sinkStructType(2)
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var fa @types.Field = make(types.Field)
	fa.Name = "p"
	fa.Type = inner
	var fb @types.Field = make(types.Field)
	fb.Name = "z"
	fb.Type = types.TypInt()
	fields[0] = fa
	fields[1] = fb
	var outer @types.Type = types.MakeStructType("Q", fields)
	var x @ir.Instr = irbuild.EmitAlloc(entry, outer)
	var ld @ir.Instr = irbuild.EmitLoad(entry, x, outer)
	var ep @ir.Instr = irbuild.EmitExtract(entry, ld, 0, inner)
	var ea @ir.Instr = irbuild.EmitExtract(entry, ep, 1, types.TypInt())
	var one @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	var two @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, one, one, types.TypInt())
	var t0 @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, ea, two, types.TypInt())
	_ = t0
	sinkReturn(entry)

	sinkExtractsFunc(f)

	var ipos int = indexIn(entry, ep)
	var apos int = indexIn(entry, ea)
	if ipos + 1 != apos || apos + 1 != indexIn(entry, t0) {
		return fail("the extract chain should sink, in order, to just before its use")
	}
	if ipos <= indexIn(entry, two) { return fail("the chain should move past the unrelated add") }
	return ""
}

// sinkPE builds a two-entry phi operand list.
func sinkPE(b1 @ir.Block, v1 @ir.Instr, b2 @ir.Block, v2 @ir.Instr) @[]ir.PhiEntry {
	var es @[]ir.PhiEntry = make_slice(ir.PhiEntry, 2)
	es[0].Block = b1
	es[0].Val = v1
	es[1].Block = b2
	es[1].Val = v2
	return es
}

// A use by a phi of the extract's own block (a loop back edge) pins it: the
// phi reads the value at the end of the block, not at a later instruction.
func TestSinkExtractPinnedByPhiUse() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var loop @ir.Block = ir.AddBlock(f, "loop")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var st @types.Type = sinkStructType(2)
	var x @ir.Instr = irbuild.EmitAlloc(entry, st)
	var zero @ir.Instr = irbuild.EmitConstInt(entry, 0, types.TypInt())
	irbuild.EmitJump(entry, loop)
	var phi @ir.Instr = irbuild.EmitPhi(loop, types.TypInt(), sinkPE(entry, zero, entry, zero))
	var ld @ir.Instr = irbuild.EmitLoad(loop, x, st)
	var e0 @ir.Instr = irbuild.EmitExtract(loop, ld, 0, types.TypInt())
	var one @ir.Instr = irbuild.EmitConstInt(loop, 1, types.TypInt())
	var t @ir.Instr = irbuild.EmitBinop(loop, iropcode.OP_ADD, e0, one, types.TypInt())
	var c @ir.Instr = irbuild.EmitBinop(loop, iropcode.OP_LT, t, phi, types.TypBool())
	irbuild.EmitBranch(loop, c, loop, exit)
	phi.Phis = sinkPE(entry, zero, loop, e0)
	sinkReturn(exit)

	sinkExtractsFunc(f)

	if indexIn(loop, e0) != indexIn(loop, ld) + 1 { return fail("a phi use must pin the extract") }
	return ""
}

// A use in a fault pad pins the extract.
func TestSinkExtractPinnedByPadUse() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	var st @types.Type = sinkStructType(2)
	var x @ir.Instr = irbuild.EmitAlloc(entry, st)
	var ld @ir.Instr = irbuild.EmitLoad(entry, x, st)
	var e0 @ir.Instr = irbuild.EmitExtract(entry, ld, 0, types.TypInt())
	var one @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	var t @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, e0, one, types.TypInt())
	_ = t
	sinkReturn(entry)
	var pt @ir.Instr = irbuild.EmitBinop(pad, iropcode.OP_ADD, e0, e0, types.TypInt())
	_ = pt
	irbuild.EmitUnwindReturn(pad)

	sinkExtractsFunc(f)

	if indexIn(entry, e0) != indexIn(entry, ld) + 1 {
		return fail("a fault-pad use must pin the extract")
	}
	return ""
}

// An extract used only by the block's terminator sinks to just before it.
func TestSinkExtractToTerminator() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = sinkStructType(2)
	var x @ir.Instr = irbuild.EmitAlloc(entry, st)
	var ld @ir.Instr = irbuild.EmitLoad(entry, x, st)
	var e0 @ir.Instr = irbuild.EmitExtract(entry, ld, 0, types.TypInt())
	var one @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	var two @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, one, one, types.TypInt())
	_ = two
	var rv @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rv[0] = e0
	irbuild.EmitReturn(entry, rv)

	sinkExtractsFunc(f)

	var n int = len(entry.Instrs)
	if indexIn(entry, e0) != n - 2 { return fail("the extract should sit just before the return") }
	return ""
}

// Two unrelated extracts whose first use is the same instruction keep their
// original order ahead of it.
func TestSinkExtractSharedAnchorKeepsOrder() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = sinkStructType(2)
	var x @ir.Instr = irbuild.EmitAlloc(entry, st)
	var ld @ir.Instr = irbuild.EmitLoad(entry, x, st)
	var e0 @ir.Instr = irbuild.EmitExtract(entry, ld, 0, types.TypInt())
	var e1 @ir.Instr = irbuild.EmitExtract(entry, ld, 1, types.TypInt())
	var one @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	var t @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, e1, e0, types.TypInt())
	_ = t
	_ = one
	sinkReturn(entry)

	sinkExtractsFunc(f)

	var tp int = indexIn(entry, t)
	if indexIn(entry, e0) != tp - 2 || indexIn(entry, e1) != tp - 1 {
		return fail("both extracts should sit before their shared use, in original order")
	}
	return ""
}

// An extract whose user is itself an extract held back by a store: the user
// stops at the store, and the inner extract lands just before it.
func TestSinkExtractChainStopsAtStore() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var inner @types.Type = sinkStructType(2)
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var fa @types.Field = make(types.Field)
	fa.Name = "p"
	fa.Type = inner
	fields[0] = fa
	var outer @types.Type = types.MakeStructType("Q", fields)
	var x @ir.Instr = irbuild.EmitAlloc(entry, outer)
	var y @ir.Instr = irbuild.EmitAlloc(entry, types.TypInt())
	var ld @ir.Instr = irbuild.EmitLoad(entry, x, outer)
	var ep @ir.Instr = irbuild.EmitExtract(entry, ld, 0, inner)
	var one @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	var ea @ir.Instr = irbuild.EmitExtract(entry, ep, 1, types.TypInt())
	var two @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, one, one, types.TypInt())
	irbuild.EmitStore(entry, y, two)
	var t @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, ea, one, types.TypInt())
	irbuild.EmitStore(entry, y, t)
	sinkReturn(entry)

	sinkExtractsFunc(f)

	var store int = -1
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == iropcode.OP_STORE && store < 0 { store = i }
	}
	if indexIn(entry, ea) != store - 1 || indexIn(entry, ep) != store - 2 {
		return fail("the chain should stop, in order, just before the store")
	}
	return ""
}
