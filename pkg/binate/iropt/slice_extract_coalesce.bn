package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/std/vec"

// coalesceSliceExtracts hoists a materialized slice value's field extracts to one
// canonical OP_EXTRACT per field, placed right after that value's definition.
//
// After RLE (applyRLE) forwards every load of a slice slot to a single
// materializing OP_LOAD `l0` — a >16 B raw/managed slice value that SPILLS on the
// native backends — each `a[i]` access still re-extracts the slice's base (field 0)
// and length (field 1).  On native those extracts lower to a field load off l0's
// spill slot EVERY iteration (the reload storm the scaled-addressing fold rides on:
// `ldr base,[hdr]; ldr len,[hdr+8]` per access).  Because l0 dominates every use
// and, when it materializes a param/loop-invariant slice before a loop, is itself
// loop-invariant, one extract per field placed right after l0 is a homed scalar
// reused across the loop — so the per-access reload becomes a register read.  LLVM's
// GVN/LICM already does this on the clang path; the native backends do not, so this
// is a native<->LLVM gap closer done at the IR level (it also shrinks the clang IR
// harmlessly — clang re-runs its own GVN).
//
// Correctness: an OP_EXTRACT is a pure value read (no refcount effect), so
// redirecting its uses and dropping the duplicate leaves the refcount trajectory
// byte-identical.  Only extracts whose aggregate operand IS l0 are touched, and SSA
// dominance holds by transitivity: every gathered extract E reads l0, so l0
// dominates E, so l0 — and the canonical placed right after it — dominates every use
// of E (a normal-block use, a phi operand measured at its predecessor edge, or a
// fault-pad use alike).  This needs no assumption about WHERE l0 sits.
//
// Fault-pad extracts of an l0 keep their own (cold) instructions; only their uses
// of a dropped normal extract are redirected — the canonical after l0 dominates the
// pads.
//
// All the l0s are coalesced together — one scan of the function, one rebuild, one
// rewrite of the uses: each l0 is a distinct fresh load (applyRLE), never an
// extract of another, so coalescing one leaves the others' extracts alone.  The
// canonicals are made l0 by l0, each l0's in the order its field indices are first
// seen.  An l0 listed twice, outside f's ids, or itself one of the extracts being
// dropped breaks that, and panics.
func coalesceSliceExtracts(f @ir.Func, l0s @[]@ir.Instr) {
	var oldCap int = f.NextID
	// Each l0's index in l0s, by id (-1: not an l0).
	var l0At @[]int = make_slice(int, oldCap)
	for id := 0; id < oldCap; id++ {
		l0At[id] = -1
	}
	for i := 0; i < len(l0s); i++ {
		if l0s[i] == nil {
			continue
		}
		if l0s[i].ID < 0 || l0s[i].ID >= oldCap || l0At[l0s[i].ID] >= 0 {
			panic("coalesceSliceExtracts: an l0 outside the function's ids, or listed twice")
		}
		l0At[l0s[i].ID] = i
	}

	// Each l0's normal-block extracts, in block order.  Scan normal blocks only:
	// that is where the l0s and the hot per-access extracts live.
	var extractsOf @[]@vec.Vec[@ir.Instr] = make_slice(@vec.Vec[@ir.Instr], len(l0s))
	var found bool = false
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var ins @ir.Instr = blk.Instrs[ii]
			var li int = extractedL0(ins, l0s, l0At, oldCap)
			if li < 0 {
				continue
			}
			if extractsOf[li] == nil {
				extractsOf[li] = vec.New[@ir.Instr]()
			}
			extractsOf[li].Push(ins)
			found = true
		}
	}
	if !found {
		return
	}

	// One canonical extract per l0 and distinct field index: made l0 by l0, each
	// l0's in the order its field indices are first seen.  replByID maps each
	// gathered extract to its canonical, and deleted marks it for dropping.
	var replByID @[]@ir.Instr = instrTable(oldCap)
	var deleted @[]bool = boolTable(oldCap)
	var canonOf @[]@[]@ir.Instr = make_slice(@[]@ir.Instr, len(l0s))
	for i := 0; i < len(l0s); i++ {
		if extractsOf[i] == nil {
			continue
		}
		var idxSeen @vec.Vec[int] = vec.New[int]()
		var canon @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
		var exts @[]@ir.Instr = extractsOf[i].Items()
		for k := 0; k < len(exts); k++ {
			var ins @ir.Instr = exts[k]
			var c @ir.Instr = findCanonExtract(idxSeen.Items(), canon.Items(), ins.Index)
			if c == nil {
				c = ir.NewInstr(f, iropcode.OP_EXTRACT, ins.Typ)
				c.Args = irbuild.MakeArgs1(l0s[i])
				c.Index = ins.Index
				idxSeen.Push(ins.Index)
				canon.Push(c)
			}
			if ins.ID >= 0 && ins.ID < oldCap {
				replByID[ins.ID] = c
				deleted[ins.ID] = true
			}
		}
		canonOf[i] = canon.Items()
	}

	// The dropped extracts, kept alive until their uses (a phi's among them, which
	// does not own its operand) are redirected below.
	var dropped @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
	// Rebuild normal blocks: drop the coalesced extracts, and emit each l0's
	// canonicals right after its own instruction (an l0 lives in a normal block).
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		var kept @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var ins @ir.Instr = blk.Instrs[ii]
			if ins.ID >= 0 && ins.ID < oldCap && deleted[ins.ID] {
				if l0At[ins.ID] >= 0 {
					panic("coalesceSliceExtracts: an l0 is an extract of another l0")
				}
				dropped.Push(ins)
				continue
			}
			kept.Push(ins)
			if ins.ID >= 0 && ins.ID < oldCap && l0At[ins.ID] >= 0 && l0s[l0At[ins.ID]] == ins {
				var canon @[]@ir.Instr = canonOf[l0At[ins.ID]]
				for k := 0; k < len(canon); k++ {
					kept.Push(canon[k])
				}
			}
		}
		blk.Instrs = kept.Items()
	}

	// Redirect every remaining use of a coalesced extract to its canonical (normal
	// blocks AND fault pads).  Pass oldCap: the canonicals have IDs >= oldCap, so
	// chaseRepl leaves them (and their l0 operand) untouched, mapping only the
	// dropped originals.
	rewriteUsesInBlocks(f.Blocks, replByID, oldCap)
	rewriteUsesInBlocks(f.FaultPads, replByID, oldCap)

	// Tripwire (matches applyRLE / applyPromotion / field-forward): no reference to a
	// dropped extract may survive the rewrite.  No alloca is deleted here, so the
	// alloca-deletion flags are all-false.
	var noAllocaDeleted @[]bool = make_slice(bool, oldCap)
	assertNoSurvivingUses(f.Blocks, replByID, noAllocaDeleted, oldCap)
	assertNoSurvivingUses(f.FaultPads, replByID, noAllocaDeleted, oldCap)
}

// extractedL0 returns the index in l0s of the l0 that ins is an OP_EXTRACT of
// (l0At maps an l0's id below cap to that index), or -1.
func extractedL0(ins @ir.Instr, l0s @[]@ir.Instr, l0At @[]int, cap int) int {
	if ins.Op != iropcode.OP_EXTRACT || len(ins.Args) < 1 {
		return -1
	}
	var x @ir.Instr = ins.Args[0]
	if x == nil || x.ID < 0 || x.ID >= cap || l0At[x.ID] < 0 || l0s[l0At[x.ID]] != x {
		return -1
	}
	return l0At[x.ID]
}

// findCanonExtract returns the canonical extract already created for field index
// `index` (parallel arrays idxSeen/canon), or nil if none yet.
func findCanonExtract(idxSeen @[]int, canon @[]@ir.Instr, index int) @ir.Instr {
	for k := 0; k < len(idxSeen); k++ {
		if idxSeen[k] == index {
			return canon[k]
		}
	}
	var none @ir.Instr
	return none
}
