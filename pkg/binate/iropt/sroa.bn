package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/std/vec"

import "pkg/binate/irutil"

import "pkg/binate/iropcode"
import "pkg/binate/types"

// SROA (scalar replacement of aggregates) — Phase 0: eligibility analysis only.
//
// The native↔LLVM -O2 gap is dominated by aggregate-header copy traffic: the
// native backends materialize slice / struct locals in stack slots and copy
// them field-by-field slot→slot, where LLVM keeps the scalarized fields in
// registers.  SROA scalar-replaces an eligible aggregate alloca with one alloca
// per field, after which mem2reg (promoteScalars) promotes the non-managed
// fields to SSA and the copies collapse.  Design: explorations/plan-ir-sroa.md.
//
// This file is the analysis + a fail-loud validator — NO IR mutation.  It
// identifies which aggregate allocas are splittable (the L1 + L2 contract
// below) and classifies them managed / non-managed (the Phase 1 vs Phase 2
// split).  The rewrite is a later phase that consumes collectSroaCandidates.
//
// THE IR MODEL this rests on (verified against the gen path):
//   - A STRUCT local is field-accessed via OP_GET_FIELD_PTR(alloca, constIdx)
//     then load/store (gen_selector.bn / gen_selector_ptr.bn); it is
//     whole-OP_LOAD'd / whole-OP_STORE'd only for a whole-value use (init from
//     a composite, copy, return, by-value arg, &s).
//   - A SLICE local is whole-OP_LOAD'd to a value, and len / element / data are
//     read via OP_EXTRACT on that value (ir_ops.bn EmitSliceLen /
//     EmitSliceElemPtr); it is whole-OP_STORE'd on assignment.
// So splittability is a TWO-LEVEL check: L1 over the alloca's uses, L2 over the
// values produced by whole loads of it.
//
// NESTING: a field that is itself an aggregate is handled by RECURSION.
// Field-by-field access of a nested aggregate reads/writes through an inner
// OP_GET_FIELD_PTR whose base is the outer field-ptr (not the alloca);
// fieldPtrChainScalarReplaceable recurses through that chain, so the outer slot
// is still splittable and becomes per-field slots — one of them the nested
// aggregate.  The SROA fixpoint re-collects that nested field slot and splits it
// on a later pass, one nesting level per pass, until the whole nest is scalars
// mem2reg can promote.  The eligibility gate (aggregateFieldsScalarReplaceable)
// admits a nested-aggregate field because the backend zero-fills its slot.

// isSroaAggregateType reports whether t (peeled) is an aggregate SROA can
// scalar-replace: a struct, or a slice (raw *[]T or managed @[]T).  Arrays are
// excluded — their element access is a dynamic OP_GET_ELEM_PTR on the slot, and
// scalar-replacing an [N]T would explode into N field slots; they are not the
// header-copy traffic SROA targets.
func isSroaAggregateType(t @types.Type) bool {
	t = irutil.PeelTransparent(t)
	if t == nil {
		return false
	}
	return t.Kind == types.TYP_STRUCT || t.Kind == types.TYP_SLICE || t.Kind == types.TYP_MANAGED_SLICE
}

// isSroaAggregateAlloca reports whether instr is an OP_ALLOC of an SROA
// aggregate type (its element type, TypeArg, is struct / slice).
func isSroaAggregateAlloca(instr @ir.Instr) bool {
	if instr.Op != iropcode.OP_ALLOC {
		return false
	}
	return isSroaAggregateType(instr.TypeArg)
}

// sroaAggregateContainsManaged reports whether the aggregate type t holds any
// managed reference (transitively): a managed pointer / slice / func-value /
// interface value, directly or inside a nested struct or array element.  Drives
// the Phase 1 (non-managed, hazard-free) vs Phase 2 (managed, refcount + fault-
// pad rework) split: a non-managed aggregate's field slots are all mem2reg-
// promotable and the slot never appears in a FaultPad.  A raw slice *[]T is
// itself non-managed (it borrows; its header owns no refcount), so its element
// type is irrelevant here; a managed slice @[]T is caught directly.
func sroaAggregateContainsManaged(t @types.Type) bool {
	t = irutil.PeelTransparent(t)
	if t == nil {
		return false
	}
	if irutil.IsManagedScalarType(t) {
		return true
	}
	if t.Kind == types.TYP_STRUCT {
		for i := 0; i < len(t.Fields); i++ {
			if sroaAggregateContainsManaged(t.Fields[i].Type) {
				return true
			}
		}
		return false
	}
	if t.Kind == types.TYP_ARRAY {
		return sroaAggregateContainsManaged(t.Elem)
	}
	return false
}

// collectSroaCandidates returns every aggregate alloca in f that SROA may
// scalar-replace: an OP_ALLOC of a struct / slice whose uses satisfy both L1
// (its alloca uses are only whole load/store + const-index field-ptr, and it
// never appears in a FaultPad) and L2 (every whole-loaded value's uses are all
// OP_EXTRACT).  Phase 0: pure analysis, no IR mutation.  The managed / non-
// managed axis (Phase 1 vs Phase 2) is orthogonal — see
// sroaAggregateContainsManaged.
func collectSroaCandidates(f @ir.Func) @[]@ir.Instr {
	return collectSroaCandidatesIn(f, buildUseIndex(f))
}

// collectSroaCandidatesIn is collectSroaCandidates with a use index of f's
// current IR.
func collectSroaCandidatesIn(f @ir.Func, ui @useIndex) @[]@ir.Instr {
	var out @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @ir.Instr = blk.Instrs[ii]
			if !isSroaAggregateAlloca(instr) {
				continue
			}
			if !sroaAllocaL1OK(ui, instr) {
				continue
			}
			if !sroaLoadedValuesAllExtract(ui, instr) {
				continue
			}
			out.Push(instr)
		}
	}
	return out.Items()
}

// sroaAllocaL1OK reports whether every use of aggregate alloca `a` is an
// L1-splittable use: the Args[0] pointer of a whole OP_LOAD or whole OP_STORE,
// or a (constant-index) OP_GET_FIELD_PTR whose own result chain is
// scalar-replaceable — used only as a load/store Args[0], or as the base of a
// deeper nested field-ptr (o.inner.x), recursively.  ANY other appearance pins
// the slot: the alloca as a value operand (its address escaping via a call arg,
// OP_RETURN, or an OP_STORE Args[1]), a dynamic OP_GET_ELEM_PTR, a PhiEntry.Val,
// or ANY appearance inside a FaultPad (matching mem2reg — and mandatory for a
// managed aggregate, whose refcount cleanup reads the whole value in pads).
func sroaAllocaL1OK(ui @useIndex, a @ir.Instr) bool {
	var us @[]valueUse = ui.usesOf(a)
	for i := 0; i < len(us); i++ {
		if us[i].inPad || !useIsL1(ui, us[i], false) {
			return false
		}
	}
	return true
}

// useIsL1 reports whether read u of an alloca (or of a field-ptr on one) is a
// valid L1 use (see sroaAllocaL1OK): the Args[0] pointer of a load or store, or
// the Args[0] base of a field-ptr whose own chain is scalar-replaceable
// (fieldPtrChainScalarReplaceable, recursing through nested field access).
func useIsL1(ui @useIndex, u valueUse, padAware bool) bool {
	if u.argIdx < 0 {
		return false // a phi entry
	}
	var op int = u.user.Op
	if u.argIdx == 0 && (op == iropcode.OP_LOAD || op == iropcode.OP_STORE) {
		return true
	}
	return u.argIdx == 0 && op == iropcode.OP_GET_FIELD_PTR &&
			fieldPtrChainScalarReplaceable(ui, u.user, padAware)
}

// fieldPtrChainScalarReplaceable reports whether the result of field-ptr instr
// fp is consumed only by uses that keep fp's owning slot scalar-replaceable: the
// Args[0] pointer of a plain load/store, OR the Args[0] base of an inner
// constant-index OP_GET_FIELD_PTR whose own result chain recursively satisfies
// the same.  The recursive case is nested struct field access (o.inner.x): the
// inner field-ptr's base is the outer field-ptr, and after the split the rewrite
// redirects that base onto the outer field's slot (rewriteUsesInBlocks /
// chaseRepl), so the inner field-ptr becomes a plain field-ptr on the slot and
// the fixpoint scalar-replaces it on a later pass.  Any other use — the address
// escaping via a call arg, &s.x, a phi entry, or a dynamic OP_GET_ELEM_PTR, or
// ANY FaultPad appearance — pins the slot.
func fieldPtrChainScalarReplaceable(ui @useIndex, fp @ir.Instr, padAware bool) bool {
	var us @[]valueUse = ui.usesOf(fp)
	for i := 0; i < len(us); i++ {
		// Non-managed path: any pad appearance is an escape (a non-managed
		// aggregate never legitimately appears in a pad).  Managed path: a
		// field-ptr legitimately appears in a FaultPad — the inline per-field
		// RefDec cleanup (emitStructFieldRefDecs on the alloca) — so a pad use
		// passes IFF it is a load/store chain use, the same check as a block use.
		if us[i].inPad && !padAware {
			return false
		}
		if !useIsL1(ui, us[i], padAware) {
			return false
		}
	}
	return true
}

// sroaLoadedValuesAllExtract reports whether, for EVERY whole OP_LOAD(a) in f,
// every use of the loaded value is an OP_EXTRACT.  A non-extract use (a by-value
// call arg, an OP_RETURN, box(), or storing the value elsewhere) means the
// loaded aggregate value must survive whole — and there is no primitive to
// rebuild an aggregate value from scalars on the real backends (OP_INSERT does
// not exist; OP_STRUCT_LIT is unlowered) — so the slot is pinned un-splittable.
func sroaLoadedValuesAllExtract(ui @useIndex, a @ir.Instr) bool {
	var us @[]valueUse = ui.usesOf(a)
	for i := 0; i < len(us); i++ {
		var ld @ir.Instr = us[i].user
		if us[i].inPad || us[i].argIdx != 0 || ld.Op != iropcode.OP_LOAD {
			continue
		}
		if !valueUsesAllExtract(ui, ld) {
			return false
		}
	}
	return true
}

// valueUsesAllExtract reports whether every use of value v across f's blocks AND
// fault pads is an OP_EXTRACT reading v as Args[0].  Any other use (including a
// phi entry, or any pad reference) returns false.
func valueUsesAllExtract(ui @useIndex, v @ir.Instr) bool {
	var us @[]valueUse = ui.usesOf(v)
	for i := 0; i < len(us); i++ {
		if us[i].argIdx != 0 || us[i].user.Op != iropcode.OP_EXTRACT {
			return false
		}
	}
	return true
}

// validateSroaCandidates re-verifies, fail-loud, that every alloca in `cands`
// still satisfies the SROA splittability contract (aggregate type + L1 + L2)
// against f's current IR.  Phase 0 performs no rewrite, so this is a self-check
// on the analysis; the eventual rewrite phase will call it as a precondition
// guard before mutating.  A violation is an analysis bug that would become a
// miscompile once the rewrite exists, so it panics rather than skipping.
func validateSroaCandidates(f @ir.Func, cands @[]@ir.Instr) {
	var ui @useIndex = buildUseIndex(f)
	for i := 0; i < len(cands); i++ {
		var a @ir.Instr = cands[i]
		if !isSroaAggregateAlloca(a) {
			panic("ir SROA: candidate is not an aggregate alloca")
		}
		// A managed (Phase 2) candidate — a managed slice, or a leaf-managed
		// struct whose cleanup was reshaped to inline per-field RefDecs — uses the
		// pad-AWARE L1/L2 (managedAllocaUsesOK / managedLoadedValuesAllExtract),
		// which admits the refcount spine's field-ptr / whole-load+extract in
		// FaultPads; the non-managed L1 here would wrongly pin it on that.
		var t @types.Type = irutil.PeelTransparent(a.TypeArg)
		if (t != nil && t.Kind == types.TYP_MANAGED_SLICE) || ir.ManagedStructLeafEligible(a.TypeArg) {
			if !managedAllocaUsesOK(ui, a) {
				panic("ir SROA: managed candidate fails L1 (alloca-use) check")
			}
			if !managedLoadedValuesAllExtract(ui, a) {
				panic("ir SROA: managed candidate fails L2 check")
			}
			continue
		}
		if !sroaAllocaL1OK(ui, a) {
			panic("ir SROA: candidate fails L1 (alloca-use) check")
		}
		if !sroaLoadedValuesAllExtract(ui, a) {
			panic("ir SROA: candidate fails L2 (loaded-value-use) check")
		}
	}
}
