package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/irutil"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for SROA copy-out splitting (sroa_copyout.bn): a whole store of a local
// struct's loaded value to a non-splittable destination is rewritten to per-field
// stores so the local scalar-replaces; the leave-alone cases (non-identical
// destination type, another non-extract use, managed struct) keep the copy whole.

// ptrParamRef adds a raw-pointer-to-t param to f and returns its value.
func ptrParamRef(f @ir.Func, t @types.Type) @ir.Instr {
	return ir.NewParamRef(f, ir.NewParam(f, "p", types.MakePointerType(t)))
}

// fillPair stores 1 and 2 into fields a and b of the twoIntStruct alloca s.
func fillPair(blk @ir.Block, s @ir.Instr) {
	var fp0 @ir.Instr = irbuild.EmitGetFieldPtr(blk, s, 0, types.TypInt())
	irbuild.EmitStore(blk, fp0, irbuild.EmitConstInt(blk, 1, types.TypInt()))
	var fp1 @ir.Instr = irbuild.EmitGetFieldPtr(blk, s, 1, types.TypInt())
	irbuild.EmitStore(blk, fp1, irbuild.EmitConstInt(blk, 2, types.TypInt()))
}

// countWholeStores counts OP_STOREs whose value operand is an aggregate (struct).
func countWholeStores(f @ir.Func) int {
	var n int = 0
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @ir.Instr = blk.Instrs[ii]
			if instr.Op != iropcode.OP_STORE || len(instr.Args) != 2 || instr.Args[1].Typ == nil {
				continue
			}
			var vt @types.Type = irutil.PeelTransparent(instr.Args[1].Typ)
			if vt != nil && vt.Kind == types.TYP_STRUCT {
				n++
			}
		}
	}
	return n
}

// `var s Pair; s.a = 1; s.b = 2; *p = s` — the copy-out to *p is split, so s
// scalar-replaces and mem2reg leaves two constant field stores through p.
func TestSroaCopyOutToPointerUnpins() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var p @ir.Instr = ptrParamRef(f, st)
	var s @ir.Instr = irbuild.EmitAlloc(entry, st)
	fillPair(entry, s)
	irbuild.EmitStore(entry, p, irbuild.EmitLoad(entry, s, st))
	irbuild.EmitReturn(entry, noArgs)

	sroaFuncToFixpoint(f)
	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 {
		return fail("SROA copy-out: the local should be scalar-replaced and promoted away")
	}
	if countWholeStores(f) != 0 {
		return fail("SROA copy-out: the whole store to *p should be split per field")
	}
	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 2 || countOp(f, iropcode.OP_STORE) != 2 {
		return fail("SROA copy-out: expected one field-ptr + store per field of *p")
	}
	if countOp(f, iropcode.OP_LOAD) != 0 {
		return fail("SROA copy-out: the stored field values should be forwarded, not loaded")
	}
	return ""
}

// A copy chain `t = s; *p = t` unpins both locals: splitting t's copy-out lets t
// split, which turns `t = s` into per-field extracts of load(s), so s splits too.
func TestSroaCopyOutChainUnpinsBoth() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var p @ir.Instr = ptrParamRef(f, st)
	var s @ir.Instr = irbuild.EmitAlloc(entry, st)
	var t @ir.Instr = irbuild.EmitAlloc(entry, st)
	fillPair(entry, s)
	irbuild.EmitStore(entry, t, irbuild.EmitLoad(entry, s, st))
	irbuild.EmitStore(entry, p, irbuild.EmitLoad(entry, t, st))
	irbuild.EmitReturn(entry, noArgs)

	sroaFuncToFixpoint(f)
	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 {
		return fail("SROA copy-out: both locals of the copy chain should be promoted away")
	}
	if countWholeStores(f) != 0 || countOp(f, iropcode.OP_STORE) != 2 {
		return fail("SROA copy-out: only the two per-field stores through p should remain")
	}
	return ""
}

// A destination whose pointee is a different struct type keeps the copy whole
// (field i need not be at the same offset there), so the local stays pinned.
func TestSroaCopyOutNonIdenticalDestPinned() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var f0 @types.Field = make(types.Field)
	f0.Name = "x"
	f0.Type = types.TypBool()
	fields[0] = f0
	var f1 @types.Field = make(types.Field)
	f1.Name = "y"
	f1.Type = types.TypInt()
	fields[1] = f1
	var other @types.Type = types.MakeStructType("Other", fields)

	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var p @ir.Instr = ptrParamRef(f, other)
	var s @ir.Instr = irbuild.EmitAlloc(entry, st)
	fillPair(entry, s)
	irbuild.EmitStore(entry, p, irbuild.EmitLoad(entry, s, st))
	irbuild.EmitReturn(entry, noArgs)

	if splitSroaCopyOuts(f) {
		return fail("SROA copy-out: a non-identical destination must not be split")
	}
	sroaFuncToFixpoint(f)
	if countOp(f, iropcode.OP_ALLOC) != 1 || countWholeStores(f) != 1 {
		return fail("SROA copy-out: the local must stay pinned with its whole copy")
	}
	return ""
}

// A loaded value with another non-extract use (here a by-value call argument)
// would stay pinned anyway, so its copy-out is left whole.
func TestSroaCopyOutWithOtherUseNotSplit() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var p @ir.Instr = ptrParamRef(f, st)
	var s @ir.Instr = irbuild.EmitAlloc(entry, st)
	fillPair(entry, s)
	var v @ir.Instr = irbuild.EmitLoad(entry, s, st)
	irbuild.EmitStore(entry, p, v)
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = v
	irbuild.EmitCall(entry, "sink", args, nil)
	irbuild.EmitReturn(entry, noArgs)

	if splitSroaCopyOuts(f) {
		return fail("SROA copy-out: a value also passed by value must not be split")
	}
	if countWholeStores(f) != 1 {
		return fail("SROA copy-out: the whole copy must be left in place")
	}
	return ""
}

// A struct with a managed field is out of scope (a whole store carries refcount
// semantics), so its copy-out is left whole.
func TestSroaCopyOutManagedStructNotSplit() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var mt @types.Type = managedFieldStruct()
	var p @ir.Instr = ptrParamRef(f, mt)
	var s @ir.Instr = irbuild.EmitAlloc(entry, mt)
	irbuild.EmitStore(entry, p, irbuild.EmitLoad(entry, s, mt))
	irbuild.EmitReturn(entry, noArgs)

	if splitSroaCopyOuts(f) {
		return fail("SROA copy-out: a managed struct's copy-out must not be split")
	}
	return ""
}

// A struct with a nested-struct field: the copy-out is split into an int field
// store and a whole store of the nested value (an extract) to the nested
// field-ptr; the local and its nested slot then scalar-replace across the
// fixpoint and promote away.
func TestSroaCopyOutNestedStructUnpins() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var f0 @types.Field = make(types.Field)
	f0.Name = "a"
	f0.Type = types.TypInt()
	fields[0] = f0
	var f1 @types.Field = make(types.Field)
	f1.Name = "inner"
	f1.Type = twoIntStruct()
	fields[1] = f1
	var outer @types.Type = types.MakeStructType("Outer", fields)

	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var p @ir.Instr = ptrParamRef(f, outer)
	var s @ir.Instr = irbuild.EmitAlloc(entry, outer)
	var fp0 @ir.Instr = irbuild.EmitGetFieldPtr(entry, s, 0, types.TypInt())
	irbuild.EmitStore(entry, fp0, irbuild.EmitConstInt(entry, 7, types.TypInt()))
	irbuild.EmitStore(entry, p, irbuild.EmitLoad(entry, s, outer))
	irbuild.EmitReturn(entry, noArgs)

	sroaFuncToFixpoint(f)
	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 {
		return fail("SROA copy-out: the nested-struct local should be promoted away")
	}
	return ""
}

// A copy-out through a NAMED pointer type (`type PS *Pair`) splits like one
// through `*Pair`: every backend lays a field pointer on it out from the pointee
// of its underlying pointer type (ir.FieldPtrBaseType).
func TestSroaCopyOutNamedPointerDestSplit() testing.TestResult {
	var st @types.Type = twoIntStruct()
	var ps @types.Type = types.MakeNamedType("PS")
	ps.Underlying = types.MakePointerType(st)

	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var p @ir.Instr = ir.NewParamRef(f, ir.NewParam(f, "p", ps))
	var s @ir.Instr = irbuild.EmitAlloc(entry, st)
	fillPair(entry, s)
	irbuild.EmitStore(entry, p, irbuild.EmitLoad(entry, s, st))
	irbuild.EmitReturn(entry, noArgs)

	if !splitSroaCopyOuts(f) {
		return fail("SROA copy-out: a named-pointer destination should be split")
	}
	return ""
}

// A whole store INTO a candidate of a load from a source that is not split
// (here through a pointer param, `s = *p`) still scalarizes via the OP_LOAD arm
// of the extractable-value gate: one extract per field.
func TestSroaWholeStoreFromUnsplitLoadScalarized() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var p @ir.Instr = ptrParamRef(f, st)
	var s @ir.Instr = irbuild.EmitAlloc(entry, st)
	irbuild.EmitStore(entry, s, irbuild.EmitLoad(entry, p, st))
	var fp0 @ir.Instr = irbuild.EmitGetFieldPtr(entry, s, 0, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(irbuild.EmitLoad(entry, fp0, types.TypInt())))

	if !sroaFunc(f) || countOp(f, iropcode.OP_EXTRACT) != 2 || countWholeStores(f) != 0 {
		return fail("SROA: `s = *p` should scalarize into one extract per field")
	}
	return ""
}

// A copy CHAIN of raw slices (`*[]int`, which copy-out splitting does not cover)
// still peels one link per pass, so a 20-deep chain needs the count-based
// fixpoint bound: one pass leaves the head pinned; the fixpoint splits them all.
func TestSroaRawSliceCopyChainPeelsPerPass() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var sl @types.Type = types.MakeSliceType(types.TypInt())
	var head @ir.Instr = irbuild.EmitAlloc(entry, sl)
	irbuild.EmitStore(entry, head, irbuild.EmitCall(entry, "mk", noArgs, sl))
	var prev @ir.Instr = head
	for i := 1; i < 20; i++ {
		var cur @ir.Instr = irbuild.EmitAlloc(entry, sl)
		irbuild.EmitStore(entry, cur, irbuild.EmitLoad(entry, prev, sl))
		prev = cur
	}
	irbuild.EmitReturn(entry, oneRet(irbuild.EmitSliceLen(entry, irbuild.EmitLoad(entry, prev, sl))))

	if !sroaFunc(f) || !instrInBlocks(f, head) {
		return fail("SROA: one pass should split only the chain's tail, leaving the head pinned")
	}
	sroaFuncToFixpoint(f)
	promoteFuncScalars(f)
	if countOp(f, iropcode.OP_ALLOC) != 0 {
		return fail("SROA fixpoint: the whole 20-deep raw-slice chain should promote away")
	}
	return ""
}
