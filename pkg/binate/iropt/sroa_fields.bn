package "pkg/binate/iropt"

import "pkg/binate/ir"

import "pkg/binate/irutil"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/stdx/slices"

// SROA field slots: the per-field allocas a split aggregate becomes, their
// zero-initialization at the declaration's position, and the field-type
// enumeration shared with the rewrite (sroa_rewrite.bn).

// makeFieldAllocas creates one OP_ALLOC per field of aggregate alloca a, typed by
// the field's type (the same index OP_GET_FIELD_PTR / OP_EXTRACT use).  For a raw
// slice the two fields are {data: *uint8, len: int} — the types its OP_EXTRACT
// consumers use (EmitSliceElemPtr extracts field 0 as *uint8, EmitSliceLen field
// 1 as int).  For a struct, the declared field types in order.
func makeFieldAllocas(f @ir.Func, a @ir.Instr) @[]@ir.Instr {
	var fieldTyps @[]@types.Type = aggregateFieldTypes(irutil.PeelTransparent(a.TypeArg))
	var out @[]@ir.Instr
	for i := 0; i < len(fieldTyps); i++ {
		var ft @types.Type = ir.StripConstForIR(fieldTyps[i])
		var fa @ir.Instr = ir.NewInstr(f, iropcode.OP_ALLOC, types.MakePointerType(ft))
		fa.TypeArg = ft
		fa.Line = a.Line
		out = slices.Append[@ir.Instr](out, fa)
	}
	return out
}

// makeFieldZeroInits returns the explicit zero-init stores for the split field
// slots, emitted at the aggregate alloca's position.  The aggregate OP_ALLOC the
// split deletes was zero-filled by the backend EACH time it executed (every
// execution of the declaration, e.g. every iteration of a loop body declaring
// it), so every field that the backend will not zero at its own alloca needs a
// store here that re-executes at the same point:
//   - a mem2reg-promotable scalar (int / bool / raw pointer) gets its typed zero:
//     mem2reg turns the store into a real definition, so a read before any
//     write sees 0 on EVERY execution.  Without it, mem2reg only substitutes 0
//     where no store reaches the read at all, and in a loop the previous
//     iteration's store reaches the next iteration's read through the header
//     phi — the stale value would flow in;
//   - a float / oversized int (non-promotable) gets its typed zero const, and a
//     MANAGED-pointer field (a managed slice's refptr) a nil, so it never reads
//     stack garbage (the refcount spine would otherwise RefDec a wild pointer);
//   - an aggregate field needs nothing: the backend zero-fills its own alloca.
// The stores are RAW (a managed OP_ALLOC slot is a pure bit-copy cell, no
// implicit refcount) and precede every use.
func makeFieldZeroInits(f @ir.Func, fieldAllocas @[]@ir.Instr) @[]@ir.Instr {
	var out @[]@ir.Instr
	for i := 0; i < len(fieldAllocas); i++ {
		var fa @ir.Instr = fieldAllocas[i]
		// A managed slot gets a nil; any other scalar (promotable, or a float /
		// oversized int) its typed zero const; an aggregate (backend zero-fill)
		// nothing.
		var zero @ir.Instr
		if irutil.IsManagedScalarType(fa.TypeArg) {
			zero = ir.NewInstr(f, iropcode.OP_CONST_NIL, fa.TypeArg)
		} else if fieldNeedsZeroConstInit(fa.TypeArg) || isScalarPromotableType(fa.TypeArg) {
			zero = makeZeroConst(f, fa.TypeArg)
		} else {
			continue
		}
		zero.Line = fa.Line
		var st @ir.Instr = ir.NewVoidInstr(iropcode.OP_STORE)
		st.Args = ir.MakeArgs2(fa, zero)
		st.Line = fa.Line
		out = slices.Append[@ir.Instr](out, zero)
		out = slices.Append[@ir.Instr](out, st)
	}
	return out
}

// aggregateFieldTypes returns the per-field types of aggregate type t, in the
// index order OP_EXTRACT / OP_GET_FIELD_PTR use: a raw slice is {*uint8, int}; a
// struct is its declared field types.
func aggregateFieldTypes(t @types.Type) @[]@types.Type {
	t = irutil.PeelTransparent(t)
	var out @[]@types.Type
	if t != nil && t.Kind == types.TYP_SLICE {
		out = slices.Append[@types.Type](out, types.MakePointerType(types.TypUint8()))
		out = slices.Append[@types.Type](out, types.TypInt())
		return out
	}
	if t != nil && t.Kind == types.TYP_MANAGED_SLICE {
		// {data:*uint8, len:int, refptr:@ptr, backinglen:int} — the refptr
		// (MSLICE_FIELD_BACKING) is a managed pointer (mem2reg won't promote it;
		// it stays in memory as a raw-copy cell + gets an explicit nil zero-init).
		out = slices.Append[@types.Type](out, types.MakePointerType(types.TypUint8()))
		out = slices.Append[@types.Type](out, types.TypInt())
		out = slices.Append[@types.Type](out, types.MakeManagedPtrType(nil))
		out = slices.Append[@types.Type](out, types.TypInt())
		return out
	}
	if t != nil && t.Kind == types.TYP_STRUCT {
		for i := 0; i < len(t.Fields); i++ {
			out = slices.Append[@types.Type](out, t.Fields[i].Type)
		}
	}
	return out
}
