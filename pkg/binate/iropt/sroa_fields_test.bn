package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the SROA field slots (sroa_fields.bn).

// A struct declared inside a loop body must read as zero on EVERY iteration: the
// split field slot's explicit zero-init store (at the declaration's position)
// becomes mem2reg's reaching definition for the read, so the read is the
// constant 0 — not a loop-header phi carrying the previous iteration's store.
//
//	pre:    sum = 0; i = 0
//	header: if i < 3 goto body else exit
//	body:   var s Pair; sum = sum + s.a; s.a = 10; i = i + 1; goto header
//	exit:   return sum
func TestSroaLoopBodyStructFieldReadsZeroEachIteration() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var st @types.Type = twoIntStruct()
	var zero @ir.Instr = irbuild.EmitConstInt(pre, 0, types.TypInt())
	irbuild.EmitJump(pre, header)

	var i @ir.Instr = irbuild.EmitPhi(header, types.TypInt(), onePhiEntry(pre, zero))
	var sum @ir.Instr = irbuild.EmitPhi(header, types.TypInt(), onePhiEntry(pre, zero))
	var three @ir.Instr = irbuild.EmitConstInt(header, 3, types.TypInt())
	irbuild.EmitBranch(header, irbuild.EmitBinop(header, iropcode.OP_LT, i, three, types.TypBool()),
			body, exit)

	var s @ir.Instr = irbuild.EmitAlloc(body, st)
	var fpRead @ir.Instr = irbuild.EmitGetFieldPtr(body, s, 0, types.TypInt())
	var read @ir.Instr = irbuild.EmitLoad(body, fpRead, types.TypInt())
	var sum1 @ir.Instr = irbuild.EmitBinop(body, iropcode.OP_ADD, sum, read, types.TypInt())
	var fpWrite @ir.Instr = irbuild.EmitGetFieldPtr(body, s, 0, types.TypInt())
	irbuild.EmitStore(body, fpWrite, irbuild.EmitConstInt(body, 10, types.TypInt()))
	var one @ir.Instr = irbuild.EmitConstInt(body, 1, types.TypInt())
	var i1 @ir.Instr = irbuild.EmitBinop(body, iropcode.OP_ADD, i, one, types.TypInt())
	irbuild.EmitJump(body, header)
	addPhiEntry(i, body, i1)
	addPhiEntry(sum, body, sum1)
	irbuild.EmitReturn(exit, oneRet(sum))

	sroaFuncToFixpoint(f)
	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 {
		return fail("SROA+mem2reg: the loop-body struct should be promoted away")
	}
	var r @ir.Instr = sum1.Args[1]
	if r.Op != iropcode.OP_CONST_INT || r.IntVal != 0 {
		return fail("SROA+mem2reg: the loop-body field read must be the constant 0, not loop-carried")
	}
	return ""
}
