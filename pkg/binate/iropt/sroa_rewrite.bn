package "pkg/binate/iropt"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/stdx/slices"

// SROA rewrite mechanics — companion to sroa_transform.bn (the pass driver +
// candidate analysis).  This is the per-alloca field-slot rewrite: planning
// which instrs are dropped / expanded, scalarizing whole stores and loads,
// rebuilding the block instruction lists, the fail-loud surviving-use assert,
// and the small id-keyed classifiers / table builders the plan and rebuild use.

// planStructRewrite marks the id-keyable dropped instrs (candidate alloca, whole
// load, field-ptr, extract-of-whole-load), builds each whole load's per-field
// loads into loadExp, and returns the whole-store expansions (which are void, so
// carried in a side list rather than an id table).
func planStructRewrite(f @ir.Func, isCand @[]bool, fieldsOf @[]@[]@ir.Instr, deleted @[]bool,
		loadExp @[]@[]@ir.Instr, origCap int) @sroaStoreExp {
	var se @sroaStoreExp = make(sroaStoreExp)
	// Blocks AND fault pads: a managed slice's refcount spine whole-loads +
	// extracts the value in pads too, so those must be scalarized as well.
	var lists @[]@[]@ir.Block = allBlockLists(f)
	for li := 0; li < len(lists); li++ {
		var blocks @[]@ir.Block = lists[li]
		for bi := 0; bi < len(blocks); bi++ {
			var blk @ir.Block = blocks[bi]
			for ii := 0; ii < len(blk.Instrs); ii++ {
				var instr @ir.Instr = blk.Instrs[ii]
				if instrIsCandAlloca(instr, isCand, origCap) {
					deleted[instr.ID] = true
					continue
				}
				if isWholeStoreOfCand(instr, isCand, origCap) {
					se.stores = slices.Append[@ir.Instr](se.stores, instr)
					se.exps = slices.Append[@[]@ir.Instr](se.exps, expandWholeStore(f, instr, fieldsOf))
					markDeadNilStoreValue(f, instr, isCand, deleted, origCap)
					continue
				}
				if isWholeLoadOfCand(instr, isCand, origCap) {
					deleted[instr.ID] = true
					loadExp[instr.ID] = expandWholeLoad(f, instr, fieldsOf)
					continue
				}
				if isFieldPtrOfCand(instr, isCand, origCap) {
					deleted[instr.ID] = true // dropped; its uses are rewritten via repl
				}
			}
		}
	}
	// Extracts of a whole load are dropped once the load is (their uses rewrite
	// to the per-field loads).  Second pass so every whole load is marked first.
	for li := 0; li < len(lists); li++ {
		var blocks @[]@ir.Block = lists[li]
		for bi := 0; bi < len(blocks); bi++ {
			var blk @ir.Block = blocks[bi]
			for ii := 0; ii < len(blk.Instrs); ii++ {
				var instr @ir.Instr = blk.Instrs[ii]
				if isExtractOfDeletedLoad(instr, deleted, origCap) {
					deleted[instr.ID] = true
				}
			}
		}
	}
	return se
}

// allBlockLists returns [f.Blocks, f.FaultPads] — the two instruction-carrying
// block lists the SROA rewrite must process (managed slices appear in pads).
func allBlockLists(f @ir.Func) @[]@[]@ir.Block {
	var out @[]@[]@ir.Block
	out = slices.Append[@[]@ir.Block](out, f.Blocks)
	out = slices.Append[@[]@ir.Block](out, f.FaultPads)
	return out
}

// fillReplacements records the SSA-value rewrites: each field-ptr of a candidate
// becomes its field alloca, and each extract of a (now-deleted) whole load
// becomes the matching per-field load created by expandWholeLoad.
func fillReplacements(f @ir.Func, isCand @[]bool, fieldsOf @[]@[]@ir.Instr, deleted @[]bool,
		loadExp @[]@[]@ir.Instr, repl @[]@ir.Instr, origCap int) {
	var lists @[]@[]@ir.Block = allBlockLists(f)
	for li := 0; li < len(lists); li++ {
		var blocks @[]@ir.Block = lists[li]
		for bi := 0; bi < len(blocks); bi++ {
			var blk @ir.Block = blocks[bi]
			for ii := 0; ii < len(blk.Instrs); ii++ {
				var instr @ir.Instr = blk.Instrs[ii]
				if isFieldPtrOfCand(instr, isCand, origCap) {
					var a @ir.Instr = instr.Args[0]
					repl[instr.ID] = fieldsOf[a.ID][instr.Index]
					continue
				}
				if isExtractOfDeletedLoad(instr, deleted, origCap) {
					var ld @ir.Instr = instr.Args[0]
					repl[instr.ID] = fieldLoadForIndex(loadExp[ld.ID], instr.Index)
				}
			}
		}
	}
}

// markDeadNilStoreValue marks a nil whole-store's OP_CONST_NIL value deleted,
// provided every use of that value is a candidate whole-store (each of which
// expandWholeStore replaces with per-field zero stores built from fresh
// constants, so the aggregate nil is left unused).  Without this the OP_CONST_NIL(struct)
// is left dead in the IR and the backends materialize it as a zero-fill stack
// temp — a dead aggregate alloca no backend DCEs (clang removes it downstream,
// but native does not).
func markDeadNilStoreValue(f @ir.Func, store @ir.Instr, isCand @[]bool, deleted @[]bool,
		origCap int) {
	if len(store.Args) < 2 {
		return
	}
	var val @ir.Instr = store.Args[1]
	if val == nil || val.Op != iropcode.OP_CONST_NIL || val.ID < 0 || val.ID >= origCap {
		return
	}
	if constNilUsedOnlyByCandStores(f, val, isCand, origCap) {
		deleted[val.ID] = true
	}
}

// constNilUsedOnlyByCandStores reports whether every use of val is as the value
// (Args[1]) of a candidate whole-store (which the rewrite replaces) — so val can
// be deleted with those stores.
func constNilUsedOnlyByCandStores(f @ir.Func, val @ir.Instr, isCand @[]bool, origCap int) bool {
	var lists @[]@[]@ir.Block = allBlockLists(f)
	for li := 0; li < len(lists); li++ {
		var blocks @[]@ir.Block = lists[li]
		for bi := 0; bi < len(blocks); bi++ {
			var blk @ir.Block = blocks[bi]
			for ii := 0; ii < len(blk.Instrs); ii++ {
				var instr @ir.Instr = blk.Instrs[ii]
				for k := 0; k < len(instr.Args); k++ {
					if instr.Args[k] == val && !(k == 1 && isWholeStoreOfCand(instr, isCand, origCap)) {
						return false
					}
				}
				for k := 0; k < len(instr.Phis); k++ {
					if instr.Phis[k].Val == val {
						return false
					}
				}
			}
		}
	}
	return true
}

// expandWholeStore lowers OP_STORE(alloca, val) into per-field
// OP_STORE(fieldAlloca_i, OP_EXTRACT(val, i)), or — for an all-zero OP_CONST_NIL
// value — into per-field zero stores.
func expandWholeStore(f @ir.Func, store @ir.Instr, fieldsOf @[]@[]@ir.Instr) @[]@ir.Instr {
	var a @ir.Instr = store.Args[0]
	var val @ir.Instr = store.Args[1]
	var out @[]@ir.Instr
	var fields @[]@ir.Instr = fieldsOf[a.ID]
	// A whole-store of OP_CONST_NIL writes the aggregate's zero value.  Right
	// after the alloca it is the `var h S` declaration zero-init, which the split
	// already reproduces at that same position (makeFieldZeroInits for scalar
	// fields, the backend zero-fill of each aggregate field's own alloca), so it
	// is dropped.  Anywhere else it is an assignment of an all-zero value (an
	// empty raw-slice literal lowers to OP_CONST_NIL, `s = nil` for a managed
	// slice) and must become a zero store per field — aggregates included.
	// There is no OP_EXTRACT of a nil.
	if val.Op == iropcode.OP_CONST_NIL {
		if isDeclarationZeroInit(f, store) {
			return out
		}
		for i := 0; i < len(fields); i++ {
			out = appendFieldZeroStore(f, out, fields[i], true, store.Line)
		}
		return out
	}
	for i := 0; i < len(fields); i++ {
		var fa @ir.Instr = fields[i]
		var ex @ir.Instr = ir.NewInstr(f, iropcode.OP_EXTRACT, fa.TypeArg)
		ex.Args = ir.MakeArgs1(val)
		ex.Index = i
		ex.Line = store.Line
		var st @ir.Instr = ir.NewVoidInstr(iropcode.OP_STORE)
		st.Args = ir.MakeArgs2(fa, ex)
		st.Line = store.Line
		out = slices.Append[@ir.Instr](out, ex)
		out = slices.Append[@ir.Instr](out, st)
	}
	return out
}

// isDeclarationZeroInit reports whether the whole-store `store(a, nil)` is the
// declaration zero-init of alloca a: in a's block, with nothing between the
// alloca and the store except the nil value itself.
func isDeclarationZeroInit(f @ir.Func, store @ir.Instr) bool {
	var a @ir.Instr = store.Args[0]
	var val @ir.Instr = store.Args[1]
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			if blk.Instrs[ii] != store {
				continue
			}
			for k := ii - 1; k >= 0; k-- {
				var prev @ir.Instr = blk.Instrs[k]
				if prev == a {
					return true
				}
				if prev != val {
					return false
				}
			}
			return false
		}
	}
	return false
}

// expandWholeLoad materializes, at the whole load's position, an
// OP_LOAD(fieldAlloca_i) ONLY for each field index i that has a surviving
// OP_EXTRACT(load, i) consumer.  Returns a per-field-indexed slice (length =
// #fields) with the field load at index i, or nil for a field no extract reads.
//
// Materializing only consumed fields is what lets mem2reg promote the header
// fields of a managed slice: in a FaultPad the refcount spine extracts only the
// refptr (field 2), so emitting dead data/len/backinglen loads there would put
// those scalar slots into a pad, and mem2reg pins ANY slot appearing in a pad.
func expandWholeLoad(f @ir.Func, load @ir.Instr, fieldsOf @[]@[]@ir.Instr) @[]@ir.Instr {
	var a @ir.Instr = load.Args[0]
	var fields @[]@ir.Instr = fieldsOf[a.ID]
	var used @[]bool = wholeLoadExtractedFields(f, load, len(fields))
	var out @[]@ir.Instr = instrTable(len(fields))
	for i := 0; i < len(fields); i++ {
		if !used[i] {
			continue // no consumer for field i at this load; leave nil (dead)
		}
		var fa @ir.Instr = fields[i]
		var fl @ir.Instr = ir.NewInstr(f, iropcode.OP_LOAD, fa.TypeArg)
		fl.Args = ir.MakeArgs1(fa)
		fl.Line = load.Line
		out[i] = fl
	}
	return out
}

// wholeLoadExtractedFields marks, in a SINGLE scan of f's blocks and fault pads,
// which field indices [0, numFields) are read by an OP_EXTRACT of this whole
// load's value.  A field left false has no consumer at this load, so its per-field
// load is dead and is dropped.  One scan for all fields (vs one scan per field).
func wholeLoadExtractedFields(f @ir.Func, load @ir.Instr, numFields int) @[]bool {
	var used @[]bool = boolTable(numFields)
	var lists @[]@[]@ir.Block = allBlockLists(f)
	for li := 0; li < len(lists); li++ {
		var blocks @[]@ir.Block = lists[li]
		for bi := 0; bi < len(blocks); bi++ {
			var blk @ir.Block = blocks[bi]
			for ii := 0; ii < len(blk.Instrs); ii++ {
				var instr @ir.Instr = blk.Instrs[ii]
				if instr.Op == iropcode.OP_EXTRACT && len(instr.Args) >= 1 && instr.Args[0] == load &&
						instr.Index >= 0 && instr.Index < numFields {
					used[instr.Index] = true
				}
			}
		}
	}
	return used
}

// fieldLoadForIndex returns the per-field load at field index idx from a whole
// load's expansion (produced by expandWholeLoad, one entry per field in order).
func fieldLoadForIndex(loads @[]@ir.Instr, idx int) @ir.Instr {
	if idx >= 0 && idx < len(loads) {
		return loads[idx]
	}
	var none @ir.Instr
	return none
}

// rebuildSroaBlocks rewrites each block's instruction list: a candidate alloca
// becomes its field allocas, a whole store becomes its per-field extract+store
// expansion, a whole load becomes its per-field loads, a dropped field-ptr /
// extract is removed, everything else is kept in order.
func rebuildSroaBlocks(f @ir.Func, isCand @[]bool, fieldsOf @[]@[]@ir.Instr,
		zeroInitsOf @[]@[]@ir.Instr, deleted @[]bool, loadExp @[]@[]@ir.Instr, se @sroaStoreExp,
		origCap int) {
	var lists @[]@[]@ir.Block = allBlockLists(f)
	for li := 0; li < len(lists); li++ {
		var blocks @[]@ir.Block = lists[li]
		for bi := 0; bi < len(blocks); bi++ {
			var blk @ir.Block = blocks[bi]
			var kept @[]@ir.Instr
			for ii := 0; ii < len(blk.Instrs); ii++ {
				var instr @ir.Instr = blk.Instrs[ii]
				if instrIsCandAlloca(instr, isCand, origCap) {
					// field allocas, then the explicit zero-inits of the scalar field
					// slots (makeFieldZeroInits), at the declaration's position so
					// they re-execute each time the declaration does.
					kept = appendAll(kept, fieldsOf[instr.ID])
					kept = appendAll(kept, zeroInitsOf[instr.ID])
					continue
				}
				if isWholeStoreOfCand(instr, isCand, origCap) {
					kept = appendAll(kept, lookupStoreExp(se, instr))
					continue
				}
				if instr.ID >= 0 && instr.ID < origCap && deleted[instr.ID] {
					// whole load -> per-field loads (skip nil = dead-field slots);
					// field-ptr / extract -> dropped (empty expansion).
					kept = appendNonNil(kept, loadExp[instr.ID])
					continue
				}
				kept = slices.Append[@ir.Instr](kept, instr)
			}
			blk.Instrs = kept
		}
	}
}

// lookupStoreExp returns the expansion recorded for whole-store instr (matched by
// identity, since a void store has no usable id), or empty if not found.
func lookupStoreExp(se @sroaStoreExp, store @ir.Instr) @[]@ir.Instr {
	for k := 0; k < len(se.stores); k++ {
		if se.stores[k] == store {
			return se.exps[k]
		}
	}
	var none @[]@ir.Instr
	return none
}

// appendAll appends every element of src to dst and returns the result.
func appendAll(dst @[]@ir.Instr, src @[]@ir.Instr) @[]@ir.Instr {
	for i := 0; i < len(src); i++ {
		dst = slices.Append[@ir.Instr](dst, src[i])
	}
	return dst
}

// appendNonNil appends every non-nil element of src to dst (src is a per-field
// load expansion with nil at dead-field indices).
func appendNonNil(dst @[]@ir.Instr, src @[]@ir.Instr) @[]@ir.Instr {
	for i := 0; i < len(src); i++ {
		if src[i] != nil {
			dst = slices.Append[@ir.Instr](dst, src[i])
		}
	}
	return dst
}

// assertNoSurvivingSroaUses fails loud if any operand still references a deleted
// (SROA-removed) alloca / field-ptr / whole load / extract after the rewrite —
// such a reference would be a miscompile (an under-approximated escape, or a
// non-unique id).
func assertNoSurvivingSroaUses(f @ir.Func, deleted @[]bool, origCap int) {
	assertNoSurvivingSroaUsesIn(f.Blocks, deleted, origCap)
	assertNoSurvivingSroaUsesIn(f.FaultPads, deleted, origCap)
}

// assertNoSurvivingSroaUsesIn is assertNoSurvivingSroaUses over one block list.
func assertNoSurvivingSroaUsesIn(blocks @[]@ir.Block, deleted @[]bool, origCap int) {
	for bi := 0; bi < len(blocks); bi++ {
		var blk @ir.Block = blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @ir.Instr = blk.Instrs[ii]
			for k := 0; k < len(instr.Args); k++ {
				checkNoSurvivingSroaUse(instr.Args[k], deleted, origCap)
			}
			for k := 0; k < len(instr.Phis); k++ {
				checkNoSurvivingSroaUse(instr.Phis[k].Val, deleted, origCap)
			}
		}
	}
}

// checkNoSurvivingSroaUse panics if v is a deleted (SROA-removed) instruction.
func checkNoSurvivingSroaUse(v @ir.Instr, deleted @[]bool, origCap int) {
	if v == nil || v.ID < 0 || v.ID >= origCap {
		return
	}
	if deleted[v.ID] {
		panic("ir SROA: a deleted instruction is still referenced after rewrite")
	}
}

// boolTable returns a length-n @[]bool initialized to false.
func boolTable(n int) @[]bool {
	if n <= 0 {
		return make_slice(bool, 0)
	}
	return make_slice(bool, n)
}

// instrTable returns a length-n @[]@Instr initialized to nil.
func instrTable(n int) @[]@ir.Instr {
	if n <= 0 {
		return make_slice(@ir.Instr, 0)
	}
	return make_slice(@ir.Instr, n)
}

// instrListTable returns a length-n @[]@[]@Instr of empty lists.
func instrListTable(n int) @[]@[]@ir.Instr {
	if n <= 0 {
		return make_slice(@[]@ir.Instr, 0)
	}
	return make_slice(@[]@ir.Instr, n)
}

// arg0IsCand reports whether instr's Args[0] is a candidate alloca (by original id).
func arg0IsCand(instr @ir.Instr, isCand @[]bool, origCap int) bool {
	if len(instr.Args) < 1 {
		return false
	}
	var a @ir.Instr = instr.Args[0]
	return a != nil && a.ID >= 0 && a.ID < origCap && isCand[a.ID]
}

// instrIsCandAlloca reports whether instr is a candidate alloca.
func instrIsCandAlloca(instr @ir.Instr, isCand @[]bool, origCap int) bool {
	return instr.Op == iropcode.OP_ALLOC && instr.ID >= 0 && instr.ID < origCap && isCand[instr.ID]
}

// isWholeStoreOfCand reports whether instr is a whole OP_STORE into a candidate.
func isWholeStoreOfCand(instr @ir.Instr, isCand @[]bool, origCap int) bool {
	return instr.Op == iropcode.OP_STORE && arg0IsCand(instr, isCand, origCap)
}

// isWholeLoadOfCand reports whether instr is a whole OP_LOAD of a candidate.
func isWholeLoadOfCand(instr @ir.Instr, isCand @[]bool, origCap int) bool {
	return instr.Op == iropcode.OP_LOAD && arg0IsCand(instr, isCand, origCap)
}

// isFieldPtrOfCand reports whether instr is a const-index OP_GET_FIELD_PTR of a
// candidate.
func isFieldPtrOfCand(instr @ir.Instr, isCand @[]bool, origCap int) bool {
	return instr.Op == iropcode.OP_GET_FIELD_PTR && arg0IsCand(instr, isCand, origCap)
}

// isExtractOfDeletedLoad reports whether instr is an OP_EXTRACT whose source is a
// (candidate) whole load already marked deleted.
func isExtractOfDeletedLoad(instr @ir.Instr, deleted @[]bool, origCap int) bool {
	if instr.Op != iropcode.OP_EXTRACT || len(instr.Args) < 1 {
		return false
	}
	var src @ir.Instr = instr.Args[0]
	if src == nil || src.Op != iropcode.OP_LOAD || src.ID < 0 || src.ID >= origCap {
		return false
	}
	return deleted[src.ID]
}
