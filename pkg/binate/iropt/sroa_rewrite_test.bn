package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the SROA rewrite mechanics (sroa_rewrite.bn), exercised end to end
// via sroaFunc: scalar replacement of field-accessed structs, extractable
// whole-store copies, whole-load extract-forwarding, unstored-field zero-init,
// and raw-slice {data,len} splitting (then mem2reg promotion).  Reuses
// twoIntStruct (sroa_test.bn) and instrInBlocks (sroa_transform_test.bn).

// A field-accessed POD struct is scalar-replaced: the struct alloca and every
// field-ptr vanish, replaced by one scalar alloca per field, which mem2reg then
// promotes away entirely.
func TestSroaStructScalarReplaced() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var s @ir.Instr = irbuild.EmitAlloc(entry, twoIntStruct())
	var fp0 @ir.Instr = irbuild.EmitGetFieldPtr(entry, s, 0, types.TypInt())
	irbuild.EmitStore(entry, fp0, irbuild.EmitConstInt(entry, 7, types.TypInt()))
	var fp1 @ir.Instr = irbuild.EmitGetFieldPtr(entry, s, 1, types.TypInt())
	irbuild.EmitStore(entry, fp1, irbuild.EmitConstInt(entry, 9, types.TypInt()))
	var fp0b @ir.Instr = irbuild.EmitGetFieldPtr(entry, s, 0, types.TypInt())
	var v @ir.Instr = irbuild.EmitLoad(entry, fp0b, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(v))

	sroaFunc(f)

	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 0 {
		return fail("SROA: every field-ptr of the struct should be gone")
	}
	if countOp(f, iropcode.OP_ALLOC) != 2 {
		return fail("SROA: the struct alloca should become two scalar field allocas")
	}

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 || countOp(f, iropcode.OP_LOAD) != 0 ||
			countOp(f, iropcode.OP_STORE) != 0 {
		return fail("SROA+mem2reg: field slots should be fully promoted away")
	}
	if lastInstr(entry).Args[0].Op != iropcode.OP_CONST_INT || lastInstr(entry).Args[0].IntVal != 7 {
		return fail("SROA+mem2reg: return should forward the stored field-0 constant 7")
	}
	return ""
}

// A field never explicitly stored reads back as zero after SROA + mem2reg
// (mem2reg's undef-load-to-zero), matching struct zero-init semantics.
func TestSroaStructUnstoredFieldIsZero() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var s @ir.Instr = irbuild.EmitAlloc(entry, twoIntStruct())
	var fp0 @ir.Instr = irbuild.EmitGetFieldPtr(entry, s, 0, types.TypInt())
	irbuild.EmitStore(entry, fp0, irbuild.EmitConstInt(entry, 5, types.TypInt()))
	// field 1 is never stored; reading it must yield zero.
	var fp1 @ir.Instr = irbuild.EmitGetFieldPtr(entry, s, 1, types.TypInt())
	var v @ir.Instr = irbuild.EmitLoad(entry, fp1, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(v))

	sroaFunc(f)
	promoteFuncScalars(f)

	if lastInstr(entry).Args[0].Op != iropcode.OP_CONST_INT || lastInstr(entry).Args[0].IntVal != 0 {
		return fail("SROA+mem2reg: an unstored field must read back as zero")
	}
	return ""
}

// A whole OP_STORE of an extractable aggregate value (here a by-value call
// result, `s = mk()`) is scalarized into per-field OP_EXTRACT + OP_STORE; the
// stored-to alloca is split.  (A load result stored this way — a copy — is split
// before candidate collection by splitSroaCopyOuts; see sroa_copyout_test.bn.)
func TestSroaStructWholeStoreScalarized() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var s @ir.Instr = irbuild.EmitAlloc(entry, st)
	var v @ir.Instr = irbuild.EmitCall(entry, "mk", noArgs, st) // struct value
	irbuild.EmitStore(entry, s, v) // whole store `s = mk()` — extractable value
	var fp0 @ir.Instr = irbuild.EmitGetFieldPtr(entry, s, 0, types.TypInt())
	var r @ir.Instr = irbuild.EmitLoad(entry, fp0, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(r))

	sroaFunc(f)

	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 0 {
		return fail("SROA: field-ptr should be gone after whole-store scalarization")
	}
	if countOp(f, iropcode.OP_EXTRACT) != 2 {
		return fail("SROA: a whole store should scalarize into one extract per field")
	}
	return ""
}

// The whole-LOAD scalarization path: a candidate whose whole value is loaded and
// consumed only by OP_EXTRACT gets per-field loads at the load site, the extracts
// rewritten to them; the whole load and extracts vanish.  (Gen doesn't produce
// this shape for plain structs — field reads use GET_FIELD_PTR — so it is
// exercised here by hand; it is the machinery the raw-slice phase reuses.)
func TestSroaStructWholeLoadForwarded() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var s @ir.Instr = irbuild.EmitAlloc(entry, st)
	var fp0 @ir.Instr = irbuild.EmitGetFieldPtr(entry, s, 0, types.TypInt())
	irbuild.EmitStore(entry, fp0, irbuild.EmitConstInt(entry, 7, types.TypInt()))
	var fp1 @ir.Instr = irbuild.EmitGetFieldPtr(entry, s, 1, types.TypInt())
	irbuild.EmitStore(entry, fp1, irbuild.EmitConstInt(entry, 9, types.TypInt()))
	var v @ir.Instr = irbuild.EmitLoad(entry, s, st) // whole load; value used only by extract
	var e0 @ir.Instr = irbuild.EmitExtract(entry, v, 0, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(e0))

	sroaFunc(f)

	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 0 || countOp(f, iropcode.OP_EXTRACT) != 0 {
		return fail("SROA: whole load + extract should be replaced by per-field loads")
	}

	promoteFuncScalars(f)

	if lastInstr(entry).Args[0].Op != iropcode.OP_CONST_INT || lastInstr(entry).Args[0].IntVal != 7 {
		return fail("SROA+mem2reg: the forwarded field-0 load should carry the stored 7")
	}
	return ""
}

// A raw slice initialized from the managed->raw decay (OP_MANAGED_TO_RAW — the
// `var s *[]T = make_slice(...)` shape) is scalar-replaced: OP_MANAGED_TO_RAW is
// a whitelisted extractable store value, and the managed source slice is left
// alone (managed).
func TestSroaRawSliceFromManagedToRawScalarReplaced() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var mst @types.Type = types.MakeManagedSliceType(types.TypInt())
	var slt @types.Type = types.MakeSliceType(types.TypInt())
	var msAlloc @ir.Instr = irbuild.EmitAlloc(entry, mst)
	var mv @ir.Instr = irbuild.EmitLoad(entry, msAlloc, mst)
	var raw @ir.Instr = irbuild.EmitManagedToRaw(entry, mv) // OP_MANAGED_TO_RAW value
	var s @ir.Instr = irbuild.EmitAlloc(entry, slt)
	irbuild.EmitStore(entry, s, raw) // whole store of a managed->raw value
	var sv @ir.Instr = irbuild.EmitLoad(entry, s, slt)
	var lenv @ir.Instr = irbuild.EmitSliceLen(entry, sv)
	irbuild.EmitReturn(entry, oneRet(lenv))

	sroaFunc(f)

	if instrInBlocks(f, s) {
		return fail("SROA: a raw slice from OP_MANAGED_TO_RAW should be scalar-replaced")
	}
	if !instrInBlocks(f, msAlloc) {
		return fail("SROA: the managed source slice must be left untouched")
	}
	return ""
}

// A raw-slice local (`*[]int`) accessed via whole-load + OP_EXTRACT (len) and
// whole-stored from an extractable value is scalar-replaced into its {data,len}
// field slots.
func TestSroaRawSliceScalarReplaced() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var slt @types.Type = types.MakeSliceType(types.TypInt())
	var other @ir.Instr = irbuild.EmitAlloc(entry, slt)
	var s @ir.Instr = irbuild.EmitAlloc(entry, slt)
	var v @ir.Instr = irbuild.EmitLoad(entry, other, slt) // slice value (extractable)
	irbuild.EmitStore(entry, s, v) // whole store `s = other`
	var sv @ir.Instr = irbuild.EmitLoad(entry, s, slt) // whole load
	var lenv @ir.Instr = irbuild.EmitSliceLen(entry, sv) // OP_EXTRACT(sv, 1)
	irbuild.EmitReturn(entry, oneRet(lenv))

	sroaFunc(f)

	if instrInBlocks(f, s) {
		return fail("SROA: a raw-slice local should be scalar-replaced")
	}
	if !instrInBlocks(f, other) {
		return fail("SROA: the pinned source slice should remain")
	}
	return ""
}

// A managed slice of non-managed elements (`@[]int`) is scalar-replaced (Phase 2):
// data/len/backinglen promote, and the refptr goes to a managed field slot with
// an explicit nil zero-init.  The refcount spine (whole-load + extract-2) is
// forwarded to that slot.  The pinned copy source (its load feeds the store)
// remains.
func TestSroaManagedSliceScalarReplaced() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var mst @types.Type = types.MakeManagedSliceType(types.TypInt())
	var other @ir.Instr = irbuild.EmitAlloc(entry, mst)
	var v @ir.Instr = irbuild.EmitLoad(entry, other, mst) // extractable managed-slice value
	var s @ir.Instr = irbuild.EmitAlloc(entry, mst)
	irbuild.EmitStore(entry, s, v) // whole store `s = other`
	var sv @ir.Instr = irbuild.EmitLoad(entry, s, mst)
	var lenv @ir.Instr = irbuild.EmitSliceLen(entry, sv)
	irbuild.EmitReturn(entry, oneRet(lenv))

	sroaFunc(f)

	if instrInBlocks(f, s) {
		return fail("SROA: a managed @[]int should be scalar-replaced (Phase 2)")
	}
	if !instrInBlocks(f, other) {
		return fail("SROA: the pinned copy source should remain")
	}
	if countOp(f, iropcode.OP_CONST_NIL) < 1 {
		return fail("SROA: the refptr field slot needs an explicit nil zero-init")
	}
	return ""
}

// SROA collapses BOTH sides of a copy in one pass.  `b = a` lowers to a whole
// store of `load(a)`, a non-extract use that would L2-pin the source a;
// splitSroaCopyOuts first rewrites it into per-field OP_EXTRACTs of `load(a)`
// stored through b's field-ptrs, so a and b are both candidates in the same pass,
// and mem2reg then forwards the copied field constant.
func TestSroaFixpointCollapsesCopySource() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var a @ir.Instr = irbuild.EmitAlloc(entry, st)
	var fpa @ir.Instr = irbuild.EmitGetFieldPtr(entry, a, 0, types.TypInt())
	irbuild.EmitStore(entry, fpa, irbuild.EmitConstInt(entry, 7, types.TypInt())) // a.x = 7
	var av @ir.Instr = irbuild.EmitLoad(entry, a, st) // whole-load a
	var b @ir.Instr = irbuild.EmitAlloc(entry, st)
	irbuild.EmitStore(entry, b, av) // b = a (source av = load(a))
	var fpb @ir.Instr = irbuild.EmitGetFieldPtr(entry, b, 0, types.TypInt())
	var v @ir.Instr = irbuild.EmitLoad(entry, fpb, types.TypInt()) // read b.x
	irbuild.EmitReturn(entry, oneRet(v))

	if !sroaFunc(f) {
		return fail("SROA: the first pass should scalar-replace the copy")
	}
	if instrInBlocks(f, a) || instrInBlocks(f, b) {
		return fail("SROA: one pass should scalar-replace both the copy source a and b")
	}
	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 0 {
		return fail("SROA fixpoint: every field-ptr of both structs should be gone")
	}

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 {
		return fail("SROA fixpoint + mem2reg: both struct allocas should be fully promoted away")
	}
	if lastInstr(entry).Args[0].Op != iropcode.OP_CONST_INT || lastInstr(entry).Args[0].IntVal != 7 {
		return fail("SROA fixpoint + mem2reg: return should forward the copied field-0 constant 7")
	}
	return ""
}

// A 20-deep copy CHAIN `s1=s0; …; s19=s18` fully collapses: every link's copy is
// split by splitSroaCopyOuts, so all 20 structs scalar-replace, promote away, and
// the tail read forwards the seed constant through the whole chain.
func TestSroaFixpointDeepCopyChain() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var chainLen int = 20
	var prev @ir.Instr = irbuild.EmitAlloc(entry, st)
	var seed @ir.Instr = irbuild.EmitGetFieldPtr(entry, prev, 0, types.TypInt())
	irbuild.EmitStore(entry, seed, irbuild.EmitConstInt(entry, 5, types.TypInt())) // s0.a = 5
	for i := 1; i < chainLen; i++ {
		var cur @ir.Instr = irbuild.EmitAlloc(entry, st)
		irbuild.EmitStore(entry, cur, irbuild.EmitLoad(entry, prev, st)) // s_i = s_{i-1}
		prev = cur
	}
	var tailFp @ir.Instr = irbuild.EmitGetFieldPtr(entry, prev, 0, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(irbuild.EmitLoad(entry, tailFp, types.TypInt()))) // read tail.a

	sroaFuncToFixpoint(f)

	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 0 {
		return fail("SROA fixpoint: every field-ptr in the 20-deep chain should be gone")
	}

	promoteFuncScalars(f)

	if countOp(f, iropcode.OP_ALLOC) != 0 {
		return fail("SROA fixpoint + mem2reg: the whole 20-deep copy chain should promote away")
	}
	if lastInstr(entry).Args[0].Op != iropcode.OP_CONST_INT || lastInstr(entry).Args[0].IntVal != 5 {
		return fail("SROA fixpoint: the tail read should forward the seed constant 5 through the chain")
	}
	return ""
}

// A whole load whose value is NEVER extracted (dead) is L2-vacuously splittable:
// expandWholeLoad marks no field used, so it contributes zero per-field loads and
// simply vanishes — only the genuine field-0 access load survives.
func TestSroaDeadWholeLoadDropped() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var s @ir.Instr = irbuild.EmitAlloc(entry, st)
	var fp0 @ir.Instr = irbuild.EmitGetFieldPtr(entry, s, 0, types.TypInt())
	irbuild.EmitStore(entry, fp0, irbuild.EmitConstInt(entry, 7, types.TypInt()))
	irbuild.EmitLoad(entry, s, st) // whole load, value UNUSED — must expand to nothing
	var fp0b @ir.Instr = irbuild.EmitGetFieldPtr(entry, s, 0, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(irbuild.EmitLoad(entry, fp0b, types.TypInt())))

	if !sroaFunc(f) {
		return fail("SROA: a struct with a dead whole-load should still be scalar-replaced")
	}
	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 0 {
		return fail("SROA: field-ptrs should be gone")
	}
	if countOp(f, iropcode.OP_LOAD) != 1 {
		return fail("SROA: the dead whole-load should drop to nothing; only the field-0 load remains")
	}
	promoteFuncScalars(f)
	if lastInstr(entry).Args[0].Op != iropcode.OP_CONST_INT || lastInstr(entry).Args[0].IntVal != 7 {
		return fail("SROA+mem2reg: the surviving field-0 load should forward the stored 7")
	}
	return ""
}

// A field extracted ONLY inside a FaultPad must still get a per-field load —
// expandWholeLoad's used-field scan covers fault pads, not just Func.Blocks.  The
// pad's OP_EXTRACT is then dropped (extract of the deleted whole-load) and its
// field-1 per-field load is materialized at the whole-load site in the block.
func TestSroaWholeLoadExtractedInFaultPad() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var s @ir.Instr = irbuild.EmitAlloc(entry, st)
	irbuild.EmitStore(entry, irbuild.EmitGetFieldPtr(entry, s, 0, types.TypInt()),
			irbuild.EmitConstInt(entry, 3, types.TypInt()))
	irbuild.EmitStore(entry, irbuild.EmitGetFieldPtr(entry, s, 1, types.TypInt()),
			irbuild.EmitConstInt(entry, 4, types.TypInt()))
	var v @ir.Instr = irbuild.EmitLoad(entry, s, st) // whole load
	// field 0 read in the block
	irbuild.EmitReturn(entry, oneRet(irbuild.EmitExtract(entry, v, 0, types.TypInt())))
	// A fault pad reads field 1 of the SAME whole-load value.
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	irbuild.EmitExtract(pad, v, 1, types.TypInt())
	irbuild.EmitUnwindReturn(pad)

	if !sroaFunc(f) {
		return fail("SROA: a whole-load feeding a pad extract should be scalar-replaced")
	}
	if countOpInBlock(f.FaultPads[0], iropcode.OP_EXTRACT) != 0 {
		return fail("SROA: the pad's extract (of the deleted whole-load) should be dropped")
	}
	// Both field-0 (block) and field-1 (pad) are marked used, so BOTH per-field
	// loads are materialized in the block — field-1's only because the pad scan saw it.
	if countOp(f, iropcode.OP_LOAD) != 2 {
		return fail("SROA: the pad-only field-1 extract must still produce a per-field load")
	}
	return ""
}

// Two whole loads of the SAME alloca extracting DISJOINT fields: the used-field
// tally is per-load, so each whole-load materializes only its own extracted
// field's load (2 total, not 4).  Verifies the tally keys on the specific load.
func TestSroaTwoWholeLoadsDisjointFields() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var s @ir.Instr = irbuild.EmitAlloc(entry, st)
	irbuild.EmitStore(entry, irbuild.EmitGetFieldPtr(entry, s, 0, types.TypInt()),
			irbuild.EmitConstInt(entry, 3, types.TypInt()))
	irbuild.EmitStore(entry, irbuild.EmitGetFieldPtr(entry, s, 1, types.TypInt()),
			irbuild.EmitConstInt(entry, 4, types.TypInt()))
	var v1 @ir.Instr = irbuild.EmitLoad(entry, s, st) // whole load 1 -> field 0 only
	var e1 @ir.Instr = irbuild.EmitExtract(entry, v1, 0, types.TypInt())
	var v2 @ir.Instr = irbuild.EmitLoad(entry, s, st) // whole load 2 -> field 1 only
	var e2 @ir.Instr = irbuild.EmitExtract(entry, v2, 1, types.TypInt())
	irbuild.EmitReturn(entry,
			oneRet(irbuild.EmitBinop(entry, iropcode.OP_ADD, e1, e2, types.TypInt())))

	if !sroaFunc(f) {
		return fail("SROA: two disjoint-field whole loads should be scalar-replaced")
	}
	if countOp(f, iropcode.OP_EXTRACT) != 0 {
		return fail("SROA: both extracts should be rewritten to per-field loads")
	}
	if countOp(f, iropcode.OP_LOAD) != 2 {
		return fail("SROA: each whole load should materialize only its own field's load (2 total)")
	}
	promoteFuncScalars(f)
	var sum @ir.Instr = lastInstr(entry).Args[0]
	if sum.Op != iropcode.OP_ADD || sum.Args[0].IntVal != 3 || sum.Args[1].IntVal != 4 {
		return fail("SROA+mem2reg: the loads should forward 3 (field 0) and 4 (field 1)")
	}
	return ""
}

// A struct initialized from a by-value aggregate call result (`var s S = f()`)
// scalar-replaces: the whole-store of the OP_CALL expands to per-field
// store(slot_i, OP_EXTRACT(call, i)), so s's field-ptrs vanish and the call is
// read field-wise.  (The backends lower OP_EXTRACT of a call result — sret buffer
// load or coerced-register reconstitution.)
func TestSroaCallResultWholeStoreScalarized() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var s @ir.Instr = irbuild.EmitAlloc(entry, st)
	var call @ir.Instr = irbuild.EmitCall(entry, "mk", noArgs, st) // returns the struct by value
	irbuild.EmitStore(entry, s, call) // whole-store of the call result
	var fp0 @ir.Instr = irbuild.EmitGetFieldPtr(entry, s, 0, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(irbuild.EmitLoad(entry, fp0, types.TypInt())))

	if !sroaFunc(f) {
		return fail("SROA: a struct initialized from a by-value call result should scalar-replace")
	}
	if countOp(f, iropcode.OP_GET_FIELD_PTR) != 0 {
		return fail("SROA: s's field-ptrs should be gone")
	}
	if countOp(f, iropcode.OP_EXTRACT) != 2 {
		return fail("SROA: the whole-store should expand to per-field extracts of the call")
	}
	return ""
}

// A whole-store of OP_CONST_NIL that is NOT the declaration's zero-init (an
// assignment of an all-zero value — an empty raw-slice literal lowers to
// OP_CONST_NIL) must zero every field, not be dropped: `r = mk(); r = {}; len(r)`
// must forward len 0, not mk()'s length.
func TestSroaNilWholeStoreAfterValueZeroesFields() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var sl @types.Type = types.MakeSliceType(types.TypInt())
	var r @ir.Instr = irbuild.EmitAlloc(entry, sl)
	irbuild.EmitStore(entry, r, irbuild.EmitCall(entry, "mk", noArgs, sl))
	irbuild.EmitStore(entry, r, irbuild.EmitConstNil(entry, sl))
	irbuild.EmitReturn(entry, oneRet(irbuild.EmitSliceLen(entry, irbuild.EmitLoad(entry, r, sl))))

	sroaFuncToFixpoint(f)
	promoteFuncScalars(f)

	var ret @ir.Instr = lastInstr(entry).Args[0]
	if ret.Op != iropcode.OP_CONST_INT || ret.IntVal != 0 {
		return fail("SROA: after `r = {}` the forwarded len must be the constant 0")
	}
	return ""
}

// The nested form: a nil whole-store into a split struct's raw-slice FIELD becomes
// a nil whole-store into the nested field slot, which the next fixpoint pass must
// also expand (not drop): `s.r = mk(); s.r = {}; len(s.r)` forwards 0.
func TestSroaNilWholeStoreIntoNestedFieldZeroes() testing.TestResult {
	var sl @types.Type = types.MakeSliceType(types.TypInt())
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var f0 @types.Field = make(types.Field)
	f0.Name = "k"
	f0.Type = types.TypInt()
	fields[0] = f0
	var f1 @types.Field = make(types.Field)
	f1.Name = "r"
	f1.Type = sl
	fields[1] = f1
	var st @types.Type = types.MakeStructType("Holder", fields)

	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var s @ir.Instr = irbuild.EmitAlloc(entry, st)
	var mk @ir.Instr = irbuild.EmitCall(entry, "mk", noArgs, sl)
	irbuild.EmitStore(entry, irbuild.EmitGetFieldPtr(entry, s, 1, sl), mk)
	irbuild.EmitStore(entry, irbuild.EmitGetFieldPtr(entry, s, 1, sl), irbuild.EmitConstNil(entry, sl))
	var v @ir.Instr = irbuild.EmitLoad(entry, irbuild.EmitGetFieldPtr(entry, s, 1, sl), sl)
	irbuild.EmitReturn(entry, oneRet(irbuild.EmitSliceLen(entry, v)))

	sroaFuncToFixpoint(f)
	promoteFuncScalars(f)

	var ret @ir.Instr = lastInstr(entry).Args[0]
	if ret.Op != iropcode.OP_CONST_INT || ret.IntVal != 0 {
		return fail("SROA: after `s.r = {}` the forwarded len must be the constant 0")
	}
	return ""
}
