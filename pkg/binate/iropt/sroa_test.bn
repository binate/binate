package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for SROA Phase 0 (sroa.bn): the splittability analysis
// (collectSroaCandidates + the L1/L2 predicates), the managed/non-managed
// classifier (sroaAggregateContainsManaged), and the fail-loud validator.
// Phase 0 performs no rewrite, so these assert classification only, on
// hand-built IR.  The package-shared oneRet (ir_phi_elim_test.bn) / fail /
// noParams / noResults (ir_test.bn) helpers are reused.

// candContains reports whether the candidate list cands includes alloca a.
func candContains(cands @[]@ir.Instr, a @ir.Instr) bool {
	for i := 0; i < len(cands); i++ {
		if cands[i] == a {
			return true
		}
	}
	return false
}

// twoIntStruct builds `struct { a int; b int }` — a POD (non-managed) aggregate.
func twoIntStruct() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var f0 @types.Field = make(types.Field)
	f0.Name = "a"
	f0.Type = types.TypInt()
	fields[0] = f0
	var f1 @types.Field = make(types.Field)
	f1.Name = "b"
	f1.Type = types.TypInt()
	fields[1] = f1
	return types.MakeStructType("Pair", fields)
}

// A raw-slice alloca used only by a whole load + an extract (len) is splittable
// and classified non-managed (Phase 1).  The validator accepts it.
func TestSroaRawSliceSplittable() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var s @ir.Instr = irbuild.EmitAlloc(entry, types.MakeSliceType(types.TypInt()))
	var v @ir.Instr = irbuild.EmitLoad(entry, s, types.MakeSliceType(types.TypInt()))
	var lenv @ir.Instr = irbuild.EmitSliceLen(entry, v) // OP_EXTRACT(v, 1)
	irbuild.EmitReturn(entry, oneRet(lenv))

	var cands @[]@ir.Instr = collectSroaCandidates(f)
	if !candContains(cands, s) {
		return fail("raw slice used by whole load + extract should be splittable")
	}
	if sroaAggregateContainsManaged(s.TypeArg) {
		return fail("a raw slice *[]int must classify as non-managed")
	}
	validateSroaCandidates(f, cands) // must not panic
	return ""
}

// A POD-struct alloca accessed only via constant-index field-ptr load/store (no
// whole load / whole store) is splittable and non-managed.
func TestSroaStructFieldAccessSplittable() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var s @ir.Instr = irbuild.EmitAlloc(entry, st)
	var fp0 @ir.Instr = irbuild.EmitGetFieldPtr(entry, s, 0, types.TypInt())
	irbuild.EmitStore(entry, fp0, irbuild.EmitConstInt(entry, 7, types.TypInt()))
	var fp1 @ir.Instr = irbuild.EmitGetFieldPtr(entry, s, 1, types.TypInt())
	var v @ir.Instr = irbuild.EmitLoad(entry, fp1, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(v))

	var cands @[]@ir.Instr = collectSroaCandidates(f)
	if !candContains(cands, s) {
		return fail("struct accessed via const field-ptr load/store should be splittable")
	}
	if sroaAggregateContainsManaged(s.TypeArg) {
		return fail("a POD struct must classify as non-managed")
	}
	return ""
}

// A struct whose whole value is loaded and RETURNED (a by-value use, not an
// OP_EXTRACT) is pinned by L2 — there is no aggregate-value rebuild primitive.
func TestSroaStructReturnedByValuePinned() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoIntStruct()
	var s @ir.Instr = irbuild.EmitAlloc(entry, st)
	var v @ir.Instr = irbuild.EmitLoad(entry, s, st) // whole load
	irbuild.EmitReturn(entry, oneRet(v)) // v used by OP_RETURN — non-extract

	var cands @[]@ir.Instr = collectSroaCandidates(f)
	if candContains(cands, s) {
		return fail("a struct whose whole value is returned must be pinned (L2)")
	}
	return ""
}

// An alloca whose address is passed to a call (a by-address argument) escapes at
// L1 and is not splittable.
func TestSroaByAddressCallArgPinned() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var s @ir.Instr = irbuild.EmitAlloc(entry, types.MakeSliceType(types.TypInt()))
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = s
	irbuild.EmitCall(entry, "callee", args, types.TypInt())
	irbuild.EmitReturn(entry, noArgs)

	var cands @[]@ir.Instr = collectSroaCandidates(f)
	if candContains(cands, s) {
		return fail("an alloca passed by-address to a call must be pinned (L1 escape)")
	}
	return ""
}

// A managed-slice alloca referenced inside a FaultPad is pinned (L1 treats ANY
// pad appearance as an escape — Phase 2 territory).
func TestSroaManagedSliceInFaultPadPinned() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var mst @types.Type = types.MakeManagedSliceType(types.TypInt())
	var s @ir.Instr = irbuild.EmitAlloc(entry, mst)
	irbuild.EmitReturn(entry, noArgs)
	// The slot's refcount cleanup lives in a fault pad, which references it.
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	irbuild.EmitLoad(pad, s, mst)

	var cands @[]@ir.Instr = collectSroaCandidates(f)
	if candContains(cands, s) {
		return fail("a managed slice referenced in a FaultPad must be pinned (L1)")
	}
	return ""
}

// A managed-slice alloca used only by whole load + extract IS splittable, but
// classifies as MANAGED (Phase 2) — splittability and managed-ness are
// orthogonal axes.
func TestSroaManagedSliceClassifiedManaged() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var mst @types.Type = types.MakeManagedSliceType(types.TypInt())
	var s @ir.Instr = irbuild.EmitAlloc(entry, mst)
	var v @ir.Instr = irbuild.EmitLoad(entry, s, mst)
	var lenv @ir.Instr = irbuild.EmitSliceLen(entry, v)
	irbuild.EmitReturn(entry, oneRet(lenv))

	var cands @[]@ir.Instr = collectSroaCandidates(f)
	if !candContains(cands, s) {
		return fail("a managed slice used only by load + extract should be splittable")
	}
	if !sroaAggregateContainsManaged(s.TypeArg) {
		return fail("a managed slice @[]int must classify as managed")
	}
	return ""
}

// An array alloca is never an SROA candidate (scalar-replacing [N]T would
// explode into N field slots), so a dynamically-indexed array is not split.
func TestSroaDynamicIndexArrayPinned() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var arr @ir.Instr = irbuild.EmitAlloc(entry, types.MakeArrayType(types.TypInt(), 4))
	var idx @ir.Instr = irbuild.EmitLoad(entry, irbuild.EmitAlloc(entry, types.TypInt()),
			types.TypInt())
	var ep @ir.Instr = irbuild.EmitGetElemPtr(entry, arr, idx, types.TypInt())
	var v @ir.Instr = irbuild.EmitLoad(entry, ep, types.TypInt())
	irbuild.EmitReturn(entry, oneRet(v))

	var cands @[]@ir.Instr = collectSroaCandidates(f)
	if candContains(cands, arr) {
		return fail("an array alloca must never be an SROA candidate")
	}
	return ""
}

// The managed-content classifier sees through a nested struct field: a struct
// holding a @T field is managed even though its outer shape is a plain struct.
func TestSroaNestedManagedFieldClassifiedManaged() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var f0 @types.Field = make(types.Field)
	f0.Name = "Ref"
	f0.Type = types.MakeManagedPtrType(types.MakeStructType("Inner", noFields))
	fields[0] = f0
	var st @types.Type = types.MakeStructType("Boxed", fields)

	if !sroaAggregateContainsManaged(st) {
		return fail("a struct with a @Inner field must classify as managed")
	}
	return ""
}

// A constant-index field-ptr whose result ESCAPES (passed to a call — the `&s.x`
// by-address case) pins the owning slot: fieldPtrUsedOnlyAsLoadStore must reject
// it, so the field-ptr L1 sub-check can't over-accept.
func TestSroaFieldPtrEscapePinned() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var s @ir.Instr = irbuild.EmitAlloc(entry, twoIntStruct())
	var fp @ir.Instr = irbuild.EmitGetFieldPtr(entry, s, 0, types.TypInt())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = fp // &s.a escapes into the callee
	irbuild.EmitCall(entry, "sink", args, types.TypInt())
	irbuild.EmitReturn(entry, noArgs)

	var cands @[]@ir.Instr = collectSroaCandidates(f)
	if candContains(cands, s) {
		return fail("a struct with an escaping field-ptr must be pinned (L1)")
	}
	return ""
}

// The alloca appearing as a store's VALUE operand (Args[1], not the destination
// Args[0]) is its address escaping into another slot — pinned by L1.
func TestSroaAllocaAsStoreValuePinned() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var s @ir.Instr = irbuild.EmitAlloc(entry, types.MakeSliceType(types.TypInt()))
	var dst @ir.Instr = irbuild.EmitAlloc(entry,
			types.MakePointerType(types.MakeSliceType(types.TypInt())))
	irbuild.EmitStore(entry, dst, s) // s rides Args[1] — its address escapes
	irbuild.EmitReturn(entry, noArgs)

	var cands @[]@ir.Instr = collectSroaCandidates(f)
	if candContains(cands, s) {
		return fail("an alloca stored as a value (Args[1]) must be pinned (L1)")
	}
	return ""
}

// The alloca appearing as a phi entry value is pinned by L1 (a phi merges the
// address, which the scalar-replacement cannot follow).
func TestSroaAllocaInPhiPinned() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var s @ir.Instr = irbuild.EmitAlloc(entry, types.MakeSliceType(types.TypInt()))
	var merge @ir.Block = ir.AddBlock(f, "merge")
	irbuild.EmitPhi(merge, types.MakeSliceType(types.TypInt()), twoEntries(entry, s, entry, s))

	var cands @[]@ir.Instr = collectSroaCandidates(f)
	if candContains(cands, s) {
		return fail("an alloca referenced by a phi entry must be pinned (L1)")
	}
	return ""
}

// L2 pins on ANY non-extract use of a whole-loaded value, not only OP_RETURN:
// passing the loaded aggregate value to a call is equally unsplittable.
func TestSroaLoadedValueToCallPinned() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = types.MakeSliceType(types.TypInt())
	var s @ir.Instr = irbuild.EmitAlloc(entry, st)
	var v @ir.Instr = irbuild.EmitLoad(entry, s, st) // whole load
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = v // the whole value flows into a call
	irbuild.EmitCall(entry, "sink", args, types.TypInt())
	irbuild.EmitReturn(entry, noArgs)

	var cands @[]@ir.Instr = collectSroaCandidates(f)
	if candContains(cands, s) {
		return fail("a slice whose whole loaded value flows to a call must be pinned (L2)")
	}
	return ""
}
