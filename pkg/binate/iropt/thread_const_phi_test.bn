package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for threading through a branch on a phi constant along an edge
// (thread_const_phi.bn).

// andLoop builds the post-mem2reg shape of `for i := 0; i < 10 && <c>; i++ {}`
// with a bounds check of i against 10 in the `&&`'s right-hand block:
//   h:     P = phi[pre: 0, post: P+1]; c1 = P < 10; branch c1, rhs, merge
//   rhs:   bounds_check(P, 10); c2 = <param>; jump merge
//   merge: r = phi[h: false, rhs: c2]; branch r, post, exit
// With useR, r is also used in exit, which merge dominates only while every way
// to exit passes it — threading h's false edge would leave that use without its
// definition, so it bars threading.  Returns the function and its blocks h,
// merge and exit.
func andLoop(useR bool) (@ir.Func, @ir.Block, @ir.Block, @ir.Block) {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var h @ir.Block = ir.AddBlock(f, "h")
	var rhs @ir.Block = ir.AddBlock(f, "rhs")
	var merge @ir.Block = ir.AddBlock(f, "merge")
	var post @ir.Block = ir.AddBlock(f, "post")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var initV @ir.Instr = irbuild.EmitConstInt(pre, 0, types.TypInt())
	irbuild.EmitJump(pre, h)
	var phi @ir.Instr = irbuild.EmitPhi(h, types.TypInt(), twoPhiEntries(pre, initV, pre, initV))
	var l @ir.Instr = irbuild.EmitConstInt(h, 10, types.TypInt())
	var c1 @ir.Instr = irbuild.EmitBinop(h, iropcode.OP_LT, phi, l, types.TypBool())
	var falseV @ir.Instr = irbuild.EmitConstBool(h, false)
	irbuild.EmitBranch(h, c1, rhs, merge)
	irbuild.EmitBoundsCheck(rhs, phi, l)
	var c2 @ir.Instr = boolParam(f)
	irbuild.EmitJump(rhs, merge)
	var r @ir.Instr = irbuild.EmitPhi(merge, types.TypBool(), twoPhiEntries(h, falseV, rhs, c2))
	irbuild.EmitBranch(merge, r, post, exit)
	var one @ir.Instr = irbuild.EmitConstInt(post, 1, types.TypInt())
	var step @ir.Instr = irbuild.EmitBinop(post, iropcode.OP_ADD, phi, one, types.TypInt())
	irbuild.EmitJump(post, h)
	phi.Phis = twoPhiEntries(pre, initV, post, step)
	if useR {
		irbuild.EmitBinop(exit, iropcode.OP_EQ, r, c2, types.TypBool())
	}
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(exit, noRet)
	return f, h, merge, exit
}

// The `&&` merge block decides on r alone, and r is false on the header's edge:
// the header's false arm goes straight to the exit, the guard is the loop's exit
// test again, and bce-loop then drops the check in the right-hand block.
func TestThreadConstPhiSendsAndLoopFalseEdgeToExit() testing.TestResult {
	var f @ir.Func
	var h @ir.Block
	var merge @ir.Block
	var exit @ir.Block
	f, h, merge, exit = andLoop(false)
	threadJumpsFunc(f)
	if lastInstr(h).Block2 != exit {
		return fail("the header's false arm should go straight to the exit")
	}
	bceLoopFunc(f)
	if countOp(f, iropcode.OP_BOUNDS_CHECK) != 0 {
		return fail("with the guard the exit test again, the bounds check should be dropped")
	}
	_ = merge
	return ""
}

// A merge-block phi used in a block the merge stops dominating keeps the edge:
// skipping the merge would leave that use without its definition.
func TestThreadConstPhiKeepsEdgeWhenPhiUsedElsewhere() testing.TestResult {
	var f @ir.Func
	var h @ir.Block
	var merge @ir.Block
	var exit @ir.Block
	f, h, merge, exit = andLoop(true)
	threadJumpsFunc(f)
	if lastInstr(h).Block2 != merge {
		return fail("the header's false arm must still go through the merge block")
	}
	_ = exit
	return ""
}

// The threaded edge's target has a phi: its new entry for the threading block
// carries the value resolved through the merge block's phis (q's entry for
// entry, 1), never the merge block's own phi.
//   entry: branch c1, rhs, merge
//   rhs:   jump merge
//   merge: r = phi[entry: false, rhs: c2]; q = phi[entry: 1, rhs: 2]; branch r, then, join
//   then:  jump join
//   join:  x = phi[merge: q, then: 5]; return x
func TestThreadConstPhiResolvesTargetPhiThroughMerge() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var rhs @ir.Block = ir.AddBlock(f, "rhs")
	var merge @ir.Block = ir.AddBlock(f, "merge")
	var then @ir.Block = ir.AddBlock(f, "then")
	var join @ir.Block = ir.AddBlock(f, "join")
	var falseV @ir.Instr = irbuild.EmitConstBool(entry, false)
	var v1 @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	irbuild.EmitBranch(entry, boolParam(f), rhs, merge)
	var c2 @ir.Instr = boolParam(f)
	var v2 @ir.Instr = irbuild.EmitConstInt(rhs, 2, types.TypInt())
	irbuild.EmitJump(rhs, merge)
	var r @ir.Instr = irbuild.EmitPhi(merge, types.TypBool(), twoPhiEntries(entry, falseV, rhs, c2))
	var q @ir.Instr = irbuild.EmitPhi(merge, types.TypInt(), twoPhiEntries(entry, v1, rhs, v2))
	irbuild.EmitBranch(merge, r, then, join)
	var t @ir.Instr = irbuild.EmitConstInt(then, 5, types.TypInt())
	irbuild.EmitJump(then, join)
	var x @ir.Instr = irbuild.EmitPhi(join, types.TypInt(), twoPhiEntries(merge, q, then, t))
	irbuild.EmitReturn(join, oneRet(x))
	threadJumpsFunc(f)
	if lastInstr(f.Blocks[0]).Block2 != join {
		return fail("entry's false arm should go straight to join")
	}
	var fromEntry int = 0
	for k := 0; k < len(x.Phis); k++ {
		if x.Phis[k].Block == f.Blocks[0] {
			fromEntry = fromEntry + 1
			if x.Phis[k].Val.Op != iropcode.OP_CONST_INT || x.Phis[k].Val.IntVal != cast(int64, 1) {
				return fail("join's entry for entry should carry q's value for entry, 1")
			}
		}
	}
	if fromEntry != 1 {
		return fail("join's phi should have exactly one entry for entry")
	}
	return ""
}

// The `||` form: the left operand's early exit stores true, so the threaded edge
// goes to the merge block's true successor.
func TestThreadConstPhiOrTakesTrueSuccessor() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var rhs @ir.Block = ir.AddBlock(f, "rhs")
	var merge @ir.Block = ir.AddBlock(f, "merge")
	var yes @ir.Block = ir.AddBlock(f, "yes")
	var no @ir.Block = ir.AddBlock(f, "no")
	var trueV @ir.Instr = irbuild.EmitConstBool(entry, true)
	irbuild.EmitBranch(entry, boolParam(f), merge, rhs)
	var c2 @ir.Instr = boolParam(f)
	irbuild.EmitJump(rhs, merge)
	var r @ir.Instr = irbuild.EmitPhi(merge, types.TypBool(), twoPhiEntries(entry, trueV, rhs, c2))
	irbuild.EmitBranch(merge, r, yes, no)
	var noRet @[]@ir.Instr
	irbuild.EmitConstInt(yes, 1, types.TypInt())
	irbuild.EmitReturn(yes, noRet)
	irbuild.EmitReturn(no, noRet)
	threadJumpsFunc(f)
	if lastInstr(f.Blocks[0]).Block1 != yes {
		return fail("entry's true arm should go straight to yes")
	}
	return ""
}

// Not threaded into a loop header: the merge block's false successor h heads a
// loop, so pre's arm keeps going through the merge block.
func TestThreadConstPhiNotIntoLoopHeader() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var other @ir.Block = ir.AddBlock(f, "other")
	var b @ir.Block = ir.AddBlock(f, "b")
	var h @ir.Block = ir.AddBlock(f, "h")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var falseV @ir.Instr = irbuild.EmitConstBool(pre, false)
	irbuild.EmitBranch(pre, boolParam(f), b, other)
	var c3 @ir.Instr = boolParam(f)
	irbuild.EmitJump(other, b)
	var r @ir.Instr = irbuild.EmitPhi(b, types.TypBool(), twoPhiEntries(pre, falseV, other, c3))
	irbuild.EmitBranch(b, r, exit, h)
	irbuild.EmitConstInt(h, 1, types.TypInt())
	irbuild.EmitJump(h, body)
	irbuild.EmitBranch(body, boolParam(f), h, exit)
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(exit, noRet)
	threadJumpsFunc(f)
	if lastInstr(f.Blocks[0]).Block1 != b {
		return fail("pre's arm must not be threaded into the loop header h")
	}
	return ""
}

// Not threaded when the branching block's other arm already enters the target
// and the target has phis: two edges from one block could not carry different
// phi values.
func TestThreadConstPhiNotOntoOtherArmPhiBlock() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var b @ir.Block = ir.AddBlock(f, "b")
	var y @ir.Block = ir.AddBlock(f, "y")
	var x @ir.Block = ir.AddBlock(f, "x")
	var falseV @ir.Instr = irbuild.EmitConstBool(pre, false)
	var v @ir.Instr = irbuild.EmitConstInt(pre, 1, types.TypInt())
	irbuild.EmitBranch(pre, boolParam(f), b, x)
	var r @ir.Instr = irbuild.EmitPhi(b, types.TypBool(), onePhiEntry(pre, falseV))
	irbuild.EmitBranch(b, r, y, x)
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(y, noRet)
	var xp @ir.Instr = irbuild.EmitPhi(x, types.TypInt(), twoPhiEntries(pre, v, b, v))
	irbuild.EmitReturn(x, oneRet(xp))
	threadJumpsFunc(f)
	if lastInstr(f.Blocks[0]).Block1 != b {
		return fail("pre's arm into b must stay: x already has an entry from pre")
	}
	return ""
}
