package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for jump threading and block merging (thread_jumps.bn).

// A chain entry -> a (jump-only) -> b (return) becomes one block.
func TestThreadJumpsMergesChain() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Block = ir.AddBlock(f, "a")
	var b @ir.Block = ir.AddBlock(f, "b")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 7, types.TypInt())
	irbuild.EmitJump(entry, a)
	irbuild.EmitJump(a, b)
	irbuild.EmitReturn(b, oneRet(c))
	threadJumpsFunc(f)
	if len(f.Blocks) != 1 {
		return fail("the chain should collapse into the entry block")
	}
	if countOp(f, iropcode.OP_JUMP) != 0 || lastInstr(f.Blocks[0]).Op != iropcode.OP_RETURN {
		return fail("the entry block should end in the return, with no jump left")
	}
	return ""
}

// A merged block's single-entry phi is replaced by its value everywhere.
func TestThreadJumpsMergeReplacesSingleEntryPhi() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var b @ir.Block = ir.AddBlock(f, "b")
	var v @ir.Instr = irbuild.EmitConstInt(entry, 7, types.TypInt())
	irbuild.EmitJump(entry, b)
	var phi @ir.Instr = irbuild.EmitPhi(b, types.TypInt(), onePhiEntry(entry, v))
	var one @ir.Instr = irbuild.EmitConstInt(b, 1, types.TypInt())
	var sum @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, phi, one, types.TypInt())
	irbuild.EmitReturn(b, oneRet(sum))
	threadJumpsFunc(f)
	if len(f.Blocks) != 1 || countOp(f, iropcode.OP_PHI) != 0 {
		return fail("b should be merged into entry and its phi dropped")
	}
	if sum.Args[0] != v {
		return fail("the phi's use should now read its incoming value")
	}
	return ""
}

// A merged block's phi that is used only as another phi's incoming value (a raw
// PhiEntry.Val, which does not keep it alive) is replaced there too.
func TestThreadJumpsMergeReplacesPhiUsedByPhi() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var b @ir.Block = ir.AddBlock(f, "b")
	var t @ir.Block = ir.AddBlock(f, "t")
	var m @ir.Block = ir.AddBlock(f, "m")
	var v @ir.Instr = irbuild.EmitConstInt(entry, 7, types.TypInt())
	irbuild.EmitJump(entry, b)
	var p1 @ir.Instr = irbuild.EmitPhi(b, types.TypInt(), onePhiEntry(entry, v))
	irbuild.EmitBranch(b, boolParam(f), t, m)
	var w @ir.Instr = irbuild.EmitConstInt(t, 9, types.TypInt())
	irbuild.EmitJump(t, m)
	var p2 @ir.Instr = irbuild.EmitPhi(m, types.TypInt(), onePhiEntry(b, p1))
	addPhiEntry(p2, t, w)
	irbuild.EmitReturn(m, oneRet(p2))
	threadJumpsFunc(f)
	if len(f.Blocks) != 3 || countOp(f, iropcode.OP_PHI) != 1 {
		return fail("b should be merged into entry, leaving only m's phi")
	}
	var fromEntry int = 0
	for k := 0; k < len(p2.Phis); k++ {
		if p2.Phis[k].Block == b {
			return fail("m's phi must not name the dropped block b")
		}
		if p2.Phis[k].Block == f.Blocks[0] {
			fromEntry = fromEntry + 1
			if p2.Phis[k].Val.IntVal != cast(int64, 7) {
				return fail("m's entry from entry should carry the dropped phi's value, 7")
			}
		}
	}
	if fromEntry != 1 {
		return fail("m's phi should have exactly one entry for entry")
	}
	return ""
}

// A branch arm into a jump-only block is retargeted to the block's target, which
// gets a phi entry for the branching block; the bypassed block is removed.
func TestThreadJumpsRetargetsBranchArm() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Block = ir.AddBlock(f, "a")
	var b @ir.Block = ir.AddBlock(f, "b")
	var m @ir.Block = ir.AddBlock(f, "m")
	var c1 @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	irbuild.EmitBranch(entry, boolParam(f), a, b)
	irbuild.EmitJump(a, m)
	var y @ir.Instr = irbuild.EmitConstInt(b, 2, types.TypInt())
	irbuild.EmitJump(b, m)
	var phi @ir.Instr = irbuild.EmitPhi(m, types.TypInt(), onePhiEntry(a, c1))
	addPhiEntry(phi, b, y)
	irbuild.EmitReturn(m, oneRet(phi))
	threadJumpsFunc(f)
	if len(f.Blocks) != 3 || !hasLabel(f.Blocks[1], "b") || !hasLabel(f.Blocks[2], "m") {
		return fail("the jump-only block a should be removed, leaving entry, b, m")
	}
	var term @ir.Instr = lastInstr(f.Blocks[0])
	if term.Op != iropcode.OP_BRANCH || term.Block1 != f.Blocks[2] || term.Block2 != f.Blocks[1] {
		return fail("entry's then-arm should go straight to m")
	}
	if len(phi.Phis) != 2 {
		return fail("m's phi should have one entry per predecessor (b and entry)")
	}
	var fromEntry bool = false
	for k := 0; k < len(phi.Phis); k++ {
		if phi.Phis[k].Block == f.Blocks[0] && phi.Phis[k].Val.IntVal == cast(int64, 1) {
			fromEntry = true
		}
	}
	if !fromEntry {
		return fail("m's phi should carry a's value for entry")
	}
	return ""
}

// When both arms of a branch end up on one phi-less block, the branch becomes a
// jump and the whole diamond collapses.
func TestThreadJumpsCollapsesDiamond() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Block = ir.AddBlock(f, "a")
	var b @ir.Block = ir.AddBlock(f, "b")
	var m @ir.Block = ir.AddBlock(f, "m")
	irbuild.EmitBranch(entry, boolParam(f), a, b)
	irbuild.EmitJump(a, m)
	irbuild.EmitJump(b, m)
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(m, noRet)
	threadJumpsFunc(f)
	if len(f.Blocks) != 1 || countOp(f, iropcode.OP_BRANCH) != 0 || countOp(f, iropcode.OP_JUMP) != 0 {
		return fail("the empty diamond should collapse to the entry block alone")
	}
	return ""
}

// A branch whose other arm already reaches a phi block is not threaded onto
// that block: two edges from one block could not carry different phi values.
func TestThreadJumpsKeepsArmIntoPhiBlockFedByOtherArm() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Block = ir.AddBlock(f, "a")
	var m @ir.Block = ir.AddBlock(f, "m")
	var c1 @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	var c2 @ir.Instr = irbuild.EmitConstInt(entry, 2, types.TypInt())
	irbuild.EmitBranch(entry, boolParam(f), a, m)
	irbuild.EmitJump(a, m)
	var phi @ir.Instr = irbuild.EmitPhi(m, types.TypInt(), onePhiEntry(a, c1))
	addPhiEntry(phi, entry, c2)
	irbuild.EmitReturn(m, oneRet(phi))
	threadJumpsFunc(f)
	if len(f.Blocks) != 3 || lastInstr(f.Blocks[0]).Block1 != a {
		return fail("the arm into a must stay: m already has an entry from entry")
	}
	return ""
}

// loopFunc builds entry -> pre -> h (loop header: branch to body or exit),
// body -> h, with pre and body jump-only.
func loopFunc(f @ir.Func) {
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var h @ir.Block = ir.AddBlock(f, "h")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	irbuild.EmitJump(entry, pre)
	irbuild.EmitJump(pre, h)
	irbuild.EmitBranch(h, boolParam(f), body, exit)
	irbuild.EmitJump(body, h)
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(exit, noRet)
}

// Nothing is threaded into a loop header: the jump-only preheader is merged into
// its predecessor instead, which then jumps to the header alone (still a clean
// preheader), and the jump-only latch keeps its back edge.
func TestThreadJumpsKeepsLoopHeaderEdges() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	loopFunc(f)
	threadJumpsFunc(f)
	if len(f.Blocks) != 4 || !hasLabel(f.Blocks[1], "h") || !hasLabel(f.Blocks[2], "body") {
		return fail("pre should be merged into entry; h, body and exit stay")
	}
	var term @ir.Instr = lastInstr(f.Blocks[0])
	if term.Op != iropcode.OP_JUMP || term.Block1 != f.Blocks[1] {
		return fail("entry should end in a jump to the header alone")
	}
	if lastInstr(f.Blocks[1]).Block1 != f.Blocks[2] {
		return fail("the header's arm into the jump-only latch must stay")
	}
	return ""
}

// A branch from outside a loop into its jump-only preheader is not threaded
// into the header: the header's out-of-loop predecessor would then branch
// elsewhere too, and licm needs it to lead only to the header.
func TestThreadJumpsDoesNotThreadIntoHeaderFromOutside() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var h @ir.Block = ir.AddBlock(f, "h")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	irbuild.EmitBranch(entry, boolParam(f), pre, exit)
	irbuild.EmitJump(pre, h)
	irbuild.EmitBranch(h, boolParam(f), body, exit)
	irbuild.EmitConstInt(body, 1, types.TypInt())
	irbuild.EmitJump(body, h)
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(exit, noRet)
	threadJumpsFunc(f)
	if lastInstr(f.Blocks[0]).Block1 != pre {
		return fail("entry's arm must still go through the preheader")
	}
	return ""
}

// An in-loop branch arm into a jump-only latch is not threaded into the header:
// the header would get a second back edge, and bce-loop wants one.
func TestThreadJumpsDoesNotThreadIntoHeaderFromInside() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var h @ir.Block = ir.AddBlock(f, "h")
	var b1 @ir.Block = ir.AddBlock(f, "b1")
	var b2 @ir.Block = ir.AddBlock(f, "b2")
	var latch @ir.Block = ir.AddBlock(f, "latch")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	irbuild.EmitJump(entry, h)
	irbuild.EmitBranch(h, boolParam(f), b1, exit)
	irbuild.EmitBranch(b1, boolParam(f), latch, b2)
	irbuild.EmitConstInt(b2, 1, types.TypInt())
	irbuild.EmitJump(b2, latch)
	irbuild.EmitJump(latch, h)
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(exit, noRet)
	threadJumpsFunc(f)
	if lastInstr(b1).Block1 != latch {
		return fail("b1's arm must still go through the latch")
	}
	return ""
}

// A jump-only loop header is not threaded past: entering below it would change
// the loop's entry.
func TestThreadJumpsDoesNotBypassJumpOnlyHeader() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var h @ir.Block = ir.AddBlock(f, "h")
	var b @ir.Block = ir.AddBlock(f, "b")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	irbuild.EmitJump(entry, h)
	irbuild.EmitJump(h, b)
	irbuild.EmitBranch(b, boolParam(f), h, exit)
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(exit, noRet)
	threadJumpsFunc(f)
	if lastInstr(f.Blocks[0]).Block1 != h {
		return fail("entry must still enter the loop at its header")
	}
	return ""
}

// An empty infinite loop of jump-only blocks is not threaded through (the chain
// never ends), and the pass ends; merging folds it to one self-jumping block.
func TestThreadJumpsJumpOnlyCycleTerminates() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Block = ir.AddBlock(f, "a")
	var b @ir.Block = ir.AddBlock(f, "b")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	irbuild.EmitBranch(entry, boolParam(f), a, exit)
	irbuild.EmitJump(a, b)
	irbuild.EmitJump(b, a)
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(exit, noRet)
	threadJumpsFunc(f)
	if len(f.Blocks) != 3 || lastInstr(f.Blocks[0]).Block1 != a {
		return fail("entry should still branch into the loop at a")
	}
	var loop @ir.Instr = lastInstr(f.Blocks[1])
	if loop.Op != iropcode.OP_JUMP || loop.Block1 != f.Blocks[1] {
		return fail("the loop should be a single block jumping to itself")
	}
	return ""
}
