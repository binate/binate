package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/std/containers/vec"

// A block threading bypasses may end scopes before its terminator: a jump-only
// block (a `break` or `continue` leaving a loop body's scope) or a constant-phi
// branch block (a loop's exit, ending the loop's own scope).  Control leaves those
// scopes there, so the block's successors are outside them.  Threading an edge past
// the block would drop the ends from that edge and leave the scopes' slots live on
// it, so they could never share bytes; the edge's new target ends the scopes itself
// instead.  Ending a scope at a block outside it is right on every edge into the
// block: no slot of the scope is needed once control has left it (spec
// mem.scope-exit), and the scope's next entry starts its slots afresh.

// carryScopeEnds gives t, after its phis, an end of each scope the jump-only chain
// from c up to t ends and t does not already end there.
func carryScopeEnds(c *ir.Block, t *ir.Block) {
	var adds @vec.Vec[int] = vec.New[int]()
	var cur *ir.Block = c
	for cur != t {
		noteScopeEnds(cur, t, adds)
		cur = jumpTarget(cur)
	}
	prependScopeEnds(t, adds)
}

// carryBlockScopeEnds gives t, after its phis, an end of each scope b ends that t
// does not already end there.
func carryBlockScopeEnds(b *ir.Block, t *ir.Block) {
	var adds @vec.Vec[int] = vec.New[int]()
	noteScopeEnds(b, t, adds)
	prependScopeEnds(t, adds)
}

// noteScopeEnds adds to adds each scope b ends that t does not already end after
// its phis and adds does not hold yet.
func noteScopeEnds(b *ir.Block, t *ir.Block, adds @vec.Vec[int]) {
	for i := 0; i < len(b.Instrs); i++ {
		if b.Instrs[i].Op != iropcode.OP_SCOPE_END { continue }
		var s int = b.Instrs[i].Scope
		if !leadingScopeEnd(t, s) && !vecHasInt(adds, s) { adds.Push(s) }
	}
}

// prependScopeEnds puts an end of each scope in adds, in order, at the start of t
// after its phis.
func prependScopeEnds(t *ir.Block, adds @vec.Vec[int]) {
	if adds.Len() == 0 { return }
	var out @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
	var i int = 0
	for i < len(t.Instrs) && t.Instrs[i].Op == iropcode.OP_PHI {
		out.Push(t.Instrs[i])
		i = i + 1
	}
	for k := 0; k < adds.Len(); k++ {
		var e @ir.Instr = irbuild.NewVoidInstr(iropcode.OP_SCOPE_END)
		e.Scope = adds.Get(k)
		out.Push(e)
	}
	for i < len(t.Instrs) {
		out.Push(t.Instrs[i])
		i = i + 1
	}
	t.InstrsVec = out
	t.Instrs = out.Items()
}

// leadingScopeEnd reports whether t ends scope s among the scope ends right after
// its phis.
func leadingScopeEnd(t *ir.Block, s int) bool {
	for i := 0; i < len(t.Instrs); i++ {
		var ins @ir.Instr = t.Instrs[i]
		if ins.Op == iropcode.OP_PHI { continue }
		if ins.Op != iropcode.OP_SCOPE_END { return false }
		if ins.Scope == s { return true }
	}
	return false
}

// vecHasInt reports whether v holds x.
func vecHasInt(v @vec.Vec[int], x int) bool {
	for i := 0; i < v.Len(); i++ {
		if v.Get(i) == x { return true }
	}
	return false
}
