package "pkg/binate/iropt"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for jump threading past scope ends (thread_scope_ends.bn).

// leadingEnds returns the scopes b ends right after its phis, in order.
func leadingEnds(b *ir.Block) @[]int {
	var out @[]int = make_slice(int, 0)
	for i := 0; i < len(b.Instrs); i++ {
		var ins @ir.Instr = b.Instrs[i]
		if ins.Op == iropcode.OP_PHI { continue }
		if ins.Op != iropcode.OP_SCOPE_END { break }
		var grown @[]int = make_slice(int, len(out) + 1)
		for k := 0; k < len(out); k++ { grown[k] = out[k] }
		grown[len(out)] = ins.Scope
		out = grown
	}
	return out
}

// scopeEndFunc builds `entry: branch p, a, b; a: end scopes, jump m; b: jump m;
// m: return` with two scopes, a ending first then second (0: none), and returns
// it with a, b and m.
func scopeEndFunc(first int, second int) (@ir.Func, @ir.Block, @ir.Block, @ir.Block) {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Block = ir.AddBlock(f, "a")
	var b @ir.Block = ir.AddBlock(f, "b")
	var m @ir.Block = ir.AddBlock(f, "m")
	_ = irbuild.NewScope(f)
	_ = irbuild.NewScope(f)
	irbuild.EmitBranch(entry, boolParam(f), a, b)
	if first > 0 { irbuild.EmitScopeEnd(a, first) }
	if second > 0 { irbuild.EmitScopeEnd(a, second) }
	irbuild.EmitJump(a, m)
	_ = irbuild.EmitConstInt(b, 2, types.TypInt())
	irbuild.EmitJump(b, m)
	irbuild.EmitReturn(m, noArgs)
	return f, a, b, m
}

// A block of scope ends and a jump is jump-only; one with any other instruction,
// or jumping to itself, is not.
func TestIsJumpOnlyPastScopeEnds() testing.TestResult {
	f, a, b, _ := scopeEndFunc(1, 2)
	if !isJumpOnly(a) { return fail("scope ends and a jump are jump-only") }
	if isJumpOnly(b) { return fail("a constant before the jump is not") }
	var loop @ir.Block = ir.AddBlock(f, "loop")
	irbuild.EmitScopeEnd(loop, 1)
	irbuild.EmitJump(loop, loop)
	if isJumpOnly(loop) { return fail("a block jumping to itself is not") }
	return ""
}

// Threading a branch arm past a block that ends scopes gives the target those
// ends, in order, so the edge still leaves the scopes.
func TestThreadCarriesScopeEnds() testing.TestResult {
	f, _, _, m := scopeEndFunc(2, 1)
	if !threadJumpOnlyBlocks(f) { return fail("setup: the arm should be threaded") }
	if lastInstr(f.Blocks[0]).Block1 != m { return fail("entry's then-arm goes straight to m") }
	var ends @[]int = leadingEnds(m)
	if len(ends) != 2 || ends[0] != 2 || ends[1] != 1 {
		return fail("m ends scopes 2 and 1, in order")
	}
	if len(irbuild.VerifyModule(moduleOf(f))) != 0 { return fail("the threaded function must verify") }
	return ""
}

// A target that already ends a scope does not end it twice, and a chain of such
// blocks gives the target every scope it ends.
func TestThreadScopeEndsDedupAndChain() testing.TestResult {
	f, a, _, m := scopeEndFunc(1, 0)
	var a2 @ir.Block = ir.AddBlock(f, "a2")
	lastInstr(a).Block1 = a2
	irbuild.EmitScopeEnd(a2, 2)
	irbuild.EmitJump(a2, m)
	threadJumpOnlyBlocks(f)
	var ends @[]int = leadingEnds(m)
	if len(ends) != 2 || ends[0] != 1 || ends[1] != 2 {
		return fail("m ends both scopes of the chain")
	}
	f, _, _, m = scopeEndFunc(1, 0)
	var pre @ir.Instr = irbuild.NewVoidInstr(iropcode.OP_SCOPE_END)
	pre.Scope = 1
	var rest @[]@ir.Instr = m.Instrs
	var instrs @[]@ir.Instr = make_slice(@ir.Instr, len(rest) + 1)
	instrs[0] = pre
	for k := 0; k < len(rest); k++ { instrs[k + 1] = rest[k] }
	m.Instrs = instrs
	threadJumpOnlyBlocks(f)
	if len(leadingEnds(m)) != 1 { return fail("m already ends scope 1, so it gets no second end") }
	return ""
}

// A loop exit that ends the loop's scope between its constant phi and its branch
// still threads, and the branch target the constant selects ends the scope.
func TestConstPhiThreadCarriesScopeEnds() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var yes @ir.Block = ir.AddBlock(f, "yes")
	var no @ir.Block = ir.AddBlock(f, "no")
	var s int = irbuild.NewScope(f)
	var t @ir.Instr = irbuild.EmitConstBool(entry, true)
	irbuild.EmitJump(entry, exit)
	var r @ir.Instr = irbuild.EmitPhi(exit, types.TypBool(), onePhiEntry(entry, t))
	irbuild.EmitScopeEnd(exit, s)
	irbuild.EmitBranch(exit, r, yes, no)
	irbuild.EmitReturn(yes, noArgs)
	irbuild.EmitReturn(no, noArgs)
	var ok bool
	ok, _ = constPhiBranch(exit)
	if !ok { return fail("a phi, a scope end and a branch on the phi is a constant-phi branch") }
	if !threadConstPhiBranches(f) { return fail("setup: entry's jump should be threaded") }
	if lastInstr(entry).Block1 != yes { return fail("entry jumps straight to yes") }
	var ends @[]int = leadingEnds(yes)
	if len(ends) != 1 || ends[0] != s { return fail("yes ends the loop's scope") }
	return ""
}

// A target with phis takes the carried scope ends after its phis.
func TestThreadScopeEndsAfterTargetPhis() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Block = ir.AddBlock(f, "a")
	var b @ir.Block = ir.AddBlock(f, "b")
	var m @ir.Block = ir.AddBlock(f, "m")
	var s int = irbuild.NewScope(f)
	var c1 @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	irbuild.EmitBranch(entry, boolParam(f), a, b)
	irbuild.EmitScopeEnd(a, s)
	irbuild.EmitJump(a, m)
	var c2 @ir.Instr = irbuild.EmitConstInt(b, 2, types.TypInt())
	irbuild.EmitJump(b, m)
	var phi @ir.Instr = irbuild.EmitPhi(m, types.TypInt(), onePhiEntry(a, c1))
	addPhiEntry(phi, b, c2)
	irbuild.EmitReturn(m, oneRet(phi))
	if !threadJumpOnlyBlocks(f) { return fail("setup: the arm should be threaded") }
	if m.Instrs[0] != phi { return fail("m's phi stays first") }
	if m.Instrs[1].Op != iropcode.OP_SCOPE_END || m.Instrs[1].Scope != s {
		return fail("the carried scope end follows m's phi")
	}
	if len(irbuild.VerifyModule(moduleOf(f))) != 0 { return fail("the threaded function must verify") }
	return ""
}
