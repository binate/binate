package "pkg/binate/iropt"

import "pkg/binate/ir"

// A per-function use index: for every value, the instructions that read it.
//
// The SROA legality checks (L1 / L2 and their managed and cost-model variants)
// ask "how is this alloca / loaded value used?" once per candidate.  Answering by
// scanning every instruction of the function per question makes a function's
// analysis O(candidates * instructions); walking an index built once makes it
// O(instructions + uses of the candidates).
//
// The index is a snapshot: it is valid only until the next IR mutation of f.
// Build it after mutating and before the analysis that reads it.  Querying a
// value the index does not cover (id < 0, or created after the build) panics:
// silently answering "no uses" would wrongly look splittable.  Reads ADDED to an
// existing value after the build are not detected, so the build-after-mutation
// discipline is what keeps the index exact.

// valueUse is one read of a value: user's Args[argIdx], or, when argIdx is -1, a
// PhiEntry.Val of user.  user sits at Instrs[pos] of f.Blocks[blockIdx], or of
// f.FaultPads[blockIdx] when inPad is set.
type valueUse struct {
	user     @ir.Instr
	argIdx   int
	inPad    bool
	blockIdx int
	pos      int
}

// useIndex maps an instruction id (0 <= id < cap) to the reads of that value:
// they are reads[start[id] : start[id+1]], all values' reads sharing one array.
type useIndex struct {
	cap   int
	start @[]int
	reads @[]valueUse
}

// buildUseIndex indexes every read, in f's blocks and fault pads, of every value
// with an id below f.NextID.  Two passes over f (count, then fill); the index
// keeps two arrays, start and reads, whatever the number of values.
func buildUseIndex(f @ir.Func) @useIndex {
	var ui @useIndex = make(useIndex)
	ui.cap = f.NextID
	if ui.cap < 0 {
		ui.cap = 0
	}
	var counts @[]int = make_slice(int, ui.cap)
	countValueReads(f.Blocks, ui.cap, counts)
	countValueReads(f.FaultPads, ui.cap, counts)
	// start[id] = how many reads all lower ids have; counts[id] becomes id's fill position.
	ui.start = make_slice(int, ui.cap + 1)
	var total int = 0
	for id := 0; id < ui.cap; id++ {
		ui.start[id] = total
		total = total + counts[id]
		counts[id] = ui.start[id]
	}
	ui.start[ui.cap] = total
	ui.reads = make_slice(valueUse, total)
	fillValueReads(ui, f.Blocks, false, counts)
	fillValueReads(ui, f.FaultPads, true, counts)
	return ui
}

// indexedID returns v's id if the index covers it, else -1.
func indexedID(v *ir.Instr, cap int) int {
	if v == nil || v.ID < 0 || v.ID >= cap {
		return -1
	}
	return v.ID
}

// countValueReads adds, for each value read in blocks, its number of reads to counts.
func countValueReads(blocks @[]@ir.Block, cap int, counts @[]int) {
	for bi := 0; bi < len(blocks); bi++ {
		var blk @ir.Block = blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @ir.Instr = blk.Instrs[ii]
			for k := 0; k < len(instr.Args); k++ {
				var id int = indexedID(instr.Args[k], cap)
				if id >= 0 {
					counts[id] = counts[id] + 1
				}
			}
			for k := 0; k < len(instr.Phis); k++ {
				var id int = indexedID(instr.Phis[k].Val, cap)
				if id >= 0 {
					counts[id] = counts[id] + 1
				}
			}
		}
	}
}

// fillValueReads records each read in blocks into ui, advancing pos[id] per value.
func fillValueReads(ui @useIndex, blocks @[]@ir.Block, inPad bool, pos @[]int) {
	for bi := 0; bi < len(blocks); bi++ {
		var blk @ir.Block = blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var instr @ir.Instr = blk.Instrs[ii]
			for k := 0; k < len(instr.Args); k++ {
				var id int = indexedID(instr.Args[k], ui.cap)
				if id >= 0 {
					recordValueRead(ui, id, pos, instr, k, inPad, bi, ii)
				}
			}
			for k := 0; k < len(instr.Phis); k++ {
				var id int = indexedID(instr.Phis[k].Val, ui.cap)
				if id >= 0 {
					recordValueRead(ui, id, pos, instr, -1, inPad, bi, ii)
				}
			}
		}
	}
}

// recordValueRead stores one read of value `id` at its next free slot pos[id]
// (an index into ui.reads).
func recordValueRead(ui @useIndex, id int, pos @[]int, user @ir.Instr, argIdx int, inPad bool,
		blockIdx int, at int) {
	var u valueUse
	u.user = user
	u.argIdx = argIdx
	u.inPad = inPad
	u.blockIdx = blockIdx
	u.pos = at
	ui.reads[pos[id]] = u
	pos[id] = pos[id] + 1
}

// usesOf returns the reads of v recorded in ui.  v must be a value the index
// covers (0 <= v.ID < ui.cap): see the file header.
func (ui @useIndex) usesOf(v @ir.Instr) @[]valueUse {
	var id int = indexedID(v, ui.cap)
	if id < 0 {
		panic("iropt: use-index query for an uncovered value (id < 0, or new since the build)")
	}
	return ui.reads[ui.start[id]:ui.start[id + 1]]
}
