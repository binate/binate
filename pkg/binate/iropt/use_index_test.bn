package "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the per-function use index (use_index.bn).

// A value read as a store address, a load address and a store value, as a phi
// entry, and from a fault pad: every read is indexed with its operand position
// (-1 for the phi entry) and whether it sits in a pad.
func TestUseIndexRecordsEveryRead() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var merge @ir.Block = ir.AddBlock(f, "merge")
	var a @ir.Instr = irbuild.EmitAlloc(entry, types.TypInt())
	var c @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	irbuild.EmitStore(entry, a, c)
	var ld @ir.Instr = irbuild.EmitLoad(entry, a, types.TypInt())
	var p @ir.Instr = irbuild.EmitAlloc(entry, types.TypInt())
	irbuild.EmitStore(entry, p, ld)
	var cond @ir.Instr = irbuild.EmitConstBool(entry, true)
	irbuild.EmitBranch(entry, cond, thenB, merge)
	irbuild.EmitJump(thenB, merge)
	var phi @ir.Instr = irbuild.EmitPhi(merge, types.TypInt(), twoEntries(entry, ld, thenB, c))
	irbuild.EmitReturn(merge, oneRet(phi))
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	irbuild.EmitLoad(pad, a, types.TypInt())
	irbuild.EmitReturn(pad, noArgs)

	var ui @useIndex = buildUseIndex(f)
	var au @[]valueUse = ui.usesOf(a)
	if len(au) != 3 { return fail("a: expected store, load and pad-load reads") }
	if au[0].user.Op != iropcode.OP_STORE || au[0].argIdx != 0 || au[0].inPad {
		return fail("a: first read is the store's address, in a block")
	}
	if au[1].user != ld || au[1].argIdx != 0 || au[1].inPad {
		return fail("a: second read is the block load's address")
	}
	if !au[2].inPad || au[2].argIdx != 0 { return fail("a: third read is the pad load's address") }
	var lu @[]valueUse = ui.usesOf(ld)
	if len(lu) != 2 { return fail("ld: expected the store-value read and the phi entry") }
	if lu[0].argIdx != 1 { return fail("ld: stored as Args[1]") }
	if lu[1].argIdx != -1 || lu[1].user != phi { return fail("ld: phi entry has argIdx -1") }
	if len(ui.usesOf(c)) != 2 { return fail("c: store value and phi entry") }
	if len(ui.usesOf(phi)) != 1 { return fail("phi: read by the return") }
	return ""
}

// An instruction reading a value in two operand positions records both reads, so
// the L1 check still sees the escaping one: `store a, a` stores a's address.
func TestUseIndexStoreOfItselfPinsL1() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Instr = irbuild.EmitAlloc(b, eightIntStruct())
	irbuild.EmitStore(b, a, a)
	irbuild.EmitReturn(b, noArgs)
	var ui @useIndex = buildUseIndex(f)
	if len(ui.usesOf(a)) != 2 { return fail("store a, a reads a twice") }
	if sroaAllocaL1OK(ui, a) { return fail("storing a's address must pin a") }
	return ""
}

// A field-ptr chain read from a fault pad pins a non-managed candidate, but the
// managed (pad-aware) L1 accepts it when the pad only loads through it.
func TestUseIndexPadFieldPtrChain() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Instr = irbuild.EmitAlloc(b, eightIntStruct())
	var fp @ir.Instr = irbuild.EmitGetFieldPtr(b, a, 0, types.TypInt())
	irbuild.EmitStore(b, fp, irbuild.EmitConstInt(b, 1, types.TypInt()))
	irbuild.EmitReturn(b, noArgs)
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	var pfp @ir.Instr = irbuild.EmitGetFieldPtr(pad, a, 1, types.TypInt())
	irbuild.EmitLoad(pad, pfp, types.TypInt())
	irbuild.EmitReturn(pad, noArgs)
	var ui @useIndex = buildUseIndex(f)
	if sroaAllocaL1OK(ui, a) { return fail("a pad read pins a non-managed candidate") }
	if !managedAllocaUsesOK(ui, a) { return fail("the pad-aware L1 admits a pad load chain") }
	return ""
}
