// Package irsym holds the IR-generation module symbol-table ENTRY types — the
// per-module gen-time lookup-table records (`Module.Consts` / `.Structs` /
// `.GlobalVars` / `.TypeAliases` / `.Interfaces`) that IR-gen fills while
// lowering a package's AST, so later expressions resolve identifiers, composite
// literals, `type T = U` aliases, and interface dispatch.  They are plain data
// records with no back-reference to the IR graph (@Module / @Func / @Instr), so
// they live in this leaf package that `pkg/binate/ir` imports — keeping the ir
// interface (and package) smaller.  Extracted from ir.bni for that reason,
// mirroring the earlier iropcode / irdata splits.
package "pkg/binate/irsym"

import "pkg/binate/ast"
import "pkg/binate/types"

// ModuleConst is one entry in a module's gen-time const lookup table:
// IR-gen records every named const so later expressions resolve an
// identifier to its compile-time value.  Kind selects which value field
// is live (see the CONST_* constants in the implementation).
type ModuleConst struct {
	Name @[]char
	Val  int64 // integer / iota value (Kind == CONST_INT); int64 so a 64-bit
	// named const (e.g. a uint64 >= 2^32) survives codegen on a 32-bit-int host
	BoolVal bool // bool-literal value (Kind == CONST_BOOL)
	FltText @[]char // float-literal raw text (Kind == CONST_FLT)
	Expr    @ast.Expr // float const-EXPRESSION (Kind == CONST_EXPR),
	// re-lowered via genExpr at each read site
	Kind int // constant family — see the CONST_* constants
	Typ  @types.Type // declared type (nil means untyped/iota)
}

// ModuleStruct is one entry in a module's gen-time struct-type lookup
// table, so composite literals and field accesses can recover the layout.
type ModuleStruct struct {
	Name   @[]char
	Fields @[]@types.Field
	Typ    @types.Type
	// IsInstantiation marks a monomorphized generic struct (from
	// ensureInstantiatedStruct).  Its Name is qualified by the generic's
	// DEFINING package, not the consumer module, so the dtor/copy-helper
	// driver must DEFINE its helpers locally (IsLinkOnce) in every consumer
	// rather than treat the defining-pkg prefix as cross-package and emit an
	// extern declaration (which nobody defines — the defining package never
	// instantiates it).  Mirrors the generic-func IsLinkOnce merge.
	IsInstantiation bool
	// InstDecl / InstDefPkg / InstArgs carry the (generic decl, defining
	// package, type-args) an IsInstantiation struct was built from, so its
	// generic-receiver methods can be emitted LAZILY at a use site
	// (ensureMethodsForInstName) rather than when the struct is first laid out.
	// Deferred because a struct can be instantiated (global-var / field / alias
	// type) before the method registry is populated (pass 3) or before other
	// FuncSigs exist — emitting there would drop bodies or mis-resolve calls.
	// nil InstDecl on a non-instantiation entry.
	InstDecl   @ast.Decl
	InstDefPkg @[]char
	InstArgs   @[]@types.Type
}

// ModuleGlobal is one entry in a module's gen-time top-level-`var` lookup
// table, so name lookups in function bodies resolve to a global when no
// local of the same name exists.
type ModuleGlobal struct {
	Name @[]char
	Typ  @types.Type
	Init int // initial value (integer only for now)
	// IsExtern marks an imported extern var (a `.bni`-declared `var X T`
	// from another package, registered during RegisterImport).  Name is
	// the defining-package dotted qualname; gen_module materializes it as
	// an `IsExtern` ir.Global (an `external global` decl) rather than a
	// definition, and gen_selector resolves a qualified read against it.
	IsExtern bool
	// Exported mirrors the decl's `.bni`-membership export flag, carried
	// onto the materialized ir.Global so the reflect descriptor's
	// exported-global table can list it.
	Exported bool
}

// ModuleTypeAlias is one entry in a module's gen-time `type T = U` lookup
// table, so subsequent type references resolve correctly.
type ModuleTypeAlias struct {
	Name @[]char
	Typ  @types.Type
}

// ModuleInterface is one entry in a module's interface registry
// (`Module.Interfaces`): an interface's method-name list (declaration order),
// the flattened result/param type tables (MethodResultsFlat/Counts,
// MethodParamsFlat/Counts — so a 0-/1-/>=2-result method's dispatch builds
// the right result shape), the alias chain (AliasTarget/Pkg for
// `interface X = Y`), and the parent list (ParentPkgs/ParentNames for
// `interface X : P`).  Built during GeneratePackage/GenModule's first pass
// (collectInterfaceFromDecl), seeded with universe `any` per module; consumed
// by impl-collection and the use-site dispatch / vtable-layout helpers (incl.
// the exported Iface* queries the VM's cross-mode vtable lowering reads).
type ModuleInterface struct {
	// Pkg: short package name where the interface is declared
	// ("main" / "greeter" / etc.). Cross-package references match
	// on (Pkg, Name); same-package references use Pkg = current
	// module's pkgShort.
	Pkg         @[]char
	Name        @[]char
	MethodNames @[]@[]char
	// MethodParamsFlat holds every method's param types concatenated in
	// method order; MethodParamCounts[j] is method j's param count (method
	// j's params are MethodParamsFlat[off..off+count], off = sum of earlier
	// counts).  Flat (not @[]@[]@Type) because a managed-slice-of-managed-
	// slice STRUCT FIELD trips a missing nested cross-package element dtor in
	// the current BUILDER.  Interface dispatch needs these to apply the same
	// arg coercions the regular call path does.
	MethodParamsFlat  @[]@types.Type
	MethodParamCounts @[]int
	// MethodParamVariadic[j] marks method j as having a variadic final
	// parameter (`name ...T`), parallel to MethodParamCounts.  At an interface
	// vtable dispatch, variadic-ness is erased at the ABI (spec §10.3): the
	// caller packs/spreads to a plain `*[]T` before the single indirection, so
	// this tells genInterfaceMethodCall whether to do so.  `@[]bool` (per-method
	// scalar), not a nested managed-slice, to stay BUILDER-safe.
	MethodParamVariadic @[]bool
	// MethodResultsFlat / MethodResultCounts: every method's RESULT types
	// flattened in method order, parallel to MethodParamsFlat/Counts.  The
	// CR-2 SEAM field — DEFINED by IR-gen, CONSUMED read-only by the codegen /
	// native backends for >=2-result tuple layout.
	MethodResultsFlat  @[]@types.Type
	MethodResultCounts @[]int
	// AliasTarget (Slice 2.4): for `interface X = Y`, the target's name;
	// lookups follow the chain on read.  Empty for non-alias entries.
	// AliasTargetPkg names a cross-package alias target's package.
	AliasTarget    @[]char
	AliasTargetPkg @[]char
	// ParentPkgs / ParentNames:
	// parallel arrays naming each parent interface this one extends, in
	// declaration order.  Empty for interfaces that don't extend.
	ParentPkgs  @[]@[]char
	ParentNames @[]@[]char
}
