// Package irutil holds small, pure IR helper utilities shared by ir and irgen:
// type predicates, string/name helpers, and type-argument name mangling.  It
// depends only on types/mangle (never on ir), so both ir and irgen may import it.
package "pkg/binate/irutil"

import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/std/strings"

// PeelTransparent strips every IR-transparent type wrapper — `readonly`
// (`.Elem`), named-distinct `type X ...` (`.Underlying`), and alias
// `type X = ...` (`.Target`) — to a fixpoint, returning the underlying
// represented type.  All three change a type's *meaning*, not its runtime
// layout, so any representation/dispatch decision (slot type, struct-field
// GEP, the managed/raw-ptr-to-struct predicates below) must see through them.
// A missed peel leaves a `readonly @Box` / named-`@Box` failing every
// Kind-test, so a field read falls through to the literal-0 fallback in
// genSelector (silent data corruption).
func PeelTransparent(t @types.Type) @types.Type

// QualifyForPkgPath is the package-path-parameterized core of
// qualifyForCurrentModule: it prepends `<pkgPath>.` to a bare name, and
// passes an already-dotted name (or an empty pkgPath) through unchanged.
// Sites that hold a concrete package path — the @Block emit methods
// (`b.Func.ModulePkgPath`) and the @Module init helpers (`m.PkgPath`) —
// call it directly instead of reading the ambient package-global, which
// is how the global's readers are being retired.
func QualifyForPkgPath(pkgPath *[]readonly char, name *[]readonly char) @[]char

// Streq compares two char slices for equality.
func Streq(a *[]readonly char, b *[]readonly char) bool

// CharEq compares two char slices for equality (same as streq).
func CharEq(a *[]readonly char, b *[]readonly char) bool

// MakeMultiReturnStructType creates an anonymous struct type for multi-return.
// Fields are named _0, _1, ... with types matching the return types.
func MakeMultiReturnStructType(results *[]@types.Type) @types.Type

// IsBitCastMemoryLoweredKind reports whether the ALREADY-PEELED t is an aggregate
// whose bit_cast must be lowered through memory (managed slice / struct / array /
// func-value / interface value).  These types are stored BY ADDRESS on the native
// backends and the VM and are first-class BY-VALUE values in LLVM — neither of
// which a register/first-class OP_BIT_CAST can reinterpret — so genBuiltin routes
// any bit_cast involving one through a scratch round-trip (emitBitCastViaMemory).
// A raw slice (TYP_SLICE, an element-agnostic {data,len}) and pointers are NOT in
// this set: their representation already IS a same-size reinterpret, so they stay
// a direct OP_BIT_CAST.
func IsBitCastMemoryLoweredKind(t @types.Type) bool

// SplitQualName splits a possibly-qualified IR-gen identifier
// (`pkg.Name`) into its components. For unqualified inputs, returns
// empty pkg + the input as name. Used by wrapAsIfaceValue to
// recover the receiver's canonical (pkg, name) pair from
// IR-gen's qualified-form Type.Name (`hello.Hello`) so cross-
// package impl-table lookup matches. Slice 2.8.
func SplitQualName(name *[]readonly char) (@[]char, @[]char)

// IsManagedScalarType returns true for the four managed VALUE types the
// refcount machinery handles inline at a store site — @T, @[]T, @func(...),
// and @Iface — as opposed to struct/array aggregates (which copy/destroy
// via emitStructCopy / emitStructDtor).  Drives copy-RefInc of a new value
// and RefDec of the overwritten old value in the assignment paths.
func IsManagedScalarType(t @types.Type) bool

// ReceiverBaseTypeName extracts the underlying named-type name
// from a pointer / managed-pointer / const-wrapped type expression
// resolved by IR-gen. Mirrors types.ReceiverBaseNamed but accepts
// IR-gen's representation where struct types may live as TYP_STRUCT
// directly (with Name populated) rather than wrapped in TYP_NAMED.
func ReceiverBaseTypeName(t @types.Type) @[]char

// DtorName returns the dtor symbol for a struct type from its LEAF name (legacy).
func DtorName(structName *[]readonly char) @[]char

// WriteStructLeafToken writes an injective encoding of a struct's LEAF name into a
// dtor/copy symbol.  A USER struct leaf is LENGTH-PREFIXED (`<declen><leaf>`): the
// leading digit means it can never reconstruct a letter-initial wrapper kind token
// (`mp_`/`ms_`/`arr`/…), so a top-level struct source-named like a wrapper helper (e.g.
// `struct mp_N1_1_M4_Node`) no longer shadows that wrapper's own `__dtor_mp_…` helper.
// A SYNTHESIZED named leaf (compiler-generated `__closure_…`, `__`-prefixed — user
// identifiers can never start with `__`, per checkReservedDeclNames; multi-return
// structs are anonymous and take anonStructSuffix, not this path) is written VERBATIM:
// it already begins
// with `_`, disjoint from every letter-initial kind token, and staying verbatim keeps
// it byte-identical to the backend's independent closure-dtor naming
// (codegen closureStructDtorMangledName), so no cross-package edit is needed.  Used at
// EVERY struct-leaf dtor/copy naming site (dtorName / qualifiedDtorName{,ForType} and
// their copy twins, dtorTypeSuffixRec's top-level struct arm, implDtorFuncName) so a
// struct's definition and every reference stay in agreement.
func WriteStructLeafToken(cb *strings.Builder, leaf *[]readonly char)

// PrimitiveQualifiedName returns the call-site name of a
// primitive, qualified with the carve-out package's full path.
// pkg/builtins/lang owns the canonical impls for primitives,
// so a method on `int`
// is mangled as `pkg/builtins/lang.int.<Method>` everywhere — this is what
// the call-site qualifier produces for a method on a value of
// primitive type, matching pkg/builtins/lang's own impl registration.
func PrimitiveQualifiedName(name @[]char) @[]char

// IsUniversePrimitive reports whether t is a universe-scope
// primitive (int / float / bool family).  Used at call sites
// to recognize that the method's owning package is the
// stdlib carve-out (`pkg/builtins/lang`) rather than a regular user
// package; mirrors the type-checker's predicate.
func IsUniversePrimitive(t @types.Type) bool

// NamelessAnySrcName builds the reserved synthetic receiver name for a name-less
// dynamic type `t` boxed into a raw `*any`: `pkg/builtins/rt.__nameless_<lp>`,
// where `<lp>` is t's STRUCTURAL mangling (mangleTypeArg).  This gives each
// distinct name-less spelling its own weak-coalesced `__ivt` / `__typeinfo` — so
// `@[]char` and `*[]int` boxes carry DISTINCT identities — while `char` ≡ `uint8`
// collapse to one (mangleTypeArg keys on the identical singleton).  It supersedes
// the earlier single shared-opaque sentinel: distinct identity is what the
// slice-assertion HIT keys on.  The `__`-prefixed name is compiler-reserved and
// un-spellable, so a user type can neither collide with it nor match it.  The
// qualified `pkg/builtins/rt.` prefix makes splitQualName recover a FIXED package
// (not the current one), so the record coalesces to one survivor program-wide.
func NamelessAnySrcName(t @types.Type) @[]char

// IsManagedSliceType returns true if t is @[]T (managed slice), peeling any
// IR-transparent wrapper first — `readonly @[]T` AND a named-distinct
// `type Buf @[]T` are both still managed slices that own a refcount the
// caller must RefInc/RefDec.  Mirrors isManagedPtrType: peeling only readonly
// (not named) made a `var b Buf = ...` local fail every scope-cleanup
// classifier, so its backing was never RefDec'd — a silent leak.
func IsManagedSliceType(t @types.Type) bool

// IsManagedPtrType returns true if t is @T (managed pointer), peeling any
// IR-transparent wrapper first (a `readonly @T` / named-`@T` is still a
// managed pointer for every lowering decision).
func IsManagedPtrType(t @types.Type) bool

// IsManagedIfaceValueType returns true if t is @Iface (managed interface
// value), peeling any IR-transparent wrapper first (mirrors isManagedPtrType /
// isManagedSliceType) so a named-distinct or readonly-wrapped @Iface is still
// recognized for refcount cleanup.
func IsManagedIfaceValueType(t @types.Type) bool

// IsManagedFuncValueType returns true if t is @func(...) (managed function
// value), peeling any IR-transparent wrapper first (mirrors isManagedPtrType /
// isManagedSliceType).  Note: IR-gen represents a named-distinct func-value
// type transparently as its underlying @func (typeDeclEntryType strips the
// TYP_NAMED), so the named case rarely reaches here — but peeling keeps the
// predicate uniform with the other managed-scalar classifiers.
func IsManagedFuncValueType(t @types.Type) bool

// MangleTypeArg produces a length-prefix TypeArg token for one type arg, the
// inverse of which mangle.Demangle recovers.  Composite types recurse over
// their element / signature; a named or primitive type is the `N`-tag leaf
// (built from its fully-qualified name).  Every token is identifier-safe and
// injective — distinct types always yield distinct tokens.
func MangleTypeArg(t @types.Type) @[]char

// MsElemsDtorName names the scalar-arg managed-slice element-cleanup helper
// `__dtor_ms_elems_<T>(backingPtr *uint8, backingLen int)` for a managed slice
// type @[]@E: the refcount==1-guarded element-RefDec loop + backing RefDec, given
// the backing pointer and its length directly (no 4-word slice image).  The
// by-address `__dtor_<T>` delegates to it, and the -O1+ inline cleanup calls it
// with `extract(sliceVal, 2)` / `extract(sliceVal, 3)` — extract-only, so the
// slice stays SROA-forwardable.  The `__dtor_ms_elems_` prefix distinguishes it
// from the PAIRED by-address `__dtor_<T>` of the same type.  The `dtorTypeSuffix`
// this shares length-prefixes nested struct names, so a struct adversarially named
// to spoof the kind tokens (e.g. `struct elems_ms_mp_Node`) no longer collides —
// its nested encoding is digit-initial (`<len>…`) and can't reconstruct a
// letter-initial kind-token sequence.
func MsElemsDtorName(t @types.Type) @[]char

// DtorTypeSuffix appends the type-encoding suffix for a dtor/copy function name.
func DtorTypeSuffix(cb *strings.Builder, t @types.Type)

// DtorNameForType returns the dtor function name for a given type.  A top-level
// struct is named by its bare leaf; a NESTED struct/named type is encoded with
// mangle.LpTypeArgNamedRaw (an injective, identifier-only full-name encoding, e.g.
// `pkg/foo.Node` -> `N2_3_pkg3_foo4_Node`) so the element-walk suffix is injective —
// see dtorTypeSuffixRec.  Shape (writing `<Node>` for that nested encoding):
//   struct Node        → "__dtor_Node"           (top-level struct: bare leaf)
//   @Node              → "__dtor_mp_<Node>"      (managed pointer; Node nested)
//   @[]@Node           → "__dtor_ms_mp_<Node>"   (managed-slice of managed ptr)
//   @[]@[]@Node        → "__dtor_ms_ms_mp_<Node>" (recursive)
//   [5]@Node           → "__dtor_arr5_mp_<Node>" (array)
// Only called for types where NeedsDestruction is true.
func DtorNameForType(t @types.Type) @[]char

// QualifiedDtorName handles cross-package struct names (legacy).
func QualifiedDtorName(structName *[]readonly char) @[]char

// HasName returns true if the name exists in the given list.
func HasName(names @[]@[]char, name *[]readonly char) bool

// DotSuffix returns the substring after the first dot (e.g., "ast.File" -> "File").
func DotSuffix(s *[]readonly char) *[]readonly char

func IsAnonStructName(name *[]readonly char) bool
