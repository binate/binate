package "pkg/binate/irutil"

import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// Tests for dtor_suffix.bn: a helper name's type encoding is written by a loop, so a
// chain of named types, a ring of them and a nest of element kinds far longer than a
// stack could follow a call per part are written whole.

// deepLinks is how long the deep tests' chains, rings and nests are: far past what a
// walk with a call per part could hold on its stack.
const deepLinks int = 100000

// nameIs returns "" when got is want, else a message naming both.
func nameIs(got *[]readonly char, want *[]readonly char) testing.TestResult {
	if CharEq(got, want) { return "" }
	return buf.Concat(buf.Concat("got ", got), buf.Concat(", want ", want))
}

// msOf returns the managed-slice of elem.
func msOf(elem @types.Type) @types.Type {
	return types.MakeManagedSliceTypeUncached(elem)
}

// structOf returns a struct named name (empty for an anonymous one) whose fields, f0,
// f1, ..., have the types ts.
func structOf(name @[]char, ts *[]@types.Type) @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, len(ts))
	for i := 0; i < len(ts); i++ {
		var f @types.Field = make(types.Field)
		f.Name = buf.Concat("f", strconv.Itoa(i))
		f.Type = ts[i]
		fs[i] = f
	}
	return types.MakeStructType(name, fs)
}

// typesOf2 returns the two types a and b.
func typesOf2(a @types.Type, b @types.Type) @[]@types.Type {
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = a
	ts[1] = b
	return ts
}

// namedChain returns n named types N0 .. N<n-1> around base, each over the next: N0
// over N1 ... over base.
func namedChain(base @types.Type, n int) @types.Type {
	var t @types.Type = base
	for i := n - 1; i >= 0; i-- {
		var nt @types.Type = types.MakeNamedType(buf.Concat("N", strconv.Itoa(i)))
		nt.Underlying = t
		t = nt
	}
	return t
}

// releaseNamedChain drops a chain of named types a link at a time, so its release does
// not nest one destruction per link.
func releaseNamedChain(t @types.Type) {
	var cur @types.Type = t
	for cur != nil && cur.Kind == types.TYP_NAMED {
		var next @types.Type = cur.Underlying
		cur.Underlying = nil
		cur = next
	}
}

// namedSliceRing returns n named types L0 .. L<n-1>, each a managed-slice of the next,
// the last of the first.
func namedSliceRing(n int) @[]@types.Type {
	var ring @[]@types.Type = make_slice(@types.Type, n)
	for i := 0; i < n; i++ {
		ring[i] = types.MakeNamedType(buf.Concat("L", strconv.Itoa(i)))
	}
	for i := 0; i < n; i++ {
		ring[i].Underlying = msOf(ring[(i + 1) % n])
	}
	return ring
}

// releaseRing breaks every link of a ring of namedSliceRing's, so its types are freed
// one by one rather than a destruction nested per type (or never, round the ring).
func releaseRing(ring *[]@types.Type) {
	for i := 0; i < len(ring); i++ {
		ring[i].Underlying = nil
	}
}

// A chain of named types far longer than a stack could follow a call per link is
// written as the type it ends at: a struct by name where it is an element, and a
// managed-slice of int where the chain is the whole type.
func TestDeepNamedChainSuffix() testing.TestResult {
	var e @types.Type = structOf("E", typesOf2(msOf(types.TypInt()), types.TypInt()))
	var chain @types.Type = namedChain(e, deepLinks)
	var nested @[]char = DtorNameForType(msOf(chain))
	releaseNamedChain(chain)
	var r testing.TestResult = nameIs(nested, buf.Concat("__dtor_ms_", mangle.LpTypeArgNamedRaw("E")))
	if len(r) > 0 { return r }
	var top @types.Type = namedChain(msOf(types.TypInt()), deepLinks)
	var whole @[]char = DtorNameForType(top)
	releaseNamedChain(top)
	return nameIs(whole, "__dtor_ms_int")
}

// In a ring of named managed-slices far longer than a stack could follow, each type
// reaches itself, so each is written by name where it is an element.
func TestDeepNamedRingSuffix() testing.TestResult {
	var ring @[]@types.Type = namedSliceRing(deepLinks)
	var first @[]char = DtorNameForType(ring[0])
	var inner @[]char = DtorNameForType(msOf(ring[5]))
	releaseRing(ring)
	var r testing.TestResult = nameIs(first, buf.Concat("__dtor_ms_", mangle.LpTypeArgNamedRaw("L1")))
	if len(r) > 0 { return r }
	return nameIs(inner, buf.Concat("__dtor_ms_", mangle.LpTypeArgNamedRaw("L5")))
}

// A nest of managed-slices far deeper than a stack could follow a call per level is
// written a kind token per level.
func TestDeepManagedSliceNestSuffix() testing.TestResult {
	var t @types.Type = types.TypInt()
	for i := 0; i < deepLinks; i++ {
		t = msOf(t)
	}
	var got @[]char = DtorNameForType(t)
	var cur @types.Type = t
	for cur != nil && cur.Kind == types.TYP_MANAGED_SLICE {
		var next @types.Type = cur.Elem
		cur.Elem = nil
		cur = next
	}
	var want @strings.Builder = strings.NewBuilder()
	want.Write("__dtor_")
	for i := 0; i < deepLinks; i++ {
		want.Write("ms_")
	}
	want.Write("int")
	if !CharEq(got, want.String()) { return "each level should be written ms_, then int" }
	return ""
}

// Where its underlying names a named type with a definition, a nested chain of named
// types is written by the name of its last link, the one whose underlying that is: N0
// over N1 over @[]N1 is N1, and M0 over M1 over @[]M0 is M1, as M1 on its own is.
func TestNamedChainWrittenByLastLink() testing.TestResult {
	var n0 @types.Type = types.MakeNamedType("N0")
	var n1 @types.Type = types.MakeNamedType("N1")
	n0.Underlying = n1
	n1.Underlying = msOf(n1)
	var viaN0 @[]char = DtorNameForType(msOf(n0))
	n1.Underlying = nil
	var m0 @types.Type = types.MakeNamedType("M0")
	var m1 @types.Type = types.MakeNamedType("M1")
	m0.Underlying = m1
	m1.Underlying = msOf(m0)
	var viaM0 @[]char = DtorNameForType(msOf(m0))
	var viaM1 @[]char = DtorNameForType(msOf(m1))
	m1.Underlying = nil
	var r testing.TestResult = nameIs(viaN0, buf.Concat("__dtor_ms_", mangle.LpTypeArgNamedRaw("N1")))
	if len(r) > 0 { return r }
	r = nameIs(viaM0, buf.Concat("__dtor_ms_", mangle.LpTypeArgNamedRaw("M1")))
	if len(r) > 0 { return r }
	return nameIs(viaM1, buf.Concat("__dtor_ms_", mangle.LpTypeArgNamedRaw("M1")))
}

// A nested named type whose underlying names no named type with a definition is
// spelled by its underlying, and one whose underlying does is written by name, though
// it does not reach itself: with Celsius over int and Temps over @[]Celsius, @[]Celsius
// is ms_int (shared with @[]int) and @[]Temps is ms_<Temps>.
func TestNestedNamedTypeSpelledOrNamed() testing.TestResult {
	var celsius @types.Type = types.MakeNamedType("Celsius")
	celsius.Underlying = types.TypInt()
	var temps @types.Type = types.MakeNamedType("Temps")
	temps.Underlying = msOf(celsius)
	var r testing.TestResult = nameIs(DtorNameForType(msOf(celsius)), "__dtor_ms_int")
	if len(r) > 0 { return r }
	return nameIs(DtorNameForType(msOf(temps)),
			buf.Concat("__dtor_ms_", mangle.LpTypeArgNamedRaw("Temps")))
}

// An anonymous struct is written `anon<count>`, then each field's encoding after its
// length -- a nested anonymous struct's included, and a field after one.
func TestAnonStructFieldsWritten() testing.TestResult {
	var inner @types.Type = structOf("", typesOf2(msOf(types.TypBool()), types.TypInt()))
	var none @[]@types.Type
	var ts @[]@types.Type = make_slice(@types.Type, 3)
	ts[0] = msOf(types.TypInt())
	ts[1] = inner
	ts[2] = structOf("", none)
	var got @[]char = DtorNameForType(msOf(structOf("", ts)))
	return nameIs(got, "__dtor_ms_anon3_6_ms_int_21_anon2_7_ms_bool_3_int_5_anon0")
}
