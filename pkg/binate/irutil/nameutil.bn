package "pkg/binate/irutil"

import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// mangleParamTypes / mangleResultTypes render a signature's parameter and
// result types as the pre-encoded TypeArg list a func-type Sig consumes.
func mangleParamTypes(params @[]@types.Param) @[]@[]char {
	var out @[]@[]char
	for i := 0; i < len(params); i++ {
		out = slices.Append[@[]char](out, MangleTypeArg(params[i].Type))
	}
	return out
}

// mangleResultTypes renders a signature's result types as a TypeArg list.
func mangleResultTypes(results @[]@types.Type) @[]@[]char {
	var out @[]@[]char
	for i := 0; i < len(results); i++ {
		out = slices.Append[@[]char](out, MangleTypeArg(results[i]))
	}
	return out
}

// structArgFieldNames / structArgFieldTypeArgs render an anonymous struct's fields
// as the parallel (name, encoded-type) lists LpTypeArgStruct consumes — field NAMES
// are part of an anon struct's identity (`struct{x int}` ≠ `struct{y int}`), so both
// ride the token.  Field types recurse through mangleTypeArg (structural all the way
// down; a nested anon-struct field recurses this same arm).
func structArgFieldNames(t @types.Type) @[]@[]char {
	var out @[]@[]char
	for i := 0; i < len(t.Fields); i++ {
		out = slices.Append[@[]char](out, t.Fields[i].Name)
	}
	return out
}

// structArgFieldTypeArgs renders each field's TYPE as a TypeArg (see
// structArgFieldNames).
func structArgFieldTypeArgs(t @types.Type) @[]@[]char {
	var out @[]@[]char
	for i := 0; i < len(t.Fields); i++ {
		out = slices.Append[@[]char](out, MangleTypeArg(t.Fields[i].Type))
	}
	return out
}

// MsElemsDtorName names the scalar-arg managed-slice element-cleanup helper
// `__dtor_ms_elems_<T>(backingPtr *uint8, backingLen int)` for a managed slice
// type @[]@E: the refcount==1-guarded element-RefDec loop + backing RefDec, given
// the backing pointer and its length directly (no 4-word slice image).  The
// by-address `__dtor_<T>` delegates to it, and the -O1+ inline cleanup calls it
// with `extract(sliceVal, 2)` / `extract(sliceVal, 3)` — extract-only, so the
// slice stays SROA-forwardable.  The `__dtor_ms_elems_` prefix distinguishes it
// from the PAIRED by-address `__dtor_<T>` of the same type.  The `dtorTypeSuffix`
// this shares length-prefixes nested struct names, so a struct adversarially named
// to spoof the kind tokens (e.g. `struct elems_ms_mp_Node`) no longer collides —
// its nested encoding is digit-initial (`<len>…`) and can't reconstruct a
// letter-initial kind-token sequence.
func MsElemsDtorName(t @types.Type) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("__dtor_ms_elems_")
	DtorTypeSuffix(cb, t)
	return buf.CopyStr(cb.String())
}

// DtorTypeSuffix appends the type-encoding suffix for a dtor/copy function name.
func DtorTypeSuffix(cb *strings.Builder, t @types.Type) {
	dtorTypeSuffixRec(cb, t, false)
}

// DtorNameForType returns the dtor function name for a given type.  A top-level
// struct is named by its bare leaf; a NESTED struct/named type is encoded with
// mangle.LpTypeArgNamedRaw (an injective, identifier-only full-name encoding, e.g.
// `pkg/foo.Node` -> `N2_3_pkg3_foo4_Node`) so the element-walk suffix is injective —
// see dtorTypeSuffixRec.  Shape (writing `<Node>` for that nested encoding):
//   struct Node        → "__dtor_Node"           (top-level struct: bare leaf)
//   @Node              → "__dtor_mp_<Node>"      (managed pointer; Node nested)
//   @[]@Node           → "__dtor_ms_mp_<Node>"   (managed-slice of managed ptr)
//   @[]@[]@Node        → "__dtor_ms_ms_mp_<Node>" (recursive)
//   [5]@Node           → "__dtor_arr5_mp_<Node>" (array)
// Only called for types where NeedsDestruction is true.
func DtorNameForType(t @types.Type) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("__dtor_")
	DtorTypeSuffix(cb, t)
	return buf.CopyStr(cb.String())
}

// QualifiedDtorName handles cross-package struct names (legacy).
func QualifiedDtorName(structName *[]readonly char) @[]char {
	var dotIdx int = -1
	for i := 0; i < len(structName); i++ {
		if structName[i] == '.' {
			dotIdx = i
			break
		}
	}
	if dotIdx < 0 {
		return DtorName(structName)
	}
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(structName[0:dotIdx])
	cb.Write(".__dtor_")
	WriteStructLeafToken(cb, structName[dotIdx + 1:len(structName)])
	return buf.CopyStr(cb.String())
}

// dtorTypeSuffixRec is dtorTypeSuffix's worker.  `nested` is true for a type that
// appears INSIDE a `mp_` / `ms_` / `arr` wrapper (an element-walk suffix), false for
// the top-level type dtorTypeSuffix was invoked on.
//
// A NESTED struct/named type is encoded with `mangle.LpTypeArgNamedRaw` — the
// length-prefixed, IDENTIFIER-ONLY, injective encoding of its FULL qualified name
// (`pkg/binate/ast.File` -> `N3_3_pkg6_binate3_ast4_File`) — rather than the bare
// leaf.  This makes the NESTED element-walk sub-language (the weak_odr
// `__dtor_ms_*` / `__dtor_mp_*` / `__dtor_arr*` helpers, and the `__copy_` twins)
// INJECTIVE among itself, which the bare-leaf encoding was not:
// (A residual NOT closed here — a TOP-LEVEL user struct whose source name literally
// embeds a wrapper encoding, e.g. `struct mp_N1_1_M4_Node` in package M, still
// collides with `@Node`'s mp-helper, because the top-level struct arm below keeps
// the bare leaf.  It is pre-existing in kind and made far harder — the adversary
// must now reproduce the exact `N<segs>_<pkg>_<leaf>` encoding — but closing it
// needs the top-level `dtorName` / `qualifiedDtorNameForType` naming to change too;
// tracked in claude-todo.md.)
//   - The encoding is self-delimiting (segment length prefixes) and begins with `N`
//     followed by a digit, which no kind token (`mp_`, `ms_`, `arr`, `interface`,
//     `func`, primitive names, `anon`) can be — so a struct name can never
//     reconstruct as a kind-token sequence, closing the spoofing class where a struct
//     named e.g. `mp_Node` / `elems_ms_mp_Node` collided with `@Node` / a `@[]@Node`
//     elems helper.
//   - The FULL path (not the leaf) distinguishes same-leaf structs from different
//     packages, so `@[]pkg/a.Config` and `@[]pkg/b.Config` no longer both mangle to
//     `__dtor_ms_Config` — aligning with §16.6 `pkg.identity` (symbol identity is the
//     full import path, not the last segment).
//   - It is identifier-only (no `/` or `.`), so it survives both LLVM's symbol
//     charset AND mangle_lp's own name parsing (which splits on `.` / `/`); embedding
//     the raw qualified name would break clang on the `/`.
// The TOP-LEVEL struct keeps the bare leaf: the top-level bare-struct dtor is named
// via `dtorName(leaf)` / `qualifiedDtorNameForType` (which write the leaf directly,
// NOT through this function), and its package is carried by the `pkg.` qualifier — so
// leaving it unchanged keeps definition and reference in agreement.  Only the nested
// element-walk suffix — where BOTH the def (ensureMsDtor: `dtorNameForType`) and the
// ref (`elemDtorName` / `msElemsDtorName`) route through this function — changes, and
// they change together.
func dtorTypeSuffixRec(cb *strings.Builder, t @types.Type, nested bool) {
	// ResolveAliasAndConst (not ResolveAlias): a `readonly T` element shares
	// `T`'s dtor, so peel the readonly wrapper too — else it falls through to the
	// "unknown" fallback below (e.g. `ms_ms_unknown` instead of `ms_ms_int`).
	t = t.ResolveAliasAndConst()
	// A named distinct type's dtor/copy is its underlying's (identical
	// layout and managed fields), so name it by the underlying —
	// `@[]Celsius` shares `__dtor_ms_int` with `@[]int` rather than
	// emitting `ms_unknown` (which would collide across distinct named
	// scalar element types).
	if t != nil && t.Kind == types.TYP_NAMED && t.Underlying != nil {
		dtorTypeSuffixRec(cb, t.Underlying, nested)
		return
	}
	if t.Kind == types.TYP_STRUCT {
		if len(t.Name) > 0 {
			if nested {
				// Injective, identifier-only full-name encoding (see above).
				cb.Write(mangle.LpTypeArgNamedRaw(t.Name))
			} else {
				// Top-level: the length-prefixed leaf token, matching dtorName /
				// qualifiedDtorNameForType (writeStructLeafToken — closes the top-level
				// residual where a struct source-named like a wrapper helper collided).
				WriteStructLeafToken(cb, DotSuffix(t.Name))
			}
		} else {
			anonStructSuffix(cb, t)
		}
		return
	}
	if t.Kind == types.TYP_MANAGED_PTR {
		cb.Write("mp_")
		dtorTypeSuffixRec(cb, t.Elem, true)
		return
	}
	if t.Kind == types.TYP_MANAGED_SLICE {
		cb.Write("ms_")
		dtorTypeSuffixRec(cb, t.Elem, true)
		return
	}
	if t.Kind == types.TYP_ARRAY {
		cb.Write("arr")
		stringutils.WriteInt(cb, t.ArrayLen)
		cb.WriteByte('_')
		dtorTypeSuffixRec(cb, t.Elem, true)
		return
	}
	// A managed interface value (@Iface) and a managed func value (@func)
	// each get ONE suffix — NOT a per-interface or per-signature one.  Their
	// element dtor/copy bodies (in genManagedSliceDtor / the copy generator)
	// are type-INDEPENDENT: an @Iface element RefDec's via the dtor fetched
	// from its own runtime vtable, an @func element via emitManagedFuncValueRefDec;
	// so a single `__dtor_ms_<tok>` (and `__copy_`) body is correct for every
	// interface / signature.  The tokens must be injective against EVERY other
	// kind — including user struct names, which the TYP_STRUCT arm above emits
	// verbatim.  Use the reserved keywords `interface` / `func`: a struct can
	// never be named a keyword, so `@[]@I` and `@[]structNamed_interface` can't
	// collide (a bare `iv` / `fv` WOULD — they are legal identifiers — producing
	// one `__dtor_ms_iv` body for two structurally-different slices, the leak /
	// SIGSEGV the adversarial review found).  No other kind maps to these tokens
	// (a non-managed *func / bare interface is not destructible, so never reaches
	// here).
	if t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		cb.Write("interface")
		return
	}
	if t.Kind == types.TYP_MANAGED_FUNC_VALUE {
		cb.Write("func")
		return
	}
	// Primitive types (used in managed-slice naming, e.g., @[]@[]char → ms_ms_uint8)
	if t.Kind == types.TYP_INT {
		cb.Write(t.Name)
		return
	}
	if t.Kind == types.TYP_BOOL {
		cb.Write("bool")
		return
	}
	cb.Write("unknown")
}

// HasName returns true if the name exists in the given list.
func HasName(names @[]@[]char, name *[]readonly char) bool {
	for i := 0; i < len(names); i++ {
		if Streq(names[i], name) { return true }
	}
	return false
}

// anonStructSuffix builds a dtor name suffix for an anonymous struct
// from its field type sequence. E.g., struct{X int; P @Node} → "anon_int_mp_Node".
// If the result would exceed 128 characters, uses a hash instead.
func anonStructSuffix(cb *strings.Builder, t @types.Type) {
	// Injective, self-delimiting: `anon<fieldcount>` then, per field, `_<bytelen>_`
	// + the field's (nested) encoding.  Length-prefixing each field removes the
	// ambiguity a bare `_` separator had — a field encoding may itself contain `_`
	// (e.g. `mp_N0_4_Node`) — and replaces the old >128-char FNV-32 `anon_h<hex>`
	// hash fallback, which was non-injective by construction (two distinct large anon
	// structs could share a 32-bit hash → one dtor/copy body for both).  There is no
	// length cap now; a very large anon struct just gets a long (valid, backend
	// length-prefixed) symbol.
	cb.Write("anon")
	stringutils.WriteInt(cb, len(t.Fields))
	for i := 0; i < len(t.Fields); i++ {
		var fb @strings.Builder = strings.NewBuilder()
		dtorTypeSuffixRec(fb, t.Fields[i].Type, true)
		var fs @[]char = buf.CopyStr(fb.String())
		cb.WriteByte('_')
		stringutils.WriteInt(cb, len(fs))
		cb.WriteByte('_')
		cb.Write(fs)
	}
}

// DotSuffix returns the substring after the first dot (e.g., "ast.File" -> "File").
func DotSuffix(s *[]readonly char) *[]readonly char {
	for i := 0; i < len(s); i++ {
		if s[i] == '.' { return s[i + 1:len(s)] }
	}
	return s
}

// IsAnonStructName reports whether a struct type's name is a compiler-synthesized
// anonymous-struct name (`__anon_<N>`) rather than a user-written nominal name.
func IsAnonStructName(name *[]readonly char) bool {
	var pfx *[]readonly char = "__anon_"
	if len(name) < len(pfx) { return false }
	for i := 0; i < len(pfx); i++ {
		if name[i] != pfx[i] { return false }
	}
	return true
}
