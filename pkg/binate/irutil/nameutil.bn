package "pkg/binate/irutil"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// mangleParamTypes / mangleResultTypes render a signature's parameter and
// result types as the pre-encoded TypeArg list a func-type Sig consumes.
func mangleParamTypes(params @[]@types.Param) @[]@[]char {
	var out @[]@[]char
	for i := 0; i < len(params); i++ {
		out = slices.Append[@[]char](out, MangleTypeArg(params[i].Type))
	}
	return out
}

// mangleResultTypes renders a signature's result types as a TypeArg list.
func mangleResultTypes(results @[]@types.Type) @[]@[]char {
	var out @[]@[]char
	for i := 0; i < len(results); i++ {
		out = slices.Append[@[]char](out, MangleTypeArg(results[i]))
	}
	return out
}

// structArgFieldNames / structArgFieldTypeArgs render an anonymous struct's fields
// as the parallel (name, encoded-type) lists LpTypeArgStruct consumes — field NAMES
// are part of an anon struct's identity (`struct{x int}` ≠ `struct{y int}`), so both
// ride the token.  Field types recurse through mangleTypeArg (structural all the way
// down; a nested anon-struct field recurses this same arm).
func structArgFieldNames(t @types.Type) @[]@[]char {
	var out @[]@[]char
	for i := 0; i < len(t.Fields); i++ {
		out = slices.Append[@[]char](out, t.Fields[i].Name)
	}
	return out
}

// structArgFieldTypeArgs renders each field's TYPE as a TypeArg (see
// structArgFieldNames).
func structArgFieldTypeArgs(t @types.Type) @[]@[]char {
	var out @[]@[]char
	for i := 0; i < len(t.Fields); i++ {
		out = slices.Append[@[]char](out, MangleTypeArg(t.Fields[i].Type))
	}
	return out
}

// MsElemsDtorName names the scalar-arg managed-slice element-cleanup helper
// `__dtor_ms_elems_<T>(backingPtr *uint8, backingLen int)` for a managed slice
// type @[]@E: the refcount==1-guarded element-RefDec loop + backing RefDec, given
// the backing pointer and its length directly (no 4-word slice image).  The
// by-address `__dtor_<T>` delegates to it, and the -O1+ inline cleanup calls it
// with `extract(sliceVal, 2)` / `extract(sliceVal, 3)` — extract-only, so the
// slice stays SROA-forwardable.  The `__dtor_ms_elems_` prefix distinguishes it
// from the PAIRED by-address `__dtor_<T>` of the same type.  The `dtorTypeSuffix`
// this shares length-prefixes nested struct names, so a struct adversarially named
// to spoof the kind tokens (e.g. `struct elems_ms_mp_Node`) does not collide —
// its nested encoding is digit-initial (`<len>…`) and can't reconstruct a
// letter-initial kind-token sequence.
func MsElemsDtorName(t @types.Type) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("__dtor_ms_elems_")
	DtorTypeSuffix(cb, t)
	return buf.CopyStr(cb.String())
}

// DtorNameForType returns the dtor function name for a given type.  A top-level
// struct is named by its length-prefixed leaf; a NESTED struct/named type is encoded
// with mangle.LpTypeArgNamedRaw (an injective, identifier-only full-name encoding, e.g.
// `pkg/foo.Node` -> `N2_3_pkg3_foo4_Node`) so the element-walk suffix is injective —
// see writeDtorTypeSuffix.  Shape (writing `<Node>` for that nested encoding):
//   struct Node        → "__dtor_4Node"          (top-level struct: length-prefixed leaf)
//   @Node              → "__dtor_mp_<Node>"      (managed pointer; Node nested)
//   @[]@Node           → "__dtor_ms_mp_<Node>"   (managed-slice of managed ptr)
//   @[]@[]@Node        → "__dtor_ms_ms_mp_<Node>" (recursive)
//   [5]@Node           → "__dtor_arr5_mp_<Node>" (array)
// Only called for types where NeedsDestruction is true.
func DtorNameForType(t @types.Type) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("__dtor_")
	DtorTypeSuffix(cb, t)
	return buf.CopyStr(cb.String())
}

// QualifiedDtorName handles cross-package struct names (legacy).
func QualifiedDtorName(structName *[]readonly char) @[]char {
	var dotIdx int = -1
	for i := 0; i < len(structName); i++ {
		if structName[i] == '.' {
			dotIdx = i
			break
		}
	}
	if dotIdx < 0 {
		return DtorName(structName)
	}
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(structName[0:dotIdx])
	cb.Write(".__dtor_")
	WriteStructLeafToken(cb, structName[dotIdx + 1:len(structName)])
	return buf.CopyStr(cb.String())
}

// HasName returns true if the name exists in the given list.
func HasName(names @[]@[]char, name *[]readonly char) bool {
	for i := 0; i < len(names); i++ {
		if Streq(names[i], name) { return true }
	}
	return false
}

// DotSuffix returns the substring after the first dot (e.g., "ast.File" -> "File").
func DotSuffix(s *[]readonly char) *[]readonly char {
	for i := 0; i < len(s); i++ {
		if s[i] == '.' { return s[i + 1:len(s)] }
	}
	return s
}

// IsAnonStructName reports whether a struct type's name is a compiler-synthesized
// anonymous-struct name (`__anon_<N>`) rather than a user-written nominal name.
func IsAnonStructName(name *[]readonly char) bool {
	return hasPrefix(name, "__anon_")
}

// hasPrefix reports whether name starts with pfx.
func hasPrefix(name *[]readonly char, pfx *[]readonly char) bool {
	if len(name) < len(pfx) { return false }
	for i := 0; i < len(pfx); i++ {
		if name[i] != pfx[i] { return false }
	}
	return true
}

// ReadonlyVariantName is the receiver name of the readonly variant of the named
// type `name` — the dynamic type of a box of a readonly object of it (a box
// records its object's readonly).  The variant is a receiver identity of its own in
// the type's package — its own TypeInfo record and ImplInfo rows (vtables,
// satisfaction entries) — carrying the type's layout, methods and destructor.  The
// `__readonly_` prefix keeps it apart from every user type: a `__`-prefixed name
// is reserved for the compiler.
func ReadonlyVariantName(name *[]readonly char) @[]char {
	return buf.Concat(readonlyVariantPrefix(), name)
}

// readonlyVariantPrefix is the prefix ReadonlyVariantName puts on a type's name.
func readonlyVariantPrefix() *[]readonly char {
	return "__readonly_"
}

// IsReadonlyVariantName reports whether a receiver name is a readonly variant's
// (ReadonlyVariantName).
func IsReadonlyVariantName(name *[]readonly char) bool {
	return hasPrefix(name, readonlyVariantPrefix())
}

// RawVariantName is the receiver name of the raw-origin variant of the named type
// `name` — the identity a box made from a raw pointer carries (a box records its
// origin).  Like a readonly variant it is a receiver identity of its own in the
// type's package, with the type's layout, methods and destructor; its rows come
// only from the impls a raw pointer can supply, so an assertion on such a box
// never reaches an impl whose receiver is managed.  A box of a readonly object
// made from a raw pointer has the readonly variant of this one
// (ReadonlyVariantName(RawVariantName(name))).
func RawVariantName(name *[]readonly char) @[]char {
	return buf.Concat(rawVariantPrefix(), name)
}

// rawVariantPrefix is the prefix RawVariantName puts on a type's name.
func rawVariantPrefix() *[]readonly char {
	return "__raw_"
}

// IsRawVariantName reports whether a receiver name is a raw-origin variant's
// (RawVariantName), readonly or not.
func IsRawVariantName(name *[]readonly char) bool {
	var n *[]readonly char = name
	if IsReadonlyVariantName(n) { n = n[len(readonlyVariantPrefix()):len(n)] }
	return hasPrefix(n, rawVariantPrefix())
}

// VariantBase is the named type a variant's receiver name stands for — a
// readonly, raw-origin or readonly raw-origin variant's — (`name` itself when it
// is not a variant's).
func VariantBase(name *[]readonly char) *[]readonly char {
	var n *[]readonly char = name
	if IsReadonlyVariantName(n) { n = n[len(readonlyVariantPrefix()):len(n)] }
	if hasPrefix(n, rawVariantPrefix()) { n = n[len(rawVariantPrefix()):len(n)] }
	return n
}

// DynamicTypeName is the receiver name of the dynamic type of a box carrying the
// receiver identity `name`.  A raw-origin variant (RawVariantName) records only how
// the box was made, so its box has the type itself — the readonly variant of it
// when the variant is a readonly one; any other name (a type's own, a readonly
// variant's) is its box's dynamic type.
func DynamicTypeName(name *[]readonly char) @[]char {
	if IsReadonlyVariantName(name) {
		var rest *[]readonly char = name[len(readonlyVariantPrefix()):len(name)]
		if hasPrefix(rest, rawVariantPrefix()) {
			return ReadonlyVariantName(rest[len(rawVariantPrefix()):len(rest)])
		}
		return buf.CopyStr(name)
	}
	if hasPrefix(name, rawVariantPrefix()) {
		return buf.CopyStr(name[len(rawVariantPrefix()):len(name)])
	}
	return buf.CopyStr(name)
}
