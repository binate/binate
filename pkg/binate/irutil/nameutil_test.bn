package "pkg/binate/irutil"

import "pkg/builtins/testing"

// A readonly variant name round-trips to its base, and a base name is its own base.
func TestReadonlyVariantName() testing.TestResult {
	var ro @[]char = ReadonlyVariantName("T")
	if !IsReadonlyVariantName(ro) {
		return "a variant name should be recognized as one"
	}
	if IsReadonlyVariantName("T") || IsReadonlyVariantName("__nameless_x") {
		return "a base or other reserved name is not a variant name"
	}
	if !CharEq(VariantBase(ro), "T") {
		return "a variant's base should be T"
	}
	if !CharEq(VariantBase("T"), "T") {
		return "a base name should be its own base"
	}
	return ""
}

// A raw-origin variant name, and the readonly variant of one, are recognized as
// raw-origin variants and stand for their base; no other name is one.
func TestRawVariantName() testing.TestResult {
	var raw @[]char = RawVariantName("T")
	var roRaw @[]char = ReadonlyVariantName(raw)
	if !IsRawVariantName(raw) || IsReadonlyVariantName(raw) {
		return "a raw-origin variant name should be one, and not a readonly one"
	}
	if !IsRawVariantName(roRaw) || !IsReadonlyVariantName(roRaw) {
		return "the readonly variant of a raw-origin one should be both"
	}
	if IsRawVariantName("T") || IsRawVariantName(ReadonlyVariantName("T")) ||
			IsRawVariantName("__rawslice_backing_x") {
		return "a base, a readonly variant or another reserved name is not a raw-origin variant name"
	}
	if !CharEq(VariantBase(raw), "T") || !CharEq(VariantBase(roRaw), "T") {
		return "a raw-origin variant, readonly or not, should stand for T"
	}
	return ""
}

// A box carrying a raw-origin variant has the type itself (readonly when the
// variant is) as its dynamic type; a type's own name and a readonly variant's
// are their boxes' dynamic types.
func TestDynamicTypeName() testing.TestResult {
	var ro @[]char = ReadonlyVariantName("T")
	var roRaw @[]char = ReadonlyVariantName(RawVariantName("T"))
	if !CharEq(DynamicTypeName(RawVariantName("T")), "T") {
		return "a raw-origin box of T should have dynamic type T"
	}
	if !CharEq(DynamicTypeName(roRaw), ro) {
		return "a readonly raw-origin box of T should have dynamic type readonly T"
	}
	if !CharEq(DynamicTypeName("T"), "T") || !CharEq(DynamicTypeName(ro), ro) {
		return "a type's own name and a readonly variant's should be their own"
	}
	return ""
}
