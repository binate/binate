// Package lexer tokenizes Binate source code into a stream of tokens with
// automatic semicolon insertion (ASI).
package "pkg/binate/lexer"

import "pkg/binate/token"
import "pkg/std/vec"

// Lexer tokenizes Binate source code with automatic semicolon insertion.
type Lexer struct {
	src  @[]uint8
	file @[]char

	pos     int
	readPos int
	ch      uint8

	line   int
	lineAt int

	lastTok           token.Type
	hasPending        bool
	pendingTok        token.Token
	pendingSawNewline bool

	// Comment collection (off unless created via NewCollecting).  comments
	// holds every // and /* */ comment scanned, in source order, and ncomments
	// how many of them the scan has reached: a Restore takes ncomments back with
	// the rest of the state, and the re-read scans the same comments into the
	// same places, so a state saved further on, restored after it, finds its
	// comments there.  lastTokenLine and lastTokenCol are the position of the
	// most recent real (non-synthetic) token (line 0 before the first), which
	// classifies a comment as own-line (leading) vs trailing and is its After.
	// They are kept apart from a token.Pos, whose File a copy would count on
	// every token the compiler scans.
	keepComments  bool
	comments      @vec.Vec[@token.Comment]
	ncomments     int
	lastTokenLine int
	lastTokenCol  int

	// Bracket pairing (comment-collecting mode only).  brackets holds a record of
	// each pair (token.Bracket) in the order of their openers, and bracketUp the
	// index of the pair around each (-1 for none); nbrackets is how many of them
	// the scan has reached and openBracket the index of the innermost pair whose
	// closer it has not reached (-1 for none).  A Restore takes nbrackets and
	// openBracket back, as it does ncomments.
	brackets    @vec.Vec[token.Bracket]
	bracketUp   @vec.Vec[int]
	nbrackets   int
	openBracket int
}

// New creates a new Lexer for the given source and filename.  Comments are
// discarded (the compiler path).
func New(src *[]uint8, file *[]readonly char) @Lexer

// NewCollecting creates a Lexer that retains comments (token.Comment), for
// tooling that needs them (a formatter / doc generator).  Otherwise identical
// to New.
func NewCollecting(src *[]uint8, file *[]readonly char) @Lexer

// Comments returns the comments collected so far -- empty unless the lexer was
// created via NewCollecting.  Meaningful once the source is fully tokenized.
func (l @Lexer) Comments() @[]@token.Comment

// Brackets returns the bracket pairs (token.Bracket) scanned so far, in the order of
// their openers -- empty unless the lexer was created via NewCollecting.
// Meaningful once the source is fully tokenized.
func (l @Lexer) Brackets() @[]token.Bracket

// Next returns the next token, with automatic semicolon insertion.
func (l @Lexer) Next() token.Token

// Save returns a copy of the lexer's scanning state, for a parser that reads a
// token range one way and may need to rewind (Restore) and read it another.
func (l @Lexer) Save() Lexer

// Restore rewinds the lexer to a state returned by Save.  Comments collected
// since that Save are dropped with the rest of the state, so the re-read tokens'
// comments are not collected twice.
func (l @Lexer) Restore(s Lexer)
