package "pkg/binate/lexer"

import "pkg/binate/token"

// recordBracket records a bracket token tok in the pairs of brackets (Brackets):
// an opener starts a pair inside the innermost open one, and a closer closes that
// one.  A closer with no open pair, which only source that does not parse has, is
// left out.  A re-read after a Restore scans the same brackets in the same order,
// so it finds each pair's record in place -- with its closer's position already set
// when an earlier read went that far -- and keeps it: a parser that rewinds, reads
// a shorter way that stops before a closer, then goes forward to a state past it
// (Restore of a later Save) never scans that closer again.  Called only in
// comment-collecting mode.
func (l @Lexer) recordBracket(tok token.Token) {
	var t token.Type = tok.Typ
	if t == token.LPAREN || t == token.LBRACKET || t == token.LBRACE {
		if l.nbrackets == l.brackets.Len() {
			var r token.Bracket
			r.Open = tok.Pos
			l.brackets.Push(r)
			l.bracketUp.Push(l.openBracket)
		}
		l.openBracket = l.nbrackets
		l.nbrackets = l.nbrackets + 1
		return
	}
	if (t == token.RPAREN || t == token.RBRACKET || t == token.RBRACE) && l.openBracket >= 0 {
		var r token.Bracket = l.brackets.Get(l.openBracket)
		r.Close = tok.Pos
		l.brackets.Set(l.openBracket, r)
		l.openBracket = l.bracketUp.Get(l.openBracket)
	}
}

// Brackets returns the bracket pairs scanned so far, in the order of their
// openers.
func (l @Lexer) Brackets() @[]token.Bracket {
	var bs @[]token.Bracket = make_slice(token.Bracket, l.nbrackets)
	for i := 0; i < l.nbrackets; i++ {
		bs[i] = l.brackets.Get(i)
	}
	return bs
}
