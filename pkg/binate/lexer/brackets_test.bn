package "pkg/binate/lexer"

import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// scanAll reads l to its end.
func scanAll(l @Lexer) {
	for {
		var tok token.Token = l.Next()
		if tok.Typ == token.EOF { break }
	}
}

// checkPairs checks bs against want, the opener's and closer's columns of each pair
// in turn (all on line 1).
func checkPairs(bs @[]token.Bracket, want @[]int) testing.TestResult {
	var ok bool = 2 * len(bs) == len(want)
	for i := 0; ok && i < len(bs); i++ {
		ok = bs[i].Open.Line == 1 && bs[i].Open.Col == want[2 * i] && bs[i].Close.Line == 1 &&
				bs[i].Close.Col == want[2 * i + 1]
	}
	if ok { return "" }
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("pairs:")
	for i := 0; i < len(bs); i++ {
		sb.WriteByte(' ')
		sb.Write(strconv.Itoa(bs[i].Open.Col))
		sb.WriteByte('-')
		sb.Write(strconv.Itoa(bs[i].Close.Col))
	}
	return buf.CopyStr(sb.String())
}

// A comment-collecting lexer pairs each opener with its closer, nested pairs
// inside the pair around them, in the order of the openers.
func TestBracketsPairOpenersWithClosers() testing.TestResult {
	// f(a[1], T{b}) {} -- `(` 2, `[` 4, `]` 6, `{` 10, `}` 12, `)` 13, `{` 15, `}` 16.
	var l @Lexer = NewCollecting(toBytes("f(a[1], T{b}) {}"), "t.bn")
	scanAll(l)
	var want @[]int = make_slice(int, 8)
	want[0] = 2
	want[1] = 13
	want[2] = 4
	want[3] = 6
	want[4] = 10
	want[5] = 12
	want[6] = 15
	want[7] = 16
	return checkPairs(l.Brackets(), want)
}

// The default New lexer records no brackets (compiler path unaffected).
func TestBracketsOffByDefault() testing.TestResult {
	var l @Lexer = New(toBytes("f(a[1])"), "t.bn")
	scanAll(l)
	if len(l.Brackets()) != 0 { return "New should record no brackets" }
	return ""
}

// A pair keeps its closer through a Restore: the parser reads `(b)` as an
// expression (past its `)`), rewinds to try a reading that stops before the `)`,
// and goes forward to the expression's end, so the `)` is not scanned again.  A
// re-read records no pair twice.
func TestBracketsKeepTheirCloserThroughRestore() testing.TestResult {
	// a(b)c -- `(` 2, `)` 4.
	var l @Lexer = NewCollecting(toBytes("a(b)c"), "t.bn")
	_ = l.Next()
	var start Lexer = l.Save()
	for i := 0; i < 4; i++ { _ = l.Next() }
	var afterExpr Lexer = l.Save()
	l.Restore(start)
	_ = l.Next()
	_ = l.Next()
	l.Restore(afterExpr)
	scanAll(l)
	var want @[]int = make_slice(int, 2)
	want[0] = 2
	want[1] = 4
	var r testing.TestResult = checkPairs(l.Brackets(), want)
	if len(r) > 0 { return r }
	l.Restore(start)
	scanAll(l)
	return checkPairs(l.Brackets(), want)
}
