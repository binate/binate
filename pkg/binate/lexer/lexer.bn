package "pkg/binate/lexer"

import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"

// New creates a new Lexer for the given source and filename.  Comments are
// discarded (the compiler path).
func New(src *[]uint8, file *[]readonly char) @Lexer {
	return newLexer(src, file, false)
}

// NewCollecting creates a Lexer that retains comments (token.Comment), for
// tooling that needs them (a formatter / doc generator).
func NewCollecting(src *[]uint8, file *[]readonly char) @Lexer {
	return newLexer(src, file, true)
}

// newLexer is the shared constructor; keep enables comment collection.
func newLexer(src *[]uint8, file *[]readonly char, keep bool) @Lexer {
	var l @Lexer = make(Lexer)
	// Copy into managed slices so the lexer owns the data
	var msrc @[]uint8 = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ { msrc[i] = src[i] }
	l.src = msrc
	l.file = buf.CopyStr(file)
	l.line = 1
	l.lineAt = 0
	l.hasPending = false
	l.keepComments = keep
	l.lastTokenLine = 0
	l.advance()
	return l
}

// Comments returns the comments collected so far (empty unless created via
// NewCollecting).
func (l @Lexer) Comments() @[]@token.Comment {
	return l.comments
}

// advance reads the next byte into l.ch.
func (l @Lexer) advance() {
	if l.readPos >= len(l.src) {
		l.ch = '\0'
	} else {
		l.ch = l.src[l.readPos]
	}
	l.pos = l.readPos
	l.readPos = l.readPos + 1
}

// peek returns the next byte without advancing, or 0 at EOF.
func (l @Lexer) peek() uint8 {
	if l.readPos >= len(l.src) {
		return '\0'
	}
	return l.src[l.readPos]
}

// col returns the current 1-based column number.
func (l @Lexer) col() int {
	return l.pos - l.lineAt + 1
}

// curPos returns the current source position.
func (l @Lexer) curPos() token.Pos {
	var p token.Pos
	p.File = l.file
	p.Line = l.line
	p.Col = l.col()
	return p
}

// newline handles a newline character, updating line tracking.
func (l @Lexer) newline() {
	l.line = l.line + 1
	l.lineAt = l.readPos
}

// sliceToChars copies src[start:end] into a fresh owned char slice (uint8 and
// char are the same byte, so the sub-slice copies verbatim).
func sliceToChars(src *[]uint8, start int, end int) @[]char {
	return buf.CopyStr(src[start:end])
}

// Next returns the next token. It handles automatic semicolon insertion.
func (l @Lexer) Next() token.Token {
	// If we have a pending real token (deferred by ASI), emit it now.
	if l.hasPending {
		var tok token.Token
		tok = l.pendingTok
		l.hasPending = false
		l.lastTok = tok.Typ
		return tok
	}

	var sawNL bool
	var tok token.Token
	sawNL = false
	tok = l.scan(&sawNL)

	// ASI: if we crossed a newline boundary and the last token triggers ASI,
	// insert a semicolon before this token.
	if tok.Typ != token.EOF && token.TriggersASI(l.lastTok) && sawNL {
		l.hasPending = true
		l.pendingTok = tok
		l.pendingSawNewline = sawNL
		var semi token.Token
		semi.Typ = token.SEMICOLON
		semi.Lit = "\n"
		semi.Pos = tok.Pos
		semi.End = tok.Pos
		return semi
	}

	// At EOF, insert a final semicolon if the last token triggers ASI.  The
	// synthetic terminator is a zero-width token at the EOF position (past the
	// last real token, possibly on a later line); consumers that care about
	// placement drop synthetic semicolons rather than positioning them.
	if tok.Typ == token.EOF && token.TriggersASI(l.lastTok) {
		l.lastTok = token.SEMICOLON
		var semi token.Token
		semi.Typ = token.SEMICOLON
		semi.Lit = "\n"
		semi.Pos = tok.Pos
		semi.End = tok.Pos
		return semi
	}

	if tok.Typ != token.SEMICOLON {
		l.lastTok = tok.Typ
	}
	return tok
}

// scan reads the next raw token and records its end position.  scanRaw does the
// token recognition and leaves the cursor one past the token's last byte, so
// curPos() there is the token's exclusive end (§ token.Token.End).
func (l @Lexer) scan(sawNewline *bool) token.Token {
	var tok token.Token = l.scanRaw(sawNewline)
	tok.End = l.curPos()
	// Record the line of this real token so a later comment on the same line is
	// classified as trailing (not own-line).  scanRaw already skipped and
	// recorded any comments preceding this token, using the PREVIOUS value.
	if tok.Typ != token.EOF {
		l.lastTokenLine = tok.Pos.Line
	}
	return tok
}

// scanRaw reads the next raw token (no ASI logic, no end position).
// Sets *sawNewline to true if whitespace/comments contained a newline.
func (l @Lexer) scanRaw(sawNewline *bool) token.Token {
	*sawNewline = l.skipWhitespace()

	var pos token.Pos = l.curPos()
	var tok token.Token
	tok.Pos = pos

	var ch uint8 = l.ch

	if ch == '\0' {
		tok.Typ = token.EOF
		tok.Lit = ""
		return tok
	}

	if isLetter(ch) {
		var lit @[]char = l.scanIdentifier()
		tok.Typ = token.Lookup(lit)
		tok.Lit = lit
		return tok
	}

	if isDigit(ch) {
		var typ token.Type
		var lit @[]char
		typ = token.ILLEGAL
		lit = l.scanNumber(&typ)
		tok.Typ = typ
		tok.Lit = lit
		return tok
	}

	if ch == '"' {
		tok.Typ = token.STRING
		tok.Lit = l.scanString()
		return tok
	}

	if ch == '\'' {
		tok.Typ = token.CHAR
		tok.Lit = l.scanChar()
		return tok
	}

	// Operators and punctuation — advance past the first char
	l.advance()

	if ch == '+' {
		if l.ch == '=' {
			l.advance()
			tok.Typ = token.ADD_ASSIGN
			tok.Lit = "+="
			return tok
		}
		if l.ch == '+' {
			l.advance()
			tok.Typ = token.INC
			tok.Lit = "++"
			return tok
		}
		tok.Typ = token.PLUS
		tok.Lit = "+"
		return tok
	}

	if ch == '-' {
		if l.ch == '=' {
			l.advance()
			tok.Typ = token.SUB_ASSIGN
			tok.Lit = "-="
			return tok
		}
		if l.ch == '-' {
			l.advance()
			tok.Typ = token.DEC
			tok.Lit = "--"
			return tok
		}
		tok.Typ = token.MINUS
		tok.Lit = "-"
		return tok
	}

	if ch == '*' {
		if l.ch == '=' {
			l.advance()
			tok.Typ = token.MUL_ASSIGN
			tok.Lit = "*="
			return tok
		}
		tok.Typ = token.STAR
		tok.Lit = "*"
		return tok
	}

	if ch == '/' {
		if l.ch == '=' {
			l.advance()
			tok.Typ = token.QUO_ASSIGN
			tok.Lit = "/="
			return tok
		}
		tok.Typ = token.SLASH
		tok.Lit = "/"
		return tok
	}

	if ch == '%' {
		if l.ch == '=' {
			l.advance()
			tok.Typ = token.REM_ASSIGN
			tok.Lit = "%="
			return tok
		}
		tok.Typ = token.PERCENT
		tok.Lit = "%"
		return tok
	}

	if ch == '&' {
		if l.ch == '&' {
			l.advance()
			tok.Typ = token.LAND
			tok.Lit = "&&"
			return tok
		}
		if l.ch == '=' {
			l.advance()
			tok.Typ = token.AND_ASSIGN
			tok.Lit = "&="
			return tok
		}
		tok.Typ = token.AMP
		tok.Lit = "&"
		return tok
	}

	if ch == '|' {
		if l.ch == '|' {
			l.advance()
			tok.Typ = token.LOR
			tok.Lit = "||"
			return tok
		}
		if l.ch == '=' {
			l.advance()
			tok.Typ = token.OR_ASSIGN
			tok.Lit = "|="
			return tok
		}
		tok.Typ = token.PIPE
		tok.Lit = "|"
		return tok
	}

	if ch == '^' {
		if l.ch == '=' {
			l.advance()
			tok.Typ = token.XOR_ASSIGN
			tok.Lit = "^="
			return tok
		}
		tok.Typ = token.CARET
		tok.Lit = "^"
		return tok
	}

	if ch == '~' {
		tok.Typ = token.TILDE
		tok.Lit = "~"
		return tok
	}

	if ch == '<' {
		if l.ch == '<' {
			l.advance()
			if l.ch == '=' {
				l.advance()
				tok.Typ = token.SHL_ASSIGN
				tok.Lit = "<<="
				return tok
			}
			tok.Typ = token.SHL
			tok.Lit = "<<"
			return tok
		}
		if l.ch == '=' {
			l.advance()
			tok.Typ = token.LEQ
			tok.Lit = "<="
			return tok
		}
		tok.Typ = token.LT
		tok.Lit = "<"
		return tok
	}

	if ch == '>' {
		if l.ch == '>' {
			l.advance()
			if l.ch == '=' {
				l.advance()
				tok.Typ = token.SHR_ASSIGN
				tok.Lit = ">>="
				return tok
			}
			tok.Typ = token.SHR
			tok.Lit = ">>"
			return tok
		}
		if l.ch == '=' {
			l.advance()
			tok.Typ = token.GEQ
			tok.Lit = ">="
			return tok
		}
		tok.Typ = token.GT
		tok.Lit = ">"
		return tok
	}

	if ch == '=' {
		if l.ch == '=' {
			l.advance()
			tok.Typ = token.EQ
			tok.Lit = "=="
			return tok
		}
		tok.Typ = token.ASSIGN
		tok.Lit = "="
		return tok
	}

	if ch == '!' {
		if l.ch == '=' {
			l.advance()
			tok.Typ = token.NEQ
			tok.Lit = "!="
			return tok
		}
		tok.Typ = token.NOT
		tok.Lit = "!"
		return tok
	}

	if ch == ':' {
		if l.ch == '=' {
			l.advance()
			tok.Typ = token.DEFINE
			tok.Lit = ":="
			return tok
		}
		tok.Typ = token.COLON
		tok.Lit = ":"
		return tok
	}

	if ch == '.' {
		if l.ch == '.' && l.peek() == '.' {
			l.advance()
			l.advance()
			tok.Typ = token.ELLIPSIS
			tok.Lit = "..."
			return tok
		}
		// `.5` is a float literal — `.` followed by digits, optional
		// exponent. The leading `.` is already consumed; l.pos now
		// points at the digit. But don't treat the second `.` in
		// `1..2` as a float: if the previous token was a DOT, the
		// current `.` is a stand-alone DOT.
		if isDigit(l.ch) && l.lastTok != token.DOT {
			var start int = l.pos - 1
			for isDigit(l.ch) {
				l.advance()
			}
			if l.ch == 'e' || l.ch == 'E' {
				l.advance()
				if l.ch == '+' || l.ch == '-' {
					l.advance()
				}
				if !isDigit(l.ch) {
					tok.Typ = token.ILLEGAL
					tok.Lit = sliceToChars(l.src, start, l.pos)
					return tok
				}
				for isDigit(l.ch) {
					l.advance()
				}
			}
			tok.Typ = token.FLOAT
			tok.Lit = sliceToChars(l.src, start, l.pos)
			return tok
		}
		tok.Typ = token.DOT
		tok.Lit = "."
		return tok
	}

	if ch == ',' {
		tok.Typ = token.COMMA
		tok.Lit = ","
		return tok
	}

	if ch == ';' {
		tok.Typ = token.SEMICOLON
		tok.Lit = ";"
		return tok
	}

	if ch == '@' {
		tok.Typ = token.AT
		tok.Lit = "@"
		return tok
	}

	if ch == '#' {
		tok.Typ = token.HASH
		tok.Lit = "#"
		return tok
	}

	if ch == '(' {
		tok.Typ = token.LPAREN
		tok.Lit = "("
		return tok
	}

	if ch == ')' {
		tok.Typ = token.RPAREN
		tok.Lit = ")"
		return tok
	}

	if ch == '[' {
		tok.Typ = token.LBRACKET
		tok.Lit = "["
		return tok
	}

	if ch == ']' {
		tok.Typ = token.RBRACKET
		tok.Lit = "]"
		return tok
	}

	if ch == '{' {
		tok.Typ = token.LBRACE
		tok.Lit = "{"
		return tok
	}

	if ch == '}' {
		tok.Typ = token.RBRACE
		tok.Lit = "}"
		return tok
	}

	// Unknown character
	tok.Typ = token.ILLEGAL
	var cb @strings.Builder = strings.NewBuilder()
	cb.WriteByte(cast(char, ch))
	tok.Lit = buf.CopyStr(cb.String())
	return tok
}
