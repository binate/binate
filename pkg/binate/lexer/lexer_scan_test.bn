package "pkg/binate/lexer"

import "pkg/binate/token"
import "pkg/builtins/testing"

// Tests for the token scanner (scan / scanRaw) in lexer_scan.bn — identifiers,
// keywords, operators, punctuation.  Shared lex helpers live in lexer_test.bn.

func TestIdentifiersAndKeywords() testing.TestResult {
	var l @Lexer = New(toBytes("foo bar break const func if return struct type var Self"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.IDENT, "foo", 0)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "bar", 1)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.BREAK, "break", 2)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.CONST, "const", 3)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.FUNC, "func", 4)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IF, "if", 5)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.RETURN, "return", 6)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.STRUCT, "struct", 7)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.TYPE, "type", 8)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.VAR, "var", 9)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SELF, "Self", 10)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 11)
	if len(r) > 0 { return r }
	return ""
}

func TestBuiltinKeywords() testing.TestResult {
	var l @Lexer = New(toBytes("make box cast bit_cast len sizeof alignof _func_handle"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.MAKE, "make", 0)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.BOX, "box", 1)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.CAST, "cast", 2)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.BIT_CAST, "bit_cast", 3)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LEN, "len", 4)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SIZEOF, "sizeof", 5)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.ALIGNOF, "alignof", 6)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.RAW_FUNC_ADDR, "_func_handle", 7)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 8)
	if len(r) > 0 { return r }
	return ""
}

// TestRawFuncAddrAlias verifies the transitional `_raw_func_addr`
// spelling still lexes to the same token as the canonical
// `_func_handle`.  Phase 4 of plan-uniform-native-fnptrs.md.  Drop
// this test alongside the alias when callers stop using
// `_raw_func_addr`.
func TestRawFuncAddrAlias() testing.TestResult {
	var l @Lexer = New(toBytes("_raw_func_addr"), "")
	return checkTok(l.Next(), token.RAW_FUNC_ADDR, "_raw_func_addr", 0)
}

func TestOperators() testing.TestResult {
	var l @Lexer = New(
			toBytes(
					"+ - * / % & | ^ ~ << >> "
							"== != < > <= >= && || ! "
							"= := += -= *= /= %= "
							"&= |= ^= <<= >>= ++ --"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.PLUS, "+", 0)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.MINUS, "-", 1)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.STAR, "*", 2)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SLASH, "/", 3)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.PERCENT, "%", 4)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.AMP, "&", 5)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.PIPE, "|", 6)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.CARET, "^", 7)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.TILDE, "~", 8)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SHL, "<<", 9)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SHR, ">>", 10)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EQ, "==", 11)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.NEQ, "!=", 12)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LT, "<", 13)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.GT, ">", 14)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LEQ, "<=", 15)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.GEQ, ">=", 16)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LAND, "&&", 17)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LOR, "||", 18)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.NOT, "!", 19)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.ASSIGN, "=", 20)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.DEFINE, ":=", 21)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.ADD_ASSIGN, "+=", 22)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SUB_ASSIGN, "-=", 23)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.MUL_ASSIGN, "*=", 24)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.QUO_ASSIGN, "/=", 25)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.REM_ASSIGN, "%=", 26)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.AND_ASSIGN, "&=", 27)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.OR_ASSIGN, "|=", 28)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.XOR_ASSIGN, "^=", 29)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SHL_ASSIGN, "<<=", 30)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SHR_ASSIGN, ">>=", 31)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.INC, "++", 32)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.DEC, "--", 33)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 34)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 35)
	if len(r) > 0 { return r }
	return ""
}

func TestPunctuation() testing.TestResult {
	var l @Lexer = New(toBytes(". , ; : @ # ( ) [ ] { } ..."), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.DOT, ".", 0)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.COMMA, ",", 1)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, ";", 2)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.COLON, ":", 3)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.AT, "@", 4)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.HASH, "#", 5)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LPAREN, "(", 6)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.RPAREN, ")", 7)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LBRACKET, "[", 8)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.RBRACKET, "]", 9)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LBRACE, "{", 10)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.RBRACE, "}", 11)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.ELLIPSIS, "...", 12)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 13)
	if len(r) > 0 { return r }
	return ""
}
