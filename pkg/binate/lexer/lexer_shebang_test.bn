package "pkg/binate/lexer"

import "pkg/binate/token"
import "pkg/builtins/testing"

// Shebang (`#!`) lexing — spec lex.shebang.  A `#!` at offset 0 is skipped as a
// whole line so a chmod +x'd `.bn` can run under `#!/usr/bin/env -S bni -x`; it
// is NOT a general comment (Binate reserves `#` for `#[...]` annotations) and is
// recognized ONLY at offset 0.  Shared helpers (toBytes / checkTok / posErr) live
// in lexer_test.bn (same package).

// A `#!` shebang at offset 0 is skipped whole; the first real token is what
// follows on line 2, at line 2 col 1 (the consumed newline is counted so
// diagnostics point past the shebang).
func TestShebangSkippedToLineTwo() testing.TestResult {
	var l @Lexer = New(toBytes("#!/usr/bin/env -S bni -x\npackage \"m\""), "s.bn")
	var tok token.Token = l.Next()
	var r testing.TestResult = checkTok(tok, token.PACKAGE, "package", 0)
	if len(r) > 0 { return r }
	if tok.Pos.Line != 2 || tok.Pos.Col != 1 {
		return posErr("first token after shebang", 2, 1, tok.Pos.Line, tok.Pos.Col)
	}
	return ""
}

// A shebang-only file with NO trailing newline lexes clean: EOF ends the skip
// (the for-loop's `l.ch != '\0'` guard) and the first token is EOF.
func TestShebangNoTrailingNewline() testing.TestResult {
	var l @Lexer = New(toBytes("#!/bin/bni"), "s.bn")
	return checkTok(l.Next(), token.EOF, "", 0)
}

// A bare `#!` immediately at EOF lexes clean (EOF) — the second byte `!` is
// consumed by the skip, then EOF.
func TestShebangBareThenEof() testing.TestResult {
	var l @Lexer = New(toBytes("#!"), "s.bn")
	return checkTok(l.Next(), token.EOF, "", 0)
}

// A CRLF-terminated shebang lexes clean: the `\r` is consumed with the shebang
// line and the first token is what follows on line 2, col 1.
func TestShebangCRLF() testing.TestResult {
	var l @Lexer = New(toBytes("#!/bin/bni\r\npackage \"m\""), "s.bn")
	var tok token.Token = l.Next()
	var r testing.TestResult = checkTok(tok, token.PACKAGE, "package", 0)
	if len(r) > 0 { return r }
	if tok.Pos.Line != 2 || tok.Pos.Col != 1 {
		return posErr("first token after CRLF shebang", 2, 1, tok.Pos.Line, tok.Pos.Col)
	}
	return ""
}

// `#!` NOT at offset 0 is NOT a shebang: the offset-0-only skip does not fire
// mid-stream, so it lexes as the HASH and NOT tokens as usual.
func TestHashBangNotAtOffsetZero() testing.TestResult {
	var l @Lexer = New(toBytes("x #!"), "s.bn")
	var r testing.TestResult = checkTok(l.Next(), token.IDENT, "x", 0)
	if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.HASH, "#", 1)
	if len(r) > 0 { return r }
	return checkTok(l.Next(), token.NOT, "!", 2)
}

// A leading `#[...]` annotation is NOT masked by the shebang rule (the second
// byte is `[`, not `!`): it lexes as HASH then LBRACKET as usual.
func TestLeadingAnnotationNotMasked() testing.TestResult {
	var l @Lexer = New(toBytes("#[build(x)]"), "s.bn")
	var r testing.TestResult = checkTok(l.Next(), token.HASH, "#", 0)
	if len(r) > 0 { return r }
	return checkTok(l.Next(), token.LBRACKET, "[", 1)
}

// A shebang-only file WITH a trailing newline lexes clean to EOF, and the EOF is
// on line 2 (the shebang's newline was counted, distinct from the
// no-trailing-newline case which ends the skip at EOF on line 1).
func TestShebangOnlyWithTrailingNewline() testing.TestResult {
	var l @Lexer = New(toBytes("#!/bin/bni\n"), "s.bn")
	var tok token.Token = l.Next()
	var r testing.TestResult = checkTok(tok, token.EOF, "", 0)
	if len(r) > 0 { return r }
	if tok.Pos.Line != 2 {
		return posErr("EOF after shebang+newline", 2, 1, tok.Pos.Line, tok.Pos.Col)
	}
	return ""
}

// A `#[...]` annotation on LINE 2 (i.e. AFTER a real shebang skip) is neither
// treated as a second shebang (the skip is offset-0 only) nor masked: it lexes
// as HASH then LBRACKET, positioned on line 2.
func TestAnnotationOnLineTwoAfterShebang() testing.TestResult {
	var l @Lexer = New(toBytes("#!/bin/bni\n#[build(x)]"), "s.bn")
	var tok token.Token = l.Next()
	var r testing.TestResult = checkTok(tok, token.HASH, "#", 0)
	if len(r) > 0 { return r }
	if tok.Pos.Line != 2 {
		return posErr("annotation HASH after shebang", 2, 1, tok.Pos.Line, tok.Pos.Col)
	}
	return checkTok(l.Next(), token.LBRACKET, "[", 1)
}
