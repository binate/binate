package "pkg/binate/lexer"

import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/binate/token"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// streq compares two char slices.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// toBytes converts a string literal (*[]readonly char) to *[]uint8 for the lexer.
func toBytes(s *[]readonly char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

// posErr builds an error message for a position mismatch.
func posErr(label *[]readonly char, wantL int, wantC int,
		gotL int, gotC int) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write(label)
	b.Write(": want ")
	stringutils.WriteInt(b, wantL)
	b.WriteByte(':')
	stringutils.WriteInt(b, wantC)
	b.Write(", got ")
	stringutils.WriteInt(b, gotL)
	b.WriteByte(':')
	stringutils.WriteInt(b, gotC)
	return buf.CopyStr(b.String())
}

// checkTok verifies a single token's type and literal.
// Returns a failure message or "".
func checkTok(got token.Token, wantTyp token.Type,
		wantLit *[]readonly char, idx int) testing.TestResult {
	if got.Typ != wantTyp {
		return buf.Concat("token ", buf.Concat(strconv.Itoa(idx),
			buf.Concat(": want type ", buf.Concat(token.TypeName(wantTyp),
			buf.Concat(", got ", buf.Concat(token.TypeName(got.Typ),
			buf.Concat(" (lit=", buf.Concat(got.Lit, ")"))))))))
	}
	if !streq(got.Lit, wantLit) {
		return buf.Concat("token ", buf.Concat(strconv.Itoa(idx),
			buf.Concat(": want lit '", buf.Concat(wantLit,
			buf.Concat("', got '", buf.Concat(got.Lit, "'"))))))
	}
	return ""
}

// Tests

func TestIdentifiersAndKeywords() testing.TestResult {
	var l @Lexer = New(toBytes("foo bar break const func if return struct type var Self"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.IDENT, "foo", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "bar", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.BREAK, "break", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.CONST, "const", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.FUNC, "func", 4); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IF, "if", 5); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.RETURN, "return", 6); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.STRUCT, "struct", 7); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.TYPE, "type", 8); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.VAR, "var", 9); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SELF, "Self", 10); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 11); if len(r) > 0 { return r }
	return ""
}

func TestBuiltinKeywords() testing.TestResult {
	var l @Lexer = New(toBytes("make box cast bit_cast len sizeof alignof _func_handle"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.MAKE, "make", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.BOX, "box", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.CAST, "cast", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.BIT_CAST, "bit_cast", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LEN, "len", 4); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SIZEOF, "sizeof", 5); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.ALIGNOF, "alignof", 6); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.RAW_FUNC_ADDR, "_func_handle", 7); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 8); if len(r) > 0 { return r }
	return ""
}

// TestRawFuncAddrAlias verifies the transitional `_raw_func_addr`
// spelling still lexes to the same token as the canonical
// `_func_handle`.  Phase 4 of plan-uniform-native-fnptrs.md.  Drop
// this test alongside the alias when callers stop using
// `_raw_func_addr`.
func TestRawFuncAddrAlias() testing.TestResult {
	var l @Lexer = New(toBytes("_raw_func_addr"), "")
	return checkTok(l.Next(), token.RAW_FUNC_ADDR, "_raw_func_addr", 0)
}

func TestOperators() testing.TestResult {
	var l @Lexer = New(toBytes(
		"+ - * / % & | ^ ~ << >> "
		"== != < > <= >= && || ! "
		"= := += -= *= /= %= "
		"&= |= ^= <<= >>= ++ --"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.PLUS, "+", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.MINUS, "-", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.STAR, "*", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SLASH, "/", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.PERCENT, "%", 4); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.AMP, "&", 5); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.PIPE, "|", 6); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.CARET, "^", 7); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.TILDE, "~", 8); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SHL, "<<", 9); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SHR, ">>", 10); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EQ, "==", 11); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.NEQ, "!=", 12); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LT, "<", 13); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.GT, ">", 14); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LEQ, "<=", 15); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.GEQ, ">=", 16); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LAND, "&&", 17); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LOR, "||", 18); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.NOT, "!", 19); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.ASSIGN, "=", 20); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.DEFINE, ":=", 21); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.ADD_ASSIGN, "+=", 22); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SUB_ASSIGN, "-=", 23); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.MUL_ASSIGN, "*=", 24); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.QUO_ASSIGN, "/=", 25); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.REM_ASSIGN, "%=", 26); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.AND_ASSIGN, "&=", 27); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.OR_ASSIGN, "|=", 28); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.XOR_ASSIGN, "^=", 29); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SHL_ASSIGN, "<<=", 30); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SHR_ASSIGN, ">>=", 31); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.INC, "++", 32); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.DEC, "--", 33); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 34); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 35); if len(r) > 0 { return r }
	return ""
}

func TestPunctuation() testing.TestResult {
	var l @Lexer = New(toBytes(". , ; : @ # ( ) [ ] { } ..."), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.DOT, ".", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.COMMA, ",", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, ";", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.COLON, ":", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.AT, "@", 4); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.HASH, "#", 5); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LPAREN, "(", 6); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.RPAREN, ")", 7); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LBRACKET, "[", 8); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.RBRACKET, "]", 9); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LBRACE, "{", 10); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.RBRACE, "}", 11); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.ELLIPSIS, "...", 12); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 13); if len(r) > 0 { return r }
	return ""
}

func TestASIBasic() testing.TestResult {
	var l @Lexer = New(toBytes("x\ny"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.IDENT, "x", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "y", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 4); if len(r) > 0 { return r }
	return ""
}

func TestASIAfterClosingDelimiters() testing.TestResult {
	var l @Lexer = New(toBytes(")\n]\n}"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.RPAREN, ")", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.RBRACKET, "]", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.RBRACE, "}", 4); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 5); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 6); if len(r) > 0 { return r }
	return ""
}

func TestNoASIAfterOperators() testing.TestResult {
	var l @Lexer = New(toBytes("x +\ny"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.IDENT, "x", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.PLUS, "+", 1); if len(r) > 0 { return r }
	// No ASI after +
	r = checkTok(l.Next(), token.IDENT, "y", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 4); if len(r) > 0 { return r }
	return ""
}

func TestNoASIAfterOpeningDelimiters() testing.TestResult {
	var l @Lexer = New(toBytes("(\n[\n{"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.LPAREN, "(", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LBRACKET, "[", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LBRACE, "{", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 3); if len(r) > 0 { return r }
	return ""
}

func TestFuncDecl() testing.TestResult {
	var l @Lexer = New(toBytes("func add(a int, b int) int {\n\treturn a + b\n}"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.FUNC, "func", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "add", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LPAREN, "(", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "a", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "int", 4); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.COMMA, ",", 5); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "b", 6); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "int", 7); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.RPAREN, ")", 8); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "int", 9); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.LBRACE, "{", 10); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.RETURN, "return", 11); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "a", 12); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.PLUS, "+", 13); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "b", 14); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 15); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.RBRACE, "}", 16); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 17); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 18); if len(r) > 0 { return r }
	return ""
}

func TestEmptyInput() testing.TestResult {
	var l @Lexer = New(toBytes(""), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.EOF, "", 0); if len(r) > 0 { return r }
	return ""
}

func TestPositionTracking() testing.TestResult {
	var l @Lexer = New(toBytes("x\ny\nz"), "test.bn")
	var tok token.Token

	tok = l.Next() // x
	if tok.Pos.Line != 1 || tok.Pos.Col != 1 {
		return posErr("token 1", 1, 1, tok.Pos.Line, tok.Pos.Col)
	}

	l.Next() // semicolon

	tok = l.Next() // y
	if tok.Pos.Line != 2 || tok.Pos.Col != 1 {
		return posErr("token 2", 2, 1, tok.Pos.Line, tok.Pos.Col)
	}

	l.Next() // semicolon

	tok = l.Next() // z
	if tok.Pos.Line != 3 || tok.Pos.Col != 1 {
		return posErr("token 3", 3, 1, tok.Pos.Line, tok.Pos.Col)
	}

	return ""
}

// End marks the position one past a token's last byte, so [Pos, End) spans the
// token.  No Binate token spans a newline (strings/chars stop at '\n', comments
// are skipped), so End.Line always equals Pos.Line; this checks single tokens,
// adjacent tokens, and the token that starts the next line.
func TestTokenEnd() testing.TestResult {
	var l @Lexer = New(toBytes("abc de\nfg"), "test.bn")
	var tok token.Token

	tok = l.Next() // abc: cols 1..3, End at 1:4
	if tok.Pos.Line != 1 || tok.Pos.Col != 1 {
		return posErr("abc start", 1, 1, tok.Pos.Line, tok.Pos.Col)
	}
	if tok.End.Line != 1 || tok.End.Col != 4 {
		return posErr("abc end", 1, 4, tok.End.Line, tok.End.Col)
	}

	tok = l.Next() // de: cols 5..6, End at 1:7
	if tok.End.Line != 1 || tok.End.Col != 7 {
		return posErr("de end", 1, 7, tok.End.Line, tok.End.Col)
	}

	l.Next() // ASI semicolon (\n)

	tok = l.Next() // fg: line 2 cols 1..2, End at 2:3
	if tok.Pos.Line != 2 || tok.Pos.Col != 1 {
		return posErr("fg start", 2, 1, tok.Pos.Line, tok.Pos.Col)
	}
	if tok.End.Line != 2 || tok.End.Col != 3 {
		return posErr("fg end", 2, 3, tok.End.Line, tok.End.Col)
	}

	return ""
}

// A synthetic ASI semicolon is zero-width: its End equals its Pos.
func TestAsiSemicolonEnd() testing.TestResult {
	var l @Lexer = New(toBytes("x\ny"), "")
	l.Next() // x
	var semi token.Token = l.Next() // ASI-inserted semicolon
	if semi.Typ != token.SEMICOLON {
		return "TestAsiSemicolonEnd: expected SEMICOLON"
	}
	if semi.End.Line != semi.Pos.Line || semi.End.Col != semi.Pos.Col {
		return posErr("asi end != pos", semi.Pos.Line, semi.Pos.Col,
			semi.End.Line, semi.End.Col)
	}
	return ""
}

// NewCollecting retains comments with their span and own-line/trailing class.
func TestCommentCollection() testing.TestResult {
	// line 1: own-line `// a`; line 2: `x` then trailing `// b`;
	// lines 3-4: a block comment `/* c\nd */`.
	var l @Lexer = NewCollecting(toBytes("// a\nx // b\n/* c\nd */\n"), "t.bn")
	for {
		var tok token.Token = l.Next()
		if tok.Typ == token.EOF { break }
	}
	var cs @[]@token.Comment = l.Comments()
	if len(cs) != 3 {
		return "TestCommentCollection: expected 3 comments"
	}
	if !streq(cs[0].Text, "// a") || !cs[0].OwnLine ||
			cs[0].Pos.Line != 1 || cs[0].Pos.Col != 1 {
		return "TestCommentCollection: comment 0 (own-line) wrong"
	}
	if !streq(cs[1].Text, "// b") || cs[1].OwnLine || cs[1].Pos.Line != 2 {
		return "TestCommentCollection: comment 1 (trailing) wrong"
	}
	if !streq(cs[2].Text, "/* c\nd */") || !cs[2].OwnLine ||
			cs[2].Pos.Line != 3 || cs[2].End.Line != 4 {
		return "TestCommentCollection: comment 2 (block, multi-line) wrong"
	}
	return ""
}

// The default New lexer collects no comments (compiler path unaffected).
func TestCommentCollectionOffByDefault() testing.TestResult {
	var l @Lexer = New(toBytes("// a\nx\n"), "t.bn")
	for {
		var tok token.Token = l.Next()
		if tok.Typ == token.EOF { break }
	}
	if len(l.Comments()) != 0 {
		return "TestCommentCollectionOffByDefault: New should collect nothing"
	}
	return ""
}

// A line comment on a CRLF-terminated line excludes the trailing '\r'.
func TestCommentCollectionCRLF() testing.TestResult {
	var l @Lexer = NewCollecting(toBytes("// a\r\nx\r\n"), "t.bn")
	for {
		var tok token.Token = l.Next()
		if tok.Typ == token.EOF { break }
	}
	var cs @[]@token.Comment = l.Comments()
	if len(cs) != 1 {
		return "TestCommentCollectionCRLF: expected 1 comment"
	}
	if !streq(cs[0].Text, "// a") {
		return "TestCommentCollectionCRLF: Text should exclude trailing CR"
	}
	if cs[0].End.Col != 5 {
		return "TestCommentCollectionCRLF: End should stop before CR (col 5)"
	}
	return ""
}

// `//` and `/* */` inside string/char literals are NOT captured as comments --
// the real tokenizer consumes them, so skipWhitespace never sees them.
func TestCommentCollectionNotInLiterals() testing.TestResult {
	var l @Lexer = NewCollecting(
		toBytes("var s = \"http://x /* y */\"\nvar c = '/'\n"), "t.bn")
	for {
		var tok token.Token = l.Next()
		if tok.Typ == token.EOF { break }
	}
	if len(l.Comments()) != 0 {
		return "TestCommentCollectionNotInLiterals: literal comment chars must not be captured"
	}
	return ""
}

// An unterminated block comment (EOF before */) is still recorded.
func TestCommentCollectionUnterminatedBlock() testing.TestResult {
	var l @Lexer = NewCollecting(toBytes("x /* no close"), "t.bn")
	for {
		var tok token.Token = l.Next()
		if tok.Typ == token.EOF { break }
	}
	var cs @[]@token.Comment = l.Comments()
	if len(cs) != 1 {
		return "TestCommentCollectionUnterminatedBlock: expected 1 comment"
	}
	if !streq(cs[0].Text, "/* no close") || cs[0].OwnLine {
		return "TestCommentCollectionUnterminatedBlock: wrong text/ownline"
	}
	return ""
}

// A header comment (before any token) and consecutive own-line comments all
// classify as own-line (lastTokenLine stays 0 until the first real token); a
// line comment at EOF has no trailing newline in its text.
func TestCommentCollectionHeaderAndConsecutive() testing.TestResult {
	var l @Lexer = NewCollecting(toBytes("// h1\n// h2\nx // t"), "t.bn")
	for {
		var tok token.Token = l.Next()
		if tok.Typ == token.EOF { break }
	}
	var cs @[]@token.Comment = l.Comments()
	if len(cs) != 3 {
		return "TestCommentCollectionHeaderAndConsecutive: expected 3 comments"
	}
	if !streq(cs[0].Text, "// h1") || !cs[0].OwnLine ||
			!streq(cs[1].Text, "// h2") || !cs[1].OwnLine {
		return "TestCommentCollectionHeaderAndConsecutive: header/consecutive should be own-line"
	}
	if !streq(cs[2].Text, "// t") || cs[2].OwnLine {
		return "TestCommentCollectionHeaderAndConsecutive: EOF trailing wrong"
	}
	return ""
}

// A block comment mid-line between tokens is captured and classified trailing.
func TestCommentCollectionMidLineBlock() testing.TestResult {
	var l @Lexer = NewCollecting(toBytes("f(/* x */ a)\n"), "t.bn")
	for {
		var tok token.Token = l.Next()
		if tok.Typ == token.EOF { break }
	}
	var cs @[]@token.Comment = l.Comments()
	if len(cs) != 1 {
		return "TestCommentCollectionMidLineBlock: expected 1 comment"
	}
	if !streq(cs[0].Text, "/* x */") || cs[0].OwnLine {
		return "TestCommentCollectionMidLineBlock: mid-line block should be trailing"
	}
	return ""
}

func TestShortVarDecl() testing.TestResult {
	var l @Lexer = New(toBytes("x := 42"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.IDENT, "x", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.DEFINE, ":=", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.INT, "42", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 4); if len(r) > 0 { return r }
	return ""
}

func TestManagedPointerSyntax() testing.TestResult {
	var l @Lexer = New(toBytes("@Point"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.AT, "@", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "Point", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 3); if len(r) > 0 { return r }
	return ""
}

// ============================================================
// ASI Edge Cases
// ============================================================

func TestASIAfterLiterals() testing.TestResult {
	// String, char, and int literals should trigger ASI
	var l @Lexer = New(toBytes("42\n\"s\"\n'x'"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.INT, "42", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.STRING, "\"s\"", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.CHAR, "'x'", 4); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 5); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 6); if len(r) > 0 { return r }
	return ""
}

func TestMultiTokenExpression() testing.TestResult {
	// Complex multi-line expression: no ASI in the middle
	var l @Lexer = New(toBytes("a + b *\nc"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.IDENT, "a", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.PLUS, "+", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "b", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.STAR, "*", 3); if len(r) > 0 { return r }
	// No ASI after *, so 'c' follows
	r = checkTok(l.Next(), token.IDENT, "c", 4); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 5); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 6); if len(r) > 0 { return r }
	return ""
}

func TestASIAfterKeywords() testing.TestResult {
	// break, continue, return trigger ASI
	var l @Lexer = New(toBytes("break\ncontinue\nreturn"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.BREAK, "break", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.CONTINUE, "continue", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.RETURN, "return", 4); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 5); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 6); if len(r) > 0 { return r }
	return ""
}

func TestPositionMultiline() testing.TestResult {
	// Track positions across multiple lines with varying content
	var l @Lexer = New(toBytes("ab\n  cd\nef"), "test.bn")
	var tok token.Token

	tok = l.Next() // ab at 1:1
	if tok.Pos.Line != 1 || tok.Pos.Col != 1 {
		return "ab: wrong position"
	}
	l.Next() // semicolon

	tok = l.Next() // cd at 2:3
	if tok.Pos.Line != 2 || tok.Pos.Col != 3 {
		return posErr("cd", 2, 3, tok.Pos.Line, tok.Pos.Col)
	}
	l.Next() // semicolon

	tok = l.Next() // ef at 3:1
	if tok.Pos.Line != 3 || tok.Pos.Col != 1 {
		return "ef: wrong position"
	}
	return ""
}
