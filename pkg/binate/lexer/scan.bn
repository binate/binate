package "pkg/binate/lexer"

import "pkg/binate/token"
import "pkg/stdx/slices"

// recordComment appends the comment spanning src[start:l.pos] (the cursor sits
// one past the comment's last byte) to l.comments.  startPos is the comment's
// start; OwnLine is true when no real token has yet appeared on the comment's
// line (a leading / standalone comment) and false when code preceded it (a
// trailing comment).  Called only in comment-collecting mode.
func (l @Lexer) recordComment(start int, end int, startPos token.Pos) {
	var c @token.Comment = make(token.Comment)
	c.Pos = startPos
	// End is the position of `end` (both line-comment and block-comment
	// callers pass an `end` on the current line: neither consumes its
	// trailing newline before recording).
	var endPos token.Pos
	endPos.File = l.file
	endPos.Line = l.line
	endPos.Col = end - l.lineAt + 1
	c.End = endPos
	c.Text = sliceToChars(l.src, start, end)
	c.OwnLine = startPos.Line != l.lastTokenLine
	l.comments = slices.Append[@token.Comment](l.comments, c)
}

// skipWhitespace skips spaces, tabs, carriage returns, newlines, and comments.
// Returns true if at least one newline was skipped.
func (l @Lexer) skipWhitespace() bool {
	var sawNewline bool = false
	for {
		if l.ch == ' ' || l.ch == '\t' || l.ch == '\r' {
			l.advance()
		} else if l.ch == '\n' {
			l.newline()
			l.advance()
			sawNewline = true
		} else if l.ch == '/' && l.peek() == '/' {
			var nl bool = l.skipLineComment()
			if nl {
				sawNewline = true
			}
		} else if l.ch == '/' && l.peek() == '*' {
			var nl bool = l.skipBlockComment()
			if nl {
				sawNewline = true
			}
		} else {
			return sawNewline
		}
	}
	return sawNewline
}

// skipLineComment skips a // comment. Returns true if a newline follows.
func (l @Lexer) skipLineComment() bool {
	var start int = l.pos
	var startPos token.Pos = l.curPos()
	l.advance() // skip first /
	l.advance() // skip second /
	for l.ch != '\0' && l.ch != '\n' {
		l.advance()
	}
	if l.keepComments {
		// Exclude a CRLF's trailing '\r' from the comment text: it is the
		// line terminator, not part of the comment (the lexer treats '\r' as
		// whitespace).  A block comment's interior '\r's stay -- they are
		// genuinely inside the /* */ span.
		var end int = l.pos
		if end > start && l.src[end - 1] == '\r' {
			end = end - 1
		}
		l.recordComment(start, end, startPos)
	}
	if l.ch == '\n' {
		l.newline()
		l.advance()
		return true
	}
	return false
}

// skipBlockComment skips a /* */ comment. Returns true if it contains newlines.
func (l @Lexer) skipBlockComment() bool {
	var start int = l.pos
	var startPos token.Pos = l.curPos()
	var sawNewline bool = false
	l.advance() // skip /
	l.advance() // skip *
	for l.ch != '\0' {
		if l.ch == '\n' {
			l.newline()
			sawNewline = true
		}
		if l.ch == '*' && l.peek() == '/' {
			l.advance() // skip *
			l.advance() // skip /
			if l.keepComments {
				l.recordComment(start, l.pos, startPos)
			}
			return sawNewline
		}
		l.advance()
	}
	// Unterminated block comment (hit EOF) -- record what was scanned.
	if l.keepComments {
		l.recordComment(start, l.pos, startPos)
	}
	return sawNewline
}

// scanIdentifier reads an identifier or keyword.
func (l @Lexer) scanIdentifier() @[]char {
	var start int = l.pos
	for isLetter(l.ch) || isDigit(l.ch) {
		l.advance()
	}
	return sliceToChars(l.src, start, l.pos)
}

// scanNumber reads an integer or floating-point literal. Sets *typ to
// the token type — token.INT for integers, token.FLOAT for decimals
// containing `.` or `eE`, token.ILLEGAL on malformed input. Hex/octal/
// binary prefixes (0x/0o/0b) are always integer.
func (l @Lexer) scanNumber(typ *token.Type) @[]char {
	var start int = l.pos
	// A non-prefixed numeral with a leading `0` and further digits (`0123`,
	// `00`) is a valid FLOAT (`0123.5`) but NOT a valid integer: the grammar
	// is `decimal_lit = "1".."9" { digit } | "0"` with no C-style leading-
	// zero octal/decimal.  Track it so the float tail can upgrade it to a
	// float, else it's reported as a single ILLEGAL token (not split).
	var leadingZeroInt bool = false

	if l.ch == '0' {
		l.advance()
		if l.ch == 'x' || l.ch == 'X' {
			l.advance()
			if !isHexDigit(l.ch) {
				*typ = token.ILLEGAL
				return sliceToChars(l.src, start, l.pos)
			}
			for isHexDigit(l.ch) {
				l.advance()
			}
			*typ = token.INT
			return sliceToChars(l.src, start, l.pos)
		}
		if l.ch == 'o' || l.ch == 'O' {
			l.advance()
			if !isOctalDigit(l.ch) {
				*typ = token.ILLEGAL
				return sliceToChars(l.src, start, l.pos)
			}
			for isOctalDigit(l.ch) {
				l.advance()
			}
			*typ = token.INT
			return sliceToChars(l.src, start, l.pos)
		}
		if l.ch == 'b' || l.ch == 'B' {
			l.advance()
			if l.ch != '0' && l.ch != '1' {
				*typ = token.ILLEGAL
				return sliceToChars(l.src, start, l.pos)
			}
			for l.ch == '0' || l.ch == '1' {
				l.advance()
			}
			*typ = token.INT
			return sliceToChars(l.src, start, l.pos)
		}
		// A leading `0` followed by more decimal digits: consume the run so
		// the numeral is ONE token (`0123` / `0123.5`), not a split.  The
		// shared float tail upgrades it to a float if `.`/`eE` follows; if
		// it stays an integer it's an invalid leading-zero numeral, flagged
		// for the ILLEGAL result below.
		if isDigit(l.ch) {
			leadingZeroInt = true
			for isDigit(l.ch) {
				l.advance()
			}
		}
		// Fall through: "0", "0.something", or "0<digits>[.…]" — float tail.
	} else {
		// Non-zero decimal integer prefix.
		for isDigit(l.ch) {
			l.advance()
		}
	}

	// At this point we've consumed the integer part. Check for a
	// fractional or exponent part to upgrade to FLOAT. A `.` followed
	// by another `.` (range syntax, future) is NOT a float.
	var isFloat bool = false
	if l.ch == '.' && l.peek() != '.' {
		isFloat = true
		l.advance() // consume '.'
		for isDigit(l.ch) {
			l.advance()
		}
	}
	if l.ch == 'e' || l.ch == 'E' {
		isFloat = true
		l.advance() // consume 'e'/'E'
		if l.ch == '+' || l.ch == '-' {
			l.advance()
		}
		if !isDigit(l.ch) {
			*typ = token.ILLEGAL
			return sliceToChars(l.src, start, l.pos)
		}
		for isDigit(l.ch) {
			l.advance()
		}
	}

	if isFloat {
		*typ = token.FLOAT
	} else if leadingZeroInt {
		// `0123` / `00` — a leading-zero non-prefixed integer is not a valid
		// literal (use `0o…` for octal); report one ILLEGAL token spanning
		// the whole numeral rather than silently splitting it.
		*typ = token.ILLEGAL
	} else {
		*typ = token.INT
	}
	return sliceToChars(l.src, start, l.pos)
}

// scanString reads a string literal including the quotes.
func (l @Lexer) scanString() @[]char {
	var start int = l.pos
	l.advance() // skip opening "
	for l.ch != '\0' && l.ch != '"' {
		if l.ch == '\n' {
			return sliceToChars(l.src, start, l.pos)
		}
		if l.ch == '\\' {
			l.advance() // skip backslash
			if l.ch == '\0' || l.ch == '\n' {
				return sliceToChars(l.src, start, l.pos)
			}
		}
		l.advance()
	}
	if l.ch == '"' {
		l.advance() // skip closing "
	}
	return sliceToChars(l.src, start, l.pos)
}

// scanChar reads a char literal including the quotes.  It consumes
// everything up to the matching closing quote, treating a backslash as
// escaping the following byte (so an escaped quote does not terminate the
// literal).  Scanning to the quote — rather than assuming a single byte
// after the backslash — is what lets multi-byte escapes (`\xHH`,
// `\uHHHH`) tokenize correctly; the escape's well-formedness is validated
// later by the type checker.
func (l @Lexer) scanChar() @[]char {
	var start int = l.pos
	l.advance() // skip opening '
	for l.ch != '\0' && l.ch != '\'' {
		if l.ch == '\n' {
			return sliceToChars(l.src, start, l.pos)
		}
		if l.ch == '\\' {
			l.advance() // the next byte is escaped
			if l.ch == '\0' || l.ch == '\n' {
				return sliceToChars(l.src, start, l.pos)
			}
		}
		l.advance()
	}
	if l.ch == '\'' {
		l.advance() // skip closing '
	}
	return sliceToChars(l.src, start, l.pos)
}

// Character classification

func isLetter(ch uint8) bool {
	if ch >= 'a' && ch <= 'z' { return true }
	if ch >= 'A' && ch <= 'Z' { return true }
	if ch == '_' { return true }
	return false
}

// isDigit reports whether ch is an ASCII decimal digit ('0'..'9').
func isDigit(ch uint8) bool {
	return ch >= '0' && ch <= '9'
}

// isHexDigit reports whether ch is an ASCII hex digit ('0'..'9','a'..'f','A'..'F').
func isHexDigit(ch uint8) bool {
	if isDigit(ch) { return true }
	if ch >= 'a' && ch <= 'f' { return true }
	if ch >= 'A' && ch <= 'F' { return true }
	return false
}

// isOctalDigit reports whether ch is an ASCII octal digit ('0'..'7').
func isOctalDigit(ch uint8) bool {
	return ch >= '0' && ch <= '7'
}
