package "pkg/binate/lexer"

import "pkg/binate/token"
import "pkg/builtins/testing"

// ============================================================
// Number Scanning Tests
// ============================================================

func TestIntegerLiterals() testing.TestResult {
	var l @Lexer = New(toBytes("0 42 100 0xFF 0o77 0b1010"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.INT, "0", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.INT, "42", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.INT, "100", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.INT, "0xFF", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.INT, "0o77", 4); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.INT, "0b1010", 5); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 6); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 7); if len(r) > 0 { return r }
	return ""
}

// Basic float literals: decimal point with fractional part.
func TestFloatLiterals() testing.TestResult {
	var l @Lexer = New(toBytes("3.14 0.5 100.0"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.FLOAT, "3.14", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.FLOAT, "0.5", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.FLOAT, "100.0", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 4); if len(r) > 0 { return r }
	return ""
}

// Trailing-dot floats: "1." is a float, "1.5" has no trailing-dot issue,
// and "1..2" must NOT be a float (range-syntax placeholder).
func TestFloatTrailingDot() testing.TestResult {
	var l @Lexer = New(toBytes("1. 2.e3"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.FLOAT, "1.", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.FLOAT, "2.e3", 1); if len(r) > 0 { return r }
	return ""
}

// Leading-dot floats: ".5" and ".5e-2".
func TestFloatLeadingDot() testing.TestResult {
	var l @Lexer = New(toBytes(".5 .25e-2"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.FLOAT, ".5", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.FLOAT, ".25e-2", 1); if len(r) > 0 { return r }
	return ""
}

// Exponent forms with and without a fractional part.
func TestFloatExponent() testing.TestResult {
	var l @Lexer = New(toBytes("1e5 2.5e-3 1E+10 0e0"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.FLOAT, "1e5", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.FLOAT, "2.5e-3", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.FLOAT, "1E+10", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.FLOAT, "0e0", 3); if len(r) > 0 { return r }
	return ""
}

// Double-dot is NOT a float — reserved for future range syntax.
// "1..2" must tokenize as INT DOT DOT INT (no SEMICOLON between).
func TestFloatDoubleDotNotFloat() testing.TestResult {
	var l @Lexer = New(toBytes("1..2"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.INT, "1", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.DOT, ".", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.DOT, ".", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.INT, "2", 3); if len(r) > 0 { return r }
	return ""
}

// A plain `.` followed by a non-digit is still a DOT token (e.g., for
// selector expressions like `foo.bar`). Integer followed by selector
// (`1.Field`) isn't valid Binate, but the lexer shouldn't choke on it.
func TestDotAfterIdentIsSelector() testing.TestResult {
	var l @Lexer = New(toBytes("foo.bar"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.IDENT, "foo", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.DOT, ".", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "bar", 2); if len(r) > 0 { return r }
	return ""
}

// Malformed exponent ("1e" with no digits) is ILLEGAL.
func TestFloatBadExponent() testing.TestResult {
	var l @Lexer = New(toBytes("1e"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.ILLEGAL, "1e", 0); if len(r) > 0 { return r }
	return ""
}

// A leading-zero non-prefixed integer (`0123`, `00`) is ILLEGAL — the
// grammar has no C-style leading-zero octal/decimal (use `0o…`) — and is
// reported as ONE token spanning the whole numeral, not split into `0`
// and `123`.
func TestLeadingZeroIntIsIllegal() testing.TestResult {
	var r testing.TestResult
	var l @Lexer = New(toBytes("0123"), "")
	r = checkTok(l.Next(), token.ILLEGAL, "0123", 0); if len(r) > 0 { return r }
	var l2 @Lexer = New(toBytes("00"), "")
	r = checkTok(l2.Next(), token.ILLEGAL, "00", 0); if len(r) > 0 { return r }
	return ""
}

// A leading zero is fine for a FLOAT (float_literal allows leading
// digits) and for bare `0`; only a leading-zero INTEGER is rejected.
func TestLeadingZeroFloatAndBareZeroOk() testing.TestResult {
	var r testing.TestResult
	var l @Lexer = New(toBytes("0123.5"), "")
	r = checkTok(l.Next(), token.FLOAT, "0123.5", 0); if len(r) > 0 { return r }
	var l2 @Lexer = New(toBytes("0"), "")
	r = checkTok(l2.Next(), token.INT, "0", 0); if len(r) > 0 { return r }
	var l3 @Lexer = New(toBytes("0.5"), "")
	r = checkTok(l3.Next(), token.FLOAT, "0.5", 0); if len(r) > 0 { return r }
	return ""
}

// ============================================================
// Comment Tests
// ============================================================

func TestLineComment() testing.TestResult {
	var l @Lexer = New(toBytes("x // comment\ny"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.IDENT, "x", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "y", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 4); if len(r) > 0 { return r }
	return ""
}

func TestBlockComment() testing.TestResult {
	var l @Lexer = New(toBytes("x /* comment */ y"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.IDENT, "x", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "y", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 3); if len(r) > 0 { return r }
	return ""
}

func TestBlockCommentWithNewline() testing.TestResult {
	var l @Lexer = New(toBytes("x /* block\ncomment */ y"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.IDENT, "x", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "y", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 4); if len(r) > 0 { return r }
	return ""
}

func TestCommentWithASI() testing.TestResult {
	// A line comment after an ASI-triggering token should still insert semicolon
	var l @Lexer = New(toBytes("x // comment\ny"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.IDENT, "x", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.IDENT, "y", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 4); if len(r) > 0 { return r }
	return ""
}

// ============================================================
// String and Char Literal Tests
// ============================================================

func TestStringLiteral() testing.TestResult {
	var l @Lexer = New(toBytes("\"hello world\""), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.STRING, "\"hello world\"", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 2); if len(r) > 0 { return r }
	return ""
}

func TestStringLiteralEscapes() testing.TestResult {
	var l @Lexer = New(toBytes("\"a\\nb\\tc\\\\d\\\"e\""), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.STRING, "\"a\\nb\\tc\\\\d\\\"e\"", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 2); if len(r) > 0 { return r }
	return ""
}

func TestEmptyStringLiteral() testing.TestResult {
	var l @Lexer = New(toBytes("\"\""), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.STRING, "\"\"", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 2); if len(r) > 0 { return r }
	return ""
}

func TestCharLiteral() testing.TestResult {
	var l @Lexer = New(toBytes("'A' 'z' '0'"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.CHAR, "'A'", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.CHAR, "'z'", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.CHAR, "'0'", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 4); if len(r) > 0 { return r }
	return ""
}

func TestCharLiteralEscapes() testing.TestResult {
	var l @Lexer = New(toBytes("'\\n' '\\t' '\\\\' '\\''"), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.CHAR, "'\\n'", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.CHAR, "'\\t'", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.CHAR, "'\\\\'", 2); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.CHAR, "'\\''", 3); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 4); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 5); if len(r) > 0 { return r }
	return ""
}

func TestStringWithEmbeddedQuote() testing.TestResult {
	var l @Lexer = New(toBytes("\"he said \\\"hi\\\"\""), "")
	var r testing.TestResult
	r = checkTok(l.Next(), token.STRING, "\"he said \\\"hi\\\"\"", 0); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.SEMICOLON, "\n", 1); if len(r) > 0 { return r }
	r = checkTok(l.Next(), token.EOF, "", 2); if len(r) > 0 { return r }
	return ""
}
