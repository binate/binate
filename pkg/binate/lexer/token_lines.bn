package "pkg/binate/lexer"

// recordTokenLine records line, that of a token just scanned, in the lines that hold
// a token (TokenLines), once.  They are kept ascending, and a line no later than the
// last one recorded is already there: the scan reads the source in order, and a
// re-read after a Restore scans only tokens it has scanned before.  Called only in
// comment-collecting mode.
func (l @Lexer) recordTokenLine(line int) {
	var n int = l.tokenLines.Len()
	if n > 0 && line <= l.tokenLines.Get(n - 1) { return }
	l.tokenLines.Push(line)
}

// TokenLines returns the lines that hold a token scanned so far, ascending, each
// once.
func (l @Lexer) TokenLines() @[]int {
	var n int = 0
	if l.keepComments { n = l.tokenLines.Len() }
	var lines @[]int = make_slice(int, n)
	for i := 0; i < n; i++ { lines[i] = l.tokenLines.Get(i) }
	return lines
}
