package "pkg/binate/lexer"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// checkLines checks got, a lexer's TokenLines, against want.
func checkLines(got @[]int, want @[]int) testing.TestResult {
	var ok bool = len(got) == len(want)
	for i := 0; ok && i < len(got); i++ { ok = got[i] == want[i] }
	if ok { return "" }
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("token lines:")
	for i := 0; i < len(got); i++ {
		sb.WriteByte(' ')
		sb.Write(strconv.Itoa(got[i]))
	}
	return buf.CopyStr(sb.String())
}

// A comment-collecting lexer records each line that holds a token, once and in
// order: not a blank line, nor one holding only a comment, nor the end of one
// where a semicolon is inserted.
func TestTokenLinesHoldATokenEach() testing.TestResult {
	var l @Lexer = NewCollecting(toBytes("a b\n\n// c\n/* d\n */ e\n\"s\";\n\n"), "t.bn")
	scanAll(l)
	var want @[]int = make_slice(int, 3)
	want[0] = 1
	want[1] = 5
	want[2] = 6
	return checkLines(l.TokenLines(), want)
}

func TestTokenLinesOffByDefault() testing.TestResult {
	var l @Lexer = New(toBytes("a\nb"), "t.bn")
	scanAll(l)
	if len(l.TokenLines()) != 0 { return "New should record no token lines" }
	return ""
}

// A re-read after a Restore records no line twice, and the lines scanned past the
// state restored stay recorded.
func TestTokenLinesThroughRestore() testing.TestResult {
	var l @Lexer = NewCollecting(toBytes("a\nb\nc\nd"), "t.bn")
	_ = l.Next()
	var start Lexer = l.Save()
	for i := 0; i < 4; i++ { _ = l.Next() }
	l.Restore(start)
	var want @[]int = make_slice(int, 3)
	want[0] = 1
	want[1] = 2
	want[2] = 3
	var r testing.TestResult = checkLines(l.TokenLines(), want)
	if len(r) > 0 { return r }
	scanAll(l)
	var all @[]int = make_slice(int, 4)
	for i := 0; i < 4; i++ { all[i] = i + 1 }
	return checkLines(l.TokenLines(), all)
}
