package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/std/table"

// Archive member selection: given the explicitly-listed objects (always included)
// and the members of each `.a` archive, pull in exactly the members needed to
// resolve undefined references — the standard `ar` "extract on demand" rule.  A
// pulled member may itself reference symbols that another member defines, so the
// pass is iterated to a fixpoint.  Only a STRONG (global) undefined reference forces
// extraction; a weak undefined reference does not (it resolves to 0), matching ld.  A common
// symbol (a C tentative definition) counts as a definition, as in lld: it never pulls a
// member, it satisfies another object's reference to its name, and a member defining a name
// only as a common is pulled for a reference to it.

// symDefines reports whether sym is a definition archive selection counts: in a section,
// absolute, or a common.
func symDefines(sym InputSymbol) bool { return sym.SecIndex >= 0 || sym.Abs || sym.Common }

// objDefinesSym reports whether obj defines (symDefines) a symbol named name,
// counting BOTH a strong (global) and a weak definition — this must agree with
// Resolve, which treats a weak definition as a real definition (strong-over-weak).
// If it counted only strong defs, a symbol already weakly defined among the linked
// objects would look undefined here, wrongly pulling an archive member that then
// silently overrides the weak default (ld would not search the archive at all).
func objDefinesSym(obj @InputObject, name *[]readonly char) bool {
	for i := 0; i < len(obj.Symbols); i++ {
		var sym InputSymbol = obj.Symbols[i]
		if symDefines(sym) && (sym.Binding == BIND_GLOBAL || sym.Binding == BIND_WEAK) &&
				charsEqual(sym.Name, name) {
			return true
		}
	}
	return false
}

// objRefsUndefinedGlobal reports whether obj has a strong (global) undefined
// reference (no definition, symDefines) to name.  A weak undefined reference does not
// count, nor does a common.
func objRefsUndefinedGlobal(obj @InputObject, name *[]readonly char) bool {
	for i := 0; i < len(obj.Symbols); i++ {
		var sym InputSymbol = obj.Symbols[i]
		if !symDefines(sym) && sym.Binding == BIND_GLOBAL && charsEqual(sym.Name, name) {
			return true
		}
	}
	return false
}

// isNeeded reports whether name is a strong undefined reference somewhere in
// included[0:n], or one a needed shared library makes (libRefs), and is defined nowhere in
// included[0:n] — i.e. an archive member defining it should be pulled.
func isNeeded(included @[]@InputObject, n int, name *[]readonly char,
		libRefs @table.Table[*[]readonly char, bool, LinkNameHasher, LinkNameEq]) bool {
	var referenced bool = libRefs.Has(name)
	for i := 0; i < n; i++ {
		if objDefinesSym(included[i], name) { return false } // already satisfied (strong or weak)
		if objRefsUndefinedGlobal(included[i], name) { referenced = true }
	}
	return referenced
}

// memberResolvesUndefined reports whether member defines a global symbol that is
// currently needed by included[0:n] or the needed shared libraries (libRefs).
func memberResolvesUndefined(member @InputObject, included @[]@InputObject, n int,
		libRefs @table.Table[*[]readonly char, bool, LinkNameHasher, LinkNameEq]) bool {
	for s := 0; s < len(member.Symbols); s++ {
		var sym InputSymbol = member.Symbols[s]
		// A member's definition of a needed symbol — strong, weak or common — can satisfy a
		// strong reference and so extract the member (matching Resolve's view of a
		// definition, and commons.bn's allocation of a common); locals never do.
		if !symDefines(sym) || len(sym.Name) == 0 { continue }
		if sym.Binding != BIND_GLOBAL && sym.Binding != BIND_WEAK { continue }
		if isNeeded(included, n, sym.Name, libRefs) { return true }
	}
	return false
}

// selectMembers returns the objects to link: every explicitly-listed object,
// followed by the archive members pulled in to resolve undefined references,
// iterated to a fixpoint.  Members are checked against the growing included set, so
// each needed symbol is satisfied by exactly one member (no spurious duplicates).
func selectMembers(objs @[]@InputObject, archives @[]@[]@InputObject) @[]@InputObject {
	return selectMembersFor(objs, archives, make_slice(@[]char, 0))
}

// selectMembersFor is selectMembers for a dynamic link whose needed shared libraries make the
// strong undefined references libRefs: a member defining one of those names is pulled in too,
// as lld does, so the definition the library binds to is linked (and exported).
func selectMembersFor(objs @[]@InputObject, archives @[]@[]@InputObject,
		libRefs @[]@[]char) @[]@InputObject {
	// The set borrows libRefs' names, which outlive it.
	var refs @table.Table[*[]readonly char, bool, LinkNameHasher, LinkNameEq] = table.NewTable[
			*[]readonly char, bool, LinkNameHasher, LinkNameEq](
					LinkNameHasher{}, LinkNameEq{})
	for i := 0; i < len(libRefs); i++ { refs.Put(libRefs[i], true) }
	var total int = len(objs)
	for a := 0; a < len(archives); a++ { total = total + len(archives[a]) }
	var included @[]@InputObject = make_slice(@InputObject, total)
	var nIncl int = 0
	for i := 0; i < len(objs); i++ {
		included[nIncl] = objs[i]
		nIncl = nIncl + 1
	}

	// pulled[a][m] marks an already-extracted member so it is not pulled twice.
	var pulled @[]@[]bool = make_slice(@[]bool, len(archives))
	for a := 0; a < len(archives); a++ { pulled[a] = make_slice(bool, len(archives[a])) }

	var changed bool = true
	for changed {
		changed = false
		for a := 0; a < len(archives); a++ {
			for m := 0; m < len(archives[a]); m++ {
				if pulled[a][m] { continue }
				if memberResolvesUndefined(archives[a][m], included, nIncl, refs) {
					included[nIncl] = archives[a][m]
					nIncl = nIncl + 1
					pulled[a][m] = true
					changed = true
				}
			}
		}
	}
	return included[0:nIncl]
}

// rejectedInput returns why the first of objs that cannot be linked (its Rejected) can't, as
// "<path>: <reason>", or "".
func rejectedInput(objs @[]@InputObject) @[]readonly char {
	for i := 0; i < len(objs); i++ {
		if len(objs[i].Rejected) != 0 {
			return buf.Concat(buf.Concat(objs[i].Path, ": "), objs[i].Rejected)
		}
	}
	return ""
}
