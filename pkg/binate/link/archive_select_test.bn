package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// (mkObj/mkSym are in resolve_test.bn; mkCommon in builder_common_test.bn;
// oneSymObj/buildArchive/writeBytes/objDefines in parse_ar_test.bn; asmToObj/checkLoadable in
// link_test.bn/emit_elf_test.bn; fakeLibcDirs / mkSoSymsWith in libsearch_test.bn;
// elfDynValue in dynlink_exports_test.bn; loadFileOff in got_link_test.bn;
// bytesAtEqual in dynmacho_test.bn — same package.)

// includedDefines counts how many of the selected objects define name.
func includedDefines(sel @[]@InputObject, name *[]readonly char) int {
	var c int = 0
	for i := 0; i < len(sel); i++ {
		if objDefines(sel[i], name) { c = c + 1 }
	}
	return c
}

// selectMembers pulls the archive member that resolves an undefined reference and
// leaves an unrelated member out.
func TestSelectMembersPullsNeeded() testing.TestResult {
	var mainSyms @[]InputSymbol = make_slice(InputSymbol, 1)
	mainSyms[0] = mkSym("helper", -1, BIND_GLOBAL) // referenced, undefined
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObj("main.o", mainSyms)

	var hSyms @[]InputSymbol = make_slice(InputSymbol, 1)
	hSyms[0] = mkSym("helper", 0, BIND_GLOBAL) // defines helper
	var uSyms @[]InputSymbol = make_slice(InputSymbol, 1)
	uSyms[0] = mkSym("unused", 0, BIND_GLOBAL) // defines something nobody needs
	var members @[]@InputObject = make_slice(@InputObject, 2)
	members[0] = mkObj("lib.a(h.o)", hSyms)
	members[1] = mkObj("lib.a(u.o)", uSyms)
	var archives @[]@[]@InputObject = make_slice(@[]@InputObject, 1)
	archives[0] = members

	var sel @[]@InputObject = selectMembers(objs, archives)
	if len(sel) != 2 { return fail("expected main + the helper member only") }
	if includedDefines(sel, "helper") != 1 { return fail("the helper member should be pulled") }
	if includedDefines(sel, "unused") != 0 { return fail("the unrelated member must not be pulled") }
	return ""
}

// A pulled member's own undefined reference pulls a further member (fixpoint).
func TestSelectMembersTransitive() testing.TestResult {
	var mainSyms @[]InputSymbol = make_slice(InputSymbol, 1)
	mainSyms[0] = mkSym("a", -1, BIND_GLOBAL)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObj("main.o", mainSyms)

	var aSyms @[]InputSymbol = make_slice(InputSymbol, 2)
	aSyms[0] = mkSym("a", 0, BIND_GLOBAL) // defines a
	aSyms[1] = mkSym("b", -1, BIND_GLOBAL) // ...but needs b
	var bSyms @[]InputSymbol = make_slice(InputSymbol, 1)
	bSyms[0] = mkSym("b", 0, BIND_GLOBAL) // defines b
	var members @[]@InputObject = make_slice(@InputObject, 2)
	members[0] = mkObj("lib.a(a.o)", aSyms)
	members[1] = mkObj("lib.a(b.o)", bSyms)
	var archives @[]@[]@InputObject = make_slice(@[]@InputObject, 1)
	archives[0] = members

	var sel @[]@InputObject = selectMembers(objs, archives)
	if len(sel) != 3 { return fail("expected main + both members (a pulls b)") }
	if includedDefines(sel, "a") != 1 || includedDefines(sel, "b") != 1 {
		return fail("both a and b should be resolved from the archive")
	}
	return ""
}

// A weak undefined reference does not force archive extraction.
func TestSelectMembersWeakDoesNotPull() testing.TestResult {
	var mainSyms @[]InputSymbol = make_slice(InputSymbol, 1)
	mainSyms[0] = mkSym("maybe", -1, BIND_WEAK) // weak reference
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObj("main.o", mainSyms)

	var mSyms @[]InputSymbol = make_slice(InputSymbol, 1)
	mSyms[0] = mkSym("maybe", 0, BIND_GLOBAL)
	var members @[]@InputObject = make_slice(@InputObject, 1)
	members[0] = mkObj("lib.a(m.o)", mSyms)
	var archives @[]@[]@InputObject = make_slice(@[]@InputObject, 1)
	archives[0] = members

	var sel @[]@InputObject = selectMembers(objs, archives)
	if len(sel) != 1 { return fail("a weak undefined reference must not pull an archive member") }
	return ""
}

// End to end: a program that calls a symbol defined only in an archive member links
// (the member is extracted), producing a loadable executable.
func TestLinkAgainstArchive() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.SetGlobal("helper")
	x64.Call(a, "helper")
	x64.Ret(a)
	if len(asmToObj(a, buf.Concat(dir, "/arlink_main.o"))) != 0 { return fail("assemble main") }

	var dh @[]uint8 = oneSymObj("helper", buf.Concat(dir, "/arlink_h.o"))
	var du @[]uint8 = oneSymObj("unused", buf.Concat(dir, "/arlink_u.o"))
	if len(dh) == 0 || len(du) == 0 { return fail("build archive members") }
	var names @[]@[]char = make_slice(@[]char, 2)
	names[0] = buf.CopyStr("h.o/")
	names[1] = buf.CopyStr("u.o/")
	var datas @[]@[]uint8 = make_slice(@[]uint8, 2)
	datas[0] = dh
	datas[1] = du
	if !writeBytes(buf.Concat(dir, "/arlink.a"), buildArchive(names, datas)) {
		return fail("write archive")
	}

	var paths @[]@[]char = make_slice(@[]char, 2)
	paths[0] = buf.CopyStr(buf.Concat(dir, "/arlink_main.o"))
	paths[1] = buf.CopyStr(buf.Concat(dir, "/arlink.a"))
	var err @[]readonly char = Link(paths, "_start", EM_X86_64, cast(uint64, 0x400000),
			buf.Concat(dir, "/arlink_prog"))
	if len(err) != 0 { return fail("linking against the archive failed") }

	data, ok := readFile(buf.Concat(dir, "/arlink_prog"))
	if !ok { return fail("cannot read the linked executable") }
	var problem @[]char = checkLoadable(data, EM_X86_64, 0x400000)
	if len(problem) != 0 { return problem }
	return ""
}

// A symbol already WEAKLY defined among the linked objects is satisfied, so an
// archive member defining it is NOT pulled (matching ld — a weak default is not
// overridden by dragging in the archive).  Guards the selection/Resolve agreement
// on what "defined" means.
func TestSelectMembersWeakDefinitionSatisfies() testing.TestResult {
	var aSyms @[]InputSymbol = make_slice(InputSymbol, 1)
	aSyms[0] = mkSym("foo", 0, BIND_WEAK) // A weak-defines foo (a default impl)
	var bSyms @[]InputSymbol = make_slice(InputSymbol, 1)
	bSyms[0] = mkSym("foo", -1, BIND_GLOBAL) // B strongly references foo
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkObj("a.o", aSyms)
	objs[1] = mkObj("b.o", bSyms)

	var mSyms @[]InputSymbol = make_slice(InputSymbol, 1)
	mSyms[0] = mkSym("foo", 0, BIND_GLOBAL) // archive member strong-defines foo
	var members @[]@InputObject = make_slice(@InputObject, 1)
	members[0] = mkObj("lib.a(m.o)", mSyms)
	var archives @[]@[]@InputObject = make_slice(@[]@InputObject, 1)
	archives[0] = members

	var sel @[]@InputObject = selectMembers(objs, archives)
	if len(sel) != 2 { return fail("a weakly-defined symbol must not pull an archive member") }
	return ""
}

// refObject returns a parsed x86-64 object whose text calls the undefined global name.
func refObject(dir *[]readonly char, name *[]readonly char) @InputObject {
	var none @InputObject
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("caller")
	a.SetGlobal("caller")
	a.SetGlobal(name)
	x64.Call(a, name)
	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return none }
	var path @[]char = buf.Concat(buf.Concat(dir, "/ref_"), buf.Concat(name, ".o"))
	if !elf.WriteX86_64(a, path) { return none }
	obj, err := ReadObject(path)
	if len(err) != 0 { return none }
	return obj
}

// An archive member that reads but cannot be linked (here, a .ctors section) fails a link
// only when the link pulls it in; ReadArchive, which hands back every member, rejects it.
func TestRejectedMemberOnlyWhenPulled() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var good @[]uint8 = oneSymObj("alpha", buf.Concat(dir, "/rm_a.o"))
	var bad @[]uint8 = keepFixture(dir, "ctors", "L", SHF_ALLOC | SHF_WRITE, false, SHT_PROGBITS,
			false)
	if len(good) == 0 || len(bad) == 0 { return fail("could not build member objects") }
	var names @[]@[]char = make_slice(@[]char, 2)
	names[0] = buf.CopyStr("a.o/")
	names[1] = buf.CopyStr("b.o/") // defines f, and has a .ctors section
	var datas @[]@[]uint8 = make_slice(@[]uint8, 2)
	datas[0] = good
	datas[1] = bad
	var ar @[]uint8 = buildArchive(names, datas)
	members, err := parseArchiveBytes(ar, "lib.a")
	if len(err) != 0 || len(members) != 2 { return fail("the archive should read") }
	var archives @[]@[]@InputObject = make_slice(@[]@InputObject, 1)
	archives[0] = members

	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = refObject(dir, "alpha")
	if !present(objs[0]) { return fail("cannot build the referring object") }
	if len(rejectedInput(selectMembers(objs, archives))) != 0 {
		return fail("a member the link does not pull in failed it")
	}
	objs[0] = refObject(dir, "f")
	if !present(objs[0]) { return fail("cannot build the referring object") }
	var rej @[]readonly char = rejectedInput(selectMembers(objs, archives))
	if !startsWith(rej, "lib.a(b.o): .ctors: bnld does not run") {
		return fail("a pulled-in rejected member did not fail the link")
	}

	var arPath @[]char = buf.Concat(dir, "/rm.a")
	if !writeBytes(arPath, ar) { return fail("write archive") }
	_, rerr := ReadArchive(arPath)
	if !startsWith(rerr, buf.Concat(arPath, "(b.o): .ctors: bnld does not run")) {
		return fail("ReadArchive should reject a member that cannot be linked")
	}
	return ""
}

// selectMembersFor pulls a member defining a name a needed shared library references (libRefs),
// as lld does, though no object references it; a name an included object already defines pulls
// nothing.
func TestSelectMembersForLibraryRefs() testing.TestResult {
	var mainSyms @[]InputSymbol = make_slice(InputSymbol, 1)
	mainSyms[0] = mkSym("own", 0, BIND_GLOBAL)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObj("main.o", mainSyms)
	var hSyms @[]InputSymbol = make_slice(InputSymbol, 1)
	hSyms[0] = mkSym("host_log", 0, BIND_GLOBAL)
	var oSyms @[]InputSymbol = make_slice(InputSymbol, 1)
	oSyms[0] = mkSym("own", 0, BIND_GLOBAL)
	var members @[]@InputObject = make_slice(@InputObject, 2)
	members[0] = mkObj("libhost.a(host.o)", hSyms)
	members[1] = mkObj("libhost.a(own.o)", oSyms)
	var archives @[]@[]@InputObject = make_slice(@[]@InputObject, 1)
	archives[0] = members
	var refs @[]@[]char = @[]@[]char{buf.CopyStr("host_log"), buf.CopyStr("own")}
	var sel @[]@InputObject = selectMembersFor(objs, archives, refs)
	if len(sel) != 2 || includedDefines(sel, "host_log") != 1 {
		return fail("the member defining the library's host_log should be pulled")
	}
	if includedDefines(sel, "own") != 1 {
		return fail("own's member must not be pulled: main.o defines it")
	}
	if len(selectMembers(objs, archives)) != 1 { return fail("without libRefs nothing is pulled") }
	return ""
}

// commonArchive returns an archive of one member, ar.o, defining x — strongly in .text when
// strong, else as a 4-byte common — and the marker `m`.
func commonArchive(strong bool) @[]@[]@InputObject {
	var syms @[]InputSymbol = make_slice(InputSymbol, 2)
	syms[0] = mkSym("x", 0, BIND_GLOBAL)
	if !strong { syms[0] = mkCommon("x", 4, 4) }
	syms[1] = mkSym("m", 0, BIND_GLOBAL)
	var members @[]@InputObject = make_slice(@InputObject, 1)
	members[0] = mkObj("lib.a(ar.o)", syms)
	var archives @[]@[]@InputObject = make_slice(@[]@InputObject, 1)
	archives[0] = members
	return archives
}

// Archive selection treats a common as a definition, as lld does: a common never pulls a
// member (main.o's `int x;` leaves the member defining x strongly out), it satisfies another
// object's reference to its name (use.o's `extern int x;` pulls nothing either, in either
// order, nor does a needed library's reference), and a member defining x only as a common is
// pulled for a strong reference to x — not for a weak one, nor when an included object already
// has a common x.
func TestSelectMembersCommons() testing.TestResult {
	var commonMain @[]InputSymbol = make_slice(InputSymbol, 1)
	commonMain[0] = mkCommon("x", 4, 4)
	var refUse @[]InputSymbol = make_slice(InputSymbol, 1)
	refUse[0] = mkSym("x", -1, BIND_GLOBAL)
	var a @[]@InputObject = @[]@InputObject{mkObj("main.o", commonMain)}
	if includedDefines(selectMembers(a, commonArchive(true)), "m") != 0 {
		return fail("a common pulled the member defining x strongly")
	}
	var c @[]@InputObject = @[]@InputObject{mkObj("main.o", commonMain), mkObj("use.o", refUse)}
	var d @[]@InputObject = @[]@InputObject{mkObj("use.o", refUse), mkObj("main.o", commonMain)}
	if includedDefines(selectMembers(c, commonArchive(true)), "m") != 0 ||
			includedDefines(selectMembers(d, commonArchive(true)), "m") != 0 {
		return fail("a reference to a name a common defines pulled a member")
	}
	if includedDefines(selectMembersFor(a, commonArchive(true), @[]@[]char{buf.CopyStr("x")}), "m") !=
			0 {
		return fail("a library's reference to a name a common defines pulled a member")
	}
	var b @[]@InputObject = @[]@InputObject{mkObj("use.o", refUse)}
	if includedDefines(selectMembers(b, commonArchive(false)), "m") != 1 {
		return fail("the member defining x as a common was not pulled for a reference to x")
	}
	var weakUse @[]InputSymbol = make_slice(InputSymbol, 1)
	weakUse[0] = mkSym("x", -1, BIND_WEAK)
	var w @[]@InputObject = @[]@InputObject{mkObj("weak.o", weakUse)}
	if includedDefines(selectMembers(w, commonArchive(false)), "m") != 0 {
		return fail("a weak reference pulled the member defining x as a common")
	}
	var both @[]@InputObject = @[]@InputObject{mkObj("main.o", commonMain), mkObj("use.o", refUse)}
	if includedDefines(selectMembers(both, commonArchive(false)), "m") != 0 {
		return fail("a member's common x was pulled though main.o already has a common x")
	}
	return ""
}

// dynsymDefines reports whether the dynamic ELF executable rd's .dynsym defines name (an entry
// of that name whose st_shndx is not SHN_UNDEF).
func dynsymDefines(rd *[]readonly uint8, name *[]readonly char) bool {
	var symOff int = loadFileOff(rd, elfDynValue(rd, DT_SYMTAB))
	var strOff int = loadFileOff(rd, elfDynValue(rd, DT_STRTAB))
	var nsym int = cast(int, u32(rd, loadFileOff(rd, elfDynValue(rd, DT_HASH)) + 4))
	if symOff < 0 || strOff < 0 { return false }
	for i := 1; i < nsym; i++ {
		var e int = symOff + i * symEntSize
		var at int = strOff + cast(int, u32(rd, e))
		if bytesAtEqual(rd, at, name) && rd[at + len(name)] == 0 && u16(rd, e + 6) != 0 { return true }
	}
	return false
}

// A dynamic link pulls in the archive member defining a name only a needed `-l` shared library
// references, and exports it: libplug.so references `host_log` (the fake libc does not),
// libhost.a's host.o defines it, and the program references neither; the executable defines
// and exports host_log.  Linked without libplug.so, host.o is not pulled in.
func TestLinkDynElfPullsMemberForLibraryRef() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var m @asm.Assembler = asm.New(8)
	m.SetSection("text", -1)
	m.DefineLabel("_start")
	m.SetGlobal("_start")
	m.SetGlobal("exit")
	aarch64.Bl(m, "exit")
	aarch64.ResolveFixups(m)
	m.Finalize()
	var h @asm.Assembler = asm.New(8)
	h.SetSection("text", -1)
	h.DefineLabel("host_log")
	h.SetGlobal("host_log")
	aarch64.Ret(h)
	aarch64.ResolveFixups(h)
	h.Finalize()
	if m.HasError || h.HasError { return fail("assembler error") }
	var mainO @[]char = buf.Concat(dir, "/main.o")
	var hostO @[]char = buf.Concat(dir, "/host.o")
	if !elf.WriteAArch64(m, mainO) || !elf.WriteAArch64(h, hostO) {
		return fail("write objects failed")
	}
	hostData, hok := readFile(hostO)
	var lib @[]char = buf.Concat(dir, "/libhost.a")
	if !hok ||
			!writeBytes(lib, buildArchive(@[]@[]char{buf.CopyStr("host.o/")}, @[]@[]uint8{hostData})) {
		return fail("cannot write libhost.a")
	}
	var plug @[]char = buf.Concat(dir, "/libplug.so")
	var plugSo @[]uint8 = mkSoSymsWith("libplug.so.1", EM_AARCH64,
			@[]@[]char{buf.CopyStr("plugin_run")}, @[]@[]char{buf.CopyStr("host_log")})
	if !writeBytes(plug, plugSo) { return fail("cannot write libplug.so") }
	var libDirs @[]@[]char = fakeLibcDirs(dir, EM_AARCH64, make_slice(@[]char, 0))
	var out @[]char = buf.Concat(dir, "/prog")
	var err @[]readonly char = LinkDynElf(@[]@[]char{mainO, lib}, "_start", EM_AARCH64,
			cast(uint64, 0x400000), out, @[]@[]char{plug}, libDirs)
	if len(err) != 0 { return fail(buf.Concat("LinkDynElf failed: ", err)) }
	exe, eok := readFile(out)
	if !eok { return fail("cannot read the executable") }
	if !dynsymDefines(exe, "host_log") {
		return fail("host_log is not the member's exported definition")
	}
	var bare @[]char = buf.Concat(dir, "/bare")
	var berr @[]readonly char = LinkDynElf(@[]@[]char{mainO, lib}, "_start", EM_AARCH64,
			cast(uint64, 0x400000), bare, make_slice(@[]char, 0), libDirs)
	if len(berr) != 0 { return fail(buf.Concat("LinkDynElf (no plugin) failed: ", berr)) }
	bexe, bok := readFile(bare)
	if !bok || dynsymDefines(bexe, "host_log") {
		return fail("host.o was pulled in with no library naming it")
	}
	return ""
}

// A static link pulls an archive member that defines a referenced name only as a common, and
// allocates it: main.o takes x's address, libc1.a's c1.o has `int x;`.
func TestLinkPullsCommonMember() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var m @asm.Assembler = asm.New(8)
	m.SetSection("text", -1)
	m.DefineLabel("_start")
	m.SetGlobal("_start")
	m.SetGlobal("x")
	aarch64.Adrp(m, aarch64.X0, "x")
	aarch64.AddImmLabel(m, true, aarch64.X0, aarch64.X0, "x")
	aarch64.Ret(m)
	aarch64.ResolveFixups(m)
	m.Finalize()
	var c @asm.Assembler = asm.New(8)
	c.SetSection("text", -1)
	c.DefineLabel("c1_marker")
	c.SetGlobal("c1_marker")
	c.DefineCommon("x", 4, 4)
	aarch64.Adrp(c, aarch64.X0, "x")
	aarch64.Ret(c)
	aarch64.ResolveFixups(c)
	c.Finalize()
	if m.HasError || c.HasError { return fail("assembler error") }
	var mainO @[]char = buf.Concat(dir, "/main.o")
	var c1O @[]char = buf.Concat(dir, "/c1.o")
	if !elf.WriteAArch64(m, mainO) || !elf.WriteAArch64(c, c1O) { return fail("write objects failed") }
	c1, cok := readFile(c1O)
	if !cok { return fail("cannot read c1.o") }
	var lib @[]char = buf.Concat(dir, "/libc1.a")
	if !writeBytes(lib, buildArchive(@[]@[]char{buf.CopyStr("c1.o/")}, @[]@[]uint8{c1})) {
		return fail("cannot write libc1.a")
	}
	var out @[]char = buf.Concat(dir, "/prog")
	var err @[]readonly char = Link(@[]@[]char{mainO, lib}, "_start", EM_AARCH64,
			cast(uint64, 0x400000), out)
	if len(err) != 0 { return fail(buf.Concat("Link failed: ", err)) }
	data, ok := readFile(out)
	if !ok { return fail("cannot read the linked executable") }
	var problem @[]char = checkLoadable(data, EM_AARCH64, 0x400000)
	if len(problem) != 0 { return problem }
	return ""
}
