package "pkg/binate/link"

// arm32's unwind index (`.ARM.exidx`): one 8-byte entry per function — a PREL31 offset to the
// function and its unwind data (inline opcodes, a PREL31 offset into `.ARM.extab`, or
// EXIDX_CANTUNWIND) — which the unwinder binary-searches by address, so the merged table must be
// sorted by the code it describes and cover all of it.  Each input index section indexes one
// code section (InputSection.Link); as ld.lld lays the table out, a code section with no index
// gets an EXIDX_CANTUNWIND entry (else a PC in it would fall into the previous function's entry
// and be unwound with that function's opcodes), and a CANTUNWIND sentinel ends the code.  The
// symbols `__exidx_start` / `__exidx_end` bracket the table (a static unwinder's way to it),
// and PT_ARM_EXIDX spans it (the dynamic loader's).

// exidxGap is a synthesized EXIDX_CANTUNWIND entry of the merged `.ARM.exidx`, at offset Off in
// it: for code section Sec of object Obj — or, Sec -1, the sentinel at the end of the code.
type exidxGap struct {
	Off int
	Obj int
	Sec int
}

// isArmExidx reports whether an input section of ELF type stype and Link link is an arm32 unwind
// index, whatever its name (LLVM names one `.ARM.exidx` plus its code section's name, which may
// be anything): the ELF reader gives one its code section's index as Link, where an x86-64
// `.eh_frame`, whose type has the same value, gets -1.
func isArmExidx(stype int, link int) bool {
	return stype == SHT_ARM_EXIDX && link >= 0
}

// placeArmExidx places the `.ARM.exidx` inputs of objs in kind kindArmExidx (kindSize /
// kindAlign as placeInKind keeps them), once the code (kindText) is placed — OutIndex still
// holding each section's kind — in the order of the code they index: each non-empty code
// section's index sections, or an 8-byte gap for a synthesized CANTUNWIND entry when it has none,
// then the sentinel's.  It returns the gaps, which writeExidxGaps fills once addresses are
// known — none, and nothing placed, when no input has an index or there is no code.  An index it
// does not place (of an empty code section, or with no code at all) is dropped (OutIndex -1): an
// entry for no code would share its address with the next function's.
func placeArmExidx(objs @[]@InputObject, kindSize @[]int, kindAlign @[]int) @[]exidxGap {
	var n int = 1 // the sentinel
	var any bool = false
	var code bool = false
	for o := 0; o < len(objs); o++ {
		for s := 0; s < len(objs[o].Sections); s++ {
			var sec InputSection = objs[o].Sections[s]
			if isArmExidx(sec.Type, sec.Link) {
				any = true
				objs[o].Sections[s].OutIndex = -1
			}
			if sec.OutIndex == kindText {
				n = n + 1
				if sec.Size > 0 { code = true }
			}
		}
	}
	if !any || !code { return make_slice(exidxGap, 0) }
	if kindAlign[kindArmExidx] < 4 { kindAlign[kindArmExidx] = 4 }
	var gaps @[]exidxGap = make_slice(exidxGap, n)
	var g int = 0
	for o := 0; o < len(objs); o++ {
		var obj @InputObject = objs[o]
		first, next := exidxChains(obj)
		for s := 0; s < len(obj.Sections); s++ {
			if obj.Sections[s].OutIndex != kindText || obj.Sections[s].Size == 0 { continue }
			if first[s] < 0 {
				gaps[g] = exidxGapAt(kindSize, o, s)
				g = g + 1
				continue
			}
			for x := first[s]; x >= 0; x = next[x] {
				obj.Sections[x].OutIndex = kindArmExidx
				placeInKind(obj, x, kindArmExidx, kindSize, kindAlign)
			}
		}
	}
	gaps[g] = exidxGapAt(kindSize, -1, -1)
	return gaps[0:g + 1]
}

// exidxChains maps each section of obj to the `.ARM.exidx` sections indexing it, as chains in
// section order: first[s] is the first index section of section s (-1: none), and next[x] the
// index section after index section x for the same code (-1: none).  One pass over the sections,
// as an object built with `-ffunction-sections` has a code and an index section per function.
func exidxChains(obj @InputObject) (@[]int, @[]int) {
	var n int = len(obj.Sections)
	var first @[]int = make_slice(int, n)
	var next @[]int = make_slice(int, n)
	for s := 0; s < n; s++ {
		first[s] = -1
		next[s] = -1
	}
	for x := n - 1; x >= 0; x = x - 1 {
		var link int = obj.Sections[x].Link
		if !isArmExidx(obj.Sections[x].Type, link) || link >= n { continue }
		next[x] = first[link]
		first[link] = x
	}
	return first, next
}

// exidxGapAt reserves an 8-byte entry at the end of kindArmExidx (4-aligned) for code section s
// of object o (s -1: the sentinel) and returns it.
func exidxGapAt(kindSize @[]int, o int, s int) exidxGap {
	var gp exidxGap
	gp.Off = alignUp(kindSize[kindArmExidx], 4)
	gp.Obj = o
	gp.Sec = s
	kindSize[kindArmExidx] = gp.Off + 8
	return gp
}

// writeExidxGaps writes each synthesized entry of the merged `.ARM.exidx` (outs[xi]): the PREL31
// offset to the start of its code section — the sentinel's to the end of .text (outs[ti]) — and
// EXIDX_CANTUNWIND.  Returns "" or an error for code beyond a PREL31 offset's reach.
func writeExidxGaps(objs @[]@InputObject, outs @[]OutputSection, xi int, ti int,
		gaps @[]exidxGap) @[]readonly char {
	for i := 0; i < len(gaps); i++ {
		var target uint64 = outs[ti].Addr + outs[ti].Size
		if gaps[i].Sec >= 0 {
			target = outs[ti].Addr + cast(uint64, objs[gaps[i].Obj].Sections[gaps[i].Sec].OutOffset)
		}
		var at uint64 = outs[xi].Addr + cast(uint64, gaps[i].Off)
		if !putCantUnwind(outs[xi].Data, gaps[i].Off, target, at) { return exidxRangeError() }
	}
	return ""
}

// putCantUnwind writes at off in d an EXIDX_CANTUNWIND entry, at address at, for the code at
// target, reporting whether the code is within a PREL31 offset's reach (±1 GiB).
func putCantUnwind(d @[]uint8, off int, target uint64, at uint64) bool {
	var diff int64 = bit_cast(int64, target - at)
	if diff < -0x40000000 || diff >= 0x40000000 { return false }
	writeU32(d, off, diff & 0x7fffffff)
	writeU32(d, off + 4, cast(int64, EXIDX_CANTUNWIND))
	return true
}

// exidxRangeError is the error for code more than a PREL31 offset's reach (±1 GiB) from the
// unwind index entry that covers it.
func exidxRangeError() @[]readonly char {
	return "code is beyond a PREL31 offset's reach (1 GiB) of its .ARM.exidx entry"
}

// exidxSymbolName returns the bracketing symbol of the unwind index: `__exidx_start` (i 0) or
// `__exidx_end` (i 1).
func exidxSymbolName(i int) *[]readonly char {
	if i == 0 { return "__exidx_start" }
	return "__exidx_end"
}

// withExidxSymbols returns abs with the unwind index's bracketing symbols some object refers to
// and none defines, as layout-defined symbols setExidxSymbols gives addresses.
func withExidxSymbols(abs @[]AbsSym, objs @[]@InputObject) @[]AbsSym {
	for i := 0; i < 2; i++ {
		if referencedNotDefined(objs, exidxSymbolName(i)) { abs = withImageSym(abs, exidxSymbolName(i)) }
	}
	return abs
}

// setExidxSymbols gives the unwind index's bracketing symbols in t.Abs their addresses in lr:
// the merged `.ARM.exidx`'s start and end, an empty range where it would be when there is none.
func setExidxSymbols(t @SymbolTable, lr @LayoutResult) {
	setAbsValue(t, exidxSymbolName(0), lr.ExidxStart)
	setAbsValue(t, exidxSymbolName(1), lr.ExidxEnd)
}

// exidxSpanOf returns the merged `.ARM.exidx` of lr as a span for its PT_ARM_EXIDX header, or
// noSpan when there is none.
func exidxSpanOf(lr @LayoutResult) secSpan {
	if lr.Exidx < 0 { return noSpan() }
	var e secSpan
	e.Sec = lr.Exidx
	e.Off = cast(uint64, 0)
	e.Size = cast(int, lr.Sections[lr.Exidx].Size)
	return e
}
