package "pkg/binate/link"

import "pkg/binate/buf"

// The scripted builder's init / fini / preinit arrays.  Start code reaches an array only
// through its bracketing symbols (`__init_array_start` …), and the builder discards an
// unplaced section nothing refers to — so an array the script does not place would vanish,
// its functions silently never run: Finish rejects one (unplacedArrayError).  A script places
// the three with PlaceInitFiniArrays (or the InitFiniArrays item); any Place puts init / fini
// array inputs in ascending priority, as Layout does.

// isInitFiniArray reports whether a section of ELF type stype is an init or fini array, whose
// inputs go in priority order.
func isInitFiniArray(stype int) bool { return stype == SHT_INIT_ARRAY || stype == SHT_FINI_ARRAY }

// placeMatchedArrays appends every not-yet-consumed init / fini array input whose name matches
// glob to the open section, in ascending priority (initFiniPriority), inputs of one priority
// in pool order.
func (b @LayoutBuilder) placeMatchedArrays(glob *[]readonly char) {
	var n int = 0
	for o := 0; o < len(b.inputs); o++ {
		for s := 0; s < len(b.inputs[o].Sections); s++ {
			var sec InputSection = b.inputs[o].Sections[s]
			if !b.consumed[o][s] && isInitFiniArray(sec.Type) && globMatch(glob, sec.Name) { n = n + 1 }
		}
	}
	var objIdx @[]int = make_slice(int, n)
	var secIdx @[]int = make_slice(int, n)
	var prio @[]int = make_slice(int, n)
	var m int = 0
	for o := 0; o < len(b.inputs); o++ {
		for s := 0; s < len(b.inputs[o].Sections); s++ {
			var sec InputSection = b.inputs[o].Sections[s]
			if b.consumed[o][s] || !isInitFiniArray(sec.Type) || !globMatch(glob, sec.Name) { continue }
			var base *[]readonly char = ".init_array"
			if sec.Type == SHT_FINI_ARRAY { base = ".fini_array" }
			// Insertion keeps it stable: an input goes after every one of no greater priority.
			var p int = initFiniPriority(sec.Name, base)
			var j int = m
			for j > 0 && prio[j - 1] > p {
				objIdx[j] = objIdx[j - 1]
				secIdx[j] = secIdx[j - 1]
				prio[j] = prio[j - 1]
				j = j - 1
			}
			objIdx[j] = o
			secIdx[j] = s
			prio[j] = p
			m = m + 1
		}
	}
	for i := 0; i < n; i++ { b.placeInput(objIdx[i], secIdx[i]) }
}

// PlaceInitFiniArrays places in the open section the preinit, init and fini arrays, each
// between its bracketing symbols (`__preinit_array_start` / `_end`, `__init_array_start` /
// `_end`, `__fini_array_start` / `_end`) — the init and fini ones in priority order — for the
// start code that runs them.  Each start symbol is at an address aligned for the array's
// inputs (and the target's pointers), so no padding lies between it and the first entry.  A
// second call would move the symbols to an empty range, so it is an error.
func (b @LayoutBuilder) PlaceInitFiniArrays() {
	if b.cur < 0 { b.fail("PlaceInitFiniArrays: no open section"); return }
	if b.placedArrays { b.fail("PlaceInitFiniArrays: the arrays are already placed"); return }
	b.placedArrays = true
	b.ensureStarted()
	var ptr int = 8
	if b.Machine == EM_ARM { ptr = 4 }
	var globs @[]@[]char = make_slice(@[]char, 3)
	globs[0] = buf.CopyStr(".preinit_array*")
	globs[1] = buf.CopyStr(".init_array*")
	globs[2] = buf.CopyStr(".fini_array*")
	for i := 0; i < 3; i++ {
		b.AlignDot(b.arrayInputAlign(globs[i], ptr))
		b.SymbolAtDot(arraySymbolName(2 * i))
		b.Place(buf.Concat(buf.Concat("*(", globs[i]), ")"), true)
		b.SymbolAtDot(arraySymbolName(2 * i + 1))
	}
}

// arrayInputAlign returns the largest alignment among the not-yet-consumed inputs whose name
// matches glob, and at least min.
func (b @LayoutBuilder) arrayInputAlign(glob *[]readonly char, min int) int {
	var a int = min
	for o := 0; o < len(b.inputs); o++ {
		for s := 0; s < len(b.inputs[o].Sections); s++ {
			var sec InputSection = b.inputs[o].Sections[s]
			if !b.consumed[o][s] && globMatch(glob, sec.Name) && sec.Align > a { a = sec.Align }
		}
	}
	return a
}

// unplacedArrayError returns why the layout cannot finish for an init / fini / preinit array
// input with contents that the script never placed, or "".
func (b @LayoutBuilder) unplacedArrayError() @[]readonly char {
	for o := 0; o < len(b.inputs); o++ {
		for s := 0; s < len(b.inputs[o].Sections); s++ {
			var sec InputSection = b.inputs[o].Sections[s]
			if b.consumed[o][s] || sec.Size == 0 { continue }
			if !isInitFiniArray(sec.Type) && sec.Type != SHT_PREINIT_ARRAY { continue }
			var msg @[]char = buf.Concat(buf.Concat(b.inputs[o].Path, ": "), sec.Name)
			return buf.Concat(msg,
					" is not placed, so its functions would never run (PlaceInitFiniArrays "
							"places the arrays with the symbols start code walks them by)")
		}
	}
	return ""
}
