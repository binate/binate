package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// arraysObject returns an x86-64 object with a 4-byte .text and the given sections.
func arraysObject(arrays @[]InputSection) @InputObject {
	var secs @[]InputSection = make_slice(InputSection, len(arrays) + 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, make_slice(uint8, 4), cast(uint, 4),
			4)
	for i := 0; i < len(arrays); i++ { secs[i + 1] = arrays[i] }
	return mkObjSecs(secs)
}

// textOnlyBuilder returns a builder over objs that places only .text, at 0x400000.
func textOnlyBuilder(objs @[]@InputObject) @LayoutBuilder {
	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x400000))
	b.BeginSection(".text", SF_READ | SF_EXEC)
	b.Place("*(.text*)", false)
	b.EndSection()
	return b
}

// An init, fini or preinit array with contents that the script never places fails Finish (it
// would silently never run); an empty one does not.
func TestBuilderUnplacedArrayErrors() testing.TestResult {
	var names @[]@[]char = make_slice(@[]char, 3)
	names[0] = buf.CopyStr(".init_array")
	names[1] = buf.CopyStr(".fini_array")
	names[2] = buf.CopyStr(".preinit_array")
	var types @[]int = @[]int{SHT_INIT_ARRAY, SHT_FINI_ARRAY, SHT_PREINIT_ARRAY}
	var arrs @[]InputSection = make_slice(InputSection, 1)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	for i := 0; i < 3; i++ {
		arrs[0] = arrSec(names[i], types[i], 0x11)
		objs[0] = arraysObject(arrs)
		var err @[]readonly char = textOnlyBuilder(objs).Finish()
		var want @[]char = buf.Concat(buf.Concat("x.o: ", names[i]), " is not placed, so its functions")
		if !startsWith(err, want) { return fail(buf.Concat("an unplaced array: ", err)) }
	}
	arrs[0] = mkSection(".fini_array", SF_READ | SF_WRITE, SHT_FINI_ARRAY, make_slice(uint8, 0),
			cast(uint, 0), 8)
	objs[0] = arraysObject(arrs)
	if len(textOnlyBuilder(objs).Finish()) != 0 {
		return fail("an empty unplaced array failed the layout")
	}
	return ""
}

// arraysInputs returns two objects: one with a preinit array, the plain init array, a fini
// array and a priority-101 init array; one with a priority-5 fini array.
func arraysInputs() @[]@InputObject {
	var arrs @[]InputSection = make_slice(InputSection, 4)
	arrs[0] = arrSec(".init_array", SHT_INIT_ARRAY, 0x33)
	arrs[1] = arrSec(".fini_array", SHT_FINI_ARRAY, 0x44)
	arrs[2] = arrSec(".init_array.101", SHT_INIT_ARRAY, 0x11)
	arrs[3] = arrSec(".preinit_array", SHT_PREINIT_ARRAY, 0x55)
	var more @[]InputSection = make_slice(InputSection, 1)
	more[0] = arrSec(".fini_array.5", SHT_FINI_ARRAY, 0x66)
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = arraysObject(arrs)
	objs[1] = arraysObject(more)
	return objs
}

// arraysScriptChecks checks the finished b's .data (output section 1) holds, from its start,
// the preinit array, the init array and the fini array — those two in priority order — with
// the bracketing symbols around each.
func arraysScriptChecks(b @LayoutBuilder) testing.TestResult {
	var lr @LayoutResult = b.result
	if len(lr.Sections) != 2 { return fail("expected .text and .data") }
	var d OutputSection = lr.Sections[1]
	if d.Size != cast(uint64, 40) || d.Data[0] != 0x55 || d.Data[8] != 0x11 || d.Data[16] != 0x33 ||
			d.Data[24] != 0x66 || d.Data[32] != 0x44 {
		return fail("the arrays are not in place, the init and fini ones in priority order")
	}
	var want @[]uint64 = @[]uint64{0, 8, 8, 24, 24, 40}
	for i := 0; i < arraySymbolCount; i++ {
		v, ok := absValue(b.AbsSyms(), arraySymbolName(i))
		if !ok || v != d.Addr + want[i] { return fail(buf.Concat("misplaced ", arraySymbolName(i))) }
	}
	return ""
}

// PlaceInitFiniArrays places the preinit, init and fini arrays (the latter two in priority
// order), each between its bracketing symbols; it runs once, in an open section.
func TestBuilderPlaceInitFiniArrays() testing.TestResult {
	var b @LayoutBuilder = textOnlyBuilder(arraysInputs())
	b.SetDot(cast(uint64, 0x401000))
	b.BeginSection(".data", SF_READ | SF_WRITE)
	b.PlaceInitFiniArrays()
	b.EndSection()
	var err @[]readonly char = b.Finish()
	if len(err) != 0 { return fail(buf.Concat("Finish: ", err)) }
	var r testing.TestResult = arraysScriptChecks(b)
	if len(r) != 0 { return r }

	b = textOnlyBuilder(arraysInputs())
	b.BeginSection(".data", SF_READ | SF_WRITE)
	b.PlaceInitFiniArrays()
	b.PlaceInitFiniArrays()
	if !startsWith(b.Error(), "PlaceInitFiniArrays: the arrays are already placed") {
		return fail("a second call should fail")
	}
	b = textOnlyBuilder(arraysInputs())
	b.PlaceInitFiniArrays()
	if !startsWith(b.Error(), "PlaceInitFiniArrays: no open section") {
		return fail("a call with no open section should fail by name")
	}
	return ""
}

// A start symbol is aligned for its array's entries even when the section starts at an
// unaligned address, so it is the first entry's address.
func TestBuilderInitArrayStartAligned() testing.TestResult {
	var arrs @[]InputSection = make_slice(InputSection, 1)
	arrs[0] = arrSec(".init_array", SHT_INIT_ARRAY, 0x11)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = arraysObject(arrs)
	var b @LayoutBuilder = textOnlyBuilder(objs)
	b.SetDot(cast(uint64, 0x401004))
	b.BeginSection(".data", SF_READ | SF_WRITE)
	b.PlaceInitFiniArrays()
	b.EndSection()
	var err @[]readonly char = b.Finish()
	if len(err) != 0 { return fail(buf.Concat("Finish: ", err)) }
	s, ok := absValue(b.AbsSyms(), "__init_array_start")
	if !ok || s != cast(uint64, 0x401008) { return fail("__init_array_start is before the padding") }
	if objs[0].Sections[1].OutOffset != cast(uint, 4) {
		return fail("the entry is not at the aligned address")
	}
	return ""
}

// One Place matching both ordinary sections and init arrays places the ordinary ones first,
// then the arrays in priority order, inputs of one priority in input order.
func TestBuilderPlaceMixedArrays() testing.TestResult {
	var a @[]InputSection = make_slice(InputSection, 3)
	a[0] = arrSec(".init_array", SHT_INIT_ARRAY, 0x33)
	a[1] = mkSection(".init_data", SF_READ | SF_WRITE, SHT_PROGBITS, make_slice(uint8, 8),
			cast(uint, 8), 8)
	a[2] = arrSec(".init_array.7", SHT_INIT_ARRAY, 0x11)
	var c @[]InputSection = make_slice(InputSection, 1)
	c[0] = arrSec(".init_array", SHT_INIT_ARRAY, 0x34)
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = arraysObject(a)
	objs[1] = arraysObject(c)
	var b @LayoutBuilder = textOnlyBuilder(objs)
	b.SetDot(cast(uint64, 0x401000))
	b.BeginSection(".data", SF_READ | SF_WRITE)
	b.Place("*(.init*)", false)
	b.EndSection()
	var err @[]readonly char = b.Finish()
	if len(err) != 0 { return fail(buf.Concat("Finish: ", err)) }
	var d OutputSection = b.result.Sections[1]
	if d.Data[0] != 0 || d.Data[8] != 0x11 || d.Data[16] != 0x33 || d.Data[24] != 0x34 {
		return fail("expected the data, then the arrays by priority, then input order")
	}
	return ""
}

// The InitFiniArrays script item does what PlaceInitFiniArrays does.
func TestScriptInitFiniArrays() testing.TestResult {
	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(arraysInputs())
	var tsec SectionSpec
	tsec.Name = buf.CopyStr(".text")
	tsec.Flags = SF_READ | SF_EXEC
	tsec.Items = make_slice(ScriptItem, 1)
	tsec.Items[0] = Place("*(.text*)", false)
	var dsec SectionSpec
	dsec.Name = buf.CopyStr(".data")
	dsec.Flags = SF_READ | SF_WRITE
	dsec.Align = 0x1000
	dsec.Items = make_slice(ScriptItem, 1)
	dsec.Items[0] = InitFiniArrays()
	var script LayoutScript
	script.HasStartDot = true
	script.StartDot = cast(uint64, 0x400000)
	script.Sections = make_slice(SectionSpec, 2)
	script.Sections[0] = tsec
	script.Sections[1] = dsec
	var cerr @[]readonly char = CompileScript(b, script)
	if len(cerr) != 0 { return fail(buf.Concat("CompileScript: ", cerr)) }
	var err @[]readonly char = b.Finish()
	if len(err) != 0 { return fail(buf.Concat("Finish: ", err)) }
	return arraysScriptChecks(b)
}
