package "pkg/binate/link"

import "pkg/binate/buf"

// `*(COMMON)` synthesis for the scripted-layout builder.  A common symbol (a C
// tentative definition, `int x;`) carries a size and an alignment but no storage; the
// linker reserves the space in a placement's section and defines the symbol there,
// unless a real definition of the name exists (which supersedes it — standard C rules).
// Same-named commons across objects merge to the maximum size and alignment.  The
// reservation grows the section but adds no file bytes (a .bss-style hole), so a
// pure-COMMON section materializes as NOBITS.

// hasRealDef reports whether any input object provides a real GLOBAL or WEAK definition
// of name in a section (not a tentative one) — such a definition supersedes a common of
// the same name, which is then not allocated.  The binding test mirrors Resolve, which
// only registers global/weak definitions: a file-local symbol (C `static int x;`) is a
// distinct object and must NOT suppress a global common of the same name, or the common
// would be neither allocated here nor resolvable there.
func (b @LayoutBuilder) hasRealDef(name *[]readonly char) bool {
	for o := 0; o < len(b.inputs); o++ {
		var syms @[]InputSymbol = b.inputs[o].Symbols
		for s := 0; s < len(syms); s++ {
			if syms[s].SecIndex < 0 || syms[s].Common { continue }
			if syms[s].Binding != BIND_GLOBAL && syms[s].Binding != BIND_WEAK { continue }
			if charsEqual(syms[s].Name, name) { return true }
		}
	}
	return false
}

// mergeCommon returns the merged (size, align) for the common symbol named name: the
// maximum st_size and the maximum alignment (st_value) over every common definition of
// that name across all objects — the standard tentative-definition merge.
func (b @LayoutBuilder) mergeCommon(name *[]readonly char) (uint64, int) {
	var size uint64 = cast(uint64, 0)
	var align int = 1
	for o := 0; o < len(b.inputs); o++ {
		var syms @[]InputSymbol = b.inputs[o].Symbols
		for s := 0; s < len(syms); s++ {
			if !syms[s].Common || !charsEqual(syms[s].Name, name) { continue }
			if cast(uint64, syms[s].Size) > size { size = cast(uint64, syms[s].Size) }
			var a int = cast(int, syms[s].Value) // st_value is the alignment for a common
			if a > align { align = a }
		}
	}
	return size, align
}

// placeCommon allocates every not-yet-defined common symbol in the open section, in
// first-encounter order (object order, then in-object order) for determinism: it aligns
// the location counter to the merged alignment, defines the symbol at that VMA (via the
// absolute-symbol set, so relocations and the entry lookup see it), and advances past
// the merged size.  A common whose name already resolves — a real definition, or one
// already synthesized / defined via DefineSymbol (both recorded in the abs set) — is
// skipped, so each is allocated at most once and a real definition wins.  The reserved
// span grows the section size but adds no file bytes.
func (b @LayoutBuilder) placeCommon() {
	if b.cur < 0 { b.fail("placeCommon: no open section"); return }
	for o := 0; o < len(b.inputs); o++ {
		var syms @[]InputSymbol = b.inputs[o].Symbols
		for s := 0; s < len(syms); s++ {
			if !syms[s].Common { continue }
			var name @[]char = syms[s].Name
			if absHas(b.abs, name) { continue } // already synthesized or DefineSymbol'd
			if b.hasRealDef(name) { continue } // a real definition supersedes the common
			size, align := b.mergeCommon(name)
			if align < 1 { align = 1 }
			b.dot = alignUpU64(b.dot, align)
			b.setAbs(buf.CopyStr(name), b.dot)
			b.dot = b.dot + size
		}
	}
	b.secs[b.cur].Size = b.dot - b.secs[b.cur].VmaStart
}
