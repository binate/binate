package "pkg/binate/link"

import "pkg/binate/buf"

// `*(COMMON)` for the scripted-layout builder.  A common symbol (a C tentative definition,
// `int x;`) carries a size and an alignment but no storage.  The first `*(COMMON)` placement
// builds the linker-made commons object the whole-link drivers use (commons.bn): a NOBITS
// section defining each common no definition supersedes — same-named commons merged to the
// largest size and alignment, a strong definition superseding one and a weak one not, as in
// GNU ld and lld — and places that section in the open section.  Its definitions are global
// object definitions, so Resolve binds every reference to a common to them, over a weak
// definition of the name.  A script's own definition of a common's name (DefineSymbol /
// SymbolAtDot, a declarative script's AbsSyms) wins, as a GNU ld or lld script assignment
// does: one made before the placement gets the common no storage, and one made after it
// drops the common's definition when the builder resolves (its storage stays).  With no
// `*(COMMON)` placement the commons are not allocated, and Resolve reports them undefined.

// placeCommons places the commons object's section in the open section (the first time only;
// a later `*(COMMON)` finds nothing left to place), adding the object to the inputs.
func (b @LayoutBuilder) placeCommons() {
	if b.placedCommons { return }
	b.placedCommons = true
	var r commonsResult = commonObjectExcept(b.inputs, b.Machine, false, b.abs)
	if len(r.Err) != 0 {
		b.fail(buf.Concat("*(COMMON): ", r.Err))
		return
	}
	if !present(r.Obj) { return }
	r.Obj.Sections[0].Name = buf.CopyStr("COMMON")
	b.inputs = objectsWith(b.inputs, r.Obj)
	var consumed @[]@[]bool = make_slice(@[]bool, len(b.consumed) + 1)
	for i := 0; i < len(b.consumed); i++ { consumed[i] = b.consumed[i] }
	consumed[len(b.consumed)] = make_slice(bool, 1)
	b.consumed = consumed
	b.commons = r.Obj
	b.placeInput(len(b.inputs) - 1, 0)
	b.secs[b.cur].Size = b.dot - b.secs[b.cur].VmaStart
}

// dropScriptDefinedCommons removes from the commons object each definition whose name the
// script has defined since the placement, so Resolve binds the name to the script's value.
func (b @LayoutBuilder) dropScriptDefinedCommons() {
	if !present(b.commons) { return }
	var keep @[]InputSymbol = make_slice(InputSymbol, len(b.commons.Symbols))
	var n int = 0
	for i := 0; i < len(b.commons.Symbols); i++ {
		if absHas(b.abs, b.commons.Symbols[i].Name) { continue }
		keep[n] = b.commons.Symbols[i]
		n = n + 1
	}
	if n == len(b.commons.Symbols) { return }
	var syms @[]InputSymbol = make_slice(InputSymbol, n)
	for i := 0; i < n; i++ { syms[i] = keep[i] }
	b.commons.Symbols = syms
}
