package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// (mkSection / mkObjSecs are in layout_test.bn, mkSym in resolve_test.bn, mkReloc in
// builder_emit_test.bn, absValue in builder_symbols_test.bn, resolvedAddr in
// macho_link_test.bn, fail in parse_elf_test.bn — all same package.)

// mkCommon builds a common (tentative-definition) InputSymbol: SecIndex -1, Common
// true, Size the byte count, Value the required alignment.
func mkCommon(name *[]readonly char, size uint, align uint) InputSymbol {
	var s InputSymbol
	s.Name = buf.CopyStr(name)
	s.SecIndex = -1
	s.Value = align // st_value = alignment for a common symbol
	s.Binding = BIND_GLOBAL
	s.Size = size
	s.Common = true
	return s
}

// builderAddr returns the address a reference to name resolves to in builder b's layout lr —
// an object's definition, the commons object's included — and whether an object defines it.
func builderAddr(b @LayoutBuilder, lr @LayoutResult, name *[]readonly char) (uint64, bool) {
	t, rerr := b.Resolve()
	if len(rerr) != 0 { return cast(uint64, 0), false }
	return resolvedAddr(t, lr, name)
}

// Place("*(COMMON)") allocates each common symbol in the open section at its aligned
// address and defines it (as a definition of the linker-made commons object); same-named
// commons across objects merge to the max size and alignment and are allocated once.
func TestPlaceCommonAllocatesAndMerges() testing.TestResult {
	// obj0: common "a" (size 4, align 4) and "shared" (size 4, align 4).
	var syms0 @[]InputSymbol = make_slice(InputSymbol, 2)
	syms0[0] = mkCommon("a", cast(uint, 4), cast(uint, 4))
	syms0[1] = mkCommon("shared", cast(uint, 4), cast(uint, 4))
	var obj0 @InputObject = make(InputObject)
	obj0.Path = buf.CopyStr("a.o")
	obj0.Machine = EM_X86_64
	obj0.Sections = make_slice(InputSection, 0)
	obj0.Symbols = syms0
	obj0.Relocs = make_slice(InputReloc, 0)
	// obj1: "shared" again, larger (size 16, align 16) — the merge must win.
	var syms1 @[]InputSymbol = make_slice(InputSymbol, 1)
	syms1[0] = mkCommon("shared", cast(uint, 16), cast(uint, 16))
	var obj1 @InputObject = make(InputObject)
	obj1.Path = buf.CopyStr("b.o")
	obj1.Machine = EM_X86_64
	obj1.Sections = make_slice(InputSection, 0)
	obj1.Symbols = syms1
	obj1.Relocs = make_slice(InputReloc, 0)
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = obj0
	objs[1] = obj1

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x1000))
	b.BeginSection(".bss", SF_READ | SF_WRITE)
	b.Place("*(COMMON)", false)
	b.EndSection()
	lr, err := b.Result()
	if len(err) != 0 { return fail("unexpected error") }

	// "a" first at 0x1000 (align 4); "shared" merged to size 16/align 16, so it aligns
	// up from 0x1004 to 0x1010.
	av, aok := builderAddr(b, lr, "a")
	if !aok || av != cast(uint64, 0x1000) { return fail("a should be at 0x1000") }
	sv, sok := builderAddr(b, lr, "shared")
	if !sok || sv != cast(uint64, 0x1010) { return fail("shared should align to 0x1010") }
	if len(b.AbsSyms()) != 0 {
		return fail("the commons must be object definitions, not layout symbols")
	}
	// Section spans 0x1000..0x1020 (shared ends at 0x1010+16) and is NOBITS (no data).
	if lr.Sections[0].Size != cast(uint64, 0x20) { return fail("section size should be 0x20") }
	if len(lr.Sections[0].Data) != 0 { return fail("a pure-COMMON section should be NOBITS") }
	return ""
}

// A real definition of a name supersedes a common of the same name: the common is not
// allocated, and the reference binds to the real definition.
func TestPlaceCommonRealDefWins() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 4)
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".data", SF_READ | SF_WRITE, SHT_PROGBITS, dt, cast(uint, 4), 1)
	var syms @[]InputSymbol = make_slice(InputSymbol, 2)
	syms[0] = mkSym("x", 0, BIND_GLOBAL) // real definition of x, in .data
	syms[1] = mkCommon("x", cast(uint, 8), cast(uint, 8)) // tentative def of x — superseded
	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr("x.o")
	obj.Machine = EM_X86_64
	obj.Sections = secs
	obj.Symbols = syms
	obj.Relocs = make_slice(InputReloc, 0)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x1000))
	b.BeginSection(".data", SF_READ | SF_WRITE)
	b.Place("*(.data*)", false)
	b.EndSection()
	b.SetDot(cast(uint64, 0x2000))
	b.BeginSection(".bss", SF_READ | SF_WRITE)
	b.Place("*(COMMON)", false)
	b.EndSection()
	lr, err := b.Result()
	if len(err) != 0 { return fail("unexpected error") }
	xv, xok := builderAddr(b, lr, "x")
	if !xok || xv != cast(uint64, 0x1000) {
		return fail("x must resolve to its real definition in .data")
	}
	if lr.Sections[1].Size != 0 { return fail("the superseded common must not be allocated") }
	return ""
}

// A file-local definition of a name (C `static int x;`, binding local) does NOT
// supersede a GLOBAL common of the same name — they are distinct objects — so the
// common must still be allocated (a local match would leave the global unresolvable).
func TestPlaceCommonLocalDefDoesNotSuppress() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 4)
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".data", SF_READ | SF_WRITE, SHT_PROGBITS, dt, cast(uint, 4), 1)
	var syms0 @[]InputSymbol = make_slice(InputSymbol, 1)
	syms0[0] = mkSym("counter", 0, 0) // file-local def in .data (binding 0 = local)
	var obj0 @InputObject = make(InputObject)
	obj0.Path = buf.CopyStr("a.o")
	obj0.Machine = EM_X86_64
	obj0.Sections = secs
	obj0.Symbols = syms0
	obj0.Relocs = make_slice(InputReloc, 0)
	var syms1 @[]InputSymbol = make_slice(InputSymbol, 1)
	syms1[0] = mkCommon("counter", cast(uint, 8), cast(uint, 8)) // global tentative def
	var obj1 @InputObject = make(InputObject)
	obj1.Path = buf.CopyStr("b.o")
	obj1.Machine = EM_X86_64
	obj1.Sections = make_slice(InputSection, 0)
	obj1.Symbols = syms1
	obj1.Relocs = make_slice(InputReloc, 0)
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = obj0
	objs[1] = obj1

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x2000))
	b.BeginSection(".bss", SF_READ | SF_WRITE)
	b.Place("*(COMMON)", false)
	b.EndSection()
	lr, err := b.Result()
	if len(err) != 0 { return fail("unexpected error") }
	cv, cok := builderAddr(b, lr, "counter")
	if !cok { return fail("a local same-name def must not suppress the global common") }
	if cv != cast(uint64, 0x2000) { return fail("counter should be allocated at 0x2000") }
	return ""
}

// A name already defined via DefineSymbol is not allocated as a common: the explicit value
// stands, and the common gets no storage.
func TestPlaceCommonSkipsAlreadyDefined() testing.TestResult {
	var syms @[]InputSymbol = make_slice(InputSymbol, 1)
	syms[0] = mkCommon("y", cast(uint, 8), cast(uint, 8))
	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr("y.o")
	obj.Machine = EM_X86_64
	obj.Sections = make_slice(InputSection, 0)
	obj.Symbols = syms
	obj.Relocs = make_slice(InputReloc, 0)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.DefineSymbol("y", cast(uint64, 0xbeef))
	b.SetDot(cast(uint64, 0x1000))
	b.BeginSection(".bss", SF_READ | SF_WRITE)
	b.Place("*(COMMON)", false)
	b.EndSection()
	yv, yok := absValue(b.AbsSyms(), "y")
	if !yok || yv != cast(uint64, 0xbeef) { return fail("the DefineSymbol value must stand") }
	lr, lerr := b.Result()
	if len(lerr) != 0 { return fail("unexpected error") }
	if lr.Sections[0].Size != 0 { return fail("y's common must get no storage") }
	t, rerr := b.Resolve()
	if len(rerr) != 0 { return fail(buf.Concat("resolve failed: ", rerr)) }
	_, _, objDef := t.Lookup("y")
	if objDef { return fail("y must not be allocated as a common beside its DefineSymbol value") }
	return ""
}

// A weak definition does not supersede a common: the common is allocated and every reference
// binds to it, the weak one's own included — as in GNU ld and lld, and bnld's whole-link
// drivers.
func TestPlaceCommonWeakDefLoses() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 4)
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".data", SF_READ | SF_WRITE, SHT_PROGBITS, dt, cast(uint, 4), 1)
	var syms0 @[]InputSymbol = make_slice(InputSymbol, 1)
	syms0[0] = mkSym("w", 0, BIND_WEAK) // weak definition of w, in .data
	var obj0 @InputObject = mkObjSecs(secs)
	obj0.Symbols = syms0
	var syms1 @[]InputSymbol = make_slice(InputSymbol, 1)
	syms1[0] = mkCommon("w", cast(uint, 4), cast(uint, 4))
	var obj1 @InputObject = mkObjSecs(make_slice(InputSection, 0))
	obj1.Symbols = syms1
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = obj0
	objs[1] = obj1

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x1000))
	b.BeginSection(".data", SF_READ | SF_WRITE)
	b.Place("*(.data*)", false)
	b.EndSection()
	b.SetDot(cast(uint64, 0x2000))
	b.BeginSection(".bss", SF_READ | SF_WRITE)
	b.Place("*(COMMON)", false)
	b.EndSection()
	lr, err := b.Result()
	if len(err) != 0 { return fail("unexpected error") }
	t, rerr := b.Resolve()
	if len(rerr) != 0 { return fail(buf.Concat("resolve failed: ", rerr)) }
	wv, wok := symbolAddr(t, lr, 0, 0) // obj0's own weak w
	if !wok || wv != cast(uint64, 0x2000) { return fail("w must resolve to the allocated common") }
	return ""
}

// A script's definition of a common's name made after the `*(COMMON)` placement still wins, as
// a GNU ld or lld script assignment does: a driver's DefineSymbol after its .bss block, and a
// declarative script's AbsSyms (which CompileScript applies after every section) — so a C
// `volatile uint32_t UART0_DR;` common resolves to the device address the script gives it.
func TestPlaceCommonLaterScriptDefinitionWins() testing.TestResult {
	var syms @[]InputSymbol = make_slice(InputSymbol, 2)
	syms[0] = mkCommon("y", cast(uint, 8), cast(uint, 8))
	syms[1] = mkCommon("UART0_DR", cast(uint, 4), cast(uint, 4))
	var obj @InputObject = mkObjSecs(make_slice(InputSection, 0))
	obj.Symbols = syms
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x1000))
	b.BeginSection(".bss", SF_READ | SF_WRITE)
	b.Place("*(COMMON)", false)
	b.EndSection()
	b.DefineSymbol("y", cast(uint64, 0xbeef)) // after the placement
	t, rerr := b.Resolve()
	if len(rerr) != 0 { return fail(buf.Concat("resolve failed: ", rerr)) }
	_, _, yObj := t.Lookup("y")
	if yObj { return fail("y's common still defines it over the later DefineSymbol") }
	_, _, uObj := t.Lookup("UART0_DR")
	if !uObj { return fail("UART0_DR, which the script does not define, lost its common") }

	var dobj @InputObject = mkObjSecs(make_slice(InputSection, 0))
	dobj.Symbols = @[]InputSymbol{mkCommon("UART0_DR", cast(uint, 4), cast(uint, 4))}
	var d @LayoutBuilder = NewLayout(EM_X86_64)
	d.SetInputs(@[]@InputObject{dobj})
	var bss SectionSpec
	bss.Name = buf.CopyStr(".bss")
	bss.Flags = SF_READ | SF_WRITE
	bss.Items = @[]ScriptItem{Place("*(COMMON)", false)}
	var script LayoutScript
	script.HasStartDot = true
	script.StartDot = cast(uint64, 0x2000)
	script.Sections = @[]SectionSpec{bss}
	var uart AbsSymSpec
	uart.Name = buf.CopyStr("UART0_DR")
	uart.Value = cast(uint64, 0x101f1000)
	script.AbsSyms = @[]AbsSymSpec{uart}
	if len(CompileScript(d, script)) != 0 { return fail("CompileScript returned an error") }
	dt, derr := d.Resolve()
	if len(derr) != 0 { return fail(buf.Concat("resolve failed: ", derr)) }
	_, _, dObj := dt.Lookup("UART0_DR")
	uv, uok := absValue(d.AbsSyms(), "UART0_DR")
	if dObj || !uok || uv != cast(uint64, 0x101f1000) {
		return fail("the script's UART0_DR does not win over the common")
	}
	return ""
}

// A common the linker-made commons object rejects (an alignment that is not a power of two)
// fails the layout with the `*(COMMON)` placement named.
func TestPlaceCommonErrorIsReported() testing.TestResult {
	var obj @InputObject = mkObjSecs(make_slice(InputSection, 0))
	obj.Symbols = @[]InputSymbol{mkCommon("odd", cast(uint, 4), cast(uint, 3))}
	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(@[]@InputObject{obj})
	b.SetDot(cast(uint64, 0x1000))
	b.BeginSection(".bss", SF_READ | SF_WRITE)
	b.Place("*(COMMON)", false)
	b.EndSection()
	var want *[]readonly char = "*(COMMON): common symbol odd has an alignment"
	var e @[]readonly char = b.Error()
	if len(e) < len(want) || !charsEqual(e[0:len(want)], want) {
		return fail(buf.Concat("wrong error: ", e))
	}
	return ""
}

// End to end: a relocation referencing a common symbol is patched to the address the
// *(COMMON) placement synthesized for it.
func TestFinishCommonReferenceResolves() testing.TestResult {
	var textData @[]uint8 = make_slice(uint8, 8) // ABS64 slot
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, textData, cast(uint, 8), 1)
	var syms @[]InputSymbol = make_slice(InputSymbol, 1)
	syms[0] = mkCommon("cvar", cast(uint, 8), cast(uint, 8))
	var relocs @[]InputReloc = make_slice(InputReloc, 1)
	relocs[0] = mkReloc(0, cast(uint, 0), 0, R_X86_64_64, 0)
	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr("x.o")
	obj.Machine = EM_X86_64
	obj.Sections = secs
	obj.Symbols = syms
	obj.Relocs = relocs
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x400000))
	b.BeginSection(".text", SF_READ | SF_EXEC)
	b.Place("*(.text*)", false)
	b.EndSection()
	b.SetDot(cast(uint64, 0x402000))
	b.BeginSection(".bss", SF_READ | SF_WRITE)
	b.Place("*(COMMON)", false)
	b.EndSection()
	if len(b.Finish()) != 0 { return fail("Finish should resolve the common reference") }
	// cvar allocated at 0x402000; the ABS64 slot in .text now holds it.
	var d @[]uint8 = b.result.Sections[0].Data
	if d[0] != 0x00 || d[1] != 0x20 || d[2] != 0x40 || d[3] != 0x00 {
		return fail("the relocation should be patched to cvar's address (0x402000)")
	}
	return ""
}

// A common reference with NO *(COMMON) placement is a hard error (the strict-orphan
// policy): the driver did not allocate it, so it stays undefined.
func TestFinishUnplacedCommonErrors() testing.TestResult {
	var textData @[]uint8 = make_slice(uint8, 8)
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, textData, cast(uint, 8), 1)
	var syms @[]InputSymbol = make_slice(InputSymbol, 1)
	syms[0] = mkCommon("cvar", cast(uint, 8), cast(uint, 8))
	var relocs @[]InputReloc = make_slice(InputReloc, 1)
	relocs[0] = mkReloc(0, cast(uint, 0), 0, R_X86_64_64, 0)
	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr("x.o")
	obj.Machine = EM_X86_64
	obj.Sections = secs
	obj.Symbols = syms
	obj.Relocs = relocs
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x400000))
	b.BeginSection(".text", SF_READ | SF_EXEC)
	b.Place("*(.text*)", false) // *(COMMON) deliberately never placed
	b.EndSection()
	if len(b.Finish()) == 0 { return fail("an unplaced common reference must be a hard error") }
	return ""
}
