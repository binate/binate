package "pkg/binate/link"

import "pkg/binate/buf"

// The scripted layout's unwind tables: PlaceEhFrame places the inputs' `.eh_frame` with the
// terminator that ends them, PlaceEhFrameHdr their search table (ehframe_hdr.bn), each between
// the bracketing symbols a bare-metal unwinder (LLVM libunwind's) finds them by; Finish fills
// the table and EmitElf gives it its PT_GNU_EH_FRAME header.  PlaceArmExidx places arm32's
// unwind index (arm_exidx.bn) between `__exidx_start` and `__exidx_end`, which EmitElf gives
// PT_ARM_EXIDX.

// builderEh is a layout's unwind-table placement: whether PlaceEhFrame, PlaceEhFrameHdr and
// PlaceArmExidx have run, the section and the offsets in it of the records PlaceEhFrame placed
// (framesStart to framesEnd), the number of code sections the unwind index covers (exidxCode),
// and where the search table and the index lie (Sec -1 for none: no call, or nothing among the
// inputs to place).
type builderEh struct {
	placedFrames bool
	placedHdr    bool
	placedExidx  bool
	exidxCode    int
	framesSec    int
	framesStart  uint64
	framesEnd    uint64
	hdr          secSpan
	exidx        secSpan
}

// PlaceEhFrame places in the open section every input's unwind tables (`*(.eh_frame)`, kept),
// then the zero terminator that ends them (crtend.o's `__FRAME_END__` in a C compiler's link),
// between `__eh_frame_start` and `__eh_frame_end` — the start aligned for the records, so it is
// the first one's address.  A second call is an error.
func (b @LayoutBuilder) PlaceEhFrame() {
	if b.cur < 0 { b.fail("PlaceEhFrame: no open section"); return }
	if b.eh.placedFrames { b.fail("PlaceEhFrame: the unwind tables are already placed"); return }
	b.eh.placedFrames = true
	var any bool = false
	var align int = 1
	for o := 0; o < len(b.inputs); o++ {
		for s := 0; s < len(b.inputs[o].Sections); s++ {
			var sec InputSection = b.inputs[o].Sections[s]
			if b.consumed[o][s] || !isEhFrame(sec.Name) || sec.Size == 0 { continue }
			any = true
			if sec.Align > align { align = sec.Align }
		}
	}
	b.AlignDot(align)
	b.ensureStarted()
	if align > b.secs[b.cur].Align { b.secs[b.cur].Align = align }
	b.SymbolAtDot("__eh_frame_start")
	b.eh.framesSec = b.cur
	b.eh.framesStart = b.dot - b.secs[b.cur].VmaStart
	b.Place("*(.eh_frame)", true)
	b.eh.framesEnd = b.dot - b.secs[b.cur].VmaStart
	if any {
		b.AlignDot(4)
		b.EmitData(make_slice(uint8, 4))
	}
	b.SymbolAtDot("__eh_frame_end")
}

// PlaceEhFrameHdr places in the open section the unwind tables' search table (`.eh_frame_hdr`),
// sized for every input's FDEs and 4-aligned, between `__eh_frame_hdr_start` and
// `__eh_frame_hdr_end`: Finish fills it, requiring PlaceEhFrame to have placed every input's
// `.eh_frame` (the table points at those records); EmitElf gives it a PT_GNU_EH_FRAME header when
// it derives the segments.  With no non-empty `.eh_frame` among the inputs it places nothing.  A
// record it cannot read, or a second call, is an error.
func (b @LayoutBuilder) PlaceEhFrameHdr() {
	if b.cur < 0 { b.fail("PlaceEhFrameHdr: no open section"); return }
	if b.eh.placedHdr { b.fail("PlaceEhFrameHdr: the search table is already placed"); return }
	b.eh.placedHdr = true
	b.ensureStarted()
	n, any, err := countEhFrameFdes(b.inputs)
	if len(err) != 0 { b.fail(buf.Concat("PlaceEhFrameHdr: ", err)); return }
	b.AlignDot(4)
	b.SymbolAtDot("__eh_frame_hdr_start")
	if any {
		if b.secs[b.cur].Align < 4 { b.secs[b.cur].Align = 4 }
		b.eh.hdr.Sec = b.cur
		b.eh.hdr.Off = b.dot - b.secs[b.cur].VmaStart
		b.eh.hdr.Size = ehFrameHdrSize + 8 * n
		b.EmitData(make_slice(uint8, b.eh.hdr.Size))
	}
	b.SymbolAtDot("__eh_frame_hdr_end")
}

// unplacedEhFrameError returns why the layout cannot finish when it placed the search table, or
// "": every input's `.eh_frame` with contents must be among the records PlaceEhFrame placed —
// the table counts their FDEs and points at them, and PlaceEhFrame ends them with the terminator
// an unwinder walking them stops at — so one unplaced, or placed by another call, is an error.
func (b @LayoutBuilder) unplacedEhFrameError() @[]readonly char {
	if b.eh.hdr.Sec < 0 { return "" }
	if !b.eh.placedFrames {
		return "the layout places .eh_frame_hdr but not the unwind tables it indexes (PlaceEhFrame "
				"places them)"
	}
	for o := 0; o < len(b.inputs); o++ {
		for s := 0; s < len(b.inputs[o].Sections); s++ {
			var sec InputSection = b.inputs[o].Sections[s]
			if sec.Size == 0 || !isEhFrame(sec.Name) { continue }
			if !b.consumed[o][s] {
				return buf.Concat(b.inputs[o].Path,
						": .eh_frame is not placed, though .eh_frame_hdr counts its FDEs (PlaceEhFrame "
								"places the unwind tables)")
			}
			var off uint64 = cast(uint64, sec.OutOffset)
			if sec.OutIndex != b.eh.framesSec || off < b.eh.framesStart || off >= b.eh.framesEnd {
				return buf.Concat(b.inputs[o].Path,
						": .eh_frame is placed apart from the unwind tables PlaceEhFrame placed, which "
								".eh_frame_hdr points at")
			}
		}
	}
	return ""
}

// fillBuilderEhHdr fills the layout's search table (PlaceEhFrameHdr), if it placed one, in the
// relocated output lr.
func (b @LayoutBuilder) fillBuilderEhHdr(lr @LayoutResult) @[]readonly char {
	if b.eh.hdr.Sec < 0 { return "" }
	var hdr @InputObject = make(InputObject)
	hdr.Path = buf.CopyStr("<linker-made .eh_frame_hdr>")
	hdr.Machine = b.Machine
	hdr.Sections = make_slice(InputSection, 1)
	hdr.Sections[0] = mkDynSection(".eh_frame_hdr", SF_READ, 4, make_slice(uint8, b.eh.hdr.Size))
	hdr.Sections[0].OutIndex = b.eh.hdr.Sec
	hdr.Sections[0].OutOffset = cast(uint, b.eh.hdr.Off)
	hdr.Symbols = make_slice(InputSymbol, 0)
	hdr.Relocs = make_slice(InputReloc, 0)
	return fillEhFrameHdr(b.inputs, lr, hdr, b.Machine)
}

// PlaceArmExidx places in the open section arm32's unwind index, between `__exidx_start` and
// `__exidx_end`: walking the placed code in address order, each code section's `.ARM.exidx`
// inputs, or a synthesized EXIDX_CANTUNWIND entry for one with none, then a CANTUNWIND sentinel
// at the end of the code (as Layout merges it, arm_exidx.bn).  The index covers the code placed
// so far: an index of code never placed is dropped with it, and Finish rejects code placed after
// (unwindIndexError).  With no index among the inputs it places nothing.  It may run once.
func (b @LayoutBuilder) PlaceArmExidx() {
	if b.cur < 0 { b.fail("PlaceArmExidx: no open section"); return }
	if b.eh.placedExidx { b.fail("PlaceArmExidx: the unwind index is already placed"); return }
	b.eh.placedExidx = true
	b.eh.exidxCode = b.placedCodeCount()
	var any bool = false
	for o := 0; o < len(b.inputs); o++ {
		for s := 0; s < len(b.inputs[o].Sections); s++ {
			var sec InputSection = b.inputs[o].Sections[s]
			if !b.consumed[o][s] && isArmExidx(sec.Type, sec.Link) && b.isPlacedCode(o, sec.Link) {
				any = true
			}
		}
	}
	b.AlignDot(4)
	b.SymbolAtDot("__exidx_start")
	if any {
		b.ensureStarted()
		if b.secs[b.cur].Align < 4 { b.secs[b.cur].Align = 4 }
		var start uint64 = b.dot - b.secs[b.cur].VmaStart
		b.placeExidxEntries()
		b.eh.exidx.Sec = b.cur
		b.eh.exidx.Off = start
		b.eh.exidx.Size = cast(int, b.dot - b.secs[b.cur].VmaStart - start)
	}
	b.SymbolAtDot("__exidx_end")
}

// placeExidxEntries places, at dot, the index entries of every placed code section in address
// order — its `.ARM.exidx` inputs, or a CANTUNWIND entry — then the sentinel (PlaceArmExidx).
func (b @LayoutBuilder) placeExidxEntries() {
	var n int = 0
	for o := 0; o < len(b.inputs); o++ {
		for s := 0; s < len(b.inputs[o].Sections); s++ { if b.isPlacedCode(o, s) { n = n + 1 } }
	}
	// addrs[k] is the address of the placed code section secs[k] of input objs[k]; sortByKey puts
	// addrs in order, carrying each one's k in ks.
	var objs @[]int = make_slice(int, n)
	var secs @[]int = make_slice(int, n)
	var addrs @[]uint64 = make_slice(uint64, n)
	var ks @[]uint64 = make_slice(uint64, n)
	var k int = 0
	var codeEnd uint64 = 0
	for o := 0; o < len(b.inputs); o++ {
		for s := 0; s < len(b.inputs[o].Sections); s++ {
			if !b.isPlacedCode(o, s) { continue }
			var sec InputSection = b.inputs[o].Sections[s]
			objs[k] = o
			secs[k] = s
			addrs[k] = b.secs[sec.OutIndex].VmaStart + cast(uint64, sec.OutOffset)
			ks[k] = cast(uint64, k)
			var end uint64 = addrs[k] + cast(uint64, sec.Size)
			if end > codeEnd { codeEnd = end }
			k = k + 1
		}
	}
	sortByKey(addrs, ks)
	var firsts @[]@[]int = make_slice(@[]int, len(b.inputs))
	var nexts @[]@[]int = make_slice(@[]int, len(b.inputs))
	for o := 0; o < len(b.inputs); o++ {
		first, next := exidxChains(b.inputs[o])
		firsts[o] = first
		nexts[o] = next
	}
	for i := 0; i < n; i++ {
		var o int = objs[cast(int, ks[i])]
		var s int = secs[cast(int, ks[i])]
		if b.inputs[o].Sections[s].Size == 0 { continue }
		var indexed bool = false
		for x := firsts[o][s]; x >= 0; x = nexts[o][x] {
			if b.consumed[o][x] { continue }
			b.placeInput(o, x)
			indexed = true
		}
		if !indexed { b.emitCantUnwind(addrs[i]) }
	}
	b.emitCantUnwind(codeEnd)
	b.secs[b.cur].Size = b.dot - b.secs[b.cur].VmaStart
}

// isPlacedCode reports whether section s of input o is code the layout has placed.
func (b @LayoutBuilder) isPlacedCode(o int, s int) bool {
	var sec InputSection = b.inputs[o].Sections[s]
	return b.consumed[o][s] && sec.OutIndex >= 0 && (sec.Flags & SF_EXEC) != 0
}

// emitCantUnwind emits at dot (4-aligned) an EXIDX_CANTUNWIND entry for the code at target,
// failing for code beyond a PREL31 offset's reach.
func (b @LayoutBuilder) emitCantUnwind(target uint64) {
	b.AlignDot(4)
	var e @[]uint8 = make_slice(uint8, 8)
	if !putCantUnwind(e, 0, target, b.dot) { b.fail(buf.Concat("PlaceArmExidx: ", exidxRangeError())) }
	b.EmitData(e)
}

// unwindIndexError returns why the layout cannot finish for the unwind index, or "": with an
// index among the inputs, code placed after PlaceArmExidx is not in it — a PC there would fall
// into the entry of the code before it and be unwound with that code's opcodes.
func (b @LayoutBuilder) unwindIndexError() @[]readonly char {
	if !b.eh.placedExidx || b.placedCodeCount() == b.eh.exidxCode { return "" }
	for o := 0; o < len(b.inputs); o++ {
		for s := 0; s < len(b.inputs[o].Sections); s++ {
			var sec InputSection = b.inputs[o].Sections[s]
			if !isArmExidx(sec.Type, sec.Link) { continue }
			return "code is placed after PlaceArmExidx, so the unwind index does not cover it (place "
					"the index after all the code)"
		}
	}
	return ""
}

// placedCodeCount returns the number of code sections the layout has placed.
func (b @LayoutBuilder) placedCodeCount() int {
	var n int = 0
	for o := 0; o < len(b.inputs); o++ {
		for s := 0; s < len(b.inputs[o].Sections); s++ { if b.isPlacedCode(o, s) { n = n + 1 } }
	}
	return n
}

// refusesArmExidx reports — failing the layout — whether section s of input o, which a Place
// glob matched, is an arm32 unwind index: only PlaceArmExidx places one, sorted by its code
// and completed, where a glob would take its entries as plain bytes.
func (b @LayoutBuilder) refusesArmExidx(o int, s int) bool {
	var sec InputSection = b.inputs[o].Sections[s]
	if !isArmExidx(sec.Type, sec.Link) { return false }
	b.fail(
			buf.Concat(buf.Concat(buf.Concat(buf.Concat("Place: ", b.inputs[o].Path), ": "), sec.Name),
					" is an arm32 unwind index (PlaceArmExidx places it, sorted and completed)"))
	return true
}

// setExidxResult records in lr the unwind index PlaceArmExidx placed (Exidx, ExidxStart /
// ExidxEnd), or none.
func (b @LayoutBuilder) setExidxResult(lr @LayoutResult) {
	lr.Exidx = b.eh.exidx.Sec
	if lr.Exidx < 0 { return }
	lr.ExidxStart = b.secs[lr.Exidx].VmaStart + b.eh.exidx.Off
	lr.ExidxEnd = lr.ExidxStart + cast(uint64, b.eh.exidx.Size)
}
