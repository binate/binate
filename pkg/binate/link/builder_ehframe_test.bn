package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// The scripted layout's unwind tables (builder_ehframe.bn).  (ehFrameTestObject, phdrOf and
// rel32At are in ehframe_hdr_test.bn, textOnlyBuilder in builder_arrays_test.bn, absValue in
// builder_symbols_test.bn.)

// ehBuilder returns a builder over the object at path laying out .text at 0x400000 then, when
// hdr is set, a section holding the search table, then one holding the unwind tables when frames
// is set — or an error.
func ehBuilder(path *[]readonly char, hdr bool, frames bool) (@LayoutBuilder, @[]readonly char) {
	var none @LayoutBuilder
	obj, err := ReadObject(path)
	if len(err) != 0 { return none, err }
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	var b @LayoutBuilder = NewLayout(EM_AARCH64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x400000))
	b.BeginSection(".text", SF_READ | SF_EXEC)
	b.Place("*(.text*)", false)
	b.EndSection()
	if hdr {
		b.BeginSection(".eh_frame_hdr", SF_READ)
		b.PlaceEhFrameHdr()
		b.EndSection()
	}
	if frames {
		b.BeginSection(".eh_frame", SF_READ)
		b.PlaceEhFrame()
		b.EndSection()
	}
	b.SetEntry("_start")
	return b, ""
}

// A layout placing the search table and the unwind tables gets them filled, between their
// bracketing symbols, with PT_GNU_EH_FRAME over the table: one entry, for f, and the records
// ending with the terminator.
func TestBuilderEhFrame() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var path @[]char = ehFrameTestObject(dir)
	if len(path) == 0 { return fail("cannot write the object") }
	b, berr := ehBuilder(path, true, true)
	if len(berr) != 0 { return fail(buf.Concat("ehBuilder: ", berr)) }
	var err @[]readonly char = b.Finish()
	if len(err) != 0 { return fail(buf.Concat("Finish: ", err)) }
	var out @[]char = buf.Concat(dir, "/eh_builder")
	if len(b.EmitElf(out)) != 0 { return fail("EmitElf failed") }
	exe, ok := readFile(out)
	if !ok { return fail("cannot read the executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = exe
	off, va, sz, found := phdrOf(rd, PT_GNU_EH_FRAME)
	if !found || sz != ehFrameHdrSize + 8 || u32(rd, off + 8) != 1 {
		return fail("no one-entry table")
	}
	if rel32At(rd, off + 12) != bit_cast(int64, cast(uint64, 0x400004) - va) {
		return fail("the entry is not f's address")
	}
	hs, _ := absValue(b.AbsSyms(), "__eh_frame_hdr_start")
	he, _ := absValue(b.AbsSyms(), "__eh_frame_hdr_end")
	es, _ := absValue(b.AbsSyms(), "__eh_frame_start")
	ee, _ := absValue(b.AbsSyms(), "__eh_frame_end")
	if hs != va || he != va + cast(uint64, sz) { return fail("wrong __eh_frame_hdr_start / _end") }
	if es != va + cast(uint64, 4 + rel32At(rd, off + 4)) || ee != es + cast(uint64, 44) {
		return fail("wrong __eh_frame_start / _end")
	}
	var ehAt int = off + 4 + cast(int, rel32At(rd, off + 4))
	if u32(rd, ehAt) != 16 || u32(rd, ehAt + 4) != 0 { return fail("the pointer is not at the CIE") }
	if es % cast(uint64, 8) != 0 { return fail("__eh_frame_start is not aligned for the records") }
	if u32(rd, ehAt + 40) != 0 { return fail("the records do not end with the terminator") }
	return ""
}

// With the search table and the records in one section, the table's `.eh_frame` pointer and
// `__eh_frame_start` are the first record's address, past the table and the padding the
// records' alignment needs.
func TestBuilderEhFrameOneSection() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var path @[]char = ehFrameTestObject(dir)
	if len(path) == 0 { return fail("cannot write the object") }
	b, berr := ehBuilder(path, false, false)
	if len(berr) != 0 { return fail(buf.Concat("ehBuilder: ", berr)) }
	b.BeginSection(".eh", SF_READ)
	b.PlaceEhFrameHdr()
	b.PlaceEhFrame()
	b.EndSection()
	var err @[]readonly char = b.Finish()
	if len(err) != 0 { return fail(buf.Concat("Finish: ", err)) }
	var out @[]char = buf.Concat(dir, "/eh_one")
	if len(b.EmitElf(out)) != 0 { return fail("EmitElf failed") }
	exe, ok := readFile(out)
	if !ok { return fail("cannot read the executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = exe
	off, va, _, found := phdrOf(rd, PT_GNU_EH_FRAME)
	if !found { return fail("no PT_GNU_EH_FRAME") }
	var ehAt int = off + 4 + cast(int, rel32At(rd, off + 4))
	if u32(rd, ehAt) != 16 || u32(rd, ehAt + 4) != 0 { return fail("the pointer is not at the CIE") }
	es, _ := absValue(b.AbsSyms(), "__eh_frame_start")
	if es != va + cast(uint64, 4 + rel32At(rd, off + 4)) {
		return fail("__eh_frame_start is not the CIE")
	}
	return ""
}

// Placing the search table but not the unwind tables it counts fails Finish; with no FDE among
// the inputs the table places nothing and there is no PT_GNU_EH_FRAME; a second call of either
// is an error.
func TestBuilderEhFrameErrors() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var path @[]char = ehFrameTestObject(dir)
	if len(path) == 0 { return fail("cannot write the object") }
	b, berr := ehBuilder(path, true, false)
	if len(berr) != 0 { return fail(buf.Concat("ehBuilder: ", berr)) }
	var err @[]readonly char = b.Finish()
	if !startsWith(err, "the layout places .eh_frame_hdr but not the unwind tables") {
		return fail(buf.Concat("an unplaced .eh_frame: ", err))
	}
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, make_slice(uint8, 4), cast(uint, 4),
			4)
	objs[0] = mkObjSecs(secs)
	var c @LayoutBuilder = textOnlyBuilder(objs)
	c.BeginSection(".eh_frame_hdr", SF_READ)
	c.PlaceEhFrameHdr()
	c.EndSection()
	if len(c.Finish()) != 0 { return fail("a layout with no FDE failed") }
	hs, _ := absValue(c.AbsSyms(), "__eh_frame_hdr_start")
	he, _ := absValue(c.AbsSyms(), "__eh_frame_hdr_end")
	if hs != he { return fail("a search table placed for a layout with no FDE") }
	var out @[]char = buf.Concat(dir, "/eh_none")
	if len(c.EmitElf(out)) != 0 { return fail("EmitElf failed") }
	data, ok := readFile(out)
	if !ok { return fail("cannot read the executable") }
	_, _, _, found := phdrOf(data, PT_GNU_EH_FRAME)
	if found { return fail("a PT_GNU_EH_FRAME for a layout with no FDE") }
	var d @LayoutBuilder = textOnlyBuilder(objs)
	d.BeginSection(".x", SF_READ)
	d.PlaceEhFrame()
	es, _ := absValue(d.AbsSyms(), "__eh_frame_start")
	ee, _ := absValue(d.AbsSyms(), "__eh_frame_end")
	if es != ee { return fail("a terminator placed for a layout with no .eh_frame") }
	d.PlaceEhFrame()
	if !startsWith(d.Error(), "PlaceEhFrame: the unwind tables are already placed") {
		return fail("a second PlaceEhFrame was accepted")
	}
	var e @LayoutBuilder = textOnlyBuilder(objs)
	e.BeginSection(".x", SF_READ)
	e.PlaceEhFrameHdr()
	e.PlaceEhFrameHdr()
	if !startsWith(e.Error(), "PlaceEhFrameHdr: the search table is already placed") {
		return fail("a second PlaceEhFrameHdr was accepted")
	}
	return ""
}

// A script's EhFrameHdr and EhFrame items place the tables as the builder calls do.
func TestScriptEhFrameItems() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var path @[]char = ehFrameTestObject(dir)
	if len(path) == 0 { return fail("cannot write the object") }
	var script LayoutScript
	script.HasStartDot = true
	script.StartDot = cast(uint64, 0x400000)
	script.Entry = buf.CopyStr("_start")
	script.Sections = make_slice(SectionSpec, 3)
	script.Sections[0].Name = buf.CopyStr(".text")
	script.Sections[0].Flags = SF_READ | SF_EXEC
	script.Sections[0].Items = make_slice(ScriptItem, 1)
	script.Sections[0].Items[0] = Place("*(.text*)", false)
	script.Sections[1].Name = buf.CopyStr(".eh_frame_hdr")
	script.Sections[1].Flags = SF_READ
	script.Sections[1].Items = make_slice(ScriptItem, 1)
	script.Sections[1].Items[0] = EhFrameHdr()
	script.Sections[2].Name = buf.CopyStr(".eh_frame")
	script.Sections[2].Flags = SF_READ
	script.Sections[2].Items = make_slice(ScriptItem, 1)
	script.Sections[2].Items[0] = EhFrame()
	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = path
	var out @[]char = buf.Concat(dir, "/eh_script")
	var err @[]readonly char = LinkWithScript(paths, script, EM_AARCH64, out)
	if len(err) != 0 { return fail(buf.Concat("LinkWithScript: ", err)) }
	exe, ok := readFile(out)
	if !ok { return fail("cannot read the executable") }
	off, _, sz, found := phdrOf(exe, PT_GNU_EH_FRAME)
	if !found || sz != ehFrameHdrSize + 8 || u32(exe, off + 8) != 1 {
		return fail("no one-entry table")
	}
	return ""
}

// A search table whose records PlaceEhFrame did not place fails Finish: records placed by another
// call with no PlaceEhFrame, or placed apart from PlaceEhFrame's (an earlier glob consumed them).
func TestBuilderEhFrameHdrNeedsPlaceEhFrame() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var path @[]char = ehFrameTestObject(dir)
	if len(path) == 0 { return fail("cannot write the object") }
	b, berr := ehBuilder(path, true, false)
	if len(berr) != 0 { return fail(buf.Concat("ehBuilder: ", berr)) }
	b.BeginSection(".frames", SF_READ)
	b.Place("*(.eh_frame)", true)
	b.EndSection()
	var err @[]readonly char = b.Finish()
	if !startsWith(err, "the layout places .eh_frame_hdr but not the unwind tables") {
		return fail(buf.Concat("records not placed by PlaceEhFrame: ", err))
	}
	c, cerr := ehBuilder(path, true, false)
	if len(cerr) != 0 { return fail(buf.Concat("ehBuilder: ", cerr)) }
	c.BeginSection(".frames", SF_READ)
	c.Place("*(.eh_frame)", true)
	c.PlaceEhFrame()
	c.EndSection()
	err = c.Finish()
	if !startsWith(err, buf.Concat(path, ": .eh_frame is placed apart from the unwind tables")) {
		return fail(buf.Concat("records placed apart from PlaceEhFrame's: ", err))
	}
	return ""
}

// exidxBuilder returns an arm32 builder over objs placing their .text at 0x10000 and then, in
// a section of its own, the unwind index.
func exidxBuilder(objs @[]@InputObject) @LayoutBuilder {
	var b @LayoutBuilder = NewLayout(EM_ARM)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x10000))
	b.BeginSection(".text", SF_READ | SF_EXEC)
	b.Place("*(.text*)", false)
	b.EndSection()
	b.BeginSection(".ARM.exidx", SF_READ)
	b.PlaceArmExidx()
	b.EndSection()
	return b
}

// PlaceArmExidx merges the index as Layout does — each code section's entries in code order, a
// CANTUNWIND entry for code with none, a sentinel at the end of the code — between
// `__exidx_start` and `__exidx_end`, and EmitElf gives it PT_ARM_EXIDX.
func TestBuilderArmExidx() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var objs @[]@InputObject = make_slice(@InputObject, 3)
	objs[0] = exidxObj(8, true, 0x0a)
	objs[1] = exidxObj(4, false, 0)
	objs[2] = exidxObj(8, true, 0x0c)
	var b @LayoutBuilder = exidxBuilder(objs)
	var err @[]readonly char = b.Finish()
	if len(err) != 0 { return fail(buf.Concat("Finish: ", err)) }
	lr, _ := b.Result()
	if lr.Exidx != 1 || lr.ExidxStart != lr.Sections[1].Addr {
		return fail("the result reports no index")
	}
	var text OutputSection = lr.Sections[0]
	var x OutputSection = lr.Sections[1]
	if x.Size != cast(uint64, 32) { return fail("not four entries") }
	if u32(x.Data, 4) != 0x0a || u32(x.Data, 20) != 0x0c {
		return fail("the inputs are not in code order")
	}
	if prel31At(x, 8) != text.Addr + cast(uint64, 8) ||
			u32(x.Data, 12) != cast(int64, EXIDX_CANTUNWIND) {
		return fail("no CANTUNWIND entry for the code with no index")
	}
	if prel31At(x, 24) != text.Addr + text.Size || u32(x.Data, 28) != cast(int64, EXIDX_CANTUNWIND) {
		return fail("no CANTUNWIND sentinel at the end of the code")
	}
	xs, _ := absValue(b.AbsSyms(), "__exidx_start")
	xe, _ := absValue(b.AbsSyms(), "__exidx_end")
	if xs != x.Addr || xe != x.Addr + cast(uint64, 32) { return fail("wrong __exidx_start / _end") }
	var out @[]char = buf.Concat(dir, "/exidx_builder")
	if len(b.EmitElf(out)) != 0 { return fail("EmitElf failed") }
	exe, ok := readFile(out)
	if !ok { return fail("cannot read the executable") }
	_, va, sz, found := phdr32Of(exe, PT_ARM_EXIDX)
	if !found || va != x.Addr || sz != 32 { return fail("no PT_ARM_EXIDX over the index") }
	return ""
}

// Code placed after the index is not in it, which Finish rejects; a Place glob does not take an
// index; with no index among the inputs it places nothing; a second call is an error; and the
// script item places it as the call does.
func TestBuilderArmExidxErrors() testing.TestResult {
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = exidxObj(8, true, 0x0a)
	var b @LayoutBuilder = NewLayout(EM_ARM)
	b.SetInputs(objs)
	b.BeginSection(".ARM.exidx", SF_READ)
	b.PlaceArmExidx()
	b.EndSection()
	b.BeginSection(".text", SF_READ | SF_EXEC)
	b.Place("*(.text*)", false)
	b.EndSection()
	if !startsWith(b.Finish(), "code is placed after PlaceArmExidx") {
		return fail("code placed after the index was accepted")
	}
	var g @LayoutBuilder = NewLayout(EM_ARM)
	g.SetInputs(objs)
	g.BeginSection(".x", SF_READ)
	g.Place("*(.ARM.exidx*)", false)
	if !startsWith(g.Error(), "Place: x.o: .ARM.exidx is an arm32 unwind index") {
		return fail(buf.Concat("a glob took the index: ", g.Error()))
	}
	var plain @[]@InputObject = make_slice(@InputObject, 1)
	plain[0] = exidxObj(8, false, 0)
	var c @LayoutBuilder = exidxBuilder(plain)
	if len(c.Finish()) != 0 { return fail("a layout with no index failed") }
	xs, _ := absValue(c.AbsSyms(), "__exidx_start")
	xe, _ := absValue(c.AbsSyms(), "__exidx_end")
	if xs != xe { return fail("an index placed for a layout with no index") }
	c.BeginSection(".again", SF_READ)
	c.PlaceArmExidx()
	if !startsWith(c.Error(), "PlaceArmExidx: the unwind index is already placed") {
		return fail("a second PlaceArmExidx was accepted")
	}
	var d @LayoutBuilder = NewLayout(EM_ARM)
	d.SetInputs(objs)
	var script LayoutScript
	script.HasStartDot = true
	script.StartDot = cast(uint64, 0x10000)
	script.Sections = make_slice(SectionSpec, 2)
	script.Sections[0].Name = buf.CopyStr(".text")
	script.Sections[0].Flags = SF_READ | SF_EXEC
	script.Sections[0].Items = make_slice(ScriptItem, 1)
	script.Sections[0].Items[0] = Place("*(.text*)", false)
	script.Sections[1].Name = buf.CopyStr(".ARM.exidx")
	script.Sections[1].Flags = SF_READ
	script.Sections[1].Items = make_slice(ScriptItem, 1)
	script.Sections[1].Items[0] = ArmExidx()
	if len(CompileScript(d, script)) != 0 || len(d.Finish()) != 0 { return fail("the script failed") }
	lr, _ := d.Result()
	if len(lr.Sections) != 2 || lr.Sections[1].Size != cast(uint64, 16) {
		return fail("the script item did not place the entry and the sentinel")
	}
	return ""
}

// The index follows the code's addresses, not the order the layout placed it in: code placed
// high first and low second gets the low code's entry first; and code beyond a PREL31 offset's
// reach of its entry is an error.
func TestBuilderArmExidxAddressOrder() testing.TestResult {
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = exidxObj(8, true, 0x0a)
	objs[1] = exidxObj(8, true, 0x0b)
	objs[1].Sections[0].Name = buf.CopyStr(".text.lo")
	var b @LayoutBuilder = NewLayout(EM_ARM)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x20000))
	b.BeginSection(".hi", SF_READ | SF_EXEC)
	b.Place("*(.text)", false)
	b.EndSection()
	b.SetDot(cast(uint64, 0x10000))
	b.BeginSection(".lo", SF_READ | SF_EXEC)
	b.Place("*(.text.lo)", false)
	b.EndSection()
	b.SetDot(cast(uint64, 0x30000))
	b.BeginSection(".ARM.exidx", SF_READ)
	b.PlaceArmExidx()
	b.EndSection()
	if len(b.Finish()) != 0 { return fail(buf.Concat("Finish: ", b.Error())) }
	lr, _ := b.Result()
	var x OutputSection = lr.Sections[2]
	if u32(x.Data, 4) != 0x0b || u32(x.Data, 12) != 0x0a { return fail("not in address order") }
	if prel31At(x, 16) != cast(uint64, 0x20008) {
		return fail("the sentinel is not at the end of the code")
	}
	var far @[]@InputObject = make_slice(@InputObject, 2)
	far[0] = exidxObj(8, false, 0)
	far[1] = exidxObj(4, true, 0x0a)
	var c @LayoutBuilder = NewLayout(EM_ARM)
	c.SetInputs(far)
	c.SetDot(cast(uint64, 0x90000000))
	c.BeginSection(".text", SF_READ | SF_EXEC)
	c.Place("*(.text*)", false)
	c.EndSection()
	c.SetDot(cast(uint64, 0x08000000))
	c.BeginSection(".ARM.exidx", SF_READ)
	c.PlaceArmExidx()
	if !startsWith(c.Error(), "PlaceArmExidx: code is beyond a PREL31") {
		return fail(buf.Concat("an entry out of PREL31 reach: ", c.Error()))
	}
	return ""
}
