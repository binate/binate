package "pkg/binate/link"

import "pkg/binate/buf"

// The scripted-layout builder's emit surface: Finish (resolve + relocate the frozen
// layout) followed by a choice of output format (EmitElf / EmitRawBinary).  Choosing
// the format after layout lets the same laid-out image emit as an ELF executable or a
// flat binary — a driver targeting a boot ROM emits raw, one targeting a hosted or
// higher-half OS emits ELF, off the same placement code.

// Finish freezes the layout for emit: it materializes the output sections (Result),
// builds the cross-object symbol table with the layout-defined absolute symbols
// injected (Resolve), resolves the program entry address, and patches every
// relocation into the merged output-section bytes (Relocate).  It must run before
// EmitElf / EmitRawBinary.  The entry is an explicit address if one was set, else the
// address of the entry symbol (an object definition or a layout-defined absolute
// symbol), else 0 (unset — valid for a raw image with no ELF entry).  Returns "" on
// success, or a non-empty error: a latched layout error, an undefined symbol or entry,
// or an out-of-range relocation.
func (b @LayoutBuilder) Finish() @[]readonly char {
	lr, lerr := b.Result()
	if len(lerr) != 0 { return lerr }
	t, rerr := b.Resolve()
	if len(rerr) != 0 { return rerr }

	var ea uint64 = cast(uint64, 0)
	if b.hasEntryAddr {
		ea = b.entryAddr
	} else if len(b.entry) > 0 {
		oo, ss, found := t.Lookup(b.entry)
		if found {
			addr, ok := symbolAddr(t, lr, oo, ss)
			if !ok { return buf.Concat("entry symbol has no address: ", b.entry) }
			ea = addr
		} else {
			av, aok := t.lookupAbs(b.entry)
			if !aok { return buf.Concat("entry symbol not defined: ", b.entry) }
			ea = av
		}
	}

	var perr @[]readonly char = Relocate(t, lr)
	if len(perr) != 0 { return perr }

	b.result = lr
	b.finalEntry = ea
	b.finished = true
	return ""
}

// EmitElf writes the finished layout as a static ELF64 executable, carrying p_paddr =
// LMA for any LMA≠VMA (ROM-copy / higher-half) section.  Finish must have run.
func (b @LayoutBuilder) EmitElf(out *[]readonly char) @[]readonly char {
	if !b.finished { return "EmitElf: call Finish first" }
	return EmitElfExec(b.result.Sections, b.finalEntry, b.Machine, out)
}

// EmitRawBinary writes the finished layout as a flat binary (section bytes packed by
// LMA, no container).  Finish must have run.
func (b @LayoutBuilder) EmitRawBinary(out *[]readonly char) @[]readonly char {
	if !b.finished { return "EmitRawBinary: call Finish first" }
	return EmitRawBinaryImage(b.result.Sections, out)
}
