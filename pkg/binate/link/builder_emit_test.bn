package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// (mkSection is in layout_test.bn, mkSym in resolve_test.bn, fail in parse_elf_test.bn,
// fileOff / u16 / u64 / readFile in the package — all same package.)

// mkReloc builds an InputReloc.
func mkReloc(secIdx int, off uint, symIdx int, kind int, addend int) InputReloc {
	var r InputReloc
	r.SecIndex = secIdx
	r.Offset = off
	r.SymIndex = symIdx
	r.Kind = kind
	r.Addend = addend
	return r
}

// A full driver pass — place .text and a page-separated .data, resolve _start, then
// Finish + EmitElf — patches an absolute relocation to its target's VMA and records
// the entry.  The .text holds an R_X86_64_64 pointing at `target` in .data; after
// Finish the eight relocated bytes read back as .data's run-time address.
func TestBuilderFinishEmitElf() testing.TestResult {
	var textData @[]uint8 = make_slice(uint8, 8) // 8-byte slot for the ABS64 reloc
	var dataData @[]uint8 = make_slice(uint8, 4)
	dataData[0] = 0x99
	var secs @[]InputSection = make_slice(InputSection, 2)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, textData, cast(uint, 8), 1)
	secs[1] = mkSection(".data", SF_READ | SF_WRITE, SHT_PROGBITS, dataData, cast(uint, 4), 1)
	var syms @[]InputSymbol = make_slice(InputSymbol, 2)
	syms[0] = mkSym("target", 1, BIND_GLOBAL) // defined in .data
	syms[1] = mkSym("_start", 0, BIND_GLOBAL) // defined in .text
	var relocs @[]InputReloc = make_slice(InputReloc, 1)
	relocs[0] = mkReloc(0, cast(uint, 0), 0, R_X86_64_64, 0)
	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr("x.o")
	obj.Machine = EM_X86_64
	obj.Sections = secs
	obj.Symbols = syms
	obj.Relocs = relocs
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x400000))
	b.BeginSection(".text", SF_READ | SF_EXEC)
	b.Place("*(.text*)", false)
	b.EndSection()
	b.SetDot(cast(uint64, 0x401000))
	b.BeginSection(".data", SF_READ | SF_WRITE)
	b.Place("*(.data*)", false)
	b.EndSection()
	b.SetEntry("_start")
	var fe @[]readonly char = b.Finish()
	if len(fe) != 0 { return fail("Finish should succeed") }
	if len(b.EmitElf("/tmp/binate_link_builder_elf")) != 0 { return fail("EmitElf failed") }

	data, ok := readFile("/tmp/binate_link_builder_elf")
	if !ok { return fail("cannot read the emitted executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	if u16(r, 56) != 2 { return fail("text + data should emit two segments") }
	if u64(r, 24) != cast(int64, 0x400000) { return fail("entry should be _start's address") }
	// The ABS64 slot at the start of .text now holds .data's run-time address.
	if u64(r, fileOff(r, 0x400000)) != cast(int64, 0x401000) {
		return fail("the relocation should be patched to target's VMA (0x401000)")
	}
	return ""
}

// A raw-binary driver needs no entry: place one section, Finish, EmitRawBinary — the
// image is exactly the placed bytes.
func TestBuilderFinishEmitRaw() testing.TestResult {
	var code @[]uint8 = make_slice(uint8, 3)
	code[0] = 0x01
	code[1] = 0x02
	code[2] = 0x03
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, code, cast(uint, 3), 1)
	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr("x.o")
	obj.Machine = EM_X86_64
	obj.Sections = secs
	obj.Symbols = make_slice(InputSymbol, 0)
	obj.Relocs = make_slice(InputReloc, 0)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0))
	b.BeginSection(".text", SF_READ | SF_EXEC)
	b.Place("*(.text*)", false)
	b.EndSection()
	if len(b.Finish()) != 0 { return fail("Finish should succeed without an entry") }
	if len(b.EmitRawBinary("/tmp/binate_link_builder_raw")) != 0 { return fail("raw emit failed") }
	data, ok := readFile("/tmp/binate_link_builder_raw")
	if !ok { return fail("cannot read the emitted binary") }
	if len(data) != 3 { return fail("the raw image should be exactly the placed bytes") }
	if data[0] != 0x01 || data[2] != 0x03 { return fail("bytes not in the image") }
	return ""
}

// A relocation that targets a symbol in an UNPLACED section is the strict-orphan hard
// error: the driver never placed .orphan, so its VMA is undefined and Finish fails
// loud rather than silently patching against a stale address.
func TestBuilderFinishOrphanReferenceErrors() testing.TestResult {
	var textData @[]uint8 = make_slice(uint8, 8)
	var orphanData @[]uint8 = make_slice(uint8, 4)
	var secs @[]InputSection = make_slice(InputSection, 2)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, textData, cast(uint, 8), 1)
	secs[1] = mkSection(".orphan", SF_READ, SHT_PROGBITS, orphanData, cast(uint, 4), 1)
	var syms @[]InputSymbol = make_slice(InputSymbol, 1)
	syms[0] = mkSym("orphan_target", 1, BIND_GLOBAL) // defined in the unplaced .orphan
	var relocs @[]InputReloc = make_slice(InputReloc, 1)
	relocs[0] = mkReloc(0, cast(uint, 0), 0, R_X86_64_64, 0)
	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr("x.o")
	obj.Machine = EM_X86_64
	obj.Sections = secs
	obj.Symbols = syms
	obj.Relocs = relocs
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x400000))
	b.BeginSection(".text", SF_READ | SF_EXEC)
	b.Place("*(.text*)", false) // .orphan is deliberately never placed
	b.EndSection()
	if len(b.Finish()) == 0 { return fail("a reference into an unplaced section must fail loud") }
	return ""
}

// EmitElf / EmitRawBinary before Finish is rejected — the output bytes are not yet
// resolved or relocated.
func TestBuilderEmitBeforeFinishErrors() testing.TestResult {
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, make_slice(uint8, 4), cast(uint, 4),
			1)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObjSecs(secs)
	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.BeginSection(".text", SF_READ | SF_EXEC)
	b.Place("*(.text*)", false)
	b.EndSection()
	if len(b.EmitElf("/tmp/binate_link_nofinish")) == 0 { return fail("EmitElf needs Finish first") }
	if len(b.EmitRawBinary("/tmp/binate_link_nofinish")) == 0 {
		return fail("EmitRawBinary before Finish should error")
	}
	return ""
}
