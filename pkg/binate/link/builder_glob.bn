package "pkg/binate/link"

// Input-section name matching for the scripted-layout builder's Place/Keep patterns.

// stripPattern extracts the section-name glob from a `*(GLOB)` input pattern (the outer
// `*` file-glob matches all files in v1); a bare glob is returned unchanged.
func stripPattern(p *[]readonly char) *[]readonly char {
	if len(p) >= 3 && p[0] == 0x2a && p[1] == 0x28 && p[len(p) - 1] == 0x29 {
		// "*(" ... ")"
		return p[2:len(p) - 1]
	}
	return p
}

// globMatch reports whether name matches pat, where `*` matches any run of characters
// (a linker-script section-name glob; `?`/`[...]` are not supported in v1).
func globMatch(pat *[]readonly char, name *[]readonly char) bool {
	var pi int = 0
	var si int = 0
	var star int = -1
	var mark int = 0
	for si < len(name) {
		if pi < len(pat) && pat[pi] == name[si] {
			pi = pi + 1
			si = si + 1
		} else if pi < len(pat) && pat[pi] == 0x2a {
			// '*'
			star = pi
			mark = si
			pi = pi + 1
		} else if star >= 0 {
			pi = star + 1
			mark = mark + 1
			si = mark
		} else {
			return false
		}
	}
	for pi < len(pat) && pat[pi] == 0x2a { pi = pi + 1 }
	return pi == len(pat)
}
