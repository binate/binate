package "pkg/binate/link"

import "pkg/builtins/testing"

// (fail is in parse_elf_test.bn, charsEqual in bytes.bn — same package.)

// stripPattern peels the `*(GLOB)` wrapper and leaves a bare glob unchanged.
func TestStripPattern() testing.TestResult {
	if !charsEqual(stripPattern("*(.text*)"), ".text*") {
		return fail("*(.text*) should strip to .text*")
	}
	if !charsEqual(stripPattern("*(.data)"), ".data") {
		return fail("*(.data) should strip to .data")
	}
	if !charsEqual(stripPattern("*(COMMON)"), "COMMON") {
		return fail("*(COMMON) should strip to COMMON")
	}
	if !charsEqual(stripPattern(".text*"), ".text*") {
		return fail("a bare glob is returned unchanged")
	}
	return ""
}

// globMatch: exact names.
func TestGlobMatchExact() testing.TestResult {
	if !globMatch(".text", ".text") { return fail("exact match should succeed") }
	if globMatch(".text", ".data") { return fail("different names should not match") }
	if globMatch(".text", ".text2") { return fail("exact pattern should not match a longer name") }
	if globMatch(".textx", ".text") { return fail("pattern longer than name should not match") }
	return ""
}

// globMatch: `*` wildcard runs.
func TestGlobMatchStar() testing.TestResult {
	if !globMatch("*", ".anything") { return fail("* should match any name") }
	if !globMatch("*", "") { return fail("* should match the empty name") }
	if !globMatch(".text*", ".text") { return fail(".text* should match .text") }
	if !globMatch(".text*", ".text.startup") { return fail(".text* should match .text.startup") }
	if !globMatch(".text*", ".textfoo") { return fail(".text* should match .textfoo") }
	if globMatch(".text*", ".data") { return fail(".text* should not match .data") }
	if !globMatch("*text*", "a.text.b") { return fail("*text* should match a.text.b") }
	if !globMatch("*.o", "foo.o") { return fail("*.o should match foo.o") }
	if globMatch("*.o", "foo.a") { return fail("*.o should not match foo.a") }
	return ""
}

// globMatch: multiple `*` (backtracking).
func TestGlobMatchMultiStar() testing.TestResult {
	if !globMatch("a*b*c", "axbyc") { return fail("a*b*c should match axbyc") }
	if !globMatch("a*b*c", "abc") { return fail("a*b*c should match abc (empty runs)") }
	if !globMatch("a*b*c", "aXXbYYc") { return fail("a*b*c should match aXXbYYc") }
	if globMatch("a*b*c", "axc") { return fail("a*b*c should not match axc (no b)") }
	if globMatch("a*b*c", "axbyd") { return fail("a*b*c should not match axbyd (wrong tail)") }
	return ""
}

// globMatch: empty-pattern edge.
func TestGlobMatchEmpty() testing.TestResult {
	if !globMatch("", "") { return fail("empty pattern should match the empty name") }
	if globMatch("", ".text") { return fail("empty pattern should not match a non-empty name") }
	return ""
}
