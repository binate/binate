package "pkg/binate/link"

import "pkg/binate/buf"

// A scripted link's linker-made GOT (got.bn).  Its slots are known from the inputs alone,
// so SetInputs adds an object holding a `.got` section of that many slots, which the
// layout script places by name like any input section; Finish lays the slots out from
// that placement, defines `_GLOBAL_OFFSET_TABLE_` there when a program references it and
// the script does not define it, and fills the slots once relocated.  A slot only
// references in discarded sections reach is left unfilled, and a GOT nothing placed needs
// — no live slot, and a `_GLOBAL_OFFSET_TABLE_` the script defines, if referenced — may go
// unplaced.

// builderGot is a scripted link's linker-made GOT: its slots, the index among the inputs
// of the object holding its `.got` section (-1: the link has none), whether a program
// references `_GLOBAL_OFFSET_TABLE_`, and whether the layout placed the section.
type builderGot struct {
	slots  @[]GotSlot
	objIdx int
	symRef bool
	placed bool
}

// withGot returns objs, with the linker-made GOT object appended when an AArch64 link's
// GOT references need slots or a program references `_GLOBAL_OFFSET_TABLE_` (a GOT named
// only by that still gets a slot, so it has an address), and records the GOT in b.got.
func (b @LayoutBuilder) withGot(objs @[]@InputObject) @[]@InputObject {
	b.got.slots = make_slice(GotSlot, 0)
	b.got.objIdx = -1
	b.got.symRef = false
	b.got.placed = false
	if b.Machine != EM_AARCH64 { return objs }
	b.got.slots = collectGotSlots(objs, make_slice(@[]char, 0))
	b.got.symRef = gotSymbolReferenced(objs)
	if len(b.got.slots) == 0 && !b.got.symRef { return objs }
	var n int = len(b.got.slots)
	if n == 0 { n = 1 }
	b.got.objIdx = len(objs)
	return gotObjectsWith(objs, newGotObject(n, b.Machine))
}

// gotSection returns the linker-made GOT's input section (b.got.objIdx >= 0).
func (b @LayoutBuilder) gotSection() InputSection { return b.inputs[b.got.objIdx].Sections[0] }

// markDeadGotSlots marks Dead each slot no GOT reference in a placed section reaches, and
// reports whether any slot is live.
func (b @LayoutBuilder) markDeadGotSlots() bool {
	var live @[]bool = make_slice(bool, len(b.got.slots))
	for o := 0; o < b.got.objIdx; o++ {
		var obj @InputObject = b.inputs[o]
		for r := 0; r < len(obj.Relocs); r++ {
			var rel InputReloc = obj.Relocs[r]
			if !isAArch64GotKind(rel.Kind) || rel.SecIndex < 0 || rel.SecIndex >= len(obj.Sections) {
				continue
			}
			if obj.Sections[rel.SecIndex].OutIndex < 0 { continue }
			if rel.SymIndex < 0 || rel.SymIndex >= len(obj.Symbols) { continue }
			name, ko, ks := gotKeyOf(b.inputs, o, rel)
			var i int = gotSlotIndex(b.got.slots, name, ko, ks, rel.Addend, true)
			if i >= 0 { live[i] = true }
		}
	}
	var any bool = false
	for i := 0; i < len(b.got.slots); i++ {
		b.got.slots[i].Dead = !live[i]
		if live[i] { any = true }
	}
	return any
}

// placeGot lays the GOT's slots out from its section's placement in lr and defines
// `_GLOBAL_OFFSET_TABLE_` there (unless the script defined it).  Returns "" or an error
// when the script left `.got` unplaced though something placed needs it.
func (b @LayoutBuilder) placeGot(lr @LayoutResult) @[]readonly char {
	if b.got.objIdx < 0 { return "" }
	var anyLive bool = b.markDeadGotSlots()
	var sec InputSection = b.gotSection()
	if sec.OutIndex < 0 {
		if anyLive || (b.got.symRef && !absHas(b.abs, gotSymbolName)) {
			return "the linker-made .got (GOT slots, or _GLOBAL_OFFSET_TABLE_) is not placed by the layout"
		}
		return ""
	}
	b.got.placed = true
	var gotVa uint64 = lr.Sections[sec.OutIndex].Addr + cast(uint64, sec.OutOffset)
	placeGotSlots(b.got.slots, gotVa, 0)
	if b.got.symRef && !absHas(b.abs, gotSymbolName) { b.setAbs(buf.CopyStr(gotSymbolName), gotVa) }
	return ""
}

// applyGot gives t the laid-out GOT (placeGot has run).
func (b @LayoutBuilder) applyGot(t @SymbolTable, lr @LayoutResult) {
	if !b.got.placed { return }
	var sec InputSection = b.gotSection()
	t.GotSlots = b.got.slots
	t.GotBase = gotBaseFor(t, lr, lr.Sections[sec.OutIndex].Addr + cast(uint64, sec.OutOffset))
	t.HasGotBase = true
}

// fillGot writes the GOT's slot values into lr's output bytes (after Relocate).
func (b @LayoutBuilder) fillGot(t @SymbolTable, lr @LayoutResult) @[]readonly char {
	if !b.got.placed { return "" }
	var sec InputSection = b.gotSection()
	return fillGotSlots(t, lr, lr.Sections[sec.OutIndex].Data, cast(int, sec.OutOffset), 0)
}
