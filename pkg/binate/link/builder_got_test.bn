package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// A scripted link's linker-made GOT.  (gotProgObjects / gotCheckProg are in
// got_link_test.bn, fail in parse_elf_test.bn, testTmpDir in link_test.bn.)

// gotScripted lays objs out by script — text at 0x80000, then data with `.got` when
// placeGot — and finishes the link, returning the builder and Finish's error.
func gotScripted(objs @[]@InputObject, placeGot bool) (@LayoutBuilder, @[]readonly char) {
	var b @LayoutBuilder = NewLayout(EM_AARCH64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x80000))
	b.BeginSection(".text", SF_READ | SF_EXEC)
	b.Place("*(.text*)", false)
	b.EndSection()
	b.SetDot(cast(uint64, 0x90000))
	b.BeginSection(".data", SF_READ | SF_WRITE)
	b.Place("*(.data*)", false)
	if placeGot { b.Place("*(.got)", false) }
	b.EndSection()
	return b, b.Finish()
}

// A scripted link places the linker-made `.got` as the script says, and the program's GOT
// forms reach it as in a static link; a script that leaves `.got` unplaced fails.
func TestLinkScriptedGot() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	objs, err := gotProgObjects(dir)
	if len(err) != 0 { return fail(buf.Concat("cannot build the object: ", err)) }
	b, ferr := gotScripted(objs, true)
	if len(ferr) != 0 { return fail(buf.Concat("Finish failed: ", ferr)) }
	var sec InputSection = b.gotSection()
	t, rerr := b.Resolve()
	if len(rerr) != 0 { return fail(buf.CopyStr(rerr)) }
	b.applyGot(t, b.result)
	if t.GotBase < 0x90000 { return fail("the GOT not placed in data") }
	var cerr @[]readonly char = gotCheckProg(t, b.result, objs[0],
			b.result.Sections[sec.OutIndex].Data, cast(int, sec.OutOffset))
	if len(cerr) != 0 { return fail(buf.CopyStr(cerr)) }
	objs2, err2 := gotProgObjects(dir)
	if len(err2) != 0 { return fail(buf.CopyStr(err2)) }
	_, ferr2 := gotScripted(objs2, false)
	if len(ferr2) == 0 { return fail("an unplaced .got accepted") }
	return ""
}

// gotObjWithDead returns an object whose `.text` holds `ret` and whose `.text.dead` holds a
// literal load of g's slot, g a word in `.data`.
func gotObjWithDead() @InputObject {
	var o @InputObject = make(InputObject)
	o.Path = "dead.o"
	o.Machine = EM_AARCH64
	o.Sections = make_slice(InputSection, 3)
	var text @[]uint8 = make_slice(uint8, 4)
	writeU32(text, 0, 0xD65F03C0)
	var dead @[]uint8 = make_slice(uint8, 4)
	writeU32(dead, 0, 0x58000000)
	o.Sections[0] = mkDynSection(".text", SF_READ | SF_EXEC, 4, text)
	o.Sections[1] = mkDynSection(".text.dead", SF_READ | SF_EXEC, 4, dead)
	o.Sections[2] = mkDynSection(".data", SF_READ | SF_WRITE, 8, make_slice(uint8, 8))
	o.Symbols = make_slice(InputSymbol, 2)
	o.Symbols[0].Name = "g"
	o.Symbols[0].SecIndex = 2
	o.Symbols[0].Binding = BIND_GLOBAL
	o.Symbols[1].Name = "_GLOBAL_OFFSET_TABLE_"
	o.Symbols[1].SecIndex = -1
	o.Symbols[1].Binding = BIND_GLOBAL
	o.Relocs = make_slice(InputReloc, 1)
	o.Relocs[0].SecIndex = 1
	o.Relocs[0].SymIndex = 0
	o.Relocs[0].Kind = R_AARCH64_GOT_LD_PREL19
	return o
}

// A GOT nothing placed needs may go unplaced: the only reference needing a slot is in a
// section the script discards, and `_GLOBAL_OFFSET_TABLE_` is the script's own.
func TestLinkScriptedGotNotNeeded() testing.TestResult {
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = gotObjWithDead()
	var b @LayoutBuilder = NewLayout(EM_AARCH64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x80000))
	b.BeginSection(".text", SF_READ | SF_EXEC)
	b.Place("*(.text)", false)
	b.EndSection()
	b.BeginSection(".data", SF_READ | SF_WRITE)
	b.Place("*(.data)", false)
	b.EndSection()
	b.DefineSymbol("_GLOBAL_OFFSET_TABLE_", cast(uint64, 0x90000))
	var ferr @[]readonly char = b.Finish()
	if len(ferr) != 0 { return fail(buf.Concat("a link needing no GOT failed: ", ferr)) }
	return ""
}
