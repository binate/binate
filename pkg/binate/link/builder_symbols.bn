package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/stdx/slices"

// The scripted-layout builder's symbol surface: layout-defined absolute symbols (a
// driver's DefineSymbol / SymbolAtDot), the LOADADDR query, and Resolve (which injects
// those symbols into the cross-object symbol table).

// AbsSym is an absolute symbol the layout defines (DefineSymbol / SymbolAtDot) — e.g.
// `_estack`, `__bss_end`, `_sidata`.  Value is an absolute VMA (correct for the
// static / bare-metal / freestanding, non-PIE scope scripted layout targets).  These
// are injected into the symbol table after addresses freeze so relocations and the
// entry lookup see them.
type AbsSym struct {
	Name  @[]char
	Value uint64
}

// setAbs records an absolute symbol, last-write-wins: a repeated name updates its value
// (matching GNU ld, where a later symbol assignment overrides an earlier one) rather than
// leaving two entries — so lookup is unambiguous.
func (b @LayoutBuilder) setAbs(name @[]char, value uint64) {
	for i := 0; i < len(b.abs); i++ {
		if charsEqual(b.abs[i].Name, name) {
			b.abs[i].Value = value
			return
		}
	}
	var s AbsSym
	s.Name = name
	s.Value = value
	b.abs = slices.Append[AbsSym](b.abs, s)
}

// DefineSymbol defines an absolute symbol with an explicit value (last-write-wins).
func (b @LayoutBuilder) DefineSymbol(name *[]readonly char, value uint64) {
	b.setAbs(buf.CopyStr(name), value)
}

// SymbolAtDot defines an absolute symbol equal to the current location counter
// (last-write-wins).
func (b @LayoutBuilder) SymbolAtDot(name *[]readonly char) {
	if b.cur >= 0 { b.ensureStarted() }
	b.setAbs(buf.CopyStr(name), b.dot)
}

// LoadAddrOf returns a section's load address (LOADADDR) — valid once the section has
// started (its start is frozen at the first content op or EndSection).
func (b @LayoutBuilder) LoadAddrOf(sec Section) uint64 {
	if sec.Idx < 0 || sec.Idx >= len(b.secs) {
		b.fail("LoadAddrOf: invalid section")
		return cast(uint64, 0)
	}
	return b.secs[sec.Idx].LmaStart
}

// AbsSyms returns the absolute symbols the layout defined (for injection into the
// symbol table before relocation).
func (b @LayoutBuilder) AbsSyms() @[]AbsSym { return b.abs }

// Resolve builds the cross-object symbol table over the builder's inputs, injecting the
// layout-defined absolute symbols (DefineSymbol / SymbolAtDot) so a reference undefined in
// every object — e.g. a startup file's `_stack_top` / `__bss_end` — resolves instead of
// being reported undefined.  Call after placement, when the absolute values are final.
// Returns the table and "" on success, or the table and a non-empty error (an undefined
// symbol not covered by an object definition or the abs set, or a duplicate definition).
func (b @LayoutBuilder) Resolve() (@SymbolTable, @[]readonly char) {
	return ResolveWithAbs(b.inputs, b.abs)
}
