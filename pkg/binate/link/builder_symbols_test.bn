package "pkg/binate/link"

import "pkg/builtins/testing"

// Tests for the scripted-layout builder's symbol surface (builder_symbols.bn).
// (mkSection / mkObjSecs are in layout_test.bn, mkSym in resolve_test.bn, fail in
// parse_elf_test.bn, charsEqual in bytes.bn, symbolAddr in relocate.bn — same package.)

// absValue returns the value of the absolute symbol named n in syms, and whether found.
func absValue(syms @[]AbsSym, n *[]readonly char) (uint64, bool) {
	for i := 0; i < len(syms); i++ {
		if charsEqual(syms[i].Name, n) { return syms[i].Value, true }
	}
	return cast(uint64, 0), false
}

// SymbolAtDot captures the location counter at boundary points; DefineSymbol takes an
// explicit value.  Verifies __start/__end bracket the placed content.
func TestBuilderBoundarySymbols() testing.TestResult {
	var dd @[]uint8 = make_slice(uint8, 8)
	for i := 0; i < 8; i++ { dd[i] = cast(uint8, i) }
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".data", SF_READ | SF_WRITE, SHT_PROGBITS, dd, cast(uint, 8), 1)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObjSecs(secs)

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x2000))
	var dataSec Section = b.BeginSection(".data", SF_READ | SF_WRITE)
	if dataSec.Idx != 0 { return fail("section index should be 0") }
	b.SymbolAtDot("__data_start")
	b.Place("*(.data*)", false)
	b.SymbolAtDot("__data_end")
	b.EndSection()
	lr, err := b.Result()
	if len(err) != 0 { return fail("unexpected error") }
	if lr.Sections[0].Size != cast(uint64, 8) { return fail(".data size should be 8") }
	s, f1 := absValue(b.AbsSyms(), "__data_start")
	e, f2 := absValue(b.AbsSyms(), "__data_end")
	if !f1 || !f2 { return fail("boundary symbols missing") }
	if s != cast(uint64, 0x2000) { return fail("__data_start should be 0x2000") }
	if e != cast(uint64, 0x2008) { return fail("__data_end should be 0x2008") }
	return ""
}

// A layout-defined absolute symbol (DefineSymbol) satisfies a reference undefined in every
// object (e.g. a startup file's `_stack_top`): Resolve does not report it undefined, and
// symbolAddr resolves it to its absolute value.  Without the definition, it stays undefined.
func TestBuilderResolveAbsSymbol() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 4)
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, dt, cast(uint, 4), 1)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObjSecs(secs)
	var syms @[]InputSymbol = make_slice(InputSymbol, 1)
	syms[0] = mkSym("_stack_top", -1, BIND_GLOBAL) // undefined reference
	objs[0].Symbols = syms

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x1000))
	var s0 Section = b.BeginSection(".text", SF_READ | SF_EXEC)
	if s0.Idx != 0 { return fail("index 0") }
	b.Place("*(.text*)", false)
	b.EndSection()
	b.DefineSymbol("_stack_top", cast(uint64, 0x40010000))
	lr, rerr := b.Result()
	if len(rerr) != 0 { return fail("unexpected layout error") }
	t, err := b.Resolve()
	if len(err) != 0 { return fail("_stack_top should resolve via the abs set, not be undefined") }
	v, ok := symbolAddr(t, lr, 0, 0)
	if !ok { return fail("symbolAddr should resolve _stack_top") }
	if v != cast(uint64, 0x40010000) { return fail("_stack_top should resolve to its absolute value") }

	// Without the abs definition, the same reference is a hard undefined-symbol error.
	var b2 @LayoutBuilder = NewLayout(EM_X86_64)
	b2.SetInputs(objs)
	b2.SetDot(cast(uint64, 0x1000))
	var s1 Section = b2.BeginSection(".text", SF_READ | SF_EXEC)
	if s1.Idx != 0 { return fail("index 0 (b2)") }
	b2.Place("*(.text*)", false)
	b2.EndSection()
	_, err2 := b2.Resolve()
	if len(err2) == 0 { return fail("an undefined symbol with no abs definition should error") }
	return ""
}

// Last-write-wins for a repeated DefineSymbol, and an object definition takes precedence
// over a same-named absolute symbol (the abs set only satisfies otherwise-undefined refs).
func TestBuilderAbsLastWinsAndPrecedence() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 4)
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, dt, cast(uint, 4), 1)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObjSecs(secs)
	var syms @[]InputSymbol = make_slice(InputSymbol, 1)
	syms[0] = mkSym("foo", 0, BIND_GLOBAL) // defined in section 0, value 0
	objs[0].Symbols = syms

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x1000))
	var ts Section = b.BeginSection(".text", SF_READ | SF_EXEC)
	if ts.Idx != 0 { return fail("index 0") }
	b.Place("*(.text*)", false)
	b.EndSection()
	b.DefineSymbol("x", cast(uint64, 0x11))
	b.DefineSymbol("x", cast(uint64, 0x22)) // last-wins: overrides 0x11
	b.DefineSymbol("foo", cast(uint64, 0xdead)) // shadowed by the object def below
	lr, rerr := b.Result()
	if len(rerr) != 0 { return fail("unexpected layout error") }

	xv, xok := absValue(b.AbsSyms(), "x")
	if !xok || xv != cast(uint64, 0x22) { return fail("x should be last-wins 0x22") }
	if len(b.AbsSyms()) != 2 { return fail("abs should hold 2 entries (x, foo) — no duplicate x") }

	t, err := b.Resolve()
	if len(err) != 0 { return fail("unexpected resolve error") }
	fv, fok := symbolAddr(t, lr, 0, 0) // foo = objs[0].Symbols[0], defined in .text
	if !fok { return fail("foo should resolve") }
	if fv != cast(uint64, 0x1000) {
		return fail("foo should resolve to the object def, not the abs 0xdead")
	}
	return ""
}
