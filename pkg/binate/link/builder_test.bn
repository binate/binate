package "pkg/binate/link"

import "pkg/builtins/testing"

// (mkSection / mkObjSecs are in layout_test.bn, fail in parse_elf_test.bn, charsEqual
// in bytes.bn — same package.)

// Two objects' .text sections placed into one output section at an explicit Dot merge
// in pool order, each recording its offset; VMA and LMA coincide by default.
func TestBuilderPlaceMerge() testing.TestResult {
	var da @[]uint8 = make_slice(uint8, 2)
	da[0] = 0x90
	da[1] = 0x90
	var sa @[]InputSection = make_slice(InputSection, 1)
	sa[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, da, cast(uint, 2), 1)
	var db @[]uint8 = make_slice(uint8, 1)
	db[0] = 0xc3
	var sb @[]InputSection = make_slice(InputSection, 1)
	sb[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, db, cast(uint, 1), 1)
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkObjSecs(sa)
	objs[1] = mkObjSecs(sb)

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x1000))
	var textSec Section = b.BeginSection(".text", SF_READ | SF_EXEC)
	if textSec.Idx != 0 { return fail("first section index should be 0") }
	b.Place("*(.text*)", false)
	b.EndSection()
	lr, err := b.Result()
	if len(err) != 0 { return fail("unexpected builder error") }
	if len(lr.Sections) != 1 { return fail("expected one output section") }
	if lr.Sections[0].Addr != cast(uint64, 0x1000) { return fail(".text VMA should be 0x1000") }
	if lr.Sections[0].Lma != cast(uint64, 0x1000) { return fail(".text LMA should equal VMA") }
	if lr.Sections[0].Size != cast(uint64, 3) { return fail(".text size should be 3") }
	if len(lr.Sections[0].Data) != 3 { return fail(".text data should be 3 bytes") }
	if lr.Sections[0].Data[0] != 0x90 || lr.Sections[0].Data[1] != 0x90 ||
			lr.Sections[0].Data[2] != 0xc3 {
		return fail("merged .text bytes are wrong")
	}
	if objs[0].Sections[0].OutOffset != cast(uint, 0) { return fail("objA .text offset should be 0") }
	if objs[1].Sections[0].OutOffset != cast(uint, 2) { return fail("objB .text offset should be 2") }
	if objs[0].Sections[0].OutIndex != 0 { return fail("objA .text OutIndex should be 0") }
	return ""
}

// A ROM→RAM-copy layout: .text lives in FLASH; .data runs in RAM but loads from FLASH
// (> RAM AT> FLASH).  .data's VMA is in RAM, its LMA is in FLASH right after .text, and
// LoadAddrOf/_sidata report that flash load address.
func TestBuilderRomCopyLma() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 4)
	dt[0] = 0x01
	dt[1] = 0x02
	dt[2] = 0x03
	dt[3] = 0x04
	var dd @[]uint8 = make_slice(uint8, 2)
	dd[0] = 0xaa
	dd[1] = 0xbb
	var secs @[]InputSection = make_slice(InputSection, 2)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, dt, cast(uint, 4), 1)
	secs[1] = mkSection(".data", SF_READ | SF_WRITE, SHT_PROGBITS, dd, cast(uint, 2), 1)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObjSecs(secs)

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.DefineRegion("FLASH", cast(uint64, 0x08000000), cast(uint64, 0x1000), 0)
	b.DefineRegion("RAM", cast(uint64, 0x20000000), cast(uint64, 0x1000), 0)
	var textSec Section = b.BeginSection(".text", SF_READ | SF_EXEC)
	b.SectionAtRegion("FLASH")
	b.Place("*(.text*)", false)
	b.EndSection()
	if textSec.Idx != 0 { return fail(".text section index should be 0") }
	var dataSec Section = b.BeginSection(".data", SF_READ | SF_WRITE)
	b.SectionAtRegion("RAM")
	b.SectionLoadRegion("FLASH")
	b.Place("*(.data*)", false)
	b.EndSection()
	b.DefineSymbol("_sidata", b.LoadAddrOf(dataSec))
	lr, err := b.Result()
	if len(err) != 0 { return fail("unexpected builder error in rom-copy") }
	if len(lr.Sections) != 2 { return fail("expected two output sections") }
	if lr.Sections[0].Addr != cast(uint64, 0x08000000) {
		return fail(".text VMA should be flash base")
	}
	if lr.Sections[0].Lma != cast(uint64, 0x08000000) { return fail(".text LMA should be flash base") }
	if lr.Sections[1].Addr != cast(uint64, 0x20000000) { return fail(".data VMA should be RAM base") }
	if lr.Sections[1].Lma != cast(uint64, 0x08000004) {
		return fail(".data LMA should be flash after .text")
	}
	if lr.Sections[1].Size != cast(uint64, 2) { return fail(".data size should be 2") }
	if lr.Sections[1].Data[0] != 0xaa || lr.Sections[1].Data[1] != 0xbb {
		return fail(".data bytes wrong")
	}
	v, found := absValue(b.AbsSyms(), "_sidata")
	if !found { return fail("_sidata not defined") }
	if v != cast(uint64, 0x08000004) { return fail("_sidata should be the .data flash load address") }
	return ""
}

// A region too small for its content is a hard error (region-overflow check).
func TestBuilderRegionOverflow() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 4)
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, dt, cast(uint, 4), 1)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObjSecs(secs)

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.DefineRegion("TINY", cast(uint64, 0x1000), cast(uint64, 2), 0) // only 2 bytes
	var s0 Section = b.BeginSection(".text", SF_READ | SF_EXEC)
	if s0.Idx != 0 { return fail("section index should be 0") }
	b.SectionAtRegion("TINY")
	b.Place("*(.text*)", false)
	b.EndSection()
	_, err := b.Result()
	if len(err) == 0 { return fail("expected a region-overflow error") }
	return ""
}

// KEEP then a broader Place does not double-place a section already consumed
// (first-match-wins, consume-once).
func TestBuilderConsumeOnce() testing.TestResult {
	var ds @[]uint8 = make_slice(uint8, 2)
	ds[0] = 0x11
	ds[1] = 0x22
	var dm @[]uint8 = make_slice(uint8, 3)
	dm[0] = 0x33
	dm[1] = 0x44
	dm[2] = 0x55
	var secs @[]InputSection = make_slice(InputSection, 2)
	secs[0] = mkSection(".text.startup", SF_READ | SF_EXEC, SHT_PROGBITS, ds, cast(uint, 2), 1)
	secs[1] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, dm, cast(uint, 3), 1)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObjSecs(secs)

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x1000))
	var s0 Section = b.BeginSection(".text", SF_READ | SF_EXEC)
	if s0.Idx != 0 { return fail("section index should be 0") }
	b.Place("*(.text.startup)", true) // KEEP first
	b.Place("*(.text*)", false) // must NOT re-place .text.startup
	b.EndSection()
	lr, err := b.Result()
	if len(err) != 0 { return fail("unexpected error") }
	// startup (2) + .text (3) = 5, each placed once.
	if lr.Sections[0].Size != cast(uint64, 5) {
		return fail("section should be 5 bytes (no double-place)")
	}
	if len(lr.Sections[0].Data) != 5 { return fail("data should be 5 bytes") }
	if objs[0].Sections[0].OutOffset != cast(uint, 0) {
		return fail(".text.startup should be at offset 0")
	}
	if objs[0].Sections[1].OutOffset != cast(uint, 2) { return fail(".text should be at offset 2") }
	if lr.Sections[0].Data[0] != 0x11 || lr.Sections[0].Data[2] != 0x33 {
		return fail("bytes wrong / mis-ordered")
	}
	return ""
}

// A raw-blob layout: place code, pad to a fixed offset, emit a literal signature
// (the bootloader shape).  Padding zero-fills; the signature lands at the padded offset.
func TestBuilderPadAndData() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 4)
	dt[0] = 0xf4
	dt[1] = 0xf4
	dt[2] = 0xf4
	dt[3] = 0xf4
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, dt, cast(uint, 4), 1)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObjSecs(secs)

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x7c00))
	var s0 Section = b.BeginSection(".text", SF_READ | SF_EXEC)
	if s0.Idx != 0 { return fail("text index 0") }
	b.Place("*(.text*)", false)
	b.EndSection()
	var s1 Section = b.BeginSection(".sig", SF_READ)
	if s1.Idx != 1 { return fail("sig index 1") }
	b.PadTo(cast(uint64, 0x7dfe), cast(uint8, 0)) // 0x7c00 + 0x1fe
	var sig @[]uint8 = make_slice(uint8, 2)
	sig[0] = 0x55
	sig[1] = 0xaa
	b.EmitData(sig)
	b.EndSection()
	lr, err := b.Result()
	if len(err) != 0 { return fail("unexpected error") }
	if len(lr.Sections) != 2 { return fail("expected two sections") }
	// .sig starts right after .text (0x7c04), pads to 0x7dfe, then 2 bytes -> ends 0x7e00.
	if lr.Sections[1].Addr != cast(uint64, 0x7c04) { return fail(".sig should start after .text") }
	if lr.Sections[1].Size != cast(uint64, 0x1fc) {
		return fail(".sig size should span pad + signature")
	}
	var d @[]uint8 = lr.Sections[1].Data
	if len(d) != 0x1fc { return fail(".sig data length wrong") }
	if d[0] != 0 { return fail("pad should be zero-filled") }
	if d[len(d) - 2] != 0x55 || d[len(d) - 1] != 0xaa { return fail("boot signature bytes wrong") }
	return ""
}

// A NOBITS input (.bss) reserves size but contributes no bytes: the output section has
// Size > 0 and empty Data.
func TestBuilderNobits() testing.TestResult {
	var empty @[]uint8 = make_slice(uint8, 0)
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".bss", SF_READ | SF_WRITE, SHT_NOBITS, empty, cast(uint, 16), 1)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObjSecs(secs)

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x3000))
	var s0 Section = b.BeginSection(".bss", SF_READ | SF_WRITE)
	if s0.Idx != 0 { return fail("section index should be 0") }
	b.Place("*(.bss*)", false)
	b.EndSection()
	lr, err := b.Result()
	if len(err) != 0 { return fail("unexpected error") }
	if lr.Sections[0].Size != cast(uint64, 16) { return fail(".bss should reserve 16 bytes") }
	if len(lr.Sections[0].Data) != 0 { return fail(".bss should carry no file bytes") }
	return ""
}

// SectionLoadAddr sets an explicit LMA (AT(addr)) independent of the VMA.
func TestBuilderSectionLoadAddr() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 4)
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, dt, cast(uint, 4), 1)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObjSecs(secs)

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x1000))
	var s0 Section = b.BeginSection(".text", SF_READ | SF_EXEC)
	b.SectionLoadAddr(cast(uint64, 0x9000))
	b.Place("*(.text*)", false)
	b.EndSection()
	lr, err := b.Result()
	if len(err) != 0 { return fail("unexpected error") }
	if lr.Sections[0].Addr != cast(uint64, 0x1000) { return fail("VMA should be 0x1000") }
	if lr.Sections[0].Lma != cast(uint64, 0x9000) { return fail("explicit LMA should be 0x9000") }
	if b.LoadAddrOf(s0) != cast(uint64, 0x9000) {
		return fail("LoadAddrOf should report the explicit LMA")
	}
	return ""
}

// A routing op after content began is a hard error (the section start is already frozen).
func TestBuilderRoutingAfterContentErrors() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 2)
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, dt, cast(uint, 2), 1)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObjSecs(secs)

	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.DefineRegion("RAM", cast(uint64, 0x2000), cast(uint64, 0x1000), 0)
	var s0 Section = b.BeginSection(".text", SF_READ | SF_EXEC)
	if s0.Idx != 0 { return fail("index 0") }
	b.Place("*(.text*)", false)
	b.SectionLoadRegion("RAM") // after content -> should latch an error
	b.EndSection()
	_, err := b.Result()
	if len(err) == 0 { return fail("routing after content should be an error") }
	return ""
}

// Result with a section still open, and BeginSection nested without EndSection, are errors.
func TestBuilderStateErrors() testing.TestResult {
	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(make_slice(@InputObject, 0))
	b.SetDot(cast(uint64, 0x1000))
	var s0 Section = b.BeginSection(".text", SF_READ | SF_EXEC)
	if s0.Idx != 0 { return fail("index 0") }
	var s1 Section = b.BeginSection(".data", SF_READ | SF_WRITE) // nested -> error
	if s1.Idx != 0 { return fail("nested BeginSection should return the still-open section") }
	_, err := b.Result() // also: section still open
	if len(err) == 0 { return fail("nested BeginSection / open-at-Result should be an error") }
	return ""
}
