package "pkg/binate/link"

// Little-endian readers over a raw object-file byte buffer, plus a byte-slice
// equality helper.  u32/u64 return int64 so they are correct on an ILP32 host
// (arm32), where `int` is 32 bits: a 32-bit field with bit 31 set (e.g. a Mach-O
// load command carrying LC_REQ_DYLD, or a symbol/section value ≥ 2 GB) does not
// fit a non-negative machine int, and a full 64-bit field does not fit at all —
// so `int` would overflow the `<< 24` / `<< 32…56` shifts and truncate the value.
// int64 holds any u32 non-negatively and any u64 as its two's-complement value (a
// signed RELA addend included).  Each caller narrows the raw field to its semantic
// type: a genuinely small offset/size/count/index takes cast(int, …) (or routes a
// 64-bit field through readOff, which fit-checks); a target address stays uint64
// and a word/displacement stays int64 — matching the emit side's widths.

// u16 reads a little-endian 16-bit value at byte offset off.  It stays int: a
// 16-bit value (≤ 0xffff) and its `<< 8` never overflow a 32-bit int.
func u16(b *[]readonly uint8, off int) int {
	return cast(int, b[off]) | (cast(int, b[off + 1]) << 8)
}

// u32 reads a little-endian 32-bit value at byte offset off, as a non-negative
// int64 (0 … 0xffffffff).
func u32(b *[]readonly uint8, off int) int64 {
	var v int64 = 0
	for i := 0; i < 4; i++ { v = v | (cast(int64, b[off + i]) << cast(uint, 8 * i)) }
	return v
}

// u64 reads a little-endian 64-bit value at byte offset off, as int64 (its
// two's-complement value; addresses < 2^63 come back non-negative).
func u64(b *[]readonly uint8, off int) int64 {
	var v int64 = 0
	for i := 0; i < 8; i++ { v = v | (cast(int64, b[off + i]) << cast(uint, 8 * i)) }
	return v
}

// readOff reads a 64-bit little-endian offset/size/value field and validates it
// fits a non-negative machine int (the high 32 bits are zero and bit 31 is
// clear).  Returns (value, true) on success; (0, false) if the field would not
// fit — which a valid relocatable object for a 32/64-bit target never produces,
// so this converts the otherwise-silent 32-bit `int` truncation into a loud,
// caller-checkable failure.  The caller must ensure off + 8 <= len(b).
func readOff(b *[]readonly uint8, off int) (int, bool) {
	var lo int64 = u32(b, off)
	var hi int64 = u32(b, off + 4)
	if hi != 0 { return 0, false }
	// lo is a non-negative int64 in [0, 0xffffffff]; require it to round-trip
	// through a non-negative machine int.  On LP64 that always holds; on ILP32 a
	// value with bit 31 set (≥ 2 GB) fails here rather than truncating silently.
	var v int = cast(int, lo)
	if cast(int64, v) != lo || v < 0 { return 0, false }
	return v, true
}

// readOffC reads an offset/size/value field whose width depends on the ELF class
// — 8 bytes on ELF64 (delegates to readOff), 4 bytes on ELF32 — and validates it
// fits a non-negative machine int (as readOff does).  An ELF32 4-byte field must
// NOT be read with readOff: readOff's 8-byte read would spill into the following
// field and, whenever that field is non-zero, fail the high-word-zero check
// spuriously (an sh_offset followed by a non-zero sh_size, say).  The caller must
// ensure the field's bytes are in range (off+8 for ELF64, off+4 for ELF32).
func readOffC(b *[]readonly uint8, off int, is64 bool) (int, bool) {
	if is64 { return readOff(b, off) }
	var v int64 = u32(b, off)
	var w int = cast(int, v)
	if cast(int64, w) != v || w < 0 { return 0, false }
	return w, true
}

// charsEqual reports whether raw slices a and b have identical contents.
func charsEqual(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ { if a[i] != b[i] { return false } }
	return true
}
