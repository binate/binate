package "pkg/binate/link"

import "pkg/builtins/testing"

// (fail is defined in parse_elf_test.bn, same package.)

// The little-endian readers must decode fields at an offset.  Values here fit in
// 32 bits (as every field in a relocatable object does), so the checks are the
// same on a 32- or 64-bit machine word.
func TestByteReaders() testing.TestResult {
	var b @[]uint8 = make_slice(uint8, 8)
	b[0] = 0x08
	b[1] = 0x07
	b[2] = 0x06
	b[3] = 0x05
	b[4] = 0x00
	b[5] = 0x00
	b[6] = 0x00
	b[7] = 0x00
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = b
	if u16(r, 0) != 0x0708 { return fail("u16 little-endian decode wrong") }
	if u16(r, 2) != 0x0506 { return fail("u16 at a nonzero offset wrong") }
	if u32(r, 0) != 0x05060708 { return fail("u32 little-endian decode wrong") }
	if u64(r, 0) != 0x05060708 { return fail("u64 of a 32-bit value wrong") }
	return ""
}

// readOff accepts a field that fits a non-negative machine int and rejects one
// whose high 32 bits are set (which would silently truncate on a 32-bit int).
func TestReadOff() testing.TestResult {
	var fits @[]uint8 = make_slice(uint8, 8)
	fits[0] = 0x10 // value 16, high bytes zero
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var fr *[]readonly uint8 = fits
	v, ok := readOff(fr, 0)
	if !ok { return fail("readOff should accept a small value") }
	if v != 16 { return fail("readOff returned the wrong value") }

	var big @[]uint8 = make_slice(uint8, 8)
	big[4] = 0x01 // high 32 bits = 1 -> does not fit a machine int
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var br *[]readonly uint8 = big
	_, ok2 := readOff(br, 0)
	if ok2 { return fail("readOff should reject a field exceeding 32 bits") }
	return ""
}

// charsEqual compares raw slice contents.
func TestCharsEqual() testing.TestResult {
	if !charsEqual(".text", ".text") { return fail("equal strings should compare equal") }
	if charsEqual(".text", ".data") { return fail("different strings should compare unequal") }
	if charsEqual(".text", ".te") { return fail("different lengths should compare unequal") }
	return ""
}
