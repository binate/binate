package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Common symbols in a whole-program link (commons.bn): which commons the linker-made object
// allocates and where, a static link's resolution through it, and a dynamic Mach-O link that
// keeps a common out of the imports.  (mkCommon is in builder_common_test.bn, mkSym / mkObj in
// resolve_test.bn, resolvedAddr in macho_link_test.bn, writeMachoAsm in dynmacho_abs_test.bn,
// machoLcOffset in dynmacho_test.bn, machoSegmentCmd / adrpAddTarget in dynmacho_init_test.bn,
// machoSymEntry in parse_macho_syms_test.bn, testTmpDir in link_test.bn, fail in
// parse_elf_test.bn.)

// commonObjs returns two objects: a.o with the commons a (4 bytes, 4-aligned), b (2, 2), w,
// s and loc (4, 4 each); b.o with the common a (8 bytes, 8-aligned) and, in its 8-byte
// .text, a weak w, a strong s and a local loc.
func commonObjs() @[]@InputObject {
	var as @[]InputSymbol = make_slice(InputSymbol, 5)
	as[0] = mkCommon("a", 4, 4)
	as[1] = mkCommon("b", 2, 2)
	as[2] = mkCommon("w", 4, 4)
	as[3] = mkCommon("s", 4, 4)
	as[4] = mkCommon("loc", 4, 4)
	var bs @[]InputSymbol = make_slice(InputSymbol, 4)
	bs[0] = mkCommon("a", 8, 8)
	bs[1] = mkSym("w", 0, BIND_WEAK)
	bs[2] = mkSym("s", 0, BIND_GLOBAL)
	bs[3] = mkSym("loc", 0, 0)
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkObj("a.o", as)
	objs[1] = mkObj("b.o", bs)
	objs[1].Sections[0].Data = make_slice(uint8, 8) // a non-empty .text, so layout keeps it
	objs[1].Sections[0].Size = 8
	return objs
}

// commonDefsAre checks that obj defines exactly names, in order, at offsets offs and sizes
// sizes, as globals in its one NOBITS .bss section of size secSize aligned to secAlign.
func commonDefsAre(obj @InputObject, names @[]@[]char, offs @[]int, sizes @[]int, secSize int,
		secAlign int) @[]char {
	if !present(obj) { return buf.CopyStr("no commons object") }
	if len(obj.Sections) != 1 || obj.Sections[0].Type != SHT_NOBITS ||
			cast(int, obj.Sections[0].Size) != secSize || obj.Sections[0].Align != secAlign ||
			(obj.Sections[0].Flags & SF_WRITE) == 0 {
		return buf.CopyStr("the commons section is not the expected writable NOBITS .bss")
	}
	if len(obj.Symbols) != len(names) { return buf.CopyStr("wrong number of common definitions") }
	for i := 0; i < len(names); i++ {
		var s InputSymbol = obj.Symbols[i]
		if !charsEqual(s.Name, names[i]) || s.SecIndex != 0 || cast(int, s.Value) != offs[i] ||
				cast(int, s.Size) != sizes[i] || s.Binding != BIND_GLOBAL || s.Common {
			return buf.Concat("wrong definition for ", names[i])
		}
	}
	return ""
}

// The linker-made object defines each common no definition supersedes, in first-reference
// order, merged to the largest size and alignment: a strong definition supersedes one, a local
// does not, and a weak one supersedes it only when weakWins (Mach-O).
func TestCommonObjectRules() testing.TestResult {
	var elf commonsResult = commonObject(commonObjs(), EM_X86_64, false)
	if len(elf.Err) != 0 { return fail(buf.Concat("commonObject: ", elf.Err)) }
	var e @[]char = commonDefsAre(elf.Obj,
			@[]@[]char{buf.CopyStr("a"), buf.CopyStr("b"), buf.CopyStr("w"), buf.CopyStr("loc")},
			@[]int{0, 8, 12, 16}, @[]int{8, 2, 4, 4}, 20, 8)
	if len(e) != 0 { return fail(buf.Concat("ELF rule: ", e)) }
	var mo commonsResult = commonObject(commonObjs(), EM_AARCH64, true)
	if len(mo.Err) != 0 { return fail(buf.Concat("commonObject: ", mo.Err)) }
	e = commonDefsAre(mo.Obj, @[]@[]char{buf.CopyStr("a"), buf.CopyStr("b"), buf.CopyStr("loc")},
			@[]int{0, 8, 12}, @[]int{8, 2, 4}, 16, 8)
	if len(e) != 0 { return fail(buf.Concat("Mach-O rule: ", e)) }
	return ""
}

// No commons, or only superseded ones, make no object; an alignment that is not a power of two
// is an error.
func TestCommonObjectNoneOrBad() testing.TestResult {
	var syms @[]InputSymbol = make_slice(InputSymbol, 1)
	syms[0] = mkSym("f", 0, BIND_GLOBAL)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObj("f.o", syms)
	var r commonsResult = commonObject(objs, EM_X86_64, false)
	if present(r.Obj) || len(r.Err) != 0 {
		return fail("an object without commons made a commons object")
	}
	var only @[]InputSymbol = make_slice(InputSymbol, 2)
	only[0] = mkCommon("f", 4, 4)
	only[1] = mkSym("f", 0, BIND_GLOBAL)
	objs[0] = mkObj("f.o", only)
	r = commonObject(objs, EM_X86_64, false)
	if present(r.Obj) || len(r.Err) != 0 { return fail("a superseded common was allocated") }
	var bad @[]InputSymbol = make_slice(InputSymbol, 1)
	bad[0] = mkCommon("odd", 4, 3)
	objs[0] = mkObj("odd.o", bad)
	r = commonObject(objs, EM_X86_64, false)
	var want *[]readonly char = "common symbol odd has an alignment that is not a power of two"
	if !charsEqual(r.Err, want) { return fail(buf.Concat("wrong error: ", r.Err)) }
	return ""
}

// A zero-size common gets a byte of storage, so the section is never empty (Layout would drop
// it) and the common has an address; its own size stays 0.
func TestCommonObjectZeroSize() testing.TestResult {
	var syms @[]InputSymbol = make_slice(InputSymbol, 1)
	syms[0] = mkCommon("z", 0, 4)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObj("z.o", syms)
	var r commonsResult = commonObject(objs, EM_X86_64, false)
	if len(r.Err) != 0 { return fail(buf.Concat("commonObject: ", r.Err)) }
	var e @[]char = commonDefsAre(r.Obj, @[]@[]char{buf.CopyStr("z")}, @[]int{0}, @[]int{0}, 1, 4)
	if len(e) != 0 { return fail(e) }
	return ""
}

// A static link allocates the commons in its .bss: a.o's common a resolves there, and b.o's
// weak w loses to a.o's common w (as in GNU ld and lld), while b.o's strong s stays in .text.
func TestLayoutStaticAllocatesCommons() testing.TestResult {
	t, lr, _, err := layoutStatic(commonObjs(), EM_X86_64, cast(uint64, 0x400000))
	if len(err) != 0 { return fail(buf.Concat("layoutStatic failed: ", err)) }
	var bss int = -1
	for i := 0; i < len(lr.Sections); i++ {
		if charsEqual(lr.Sections[i].Name, ".bss") { bss = i }
	}
	if bss < 0 || lr.Sections[bss].Size != 20 { return fail("no 20-byte .bss for the commons") }
	var lo uint64 = lr.Sections[bss].Addr
	a, aok := symbolAddr(t, lr, 0, 0)
	w, wok := symbolAddr(t, lr, 1, 1)
	s, sok := resolvedAddr(t, lr, "s")
	if !aok || a != lo { return fail("a.o's common a is not the .bss's first 8 bytes") }
	if !wok || w != lo + 12 { return fail("b.o's weak w does not resolve to the allocated common") }
	if !sok || s >= lo { return fail("the strong s should stay in .text") }
	return ""
}

// machoPatchCommon makes the undefined external name in the Mach-O object data a common of
// size bytes aligned to 2^alignLog2 (n_value = size, n_desc bits 8-11 = alignLog2), and
// reports whether it found the symbol.
func machoPatchCommon(data @[]uint8, name *[]readonly char, size int, alignLog2 int) bool {
	var e int = machoSymEntry(data, name)
	if e < 0 { return false }
	writeU64(data, e + 8, cast(uint64, size))
	data[e + 6] = 0
	data[e + 7] = cast(uint8, alignLog2)
	return true
}

// commonMachoObj writes under dir a Mach-O object whose `_start` takes the address of `_x`
// (ADRP + ADD), calls `_exit`, then takes the pages of `_y` and `_z`: `_x` a 12-byte, 8-aligned
// common, `_y` (100 bytes) and `_z` (70000) commons with alignment field 0.  Returns its path,
// or "".
func commonMachoObj(dir *[]readonly char) @[]char {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.SetGlobal("_exit")
	a.SetGlobal("_x")
	a.SetGlobal("_y")
	a.SetGlobal("_z")
	aarch64.Adrp(a, aarch64.X1, "_x")
	aarch64.AddImmLabel(a, true, aarch64.X1, aarch64.X1, "_x")
	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(42))
	aarch64.Bl(a, "_exit")
	aarch64.Adrp(a, aarch64.X2, "_y")
	aarch64.Adrp(a, aarch64.X3, "_z")
	var path @[]char = writeMachoAsm(a, dir, "common.o")
	if len(path) == 0 { return "" }
	data, ok := readFile(path)
	if !ok || !machoPatchCommon(data, "_x", 12, 3) || !machoPatchCommon(data, "_y", 100, 0) ||
			!machoPatchCommon(data, "_z", 70000, 0) || !writeBytes(path, data) {
		return ""
	}
	return path
}

// A dynamic Mach-O link allocates a common in __DATA rather than importing it from
// libSystem: the link succeeds, `_x` is not among the imports' names, and the ADRP + ADD of it
// lands in __DATA.
func TestLinkDynMachoAllocatesCommon() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = commonMachoObj(dir)
	if len(paths[0]) == 0 { return fail("cannot build the object") }
	var start uint64 = 0x100004000
	var out @[]char = buf.Concat(dir, "/common")
	var err @[]readonly char = LinkDynMacho(paths, "_start", EM_AARCH64, start, out)
	if len(err) != 0 { return fail(buf.Concat("LinkDynMacho failed: ", err)) }
	exe, eok := readFile(out)
	if !eok { return fail("cannot read the executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = exe
	var st int = machoLcOffset(rd, 0x2) // LC_SYMTAB: the imports' nlists
	if st < 0 { return fail("no LC_SYMTAB") }
	var strOff int = cast(int, u32(rd, st + 16))
	var strSize int = cast(int, u32(rd, st + 20))
	for i := strOff; i + 3 <= strOff + strSize; i++ {
		if rd[i] == 0 && bytesAtEqual(rd, i + 1, "_x") && rd[i + 3] == 0 {
			return fail("_x was imported")
		}
	}
	var tseg int = machoSegmentCmd(rd, "__TEXT")
	var dseg int = machoSegmentCmd(rd, "__DATA")
	if tseg < 0 || dseg < 0 { return fail("no __TEXT or __DATA segment") }
	var textOff int = cast(int, start - cast(uint64, u64(rd, tseg + 24)))
	var x uint64 = adrpAddTarget(start, u32(rd, textOff), u32(rd, textOff + 4))
	var dlo uint64 = cast(uint64, u64(rd, dseg + 24))
	if x < dlo || x + 12 > dlo + cast(uint64, u64(rd, dseg + 32)) || (x & 7) != 0 {
		return fail("_x is not an 8-aligned 12-byte object in __DATA")
	}
	return ""
}
