package "pkg/binate/link"

import "pkg/binate/buf"

// A difference S - B + A in a data field — a Mach-O SUBTRACTOR + UNSIGNED pair, which
// parse_macho joins into one InputReloc (HasSub) — is the same wherever the image loads when
// S and B are both in it or both absolute, so it needs no rebase; it is patched in place at
// its width.

// RELOC_DIFF32 / RELOC_DIFF64 are bnld's kinds for such a difference in a 4- or 8-byte
// field, numbered past every ELF relocation type so that no test of an ELF kind takes one.
const (
	RELOC_DIFF32 int = 0x10002
	RELOC_DIFF64 int = 0x10003
)

// machoDiffKind returns the difference kind of a pair of r_length rLength (2: 4 bytes, 3:
// 8), or -1 for the 1- and 2-byte pairs, which bnld does not link.
func machoDiffKind(rLength int) int {
	if rLength == 2 { return RELOC_DIFF32 }
	if rLength == 3 { return RELOC_DIFF64 }
	return -1
}

// diffAddend returns a difference's addend, the field at rAddr of secData (the word
// sign-extended, or the doubleword), with ok false when the field lies outside it.
func diffAddend(secData *[]readonly uint8, rAddr int, kind int) (int, bool) {
	if kind == RELOC_DIFF64 {
		if rAddr < 0 || rAddr + 8 > len(secData) { return 0, false }
		return cast(int, u64(secData, rAddr)), true
	}
	if rAddr < 0 || rAddr + 4 > len(secData) { return 0, false }
	return cast(int, cast(int32, u32(secData, rAddr))), true
}

// applyDiff patches relocation rel (HasSub) of object objIdx at byteLoc of data: S - B
// + A at its width, s the address of its minuend (oo / ss / found as chosenDef gave
// them).  The subtracted symbol must be defined, in an object or as a layout-defined
// absolute symbol — an undefined or imported one has no address to subtract — and in a
// sliding image (t.PIE) S and B must both be in the image or both absolute, or the
// value would change with the slide.
func applyDiff(t @SymbolTable, lr @LayoutResult, objIdx int, rel InputReloc, s uint64, oo int,
		ss int, found bool, data @[]uint8, byteLoc int) @[]readonly char {
	var obj @InputObject = t.Objs[objIdx]
	if rel.SubSymIndex < 0 || rel.SubSymIndex >= len(obj.Symbols) {
		return buf.Concat("relocation symbol index out of range in ", obj.Path)
	}
	var subName @[]char = obj.Symbols[rel.SubSymIndex].Name
	bo, bs, bfound := chosenDef(t, objIdx, rel.SubSymIndex)
	var b uint64 = 0
	var bAbs bool = true
	if bfound {
		var bok bool = false
		b, bok = definedAddr(t, lr, bo, bs)
		if !bok { return buf.Concat("unresolved symbol ", subName) }
		bAbs = t.Objs[bo].Symbols[bs].Abs
	} else {
		// A layout-defined absolute symbol (choiceAddr's fallback) has an address; an
		// undefined one, weak or not, has none to subtract.
		av, aok := t.lookupAbs(subName)
		if !aok { return buf.Concat("a difference subtracts an undefined symbol: ", subName) }
		b = av
	}
	var symName @[]char = obj.Symbols[rel.SymIndex].Name
	// A minuend no object defines is a layout-defined absolute symbol or a weak undefined one
	// (0): absolute either way.
	var sAbs bool = !found || t.Objs[oo].Symbols[ss].Abs
	if t.PIE && sAbs != bAbs {
		var msg @[]char = buf.Concat(
				buf.Concat("a difference of an absolute and an in-image symbol (", symName), " - ")
		return buf.Concat(buf.Concat(msg, subName), ") in a position-independent executable")
	}
	var v int64 = cast(int64, s) - cast(int64, b) + cast(int64, rel.Addend)
	if rel.Kind == RELOC_DIFF64 {
		if byteLoc < 0 || byteLoc + 8 > len(data) {
			return buf.Concat("relocation offset out of range in ", obj.Path)
		}
		writeU64(data, byteLoc, cast(uint64, v))
		return ""
	}
	if byteLoc < 0 || byteLoc + 4 > len(data) {
		return buf.Concat("relocation offset out of range in ", obj.Path)
	}
	return patchData(data, byteLoc, 4, v, 0 - 0x80000000, 0xffffffff, "a 4-byte difference", symName)
}
