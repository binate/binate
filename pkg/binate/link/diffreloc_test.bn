package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/buf"
import "pkg/builtins/build"
import "pkg/builtins/testing"
import "pkg/std/errors"
import "pkg/std/os"
import "pkg/std/os/process"

// Mach-O differences (SUBTRACTOR + UNSIGNED pairs) through bnld: the reader joins a pair into
// one difference relocation, a dynamic link patches S - B + A with no rebase, and a
// difference of an absolute and an in-image symbol, or one subtracting an import, fails.
// (writeMachoAsm / absDefAsm are in dynmacho_abs_test.bn, testTmpDir in link_test.bn,
// fail in parse_elf_test.bn.)

// diffProg returns `_main`, which reads two relative pointers in `_tbl` — `.long _target -
// _tbl` and `.long Ltgt - .`, Ltgt inside _target's atom — and returns 7 when both lead to
// their targets, else 0; with absK, a third word `.long K - _tbl` (K an absolute symbol).
func diffProg(absK bool) @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	a.DefineLabel("_main")
	a.SetGlobal("_main")
	aarch64.Adrp(a, aarch64.X0, "_tbl")
	isa.AddSubLo12(a, true, aarch64.X0, aarch64.X0, "_tbl", 0, false)
	a.EmitUint32(0xB9800001) // ldrsw x1, [x0]
	a.EmitUint32(0x8B010001) // add x1, x0, x1
	a.EmitUint32(0xB9800402) // ldrsw x2, [x0, #4]
	a.EmitUint32(0x8B020002) // add x2, x0, x2
	a.EmitUint32(0x91001042) // add x2, x2, #4
	aarch64.Adrp(a, aarch64.X3, "_target")
	isa.AddSubLo12(a, true, aarch64.X3, aarch64.X3, "_target", 0, false)
	a.EmitUint32(0x91001064) // add x4, x3, #4
	a.EmitUint32(0xD2800000) // mov x0, #0
	a.EmitUint32(0xEB03003F) // cmp x1, x3
	a.EmitUint32(0x540000A1) // b.ne fail
	a.EmitUint32(0xEB04005F) // cmp x2, x4
	a.EmitUint32(0x54000061) // b.ne fail
	a.EmitUint32(0xD28000E0) // mov x0, #7
	a.EmitUint32(0xD65F03C0) // ret
	a.EmitUint32(0xD65F03C0) // fail: ret
	a.DefineLabel("_target")
	a.EmitUint32(0xD503201F)
	a.DefineLabel("Ltgt")
	a.EmitUint32(0xD503201F)
	a.SetSection("data", -1)
	a.DefineLabel("_tbl")
	a.AddDiffFixup("_target", "_tbl", asm.FIX_DATA_ABS32, 0, 4)
	a.Zero(4)
	a.DefineLabel("Ldot")
	a.AddDiffFixup("Ltgt", "Ldot", asm.FIX_DATA_ABS64, 0, 8)
	a.Zero(8)
	if absK {
		a.SetGlobal("K")
		a.AddDiffFixup("K", "_tbl", asm.FIX_DATA_ABS32, 0, 4)
		a.Zero(4)
	}
	return a
}

// The reader joins each pair into one relocation: RELOC_DIFF32 / RELOC_DIFF64 of the
// UNSIGNED's symbol, subtracting the SUBTRACTOR's (HasSub), the addend the field.
func TestParseMachoDifferencePair() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var path @[]char = writeMachoAsm(diffProg(false), dir, "diff.o")
	if len(path) == 0 { return fail("cannot build the object") }
	data, ok := readFile(path)
	if !ok { return fail("cannot read the object back") }
	obj, perr := parseMachoBytes(data, path)
	if len(perr) != 0 { return fail(buf.Concat("rejected: ", perr)) }
	var seen int = 0
	for r := 0; r < len(obj.Relocs); r++ {
		var rel InputReloc = obj.Relocs[r]
		if !rel.HasSub { continue }
		var sym @[]char = obj.Symbols[rel.SymIndex].Name
		var sub @[]char = obj.Symbols[rel.SubSymIndex].Name
		if rel.Kind == RELOC_DIFF32 && charsEqual(sym, "_target") && charsEqual(sub, "_tbl") &&
				rel.Addend == 0 {
			seen = seen + 1
		}
		// Ltgt is _target + 4 and Ldot _tbl + 4: the addend stays 0.
		if rel.Kind == RELOC_DIFF64 && charsEqual(sym, "_target") && charsEqual(sub, "_tbl") &&
				rel.Addend == 0 {
			seen = seen + 2
		}
	}
	if seen != 3 { return fail("the pairs were not joined into the two differences") }
	return ""
}

// A SUBTRACTOR not followed by its UNSIGNED (here, the UNSIGNED's type changed to BRANCH26)
// is malformed.
func TestParseMachoSubtractorUnpaired() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("data", -1)
	a.DefineLabel("_d")
	a.EmitUint32(0)
	a.DefineLabel("_e")
	a.AddDiffFixup("_d", "_e", asm.FIX_DATA_ABS32, 0, 4)
	a.Zero(4)
	var path @[]char = writeMachoAsm(a, dir, "unpaired.o")
	if len(path) == 0 { return fail("cannot build the object") }
	data, ok := readFile(path)
	if !ok { return fail("cannot read the object back") }
	// The first section's relocations: reloff at section_64 + 56; entry 1's info word.
	var reloff int = cast(int, u32(data, 32 + 72 + 56))
	var e int = reloff + 8 + 7
	data[e] = cast(uint8, (cast(int, data[e]) & 0x0f) | 0x20) // r_type 2 (BRANCH26)
	_, perr := parseMachoBytes(data, path)
	var want *[]readonly char = "an ARM64_RELOC_SUBTRACTOR not followed by its UNSIGNED"
	if len(perr) < len(want) || !charsEqual(perr[0:len(want)], want) {
		return fail(buf.Concat("not rejected as unpaired: ", perr))
	}
	return ""
}

// The program links into a dynamic executable; on a macOS arm64 host it runs (dyld slides
// it, the differences needing no rebase) and both relative pointers reach their targets.
func TestLinkDynMachoDifferenceRuns() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = writeMachoAsm(diffProg(false), dir, "diff_prog.o")
	if len(paths[0]) == 0 { return fail("cannot build the object") }
	var exe @[]char = buf.Concat(dir, "/diff_run")
	var err @[]readonly char = LinkDynMacho(paths, "_main", EM_AARCH64, cast(uint64, 0x100004000), exe)
	if len(err) != 0 { return fail(buf.Concat("LinkDynMacho failed: ", err)) }
	if build.OS != build.OS_DARWIN || build.Arch != build.ARCH_AARCH64 { return "" }
	var st process.ExitStatus
	var perr @errors.Error
	st, perr = process.Run(exe, &process.Options{Args: make_slice(@[]char, 0)})
	if present(perr) || !st.Exited() { return fail("the executable did not run to exit") }
	if st.Code() != 7 { return fail("a relative pointer missed its target (exit not 7)") }
	return ""
}

// In a sliding image, a difference of an absolute symbol (K) and an in-image one changes with
// the slide: the link fails.
func TestLinkDynMachoDifferenceAbsoluteRejected() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var paths @[]@[]char = make_slice(@[]char, 2)
	paths[0] = writeMachoAsm(diffProg(true), dir, "diff_abs.o")
	paths[1] = writeMachoAsm(absDefAsm(), dir, "abs_def.o")
	if len(paths[0]) == 0 || len(paths[1]) == 0 { return fail("cannot build the objects") }
	var err @[]readonly char = LinkDynMacho(paths, "_main", EM_AARCH64, cast(uint64, 0x100004000),
			buf.Concat(dir, "/diff_abs"))
	var want *[]readonly char = "a difference of an absolute and an in-image symbol (K - _tbl)"
	if len(err) < len(want) || !charsEqual(err[0:len(want)], want) {
		return fail(buf.Concat("not rejected: ", err))
	}
	return ""
}

// A difference subtracting a dynamic import has no address to subtract: the link fails.
func TestLinkDynMachoDifferenceSubtractingImport() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = diffProg(false)
	a.SetGlobal("___stdoutp")
	a.AddDiffFixup("_tbl", "___stdoutp", asm.FIX_DATA_ABS64, 0, 8)
	a.Zero(8)
	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = writeMachoAsm(a, dir, "diff_imp.o")
	if len(paths[0]) == 0 { return fail("cannot build the object") }
	var err @[]readonly char = LinkDynMacho(paths, "_main", EM_AARCH64, cast(uint64, 0x100004000),
			buf.Concat(dir, "/diff_imp"))
	var want *[]readonly char = "dynamic import reached by an unsupported"
	if len(err) < len(want) || !charsEqual(err[0:len(want)], want) {
		return fail(buf.Concat("not rejected: ", err))
	}
	return ""
}

// pairObj writes an object whose data section holds `_a: .uint32 0` then one difference
// `_c - _a + addend` of size bytes (_c after it) and returns its bytes and path.
func pairObj(dir *[]readonly char, kind int, size int, addend int) (@[]uint8, @[]char) {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("data", -1)
	a.DefineLabel("_a")
	a.EmitUint32(0)
	a.AddDiffFixup("_c", "_a", kind, addend, size)
	a.Zero(size)
	a.DefineLabel("_c")
	a.EmitUint32(0)
	var path @[]char = writeMachoAsm(a, dir, "pair.o")
	if len(path) == 0 { return make_slice(uint8, 0), path }
	data, _ := readFile(path)
	return data, path
}

// parseErrIs reports whether parsing data fails with an error starting want.
func parseErrIs(data @[]uint8, path *[]readonly char, want *[]readonly char) bool {
	_, perr := parseMachoBytes(data, path)
	return len(perr) >= len(want) && charsEqual(perr[0:len(want)], want)
}

// A 4-byte difference's addend is the field sign-extended (-4 here), and the pair's
// malformed shapes are errors: a 1-byte pair (not linked), a SUBTRACTOR left at the
// section's end, an UNSIGNED at another address.
func TestParseMachoDifferenceShapes() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	data, path := pairObj(dir, asm.FIX_DATA_ABS32, 4, -4)
	if len(data) == 0 { return fail("cannot build the object") }
	obj, perr := parseMachoBytes(data, path)
	if len(perr) != 0 { return fail(buf.Concat("rejected: ", perr)) }
	if len(obj.Relocs) != 1 || !obj.Relocs[0].HasSub || obj.Relocs[0].Addend != -4 {
		return fail("the 4-byte addend not sign-extended")
	}
	var reloff int = cast(int, u32(data, 32 + 72 + 56))
	data[reloff + 8] = cast(uint8, cast(int, data[reloff + 8]) + 1) // the UNSIGNED's r_address
	if !parseErrIs(data, path, "an ARM64_RELOC_SUBTRACTOR not followed by its UNSIGNED") {
		return fail("an UNSIGNED at another address accepted")
	}
	data, path = pairObj(dir, asm.FIX_DATA_ABS32, 4, 0)
	data[32 + 72 + 60] = 1 // nreloc: the SUBTRACTOR alone
	if !parseErrIs(data, path, "an ARM64_RELOC_SUBTRACTOR without its UNSIGNED") {
		return fail("a SUBTRACTOR at the section's end accepted")
	}
	data, path = pairObj(dir, asm.FIX_DATA_ABS8, 1, 0)
	if !parseErrIs(data, path, "a 1- or 2-byte Mach-O difference is not linked") {
		return fail("a 1-byte pair accepted")
	}
	return ""
}
