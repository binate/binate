package "pkg/binate/link"

import "pkg/binate/buf"

// Dynamic ELF linking (aarch64).  A dynamically-linked executable resolves its
// undefined externals (e.g. libc's `exit`) from shared libraries at load time via the
// platform dynamic linker (ld-linux-aarch64.so.1), instead of erroring on them.  We
// synthesize the loader-facing machinery — .interp, .hash, .dynsym, .dynstr,
// .rela.plt, .plt, .got.plt, .dynamic — as a single extra "dynamic stubs" input
// object, then reuse the ordinary Resolve → Layout → Relocate pipeline: the stubs
// object *defines* each import at its PLT stub, so the program's `bl exit` retargets
// through the PLT like any cross-object call, while ld.so binds the real address into
// the GOT at load (we set DF_BIND_NOW, so there is no lazy resolver).  See
// explorations/plan-dynamic-linking.md for the validated byte-level recipe.

// ELF dynamic-array tags (Elf64_Dyn.d_tag) and symbol/flag constants used below.
const (
	DT_NULL int = 0
	DT_NEEDED int = 1
	DT_SONAME int = 14
	DT_PLTRELSZ int = 2
	DT_PLTGOT int = 3
	DT_HASH int = 4
	DT_STRTAB int = 5
	DT_SYMTAB int = 6
	DT_RELA int = 7
	DT_RELASZ int = 8
	DT_RELAENT int = 9
	DT_STRSZ int = 10
	DT_SYMENT int = 11
	DT_PLTREL int = 20
	DT_JMPREL int = 23
	DT_BIND_NOW int = 24
	DT_FLAGS int = 30
	DF_BIND_NOW int = 0x8
	STT_NOTYPE int = 0
	STT_FUNC int = 2
)

// Import kinds: how a program references an undefined external decides how the
// dynamic linker must satisfy it.  A *called* symbol needs a PLT stub + a JUMP_SLOT
// in .got.plt (the program branches to the stub); an *address-taken* symbol — a data
// global like libc `environ`, or a function pointer — needs a GOT slot + a GLOB_DAT
// in .got (the program loads the slot).  The two are patched and relocated
// differently, so each import is classified from the relocations that reach it.
const (
	impPlt int = 0 // called: PLT stub + JUMP_SLOT
	impGot int = 1 // address-taken/data: GOT slot + GLOB_DAT
)

// dynInterp is the Linux dynamic-linker path for the machine (NUL-terminated).
func dynInterp(machine int) @[]uint8 {
	var s *[]readonly char = "/lib/ld-linux-aarch64.so.1"
	if machine == EM_X86_64 { s = "/lib64/ld-linux-x86-64.so.2" }
	var out @[]uint8 = make_slice(uint8, len(s) + 1)
	for i := 0; i < len(s); i++ { out[i] = cast(uint8, s[i]) }
	return out // last byte stays 0 (NUL)
}

// dynJumpSlot returns the machine's PLT GOT-slot relocation type (.rela.plt).
func dynJumpSlot(machine int) int {
	if machine == EM_X86_64 { return R_X86_64_JUMP_SLOT }
	return R_AARCH64_JUMP_SLOT
}

// dynGlobDat returns the machine's GOT-slot data relocation type (.rela.dyn).
func dynGlobDat(machine int) int {
	if machine == EM_X86_64 { return R_X86_64_GLOB_DAT }
	return R_AARCH64_GLOB_DAT
}

// isCallReloc reports whether a relocation kind is a direct call/branch to its
// target (aarch64 CALL26/JUMP26, x86-64 PLT32) — the mark of a *called* import,
// satisfied by a PLT stub.
func isCallReloc(kind int) bool {
	return kind == R_AARCH64_CALL26 || kind == R_AARCH64_JUMP26 || kind == R_X86_64_PLT32
}

// isGotReloc reports whether a relocation kind is a GOT-indirect load of its
// target's address (aarch64 ADR_GOT_PAGE/LD64_GOT_LO12_NC, x86-64
// GOTPCRELX/REX_GOTPCRELX) — the mark of an *address-taken* import, satisfied by a
// GOT slot + GLOB_DAT.
func isGotReloc(kind int) bool {
	return kind == R_AARCH64_ADR_GOT_PAGE || kind == R_AARCH64_LD64_GOT_LO12_NC ||
			kind == R_X86_64_GOTPCRELX || kind == R_X86_64_REX_GOTPCRELX
}

// isAbs64Reloc reports whether a relocation kind stores its target's absolute 64-bit
// address as a data word (aarch64 ABS64, x86-64 R_X86_64_64) — e.g. `.quad sym`.
// Against a *dynamic import* this has no link-time address to write, so classifyImports
// rejects it (rather than letting it silently resolve to the import's PLT stub — the
// wrong address, especially for a data symbol).  A GOT-indirect reference is the
// supported way to take an import's address.  (Mach-O ARM64_RELOC_UNSIGNED-8 normalizes
// to R_AARCH64_ABS64 in parse_macho, so this covers both backends.)
func isAbs64Reloc(kind int) bool {
	return kind == R_AARCH64_ABS64 || kind == R_X86_64_64
}

// classifyImports decides, for each import name, whether the program reaches it by a
// call (impPlt) or by a GOT-indirect load (impGot), by scanning every relocation in
// objs whose target symbol is that import.  A name reached only via the GOT is a data
// import; anything else defaults to a PLT import (a plain call, or an undefined that
// no relocation reaches — harmless as an unused PLT stub).  A name reached *both*
// ways is rejected: it would need a PLT stub and a GOT slot at once, which the single
// per-symbol definition here cannot express (rare — the real targets never collide,
// e.g. exit/puts are call-only and environ/stdout GOT-only).  A name reached by an
// ABS64 (absolute-pointer) relocation is also rejected: a dynamic import has no
// link-time address, so an unhandled ABS64 would silently resolve to the import's PLT
// stub (the wrong address); the supported way to take an import's address is a
// GOT-indirect reference.  Returns (kinds, "") or (kinds, error).
func classifyImports(objs @[]@InputObject, names @[]@[]char) (@[]int, @[]readonly char) {
	var n int = len(names)
	var kinds @[]int = make_slice(int, n)
	var sawCall @[]bool = make_slice(bool, n)
	var sawGot @[]bool = make_slice(bool, n)
	var sawAbs64 @[]bool = make_slice(bool, n)
	for o := 0; o < len(objs); o++ {
		var obj @InputObject = objs[o]
		for r := 0; r < len(obj.Relocs); r++ {
			var rel InputReloc = obj.Relocs[r]
			if rel.SymIndex < 0 || rel.SymIndex >= len(obj.Symbols) { continue }
			var idx int = nameIndex(names, n, obj.Symbols[rel.SymIndex].Name)
			if idx < 0 { continue } // not an import
			if isCallReloc(rel.Kind) { sawCall[idx] = true }
			if isGotReloc(rel.Kind) { sawGot[idx] = true }
			if isAbs64Reloc(rel.Kind) { sawAbs64[idx] = true }
		}
	}
	for i := 0; i < n; i++ {
		if sawAbs64[i] {
			return kinds,
				buf.Concat(
						"ABS64 (absolute-pointer) relocation against a dynamic "
								"import is unsupported (use a GOT-indirect reference): ",
						names[i])
		}
		if sawCall[i] && sawGot[i] {
			return kinds, buf.Concat("symbol both called and address-taken (unsupported): ", names[i])
		}
		if sawGot[i] {
			kinds[i] = impGot
		} else {
			kinds[i] = impPlt
		}
	}
	return kinds, ""
}

// gotImportNames returns the subset of names classified impGot — the data (GOT)
// imports, recorded on the SymbolTable so Relocate keeps their GOT loads pointing at
// the GOT slot rather than relaxing them to a direct address.
func gotImportNames(names @[]@[]char, kinds @[]int) @[]@[]char {
	var c int = 0
	for i := 0; i < len(names); i++ { if kinds[i] == impGot { c = c + 1 } }
	var out @[]@[]char = make_slice(@[]char, c)
	var w int = 0
	for i := 0; i < len(names); i++ {
		if kinds[i] == impGot { out[w] = names[i]; w = w + 1 }
	}
	return out
}

// writePltStub writes the machine's PLT stub at out[off:off+16]: a jump through the
// import's GOT slot.  With DF_BIND_NOW the slot already holds the resolved address, so
// the stub needs no lazy-resolver tail.  stubVa is the stub's virtual address, gotSlot
// the GOT slot's virtual address.  Returns "" or, if the stub-to-GOT displacement does
// not fit the instruction's field, a non-empty error (unreachable in a normal
// executable — .plt and .got.plt are always a few pages apart — but a loud failure
// rather than a silently-truncated jump if that ever changes).
func writePltStub(out @[]uint8, off int, machine int, stubVa uint, gotSlot uint) @[]readonly char {
	if machine == EM_X86_64 {
		// jmp *disp32(%rip) ; RIP is the address after the 6-byte instruction.
		var disp int = cast(int, gotSlot) - (cast(int, stubVa) + 6)
		if disp > 0x7fffffff || disp < (0 - 0x80000000) {
			return "x86-64 PLT stub displacement out of range"
		}
		out[off + 0] = cast(uint8, 0xff)
		out[off + 1] = cast(uint8, 0x25)
		writeLE(out, off + 2, disp, 4)
		return ""
	}
	// aarch64: adrp x16,GOTpage ; ldr x17,[x16,#:lo12] ; add x16,x16,#:lo12 ; br x17.
	// The ADRP immediate is a signed 21-bit page count (±4GB).
	var pageMask int = 0 - 0x1000
	var pages int = ((cast(int, gotSlot) & pageMask) - (cast(int, stubVa) & pageMask)) >> 12
	if pages > 0xfffff || pages < (0 - 0x100000) {
		return "aarch64 PLT stub ADRP page offset out of range"
	}
	var lo int = cast(int, gotSlot & cast(uint, 0xfff))
	writeLE(out, off + 0, encAdrp(16, stubVa, gotSlot), 4)
	writeLE(out, off + 4, encLdr64(17, 16, lo), 4)
	writeLE(out, off + 8, encAdd64(16, 16, lo), 4)
	writeLE(out, off + 12, encBr(17), 4)
	return ""
}

// aarch64 PLT-stub instruction encoders (Xd/Xn are register numbers).
func encAdrp(rd int, frm uint, to uint) int {
	// Page-align by subtracting the low 12 bits (avoids a negative page mask).
	var pto uint = to - (to % 0x1000)
	var pfrm uint = frm - (frm % 0x1000)
	var imm int = (cast(int, pto) - cast(int, pfrm)) >> 12
	return 0x90000000 | ((imm & 0x3) << 29) | (((imm >> 2) & 0x7ffff) << 5) | rd
}

// encLdr64 encodes `ldr Xt, [Xn, #off]` (unsigned offset, scaled by 8).
func encLdr64(rt int, rn int, off int) int {
	return 0xf9400000 | ((off / 8) << 10) | (rn << 5) | rt
}

// encAdd64 encodes `add Xd, Xn, #imm` (12-bit unsigned immediate).
func encAdd64(rd int, rn int, imm int) int { return 0x91000000 | (imm << 10) | (rn << 5) | rd }

// encBr encodes `br Xn` (branch to register).
func encBr(rn int) int { return 0xd61f0000 | (rn << 5) }

// collectImports returns the distinct undefined global/weak symbol names across objs
// that no object defines — the dynamic imports to satisfy from shared libraries — with
// each name's binding.  A weak undefined reference becomes a weak import (STB_WEAK, so
// ld.so binds it if a library provides it and resolves it to 0 otherwise); a global
// one is a required import.  A name referenced both ways is imported as global.
func collectImports(objs @[]@InputObject) (@[]@[]char, @[]int) {
	var cap int = 0
	for o := 0; o < len(objs); o++ { cap = cap + len(objs[o].Symbols) }
	var names @[]@[]char = make_slice(@[]char, cap)
	var binds @[]int = make_slice(int, cap)
	var n int = 0
	for o := 0; o < len(objs); o++ {
		for s := 0; s < len(objs[o].Symbols); s++ {
			var sym InputSymbol = objs[o].Symbols[s]
			if sym.SecIndex >= 0 || len(sym.Name) == 0 { continue }
			if sym.Binding != BIND_GLOBAL && sym.Binding != BIND_WEAK { continue }
			if definedBySome(objs, sym.Name) { continue }
			var idx int = nameIndex(names, n, sym.Name)
			if idx < 0 {
				names[n] = buf.CopyStr(sym.Name)
				binds[n] = sym.Binding
				n = n + 1
			} else if sym.Binding == BIND_GLOBAL {
				binds[idx] = BIND_GLOBAL // a strong reference wins over a weak one
			}
		}
	}
	var outNames @[]@[]char = make_slice(@[]char, n)
	var outBinds @[]int = make_slice(int, n)
	for i := 0; i < n; i++ {
		outNames[i] = names[i]
		outBinds[i] = binds[i]
	}
	return outNames, outBinds
}

// definedBySome reports whether any object defines name (a section-bound global/weak).
func definedBySome(objs @[]@InputObject, name *[]readonly char) bool {
	for o := 0; o < len(objs); o++ {
		for s := 0; s < len(objs[o].Symbols); s++ {
			var sym InputSymbol = objs[o].Symbols[s]
			if sym.SecIndex >= 0 && charsEqual(sym.Name, name) &&
					(sym.Binding == BIND_GLOBAL || sym.Binding == BIND_WEAK) {
				return true
			}
		}
	}
	return false
}

// mkDynSection builds one synthetic InputSection with the given name/flags/align and
// a zero-or-content Data slice of the given size.
func mkDynSection(name *[]readonly char, flags int, align int, data @[]uint8) InputSection {
	var sec InputSection
	sec.Name = buf.CopyStr(name)
	sec.Type = SHT_PROGBITS
	sec.Flags = flags
	sec.Data = data
	sec.Size = cast(uint, len(data))
	sec.Align = align
	sec.OutIndex = -1
	sec.OutOffset = cast(uint, 0)
	return sec
}

// dynStrtab builds the .dynstr blob (leading NUL, then each import name, then each
// needed-library name) and returns it with each import's offset and each lib's offset
// (one per needed library, in order — one DT_NEEDED points at each).
func dynStrtab(imports @[]@[]char, libs @[]@[]char) (@[]uint8, @[]int, @[]int) {
	var total int = 1
	for i := 0; i < len(imports); i++ { total = total + len(imports[i]) + 1 }
	var libOffs @[]int = make_slice(int, len(libs))
	for i := 0; i < len(libs); i++ {
		libOffs[i] = total
		total = total + len(libs[i]) + 1
	}
	var out @[]uint8 = make_slice(uint8, total)
	var offs @[]int = make_slice(int, len(imports))
	var p int = 1
	for i := 0; i < len(imports); i++ {
		offs[i] = p
		for j := 0; j < len(imports[i]); j++ { out[p] = cast(uint8, imports[i][j]); p = p + 1 }
		p = p + 1 // NUL
	}
	for i := 0; i < len(libs); i++ {
		for j := 0; j < len(libs[i]); j++ { out[p] = cast(uint8, libs[i][j]); p = p + 1 }
		p = p + 1 // NUL
	}
	return out, offs, libOffs
}
