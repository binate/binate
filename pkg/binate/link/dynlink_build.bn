package "pkg/binate/link"

import "pkg/binate/buf"

// Synthesis + driver for dynamic ELF linking (see dynlink.bn for the overview).

// Synthetic-object section indices (the order buildDynStubs emits them in).  .rela.dyn
// carries the GLOB_DAT relocations for data (GOT) imports; .got holds their slots,
// distinct from .got.plt's JUMP_SLOT slots for called (PLT) imports.
const (
	dsInterp int = 0
	dsHash int = 1
	dsDynsym int = 2
	dsDynstr int = 3
	dsRelaplt int = 4
	dsReladyn int = 5
	dsPlt int = 6
	dsGot int = 7
	dsGotplt int = 8
	dsDynamic int = 9
	dsSectionCount int = 10
	dynEntryBase int = 13   // .dynamic entries without data imports (no DT_RELA trio)
	dynEntryMax int = 16    // .dynamic entries WITH the DT_RELA/RELASZ/RELAENT trio
	pltStubSize int = 16
	gotEntSize int = 8
	relaEntSize int = 24
	symEntSize int = 24
)

// dynSymtab builds the .dynsym blob: a null entry then one UND entry per import
// (st_name = its .dynstr offset), with the import's binding in st_info's high nibble
// — STB_GLOBAL (required) or STB_WEAK (bound if available, else 0) — and its type in
// the low nibble: STT_FUNC for a called (PLT) import, STT_NOTYPE for a data (GOT)
// import (which may be a data object or an address-taken function).  The binding
// value is the ELF st_info binding directly (BIND_GLOBAL=1 / BIND_WEAK=2).
func dynSymtab(imports @[]@[]char, strOffs @[]int, binds @[]int, kinds @[]int) @[]uint8 {
	var n int = len(imports)
	var out @[]uint8 = make_slice(uint8, (n + 1) * symEntSize)
	for i := 0; i < n; i++ {
		var e int = (i + 1) * symEntSize
		var stype int = STT_FUNC
		if kinds[i] == impGot { stype = STT_NOTYPE }
		writeLE(out, e + 0, strOffs[i], 4) // st_name
		out[e + 4] = cast(uint8, (binds[i] << 4) | stype) // st_info
		// st_other(1)/st_shndx(2)=SHN_UNDEF/st_value(8)/st_size(8) stay zero.
	}
	return out
}

// dynHash builds a minimal SysV .hash over nsym symbols: one bucket, so all symbols
// chain from bucket[0].  Layout: nbucket, nchain, bucket[1], chain[nsym].
func dynHash(nsym int) @[]uint8 {
	var out @[]uint8 = make_slice(uint8, (3 + nsym) * 4)
	writeLE(out, 0, 1, 4) // nbucket
	writeLE(out, 4, nsym, 4) // nchain
	if nsym > 1 { writeLE(out, 8, 1, 4) } // bucket[0] = first real symbol
	// chain[i] = i+1 for the interior symbols; chain[nsym-1] = 0 (STN_UNDEF, end).
	for i := 1; i < nsym - 1; i++ { writeLE(out, 12 + i * 4, i + 1, 4) }
	return out
}

// countKind returns how many of kinds equal want.
func countKind(kinds @[]int, want int) int {
	var c int = 0
	for i := 0; i < len(kinds); i++ { if kinds[i] == want { c = c + 1 } }
	return c
}

// dynEntryCount returns the number of .dynamic entries for a link with nGot data
// imports: the base set, plus the DT_RELA/DT_RELASZ/DT_RELAENT trio only when there
// is a .rela.dyn to describe.  A binary with no data relocations must NOT carry
// DT_RELA at all — an empty .rela.dyn adjacent to .rela.plt makes glibc's ld.so skip
// the PLT (JUMP_SLOT) relocations entirely, so a called import binds to address 0 and
// the program jumps to null.  (Matches what ld/lld emit: no DT_RELA when empty.)
func dynEntryCount(nGot int) int {
	if nGot > 0 { return dynEntryMax }
	return dynEntryBase
}

// buildDynStubs assembles the synthetic "dynamic stubs" object: the loader-facing
// sections (content-complete for .interp/.hash/.dynsym/.dynstr; correctly-sized zero
// placeholders for .rela.plt/.rela.dyn/.plt/.got/.got.plt/.dynamic, patched after
// Layout) plus a global symbol per import defined at its slot — a called (PLT) import
// at its .plt stub (so the program's call resolves through the PLT), a data (GOT)
// import at its .got slot (so a GOT-indirect load reads the slot).  Returns the object
// and the needed-library's .dynstr offset.
func buildDynStubs(imports @[]@[]char, binds @[]int, kinds @[]int, lib *[]readonly char,
		machine int) (@InputObject, int) {
	strtab, strOffs, libOff := dynStrtab(imports, lib)
	var n int = len(imports)
	var nPlt int = countKind(kinds, impPlt)
	var nGot int = countKind(kinds, impGot)
	var secs @[]InputSection = make_slice(InputSection, dsSectionCount)
	secs[dsInterp] = mkDynSection(".interp", SF_READ, 1, dynInterp(machine))
	secs[dsHash] = mkDynSection(".hash", SF_READ, 8, dynHash(n + 1))
	secs[dsDynsym] = mkDynSection(".dynsym", SF_READ, 8, dynSymtab(imports, strOffs, binds, kinds))
	secs[dsDynstr] = mkDynSection(".dynstr", SF_READ, 1, strtab)
	secs[dsRelaplt] = mkDynSection(".rela.plt", SF_READ, 8, make_slice(uint8, nPlt * relaEntSize))
	secs[dsReladyn] = mkDynSection(".rela.dyn", SF_READ, 8, make_slice(uint8, nGot * relaEntSize))
	secs[dsPlt] = mkDynSection(".plt", SF_READ | SF_EXEC, 4, make_slice(uint8, nPlt * pltStubSize))
	secs[dsGot] = mkDynSection(".got", SF_READ | SF_WRITE, 8, make_slice(uint8, nGot * gotEntSize))
	secs[dsGotplt] = mkDynSection(".got.plt", SF_READ | SF_WRITE, 8,
			make_slice(uint8, (3 + nPlt) * gotEntSize))
	secs[dsDynamic] = mkDynSection(".dynamic", SF_READ | SF_WRITE, 8,
			make_slice(uint8, dynEntryCount(nGot) * 16))

	// Define each import at its slot, in unified order, tracking the per-kind ordinal
	// (PLT stub index / GOT slot index).
	var syms @[]InputSymbol = make_slice(InputSymbol, n)
	var j int = 0 // PLT stub ordinal
	var k int = 0 // GOT slot ordinal
	for i := 0; i < n; i++ {
		var sym InputSymbol
		sym.Name = buf.CopyStr(imports[i])
		if kinds[i] == impGot {
			sym.SecIndex = dsGot
			sym.Value = cast(uint, k * gotEntSize)
			k = k + 1
		} else {
			sym.SecIndex = dsPlt
			sym.Value = cast(uint, j * pltStubSize)
			j = j + 1
		}
		sym.Binding = BIND_GLOBAL
		syms[i] = sym
	}

	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr("<dynamic-stubs>")
	obj.Machine = machine
	obj.Sections = secs
	obj.Symbols = syms
	obj.Relocs = make_slice(InputReloc, 0)
	return obj, libOff
}

// secVaddr returns the final virtual address of the dynObj section at index k.
func secVaddr(dynObj @InputObject, lr @LayoutResult, k int) uint {
	var s InputSection = dynObj.Sections[k]
	return lr.Sections[s.OutIndex].Addr + s.OutOffset
}

// outData returns the merged output-section byte slice holding dynObj section k, and
// the byte offset of section k within it.
func outData(dynObj @InputObject, lr @LayoutResult, k int) (@[]uint8, int) {
	var s InputSection = dynObj.Sections[k]
	return lr.Sections[s.OutIndex].Data, cast(int, s.OutOffset)
}

// patchDynSections fills the address-dependent synthetic sections now that Layout has
// assigned addresses: the PLT stubs (jump through .got.plt), .got.plt[0] (&.dynamic),
// the .rela.plt JUMP_SLOT relocations (called imports), the .rela.dyn GLOB_DAT
// relocations (data imports → their .got slots), and the .dynamic array.  The .got
// slots themselves stay zero — ld.so writes the resolved data addresses into them.
func patchDynSections(dynObj @InputObject, lr @LayoutResult, imports @[]@[]char, kinds @[]int,
		libOff int, machine int) @[]readonly char {
	var n int = len(imports)
	var nPlt int = countKind(kinds, impPlt)
	var nGot int = countKind(kinds, impGot)
	var pltVa uint = secVaddr(dynObj, lr, dsPlt)
	var gotpltVa uint = secVaddr(dynObj, lr, dsGotplt)
	var gotVa uint = secVaddr(dynObj, lr, dsGot)
	var relaPltVa uint = secVaddr(dynObj, lr, dsRelaplt)
	var relaDynVa uint = secVaddr(dynObj, lr, dsReladyn)
	var dynVa uint = secVaddr(dynObj, lr, dsDynamic)
	var hashVa uint = secVaddr(dynObj, lr, dsHash)
	var symVa uint = secVaddr(dynObj, lr, dsDynsym)
	var strVa uint = secVaddr(dynObj, lr, dsDynstr)
	var strSize int = len(dynObj.Sections[dsDynstr].Data)

	// .got.plt[0] = &.dynamic (glibc convention); [1],[2] and the import slots stay 0
	// (ld.so writes the resolved addresses into the import slots).
	gotpltData, gotpltOff := outData(dynObj, lr, dsGotplt)
	writeLE(gotpltData, gotpltOff, cast(int, dynVa), 8)

	// One pass over the imports in unified order fills, per kind: a PLT stub +
	// .rela.plt JUMP_SLOT (impPlt), or a .rela.dyn GLOB_DAT (impGot).  j/k are the
	// per-kind ordinals (matching the slot layout buildDynStubs used); i+1 is the
	// .dynsym index (a null entry precedes the imports).
	var jumpSlot int = dynJumpSlot(machine)
	var globDat int = dynGlobDat(machine)
	pltData, pltOff := outData(dynObj, lr, dsPlt)
	relaPltData, relaPltOff := outData(dynObj, lr, dsRelaplt)
	relaDynData, relaDynOff := outData(dynObj, lr, dsReladyn)
	var j int = 0
	var k int = 0
	for i := 0; i < n; i++ {
		if kinds[i] == impGot {
			// .got slot k, GLOB_DAT → it.
			var e int = relaDynOff + k * relaEntSize
			writeLE(relaDynData, e + 0, cast(int, gotVa) + k * gotEntSize, 8) // r_offset
			writeLE(relaDynData, e + 8, ((i + 1) << 32) | globDat, 8) // r_info
			k = k + 1
		} else {
			// .got.plt slot 3+j, a PLT stub that jumps through it, JUMP_SLOT → it.
			var gotSlot uint = gotpltVa + cast(uint, (3 + j) * gotEntSize)
			var stubVa uint = pltVa + cast(uint, j * pltStubSize)
			var serr @[]readonly char = writePltStub(pltData, pltOff + j * pltStubSize, machine, stubVa,
					gotSlot)
			if len(serr) != 0 { return serr }
			var e int = relaPltOff + j * relaEntSize
			writeLE(relaPltData, e + 0, cast(int, gotpltVa) + (3 + j) * gotEntSize, 8) // r_offset
			writeLE(relaPltData, e + 8, ((i + 1) << 32) | jumpSlot, 8) // r_info
			j = j + 1
		}
		// r_addend stays 0 in both tables.
	}

	// .dynamic array.
	dynData, dynOff := outData(dynObj, lr, dsDynamic)
	var d int = dynOff
	writeDyn(dynData, d, DT_NEEDED, libOff)
	d = d + 16
	writeDyn(dynData, d, DT_HASH, cast(int, hashVa))
	d = d + 16
	writeDyn(dynData, d, DT_STRTAB, cast(int, strVa))
	d = d + 16
	writeDyn(dynData, d, DT_SYMTAB, cast(int, symVa))
	d = d + 16
	writeDyn(dynData, d, DT_STRSZ, strSize)
	d = d + 16
	writeDyn(dynData, d, DT_SYMENT, symEntSize)
	d = d + 16
	writeDyn(dynData, d, DT_PLTGOT, cast(int, gotpltVa))
	d = d + 16
	writeDyn(dynData, d, DT_PLTRELSZ, nPlt * relaEntSize)
	d = d + 16
	writeDyn(dynData, d, DT_PLTREL, 7) // DT_RELA
	d = d + 16
	writeDyn(dynData, d, DT_JMPREL, cast(int, relaPltVa))
	d = d + 16
	// .rela.dyn (GLOB_DAT for data imports) — only when there is one.  Emitting a
	// zero-size DT_RELA here makes glibc's ld.so skip the JUMP_SLOT relocations (see
	// dynEntryCount), so this trio is omitted entirely when nGot == 0.
	if nGot > 0 {
		writeDyn(dynData, d, DT_RELA, cast(int, relaDynVa))
		d = d + 16
		writeDyn(dynData, d, DT_RELASZ, nGot * relaEntSize)
		d = d + 16
		writeDyn(dynData, d, DT_RELAENT, relaEntSize)
		d = d + 16
	}
	writeDyn(dynData, d, DT_FLAGS, DF_BIND_NOW)
	d = d + 16
	writeDyn(dynData, d, DT_BIND_NOW, 0)
	d = d + 16
	writeDyn(dynData, d, DT_NULL, 0)
	return ""
}

// writeDyn writes one Elf64_Dyn (d_tag, d_val), each 8 bytes little-endian.
func writeDyn(dst @[]uint8, off int, tag int, val int) {
	writeLE(dst, off + 0, tag, 8)
	writeLE(dst, off + 8, val, 8)
}

// LinkDynElf links inputPaths into a dynamically-linked ELF executable (aarch64 or
// x86-64) at outPath, entering at entryName.  Undefined externals become dynamic
// imports from libc.so.6, resolved at load by the platform dynamic linker
// (ld-linux-aarch64.so.1 / ld-linux-x86-64.so.2).  Returns "" or an error.
func LinkDynElf(inputPaths @[]@[]char, entryName *[]readonly char, machine int, base uint,
		outPath *[]readonly char) @[]readonly char {
	if machine != EM_AARCH64 && machine != EM_X86_64 {
		return "dynamic linking supports aarch64 and x86-64"
	}

	var objs @[]@InputObject = make_slice(@InputObject, len(inputPaths))
	var nObj int = 0
	var archives @[]@[]@InputObject = make_slice(@[]@InputObject, len(inputPaths))
	var nArch int = 0
	for i := 0; i < len(inputPaths); i++ {
		data, ok := readFile(inputPaths[i])
		if !ok { return buf.Concat("cannot read input file: ", inputPaths[i]) }
		// bnlint:allow managed-to-raw-assign - a live read-only view of the input bytes
		var raw *[]readonly uint8 = data
		if len(raw) >= 4 && raw[0] == 0x7f && raw[1] == 0x45 && raw[2] == 0x4c && raw[3] == 0x46 {
			obj, perr := parseObjectBytes(raw, inputPaths[i])
			if len(perr) != 0 { return perr }
			objs[nObj] = obj
			nObj = nObj + 1
		} else if arMagicOk(raw) {
			members, aerr := parseArchiveBytes(raw, inputPaths[i])
			if len(aerr) != 0 { return aerr }
			archives[nArch] = members
			nArch = nArch + 1
		} else {
			return buf.Concat("input is not an ELF object or an archive: ", inputPaths[i])
		}
	}
	var program @[]@InputObject = selectMembers(objs[0:nObj], archives[0:nArch])
	for i := 0; i < len(program); i++ {
		if program[i].Machine != machine {
			return buf.Concat("object machine does not match the target: ", program[i].Path)
		}
	}

	imports, binds := collectImports(program)
	kinds, cerr := classifyImports(program, imports)
	if len(cerr) != 0 { return cerr }
	dynObj, libOff := buildDynStubs(imports, binds, kinds, "libc.so.6", machine)

	var allObjs @[]@InputObject = make_slice(@InputObject, len(program) + 1)
	for i := 0; i < len(program); i++ { allObjs[i] = program[i] }
	allObjs[len(program)] = dynObj

	t, rerr := Resolve(allObjs)
	if len(rerr) != 0 { return rerr }
	// Data (GOT) imports: Relocate must keep their GOT loads pointing at the GOT slot
	// (ld.so fills it via GLOB_DAT) rather than relaxing them to a direct address.
	t.GotImports = gotImportNames(imports, kinds)
	var lr @LayoutResult = Layout(allObjs, base)

	oo, ss, found := t.Lookup(entryName)
	if !found { return buf.Concat("entry symbol not defined: ", entryName) }
	entryAddr, ok := symbolAddr(t, lr, oo, ss)
	if !ok { return buf.Concat("entry symbol has no address: ", entryName) }

	var derr @[]readonly char = patchDynSections(dynObj, lr, imports, kinds, libOff, machine)
	if len(derr) != 0 { return derr }
	var perr @[]readonly char = Relocate(t, lr)
	if len(perr) != 0 { return perr }

	var interpVa uint = secVaddr(dynObj, lr, dsInterp)
	var dynVa uint = secVaddr(dynObj, lr, dsDynamic)
	var nGot int = countKind(kinds, impGot)
	return EmitDynElfExec(lr.Sections, entryAddr, machine, interpVa,
			len(dynObj.Sections[dsInterp].Data), dynVa, dynEntryCount(nGot) * 16, outPath)
}
