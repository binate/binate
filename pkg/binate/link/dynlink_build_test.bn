package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// The end-to-end LinkDynElf proof (assemble -> link -> run) lives in dynlink_test.bn;
// these pin the synthesized-table builders directly.

// dynHash builds a well-formed one-bucket SysV hash over the symbols.
func TestDynHash() testing.TestResult {
	var h @[]uint8 = dynHash(2) // null + one import
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = h
	if u32(rd, 0) != 1 { return fail("nbucket should be 1") }
	if u32(rd, 4) != 2 { return fail("nchain should be nsym (2)") }
	if u32(rd, 8) != 1 { return fail("bucket[0] should chain from symbol 1") }
	return ""
}

// dynSymtab emits a null entry then one UND STT_FUNC entry per import, carrying each
// import's binding in st_info (a weak import must be STB_WEAK, not STB_GLOBAL).
func TestDynSymtab() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 2)
	imports[0] = buf.CopyStr("exit") // global (required)
	imports[1] = buf.CopyStr("opt") // weak (bound if available, else 0)
	var offs @[]int = make_slice(int, 2)
	offs[0] = 1
	offs[1] = 6
	var binds @[]int = make_slice(int, 2)
	binds[0] = BIND_GLOBAL
	binds[1] = BIND_WEAK
	var kinds @[]int = make_slice(int, 2)
	kinds[0] = impPlt
	kinds[1] = impPlt
	var sym @[]uint8 = dynSymtab(imports, offs, binds, kinds)
	if len(sym) != 3 * symEntSize { return fail("expected null + two symbols") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = sym
	if u32(rd, symEntSize + 0) != 1 { return fail("st_name should be the .dynstr offset (1)") }
	if sym[symEntSize + 4] != cast(uint8, (BIND_GLOBAL << 4) | STT_FUNC) {
		return fail("the global import should be STB_GLOBAL|STT_FUNC")
	}
	if sym[2 * symEntSize + 4] != cast(uint8, (BIND_WEAK << 4) | STT_FUNC) {
		return fail("the weak import should be STB_WEAK|STT_FUNC")
	}
	if u16(rd, symEntSize + 6) != 0 { return fail("st_shndx should be SHN_UNDEF") }
	return ""
}

// buildDynStubs lays out the full synthetic section set and defines a called import
// at its PLT stub, and dynStrtab records the needed library after the import names.
func TestBuildDynStubs() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = buf.CopyStr("exit")
	var binds @[]int = make_slice(int, 1)
	binds[0] = BIND_GLOBAL
	var kinds @[]int = make_slice(int, 1)
	kinds[0] = impPlt
	obj, libOff := buildDynStubs(imports, binds, kinds, "libc.so.6", EM_AARCH64)
	if len(obj.Sections) != dsSectionCount { return fail("expected the full synthetic section set") }
	if !charsEqual(obj.Sections[dsPlt].Name, ".plt") { return fail(".plt section name wrong") }
	if (obj.Sections[dsPlt].Flags & SF_EXEC) == 0 { return fail(".plt should be executable") }
	if (obj.Sections[dsGotplt].Flags & SF_WRITE) == 0 { return fail(".got.plt should be writable") }
	if len(obj.Symbols) != 1 || !charsEqual(obj.Symbols[0].Name, "exit") {
		return fail("the import should be defined as a symbol")
	}
	if obj.Symbols[0].SecIndex != dsPlt { return fail("the import should be defined in .plt") }
	// .dynstr is \0 exit \0 libc.so.6 \0 ; the lib name follows "exit\0".
	if libOff != 1 + len("exit") + 1 { return fail("wrong needed-library .dynstr offset") }
	return ""
}

// Two imports (puts + exit) size the synthetic tables per-import: 3 .dynsym entries,
// 2 .rela.plt relocs, 2 PLT stubs, 3+2 GOT slots, both defined, and the needed library
// follows both names in .dynstr.
func TestBuildDynStubsMultiImport() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 2)
	imports[0] = buf.CopyStr("puts")
	imports[1] = buf.CopyStr("exit")
	var binds @[]int = make_slice(int, 2)
	binds[0] = BIND_GLOBAL
	binds[1] = BIND_GLOBAL
	var kinds @[]int = make_slice(int, 2)
	kinds[0] = impPlt
	kinds[1] = impPlt
	obj, libOff := buildDynStubs(imports, binds, kinds, "libc.so.6", EM_AARCH64)
	if len(obj.Sections[dsDynsym].Data) != 3 * symEntSize { return fail("expected 3 .dynsym entries") }
	if len(obj.Sections[dsRelaplt].Data) != 2 * relaEntSize {
		return fail("expected 2 .rela.plt relocs")
	}
	if len(obj.Sections[dsPlt].Data) != 2 * pltStubSize { return fail("expected 2 PLT stubs") }
	if len(obj.Sections[dsGotplt].Data) != 5 * gotEntSize {
		return fail("expected 3+2 .got.plt slots")
	}
	if len(obj.Symbols) != 2 { return fail("both imports should be defined") }
	if !charsEqual(obj.Symbols[1].Name, "exit") || obj.Symbols[1].Value != cast(uint, pltStubSize) {
		return fail("the second import should be defined at the second PLT stub")
	}
	if libOff != 1 + len("puts") + 1 + len("exit") + 1 { return fail("lib should follow both names") }
	return ""
}

// A data (GOT) import is defined at a .got slot with a GLOB_DAT in .rela.dyn, an
// STT_NOTYPE UND .dynsym entry, and NO PLT stub — distinct from a called (PLT)
// import.  (.got.plt keeps its 3 reserved slots even with no PLT imports.)
func TestBuildDynStubsDataImport() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = buf.CopyStr("environ")
	var binds @[]int = make_slice(int, 1)
	binds[0] = BIND_GLOBAL
	var kinds @[]int = make_slice(int, 1)
	kinds[0] = impGot
	obj, _ := buildDynStubs(imports, binds, kinds, "libc.so.6", EM_AARCH64)
	if len(obj.Sections[dsGot].Data) != gotEntSize { return fail("expected one .got slot") }
	if len(obj.Sections[dsReladyn].Data) != relaEntSize {
		return fail("expected one .rela.dyn GLOB_DAT")
	}
	if len(obj.Sections[dsPlt].Data) != 0 { return fail("a data import needs no PLT stub") }
	if len(obj.Sections[dsRelaplt].Data) != 0 { return fail("a data import needs no .rela.plt") }
	if len(obj.Sections[dsGotplt].Data) != 3 * gotEntSize {
		return fail("expected the 3 reserved .got.plt slots")
	}
	if len(obj.Symbols) != 1 || obj.Symbols[0].SecIndex != dsGot {
		return fail("the data import should be defined in .got")
	}
	if obj.Symbols[0].Value != cast(uint, 0) { return fail("first .got import not at slot 0") }
	// .dynsym[1] st_info low nibble = STT_NOTYPE (not STT_FUNC) for a data import.
	var sym @[]uint8 = obj.Sections[dsDynsym].Data
	if (cast(int, sym[symEntSize + 4]) & 0xf) != STT_NOTYPE {
		return fail("a data import should be STT_NOTYPE")
	}
	return ""
}

// A mix of a called import (puts -> PLT) and a data import (environ -> GOT) sizes
// each table by its own kind: one PLT stub + one .rela.plt, one .got slot + one
// .rela.dyn, and both symbols defined at their respective slots.
func TestBuildDynStubsMixed() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 2)
	imports[0] = buf.CopyStr("puts") // called
	imports[1] = buf.CopyStr("environ") // data
	var binds @[]int = make_slice(int, 2)
	binds[0] = BIND_GLOBAL
	binds[1] = BIND_GLOBAL
	var kinds @[]int = make_slice(int, 2)
	kinds[0] = impPlt
	kinds[1] = impGot
	obj, _ := buildDynStubs(imports, binds, kinds, "libc.so.6", EM_AARCH64)
	if len(obj.Sections[dsPlt].Data) != pltStubSize { return fail("expected one PLT stub (puts)") }
	if len(obj.Sections[dsRelaplt].Data) != relaEntSize { return fail("expected one .rela.plt") }
	if len(obj.Sections[dsGot].Data) != gotEntSize { return fail("expected one .got slot (environ)") }
	if len(obj.Sections[dsReladyn].Data) != relaEntSize {
		return fail("expected one .rela.dyn (environ)")
	}
	if obj.Symbols[0].SecIndex != dsPlt { return fail("puts should be defined in .plt") }
	if obj.Symbols[1].SecIndex != dsGot { return fail("environ should be defined in .got") }
	return ""
}
