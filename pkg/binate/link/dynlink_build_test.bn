package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// The end-to-end LinkDynElf proof (assemble -> link -> run) lives in dynlink_test.bn;
// these pin the synthesized-table builders directly.

// dynHash builds a well-formed one-bucket SysV hash over the symbols.
func TestDynHash() testing.TestResult {
	var h @[]uint8 = dynHash(2) // null + one import
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = h
	if u32(rd, 0) != 1 { return fail("nbucket should be 1") }
	if u32(rd, 4) != 2 { return fail("nchain should be nsym (2)") }
	if u32(rd, 8) != 1 { return fail("bucket[0] should chain from symbol 1") }
	return ""
}

// dynSymtab emits a null entry then one UND STT_FUNC/STB_GLOBAL entry per import.
func TestDynSymtab() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = buf.CopyStr("exit")
	var offs @[]int = make_slice(int, 1)
	offs[0] = 1
	var sym @[]uint8 = dynSymtab(imports, offs)
	if len(sym) != 2 * symEntSize { return fail("expected two 24-byte symbols") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = sym
	if u32(rd, symEntSize + 0) != 1 { return fail("st_name should be the .dynstr offset (1)") }
	if sym[symEntSize + 4] != cast(uint8, (STB_GLOBAL << 4) | STT_FUNC) {
		return fail("st_info should be STB_GLOBAL|STT_FUNC")
	}
	if u16(rd, symEntSize + 6) != 0 { return fail("st_shndx should be SHN_UNDEF") }
	return ""
}

// buildDynStubs lays out the eight synthetic sections and defines each import at its
// PLT stub, and dynStrtab records the needed library after the import names.
func TestBuildDynStubs() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = buf.CopyStr("exit")
	obj, libOff := buildDynStubs(imports, "libc.so.6", EM_AARCH64)
	if len(obj.Sections) != 8 { return fail("expected 8 synthetic sections") }
	if !charsEqual(obj.Sections[dsPlt].Name, ".plt") { return fail("section 5 should be .plt") }
	if (obj.Sections[dsPlt].Flags & SF_EXEC) == 0 { return fail(".plt should be executable") }
	if (obj.Sections[dsGotplt].Flags & SF_WRITE) == 0 { return fail(".got.plt should be writable") }
	if len(obj.Symbols) != 1 || !charsEqual(obj.Symbols[0].Name, "exit") {
		return fail("the import should be defined as a symbol")
	}
	if obj.Symbols[0].SecIndex != dsPlt { return fail("the import should be defined in .plt") }
	// .dynstr is \0 exit \0 libc.so.6 \0 ; the lib name follows "exit\0".
	if libOff != 1 + len("exit") + 1 { return fail("wrong needed-library .dynstr offset") }
	return ""
}
