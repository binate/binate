package "pkg/binate/link"

// Symbols a dynamic ELF executable exports.  An executable's common symbols (C tentative
// definitions, which commons.bn allocates in it) are entered in its .dynsym as defined
// globals, so a needed library that defines and uses the same name — libc's `optind`, say,
// which getopt updates through the GOT — binds to the executable's copy, and the two share one
// variable, as lld arranges for a common.  (bnld does not read the libraries' symbols; GNU ld
// instead imports a common that a library defines as data.)  Only commons are exported: the
// program's other definitions stay out of .dynsym, so one does not interpose a library's
// definition of the same name, where lld exports any definition a needed library defines or
// references.

// addDynExports appends to the dynamic-stubs object dynObj (buildDynStubs, over nImports
// imports) one .dynsym entry per symbol of exports — a global data object of its size, its
// name in .dynstr after the libraries' — and rebuilds .hash to cover them.  The entries'
// values and section indices are set after layout (patchDynExports).
func addDynExports(dynObj @InputObject, nImports int, exports @[]InputSymbol) {
	if len(exports) == 0 { return }
	var oldStr @[]uint8 = dynObj.Sections[dsDynstr].Data
	var total int = len(oldStr)
	for i := 0; i < len(exports); i++ { total = total + len(exports[i].Name) + 1 }
	var strtab @[]uint8 = make_slice(uint8, total)
	for i := 0; i < len(oldStr); i++ { strtab[i] = oldStr[i] }
	var oldSym @[]uint8 = dynObj.Sections[dsDynsym].Data
	var symtab @[]uint8 = make_slice(uint8, len(oldSym) + len(exports) * symEntSize)
	for i := 0; i < len(oldSym); i++ { symtab[i] = oldSym[i] }
	var p int = len(oldStr)
	for i := 0; i < len(exports); i++ {
		var e int = (1 + nImports + i) * symEntSize
		writeLE(symtab, e + 0, p, 4) // st_name
		symtab[e + 4] = cast(uint8, (BIND_GLOBAL << 4) | STT_OBJECT) // st_info
		writeU64(symtab, e + 16, cast(uint64, exports[i].Size)) // st_size; st_value, st_shndx later
		for j := 0; j < len(exports[i].Name); j++ { strtab[p + j] = cast(uint8, exports[i].Name[j]) }
		p = p + len(exports[i].Name) + 1 // NUL
	}
	dynObj.Sections[dsDynstr] = mkDynSection(".dynstr", SF_READ, 1, strtab)
	dynObj.Sections[dsDynsym] = mkDynSection(".dynsym", SF_READ, 8, symtab)
	dynObj.Sections[dsHash] = mkDynSection(".hash", SF_READ, 8, dynHash(1 + nImports + len(exports)))
}

// patchDynExports sets each .dynsym entry addDynExports added for the symbols of the
// linker-made commons object comObj: its value, the address layout lr gave it, and its section
// index, that of the output .bss in a section header table listing lr's sections after the
// null entry.  bnld writes no section headers, so the dynamic linker reads the index only as
// "defined"; an ordinary index rather than SHN_ABS keeps the symbol visible to dladdr, which
// skips absolute symbols, and the executable is never relocated (ET_EXEC), so the value is the
// address either way.
func patchDynExports(dynObj @InputObject, lr @LayoutResult, nImports int, comObj @InputObject) {
	var base uint64 = secVaddr(comObj, lr, 0)
	var shndx int = comObj.Sections[0].OutIndex + 1
	symData, symOff := outData(dynObj, lr, dsDynsym)
	for i := 0; i < len(comObj.Symbols); i++ {
		var e int = symOff + (1 + nImports + i) * symEntSize
		writeLE(symData, e + 6, shndx, 2) // st_shndx
		writeU64(symData, e + 8, base + cast(uint64, comObj.Symbols[i].Value)) // st_value
	}
}
