package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/std/table"

// Symbols a dynamic ELF executable exports.  A program definition whose name a needed library
// defines or references is entered in the executable's .dynsym, so the library binds to it —
// libc's getopt updates the program's `optind` through its GOT, and libc's own calls to
// `malloc` reach a program that defines one — as lld arranges.  (GNU ld does the same for a
// definition; for a common it instead lets the library's definition win, copy-relocated into
// the executable.)  A name some object marks Hidden is never exported, nor is one no needed
// library names: exporting it would only add to the startup lookups.

// dynExport is a definition the executable exports: its name and the definition Resolve chose
// for it (ObjIdx, SymIdx in the symbol table's objects).
type dynExport struct {
	Name   @[]char
	ObjIdx int
	SymIdx int
}

// programExports returns the definitions t's program objects (the first nProgram) export: for
// each global or weak name one of them defines — in a section or absolute — that libNames
// holds (the names the needed libraries define or reference, neededLibs) and no object marks
// Hidden, the definition Resolve chose, in first-definition order.
func programExports(t @SymbolTable, nProgram int, libNames @[]@[]char) @[]dynExport {
	// The tables borrow names owned by libNames and the objects, which outlive them.
	var lib @table.Table[*[]readonly char, bool, LinkNameHasher, LinkNameEq] = table.NewTable[
			*[]readonly char, bool, LinkNameHasher, LinkNameEq](
					LinkNameHasher{}, LinkNameEq{})
	for i := 0; i < len(libNames); i++ { lib.Put(libNames[i], true) }
	var hidden @table.Table[*[]readonly char, bool, LinkNameHasher, LinkNameEq] = table.NewTable[
			*[]readonly char, bool, LinkNameHasher, LinkNameEq](
					LinkNameHasher{}, LinkNameEq{})
	var n int = 0
	for o := 0; o < nProgram; o++ {
		for s := 0; s < len(t.Objs[o].Symbols); s++ {
			var sym InputSymbol = t.Objs[o].Symbols[s]
			if sym.Binding == 0 || len(sym.Name) == 0 { continue }
			if sym.Hidden { hidden.Put(sym.Name, true) }
			n = n + 1
		}
	}
	var seen @table.Table[*[]readonly char, bool, LinkNameHasher, LinkNameEq] = table.NewTable[
			*[]readonly char, bool, LinkNameHasher, LinkNameEq](
					LinkNameHasher{}, LinkNameEq{})
	var out @[]dynExport = make_slice(dynExport, n)
	var k int = 0
	for o := 0; o < nProgram; o++ {
		for s := 0; s < len(t.Objs[o].Symbols); s++ {
			var sym InputSymbol = t.Objs[o].Symbols[s]
			if sym.Binding == 0 || len(sym.Name) == 0 || (sym.SecIndex < 0 && !sym.Abs) { continue }
			if !lib.Has(sym.Name) || hidden.Has(sym.Name) || seen.Has(sym.Name) { continue }
			oo, ss, found := t.Lookup(sym.Name)
			if !found { continue }
			seen.Put(sym.Name, true)
			out[k].Name = sym.Name
			out[k].ObjIdx = oo
			out[k].SymIdx = ss
			k = k + 1
		}
	}
	return out[0:k]
}

// addDynExports appends to the dynamic-stubs object dynObj (buildDynStubs, over nImports
// imports) one .dynsym entry per export — its name in .dynstr after the libraries', the
// definition's binding and size, STT_FUNC for code and STT_OBJECT for anything else — and
// rebuilds .hash to cover them.  The entries' values and section indices are set after layout
// (patchDynExports).
func addDynExports(dynObj @InputObject, nImports int, t @SymbolTable, exports @[]dynExport) {
	if len(exports) == 0 { return }
	var oldStr @[]uint8 = dynObj.Sections[dsDynstr].Data
	var total int = len(oldStr)
	for i := 0; i < len(exports); i++ { total = total + len(exports[i].Name) + 1 }
	var strtab @[]uint8 = make_slice(uint8, total)
	for i := 0; i < len(oldStr); i++ { strtab[i] = oldStr[i] }
	var oldSym @[]uint8 = dynObj.Sections[dsDynsym].Data
	var symtab @[]uint8 = make_slice(uint8, len(oldSym) + len(exports) * symEntSize)
	for i := 0; i < len(oldSym); i++ { symtab[i] = oldSym[i] }
	var p int = len(oldStr)
	for i := 0; i < len(exports); i++ {
		var obj @InputObject = t.Objs[exports[i].ObjIdx]
		var def InputSymbol = obj.Symbols[exports[i].SymIdx]
		var stype int = STT_OBJECT
		if def.SecIndex >= 0 && (obj.Sections[def.SecIndex].Flags & SF_EXEC) != 0 { stype = STT_FUNC }
		var e int = (1 + nImports + i) * symEntSize
		writeLE(symtab, e + 0, p, 4) // st_name
		symtab[e + 4] = cast(uint8, (def.Binding << 4) | stype) // st_info
		writeU64(symtab, e + 16, cast(uint64, def.Size)) // st_size; st_value, st_shndx later
		for j := 0; j < len(exports[i].Name); j++ { strtab[p + j] = cast(uint8, exports[i].Name[j]) }
		p = p + len(exports[i].Name) + 1 // NUL
	}
	dynObj.Sections[dsDynstr] = mkDynSection(".dynstr", SF_READ, 1, strtab)
	dynObj.Sections[dsDynsym] = mkDynSection(".dynsym", SF_READ, 8, symtab)
	dynObj.Sections[dsHash] = mkDynSection(".hash", SF_READ, 8, dynHash(1 + nImports + len(exports)))
}

// patchDynExports sets each .dynsym entry addDynExports added: its value, the definition's
// address in layout lr, and its section index — that of the definition's output section in a
// section header table listing lr's sections after the null entry, or SHN_ABS for an absolute
// definition.  bnld writes no section headers, so the dynamic linker reads the index only as
// "defined"; an ordinary index rather than SHN_ABS keeps a symbol in the image visible to
// dladdr, which skips absolute symbols, and the executable is never relocated (ET_EXEC), so
// the value is the address either way.  Returns "" or an error for a definition with no
// address.
func patchDynExports(dynObj @InputObject, lr @LayoutResult, nImports int, t @SymbolTable,
		exports @[]dynExport) @[]readonly char {
	symData, symOff := outData(dynObj, lr, dsDynsym)
	for i := 0; i < len(exports); i++ {
		var obj @InputObject = t.Objs[exports[i].ObjIdx]
		var def InputSymbol = obj.Symbols[exports[i].SymIdx]
		addr, ok := definedAddr(t, lr, exports[i].ObjIdx, exports[i].SymIdx)
		if !ok { return buf.Concat("an exported symbol has no address: ", exports[i].Name) }
		var shndx int = SHN_ABS
		if def.SecIndex >= 0 { shndx = obj.Sections[def.SecIndex].OutIndex + 1 }
		var e int = symOff + (1 + nImports + i) * symEntSize
		writeLE(symData, e + 6, shndx, 2) // st_shndx
		writeU64(symData, e + 8, addr) // st_value
	}
	return ""
}
