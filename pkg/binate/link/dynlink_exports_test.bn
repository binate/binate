package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/elf"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// A dynamic ELF link exports the program definitions its needed libraries name
// (dynlink_exports.bn): which definitions programExports picks, their .dynsym entries, their
// values after layout, and end-to-end links.  (adrpAddTarget is in dynmacho_init_test.bn,
// mkSym / mkObj in resolve_test.bn, mkSection in layout_test.bn, fakeLibcDirs in
// libsearch_test.bn, testTmpDir in link_test.bn, fail in parse_elf_test.bn, loadFileOff in
// got_link_test.bn, elfSymEntry in visibility_test.bn.)

// exportObjs returns two program objects with an 8-byte .text and a 16-byte .data: p.o defines
// the function `malloc` (text), the data `optind` (.data, 4 bytes), the weak `wk`, the hidden
// `hid`, the absolute `abs` (0x1234), the local `loc`, the program's own `own`, the weak `lw`
// (its only definition) and `hu`; q.o defines a strong `wk` (it wins), references `hid`
// without hiding it, and references `hu` hidden.
func exportObjs() @[]@InputObject {
	var secs @[]InputSection = make_slice(InputSection, 2)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, make_slice(uint8, 8), cast(uint, 8),
			4)
	secs[1] = mkSection(".data", SF_READ | SF_WRITE, SHT_PROGBITS, make_slice(uint8, 16),
			cast(uint, 16), 8)
	var ps @[]InputSymbol = make_slice(InputSymbol, 9)
	ps[0] = mkSym("malloc", 0, BIND_GLOBAL)
	ps[1] = mkSym("optind", 1, BIND_GLOBAL)
	ps[1].Size = 4
	ps[2] = mkSym("wk", 1, BIND_WEAK)
	ps[3] = mkSym("hid", 1, BIND_GLOBAL)
	ps[3].Hidden = true
	ps[4] = mkSym("abs", -1, BIND_GLOBAL)
	ps[4].Abs = true
	ps[4].AbsValue = 0x1234
	ps[5] = mkSym("loc", 1, 0)
	ps[6] = mkSym("own", 1, BIND_GLOBAL)
	ps[7] = mkSym("lw", 1, BIND_WEAK)
	ps[8] = mkSym("hu", 1, BIND_GLOBAL)
	var p @InputObject = mkObj("p.o", ps)
	p.Sections = secs
	var qs @[]InputSymbol = make_slice(InputSymbol, 3)
	qs[0] = mkSym("wk", 0, BIND_GLOBAL)
	qs[1] = mkSym("hid", -1, BIND_GLOBAL)
	qs[2] = mkSym("hu", -1, BIND_GLOBAL)
	qs[2].Hidden = true
	var q @InputObject = mkObj("q.o", qs)
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = p
	objs[1] = q
	return objs
}

// programExports picks each global or weak definition — in a section or absolute — whose name
// a library holds, as Resolve chose it (q.o's strong wk, not p.o's weak one), and not a hidden
// name, a local, or a name no library holds.
func TestProgramExports() testing.TestResult {
	t, rerr := Resolve(exportObjs())
	if len(rerr) != 0 { return fail(buf.Concat("resolve failed: ", rerr)) }
	var libNames @[]@[]char = @[]@[]char{buf.CopyStr("malloc"), buf.CopyStr("optind"),
			buf.CopyStr("wk"), buf.CopyStr("hid"), buf.CopyStr("abs"), buf.CopyStr("loc"),
			buf.CopyStr("free"), buf.CopyStr("lw"), buf.CopyStr("hu")}
	var x @[]dynExport = programExports(t, 2, libNames)
	if len(x) != 5 { return fail("not five exports") }
	if !charsEqual(x[0].Name, "malloc") || x[0].ObjIdx != 0 || x[0].SymIdx != 0 {
		return fail("malloc")
	}
	if !charsEqual(x[1].Name, "optind") || x[1].ObjIdx != 0 { return fail("optind") }
	if !charsEqual(x[2].Name, "wk") || x[2].ObjIdx != 1 { return fail("wk is not q.o's strong one") }
	if !charsEqual(x[3].Name, "abs") { return fail("abs") }
	// hu is left out: q.o's undefined reference marks the name hidden.
	if !charsEqual(x[4].Name, "lw") { return fail("lw, a weak definition with no strong one") }
	return ""
}

// addDynExports adds an entry per export after the imports' — named in .dynstr after the
// libraries, with the definition's binding (lw stays weak) and size, STT_FUNC for code and
// STT_OBJECT for
// data — and covers them in .hash, leaving the import's entry and the libraries' names where
// they were.
func TestAddDynExports() testing.TestResult {
	t, rerr := Resolve(exportObjs())
	if len(rerr) != 0 { return fail(buf.Concat("resolve failed: ", rerr)) }
	var x @[]dynExport = programExports(t, 2,
			@[]@[]char{buf.CopyStr("malloc"), buf.CopyStr("optind"), buf.CopyStr("lw")})
	var libs @[]@[]char = make_slice(@[]char, 1)
	libs[0] = buf.CopyStr("libc.so.6")
	obj, libOffs := buildDynStubs(@[]@[]char{buf.CopyStr("exit")}, @[]int{BIND_GLOBAL}, @[]int{impPlt},
			libs, EM_AARCH64, 0, 0, 0)
	addDynExports(obj, 1, t, x)
	var sym @[]uint8 = obj.Sections[dsDynsym].Data
	var str @[]uint8 = obj.Sections[dsDynstr].Data
	if len(sym) != 5 * symEntSize { return fail(".dynsym is not null + import + three exports") }
	var m int = 2 * symEntSize
	var o int = 3 * symEntSize
	var mname int = cast(int, u32(sym, m))
	var oname int = cast(int, u32(sym, o))
	if !bytesAtEqual(str, mname, "malloc") || !bytesAtEqual(str, oname, "optind") {
		return fail("the exports are not malloc then optind")
	}
	if !bytesAtEqual(str, libOffs[0], "libc.so.6") {
		return fail("the libraries' names moved in .dynstr")
	}
	var imp int = cast(int, u32(sym, symEntSize))
	if !bytesAtEqual(str, imp, "exit") || str[imp + 4] != 0 {
		return fail("the import is no longer named exit")
	}
	if sym[m + 4] != 0x12 { return fail("malloc is not a global function") }
	if sym[o + 4] != 0x11 || u64(sym, o + 16) != 4 {
		return fail("optind is not a global 4-byte object")
	}
	if sym[4 * symEntSize + 4] != 0x21 { return fail("lw is not a weak object") }
	if cast(int, u32(obj.Sections[dsHash].Data, 4)) != 5 {
		return fail(".hash does not chain five symbols")
	}
	return ""
}

// elfPatchCommon makes the undefined global name in the ELF64 object data a common of size
// bytes aligned to align (st_shndx SHN_COMMON, st_value the alignment), and reports whether it
// found the symbol.
func elfPatchCommon(data @[]uint8, name *[]readonly char, size int, align int) bool {
	var e int = elfSymEntry(data, name)
	if e < 0 { return false }
	writeLE(data, e + 6, SHN_COMMON, 2)
	writeU64(data, e + 8, cast(uint64, align))
	writeU64(data, e + 16, cast(uint64, size))
	return true
}

// elfDynValue returns the value of the .dynamic entry tag in the ELF64 executable rd, or 0.
func elfDynValue(rd *[]readonly uint8, tag int) uint64 {
	var phoff int = cast(int, u64(rd, 32))
	for i := 0; i < u16(rd, 56); i++ {
		var ph int = phoff + i * u16(rd, 54)
		if cast(int, u32(rd, ph)) != PT_DYNAMIC { continue }
		var off int = cast(int, u64(rd, ph + 8))
		for e := off; e + 16 <= off + cast(int, u64(rd, ph + 32)); e = e + 16 {
			if cast(int, u64(rd, e)) == tag { return cast(uint64, u64(rd, e + 8)) }
		}
	}
	return cast(uint64, 0)
}

// A dynamic ELF link allocates a common and exports it when a needed library defines the name:
// `counter` (libc's here) is a .dynsym entry defined in an ordinary section (not SHN_ABS, which
// dladdr skips), whose value is the address the program's ADRP + ADD of it computes, and whose
// name DT_STRSZ covers; the program's own common `own`, which no library names, is not
// exported.
func TestLinkDynElfExportsCommon() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.SetGlobal("exit")
	a.SetGlobal("counter")
	a.SetGlobal("own")
	aarch64.Adrp(a, aarch64.X1, "counter")
	aarch64.AddImmLabel(a, true, aarch64.X1, aarch64.X1, "counter")
	aarch64.Adrp(a, aarch64.X2, "own")
	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(42))
	aarch64.Bl(a, "exit")
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	var obj @[]char = buf.Concat(dir, "/common.o")
	if !elf.WriteAArch64(a, obj) { return fail("write object failed") }
	data, ok := readFile(obj)
	if !ok || !elfPatchCommon(data, "counter", 4, 4) || !elfPatchCommon(data, "own", 4, 4) ||
			!writeBytes(obj, data) {
		return fail("cannot make counter and own commons")
	}
	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = obj
	var out @[]char = buf.Concat(dir, "/common")
	var base uint64 = 0x400000
	var err @[]readonly char = LinkDynElf(paths, "_start", EM_AARCH64, base, out,
			make_slice(@[]char, 0), fakeLibcDirs(dir, EM_AARCH64, @[]@[]char{buf.CopyStr("counter")}))
	if len(err) != 0 { return fail(buf.Concat("LinkDynElf failed: ", err)) }
	exe, eok := readFile(out)
	if !eok { return fail("cannot read the executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = exe
	var symOff int = loadFileOff(rd, elfDynValue(rd, DT_SYMTAB))
	var strOff int = loadFileOff(rd, elfDynValue(rd, DT_STRTAB))
	var strSize int = cast(int, elfDynValue(rd, DT_STRSZ))
	var nsym int = cast(int, u32(rd, loadFileOff(rd, elfDynValue(rd, DT_HASH)) + 4))
	if symOff < 0 || strOff < 0 { return fail("no .dynsym / .dynstr") }
	var entry uint64 = cast(uint64, u64(rd, 24))
	var textOff int = loadFileOff(rd, entry)
	var addr uint64 = adrpAddTarget(entry, u32(rd, textOff), u32(rd, textOff + 4))
	var sawCounter bool = false
	for i := 1; i < nsym; i++ {
		var e int = symOff + i * symEntSize
		var at int = strOff + cast(int, u32(rd, e))
		if bytesAtEqual(rd, at, "own") && rd[at + 3] == 0 { return fail("own was exported") }
		if !bytesAtEqual(rd, at, "counter") || rd[at + 7] != 0 { continue }
		if u16(rd, e + 6) == 0 { return fail("counter was imported") }
		if u16(rd, e + 6) == SHN_ABS { return fail("counter is SHN_ABS") }
		if cast(int, u32(rd, e)) + 8 > strSize { return fail("DT_STRSZ does not cover counter's name") }
		if cast(uint64, u64(rd, e + 8)) != addr || u64(rd, e + 16) != 4 {
			return fail("the exported counter is not the program's 4-byte counter")
		}
		sawCounter = true
	}
	if !sawCounter { return fail("counter is not in .dynsym") }
	return ""
}

// A dynamic ELF link exports a program's own function, data and absolute definitions that a
// needed library defines: `malloc` (code, STT_FUNC) and `optind` (data, STT_OBJECT, 8 bytes
// into .data), each at its address in an ordinary section, and `absx` (SHN_ABS, its value);
// the program's `own`, which no library names, is not exported.
func TestLinkDynElfExportsDefinitions() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.SetGlobal("exit")
	aarch64.Adrp(a, aarch64.X1, "optind")
	aarch64.AddImmLabel(a, true, aarch64.X1, aarch64.X1, "optind")
	aarch64.Bl(a, "exit")
	a.DefineLabel("malloc")
	a.SetGlobal("malloc")
	aarch64.Ret(a)
	a.SetSection("data", -1)
	a.Zero(8) // optind sits at a nonzero offset
	a.DefineLabel("optind")
	a.SetGlobal("optind")
	a.Zero(4)
	a.DefineLabel("own")
	a.SetGlobal("own")
	a.Zero(4)
	a.DefineLabel("absx")
	a.SetGlobal("absx")
	a.Zero(4)
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	var obj @[]char = buf.Concat(dir, "/defs.o")
	if !elf.WriteAArch64(a, obj) { return fail("write object failed") }
	data, dok := readFile(obj)
	var ae int = elfSymEntry(data, "absx")
	if !dok || ae < 0 { return fail("no absx in the object") }
	writeLE(data, ae + 6, SHN_ABS, 2) // absx becomes an absolute 0x1234
	writeU64(data, ae + 8, cast(uint64, 0x1234))
	if !writeBytes(obj, data) { return fail("cannot rewrite the object") }
	var paths @[]@[]char = @[]@[]char{obj}
	var out @[]char = buf.Concat(dir, "/defs")
	var err @[]readonly char = LinkDynElf(paths, "_start", EM_AARCH64, cast(uint64, 0x400000), out,
			make_slice(@[]char, 0),
			fakeLibcDirs(dir, EM_AARCH64,
					@[]@[]char{buf.CopyStr("malloc"), buf.CopyStr("optind"), buf.CopyStr("absx")}))
	if len(err) != 0 { return fail(buf.Concat("LinkDynElf failed: ", err)) }
	exe, eok := readFile(out)
	if !eok { return fail("cannot read the executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = exe
	var symOff int = loadFileOff(rd, elfDynValue(rd, DT_SYMTAB))
	var strOff int = loadFileOff(rd, elfDynValue(rd, DT_STRTAB))
	var nsym int = cast(int, u32(rd, loadFileOff(rd, elfDynValue(rd, DT_HASH)) + 4))
	if symOff < 0 || strOff < 0 { return fail("no .dynsym / .dynstr") }
	var entry uint64 = cast(uint64, u64(rd, 24))
	var textOff int = loadFileOff(rd, entry)
	var optindAddr uint64 = adrpAddTarget(entry, u32(rd, textOff), u32(rd, textOff + 4))
	var seen @[]bool = make_slice(bool, 3) // malloc, optind, absx
	for i := 1; i < nsym; i++ {
		var e int = symOff + i * symEntSize
		var at int = strOff + cast(int, u32(rd, e))
		var shndx int = u16(rd, e + 6)
		if bytesAtEqual(rd, at, "own") && rd[at + 3] == 0 { return fail("own was exported") }
		if bytesAtEqual(rd, at, "malloc") && rd[at + 6] == 0 {
			if rd[e + 4] != 0x12 || shndx == 0 || shndx == SHN_ABS {
				return fail("malloc is not a defined function")
			}
			if cast(uint64, u64(rd, e + 8)) != entry + 12 { return fail("malloc is not at its address") }
			seen[0] = true
		}
		if bytesAtEqual(rd, at, "optind") && rd[at + 6] == 0 {
			if rd[e + 4] != 0x11 || shndx == 0 || shndx == SHN_ABS {
				return fail("optind is not defined data")
			}
			if cast(uint64, u64(rd, e + 8)) != optindAddr { return fail("optind is not at its address") }
			seen[1] = true
		}
		if bytesAtEqual(rd, at, "absx") && rd[at + 4] == 0 {
			if shndx != SHN_ABS || u64(rd, e + 8) != 0x1234 {
				return fail("absx is not the absolute 0x1234")
			}
			seen[2] = true
		}
	}
	if !seen[0] { return fail("malloc is not exported") }
	if !seen[1] { return fail("optind is not exported") }
	if !seen[2] { return fail("absx is not exported") }
	return ""
}
