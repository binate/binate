package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/elf"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// A program whose _start calls an undefined external (libc `exit`) links into a
// dynamic ELF: the undefined symbol becomes a dynamic import, and the output carries
// PT_INTERP + PT_DYNAMIC and is an ELF the loader can run.  (Actually
// RUNNING it needs Linux + ld.so — see e2e/bnld-dynamic-linux.sh; this checks the
// structure, which is host-independent.)
func TestLinkDynElfExit42() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.SetGlobal("exit") // undefined external -> dynamic import
	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(42))
	aarch64.Bl(a, "exit")
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	if !elf.WriteAArch64(a, "/tmp/binate_dynelf_prog.o") { return fail("write object failed") }

	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = buf.CopyStr("/tmp/binate_dynelf_prog.o")
	var err @[]readonly char = LinkDynElf(paths, "_start", EM_AARCH64, cast(uint, 0x400000),
			"/tmp/binate_dynelf_exit42")
	if len(err) != 0 { return fail(buf.Concat("LinkDynElf failed: ", err)) }

	data, ok := readFile("/tmp/binate_dynelf_exit42")
	if !ok { return fail("cannot read the linked executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	if len(data) < 64 || data[0] != 0x7f || data[1] != 0x45 { return fail("not an ELF file") }
	if u16(rd, 16) != ET_EXEC { return fail("not ET_EXEC") }
	if u16(rd, 18) != EM_AARCH64 { return fail("wrong e_machine") }
	// Walk the program headers for PT_INTERP and PT_DYNAMIC.
	var phoff int = u64(rd, 32)
	var phentsize int = u16(rd, 54)
	var phnum int = u16(rd, 56)
	var sawInterp bool = false
	var sawDynamic bool = false
	for i := 0; i < phnum; i++ {
		var p int = phoff + i * phentsize
		var ptype int = u32(rd, p)
		if ptype == PT_INTERP { sawInterp = true }
		if ptype == PT_DYNAMIC { sawDynamic = true }
	}
	if !sawInterp { return fail("no PT_INTERP") }
	if !sawDynamic { return fail("no PT_DYNAMIC") }
	return ""
}

// interpEq reports whether b is s followed by a NUL (a .interp blob).
func interpEq(b @[]uint8, s *[]readonly char) bool {
	if len(b) != len(s) + 1 { return false }
	for i := 0; i < len(s); i++ {
		if b[i] != cast(uint8, s[i]) { return false }
	}
	return b[len(s)] == 0
}

// dynInterp returns the correct per-machine dynamic-linker path.
func TestDynInterp() testing.TestResult {
	if !interpEq(dynInterp(EM_X86_64), "/lib64/ld-linux-x86-64.so.2") {
		return fail("wrong x86-64 interpreter path")
	}
	if !interpEq(dynInterp(EM_AARCH64), "/lib/ld-linux-aarch64.so.1") {
		return fail("wrong aarch64 interpreter path")
	}
	return ""
}

// dynJumpSlot returns the machine's PLT GOT-slot relocation type.
func TestDynJumpSlot() testing.TestResult {
	if dynJumpSlot(EM_X86_64) != R_X86_64_JUMP_SLOT { return fail("wrong x86-64 JUMP_SLOT type") }
	if dynJumpSlot(EM_AARCH64) != R_AARCH64_JUMP_SLOT { return fail("wrong aarch64 JUMP_SLOT type") }
	return ""
}

// The x86-64 PLT stub is `jmp *disp32(%rip)` (ff 25) with disp = gotSlot - (stub + 6).
func TestWritePltStubX64() testing.TestResult {
	var out @[]uint8 = make_slice(uint8, pltStubSize)
	var stubVa uint = cast(uint, 0x401000)
	var gotSlot uint = cast(uint, 0x404000)
	if len(writePltStub(out, 0, EM_X86_64, stubVa, gotSlot)) != 0 {
		return fail("writePltStub should succeed for an in-range displacement")
	}
	if out[0] != 0xff || out[1] != 0x25 {
		return fail("x86-64 stub should start with ff 25 (jmp *rip)")
	}
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = out
	var disp int = u32(rd, 2)
	if disp != cast(int, gotSlot) - (cast(int, stubVa) + 6) {
		return fail("x86-64 stub RIP-relative displacement is wrong")
	}
	return ""
}

// mkUndefObj builds a bare object whose only symbols are undefined externals with the
// given names/bindings — enough to exercise collectImports.
func mkUndefObj(names @[]@[]char, binds @[]int) @InputObject {
	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr("<undef>")
	obj.Machine = EM_AARCH64
	obj.Sections = make_slice(InputSection, 0)
	var syms @[]InputSymbol = make_slice(InputSymbol, len(names))
	for i := 0; i < len(names); i++ {
		syms[i].Name = buf.CopyStr(names[i])
		syms[i].SecIndex = -1 // undefined
		syms[i].Binding = binds[i]
		syms[i].Value = cast(uint, 0)
	}
	obj.Symbols = syms
	obj.Relocs = make_slice(InputReloc, 0)
	return obj
}

// collectImports gathers both global and weak undefined externals, preserving each
// one's binding (a weak reference stays weak so ld.so binds-or-zeros it).
func TestCollectImportsWeak() testing.TestResult {
	var names @[]@[]char = make_slice(@[]char, 2)
	names[0] = buf.CopyStr("reqfn") // global (required)
	names[1] = buf.CopyStr("optfn") // weak (optional)
	var binds @[]int = make_slice(int, 2)
	binds[0] = BIND_GLOBAL
	binds[1] = BIND_WEAK
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkUndefObj(names, binds)
	gotNames, gotBinds := collectImports(objs)
	if len(gotNames) != 2 { return fail("both undefined externals should be imported") }
	var reqB int = -1
	var optB int = -1
	for i := 0; i < len(gotNames); i++ {
		if charsEqual(gotNames[i], "reqfn") { reqB = gotBinds[i] }
		if charsEqual(gotNames[i], "optfn") { optB = gotBinds[i] }
	}
	if reqB != BIND_GLOBAL { return fail("the global import should stay global") }
	if optB != BIND_WEAK { return fail("the weak import should stay weak") }
	return ""
}

// A name referenced weakly in one object and strongly in another is imported as
// global (a strong reference wins), so ld.so treats it as required.
func TestCollectImportsUpgrade() testing.TestResult {
	var na @[]@[]char = make_slice(@[]char, 1)
	na[0] = buf.CopyStr("shared")
	var ba @[]int = make_slice(int, 1)
	ba[0] = BIND_WEAK
	var nb @[]@[]char = make_slice(@[]char, 1)
	nb[0] = buf.CopyStr("shared")
	var bb @[]int = make_slice(int, 1)
	bb[0] = BIND_GLOBAL
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkUndefObj(na, ba) // weak reference first
	objs[1] = mkUndefObj(nb, bb) // strong reference second
	gotNames, gotBinds := collectImports(objs)
	if len(gotNames) != 1 { return fail("the shared undef should be a single import") }
	if gotBinds[0] != BIND_GLOBAL { return fail("a strong reference should upgrade weak to global") }
	return ""
}

// writePltStub rejects a stub->GOT displacement that overflows the instruction field
// (unreachable in a real executable, but a loud error rather than a truncated jump).
func TestWritePltStubOutOfRange() testing.TestResult {
	var out @[]uint8 = make_slice(uint8, pltStubSize)
	// aarch64: a GOT slot > 4GB away overflows the 21-bit ADRP page count.
	if len(writePltStub(out, 0, EM_AARCH64, cast(uint, 0x1000), cast(uint, 0x200000000))) == 0 {
		return fail("aarch64 stub should reject an out-of-range GOT displacement")
	}
	// x86-64: a GOT slot > 2GB away overflows the signed disp32.
	if len(writePltStub(out, 0, EM_X86_64, cast(uint, 0x1000), cast(uint, 0x100000000))) == 0 {
		return fail("x86-64 stub should reject an out-of-range GOT displacement")
	}
	return ""
}

// classifyImports marks a call-referenced import as a PLT import (impPlt) and a
// GOT-referenced one as a data import (impGot), from the relocations that reach each.
func TestClassifyImports() testing.TestResult {
	var names @[]@[]char = make_slice(@[]char, 2)
	names[0] = buf.CopyStr("callee") // reached by a call
	names[1] = buf.CopyStr("datum") // reached by a GOT load
	var binds @[]int = make_slice(int, 2)
	binds[0] = BIND_GLOBAL
	binds[1] = BIND_GLOBAL
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkUndefObj(names, binds)
	objs[0].Relocs = make_slice(InputReloc, 2)
	objs[0].Relocs[0].SymIndex = 0
	objs[0].Relocs[0].Kind = R_AARCH64_CALL26
	objs[0].Relocs[1].SymIndex = 1
	objs[0].Relocs[1].Kind = R_AARCH64_ADR_GOT_PAGE
	kinds, err := classifyImports(objs, names)
	if len(err) != 0 { return fail(buf.Concat("classifyImports failed: ", err)) }
	if kinds[0] != impPlt { return fail("a called import should be impPlt") }
	if kinds[1] != impGot { return fail("a GOT-referenced import should be impGot") }
	return ""
}

// A symbol reached BOTH by a call and by a GOT load is rejected — a single stub
// definition cannot be both a PLT stub and a GOT slot.
func TestClassifyImportsBothWaysRejected() testing.TestResult {
	var names @[]@[]char = make_slice(@[]char, 1)
	names[0] = buf.CopyStr("both")
	var binds @[]int = make_slice(int, 1)
	binds[0] = BIND_GLOBAL
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkUndefObj(names, binds)
	objs[0].Relocs = make_slice(InputReloc, 2)
	objs[0].Relocs[0].SymIndex = 0
	objs[0].Relocs[0].Kind = R_AARCH64_CALL26
	objs[0].Relocs[1].SymIndex = 0
	objs[0].Relocs[1].Kind = R_AARCH64_ADR_GOT_PAGE
	_, err := classifyImports(objs, names)
	if len(err) == 0 { return fail("a called + address-taken symbol should be rejected") }
	return ""
}

// A program that GOT-loads an undefined libc DATA symbol (environ) links into a
// dynamic ELF whose .dynamic carries a DT_RELA table sized for exactly one GLOB_DAT.
// (Structure only; e2e/bnld-dynamic-linux-aarch64.sh RUNS the data-import path.)
func TestLinkDynElfDataImport() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.SetGlobal("environ") // undefined data external -> GOT/GLOB_DAT import
	aarch64.AdrpGot(a, aarch64.X0, "environ")
	aarch64.LdrGotLo12(a, aarch64.X0, aarch64.X0, "environ") // x0 = &environ (from the GOT slot)
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	if !elf.WriteAArch64(a, "/tmp/binate_dynelf_datimp.o") { return fail("write object failed") }

	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = buf.CopyStr("/tmp/binate_dynelf_datimp.o")
	var err @[]readonly char = LinkDynElf(paths, "_start", EM_AARCH64, cast(uint, 0x400000),
			"/tmp/binate_dynelf_datimp")
	if len(err) != 0 { return fail(buf.Concat("LinkDynElf failed: ", err)) }

	data, ok := readFile("/tmp/binate_dynelf_datimp")
	if !ok { return fail("cannot read the linked executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	if len(data) < 64 || data[0] != 0x7f { return fail("not an ELF file") }
	// Find PT_DYNAMIC, then walk its Elf64_Dyn array for DT_RELASZ (the GLOB_DAT table).
	var phoff int = u64(rd, 32)
	var phentsize int = u16(rd, 54)
	var phnum int = u16(rd, 56)
	var dynOff int = -1
	var dynSz int = 0
	for i := 0; i < phnum; i++ {
		var ph int = phoff + i * phentsize
		if u32(rd, ph) == PT_DYNAMIC {
			dynOff = u64(rd, ph + 8) // p_offset
			dynSz = u64(rd, ph + 32) // p_filesz
		}
	}
	if dynOff < 0 { return fail("no PT_DYNAMIC") }
	var relaSz int = -1
	for e := 0; e < dynSz; e = e + 16 {
		var tag int = u64(rd, dynOff + e)
		var val int = u64(rd, dynOff + e + 8)
		if tag == DT_NULL { break }
		if tag == DT_RELASZ { relaSz = val }
	}
	if relaSz != relaEntSize {
		return fail("DT_RELASZ should size exactly one GLOB_DAT for the data import")
	}
	return ""
}
