package "pkg/binate/link"

import "pkg/binate/buf"

// Dynamic Mach-O linking (arm64).  The macOS analogue of dynlink.bn: a
// dynamically-linked Mach-O resolves its undefined externals (e.g. libSystem's
// `_exit`, `___stdoutp`) from shared libraries at load via /usr/lib/dyld, instead of
// erroring on them.  Each import gets a __got slot that dyld binds at load (a BIND
// opcode in LC_DYLD_INFO_ONLY — non-lazy, the Mach-O analogue of DF_BIND_NOW, so no
// __stub_helper / stub-binder).  As on ELF, a *called* import also gets a __TEXT stub
// that jumps through its slot (so a `bl _exit` reaches libSystem), while a *data*
// import's GOT-load is kept pointing straight at its slot.  Both go through the
// ordinary Resolve → Layout → Relocate pipeline: a synthesized "dynamic-stubs" object
// *defines* each import at its stub (called) or its __got slot (data).  The
// loader-facing tables (bind opcodes, symtab, LC_LOAD_DYLINKER/DYLIB, LC_MAIN,
// LC_BUILD_VERSION, the ad-hoc code signature) are emitted by the writer.  arm64
// only.

// Mach-O dynamic-linking constants.
const (
	// Dyld info bind opcodes (the high nibble is the opcode, the low nibble an
	// immediate operand).
	BIND_OPCODE_DONE int = 0x00
	BIND_OPCODE_SET_DYLIB_ORDINAL_IMM int = 0x10
	BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM int = 0x40
	BIND_OPCODE_SET_TYPE_IMM int = 0x50
	BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB int = 0x70
	BIND_OPCODE_DO_BIND int = 0x90
	BIND_TYPE_POINTER int = 1
	// Dyld info rebase opcodes (same high-nibble opcode / low-nibble immediate split as
	// bind).  dyld ADDS the image's load slide to each rebased pointer, so a PIE Mach-O's
	// absolute in-image pointers survive ASLR.  arm64 macOS requires PIE, so a bnld
	// executable with any such pointer (vtables, type info, static-data addresses — every
	// R_AARCH64_ABS64 site whose target is in the image, not an absolute symbol) needs
	// these; without them the pointers keep their unslid value and dereferencing one
	// faults.
	REBASE_OPCODE_DONE int = 0x00
	REBASE_OPCODE_SET_TYPE_IMM int = 0x10
	REBASE_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB int = 0x20
	REBASE_OPCODE_DO_REBASE_IMM_TIMES int = 0x50
	REBASE_TYPE_POINTER int = 1
	// BIND_SYMBOL_FLAGS_WEAK_IMPORT (a low-nibble immediate on
	// SET_SYMBOL_TRAILING_FLAGS_IMM) marks a weak import: dyld binds it to 0 if no
	// library provides it, instead of failing the load.
	BIND_SYMBOL_FLAGS_WEAK_IMPORT int = 0x1
	// nlist_64 constants: an imported symbol is undefined + external, with the
	// providing dylib's ordinal (1 for the first LC_LOAD_DYLIB) in n_desc's high byte.
	// (MACHO_N_WEAK_REF, the low-byte n_desc flag marking a weak reference, is in
	// parse_macho.bn — same package.)
	MACHO_LIBSYSTEM_ORDINAL int = 1
	machoPtrSize int = 8            // a __got slot / pointer
	machoStubSize int = 12          // adrp x16 ; ldr x16,[x16,#off] ; br x16
	machoNlistSize int = 16
)

// machoDsoHandle returns the name of the image's own Mach-O header (C `__dso_handle`, in the
// Mach-O spelling).
func machoDsoHandle() *[]readonly char { return "___dso_handle" }

// machoExecuteHeader returns the name ld64 gives an executable's own Mach-O header (C
// `_mh_execute_header`), the address ___dso_handle has in an executable.
func machoExecuteHeader() *[]readonly char { return "__mh_execute_header" }

// machoInterp is the dynamic linker a hosted arm64 Mach-O loads (LC_LOAD_DYLINKER).
func machoInterp() *[]readonly char { return "/usr/lib/dyld" }

// machoLibSystem is the libc-providing dylib a hosted arm64 Mach-O links (LC_LOAD_DYLIB).
func machoLibSystem() *[]readonly char { return "/usr/lib/libSystem.B.dylib" }

// encMachoStub writes the 12-byte arm64 PLT-style stub at out[off:off+12]: it jumps
// through the import's __got slot (adrp x16,slot@page ; ldr x16,[x16,#slot_lo12] ; br
// x16).  With the non-lazy bind the slot already holds the resolved address.  Returns
// "" or a range error (unreachable in a real executable — __TEXT and __DATA are a few
// pages apart — but a loud failure if that changes).
func encMachoStub(out @[]uint8, off int, stubVa uint64, gotSlot uint64) @[]readonly char {
	var pageMask int64 = 0 - 0x1000
	var pages int64 = ((cast(int64, gotSlot) & pageMask) - (cast(int64, stubVa) & pageMask)) >> 12
	if pages > 0xfffff || pages < (0 - 0x100000) {
		return "Mach-O stub ADRP page offset out of range"
	}
	var lo int = cast(int, gotSlot & cast(uint64, 0xfff))
	writeU32(out, off + 0, encAdrp(16, stubVa, gotSlot))
	writeU32(out, off + 4, encLdr64(16, 16, lo)) // ldr x16, [x16, #lo]
	writeU32(out, off + 8, encBr(16))
	return ""
}

// Synthetic "dynamic-stubs" object section indices.
const (
	dmStubs int = 0 // __stubs: a jump-through-GOT stub per called (impPlt) import
	dmGot int = 1   // __got: a slot per import (all kinds), bound by dyld, then AbsGot's slots
)

// buildMachoDynObj synthesizes the "dynamic-stubs" object: an executable __stubs
// section (one stub per *called* import) and a writable __got section (one slot per
// import, all kinds).  Each import is a defined global so the ordinary Resolve →
// Relocate pipeline retargets the program's references: a called import is defined at
// its __stubs stub (its `bl` branches there; the stub jumps through the GOT slot), a
// data import is defined at its __got slot (its GOT-load is kept pointing at the slot
// — see GotImports).  The stubs' page/GOT fields and the GOT contents are patched /
// bound after Layout.  Returns the object.
func buildMachoDynObj(imports @[]@[]char, kinds @[]int, machine int) @InputObject {
	var n int = len(imports)
	var nPlt int = 0
	for i := 0; i < n; i++ { if kinds[i] == impPlt { nPlt = nPlt + 1 } }
	// __got holds one slot per import.  A dynamic exec with zero imports is still valid
	// (a pure-syscall program must be dynamic to run on arm64 — static does not), so
	// keep at least one (unused) slot: an empty kindData section would be dropped by
	// Layout and leave the writer with no writable group / no __DATA segment.
	var gotSlots int = n
	if gotSlots == 0 { gotSlots = 1 }
	var secs @[]InputSection = make_slice(InputSection, 2)
	secs[dmStubs] = mkDynSection("__stubs", SF_READ | SF_EXEC, 4,
			make_slice(uint8, nPlt * machoStubSize))
	secs[dmGot] = mkDynSection("__got", SF_READ | SF_WRITE, 8,
			make_slice(uint8, gotSlots * machoPtrSize))
	var syms @[]InputSymbol = make_slice(InputSymbol, n)
	var j int = 0 // stub ordinal among the called imports
	for i := 0; i < n; i++ {
		var sym InputSymbol
		sym.Name = buf.CopyStr(imports[i])
		if kinds[i] == impGot {
			sym.SecIndex = dmGot
			sym.Value = cast(uint, i * machoPtrSize) // defined at its GOT slot
		} else {
			sym.SecIndex = dmStubs
			sym.Value = cast(uint, j * machoStubSize) // defined at its stub
			j = j + 1
		}
		sym.Binding = BIND_GLOBAL
		syms[i] = sym
	}
	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr("<dynamic-stubs>")
	obj.Machine = machine
	obj.Sections = secs
	obj.Symbols = syms
	obj.Relocs = make_slice(InputReloc, 0)
	return obj
}

// patchMachoStubs fills each called import's stub (now that Layout placed __stubs and
// __got) to jump through that import's __got slot: stub j (the j-th called import) at
// __stubs + j*machoStubSize targets __got slot i (its unified import index).  dynObj is
// the buildMachoDynObj object; lr the layout.  Returns "" or a stub-encoding error.
func patchMachoStubs(dynObj @InputObject, lr @LayoutResult, imports @[]@[]char,
		kinds @[]int) @[]readonly char {
	var gotVa uint64 = secVaddr(dynObj, lr, dmGot)
	var stubVaBase uint64 = secVaddr(dynObj, lr, dmStubs)
	stubData, stubOff := outData(dynObj, lr, dmStubs)
	var j int = 0
	for i := 0; i < len(imports); i++ {
		if kinds[i] != impPlt { continue }
		var stubVa uint64 = stubVaBase + cast(uint64, j * machoStubSize)
		var gotSlot uint64 = gotVa + cast(uint64, i * machoPtrSize)
		var e @[]readonly char = encMachoStub(stubData, stubOff + j * machoStubSize, stubVa, gotSlot)
		if len(e) != 0 { return e }
		j = j + 1
	}
	return ""
}

// machoIdent returns the last path component of p (the CodeDirectory identifier,
// conventionally the output basename).
func machoIdent(p *[]readonly char) @[]char {
	var start int = 0
	for i := 0; i < len(p); i++ { if p[i] == '/' { start = i + 1 } }
	var out @[]char = make_slice(char, len(p) - start)
	for i := start; i < len(p); i++ { out[i - start] = p[i] }
	return out
}

// LinkDynMacho links inputPaths (arm64 Mach-O objects) into a dynamically-linked,
// ad-hoc-signed Mach-O executable at outPath, entering at entryName.  Undefined
// externals become dynamic imports from libSystem, bound at load by /usr/lib/dyld:
// a *called* import gets a __TEXT stub that jumps through its __got slot; a *data*
// (GOT-referenced) import's GOT-load is kept pointing straight at its __got slot, which
// dyld binds.  A GOT-load of an absolute symbol reads a further __got slot holding its
// value (t.AbsGot), which dyld leaves alone.  Reuses Resolve → Layout → Relocate (a synthesized
// "dynamic-stubs" object defines each import at its stub or its GOT slot; data imports
// are recorded in GotImports so Relocate keeps their loads) then EmitDynMachoExec.
// base is the code base (segStart = base - header size).  Writable program data — the
// initializer / terminator pointers (__mod_init_func / __mod_term_func), .data and .bss —
// joins the __got in a single writable __DATA segment.  `___dso_handle` and
// `__mh_execute_header`, when referenced and not defined, are the Mach-O header.  Returns "" or
// an error.  arm64 only.
func LinkDynMacho(inputPaths @[]@[]char, entryName *[]readonly char, machine int, base uint64,
		outPath *[]readonly char) @[]readonly char {
	if machine != EM_AARCH64 { return "dynamic Mach-O linking supports arm64 only" }

	var program @[]@InputObject = make_slice(@InputObject, len(inputPaths))
	var nObj int = 0
	for i := 0; i < len(inputPaths); i++ {
		data, ok := readFile(inputPaths[i])
		if !ok { return buf.Concat("cannot read input file: ", inputPaths[i]) }
		// bnlint:allow managed-to-raw-assign - a live read-only view of the input bytes
		var raw *[]readonly uint8 = data
		if len(raw) >= 4 && raw[0] == 0xcf && raw[1] == 0xfa && raw[2] == 0xed && raw[3] == 0xfe {
			obj, perr := parseMachoBytes(raw, inputPaths[i])
			if len(perr) != 0 { return perr }
			program[nObj] = obj
			nObj = nObj + 1
		} else {
			return buf.Concat("dynamic Mach-O linking needs Mach-O objects: ", inputPaths[i])
		}
	}
	program = program[0:nObj]
	for i := 0; i < len(program); i++ {
		if program[i].Machine != machine {
			return buf.Concat("object machine does not match the target: ", program[i].Path)
		}
	}
	// The program's common symbols are its own definitions (commons.bn), not imports; a weak
	// definition supersedes one, as in ld64.
	var comErr @[]readonly char
	program, comErr = withCommons(program, machine, true)
	if len(comErr) != 0 { return comErr }

	imports, binds := collectImports(program)
	// `___dso_handle` — the image's own Mach-O header, which a C / C++ object passes to
	// __cxa_atexit with a destructor — and `__mh_execute_header`, an executable's name for the
	// same header, are the linker's when no object defines them, not imports: addresses in the
	// image, which slide with it.
	var headers @[]*[]readonly char = make_slice(*[]readonly char, 2)
	headers[0] = machoDsoHandle()
	headers[1] = machoExecuteHeader()
	var abs @[]AbsSym = make_slice(AbsSym, 0)
	for i := 0; i < len(headers); i++ {
		if referencedNotDefined(program, headers[i]) {
			imports, binds = withoutName(imports, binds, headers[i])
			abs = withImageSym(abs, headers[i])
		}
	}
	kinds, cerr := classifyImports(program, imports)
	if len(cerr) != 0 { return cerr }

	var dynObj @InputObject = buildMachoDynObj(imports, kinds, machine)
	var allObjs @[]@InputObject = make_slice(@InputObject, len(program) + 1)
	for i := 0; i < len(program); i++ { allObjs[i] = program[i] }
	allObjs[len(program)] = dynObj

	t, rerr := ResolveWithAbs(allObjs, abs)
	if len(rerr) != 0 { return rerr }
	// Data (GOT) imports: Relocate must keep their GOT loads pointing at the __got slot
	// (dyld binds it) rather than relaxing them to a direct address.
	t.GotImports = gotImportNames(imports, kinds)
	// The image slides (PIE), so a GOT-indirect reference to an absolute symbol loads a
	// __got slot after the imports' that holds its value, neither bound nor rebased.
	t.PIE = true
	var absGot @[]AbsGotSlot = collectAbsGotTargets(t)
	// Then the linker-made slots (got.bn) of in-image symbols whose GOT references cannot
	// be relaxed, each rebased by the slide.
	slots, gerr := inImageGotSlots(t, collectGotSlots(program, t.GotImports))
	if len(gerr) != 0 { return gerr }
	var nFirst int = len(imports) + len(absGot)
	if len(absGot) + len(slots) > 0 {
		dynObj.Sections[dmGot] = mkDynSection("__got", SF_READ | SF_WRITE, 8,
				make_slice(uint8, (nFirst + len(slots)) * machoPtrSize))
	}
	// 16 KB pages so Layout puts the writable group (program .data/.bss + the __got) on a
	// Mach-O-aligned page.
	var lr @LayoutResult = LayoutPaged(allObjs, base, machoDynPage)
	for i := 0; i < len(headers); i++ {
		setAbsValue(t, headers[i], machoDynHeaderAddr(lr.Sections))
	}
	var gotVa uint64 = secVaddr(dynObj, lr, dmGot)
	for i := 0; i < len(absGot); i++ {
		absGot[i].Addr = gotVa + cast(uint64, (len(imports) + i) * machoPtrSize)
	}
	t.AbsGot = absGot
	placeGotSlots(slots, gotVa, nFirst)
	t.GotSlots = slots

	oo, ss, found := t.Lookup(entryName)
	if !found { return buf.Concat("entry symbol not defined: ", entryName) }
	entryAddr, eok := symbolAddr(t, lr, oo, ss)
	if !eok { return buf.Concat("entry symbol has no address: ", entryName) }

	var perr @[]readonly char = Relocate(t, lr)
	if len(perr) != 0 { return perr }

	var serr @[]readonly char = patchMachoStubs(dynObj, lr, imports, kinds)
	if len(serr) != 0 { return serr }
	gotData, gotOff := outData(dynObj, lr, dmGot)
	for i := 0; i < len(absGot); i++ {
		var sym InputSymbol = t.Objs[absGot[i].ObjIdx].Symbols[absGot[i].SymIdx]
		writeU64(gotData, gotOff + (len(imports) + i) * machoPtrSize, sym.AbsValue)
	}
	var ferr @[]readonly char = fillGotSlots(t, lr, gotData, gotOff, nFirst)
	if len(ferr) != 0 { return ferr }

	// __DATA is the 3rd segment (__PAGEZERO, __TEXT, __DATA), so the bind stream names
	// segment index 2.  The __got may not be at the segment start — program .data
	// precedes it in __DATA — so the bind offsets are relative to the __got's position
	// within the writable segment (its vaddr minus the segment's base vaddr).
	_, rwLo, _, rwMemEnd, _ := groupStats(lr.Sections, true)
	var gotSegOff int = cast(int, secVaddr(dynObj, lr, dmGot) - rwLo)
	var bindOps @[]uint8 = buildMachoBind(imports, 2, gotSegOff, binds)
	// Rebase every absolute in-image pointer (an ABS64 site, a linker-made GOT slot) by the
	// load slide.  Each must sit in the writable __DATA segment (index 2, as the bind stream
	// also names), the rebase offset relative to that segment's base vaddr (rwLo): an ABS64
	// word in a read-only or executable section cannot be rebased, as ld64 rejects a text
	// relocation.
	var absSites @[]uint64 = collectMachoRebaseSites(t, lr)
	var gotSites @[]uint64 = gotSlotRebaseSites(t)
	for i := 0; i < len(absSites); i++ {
		if absSites[i] < rwLo || absSites[i] >= rwMemEnd {
			return "an absolute pointer to an in-image symbol is in a read-only or executable section; "
					"dyld rebases only the writable __DATA segment"
		}
	}
	for i := 0; i < len(gotSites); i++ {
		if gotSites[i] < rwLo || gotSites[i] >= rwMemEnd {
			return "internal error: a linker-made GOT slot is outside __DATA"
		}
	}
	var rebaseSites @[]uint64 = concatSites(absSites, gotSites)
	var rebaseOffs @[]int = make_slice(int, len(rebaseSites))
	for i := 0; i < len(rebaseSites); i++ { rebaseOffs[i] = cast(int, rebaseSites[i] - rwLo) }
	var rebaseOps @[]uint8 = buildMachoRebase(rebaseOffs, 2)
	symtab, strtab := buildMachoSymtab(imports, binds)
	return EmitDynMachoExec(lr.Sections, entryAddr, machine, rebaseOps, bindOps, symtab, len(imports),
			strtab, machoIdent(outPath), outPath)
}
