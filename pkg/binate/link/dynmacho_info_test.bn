package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// The dyld info encoders (dynmacho_info.bn): the bind and rebase opcode streams and the
// symbol table of a dynamic Mach-O.

// globalBinds returns n BIND_GLOBAL bindings — the common non-weak import case for the
// bind/symtab builders, which take a per-import binding.
func globalBinds(n int) @[]int {
	var b @[]int = make_slice(int, n)
	for i := 0; i < n; i++ { b[i] = BIND_GLOBAL }
	return b
}

// buildMachoBind emits the non-lazy bind stream: SET_DYLIB_ORDINAL(1), SET_TYPE
// (POINTER), then per import SET_SYMBOL(name), SET_SEGMENT_AND_OFFSET(seg, i*8),
// DO_BIND, and a trailing DONE.
func TestBuildMachoBind() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = buf.CopyStr("_exit")
	var b @[]uint8 = buildMachoBind(imports, 2, 0, globalBinds(len(imports)))
	// 0x11 0x51 0x40 '_' 'e' 'x' 'i' 't' 0x00 0x72 0x00 0x90 0x00
	var want @[]int = make_slice(int, 13)
	want[0] = BIND_OPCODE_SET_DYLIB_ORDINAL_IMM | 1
	want[1] = BIND_OPCODE_SET_TYPE_IMM | BIND_TYPE_POINTER
	want[2] = BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM
	want[3] = cast(int, '_')
	want[4] = cast(int, 'e')
	want[5] = cast(int, 'x')
	want[6] = cast(int, 'i')
	want[7] = cast(int, 't')
	want[8] = 0
	want[9] = BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | 2
	want[10] = 0 // uleb(0)
	want[11] = BIND_OPCODE_DO_BIND
	want[12] = BIND_OPCODE_DONE
	if len(b) != 13 { return fail("bind stream should be 13 bytes for one import") }
	for i := 0; i < 13; i++ {
		if cast(int, b[i]) != want[i] { return fail("bind opcode byte mismatch") }
	}
	return ""
}

// buildMachoRebase encodes SET_TYPE_IMM(POINTER), then per site
// SET_SEGMENT_AND_OFFSET(seg, off) + DO_REBASE_IMM_TIMES(1), and a trailing DONE.  Two
// sites at __DATA (segment 2) offsets 0x10 and 0x18 — both single-byte ULEBs.
func TestBuildMachoRebase() testing.TestResult {
	var offs @[]int = make_slice(int, 2)
	offs[0] = 0x10
	offs[1] = 0x18
	var b @[]uint8 = buildMachoRebase(offs, 2)
	var want @[]int = make_slice(int, 8)
	want[0] = REBASE_OPCODE_SET_TYPE_IMM | REBASE_TYPE_POINTER
	want[1] = REBASE_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | 2
	want[2] = 0x10 // uleb(0x10)
	want[3] = REBASE_OPCODE_DO_REBASE_IMM_TIMES | 1
	want[4] = REBASE_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | 2
	want[5] = 0x18 // uleb(0x18)
	want[6] = REBASE_OPCODE_DO_REBASE_IMM_TIMES | 1
	want[7] = REBASE_OPCODE_DONE
	if len(b) != 8 { return fail("rebase stream should be 8 bytes for two sites") }
	for i := 0; i < 8; i++ {
		if cast(int, b[i]) != want[i] { return fail("rebase opcode byte mismatch") }
	}
	return ""
}

// No sites -> an empty rebase stream (EmitDynMachoExec then leaves rebase_off/size 0).
func TestBuildMachoRebaseEmpty() testing.TestResult {
	if len(buildMachoRebase(make_slice(int, 0), 2)) != 0 {
		return fail("an empty site list should produce no rebase opcodes")
	}
	return ""
}

// A second import advances the __got offset in its SET_SEGMENT_AND_OFFSET_ULEB (8,
// one pointer past the first).
func TestBuildMachoBindTwoImports() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 2)
	imports[0] = buf.CopyStr("_a")
	imports[1] = buf.CopyStr("_bb")
	var b @[]uint8 = buildMachoBind(imports, 2, 0, globalBinds(len(imports)))
	// Find the two DO_BIND opcodes; the ULEB before the second must be 8.
	var binds int = 0
	for i := 0; i < len(b); i++ { if cast(int, b[i]) == BIND_OPCODE_DO_BIND { binds = binds + 1 } }
	if binds != 2 { return fail("expected two DO_BIND opcodes") }
	// The last data byte before DONE is DO_BIND; the byte before its SET_OFFSET uleb is 8.
	// (offset for import 1 = 1*machoPtrSize = 8, a single-byte uleb.)
	var sawEight bool = false
	for i := 1; i < len(b); i++ {
		if cast(int, b[i - 1]) == (BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | 2) && cast(int, b[i]) == 8 {
			sawEight = true
		}
	}
	if !sawEight { return fail("the second import's __got offset should be 8") }
	return ""
}

// buildMachoSymtab emits one UND external nlist_64 per import (n_strx into the
// strtab, n_type = N_EXT, n_desc = dylib ordinal << 8) plus a NUL-led string table.
func TestBuildMachoSymtab() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = buf.CopyStr("_exit")
	syms, strs := buildMachoSymtab(imports, globalBinds(len(imports)))
	if len(syms) != machoNlistSize { return fail("expected one nlist_64") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rs *[]readonly uint8 = syms
	if u32(rs, 0) != 1 { return fail("n_strx should be 1 (past the leading NUL)") }
	if syms[4] != cast(uint8, MACHO_N_EXT) {
		return fail("n_type should be N_EXT (undefined external)")
	}
	if u16(rs, 6) != MACHO_LIBSYSTEM_ORDINAL << 8 {
		return fail("n_desc should carry the dylib ordinal")
	}
	// strtab = \0 _exit \0
	if len(strs) != 1 + len("_exit") + 1 { return fail("wrong strtab size") }
	if strs[0] != 0 { return fail("strtab[0] should be the empty-string NUL") }
	if strs[1] != cast(uint8, '_') || strs[5] != cast(uint8, 't') {
		return fail("strtab should hold _exit")
	}
	return ""
}

// buildMachoBind places each __got slot at gotSegOff + i*8: when program .data precedes
// the __got in __DATA, the first slot's bind offset is the __got's segment offset (here
// 16), not 0 — binding into the __got, not into the program's data.
func TestBuildMachoBindGotOffset() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = buf.CopyStr("_f")
	// __got at segment offset 16 (as if 16 bytes of program .data preceded it).
	var b @[]uint8 = buildMachoBind(imports, 2, 16, globalBinds(len(imports)))
	var sawOff bool = false
	for i := 1; i < len(b); i++ {
		if cast(int, b[i - 1]) == (BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | 2) && cast(int, b[i]) == 16 {
			sawOff = true
		}
	}
	if !sawOff { return fail("the __got slot's bind offset should be gotSegOff (16), not 0") }
	return ""
}

// A weak import (binds[i] == BIND_WEAK) carries BIND_SYMBOL_FLAGS_WEAK_IMPORT in its
// bind flags byte and N_WEAK_REF in its nlist n_desc, so dyld binds it to 0 (rather than
// failing the load) when no library provides it.  A global import gets neither.
func TestBuildMachoWeakImport() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = buf.CopyStr("_w")
	var binds @[]int = make_slice(int, 1)
	binds[0] = BIND_WEAK
	// b[0]=SET_DYLIB, b[1]=SET_TYPE, b[2]=SET_SYMBOL_TRAILING_FLAGS for the first import.
	var b @[]uint8 = buildMachoBind(imports, 2, 0, binds)
	if cast(int, b[2]) != (BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM | BIND_SYMBOL_FLAGS_WEAK_IMPORT) {
		return fail("a weak import's bind flags should set WEAK_IMPORT")
	}
	syms, _ := buildMachoSymtab(imports, binds)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rs *[]readonly uint8 = syms
	var nDesc int = u16(rs, 6)
	if (nDesc & MACHO_N_WEAK_REF) == 0 { return fail("a weak import's n_desc should set N_WEAK_REF") }
	if (nDesc >> 8) != MACHO_LIBSYSTEM_ORDINAL { return fail("n_desc should keep the dylib ordinal") }
	return ""
}
