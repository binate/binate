package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/macho"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// (fail is in parse_elf_test.bn; u16/u32/charsEqual in bytes.bn — same package.)

// globalBinds returns n BIND_GLOBAL bindings — the common non-weak import case for the
// bind/symtab builders, which now take a per-import binding.
func globalBinds(n int) @[]int {
	var b @[]int = make_slice(int, n)
	for i := 0; i < n; i++ { b[i] = BIND_GLOBAL }
	return b
}

// buildMachoBind emits the non-lazy bind stream: SET_DYLIB_ORDINAL(1), SET_TYPE
// (POINTER), then per import SET_SYMBOL(name), SET_SEGMENT_AND_OFFSET(seg, i*8),
// DO_BIND, and a trailing DONE.
func TestBuildMachoBind() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = buf.CopyStr("_exit")
	var b @[]uint8 = buildMachoBind(imports, 2, 0, globalBinds(len(imports)))
	// 0x11 0x51 0x40 '_' 'e' 'x' 'i' 't' 0x00 0x72 0x00 0x90 0x00
	var want @[]int = make_slice(int, 13)
	want[0] = BIND_OPCODE_SET_DYLIB_ORDINAL_IMM | 1
	want[1] = BIND_OPCODE_SET_TYPE_IMM | BIND_TYPE_POINTER
	want[2] = BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM
	want[3] = cast(int, '_')
	want[4] = cast(int, 'e')
	want[5] = cast(int, 'x')
	want[6] = cast(int, 'i')
	want[7] = cast(int, 't')
	want[8] = 0
	want[9] = BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | 2
	want[10] = 0 // uleb(0)
	want[11] = BIND_OPCODE_DO_BIND
	want[12] = BIND_OPCODE_DONE
	if len(b) != 13 { return fail("bind stream should be 13 bytes for one import") }
	for i := 0; i < 13; i++ {
		if cast(int, b[i]) != want[i] { return fail("bind opcode byte mismatch") }
	}
	return ""
}

// A second import advances the __got offset in its SET_SEGMENT_AND_OFFSET_ULEB (8,
// one pointer past the first).
func TestBuildMachoBindTwoImports() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 2)
	imports[0] = buf.CopyStr("_a")
	imports[1] = buf.CopyStr("_bb")
	var b @[]uint8 = buildMachoBind(imports, 2, 0, globalBinds(len(imports)))
	// Find the two DO_BIND opcodes; the ULEB before the second must be 8.
	var binds int = 0
	for i := 0; i < len(b); i++ { if cast(int, b[i]) == BIND_OPCODE_DO_BIND { binds = binds + 1 } }
	if binds != 2 { return fail("expected two DO_BIND opcodes") }
	// The last data byte before DONE is DO_BIND; the byte before its SET_OFFSET uleb is 8.
	// (offset for import 1 = 1*machoPtrSize = 8, a single-byte uleb.)
	var sawEight bool = false
	for i := 1; i < len(b); i++ {
		if cast(int, b[i - 1]) == (BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | 2) && cast(int, b[i]) == 8 {
			sawEight = true
		}
	}
	if !sawEight { return fail("the second import's __got offset should be 8") }
	return ""
}

// buildMachoSymtab emits one UND external nlist_64 per import (n_strx into the
// strtab, n_type = N_EXT, n_desc = dylib ordinal << 8) plus a NUL-led string table.
func TestBuildMachoSymtab() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = buf.CopyStr("_exit")
	syms, strs := buildMachoSymtab(imports, globalBinds(len(imports)))
	if len(syms) != machoNlistSize { return fail("expected one nlist_64") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rs *[]readonly uint8 = syms
	if u32(rs, 0) != 1 { return fail("n_strx should be 1 (past the leading NUL)") }
	if syms[4] != cast(uint8, MACHO_N_EXT) {
		return fail("n_type should be N_EXT (undefined external)")
	}
	if u16(rs, 6) != MACHO_LIBSYSTEM_ORDINAL << 8 {
		return fail("n_desc should carry the dylib ordinal")
	}
	// strtab = \0 _exit \0
	if len(strs) != 1 + len("_exit") + 1 { return fail("wrong strtab size") }
	if strs[0] != 0 { return fail("strtab[0] should be the empty-string NUL") }
	if strs[1] != cast(uint8, '_') || strs[5] != cast(uint8, 't') {
		return fail("strtab should hold _exit")
	}
	return ""
}

// encMachoStub encodes a jump through the __got slot: adrp x16,page ; ldr x16,[x16,
// #lo12] ; br x16 — a 64-bit LDR (top 10 bits 0xf9400000) and a BR x16.
func TestEncMachoStub() testing.TestResult {
	var out @[]uint8 = make_slice(uint8, machoStubSize)
	// stub at 0x100004000, GOT slot at 0x100008000 (one 16 KB page apart).
	if len(encMachoStub(out, 0, cast(uint, 0x100004000), cast(uint, 0x100008000))) != 0 {
		return fail("encMachoStub should succeed for an in-range slot")
	}
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = out
	if (u32(r, 0) & 0x9f000000) != 0x90000000 { return fail("first insn should be an ADRP") }
	if (u32(r, 4) & 0xffc00000) != 0xf9400000 { return fail("second insn should be a 64-bit LDR") }
	if u32(r, 8) != cast(int, 0xd61f0000 | (16 << 5)) { return fail("third insn should be BR x16") }
	return ""
}

// encMachoStub rejects a slot more than 4 GB from the stub (the ADRP page count
// overflows) — a loud failure rather than a truncated jump.
func TestEncMachoStubOutOfRange() testing.TestResult {
	var out @[]uint8 = make_slice(uint8, machoStubSize)
	if len(encMachoStub(out, 0, cast(uint, 0x1000), cast(uint, 0x200000000))) == 0 {
		return fail("encMachoStub should reject an out-of-range slot")
	}
	return ""
}

// machoLcOffset scans the load commands of a Mach-O executable image for the first
// command of type `cmd`, returning its byte offset or -1.
func machoLcOffset(rd *[]readonly uint8, cmd int) int {
	var ncmds int = u32(rd, 16)
	var off int = 32
	for i := 0; i < ncmds; i++ {
		if u32(rd, off) == cmd { return off }
		off = off + u32(rd, off + 4) // cmdsize
	}
	return -1
}

// End-to-end: a program whose _start calls libSystem `_exit` links into a dynamic
// Mach-O executable that names /usr/lib/dyld + libSystem, carries LC_MAIN and a bind
// stream for `_exit`, and is ad-hoc signed.  (Actually RUNNING it needs macOS + dyld —
// see e2e; this checks the structure, host-independently.)
func TestLinkDynMachoExit() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.SetGlobal("_exit") // undefined external -> a dynamic import
	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(42))
	aarch64.Bl(a, "_exit")
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	if !macho.WriteARM64(a, "/tmp/binate_dynmacho_prog.o") { return fail("write object failed") }

	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = buf.CopyStr("/tmp/binate_dynmacho_prog.o")
	var err @[]readonly char = LinkDynMacho(paths, "_start", EM_AARCH64, cast(uint, 0x100004000),
			"/tmp/binate_dynmacho_exit")
	if len(err) != 0 { return fail(buf.Concat("LinkDynMacho failed: ", err)) }

	data, ok := readFile("/tmp/binate_dynmacho_exit")
	if !ok { return fail("cannot read the linked executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	if u32(rd, 0) != 0xfeedfacf { return fail("not a 64-bit Mach-O") }
	if u32(rd, 12) != MACHO_MH_EXECUTE { return fail("not MH_EXECUTE") }
	if machoLcOffset(rd, MACHO_LC_MAIN) < 0 { return fail("no LC_MAIN") }
	if machoLcOffset(rd, MACHO_LC_LOAD_DYLINKER) < 0 { return fail("no LC_LOAD_DYLINKER") }
	if machoLcOffset(rd, MACHO_LC_DYLD_INFO_ONLY) < 0 { return fail("no LC_DYLD_INFO_ONLY") }
	if machoLcOffset(rd, MACHO_LC_CODE_SIGNATURE) < 0 { return fail("no LC_CODE_SIGNATURE") }
	var dylib int = machoLcOffset(rd, MACHO_LC_LOAD_DYLIB)
	if dylib < 0 { return fail("no LC_LOAD_DYLIB") }
	// The dylib name (lc_str at offset 24) must be libSystem.
	if !bytesAtEqual(rd, dylib + 24, "/usr/lib/libSystem.B.dylib") {
		return fail("LC_LOAD_DYLIB should name libSystem")
	}
	return ""
}

// bytesAtEqual reports whether rd[off:off+len(s)] equals s.
func bytesAtEqual(rd *[]readonly uint8, off int, s *[]readonly char) bool {
	if off + len(s) > len(rd) { return false }
	for i := 0; i < len(s); i++ {
		if rd[off + i] != cast(uint8, s[i]) { return false }
	}
	return true
}

// buildMachoDynObj defines a called import at a __stubs stub and a data import at its
// __got slot: mixed [puts(called), datum(data)] -> 1 stub, 2 GOT slots, and each
// symbol defined in the right synthetic section.
func TestBuildMachoDynObjMixed() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 2)
	imports[0] = buf.CopyStr("_puts") // called
	imports[1] = buf.CopyStr("_datum") // data (GOT)
	var kinds @[]int = make_slice(int, 2)
	kinds[0] = impPlt
	kinds[1] = impGot
	var obj @InputObject = buildMachoDynObj(imports, kinds, EM_AARCH64)
	if len(obj.Sections[dmStubs].Data) != machoStubSize {
		return fail("expected one PLT stub (_puts)")
	}
	if len(obj.Sections[dmGot].Data) != 2 * machoPtrSize { return fail("expected two __got slots") }
	if obj.Symbols[0].SecIndex != dmStubs { return fail("_puts should be defined in __stubs") }
	if obj.Symbols[1].SecIndex != dmGot { return fail("_datum should be defined in __got") }
	// _datum is import index 1, so it is defined at __got slot 1 (offset 8).
	if obj.Symbols[1].Value != cast(uint, machoPtrSize) {
		return fail("_datum should be at __got slot 1")
	}
	return ""
}

// End-to-end: a program that GOT-loads an undefined DATA symbol (_datum) and calls
// _exit links into a dynamic Mach-O (the data import is NOT rejected) with a
// __DATA __got and a bind stream.  (Running it needs macOS + dyld — see e2e,
// which reads libSystem ___stdoutp; this checks structure host-independently.)
func TestLinkDynMachoData() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.SetGlobal("_datum") // undefined data external -> a GOT import
	a.SetGlobal("_exit") // undefined function external -> a stub import
	aarch64.AdrpGot(a, aarch64.X0, "_datum")
	aarch64.LdrGotLo12(a, aarch64.X0, aarch64.X0, "_datum")
	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(0))
	aarch64.Bl(a, "_exit")
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	if !macho.WriteARM64(a, "/tmp/binate_dynmacho_data.o") { return fail("write object failed") }

	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = buf.CopyStr("/tmp/binate_dynmacho_data.o")
	var err @[]readonly char = LinkDynMacho(paths, "_start", EM_AARCH64, cast(uint, 0x100004000),
			"/tmp/binate_dynmacho_data")
	if len(err) != 0 { return fail(buf.Concat("LinkDynMacho (data import) failed: ", err)) }

	data, ok := readFile("/tmp/binate_dynmacho_data")
	if !ok { return fail("cannot read the linked executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	if u32(rd, 0) != 0xfeedfacf { return fail("not a 64-bit Mach-O") }
	if machoLcOffset(rd, MACHO_LC_DYLD_INFO_ONLY) < 0 { return fail("no LC_DYLD_INFO_ONLY") }
	if machoDataSegVmsize(rd) < 0 { return fail("no __DATA for the __got") }
	return ""
}

// A dynamic exec with ZERO imports still links (a pure-syscall program must be dynamic
// to run on arm64): __DATA is kept present via an unused __got slot rather than
// erroring on an empty writable group.
func TestLinkDynMachoNoImports() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(42))
	aarch64.Ret(a) // no imports; only the link path is under test here
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	if !macho.WriteARM64(a, "/tmp/binate_dynmacho_noimp.o") { return fail("write object failed") }

	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = buf.CopyStr("/tmp/binate_dynmacho_noimp.o")
	var err @[]readonly char = LinkDynMacho(paths, "_start", EM_AARCH64, cast(uint, 0x100004000),
			"/tmp/binate_dynmacho_noimp")
	if len(err) != 0 { return fail(buf.Concat("LinkDynMacho (no imports) failed: ", err)) }

	data, ok := readFile("/tmp/binate_dynmacho_noimp")
	if !ok { return fail("cannot read the linked executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	if u32(rd, 0) != 0xfeedfacf { return fail("not a 64-bit Mach-O") }
	if machoDataSegVmsize(rd) < 0 { return fail("__DATA should still be present") }
	return ""
}

// buildMachoBind places each __got slot at gotSegOff + i*8: when program .data precedes
// the __got in __DATA, the first slot's bind offset is the __got's segment offset (here
// 16), not 0 — binding into the __got, not into the program's data.
func TestBuildMachoBindGotOffset() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = buf.CopyStr("_f")
	// __got at segment offset 16 (as if 16 bytes of program .data preceded it).
	var b @[]uint8 = buildMachoBind(imports, 2, 16, globalBinds(len(imports)))
	var sawOff bool = false
	for i := 1; i < len(b); i++ {
		if cast(int, b[i - 1]) == (BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB | 2) && cast(int, b[i]) == 16 {
			sawOff = true
		}
	}
	if !sawOff { return fail("the __got slot's bind offset should be gotSegOff (16), not 0") }
	return ""
}

// A program with a writable .data section links into a dynamic Mach-O (no longer
// rejected): program .data and the __got share the single writable __DATA segment.
// (The e2e RUNS the writable-data path — mutating a .data + .bss global; this checks
// the link succeeds and produces __DATA, host-independently.)
func TestLinkDynMachoWritableData() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("data", -1)
	a.DefineLabel("_g")
	a.SetGlobal("_g")
	a.EmitUint32(cast(uint32, 40)) // a writable program global
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.SetGlobal("_exit") // a called import, so the __got sits after the program .data
	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(0))
	aarch64.Bl(a, "_exit")
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	if !macho.WriteARM64(a, "/tmp/binate_dynmacho_wdata.o") { return fail("write object failed") }

	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = buf.CopyStr("/tmp/binate_dynmacho_wdata.o")
	var err @[]readonly char = LinkDynMacho(paths, "_start", EM_AARCH64, cast(uint, 0x100004000),
			"/tmp/binate_dynmacho_wdata")
	if len(err) != 0 { return fail(buf.Concat("LinkDynMacho (writable data) failed: ", err)) }

	data, ok := readFile("/tmp/binate_dynmacho_wdata")
	if !ok { return fail("cannot read the linked executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	if u32(rd, 0) != 0xfeedfacf { return fail("not a 64-bit Mach-O") }
	if machoDataSegVmsize(rd) < 0 { return fail("no writable __DATA segment") }
	return ""
}

// A weak import (binds[i] == BIND_WEAK) carries BIND_SYMBOL_FLAGS_WEAK_IMPORT in its
// bind flags byte and N_WEAK_REF in its nlist n_desc, so dyld binds it to 0 (rather than
// failing the load) when no library provides it.  A global import gets neither.
func TestBuildMachoWeakImport() testing.TestResult {
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = buf.CopyStr("_w")
	var binds @[]int = make_slice(int, 1)
	binds[0] = BIND_WEAK
	// b[0]=SET_DYLIB, b[1]=SET_TYPE, b[2]=SET_SYMBOL_TRAILING_FLAGS for the first import.
	var b @[]uint8 = buildMachoBind(imports, 2, 0, binds)
	if cast(int, b[2]) != (BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM | BIND_SYMBOL_FLAGS_WEAK_IMPORT) {
		return fail("a weak import's bind flags should set WEAK_IMPORT")
	}
	syms, _ := buildMachoSymtab(imports, binds)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rs *[]readonly uint8 = syms
	var nDesc int = u16(rs, 6)
	if (nDesc & MACHO_N_WEAK_REF) == 0 { return fail("a weak import's n_desc should set N_WEAK_REF") }
	if (nDesc >> 8) != MACHO_LIBSYSTEM_ORDINAL { return fail("n_desc should keep the dylib ordinal") }
	return ""
}

// machoNlistDesc returns the n_desc of the symbol named `name` in a linked Mach-O's
// LC_SYMTAB (matched exactly, NUL-terminated), or -1 if absent.
func machoNlistDesc(rd *[]readonly uint8, name *[]readonly char) int {
	var sym int = machoLcOffset(rd, MACHO_LC_SYMTAB)
	if sym < 0 { return -1 }
	var symOff int = u32(rd, sym + 8)
	var nSyms int = u32(rd, sym + 12)
	var strOff int = u32(rd, sym + 16)
	for i := 0; i < nSyms; i++ {
		var e int = symOff + i * 16
		var nameOff int = strOff + u32(rd, e + 0)
		if bytesAtEqual(rd, nameOff, name) && nameOff + len(name) < len(rd) &&
				rd[nameOff + len(name)] == 0 {
			return u16(rd, e + 6) // n_desc
		}
	}
	return -1
}

// End-to-end: a program with a WEAK undefined import (via SetWeak) and a STRONG one,
// linked, carries N_WEAK_REF on the weak import's nlist and not on the strong one —
// exercising the full chain (asm .weak -> Mach-O object N_WEAK_REF -> parse BIND_WEAK ->
// link WEAK bind).  (The e2e RUNS a weak-absent import and confirms it binds to 0.)
func TestLinkDynMachoWeakImport() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.SetWeak("_weakfn") // a WEAK undefined import
	a.SetGlobal("_exit") // a STRONG undefined import
	aarch64.Bl(a, "_weakfn")
	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(0))
	aarch64.Bl(a, "_exit")
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	if !macho.WriteARM64(a, "/tmp/binate_dynmacho_weak.o") { return fail("write object failed") }

	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = buf.CopyStr("/tmp/binate_dynmacho_weak.o")
	var err @[]readonly char = LinkDynMacho(paths, "_start", EM_AARCH64, cast(uint, 0x100004000),
			"/tmp/binate_dynmacho_weak")
	if len(err) != 0 { return fail(buf.Concat("LinkDynMacho (weak import) failed: ", err)) }

	data, ok := readFile("/tmp/binate_dynmacho_weak")
	if !ok { return fail("cannot read the linked executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	var weakDesc int = machoNlistDesc(rd, "_weakfn")
	var exitDesc int = machoNlistDesc(rd, "_exit")
	if weakDesc < 0 || exitDesc < 0 { return fail("import nlists not found in the symtab") }
	if (weakDesc & MACHO_N_WEAK_REF) == 0 { return fail("_weakfn should carry N_WEAK_REF") }
	if (exitDesc & MACHO_N_WEAK_REF) != 0 { return fail("_exit (strong) should not carry N_WEAK_REF") }
	return ""
}
