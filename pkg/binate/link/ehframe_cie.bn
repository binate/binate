package "pkg/binate/link"

// Reading `.eh_frame` records for `.eh_frame_hdr` (ehframe_hdr.bn): the pointer encoding a
// CIE gives its FDEs, and the address an encoded pointer holds.

// cieFdeEncoding returns the encoding (DW_EH_PE_*) of the FDE addresses of the CIE at c in d,
// whose section ends at end, pointers ptrSize bytes: its 'R' augmentation's, or absptr for a
// CIE without one.  A CIE it cannot read with certainty is an error, as lld rejects it: a
// version other than 1 or 3, an augmentation it does not know, a personality pointer of an
// encoding without a fixed size or aligned (padded to a pointer boundary), or augmentation data
// running past the length the CIE gives it.
func cieFdeEncoding(d *[]readonly uint8, c int, end int, ptrSize int) (int, @[]readonly char) {
	var bad @[]readonly char = "an .eh_frame CIE whose augmentation bnld cannot read"
	length, id, err := ehRecordAt(d, c, end)
	if len(err) != 0 { return 0, err }
	if length == 0 || id != 0 { return 0, "an FDE's CIE pointer does not point at a CIE" }
	var cend int = c + 4 + length
	if c + 9 > cend { return 0, bad }
	var version int = cast(int, d[c + 8])
	if version != 1 && version != 3 { return 0, bad }
	var aug int = c + 9
	var p int = aug
	for p < cend && d[p] != 0 { p = p + 1 }
	if p >= cend { return 0, bad }
	var augEnd int = p
	if augEnd == aug { return dwEhPeAbsptr, "" }
	if d[aug] != 'z' { return 0, bad }
	p = skipLeb(d, p + 1, cend) // code alignment factor
	p = skipLeb(d, p, cend) // data alignment factor
	if version == 1 {
		if p >= 0 { p = p + 1 } // return-address register, a byte in version 1
	} else {
		p = skipLeb(d, p, cend)
	}
	var dataLen int = 0
	dataLen, p = readUleb(d, p, cend) // augmentation data length
	if p < 0 || dataLen > cend - p { return 0, bad }
	var dataEnd int = p + dataLen
	for i := aug + 1; i < augEnd; i++ {
		if p >= dataEnd { return 0, bad }
		var ch uint8 = d[i]
		if ch == 'R' { return cast(int, d[p]), "" }
		if ch == 'L' {
			p = p + 1 // the LSDA pointer's encoding
		} else if ch == 'P' {
			var size int = encodedSize(cast(int, d[p]), ptrSize)
			if size < 0 || (cast(int, d[p]) & 0x70) == dwEhPeAligned { return 0, bad }
			p = p + 1 + size // the personality pointer's encoding and the pointer
		} else if ch != 'S' && ch != 'B' && ch != 'G' {
			return 0, bad
		}
	}
	return dwEhPeAbsptr, ""
}

// readUleb returns the unsigned LEB128 number at p in d (ending at end) and the index after
// it, or (0, -1) when it runs past end, p is already -1, or it does not fit an int.
func readUleb(d *[]readonly uint8, p int, end int) (int, int) {
	if p < 0 { return 0, -1 }
	var v int = 0
	var shift int = 0
	for p < end {
		var b int = cast(int, d[p])
		if shift > 28 { return 0, -1 }
		v = v | ((b & 0x7f) << cast(uint, shift))
		p = p + 1
		if (b & 0x80) == 0 { return v, p }
		shift = shift + 7
	}
	return 0, -1
}

// skipLeb returns the index after the LEB128 number at p in d (ending at end), or -1 when it
// runs past end or p is already -1.
func skipLeb(d *[]readonly uint8, p int, end int) int {
	if p < 0 { return -1 }
	for p < end {
		if (d[p] & 0x80) == 0 { return p + 1 }
		p = p + 1
	}
	return -1
}

// encodedSize returns the size in bytes of a pointer of encoding enc (DW_EH_PE_*), a native
// pointer being ptrSize bytes, or -1 for a format of no fixed size (LEB128).
func encodedSize(enc int, ptrSize int) int {
	var format int = enc & 0x0f
	if format == dwEhPeAbsptr { return ptrSize }
	if format == dwEhPeUdata2 || format == dwEhPeSdata2 { return 2 }
	if format == dwEhPeUdata4 || format == dwEhPeSdata4 { return 4 }
	if format == dwEhPeUdata8 || format == dwEhPeSdata8 { return 8 }
	return -1
}

// ehDecode returns the address the pointer of encoding enc at p in d holds (the record ending
// at end), the pointer itself being at address at (for DW_EH_PE_pcrel), pointers ptrSize
// bytes.  An indirect value, one relative to anything but nothing or its own address, or one
// of no fixed size is an error.
func ehDecode(d *[]readonly uint8, p int, end int, enc int, ptrSize int,
		at uint64) (uint64, @[]readonly char) {
	var bad @[]readonly char = "an .eh_frame FDE address of an encoding bnld cannot read"
	var app int = enc & 0x70
	if (enc & dwEhPeIndirect) != 0 || (app != 0 && app != dwEhPePcrel) { return 0, bad }
	var size int = encodedSize(enc, ptrSize)
	if size < 0 || p + size > end { return 0, bad }
	var v uint64 = 0
	for i := size - 1; i >= 0; i = i - 1 { v = (v << 8) | cast(uint64, d[p + i]) }
	var format int = enc & 0x0f
	var signed bool = format == dwEhPeSdata2 || format == dwEhPeSdata4 || format == dwEhPeSdata8
	if signed && size < 8 && (v >> cast(uint, 8 * size - 1)) != 0 {
		v = v | (~cast(uint64, 0) << cast(uint, 8 * size))
	}
	if app == dwEhPePcrel { v = v + at }
	if ptrSize == 4 { v = v & 0xffffffff }
	return v, ""
}

// sortEhPairs sorts locs ascending, keeping each fdes entry with its locs one: a stable merge
// sort, an image's FDE count running to the thousands.
func sortEhPairs(locs @[]uint64, fdes @[]uint64) {
	var n int = len(locs)
	var tl @[]uint64 = make_slice(uint64, n)
	var tf @[]uint64 = make_slice(uint64, n)
	var w int = 1
	for w < n {
		var lo int = 0
		for lo < n {
			var mid int = lo + w
			if mid > n { mid = n }
			var hi int = lo + 2 * w
			if hi > n { hi = n }
			var i int = lo
			var j int = mid
			for k := lo; k < hi; k++ {
				if i < mid && (j >= hi || locs[i] <= locs[j]) {
					tl[k] = locs[i]
					tf[k] = fdes[i]
					i = i + 1
				} else {
					tl[k] = locs[j]
					tf[k] = fdes[j]
					j = j + 1
				}
			}
			lo = hi
		}
		for k := 0; k < n; k++ {
			locs[k] = tl[k]
			fdes[k] = tf[k]
		}
		w = 2 * w
	}
}
