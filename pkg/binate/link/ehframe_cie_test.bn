package "pkg/binate/link"

import "pkg/builtins/testing"

// Reading `.eh_frame` records (ehframe_cie.bn): a CIE's FDE encoding and an encoded pointer.

// A CIE's FDE encoding is its 'R' augmentation's — read past an LSDA encoding ('L') and a
// personality encoding and pointer ('P'), as a C++ CIE carries them — or absptr with no
// augmentation; an augmentation it cannot read past is an error.
func TestCieFdeEncoding() testing.TestResult {
	// version 1, "zR", code align 1, data align -8, return register 30, 1 byte of data: 0x1b
	var zr @[]uint8 = @[]uint8{16, 0, 0, 0, 0, 0, 0, 0, 1, 'z', 'R', 0, 1, 0x78, 0x1e, 1, 0x1b, 0, 0,
			0}
	enc, err := cieFdeEncoding(zr, 0, len(zr), 8)
	if len(err) != 0 || enc != 0x1b { return fail("zR: not pcrel sdata4") }
	// "zPLR": P = indirect pcrel sdata4 and its 4-byte pointer, L = 0x1b, R = udata4
	var zplr @[]uint8 = @[]uint8{24, 0, 0, 0, 0, 0, 0, 0, 1, 'z', 'P', 'L', 'R', 0, 1, 0x78, 0x1e, 7,
			0x9b, 0xaa, 0xbb, 0xcc, 0xdd, 0x1b, 0x03, 0, 0, 0}
	enc, err = cieFdeEncoding(zplr, 0, len(zplr), 8)
	if len(err) != 0 || enc != 0x03 { return fail("zPLR: not the R encoding") }
	var none @[]uint8 = @[]uint8{12, 0, 0, 0, 0, 0, 0, 0, 1, 0, 1, 0x78, 0x1e, 0, 0, 0}
	enc, err = cieFdeEncoding(none, 0, len(none), 8)
	if len(err) != 0 || enc != dwEhPeAbsptr { return fail("no augmentation: not absptr") }
	var bad @[]uint8 = @[]uint8{16, 0, 0, 0, 0, 0, 0, 0, 1, 'z', 'X', 0, 1, 0x78, 0x1e, 1, 0, 0, 0, 0}
	_, err = cieFdeEncoding(bad, 0, len(bad), 8)
	if len(err) == 0 { return fail("an unknown augmentation was read past") }
	var fde @[]uint8 = @[]uint8{8, 0, 0, 0, 4, 0, 0, 0, 0, 0, 0, 0}
	_, err = cieFdeEncoding(fde, 0, len(fde), 8)
	if len(err) == 0 { return fail("an FDE was read as a CIE") }
	return ""
}

// ehDecode reads each fixed-size format, sign-extending the sdata ones, adds the pointer's
// own address for pcrel, and keeps 32 bits for 4-byte pointers; an indirect, data-relative or
// LEB128 value is an error.
func TestEhDecode() testing.TestResult {
	var neg @[]uint8 = @[]uint8{0xf0, 0xff, 0xff, 0xff}
	v, err := ehDecode(neg, 0, 4, dwEhPePcrel | dwEhPeSdata4, 8, cast(uint64, 0x401000))
	if len(err) != 0 || v != cast(uint64, 0x400ff0) { return fail("pcrel sdata4") }
	v, err = ehDecode(neg, 0, 4, dwEhPePcrel | dwEhPeSdata4, 4, cast(uint64, 0x1000))
	if len(err) != 0 || v != cast(uint64, 0xff0) { return fail("pcrel sdata4, 4-byte pointers") }
	var abs @[]uint8 = @[]uint8{0x23, 0x01, 0x40, 0, 0, 0, 0, 0}
	v, err = ehDecode(abs, 0, 8, dwEhPeAbsptr, 8, cast(uint64, 0))
	if len(err) != 0 || v != cast(uint64, 0x400123) { return fail("absptr") }
	v, err = ehDecode(neg, 0, 2, dwEhPeSdata2, 8, cast(uint64, 0))
	if len(err) != 0 || v != ~cast(uint64, 0) - 15 { return fail("sdata2") }
	v, err = ehDecode(neg, 0, 2, dwEhPeUdata2, 8, cast(uint64, 0))
	if len(err) != 0 || v != cast(uint64, 0xfff0) { return fail("udata2") }
	_, err = ehDecode(neg, 0, 4, dwEhPeIndirect | dwEhPePcrel | dwEhPeSdata4, 8, cast(uint64, 0))
	if len(err) == 0 { return fail("an indirect value was read") }
	_, err = ehDecode(neg, 0, 4, dwEhPeDatarel | dwEhPeSdata4, 8, cast(uint64, 0))
	if len(err) == 0 { return fail("a data-relative value was read") }
	_, err = ehDecode(neg, 0, 4, 0x01, 8, cast(uint64, 0))
	if len(err) == 0 { return fail("a LEB128 value was read") }
	_, err = ehDecode(neg, 0, 2, dwEhPeSdata4, 8, cast(uint64, 0))
	if len(err) == 0 { return fail("a value past its record was read") }
	return ""
}

// A version-3 CIE (its return register a LEB128) and the 'S', 'B' and 'G' augmentations, which
// carry no data, are read past; a version other than 1 or 3, an aligned personality pointer and
// augmentation data past the length the CIE gives it are errors, as lld has them.
func TestCieFdeEncodingVariants() testing.TestResult {
	var v3 @[]uint8 = @[]uint8{20, 0, 0, 0, 0, 0, 0, 0, 3, 'z', 'S', 'B', 'G', 'R', 0, 1, 0x78, 0x1e,
			1, 0x1c, 0, 0, 0, 0}
	enc, err := cieFdeEncoding(v3, 0, len(v3), 8)
	if len(err) != 0 || enc != 0x1c { return fail("a version-3 zSBGR CIE") }
	var v4 @[]uint8 = @[]uint8{16, 0, 0, 0, 0, 0, 0, 0, 4, 'z', 'R', 0, 1, 0x78, 0x1e, 1, 0x1b, 0, 0,
			0}
	_, err = cieFdeEncoding(v4, 0, len(v4), 8)
	if len(err) == 0 { return fail("a version-4 CIE was read") }
	var aligned @[]uint8 = @[]uint8{24, 0, 0, 0, 0, 0, 0, 0, 1, 'z', 'P', 'R', 0, 1, 0x78, 0x1e, 10,
			0x50, 0, 0, 0, 0, 0, 0, 0, 0, 0x1b, 0}
	_, err = cieFdeEncoding(aligned, 0, len(aligned), 8)
	if len(err) == 0 { return fail("an aligned personality pointer was read past") }
	var short @[]uint8 = @[]uint8{16, 0, 0, 0, 0, 0, 0, 0, 1, 'z', 'R', 0, 1, 0x78, 0x1e, 0, 0x1b, 0,
			0, 0}
	_, err = cieFdeEncoding(short, 0, len(short), 8)
	if len(err) == 0 { return fail("an 'R' past the augmentation data was read") }
	return ""
}

// A 64-bit record and one running past its section are errors; a zero length is the terminator.
func TestEhRecordAt() testing.TestResult {
	var big @[]uint8 = @[]uint8{0xff, 0xff, 0xff, 0xff, 0, 0, 0, 0}
	_, _, err := ehRecordAt(big, 0, len(big))
	if len(err) == 0 { return fail("a 64-bit record was read") }
	var over @[]uint8 = @[]uint8{12, 0, 0, 0, 0, 0, 0, 0}
	_, _, err = ehRecordAt(over, 0, len(over))
	if len(err) == 0 { return fail("a record past its section was read") }
	var term @[]uint8 = @[]uint8{0, 0, 0, 0}
	n, _, terr := ehRecordAt(term, 0, len(term))
	if len(terr) != 0 || n != 0 { return fail("the terminator was not one") }
	return ""
}
