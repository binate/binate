package "pkg/binate/link"

import "pkg/binate/buf"

// `.eh_frame_hdr`, the binary-search table of a linked image's FDEs.  glibc's unwinder
// (libgcc's `_Unwind_Find_FDE`, through `dl_iterate_phdr`) finds an executable's FDEs only by
// its PT_GNU_EH_FRAME segment, which spans this section: an image carrying `.eh_frame` but no
// table is not unwound through.  As GNU ld and lld write it: a version (1); the encodings of
// the `.eh_frame` pointer (DW_EH_PE_pcrel | sdata4), of the FDE count (udata4) and of the
// table (DW_EH_PE_datarel | sdata4); the pointer to `.eh_frame`; the count; then, sorted by
// the address each FDE's code starts at, that address and the FDE's, both relative to the
// table's start.

// DWARF exception-handling pointer encodings (DW_EH_PE_*): the value's format in the low four
// bits, what it is relative to in the next three (pcrel: the encoded value's own address;
// datarel: here, the table's start), the top bit marking an indirect value.
const (
	dwEhPeAbsptr int = 0x00
	dwEhPeUdata2 int = 0x02
	dwEhPeUdata4 int = 0x03
	dwEhPeUdata8 int = 0x04
	dwEhPeSdata2 int = 0x0a
	dwEhPeSdata4 int = 0x0b
	dwEhPeSdata8 int = 0x0c
	dwEhPePcrel int = 0x10
	dwEhPeDatarel int = 0x30
	dwEhPeAligned int = 0x50
	dwEhPeIndirect int = 0x80
)

// ehFrameHdrSize is the size of `.eh_frame_hdr`'s fixed part: the version, the three
// encodings, the `.eh_frame` pointer and the FDE count.
const ehFrameHdrSize int = 12

// isEhFrame reports whether an input section named name holds unwind records (`.eh_frame`).
func isEhFrame(name *[]readonly char) bool { return charsEqual(name, ".eh_frame") }

// withEhFrameHdr returns objs with a linker-made `.eh_frame_hdr` object appended, and that
// object, when some object has a non-empty `.eh_frame` — else objs and no object — or an
// error for a record it cannot read.  The table has one entry per FDE, which fillEhFrameHdr
// writes once the link is laid out and relocated.  The object also holds the zero terminator
// that ends the output `.eh_frame` (where crtend.o's `__FRAME_END__` ends a C compiler's link,
// which bnld does not link): appended last, it lands after every input's records, and an
// unwinder that falls back to walking `.eh_frame` from its start — LLVM libunwind does, for a
// PC the table has no FDE for — stops there instead of reading past it.
func withEhFrameHdr(objs @[]@InputObject,
		machine int) (@[]@InputObject, @InputObject, @[]readonly char) {
	var none @InputObject
	n, any, err := countEhFrameFdes(objs)
	if len(err) != 0 { return objs, none, err }
	if !any { return objs, none, "" }
	var hdr @InputObject = make(InputObject)
	hdr.Path = buf.CopyStr("<linker-made .eh_frame_hdr>")
	hdr.Machine = machine
	hdr.Sections = make_slice(InputSection, 2)
	hdr.Sections[0] = mkDynSection(".eh_frame_hdr", SF_READ, 4,
			make_slice(uint8, ehFrameHdrSize + 8 * n))
	hdr.Sections[1] = mkDynSection(".eh_frame", SF_READ, 4, make_slice(uint8, 4))
	hdr.Symbols = make_slice(InputSymbol, 0)
	hdr.Relocs = make_slice(InputReloc, 0)
	return objectsWith(objs, hdr), hdr, ""
}

// countEhFrameFdes returns the number of FDEs in the `.eh_frame` sections of objs and whether
// any is non-empty, or an error naming the object for a record it cannot read.
func countEhFrameFdes(objs @[]@InputObject) (int, bool, @[]readonly char) {
	var n int = 0
	var any bool = false
	for o := 0; o < len(objs); o++ {
		for s := 0; s < len(objs[o].Sections); s++ {
			var sec InputSection = objs[o].Sections[s]
			if !isEhFrame(sec.Name) || sec.Size == 0 { continue }
			any = true
			// bnlint:allow managed-to-raw-assign - sec holds the section's bytes for the read
			var d *[]readonly uint8 = sec.Data
			var end int = cast(int, sec.Size)
			if end > len(d) { end = len(d) }
			var p int = 0
			for p < end {
				length, id, err := ehRecordAt(d, p, end)
				if len(err) != 0 { return 0, false, buf.Concat(buf.Concat(objs[o].Path, ": "), err) }
				if length == 0 { break }
				if id != 0 { n = n + 1 }
				p = p + 4 + length
			}
		}
	}
	return n, any, ""
}

// ehRecordAt returns the length (after the length field) and the CIE id or CIE pointer of the
// `.eh_frame` record at p in d, whose section ends at end: a length of 0 is a terminator, past
// which nothing is read.  A 64-bit record, or one running past end, is an error.
func ehRecordAt(d *[]readonly uint8, p int, end int) (int, int64, @[]readonly char) {
	if p + 4 > end { return 0, 0, "a truncated .eh_frame record" }
	var length int64 = u32(d, p)
	if length == 0 { return 0, 0, "" }
	if length == 0xffffffff { return 0, 0, "a 64-bit .eh_frame record, which bnld does not read" }
	if length < 4 || cast(int64, p) + 4 + length > cast(int64, end) {
		return 0, 0, "a malformed .eh_frame record"
	}
	return cast(int, length), u32(d, p + 4), ""
}

// fillEhFrameHdr writes hdr's `.eh_frame_hdr` (withEhFrameHdr) for objs as lr lays them out,
// relocated: its `.eh_frame` pointer is the first record's address (the lowest placed input's),
// and each FDE's code address is read from the relocated `.eh_frame`, by its CIE's encoding, a
// pointer being 4 bytes on ARM and 8 elsewhere.  Returns "" or an error: an
// encoding it cannot read, or an address too far from the table for its 32-bit entries.
func fillEhFrameHdr(objs @[]@InputObject, lr @LayoutResult, hdr @InputObject,
		machine int) @[]readonly char {
	var ptrSize int = 8
	if machine == EM_ARM { ptrSize = 4 }
	var hdrVa uint64 = secVaddr(hdr, lr, 0)
	hdrData, hdrOff := outData(hdr, lr, 0)
	var n int = (len(hdr.Sections[0].Data) - ehFrameHdrSize) / 8
	var locs @[]uint64 = make_slice(uint64, n)
	var fdes @[]uint64 = make_slice(uint64, n)
	var k int = 0
	var ehVa uint64 = 0
	var haveEh bool = false
	for o := 0; o < len(objs); o++ {
		var where @[]char = buf.Concat(objs[o].Path, ": ")
		for s := 0; s < len(objs[o].Sections); s++ {
			var sec InputSection = objs[o].Sections[s]
			if !isEhFrame(sec.Name) || sec.OutIndex < 0 { continue }
			var out OutputSection = lr.Sections[sec.OutIndex]
			var secVa uint64 = out.Addr + cast(uint64, sec.OutOffset)
			if sec.Size > 0 && (!haveEh || secVa < ehVa) {
				ehVa = secVa
				haveEh = true
			}
			// bnlint:allow managed-to-raw-assign - out holds the section's relocated bytes
			var d *[]readonly uint8 = out.Data
			var start int = cast(int, sec.OutOffset)
			var end int = start + cast(int, sec.Size)
			var p int = start
			for p < end {
				length, id, err := ehRecordAt(d, p, end)
				if len(err) != 0 { return buf.Concat(where, err) }
				if length == 0 { break }
				if id != 0 {
					var cie int64 = cast(int64, p + 4) - id
					if cie < cast(int64, start) || cie >= cast(int64, p) {
						return buf.Concat(where, "an FDE whose CIE is not before it in its .eh_frame")
					}
					enc, eerr := cieFdeEncoding(d, cast(int, cie), end, ptrSize)
					if len(eerr) != 0 { return buf.Concat(where, eerr) }
					var at uint64 = out.Addr + cast(uint64, p + 8)
					loc, lerr := ehDecode(d, p + 8, p + 4 + length, enc, ptrSize, at)
					if len(lerr) != 0 { return buf.Concat(where, lerr) }
					if k >= n { return "an .eh_frame gained an FDE after its table was sized" }
					locs[k] = loc
					fdes[k] = out.Addr + cast(uint64, p)
					k = k + 1
				}
				p = p + 4 + length
			}
		}
	}
	if k != n { return "an .eh_frame lost an FDE after its table was sized" }
	sortByKey(locs, fdes)
	hdrData[hdrOff] = 1
	hdrData[hdrOff + 1] = cast(uint8, dwEhPePcrel | dwEhPeSdata4)
	hdrData[hdrOff + 2] = cast(uint8, dwEhPeUdata4)
	hdrData[hdrOff + 3] = cast(uint8, dwEhPeDatarel | dwEhPeSdata4)
	var far @[]readonly char = "an address too far from .eh_frame_hdr for its 32-bit table"
	if !putRel32(hdrData, hdrOff + 4, ehVa, hdrVa + 4) { return far }
	writeU32(hdrData, hdrOff + 8, cast(int64, n))
	for i := 0; i < n; i++ {
		var e int = hdrOff + ehFrameHdrSize + 8 * i
		if !putRel32(hdrData, e, locs[i], hdrVa) || !putRel32(hdrData, e + 4, fdes[i], hdrVa) {
			return far
		}
	}
	return ""
}

// secSpan is where a part of a link's output lies for the program header that spans it (the
// `.eh_frame_hdr` table's PT_GNU_EH_FRAME, arm32's unwind index's PT_ARM_EXIDX): its output
// section's index (-1 for none), its offset in that section and its size.
type secSpan struct {
	Sec  int
	Off  uint64
	Size int
}

// noSpan is the secSpan of a part a link does not have.
func noSpan() secSpan {
	var e secSpan
	e.Sec = -1
	return e
}

// ehHdrSpanOf returns where hdr's table (withEhFrameHdr) lies once laid out, or noSpan for an
// absent hdr.
func ehHdrSpanOf(hdr @InputObject) secSpan {
	if !present(hdr) { return noSpan() }
	var e secSpan
	e.Sec = hdr.Sections[0].OutIndex
	e.Off = cast(uint64, hdr.Sections[0].OutOffset)
	e.Size = cast(int, hdr.Sections[0].Size)
	return e
}

// putRel32 writes target - from at off in d as a signed 32-bit word, reporting whether it
// fits one.
func putRel32(d @[]uint8, off int, target uint64, from uint64) bool {
	var diff int64 = bit_cast(int64, target - from)
	if diff < -0x80000000 || diff > 0x7fffffff { return false }
	writeU32(d, off, diff)
	return true
}
