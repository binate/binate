package "pkg/binate/link"

// ELF on-disk layout descriptor, so the object reader parses both classes through
// one structural path: arm32 objects are ELF32/REL (32-bit fields, relocations
// without an explicit addend word), while x86-64 and aarch64 objects are
// ELF64/RELA.  The two classes differ not only in field WIDTH but in field ORDER
// (Elf32_Sym is name/value/size/info/other/shndx; Elf64_Sym is
// name/info/other/shndx/value/size) and in relocation form, so a descriptor of
// byte offsets is cleaner than scattering `if is64` at every field access.

// elfFmt holds the byte offsets and entry sizes the reader needs for one ELF
// class.  Fields not consumed by the reader (e.g. sh_addr) are omitted.  A
// relocation's r_info is decoded by the reader directly off Is64 (its width and
// the sym/type split differ), so no r_info fields live here.
type elfFmt struct {
	Is64 bool
	// Minimum whole-header size (Elf32_Ehdr = 52 / Elf64_Ehdr = 64) and the
	// smallest valid section-header / symbol / relocation entry sizes.
	EhSize      int
	ShEntBase   int // Elf32_Shdr = 40 / Elf64_Shdr = 64
	SymEntBase  int // Elf32_Sym = 16 / Elf64_Sym = 24
	RelEntBase  int // Elf32_Rel = 8 / Elf64_Rel = 16
	RelaEntBase int // Elf32_Rela = 12 / Elf64_Rela = 24
	// ELF-header field offsets (e_type/e_machine/e_version share offsets across
	// classes; only these move).
	EShoff     int // e_shoff (32 / 40)
	EShentsize int // e_shentsize (46 / 58)
	EShnum     int // e_shnum (48 / 60)
	EShstrndx  int // e_shstrndx (50 / 62)
	// Section-header field offsets (sh_name/sh_type share offsets; sh_flags shares
	// its offset but widens to 8 bytes on ELF64 — the reader takes its low 32).
	ShFlags   int // sh_flags (8 / 8)
	ShOffset  int // sh_offset (16 / 24)
	ShSize    int // sh_size (20 / 32)
	ShLink    int // sh_link (24 / 40)
	ShInfo    int // sh_info (28 / 44)
	ShAlign   int // sh_addralign (32 / 48)
	ShEntsize int // sh_entsize (36 / 56)
	// Symbol field offsets (order differs between classes — see above).
	SymName  int // st_name (0 / 0)
	SymValue int // st_value (4 / 8)
	SymSize  int // st_size (8 / 16)
	SymInfo  int // st_info (12 / 4)
	SymShndx int // st_shndx (14 / 6)
	// Relocation field offset that moves: r_addend within a RELA entry (RELA
	// only; a REL entry has none).  r_offset is at 0 and r_info at 4/8 in both.
	RInfoOff   int // r_info (4 / 8)
	RAddendOff int // r_addend within a RELA entry (8 / 16)
}

// elfFmtFor returns the layout descriptor for the given EI_CLASS byte.  A single
// local is filled and returned once (a by-value struct returned from more than one
// site trips a BUILDER codegen bug).  The caller has already validated class is
// ELFCLASS32 or ELFCLASS64; an unrecognized class yields the ELF64 layout, which
// the caller's class check rejects before this is reached.
func elfFmtFor(class uint8) elfFmt {
	var f elfFmt
	if class == ELFCLASS32 {
		f.Is64 = false
		f.EhSize = 52
		f.ShEntBase = 40
		f.SymEntBase = 16
		f.RelEntBase = 8
		f.RelaEntBase = 12
		f.EShoff = 32
		f.EShentsize = 46
		f.EShnum = 48
		f.EShstrndx = 50
		f.ShFlags = 8
		f.ShOffset = 16
		f.ShSize = 20
		f.ShLink = 24
		f.ShInfo = 28
		f.ShAlign = 32
		f.ShEntsize = 36
		f.SymName = 0
		f.SymValue = 4
		f.SymSize = 8
		f.SymInfo = 12
		f.SymShndx = 14
		f.RInfoOff = 4
		f.RAddendOff = 8
	} else {
		f.Is64 = true
		f.EhSize = 64
		f.ShEntBase = 64
		f.SymEntBase = 24
		f.RelEntBase = 16
		f.RelaEntBase = 24
		f.EShoff = 40
		f.EShentsize = 58
		f.EShnum = 60
		f.EShstrndx = 62
		f.ShFlags = 8
		f.ShOffset = 24
		f.ShSize = 32
		f.ShLink = 40
		f.ShInfo = 44
		f.ShAlign = 48
		f.ShEntsize = 56
		f.SymName = 0
		f.SymValue = 8
		f.SymSize = 16
		f.SymInfo = 4
		f.SymShndx = 6
		f.RInfoOff = 8
		f.RAddendOff = 16
	}
	return f
}
