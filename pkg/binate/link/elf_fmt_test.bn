package "pkg/binate/link"

import "pkg/builtins/testing"

// (fail is in parse_elf_test.bn — same package.)

// The ELF64 descriptor must carry the Elf64 layout: 64-byte header, 64-byte
// section headers, 24-byte symbols laid out name/info/other/shndx/value/size, and
// 8-byte-wide relocation r_info/r_addend.
func TestElfFmt64() testing.TestResult {
	var f elfFmt = elfFmtFor(ELFCLASS64)
	if !f.Is64 { return fail("ELFCLASS64 should be 64-bit") }
	if f.EhSize != 64 { return fail("Elf64 header is 64 bytes") }
	if f.ShEntBase != 64 { return fail("Elf64_Shdr is 64 bytes") }
	if f.SymEntBase != 24 { return fail("Elf64_Sym is 24 bytes") }
	if f.RelEntBase != 16 || f.RelaEntBase != 24 { return fail("Elf64 Rel/Rela sizes wrong") }
	if f.EShoff != 40 { return fail("Elf64 e_shoff is at 40") }
	if f.ShOffset != 24 || f.ShSize != 32 || f.ShEntsize != 56 {
		return fail("Elf64_Shdr offsets wrong")
	}
	// Elf64_Sym: name(0), info(4), other(5), shndx(6), value(8), size(16).
	if f.SymValue != 8 || f.SymSize != 16 || f.SymInfo != 4 || f.SymShndx != 6 {
		return fail("Elf64_Sym field offsets wrong")
	}
	if f.RInfoOff != 8 || f.RAddendOff != 16 { return fail("Elf64_Rela field offsets wrong") }
	return ""
}

// The ELF32 descriptor must carry the Elf32 layout — crucially with the symbol
// fields in a DIFFERENT order (name/value/size/info/other/shndx) than Elf64, the
// trap that a width-only conversion would miss.
func TestElfFmt32() testing.TestResult {
	var f elfFmt = elfFmtFor(ELFCLASS32)
	if f.Is64 { return fail("ELFCLASS32 should be 32-bit") }
	if f.EhSize != 52 { return fail("Elf32 header is 52 bytes") }
	if f.ShEntBase != 40 { return fail("Elf32_Shdr is 40 bytes") }
	if f.SymEntBase != 16 { return fail("Elf32_Sym is 16 bytes") }
	if f.RelEntBase != 8 || f.RelaEntBase != 12 { return fail("Elf32 Rel/Rela sizes wrong") }
	if f.EShoff != 32 || f.EShentsize != 46 || f.EShnum != 48 || f.EShstrndx != 50 {
		return fail("Elf32 header field offsets wrong")
	}
	if f.ShOffset != 16 || f.ShSize != 20 || f.ShEntsize != 36 || f.ShAlign != 32 {
		return fail("Elf32_Shdr offsets wrong")
	}
	// Elf32_Sym: name(0), value(4), size(8), info(12), other(13), shndx(14).
	if f.SymValue != 4 || f.SymSize != 8 || f.SymInfo != 12 || f.SymShndx != 14 {
		return fail("Elf32_Sym field offsets wrong (order differs from Elf64)")
	}
	if f.RInfoOff != 4 { return fail("Elf32_Rel r_info is at 4") }
	return ""
}
