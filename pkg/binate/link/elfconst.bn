package "pkg/binate/link"

// ELF format constants used by the object-file reader (parse_elf.bn).  Declared
// locally rather than imported from pkg/binate/asm/elf, whose format constants
// are package-private to the writer (only the EM_* machine constants are
// exported there).  More constants are added here as the reader grows to cover
// symbols and relocations.

// ELFCLASS64 is the EI_CLASS byte marking a 64-bit ELF object.
const ELFCLASS64 uint8 = 2

// ELFDATA2LSB is the EI_DATA byte marking little-endian encoding.
const ELFDATA2LSB uint8 = 1

// ET_EXEC marks an ELF file as an executable.
const ET_EXEC int = 2

// PT_LOAD marks a loadable program-header segment.
const PT_LOAD int = 1

// PF_X / PF_W / PF_R are the program-header segment permission flags.
const PF_X int = 1

// PF_W marks a segment writable.
const PF_W int = 2

// PF_R marks a segment readable.
const PF_R int = 4

// SHT_PROGBITS marks a section holding program-defined data (text/rodata/data).
const SHT_PROGBITS int = 1

// SHT_SYMTAB marks the symbol-table section.
const SHT_SYMTAB int = 2

// SHT_RELA marks a relocation-table section with explicit addends.
const SHT_RELA int = 4

// SHT_NOBITS marks a zero-fill section occupying no file bytes (.bss).
const SHT_NOBITS int = 8

// SHN_UNDEF is the section index of an undefined (external) symbol.
const SHN_UNDEF int = 0

// SHF_WRITE marks a section writable at runtime.
const SHF_WRITE int = 1

// SHF_ALLOC marks a section that occupies memory at runtime.
const SHF_ALLOC int = 2

// SHF_EXECINSTR marks a section containing executable instructions.
const SHF_EXECINSTR int = 4

// Symbol bindings, as stored in InputSymbol.Binding (ELF st_info >> 4).
const BIND_GLOBAL int = 1

// BIND_WEAK marks a weak symbol: a weak definition is overridden by a strong one,
// and a weak undefined reference resolves to address 0 rather than erroring.
const BIND_WEAK int = 2

// x86-64 relocation types (the low 32 bits of Elf64_Rela r_info), as stored in
// InputReloc.Kind.

// R_X86_64_64 is a 64-bit absolute relocation: S + A.
const R_X86_64_64 int = 1

// R_X86_64_PC32 is a 32-bit PC-relative relocation: S + A - P.
const R_X86_64_PC32 int = 2

// R_X86_64_PLT32 is a 32-bit PC-relative call via the PLT; for a statically-linked
// defined symbol it is patched identically to PC32 (S + A - P).
const R_X86_64_PLT32 int = 4

// R_X86_64_GOTPCRELX / R_X86_64_REX_GOTPCRELX are relaxable GOT-indirect loads of a
// symbol's address (`mov sym@GOTPCREL(%rip), %reg`; REX_ is the 64-bit-register form
// with a REX prefix).  In a static link the symbol is defined, so the load is relaxed
// to a direct `lea sym(%rip), %reg` — no GOT needed.  (The LLVM/clang backend emits
// these; the native backend uses REX_GOTPCRELX for __c_global too.)
const R_X86_64_GOTPCRELX int = 41

// (see R_X86_64_GOTPCRELX above for the relaxation)
const R_X86_64_REX_GOTPCRELX int = 42

// AArch64 relocation types (the low 32 bits of Elf64_Rela r_info), as stored in
// InputReloc.Kind.  These patch bit-fields of the 32-bit instruction word (except
// ABS64, which is a 64-bit data word).

// R_AARCH64_ABS64 is a 64-bit absolute data relocation: S + A.
const R_AARCH64_ABS64 int = 257

// R_AARCH64_ADR_PREL_LO21 patches an ADR's imm21 with the PC-relative byte offset.
const R_AARCH64_ADR_PREL_LO21 int = 274

// R_AARCH64_ADR_PREL_PG_HI21 patches an ADRP's imm21 with the page-relative offset
// (page(S+A) - page(P)) >> 12.
const R_AARCH64_ADR_PREL_PG_HI21 int = 275

// R_AARCH64_ADD_ABS_LO12_NC patches an ADD's imm12 with the low 12 bits of S+A.
const R_AARCH64_ADD_ABS_LO12_NC int = 277

// R_AARCH64_TSTBR14 patches a TBZ/TBNZ's imm14 with the PC-relative branch offset.
const R_AARCH64_TSTBR14 int = 279

// R_AARCH64_CONDBR19 patches a B.cond/CBZ/CBNZ's imm19 with the branch offset.
const R_AARCH64_CONDBR19 int = 280

// R_AARCH64_JUMP26 patches an unconditional B's imm26 with the branch offset.
const R_AARCH64_JUMP26 int = 282

// R_AARCH64_CALL26 patches a BL's imm26 with the branch offset.
const R_AARCH64_CALL26 int = 283

// R_AARCH64_LDST64_ABS_LO12_NC patches a 64-bit LDR/STR's scaled imm12 with the
// low 12 bits of S+A (scaled by 8).
const R_AARCH64_LDST64_ABS_LO12_NC int = 286

// R_AARCH64_ADR_GOT_PAGE / R_AARCH64_LD64_GOT_LO12_NC are GOT-indirect (external C
// data); not supported in a hermetic link.
const R_AARCH64_ADR_GOT_PAGE int = 311

// R_AARCH64_LD64_GOT_LO12_NC is the LDR half of a GOT-indirect access.
const R_AARCH64_LD64_GOT_LO12_NC int = 312
