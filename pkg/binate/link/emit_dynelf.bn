package "pkg/binate/link"

// Dynamic ELF executable writer.  It is EmitElfExec plus the two program headers a
// dynamically-linked ET_EXEC needs: PT_INTERP (naming the dynamic linker, e.g.
// /lib/ld-linux-aarch64.so.1) and PT_DYNAMIC (pointing at the .dynamic array the
// loader walks).  The .interp and .dynamic sections themselves are ordinary content
// sections merged by Layout (into the read-only and read-write groups respectively);
// the caller passes their final addresses/sizes so the two extra headers can name
// them.  Everything else — the two W^X PT_LOADs, the header-in-the-lowest-segment
// trick, offset/vaddr page congruence — matches EmitElfExec.
//
// The dynamic-linking machinery (.hash/.dynsym/.dynstr/.rela.plt/.plt/.got.plt and
// the .dynamic contents) is synthesized in dynlink.bn; this file only lays out and
// writes bytes.

// writeDynPhdr writes one Elf64_Phdr of the given p_type at file offset phi.
func writeDynPhdr(out @[]uint8, phi int, ptype int, flags int, off int, vaddr uint64, filesz int,
		memsz int, align int) {
	writeLE(out, phi + 0, ptype, 4)
	writeLE(out, phi + 4, flags, 4)
	writeLE(out, phi + 8, off, 8)
	writeU64(out, phi + 16, vaddr)
	writeU64(out, phi + 24, vaddr) // p_paddr == p_vaddr
	writeLE(out, phi + 32, filesz, 8)
	writeLE(out, phi + 40, memsz, 8)
	writeLE(out, phi + 48, align, 8)
}

// EmitDynElfExec writes a dynamically-linked ET_EXEC for the laid-out sections,
// entering at `entry`.  interpVaddr/interpSize and dynamicVaddr/dynamicSize name the
// .interp and .dynamic sections (already merged into the output groups by Layout) for
// the PT_INTERP / PT_DYNAMIC headers.  Returns "" on success or a non-empty error.
func EmitDynElfExec(sections @[]OutputSection, entry uint64, machine int, interpVaddr uint64,
		interpSize int, dynamicVaddr uint64, dynamicSize int, path *[]readonly char) @[]readonly char {
	if len(sections) == 0 { return "no sections to emit" }
	var pagesize int = linkPageSize
	var ehsize int = 64
	var phentsize int = 56

	roFound, _, roFileEnd, roMemEnd, roPerms := groupStats(sections, false)
	rwFound, rwLo, rwFileEnd, rwMemEnd, rwPerms := groupStats(sections, true)
	// A dynamic executable always has both groups (.dynamic/.got.plt are writable, the
	// code/.interp/.dynsym read-only), plus PT_INTERP and PT_DYNAMIC.
	var phnum int = 2 // PT_INTERP + PT_DYNAMIC
	if roFound { phnum = phnum + 1 }
	if rwFound { phnum = phnum + 1 }
	var hend int = ehsize + phnum * phentsize

	var base uint64 = sections[0].Addr
	var dataStart int = alignUp(hend, pagesize) + cast(int, base % cast(uint64, pagesize))
	if base < cast(uint64, dataStart) { return "load base too low to hold the ELF headers" }

	var memEnd uint64 = base
	if roFound && roMemEnd > memEnd { memEnd = roMemEnd }
	if rwFound && rwMemEnd > memEnd { memEnd = rwMemEnd }
	var fileEnd uint64 = base
	if roFound && roFileEnd > fileEnd { fileEnd = roFileEnd }
	if rwFound && rwFileEnd > fileEnd { fileEnd = rwFileEnd }
	for i := 0; i < len(sections); i++ {
		if sections[i].Addr < base { return "a section address is below the load base" }
	}
	if entry < base || entry >= memEnd { return "entry point is outside the loaded image" }

	var totalFile int = dataStart + cast(int, fileEnd - base)
	var out @[]uint8 = make_slice(uint8, totalFile)

	// ELF header (ET_EXEC, dynamic — the PT_INTERP/PT_DYNAMIC headers below make it
	// dynamically linked).
	out[0] = 0x7f
	out[1] = 0x45
	out[2] = 0x4c
	out[3] = 0x46
	out[4] = ELFCLASS64
	out[5] = ELFDATA2LSB
	out[6] = 1 // EV_CURRENT
	writeLE(out, 16, ET_EXEC, 2)
	writeLE(out, 18, machine, 2)
	writeLE(out, 20, 1, 4)
	writeU64(out, 24, entry)
	writeLE(out, 32, ehsize, 8) // e_phoff
	writeLE(out, 52, ehsize, 2) // e_ehsize
	writeLE(out, 54, phentsize, 2)
	writeLE(out, 56, phnum, 2)

	// The lowest group maps file offset 0 (so it covers the ELF header + program
	// headers), at vaddr base - dataStart; the writable group maps at its own address.
	var segVaddr uint64 = base - cast(uint64, dataStart)
	var interpFileOff int = dataStart + cast(int, interpVaddr - base)
	var dynamicFileOff int = dataStart + cast(int, dynamicVaddr - base)
	var phi int = ehsize

	// PT_INTERP first (its file range lies within the read-only PT_LOAD below).
	writeDynPhdr(out, phi, PT_INTERP, PF_R, interpFileOff, interpVaddr, interpSize, interpSize, 1)
	phi = phi + phentsize

	if roFound {
		writeDynPhdr(out, phi, PT_LOAD, roPerms, 0, segVaddr, dataStart + cast(int, roFileEnd - base),
				dataStart + cast(int, roMemEnd - base), pagesize)
		phi = phi + phentsize
	}
	if rwFound {
		var rwOff int = dataStart + cast(int, rwLo - base)
		if !roFound { rwOff = 0 }
		var rwVaddr uint64 = rwLo
		if !roFound { rwVaddr = segVaddr }
		var rwFilesz int = cast(int, rwFileEnd - rwLo)
		var rwMemsz int = cast(int, rwMemEnd - rwLo)
		if !roFound {
			rwFilesz = dataStart + cast(int, rwFileEnd - base)
			rwMemsz = dataStart + cast(int, rwMemEnd - base)
		}
		writeDynPhdr(out, phi, PT_LOAD, rwPerms, rwOff, rwVaddr, rwFilesz, rwMemsz, pagesize)
		phi = phi + phentsize
	}

	// PT_DYNAMIC last.
	writeDynPhdr(out, phi, PT_DYNAMIC, PF_R | PF_W, dynamicFileOff, dynamicVaddr, dynamicSize,
			dynamicSize, 8)

	// Section data at dataStart + (Addr - base).
	for i := 0; i < len(sections); i++ {
		var d @[]uint8 = sections[i].Data
		if len(d) == 0 { continue }
		var fo int = dataStart + cast(int, sections[i].Addr - base)
		for j := 0; j < len(d); j++ { out[fo + j] = d[j] }
	}

	return writeFile(path, out)
}
