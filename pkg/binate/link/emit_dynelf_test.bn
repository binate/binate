package "pkg/binate/link"

import "pkg/builtins/testing"

// EmitDynElfExec must emit an ET_EXEC with PT_INTERP and PT_DYNAMIC naming the
// caller-supplied .interp / .dynamic addresses, plus the two W^X PT_LOADs.  (A
// full run-proof is the end-to-end LinkDynElf test + the Docker e2e; this pins the
// header structure host-independently.)  mkOutSec is in emit_elf_test.bn.
func TestEmitDynElfHeaders() testing.TestResult {
	var ro @[]uint8 = make_slice(uint8, 32) // stands in for .interp + code
	var rw @[]uint8 = make_slice(uint8, 32) // stands in for .dynamic + data
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	secs[0] = mkOutSec(".rodata", SF_READ | SF_EXEC, cast(uint, 0x400000), ro, cast(uint, 32))
	secs[1] = mkOutSec(".data", SF_READ | SF_WRITE, cast(uint, 0x401000), rw, cast(uint, 32))
	var interpVa uint64 = cast(uint64, 0x400000)
	var dynVa uint64 = cast(uint64, 0x401000)
	var err @[]readonly char = EmitDynElfExec(secs, cast(uint64, 0x400000), EM_AARCH64, interpVa, 8,
			dynVa, 16, "/tmp/binate_dynelf_emit")
	if len(err) != 0 { return fail("EmitDynElfExec failed") }

	data, ok := readFile("/tmp/binate_dynelf_emit")
	if !ok { return fail("cannot read the emitted executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	if u16(rd, 16) != ET_EXEC { return fail("not ET_EXEC") }
	var phoff int = cast(int, u64(rd, 32))
	var phentsize int = u16(rd, 54)
	var phnum int = u16(rd, 56)
	var nLoad int = 0
	var interpOk bool = false
	var dynamicOk bool = false
	for i := 0; i < phnum; i++ {
		var p int = phoff + i * phentsize
		var ptype int = cast(int, u32(rd, p))
		var pvaddr int = cast(int, u64(rd, p + 16))
		if ptype == PT_LOAD { nLoad = nLoad + 1 }
		if ptype == PT_INTERP && pvaddr == cast(int, interpVa) { interpOk = true }
		if ptype == PT_DYNAMIC && pvaddr == cast(int, dynVa) { dynamicOk = true }
	}
	if nLoad != 2 { return fail("expected two PT_LOAD segments") }
	if !interpOk { return fail("PT_INTERP missing or points at the wrong address") }
	if !dynamicOk { return fail("PT_DYNAMIC missing or points at the wrong address") }
	return ""
}
