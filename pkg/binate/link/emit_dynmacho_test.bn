package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// (machoLcOffset / bytesAtEqual live in dynmacho_test.bn — same package; the
// end-to-end assemble→link path is TestLinkDynMachoExit there.  These pin the writer
// directly, on hand-built OutputSections: a read-only/exec __text group + a writable
// __got group, which the writer maps to __TEXT / __DATA.)

// mkTextOutSection builds a read-only/exec output section of `size` bytes at `addr`.
func mkTextOutSection(addr uint, size int) OutputSection {
	var os OutputSection
	os.Name = buf.CopyStr("__text")
	os.Flags = SF_READ | SF_EXEC
	os.Align = 4
	os.Addr = addr
	os.Data = make_slice(uint8, size)
	os.Size = cast(uint, size)
	return os
}

// mkGotOutSection builds a writable output section of `slots` 8-byte GOT entries at
// `addr` (zero-filled — the writer maps it to __DATA for dyld to bind).
func mkGotOutSection(addr uint, slots int) OutputSection {
	var os OutputSection
	os.Name = buf.CopyStr("__got")
	os.Flags = SF_READ | SF_WRITE
	os.Align = 8
	os.Addr = addr
	os.Data = make_slice(uint8, slots * 8)
	os.Size = cast(uint, slots * 8)
	return os
}

// mkBssOutSection builds a writable .bss-style output section of `size` bytes at `addr`
// with NO file data (empty Data, Size set) — the writer must reserve it in __DATA's
// vmsize (dyld zero-fills it) without reserving any file bytes.
func mkBssOutSection(addr uint, size int) OutputSection {
	var os OutputSection
	os.Name = buf.CopyStr("__bss")
	os.Flags = SF_READ | SF_WRITE
	os.Align = 8
	os.Addr = addr
	os.Data = make_slice(uint8, 0)
	os.Size = cast(uint, size)
	return os
}

// EmitDynMachoExec turns a __text group + a __got group + one import into a
// structurally valid, ad-hoc-signed dynamic Mach-O: 64-bit magic, MH_EXECUTE, the
// dynamic load commands (LC_DYLD_INFO_ONLY, LC_MAIN, LC_LOAD_DYLINKER, LC_LOAD_DYLIB
// naming libSystem) and an LC_CODE_SIGNATURE.
func TestEmitDynMachoExecMinimal() testing.TestResult {
	var base uint = cast(uint, 0x100004000)
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	secs[0] = mkTextOutSection(base, 12)
	secs[1] = mkGotOutSection(cast(uint, 0x100008000), 1) // one page above, one slot
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = buf.CopyStr("_exit")
	var bindOps @[]uint8 = buildMachoBind(imports, 2, 0, globalBinds(len(imports)))
	symtab, strtab := buildMachoSymtab(imports, globalBinds(len(imports)))

	var err @[]readonly char = EmitDynMachoExec(secs, base, EM_AARCH64, bindOps, symtab, 1, strtab,
			"t", "/tmp/binate_emit_dynmacho")
	if len(err) != 0 { return fail(buf.Concat("EmitDynMachoExec failed: ", err)) }

	data, ok := readFile("/tmp/binate_emit_dynmacho")
	if !ok { return fail("cannot read the emitted executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	if u32(rd, 0) != 0xfeedfacf { return fail("not a 64-bit Mach-O") }
	if u32(rd, 12) != MACHO_MH_EXECUTE { return fail("not MH_EXECUTE") }
	if machoLcOffset(rd, MACHO_LC_MAIN) < 0 { return fail("no LC_MAIN") }
	if machoLcOffset(rd, MACHO_LC_DYLD_INFO_ONLY) < 0 { return fail("no LC_DYLD_INFO_ONLY") }
	if machoLcOffset(rd, MACHO_LC_LOAD_DYLINKER) < 0 { return fail("no LC_LOAD_DYLINKER") }
	if machoLcOffset(rd, MACHO_LC_CODE_SIGNATURE) < 0 { return fail("no LC_CODE_SIGNATURE") }
	var dylib int = machoLcOffset(rd, MACHO_LC_LOAD_DYLIB)
	if dylib < 0 || !bytesAtEqual(rd, dylib + 24, "/usr/lib/libSystem.B.dylib") {
		return fail("LC_LOAD_DYLIB should name libSystem")
	}
	var lcMain int = machoLcOffset(rd, MACHO_LC_MAIN)
	if u64(rd, lcMain + 8) == 0 { return fail("LC_MAIN entryoff should be non-zero") }
	return ""
}

// machoDataSegVmsize returns the __DATA segment's vmsize (or -1 if absent).
func machoDataSegVmsize(rd *[]readonly uint8) int {
	var ncmds int = u32(rd, 16)
	var off int = 32
	for i := 0; i < ncmds; i++ {
		if u32(rd, off) == MACHO_LC_SEGMENT_64 && bytesAtEqual(rd, off + 8, "__DATA") {
			return u64(rd, off + 32) // segment_command_64.vmsize
		}
		off = off + u32(rd, off + 4)
	}
	return -1
}

// The __got (the writable group) is sized by the number of slots, not capped at one
// page: 2049 slots (2049*8 = 16392 B > 16 KB) make __DATA span two pages.
func TestEmitDynMachoExecManyImports() testing.TestResult {
	var base uint = cast(uint, 0x100004000)
	var n int = 2049
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	secs[0] = mkTextOutSection(base, 12)
	secs[1] = mkGotOutSection(cast(uint, 0x100008000), n)
	var imports @[]@[]char = make_slice(@[]char, n)
	for i := 0; i < n; i++ { imports[i] = buf.CopyStr("_f") } // names need not be distinct here
	var bindOps @[]uint8 = buildMachoBind(imports, 2, 0, globalBinds(len(imports)))
	symtab, strtab := buildMachoSymtab(imports, globalBinds(len(imports)))
	var err @[]readonly char = EmitDynMachoExec(secs, base, EM_AARCH64, bindOps, symtab, n, strtab,
			"t", "/tmp/binate_emit_dynmacho_many")
	if len(err) != 0 { return fail(buf.Concat("EmitDynMachoExec failed: ", err)) }
	data, ok := readFile("/tmp/binate_emit_dynmacho_many")
	if !ok { return fail("cannot read the emitted executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	if machoDataSegVmsize(rd) != 0x8000 {
		return fail("__DATA should span two pages for 2049 GOT slots")
	}
	return ""
}

// EmitDynMachoExec is arm64-only and rejects any other machine.
func TestEmitDynMachoExecRejectsNonArm64() testing.TestResult {
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	secs[0] = mkTextOutSection(cast(uint, 0x100004000), 12)
	secs[1] = mkGotOutSection(cast(uint, 0x100008000), 1)
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = buf.CopyStr("_exit")
	var bindOps @[]uint8 = buildMachoBind(imports, 2, 0, globalBinds(len(imports)))
	symtab, strtab := buildMachoSymtab(imports, globalBinds(len(imports)))
	var err @[]readonly char = EmitDynMachoExec(secs, cast(uint, 0x100004000), EM_X86_64, bindOps,
			symtab, 1, strtab, "t", "/tmp/binate_emit_dynmacho_x")
	if len(err) == 0 { return fail("a non-arm64 machine should be rejected") }
	return ""
}

// A large .bss (a writable section with no file bytes) must NOT bloat the output file:
// the __LINKEDIT file offset follows only __DATA's file-backed bytes, while __DATA's
// vmsize still covers the .bss for dyld to zero-fill.  A 1 MB .bss leaves the file
// small AND keeps __DATA's vmsize >= 1 MB.
func TestEmitDynMachoExecLargeBss() testing.TestResult {
	var base uint = cast(uint, 0x100004000)
	var secs @[]OutputSection = make_slice(OutputSection, 3)
	secs[0] = mkTextOutSection(base, 12)
	secs[1] = mkGotOutSection(cast(uint, 0x100008000), 1) // __got (file-backed)
	secs[2] = mkBssOutSection(cast(uint, 0x100008008), 1048576) // 1 MB .bss (no file bytes)
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = buf.CopyStr("_exit")
	var bindOps @[]uint8 = buildMachoBind(imports, 2, 0, globalBinds(len(imports)))
	symtab, strtab := buildMachoSymtab(imports, globalBinds(len(imports)))
	var err @[]readonly char = EmitDynMachoExec(secs, base, EM_AARCH64, bindOps, symtab, 1, strtab,
			"t", "/tmp/binate_emit_dynmacho_bss")
	if len(err) != 0 { return fail(buf.Concat("EmitDynMachoExec failed: ", err)) }
	data, ok := readFile("/tmp/binate_emit_dynmacho_bss")
	if !ok { return fail("cannot read the emitted executable") }
	if len(data) > 0x20000 {
		return fail("a 1 MB .bss must not bloat the file (NOBITS not honored)")
	}
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	if machoDataSegVmsize(rd) < 1048576 { return fail("__DATA vmsize should cover the 1 MB .bss") }
	return ""
}
