package "pkg/binate/link"

import "pkg/std/os"

// segFlags maps normalized SF_* section flags to ELF PF_* segment flags.
func segFlags(flags int) int {
	var f int = 0
	if (flags & SF_READ) != 0 { f = f | PF_R }
	if (flags & SF_WRITE) != 0 { f = f | PF_W }
	if (flags & SF_EXEC) != 0 { f = f | PF_X }
	return f
}

// writeFile writes data to path, creating it mode 0o755 so the output is
// owner-executable (umask permitting) without a separate chmod — the stdlib has
// no os.Chmod, and a linker always creates its output fresh, so create-executable
// is the right seam.
func writeFile(path *[]readonly char, data @[]uint8) @[]readonly char {
	// Unlink first, then create a fresh inode: O_CREATE's mode is ignored for an
	// existing file (so re-linking would keep a stale non-exec mode), and unlinking
	// avoids ETXTBSY when re-linking over a still-running previous build.  A missing
	// path makes Remove fail harmlessly.
	_ = os.Remove(path)
	f, cerr := os.OpenFile(path, os.O_RDWR | os.O_CREATE | os.O_TRUNC, cast(os.FileMode, 0o755))
	if present(cerr) { return "cannot create output file" }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var raw *[]readonly uint8 = data
	n, werr := f.Write(raw)
	closeErr := f.Close()
	if present(werr) || n < len(data) || present(closeErr) {
		_ = os.Remove(path) // do not leave a truncated/corrupt executable behind
		return "failed to write output file"
	}
	return ""
}

// groupStats scans the output sections whose writability matches `writable` and
// returns (found, lo, fileEnd, memEnd, perms): whether any matched, the group's
// lowest vaddr, its file-backed end (max Addr + len(Data)), its memory end (max
// Addr + Size, so .bss counts), and the union of its PF_* permissions.  A group
// with no file data (e.g. only .bss) reports fileEnd == lo (zero file span).
func groupStats(sections @[]OutputSection, writable bool) (bool, uint64, uint64, uint64, int) {
	var found bool = false
	var hasData bool = false
	var lo uint64 = cast(uint64, 0)
	var fileEnd uint64 = cast(uint64, 0)
	var memEnd uint64 = cast(uint64, 0)
	var perms int = 0
	for i := 0; i < len(sections); i++ {
		if ((sections[i].Flags & SF_WRITE) != 0) != writable { continue }
		var a uint64 = sections[i].Addr
		if !found || a < lo { lo = a }
		var me uint64 = a + sections[i].Size
		if !found || me > memEnd { memEnd = me }
		if len(sections[i].Data) > 0 {
			var fe uint64 = a + cast(uint64, len(sections[i].Data))
			if !hasData || fe > fileEnd { fileEnd = fe }
			hasData = true
		}
		perms = perms | segFlags(sections[i].Flags)
		found = true
	}
	if !hasData { fileEnd = lo }
	return found, lo, fileEnd, memEnd, perms
}

// writePhdr writes one Elf64_Phdr (PT_LOAD) at file offset phi, with p_paddr set
// equal to p_vaddr.
func writePhdr(out @[]uint8, phi int, flags int, off int, vaddr uint64, filesz int, memsz int,
		align int) {
	writeLE(out, phi + 0, PT_LOAD, 4) // p_type
	writeLE(out, phi + 4, flags, 4) // p_flags
	writeLE(out, phi + 8, off, 8) // p_offset
	writeU64(out, phi + 16, vaddr) // p_vaddr
	writeU64(out, phi + 24, vaddr) // p_paddr
	writeLE(out, phi + 32, filesz, 8) // p_filesz
	writeLE(out, phi + 40, memsz, 8) // p_memsz
	writeLE(out, phi + 48, align, 8) // p_align
}

// EmitElfExec writes a static ELF64 executable for the laid-out output sections
// (from Layout), entering at `entry`.  Sections are mapped by two PT_LOADs — a
// read-only/exec segment (.text/.rodata) and a read-write segment (.data/.bss) —
// so no segment is both writable and executable (W^X).  Layout page-aligns the
// writable group away from the read-only one, so the two segments never share a
// page.  The lowest segment starts at file offset 0 so it maps the ELF header and
// the program headers — a runtime that reads AT_PHDR (TLS setup, static-PIE
// self-relocation, a libc _start) would otherwise dereference an unmapped address.
// A program with only one group emits one segment.  Section file offsets keep
// p_offset congruent to p_vaddr modulo the page size, so segments are loadable
// even for a non-page-aligned base.  Returns "" on success or a non-empty error.
func EmitElfExec(sections @[]OutputSection, entry uint64, machine int,
		path *[]readonly char) @[]readonly char {
	if len(sections) == 0 { return "no sections to emit" }
	var pagesize int = linkPageSize
	var ehsize int = 64
	var phentsize int = 56

	roFound, _, roFileEnd, roMemEnd, roPerms := groupStats(sections, false)
	rwFound, rwLo, rwFileEnd, rwMemEnd, rwPerms := groupStats(sections, true)
	var phnum int = 0
	if roFound { phnum = phnum + 1 }
	if rwFound { phnum = phnum + 1 }
	var hend int = ehsize + phnum * phentsize

	// The load base is the first (lowest-address) section — Layout assigns
	// addresses in ascending load order.  Data starts at the first page-boundary
	// offset that is congruent to base modulo the page size (loadability).
	var base uint64 = sections[0].Addr
	var dataStart int = alignUp(hend, pagesize) + cast(int, base % cast(uint64, pagesize))
	if base < cast(uint64, dataStart) { return "load base too low to hold the ELF headers" }

	// Overall memory/file ends and the below-base guard.
	var memEnd uint64 = base
	if roFound && roMemEnd > memEnd { memEnd = roMemEnd }
	if rwFound && rwMemEnd > memEnd { memEnd = rwMemEnd }
	var fileEnd uint64 = base
	if roFound && roFileEnd > fileEnd { fileEnd = roFileEnd }
	if rwFound && rwFileEnd > fileEnd { fileEnd = rwFileEnd }
	for i := 0; i < len(sections); i++ {
		if sections[i].Addr < base { return "a section address is below the load base" }
	}
	if entry < base || entry >= memEnd { return "entry point is outside the loaded image" }

	var totalFile int = dataStart + cast(int, fileEnd - base)
	var out @[]uint8 = make_slice(uint8, totalFile)

	// ELF header.
	out[0] = 0x7f
	out[1] = 0x45
	out[2] = 0x4c
	out[3] = 0x46
	out[4] = ELFCLASS64
	out[5] = ELFDATA2LSB
	out[6] = 1 // EV_CURRENT
	writeLE(out, 16, ET_EXEC, 2) // e_type
	writeLE(out, 18, machine, 2) // e_machine
	writeLE(out, 20, 1, 4) // e_version
	writeU64(out, 24, entry) // e_entry
	writeLE(out, 32, ehsize, 8) // e_phoff (right after the ELF header)
	// e_shoff (40) stays 0: no section headers.
	writeLE(out, 52, ehsize, 2) // e_ehsize
	writeLE(out, 54, phentsize, 2) // e_phentsize
	writeLE(out, 56, phnum, 2) // e_phnum
	// e_shentsize / e_shnum / e_shstrndx stay 0.

	// Program headers.  The lowest group covers the ELF header + program headers
	// (p_offset 0, p_vaddr = base - dataStart, sizes include the dataStart prefix);
	// a following group maps at its own page-aligned vaddr and congruent offset.
	// The read-only/exec group is always the lower one when present (Layout orders
	// .text/.rodata below .data/.bss).
	var segVaddr uint64 = base - cast(uint64, dataStart)
	var phi int = ehsize
	if roFound {
		writePhdr(out, phi, roPerms, 0, segVaddr, dataStart + cast(int, roFileEnd - base),
				dataStart + cast(int, roMemEnd - base), pagesize)
		phi = phi + phentsize
		if rwFound {
			writePhdr(out, phi, rwPerms, dataStart + cast(int, rwLo - base), rwLo,
					cast(int, rwFileEnd - rwLo), cast(int, rwMemEnd - rwLo), pagesize)
		}
	} else {
		writePhdr(out, phi, rwPerms, 0, segVaddr, dataStart + cast(int, rwFileEnd - base),
				dataStart + cast(int, rwMemEnd - base), pagesize)
	}

	// Section data at dataStart + (Addr - base).
	for i := 0; i < len(sections); i++ {
		var d @[]uint8 = sections[i].Data
		if len(d) == 0 { continue }
		var fo int = dataStart + cast(int, sections[i].Addr - base)
		for j := 0; j < len(d); j++ { out[fo + j] = d[j] }
	}

	return writeFile(path, out)
}
