package "pkg/binate/link"

import "pkg/std/os"

// segFlags maps normalized SF_* section flags to ELF PF_* segment flags.
func segFlags(flags int) int {
	var f int = 0
	if (flags & SF_READ) != 0 { f = f | PF_R }
	if (flags & SF_WRITE) != 0 { f = f | PF_W }
	if (flags & SF_EXEC) != 0 { f = f | PF_X }
	return f
}

// writeFile writes data to path (creating/truncating it).  The file is not made
// executable here — there is no os.Chmod in the stdlib yet, so a runner sets the
// mode (tracked as a stdlib gap in the plan).
func writeFile(path *[]readonly char, data @[]uint8) @[]readonly char {
	f, cerr := os.Create(path)
	if present(cerr) { return "cannot create output file" }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var raw *[]readonly uint8 = data
	n, werr := f.Write(raw)
	closeErr := f.Close()
	if present(werr) || n < len(data) || present(closeErr) {
		_ = os.Remove(path) // do not leave a truncated/corrupt executable behind
		return "failed to write output file"
	}
	return ""
}

// EmitElfExec writes a static ELF64 executable for the laid-out output sections
// (from Layout), entering at `entry`.  This first increment uses a single loadable
// PT_LOAD segment spanning all sections, with permissions the union of theirs
// (per-section RX/RW segments are a follow-up).  Section file offsets keep
// p_offset congruent to p_vaddr modulo the page size, so the segment is loadable
// even for a non-page-aligned base.  Returns "" on success or a non-empty error.
func EmitElfExec(sections @[]OutputSection, entry uint, machine int,
		path *[]readonly char) @[]readonly char {
	if len(sections) == 0 { return "no sections to emit" }
	var pagesize int = 0x1000
	var ehsize int = 64
	var phentsize int = 56
	var phnum int = 1
	var hend int = ehsize + phnum * phentsize

	// The load base is the first (lowest-address) section — Layout assigns
	// addresses in ascending load order.  Data starts at the first page-boundary
	// offset that is congruent to base modulo the page size (loadability).
	var base uint = sections[0].Addr
	var dataStart int = alignUp(hend, pagesize) + cast(int, base % cast(uint, pagesize))
	if base < cast(uint, dataStart) { return "load base too low to hold the ELF headers" }

	// File-backed end (last section carrying data), memory end (incl. bss), and
	// the union of segment permissions.
	var fileEnd uint = base
	var memEnd uint = base
	var perms int = 0
	for i := 0; i < len(sections); i++ {
		if sections[i].Addr < base { return "a section address is below the load base" }
		var end uint = sections[i].Addr + sections[i].Size
		if end > memEnd { memEnd = end }
		if len(sections[i].Data) > 0 {
			var fe uint = sections[i].Addr + cast(uint, len(sections[i].Data))
			if fe > fileEnd { fileEnd = fe }
		}
		perms = perms | segFlags(sections[i].Flags)
	}
	var filesz uint = fileEnd - base
	var memsz uint = memEnd - base
	if entry < base || entry >= memEnd { return "entry point is outside the loaded image" }

	var totalFile int = dataStart + cast(int, filesz)
	var out @[]uint8 = make_slice(uint8, totalFile)

	// ELF header.
	out[0] = 0x7f
	out[1] = 0x45
	out[2] = 0x4c
	out[3] = 0x46
	out[4] = ELFCLASS64
	out[5] = ELFDATA2LSB
	out[6] = 1 // EV_CURRENT
	writeLE(out, 16, ET_EXEC, 2) // e_type
	writeLE(out, 18, machine, 2) // e_machine
	writeLE(out, 20, 1, 4) // e_version
	writeLE(out, 24, cast(int, entry), 8) // e_entry
	writeLE(out, 32, ehsize, 8) // e_phoff (right after the ELF header)
	// e_shoff (40) stays 0: no section headers.
	writeLE(out, 52, ehsize, 2) // e_ehsize
	writeLE(out, 54, phentsize, 2) // e_phentsize
	writeLE(out, 56, phnum, 2) // e_phnum
	// e_shentsize / e_shnum / e_shstrndx stay 0.

	// One PT_LOAD segment.  It starts at file offset 0 so it maps the ELF header
	// and the program headers — a runtime that reads AT_PHDR (TLS setup, static-PIE
	// self-relocation, a libc _start) would otherwise dereference an unmapped
	// address.  Its vaddr is therefore base - dataStart (page-aligned, so p_offset 0
	// stays congruent to p_vaddr), and its sizes include the dataStart prefix.
	var segVaddr uint = base - cast(uint, dataStart)
	var ph int = ehsize
	writeLE(out, ph + 0, PT_LOAD, 4) // p_type
	writeLE(out, ph + 4, perms, 4) // p_flags
	writeLE(out, ph + 8, 0, 8) // p_offset (covers the ELF header + program headers)
	writeLE(out, ph + 16, cast(int, segVaddr), 8) // p_vaddr
	writeLE(out, ph + 24, cast(int, segVaddr), 8) // p_paddr
	writeLE(out, ph + 32, dataStart + cast(int, filesz), 8) // p_filesz
	writeLE(out, ph + 40, dataStart + cast(int, memsz), 8) // p_memsz
	writeLE(out, ph + 48, pagesize, 8) // p_align

	// Section data at dataStart + (Addr - base).
	for i := 0; i < len(sections); i++ {
		var d @[]uint8 = sections[i].Data
		if len(d) == 0 { continue }
		var fo int = dataStart + cast(int, sections[i].Addr - base)
		for j := 0; j < len(d); j++ { out[fo + j] = d[j] }
	}

	return writeFile(path, out)
}
