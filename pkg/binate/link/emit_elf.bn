package "pkg/binate/link"

import "pkg/std/os"

// segFlags maps normalized SF_* section flags to ELF PF_* segment flags.
func segFlags(flags int) int {
	var f int = 0
	if (flags & SF_READ) != 0 { f = f | PF_R }
	if (flags & SF_WRITE) != 0 { f = f | PF_W }
	if (flags & SF_EXEC) != 0 { f = f | PF_X }
	return f
}

// writeFile writes data to path, creating it mode 0o755 so the output is
// owner-executable (umask permitting) without a separate chmod — the stdlib has
// no os.Chmod, and a linker always creates its output fresh, so create-executable
// is the right seam.
func writeFile(path *[]readonly char, data @[]uint8) @[]readonly char {
	// Unlink first, then create a fresh inode: O_CREATE's mode is ignored for an
	// existing file (so re-linking would keep a stale non-exec mode), and unlinking
	// avoids ETXTBSY when re-linking over a still-running previous build.  A missing
	// path makes Remove fail harmlessly.
	_ = os.Remove(path)
	f, cerr := os.OpenFile(path, os.O_RDWR | os.O_CREATE | os.O_TRUNC, cast(os.FileMode, 0o755))
	if present(cerr) { return "cannot create output file" }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var raw *[]readonly uint8 = data
	n, werr := f.Write(raw)
	closeErr := f.Close()
	if present(werr) || n < len(data) || present(closeErr) {
		_ = os.Remove(path) // do not leave a truncated/corrupt executable behind
		return "failed to write output file"
	}
	return ""
}

// groupStats scans the output sections whose writability matches `writable` and
// returns (found, lo, fileEnd, memEnd, perms): whether any matched, the group's
// lowest vaddr, its file-backed end (max Addr + len(Data)), its memory end (max
// Addr + Size, so .bss counts), and the union of its PF_* permissions.  A group
// with no file data (e.g. only .bss) reports fileEnd == lo (zero file span).
func groupStats(sections @[]OutputSection, writable bool) (bool, uint64, uint64, uint64, int) {
	var found bool = false
	var hasData bool = false
	var lo uint64 = cast(uint64, 0)
	var fileEnd uint64 = cast(uint64, 0)
	var memEnd uint64 = cast(uint64, 0)
	var perms int = 0
	for i := 0; i < len(sections); i++ {
		if ((sections[i].Flags & SF_WRITE) != 0) != writable { continue }
		var a uint64 = sections[i].Addr
		if !found || a < lo { lo = a }
		var me uint64 = a + sections[i].Size
		if !found || me > memEnd { memEnd = me }
		if len(sections[i].Data) > 0 {
			var fe uint64 = a + cast(uint64, len(sections[i].Data))
			if !hasData || fe > fileEnd { fileEnd = fe }
			hasData = true
		}
		perms = perms | segFlags(sections[i].Flags)
		found = true
	}
	if !hasData { fileEnd = lo }
	return found, lo, fileEnd, memEnd, perms
}

// writePhdr writes one program header of type ptype (PT_LOAD for the ordinary case,
// or a driver's declared type for an explicit-PHDRS segment) at file offset phi, with
// independent p_vaddr (run address) and p_paddr (load address) — they differ for a
// ROM-copy or higher-half segment (LMA≠VMA) and coincide for the ordinary case.  The
// Elf32_Phdr (32 bytes) and Elf64_Phdr (56 bytes) share only p_type at offset 0:
// notably Elf32 places p_flags LAST (offset 24) rather than right after p_type, and
// its address/size fields are 4 bytes (an arm32 address fits).
func writePhdr(out @[]uint8, phi int, is64 bool, ptype int, flags int, off int, vaddr uint64,
		paddr uint64, filesz int, memsz int, align int) {
	if is64 {
		writeLE(out, phi + 0, ptype, 4) // p_type
		writeLE(out, phi + 4, flags, 4) // p_flags
		writeLE(out, phi + 8, off, 8) // p_offset
		writeU64(out, phi + 16, vaddr) // p_vaddr
		writeU64(out, phi + 24, paddr) // p_paddr
		writeLE(out, phi + 32, filesz, 8) // p_filesz
		writeLE(out, phi + 40, memsz, 8) // p_memsz
		writeLE(out, phi + 48, align, 8) // p_align
	} else {
		writeLE(out, phi + 0, ptype, 4) // p_type
		writeLE(out, phi + 4, off, 4) // p_offset
		writeU32(out, phi + 8, cast(int64, vaddr)) // p_vaddr
		writeU32(out, phi + 12, cast(int64, paddr)) // p_paddr
		writeLE(out, phi + 16, filesz, 4) // p_filesz
		writeLE(out, phi + 20, memsz, 4) // p_memsz
		writeLE(out, phi + 24, flags, 4) // p_flags
		writeLE(out, phi + 28, align, 4) // p_align
	}
}

// writeElfFromSegments writes a static ELF executable — ELF64, or ELF32 for arm32 (EM_ARM)
// — for the given load segments over `sections`, entering at `entry`.  Segments may be
// passed in any order — they are sorted
// here by load address so the lowest-LMA segment anchors the ELF header prefix.  Each
// segment carries its own p_type / p_flags, p_paddr = LMA and p_vaddr = VMA (equal for the
// ordinary case); the file is packed by LMA.  The lowest-LMA segment maps from file offset
// 0 so it covers the ELF header + program headers — a runtime reading AT_PHDR (TLS setup,
// static-PIE self-relocation, a libc _start) would otherwise dereference an unmapped
// address.  Each segment's p_offset stays congruent to its p_vaddr modulo the page size,
// so segments are loadable even for a non-page-aligned base.  A non-zero entry must fall
// inside a loaded segment.  Shared by the auto-derived (EmitElfExec) and explicit-PHDRS
// (EmitElfExecPhdrs) paths.  Returns "" on success or a non-empty error.
func writeElfFromSegments(segs @[]outSeg, sections @[]OutputSection, entry uint64, machine int,
		path *[]readonly char) @[]readonly char {
	// arm32 (EM_ARM) is the only 32-bit ELF machine — its header is 52 bytes with
	// 32-byte program headers and 32-bit addresses; every other target is ELF64.
	var is64 bool = machine != EM_ARM
	var pagesize int = linkPageSize
	var ehsize int = 52
	var phentsize int = 32
	if is64 {
		ehsize = 64
		phentsize = 56
	}

	// Sort segments by load address (LMA) so segs[0] is the lowest — it maps file offset
	// 0 and carries the header prefix.  deriveSegments already returns LMA order; explicit
	// PHDRS may be declared in any order.  Insertion sort — n is tiny.
	for i := 1; i < len(segs); i++ {
		var j int = i
		for j > 0 && segs[j - 1].Paddr > segs[j].Paddr {
			var tmp outSeg = segs[j - 1]
			segs[j - 1] = segs[j]
			segs[j] = tmp
			j = j - 1
		}
	}

	var phnum int = len(segs)
	var hend int = ehsize + phnum * phentsize

	// The lowest-LMA segment folds in the ELF header + program headers: it maps from
	// file offset 0, so its first byte (at Vaddr/Paddr) sits at dataStart, chosen as
	// the first page-boundary offset congruent to its VMA (loadability), and BOTH its
	// p_vaddr and its p_paddr back up by that prefix.  So the VMA and the LMA base each
	// need dataStart bytes of headroom below them; a lower LMA (a load address in the
	// first page) would underflow p_paddr, so it is rejected like a too-low VMA.
	var dataStart int = alignUp(hend, pagesize) + cast(int, segs[0].Vaddr % cast(uint64, pagesize))
	if segs[0].Vaddr < cast(uint64, dataStart) || segs[0].Paddr < cast(uint64, dataStart) {
		return "load base too low to hold the ELF headers"
	}

	// Assign each segment its file offset (DataOff = where its Paddr byte lands),
	// packing each right after the previous while keeping p_offset ≡ p_vaddr (mod
	// page).  Track the highest file end for the output size.
	var totalFile int = 0
	for k := 0; k < phnum; k++ {
		if k == 0 {
			segs[k].DataOff = dataStart
		} else {
			segs[k].DataOff = congruentAtLeast(totalFile, segs[k].Vaddr, pagesize)
		}
		var end int = segs[k].DataOff + segs[k].FileSz
		if end > totalFile { totalFile = end }
	}

	// A non-zero entry must be inside some loaded segment (zero = unset, e.g. a
	// raw-binary driver that emits ELF without an entry).
	if entry != cast(uint64, 0) {
		var inRange bool = false
		for k := 0; k < phnum; k++ {
			var lo uint64 = segs[k].Vaddr
			var hi uint64 = segs[k].Vaddr + cast(uint64, segs[k].MemSz)
			if k == 0 { lo = segs[k].Vaddr - cast(uint64, dataStart) }
			if entry >= lo && entry < hi { inRange = true }
		}
		if !inRange { return "entry point is outside the loaded image" }
	}

	var out @[]uint8 = make_slice(uint8, totalFile)

	// ELF header (e_ident + fields).  e_type/e_machine/e_version share offsets across
	// classes; e_entry/e_phoff and the e_*size/num fields move (and narrow) on ELF32.
	out[0] = 0x7f
	out[1] = 0x45
	out[2] = 0x4c
	out[3] = 0x46
	out[4] = ELFCLASS64
	if !is64 { out[4] = ELFCLASS32 }
	out[5] = ELFDATA2LSB
	out[6] = 1 // EV_CURRENT
	writeLE(out, 16, ET_EXEC, 2) // e_type
	writeLE(out, 18, machine, 2) // e_machine
	writeLE(out, 20, 1, 4) // e_version
	if is64 {
		writeU64(out, 24, entry) // e_entry
		writeLE(out, 32, ehsize, 8) // e_phoff (right after the ELF header)
		// e_shoff (40) stays 0: no section headers.
		writeLE(out, 52, ehsize, 2) // e_ehsize
		writeLE(out, 54, phentsize, 2) // e_phentsize
		writeLE(out, 56, phnum, 2) // e_phnum
		// e_shentsize / e_shnum / e_shstrndx stay 0.
	} else {
		writeU32(out, 24, cast(int64, entry)) // e_entry (4 bytes; an arm32 address fits)
		writeLE(out, 28, ehsize, 4) // e_phoff (right after the ELF header)
		// e_shoff (32) stays 0: no section headers.
		writeLE(out, 40, ehsize, 2) // e_ehsize
		writeLE(out, 42, phentsize, 2) // e_phentsize
		writeLE(out, 44, phnum, 2) // e_phnum
		// e_shentsize / e_shnum / e_shstrndx stay 0.
	}

	// Program headers + section bytes, one segment at a time.  The lowest-LMA segment
	// carries the header prefix (p_offset 0, sizes include dataStart); later segments
	// map from their own congruent file offset.
	for k := 0; k < phnum; k++ {
		var phi int = ehsize + k * phentsize
		if k == 0 {
			writePhdr(out, phi, is64, segs[k].Ptype, segs[k].Flags, 0,
					segs[k].Vaddr - cast(uint64, dataStart), segs[k].Paddr - cast(uint64, dataStart),
					dataStart + segs[k].FileSz, dataStart + segs[k].MemSz, pagesize)
		} else {
			writePhdr(out, phi, is64, segs[k].Ptype, segs[k].Flags, segs[k].DataOff, segs[k].Vaddr,
					segs[k].Paddr, segs[k].FileSz, segs[k].MemSz, pagesize)
		}
		for si := 0; si < len(segs[k].Secs); si++ {
			var idx int = segs[k].Secs[si]
			var d @[]uint8 = sections[idx].Data
			if len(d) == 0 { continue }
			var fo int = segs[k].DataOff + cast(int, sections[idx].Lma - segs[k].Paddr)
			for j := 0; j < len(d); j++ { out[fo + j] = d[j] }
		}
	}

	return writeFile(path, out)
}

// EmitElfExec writes a static ELF executable, AUTO-DERIVING the load segments from the
// sections (deriveSegments: coalesce by writability / VMA−LMA delta / LMA contiguity, so
// W^X holds and a multi-region layout packs compactly).  Returns "" on success or a
// non-empty error.
func EmitElfExec(sections @[]OutputSection, entry uint64, machine int,
		path *[]readonly char) @[]readonly char {
	if len(sections) == 0 { return "no sections to emit" }
	var segs @[]outSeg = deriveSegments(sections)
	if len(segs) == 0 { return "no loadable content to emit" }
	return writeElfFromSegments(segs, sections, entry, machine, path)
}

// EmitElfExecPhdrs writes a static ELF executable using a driver's EXPLICIT program
// headers (DefineSegment / AssignSection) rather than auto-deriving them — for a
// higher-half kernel or any layout that controls its own segment table (each segment's
// p_type / p_flags and section membership are the driver's).  Returns "" on success or a
// non-empty error (an out-of-range or mixed-delta segment, or a non-empty unassigned
// section).
func EmitElfExecPhdrs(sections @[]OutputSection, segStates @[]segState, entry uint64, machine int,
		path *[]readonly char) @[]readonly char {
	if len(sections) == 0 { return "no sections to emit" }
	segs, err := segmentsFromExplicit(sections, segStates)
	if len(err) != 0 { return err }
	if len(segs) == 0 { return "no loadable content to emit" }
	return writeElfFromSegments(segs, sections, entry, machine, path)
}
