package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// (fail is in parse_elf_test.bn; u16/u32/u64 in bytes.bn — same package.)

// mkOutSec builds an OutputSection.
func mkOutSec(name *[]readonly char, flags int, addr uint, data @[]uint8, size uint) OutputSection {
	var os OutputSection
	os.Name = buf.CopyStr(name)
	os.Flags = flags
	os.Align = 16
	os.Addr = cast(uint64, addr)
	os.Lma = cast(uint64, addr) // LMA == VMA (as Layout produces); LMA≠VMA: see emit_seg_test
	os.Data = data
	os.Size = cast(uint64, size)
	return os
}

// checkLoadable re-parses an emitted executable and verifies the load-critical
// invariants: the ELF64 identity, ET_EXEC/machine/entry, 1 or 2 well-formed
// PT_LOAD segments, the first covering file offset 0 (so the program headers are
// mapped for AT_PHDR), every segment p_offset congruent to p_vaddr modulo the
// page and never both writable and executable (W^X), and the entry inside some
// segment.  Returns "" if all hold, else a message.
func checkLoadable(data @[]uint8, machine int, entry int) @[]char {
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	if data[0] != 0x7f || data[1] != 0x45 || data[2] != 0x4c || data[3] != 0x46 {
		return buf.CopyStr("bad ELF magic")
	}
	if data[4] != ELFCLASS64 { return buf.CopyStr("not ELF64") }
	if data[5] != ELFDATA2LSB { return buf.CopyStr("not little-endian") }
	if u16(r, 16) != ET_EXEC { return buf.CopyStr("not ET_EXEC") }
	if u16(r, 18) != machine { return buf.CopyStr("wrong e_machine") }
	if cast(int, u64(r, 24)) != entry { return buf.CopyStr("wrong entry point") }
	if u64(r, 32) != 64 { return buf.CopyStr("wrong e_phoff") }
	if u16(r, 52) != 64 { return buf.CopyStr("wrong e_ehsize") }
	if u16(r, 54) != 56 { return buf.CopyStr("wrong e_phentsize") }
	if u64(r, 40) != 0 { return buf.CopyStr("e_shoff should be 0") }
	var phnum int = u16(r, 56)
	if phnum < 1 || phnum > 2 { return buf.CopyStr("expected 1 or 2 program headers") }
	var entryMapped bool = false
	for i := 0; i < phnum; i++ {
		var ph int = 64 + i * 56
		if cast(int, u32(r, ph)) != PT_LOAD { return buf.CopyStr("segment should be PT_LOAD") }
		var flags int = cast(int, u32(r, ph + 4))
		var pOffset int = cast(int, u64(r, ph + 8))
		var pVaddr int = cast(int, u64(r, ph + 16))
		var pMemsz int = cast(int, u64(r, ph + 40))
		if i == 0 && pOffset != 0 { return buf.CopyStr("first PT_LOAD must cover file offset 0") }
		if (pOffset % 0x1000) != (pVaddr % 0x1000) {
			return buf.CopyStr("p_offset not page-congruent to p_vaddr")
		}
		if (flags & PF_W) != 0 && (flags & PF_X) != 0 {
			return buf.CopyStr("a segment is both writable and executable (W^X violated)")
		}
		if entry >= pVaddr && entry < pVaddr + pMemsz { entryMapped = true }
	}
	if !entryMapped { return buf.CopyStr("entry not inside any load segment") }
	return buf.CopyStr("")
}

// fileOff maps a virtual address to its file offset.  Section data is packed by
// vaddr from the first segment's base (p_offset 0, p_vaddr = base - dataStart), so
// this holds across both segments even though the writable one starts a new page.
func fileOff(r *[]readonly uint8, vaddr int) int {
	var pOffset int = cast(int, u64(r, 64 + 8))
	var pVaddr int = cast(int, u64(r, 64 + 16))
	return (vaddr - pVaddr) + pOffset
}

// A single .text section emits a loadable executable; the entry's code bytes are
// at the file offset the segment maps the entry to.
func TestEmitElfExecSingleSection() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 4)
	d[0] = 0xb8
	d[1] = 0x2a
	d[2] = 0x00
	d[3] = 0xc3
	var secs @[]OutputSection = make_slice(OutputSection, 1)
	secs[0] = mkOutSec(".text", SF_READ | SF_EXEC, cast(uint, 0x400000), d, cast(uint, 4))
	if len(EmitElfExec(secs, cast(uint64, 0x400000), EM_X86_64, "/tmp/binate_link_exec")) != 0 {
		return fail("emit failed")
	}
	data, ok := readFile("/tmp/binate_link_exec")
	if !ok { return fail("cannot read the emitted executable") }
	var problem @[]char = checkLoadable(data, EM_X86_64, 0x400000)
	if len(problem) != 0 { return problem }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	if (cast(int, u32(r, 64 + 4)) & PF_X) == 0 { return fail("the text segment should be executable") }
	var fo int = fileOff(r, 0x400000)
	if data[fo] != 0xb8 || data[fo + 3] != 0xc3 {
		return fail("entry code not at its mapped file offset")
	}
	return ""
}

// A non-page-aligned base still yields a loadable segment (exercises the
// base % pagesize term in dataStart).
func TestEmitElfExecUnalignedBase() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 4)
	d[0] = 0xc3
	var secs @[]OutputSection = make_slice(OutputSection, 1)
	secs[0] = mkOutSec(".text", SF_READ | SF_EXEC, cast(uint, 0x400080), d, cast(uint, 4))
	if len(EmitElfExec(secs, cast(uint64, 0x400080), EM_X86_64, "/tmp/binate_link_exec_unaligned")) !=
			0 {
		return fail("emit failed")
	}
	data, ok := readFile("/tmp/binate_link_exec_unaligned")
	if !ok { return fail("cannot read the emitted executable") }
	var problem @[]char = checkLoadable(data, EM_X86_64, 0x400080)
	if len(problem) != 0 { return problem }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	if data[fileOff(r, 0x400080)] != 0xc3 { return fail("entry code not at its mapped file offset") }
	return ""
}

// A multi-section image (text + a page-separated data section, as Layout produces)
// emits two segments: a read-only/exec one and a read-write one.  Each section
// maps to its file offset, and W^X holds (the .text segment is not writable, the
// .data segment is not executable).
func TestEmitElfExecMultiSection() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 4)
	dt[0] = 0xc3
	var dd @[]uint8 = make_slice(uint8, 4)
	dd[0] = 0xaa
	dd[1] = 0xbb
	dd[2] = 0xcc
	dd[3] = 0xdd
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	secs[0] = mkOutSec(".text", SF_READ | SF_EXEC, cast(uint, 0x400000), dt, cast(uint, 4))
	secs[1] = mkOutSec(".data", SF_READ | SF_WRITE, cast(uint, 0x401000), dd, cast(uint, 4))
	if len(EmitElfExec(secs, cast(uint64, 0x400000), EM_X86_64, "/tmp/binate_link_exec_multi")) != 0 {
		return fail("emit failed")
	}
	data, ok := readFile("/tmp/binate_link_exec_multi")
	if !ok { return fail("cannot read the emitted executable") }
	var problem @[]char = checkLoadable(data, EM_X86_64, 0x400000)
	if len(problem) != 0 { return problem }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	if u16(r, 56) != 2 { return fail("text + data should emit two segments") }
	var roPerms int = cast(int, u32(r, 64 + 4))
	if (roPerms & PF_X) == 0 || (roPerms & PF_W) != 0 {
		return fail("the .text segment should be R+X, not writable")
	}
	var rwPerms int = cast(int, u32(r, 64 + 56 + 4))
	if (rwPerms & PF_W) == 0 || (rwPerms & PF_X) != 0 {
		return fail("the .data segment should be R+W, not executable")
	}
	if data[fileOff(r, 0x400000)] != 0xc3 { return fail(".text not at its mapped file offset") }
	if data[fileOff(r, 0x401000)] != 0xaa { return fail(".data not at its mapped file offset") }
	return ""
}

// A .bss section (memory, no file bytes) makes the writable segment's p_memsz
// exceed its p_filesz.  .bss is page-separated from .text (as Layout produces), so
// it lands in the second (R+W) segment, which is bss-only here: filesz 0, memsz 16.
func TestEmitElfExecBssMemszExceedsFilesz() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 4)
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	secs[0] = mkOutSec(".text", SF_READ | SF_EXEC, cast(uint, 0x400000), dt, cast(uint, 4))
	secs[1] = mkOutSec(".bss", SF_READ | SF_WRITE, cast(uint, 0x401000), make_slice(uint8, 0),
			cast(uint, 16))
	if len(EmitElfExec(secs, cast(uint64, 0x400000), EM_X86_64, "/tmp/binate_link_exec_bss")) != 0 {
		return fail("emit failed")
	}
	data, ok := readFile("/tmp/binate_link_exec_bss")
	if !ok { return fail("cannot read the emitted executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	if u16(r, 56) != 2 { return fail("text + bss should emit two segments") }
	var filesz int = cast(int, u64(r, 64 + 56 + 32)) // second (R+W) segment
	var memsz int = cast(int, u64(r, 64 + 56 + 40))
	if filesz != 0 { return fail("the bss-only segment should have filesz 0") }
	if memsz != 16 { return fail("the bss-only segment memsz should be the .bss size (16)") }
	return ""
}

// Two segments with a NON-page-aligned base: the RW segment's p_offset must stay
// congruent to its p_vaddr modulo the page (this relies on dataStart - base being
// a whole number of pages), and W^X must hold.  checkLoadable verifies both, plus
// each section maps to its file offset.
func TestEmitElfExecTwoSegmentsUnalignedBase() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 4)
	dt[0] = 0xc3
	var dd @[]uint8 = make_slice(uint8, 4)
	dd[0] = 0x7e
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	// base = 0x400080 (not page-aligned); .data page-aligned as Layout produces.
	secs[0] = mkOutSec(".text", SF_READ | SF_EXEC, cast(uint, 0x400080), dt, cast(uint, 4))
	secs[1] = mkOutSec(".data", SF_READ | SF_WRITE, cast(uint, 0x401000), dd, cast(uint, 4))
	if len(EmitElfExec(secs, cast(uint64, 0x400080), EM_X86_64, "/tmp/binate_link_exec_unaln2")) != 0 {
		return fail("emit failed")
	}
	data, ok := readFile("/tmp/binate_link_exec_unaln2")
	if !ok { return fail("cannot read the emitted executable") }
	var problem @[]char = checkLoadable(data, EM_X86_64, 0x400080)
	if len(problem) != 0 { return problem }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	if u16(r, 56) != 2 { return fail("expected two segments") }
	if data[fileOff(r, 0x400080)] != 0xc3 { return fail(".text not at its mapped file offset") }
	if data[fileOff(r, 0x401000)] != 0x7e { return fail(".data not at its mapped file offset") }
	return ""
}

// arm32 (EM_ARM) emits a real ELF32 image: ELFCLASS32, a 52-byte header, 32-byte
// program headers with p_flags at offset 24, 4-byte addresses, e_machine=ARM.  The
// text segment is R+X (W^X), and the section bytes land at the header-prefixed file
// offset.
func TestEmitElfArm32() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 4)
	d[0] = 0x1e // BX LR = 0xE12FFF1E, little-endian
	d[1] = 0xff
	d[2] = 0x2f
	d[3] = 0xe1
	var sections @[]OutputSection = make_slice(OutputSection, 1)
	sections[0] = mkOutSec(".text", SF_READ | SF_EXEC, cast(uint, 0x10000), d, cast(uint, 4))
	var path *[]readonly char = "/tmp/binate_link_arm32_emit"
	var e @[]readonly char = EmitElfExec(sections, cast(uint64, 0x10000), EM_ARM, path)
	if len(e) != 0 { return fail("EmitElfExec(EM_ARM) should emit an ELF32") }
	data, ok := readFile(path)
	if !ok { return fail("cannot read the emitted ELF32") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	if data[0] != 0x7f || data[4] != ELFCLASS32 { return fail("not an ELFCLASS32 file") }
	if data[5] != ELFDATA2LSB { return fail("not little-endian") }
	if u16(r, 16) != ET_EXEC { return fail("not ET_EXEC") }
	if u16(r, 18) != EM_ARM { return fail("e_machine should be EM_ARM") }
	if u32(r, 24) != cast(int64, 0x10000) { return fail("e_entry should be 0x10000") }
	if u32(r, 28) != cast(int64, 52) {
		return fail("e_phoff should be 52 (right after the Elf32 header)")
	}
	if u16(r, 40) != 52 { return fail("e_ehsize should be 52") }
	if u16(r, 42) != 32 { return fail("e_phentsize should be 32") }
	if u16(r, 44) < 1 { return fail("expected at least one program header") }
	// First Elf32_Phdr at offset 52: p_type(+0), p_offset(+4), p_vaddr(+8), p_flags(+24).
	if cast(int, u32(r, 52)) != PT_LOAD { return fail("first phdr should be PT_LOAD") }
	var pflags int = cast(int, u32(r, 52 + 24))
	if (pflags & PF_R) == 0 || (pflags & PF_X) == 0 { return fail("text segment should be R+X") }
	if (pflags & PF_W) != 0 { return fail("text segment should not be writable (W^X)") }
	// The single segment's content is packed after the header prefix — here the last
	// four bytes of the file (the BX LR word).
	var n int = len(data)
	if data[n - 4] != 0x1e || data[n - 1] != 0xe1 { return fail("text bytes missing from the image") }
	return ""
}
