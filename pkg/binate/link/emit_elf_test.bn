package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// (fail is in parse_elf_test.bn; u16/u32/u64 in bytes.bn — same package.)

// mkOutSec builds an OutputSection.
func mkOutSec(name *[]readonly char, flags int, addr uint, data @[]uint8, size uint) OutputSection {
	var os OutputSection
	os.Name = buf.CopyStr(name)
	os.Flags = flags
	os.Align = 16
	os.Addr = addr
	os.Data = data
	os.Size = size
	return os
}

// checkLoadable re-parses an emitted executable and verifies the load-critical
// invariants: the ELF64 identity, ET_EXEC/machine/entry, a well-formed single
// PT_LOAD that covers file offset 0 (so the program headers are mapped for
// AT_PHDR), p_offset congruent to p_vaddr modulo the page, and the entry inside
// the segment.  Returns "" if all hold, else a message.
func checkLoadable(data @[]uint8, machine int, entry int) @[]char {
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	if data[0] != 0x7f || data[1] != 0x45 || data[2] != 0x4c || data[3] != 0x46 {
		return buf.CopyStr("bad ELF magic")
	}
	if data[4] != ELFCLASS64 { return buf.CopyStr("not ELF64") }
	if data[5] != ELFDATA2LSB { return buf.CopyStr("not little-endian") }
	if u16(r, 16) != ET_EXEC { return buf.CopyStr("not ET_EXEC") }
	if u16(r, 18) != machine { return buf.CopyStr("wrong e_machine") }
	if u64(r, 24) != entry { return buf.CopyStr("wrong entry point") }
	if u64(r, 32) != 64 { return buf.CopyStr("wrong e_phoff") }
	if u16(r, 52) != 64 { return buf.CopyStr("wrong e_ehsize") }
	if u16(r, 54) != 56 { return buf.CopyStr("wrong e_phentsize") }
	if u16(r, 56) != 1 { return buf.CopyStr("expected exactly one program header") }
	if u64(r, 40) != 0 { return buf.CopyStr("e_shoff should be 0") }
	if u32(r, 64) != PT_LOAD { return buf.CopyStr("segment should be PT_LOAD") }
	var pOffset int = u64(r, 64 + 8)
	var pVaddr int = u64(r, 64 + 16)
	var pMemsz int = u64(r, 64 + 40)
	if pOffset != 0 { return buf.CopyStr("first PT_LOAD must cover file offset 0") }
	if (pOffset % 0x1000) != (pVaddr % 0x1000) {
		return buf.CopyStr("p_offset not page-congruent to p_vaddr")
	}
	if entry < pVaddr || entry >= pVaddr + pMemsz {
		return buf.CopyStr("entry not inside the load segment")
	}
	return buf.CopyStr("")
}

// fileOff maps a virtual address to its file offset in the single-segment image.
func fileOff(r *[]readonly uint8, vaddr int) int {
	var pOffset int = u64(r, 64 + 8)
	var pVaddr int = u64(r, 64 + 16)
	return (vaddr - pVaddr) + pOffset
}

// A single .text section emits a loadable executable; the entry's code bytes are
// at the file offset the segment maps the entry to.
func TestEmitElfExecSingleSection() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 4)
	d[0] = 0xb8
	d[1] = 0x2a
	d[2] = 0x00
	d[3] = 0xc3
	var secs @[]OutputSection = make_slice(OutputSection, 1)
	secs[0] = mkOutSec(".text", SF_READ | SF_EXEC, cast(uint, 0x400000), d, cast(uint, 4))
	if len(EmitElfExec(secs, cast(uint, 0x400000), EM_X86_64, "/tmp/binate_link_exec")) != 0 {
		return fail("emit failed")
	}
	data, ok := readFile("/tmp/binate_link_exec")
	if !ok { return fail("cannot read the emitted executable") }
	var problem @[]char = checkLoadable(data, EM_X86_64, 0x400000)
	if len(problem) != 0 { return problem }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	if (u32(r, 64 + 4) & PF_X) == 0 { return fail("the text segment should be executable") }
	var fo int = fileOff(r, 0x400000)
	if data[fo] != 0xb8 || data[fo + 3] != 0xc3 {
		return fail("entry code not at its mapped file offset")
	}
	return ""
}

// A non-page-aligned base still yields a loadable segment (exercises the
// base % pagesize term in dataStart).
func TestEmitElfExecUnalignedBase() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 4)
	d[0] = 0xc3
	var secs @[]OutputSection = make_slice(OutputSection, 1)
	secs[0] = mkOutSec(".text", SF_READ | SF_EXEC, cast(uint, 0x400080), d, cast(uint, 4))
	if len(EmitElfExec(secs, cast(uint, 0x400080), EM_X86_64, "/tmp/binate_link_exec_unaligned")) !=
			0 {
		return fail("emit failed")
	}
	data, ok := readFile("/tmp/binate_link_exec_unaligned")
	if !ok { return fail("cannot read the emitted executable") }
	var problem @[]char = checkLoadable(data, EM_X86_64, 0x400080)
	if len(problem) != 0 { return problem }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	if data[fileOff(r, 0x400080)] != 0xc3 { return fail("entry code not at its mapped file offset") }
	return ""
}

// A multi-section image (text + data) places each section at its mapped file
// offset, both within one RWX segment.
func TestEmitElfExecMultiSection() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 4)
	dt[0] = 0xc3
	var dd @[]uint8 = make_slice(uint8, 4)
	dd[0] = 0xaa
	dd[1] = 0xbb
	dd[2] = 0xcc
	dd[3] = 0xdd
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	secs[0] = mkOutSec(".text", SF_READ | SF_EXEC, cast(uint, 0x400000), dt, cast(uint, 4))
	secs[1] = mkOutSec(".data", SF_READ | SF_WRITE, cast(uint, 0x400010), dd, cast(uint, 4))
	if len(EmitElfExec(secs, cast(uint, 0x400000), EM_X86_64, "/tmp/binate_link_exec_multi")) != 0 {
		return fail("emit failed")
	}
	data, ok := readFile("/tmp/binate_link_exec_multi")
	if !ok { return fail("cannot read the emitted executable") }
	var problem @[]char = checkLoadable(data, EM_X86_64, 0x400000)
	if len(problem) != 0 { return problem }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	var perms int = u32(r, 64 + 4)
	if (perms & PF_X) == 0 || (perms & PF_W) == 0 {
		return fail("segment should be RWX (union of RX + RW)")
	}
	if data[fileOff(r, 0x400000)] != 0xc3 { return fail(".text not at its mapped file offset") }
	if data[fileOff(r, 0x400010)] != 0xaa { return fail(".data not at its mapped file offset") }
	return ""
}

// A .bss section (memory, no file bytes) makes p_memsz exceed p_filesz.
func TestEmitElfExecBssMemszExceedsFilesz() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 4)
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	secs[0] = mkOutSec(".text", SF_READ | SF_EXEC, cast(uint, 0x400000), dt, cast(uint, 4))
	secs[1] = mkOutSec(".bss", SF_READ | SF_WRITE, cast(uint, 0x401000), make_slice(uint8, 0),
			cast(uint, 16))
	if len(EmitElfExec(secs, cast(uint, 0x400000), EM_X86_64, "/tmp/binate_link_exec_bss")) != 0 {
		return fail("emit failed")
	}
	data, ok := readFile("/tmp/binate_link_exec_bss")
	if !ok { return fail("cannot read the emitted executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	var filesz int = u64(r, 64 + 32)
	var memsz int = u64(r, 64 + 40)
	if memsz <= filesz { return fail("memsz should exceed filesz when .bss is present") }
	if memsz - filesz != (0x401010 - 0x400004) {
		return fail("memsz - filesz should span the gap + .bss")
	}
	return ""
}
