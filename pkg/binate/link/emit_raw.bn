package "pkg/binate/link"

// Raw-binary output backend.  A raw binary is the section bytes concatenated by load
// address (LMA) with no ELF/Mach-O container — the form a boot ROM, an MBR, or a
// firmware flasher consumes directly (the equivalent of `objcopy -O binary`).  It is
// arch-agnostic: no headers, no relocation of a program-header table, just bytes at
// their load offsets.

// EmitRawBinaryImage writes the laid-out sections as a flat binary: each data-bearing
// section's bytes at file offset (Lma − loBase), where loBase is the lowest section
// LMA.  Gaps between sections (alignment padding, an explicit PadTo) are zero-filled;
// NOBITS sections (.bss — no file bytes) contribute nothing, matching a ROM image
// where zero-init memory is not stored.  Overlapping LMA ranges are a hard error
// (they would silently corrupt each other).  Returns "" on success, or a non-empty
// error (no data to emit, or overlap).
func EmitRawBinaryImage(sections @[]OutputSection, path *[]readonly char) @[]readonly char {
	// Span of the file-backed content in LMA space.
	var found bool = false
	var lo uint64 = cast(uint64, 0)
	var hi uint64 = cast(uint64, 0)
	for i := 0; i < len(sections); i++ {
		if len(sections[i].Data) == 0 { continue }
		var a uint64 = sections[i].Lma
		var e uint64 = a + cast(uint64, len(sections[i].Data))
		if !found || a < lo { lo = a }
		if !found || e > hi { hi = e }
		found = true
	}
	if !found { return "no data to emit" }

	// Reject overlapping load ranges (O(n^2) over the few output sections): a raw
	// image stores each byte once, so two sections mapping the same offset is a
	// layout bug, not a silent last-writer-wins.
	for i := 0; i < len(sections); i++ {
		if len(sections[i].Data) == 0 { continue }
		var ai uint64 = sections[i].Lma
		var ei uint64 = ai + cast(uint64, len(sections[i].Data))
		for j := i + 1; j < len(sections); j++ {
			if len(sections[j].Data) == 0 { continue }
			var aj uint64 = sections[j].Lma
			var ej uint64 = aj + cast(uint64, len(sections[j].Data))
			if ai < ej && aj < ei { return "overlapping section load addresses in raw binary" }
		}
	}

	var out @[]uint8 = make_slice(uint8, cast(int, hi - lo))
	for i := 0; i < len(sections); i++ {
		var d @[]uint8 = sections[i].Data
		if len(d) == 0 { continue }
		var fo int = cast(int, sections[i].Lma - lo)
		for j := 0; j < len(d); j++ { out[fo + j] = d[j] }
	}
	return writeFile(path, out)
}
