package "pkg/binate/link"

import "pkg/builtins/testing"

// (mkSecLma is in emit_seg_test.bn; fail in parse_elf_test.bn; readFile in the
// package — all same package.)

// Two data sections at contiguous load addresses concatenate into a flat binary with
// no headers; each section's bytes land at (Lma − loBase).
func TestEmitRawBinaryContiguous() testing.TestResult {
	var da @[]uint8 = make_slice(uint8, 4)
	da[0] = 0xaa
	da[3] = 0xbb
	var db @[]uint8 = make_slice(uint8, 2)
	db[0] = 0xcc
	db[1] = 0xdd
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	secs[0] = mkSecLma(".a", SF_READ, cast(uint64, 0x1000), cast(uint64, 0x1000), da, cast(uint64, 4))
	secs[1] = mkSecLma(".b", SF_READ, cast(uint64, 0x1004), cast(uint64, 0x1004), db, cast(uint64, 2))
	if len(EmitRawBinaryImage(secs, "/tmp/binate_link_raw")) != 0 { return fail("emit failed") }
	data, ok := readFile("/tmp/binate_link_raw")
	if !ok { return fail("cannot read the emitted binary") }
	if len(data) != 6 { return fail("the binary should be exactly the two sections' bytes") }
	if data[0] != 0xaa || data[3] != 0xbb || data[4] != 0xcc || data[5] != 0xdd {
		return fail("section bytes not at their load offsets")
	}
	return ""
}

// A gap between load addresses (e.g. an MBR padded to offset 510 before its signature)
// is zero-filled, and the signature lands at its exact offset.
func TestEmitRawBinaryGapFill() testing.TestResult {
	var code @[]uint8 = make_slice(uint8, 2)
	code[0] = 0xeb
	code[1] = 0xfe
	var sig @[]uint8 = make_slice(uint8, 2)
	sig[0] = 0x55
	sig[1] = 0xaa
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	secs[0] = mkSecLma(".text", SF_READ | SF_EXEC, cast(uint64, 0x7c00), cast(uint64, 0x7c00), code,
			cast(uint64, 2))
	secs[1] = mkSecLma(".sig", SF_READ, cast(uint64, 0x7dfe), cast(uint64, 0x7dfe), sig,
			cast(uint64, 2))
	if len(EmitRawBinaryImage(secs, "/tmp/binate_link_raw_gap")) != 0 { return fail("emit failed") }
	data, ok := readFile("/tmp/binate_link_raw_gap")
	if !ok { return fail("cannot read the emitted binary") }
	if len(data) != 512 { return fail("the padded image should be exactly 512 bytes") }
	if data[0] != 0xeb || data[1] != 0xfe { return fail("code not at offset 0") }
	if data[2] != 0 || data[509] != 0 { return fail("the gap should be zero-filled") }
	if data[510] != 0x55 || data[511] != 0xaa { return fail("the signature should be at offset 510") }
	return ""
}

// A NOBITS .bss (no file bytes) contributes nothing to a raw binary — zero-init memory
// is not stored in a ROM image.
func TestEmitRawBinaryBssSkipped() testing.TestResult {
	var code @[]uint8 = make_slice(uint8, 4)
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	secs[0] = mkSecLma(".text", SF_READ | SF_EXEC, cast(uint64, 0x1000), cast(uint64, 0x1000), code,
			cast(uint64, 4))
	secs[1] = mkSecLma(".bss", SF_READ | SF_WRITE, cast(uint64, 0x1004), cast(uint64, 0x1004),
			make_slice(uint8, 0), cast(uint64, 4096))
	if len(EmitRawBinaryImage(secs, "/tmp/binate_link_raw_bss")) != 0 { return fail("emit failed") }
	data, ok := readFile("/tmp/binate_link_raw_bss")
	if !ok { return fail("cannot read the emitted binary") }
	if len(data) != 4 { return fail("only .text bytes belong in the image, not the .bss reservation") }
	return ""
}

// Overlapping load ranges are a hard error (a raw image stores each byte once — a
// silent last-writer-wins would corrupt the output).
func TestEmitRawBinaryOverlapError() testing.TestResult {
	var da @[]uint8 = make_slice(uint8, 8)
	var db @[]uint8 = make_slice(uint8, 8)
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	secs[0] = mkSecLma(".a", SF_READ, cast(uint64, 0x1000), cast(uint64, 0x1000), da, cast(uint64, 8))
	secs[1] = mkSecLma(".b", SF_READ, cast(uint64, 0x1004), cast(uint64, 0x1004), db, cast(uint64, 8))
	if len(EmitRawBinaryImage(secs, "/tmp/binate_link_raw_overlap")) == 0 {
		return fail("overlapping load ranges should be rejected")
	}
	return ""
}
