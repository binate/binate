package "pkg/binate/link"

import "pkg/stdx/slices"

// Load-segment derivation for the ELF writer.  A scripted layout can place output
// sections at arbitrary VMAs and LMAs across several memory regions (ROM-copy data,
// a higher-half image, FLASH+RAM), so the writer can no longer assume one contiguous
// base with a single read-only/read-write split.  deriveSegments walks the sections
// in LMA order and coalesces them into PT_LOAD segments, the file being packed by
// LMA (where bytes load from) while addresses stay in VMA (where code runs).

// outSeg is a derived PT_LOAD: a maximal run of output sections, in LMA order,
// sharing writability and the same VMA−LMA delta and contiguous in LMA.  Vaddr/Paddr
// are the segment's first byte in VMA / LMA (Paddr is the load address; Vaddr the run
// address — equal for the ordinary LMA==VMA case).  FileSz counts only file-backed
// bytes (a NOBITS .bss contributes to MemSz but not FileSz); DataOff is the file
// offset the writer assigns to the Paddr byte.  Secs indexes the sections slice.
type outSeg struct {
	Ptype   int // ELF p_type: PT_LOAD for auto-derived; a driver's declared type for explicit PHDRS
	Flags   int
	Vaddr   uint64
	Paddr   uint64
	Delta   uint64
	FileSz  int
	MemSz   int
	DataOff int
	Secs    @[]int
}

// deriveSegments groups sections into PT_LOAD segments in LMA-ascending order.  A new
// segment starts when a section differs from the current one in writability, in its
// VMA−LMA delta (a ROM-copy or higher-half section cannot share a segment's single
// vaddr/paddr relationship), or when at least a full page of LMA separates them (a
// distinct memory region — coalescing across it would inflate the file by the gap).
// Otherwise the section extends the current segment, unioning its permissions and
// growing the file/memory spans.  bss sections carry no file bytes, so they grow only
// MemSz.  Returns the segments; the caller assigns file offsets.
func deriveSegments(sections @[]OutputSection) @[]outSeg {
	// LMA-ascending order of section indices (stable insertion sort — n is tiny, and
	// sections at equal LMA keep creation order).
	var order @[]int = make_slice(int, len(sections))
	for i := 0; i < len(sections); i++ { order[i] = i }
	for i := 1; i < len(order); i++ {
		var j int = i
		for j > 0 && sections[order[j - 1]].Lma > sections[order[j]].Lma {
			var tmp int = order[j - 1]
			order[j - 1] = order[j]
			order[j] = tmp
			j = j - 1
		}
	}

	var segs @[]outSeg = make_slice(outSeg, 0)
	for oi := 0; oi < len(order); oi++ {
		var idx int = order[oi]
		// Skip a truly-empty section — no memory reserved and no bytes.  A scripted
		// driver commonly opens .rodata/.data/.bss whose Place globs match nothing (a
		// program with only .text); such a section needs no segment, and an empty
		// PT_LOAD (memsz 0) is degenerate.  A NOBITS .bss with Size>0 reserves memory
		// and is NOT empty, so it is kept.
		if sections[idx].Size == cast(uint64, 0) && len(sections[idx].Data) == 0 { continue }
		var wr bool = (sections[idx].Flags & SF_WRITE) != 0
		var delta uint64 = sections[idx].Addr - sections[idx].Lma
		var startNew bool = true
		if len(segs) > 0 {
			var li int = len(segs) - 1
			var gwr bool = (segs[li].Flags & PF_W) != 0
			var prevLmaEnd uint64 = segs[li].Paddr + cast(uint64, segs[li].MemSz)
			var gap uint64 = cast(uint64, 0)
			if sections[idx].Lma > prevLmaEnd { gap = sections[idx].Lma - prevLmaEnd }
			if wr == gwr && delta == segs[li].Delta && gap < cast(uint64, linkPageSize) {
				startNew = false
			}
		}
		if startNew {
			var sg outSeg
			sg.Ptype = PT_LOAD
			sg.Flags = 0
			sg.Vaddr = sections[idx].Addr
			sg.Paddr = sections[idx].Lma
			sg.Delta = delta
			sg.FileSz = 0
			sg.MemSz = 0
			sg.DataOff = 0
			sg.Secs = make_slice(int, 0)
			segs = slices.Append[outSeg](segs, sg)
		}
		var li int = len(segs) - 1
		segs[li].Flags = segs[li].Flags | segFlags(sections[idx].Flags)
		segs[li].Secs = slices.Append[int](segs[li].Secs, idx)
		var memEnd uint64 = sections[idx].Addr + sections[idx].Size
		var mem int = cast(int, memEnd - segs[li].Vaddr)
		if mem > segs[li].MemSz { segs[li].MemSz = mem }
		if len(sections[idx].Data) > 0 {
			var lmaEnd uint64 = sections[idx].Lma + cast(uint64, len(sections[idx].Data))
			var fsz int = cast(int, lmaEnd - segs[li].Paddr)
			if fsz > segs[li].FileSz { segs[li].FileSz = fsz }
		}
	}
	return segs
}

// congruentAtLeast returns the smallest file offset >= minOff whose value modulo page
// equals vaddr modulo page — so a PT_LOAD placed there keeps p_offset ≡ p_vaddr (mod
// page), the ELF loadability requirement, while packing right after the previous
// segment's bytes.
func congruentAtLeast(minOff int, vaddr uint64, page int) int {
	var want int = cast(int, vaddr % cast(uint64, page))
	var cand int = (minOff - (minOff % page)) + want
	if cand < minOff { cand = cand + page }
	return cand
}

// segmentsFromExplicit builds load segments from a driver's explicit PHDRS
// (DefineSegment / AssignSection): one outSeg per declared segment, carrying the driver's
// p_type and p_flags and the sections assigned to it.  Each segment's members must share
// one VMA−LMA delta (a PT_LOAD maps a single file range affinely, so p_vaddr−p_paddr is
// constant within it); a non-empty section assigned to no segment is a hard error (strict
// orphan).  Empty members / segments contribute nothing.  Returns the segments and "" on
// success, or an empty slice and a non-empty error.
func segmentsFromExplicit(sections @[]OutputSection,
		segStates @[]segState) (@[]outSeg, @[]readonly char) {
	var none @[]outSeg = make_slice(outSeg, 0)
	var assigned @[]bool = make_slice(bool, len(sections))
	var out @[]outSeg = make_slice(outSeg, 0)
	for s := 0; s < len(segStates); s++ {
		var members @[]int = segStates[s].SecIdxs
		var sg outSeg
		sg.Ptype = segStates[s].Ptype
		sg.Flags = segStates[s].Flags
		sg.FileSz = 0
		sg.MemSz = 0
		sg.DataOff = 0
		sg.Secs = make_slice(int, 0)
		var found bool = false
		var vaddr uint64 = cast(uint64, 0)
		var paddr uint64 = cast(uint64, 0)
		var delta uint64 = cast(uint64, 0)
		for mi := 0; mi < len(members); mi++ {
			var idx int = members[mi]
			if idx < 0 || idx >= len(sections) {
				return none, "explicit segment references an out-of-range section"
			}
			assigned[idx] = true
			// A truly-empty section reserves nothing; it needs no place in the segment.
			if sections[idx].Size == cast(uint64, 0) && len(sections[idx].Data) == 0 { continue }
			var d uint64 = sections[idx].Addr - sections[idx].Lma
			if !found {
				vaddr = sections[idx].Addr
				paddr = sections[idx].Lma
				delta = d
			} else {
				if d != delta {
					return none, "a segment mixes sections with different VMA-LMA deltas"
				}
				if sections[idx].Addr < vaddr { vaddr = sections[idx].Addr }
				if sections[idx].Lma < paddr { paddr = sections[idx].Lma }
			}
			found = true
			sg.Secs = slices.Append[int](sg.Secs, idx)
		}
		if !found { continue } // an empty (or all-empty) segment contributes no PT_LOAD
		sg.Vaddr = vaddr
		sg.Paddr = paddr
		sg.Delta = delta
		for si := 0; si < len(sg.Secs); si++ {
			var idx int = sg.Secs[si]
			var mem int = cast(int, (sections[idx].Addr + sections[idx].Size) - sg.Vaddr)
			if mem > sg.MemSz { sg.MemSz = mem }
			if len(sections[idx].Data) > 0 {
				var fsz int = cast(int, (sections[idx].Lma + cast(uint64, len(sections[idx].Data))) - sg.Paddr)
				if fsz > sg.FileSz { sg.FileSz = fsz }
			}
		}
		out = slices.Append[outSeg](out, sg)
	}
	// Strict orphan: every non-empty section must be assigned to some segment.
	for i := 0; i < len(sections); i++ {
		if assigned[i] { continue }
		if sections[i].Size == cast(uint64, 0) && len(sections[i].Data) == 0 { continue }
		return none, "a non-empty section is not assigned to any explicit segment"
	}
	return out, ""
}
