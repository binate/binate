package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// (fail is in parse_elf_test.bn; u64 in bytes.bn; readFile in the package — all same
// package.)

// mkSecLma builds an OutputSection with independent VMA (addr) and LMA (lma), for the
// ROM-copy / higher-half cases where they differ.
func mkSecLma(name *[]readonly char, flags int, addr uint64, lma uint64, data @[]uint8,
		size uint64) OutputSection {
	var os OutputSection
	os.Name = buf.CopyStr(name)
	os.Flags = flags
	os.Align = 4
	os.Addr = addr
	os.Lma = lma
	os.Data = data
	os.Size = size
	return os
}

// congruentAtLeast returns the smallest offset >= minOff congruent to the address
// modulo the page — so packing stays dense while p_offset ≡ p_vaddr holds.
func TestCongruentAtLeast() testing.TestResult {
	if congruentAtLeast(0x1004, cast(uint64, 0x401000), 0x1000) != 0x2000 {
		return fail("0x1004 vs page-aligned vaddr should round to 0x2000")
	}
	if congruentAtLeast(0x1000, cast(uint64, 0x400000), 0x1000) != 0x1000 {
		return fail("an already-congruent offset at the boundary should stay")
	}
	if congruentAtLeast(0x1004, cast(uint64, 0x400080), 0x1000) != 0x1080 {
		return fail("a non-page-aligned vaddr should land at the 0x80 slot of the current page")
	}
	return ""
}

// A read-only/exec .text and a read-only .rodata, contiguous, coalesce into ONE
// segment (same writability, same delta, no region gap); its flags union to R+X.
func TestDeriveSegmentsRoCoalesce() testing.TestResult {
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	secs[0] = mkSecLma(".text", SF_READ | SF_EXEC, cast(uint64, 0x1000), cast(uint64, 0x1000),
			make_slice(uint8, 4), cast(uint64, 0x100))
	secs[1] = mkSecLma(".rodata", SF_READ, cast(uint64, 0x1100), cast(uint64, 0x1100),
			make_slice(uint8, 4), cast(uint64, 0x10))
	var segs @[]outSeg = deriveSegments(secs)
	if len(segs) != 1 { return fail("contiguous RO sections should be one segment") }
	if (segs[0].Flags & PF_R) == 0 || (segs[0].Flags & PF_X) == 0 {
		return fail("the coalesced segment should be R+X")
	}
	if (segs[0].Flags & PF_W) != 0 { return fail("an RO segment must not be writable") }
	if segs[0].MemSz != 0x110 { return fail("memsz should span .text start to .rodata end") }
	return ""
}

// Read-only .text then read-write .data split on writability (W^X): two segments, the
// second R+W, and .bss (no file bytes) extends the RW segment's memsz past its filesz.
func TestDeriveSegmentsWxSplit() testing.TestResult {
	var secs @[]OutputSection = make_slice(OutputSection, 3)
	secs[0] = mkSecLma(".text", SF_READ | SF_EXEC, cast(uint64, 0x1000), cast(uint64, 0x1000),
			make_slice(uint8, 8), cast(uint64, 8))
	secs[1] = mkSecLma(".data", SF_READ | SF_WRITE, cast(uint64, 0x2000), cast(uint64, 0x2000),
			make_slice(uint8, 4), cast(uint64, 4))
	secs[2] = mkSecLma(".bss", SF_READ | SF_WRITE, cast(uint64, 0x2004), cast(uint64, 0x2004),
			make_slice(uint8, 0), cast(uint64, 16))
	var segs @[]outSeg = deriveSegments(secs)
	if len(segs) != 2 { return fail("RO + RW should split into two segments") }
	if (segs[1].Flags & PF_W) == 0 || (segs[1].Flags & PF_X) != 0 {
		return fail("the second segment should be R+W, not executable")
	}
	if segs[1].FileSz != 4 { return fail("the RW filesz should count only .data's bytes") }
	if segs[1].MemSz != 4 + 16 { return fail("the RW memsz should include .bss") }
	return ""
}

// A ROM-copy .data (runs in RAM, loads from flash) has a different VMA−LMA delta than
// .text (loads and runs in flash), so it forms its own segment carrying p_paddr in
// flash and p_vaddr in RAM.
func TestDeriveSegmentsRomCopy() testing.TestResult {
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	secs[0] = mkSecLma(".text", SF_READ | SF_EXEC, cast(uint64, 0x08000000), cast(uint64, 0x08000000),
			make_slice(uint8, 4), cast(uint64, 4))
	secs[1] = mkSecLma(".data", SF_READ | SF_WRITE, cast(uint64, 0x20000000), cast(uint64, 0x08000004),
			make_slice(uint8, 4), cast(uint64, 4))
	var segs @[]outSeg = deriveSegments(secs)
	if len(segs) != 2 { return fail("a ROM-copy .data should be its own segment") }
	if segs[1].Vaddr != cast(uint64, 0x20000000) { return fail(".data vaddr should be its RAM VMA") }
	if segs[1].Paddr != cast(uint64, 0x08000004) { return fail(".data paddr should be its flash LMA") }
	return ""
}

// Two same-permission sections separated by more than a page (distinct memory
// regions) split into two segments, so the file is not inflated across the gap.
func TestDeriveSegmentsRegionGap() testing.TestResult {
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	secs[0] = mkSecLma(".a", SF_READ | SF_WRITE, cast(uint64, 0x1000), cast(uint64, 0x1000),
			make_slice(uint8, 4), cast(uint64, 4))
	secs[1] = mkSecLma(".b", SF_READ | SF_WRITE, cast(uint64, 0x100000), cast(uint64, 0x100000),
			make_slice(uint8, 4), cast(uint64, 4))
	var segs @[]outSeg = deriveSegments(secs)
	if len(segs) != 2 { return fail("a >page LMA gap should split into two segments") }
	return ""
}

// EmitElfExec on a ROM-copy layout writes a data PT_LOAD whose p_paddr (flash load
// address) differs from its p_vaddr (RAM run address), while the text segment keeps
// p_paddr == p_vaddr.  The file packs both regions compactly (no 0x18000000-byte gap).
func TestEmitElfExecLmaNeVma() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 4)
	dt[0] = 0xc3
	var dd @[]uint8 = make_slice(uint8, 4)
	dd[0] = 0x11
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	secs[0] = mkSecLma(".text", SF_READ | SF_EXEC, cast(uint64, 0x08000000), cast(uint64, 0x08000000),
			dt, cast(uint64, 4))
	secs[1] = mkSecLma(".data", SF_READ | SF_WRITE, cast(uint64, 0x20000000), cast(uint64, 0x08000004),
			dd, cast(uint64, 4))
	if len(EmitElfExec(secs, cast(uint64, 0x08000000), EM_AARCH64, "/tmp/binate_link_lma")) != 0 {
		return fail("emit failed")
	}
	data, ok := readFile("/tmp/binate_link_lma")
	if !ok { return fail("cannot read the emitted executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	if u16(r, 56) != 2 { return fail("text + rom-copy data should emit two segments") }
	// Segment 0 (.text): p_paddr == p_vaddr (delta 0).
	if u64(r, 64 + 16) != u64(r, 64 + 24) { return fail("text segment: paddr should equal vaddr") }
	// Segment 1 (.data): p_vaddr in RAM, p_paddr in flash.
	if u64(r, 64 + 56 + 16) != cast(int64, 0x20000000) { return fail(".data p_vaddr should be RAM") }
	if u64(r, 64 + 56 + 24) != cast(int64, 0x08000004) { return fail(".data p_paddr should be flash") }
	// Compact file: well under a megabyte, not the ~400MB an LMA==VMA packing would need.
	if len(data) > 0x10000 { return fail("the file should pack compactly, not span the region gap") }
	return ""
}

// A section whose LOAD address is in the first page (below the header prefix), even
// though its run address has room, is rejected: the lowest-LMA segment backs its
// p_paddr up by dataStart, so a too-low LMA would underflow it.  Guarding the VMA
// alone (which has headroom here) would let that garbage p_paddr through silently.
func TestEmitElfExecLowLmaRejected() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 4)
	var secs @[]OutputSection = make_slice(OutputSection, 1)
	// Runs at 0x8000 (room for the header), but loads at 0 (no room below it).
	secs[0] = mkSecLma(".text", SF_READ | SF_EXEC, cast(uint64, 0x8000), cast(uint64, 0), d,
			cast(uint64, 4))
	if len(EmitElfExec(secs, cast(uint64, 0x8000), EM_X86_64, "/tmp/binate_link_lowlma")) == 0 {
		return fail("a load address below the header prefix should be rejected")
	}
	return ""
}

// A truly-empty section (a scripted driver's .rodata/.data/.bss whose Place globs matched
// nothing) produces no segment — no degenerate empty PT_LOAD.  A .bss that reserves memory
// (Size>0, no data) is NOT empty and is kept (covered by TestDeriveSegmentsWxSplit).
func TestDeriveSegmentsSkipsEmptySections() testing.TestResult {
	var secs @[]OutputSection = make_slice(OutputSection, 3)
	secs[0] = mkSecLma(".text", SF_READ | SF_EXEC, cast(uint64, 0x1000), cast(uint64, 0x1000),
			make_slice(uint8, 4), cast(uint64, 4))
	secs[1] = mkSecLma(".rodata", SF_READ, cast(uint64, 0x1004), cast(uint64, 0x1004),
			make_slice(uint8, 0), cast(uint64, 0)) // empty
	secs[2] = mkSecLma(".data", SF_READ | SF_WRITE, cast(uint64, 0x2000), cast(uint64, 0x2000),
			make_slice(uint8, 0), cast(uint64, 0)) // empty
	var segs @[]outSeg = deriveSegments(secs)
	if len(segs) != 1 { return fail("empty sections should not create segments") }
	if (segs[0].Flags & PF_W) != 0 { return fail("only the RO .text segment should remain") }
	return ""
}

// EmitElfExec on sections that are all empty has no loadable content and errors rather
// than indexing an empty segment list.
func TestEmitElfExecAllEmptyErrors() testing.TestResult {
	var secs @[]OutputSection = make_slice(OutputSection, 1)
	secs[0] = mkSecLma(".bss", SF_READ | SF_WRITE, cast(uint64, 0x1000), cast(uint64, 0x1000),
			make_slice(uint8, 0), cast(uint64, 0))
	if len(EmitElfExec(secs, cast(uint64, 0), EM_X86_64, "/tmp/binate_link_allempty")) == 0 {
		return fail("an all-empty layout should be rejected")
	}
	return ""
}
