package "pkg/binate/link"

import "pkg/binate/buf"

// Patching the AArch64 GOT relocations.  slot reports that the target address s is a GOT
// slot — a dynamic import's, an absolute symbol's in a position-independent output, or a
// linker-made one (got.bn) — whose contents the instruction reaches; without one, only a
// relaxable reference gets here (ADR_GOT_PAGE, LD64_GOT_LO12_NC on a 64-bit LDR), and it
// is relaxed to the symbol's own address.  A slot holds its symbol plus any addend, so a
// reference reaching one carries no addend of its own (a nonzero one is an internal
// error: it would select a neighbouring slot).

// gotSlotAddendErr returns the internal error for a reference to symName that reaches a
// slot with an addend.
func gotSlotAddendErr(symName *[]readonly char) @[]readonly char {
	return buf.Concat("internal error: a GOT reference with an addend reached the slot of ", symName)
}

// patchLd64GotLo12 applies LD64_GOT_LO12_NC at byteLoc of data: reaching a slot, the
// transfer — any 8-byte one: LDR / STR of X or D, PRFM — keeps pointing at it, the slot's
// low 12 bits scaled by 8 into the imm12; otherwise the 64-bit LDR is rewritten into an
// ADD of the low 12 bits of S + A, with the same registers.
func patchLd64GotLo12(data @[]uint8, byteLoc int, addend int, s uint64, symName *[]readonly char,
		objPath *[]readonly char, slot bool) @[]readonly char {
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	var insn int64 = u32(r, byteLoc)
	if slot {
		if !isGotSlotTransferWord(insn) {
			return buf.Concat("unsupported GOT-slot transfer (an 8-byte ldr / str or prfm) in ", objPath)
		}
		if addend != 0 { return gotSlotAddendErr(symName) }
		patch32Field(data, byteLoc, 0xfff << 10, cast(int, (s & 0xfff) >> 3), 10)
		return ""
	}
	if !isLd64GotWord(insn) {
		return buf.Concat("unsupported GOT-load form (only 64-bit ldr) in ", objPath)
	}
	var rd int = cast(int, insn & 0x1f)
	var rn int = cast(int, (insn >> 5) & 0x1f)
	var imm12 int = cast(int, (cast(int64, s) + cast(int64, addend)) & 0xfff)
	writeU32(data, byteLoc, 0x91000000 | cast(int64, (imm12 << 10) | (rn << 5) | rd))
	return ""
}

// patchGotLdPrel19 applies GOT_LD_PREL19 at byteLoc: the literal load's (LDR of any
// register, LDRSW, PRFM) imm19 gets the word displacement from P to the slot s (±1 MB).
// Returns "" or an error.
func patchGotLdPrel19(data @[]uint8, byteLoc int, addend int, s uint64, p uint64,
		symName *[]readonly char, slot bool) @[]readonly char {
	if !slot { return buf.Concat("internal error: no GOT slot for the literal load of ", symName) }
	if addend != 0 { return gotSlotAddendErr(symName) }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	if (u32(r, byteLoc) & 0x3b000000) != 0x18000000 {
		return buf.Concat("GOT_LD_PREL19 on an instruction other than a literal load for ", symName)
	}
	var v int64 = cast(int64, s) - cast(int64, p)
	if (v & 3) != 0 { return buf.Concat("misaligned GOT literal load for ", symName) }
	if v > 0xffffc || v < (0 - 0x100000) {
		return buf.Concat("GOT literal load out of range for ", symName)
	}
	patch32Field(data, byteLoc, 0x7ffff << 5, cast(int, (v >> 2) & 0x7ffff), 5)
	return ""
}

// patchGotPageLo15 applies LD64_GOTPAGE_LO15 at byteLoc: the 8-byte transfer's imm12 gets
// the slot s's offset from the page of the GOT's start gotBase (haveBase false: the link
// has no GOT), scaled by 8 — an offset below 32 KB.  Returns "" or an error.
func patchGotPageLo15(data @[]uint8, byteLoc int, addend int, s uint64, gotBase uint64,
		haveBase bool, symName *[]readonly char, objPath *[]readonly char, slot bool) @[]readonly char {
	if !slot || !haveBase {
		return buf.Concat("internal error: no GOT slot for the GOT-page offset of ", symName)
	}
	if addend != 0 { return gotSlotAddendErr(symName) }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	if !isGotSlotTransferWord(u32(r, byteLoc)) {
		return buf.Concat("unsupported GOT-slot transfer (an 8-byte ldr / str or prfm) in ", objPath)
	}
	var pageMask int64 = 0 - 0x1000
	var v int64 = cast(int64, s) - (cast(int64, gotBase) & pageMask)
	if v < 0 || v >= 0x8000 || (v & 7) != 0 {
		return buf.Concat("GOT-page offset out of range for ", symName)
	}
	patch32Field(data, byteLoc, 0xfff << 10, cast(int, v >> 3), 10)
	return ""
}
