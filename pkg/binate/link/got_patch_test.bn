package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Patching the AArch64 GOT relocations into a slot (or, for a relaxable reference with
// none, into the symbol's own address).  (fail is in parse_elf_test.bn.)

// gotLo12Patch applies LD64_GOT_LO12_NC (addend, S s, slot) to insn, returning the word
// and the error.
func gotLo12Patch(insn int64, addend int, s uint64, slot bool) (int64, @[]readonly char) {
	var d @[]uint8 = make_slice(uint8, 4)
	writeU32(d, 0, insn)
	var e @[]readonly char = patchLd64GotLo12(d, 0, addend, s, "sym", "obj", slot)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = d
	return u32(r, 0), e
}

// Reaching a slot, every 8-byte transfer — LDR / STR of X or D, PRFM — keeps pointing at it
// (the slot's low 12 bits, scaled by 8: 0x412348 → 0x69); a 4-byte one, and an addend, are
// errors.  With no slot, a 64-bit LDR becomes an ADD of S + A's low 12 bits, and a store
// is an error.
func TestPatchLd64GotLo12() testing.TestResult {
	var insns @[]int64 = make_slice(int64, 5)
	insns[0] = 0xf9400020 // ldr x0, [x1]
	insns[1] = 0xf9000020 // str x0, [x1]
	insns[2] = 0xfd400020 // ldr d0, [x1]
	insns[3] = 0xfd000020 // str d0, [x1]
	insns[4] = 0xf9800020 // prfm pldl1keep, [x1]
	for i := 0; i < 5; i++ {
		w, e := gotLo12Patch(insns[i], 0, cast(uint64, 0x412348), true)
		if len(e) != 0 || w != (insns[i] | (0x69 << 10)) { return fail(buf.Concat("slot transfer: ", e)) }
	}
	_, e1 := gotLo12Patch(0xb9400020, 0, cast(uint64, 0x412348), true) // ldr w0, [x1]
	if len(e1) == 0 { return fail("a 4-byte GOT-slot transfer accepted") }
	_, e2 := gotLo12Patch(0xf9400020, 8, cast(uint64, 0x412348), true)
	if len(e2) == 0 { return fail("a slot reached with an addend accepted") }
	w3, e3 := gotLo12Patch(0xf9400020, 8, cast(uint64, 0x412340), false)
	if len(e3) != 0 || w3 != 0x910d2020 {
		return fail("the 64-bit LDR not relaxed to add x0, x1, #0x348")
	}
	_, e4 := gotLo12Patch(0xf9000020, 0, cast(uint64, 0x412340), false)
	if !charsEqual(e4, "unsupported GOT-load form (only 64-bit ldr) in obj") {
		return fail("a store relaxed")
	}
	return ""
}

// gotPrel19Patch applies GOT_LD_PREL19 (addend, slot s, P p, slot) to `ldr x0, <literal>`.
func gotPrel19Patch(addend int, s uint64, p uint64, slot bool) (int64, @[]readonly char) {
	var d @[]uint8 = make_slice(uint8, 4)
	writeU32(d, 0, 0x58000000)
	var e @[]readonly char = patchGotLdPrel19(d, 0, addend, s, p, "sym", slot)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = d
	return u32(r, 0), e
}

// The literal load's imm19 gets the word displacement to the slot, ahead or behind; a
// misaligned or out-of-range one, no slot, or an addend is an error.
func TestPatchGotLdPrel19() testing.TestResult {
	w, e := gotPrel19Patch(0, cast(uint64, 0x401000), cast(uint64, 0x400ff0), true)
	if len(e) != 0 || w != 0x58000080 { return fail(buf.Concat("16 bytes ahead: ", e)) }
	w2, e2 := gotPrel19Patch(0, cast(uint64, 0x400000), cast(uint64, 0x400010), true)
	if len(e2) != 0 || w2 != 0x58ffff80 { return fail(buf.Concat("16 bytes behind: ", e2)) }
	_, e3 := gotPrel19Patch(0, cast(uint64, 0x401002), cast(uint64, 0x400ff0), true)
	if len(e3) == 0 { return fail("a misaligned slot accepted") }
	_, e4 := gotPrel19Patch(0, cast(uint64, 0x500000), cast(uint64, 0x400000), true)
	if len(e4) == 0 { return fail("a slot 1 MB ahead accepted") }
	_, e5 := gotPrel19Patch(0, cast(uint64, 0x401000), cast(uint64, 0x400ff0), false)
	if len(e5) == 0 { return fail("a literal load with no slot accepted") }
	_, e6 := gotPrel19Patch(8, cast(uint64, 0x401000), cast(uint64, 0x400ff0), true)
	if len(e6) == 0 { return fail("a slot reached with an addend accepted") }
	return ""
}

// gotLo15Patch applies LD64_GOTPAGE_LO15 (slot s, GOT start base, haveBase, slot) to insn.
func gotLo15Patch(insn int64, s uint64, base uint64, haveBase bool,
		slot bool) (int64, @[]readonly char) {
	var d @[]uint8 = make_slice(uint8, 4)
	writeU32(d, 0, insn)
	var e @[]readonly char = patchGotPageLo15(d, 0, 0, s, base, haveBase, "sym", "obj", slot)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = d
	return u32(r, 0), e
}

// The 8-byte transfer's imm12 gets the slot's offset from the GOT start's page, scaled by
// 8 (GOT at 0x412010, slot 0x412018: offset 0x18 from page 0x412000, imm12 3); an offset of
// 32 KB or more, or below the page, no GOT or slot, or a 4-byte transfer is an error.
func TestPatchGotPageLo15() testing.TestResult {
	w, e := gotLo15Patch(0xf9400020, cast(uint64, 0x412018), cast(uint64, 0x412010), true, true)
	if len(e) != 0 || w != 0xf9400c20 { return fail(buf.Concat("offset 0x18: ", e)) }
	var bad @[]uint64 = make_slice(uint64, 2)
	bad[0] = 0x41a000
	bad[1] = 0x411ff8
	for i := 0; i < 2; i++ {
		_, eb := gotLo15Patch(0xf9400020, bad[i], cast(uint64, 0x412010), true, true)
		if len(eb) == 0 { return fail("an out-of-range GOT-page offset accepted") }
	}
	_, e2 := gotLo15Patch(0xf9400020, cast(uint64, 0x412018), cast(uint64, 0x412010), false, true)
	if len(e2) == 0 { return fail("a GOT-page offset with no GOT accepted") }
	_, e3 := gotLo15Patch(0xf9400020, cast(uint64, 0x412018), cast(uint64, 0x412010), true, false)
	if len(e3) == 0 { return fail("a GOT-page offset with no slot accepted") }
	_, e4 := gotLo15Patch(0xb9400020, cast(uint64, 0x412018), cast(uint64, 0x412010), true, true)
	if len(e4) == 0 { return fail("a 4-byte GOT-page transfer accepted") }
	return ""
}
