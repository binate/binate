package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Collecting the linker-made GOT slots, before symbols are resolved, and reaching them.
// (fail is in parse_elf_test.bn.)

// gotTestObj returns an AArch64 object whose text section holds the instruction words
// insns, with symbols syms and relocations rels.
func gotTestObj(insns @[]int64, syms @[]InputSymbol, rels @[]InputReloc) @InputObject {
	var o @InputObject = make(InputObject)
	o.Path = "t.o"
	o.Machine = EM_AARCH64
	o.Sections = make_slice(InputSection, 1)
	var data @[]uint8 = make_slice(uint8, 4 * len(insns))
	for i := 0; i < len(insns); i++ { writeU32(data, 4 * i, insns[i]) }
	o.Sections[0] = mkDynSection(".text", SF_READ | SF_EXEC, 4, data)
	o.Symbols = syms
	o.Relocs = rels
	return o
}

// gotTestSym returns a symbol named name, global unless local, defined at offset 0 of the
// text section when defined (else undefined).
func gotTestSym(name *[]readonly char, local bool, defined bool) InputSymbol {
	var s InputSymbol
	s.Name = buf.CopyStr(name)
	s.Binding = BIND_GLOBAL
	if local { s.Binding = 0 }
	s.SecIndex = -1
	if defined { s.SecIndex = 0 }
	return s
}

// gotTestRel returns a relocation of kind against symbol si at word w of the text, with
// addend.
func gotTestRel(w int, si int, kind int, addend int) InputReloc {
	var r InputReloc
	r.SecIndex = 0
	r.Offset = cast(uint, 4 * w)
	r.SymIndex = si
	r.Kind = kind
	r.Addend = addend
	return r
}

// gotTestObjs returns the one-object list o.
func gotTestObjs(o @InputObject) @[]@InputObject {
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = o
	return objs
}

// noImports is an empty import list.
func noImports() @[]@[]char { return make_slice(@[]char, 0) }

// An ADRP / 64-bit LDR GOT pair is relaxed: no slot.  A literal load of g's slot gives g
// one, which g's relaxable pair (same addend) shares; a store through k's page offset gives
// k one per addend its GOT references carry.
func TestCollectGotSlotsUnrelaxable() testing.TestResult {
	var insns @[]int64 = make_slice(int64, 4)
	insns[0] = 0x90000000 // adrp x0, …
	insns[1] = 0xf9400000 // ldr x0, [x0, …]
	insns[2] = 0x58000000 // ldr x0, <literal>
	insns[3] = 0xf9000000 // str x0, [x0, …]
	var syms @[]InputSymbol = make_slice(InputSymbol, 3)
	syms[0] = gotTestSym("g", false, true)
	syms[1] = gotTestSym("h", false, true)
	syms[2] = gotTestSym("k", false, true)
	var rels @[]InputReloc = make_slice(InputReloc, 2)
	rels[0] = gotTestRel(0, 1, R_AARCH64_ADR_GOT_PAGE, 0)
	rels[1] = gotTestRel(1, 1, R_AARCH64_LD64_GOT_LO12_NC, 0)
	if len(collectGotSlots(gotTestObjs(gotTestObj(insns, syms, rels)), noImports())) != 0 {
		return fail("a relaxable GOT pair got a slot")
	}
	var rels2 @[]InputReloc = make_slice(InputReloc, 6)
	rels2[0] = gotTestRel(0, 0, R_AARCH64_ADR_GOT_PAGE, 0)
	rels2[1] = gotTestRel(1, 0, R_AARCH64_LD64_GOT_LO12_NC, 0)
	rels2[2] = gotTestRel(2, 0, R_AARCH64_GOT_LD_PREL19, 0)
	rels2[3] = gotTestRel(0, 2, R_AARCH64_ADR_GOT_PAGE, 8)
	rels2[4] = gotTestRel(3, 2, R_AARCH64_LD64_GOT_LO12_NC, 0)
	rels2[5] = gotTestRel(1, 1, R_AARCH64_LD64_GOT_LO12_NC, 0)
	var slots @[]GotSlot = collectGotSlots(gotTestObjs(gotTestObj(insns, syms, rels2)), noImports())
	if len(slots) != 3 { return fail("not one slot for g and two for k") }
	if !charsEqual(slots[0].Name, "g") || slots[0].Addend != 0 || slots[0].Import {
		return fail("g's slot wrong")
	}
	if !charsEqual(slots[1].Name, "k") || slots[1].Addend != 8 || !charsEqual(slots[2].Name, "k") ||
			slots[2].Addend != 0 {
		return fail("k's slots wrong (addend 8, then 0)")
	}
	return ""
}

// A local symbol's slot is keyed by its object: two objects' locals named L get one each;
// a `:gotpage_lo15:` reference needs a slot.
func TestCollectGotSlotsLocals() testing.TestResult {
	var insns @[]int64 = make_slice(int64, 1)
	insns[0] = 0xf9400000
	var syms @[]InputSymbol = make_slice(InputSymbol, 1)
	syms[0] = gotTestSym("L", true, true)
	var rels @[]InputReloc = make_slice(InputReloc, 1)
	rels[0] = gotTestRel(0, 0, R_AARCH64_LD64_GOTPAGE_LO15, 0)
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = gotTestObj(insns, syms, rels)
	objs[1] = gotTestObj(insns, syms, rels)
	var slots @[]GotSlot = collectGotSlots(objs, noImports())
	if len(slots) != 2 || len(slots[0].Name) != 0 || slots[0].ObjIdx != 0 || slots[1].ObjIdx != 1 {
		return fail("not a slot per object's local L")
	}
	return ""
}

// A GOT reference to a dynamic import uses the import's own slot — with no addend, however
// it is made (a literal load included) — and one with an addend gets an import slot per
// addend, which the loader fills.
func TestCollectGotSlotsImports() testing.TestResult {
	var insns @[]int64 = make_slice(int64, 3)
	insns[0] = 0x90000000
	insns[1] = 0xf9400000
	insns[2] = 0x58000000
	var syms @[]InputSymbol = make_slice(InputSymbol, 1)
	syms[0] = gotTestSym("imp", false, false)
	var rels @[]InputReloc = make_slice(InputReloc, 4)
	rels[0] = gotTestRel(0, 0, R_AARCH64_ADR_GOT_PAGE, 8)
	rels[1] = gotTestRel(1, 0, R_AARCH64_LD64_GOT_LO12_NC, 8)
	rels[2] = gotTestRel(2, 0, R_AARCH64_GOT_LD_PREL19, 0)
	rels[3] = gotTestRel(1, 0, R_AARCH64_LD64_GOT_LO12_NC, 0)
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = "imp"
	var slots @[]GotSlot = collectGotSlots(gotTestObjs(gotTestObj(insns, syms, rels)), imports)
	if len(slots) != 1 || !slots[0].Import || slots[0].Addend != 8 ||
			!charsEqual(slots[0].Name, "imp") {
		return fail("not exactly one import slot, for imp + 8")
	}
	return ""
}

// `_GLOBAL_OFFSET_TABLE_` is the linker's when a global reference to it is undefined in
// every object; an object's own definition keeps it, and a local of that name is not one.
func TestGotSymbolReferenced() testing.TestResult {
	var insns @[]int64 = make_slice(int64, 1)
	insns[0] = 0x90000000
	var use @[]InputSymbol = make_slice(InputSymbol, 1)
	use[0] = gotTestSym("_GLOBAL_OFFSET_TABLE_", false, false)
	var user @InputObject = gotTestObj(insns, use, make_slice(InputReloc, 0))
	if !gotSymbolReferenced(gotTestObjs(user)) { return fail("an undefined reference not seen") }
	var def @[]InputSymbol = make_slice(InputSymbol, 1)
	def[0] = gotTestSym("_GLOBAL_OFFSET_TABLE_", false, true)
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = user
	objs[1] = gotTestObj(insns, def, make_slice(InputReloc, 0))
	if gotSymbolReferenced(objs) { return fail("an object's definition overridden") }
	var loc @[]InputSymbol = make_slice(InputSymbol, 1)
	loc[0] = gotTestSym("_GLOBAL_OFFSET_TABLE_", true, false)
	if gotSymbolReferenced(gotTestObjs(gotTestObj(insns, loc, make_slice(InputReloc, 0)))) {
		return fail("a local taken for a reference")
	}
	return ""
}

// For a sliding (Mach-O) image, an absolute symbol's slot is dropped (it has its own,
// unrebased) and only an in-image symbol's slot is a rebase site; an import slot (an
// addend on a Mach-O GOT reference) is an internal error.
func TestInImageGotSlots() testing.TestResult {
	var insns @[]int64 = make_slice(int64, 1)
	insns[0] = 0x58000000
	var syms @[]InputSymbol = make_slice(InputSymbol, 2)
	syms[0] = gotTestSym("g", false, true)
	syms[1] = gotTestSym("A", false, true)
	syms[1].SecIndex = -1
	syms[1].Abs = true
	syms[1].AbsValue = cast(uint64, 0x1234)
	var rels @[]InputReloc = make_slice(InputReloc, 2)
	rels[0] = gotTestRel(0, 0, R_AARCH64_GOT_LD_PREL19, 0)
	rels[1] = gotTestRel(0, 1, R_AARCH64_GOT_LD_PREL19, 0)
	var objs @[]@InputObject = gotTestObjs(gotTestObj(insns, syms, rels))
	var all @[]GotSlot = collectGotSlots(objs, noImports())
	if len(all) != 2 { return fail("not a slot each for g and A") }
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return fail(buf.Concat("resolve: ", rerr)) }
	slots, err := inImageGotSlots(t, all)
	if len(err) != 0 || len(slots) != 1 || !charsEqual(slots[0].Name, "g") {
		return fail("the absolute symbol's slot kept")
	}
	slots[0].Addr = cast(uint64, 0x5000)
	t.GotSlots = all
	t.GotSlots[0].Addr = cast(uint64, 0x5000)
	t.GotSlots[1].Addr = cast(uint64, 0x5008)
	var sites @[]uint64 = gotSlotRebaseSites(t)
	if len(sites) != 1 || sites[0] != 0x5000 { return fail("not exactly g's slot rebased") }
	all[0].Import = true
	_, ierr := inImageGotSlots(t, all)
	if len(ierr) == 0 { return fail("an import slot accepted for a Mach-O link") }
	return ""
}

// Relocate points a GOT reference with an addend to an import at the import slot for that
// addend, carrying no addend into it (the slot holds the import plus 8); one with no such
// slot is an error, not the import's own slot plus 8.
func TestRelocateImportAddendSlot() testing.TestResult {
	var insns @[]int64 = make_slice(int64, 1)
	insns[0] = 0xf9400000 // ldr x0, [x0]
	var syms @[]InputSymbol = make_slice(InputSymbol, 2)
	syms[0] = gotTestSym("imp", false, false)
	syms[1] = gotTestSym("imp", false, true) // the import's own slot (the stubs' definition)
	var rels @[]InputReloc = make_slice(InputReloc, 1)
	rels[0] = gotTestRel(0, 0, R_AARCH64_LD64_GOT_LO12_NC, 8)
	var prog @InputObject = gotTestObj(insns, syms[0:1], rels)
	var stubs @InputObject = gotTestObj(make_slice(int64, 4), syms[1:2], make_slice(InputReloc, 0))
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = prog
	objs[1] = stubs
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = "imp"
	var slots @[]GotSlot = collectGotSlots(objs[0:1], imports)
	if len(slots) != 1 { return fail("no import slot for imp + 8") }
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return fail(buf.Concat("resolve: ", rerr)) }
	t.GotImports = imports
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	var bare @[]readonly char = Relocate(t, lr)
	if len(bare) == 0 { return fail("an addend into the import's own slot accepted") }
	slots[0].Addr = cast(uint64, 0x412348)
	t.GotSlots = slots
	if len(Relocate(t, lr)) != 0 { return fail("relocate failed") }
	word, _, ok := fieldWord(prog, lr, "imp", R_AARCH64_LD64_GOT_LO12_NC)
	if !ok || word != (0xf9400000 | (0x69 << 10)) {
		return fail("the load does not read the import slot")
	}
	return ""
}

// A local symbol and a global of the same name are different slots, keyed by object and
// by name.
func TestCollectGotSlotsLocalVsGlobal() testing.TestResult {
	var insns @[]int64 = make_slice(int64, 1)
	insns[0] = 0x58000000
	var loc @[]InputSymbol = make_slice(InputSymbol, 1)
	loc[0] = gotTestSym("g", true, true)
	var glob @[]InputSymbol = make_slice(InputSymbol, 1)
	glob[0] = gotTestSym("g", false, true)
	var rels @[]InputReloc = make_slice(InputReloc, 1)
	rels[0] = gotTestRel(0, 0, R_AARCH64_GOT_LD_PREL19, 0)
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = gotTestObj(insns, loc, rels)
	objs[1] = gotTestObj(insns, glob, rels)
	var slots @[]GotSlot = collectGotSlots(objs, noImports())
	if len(slots) != 2 || len(slots[0].Name) != 0 || !charsEqual(slots[1].Name, "g") {
		return fail("the local g and the global g share a slot")
	}
	return ""
}

// A slot holds the definition the symbol table chose: a weak w overridden by a strong one
// in another object gets the strong one's address.
func TestLinkStaticGotSlotFollowsStrong() testing.TestResult {
	var insns @[]int64 = make_slice(int64, 1)
	insns[0] = 0x58000000
	var weak @[]InputSymbol = make_slice(InputSymbol, 1)
	weak[0] = gotTestSym("w", false, true)
	weak[0].Binding = BIND_WEAK
	var rels @[]InputReloc = make_slice(InputReloc, 1)
	rels[0] = gotTestRel(0, 0, R_AARCH64_GOT_LD_PREL19, 0)
	var strong @[]InputSymbol = make_slice(InputSymbol, 1)
	strong[0] = gotTestSym("w", false, true)
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = gotTestObj(insns, weak, rels)
	objs[1] = gotTestObj(make_slice(int64, 2), strong, make_slice(InputReloc, 0))
	t, lr, gotObj, lerr := layoutStatic(objs, EM_AARCH64, cast(uint64, 0x400000))
	if len(lerr) != 0 || !present(gotObj) { return fail("no GOT laid out") }
	if len(relocateStatic(t, lr, gotObj)) != 0 { return fail("relocate failed") }
	strongAt, _ := definedAddr(t, lr, 1, 0)
	gotData, gotOff := outData(gotObj, lr, 0)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var d *[]readonly uint8 = gotData
	if cast(uint64, u64(d, gotOff)) != strongAt { return fail("the slot holds the weak definition") }
	return ""
}

// A local symbol named like a dynamic data import is its object's own: its relaxable GOT
// pair is relaxed to its address (an ADD), not kept loading from the import's slot.
func TestRelocateLocalNamedLikeImport() testing.TestResult {
	var insns @[]int64 = make_slice(int64, 2)
	insns[0] = 0x90000000 // adrp x0, …
	insns[1] = 0xf9400000 // ldr x0, [x0, …]
	var syms @[]InputSymbol = make_slice(InputSymbol, 1)
	syms[0] = gotTestSym("environ", true, true)
	var rels @[]InputReloc = make_slice(InputReloc, 2)
	rels[0] = gotTestRel(0, 0, R_AARCH64_ADR_GOT_PAGE, 0)
	rels[1] = gotTestRel(1, 0, R_AARCH64_LD64_GOT_LO12_NC, 0)
	var prog @InputObject = gotTestObj(insns, syms, rels)
	var objs @[]@InputObject = gotTestObjs(prog)
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return fail(buf.Concat("resolve: ", rerr)) }
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = "environ"
	t.GotImports = imports
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) != 0 { return fail("relocate failed") }
	word, _, ok := fieldWord(prog, lr, "environ", R_AARCH64_LD64_GOT_LO12_NC)
	if !ok || (word & 0xff800000) != 0x91000000 { return fail("the local's GOT load kept as a load") }
	return ""
}
