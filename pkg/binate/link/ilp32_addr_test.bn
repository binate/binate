package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// ILP32 address-arithmetic guard.  These tests exercise the paths where a 64-bit
// target address (> 2^32) must survive on a host whose `int`/`uint` are only 32 bits
// (arm32): a truncating regression would zero the high dword and fail here.  On a
// 64-bit host they pass trivially; the meaningful runs are the 32-bit-host lanes
// (builder-comp_arm32_linux), plus builder-comp_arm32_baremetal in isolation — these
// are the only link tests that need no filesystem, so they are the sole part of the
// package that a semihosting (no-FS) baremetal run can execute.  Self-contained
// (own helpers) so they need nothing from the filesystem-using test files.

// ilFail wraps a failure message as a TestResult (empty string = pass).
func ilFail(msg @[]char) testing.TestResult { return msg }

// ilMkSection builds a synthetic InputSection (no relocs/symbols).
func ilMkSection(name *[]readonly char, flags int, data @[]uint8, size uint) InputSection {
	var sec InputSection
	sec.Name = buf.CopyStr(name)
	sec.Flags = flags
	sec.Type = SHT_PROGBITS
	sec.Data = data
	sec.Size = size
	sec.Align = 1
	sec.OutIndex = -1
	sec.OutOffset = cast(uint, 0)
	return sec
}

// ilMkObj builds an InputObject with one section and no symbols/relocs.
func ilMkObj(sec InputSection) @InputObject {
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = sec
	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr("x.o")
	obj.Machine = EM_X86_64
	obj.Sections = secs
	obj.Symbols = make_slice(InputSymbol, 0)
	obj.Relocs = make_slice(InputReloc, 0)
	return obj
}

// writeU64 must store all 8 bytes of a value whose high dword is non-zero — the byte
// writer used for every 64-bit address field (segment vmaddr, p_vaddr, ABS64, r_offset).
func TestILP32WriteU64() testing.TestResult {
	var b @[]uint8 = make_slice(uint8, 8)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = b
	writeU64(b, 0, cast(uint64, 0x1122334455667788))
	if u32(r, 0) != 0x55667788 { return ilFail("writeU64 low dword wrong") }
	if u32(r, 4) != 0x11223344 { return ilFail("writeU64 high dword truncated (ILP32 regression)") }
	return ""
}

// R_AARCH64_ABS64 with a target address above 4 GB: the stored pointer must be the full
// 64-bit S+A.  If s were carried in a 32-bit int/uint, the high dword would be zero.
func TestILP32Abs64Over4GB() testing.TestResult {
	var data @[]uint8 = make_slice(uint8, 8)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	var e @[]readonly char = patchAArch64(data, 0, R_AARCH64_ABS64, 0x24, cast(uint64, 0x100002000),
			cast(uint64, 0), "sym", "obj", false)
	if len(e) != 0 { return ilFail("patchAArch64 ABS64 returned an error") }
	if u32(r, 0) != 0x00002024 { return ilFail("ABS64 low dword wrong") }
	if u32(r, 4) != 0x00000001 { return ilFail("ABS64 high dword truncated (ILP32 regression)") }
	return ""
}

// Layout must carry a > 4 GB load base through to each output section address unchanged.
// 0x100004000 is cmd/bnld's machoBase; as a 32-bit uint it would truncate to 0x4000.
func TestILP32Layout4GBBase() testing.TestResult {
	var da @[]uint8 = make_slice(uint8, 2)
	da[0] = 0x90
	da[1] = 0x90
	var db @[]uint8 = make_slice(uint8, 1)
	db[0] = 0xc3
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = ilMkObj(ilMkSection(".text", SF_READ | SF_EXEC, da, cast(uint, 2)))
	objs[1] = ilMkObj(ilMkSection(".text", SF_READ | SF_EXEC, db, cast(uint, 1)))
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x100004000))
	if len(lr.Sections) != 1 { return ilFail("expected one merged .text section") }
	if lr.Sections[0].Addr != cast(uint64, 0x100004000) {
		return ilFail(".text base truncated below 4 GB (ILP32 regression)")
	}
	if objs[1].Sections[0].OutOffset != cast(uint, 2) {
		return ilFail("second .text merged at the wrong offset")
	}
	return ""
}

// patch32Field's 0xffffffff mask must be computed in a 64-bit word: on ILP32 a plain
// `int` mask overflows and the field write is wrong.  Clearing imm26 of an all-ones
// word must leave exactly the top 6 bits set (0xFC000000).
func TestILP32Patch32FieldMask() testing.TestResult {
	var data @[]uint8 = make_slice(uint8, 4)
	for i := 0; i < 4; i++ { data[i] = 0xff }
	patch32Field(data, 0, 0x3ffffff, 0, 0) // clear the low 26 bits
	if data[0] != 0x00 || data[1] != 0x00 || data[2] != 0x00 || data[3] != 0xfc {
		return ilFail("patch32Field mask overflowed (ILP32 regression)")
	}
	return ""
}
