package "pkg/binate/link"

import "pkg/binate/buf"

// The init / fini / preinit arrays of an ELF link: their inputs placed in priority order, the
// symbols bracketing them (`__init_array_start` / `__init_array_end` and the preinit / fini
// pairs, which start code walks), and the dynamic tags (DT_INIT_ARRAY / DT_INIT_ARRAYSZ …)
// through which the dynamic loader and libc's start code run them.

// arraySymbolCount is the number of bracketing symbols: a start and an end for each array.
const arraySymbolCount int = 6

// arraySymbolName returns bracketing symbol i (0..5): the preinit, init and fini arrays'
// start and end, in that order.
func arraySymbolName(i int) *[]readonly char {
	if i == 0 { return "__preinit_array_start" }
	if i == 1 { return "__preinit_array_end" }
	if i == 2 { return "__init_array_start" }
	if i == 3 { return "__init_array_end" }
	if i == 4 { return "__fini_array_start" }
	return "__fini_array_end"
}

// initFiniPriority returns the priority of an init / fini array input named name, whose plain
// name is base: N for `base.N`, 65536 (the default, after every numbered one) for base itself
// or any other suffix — lld's order.
func initFiniPriority(name *[]readonly char, base *[]readonly char) int {
	if len(name) <= len(base) + 1 || !charsEqual(name[0:len(base)], base) || name[len(base)] != '.' {
		return 65536
	}
	var v int = 0
	for i := len(base) + 1; i < len(name); i++ {
		if name[i] < '0' || name[i] > '9' || v > 65536 { return 65536 }
		v = v * 10 + cast(int, name[i] - '0')
	}
	return v
}

// placeArrayByPriority places the inputs of array kind k (named base, `base.N` for a
// priority) at the end of the kind (placeInKind), in ascending priority, inputs of one
// priority in input order.
func placeArrayByPriority(objs @[]@InputObject, k int, base *[]readonly char, kindSize @[]int,
		kindAlign @[]int) {
	var n int = 0
	for o := 0; o < len(objs); o++ {
		for s := 0; s < len(objs[o].Sections); s++ {
			if objs[o].Sections[s].OutIndex == k { n = n + 1 }
		}
	}
	var objIdx @[]int = make_slice(int, n)
	var secIdx @[]int = make_slice(int, n)
	var prio @[]int = make_slice(int, n)
	var m int = 0
	for o := 0; o < len(objs); o++ {
		for s := 0; s < len(objs[o].Sections); s++ {
			if objs[o].Sections[s].OutIndex != k { continue }
			// Insertion keeps it stable: an input goes after every one of no greater priority.
			var p int = initFiniPriority(objs[o].Sections[s].Name, base)
			var j int = m
			for j > 0 && prio[j - 1] > p {
				objIdx[j] = objIdx[j - 1]
				secIdx[j] = secIdx[j - 1]
				prio[j] = prio[j - 1]
				j = j - 1
			}
			objIdx[j] = o
			secIdx[j] = s
			prio[j] = p
			m = m + 1
		}
	}
	for i := 0; i < n; i++ { placeInKind(objs[objIdx[i]], secIdx[i], k, kindSize, kindAlign) }
}

// referencedArraySymbols returns, as layout-defined absolute symbols (values set after layout
// by setArraySymbols), the bracketing symbols some object refers to and none defines.
func referencedArraySymbols(objs @[]@InputObject) @[]AbsSym {
	var used @[]bool = make_slice(bool, arraySymbolCount)
	var n int = 0
	for i := 0; i < arraySymbolCount; i++ {
		var refd bool = false
		var defd bool = false
		for o := 0; o < len(objs); o++ {
			for j := 0; j < len(objs[o].Symbols); j++ {
				var sym InputSymbol = objs[o].Symbols[j]
				if isLocalSymbol(sym) || !charsEqual(sym.Name, arraySymbolName(i)) { continue }
				if sym.SecIndex >= 0 || sym.Abs {
					defd = true
				} else {
					refd = true
				}
			}
		}
		used[i] = refd && !defd
		if used[i] { n = n + 1 }
	}
	var abs @[]AbsSym = make_slice(AbsSym, n)
	var k int = 0
	for i := 0; i < arraySymbolCount; i++ {
		if !used[i] { continue }
		abs[k].Name = buf.CopyStr(arraySymbolName(i))
		k = k + 1
	}
	return abs
}

// setArraySymbols gives each bracketing symbol in t.Abs its address in lr.
func setArraySymbols(t @SymbolTable, lr @LayoutResult) {
	for i := 0; i < arraySymbolCount; i++ {
		var a uint64 = lr.ArrayStart[i / 2]
		if (i & 1) != 0 { a = lr.ArrayEnd[i / 2] }
		setAbsValue(t, arraySymbolName(i), a)
	}
}

// arrayTagCount returns the number of .dynamic entries the arrays of objs need: a pair
// (address, size) for each array some input is non-empty in.
func arrayTagCount(objs @[]@InputObject) int {
	var n int = 0
	for k := kindPreinitArray; k <= kindFiniArray; k++ {
		var used bool = false
		for o := 0; o < len(objs); o++ {
			for s := 0; s < len(objs[o].Sections); s++ {
				var sec InputSection = objs[o].Sections[s]
				if kindOf(sec.Flags, sec.Type) == k && sec.Size > 0 { used = true }
			}
		}
		if used { n = n + 2 }
	}
	return n
}

// writeArrayTags writes, from offset d of dynData, the .dynamic pairs for lr's non-empty
// arrays — DT_PREINIT_ARRAY / DT_PREINIT_ARRAYSZ, DT_INIT_ARRAY / DT_INIT_ARRAYSZ,
// DT_FINI_ARRAY / DT_FINI_ARRAYSZ — and returns the offset after them (arrayTagCount entries).
func writeArrayTags(dynData @[]uint8, d int, lr @LayoutResult) int {
	for i := 0; i < 3; i++ {
		var size uint64 = lr.ArrayEnd[i] - lr.ArrayStart[i]
		if size == 0 { continue }
		var tag int = DT_PREINIT_ARRAY
		var sizeTag int = DT_PREINIT_ARRAYSZ
		if i == 1 {
			tag = DT_INIT_ARRAY
			sizeTag = DT_INIT_ARRAYSZ
		} else if i == 2 {
			tag = DT_FINI_ARRAY
			sizeTag = DT_FINI_ARRAYSZ
		}
		writeDyn(dynData, d, tag, lr.ArrayStart[i])
		writeDyn(dynData, d + 16, sizeTag, size)
		d = d + 32
	}
	return d
}
