package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/elf"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// An init / fini array input's priority is its `.N` suffix; the plain name and any other
// suffix take 65536, after every numbered one.
func TestInitFiniPriority() testing.TestResult {
	if initFiniPriority(".init_array", ".init_array") != 65536 { return fail("plain name") }
	if initFiniPriority(".init_array.101", ".init_array") != 101 { return fail(".101") }
	if initFiniPriority(".init_array.00065", ".init_array") != 65 { return fail(".00065") }
	if initFiniPriority(".init_array.x1", ".init_array") != 65536 { return fail("non-numeric suffix") }
	if initFiniPriority(".fini_array.7", ".fini_array") != 7 { return fail(".fini_array.7") }
	if initFiniPriority(".init_array.", ".init_array") != 65536 { return fail("empty suffix") }
	return ""
}

// arrSec returns an 8-byte array input of type stype named name, filled with tag.
func arrSec(name *[]readonly char, stype int, tag uint8) InputSection {
	var d @[]uint8 = make_slice(uint8, 8)
	for i := 0; i < 8; i++ { d[i] = tag }
	return mkSection(name, SF_READ | SF_WRITE, stype, d, cast(uint, 8), 8)
}

// The arrays open the writable group, before .data, in the order preinit / init / fini;
// .init_array's inputs go in ascending priority (input order within one); ArrayStart /
// ArrayEnd hold each array's range, start == end for an empty one.
func TestLayoutPlacesArrays() testing.TestResult {
	var secsA @[]InputSection = make_slice(InputSection, 4)
	secsA[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, make_slice(uint8, 4), cast(uint, 4),
			4)
	secsA[1] = arrSec(".init_array.200", SHT_INIT_ARRAY, 0x22)
	secsA[2] = arrSec(".init_array", SHT_INIT_ARRAY, 0x33)
	secsA[3] = mkSection(".data", SF_READ | SF_WRITE, SHT_PROGBITS, make_slice(uint8, 4),
			cast(uint, 4), 4)
	var secsB @[]InputSection = make_slice(InputSection, 4)
	secsB[0] = arrSec(".init_array.100", SHT_INIT_ARRAY, 0x11)
	secsB[1] = arrSec(".fini_array", SHT_FINI_ARRAY, 0x44)
	secsB[2] = arrSec(".preinit_array", SHT_PREINIT_ARRAY, 0x55)
	secsB[3] = arrSec(".fini_array.5", SHT_FINI_ARRAY, 0x66)
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkObjSecs(secsA)
	objs[1] = mkObjSecs(secsB)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(lr.Sections) != 5 { return fail("expected .text and the three arrays and .data") }
	var want @[]@[]char = make_slice(@[]char, 5)
	want[0] = buf.CopyStr(".text")
	want[1] = buf.CopyStr(".preinit_array")
	want[2] = buf.CopyStr(".init_array")
	want[3] = buf.CopyStr(".fini_array")
	want[4] = buf.CopyStr(".data")
	for i := 0; i < 5; i++ {
		if !charsEqual(lr.Sections[i].Name, want[i]) { return fail(buf.Concat("misplaced: ", want[i])) }
	}
	if lr.Sections[1].Addr != cast(uint64, 0x401000) {
		return fail("the arrays do not open the writable page")
	}
	var init OutputSection = lr.Sections[2]
	if init.Size != cast(uint64, 24) || init.Data[0] != 0x11 || init.Data[8] != 0x22 ||
			init.Data[16] != 0x33 {
		return fail(".init_array's inputs are not in priority order")
	}
	if lr.ArrayStart[1] != init.Addr || lr.ArrayEnd[1] != init.Addr + cast(uint64, 24) {
		return fail("wrong .init_array range")
	}
	if lr.ArrayStart[0] != lr.Sections[1].Addr ||
			lr.ArrayEnd[2] != lr.Sections[3].Addr + cast(uint64, 16) {
		return fail("wrong preinit / fini range")
	}
	var fini OutputSection = lr.Sections[3]
	if fini.Size != cast(uint64, 16) || fini.Data[0] != 0x66 || fini.Data[8] != 0x44 {
		return fail(".fini_array's inputs are not in priority order")
	}

	var only @[]InputSection = make_slice(InputSection, 1)
	only[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, make_slice(uint8, 4), cast(uint, 4),
			4)
	var one @[]@InputObject = make_slice(@InputObject, 1)
	one[0] = mkObjSecs(only)
	lr = Layout(one, cast(uint64, 0x400000))
	for k := 0; k < 3; k++ {
		if lr.ArrayStart[k] != lr.ArrayEnd[k] { return fail("an empty array has a non-empty range") }
	}
	return ""
}

// The bracketing symbols an object refers to (and none defines) are layout-defined, with the
// arrays' addresses.
func TestArraySymbolsWhenReferenced() testing.TestResult {
	var secs @[]InputSection = make_slice(InputSection, 2)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, make_slice(uint8, 4), cast(uint, 4),
			4)
	secs[1] = arrSec(".init_array", SHT_INIT_ARRAY, 0x11)
	var syms @[]InputSymbol = make_slice(InputSymbol, 3)
	syms[0] = mkSym("__init_array_start", -1, BIND_GLOBAL)
	syms[1] = mkSym("__init_array_end", -1, BIND_GLOBAL)
	syms[2] = mkSym("__fini_array_start", 0, BIND_GLOBAL) // the object's own definition
	var obj @InputObject = mkObjSecs(secs)
	obj.Symbols = syms
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	var abs @[]AbsSym = referencedArraySymbols(objs)
	if len(abs) != 2 || !charsEqual(abs[0].Name, "__init_array_start") ||
			!charsEqual(abs[1].Name, "__init_array_end") {
		return fail("expected exactly the referenced, undefined init-array symbols")
	}
	t, err := ResolveWithAbs(objs, abs)
	if len(err) != 0 { return fail(buf.Concat("resolve: ", err)) }
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	setArraySymbols(t, lr)
	s, sok := t.lookupAbs("__init_array_start")
	e, eok := t.lookupAbs("__init_array_end")
	if !sok || !eok || s != lr.ArrayStart[1] || e != s + cast(uint64, 8) {
		return fail("the init-array symbols do not bracket the array")
	}
	return ""
}

// An AArch64 static link whose objects refer to both `_GLOBAL_OFFSET_TABLE_` and
// `__init_array_start` gives each its own value: the GOT's start and the array's.
func TestStaticLinkGotAndArraySymbols() testing.TestResult {
	var secs @[]InputSection = make_slice(InputSection, 2)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, make_slice(uint8, 4), cast(uint, 4),
			4)
	secs[1] = arrSec(".init_array", SHT_INIT_ARRAY, 0x11)
	var syms @[]InputSymbol = make_slice(InputSymbol, 2)
	syms[0] = mkSym("_GLOBAL_OFFSET_TABLE_", -1, BIND_GLOBAL)
	syms[1] = mkSym("__init_array_start", -1, BIND_GLOBAL)
	var obj @InputObject = mkObjSecs(secs)
	obj.Machine = EM_AARCH64
	obj.Symbols = syms
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	t, lr, gotObj, err := layoutStatic(objs, EM_AARCH64, cast(uint64, 0x400000))
	if len(err) != 0 || !present(gotObj) { return fail("the link should have a GOT") }
	g, gok := t.lookupAbs("_GLOBAL_OFFSET_TABLE_")
	a, aok := t.lookupAbs("__init_array_start")
	if !gok || g != secVaddr(gotObj, lr, 0) {
		return fail("_GLOBAL_OFFSET_TABLE_ is not the GOT's start")
	}
	if !aok || a != lr.ArrayStart[1] { return fail("__init_array_start is not the array's start") }
	return ""
}

// A dynamic link gives a non-empty init array DT_INIT_ARRAY (its address) and DT_INIT_ARRAYSZ
// (its size) in .dynamic, and the array holds its pointer, relocated.
func TestLinkDynElfInitArrayTags() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var obj @[]char = initArrayObject(dir, "/ia_prog.o", "ctor", true)
	if len(obj) == 0 { return fail("cannot write the object") }

	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = obj
	var out @[]char = buf.Concat(dir, "/ia_prog")
	var err @[]readonly char = LinkDynElf(paths, "_start", EM_AARCH64, cast(uint64, 0x400000), out,
			make_slice(@[]char, 0), fakeLibcDirs(dir, EM_AARCH64, make_slice(@[]char, 0)))
	if len(err) != 0 { return fail(buf.Concat("LinkDynElf failed: ", err)) }
	exe, eok := readFile(out)
	if !eok { return fail("cannot read the executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = exe
	arrVa, arrSz, found := dynArrayTags(rd)
	if !found || arrSz != 8 { return fail("no DT_INIT_ARRAY / DT_INIT_ARRAYSZ of 8") }
	off, fok := vaToFileOff(rd, arrVa)
	if !fok { return fail("DT_INIT_ARRAY is not in a loaded segment") }
	if u64(rd, off) == 0 { return fail("the init array's pointer was not relocated") }
	return ""
}

// Two objects' 8-aligned init arrays link into one array of exactly their two entries: no
// padding between them, which would be a null entry the C runtime calls (as a minimum section
// alignment above 8 in the objects would insert).
func TestLinkDynElfInitArraysFromTwoObjects() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var paths @[]@[]char = make_slice(@[]char, 2)
	paths[0] = initArrayObject(dir, "/ia_a.o", "ctor_a", true)
	paths[1] = initArrayObject(dir, "/ia_b.o", "ctor_b", false)
	if len(paths[0]) == 0 || len(paths[1]) == 0 { return fail("cannot write the objects") }
	var out @[]char = buf.Concat(dir, "/ia_two")
	var err @[]readonly char = LinkDynElf(paths, "_start", EM_AARCH64, cast(uint64, 0x400000), out,
			make_slice(@[]char, 0), fakeLibcDirs(dir, EM_AARCH64, make_slice(@[]char, 0)))
	if len(err) != 0 { return fail(buf.Concat("LinkDynElf failed: ", err)) }
	exe, eok := readFile(out)
	if !eok { return fail("cannot read the executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = exe
	arrVa, arrSz, found := dynArrayTags(rd)
	if !found || arrSz != 16 { return fail("the init array is not exactly the two entries") }
	off, fok := vaToFileOff(rd, arrVa)
	if !fok { return fail("DT_INIT_ARRAY is not in a loaded segment") }
	if u64(rd, off) == 0 || u64(rd, off + 8) == 0 { return fail("an init array entry is null") }
	if u64(rd, off) >= u64(rd, off + 8) { return fail("the entries are not ctor_a then ctor_b") }
	return ""
}

// Two ELF32 (arm32) objects' 4-byte init arrays lay out as one array of exactly their two
// words, with no padding between them (a null entry the C runtime would call).
func TestLayoutArm32InitArraysFromTwoObjects() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	for i := 0; i < 2; i++ {
		var a @asm.Assembler = asm.New(4)
		a.SetSection("text", -1)
		a.DefineLabel("ctor")
		arm32.Bx(a, arm32.COND_AL, arm32.LR)
		a.SetSection("init_array", SF_READ | SF_WRITE)
		a.Align(4)
		a.EmitAddr("ctor")
		if !arm32.ResolveFixups(a) { return fail("arm32 fixup resolution failed") }
		a.Finalize()
		if a.HasError { return fail("assembler error") }
		var path @[]char = buf.Concat(dir, "/ia32.o")
		if !elf.WriteARM32(a, path) { return fail("cannot write the object") }
		data, ok := readFile(path)
		if !ok { return fail("cannot read the object") }
		obj, err := parseObjectBytes(data, "ia32.o")
		if len(err) != 0 { return fail(buf.Concat("cannot read the object: ", err)) }
		objs[i] = obj
	}
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x40001000))
	for i := 0; i < len(lr.Sections); i++ {
		if !charsEqual(lr.Sections[i].Name, ".init_array") { continue }
		if lr.Sections[i].Size != cast(uint64, 8) {
			return fail("the init array is not exactly the two words")
		}
		return ""
	}
	return fail("no .init_array")
}

// initArrayObject writes an AArch64 object to dir/file whose init array holds a pointer to its
// function ctor, 8-aligned as a C compiler aligns it, with a _start that calls exit when
// withStart; it returns the object's path, empty on failure.
func initArrayObject(dir *[]readonly char, file *[]readonly char, ctor *[]readonly char,
		withStart bool) @[]char {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	if withStart {
		a.DefineLabel("_start")
		a.SetGlobal("_start")
		a.SetGlobal("exit")
		aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(0))
		aarch64.Bl(a, "exit")
	}
	a.DefineLabel(ctor)
	aarch64.Ret(a)
	a.SetSection("init_array", SF_READ | SF_WRITE)
	a.Align(8)
	a.AddFixup(ctor, asm.FIX_DATA_ABS64, 0, 8)
	a.Zero(8)
	aarch64.ResolveFixups(a)
	a.Finalize()
	var none @[]char
	if a.HasError { return none }
	var obj @[]char = buf.Concat(dir, file)
	if !elf.WriteAArch64(a, obj) { return none }
	return obj
}

// dynArrayTags returns the DT_INIT_ARRAY address and DT_INIT_ARRAYSZ size in the ELF64
// executable exe's PT_DYNAMIC, and whether both are there.
func dynArrayTags(exe *[]readonly uint8) (uint64, int64, bool) {
	var phoff int = cast(int, u64(exe, 32))
	var phentsize int = u16(exe, 54)
	var phnum int = u16(exe, 56)
	for i := 0; i < phnum; i++ {
		var p int = phoff + i * phentsize
		if cast(int, u32(exe, p)) != PT_DYNAMIC { continue }
		var off int = cast(int, u64(exe, p + 8))
		var size int = cast(int, u64(exe, p + 32))
		var va uint64 = cast(uint64, 0)
		var sz int64 = -1
		for d := off; d + 16 <= off + size; d = d + 16 {
			var tag int64 = u64(exe, d)
			if tag == cast(int64, DT_INIT_ARRAY) { va = cast(uint64, u64(exe, d + 8)) }
			if tag == cast(int64, DT_INIT_ARRAYSZ) { sz = u64(exe, d + 8) }
		}
		return va, sz, va != cast(uint64, 0) && sz >= 0
	}
	return cast(uint64, 0), -1, false
}

// vaToFileOff returns the file offset of virtual address va in the ELF64 executable exe (from
// its PT_LOAD headers), and whether a segment maps it from the file.
func vaToFileOff(exe *[]readonly uint8, va uint64) (int, bool) {
	var phoff int = cast(int, u64(exe, 32))
	var phentsize int = u16(exe, 54)
	var phnum int = u16(exe, 56)
	for i := 0; i < phnum; i++ {
		var p int = phoff + i * phentsize
		if cast(int, u32(exe, p)) != PT_LOAD { continue }
		var vaddr uint64 = cast(uint64, u64(exe, p + 16))
		var filesz uint64 = cast(uint64, u64(exe, p + 32))
		if va >= vaddr && va + cast(uint64, 8) <= vaddr + filesz {
			return cast(int, u64(exe, p + 8)) + cast(int, va - vaddr), true
		}
	}
	return 0, false
}
