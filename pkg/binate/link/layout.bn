package "pkg/binate/link"

import "pkg/binate/buf"

// OutputSection is a merged output section: all input sections of one kind
// (text/rodata/data/bss) concatenated, with an assigned virtual address.  Data is
// empty for .bss (a NOBITS section reserves Size bytes but occupies none).
type OutputSection struct {
	Name  @[]char
	Flags int
	Align int
	Addr  uint
	Data  @[]uint8
	Size  uint
}

// LayoutResult is the set of output sections produced by Layout, in load order
// (.text, .rodata, .data, .bss — omitting any that are empty).
type LayoutResult struct {
	Sections @[]OutputSection
}

// The four output-section kinds, in load order.
const (
	kindText int = 0
	kindRodata int = 1
	kindData int = 2
	kindBss int = 3
)

// kindOf classifies an input section by its normalized flags and ELF type.
func kindOf(flags int, stype int) int {
	if stype == SHT_NOBITS { return kindBss } // NOBITS reserves memory, no file bytes
	if (flags & SF_EXEC) != 0 { return kindText }
	if (flags & SF_WRITE) != 0 { return kindData }
	return kindRodata
}

// kindName returns the conventional output-section name for a kind.
func kindName(k int) @[]char {
	if k == kindText { return buf.CopyStr(".text") }
	if k == kindRodata { return buf.CopyStr(".rodata") }
	if k == kindData { return buf.CopyStr(".data") }
	return buf.CopyStr(".bss")
}

// kindFlags returns the normalized SF_* flags for an output-section kind.
func kindFlags(k int) int {
	if k == kindText { return SF_READ | SF_EXEC }
	if k == kindRodata { return SF_READ }
	return SF_READ | SF_WRITE // data and bss
}

// alignUp rounds x up to a multiple of a (a >= 1).
func alignUp(x int, a int) int {
	if a <= 1 { return x }
	var r int = x % a
	if r == 0 { return x }
	return x + (a - r)
}

// Layout merges the objects' content sections into per-kind output sections,
// records each input section's placement (OutIndex/OutOffset), and assigns
// virtual addresses starting at base (each output section aligned to the maximum
// alignment of its inputs).  Empty kinds are omitted.  Segment permissions and
// page alignment are an emit concern; this stage only packs and addresses.
func Layout(objs @[]@InputObject, base uint) @LayoutResult {
	// Per-kind accumulated size and maximum alignment.
	var kindSize @[]int = make_slice(int, 4)
	var kindAlign @[]int = make_slice(int, 4)
	for k := 0; k < 4; k++ { kindAlign[k] = 1 }

	// Pass A: assign each input section a kind and an offset within that kind;
	// accumulate per-kind sizes and alignments.  OutIndex temporarily holds the
	// kind and is remapped to the final section index below.
	for o := 0; o < len(objs); o++ {
		var obj @InputObject = objs[o]
		for s := 0; s < len(obj.Sections); s++ {
			var k int = kindOf(obj.Sections[s].Flags, obj.Sections[s].Type)
			var a int = obj.Sections[s].Align
			if a < 1 { a = 1 }
			if a > kindAlign[k] { kindAlign[k] = a }
			var off int = alignUp(kindSize[k], a)
			obj.Sections[s].OutIndex = k
			obj.Sections[s].OutOffset = cast(uint, off)
			kindSize[k] = off + cast(int, obj.Sections[s].Size)
		}
	}

	// Map each non-empty kind to its final output-section index (load order).
	var kindToFinal @[]int = make_slice(int, 4)
	var nOut int = 0
	for k := 0; k < 4; k++ {
		if kindSize[k] > 0 {
			kindToFinal[k] = nOut
			nOut = nOut + 1
		} else {
			kindToFinal[k] = -1
		}
	}
	for o := 0; o < len(objs); o++ {
		var obj @InputObject = objs[o]
		for s := 0; s < len(obj.Sections); s++ {
			obj.Sections[s].OutIndex = kindToFinal[obj.Sections[s].OutIndex]
		}
	}

	// Build the output sections and assign addresses.
	var outs @[]OutputSection = make_slice(OutputSection, nOut)
	// Addresses are carried in uint: a base or address >= 2^31 is a valid load
	// address (kernel-half, some DRAM/MMIO bases) that would be negative — and
	// misalign — in a 32-bit signed int.
	var vaddr uint = base
	for k := 0; k < 4; k++ {
		if kindSize[k] == 0 { continue }
		var os OutputSection
		os.Name = kindName(k)
		os.Flags = kindFlags(k)
		os.Align = kindAlign[k]
		os.Size = cast(uint, kindSize[k])
		var al uint = cast(uint, kindAlign[k])
		if al > 1 {
			var rem uint = vaddr % al
			if rem != 0 { vaddr = vaddr + (al - rem) }
		}
		os.Addr = vaddr
		vaddr = vaddr + cast(uint, kindSize[k])
		if k == kindBss {
			os.Data = make_slice(uint8, 0)
		} else {
			os.Data = make_slice(uint8, kindSize[k])
		}
		outs[kindToFinal[k]] = os
	}

	// Pass B: copy each input section's bytes into its output section (NOBITS
	// sections carry no data).
	for o := 0; o < len(objs); o++ {
		var obj @InputObject = objs[o]
		for s := 0; s < len(obj.Sections); s++ {
			var oi int = obj.Sections[s].OutIndex
			if oi < 0 || obj.Sections[s].Type == SHT_NOBITS { continue }
			var off int = cast(int, obj.Sections[s].OutOffset)
			var d @[]uint8 = obj.Sections[s].Data
			// Copy at most Size bytes: the reserved span is [off, off+Size), so a
			// malformed input with len(Data) > Size cannot overrun a neighbor.
			var n int = len(d)
			if n > cast(int, obj.Sections[s].Size) { n = cast(int, obj.Sections[s].Size) }
			for i := 0; i < n; i++ { outs[oi].Data[off + i] = d[i] }
		}
	}

	var r @LayoutResult = make(LayoutResult)
	r.Sections = outs
	return r
}
