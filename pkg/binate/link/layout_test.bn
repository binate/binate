package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// (fail is defined in parse_elf_test.bn, charsEqual in bytes.bn — same package.)

// mkSection builds a synthetic InputSection.
func mkSection(name *[]readonly char, flags int, stype int, data @[]uint8, size uint,
		align int) InputSection {
	var sec InputSection
	sec.Name = buf.CopyStr(name)
	sec.Flags = flags
	sec.Type = stype
	sec.Data = data
	sec.Size = size
	sec.Align = align
	sec.OutIndex = -1
	sec.OutOffset = cast(uint, 0)
	return sec
}

// mkObjSecs builds an InputObject with the given sections and no symbols/relocs.
func mkObjSecs(secs @[]InputSection) @InputObject {
	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr("x.o")
	obj.Machine = EM_X86_64
	obj.Sections = secs
	obj.Symbols = make_slice(InputSymbol, 0)
	obj.Relocs = make_slice(InputReloc, 0)
	return obj
}

// Two objects' .text sections merge into one output .text at the base address,
// concatenated in object order, and each input records its offset.
func TestLayoutMergesText() testing.TestResult {
	var da @[]uint8 = make_slice(uint8, 2)
	da[0] = 0x90
	da[1] = 0x90
	var secsA @[]InputSection = make_slice(InputSection, 1)
	secsA[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, da, cast(uint, 2), 1)

	var db @[]uint8 = make_slice(uint8, 1)
	db[0] = 0xc3
	var secsB @[]InputSection = make_slice(InputSection, 1)
	secsB[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, db, cast(uint, 1), 1)

	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkObjSecs(secsA)
	objs[1] = mkObjSecs(secsB)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))

	if len(lr.Sections) != 1 { return fail("expected one output section (.text)") }
	var t OutputSection = lr.Sections[0]
	if !charsEqual(t.Name, ".text") { return fail("output section should be .text") }
	if t.Addr != cast(uint64, 0x400000) { return fail(".text should be at the base address") }
	if len(t.Data) != 3 { return fail(".text should merge to 3 bytes") }
	if t.Data[0] != 0x90 || t.Data[1] != 0x90 || t.Data[2] != 0xc3 {
		return fail("merged .text bytes are wrong")
	}
	if objs[0].Sections[0].OutOffset != cast(uint, 0) {
		return fail("objA .text should be at offset 0")
	}
	if objs[1].Sections[0].OutOffset != cast(uint, 2) {
		return fail("objB .text should be at offset 2")
	}
	if objs[0].Sections[0].OutIndex != 0 { return fail("objA .text OutIndex should be 0") }
	return ""
}

// Distinct kinds become separate output sections in load order (text, data, bss)
// with sequential addresses; .bss reserves size but carries no data.
func TestLayoutMultipleKinds() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 2)
	dt[0] = 0xc3
	dt[1] = 0xc3
	var dd @[]uint8 = make_slice(uint8, 4)
	dd[0] = 1
	dd[1] = 2
	dd[2] = 3
	dd[3] = 4
	var secs @[]InputSection = make_slice(InputSection, 3)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, dt, cast(uint, 2), 1)
	secs[1] = mkSection(".data", SF_READ | SF_WRITE, SHT_PROGBITS, dd, cast(uint, 4), 1)
	secs[2] = mkSection(".bss", SF_READ | SF_WRITE, SHT_NOBITS, make_slice(uint8, 0), cast(uint, 8), 1)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObjSecs(secs)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x1000))

	if len(lr.Sections) != 3 { return fail("expected .text, .data, .bss") }
	if !charsEqual(lr.Sections[0].Name, ".text") { return fail("section 0 should be .text") }
	if !charsEqual(lr.Sections[1].Name, ".data") { return fail("section 1 should be .data") }
	if !charsEqual(lr.Sections[2].Name, ".bss") { return fail("section 2 should be .bss") }
	if lr.Sections[0].Addr != cast(uint64, 0x1000) { return fail(".text addr wrong") }
	// .data is writable, so it starts on a fresh page (0x2000) away from .text; .bss
	// is also writable and packs contiguously after .data.
	if lr.Sections[1].Addr != cast(uint64, 0x2000) { return fail(".data should start a new page") }
	if lr.Sections[2].Addr != cast(uint64, 0x2004) { return fail(".bss should follow .data") }
	if lr.Sections[2].Size != cast(uint64, 8) { return fail(".bss size should be 8") }
	if len(lr.Sections[2].Data) != 0 { return fail(".bss should carry no data") }
	return ""
}

// A read-only, non-exec section becomes .rodata with read-only flags.
func TestLayoutRodata() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 4)
	d[0] = 0xde
	d[1] = 0xad
	d[2] = 0xbe
	d[3] = 0xef
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".rodata", SF_READ, SHT_PROGBITS, d, cast(uint, 4), 1)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObjSecs(secs)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x8000))
	if len(lr.Sections) != 1 { return fail("expected one .rodata section") }
	if !charsEqual(lr.Sections[0].Name, ".rodata") { return fail("section should be .rodata") }
	if lr.Sections[0].Flags != SF_READ { return fail(".rodata should be read-only") }
	if lr.Sections[0].Addr != cast(uint64, 0x8000) { return fail(".rodata address wrong") }
	if len(lr.Sections[0].Data) != 4 { return fail(".rodata data length wrong") }
	return ""
}

// An output section whose kind has a higher alignment is padded to that alignment
// in the assigned address, not just in the inter-input offset.  Uses .rodata (also
// read-only, same segment as .text) so the page gap before the writable group does
// not mask the alignment being tested.
func TestLayoutOutputSectionAddressAlignment() testing.TestResult {
	var dt @[]uint8 = make_slice(uint8, 2)
	var dd @[]uint8 = make_slice(uint8, 4)
	var secs @[]InputSection = make_slice(InputSection, 2)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, dt, cast(uint, 2), 1)
	secs[1] = mkSection(".rodata", SF_READ, SHT_PROGBITS, dd, cast(uint, 4), 16)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObjSecs(secs)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x1000))
	if len(lr.Sections) != 2 { return fail("expected .text and .rodata") }
	if lr.Sections[0].Addr != cast(uint64, 0x1000) { return fail(".text should be at the base") }
	// .text ends at 0x1002; .rodata (align 16) must be padded up to 0x1010.
	if lr.Sections[1].Addr != cast(uint64, 0x1010) {
		return fail(".rodata address should align to 0x1010")
	}
	return ""
}

// The writable group (.data/.bss) starts on a fresh page, disjoint from the
// read-only/exec group's pages, while the read-only group stays contiguous.
func TestLayoutWritableGroupPageAligned() testing.TestResult {
	var dtext @[]uint8 = make_slice(uint8, 3)
	var drod @[]uint8 = make_slice(uint8, 5)
	var ddata @[]uint8 = make_slice(uint8, 2)
	var secs @[]InputSection = make_slice(InputSection, 3)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, dtext, cast(uint, 3), 1)
	secs[1] = mkSection(".rodata", SF_READ, SHT_PROGBITS, drod, cast(uint, 5), 1)
	secs[2] = mkSection(".data", SF_READ | SF_WRITE, SHT_PROGBITS, ddata, cast(uint, 2), 1)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObjSecs(secs)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(lr.Sections) != 3 { return fail("expected .text, .rodata, .data") }
	// .text at the base, .rodata contiguous after it (both read-only), .data on the
	// next page boundary (writable group).
	if lr.Sections[0].Addr != cast(uint64, 0x400000) { return fail(".text should be at the base") }
	if lr.Sections[1].Addr != cast(uint64, 0x400003) {
		return fail(".rodata should follow .text contiguously")
	}
	if lr.Sections[2].Addr != cast(uint64, 0x401000) {
		return fail(".data should start the next page")
	}
	return ""
}

// A more-aligned later input is padded to its alignment within the output section.
func TestLayoutAlignment() testing.TestResult {
	var d1 @[]uint8 = make_slice(uint8, 3)
	var d2 @[]uint8 = make_slice(uint8, 2)
	var secsA @[]InputSection = make_slice(InputSection, 1)
	secsA[0] = mkSection(".data", SF_READ | SF_WRITE, SHT_PROGBITS, d1, cast(uint, 3), 1)
	var secsB @[]InputSection = make_slice(InputSection, 1)
	secsB[0] = mkSection(".data", SF_READ | SF_WRITE, SHT_PROGBITS, d2, cast(uint, 2), 8)
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkObjSecs(secsA)
	objs[1] = mkObjSecs(secsB)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0))

	if len(lr.Sections) != 1 { return fail("expected one .data section") }
	if objs[1].Sections[0].OutOffset != cast(uint, 8) {
		return fail("aligned input should be at offset 8")
	}
	if lr.Sections[0].Align != 8 { return fail("output .data align should be 8") }
	if lr.Sections[0].Size != cast(uint64, 10) { return fail(".data size should be 10 (8 + 2)") }
	return ""
}
