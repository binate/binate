package "pkg/binate/link"

import "pkg/binate/buf"

// The shared libraries a dynamic ELF link needs.  libc.so.6 is needed implicitly and found by
// name in the library directories; a `-l` shared library arrives as a path.  Each is read for
// its SONAME (the DT_NEEDED it becomes) and for the names in its .dynsym — those it defines or
// references — which decide what the executable exports.  A needed library found nowhere is
// an error: without it the link cannot tell what the program must export.

// SHT_DYNSYM is the type of a shared object's dynamic symbol table section (.dynsym).
const SHT_DYNSYM int = 11

// SHT_GNU_VERSYM is the type of a shared object's symbol-version section (.gnu.version): a
// uint16 version index per .dynsym entry, VERSYM_HIDDEN marking a definition reachable only
// by its explicit version (a non-default one).
const (
	SHT_GNU_VERSYM int = 0x6fffffff
	VERSYM_HIDDEN int = 0x8000
)

// DefaultLibDirs returns the directories under sysroot ("" or "/" for the host's own root)
// where a Linux distribution keeps machine's shared libraries: the multiarch directories
// (lib/<triple>, usr/lib/<triple>) first, then lib64, usr/lib64, lib and usr/lib.
func DefaultLibDirs(sysroot *[]readonly char, machine int) @[]@[]char {
	var root *[]readonly char = sysroot
	for len(root) > 0 && root[len(root) - 1] == '/' { root = root[0:len(root) - 1] }
	var triple *[]readonly char = "x86_64-linux-gnu"
	if machine == EM_AARCH64 { triple = "aarch64-linux-gnu" }
	var dirs @[]@[]char = make_slice(@[]char, 6)
	dirs[0] = buf.Concat(buf.Concat(root, "/lib/"), triple)
	dirs[1] = buf.Concat(buf.Concat(root, "/usr/lib/"), triple)
	dirs[2] = buf.Concat(root, "/lib64")
	dirs[3] = buf.Concat(root, "/usr/lib64")
	dirs[4] = buf.Concat(root, "/lib")
	dirs[5] = buf.Concat(root, "/usr/lib")
	return dirs
}

// elfMachineOf returns the e_machine of the ELF64 little-endian file data, or -1 for anything
// else.
func elfMachineOf(data *[]readonly uint8) int {
	if len(data) < 64 || data[0] != 0x7f || data[1] != 0x45 || data[2] != 0x4c || data[3] != 0x46 {
		return -1
	}
	if data[4] != ELFCLASS64 || data[5] != ELFDATA2LSB { return -1 }
	return u16(data, 18)
}

// SharedObjectMachine returns the e_machine of the ELF64 little-endian file at path, or -1 when
// it is not one or cannot be read — for a library search that skips another machine's file.
func SharedObjectMachine(path *[]readonly char) int {
	data, ok := readFile(path)
	if !ok { return -1 }
	return elfMachineOf(data)
}

// findLibrary returns the path and contents of the first file named name in dirs that is an
// ELF64 object for machine, skipping one for another machine (as GNU ld does), and whether
// there is one.
func findLibrary(name *[]readonly char, dirs @[]@[]char, machine int) (@[]char, @[]uint8, bool) {
	for i := 0; i < len(dirs); i++ {
		var p @[]char = buf.Concat(buf.Concat(dirs[i], "/"), name)
		data, ok := readFile(p)
		if ok && elfMachineOf(data) == machine { return p, data, true }
	}
	return "", make_slice(uint8, 0), false
}

// readDynSymbolNames returns the names of the global and weak symbols — defined or not — in
// the .dynsym of the ELF64 shared object data (path labels errors), found through its section
// headers: modern glibc carries DT_GNU_HASH and no DT_HASH, so the dynamic segment alone does
// not give the table's length.  A definition under a hidden symbol version (its .gnu.version
// entry has VERSYM_HIDDEN set — e.g. glibc's `__malloc_hook`, kept only for old binaries) is
// left out: a link binds a plain name only to a default-version definition, as lld does.
func readDynSymbolNames(data *[]readonly uint8,
		path *[]readonly char) (@[]@[]char, @[]readonly char) {
	var none @[]@[]char = make_slice(@[]char, 0)
	shoff, shoffOk := readOff(data, 0x28) // e_shoff
	var shentsize int = u16(data, 0x3a)
	var shnum int = u16(data, 0x3c)
	if !shoffOk || shentsize < 64 || !rangeOk(shoff, shnum * shentsize, len(data)) {
		return none, buf.Concat("shared object has no readable section headers: ", path)
	}
	var symSh int = -1
	var verSh int = -1
	for i := 0; i < shnum; i++ {
		var t int = cast(int, u32(data, shoff + i * shentsize + 4))
		if t == SHT_DYNSYM && symSh < 0 { symSh = shoff + i * shentsize }
		if t == SHT_GNU_VERSYM && verSh < 0 { verSh = shoff + i * shentsize }
	}
	if symSh < 0 { return none, buf.Concat("shared object has no .dynsym: ", path) }
	off, offOk := readOff(data, symSh + 0x18)
	size, sizeOk := readOff(data, symSh + 0x20)
	var link int = cast(int, u32(data, symSh + 0x28))
	if !offOk || !sizeOk || !rangeOk(off, size, len(data)) || link <= 0 || link >= shnum {
		return none, buf.Concat("malformed .dynsym in ", path)
	}
	strOff, strOk := readOff(data, shoff + link * shentsize + 0x18)
	if !strOk || strOff >= len(data) { return none, buf.Concat("malformed .dynstr in ", path) }
	var n int = size / symEntSize
	var verOff int = -1 // .gnu.version: one uint16 per .dynsym entry
	if verSh >= 0 {
		vo, voOk := readOff(data, verSh + 0x18)
		if !voOk || !rangeOk(vo, n * 2, len(data)) {
			return none, buf.Concat("malformed .gnu.version in ", path)
		}
		verOff = vo
	}
	var names @[]@[]char = make_slice(@[]char, n)
	var k int = 0
	for j := 1; j < n; j++ {
		var e int = off + j * symEntSize
		if (cast(int, data[e + 4]) >> 4) == 0 { continue } // a local
		var defined bool = u16(data, e + 6) != SHN_UNDEF
		if defined && verOff >= 0 && (u16(data, verOff + j * 2) & VERSYM_HIDDEN) != 0 { continue }
		var nameOff int = cast(int, u32(data, e))
		if nameOff == 0 || strOff + nameOff >= len(data) { continue }
		names[k] = readCStr(data, strOff + nameOff, len(data))
		k = k + 1
	}
	return names[0:k], ""
}

// readNeededLib reads the shared object data (at path) a link for machine needs: its SONAME
// and its .dynsym's names.  A file for another machine is an error.
func readNeededLib(data *[]readonly uint8, path *[]readonly char,
		machine int) (@[]char, @[]@[]char, @[]readonly char) {
	var none @[]@[]char = make_slice(@[]char, 0)
	soname, serr := readSoname(data, path) // first: it says what a non-ELF file (a linker script) is
	if len(serr) != 0 { return "", none, serr }
	if elfMachineOf(data) != machine {
		return "", none, buf.Concat("shared library is for another machine than the target: ", path)
	}
	names, nerr := readDynSymbolNames(data, path)
	if len(nerr) != 0 { return "", none, nerr }
	return soname, names, ""
}

// neededLibs resolves the shared libraries a dynamic ELF link for machine needs: libc.so.6
// first — the file of sharedLibPaths whose SONAME it is, else the first libc.so.6 for machine
// in libDirs — then each other file of sharedLibPaths (one whose SONAME is already present,
// e.g. a `-lc` resolving to libc.so.6, is not needed twice).  Returns their SONAMEs (one
// DT_NEEDED each, in order), the names in their .dynsym tables, or an error: an unreadable or
// foreign library, or no libc.so.6 in libDirs.
func neededLibs(sharedLibPaths @[]@[]char, libDirs @[]@[]char,
		machine int) (@[]@[]char, @[]@[]char, @[]readonly char) {
	var none @[]@[]char = make_slice(@[]char, 0)
	var sonames @[]@[]char = make_slice(@[]char, len(sharedLibPaths))
	var symNames @[]@[]@[]char = make_slice(@[]@[]char, len(sharedLibPaths))
	var libcAt int = -1
	for i := 0; i < len(sharedLibPaths); i++ {
		data, ok := readFile(sharedLibPaths[i])
		if !ok { return none, none, buf.Concat("cannot read shared library: ", sharedLibPaths[i]) }
		soname, names, rerr := readNeededLib(data, sharedLibPaths[i], machine)
		if len(rerr) != 0 { return none, none, rerr }
		sonames[i] = soname
		symNames[i] = names
		if libcAt < 0 && charsEqual(soname, "libc.so.6") { libcAt = i }
	}
	var libs @[]@[]char = make_slice(@[]char, 1 + len(sharedLibPaths))
	libs[0] = buf.CopyStr("libc.so.6")
	var all @[]@[]@[]char = make_slice(@[]@[]char, 1 + len(sharedLibPaths))
	if libcAt >= 0 {
		all[0] = symNames[libcAt]
	} else {
		path, data, found := findLibrary("libc.so.6", libDirs, machine)
		if !found { return none, none, missingLibcError(libDirs, machine) }
		_, names, rerr := readNeededLib(data, path, machine)
		if len(rerr) != 0 { return none, none, rerr }
		all[0] = names
	}
	var n int = 1
	for i := 0; i < len(sharedLibPaths); i++ {
		if libListHas(libs[0:n], sonames[i]) { continue }
		libs[n] = sonames[i]
		all[n] = symNames[i]
		n = n + 1
	}
	var total int = 0
	for i := 0; i < n; i++ { total = total + len(all[i]) }
	var flat @[]@[]char = make_slice(@[]char, total)
	var k int = 0
	for i := 0; i < n; i++ {
		for j := 0; j < len(all[i]); j++ {
			flat[k] = all[i][j]
			k = k + 1
		}
	}
	return libs[0:n], flat, ""
}

// missingLibcError describes a dynamic link for machine that found no libc.so.6 in libDirs.
func missingLibcError(libDirs @[]@[]char, machine int) @[]readonly char {
	var arch *[]readonly char = "x86-64"
	if machine == EM_AARCH64 { arch = "aarch64" }
	var msg @[]char = buf.Concat(buf.Concat("cannot find an ", arch), " libc.so.6 in")
	if len(libDirs) == 0 { msg = buf.Concat(msg, " (no library directories)") }
	for i := 0; i < len(libDirs); i++ {
		var sep *[]readonly char = ","
		if i == 0 { sep = "" }
		msg = buf.Concat(buf.Concat(buf.Concat(msg, sep), " "), libDirs[i])
	}
	msg = buf.Concat(msg, " — a dynamic link reads its symbols to decide what the executable")
	return buf.Concat(msg, " exports; give the linker a sysroot or library directory holding one")
}

// libListHas reports whether libs already contains a SONAME equal to name.
func libListHas(libs @[]@[]char, name *[]readonly char) bool {
	for i := 0; i < len(libs); i++ {
		if charsEqual(libs[i], name) { return true }
	}
	return false
}
