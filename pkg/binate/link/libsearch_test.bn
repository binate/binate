package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Finding and reading the shared libraries a dynamic ELF link needs (libsearch.bn): the
// default directories, a library's .dynsym names, the machine check, and libc.so.6's lookup.
// (testTmpDir is in link_test.bn, writeFile in parse_ar_test.bn, fail in parse_elf_test.bn.)

// mkSoSyms is mkSoSymsWith making the one strong undefined reference `und`.
func mkSoSyms(soname *[]readonly char, machine int, globals @[]@[]char) @[]uint8 {
	return mkSoSymsWith(soname, machine, globals, @[]@[]char{buf.CopyStr("und")})
}

// mkSoSymsWith builds a minimal ELF64 shared object for machine named soname, with section
// headers (null, .dynstr, .dynsym, .gnu.version) and a .dynsym holding a global function per
// name of globals, then: the weak definition `wk`; a strong undefined reference per name of
// undefs; the weak undefined reference `wku`; the reference `vu` bound to version 2; the
// definition `hv` under a hidden version; and the local `loc`.  readDynSymbolNames keeps all
// through `wku` (refs: undefs) and drops the last three.  Its one PT_LOAD maps the file at
// vaddr == offset, and its PT_DYNAMIC holds DT_SONAME and DT_STRTAB.
func mkSoSymsWith(soname *[]readonly char, machine int, globals @[]@[]char,
		undefs @[]@[]char) @[]uint8 {
	var extras @[]@[]char = make_slice(@[]char, 5 + len(undefs))
	extras[0] = buf.CopyStr("wk")
	for i := 0; i < len(undefs); i++ { extras[1 + i] = undefs[i] }
	extras[1 + len(undefs)] = buf.CopyStr("wku")
	extras[2 + len(undefs)] = buf.CopyStr("vu")
	extras[3 + len(undefs)] = buf.CopyStr("hv")
	extras[4 + len(undefs)] = buf.CopyStr("loc")
	var strSize int = 2 + len(soname) // \0 <soname> \0, then each name and its \0
	for i := 0; i < len(globals); i++ { strSize = strSize + len(globals[i]) + 1 }
	for i := 0; i < len(extras); i++ { strSize = strSize + len(extras[i]) + 1 }
	var strOff int = 64 + 2 * 56
	var symOff int = strOff + strSize
	if symOff % 8 != 0 { symOff = symOff + (8 - symOff % 8) }
	var nSym int = 1 + len(globals) + len(extras)
	var verOff int = symOff + nSym * symEntSize
	var dynOff int = verOff + nSym * 2
	if dynOff % 8 != 0 { dynOff = dynOff + (8 - dynOff % 8) }
	var shOff int = dynOff + 3 * 16
	var fileSize int = shOff + 4 * 64
	var out @[]uint8 = make_slice(uint8, fileSize)
	out[0] = 0x7f
	out[1] = 0x45
	out[2] = 0x4c
	out[3] = 0x46
	out[4] = ELFCLASS64
	out[5] = ELFDATA2LSB
	writeLE(out, 16, 3, 2) // e_type = ET_DYN
	writeLE(out, 18, machine, 2) // e_machine
	writeLE(out, 32, 64, 8) // e_phoff
	writeLE(out, 0x28, shOff, 8) // e_shoff
	writeLE(out, 54, 56, 2) // e_phentsize
	writeLE(out, 56, 2, 2) // e_phnum
	writeLE(out, 0x3a, 64, 2) // e_shentsize
	writeLE(out, 0x3c, 4, 2) // e_shnum
	writeLE(out, 64, PT_LOAD, 4)
	writeLE(out, 64 + 32, fileSize, 8) // p_filesz (p_offset = p_vaddr = 0)
	writeLE(out, 64 + 40, fileSize, 8) // p_memsz
	writeLE(out, 120, PT_DYNAMIC, 4)
	writeLE(out, 120 + 8, dynOff, 8) // p_offset
	writeLE(out, 120 + 16, dynOff, 8) // p_vaddr
	writeLE(out, 120 + 32, 3 * 16, 8) // p_filesz

	// .dynstr: \0 <soname> \0 <names...>; each .dynsym entry names into it, and its
	// .gnu.version entry is 1 (unversioned), 2 for vu, 0x8002 for hv, 0 for loc.
	var p int = strOff + 1
	for i := 0; i < len(soname); i++ { out[p + i] = cast(uint8, soname[i]) }
	p = p + len(soname) + 1
	for i := 0; i < len(globals) + len(extras); i++ {
		var name @[]char
		var bind int = BIND_GLOBAL
		var shndx int = 1 // defined
		var ver int = 1
		if i < len(globals) {
			name = globals[i]
		} else {
			var x int = i - len(globals)
			name = extras[x]
			if x == 0 { bind = BIND_WEAK } // wk
			if x >= 1 && x <= len(undefs) { shndx = SHN_UNDEF } // the undefs
			if x == 1 + len(undefs) {
				// wku
				bind = BIND_WEAK
				shndx = SHN_UNDEF
			}
			if x == 2 + len(undefs) {
				// vu
				shndx = SHN_UNDEF
				ver = 2
			}
			if x == 3 + len(undefs) { ver = 0x8002 } // hv
			if x == 4 + len(undefs) {
				// loc
				bind = 0
				ver = 0
			}
		}
		var e int = symOff + (1 + i) * symEntSize
		writeLE(out, e, p - strOff, 4) // st_name
		out[e + 4] = cast(uint8, (bind << 4) | STT_FUNC) // st_info
		writeLE(out, e + 6, shndx, 2) // st_shndx
		writeLE(out, verOff + (1 + i) * 2, ver, 2)
		for j := 0; j < len(name); j++ { out[p + j] = cast(uint8, name[j]) }
		p = p + len(name) + 1
	}

	writeLE(out, dynOff, DT_SONAME, 8)
	writeLE(out, dynOff + 8, 1, 8) // the SONAME is at .dynstr offset 1
	writeLE(out, dynOff + 16, DT_STRTAB, 8)
	writeLE(out, dynOff + 24, strOff, 8) // vaddr == file offset

	writeLE(out, shOff + 64 + 4, 3, 4) // .dynstr: SHT_STRTAB
	writeLE(out, shOff + 64 + 0x18, strOff, 8)
	writeLE(out, shOff + 64 + 0x20, strSize, 8)
	writeLE(out, shOff + 128 + 4, SHT_DYNSYM, 4) // .dynsym
	writeLE(out, shOff + 128 + 0x18, symOff, 8)
	writeLE(out, shOff + 128 + 0x20, nSym * symEntSize, 8)
	writeLE(out, shOff + 128 + 0x28, 1, 4) // sh_link: .dynstr
	writeLE(out, shOff + 128 + 0x38, symEntSize, 8)
	writeLE(out, shOff + 192 + 4, SHT_GNU_VERSYM, 4) // .gnu.version
	writeLE(out, shOff + 192 + 0x18, verOff, 8)
	writeLE(out, shOff + 192 + 0x20, nSym * 2, 8)
	writeLE(out, shOff + 192 + 0x28, 2, 4) // sh_link: .dynsym
	writeLE(out, shOff + 192 + 0x38, 2, 8)
	return out
}

// fakeLibcDirs writes under dir a libc.so.6 for machine defining globals and returns the one
// library directory holding it, or an empty list on failure.
func fakeLibcDirs(dir *[]readonly char, machine int, globals @[]@[]char) @[]@[]char {
	if len(writeFile(buf.Concat(dir, "/libc.so.6"), mkSoSyms("libc.so.6", machine, globals))) != 0 {
		return make_slice(@[]char, 0)
	}
	var dirs @[]@[]char = make_slice(@[]char, 1)
	dirs[0] = buf.CopyStr(dir)
	return dirs
}

// The default directories are a distribution's, under the sysroot: multiarch first.
func TestDefaultLibDirs() testing.TestResult {
	var a @[]@[]char = DefaultLibDirs("/sys/root/", EM_AARCH64)
	if len(a) != 6 || !charsEqual(a[0], "/sys/root/lib/aarch64-linux-gnu") ||
			!charsEqual(a[1], "/sys/root/usr/lib/aarch64-linux-gnu") ||
			!charsEqual(a[5], "/sys/root/usr/lib") {
		return fail("wrong aarch64 directories under a sysroot")
	}
	var x @[]@[]char = DefaultLibDirs("", EM_X86_64)
	if !charsEqual(x[0], "/lib/x86_64-linux-gnu") || !charsEqual(x[2], "/lib64") ||
			!charsEqual(x[4], "/lib") {
		return fail("wrong x86-64 directories under the host root")
	}
	var r @[]@[]char = DefaultLibDirs("/", EM_X86_64)
	if !charsEqual(r[0], "/lib/x86_64-linux-gnu") { return fail("a sysroot of / is the host root") }
	return ""
}

// readDynSymbolNames returns a shared object's global and weak .dynsym names, defined or only
// referenced — not its locals, a definition under a hidden version, or a reference bound to a
// version; its definitions; and its strong unversioned references (not a weak one).  One
// without section headers is an error.
func TestReadDynSymbolNames() testing.TestResult {
	var so @[]uint8 = mkSoSyms("libx.so.1", EM_AARCH64,
			@[]@[]char{buf.CopyStr("optind"), buf.CopyStr("malloc")})
	syms, err := readDynSymbolNames(so, "libx.so.1")
	if len(err) != 0 { return fail(buf.Concat("read failed: ", err)) }
	var names @[]@[]char = syms.All
	if len(names) != 5 || !charsEqual(names[0], "optind") || !charsEqual(names[1], "malloc") ||
			!charsEqual(names[2], "wk") || !charsEqual(names[3], "und") || !charsEqual(names[4], "wku") {
		return fail("not exactly the two globals, wk, und and wku")
	}
	if len(syms.Defs) != 3 || !charsEqual(syms.Defs[2], "wk") {
		return fail("the definitions are not optind, malloc, wk")
	}
	if len(syms.Refs) != 1 || !charsEqual(syms.Refs[0], "und") {
		return fail("the strong reference is not und")
	}
	_, nerr := readDynSymbolNames(mkSo("libc.so.6", true, true), "nosh.so")
	if len(nerr) == 0 { return fail("an object without section headers should be an error") }
	return ""
}

// findLibrary skips a file of the right name for another machine and takes the next one.
func TestFindLibrarySkipsOtherMachine() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	d1, e1 := os.MkdirTemp(dir, "x64_")
	d2, e2 := os.MkdirTemp(dir, "aa64_")
	if present(e1) || present(e2) { return fail("cannot create the library directories") }
	if len(fakeLibcDirs(d1, EM_X86_64, make_slice(@[]char, 0))) == 0 ||
			len(fakeLibcDirs(d2, EM_AARCH64, make_slice(@[]char, 0))) == 0 {
		return fail("cannot write the libraries")
	}
	var dirs @[]@[]char = @[]@[]char{d1, d2}
	path, _, found := findLibrary("libc.so.6", dirs, EM_AARCH64)
	if !found || !charsEqual(path, buf.Concat(d2, "/libc.so.6")) {
		return fail("did not skip the x86-64 libc")
	}
	_, _, none := findLibrary("libc.so.6", @[]@[]char{d1}, EM_AARCH64)
	if none { return fail("an x86-64 libc was taken for an aarch64 link") }
	return ""
}

// neededLibs finds libc.so.6 in the library directories and returns its names; with none
// there it is an error naming the directories searched; a `-l` libc (SONAME libc.so.6) needs
// no search; and an extra library adds its SONAME and names.
func TestNeededLibs() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var libDirs @[]@[]char = fakeLibcDirs(dir, EM_AARCH64, @[]@[]char{buf.CopyStr("optind")})
	if len(libDirs) == 0 { return fail("cannot write libc.so.6") }
	var extra @[]char = buf.Concat(dir, "/libextra.so")
	if len(writeFile(extra, mkSoSyms("libextra.so.2", EM_AARCH64, @[]@[]char{buf.CopyStr("ext")}))) !=
			0 {
		return fail("cannot write libextra.so")
	}
	libs, syms, err := neededLibs(@[]@[]char{extra}, libDirs, EM_AARCH64)
	var names @[]@[]char = syms.All
	if len(err) != 0 { return fail(buf.Concat("neededLibs failed: ", err)) }
	if len(libs) != 2 || !charsEqual(libs[0], "libc.so.6") || !charsEqual(libs[1], "libextra.so.2") {
		return fail("the needed libraries are not libc.so.6 then libextra.so.2")
	}
	// Each library's names: its globals, then wk, und and wku (mkSoSyms).
	if len(names) != 8 || !charsEqual(names[0], "optind") || !charsEqual(names[4], "ext") {
		return fail("the names are not libc's then libextra's")
	}
	_, _, merr := neededLibs(make_slice(@[]char, 0), @[]@[]char{buf.Concat(dir, "/none")}, EM_AARCH64)
	var want *[]readonly char = "cannot find an aarch64 libc.so.6 in "
	if len(merr) < len(want) || !charsEqual(merr[0:len(want)], want) {
		return fail(buf.Concat("wrong missing-libc error: ", merr))
	}
	libs2, names2, err2 := neededLibs(@[]@[]char{buf.Concat(dir, "/libc.so.6")},
			make_slice(@[]char, 0), EM_AARCH64)
	if len(err2) != 0 || len(libs2) != 1 || len(names2.All) != 4 {
		return fail("a -l libc should need no search")
	}
	// A -l libc after another library is still needed first, and only once.
	libs3, _, err3 := neededLibs(@[]@[]char{extra, buf.Concat(dir, "/libc.so.6")},
			make_slice(@[]char, 0), EM_AARCH64)
	if len(err3) != 0 || len(libs3) != 2 || !charsEqual(libs3[0], "libc.so.6") ||
			!charsEqual(libs3[1], "libextra.so.2") {
		return fail("a -l libc is not first and alone")
	}
	var x64 @[]char = buf.Concat(dir, "/libx64.so")
	if len(writeFile(x64, mkSoSyms("libx64.so.1", EM_X86_64, make_slice(@[]char, 0)))) != 0 {
		return fail("cannot write libx64.so")
	}
	_, _, ferr := neededLibs(@[]@[]char{x64}, libDirs, EM_AARCH64)
	if len(ferr) == 0 { return fail("a -l library for another machine should be an error") }
	return ""
}

// mergeLibSymbols joins the libraries' names and definitions, and keeps a strong reference only
// if none of them defines the name: a plugin's reference to libc's `malloc` is not a name the
// program must define, its `host_log` is.
func TestMergeLibSymbols() testing.TestResult {
	var each @[]libSymbols = make_slice(libSymbols, 2)
	each[0].All = @[]@[]char{buf.CopyStr("malloc"), buf.CopyStr("_dl_argv")}
	each[0].Defs = @[]@[]char{buf.CopyStr("malloc")}
	each[0].Refs = @[]@[]char{buf.CopyStr("_dl_argv")}
	each[1].All = @[]@[]char{buf.CopyStr("plugin_run"), buf.CopyStr("malloc"), buf.CopyStr("host_log")}
	each[1].Defs = @[]@[]char{buf.CopyStr("plugin_run")}
	each[1].Refs = @[]@[]char{buf.CopyStr("malloc"), buf.CopyStr("host_log")}
	var m libSymbols = mergeLibSymbols(each, 2)
	if len(m.All) != 5 || len(m.Defs) != 2 { return fail("All / Defs are not the libraries' joined") }
	if len(m.Refs) != 2 || !charsEqual(m.Refs[0], "_dl_argv") || !charsEqual(m.Refs[1], "host_log") {
		return fail("the references are not _dl_argv and host_log (malloc is libc's)")
	}
	return ""
}
