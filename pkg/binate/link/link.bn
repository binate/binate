package "pkg/binate/link"

import "pkg/binate/buf"

// Link is the top-level driver: read -> resolve -> layout -> relocate -> emit.
// It reads each object, resolves cross-object symbols, lays sections out from
// base, resolves the entry symbol's address, patches relocations, and writes the
// executable.  Errors from any stage are returned verbatim.
func Link(objectPaths @[]@[]char, entryName *[]readonly char, machine int, base uint,
		outPath *[]readonly char) @[]readonly char {
	var objs @[]@InputObject = make_slice(@InputObject, len(objectPaths))
	for i := 0; i < len(objectPaths); i++ {
		obj, err := ReadObject(objectPaths[i])
		if len(err) != 0 { return err }
		if obj.Machine != machine {
			return buf.Concat("object machine does not match the target: ", objectPaths[i])
		}
		objs[i] = obj
	}

	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return rerr }

	var lr @LayoutResult = Layout(objs, base)

	oo, ss, found := t.Lookup(entryName)
	if !found { return buf.Concat("entry symbol not defined: ", entryName) }
	entryAddr, ok := symbolAddr(t, lr, oo, ss)
	if !ok { return buf.Concat("entry symbol has no address: ", entryName) }

	var perr @[]readonly char = Relocate(t, lr)
	if len(perr) != 0 { return perr }

	return EmitElfExec(lr.Sections, entryAddr, machine, outPath)
}
