package "pkg/binate/link"

import "pkg/binate/buf"

// Link is the top-level driver: read -> select -> resolve -> layout -> relocate ->
// emit.  Each input is classified by magic: an ELF or Mach-O object is always linked;
// a `.a` archive contributes only the members that resolve undefined references
// (pulled to a fixpoint by selectMembers).  It then resolves cross-object symbols,
// lays sections out from base, resolves the entry symbol's address, patches
// relocations, and writes the executable.  Errors from any stage are returned
// verbatim.  The output is currently always ELF (EmitElfExec); a Mach-O executable
// writer, and selecting the output format, is a separate step — so a Mach-O *input*
// today is relinked into an ELF executable for the target machine.
func Link(inputPaths @[]@[]char, entryName *[]readonly char, machine int, base uint,
		outPath *[]readonly char) @[]readonly char {
	// Classify inputs (over-allocate: at most one object per input; archives kept
	// separately as pull-on-demand candidates).
	var objs @[]@InputObject = make_slice(@InputObject, len(inputPaths))
	var nObj int = 0
	var archives @[]@[]@InputObject = make_slice(@[]@InputObject, len(inputPaths))
	var nArch int = 0
	for i := 0; i < len(inputPaths); i++ {
		data, ok := readFile(inputPaths[i])
		if !ok { return buf.Concat("cannot read input file: ", inputPaths[i]) }
		// bnlint:allow managed-to-raw-assign - a live read-only view of the input bytes
		var raw *[]readonly uint8 = data
		if len(raw) >= 4 && raw[0] == 0x7f && raw[1] == 0x45 && raw[2] == 0x4c && raw[3] == 0x46 {
			obj, perr := parseObjectBytes(raw, inputPaths[i])
			if len(perr) != 0 { return perr }
			objs[nObj] = obj
			nObj = nObj + 1
		} else if len(raw) >= 4 && raw[0] == 0xcf && raw[1] == 0xfa && raw[2] == 0xed && raw[3] == 0xfe {
			obj, perr := parseMachoBytes(raw, inputPaths[i])
			if len(perr) != 0 { return perr }
			objs[nObj] = obj
			nObj = nObj + 1
		} else if arMagicOk(raw) {
			members, aerr := parseArchiveBytes(raw, inputPaths[i])
			if len(aerr) != 0 { return aerr }
			archives[nArch] = members
			nArch = nArch + 1
		} else {
			return buf.Concat("input is not an ELF/Mach-O object or an archive: ", inputPaths[i])
		}
	}

	var included @[]@InputObject = selectMembers(objs[0:nObj], archives[0:nArch])
	for i := 0; i < len(included); i++ {
		if included[i].Machine != machine {
			return buf.Concat("object machine does not match the target: ", included[i].Path)
		}
	}

	t, rerr := Resolve(included)
	if len(rerr) != 0 { return rerr }

	var lr @LayoutResult = Layout(included, base)

	oo, ss, found := t.Lookup(entryName)
	if !found { return buf.Concat("entry symbol not defined: ", entryName) }
	entryAddr, ok := symbolAddr(t, lr, oo, ss)
	if !ok { return buf.Concat("entry symbol has no address: ", entryName) }

	var perr @[]readonly char = Relocate(t, lr)
	if len(perr) != 0 { return perr }

	return EmitElfExec(lr.Sections, entryAddr, machine, outPath)
}
