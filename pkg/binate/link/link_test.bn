package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// (fail is in parse_elf_test.bn; checkLoadable in emit_elf_test.bn — same package.)

// asmToObj assembles a one-section program (built by the caller via `build`) to
// an ELF object at path.  Returns "" on success or an error message.
func asmToObj(a @asm.Assembler, path *[]readonly char) @[]char {
	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return buf.CopyStr("assembler error") }
	if !elf.WriteX86_64(a, path) { return buf.CopyStr("failed to write object") }
	return buf.CopyStr("")
}

// A single object with a _start symbol links to a loadable, owner-executable ELF
// whose entry is _start's address.
func TestLinkSingleObject() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	x64.Ret(a)
	var ae @[]char = asmToObj(a, "/tmp/binate_link_prog.o")
	if len(ae) != 0 { return ae }

	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = buf.CopyStr("/tmp/binate_link_prog.o")
	var err @[]readonly char = Link(paths, "_start", EM_X86_64, cast(uint64, 0x400000),
			"/tmp/binate_link_prog")
	if len(err) != 0 { return fail("link failed") }

	data, ok := readFile("/tmp/binate_link_prog")
	if !ok { return fail("cannot read the linked executable") }
	// _start is at the start of .text, which Layout places at the base.
	var problem @[]char = checkLoadable(data, EM_X86_64, 0x400000)
	if len(problem) != 0 { return problem }

	// The output must be owner-executable.
	fi, serr := os.Stat("/tmp/binate_link_prog")
	if present(serr) { return fail("cannot stat the output") }
	if (cast(int, fi.Mode().Perm()) & 0o100) == 0 { return fail("output should be owner-executable") }
	return ""
}

// Two objects (one calls a symbol the other defines) link end to end.
func TestLinkTwoObjects() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.SetGlobal("helper")
	x64.Call(a, "helper")
	x64.Ret(a)
	var ae @[]char = asmToObj(a, "/tmp/binate_link_2a.o")
	if len(ae) != 0 { return ae }

	var b @asm.Assembler = asm.New(8)
	b.SetSection("text", -1)
	b.DefineLabel("helper")
	b.SetGlobal("helper")
	x64.Ret(b)
	var be @[]char = asmToObj(b, "/tmp/binate_link_2b.o")
	if len(be) != 0 { return be }

	var paths @[]@[]char = make_slice(@[]char, 2)
	paths[0] = buf.CopyStr("/tmp/binate_link_2a.o")
	paths[1] = buf.CopyStr("/tmp/binate_link_2b.o")
	var err @[]readonly char = Link(paths, "_start", EM_X86_64, cast(uint64, 0x400000),
			"/tmp/binate_link_2")
	if len(err) != 0 { return fail("link failed") }

	data, ok := readFile("/tmp/binate_link_2")
	if !ok { return fail("cannot read the linked executable") }
	var problem @[]char = checkLoadable(data, EM_X86_64, 0x400000)
	if len(problem) != 0 { return problem }

	// The cross-object call must be patched: _start's call (rel32 field at base+1)
	// must land on helper — a ret (0xc3) in object B's region, past _start's 6
	// bytes (call + ret).  This proves the relocation was applied, not just that
	// the file is loadable.
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	var callField int = 0x400000 + 1
	var disp int64 = cast(int64, u32(r, fileOff(r, callField))) & 0xffffffff
	if disp >= 0x80000000 { disp = disp - 0x100000000 }
	var landing int = callField + 4 + cast(int, disp)
	if landing < 0x400000 + 6 { return fail("cross-object call did not reach object B") }
	if data[fileOff(r, landing)] != 0xc3 {
		return fail("cross-object call not patched to helper (ret)")
	}
	return ""
}

// Linking over a pre-existing non-executable file must still produce an
// owner-executable output (the unlink-then-create seam).
func TestLinkReplacesExistingOutput() testing.TestResult {
	var outp *[]readonly char = "/tmp/binate_link_relink"
	f, cerr := os.Create(outp) // mode 0o666, no execute bit
	if present(cerr) { return fail("cannot pre-create the output file") }
	_ = f.Close()

	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	x64.Ret(a)
	var ae @[]char = asmToObj(a, "/tmp/binate_link_relink.o")
	if len(ae) != 0 { return ae }

	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = buf.CopyStr("/tmp/binate_link_relink.o")
	if len(Link(paths, "_start", EM_X86_64, cast(uint64, 0x400000), outp)) != 0 {
		return fail("link failed")
	}

	fi, serr := os.Stat(outp)
	if present(serr) { return fail("cannot stat the output") }
	if (cast(int, fi.Mode().Perm()) & 0o100) == 0 {
		return fail("re-linked output should be owner-executable")
	}
	return ""
}

// Linking with an entry symbol no object defines is an error, not a crash.
func TestLinkUndefinedEntry() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("foo")
	a.SetGlobal("foo")
	x64.Ret(a)
	var ae @[]char = asmToObj(a, "/tmp/binate_link_noentry.o")
	if len(ae) != 0 { return ae }

	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = buf.CopyStr("/tmp/binate_link_noentry.o")
	var err @[]readonly char = Link(paths, "_start", EM_X86_64, cast(uint64, 0x400000),
			"/tmp/binate_link_noentry")
	if len(err) == 0 { return fail("linking with an undefined entry should be an error") }
	return ""
}

// The pipeline is machine-agnostic: an AArch64 object links to a loadable AArch64
// ELF64 executable (emit takes the machine; the reader/layout are arch-neutral).
func TestLinkAArch64() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	aarch64.Ret(a)
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	if !elf.WriteAArch64(a, "/tmp/binate_link_aa64.o") { return fail("failed to write aa64 object") }

	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = buf.CopyStr("/tmp/binate_link_aa64.o")
	var err @[]readonly char = Link(paths, "_start", EM_AARCH64, cast(uint64, 0x400000),
			"/tmp/binate_link_aa64")
	if len(err) != 0 { return fail("aarch64 link failed") }

	data, ok := readFile("/tmp/binate_link_aa64")
	if !ok { return fail("cannot read the linked executable") }
	var problem @[]char = checkLoadable(data, EM_AARCH64, 0x400000)
	if len(problem) != 0 { return problem }

	// The aa64 `ret` (0xD65F03C0, little-endian C0 03 5F D6) must land at the
	// entry's file offset — the aa64 code really went through the pipeline.
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	var fo int = fileOff(r, 0x400000)
	if data[fo] != 0xc0 || data[fo + 1] != 0x03 || data[fo + 2] != 0x5f || data[fo + 3] != 0xd6 {
		return fail("aa64 ret bytes not at the entry offset")
	}
	return ""
}

// A machine mismatch (an x86-64 object linked for the aarch64 target) is rejected.
func TestLinkMachineMismatch() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	x64.Ret(a)
	var ae @[]char = asmToObj(a, "/tmp/binate_link_mm.o") // an x86-64 object
	if len(ae) != 0 { return ae }

	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = buf.CopyStr("/tmp/binate_link_mm.o")
	var err @[]readonly char = Link(paths, "_start", EM_AARCH64, cast(uint64, 0x400000),
			"/tmp/binate_link_mm")
	if len(err) == 0 { return fail("an x86-64 object linked for aarch64 should be rejected") }
	return ""
}
