package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/macho"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Sizes and offsets past a 32-bit host's int and uint (2^31, 2^32): an input section's size and
// output offset, a symbol's value and size, and a segment's memory size are uint64, so a 32-bit
// host links a large bss as a 64-bit one does.  (mkSection and mkObjSecs are in layout_test.bn,
// testTmpDir in link_test.bn, fail in parse_elf_test.bn.)

// wideHas reports whether s contains sub.
func wideHas(s *[]readonly char, sub *[]readonly char) bool {
	for i := 0; i + len(sub) <= len(s); i++ {
		if charsEqual(s[i:i + len(sub)], sub) { return true }
	}
	return false
}

// bssObjWide returns an object holding one NOBITS .bss of size bytes, with the global symbol name
// at value in it.
func bssObjWide(name *[]readonly char, size uint64, value uint64) @InputObject {
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".bss", SF_READ | SF_WRITE, SHT_NOBITS, make_slice(uint8, 0), size, 8)
	var obj @InputObject = mkObjSecs(secs)
	obj.Symbols = make_slice(InputSymbol, 1)
	obj.Symbols[0].Name = buf.CopyStr(name)
	obj.Symbols[0].SecIndex = 0
	obj.Symbols[0].Value = value
	obj.Symbols[0].Binding = BIND_GLOBAL
	return obj
}

// Two .bss inputs, the first 2^32 + 8 bytes: the merged .bss is 2^32 + 24 zero-fill bytes (no
// host memory for them), the second input sits 2^32 + 8 into it, and a symbol 2^32 into the
// first, or 8 into the second, has the address its placement gives.
func TestLayoutBssPast4GiB() testing.TestResult {
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = bssObjWide("lo", 0x100000008, 0x100000000)
	objs[1] = bssObjWide("hi", 16, 8)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(lr.Err) != 0 { return fail(buf.Concat("layout: ", lr.Err)) }
	if len(lr.Sections) != 1 || lr.Sections[0].Size != 0x100000018 || len(lr.Sections[0].Data) != 0 {
		return fail("the merged .bss is not 2^32 + 24 zero-fill bytes")
	}
	if objs[1].Sections[0].OutOffset != 0x100000008 {
		return fail("the second .bss is not at 2^32 + 8")
	}
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return fail(buf.Concat("resolve: ", rerr)) }
	var base uint64 = lr.Sections[0].Addr
	a0, ok0 := definedAddr(t, lr, 0, 0)
	a1, ok1 := definedAddr(t, lr, 1, 0)
	if !ok0 || a0 != base + 0x100000000 { return fail("lo is not 2^32 into .bss") }
	if !ok1 || a1 != base + 0x100000010 { return fail("hi is not 2^32 + 16 into .bss") }
	return ""
}

// The readers keep a section's size and a symbol's value whole: a .bss of 2^32 + 16 bytes with
// the symbol _hi 2^32 into it, written by the assembler as an ELF64 object and as a Mach-O one.
func TestReadObjectBssPast4GiB() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	for format := 0; format < 2; format++ {
		var a @asm.Assembler = asm.New(8)
		a.ObjFormat = asm.OBJ_ELF
		if format == 1 { a.ObjFormat = asm.OBJ_MACHO }
		a.SetSection("text", -1)
		aarch64.Ret(a)
		a.SetSection("bss", -1)
		a.DefineLabel("_lo")
		a.Zero(0x100000000)
		a.DefineLabel("_hi")
		a.SetGlobal("_hi")
		a.Zero(16)
		aarch64.ResolveFixups(a)
		a.Finalize()
		if a.HasError { return fail(a.ErrorMsg) }
		var path @[]char = buf.Concat(dir, "/wide_elf.o")
		var written bool = false
		if format == 0 {
			written = elf.WriteAArch64(a, path)
		} else {
			path = buf.Concat(dir, "/wide_macho.o")
			written = macho.WriteARM64(a, path)
		}
		if !written { return fail(buf.Concat("cannot write the object: ", a.ErrorMsg)) }
		var obj @InputObject
		var rerr @[]readonly char
		if format == 0 {
			obj, rerr = ReadObject(path)
		} else {
			data, ok := readFile(path)
			if !ok { return fail("cannot read the Mach-O object") }
			obj, rerr = parseMachoBytes(data, path)
		}
		if len(rerr) != 0 { return fail(buf.Concat("read: ", rerr)) }
		var bss int = -1
		for s := 0; s < len(obj.Sections); s++ {
			if obj.Sections[s].Type == SHT_NOBITS { bss = s }
		}
		if bss < 0 || obj.Sections[bss].Size != 0x100000010 {
			return fail(buf.Concat(path, ": the .bss's size is not 2^32 + 16"))
		}
		var found bool = false
		for i := 0; i < len(obj.Symbols); i++ {
			if !charsEqual(obj.Symbols[i].Name, "_hi") { continue }
			found = obj.Symbols[i].SecIndex == bss && obj.Symbols[i].Value == 0x100000000
		}
		if !found { return fail(buf.Concat(path, ": _hi is not 2^32 into the .bss")) }
	}
	return ""
}

// wideImage returns a .text at 0x400000 and a .bss at 0x401000 of bssSize bytes.
func wideImage(bssSize uint64) @[]OutputSection {
	var secs @[]OutputSection = make_slice(OutputSection, 2)
	secs[0] = mkOutSec(".text", SF_READ | SF_EXEC, cast(uint, 0x400000), make_slice(uint8, 4),
			cast(uint, 4))
	secs[1] = mkOutSec(".bss", SF_READ | SF_WRITE, cast(uint, 0x401000), make_slice(uint8, 0),
			cast(uint, 16))
	secs[1].Size = bssSize
	return secs
}

// An executable whose .bss passes 4 GiB: an ELF64 one's bss segment has the whole size as its
// p_memsz; an ELF32 (arm32) one is refused, its image past a 32-bit target's address space, as
// is one ending a byte past 4 GiB, while one ending at 4 GiB is written.
func TestEmitElfBssPast4GiB() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var path @[]char = buf.Concat(dir, "/wide_exec")
	var e @[]readonly char = EmitElfExec(wideImage(0x100000010), cast(uint64, 0x400000), EM_X86_64,
			path)
	if len(e) != 0 { return fail(buf.Concat("ELF64: ", e)) }
	data, ok := readFile(path)
	if !ok { return fail("cannot read the emitted executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	if u16(r, 56) != 2 || u64(r, 64 + 56 + 40) != 0x100000010 {
		return fail("the bss segment's p_memsz is not 2^32 + 16")
	}
	e = EmitElfExec(wideImage(0x100000010), cast(uint64, 0x400000), EM_ARM, path)
	if len(e) == 0 || !wideHas(e, "4 GiB") { return fail("an ELF32 image past 4 GiB was emitted") }
	e = EmitElfExec(wideImage(0xFFBFF001), cast(uint64, 0x400000), EM_ARM, path)
	if len(e) == 0 || !wideHas(e, "4 GiB") {
		return fail("an ELF32 image ending a byte past 4 GiB was emitted")
	}
	e = EmitElfExec(wideImage(0xFFBFF000), cast(uint64, 0x400000), EM_ARM, path)
	if len(e) != 0 { return fail(buf.Concat("an ELF32 image ending at 4 GiB: ", e)) }
	return ""
}

// A malformed input whose section size is near 2^64 is an error, not a layout whose sizes wrap,
// with no output sections.
func TestLayoutRefusesSizesPast64Bits() testing.TestResult {
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = bssObjWide("a", 0xFFFFFFFFFFFFFF80, 0)
	objs[1] = bssObjWide("b", 16, 0)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(lr.Err) == 0 || !wideHas(lr.Err, "64-bit") || len(lr.Sections) != 0 || lr.Exidx != -1 {
		return fail("a layout past the 64-bit address range was not refused")
	}
	return ""
}

// wideOutSec returns an output section of name and flags at addr (VMA and LMA), holding data, size
// bytes long.
func wideOutSec(name *[]readonly char, flags int, addr uint64, data @[]uint8,
		size uint64) OutputSection {
	var os OutputSection
	os.Name = buf.CopyStr(name)
	os.Flags = flags
	os.Align = 8
	os.Addr = addr
	os.Lma = addr
	os.Data = data
	os.Size = size
	return os
}

// A dynamic ELF executable whose .bss passes 4 GiB: the writable PT_LOAD's p_memsz covers .data and
// the whole .bss after it, 2^32 + 32 bytes.
func TestEmitDynElfBssPast4GiB() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var secs @[]OutputSection = make_slice(OutputSection, 3)
	secs[0] = wideOutSec(".rodata", SF_READ | SF_EXEC, cast(uint64, 0x400000), make_slice(uint8, 32),
			32)
	secs[1] = wideOutSec(".data", SF_READ | SF_WRITE, cast(uint64, 0x401000), make_slice(uint8, 32),
			32)
	secs[2] = wideOutSec(".bss", SF_READ | SF_WRITE, cast(uint64, 0x401020), make_slice(uint8, 0),
			0x100000000)
	var path @[]char = buf.Concat(dir, "/wide_dynelf")
	var e @[]readonly char = EmitDynElfExec(secs, cast(uint64, 0x400000), EM_AARCH64,
			cast(uint64, 0x400000), 8, cast(uint64, 0x401000), 16, noSpan(), path)
	if len(e) != 0 { return fail(buf.Concat("EmitDynElfExec: ", e)) }
	data, ok := readFile(path)
	if !ok { return fail("cannot read the emitted executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	var phoff int = cast(int, u64(rd, 32))
	var found bool = false
	for i := 0; i < u16(rd, 56); i++ {
		var p int = phoff + i * u16(rd, 54)
		if cast(int, u32(rd, p)) != PT_LOAD || u64(rd, p + 16) != 0x401000 { continue }
		found = u64(rd, p + 40) == 0x100000020
	}
	if !found { return fail("the writable PT_LOAD's p_memsz is not 2^32 + 32") }
	return ""
}

// A dynamic Mach-O executable whose .bss passes 4 GiB: __DATA's vmsize covers the __got and the
// whole .bss (2^32 + 8 bytes, page-aligned to 2^32 + 16 KiB), and __LINKEDIT's vmaddr follows it.
func TestEmitDynMachoBssPast4GiB() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var base uint64 = cast(uint64, 0x100004000)
	var secs @[]OutputSection = make_slice(OutputSection, 3)
	secs[0] = mkTextOutSection(base, 12)
	secs[1] = mkGotOutSection(cast(uint64, 0x100008000), 1)
	secs[2] = wideOutSec(".bss", SF_READ | SF_WRITE, cast(uint64, 0x100008008), make_slice(uint8, 0),
			0x100000000)
	var imports @[]@[]char = make_slice(@[]char, 1)
	imports[0] = buf.CopyStr("_exit")
	var bindOps @[]uint8 = buildMachoBind(imports, 2, 0, globalBinds(len(imports)))
	symtab, strtab := buildMachoSymtab(imports, globalBinds(len(imports)))
	var path @[]char = buf.Concat(dir, "/wide_dynmacho")
	var e @[]readonly char = EmitDynMachoExec(secs, base, EM_AARCH64, make_slice(uint8, 0), bindOps,
			symtab, 1, strtab, "t", path)
	if len(e) != 0 { return fail(buf.Concat("EmitDynMachoExec: ", e)) }
	data, ok := readFile(path)
	if !ok { return fail("cannot read the emitted executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	var ds int = machoSegmentCmd(rd, "__DATA")
	var le int = machoSegmentCmd(rd, "__LINKEDIT")
	if ds < 0 || le < 0 { return fail("no __DATA or __LINKEDIT segment") }
	if u64(rd, ds + 32) != 0x100004000 { return fail("__DATA's vmsize is not 2^32 + 16 KiB") }
	if u64(rd, le + 24) != 0x20000C000 { return fail("__LINKEDIT's vmaddr does not follow __DATA") }
	return ""
}
