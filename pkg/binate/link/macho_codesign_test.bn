package "pkg/binate/link"

import "pkg/binate/sha256"
import "pkg/builtins/testing"

// Focused unit tests for the code-signature builder (macho_codesign.bn).  The
// end-to-end signature is also re-verified through EmitMachoExec in emit_macho_test.bn
// (and against the system codesign in the e2e); these pin the pieces directly.
// (beU32 is in emit_macho_test.bn; fail in parse_elf_test.bn — same package.)

// writeBE must lay bytes out most-significant-first.
func TestWriteBE() testing.TestResult {
	var b @[]uint8 = make_slice(uint8, 4)
	writeBE(b, 0, 0x01020304, 4)
	if b[0] != 0x01 || b[1] != 0x02 || b[2] != 0x03 || b[3] != 0x04 {
		return fail("writeBE is not big-endian")
	}
	return ""
}

// codeSlots is ceil(codeLimit / 4096): exact multiples, and one byte over a boundary.
func TestCodeSlots() testing.TestResult {
	if codeSlots(4096) != 1 { return fail("4096 bytes should be one page") }
	if codeSlots(4097) != 2 { return fail("4097 bytes should be two pages") }
	if codeSlots(0) != 0 { return fail("0 bytes should be zero pages") }
	if codeSlots(16560) != 5 { return fail("16560 bytes should be five pages") }
	return ""
}

// codeSignatureSize accounts for the SuperBlob header + index + CodeDirectory (fixed
// 88-byte header + identifier + NUL + one 32-byte hash per page).
func TestCodeSignatureSize() testing.TestResult {
	// One page, a 2-char identifier: 12 + 8 + (88 + 2 + 1 + 32) = 143.
	if codeSignatureSize(4096, 2) != 143 { return fail("wrong signature size for one page") }
	return ""
}

// writeCodeSignature must produce a SuperBlob/CodeDirectory whose codeLimit,
// nCodeSlots, and per-page SHA-256 hashes are correct — including a short final page.
func TestWriteCodeSignatureRoundTrip() testing.TestResult {
	var codeLimit int = 5000 // spans two pages; the second is 904 bytes
	var sigSize int = codeSignatureSize(codeLimit, len("id"))
	var out @[]uint8 = make_slice(uint8, codeLimit + sigSize)
	for i := 0; i < codeLimit; i++ { out[i] = cast(uint8, (i * 7 + 3) & 0xff) }
	writeCodeSignature(out, codeLimit, codeLimit, "id", 4096)

	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = out
	if cast(int64, beU32(rd, codeLimit)) != CS_MAGIC_EMBEDDED_SIGNATURE {
		return fail("no CS_SuperBlob at the signature offset")
	}
	var cdOff int = codeLimit + cast(int, beU32(rd, codeLimit + 16))
	if cast(int64, beU32(rd, cdOff)) != CS_MAGIC_CODEDIRECTORY { return fail("no CodeDirectory") }
	if cast(int, beU32(rd, cdOff + 32)) != codeLimit { return fail("codeLimit field wrong") }
	if beU32(rd, cdOff + 28) != 2 { return fail("expected two code slots") }
	if cast(int, beU32(rd, cdOff + 20)) != CD_HEADER_SIZE { return fail("identOffset should be 88") }

	// Both page hashes must match a fresh SHA-256 (the second page is short).
	var hashOff int = cdOff + cast(int, beU32(rd, cdOff + 16))
	var bounds @[]int = make_slice(int, 3)
	bounds[0] = 0
	bounds[1] = 4096
	bounds[2] = codeLimit
	for p := 0; p < 2; p++ {
		// bnlint:allow managed-to-raw-assign - live borrow of one page
		var page *[]readonly uint8 = out[bounds[p]:bounds[p + 1]]
		var want @[]uint8 = sha256.Sum256(page)
		for j := 0; j < 32; j++ {
			if out[hashOff + p * 32 + j] != want[j] { return fail("page hash mismatch") }
		}
	}

	// execSegLimit is an 8-byte big-endian field (cd + 72); it must read back as the
	// passed 4096 with a zero high word.  writeBU64 writes all 8 bytes in int64;
	// writeBE(…, 8) would shift a 32-bit int past its width on ILP32 (poison) and
	// corrupt the high word — a check the page hashes and 4-byte fields never touch.
	if beU32(rd, cdOff + 72) != 0 { return fail("execSegLimit high word should be zero") }
	if beU32(rd, cdOff + 76) != 4096 { return fail("execSegLimit low word should be 4096") }
	return ""
}
