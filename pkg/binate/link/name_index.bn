package "pkg/binate/link"

import "pkg/std/cmp"
import "pkg/std/hash"

// The global symbol table indexes its definitions by name with a stdlib
// table.Table[*[]readonly char, int, LinkNameHasher, LinkNameEq] (the field
// SymbolTable.defIndex) — the shared open-addressing engine under these
// ZERO-SIZE policies, so its hash/equality calls stay DIRECT and inlinable, at
// parity with an open-coded probe table.  It replaces the former linear
// findDefIdx scan, making definition collection and per-reference resolution
// (Lookup, called once per relocation by Relocate) O(1) amortized instead of
// O(references × defs).

// hashSymName is a djb2 hash of a symbol name.  Sign is not meaningful — the
// policy casts it to uint and the container masks to a bucket by the low bits;
// djb2 is cheap and well-distributed for the mangled symbol names the linker
// resolves.  Overflow of `h * 33` wraps and is harmless (the hash need only be
// deterministic and reasonably spread).
func hashSymName(name *[]readonly char) int {
	var h int = 5381
	for i := 0; i < len(name); i++ {
		h = h * 33 + cast(int, name[i])
	}
	return h
}

// LinkNameHasher is the zero-size hashing policy for the symbol-name table.
type LinkNameHasher struct {}

// Hash is LinkNameHasher's method.
func (h LinkNameHasher) Hash(k *[]readonly char) uint {
	return cast(uint, hashSymName(k))
}

impl LinkNameHasher : hash.Hasher[*[]readonly char]

// LinkNameEq is the equality policy paired with LinkNameHasher: byte-equality of
// the name contents (charsEqual).
type LinkNameEq struct {}

// Equal is LinkNameEq's method.
func (e LinkNameEq) Equal(a *[]readonly char, b *[]readonly char) bool {
	return charsEqual(a, b)
}

impl LinkNameEq : cmp.Eq[*[]readonly char]
