package "pkg/binate/link"

import "pkg/builtins/testing"

// (fail is defined in parse_elf_test.bn, same package.)

// LinkNameEq.Equal delegates to charsEqual: identical contents compare equal;
// differing bytes or length compare unequal (the table relies on this to confirm
// a probe hit).
func TestLinkNameEqEqual() testing.TestResult {
	var e LinkNameEq
	if !e.Equal("bn_foo", "bn_foo") { return fail("identical names must compare equal") }
	if e.Equal("bn_foo", "bn_bar") { return fail("different names must compare unequal") }
	if e.Equal("bn_foo", "bn_fo") { return fail("different-length names must compare unequal") }
	return ""
}

// LinkNameHasher.Hash is a pure function of the name bytes — equal names MUST hash
// equal (or the table would miss a present key) — and it delegates to hashSymName.
func TestLinkNameHasherHash() testing.TestResult {
	var h LinkNameHasher
	if h.Hash("bn_foo") != h.Hash("bn_foo") { return fail("equal names must hash equal") }
	if h.Hash("bn_foo") != cast(uint, hashSymName("bn_foo")) {
		return fail("Hash must delegate to hashSymName")
	}
	return ""
}

// hashSymName (djb2) distinguishes distinct short names, including permutations —
// an all-equal hash would still be correct but would degrade every probe to a
// linear scan, defeating the point of the index.
func TestHashSymNameDistinguishes() testing.TestResult {
	if hashSymName("a") == hashSymName("b") {
		return fail("distinct one-char names should hash differently")
	}
	if hashSymName("ab") == hashSymName("ba") {
		return fail("djb2 should distinguish byte order")
	}
	return ""
}
