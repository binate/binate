package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/macho"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// The readers keep an absolute symbol (an assembler constant) as one: Abs, in no section
// (SecIndex -1), its whole value in AbsValue — the object's 64 bits, or an ELF32 object's
// 32 — and its binding.  (fail is in parse_elf_test.bn, testTmpDir in link_test.bn.)

// absTestAsm returns an assembler for objFormat holding a function f and absolute symbols
// NEG = -16 (local), BIG = 0x123456789 (global) and W = 6 (weak).
func absTestAsm(ptrSize int, objFormat int) @asm.Assembler {
	var a @asm.Assembler = asm.New(ptrSize)
	a.ObjFormat = objFormat
	a.SetSection("text", -1)
	a.DefineLabel("f")
	a.EmitUint32(0xD65F03C0)
	a.DefineAbsolute("NEG", -16)
	a.SetGlobal("BIG")
	a.DefineAbsolute("BIG", 0x123456789)
	a.SetWeak("W")
	a.DefineAbsolute("W", 6)
	a.Finalize()
	return a
}

// readAbsSyms checks obj's absolute symbols against neg and big (W is always 6), and that
// f keeps its section.
func readAbsSyms(obj @InputObject, neg uint64, big uint64) @[]char {
	var seen int = 0
	for i := 0; i < len(obj.Symbols); i++ {
		var s InputSymbol = obj.Symbols[i]
		if charsEqual(s.Name, "f") && (s.SecIndex < 0 || s.Abs) {
			return buf.CopyStr("f lost its section")
		}
		if !charsEqual(s.Name, "NEG") && !charsEqual(s.Name, "BIG") && !charsEqual(s.Name, "W") {
			continue
		}
		if !s.Abs || s.SecIndex != -1 { return buf.Concat(s.Name, " not absolute, sectionless") }
		if charsEqual(s.Name, "NEG") && (s.AbsValue != neg || s.Binding != 0) {
			return buf.CopyStr("NEG not local, its value")
		}
		if charsEqual(s.Name, "BIG") && (s.AbsValue != big || s.Binding != BIND_GLOBAL) {
			return buf.CopyStr("BIG not global, its value")
		}
		if charsEqual(s.Name, "W") && (s.AbsValue != 6 || s.Binding != BIND_WEAK) {
			return buf.CopyStr("W not weak 6")
		}
		seen = seen + 1
	}
	if seen != 3 { return buf.CopyStr("NEG, BIG and W not all read") }
	return ""
}

// An ELF64 object's absolute symbols keep all 64 bits — a negative one and one past 32
// bits too, which no section offset could represent.
func TestReadElfAbsoluteSymbols() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = absTestAsm(8, asm.OBJ_ELF)
	if a.HasError { return fail("assembler error") }
	var path @[]char = buf.Concat(dir, "/abs.o")
	if !elf.WriteAArch64(a, path) { return fail("cannot write the object") }
	obj, err := ReadObject(path)
	if len(err) > 0 { return fail(buf.Concat("rejected: ", err)) }
	return readAbsSyms(obj, 0xFFFFFFFFFFFFFFF0, 0x123456789)
}

// An ELF32 object's absolute symbols hold 32 bits (the writer keeps BIG's low 32), read
// unsigned.
func TestReadElf32AbsoluteSymbols() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = absTestAsm(4, asm.OBJ_ELF)
	if a.HasError { return fail("assembler error") }
	var path @[]char = buf.Concat(dir, "/abs32.o")
	if !elf.WriteARM32(a, path, false) { return fail("cannot write the object") }
	obj, err := ReadObject(path)
	if len(err) > 0 { return fail(buf.Concat("rejected: ", err)) }
	return readAbsSyms(obj, 0xFFFFFFF0, 0x23456789)
}

// A Mach-O object's N_ABS symbols are read as absolute symbols with all 64 bits (a weak
// one is a weak definition, N_WEAK_DEF).
func TestReadMachoAbsoluteSymbols() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = absTestAsm(8, asm.OBJ_MACHO)
	if a.HasError { return fail("assembler error") }
	var path @[]char = buf.Concat(dir, "/abs_macho.o")
	if !macho.WriteARM64(a, path) { return fail("cannot write the object") }
	data, ok := readFile(path)
	if !ok { return fail("cannot read the object back") }
	obj, err := parseMachoBytes(data, path)
	if len(err) > 0 { return fail(buf.Concat("rejected: ", err)) }
	return readAbsSyms(obj, 0xFFFFFFFFFFFFFFF0, 0x123456789)
}
