package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// (fail is in parse_elf_test.bn; charsEqual in bytes.bn; asmToObj in link_test.bn —
// same package.)

// oneSymObj assembles a one-instruction (ret) x86-64 object that defines a single
// global `sym`, writes it to path, and returns its raw bytes (for embedding in a
// test archive).  Empty result means an assembler/write/read error.
func oneSymObj(sym *[]readonly char, path *[]readonly char) @[]uint8 {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel(sym)
	a.SetGlobal(sym)
	x64.Ret(a)
	if len(asmToObj(a, path)) != 0 { return make_slice(uint8, 0) }
	data, ok := readFile(path)
	if !ok { return make_slice(uint8, 0) }
	return data
}

// writeDecField writes v as a left-justified, space-padded decimal into
// dst[off:off+width] — the format of an `ar` header's numeric fields.
func writeDecField(dst @[]uint8, off int, width int, v int) {
	for i := 0; i < width; i++ { dst[off + i] = 0x20 }
	if v == 0 {
		dst[off] = 0x30
		return
	}
	var digits @[]uint8 = make_slice(uint8, 12)
	var nd int = 0
	var x int = v
	for x > 0 {
		digits[nd] = cast(uint8, 0x30 + x % 10)
		nd = nd + 1
		x = x / 10
	}
	for i := 0; i < nd; i++ { dst[off + i] = digits[nd - 1 - i] } // reverse (most-significant first)
}

// buildArchive assembles a System V `ar` archive: the magic, then one member per
// (nameField, data) pair.  nameField is written verbatim into the 16-byte name
// field (space-padded) — the caller supplies the exact `ar` spelling ("a.o/", "//",
// "/0", …).  Member data is 2-byte aligned with a trailing newline pad.
func buildArchive(nameFields @[]@[]char, datas @[]@[]uint8) @[]uint8 {
	var total int = 8
	for i := 0; i < len(datas); i++ {
		total = total + 60 + len(datas[i])
		if (len(datas[i]) & 1) != 0 { total = total + 1 }
	}
	var out @[]uint8 = make_slice(uint8, total)
	out[0] = 0x21
	out[1] = 0x3c
	out[2] = 0x61
	out[3] = 0x72
	out[4] = 0x63
	out[5] = 0x68
	out[6] = 0x3e
	out[7] = 0x0a
	var pos int = 8
	for i := 0; i < len(datas); i++ {
		var nf @[]char = nameFields[i]
		var j int = 0
		for j < 16 {
			if j < len(nf) { out[pos + j] = cast(uint8, nf[j]) } else { out[pos + j] = 0x20 }
			j = j + 1
		}
		for k := 16; k < 48; k++ { out[pos + k] = 0x20 } // mtime/uid/gid/mode
		writeDecField(out, pos + 48, 10, len(datas[i]))
		out[pos + 58] = 0x60 // '`'
		out[pos + 59] = 0x0a // '\n'
		pos = pos + 60
		for k := 0; k < len(datas[i]); k++ { out[pos + k] = datas[i][k] }
		pos = pos + len(datas[i])
		if (len(datas[i]) & 1) != 0 {
			out[pos] = 0x0a
			pos = pos + 1
		}
	}
	return out
}

// writeBytes writes data to path (truncating), returning success.
func writeBytes(path *[]readonly char, data @[]uint8) bool {
	f, cerr := os.Create(path)
	if present(cerr) { return false }
	// bnlint:allow managed-to-raw-assign - a live read-only view for the write
	var raw *[]readonly uint8 = data
	n, werr := f.Write(raw)
	_ = f.Close()
	return !present(werr) && n == len(data)
}

// objDefines reports whether obj defines (SecIndex >= 0) a symbol named name.
func objDefines(obj @InputObject, name *[]readonly char) bool {
	for i := 0; i < len(obj.Symbols); i++ {
		if obj.Symbols[i].SecIndex >= 0 && charsEqual(obj.Symbols[i].Name, name) { return true }
	}
	return false
}

// A two-member archive parses into both objects, each with its defined symbol.
func TestReadArchiveTwoMembers() testing.TestResult {
	var da @[]uint8 = oneSymObj("alpha", "/tmp/binate_ar_a.o")
	var db @[]uint8 = oneSymObj("beta", "/tmp/binate_ar_b.o")
	if len(da) == 0 || len(db) == 0 { return fail("could not build member objects") }

	var names @[]@[]char = make_slice(@[]char, 2)
	names[0] = buf.CopyStr("a.o/")
	names[1] = buf.CopyStr("b.o/")
	var datas @[]@[]uint8 = make_slice(@[]uint8, 2)
	datas[0] = da
	datas[1] = db
	if !writeBytes("/tmp/binate_ar_two.a", buildArchive(names, datas)) { return fail("write archive") }

	members, err := ReadArchive("/tmp/binate_ar_two.a")
	if len(err) != 0 { return fail("ReadArchive failed") }
	if len(members) != 2 { return fail("expected two object members") }
	if !objDefines(members[0], "alpha") { return fail("member 0 should define alpha") }
	if !objDefines(members[1], "beta") { return fail("member 1 should define beta") }
	return ""
}

// A member with a >15-char name is stored via the "//" long-name table and named
// "/N"; the reader resolves it and parses the object.
func TestReadArchiveLongName() testing.TestResult {
	var d @[]uint8 = oneSymObj("gamma", "/tmp/binate_ar_g.o")
	if len(d) == 0 { return fail("could not build member object") }

	// The "//" table: one long name, '/'-terminated then newline (GNU convention).
	var table @[]char = buf.CopyStr("a_very_long_member_name.o/\n")
	var tableBytes @[]uint8 = make_slice(uint8, len(table))
	for i := 0; i < len(table); i++ { tableBytes[i] = cast(uint8, table[i]) }

	var names @[]@[]char = make_slice(@[]char, 2)
	names[0] = buf.CopyStr("//") // the long-name table member
	names[1] = buf.CopyStr("/0") // name at offset 0 in the table
	var datas @[]@[]uint8 = make_slice(@[]uint8, 2)
	datas[0] = tableBytes
	datas[1] = d
	if !writeBytes("/tmp/binate_ar_long.a", buildArchive(names, datas)) {
		return fail("write archive")
	}

	members, err := ReadArchive("/tmp/binate_ar_long.a")
	if len(err) != 0 { return fail("ReadArchive failed") }
	if len(members) != 1 { return fail("the // table must not be returned as a member") }
	if !objDefines(members[0], "gamma") { return fail("the long-named member should define gamma") }
	return ""
}

// A file that is not an archive is rejected, not mis-parsed.
func TestReadArchiveBadMagic() testing.TestResult {
	var junk @[]uint8 = make_slice(uint8, 16)
	for i := 0; i < 16; i++ { junk[i] = cast(uint8, 0x41 + i) } // "ABCD..."
	if !writeBytes("/tmp/binate_ar_junk.a", junk) { return fail("write junk") }
	_, err := ReadArchive("/tmp/binate_ar_junk.a")
	if len(err) == 0 { return fail("a non-archive should be rejected") }
	return ""
}

// The "/" archive symbol index is skipped, not returned as an object member.
func TestReadArchiveSkipsSymbolIndex() testing.TestResult {
	var d @[]uint8 = oneSymObj("epsilon", "/tmp/binate_ar_e.o")
	if len(d) == 0 { return fail("could not build member object") }
	var symtab @[]uint8 = make_slice(uint8, 4) // the "/" member's content is irrelevant (skipped)
	var names @[]@[]char = make_slice(@[]char, 2)
	names[0] = buf.CopyStr("/") // the symbol index
	names[1] = buf.CopyStr("e.o/")
	var datas @[]@[]uint8 = make_slice(@[]uint8, 2)
	datas[0] = symtab
	datas[1] = d
	if !writeBytes("/tmp/binate_ar_sym.a", buildArchive(names, datas)) { return fail("write archive") }
	members, err := ReadArchive("/tmp/binate_ar_sym.a")
	if len(err) != 0 { return fail("ReadArchive failed") }
	if len(members) != 1 { return fail("the / symbol index must not be returned as a member") }
	if !objDefines(members[0], "epsilon") { return fail("member should define epsilon") }
	return ""
}

// A GNU member whose short name begins with "__" (but is not the BSD "__.SYMDEF"
// symbol table) is a normal object, not dropped.
func TestReadArchiveKeepsUnderscoreName() testing.TestResult {
	var d @[]uint8 = oneSymObj("zeta", "/tmp/binate_ar_z.o")
	if len(d) == 0 { return fail("could not build member object") }
	var names @[]@[]char = make_slice(@[]char, 1)
	names[0] = buf.CopyStr("__foo.o/")
	var datas @[]@[]uint8 = make_slice(@[]uint8, 1)
	datas[0] = d
	if !writeBytes("/tmp/binate_ar_us.a", buildArchive(names, datas)) { return fail("write archive") }
	members, err := ReadArchive("/tmp/binate_ar_us.a")
	if len(err) != 0 { return fail("ReadArchive failed") }
	if len(members) != 1 { return fail("a __foo.o member must not be dropped as BSD metadata") }
	if !objDefines(members[0], "zeta") { return fail("member should define zeta") }
	return ""
}

// A "/N" long-name reference with no "//" table (or N past its end) is an error,
// not a mis-read.
func TestReadArchiveBadLongNameRef() testing.TestResult {
	var dummy @[]uint8 = make_slice(uint8, 4)
	var names @[]@[]char = make_slice(@[]char, 1)
	names[0] = buf.CopyStr("/999") // offset 999, but there is no // table
	var datas @[]@[]uint8 = make_slice(@[]uint8, 1)
	datas[0] = dummy
	if !writeBytes("/tmp/binate_ar_badref.a", buildArchive(names, datas)) {
		return fail("write archive")
	}
	_, err := ReadArchive("/tmp/binate_ar_badref.a")
	if len(err) == 0 { return fail("an out-of-range /N reference should be an error") }
	return ""
}

// A corrupt member header (bad "`\n" end marker) is rejected, not mis-walked.
func TestReadArchiveBadHeaderMarker() testing.TestResult {
	var d @[]uint8 = oneSymObj("eta", "/tmp/binate_ar_h.o")
	if len(d) == 0 { return fail("could not build member object") }
	var names @[]@[]char = make_slice(@[]char, 1)
	names[0] = buf.CopyStr("h.o/")
	var datas @[]@[]uint8 = make_slice(@[]uint8, 1)
	datas[0] = d
	var ar @[]uint8 = buildArchive(names, datas)
	ar[8 + 58] = 0x20 // clobber the first member's '`' end marker
	if !writeBytes("/tmp/binate_ar_badhdr.a", ar) { return fail("write archive") }
	_, err := ReadArchive("/tmp/binate_ar_badhdr.a")
	if len(err) == 0 { return fail("a corrupt member header should be an error") }
	return ""
}
