package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/std/os"

// readFile reads the entire file at path into a fresh @[]uint8.  Returns
// (data, true) on success; (empty, false) on any open/stat/read error or a
// short read.
func readFile(path *[]readonly char) (@[]uint8, bool) {
	f, oerr := os.Open(path)
	if present(oerr) { return make_slice(uint8, 0), false }
	fi, serr := f.Stat()
	if present(serr) { _ = f.Close(); return make_slice(uint8, 0), false }
	var size int = cast(int, fi.Size())
	var data @[]uint8 = make_slice(uint8, size)
	var got int = 0
	for got < size {
		// bnlint:allow managed-to-raw-assign - borrows a live managed local; outlives the read
		var dst *[]uint8 = data[got:]
		n, rerr := f.Read(dst)
		if n <= 0 || present(rerr) { break }
		got = got + n
	}
	_ = f.Close()
	if got < size { return make_slice(uint8, 0), false }
	return data, true
}

// rangeOk reports whether [off, off+size) lies within a buffer of dlen bytes.
// off and size are expected non-negative (as returned by readOff).
func rangeOk(off int, size int, dlen int) bool {
	return off >= 0 && size >= 0 && off + size <= dlen
}

// readCStr reads a NUL-terminated string starting at byte offset off, never
// reading at or past dlen.  An out-of-range start or a missing terminator yields
// the bytes available (up to the buffer end) rather than an out-of-bounds abort,
// so a malformed string table degrades to a garbled name, not a crash.
func readCStr(b *[]readonly uint8, off int, dlen int) @[]char {
	if off < 0 || off >= dlen { return make_slice(char, 0) }
	var n int = 0
	for off + n < dlen && b[off + n] != 0 { n = n + 1 }
	var s @[]char = make_slice(char, n)
	for i := 0; i < n; i++ { s[i] = cast(char, b[off + i]) }
	return s
}

// copyBytes returns a fresh @[]uint8 holding n bytes copied from b at offset off.
// The caller must have validated that [off, off+n) is in range.
func copyBytes(b *[]readonly uint8, off int, n int) @[]uint8 {
	var out @[]uint8 = make_slice(uint8, n)
	for i := 0; i < n; i++ { out[i] = b[off + i] }
	return out
}

// normFlags maps the ELF SHF_* section flags to the normalized SF_* set.
func normFlags(shflags int) int {
	var f int = 0
	if (shflags & SHF_ALLOC) != 0 { f = f | SF_READ }
	if (shflags & SHF_WRITE) != 0 { f = f | SF_WRITE }
	if (shflags & SHF_EXECINSTR) != 0 { f = f | SF_EXEC }
	return f
}

// parseSymbols reads the object's .symtab (SHT_SYMTAB) into an InputSymbol slice,
// keeping symbols in symtab order (index 0 is the reserved null symbol) so a
// relocation's symbol index maps directly.  A symbol's defining section is mapped
// from the ELF section index through elfToMy; an undefined external gets -1.  The
// symtab and its linked .strtab lie in ranges the caller (ReadObject) has already
// validated against dlen; readCStr additionally caps every name at dlen.
func parseSymbols(data *[]readonly uint8, dlen int, fmt elfFmt, shoff int, shentsize int, shnum int,
		elfToMy *[]readonly int) (@[]InputSymbol, bool) {
	var symSh int = -1
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if cast(int, u32(data, sh + 4)) == SHT_SYMTAB { symSh = sh; break }
	}
	if symSh < 0 { return make_slice(InputSymbol, 0), true }

	symOff, ooOk := readOffC(data, symSh + fmt.ShOffset, fmt.Is64) // sh_offset
	symSize, osOk := readOffC(data, symSh + fmt.ShSize, fmt.Is64) // sh_size
	entsize, oeOk := readOffC(data, symSh + fmt.ShEntsize, fmt.Is64) // sh_entsize (Elf{32,64}_Sym)
	var strIdx int = cast(int, u32(data, symSh + fmt.ShLink)) // sh_link -> the linked .strtab
	if !ooOk || !osOk || !oeOk || entsize < fmt.SymEntBase || strIdx < 0 || strIdx >= shnum {
		return make_slice(InputSymbol, 0), false
	}
	// The linked .strtab's sh_offset.
	strOff, soOk := readOffC(data, shoff + strIdx * shentsize + fmt.ShOffset, fmt.Is64)
	if !soOk { return make_slice(InputSymbol, 0), false }

	var count int = symSize / entsize
	var syms @[]InputSymbol = make_slice(InputSymbol, count)
	for i := 0; i < count; i++ {
		var e int = symOff + i * entsize
		var nameOff int = cast(int, u32(data, e + fmt.SymName))
		var info int = cast(int, data[e + fmt.SymInfo]) // st_info: binding = info >> 4
		var shndx int = u16(data, e + fmt.SymShndx)
		value, vOk := readOffC(data, e + fmt.SymValue, fmt.Is64) // st_value
		if !vOk { return make_slice(InputSymbol, 0), false } // >32-bit value: unrepresentable, fail loud
		size, szOk := readOffC(data, e + fmt.SymSize, fmt.Is64) // st_size
		if !szOk { return make_slice(InputSymbol, 0), false } // >32-bit size: unrepresentable, fail loud

		var sym InputSymbol
		if nameOff == 0 {
			sym.Name = make_slice(char, 0)
		} else {
			sym.Name = readCStr(data, strOff + nameOff, dlen)
		}
		sym.Binding = info >> 4
		sym.Value = cast(uint, value)
		sym.Size = cast(uint, size)
		if shndx == SHN_COMMON {
			// A tentative definition (C `int x;`): st_value is its required alignment
			// (kept in Value), st_size its byte count (Size).  It occupies no section
			// until a *(COMMON) placement allocates it, so SecIndex stays -1, but Common
			// distinguishes it from an ordinary undefined external.
			sym.Common = true
			sym.SecIndex = -1
		} else if shndx == SHN_UNDEF || shndx >= shnum {
			// SHN_ABS (a defined-absolute symbol, shndx 0xfff1 >= shnum) is still folded
			// into -1 here; the current writers emit none, so nothing exercises it — model
			// it explicitly if one is ever read.
			sym.SecIndex = -1
		} else {
			sym.SecIndex = elfToMy[shndx]
		}
		syms[i] = sym
	}
	return syms, true
}

// relEntBase returns the smallest valid entry size for a relocation section of the
// given ELF type (SHT_REL vs SHT_RELA) in the given class, or -1 if the type is not
// a relocation section.
func relEntBase(fmt elfFmt, stype int) int {
	if stype == SHT_RELA { return fmt.RelaEntBase }
	if stype == SHT_REL { return fmt.RelEntBase }
	return -1
}

// relAddend reads a signed RELA addend at off (a REL section has none — its addend
// is baked into the patched field and read there by the relocator).  On ELF64 the
// addend is a 64-bit two's-complement word; on ELF32 it is a 32-bit word,
// sign-extended here so a negative addend is correct on an LP64 host too.
func relAddend(data *[]readonly uint8, off int, is64 bool) int {
	if is64 { return cast(int, u64(data, off)) }
	var a int64 = u32(data, off)
	if (a & cast(int64, 0x80000000)) != 0 { a = a | (cast(int64, -1) << cast(uint, 32)) }
	return cast(int, a)
}

// parseRelocs reads every relocation section (SHT_REL or SHT_RELA) into a single
// InputReloc slice.  Each section's sh_info names the patched content section
// (mapped through elfToMy); each entry carries r_offset, r_info (the reloc type and
// the symbol index into parseSymbols' symtab order — split (sym<<8)|type on ELF32,
// (sym<<32)|type on ELF64), and, for a RELA entry, a signed r_addend (a REL entry's
// addend is 0 here, baked into the field).  Every section's byte range is validated
// against dlen by ReadObject.
func parseRelocs(data *[]readonly uint8, dlen int, fmt elfFmt, shoff int, shentsize int, shnum int,
		elfToMy *[]readonly int) (@[]InputReloc, bool) {
	var total int = 0
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		var base int = relEntBase(fmt, cast(int, u32(data, sh + 4)))
		if base < 0 { continue }
		entsize, eOk := readOffC(data, sh + fmt.ShEntsize, fmt.Is64)
		size, sOk := readOffC(data, sh + fmt.ShSize, fmt.Is64)
		if !eOk || !sOk || entsize < base { continue }
		total = total + size / entsize
	}

	var relocs @[]InputReloc = make_slice(InputReloc, total)
	var w int = 0
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		var stype int = cast(int, u32(data, sh + 4))
		var base int = relEntBase(fmt, stype)
		if base < 0 { continue }
		roff, rOk := readOffC(data, sh + fmt.ShOffset, fmt.Is64) // sh_offset
		rsize, zOk := readOffC(data, sh + fmt.ShSize, fmt.Is64) // sh_size
		entsize, eOk := readOffC(data, sh + fmt.ShEntsize, fmt.Is64)
		if !rOk || !zOk || !eOk || entsize < base { continue }
		var applies int = cast(int, u32(data, sh + fmt.ShInfo)) // sh_info -> patched section
		var mySec int = -1
		if applies >= 0 && applies < shnum { mySec = elfToMy[applies] }
		var n int = rsize / entsize
		for j := 0; j < n; j++ {
			var e int = roff + j * entsize
			roffset, roOk := readOffC(data, e + 0, fmt.Is64) // r_offset
			if !roOk { return make_slice(InputReloc, 0), false } // >32-bit offset: fail loud
			var rel InputReloc
			rel.SecIndex = mySec
			rel.Offset = cast(uint, roffset)
			if fmt.Is64 {
				rel.Kind = cast(int, u32(data, e + fmt.RInfoOff)) // r_info low 32 = r_type
				rel.SymIndex = cast(int, u32(data, e + fmt.RInfoOff + 4)) // r_info high 32 = r_sym
			} else {
				var info int64 = u32(data, e + fmt.RInfoOff)
				rel.Kind = cast(int, info & cast(int64, 0xff)) // r_info low 8 = r_type
				rel.SymIndex = cast(int, info >> cast(uint, 8)) // r_info high 24 = r_sym
			}
			if stype == SHT_RELA {
				rel.Addend = relAddend(data, e + fmt.RAddendOff, fmt.Is64)
			} else {
				rel.Addend = 0 // REL: addend baked into the patched field
			}
			relocs[w] = rel
			w = w + 1
		}
	}
	return relocs, true
}

// ReadObject reads the relocatable ELF object at path into an InputObject: the
// header, the content sections (allocatable text/rodata/data/bss), the symbol
// table, and the relocations.  Both classes are handled — ELF64/RELA (x86-64,
// aarch64) and ELF32/REL (arm32) — selected by the EI_CLASS byte.  Structural
// offsets/sizes are validated against the file length, so a truncated or malformed
// object yields a non-empty error rather than an out-of-bounds abort.  On success
// the error is "" and the object is present; on failure the object is absent.
func ReadObject(path *[]readonly char) (@InputObject, @[]readonly char) {
	var none @InputObject
	data, ok := readFile(path)
	if !ok { return none, "cannot read object file" }
	return parseObjectBytes(data, path)
}

// parseObjectBytes parses a relocatable ELF object (either class) from an in-memory
// byte slice (a whole file's contents, or one archive member's byte range).  path is used only
// for the object's Path label and error messages — it need not be a real filesystem
// path (an archive member is labeled e.g. "libfoo.a(bar.o)").  Everything the result
// holds (section bytes, symbol names, path) is copied, so the object does not alias
// data and outlives it.  Validation matches ReadObject.
func parseObjectBytes(data *[]readonly uint8,
		path *[]readonly char) (@InputObject, @[]readonly char) {
	var none @InputObject
	var dlen int = len(data)
	if dlen < 16 { return none, "file too small for an ELF header" }
	if data[0] != 0x7f || data[1] != 0x45 || data[2] != 0x4c || data[3] != 0x46 {
		return none, "not an ELF file (bad magic)"
	}
	if data[4] != ELFCLASS32 && data[4] != ELFCLASS64 { return none, "not a 32- or 64-bit ELF object" }
	if data[5] != ELFDATA2LSB { return none, "not a little-endian ELF object" }
	var fmt elfFmt = elfFmtFor(data[4])
	if dlen < fmt.EhSize { return none, "file too small for its ELF header" }

	var machine int = u16(data, 18)
	shoff, shoffOk := readOffC(data, fmt.EShoff, fmt.Is64) // e_shoff
	var shentsize int = u16(data, fmt.EShentsize)
	var shnum int = u16(data, fmt.EShnum)
	var shstrndx int = u16(data, fmt.EShstrndx)
	if !shoffOk || shoff == 0 || shnum == 0 { return none, "object has no section headers" }
	if shentsize < fmt.ShEntBase { return none, "unsupported section-header entry size" }
	if !rangeOk(shoff, shnum * shentsize, dlen) { return none, "section-header table out of range" }
	if shstrndx >= shnum { return none, "section-name table index out of range" }

	// Validate every section's on-disk extent so later field reads are in range.
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if cast(int, u32(data, sh + 4)) == SHT_NOBITS { continue }
		soff, soffOk := readOffC(data, sh + fmt.ShOffset, fmt.Is64)
		ssize, ssizeOk := readOffC(data, sh + fmt.ShSize, fmt.Is64)
		if !soffOk || !ssizeOk || !rangeOk(soff, ssize, dlen) {
			return none, "section data out of range"
		}
	}

	// The section-name string table (validated above since shstrndx < shnum).
	strDataOff, _ := readOffC(data, shoff + shstrndx * shentsize + fmt.ShOffset, fmt.Is64)

	// Map every ELF section index to a kept content-section index.  A content
	// section is PROGBITS/NOBITS *and* SHF_ALLOC — the alloc test drops
	// .note.GNU-stack (PROGBITS, non-alloc) and debug sections, which are not
	// content the linker lays out.
	var elfToMy @[]int = make_slice(int, shnum)
	var myCount int = 0
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		var stype int = cast(int, u32(data, sh + 4))
		// sh_flags is a 4-byte field on ELF32 and 8-byte on ELF64; the SHF_* bits
		// all fit the low 32, so read them the same way for both classes.
		var flags int = cast(int, u32(data, sh + fmt.ShFlags))
		if (stype == SHT_PROGBITS || stype == SHT_NOBITS) && (flags & SHF_ALLOC) != 0 {
			elfToMy[i] = myCount
			myCount = myCount + 1
		} else {
			elfToMy[i] = -1
		}
	}

	// Read each kept section.
	var secs @[]InputSection = make_slice(InputSection, myCount)
	for i := 0; i < shnum; i++ {
		if elfToMy[i] < 0 { continue }
		var sh int = shoff + i * shentsize
		var nameOff int = cast(int, u32(data, sh + 0))
		var stype int = cast(int, u32(data, sh + 4))
		var flags int = cast(int, u32(data, sh + fmt.ShFlags))
		dataOff, doOk := readOffC(data, sh + fmt.ShOffset, fmt.Is64)
		dataSize, dsOk := readOffC(data, sh + fmt.ShSize, fmt.Is64)
		align, alOk := readOffC(data, sh + fmt.ShAlign, fmt.Is64)
		// sh_size and sh_addralign are always consumed (Size / Align); sh_offset only
		// for a section with file data — a NOBITS section's is unused, so it is not
		// fit-checked here (checked in the copy branch below).
		if !dsOk || !alOk { return none, "section size/align out of representable range" }

		var sec InputSection
		sec.Name = readCStr(data, strDataOff + nameOff, dlen)
		sec.Type = stype
		sec.Flags = normFlags(flags)
		sec.Size = cast(uint, dataSize)
		sec.Align = align
		if stype == SHT_NOBITS {
			sec.Data = make_slice(uint8, 0)
		} else {
			if !doOk { return none, "section file offset out of representable range" }
			sec.Data = copyBytes(data, dataOff, dataSize)
		}
		secs[elfToMy[i]] = sec
	}

	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr(path)
	obj.Machine = machine
	obj.Sections = secs
	syms, symOk := parseSymbols(data, dlen, fmt, shoff, shentsize, shnum, elfToMy)
	if !symOk { return none, "ELF symbol value not representable on this host" }
	obj.Symbols = syms
	rels, relOk := parseRelocs(data, dlen, fmt, shoff, shentsize, shnum, elfToMy)
	if !relOk { return none, "ELF relocation offset not representable on this host" }
	obj.Relocs = rels

	// A relocation's symbol index must be in range so every consumer can index
	// Symbols[SymIndex] without an out-of-bounds abort (the reader's contract).
	for r := 0; r < len(obj.Relocs); r++ {
		if obj.Relocs[r].SymIndex < 0 || obj.Relocs[r].SymIndex >= len(obj.Symbols) {
			return none, "relocation symbol index out of range"
		}
	}
	return obj, ""
}
