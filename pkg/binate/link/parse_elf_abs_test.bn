package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/elf"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// An absolute symbol's value is a number, not an offset: an object listing a negative or
// past-32-bit constant (`NEG = -16`, `BIG = 0x123456789`) is read, the symbols kept as
// absolute symbols are today — with no section (SecIndex -1) — and the rest of the object
// unaffected.  (fail is in parse_elf_test.bn, testTmpDir in link_test.bn.)
func TestReadElfAbsoluteSymbolValues() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("f")
	a.EmitUint32(0xD65F03C0) // ret
	a.DefineAbsolute("NEG", -16)
	a.DefineAbsolute("BIG", 0x123456789)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	var path @[]char = buf.Concat(dir, "/abs.o")
	if !elf.WriteAArch64(a, path) { return fail("cannot write the object") }
	obj, err := ReadObject(path)
	if len(err) > 0 { return fail(buf.Concat("rejected: ", err)) }
	var seen int = 0
	for i := 0; i < len(obj.Symbols); i++ {
		var s InputSymbol = obj.Symbols[i]
		if charsEqual(s.Name, "NEG") || charsEqual(s.Name, "BIG") {
			if s.SecIndex != -1 || s.Binding != 0 {
				return fail("an absolute symbol not local, sectionless")
			}
			seen = seen + 1
		}
		if charsEqual(s.Name, "f") && s.SecIndex < 0 { return fail("f lost its section") }
	}
	if seen != 2 { return fail("NEG and BIG not both read") }
	return ""
}
