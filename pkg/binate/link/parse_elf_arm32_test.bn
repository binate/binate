package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/elf"
import "pkg/builtins/testing"

// relForSymKind returns the index of the first relocation whose symbol is named
// symName AND whose kind is kind, or -1 — needed because one symbol (gvar) is
// referenced by several relocation kinds (MOVW/MOVT/ABS32).
func relForSymKind(obj @InputObject, symName *[]readonly char, kind int) int {
	for i := 0; i < len(obj.Relocs); i++ {
		if obj.Relocs[i].Kind != kind { continue }
		var s int = obj.Relocs[i].SymIndex
		if s >= 0 && s < len(obj.Symbols) && charsEqual(obj.Symbols[s].Name, symName) {
			return i
		}
	}
	return -1
}

// Round-trip an arm32 (ELF32/REL) object: assemble a tiny .text (a single BX LR),
// write it with WriteARM32, read it back, and check the machine plus the .text
// section's type, flags, and bytes.  Exercises the ELF32 header + section-header
// parsing path (distinct field offsets and widths from ELF64).
func TestReadElfArm32TextSection() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	arm32.Bx(a, arm32.COND_AL, arm32.LR)

	if !arm32.ResolveFixups(a) { return fail("arm32 fixup resolution failed") }
	a.Finalize()
	if a.HasError { return fail("assembler error") }

	var path *[]readonly char = "/tmp/binate_link_arm32_text.o"
	if !elf.WriteARM32(a, path, false) { return fail("failed to write ELF32 object") }

	obj, err := ReadObject(path)
	if len(err) != 0 { return fail("ReadObject returned an error") }
	if obj.Machine != EM_ARM { return fail("wrong e_machine (expected arm32)") }

	var ti int = findSection(obj, ".text")
	if ti < 0 { return fail("no .text section in the object") }
	var t InputSection = obj.Sections[ti]
	if t.Type != SHT_PROGBITS { return fail(".text is not SHT_PROGBITS") }
	if (t.Flags & SF_EXEC) == 0 { return fail(".text is missing SF_EXEC") }
	if (t.Flags & SF_READ) == 0 { return fail(".text is missing SF_READ") }
	if len(t.Data) != 4 { return fail(".text should be one 4-byte instruction (BX LR)") }
	// BX LR = 0xE12FFF1E, little-endian.
	if t.Data[0] != 0x1e || t.Data[1] != 0xff || t.Data[2] != 0x2f || t.Data[3] != 0xe1 {
		return fail(".text bytes should be BX LR (0xE12FFF1E)")
	}
	return ""
}

// Symbol round-trip on ELF32: Elf32_Sym orders its fields differently from
// Elf64_Sym (name/value/size/info/other/shndx vs name/info/other/shndx/value/
// size), so a defined global and an undefined external must both surface with the
// right binding and defining section.
func TestReadElfArm32Symbols() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.SetGlobal("ext") // declared global but never defined -> undefined external
	arm32.Bx(a, arm32.COND_AL, arm32.LR)

	if !arm32.ResolveFixups(a) { return fail("arm32 fixup resolution failed") }
	a.Finalize()
	if a.HasError { return fail("assembler error") }

	var path *[]readonly char = "/tmp/binate_link_arm32_syms.o"
	if !elf.WriteARM32(a, path, false) { return fail("failed to write ELF32 object") }

	obj, err := ReadObject(path)
	if len(err) != 0 { return fail("ReadObject returned an error") }

	var textIdx int = findSection(obj, ".text")
	if textIdx < 0 { return fail("no .text section") }

	var si int = findSymbol(obj, "_start")
	if si < 0 { return fail("_start symbol not found") }
	var start InputSymbol = obj.Symbols[si]
	if start.Binding != BIND_GLOBAL { return fail("_start should be a global symbol") }
	if start.SecIndex != textIdx { return fail("_start should be defined in .text") }
	if start.Value != cast(uint, 0) { return fail("_start should be at offset 0") }

	var ei int = findSymbol(obj, "ext")
	if ei < 0 { return fail("ext symbol not found") }
	var ext InputSymbol = obj.Symbols[ei]
	if ext.Binding != BIND_GLOBAL { return fail("ext should be a global symbol") }
	if ext.SecIndex != -1 { return fail("ext should be undefined (SecIndex -1)") }
	return ""
}

// Relocation round-trip on ELF32/REL: an arm32 object uses SHT_REL (no r_addend
// word — the addend is baked into the patched field), and r_info packs
// (sym<<8)|type rather than ELF64's (sym<<32)|type.  A cross-object branch emits
// R_ARM_JUMP24 (bnas encodes both B and BL as a 24-bit branch relocation; the
// CALL/JUMP24 distinction is a relocator concern, tested there), MOVW/MOVT-label
// emit MOVW_ABS_NC/MOVT_ABS, and a word-absolute data slot emits R_ARM_ABS32.
// Read them back and check kind, patched section, symbol, and a zero (REL) addend.
func TestReadElfArm32Relocs() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.SetGlobal("extbranch")
	a.SetGlobal("gvar")
	arm32.Bl(a, arm32.COND_AL, "callee") // defined, same section -> resolved in place, no reloc
	arm32.Bl(a, arm32.COND_AL, "extbranch") // undefined -> R_ARM_JUMP24
	arm32.MovwLabel(a, arm32.COND_AL, arm32.R0, "gvar") // R_ARM_MOVW_ABS_NC
	arm32.MovtLabel(a, arm32.COND_AL, arm32.R0, "gvar") // R_ARM_MOVT_ABS
	a.DefineLabel("callee")
	a.SetGlobal("callee")
	arm32.Bx(a, arm32.COND_AL, arm32.LR)

	a.SetSection("data", -1)
	a.AddFixup("gvar", arm32.FIX_ABS32, 0, 4) // R_ARM_ABS32 on a data word
	a.Fill(4, cast(uint8, 0))

	if !arm32.ResolveFixups(a) { return fail("arm32 fixup resolution failed") }
	a.Finalize()
	if a.HasError { return fail("assembler error") }

	var path *[]readonly char = "/tmp/binate_link_arm32_relocs.o"
	if !elf.WriteARM32(a, path, false) { return fail("failed to write ELF32 object") }

	obj, err := ReadObject(path)
	if len(err) != 0 { return fail("ReadObject returned an error") }

	var textIdx int = findSection(obj, ".text")
	if textIdx < 0 { return fail("no .text section") }
	var dataIdx int = findSection(obj, ".data")
	if dataIdx < 0 { return fail("no .data section") }

	var rc int = relForSymKind(obj, "extbranch", R_ARM_JUMP24)
	if rc < 0 { return fail("no R_ARM_JUMP24 relocation referencing extbranch") }
	if obj.Relocs[rc].SecIndex != textIdx { return fail("extbranch relocation should patch .text") }
	if obj.Relocs[rc].Addend != 0 { return fail("REL relocation addend should be 0 (baked in field)") }

	if relForSymKind(obj, "gvar", R_ARM_MOVW_ABS_NC) < 0 {
		return fail("no R_ARM_MOVW_ABS_NC relocation referencing gvar")
	}
	if relForSymKind(obj, "gvar", R_ARM_MOVT_ABS) < 0 {
		return fail("no R_ARM_MOVT_ABS relocation referencing gvar")
	}
	var ra int = relForSymKind(obj, "gvar", R_ARM_ABS32)
	if ra < 0 { return fail("no R_ARM_ABS32 relocation referencing gvar") }
	if obj.Relocs[ra].SecIndex != dataIdx { return fail("gvar ABS32 relocation should patch .data") }

	// The same-section BL to callee is resolved in place, so it produces no reloc.
	if relForSymKind(obj, "callee", R_ARM_CALL) >= 0 {
		return fail("a same-section BL should be resolved in place, not left as a reloc")
	}
	return ""
}
