package "pkg/binate/link"

// An arm32 object's build attributes (`.ARM.attributes`, AAELF32's "aeabi" subsection) say which
// architecture its code needs: Tag_CPU_arch.  bnld reads that tag to know whether a call it
// rewrites may become BLX, which ARMv5T introduced (patchArm32Branch), as lld does.

// SHT_ARM_ATTRIBUTES marks arm32's build-attributes section (`.ARM.attributes`).
const SHT_ARM_ATTRIBUTES int = 0x70000003

// armTagCPUArch is Tag_CPU_arch's tag; armArchV5T its value for ARMv5T, every later
// architecture's being larger.
const (
	armTagCPUArch int = 6
	armArchV5T int = 3
)

// elfArmBlx reports whether the arm32 object data has a `.ARM.attributes` section whose
// Tag_CPU_arch is ARMv5T or later.
func elfArmBlx(data *[]readonly uint8, fmt elfFmt, shoff int, shentsize int, shnum int) bool {
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if cast(int, u32(data, sh + 4)) != SHT_ARM_ATTRIBUTES { continue }
		off, ook := readOffC(data, sh + fmt.ShOffset, fmt.Is64)
		size, sok := readOffC(data, sh + fmt.ShSize, fmt.Is64)
		if !ook || !sok || !rangeOk(off, size, len(data)) { return false }
		return armAttrCPUArch(data[off:off + size]) >= armArchV5T
	}
	return false
}

// armAttrCPUArch returns the file-scope Tag_CPU_arch of a `.ARM.attributes` section's
// contents, or -1 when it has none (or is malformed): a format byte 'A', then subsections --
// a 4-byte length, a vendor's name -- of which "aeabi"'s holds sub-subsections, a tag byte and
// a 4-byte length each, the file's (tag 1) a list of attributes (armAttrSkip).
func armAttrCPUArch(sec *[]readonly uint8) int {
	if len(sec) < 1 || sec[0] != 'A' { return -1 }
	var p int = 1
	for p + 4 <= len(sec) {
		var n int = cast(int, u32(sec, p))
		if n < 4 || n > len(sec) - p { return -1 }
		var end int = p + n
		var q int = p + 4
		var vendor int = q
		for q < end && sec[q] != 0 { q = q + 1 }
		if q >= end { return -1 }
		if charsEqual(sec[vendor:q], "aeabi") {
			q = q + 1
			for q + 5 <= end {
				var m int = cast(int, u32(sec, q + 1))
				if m < 5 || m > end - q { return -1 }
				if sec[q] == 1 {
					var v int = armAttrFind(sec, q + 5, q + m, armTagCPUArch)
					if v != -1 { return v }
				}
				q = q + m
			}
		}
		p = end
	}
	return -1
}

// armAttrFind returns the number attribute want in the attribute list sec[p:end], or -1 when
// the list has none or ends malformed.
func armAttrFind(sec *[]readonly uint8, p int, end int, want int) int {
	for p >= 0 && p < end {
		var tag int
		tag, p = readUleb(sec, p, end)
		if p < 0 { return -1 }
		if tag == want {
			var v int
			v, p = readUleb(sec, p, end)
			if p < 0 { return -1 }
			return v
		}
		p = armAttrSkip(sec, p, end, tag)
	}
	return -1
}

// armAttrSkip returns the index after tag's value at p in sec (ending at end), or -1 when it
// runs past end: a NUL-terminated string for Tag_CPU_raw_name (4), Tag_CPU_name (5) and every
// odd tag past 32; Tag_compatibility (32) a number, then a string; any other tag a ULEB128
// number.
func armAttrSkip(sec *[]readonly uint8, p int, end int, tag int) int {
	if tag == 32 {
		p = skipLeb(sec, p, end)
		if p < 0 { return -1 }
	}
	if tag == 4 || tag == 5 || tag == 32 || (tag > 32 && tag % 2 == 1) {
		for p < end && sec[p] != 0 { p = p + 1 }
		if p >= end { return -1 }
		return p + 1
	}
	return skipLeb(sec, p, end)
}
