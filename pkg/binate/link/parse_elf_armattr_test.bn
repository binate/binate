package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/elf"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// armAttrBytes returns a `.ARM.attributes` section: a "gnu" vendor subsection, then an "aeabi"
// one holding one sub-subsection with tag and the attribute bytes attrs.
func armAttrBytes(tag uint8, attrs *[]readonly char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, 1 + 9 + 4 + 6 + 5 + len(attrs))
	var n int = 0
	b[n] = 'A'
	n = n + 1
	// A "gnu" subsection: length 9 (itself, "gnu\0", one byte).
	n = putBytes(b, n, "\x09\x00\x00\x00gnu\x00\x06")
	// "aeabi": length 4 + 6 + the sub-subsection (5 + its attributes).
	n = putU32(b, n, 4 + 6 + 5 + len(attrs))
	n = putBytes(b, n, "aeabi\x00")
	b[n] = tag
	n = n + 1
	n = putU32(b, n, 5 + len(attrs))
	n = putBytes(b, n, attrs)
	return b
}

// putBytes copies s into b at n and returns the index after it.
func putBytes(b @[]uint8, n int, s *[]readonly char) int {
	for i := 0; i < len(s); i++ { b[n + i] = s[i] }
	return n + len(s)
}

// putU32 writes v into b at n, little-endian, and returns the index after it.
func putU32(b @[]uint8, n int, v int) int {
	writeU32(b, n, cast(int64, v))
	return n + 4
}

// armAttrCPUArch reads the file-scope Tag_CPU_arch after attributes of each kind -- a string
// (Tag_conformance, Tag_CPU_name), a number and a string (Tag_compatibility), a number -- and
// past a vendor subsection that is not "aeabi"; the tag in a section's or symbol's attributes
// (Tag_Section) is not the file's.
func TestArmAttrCPUArch() testing.TestResult {
	var attrs *[]readonly char = "\x43\x32\x2e\x30\x39\x00\x05\x37\x2d\x41\x00\x20\x01\x78\x00\x06\x0a"
	if armAttrCPUArch(armAttrBytes(1, attrs)) != 10 { return fail("Tag_CPU_arch v7 not read") }
	if armAttrCPUArch(armAttrBytes(2, attrs)) != -1 { return fail("a section's Tag_CPU_arch read") }
	// Tag_ARM_ISA_use in its place.
	if armAttrCPUArch(armAttrBytes(1, "\x05\x37\x2d\x41\x00\x08\x0a")) != -1 {
		return fail("a section without the tag read one")
	}
	return ""
}

// A malformed section has no Tag_CPU_arch: one of another format, one cut short (the
// subsection's length past its end), a string with no NUL, a number running past the end, a
// sub-subsection's length past its subsection's or below its own header's.
func TestArmAttrCPUArchMalformed() testing.TestResult {
	var good @[]uint8 = armAttrBytes(1, "\x06\x0a")
	if armAttrCPUArch(good) != 10 { return fail("the well-formed section not read") }
	if armAttrCPUArch(good[0:len(good) - 1]) != -1 { return fail("a truncated section read a tag") }
	good[0] = 'B'
	if armAttrCPUArch(good) != -1 { return fail("a section of another format read a tag") }
	if armAttrCPUArch(armAttrBytes(1, "\x05\x37\x2d")) != -1 {
		return fail("an unterminated string read")
	}
	if armAttrCPUArch(armAttrBytes(1, "\x08\x8a")) != -1 { return fail("a number past the end read") }
	var long @[]uint8 = armAttrBytes(1, "\x06\x0a")
	writeU32(long, 1 + 9 + 4 + 6 + 1, cast(int64, 5 + 3))
	if armAttrCPUArch(long) != -1 { return fail("a sub-subsection past its subsection read") }
	writeU32(long, 1 + 9 + 4 + 6 + 1, cast(int64, 4))
	if armAttrCPUArch(long) != -1 { return fail("a sub-subsection shorter than its header read") }
	return ""
}

// setSectionType sets, in the ELF32 object data, the sh_type of every section of type from to
// to, and reports whether there was one.
func setSectionType(data @[]uint8, from int, to int) bool {
	var fmt elfFmt = elfFmtFor(data[4])
	shoff, ok := readOffC(data, fmt.EShoff, fmt.Is64)
	if !ok { return false }
	var shentsize int = u16(data, fmt.EShentsize)
	var found bool = false
	for i := 0; i < u16(data, fmt.EShnum); i++ {
		var sh int = shoff + i * shentsize
		if cast(int, u32(data, sh + 4)) != from { continue }
		writeU32(data, sh + 4, cast(int64, to))
		found = true
	}
	return found
}

// ReadObject marks an arm32 object ArmBlx when its build attributes name ARMv5T or later --
// bnas's default, ARMv7 -- and not for ARMv4T, nor for an object with no `.ARM.attributes` (its
// section's type changed here to SHT_PROGBITS, which a non-allocated section is ignored as).
func TestReadElfArmBlx() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var arch int = -1
	for k := 0; k < 2; k++ {
		var a @asm.Assembler = asm.New(4)
		if arch >= 0 { a.SetArmAttr(6, cast(int64, arch), "") }
		a.SetSection("text", -1)
		arm32.Bx(a, arm32.COND_AL, arm32.LR)
		a.Finalize()
		var path @[]char = buf.Concat(dir, "/armblx.o")
		if a.HasError || !elf.WriteARM32(a, path) { return fail("write failed") }
		data, rok := readFile(path)
		if !rok { return fail("cannot read the object back") }
		obj, e := readObjectBytes(data, path)
		if len(e) != 0 || obj.ArmBlx != (arch < 0) {
			return fail("ArmBlx not the attributes' architecture")
		}
		if arch < 0 {
			if !setSectionType(data, SHT_ARM_ATTRIBUTES, 1) { return fail("no .ARM.attributes") }
			obj, e = readObjectBytes(data, path)
			if len(e) != 0 || obj.ArmBlx {
				return fail("an object with no build attributes taken as ArmBlx")
			}
		}
		arch = 2
	}
	return ""
}
