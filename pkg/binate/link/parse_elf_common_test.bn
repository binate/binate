package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// The ELF reader's common symbols: an assembled object's SHN_COMMON entry.  (fail / findSymbol
// are in parse_elf_test.bn, testTmpDir in link_test.bn.)

// A SHN_COMMON symbol surfaces as Common with its size and alignment, distinct from an
// ordinary undefined external.
func TestReadElfCommonSymbol() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.DefineCommon("commonvar", 16, 8)
	a.SetGlobal("plainext")
	x64.Ret(a)

	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }

	var path @[]char = buf.Concat(dir, "/link_common.o")
	if !elf.WriteX86_64(a, path) { return fail("failed to write ELF object") }

	obj, err := ReadObject(path)
	if len(err) != 0 { return fail("ReadObject returned an error") }
	var ci int = findSymbol(obj, "commonvar")
	if ci < 0 { return fail("commonvar symbol not found") }
	var cv InputSymbol = obj.Symbols[ci]
	if !cv.Common { return fail("commonvar should be a common symbol") }
	if cv.SecIndex != -1 { return fail("a common symbol has no section (SecIndex -1)") }
	if cv.Size != cast(uint, 16) { return fail("commonvar size should be 16") }
	if cv.Value != cast(uint, 8) { return fail("commonvar alignment (Value) should be 8") }

	// A plain undefined external stays non-common.
	var si int = findSymbol(obj, "plainext")
	if si < 0 || obj.Symbols[si].Common { return fail("plainext must not be flagged common") }
	return ""
}
