package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// (fail / findSymbol are in parse_elf_test.bn; readFile / writeFile / u16 / u32 /
// readOff / readCStr / writeLE / writeU64 / charsEqual in the package — all same
// package.)  The assembler emits no SHN_COMMON symbols (they come from a C compiler's
// tentative definitions), so this test assembles a real object with an undefined global
// and rewrites that symbol's table entry to SHN_COMMON, then re-reads it — exercising
// the reader's common branch on genuine ELF bytes.

// patchSymToCommon finds the symbol named `name` in the object's SHT_SYMTAB and rewrites
// its entry to a common symbol: st_shndx = SHN_COMMON, st_value = align, st_size = size.
// Returns true if the symbol was found and patched.
func patchSymToCommon(data @[]uint8, name *[]readonly char, size uint64, align uint64) bool {
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow for the field reads
	var r *[]readonly uint8 = data
	var dlen int = len(data)
	shoff, ok := readOff(r, 40) // e_shoff
	if !ok { return false }
	var shentsize int = u16(r, 58)
	var shnum int = u16(r, 60)
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if cast(int, u32(r, sh + 4)) != SHT_SYMTAB { continue }
		symOff, soOk := readOff(r, sh + 24) // sh_offset
		symSize, ssOk := readOff(r, sh + 32) // sh_size
		entsize, eOk := readOff(r, sh + 56) // sh_entsize
		var strIdx int = cast(int, u32(r, sh + 40)) // sh_link -> .strtab
		if !soOk || !ssOk || !eOk || entsize < 24 || strIdx < 0 || strIdx >= shnum { return false }
		strOff, stOk := readOff(r, shoff + strIdx * shentsize + 24)
		if !stOk { return false }
		var count int = symSize / entsize
		for j := 0; j < count; j++ {
			var e int = symOff + j * entsize
			var nameOff int = cast(int, u32(r, e + 0))
			if nameOff == 0 { continue }
			if charsEqual(readCStr(r, strOff + nameOff, dlen), name) {
				writeLE(data, e + 6, SHN_COMMON, 2) // st_shndx
				writeU64(data, e + 8, align) // st_value = required alignment
				writeU64(data, e + 16, size) // st_size = byte count
				return true
			}
		}
	}
	return false
}

// A SHN_COMMON symbol surfaces as Common with its size and alignment, distinct from an
// ordinary undefined external.
func TestReadElfCommonSymbol() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.SetGlobal("commonvar") // undefined global -> its table entry gets patched to COMMON
	x64.Ret(a)

	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }

	var path *[]readonly char = "/tmp/binate_link_common.o"
	if !elf.WriteX86_64(a, path) { return fail("failed to write ELF object") }
	data, ok := readFile(path)
	if !ok { return fail("cannot read the assembled object") }
	if !patchSymToCommon(data, "commonvar", cast(uint64, 16), cast(uint64, 8)) {
		return fail("commonvar symbol not found to patch")
	}
	if len(writeFile(path, data)) != 0 { return fail("cannot rewrite the patched object") }

	obj, err := ReadObject(path)
	if len(err) != 0 { return fail("ReadObject returned an error") }
	var ci int = findSymbol(obj, "commonvar")
	if ci < 0 { return fail("commonvar symbol not found") }
	var cv InputSymbol = obj.Symbols[ci]
	if !cv.Common { return fail("commonvar should be a common symbol") }
	if cv.SecIndex != -1 { return fail("a common symbol has no section (SecIndex -1)") }
	if cv.Size != cast(uint, 16) { return fail("commonvar size should be 16") }
	if cv.Value != cast(uint, 8) { return fail("commonvar alignment (Value) should be 8") }

	// A plain undefined external stays non-common.
	var si int = findSymbol(obj, "_start")
	if si < 0 || obj.Symbols[si].Common { return fail("_start must not be flagged common") }
	return ""
}
