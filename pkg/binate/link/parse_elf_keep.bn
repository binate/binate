package "pkg/binate/link"

import "pkg/binate/buf"

// Which input sections the ELF reader keeps, and what it rejects about the ones it drops.  It
// keeps the allocatable sections a link lays out — program bits, zero-fill, and the init /
// fini / preinit arrays — and drops the rest: non-allocated ones (debug info, symbol / string /
// relocation tables) and allocatable ones of other types (notes; x86-64's `.eh_frame`, typed
// SHT_X86_64_UNWIND, and arm32's `.ARM.exidx` — aarch64's `.eh_frame` is PROGBITS and kept).
// A dropped section is not in the output, so a symbol defined in one has no address: a kept
// section's relocation against such a symbol, or a global / weak one defined in a dropped
// allocatable section, rejects the object, rather than binding the reference by name to
// another object's symbol or resolving it to 0.

// elfKeepsSection reports whether the reader keeps a section of ELF type stype whose sh_flags
// (their low 32 bits) are flags.
func elfKeepsSection(stype int, flags int) bool {
	if (flags & SHF_ALLOC) == 0 { return false }
	return stype == SHT_PROGBITS || stype == SHT_NOBITS || stype == SHT_INIT_ARRAY ||
			stype == SHT_FINI_ARRAY || stype == SHT_PREINIT_ARRAY
}

// isCtorsSection reports whether name is a `.ctors` / `.dtors` section (or `.ctors.N`,
// `.dtors.N`): the older constructor tables, which only the C runtime's crtend.o / crtbegin.o
// code walks — and bnld links neither, so their functions would silently never run.
func isCtorsSection(name *[]readonly char) bool {
	return namePrefixed(name, ".ctors") || namePrefixed(name, ".dtors")
}

// namePrefixed reports whether name is prefix, or prefix followed by '.'.
func namePrefixed(name *[]readonly char, prefix *[]readonly char) bool {
	if len(name) < len(prefix) || !charsEqual(name[0:len(prefix)], prefix) { return false }
	return len(name) == len(prefix) || name[len(prefix)] == '.'
}

// elfSectionName returns the name of ELF section idx (headers at shoff, shentsize apart; the
// section-name string table's data at strDataOff).
func elfSectionName(data *[]readonly uint8, dlen int, shoff int, shentsize int, strDataOff int,
		idx int) @[]char {
	return readCStr(data, strDataOff + cast(int, u32(data, shoff + idx * shentsize)), dlen)
}

// droppedDefinitionError returns why obj — read from data, its section headers at shoff
// (shentsize apart), their names at strDataOff — cannot be linked for a symbol in a section
// the reader dropped (elfToMy -1), or "": it defines a global or weak symbol in a dropped
// allocatable section, or a kept section's relocation refers to any symbol defined in a
// dropped section.  defShndx[i] is symbol i's ELF section index, 0 when it has none
// (parseSymbols).  The relocations' symbol indices are in range.
func droppedDefinitionError(data *[]readonly uint8, dlen int, fmt elfFmt, shoff int, shentsize int,
		strDataOff int, elfToMy *[]readonly int, obj @InputObject,
		defShndx *[]readonly int) @[]readonly char {
	for i := 0; i < len(obj.Symbols); i++ {
		var sx int = defShndx[i]
		if sx <= 0 || elfToMy[sx] >= 0 { continue }
		var b int = obj.Symbols[i].Binding
		if b != BIND_GLOBAL && b != BIND_WEAK { continue }
		if (cast(int, u32(data, shoff + sx * shentsize + fmt.ShFlags)) & SHF_ALLOC) == 0 { continue }
		var kind *[]readonly char = "global symbol "
		if b == BIND_WEAK { kind = "weak symbol " }
		var msg @[]char = buf.Concat(buf.Concat(kind, obj.Symbols[i].Name), " is defined in ")
		return buf.Concat(msg, droppedName(data, dlen, shoff, shentsize, strDataOff, sx))
	}
	for r := 0; r < len(obj.Relocs); r++ {
		var rel InputReloc = obj.Relocs[r]
		if rel.SecIndex < 0 { continue }
		var sx int = defShndx[rel.SymIndex]
		if sx <= 0 || elfToMy[sx] >= 0 { continue }
		var msg @[]char = buf.Concat("a relocation in ", obj.Sections[rel.SecIndex].Name)
		if len(obj.Symbols[rel.SymIndex].Name) > 0 {
			msg = buf.Concat(buf.Concat(msg, " refers to "), obj.Symbols[rel.SymIndex].Name)
			msg = buf.Concat(msg, ", in ")
		} else {
			msg = buf.Concat(msg, " refers to ")
		}
		return buf.Concat(msg, droppedName(data, dlen, shoff, shentsize, strDataOff, sx))
	}
	return ""
}

// droppedName describes dropped ELF section idx for an error: "<name>, which bnld does not
// link".
func droppedName(data *[]readonly uint8, dlen int, shoff int, shentsize int, strDataOff int,
		idx int) @[]char {
	var name @[]char = elfSectionName(data, dlen, shoff, shentsize, strDataOff, idx)
	return buf.Concat(name, ", which bnld does not link")
}
