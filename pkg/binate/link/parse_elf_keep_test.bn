package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// sectionHeaderNamed returns the file offset of the section header named name in the ELF
// object (either class) data, or -1.
func sectionHeaderNamed(data *[]readonly uint8, name *[]readonly char) int {
	var f elfFmt = elfFmtFor(data[4])
	shoff, _ := readOffC(data, f.EShoff, f.Is64)
	var shentsize int = u16(data, f.EShentsize)
	var shnum int = u16(data, f.EShnum)
	var strIdx int = u16(data, f.EShstrndx)
	strOff, _ := readOffC(data, shoff + strIdx * shentsize + f.ShOffset, f.Is64)
	for i := 0; i < shnum; i++ {
		var got @[]char = elfSectionName(data, len(data), shoff, shentsize, strOff, i)
		if charsEqual(got, name) { return shoff + i * shentsize }
	}
	return -1
}

// keepFixture assembles an x86-64 object — `.text` with f (and `lea rax, [rip + label]` when
// lea), and a section named secName defining label (global when global) and an 8-byte pointer
// to f — writes it, and returns its bytes with secName's sh_type set to stype and sh_flags to
// shflags, as a C compiler's object would have them.  Empty on failure.
func keepFixture(dir *[]readonly char, secName *[]readonly char, label *[]readonly char,
		shflags int, global bool, stype int, lea bool) @[]uint8 {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("f")
	a.SetGlobal("f")
	if lea { x64.LeaRipLabel(a, x64.Reg(x64.RAX, x64.SZ64), label) }
	x64.Ret(a)
	a.SetSection(secName, SF_READ)
	a.DefineLabel(label)
	if global { a.SetGlobal(label) }
	a.AddFixup("f", asm.FIX_DATA_ABS64, 0, 8)
	a.Zero(8)
	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return make_slice(uint8, 0) }
	var path @[]char = buf.Concat(buf.Concat(dir, "/keep_"), secName)
	if !elf.WriteX86_64(a, buf.Concat(path, ".o")) { return make_slice(uint8, 0) }
	data, ok := readFile(buf.Concat(path, ".o"))
	if !ok { return make_slice(uint8, 0) }
	var sh int = sectionHeaderNamed(data, buf.Concat(".", secName))
	if sh < 0 { return make_slice(uint8, 0) }
	writeU32(data, sh + 4, cast(int64, stype))
	writeU64(data, sh + 8, cast(uint64, shflags))
	return data
}

// startsWith reports whether s begins with prefix.
func startsWith(s *[]readonly char, prefix *[]readonly char) bool {
	return len(s) >= len(prefix) && charsEqual(s[0:len(prefix)], prefix)
}

// An init, fini or preinit array is kept, with its type and its relocations (the pointer to
// f); its symbols stay defined in it.
func TestReadElfKeepsInitFiniArrays() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var types @[]int = @[]int{SHT_INIT_ARRAY, SHT_FINI_ARRAY, SHT_PREINIT_ARRAY}
	for i := 0; i < len(types); i++ {
		var data @[]uint8 = keepFixture(dir, "init_array", "L", SHF_ALLOC | SHF_WRITE, false, types[i],
				true)
		if len(data) == 0 { return fail("cannot build the fixture") }
		obj, err := parseObjectBytes(data, "arr.o")
		if len(err) != 0 { return fail(buf.Concat("an array section should be kept: ", err)) }
		var si int = findSection(obj, ".init_array")
		if si < 0 || obj.Sections[si].Type != types[i] { return fail("the array section is not kept") }
		if (obj.Sections[si].Flags & SF_WRITE) == 0 { return fail("the array section is not writable") }
		var ri int = relForSym(obj, "f")
		if ri < 0 || obj.Relocs[ri].SecIndex != si {
			return fail("the array's pointer relocation is lost")
		}
	}
	return ""
}

// A .ctors / .dtors section is rejected: bnld links no crtbegin to run it.
func TestReadElfRejectsCtorsSections() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var names @[]@[]char = make_slice(@[]char, 2)
	names[0] = buf.CopyStr("ctors")
	names[1] = buf.CopyStr("dtors.65535")
	for i := 0; i < len(names); i++ {
		var data @[]uint8 = keepFixture(dir, names[i], "L", SHF_ALLOC | SHF_WRITE, false, SHT_PROGBITS,
				true)
		if len(data) == 0 { return fail("cannot build the fixture") }
		_, err := parseObjectBytes(data, "ctors.o")
		var want @[]char = buf.Concat(buf.Concat(".", names[i]), ": bnld does not run .ctors / .dtors")
		if !startsWith(err, want) { return fail(buf.Concat("not rejected: ", names[i])) }
	}
	// A name that only starts with .ctors is an ordinary section.
	var other @[]uint8 = keepFixture(dir, "ctorsx", "L", SHF_ALLOC | SHF_WRITE, false, SHT_PROGBITS,
			true)
	if len(other) == 0 { return fail("cannot build the fixture") }
	_, oerr := parseObjectBytes(other, "ctorsx.o")
	if len(oerr) != 0 { return fail(buf.Concat(".ctorsx rejected: ", oerr)) }
	return ""
}

// A kept section's relocation against a symbol defined in a dropped section (here an
// allocatable SHT_NOTE) is an error — against its section symbol too, for a temporary label —
// as is a global defined in one, referenced or not; a dropped non-allocated section that
// nothing kept refers into is not.
func TestReadElfRejectsReferencesIntoDroppedSections() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var data @[]uint8 = keepFixture(dir, "notes", "L", SHF_ALLOC, false, 7, true)
	if len(data) == 0 { return fail("cannot build the fixture") }
	_, err := parseObjectBytes(data, "ref.o")
	if !startsWith(err, "a relocation in .text refers to L, in .notes, which bnld does not link") {
		return fail(buf.Concat("a reference into a dropped section: ", err))
	}
	data = keepFixture(dir, "tnotes", ".Ltmp", SHF_ALLOC, false, 7, true)
	if len(data) == 0 { return fail("cannot build the fixture") }
	_, err = parseObjectBytes(data, "tmp.o")
	if !startsWith(err, "a relocation in .text refers to .tnotes, which bnld does not link") {
		return fail(buf.Concat("a section-symbol reference into a dropped section: ", err))
	}
	for i := 0; i < 2; i++ {
		data = keepFixture(dir, "gnotes", "L", SHF_ALLOC, true, 7, i == 0)
		if len(data) == 0 { return fail("cannot build the fixture") }
		_, err = parseObjectBytes(data, "glob.o")
		if !startsWith(err, "global symbol L is defined in .gnotes, which bnld does not link") {
			return fail(buf.Concat("a global in a dropped section: ", err))
		}
	}
	// A non-allocated section (sh_flags 0, like debug info): dropped, with its own relocation
	// left unapplied, and nothing kept refers into it.
	data = keepFixture(dir, "dbg", "L", 0, false, SHT_PROGBITS, false)
	if len(data) == 0 { return fail("cannot build the fixture") }
	obj, derr := parseObjectBytes(data, "dbg.o")
	if len(derr) != 0 || findSection(obj, ".dbg") >= 0 {
		return fail("a non-allocated section should be dropped without an error")
	}
	return ""
}
