package "pkg/binate/link"

import "pkg/binate/buf"

// ELF symbols of a type or binding bnld does not link: an indirect function
// (STT_GNU_IFUNC), whose value is a resolver that a reference must not bind to — a static
// link would need an IRELATIVE relocation for it, a dynamic one its type kept — and a GNU
// unique symbol (STB_GNU_UNIQUE), whose binding is none of local, global or weak.  Read as
// ordinary symbols they would link without a word — a call reaching the resolver, not the
// function it returns — so the reader rejects the object.

// elfSymbolKindError returns why the ELF object obj — read from data (its symbol table
// already validated by parseSymbols), its section headers at shoff (shentsize apart, shnum
// of them) — cannot be linked for a symbol of a type or binding bnld does not link, or "".
// An undefined reference typed STT_GNU_IFUNC (GNU as's `.type f, %gnu_indirect_function`
// on a name defined elsewhere) is no indirect function here: the definition decides.  A
// common so typed is a definition (symDefines), and rejected.
func elfSymbolKindError(data *[]readonly uint8, fmt elfFmt, shoff int, shentsize int, shnum int,
		obj @InputObject) @[]readonly char {
	for s := 0; s < len(obj.Symbols); s++ {
		if obj.Symbols[s].Binding == BIND_GNU_UNIQUE {
			return buf.Concat(obj.Symbols[s].Name,
					" has a unique binding (STB_GNU_UNIQUE), which bnld does not link")
		}
	}
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if cast(int, u32(data, sh + 4)) != SHT_SYMTAB { continue }
		symOff, ok := readOffC(data, sh + fmt.ShOffset, fmt.Is64)
		entsize, eok := readOffC(data, sh + fmt.ShEntsize, fmt.Is64)
		if !ok || !eok { return "" }
		for s := 0; s < len(obj.Symbols); s++ {
			if (cast(int, data[symOff + s * entsize + fmt.SymInfo]) & 0xf) != STT_GNU_IFUNC {
				continue
			}
			if !symDefines(obj.Symbols[s]) { continue }
			return buf.Concat(obj.Symbols[s].Name,
					" is an indirect function (STT_GNU_IFUNC), which bnld does not link")
		}
		return ""
	}
	return ""
}
