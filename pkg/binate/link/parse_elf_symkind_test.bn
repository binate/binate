package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/elf"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// ELF symbols of a type or binding bnld does not link (parse_elf_symkind.bn): an indirect
// function and a GNU unique symbol are rejected, naming the symbol, Rejected when read as an
// archive member would be.  (testTmpDir is in link_test.bn, fail in parse_elf_test.bn, tlsHas
// in parse_tls_test.bn.)

// undefIfuncObject writes to path an aarch64 ELF object whose data word refers to `ext`, an
// undefined global given the type SYM_IFUNC (GNU as's `.type ext, %gnu_indirect_function`),
// reporting whether it could.
func undefIfuncObject(path *[]readonly char) bool {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_ELF
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.EmitUint32(0xD65F03C0) // ret
	a.SetGlobal("ext")
	a.SetType("ext", asm.SYM_IFUNC)
	a.SetSection("data", -1)
	a.EmitAddr("ext")
	if !aarch64.ResolveFixups(a) { return false }
	a.Finalize()
	if a.HasError { return false }
	return elf.WriteAArch64(a, path)
}

// commonIfuncObject writes to path an aarch64 ELF object with a function `_start` and a
// common `cv`, given the type SYM_IFUNC, reporting whether it could.
func commonIfuncObject(path *[]readonly char) bool {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_ELF
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.EmitUint32(0xD65F03C0) // ret
	a.DefineCommon("cv", 8, 8)
	a.SetType("cv", asm.SYM_IFUNC)
	if !aarch64.ResolveFixups(a) { return false }
	a.Finalize()
	if a.HasError { return false }
	return elf.WriteAArch64(a, path)
}

// symKindObject writes to path an aarch64 ELF object with a global function `_start` and a
// global function `g`, given the type ifunc makes it (SYM_IFUNC), else SYM_FUNC — reporting
// whether it could.
func symKindObject(path *[]readonly char, ifunc bool) bool {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_ELF
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.EmitUint32(0xD65F03C0) // ret
	a.DefineLabel("g")
	a.SetGlobal("g")
	if ifunc {
		a.SetType("g", asm.SYM_IFUNC)
	} else {
		a.SetType("g", asm.SYM_FUNC)
	}
	a.EmitUint32(0xD65F03C0) // ret
	if !aarch64.ResolveFixups(a) { return false }
	a.Finalize()
	if a.HasError { return false }
	return elf.WriteAArch64(a, path)
}

// setSymBinding sets, in the ELF object data, the binding (st_info's high nibble) of the
// symbol named name to bind, and reports whether it found the symbol.
func setSymBinding(data @[]uint8, name *[]readonly char, bind int) bool {
	var fmt elfFmt = elfFmtFor(data[4])
	shoff, ok := readOffC(data, fmt.EShoff, fmt.Is64)
	if !ok { return false }
	var shentsize int = u16(data, fmt.EShentsize)
	var shnum int = u16(data, fmt.EShnum)
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if cast(int, u32(data, sh + 4)) != SHT_SYMTAB { continue }
		symOff, sok := readOffC(data, sh + fmt.ShOffset, fmt.Is64)
		symSize, zok := readOffC(data, sh + fmt.ShSize, fmt.Is64)
		entsize, eok := readOffC(data, sh + fmt.ShEntsize, fmt.Is64)
		var strIdx int = cast(int, u32(data, sh + fmt.ShLink))
		strOff, tok := readOffC(data, shoff + strIdx * shentsize + fmt.ShOffset, fmt.Is64)
		if !sok || !zok || !eok || !tok || entsize == 0 { return false }
		for s := 0; s < symSize / entsize; s++ {
			var e int = symOff + s * entsize
			var nameOff int = cast(int, u32(data, e + fmt.SymName))
			if nameOff == 0 || !charsEqual(readCStr(data, strOff + nameOff, len(data)), name) {
				continue
			}
			var info int = cast(int, data[e + fmt.SymInfo])
			data[e + fmt.SymInfo] = cast(uint8, (bind << 4) | (info & 0xf))
			return true
		}
	}
	return false
}

// An ELF object defining an indirect function — in a section, or as a common — or a symbol
// with a GNU unique binding, is rejected naming the symbol — Rejected when read as an archive
// member would be.  The same object with g an ordinary function reads.
func TestReadElfRejectsIfuncAndUnique() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var path @[]char = buf.Concat(dir, "/g.o")
	if !symKindObject(path, false) { return fail("cannot write the object") }
	_, err := ReadObject(path)
	if len(err) != 0 { return fail(buf.Concat("an ordinary function: ", err)) }
	data, ok := readFile(path)
	if !ok { return fail("cannot read the object back") }
	if !setSymBinding(data, "g", BIND_GNU_UNIQUE) { return fail("no symbol g") }
	obj, rerr := readObjectBytes(data, path)
	if len(rerr) != 0 || !tlsHas(obj.Rejected, "g has a unique binding (STB_GNU_UNIQUE)") {
		return fail(buf.Concat("a unique symbol not rejected: ", rerr))
	}
	if !symKindObject(path, true) { return fail("cannot write the indirect function's object") }
	_, err = ReadObject(path)
	if !tlsHas(err, "g is an indirect function (STT_GNU_IFUNC)") {
		return fail(buf.Concat("ReadObject: ", err))
	}
	data, ok = readFile(path)
	if !ok { return fail("cannot read the object back") }
	obj, rerr = readObjectBytes(data, path)
	if len(rerr) != 0 || !tlsHas(obj.Rejected, "g is an indirect function (STT_GNU_IFUNC)") {
		return fail(buf.Concat("not deferred as Rejected: ", rerr))
	}
	// A reference typed STT_GNU_IFUNC to a symbol defined elsewhere reads: the definition
	// decides.
	if !undefIfuncObject(path) { return fail("cannot write the undefined reference's object") }
	_, err = ReadObject(path)
	if len(err) != 0 { return fail(buf.Concat("an undefined IFUNC-typed reference: ", err)) }
	if !commonIfuncObject(path) { return fail("cannot write the common's object") }
	_, err = ReadObject(path)
	if !tlsHas(err, "cv is an indirect function (STT_GNU_IFUNC)") {
		return fail(buf.Concat("an IFUNC-typed common: ", err))
	}
	return ""
}
