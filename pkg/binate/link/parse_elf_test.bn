package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

func fail(msg @[]char) testing.TestResult { return msg }

// findSection returns the index of the first section named name, or -1.
func findSection(obj @InputObject, name *[]readonly char) int {
	for i := 0; i < len(obj.Sections); i++ {
		if charsEqual(obj.Sections[i].Name, name) { return i }
	}
	return -1
}

// Round-trip: assemble a tiny x86-64 object whose .text is a single RET, write
// it as ELF64, read it back with ReadObject, and check the machine plus the
// .text section's type, flags, and bytes.
func TestReadElfX64TextSection() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	x64.Ret(a)

	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }

	var path @[]char = buf.Concat(dir, "/link_x64_text.o")
	if !elf.WriteX86_64(a, path) { return fail("failed to write ELF object") }

	obj, err := ReadObject(path)
	if len(err) != 0 { return fail("ReadObject returned an error") }
	if obj.Machine != EM_X86_64 { return fail("wrong e_machine (expected x86-64)") }
	// Only .text is an allocatable content section: the non-alloc .note.GNU-stack
	// (and symtab/strtab/shstrtab) must be filtered out.
	if len(obj.Sections) != 1 { return fail("expected exactly one content section (.text)") }

	var ti int = findSection(obj, ".text")
	if ti < 0 { return fail("no .text section in the object") }
	var t InputSection = obj.Sections[ti]
	if t.Type != SHT_PROGBITS { return fail(".text is not SHT_PROGBITS") }
	if (t.Flags & SF_EXEC) == 0 { return fail(".text is missing SF_EXEC") }
	if (t.Flags & SF_READ) == 0 { return fail(".text is missing SF_READ") }
	if len(t.Data) != 1 { return fail(".text should be one byte (RET)") }
	if t.Data[0] != 0xc3 { return fail(".text byte should be RET (0xc3)") }
	return ""
}

// findSymbol returns the index of the first symbol named name, or -1.
func findSymbol(obj @InputObject, name *[]readonly char) int {
	for i := 0; i < len(obj.Symbols); i++ {
		if charsEqual(obj.Symbols[i].Name, name) { return i }
	}
	return -1
}

// Symbol round-trip: a defined global (_start, in .text at offset 0) and an
// undefined external (ext) must both surface with the right binding and defining
// section after write→read.
func TestReadElfX64Symbols() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.SetGlobal("ext") // declared global but never defined -> undefined external
	x64.Ret(a)

	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }

	var path @[]char = buf.Concat(dir, "/link_x64_syms.o")
	if !elf.WriteX86_64(a, path) { return fail("failed to write ELF object") }

	obj, err := ReadObject(path)
	if len(err) != 0 { return fail("ReadObject returned an error") }

	var textIdx int = findSection(obj, ".text")
	if textIdx < 0 { return fail("no .text section") }

	var si int = findSymbol(obj, "_start")
	if si < 0 { return fail("_start symbol not found") }
	var start InputSymbol = obj.Symbols[si]
	if start.Binding != 1 { return fail("_start should be a global symbol") }
	if start.SecIndex != textIdx { return fail("_start should be defined in .text") }
	if start.Value != cast(uint, 0) { return fail("_start should be at offset 0") }

	var ei int = findSymbol(obj, "ext")
	if ei < 0 { return fail("ext symbol not found") }
	var ext InputSymbol = obj.Symbols[ei]
	if ext.Binding != 1 { return fail("ext should be a global symbol") }
	if ext.SecIndex != -1 { return fail("ext should be undefined (SecIndex -1)") }
	return ""
}

// relForSym returns the index of the first relocation whose symbol is named
// symName, or -1.
func relForSym(obj @InputObject, symName *[]readonly char) int {
	for i := 0; i < len(obj.Relocs); i++ {
		var s int = obj.Relocs[i].SymIndex
		if s >= 0 && s < len(obj.Symbols) && charsEqual(obj.Symbols[s].Name, symName) {
			return i
		}
	}
	return -1
}

// Relocation round-trip: a CALL to a plain symbol emits R_X86_64_PLT32 (4), one with an
// addend R_X86_64_PC32 (2).  Both are end-of-instruction-relative, so their addend is the
// written one - 4.  Read them back and check the kind, the patched section, the addend,
// and the referenced symbol.
func TestReadElfX64Relocs() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("caller")
	a.SetGlobal("caller")
	a.SetGlobal("ext") // undefined external
	x64.CallAddend(a, "callee", 4) // with an addend -> PC32
	x64.Call(a, "ext") // plain -> PLT32
	x64.Ret(a)
	a.DefineLabel("callee")
	a.SetGlobal("callee")
	x64.Ret(a)

	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }

	var path @[]char = buf.Concat(dir, "/link_x64_relocs.o")
	if !elf.WriteX86_64(a, path) { return fail("failed to write ELF object") }

	obj, err := ReadObject(path)
	if len(err) != 0 { return fail("ReadObject returned an error") }

	var textIdx int = findSection(obj, ".text")
	if textIdx < 0 { return fail("no .text section") }

	var re int = relForSym(obj, "ext")
	if re < 0 { return fail("no relocation referencing ext") }
	var r InputReloc = obj.Relocs[re]
	if r.Kind != 4 { return fail("ext call should be R_X86_64_PLT32 (4)") }
	if r.SecIndex != textIdx { return fail("ext relocation should patch .text") }
	if r.Addend != -4 { return fail("x86-64 PC-relative addend should be -4") }

	var rc int = relForSym(obj, "callee")
	if rc < 0 { return fail("no relocation referencing callee") }
	if obj.Relocs[rc].Kind != 2 { return fail("callee+4 call should be R_X86_64_PC32 (2)") }
	if obj.Relocs[rc].Addend != 0 { return fail("callee+4 call's addend should be 4 - 4") }
	return ""
}

// ReadObject must reject a file that is not an ELF64 object (rather than crash).
func TestReadObjectRejectsNonElf() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var path @[]char = buf.Concat(dir, "/link_not_elf.bin")
	f, cerr := os.Create(path)
	if present(cerr) { return fail("cannot create fixture file") }
	var junk @[]uint8 = make_slice(uint8, 64)
	for i := 0; i < 64; i++ { junk[i] = 0x41 } // all 'A' — not the ELF magic
	// bnlint:allow managed-to-raw-assign - borrows a live managed local; outlives the write
	var raw *[]readonly uint8 = junk
	_, werr := f.Write(raw)
	_ = f.Close()
	if present(werr) { return fail("cannot write fixture file") }

	_, err := ReadObject(path)
	if len(err) == 0 { return fail("ReadObject should reject a non-ELF file") }
	return ""
}

// A truncated object (a valid header whose section table then lies past EOF) must
// yield a returned error, not an out-of-bounds abort.
func TestReadObjectRejectsTruncated() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	x64.Ret(a)
	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }

	var full @[]char = buf.Concat(dir, "/link_full.o")
	if !elf.WriteX86_64(a, full) { return fail("failed to write ELF object") }
	data, ok := readFile(full)
	if !ok { return fail("cannot read the written object") }
	if len(data) <= 80 { return fail("written object unexpectedly small") }

	var trunc @[]char = buf.Concat(dir, "/link_trunc.o")
	f, cerr := os.Create(trunc)
	if present(cerr) { return fail("cannot create truncated file") }
	var prefix @[]uint8 = make_slice(uint8, 80)
	for i := 0; i < 80; i++ { prefix[i] = data[i] }
	// bnlint:allow managed-to-raw-assign - borrows a live managed local; outlives the write
	var raw *[]readonly uint8 = prefix
	_, werr := f.Write(raw)
	_ = f.Close()
	if present(werr) { return fail("cannot write truncated file") }

	_, err := ReadObject(trunc)
	if len(err) == 0 { return fail("ReadObject should reject a truncated object") }
	return ""
}

// relocHeaderOf returns the file offset of the first SHT_REL / SHT_RELA section header of
// the ELF object (either class) in data, or -1.
func relocHeaderOf(data *[]readonly uint8) int {
	var f elfFmt = elfFmtFor(data[4])
	shoff, _ := readOffC(data, f.EShoff, f.Is64)
	var shentsize int = u16(data, f.EShentsize)
	var shnum int = u16(data, f.EShnum)
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		var t int = cast(int, u32(data, sh + 4))
		if t == SHT_RELA || t == SHT_REL { return sh }
	}
	return -1
}

// patchedError returns parseObjectBytes' error for a copy of data with the 2-, 4- or
// 8-byte field at off set to v ("" when the copy reads).
func patchedError(data *[]readonly uint8, off int, width int, v int64) @[]readonly char {
	var c @[]uint8 = make_slice(uint8, len(data))
	for i := 0; i < len(data); i++ { c[i] = data[i] }
	if width == 8 {
		writeU64(c, off, cast(uint64, v))
	} else if width == 4 {
		writeU32(c, off, v)
	} else {
		c[off] = cast(uint8, v)
		c[off + 1] = cast(uint8, v >> 8)
	}
	_, err := parseObjectBytes(c, "bad.o")
	return err
}

// relocSectionChecks checks that each defect of the one relocation section of the ELF
// object in data (either class, nRelocs relocations) rejects the object with its own
// error: sh_entsize 0 and small (below the section type's entry size), a partial entry,
// sh_info naming no section or the symbol table, and the CREL type.
func relocSectionChecks(data *[]readonly uint8, nRelocs int, small int) testing.TestResult {
	var sh int = relocHeaderOf(data)
	if sh < 0 { return fail("no relocation section in the object") }
	obj, err := parseObjectBytes(data, "good.o")
	if len(err) != 0 || len(obj.Relocs) != nRelocs { return fail("the unmodified object should read") }

	var f elfFmt = elfFmtFor(data[4])
	var w int = 4
	if f.Is64 { w = 8 }
	var shnum int = u16(data, f.EShnum)
	var tooSmall @[]readonly char = "ELF relocation section entry size too small"
	if !charsEqual(patchedError(data, sh + f.ShEntsize, w, 0), tooSmall) {
		return fail("sh_entsize 0 should be rejected as too small")
	}
	if !charsEqual(patchedError(data, sh + f.ShEntsize, w, cast(int64, small)), tooSmall) {
		return fail("sh_entsize below the section type's entry should be rejected as too small")
	}
	size, _ := readOffC(data, sh + f.ShSize, f.Is64)
	if !charsEqual(patchedError(data, sh + f.ShSize, w, cast(int64, size - 1)),
			"ELF relocation section size not a whole number of entries") {
		return fail("a partial relocation entry should be rejected")
	}
	var noSection @[]readonly char = "ELF relocation section patches no section of the object (sh_info"
			" out of range)"
	if !charsEqual(patchedError(data, sh + f.ShInfo, 4, 0), noSection) {
		return fail("sh_info 0 should be rejected")
	}
	if !charsEqual(patchedError(data, sh + f.ShInfo, 4, cast(int64, shnum)), noSection) {
		return fail("sh_info past the section table should be rejected")
	}
	// A relocation section's sh_link names its symbol table.
	if !charsEqual(patchedError(data, sh + f.ShInfo, 4, u32(data, sh + f.ShLink)),
			"ELF relocation section patches a symbol, string or relocation table (sh_info)") {
		return fail("sh_info naming the symbol table should be rejected")
	}
	if !charsEqual(patchedError(data, sh + 4, 4, cast(int64, SHT_CREL)),
			"unsupported ELF relocation section type (CREL, RELR or packed)") {
		return fail("a CREL section should be rejected")
	}
	return ""
}

// A malformed ELF64 RELA section rejects the object instead of leaving its relocations
// unapplied (relocSectionChecks); a REL entry size (16) is too small for RELA.
func TestReadObjectRejectsMalformedRelocSection() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.SetGlobal("ext")
	x64.Call(a, "ext")
	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	var path @[]char = buf.Concat(dir, "/link_bad_rela.o")
	if !elf.WriteX86_64(a, path) { return fail("failed to write ELF object") }
	data, ok := readFile(path)
	if !ok { return fail("cannot read the written object") }
	return relocSectionChecks(data, 1, 16)
}

// An executable or shared object given as an input object is rejected: its symbol values
// are addresses, which the reader would take as section offsets.
func TestReadObjectRejectsNonRelocatable() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	x64.Ret(a)
	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	var path @[]char = buf.Concat(dir, "/link_etype.o")
	if !elf.WriteX86_64(a, path) { return fail("failed to write ELF object") }
	data, ok := readFile(path)
	if !ok { return fail("cannot read the written object") }
	_, err := parseObjectBytes(data, "good.o")
	if len(err) != 0 { return fail("the unmodified object should read") }
	var notRel @[]readonly char = "not a relocatable ELF object (e_type is not ET_REL)"
	if !charsEqual(patchedError(data, 16, 2, 2), notRel) {
		return fail("an ET_EXEC file should be rejected")
	}
	if !charsEqual(patchedError(data, 16, 2, 3), notRel) {
		return fail("an ET_DYN file should be rejected")
	}
	return ""
}
