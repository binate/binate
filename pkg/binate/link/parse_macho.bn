package "pkg/binate/link"

import "pkg/binate/buf"

// Mach-O 64-bit relocatable-object reader.  It normalizes a Mach-O object into the
// SAME InputObject model as the ELF reader (parse_elf.bn) — sections classified into
// text/rodata/data/bss, symbols, and relocations translated into bnld's canonical
// (ELF-numbered) relocation kinds — so the resolver, layout, and the per-arch
// relocation patchers (incl. the GOT relaxation) all work unchanged.
//
// Layout: a 32-byte mach_header_64, then ncmds load commands.  LC_SEGMENT_64 carries
// the sections (an MH_OBJECT has one segment holding them all); LC_SYMTAB names the
// symbol and string tables.  Relocations are per-section (section_64.reloff/nreloc),
// each an 8-byte relocation_info.  This targets what bnas / clang emit for arm64:
// external (symbol-indexed) relocs, the PAGE21/PAGEOFF12/BRANCH26/UNSIGNED kinds and
// the GOT_LOAD pair, and ARM64_RELOC_ADDEND for an explicit addend.
//
// Two deliberate limits (both fail loud rather than misread): a section-relative
// (non-extern) relocation in a KEPT section is rejected — clang emits the section-number
// form only in the unwind-metadata sections (__compact_unwind / __eh_frame), and this
// reader DROPS those (they are intermediate sections ld64 consumes into __unwind_info,
// and bnld does no unwind processing — see the section loop), so the form is never
// reached for a section bnld keeps; and an unrecognized r_type is rejected.  The
// ARM64_RELOC_ADDEND path is spec-derived (the addend reloc immediately precedes its
// PAGE21/PAGEOFF12) — a clang object reaches it via the LLVM backend + `--linker bnld`.

// MH_MAGIC_64 little-endian first byte, MH_OBJECT filetype, the cpu types, and the
// load-command / section-flag constants used below.
const (
	MACHO_MH_OBJECT int = 1
	MACHO_CPU_X86_64 int = 0x01000007
	MACHO_CPU_ARM64 int = 0x0100000c
	MACHO_LC_SEGMENT_64 int = 0x19
	MACHO_LC_SYMTAB int = 0x02
	MACHO_S_ZEROFILL int = 0x1                        // section type in flags & 0xff -> .bss
	MACHO_S_ATTR_PURE_INSTRUCTIONS int64 = 0x80000000 // an executable section
	MACHO_N_EXT int = 0x01                            // external (global) symbol
	MACHO_N_TYPE int = 0x0e                           // mask for the symbol's kind
	MACHO_N_SECT int = 0x0e                           // defined in a section
	MACHO_N_WEAK_DEF int = 0x0080                     // n_desc bit: a weak definition
	MACHO_N_WEAK_REF int = 0x0040                     // n_desc bit: a weak undefined reference
)

// AArch64 Mach-O relocation types (relocation_info r_type), translated to the
// canonical R_AARCH64_* kinds below.
const (
	ARM64_RELOC_UNSIGNED int = 0
	ARM64_RELOC_BRANCH26 int = 2
	ARM64_RELOC_PAGE21 int = 3
	ARM64_RELOC_PAGEOFF12 int = 4
	ARM64_RELOC_GOT_LOAD_PAGE21 int = 5
	ARM64_RELOC_GOT_LOAD_PAGEOFF12 int = 6
	ARM64_RELOC_ADDEND int = 10
)

// machoSectionKind classifies a Mach-O section into the same SF_* flags the ELF
// reader produces: an executable section -> text, a zero-fill section -> bss, a
// __DATA / __DATA_CONST section (isData) -> data, anything else (e.g. __TEXT,__const)
// -> rodata.
// Returns (flags, isBss).
func machoSectionKind(flags int, isData bool) (int, bool) {
	if (cast(int64, flags) & MACHO_S_ATTR_PURE_INSTRUCTIONS) != 0 { return SF_READ | SF_EXEC, false }
	if (flags & 0xff) == MACHO_S_ZEROFILL { return SF_READ | SF_WRITE, true }
	if isData { return SF_READ | SF_WRITE, false }
	return SF_READ, false
}

// machoReloc translates an arm64 relocation_info (type/length) into a canonical
// (kind, addend, ok) triple.  addendIn is the pending ARM64_RELOC_ADDEND value (0 if
// none).  secData is this reloc's section bytes: UNSIGNED's addend is implicit in
// the field there, and PAGEOFF12 needs the opcode to tell an ADD from a load.  A
// field read past the section end returns ok=false rather than aborting.
func machoReloc(rtype int, rlength int, secData *[]readonly uint8, rAddr int,
		addendIn int) (int, int, bool) {
	if rtype == ARM64_RELOC_UNSIGNED {
		if rlength == 3 {
			if rAddr < 0 || rAddr + 8 > len(secData) { return 0, 0, false }
			return R_AARCH64_ABS64, u64(secData, rAddr), true
		}
		// A 32-bit UNSIGNED is ABSOLUTE (S+A); there is no absolute-32 kind in the
		// patcher yet (R_AARCH64_PREL32 is PC-relative and would patch wrong bytes),
		// so reject rather than mis-emit.  bnas emits only the 64-bit form.
		return 0, 0, false
	}
	if rtype == ARM64_RELOC_BRANCH26 { return R_AARCH64_CALL26, addendIn, true }
	if rtype == ARM64_RELOC_PAGE21 { return R_AARCH64_ADR_PREL_PG_HI21, addendIn, true }
	if rtype == ARM64_RELOC_GOT_LOAD_PAGE21 { return R_AARCH64_ADR_GOT_PAGE, 0, true }
	if rtype == ARM64_RELOC_GOT_LOAD_PAGEOFF12 { return R_AARCH64_LD64_GOT_LO12_NC, 0, true }
	if rtype == ARM64_RELOC_PAGEOFF12 {
		// PAGEOFF12 patches an ADD (address) or a load/store (direct load) low-12
		// field; the ELF vocabulary distinguishes them, so pick by the opcode.
		if rAddr < 0 || rAddr + 4 > len(secData) { return 0, 0, false }
		var insn int = u32(secData, rAddr)
		if (insn & 0x7f800000) == 0x11000000 { return R_AARCH64_ADD_ABS_LO12_NC, addendIn, true }
		// TODO(macho): a sub-64-bit load/store (LDRB/LDRH/32-bit/128-bit) needs the
		// matching LDST8/16/32/128 lo12 kind (different imm12 scale); only the 64-bit
		// form bnas emits is handled.  Map the rest to LDST64 for now.
		return R_AARCH64_LDST64_ABS_LO12_NC, addendIn, true
	}
	return 0, 0, false
}

// parseMachoBytes parses a Mach-O 64-bit relocatable object from an in-memory byte
// slice into an InputObject (path labels it).  Everything is copied, so the result
// does not alias data.  Returns (obj, "") or an absent object and an error.
func parseMachoBytes(data *[]readonly uint8,
		path *[]readonly char) (@InputObject, @[]readonly char) {
	var none @InputObject
	var dlen int = len(data)
	if dlen < 32 { return none, "file too small for a Mach-O header" }
	if data[0] != 0xcf || data[1] != 0xfa || data[2] != 0xed || data[3] != 0xfe {
		return none, "not a Mach-O 64-bit object (bad magic)"
	}
	var cpu int = u32(data, 4)
	var machine int = 0
	if cpu == MACHO_CPU_ARM64 {
		machine = EM_AARCH64
	} else if cpu == MACHO_CPU_X86_64 {
		machine = EM_X86_64
	} else {
		return none, "unsupported Mach-O cpu type"
	}
	if u32(data, 12) != MACHO_MH_OBJECT { return none, "not a relocatable Mach-O object" }
	var ncmds int = u32(data, 16)

	// Upper-bound the section count for the scratch arrays: each section needs an
	// 80-byte section_64 after >= 104 bytes of headers, so dlen/64 over-estimates it.
	var maxSecs int = dlen / 64
	if maxSecs < 1 { maxSecs = 1 }
	var secs @[]InputSection = make_slice(InputSection, maxSecs)
	var secReloff @[]int = make_slice(int, maxSecs) // per-section reloff
	var secNreloc @[]int = make_slice(int, maxSecs)
	var secAddr @[]int = make_slice(int, maxSecs) // per-section vmaddr (section_64.addr)
	var nSec int = 0
	// machoToMy maps a 1-based Mach-O section index to my section index (or -1).
	var machoToMy @[]int = make_slice(int, maxSecs + 1)
	for i := 0; i < maxSecs + 1; i++ { machoToMy[i] = -1 }
	var machoSecCount int = 0 // running 1-based Mach-O section counter

	var symOff int = 0
	var nSyms int = 0
	var strOff int = 0
	var haveSymtab bool = false

	var lc int = 32
	for c := 0; c < ncmds; c++ {
		if lc + 8 > dlen { return none, "load command out of range" }
		var cmd int = u32(data, lc)
		var cmdsize int = u32(data, lc + 4)
		if cmdsize < 8 || lc + cmdsize > dlen { return none, "malformed load command" }
		if cmd == MACHO_LC_SEGMENT_64 {
			// The command must hold its own header (72) before nsects@64 is read, and
			// all nsects * 80-byte section_64 records must fit inside cmdsize.  Without
			// the latter a bogus (small cmdsize, huge nsects) command would scan the
			// 80-byte grid past its own extent into the next command / off the end,
			// and — since sections can be zero-fill (no file data) — push nSec past
			// the dlen/64-sized scratch arrays: an out-of-bounds write.
			if cmdsize < 72 { return none, "segment command too small" }
			var nsects int = u32(data, lc + 64)
			if nsects < 0 || 72 + nsects * 80 > cmdsize {
				return none, "segment sections exceed command size"
			}
			var s int = lc + 72
			for k := 0; k < nsects; k++ {
				if s + 80 > dlen { return none, "section header out of range" }
				if nSec >= maxSecs { return none, "too many sections" } // scratch-array guard
				machoSecCount = machoSecCount + 1
				var segName @[]char = readCStr(data, s + 16, s + 32) // segname[16] at +16
				var sectName @[]char = readCStr(data, s + 0, s + 16) // sectname[16] at +0
				// __compact_unwind / __eh_frame are intermediate unwind-metadata sections
				// that ld64 CONSUMES into __TEXT,__unwind_info — a final image does not carry
				// them, and bnld does no unwind processing.  They also bear section-relative
				// (non-extern) relocations, which bnld does not resolve.  Drop them (leaving
				// machoToMy[machoSecCount] == -1): the program runs (arm64 keeps frame-pointer
				// chains, so the unwinder still walks stacks), and nothing else references them.
				if charsEqual(sectName, "__compact_unwind") || charsEqual(sectName, "__eh_frame") {
					s = s + 80
					continue
				}
				var addr int = u64(data, s + 32) // section_64.addr (the object's vmaddr)
				var size int = u64(data, s + 40)
				var off int = u32(data, s + 48)
				var align int = u32(data, s + 52)
				var reloff int = u32(data, s + 56)
				var nreloc int = u32(data, s + 60)
				var flags int = u32(data, s + 64)
				// __DATA_CONST holds relocatable read-only data (rodata_relro — vtables,
				// type info, descriptor nodes) that bears absolute pointers.  bnld has no
				// separate read-only-after-fixup __DATA_CONST segment, so it must place
				// these in the writable __DATA where dyld can rebase them; treat the
				// segment as data alongside __DATA.
				var isData bool = charsEqual(segName, "__DATA") || charsEqual(segName, "__DATA_CONST")
				kflags, isBss := machoSectionKind(flags, isData)
				var sec InputSection
				sec.Name = sectName
				sec.Type = SHT_PROGBITS
				sec.Flags = kflags
				sec.Size = cast(uint, size)
				// section_64.align is a log2 exponent; Layout wants a byte count.
				var alignBytes int = 1
				if align > 0 && align < 31 {
					for j := 0; j < align; j++ { alignBytes = alignBytes * 2 }
				}
				sec.Align = alignBytes
				sec.OutIndex = -1
				sec.OutOffset = cast(uint, 0)
				if isBss {
					sec.Type = SHT_NOBITS
					sec.Data = make_slice(uint8, 0)
				} else {
					if !rangeOk(off, size, dlen) { return none, "section data out of range" }
					sec.Data = copyBytes(data, off, size)
				}
				secs[nSec] = sec
				secReloff[nSec] = reloff
				secNreloc[nSec] = nreloc
				secAddr[nSec] = addr
				machoToMy[machoSecCount] = nSec
				nSec = nSec + 1
				s = s + 80 // next section_64
			}
		} else if cmd == MACHO_LC_SYMTAB {
			// symtab_command is 24 bytes; guard before reading its fields past cmdsize.
			if cmdsize < 24 { return none, "symtab command too small" }
			symOff = u32(data, lc + 8)
			nSyms = u32(data, lc + 12)
			strOff = u32(data, lc + 16)
			haveSymtab = true
		}
		lc = lc + cmdsize
	}

	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr(path)
	obj.Machine = machine
	// Copy the filled prefix into an exactly-sized managed-slice: slicing a
	// managed-slice yields a raw borrow, which does not assign to an @[]T field.
	var finalSecs @[]InputSection = make_slice(InputSection, nSec)
	for i := 0; i < nSec; i++ { finalSecs[i] = secs[i] }
	obj.Sections = finalSecs

	// Symbols (nlist_64, 16 bytes each), kept in table order so a relocation's symbol
	// index maps directly.  Bound the count by the file size (16 bytes/entry) before
	// allocating so a corrupt nsyms can't force a giant make_slice.
	if nSyms < 0 || nSyms > dlen / 16 { return none, "symbol count out of range" }
	var syms @[]InputSymbol = make_slice(InputSymbol, nSyms)
	if haveSymtab {
		// symOff/strOff come straight from u32; guard against a corrupt (negative,
		// on a 32-bit host) table base so the per-entry reads stay in bounds.
		if symOff < 0 || strOff < 0 { return none, "symbol table offset out of range" }
		for i := 0; i < nSyms; i++ {
			var e int = symOff + i * 16
			if e + 16 > dlen { return none, "symbol table out of range" }
			var nStrx int = u32(data, e + 0)
			var nType int = cast(int, data[e + 4])
			var nSect int = cast(int, data[e + 5])
			var nDesc int = u16(data, e + 6)
			var nValue int = u64(data, e + 8)
			var sym InputSymbol
			sym.Name = readCStr(data, strOff + nStrx, dlen)
			if (nType & MACHO_N_EXT) != 0 {
				// A weak definition OR a weak undefined reference is BIND_WEAK: the
				// resolver overrides a weak def with a strong one and resolves an
				// unsatisfied weak ref to 0 rather than erroring.
				if (nDesc & (MACHO_N_WEAK_DEF | MACHO_N_WEAK_REF)) != 0 {
					sym.Binding = BIND_WEAK
				} else {
					sym.Binding = BIND_GLOBAL
				}
			} else {
				sym.Binding = 0 // local
			}
			if (nType & MACHO_N_TYPE) == MACHO_N_SECT && nSect >= 1 && nSect <= machoSecCount &&
					machoToMy[nSect] >= 0 {
				// n_value is the symbol's address in the object's own vmspace, where each
				// section sits at its section_64.addr; the resolver/relocator want the
				// offset WITHIN the defining section, so subtract that section's addr.
				// (Without this, any symbol in a section that isn't at object-addr 0 — e.g.
				// __text when a __const precedes it — resolves off by the section's addr.)
				var myIdx int = machoToMy[nSect]
				sym.SecIndex = myIdx
				sym.Value = cast(uint, nValue - secAddr[myIdx])
			} else {
				sym.SecIndex = -1 // undefined / absolute
				sym.Value = cast(uint, nValue)
			}
			syms[i] = sym
		}
	}
	obj.Symbols = syms

	// Relocations: per section, translate each relocation_info to a canonical kind.
	// ARM64_RELOC_ADDEND carries the addend for the immediately-following reloc.  The
	// r_type table below is arm64's; x86-64 shares the numeric space with different
	// meanings, so translating an x86-64 object's relocs here would silently emit the
	// wrong kinds — reject them loud until an x86-64 translation exists.
	var totalRel int = 0
	for i := 0; i < nSec; i++ { totalRel = totalRel + secNreloc[i] }
	if totalRel > 0 && machine != EM_AARCH64 {
		return none, "non-arm64 Mach-O relocations not yet supported"
	}
	// Bound by the file size (8 bytes/reloc) before allocating.
	if totalRel < 0 || totalRel > dlen / 8 { return none, "relocation count out of range" }
	var relocs @[]InputReloc = make_slice(InputReloc, totalRel)
	var w int = 0
	for i := 0; i < nSec; i++ {
		var base int = secReloff[i]
		if secNreloc[i] > 0 && base < 0 { return none, "relocation table offset out of range" }
		var pending int = 0
		var havePending bool = false
		for r := 0; r < secNreloc[i]; r++ {
			var e int = base + r * 8
			if e + 8 > dlen { return none, "relocation out of range" }
			var rAddr int = u32(data, e + 0)
			// The top bit of the first word marks a scattered_relocation_info, whose
			// layout differs; arm64 never emits them, so reject rather than misdecode.
			if (rAddr & 0x80000000) != 0 { return none, "scattered Mach-O relocation unsupported" }
			var info int = u32(data, e + 4)
			var rSym int = info & 0xffffff
			var rLength int = (info >> 25) & 0x3
			var rExtern int = (info >> 27) & 0x1
			var rType int = (info >> 28) & 0xf
			if rType == ARM64_RELOC_ADDEND {
				// r_symbolnum is a 24-bit signed addend for the next reloc.
				pending = rSym
				if pending >= 0x800000 { pending = pending - 0x1000000 }
				havePending = true
				continue
			}
			if rExtern == 0 {
				return none,
					buf.Concat("section-relative Mach-O relocation unsupported in section ", obj.Sections[i].Name)
			}
			var addIn int = 0
			if havePending { addIn = pending }
			// UNSIGNED's addend and PAGEOFF12's ADD/load opcode live in this
			// section's own bytes at the (section-relative) r_address.
			kind, addend, ok := machoReloc(rType, rLength, obj.Sections[i].Data, rAddr, addIn)
			if !ok { return none, buf.Concat("unsupported Mach-O relocation in ", path) }
			var rel InputReloc
			rel.SecIndex = i
			rel.Offset = cast(uint, rAddr)
			rel.SymIndex = rSym
			rel.Kind = kind
			rel.Addend = addend
			relocs[w] = rel
			w = w + 1
			pending = 0
			havePending = false
		}
	}
	// Exactly-size the reloc slice (w <= totalRel: ADDEND entries emit nothing).
	var finalRel @[]InputReloc = make_slice(InputReloc, w)
	for r := 0; r < w; r++ { finalRel[r] = relocs[r] }
	obj.Relocs = finalRel

	// Every relocation's symbol index must be in range (the reader's contract).
	for r := 0; r < len(obj.Relocs); r++ {
		if obj.Relocs[r].SymIndex < 0 || obj.Relocs[r].SymIndex >= len(obj.Symbols) {
			return none, "relocation symbol index out of range"
		}
	}
	return obj, ""
}
