package "pkg/binate/link"

// The Mach-O section types (section_64.flags & 0xff) bnld links.  It reads a section of
// one by its contents — instructions, zero fill (S_ZEROFILL, S_GB_ZEROFILL), data or
// read-only data — whatever the type: a regular section, a literal section, whose contents
// ld64 may merge across objects and bnld keeps as they are (C strings, 4-, 8- and 16-byte
// literals, literal pointers), and the initializer and terminator pointers, which it carries
// as init and fini arrays.  Every other type carries linker semantics bnld does not
// implement — symbol pointers and stubs, a coalesced section (one copy kept across
// objects), interposing, DTrace DOF, initializer offsets, and the thread-local types
// (parse_tls.bn) — and read as data it would link wrong without a word, so the reader
// rejects the object, naming the section.

// The Mach-O section types bnld does not link (section_64.flags & 0xff), and the zero-fill
// type S_GB_ZEROFILL, which it links as S_ZEROFILL.
const (
	MACHO_S_NON_LAZY_SYMBOL_POINTERS int = 0x6
	MACHO_S_LAZY_SYMBOL_POINTERS int = 0x7
	MACHO_S_SYMBOL_STUBS int = 0x8
	MACHO_S_COALESCED int = 0xb
	MACHO_S_GB_ZEROFILL int = 0xc
	MACHO_S_INTERPOSING int = 0xd
	MACHO_S_DTRACE_DOF int = 0xf
	MACHO_S_LAZY_DYLIB_SYMBOL_POINTERS int = 0x10
	MACHO_S_INIT_FUNC_OFFSETS int = 0x16
)

// isMachoZeroFill reports whether a Mach-O section whose section_64.flags are flags is zero
// fill, which has no file bytes: S_ZEROFILL or S_GB_ZEROFILL (S_THREAD_LOCAL_ZEROFILL is
// rejected as thread-local storage).
func isMachoZeroFill(flags int) bool {
	var t int = flags & 0xff
	return t == MACHO_S_ZEROFILL || t == MACHO_S_GB_ZEROFILL
}

// machoSectionTypeUnlinked returns what a Mach-O section whose section_64.flags are flags
// is, when bnld does not link its type — the rest of a message naming the section — or "".
// The thread-local types are isMachoThreadLocal's.
func machoSectionTypeUnlinked(flags int) *[]readonly char {
	var t int = flags & 0xff
	if t == MACHO_S_NON_LAZY_SYMBOL_POINTERS {
		return " is a non-lazy symbol-pointer section (S_NON_LAZY_SYMBOL_POINTERS)"
	}
	if t == MACHO_S_LAZY_SYMBOL_POINTERS {
		return " is a lazy symbol-pointer section (S_LAZY_SYMBOL_POINTERS)"
	}
	if t == MACHO_S_SYMBOL_STUBS { return " is a symbol-stub section (S_SYMBOL_STUBS)" }
	if t == MACHO_S_COALESCED { return " is a coalesced section (S_COALESCED)" }
	if t == MACHO_S_INTERPOSING { return " is an interposing section (S_INTERPOSING)" }
	if t == MACHO_S_DTRACE_DOF { return " is a DTrace DOF section (S_DTRACE_DOF)" }
	if t == MACHO_S_LAZY_DYLIB_SYMBOL_POINTERS {
		return " is a lazy dylib symbol-pointer section (S_LAZY_DYLIB_SYMBOL_POINTERS)"
	}
	if t == MACHO_S_INIT_FUNC_OFFSETS {
		return " is an initializer-offset section (S_INIT_FUNC_OFFSETS)"
	}
	if t > MACHO_S_INIT_FUNC_OFFSETS { return " has a section type bnld does not know" }
	return ""
}
