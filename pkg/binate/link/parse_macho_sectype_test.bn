package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/macho"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Mach-O section types (parse_macho_sectype.bn): a section of a type bnld does not link is
// rejected naming it, and S_GB_ZEROFILL is read as zero fill.  (testTmpDir is in
// link_test.bn, fail in parse_elf_test.bn, tlsHas in parse_tls_test.bn.)

// secTypeObject writes to path an aarch64 Mach-O object with a function and a data word in
// __data, reporting whether it could.
func secTypeObject(path *[]readonly char) bool {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.EmitUint32(0xD65F03C0) // ret
	a.SetSection("data", -1)
	a.DefineLabel("_d")
	a.EmitUint32(7)
	if !aarch64.ResolveFixups(a) { return false }
	a.Finalize()
	if a.HasError { return false }
	return macho.WriteARM64(a, path)
}

// setMachoSectionType sets, in the Mach-O object data, the type (flags & 0xff) of the
// section named name to t, and reports whether it found the section.
func setMachoSectionType(data @[]uint8, name *[]readonly char, t int) bool {
	var ncmds int = cast(int, u32(data, 16))
	var lc int = 32 // past mach_header_64
	for i := 0; i < ncmds; i++ {
		var cmd int = cast(int, u32(data, lc))
		var cmdsize int = cast(int, u32(data, lc + 4))
		if cmd == MACHO_LC_SEGMENT_64 {
			var nsects int = cast(int, u32(data, lc + 64))
			for k := 0; k < nsects; k++ {
				var s int = lc + 72 + k * 80
				if charsEqual(readCStr(data, s, s + 16), name) {
					data[s + 64] = cast(uint8, t)
					return true
				}
			}
		}
		lc = lc + cmdsize
	}
	return false
}

// A Mach-O object with a section of a type bnld does not link — symbol stubs, a coalesced
// section, a type it does not know — is rejected naming the section; one of type
// S_GB_ZEROFILL is read as zero fill, no file bytes, not as data.
func TestReadMachoSectionTypes() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var path @[]char = buf.Concat(dir, "/st.o")
	if !secTypeObject(path) { return fail("cannot write the object") }
	var types @[]int = @[]int{MACHO_S_SYMBOL_STUBS, MACHO_S_COALESCED, 0x17}
	var want @[]@[]char = @[]@[]char{": __data is a symbol-stub section (S_SYMBOL_STUBS), which bnld",
			": __data is a coalesced section (S_COALESCED), which bnld",
			": __data has a section type bnld does not know, which bnld"}
	for i := 0; i < len(types); i++ {
		data, ok := readFile(path)
		if !ok { return fail("cannot read the object back") }
		if !setMachoSectionType(data, "__data", types[i]) { return fail("no section __data") }
		_, err := parseMachoBytes(data, path)
		if !tlsHas(err, want[i]) { return fail(buf.Concat("parseMachoBytes: ", err)) }
	}
	data, ok := readFile(path)
	if !ok { return fail("cannot read the object back") }
	if !setMachoSectionType(data, "__data", MACHO_S_GB_ZEROFILL) { return fail("no section __data") }
	obj, err := parseMachoBytes(data, path)
	if len(err) != 0 { return fail(buf.Concat("S_GB_ZEROFILL: ", err)) }
	for i := 0; i < len(obj.Sections); i++ {
		if !charsEqual(obj.Sections[i].Name, "__data") { continue }
		if obj.Sections[i].Type != SHT_NOBITS || len(obj.Sections[i].Data) != 0 {
			return fail("an S_GB_ZEROFILL section is read as data")
		}
		return ""
	}
	return fail("no section __data read")
}
