package "pkg/binate/link"

import "pkg/binate/buf"

// readMachoSymbols reads the nSyms nlist_64 entries at symOff (names in the string table at
// strOff) of the Mach-O object data, in table order so a relocation's symbol index maps
// directly.  machoToMy maps a 1-based Mach-O section number to the reader's section index
// (-1 for a section it drops), for the first machoSecCount sections, and secAddr gives each
// kept section's address in the object, which a defined symbol's n_value is relative to.
// Returns the symbols, or an error for a malformed entry.
func readMachoSymbols(data *[]readonly uint8, symOff int, nSyms int, strOff int, machoToMy @[]int,
		machoSecCount int, secAddr @[]int) (@[]InputSymbol, @[]readonly char) {
	var none @[]InputSymbol = make_slice(InputSymbol, 0)
	var dlen int = len(data)
	var syms @[]InputSymbol = make_slice(InputSymbol, nSyms)
	// symOff/strOff come straight from u32; guard against a corrupt (negative,
	// on a 32-bit host) table base so the per-entry reads stay in bounds.
	if symOff < 0 || strOff < 0 { return none, "symbol table offset out of range" }
	for i := 0; i < nSyms; i++ {
		var e int = symOff + i * 16
		if e + 16 > dlen { return none, "symbol table out of range" }
		var nStrx int = cast(int, u32(data, e + 0))
		var nType int = cast(int, data[e + 4])
		var nSect int = cast(int, data[e + 5])
		var nDesc int = u16(data, e + 6)
		var nValue int = cast(int, u64(data, e + 8))
		var sym InputSymbol
		sym.Name = readCStr(data, strOff + nStrx, dlen)
		if (nType & MACHO_N_EXT) != 0 {
			// A weak definition OR a weak undefined reference is BIND_WEAK: the
			// resolver overrides a weak def with a strong one and resolves an
			// unsatisfied weak ref to 0 rather than erroring.
			if (nDesc & (MACHO_N_WEAK_DEF | MACHO_N_WEAK_REF)) != 0 {
				sym.Binding = BIND_WEAK
			} else {
				sym.Binding = BIND_GLOBAL
			}
		} else {
			sym.Binding = 0 // local
		}
		sym.Hidden = (nType & MACHO_N_STAB) == 0 && (nType & MACHO_N_PEXT) != 0
		if (nType & MACHO_N_TYPE) == MACHO_N_SECT && nSect >= 1 && nSect <= machoSecCount &&
				machoToMy[nSect] >= 0 {
			// n_value is the symbol's address in the object's own vmspace, where each
			// section sits at its section_64.addr; the resolver/relocator want the
			// offset WITHIN the defining section, so subtract that section's addr.
			// (Without this, any symbol in a section that isn't at object-addr 0 — e.g.
			// __text when a __const precedes it — resolves off by the section's addr.)
			var myIdx int = machoToMy[nSect]
			sym.SecIndex = myIdx
			sym.Value = cast(uint, nValue - secAddr[myIdx])
		} else {
			sym.SecIndex = -1 // undefined, absolute or common (in no section)
			sym.Value = cast(uint, nValue)
			if (nType & MACHO_N_TYPE) == MACHO_N_ABS {
				sym.Abs = true
				sym.AbsValue = bit_cast(uint64, u64(data, e + 8))
			} else if (nType & MACHO_N_TYPE) == MACHO_N_UNDF && (nType & MACHO_N_EXT) != 0 &&
					u64(data, e + 8) != 0 {
				// A common symbol (a C tentative definition): n_value is its size, and
				// n_desc bits 8-11 the log2 of its alignment (GET_COMM_ALIGN) — 0 meaning
				// the size's own: the next power of two, at most 2^15, as ld64 takes it.  As
				// in the ELF reader, Size holds the size and Value the alignment.
				var size int64 = u64(data, e + 8)
				sym.Common = true
				sym.Size = cast(uint, size)
				if size < 0 || cast(int64, sym.Size) != size {
					return none, buf.Concat("common symbol size out of range: ", sym.Name)
				}
				var align uint = cast(uint, 1) << cast(uint, (nDesc >> 8) & 0x0f)
				if ((nDesc >> 8) & 0x0f) == 0 {
					for cast(int64, align) < size && align < 0x8000 { align = align * 2 }
				}
				sym.Value = align
			}
		}
		syms[i] = sym
	}
	return syms, ""
}
