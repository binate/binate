package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// The Mach-O symbol table (parse_macho_syms.bn): a private external's Hidden mark and a common's
// size and alignment.  (visAsm is in visibility_test.bn, commonMachoObj in commons_test.bn,
// writeMachoAsm in dynmacho_abs_test.bn, machoLcOffset / bytesAtEqual in dynmacho_test.bn,
// testTmpDir in link_test.bn, fail in parse_elf_test.bn.)

// machoSymEntry returns the offset of the nlist_64 named name in the Mach-O object data, or -1.
func machoSymEntry(data *[]readonly uint8, name *[]readonly char) int {
	var st int = machoLcOffset(data, 0x2) // LC_SYMTAB
	if st < 0 { return -1 }
	var symOff int = cast(int, u32(data, st + 8))
	var nSyms int = cast(int, u32(data, st + 12))
	var strOff int = cast(int, u32(data, st + 16))
	for i := 0; i < nSyms; i++ {
		var e int = symOff + i * 16
		var at int = strOff + cast(int, u32(data, e))
		if bytesAtEqual(data, at, name) && data[at + len(name)] == 0 { return e }
	}
	return -1
}

// The Mach-O reader marks a private external (N_PEXT) Hidden, and neither an ordinary external
// nor a debug (stab) entry whose code has the same bit (N_PC, 0x30).
func TestReadMachoPrivateExtern() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = visAsm()
	a.ObjFormat = asm.OBJ_MACHO
	var path @[]char = writeMachoAsm(a, dir, "vis.o")
	if len(path) == 0 { return fail("cannot build the object") }
	data, ok := readFile(path)
	if !ok { return fail("cannot read the object") }
	var e int = machoSymEntry(data, "d2")
	if e < 0 { return fail("no symbol d2") }
	data[e + 4] = cast(uint8, cast(int, data[e + 4]) | MACHO_N_PEXT)
	var e0 int = machoSymEntry(data, "d0")
	if e0 < 0 { return fail("no symbol d0") }
	data[e0 + 4] = 0x30 // N_PC, a stab code
	obj, perr := parseMachoBytes(data, path)
	if len(perr) != 0 { return fail(buf.Concat("parse: ", perr)) }
	var seen int = 0
	for s := 0; s < len(obj.Symbols); s++ {
		var sym InputSymbol = obj.Symbols[s]
		if charsEqual(sym.Name, "d2") {
			if !sym.Hidden { return fail("the private external d2 is not Hidden") }
			seen = seen + 1
		} else if charsEqual(sym.Name, "d1") {
			if sym.Hidden { return fail("the external d1 is Hidden") }
			seen = seen + 1
		} else if charsEqual(sym.Name, "d0") {
			if sym.Hidden { return fail("the stab entry d0 is Hidden") }
			seen = seen + 1
		}
	}
	if seen != 3 { return fail("d0 / d1 / d2 missing") }
	return ""
}

// The Mach-O reader reads an external N_UNDF with a size as a common: Size its n_value, Value
// its alignment — 2^GET_COMM_ALIGN, or, for a field of 0, the next power of two at or above
// the size, at most 2^15 (ld64's rule): 128 for 100 bytes, 2^15 for 70000.
func TestReadMachoCommonSymbol() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var path @[]char = commonMachoObj(dir)
	if len(path) == 0 { return fail("cannot build the object") }
	data, ok := readFile(path)
	if !ok { return fail("cannot read the object") }
	obj, perr := parseMachoBytes(data, path)
	if len(perr) != 0 { return fail(buf.Concat("parse: ", perr)) }
	var seen int = 0
	for i := 0; i < len(obj.Symbols); i++ {
		var s InputSymbol = obj.Symbols[i]
		if charsEqual(s.Name, "_x") {
			if !s.Common || s.SecIndex != -1 || s.Size != 12 || s.Value != 8 {
				return fail("_x does not read as a 12-byte, 8-aligned common")
			}
			seen = seen + 1
		} else if charsEqual(s.Name, "_y") {
			if !s.Common || s.Size != 100 || s.Value != 128 { return fail("_y is not 128-aligned") }
			seen = seen + 1
		} else if charsEqual(s.Name, "_z") {
			if !s.Common || s.Size != 70000 || s.Value != 0x8000 { return fail("_z is not 2^15-aligned") }
			seen = seen + 1
		}
	}
	if seen != 3 { return fail("not all of _x, _y and _z were read") }
	return ""
}
