package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/macho"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// readMachoObj assembles a, writes it as an arm64 Mach-O object, and reads it back
// through the reader under test.  Assembling/writing/reading are pure byte work, so
// this needs no macOS tools and runs on any host.  The error is a mutable @[]char so
// a caller can pass it to fail().
func readMachoObj(a @asm.Assembler, path *[]readonly char) (@InputObject, @[]char) {
	aarch64.ResolveFixups(a)
	a.Finalize()
	var none @InputObject
	if a.HasError { return none, buf.CopyStr("assembler error") }
	if !macho.WriteARM64(a, path) { return none, buf.CopyStr("failed to write Mach-O object") }
	data, ok := readFile(path)
	if !ok { return none, buf.CopyStr("cannot re-read written object") }
	obj, perr := parseMachoBytes(data, path)
	if len(perr) != 0 { return none, buf.CopyStr(perr) }
	return obj, buf.CopyStr("")
}

// relocKindFor returns the Kind of the first relocation whose target symbol is
// named symName, or -1 if none.
func relocKindFor(obj @InputObject, symName *[]readonly char) int {
	for r := 0; r < len(obj.Relocs); r++ {
		var si int = obj.Relocs[r].SymIndex
		if si >= 0 && si < len(obj.Symbols) && charsEqual(obj.Symbols[si].Name, symName) {
			return obj.Relocs[r].Kind
		}
	}
	return -1
}

// countRelocKind returns how many relocations have the given Kind.
func countRelocKind(obj @InputObject, kind int) int {
	var n int = 0
	for r := 0; r < len(obj.Relocs); r++ {
		if obj.Relocs[r].Kind == kind { n = n + 1 }
	}
	return n
}

// Assemble an arm64 object with a text section (a global _start referencing a local
// __const symbol via ADRP+ADD and calling a global helper, plus helper itself) and a
// rodata symbol, then read it back and check the machine, section classification,
// and symbols.
func TestReadMachoArm64SectionsAndSymbols() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	aarch64.Adrp(a, aarch64.X1, "msg")
	aarch64.AddImmLabel(a, true, aarch64.X1, aarch64.X1, "msg")
	aarch64.Bl(a, "helper")
	aarch64.Ret(a)
	a.DefineLabel("helper")
	a.SetGlobal("helper")
	aarch64.Ret(a)

	a.SetSection("rodata", -1)
	a.DefineLabel("msg")
	a.EmitAsciz("hi")

	obj, err := readMachoObj(a, "/tmp/binate_link_macho_basic.o")
	if len(err) != 0 { return fail(err) }
	if obj.Machine != EM_AARCH64 { return fail("wrong e_machine (expected aarch64)") }

	if len(obj.Sections) != 2 { return fail("expected exactly 2 sections (__text, __const)") }
	var ti int = -1
	var ri int = -1
	for i := 0; i < len(obj.Sections); i++ {
		if (obj.Sections[i].Flags & SF_EXEC) != 0 { ti = i }
		if obj.Sections[i].Flags == SF_READ { ri = i }
	}
	if ti < 0 { return fail("no executable (text) section") }
	if ri < 0 { return fail("no read-only (rodata/__const) section") }
	if !charsEqual(obj.Sections[ri].Name, "__const") {
		return fail("read-only section should be __const")
	}
	if (obj.Sections[ti].Flags & SF_READ) == 0 { return fail("text section missing SF_READ") }
	if len(obj.Sections[ti].Data) < 4 { return fail("text section too small") }
	if len(obj.Sections[ri].Data) != 3 { return fail("rodata should be \"hi\\0\" (3 bytes)") }

	var si int = findSymbol(obj, "_start")
	if si < 0 || obj.Symbols[si].Binding != BIND_GLOBAL {
		return fail("_start should be a global symbol")
	}
	if obj.Symbols[si].SecIndex < 0 { return fail("_start should be defined in a section") }
	// _start is the first thing in __text, so its section-relative Value is 0 — even
	// though __const precedes __text in the object (so _start's raw n_value is the
	// __const size).  A non-zero Value here means the section addr wasn't subtracted,
	// which would make the entry point (and every __text symbol) resolve off by that
	// amount — the entry would land mid-function.
	if obj.Symbols[si].Value != cast(uint, 0) {
		return fail("_start's Value should be section-relative (0), not its object address")
	}
	var hi int = findSymbol(obj, "helper")
	if hi < 0 || obj.Symbols[hi].Binding != BIND_GLOBAL {
		return fail("helper should be a global symbol")
	}
	// helper follows _start's four instructions (16 bytes) within __text.
	if obj.Symbols[hi].SecIndex != obj.Symbols[si].SecIndex {
		return fail("helper should share _start's section")
	}
	if obj.Symbols[hi].Value != cast(uint, 16) {
		return fail("helper's Value should be its 16-byte offset within __text")
	}
	var mi int = findSymbol(obj, "msg")
	if mi < 0 { return fail("msg symbol missing") }
	if obj.Symbols[mi].Binding != 0 { return fail("msg should be a local symbol") }
	if obj.Symbols[mi].SecIndex < 0 { return fail("msg should be defined in a section") }
	// msg is the first (only) datum in __const, so its section-relative Value is 0.
	if obj.Symbols[mi].Value != cast(uint, 0) { return fail("msg's Value should be 0 within __const") }
	return ""
}

// The ADRP+ADD reference to msg and the BL to helper must translate to the canonical
// ELF relocation kinds, each pointing at the right symbol.
func TestReadMachoArm64Relocs() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	aarch64.Adrp(a, aarch64.X1, "msg")
	aarch64.AddImmLabel(a, true, aarch64.X1, aarch64.X1, "msg")
	aarch64.Bl(a, "helper")
	aarch64.Ret(a)
	a.DefineLabel("helper")
	a.SetGlobal("helper")
	aarch64.Ret(a)
	a.SetSection("rodata", -1)
	a.DefineLabel("msg")
	a.EmitAsciz("hi")

	obj, err := readMachoObj(a, "/tmp/binate_link_macho_relocs.o")
	if len(err) != 0 { return fail(err) }

	if relocKindFor(obj, "helper") != R_AARCH64_CALL26 {
		return fail("BL helper should translate to R_AARCH64_CALL26")
	}
	if countRelocKind(obj, R_AARCH64_ADR_PREL_PG_HI21) < 1 {
		return fail("ADRP msg should translate to R_AARCH64_ADR_PREL_PG_HI21")
	}
	if countRelocKind(obj, R_AARCH64_ADD_ABS_LO12_NC) < 1 {
		return fail("ADD :lo12:msg should translate to R_AARCH64_ADD_ABS_LO12_NC")
	}
	// Both the PAGE21 and the PAGEOFF12 relocs must resolve to msg.
	if relocKindFor(obj, "msg") != R_AARCH64_ADR_PREL_PG_HI21 &&
			relocKindFor(obj, "msg") != R_AARCH64_ADD_ABS_LO12_NC {
		return fail("msg relocations should target the msg symbol")
	}
	return ""
}

// A rodata_relro global is written to Mach-O __DATA_CONST,__const; the reader must
// classify that segment as writable data (SF_WRITE), NOT read-only, so bnld's Layout puts
// it in __DATA — the writable segment where dyld can rebase the absolute pointers such
// data holds.  Left in a read-only segment, those pointers dangle after a PIE slide.
func TestReadMachoDataConstIsWritable() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("helper")
	a.SetGlobal("helper")
	aarch64.Ret(a)
	a.SetSection("rodata_relro", -1) // → __DATA_CONST,__const
	a.DefineLabel("_p")
	a.SetGlobal("_p")
	a.AddFixup("helper", 0, 0, a.WordSize) // an 8-byte absolute pointer → R_AARCH64_ABS64
	a.Fill(a.WordSize, cast(uint8, 0))

	obj, err := readMachoObj(a, "/tmp/binate_link_macho_dataconst.o")
	if len(err) != 0 { return fail(err) }
	if countRelocKind(obj, R_AARCH64_ABS64) < 1 {
		return fail("the rodata_relro pointer should read back as an R_AARCH64_ABS64 reloc")
	}
	var si int = findSection(obj, "__const")
	if si < 0 { return fail("no __const section (rodata_relro) found") }
	if (obj.Sections[si].Flags & SF_WRITE) == 0 {
		return fail("__DATA_CONST,__const must be writable so bnld puts it in __DATA for rebasing")
	}
	return ""
}

// putName writes name's bytes into b at off (Mach-O 16-byte name fields; b is pre-zeroed
// by make_slice, so a short name is NUL-padded).
func putName(b @[]uint8, off int, name *[]readonly char) {
	for i := 0; i < len(name); i++ { b[off + i] = cast(uint8, name[i]) }
}

// __compact_unwind / __eh_frame are dropped by the reader: they are intermediate
// unwind-metadata sections ld64 consumes, and they bear section-relative (non-extern)
// relocations bnld does not resolve.  An object with such a section must parse cleanly
// with the section omitted — and its section-relative reloc must NOT surface the
// "section-relative Mach-O relocation unsupported" error (it is skipped with the section;
// without the drop, this same object would fail on that reloc).
func TestParseMachoDropsCompactUnwind() testing.TestResult {
	// header(32) + one LC_SEGMENT_64 (72 + 2*80 = 232) + __text data(4) + __compact_unwind
	// data(8) + one relocation_info(8) = 284.
	var b @[]uint8 = make_slice(uint8, 284)
	machoHeader(b, 1, 232)
	putU32LE(b, 32, MACHO_LC_SEGMENT_64)
	putU32LE(b, 36, 232) // cmdsize
	putU32LE(b, 32 + 64, 2) // nsects
	// section 0: __text, 4 bytes at file offset 264, no relocs.
	var s0 int = 32 + 72
	putName(b, s0 + 0, "__text")
	putName(b, s0 + 16, "__TEXT")
	putU32LE(b, s0 + 40, 4) // size
	putU32LE(b, s0 + 48, 264) // offset
	// section 1: __compact_unwind, 8 bytes at 268, one section-relative UNSIGNED reloc.
	var s1 int = s0 + 80
	putName(b, s1 + 0, "__compact_unwind")
	putName(b, s1 + 16, "__LD")
	putU32LE(b, s1 + 32, 4) // addr (object vmaddr, just past __text)
	putU32LE(b, s1 + 40, 8) // size
	putU32LE(b, s1 + 48, 268) // offset
	putU32LE(b, s1 + 56, 276) // reloff
	putU32LE(b, s1 + 60, 1) // nreloc
	// The relocation_info at 276: r_address 0, non-extern UNSIGNED (length 3) to section 1.
	putU32LE(b, 276, 0) // r_address
	putU32LE(b, 280, (3 << 25) | 1) // length=3, extern=0, type=UNSIGNED(0), symbolnum=1
	obj, err := parseMachoBytes(b, "/tmp/macho_compact_unwind")
	if len(err) != 0 { return fail(buf.Concat("parse should drop __compact_unwind, not fail: ", err)) }
	if len(obj.Sections) != 1 {
		return fail("expected exactly one section (__compact_unwind dropped)")
	}
	if !charsEqual(obj.Sections[0].Name, "__text") {
		return fail("the surviving section should be __text")
	}
	if len(obj.Relocs) != 0 { return fail("the dropped section's reloc must not be parsed") }
	return ""
}

// A GOT-indirect reference (ADRP :got: + LDR :got_lo12:) to an external data symbol
// must translate to the GOT relaxation kinds the patcher relaxes in a static link.
func TestReadMachoArm64GotReloc() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	aarch64.AdrpGot(a, aarch64.X2, "_ext")
	aarch64.LdrGotLo12(a, aarch64.X2, aarch64.X2, "_ext")
	aarch64.Ret(a)
	// The assembler rejects an unresolved label, so _ext must be defined; a global
	// GOT-referenced datum still yields GOT_LOAD relocations (which the reader
	// translates to the relaxable GOT kinds).
	a.SetSection("data", -1)
	a.DefineLabel("_ext")
	a.SetGlobal("_ext")
	a.EmitUint64(cast(uint64, 0))

	obj, err := readMachoObj(a, "/tmp/binate_link_macho_got.o")
	if len(err) != 0 { return fail(err) }
	if countRelocKind(obj, R_AARCH64_ADR_GOT_PAGE) != 1 {
		return fail("ADRP :got:_ext should translate to R_AARCH64_ADR_GOT_PAGE")
	}
	if countRelocKind(obj, R_AARCH64_LD64_GOT_LO12_NC) != 1 {
		return fail("LDR :got_lo12:_ext should translate to R_AARCH64_LD64_GOT_LO12_NC")
	}
	if relocKindFor(obj, "_ext") != R_AARCH64_ADR_GOT_PAGE &&
			relocKindFor(obj, "_ext") != R_AARCH64_LD64_GOT_LO12_NC {
		return fail("GOT relocations should target the _ext symbol")
	}
	return ""
}

// A non-Mach-O byte slice must be rejected with a non-empty error, not misread.
func TestParseMachoRejectsNonMacho() testing.TestResult {
	var junk @[]uint8 = make_slice(uint8, 64)
	junk[0] = 0x7f
	junk[1] = 0x45 // ELF magic, not Mach-O
	_, err := parseMachoBytes(junk, "/tmp/not_macho")
	if len(err) == 0 { return fail("a non-Mach-O buffer should be rejected") }
	return ""
}

// putU32LE writes a little-endian 32-bit value into b at off (test byte-builder).
func putU32LE(b @[]uint8, off int, v int) {
	b[off + 0] = cast(uint8, v & 0xff)
	b[off + 1] = cast(uint8, (v >> 8) & 0xff)
	b[off + 2] = cast(uint8, (v >> 16) & 0xff)
	b[off + 3] = cast(uint8, (v >> 24) & 0xff)
}

// machoHeader writes a 32-byte arm64 mach_header_64 (MH_OBJECT) into b.
func machoHeader(b @[]uint8, ncmds int, sizeofcmds int) {
	b[0] = cast(uint8, 0xcf)
	b[1] = cast(uint8, 0xfa)
	b[2] = cast(uint8, 0xed)
	b[3] = cast(uint8, 0xfe) // MH_MAGIC_64, little-endian
	putU32LE(b, 4, MACHO_CPU_ARM64) // cputype
	putU32LE(b, 8, 0) // cpusubtype
	putU32LE(b, 12, MACHO_MH_OBJECT) // filetype
	putU32LE(b, 16, ncmds)
	putU32LE(b, 20, sizeofcmds)
	putU32LE(b, 24, 0) // flags
	putU32LE(b, 28, 0) // reserved
}

// A load command whose cmdsize is smaller than the fixed fields the reader must read
// (here an LC_SEGMENT_64 with cmdsize 8) must be rejected before any out-of-range
// field read — not decoded past its own extent.
func TestParseMachoRejectsTruncatedCommand() testing.TestResult {
	var b @[]uint8 = make_slice(uint8, 40) // 32 header + 8 command
	machoHeader(b, 1, 8)
	putU32LE(b, 32, MACHO_LC_SEGMENT_64) // cmd
	putU32LE(b, 36, 8) // cmdsize (too small for a segment)
	_, err := parseMachoBytes(b, "/tmp/macho_trunc")
	if len(err) == 0 { return fail("a truncated segment command should be rejected") }
	return ""
}

// A segment command declaring more sections than its cmdsize can hold must be
// rejected: otherwise the 80-byte section scan runs past the command (and, for
// zero-fill sections, past the section scratch arrays — an out-of-bounds write).
func TestParseMachoRejectsOversizedSections() testing.TestResult {
	var b @[]uint8 = make_slice(uint8, 104) // 32 header + 72 segment header
	machoHeader(b, 1, 72)
	putU32LE(b, 32, MACHO_LC_SEGMENT_64) // cmd
	putU32LE(b, 36, 72) // cmdsize (header only, no room for sections)
	putU32LE(b, 32 + 64, 1000) // nsects (far more than fit)
	_, err := parseMachoBytes(b, "/tmp/macho_oversized_secs")
	if len(err) == 0 { return fail("oversized nsects should be rejected") }
	return ""
}

// A symbol count that would demand a huge allocation (nsyms * 16 bytes >> file size)
// must be rejected before the make_slice, not turned into an OOM.
func TestParseMachoRejectsHugeSymCount() testing.TestResult {
	var b @[]uint8 = make_slice(uint8, 56) // 32 header + 24 symtab command
	machoHeader(b, 1, 24)
	putU32LE(b, 32, MACHO_LC_SYMTAB) // cmd
	putU32LE(b, 36, 24) // cmdsize
	putU32LE(b, 40, 48) // symoff
	putU32LE(b, 44, 0x7fffffff) // nsyms (absurd)
	putU32LE(b, 48, 48) // stroff
	_, err := parseMachoBytes(b, "/tmp/macho_huge_syms")
	if len(err) == 0 { return fail("an absurd symbol count should be rejected") }
	return ""
}
