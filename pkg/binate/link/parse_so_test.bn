package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// mkSo builds a minimal ELF64 shared object in memory for readSoname: an ELF header,
// program headers (a PT_LOAD covering the whole file with vaddr == offset, and a
// PT_DYNAMIC), a .dynstr holding the SONAME, and a .dynamic array.  includeDynamic
// drops the PT_DYNAMIC (leaving only the PT_LOAD) when false; includeSoname drops the
// DT_SONAME entry when false.  vaddr == offset throughout, so the DT_STRTAB vaddr maps
// straight to its own file offset.
func mkSo(soname *[]readonly char, includeDynamic bool, includeSoname bool) @[]uint8 {
	var phnum int = 2
	if !includeDynamic { phnum = 1 }
	var phoff int = 64
	var strOff int = phoff + phnum * 56
	var strSize int = 2 + len(soname) // \0 <soname> \0
	var dynOff int = strOff + strSize
	if dynOff % 8 != 0 { dynOff = dynOff + (8 - dynOff % 8) } // align 8
	var nDyn int = 3
	if !includeSoname { nDyn = 2 }
	var dynSize int = nDyn * 16
	var fileSize int = dynOff + dynSize
	var out @[]uint8 = make_slice(uint8, fileSize)

	// ELF header.
	out[0] = 0x7f
	out[1] = 0x45
	out[2] = 0x4c
	out[3] = 0x46
	out[4] = ELFCLASS64
	out[5] = ELFDATA2LSB
	writeLE(out, 16, 3, 2) // e_type = ET_DYN
	writeLE(out, 18, EM_AARCH64, 2) // e_machine
	writeLE(out, 32, phoff, 8) // e_phoff
	writeLE(out, 54, 56, 2) // e_phentsize
	writeLE(out, 56, phnum, 2) // e_phnum

	// PT_LOAD covering the whole file, vaddr == offset.
	writeLE(out, phoff + 0, PT_LOAD, 4)
	writeLE(out, phoff + 4, 5, 4) // p_flags = R|X
	writeLE(out, phoff + 8, 0, 8) // p_offset
	writeLE(out, phoff + 16, 0, 8) // p_vaddr
	writeLE(out, phoff + 32, fileSize, 8) // p_filesz
	writeLE(out, phoff + 40, fileSize, 8) // p_memsz

	if includeDynamic {
		var pd int = phoff + 56
		writeLE(out, pd + 0, PT_DYNAMIC, 4)
		writeLE(out, pd + 8, dynOff, 8) // p_offset
		writeLE(out, pd + 16, dynOff, 8) // p_vaddr
		writeLE(out, pd + 32, dynSize, 8) // p_filesz
	}

	// .dynstr: a leading NUL, the SONAME, a trailing NUL.
	for i := 0; i < len(soname); i++ { out[strOff + 1 + i] = cast(uint8, soname[i]) }

	// .dynamic: [DT_SONAME], DT_STRTAB, DT_NULL.
	var d int = dynOff
	if includeSoname {
		writeLE(out, d + 0, DT_SONAME, 8)
		writeLE(out, d + 8, 1, 8) // the SONAME is at .dynstr offset 1
		d = d + 16
	}
	writeLE(out, d + 0, DT_STRTAB, 8)
	writeLE(out, d + 8, strOff, 8) // vaddr == file offset
	d = d + 16
	writeLE(out, d + 0, DT_NULL, 8)
	writeLE(out, d + 8, 0, 8)
	return out
}

// readSoname returns the DT_SONAME string of a well-formed shared object.
func TestReadSonameOk() testing.TestResult {
	var so @[]uint8 = mkSo("libtest.so.1", true, true)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = so
	name, err := readSoname(rd, "libtest.so")
	if len(err) != 0 { return fail(buf.Concat("readSoname failed: ", err)) }
	if !charsEqual(name, "libtest.so.1") { return fail("wrong SONAME") }
	return ""
}

// A file with no PT_DYNAMIC is not a dynamic ELF — rejected.
func TestReadSonameNoDynamic() testing.TestResult {
	var so @[]uint8 = mkSo("libtest.so.1", false, true)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = so
	_, err := readSoname(rd, "x")
	if len(err) == 0 { return fail("a file with no PT_DYNAMIC should be rejected") }
	return ""
}

// A dynamic ELF that carries no DT_SONAME cannot name itself — rejected.
func TestReadSonameNoSoname() testing.TestResult {
	var so @[]uint8 = mkSo("libtest.so.1", true, false)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = so
	_, err := readSoname(rd, "x")
	if len(err) == 0 { return fail("a shared object with no DT_SONAME should be rejected") }
	return ""
}

// A non-ELF file is rejected (bad magic).
func TestReadSonameBadMagic() testing.TestResult {
	var junk @[]uint8 = make_slice(uint8, 128)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = junk
	_, err := readSoname(rd, "x")
	if len(err) == 0 { return fail("a non-ELF file should be rejected") }
	return ""
}

// neededLibs prepends the default libc.so.6, then adds each shared object's own SONAME,
// deduping — a library whose SONAME is already listed (e.g. a libc.so.X that resolves
// back to libc.so.6) is not repeated.
func TestNeededLibs() testing.TestResult {
	if len(writeFile("/tmp/binate_test_libextra.so", mkSo("libextra.so.2", true, true))) != 0 {
		return fail("cannot write test .so")
	}
	if len(writeFile("/tmp/binate_test_libc.so", mkSo("libc.so.6", true, true))) != 0 {
		return fail("cannot write test libc .so")
	}
	var paths @[]@[]char = make_slice(@[]char, 2)
	paths[0] = buf.CopyStr("/tmp/binate_test_libextra.so")
	paths[1] = buf.CopyStr("/tmp/binate_test_libc.so") // SONAME libc.so.6 -> deduped
	libs, err := neededLibs(paths)
	if len(err) != 0 { return fail(buf.Concat("neededLibs failed: ", err)) }
	if len(libs) != 2 { return fail("expected libc.so.6 + libextra.so.2 (the libc dup dropped)") }
	if !charsEqual(libs[0], "libc.so.6") { return fail("libc.so.6 should be first (the default)") }
	if !charsEqual(libs[1], "libextra.so.2") { return fail("the extra SONAME should follow") }
	return ""
}

// neededLibs with no shared libraries yields just the default libc.so.6.
func TestNeededLibsDefault() testing.TestResult {
	libs, err := neededLibs(make_slice(@[]char, 0))
	if len(err) != 0 { return fail(buf.Concat("neededLibs failed: ", err)) }
	if len(libs) != 1 || !charsEqual(libs[0], "libc.so.6") {
		return fail("with no -l shared libs, only libc.so.6 is needed")
	}
	return ""
}
