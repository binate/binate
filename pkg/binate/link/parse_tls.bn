package "pkg/binate/link"

import "pkg/binate/buf"

// Thread-local storage in an input, which bnld does not link: an ELF section of the
// thread-local template (SHF_TLS) or thread-local symbol (STT_TLS), or a Mach-O thread-local
// section (S_THREAD_LOCAL_*).  Read as ordinary data it would link without a word — a
// thread-local object one address shared by every thread, a Mach-O __thread_bss filled from
// the file's header (it has no file bytes) — so the readers reject the object.

// elfTlsError returns why the ELF object obj — read from data (its symbol table already
// validated by parseSymbols), its section headers at shoff (shentsize apart, shnum of them),
// their names at strDataOff — cannot be linked for thread-local storage, or "": a section it
// keeps (elfToMy) is thread-local, or a symbol is.
func elfTlsError(data *[]readonly uint8, fmt elfFmt, shoff int, shentsize int, shnum int,
		strDataOff int, elfToMy *[]readonly int, obj @InputObject) @[]readonly char {
	for i := 0; i < shnum; i++ {
		if elfToMy[i] < 0 { continue }
		if (cast(int, u32(data, shoff + i * shentsize + fmt.ShFlags)) & SHF_TLS) == 0 { continue }
		var name @[]char = elfSectionName(data, len(data), shoff, shentsize, strDataOff, i)
		return buf.Concat(name, " is thread-local storage (SHF_TLS), which bnld does not link")
	}
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if cast(int, u32(data, sh + 4)) != SHT_SYMTAB { continue }
		symOff, ok := readOffC(data, sh + fmt.ShOffset, fmt.Is64)
		entsize, eok := readOffC(data, sh + fmt.ShEntsize, fmt.Is64)
		if !ok || !eok { return "" }
		for s := 0; s < len(obj.Symbols); s++ {
			if (cast(int, data[symOff + s * entsize + fmt.SymInfo]) & 0xf) != STT_TLS { continue }
			return buf.Concat(obj.Symbols[s].Name,
					" is a thread-local symbol (STT_TLS), which bnld does not link")
		}
		return ""
	}
	return ""
}

// MACHO_S_THREAD_LOCAL_REGULAR is the first Mach-O thread-local section type (a section of
// the template's initial bytes).
const MACHO_S_THREAD_LOCAL_REGULAR int = 0x11

// MACHO_S_THREAD_LOCAL_INIT_FUNCTION_POINTERS is the last Mach-O thread-local section type (the
// thread-local variables' initializer pointers).
const MACHO_S_THREAD_LOCAL_INIT_FUNCTION_POINTERS int = 0x15

// isMachoThreadLocal reports whether a Mach-O section whose section_64.flags are flags is
// thread-local (S_THREAD_LOCAL_REGULAR .. S_THREAD_LOCAL_INIT_FUNCTION_POINTERS): the
// template's initial bytes or zero fill, the variable descriptors, pointers to descriptors, or
// the variables' initializer pointers.
func isMachoThreadLocal(flags int) bool {
	var t int = flags & 0xff
	return t >= MACHO_S_THREAD_LOCAL_REGULAR && t <= MACHO_S_THREAD_LOCAL_INIT_FUNCTION_POINTERS
}
