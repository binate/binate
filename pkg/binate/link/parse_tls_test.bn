package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/macho"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Thread-local storage in an input (parse_tls.bn), which bnld does not link: the readers
// reject an ELF object with a thread-local section or symbol (an archive member only if a link
// pulls it in, through Rejected) and a Mach-O object with a thread-local section.  (testTmpDir
// is in link_test.bn, fail in parse_elf_test.bn.)

// tlsHas reports whether s contains sub.
func tlsHas(s *[]readonly char, sub *[]readonly char) bool {
	for i := 0; i + len(sub) <= len(s); i++ {
		if charsEqual(s[i:i + len(sub)], sub) { return true }
	}
	return false
}

// tlsObject writes to path an aarch64 object (Mach-O when isMacho is set) with a function and,
// by kind: 0 a thread-local variable in tdata, 1 an undefined thread-local symbol a data word
// refers to, 2 (Mach-O) a `.tbss` object — reporting whether it could.
func tlsObject(path *[]readonly char, isMacho bool, kind int) bool {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_ELF
	if isMacho { a.ObjFormat = asm.OBJ_MACHO }
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.EmitUint32(0xD65F03C0) // ret
	if kind == 0 {
		a.SetSection("tdata", -1)
		a.DefineLabel("v")
		a.EmitUint32(5)
	} else if kind == 1 {
		a.SetGlobal("ext")
		a.SetType("ext", asm.SYM_TLS)
		a.SetSection("data", -1)
		a.EmitAddr("ext")
	} else {
		a.DefineTbssSymbol("_b$tlv$init", 4, 4)
	}
	if !aarch64.ResolveFixups(a) { return false }
	a.Finalize()
	if a.HasError { return false }
	if isMacho { return macho.WriteARM64(a, path) }
	return elf.WriteAArch64(a, path)
}

// An ELF object holding a thread-local section, or referring to a thread-local symbol, is
// rejected naming it — Rejected when read as an archive member would be.
func TestReadElfRejectsThreadLocal() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var want @[]@[]char = @[]@[]char{".tdata is thread-local storage (SHF_TLS)",
			"ext is a thread-local symbol (STT_TLS)"}
	for k := 0; k < 2; k++ {
		var path @[]char = buf.Concat(dir, "/tls.o")
		if !tlsObject(path, false, k) { return fail("cannot write the object") }
		_, err := ReadObject(path)
		if !tlsHas(err, want[k]) { return fail(buf.Concat("ReadObject: ", err)) }
		data, ok := readFile(path)
		if !ok { return fail("cannot read the object back") }
		obj, rerr := readObjectBytes(data, path)
		if len(rerr) != 0 || !tlsHas(obj.Rejected, want[k]) {
			return fail(buf.Concat("not deferred as Rejected: ", rerr))
		}
	}
	return ""
}

// A Mach-O object with a thread-local section (here `.tbss`'s __thread_bss, which has no file
// bytes) is rejected naming it and the object; the thread-local types are 0x11 to 0x15,
// whatever attribute bits the flags carry.
func TestReadMachoRejectsThreadLocal() testing.TestResult {
	if isMachoThreadLocal(0x10) || !isMachoThreadLocal(0x11) || !isMachoThreadLocal(0x80000015) ||
			isMachoThreadLocal(0x16) || isMachoThreadLocal(0x80000400) {
		return fail("isMachoThreadLocal misreads a section type")
	}
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var path @[]char = buf.Concat(dir, "/tlv.o")
	if !tlsObject(path, true, 2) { return fail("cannot write the object") }
	data, ok := readFile(path)
	if !ok { return fail("cannot read the object back") }
	_, err := parseMachoBytes(data, path)
	if !tlsHas(err, buf.Concat(path, ": __thread_bss is thread-local storage")) {
		return fail(buf.Concat("parseMachoBytes: ", err))
	}
	return ""
}
