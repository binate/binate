package "pkg/binate/link"

import "pkg/binate/buf"

// symbolAddr computes the final virtual address of the symbol (objIdx, symIdx),
// following an undefined reference through the symbol table to its cross-object
// definition.  Returns (addr, true) for a defined or resolved symbol, (0, true)
// for a weak undefined reference (address 0), and (0, false) only if a defined
// symbol's section was omitted by layout (degenerate — a symbol in an empty kind).
func symbolAddr(t @SymbolTable, lr @LayoutResult, objIdx int, symIdx int) (uint, bool) {
	var sym InputSymbol = t.Objs[objIdx].Symbols[symIdx]
	if sym.SecIndex < 0 {
		oo, ss, found := t.Lookup(sym.Name)
		if !found { return cast(uint, 0), true } // weak undefined -> 0
		return symbolAddr(t, lr, oo, ss)
	}
	var outIdx int = t.Objs[objIdx].Sections[sym.SecIndex].OutIndex
	if outIdx < 0 { return cast(uint, 0), false }
	var base uint = lr.Sections[outIdx].Addr
	var secOff uint = t.Objs[objIdx].Sections[sym.SecIndex].OutOffset
	return base + secOff + sym.Value, true
}

// writeLE writes the n low bytes of value into dst at off, little-endian.  It
// works for a signed value (the arithmetic shift is masked to a byte each step),
// so a negative PC-relative displacement writes its two's-complement bytes.
func writeLE(dst @[]uint8, off int, value int, n int) {
	for i := 0; i < n; i++ {
		dst[off + i] = cast(uint8, (value >> cast(uint, 8 * i)) & 0xff)
	}
}

// Relocate patches every relocation in the linked objects: for each it computes
// the patch site's virtual address P and the target symbol's address S, applies
// the per-kind formula, and writes the result into the containing output section's
// merged Data.  Supported x86-64 kinds: R_X86_64_64 (S + A, 64-bit absolute) and
// R_X86_64_PC32 / R_X86_64_PLT32 (S + A - P, 32-bit PC-relative; PLT32 is patched
// as PC32 for a statically-resolved symbol).  Returns "" on success, or a
// non-empty error for an unsupported kind or a PC-relative displacement that does
// not fit a signed 32-bit field.
func Relocate(t @SymbolTable, lr @LayoutResult) @[]readonly char {
	for o := 0; o < len(t.Objs); o++ {
		var obj @InputObject = t.Objs[o]
		for r := 0; r < len(obj.Relocs); r++ {
			var rel InputReloc = obj.Relocs[r]
			if rel.SecIndex < 0 || rel.SecIndex >= len(obj.Sections) { continue }
			if rel.SymIndex < 0 || rel.SymIndex >= len(obj.Symbols) {
				return buf.Concat("relocation symbol index out of range in ", obj.Path)
			}
			var outIdx int = obj.Sections[rel.SecIndex].OutIndex
			if outIdx < 0 { continue } // patched section was omitted
			var secOff uint = obj.Sections[rel.SecIndex].OutOffset
			var byteLoc int = cast(int, secOff + rel.Offset)
			var p uint = lr.Sections[outIdx].Addr + secOff + rel.Offset
			s, sok := symbolAddr(t, lr, o, rel.SymIndex)
			if !sok {
				return buf.Concat("unresolved symbol ", obj.Symbols[rel.SymIndex].Name)
			}
			var data @[]uint8 = lr.Sections[outIdx].Data

			// Field width per kind; unsupported kinds fail loud before any write.
			var width int = 0
			if rel.Kind == R_X86_64_64 {
				width = 8
			} else if rel.Kind == R_X86_64_PC32 || rel.Kind == R_X86_64_PLT32 {
				width = 4
			} else if rel.Kind == R_X86_64_REX_GOTPCRELX {
				return "GOT relocation unsupported (hermetic links only)"
			} else {
				return buf.Concat("unsupported relocation in ", obj.Path)
			}
			if byteLoc < 0 || byteLoc + width > len(data) {
				return buf.Concat("relocation offset out of range in ", obj.Path)
			}

			if width == 8 {
				writeLE(data, byteLoc, cast(int, s) + rel.Addend, 8)
			} else {
				var val int = cast(int, s) + rel.Addend - cast(int, p)
				if val > 0x7fffffff || val < (0 - 0x80000000) {
					return buf.Concat("relocation out of range for ", obj.Symbols[rel.SymIndex].Name)
				}
				writeLE(data, byteLoc, val, 4)
			}
		}
	}
	return ""
}
