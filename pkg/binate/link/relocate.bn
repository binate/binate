package "pkg/binate/link"

import "pkg/binate/buf"

// writeLE writes the n low bytes of value into dst at off, little-endian.  It
// works for a signed value (the arithmetic shift is masked to a byte each step),
// so a negative PC-relative displacement writes its two's-complement bytes.
func writeLE(dst @[]uint8, off int, value int, n int) {
	for i := 0; i < n; i++ {
		dst[off + i] = cast(uint8, (value >> cast(uint, 8 * i)) & 0xff)
	}
}

// writeU32 writes the low 4 bytes of value into dst at off, little-endian.  It takes
// an int64 so a 32-bit instruction word with the high bit set (e.g. 0x90000000) or a
// 64-bit-derived value fits on an ILP32 target where int is 32-bit.
func writeU32(dst @[]uint8, off int, value int64) {
	for i := 0; i < 4; i++ {
		dst[off + i] = cast(uint8, (value >> cast(uint, 8 * i)) & 0xff)
	}
}

// writeU64 writes the low 8 bytes of value into dst at off, little-endian.  It takes a
// uint64 so a 64-bit target address (which may exceed 2^32, e.g. a macOS __PAGEZERO
// base) is written in full on an ILP32 host where int/uint are 32-bit.
func writeU64(dst @[]uint8, off int, value uint64) {
	for i := 0; i < 8; i++ {
		dst[off + i] = cast(uint8, (value >> cast(uint, 8 * i)) & 0xff)
	}
}

// Relocate patches every relocation in the linked objects: for each it computes
// the patch site's virtual address P and the target symbol's address S, then
// dispatches on the object's machine to the per-arch patcher (patchX64 /
// patchAArch64 / patchArm32), which applies the per-kind formula and writes into
// the containing output section's merged Data.  Returns "" on success, or a
// non-empty error for an unsupported kind/machine, an out-of-range offset, or an
// out-of-range or misaligned displacement.
func Relocate(t @SymbolTable, lr @LayoutResult) @[]readonly char {
	for o := 0; o < len(t.Objs); o++ {
		var obj @InputObject = t.Objs[o]
		for r := 0; r < len(obj.Relocs); r++ {
			var rel InputReloc = obj.Relocs[r]
			if rel.SecIndex < 0 || rel.SecIndex >= len(obj.Sections) { continue }
			if rel.SymIndex < 0 || rel.SymIndex >= len(obj.Symbols) {
				return buf.Concat("relocation symbol index out of range in ", obj.Path)
			}
			var outIdx int = obj.Sections[rel.SecIndex].OutIndex
			if outIdx < 0 { continue } // patched section was omitted
			var secOff uint = obj.Sections[rel.SecIndex].OutOffset
			var byteLoc int = cast(int, secOff + rel.Offset)
			var p uint64 = lr.Sections[outIdx].Addr + cast(uint64, secOff) + cast(uint64, rel.Offset)
			oo, ss, found := chosenDef(t, o, rel.SymIndex)
			s, sok := choiceAddr(t, lr, o, rel.SymIndex, oo, ss, found)
			if !sok {
				return buf.Concat("unresolved symbol ", obj.Symbols[rel.SymIndex].Name)
			}
			var data @[]uint8 = lr.Sections[outIdx].Data
			var symName @[]char = obj.Symbols[rel.SymIndex].Name
			// A GOT-indirect reference to a dynamic data import must LOAD the GOT slot
			// (which ld.so fills via GLOB_DAT), not be relaxed to a direct address — s
			// is the slot's own address, and the real datum lives behind it.
			// (A local of a data import's name is its object's own, not the import.)
			var gotImp bool = !isLocalSymbol(obj.Symbols[rel.SymIndex]) && t.isGotImport(symName)
			var addend int = rel.Addend
			// An AArch64 GOT reference whose symbol has a linker-made slot reaches it (the
			// slot holds the addend too).
			var toSlot bool = false
			if obj.Machine == EM_AARCH64 && isAArch64GotKind(rel.Kind) {
				slotAddr, sok := t.gotSlotAddr(o, rel)
				if sok {
					s = slotAddr
					addend = 0
					gotImp = true
					toSlot = true
				}
			}
			if obj.Machine == EM_AARCH64 && isAArch64GotKind(rel.Kind) && gotImp && addend != 0 {
				return gotSlotAddendErr(symName) // an import's own slot holds no addend
			}
			if t.PIE && !toSlot {
				var aerr @[]readonly char
				s, gotImp, aerr = pieAbsoluteTarget(t, o, rel, oo, ss, found, s, gotImp)
				if len(aerr) != 0 { return aerr }
			}

			var e @[]readonly char
			if obj.Machine == EM_X86_64 {
				e = patchX64(data, byteLoc, cast(int, secOff), rel.Kind, addend, s, p, symName, obj.Path,
						gotImp)
			} else if obj.Machine == EM_AARCH64 && rel.Kind == R_AARCH64_LD64_GOTPAGE_LO15 {
				e = patchGotPageLo15(data, byteLoc, addend, s, t.GotBase, t.HasGotBase, symName, obj.Path,
						gotImp)
			} else if obj.Machine == EM_AARCH64 {
				e = patchAArch64(data, byteLoc, rel.Kind, addend, s, p, symName, obj.Path, gotImp)
			} else if obj.Machine == EM_ARM {
				e = patchArm32(data, byteLoc, rel.Kind, rel.Addend, s, p, symName, obj.Path)
			} else {
				e = buf.Concat("unsupported target machine in ", obj.Path)
			}
			if len(e) != 0 { return e }
		}
	}
	return ""
}
