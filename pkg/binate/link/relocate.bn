package "pkg/binate/link"

import "pkg/binate/buf"

// symbolAddr computes the final virtual address of the symbol (objIdx, symIdx),
// following an undefined reference through the symbol table to its cross-object
// definition.  Returns (addr, true) for a defined or resolved symbol, (0, true)
// for a weak undefined reference (address 0), and (0, false) only if a defined
// symbol's section was omitted by layout (degenerate — a symbol in an empty kind).
func symbolAddr(t @SymbolTable, lr @LayoutResult, objIdx int, symIdx int) (uint, bool) {
	var sym InputSymbol = t.Objs[objIdx].Symbols[symIdx]
	if sym.SecIndex < 0 {
		oo, ss, found := t.Lookup(sym.Name)
		if !found { return cast(uint, 0), true } // weak undefined -> 0
		return symbolAddr(t, lr, oo, ss)
	}
	var outIdx int = t.Objs[objIdx].Sections[sym.SecIndex].OutIndex
	if outIdx < 0 { return cast(uint, 0), false }
	var base uint = lr.Sections[outIdx].Addr
	var secOff uint = t.Objs[objIdx].Sections[sym.SecIndex].OutOffset
	return base + secOff + sym.Value, true
}

// writeLE writes the n low bytes of value into dst at off, little-endian.  It
// works for a signed value (the arithmetic shift is masked to a byte each step),
// so a negative PC-relative displacement writes its two's-complement bytes.
func writeLE(dst @[]uint8, off int, value int, n int) {
	for i := 0; i < n; i++ {
		dst[off + i] = cast(uint8, (value >> cast(uint, 8 * i)) & 0xff)
	}
}

// Relocate patches every relocation in the linked objects: for each it computes
// the patch site's virtual address P and the target symbol's address S, then
// dispatches on the object's machine to the per-arch patcher (patchX64 /
// patchAArch64), which applies the per-kind formula and writes into the containing
// output section's merged Data.  Returns "" on success, or a non-empty error for
// an unsupported kind/machine, an out-of-range offset, or an out-of-range or
// misaligned displacement.
func Relocate(t @SymbolTable, lr @LayoutResult) @[]readonly char {
	for o := 0; o < len(t.Objs); o++ {
		var obj @InputObject = t.Objs[o]
		for r := 0; r < len(obj.Relocs); r++ {
			var rel InputReloc = obj.Relocs[r]
			if rel.SecIndex < 0 || rel.SecIndex >= len(obj.Sections) { continue }
			if rel.SymIndex < 0 || rel.SymIndex >= len(obj.Symbols) {
				return buf.Concat("relocation symbol index out of range in ", obj.Path)
			}
			var outIdx int = obj.Sections[rel.SecIndex].OutIndex
			if outIdx < 0 { continue } // patched section was omitted
			var secOff uint = obj.Sections[rel.SecIndex].OutOffset
			var byteLoc int = cast(int, secOff + rel.Offset)
			var p uint = lr.Sections[outIdx].Addr + secOff + rel.Offset
			s, sok := symbolAddr(t, lr, o, rel.SymIndex)
			if !sok {
				return buf.Concat("unresolved symbol ", obj.Symbols[rel.SymIndex].Name)
			}
			var data @[]uint8 = lr.Sections[outIdx].Data
			var symName @[]char = obj.Symbols[rel.SymIndex].Name
			// A GOT-indirect reference to a dynamic data import must LOAD the GOT slot
			// (which ld.so fills via GLOB_DAT), not be relaxed to a direct address — s
			// is the slot's own address, and the real datum lives behind it.
			var gotImp bool = t.isGotImport(symName)

			var e @[]readonly char
			if obj.Machine == EM_X86_64 {
				e = patchX64(data, byteLoc, cast(int, secOff), rel.Kind, rel.Addend, s, p, symName, obj.Path,
						gotImp)
			} else if obj.Machine == EM_AARCH64 {
				e = patchAArch64(data, byteLoc, rel.Kind, rel.Addend, s, p, symName, obj.Path, gotImp)
			} else {
				e = buf.Concat("unsupported target machine in ", obj.Path)
			}
			if len(e) != 0 { return e }
		}
	}
	return ""
}

// patchX64 applies an x86-64 relocation at byteLoc: R_X86_64_64 (S + A, 64-bit
// absolute) and R_X86_64_PC32 / R_X86_64_PLT32 (S + A - P, 32-bit PC-relative;
// PLT32 patched as PC32 for a statically-resolved symbol).  Returns "" or an error
// (unsupported/GOT kind, out-of-range offset, or a displacement that does not fit
// a signed 32-bit field).
func patchX64(data @[]uint8, byteLoc int, secStart int, kind int, addend int, s uint, p uint,
		symName *[]readonly char, objPath *[]readonly char, gotImp bool) @[]readonly char {
	if kind == R_X86_64_REX_GOTPCRELX || kind == R_X86_64_GOTPCRELX {
		return patchGotpcrelx(data, byteLoc, secStart, addend, s, p, symName, objPath, gotImp)
	}
	var width int = 0
	if kind == R_X86_64_64 {
		width = 8
	} else if kind == R_X86_64_PC32 || kind == R_X86_64_PLT32 {
		width = 4
	} else {
		return buf.Concat("unsupported relocation in ", objPath)
	}
	if byteLoc < 0 || byteLoc + width > len(data) {
		return buf.Concat("relocation offset out of range in ", objPath)
	}
	if width == 8 {
		writeLE(data, byteLoc, cast(int, s) + addend, 8)
	} else {
		var val int = cast(int, s) + addend - cast(int, p)
		if val > 0x7fffffff || val < (0 - 0x80000000) {
			return buf.Concat("relocation out of range for ", symName)
		}
		writeLE(data, byteLoc, val, 4)
	}
	return ""
}

// patchGotpcrelx patches a GOTPCRELX / REX_GOTPCRELX relocation — a GOT-indirect load
// of a symbol's address via `mov sym@GOTPCREL(%rip), %reg` (opcode 0x8b).  For a
// *defined* symbol (static link, gotImp=false) it RELAXES the load to a direct
// address computation `lea sym(%rip), %reg` (opcode 0x8d): the opcode byte sits two
// bytes before the disp32 (…, opcode, modrm, disp32), so it flips it and patches the
// disp32 as a PC-relative reference to the symbol (S + A - P; the addend already
// carries the -4 instruction-end adjustment).  For a dynamic *data import*
// (gotImp=true) it KEEPS the load — s is the symbol's GOT slot, filled by ld.so via
// GLOB_DAT — leaving the mov and patching the disp32 to reach the slot.  Any other
// opcode at a GOTPCRELX site (a non-mov relaxable form, or a GOT-materialization we
// do not model) is rejected rather than mis-patched.
func patchGotpcrelx(data @[]uint8, byteLoc int, secStart int, addend int, s uint, p uint,
		symName *[]readonly char, objPath *[]readonly char, gotImp bool) @[]readonly char {
	// The opcode byte (byteLoc - 2) must lie within this reloc's own input section
	// [secStart, ...) — i.e. rel.Offset >= 2 — so a malformed reloc cannot rewrite a
	// byte of a different input merged into the same output section.
	if byteLoc - 2 < secStart || byteLoc + 4 > len(data) {
		return buf.Concat("relocation offset out of range in ", objPath)
	}
	if data[byteLoc - 2] != 0x8b {
		return buf.Concat("unsupported GOTPCRELX form (only mov) in ", objPath)
	}
	if !gotImp {
		data[byteLoc - 2] = 0x8d // mov -> lea (relax: the symbol is defined)
	}
	// gotImp: leave the mov (0x8b) so it loads the GOT slot at s.
	var val int = cast(int, s) + addend - cast(int, p)
	if val > 0x7fffffff || val < (0 - 0x80000000) {
		return buf.Concat("relocation out of range for ", symName)
	}
	writeLE(data, byteLoc, val, 4)
	return ""
}

// patch32Field reads the 32-bit little-endian instruction at loc, replaces the
// bits selected by mask with value (shifted into place and confined to mask), and
// writes it back — leaving the opcode bits intact.  Distinct fields of one
// instruction (e.g. an ADRP's immlo and immhi) are patched by successive calls.
func patch32Field(data @[]uint8, loc int, mask int, value int, shift int) {
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	var insn int = u32(r, loc)
	insn = (insn & (0xffffffff ^ mask)) | ((value << cast(uint, shift)) & mask)
	writeLE(data, loc, insn, 4)
}

// patchAArch64 applies an AArch64 relocation at byteLoc.  ABS64 is a 64-bit data
// word; PREL32 is a 32-bit data word; the rest patch a bit-field of the 32-bit
// instruction.  Branch displacements are S + A - P in bytes (checked 4-aligned and
// in range); ADRP is the page delta (page(S+A) - page(P)) >> 12 split across
// immlo/immhi; ADD/LDR lo12 are the low 12 bits of S + A (LDR scaled by the access
// size).  The GOT relocations are RELAXED (a static link has the symbol defined):
// ADR_GOT_PAGE patches like an ordinary ADRP to the symbol, and LD64_GOT_LO12_NC
// rewrites the GOT-load LDR into a direct address ADD.  Every PC-relative field
// (branches, ADR, ADRP) is range-checked so an over-long displacement is rejected
// loudly rather than truncated into a wrong target.  Returns "" or an error
// (unsupported kind, an unexpected instruction at a GOT-load site, out-of-range file
// offset, or a misaligned or out-of-range displacement).
func patchAArch64(data @[]uint8, byteLoc int, kind int, addend int, s uint, p uint,
		symName *[]readonly char, objPath *[]readonly char, gotImp bool) @[]readonly char {
	var width int = 4
	if kind == R_AARCH64_ABS64 { width = 8 }
	if byteLoc < 0 || byteLoc + width > len(data) {
		return buf.Concat("relocation offset out of range in ", objPath)
	}

	if kind == R_AARCH64_ABS64 {
		writeLE(data, byteLoc, cast(int, s) + addend, 8)
		return ""
	}
	if kind == R_AARCH64_CALL26 || kind == R_AARCH64_JUMP26 {
		var v int = cast(int, s) + addend - cast(int, p)
		if (v & 3) != 0 { return buf.Concat("misaligned branch target for ", symName) }
		if v > 0x7ffffff || v < (0 - 0x8000000) { return buf.Concat("branch out of range for ", symName) }
		patch32Field(data, byteLoc, 0x3ffffff, v >> 2, 0)
		return ""
	}
	if kind == R_AARCH64_ADR_PREL_PG_HI21 || kind == R_AARCH64_ADR_GOT_PAGE {
		// ADR_GOT_PAGE is relaxed identically: in a static link the ADRP names the
		// symbol's page rather than the GOT entry's (paired with the LD64_GOT ->
		// ADD relaxation below).
		var pageMask int = 0 - 0x1000 // ~0xFFF: page(x) = x & pageMask
		var v int = (((cast(int, s) + addend) & pageMask) - (cast(int, p) & pageMask)) >> 12
		// v is a page count in a signed 21-bit field: [-2^20, 2^20-1] pages (±4GB).
		if v > 0xfffff || v < (0 - 0x100000) {
			return buf.Concat("ADRP page offset out of range for ", symName)
		}
		patch32Field(data, byteLoc, 3 << 29, v & 3, 29) // immlo (bits 30:29)
		patch32Field(data, byteLoc, 0x7ffff << 5, (v >> 2) & 0x7ffff, 5) // immhi (bits 23:5)
		return ""
	}
	if kind == R_AARCH64_ADR_PREL_LO21 {
		var v int = cast(int, s) + addend - cast(int, p)
		// ADR's imm21 is a signed byte displacement: [-2^20, 2^20-1] (±1MB).
		if v > 0xfffff || v < (0 - 0x100000) {
			return buf.Concat("ADR offset out of range for ", symName)
		}
		patch32Field(data, byteLoc, 3 << 29, v & 3, 29)
		patch32Field(data, byteLoc, 0x7ffff << 5, (v >> 2) & 0x7ffff, 5)
		return ""
	}
	if kind == R_AARCH64_ADD_ABS_LO12_NC {
		patch32Field(data, byteLoc, 0xfff << 10, (cast(int, s) + addend) & 0xfff, 10)
		return ""
	}
	if kind == R_AARCH64_LDST64_ABS_LO12_NC {
		patch32Field(data, byteLoc, 0xfff << 10, ((cast(int, s) + addend) & 0xfff) >> 3, 10)
		return ""
	}
	if kind == R_AARCH64_CONDBR19 {
		var v int = cast(int, s) + addend - cast(int, p)
		if (v & 3) != 0 { return buf.Concat("misaligned branch target for ", symName) }
		// imm19 is a signed ×4-scaled field: [-2^20, 2^20-4] (±1MB).
		if v > 0xffffc || v < (0 - 0x100000) { return buf.Concat("branch out of range for ", symName) }
		patch32Field(data, byteLoc, 0x7ffff << 5, (v >> 2) & 0x7ffff, 5)
		return ""
	}
	if kind == R_AARCH64_TSTBR14 {
		var v int = cast(int, s) + addend - cast(int, p)
		if (v & 3) != 0 { return buf.Concat("misaligned branch target for ", symName) }
		// imm14 is a signed ×4-scaled field: [-2^15, 2^15-4] (±32KB).
		if v > 0x7ffc || v < (0 - 0x8000) { return buf.Concat("branch out of range for ", symName) }
		patch32Field(data, byteLoc, 0x3fff << 5, (v >> 2) & 0x3fff, 5)
		return ""
	}
	if kind == R_AARCH64_LD64_GOT_LO12_NC {
		// Verify the instruction is a 64-bit unsigned-offset LDR (top 10 bits).
		// bnlint:allow managed-to-raw-assign - live local, read-only borrow
		var r *[]readonly uint8 = data
		var insn int = u32(r, byteLoc)
		if (insn & 0xffc00000) != 0xf9400000 {
			return buf.Concat("unsupported GOT-load form (only 64-bit ldr) in ", objPath)
		}
		if gotImp {
			// Dynamic data import: KEEP the LDR, pointing it at the GOT slot (s) whose
			// low 12 bits scale by 8 into the unsigned imm12 — so it loads the slot that
			// ld.so fills via GLOB_DAT.  (Paired ADR_GOT_PAGE already put the slot's page
			// in the base register: for a GOT import s is the slot's own address.)
			patch32Field(data, byteLoc, 0xfff << 10, ((cast(int, s) + addend) & 0xfff) >> 3, 10)
			return ""
		}
		// Defined symbol (static link): relax the GOT load to a direct address ADD
		// `ldr xN,[xM,#got_lo12]` -> `add xN,xM,#:lo12:sym`, rebuilding it as ADD with
		// the same Rd/Rn (identical bit positions) and the low 12 bits of S+A.
		var rd int = insn & 0x1f
		var rn int = (insn >> 5) & 0x1f
		var imm12 int = (cast(int, s) + addend) & 0xfff
		writeLE(data, byteLoc, 0x91000000 | (imm12 << 10) | (rn << 5) | rd, 4)
		return ""
	}
	if kind == R_AARCH64_PREL32 {
		var v int = cast(int, s) + addend - cast(int, p)
		// PREL32 is a stored data word; its ABI overflow class is [-2^31, 2^32) (the
		// signed OR unsigned 32-bit range), so only a displacement that does not fit
		// 32 bits at all is an error.
		if v > 0xffffffff || v < (0 - 0x80000000) {
			return buf.Concat("PREL32 out of range for ", symName)
		}
		writeLE(data, byteLoc, v, 4)
		return ""
	}
	return buf.Concat("unsupported relocation in ", objPath)
}
