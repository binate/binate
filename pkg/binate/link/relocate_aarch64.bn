package "pkg/binate/link"

import "pkg/binate/buf"

// patch32Field reads the 32-bit little-endian instruction at loc, replaces the
// bits selected by mask with value (shifted into place and confined to mask), and
// writes it back — leaving the opcode bits intact.  Distinct fields of one
// instruction (e.g. an ADRP's immlo and immhi) are patched by successive calls.
func patch32Field(data @[]uint8, loc int, mask int, value int, shift int) {
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	var insn int64 = u32(r, loc)
	insn = (insn & (0xffffffff ^ cast(int64, mask))) |
			((cast(int64, value) << cast(uint, shift)) & cast(int64, mask))
	writeU32(data, loc, insn)
}

// ldstLo12AccessBytes returns the access size in bytes that an
// R_AARCH64_LDST*_ABS_LO12_NC kind scales its imm12 by (1, 2, 4, 8 or 16), or 0 when
// kind is not one of them.
func ldstLo12AccessBytes(kind int) int {
	if kind == R_AARCH64_LDST8_ABS_LO12_NC { return 1 }
	if kind == R_AARCH64_LDST16_ABS_LO12_NC { return 2 }
	if kind == R_AARCH64_LDST32_ABS_LO12_NC { return 4 }
	if kind == R_AARCH64_LDST64_ABS_LO12_NC { return 8 }
	if kind == R_AARCH64_LDST128_ABS_LO12_NC { return 16 }
	return 0
}

// patchAArch64 applies an AArch64 relocation at byteLoc.  ABS64 is a 64-bit data
// word; ABS32 and PREL32 are 32-bit data words; the rest patch a bit-field of the 32-bit
// instruction.  Branch displacements are S + A - P in bytes (checked 4-aligned and
// in range); ADRP is the page delta (page(S+A) - page(P)) >> 12 split across
// immlo/immhi; ADD/load-store lo12 are the low 12 bits of S + A (a load/store's scaled
// by its access size, which those bits must be aligned to); the MOVW group fills a
// move-wide's imm16 (patchAArch64Movw).  A GOT relocation reaching a slot (gotImp: a
// dynamic import's, or a linker-made one, got.bn) addresses the slot; one that does not is
// relaxed — ADR_GOT_PAGE patches like an ordinary ADRP to the symbol, and LD64_GOT_LO12_NC
// rewrites the GOT-load LDR into a direct address ADD (got_patch.bn, which also has
// GOT_LD_PREL19; LD64_GOTPAGE_LO15 is Relocate's, needing the GOT's start).  Every
// PC-relative field (branches, ADR, ADRP) is range-checked so an over-long displacement is
// rejected loudly rather than truncated into a wrong target — but for ADR_PREL_PG_HI21_NC,
// whose definition is the page delta's low 21 bits, unchecked.  Returns "" or an error
// (unsupported kind, an unexpected instruction at a GOT-load site, out-of-range file
// offset, or a misaligned or out-of-range displacement).
func patchAArch64(data @[]uint8, byteLoc int, kind int, addend int, s uint64, p uint64,
		symName *[]readonly char, objPath *[]readonly char, gotImp bool) @[]readonly char {
	var width int = 4
	if kind == R_AARCH64_ABS64 { width = 8 }
	if byteLoc < 0 || byteLoc + width > len(data) {
		return buf.Concat("relocation offset out of range in ", objPath)
	}

	if kind == R_AARCH64_ABS64 {
		writeU64(data, byteLoc, cast(uint64, cast(int64, s) + cast(int64, addend)))
		return ""
	}
	if kind == R_AARCH64_CALL26 || kind == R_AARCH64_JUMP26 {
		var v int64 = cast(int64, s) + cast(int64, addend) - cast(int64, p)
		if (v & 3) != 0 { return buf.Concat("misaligned branch target for ", symName) }
		if v > 0x7ffffff || v < (0 - 0x8000000) { return buf.Concat("branch out of range for ", symName) }
		patch32Field(data, byteLoc, 0x3ffffff, cast(int, v >> 2), 0)
		return ""
	}
	if kind == R_AARCH64_ADR_PREL_PG_HI21 || kind == R_AARCH64_ADR_GOT_PAGE ||
			kind == R_AARCH64_ADR_PREL_PG_HI21_NC {
		// ADR_GOT_PAGE is the same page delta: to the slot's page when s is a GOT slot,
		// else (relaxed) to the symbol's own page, paired with the LD64_GOT -> ADD
		// relaxation.
		var pageMask int64 = 0 - 0x1000 // ~0xFFF: page(x) = x & pageMask
		var v int64 = (((cast(int64, s) + cast(int64, addend)) & pageMask) -
				(cast(int64, p) & pageMask)) >> 12
		// v is a page count in a signed 21-bit field: [-2^20, 2^20-1] pages (±4GB); the
		// _NC form keeps its low 21 bits unchecked.
		if kind != R_AARCH64_ADR_PREL_PG_HI21_NC && (v > 0xfffff || v < (0 - 0x100000)) {
			return buf.Concat("ADRP page offset out of range for ", symName)
		}
		patch32Field(data, byteLoc, 3 << 29, cast(int, v & 3), 29) // immlo (bits 30:29)
		patch32Field(data, byteLoc, 0x7ffff << 5, cast(int, (v >> 2) & 0x7ffff), 5) // immhi (bits 23:5)
		return ""
	}
	if kind == R_AARCH64_ADR_PREL_LO21 {
		var v int64 = cast(int64, s) + cast(int64, addend) - cast(int64, p)
		// ADR's imm21 is a signed byte displacement: [-2^20, 2^20-1] (±1MB).
		if v > 0xfffff || v < (0 - 0x100000) {
			return buf.Concat("ADR offset out of range for ", symName)
		}
		patch32Field(data, byteLoc, 3 << 29, cast(int, v & 3), 29)
		patch32Field(data, byteLoc, 0x7ffff << 5, cast(int, (v >> 2) & 0x7ffff), 5)
		return ""
	}
	if kind == R_AARCH64_ADD_ABS_LO12_NC {
		patch32Field(data, byteLoc, 0xfff << 10,
				cast(int, (cast(int64, s) + cast(int64, addend)) & 0xfff), 10)
		return ""
	}
	if movwRelocChunk(kind) >= 0 {
		return patchAArch64Movw(data, byteLoc, kind, addend, s, p, symName)
	}
	var ldstBytes int = ldstLo12AccessBytes(kind)
	if ldstBytes > 0 {
		// The imm12 holds the low 12 bits of S+A in units of the access size, so those
		// bits must be a multiple of it: a misaligned target has no encoding, and
		// dropping the low bits would silently address the wrong bytes.
		var lo12 int = cast(int, (cast(int64, s) + cast(int64, addend)) & 0xfff)
		if lo12 % ldstBytes != 0 {
			return buf.Concat("misaligned load/store lo12 target for ", symName)
		}
		patch32Field(data, byteLoc, 0xfff << 10, lo12 / ldstBytes, 10)
		return ""
	}
	if kind == R_AARCH64_CONDBR19 {
		var v int64 = cast(int64, s) + cast(int64, addend) - cast(int64, p)
		if (v & 3) != 0 { return buf.Concat("misaligned branch target for ", symName) }
		// imm19 is a signed ×4-scaled field: [-2^20, 2^20-4] (±1MB).
		if v > 0xffffc || v < (0 - 0x100000) { return buf.Concat("branch out of range for ", symName) }
		patch32Field(data, byteLoc, 0x7ffff << 5, cast(int, (v >> 2) & 0x7ffff), 5)
		return ""
	}
	if kind == R_AARCH64_LD_PREL_LO19 {
		var v int64 = cast(int64, s) + cast(int64, addend) - cast(int64, p)
		if (v & 3) != 0 { return buf.Concat("misaligned literal-load target for ", symName) }
		// imm19 is a signed ×4-scaled field: [-2^20, 2^20-4] (±1MB).
		if v > 0xffffc || v < (0 - 0x100000) {
			return buf.Concat("literal load out of range for ", symName)
		}
		patch32Field(data, byteLoc, 0x7ffff << 5, cast(int, (v >> 2) & 0x7ffff), 5)
		return ""
	}
	if kind == R_AARCH64_TSTBR14 {
		var v int64 = cast(int64, s) + cast(int64, addend) - cast(int64, p)
		if (v & 3) != 0 { return buf.Concat("misaligned branch target for ", symName) }
		// imm14 is a signed ×4-scaled field: [-2^15, 2^15-4] (±32KB).
		if v > 0x7ffc || v < (0 - 0x8000) { return buf.Concat("branch out of range for ", symName) }
		patch32Field(data, byteLoc, 0x3fff << 5, cast(int, (v >> 2) & 0x3fff), 5)
		return ""
	}
	if kind == R_AARCH64_LD64_GOT_LO12_NC {
		return patchLd64GotLo12(data, byteLoc, addend, s, symName, objPath, gotImp)
	}
	if kind == R_AARCH64_GOT_LD_PREL19 {
		return patchGotLdPrel19(data, byteLoc, addend, s, p, symName, gotImp)
	}
	if kind == R_AARCH64_ABS32 {
		var v int64 = cast(int64, s) + cast(int64, addend)
		// ABS32 is a stored data word; its ABI overflow class is [-2^31, 2^32).
		if v > 0xffffffff || v < (0 - 0x80000000) {
			return buf.Concat("ABS32 out of range for ", symName)
		}
		writeU32(data, byteLoc, v)
		return ""
	}
	if kind == R_AARCH64_PREL32 {
		var v int64 = cast(int64, s) + cast(int64, addend) - cast(int64, p)
		// PREL32 is a stored data word; its ABI overflow class is [-2^31, 2^32) (the
		// signed OR unsigned 32-bit range), so only a displacement that does not fit
		// 32 bits at all is an error.
		if v > 0xffffffff || v < (0 - 0x80000000) {
			return buf.Concat("PREL32 out of range for ", symName)
		}
		writeU32(data, byteLoc, v)
		return ""
	}
	return buf.Concat("unsupported relocation in ", objPath)
}
