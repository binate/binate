package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/elf"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// (fail is in parse_elf_test.bn; u32/charsEqual in bytes.bn — same package.)

// End-to-end AArch64: object A does `bl target`, object B defines target.  After
// linking, the patched BL's imm26 must make the branch (blAddr + imm26*4) land on
// target's address (the CPU's PC-relative rule for BL).  The ELF writer emits
// R_AARCH64_CALL26 for a BL (JUMP26 for a B); the imm26 patch math is identical.
func TestRelocateAArch64Branch() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("caller")
	a.SetGlobal("caller")
	a.SetGlobal("target") // undefined external: a BL -> R_AARCH64_CALL26 (FIX_BRANCH26)
	aarch64.Bl(a, "target")
	aarch64.Ret(a)
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error (A)") }
	if !elf.WriteAArch64(a, buf.Concat(dir, "/link_aa64_a.o")) { return fail("write A failed") }

	var b @asm.Assembler = asm.New(8)
	b.SetSection("text", -1)
	b.DefineLabel("target")
	b.SetGlobal("target")
	aarch64.Ret(b)
	aarch64.ResolveFixups(b)
	b.Finalize()
	if b.HasError { return fail("assembler error (B)") }
	if !elf.WriteAArch64(b, buf.Concat(dir, "/link_aa64_b.o")) { return fail("write B failed") }

	objA, ea := ReadObject(buf.Concat(dir, "/link_aa64_a.o"))
	if len(ea) != 0 { return fail("read A failed") }
	objB, eb := ReadObject(buf.Concat(dir, "/link_aa64_b.o"))
	if len(eb) != 0 { return fail("read B failed") }
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = objA
	objs[1] = objB
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return fail("resolve failed") }
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) != 0 { return fail("relocate failed") }

	if len(objA.Relocs) != 1 { return fail("expected one relocation in object A") }
	var rel InputReloc = objA.Relocs[0]
	if rel.Kind != R_AARCH64_CALL26 { return fail("expected an R_AARCH64_CALL26 relocation for a BL") }
	var outIdx int = objA.Sections[rel.SecIndex].OutIndex
	var secOff uint = objA.Sections[rel.SecIndex].OutOffset
	var blAddr uint64 = lr.Sections[outIdx].Addr + cast(uint64, secOff) + cast(uint64, rel.Offset)

	var bTextIdx int = objB.Sections[0].OutIndex
	var targetAddr uint64 = lr.Sections[bTextIdx].Addr + cast(uint64, objB.Sections[0].OutOffset)

	var data @[]uint8 = lr.Sections[outIdx].Data
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	var insn int = cast(int, u32(rd, cast(int, secOff + rel.Offset)))
	var imm26 int = insn & 0x3ffffff
	if imm26 >= 0x2000000 { imm26 = imm26 - 0x4000000 } // sign-extend the 26-bit field
	var landing uint64 = cast(uint64, cast(int64, blAddr) + cast(int64, imm26 * 4))
	if landing != targetAddr { return fail("aa64 BL would not land on target") }
	return ""
}

// End-to-end AArch64 R_AARCH64_ABS64: an 8-byte absolute pointer to a defined
// symbol is patched with the symbol's absolute address.
func TestRelocateAArch64Abs64() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("data", -1)
	a.DefineLabel("ptr")
	a.SetGlobal("ptr")
	a.EmitAddr("sym") // 8-byte absolute reference -> R_AARCH64_ABS64
	a.SetSection("text", -1)
	a.DefineLabel("sym")
	a.SetGlobal("sym")
	aarch64.Ret(a)
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	if !elf.WriteAArch64(a, buf.Concat(dir, "/link_aa64_abs.o")) { return fail("write failed") }

	obj, e := ReadObject(buf.Concat(dir, "/link_aa64_abs.o"))
	if len(e) != 0 { return fail("read failed") }
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return fail("resolve failed") }
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) != 0 { return fail("relocate failed") }

	if len(obj.Relocs) != 1 { return fail("expected one relocation") }
	var rel InputReloc = obj.Relocs[0]
	if rel.Kind != R_AARCH64_ABS64 { return fail("expected an R_AARCH64_ABS64 relocation") }
	var outIdx int = obj.Sections[rel.SecIndex].OutIndex
	var byteLoc int = cast(int, obj.Sections[rel.SecIndex].OutOffset + rel.Offset)
	var data @[]uint8 = lr.Sections[outIdx].Data
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	var stored int64 = u64(rd, byteLoc)
	// sym is at .text offset 0 -> the base (text is the first output section).
	if stored != 0x400000 { return fail("aa64 ABS64 stored the wrong address") }
	return ""
}

// rangeCase asserts patchAArch64(kind) accepts the field's max (hi) and min (lo)
// signed displacements but rejects hi+step and lo-step, where step is the field's
// scale (4 for the ×4-scaled branch fields, 1 for ADR's byte field).  s/p are byte
// addresses, so a displacement d is produced with s=d, p=0 (positive) or s=0, p=-d.
func rangeCase(word @[]uint8, kind int, hi int, lo int) bool {
	var step int = 4
	if kind == R_AARCH64_ADR_PREL_LO21 { step = 1 }
	if len(patchAArch64(word, 0, kind, 0, cast(uint64, hi), cast(uint64, 0), "s", "o", false)) != 0 {
		return false
	}
	if len(patchAArch64(word, 0, kind, 0, cast(uint64, 0), cast(uint64, 0 - lo), "s", "o", false)) !=
			0 {
		return false
	}
	if len(patchAArch64(word, 0, kind, 0, cast(uint64, hi + step), cast(uint64, 0), "s", "o",
			false)) == 0 {
		return false
	}
	if len(
			patchAArch64(word, 0, kind, 0, cast(uint64, 0), cast(uint64, (0 - lo) + step), "s", "o",
					false)) == 0 {
		return false
	}
	return true
}

// The PC-relative AArch64 relocs whose fields can overflow must reject an
// out-of-range displacement rather than silently truncate it (which would branch
// or address the wrong place at runtime).  Each field's true signed bounds are
// exercised at the boundary: max and min patch; one step past either is rejected.
func TestRelocateAArch64RangeChecks() testing.TestResult {
	var word @[]uint8 = make_slice(uint8, 8)
	if !rangeCase(word, R_AARCH64_TSTBR14, 0x7ffc, 0 - 0x8000) { return fail("TSTBR14 range check") }
	if !rangeCase(word, R_AARCH64_CONDBR19, 0xffffc, 0 - 0x100000) {
		return fail("CONDBR19 range check")
	}
	if !rangeCase(word, R_AARCH64_ADR_PREL_LO21, 0xfffff, 0 - 0x100000) {
		return fail("ADR range check")
	}
	// ADRP's field is a signed 21-bit page count (±4GB); step is one page (0x1000).
	// An in-range span of 0xfffff pages patches; a >4GB span (0x100000 pages) errors.
	if len(
			patchAArch64(word, 0, R_AARCH64_ADR_PREL_PG_HI21, 0, cast(uint64, 0xfffff000), cast(uint64, 0),
					"s", "o", false)) != 0 {
		return fail("in-range ADRP should patch")
	}
	if len(
			patchAArch64(word, 0, R_AARCH64_ADR_PREL_PG_HI21, 0, cast(uint64, 0x100000000), cast(uint64, 0),
					"s", "o", false)) == 0 {
		return fail("out-of-range ADRP should be rejected")
	}
	return ""
}

// R_AARCH64_PREL32 stores a 32-bit PC-relative displacement S + A - P.
func TestPatchAArch64Prel32() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 4)
	var e @[]readonly char = patchAArch64(d, 0, R_AARCH64_PREL32, 0, cast(uint64, 0x1008),
			cast(uint64, 0x1000), "sym", "obj", false)
	if len(e) != 0 { return fail("PREL32 should succeed") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = d
	if u32(r, 0) != 8 { return fail("PREL32 should store S + A - P = 8") }
	return ""
}

// A backward (negative) PREL32 stores the two's-complement low 32 bits, and the
// widened upper bound (ABI [-2^31, 2^32)) is not wrongly tripped.
func TestPatchAArch64Prel32Negative() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 4)
	// s=0x1000, p=0x1010 -> v = -0x10.
	var e @[]readonly char = patchAArch64(d, 0, R_AARCH64_PREL32, 0, cast(uint64, 0x1000),
			cast(uint64, 0x1010), "sym", "obj", false)
	if len(e) != 0 { return fail("a negative PREL32 should succeed") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = d
	if (cast(int64, u32(r, 0)) & 0xffffffff) != 0xfffffff0 {
		return fail("PREL32 should store two's-complement -0x10")
	}
	return ""
}
