package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/elf"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// A global or weak absolute symbol (an assembler constant made global or weak, `.global K;
// K = 0x1234`) is a definition: a reference in another object binds to its value — a weak
// one's too, not 0 — and it takes part in strong-over-weak resolution like any definition;
// a local one defines nothing outside its own object.  (fail is in parse_elf_test.bn,
// testTmpDir in link_test.bn, fieldWord in relocate_arm32_test.bn.)

// absObj writes an arm32 object to dir/name defining K as an absolute symbol of value
// 0x1234 with binding bind (BIND_GLOBAL, BIND_WEAK, or 0 for a local one), returning the
// path or "" on failure.
func absObj(dir *[]readonly char, name *[]readonly char, bind int) @[]char {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	arm32.Nop(a)
	if bind == BIND_GLOBAL { a.SetGlobal("K") }
	if bind == BIND_WEAK { a.SetWeak("K") }
	a.DefineAbsolute("K", 0x1234)
	a.Finalize()
	if a.HasError { return "" }
	var path @[]char = buf.Concat(buf.Concat(dir, "/"), name)
	if !elf.WriteARM32(a, path, false) { return "" }
	return path
}

// absRefObj writes an arm32 object to dir/name with a data word referring to K, defining K
// as a function with binding bind (BIND_GLOBAL or BIND_WEAK), or declaring it an undefined
// global when bind is -1, returning the path or "" on failure.
func absRefObj(dir *[]readonly char, name *[]readonly char, bind int) @[]char {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	arm32.Nop(a)
	if bind == BIND_GLOBAL || bind < 0 { a.SetGlobal("K") }
	if bind == BIND_WEAK { a.SetWeak("K") }
	if bind >= 0 { a.DefineLabel("K") }
	arm32.Bx(a, arm32.COND_AL, arm32.LR)
	a.SetSection("data", -1)
	a.AddFixup("K", 0, 0, 4)
	a.Fill(4, cast(uint8, 0))
	if !arm32.ResolveFixups(a) { return "" }
	a.Finalize()
	if a.HasError { return "" }
	var path @[]char = buf.Concat(buf.Concat(dir, "/"), name)
	if !elf.WriteARM32(a, path, false) { return "" }
	return path
}

// linkAbsPair builds absObj(defBind) and absRefObj(refBind) and links them, returning the
// objects, table and layout, or a non-empty error.
func linkAbsPair(defBind int,
		refBind int) (@[]@InputObject, @SymbolTable, @LayoutResult, @[]readonly char) {
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	var none @SymbolTable
	var noLr @LayoutResult
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return objs, none, noLr, "cannot create a temporary directory" }
	defer os.RemoveAll(dir)
	var pa @[]char = absObj(dir, "abs_def.o", defBind)
	var pb @[]char = absRefObj(dir, "abs_ref.o", refBind)
	if len(pa) == 0 || len(pb) == 0 { return objs, none, noLr, "cannot build the objects" }
	oa, ea := ReadObject(pa)
	ob, eb := ReadObject(pb)
	if len(ea) != 0 || len(eb) != 0 { return objs, none, noLr, "cannot read the objects" }
	objs[0] = oa
	objs[1] = ob
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return objs, none, noLr, rerr }
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x8000))
	var lerr @[]readonly char = Relocate(t, lr)
	if len(lerr) != 0 { return objs, t, lr, lerr }
	return objs, t, lr, ""
}

// kWordIs reports whether obj's data word referring to K holds want.
func kWordIs(obj @InputObject, lr @LayoutResult, want uint64) bool {
	word, _, ok := fieldWord(obj, lr, "K", R_ARM_ABS32)
	return ok && cast(uint64, word) == want
}

// A global absolute K satisfies a reference in another object, which gets its value.
func TestAbsoluteGlobalDefinesReference() testing.TestResult {
	objs, _, lr, err := linkAbsPair(BIND_GLOBAL, -1)
	if len(err) != 0 { return fail(buf.Concat("link failed: ", err)) }
	if !kWordIs(objs[1], lr, 0x1234) { return fail("the reference does not get K's value") }
	return ""
}

// A weak absolute K with no other definition binds its references to its value, not 0.
func TestAbsoluteWeakDefinesReference() testing.TestResult {
	objs, _, lr, err := linkAbsPair(BIND_WEAK, -1)
	if len(err) != 0 { return fail(buf.Concat("link failed: ", err)) }
	if !kWordIs(objs[1], lr, 0x1234) { return fail("the reference does not get weak K's value") }
	return ""
}

// A strong function K overrides a weak absolute K: the reference reaches the function.
func TestStrongDefinitionOverridesWeakAbsolute() testing.TestResult {
	objs, t, lr, err := linkAbsPair(BIND_WEAK, BIND_GLOBAL)
	if len(err) != 0 { return fail(buf.Concat("link failed: ", err)) }
	oo, ss, found := t.Lookup("K")
	if !found || oo != 1 { return fail("the strong K is not the chosen definition") }
	addr, ok := definedAddr(t, lr, oo, ss)
	if !ok || addr == 0x1234 { return fail("cannot place the strong K") }
	if !kWordIs(objs[1], lr, addr) { return fail("the reference does not reach the strong K") }
	return ""
}

// A strong absolute K overrides a weak function K, even for the weak one's own object.
func TestStrongAbsoluteOverridesWeakDefinition() testing.TestResult {
	objs, t, lr, err := linkAbsPair(BIND_GLOBAL, BIND_WEAK)
	if len(err) != 0 { return fail(buf.Concat("link failed: ", err)) }
	oo, _, found := t.Lookup("K")
	if !found || oo != 0 { return fail("the absolute K is not the chosen definition") }
	if !kWordIs(objs[1], lr, 0x1234) { return fail("the reference stays on the weak K") }
	return ""
}

// A strong absolute K and a strong function K are a duplicate definition.
func TestStrongAbsoluteCollides() testing.TestResult {
	_, _, _, err := linkAbsPair(BIND_GLOBAL, BIND_GLOBAL)
	var want *[]readonly char = "duplicate symbol: K "
	if len(err) < len(want) || !charsEqual(err[0:len(want)], want) {
		return fail("two strong K's not a duplicate")
	}
	return ""
}

// A local absolute K defines nothing for another object: its reference is undefined.
func TestLocalAbsoluteDefinesNothingOutside() testing.TestResult {
	_, _, _, err := linkAbsPair(0, -1)
	if !charsEqual(err, "undefined symbol: K") { return fail(buf.Concat("not undefined: ", err)) }
	return ""
}

// absRelocObj builds an x86-64 object whose .text holds an R_X86_64_64 against its symbol
// K: an absolute symbol of value 0x1234 with binding bind, or (bind -1) a global K defined
// at the start of .text.
func absRelocObj(path *[]readonly char, bind int) @InputObject {
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, make_slice(uint8, 8), cast(uint, 8),
			1)
	var syms @[]InputSymbol = make_slice(InputSymbol, 1)
	syms[0] = mkSym("K", 0, BIND_GLOBAL)
	if bind >= 0 {
		syms[0] = mkSym("K", -1, bind)
		syms[0].Abs = true
		syms[0].AbsValue = 0x1234
	}
	var relocs @[]InputReloc = make_slice(InputReloc, 1)
	relocs[0] = mkReloc(0, cast(uint, 0), 0, R_X86_64_64, 0)
	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr(path)
	obj.Machine = EM_X86_64
	obj.Sections = secs
	obj.Symbols = syms
	obj.Relocs = relocs
	return obj
}

// A relocation against an object's own local absolute K takes K's value — not another
// object's global K, nor 0.
func TestLocalAbsoluteRelocation() testing.TestResult {
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = absRelocObj("local.o", 0)
	objs[1] = absRelocObj("global.o", -1)
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return fail(buf.Concat("resolve failed: ", rerr)) }
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) != 0 { return fail("relocate failed") }
	word, _, ok := fieldWord(objs[0], lr, "K", R_X86_64_64)
	if !ok || word != 0x1234 { return fail("the local K's reference does not get its value") }
	return ""
}
