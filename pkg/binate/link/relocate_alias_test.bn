package "pkg/binate/link"

import "pkg/binate/asm/assemble"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// A weak alias assembled from text binds as a weak definition: the arm32 default-handler
// idiom — `.weak irq_handler` / `irq_handler = default_handler` / `bl irq_handler` — reaches
// default_handler when nothing else defines irq_handler, and another object's strong
// irq_handler when one does.  (fail is in parse_elf_test.bn, testTmpDir in link_test.bn,
// writeBytes in parse_ar_test.bn, fieldWord / branchTarget in relocate_arm32_test.bn,
// linkWeakPair in relocate_weak_test.bn.)

// assembleArm32 assembles src as an arm32 ELF object at dir/name.o, returning its path or
// "" on failure.
func assembleArm32(dir *[]readonly char, name *[]readonly char, src *[]readonly char) @[]char {
	var base @[]char = buf.Concat(buf.Concat(dir, "/"), name)
	var sPath @[]char = buf.Concat(base, ".s")
	if !writeBytes(sPath, buf.CopyStr(src)) { return "" }
	var oPath @[]char = buf.Concat(base, ".o")
	ok, _ := assemble.AssembleFile(sPath, oPath, "arm32", "linux")
	if !ok { return "" }
	return oPath
}

// irqHandlerTarget returns where obj's `bl irq_handler` lands, or false if obj has none.
func irqHandlerTarget(obj @InputObject, lr @LayoutResult) (uint64, bool) {
	bl, blAddr, ok := fieldWord(obj, lr, "irq_handler", R_ARM_CALL)
	if !ok { return cast(uint64, 0), false }
	return branchTarget(bl, blAddr), true
}

// irq_a.o makes irq_handler a weak alias of its default_handler and calls it; irq_b.o
// defines a strong irq_handler.  Linked alone, irq_a.o's call reaches default_handler;
// linked with irq_b.o, it reaches irq_b.o's irq_handler.
func TestWeakAliasDefaultHandler() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var pa @[]char = assembleArm32(dir, "irq_a",
			".section text\n.weak irq_handler\nirq_handler = default_handler\nnop\n"
					"default_handler:\nbx lr\ncaller:\nbl irq_handler\n")
	var pb @[]char = assembleArm32(dir, "irq_b",
			".section text\nnop\nnop\n.global irq_handler\nirq_handler:\nbx lr\n")
	if len(pa) == 0 || len(pb) == 0 { return fail("cannot assemble the objects") }

	oa, ea := ReadObject(pa)
	if len(ea) != 0 { return fail("cannot read irq_a.o") }
	var alone @[]@InputObject = make_slice(@InputObject, 1)
	alone[0] = oa
	t, rerr := Resolve(alone)
	if len(rerr) != 0 { return fail(buf.Concat("resolve failed: ", rerr)) }
	var lr @LayoutResult = Layout(alone, cast(uint64, 0x8000))
	if len(Relocate(t, lr)) != 0 { return fail("relocate failed") }
	var defIdx int = -1
	for i := 0; i < len(oa.Symbols); i++ {
		if charsEqual(oa.Symbols[i].Name, "default_handler") { defIdx = i }
	}
	if defIdx < 0 { return fail("default_handler not listed") }
	defAddr, dok := definedAddr(t, lr, 0, defIdx)
	at, aok := irqHandlerTarget(oa, lr)
	if !dok || !aok || at != defAddr { return fail("alone, the call does not reach default_handler") }

	objs, t2, lr2, ok := linkWeakPair(pa, pb)
	if !ok { return fail("the pair does not link") }
	oo, ss, found := t2.Lookup("irq_handler")
	if !found || oo != 1 { return fail("the strong irq_handler is not the chosen definition") }
	strong, sok := definedAddr(t2, lr2, oo, ss)
	at2, aok2 := irqHandlerTarget(objs[0], lr2)
	if !sok || !aok2 || at2 != strong { return fail("the call does not reach the strong irq_handler") }
	return ""
}
