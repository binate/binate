package "pkg/binate/link"

import "pkg/binate/buf"

// patchArm32 applies an arm32 relocation at byteLoc.  arm32 objects are ELF32/REL:
// the relocation carries no addend word, so the addend A is read from the patched
// field itself (a branch's imm24 folds in the -8 pipeline bias; an ABS32 word holds
// a whole 32-bit addend; MOVW/MOVT immediates are 0).  ABS32 is a 32-bit data word
// (S + A); PREL31 a 31-bit PC-relative data word (S + A - P, bit 31 preserved);
// CALL/JUMP24 patch a BL/B's imm24 with the branch offset (S + A - P) >> 2
// (checked 4-aligned and in signed 26-bit range — no Thumb, so CALL and JUMP24 are
// identical); MOVW_ABS_NC/MOVT_ABS patch a MOV's split imm4:imm12 with the low /
// high 16 bits of S + A; LDR_PC_G0 / LDRS_PC_G0 patch a PC-relative load / store's U bit
// and 12-bit (or split 8-bit) offset with S + A - P, A being the signed offset in the
// field.  NONE patches nothing (a link-order marker).  The `addend`
// argument (an explicit RELA addend) is added on top of the field's implicit one;
// it is 0 for the REL objects arm32 uses.  Returns "" or an error (unsupported
// kind, out-of-range file offset, or a misaligned or out-of-range displacement).
func patchArm32(data @[]uint8, byteLoc int, kind int, addend int, s uint64, p uint64,
		symName *[]readonly char, objPath *[]readonly char) @[]readonly char {
	if kind == R_ARM_NONE { return "" } // link-order/marker entry: patches nothing

	if byteLoc < 0 || byteLoc + 4 > len(data) {
		return buf.Concat("relocation offset out of range in ", objPath)
	}
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	var insn int64 = u32(r, byteLoc)

	if kind == R_ARM_ABS32 {
		// A is the whole 32-bit word already in the field (REL implicit addend).
		writeU32(data, byteLoc, cast(int64, s) + insn + cast(int64, addend))
		return ""
	}
	if kind == R_ARM_CALL || kind == R_ARM_JUMP24 {
		// imm24 (bits 23:0) of a BL/B; A = SignExtend(imm24) << 2 (bakes the -8 bias).
		var imm24 int64 = insn & 0xffffff
		if (imm24 & 0x800000) != 0 { imm24 = imm24 - 0x1000000 } // sign-extend 24-bit
		var value int64 = cast(int64, s) + (imm24 << cast(uint, 2)) + cast(int64, addend) - cast(int64, p)
		if (value & 3) != 0 { return buf.Concat("misaligned branch target for ", symName) }
		if value > 0x1ffffff || value < (0 - 0x2000000) {
			// signed 26-bit (±32 MB)
			return buf.Concat("branch out of range for ", symName)
		}
		writeU32(data, byteLoc, (insn & cast(int64, 0xff000000)) | ((value >> cast(uint, 2)) & 0xffffff))
		return ""
	}
	if kind == R_ARM_MOVW_ABS_NC || kind == R_ARM_MOVT_ABS {
		// imm16 = imm4:imm12 = bits[19:16]:bits[11:0]; A = SignExtend(imm16) (0 in
		// practice).  MOVW takes bits[15:0] of S+A, MOVT bits[31:16].
		var imm16 int64 = ((insn >> cast(uint, 4)) & 0xf000) | (insn & 0xfff)
		if (imm16 & 0x8000) != 0 { imm16 = imm16 - 0x10000 } // sign-extend 16-bit
		var full int64 = cast(int64, s) + imm16 + cast(int64, addend)
		var residual int64 = full & 0xffff
		if kind == R_ARM_MOVT_ABS { residual = (full >> cast(uint, 16)) & 0xffff }
		var enc int64 = ((residual & 0xf000) << cast(uint, 4)) | (residual & 0xfff)
		writeU32(data, byteLoc, (insn & cast(int64, 0xfff0f000)) | enc)
		return ""
	}
	if kind == R_ARM_LDR_PC_G0 || kind == R_ARM_LDRS_PC_G0 {
		return patchArm32PcLoad(data, byteLoc, kind, insn, addend, s, p, symName)
	}
	if kind == R_ARM_PREL31 {
		// 31-bit PC-relative data word (bit 31 is a flag, preserved); A =
		// SignExtend(bits[30:0]); result S + A - P written into bits[30:0].
		var a int64 = insn & 0x7fffffff
		if (a & 0x40000000) != 0 { a = a - 0x80000000 } // sign-extend 31-bit
		var value int64 = cast(int64, s) + a + cast(int64, addend) - cast(int64, p)
		if value > 0x3fffffff || value < (0 - 0x40000000) {
			// signed 31-bit
			return buf.Concat("PREL31 out of range for ", symName)
		}
		writeU32(data, byteLoc, (insn & cast(int64, 0x80000000)) | (value & 0x7fffffff))
		return ""
	}
	return buf.Concat("unsupported relocation in ", objPath)
}

// patchArm32PcLoad applies R_ARM_LDR_PC_G0 (U bit 23, offset bits 11:0: LDR / LDRB / STR /
// STRB) or R_ARM_LDRS_PC_G0 (U bit, offset split into bits 11:8 and 3:0: LDRH / STRH /
// LDRSB / LDRSH) to insn at byteLoc: A is the signed offset in the field, and S + A - P is
// written back as the U bit and magnitude, which must fit 4095 (255 for the split form).
func patchArm32PcLoad(data @[]uint8, byteLoc int, kind int, insn int64, addend int, s uint64,
		p uint64, symName *[]readonly char) @[]readonly char {
	var mag int64 = insn & 0xfff
	var max int64 = 4095
	if kind == R_ARM_LDRS_PC_G0 {
		mag = ((insn >> cast(uint, 4)) & 0xf0) | (insn & 0xf)
		max = 255
	}
	if (insn & 0x800000) == 0 { mag = 0 - mag }
	var value int64 = cast(int64, s) + mag + cast(int64, addend) - cast(int64, p)
	var up int64 = 0x800000
	if value < 0 {
		up = 0
		value = 0 - value
	}
	if value > max { return buf.Concat("PC-relative load / store out of range for ", symName) }
	if kind == R_ARM_LDR_PC_G0 {
		writeU32(data, byteLoc, (insn & cast(int64, 0xff7ff000)) | up | value)
	} else {
		writeU32(data, byteLoc,
				(insn & cast(int64, 0xff7ff0f0)) | up | ((value & 0xf0) << cast(uint, 4)) | (value & 0xf))
	}
	return ""
}
