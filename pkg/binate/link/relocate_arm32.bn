package "pkg/binate/link"

import "pkg/binate/asm/arm32"
import "pkg/binate/buf"

// patchArm32 applies an arm32 relocation at byteLoc.  arm32 objects are ELF32/REL: the
// relocation carries no addend word, so the addend A is read from the patched field
// itself (a branch's imm24 folds in the -8 pipeline bias; an ABS32 word holds a whole
// 32-bit addend; a MOVW / MOVT immediate a sign-extended 16-bit one).  ABS32 is a 32-bit
// data word (S + A), REL32 a PC-relative one (S + A - P), ABS16 / ABS8 a 2- / 1-byte one
// (patchArm32Data); PREL31 a 31-bit PC-relative data word (S + A - P, bit 31 preserved);
// CALL / JUMP24 patch a branch (patchArm32Branch), fn telling whether the target is a function
// and blxOk whether a call may become BLX;
// MOVW_ABS_NC/MOVT_ABS patch a MOV's split imm4:imm12 with the low / high 16 bits of S + A,
// MOVW_PREL_NC / MOVT_PREL with those of S + A - P; LDR_PC_G0 / LDRS_PC_G0 patch a
// PC-relative load / store's U bit and 12-bit (or split 8-bit) offset with S + A - P, A
// being the signed offset in the field; ALU_PC_G0 rewrites an ADR (ADD / SUB from PC) to add
// or subtract S + A - P, A being the field's immediate (negative for SUB).  NONE patches
// nothing (a link-order marker).  The `addend` argument (an explicit RELA addend) is added on
// top of the field's implicit one; it is 0 for the REL objects arm32 uses.  Returns "" or an
// error (unsupported kind, out-of-range file offset, a misaligned or out-of-range displacement,
// or a branch no instruction can make: patchArm32Branch).
func patchArm32(data @[]uint8, byteLoc int, kind int, addend int64, s uint64, p uint64, fn bool,
		blxOk bool, symName *[]readonly char, objPath *[]readonly char) @[]readonly char {
	if kind == R_ARM_NONE { return "" } // link-order/marker entry: patches nothing
	if kind == R_ARM_ABS16 || kind == R_ARM_ABS8 {
		return patchArm32Data(data, byteLoc, kind, addend, s, symName, objPath)
	}

	if byteLoc < 0 || byteLoc + 4 > len(data) {
		return buf.Concat("relocation offset out of range in ", objPath)
	}
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	var insn int64 = u32(r, byteLoc)

	if kind == R_ARM_ABS32 || kind == R_ARM_TARGET1 {
		// A is the whole 32-bit word already in the field (REL implicit addend).
		writeU32(data, byteLoc, cast(int64, s) + insn + addend)
		return ""
	}
	if kind == R_ARM_REL32 {
		// S + A - P, A the word in the field; no overflow check (it wraps, as ABS32).
		writeU32(data, byteLoc, cast(int64, s) + insn + addend - cast(int64, p))
		return ""
	}
	if kind == R_ARM_CALL || kind == R_ARM_JUMP24 {
		return patchArm32Branch(data, byteLoc, kind, insn, addend, s, p, fn, blxOk, symName)
	}
	if kind == R_ARM_MOVW_ABS_NC || kind == R_ARM_MOVT_ABS || kind == R_ARM_MOVW_PREL_NC ||
			kind == R_ARM_MOVT_PREL {
		// imm16 = imm4:imm12 = bits[19:16]:bits[11:0]; A = SignExtend(imm16).  MOVW takes
		// bits[15:0] of S+A (less P for PREL), MOVT bits[31:16].
		var imm16 int64 = ((insn >> cast(uint, 4)) & 0xf000) | (insn & 0xfff)
		if (imm16 & 0x8000) != 0 { imm16 = imm16 - 0x10000 } // sign-extend 16-bit
		var full int64 = cast(int64, s) + imm16 + addend
		if kind == R_ARM_MOVW_PREL_NC || kind == R_ARM_MOVT_PREL { full = full - cast(int64, p) }
		var residual int64 = full & 0xffff
		if kind == R_ARM_MOVT_ABS || kind == R_ARM_MOVT_PREL {
			residual = (full >> cast(uint, 16)) & 0xffff
		}
		var enc int64 = ((residual & 0xf000) << cast(uint, 4)) | (residual & 0xfff)
		writeU32(data, byteLoc, (insn & cast(int64, 0xfff0f000)) | enc)
		return ""
	}
	if kind == R_ARM_LDR_PC_G0 || kind == R_ARM_LDRS_PC_G0 {
		return patchArm32PcLoad(data, byteLoc, kind, insn, addend, s, p, symName)
	}
	if kind == R_ARM_ALU_PC_G0 {
		return patchArm32Adr(data, byteLoc, insn, addend, s, p, symName)
	}
	if kind == R_ARM_PREL31 {
		// 31-bit PC-relative data word (bit 31 is a flag, preserved); A =
		// SignExtend(bits[30:0]); result S + A - P written into bits[30:0].
		var a int64 = insn & 0x7fffffff
		if (a & 0x40000000) != 0 { a = a - 0x80000000 } // sign-extend 31-bit
		var value int64 = cast(int64, s) + a + addend - cast(int64, p)
		if value > 0x3fffffff || value < (0 - 0x40000000) {
			// signed 31-bit
			return buf.Concat("PREL31 out of range for ", symName)
		}
		writeU32(data, byteLoc, (insn & cast(int64, 0x80000000)) | (value & 0x7fffffff))
		return ""
	}
	return buf.Concat("unsupported relocation in ", objPath)
}

// patchArm32PcLoad applies R_ARM_LDR_PC_G0 (U bit 23, offset bits 11:0: LDR / LDRB / STR /
// STRB) or R_ARM_LDRS_PC_G0 (U bit, offset split into bits 11:8 and 3:0: LDRH / STRH /
// LDRSB / LDRSH) to insn at byteLoc: A is the signed offset in the field, and S + A - P is
// written back as the U bit and magnitude, which must fit 4095 (255 for the split form).
func patchArm32PcLoad(data @[]uint8, byteLoc int, kind int, insn int64, addend int64, s uint64,
		p uint64, symName *[]readonly char) @[]readonly char {
	var mag int64 = insn & 0xfff
	var max int64 = 4095
	if kind == R_ARM_LDRS_PC_G0 {
		mag = ((insn >> cast(uint, 4)) & 0xf0) | (insn & 0xf)
		max = 255
	}
	if (insn & 0x800000) == 0 { mag = 0 - mag }
	var value int64 = cast(int64, s) + mag + addend - cast(int64, p)
	var up int64 = 0x800000
	if value < 0 {
		up = 0
		value = 0 - value
	}
	if value > max { return buf.Concat("PC-relative load / store out of range for ", symName) }
	if kind == R_ARM_LDR_PC_G0 {
		writeU32(data, byteLoc, (insn & cast(int64, 0xff7ff000)) | up | value)
	} else {
		writeU32(data, byteLoc,
				(insn & cast(int64, 0xff7ff0f0)) | up | ((value & 0xf0) << cast(uint, 4)) | (value & 0xf))
	}
	return ""
}

// patchArm32Adr applies R_ARM_ALU_PC_G0 to an ADR -- `ADD Rd, PC, #imm` (opcode 0100)
// or `SUB Rd, PC, #imm` (0010) -- at byteLoc: A is the field's rotated immediate,
// negative for SUB, and S + A - P is written back as an ADD or a SUB of its magnitude,
// which must be a rotated 8-bit immediate.  Any other instruction is an error.
func patchArm32Adr(data @[]uint8, byteLoc int, insn int64, addend int64, s uint64, p uint64,
		symName *[]readonly char) @[]readonly char {
	var op int64 = (insn >> cast(uint, 21)) & 0xf
	if (insn & 0x0e000000) != 0x02000000 || (op != 2 && op != 4) {
		return buf.Concat("R_ARM_ALU_PC_G0 not on an ADD / SUB immediate for ", symName)
	}
	var rot int64 = ((insn >> cast(uint, 8)) & 0xf) * 2
	var a int64 = insn & 0xff
	if rot != 0 {
		a = ((a >> cast(uint, rot)) | (a << cast(uint, 32 - rot))) & 0xffffffff
	}
	if op == 2 { a = 0 - a }
	var value int64 = cast(int64, s) + a + addend - cast(int64, p)
	var opcode int64 = 4
	if value < 0 {
		opcode = 2
		value = 0 - value
	}
	if value > 0xffffffff { return buf.Concat("ADR target out of range for ", symName) }
	var ri arm32.RotImmResult = arm32.EncodeRotImm(cast(int, value))
	if !ri.Ok { return buf.Concat("ADR target not a rotated 8-bit immediate away for ", symName) }
	writeU32(data, byteLoc,
			(insn & cast(int64, 0xfe1ff000)) | (opcode << cast(uint, 21)) |
					(cast(int64, ri.Rot4) << cast(uint, 8)) | cast(int64, ri.Imm8))
	return ""
}

// patchArm32Branch applies R_ARM_CALL (a BL or BLX) or R_ARM_JUMP24 (a B or a conditional BL)
// to the branch insn at byteLoc.  imm24 (and a BLX's H bit: imm24:H is the offset's bits 25:1)
// takes S + A - P, checked to fit 26 signed bits, A being the field's offset -- SignExtend(imm24)
// << 2, which holds the -8 of PC's read-ahead, plus H << 1 in a BLX -- plus addend.  (AAELF32 and
// lld read imm24 alone; GNU as keeps an addend's bit 1 in H, which clang never sets, so reading
// it lands GNU as's `blx f+2` where it says.)  A call to a function goes to the function's
// instruction set, bit 0 of its address set for Thumb code: BLX (H the target's bit 1) to
// Thumb, BL to ARM, whichever of the two the instruction was -- a BL becoming BLX only when
// blxOk, some input's build attributes allowing BLX (ARMv5T on), as lld has it.  A call to
// anything else keeps its instruction, 4-aligned for BL, 2-aligned for BLX.  What no branch can
// do is an error: a B or conditional BL (R_ARM_JUMP24) to a Thumb function, or a BL to one
// without blxOk (each would need a veneer, which bnld does not make); a conditional BL's switch
// to Thumb (BLX has no condition); R_ARM_JUMP24 on a BLX, and R_ARM_CALL on anything but a BL
// or BLX.
func patchArm32Branch(data @[]uint8, byteLoc int, kind int, insn int64, addend int64, s uint64,
		p uint64, fn bool, blxOk bool, symName *[]readonly char) @[]readonly char {
	var blx bool = (insn & cast(int64, 0xfe000000)) == cast(int64, 0xfa000000)
	var bl bool = (insn & cast(int64, 0x0f000000)) == cast(int64, 0x0b000000) && !blx
	if blx && kind == R_ARM_JUMP24 { return buf.Concat("R_ARM_JUMP24 on a BLX for ", symName) }
	if kind == R_ARM_CALL && !bl && !blx {
		return buf.Concat("R_ARM_CALL on an instruction that is no BL or BLX, for ", symName)
	}
	var thumbFn bool = fn && (s & 1) != 0
	var toThumb bool = blx
	if kind == R_ARM_CALL && fn { toThumb = thumbFn }
	if thumbFn && (!toThumb || (!blx && !blxOk)) {
		return buf.Concat(buf.Concat("a branch to the Thumb function ", symName),
				" needs a veneer, which bnld does not make")
	}
	if toThumb && !blx && (insn >> cast(uint, 28)) != 0xe {
		return buf.Concat("a conditional BL cannot switch to the Thumb code of ", symName)
	}
	var imm24 int64 = insn & 0xffffff
	if (imm24 & 0x800000) != 0 { imm24 = imm24 - 0x1000000 } // sign-extend 24-bit
	var a int64 = imm24 << cast(uint, 2)
	if blx { a = a + ((insn >> cast(uint, 23)) & 2) }
	var value int64 = cast(int64, s) + a + addend - cast(int64, p)
	if toThumb {
		// A Thumb function's bit 0 marks its instruction set, not part of its address.
		if thumbFn { value = value & ~cast(int64, 1) }
		if (value & 1) != 0 { return buf.Concat("misaligned branch target for ", symName) }
	} else if (value & 3) != 0 {
		return buf.Concat("misaligned branch target for ", symName)
	}
	if value > 0x1ffffff || value < (0 - 0x2000000) {
		// signed 26-bit (±32 MB)
		return buf.Concat("branch out of range for ", symName)
	}
	var top int64 = insn & cast(int64, 0xff000000)
	if toThumb {
		top = cast(int64, 0xfa000000) | ((value & 2) << cast(uint, 23))
	} else if blx {
		top = cast(int64, 0xeb000000) // a BLX to ARM code is BL
	}
	writeU32(data, byteLoc, top | ((value >> cast(uint, 2)) & 0xffffff))
	return ""
}

// anyArmBlx reports whether some arm32 input's build attributes allow BLX (InputObject.ArmBlx),
// which lets a call to Thumb code switch to it (patchArm32Branch).
func anyArmBlx(t @SymbolTable) bool {
	for o := 0; o < len(t.Objs); o++ {
		if t.Objs[o].Machine == EM_ARM && t.Objs[o].ArmBlx { return true }
	}
	return false
}

// patchArm32Data applies R_ARM_ABS16 / R_ARM_ABS8: S + A in a 2- or 1-byte data field, A the
// field's value sign-extended (the REL implicit addend) plus any explicit addend, its ABI
// overflow class the field's signed or unsigned range.
func patchArm32Data(data @[]uint8, byteLoc int, kind int, addend int64, s uint64,
		symName *[]readonly char, objPath *[]readonly char) @[]readonly char {
	var n int = 2
	if kind == R_ARM_ABS8 { n = 1 }
	if byteLoc < 0 || byteLoc + n > len(data) {
		return buf.Concat("relocation offset out of range in ", objPath)
	}
	var a int64 = cast(int64, data[byteLoc])
	if n == 2 {
		a = a | (cast(int64, data[byteLoc + 1]) << cast(uint, 8))
		if a >= 0x8000 { a = a - 0x10000 }
		return patchData(data, byteLoc, 2, cast(int64, s) + a + addend, -32768, 65535, "ABS16", symName)
	}
	if a >= 0x80 { a = a - 0x100 }
	return patchData(data, byteLoc, 1, cast(int64, s) + a + addend, -128, 255, "ABS8", symName)
}
