package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/elf"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// arm32 ADR (R_ARM_ALU_PC_G0): the addend is the field's rotated immediate, negative
// for a SUB (the assembler's -8 is `SUB Rd, PC, #8`), and S + A - P goes back as an ADD
// or a SUB of its magnitude.  (fail is in parse_elf_test.bn; patchOne / fieldWord in
// relocate_arm32_test.bn, symbolAddr in symaddr.bn, ldrPatchIs in
// relocate_arm32_ldr_test.bn.)

// Forward and backward, from a SUB field (A = -8) and an ADD one (A = +8), each word as
// clang writes the instruction: S - 8 - P = 0x100 is `add r0, pc, #256` (E28F0C01),
// -0x108 `sub r0, pc, #264` (E24F0F42) and 0xFF000000 `add r0, pc, #0xff000000`
// (E28F04FF); a distance with no rotated encoding, or the relocation on another
// instruction, is an error.
func TestPatchArm32AluPcG0() testing.TestResult {
	var sub int64 = cast(int64, 0xE24F0008)
	var add int64 = cast(int64, 0xE28F0008)
	var k int = R_ARM_ALU_PC_G0
	if !ldrPatchIs(sub, k, 0x208, 0x100, cast(int64, 0xE28F0C01)) { return fail("forward") }
	if !ldrPatchIs(sub, k, 0x100, 0x200, cast(int64, 0xE24F0F42)) { return fail("backward") }
	if !ldrPatchIs(add, k, 0x100, 0x100, cast(int64, 0xE28F0008)) { return fail("ADD addend") }
	if !ldrPatchIs(add, k, 0xFF000000, 0x8, cast(int64, 0xE28F04FF)) { return fail("top bits") }
	if !ldrPatchIs(cast(int64, 0x124F2008), k, 0x100, 0x200, cast(int64, 0x124F2F42)) {
		return fail("the condition and Rd are not kept")
	}
	if !ldrPatchIs(sub, k, 0x209, 0x100, -1) { return fail("0x101 accepted") }
	if !ldrPatchIs(cast(int64, 0xE3A00000), k, 0x100, 0x100, -1) { return fail("a MOV patched") }
	if !ldrPatchIs(cast(int64, 0xE59F0000), k, 0x100, 0x100, -1) { return fail("an LDR patched") }
	return ""
}

// adrTarget decodes the address a relocated ADR at fieldAddr computes: PC (the
// instruction + 8) plus (ADD) or minus (SUB) the rotated immediate.
func adrTarget(insn int64, fieldAddr uint64) uint64 {
	var rot int64 = ((insn >> cast(uint, 8)) & 0xf) * 2
	var v int64 = insn & 0xff
	if rot != 0 { v = ((v >> cast(uint, rot)) | (v << cast(uint, 32 - rot))) & 0xffffffff }
	if ((insn >> cast(uint, 21)) & 0xf) == 2 { v = 0 - v }
	return cast(uint64, cast(int64, fieldAddr) + 8 + v)
}

// End to end: object A takes the addresses of `gvar` and `gend + 4` (both in object B)
// with ADR, the assembler baking the REL addends (-8 and -4, as SUBs); after read ->
// resolve -> layout -> relocate each ADR computes exactly its target.
func TestRelocateArm32Adr() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.DefineLabel("taker")
	a.SetGlobal("taker")
	a.SetGlobal("gvar")
	a.SetGlobal("gend")
	arm32.Adr(a, arm32.COND_AL, arm32.R0, "gvar", 0)
	arm32.Adr(a, arm32.COND_AL, arm32.R1, "gend", 4)
	arm32.Bx(a, arm32.COND_AL, arm32.LR)
	if !arm32.ResolveFixups(a) { return fail("fixup resolution (A) failed") }
	a.Finalize()
	if a.HasError { return fail("assembler error (A)") }
	if !elf.WriteARM32(a, buf.Concat(dir, "/link_arm32_adrA.o"), false) {
		return fail("write A failed")
	}

	var b @asm.Assembler = asm.New(4)
	b.SetSection("text", -1)
	arm32.Nop(b)
	b.DefineLabel("gvar")
	b.SetGlobal("gvar")
	b.EmitUint32(0x12345678)
	b.DefineLabel("gend")
	b.SetGlobal("gend")
	b.EmitUint32(0x9abcdef0)
	b.EmitUint32(0x0fedcba9)
	b.Finalize()
	if b.HasError { return fail("assembler error (B)") }
	if !elf.WriteARM32(b, buf.Concat(dir, "/link_arm32_adrB.o"), false) {
		return fail("write B failed")
	}

	objA, ea := ReadObject(buf.Concat(dir, "/link_arm32_adrA.o"))
	if len(ea) != 0 { return fail("read A failed") }
	objB, eb := ReadObject(buf.Concat(dir, "/link_arm32_adrB.o"))
	if len(eb) != 0 { return fail("read B failed") }
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = objA
	objs[1] = objB
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return fail("resolve failed") }
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x8000))
	if len(Relocate(t, lr)) != 0 { return fail("relocate failed") }

	w0, at0, ok0 := fieldWord(objA, lr, "gvar", R_ARM_ALU_PC_G0)
	w1, at1, ok1 := fieldWord(objA, lr, "gend", R_ARM_ALU_PC_G0)
	if !ok0 || !ok1 { return fail("no ADR relocation to gvar / gend") }
	var gvarAddr uint64
	var gendAddr uint64
	var okv bool = false
	var oke bool = false
	for i := 0; i < len(objA.Relocs); i++ {
		var si int = objA.Relocs[i].SymIndex
		if charsEqual(objA.Symbols[si].Name, "gvar") { gvarAddr, okv = symbolAddr(t, lr, 0, si) }
		if charsEqual(objA.Symbols[si].Name, "gend") { gendAddr, oke = symbolAddr(t, lr, 0, si) }
	}
	if !okv || !oke { return fail("could not resolve gvar / gend") }
	if adrTarget(w0, at0) != gvarAddr { return fail("the first ADR does not compute gvar") }
	if adrTarget(w1, at1) != gendAddr + 4 { return fail("the second ADR does not compute gend + 4") }
	return ""
}
