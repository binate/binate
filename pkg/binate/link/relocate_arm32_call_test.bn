package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/elf"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// patchCall applies patchArm32 to a fresh 4-byte field holding the branch field, its target a
// function when fn and a call allowed to become BLX when blxOk, returning the resulting word and
// the error string.
func patchCall(field int64, kind int, s uint64, p uint64, fn bool,
		blxOk bool) (int64, @[]readonly char) {
	var data @[]uint8 = make_slice(uint8, 4)
	writeU32(data, 0, field)
	var e @[]readonly char = patchArm32(data, 0, kind, 0, s, p, fn, blxOk, "sym", "obj.o")
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	return u32(rd, 0), e
}

// wantCall checks one patchCall from P 0x1000, BLX allowed: no error and the word want.
func wantCall(field int64, kind int, s uint64, fn bool, want int64, what *[]readonly char) @[]char {
	w, e := patchCall(field, kind, s, cast(uint64, 0x1000), fn, true)
	if len(e) != 0 { return buf.Concat(buf.Concat(what, ": "), e) }
	if w != want { return buf.Concat(what, ": wrong word") }
	return ""
}

// wantCallError checks that one patchCall from P 0x1000 fails with an error holding sub.
func wantCallError(field int64, kind int, s uint64, fn bool, blxOk bool,
		sub *[]readonly char) bool {
	_, e := patchCall(field, kind, s, cast(uint64, 0x1000), fn, blxOk)
	return tlsHas(e, sub)
}

// R_ARM_CALL goes to a function's instruction set -- BL to ARM code, BLX (H the target's bit 1)
// to Thumb code, whose address has bit 0 set -- whichever of the two the call was, keeping a
// conditional BL's condition, and keeps a call to anything else as written.  Each target is
// 0xF8 past PC (the instruction + 8) and bit 0, field 0xEBFFFFFE / 0xFAFFFFFE (the -8 of PC's
// read-ahead), P 0x1000.
func TestPatchArm32CallInterworking() testing.TestResult {
	var bl int64 = cast(int64, 0xebfffffe)
	var blx int64 = cast(int64, 0xfafffffe)
	var e @[]char = wantCall(bl, R_ARM_CALL, cast(uint64, 0x1100), true, cast(int64, 0xeb00003e),
			"BL to an ARM function")
	if len(e) == 0 {
		e = wantCall(bl, R_ARM_CALL, cast(uint64, 0x1103), true, cast(int64, 0xfb00003e),
				"BL to a Thumb function")
	}
	if len(e) == 0 {
		e = wantCall(blx, R_ARM_CALL, cast(uint64, 0x1100), true, cast(int64, 0xeb00003e),
				"BLX to an ARM function")
	}
	if len(e) == 0 {
		e = wantCall(blx, R_ARM_CALL, cast(uint64, 0x1101), true, cast(int64, 0xfa00003e),
				"BLX to a Thumb function")
	}
	if len(e) == 0 {
		e = wantCall(blx, R_ARM_CALL, cast(uint64, 0x1102), false, cast(int64, 0xfb00003e),
				"BLX to a label")
	}
	if len(e) == 0 {
		e = wantCall(bl, R_ARM_CALL, cast(uint64, 0x1100), false, cast(int64, 0xeb00003e),
				"BL to a label")
	}
	if len(e) == 0 {
		e = wantCall(cast(int64, 0x0bfffffe), R_ARM_CALL, cast(uint64, 0x1100), true,
				cast(int64, 0x0b00003e), "BLEQ to an ARM function")
	}
	if len(e) != 0 { return fail(e) }
	// A label's address is its target: BL to a halfword, BLX to an odd byte, are misaligned.
	if !wantCallError(bl, R_ARM_CALL, cast(uint64, 0x1102), false, true, "misaligned") ||
			!wantCallError(blx, R_ARM_CALL, cast(uint64, 0x1101), false, true, "misaligned") {
		return fail("a misaligned label target was taken")
	}
	return ""
}

// A BLX's H bit is part of the field's offset, as GNU as writes an addend's bit 1 there:
// 0xFBFFFFFE holds -6 (-8 + 2), so a call to the label at 0x1102 is 0xFC past PC (0xFA00003F; the
// field's imm24 alone would make it misaligned, imm24 and the label's H 0xFB00003E), and a call
// to a Thumb function at 0x1100 (bit 0 set: 0x1101), 2 bytes into it, is 0xFB00003E.
func TestPatchArm32CallFieldH() testing.TestResult {
	var blxH int64 = cast(int64, 0xfbfffffe)
	var e @[]char = wantCall(blxH, R_ARM_CALL, cast(uint64, 0x1102), false, cast(int64, 0xfa00003f),
			"BLX with H to a label")
	if len(e) == 0 {
		e = wantCall(blxH, R_ARM_CALL, cast(uint64, 0x1101), true, cast(int64, 0xfb00003e),
				"BLX with H to a Thumb function")
	}
	if len(e) != 0 { return fail(e) }
	return ""
}

// A switch to Thumb reaches 26 signed bits as BL does: 0x1FFFFFE past PC the farthest forward
// (0xFB7FFFFF) and 0x2000000 before it backward (0xFA800000), 2 bytes more each way out of
// range.
func TestPatchArm32CallRange() testing.TestResult {
	var bl int64 = cast(int64, 0xebfffffe)
	var e @[]char = wantCall(bl, R_ARM_CALL, cast(uint64, 0x1000 + 8 + 0x1fffffe + 1), true,
			cast(int64, 0xfb7fffff), "the farthest switch forward")
	if len(e) != 0 { return fail(e) }
	var p uint64 = cast(uint64, 0x3000000)
	w, e1 := patchCall(bl, R_ARM_CALL, p + 8 - cast(uint64, 0x2000000) + 1, p, true, true)
	if len(e1) != 0 || w != cast(int64, 0xfa800000) { return fail("the farthest switch backward") }
	_, e2 := patchCall(bl, R_ARM_CALL, p + 8 - cast(uint64, 0x2000002) + 1, p, true, true)
	if !tlsHas(e2, "out of range") ||
			!wantCallError(bl, R_ARM_CALL, cast(uint64, 0x1000 + 8 + 0x2000000 + 1), true, true,
					"out of range") {
		return fail("a switch to Thumb out of range was taken")
	}
	return ""
}

// What no branch can do is an error: a B, a conditional BL (R_ARM_JUMP24) or a BL without BLX
// to a Thumb function (a veneer each); a conditional BL's switch to Thumb (BLX has no
// condition); R_ARM_JUMP24 on a BLX, and R_ARM_CALL on a B.
func TestPatchArm32CallErrors() testing.TestResult {
	var bl int64 = cast(int64, 0xebfffffe)
	var thumb uint64 = cast(uint64, 0x1101)
	if !wantCallError(cast(int64, 0xeafffffe), R_ARM_JUMP24, thumb, true, true, "needs a veneer") ||
			!wantCallError(cast(int64, 0x0bfffffe), R_ARM_JUMP24, thumb, true, true, "needs a veneer") ||
			!wantCallError(bl, R_ARM_CALL, thumb, true, false, "needs a veneer") {
		return fail("a branch to Thumb code needing a veneer was taken")
	}
	if !wantCallError(cast(int64, 0x0bfffffe), R_ARM_CALL, thumb, true, true, "conditional BL") {
		return fail("a conditional BL to Thumb code was taken")
	}
	if !wantCallError(cast(int64, 0xfafffffe), R_ARM_JUMP24, cast(uint64, 0x1100), false, true,
			"R_ARM_JUMP24 on a BLX") {
		return fail("R_ARM_JUMP24 on a BLX was taken")
	}
	if !wantCallError(cast(int64, 0xeafffffe), R_ARM_CALL, cast(uint64, 0x1100), false, true,
			"no BL or BLX") {
		return fail("R_ARM_CALL on a B was taken")
	}
	// Without BLX, a BLX in the input to ARM code is still BL, and a BL to ARM code BL.
	w, e1 := patchCall(cast(int64, 0xfafffffe), R_ARM_CALL, cast(uint64, 0x1100), cast(uint64, 0x1000),
			true, false)
	if len(e1) != 0 || w != cast(int64, 0xeb00003e) { return fail("BLX to ARM code without BLX") }
	// and a BLX in the input to Thumb code stays BLX.
	w, e1 = patchCall(cast(int64, 0xfafffffe), R_ARM_CALL, cast(uint64, 0x1101), cast(uint64, 0x1000),
			true, false)
	if len(e1) != 0 || w != cast(int64, 0xfa00003e) { return fail("BLX to Thumb code without BLX") }
	return ""
}

// orSymValue ORs bits into the st_value of the ELF32 symbol named name in the object data, and
// reports whether it found the symbol.
func orSymValue(data @[]uint8, name *[]readonly char, bits int64) bool {
	var fmt elfFmt = elfFmtFor(data[4])
	shoff, ok := readOffC(data, fmt.EShoff, fmt.Is64)
	if !ok || fmt.Is64 { return false }
	var shentsize int = u16(data, fmt.EShentsize)
	var shnum int = u16(data, fmt.EShnum)
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if cast(int, u32(data, sh + 4)) != SHT_SYMTAB { continue }
		symOff, sok := readOffC(data, sh + fmt.ShOffset, fmt.Is64)
		symSize, zok := readOffC(data, sh + fmt.ShSize, fmt.Is64)
		entsize, eok := readOffC(data, sh + fmt.ShEntsize, fmt.Is64)
		var strIdx int = cast(int, u32(data, sh + fmt.ShLink))
		strOff, tok := readOffC(data, shoff + strIdx * shentsize + fmt.ShOffset, fmt.Is64)
		if !sok || !zok || !eok || !tok || entsize == 0 { return false }
		for s := 0; s < symSize / entsize; s++ {
			var e int = symOff + s * entsize
			var nameOff int = cast(int, u32(data, e + fmt.SymName))
			if nameOff == 0 || !charsEqual(readCStr(data, strOff + nameOff, len(data)), name) {
				continue
			}
			writeU32(data, e + fmt.SymValue, u32(data, e + fmt.SymValue) | bits)
			return true
		}
	}
	return false
}

// callObjects writes object A, calling tf and af and the weak function wf it defines (as ARM
// code), and object B, defining the functions af (ARM code), tf and a strong wf (Thumb code:
// their ELF values' bit 0 set here in the assembled object), into dir; with archA / archB >= 0,
// A / B names it as its Tag_CPU_arch.  Returns A and B as read, or a present error.
func callObjects(dir *[]readonly char, archA int,
		archB int) (@InputObject, @InputObject, @[]readonly char) {
	var none @InputObject
	var a @asm.Assembler = asm.New(4)
	if archA >= 0 { a.SetArmAttr(6, cast(int64, archA), "") }
	a.SetSection("text", -1)
	a.SetGlobal("tf")
	a.SetGlobal("af")
	a.DefineLabel("wf")
	a.SetWeak("wf")
	a.SetType("wf", asm.SYM_FUNC)
	arm32.Bl(a, arm32.COND_AL, "tf")
	arm32.Bl(a, arm32.COND_AL, "af")
	arm32.Bl(a, arm32.COND_AL, "wf")
	if !arm32.ResolveFixups(a) { return none, none, "fixup resolution (A) failed" }
	a.Finalize()
	if a.HasError || !elf.WriteARM32(a, buf.Concat(dir, "/call_a.o")) {
		return none, none, "write A failed"
	}
	var b @asm.Assembler = asm.New(4)
	if archB >= 0 { b.SetArmAttr(6, cast(int64, archB), "") }
	b.SetSection("text", -1)
	b.DefineLabel("lbl")
	arm32.Nop(b, arm32.COND_AL)
	var names @[]@[]char = make_slice(@[]char, 3)
	names[0] = buf.CopyStr("af")
	names[1] = buf.CopyStr("tf")
	names[2] = buf.CopyStr("wf")
	for i := 0; i < 3; i++ {
		b.DefineLabel(names[i])
		b.SetGlobal(names[i])
		b.SetType(names[i], asm.SYM_FUNC)
		arm32.Nop(b, arm32.COND_AL)
	}
	if !arm32.ResolveFixups(b) { return none, none, "fixup resolution (B) failed" }
	b.Finalize()
	if b.HasError || !elf.WriteARM32(b, buf.Concat(dir, "/call_b.o")) {
		return none, none, "write B failed"
	}
	objA, ea := ReadObject(buf.Concat(dir, "/call_a.o"))
	if len(ea) != 0 { return none, none, "read A failed" }
	data, rok := readFile(buf.Concat(dir, "/call_b.o"))
	if !rok || !orSymValue(data, "tf", 1) || !orSymValue(data, "wf", 1) {
		return none, none, "cannot mark tf and wf Thumb"
	}
	objB, eb := readObjectBytes(data, "call_b.o")
	if len(eb) != 0 { return none, none, "read B failed" }
	return objA, objB, ""
}

// linkCallObjects links callObjects' A and B at 0x8000, returning Relocate's error.
func linkCallObjects(objA @InputObject,
		objB @InputObject) (@SymbolTable, @LayoutResult, @[]readonly char) {
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = objA
	objs[1] = objB
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return t, Layout(objs, cast(uint64, 0x8000)), "resolve failed" }
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x8000))
	return t, lr, Relocate(t, lr)
}

// callLanding returns where the relocated BL or BLX at field address p, word w, lands.
func callLanding(w int64, p uint64) int64 {
	var off int64 = w & 0xffffff
	if (off & 0x800000) != 0 { off = off - 0x1000000 }
	var land int64 = cast(int64, p) + 8 + (off << cast(uint, 2))
	if (w & cast(int64, 0xfe000000)) == cast(int64, 0xfa000000) {
		land = land + ((w >> cast(uint, 23)) & 2)
	}
	return land
}

// End to end: BL to an ARM function stays BL; BL to a Thumb one becomes BLX, the weak ARM wf
// in the caller's own object included, which B's strong Thumb wf overrides; each lands on its
// function.  The reader marks the STT_FUNC definitions Func, not a label of no type nor A's
// undefined references, and ArmBlx from the objects' Tag_CPU_arch: with ARMv4T (no BLX) the
// switch to Thumb needs a veneer, an error, and with one input ARMv4T and the other ARMv7 it is
// BLX, as lld has it (any input allowing BLX allows it).
func TestRelocateArm32CallToThumb() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	objA, objB, err := callObjects(dir, -1, -1)
	if len(err) != 0 { return fail(buf.Concat("", err)) }
	if !objA.ArmBlx || !objB.ArmBlx { return fail("bnas's ARMv7 objects not ArmBlx") }
	for i := 0; i < len(objB.Symbols); i++ {
		var sym InputSymbol = objB.Symbols[i]
		var fn bool = charsEqual(sym.Name, "af") || charsEqual(sym.Name, "tf") ||
				charsEqual(sym.Name, "wf")
		if sym.Func != fn { return fail(buf.Concat("wrong Func on ", sym.Name)) }
	}
	for i := 0; i < len(objA.Symbols); i++ {
		var sym InputSymbol = objA.Symbols[i]
		if sym.Func != charsEqual(sym.Name, "wf") {
			return fail(buf.Concat("wrong Func on A's ", sym.Name))
		}
	}
	t, lr, perr := linkCallObjects(objA, objB)
	if len(perr) != 0 { return fail(buf.Concat("relocate failed: ", perr)) }
	for r := 0; r < 3; r++ {
		w, p, ok := fieldWordOfKind(objA, lr, R_ARM_CALL, r)
		target, tok := symbolAddr(t, lr, 0, objA.Relocs[r].SymIndex)
		if !ok || !tok { return fail("missing a call relocation") }
		var thumb bool = (target & 1) == 1
		if thumb != ((w & cast(int64, 0xfe000000)) == cast(int64, 0xfa000000)) {
			return fail("a call is not BLX exactly when its target is Thumb code")
		}
		if !thumb && (w & cast(int64, 0xff000000)) != cast(int64, 0xeb000000) { return fail("not BL") }
		if callLanding(w, p) != cast(int64, target & ~cast(uint64, 1)) { return fail("a call misses") }
	}
	objA, objB, err = callObjects(dir, 2, 2)
	if len(err) != 0 { return fail(buf.Concat("", err)) }
	if objA.ArmBlx || objB.ArmBlx { return fail("ARMv4T objects taken as ArmBlx") }
	_, _, perr = linkCallObjects(objA, objB)
	if !tlsHas(perr, "needs a veneer") { return fail("a switch to Thumb without BLX linked") }
	objA, objB, err = callObjects(dir, 2, 10)
	if len(err) != 0 { return fail(buf.Concat("", err)) }
	if objA.ArmBlx || !objB.ArmBlx { return fail("ArmBlx not read per object") }
	_, lr, perr = linkCallObjects(objA, objB)
	if len(perr) != 0 { return fail(buf.Concat("an ARMv4T and ARMv7 link failed: ", perr)) }
	w, _, ok := fieldWordOfKind(objA, lr, R_ARM_CALL, 0)
	if !ok || (w & cast(int64, 0xfe000000)) != cast(int64, 0xfa000000) {
		return fail("BL to Thumb in an ARMv4T and ARMv7 link is not BLX")
	}
	return ""
}
