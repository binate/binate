package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/elf"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// arm32 PC-relative loads and stores (R_ARM_LDR_PC_G0, R_ARM_LDRS_PC_G0): the addend is
// the signed offset in the field (the assembler's -8), and S + A - P goes back as the U
// bit and magnitude.  (fail is in parse_elf_test.bn; patchOne / fieldWord / symbolAddr in
// relocate_arm32_test.bn and relocate.bn.)

// ldrPatchIs reports whether patching field with relocation kind, S and P gives want — or,
// want < 0, is rejected.
func ldrPatchIs(field int64, kind int, s int, p int, want int64) bool {
	w, e := patchOne(field, kind, cast(uint64, s), cast(uint64, p))
	if want < 0 { return len(e) != 0 }
	return len(e) == 0 && w == want
}

// The 12-bit form, forward and backward, up to ±4095 and no further: from `ldr r0, [pc,
// #-8]` (A = -8), S - 8 - P = 0xEF8 is E59F0EF8 and -0x108 E51F0108.
func TestPatchArm32LdrPcG0() testing.TestResult {
	var f int64 = cast(int64, 0xE51F0008)
	var k int = R_ARM_LDR_PC_G0
	if !ldrPatchIs(f, k, 0x1000, 0x100, cast(int64, 0xE59F0EF8)) { return fail("forward") }
	if !ldrPatchIs(f, k, 0x100, 0x200, cast(int64, 0xE51F0108)) { return fail("backward") }
	if !ldrPatchIs(f, k, 0x1107, 0x100, cast(int64, 0xE59F0FFF)) { return fail("+4095") }
	if !ldrPatchIs(f, k, 0x1108, 0x100, -1) { return fail("+4096 accepted") }
	if !ldrPatchIs(f, k, 0x100, 0x10F8, -1) { return fail("-4096 accepted") }
	return ""
}

// The split 8-bit form (immH bits 11:8, immL bits 3:0), forward and backward, up to ±255:
// from `ldrh r1, [pc, #-8]`, 0xF8 is E1DF1FB8 and -0x88 E15F18B8.
func TestPatchArm32LdrsPcG0() testing.TestResult {
	var f int64 = cast(int64, 0xE15F10B8)
	var k int = R_ARM_LDRS_PC_G0
	if !ldrPatchIs(f, k, 0x200, 0x100, cast(int64, 0xE1DF1FB8)) { return fail("forward") }
	if !ldrPatchIs(f, k, 0x100, 0x180, cast(int64, 0xE15F18B8)) { return fail("backward") }
	if !ldrPatchIs(f, k, 0x207, 0x100, cast(int64, 0xE1DF1FBF)) { return fail("+255") }
	if !ldrPatchIs(f, k, 0x208, 0x100, -1) { return fail("+256 accepted") }
	return ""
}

// pcLoadTarget decodes the address a relocated PC-relative load at fieldAddr reads: PC
// (the instruction + 8) plus or minus the field's magnitude.
func pcLoadTarget(insn int64, fieldAddr uint64, split bool) uint64 {
	var mag int64 = insn & 0xfff
	if split { mag = ((insn >> cast(uint, 4)) & 0xf0) | (insn & 0xf) }
	if (insn & 0x800000) == 0 { mag = 0 - mag }
	return cast(uint64, cast(int64, fieldAddr) + 8 + mag)
}

// End to end: object A loads `gvar` (defined in object B) with LDR and LDRH, the
// assembler baking the REL addend -8; after read -> resolve -> layout -> relocate each
// load reads exactly gvar's address.
func TestRelocateArm32PcLoads() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.DefineLabel("loader")
	a.SetGlobal("loader")
	a.SetGlobal("gvar") // undefined external -> literal-load relocations
	arm32.Ldr(a, arm32.COND_AL, arm32.R0, arm32.Label("gvar"))
	arm32.Ldrh(a, arm32.COND_AL, arm32.R1, arm32.Label("gvar"))
	arm32.Bx(a, arm32.COND_AL, arm32.LR)
	if !arm32.ResolveFixups(a) { return fail("fixup resolution (A) failed") }
	a.Finalize()
	if a.HasError { return fail("assembler error (A)") }
	if !elf.WriteARM32(a, buf.Concat(dir, "/link_arm32_ldrA.o"), false) {
		return fail("write A failed")
	}

	var b @asm.Assembler = asm.New(4)
	b.SetSection("text", -1)
	arm32.Nop(b)
	b.DefineLabel("gvar")
	b.SetGlobal("gvar")
	b.EmitUint32(0x12345678)
	b.Finalize()
	if b.HasError { return fail("assembler error (B)") }
	if !elf.WriteARM32(b, buf.Concat(dir, "/link_arm32_ldrB.o"), false) {
		return fail("write B failed")
	}

	objA, ea := ReadObject(buf.Concat(dir, "/link_arm32_ldrA.o"))
	if len(ea) != 0 { return fail("read A failed") }
	objB, eb := ReadObject(buf.Concat(dir, "/link_arm32_ldrB.o"))
	if len(eb) != 0 { return fail("read B failed") }
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = objA
	objs[1] = objB
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return fail("resolve failed") }
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x8000))
	if len(Relocate(t, lr)) != 0 { return fail("relocate failed") }

	ldr, ldrAddr, ok1 := fieldWord(objA, lr, "gvar", R_ARM_LDR_PC_G0)
	ldrh, ldrhAddr, ok2 := fieldWord(objA, lr, "gvar", R_ARM_LDRS_PC_G0)
	if !ok1 || !ok2 { return fail("no literal-load relocation to gvar") }
	var gi int = -1
	for i := 0; i < len(objA.Relocs); i++ {
		if objA.Relocs[i].Kind == R_ARM_LDR_PC_G0 { gi = objA.Relocs[i].SymIndex }
	}
	gvarAddr, gok := symbolAddr(t, lr, 0, gi)
	if !gok { return fail("could not resolve gvar") }
	if pcLoadTarget(ldr, ldrAddr, false) != gvarAddr { return fail("the LDR does not read gvar") }
	if pcLoadTarget(ldrh, ldrhAddr, true) != gvarAddr { return fail("the LDRH does not read gvar") }
	return ""
}
