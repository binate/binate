package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/elf"
import "pkg/builtins/testing"

// (fail is in parse_elf_test.bn; u32 in bytes.bn — same package.)

// linkOneArm32 reads one arm32 object, resolves + lays it out at base, and
// relocates it, returning the object and the LayoutResult so a test can decode a
// patched field.  On any step failing it returns a present error string.
func linkOneArm32(path *[]readonly char,
		base uint64) (@InputObject, @LayoutResult, @[]readonly char) {
	var none @LayoutResult
	obj, e := ReadObject(path)
	if len(e) != 0 { return obj, none, "read failed" }
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return obj, none, "resolve failed" }
	var lr @LayoutResult = Layout(objs, base)
	var perr @[]readonly char = Relocate(t, lr)
	if len(perr) != 0 { return obj, lr, perr }
	return obj, lr, ""
}

// fieldWord returns the relocated 4-byte little-endian word at the patch site of
// obj's relocation whose symbol is symName and whose kind is kind, plus the field's
// virtual address; ok is false if no such relocation exists.
func fieldWord(obj @InputObject, lr @LayoutResult, symName *[]readonly char,
		kind int) (int64, uint64, bool) {
	for i := 0; i < len(obj.Relocs); i++ {
		var rel InputReloc = obj.Relocs[i]
		if rel.Kind != kind { continue }
		var s int = rel.SymIndex
		if s < 0 || s >= len(obj.Symbols) || !charsEqual(obj.Symbols[s].Name, symName) { continue }
		var outIdx int = obj.Sections[rel.SecIndex].OutIndex
		var secOff uint = obj.Sections[rel.SecIndex].OutOffset
		var byteLoc int = cast(int, secOff + rel.Offset)
		// bnlint:allow managed-to-raw-assign - live local, read-only borrow
		var rd *[]readonly uint8 = lr.Sections[outIdx].Data
		var addr uint64 = lr.Sections[outIdx].Addr + cast(uint64, secOff) + cast(uint64, rel.Offset)
		return u32(rd, byteLoc), addr, true
	}
	return cast(int64, 0), cast(uint64, 0), false
}

// End-to-end arm32 branch: object A branches to an undefined "target" defined by
// object B.  arm32 is ELF32/REL, so the -8 pipeline bias rides in the field's
// imm24; after read -> resolve -> layout -> relocate the CPU rule
// (fieldAddr + 8) + SignExtend(imm24)<<2 must land exactly on target.
func TestRelocateArm32Branch() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.DefineLabel("caller")
	a.SetGlobal("caller")
	a.SetGlobal("target") // undefined external -> a branch relocation
	arm32.Bl(a, arm32.COND_AL, "target")
	arm32.Bx(a, arm32.COND_AL, arm32.LR)
	if !arm32.ResolveFixups(a) { return fail("fixup resolution (A) failed") }
	a.Finalize()
	if a.HasError { return fail("assembler error (A)") }
	if !elf.WriteARM32(a, "/tmp/binate_link_arm32_relA.o", false) { return fail("write A failed") }

	var b @asm.Assembler = asm.New(4)
	b.SetSection("text", -1)
	arm32.Nop(b) // padding before target so the resolved branch displacement is nonzero
	arm32.Nop(b)
	b.DefineLabel("target")
	b.SetGlobal("target")
	arm32.Bx(b, arm32.COND_AL, arm32.LR)
	if !arm32.ResolveFixups(b) { return fail("fixup resolution (B) failed") }
	b.Finalize()
	if b.HasError { return fail("assembler error (B)") }
	if !elf.WriteARM32(b, "/tmp/binate_link_arm32_relB.o", false) { return fail("write B failed") }

	objA, ea := ReadObject("/tmp/binate_link_arm32_relA.o")
	if len(ea) != 0 { return fail("read A failed") }
	objB, eb := ReadObject("/tmp/binate_link_arm32_relB.o")
	if len(eb) != 0 { return fail("read B failed") }
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = objA
	objs[1] = objB
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return fail("resolve failed") }
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x8000))
	if len(Relocate(t, lr)) != 0 { return fail("relocate failed") }

	insn, fieldAddr, ok := fieldWord(objA, lr, "target", R_ARM_JUMP24)
	if !ok { return fail("no branch relocation to target") }
	targetAddr, tok := symbolAddr(t, lr, 0, objA.Relocs[0].SymIndex)
	if !tok { return fail("could not resolve target") }
	var imm24 int64 = insn & 0xffffff
	if (imm24 & 0x800000) != 0 { imm24 = imm24 - 0x1000000 }
	var landing uint64 = cast(uint64, cast(int64, fieldAddr) + 8 + (imm24 << cast(uint, 2)))
	if landing != targetAddr { return fail("relocated branch would not land on target") }
	return ""
}

// End-to-end arm32 MOVW/MOVT + ABS32 against a defined data symbol: MOVW takes the
// low 16 bits of the address, MOVT the high 16, and the ABS32 data word the whole
// address.  A base with a nonzero high half exercises MOVT.
func TestRelocateArm32MovwMovtAbs() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.SetGlobal("gvar")
	arm32.MovwLabel(a, arm32.COND_AL, arm32.R0, "gvar")
	arm32.MovtLabel(a, arm32.COND_AL, arm32.R0, "gvar")
	arm32.Bx(a, arm32.COND_AL, arm32.LR)
	a.SetSection("data", -1)
	a.DefineLabel("gvar")
	a.SetGlobal("gvar")
	a.AddFixup("gvar", arm32.FIX_ABS32, 0, 4) // ABS32 pointer to gvar itself
	a.Fill(4, cast(uint8, 0))
	if !arm32.ResolveFixups(a) { return fail("fixup resolution failed") }
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	if !elf.WriteARM32(a, "/tmp/binate_link_arm32_movw.o", false) { return fail("write failed") }

	obj, lr, e := linkOneArm32("/tmp/binate_link_arm32_movw.o", cast(uint64, 0x420000))
	if len(e) != 0 { return fail("link failed") }

	var gi int = findSymbol(obj, "gvar")
	if gi < 0 { return fail("gvar symbol not found") }
	var gaddr uint64 = symAddrOf(obj, lr, gi)

	movw, _, wok := fieldWord(obj, lr, "gvar", R_ARM_MOVW_ABS_NC)
	if !wok { return fail("no MOVW relocation") }
	if imm16Of(movw) != cast(int64, gaddr & cast(uint64, 0xffff)) {
		return fail("MOVW imm16 should be the low 16 bits of gvar")
	}
	movt, _, tok := fieldWord(obj, lr, "gvar", R_ARM_MOVT_ABS)
	if !tok { return fail("no MOVT relocation") }
	if imm16Of(movt) != cast(int64, (gaddr >> cast(uint, 16)) & cast(uint64, 0xffff)) {
		return fail("MOVT imm16 should be the high 16 bits of gvar")
	}
	abs, _, aok := fieldWord(obj, lr, "gvar", R_ARM_ABS32)
	if !aok { return fail("no ABS32 relocation") }
	if (abs & 0xffffffff) != cast(int64, gaddr & cast(uint64, 0xffffffff)) {
		return fail("ABS32 word should be gvar's address")
	}
	return ""
}

// symAddrOf returns the final virtual address of obj's symbol at index i (defined
// in some laid-out section).
func symAddrOf(obj @InputObject, lr @LayoutResult, i int) uint64 {
	var sym InputSymbol = obj.Symbols[i]
	var outIdx int = obj.Sections[sym.SecIndex].OutIndex
	var secOff uint = obj.Sections[sym.SecIndex].OutOffset
	return lr.Sections[outIdx].Addr + cast(uint64, secOff) + cast(uint64, sym.Value)
}

// imm16Of decodes a MOVW/MOVT instruction's split imm4:imm12 immediate.
func imm16Of(insn int64) int64 { return ((insn >> cast(uint, 4)) & 0xf000) | (insn & 0xfff) }

// patchOne applies patchArm32 to a fresh 4-byte field initialized to `field`,
// returning the resulting word and the error string.
func patchOne(field int64, kind int, s uint64, p uint64) (int64, @[]readonly char) {
	var data @[]uint8 = make_slice(uint8, 4)
	writeU32(data, 0, field)
	var e @[]readonly char = patchArm32(data, 0, kind, 0, s, p, "sym", "obj.o")
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	return u32(rd, 0), e
}

// R_ARM_NONE patches nothing and never errors — even against an undefined symbol
// (s = 0), as .ARM.exidx's __aeabi_unwind_cpp_pr0 marker uses.
func TestPatchArm32None() testing.TestResult {
	w, e := patchOne(0x12345678, R_ARM_NONE, cast(uint64, 0), cast(uint64, 0x8000))
	if len(e) != 0 { return fail("R_ARM_NONE should not error") }
	if w != 0x12345678 { return fail("R_ARM_NONE must leave the field untouched") }
	return ""
}

// R_ARM_PREL31: S + A - P into bits[30:0], bit 31 preserved.  A rides in the field
// (0 here); with the top bit set in the input it must survive the patch.
func TestPatchArm32Prel31() testing.TestResult {
	// P = 0x1000, S = 0x1100 -> delta +0x100, top flag bit set on input.
	w, e := patchOne(cast(int64, 0x80000000), R_ARM_PREL31, cast(uint64, 0x1100), cast(uint64, 0x1000))
	if len(e) != 0 { return fail("PREL31 unexpected error") }
	if (w & 0x7fffffff) != 0x100 { return fail("PREL31 low 31 bits should be S - P (0x100)") }
	if (w & cast(int64, 0x80000000)) == 0 { return fail("PREL31 must preserve bit 31") }
	// A backward reference (S < P) yields a negative displacement in bits[30:0].
	w2, e2 := patchOne(cast(int64, 0), R_ARM_PREL31, cast(uint64, 0x1000), cast(uint64, 0x1100))
	if len(e2) != 0 { return fail("PREL31 backward unexpected error") }
	if (w2 & 0x7fffffff) != (0x7fffffff & (0 - 0x100)) {
		return fail("PREL31 backward displacement wrong")
	}
	return ""
}

// A branch whose target is not 4-aligned, and one that overflows the signed 26-bit
// range, must both be rejected loudly rather than silently truncated.
func TestPatchArm32BranchErrors() testing.TestResult {
	// Misaligned: S - 8 - P not a multiple of 4 (field 0 -> A = -8, S=0x1002, P=0x1000).
	_, e1 := patchOne(cast(int64, 0), R_ARM_CALL, cast(uint64, 0x1002), cast(uint64, 0x1000))
	if len(e1) == 0 { return fail("misaligned branch should be rejected") }
	// Out of range: S far beyond +32 MB from P (field 0 -> A = -8).
	_, e2 := patchOne(cast(int64, 0), R_ARM_JUMP24, cast(uint64, 0x8000000), cast(uint64, 0x1000))
	if len(e2) == 0 { return fail("out-of-range branch should be rejected") }
	return ""
}

// An unsupported relocation kind is rejected rather than silently mis-patched.
func TestPatchArm32UnsupportedKind() testing.TestResult {
	_, e := patchOne(cast(int64, 0), 999, cast(uint64, 0x1000), cast(uint64, 0x1000))
	if len(e) == 0 { return fail("unsupported kind should be rejected") }
	return ""
}
