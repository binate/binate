package "pkg/binate/link"

import "pkg/builtins/testing"

// GOT-indirect relocation patching.  For a *defined* symbol (static link, gotImp
// false) the linker RELAXES the GOT load to a direct address (no GOT needed).  For a
// dynamic *data import* (gotImp true) it KEEPS the load pointing at the GOT slot,
// which ld.so fills via GLOB_DAT.  (fail is in parse_elf_test.bn; u32 in bytes.bn —
// same package.)

// R_AARCH64_LD64_GOT_LO12_NC is relaxed from a GOT load to a direct address ADD:
// `ldr x0,[x1,#got_lo12]` (0xF9400020) becomes `add x0,x1,#:lo12:sym`, keeping Rd/Rn.
func TestPatchAArch64Ld64GotToAdd() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 4)
	writeLE(d, 0, 0xf9400020, 4) // ldr x0, [x1, #0]
	var e @[]readonly char = patchAArch64(d, 0, R_AARCH64_LD64_GOT_LO12_NC, 0, cast(uint, 0x40002a),
			cast(uint, 0), "sym", "obj", false)
	if len(e) != 0 { return fail("LD64_GOT relaxation should succeed") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = d
	// add x0, x1, #0x2a = 0x91000000 | (0x2a<<10) | (1<<5) | 0
	if u32(r, 0) != 0x9100a820 { return fail("LDR should be rewritten to ADD x0,x1,#0x2a") }
	return ""
}

// A non-LDR instruction at a LD64_GOT site is rejected rather than mis-rewritten.
func TestPatchAArch64Ld64GotRejectsNonLdr() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 4)
	writeLE(d, 0, 0xd503201f, 4) // nop (not a 64-bit ldr)
	var e @[]readonly char = patchAArch64(d, 0, R_AARCH64_LD64_GOT_LO12_NC, 0, cast(uint, 0x40002a),
			cast(uint, 0), "sym", "obj", false)
	if len(e) == 0 { return fail("a non-ldr GOT-load form should be rejected") }
	return ""
}

// R_AARCH64_ADR_GOT_PAGE relaxes an ADRP-to-GOT-page into ADRP-to-symbol-page (same
// page-delta encoding as ADR_PREL_PG_HI21).
func TestPatchAArch64AdrGotPage() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 4)
	writeLE(d, 0, 0x90000000, 4) // adrp x0, #0
	// page(s=0x402000) - page(p=0x400000) = 0x2000 -> 2 pages.  immlo = 2 (bits 30:29).
	var e @[]readonly char = patchAArch64(d, 0, R_AARCH64_ADR_GOT_PAGE, 0, cast(uint, 0x402000),
			cast(uint, 0x400000), "sym", "obj", false)
	if len(e) != 0 { return fail("ADR_GOT_PAGE relaxation should succeed") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = d
	if u32(r, 0) != 0xd0000000 { return fail("ADRP page delta encoded wrong (immlo=2)") }
	return ""
}

// With gotImp=true (a dynamic data import) the LD64_GOT LDR is KEPT, not relaxed to
// ADD: the load must read the GOT slot at s (an 8-aligned pointer), so its scaled
// imm12 is (s & 0xfff) / 8 and the instruction stays a 64-bit LDR.
func TestPatchAArch64Ld64GotKeepLoad() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 4)
	writeLE(d, 0, 0xf9400020, 4) // ldr x0, [x1, #0]
	// s = GOT slot at 0x402028 -> lo12 0x28 = 40 = slot index 5 (×8).
	var e @[]readonly char = patchAArch64(d, 0, R_AARCH64_LD64_GOT_LO12_NC, 0, cast(uint, 0x402028),
			cast(uint, 0), "environ", "obj", true)
	if len(e) != 0 { return fail("keeping the GOT load should succeed") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = d
	var insn int = u32(r, 0)
	// Still a 64-bit unsigned-offset LDR (top 10 bits), NOT rewritten to an ADD.
	if (insn & 0xffc00000) != 0xf9400000 { return fail("the GOT load must stay an LDR") }
	// ldr x0, [x1, #0x28]: 0xf9400020 | (5<<10) = 0xf9401420.
	if insn != 0xf9401420 { return fail("the LDR offset should address the GOT slot") }
	return ""
}

// With gotImp=true the x86-64 GOTPCRELX `mov sym@GOTPCREL(%rip),%reg` is KEPT (0x8b),
// not relaxed to `lea` (0x8d): the mov must load the GOT slot at s.  disp = s + A - P
// (A carries the -4 instruction-end adjustment).
func TestPatchX64GotpcrelxKeepLoad() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 8)
	d[0] = 0x48 // REX.W
	d[1] = 0x8b // mov r64, r/m64
	d[2] = 0x05 // modrm: rax, [rip+disp32]
	// disp32 at offset 3; s = GOT slot 0x404000, P = site 0x401000, A = -4.
	var e @[]readonly char = patchX64(d, 3, 0, R_X86_64_REX_GOTPCRELX, 0 - 4, cast(uint, 0x404000),
			cast(uint, 0x401000), "environ", "obj", true)
	if len(e) != 0 { return fail("keeping the GOTPCRELX mov should succeed") }
	if d[1] != 0x8b { return fail("the mov (0x8b) must be KEPT (not relaxed to lea 0x8d)") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = d
	// disp = 0x404000 - 4 - 0x401000 = 0x2ffc.
	if u32(r, 3) != 0x2ffc { return fail("the mov disp should reach the GOT slot") }
	return ""
}
