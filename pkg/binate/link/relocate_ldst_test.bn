package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for the AArch64 load/store lo12 relocations: the Mach-O PAGEOFF12 → LDST*
// kind mapping (by the patched instruction's access size) and the patcher's per-size
// imm12 scaling and alignment check.

// insnBytes returns a 4-byte section holding the little-endian instruction insn.
func insnBytes(insn int64) @[]uint8 {
	var d @[]uint8 = make_slice(uint8, 4)
	writeU32(d, 0, insn)
	return d
}

// pageoff12Kind runs machoReloc for a PAGEOFF12 on insn, returning (kind, addend, ok).
func pageoff12Kind(insn int64, addendIn int) (int, int, bool) {
	var d @[]uint8 = insnBytes(insn)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = d
	return machoReloc(ARM64_RELOC_PAGEOFF12, 2, r, 0, addendIn)
}

// checkPageoff12Kind reports "" when a PAGEOFF12 on insn (named op, for the message)
// maps to want and carries the pending addend, else a failure naming op.
func checkPageoff12Kind(insn int64, want int, op *[]readonly char) @[]char {
	kind, addend, ok := pageoff12Kind(insn, 24)
	if !ok || kind != want || addend != 24 {
		return buf.Concat(buf.Concat("PAGEOFF12 on ", op), ": wrong kind/addend or rejected")
	}
	return ""
}

// A PAGEOFF12 on a load/store picks the LDST kind of that instruction's access size
// (every GP and SIMD&FP unsigned-offset form clang emits), carrying the pending addend;
// an ADD keeps the ADD lo12 kind.  Words are clang's encodings of `<op> <reg>, [x1]`.
func TestMachoPageoff12KindPerAccessSize() testing.TestResult {
	var e @[]char = checkPageoff12Kind(0x39400020, R_AARCH64_LDST8_ABS_LO12_NC, "ldrb w0")
	if len(e) == 0 { e = checkPageoff12Kind(0x39000020, R_AARCH64_LDST8_ABS_LO12_NC, "strb w0") }
	if len(e) == 0 { e = checkPageoff12Kind(0x39800020, R_AARCH64_LDST8_ABS_LO12_NC, "ldrsb x0") }
	if len(e) == 0 { e = checkPageoff12Kind(0x39C00020, R_AARCH64_LDST8_ABS_LO12_NC, "ldrsb w0") }
	if len(e) == 0 { e = checkPageoff12Kind(0x79400020, R_AARCH64_LDST16_ABS_LO12_NC, "ldrh w0") }
	if len(e) == 0 { e = checkPageoff12Kind(0x79800020, R_AARCH64_LDST16_ABS_LO12_NC, "ldrsh x0") }
	if len(e) == 0 { e = checkPageoff12Kind(0xB9400020, R_AARCH64_LDST32_ABS_LO12_NC, "ldr w0") }
	if len(e) == 0 { e = checkPageoff12Kind(0xB9000020, R_AARCH64_LDST32_ABS_LO12_NC, "str w0") }
	if len(e) == 0 { e = checkPageoff12Kind(0xB9800020, R_AARCH64_LDST32_ABS_LO12_NC, "ldrsw x0") }
	if len(e) == 0 { e = checkPageoff12Kind(0xF9400020, R_AARCH64_LDST64_ABS_LO12_NC, "ldr x0") }
	if len(e) == 0 { e = checkPageoff12Kind(0xF9000020, R_AARCH64_LDST64_ABS_LO12_NC, "str x0") }
	if len(e) == 0 {
		e = checkPageoff12Kind(0xF9800020, R_AARCH64_LDST64_ABS_LO12_NC, "prfm pldl1keep")
	}
	if len(e) == 0 { e = checkPageoff12Kind(0x3D400020, R_AARCH64_LDST8_ABS_LO12_NC, "ldr b0") }
	if len(e) == 0 { e = checkPageoff12Kind(0x7D400020, R_AARCH64_LDST16_ABS_LO12_NC, "ldr h0") }
	if len(e) == 0 { e = checkPageoff12Kind(0xBD400020, R_AARCH64_LDST32_ABS_LO12_NC, "ldr s0") }
	if len(e) == 0 { e = checkPageoff12Kind(0xFD400020, R_AARCH64_LDST64_ABS_LO12_NC, "ldr d0") }
	if len(e) == 0 { e = checkPageoff12Kind(0x3DC00020, R_AARCH64_LDST128_ABS_LO12_NC, "ldr q0") }
	if len(e) == 0 { e = checkPageoff12Kind(0x3D800020, R_AARCH64_LDST128_ABS_LO12_NC, "str q0") }
	if len(e) == 0 { e = checkPageoff12Kind(0x91000020, R_AARCH64_ADD_ABS_LO12_NC, "add x0, x1, #0") }
	return e
}

// A PAGEOFF12 on anything but an ADD or an unsigned-offset load/store has no lo12
// field to patch: it is rejected, never guessed at.
func TestMachoPageoff12RejectsOtherInstructions() testing.TestResult {
	_, _, okNop := pageoff12Kind(0xD503201F, 0) // nop
	if okNop { return fail("PAGEOFF12 on a nop should be rejected") }
	// ldr x0, [x1, #8]! — pre-index carries an imm9, not a scaled imm12.
	_, _, okPre := pageoff12Kind(0xF8408C20, 0)
	if okPre { return fail("PAGEOFF12 on a pre-index load should be rejected") }
	// V=1 size=01 opc=11 is an unallocated load/store encoding.
	_, _, okUnalloc := pageoff12Kind(0x7DC00020, 0)
	if okUnalloc { return fail("PAGEOFF12 on an unallocated SIMD load/store should be rejected") }
	// V=0 opc=11 with size 10 / 11 are unallocated general-purpose encodings.
	_, _, okGp32 := pageoff12Kind(0xB9C00020, 0)
	_, _, okGp64 := pageoff12Kind(0xF9C00020, 0)
	if okGp32 || okGp64 { return fail("PAGEOFF12 on an unallocated GP load/store should be rejected") }
	// add x0, x1, #0, lsl #12: a shifted ADD has no page-offset form.
	_, _, okShAdd := pageoff12Kind(0x91400020, 0)
	if okShAdd { return fail("PAGEOFF12 on an ADD with lsl #12 should be rejected") }
	return ""
}

// Each LDST kind stores the low 12 bits of S+A divided by its access size into imm12
// (bits 21:10), leaving the rest of the instruction intact.  S+A = 0x5230 is aligned
// to every size; lo12 = 0x230.
func TestPatchAArch64LdstLo12Scales() testing.TestResult {
	var kinds @[]int = @[]int{
			R_AARCH64_LDST8_ABS_LO12_NC, R_AARCH64_LDST16_ABS_LO12_NC, R_AARCH64_LDST32_ABS_LO12_NC,
			R_AARCH64_LDST64_ABS_LO12_NC, R_AARCH64_LDST128_ABS_LO12_NC}
	var insns @[]int64 = @[]int64{0x39400020, 0x79400020, 0xB9400020, 0xF9400020, 0x3DC00020}
	var sizes @[]int = @[]int{1, 2, 4, 8, 16}
	for i := 0; i < len(kinds); i++ {
		var d @[]uint8 = insnBytes(insns[i])
		var e @[]readonly char = patchAArch64(d, 0, kinds[i], 0x30, cast(uint64, 0x5200),
				cast(uint64, 0x1000), "sym", "obj", false)
		if len(e) != 0 { return fail("an aligned LDST lo12 patch should succeed") }
		// bnlint:allow managed-to-raw-assign - live local, read-only borrow
		var r *[]readonly uint8 = d
		var wantInsn int64 = insns[i] | (cast(int64, 0x230 / sizes[i]) << 10)
		if u32(r, 0) != wantInsn { return fail("LDST lo12 imm12 should be lo12 / access size") }
	}
	return ""
}

// clang's `ldr q0, [x9, :lo12:sym]` with sym at page offset 0x10 must patch imm12=1
// (0x3DC00520) — the 16-byte scale; the 8-byte scale would give imm12=2, addressing
// 0x20.
func TestPatchAArch64Ldst128MatchesClang() testing.TestResult {
	var d @[]uint8 = insnBytes(0x3DC00120) // ldr q0, [x9]
	var e @[]readonly char = patchAArch64(d, 0, R_AARCH64_LDST128_ABS_LO12_NC, 0, cast(uint64, 0x4010),
			cast(uint64, 0x1000), "sym", "obj", false)
	if len(e) != 0 { return fail("LDST128 patch should succeed") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = d
	if u32(r, 0) != 0x3DC00520 { return fail("LDST128 at offset 0x10 should give ldr q0, [x9, #16]") }
	return ""
}

// A target whose low 12 bits are not a multiple of the access size cannot be encoded;
// the patch fails loudly instead of dropping the low bits.  A byte access has no
// alignment requirement.
func TestPatchAArch64LdstLo12RejectsMisaligned() testing.TestResult {
	var kinds @[]int = @[]int{
			R_AARCH64_LDST16_ABS_LO12_NC, R_AARCH64_LDST32_ABS_LO12_NC, R_AARCH64_LDST64_ABS_LO12_NC,
			R_AARCH64_LDST128_ABS_LO12_NC}
	var misalign @[]int = @[]int{1, 2, 4, 8}
	for i := 0; i < len(kinds); i++ {
		var d @[]uint8 = insnBytes(0xF9400020)
		var e @[]readonly char = patchAArch64(d, 0, kinds[i], misalign[i], cast(uint64, 0x5200),
				cast(uint64, 0x1000), "sym", "obj", false)
		if len(e) == 0 { return fail("a misaligned LDST lo12 target should be rejected") }
	}
	var b @[]uint8 = insnBytes(0x39400020)
	var e8 @[]readonly char = patchAArch64(b, 0, R_AARCH64_LDST8_ABS_LO12_NC, 0x231,
			cast(uint64, 0x5000), cast(uint64, 0x1000), "sym", "obj", false)
	if len(e8) != 0 { return fail("a byte-access LDST8 patch has no alignment requirement") }
	return ""
}
