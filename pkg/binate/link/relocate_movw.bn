package "pkg/binate/link"

import "pkg/binate/buf"

// The AArch64 MOVW-group relocations (R_AARCH64_MOVW_UABS_G0 .. R_AARCH64_MOVW_PREL_G3),
// as the ELF for the Arm 64-bit Architecture defines them: X is S + A (UABS, SABS) or
// S + A - P (PREL), and the instruction's imm16 gets X's chunk G (bits 16G+15:16G).  A
// checked kind requires X to fit the chunks up to G — [0, 2^(16(G+1))) unsigned,
// [-2^(16(G+1)), 2^(16(G+1))) signed; an _NC kind and G3 are not checked.  A signed kind
// (SABS, and PREL but for _NC) on a MOVZ or MOVN makes it a MOVZ of the chunk of X when X
// is non-negative, else a MOVN of the chunk of ~X; on a MOVK, and for the other kinds, the
// opcode is kept.

// movwRelocChunk returns the chunk G (0..3) a MOVW-group relocation kind fills, or -1
// for any other kind.
func movwRelocChunk(kind int) int {
	if kind == R_AARCH64_MOVW_UABS_G0 || kind == R_AARCH64_MOVW_UABS_G0_NC ||
			kind == R_AARCH64_MOVW_SABS_G0 || kind == R_AARCH64_MOVW_PREL_G0 ||
			kind == R_AARCH64_MOVW_PREL_G0_NC {
		return 0
	}
	if kind == R_AARCH64_MOVW_UABS_G1 || kind == R_AARCH64_MOVW_UABS_G1_NC ||
			kind == R_AARCH64_MOVW_SABS_G1 || kind == R_AARCH64_MOVW_PREL_G1 ||
			kind == R_AARCH64_MOVW_PREL_G1_NC {
		return 1
	}
	if kind == R_AARCH64_MOVW_UABS_G2 || kind == R_AARCH64_MOVW_UABS_G2_NC ||
			kind == R_AARCH64_MOVW_SABS_G2 || kind == R_AARCH64_MOVW_PREL_G2 ||
			kind == R_AARCH64_MOVW_PREL_G2_NC {
		return 2
	}
	if kind == R_AARCH64_MOVW_UABS_G3 || kind == R_AARCH64_MOVW_PREL_G3 { return 3 }
	return -1
}

// movwRelocSigned reports whether a MOVW-group kind is signed: X may be negative, and a
// MOVZ / MOVN takes X's sign.
func movwRelocSigned(kind int) bool {
	if kind == R_AARCH64_MOVW_SABS_G0 || kind == R_AARCH64_MOVW_SABS_G1 ||
			kind == R_AARCH64_MOVW_SABS_G2 {
		return true
	}
	return kind == R_AARCH64_MOVW_PREL_G0 || kind == R_AARCH64_MOVW_PREL_G1 ||
			kind == R_AARCH64_MOVW_PREL_G2 || kind == R_AARCH64_MOVW_PREL_G3
}

// movwRelocChecked reports whether a MOVW-group kind checks X's range (not _NC, not G3).
func movwRelocChecked(kind int) bool {
	return kind == R_AARCH64_MOVW_UABS_G0 || kind == R_AARCH64_MOVW_UABS_G1 ||
			kind == R_AARCH64_MOVW_UABS_G2 || kind == R_AARCH64_MOVW_SABS_G0 ||
			kind == R_AARCH64_MOVW_SABS_G1 || kind == R_AARCH64_MOVW_SABS_G2 ||
			kind == R_AARCH64_MOVW_PREL_G0 || kind == R_AARCH64_MOVW_PREL_G1 ||
			kind == R_AARCH64_MOVW_PREL_G2
}

// patchAArch64Movw applies MOVW-group relocation kind at byteLoc (see the file comment).
// Returns "" or an error: the site is not a move-wide instruction, or X is out of a
// checked kind's range.
func patchAArch64Movw(data @[]uint8, byteLoc int, kind int, addend int, s uint64, p uint64,
		symName *[]readonly char) @[]readonly char {
	var g int = movwRelocChunk(kind)
	var x int64 = cast(int64, s) + cast(int64, addend)
	if kind >= R_AARCH64_MOVW_PREL_G0 && kind <= R_AARCH64_MOVW_PREL_G3 { x = x - cast(int64, p) }
	var isSigned bool = movwRelocSigned(kind)
	if movwRelocChecked(kind) {
		var limit int64 = cast(int64, 1) << cast(uint, 16 * (g + 1))
		var low int64 = 0
		if isSigned { low = 0 - limit }
		if x < low || x >= limit { return buf.Concat("MOVW relocation out of range for ", symName) }
	}
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	var insn int64 = u32(r, byteLoc)
	// A move-wide immediate is bits 28:23 100101 with opc (bits 30:29) MOVN 00, MOVZ 10 or
	// MOVK 11 (01 is unallocated).
	var opc int64 = (insn >> 29) & 3
	if (insn & 0x1f800000) != 0x12800000 || opc == 1 {
		return buf.Concat("MOVW relocation on an instruction other than MOVZ / MOVN / MOVK for ", symName)
	}
	var v int64 = x
	if isSigned && opc != 3 {
		if x < 0 {
			v = x ^ -1
			insn = insn & (0xffffffff ^ (cast(int64, 1) << 30))
		} else {
			insn = insn | (cast(int64, 1) << 30)
		}
	}
	var chunk int64 = (v >> cast(uint, 16 * g)) & 0xffff
	writeU32(data, byteLoc, (insn & (0xffffffff ^ (cast(int64, 0xffff) << 5))) | (chunk << 5))
	return ""
}
