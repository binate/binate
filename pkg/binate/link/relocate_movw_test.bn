package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/asm/elf"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// The AArch64 MOVW-group relocations: each kind's chunk, the range a checked kind
// requires, the MOVZ / MOVN choice of a signed kind, and an ELF object's sequence linked
// end to end.  (fail is in parse_elf_test.bn, testTmpDir in link_test.bn, fieldWord in
// relocate_arm32_test.bn.)

// movwPatch applies kind (addend, S s, P p) to the instruction insn, returning the
// patched word and the error.
func movwPatch(insn int64, kind int, addend int, s uint64, p uint64) (int64, @[]readonly char) {
	var data @[]uint8 = make_slice(uint8, 4)
	writeU32(data, 0, insn)
	var err @[]readonly char = patchAArch64(data, 0, kind, addend, s, p, "sym", "t.o", false)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	return u32(r, 0), err
}

// movwWant checks that kind (addend, S s, P p) on insn makes want.
func movwWant(e @[]char, what *[]readonly char, insn int64, kind int, addend int, s uint64,
		p uint64, want int64) @[]char {
	if len(e) != 0 { return e }
	got, err := movwPatch(insn, kind, addend, s, p)
	if len(err) != 0 { return buf.Concat(buf.Concat(what, ": "), err) }
	if got != want { return buf.Concat(what, ": wrong instruction") }
	return e
}

// movwRejected checks that kind (addend, S s, P p) on insn fails with an error
// starting with want.
func movwRejected(e @[]char, what *[]readonly char, insn int64, kind int, addend int, s uint64,
		p uint64, want *[]readonly char) @[]char {
	if len(e) != 0 { return e }
	_, err := movwPatch(insn, kind, addend, s, p)
	if len(err) < len(want) || !charsEqual(err[0:len(want)], want) {
		return buf.Concat(buf.Concat(what, ": not rejected: "), err)
	}
	return e
}

// The move-wide instructions the cases patch (x0, imm16 0): MOVZ at shifts 0 / 16 / 32 /
// 48, MOVN and MOVK at shift 0.
const (
	movzX0 int64 = 0xD2800000
	movzX0L16 int64 = 0xD2A00000
	movzX0L32 int64 = 0xD2C00000
	movzX0L48 int64 = 0xD2E00000
	movnX0 int64 = 0x92800000
	movkX0 int64 = 0xF2800000
)

// The unsigned kinds put chunk G of S + A in the field, whatever the opcode; a checked
// one (not _NC, not G3) rejects S + A at or past 2^(16(G+1)).
func TestRelocateMovwUnsigned() testing.TestResult {
	var e @[]char = ""
	e = movwWant(e, "UABS_G0", movzX0, R_AARCH64_MOVW_UABS_G0, 4, 0x1230, 0, 0xD2824680)
	e = movwWant(e, "UABS_G0 top", movzX0, R_AARCH64_MOVW_UABS_G0, 0, 0xFFFF, 0, 0xD29FFFE0)
	e = movwRejected(e, "UABS_G0 2^16", movzX0, R_AARCH64_MOVW_UABS_G0, 0, 0x10000, 0,
			"MOVW relocation out of range for sym")
	e = movwWant(e, "UABS_G0_NC", movkX0, R_AARCH64_MOVW_UABS_G0_NC, 0, 0x12345678, 0, 0xF28ACF00)
	e = movwWant(e, "UABS_G1", movzX0L16, R_AARCH64_MOVW_UABS_G1, 0, 0xFFFFFFFF, 0, 0xD2BFFFE0)
	e = movwRejected(e, "UABS_G1 2^32", movzX0L16, R_AARCH64_MOVW_UABS_G1, 0, 0x100000000, 0,
			"MOVW relocation out of range")
	e = movwWant(e, "UABS_G1_NC", movzX0L16, R_AARCH64_MOVW_UABS_G1_NC, 0, 0x5555123400000000, 0,
			movzX0L16)
	e = movwWant(e, "UABS_G2", movzX0L32, R_AARCH64_MOVW_UABS_G2, 0, 0x123400000000, 0, 0xD2C24680)
	e = movwRejected(e, "UABS_G2 2^48", movzX0L32, R_AARCH64_MOVW_UABS_G2, 0, 0x1000000000000, 0,
			"MOVW relocation out of range")
	e = movwWant(e, "UABS_G2_NC", movzX0L32, R_AARCH64_MOVW_UABS_G2_NC, 0, 0x7777123400000000, 0,
			0xD2C24680)
	e = movwWant(e, "UABS_G3", movzX0L48, R_AARCH64_MOVW_UABS_G3, 0, 0xFEDC000000000000, 0, 0xD2FFDB80)
	// A negative S + A is out of an unsigned range; on a MOVN the opcode is kept.
	e = movwRejected(e, "UABS_G0 negative", movzX0, R_AARCH64_MOVW_UABS_G0, -1, 0, 0,
			"MOVW relocation out of range")
	e = movwWant(e, "UABS_G0 on MOVN", movnX0, R_AARCH64_MOVW_UABS_G0, 0, 5, 0, 0x928000A0)
	return e
}

// The signed kinds make a MOVZ or MOVN a MOVZ of chunk G of X when X >= 0, else a MOVN of
// chunk G of ~X, checking X within [-2^(16(G+1)), 2^(16(G+1))) (not PREL_G3); a MOVK
// keeps its opcode and takes chunk G of X; PREL is S + A - P, and PREL _NC takes the bits
// on any opcode.
func TestRelocateMovwSigned() testing.TestResult {
	var e @[]char = ""
	e = movwWant(e, "SABS_G0 -5", movzX0, R_AARCH64_MOVW_SABS_G0, -5, 0, 0, 0x92800080)
	e = movwWant(e, "SABS_G0 5 on MOVN", movnX0, R_AARCH64_MOVW_SABS_G0, 5, 0, 0, 0xD28000A0)
	e = movwWant(e, "SABS_G0 -2^16", movzX0, R_AARCH64_MOVW_SABS_G0, -0x10000, 0, 0, 0x929FFFE0)
	e = movwRejected(e, "SABS_G0 -2^16-1", movzX0, R_AARCH64_MOVW_SABS_G0, -0x10001, 0, 0,
			"MOVW relocation out of range")
	e = movwRejected(e, "SABS_G0 2^16", movzX0, R_AARCH64_MOVW_SABS_G0, 0x10000, 0, 0,
			"MOVW relocation out of range")
	e = movwWant(e, "SABS_G0 2^16-1", movnX0, R_AARCH64_MOVW_SABS_G0, 0xFFFF, 0, 0, 0xD29FFFE0)
	e = movwWant(e, "SABS_G0 on MOVK", movkX0, R_AARCH64_MOVW_SABS_G0, -5, 0, 0, 0xF29FFF60)
	e = movwWant(e, "SABS_G0 on a W MOVZ", 0x52800000, R_AARCH64_MOVW_SABS_G0, -5, 0, 0, 0x12800080)
	e = movwWant(e, "SABS_G1", movzX0L16, R_AARCH64_MOVW_SABS_G1, -0x12345678, 0, 0, 0x92A24680)
	e = movwRejected(e, "SABS_G1 2^32", movzX0L16, R_AARCH64_MOVW_SABS_G1, 0, 0x100000000, 0,
			"MOVW relocation out of range")
	e = movwWant(e, "SABS_G2", movzX0L32, R_AARCH64_MOVW_SABS_G2, 0, 0x123400000000, 0, 0xD2C24680)
	e = movwRejected(e, "SABS_G2 2^48", movzX0L32, R_AARCH64_MOVW_SABS_G2, 0, 0x1000000000000, 0,
			"MOVW relocation out of range")
	e = movwWant(e, "PREL_G0 back", movzX0, R_AARCH64_MOVW_PREL_G0, 0, 0x1000, 0x1010, 0x928001E0)
	e = movwWant(e, "PREL_G0 ahead", movnX0, R_AARCH64_MOVW_PREL_G0, 4, 0x1010, 0x1000, 0xD2800280)
	e = movwRejected(e, "PREL_G0 far", movzX0, R_AARCH64_MOVW_PREL_G0, 0, 0x20000, 0x1000,
			"MOVW relocation out of range")
	e = movwWant(e, "PREL_G0_NC on MOVK", movkX0, R_AARCH64_MOVW_PREL_G0_NC, 0, 0x1000, 0x1010,
			0xF29FFE00)
	e = movwWant(e, "PREL_G0_NC on MOVZ", movzX0, R_AARCH64_MOVW_PREL_G0_NC, 0, 0x1000, 0x1010,
			0xD29FFE00)
	e = movwWant(e, "PREL_G1", movzX0L16, R_AARCH64_MOVW_PREL_G1, 0, 0x30000, 0x10000, 0xD2A00040)
	e = movwRejected(e, "PREL_G1 2^32", movzX0L16, R_AARCH64_MOVW_PREL_G1, 0, 0x100001000, 0x1000,
			"MOVW relocation out of range")
	e = movwRejected(e, "PREL_G2 -2^48-1", movzX0L32, R_AARCH64_MOVW_PREL_G2, 0, 0, 0x1000000000001,
			"MOVW relocation out of range")
	e = movwWant(e, "PREL_G2_NC", movkX0, R_AARCH64_MOVW_PREL_G2_NC, 0, 0, 0x100000000, 0xF29FFFE0)
	e = movwWant(e, "PREL_G3 back", movzX0L48, R_AARCH64_MOVW_PREL_G3, 0, 0x1000, 0x1010, 0x92E00000)
	e = movwWant(e, "PREL_G3 ahead", movnX0, R_AARCH64_MOVW_PREL_G3, 0, 0x2000000000000, 0, 0xD2800040)
	return e
}

// A MOVW-group relocation on anything but MOVZ / MOVN / MOVK — an ADD, or the
// unallocated move-wide opc 01 — is an error.
func TestRelocateMovwNotMoveWide() testing.TestResult {
	var e @[]char = ""
	e = movwRejected(e, "ADD", 0x91000000, R_AARCH64_MOVW_UABS_G0_NC, 0, 0, 0,
			"MOVW relocation on an instruction other than MOVZ / MOVN / MOVK")
	e = movwRejected(e, "opc 01", 0xB2800000, R_AARCH64_MOVW_SABS_G0, 0, 0, 0,
			"MOVW relocation on an instruction")
	if movwRelocChunk(R_AARCH64_ABS64) != -1 { e = "ABS64 taken for a MOVW-group kind" }
	return e
}

// movwLink assembles an ELF object — f: the full MOVZ / MOVK sequence of g + 8, a SABS_G0
// of the absolute N = -5, a PREL_G1 / PREL_G0_NC pair to f, a UABS_G0 of g when lo16, and
// g — writes it, reads it back and links it at base.
func movwLink(dir *[]readonly char, base uint64,
		lo16 bool) (@InputObject, @LayoutResult, uint64, @[]readonly char) {
	var none @InputObject
	var noLr @LayoutResult
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_ELF
	a.SetSection("text", -1)
	a.SetGlobal("N")
	a.DefineAbsolute("N", -5)
	a.DefineLabel("f")
	isa.MoveWideReloc(a, isa.MW_MOVZ, true, 0, 48, "g", 8, isa.FIX_MOVW_UABS_G3)
	isa.MoveWideReloc(a, isa.MW_MOVK, true, 0, 32, "g", 8, isa.FIX_MOVW_UABS_G2_NC)
	isa.MoveWideReloc(a, isa.MW_MOVK, true, 0, 16, "g", 8, isa.FIX_MOVW_UABS_G1_NC)
	isa.MoveWideReloc(a, isa.MW_MOVK, true, 0, 0, "g", 8, isa.FIX_MOVW_UABS_G0_NC)
	isa.MoveWideReloc(a, isa.MW_MOVZ, true, 1, 0, "N", 0, isa.FIX_MOVW_SABS_G0)
	isa.MoveWideReloc(a, isa.MW_MOVZ, true, 2, 16, "f", 0, isa.FIX_MOVW_PREL_G1)
	isa.MoveWideReloc(a, isa.MW_MOVK, true, 2, 0, "f", 0, isa.FIX_MOVW_PREL_G0_NC)
	if lo16 { isa.MoveWideReloc(a, isa.MW_MOVZ, true, 3, 0, "g", 0, isa.FIX_MOVW_UABS_G0) }
	a.DefineLabel("g")
	a.SetGlobal("g")
	a.EmitUint32(0xD65F03C0) // ret
	a.Finalize()
	if a.HasError { return none, noLr, 0, a.ErrorMsg }
	var path @[]char = buf.Concat(dir, "/movw.o")
	if !elf.WriteAArch64(a, path) { return none, noLr, 0, "cannot write the ELF object" }
	obj, err := ReadObject(path)
	if len(err) != 0 { return none, noLr, 0, "cannot read the ELF object" }
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return none, noLr, 0, rerr }
	var lr @LayoutResult = Layout(objs, base)
	var lerr @[]readonly char = Relocate(t, lr)
	oo, ss, found := t.Lookup("g")
	if !found { return obj, lr, 0, "g not defined" }
	g, gok := definedAddr(t, lr, oo, ss)
	if !gok { return obj, lr, 0, "g not placed" }
	return obj, lr, g, lerr
}

// The linked sequence builds g + 8 chunk by chunk (with g linked past 2^32, so every
// chunk but G3 is non-zero), N = -5 is MOVN #4, and the PC-relative pair to f is MOVN
// #0, lsl #16 then MOVK of f's distance's low chunk; a checked UABS_G0 of g past 2^16
// fails the link.
func TestRelocateMovwLinks() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	obj, lr, g, err := movwLink(dir, cast(uint64, 0x123456780000), false)
	if len(err) != 0 { return fail(buf.Concat("link failed: ", err)) }
	var x uint64 = g + 8
	var e @[]char = ""
	var kinds @[]int = make_slice(int, 4)
	kinds[0] = R_AARCH64_MOVW_UABS_G3
	kinds[1] = R_AARCH64_MOVW_UABS_G2_NC
	kinds[2] = R_AARCH64_MOVW_UABS_G1_NC
	kinds[3] = R_AARCH64_MOVW_UABS_G0_NC
	var base @[]int64 = make_slice(int64, 4)
	base[0] = movzX0L48
	base[1] = 0xF2C00000
	base[2] = 0xF2A00000
	base[3] = movkX0
	for i := 0; i < 4; i++ {
		word, _, ok := fieldWord(obj, lr, "g", kinds[i])
		var chunk int64 = cast(int64, (x >> cast(uint64, 16 * (3 - i))) & 0xFFFF)
		if !ok || word != (base[i] | (chunk << 5)) { e = "the MOVZ / MOVK sequence is not g + 8" }
	}
	if (x & 0xFFFF0000) == 0 || (x & 0xFFFF00000000) == 0 {
		e = "g not linked where every chunk shows"
	}
	nw, _, nok := fieldWord(obj, lr, "N", R_AARCH64_MOVW_SABS_G0)
	if !nok || nw != 0x92800081 { e = "N = -5 is not MOVN x1, #4" }
	pw, _, pok := fieldWord(obj, lr, "f", R_AARCH64_MOVW_PREL_G1)
	if !pok || pw != 0x92A00002 { e = "f - P (-20) is not MOVN x2, #0, lsl #16" }
	kw, _, kok := fieldWord(obj, lr, "f", R_AARCH64_MOVW_PREL_G0_NC)
	if !kok || kw != 0xF29FFD02 { e = "f - P (-24) is not MOVK x2, #0xFFE8" }
	if len(e) != 0 { return fail(e) }
	_, _, _, rerr := movwLink(dir, cast(uint64, 0x400000), true)
	if !charsEqual(rerr, "MOVW relocation out of range for g") {
		return fail(buf.Concat("UABS_G0 of g past 2^16 linked: ", rerr))
	}
	return ""
}
