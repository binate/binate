package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// R_AARCH64_ADR_PREL_PG_HI21_NC patches an ADRP like R_AARCH64_ADR_PREL_PG_HI21 but keeps
// the page delta's low 21 bits where that one rejects a delta beyond ±4 GiB.  (fail is in
// parse_elf_test.bn.)

// adrpPatch applies kind (S s, P p, addend 0) to `adrp x0, 0`, returning the patched word
// and the error.
func adrpPatch(kind int, s uint64, p uint64) (int64, @[]readonly char) {
	var data @[]uint8 = make_slice(uint8, 4)
	writeU32(data, 0, 0x90000000)
	var err @[]readonly char = patchAArch64(data, 0, kind, 0, s, p, "sym", "t.o", false)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = data
	return u32(r, 0), err
}

func TestRelocateAdrpPageNc() testing.TestResult {
	// 15 pages ahead: immlo 3, immhi 3, under both kinds.
	w, err := adrpPatch(R_AARCH64_ADR_PREL_PG_HI21_NC, 0x10000, 0x1000)
	if len(err) != 0 || w != 0xF0000060 { return fail(buf.Concat("15 pages: ", err)) }
	w2, err2 := adrpPatch(R_AARCH64_ADR_PREL_PG_HI21, 0x10000, 0x1000)
	if len(err2) != 0 || w2 != 0xF0000060 { return fail(buf.Concat("15 pages, checked: ", err2)) }
	// 0x200003 pages ahead (past 8 GiB): the low 21 bits, 3, unchecked; the checked kind
	// fails.
	w3, err3 := adrpPatch(R_AARCH64_ADR_PREL_PG_HI21_NC, 0x200003000, 0)
	if len(err3) != 0 || w3 != 0xF0000000 { return fail(buf.Concat("past 8 GiB, unchecked: ", err3)) }
	_, err4 := adrpPatch(R_AARCH64_ADR_PREL_PG_HI21, 0x200003000, 0)
	if !charsEqual(err4, "ADRP page offset out of range for sym") {
		return fail(buf.Concat("past 8 GiB, checked: ", err4))
	}
	// 0x200003 pages back: the low 21 bits of -0x200003, 0x1ffffd (immlo 1, immhi 0x7ffff).
	w5, err5 := adrpPatch(R_AARCH64_ADR_PREL_PG_HI21_NC, 0, 0x200003000)
	if len(err5) != 0 || w5 != 0xB0FFFFE0 { return fail(buf.Concat("8 GiB back, unchecked: ", err5)) }
	return ""
}
