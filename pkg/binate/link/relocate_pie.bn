package "pkg/binate/link"

import "pkg/binate/buf"

// AbsGotSlot is a GOT slot holding an absolute symbol's value in a position-independent
// output (SymbolTable.PIE): the definition (ObjIdx, SymIdx) a GOT-indirect reference
// reaches, and the slot's address (Addr).  The slot is neither bound nor rebased: the
// value is the same wherever the image is loaded.
type AbsGotSlot struct {
	ObjIdx int
	SymIdx int
	Addr   uint64
}

// absoluteDef returns the absolute definition a reference to the symbol (objIdx, symIdx)
// binds to (chosenDef), and whether there is one.
func absoluteDef(t @SymbolTable, objIdx int, symIdx int) (int, int, bool) {
	oo, ss, found := chosenDef(t, objIdx, symIdx)
	if !found || !t.Objs[oo].Symbols[ss].Abs { return -1, -1, false }
	return oo, ss, true
}

// isGotIndirectReloc reports whether a relocation of kind (in an object for machine)
// reaches its target through the target's GOT slot.  (The kinds are machine-specific:
// x86-64's REX_GOTPCRELX is arm32's PREL31.)
func isGotIndirectReloc(machine int, kind int) bool {
	if machine == EM_AARCH64 { return isAArch64GotKind(kind) }
	if machine == EM_X86_64 { return kind == R_X86_64_GOTPCRELX || kind == R_X86_64_REX_GOTPCRELX }
	return false
}

// isPcRelativeReloc reports whether a relocation of kind (in an object for machine)
// computes its field from the distance to its target — a branch, an ADR / ADRP, a literal
// load, a PC-relative data word — which no position-independent image can encode for a
// target that does not move with it.
func isPcRelativeReloc(machine int, kind int) bool {
	if machine == EM_AARCH64 {
		return kind == R_AARCH64_CALL26 || kind == R_AARCH64_JUMP26 ||
				kind == R_AARCH64_ADR_PREL_PG_HI21 || kind == R_AARCH64_ADR_PREL_PG_HI21_NC ||
				kind == R_AARCH64_ADR_PREL_LO21 || kind == R_AARCH64_CONDBR19 || kind == R_AARCH64_TSTBR14 ||
				kind == R_AARCH64_LD_PREL_LO19 || kind == R_AARCH64_PREL32 ||
				(kind >= R_AARCH64_MOVW_PREL_G0 && kind <= R_AARCH64_MOVW_PREL_G3)
	}
	if machine == EM_X86_64 { return kind == R_X86_64_PC32 || kind == R_X86_64_PLT32 }
	if machine == EM_ARM {
		return kind == R_ARM_CALL || kind == R_ARM_JUMP24 || kind == R_ARM_LDR_PC_G0 ||
				kind == R_ARM_LDRS_PC_G0 || kind == R_ARM_PREL31
	}
	return false
}

// pieAbsoluteTarget adjusts relocation rel of object objIdx — whose target binds to the
// definition (oo, ss) when found (chosenDef), at address s — for a position-independent
// output.  A 32-bit absolute word holding a symbol in the image is an error: dyld rebases
// only pointer-sized words.  When the definition is an absolute symbol, a GOT-indirect
// reference is kept as a load of the slot holding the value (returning the slot's address
// as the new target, gotImp true); a PC-relative one is an error, as GNU ld and lld reject
// it in a PIE (ld64 links it against the unslid image, a value wrong once the image
// slides).  Any other relocation keeps s and gotImp.
func pieAbsoluteTarget(t @SymbolTable, objIdx int, rel InputReloc, oo int, ss int, found bool,
		s uint64, gotImp bool) (uint64, bool, @[]readonly char) {
	var obj @InputObject = t.Objs[objIdx]
	if !found || !t.Objs[oo].Symbols[ss].Abs {
		if found && obj.Machine == EM_AARCH64 && rel.Kind == R_AARCH64_ABS32 {
			var msg @[]char = buf.Concat("32-bit absolute address of ", obj.Symbols[rel.SymIndex].Name)
			msg = buf.Concat(msg, " in a position-independent executable (in ")
			return s, gotImp, buf.Concat(buf.Concat(msg, obj.Path), ")")
		}
		return s, gotImp, ""
	}
	if isGotIndirectReloc(obj.Machine, rel.Kind) {
		for i := 0; i < len(t.AbsGot); i++ {
			if t.AbsGot[i].ObjIdx == oo && t.AbsGot[i].SymIdx == ss { return t.AbsGot[i].Addr, true, "" }
		}
		return s, gotImp,
			buf.Concat("internal error: no GOT slot for absolute symbol ", t.Objs[oo].Symbols[ss].Name)
	}
	if isPcRelativeReloc(obj.Machine, rel.Kind) {
		var msg @[]char = buf.Concat("PC-relative reference to absolute symbol ",
				obj.Symbols[rel.SymIndex].Name)
		msg = buf.Concat(msg, " in a position-independent executable (in ")
		msg = buf.Concat(msg, obj.Path)
		return s, gotImp, buf.Concat(msg, ")")
	}
	return s, gotImp, ""
}

// collectAbsGotTargets returns one AbsGotSlot (its Addr not yet set) per absolute
// definition some GOT-indirect relocation in t's objects reaches, in first-reference
// order.
func collectAbsGotTargets(t @SymbolTable) @[]AbsGotSlot {
	var n int = 0 // the GOT-indirect relocations: at most one slot each
	for o := 0; o < len(t.Objs); o++ {
		var obj @InputObject = t.Objs[o]
		for r := 0; r < len(obj.Relocs); r++ {
			if isGotIndirectReloc(obj.Machine, obj.Relocs[r].Kind) { n = n + 1 }
		}
	}
	var slots @[]AbsGotSlot = make_slice(AbsGotSlot, n)
	var k int = 0
	for o := 0; o < len(t.Objs); o++ {
		var obj @InputObject = t.Objs[o]
		for r := 0; r < len(obj.Relocs); r++ {
			var rel InputReloc = obj.Relocs[r]
			if !isGotIndirectReloc(obj.Machine, rel.Kind) || rel.SymIndex < 0 ||
					rel.SymIndex >= len(obj.Symbols) {
				continue
			}
			oo, ss, abs := absoluteDef(t, o, rel.SymIndex)
			if !abs { continue }
			var seen bool = false
			for i := 0; i < k && !seen; i++ { seen = slots[i].ObjIdx == oo && slots[i].SymIdx == ss }
			if seen { continue }
			slots[k].ObjIdx = oo
			slots[k].SymIdx = ss
			k = k + 1
		}
	}
	return slots[0:k]
}
