package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Absolute targets in a position-independent output (relocate_pie.bn): which relocations
// are GOT-indirect or PC-relative per machine, the GOT slots collected for absolute
// targets, and how pieAbsoluteTarget treats each relocation.  (mkSym is in
// resolve_test.bn, mkSection in layout_test.bn, mkReloc in builder_emit_test.bn, fail in
// parse_elf_test.bn.)

// pieObj builds an object for machine with one 8-byte .text section, symbols syms and
// relocations relocs.
func pieObj(path *[]readonly char, machine int, syms @[]InputSymbol,
		relocs @[]InputReloc) @InputObject {
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, make_slice(uint8, 8), cast(uint, 8),
			4)
	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr(path)
	obj.Machine = machine
	obj.Sections = secs
	obj.Symbols = syms
	obj.Relocs = relocs
	return obj
}

// pieTable resolves a referencing object for machine — symbols K (undefined global), L
// (a local absolute symbol of 0x77), F (a global in .text) and U (weak, defined nowhere),
// with relocations relocs — against an object defining K as a global absolute symbol of
// 0x1234.
func pieTable(machine int, relocs @[]InputReloc) (@SymbolTable, @[]readonly char) {
	var syms @[]InputSymbol = make_slice(InputSymbol, 4)
	syms[0] = mkSym("K", -1, BIND_GLOBAL)
	syms[1] = mkSym("L", -1, 0)
	syms[1].Abs = true
	syms[1].AbsValue = 0x77
	syms[2] = mkSym("F", 0, BIND_GLOBAL)
	syms[3] = mkSym("U", -1, BIND_WEAK)
	var defSyms @[]InputSymbol = make_slice(InputSymbol, 1)
	defSyms[0] = mkSym("K", -1, BIND_GLOBAL)
	defSyms[0].Abs = true
	defSyms[0].AbsValue = 0x1234
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = pieObj("ref.o", machine, syms, relocs)
	objs[1] = pieObj("def.o", machine, defSyms, make_slice(InputReloc, 0))
	return Resolve(objs)
}

// The GOT-indirect and PC-relative kinds are told apart per machine: x86-64's
// REX_GOTPCRELX shares its number with arm32's PREL31, which is PC-relative, not GOT.
func TestPieRelocKinds() testing.TestResult {
	if !isGotIndirectReloc(EM_AARCH64, R_AARCH64_ADR_GOT_PAGE) ||
			!isGotIndirectReloc(EM_AARCH64, R_AARCH64_LD64_GOT_LO12_NC) ||
			!isGotIndirectReloc(EM_X86_64, R_X86_64_REX_GOTPCRELX) {
		return fail("a GOT-indirect kind not recognised")
	}
	if isGotIndirectReloc(EM_ARM, R_ARM_PREL31) || !isPcRelativeReloc(EM_ARM, R_ARM_PREL31) {
		return fail("arm32 PREL31 taken for x86-64's REX_GOTPCRELX")
	}
	if !isPcRelativeReloc(EM_AARCH64, R_AARCH64_ADR_PREL_PG_HI21) ||
			!isPcRelativeReloc(EM_AARCH64, R_AARCH64_CALL26) ||
			!isPcRelativeReloc(EM_AARCH64, R_AARCH64_MOVW_PREL_G0) ||
			!isPcRelativeReloc(EM_AARCH64, R_AARCH64_MOVW_PREL_G3) ||
			!isPcRelativeReloc(EM_X86_64, R_X86_64_PC32) {
		return fail("a PC-relative kind not recognised")
	}
	if isPcRelativeReloc(EM_AARCH64, R_AARCH64_ABS64) ||
			isPcRelativeReloc(EM_AARCH64, R_AARCH64_ADD_ABS_LO12_NC) ||
			isPcRelativeReloc(EM_AARCH64, R_AARCH64_MOVW_SABS_G2) ||
			isPcRelativeReloc(EM_AARCH64, R_AARCH64_ADR_GOT_PAGE) {
		return fail("an absolute or GOT kind taken for PC-relative")
	}
	return ""
}

// One slot per absolute definition a GOT-indirect relocation reaches, in first-reference
// order: K (defined in def.o) once for its two relocations, the local L in its own
// object; not F (in a section), and not K's PC-relative reference.
func TestCollectAbsGotTargets() testing.TestResult {
	var relocs @[]InputReloc = make_slice(InputReloc, 5)
	relocs[0] = mkReloc(0, cast(uint, 0), 0, R_AARCH64_ADR_GOT_PAGE, 0)
	relocs[1] = mkReloc(0, cast(uint, 4), 0, R_AARCH64_LD64_GOT_LO12_NC, 0)
	relocs[2] = mkReloc(0, cast(uint, 0), 2, R_AARCH64_ADR_GOT_PAGE, 0)
	relocs[3] = mkReloc(0, cast(uint, 4), 1, R_AARCH64_LD64_GOT_LO12_NC, 0)
	relocs[4] = mkReloc(0, cast(uint, 0), 0, R_AARCH64_CALL26, 0)
	t, rerr := pieTable(EM_AARCH64, relocs)
	if len(rerr) != 0 { return fail(buf.Concat("resolve failed: ", rerr)) }
	var slots @[]AbsGotSlot = collectAbsGotTargets(t)
	if len(slots) != 2 { return fail("not two slots") }
	if slots[0].ObjIdx != 1 || slots[0].SymIdx != 0 { return fail("the first slot is not def.o's K") }
	if slots[1].ObjIdx != 0 || slots[1].SymIdx != 1 { return fail("the second slot is not ref.o's L") }
	return ""
}

// pieCase checks pieAbsoluteTarget on a relocation of kind against ref.o's symbol symIdx
// with target address 0x9000: the target it returns, whether it keeps a GOT load, and
// whether it is an error.
func pieCase(e @[]char, t @SymbolTable, kind int, symIdx int, wantS uint64, wantGot bool,
		wantErr bool) @[]char {
	if len(e) != 0 { return e }
	var rel InputReloc = mkReloc(0, cast(uint, 0), symIdx, kind, 0)
	oo, ss, found := chosenDef(t, 0, symIdx)
	s, got, err := pieAbsoluteTarget(t, 0, rel, oo, ss, found, cast(uint64, 0x9000), false)
	if wantErr {
		if len(err) == 0 { return buf.CopyStr("an error expected") }
		return ""
	}
	if len(err) != 0 { return buf.Concat("unexpected error: ", err) }
	if s != wantS || got != wantGot { return buf.CopyStr("wrong target or GOT load") }
	return ""
}

// A GOT-indirect reference to an absolute symbol loads its slot; a PC-relative one is an
// error naming the symbol; an absolute one (ABS64, ABS32), or any but a 32-bit absolute
// word to a symbol in a section (an ABS32 to a weak symbol defined nowhere is 0), is left
// alone; a GOT-indirect one with no slot is an internal error.
func TestPieAbsoluteTarget() testing.TestResult {
	t, rerr := pieTable(EM_AARCH64, make_slice(InputReloc, 0))
	if len(rerr) != 0 { return fail(buf.Concat("resolve failed: ", rerr)) }
	t.PIE = true
	t.AbsGot = make_slice(AbsGotSlot, 1)
	t.AbsGot[0].ObjIdx = 1
	t.AbsGot[0].SymIdx = 0
	t.AbsGot[0].Addr = 0x5000
	var e @[]char = ""
	e = pieCase(e, t, R_AARCH64_ADR_GOT_PAGE, 0, 0x5000, true, false)
	e = pieCase(e, t, R_AARCH64_LD64_GOT_LO12_NC, 0, 0x5000, true, false)
	e = pieCase(e, t, R_AARCH64_CALL26, 0, 0, false, true)
	e = pieCase(e, t, R_AARCH64_ADR_PREL_PG_HI21, 1, 0, false, true)
	e = pieCase(e, t, R_AARCH64_ABS64, 0, 0x9000, false, false)
	e = pieCase(e, t, R_AARCH64_ADD_ABS_LO12_NC, 0, 0x9000, false, false)
	e = pieCase(e, t, R_AARCH64_CALL26, 2, 0x9000, false, false)
	e = pieCase(e, t, R_AARCH64_ADR_GOT_PAGE, 1, 0, false, true)
	e = pieCase(e, t, R_AARCH64_ABS32, 0, 0x9000, false, false)
	e = pieCase(e, t, R_AARCH64_ABS32, 2, 0, false, true)
	e = pieCase(e, t, R_AARCH64_ABS32, 3, 0x9000, false, false)
	if len(e) != 0 { return fail(e) }
	var abs32 InputReloc = mkReloc(0, cast(uint, 0), 2, R_AARCH64_ABS32, 0)
	_, _, aerr := pieAbsoluteTarget(t, 0, abs32, 0, 2, true, cast(uint64, 0x9000), false)
	var awant *[]readonly char = "32-bit absolute address of F in a position-independent"
	if len(aerr) < len(awant) || !charsEqual(aerr[0:len(awant)], awant) {
		return fail(buf.Concat("wrong 32-bit diagnostic: ", aerr))
	}
	var rel InputReloc = mkReloc(0, cast(uint, 0), 0, R_AARCH64_CALL26, 0)
	_, _, err := pieAbsoluteTarget(t, 0, rel, 1, 0, true, cast(uint64, 0x9000), false)
	var want *[]readonly char = "PC-relative reference to absolute symbol K in a position-independent"
	if len(err) < len(want) || !charsEqual(err[0:len(want)], want) {
		return fail(buf.Concat("wrong diagnostic: ", err))
	}
	return ""
}
