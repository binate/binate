package "pkg/binate/link"

import "pkg/binate/asm/assemble"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Literal-pool entries holding a symbol's address, assembled from text for AArch64 ELF and
// linked by bnld: the 8-byte entry (R_AARCH64_ABS64) and the 4-byte one (R_AARCH64_ABS32)
// both hold the symbol's address.  (fail is in parse_elf_test.bn, testTmpDir in
// link_test.bn, writeBytes in parse_ar_test.bn, fieldWord in relocate_arm32_test.bn.)
func TestPoolEntriesLink() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var sPath @[]char = buf.Concat(dir, "/pool.s")
	var src *[]readonly char =
	".arch aarch64\n.section text\n ldr x0, =data_word\n ldr w1, =data_word\n ret\n"
			".section data\ndata_word: .uint64 40\n"
	if !writeBytes(sPath, buf.CopyStr(src)) { return fail("cannot write the source") }
	var oPath @[]char = buf.Concat(dir, "/pool.o")
	ok, msg := assemble.AssembleFile(sPath, oPath, "aarch64", "linux")
	if !ok { return fail(buf.Concat("cannot assemble: ", msg)) }
	obj, rerr := ReadObject(oPath)
	if len(rerr) != 0 { return fail("cannot read the object") }
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	t, terr := Resolve(objs)
	if len(terr) != 0 { return fail(buf.Concat("resolve failed: ", terr)) }
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) != 0 { return fail("relocate failed") }
	var di int = -1
	for i := 0; i < len(obj.Symbols); i++ {
		if charsEqual(obj.Symbols[i].Name, "data_word") { di = i }
	}
	if di < 0 { return fail("data_word not listed") }
	addr, aok := definedAddr(t, lr, 0, di)
	if !aok { return fail("data_word not placed") }
	w64, a64, ok64 := fieldWord(obj, lr, "data_word", R_AARCH64_ABS64)
	w32, _, ok32 := fieldWord(obj, lr, "data_word", R_AARCH64_ABS32)
	if !ok64 || cast(uint64, w64) != addr { return fail("the 8-byte entry does not hold data_word") }
	// fieldWord reads 4 bytes: the 8-byte entry's high half, after it, must be 0.
	var hi bool = false
	for i := 0; i < len(lr.Sections); i++ {
		var s OutputSection = lr.Sections[i]
		if a64 + 8 > s.Addr && a64 + 8 <= s.Addr + cast(uint64, len(s.Data)) - 4 {
			// bnlint:allow managed-to-raw-assign - live local, read-only borrow
			var rd *[]readonly uint8 = s.Data
			hi = u32(rd, cast(int, a64 + 4 - s.Addr)) == 0
		}
	}
	if !hi { return fail("the 8-byte entry's high half is not 0") }
	if !ok32 || cast(uint64, w32) != addr { return fail("the 4-byte entry does not hold data_word") }
	return ""
}
