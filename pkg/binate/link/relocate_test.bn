package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// (fail is in parse_elf_test.bn; u32/charsEqual in bytes.bn — same package.)

// writeLE writes the low n bytes little-endian, including for a negative value.
func TestWriteLE() testing.TestResult {
	var b @[]uint8 = make_slice(uint8, 8)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = b
	writeLE(b, 0, 0x05060708, 4)
	if u32(r, 0) != 0x05060708 { return fail("writeLE u32 wrong") }
	writeLE(b, 0, 0x01020304, 8) // high 4 bytes -> 0
	if u32(r, 0) != 0x01020304 { return fail("writeLE u64 low word wrong") }
	if u32(r, 4) != 0 { return fail("writeLE u64 high word should be zero") }
	writeLE(b, 0, 0 - 1, 4) // -1 -> 0xFFFFFFFF
	if b[0] != 0xff || b[1] != 0xff || b[2] != 0xff || b[3] != 0xff {
		return fail("writeLE of -1 should be all 0xff")
	}
	return ""
}

// End-to-end: object A calls an external "target" defined by object B.  After
// read -> resolve -> layout -> relocate, the patched PC-relative displacement must
// make the call land exactly on target's address.
func TestRelocateCrossObjectCall() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("caller")
	a.SetGlobal("caller")
	a.SetGlobal("target") // undefined external -> a PC-relative call relocation
	x64.Call(a, "target")
	x64.Ret(a)
	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error (A)") }
	if !elf.WriteX86_64(a, buf.Concat(dir, "/link_relA.o")) { return fail("write A failed") }

	var b @asm.Assembler = asm.New(8)
	b.SetSection("text", -1)
	b.DefineLabel("target")
	b.SetGlobal("target")
	x64.Ret(b)
	x64.ResolveFixups(b)
	b.Finalize()
	if b.HasError { return fail("assembler error (B)") }
	if !elf.WriteX86_64(b, buf.Concat(dir, "/link_relB.o")) { return fail("write B failed") }

	objA, ea := ReadObject(buf.Concat(dir, "/link_relA.o"))
	if len(ea) != 0 { return fail("read A failed") }
	objB, eb := ReadObject(buf.Concat(dir, "/link_relB.o"))
	if len(eb) != 0 { return fail("read B failed") }

	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = objA
	objs[1] = objB
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return fail("resolve failed") }
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	var perr @[]readonly char = Relocate(t, lr)
	if len(perr) != 0 { return fail("relocate failed") }

	if len(objA.Relocs) != 1 { return fail("expected one relocation in object A") }
	var rel InputReloc = objA.Relocs[0]
	var outIdx int = objA.Sections[rel.SecIndex].OutIndex
	var secOff uint = objA.Sections[rel.SecIndex].OutOffset
	var fieldAddr uint64 = lr.Sections[outIdx].Addr + cast(uint64, secOff) + cast(uint64, rel.Offset)

	// Independently derive target's address (not via symbolAddr): it is at the
	// start of object B's .text, merged into the single output .text section.
	var bTextIdx int = objB.Sections[0].OutIndex
	var expectedTarget uint64 = lr.Sections[bTextIdx].Addr + cast(uint64, objB.Sections[0].OutOffset)
	targetAddr, ok := symbolAddr(t, lr, 0, rel.SymIndex)
	if !ok { return fail("could not resolve target address") }
	if targetAddr != expectedTarget { return fail("symbolAddr returned the wrong target address") }

	// Decode the patched displacement and check the CPU's PC-relative rule:
	// (fieldAddr + 4) + disp must equal the independently-derived target address.
	var byteLoc int = cast(int, secOff + rel.Offset)
	var data @[]uint8 = lr.Sections[outIdx].Data
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	var disp int64 = cast(int64, u32(rd, byteLoc)) & 0xffffffff
	if disp >= 0x80000000 { disp = disp - 0x100000000 } // to signed
	var landing uint64 = cast(uint64, cast(int64, fieldAddr) + 4 + disp)
	if landing != expectedTarget { return fail("relocated call would not land on target") }
	return ""
}

// An unknown relocation kind is rejected rather than silently ignored.
func TestRelocateRejectsUnknownKind() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 8)
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, d, cast(uint, 8), 1)
	var obj @InputObject = mkObjSecs(secs)
	obj.Symbols = make_slice(InputSymbol, 1)
	obj.Symbols[0] = mkSym("sym", 0, BIND_GLOBAL)
	obj.Relocs = make_slice(InputReloc, 1)
	var rel InputReloc
	rel.SecIndex = 0
	rel.Offset = cast(uint, 0)
	rel.SymIndex = 0
	rel.Kind = 9999
	rel.Addend = 0
	obj.Relocs[0] = rel
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	t, _ := Resolve(objs)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) == 0 { return fail("unknown relocation kind should be rejected") }
	return ""
}

// An AArch64 reloc kind (R_AARCH64_CALL26 = 283) carried by an x86-64 object (a
// malformed cross-arch input) is rejected by the x86 patcher, not mis-applied —
// aa64 LP64 kinds (>=257) never collide with x86's {1,2,4,42}.  (mkObjSecs makes an
// EM_X86_64 object, so Relocate dispatches to patchX64.)
func TestRelocateRejectsAArch64Reloc() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 8)
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, d, cast(uint, 8), 1)
	var obj @InputObject = mkObjSecs(secs)
	obj.Symbols = make_slice(InputSymbol, 1)
	obj.Symbols[0] = mkSym("target", 0, BIND_GLOBAL)
	obj.Relocs = make_slice(InputReloc, 1)
	var rel InputReloc
	rel.SecIndex = 0
	rel.Offset = cast(uint, 0)
	rel.SymIndex = 0
	rel.Kind = 283 // R_AARCH64_CALL26
	rel.Addend = 0
	obj.Relocs[0] = rel
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	t, _ := Resolve(objs)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) == 0 {
		return fail("an aa64 relocation should be rejected, not mis-patched")
	}
	return ""
}
