package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// (fail is in parse_elf_test.bn; u32/charsEqual in bytes.bn — same package.)

// writeLE writes the low n bytes little-endian, including for a negative value.
func TestWriteLE() testing.TestResult {
	var b @[]uint8 = make_slice(uint8, 8)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = b
	writeLE(b, 0, 0x05060708, 4)
	if u32(r, 0) != 0x05060708 { return fail("writeLE u32 wrong") }
	writeLE(b, 0, 0x01020304, 8) // high 4 bytes -> 0
	if u32(r, 0) != 0x01020304 { return fail("writeLE u64 low word wrong") }
	if u32(r, 4) != 0 { return fail("writeLE u64 high word should be zero") }
	writeLE(b, 0, 0 - 1, 4) // -1 -> 0xFFFFFFFF
	if b[0] != 0xff || b[1] != 0xff || b[2] != 0xff || b[3] != 0xff {
		return fail("writeLE of -1 should be all 0xff")
	}
	return ""
}

// End-to-end: object A calls an external "target" defined by object B.  After
// read -> resolve -> layout -> relocate, the patched PC-relative displacement must
// make the call land exactly on target's address.
func TestRelocateCrossObjectCall() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("caller")
	a.SetGlobal("caller")
	a.SetGlobal("target") // undefined external -> a PC-relative call relocation
	x64.Call(a, "target")
	x64.Ret(a)
	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error (A)") }
	if !elf.WriteX86_64(a, "/tmp/binate_link_relA.o") { return fail("write A failed") }

	var b @asm.Assembler = asm.New(8)
	b.SetSection("text", -1)
	b.DefineLabel("target")
	b.SetGlobal("target")
	x64.Ret(b)
	x64.ResolveFixups(b)
	b.Finalize()
	if b.HasError { return fail("assembler error (B)") }
	if !elf.WriteX86_64(b, "/tmp/binate_link_relB.o") { return fail("write B failed") }

	objA, ea := ReadObject("/tmp/binate_link_relA.o")
	if len(ea) != 0 { return fail("read A failed") }
	objB, eb := ReadObject("/tmp/binate_link_relB.o")
	if len(eb) != 0 { return fail("read B failed") }

	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = objA
	objs[1] = objB
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return fail("resolve failed") }
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	var perr @[]readonly char = Relocate(t, lr)
	if len(perr) != 0 { return fail("relocate failed") }

	if len(objA.Relocs) != 1 { return fail("expected one relocation in object A") }
	var rel InputReloc = objA.Relocs[0]
	var outIdx int = objA.Sections[rel.SecIndex].OutIndex
	var secOff uint = objA.Sections[rel.SecIndex].OutOffset
	var fieldAddr uint64 = lr.Sections[outIdx].Addr + cast(uint64, secOff) + cast(uint64, rel.Offset)

	// Independently derive target's address (not via symbolAddr): it is at the
	// start of object B's .text, merged into the single output .text section.
	var bTextIdx int = objB.Sections[0].OutIndex
	var expectedTarget uint64 = lr.Sections[bTextIdx].Addr + cast(uint64, objB.Sections[0].OutOffset)
	targetAddr, ok := symbolAddr(t, lr, 0, rel.SymIndex)
	if !ok { return fail("could not resolve target address") }
	if targetAddr != expectedTarget { return fail("symbolAddr returned the wrong target address") }

	// Decode the patched displacement and check the CPU's PC-relative rule:
	// (fieldAddr + 4) + disp must equal the independently-derived target address.
	var byteLoc int = cast(int, secOff + rel.Offset)
	var data @[]uint8 = lr.Sections[outIdx].Data
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	var disp int64 = cast(int64, u32(rd, byteLoc)) & 0xffffffff
	if disp >= 0x80000000 { disp = disp - 0x100000000 } // to signed
	var landing uint64 = cast(uint64, cast(int64, fieldAddr) + 4 + disp)
	if landing != expectedTarget { return fail("relocated call would not land on target") }
	return ""
}

// R_X86_64_64: an 8-byte absolute pointer to a defined symbol must be patched with
// that symbol's absolute address.
func TestRelocateAbs64() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("data", -1)
	a.DefineLabel("ptr")
	a.SetGlobal("ptr")
	a.EmitAddr("sym") // 8-byte absolute reference -> R_X86_64_64
	a.SetSection("text", -1)
	a.DefineLabel("sym")
	a.SetGlobal("sym")
	x64.Ret(a)
	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	if !elf.WriteX86_64(a, "/tmp/binate_link_abs64.o") { return fail("write failed") }

	obj, e := ReadObject("/tmp/binate_link_abs64.o")
	if len(e) != 0 { return fail("read failed") }
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return fail("resolve failed") }
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) != 0 { return fail("relocate failed") }

	if len(obj.Relocs) != 1 { return fail("expected one relocation") }
	var rel InputReloc = obj.Relocs[0]
	if rel.Kind != R_X86_64_64 { return fail("expected an R_X86_64_64 relocation") }
	var outIdx int = obj.Sections[rel.SecIndex].OutIndex
	var byteLoc int = cast(int, obj.Sections[rel.SecIndex].OutOffset + rel.Offset)
	var data @[]uint8 = lr.Sections[outIdx].Data
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	var stored int64 = u64(rd, byteLoc)
	// sym is the first byte of .text, which is the first (text-kind) output section
	// at the base — an independent expected value.
	if stored != 0x400000 { return fail("ABS64 stored the wrong address") }
	return ""
}

// A GOTPCRELX / REX_GOTPCRELX relocation — a GOT-indirect load of a symbol's
// address — is RELAXED to a direct lea in a static link: `mov sym@GOTPCREL(%rip),
// %rax` (48 8b 05 <disp>) becomes `lea sym(%rip),%rax` (48 8d 05 <disp>), the disp
// pointing straight at the symbol.
func TestRelocateRelaxesGotpcrelx() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 8)
	d[0] = 0x48 // REX.W
	d[1] = 0x8b // mov r64, r/m64
	d[2] = 0x05 // modrm: rax, [rip+disp32]
	// d[3:7] is the disp32 (0 placeholder); d[7] is the target datum (a ret).
	d[7] = 0xc3
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, d, cast(uint, 8), 1)
	var obj @InputObject = mkObjSecs(secs)
	obj.Symbols = make_slice(InputSymbol, 1)
	var target InputSymbol = mkSym("target", 0, BIND_GLOBAL)
	target.Value = cast(uint, 7) // the ret byte
	obj.Symbols[0] = target
	obj.Relocs = make_slice(InputReloc, 1)
	var rel InputReloc
	rel.SecIndex = 0
	rel.Offset = cast(uint, 3) // the disp32
	rel.SymIndex = 0
	rel.Kind = R_X86_64_REX_GOTPCRELX
	rel.Addend = 0 - 4 // the instruction-end adjustment the assembler bakes in
	obj.Relocs[0] = rel
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	t, _ := Resolve(objs)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) != 0 { return fail("the GOTPCRELX relaxation should succeed") }

	var out @[]uint8 = lr.Sections[0].Data
	if out[1] != 0x8d { return fail("the mov (0x8b) should be relaxed to lea (0x8d)") }
	// disp = target(base+7) + addend(-4) - P(base+3) = 0 -> lea rax,[rip+0] lands on
	// the target byte at base+7.
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = out
	var disp int64 = cast(int64, u32(r, 3)) & 0xffffffff
	if disp >= 0x80000000 { disp = disp - 0x100000000 }
	if disp != 0 { return fail("the relaxed lea disp should point at the target") }
	return ""
}

// A GOTPCRELX site whose instruction is not the relaxable mov (0x8b) form is
// rejected rather than mis-relaxed.
func TestRelocateGotpcrelxRejectsNonMov() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 8)
	d[0] = 0xff // an indirect call/jmp opcode, not a relaxable mov
	d[1] = 0x15
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, d, cast(uint, 8), 1)
	var obj @InputObject = mkObjSecs(secs)
	obj.Symbols = make_slice(InputSymbol, 1)
	obj.Symbols[0] = mkSym("target", 0, BIND_GLOBAL)
	obj.Relocs = make_slice(InputReloc, 1)
	var rel InputReloc
	rel.SecIndex = 0
	rel.Offset = cast(uint, 2) // disp32 at 2 -> opcode checked at offset 0 (0xff)
	rel.SymIndex = 0
	rel.Kind = R_X86_64_REX_GOTPCRELX
	rel.Addend = 0 - 4
	obj.Relocs[0] = rel
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	t, _ := Resolve(objs)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) == 0 { return fail("a non-mov GOTPCRELX form should be rejected") }
	return ""
}

// A GOTPCRELX whose opcode byte (byteLoc-2) would fall in a DIFFERENT input merged
// into the same output section (rel.Offset < 2) is rejected, not allowed to rewrite
// the neighbor.
func TestRelocateGotpcrelxGuardsSectionBoundary() testing.TestResult {
	var da @[]uint8 = make_slice(uint8, 2)
	da[0] = 0x90
	da[1] = 0x8b // objA's trailing byte, at merged output offset 1
	var secsA @[]InputSection = make_slice(InputSection, 1)
	secsA[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, da, cast(uint, 2), 1)
	var objA @InputObject = mkObjSecs(secsA)

	var db @[]uint8 = make_slice(uint8, 7)
	db[0] = 0x48
	db[1] = 0x8b
	db[2] = 0x05
	var secsB @[]InputSection = make_slice(InputSection, 1)
	secsB[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, db, cast(uint, 7), 1)
	var objB @InputObject = mkObjSecs(secsB)
	objB.Symbols = make_slice(InputSymbol, 1)
	objB.Symbols[0] = mkSym("target", 0, BIND_GLOBAL)
	objB.Relocs = make_slice(InputReloc, 1)
	var rel InputReloc
	rel.SecIndex = 0
	rel.Offset = cast(uint, 1) // malformed: byteLoc-2 lands in objA
	rel.SymIndex = 0
	rel.Kind = R_X86_64_REX_GOTPCRELX
	rel.Addend = 0 - 4
	objB.Relocs[0] = rel

	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = objA
	objs[1] = objB
	t, _ := Resolve(objs)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) == 0 {
		return fail("a GOTPCRELX whose opcode falls in another section must be rejected")
	}
	if lr.Sections[0].Data[1] != 0x8b {
		return fail("the relaxation corrupted a neighboring input section")
	}
	return ""
}

// An unknown relocation kind is rejected rather than silently ignored.
func TestRelocateRejectsUnknownKind() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 8)
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, d, cast(uint, 8), 1)
	var obj @InputObject = mkObjSecs(secs)
	obj.Symbols = make_slice(InputSymbol, 1)
	obj.Symbols[0] = mkSym("sym", 0, BIND_GLOBAL)
	obj.Relocs = make_slice(InputReloc, 1)
	var rel InputReloc
	rel.SecIndex = 0
	rel.Offset = cast(uint, 0)
	rel.SymIndex = 0
	rel.Kind = 9999
	rel.Addend = 0
	obj.Relocs[0] = rel
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	t, _ := Resolve(objs)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) == 0 { return fail("unknown relocation kind should be rejected") }
	return ""
}

// An AArch64 reloc kind (R_AARCH64_CALL26 = 283) carried by an x86-64 object (a
// malformed cross-arch input) is rejected by the x86 patcher, not mis-applied —
// aa64 LP64 kinds (>=257) never collide with x86's {1,2,4,42}.  (mkObjSecs makes an
// EM_X86_64 object, so Relocate dispatches to patchX64.)
func TestRelocateRejectsAArch64Reloc() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 8)
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, d, cast(uint, 8), 1)
	var obj @InputObject = mkObjSecs(secs)
	obj.Symbols = make_slice(InputSymbol, 1)
	obj.Symbols[0] = mkSym("target", 0, BIND_GLOBAL)
	obj.Relocs = make_slice(InputReloc, 1)
	var rel InputReloc
	rel.SecIndex = 0
	rel.Offset = cast(uint, 0)
	rel.SymIndex = 0
	rel.Kind = 283 // R_AARCH64_CALL26
	rel.Addend = 0
	obj.Relocs[0] = rel
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	t, _ := Resolve(objs)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) == 0 {
		return fail("an aa64 relocation should be rejected, not mis-patched")
	}
	return ""
}

// End-to-end AArch64: object A does `bl target`, object B defines target.  After
// linking, the patched BL's imm26 must make the branch (blAddr + imm26*4) land on
// target's address (the CPU's PC-relative rule for BL).  The assembler records
// FIX_BRANCH26 for both B and BL, so the ELF reloc is R_AARCH64_JUMP26 (the imm26
// patch math is identical for JUMP26 and CALL26).
func TestRelocateAArch64Branch() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("caller")
	a.SetGlobal("caller")
	a.SetGlobal("target") // undefined external -> R_AARCH64_JUMP26 (FIX_BRANCH26)
	aarch64.Bl(a, "target")
	aarch64.Ret(a)
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error (A)") }
	if !elf.WriteAArch64(a, "/tmp/binate_link_aa64_a.o") { return fail("write A failed") }

	var b @asm.Assembler = asm.New(8)
	b.SetSection("text", -1)
	b.DefineLabel("target")
	b.SetGlobal("target")
	aarch64.Ret(b)
	aarch64.ResolveFixups(b)
	b.Finalize()
	if b.HasError { return fail("assembler error (B)") }
	if !elf.WriteAArch64(b, "/tmp/binate_link_aa64_b.o") { return fail("write B failed") }

	objA, ea := ReadObject("/tmp/binate_link_aa64_a.o")
	if len(ea) != 0 { return fail("read A failed") }
	objB, eb := ReadObject("/tmp/binate_link_aa64_b.o")
	if len(eb) != 0 { return fail("read B failed") }
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = objA
	objs[1] = objB
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return fail("resolve failed") }
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) != 0 { return fail("relocate failed") }

	if len(objA.Relocs) != 1 { return fail("expected one relocation in object A") }
	var rel InputReloc = objA.Relocs[0]
	if rel.Kind != R_AARCH64_JUMP26 { return fail("expected an R_AARCH64_JUMP26 relocation") }
	var outIdx int = objA.Sections[rel.SecIndex].OutIndex
	var secOff uint = objA.Sections[rel.SecIndex].OutOffset
	var blAddr uint64 = lr.Sections[outIdx].Addr + cast(uint64, secOff) + cast(uint64, rel.Offset)

	var bTextIdx int = objB.Sections[0].OutIndex
	var targetAddr uint64 = lr.Sections[bTextIdx].Addr + cast(uint64, objB.Sections[0].OutOffset)

	var data @[]uint8 = lr.Sections[outIdx].Data
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	var insn int = cast(int, u32(rd, cast(int, secOff + rel.Offset)))
	var imm26 int = insn & 0x3ffffff
	if imm26 >= 0x2000000 { imm26 = imm26 - 0x4000000 } // sign-extend the 26-bit field
	var landing uint64 = cast(uint64, cast(int64, blAddr) + cast(int64, imm26 * 4))
	if landing != targetAddr { return fail("aa64 BL would not land on target") }
	return ""
}

// End-to-end AArch64 R_AARCH64_ABS64: an 8-byte absolute pointer to a defined
// symbol is patched with the symbol's absolute address.
func TestRelocateAArch64Abs64() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("data", -1)
	a.DefineLabel("ptr")
	a.SetGlobal("ptr")
	a.EmitAddr("sym") // 8-byte absolute reference -> R_AARCH64_ABS64
	a.SetSection("text", -1)
	a.DefineLabel("sym")
	a.SetGlobal("sym")
	aarch64.Ret(a)
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	if !elf.WriteAArch64(a, "/tmp/binate_link_aa64_abs.o") { return fail("write failed") }

	obj, e := ReadObject("/tmp/binate_link_aa64_abs.o")
	if len(e) != 0 { return fail("read failed") }
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return fail("resolve failed") }
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) != 0 { return fail("relocate failed") }

	if len(obj.Relocs) != 1 { return fail("expected one relocation") }
	var rel InputReloc = obj.Relocs[0]
	if rel.Kind != R_AARCH64_ABS64 { return fail("expected an R_AARCH64_ABS64 relocation") }
	var outIdx int = obj.Sections[rel.SecIndex].OutIndex
	var byteLoc int = cast(int, obj.Sections[rel.SecIndex].OutOffset + rel.Offset)
	var data @[]uint8 = lr.Sections[outIdx].Data
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	var stored int64 = u64(rd, byteLoc)
	// sym is at .text offset 0 -> the base (text is the first output section).
	if stored != 0x400000 { return fail("aa64 ABS64 stored the wrong address") }
	return ""
}

// rangeCase asserts patchAArch64(kind) accepts the field's max (hi) and min (lo)
// signed displacements but rejects hi+step and lo-step, where step is the field's
// scale (4 for the ×4-scaled branch fields, 1 for ADR's byte field).  s/p are byte
// addresses, so a displacement d is produced with s=d, p=0 (positive) or s=0, p=-d.
func rangeCase(word @[]uint8, kind int, hi int, lo int) bool {
	var step int = 4
	if kind == R_AARCH64_ADR_PREL_LO21 { step = 1 }
	if len(patchAArch64(word, 0, kind, 0, cast(uint64, hi), cast(uint64, 0), "s", "o", false)) != 0 {
		return false
	}
	if len(patchAArch64(word, 0, kind, 0, cast(uint64, 0), cast(uint64, 0 - lo), "s", "o", false)) !=
			0 {
		return false
	}
	if len(patchAArch64(word, 0, kind, 0, cast(uint64, hi + step), cast(uint64, 0), "s", "o",
			false)) == 0 {
		return false
	}
	if len(
			patchAArch64(word, 0, kind, 0, cast(uint64, 0), cast(uint64, (0 - lo) + step), "s", "o",
					false)) == 0 {
		return false
	}
	return true
}

// The PC-relative AArch64 relocs whose fields can overflow must reject an
// out-of-range displacement rather than silently truncate it (which would branch
// or address the wrong place at runtime).  Each field's true signed bounds are
// exercised at the boundary: max and min patch; one step past either is rejected.
func TestRelocateAArch64RangeChecks() testing.TestResult {
	var word @[]uint8 = make_slice(uint8, 8)
	if !rangeCase(word, R_AARCH64_TSTBR14, 0x7ffc, 0 - 0x8000) { return fail("TSTBR14 range check") }
	if !rangeCase(word, R_AARCH64_CONDBR19, 0xffffc, 0 - 0x100000) {
		return fail("CONDBR19 range check")
	}
	if !rangeCase(word, R_AARCH64_ADR_PREL_LO21, 0xfffff, 0 - 0x100000) {
		return fail("ADR range check")
	}
	// ADRP's field is a signed 21-bit page count (±4GB); step is one page (0x1000).
	// An in-range span of 0xfffff pages patches; a >4GB span (0x100000 pages) errors.
	if len(
			patchAArch64(word, 0, R_AARCH64_ADR_PREL_PG_HI21, 0, cast(uint64, 0xfffff000), cast(uint64, 0),
					"s", "o", false)) != 0 {
		return fail("in-range ADRP should patch")
	}
	if len(
			patchAArch64(word, 0, R_AARCH64_ADR_PREL_PG_HI21, 0, cast(uint64, 0x100000000), cast(uint64, 0),
					"s", "o", false)) == 0 {
		return fail("out-of-range ADRP should be rejected")
	}
	return ""
}

// R_AARCH64_PREL32 stores a 32-bit PC-relative displacement S + A - P.
func TestPatchAArch64Prel32() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 4)
	var e @[]readonly char = patchAArch64(d, 0, R_AARCH64_PREL32, 0, cast(uint64, 0x1008),
			cast(uint64, 0x1000), "sym", "obj", false)
	if len(e) != 0 { return fail("PREL32 should succeed") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = d
	if u32(r, 0) != 8 { return fail("PREL32 should store S + A - P = 8") }
	return ""
}

// A backward (negative) PREL32 stores the two's-complement low 32 bits, and the
// widened upper bound (ABI [-2^31, 2^32)) is not wrongly tripped.
func TestPatchAArch64Prel32Negative() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 4)
	// s=0x1000, p=0x1010 -> v = -0x10.
	var e @[]readonly char = patchAArch64(d, 0, R_AARCH64_PREL32, 0, cast(uint64, 0x1000),
			cast(uint64, 0x1010), "sym", "obj", false)
	if len(e) != 0 { return fail("a negative PREL32 should succeed") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = d
	if (cast(int64, u32(r, 0)) & 0xffffffff) != 0xfffffff0 {
		return fail("PREL32 should store two's-complement -0x10")
	}
	return ""
}
