package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/elf"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// A reference to a weak symbol binds to the definition the symbol table chose, even when
// the referencing object defines a copy of its own: a strong definition elsewhere wins, and
// every reference to link-once weak copies reaches the one kept (symbolAddr).  (fail is in
// parse_elf_test.bn, testTmpDir in link_test.bn, fieldWord / branchTarget in
// relocate_arm32_test.bn, mkSection in layout_test.bn, mkSym in resolve_test.bn, mkReloc in
// builder_emit_test.bn.)

// weakObj writes an arm32 object to dir/name defining w (weak, or strong global) as a
// function and referring to it from `caller` with a BL and from a data word, returning the
// path or "" on failure.
func weakObj(dir *[]readonly char, name *[]readonly char, strong bool) @[]char {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	arm32.Nop(a) // w is not at its section's start, so its value must be added
	a.DefineLabel("w")
	if strong {
		a.SetGlobal("w")
	} else {
		a.SetWeak("w")
	}
	arm32.Bx(a, arm32.COND_AL, arm32.LR)
	a.DefineLabel("caller")
	arm32.Bl(a, arm32.COND_AL, "w")
	a.SetSection("data", -1)
	a.AddFixup("w", 0, 0, 4)
	a.Fill(4, cast(uint8, 0))
	if !arm32.ResolveFixups(a) { return "" }
	a.Finalize()
	if a.HasError { return "" }
	var path @[]char = buf.Concat(buf.Concat(dir, "/"), name)
	if !elf.WriteARM32(a, path, false) { return "" }
	return path
}

// linkWeakPair links the two objects at paths, returning them, the table and the layout.
func linkWeakPair(pathA *[]readonly char,
		pathB *[]readonly char) (@[]@InputObject, @SymbolTable, @LayoutResult, bool) {
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	var none @SymbolTable
	var noLr @LayoutResult
	oa, ea := ReadObject(pathA)
	ob, eb := ReadObject(pathB)
	if len(ea) != 0 || len(eb) != 0 { return objs, none, noLr, false }
	objs[0] = oa
	objs[1] = ob
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return objs, none, noLr, false }
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x8000))
	if len(Relocate(t, lr)) != 0 { return objs, t, lr, false }
	return objs, t, lr, true
}

// weakRefsLandOn reports whether obj's BL and data word referring to w both reach target.
func weakRefsLandOn(obj @InputObject, lr @LayoutResult, target uint64) bool {
	bl, blAddr, ok1 := fieldWord(obj, lr, "w", R_ARM_CALL)
	word, _, ok2 := fieldWord(obj, lr, "w", R_ARM_ABS32)
	return ok1 && ok2 && branchTarget(bl, blAddr) == target && cast(uint64, word) == target
}

// Object A defines a weak w and calls / takes the address of it; object B defines a strong
// w.  Every reference — A's own included — reaches B's w.
func TestWeakRefsBindToStrongDefinition() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var pa @[]char = weakObj(dir, "weak_a.o", false)
	var pb @[]char = weakObj(dir, "strong_b.o", true)
	if len(pa) == 0 || len(pb) == 0 { return fail("cannot build the objects") }
	objs, t, lr, ok := linkWeakPair(pa, pb)
	if !ok { return fail("link failed") }
	oo, ss, found := t.Lookup("w")
	if !found || oo != 1 { return fail("the strong w in B is not the chosen definition") }
	strongW, sok := definedAddr(t, lr, oo, ss)
	if !sok { return fail("cannot place B's w") }
	if !weakRefsLandOn(objs[0], lr, strongW) { return fail("A's references stay on its weak copy") }
	if !weakRefsLandOn(objs[1], lr, strongW) { return fail("B's references miss its w") }
	return ""
}

// Object A defines a strong w and object B a weak one: the strong w is chosen though it
// comes first, and B's own references reach it.
func TestWeakRefsBindToEarlierStrongDefinition() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var pa @[]char = weakObj(dir, "strong_a.o", true)
	var pb @[]char = weakObj(dir, "weak_b.o", false)
	if len(pa) == 0 || len(pb) == 0 { return fail("cannot build the objects") }
	objs, t, lr, ok := linkWeakPair(pa, pb)
	if !ok { return fail("link failed") }
	oo, ss, found := t.Lookup("w")
	if !found || oo != 0 { return fail("the strong w in A is not the chosen definition") }
	strongW, sok := definedAddr(t, lr, oo, ss)
	if !sok { return fail("cannot place A's w") }
	if !weakRefsLandOn(objs[0], lr, strongW) { return fail("A's references miss its w") }
	if !weakRefsLandOn(objs[1], lr, strongW) { return fail("B's references stay on its weak copy") }
	return ""
}

// Both objects define a weak w: the first is kept, and B's references reach it too.
func TestWeakRefsBindToTheKeptCopy() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var pa @[]char = weakObj(dir, "weak_a.o", false)
	var pb @[]char = weakObj(dir, "weak_b.o", false)
	if len(pa) == 0 || len(pb) == 0 { return fail("cannot build the objects") }
	objs, t, lr, ok := linkWeakPair(pa, pb)
	if !ok { return fail("link failed") }
	oo, ss, found := t.Lookup("w")
	if !found || oo != 0 { return fail("A's w is not the kept copy") }
	keptW, kok := definedAddr(t, lr, oo, ss)
	if !kok { return fail("cannot place A's w") }
	if !weakRefsLandOn(objs[0], lr, keptW) { return fail("A's references miss its w") }
	if !weakRefsLandOn(objs[1], lr, keptW) { return fail("B's references stay on its own copy") }
	return ""
}

// weakDefObj builds an x86-64 object defining a weak w at the start of a section named
// secName and a .text.ref holding, when ref is set, an absolute reference to w.
func weakDefObj(path *[]readonly char, secName *[]readonly char, ref bool) @InputObject {
	var secs @[]InputSection = make_slice(InputSection, 2)
	secs[0] = mkSection(secName, SF_READ | SF_EXEC, SHT_PROGBITS, make_slice(uint8, 8), cast(uint, 8),
			1)
	secs[1] = mkSection(".text.ref", SF_READ | SF_EXEC, SHT_PROGBITS, make_slice(uint8, 8),
			cast(uint, 8), 1)
	var syms @[]InputSymbol = make_slice(InputSymbol, 1)
	syms[0] = mkSym("w", 0, BIND_WEAK)
	var nRel int = 0
	if ref { nRel = 1 }
	var relocs @[]InputReloc = make_slice(InputReloc, nRel)
	if ref { relocs[0] = mkReloc(1, cast(uint, 0), 0, R_X86_64_64, 0) }
	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr(path)
	obj.Machine = EM_X86_64
	obj.Sections = secs
	obj.Symbols = syms
	obj.Relocs = relocs
	return obj
}

// Under a scripted layout, A's kept weak w sits in a section the driver leaves unplaced
// while B's own copy is placed: B's reference binds to the kept copy, which has no
// address, so the link fails loud (as GNU ld rejects a reference to a symbol defined in a
// discarded section) rather than quietly using B's copy.
func TestWeakRefToUnplacedKeptCopyErrors() testing.TestResult {
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = weakDefObj("a.o", ".orphan", false)
	objs[1] = weakDefObj("b.o", ".text", true)
	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)
	b.SetDot(cast(uint64, 0x400000))
	b.BeginSection(".text", SF_READ | SF_EXEC)
	b.Place("*(.text*)", false) // a.o's .orphan is deliberately never placed
	b.EndSection()
	if len(b.Finish()) == 0 { return fail("a reference to an unplaced kept copy must fail loud") }
	return ""
}
