package "pkg/binate/link"

import "pkg/binate/buf"

// patchX64 applies an x86-64 relocation at byteLoc: R_X86_64_64 / 32 / 32S / 16 / 8 (S +
// A, absolute, of their widths), R_X86_64_PC64 / PC16 / PC8 (S + A - P, PC-relative data)
// and R_X86_64_PC32 / R_X86_64_PLT32 (S + A - P, 32-bit PC-relative; PLT32 patched as PC32
// for a statically-resolved symbol).  Returns "" or an error
// (unsupported/GOT kind, out-of-range offset, or a displacement that does not fit
// a signed 32-bit field).
func patchX64(data @[]uint8, byteLoc int, secStart int, kind int, addend int, s uint64, p uint64,
		symName *[]readonly char, objPath *[]readonly char, gotImp bool) @[]readonly char {
	if kind == R_X86_64_REX_GOTPCRELX || kind == R_X86_64_GOTPCRELX {
		return patchGotpcrelx(data, byteLoc, secStart, addend, s, p, symName, objPath, gotImp)
	}
	var width int = 0
	if kind == R_X86_64_64 || kind == R_X86_64_PC64 {
		width = 8
	} else if kind == R_X86_64_PC16 {
		width = 2
	} else if kind == R_X86_64_PC8 {
		width = 1
	} else if kind == R_X86_64_PC32 || kind == R_X86_64_PLT32 || kind == R_X86_64_32 ||
			kind == R_X86_64_32S {
		width = 4
	} else if kind == R_X86_64_16 {
		width = 2
	} else if kind == R_X86_64_8 {
		width = 1
	} else {
		return buf.Concat("unsupported relocation in ", objPath)
	}
	if byteLoc < 0 || byteLoc + width > len(data) {
		return buf.Concat("relocation offset out of range in ", objPath)
	}
	var abs int64 = cast(int64, s) + cast(int64, addend)
	// The absolute data relocations' overflow classes: 32 unsigned, 32S signed, 16 and 8
	// signed or unsigned.
	if kind == R_X86_64_32 {
		return patchData(data, byteLoc, 4, abs, 0, 0xffffffff, "R_X86_64_32", symName)
	}
	if kind == R_X86_64_32S {
		return patchData(data, byteLoc, 4, abs, 0 - 0x80000000, 0x7fffffff, "R_X86_64_32S", symName)
	}
	if kind == R_X86_64_16 {
		return patchData(data, byteLoc, 2, abs, -32768, 65535, "R_X86_64_16", symName)
	}
	if kind == R_X86_64_8 { return patchData(data, byteLoc, 1, abs, -128, 255, "R_X86_64_8", symName) }
	// The PC-relative data relocations: PC8 and PC16 signed; PC64 unchecked.
	var rel int64 = abs - cast(int64, p)
	if kind == R_X86_64_PC8 {
		return patchData(data, byteLoc, 1, rel, -128, 127, "R_X86_64_PC8", symName)
	}
	if kind == R_X86_64_PC16 {
		return patchData(data, byteLoc, 2, rel, -32768, 32767, "R_X86_64_PC16", symName)
	}
	if kind == R_X86_64_PC64 {
		writeU64(data, byteLoc, cast(uint64, rel))
		return ""
	}
	if width == 8 {
		writeU64(data, byteLoc, cast(uint64, abs))
	} else {
		var val int64 = abs - cast(int64, p)
		if val > 0x7fffffff || val < (0 - 0x80000000) {
			return buf.Concat("relocation out of range for ", symName)
		}
		writeU32(data, byteLoc, val)
	}
	return ""
}

// patchGotpcrelx patches a GOTPCRELX / REX_GOTPCRELX relocation — a GOT-indirect load
// of a symbol's address via `mov sym@GOTPCREL(%rip), %reg` (opcode 0x8b).  For a
// *defined* symbol (static link, gotImp=false) it RELAXES the load to a direct
// address computation `lea sym(%rip), %reg` (opcode 0x8d): the opcode byte sits two
// bytes before the disp32 (…, opcode, modrm, disp32), so it flips it and patches the
// disp32 as a PC-relative reference to the symbol (S + A - P; the addend already
// carries the -4 instruction-end adjustment).  For a dynamic *data import*
// (gotImp=true) it KEEPS the load — s is the symbol's GOT slot, filled by ld.so via
// GLOB_DAT — leaving the mov and patching the disp32 to reach the slot.  Any other
// opcode at a GOTPCRELX site (a non-mov relaxable form, or a GOT-materialization we
// do not model) is rejected rather than mis-patched.
func patchGotpcrelx(data @[]uint8, byteLoc int, secStart int, addend int, s uint64, p uint64,
		symName *[]readonly char, objPath *[]readonly char, gotImp bool) @[]readonly char {
	// The opcode byte (byteLoc - 2) must lie within this reloc's own input section
	// [secStart, ...) — i.e. rel.Offset >= 2 — so a malformed reloc cannot rewrite a
	// byte of a different input merged into the same output section.
	if byteLoc - 2 < secStart || byteLoc + 4 > len(data) {
		return buf.Concat("relocation offset out of range in ", objPath)
	}
	if data[byteLoc - 2] != 0x8b {
		return buf.Concat("unsupported GOTPCRELX form (only mov) in ", objPath)
	}
	if !gotImp {
		data[byteLoc - 2] = 0x8d // mov -> lea (relax: the symbol is defined)
	}
	// gotImp: leave the mov (0x8b) so it loads the GOT slot at s.
	var val int64 = cast(int64, s) + cast(int64, addend) - cast(int64, p)
	if val > 0x7fffffff || val < (0 - 0x80000000) {
		return buf.Concat("relocation out of range for ", symName)
	}
	writeU32(data, byteLoc, val)
	return ""
}
