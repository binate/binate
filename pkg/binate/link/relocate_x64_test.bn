package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// (fail is in parse_elf_test.bn; u32/charsEqual in bytes.bn — same package.)

// R_X86_64_64: an 8-byte absolute pointer to a defined symbol must be patched with
// that symbol's absolute address.
func TestRelocateAbs64() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("data", -1)
	a.DefineLabel("ptr")
	a.SetGlobal("ptr")
	a.EmitAddr("sym") // 8-byte absolute reference -> R_X86_64_64
	a.SetSection("text", -1)
	a.DefineLabel("sym")
	a.SetGlobal("sym")
	x64.Ret(a)
	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	if !elf.WriteX86_64(a, buf.Concat(dir, "/link_abs64.o")) { return fail("write failed") }

	obj, e := ReadObject(buf.Concat(dir, "/link_abs64.o"))
	if len(e) != 0 { return fail("read failed") }
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return fail("resolve failed") }
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) != 0 { return fail("relocate failed") }

	if len(obj.Relocs) != 1 { return fail("expected one relocation") }
	var rel InputReloc = obj.Relocs[0]
	if rel.Kind != R_X86_64_64 { return fail("expected an R_X86_64_64 relocation") }
	var outIdx int = obj.Sections[rel.SecIndex].OutIndex
	var byteLoc int = cast(int, obj.Sections[rel.SecIndex].OutOffset + rel.Offset)
	var data @[]uint8 = lr.Sections[outIdx].Data
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = data
	var stored int64 = u64(rd, byteLoc)
	// sym is the first byte of .text, which is the first (text-kind) output section
	// at the base — an independent expected value.
	if stored != 0x400000 { return fail("ABS64 stored the wrong address") }
	return ""
}

// A GOTPCRELX / REX_GOTPCRELX relocation — a GOT-indirect load of a symbol's
// address — is RELAXED to a direct lea in a static link: `mov sym@GOTPCREL(%rip),
// %rax` (48 8b 05 <disp>) becomes `lea sym(%rip),%rax` (48 8d 05 <disp>), the disp
// pointing straight at the symbol.
func TestRelocateRelaxesGotpcrelx() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 8)
	d[0] = 0x48 // REX.W
	d[1] = 0x8b // mov r64, r/m64
	d[2] = 0x05 // modrm: rax, [rip+disp32]
	// d[3:7] is the disp32 (0 placeholder); d[7] is the target datum (a ret).
	d[7] = 0xc3
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, d, cast(uint, 8), 1)
	var obj @InputObject = mkObjSecs(secs)
	obj.Symbols = make_slice(InputSymbol, 1)
	var target InputSymbol = mkSym("target", 0, BIND_GLOBAL)
	target.Value = cast(uint, 7) // the ret byte
	obj.Symbols[0] = target
	obj.Relocs = make_slice(InputReloc, 1)
	var rel InputReloc
	rel.SecIndex = 0
	rel.Offset = cast(uint, 3) // the disp32
	rel.SymIndex = 0
	rel.Kind = R_X86_64_REX_GOTPCRELX
	rel.Addend = 0 - 4 // the instruction-end adjustment the assembler bakes in
	obj.Relocs[0] = rel
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	t, _ := Resolve(objs)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) != 0 { return fail("the GOTPCRELX relaxation should succeed") }

	var out @[]uint8 = lr.Sections[0].Data
	if out[1] != 0x8d { return fail("the mov (0x8b) should be relaxed to lea (0x8d)") }
	// disp = target(base+7) + addend(-4) - P(base+3) = 0 -> lea rax,[rip+0] lands on
	// the target byte at base+7.
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var r *[]readonly uint8 = out
	var disp int64 = cast(int64, u32(r, 3)) & 0xffffffff
	if disp >= 0x80000000 { disp = disp - 0x100000000 }
	if disp != 0 { return fail("the relaxed lea disp should point at the target") }
	return ""
}

// A GOTPCRELX site whose instruction is not the relaxable mov (0x8b) form is
// rejected rather than mis-relaxed.
func TestRelocateGotpcrelxRejectsNonMov() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 8)
	d[0] = 0xff // an indirect call/jmp opcode, not a relaxable mov
	d[1] = 0x15
	var secs @[]InputSection = make_slice(InputSection, 1)
	secs[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, d, cast(uint, 8), 1)
	var obj @InputObject = mkObjSecs(secs)
	obj.Symbols = make_slice(InputSymbol, 1)
	obj.Symbols[0] = mkSym("target", 0, BIND_GLOBAL)
	obj.Relocs = make_slice(InputReloc, 1)
	var rel InputReloc
	rel.SecIndex = 0
	rel.Offset = cast(uint, 2) // disp32 at 2 -> opcode checked at offset 0 (0xff)
	rel.SymIndex = 0
	rel.Kind = R_X86_64_REX_GOTPCRELX
	rel.Addend = 0 - 4
	obj.Relocs[0] = rel
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	t, _ := Resolve(objs)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) == 0 { return fail("a non-mov GOTPCRELX form should be rejected") }
	return ""
}

// A GOTPCRELX whose opcode byte (byteLoc-2) would fall in a DIFFERENT input merged
// into the same output section (rel.Offset < 2) is rejected, not allowed to rewrite
// the neighbor.
func TestRelocateGotpcrelxGuardsSectionBoundary() testing.TestResult {
	var da @[]uint8 = make_slice(uint8, 2)
	da[0] = 0x90
	da[1] = 0x8b // objA's trailing byte, at merged output offset 1
	var secsA @[]InputSection = make_slice(InputSection, 1)
	secsA[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, da, cast(uint, 2), 1)
	var objA @InputObject = mkObjSecs(secsA)

	var db @[]uint8 = make_slice(uint8, 7)
	db[0] = 0x48
	db[1] = 0x8b
	db[2] = 0x05
	var secsB @[]InputSection = make_slice(InputSection, 1)
	secsB[0] = mkSection(".text", SF_READ | SF_EXEC, SHT_PROGBITS, db, cast(uint, 7), 1)
	var objB @InputObject = mkObjSecs(secsB)
	objB.Symbols = make_slice(InputSymbol, 1)
	objB.Symbols[0] = mkSym("target", 0, BIND_GLOBAL)
	objB.Relocs = make_slice(InputReloc, 1)
	var rel InputReloc
	rel.SecIndex = 0
	rel.Offset = cast(uint, 1) // malformed: byteLoc-2 lands in objA
	rel.SymIndex = 0
	rel.Kind = R_X86_64_REX_GOTPCRELX
	rel.Addend = 0 - 4
	objB.Relocs[0] = rel

	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = objA
	objs[1] = objB
	t, _ := Resolve(objs)
	var lr @LayoutResult = Layout(objs, cast(uint64, 0x400000))
	if len(Relocate(t, lr)) == 0 {
		return fail("a GOTPCRELX whose opcode falls in another section must be rejected")
	}
	if lr.Sections[0].Data[1] != 0x8b {
		return fail("the relaxation corrupted a neighboring input section")
	}
	return ""
}
