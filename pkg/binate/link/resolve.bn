package "pkg/binate/link"

import "pkg/binate/buf"

// SymDef records the winning definition of a global symbol name: which added
// object defines it, the symbol index within that object, and its binding
// (BIND_GLOBAL or BIND_WEAK).  A strong (global) definition overrides a weak one.
type SymDef struct {
	Name    @[]char
	ObjIdx  int
	SymIdx  int
	Binding int
}

// SymbolTable is the result of resolving a set of objects: the input objects plus
// the resolved global definitions.  Lookup finds a name's defining object/symbol.
type SymbolTable struct {
	Objs @[]@InputObject
	Defs @[]SymDef
}

// findDefIdx returns the index in defs[0:n] of the entry named name, or -1.
func findDefIdx(defs @[]SymDef, n int, name *[]readonly char) int {
	for i := 0; i < n; i++ {
		if charsEqual(defs[i].Name, name) { return i }
	}
	return -1
}

// nameIndex returns the index of name in the first n entries of names, or -1.
// Used to de-duplicate the undefined-symbol list (one name may be referenced by
// several objects).
func nameIndex(names @[]@[]char, n int, name *[]readonly char) int {
	for i := 0; i < n; i++ {
		if charsEqual(names[i], name) { return i }
	}
	return -1
}

// Lookup returns the object index and symbol index that define name, and whether
// a definition was found.  (Linear scan for now; a hashed index over Defs is a
// follow-up once the symbol counts warrant it.)
func (t @SymbolTable) Lookup(name *[]readonly char) (int, int, bool) {
	var i int = findDefIdx(t.Defs, len(t.Defs), name)
	if i < 0 { return -1, -1, false }
	return t.Defs[i].ObjIdx, t.Defs[i].SymIdx, true
}

// Resolve builds the global symbol table over objs and verifies that every
// referenced symbol is defined.  Rules: a strong (global) definition overrides a
// weak one; two strong definitions of the same name are a duplicate-symbol error;
// an undefined non-weak symbol with no definition is an unresolved-symbol error
// (a weak undefined reference is allowed and resolves to address 0).  Returns the
// table and "" on success, or the table and a non-empty error: every distinct
// undefined symbol is named (so a link failure is fixed in one pass, not one
// symbol per re-link), or the first duplicate.  The table is unusable when the
// error is non-empty.  Local symbols do not participate in cross-object resolution.
func Resolve(objs @[]@InputObject) (@SymbolTable, @[]readonly char) {
	var t @SymbolTable = make(SymbolTable)
	t.Objs = objs

	// Over-allocate: at most one definition per symbol across all objects.
	var maxDefs int = 0
	for o := 0; o < len(objs); o++ { maxDefs = maxDefs + len(objs[o].Symbols) }
	var defs @[]SymDef = make_slice(SymDef, maxDefs)
	var nDefs int = 0

	// Collect definitions, applying strong-over-weak precedence and flagging a
	// strong/strong collision.
	for o := 0; o < len(objs); o++ {
		var obj @InputObject = objs[o]
		for s := 0; s < len(obj.Symbols); s++ {
			var sym InputSymbol = obj.Symbols[s]
			if sym.SecIndex < 0 { continue } // undefined -> not a definition here
			if sym.Binding != BIND_GLOBAL && sym.Binding != BIND_WEAK { continue }
			if len(sym.Name) == 0 { continue }
			var existing int = findDefIdx(defs, nDefs, sym.Name)
			if existing < 0 {
				var d SymDef
				d.Name = sym.Name
				d.ObjIdx = o
				d.SymIdx = s
				d.Binding = sym.Binding
				defs[nDefs] = d
				nDefs = nDefs + 1
			} else if defs[existing].Binding == BIND_GLOBAL && sym.Binding == BIND_GLOBAL {
				// Name both colliding objects — the actionable detail when linking a
				// large object graph (which one to fix / drop).
				var msg @[]char = buf.Concat("duplicate symbol: ", sym.Name)
				msg = buf.Concat(msg, " (defined in ")
				msg = buf.Concat(msg, objs[defs[existing].ObjIdx].Path)
				msg = buf.Concat(msg, " and ")
				msg = buf.Concat(msg, obj.Path)
				return t, buf.Concat(msg, ")")
			} else if defs[existing].Binding == BIND_WEAK && sym.Binding == BIND_GLOBAL {
				defs[existing].ObjIdx = o
				defs[existing].SymIdx = s
				defs[existing].Binding = BIND_GLOBAL
			}
		}
	}
	t.Defs = defs[0:nDefs]

	// Every undefined non-weak reference must have a definition.  Collect ALL
	// distinct undefined GLOBAL names (not just the first) so a link failure names
	// every missing symbol in one pass rather than one per re-link.  Skip locals
	// (e.g. STT_FILE, which the reader folds to SecIndex -1) and weak undefined
	// references (which resolve to address 0) — matching pass 1, which only collects
	// global/weak definitions.
	var undef @[]@[]char = make_slice(@[]char, maxDefs) // >= the number of refs
	var nUndef int = 0
	for o := 0; o < len(objs); o++ {
		var obj @InputObject = objs[o]
		for s := 0; s < len(obj.Symbols); s++ {
			var sym InputSymbol = obj.Symbols[s]
			if sym.SecIndex >= 0 { continue } // defined
			if len(sym.Name) == 0 { continue } // the null symbol
			if sym.Binding != BIND_GLOBAL { continue }
			if findDefIdx(t.Defs, len(t.Defs), sym.Name) >= 0 { continue } // resolved
			if nameIndex(undef, nUndef, sym.Name) < 0 {
				// not already listed
				undef[nUndef] = sym.Name
				nUndef = nUndef + 1
			}
		}
	}
	if nUndef > 0 {
		var list @[]char = undef[0]
		for i := 1; i < nUndef; i++ { list = buf.Concat(buf.Concat(list, ", "), undef[i]) }
		if nUndef == 1 { return t, buf.Concat("undefined symbol: ", list) }
		return t, buf.Concat("undefined symbols: ", list)
	}
	return t, ""
}
