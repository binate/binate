package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// A global or weak absolute symbol is a definition wherever the linker asks whether a name
// is defined: archive selection, the dynamic import list, and a common of the same name.
// (mkObj/mkSym are in resolve_test.bn, mkUndefObj in dynlink_test.bn, mkCommon in
// builder_common_test.bn, absValue in builder_symbols_test.bn, fail in parse_elf_test.bn.)

// mkAbsSym builds an absolute InputSymbol of value 0x1234 with binding bind.
func mkAbsSym(name *[]readonly char, bind int) InputSymbol {
	var s InputSymbol = mkSym(name, -1, bind)
	s.Abs = true
	s.AbsValue = 0x1234
	return s
}

// oneSym returns a one-element symbol slice holding s.
func oneSym(s InputSymbol) @[]InputSymbol {
	var syms @[]InputSymbol = make_slice(InputSymbol, 1)
	syms[0] = s
	return syms
}

// An archive member defining a needed symbol absolutely is pulled; a member defining a
// symbol a linked object already defines absolutely (strong or weak) is not.
func TestSelectMembersAbsolute() testing.TestResult {
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObj("main.o", oneSym(mkSym("k", -1, BIND_GLOBAL)))
	var members @[]@InputObject = make_slice(@InputObject, 1)
	members[0] = mkObj("lib.a(k.o)", oneSym(mkAbsSym("k", BIND_GLOBAL)))
	var archives @[]@[]@InputObject = make_slice(@[]@InputObject, 1)
	archives[0] = members
	if len(selectMembers(objs, archives)) != 2 { return fail("the absolute k's member not pulled") }

	for b := 0; b < 2; b++ {
		var bind int = BIND_GLOBAL
		if b == 1 { bind = BIND_WEAK }
		var objs2 @[]@InputObject = make_slice(@InputObject, 2)
		objs2[0] = mkObj("main.o", oneSym(mkSym("k", -1, BIND_GLOBAL)))
		objs2[1] = mkObj("abs.o", oneSym(mkAbsSym("k", bind)))
		var members2 @[]@InputObject = make_slice(@InputObject, 1)
		members2[0] = mkObj("lib.a(k.o)", oneSym(mkSym("k", 0, BIND_GLOBAL)))
		var archives2 @[]@[]@InputObject = make_slice(@[]@InputObject, 1)
		archives2[0] = members2
		if len(selectMembers(objs2, archives2)) != 2 {
			return fail("a member pulled for a name already defined absolutely")
		}
	}
	return ""
}

// A name some object defines absolutely is no dynamic import, and neither is the absolute
// symbol itself.
func TestCollectImportsSkipsAbsolute() testing.TestResult {
	var names @[]@[]char = make_slice(@[]char, 1)
	names[0] = buf.CopyStr("k")
	var binds @[]int = make_slice(int, 1)
	binds[0] = BIND_GLOBAL
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkUndefObj(names, binds)
	objs[1] = mkObj("abs.o", oneSym(mkAbsSym("k", BIND_WEAK)))
	gotNames, _ := collectImports(objs)
	if len(gotNames) != 0 { return fail("an absolutely defined name imported") }
	return ""
}

// A global absolute definition supersedes a common of the same name, which is then not
// allocated; a local one does not.
func TestPlaceCommonAbsoluteDefWins() testing.TestResult {
	for b := 0; b < 2; b++ {
		var syms @[]InputSymbol = make_slice(InputSymbol, 2)
		syms[0] = mkAbsSym("x", BIND_GLOBAL)
		if b == 1 { syms[0] = mkAbsSym("x", 0) }
		syms[1] = mkCommon("x", cast(uint, 8), cast(uint, 8))
		var obj @InputObject = make(InputObject)
		obj.Path = buf.CopyStr("x.o")
		obj.Machine = EM_X86_64
		obj.Sections = make_slice(InputSection, 0)
		obj.Symbols = syms
		obj.Relocs = make_slice(InputReloc, 0)
		var objs @[]@InputObject = make_slice(@InputObject, 1)
		objs[0] = obj
		var lb @LayoutBuilder = NewLayout(EM_X86_64)
		lb.SetInputs(objs)
		lb.SetDot(cast(uint64, 0x2000))
		lb.BeginSection(".bss", SF_READ | SF_WRITE)
		lb.Place("*(COMMON)", false)
		lb.EndSection()
		if len(lb.Error()) != 0 { return fail("unexpected error") }
		_, xIsCommon := absValue(lb.AbsSyms(), "x")
		if b == 0 && xIsCommon { return fail("a common allocated beside a global absolute x") }
		if b == 1 && !xIsCommon { return fail("a local absolute x suppressed the global common") }
	}
	return ""
}
