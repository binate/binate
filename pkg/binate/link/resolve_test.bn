package "pkg/binate/link"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// (fail is defined in parse_elf_test.bn, same package.)

// mkSym builds a synthetic InputSymbol.
func mkSym(name *[]readonly char, secIdx int, binding int) InputSymbol {
	var s InputSymbol
	s.Name = buf.CopyStr(name)
	s.SecIndex = secIdx
	s.Value = cast(uint, 0)
	s.Binding = binding
	return s
}

// mkObj builds a minimal InputObject with one .text section and the given symbols.
func mkObj(path *[]readonly char, syms @[]InputSymbol) @InputObject {
	var obj @InputObject = make(InputObject)
	obj.Path = buf.CopyStr(path)
	obj.Machine = EM_X86_64
	obj.Sections = make_slice(InputSection, 1)
	var sec InputSection
	sec.Name = buf.CopyStr(".text")
	sec.Type = SHT_PROGBITS
	sec.Flags = SF_READ | SF_EXEC
	sec.Data = make_slice(uint8, 0)
	sec.Size = cast(uint, 0)
	sec.Align = 1
	obj.Sections[0] = sec
	obj.Symbols = syms
	obj.Relocs = make_slice(InputReloc, 0)
	return obj
}

// Two objects that each define what the other references must resolve, and Lookup
// must point each name at its defining object.
func TestResolveCrossObject() testing.TestResult {
	var symsA @[]InputSymbol = make_slice(InputSymbol, 2)
	symsA[0] = mkSym("foo", 0, BIND_GLOBAL) // defined
	symsA[1] = mkSym("bar", -1, BIND_GLOBAL) // referenced
	var symsB @[]InputSymbol = make_slice(InputSymbol, 2)
	symsB[0] = mkSym("bar", 0, BIND_GLOBAL) // defined
	symsB[1] = mkSym("foo", -1, BIND_GLOBAL) // referenced

	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkObj("a.o", symsA)
	objs[1] = mkObj("b.o", symsB)

	t, err := Resolve(objs)
	if len(err) != 0 { return fail("cross-object resolve should succeed") }
	oi, _, ok := t.Lookup("foo")
	if !ok || oi != 0 { return fail("foo should resolve to object 0") }
	oj, _, ok2 := t.Lookup("bar")
	if !ok2 || oj != 1 { return fail("bar should resolve to object 1") }
	return ""
}

// An undefined, non-weak symbol with no definition is an error.
func TestResolveUndefined() testing.TestResult {
	var syms @[]InputSymbol = make_slice(InputSymbol, 1)
	syms[0] = mkSym("missing", -1, BIND_GLOBAL)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObj("a.o", syms)
	_, err := Resolve(objs)
	if !charsEqual(err, "undefined symbol: missing") {
		return fail("expected the singular undefined-symbol message")
	}
	return ""
}

// A link with several missing symbols names ALL of them (deduplicated), in one
// error â so a real link failure is fixed in one pass, not one symbol per re-link.
func TestResolveReportsAllUndefined() testing.TestResult {
	var symsA @[]InputSymbol = make_slice(InputSymbol, 2)
	symsA[0] = mkSym("alpha", -1, BIND_GLOBAL)
	symsA[1] = mkSym("beta", -1, BIND_GLOBAL)
	var symsB @[]InputSymbol = make_slice(InputSymbol, 1)
	symsB[0] = mkSym("alpha", -1, BIND_GLOBAL) // a second reference to alpha -> deduped
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkObj("a.o", symsA)
	objs[1] = mkObj("b.o", symsB)
	_, err := Resolve(objs)
	if !charsEqual(err, "undefined symbols: alpha, beta") {
		return fail("expected both undefined symbols named once, in encounter order")
	}
	return ""
}

// A reference undefined in one object but defined in another is resolved, so it is
// NOT listed among the undefined — only the genuinely-missing symbol is.
func TestResolveUndefinedExcludesCrossResolved() testing.TestResult {
	var symsA @[]InputSymbol = make_slice(InputSymbol, 2)
	symsA[0] = mkSym("resolved", -1, BIND_GLOBAL) // undefined here, defined in B
	symsA[1] = mkSym("missing", -1, BIND_GLOBAL) // defined nowhere
	var symsB @[]InputSymbol = make_slice(InputSymbol, 1)
	symsB[0] = mkSym("resolved", 0, BIND_GLOBAL) // the definition
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkObj("a.o", symsA)
	objs[1] = mkObj("b.o", symsB)
	_, err := Resolve(objs)
	if !charsEqual(err, "undefined symbol: missing") {
		return fail("only the genuinely-undefined symbol should be reported")
	}
	return ""
}

// A weak undefined reference is allowed (resolves to 0), not an error.
func TestResolveWeakUndefinedOk() testing.TestResult {
	var syms @[]InputSymbol = make_slice(InputSymbol, 1)
	syms[0] = mkSym("weakref", -1, BIND_WEAK)
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObj("a.o", syms)
	_, err := Resolve(objs)
	if len(err) != 0 { return fail("weak-undefined should be allowed") }
	return ""
}

// Two strong definitions of the same name collide.
func TestResolveDuplicate() testing.TestResult {
	var symsA @[]InputSymbol = make_slice(InputSymbol, 1)
	symsA[0] = mkSym("dup", 0, BIND_GLOBAL)
	var symsB @[]InputSymbol = make_slice(InputSymbol, 1)
	symsB[0] = mkSym("dup", 0, BIND_GLOBAL)
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkObj("a.o", symsA)
	objs[1] = mkObj("b.o", symsB)
	_, err := Resolve(objs)
	if !charsEqual(err, "duplicate symbol: dup (defined in a.o and b.o)") {
		return fail("a duplicate error should name the symbol and both colliding objects")
	}
	return ""
}

// A named, undefined LOCAL symbol (e.g. STT_FILE, which the reader folds to
// SecIndex -1) must not be treated as a required global reference.
func TestResolveLocalUndefinedIgnored() testing.TestResult {
	var syms @[]InputSymbol = make_slice(InputSymbol, 1)
	syms[0] = mkSym("srcfile.bn", -1, 0) // binding 0 = local
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = mkObj("a.o", syms)
	_, err := Resolve(objs)
	if len(err) != 0 { return fail("a local undefined symbol must not be an error") }
	return ""
}

// Precedence must hold regardless of order: a strong definition seen BEFORE a
// weak one of the same name keeps the strong definition.
func TestResolveStrongThenWeak() testing.TestResult {
	var symsA @[]InputSymbol = make_slice(InputSymbol, 1)
	symsA[0] = mkSym("dup", 0, BIND_GLOBAL) // strong first
	var symsB @[]InputSymbol = make_slice(InputSymbol, 1)
	symsB[0] = mkSym("dup", 0, BIND_WEAK) // weak second
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkObj("a.o", symsA)
	objs[1] = mkObj("b.o", symsB)
	t, err := Resolve(objs)
	if len(err) != 0 { return fail("strong-then-weak should not error") }
	oi, _, ok := t.Lookup("dup")
	if !ok || oi != 0 { return fail("dup should stay the strong definition (object 0)") }
	return ""
}

// Two weak definitions of one name are allowed; the first wins.
func TestResolveTwoWeak() testing.TestResult {
	var symsA @[]InputSymbol = make_slice(InputSymbol, 1)
	symsA[0] = mkSym("dup", 0, BIND_WEAK)
	var symsB @[]InputSymbol = make_slice(InputSymbol, 1)
	symsB[0] = mkSym("dup", 0, BIND_WEAK)
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkObj("a.o", symsA)
	objs[1] = mkObj("b.o", symsB)
	t, err := Resolve(objs)
	if len(err) != 0 { return fail("two weak definitions should not error") }
	oi, _, ok := t.Lookup("dup")
	if !ok || oi != 0 { return fail("first weak definition should win (object 0)") }
	return ""
}

// A strong definition overrides a weak one (no error; the strong def wins).
func TestResolveStrongOverridesWeak() testing.TestResult {
	var symsA @[]InputSymbol = make_slice(InputSymbol, 1)
	symsA[0] = mkSym("dup", 0, BIND_WEAK)
	var symsB @[]InputSymbol = make_slice(InputSymbol, 1)
	symsB[0] = mkSym("dup", 0, BIND_GLOBAL)
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkObj("a.o", symsA)
	objs[1] = mkObj("b.o", symsB)
	t, err := Resolve(objs)
	if len(err) != 0 { return fail("weak+strong should resolve to strong, not error") }
	oi, _, ok := t.Lookup("dup")
	if !ok || oi != 1 { return fail("dup should resolve to the strong definition (object 1)") }
	return ""
}

// mkIdxName builds a distinct 3-char symbol name for index i (i in [0, 676)):
// 's' + two base-26 letters.  Used to synthesize many distinct names.
func mkIdxName(i int) @[]char {
	var n @[]char = make_slice(char, 3)
	n[0] = 's'
	n[1] = cast(char, cast(int, 'a') + (i / 26))
	n[2] = cast(char, cast(int, 'a') + (i % 26))
	return n
}

// The functional tests above use 1-2 symbols, so the defIndex table never grows
// past its initial capacity.  With enough distinct definitions to force the table
// to grow and rehash, every definition must still be found by Lookup (pointing at
// its object), every cross-object reference must still resolve, and a never-defined
// name must not be found — i.e. the hashed index stays correct across a rehash (a
// stale/dangling key would surface only at this scale).
func TestResolveManySymbolsAcrossGrowth() testing.TestResult {
	var n int = 40
	var defsA @[]InputSymbol = make_slice(InputSymbol, n)
	for i := 0; i < n; i++ {
		defsA[i] = mkSym(mkIdxName(i), 0, BIND_GLOBAL)
	}
	// objB references every other one of A's symbols (undefined in B, defined in A);
	// none is genuinely missing, so resolution must succeed with no error.
	var refsB @[]InputSymbol = make_slice(InputSymbol, n / 2)
	for i := 0; i < n / 2; i++ {
		refsB[i] = mkSym(mkIdxName(i * 2), -1, BIND_GLOBAL)
	}
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkObj("a.o", defsA)
	objs[1] = mkObj("b.o", refsB)
	t, err := Resolve(objs)
	if len(err) != 0 {
		return fail("all of B's references are defined in A; expected no undefined-symbol error")
	}
	for i := 0; i < n; i++ {
		// defsA[i] is symbol i of object 0, so its SymDef is (ObjIdx 0, SymIdx i).
		// Asserting SymIdx too catches an index that maps a name to the WRONG entry
		// (a corruption ObjIdx alone can't see, since every def shares object 0).
		oi, si, ok := t.Lookup(mkIdxName(i))
		if !ok || oi != 0 || si != i {
			return fail("every definition must map to its own (object 0, symbol i) entry after rehash")
		}
	}
	_, _, absent := t.Lookup("absent")
	if absent {
		return fail("a never-defined name must not be found by Lookup")
	}
	return ""
}
