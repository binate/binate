package "pkg/binate/link"

import "pkg/binate/buf"

// Layer 2: a declarative layout SPEC that compiles to the Layer-1 LayoutBuilder — sugar
// for the common linker-script case (cases A/D and the common part of B).  A driver
// builds a LayoutScript value (memory regions, ordered output sections whose bodies are
// ordered items, segments, symbols, an entry) and calls LinkWithScript; the esoteric
// (hand-built data blobs, arbitrary PHDRS arithmetic) is deliberately omitted and drops
// to the imperative builder — a driver mixes the two via CompileScript on its own builder.
// The LayoutScript / SectionSpec / ScriptItem / RegionSpec / SegmentSpec / AbsSymSpec data
// types are declared in the driver-facing interface (link.bni).

// Section-item kinds (a section body is an ordered list of these; a driver builds items
// with the Place / SymAt / SetDotTo / AlignTo constructors, not by setting Kind).
const (
	siPlace int = 0  // Place(pattern, keep)
	siSymbol int = 1 // SymbolAtDot(name)
	siSetDot int = 2 // SetDot(addr)
	siAlign int = 3  // AlignDot(n)
)

// Place returns a section item that appends every not-yet-consumed input section matching
// pattern (a `*(GLOB)` such as "*(.text*)" or "*(COMMON)"); keep marks it never-GC'd.
func Place(pattern *[]readonly char, keep bool) ScriptItem {
	var it ScriptItem
	it.Kind = siPlace
	it.Pattern = buf.CopyStr(pattern)
	it.Keep = keep
	return it
}

// SymAt returns a section item defining an absolute symbol equal to the current location
// counter — the section-boundary idiom (`__bss_start`, `_edata`).
func SymAt(name *[]readonly char) ScriptItem {
	var it ScriptItem
	it.Kind = siSymbol
	it.Sym = buf.CopyStr(name)
	return it
}

// SetDotTo returns a section item that sets the location counter to an absolute address
// (a gap or an overlay within the section).
func SetDotTo(addr uint64) ScriptItem {
	var it ScriptItem
	it.Kind = siSetDot
	it.Addr = addr
	return it
}

// AlignTo returns a section item that rounds the location counter up to a multiple of n.
func AlignTo(n int) ScriptItem {
	var it ScriptItem
	it.Kind = siAlign
	it.N = n
	return it
}

// segHandleFor returns the index in names of the segment named name, or -1.
func segHandleFor(names @[]@[]char, name *[]readonly char) int {
	for i := 0; i < len(names); i++ {
		if charsEqual(names[i], name) { return i }
	}
	return -1
}

// CompileScript issues the Layer-1 calls for s against an existing builder b (so a driver
// can compile most of a layout declaratively, then add imperative calls for a weird
// section before Finish).  It does NOT call Finish or emit.  Returns "" on success or the
// first error (an unknown region/segment name, or a builder error).
func CompileScript(b @LayoutBuilder, s LayoutScript) @[]readonly char {
	for i := 0; i < len(s.Regions); i++ {
		var r RegionSpec = s.Regions[i]
		b.DefineRegion(r.Name, r.Origin, r.Length, r.Attrs)
	}
	// Declare segments, keeping their handles (and names) for section assignment.
	var segHandles @[]Segment = make_slice(Segment, len(s.Segments))
	var segNames @[]@[]char = make_slice(@[]char, len(s.Segments))
	for i := 0; i < len(s.Segments); i++ {
		var sp SegmentSpec = s.Segments[i]
		segHandles[i] = b.DefineSegment(sp.Name, sp.Ptype, sp.Flags)
		segNames[i] = sp.Name
	}
	if s.HasStartDot { b.SetDot(s.StartDot) }

	for i := 0; i < len(s.Sections); i++ {
		var sec SectionSpec = s.Sections[i]
		var h Section = b.BeginSection(sec.Name, sec.Flags)
		if len(sec.VmaRegion) != 0 { b.SectionAtRegion(sec.VmaRegion) }
		if len(sec.LmaRegion) != 0 {
			b.SectionLoadRegion(sec.LmaRegion)
		} else if sec.HasLmaAddr {
			b.SectionLoadAddr(sec.LmaAddr)
		}
		if sec.Align > 0 { b.SectionAlign(sec.Align) }
		for j := 0; j < len(sec.Items); j++ {
			var it ScriptItem = sec.Items[j]
			if it.Kind == siPlace {
				b.Place(it.Pattern, it.Keep)
			} else if it.Kind == siSymbol {
				b.SymbolAtDot(it.Sym)
			} else if it.Kind == siSetDot {
				b.SetDot(it.Addr)
			} else if it.Kind == siAlign {
				b.AlignDot(it.N)
			}
		}
		b.EndSection()
		if len(sec.Segment) != 0 {
			var si int = segHandleFor(segNames, sec.Segment)
			if si < 0 {
				return buf.Concat("CompileScript: section assigned to unknown segment: ", sec.Segment)
			}
			b.AssignSection(h, segHandles[si])
		}
	}

	for i := 0; i < len(s.AbsSyms); i++ {
		var as AbsSymSpec = s.AbsSyms[i]
		b.DefineSymbol(as.Name, as.Value)
	}
	if s.HasEntryAddr {
		b.SetEntryAddr(s.EntryAddr)
	} else if len(s.Entry) != 0 {
		b.SetEntry(s.Entry)
	}
	return b.Error()
}

// LinkWithScript is the one-shot convenience over Layer 1: it reads inputPaths, compiles
// the declarative script s for machine, resolves + relocates (Finish), and emits — an ELF
// executable, or a flat binary if s.Raw.  Returns "" on success or a non-empty error (a
// read failure, a script error, or a Finish/emit error).
func LinkWithScript(inputPaths @[]@[]char, s LayoutScript, machine int,
		out *[]readonly char) @[]readonly char {
	var inputs @[]@InputObject = make_slice(@InputObject, len(inputPaths))
	for i := 0; i < len(inputPaths); i++ {
		obj, err := ReadObject(inputPaths[i])
		if len(err) != 0 { return buf.Concat("LinkWithScript: read: ", err) }
		inputs[i] = obj
	}
	var b @LayoutBuilder = NewLayout(machine)
	b.SetInputs(inputs)
	var cerr @[]readonly char = CompileScript(b, s)
	if len(cerr) != 0 { return cerr }
	var ferr @[]readonly char = b.Finish()
	if len(ferr) != 0 { return ferr }
	if s.Raw { return b.EmitRawBinary(out) }
	return b.EmitElf(out)
}
