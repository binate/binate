package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// (fail is in parse_elf_test.bn; checkLoadable in emit_elf_test.bn; absValue in
// builder_symbols_test.bn; u32/charsEqual in bytes.bn — same package.)

// A declarative script's section-boundary items (SymAt) and top-level AbsSyms compile to
// the Layer-1 SymbolAtDot / DefineSymbol calls, defining the expected absolute symbols at
// the placed addresses.  Compiled against an existing builder (the mix-friendly entry) and
// inspected via AbsSyms — no emit.
func TestCompileScriptSymbols() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("data", -1)
	a.DefineLabel("d")
	a.SetGlobal("d")
	a.EmitUint32(cast(uint32, 0xdeadbeef)) // 4 bytes of .data content
	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	if !elf.WriteX86_64(a, "/tmp/binate_link_script_syms.o") { return fail("write failed") }

	obj, e := ReadObject("/tmp/binate_link_script_syms.o")
	if len(e) != 0 { return fail("read failed") }
	var objs @[]@InputObject = make_slice(@InputObject, 1)
	objs[0] = obj
	var b @LayoutBuilder = NewLayout(EM_X86_64)
	b.SetInputs(objs)

	// A .data section bracketed by boundary symbols, plus a fixed-value _stack_top.
	var dsec SectionSpec
	dsec.Name = buf.CopyStr(".data")
	dsec.Flags = SF_READ | SF_WRITE
	dsec.Items = make_slice(ScriptItem, 3)
	dsec.Items[0] = SymAt("__data_start")
	dsec.Items[1] = Place("*(.data*)", false)
	dsec.Items[2] = SymAt("__data_end")

	var script LayoutScript
	script.HasStartDot = true
	script.StartDot = cast(uint64, 0x400000)
	script.Sections = make_slice(SectionSpec, 1)
	script.Sections[0] = dsec
	script.AbsSyms = make_slice(AbsSymSpec, 1)
	var st AbsSymSpec
	st.Name = buf.CopyStr("_stack_top")
	st.Value = cast(uint64, 0x800000)
	script.AbsSyms[0] = st

	var cerr @[]readonly char = CompileScript(b, script)
	if len(cerr) != 0 { return fail("CompileScript returned an error") }

	var syms @[]AbsSym = b.AbsSyms()
	ds, dok := absValue(syms, "__data_start")
	if !dok || ds != cast(uint64, 0x400000) { return fail("__data_start should be the .data VMA") }
	de, eok := absValue(syms, "__data_end")
	if !eok || de <= ds { return fail("__data_end should be past __data_start") }
	sv, sok := absValue(syms, "_stack_top")
	if !sok || sv != cast(uint64, 0x800000) { return fail("_stack_top should be its fixed value") }
	return ""
}

// LinkWithScript is the one-shot path: a declarative script with a start dot, ordered
// sections, a page-aligned writable group, and an entry links two x86-64 objects into a
// loadable ELF64 whose entry is _start's address.
func TestLinkWithScriptElf() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	x64.Ret(a)
	a.SetSection("data", -1)
	a.DefineLabel("dv")
	a.SetGlobal("dv")
	a.EmitUint32(cast(uint32, 0x11223344))
	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	if !elf.WriteX86_64(a, "/tmp/binate_link_script_elf.o") { return fail("write failed") }

	// .text/.rodata (R+X/R) then .data/.bss (R+W) on a fresh page — the W^X layout.
	var secs @[]SectionSpec = make_slice(SectionSpec, 4)
	var tsec SectionSpec
	tsec.Name = buf.CopyStr(".text")
	tsec.Flags = SF_READ | SF_EXEC
	tsec.Items = make_slice(ScriptItem, 1)
	tsec.Items[0] = Place("*(.text*)", false)
	secs[0] = tsec
	var rsec SectionSpec
	rsec.Name = buf.CopyStr(".rodata")
	rsec.Flags = SF_READ
	rsec.Items = make_slice(ScriptItem, 1)
	rsec.Items[0] = Place("*(.rodata*)", false)
	secs[1] = rsec
	var dsec SectionSpec
	dsec.Name = buf.CopyStr(".data")
	dsec.Flags = SF_READ | SF_WRITE
	dsec.Align = 0x1000
	dsec.Items = make_slice(ScriptItem, 1)
	dsec.Items[0] = Place("*(.data*)", false)
	secs[2] = dsec
	var bsec SectionSpec
	bsec.Name = buf.CopyStr(".bss")
	bsec.Flags = SF_READ | SF_WRITE
	bsec.Items = make_slice(ScriptItem, 1)
	bsec.Items[0] = Place("*(.bss*)", false)
	secs[3] = bsec

	var script LayoutScript
	script.HasStartDot = true
	script.StartDot = cast(uint64, 0x400000)
	script.Sections = secs
	script.Entry = buf.CopyStr("_start")

	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = buf.CopyStr("/tmp/binate_link_script_elf.o")
	var err @[]readonly char = LinkWithScript(paths, script, EM_X86_64, "/tmp/binate_link_script_elf")
	if len(err) != 0 { return fail("LinkWithScript failed") }

	data, ok := readFile("/tmp/binate_link_script_elf")
	if !ok { return fail("cannot read the linked executable") }
	var problem @[]char = checkLoadable(data, EM_X86_64, 0x400000)
	if len(problem) != 0 { return problem }
	return ""
}

// LinkWithScript with Raw emits a flat binary (no ELF headers): a single section placed at
// a fixed dot, its content packed by load address.  The first bytes are the section's, not
// an ELF magic.
func TestLinkWithScriptRaw() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	x64.Ret(a) // 0xc3
	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	if !elf.WriteX86_64(a, "/tmp/binate_link_script_raw.o") { return fail("write failed") }

	var tsec SectionSpec
	tsec.Name = buf.CopyStr(".text")
	tsec.Flags = SF_READ | SF_EXEC
	tsec.Items = make_slice(ScriptItem, 1)
	tsec.Items[0] = Place("*(.text*)", false)

	var script LayoutScript
	script.HasStartDot = true
	script.StartDot = cast(uint64, 0x7c00)
	script.Sections = make_slice(SectionSpec, 1)
	script.Sections[0] = tsec
	script.Raw = true

	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = buf.CopyStr("/tmp/binate_link_script_raw.o")
	var err @[]readonly char = LinkWithScript(paths, script, EM_X86_64,
			"/tmp/binate_link_script_raw.bin")
	if len(err) != 0 { return fail("LinkWithScript (raw) failed") }

	data, ok := readFile("/tmp/binate_link_script_raw.bin")
	if !ok { return fail("cannot read the raw image") }
	if len(data) != 1 { return fail("raw image should be exactly the one RET byte") }
	if data[0] != 0xc3 { return fail("raw image should start with the RET byte, not an ELF header") }
	return ""
}
