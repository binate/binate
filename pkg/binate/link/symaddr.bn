package "pkg/binate/link"

// symbolAddr computes the final virtual address of the symbol (objIdx, symIdx): a local
// symbol's own definition; a global or weak one's — defined in this object or not — the
// definition the symbol table chose, so a strong definition elsewhere overrides a weak one
// here and every reference to link-once weak copies reaches the one kept (as GNU ld and
// lld bind them).  Returns (addr, true) for a defined or resolved symbol, (0, true) for a
// weak undefined reference (address 0), and (0, false) if the definition's section was not
// placed: Layout omitted it (a symbol in an empty kind) or a scripted layout left it
// unplaced (the strict-orphan error).
func symbolAddr(t @SymbolTable, lr @LayoutResult, objIdx int, symIdx int) (uint64, bool) {
	oo, ss, found := chosenDef(t, objIdx, symIdx)
	return choiceAddr(t, lr, objIdx, symIdx, oo, ss, found)
}

// choiceAddr is symbolAddr for the symbol (objIdx, symIdx) given chosenDef's result for it
// (oo, ss, found), for a caller that also needs the definition.
func choiceAddr(t @SymbolTable, lr @LayoutResult, objIdx int, symIdx int, oo int, ss int,
		found bool) (uint64, bool) {
	if found { return definedAddr(t, lr, oo, ss) }
	av, aok := t.lookupAbs(t.Objs[objIdx].Symbols[symIdx].Name)
	if aok { return av, true } // layout-defined absolute symbol (scripted driver)
	return cast(uint64, 0), true // weak undefined -> 0
}

// chosenDef returns the definition (object, symbol) a reference to the symbol (objIdx,
// symIdx) binds to, as symbolAddr places it: its own for a defined local or strong symbol,
// the symbol table's choice for an undefined or weak one; found is false for an undefined
// symbol no object defines.
//
// Only an undefined or weak symbol is looked up: Resolve rejects a second strong
// definition and lets a strong one replace a weak one, so a defined strong global is
// always the table's own choice, and skipping the lookup keeps it off the per-relocation
// path.
func chosenDef(t @SymbolTable, objIdx int, symIdx int) (int, int, bool) {
	var sym InputSymbol = t.Objs[objIdx].Symbols[symIdx]
	var undefined bool = sym.SecIndex < 0 && !sym.Abs
	if undefined || sym.Binding == BIND_WEAK {
		oo, ss, found := t.Lookup(sym.Name)
		if found { return oo, ss, true }
		if undefined { return -1, -1, false }
	}
	return objIdx, symIdx, true
}

// definedAddr computes the final virtual address of the symbol (objIdx, symIdx), which
// that object defines: its section's placement plus its value, or an absolute symbol's own
// value.  Returns (0, false) if the section was not placed.
func definedAddr(t @SymbolTable, lr @LayoutResult, objIdx int, symIdx int) (uint64, bool) {
	var sym InputSymbol = t.Objs[objIdx].Symbols[symIdx]
	if sym.Abs { return sym.AbsValue, true }
	var outIdx int = t.Objs[objIdx].Sections[sym.SecIndex].OutIndex
	if outIdx < 0 { return cast(uint64, 0), false }
	var base uint64 = lr.Sections[outIdx].Addr
	var secOff uint = t.Objs[objIdx].Sections[sym.SecIndex].OutOffset
	return base + cast(uint64, secOff) + cast(uint64, sym.Value), true
}
