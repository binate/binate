package "pkg/binate/link"

import "pkg/builtins/testing"

// chosenDef binds a reference to the definition symbolAddr places: a defined local or
// strong symbol to itself, an undefined or weak one to the symbol table's choice, and an
// undefined one nothing defines to nothing.  (mkSym / mkObj are in resolve_test.bn, fail
// in parse_elf_test.bn.)
func TestChosenDef() testing.TestResult {
	var a @[]InputSymbol = make_slice(InputSymbol, 5)
	a[0] = mkSym("s", 0, BIND_GLOBAL) // strong: itself
	a[1] = mkSym("w", 0, BIND_WEAK) // weak: b.o's strong w
	a[2] = mkSym("u", -1, BIND_GLOBAL) // undefined: b.o's u
	a[3] = mkSym("l", 0, 0) // local: itself, though b.o defines an l
	a[4] = mkSym("m", -1, BIND_WEAK) // weak undefined, defined nowhere
	var b @[]InputSymbol = make_slice(InputSymbol, 3)
	b[0] = mkSym("w", 0, BIND_GLOBAL)
	b[1] = mkSym("u", 0, BIND_GLOBAL)
	b[2] = mkSym("l", 0, BIND_GLOBAL)
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkObj("a.o", a)
	objs[1] = mkObj("b.o", b)
	t, rerr := Resolve(objs)
	if len(rerr) != 0 { return fail("resolve failed") }
	oo, ss, found := chosenDef(t, 0, 0)
	if !found || oo != 0 || ss != 0 { return fail("a strong symbol not bound to itself") }
	oo, ss, found = chosenDef(t, 0, 1)
	if !found || oo != 1 || ss != 0 { return fail("a weak symbol not bound to the strong one") }
	oo, ss, found = chosenDef(t, 0, 2)
	if !found || oo != 1 || ss != 1 { return fail("an undefined symbol not bound to b.o's") }
	oo, ss, found = chosenDef(t, 0, 3)
	if !found || oo != 0 || ss != 3 { return fail("a local symbol not bound to itself") }
	_, _, found = chosenDef(t, 0, 4)
	if found { return fail("an undefined symbol defined nowhere bound to something") }
	return ""
}
