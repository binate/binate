package "pkg/binate/link"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/elf"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Symbol visibility: the ELF reader's Hidden mark (STV_HIDDEN / STV_INTERNAL), a hidden
// common's merged definition, imports leaving out a hidden reference, and a dynamic ELF link
// that leaves a hidden common out of .dynsym.  (mkCommon is in builder_common_test.bn, mkSym /
// mkObj in resolve_test.bn, bytesAtEqual in dynmacho_test.bn, elfPatchCommon / elfDynValue in
// dynlink_exports_test.bn, loadFileOff in got_link_test.bn, mkUndefObj in dynlink_test.bn,
// adrpAddTarget in dynmacho_init_test.bn, testTmpDir in link_test.bn, fail in
// parse_elf_test.bn.)

// elfSymEntry returns the offset of the .symtab entry named name in the ELF64 object data, or
// -1.
func elfSymEntry(data *[]readonly uint8, name *[]readonly char) int {
	var shoff int = cast(int, u64(data, 0x28))
	var shnum int = u16(data, 0x3c)
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * 64
		if cast(int, u32(data, sh + 4)) != SHT_SYMTAB { continue }
		var strSh int = shoff + cast(int, u32(data, sh + 0x28)) * 64
		var strOff int = cast(int, u64(data, strSh + 0x18))
		var off int = cast(int, u64(data, sh + 0x18))
		var n int = cast(int, u64(data, sh + 0x20)) / 24
		for k := 0; k < n; k++ {
			var e int = off + k * 24
			var at int = strOff + cast(int, u32(data, e))
			if bytesAtEqual(data, at, name) && data[at + len(name)] == 0 { return e }
		}
	}
	return -1
}

// visAsm returns an assembler whose text defines the globals d0 .. d3 (one instruction each).
func visAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var names @[]@[]char = @[]@[]char{buf.CopyStr("d0"), buf.CopyStr("d1"), buf.CopyStr("d2"),
			buf.CopyStr("d3")}
	for i := 0; i < len(names); i++ {
		a.DefineLabel(names[i])
		a.SetGlobal(names[i])
		aarch64.Ret(a)
	}
	return a
}

// The ELF reader marks a symbol of visibility STV_HIDDEN or STV_INTERNAL Hidden, and one of
// STV_DEFAULT or STV_PROTECTED not.
func TestReadElfSymbolVisibility() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = visAsm()
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	var path @[]char = buf.Concat(dir, "/vis.o")
	if !elf.WriteAArch64(a, path) { return fail("write object failed") }
	data, ok := readFile(path)
	if !ok { return fail("cannot read the object") }
	// d0 default, d1 internal, d2 hidden, d3 protected.
	var names @[]@[]char = @[]@[]char{buf.CopyStr("d0"), buf.CopyStr("d1"), buf.CopyStr("d2"),
			buf.CopyStr("d3")}
	for i := 0; i < len(names); i++ {
		var e int = elfSymEntry(data, names[i])
		if e < 0 { return fail(buf.Concat("no symbol ", names[i])) }
		data[e + 5] = cast(uint8, i) // st_other's visibility
	}
	obj, perr := parseObjectBytes(data, path)
	if len(perr) != 0 { return fail(buf.Concat("parse: ", perr)) }
	var want @[]bool = @[]bool{false, true, true, false}
	var seen int = 0
	for i := 0; i < len(names); i++ {
		for s := 0; s < len(obj.Symbols); s++ {
			if !charsEqual(obj.Symbols[s].Name, names[i]) { continue }
			if obj.Symbols[s].Hidden != want[i] {
				return fail(buf.Concat("wrong Hidden mark for ", names[i]))
			}
			seen = seen + 1
		}
	}
	if seen != len(names) { return fail("not every one of d0 .. d3 was read") }
	return ""
}

// A common's definition is Hidden when any global symbol of its name is — a hidden undefined
// reference in another object (h), or the common itself (c) — and not for a hidden local of
// the name (l, a different symbol) or none at all (v).
func TestCommonObjectHiddenVisibility() testing.TestResult {
	var as @[]InputSymbol = make_slice(InputSymbol, 4)
	as[0] = mkCommon("h", 4, 4)
	as[1] = mkCommon("v", 4, 4)
	as[2] = mkCommon("c", 4, 4)
	as[2].Hidden = true
	as[3] = mkCommon("l", 4, 4)
	var bs @[]InputSymbol = make_slice(InputSymbol, 2)
	bs[0] = mkSym("h", -1, BIND_GLOBAL)
	bs[0].Hidden = true
	bs[1] = mkSym("l", 0, 0)
	bs[1].Hidden = true
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = mkObj("a.o", as)
	objs[1] = mkObj("b.o", bs)
	var r commonsResult = commonObject(objs, EM_X86_64, false)
	if len(r.Err) != 0 || !present(r.Obj) || len(r.Obj.Symbols) != 4 { return fail("no four commons") }
	var want @[]bool = @[]bool{true, false, true, false}
	for i := 0; i < 4; i++ {
		if r.Obj.Symbols[i].Hidden != want[i] {
			return fail(buf.Concat("wrong Hidden mark for ", r.Obj.Symbols[i].Name))
		}
	}
	return ""
}

// collectImports leaves out a name any object references as hidden — it must resolve inside
// the image — whichever object marks it, and keeps an ordinary undefined reference.
func TestCollectImportsSkipsHidden() testing.TestResult {
	var a @InputObject = mkUndefObj(@[]@[]char{buf.CopyStr("foo"), buf.CopyStr("bar")},
			@[]int{BIND_GLOBAL, BIND_GLOBAL})
	a.Symbols[0].Hidden = true
	var b @InputObject = mkUndefObj(@[]@[]char{buf.CopyStr("foo"), buf.CopyStr("weak")},
			@[]int{BIND_GLOBAL, BIND_WEAK})
	b.Symbols[1].Hidden = true
	var objs @[]@InputObject = make_slice(@InputObject, 2)
	objs[0] = a
	objs[1] = b
	names, _ := collectImports(objs)
	if len(names) != 1 || !charsEqual(names[0], "bar") { return fail("the imports are not just bar") }
	return ""
}

// A dynamic ELF link exports a common but not a hidden one: `counter` is in .dynsym at the
// address its ADRP + ADD computes, the hidden `secret` — allocated first, so an export indexed
// by the commons rather than the exports would take its address — is not.
func TestLinkDynElfHiddenCommonNotExported() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	a.SetGlobal("exit")
	a.SetGlobal("secret")
	a.SetGlobal("counter")
	aarch64.Adrp(a, aarch64.X1, "counter")
	aarch64.AddImmLabel(a, true, aarch64.X1, aarch64.X1, "counter")
	aarch64.Adrp(a, aarch64.X2, "secret")
	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(42))
	aarch64.Bl(a, "exit")
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }
	var obj @[]char = buf.Concat(dir, "/hidden.o")
	if !elf.WriteAArch64(a, obj) { return fail("write object failed") }
	data, ok := readFile(obj)
	if !ok || !elfPatchCommon(data, "counter", 4, 4) || !elfPatchCommon(data, "secret", 4, 4) {
		return fail("cannot make counter and secret commons")
	}
	data[elfSymEntry(data, "secret") + 5] = cast(uint8, STV_HIDDEN)
	if !writeBytes(obj, data) { return fail("cannot rewrite the object") }
	var paths @[]@[]char = make_slice(@[]char, 1)
	paths[0] = obj
	var out @[]char = buf.Concat(dir, "/hidden")
	var err @[]readonly char = LinkDynElf(paths, "_start", EM_AARCH64, cast(uint64, 0x400000), out,
			make_slice(@[]char, 0))
	if len(err) != 0 { return fail(buf.Concat("LinkDynElf failed: ", err)) }
	exe, eok := readFile(out)
	if !eok { return fail("cannot read the executable") }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var rd *[]readonly uint8 = exe
	var symOff int = loadFileOff(rd, elfDynValue(rd, DT_SYMTAB))
	var strOff int = loadFileOff(rd, elfDynValue(rd, DT_STRTAB))
	var nsym int = cast(int, u32(rd, loadFileOff(rd, elfDynValue(rd, DT_HASH)) + 4))
	if symOff < 0 || strOff < 0 { return fail("no .dynsym / .dynstr") }
	var entry uint64 = cast(uint64, u64(rd, 24))
	var textOff int = loadFileOff(rd, entry)
	var counter uint64 = adrpAddTarget(entry, u32(rd, textOff), u32(rd, textOff + 4))
	var sawCounter bool = false
	for i := 1; i < nsym; i++ {
		var e int = symOff + i * symEntSize
		var at int = strOff + cast(int, u32(rd, e))
		if bytesAtEqual(rd, at, "secret") && rd[at + 6] == 0 {
			return fail("the hidden secret was exported")
		}
		if bytesAtEqual(rd, at, "counter") && rd[at + 7] == 0 {
			if cast(uint64, u64(rd, e + 8)) != counter {
				return fail("the exported counter has another address")
			}
			sawCounter = true
		}
	}
	if !sawCounter { return fail("counter was not exported") }
	return ""
}
