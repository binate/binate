// Package lint provides static analysis rules for Binate source code.
// It walks type-checked ASTs and reports diagnostics for common mistakes.
package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/std/vec"

// Diagnostic represents a single lint warning.
type Diagnostic struct {
	Pos     token.Pos
	Rule    @[]char
	Message @[]char
}

// Result holds all diagnostics from a lint pass.
type Result struct {
	Diags @vec.Vec[Diagnostic]
}

// LintFile runs all lint rules on a type-checked package.  `file` is
// the package's merged AST; `files` is the per-impl-file ASTs (needed
// by unused-import for per-file import attribution).
// The Checker must have already checked the package (so ExprTypes are populated).
func LintFile(c @types.Checker, file @ast.File, files @[]@ast.File) @Result
