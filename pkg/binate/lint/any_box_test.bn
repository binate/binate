package "pkg/binate/lint"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for func-into-any-variadic and iface-pointer-into-any (any_box.bn).

// anyBoxPrelude declares a `...*any` print, a `*any` parameter, functions and an
// interface value for the tests' bodies.
func anyBoxPrelude() *[]readonly char {
	return "package \"test\"\n"
			"interface G {\n\tM() int\n}\n"
			"type B struct {\n\tv int\n}\n"
			"func (b *B) M() int {\n\treturn b.v\n}\n"
			"impl *B : G\n"
			"type S struct {\n\ta *any\n}\n"
			"func add(a int, b int) int {\n\treturn a + b\n}\n"
			"func id[T any](x T) T {\n\treturn x\n}\n"
			"func pr(xs ...*any) int {\n\treturn len(xs)\n}\n"
			"func take(x *any) bool {\n\treturn present(x)\n}\n"
}

// anyBoxCount lints the prelude plus body and returns rule's diagnostic count.
func anyBoxCount(body *[]readonly char, rule *[]readonly char) int {
	return countRule(lintSrc(buf.Concat(anyBoxPrelude(), body)), rule)
}

// expectAnyBox reports a failure unless body has want diagnostics of rule.
func expectAnyBox(body *[]readonly char, rule *[]readonly char, want int) testing.TestResult {
	var got int = anyBoxCount(body, rule)
	if got == want { return "" }
	return fail(
			buf.Concat(buf.Concat(buf.Concat("want ", strconv.Itoa(want)), " got "),
					buf.Concat(strconv.Itoa(got), buf.Concat(" for: ", body))))
}

// A function — a name, a generic instance, a function value — passed as a
// `...*any` argument is flagged once per argument.
func TestFuncIntoAnyVariadic() testing.TestResult {
	var r testing.TestResult = expectAnyBox("func main() {\n\t_ = pr(add, 1, id[int])\n}\n",
			"func-into-any-variadic", 2)
	if len(r) > 0 { return r }
	return expectAnyBox("func main() {\n\tf := add\n\t_ = pr(f)\n}\n", "func-into-any-variadic", 1)
}

// A call's result, a non-variadic `*any` parameter, and a spread are not flagged.
func TestFuncIntoAnyVariadicNotFlagged() testing.TestResult {
	var r testing.TestResult = expectAnyBox(
			"func main() {\n\t_ = pr(add(1, 2))\n\t_ = take(add)\n\tvar xs *[]*any\n\t_ = pr(xs...)\n}\n",
			"func-into-any-variadic", 0)
	if len(r) > 0 { return r }
	return expectAnyBox("func main() {\n\tvar g @G = make(B)\n\t_ = pr(g)\n}\n",
			"func-into-any-variadic", 0)
}

// A pointer to an interface value converted to any is flagged in an argument (a
// `...*any` one too), a typed initializer, an assignment, a return, and a
// composite element.
func TestIfacePointerIntoAny() testing.TestResult {
	var body *[]readonly char = "func main() {\n"
			"\tvar g @G = make(B)\n"
			"\tvar pg @(@G) = box(g)\n"
			"\t_ = take(&g)\n"
			"\t_ = pr(pg)\n"
			"\tvar x *any = &g\n"
			"\tx = pg\n"
			"\tvar s S = S{a: pg}\n"
			"\t_ = present(x)\n"
			"\t_ = present(s.a)\n"
			"}\n"
			"func ret(pg @(@G)) *any {\n\treturn pg\n}\n"
	return expectAnyBox(body, "iface-pointer-into-any", 6)
}

// The interface value itself, and a pointer to a non-interface value, are not
// flagged.
func TestIfacePointerIntoAnyNotFlagged() testing.TestResult {
	return expectAnyBox(
			"func main() {\n\tvar g @G = make(B)\n\tvar n int\n\t_ = take(g)\n\t_ = take(&n)\n"
					"\t_ = pr(g, &n)\n}\n",
			"iface-pointer-into-any", 0)
}

// A named type over an interface value, a pointer to one, or a function value is
// a value of its own type, boxed with that type, which an assertion recovers:
// not flagged.
func TestAnyBoxNamedTypesNotFlagged() testing.TestResult {
	var body *[]readonly char = "type GRef @G\ntype GP @(@G)\ntype Fn @func(int, int) int\n"
			"func main() {\n"
			"\tvar g @G = make(B)\n"
			"\tvar gr GRef = cast(GRef, g)\n"
			"\t_ = take(&gr)\n"
			"\tvar gp GP = cast(GP, box(g))\n"
			"\t_ = take(gp)\n"
			"\tvar fn Fn = add\n"
			"\t_ = pr(fn)\n"
			"}\n"
	var r testing.TestResult = expectAnyBox(body, "iface-pointer-into-any", 0)
	if len(r) > 0 { return r }
	return expectAnyBox(body, "func-into-any-variadic", 0)
}

// After fixed parameters (the Printf shape), only the function among the
// `...*any` arguments is flagged.
func TestFuncIntoAnyVariadicAfterFixedParams() testing.TestResult {
	return expectAnyBox(
			"func pf(f *[]readonly char, xs ...*any) int {\n\treturn len(xs)\n}\n"
					"func main() {\n\t_ = pf(\"x\", add, 3)\n}\n",
			"func-into-any-variadic", 1)
}

// A function literal's body, a deferred block and a package-level initializer
// are walked.
func TestIfacePointerIntoAnyNested() testing.TestResult {
	var body *[]readonly char = "var gg @G\nvar gx *any = &gg\n"
			"func main() {\n"
			"\tvar g @G = make(B)\n"
			"\tf := func() {\n\t\t_ = take(&g)\n\t}\n"
			"\tf()\n"
			"\tdefer {\n\t\t_ = take(&g)\n\t}\n"
			"\t_ = present(gx)\n"
			"}\n"
	return expectAnyBox(body, "iface-pointer-into-any", 3)
}

// A method call's arguments bind to the method's parameters — a struct's method
// (without its receiver) or an interface's — and a method's return operands to
// its results; a cast to any is a conversion too.
func TestAnyBoxMethodsAndCast() testing.TestResult {
	var body *[]readonly char = "type W struct {\n\tn int\n}\n"
			"func (w *W) Log(xs ...*any) int {\n\treturn len(xs)\n}\n"
			"func (w *W) Get(pg @(@G)) *any {\n\treturn pg\n}\n"
			"interface L {\n\tPut(x *any) bool\n}\n"
			"func main() {\n"
			"\tvar w W\n"
			"\t_ = w.Log(add)\n"
			"\tvar g @G = make(B)\n"
			"\t_ = w.Log(&g)\n"
			"\tvar l @L\n"
			"\tif present(l) {\n\t\t_ = l.Put(&g)\n\t}\n"
			"\tvar y *any = cast(*any, &g)\n"
			"\t_ = present(y)\n"
			"}\n"
	var r testing.TestResult = expectAnyBox(body, "func-into-any-variadic", 1)
	if len(r) > 0 { return r }
	return expectAnyBox(body, "iface-pointer-into-any", 4)
}
