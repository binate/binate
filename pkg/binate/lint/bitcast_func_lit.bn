package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"

// ============================================================
// Rule: bit-cast-func-lit
// ============================================================
//
// `bit_cast` reinterprets its operand as it is typed (conv.bit-cast), so it gives a
// function literal no destination type: `bit_cast(*func(int) int, func(x int) int { return
// x + n })` makes the literal a managed `@func`, a statement temporary (mem.temporary), and
// reinterprets it as a raw function value.  A capturing literal's captures live in that
// temporary, so the raw value dangles once the statement ends when it is kept past it — at a
// raw function-value store (walkRawFuncStores).  `cast` to the raw function-value type makes
// the literal a closure in the frame instead (func.closure.allocation).  A non-capturing
// literal's value has a null data word (func.lit.noncapturing), so nothing dangles, and a
// call's argument is borrowed only while the call runs; neither is flagged.

// lintBitCastFuncLits runs the rule over every declaration of the package.
func lintBitCastFuncLits(ctx @lintCtx, file @ast.File) {
	walkRawFuncStores(ctx, file, bcVisit)
}

// bcVisit flags value, stored as a raw function value, when it is a `bit_cast` of a
// capturing function literal.
func bcVisit(ctx @lintCtx, dst @types.Type, value @ast.Expr, idx int) {
	if idx >= 0 || !isBitCastOfCapturingLit(value) { return }
	addDiag(ctx, value.Pos, "bit-cast-func-lit",
			"bit_cast of a capturing function literal kept as a raw function value: the literal is a "
					"managed temporary that dangles after the statement; cast makes it a closure in the frame")
}

// isBitCastOfCapturingLit reports whether e is `bit_cast(T, <function literal that captures>)`.
func isBitCastOfCapturingLit(e @ast.Expr) bool {
	if e == nil || e.Kind != ast.EXPR_BUILTIN || e.Op != cast(int, token.BIT_CAST) ||
			len(e.Args) != 1 {
		return false
	}
	var lit @ast.Expr = e.Args[0]
	return lit != nil && lit.Kind == ast.EXPR_FUNC_LIT && lit.DeclRef != nil &&
			len(lit.DeclRef.Captures) > 0
}
