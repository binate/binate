package "pkg/binate/lint"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// bcDecls declares use, which borrows a raw function value for its call.
var bcDecls *[]readonly char = "package \"test\"\nfunc use(g *func(int) int) int { return g(1) }\n"

// A `bit_cast` of a capturing function literal kept as a raw function value — `*func`, or a
// named type over one, at a variable's declaration, an assignment inside another literal's
// body, a return, a stored struct literal's field — is flagged; a `cast` of it, a `bit_cast`
// to a managed function-value type, a `bit_cast` of a function value that is no literal or of
// a non-capturing literal, one passed to a call, and one stored to a blank are not.
func TestBitCastFuncLit() testing.TestResult {
	var flagged @[]*[]readonly char = @[]*[]readonly char{
			"func f(n int) int { var g *func(int) int = bit_cast(*func(int) int, "
					"func(x int) int { return x + n }); return g(1) }\n",
			"type F *func(int) int\nfunc f(n int) int { var g F = bit_cast(F, "
					"func(x int) int { return x + n }); return g(1) }\n",
			"func f(n int) int { var h @func() int = func() int { var g *func(int) int; "
					"g = bit_cast(*func(int) int, func(x int) int { return x + n }); return g(1) }; "
					"return h() }\n",
			"func f(n int) *func(int) int { return bit_cast(*func(int) int, "
					"func(x int) int { return x + n }) }\n",
			"type S struct { g *func(int) int }\n"
					"func f(n int) int { var s S = S{g: bit_cast(*func(int) int, "
					"func(x int) int { return x + n })}; return s.g(1) }\n"}
	for i := 0; i < len(flagged); i++ {
		var src @[]char = buf.Concat(bcDecls, flagged[i])
		if countRule(lintSrc(src), "bit-cast-func-lit") != 1 {
			return fail(buf.Concat("not flagged once: ", flagged[i]))
		}
	}
	var clean @[]*[]readonly char = @[]*[]readonly char{
			"func f(n int) int { var g *func(int) int = cast(*func(int) int, "
					"func(x int) int { return x + n }); return g(1) }\n",
			"func f(n int) int { var g @func(int) int = bit_cast(@func(int) int, "
					"func(x int) int { return x + n }); return g(1) }\n",
			"func id(x int) int { return x }\n"
					"func f() int { var h *func(int) int = id; "
					"var g *func(int) int = bit_cast(*func(int) int, h); return g(1) }\n",
			"func f() int { var g *func(int) int = bit_cast(*func(int) int, "
					"func(x int) int { return x }); return g(1) }\n",
			"var g *func(int) int = bit_cast(*func(int) int, func(x int) int { return x })\n",
			"func f(n int) int { return use(bit_cast(*func(int) int, func(x int) int { return x + n })) }\n",
			"func f(n int) { var _ *func(int) int = bit_cast(*func(int) int, "
					"func(x int) int { return x + n }) }\n"}
	for i := 0; i < len(clean); i++ {
		var src @[]char = buf.Concat(bcDecls, clean[i])
		if countRule(lintSrc(src), "bit-cast-func-lit") != 0 {
			return fail(buf.Concat("flagged: ", clean[i]))
		}
	}
	return ""
}
