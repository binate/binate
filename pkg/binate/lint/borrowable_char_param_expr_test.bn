package "pkg/binate/lint"

import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the value-family / escape classification (borrowable_char_param_expr.bn):
// where a sub-slice or laundered view FLOWS decides whether the parameter is
// reducible to *[]readonly char.  These pin the two over-warn defects the sound
// analysis fixes — a family value stored into a non-retypeable managed sink
// (Defect A: a hard type error) and a laundered view alongside an owned return
// (Defect B: a silent use-after-free) — plus the return-cascade behaviour.  Uses
// the shared `bcpFired` harness (borrowable_char_param_test.bn).

// ============================================================
// Return cascade
// ============================================================

func TestBorrowCharParamMixedViewOwnedReturn() testing.TestResult {
	// Returned as a view on one path but as a fresh make_slice allocation on
	// another: the @[]char return type cannot uniformly become *[]readonly char
	// (the owned path would become a dangling raw-slice return), so must NOT flag.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func f(name @[]char) @[]char {\n")
	b.Write("  var cut int = -1\n")
	b.Write("  for i := 0; i < len(name); i++ { if name[i] == '.' { cut = i } }\n")
	b.Write("  if cut < 0 { return name }\n")
	b.Write("  var out @[]char = make_slice(char, len(name) - cut - 1)\n")
	b.Write("  for i := cut + 1; i < len(name); i++ { out[i - cut - 1] = name[i] }\n")
	b.Write("  return out\n")
	b.Write("}")
	if bcpFired(b.String()) {
		return "did not expect borrowable-char-param for a view + owned-alloc mixed return"
	}
	return ""
}

func TestBorrowCharParamViewPlusNilSlotReturn() testing.TestResult {
	// A char-slice view in slot 0 plus a nil in a nillable POINTER slot (slot 1):
	// the nil operand must NOT be treated as an owned char return (it is a
	// different, nillable slot), so slot 0 still cascades and the parameter stays
	// flagged.  (A slice is non-nillable, so nil can only appear in slot 1 here.)
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func f(p @[]char) (@[]char, *int) {\n")
	b.Write("  if len(p) == 0 { return p, nil }\n")
	b.Write("  return p[1:len(p)], nil\n")
	b.Write("}")
	if !bcpFired(b.String()) {
		return "expected borrowable-char-param for a view + nil-pointer-slot multi-return"
	}
	return ""
}

func TestBorrowCharParamViewPlusZeroLocalUnderWarn() testing.TestResult {
	// A view return plus a fresh ZERO-VALUE-local return (`var e @[]char; return
	// e`): the empty local is in principle borrow-compatible (retypeable to an
	// empty *[]readonly char), but the analysis conservatively treats every
	// non-family @[]char return as owned, so it UNDER-warns here (does not flag).
	// The borrow-compatible idiom is to return an empty family view (`p[0:0]`),
	// which IS flagged.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func f(s @[]char) @[]char {\n")
	b.Write("  if len(s) == 0 { var e @[]char; return e }\n")
	b.Write("  return s[1:len(s)]\n")
	b.Write("}")
	if bcpFired(b.String()) {
		return "expected the zero-value-local return to conservatively suppress (documented under-warn)"
	}
	return ""
}

func TestBorrowCharParamViewPlusNamedOwnedReturn() testing.TestResult {
	// A view return plus an owned return of a DEFINED NAMED char-slice type
	// (`type Str @[]char`): the named return is still an owned char slice, so the
	// return type cannot cascade.  The cascade guard must peel the named wrapper —
	// otherwise it flags and the driven conversion returns a dangling raw slice.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("type Str @[]char\n")
	b.Write("func mk() Str { return make_slice(char, 3) }\n")
	b.Write("func f(p @[]char) @[]char {\n")
	b.Write("  if len(p) > 5 { return p }\n")
	b.Write("  return mk()\n")
	b.Write("}")
	if bcpFired(b.String()) {
		return "did not expect borrowable-char-param for a view + named-char-slice owned return"
	}
	return ""
}

func TestBorrowCharParamViewPlusMultiResultForward() testing.TestResult {
	// A view return plus a MULTI-VALUE call forward (`return g()` where g yields
	// (@[]char, int)): g's owned char-slice slot is forwarded into the cascade
	// slot.  The call node's type is g's signature (TYP_FUNC), not the @[]char
	// slot, so the guard must recognise the multi-result forward — otherwise it
	// flags and the driven return cascade dangles g's fresh allocation.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func g() (@[]char, int) { return make_slice(char, 3), 0 }\n")
	b.Write("func f(p @[]char) (@[]char, int) {\n")
	b.Write("  if len(p) > 5 { return p, 0 }\n")
	b.Write("  return g()\n")
	b.Write("}")
	if bcpFired(b.String()) {
		return "did not expect borrowable-char-param for a view + multi-result owned call forward"
	}
	return ""
}

func TestBorrowCharParamViewPlusFuncValueForward() testing.TestResult {
	// Like the multi-result forward, but the callee is a `*func` VALUE: the call
	// node's type is the func-value signature (TYP_FUNC_VALUE), not TYP_FUNC, so
	// the guard must accept func-value types too — otherwise g's owned char-slice
	// slot is forwarded into the cascade and the driven return dangles.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func producer() (@[]char, int) { var s @[]char = make_slice(char, 3); return s, 0 }\n")
	b.Write("func f(p @[]char) (@[]char, int) {\n")
	b.Write("  var fv *func() (@[]char, int) = producer\n")
	b.Write("  if len(p) == 0 { return fv() }\n")
	b.Write("  return p, 0\n")
	b.Write("}")
	if bcpFired(b.String()) {
		return "did not expect borrowable-char-param for a view + func-value multi-result forward"
	}
	return ""
}

// ============================================================
// Defect A: a family value stored into a non-retypeable managed sink
// (converting would be a hard type error → must NOT flag)
// ============================================================

func TestBorrowCharParamSubSliceStoredGlobal() testing.TestResult {
	// gg = p[1:] stores a sub-slice (an owned @[]char) into a @[]char global.
	// Converting p to *[]readonly char makes p[1:] a *[]readonly char and the store
	// `cannot assign *[]readonly char to @[]char` — an over-warn the rule avoids.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("var gg @[]char\n")
	b.Write("func f(p @[]char) { gg = p[1:len(p)] }")
	if bcpFired(b.String()) {
		return "did not expect borrowable-char-param when a sub-slice is stored into a managed global"
	}
	return ""
}

func TestBorrowCharParamSubSlicePassedToManagedCallee() testing.TestResult {
	// g(p[1:]) passes a sub-slice to a @[]char callee, which may own it.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func sink(x @[]char) { x[0] = 'a' }\n")
	b.Write("func f(p @[]char) { sink(p[1:len(p)]) }")
	if bcpFired(b.String()) {
		return "did not expect borrowable-char-param when a sub-slice flows to a @[]char callee"
	}
	return ""
}

// ============================================================
// Defect B: a laundered view alongside a fresh owned allocation
// (converting the return type would dangle → must NOT flag)
// ============================================================

func TestBorrowCharParamLaunderedViewPlusOwnedAlloc() testing.TestResult {
	// The view is laundered through a local (rest = name[1:]) and returned on one
	// path, but a fresh make_slice is returned on another.  The naive rule set
	// RetView only for a DIRECT param-view return, so it skipped the owned-return
	// check here and over-warned; the family analysis marks `return rest` as a
	// family return and the make_slice return blocks the cascade → must NOT flag.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func f(name @[]char) @[]char {\n")
	b.Write("  var rest @[]char = name[1:len(name)]\n")
	b.Write("  if len(name) > 5 { return rest }\n")
	b.Write("  return make_slice(char, 3)\n")
	b.Write("}")
	if bcpFired(b.String()) {
		return "did not expect borrowable-char-param for a laundered view + owned-alloc return"
	}
	return ""
}

// ============================================================
// Positive: a sub-slice passed to a *[]readonly char callee is a borrow
// ============================================================

func TestBorrowCharParamSubSlicePassedToBorrowCallee() testing.TestResult {
	// g(p[1:]) where g takes *[]readonly char: the sub-slice is only borrowed, so
	// the parameter is reducible to *[]readonly char — FLAG.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func sink(x *[]readonly char) int { return len(x) }\n")
	b.Write("func f(p @[]char) int { return sink(p[1:len(p)]) }")
	if !bcpFired(b.String()) {
		return "expected borrowable-char-param when a sub-slice flows only to a *[]readonly char callee"
	}
	return ""
}
