package "pkg/binate/lint"

import "pkg/builtins/testing"
import "pkg/std/strings"

// ============================================================
// borrowable-char-param: positive cases (flagged)
// ============================================================

// bcpSrc wraps a function body in a package, checks + lints it, and returns
// whether `borrowable-char-param` fired.
func bcpFired(src *[]readonly char) bool {
	var r @Result = lintSrc(src)
	return countRule(r, "borrowable-char-param") > 0
}

func TestBorrowCharParamViewSlice() testing.TestResult {
	// The canonical view helper: sub-slice + return.
	var src *[]readonly char = "package \"test\"\n"
			"func f(s @[]char) @[]char { return s[1:len(s) - 1] }"
	if !bcpFired(src) {
		return "expected borrowable-char-param for a view-helper sub-slice return"
	}
	return ""
}

func TestBorrowCharParamReadOnly() testing.TestResult {
	// Only index reads + len — no return of the parameter.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func f(s @[]char) bool {\n")
	b.Write("  for i := 0; i < len(s); i++ { if s[i] == 'x' { return true } }\n")
	b.Write("  return false\n")
	b.Write("}")
	if !bcpFired(b.String()) {
		return "expected borrowable-char-param for a read-only (len + index) parameter"
	}
	return ""
}

func TestBorrowCharParamReturnBare() testing.TestResult {
	// Returning the parameter directly (view) plus reads.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func f(s @[]char) @[]char {\n")
	b.Write("  if len(s) >= 2 && s[0] == '\"' { return s[1:len(s) - 1] }\n")
	b.Write("  return s\n")
	b.Write("}")
	if !bcpFired(b.String()) {
		return "expected borrowable-char-param when the parameter is returned as a view"
	}
	return ""
}

func TestBorrowCharParamSubSliceIntoManagedLocal() testing.TestResult {
	// A sub-slice stored into a @[]char local then returned: the PARAMETER's uses
	// are all borrows (len, index, sub-slice); the local's type is not a use of
	// the parameter.  (Mirrors ir.unqualifiedHelperName.)
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func f(n @[]char) @[]char {\n")
	b.Write("  var start int = 0\n")
	b.Write("  for i := 0; i < len(n); i++ { if n[i] == '.' { start = i + 1 } }\n")
	b.Write("  var rest @[]char = n[start:]\n")
	b.Write("  return rest\n")
	b.Write("}")
	if !bcpFired(b.String()) {
		return "expected borrowable-char-param for a sub-slice stored into a managed local"
	}
	return ""
}

// ============================================================
// borrowable-char-param: negative cases (not flagged)
// ============================================================

func TestBorrowCharParamElementMutation() testing.TestResult {
	// p[i] = e mutates the backing — genuinely needs @[]char.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func f(s @[]char) {\n")
	b.Write("  for i := 0; i < len(s); i++ { s[i] = 'x' }\n")
	b.Write("}")
	if bcpFired(b.String()) {
		return "did not expect borrowable-char-param for an element-mutated parameter"
	}
	return ""
}

func TestBorrowCharParamStored() testing.TestResult {
	// Stored whole into a managed global — an owning use.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("var g @[]char\n")
	b.Write("func f(s @[]char) { g = s }")
	if bcpFired(b.String()) {
		return "did not expect borrowable-char-param for a parameter stored into a global"
	}
	return ""
}

func TestBorrowCharParamWholeAliasIntoManagedLocal() testing.TestResult {
	// var x @[]char = s aliases the WHOLE parameter into a local, then returns it:
	// x joins the parameter's value family (it would become a *[]readonly char
	// borrow too), and the return cascades — a laundered view, so FLAG.  (The local
	// x is retyped as part of the conversion, exactly like s[lo:hi] laundering.)
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func f(s @[]char) @[]char { var x @[]char = s; return x }")
	if !bcpFired(b.String()) {
		return "expected borrowable-char-param for a whole-param alias laundered through a local"
	}
	return ""
}

func TestBorrowCharParamClosureCapture() testing.TestResult {
	// A nested closure capturing the parameter holds a live reference — owning, so
	// the parameter cannot be reduced to a raw borrow.  Must NOT flag.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func f(s @[]char) int {\n")
	b.Write("  var g @func() int = func() int { return len(s) }\n")
	b.Write("  return g()\n")
	b.Write("}")
	if bcpFired(b.String()) {
		return "did not expect borrowable-char-param when the parameter is captured by a closure"
	}
	return ""
}

func TestBorrowCharParamUnused() testing.TestResult {
	// A parameter with no uses is not flagged (unused-parameter concern).
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func f(s @[]char) int { return 0 }")
	if bcpFired(b.String()) {
		return "did not expect borrowable-char-param for an unused parameter"
	}
	return ""
}

func TestBorrowCharParamAddressOf() testing.TestResult {
	// &s takes the address of the parameter slot — an owning / escaping use.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func g(p *@[]char) {}\n")
	b.Write("func f(s @[]char) { g(&s) }")
	if bcpFired(b.String()) {
		return "did not expect borrowable-char-param when the parameter's address is taken"
	}
	return ""
}

func TestBorrowCharParamAddressOfElement() testing.TestResult {
	// &p[i] takes the address of a family ELEMENT — a raw pointer into the backing
	// that here enables a write (`*x = 'Z'`).  Converting p to *[]readonly char
	// would make &p[i] a *readonly char (a hard type error against *char, and the
	// code genuinely needs mutable backing), so this is an owning use — must NOT
	// flag.  (The whole-slice &p is caught too; this covers the element address.)
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func f(p @[]char) {\n")
	b.Write("  var x *char = &p[0]\n")
	b.Write("  *x = 'Z'\n")
	b.Write("}")
	if bcpFired(b.String()) {
		return "did not expect borrowable-char-param when the address of a parameter element is taken"
	}
	return ""
}
