package "pkg/binate/lint"

import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the borrowable-char-param leaf predicates
// (borrowable_char_param_util.bn): the exact `@[]char` parameter-type match
// (isManagedCharSliceParam) and the borrow-consuming callee-argument check
// (isRawReadonlyCharSlice / resolveCalleeFuncType).  Uses the shared `bcpFired`
// harness (borrowable_char_param_test.bn).

func TestBorrowCharParamCalleeReadonly() testing.TestResult {
	// Passed to a callee whose parameter is *[]readonly char — a borrow consumer.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func sink(x *[]readonly char) int { return len(x) }\n")
	b.Write("func f(s @[]char) int { return sink(s) }")
	if !bcpFired(b.String()) {
		return "expected borrowable-char-param when the parameter flows to a *[]readonly char callee"
	}
	return ""
}

func TestBorrowCharParamCalleeManaged() testing.TestResult {
	// Passed to a callee whose parameter is @[]char — the callee may own it, so
	// `f`'s parameter is owning.  (`sink` mutates its own parameter so that `sink`
	// is not itself a borrowable-char-param candidate, isolating this test to `f`.)
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func sink(x @[]char) { x[0] = 'a' }\n")
	b.Write("func f(s @[]char) { sink(s) }")
	if bcpFired(b.String()) {
		return "did not expect borrowable-char-param when the parameter flows to a @[]char callee"
	}
	return ""
}

func TestBorrowCharParamAlreadyRawReadonly() testing.TestResult {
	// A *[]readonly char parameter is already the recommended form — never flag.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func f(s *[]readonly char) @[]char { return s[0:len(s)] }")
	if bcpFired(b.String()) {
		return "did not expect borrowable-char-param for an already-*[]readonly char parameter"
	}
	return ""
}

func TestBorrowCharParamReadonlyManaged() testing.TestResult {
	// A @[]readonly char parameter is a distinct type (readonly element) — not the
	// @[]char spelling the rule targets.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func f(s @[]readonly char) @[]char { return s[0:len(s)] }")
	if bcpFired(b.String()) {
		return "did not expect borrowable-char-param for a @[]readonly char parameter"
	}
	return ""
}

func TestBorrowCharParamNonCharElem() testing.TestResult {
	// @[]int is not a char slice — out of scope.
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func f(s @[]int) int { return len(s) + s[0] }")
	if bcpFired(b.String()) {
		return "did not expect borrowable-char-param for a @[]int parameter"
	}
	return ""
}
