package "pkg/binate/lint"

import "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"

// ============================================================
// Rule: doubled-expose
// ============================================================
//
// Flags an `expose "P"` in a package's `.bni` that repeats an earlier expose of
// the same package.  A repeated expose is idempotent (pkg.expose.conflict): it
// re-exports nothing new, so it is almost always a merge leftover or a typo for
// another package.

// LintInterfaceFile runs the rules that read a package's `.bni` surface itself
// (`bni`, which may be nil for a package without one).
func LintInterfaceFile(c @check.Checker, bni @ast.File) @Result {
	var ctx @lintCtx = newCtx(c)
	if bni != nil {
		lintDoubledExposes(ctx, bni)
	}
	return ctx.Result
}

// lintDoubledExposes reports each `expose` of bni whose package an earlier one
// already exposes.
func lintDoubledExposes(ctx @lintCtx, bni @ast.File) {
	for i := 0; i < len(bni.Decls); i++ {
		var d @ast.Decl = bni.Decls[i]
		if d == nil || d.Kind != ast.DECL_EXPOSE { continue }
		for j := 0; j < i; j++ {
			var e @ast.Decl = bni.Decls[j]
			if e != nil && e.Kind == ast.DECL_EXPOSE && streq(e.Name, d.Name) {
				addDiag(ctx, d.Pos, "doubled-expose",
						buf.Concat(buf.Concat("expose ", d.Name), " repeats an earlier expose of the same package"))
				break
			}
		}
	}
}
