package "pkg/binate/lint"

import "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// lintBniSrc parses src as a `.bni` and runs the interface-surface rules on it.
func lintBniSrc(src *[]readonly char) @Result {
	var p @parser.Parser = parser.NewInterface(toBytes(src), "test.bni")
	var bni @ast.File = p.ParseFile()
	return LintInterfaceFile(check.NewChecker(), bni)
}

// A repeated expose of one package is flagged once, at the repeat; exposes of
// distinct packages are not.
func TestDoubledExpose() testing.TestResult {
	var r @Result = lintBniSrc(
			"package \"pkg/q\"\nexpose \"pkg/a\"\nexpose \"pkg/b\"\nexpose \"pkg/a\"\n")
	if r.Diags.Len() != 1 { return fail("expected one doubled-expose diagnostic") }
	var d Diagnostic = r.Diags.Get(0)
	if !streq(d.Rule, "doubled-expose") || d.Pos.Line != 4 { return fail(d.Message) }
	if lintBniSrc("package \"pkg/q\"\nexpose \"pkg/a\"\nexpose \"pkg/b\"\n").Diags.Len() != 0 {
		return fail("distinct exposes must not be flagged")
	}
	if LintInterfaceFile(check.NewChecker(), nil).Diags.Len() != 0 {
		return fail("a package without a .bni has nothing to flag")
	}
	return ""
}
