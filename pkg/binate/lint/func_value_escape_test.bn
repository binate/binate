package "pkg/binate/lint"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for the func-value-escape and managed-func-raw-capture
// rules in func_value_escape.bn.  Both rules pin canonical
// danger-pattern shapes from plan-function-values-phase-2.md B.5.

// Capturing *func returned from the enclosing frame fires
// func-value-escape: the closure struct is stack-bound to the
// returning function's frame and the captures will dangle.
func TestFuncValueEscapeCapturingReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func makeAdder(base int) *func(int) int {\n"
		"  return func(x int) int { return base + x }\n"
		"}\n")
	var r @Result = lintSrc(cb.Bytes())
	return expectDiag(r, "func-value-escape")
}

// Non-capturing *func returned from the enclosing frame is fine —
// no closure struct to dangle.  Pin the negative case so the rule
// doesn't false-positive on the non-capturing path.
func TestFuncValueEscapeNonCapturingReturnNoWarn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func plain() *func(int) int {\n"
		"  return func(x int) int { return x * 2 }\n"
		"}\n")
	var r @Result = lintSrc(cb.Bytes())
	return expectNoDiag(r, "func-value-escape")
}

// Capturing literal flowing into @func via the return slot —
// once the checker's context-propagation lifts returns (today
// only VarDecl is wired), the literal's resolved type becomes
// @func and the *func-escape rule MUST stay silent (the @func
// is refcount-managed and outliving the frame is the whole
// point).  Today the literal still resolves as *func at the
// return site (no hint propagation), so the rule WOULD warn —
// once return-slot propagation lands the rule's @func gate
// keeps it silent automatically.  This test pins the gate.
func TestFuncValueEscapeManagedNoWarn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var k int = 7\n"
		"  var f @func() int = func() int { return k }\n"
		"  _ = f\n"
		"}\n")
	var r @Result = lintSrc(cb.Bytes())
	return expectNoDiag(r, "func-value-escape")
}

// @func capturing a raw pointer (CAP_RAW_PTR) fires the
// managed-func-raw-capture rule.  The @func itself can outlive
// any frame via refcount, but the captured *T's lifetime
// piggy-backs on its source variable.
func TestManagedFuncRawCaptureFires() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Box struct { N int }\n"
		"func main() {\n"
		"  var b Box\n"
		"  b.N = 7\n"
		"  var p *Box = &b\n"
		"  var f @func() int = func() int { return p.N }\n"
		"  _ = f\n"
		"}\n")
	var r @Result = lintSrc(cb.Bytes())
	return expectDiag(r, "managed-func-raw-capture")
}

// @func capturing a managed pointer (CAP_MANAGED, not CAP_RAW_PTR)
// is safe — the captured @T is refcounted via the closure struct
// dtor (B.3a infrastructure).  Rule MUST NOT fire.
func TestManagedFuncManagedCaptureNoWarn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Box struct { N int }\n"
		"func main() {\n"
		"  var b @Box = make(Box)\n"
		"  b.N = 7\n"
		"  var f @func() int = func() int { return b.N }\n"
		"  _ = f\n"
		"}\n")
	var r @Result = lintSrc(cb.Bytes())
	return expectNoDiag(r, "managed-func-raw-capture")
}

// *func capturing a raw pointer is fine for that rule — the *func
// flavour doesn't promise lifetime extension beyond its frame, so
// raw-pointer captures are no more dangerous than the *func
// itself.  The managed-func-raw-capture rule MUST NOT fire here.
// (The *func-escape rule may fire if the *func is returned, but
// that's a different rule.)
func TestRawFuncRawCaptureNoManagedWarn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Box struct { N int }\n"
		"func main() {\n"
		"  var b Box\n"
		"  b.N = 7\n"
		"  var p *Box = &b\n"
		"  var f *func() int = func() int { return p.N }\n"
		"  _ = f\n"
		"}\n")
	var r @Result = lintSrc(cb.Bytes())
	return expectNoDiag(r, "managed-func-raw-capture")
}
