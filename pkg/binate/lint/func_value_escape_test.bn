package "pkg/binate/lint"

import "pkg/builtins/testing"

// Tests for the func-value-escape and managed-func-raw-capture
// rules in func_value_escape.bn.  Both rules pin canonical
// danger-pattern shapes from plan-function-values-phase-2.md B.5.

// Capturing *func returned from the enclosing frame fires
// func-value-escape: the closure struct is stack-bound to the
// returning function's frame and the captures will dangle.
func TestFuncValueEscapeCapturingReturn() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"func makeAdder(base int) *func(int) int {\n"
		"  return func(x int) int { return base + x }\n"
		"}\n")
	return expectDiag(r, "func-value-escape")
}

// Non-capturing *func returned from the enclosing frame is fine —
// no closure struct to dangle.  Pin the negative case so the rule
// doesn't false-positive on the non-capturing path.
func TestFuncValueEscapeNonCapturingReturnNoWarn() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"func plain() *func(int) int {\n"
		"  return func(x int) int { return x * 2 }\n"
		"}\n")
	return expectNoDiag(r, "func-value-escape")
}

// Capturing literal flowing into @func via the return slot —
// once the checker's context-propagation lifts returns (today
// only VarDecl is wired), the literal's resolved type becomes
// @func and the *func-escape rule MUST stay silent (the @func
// is refcount-managed and outliving the frame is the whole
// point).  Today the literal still resolves as *func at the
// return site (no hint propagation), so the rule WOULD warn —
// once return-slot propagation lands the rule's @func gate
// keeps it silent automatically.  This test pins the gate.
func TestFuncValueEscapeManagedNoWarn() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"func main() {\n"
		"  var k int = 7\n"
		"  var f @func() int = func() int { return k }\n"
		"  _ = f\n"
		"}\n")
	return expectNoDiag(r, "func-value-escape")
}

// @func capturing a raw pointer (CAP_RAW_PTR) fires the
// managed-func-raw-capture rule.  The @func itself can outlive
// any frame via refcount, but the captured *T's lifetime
// piggy-backs on its source variable.
func TestManagedFuncRawCaptureFires() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"type Box struct { N int }\n"
		"func main() {\n"
		"  var b Box\n"
		"  b.N = 7\n"
		"  var p *Box = &b\n"
		"  var f @func() int = func() int { return p.N }\n"
		"  _ = f\n"
		"}\n")
	return expectDiag(r, "managed-func-raw-capture")
}

// @func capturing a managed pointer (CAP_MANAGED, not CAP_RAW_PTR)
// is safe — the captured @T is refcounted via the closure struct
// dtor (B.3a infrastructure).  Rule MUST NOT fire.
func TestManagedFuncManagedCaptureNoWarn() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"type Box struct { N int }\n"
		"func main() {\n"
		"  var b @Box = make(Box)\n"
		"  b.N = 7\n"
		"  var f @func() int = func() int { return b.N }\n"
		"  _ = f\n"
		"}\n")
	return expectNoDiag(r, "managed-func-raw-capture")
}

// *func capturing a raw pointer is fine for that rule — the *func
// flavour doesn't promise lifetime extension beyond its frame, so
// raw-pointer captures are no more dangerous than the *func
// itself.  The managed-func-raw-capture rule MUST NOT fire here.
// (The *func-escape rule may fire if the *func is returned, but
// that's a different rule.)
func TestRawFuncRawCaptureNoManagedWarn() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"type Box struct { N int }\n"
		"func main() {\n"
		"  var b Box\n"
		"  b.N = 7\n"
		"  var p *Box = &b\n"
		"  var f *func() int = func() int { return p.N }\n"
		"  _ = f\n"
		"}\n")
	return expectNoDiag(r, "managed-func-raw-capture")
}

// Local `var f *func(...) = <capturing literal>` — same frame for the var slot
// and the closure struct, so no escape and no warn.  A var decl is not a
// func-value-escape site (the rule fires only on returns / escaping
// assignments); this guards against the rule over-firing on a safe local.
func TestFuncValueEscapeLocalVarNoWarn() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"func main() {\n"
		"  var k int = 10\n"
		"  var f *func(int) int = func(x int) int { return k + x }\n"
		"  _ = f\n"
		"}\n")
	return expectNoDiag(r, "func-value-escape")
}

// `p.cb = <capturing literal>` with `p *S` — write through a
// pointer-receiver SELECTOR stores into a heap-rooted struct's
// field, outliving the local frame.  Fires `func-value-escape`.
func TestFuncValueEscapeFieldThroughPointerFires() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"type S struct { Cb *func(int) int }\n"
		"func main() {\n"
		"  var s S\n"
		"  var p *S = &s\n"
		"  var k int = 7\n"
		"  p.Cb = func(x int) int { return k + x }\n"
		"  _ = p\n"
		"}\n")
	return expectDiag(r, "func-value-escape")
}

// `s.Cb = <capturing literal>` with `s S` (value receiver) — the
// struct value sits on the stack, same frame as the closure.
// Pin the negative case so the rule doesn't over-fire on the
// value-receiver shape.
func TestFuncValueEscapeFieldOnLocalValueNoWarn() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"type S struct { Cb *func(int) int }\n"
		"func main() {\n"
		"  var s S\n"
		"  var k int = 7\n"
		"  s.Cb = func(x int) int { return k + x }\n"
		"  _ = s\n"
		"}\n")
	return expectNoDiag(r, "func-value-escape")
}

// `m.Cb = <capturing literal>` with `m @S` (managed receiver) —
// auto-deref through a managed pointer stores into a heap-rooted
// struct's field.  Fires.
func TestFuncValueEscapeFieldThroughManagedFires() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"type S struct { Cb *func(int) int }\n"
		"func main() {\n"
		"  var m @S = make(S)\n"
		"  var k int = 7\n"
		"  m.Cb = func(x int) int { return k + x }\n"
		"  _ = m\n"
		"}\n")
	return expectDiag(r, "func-value-escape")
}

// `s[i] = <capturing literal>` with `s @[]*func(int) int` — element
// write through a managed-slice stores into the backing allocation
// which outlives the local frame.  Fires.
func TestFuncValueEscapeSliceIndexFires() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"func main() {\n"
		"  var s @[]*func(int) int = make_slice(*func(int) int, 1)\n"
		"  var k int = 7\n"
		"  s[0] = func(x int) int { return k + x }\n"
		"  _ = s\n"
		"}\n")
	return expectDiag(r, "func-value-escape")
}

// `*p = <capturing literal>` with `p **func(int) int` — UNARY
// STAR LHS stores through a pointer.  Fires.
func TestFuncValueEscapeDerefLhsFires() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"func main() {\n"
		"  var fn *func(int) int\n"
		"  var p **func(int) int = &fn\n"
		"  var k int = 7\n"
		"  *p = func(x int) int { return k + x }\n"
		"  _ = p\n"
		"}\n")
	return expectDiag(r, "func-value-escape")
}

// Nested literals: an outer @func capturing literal that itself
// contains an inner @func capturing literal — both should be
// reached by the walker.  The inner one captures a *T and so
// the rule should fire on the inner capture, not just the outer.
func TestManagedFuncRawCaptureNestedReached() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"type Box struct { N int }\n"
		"func main() {\n"
		"  var b Box\n"
		"  b.N = 7\n"
		"  var p *Box = &b\n"
		"  var outer @func() int = func() int {\n"
		"    var inner @func() int = func() int { return p.N }\n"
		"    return inner()\n"
		"  }\n"
		"  _ = outer\n"
		"}\n")
	// Two diagnostics: outer captures p (because the inner
	// literal's capture flows through the outer's frame too),
	// AND inner captures p directly.  At minimum the rule must
	// have fired — count by iterating.
	var count int = 0
	for i := 0; i < r.NumDiags; i++ {
		if charEq(r.Diags[i].Rule, "managed-func-raw-capture") {
			count = count + 1
		}
	}
	if count < 1 {
		return fail("expected at least one managed-func-raw-capture diagnostic for nested literal")
	}
	return ""
}

// func-value-escape fires for a NAMED *func too (`type Fn *func(...)`): the
// named wrapper must not hide the stack-closure escape (the lint peels it).
func TestFuncValueEscapeNamedRawReturn() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"type Fn *func(int) int\n"
		"func makeAdder(base int) Fn {\n"
		"  return func(x int) int { return base + x }\n"
		"}\n")
	return expectDiag(r, "func-value-escape")
}

// A NAMED @func return is the safe (heap+refcount) path -- no escape warning.
func TestFuncValueEscapeNamedManagedReturnNoWarn() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"type Fn @func(int) int\n"
		"func makeAdder(base int) Fn {\n"
		"  return func(x int) int { return base + x }\n"
		"}\n")
	return expectNoDiag(r, "func-value-escape")
}

// managed-func-raw-capture fires through a NAMED @func wrapper too.
func TestManagedFuncRawCaptureNamed() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"type Box struct { v int }\n"
		"type Fn @func() int\n"
		"func mk(p *Box) Fn {\n"
		"  return func() int { return p.v }\n"
		"}\n")
	return expectDiag(r, "managed-func-raw-capture")
}
