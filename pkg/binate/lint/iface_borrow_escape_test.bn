package "pkg/binate/lint"

import "pkg/builtins/testing"

// Tests for the iface-borrow-escape rule in iface_borrow_escape.bn.  The rule
// flags a raw interface value (`*Iface` / `*any`) that borrows frame-local
// storage and escapes the frame — via a `return` or a store into a location
// that outlives the frame.  Two shapes: a NAMED borrow variable escaping later
// (`var iv *any = 42; … return iv`), and a DIRECT value-borrow at the escape
// site (`func f(x int) *any { return x }`).  The negatives pin the frame-
// locality boundary so the rule never flags a source that outlives the frame
// (a global, a managed borrow, a heap field, or a non-escaping local).

// ============================================================
// Positive: named borrow variable escaping via return
// ============================================================

// `var iv *any = 42` materialises a frame temporary and borrows it; the later
// `return iv` escapes that borrow.  This is the motivating case the checker's
// construction-time position rule cannot catch.
func TestIfaceBorrowEscapeNamedRvalueReturn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"func f() *any {\n"
					"  var iv *any = 42\n"
					"  return iv\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// The escape via a LATER statement (an intervening declaration between the
// borrow and the return) — the borrow variable is frame-scoped, so the return
// still dangles.  Pins the cross-statement nature.
func TestIfaceBorrowEscapeNamedCrossStatement() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"func f() *any {\n"
					"  var iv *any = 42\n"
					"  var z int = 1\n"
					"  _ = z\n"
					"  return iv\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// `var iv *any = localVar` (implicit borrow of a frame-local lvalue) then
// `return iv` — named borrow of a local escaping.
func TestIfaceBorrowEscapeNamedLocalReturn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"func f() *any {\n"
					"  var g int = 5\n"
					"  var iv *any = g\n"
					"  return iv\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// ============================================================
// Positive: direct value-borrow at the escape site
// ============================================================

// `func f(x int) *any { return x }` — a parameter (frame-local value) borrowed
// directly into the raw-interface return slot; no visible `&`.
func TestIfaceBorrowEscapeDirectParamReturn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"func f(x int) *any {\n"
					"  return x\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// A local variable borrowed directly into the return slot.
func TestIfaceBorrowEscapeDirectLocalReturn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"func f() *any {\n"
					"  var g int = 5\n"
					"  return g\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// An EXPLICIT `&local` into the raw-interface return slot — the same dangling
// borrow, spelled with the `&`.
func TestIfaceBorrowEscapeDirectExplicitAmpReturn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"func f() *any {\n"
					"  var g int = 5\n"
					"  return &g\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// A user-declared interface (not `any`), with the required `impl *T : I`: a
// value local borrowed directly into the raw `*I` return slot.  Exercises the
// type-soundness slot recognition (a value source into a `*Named` slot type-
// checks only when Named is an interface).
func TestIfaceBorrowEscapeDirectUserInterfaceReturn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"interface I { foo() int }\n"
					"type T struct { x int }\n"
					"func (t *T) foo() int { return t.x }\n"
					"impl *T : I\n"
					"func mk() *I {\n"
					"  var a T\n"
					"  a.x = 3\n"
					"  return a\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// The same user interface via the NAMED-borrow-variable path: `var iv *I = a`
// (a var-init value-borrow) escaping through a later `return iv`.
func TestIfaceBorrowEscapeNamedUserInterfaceReturn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"interface I { foo() int }\n"
					"type T struct { x int }\n"
					"func (t *T) foo() int { return t.x }\n"
					"impl *T : I\n"
					"func mk() *I {\n"
					"  var a T\n"
					"  a.x = 3\n"
					"  var iv *I = a\n"
					"  return iv\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// A user interface whose value source is a GLOBAL (086's safe pattern) — the
// borrow outlives the frame, so the rule must not fire.
func TestIfaceBorrowEscapeUserInterfaceGlobalNoWarn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"interface I { foo() int }\n"
					"type T struct { x int }\n"
					"func (t *T) foo() int { return t.x }\n"
					"impl *T : I\n"
					"var g T\n"
					"func mk() *I {\n"
					"  return g\n"
					"}\n")
	return expectNoDiag(r, "iface-borrow-escape")
}

// ============================================================
// Positive: escaping store (into a heap-rooted location)
// ============================================================

// `p.v = x` with `p *Box` — a direct value-borrow stored through a pointer-
// receiver selector into a heap-rooted struct field that outlives the frame.
func TestIfaceBorrowEscapeDirectStoreThroughPointer() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"type Box struct { v *any }\n"
					"func f(p *Box, x int) {\n"
					"  p.v = x\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// `var iv *any = x; p.v = iv` — a named borrow variable stored into a heap-
// rooted field.
func TestIfaceBorrowEscapeNamedStoreThroughPointer() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"type Box struct { v *any }\n"
					"func f(p *Box, x int) {\n"
					"  var iv *any = x\n"
					"  p.v = iv\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// ============================================================
// Negative: sources that outlive the frame, or don't escape
// ============================================================

// A borrow variable that never escapes (`_ = iv`) — a var decl is not an
// escape site; the rule must not fire on a safe local.
func TestIfaceBorrowEscapeLocalNoEscapeNoWarn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"func f() {\n"
					"  var iv *any = 42\n"
					"  _ = iv\n"
					"}\n")
	return expectNoDiag(r, "iface-borrow-escape")
}

// `return G` with `G` a package global — the borrow roots in a global that
// outlives every frame, so it never dangles.  The critical no-false-positive
// case.
func TestIfaceBorrowEscapeDirectGlobalReturnNoWarn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"var G int = 7\n"
					"func f() *any {\n"
					"  return G\n"
					"}\n")
	return expectNoDiag(r, "iface-borrow-escape")
}

// `var iv *any = G; return iv` with `G` a global — `iv` borrows a global, so it
// is not a frame-local borrow variable and its escape must not warn.
func TestIfaceBorrowEscapeNamedGlobalNoWarn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"var G int = 7\n"
					"func f() *any {\n"
					"  var iv *any = G\n"
					"  return iv\n"
					"}\n")
	return expectNoDiag(r, "iface-borrow-escape")
}

// A plain value return (`func f(x int) int { return x }`) — the return slot is
// not a raw interface value, so no borrow is constructed and the rule stays
// silent.  Guards against flagging every `return localVar`.
func TestIfaceBorrowEscapePlainValueReturnNoWarn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"func f(x int) int {\n"
					"  return x\n"
					"}\n")
	return expectNoDiag(r, "iface-borrow-escape")
}

// A managed source (`@Sq`) borrowed into `*any` — a managed-to-raw interface
// borrow, which is the ordinary raw-pointer-escape concern, out of THIS rule's
// scope.  The rule must not fire (documented gap).
func TestIfaceBorrowEscapeManagedSourceNoWarn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"type Sq struct { s int }\n"
					"func f(p @Sq) *any {\n"
					"  return p\n"
					"}\n")
	return expectNoDiag(r, "iface-borrow-escape")
}

// `return &a` into a `*T` STRUCT pointer slot — a plain raw-pointer escape, a
// different concern this rule is not scoped to.  The explicit `&` into a non-
// `any` `*Named` slot must NOT be mistaken for an interface borrow (the slot is
// a struct pointer, not an interface value).  Guards the soundness heuristic.
func TestIfaceBorrowEscapeStructPointerReturnNoWarn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"type T struct { x int }\n"
					"func mk() *T {\n"
					"  var a T\n"
					"  a.x = 3\n"
					"  return &a\n"
					"}\n")
	return expectNoDiag(r, "iface-borrow-escape")
}

// `b.v = x` with `b` a LOCAL value struct — the store target sits in this
// frame, so nothing escapes.  Pins the value-receiver store negative.
func TestIfaceBorrowEscapeStoreLocalValueNoWarn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"type Box struct { v *any }\n"
					"func f(x int) {\n"
					"  var b Box\n"
					"  b.v = x\n"
					"  _ = b\n"
					"}\n")
	return expectNoDiag(r, "iface-borrow-escape")
}

// ============================================================
// Scope / flow correctness (regression on adversarial-review findings)
// ============================================================

// `return total` where `total` is a package GLOBAL and a DISJOINT for-loop
// declares a like-named loop variable — a scope-blind name set would misread the
// global return as frame-local.  With lexical scoping the loop `total` is out of
// scope at the return, so this safe global return must NOT fire.
func TestIfaceBorrowEscapeGlobalShadowedByLoopVarNoWarn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"var total int = 100\n"
					"func sum() *any {\n"
					"  for total := 0; total < 3; total++ {\n"
					"  }\n"
					"  return total\n"
					"}\n")
	return expectNoDiag(r, "iface-borrow-escape")
}

// `var iv *any = G` (borrows a global) returned, with an unrelated same-named
// borrow variable in a DISJOINT block.  A scope-blind borrow-var set would taint
// the outer `iv`; with lexical scoping the inner `iv` is out of scope, so the
// safe outer return must NOT fire.
func TestIfaceBorrowEscapeBorrowVarShadowNoWarn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"var G int = 7\n"
					"func f() *any {\n"
					"  {\n"
					"    var iv *any = 42\n"
					"    _ = iv\n"
					"  }\n"
					"  var iv *any = G\n"
					"  return iv\n"
					"}\n")
	return expectNoDiag(r, "iface-borrow-escape")
}

// A borrow variable REASSIGNED to an outliving source (a global) before it
// escapes — its post-assignment source is safe, so returning it must NOT fire
// (flow-sensitivity: reassignment drops the borrow-var taint).
func TestIfaceBorrowEscapeReassignedToGlobalNoWarn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"var g int = 7\n"
					"func f(x int) *any {\n"
					"  var iv *any = x\n"
					"  iv = g\n"
					"  return iv\n"
					"}\n")
	return expectNoDiag(r, "iface-borrow-escape")
}

// `return nil` from a function whose return slot is a raw pointer-to-named type
// (`*Node`, not an interface) — nil borrows nothing, so it must NOT fire.
func TestIfaceBorrowEscapeReturnNilNoWarn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"type Node struct { key int }\n"
					"func find(head *Node) *Node {\n"
					"  if head != nil {\n"
					"    return head\n"
					"  }\n"
					"  return nil\n"
					"}\n")
	return expectNoDiag(r, "iface-borrow-escape")
}

// A frame-local value-borrow stored into a GLOBAL struct field — the global
// outlives the frame, so this is a genuine dangling-borrow escape and MUST fire
// (a global is a longer-lived location, like a heap store through a pointer).
func TestIfaceBorrowEscapeStoreIntoGlobalFires() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"type Box struct { v *any }\n"
					"var G Box\n"
					"func f(x int) {\n"
					"  G.v = x\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// A frame-local value-borrow stored through a pointer in a for-loop's POST
// clause — the escape site must be walked even in the loop header.
func TestIfaceBorrowEscapeStoreInForPostFires() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"type Box struct { v *any }\n"
					"func f(p *Box, x int) {\n"
					"  for i := 0; i < 1; p.v = x {\n"
					"  }\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// A NESTED same-name shadow: an inner `var iv *any = G` (borrows a global —
// safe) shadows an outer frame-local borrow variable `iv`.  Name resolution
// must stop at the nearer non-borrow binding, so the inner `return iv` must NOT
// fire (the outer borrow must not leak into the inner scope).
func TestIfaceBorrowEscapeNestedShadowNoWarn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"var G int = 7\n"
					"func f(c bool) *any {\n"
					"  var local int = 5\n"
					"  var iv *any = local\n"
					"  _ = iv\n"
					"  if c {\n"
					"    var iv *any = G\n"
					"    return iv\n"
					"  }\n"
					"  return G\n"
					"}\n")
	return expectNoDiag(r, "iface-borrow-escape")
}

// The reassignment-drop must be PER-SCOPE: a borrow variable reassigned inside a
// disjoint block must not suppress a distinct same-named borrow variable in an
// outer scope.  The outer `var iv *any = x; return iv` genuinely escapes and
// MUST fire despite the inner block's `iv = g` drop.
func TestIfaceBorrowEscapeDropIsPerScopeFires() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"var g int = 7\n"
					"func f(x int) *any {\n"
					"  {\n"
					"    var iv *any = x\n"
					"    iv = g\n"
					"    _ = iv\n"
					"  }\n"
					"  var iv *any = x\n"
					"  return iv\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// A type switch binds `v` to a recovered value (a frame-local); returning it
// into `*any` borrows that frame temporary and escapes, so it must fire.  Pins
// that the type-switch binder is tracked as frame-local.
func TestIfaceBorrowEscapeTypeSwitchBinderFires() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"func f(x *any) *any {\n"
					"  switch v := x.(type) {\n"
					"  case int:\n"
					"    return v\n"
					"  }\n"
					"  return x\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// ============================================================
// Aggregate footgun (Opts{Any: x}) — embedded raw-interface field
// ============================================================

// The spec canonical footgun: returning a struct literal whose raw-interface
// field is a value-borrow of a frame-local (`return Opts{a: x}`).  The struct
// escapes by value carrying a dangling borrow, so it must fire.
func TestIfaceBorrowEscapeAggregateDirectReturnFires() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"type Opts struct { a *any }\n"
					"func f(x int) Opts {\n"
					"  return Opts{a: x}\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// A named aggregate variable initialised by such a composite, then returned.
func TestIfaceBorrowEscapeAggregateNamedVarFires() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"type Opts struct { a *any }\n"
					"func f(x int) Opts {\n"
					"  var o Opts = Opts{a: x}\n"
					"  return o\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// The `:=` short-var spelling of the named-aggregate footgun — the idiomatic
// form — must fire just like the `var o Opts = ...` spelling.
func TestIfaceBorrowEscapeAggregateShortVarFires() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"type Opts struct { a *any }\n"
					"func f(x int) Opts {\n"
					"  o := Opts{a: x}\n"
					"  return o\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// A `:=` aggregate whose field borrows a GLOBAL is safe and must NOT fire (pins
// that the short-var aggregate path still respects frame-locality).
func TestIfaceBorrowEscapeAggregateShortVarGlobalNoWarn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"type Opts struct { a *any }\n"
					"var g int = 7\n"
					"func f() Opts {\n"
					"  o := Opts{a: g}\n"
					"  return o\n"
					"}\n")
	return expectNoDiag(r, "iface-borrow-escape")
}

// A nested composite: the embedded borrow is one aggregate level deep.
func TestIfaceBorrowEscapeAggregateNestedFires() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"type Inner struct { a *any }\n"
					"type Outer struct { inner Inner }\n"
					"func f(x int) Outer {\n"
					"  return Outer{inner: Inner{a: x}}\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// Storing such an aggregate into a global (a longer-lived location) fires.
func TestIfaceBorrowEscapeAggregateStoreGlobalFires() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"type Opts struct { a *any }\n"
					"var G Opts\n"
					"func f(x int) {\n"
					"  G = Opts{a: x}\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// A POSITIONAL struct-literal element (no field name) borrowing a frame-local
// into a raw-interface field — exercises the positional field-by-index path.
func TestIfaceBorrowEscapeAggregatePositionalFires() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"type Opts struct { a *any }\n"
					"func f(x int) Opts {\n"
					"  return Opts{x}\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// An ARRAY literal whose element type is a raw interface, borrowing a frame-local
// — exercises the array/slice element-type (`.Elem`) path.
func TestIfaceBorrowEscapeAggregateArrayElemFires() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"func f(x int) [1]*any {\n"
					"  return [1]*any{x}\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}

// A composite whose borrowed field is NOT a raw interface (a plain value field)
// copies the value — no borrow, no escape.  Must NOT fire.
func TestIfaceBorrowEscapeAggregateNonIfaceFieldNoWarn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"type Opts struct { n int }\n"
					"func f(x int) Opts {\n"
					"  return Opts{n: x}\n"
					"}\n")
	return expectNoDiag(r, "iface-borrow-escape")
}

// A composite whose raw-interface field borrows a GLOBAL (outlives the frame)
// must NOT fire.
func TestIfaceBorrowEscapeAggregateGlobalSourceNoWarn() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"type Opts struct { a *any }\n"
					"var g int = 7\n"
					"func f() Opts {\n"
					"  return Opts{a: g}\n"
					"}\n")
	return expectNoDiag(r, "iface-borrow-escape")
}

// A value-borrow escape nested inside an if/for block body still fires (the walk
// descends control-flow blocks).
func TestIfaceBorrowEscapeNestedBlockReturnFires() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\n"
					"func f(x int, c bool) *any {\n"
					"  if c {\n"
					"    return x\n"
					"  }\n"
					"  return x\n"
					"}\n")
	return expectDiag(r, "iface-borrow-escape")
}
