package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/containers/vec"

// Unit tests for the pure frame-locality / slot-recognition helpers in
// iface_borrow_escape_util.bn.  The escCtx-dependent predicates
// (lvalueFrameLocal, borrowSourceFrameLocal) and the walk are exercised
// end-to-end in iface_borrow_escape_test.bn.

// mkNamedTexpr builds a `TEXPR_NAMED` type expression `pkg.name` (empty pkg for
// an unqualified name).
func mkNamedTexpr(pkg @[]char, name @[]char) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_NAMED
	te.Pkg = pkg
	te.Name = name
	return te
}

// mkPtrTexpr builds a `TEXPR_POINTER` wrapping `base`.
func mkPtrTexpr(base @ast.TypeExpr) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_POINTER
	te.Base = base
	return te
}

// mkExpr builds an expression node of the given kind and operator token.
func mkExpr(kind int, op int) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = kind
	e.Op = op
	return e
}

func TestTypeIsRawIfaceValueHelper() testing.TestResult {
	var iv @types.Type = types.MakeInterfaceValueType(types.MakeInterfaceType("m", "I"))
	if !typeIsRawIfaceValue(iv) {
		return fail("typeIsRawIfaceValue(*I) should be true")
	}
	if typeIsRawIfaceValue(types.TypInt()) {
		return fail("typeIsRawIfaceValue(int) should be false")
	}
	if typeIsRawIfaceValue(types.MakePointerType(types.TypInt())) {
		return fail("typeIsRawIfaceValue(*int) should be false")
	}
	if typeIsRawIfaceValue(nil) {
		return fail("typeIsRawIfaceValue(nil) should be false")
	}
	return ""
}

func TestPeelTexprWrappersHelper() testing.TestResult {
	var named @ast.TypeExpr = mkNamedTexpr("", "I")
	var wrapped @ast.TypeExpr = make(ast.TypeExpr)
	wrapped.Kind = ast.TEXPR_CONST
	wrapped.Base = named
	var peeled @ast.TypeExpr = peelTexprWrappers(wrapped)
	if peeled == nil || peeled.Kind != ast.TEXPR_NAMED {
		return fail("peelTexprWrappers should strip TEXPR_CONST to the named type")
	}
	return ""
}

func TestReturnSlotIsAnyPointerHelper() testing.TestResult {
	if !returnSlotIsAnyPointer(mkPtrTexpr(mkNamedTexpr("", "any"))) {
		return fail("*any should be recognised as the any pointer")
	}
	if returnSlotIsAnyPointer(mkPtrTexpr(mkNamedTexpr("", "Shape"))) {
		return fail("*Shape is not *any")
	}
	if returnSlotIsAnyPointer(mkPtrTexpr(mkNamedTexpr("pkg", "any"))) {
		return fail("*pkg.any is not the universal *any")
	}
	if returnSlotIsAnyPointer(mkNamedTexpr("", "any")) {
		return fail("bare any (not a pointer) is not *any")
	}
	return ""
}

func TestReturnSlotIsPointerToNamedHelper() testing.TestResult {
	if !returnSlotIsPointerToNamed(mkPtrTexpr(mkNamedTexpr("", "Shape"))) {
		return fail("*Shape is a pointer-to-named")
	}
	if returnSlotIsPointerToNamed(mkNamedTexpr("", "Shape")) {
		return fail("bare Shape is not a pointer-to-named")
	}
	var slice @ast.TypeExpr = make(ast.TypeExpr)
	slice.Kind = ast.TEXPR_SLICE
	if returnSlotIsPointerToNamed(mkPtrTexpr(slice)) {
		return fail("*[]T (pointer to slice) is not a pointer-to-named")
	}
	return ""
}

func TestSourceIsImplicitValueBorrowHelper() testing.TestResult {
	if sourceIsImplicitValueBorrow(mkExpr(ast.EXPR_UNARY, cast(int, token.AMP))) {
		return fail("&x is an explicit borrow, not implicit")
	}
	if !sourceIsImplicitValueBorrow(mkExpr(ast.EXPR_IDENT, 0)) {
		return fail("a bare identifier is an implicit value-borrow source")
	}
	return ""
}

func TestIsAddressableExprShapeHelper() testing.TestResult {
	if !isAddressableExprShape(mkExpr(ast.EXPR_IDENT, 0)) {
		return fail("an identifier has addressable shape")
	}
	if isAddressableExprShape(mkExpr(ast.EXPR_INT_LIT, 0)) {
		return fail("an int literal is not an addressable shape")
	}
	if !isAddressableExprShape(mkExpr(ast.EXPR_UNARY, cast(int, token.STAR))) {
		return fail("a dereference *p has addressable shape")
	}
	if isAddressableExprShape(mkExpr(ast.EXPR_UNARY, cast(int, token.AMP))) {
		return fail("&x (address-of) is not an addressable-lvalue shape")
	}
	return ""
}

func TestNameInVecHelper() testing.TestResult {
	var v @vec.Vec[@[]char] = vec.New[@[]char]()
	v.Push("alpha")
	v.Push("beta")
	if !nameInVec(v, "alpha") {
		return fail("nameInVec should find alpha")
	}
	if nameInVec(v, "gamma") {
		return fail("nameInVec should not find gamma")
	}
	if nameInVec(nil, "alpha") {
		return fail("nameInVec(nil, ...) should be false")
	}
	return ""
}
