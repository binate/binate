package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/std/strings"

// ============================================================
// Lint Context
// ============================================================

type lintCtx struct {
	Checker      @types.Checker
	Result       @Result
	FuncRetExprs @[]@ast.TypeExpr  // return type expressions of the current function
	// InFunction is true while walking inside a function body.  Used by
	// `readonly-uninit-global` to restrict itself to file-scope declarations
	// (it returns early once inside a function body).
	InFunction bool
}

// newCtx creates a lint context wrapping the given type checker.
func newCtx(c @types.Checker) @lintCtx {
	var ctx @lintCtx = make(lintCtx)
	ctx.Checker = c
	ctx.Result = make(Result)
	ctx.Result.Diags = make_slice(Diagnostic, 32)
	return ctx
}

// addDiag appends a diagnostic to ctx.Result, growing the array if needed.
func addDiag(ctx @lintCtx, pos token.Pos, rule @[]char, msg @[]char) {
	var d Diagnostic
	d.Pos = pos
	d.Rule = rule
	d.Message = msg
	var n int = ctx.Result.NumDiags
	if n >= len(ctx.Result.Diags) {
		var newCap int = len(ctx.Result.Diags) * 2
		var newArr @[]Diagnostic = make_slice(Diagnostic, newCap)
		for i := 0; i < n; i++ {
			newArr[i] = ctx.Result.Diags[i]
		}
		ctx.Result.Diags = newArr
	}
	ctx.Result.Diags[n] = d
	ctx.Result.NumDiags = n + 1
}

// ============================================================
// Entry Point
// ============================================================

// LintFile runs all lint rules on a type-checked package and returns
// diagnostics.  `file` is the package's merged AST (all rule walks
// run over it); `files` is the per-impl-file ASTs, needed by
// unused-import so it can attribute imports to their own source file
// rather than the deduped merged import list.
func LintFile(c @types.Checker, file @ast.File, files @[]@ast.File) @Result {
	var ctx @lintCtx = newCtx(c)
	for i := 0; i < len(file.Decls); i++ {
		lintDecl(ctx, file.Decls[i])
		// B.5 of plan-function-values-phase-2.md: the @func-
		// captures-raw-ptr rule fires anywhere an @func capturing
		// literal carries a CAP_RAW_PTR capture — walk function
		// bodies looking for such literals.  The other rules
		// (managed-to-raw-assign, raw-slice-return, func-value-
		// escape) are dispatched from inside lintStmt; this one
		// needs the full Expr-subtree walk.
		var d @ast.Decl = file.Decls[i]
		if d != nil && d.Kind == ast.DECL_FUNC && d.Body != nil {
			walkStmtFuncLits(ctx, d.Body,
				lintManagedFuncRawCapture)
		}
	}
	// Shared reference index: one walk of the merged AST feeds every
	// "unused" rule (imports, globals, …).
	var idx @refIndex = newRefIndex()
	collectRefs(idx, file)
	lintUnusedImports(ctx, files, idx)
	lintUnusedGlobals(ctx, file, idx)
	lintUnusedTypes(ctx, file, idx)
	lintUnusedFuncs(ctx, file)
	return ctx.Result
}

// ============================================================
// AST Walker
// ============================================================

// lintDecl walks a declaration, checking func bodies, var decls, and groups.
func lintDecl(ctx @lintCtx, d @ast.Decl) {
	if d == nil { return }

	if d.Kind == ast.DECL_FUNC {
		if d.Body != nil {
			var oldRet @[]@ast.TypeExpr = ctx.FuncRetExprs
			var oldIn bool = ctx.InFunction
			ctx.FuncRetExprs = d.Results
			ctx.InFunction = true
			lintStmt(ctx, d.Body)
			ctx.FuncRetExprs = oldRet
			ctx.InFunction = oldIn
		}
	}
	if d.Kind == ast.DECL_VAR {
		lintVarDecl(ctx, d)
		lintUninitReadonlyGlobal(ctx, d)
		lintRecursiveClosureCapture(ctx, d.Name, d.Value)
	}
	if d.Kind == ast.DECL_GROUP {
		for i := 0; i < len(d.Decls); i++ {
			lintDecl(ctx, d.Decls[i])
		}
	}
}

// lintStmt walks a statement, dispatching to rule checks and recursing into sub-statements.
func lintStmt(ctx @lintCtx, s @ast.Stmt) {
	if s == nil { return }

	if s.Kind == ast.STMT_BLOCK {
		for i := 0; i < len(s.Stmts); i++ {
			lintStmt(ctx, s.Stmts[i])
		}
		return
	}
	if s.Kind == ast.STMT_ASSIGN {
		lintAssignStmt(ctx, s)
		return
	}
	if s.Kind == ast.STMT_SHORT_VAR {
		lintShortVarRecursiveClosure(ctx, s)
		return
	}
	if s.Kind == ast.STMT_RETURN {
		lintReturnStmt(ctx, s)
		return
	}
	if s.Kind == ast.STMT_IF {
		lintStmt(ctx, s.Body)
		lintStmt(ctx, s.Else)
		return
	}
	if s.Kind == ast.STMT_FOR {
		lintStmt(ctx, s.Body)
		return
	}
	if s.Kind == ast.STMT_SWITCH {
		for i := 0; i < len(s.Cases); i++ {
			var cc @ast.CaseClause = s.Cases[i]
			for j := 0; j < len(cc.Body); j++ {
				lintStmt(ctx, cc.Body[j])
			}
		}
		return
	}
	if s.Kind == ast.STMT_DECL {
		if s.DeclRef != nil {
			lintDecl(ctx, s.DeclRef)
		}
		return
	}
}

// ============================================================
// Rule: managed-to-raw-assign
// ============================================================

// isManagedToRawSlice checks if src is @[]T and dst is *[]T.
func isManagedToRawSlice(src @types.Type, dst @types.Type) bool {
	if src == nil || dst == nil { return false }
	src = src.ResolveAlias()
	dst = dst.ResolveAlias()
	if src.Kind == types.TYP_MANAGED_SLICE && dst.Kind == types.TYP_SLICE {
		return true
	}
	return false
}

// managedToRawMsg builds the diagnostic message for a managed-to-raw-assign warning.
// Returns a new managed slice.
func managedToRawMsg(src @types.Type, dst @types.Type) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("assigning ")
	cb.Write(src.TypeName())
	cb.Write(" to ")
	cb.Write(dst.TypeName())
	cb.Write(" drops managed wrapper")
	return buf.CopyStr(cb.String())
}

// lintVarDecl checks `var x *[]T = expr` where expr is @[]T
// (managed-to-raw-assign).
//
// It intentionally does NOT check `var x *func(...) = <capturing lit>` for
// func-value-escape: a file-scope closure's enclosing scope holds only package
// globals, which are read LIVE rather than captured (types: don't capture
// package globals), so such a literal never has a non-empty capture set to
// escape.  func-value-escape fires only where a capturing local literal reaches
// an escaping slot -- a return (lintFuncValueEscape) or an escaping assignment
// (lintAssignStmt).
func lintVarDecl(ctx @lintCtx, d @ast.Decl) {
	if d.TypeRef == nil || d.Value == nil { return }
	if d.TypeRef.Kind != ast.TEXPR_SLICE { return }

	var valType @types.Type = ctx.Checker.ExprType(d.Value.ResolvedTypeID)
	if valType == nil { return }
	valType = valType.ResolveAlias()
	if valType.Kind == types.TYP_MANAGED_SLICE {
		// Build the dst type for the message
		var dstType @types.Type = types.MakeSliceType(valType.Elem)
		addDiag(ctx, d.Value.Pos, "managed-to-raw-assign",
			managedToRawMsg(valType, dstType))
	}
}

// lintAssignStmt checks: x = expr where x is *[]T and expr is @[]T
// (managed-to-raw-assign), and writes of a capturing *func literal
// through a pointer- / managed-receiver-rooted LHS, where the
// destination outlives the local frame (func-value-escape).
func lintAssignStmt(ctx @lintCtx, s @ast.Stmt) {
	if s.Op != cast(int, token.ASSIGN) { return }

	var n int = len(s.Exprs)
	if n != len(s.Exprs2) { return }

	for i := 0; i < n; i++ {
		var lhsType @types.Type = ctx.Checker.ExprType(s.Exprs[i].ResolvedTypeID)
		var rhsType @types.Type = ctx.Checker.ExprType(s.Exprs2[i].ResolvedTypeID)
		if isManagedToRawSlice(rhsType, lhsType) {
			addDiag(ctx, s.Exprs2[i].Pos, "managed-to-raw-assign",
				managedToRawMsg(rhsType, lhsType))
		}
		if lhsEscapesLocalFrame(ctx, s.Exprs[i]) {
			lintFuncValueEscapeExpr(ctx, s.Exprs2[i])
		}
		if s.Exprs[i] != nil && s.Exprs[i].Kind == ast.EXPR_IDENT {
			lintRecursiveClosureCapture(ctx, s.Exprs[i].Name,
				s.Exprs2[i])
		}
	}
}

// lhsEscapesLocalFrame returns true if writing to `lhs` stores
// into a location that outlives the current function's frame.
// The conservative shapes:
//   * `*p = ...`  — write through a raw or managed pointer
//     (EXPR_UNARY with STAR operator).
//   * `p.f = ...` where `p` is `*T` or `@T` — auto-deref store
//     into a heap-rooted struct's field.
//   * `s[i] = ...` where `s` is `*[]T` / `@[]T` / `*T` / `@T` —
//     element write into a slice / array whose backing isn't
//     this frame's local.
//
// Local-only assignments (`x = ...` where `x` is a function-local
// var, `localStruct.field = ...` where the struct value is itself
// a local) return false so the rule doesn't over-fire on safe
// patterns.
func lhsEscapesLocalFrame(ctx @lintCtx, lhs @ast.Expr) bool {
	if lhs == nil { return false }
	if lhs.Kind == ast.EXPR_UNARY &&
			lhs.Op == cast(int, token.STAR) {
		return true
	}
	if lhs.Kind == ast.EXPR_SELECTOR {
		// `e.f`: deref-via-pointer / managed-receiver SELECTOR
		// stores into a heap-rooted struct.  Value-receiver
		// SELECTOR (`s.f` where `s` is a plain struct value) does
		// not escape — the value sits on the stack.
		if lhs.X == nil { return false }
		var recvType @types.Type =
			ctx.Checker.ExprType(lhs.X.ResolvedTypeID)
		if recvType == nil { return false }
		recvType = recvType.ResolveAlias()
		if recvType.Kind == types.TYP_POINTER { return true }
		if recvType.Kind == types.TYP_MANAGED_PTR { return true }
		return false
	}
	if lhs.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		// `e[i]`: element write through a slice / managed-slice
		// stores into the backing allocation — outlives every
		// indexing-into-array-on-the-stack pattern that fits the
		// `*func(...)` shape (the array would have to be in a
		// `@[]T` or `*[]T` slot anyway).
		if lhs.X == nil { return false }
		var recvType @types.Type =
			ctx.Checker.ExprType(lhs.X.ResolvedTypeID)
		if recvType == nil { return false }
		recvType = recvType.ResolveAlias()
		if recvType.Kind == types.TYP_SLICE { return true }
		if recvType.Kind == types.TYP_MANAGED_SLICE { return true }
		if recvType.Kind == types.TYP_POINTER { return true }
		if recvType.Kind == types.TYP_MANAGED_PTR { return true }
		return false
	}
	return false
}

// ============================================================
// Rule: raw-slice-return
// ============================================================

// lintReturnStmt checks if returning @[]T where the function declares *[]T return.
func lintReturnStmt(ctx @lintCtx, s @ast.Stmt) {
	// B.5 of plan-function-values-phase-2.md:
	// `*func-escape` warning fires when a CAPTURING *func literal
	// is returned (its closure struct is stack-bound to the
	// returning function's frame).  Independent of the raw-slice-
	// return check below, so dispatch first.
	lintFuncValueEscape(ctx, s)

	if len(ctx.FuncRetExprs) == 0 { return }
	var n int = len(s.Exprs)
	if n > len(ctx.FuncRetExprs) { n = len(ctx.FuncRetExprs) }

	for i := 0; i < n; i++ {
		// Check if declared return type is syntactically a raw slice
		if ctx.FuncRetExprs[i].Kind != ast.TEXPR_SLICE { continue }

		var exprType @types.Type = ctx.Checker.ExprType(s.Exprs[i].ResolvedTypeID)
		if exprType == nil { continue }
		exprType = exprType.ResolveAlias()
		if exprType.Kind == types.TYP_MANAGED_SLICE {
			var dstType @types.Type = types.MakeSliceType(exprType.Elem)
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write("returning ")
			cb.Write(exprType.TypeName())
			cb.Write(" as ")
			cb.Write(dstType.TypeName())
			cb.Write(" drops managed wrapper")
			addDiag(ctx, s.Exprs[i].Pos, "raw-slice-return", buf.CopyStr(cb.String()))
		}
	}
}
