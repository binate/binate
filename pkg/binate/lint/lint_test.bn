package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// ============================================================
// Test Helpers
// ============================================================

func toBytes(s *[]readonly char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

func fail(msg @[]char) testing.TestResult {
	return msg
}

// lintSrc parses, type-checks, and lints a source string.
// Returns the lint Result.
func lintSrc(src *[]readonly char) @Result {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	return LintFile(c, file)
}

func expectDiag(r @Result, rule *[]readonly char) testing.TestResult {
	for i := 0; i < r.NumDiags; i++ {
		if charEq(r.Diags[i].Rule, rule) {
			return ""
		}
	}
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("expected diagnostic '")
	cb.Write(rule)
	cb.Write("' but got ")
	cb.Write(strconv.Itoa(r.NumDiags))
	cb.Write(" diagnostics")
	return buf.CopyStr(cb.String())
}

func expectNoDiag(r @Result, rule *[]readonly char) testing.TestResult {
	for i := 0; i < r.NumDiags; i++ {
		if charEq(r.Diags[i].Rule, rule) {
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write("unexpected diagnostic '")
			cb.Write(rule)
			cb.Write("': ")
			cb.Write(r.Diags[i].Message)
			return buf.CopyStr(cb.String())
		}
	}
	return ""
}

func charEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// ============================================================
// managed-to-raw-assign: var decl
// ============================================================

func TestManagedToRawVarDecl() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func foo() { var ms @[]int = make_slice(int, 10)")
	b.Write("; var s *[]int = ms; _ = s }")
	var src @[]readonly char = b.String()
	var r @Result = lintSrc(src)
	return expectDiag(r, "managed-to-raw-assign")
}

func TestManagedToRawVarDeclNeg() testing.TestResult {
	// Assigning raw to raw — no warning
	var src *[]readonly char = "package \"test\"\nfunc foo(s *[]int) { var s2 *[]int = s; _ = s2 }"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "managed-to-raw-assign")
}

func TestManagedToRawVarDeclManagedToManaged() testing.TestResult {
	// Assigning managed to managed — no warning
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func foo() { var ms @[]int = make_slice(int, 10)")
	b.Write("; var ms2 @[]int = ms; _ = ms2 }")
	var src @[]readonly char = b.String()
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "managed-to-raw-assign")
}

// ============================================================
// managed-to-raw-assign: assignment
// ============================================================

func TestManagedToRawAssign() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func foo() { var ms @[]int = make_slice(int, 10)")
	b.Write("; var s *[]int; s = ms; _ = s }")
	var src @[]readonly char = b.String()
	var r @Result = lintSrc(src)
	return expectDiag(r, "managed-to-raw-assign")
}

func TestManagedToRawAssignNeg() testing.TestResult {
	// Raw to raw assignment — no warning
	var src *[]readonly char = "package \"test\"\nfunc foo(a *[]int) { var b *[]int; b = a; _ = b }"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "managed-to-raw-assign")
}

// ============================================================
// managed-to-raw-assign: function return value
// ============================================================

func TestManagedToRawFromCall() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func bar() @[]int { return make_slice(int, 5) }\n")
	b.Write("func foo() { var s *[]int = bar(); _ = s }")
	var src @[]readonly char = b.String()
	var r @Result = lintSrc(src)
	return expectDiag(r, "managed-to-raw-assign")
}

// ============================================================
// raw-slice-return
// ============================================================

func TestRawSliceReturn() testing.TestResult {
	// Function returns *[]int but the expression is @[]int
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func foo() *[]int { ")
	b.Write("var ms @[]int = make_slice(int, 5); return ms }")
	var src @[]readonly char = b.String()
	var r @Result = lintSrc(src)
	return expectDiag(r, "raw-slice-return")
}

func TestRawSliceReturnNeg() testing.TestResult {
	// Function returns @[]int and expression is @[]int — no warning
	var src *[]readonly char = "package \"test\"\nfunc foo() @[]int { return make_slice(int, 5) }"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "raw-slice-return")
}

func TestRawSliceReturnRawToRaw() testing.TestResult {
	// Function returns *[]int and expression is *[]int — no warning
	var src *[]readonly char = "package \"test\"\nfunc foo(s *[]int) *[]int { return s }"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "raw-slice-return")
}

func TestRawSliceReturnFromCall() testing.TestResult {
	// Function returns *[]int but calls a function returning @[]int
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"test\"\n")
	b.Write("func bar() @[]int { return make_slice(int, 3) }\n")
	b.Write("func foo() *[]int { return bar() }")
	var src @[]readonly char = b.String()
	var r @Result = lintSrc(src)
	return expectDiag(r, "raw-slice-return")
}

// ============================================================
// No false positives for unrelated code
// ============================================================

func TestCleanCode() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc foo() int { var x int = 42; return x }"
	var r @Result = lintSrc(src)
	if r.NumDiags != 0 {
		return "expected no diagnostics for clean code"
	}
	return ""
}
