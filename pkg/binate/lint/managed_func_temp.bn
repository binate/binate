package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"

// ============================================================
// Rule: managed-func-temp-borrow
// ============================================================
//
// A managed function value a call returns, or a `cast` to a managed function-value type
// makes from one or from a capturing function literal, is a statement temporary
// (mem.temporary): kept as a raw `*func` past its statement (walkRawFuncStores), it is
// borrowed (func.value.smoothing) and released once the statement ends, so the raw value
// dangles — user error by the spec; the compiler does not extend the temporary.  The same
// holds for a `cast` or `bit_cast` to a raw function-value type of such a temporary, and for
// a multi-value call's managed function-value result.  `var h *func(int) int = mk(7)` (mk
// returning `@func(int) int`), `return mk(7)` from a function returning `*func(int) int`,
// `h, n = mk2(7)` and `S{f: mk(7)}` stored for a `*func` field are flagged.  A declaration
// that keeps the managed value (`var h @func(int) int = mk(7)`, `h := mk(7)`) owns it; a
// `cast` of a variable that owns one, of a named function or of a non-capturing literal
// makes no temporary that holds data; and a `bit_cast` of a function literal is
// bit-cast-func-lit's.

// lintManagedFuncTemps runs the rule over every declaration of the package.
func lintManagedFuncTemps(ctx @lintCtx, file @ast.File) {
	walkRawFuncStores(ctx, file, mfVisit)
}

// mfVisit flags value, stored as a raw function value, when it holds a managed function-value
// temporary: the multi-value call's idx-th result, or value itself.
func mfVisit(ctx @lintCtx, dst @types.Type, value @ast.Expr, idx int) {
	if idx >= 0 {
		var tup @types.Type = ctx.Checker.ExprType(value.ResolvedTypeID)
		if value.Kind != ast.EXPR_CALL || tup == nil || tup.Kind != types.TYP_TUPLE ||
				idx >= len(tup.Results) || !mfManaged(tup.Results[idx]) {
			return
		}
	} else if !mfHoldsTemp(ctx, value) {
		return
	}
	addDiag(ctx, value.Pos, "managed-func-temp-borrow",
			"a managed function value made here is a temporary, released at the end of the "
					"statement: the raw function value it is stored as dangles; keep it in an @func")
}

// mfManaged reports whether t is a managed function-value type (or a named type over one).
func mfManaged(t @types.Type) bool {
	var s @types.Type = types.StripWrappers(t)
	return s != nil && s.Kind == types.TYP_MANAGED_FUNC_VALUE
}

// mfHoldsTemp reports whether e, kept as a raw function value, holds a managed function-value
// temporary: e is one (mfIsTemp), or a `cast` / `bit_cast` of one other than a function
// literal (bit-cast-func-lit's).
func mfHoldsTemp(ctx @lintCtx, e @ast.Expr) bool {
	if mfIsTemp(ctx, e) { return true }
	if e.Kind != ast.EXPR_BUILTIN || len(e.Args) != 1 || e.Args[0] == nil { return false }
	if e.Op != cast(int, token.CAST) && e.Op != cast(int, token.BIT_CAST) { return false }
	return e.Args[0].Kind != ast.EXPR_FUNC_LIT && mfIsTemp(ctx, e.Args[0])
}

// mfIsTemp reports whether e is a managed function-value temporary that holds data: a call
// returning a managed function value, or a `cast` to a managed function-value type of a call
// or of a capturing function literal.
func mfIsTemp(ctx @lintCtx, e @ast.Expr) bool {
	if e == nil || !mfManaged(ctx.Checker.ExprType(e.ResolvedTypeID)) { return false }
	if e.Kind == ast.EXPR_CALL { return true }
	if e.Kind != ast.EXPR_BUILTIN || e.Op != cast(int, token.CAST) || len(e.Args) != 1 { return false }
	var op @ast.Expr = e.Args[0]
	if op == nil { return false }
	if op.Kind == ast.EXPR_FUNC_LIT { return op.DeclRef != nil && len(op.DeclRef.Captures) > 0 }
	return op.Kind == ast.EXPR_CALL
}
