package "pkg/binate/lint"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// mfDecls declares mk and mk2, which return a managed function value (mk2 with an int), S,
// with a raw one, and the borrowers use and use2.
var mfDecls *[]readonly char = "package \"test\"\n"
		"func mk(n int) @func(int) int { return func(x int) int { return x + n } }\n"
		"func mk2(n int) (@func(int) int, int) { return mk(n), n }\n"
		"type S struct { f *func(int) int }\n"
		"func use(g *func(int) int) int { return g(1) }\n"
		"func use2(s S) int { return s.f(1) }\n"
		"func id(x int) int { return x }\n"

// A managed function-value temporary — a call's result, a `cast` to `@func` of a capturing
// literal, a `cast` or `bit_cast` to `*func` of a call's result, a multi-value call's result —
// kept as a raw `*func` is flagged: at a variable's declaration (local or package), an
// assignment (to a variable, an element or a field, of a multi-value call), a stored struct
// literal's field (its address or its box stored too, and a box of a `cast` of one), an array
// literal's element, a return (of a multi-value call too), inside a function literal's body.
// Keeping it as an `@func`, inferring the variable's type, passing it (or a struct literal
// holding it) to a call, a blank target, storing an `@func` variable or the address of a
// `*func` one, and a `cast` to `@func` of a variable, a named function or a non-capturing
// literal are not; nor is a `bit_cast` of a function literal (bit-cast-func-lit's).
func TestManagedFuncTempBorrow() testing.TestResult {
	var flagged @[]*[]readonly char = @[]*[]readonly char{
			"func f() int { var h *func(int) int = mk(7); return h(1) }\n", "var h *func(int) int = mk(7)\n",
			"func f() int { var h *func(int) int; h = mk(7); return h(1) }\n",
			"func f(n int) int { var h *func(int) int = cast(@func(int) int, "
					"func(x int) int { return x + n }); return h(1) }\n",
			"func f() int { var s S = S{f: mk(7)}; return s.f(1) }\n",
			"func f() int { var a [1]*func(int) int = [1]*func(int) int{mk(7)}; return a[0](1) }\n",
			"func f() int { var a [1]*func(int) int; a[0] = mk(7); return a[0](1) }\n",
			"func f() int { var s S; s.f = mk(7); return s.f(1) }\n",
			"func f() int { var g @func() int = func() int { var h *func(int) int = mk(7); return h(1) }; "
					"return g() }\n",
			"func g() *func(int) int { return mk(7) }\n",
			"func f() int { var h *func(int) int; var n int; h, n = mk2(7); return h(n) }\n",
			"func g() (*func(int) int, int) { return mk2(7) }\n",
			"func f() int { var h *func(int) int = cast(*func(int) int, mk(7)); return h(1) }\n",
			"func f() int { var h *func(int) int = bit_cast(*func(int) int, mk(7)); return h(1) }\n",
			"func f() int { var p *S = &S{f: mk(7)}; return p.f(1) }\n",
			"func f() int { var b @S = box(S{f: mk(7)}); return b.f(1) }\n",
			"func f() int { var b @(*func(int) int) = box(cast(*func(int) int, mk(7))); return 0 }\n"}
	for i := 0; i < len(flagged); i++ {
		var src @[]char = buf.Concat(mfDecls, flagged[i])
		if countRule(lintSrc(src), "managed-func-temp-borrow") != 1 {
			return fail(buf.Concat("not flagged once: ", flagged[i]))
		}
	}
	var clean @[]*[]readonly char = @[]*[]readonly char{
			"func f() int { var h @func(int) int = mk(7); return h(1) }\n",
			"func f() int { h := mk(7); return h(1) }\n", "func f() int { return use(mk(7)) }\n",
			"func f() int { return use2(S{f: mk(7)}) }\n",
			"func f() int { var m @func(int) int = mk(7); var h *func(int) int = m; return h(1) }\n",
			"func f() int { var m @func(int) int = mk(7); var h *func(int) int = cast(@func(int) int, m); "
					"return h(1) }\n",
			"func f() int { var h *func(int) int = cast(@func(int) int, id); return h(1) }\n",
			"func f() int { var h *func(int) int = cast(@func(int) int, func(x int) int { return x }); "
					"return h(1) }\n",
			"func f() { var _ *func(int) int = mk(7) }\n", "var _ *func(int) int = mk(7)\n",
			"func f() int { var h *func(int) int = id; var p **func(int) int = &h; return (*p)(1) }\n",
			"func f(n int) int { var h *func(int) int = bit_cast(*func(int) int, "
					"func(x int) int { return x + n }); return h(1) }\n"}
	for i := 0; i < len(clean); i++ {
		var src @[]char = buf.Concat(mfDecls, clean[i])
		if countRule(lintSrc(src), "managed-func-temp-borrow") != 0 {
			return fail(buf.Concat("flagged: ", clean[i]))
		}
	}
	return ""
}
