package "pkg/binate/lint"

// Shared key functions for the lint rules' name-keyed hash containers
// (setfn.SetFn / mapfn.MapFn on `@[]char` identifier/qualifier names).  The
// containers key on the OWNED `@[]char`, so both the hash and equality
// functions take `@[]char`; every lint site collects and looks up names it
// already owns (from the AST/checker), so there is no per-lookup copy.

// nameHash returns a djb2 hash of `name` — cheap and well-distributed for the
// short identifier / qualified-name strings the lint rules key on.
// bnlint:allow borrowable-char-param
func nameHash(name @[]char) uint {
	var h uint = 5381
	for i := 0; i < len(name); i++ {
		h = h * 33 + cast(uint, name[i])
	}
	return h
}

// nameEq reports whether two names contain identical bytes — the equality
// function paired with nameHash (names it treats equal must hash equal).
// bnlint:allow borrowable-char-param
func nameEq(a @[]char, b @[]char) bool {
	return streq(a, b)
}
