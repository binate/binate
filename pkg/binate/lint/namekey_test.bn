package "pkg/binate/lint"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// nameEq matches byte-identical names and rejects any difference (content or
// length), including the two-empty-names case.
func TestNameEq() testing.TestResult {
	if !nameEq(buf.CopyStr("foo"), buf.CopyStr("foo")) {
		return "equal names should match"
	}
	if nameEq(buf.CopyStr("foo"), buf.CopyStr("bar")) {
		return "different names should not match"
	}
	if nameEq(buf.CopyStr("abc"), buf.CopyStr("ab")) {
		return "different-length names should not match"
	}
	if !nameEq(buf.CopyStr(""), buf.CopyStr("")) {
		return "two empty names should match"
	}
	return ""
}

// nameHash is a deterministic djb2: the empty name hashes to the 5381 seed,
// equal names hash equal (the invariant nameEq/nameHash must jointly satisfy),
// and distinct names hash apart here.
func TestNameHash() testing.TestResult {
	if nameHash(buf.CopyStr("")) != 5381 {
		return "empty name should hash to the djb2 seed 5381"
	}
	if nameHash(buf.CopyStr("alpha")) != nameHash(buf.CopyStr("alpha")) {
		return "equal names must hash equal"
	}
	if nameHash(buf.CopyStr("alpha")) == nameHash(buf.CopyStr("beta")) {
		return "distinct names should hash apart"
	}
	return ""
}
