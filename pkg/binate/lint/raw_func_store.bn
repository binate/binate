package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/binate/types"

// ============================================================
// Raw function-value stores
// ============================================================
//
// The positions where a value is kept as a raw function value (`*func`, or a named type
// over one) past its statement, which the bit-cast-func-lit and managed-func-temp-borrow
// rules check: a variable's declaration with a declared type (local or package), an
// assignment — one value to each target, or a multi-value call's results — and a `return`
// against the function's results, each in a function body or a function literal's body.  A
// composite literal stored at one of them stores its elements as its fields' or elements'
// types, nested composites included.  A blank target stores nothing, and a call's argument
// (a composite one included) is borrowed only while the call runs, so neither is a store.

// rfsVisit is called for each value stored as a raw function value: dst is the destination's
// type, value the expression stored, and idx the result of the multi-value call value that
// is stored (-1 for a single value).
type rfsVisit *func(@lintCtx, @types.Type, @ast.Expr, int)

// walkRawFuncStores calls visit for each raw function-value store in file.
func walkRawFuncStores(ctx @lintCtx, file @ast.File, visit rfsVisit) {
	for i := 0; i < len(file.Decls); i++ {
		rfsDecl(ctx, file.Decls[i], visit)
	}
}

// rfsDecl visits a declaration: a function body (against its signature's results), a typed
// variable's initializer, or a group's members.
func rfsDecl(ctx @lintCtx, d @ast.Decl, visit rfsVisit) {
	if d == nil { return }
	if d.Kind == ast.DECL_FUNC && d.Body != nil {
		var results @[]@types.Type
		var sig @types.Type = ctx.Checker.ExprType(d.ResolvedTypeID)
		if sig != nil { results = sig.Results }
		rfsStmt(ctx, d.Body, results, visit)
	}
	if d.Kind == ast.DECL_VAR && d.Value != nil {
		if d.TypeRef != nil && !streq(d.Name, "_") {
			rfsSite(ctx, ctx.Checker.ExprType(d.ResolvedTypeID), d.Value, -1, visit)
		}
		rfsExpr(ctx, d.Value, visit)
	}
	if d.Kind == ast.DECL_GROUP {
		for i := 0; i < len(d.Decls); i++ {
			rfsDecl(ctx, d.Decls[i], visit)
		}
	}
}

// rfsBlank reports whether e is the blank identifier `_`.
func rfsBlank(e @ast.Expr) bool {
	return e != nil && e.Kind == ast.EXPR_IDENT && streq(e.Name, "_")
}

// rfsStmt visits a statement and everything in it; results are the enclosing function's.
func rfsStmt(ctx @lintCtx, s @ast.Stmt, results @[]@types.Type, visit rfsVisit) {
	if s == nil { return }
	if s.Kind == ast.STMT_ASSIGN && s.Op == cast(int, token.ASSIGN) {
		for i := 0; i < len(s.Exprs); i++ {
			if rfsBlank(s.Exprs[i]) { continue }
			var dst @types.Type = ctx.Checker.ExprType(s.Exprs[i].ResolvedTypeID)
			if len(s.Exprs2) == len(s.Exprs) {
				rfsSite(ctx, dst, s.Exprs2[i], -1, visit)
			} else if len(s.Exprs2) == 1 {
				rfsSite(ctx, dst, s.Exprs2[0], i, visit)
			}
		}
	}
	if s.Kind == ast.STMT_RETURN {
		for i := 0; i < len(results); i++ {
			if len(s.Exprs) == len(results) {
				rfsSite(ctx, results[i], s.Exprs[i], -1, visit)
			} else if len(s.Exprs) == 1 {
				rfsSite(ctx, results[i], s.Exprs[0], i, visit)
			}
		}
	}
	for i := 0; i < len(s.Stmts); i++ {
		rfsStmt(ctx, s.Stmts[i], results, visit)
	}
	for i := 0; i < len(s.Exprs); i++ {
		rfsExpr(ctx, s.Exprs[i], visit)
	}
	for i := 0; i < len(s.Exprs2); i++ {
		rfsExpr(ctx, s.Exprs2[i], visit)
	}
	rfsExpr(ctx, s.X, visit)
	rfsStmt(ctx, s.Init, results, visit)
	rfsStmt(ctx, s.Body, results, visit)
	rfsStmt(ctx, s.Else, results, visit)
	rfsStmt(ctx, s.Post, results, visit)
	for i := 0; i < len(s.Cases); i++ {
		var cc @ast.CaseClause = s.Cases[i]
		if cc == nil { continue }
		for j := 0; j < len(cc.Exprs); j++ {
			rfsExpr(ctx, cc.Exprs[j], visit)
		}
		for j := 0; j < len(cc.Body); j++ {
			rfsStmt(ctx, cc.Body[j], results, visit)
		}
	}
	if s.DeclRef != nil { rfsDecl(ctx, s.DeclRef, visit) }
}

// rfsExpr visits the function literals in an expression: each one's body, against its own
// results.
func rfsExpr(ctx @lintCtx, e @ast.Expr, visit rfsVisit) {
	if e == nil { return }
	if e.Kind == ast.EXPR_FUNC_LIT && e.DeclRef != nil {
		var results @[]@types.Type
		var lt @types.Type = types.StripWrappers(ctx.Checker.ExprType(e.ResolvedTypeID))
		if lt != nil { results = lt.Results }
		rfsStmt(ctx, e.DeclRef.Body, results, visit)
	}
	rfsExpr(ctx, e.X, visit)
	rfsExpr(ctx, e.Y, visit)
	rfsExpr(ctx, e.Z, visit)
	for i := 0; i < len(e.Args); i++ {
		rfsExpr(ctx, e.Args[i], visit)
	}
	for i := 0; i < len(e.Elems); i++ {
		if e.Elems[i] != nil { rfsExpr(ctx, e.Elems[i].Value, visit) }
	}
}

// rfsSite visits value, stored as a value of type dst (idx as rfsVisit takes it): a composite
// literal's elements as its fields' or elements' types, and a value stored as a raw function
// value through visit.
func rfsSite(ctx @lintCtx, dst @types.Type, value @ast.Expr, idx int, visit rfsVisit) {
	if dst == nil || value == nil { return }
	var d @types.Type = types.StripWrappers(dst)
	if d == nil { return }
	if idx < 0 && value.Kind == ast.EXPR_COMPOSITE {
		for i := 0; i < len(value.Elems); i++ {
			var el @ast.Element = value.Elems[i]
			if el != nil { rfsSite(ctx, aggregateElemTargetType(d, el, i), el.Value, -1, visit) }
		}
		return
	}
	if d.Kind == types.TYP_FUNC_VALUE { visit(ctx, dst, value, idx) }
}
