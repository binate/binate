package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/check"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// rfsTestSites and rfsTestMulti count the stores rfsTestVisit sees: all of them, and those of
// a multi-value call's result.
var rfsTestSites int

var rfsTestMulti int

// rfsTestVisit counts a raw function-value store.
func rfsTestVisit(ctx @lintCtx, dst @types.Type, value @ast.Expr, idx int) {
	rfsTestSites = rfsTestSites + 1
	if idx >= 0 { rfsTestMulti = rfsTestMulti + 1 }
}

// rfsTestSrc stores raw function values at each kind of store, and at positions that are
// none: a blank, a call's (composite) argument, an int result of a multi-value call.
var rfsTestSrc *[]readonly char = "package \"test\"\n"
		"type S struct { f *func(int) int; g int }\n"
		"func id(x int) int { return x }\n"
		"var pv *func(int) int = id\n"
		"var _ *func(int) int = id\n"
		"func use(s S) int { return s.g }\n"
		"func two() (*func(int) int, int) { return id, 1 }\n"
		"func f() *func(int) int {\n"
		"\tvar h *func(int) int = id\n"
		"\th = id\n"
		"\tvar s S = S{f: id, g: 1}\n"
		"\tvar a [2]*func(int) int = [2]*func(int) int{id, id}\n"
		"\tvar n int\n"
		"\th, n = two()\n"
		"\t_ = use(S{f: id})\n"
		"\tvar g @func() *func(int) int = func() *func(int) int { return id }\n"
		"\tswitch n {\n\tcase 0:\n\t\th = id\n\t}\n"
		"\t_ = s\n\t_ = a\n\t_ = g\n\t_ = h\n"
		"\treturn id\n"
		"}\n"

// walkRawFuncStores visits each store of a raw function value — a package variable, a local
// one, an assignment, a stored composite's field and elements, a multi-value call's result,
// a return (of a function and of a function literal), a case body — eleven in rfsTestSrc, one
// of them a multi-value call's result, and nothing at a blank, a call's argument or a
// non-function result.
func TestWalkRawFuncStores() testing.TestResult {
	var p @parser.Parser = parser.New(toBytes(rfsTestSrc), "test.bn")
	var file @ast.File = mustParse(p)
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	rfsTestSites = 0
	rfsTestMulti = 0
	walkRawFuncStores(newCtx(c), file, rfsTestVisit)
	if rfsTestSites != 11 || rfsTestMulti != 1 {
		return fail(
				buf.Concat(buf.Concat("stores seen: ", strconv.Itoa(rfsTestSites)),
						buf.Concat(", of a multi-value call: ", strconv.Itoa(rfsTestMulti))))
	}
	return ""
}
