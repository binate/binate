package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// buildReach parses a single source and computes its reachability.  Reachability
// is purely syntactic (AST references), so no type-check pass is needed.
func buildReach(src *[]readonly char) @reachState {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	return computeReach(file)
}

// A private func reached transitively from `main` (a root) is reachable; one no
// root reaches is not.
func TestReachFromMain() testing.TestResult {
	var s @reachState = buildReach(
			"package \"test\"\n"
					"func used() {}\nfunc dead() {}\n"
					"func main() { used() }\n")
	if !s.isReach("used") {
		return "used should be reachable from main"
	}
	if s.isReach("dead") {
		return "dead should be unreachable (no root reaches it)"
	}
	return ""
}

// A dead-code ISLAND — two private funcs referencing only each other, with no
// root — is entirely unreachable (reachability, not reference-presence).
func TestReachDeadIsland() testing.TestResult {
	var s @reachState = buildReach(
			"package \"test\"\nfunc a() { b() }\nfunc b() { a() }\n")
	if s.isReach("a") || s.isReach("b") {
		return "a mutually-recursive island with no root must be dead"
	}
	return ""
}

// A method is a root and seeds its BODY refs, but NOT its receiver type: a helper
// the method calls is reachable, while a type mentioned only as that method's
// receiver stays dead (nothing can construct it).
func TestReachMethodReceiverExcluded() testing.TestResult {
	var s @reachState = buildReach(
			"package \"test\"\ntype T int\n"
					"func (r @T) m() { helper() }\nfunc helper() {}\n")
	if !s.isReach("helper") {
		return "a method body seeds its refs — helper should be reachable"
	}
	if s.isReach("T") {
		return "a type mentioned only as its method's receiver must stay dead"
	}
	return ""
}

// A type referenced (constructed) by a root is reachable.
func TestReachTypeFromRoot() testing.TestResult {
	var s @reachState = buildReach(
			"package \"test\"\ntype T int\nfunc main() { var x T = 0\n_ = x }\n")
	if !s.isReach("T") {
		return "a type referenced from main should be reachable"
	}
	return ""
}

// classifyDecls records one candidate per unexported func / var / type.
func TestReachCandidateClassification() testing.TestResult {
	var s @reachState = buildReach(
			"package \"test\"\ntype T int\nvar g int = 0\nfunc f() {}\n")
	if s.funcCands.Len() != 1 {
		return "expected exactly one func candidate (f)"
	}
	if s.globalCands.Len() != 1 {
		return "expected exactly one global candidate (g)"
	}
	if s.typeCands.Len() != 1 {
		return "expected exactly one type candidate (T)"
	}
	return ""
}
