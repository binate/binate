package "pkg/binate/lint"

import "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"

// ============================================================
// Rule: readonly-handle-type-arg
// ============================================================
//
// Flags a type argument written with an outermost `readonly` over a pointer or
// slice — `as[readonly *Thing](x)`, `Vec[readonly @Node]`, `f[readonly *[]T]`.
// The `readonly` qualifies only the handle: an instance's T-typed variables
// cannot be rebound, while the pointee (or the elements) stays writable
// (spec type.readonly.surface / type.readonly.shallow).  Whoever writes it
// almost always means read-only contents, `*readonly Thing` / `*[]readonly T`.
//
// Only the written spelling triggers the rule: a named type or an alias over
// such a type (`type RP readonly *int`) is a deliberate choice and is not
// flagged.  Nor is a handle whose contents are already read-only (`readonly
// *readonly T`), or an interface value (`readonly *Getter`): an interface value
// has no inner readonly slot, so its read-only handle is the only reading.

// readonlyHandleTypeArgMsg builds the diagnostic for a readonly-handle type
// argument.
func readonlyHandleTypeArgMsg() @[]char {
	return buf.CopyStr(
			"type argument `readonly` over a pointer or slice makes only the handle read-only — "
					"the pointee or the elements stay writable; for read-only contents put `readonly` "
					"inside: `*readonly T`, `@readonly T`, `*[]readonly T`, `@[]readonly T`")
}

// rhtaState is the readonly-handle-type-arg walk's state: the lint context and
// the package's merged AST, whose imports resolve a qualified type name.
type rhtaState struct {
	Ctx  @lintCtx
	File @ast.File
}

// lintReadonlyHandleTypeArgs reports every readonly-handle type argument in the
// package's merged AST.
func lintReadonlyHandleTypeArgs(ctx @lintCtx, file @ast.File) {
	var st @rhtaState = make(rhtaState)
	st.Ctx = ctx
	st.File = file
	for i := 0; i < len(file.Decls); i++ {
		rhtaDecl(st, file.Decls[i])
	}
}

// isReadonlyHandleTypeArg reports whether the type expression t, a type
// argument, is spelled `readonly` over a raw or managed pointer or slice whose
// contents are writable and which is not an interface value.
func isReadonlyHandleTypeArg(st @rhtaState, t @ast.TypeExpr) bool {
	t = peelTypeParens(t)
	if t == nil || t.Kind != ast.TEXPR_CONST { return false }
	var handle @ast.TypeExpr = peelTypeParens(t.Base)
	if handle == nil ||
			(handle.Kind != ast.TEXPR_POINTER && handle.Kind != ast.TEXPR_MANAGED &&
					handle.Kind != ast.TEXPR_SLICE && handle.Kind != ast.TEXPR_MANAGED_SLICE) {
		return false
	}
	var contents @ast.TypeExpr = peelTypeParens(handle.Base)
	if contents == nil || contents.Kind == ast.TEXPR_CONST { return false }
	var slice bool = handle.Kind == ast.TEXPR_SLICE || handle.Kind == ast.TEXPR_MANAGED_SLICE
	return slice || !namesInterface(st, contents)
}

// namesInterface reports whether the type expression t names an interface (a
// generic one by its head): one the package declares, a predeclared one (`any`),
// or for a qualified name one the package its import names declares.
func namesInterface(st @rhtaState, t @ast.TypeExpr) bool {
	if t.Kind != ast.TEXPR_NAMED && t.Kind != ast.TEXPR_INSTANTIATE { return false }
	var ty @types.Type = nil
	if len(t.Pkg) > 0 {
		var path @[]char = importPathFor(st.File, t.Pkg)
		if len(path) > 0 { ty = st.Ctx.Checker.PackageType(path, t.Name) }
	} else {
		for i := 0; i < len(st.File.Decls); i++ {
			var d @ast.Decl = st.File.Decls[i]
			if d != nil && d.Kind == ast.DECL_INTERFACE && streq(d.Name, t.Name) { return true }
		}
		var sym @check.Symbol = st.Ctx.Checker.Scope().Lookup(t.Name)
		if sym != nil { ty = sym.Type() }
	}
	ty = types.ResolveAliasAndConst(ty)
	return ty != nil && ty.Kind == types.TYP_INTERFACE
}

// importPathFor returns the path of the package file imports as qual — by its
// alias, or else by the last segment of its path — or empty if none.
func importPathFor(file @ast.File, qual *[]readonly char) @[]char {
	for i := 0; i < len(file.Imports); i++ {
		var imp @ast.ImportSpec = file.Imports[i]
		var path @[]char = buf.CopyStr(stripImportQuotes(imp.Path))
		var local @[]char = imp.Alias
		if len(local) == 0 { local = buf.CopyStr(lastSegment(path)) }
		if streq(local, qual) { return path }
	}
	var none @[]char
	return none
}

// peelTypeParens returns t without its enclosing parentheses.
func peelTypeParens(t @ast.TypeExpr) @ast.TypeExpr {
	for t != nil && t.Kind == ast.TEXPR_PAREN {
		t = t.Base
	}
	return t
}

// rhtaDecl walks a declaration's signature, type, initializer, body and nested
// declarations.
func rhtaDecl(st @rhtaState, d @ast.Decl) {
	if d == nil { return }
	if d.Recv != nil { rhtaType(st, d.Recv.Type) }
	for i := 0; i < len(d.Params); i++ {
		rhtaType(st, d.Params[i].Type)
	}
	for i := 0; i < len(d.Results); i++ {
		rhtaType(st, d.Results[i])
	}
	for i := 0; i < len(d.TypeParams); i++ {
		rhtaType(st, d.TypeParams[i].Constraint)
	}
	rhtaType(st, d.TypeRef)
	rhtaExpr(st, d.Value)
	rhtaStmt(st, d.Body)
	for i := 0; i < len(d.Decls); i++ {
		rhtaDecl(st, d.Decls[i])
	}
	for i := 0; i < len(d.Interfaces); i++ {
		rhtaType(st, d.Interfaces[i])
	}
}

// rhtaType walks a type expression, checking a generic instantiation's type
// arguments.
func rhtaType(st @rhtaState, t @ast.TypeExpr) {
	if t == nil { return }
	if t.Kind == ast.TEXPR_INSTANTIATE {
		for i := 0; i < len(t.TypeArgs); i++ {
			if isReadonlyHandleTypeArg(st, t.TypeArgs[i]) {
				addDiag(st.Ctx, t.TypeArgs[i].Pos, "readonly-handle-type-arg", readonlyHandleTypeArgMsg())
			}
		}
	}
	rhtaType(st, t.Base)
	rhtaExpr(st, t.Len)
	for i := 0; i < len(t.Fields); i++ {
		rhtaType(st, t.Fields[i].Type)
	}
	for i := 0; i < len(t.ParamTypes); i++ {
		rhtaType(st, t.ParamTypes[i])
	}
	for i := 0; i < len(t.ResultTypes); i++ {
		rhtaType(st, t.ResultTypes[i])
	}
	for i := 0; i < len(t.TypeArgs); i++ {
		rhtaType(st, t.TypeArgs[i])
	}
}

// rhtaExpr walks an expression, checking a generic instantiation's type
// arguments (`f[readonly *T]` puts each in an EXPR_TYPE argument).
func rhtaExpr(st @rhtaState, e @ast.Expr) {
	if e == nil { return }
	if e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		for i := 0; i < len(e.Args); i++ {
			var a @ast.Expr = e.Args[i]
			if a != nil && a.Kind == ast.EXPR_TYPE && isReadonlyHandleTypeArg(st, a.TypeRef) {
				addDiag(st.Ctx, a.Pos, "readonly-handle-type-arg", readonlyHandleTypeArgMsg())
			}
		}
	}
	rhtaExpr(st, e.X)
	rhtaExpr(st, e.Y)
	rhtaExpr(st, e.Z)
	for i := 0; i < len(e.Args); i++ {
		rhtaExpr(st, e.Args[i])
	}
	rhtaType(st, e.TypeRef)
	for i := 0; i < len(e.Elems); i++ {
		rhtaExpr(st, e.Elems[i].Key)
		rhtaExpr(st, e.Elems[i].Value)
	}
	if e.DeclRef != nil { rhtaDecl(st, e.DeclRef) }
}

// rhtaStmt walks a statement and its sub-statements, expressions, case labels and
// declarations.
func rhtaStmt(st @rhtaState, s @ast.Stmt) {
	if s == nil { return }
	for i := 0; i < len(s.Stmts); i++ {
		rhtaStmt(st, s.Stmts[i])
	}
	for i := 0; i < len(s.Exprs); i++ {
		rhtaExpr(st, s.Exprs[i])
	}
	for i := 0; i < len(s.Exprs2); i++ {
		rhtaExpr(st, s.Exprs2[i])
	}
	rhtaExpr(st, s.X)
	rhtaStmt(st, s.Body)
	rhtaStmt(st, s.Else)
	rhtaStmt(st, s.Init)
	rhtaStmt(st, s.Post)
	rhtaExpr(st, s.ForKey)
	rhtaExpr(st, s.ForVal)
	for i := 0; i < len(s.Cases); i++ {
		var cc @ast.CaseClause = s.Cases[i]
		for j := 0; j < len(cc.Exprs); j++ {
			rhtaExpr(st, cc.Exprs[j])
		}
		for j := 0; j < len(cc.Types); j++ {
			rhtaType(st, cc.Types[j])
		}
		for j := 0; j < len(cc.Body); j++ {
			rhtaStmt(st, cc.Body[j])
		}
	}
	if s.DeclRef != nil { rhtaDecl(st, s.DeclRef) }
}
