package "pkg/binate/lint"

import "pkg/builtins/testing"

// Tests for the readonly-handle-type-arg rule (readonly_handle_type_arg.bn).
// lintSrc / expectDiag / expectNoDiag are shared test helpers from lint_test.bn.

// rhtaSrc wraps body in a package with a generic function and a generic type.
func rhtaSrc(body *[]readonly char) @[]char {
	var head *[]readonly char = "package \"test\"\n"
			"type Thing struct { n int }\n"
			"interface Getter { Get() int }\n"
			"type Box[T any] struct { v T }\n"
			"func as[T any](x @any) T { return x.(T) }\n"
	var b @[]char = make_slice(char, len(head) + len(body))
	for i := 0; i < len(head); i++ { b[i] = head[i] }
	for i := 0; i < len(body); i++ { b[len(head) + i] = body[i] }
	return b
}

// A function's type argument `readonly *Thing` is flagged.
func TestReadonlyHandleTypeArgFuncInstance() testing.TestResult {
	return expectDiag(
			lintSrc(rhtaSrc("func f(a @any) { var r *Thing = as[readonly *Thing](a); _ = r }\n")),
			"readonly-handle-type-arg")
}

// A generic type's type argument `readonly @Thing` (in a variable's type) and a
// slice `readonly *[]int` are flagged.
func TestReadonlyHandleTypeArgTypeInstance() testing.TestResult {
	var r testing.TestResult = expectDiag(
			lintSrc(rhtaSrc("func f() { var b Box[readonly @Thing]; _ = b }\n")), "readonly-handle-type-arg")
	if len(r) > 0 { return r }
	return expectDiag(
			lintSrc(rhtaSrc("func f() { var b Box[readonly *[]int]; _ = b }\n")), "readonly-handle-type-arg")
}

// A readonly-handle type argument is found wherever a type is written: a
// parameter type, a struct field, a composite literal and a function literal's
// body.
func TestReadonlyHandleTypeArgPositions() testing.TestResult {
	var srcs @[]@[]char = make_slice(@[]char, 4)
	srcs[0] = rhtaSrc("func f(b Box[readonly *Thing]) { _ = b }\n")
	srcs[1] = rhtaSrc("type W struct { b Box[readonly @Thing] }\n")
	srcs[2] = rhtaSrc("func f() { var b Box[readonly *Thing] = Box[readonly *Thing]{}; _ = b }\n")
	srcs[3] = rhtaSrc("func f(a @any) { var g func() = func() { _ = as[readonly *Thing](a) }; g() }\n")
	for i := 0; i < len(srcs); i++ {
		var r testing.TestResult = expectDiag(lintSrc(srcs[i]), "readonly-handle-type-arg")
		if len(r) > 0 { return r }
	}
	return ""
}

// Read-only contents (`*readonly Thing`, `readonly *readonly Thing`, `readonly
// *[]readonly int`), a readonly value type argument (`readonly int`), an
// interface value's read-only handle (`readonly *Getter`, `readonly @any`), and a
// named type over
// a readonly handle are not flagged.
func TestReadonlyHandleTypeArgNeg() testing.TestResult {
	var srcs @[]@[]char = make_slice(@[]char, 7)
	srcs[6] = rhtaSrc("func f() { var b Box[readonly @any]; _ = b }\n")
	srcs[0] = rhtaSrc("func f(a @any) { var r *readonly Thing = as[*readonly Thing](a); _ = r }\n")
	srcs[1] = rhtaSrc("func f() { var b Box[readonly *readonly Thing]; _ = b }\n")
	srcs[2] = rhtaSrc("func f() { var b Box[readonly *[]readonly int]; _ = b }\n")
	srcs[3] = rhtaSrc("func f() { var b Box[readonly int]; _ = b }\n")
	srcs[4] = rhtaSrc("func f() { var b Box[readonly *Getter]; _ = b }\n")
	srcs[5] = rhtaSrc("type RP readonly *Thing\nfunc f() { var b Box[RP]; _ = b }\n")
	for i := 0; i < len(srcs); i++ {
		var r testing.TestResult = expectNoDiag(lintSrc(srcs[i]), "readonly-handle-type-arg")
		if len(r) > 0 { return r }
	}
	return ""
}
