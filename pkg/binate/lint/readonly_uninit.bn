package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/strings"

// ============================================================
// Rule: uninitialized-readonly-global
// ============================================================
//
// Flags a file-scope `var X readonly T` with no initializer.  The
// outer `readonly` modifier forbids writing through X, so with no
// initializer X is zero-valued forever and can never hold a useful
// value — almost always a mistake.  The fix is to add an initializer,
// or to drop `readonly` if X is meant to be assigned later.
//
// Only the OUTER readonly (a TEXPR_CONST at the top of the type
// expression) triggers the rule.  Element-level readonly — e.g.
// `var X *[]readonly T` — is fine: X itself is still assignable, so
// an empty initializer just means "starts empty, filled later".
//
// File-scope only: a non-readonly `var X T` with no initializer is a
// valid zero-initialized mutable global and is never flagged.

// lintUninitReadonlyGlobal reports a file-scope readonly var with no
// initializer.
func lintUninitReadonlyGlobal(ctx @lintCtx, d @ast.Decl) {
	if ctx.InFunction { return }
	if d.Value != nil { return }
	if d.TypeRef == nil || d.TypeRef.Kind != ast.TEXPR_CONST { return }
	addDiag(ctx, d.Pos, "uninitialized-readonly-global", uninitReadonlyMsg(d.Name))
}

// uninitReadonlyMsg builds the diagnostic for an uninitialized
// readonly global var.
func uninitReadonlyMsg(name @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("readonly global `")
	cb.Write(name)
	cb.Write("` has no initializer; it is zero-valued forever ")
	cb.Write("and can never be assigned — add an initializer, ")
	cb.Write("or drop `readonly` if it is meant to be set later")
	return buf.CopyStr(cb.String())
}
