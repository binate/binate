package "pkg/binate/lint"

import "pkg/builtins/testing"

// Tests for the uninitialized-readonly-global rule (readonly_uninit.bn).
// lintSrc / expectDiag / expectNoDiag are shared test helpers from
// lint_test.bn (same package).

// A file-scope readonly var with no initializer is flagged: it is
// zero-valued forever and can never be assigned.
func TestUninitReadonlyGlobal() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar X readonly int\n"
	var r @Result = lintSrc(src)
	return expectDiag(r, "uninitialized-readonly-global")
}

// An initialized readonly global is the intended shape — not flagged.
func TestUninitReadonlyGlobalInitializedNeg() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar X readonly int = 5\n"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "uninitialized-readonly-global")
}

// A non-readonly uninitialized global is a valid zero-initialized
// mutable var — not flagged.
func TestUninitReadonlyGlobalNonReadonlyNeg() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar X int\n"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "uninitialized-readonly-global")
}

// Element-level readonly (outer type not readonly): X itself is still
// assignable, so an empty initializer isn't flagged.
func TestUninitReadonlyGlobalElementReadonlyNeg() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar X *[]readonly char\n"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "uninitialized-readonly-global")
}
