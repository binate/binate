package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/buf"

// `recursive-closure-capture`: a function literal bound to a variable that the
// literal also CAPTURES.  Captures are by value — a snapshot at the literal's
// evaluation (claude-notes.md "Diagnostics"/"Closures";
// plan-function-values-phase-2.md "Capture semantics: always by value").  So
// the captured copy is the variable's PRE-binding value: nil for
// `var g = func(){…g…}`, the previous value for a reassignment
// `g = func(){…g…}`.  The closure therefore closes over a stale snapshot, not
// itself, and a recursive self-call silently misbehaves.  Recursive lambdas are
// unsupported by design (the documented idiom is a named top-level function);
// this is a footgun the compiler stays silent about (errors-only policy), so
// the linter flags it.

// lintRecursiveClosureCapture emits the warning when `value` is a function
// literal that captures `varName` — i.e. the literal is being bound to a
// variable it closes over by value.  Called once per binding form (var decl /
// assignment / short var decl) with the bound name and its initializer.
func lintRecursiveClosureCapture(ctx @lintCtx, varName @[]char,
		value @ast.Expr) {
	if value == nil || value.Kind != ast.EXPR_FUNC_LIT { return }
	if value.DeclRef == nil { return }
	if len(varName) == 0 || streq(varName, "_") { return }
	for i := 0; i < len(value.DeclRef.Captures); i++ {
		if !streq(value.DeclRef.Captures[i].Name, varName) { continue }
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteStr("closure captures the variable `")
		cb = cb.WriteStr(varName)
		cb = cb.WriteStr("` it is being assigned to; captures are by value ")
		cb = cb.WriteStr("(a snapshot here), so the closure closes over `")
		cb = cb.WriteStr(varName)
		cb = cb.WriteStr("`'s pre-assignment value, not itself — a recursive ")
		cb = cb.WriteStr("self-call misbehaves; use a named top-level function")
		addDiag(ctx, value.Pos, "recursive-closure-capture", cb.Bytes())
		return
	}
}

// lintShortVarRecursiveClosure dispatches the recursive-closure-capture rule
// over a `:=` short var decl's name/initializer pairs.  STMT_SHORT_VAR is not
// otherwise visited by lintStmt, so this is its only entry point for the rule.
func lintShortVarRecursiveClosure(ctx @lintCtx, s @ast.Stmt) {
	var n int = len(s.Exprs)
	if n > len(s.Exprs2) { n = len(s.Exprs2) }
	for i := 0; i < n; i++ {
		if s.Exprs[i] == nil || s.Exprs[i].Kind != ast.EXPR_IDENT {
			continue
		}
		lintRecursiveClosureCapture(ctx, s.Exprs[i].Name, s.Exprs2[i])
	}
}
