package "pkg/binate/lint"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for the recursive-closure-capture rule (recursive_closure_capture.bn).
// The footgun: capture-by-value snapshots a variable's PRE-assignment value, so
// a closure assigned to a variable it also captures closes over a stale value,
// not itself — recursive lambdas are unsupported by design.

// A closure REASSIGNED to a func-value var it captures fires the rule (the
// canonical recursive-lambda mistake; the closure captures the previous value
// of `g`, the `return 0` stub).
func TestRecursiveClosureCaptureReassign() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var g @func(int) int = func(x int) int { return 0 }\n"
		"  g = func(x int) int {\n"
		"    if x <= 1 { return 1 }\n"
		"    return x * g(x - 1)\n"
		"  }\n"
		"  _ = g\n"
		"}\n")
	var r @Result = lintSrc(cb.Bytes())
	return expectDiag(r, "recursive-closure-capture")
}

// A closure that captures a DIFFERENT variable than the one it is assigned to
// is the normal capture idiom and must NOT fire — pin the negative so the rule
// doesn't over-fire on ordinary closures.
func TestRecursiveClosureCaptureOtherVarNoWarn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var w int = 5\n"
		"  var f @func() int = func() int { return w }\n"
		"  _ = f\n"
		"}\n")
	var r @Result = lintSrc(cb.Bytes())
	return expectNoDiag(r, "recursive-closure-capture")
}

// A non-capturing closure assigned to a var never fires — there is no capture
// list to match the target against.
func TestRecursiveClosureCaptureNonCapturingNoWarn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var d @func(int) int = func(x int) int { return x * 2 }\n"
		"  _ = d\n"
		"}\n")
	var r @Result = lintSrc(cb.Bytes())
	return expectNoDiag(r, "recursive-closure-capture")
}
