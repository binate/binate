package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/stdx/containers/mapfn"
import "pkg/stdx/containers/setfn"
import "pkg/stdx/containers/vec"

// ============================================================
// Shared reference index
// ============================================================
//
// A single walk of a package's merged AST records every reference
// site, so the "unused" rules can share one traversal:
//
//   - Package qualifiers, per source file — `pkg.X` / `pkg.T`.  Keyed
//     by (file, alias) because unused-import is a per-file check.
//   - Value names, package-wide — every bare `EXPR_IDENT` (including a
//     selector's base ident).  Consumed by unused-func / unused-global.
//   - Type names, package-wide — every unqualified `TEXPR_NAMED` (and
//     instantiation head).  Consumed by unused-type.
//
// Over-counting is deliberately safe: a local variable that shadows a
// top-level name records the top-level name as "referenced", so a rule
// can only ever UNDER-warn, never false-positive.

type refIndex struct {
	// Per-file package qualifiers (unused-import).
	QualFiles @vec.Vec[@[]char]
	QualNames @vec.Vec[@[]char]
	// CurFile is the source file of the top-level decl being walked;
	// every qualifier in its subtree is attributed to it.
	CurFile @[]char
	// Package-wide referenced value names (unused-func / -global).  A set:
	// membership answers valRefd, and unused-func iterates it to seed reachability.
	ValNames @setfn.SetFn[@[]char]
	// Package-wide referenced type names → reference COUNT (unused-type compares
	// the count against a type's own self-references, so this must count, not dedup).
	TypeCounts @mapfn.MapFn[@[]char, int]
}

// newRefIndex returns an empty index.
func newRefIndex() @refIndex {
	var idx @refIndex = make(refIndex)
	idx.QualFiles = vec.New[@[]char]()
	idx.QualNames = vec.New[@[]char]()
	idx.ValNames = setfn.NewSetFn[@[]char](nameHash, nameEq)
	idx.TypeCounts = mapfn.NewMapFn[@[]char, int](nameHash, nameEq)
	return idx
}

// addQual records that CurFile references package qualifier `name`.  QualFiles
// and QualNames grow in lockstep, so index i names one (file, qualifier) pair.
func (idx @refIndex) addQual(name @[]char) {
	if len(name) == 0 { return }
	idx.QualFiles.Push(idx.CurFile)
	idx.QualNames.Push(name)
}

// addVal records a package-wide value-name reference.
func (idx @refIndex) addVal(name @[]char) {
	if len(name) == 0 { return }
	idx.ValNames.Add(name)
}

// addType records a package-wide type-name reference, bumping its count.
func (idx @refIndex) addType(name @[]char) {
	if len(name) == 0 { return }
	var n int
	n, _ = idx.TypeCounts.Get(name)
	idx.TypeCounts.Put(name, n + 1)
}

// qualUsed reports whether file `f` references package qualifier `name`.
func (idx @refIndex) qualUsed(f @[]char, name @[]char) bool {
	for i := 0; i < idx.QualFiles.Len(); i++ {
		if streq(idx.QualFiles.Get(i), f) && streq(idx.QualNames.Get(i), name) {
			return true
		}
	}
	return false
}

// valRefd reports whether value name `name` is referenced anywhere in
// the package.
func (idx @refIndex) valRefd(name @[]char) bool {
	return idx.ValNames.Has(name)
}

// typeRefd reports whether type name `name` is referenced anywhere in
// the package.
func (idx @refIndex) typeRefd(name @[]char) bool {
	return idx.TypeCounts.Has(name)
}

// typeRefCount returns how many times type name `name` is referenced.
// unused-type subtracts a type's self-references (counted by re-walking
// its own decl into a fresh index) from this to decide external use.
func (idx @refIndex) typeRefCount(name @[]char) int {
	var n int
	n, _ = idx.TypeCounts.Get(name)
	return n
}

// ============================================================
// AST walk
// ============================================================

// collectRefs walks every top-level decl of the merged AST, recording
// each reference attributed to the decl's own source file.
func collectRefs(idx @refIndex, merged @ast.File) {
	if merged == nil { return }
	for i := 0; i < len(merged.Decls); i++ {
		var d @ast.Decl = merged.Decls[i]
		if d == nil { continue }
		idx.CurFile = d.Pos.File
		walkDeclRefs(idx, d)
	}
}

// walkTypeRefs records references from a type expression: a qualified
// named type (`pkg.T`) records the package qualifier; an unqualified
// named type records the type name.
func walkTypeRefs(idx @refIndex, t @ast.TypeExpr) {
	if t == nil { return }
	if t.Kind == ast.TEXPR_NAMED {
		if len(t.Pkg) > 0 {
			idx.addQual(t.Pkg)
		} else {
			idx.addType(t.Name)
		}
	}
	walkTypeRefs(idx, t.Base)
	walkExprRefs(idx, t.Len)
	for i := 0; i < len(t.Fields); i++ {
		walkTypeRefs(idx, t.Fields[i].Type)
	}
	for i := 0; i < len(t.ParamTypes); i++ {
		walkTypeRefs(idx, t.ParamTypes[i])
	}
	for i := 0; i < len(t.ResultTypes); i++ {
		walkTypeRefs(idx, t.ResultTypes[i])
	}
	for i := 0; i < len(t.TypeArgs); i++ {
		walkTypeRefs(idx, t.TypeArgs[i])
	}
}

// walkExprRefs records references from an expression.  A package
// reference is a selector whose base is a bare identifier (`pkg.X`); a
// value reference is any bare identifier (the selector's base ident is
// recorded on the recursive descent below).
func walkExprRefs(idx @refIndex, e @ast.Expr) {
	if e == nil { return }
	if e.Kind == ast.EXPR_IDENT {
		idx.addVal(e.Name)
	}
	if e.Kind == ast.EXPR_SELECTOR && e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		idx.addQual(e.X.Name)
	}
	// A generic instantiation type argument in value position —
	// `f[secret](x)` — parses as EXPR_INSTANTIATE_OR_INDEX with a bare
	// EXPR_IDENT arg (the checker resolves it as a type without
	// rewriting the node), so it would otherwise be recorded only as a
	// value ref.  Record such idents as TYPE refs too, so an unexported
	// type used only there is not falsely flagged unused.  For a real
	// index `a[i]`, `i` is over-counted as a type ref — harmless, since
	// over-counting can only under-warn, never false-flag.
	if e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		for i := 0; i < len(e.Args); i++ {
			if e.Args[i] != nil && e.Args[i].Kind == ast.EXPR_IDENT {
				idx.addType(e.Args[i].Name)
			}
		}
	}
	walkExprRefs(idx, e.X)
	walkExprRefs(idx, e.Y)
	walkExprRefs(idx, e.Z)
	for i := 0; i < len(e.Args); i++ {
		walkExprRefs(idx, e.Args[i])
	}
	walkTypeRefs(idx, e.TypeRef)
	for i := 0; i < len(e.Elems); i++ {
		walkExprRefs(idx, e.Elems[i].Key)
		walkExprRefs(idx, e.Elems[i].Value)
	}
	if e.DeclRef != nil {
		walkDeclRefs(idx, e.DeclRef)
	}
}

// walkStmtRefs records references from a statement.
func walkStmtRefs(idx @refIndex, s @ast.Stmt) {
	if s == nil { return }
	for i := 0; i < len(s.Stmts); i++ {
		walkStmtRefs(idx, s.Stmts[i])
	}
	for i := 0; i < len(s.Exprs); i++ {
		walkExprRefs(idx, s.Exprs[i])
	}
	for i := 0; i < len(s.Exprs2); i++ {
		walkExprRefs(idx, s.Exprs2[i])
	}
	walkExprRefs(idx, s.X)
	walkStmtRefs(idx, s.Body)
	walkStmtRefs(idx, s.Else)
	walkStmtRefs(idx, s.Init)
	walkStmtRefs(idx, s.Post)
	walkExprRefs(idx, s.ForKey)
	walkExprRefs(idx, s.ForVal)
	for i := 0; i < len(s.Cases); i++ {
		var cc @ast.CaseClause = s.Cases[i]
		for j := 0; j < len(cc.Exprs); j++ {
			walkExprRefs(idx, cc.Exprs[j])
		}
		// A type-switch case label (`case *foo.Bar, @Baz:`) references the named
		// types / package qualifiers in its AssertTargetList — record them, exactly
		// as walkExprRefs records a single assertion's e.TypeRef, else a type or
		// import used ONLY in a case label reads as unused (a false-positive lint).
		for j := 0; j < len(cc.Types); j++ {
			walkTypeRefs(idx, cc.Types[j])
		}
		for j := 0; j < len(cc.Body); j++ {
			walkStmtRefs(idx, cc.Body[j])
		}
	}
	if s.DeclRef != nil {
		walkDeclRefs(idx, s.DeclRef)
	}
}

// walkDeclRefs records references from a declaration's signature,
// body, and nested decls.  A decl's own NAME is not recorded (it is a
// definition, not a use).
func walkDeclRefs(idx @refIndex, d @ast.Decl) {
	if d == nil { return }
	if d.Recv != nil {
		walkTypeRefs(idx, d.Recv.Type)
	}
	for i := 0; i < len(d.Params); i++ {
		walkTypeRefs(idx, d.Params[i].Type)
	}
	for i := 0; i < len(d.Results); i++ {
		walkTypeRefs(idx, d.Results[i])
	}
	for i := 0; i < len(d.TypeParams); i++ {
		walkTypeRefs(idx, d.TypeParams[i].Constraint)
	}
	walkTypeRefs(idx, d.TypeRef)
	walkExprRefs(idx, d.Value)
	walkStmtRefs(idx, d.Body)
	for i := 0; i < len(d.Decls); i++ {
		walkDeclRefs(idx, d.Decls[i])
	}
	for i := 0; i < len(d.Interfaces); i++ {
		walkTypeRefs(idx, d.Interfaces[i])
	}
	// Annotation arguments (`#[tool.x(expr)]`) are arbitrary
	// expressions that can reference package symbols, imports, or types
	// — a symbol referenced only there must still count as used.
	for i := 0; i < len(d.Annotations); i++ {
		var an @ast.Annotation = d.Annotations[i]
		if an == nil { continue }
		for j := 0; j < len(an.Args); j++ {
			walkExprRefs(idx, an.Args[j])
		}
	}
}
