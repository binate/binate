package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// buildIndex parses a single source and returns its reference index.
// The index is purely syntactic, so no type-check pass is needed.
func buildIndex(src *[]readonly char) @refIndex {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var idx @refIndex = newRefIndex()
	collectRefs(idx, file)
	return idx
}

// A package qualifier (`foo.Bar`) is recorded and attributed to the
// file it appears in; the selector's field name is not a qualifier.
func TestRefIndexQualUsed() testing.TestResult {
	var idx @refIndex = buildIndex(
		"package \"test\"\nfunc f() { foo.Bar() }\n")
	if !idx.qualUsed("test.bn", "foo") {
		return "expected qualifier foo used in test.bn"
	}
	if idx.qualUsed("other.bn", "foo") {
		return "qualifier must be attributed to its own file only"
	}
	if idx.qualUsed("test.bn", "Bar") {
		return "did not expect a qualifier named Bar"
	}
	return ""
}

// A bare identifier is recorded as a value reference (package-wide).
func TestRefIndexValRefd() testing.TestResult {
	var idx @refIndex = buildIndex(
		"package \"test\"\nvar g int = 0\nfunc f() int { return g }\n")
	if !idx.valRefd("g") {
		return "expected value ref g"
	}
	if idx.valRefd("nope") {
		return "did not expect value ref nope"
	}
	return ""
}

// An unqualified named type is recorded as a type reference (via the
// param type here); a nonexistent name is not.
func TestRefIndexTypeRefd() testing.TestResult {
	var idx @refIndex = buildIndex(
		"package \"test\"\ntype T struct { x int }\nfunc f(t T) {}\n")
	if !idx.typeRefd("T") {
		return "expected type ref T"
	}
	if idx.typeRefd("Missing") {
		return "did not expect type ref Missing"
	}
	return ""
}

// Generic instantiation records the referenced type names: `Vec[int]`
// in type position records the head `Vec` (via TEXPR_INSTANTIATE.Base);
// `f[secret](0)` in value position records the arg `secret` (via the
// EXPR_INSTANTIATE_OR_INDEX arm).
func TestRefIndexInstantiationTypeRefs() testing.TestResult {
	var idx @refIndex = buildIndex(
		"package \"test\"\nvar v Vec[int] = nil\n"
		"func use() { f[secret](0) }\n")
	if !idx.typeRefd("Vec") {
		return "expected type ref Vec (type-position instantiation head)"
	}
	if !idx.typeRefd("secret") {
		return "expected type ref secret (value-position generic type arg)"
	}
	return ""
}
