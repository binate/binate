package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/strings"

// ============================================================
// Rule: unused-const
// ============================================================
//
// Flags an unexported package-level `const` unreachable from any root (the
// shared reachability in reach.bn).  REACHABILITY, not mere reference-presence:
// a const referenced nowhere, OR referenced only by dead code (an unreachable
// private func), is flagged.  A const declared in the package's `.bni` is the
// exported contract — a root, never flagged; a blank `const _ = …` is a discard.
// A local shadowing the const name over-counts it as used, so the rule only ever
// UNDER-warns, never false-positives.

// lintUnusedConsts flags unexported package-level consts unreachable from a root.
func lintUnusedConsts(ctx @lintCtx, s @reachState) {
	for i := 0; i < s.constCands.Len(); i++ {
		var d @ast.Decl = s.constCands.Get(i)
		if !s.isReach(d.Name) {
			addDiag(ctx, d.Pos, "unused-const", unusedConstMsg(d.Name))
		}
	}
}

// unusedConstMsg builds the diagnostic message for an unused const.
func unusedConstMsg(name @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("unused constant: ")
	cb.Write(name)
	return buf.CopyStr(cb.String())
}
