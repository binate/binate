package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// lintSrcWithBniConst parses+checks a `.bn` source, then appends a synthetic
// `.bni`-sourced DECL_CONST named `name` — as the loader would prepend from the
// package's `.bni` — and lints.  Exercises the exported-const skip (the unit
// harness doesn't run the loader, so `.bni` provenance must be synthesized).
func lintSrcWithBniConst(src *[]readonly char, name @[]char) @Result {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	var bniDecl @ast.Decl = make(ast.Decl)
	bniDecl.Kind = ast.DECL_CONST
	bniDecl.Name = name
	bniDecl.FromBNI = true
	appendDecl(file, bniDecl)
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = file
	return LintFile(c, file, files)
}

// lintSrcWithBniConstGroup is lintSrcWithBniConst but wraps the synthetic const
// in a `.bni`-sourced GROUP whose MEMBER is left FromBNI == false — reproducing
// how the loader marks only the group node.  Exercises the group-FromBNI
// propagation (a grouped `.bni` const must still count as the exported contract).
func lintSrcWithBniConstGroup(src *[]readonly char, name @[]char) @Result {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	var member @ast.Decl = make(ast.Decl)
	member.Kind = ast.DECL_CONST
	member.Name = name
	var grp @ast.Decl = make(ast.Decl)
	grp.Kind = ast.DECL_GROUP
	grp.FromBNI = true
	var gd @[]@ast.Decl = make_slice(@ast.Decl, 1)
	gd[0] = member
	grp.Decls = gd
	appendDecl(file, grp)
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = file
	return LintFile(c, file, files)
}

// appendDecl appends one decl to a file's top-level decl list.
func appendDecl(file @ast.File, d @ast.Decl) {
	var nd @[]@ast.Decl = make_slice(@ast.Decl, len(file.Decls) + 1)
	for i := 0; i < len(file.Decls); i++ {
		nd[i] = file.Decls[i]
	}
	nd[len(file.Decls)] = d
	file.Decls = nd
}

// An unexported const referenced nowhere is flagged.
func TestUnusedConstFlagged() testing.TestResult {
	var r @Result = lintSrc("package \"test\"\nconst SECRET int = 0\n")
	return expectDiag(r, "unused-const")
}

// A const read in a reachable function is not flagged.
func TestConstUsedByReachableFuncNotFlagged() testing.TestResult {
	var r @Result = lintSrcRooted(
			"package \"test\"\nconst K int = 5\nfunc f() int { return K }\n", "f")
	return expectNoDiag(r, "unused-const")
}

// Reachability: a const referenced ONLY from a dead (unreachable) private func is
// itself unreachable — flagged.
func TestConstUsedOnlyByDeadFuncFlagged() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\nconst K int = 5\nfunc dead() int { return K }\n")
	return expectDiag(r, "unused-const")
}

// A const declared in the `.bni` (exported) is part of the contract — not flagged
// even if unused within the package.
func TestExportedConstNotFlagged() testing.TestResult {
	var r @Result = lintSrcWithBniConst("package \"test\"\nconst K int = 0\n", "K")
	return expectNoDiag(r, "unused-const")
}

// A const exported via a `.bni` GROUP (the member itself not FromBNI, only the
// group node) is still the exported contract — not flagged.  Guards the
// group-FromBNI propagation.
func TestExportedConstGroupMemberNotFlagged() testing.TestResult {
	var r @Result = lintSrcWithBniConstGroup("package \"test\"\nconst K int = 0\n", "K")
	return expectNoDiag(r, "unused-const")
}
