package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/buildcfg"
import "pkg/std/strings"
import "pkg/stdx/containers/mapfn"
import "pkg/stdx/containers/setfn"
import "pkg/stdx/containers/vec"

// ============================================================
// Rule: unused-func
// ============================================================
//
// Flags an unexported top-level function unreachable from any "root":
// an exported function, `main`, a method, or a package-level `var`/
// `const` initializer.  REACHABILITY (not mere reference-presence) is
// used so a dead-code ISLAND — mutually-recursive private funcs that
// reference only each other but no root — is still flagged.
//
// Methods are excluded (dispatched via vtable/selector, not a bare name
// — flagging them risks false positives on interface impls).  A local
// or param that shadows a func name over-counts it as reachable, so the
// rule only ever UNDER-warns.  References come from the value-name set
// of each decl (calls, bare function values, generic-call heads).

// funcReach holds the reachability worklist state for one package.
type funcReach struct {
	CNames @mapfn.MapFn[@[]char, int] // candidate func name → index into CDecls
	CDecls @vec.Vec[@ast.Decl] // candidate func decls (candIndex indexes this)
	Work   @vec.Vec[@[]char] // names still to process (an ordered queue)
	Reach  @setfn.SetFn[@[]char] // set of candidate names proven reachable
}

// newFuncReach returns an empty reachability state for one package.
func newFuncReach() @funcReach {
	var s @funcReach = make(funcReach)
	s.CNames = mapfn.NewMapFn[@[]char, int](nameHash, nameEq)
	s.CDecls = vec.New[@ast.Decl]()
	s.Work = vec.New[@[]char]()
	s.Reach = setfn.NewSetFn[@[]char](nameHash, nameEq)
	return s
}

// addCand records a candidate func (name → its decl's index).
func (s @funcReach) addCand(name @[]char, d @ast.Decl) {
	s.CNames.Put(name, s.CDecls.Len())
	s.CDecls.Push(d)
}

// pushWork enqueues a name to process; empty names are skipped.
func (s @funcReach) pushWork(name @[]char) {
	if len(name) == 0 { return }
	s.Work.Push(name)
}

// markReach records candidate name as reachable.
func (s @funcReach) markReach(name @[]char) {
	s.Reach.Add(name)
}

// isReach reports whether candidate name was proven reachable.
func (s @funcReach) isReach(name @[]char) bool {
	return s.Reach.Has(name)
}

// candIndex returns the CDecls index of candidate name, or -1 if not a candidate.
func (s @funcReach) candIndex(name @[]char) int {
	var i int
	var ok bool
	i, ok = s.CNames.Get(name)
	if !ok { return -1 }
	return i
}

// isUnusedFuncCandidate reports whether `d` is an unexported top-level
// function eligible for the unused-func check.
func isUnusedFuncCandidate(d @ast.Decl) bool {
	if d == nil || d.Kind != ast.DECL_FUNC { return false }
	if d.Recv != nil { return false } // methods dispatched by vtable
	if d.Exported { return false } // part of the package contract
	// A `#[c_export("name")]` function is called from C under its exported name
	// (e.g. startup._entry is crt0's `main`), so it is a reachability root, not an
	// unused candidate — like an exported function is part of the package contract.
	if buildcfg.HasCExport(d.Annotations) { return false }
	if d.Body == nil { return false } // extern / forward declaration
	if streq(d.Name, "main") { return false }
	// A `Test…` / `Benchmark…` function (in a `_test.bn`, linted under
	// --tests) is a framework entry point — invoked by the test runner, not
	// by in-package code.  Treat it as a ROOT, not a candidate, so it is not
	// flagged AND anything it calls (test helpers) counts as reachable.
	if isTestEntryName(d.Name) { return false }
	return true
}

// isTestEntryName reports whether `name` is a test-framework entry point
// (a `Test…` or `Benchmark…` function).
func isTestEntryName(name *[]readonly char) bool {
	return hasNamePrefix(name, "Test") || hasNamePrefix(name, "Benchmark")
}

// hasNamePrefix reports whether `name` starts with `prefix`.
func hasNamePrefix(name *[]readonly char, prefix *[]readonly char) bool {
	if len(name) < len(prefix) { return false }
	for i := 0; i < len(prefix); i++ {
		if name[i] != prefix[i] { return false }
	}
	return true
}

// pushDeclValRefs adds every value name referenced within decl `d` to
// the worklist (`d`'s signature, body, initializer, nested decls).
func pushDeclValRefs(s @funcReach, d @ast.Decl) {
	var idx @refIndex = newRefIndex()
	walkDeclRefs(idx, d)
	// ValNames is a set; enqueuing each referenced name once is sufficient — the
	// reachability closure already skips names it has processed (isReach).
	var it setfn.SetCursor[@[]char] = idx.ValNames.Iter()
	var name @[]char
	var ok bool
	name, ok = it.Next()
	for ok {
		s.pushWork(name)
		name, ok = it.Next()
	}
}

// collectCandidates records candidate funcs (recursing groups).
func collectCandidates(s @funcReach, decls @[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d == nil { continue }
		if d.Kind == ast.DECL_GROUP {
			collectCandidates(s, d.Decls)
			continue
		}
		if isUnusedFuncCandidate(d) {
			s.addCand(d.Name, d)
		}
	}
}

// seedRoots seeds the worklist with the value refs of every ROOT decl —
// anything that is NOT a candidate func (exported funcs, methods, main,
// package-level var/const/type decls).  Recurses groups.
func seedRoots(s @funcReach, decls @[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d == nil { continue }
		if d.Kind == ast.DECL_GROUP {
			seedRoots(s, d.Decls)
			continue
		}
		if isUnusedFuncCandidate(d) { continue }
		pushDeclValRefs(s, d)
	}
}

// lintUnusedFuncs flags unexported top-level funcs unreachable from a root.
func lintUnusedFuncs(ctx @lintCtx, merged @ast.File) {
	if merged == nil { return }
	var s @funcReach = newFuncReach()
	collectCandidates(s, merged.Decls)
	if s.CNames.Len() == 0 { return }
	seedRoots(s, merged.Decls)

	// Reachability closure: a candidate referenced from a root (or from
	// an already-reachable candidate) is reachable; process its refs too.
	// Work grows during the walk (pushWork), and Len re-reads the current
	// length each iteration, so newly-enqueued names are still processed.
	var qi int = 0
	for qi < s.Work.Len() {
		var name @[]char = s.Work.Get(qi)
		qi = qi + 1
		if s.isReach(name) { continue }
		var ci int = s.candIndex(name)
		if ci < 0 { continue }
		s.markReach(name)
		pushDeclValRefs(s, s.CDecls.Get(ci))
	}

	// Flag candidates never reached.  Iterate CDecls (a candidate's name is its
	// decl's Name — exactly the key addCand recorded), so no index into CNames.
	for i := 0; i < s.CDecls.Len(); i++ {
		var d @ast.Decl = s.CDecls.Get(i)
		if !s.isReach(d.Name) {
			addDiag(ctx, d.Pos, "unused-func", unusedFuncMsg(d.Name))
		}
	}
}

// unusedFuncMsg builds the diagnostic message for an unused function.
func unusedFuncMsg(name @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("unused function: ")
	cb.Write(name)
	return buf.CopyStr(cb.String())
}
