package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/strings"

// ============================================================
// Rule: unused-func
// ============================================================
//
// Flags an unexported top-level function unreachable from any root.  The shared
// reachability (reach.bn) treats exported funcs, `main`, `#[c_export]` and
// `Test…` / `Benchmark…` entries, and methods as roots, and unexported
// non-method funcs as candidates; REACHABILITY (not mere reference-presence)
// means a dead-code ISLAND — mutually-recursive private funcs that reference
// only each other but no root — is still flagged.  A local or param that shadows
// a func name over-counts it as reachable, so the rule only ever UNDER-warns.

// lintUnusedFuncs flags unexported top-level funcs unreachable from a root.
func lintUnusedFuncs(ctx @lintCtx, s @reachState) {
	for i := 0; i < s.funcCands.Len(); i++ {
		var d @ast.Decl = s.funcCands.Get(i)
		if !s.isReach(d.Name) {
			addDiag(ctx, d.Pos, "unused-func", unusedFuncMsg(d.Name))
		}
	}
}

// unusedFuncMsg builds the diagnostic message for an unused function.
func unusedFuncMsg(name @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("unused function: ")
	cb.Write(name)
	return buf.CopyStr(cb.String())
}
