package "pkg/binate/lint"

import "pkg/builtins/testing"

// ============================================================
// unused-func
// ============================================================

// A lone unexported function referenced nowhere is flagged.
func TestUnusedFuncFlagged() testing.TestResult {
	var r @Result = lintSrc("package \"test\"\nfunc f() {}\n")
	return expectDiag(r, "unused-func")
}

// A function called from main is reachable — not flagged.
func TestFuncCalledFromMainNotFlagged() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\nfunc helper() {}\nfunc main() { helper() }\n")
	return expectNoDiag(r, "unused-func")
}

// Reachability discriminator: a dead-code ISLAND — a() and b() call
// only each other, reachable from no root — flags BOTH (reference-
// presence would flag neither).
func TestUnusedFuncIslandBothFlagged() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\nfunc a() { b() }\nfunc b() { a() }\n")
	if countRule(r, "unused-func") != 2 {
		return "expected both island funcs (a, b) flagged"
	}
	return ""
}

// A function used as a bare function value is reachable — not flagged.
func TestFuncUsedAsValueNotFlagged() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\nfunc h() {}\nfunc main() { var f = h\n _ = f }\n")
	return expectNoDiag(r, "unused-func")
}

// A method (receiver != nil) is excluded — dispatched via vtable/
// selector, not a bare name — so it is never flagged unused-func.
func TestMethodNotFlaggedAsUnusedFunc() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\ntype T int\nfunc (t T) m() {}\n")
	return expectNoDiag(r, "unused-func")
}

// A function referenced by a package-level var initializer is reachable
// (the global is a root) — not flagged.
func TestFuncUsedByGlobalInitNotFlagged() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\nfunc mk() int { return 0 }\nvar g int = mk()\n")
	return expectNoDiag(r, "unused-func")
}

// A `Test…` function is a test-framework entry point — a reachability root
// (invoked by the runner, not in-package code), so it is not flagged, and a
// helper it calls is reachable through it.  (Relevant when linting `_test.bn`
// under bnlint --tests.)
func TestTestEntryAndHelperNotFlagged() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\nfunc helper() int { return 0 }\n"
					"func TestThing() { _ = helper() }\n")
	return expectNoDiag(r, "unused-func")
}
