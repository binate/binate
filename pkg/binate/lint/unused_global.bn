package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/strings"

// ============================================================
// Rule: unused-global
// ============================================================
//
// Flags an unexported package-level `var` unreachable from any root (the shared
// reachability in reach.bn).  REACHABILITY, not mere reference-presence: a global
// used ONLY by dead code (an unreachable private func) is flagged, because the
// dead code's references are never seeded.  A `.bni`-sourced or exported var is
// the package contract; a blank `var _ = …` is an intentional discard whose
// initializer still runs for side effects (the escape hatch for a side-effect-
// only global) — both are roots, never candidates.  A local/param shadowing the
// global's name over-counts it as used, so the rule only ever UNDER-warns.

// lintUnusedGlobals flags unexported package-level vars unreachable from a root.
func lintUnusedGlobals(ctx @lintCtx, s @reachState) {
	for i := 0; i < s.globalCands.Len(); i++ {
		var d @ast.Decl = s.globalCands.Get(i)
		if !s.isReach(d.Name) {
			addDiag(ctx, d.Pos, "unused-global", unusedGlobalMsg(d.Name))
		}
	}
}

// unusedGlobalMsg builds the diagnostic message for an unused global.
func unusedGlobalMsg(name @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("unused package variable: ")
	cb.Write(name)
	return buf.CopyStr(cb.String())
}
