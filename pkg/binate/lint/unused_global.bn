package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/strings"

// ============================================================
// Rule: unused-global
// ============================================================
//
// Flags an unexported package-level `var` whose name is never
// referenced anywhere in the package.  "Unexported" = not declared in
// the package's `.bni` (`Decl.Exported`); an exported var is part of
// the package's contract and may legitimately be used only by other
// packages.
//
// Reference-presence: a global counts as used if its name appears as a
// value reference anywhere (the shared refIndex's ValNames) — a read,
// an address-of, another global's initializer, or any function body.  A
// local or parameter that shadows the global's name over-counts it as
// used, so this rule only ever UNDER-warns, never false-positives.
//
// Blank vars (`var _ = ...`) are intentional discards; never flagged.
// Consts are out of scope (unused consts are common and noisy).
//
// Known under-report: a global used ONLY by dead code (an unused
// private func) is NOT flagged here — its name still appears.  The
// reachability variant (see the unused-func rule) catches that; the
// reference-presence stance here is the maintainer's choice for (d).

// lintUnusedGlobals flags unexported, unreferenced package-level vars.
func lintUnusedGlobals(ctx @lintCtx, merged @ast.File, idx @refIndex) {
	if merged == nil { return }
	for i := 0; i < len(merged.Decls); i++ {
		lintUnusedGlobalDecl(ctx, merged.Decls[i], idx)
	}
}

// lintUnusedGlobalDecl checks one decl, recursing `var ( ... )` groups.
func lintUnusedGlobalDecl(ctx @lintCtx, d @ast.Decl, idx @refIndex) {
	if d == nil { return }
	if d.Kind == ast.DECL_GROUP {
		for i := 0; i < len(d.Decls); i++ {
			lintUnusedGlobalDecl(ctx, d.Decls[i], idx)
		}
		return
	}
	if d.Kind != ast.DECL_VAR { return }
	// A `.bni`-sourced decl is an interface declaration, not the
	// package's definition — the impl `.bn` var is the candidate.
	if d.FromBNI { return }
	// Exported (declared in the `.bni`) vars are part of the contract.
	if d.Exported { return }
	// Blank vars are intentional discards.
	if streq(d.Name, "_") { return }
	if idx.valRefd(d.Name) { return }
	addDiag(ctx, d.Pos, "unused-global", unusedGlobalMsg(d.Name))
}

// unusedGlobalMsg builds the diagnostic message for an unused global.
func unusedGlobalMsg(name @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("unused package variable: ")
	cb.Write(name)
	return buf.CopyStr(cb.String())
}
