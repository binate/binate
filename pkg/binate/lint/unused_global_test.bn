package "pkg/binate/lint"

import "pkg/builtins/testing"

// ============================================================
// unused-global
// ============================================================

// An unexported package var referenced nowhere is flagged.
func TestUnusedGlobalFlagged() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x int = 0\n"
	var r @Result = lintSrc(src)
	return expectDiag(r, "unused-global")
}

// A package var read in a (reachable) function body is not flagged.
func TestUsedGlobalNotFlagged() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x int = 0\nfunc f() int { return x }\n"
	var r @Result = lintSrcRooted(src, "f")
	return expectNoDiag(r, "unused-global")
}

// A package var referenced by a (reachable) global's initializer, whose chain
// is rooted, counts as used.
func TestGlobalUsedByAnotherGlobalInit() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar base int = 5\nvar derived int = base\n"
			"func use() int { return derived }\n"
	var r @Result = lintSrcRooted(src, "use")
	return expectNoDiag(r, "unused-global")
}

// Taking a global's address in a reachable function counts as a use.
func TestGlobalAddressOfNotFlagged() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x int = 0\nfunc f() *int { return &x }\n"
	var r @Result = lintSrcRooted(src, "f")
	return expectNoDiag(r, "unused-global")
}

// A `var ( ... )` group with one member used by a reachable function flags
// exactly the other, unused member (verifies group recursion).
func TestGlobalGroupOneUnused() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar (\n\ta int = 1\n\tb int = 2\n)\n"
			"func f() int { return a }\n"
	var r @Result = lintSrcRooted(src, "f")
	if countRule(r, "unused-global") != 1 {
		return "expected exactly one unused-global (b)"
	}
	return ""
}

// A blank var is an intentional discard; never flagged.
func TestBlankGlobalNotFlagged() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar _ int = 0\n"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "unused-global")
}

// An exported var (declared in the .bni) is part of the contract and
// not flagged even if unused within the package.
func TestExportedGlobalNotFlagged() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x int = 0\n"
	var r @Result = lintSrcVarsExported(src)
	return expectNoDiag(r, "unused-global")
}

// A local shadowing a global's name over-counts the global as used (in a
// reachable function) — a safe under-warning, never a false positive.
func TestGlobalShadowedNameNotFlagged() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x int = 0\n"
			"func f() { var x int = 1; _ = x }\n"
	var r @Result = lintSrcRooted(src, "f")
	return expectNoDiag(r, "unused-global")
}

// Reachability: a global referenced ONLY from a dead (unreachable) private
// function is itself unreachable — flagged.  `dead` reaches no root, so its
// reference to `g` never counts; both `dead` (unused-func) and `g`
// (unused-global) are dead code.
func TestGlobalUsedOnlyByDeadFuncFlagged() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar g int = 0\n"
			"func dead() int { return g }\n"
	var r @Result = lintSrc(src)
	return expectDiag(r, "unused-global")
}
