package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/buf"

// ============================================================
// Rule: unused-import
// ============================================================
//
// Flags an import whose package name is never referenced in the
// file that declared it.  The check is per-file (Go-style): an
// import counts as used only if its own source file qualifies a
// name with it (an expression `pkg.X` or a type `pkg.T`).
//
// LintFile receives the package's merged AST, but MergeFiles
// preserves each node's source file in `Pos.File` and dedups
// imports by (alias, path).  So usage is attributed to the file a
// top-level decl came from, and each surviving ImportSpec is
// checked against references from its own file.  The dedup means a
// path imported-and-unused in one file but imported-and-used in
// another is not flagged — a rare, safe under-warning.
//
// Blank imports (`import _ "pkg/foo"`) are intentional side-effect
// imports and are never flagged.

// refCollector accumulates (file, package-qualifier-name) pairs
// gathered while walking the merged AST.  CurFile is the source
// file of the top-level decl currently being walked; every
// qualifier found within that decl's subtree is attributed to it.
type refCollector struct {
	Files   @[]@[]char
	Names   @[]@[]char
	N       int
	CurFile @[]char
}

// newRefCollector returns an empty collector with initial capacity.
func newRefCollector() @refCollector {
	var rc @refCollector = make(refCollector)
	rc.Files = make_slice(@[]char, 32)
	rc.Names = make_slice(@[]char, 32)
	rc.N = 0
	return rc
}

// addQual records that CurFile references package qualifier `name`.
func addQual(rc @refCollector, name @[]char) {
	if len(name) == 0 { return }
	if rc.N >= len(rc.Names) {
		var newCap int = len(rc.Names) * 2
		var nf @[]@[]char = make_slice(@[]char, newCap)
		var nn @[]@[]char = make_slice(@[]char, newCap)
		for i := 0; i < rc.N; i++ {
			nf[i] = rc.Files[i]
			nn[i] = rc.Names[i]
		}
		rc.Files = nf
		rc.Names = nn
	}
	rc.Files[rc.N] = rc.CurFile
	rc.Names[rc.N] = name
	rc.N = rc.N + 1
}

// refUsed reports whether file `f` references qualifier `name`.
func refUsed(rc @refCollector, f @[]char, name @[]char) bool {
	for i := 0; i < rc.N; i++ {
		if streq(rc.Files[i], f) && streq(rc.Names[i], name) {
			return true
		}
	}
	return false
}

// ============================================================
// AST walk — collect package qualifiers
// ============================================================

// walkTypeRefs collects package qualifiers from a type expression.
// A qualified named type (`pkg.T`) carries the package in `Pkg`.
func walkTypeRefs(rc @refCollector, t @ast.TypeExpr) {
	if t == nil { return }
	if t.Kind == ast.TEXPR_NAMED && len(t.Pkg) > 0 {
		addQual(rc, t.Pkg)
	}
	walkTypeRefs(rc, t.Base)
	walkExprRefs(rc, t.Len)
	for i := 0; i < len(t.Fields); i++ {
		walkTypeRefs(rc, t.Fields[i].Type)
	}
	for i := 0; i < len(t.ParamTypes); i++ {
		walkTypeRefs(rc, t.ParamTypes[i])
	}
	for i := 0; i < len(t.ResultTypes); i++ {
		walkTypeRefs(rc, t.ResultTypes[i])
	}
	for i := 0; i < len(t.TypeArgs); i++ {
		walkTypeRefs(rc, t.TypeArgs[i])
	}
}

// walkExprRefs collects package qualifiers from an expression.  A
// package reference is a selector whose base is a bare identifier
// (`pkg.X`); the identifier name is the qualifier.
func walkExprRefs(rc @refCollector, e @ast.Expr) {
	if e == nil { return }
	if e.Kind == ast.EXPR_SELECTOR && e.X != nil &&
			e.X.Kind == ast.EXPR_IDENT {
		addQual(rc, e.X.Name)
	}
	walkExprRefs(rc, e.X)
	walkExprRefs(rc, e.Y)
	walkExprRefs(rc, e.Z)
	for i := 0; i < len(e.Args); i++ {
		walkExprRefs(rc, e.Args[i])
	}
	walkTypeRefs(rc, e.TypeRef)
	for i := 0; i < len(e.Elems); i++ {
		walkExprRefs(rc, e.Elems[i].Key)
		walkExprRefs(rc, e.Elems[i].Value)
	}
	if e.DeclRef != nil {
		walkDeclRefs(rc, e.DeclRef)
	}
}

// walkStmtRefs collects package qualifiers from a statement.
func walkStmtRefs(rc @refCollector, s @ast.Stmt) {
	if s == nil { return }
	for i := 0; i < len(s.Stmts); i++ {
		walkStmtRefs(rc, s.Stmts[i])
	}
	for i := 0; i < len(s.Exprs); i++ {
		walkExprRefs(rc, s.Exprs[i])
	}
	for i := 0; i < len(s.Exprs2); i++ {
		walkExprRefs(rc, s.Exprs2[i])
	}
	walkExprRefs(rc, s.X)
	walkStmtRefs(rc, s.Body)
	walkStmtRefs(rc, s.Else)
	walkStmtRefs(rc, s.Init)
	walkStmtRefs(rc, s.Post)
	walkExprRefs(rc, s.ForKey)
	walkExprRefs(rc, s.ForVal)
	for i := 0; i < len(s.Cases); i++ {
		var cc @ast.CaseClause = s.Cases[i]
		for j := 0; j < len(cc.Exprs); j++ {
			walkExprRefs(rc, cc.Exprs[j])
		}
		for j := 0; j < len(cc.Body); j++ {
			walkStmtRefs(rc, cc.Body[j])
		}
	}
	if s.DeclRef != nil {
		walkDeclRefs(rc, s.DeclRef)
	}
}

// walkDeclRefs collects package qualifiers from a declaration and
// its signature, body, and nested decls.
func walkDeclRefs(rc @refCollector, d @ast.Decl) {
	if d == nil { return }
	if d.Recv != nil {
		walkTypeRefs(rc, d.Recv.Type)
	}
	for i := 0; i < len(d.Params); i++ {
		walkTypeRefs(rc, d.Params[i].Type)
	}
	for i := 0; i < len(d.Results); i++ {
		walkTypeRefs(rc, d.Results[i])
	}
	for i := 0; i < len(d.TypeParams); i++ {
		walkTypeRefs(rc, d.TypeParams[i].Constraint)
	}
	walkTypeRefs(rc, d.TypeRef)
	walkExprRefs(rc, d.Value)
	walkStmtRefs(rc, d.Body)
	for i := 0; i < len(d.Decls); i++ {
		walkDeclRefs(rc, d.Decls[i])
	}
	for i := 0; i < len(d.Interfaces); i++ {
		walkTypeRefs(rc, d.Interfaces[i])
	}
}

// ============================================================
// Entry: lintUnusedImports
// ============================================================

// lintUnusedImports flags imports whose package name is never
// referenced in the importing file.  Run from LintFile after the
// rule walk.
func lintUnusedImports(ctx @lintCtx, file @ast.File) {
	if file == nil { return }
	if len(file.Imports) == 0 { return }

	// One pass: attribute every package qualifier to the file of
	// the top-level decl it appears in.
	var rc @refCollector = newRefCollector()
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d == nil { continue }
		rc.CurFile = d.Pos.File
		walkDeclRefs(rc, d)
	}

	for i := 0; i < len(file.Imports); i++ {
		var imp @ast.ImportSpec = file.Imports[i]
		// Blank imports are intentional side-effect imports.
		if streq(imp.Alias, "_") { continue }
		var path @[]char = stripImportQuotes(imp.Path)
		var local @[]char = imp.Alias
		if len(local) == 0 {
			local = lastSegment(path)
		}
		if !refUsed(rc, imp.Pos.File, local) {
			addDiag(ctx, imp.Pos, "unused-import", unusedImportMsg(path))
		}
	}
}

// unusedImportMsg builds the diagnostic message for an unused import.
func unusedImportMsg(path @[]char) @[]char {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("imported and not used: ")
	cb = cb.WriteStr(path)
	return cb.Bytes()
}

// ============================================================
// Small string helpers (pkg/binate/lint-local)
// ============================================================

// streq reports whether two char slices have identical contents.
func streq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// stripImportQuotes removes the surrounding double quotes the lexer
// keeps on a string-literal import path.  Returns the input
// unchanged if it isn't quote-wrapped.
func stripImportQuotes(s @[]char) @[]char {
	var n int = len(s)
	if n >= 2 && s[0] == '"' && s[n-1] == '"' {
		return s[1:n-1]
	}
	return s
}

// lastSegment returns the final `/`-separated component of a package
// path (the package's default local name when no alias is given).
func lastSegment(path @[]char) @[]char {
	var start int = 0
	for i := 0; i < len(path); i++ {
		if path[i] == '/' { start = i + 1 }
	}
	return path[start:len(path)]
}
