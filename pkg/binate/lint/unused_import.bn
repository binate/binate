package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/strings"

// ============================================================
// Rule: unused-import
// ============================================================
//
// Flags an import whose package name is never referenced in the file
// that declared it.  Per-file (Go-style): an import counts as used
// only if its own source file qualifies a name with it (`pkg.X` or
// `pkg.T`).
//
// References come from the shared refIndex (refs.bn): one walk of the
// merged AST records each package qualifier attributed to the source
// file it appears in (`Pos.File` survives MergeFiles).  Imports are
// then checked PER SOURCE FILE — each impl file's own `Imports` list —
// not the deduped merged list.  This matters because MergeFiles dedups
// imports by (alias, path): a path imported-and-unused in one file but
// imported-and-used in a sibling survives in the merged list only as
// the sibling's spec, so checking the merged list alone would miss the
// genuinely-unused one (and which spec survives is file-order
// dependent).  `.bni`-sourced imports are not in the impl-file list, so
// they are not flagged against `.bn` usage.
//
// Blank imports (`import _ "pkg/foo"`) are intentional side-effect
// imports and are never flagged.
//
// Known limitation: a local variable that shadows an import alias still
// counts as a use of that alias — the walk records any `ident.X`
// selector as a package reference without resolving `ident` to a
// symbol — so a shadowed-then-otherwise-unused import is a silent miss
// (a safe under-warning).

// lintUnusedImports flags imports whose package name is never
// referenced in the importing file.  `files` is the per-impl-file
// ASTs; `idx` is the shared reference index built over the merged AST.
func lintUnusedImports(ctx @lintCtx, files @[]@ast.File, idx @refIndex) {
	for k := 0; k < len(files); k++ {
		var f @ast.File = files[k]
		if f == nil { continue }
		for i := 0; i < len(f.Imports); i++ {
			var imp @ast.ImportSpec = f.Imports[i]
			// Blank imports are intentional side-effect imports.
			if streq(imp.Alias, "_") { continue }
			var path @[]char = stripImportQuotes(imp.Path)
			var local @[]char = imp.Alias
			if len(local) == 0 {
				local = lastSegment(path)
			}
			if !idx.qualUsed(imp.Pos.File, local) {
				addDiag(ctx, imp.Pos, "unused-import", unusedImportMsg(path))
			}
		}
	}
}

// unusedImportMsg builds the diagnostic message for an unused import.
func unusedImportMsg(path @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("imported and not used: ")
	cb.Write(path)
	return buf.CopyStr(cb.String())
}

// ============================================================
// Small string helpers (pkg/binate/lint-local)
// ============================================================

// streq reports whether two char slices have identical contents.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// stripImportQuotes removes the surrounding double quotes the lexer
// keeps on a string-literal import path.  Returns the input unchanged
// if it isn't quote-wrapped.
func stripImportQuotes(s @[]char) @[]char {
	var n int = len(s)
	if n >= 2 && s[0] == '"' && s[n - 1] == '"' {
		return s[1:n - 1]
	}
	return s
}

// lastSegment returns the final `/`-separated component of a package
// path (the package's default local name when no alias is given).
func lastSegment(path @[]char) @[]char {
	var start int = 0
	for i := 0; i < len(path); i++ {
		if path[i] == '/' { start = i + 1 }
	}
	return path[start:len(path)]
}
