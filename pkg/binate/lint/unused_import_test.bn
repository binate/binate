package "pkg/binate/lint"

import "pkg/builtins/testing"

// ============================================================
// unused-import
// ============================================================

// An import never referenced in the file is flagged.
func TestUnusedImportFlagged() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nimport \"pkg/foo\"\nfunc main() {}\n"
	var r @Result = lintSrc(src)
	return expectDiag(r, "unused-import")
}

// An import referenced via an expression qualifier (`foo.Bar`) is
// not flagged, even when the package itself doesn't resolve in the
// test checker — the rule reads the AST, not resolved symbols.
func TestUsedImportExprNotFlagged() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nimport \"pkg/foo\"\nfunc main() { foo.Bar() }\n"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "unused-import")
}

// An import referenced only in a type position (`foo.T`) is not
// flagged.
func TestUsedImportTypeNotFlagged() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nimport \"pkg/foo\"\nfunc main() { var x foo.T; _ = x }\n"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "unused-import")
}

// A reference in a function signature (parameter type) counts as a
// use.
func TestUsedImportParamTypeNotFlagged() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nimport \"pkg/foo\"\nfunc f(x foo.T) { _ = x }\n"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "unused-import")
}

// Blank imports are intentional side-effect imports; never flagged.
func TestBlankImportNotFlagged() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nimport _ \"pkg/foo\"\nfunc main() {}\n"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "unused-import")
}

// An aliased import is matched by its alias, not its path's last
// segment: `import alt "pkg/foo"` used as `alt.Bar()` is fine.
func TestAliasImportUsedNotFlagged() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nimport alt \"pkg/foo\"\nfunc main() { alt.Bar() }\n"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "unused-import")
}

// An aliased import is flagged when the alias is unused, even if a
// bare reference to the path's last segment exists elsewhere.
func TestAliasImportUnusedFlagged() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nimport alt \"pkg/foo\"\nfunc main() {}\n"
	var r @Result = lintSrc(src)
	return expectDiag(r, "unused-import")
}

// Multiple imports: only the unused one is flagged, and the used
// one is not.
func TestMixedImportsOnlyUnusedFlagged() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nimport \"pkg/foo\"\nimport \"pkg/bar\"\n"
		"func main() { foo.Do() }\n"
	var r @Result = lintSrc(src)
	// foo is used → no false positive; bar is unused → flagged.
	var t1 testing.TestResult = expectDiag(r, "unused-import")
	if len(t1) != 0 { return t1 }
	// Exactly one unused-import diagnostic expected.
	var count int = 0
	for i := 0; i < r.NumDiags; i++ {
		if charEq(r.Diags[i].Rule, "unused-import") { count = count + 1 }
	}
	if count != 1 {
		return "expected exactly one unused-import diagnostic"
	}
	return ""
}
