package "pkg/binate/lint"

import "pkg/builtins/testing"

// ============================================================
// unused-import
// ============================================================

// An import never referenced in the file is flagged.
func TestUnusedImportFlagged() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nimport \"pkg/foo\"\nfunc main() {}\n"
	var r @Result = lintSrc(src)
	return expectDiag(r, "unused-import")
}

// An import referenced via an expression qualifier (`foo.Bar`) is
// not flagged, even when the package itself doesn't resolve in the
// test checker — the rule reads the AST, not resolved symbols.
func TestUsedImportExprNotFlagged() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nimport \"pkg/foo\"\nfunc main() { foo.Bar() }\n"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "unused-import")
}

// An import referenced only in a type position (`foo.T`) is not
// flagged.
func TestUsedImportTypeNotFlagged() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nimport \"pkg/foo\"\nfunc main() { var x foo.T; _ = x }\n"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "unused-import")
}

// A reference in a function signature (parameter type) counts as a
// use.
func TestUsedImportParamTypeNotFlagged() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nimport \"pkg/foo\"\nfunc f(x foo.T) { _ = x }\n"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "unused-import")
}

// Blank imports are intentional side-effect imports; never flagged.
func TestBlankImportNotFlagged() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nimport _ \"pkg/foo\"\nfunc main() {}\n"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "unused-import")
}

// An aliased import is matched by its alias, not its path's last
// segment: `import alt "pkg/foo"` used as `alt.Bar()` is fine.
func TestAliasImportUsedNotFlagged() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nimport alt \"pkg/foo\"\nfunc main() { alt.Bar() }\n"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "unused-import")
}

// An aliased import is flagged when the alias is unused, even if a
// bare reference to the path's last segment exists elsewhere.
func TestAliasImportUnusedFlagged() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nimport alt \"pkg/foo\"\nfunc main() {}\n"
	var r @Result = lintSrc(src)
	return expectDiag(r, "unused-import")
}

// Multiple imports: only the unused one is flagged, and the used
// one is not.
func TestMixedImportsOnlyUnusedFlagged() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nimport \"pkg/foo\"\nimport \"pkg/bar\"\n"
		"func main() { foo.Do() }\n"
	var r @Result = lintSrc(src)
	// foo is used → no false positive; bar is unused → flagged.
	var t1 testing.TestResult = expectDiag(r, "unused-import")
	if len(t1) != 0 { return t1 }
	// Exactly one unused-import diagnostic expected.
	var count int = 0
	for i := 0; i < r.NumDiags; i++ {
		if charEq(r.Diags[i].Rule, "unused-import") { count = count + 1 }
	}
	if count != 1 {
		return "expected exactly one unused-import diagnostic"
	}
	return ""
}

// ============================================================
// (a) cross-file attribution — check each file's own imports, not
// the deduped merged import list.  MergeFiles keeps one spec per
// (alias, path) from the alphabetically-first file, so a
// genuinely-unused import in a NON-surviving sibling must still be
// flagged, and the result must be file-order independent.
// ============================================================

// countUnused counts unused-import diagnostics in a result.
func countUnused(r @Result) int {
	var n int = 0
	for i := 0; i < r.NumDiags; i++ {
		if charEq(r.Diags[i].Rule, "unused-import") { n = n + 1 }
	}
	return n
}

// unusedInFile reports whether an unused-import diag is attributed to
// source file `f`.
func unusedInFile(r @Result, f *[]readonly char) bool {
	for i := 0; i < r.NumDiags; i++ {
		if charEq(r.Diags[i].Rule, "unused-import") &&
				charEq(r.Diags[i].Pos.File, f) {
			return true
		}
	}
	return false
}

// The non-surviving sibling's unused import is flagged.  "a.bn" sorts
// first so its spec survives dedup, and it USES foo; "b.bn" imports
// foo and does not.  The old merged-only check missed b's import
// entirely (false negative); the per-file check flags it on b.bn.
func TestUnusedImportCrossFileNonSurvivorFlagged() testing.TestResult {
	var srcs @[]@[]char = @[]@[]char{
		"package \"test\"\nimport \"pkg/foo\"\nfunc a() { foo.Do() }\n",
		"package \"test\"\nimport \"pkg/foo\"\nfunc b() {}\n",
	}
	var names @[]@[]char = @[]@[]char{ "a.bn", "b.bn" }
	var r @Result = lintMultiSrc(srcs, names)
	if countUnused(r) != 1 {
		return "expected exactly one unused-import (b.bn's)"
	}
	if !unusedInFile(r, "b.bn") {
		return "expected the unused-import attributed to b.bn"
	}
	return ""
}

// Order independence: swap the roles — "a.bn" imports foo unused,
// "b.bn" uses it.  a.bn's spec is the survivor, and it is correctly
// flagged; still exactly one diagnostic.
func TestUnusedImportCrossFileOrderIndependent() testing.TestResult {
	var srcs @[]@[]char = @[]@[]char{
		"package \"test\"\nimport \"pkg/foo\"\nfunc a() {}\n",
		"package \"test\"\nimport \"pkg/foo\"\nfunc b() { foo.Do() }\n",
	}
	var names @[]@[]char = @[]@[]char{ "a.bn", "b.bn" }
	var r @Result = lintMultiSrc(srcs, names)
	if countUnused(r) != 1 {
		return "expected exactly one unused-import (a.bn's)"
	}
	if !unusedInFile(r, "a.bn") {
		return "expected the unused-import attributed to a.bn"
	}
	return ""
}

// Used in every file → no diagnostic.
func TestUnusedImportCrossFileUsedEverywhere() testing.TestResult {
	var srcs @[]@[]char = @[]@[]char{
		"package \"test\"\nimport \"pkg/foo\"\nfunc a() { foo.Do() }\n",
		"package \"test\"\nimport \"pkg/foo\"\nfunc b() { foo.Do() }\n",
	}
	var names @[]@[]char = @[]@[]char{ "a.bn", "b.bn" }
	var r @Result = lintMultiSrc(srcs, names)
	return expectNoDiag(r, "unused-import")
}

// Three files import foo, only one uses it → the two unused files are
// both flagged (a single deduped spec could never express this).
func TestUnusedImportCrossFileThreeFilesOneUse() testing.TestResult {
	var srcs @[]@[]char = @[]@[]char{
		"package \"test\"\nimport \"pkg/foo\"\nfunc a() { foo.Do() }\n",
		"package \"test\"\nimport \"pkg/foo\"\nfunc b() {}\n",
		"package \"test\"\nimport \"pkg/foo\"\nfunc c() {}\n",
	}
	var names @[]@[]char = @[]@[]char{ "a.bn", "b.bn", "c.bn" }
	var r @Result = lintMultiSrc(srcs, names)
	if countUnused(r) != 2 {
		return "expected exactly two unused-import diags (b.bn, c.bn)"
	}
	if !unusedInFile(r, "b.bn") { return "expected b.bn flagged" }
	if !unusedInFile(r, "c.bn") { return "expected c.bn flagged" }
	return ""
}
