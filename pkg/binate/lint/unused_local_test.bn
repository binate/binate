package "pkg/binate/lint"

import "pkg/builtins/testing"

// ============================================================
// unused-local
// ============================================================

// A never-referenced local variable is flagged.
func TestUnusedLocalFlagged() testing.TestResult {
	var r @Result = lintSrc("package \"test\"\nfunc f() { var x int = 0 }\n")
	return expectDiag(r, "unused-local")
}

// A local that is read is not flagged.
func TestUsedLocalNotFlagged() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\nfunc f() int { var x int = 0\n return x }\n")
	return expectNoDiag(r, "unused-local")
}

// A parameter is never flagged (params are contract-bound).
func TestUnusedParamNotFlagged() testing.TestResult {
	var r @Result = lintSrc("package \"test\"\nfunc f(x int) {}\n")
	return expectNoDiag(r, "unused-local")
}

// The blank identifier is never flagged.
func TestBlankLocalNotFlagged() testing.TestResult {
	var r @Result = lintSrc("package \"test\"\nfunc f() { var _ int = 0 }\n")
	return expectNoDiag(r, "unused-local")
}

// Conservative: a write (`x = 5`) counts as a use, so a write-only local
// is NOT flagged by this rule.
func TestWriteMarksUsed() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\nfunc f() { var x int = 0\n x = 5 }\n")
	return expectNoDiag(r, "unused-local")
}

// A short-var declaration is covered.
func TestUnusedShortVarFlagged() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\nfunc g() int { return 0 }\n"
		"func f() { y := g() }\n")
	return expectDiag(r, "unused-local")
}

// A local captured (read) by a closure is not flagged.
func TestCapturedLocalNotFlagged() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"func f() int {\n"
		"\tvar x int = 5\n"
		"\tvar g @func() int = func() int { return x }\n"
		"\treturn g()\n"
		"}\n")
	return expectNoDiag(r, "unused-local")
}

// A closure's OWN unused local is flagged (its body is walked as part of
// the enclosing function).
func TestClosureOwnUnusedLocalFlagged() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"func f() {\n"
		"\tvar g @func() = func() { var y int = 0 }\n"
		"\tg()\n"
		"}\n")
	return expectDiag(r, "unused-local")
}

// A never-referenced local inside a nested block is flagged.
func TestNestedBlockLocalFlagged() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\nfunc f() { if true { var y int = 0 } }\n")
	return expectDiag(r, "unused-local")
}

// A local var inside a METHOD body is covered.
func TestMethodLocalFlagged() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\ntype T int\nfunc (t T) m() { var z int = 0 }\n")
	return expectDiag(r, "unused-local")
}

// A for-in loop VALUE binding that is never used is flagged (real `in`
// syntax — `range` is not a keyword in Binate).
func TestUnusedForInValFlagged() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\nfunc f(xs @[]int) { for v in xs {} }\n")
	return expectDiag(r, "unused-local")
}

// A for-in value binding that IS used is not flagged.
func TestUsedForInValNotFlagged() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"func f(xs @[]int) int { var s int = 0\n"
		"\tfor v in xs { s = s + v }\n return s }\n")
	return expectNoDiag(r, "unused-local")
}

// A for-in KEY binding that is never used is flagged (the value is used).
func TestUnusedForInKeyFlagged() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"func f(xs @[]int) int { var s int = 0\n"
		"\tfor k, v in xs { s = s + v }\n return s }\n")
	if countRule(r, "unused-local") != 1 {
		return "expected exactly the unused key k flagged"
	}
	return ""
}

// An index-target base is read to compute the store location, so `a` in
// `a[0] = 5` counts as used.
func TestIndexTargetMarksBaseUsed() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\nfunc f() { var a [3]int\n a[0] = 5 }\n")
	return expectNoDiag(r, "unused-local")
}

// A C-style for-loop init variable never referenced in cond/post/body is
// flagged (the init is a short-var decl inside the for-scope).
func TestUnusedForInitVarFlagged() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\nfunc f() { for i := 0; true; {} }\n")
	return expectDiag(r, "unused-local")
}

// A C-style for-loop init variable that IS used is not flagged.
func TestUsedForInitVarNotFlagged() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"func f(n int) int { var s int = 0\n"
		"\tfor i := 0; i < n; i = i + 1 { s = s + i }\n return s }\n")
	return expectNoDiag(r, "unused-local")
}

// A grouped local `var ( ... )` is covered: the unused member is flagged,
// the used one is not.
func TestUnusedGroupedVarFlagged() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"func f() int { var (\n\ta int = 1\n\tb int = 2\n)\n return a }\n")
	if countRule(r, "unused-local") != 1 {
		return "expected exactly the unused grouped member b flagged"
	}
	return ""
}

// A multi-name short-var (`a, b := g()`) flags only the unused binding.
func TestUnusedMultiShortVarFlagged() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\nfunc g() (int, int) { return 0, 0 }\n"
		"func f() int { a, b := g()\n return a }\n")
	if countRule(r, "unused-local") != 1 {
		return "expected exactly the unused binding b flagged"
	}
	return ""
}

// A closure nested inside another closure is walked recursively — the
// innermost closure's own unused local is flagged.
func TestNestedClosureUnusedLocalFlagged() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"func f() {\n"
		"\tvar g @func() = func() {\n"
		"\t\tvar h @func() = func() { var y int = 0 }\n"
		"\t\th()\n"
		"\t}\n"
		"\tg()\n"
		"}\n")
	return expectDiag(r, "unused-local")
}

// `x++` reads x, so a local used only via inc/dec is not flagged
// (conservative).
func TestIncDecMarksUsed() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\nfunc f() { var x int = 0\n x++ }\n")
	return expectNoDiag(r, "unused-local")
}

// Flat (per-function) scoping deliberately UNDER-warns on shadowing: an
// unused OUTER local whose name is referenced by a shadowing inner local is
// not flagged — a safe non-false-positive.  Documents the intentional
// limitation (a block-scope-aware rule would flag the outer `x`).
func TestShadowedUnusedLocalUnderWarn() testing.TestResult {
	var r @Result = lintSrc(
		"package \"test\"\n"
		"func f() int {\n"
		"\tvar x int = 0\n"
		"\tif true { var x int = 5\n return x }\n"
		"\treturn 0\n"
		"}\n")
	return expectNoDiag(r, "unused-local")
}
