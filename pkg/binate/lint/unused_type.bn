package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/strings"

// ============================================================
// Rule: unused-type
// ============================================================
//
// Flags an unexported package-level type whose name is referenced
// nowhere in the package outside its own definition.
//
// Exportedness: `DECL_TYPE` carries no `Exported` flag, so a type is
// treated as exported iff a same-name type is declared in the package's
// `.bni` (a `.bni`-sourced `DECL_TYPE`).  Exported types are part of the
// contract and never flagged.
//
// Used iff the type name appears as a type reference (unqualified
// `TEXPR_NAMED`, or a generic instantiation head) anywhere OUTSIDE its
// own definition.  Self-references within the definition (`type node
// struct { next @node }`) do not count: they are subtracted by
// re-walking the candidate's own decl into a fresh index, which mirrors
// the shared index's traversal exactly (so the subtraction can only
// remove genuine self-references — never a false positive).
//
// A method receiver does NOT count as a use of its type: a private type
// mentioned only as its own methods' receiver is dead (nothing can
// construct it, so the methods are unreachable too).  Receiver-position
// references are subtracted alongside self-references.  A shadowing
// local of the same name still over-counts, so this rule only ever
// UNDER-warns, never false-positives.
//
// Known under-report: a type referenced only by other dead code is not
// flagged (the reference still appears); the reachability variant would
// catch it — deferred.

// lintUnusedTypes flags unexported, externally-unreferenced package types.
func lintUnusedTypes(ctx @lintCtx, merged @ast.File, idx @refIndex) {
	if merged == nil { return }
	for i := 0; i < len(merged.Decls); i++ {
		lintUnusedTypeDecl(ctx, merged.Decls[i], merged, idx)
	}
}

// lintUnusedTypeDecl checks one decl, recursing `type ( ... )` groups.
func lintUnusedTypeDecl(ctx @lintCtx, d @ast.Decl, merged @ast.File,
		idx @refIndex) {
	if d == nil { return }
	if d.Kind == ast.DECL_GROUP {
		for i := 0; i < len(d.Decls); i++ {
			lintUnusedTypeDecl(ctx, d.Decls[i], merged, idx)
		}
		return
	}
	if d.Kind != ast.DECL_TYPE { return }
	// A `.bni`-sourced decl is the interface declaration, not the
	// package's definition.
	if d.FromBNI { return }
	// Exported types (declared in the `.bni`) are part of the contract.
	if isExportedType(merged, d.Name) { return }
	// Used iff referenced outside its own definition AND outside its
	// own methods' receiver positions: total refs minus self-references
	// minus receiver references.
	if idx.typeRefCount(d.Name) >
			selfTypeRefs(d) + receiverTypeRefs(merged, d.Name) {
		return
	}
	addDiag(ctx, d.Pos, "unused-type", unusedTypeMsg(d.Name))
}

// isExportedType reports whether type `name` is declared in the
// package's `.bni` (a `.bni`-sourced `DECL_TYPE`), recursing groups.
func isExportedType(merged @ast.File, name @[]char) bool {
	for i := 0; i < len(merged.Decls); i++ {
		if bniTypeMatches(merged.Decls[i], name) { return true }
	}
	return false
}

// bniTypeMatches reports whether decl `d` (or a group member) is a
// `.bni`-sourced `DECL_TYPE` named `name`.
func bniTypeMatches(d @ast.Decl, name @[]char) bool {
	if d == nil { return false }
	if d.Kind == ast.DECL_GROUP {
		for i := 0; i < len(d.Decls); i++ {
			if bniTypeMatches(d.Decls[i], name) { return true }
		}
		return false
	}
	return d.FromBNI && d.Kind == ast.DECL_TYPE && streq(d.Name, name)
}

// selfTypeRefs counts references to a type's own name within its own
// declaration subtree.  It re-walks the decl into a fresh index using
// the SAME traversal collectRefs uses, so the count exactly matches the
// self-references folded into the shared index's total.
func selfTypeRefs(d @ast.Decl) int {
	var fresh @refIndex = newRefIndex()
	walkDeclRefs(fresh, d)
	return fresh.typeRefCount(d.Name)
}

// receiverTypeRefs counts references to type `name` in method-receiver
// positions across the package.  A type mentioned only as its own
// methods' receiver is dead, so these are subtracted from the used
// count.  Uses the same walkTypeRefs traversal as the shared index, so
// the count exactly matches the receiver contribution to the total.
func receiverTypeRefs(merged @ast.File, name @[]char) int {
	var n int = 0
	for i := 0; i < len(merged.Decls); i++ {
		n = n + receiverTypeRefsDecl(merged.Decls[i], name)
	}
	return n
}

// receiverTypeRefsDecl counts receiver-position refs to `name` in one
// decl, recursing groups.
func receiverTypeRefsDecl(d @ast.Decl, name @[]char) int {
	if d == nil { return 0 }
	if d.Kind == ast.DECL_GROUP {
		var n int = 0
		for i := 0; i < len(d.Decls); i++ {
			n = n + receiverTypeRefsDecl(d.Decls[i], name)
		}
		return n
	}
	if d.Recv == nil { return 0 }
	var fresh @refIndex = newRefIndex()
	walkTypeRefs(fresh, d.Recv.Type)
	return fresh.typeRefCount(name)
}

// unusedTypeMsg builds the diagnostic message for an unused type.
func unusedTypeMsg(name @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("unused type: ")
	cb.Write(name)
	return buf.CopyStr(cb.String())
}
