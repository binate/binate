package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/strings"

// ============================================================
// Rule: unused-type
// ============================================================
//
// Flags an unexported package-level type unreachable from any root (the shared
// reachability in reach.bn).  REACHABILITY, not mere reference-presence: a type
// referenced ONLY by dead code (an unreachable private func, or another dead
// type's field) is flagged.  A method RECEIVER does not count as a use of its
// type — reach.bn's seeder excludes a method's own receiver — so a private type
// mentioned only as its own methods' receiver is dead (nothing can construct it,
// so the methods are unreachable too).  A type declared in the package's `.bni`
// is the exported contract — a root, never flagged.  A local shadowing the type
// name over-counts, so the rule only ever UNDER-warns, never false-positives.

// lintUnusedTypes flags unexported package types unreachable from a root.
func lintUnusedTypes(ctx @lintCtx, s @reachState) {
	for i := 0; i < s.typeCands.Len(); i++ {
		var d @ast.Decl = s.typeCands.Get(i)
		if !s.isReach(d.Name) {
			addDiag(ctx, d.Pos, "unused-type", unusedTypeMsg(d.Name))
		}
	}
}

// unusedTypeMsg builds the diagnostic message for an unused type.
func unusedTypeMsg(name @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("unused type: ")
	cb.Write(name)
	return buf.CopyStr(cb.String())
}
