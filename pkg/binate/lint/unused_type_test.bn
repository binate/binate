package "pkg/binate/lint"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// lintSrcWithBniType parses+checks a `.bn` source, then appends a
// synthetic `.bni`-sourced `DECL_TYPE` named `name` — as the loader
// would prepend from the package's `.bni` — and lints.  Exercises the
// unused-type exported-skip path (the unit harness doesn't run the
// loader, so `.bni` provenance must be synthesized).  Appended after
// the check because unused-type is purely syntactic.
func lintSrcWithBniType(src *[]readonly char, name @[]char) @Result {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	var bniDecl @ast.Decl = make(ast.Decl)
	bniDecl.Kind = ast.DECL_TYPE
	bniDecl.Name = name
	bniDecl.FromBNI = true
	var nd @[]@ast.Decl = make_slice(@ast.Decl, len(file.Decls) + 1)
	for i := 0; i < len(file.Decls); i++ { nd[i] = file.Decls[i] }
	nd[len(file.Decls)] = bniDecl
	file.Decls = nd
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = file
	return LintFile(c, file, files)
}

// An unexported type referenced nowhere is flagged.
func TestUnusedTypeFlagged() testing.TestResult {
	var r @Result = lintSrc("package \"test\"\ntype secret int\n")
	return expectDiag(r, "unused-type")
}

// A type used in a (rooted) var declaration is not flagged.
func TestTypeUsedByVarNotFlagged() testing.TestResult {
	var r @Result = lintSrcRooted(
			"package \"test\"\ntype T int\nvar x T = 0\n", "x")
	return expectNoDiag(r, "unused-type")
}

// A type used only as a struct field (reached transitively via a rooted var of
// the outer type) is not flagged.
func TestTypeUsedByFieldNotFlagged() testing.TestResult {
	var r @Result = lintSrcRooted(
			"package \"test\"\ntype Inner int\n"
					"type Outer struct { i Inner }\nvar o Outer\n",
			"o")
	return expectNoDiag(r, "unused-type")
}

// A type used only in a cast / result position of a reachable func is not flagged.
func TestTypeUsedByCastNotFlagged() testing.TestResult {
	var r @Result = lintSrcRooted(
			"package \"test\"\ntype T int\n"
					"func f(x int) T { return cast(T, x) }\n",
			"f")
	return expectNoDiag(r, "unused-type")
}

// A self-referential type used nowhere else is flagged — the
// self-reference in its own definition does not count.
func TestSelfRefTypeUnusedFlagged() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\ntype node struct { next @node }\n")
	return expectDiag(r, "unused-type")
}

// A self-referential type used elsewhere (a reachable func's param) is not
// flagged.
func TestSelfRefTypeUsedNotFlagged() testing.TestResult {
	var r @Result = lintSrcRooted(
			"package \"test\"\ntype node struct { next @node }\n"
					"func f(n @node) {}\n",
			"f")
	return expectNoDiag(r, "unused-type")
}

// An unused type alias is a candidate (dead code) and is flagged.
func TestUnusedTypeAliasFlagged() testing.TestResult {
	var r @Result = lintSrc("package \"test\"\ntype Alias = int\n")
	return expectDiag(r, "unused-type")
}

// A type declared in the .bni (exported) is part of the contract and
// not flagged even if unused within the package.
func TestExportedTypeNotFlagged() testing.TestResult {
	var r @Result = lintSrcWithBniType(
			"package \"test\"\ntype secret int\n", "secret")
	return expectNoDiag(r, "unused-type")
}

// Use via a pointer base (`*T`) in a reachable func counts.
func TestTypeUsedByPointerNotFlagged() testing.TestResult {
	var r @Result = lintSrcRooted(
			"package \"test\"\ntype T int\nfunc f(p *T) {}\n", "f")
	return expectNoDiag(r, "unused-type")
}

// Use via a managed-slice base (`@[]T`) in a reachable func counts.
func TestTypeUsedBySliceNotFlagged() testing.TestResult {
	var r @Result = lintSrcRooted(
			"package \"test\"\ntype T int\nfunc f(s @[]T) {}\n", "f")
	return expectNoDiag(r, "unused-type")
}

// Use via the `sizeof` builtin's type argument in a reachable func counts.
func TestTypeUsedBySizeofNotFlagged() testing.TestResult {
	var r @Result = lintSrcRooted(
			"package \"test\"\ntype T int\nfunc f() int { return sizeof(T) }\n", "f")
	return expectNoDiag(r, "unused-type")
}

// Use via a composite literal head (`T{...}`) in a reachable func counts.
func TestTypeUsedByCompositeNotFlagged() testing.TestResult {
	var r @Result = lintSrcRooted(
			"package \"test\"\ntype T struct { x int }\n"
					"func f() T { return T{x: 1} }\n",
			"f")
	return expectNoDiag(r, "unused-type")
}

// Use via a (reachable) global's function-value param/result type counts.
func TestTypeUsedByFuncValueNotFlagged() testing.TestResult {
	var r @Result = lintSrcRooted(
			"package \"test\"\ntype T int\nvar fn *func(T) T = nil\n", "fn")
	return expectNoDiag(r, "unused-type")
}

// A private type used ONLY as a generic-call type argument
// (`id[secret](0)` — parsed as a bare-ident bracket arg) in a reachable func
// counts.  This is the case the refs.bn generic-arg fix guards against.
func TestTypeUsedByGenericCallArgNotFlagged() testing.TestResult {
	var r @Result = lintSrcRooted(
			"package \"test\"\ntype secret int\n"
					"func use() { f[secret](0) }\n",
			"use")
	return expectNoDiag(r, "unused-type")
}

// A private type whose ONLY mention is its own method receiver is dead
// (nothing can construct it, so the methods are unreachable) — flagged.
func TestTypeReceiverOnlyFlagged() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\ntype secret int\nfunc (r @secret) m() {}\n")
	return expectDiag(r, "unused-type")
}

// A type used as a receiver AND in a reachable use (a rooted var) is not flagged
// — the receiver exclusion drops only the receiver contribution, not the real use.
func TestTypeReceiverPlusUseNotFlagged() testing.TestResult {
	var r @Result = lintSrcRooted(
			"package \"test\"\ntype T int\nfunc (t @T) m() {}\nvar x T = 0\n", "x")
	return expectNoDiag(r, "unused-type")
}

// Cascade under reachability: `A` (dead — no root reaches it) references `B`, so
// B is reachable only from dead code and is ALSO flagged — two diagnostics, not
// one.  This is the reference-presence under-report the reachability upgrade
// fixes.
func TestTypeCascadeBothDeadFlagged() testing.TestResult {
	var r @Result = lintSrc(
			"package \"test\"\ntype A struct { b B }\ntype B int\n")
	if countRule(r, "unused-type") != 2 {
		return "expected two unused-type (both A and B — B reached only via dead A)"
	}
	return ""
}

// Positive cascade (isolates the mechanism against TestTypeCascadeBothDeadFlagged):
// when `A` IS reachable — a rooted var constructs it — its field type `B`, whose
// ONLY reference is that field, is reached THROUGH A, so neither is flagged.
func TestTypeCascadeReachableViaField() testing.TestResult {
	var r @Result = lintSrcRooted(
			"package \"test\"\ntype A struct { b B }\ntype B int\nvar a A\n", "a")
	return expectNoDiag(r, "unused-type")
}

// A realistic package whose private type and global are reached from a rooted
// entry function produces NO unused-* diagnostics (a combined false-positive
// guard at the LintFile level).
func TestCleanPackageNoUnusedDiags() testing.TestResult {
	var r @Result = lintSrcRooted(
			"package \"test\"\n"
					"type pair struct { a int\n b int }\n"
					"var origin pair = pair{a: 0, b: 0}\n"
					"func sum() int { return origin.a + origin.b }\n",
			"sum")
	var t1 testing.TestResult = expectNoDiag(r, "unused-type")
	if len(t1) != 0 { return t1 }
	var t2 testing.TestResult = expectNoDiag(r, "unused-global")
	if len(t2) != 0 { return t2 }
	return expectNoDiag(r, "unused-import")
}

// A type referenced ONLY in a type-switch case label (`case *T:`) of a reachable
// func is used, not flagged — walkStmtRefs must record the case's
// AssertTargetList (refs.bn), the analog of how a single assertion's e.TypeRef is
// recorded.
func TestTypeUsedOnlyInTypeSwitchCaseNotFlagged() testing.TestResult {
	var r @Result = lintSrcRooted(
			"package \"test\"\n"
					"interface I { foo() }\n"
					"type Recovered struct { x int }\n"
					"func classify(v *I) int {\n"
					"\tswitch v.(type) {\n"
					"\tcase *Recovered:\n"
					"\t\treturn 1\n"
					"\tdefault:\n"
					"\t\treturn 0\n"
					"\t}\n"
					"}\n",
			"classify")
	return expectNoDiag(r, "unused-type")
}
