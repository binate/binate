// Package loader discovers, reads, and parses Binate packages from project
// roots. It resolves import dependencies and provides a topological build order.
package "pkg/binate/loader"

import "pkg/binate/ast"
import "pkg/binate/buildcfg"

// Package represents a parsed Binate package.
//
// `Merged` concatenates every impl file's decls (and prepends the `.bni`
// surface) into one AST and DEDUPLICATES imports — so it loses per-file import
// provenance.  `Files` retains the individual impl-file ASTs (each with its own
// undeduped `Imports` and `Pos.File`), which is what file-scoped import
// resolution needs: a qualifier in file F must resolve against only F's
// imports, not the package-wide merged set.  `BNI` carries the interface file's
// own imports for the same reason (its prepended decls resolve against it).
//
// `Exposes` holds the resolved (unquoted) target paths of every `expose "P"`
// re-export declaration in the `.bni`.  Each is ALSO appended to `Imports` (so
// P is loaded, cycle-checked, and topo-ordered before this package), but is
// tracked separately here because the checker re-exports P's whole exported
// surface into this package's surface — a strictly larger relationship than a
// plain import.
type Package struct {
	Path    @[]char
	BNI     @ast.File
	Merged  @ast.File
	Files   @[]@ast.File
	Imports @[]@[]char
	Exposes @[]@[]char
}

// Loader discovers and parses packages.
//
// Resolution uses two independent, ordered search paths:
//   - BniPath: directories searched for `<dir>/<path>.bni` interface files.
//   - ImplPath: directories searched for `<dir>/<path>/` impl directories
//     (a directory is considered an impl iff it contains at least one
//     `.bn` file). Future: also `.o`/`.a`/`.so` artifacts.
//
// First hit wins on each path; the two are searched independently, so
// interface and impl can come from different trees.
type Loader struct {
	BniPath      @[]@[]char
	ImplPath     @[]@[]char
	Packages     @[]@Package
	Order        @[]@[]char
	Errors       @[]@[]char
	TestPackages @[]@[]char
	// InterfaceOnly lists package paths to load as INTERFACE-ONLY: the `.bni`
	// is read, but the `.bn` impl is NOT searched, parsed, or merged (Merged
	// falls back to the .bni, Files stays empty).  Set by an interpreter host
	// for its injected / compiled-instance packages (pkg/std/*,
	// pkg/builtins/rt): those run as their native compiled instance, so the VM
	// neither needs nor should require their `.bn` at runtime — and not loading
	// it keeps their native-only `__c_call` funcs out of the interpreted-mode
	// type check.  Empty (the default) means every package loads its impl, so
	// bnc (which compiles every impl) is unaffected.
	InterfaceOnly @[]@[]char
	// BuildConfig drives `#[build(...)]` gating during package loading: a
	// dependency file whose package-clause build constraint excludes the
	// active target is dropped.  nil (the default) means gating is
	// inactive — every file is kept — so callers that don't set it (the
	// REPL, the bni tool, unit tests) are unaffected.
	BuildConfig @buildcfg.BuildConfig
	// Provider abstracts the loader's filesystem access (Stat / List / Read).
	// NewLoader installs an os-backed OsSourceProvider, so every existing caller is
	// unaffected; a host replaces it before loading to serve source from elsewhere
	// (e.g. an in-memory overlay) without touching the search logic.
	Provider @SourceProvider
	// loadingStack holds the packages currently being loaded, for import-cycle
	// detection (a simple stack since there are no maps).  Per-instance so two
	// Loaders in one process never see each other's in-flight loads.
	loadingStack @[]@[]char
}

// SourceProvider abstracts the loader's filesystem access so a host can serve
// package source from somewhere other than the real filesystem (e.g. an in-memory
// overlay for a browser/wasm embedding).  NewLoader installs the os-backed default
// (OsSourceProvider); assign Loader.Provider before loading to override.
interface SourceProvider {
	Stat(path *[]readonly char) (bool, bool)
	List(dir *[]readonly char) @[]@[]char
	Read(path *[]readonly char) @[]uint8
}

// Stat reports whether path exists and whether it is a directory.

// List returns the entry names in a directory ("." / ".." already dropped), or
// an empty slice if it is not a readable directory.

// Read returns a file's bytes, or an empty slice on any error.

// NewLoader creates an empty Loader.  Configure its search paths with
// AddBniPath / AddImplPath before loading; a directory holding both `.bni`
// and `.bn` is simply added to both paths.
func NewLoader() @Loader

// AddBniPath appends a directory to the interface search path
// (where `.bni` files are looked up).
func (l @Loader) AddBniPath(dir @[]char)

// AddImplPath appends a directory to the impl search path
// (where impl directories containing `.bn` files are looked up).
func (l @Loader) AddImplPath(dir @[]char)

// LoadImports recursively discovers and parses all packages reachable from
// the given import specs.
func (l @Loader) LoadImports(imports *[]@ast.ImportSpec)

// MergeFiles combines multiple parsed files from the same package into one.
func MergeFiles(files *[]@ast.File) @ast.File

// GetPackage returns the loaded package for the given path, or nil.
func (l @Loader) GetPackage(path *[]readonly char) @Package

// ExposeClosure returns the transitive `expose` closure of `roots` (packages
// reachable by following expose edges from a forwarder among the roots),
// excluding any path already in `exclude`, deduped.  Import-registration passes
// use it so a module importing a forwarder A (which exposes P) also declares P's
// funcs/consts/vars under P's home path.
func (l @Loader) ExposeClosure(roots @[]@[]char, exclude @[]@[]char) @[]@[]char
