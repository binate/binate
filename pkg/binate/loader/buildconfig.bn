package "pkg/binate/loader"

import "pkg/binate/ast"
import "pkg/binate/buildcfg"
import "pkg/stdx/slices"

// ResolveBuildConfig loads pkg/builtins/build through a sub-loader that
// shares this loader's search paths and, on success, sets l.BuildConfig from
// its Arch/OS constants — activating `#[build(...)]` gating for subsequent
// loads.  The build package's per-target copy is the one binate-paths
// resolves into the search path for the host or --target, so the values match
// `import "pkg/builtins/build"` and are correct on every host.  A missing or
// unresolvable build package leaves BuildConfig nil (gating inactive); the
// sub-loader keeps any load error out of l.Errors.  Call it after the search
// paths are configured and before loading the program's dependencies.
func (l @Loader) ResolveBuildConfig() {
	var sub @Loader = NewLoader(l.Root)
	sub.BniPath = l.BniPath
	sub.ImplPath = l.ImplPath
	var imps @[]@ast.ImportSpec
	var imp @ast.ImportSpec = make(ast.ImportSpec)
	imp.Path = "\"pkg/builtins/build\""
	imps = slices.Append[@ast.ImportSpec](imps, imp)
	sub.LoadImports(imps)
	if len(sub.Errors) > 0 {
		return
	}
	var pkg @Package = sub.GetPackage("pkg/builtins/build")
	if pkg == nil {
		return
	}
	l.BuildConfig = buildcfg.ConfigFromBuild(pkg.BNI)
}

// gateMerged drops the declarations and imports of merged whose own
// `#[build(...)]` constraint excludes the active target — the
// declaration-level gate (so a package can hold same-named per-target variant
// decls) and the per-import gate (so a dependency is followed only on the
// targets it applies to).  It is a no-op when gating is inactive (BuildConfig
// nil) or merged is nil.  Returns true on success; on a malformed/unknown
// constraint it appends the error to l.Errors and returns false so the caller
// aborts the load rather than silently dropping an element.
func (l @Loader) gateMerged(merged @ast.File) bool {
	if l.BuildConfig == nil || merged == nil {
		return true
	}
	var kept @[]@ast.Decl
	for j := 0; j < len(merged.Decls); j++ {
		var d @ast.Decl = merged.Decls[j]
		var keep bool
		var derr @[]char
		var dhas bool
		keep, derr, dhas = buildcfg.DeclIncluded(l.BuildConfig, d.Annotations)
		if dhas {
			l.Errors = slices.Append[@[]char](l.Errors, derr)
			return false
		}
		if keep {
			kept = slices.Append[@ast.Decl](kept, d)
		}
	}
	merged.Decls = kept
	var keptImports @[]@ast.ImportSpec
	for j := 0; j < len(merged.Imports); j++ {
		var imp @ast.ImportSpec = merged.Imports[j]
		var ikeep bool
		var ierr @[]char
		var ihas bool
		ikeep, ierr, ihas = buildcfg.DeclIncluded(l.BuildConfig, imp.Annotations)
		if ihas {
			l.Errors = slices.Append[@[]char](l.Errors, ierr)
			return false
		}
		if ikeep {
			keptImports = slices.Append[@ast.ImportSpec](keptImports, imp)
		}
	}
	merged.Imports = keptImports
	return true
}
