package "pkg/binate/loader"

import "pkg/binate/ast"
import "pkg/binate/buildcfg"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Keeps a parser's borrowed source buffer alive across a parse.
var bcTestSrc @[]uint8

// gateFile parses src, gates it under an aarch64/linux config, and returns the
// loader (so callers can inspect l.Errors) and gateMerged's success bool.
func gateFile(src *[]readonly char) (@Loader, bool) {
	bcTestSrc = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		bcTestSrc[i] = cast(uint8, src[i])
	}
	var f @ast.File = parser.New(bcTestSrc, "t.bn").ParseFile()
	var l @Loader = NewLoader()
	var cfg @buildcfg.BuildConfig = make(buildcfg.BuildConfig)
	cfg.Arch = "aarch64"
	cfg.OS = "linux"
	l.BuildConfig = cfg
	var ok bool = l.gateMerged(f)
	return l, ok
}

// #[c_export] on a function is accepted by the gate — a valid placement.
func TestGateMergedCExportOnFuncOk() testing.TestResult {
	var l @Loader
	var ok bool
	l, ok = gateFile("package \"t\"\n#[c_export(\"foo\")]\nfunc F() {}")
	if !ok {
		return "gateMerged rejected a valid #[c_export] on a function"
	}
	if len(l.Errors) != 0 {
		return "gateMerged recorded an error for a valid #[c_export]"
	}
	return ""
}

// #[c_export] on a non-function declaration (a type) is a hard error: there is
// no function symbol to alias.
func TestGateMergedCExportOnTypeRejected() testing.TestResult {
	var l @Loader
	var ok bool
	l, ok = gateFile("package \"t\"\n#[c_export(\"foo\")]\ntype Foo struct { x int }")
	if ok {
		return "gateMerged accepted #[c_export] on a type"
	}
	if len(l.Errors) == 0 {
		return "gateMerged should have recorded an error for #[c_export] on a type"
	}
	return ""
}

// #[c_export] on an import is likewise rejected.
func TestGateMergedCExportOnImportRejected() testing.TestResult {
	var l @Loader
	var ok bool
	l, ok = gateFile("package \"t\"\n#[c_export(\"foo\")]\nimport \"pkg/a\"\nfunc F() {}")
	if ok {
		return "gateMerged accepted #[c_export] on an import"
	}
	if len(l.Errors) == 0 {
		return "gateMerged should have recorded an error for #[c_export] on an import"
	}
	return ""
}

// #[c_export] on a METHOD (a DECL_FUNC with a receiver) is rejected: a method's
// mangled symbol carries a receiver, so it is not a clean C free function, and
// accepting it would silently produce no export.
func TestGateMergedCExportOnMethodRejected() testing.TestResult {
	var l @Loader
	var ok bool
	l, ok = gateFile("package \"t\"\ntype T struct { }\n#[c_export(\"m\")]\nfunc (r *T) M() {}")
	if ok {
		return "gateMerged accepted #[c_export] on a method"
	}
	if len(l.Errors) == 0 {
		return "gateMerged should have recorded an error for #[c_export] on a method"
	}
	return ""
}

// #[c_export] on a var is rejected (a var has no function symbol to alias).
func TestGateMergedCExportOnVarRejected() testing.TestResult {
	var l @Loader
	var ok bool
	l, ok = gateFile("package \"t\"\n#[c_export(\"v\")]\nvar x int = 0")
	if ok {
		return "gateMerged accepted #[c_export] on a var"
	}
	if len(l.Errors) == 0 {
		return "gateMerged should have recorded an error for #[c_export] on a var"
	}
	return ""
}

// gateMergedDecls keeps only the declaration whose per-decl #[build(...)]
// matches the active arch, dropping the same-named variants for other archs.
func TestGateMergedDeclsSelectsVariant() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n#[build(is(arch, \"aarch64\"))]\nfunc A() {}\n"
			"#[build(is(arch, \"x64\"))]\nfunc A() {}"
	bcTestSrc = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		bcTestSrc[i] = cast(uint8, src[i])
	}
	var f @ast.File = parser.New(bcTestSrc, "t.bn").ParseFile()
	var l @Loader = NewLoader()
	var cfg @buildcfg.BuildConfig = make(buildcfg.BuildConfig)
	cfg.Arch = "aarch64"
	cfg.OS = "linux"
	l.BuildConfig = cfg
	if !l.gateMerged(f) {
		return "gateMerged reported an unexpected error"
	}
	if len(f.Decls) != 1 {
		return "expected exactly one surviving decl"
	}
	return ""
}

// gateMerged also drops imports whose per-import #[build(...)] excludes the
// active arch, so the gated-out dependency is never followed.
func TestGateMergedDropsImport() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n#[build(is(arch, \"aarch64\"))]\nimport \"pkg/a\"\n"
			"#[build(is(arch, \"x64\"))]\nimport \"pkg/b\"\nfunc F() {}"
	bcTestSrc = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		bcTestSrc[i] = cast(uint8, src[i])
	}
	var f @ast.File = parser.New(bcTestSrc, "t.bn").ParseFile()
	var l @Loader = NewLoader()
	var cfg @buildcfg.BuildConfig = make(buildcfg.BuildConfig)
	cfg.Arch = "aarch64"
	cfg.OS = "linux"
	l.BuildConfig = cfg
	if !l.gateMerged(f) {
		return "gateMerged reported an unexpected error"
	}
	if len(f.Imports) != 1 {
		return "expected exactly one surviving import"
	}
	if !streq(f.Imports[0].Path, "\"pkg/a\"") {
		return "expected pkg/a to survive"
	}
	return ""
}
