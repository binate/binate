package "pkg/binate/loader"

import "pkg/binate/ast"
import "pkg/binate/buildcfg"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Keeps a parser's borrowed source buffer alive across a parse.
var bcTestSrc @[]uint8

// When pkg/builtins/build cannot be resolved (here, a loader rooted where no
// packages exist), ResolveBuildConfig leaves BuildConfig nil so build-
// constraint gating stays INACTIVE — the safe fallback that avoids mis-gating
// when the target's build metadata isn't on the search path.  The success
// path (build resolves, arch/os set) is covered end-to-end by
// conformance/731_build_arch_select across the compiled and VM modes.
func TestResolveBuildConfigUnresolvableIsInactive() testing.TestResult {
	var l @Loader = NewLoader("/nonexistent-binate-root-for-test")
	l.ResolveBuildConfig()
	if l.BuildConfig != nil {
		return "expected nil BuildConfig when build is unresolvable"
	}
	return ""
}

// gateMergedDecls keeps only the declaration whose per-decl #[build(...)]
// matches the active arch, dropping the same-named variants for other archs.
func TestGateMergedDeclsSelectsVariant() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n#[build(is(arch, \"aarch64\"))]\nfunc A() {}\n"
		"#[build(is(arch, \"x64\"))]\nfunc A() {}"
	bcTestSrc = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		bcTestSrc[i] = cast(uint8, src[i])
	}
	var f @ast.File = parser.New(bcTestSrc, "t.bn").ParseFile()
	var l @Loader = NewLoader("/x")
	var cfg @buildcfg.BuildConfig = make(buildcfg.BuildConfig)
	cfg.Arch = "aarch64"
	cfg.OS = "linux"
	l.BuildConfig = cfg
	if !l.gateMerged(f) {
		return "gateMerged reported an unexpected error"
	}
	if len(f.Decls) != 1 {
		return "expected exactly one surviving decl"
	}
	return ""
}

// gateMerged also drops imports whose per-import #[build(...)] excludes the
// active arch, so the gated-out dependency is never followed.
func TestGateMergedDropsImport() testing.TestResult {
	var src *[]readonly char =
		"package \"t\"\n#[build(is(arch, \"aarch64\"))]\nimport \"pkg/a\"\n"
		"#[build(is(arch, \"x64\"))]\nimport \"pkg/b\"\nfunc F() {}"
	bcTestSrc = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		bcTestSrc[i] = cast(uint8, src[i])
	}
	var f @ast.File = parser.New(bcTestSrc, "t.bn").ParseFile()
	var l @Loader = NewLoader("/x")
	var cfg @buildcfg.BuildConfig = make(buildcfg.BuildConfig)
	cfg.Arch = "aarch64"
	cfg.OS = "linux"
	l.BuildConfig = cfg
	if !l.gateMerged(f) {
		return "gateMerged reported an unexpected error"
	}
	if len(f.Imports) != 1 {
		return "expected exactly one surviving import"
	}
	if !streq(f.Imports[0].Path, "\"pkg/a\"") {
		return "expected pkg/a to survive"
	}
	return ""
}
