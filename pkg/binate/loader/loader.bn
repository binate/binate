package "pkg/binate/loader"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/stdx/slices"

// ============================================================
// Loader
// ============================================================

// NewLoader creates an empty Loader; configure its search paths with
// AddBniPath / AddImplPath before loading.
func NewLoader() @Loader {
	var l @Loader = make(Loader)
	// Explicitly initialize slices (workaround: bootstrap may zero them as NilVal)
	var emptyPkgs @[]@Package
	l.Packages = emptyPkgs
	var emptyOrder @[]@[]char
	l.Order = emptyOrder
	var emptyErrs @[]@[]char
	l.Errors = emptyErrs
	// Default to the os-backed provider; a host may replace it before loading.
	var prov @OsSourceProvider = make(OsSourceProvider)
	l.Provider = prov
	return l
}

// AddBniPath appends a directory to the interface search path,
// skipping duplicates.
func (l @Loader) AddBniPath(dir @[]char) {
	for i := 0; i < len(l.BniPath); i++ {
		if streq(l.BniPath[i], dir) { return }
	}
	l.BniPath = slices.Append[@[]char](l.BniPath, dir)
}

// AddBniPathFront prepends a directory to the interface search
// path, skipping duplicates.  Companion to AddImplPathFront — used
// for target-specific bni overrides where a bare-metal-only .bni
// (e.g. runtime/baremetal_arm32/pkg/semihost.bni) needs to be
// resolvable in addition to the default-root .bni surface.
func (l @Loader) AddBniPathFront(dir @[]char) {
	for i := 0; i < len(l.BniPath); i++ {
		if streq(l.BniPath[i], dir) { return }
	}
	var n int = len(l.BniPath)
	var next @[]@[]char = make_slice(@[]char, n + 1)
	next[0] = dir
	for i := 0; i < n; i++ {
		next[i + 1] = l.BniPath[i]
	}
	l.BniPath = next
}

// AddImplPath appends a directory to the impl search path,
// skipping duplicates.
func (l @Loader) AddImplPath(dir @[]char) {
	for i := 0; i < len(l.ImplPath); i++ {
		if streq(l.ImplPath[i], dir) { return }
	}
	l.ImplPath = slices.Append[@[]char](l.ImplPath, dir)
}

// AddImplPathFront prepends a directory to the impl search path,
// skipping duplicates.  Used for target-specific impl overrides
// (e.g. --target arm32-baremetal prepends runtime/baremetal_arm32 so
// pkg/semihost resolves ahead of the default libc-host impls), since
// the loader's impl-path search is first-match-wins.
func (l @Loader) AddImplPathFront(dir @[]char) {
	for i := 0; i < len(l.ImplPath); i++ {
		if streq(l.ImplPath[i], dir) { return }
	}
	var n int = len(l.ImplPath)
	var next @[]@[]char = make_slice(@[]char, n + 1)
	next[0] = dir
	for i := 0; i < n; i++ {
		next[i + 1] = l.ImplPath[i]
	}
	l.ImplPath = next
}

// GetPackage looks up a loaded package by its import path, returning nil if not found.
func (l @Loader) GetPackage(path *[]readonly char) @Package {
	if len(l.Packages) == 0 { return nil }
	for i := 0; i < len(l.Packages); i++ {
		if streq(l.Packages[i].Path, path) {
			return l.Packages[i]
		}
	}
	return nil
}

// ExposeClosure returns the transitive `expose` closure of `roots`: every
// package reachable by following expose edges from a package in `roots` (for a
// forwarder A among the roots, A's exposed packages and whatever those
// transitively expose), EXCLUDING any path already in `exclude`, deduped.
//
// The import-registration passes use this so a module that imports a forwarder A
// (which exposes P) also declares P's funcs/consts/vars under P's home path;
// without it a resolved-home reference `pkg/P.X` would resolve to no symbol in
// the consuming module.  `roots` are the module's direct imports and `exclude`
// is the set already being registered (direct imports + rt/lang), so a
// directly-imported package is not re-registered here — but its own exposes are
// still walked, because it is itself a root.
func (l @Loader) ExposeClosure(roots @[]@[]char, exclude @[]@[]char) @[]@[]char {
	var out @[]@[]char
	for i := 0; i < len(roots); i++ {
		var p @Package = l.GetPackage(roots[i])
		if p != nil {
			l.collectExposeClosure(p, exclude, &out)
		}
	}
	return out
}

// collectExposeClosure appends p's not-yet-seen, not-excluded expose targets to
// out and recurses into each.  Terminates: out grows monotonically and the
// out-membership guard prevents revisiting (expose cycles are already rejected
// at load time, so the graph is acyclic regardless).
func (l @Loader) collectExposeClosure(p @Package, exclude @[]@[]char, out *@[]@[]char) {
	for i := 0; i < len(p.Exposes); i++ {
		var ep @[]char = p.Exposes[i]
		if containsStr(exclude, ep) { continue }
		if containsStr(*out, ep) { continue }
		*out = slices.Append[@[]char](*out, ep)
		var epkg @Package = l.GetPackage(ep)
		if epkg != nil {
			l.collectExposeClosure(epkg, exclude, out)
		}
	}
}

// LoadImports loads all packages referenced by the given import specs, then computes load order.
func (l @Loader) LoadImports(imports *[]@ast.ImportSpec) {
	if len(imports) == 0 { return }
	for i := 0; i < len(imports); i++ {
		var path @[]char = buf.CopyStr(unquote(imports[i].Path))
		if l.GetPackage(path) != nil { continue }
		l.loadPackage(path)
	}
	if len(l.Errors) == 0 {
		l.computeOrder()
	}
}

// isInterfaceOnly reports whether path is registered as INTERFACE-ONLY
// (loaded from its `.bni` only, impl skipped — see the Loader.InterfaceOnly
// field).
func (l @Loader) isInterfaceOnly(path *[]readonly char) bool {
	for i := 0; i < len(l.InterfaceOnly); i++ {
		if streq(l.InterfaceOnly[i], path) { return true }
	}
	return false
}

// hasImport reports whether the import list already contains an entry
// with the given alias and path.
func hasImport(imports @[]@ast.ImportSpec, alias *[]readonly char, path *[]readonly char) bool {
	if len(imports) == 0 { return false }
	for i := 0; i < len(imports); i++ {
		if streq(imports[i].Alias, alias) && streq(imports[i].Path, path) {
			return true
		}
	}
	return false
}

// ============================================================
// Topological Sort
// ============================================================

// computeOrder performs a topological sort of loaded packages by their dependencies.
func (l @Loader) computeOrder() {
	var visited @[]@[]char
	var order @[]@[]char

	if len(l.Packages) == 0 { return }
	for i := 0; i < len(l.Packages); i++ {
		l.visit(l.Packages[i].Path, &visited, &order)
	}
	l.Order = order
}

// visit is the recursive DFS helper for topological sort, appending a package after its deps.
func (l @Loader) visit(path @[]char, visited *@[]@[]char, order *@[]@[]char) {
	if containsStr(*visited, path) { return }
	*visited = slices.Append[@[]char](*visited, path)

	var pkg @Package = l.GetPackage(path)
	if pkg == nil { return }

	if len(pkg.Imports) > 0 {
		for i := 0; i < len(pkg.Imports); i++ {
			l.visit(pkg.Imports[i], visited, order)
		}
	}
	*order = slices.Append[@[]char](*order, path)
}

// ============================================================
// Sort
// ============================================================

// sortStrings sorts a managed-slice of strings in place using insertion sort.
func sortStrings(ss @[]@[]char) {
	// Simple insertion sort
	for i := 1; i < len(ss); i++ {
		var key @[]char = ss[i]
		var j int = i - 1
		for j >= 0 && strLess(key, ss[j]) {
			ss[j + 1] = ss[j]
			j--
		}
		ss[j + 1] = key
	}
}

// strLess returns true if string a is lexicographically less than string b.
func strLess(a @[]char, b @[]char) bool {
	var n int = len(a)
	if len(b) < n { n = len(b) }
	for i := 0; i < n; i++ {
		if a[i] < b[i] { return true }
		if a[i] > b[i] { return false }
	}
	return len(a) < len(b)
}
