package "pkg/binate/loader"

import "pkg/binate/ast"
import "pkg/binate/buildcfg"
import "pkg/binate/parser"

// asmFileIncluded evaluates a package `.s` file's file-level `#[build(...)]` gate
// against the active BuildConfig.  The gate is a single leading comment directive
// — `// ... #[build(EXPR)]`, before the first assembly line — which the assembler
// ignores (`//` is a line comment) but the loader reads: the `#[...]` text is
// parsed by the SAME annotation parser used for a `.bn`/`.bni` package clause and
// evaluated by buildcfg.DeclIncluded, so a `.s` gate uses the exact same
// grammar/vocabulary (`is`/`!is`/`&&`/`||`, keys arch/os/...) as source gating.
//
// Returns (keep, err, hasErr).  hasErr (with err set) signals a malformed/unknown
// constraint, a second gate line, or a parse error — the caller aborts the load
// rather than silently dropping the file's symbols.  A file with NO gate is kept
// (an ungated `.s` targets every configuration).  When cfg is nil — gating
// inactive (REPL / bni / unit tests, none of which assemble) — the file is kept
// unconditionally, mirroring the `.bn` gate.
func asmFileIncluded(cfg @buildcfg.BuildConfig, src @[]uint8) (bool, @[]char, bool) {
	var start int
	var end int
	var gerr @[]char
	var ghas bool
	start, end, gerr, ghas = extractAsmBuildGate(src)
	if ghas {
		return false, gerr, true
	}
	if start < 0 || cfg == nil {
		return true, "", false
	}
	var p @parser.Parser = parser.New(src[start:end], "<asm-build-gate>")
	var annots @[]@ast.Annotation = p.ParseAnnotationBlock()
	var perrs @[]parser.ParseError = p.Errors()
	if len(perrs) > 0 {
		return false, perrs[0].Msg, true
	}
	return buildcfg.DeclIncluded(cfg, annots)
}

// extractAsmBuildGate scans a `.s` file's LEADING comment block for its single
// build-gate directive: a comment line whose content begins `#[`.  It returns
// (start, end, err, hasErr), where src[start:end] is the `#[...]` text (through
// end of that line) when a gate is found and start < 0 when none is (an ungated
// file).  Scanning stops at the first non-blank, non-comment line — the gate must
// precede the assembly body — so a `#[`-looking comment further down is an
// ordinary comment, not a gate.  A SECOND gate line in the leading block is an
// error (hasErr): at most one gate per file.
func extractAsmBuildGate(src @[]uint8) (int, int, @[]char, bool) {
	var i int = 0
	var n int = len(src)
	var found bool = false
	var gateStart int = -1
	var gateEnd int = -1
	for i < n {
		var lineStart int = i
		var lineEnd int = i
		for lineEnd < n && src[lineEnd] != '\n' {
			lineEnd = lineEnd + 1
		}
		i = lineEnd + 1
		var s int = lineStart
		for s < lineEnd && (src[s] == ' ' || src[s] == '\t') {
			s = s + 1
		}
		if s >= lineEnd {
			continue // blank line — allowed within the leading block
		}
		if !(s + 1 < lineEnd && src[s] == '/' && src[s + 1] == '/') {
			break // the assembly body has begun; the gate must precede it
		}
		var c int = s + 2
		for c < lineEnd && (src[c] == ' ' || src[c] == '\t') {
			c = c + 1
		}
		if c + 1 < lineEnd && src[c] == '#' && src[c + 1] == '[' {
			if found {
				return -1, -1, "package .s file: at most one #[build(...)] gate is allowed", true
			}
			found = true
			gateStart = c
			// Trim trailing whitespace / a CRLF `\r` so the parsed region is exactly
			// the `#[...]` text (a `\r` left in would lex as an illegal token and turn
			// a valid gate into a spurious hard-abort on a CRLF-checked-out file).
			var e int = lineEnd
			for e > c && (src[e - 1] == '\r' || src[e - 1] == ' ' || src[e - 1] == '\t') {
				e = e - 1
			}
			gateEnd = e
		}
	}
	return gateStart, gateEnd, "", false
}
