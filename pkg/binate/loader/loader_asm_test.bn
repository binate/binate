package "pkg/binate/loader"

import "pkg/binate/buildcfg"
import "pkg/builtins/testing"

// sb copies a string literal into a fresh @[]uint8, the `.s` source shape the
// loader hands asmFileIncluded / extractAsmBuildGate.
func sb(s *[]readonly char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

// regionEquals reports whether src[start:end] equals want byte-for-byte.
func regionEquals(src @[]uint8, start int, end int, want *[]readonly char) bool {
	if start < 0 || end - start != len(want) {
		return false
	}
	for i := 0; i < len(want); i++ {
		if src[start + i] != cast(uint8, want[i]) {
			return false
		}
	}
	return true
}

// aarch64Cfg / x64Cfg: minimal configs for gating tests.
func aarch64Cfg() @buildcfg.BuildConfig {
	var cfg @buildcfg.BuildConfig = make(buildcfg.BuildConfig)
	cfg.Arch = "aarch64"
	cfg.OS = "linux"
	return cfg
}

func x64Cfg() @buildcfg.BuildConfig {
	var cfg @buildcfg.BuildConfig = make(buildcfg.BuildConfig)
	cfg.Arch = "x86_64"
	cfg.OS = "linux"
	return cfg
}

// The gate is the `#[...]` text of the first leading comment whose content
// begins `#[`; the returned region is exactly that text.
func TestExtractAsmGateFound() testing.TestResult {
	var src @[]uint8 = sb("// #[build(is(arch, \"aarch64\"))]\n.arch aarch64\n ret\n")
	var start int
	var end int
	var e @[]char
	var has bool
	start, end, e, has = extractAsmBuildGate(src)
	if has {
		return fail("unexpected error extracting a well-formed gate")
	}
	if !regionEquals(src, start, end, "#[build(is(arch, \"aarch64\"))]") {
		return fail("extracted region is not the gate text")
	}
	return ""
}

// A file with no gate comment yields start < 0 (ungated, kept).
func TestExtractAsmGateNone() testing.TestResult {
	var src @[]uint8 = sb(".arch aarch64\n ret\n")
	var start int
	start, _, _, _ = extractAsmBuildGate(src)
	if start >= 0 {
		return fail("expected no gate (start < 0)")
	}
	return ""
}

// A `#[`-looking comment AFTER the first assembly line is an ordinary comment,
// not a gate — scanning stops at the body.
func TestExtractAsmGateAfterCodeIgnored() testing.TestResult {
	var src @[]uint8 = sb(".arch aarch64\n// #[build(is(arch, \"x86_64\"))]\n ret\n")
	var start int
	start, _, _, _ = extractAsmBuildGate(src)
	if start >= 0 {
		return fail("a gate after the body must be ignored")
	}
	return ""
}

// A gate is found past leading blank and non-gate comment lines.
func TestExtractAsmGatePastBlankAndComment() testing.TestResult {
	var src @[]uint8 = sb("\n// a note\n// #[build(is(arch, \"aarch64\"))]\n.arch aarch64\n")
	var start int
	var has bool
	start, _, _, has = extractAsmBuildGate(src)
	if has || start < 0 {
		return fail("gate after blank + comment lines must be found")
	}
	return ""
}

// Two gate lines in the leading block is an error (at most one).
func TestExtractAsmGateTwiceErrors() testing.TestResult {
	var src @[]uint8 = sb(
			"// #[build(is(arch, \"aarch64\"))]\n"
					"// #[build(is(os, \"linux\"))]\n.arch aarch64\n")
	var has bool
	_, _, _, has = extractAsmBuildGate(src)
	if !has {
		return fail("a second gate line must be an error")
	}
	return ""
}

// A gate matching the active arch keeps the file.
func TestAsmFileIncludedMatch() testing.TestResult {
	var src @[]uint8 = sb("// #[build(is(arch, \"aarch64\"))]\n.arch aarch64\n")
	var keep bool
	var e @[]char
	var has bool
	keep, e, has = asmFileIncluded(aarch64Cfg(), src)
	if has {
		return fail("well-formed matching gate must not error")
	}
	if !keep {
		return fail("a gate matching the active arch must keep the file")
	}
	return ""
}

// A gate that excludes the active arch drops the file (no error).
func TestAsmFileIncludedMismatch() testing.TestResult {
	var src @[]uint8 = sb("// #[build(is(arch, \"aarch64\"))]\n.arch aarch64\n")
	var keep bool
	var has bool
	keep, _, has = asmFileIncluded(x64Cfg(), src)
	if has {
		return fail("a non-matching gate is a clean drop, not an error")
	}
	if keep {
		return fail("a gate excluding the active arch must drop the file")
	}
	return ""
}

// nil config (gating inactive) keeps the file unconditionally.
func TestAsmFileIncludedNilConfigKept() testing.TestResult {
	var src @[]uint8 = sb("// #[build(is(arch, \"aarch64\"))]\n.arch aarch64\n")
	var keep bool
	keep, _, _ = asmFileIncluded(nil, src)
	if !keep {
		return fail("nil config must keep the file (gating inactive)")
	}
	return ""
}

// An ungated file is kept on any target.
func TestAsmFileIncludedNoGateKept() testing.TestResult {
	var src @[]uint8 = sb(".arch aarch64\n ret\n")
	var keep bool
	keep, _, _ = asmFileIncluded(x64Cfg(), src)
	if !keep {
		return fail("an ungated .s must be kept")
	}
	return ""
}

// A CRLF gate line (trailing `\r`) parses correctly — the region is trimmed to
// the exact `#[...]` text, not left with a `\r` that would spuriously hard-abort.
func TestAsmFileIncludedCRLFGate() testing.TestResult {
	var src @[]uint8 = sb("// #[build(is(arch, \"aarch64\"))]\r\n.arch aarch64\r\n")
	var keep bool
	var has bool
	keep, _, has = asmFileIncluded(aarch64Cfg(), src)
	if has {
		return fail("a CRLF gate line must not error")
	}
	if !keep {
		return fail("a CRLF gate matching the arch must keep the file")
	}
	return ""
}

// A malformed / unknown constraint is a hard error (aborts the load).
func TestAsmFileIncludedMalformedErrors() testing.TestResult {
	var src @[]uint8 = sb("// #[build(nope(x))]\n.arch aarch64\n")
	var has bool
	_, _, has = asmFileIncluded(aarch64Cfg(), src)
	if !has {
		return fail("an unknown predicate must be a hard error")
	}
	return ""
}
