package "pkg/binate/loader"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Keeps a parser's borrowed source buffer alive across a parse.
var exposeTestSrc @[]uint8

// parseBniForExpose parses a .bni source string into an ast.File (interface
// mode, so `expose` is accepted).
func parseBniForExpose(src *[]readonly char) @ast.File {
	exposeTestSrc = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		exposeTestSrc[i] = cast(uint8, src[i])
	}
	return parser.NewInterface(exposeTestSrc, "t.bni").ParseFile()
}

// TestCollectExposePathsSingle: one `expose "P"` yields P's unquoted path.
func TestCollectExposePathsSingle() testing.TestResult {
	var f @ast.File = parseBniForExpose("package \"a\"\nexpose \"pkg/std/foo\"\n")
	var paths @[]@[]char = collectExposePaths(f)
	if len(paths) != 1 {
		return fail("expected exactly 1 expose path")
	}
	if !streq(paths[0], "pkg/std/foo") {
		return fail("expose path should be the unquoted pkg/std/foo")
	}
	return ""
}

// TestCollectExposePathsMultiple: two exposes are collected in source order.
func TestCollectExposePathsMultiple() testing.TestResult {
	var f @ast.File = parseBniForExpose(
			"package \"a\"\n"
					"expose \"pkg/p\"\n"
					"expose \"pkg/q\"\n")
	var paths @[]@[]char = collectExposePaths(f)
	if len(paths) != 2 {
		return fail("expected exactly 2 expose paths")
	}
	if !streq(paths[0], "pkg/p") || !streq(paths[1], "pkg/q") {
		return fail("expose paths wrong or out of source order")
	}
	return ""
}

// TestCollectExposePathsNone: a .bni with no expose decls yields an empty list.
func TestCollectExposePathsNone() testing.TestResult {
	var f @ast.File = parseBniForExpose("package \"a\"\ntype T struct { x int }\n")
	var paths @[]@[]char = collectExposePaths(f)
	if len(paths) != 0 {
		return fail("expected no expose paths")
	}
	return ""
}

// TestCollectExposePathsNil: a nil bniFile is handled safely (empty result).
func TestCollectExposePathsNil() testing.TestResult {
	var f @ast.File
	var paths @[]@[]char = collectExposePaths(f)
	if len(paths) != 0 {
		return fail("nil bniFile should yield an empty expose list")
	}
	return ""
}

// TestRecordExposesDedupsImports: recordExposes records every exposed path in
// pkg.Exposes and appends it to pkg.Imports WITHOUT duplicating a path already
// present in pkg.Imports (a package that both imports and exposes P).
func TestRecordExposesDedupsImports() testing.TestResult {
	var f @ast.File = parseBniForExpose(
			"package \"a\"\n"
					"expose \"pkg/dup\"\n"
					"expose \"pkg/new\"\n")
	var pkg @Package = make(Package)
	pkg.Path = "pkg/a"
	pkg.Imports = slices.Append[@[]char](pkg.Imports, "pkg/dup")
	recordExposes(pkg, f)
	// pkg/dup was already imported -> not duplicated; pkg/new is appended.
	if len(pkg.Imports) != 2 {
		return fail("expected pkg.Imports to hold 2 entries (pkg/dup not duplicated)")
	}
	if len(pkg.Exposes) != 2 {
		return fail("expected both exposed paths in pkg.Exposes")
	}
	if !streq(pkg.Exposes[0], "pkg/dup") || !streq(pkg.Exposes[1], "pkg/new") {
		return fail("pkg.Exposes wrong or out of source order")
	}
	return ""
}
