package "pkg/binate/loader"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Keeps a parser's borrowed source buffer alive across a parse.
var exposeTestSrc @[]uint8

// parseBniForExpose parses a .bni source string into an ast.File (interface
// mode, so `expose` is accepted).
func parseBniForExpose(src *[]readonly char) @ast.File {
	exposeTestSrc = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		exposeTestSrc[i] = cast(uint8, src[i])
	}
	return parser.NewInterface(exposeTestSrc, "t.bni").ParseFile()
}

// TestCollectExposePathsSingle: one `expose "P"` yields P's unquoted path.
func TestCollectExposePathsSingle() testing.TestResult {
	var f @ast.File = parseBniForExpose("package \"a\"\nexpose \"pkg/std/foo\"\n")
	var paths @[]@[]char = collectExposePaths(f)
	if len(paths) != 1 {
		return fail("expected exactly 1 expose path")
	}
	if !streq(paths[0], "pkg/std/foo") {
		return fail("expose path should be the unquoted pkg/std/foo")
	}
	return ""
}

// TestCollectExposePathsMultiple: two exposes are collected in source order.
func TestCollectExposePathsMultiple() testing.TestResult {
	var f @ast.File = parseBniForExpose(
			"package \"a\"\n"
					"expose \"pkg/p\"\n"
					"expose \"pkg/q\"\n")
	var paths @[]@[]char = collectExposePaths(f)
	if len(paths) != 2 {
		return fail("expected exactly 2 expose paths")
	}
	if !streq(paths[0], "pkg/p") || !streq(paths[1], "pkg/q") {
		return fail("expose paths wrong or out of source order")
	}
	return ""
}

// TestCollectExposePathsNone: a .bni with no expose decls yields an empty list.
func TestCollectExposePathsNone() testing.TestResult {
	var f @ast.File = parseBniForExpose("package \"a\"\ntype T struct { x int }\n")
	var paths @[]@[]char = collectExposePaths(f)
	if len(paths) != 0 {
		return fail("expected no expose paths")
	}
	return ""
}

// TestCollectExposePathsNil: a nil bniFile is handled safely (empty result).
func TestCollectExposePathsNil() testing.TestResult {
	var f @ast.File
	var paths @[]@[]char = collectExposePaths(f)
	if len(paths) != 0 {
		return fail("nil bniFile should yield an empty expose list")
	}
	return ""
}

// TestRecordExposesDedupsImports: recordExposes records every exposed path in
// pkg.Exposes and appends it to pkg.Imports WITHOUT duplicating a path already
// present in pkg.Imports (a package that both imports and exposes P).
func TestRecordExposesDedupsImports() testing.TestResult {
	var f @ast.File = parseBniForExpose(
			"package \"a\"\n"
					"expose \"pkg/dup\"\n"
					"expose \"pkg/new\"\n")
	var pkg @Package = make(Package)
	pkg.Path = "pkg/a"
	pkg.Imports = slices.Append[@[]char](pkg.Imports, "pkg/dup")
	recordExposes(pkg, f)
	// pkg/dup was already imported -> not duplicated; pkg/new is appended.
	if len(pkg.Imports) != 2 {
		return fail("expected pkg.Imports to hold 2 entries (pkg/dup not duplicated)")
	}
	if len(pkg.Exposes) != 2 {
		return fail("expected both exposed paths in pkg.Exposes")
	}
	if !streq(pkg.Exposes[0], "pkg/dup") || !streq(pkg.Exposes[1], "pkg/new") {
		return fail("pkg.Exposes wrong or out of source order")
	}
	return ""
}

// mkExposePkg registers a package with the given path + expose targets on the
// loader (for ExposeClosure tests, which need only Path + Exposes).
func mkExposePkg(l @Loader, path @[]char, exposes @[]@[]char) {
	var p @Package = make(Package)
	p.Path = path
	p.Exposes = exposes
	l.Packages = slices.Append[@Package](l.Packages, p)
}

// TestExposeClosureTransitive: ExposeClosure follows expose edges transitively —
// A exposes P, P exposes Q -> {pkg/p, pkg/q} in discovery order.
func TestExposeClosureTransitive() testing.TestResult {
	var l @Loader = NewLoader()
	var aExp @[]@[]char
	aExp = slices.Append[@[]char](aExp, "pkg/p")
	mkExposePkg(l, "pkg/a", aExp)
	var pExp @[]@[]char
	pExp = slices.Append[@[]char](pExp, "pkg/q")
	mkExposePkg(l, "pkg/p", pExp)
	var qExp @[]@[]char
	mkExposePkg(l, "pkg/q", qExp)

	var roots @[]@[]char
	roots = slices.Append[@[]char](roots, "pkg/a")
	var exclude @[]@[]char
	var closure @[]@[]char = l.ExposeClosure(roots, exclude)
	if len(closure) != 2 {
		return fail("expected 2 closure packages (pkg/p, pkg/q)")
	}
	if !streq(closure[0], "pkg/p") || !streq(closure[1], "pkg/q") {
		return fail("closure wrong or out of discovery order")
	}
	return ""
}

// TestExposeClosureExcludesAlreadyRegistered: a closure package already in the
// exclude set (e.g. also a direct import) is not returned.
func TestExposeClosureExcludesAlreadyRegistered() testing.TestResult {
	var l @Loader = NewLoader()
	var aExp @[]@[]char
	aExp = slices.Append[@[]char](aExp, "pkg/p")
	mkExposePkg(l, "pkg/a", aExp)
	var pExp @[]@[]char
	pExp = slices.Append[@[]char](pExp, "pkg/q")
	mkExposePkg(l, "pkg/p", pExp)
	var qExp @[]@[]char
	mkExposePkg(l, "pkg/q", qExp)

	var roots @[]@[]char
	roots = slices.Append[@[]char](roots, "pkg/a")
	var exclude @[]@[]char
	exclude = slices.Append[@[]char](exclude, "pkg/q")
	var closure @[]@[]char = l.ExposeClosure(roots, exclude)
	if len(closure) != 1 || !streq(closure[0], "pkg/p") {
		return fail("expected closure [pkg/p] with pkg/q excluded")
	}
	return ""
}

// TestExposeClosureRootWalkedEvenIfExcluded: a root that is ALSO in the exclude
// set (a direct import that is itself a forwarder) is not added, but its own
// exposes ARE still walked — so P (excluded) exposing Q yields {pkg/q}.  This is
// what makes passing the direct imports as roots correct even when some of them
// are also in the exclude set.
func TestExposeClosureRootWalkedEvenIfExcluded() testing.TestResult {
	var l @Loader = NewLoader()
	var pExp @[]@[]char
	pExp = slices.Append[@[]char](pExp, "pkg/q")
	mkExposePkg(l, "pkg/p", pExp)
	var qExp @[]@[]char
	mkExposePkg(l, "pkg/q", qExp)

	var roots @[]@[]char
	roots = slices.Append[@[]char](roots, "pkg/p")
	var exclude @[]@[]char
	exclude = slices.Append[@[]char](exclude, "pkg/p")
	var closure @[]@[]char = l.ExposeClosure(roots, exclude)
	if len(closure) != 1 || !streq(closure[0], "pkg/q") {
		return fail("excluded root pkg/p must still be walked, yielding [pkg/q]")
	}
	return ""
}
