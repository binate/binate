package "pkg/binate/loader"

import "pkg/binate/ast"
import "pkg/std/cmp"
import "pkg/std/containers/table"
import "pkg/std/containers/vec"
import "pkg/std/hash"

// funcDeclIndex holds a package's top-level function declarations by name, so the
// definition a `.bni` function declaration has (sameFuncDecl) is found among those of
// its name, in time independent of how many declarations the package has.  Its keys
// borrow the declarations' names.
type funcDeclIndex struct {
	byName @table.Table[*[]readonly char, @vec.Vec[@ast.Decl], loaderNameHasher, loaderNameEq]
}

// newFuncDeclIndex returns the index of decls' top-level function declarations.
func newFuncDeclIndex(decls *[]@ast.Decl) @funcDeclIndex {
	var ix @funcDeclIndex = make(funcDeclIndex)
	ix.byName = table.NewTable[*[]readonly char, @vec.Vec[@ast.Decl], loaderNameHasher, loaderNameEq](
			loaderNameHasher{}, loaderNameEq{})
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind != ast.DECL_FUNC { continue }
		var ofName @vec.Vec[@ast.Decl]
		var ok bool
		ofName, ok = ix.byName.Get(d.Name)
		if !ok {
			ofName = vec.New[@ast.Decl]()
			ix.byName.Put(d.Name, ofName)
		}
		ofName.Push(d)
	}
	return ix
}

// hasSame reports whether ix holds a declaration of the function d declares
// (sameFuncDecl).
func (ix @funcDeclIndex) hasSame(d @ast.Decl) bool {
	var named @vec.Vec[@ast.Decl]
	var ok bool
	named, ok = ix.byName.Get(d.Name)
	if !ok { return false }
	for i := 0; i < named.Len(); i++ {
		if sameFuncDecl(named.Get(i), d) { return true }
	}
	return false
}

// loaderNameHasher and loaderNameEq key a table by a name's bytes.
type loaderNameHasher struct {}

impl loaderNameHasher : hash.Hasher[*[]readonly char]

// Hash hashes a name's bytes (djb2).
func (h loaderNameHasher) Hash(k *[]readonly char) uint {
	var v uint = 5381
	for i := 0; i < len(k); i++ {
		v = v * 33 + cast(uint, k[i])
	}
	return v
}

// loaderNameEq is the byte equality paired with loaderNameHasher.
type loaderNameEq struct {}

impl loaderNameEq : cmp.Eq[*[]readonly char]

// Equal reports whether a and b hold the same bytes.
func (e loaderNameEq) Equal(a *[]readonly char, b *[]readonly char) bool {
	return streq(a, b)
}
