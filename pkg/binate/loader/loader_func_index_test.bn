package "pkg/binate/loader"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for loader_func_index.bn.

// funcIndexDecl returns a top-level declaration of kind named name, a method on recv
// when recv is not empty.
func funcIndexDecl(kind int, name *[]readonly char, recv *[]readonly char) @ast.Decl {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = kind
	d.Name = buf.CopyStr(name)
	if len(recv) > 0 {
		d.Recv = make(ast.ParamDecl)
		d.Recv.Type = make(ast.TypeExpr)
		d.Recv.Type.Kind = ast.TEXPR_NAMED
		d.Recv.Type.Name = buf.CopyStr(recv)
	}
	return d
}

// The index finds a function's declaration by name and receiver, not a method of the
// name, another type's method or a type of the name.
func TestFuncDeclIndex() testing.TestResult {
	var decls @[]@ast.Decl = make_slice(@ast.Decl, 4)
	decls[0] = funcIndexDecl(ast.DECL_TYPE, "Stat", "")
	decls[1] = funcIndexDecl(ast.DECL_FUNC, "Stat", "File")
	decls[2] = funcIndexDecl(ast.DECL_FUNC, "Open", "")
	decls[3] = funcIndexDecl(ast.DECL_FUNC, "Close", "File")
	var ix @funcDeclIndex = newFuncDeclIndex(decls)
	if !ix.hasSame(funcIndexDecl(ast.DECL_FUNC, "Open", "")) { return fail("Open is defined") }
	if !ix.hasSame(funcIndexDecl(ast.DECL_FUNC, "Stat", "File")) {
		return fail("File.Stat is defined")
	}
	if ix.hasSame(funcIndexDecl(ast.DECL_FUNC, "Stat", "")) { return fail("a free Stat is not") }
	if ix.hasSame(funcIndexDecl(ast.DECL_FUNC, "Close", "Dir")) { return fail("Dir.Close is not") }
	if ix.hasSame(funcIndexDecl(ast.DECL_FUNC, "Read", "")) { return fail("Read is not") }
	return ""
}
