package "pkg/binate/loader"

import "pkg/builtins/testing"

// Tests for loadPackage (via its loading-stack behavior) in loader_load.bn.
// Shared helpers live in loader_test.bn (same package).

func TestLoadingStackPushPop() testing.TestResult {
	var l @Loader = NewLoader()
	if l.isLoading("pkg/a") { return fail("fresh loader should have nothing loading") }
	l.pushLoading("pkg/a")
	l.pushLoading("pkg/b")
	if !l.isLoading("pkg/a") { return fail("pkg/a should be loading") }
	if !l.isLoading("pkg/b") { return fail("pkg/b should be loading") }
	l.popLoading("pkg/b")
	if l.isLoading("pkg/b") { return fail("pkg/b should be popped") }
	if !l.isLoading("pkg/a") { return fail("pkg/a should still be loading") }
	l.popLoading("pkg/a")
	if l.isLoading("pkg/a") { return fail("pkg/a should be popped") }
	if len(l.loadingStack) != 0 { return fail("stack should be empty after balanced pops") }
	return ""
}

func TestLoadingStackPopLastOccurrence() testing.TestResult {
	// popLoading removes only the LAST occurrence, so a path entered
	// twice stays "loading" until both pushes are balanced.
	var l @Loader = NewLoader()
	l.pushLoading("pkg/a")
	l.pushLoading("pkg/a")
	l.popLoading("pkg/a")
	if !l.isLoading("pkg/a") { return fail("one occurrence should remain") }
	l.popLoading("pkg/a")
	if l.isLoading("pkg/a") { return fail("both occurrences should be gone") }
	return ""
}

func TestLoaderLoadingStackIsolation() testing.TestResult {
	// Per-instance loadingStack: a path left in-flight on one Loader
	// (e.g. an error path that skipped its pop) must NOT make a second
	// Loader see a phantom import cycle.  This is the reentrancy
	// guarantee a process-global stack could not provide.
	var a @Loader = NewLoader()
	a.pushLoading("pkg/x")
	var b @Loader = NewLoader()
	if b.isLoading("pkg/x") {
		return fail("second loader must not see the first loader's in-flight load")
	}
	return ""
}
