package "pkg/binate/loader"

import "pkg/binate/ast"
import "pkg/stdx/slices"

// MergeFiles combines the parsed files of one package into a single new AST,
// deduplicating imports (by alias+path via hasImport) and concatenating
// declarations — a new one for a single file too, so a later merge into it (the
// package's `.bni`, appending its imports) never changes a source file's own AST,
// which per-file import scopes read.
func MergeFiles(files *[]@ast.File) @ast.File {
	if len(files) == 0 {
		return nil
	}

	var merged @ast.File = make(ast.File)
	merged.PkgName = files[0].PkgName
	merged.Pos = files[0].Pos

	// Deduplicate imports
	for i := 0; i < len(files); i++ {
		if len(files[i].Imports) == 0 { continue }
		for j := 0; j < len(files[i].Imports); j++ {
			var imp @ast.ImportSpec = files[i].Imports[j]
			if !hasImport(merged.Imports, imp.Alias, imp.Path) {
				merged.Imports = slices.Append[@ast.ImportSpec](merged.Imports, imp)
			}
		}
	}

	// Concatenate declarations
	for i := 0; i < len(files); i++ {
		if len(files[i].Decls) == 0 { continue }
		for j := 0; j < len(files[i].Decls); j++ {
			merged.Decls = slices.Append[@ast.Decl](merged.Decls, files[i].Decls[j])
		}
	}

	// Per-file Annotations and Comments are deliberately NOT merged: this is
	// the loader/compiler path (parser.New, non-collecting), where both are
	// empty.  A whole-package formatter that needs comments would format each
	// file on its own (via NewCollecting) rather than the merged unit.
	return merged
}
