package "pkg/binate/loader"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for the load order (computeOrder, LoadImplicitDep).

// orderPkg returns a package at path whose imports are imports.
func orderPkg(path *[]readonly char, imports @[]@[]char) @Package {
	var p @Package = make(Package)
	p.Path = buf.CopyStr(path)
	p.Imports = imports
	return p
}

// orderIs reports whether l.Order is want.
func orderIs(l @Loader, want @[]@[]char) bool {
	if len(l.Order) != len(want) { return false }
	for i := 0; i < len(want); i++ {
		if !streq(l.Order[i], want[i]) { return false }
	}
	return true
}

// An implicit dependency, loaded already and imported by nothing, is ordered —
// after its own dependencies — before every other package, so a package that
// uses it without importing it follows it.
func TestImplicitDepOrderedFirst() testing.TestResult {
	var l @Loader = NewLoader()
	var none @[]@[]char
	l.Packages = @[]@Package{orderPkg("pkg/a", none), orderPkg("pkg/b", @[]@[]char{"pkg/x"}),
			orderPkg("pkg/x", none), orderPkg("pkg/lang", @[]@[]char{"pkg/y"}), orderPkg("pkg/y", none)}
	l.computeOrder()
	if !orderIs(l, @[]@[]char{"pkg/a", "pkg/x", "pkg/b", "pkg/y", "pkg/lang"}) {
		return fail("import edges alone order by insertion")
	}
	l.LoadImplicitDep("pkg/lang")
	if len(l.Errors) > 0 { return fail(l.Errors[0]) }
	if !orderIs(l, @[]@[]char{"pkg/y", "pkg/lang", "pkg/a", "pkg/x", "pkg/b"}) {
		return fail("the implicit dependency and its own dependency should come first")
	}
	return ""
}
