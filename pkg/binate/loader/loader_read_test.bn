package "pkg/binate/loader"

import "pkg/builtins/testing"
import "pkg/std/os"

// readTestFile writes n bytes (byte i is i mod 251) to a new file in dir and
// returns its path, or an empty path if it could not.
func readTestFile(dir *[]readonly char, n int) @[]char {
	var path @[]char = pathJoin(dir, "f.bn")
	var data @[]uint8 = make_slice(uint8, n)
	for i := 0; i < n; i++ {
		data[i] = cast(uint8, i % 251)
	}
	f, err := os.Create(path)
	if present(err) {
		var none @[]char
		return none
	}
	_, _ = f.Write(data)
	_ = f.Close()
	return path
}

// readFileBytes returns a file's exact contents whatever its size relative to
// the read buffer, nothing for an empty file and nothing for a missing one.
func TestReadFileBytesWholeFile() testing.TestResult {
	dir, derr := os.MkdirTemp("/tmp", "binate_loader_read_test_")
	if present(derr) { return "could not create a temporary directory" }
	defer { _ = os.RemoveAll(dir) }
	var sizes [5]int = [5]int{1, 4095, 4096, 4097, 70000}
	for k := 0; k < len(sizes); k++ {
		var path @[]char = readTestFile(dir, sizes[k])
		if len(path) == 0 { return "could not write the test file" }
		var got @[]uint8 = readFileBytes(path)
		if len(got) != sizes[k] { return "expected the file's length back" }
		for i := 0; i < len(got); i++ {
			if got[i] != cast(uint8, i % 251) { return "expected the file's bytes back" }
		}
	}
	if len(readFileBytes(readTestFile(dir, 0))) != 0 { return "expected nothing for an empty file" }
	if len(readFileBytes(pathJoin(dir, "missing.bn"))) != 0 {
		return "expected nothing for a missing file"
	}
	return ""
}
