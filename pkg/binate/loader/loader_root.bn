package "pkg/binate/loader"

import "pkg/binate/ast"
import "pkg/binate/buildcfg"
import "pkg/stdx/slices"

// LoadRoot gates and loads the root package of a load — the main program, or an
// embedder's driver package — which its driver has already parsed from files it
// was handed, so it never passes through loadPackage.  It applies the same
// `#[build(...)]` gate loadPackage applies to an imported package: a file whose
// package-clause constraint excludes the active target is dropped, each
// surviving file's gated-out declarations and imports are dropped
// (gateDeclsAndImports), the files are merged, and only the imports that survive
// are loaded.  Returns the merged file and the gated per-file ASTs (as
// Package.Files keeps them for an imported package).  On a malformed or
// unknown constraint, or when every file is gated out, the error is appended to
// l.Errors and the merged file is nil.
func (l @Loader) LoadRoot(files *[]@ast.File) (@ast.File, @[]@ast.File) {
	var kept @[]@ast.File
	var none @ast.File
	for i := 0; i < len(files); i++ {
		var f @ast.File = files[i]
		if l.BuildConfig != nil {
			var keep bool
			var cerr @[]char
			var chas bool
			keep, cerr, chas = buildcfg.DeclIncluded(l.BuildConfig, f.Annotations)
			if chas {
				l.Errors = slices.Append[@[]char](l.Errors, cerr)
				return none, kept
			}
			if !keep {
				continue
			}
		}
		// Gate each file's declarations and imports before the merge, as
		// loadPackage does (the merge de-duplicates imports, and the returned
		// per-file ASTs must not keep a gated-out import).
		if !l.gateDeclsAndImports(f) {
			return none, kept
		}
		kept = slices.Append[@ast.File](kept, f)
	}
	if len(kept) == 0 {
		l.Errors = slices.Append[@[]char](l.Errors,
				"no source file is built for this target: each is excluded by its "
						"package-clause #[build(...)] constraint")
		return none, kept
	}
	var merged @ast.File = kept[0]
	if len(kept) > 1 {
		merged = MergeFiles(kept)
	}
	l.LoadImports(merged.Imports)
	return merged, kept
}
