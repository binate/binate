package "pkg/binate/loader"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/buildcfg"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Keeps each parser's borrowed source buffer alive across the parse and after.
var lrTestSrcs @[]@[]uint8

// lrParse parses src as an ordinary `.bn` file.
func lrParse(src *[]readonly char) @ast.File {
	var b @[]uint8 = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		b[i] = cast(uint8, src[i])
	}
	var keep @[]@[]uint8 = make_slice(@[]uint8, len(lrTestSrcs) + 1)
	for i := 0; i < len(lrTestSrcs); i++ {
		keep[i] = lrTestSrcs[i]
	}
	keep[len(lrTestSrcs)] = b
	lrTestSrcs = keep
	return parser.New(b, "t.bn").ParseFile()
}

// lrLoader returns a loader gating for aarch64/linux, with no search paths.
func lrLoader() @Loader {
	var l @Loader = NewLoader()
	var cfg @buildcfg.BuildConfig = make(buildcfg.BuildConfig)
	cfg.Arch = "aarch64"
	cfg.OS = "linux"
	l.BuildConfig = cfg
	return l
}

// lrHasFunc reports whether f declares a function named name.
func lrHasFunc(f @ast.File, name *[]readonly char) bool {
	for i := 0; i < len(f.Decls); i++ {
		var d @ast.Decl = f.Decls[i]
		if d.Kind == ast.DECL_FUNC && streq(d.Name, name) { return true }
	}
	return false
}

// A file whose package-clause constraint excludes the target is dropped before
// the merge; the surviving file is returned as the merged file and as the only
// per-file AST.
func TestLoadRootDropsGatedFile() testing.TestResult {
	var files @[]@ast.File = make_slice(@ast.File, 2)
	files[0] = lrParse("#[build(is(arch, \"x64\"))]\npackage \"main\"\nfunc onX64() {}\n")
	files[1] = lrParse("package \"main\"\nfunc main() {}\n")
	var l @Loader = lrLoader()
	merged, built := l.LoadRoot(files)
	if len(l.Errors) != 0 { return "LoadRoot should not report an error" }
	if merged == nil || len(built) != 1 { return "LoadRoot should keep exactly one file" }
	if lrHasFunc(merged, "onX64") || !lrHasFunc(merged, "main") {
		return "the x64-only file should be dropped and the other kept"
	}
	return ""
}

// Complementary declaration gates leave one definition, and a gated-out import
// is never followed (the named package does not exist, so loading it would fail).
func TestLoadRootGatesDeclsAndImports() testing.TestResult {
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = lrParse(
			"package \"main\"\n"
					"#[build(is(arch, \"x64\"))]\nimport \"pkg/nosuch_for_loadroot\"\n"
					"#[build(is(arch, \"aarch64\"))]\nfunc pick() int { return 1 }\n"
					"#[build(!is(arch, \"aarch64\"))]\nfunc pick() int { return 2 }\n"
					"func main() {}\n")
	var l @Loader = lrLoader()
	merged, _ := l.LoadRoot(files)
	if len(l.Errors) != 0 { return "the gated-out import must not be loaded" }
	if merged == nil { return "LoadRoot should return the merged file" }
	if len(merged.Imports) != 0 { return "the gated-out import should be dropped" }
	var picks int = 0
	for i := 0; i < len(merged.Decls); i++ {
		if streq(merged.Decls[i].Name, "pick") { picks = picks + 1 }
	}
	if picks != 1 { return "exactly one pick variant should survive" }
	return ""
}

// A constraint that fails to evaluate is a hard error, never a silent skip.
func TestLoadRootMalformedConstraint() testing.TestResult {
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = lrParse("package \"main\"\n#[build(gt(version, \"1.0.0\"))]\nfunc f() {}\n")
	var l @Loader = lrLoader()
	merged, _ := l.LoadRoot(files)
	if merged != nil || len(l.Errors) == 0 {
		return "a malformed declaration constraint should fail the load"
	}
	var files2 @[]@ast.File = make_slice(@ast.File, 1)
	files2[0] = lrParse("#[build(is(cpu, \"x\"))]\npackage \"main\"\nfunc main() {}\n")
	var l2 @Loader = lrLoader()
	var merged2 @ast.File
	merged2, _ = l2.LoadRoot(files2)
	if merged2 != nil || len(l2.Errors) == 0 {
		return "a malformed package-clause constraint should fail the load"
	}
	return ""
}

// When every file is gated out there is nothing to build: an error, not an empty
// program.
func TestLoadRootAllFilesGatedOut() testing.TestResult {
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = lrParse("#[build(is(arch, \"x64\"))]\npackage \"main\"\nfunc main() {}\n")
	var l @Loader = lrLoader()
	merged, built := l.LoadRoot(files)
	if merged != nil || len(built) != 0 || len(l.Errors) == 0 {
		return "a fully gated-out root package should be an error"
	}
	return ""
}

// With no build configuration gating is inactive: every file and declaration is
// kept.
func TestLoadRootNoConfigKeepsAll() testing.TestResult {
	var files @[]@ast.File = make_slice(@ast.File, 2)
	files[0] = lrParse("#[build(is(arch, \"x64\"))]\npackage \"main\"\nfunc a() {}\n")
	files[1] = lrParse("package \"main\"\n#[build(is(arch, \"x64\"))]\nfunc b() {}\n")
	var l @Loader = NewLoader()
	merged, built := l.LoadRoot(files)
	if len(l.Errors) != 0 || merged == nil || len(built) != 2 {
		return "with no build config every file should be kept"
	}
	if !lrHasFunc(merged, "a") || !lrHasFunc(merged, "b") {
		return "with no build config every declaration should be kept"
	}
	return ""
}

// lrMem is an in-memory SourceProvider over a fixed set of files (full paths)
// and the directories that hold them.
type lrMem struct {
	dirs  @[]@[]char
	paths @[]@[]char
	srcs  @[]@[]uint8
}

// lrAdd adds file name with source src to directory dir.
func lrAdd(m @lrMem, dir *[]readonly char, name *[]readonly char, src *[]readonly char) {
	if !containsStr(m.dirs, dir) {
		m.dirs = slices.Append[@[]char](m.dirs, buf.CopyStr(dir))
	}
	m.paths = slices.Append[@[]char](m.paths, pathJoin(dir, name))
	m.srcs = slices.Append[@[]uint8](m.srcs, memBytes(src))
}

func (m @lrMem) Stat(path *[]readonly char) (bool, bool) {
	if containsStr(m.dirs, path) { return true, true }
	if containsStr(m.paths, path) { return true, false }
	return false, false
}

func (m @lrMem) List(dir *[]readonly char) @[]@[]char {
	var names @[]@[]char
	for i := 0; i < len(m.paths); i++ {
		var p @[]char = m.paths[i]
		if len(p) > len(dir) + 1 && streq(p[0:len(dir)], dir) && p[len(dir)] == '/' {
			names = slices.Append[@[]char](names, buf.CopyStr(p[len(dir) + 1:len(p)]))
		}
	}
	return names
}

func (m @lrMem) Read(path *[]readonly char) @[]uint8 {
	for i := 0; i < len(m.paths); i++ {
		if streq(m.paths[i], path) { return m.srcs[i] }
	}
	var none @[]uint8
	return none
}

impl @lrMem : SourceProvider

// A gated-out import in one root file does not stand in for the same import made
// unconditionally in another: the files are gated before the merge
// de-duplicates imports, so the dependency is still loaded, and the gated file's
// own AST no longer lists it.
func TestLoadRootGatedImportDoesNotShadowAnother() testing.TestResult {
	var m @lrMem = make(lrMem)
	lrAdd(m, "/mem/pkg/dep", "dep.bn", "package \"pkg/dep\"\nfunc D() int { return 1 }\n")
	var l @Loader = lrLoader()
	l.AddImplPath("/mem")
	l.Provider = m
	var files @[]@ast.File = make_slice(@ast.File, 2)
	files[0] = lrParse("package \"main\"\n#[build(is(arch, \"x64\"))]\nimport \"pkg/dep\"\n")
	files[1] = lrParse("package \"main\"\nimport \"pkg/dep\"\nfunc main() {}\n")
	merged, built := l.LoadRoot(files)
	if len(l.Errors) != 0 { return fail(l.Errors[0]) }
	if merged == nil || len(merged.Imports) != 1 {
		return "the ungated import should survive the merge"
	}
	if l.GetPackage("pkg/dep") == nil { return "pkg/dep should be loaded" }
	if len(built) != 2 || len(built[0].Imports) != 0 || len(built[1].Imports) != 1 {
		return "each file's own imports should be gated"
	}
	return ""
}

// An imported package with several files: a gated-out import is dropped from that
// file's own AST (Package.Files), not only from the merged file, so a per-file
// scope never names a package that was never loaded.
func TestLoadPackageGatesEachFilesImports() testing.TestResult {
	var m @lrMem = make(lrMem)
	lrAdd(m, "/mem/pkg/sel", "a.bn",
			"package \"pkg/sel\"\n#[build(is(arch, \"x64\"))]\nimport \"pkg/never\"\n")
	lrAdd(m, "/mem/pkg/sel", "b.bn", "package \"pkg/sel\"\nfunc S() int { return 1 }\n")
	var l @Loader = lrLoader()
	l.AddImplPath("/mem")
	l.Provider = m
	l.loadPackage("pkg/sel")
	if len(l.Errors) != 0 { return fail(l.Errors[0]) }
	var pkg @Package = l.GetPackage("pkg/sel")
	if pkg == nil || len(pkg.Files) != 2 { return "pkg/sel should load with both files" }
	for i := 0; i < len(pkg.Files); i++ {
		if len(pkg.Files[i].Imports) != 0 {
			return "the gated-out import should be dropped from its file"
		}
	}
	return ""
}

// #[c_export] placement is checked on the root package too.
func TestLoadRootCExportPlacement() testing.TestResult {
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = lrParse(
			"package \"main\"\n#[c_export(\"foo\")]\ntype T struct { x int }\n"
					"func main() {}\n")
	var l @Loader = lrLoader()
	merged, _ := l.LoadRoot(files)
	if merged != nil || len(l.Errors) == 0 { return "#[c_export] on a type should fail the load" }
	return ""
}
