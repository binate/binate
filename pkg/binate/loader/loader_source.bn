package "pkg/binate/loader"

import "pkg/binate/buf"
import "pkg/std/os"
import "pkg/stdx/slices"

// OsSourceProvider is the default SourceProvider: it reads the real filesystem via
// pkg/std/os.  NewLoader installs it, so every existing caller (bnc, bni, the REPL,
// unit tests) is unaffected — the loader's search logic is unchanged, only its
// filesystem access is routed through the provider.  A host replaces
// Loader.Provider before loading to serve package source from elsewhere (e.g. an
// in-memory overlay for a browser/wasm embedding) without touching that logic.
type OsSourceProvider struct {
}

// Stat reports whether path exists and whether it is a directory.
func (p @OsSourceProvider) Stat(path *[]readonly char) (bool, bool) {
	fi, err := os.Stat(path)
	if present(err) {
		return false, false
	}
	return true, fi.IsDir()
}

// List returns the entry names in dir (os.ReadDir already drops "." and ".."), or
// an empty slice if dir is not a readable directory.  Loader policy — skipping
// dot-prefixed and non-".bn" names — stays in the caller, not the provider.
func (p @OsSourceProvider) List(dir *[]readonly char) @[]@[]char {
	var names @[]@[]char
	dents, rderr := os.ReadDir(dir)
	if present(rderr) {
		return names
	}
	for i := 0; i < len(dents); i++ {
		var dnm @[]readonly char = dents[i].Name()
		names = slices.Append[@[]char](names, buf.CopyStr(dnm[0:len(dnm)]))
	}
	return names
}

// Read returns the file's bytes, or an empty slice on any error.
func (p @OsSourceProvider) Read(path *[]readonly char) @[]uint8 {
	return readFileBytes(path)
}

impl @OsSourceProvider : SourceProvider
