package "pkg/binate/loader"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// memBytes copies a readonly string into an owned byte buffer (the provider serves
// bytes).
func memBytes(s *[]readonly char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

// MemProvider is an in-memory SourceProvider serving a single .bn-only package —
// no filesystem access.  Stat reports every path as a directory (the loader only
// stats the impl dir here, since no bni path is set); List returns the one source
// file; Read returns its bytes regardless of path.
type MemProvider struct {
	src @[]uint8
}

func (p @MemProvider) Stat(path *[]readonly char) (bool, bool) {
	return true, true
}

func (p @MemProvider) List(dir *[]readonly char) @[]@[]char {
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr("foo.bn"))
	return names
}

func (p @MemProvider) Read(path *[]readonly char) @[]uint8 {
	return p.src
}

impl @MemProvider : SourceProvider

// The loader loads a package entirely from an injected in-memory provider (no
// filesystem), demonstrating the SourceProvider seam: a host can serve source from
// anywhere by replacing Loader.Provider before loading.
func TestSourceProviderInMemory() testing.TestResult {
	var l @Loader = NewLoader()
	l.AddImplPath("/mem")
	var prov @MemProvider = make(MemProvider)
	prov.src = memBytes("package \"pkg/foo\"\nfunc Foo() int { return 42 }\n")
	l.Provider = prov
	l.loadPackage("pkg/foo")
	if len(l.Errors) > 0 { return fail(l.Errors[0]) }
	var pkg @Package = l.GetPackage("pkg/foo")
	if pkg == nil { return fail("the package should load from the in-memory provider") }
	return ""
}

// NewLoader installs the os-backed default provider (so existing callers are
// unaffected).
func TestNewLoaderInstallsOsProvider() testing.TestResult {
	var l @Loader = NewLoader()
	if !present(l.Provider) { return fail("NewLoader should install a default SourceProvider") }
	return ""
}
