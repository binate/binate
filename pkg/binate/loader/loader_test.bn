package "pkg/binate/loader"

import "pkg/builtins/testing"
import "pkg/stdx/slices"

// ============================================================
// Helpers
// ============================================================

func seq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) == 0 && len(b) == 0 { return true }
	if len(a) == 0 || len(b) == 0 { return false }
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

func fail(msg @[]char) testing.TestResult {
	return msg
}

// ============================================================
// streq tests
// ============================================================

func TestStreqEqual() testing.TestResult {
	if !streq("hello", "hello") { return fail("equal strings should match") }
	return ""
}

func TestStreqDifferent() testing.TestResult {
	if streq("hello", "world") { return fail("different strings should not match") }
	return ""
}

func TestStreqDifferentLength() testing.TestResult {
	if streq("hi", "hello") { return fail("different length strings should not match") }
	return ""
}

func TestStreqEmpty() testing.TestResult {
	if !streq("", "") { return fail("empty strings should match") }
	return ""
}

func TestStreqNilNil() testing.TestResult {
	var a *[]readonly char
	var b *[]readonly char
	if !streq(a, b) { return fail("nil/nil should match") }
	return ""
}

func TestStreqNilNonNil() testing.TestResult {
	var a *[]readonly char
	if streq(a, "hello") { return fail("nil vs non-nil should not match") }
	if streq("hello", a) { return fail("non-nil vs nil should not match") }
	return ""
}

// ============================================================
// pathJoin string building tests (replaces appendStr tests)
// ============================================================

func TestPathJoinBuild() testing.TestResult {
	var r @[]char = pathJoin("hello", "world")
	if !seq(r, "hello/world") { return fail("pathJoin build wrong") }
	return ""
}

// ============================================================
// hasSuffix tests
// ============================================================

func TestHasSuffixMatch() testing.TestResult {
	if !hasSuffix("hello.bn", ".bn") { return fail("should match .bn suffix") }
	return ""
}

func TestHasSuffixNoMatch() testing.TestResult {
	if hasSuffix("hello.go", ".bn") { return fail("should not match .bn suffix") }
	return ""
}

func TestHasSuffixEmpty() testing.TestResult {
	if !hasSuffix("anything", "") { return fail("empty suffix should always match") }
	return ""
}

func TestHasSuffixTooLong() testing.TestResult {
	if hasSuffix("hi", "hello") { return fail("suffix longer than string should not match") }
	return ""
}

// ============================================================
// pathJoin tests
// ============================================================

func TestPathJoin() testing.TestResult {
	var r @[]char = pathJoin("foo", "bar")
	if !seq(r, "foo/bar") { return fail("pathJoin should join with /") }
	return ""
}

func TestPathJoinNested() testing.TestResult {
	var r @[]char = pathJoin("a/b", "c.bn")
	if !seq(r, "a/b/c.bn") { return fail("pathJoin nested wrong") }
	return ""
}

// ============================================================
// unquote tests
// ============================================================

func TestUnquoteQuoted() testing.TestResult {
	// bnlint:allow managed-to-raw-assign - sub-slice view of an immortal string literal
	var r *[]readonly char = unquote("\"pkg/binate/ast\"")
	if !seq(r, "pkg/binate/ast") { return fail("unquote should strip quotes") }
	return ""
}

func TestUnquoteUnquoted() testing.TestResult {
	// bnlint:allow managed-to-raw-assign - sub-slice view of an immortal string literal
	var r *[]readonly char = unquote("plain")
	if !seq(r, "plain") { return fail("unquote should pass through unquoted") }
	return ""
}

func TestUnquoteEmpty() testing.TestResult {
	// bnlint:allow managed-to-raw-assign - sub-slice view of an immortal string literal
	var r *[]readonly char = unquote("")
	if !seq(r, "") { return fail("unquote empty should return empty") }
	return ""
}

func TestUnquoteEmptyQuoted() testing.TestResult {
	// bnlint:allow managed-to-raw-assign - sub-slice view of an immortal string literal
	var r *[]readonly char = unquote("\"\"")
	if len(r) != 0 { return fail("unquote empty quotes should return empty") }
	return ""
}

// ============================================================
// containsStr tests
// ============================================================

func TestContainsStrFound() testing.TestResult {
	var ss @[]@[]char
	ss = slices.Append[@[]char](ss, "alpha")
	ss = slices.Append[@[]char](ss, "beta")
	ss = slices.Append[@[]char](ss, "gamma")
	if !containsStr(ss, "beta") { return fail("should find beta") }
	return ""
}

func TestContainsStrNotFound() testing.TestResult {
	var ss @[]@[]char
	ss = slices.Append[@[]char](ss, "alpha")
	ss = slices.Append[@[]char](ss, "beta")
	if containsStr(ss, "gamma") { return fail("should not find gamma") }
	return ""
}

func TestContainsStrNil() testing.TestResult {
	var ss @[]@[]char
	if containsStr(ss, "anything") { return fail("nil slice should not contain anything") }
	return ""
}

// ============================================================
// sortStrings tests
// ============================================================

func TestSortStrings() testing.TestResult {
	var ss @[]@[]char = @[]@[]char{"cherry", "apple", "banana"}
	sortStrings(ss)
	if !seq(ss[0], "apple") { return fail("first should be apple") }
	if !seq(ss[1], "banana") { return fail("second should be banana") }
	if !seq(ss[2], "cherry") { return fail("third should be cherry") }
	return ""
}

func TestSortStringsSingle() testing.TestResult {
	var ss @[]@[]char = @[]@[]char{"only"}
	sortStrings(ss)
	if !seq(ss[0], "only") { return fail("single element sort wrong") }
	return ""
}

// ============================================================
// strLess tests
// ============================================================

func TestStrLessTrue() testing.TestResult {
	if !strLess("apple", "banana") { return fail("apple < banana") }
	return ""
}

func TestStrLessFalse() testing.TestResult {
	if strLess("banana", "apple") { return fail("banana not < apple") }
	return ""
}

func TestStrLessEqual() testing.TestResult {
	if strLess("same", "same") { return fail("equal strings not less") }
	return ""
}

func TestStrLessPrefix() testing.TestResult {
	if !strLess("ab", "abc") { return fail("ab < abc") }
	if strLess("abc", "ab") { return fail("abc not < ab") }
	return ""
}

// ============================================================
// NewLoader tests
// ============================================================

func TestNewLoader() testing.TestResult {
	var l @Loader = NewLoader()
	if l == nil { return fail("loader should not be nil") }
	if len(l.Packages) != 0 { return fail("Packages should be empty") }
	if len(l.Order) != 0 { return fail("Order should be empty") }
	if len(l.Errors) != 0 { return fail("Errors should be empty") }
	// A fresh loader has no search paths; the host adds them.
	if len(l.BniPath) != 0 { return fail("BniPath should be empty") }
	if len(l.ImplPath) != 0 { return fail("ImplPath should be empty") }
	return ""
}

// ============================================================
// AddBniPath / AddImplPath tests
// ============================================================

func TestAddBniPathOnly() testing.TestResult {
	var l @Loader = NewLoader()
	l.AddBniPath("/bni-only")
	if len(l.BniPath) != 1 { return fail("BniPath should have 1 entry") }
	if !seq(l.BniPath[0], "/bni-only") { return fail("BniPath[0] wrong") }
	if len(l.ImplPath) != 0 { return fail("ImplPath should still be empty") }
	return ""
}

func TestAddImplPathOnly() testing.TestResult {
	var l @Loader = NewLoader()
	l.AddImplPath("/impl-only")
	if len(l.ImplPath) != 1 { return fail("ImplPath should have 1 entry") }
	if !seq(l.ImplPath[0], "/impl-only") { return fail("ImplPath[0] wrong") }
	if len(l.BniPath) != 0 { return fail("BniPath should still be empty") }
	return ""
}

func TestAddBniPathDedup() testing.TestResult {
	var l @Loader = NewLoader()
	l.AddBniPath("/a")
	l.AddBniPath("/a")
	if len(l.BniPath) != 1 { return fail("BniPath dup not skipped") }
	return ""
}

func TestAddImplPathDedup() testing.TestResult {
	var l @Loader = NewLoader()
	l.AddImplPath("/a")
	l.AddImplPath("/a")
	if len(l.ImplPath) != 1 { return fail("ImplPath dup not skipped") }
	return ""
}

func TestAddImplPathFrontPrepends() testing.TestResult {
	var l @Loader = NewLoader()
	l.AddImplPath("/base")
	l.AddImplPath("/cli")
	l.AddImplPathFront("/target-override")
	if len(l.ImplPath) != 3 { return fail("ImplPath should have 3 entries") }
	if !seq(l.ImplPath[0], "/target-override") {
		return fail("ImplPath[0] should be the target override")
	}
	if !seq(l.ImplPath[1], "/base") { return fail("ImplPath[1] wrong") }
	if !seq(l.ImplPath[2], "/cli") { return fail("ImplPath[2] wrong") }
	return ""
}

func TestAddImplPathFrontDedup() testing.TestResult {
	var l @Loader = NewLoader()
	l.AddImplPath("/a")
	l.AddImplPathFront("/a")
	if len(l.ImplPath) != 1 { return fail("ImplPath dup not skipped") }
	if !seq(l.ImplPath[0], "/a") { return fail("ImplPath[0] wrong") }
	return ""
}

func TestAddBniPathFrontPrepends() testing.TestResult {
	var l @Loader = NewLoader()
	l.AddBniPath("/base")
	l.AddBniPath("/cli")
	l.AddBniPathFront("/target-override")
	if len(l.BniPath) != 3 { return fail("BniPath should have 3 entries") }
	if !seq(l.BniPath[0], "/target-override") {
		return fail("BniPath[0] should be the target override")
	}
	if !seq(l.BniPath[1], "/base") { return fail("BniPath[1] wrong") }
	if !seq(l.BniPath[2], "/cli") { return fail("BniPath[2] wrong") }
	return ""
}

func TestAddBniPathFrontDedup() testing.TestResult {
	var l @Loader = NewLoader()
	l.AddBniPath("/a")
	l.AddBniPathFront("/a")
	if len(l.BniPath) != 1 { return fail("BniPath dup not skipped") }
	if !seq(l.BniPath[0], "/a") { return fail("BniPath[0] wrong") }
	return ""
}

func TestAddImplPathFrontBeforeBase() testing.TestResult {
	// Pin "prepend wins over an earlier-added entry" — the scenario
	// applyPathFlags uses for --target arm32-baremetal, where
	// runtime/baremetal_arm32 needs to outrank the project's base impl
	// dir in the impl-path's first-match-wins lookup.
	var l @Loader = NewLoader()
	l.AddImplPath("/base")
	l.AddImplPathFront("/target-override")
	if len(l.ImplPath) != 2 { return fail("ImplPath should have 2 entries") }
	if !seq(l.ImplPath[0], "/target-override") {
		return fail("target override should be first")
	}
	if !seq(l.ImplPath[1], "/base") { return fail("base should be second") }
	return ""
}

// ============================================================
// GetPackage tests
// ============================================================

func TestGetPackageNotFound() testing.TestResult {
	var l @Loader = NewLoader()
	var pkg @Package = l.GetPackage("nonexistent")
	if pkg != nil { return fail("should return nil for missing package") }
	return ""
}

// ============================================================
// loadingStack (import-cycle detection) tests
// ============================================================

func TestLoadingStackPushPop() testing.TestResult {
	var l @Loader = NewLoader()
	if l.isLoading("pkg/a") { return fail("fresh loader should have nothing loading") }
	l.pushLoading("pkg/a")
	l.pushLoading("pkg/b")
	if !l.isLoading("pkg/a") { return fail("pkg/a should be loading") }
	if !l.isLoading("pkg/b") { return fail("pkg/b should be loading") }
	l.popLoading("pkg/b")
	if l.isLoading("pkg/b") { return fail("pkg/b should be popped") }
	if !l.isLoading("pkg/a") { return fail("pkg/a should still be loading") }
	l.popLoading("pkg/a")
	if l.isLoading("pkg/a") { return fail("pkg/a should be popped") }
	if len(l.loadingStack) != 0 { return fail("stack should be empty after balanced pops") }
	return ""
}

func TestLoadingStackPopLastOccurrence() testing.TestResult {
	// popLoading removes only the LAST occurrence, so a path entered
	// twice stays "loading" until both pushes are balanced.
	var l @Loader = NewLoader()
	l.pushLoading("pkg/a")
	l.pushLoading("pkg/a")
	l.popLoading("pkg/a")
	if !l.isLoading("pkg/a") { return fail("one occurrence should remain") }
	l.popLoading("pkg/a")
	if l.isLoading("pkg/a") { return fail("both occurrences should be gone") }
	return ""
}

func TestLoaderLoadingStackIsolation() testing.TestResult {
	// Per-instance loadingStack: a path left in-flight on one Loader
	// (e.g. an error path that skipped its pop) must NOT make a second
	// Loader see a phantom import cycle.  This is the reentrancy
	// guarantee a process-global stack could not provide.
	var a @Loader = NewLoader()
	a.pushLoading("pkg/x")
	var b @Loader = NewLoader()
	if b.isLoading("pkg/x") {
		return fail("second loader must not see the first loader's in-flight load")
	}
	return ""
}
