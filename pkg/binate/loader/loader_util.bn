package "pkg/binate/loader"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/os"
import "pkg/std/strings"
import "pkg/stdx/slices"

// ============================================================
// Helpers
// ============================================================

// streq returns true if two char slices have identical content.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) == 0 && len(b) == 0 { return true }
	if len(a) == 0 || len(b) == 0 { return false }
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// hasSuffix reports whether s ends with the given suffix.
func hasSuffix(s *[]readonly char, suffix *[]readonly char) bool {
	if len(suffix) > len(s) { return false }
	var off int = len(s) - len(suffix)
	for i := 0; i < len(suffix); i++ {
		if s[off + i] != suffix[i] { return false }
	}
	return true
}

// pathJoin concatenates two path segments with a '/' separator.
func pathJoin(a *[]readonly char, b *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(a)
	cb.WriteByte('/')
	cb.Write(b)
	return buf.CopyStr(cb.String())
}

// unquote strips surrounding double quotes from a string, if present.
func unquote(s @[]char) @[]char {
	if len(s) >= 2 && s[0] == '"' && s[len(s) - 1] == '"' {
		return s[1:len(s) - 1]
	}
	return s
}

// readFileBytes reads an entire file into a byte slice.
func readFileBytes(path *[]readonly char) @[]uint8 {
	f, oerr := os.Open(path)
	if present(oerr) {
		var empty @[]uint8
		return empty
	}
	var cap int = 4096
	var result @[]uint8 = make_slice(uint8, cap)
	var total int = 0
	var tmp @[]uint8 = make_slice(uint8, 4096)
	for {
		n, _ := f.Read(tmp)
		if n <= 0 { break }
		// Grow geometrically if needed
		for total + n > cap {
			var newCap int = cap * 2
			var newBuf @[]uint8 = make_slice(uint8, newCap)
			for i := 0; i < total; i++ {
				newBuf[i] = result[i]
			}
			result = newBuf
			cap = newCap
		}
		for i := 0; i < n; i++ {
			result[total + i] = tmp[i]
		}
		total = total + n
	}
	_ = f.Close()
	if total == 0 {
		var empty @[]uint8
		return empty
	}
	return result[0:total]
}

// containsStr checks if a string is in a slice.
func containsStr(ss @[]@[]char, s *[]readonly char) bool {
	if len(ss) == 0 { return false }
	for i := 0; i < len(ss); i++ {
		if streq(ss[i], s) { return true }
	}
	return false
}

// recvBaseName returns the receiver's base named-type name for a method decl,
// walking the pointer/managed/const/paren wrappers to the underlying named
// type (mirroring the type-checker's resolveMethodReceiver).  Returns an empty
// slice for a free function (Recv == nil) or an unresolvable receiver.
func recvBaseName(d @ast.Decl) @[]char {
	var empty @[]char
	if d == nil || d.Recv == nil { return empty }
	var base @ast.TypeExpr = d.Recv.Type
	for base != nil {
		if base.Kind == ast.TEXPR_POINTER || base.Kind == ast.TEXPR_MANAGED ||
				base.Kind == ast.TEXPR_CONST || base.Kind == ast.TEXPR_PAREN {
			base = base.Base
		} else {
			break
		}
	}
	if base == nil { return empty }
	if base.Kind == ast.TEXPR_NAMED { return base.Name }
	if base.Kind == ast.TEXPR_INSTANTIATE && base.Base != nil && base.Base.Kind == ast.TEXPR_NAMED {
		// A generic-receiver method (`@Box[T]`): key by the generic base name
		// (`Box`), NOT the empty string — else two DIFFERENT generic types'
		// same-named methods (Box[T].Get, Bag[T].Get) collapse to streq("","")
		// and false-match in sameFuncDecl, wrongly pairing (and dropping) an
		// unrelated method during .bni↔.bn merge.
		return base.Base.Name
	}
	return empty
}

// recvIsGenericInst reports whether d is a method whose receiver names a
// generic-type instantiation (`func (b @Box[T]) Get()`), peeling the pointer/
// managed/const/paren wrappers to a TEXPR_INSTANTIATE base.  Such a method
// carries its body in the .bni (like a generic function, so a cross-package
// consumer can monomorphize it) but has EMPTY decl-level TypeParams — so the
// .bni→merged inclusion test in MergeBniInto must special-case it, else the
// body-carrying decl is dropped and the consumer can't emit it.
func recvIsGenericInst(d @ast.Decl) bool {
	if d == nil || d.Recv == nil { return false }
	var base @ast.TypeExpr = d.Recv.Type
	for base != nil {
		if base.Kind == ast.TEXPR_POINTER || base.Kind == ast.TEXPR_MANAGED ||
				base.Kind == ast.TEXPR_CONST || base.Kind == ast.TEXPR_PAREN {
			base = base.Base
		} else {
			break
		}
	}
	return base != nil && base.Kind == ast.TEXPR_INSTANTIATE
}

// sameFuncDecl reports whether two DECL_FUNC decls denote the same function:
// both free functions with the same name, or both methods with the same name
// AND the same receiver base type.  Pairing a .bni func declaration with its
// .bn definition by NAME ALONE would let a free function and a same-named
// method (e.g. os.Stat + File.Stat), or two methods of the same name on
// different types, match each other — marking the wrong decl exported or
// resolving the wrong impl.
func sameFuncDecl(a @ast.Decl, b @ast.Decl) bool {
	if a == nil || b == nil { return false }
	if !streq(a.Name, b.Name) { return false }
	var aMethod bool = a.Recv != nil
	var bMethod bool = b.Recv != nil
	if aMethod != bMethod { return false }
	if !aMethod { return true }
	return streq(recvBaseName(a), recvBaseName(b))
}

// markBniExportedFuncs sets Exported = true on every merged DECL_FUNC whose
// name is declared as a function in the package's .bni.  In Binate the
// exported surface is the .bni interface, not identifier capitalization, so a
// function is exported exactly when its signature appears in the .bni.  The
// caller runs this AFTER prepending the .bni's pure-extern / generic func
// decls into merged.Decls, so those are marked here too (a prepended decl's
// name matches its own .bni entry).  B0 of
// plan-package-introspection-phase-b.md consumes the flag (via
// ir.Func.Exported) to emit one func-value table entry per exported function.
func markBniExportedFuncs(bniFile @ast.File, merged @ast.File) {
	if bniFile == nil || merged == nil {
		return
	}
	for j := 0; j < len(bniFile.Decls); j++ {
		var d @ast.Decl = bniFile.Decls[j]
		if d.Kind != ast.DECL_FUNC {
			continue
		}
		for k := 0; k < len(merged.Decls); k++ {
			if merged.Decls[k].Kind == ast.DECL_FUNC && sameFuncDecl(merged.Decls[k], d) {
				merged.Decls[k].Exported = true
				break
			}
		}
	}
}

// markBniExportedVars is the package-level-`var` counterpart to
// markBniExportedFuncs: it sets Exported = true on every merged DECL_VAR whose
// name is declared in the package's .bni.  `.bni` membership is the export
// signal; the reflect descriptor's exported-global table — and the cross-mode
// global injection that consumes it (RegisterPackageGlobals) — keys off the
// flag (carried onto ir.Global.Exported).
func markBniExportedVars(bniFile @ast.File, merged @ast.File) {
	if bniFile == nil || merged == nil {
		return
	}
	for j := 0; j < len(bniFile.Decls); j++ {
		markBniExportedVarDecl(bniFile.Decls[j], merged)
	}
}

// markBniExportedVarDecl marks the merged-file var matching `.bni` decl `d`
// exported — recursing a `var ( ... )` group so grouped exported vars (whose
// members live in a group, not a top-level decl) are marked too.
func markBniExportedVarDecl(d @ast.Decl, merged @ast.File) {
	if d.Kind == ast.DECL_GROUP {
		for i := 0; i < len(d.Decls); i++ {
			markBniExportedVarDecl(d.Decls[i], merged)
		}
		return
	}
	if d.Kind != ast.DECL_VAR {
		return
	}
	markMergedVarExported(merged, d.Name)
}

// markMergedVarExported sets Exported on the merged-file var named `name`,
// searching both top-level `DECL_VAR` and `var ( ... )` group members (a
// grouped exported var's storage lives in the .bn's grouped definition).
func markMergedVarExported(merged @ast.File, name *[]readonly char) {
	for k := 0; k < len(merged.Decls); k++ {
		var md @ast.Decl = merged.Decls[k]
		if md.Kind == ast.DECL_VAR && streq(md.Name, name) {
			md.Exported = true
			return
		}
		if md.Kind == ast.DECL_GROUP {
			for i := 0; i < len(md.Decls); i++ {
				if md.Decls[i].Kind == ast.DECL_VAR && streq(md.Decls[i].Name, name) {
					md.Decls[i].Exported = true
					return
				}
			}
		}
	}
}

// isVarGroup reports whether a DECL_GROUP is a `var ( ... )` group (its members
// are DECL_VAR).  Groups are homogeneous, so the first member's kind decides;
// an empty group is treated as non-var (nothing to exclude).
func isVarGroup(d @ast.Decl) bool {
	if len(d.Decls) == 0 {
		return false
	}
	return d.Decls[0].Kind == ast.DECL_VAR
}

// ============================================================
// Import-cycle detection (the per-Loader loading stack)
// ============================================================

// isLoading checks whether a package is currently on the loading stack (cycle detection).
func (l @Loader) isLoading(path @[]char) bool {
	if len(l.loadingStack) == 0 { return false }
	for i := 0; i < len(l.loadingStack); i++ {
		if streq(l.loadingStack[i], path) { return true }
	}
	return false
}

// pushLoading adds a package path to the loading stack.
func (l @Loader) pushLoading(path @[]char) {
	l.loadingStack = slices.Append[@[]char](l.loadingStack, path)
}

// popLoading removes the last occurrence of a package path from the loading stack.
func (l @Loader) popLoading(path @[]char) {
	// Remove last occurrence
	if len(l.loadingStack) == 0 { return }
	var newStack @[]@[]char
	var found bool = false
	for i := len(l.loadingStack) - 1; i >= 0; i-- {
		if streq(l.loadingStack[i], path) && !found {
			found = true
		} else {
			newStack = slices.Append[@[]char](newStack, l.loadingStack[i])
		}
	}
	// Reverse
	var reversed @[]@[]char
	for i := len(newStack) - 1; i >= 0; i-- {
		reversed = slices.Append[@[]char](reversed, newStack[i])
	}
	l.loadingStack = reversed
}

// cycleErrorMsg builds an "import cycle: A -> B -> ... -> X" message from the
// packages currently on the loading stack plus `cyclic`, the import that closes
// the cycle (it is the same package as the first stack entry the chain leads
// back to).
func (l @Loader) cycleErrorMsg(cyclic @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("import cycle: ")
	for i := 0; i < len(l.loadingStack); i++ {
		cb.Write(l.loadingStack[i])
		cb.Write(" -> ")
	}
	cb.Write(cyclic)
	return buf.CopyStr(cb.String())
}
