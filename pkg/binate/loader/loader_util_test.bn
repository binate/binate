package "pkg/binate/loader"

import "pkg/binate/ast"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for the helpers in loader_util.bn — pure
// string/path/byte-slice utilities used by the Loader. The
// readFileBytes helper isn't directly unit-testable without
// touching the filesystem; it's covered end-to-end by the existing
// loader_test.bn cases that load real packages.

func TestStreqMatches() testing.TestResult {
	if !streq("hello", "hello") {
		return "equal strings should compare equal"
	}
	if !streq("", "") {
		return "two empty strings should compare equal"
	}
	if streq("hello", "world") {
		return "different content should compare unequal"
	}
	if streq("abc", "ab") {
		return "different lengths should compare unequal"
	}
	if streq("a", "") {
		return "empty vs non-empty should compare unequal"
	}
	return ""
}

func TestHasSuffix() testing.TestResult {
	if !hasSuffix("hello.bn", ".bn") {
		return "hello.bn should have suffix .bn"
	}
	if !hasSuffix("foo", "foo") {
		return "exact match should be a suffix"
	}
	if !hasSuffix("anything", "") {
		return "empty suffix should match"
	}
	if hasSuffix("foo", "longer") {
		return "longer suffix should not match a shorter string"
	}
	if hasSuffix("hello.bni", ".bn") {
		return "hello.bni should NOT match suffix .bn (extra char)"
	}
	return ""
}

func TestPathJoinBasic() testing.TestResult {
	var r1 @[]char = pathJoin("a", "b")
	if !streq(r1, "a/b") {
		return "pathJoin('a', 'b') should be 'a/b'"
	}
	var r2 @[]char = pathJoin("/abs/path", "file.bn")
	if !streq(r2, "/abs/path/file.bn") {
		return "absolute + relative should join with /"
	}
	return ""
}

func TestUnquote() testing.TestResult {
	if !streq(unquote("\"hello\""), "hello") {
		return "quoted string should be unquoted"
	}
	if !streq(unquote("hello"), "hello") {
		return "unquoted string should pass through"
	}
	if !streq(unquote("\"\""), "") {
		return "empty quoted string should become empty"
	}
	if !streq(unquote("\""), "\"") {
		return "single quote (len 1) shouldn't strip"
	}
	return ""
}

func TestContainsStr() testing.TestResult {
	var ss @[]@[]char = @[]@[]char{"alpha", "beta", "gamma"}
	if !containsStr(ss, "beta") {
		return "containsStr should find 'beta'"
	}
	if containsStr(ss, "delta") {
		return "containsStr should NOT find 'delta'"
	}
	var empty @[]@[]char
	if containsStr(empty, "x") {
		return "containsStr on empty slice should return false"
	}
	return ""
}

// mkFuncDecl builds a DECL_FUNC ast.Decl with the given name.
func mkFuncDecl(name @[]char) @ast.Decl {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = name
	return d
}

// mkVarMember builds a DECL_VAR ast.Decl named `name` (a group member or a
// top-level var).
func mkVarMember(name @[]char) @ast.Decl {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_VAR
	d.Name = name
	return d
}

// mkVarGroup2 builds a `var ( a; b )` DECL_GROUP of two DECL_VAR members.
func mkVarGroup2(a @[]char, b @[]char) @ast.Decl {
	var g @ast.Decl = make(ast.Decl)
	g.Kind = ast.DECL_GROUP
	g.Decls = slices.Append[@ast.Decl](g.Decls, mkVarMember(a))
	g.Decls = slices.Append[@ast.Decl](g.Decls, mkVarMember(b))
	return g
}

// isVarGroup distinguishes a `var ( ... )` group (excluded from the .bni-decl
// prepend, since its members are externs) from const/type groups.
func TestIsVarGroup() testing.TestResult {
	if !isVarGroup(mkVarGroup2("A", "B")) {
		return "a var group should be recognized"
	}
	var constGrp @ast.Decl = make(ast.Decl)
	constGrp.Kind = ast.DECL_GROUP
	var c @ast.Decl = make(ast.Decl)
	c.Kind = ast.DECL_CONST
	c.Name = "C"
	constGrp.Decls = slices.Append[@ast.Decl](constGrp.Decls, c)
	if isVarGroup(constGrp) {
		return "a const group must not be a var group"
	}
	var empty @ast.Decl = make(ast.Decl)
	empty.Kind = ast.DECL_GROUP
	if isVarGroup(empty) {
		return "an empty group is not a var group"
	}
	return ""
}

// markBniExportedVars marks a GROUPED exported var: its member lives in a
// `var ( ... )` group in both the .bni and the merged .bn, so the recursion
// must reach it (a flat top-level scan would miss it).
func TestMarkBniExportedGroupedVars() testing.TestResult {
	var bni @ast.File = make(ast.File)
	bni.Decls = slices.Append[@ast.Decl](bni.Decls, mkVarGroup2("X", "Y"))

	var x @ast.Decl = mkVarMember("X")
	var y @ast.Decl = mkVarMember("Y")
	var mGrp @ast.Decl = make(ast.Decl)
	mGrp.Kind = ast.DECL_GROUP
	mGrp.Decls = slices.Append[@ast.Decl](mGrp.Decls, x)
	mGrp.Decls = slices.Append[@ast.Decl](mGrp.Decls, y)
	var merged @ast.File = make(ast.File)
	merged.Decls = slices.Append[@ast.Decl](merged.Decls, mGrp)

	markBniExportedVars(bni, merged)
	if !x.Exported || !y.Exported {
		return "grouped .bni-declared vars should be Exported in the merged group"
	}
	return ""
}

// A function declared in the .bni is exported; a merged-only function
// (no .bni declaration) is not.  The lowercase "format" entry IS exported
// because it is declared in the .bni — pinning that exports are the .bni
// surface, NOT identifier capitalization.
func TestMarkBniExportedFuncs() testing.TestResult {
	var bniDecls @[]@ast.Decl
	bniDecls = slices.Append[@ast.Decl](bniDecls, mkFuncDecl("Open"))
	bniDecls = slices.Append[@ast.Decl](bniDecls, mkFuncDecl("format"))
	var bniTy @ast.Decl = make(ast.Decl)
	bniTy.Kind = ast.DECL_TYPE
	bniTy.Name = "format" // a type sharing a name must not mark a func
	bniDecls = slices.Append[@ast.Decl](bniDecls, bniTy)
	var bni @ast.File = make(ast.File)
	bni.Decls = bniDecls

	var mDecls @[]@ast.Decl
	var open @ast.Decl = mkFuncDecl("Open")
	var format @ast.Decl = mkFuncDecl("format")
	var helper @ast.Decl = mkFuncDecl("helper") // local, not in .bni
	mDecls = slices.Append[@ast.Decl](mDecls, open)
	mDecls = slices.Append[@ast.Decl](mDecls, format)
	mDecls = slices.Append[@ast.Decl](mDecls, helper)
	var merged @ast.File = make(ast.File)
	merged.Decls = mDecls

	markBniExportedFuncs(bni, merged)

	if !open.Exported {
		return ".bni-declared func should be Exported"
	}
	if !format.Exported {
		return "lowercase .bni-declared func should be Exported (exports are the .bni surface)"
	}
	if helper.Exported {
		return "merged-only func (not in .bni) must NOT be Exported"
	}
	return ""
}

// For an all-`.bni` package (no `.bn` impl, e.g. a generics library whose
// bodies live in the `.bni`), the loader uses the `.bni` file itself as the
// merged file and must still mark its exported surface.  markBniExportedFuncs
// is called with merged === bniFile in that path, so verify the self-marking
// case: every `.bni`-declared func is marked Exported.  Guards the loader bug
// where an all-`.bni` package skipped this marking, leaving its public API
// Exported = false so bnlint's unused-func flagged it as dead.
func TestMarkBniExportedFuncsBniOnly() testing.TestResult {
	var bniDecls @[]@ast.Decl
	var newf @ast.Decl = mkFuncDecl("New")
	newf.FromBNI = true
	var pushf @ast.Decl = mkFuncDecl("Push")
	pushf.FromBNI = true
	bniDecls = slices.Append[@ast.Decl](bniDecls, newf)
	bniDecls = slices.Append[@ast.Decl](bniDecls, pushf)
	var bni @ast.File = make(ast.File)
	bni.Decls = bniDecls

	// The all-`.bni` merged file IS the .bni file — mark it against itself.
	markBniExportedFuncs(bni, bni)

	if !newf.Exported || !pushf.Exported {
		return "all-.bni package funcs should be marked Exported (self-merge)"
	}
	return ""
}

// mkMethodDecl builds a DECL_FUNC ast.Decl for a method `(r *RecvType) name()`.
func mkMethodDecl(name @[]char, recvType @[]char) @ast.Decl {
	var named @ast.TypeExpr = make(ast.TypeExpr)
	named.Kind = ast.TEXPR_NAMED
	named.Name = recvType
	var ptr @ast.TypeExpr = make(ast.TypeExpr)
	ptr.Kind = ast.TEXPR_POINTER
	ptr.Base = named
	var recv @ast.ParamDecl = make(ast.ParamDecl)
	recv.Name = "r"
	recv.Type = ptr
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = name
	d.Recv = recv
	return d
}

// sameFuncDecl pairs a .bni func decl with its .bn definition.  It must treat a
// free function and a same-named method as DISTINCT, and two same-named methods
// on different receiver types as distinct — otherwise the os.Stat + File.Stat
// pattern (a free func and a same-named method) mis-pairs.
func TestSameFuncDecl() testing.TestResult {
	if !sameFuncDecl(mkFuncDecl("Stat"), mkFuncDecl("Stat")) {
		return "two free funcs named Stat should match"
	}
	if sameFuncDecl(mkFuncDecl("Stat"), mkFuncDecl("Open")) {
		return "free funcs with different names should not match"
	}
	if sameFuncDecl(mkFuncDecl("Stat"), mkMethodDecl("Stat", "File")) {
		return "a free func and a same-named method must NOT match"
	}
	if !sameFuncDecl(mkMethodDecl("Stat", "File"), mkMethodDecl("Stat", "File")) {
		return "methods with same name and receiver should match"
	}
	if sameFuncDecl(mkMethodDecl("Foo", "A"), mkMethodDecl("Foo", "B")) {
		return "methods of the same name on different receivers must NOT match"
	}
	return ""
}

// A .bni declaring BOTH a free function and a same-named method (os.Stat +
// File.Stat) must mark BOTH merged decls Exported.  Name-only matching marks
// only the first "Stat" and silently drops the other from the reflect table.
func TestMarkBniExportedFuncsFreeAndMethodSameName() testing.TestResult {
	var bniDecls @[]@ast.Decl
	bniDecls = slices.Append[@ast.Decl](bniDecls, mkFuncDecl("Stat"))
	bniDecls = slices.Append[@ast.Decl](bniDecls, mkMethodDecl("Stat", "File"))
	var bni @ast.File = make(ast.File)
	bni.Decls = bniDecls

	var freeStat @ast.Decl = mkFuncDecl("Stat")
	var methodStat @ast.Decl = mkMethodDecl("Stat", "File")
	var mDecls @[]@ast.Decl
	mDecls = slices.Append[@ast.Decl](mDecls, freeStat)
	mDecls = slices.Append[@ast.Decl](mDecls, methodStat)
	var merged @ast.File = make(ast.File)
	merged.Decls = mDecls

	markBniExportedFuncs(bni, merged)

	if !freeStat.Exported {
		return "free Stat should be Exported"
	}
	if !methodStat.Exported {
		return "method (r *File) Stat should be Exported (name-only match would miss it)"
	}
	return ""
}

// Two same-named methods on different receiver types must each be marked
// against their OWN merged decl, not whichever appears first.
func TestMarkBniExportedFuncsMethodDifferentReceivers() testing.TestResult {
	var bniDecls @[]@ast.Decl
	bniDecls = slices.Append[@ast.Decl](bniDecls, mkMethodDecl("Foo", "A"))
	bniDecls = slices.Append[@ast.Decl](bniDecls, mkMethodDecl("Foo", "B"))
	var bni @ast.File = make(ast.File)
	bni.Decls = bniDecls

	var fooA @ast.Decl = mkMethodDecl("Foo", "A")
	var fooB @ast.Decl = mkMethodDecl("Foo", "B")
	var mDecls @[]@ast.Decl
	mDecls = slices.Append[@ast.Decl](mDecls, fooA)
	mDecls = slices.Append[@ast.Decl](mDecls, fooB)
	var merged @ast.File = make(ast.File)
	merged.Decls = mDecls

	markBniExportedFuncs(bni, merged)

	if !fooA.Exported || !fooB.Exported {
		return "both same-named methods on different types should be Exported"
	}
	return ""
}

// markBniExportedFuncs must be nil-safe on either argument.
func TestMarkBniExportedFuncsNilSafe() testing.TestResult {
	var empty @ast.File
	var f @ast.File = make(ast.File)
	markBniExportedFuncs(empty, empty)
	markBniExportedFuncs(empty, f)
	markBniExportedFuncs(f, empty)
	return ""
}

// recvIsGenericInst detects a method whose receiver is a generic-type
// instantiation (`@Box[T]`) — such a method carries its body in the .bni and
// must be retained by the .bni→merged inclusion despite having empty TypeParams.
func TestRecvIsGenericInst() testing.TestResult {
	if recvIsGenericInst(mkMethodDecl("Stat", "File")) {
		return "plain-receiver method should not be a generic instantiation"
	}
	if recvIsGenericInst(mkFuncDecl("Sum")) {
		return "free function should not be a generic instantiation"
	}
	var head @ast.TypeExpr = make(ast.TypeExpr)
	head.Kind = ast.TEXPR_NAMED
	head.Name = "Box"
	var inst @ast.TypeExpr = make(ast.TypeExpr)
	inst.Kind = ast.TEXPR_INSTANTIATE
	inst.Base = head
	var mgd @ast.TypeExpr = make(ast.TypeExpr)
	mgd.Kind = ast.TEXPR_MANAGED
	mgd.Base = inst
	var recv @ast.ParamDecl = make(ast.ParamDecl)
	recv.Name = "b"
	recv.Type = mgd
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "Get"
	d.Recv = recv
	if !recvIsGenericInst(d) {
		return "generic-receiver method @Box[T] should be detected"
	}
	return ""
}
