// Package mangle provides symbol name mangling for Binate.
//
// The mangling scheme converts Binate names to linker symbols using
// the FULL package path so that two packages sharing a last-segment
// name (e.g. `pkg/asm/x64` and `pkg/native/x64`) produce distinct
// symbols.  Every `/` and `.` in the qualified name becomes `__`:
//
//   pkg "pkg/parser", func "parseExpr" → "bn_pkg__parser__parseExpr"
//   pkg "main", func "main"            → "bn_main__main"
//   pre-qualified "pkg/parser.New"     → "bn_pkg__parser__New"
//   method "pkg/geom.Point.M"          → "bn_pkg__geom__Point__M"
//
// Special case: source-level "main.__entry" (the synthetic entry
// wrapper that runs init + user main) → "bn_entry" — the C runtime's
// sole entry point into Binate.
package "pkg/binate/mangle"

import "pkg/binate/buf"

// PkgPathFromQuoted strips surrounding quotes from a quoted module
// name like `"pkg/foo"` → `pkg/foo`, preserving the full path.
func PkgPathFromQuoted(name *[]const char) @[]char

// FuncName returns the mangled symbol name for a function.
// pkgPath is the full package path; for pre-qualified names
// (containing a `.`), the package component is taken from the name.
func FuncName(pkgPath *[]const char, name *[]const char) buf.CharBuf

// QualifyName returns a dot-qualified name (`<pkgPath>.<name>`) for
// intra-package references. Names already containing a dot pass
// through unchanged. Used by the VM to key its flat function table
// without cross-package collisions.
func QualifyName(pkgPath *[]const char, name *[]const char) @[]char

// GlobalName returns the mangled symbol name for a global variable.
func GlobalName(pkgPath *[]const char, name *[]const char) buf.CharBuf

// StructName returns the mangled type name for a struct.
func StructName(pkgPath *[]const char, name *[]const char) buf.CharBuf
