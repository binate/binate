// Package mangle provides symbol name mangling for Binate — the
// length-prefix (invertible) scheme.  Every linker symbol is
// `bn_<kind><body>`; lengths self-delimit every variable-length
// component, so the scheme is injective and Demangle is its exact
// inverse.
//
//   FuncName / GlobalName / StructName parse a (pkgPath, name) pair into
//   a package path and a "."-split member chain, then emit bn_F / bn_G /
//   bn_S (a method is a 2-member chain), or bn_I / bn_T when the sole
//   member carries the `__bn_inst__` instantiation marker.
//
//   ImplVtableName / ImplVtableShimName build the `__ivt`/`__ivtshim`
//   decoration on a bn_V / bn_W core.
//
// Special case: source-level "main.__entry" → the reserved literal
// "bn_entry" — the C runtime's sole entry point into Binate.
package "pkg/binate/mangle"

import "pkg/std/strings"

// PkgPathFromQuoted strips surrounding quotes from a quoted module
// name like `"pkg/foo"` → `pkg/foo`, preserving the full path.
func PkgPathFromQuoted(name *[]readonly char) @[]char

// FuncName returns the mangled symbol name for a function.
// pkgPath is the full package path; for pre-qualified names
// (containing a `.`), the package component is taken from the name.
func FuncName(pkgPath *[]readonly char, name *[]readonly char) @[]char

// QualifyName returns a dot-qualified name (`<pkgPath>.<name>`) for
// intra-package references. Names already containing a dot pass
// through unchanged. Used by the VM to key its flat function table
// without cross-package collisions.
func QualifyName(pkgPath *[]readonly char, name *[]readonly char) @[]char

// GlobalName returns the mangled symbol name for a global variable.
func GlobalName(pkgPath *[]readonly char, name *[]readonly char) @[]char

// StructName returns the mangled type name for a struct.
func StructName(pkgPath *[]readonly char, name *[]readonly char) @[]char

// IsInstantiationName reports whether an IR-level name carries the
// `__bn_inst__` marker (a monomorphized generic instantiation).  The
// single source for the marker check codegen and the native descriptor use
// to exclude instantiation impls from by-name vtable injection.
func IsInstantiationName(name *[]readonly char) bool

// IsReservedIdentifier reports whether a SOURCE identifier would collide
// with a compiler-synthesized symbol if declared by the user — a name with
// a `__` prefix (every synthesized helper uses it) or carrying the
// `__bn_inst__` instantiation marker anywhere.  The front-end rejects such
// declarations to prevent a silent duplicate-symbol miscompilation.  The
// single-underscore prefix (`_Foo`) is NOT reserved.
func IsReservedIdentifier(name *[]readonly char) bool

// ImplVtableName builds the interface-impl vtable symbol — the `__ivt.`
// decoration on a bn_V core (recvPkg, recvType, ifacePkg, ifaceName).
// Single source of truth for the ir/codegen builders and the VM's
// runtime lookup key (the VM recovers the trailing iface PkgPath+Ident
// of the core via Demangle).
func ImplVtableName(recvPkg *[]readonly char, recvType *[]readonly char,
	ifacePkg *[]readonly char, ifaceName *[]readonly char) @[]char

// ImplVtableShimName is ImplVtableName with the `__ivtshim.` decoration on
// a bn_W core (the parallel function-value-handle vtable codegen emits
// alongside `__ivt`).
func ImplVtableShimName(recvPkg *[]readonly char, recvType *[]readonly char,
	ifacePkg *[]readonly char, ifaceName *[]readonly char) @[]char

// TypeInfoName builds the per-type RTTI record symbol — the `__typeinfo.`
// decoration on the type's StructName core (recvPkg, recvType).  One per
// concrete type program-wide (weak); the record whose ADDRESS a type
// assertion compares (spec §7.13.14).  Keyed identically to the `__ivt`
// slot that references it so the two agree cross-TU.
func TypeInfoName(recvPkg *[]readonly char,
	recvType *[]readonly char) @[]char

// TypeInfoNameBlobName is the symbol of the read-only blob holding a TypeInfo
// record's name string (referenced by the record's word-3 name pointer).  Keyed
// on the receiver type like TypeInfoName; emitted TU-locally.
func TypeInfoNameBlobName(recvPkg *[]readonly char,
	recvType *[]readonly char) @[]char

// IfaceIdName is the per-interface identity token `__ifaceid.<J>` — one weak,
// address-only marker per interface program-wide, keyed on the canonical
// (alias-resolved) (pkg, name).  A satisfaction entry references it and a type
// assertion `x.(*J)` references the same symbol (spec §11.12 `iface.rtti`).
func IfaceIdName(ifacePkg *[]readonly char,
	ifaceName *[]readonly char) @[]char

// ===========================================================================
// Length-prefix type-arg encoders — the shared surface ir's mangleTypeArg /
// mangleFuncSig and instantiationMangledName build instantiation type-arg
// tokens with (so they use the same encoders Demangle inverts).
// ===========================================================================

// LpWriteArgList appends an lp ArgList (`<argcount> "_" TypeArg{argcount}`)
// of pre-encoded TypeArg strings.
func LpWriteArgList(b *strings.Builder, args @[]@[]char)

// LpTypeArgPtr encodes `*T`.
func LpTypeArgPtr(inner *[]readonly char) @[]char

// LpTypeArgMptr encodes `@T`.
func LpTypeArgMptr(inner *[]readonly char) @[]char

// LpTypeArgSlice encodes `*[]T`.
func LpTypeArgSlice(inner *[]readonly char) @[]char

// LpTypeArgMslice encodes `@[]T` (managed-slice).
func LpTypeArgMslice(inner *[]readonly char) @[]char

// LpTypeArgReadonly encodes `readonly T`.
func LpTypeArgReadonly(inner *[]readonly char) @[]char

// LpTypeArgIfaceVal encodes `*Iface` (interface value).
func LpTypeArgIfaceVal(inner *[]readonly char) @[]char

// LpTypeArgMIfaceVal encodes `@Iface` (managed interface value).
func LpTypeArgMIfaceVal(inner *[]readonly char) @[]char

// LpTypeArgArray encodes `[len]T`.
func LpTypeArgArray(length int, inner *[]readonly char) @[]char

// LpTypeArgFunc encodes a func TYPE.
func LpTypeArgFunc(params @[]@[]char, results @[]@[]char) @[]char

// LpTypeArgFuncVal encodes a `*func` value.
func LpTypeArgFuncVal(params @[]@[]char, results @[]@[]char) @[]char

// LpTypeArgMFuncVal encodes an `@func` value.
func LpTypeArgMFuncVal(params @[]@[]char, results @[]@[]char) @[]char

// LpTypeArgNamedRaw encodes a named/primitive leaf from a RAW qualified
// type name (the package path and leaf are the runs before/after the LAST
// ".", with the package "/"-split).
func LpTypeArgNamedRaw(qualifiedName *[]readonly char) @[]char

// ===========================================================================
// Demangler — the exact inverse of the encoders.  The VM uses it for the
// __ivt iface-suffix rewrite and instantiation detection.
// ===========================================================================

// Kind tags carried by a DemangledName — the symbol-class enumeration.
// ENTRY is the reserved bn_entry sentinel.  One closed enum, one doc.
const (
	KIND_FUNC int = 0
	KIND_GLOBAL int = 1
	KIND_STRUCT int = 2
	KIND_INST_FUNC int = 3
	KIND_INST_STRUCT int = 4
	KIND_IMPL_VTABLE int = 5
	KIND_IMPL_SHIM int = 6
	KIND_ENTRY int = 7
)

// DemangledName is the structured recovery of a mangled symbol.  Which
// fields are populated depends on Kind:
//   FUNC/GLOBAL/STRUCT:        Pkg, Members
//   INST_FUNC/INST_STRUCT:     Pkg, Decl, Args (verbatim TypeArg strings)
//   IMPL_VTABLE/IMPL_SHIM:     Pkg (recv), RecvType, IfacePkg, IfaceName
//   ENTRY:                     (none)
type DemangledName struct {
	Kind int
	// Pkg holds the "/"-split package segments (the RECEIVER package for
	// the impl-vtable kinds; the interface package is in IfacePkg).
	Pkg @[]@[]char
	// Members holds the "."-split member chain for FUNC/GLOBAL/STRUCT.
	Members @[]@[]char
	// Decl is the generic decl name for the INST kinds.
	Decl @[]char
	// Args holds the verbatim, pre-encoded TypeArg strings for the INST
	// kinds (recovered byte-for-byte so re-encoding is the identity).
	Args @[]@[]char
	// RecvType / IfacePkg / IfaceName carry the impl-vtable components.
	RecvType @[]char
	IfacePkg @[]@[]char
	IfaceName @[]char
}

// Demangle is the exact inverse of the encoders.  It operates on the BARE
// `bn_` symbol (any object-file prefix is stripped first by the caller).
// Returns ok=false on malformed input.  The literal "bn_entry" is the
// reserved entry sentinel (KIND_ENTRY, no components).
func Demangle(sym *[]readonly char) (@DemangledName, bool)
