package "pkg/binate/mangle"

import "pkg/binate/buf"

// Mangling uses the FULL package path as the symbol's package
// component so that two packages sharing a last-segment name (e.g.
// `pkg/binate/asm/x64` and `pkg/binate/native/x64`) produce distinct linker
// symbols.  Every `/` and `.` in the qualified name becomes `__`:
//
//   pkg "pkg/binate/parser", func "parseExpr"  → bn_pkg__parser__parseExpr
//   pkg "main", func "main"             → bn_main__main
//   pre-qualified "pkg/binate/parser.New"      → bn_pkg__parser__New
//   method "pkg/geom.Point.M"           → bn_pkg__geom__Point__M
//
// Special case: source-level `main.__entry` (the synthetic wrapper
// that runs var-init + user main) maps to `bn_entry`, the C
// runtime's sole entry point into Binate; nothing else does.

// PkgPathFromQuoted strips surrounding quotes from a quoted-module
// name (`"pkg/foo"` → `pkg/foo`) while preserving the full path.  IR
// Module names and AST PkgName entries are conventionally quoted.
func PkgPathFromQuoted(name *[]const char) @[]char {
	var start int = 0
	var end int = len(name)
	if end >= 2 && name[0] == '"' && name[end-1] == '"' {
		start = 1
		end = end - 1
	}
	var b buf.CharBuf = buf.New()
	b = b.WriteStr(name[start:end])
	return b.Bytes()
}

// writePathIdent appends pkgPath to b with every `/` replaced by
// `__`, folding a package's full path into the identifier-safe
// prefix of a mangled symbol (`pkg/foo` → `pkg__foo`).
func writePathIdent(b buf.CharBuf, pkgPath *[]const char) buf.CharBuf {
	for i := 0; i < len(pkgPath); i++ {
		if pkgPath[i] == '/' {
			b = b.WriteStr("__")
		} else {
			b = b.WriteByte(pkgPath[i])
		}
	}
	return b
}

// QualifyName returns a dot-qualified name `<pkgPath>.<name>` for
// intra-package references.  Names already containing a dot (cross-
// package refs, qualified extern decls, methods) pass through
// unchanged.  Used by the VM to key its flat function table without
// cross-package collisions.  pkgPath is the full package path.
func QualifyName(pkgPath *[]const char, name *[]const char) @[]char {
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			var b buf.CharBuf = buf.New()
			b = b.WriteStr(name)
			return b.Bytes()
		}
	}
	var b buf.CharBuf = buf.New()
	b = b.WriteStr(pkgPath)
	b = b.WriteByte('.')
	b = b.WriteStr(name)
	return b.Bytes()
}

// FuncName converts a Binate function name to its linker symbol.
//
// Free functions:
//   "foo" in pkg "pkg/binate/parser"        → "bn_pkg__parser__foo"
//   "main" in pkg "main"             → "bn_main__main"
//
// Pre-qualified names (any `.` in `name`):
//   "pkg/binate/parser.New"                 → "bn_pkg__parser__New"
//   "pkg/geom.Point.M"               → "bn_pkg__geom__Point__M"
//
// Special case: source-level `main.__entry` → `bn_entry` (the C
// runtime's entry into Binate).  pkgPath is the full package path.
func FuncName(pkgPath *[]const char, name *[]const char) buf.CharBuf {
	if charsEqual(name, "main.__entry") {
		var b buf.CharBuf = buf.New()
		b = b.WriteStr("bn_entry")
		return b
	}
	var hasDot bool = false
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			hasDot = true
			break
		}
	}
	if hasDot {
		return writeBnDotted(name)
	}
	if charsEqual(name, "__entry") && charsEqual(pkgPath, "main") {
		var b buf.CharBuf = buf.New()
		b = b.WriteStr("bn_entry")
		return b
	}
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("bn_")
	b = writePathIdent(b, pkgPath)
	b = b.WriteStr("__")
	b = b.WriteStr(name)
	return b
}

// writeBnDotted writes the mangled symbol for a pre-qualified name
// (one containing a dot): "bn_" followed by the name with every
// "/" and "." replaced by "__".  The package path before the first
// dot may contain slashes (`pkg/binate/buf.CharBuf.WriteByte`); folding
// both separators yields `bn_pkg__binate__buf__CharBuf__WriteByte`.
func writeBnDotted(name *[]const char) buf.CharBuf {
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("bn_")
	for i := 0; i < len(name); i++ {
		if name[i] == '.' || name[i] == '/' {
			b = b.WriteStr("__")
		} else {
			b = b.WriteByte(name[i])
		}
	}
	return b
}

// GlobalName converts a Binate global variable name to its linker
// symbol.  Same algorithm as FuncName (no special cases).  pkgPath
// is the full package path.
func GlobalName(pkgPath *[]const char, name *[]const char) buf.CharBuf {
	var hasDot bool = false
	for i := 0; i < len(name); i++ {
		if name[i] == '.' { hasDot = true; break }
	}
	if hasDot {
		return writeBnDotted(name)
	}
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("bn_")
	b = writePathIdent(b, pkgPath)
	b = b.WriteStr("__")
	b = b.WriteStr(name)
	return b
}

// StructName converts a Binate struct type name to its linker
// symbol.
//   Unqualified "Point" in pkg "pkg/geom" → "bn_pkg__geom__Point"
//   Qualified "pkg/binate/parser.Parser"         → "bn_pkg__parser__Parser"
func StructName(pkgPath *[]const char, name *[]const char) buf.CharBuf {
	var hasDot bool = false
	for i := 0; i < len(name); i++ {
		if name[i] == '.' { hasDot = true; break }
	}
	if hasDot {
		return writeBnDotted(name)
	}
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("bn_")
	b = writePathIdent(b, pkgPath)
	b = b.WriteStr("__")
	b = b.WriteStr(name)
	return b
}

// charsEqual returns true if raw slices a and b have identical contents.
func charsEqual(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
