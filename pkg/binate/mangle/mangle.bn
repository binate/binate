package "pkg/binate/mangle"

import "pkg/binate/buf"
import "pkg/std/strings"

// Public symbol mangling — the length-prefix (invertible) scheme.  Every
// linker symbol is `bn_<kind><body>`; the encoders themselves live in
// mangle_lp.bn and the inverse (Demangle) in mangle_lp_demangle.bn.  This
// file maps the compiler's name shapes onto those encoders:
//
//   FuncName / GlobalName / StructName parse a (pkgPath, name) pair into a
//   package path and a "."-split member chain, then pick the kind:
//     - a sole member carrying the `__bn_inst__` marker is a generic
//       INSTANTIATION (bn_I for funcs, bn_T for structs); the marker
//       splits it into a decl name and a verbatim, self-delimiting lp
//       ArgList (built by instantiationMangledName via LpWriteArgList).
//     - anything else is a free function / method / dtor / global / struct
//       (bn_F / bn_G / bn_S), with the whole member chain as the Ident list
//       (a 2-member chain is a method `Recv.Method`, a dtor/copy helper is
//       a 1-member chain whose Ident happens to contain `_`).
//
//   ImplVtableName / ImplVtableShimName build the `__ivt`/`__ivtshim`
//   decoration on a bn_V / bn_W core (recvPkg, recvType, ifacePkg,
//   ifaceName).
//
// Special case: source-level `main.__entry` (the synthetic wrapper that
// runs var-init + user main) maps to the reserved literal `bn_entry`, the C
// runtime's sole entry point into Binate.  Demangle treats it as a sentinel.
// instMarker is the `__bn_inst__` infix instantiationMangledName emits
// between a generic decl's name and its lp ArgList.  A name carrying it
// (as its sole "."-member) is a monomorphized instantiation symbol.
func instMarker() @[]char {
	return buf.CopyStr("__bn_inst__")
}

// PkgPathFromQuoted strips surrounding quotes from a quoted-module
// name (`"pkg/foo"` → `pkg/foo`) while preserving the full path.  IR
// Module names and AST PkgName entries are conventionally quoted.
func PkgPathFromQuoted(name *[]readonly char) @[]char {
	var start int = 0
	var end int = len(name)
	if end >= 2 && name[0] == '"' && name[end - 1] == '"' {
		start = 1
		end = end - 1
	}
	return buf.CopyStr(name[start:end])
}

// splitPkgPath splits a "/"-joined package path into its segments (a
// PkgPath input shape for the lp encoders).  An empty path yields no
// segments (the canonical 0-segment package, e.g. a primitive leaf).
func splitPkgPath(pkgPath *[]readonly char) @[]@[]char {
	return splitOn(pkgPath, '/')
}

// splitOn splits s into the maximal runs between occurrences of sep.  An
// empty s yields a single empty segment unless s is truly empty (len 0),
// in which case it yields zero segments — matching the encoders' empty-
// package contract.
func splitOn(s *[]readonly char, sep char) @[]@[]char {
	if len(s) == 0 {
		var none @[]@[]char
		return none
	}
	var count int = 1
	for i := 0; i < len(s); i++ {
		if s[i] == sep {
			count = count + 1
		}
	}
	var out @[]@[]char = make_slice(@[]char, count)
	var idx int = 0
	var segStart int = 0
	for i := 0; i < len(s); i++ {
		if s[i] == sep {
			out[idx] = buf.CopyStr(s[segStart:i])
			idx = idx + 1
			segStart = i + 1
		}
	}
	out[idx] = buf.CopyStr(s[segStart:])
	return out
}

// IsInstantiationName reports whether an IR-level name carries the
// `__bn_inst__` marker — i.e. it is a monomorphized generic instantiation
// (a function instance, struct instance, or a generic-impl receiver type
// name).  This is the single source for the marker check: codegen's
// per-package vtable injection and the native descriptor both use it to
// exclude instantiation impls (use-site-lowered by importers, never
// injected by name).  Operates on the bare IR name (before mangling), so
// it cannot go through Demangle — the marker IS the invertible scheme's
// reliable instantiation signal (plan invariant 4).
func IsInstantiationName(name *[]readonly char) bool {
	return findInstMarker(name) >= 0
}

// IsReservedIdentifier reports whether a SOURCE identifier would collide
// with a compiler-synthesized symbol if a user were allowed to declare it.
// The front-end rejects such declarations (a user decl that mangles to a
// compiler symbol is a silent duplicate-symbol miscompilation).  Two
// reserved shapes:
//   - A `__` prefix: every synthesized helper name uses it (`__entry`,
//     `__closure_*`, `__copy_*`, `__bn_thunk_*`, the per-package `__Package`
//     reflect accessor, the `__ivt*` vtable decorations), so a same-named user
//     free function / global / type would mangle to the same
//     `bn_F`/`bn_G`/`bn_S` symbol.
//   - The instantiation marker `__bn_inst__` ANYWHERE in the name (an
//     infix, e.g. `foo__bn_inst__bar`): mangleKinded reads it as a
//     monomorphized generic symbol, so a crafted name could alias a real
//     instantiation's `bn_I`/`bn_T` symbol.
// The single underscore prefix (`_Foo`) is NOT reserved — it is a normal user
// convention; the compiler keeps its own synthesized names in the reserved
// `__` namespace (e.g. the `__Package` accessor above), so a user
// single-underscore name cannot collide with one.
func IsReservedIdentifier(name *[]readonly char) bool {
	if len(name) >= 2 && name[0] == '_' && name[1] == '_' {
		return true
	}
	return IsInstantiationName(name)
}

// findInstMarker returns the byte index of the first `__bn_inst__`
// occurrence in s, or -1 if absent.  A sole member containing it is a
// generic-instantiation symbol (the decl name precedes it; the lp
// ArgList follows).
func findInstMarker(s *[]readonly char) int {
	var marker @[]char = instMarker()
	var n int = len(s)
	var mlen int = len(marker)
	if n < mlen {
		return -1
	}
	for i := 0; i <= n - mlen; i++ {
		var match bool = true
		for j := 0; j < mlen; j++ {
			if s[i + j] != marker[j] {
				match = false
				break
			}
		}
		if match {
			return i
		}
	}
	return -1
}

// nameShape is the lp-encoder-ready decomposition of a (pkgPath, name)
// pair: the package-path segments and the "."-split member chain.
type nameShape struct {
	Segs    @[]@[]char
	Members @[]@[]char
}

// effectivePkgAndMembers resolves the (pkgPath, name) pair a public
// mangler receives into the lp-encoder shape.  A name containing a "." is
// pre-qualified — its package is the run before the FIRST "." and its
// members are the "."-split tail (so `pkg/geom.Point.M` → pkg [pkg, geom],
// members [Point, M]); otherwise the passed pkgPath is used and the whole
// name is the single member.
func effectivePkgAndMembers(pkgPath *[]readonly char, name *[]readonly char) @nameShape {
	var out @nameShape = make(nameShape)
	var dotIdx int = -1
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			dotIdx = i
			break
		}
	}
	if dotIdx < 0 {
		out.Segs = splitPkgPath(pkgPath)
		var members @[]@[]char = make_slice(@[]char, 1)
		members[0] = buf.CopyStr(name)
		out.Members = members
		return out
	}
	out.Segs = splitPkgPath(name[0:dotIdx])
	out.Members = splitOn(name[dotIdx + 1:], '.')
	return out
}

// mangleKinded is the shared body of FuncName / GlobalName / StructName:
// it parses the name shape and emits the appropriate kind.  baseKind is
// the non-instantiation kind letter; instKind is chosen for a
// monomorphized generic symbol (I for funcs/globals, T for structs).
func mangleKinded(pkgPath *[]readonly char, name *[]readonly char, baseKind char,
		instKind char) @[]char {
	var shape @nameShape = effectivePkgAndMembers(pkgPath, name)
	var segs @[]@[]char = shape.Segs
	var members @[]@[]char = shape.Members
	// A sole member carrying the instantiation marker is a monomorphized
	// generic symbol: split it into <decl>__bn_inst__<lp-ArgList> and emit
	// the inst kind, passing the lp ArgList body through verbatim (it is
	// already the self-delimiting type-arg sub-language).
	if len(members) == 1 {
		var mi int = findInstMarker(members[0])
		if mi >= 0 {
			var decl @[]char = buf.CopyStr(members[0][0:mi])
			var argList @[]char = buf.CopyStr(
					members[0][mi + len(instMarker()):])
			return lpInstWithRawArgList(instKind, segs, decl, argList)
		}
	}
	return lpFGS(baseKind, segs, members)
}

// FuncName converts a Binate function name to its linker symbol.
//
//   "parseExpr" in pkg "pkg/binate/parser" → bn_F-encoded free function
//   "pkg/geom.Point.M"                      → bn_F-encoded method
//   "pkg/foo.Box__bn_inst__<args>"          → bn_I-encoded instantiation
//
// Special case: source-level `main.__entry` → the reserved `bn_entry`.
// pkgPath is the full package path.
func FuncName(pkgPath *[]readonly char, name *[]readonly char) @[]char {
	if charsEqual(name, "main.__entry") {
		return buf.CopyStr("bn_entry")
	}
	if charsEqual(name, "__entry") && charsEqual(pkgPath, "main") {
		return buf.CopyStr("bn_entry")
	}
	return mangleKinded(pkgPath, name, 'F', 'I')
}

// GlobalName converts a Binate global variable name to its linker symbol
// (bn_G; same name-shape parsing as FuncName, no entry special case).
func GlobalName(pkgPath *[]readonly char, name *[]readonly char) @[]char {
	return mangleKinded(pkgPath, name, 'G', 'I')
}

// StructName converts a Binate struct type name to its linker symbol
// (bn_S, or bn_T for a generic-struct instantiation).
func StructName(pkgPath *[]readonly char, name *[]readonly char) @[]char {
	return mangleKinded(pkgPath, name, 'S', 'T')
}

// QualifyName returns a dot-qualified name `<pkgPath>.<name>` for
// intra-package references.  Names already containing a dot (cross-
// package refs, qualified extern decls, methods) pass through
// unchanged.  Used by the VM to key its flat function table without
// cross-package collisions.  pkgPath is the full package path.
func QualifyName(pkgPath *[]readonly char, name *[]readonly char) @[]char {
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			return buf.CopyStr(name)
		}
	}
	var b @strings.Builder = strings.NewBuilder()
	b.Write(pkgPath)
	b.WriteByte('.')
	b.Write(name)
	return buf.CopyStr(b.String())
}

// ImplVtableName builds the interface-impl vtable symbol: the `__ivt.`
// decoration on a bn_V core (recvPkg, recvType, ifacePkg, ifaceName).
// Single source of truth for the ir/codegen builders and the VM's
// runtime lookup key — the VM recovers the trailing iface PkgPath+Ident
// of the core via Demangle (swapIfaceSuffix).
func ImplVtableName(recvPkg *[]readonly char, recvType *[]readonly char, ifacePkg *[]readonly char,
		ifaceName *[]readonly char) @[]char {
	return buf.Concat("__ivt.",
			lpImplVtable(splitPkgPath(recvPkg), recvType, splitPkgPath(ifacePkg), ifaceName))
}

// ImplVtableShimName is ImplVtableName with the `__ivtshim.` decoration on
// a bn_W core — the parallel function-value-handle vtable codegen emits
// alongside `__ivt`.
func ImplVtableShimName(recvPkg *[]readonly char, recvType *[]readonly char,
		ifacePkg *[]readonly char, ifaceName *[]readonly char) @[]char {
	return buf.Concat("__ivtshim.",
			lpImplShimVtable(splitPkgPath(recvPkg), recvType, splitPkgPath(ifacePkg), ifaceName))
}

// TypeInfoName builds the per-type RTTI record symbol: the `__typeinfo.`
// decoration on the type's `StructName` core (recvPkg, recvType).  One
// TypeInfo exists per concrete type program-wide (weak, ODR-coalesced),
// so the symbol is keyed on the receiver type alone — not on any
// interface — and a generic instantiation gets a distinct symbol
// automatically (StructName routes `__bn_inst__` names through `bn_T`).
// It is the record whose ADDRESS a type assertion compares (spec §7.13.14
// `type.layout.typeinfo`; §11.12 `iface.rtti`).  Keyed identically to the
// `__ivt` vtable slot that references it so the two agree cross-TU.
func TypeInfoName(recvPkg *[]readonly char, recvType *[]readonly char) @[]char {
	return buf.Concat("__typeinfo.", StructName(recvPkg, recvType))
}

// TypeInfoNameBlobName is the symbol of the read-only byte blob holding a
// TypeInfo record's name string (the record's word-3 name pointer references
// it).  Keyed on the receiver type like TypeInfoName.  The blob is emitted
// TU-locally (the weak record coalesces to one survivor, whose own TU's blob it
// references), so this need only be unique within a TU — one per type suffices.
func TypeInfoNameBlobName(recvPkg *[]readonly char,
		recvType *[]readonly char) @[]char {
	return buf.Concat("__typeinfo_name.", StructName(recvPkg, recvType))
}

// charsEqual returns true if raw slices a and b have identical contents.
func charsEqual(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
