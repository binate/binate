package "pkg/binate/mangle"

import "pkg/builtins/testing"

// Tests for the demangler half (mangle_lp_demangle.bn): the injectivity
// guarantees that the OLD `.`/`__`-fold scheme failed, plus malformed-
// input rejection and the canonical-decimal digit reader.

func dmFail(msg @[]char) testing.TestResult {
	return msg
}

func dmStrEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// ============================================================
// INJECTIVITY — collisions the old scheme produced must now be distinct.
// ============================================================

// (a) The `.`//`__` 2-to-1 fold: type C in package "a/b" vs a type
// literally named "b__C" in package "a".  The old fold mapped both to
// `bn_a__b__C`; length-prefixing keeps them apart.
func TestDmInjectivityFoldedPath() testing.TestResult {
	var x @[]char = lpStruct(@[]@[]char{"a", "b"}, @[]@[]char{"C"})
	var y @[]char = lpStruct(@[]@[]char{"a"}, @[]@[]char{"b__C"})
	if dmStrEq(x, y) {
		return dmFail("C@a/b and b__C@a must produce distinct symbols")
	}
	// And both still demangle back to their own structure.
	var dx @DemangledName
	var dy @DemangledName
	var ok bool
	dx, ok = Demangle(x)
	if !ok || len(dx.Pkg) != 2 {
		return dmFail("C@a/b structure lost")
	}
	dy, ok = Demangle(y)
	if !ok || len(dy.Pkg) != 1 || !dmStrEq(dy.Members[0], "b__C") {
		return dmFail("b__C@a structure lost")
	}
	return ""
}

// (b) Finding A: a named type whose PACKAGE begins with a reserved
// constructor prefix (here "ptr_q") must not be confused with a `*`
// (raw-pointer) constructor applied to a type in package "q".  Both are
// encoded as TypeArgs; they must differ.
func TestDmInjectivityNamedVsPtrPrefix() testing.TestResult {
	// Named type Bar in package "ptr_q".
	var named @[]char = lpTypeArgNamed(@[]@[]char{"ptr_q"}, "Bar")
	// *Bar where Bar lives in package "q".
	var ptr @[]char = lpTypeArgPtr(lpTypeArgNamed(@[]@[]char{"q"}, "Bar"))
	if dmStrEq(named, ptr) {
		return dmFail("named type in ptr_q vs *Bar-in-q must be distinct")
	}
	return ""
}

// (c) An identifier containing a literal "__" (e.g. "__entry") vs a
// dotted two-member name that the old scheme would have folded to the
// same `__`-joined string.  Here: member "a__b" (one member) vs members
// ["a","b"] (two members).
func TestDmInjectivityEmbeddedDoubleUnderscore() testing.TestResult {
	var one @[]char = lpFunc(@[]@[]char{"main"}, @[]@[]char{"a__b"})
	var two @[]char = lpFunc(@[]@[]char{"main"}, @[]@[]char{"a", "b"})
	if dmStrEq(one, two) {
		return dmFail("member a__b vs [a,b] must be distinct")
	}
	var d1 @DemangledName
	var d2 @DemangledName
	var ok bool
	d1, ok = Demangle(one)
	if !ok || len(d1.Members) != 1 {
		return dmFail("a__b should be one member")
	}
	d2, ok = Demangle(two)
	if !ok || len(d2.Members) != 2 {
		return dmFail("[a,b] should be two members")
	}
	return ""
}

// (d) Arity: func(int), func(int,int), and func()int must all differ.
func TestDmInjectivityFuncArity() testing.TestResult {
	var i @[]char = lpTypeArgNamed(@[]@[]char{}, "int")
	var f1 @[]char = lpTypeArgFunc(@[]@[]char{i}, @[]@[]char{})
	var f2 @[]char = lpTypeArgFunc(@[]@[]char{i, i}, @[]@[]char{})
	var f3 @[]char = lpTypeArgFunc(@[]@[]char{}, @[]@[]char{i})
	if dmStrEq(f1, f2) || dmStrEq(f1, f3) || dmStrEq(f2, f3) {
		return dmFail("func arities must produce distinct symbols")
	}
	return ""
}

// ============================================================
// Malformed input — Demangle must return ok=false, not panic/accept.
// ============================================================

func TestDmRejectMalformed() testing.TestResult {
	var ok bool
	// Unknown kind letter.
	_, ok = Demangle("bn_Z0_0_")
	if ok {
		return dmFail("unknown kind must be rejected")
	}
	// Missing the bn_ prefix.
	_, ok = Demangle("xy_F0_0_")
	if ok {
		return dmFail("missing bn_ prefix must be rejected")
	}
	// Truncated: count promises more bytes than present.
	_, ok = Demangle("bn_F1_5_pkg")
	if ok {
		return dmFail("truncated body must be rejected")
	}
	// Trailing garbage after a complete parse.
	_, ok = Demangle("bn_F1_4_main0_X")
	if ok {
		return dmFail("trailing bytes must be rejected")
	}
	// Empty input.
	_, ok = Demangle("")
	if ok {
		return dmFail("empty input must be rejected")
	}
	// An OVERFLOWING count must be rejected, not crash the parse.  Before the
	// len(c.s) cap, a long digit run overflowed int to a negative value and the
	// remaining-bytes check (c.pos+n > len) went false, slicing out of bounds.
	_, ok = Demangle("bn_F1_99999999999999999999_x")
	if ok {
		return dmFail("overflowing count must be rejected (no crash)")
	}
	// An indexing count larger than the remaining bytes is malformed (an Ident
	// len of 99 with only a few bytes left).
	_, ok = Demangle("bn_F1_99_ab")
	if ok {
		return dmFail("count exceeding remaining bytes must be rejected")
	}
	return ""
}

// Non-canonical decimals (leading zero) must be rejected so the encoding
// stays injective — the encoder never emits "01" or "00".
func TestDmRejectLeadingZero() testing.TestResult {
	var d @DemangledName
	var ok bool
	// "01" segment count.
	d, ok = Demangle("bn_F01_4_main0_")
	if ok {
		return dmFail("leading-zero count must be rejected")
	}
	// Canonical zero IS accepted: empty pkg + empty members.
	d, ok = Demangle("bn_F0_0_")
	if !ok {
		return dmFail("canonical 0_0_ must be accepted")
	}
	if d.Kind != KIND_FUNC || len(d.Pkg) != 0 || len(d.Members) != 0 {
		return dmFail("0_0_ should be a no-pkg, no-member func")
	}
	return ""
}
