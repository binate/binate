package "pkg/binate/mangle"

import "pkg/builtins/testing"

// ============================================================
// Helpers
// ============================================================
func lpFail(msg @[]char) testing.TestResult {
	return msg
}

// lpStrEq reports byte-equality of two strings.
func lpStrEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// lpListEq reports element-wise byte-equality of two @[]@[]char lists.
func lpListEq(a @[]@[]char, b @[]@[]char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if !lpStrEq(a[i], b[i]) {
			return false
		}
	}
	return true
}

// lpIdentSafe reports whether every byte of s is in [A-Za-z0-9_].
func lpIdentSafe(s *[]readonly char) bool {
	for i := 0; i < len(s); i++ {
		var c char = s[i]
		var ok bool = c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_'
		if !ok {
			return false
		}
	}
	return true
}

// ============================================================
// Core productions: PkgPath / Ident corner cases
// ============================================================
// lpEncEmpty builds a one-segment path so we can exercise empty/0 cases.
func TestLpIdentEmptyAndEntry() testing.TestResult {
	// "" member round-trips to one empty member.
	var sym @[]char = lpFunc(@[]@[]char{"main"}, @[]@[]char{""})
	var d @DemangledName
	var ok bool
	d, ok = Demangle(sym)
	if !ok {
		return lpFail("demangle of empty-member func failed")
	}
	if !lpListEq(d.Members, @[]@[]char{""}) {
		return lpFail("empty member not recovered")
	}
	// "__entry"-style identifier with embedded "__" round-trips.
	var sym2 @[]char = lpFunc(@[]@[]char{"main"}, @[]@[]char{"__entry"})
	d, ok = Demangle(sym2)
	if !ok || !lpListEq(d.Members, @[]@[]char{"__entry"}) {
		return lpFail("__entry member not recovered")
	}
	return ""
}

// Empty package path encodes 0 segments and round-trips to no segments.
func TestLpEmptyPkgPath() testing.TestResult {
	// A primitive leaf uses the empty package: "N0_3_int".
	var arg @[]char = lpTypeArgNamed(@[]@[]char{}, "int")
	if !lpStrEq(arg, "N0_3_int") {
		return lpFail("primitive int leaf must encode as N0_3_int")
	}
	return ""
}

// ============================================================
// Round-trip: F / G / S
// ============================================================
func TestLpRoundTripFunc() testing.TestResult {
	var pkg @[]@[]char = @[]@[]char{"pkg", "binate", "parser"}
	var mem @[]@[]char = @[]@[]char{"parseExpr"}
	var sym @[]char = lpFunc(pkg, mem)
	if !lpStrEq(sym, "bn_F3_3_pkg6_binate6_parser1_9_parseExpr") {
		return lpFail("free func symbol shape wrong")
	}
	var d @DemangledName
	var ok bool
	d, ok = Demangle(sym)
	if !ok || d.Kind != KIND_FUNC {
		return lpFail("func kind not recovered")
	}
	if !lpListEq(d.Pkg, pkg) || !lpListEq(d.Members, mem) {
		return lpFail("func pkg/members not recovered")
	}
	return ""
}

