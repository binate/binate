// ============================================================
// Round-trip: I / T (generic instantiations)
// ============================================================
func TestLpRoundTripInstFuncOneArg() testing.TestResult {
	var pkg @[]@[]char = @[]@[]char{"pkg", "stdx", "slices"}
	var args @[]@[]char = @[]@[]char{lpTypeArgNamed(@[]@[]char{}, "int")}
	var sym @[]char = lpInstFunc(pkg, "Append", args)
	var d @DemangledName
	var ok bool
	d, ok = Demangle(sym)
	if !ok || d.Kind != KIND_INST_FUNC {
		return lpFail("inst-func kind not recovered")
	}
	if !lpStrEq(d.Decl, "Append") {
		return lpFail("inst-func decl not recovered")
	}
	if !lpListEq(d.Args, args) {
		return lpFail("inst-func args not recovered verbatim")
	}
	return ""
}

func TestLpRoundTripInstFuncTwoArgs() testing.TestResult {
	var pkg @[]@[]char = @[]@[]char{"pkg", "stdx", "maps"}
	var a0 @[]char = lpTypeArgNamed(@[]@[]char{}, "int")
	var a1 @[]char = lpTypeArgMslice(lpTypeArgNamed(@[]@[]char{}, "int"))
	var args @[]@[]char = @[]@[]char{a0, a1}
	var sym @[]char = lpInstFunc(pkg, "Map", args)
	var d @DemangledName
	var ok bool
	d, ok = Demangle(sym)
	if !ok || d.Kind != KIND_INST_FUNC || !lpStrEq(d.Decl, "Map") {
		return lpFail("two-arg inst-func not recovered")
	}
	if len(d.Args) != 2 || !lpStrEq(d.Args[0], a0) || !lpStrEq(d.Args[1], a1) {
		return lpFail("two-arg inst-func args not recovered")
	}
	return ""
}

func TestLpRoundTripLargeArray() testing.TestResult {
	// An array LENGTH is a magnitude that can exceed the symbol length; it must
	// still round-trip (the demangler skips it via lpSkipCount, NOT the
	// input-length-capped lpReadCount used for indexing counts).
	var arg @[]char = lpTypeArgArray(1000000, lpTypeArgNamed(@[]@[]char{}, "int"))
	var args @[]@[]char = @[]@[]char{arg}
	var sym @[]char = lpInstFunc(@[]@[]char{"main"}, "F", args)
	var d @DemangledName
	var ok bool
	d, ok = Demangle(sym)
	if !ok || d.Kind != KIND_INST_FUNC {
		return lpFail("large-array inst-func not recovered")
	}
	if len(d.Args) != 1 || !lpStrEq(d.Args[0], arg) {
		return lpFail("large array-length arg not recovered verbatim")
	}
	return ""
}

func TestLpRoundTripInstStruct() testing.TestResult {
	var pkg @[]@[]char = @[]@[]char{"pkg", "stdx", "vec"}
	var args @[]@[]char = @[]@[]char{lpTypeArgPtr(lpTypeArgNamed(@[]@[]char{}, "int"))}
	var sym @[]char = lpInstStruct(pkg, "Vec", args)
	var d @DemangledName
	var ok bool
	d, ok = Demangle(sym)
	if !ok || d.Kind != KIND_INST_STRUCT || !lpStrEq(d.Decl, "Vec") {
		return lpFail("inst-struct not recovered")
	}
	if !lpListEq(d.Args, args) {
		return lpFail("inst-struct args not recovered")
	}
	return ""
}

// ============================================================
// Round-trip: V / W (interface-impl vtables)
// ============================================================
func TestLpRoundTripImplVtable() testing.TestResult {
	var recvPkg @[]@[]char = @[]@[]char{"pkg", "geom"}
	var ifacePkg @[]@[]char = @[]@[]char{"pkg", "io"}
	var sym @[]char = lpImplVtable(recvPkg, "Point", ifacePkg, "Writer")
	var d @DemangledName
	var ok bool
	d, ok = Demangle(sym)
	if !ok || d.Kind != KIND_IMPL_VTABLE {
		return lpFail("impl-vtable kind not recovered")
	}
	if !lpListEq(d.Pkg, recvPkg) || !lpStrEq(d.RecvType, "Point") {
		return lpFail("impl-vtable recv not recovered")
	}
	if !lpListEq(d.IfacePkg, ifacePkg) || !lpStrEq(d.IfaceName, "Writer") {
		return lpFail("impl-vtable iface not recovered")
	}
	return ""
}

func TestLpRoundTripImplShim() testing.TestResult {
	var recvPkg @[]@[]char = @[]@[]char{"main"}
	var ifacePkg @[]@[]char = @[]@[]char{"pkg", "io"}
	var sym @[]char = lpImplShimVtable(recvPkg, "Buf", ifacePkg, "Reader")
	var d @DemangledName
	var ok bool
	d, ok = Demangle(sym)
	if !ok || d.Kind != KIND_IMPL_SHIM {
		return lpFail("impl-shim kind not recovered")
	}
	if !lpListEq(d.Pkg, recvPkg) || !lpStrEq(d.RecvType, "Buf") {
		return lpFail("impl-shim recv not recovered")
	}
	if !lpListEq(d.IfacePkg, ifacePkg) || !lpStrEq(d.IfaceName, "Reader") {
		return lpFail("impl-shim iface not recovered")
	}
	return ""
}

// ============================================================
// Round-trip: every TypeArg constructor (nested, func value, array,
// cross-pkg named, primitive)
// ============================================================
// lpArgRoundTrip wraps one TypeArg as the sole arg of an inst-func and
// asserts the demangler recovers it verbatim.
func lpArgRoundTrip(arg @[]char) bool {
	var sym @[]char = lpInstFunc(@[]@[]char{"main"}, "F", @[]@[]char{arg})
	var d @DemangledName
	var ok bool
	d, ok = Demangle(sym)
	if !ok || len(d.Args) != 1 {
		return false
	}
	return lpStrEq(d.Args[0], arg)
}

// @[]*int — a managed-slice of raw-pointer-to-int (nested constructors).
func TestLpTypeArgNestedMsliceOfPtr() testing.TestResult {
	var arg @[]char = lpTypeArgMslice(lpTypeArgPtr(lpTypeArgNamed(@[]@[]char{}, "int")))
	if !lpStrEq(arg, "MpN0_3_int") {
		return lpFail("@[]*int should encode as MpN0_3_int")
	}
	if !lpArgRoundTrip(arg) {
		return lpFail("@[]*int did not round-trip")
	}
	return ""
}

// Each remaining unary constructor round-trips.
func TestLpTypeArgUnaryConstructors() testing.TestResult {
	var leaf @[]char = lpTypeArgNamed(@[]@[]char{}, "int")
	if !lpArgRoundTrip(lpTypeArgMptr(leaf)) {
		return lpFail("@T did not round-trip")
	}
	if !lpArgRoundTrip(lpTypeArgSlice(leaf)) {
		return lpFail("*[]T did not round-trip")
	}
	if !lpArgRoundTrip(lpTypeArgReadonly(leaf)) {
		return lpFail("readonly T did not round-trip")
	}
	if !lpArgRoundTrip(lpTypeArgIfaceVal(leaf)) {
		return lpFail("*Iface did not round-trip")
	}
	if !lpArgRoundTrip(lpTypeArgMIfaceVal(leaf)) {
		return lpFail("@Iface did not round-trip")
	}
	return ""
}

// An array [4]int round-trips (the length is preserved in the bytes).
func TestLpTypeArgArray() testing.TestResult {
	var arg @[]char = lpTypeArgArray(4, lpTypeArgNamed(@[]@[]char{}, "int"))
	if !lpStrEq(arg, "a4_N0_3_int") {
		return lpFail("[4]int should encode as a4_N0_3_int")
	}
	if !lpArgRoundTrip(arg) {
		return lpFail("[4]int did not round-trip")
	}
	return ""
}

// A managed func value @func(int) int round-trips.
func TestLpTypeArgMFuncVal() testing.TestResult {
	var i @[]char = lpTypeArgNamed(@[]@[]char{}, "int")
	var arg @[]char = lpTypeArgMFuncVal(@[]@[]char{i}, @[]@[]char{i})
	if !lpStrEq(arg, "gp1_N0_3_intr1_N0_3_int") {
		return lpFail("@func(int)int wrong shape")
	}
	if !lpArgRoundTrip(arg) {
		return lpFail("@func value did not round-trip")
	}
	return ""
}

// A func TYPE and a *func value also round-trip (incl. zero results).
func TestLpTypeArgFuncTypeAndVal() testing.TestResult {
	var i @[]char = lpTypeArgNamed(@[]@[]char{}, "int")
	var ft @[]char = lpTypeArgFunc(@[]@[]char{i}, @[]@[]char{})
	if !lpArgRoundTrip(ft) {
		return lpFail("func(int) type did not round-trip")
	}
	var fv @[]char = lpTypeArgFuncVal(@[]@[]char{}, @[]@[]char{i})
	if !lpArgRoundTrip(fv) {
		return lpFail("*func()int value did not round-trip")
	}
	return ""
}

// A cross-package named type round-trips.
func TestLpTypeArgCrossPkgNamed() testing.TestResult {
	var arg @[]char = lpTypeArgNamed(@[]@[]char{"pkg", "geom"}, "Point")
	if !lpStrEq(arg, "N2_3_pkg4_geom5_Point") {
		return lpFail("cross-pkg named wrong shape")
	}
	if !lpArgRoundTrip(arg) {
		return lpFail("cross-pkg named did not round-trip")
	}
	return ""
}

// ============================================================
// bn_entry sentinel
// ============================================================
func TestLpEntrySentinel() testing.TestResult {
	var d @DemangledName
	var ok bool
	d, ok = Demangle("bn_entry")
	if !ok || d.Kind != KIND_ENTRY {
		return lpFail("bn_entry must demangle to KIND_ENTRY")
	}
	return ""
}

// ============================================================
// Identifier-safety: every produced symbol is [A-Za-z0-9_]
// ============================================================
func TestLpIdentifierSafe() testing.TestResult {
	var s1 @[]char = lpFunc(@[]@[]char{"pkg", "binate", "parser"}, @[]@[]char{"parseExpr"})
	var s2 @[]char = lpImplVtable(@[]@[]char{"pkg", "geom"}, "Point", @[]@[]char{"pkg", "io"},
			"Writer")
	var arg @[]char = lpTypeArgMslice(lpTypeArgPtr(lpTypeArgNamed(@[]@[]char{}, "int")))
	var s3 @[]char = lpInstStruct(@[]@[]char{"main"}, "Vec", @[]@[]char{arg})
	if !lpIdentSafe(s1) || !lpIdentSafe(s2) || !lpIdentSafe(s3) {
		return lpFail("produced symbol contained a non-identifier byte")
	}
	return ""
}
