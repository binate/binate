	var b @[]char = StructName("pkg/binate/ir", "Instr")
	if !strEq(b, "bn_S3_3_pkg6_binate2_ir1_5_Instr") {
		return fail("expected bn_S3_3_pkg6_binate2_ir1_5_Instr")
	}
	return ""
}

func TestStructNameCrossPkg() testing.TestResult {
	var b @[]char = StructName("main", "pkg/binate/parser.Parser")
	if !strEq(b, "bn_S3_3_pkg6_binate6_parser1_6_Parser") {
		return fail("expected bn_S3_3_pkg6_binate6_parser1_6_Parser")
