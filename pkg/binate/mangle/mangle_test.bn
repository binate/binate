package "pkg/binate/mangle"

import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult {
	return msg
}

func strEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// ============================================================
// PkgPathFromQuoted
// ============================================================

func TestPkgPathFromQuotedSimple() testing.TestResult {
	var s @[]char = PkgPathFromQuoted("\"main\"")
	if !strEq(s, "main") { return fail("expected main") }
	return ""
}

func TestPkgPathFromQuotedPath() testing.TestResult {
	var s @[]char = PkgPathFromQuoted("\"pkg/binate/parser\"")
	if !strEq(s, "pkg/binate/parser") {
		return fail("expected pkg/binate/parser (full path preserved)")
	}
	return ""
}

func TestPkgPathFromQuotedDeep() testing.TestResult {
	var s @[]char = PkgPathFromQuoted("\"pkg/binate/asm/aarch64\"")
	if !strEq(s, "pkg/binate/asm/aarch64") {
		return fail("expected pkg/binate/asm/aarch64 (full path preserved)")
	}
	return ""
}

func TestPkgPathFromQuotedUnquoted() testing.TestResult {
	var s @[]char = PkgPathFromQuoted("main")
	if !strEq(s, "main") {
		return fail("expected main passthrough for unquoted input")
	}
	return ""
}

// ============================================================
// FuncName — length-prefix mangling (bn_F PkgPath Members)
// ============================================================

func TestFuncNamePkgPath() testing.TestResult {
	var b @[]char = FuncName("pkg/binate/parser", "parseExpr")
	if !strEq(b, "bn_F3_3_pkg6_binate6_parser1_9_parseExpr") {
		return fail("expected bn_F3_3_pkg6_binate6_parser1_9_parseExpr")
	}
	return ""
}

func TestFuncNameDeepPkgPath() testing.TestResult {
	var b @[]char = FuncName("pkg/binate/asm/x64", "Push")
	if !strEq(b, "bn_F4_3_pkg6_binate3_asm3_x641_4_Push") {
		return fail("expected bn_F4_3_pkg6_binate3_asm3_x641_4_Push")
	}
	return ""
}

// The collision-avoidance pin: `pkg/binate/asm/x64` and `pkg/binate/native/x64`
// share the last segment `x64` but MUST produce distinct symbols.
// This is the whole point of full-path mangling.
func TestFuncNameNoLastSegmentCollision() testing.TestResult {
	var a @[]char = FuncName("pkg/binate/asm/x64", "Push")
	var b @[]char = FuncName("pkg/binate/native/x64", "Push")
	if strEq(a, b) {
		return fail("packages with same last segment must NOT collide")
	}
	return ""
}

// `main` is a single-segment package.
func TestFuncNameMain() testing.TestResult {
	var b @[]char = FuncName("main", "main")
	if !strEq(b, "bn_F1_4_main1_4_main") {
		return fail("expected bn_F1_4_main1_4_main")
	}
	return ""
}

// IsUniversalTrampoline matches ONLY the three universal VM trampolines by their
// canonical mangled name (the func-value-vtable emitters bypass __shim for these).
// It must reject an ordinary vm function AND a same-named function in another
// package — mangling is injective on (package, member), so no false match.
func TestIsUniversalTrampoline() testing.TestResult {
	if !IsUniversalTrampoline(FuncName("pkg/binate/vm", "TrampolineScalar")) {
		return fail("TrampolineScalar should be a universal trampoline")
	}
	if !IsUniversalTrampoline(FuncName("pkg/binate/vm", "TrampolineScalar64")) {
		return fail("TrampolineScalar64 should be a universal trampoline")
	}
	if !IsUniversalTrampoline(FuncName("pkg/binate/vm", "TrampolineAggregate")) {
		return fail("TrampolineAggregate should be a universal trampoline")
	}
	if IsUniversalTrampoline(FuncName("pkg/binate/vm", "CallIfaceMethod")) {
		return fail("an ordinary vm function must not match")
	}
	if IsUniversalTrampoline(FuncName("other/pkg", "TrampolineScalar")) {
		return fail("a same-named function in another package must not match")
	}
	return ""
}

// `<main>.__entry` is the C runtime's sole entry into Binate.
// Both the bare-then-pkg form and the pre-qualified dotted form
// resolve to the reserved literal `bn_entry`.
func TestFuncNameMainEntry() testing.TestResult {
	var b1 @[]char = FuncName("main", "__entry")
	if !strEq(b1, "bn_entry") {
		return fail("expected bn_entry from (main, __entry)")
	}
	var b2 @[]char = FuncName("main", "main.__entry")
	if !strEq(b2, "bn_entry") {
		return fail("expected bn_entry from main.__entry")
	}
	return ""
}

// The synthetic library-init dispatcher `<facade>.__bninit` (EmitLibInit)
// resolves to the reserved well-known literal `bn_init` for ANY facade package,
// bare or qualified — the library counterpart of `bn_entry`.
func TestFuncNameLibInit() testing.TestResult {
	var b1 @[]char = FuncName("ffiexp", "ffiexp.__bninit")
	if !strEq(b1, "bn_init") {
		return fail("expected bn_init from ffiexp.__bninit")
	}
	var b2 @[]char = FuncName("main", "__bninit")
	if !strEq(b2, "bn_init") {
		return fail("expected bn_init from bare __bninit")
	}
	// A different package's __bninit still maps to the single bn_init.
	var b3 @[]char = FuncName("pkg/foo", "pkg/foo.__bninit")
	if !strEq(b3, "bn_init") {
		return fail("expected bn_init from pkg/foo.__bninit")
	}
	// A normal function whose name merely CONTAINS bninit is NOT special.
	var b4 @[]char = FuncName("main", "main.bninit")
	if strEq(b4, "bn_init") {
		return fail("a normal function must not map to bn_init")
	}
	return ""
}

// Pre-qualified cross-package call: the package component comes from
// the name's full-path prefix (before the first `.`); the tail is the
// member chain.
func TestFuncNameCrossPkgQualified() testing.TestResult {
	var b @[]char = FuncName("main", "pkg/binate/parser.New")
	if !strEq(b, "bn_F3_3_pkg6_binate6_parser1_3_New") {
		return fail("expected bn_F3_3_pkg6_binate6_parser1_3_New")
	}
	return ""
}

// Method on a named type: the `.`-split tail is the two-member chain
// [Point, M] (a method is recovered by member count).
func TestFuncNameMethod() testing.TestResult {
	var b @[]char = FuncName("pkg/geom", "pkg/geom.Point.M")
	if !strEq(b, "bn_F2_3_pkg4_geom2_5_Point1_M") {
		return fail("expected bn_F2_3_pkg4_geom2_5_Point1_M")
	}
	return ""
}

func TestFuncNameMethodCrossPkg() testing.TestResult {
	var b @[]char = FuncName("main", "pkg/geom.Point.Translate")
	if !strEq(b, "bn_F2_3_pkg4_geom2_5_Point9_Translate") {
		return fail("expected bn_F2_3_pkg4_geom2_5_Point9_Translate")
	}
	return ""
}

// A generic-instantiation function name (sole member carries the
// `__bn_inst__` marker) becomes a bn_I with the lp ArgList passed through.
func TestFuncNameInstantiation() testing.TestResult {
	var b @[]char = FuncName("pkg/aa/gen", "pkg/aa/gen.pair__bn_inst__2_N0_3_intN0_4_bool")
	if !strEq(b, "bn_I3_3_pkg2_aa3_gen4_pair2_N0_3_intN0_4_bool") {
		return fail("expected bn_I3_3_pkg2_aa3_gen4_pair2_N0_3_intN0_4_bool")
	}
	return ""
}

// A METHOD on an instantiated receiver type (2 members) is NOT an inst
// symbol: it stays bn_F, with the instantiation name as a length-prefixed
// member Ident (so the embedded `__bn_inst__` lives inside the Ident bytes).
func TestFuncNameMethodOnInstantiation() testing.TestResult {
	var b @[]char = FuncName("pkg/foo", "pkg/foo.Box__bn_inst__1_N0_3_int.Get")
	if !strEq(b, "bn_F2_3_pkg3_foo2_24_Box__bn_inst__1_N0_3_int3_Get") {
		return fail("expected bn_F2_3_pkg3_foo2_24_Box__bn_inst__1_N0_3_int3_Get")
	}
	// Demangle recovers it as a 2-member func (recv + method), with the
	// instantiation name preserved verbatim as the first member Ident.
	var d @DemangledName
	var ok bool
	d, ok = Demangle(b)
	if !ok || d.Kind != KIND_FUNC || len(d.Members) != 2 {
		return fail("method-on-inst should demangle to a 2-member func")
	}
	if !strEq(d.Members[0], "Box__bn_inst__1_N0_3_int") || !strEq(d.Members[1], "Get") {
		return fail("method-on-inst members not recovered verbatim")
	}
	return ""
}

