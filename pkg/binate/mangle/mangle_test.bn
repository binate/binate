func TestGlobalName() testing.TestResult {
	var b @[]char = GlobalName("pkg/binate/ir", "moduleStructs")
	if !strEq(b, "bn_G3_3_pkg6_binate2_ir1_13_moduleStructs") {
		return fail("expected bn_G3_3_pkg6_binate2_ir1_13_moduleStructs")
	}
	return ""
}

func TestGlobalNameNoLastSegmentCollision() testing.TestResult {
	var a @[]char = GlobalName("pkg/binate/asm/x64", "tbl")
	var b @[]char = GlobalName("pkg/binate/native/x64", "tbl")
	if strEq(a, b) {
		return fail("global symbols must not collide across packages")
	}
	return ""
}

