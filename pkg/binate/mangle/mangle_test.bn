package "pkg/binate/mangle"

import "pkg/binate/buf"
import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult {
	return msg
}

func bufStr(cb buf.CharBuf) @[]char {
	return cb.Bytes()
}

func strEq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// ============================================================
// PkgPathFromQuoted
// ============================================================

func TestPkgPathFromQuotedSimple() testing.TestResult {
	var s @[]char = PkgPathFromQuoted("\"main\"")
	if !strEq(s, "main") { return fail("expected main") }
	return ""
}

func TestPkgPathFromQuotedPath() testing.TestResult {
	var s @[]char = PkgPathFromQuoted("\"pkg/parser\"")
	if !strEq(s, "pkg/parser") {
		return fail("expected pkg/parser (full path preserved)")
	}
	return ""
}

func TestPkgPathFromQuotedDeep() testing.TestResult {
	var s @[]char = PkgPathFromQuoted("\"pkg/asm/aarch64\"")
	if !strEq(s, "pkg/asm/aarch64") {
		return fail("expected pkg/asm/aarch64 (full path preserved)")
	}
	return ""
}

func TestPkgPathFromQuotedUnquoted() testing.TestResult {
	var s @[]char = PkgPathFromQuoted("main")
	if !strEq(s, "main") {
		return fail("expected main passthrough for unquoted input")
	}
	return ""
}

// ============================================================
// FuncName — full-path mangling (every `/` and `.` → `__`)
// ============================================================

func TestFuncNamePkgPath() testing.TestResult {
	var b buf.CharBuf = FuncName("pkg/parser", "parseExpr")
	if !strEq(bufStr(b), "bn_pkg__parser__parseExpr") {
		return fail("expected bn_pkg__parser__parseExpr")
	}
	return ""
}

func TestFuncNameDeepPkgPath() testing.TestResult {
	var b buf.CharBuf = FuncName("pkg/asm/x64", "Push")
	if !strEq(bufStr(b), "bn_pkg__asm__x64__Push") {
		return fail("expected bn_pkg__asm__x64__Push")
	}
	return ""
}

// The collision-avoidance pin: `pkg/asm/x64` and `pkg/native/x64`
// share the last segment `x64` but MUST produce distinct symbols.
// This is the whole point of full-path mangling.
func TestFuncNameNoLastSegmentCollision() testing.TestResult {
	var a @[]char = bufStr(FuncName("pkg/asm/x64", "Push"))
	var b @[]char = bufStr(FuncName("pkg/native/x64", "Push"))
	if strEq(a, b) {
		return fail("packages with same last segment must NOT collide")
	}
	return ""
}

// `main` is a single-segment package — no slashes to fold.
func TestFuncNameMain() testing.TestResult {
	var b buf.CharBuf = FuncName("main", "main")
	if !strEq(bufStr(b), "bn_main__main") {
		return fail("expected bn_main__main")
	}
	return ""
}

// `<main>.__entry` is the C runtime's sole entry into Binate.
// Both the bare-then-pkg form and the pre-qualified dotted form
// resolve to `bn_entry`.
func TestFuncNameMainEntry() testing.TestResult {
	var b1 buf.CharBuf = FuncName("main", "__entry")
	if !strEq(bufStr(b1), "bn_entry") {
		return fail("expected bn_entry from (main, __entry)")
	}
	var b2 buf.CharBuf = FuncName("main", "main.__entry")
	if !strEq(bufStr(b2), "bn_entry") {
		return fail("expected bn_entry from main.__entry")
	}
	return ""
}

// Pre-qualified cross-package call: the package component comes from
// the name's full-path prefix, slashes folded.
func TestFuncNameCrossPkgQualified() testing.TestResult {
	var b buf.CharBuf = FuncName("main", "pkg/parser.New")
	if !strEq(bufStr(b), "bn_pkg__parser__New") {
		return fail("expected bn_pkg__parser__New")
	}
	return ""
}

// Method on a named type, fully-path-qualified: every `/` and `.`
// becomes `__`.
func TestFuncNameMethod() testing.TestResult {
	var b buf.CharBuf = FuncName("pkg/geom", "pkg/geom.Point.M")
	if !strEq(bufStr(b), "bn_pkg__geom__Point__M") {
		return fail("expected bn_pkg__geom__Point__M")
	}
	return ""
}

func TestFuncNameMethodCrossPkg() testing.TestResult {
	var b buf.CharBuf = FuncName("main", "pkg/geom.Point.Translate")
	if !strEq(bufStr(b), "bn_pkg__geom__Point__Translate") {
		return fail("expected bn_pkg__geom__Point__Translate")
	}
	return ""
}

// ============================================================
// QualifyName
// ============================================================

func TestQualifyNameBare() testing.TestResult {
	var s @[]char = QualifyName("pkg/parser", "New")
	if !strEq(s, "pkg/parser.New") {
		return fail("expected pkg/parser.New")
	}
	return ""
}

func TestQualifyNameAlreadyDottedPassthrough() testing.TestResult {
	var s @[]char = QualifyName("pkg/parser", "pkg/other.Func")
	if !strEq(s, "pkg/other.Func") {
		return fail("already-qualified should pass through")
	}
	return ""
}

// ============================================================
// GlobalName
// ============================================================

func TestGlobalName() testing.TestResult {
	var b buf.CharBuf = GlobalName("pkg/ir", "moduleStructs")
	if !strEq(bufStr(b), "bn_pkg__ir__moduleStructs") {
		return fail("expected bn_pkg__ir__moduleStructs")
	}
	return ""
}

func TestGlobalNameNoLastSegmentCollision() testing.TestResult {
	var a @[]char = bufStr(GlobalName("pkg/asm/x64", "tbl"))
	var b @[]char = bufStr(GlobalName("pkg/native/x64", "tbl"))
	if strEq(a, b) {
		return fail("global symbols must not collide across packages")
	}
	return ""
}

// ============================================================
// StructName
// ============================================================

func TestStructNameLocal() testing.TestResult {
	var b buf.CharBuf = StructName("pkg/ir", "Instr")
	if !strEq(bufStr(b), "bn_pkg__ir__Instr") {
		return fail("expected bn_pkg__ir__Instr")
	}
	return ""
}

func TestStructNameCrossPkg() testing.TestResult {
	var b buf.CharBuf = StructName("main", "pkg/parser.Parser")
	if !strEq(bufStr(b), "bn_pkg__parser__Parser") {
		return fail("expected bn_pkg__parser__Parser")
	}
	return ""
}
