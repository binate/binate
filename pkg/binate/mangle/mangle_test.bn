// A generic-struct instantiation (sole member carries `__bn_inst__`)
// becomes a bn_T with the lp ArgList passed through.
func TestStructNameInstantiation() testing.TestResult {
	var b @[]char = StructName("pkg/foo", "pkg/foo.Box__bn_inst__1_N0_3_int")
	if !strEq(b, "bn_T2_3_pkg3_foo3_Box1_N0_3_int") {
		return fail("expected bn_T2_3_pkg3_foo3_Box1_N0_3_int")
	}
	return ""
}

// ============================================================
// IsReservedIdentifier
// ============================================================

// A `__` prefix is reserved (every synthesized helper uses it), so a
// same-named user decl would collide with a compiler symbol.
func TestIsReservedDunderPrefix() testing.TestResult {
	if !IsReservedIdentifier("__entry") { return fail("__entry reserved") }
	if !IsReservedIdentifier("__closure_1") {
		return fail("__closure_1 reserved")
	}
	// The per-package reflect accessor lives in the reserved namespace.
	if !IsReservedIdentifier("__Package") {
		return fail("__Package reserved (reflect accessor)")
	}
	if !IsReservedIdentifier("__") { return fail("__ reserved") }
	return ""
}

// The instantiation marker is reserved as an INFIX too — a user name like
// foo__bn_inst__bar would be misread as a monomorphized generic symbol.
func TestIsReservedInstMarkerInfix() testing.TestResult {
	if !IsReservedIdentifier("foo__bn_inst__bar") {
		return fail("foo__bn_inst__bar reserved (infix marker)")
	}
	// The crafted collision with a real instantiation of foo[int].
	if !IsReservedIdentifier("foo__bn_inst__1_N0_3_int") {
		return fail("crafted instantiation collision reserved")
	}
	return ""
}

// Ordinary names — including the single-underscore convention (`_Foo`) —
// are NOT reserved.  A lone `_` is the blank identifier, handled elsewhere;
// it is not a `__` prefix.
func TestIsReservedAllowsOrdinaryNames() testing.TestResult {
	if IsReservedIdentifier("parseExpr") { return fail("parseExpr ok") }
	if IsReservedIdentifier("_Package") { return fail("_Package ok") }
	if IsReservedIdentifier("_priv") { return fail("_priv ok") }
	if IsReservedIdentifier("_") { return fail("blank _ ok") }
	if IsReservedIdentifier("a__b") { return fail("infix __ (not the marker) ok") }
	return ""
}
