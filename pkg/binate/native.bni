// Package native is Binate's own code-generation backend (peer to pkg/binate/codegen).
// It targets multiple architectures via per-arch sub-packages (aarch64, x64,
// arm32).
package "pkg/binate/native"

import "pkg/binate/ir"
import "pkg/binate/native/place"

// Options holds the native backends' code-generation switches; the zero value
// is the default codegen.  A switch named for one architecture is ignored by the
// others.
type Options struct {
	// X64RaxHome (bnc -fx64-rax-home, off by default) adds RAX to the x64
	// backend's caller-saved GP home pool; the aarch64 and arm32 backends ignore
	// it.
	X64RaxHome bool
	// X64FarDisp (bnc -fx64-far-disp=N, a test aid; 0, the default, leaves it off)
	// has the x64 backend address a frame slot past displacement N the way it
	// addresses one past a signed 32-bit displacement — through a register — so an
	// ordinary program exercises those paths (no test can run a 2 GiB frame); the
	// aarch64 and arm32 backends ignore it.
	X64FarDisp int
	// Place (bnc -fnative-place-seed / -fnative-place-mode, and
	// -fnative-place-probe / -fnative-place-probe-phase for a probe) inserts trap
	// filler around functions to choose where they land, a measurement aid that
	// reaches all three backends (place.PlaceOptions).  The zero value leaves the
	// output unchanged.
	Place place.PlaceOptions
}

// EmitObject lowers an IR module to a native object file for the given arch,
// with the code-generation switches in opts, and writes it to path. Returns
// true on success.
//
// Supported arch names:
//   - "aarch64" / "arm64" — pkg/binate/native/aarch64
//   - "x86_64" / "x64"    — pkg/binate/native/x64 (SysV-AMD64)
//   - "arm32" / "arm"     — pkg/binate/native/arm32 (ELF32, AAPCS32)
// `format` ("macho" / "elf") is an independent axis from arch.
func EmitObject(mod @ir.Module, arch *[]readonly char, format *[]readonly char,
		path *[]readonly char, opts Options) bool

// SetCopyStats turns on (or off) the tally of the aggregate copies the native backends
// emit (bnc's experimental --x-copy-stats; only the aarch64 backend counts), clearing
// it; CopyStatsReport returns the tally as a table.
func SetCopyStats(on bool)

// CopyStatsReport returns the copy tally SetCopyStats turned on, as a table.
func CopyStatsReport() @[]char
