// Package arm64 is the AArch64 backend of pkg/binate/native. Named arm64 (not
// aarch64) so its mangled short name doesn't collide with pkg/binate/asm/aarch64.
// Emits a Mach-O (or ELF) object file that links with the Binate runtime
// (pkg/builtins/rt + startup) and the platform libc.
package "pkg/binate/native/aarch64"

import "pkg/binate/ir"
import "pkg/binate/native/place"

// Options holds the aarch64 backend's code-generation switches; the zero value
// is the default codegen.
type Options struct {
	// Place positions functions with BRK #place.PLACE_FILL_IMM filler, in 4-byte
	// units, before each function and right after a probed function
	// (place.PlaceOptions; bnc -fnative-place-seed / -fnative-place-probe).  The
	// zero value adds none.
	Place place.PlaceOptions
}

// EmitObject lowers an IR module to AArch64 and writes a .o file in
// the requested object `format` ("macho" / "elf"; defaults to Mach-O),
// with the code-generation switches in opts.
// Caller links the resulting object with the Binate runtime
// (pkg/builtins/rt + startup) and libc.
func EmitObject(mod @ir.Module, format *[]readonly char, path *[]readonly char, opts Options) bool
