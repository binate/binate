package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/macho"
import "pkg/binate/ir"

// ============================================================
// EmitObject — module entry
// ============================================================

// objFmtEq compares two object-format selector strings.
func objFmtEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// EmitObject emits one __text section containing every function in the
// module, plus a string table with collected literals, resolves
// fixups, and writes the object file in `format` ("macho" or "elf";
// anything else defaults to Mach-O, this backend's native format on
// macOS).  Both the writer (Phase 2) and the symbol-linkage prefix
// (Phase 4: `_` for Mach-O, bare for ELF, via objEmitElf) follow the
// object-format axis — see plan-backend-objformat-decoupling.md.
func EmitObject(mod @ir.Module, format *[]readonly char,
		path *[]readonly char) bool {
	// Set the symbol-linkage convention before any name is emitted:
	// ELF symbols are bare, Mach-O symbols carry a leading '_'.
	objEmitElf = objFmtEq(format, "elf")
	mod.FinalizeStrings()

	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)

	// Full package path; the mangler short-names it internally for
	// now (full-path migration — see pkg/binate/mangle).
	var pkgName *[]readonly char = stripQuotes(mod.Name)

	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		emitFunc(a, pkgName, f, mod.Strings, mod.Funcs)
	}

	emitFuncValueShims(a, pkgName, mod)
	emitStringTable(a, mod.Strings)
	emitGlobals(a, pkgName, mod.Globals)
	emitFuncValueVtables(a, pkgName, mod)
	emitImplVtables(a, pkgName, mod)
	emitPackageDescriptor(a, pkgName)

	aarch64.ResolveFixups(a)
	a.Finalize()

	// Restore the Mach-O default before returning so objEmitElf never
	// leaks past one EmitObject — direct symFor/globalSymFor callers
	// (and the next EmitObject) start from this backend's macOS default.
	var isElf bool = objEmitElf
	objEmitElf = false
	if a.HasError { return false }
	if isElf {
		return elf.WriteAArch64(a, path)
	}
	return macho.WriteARM64(a, path)
}

// emitStringTable emits every collected string literal with a local
// label `Lstr_<id>` pointing at its bytes. Strings live in the
// `text` section alongside code; reaches go through ADRP+ADD pairs
// (PAGE21+PAGEOFF12 relocs) since Mach-O has no ADR reloc and ADR's
// ±1MB range can't span a large module.
func emitStringTable(a @asm.Assembler, strings @[]ir.StringConst) {
	if len(strings) == 0 { return }
	for i := 0; i < len(strings); i++ {
		var sc ir.StringConst = strings[i]
		a.DefineLabel(stringLabel(sc.ID))
		a.EmitAsciz(sc.Data)
	}
	// Pad back up to instruction alignment so any subsequent emissions
	// stay on 4-byte boundaries.
	a.Align(4)
}

// charEqAA64 compares two char slices for equality. Local helper
// (pkg/binate/native/arm64 doesn't pull in pkg/binate/buf's full set).
func charEqAA64(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// emitGlobals emits package-level variable storage in a new __DATA
// section. Each global gets a mangled `_bn_<pkg>__<name>` label
// followed by g.Typ.SizeOf() zero bytes. pkg/binate/asm/macho maps the
// assembler "data" section to Mach-O __DATA,__data and advertises it
// with 8-byte alignment (see machoSectAlign) so 64-bit LDRs don't
// SIGBUS after the linker splices .o's together. Use sites reach the
// symbol via ADRP+ADD (see emitGlobalAddr).
func emitGlobals(a @asm.Assembler, pkgName *[]readonly char,
	globals @[]@ir.Global) {
	if len(globals) == 0 { return }
	// Open the __DATA section lazily — only once a real (non-extern) global
	// is about to be emitted.  A module whose globals are ALL imported
	// extern vars (skipped below) would otherwise leave an empty data
	// section behind, which the Mach-O writer turns into a malformed load
	// command.
	var sectionOpen bool = false
	for i := 0; i < len(globals); i++ {
		var g @ir.Global = globals[i]
		if g == nil { continue }
		// An imported extern var (a `.bni`-declared `var X T` from another
		// package) is DEFINED by its owning package's object file; here it
		// is only referenced, so emit no storage — a definition would be a
		// duplicate symbol at link time.  The reference (emitGlobalAddr)
		// mangles to the owner's symbol and resolves cross-object, exactly
		// as the LLVM backend's `external global` declaration does.
		if g.IsExtern { continue }
		if !sectionOpen {
			a.SetSection("data", -1)
			sectionOpen = true
		}
		var label @[]char = globalSymFor(pkgName, g.Name)
		a.DefineLabel(label)
		a.SetGlobal(label)
		var sz int = 8
		if g.Typ != nil { sz = g.Typ.SizeOf() }
		if sz < 8 { sz = 8 }
		if sz % 8 != 0 { sz = sz + (8 - sz % 8) }
		for b := 0; b < sz; b = b + 1 {
			a.EmitUint8(cast(uint8, 0))
		}
	}
}
