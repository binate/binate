package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/macho"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/native/common"

// ============================================================
// EmitObject — module entry
// ============================================================

// objFmtEq compares two object-format selector strings.
func objFmtEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// EmitObject emits one __text section containing every function in the
// module, plus a string table with collected literals, resolves
// fixups, and writes the object file in `format` ("macho" or "elf";
// anything else defaults to Mach-O, this backend's native format on
// macOS).  Both the writer (Phase 2) and the symbol-linkage prefix
// (Phase 4: `_` for Mach-O, bare for ELF, via objEmitElf) follow the
// object-format axis — see plan-backend-objformat-decoupling.md.
func EmitObject(mod @ir.Module, format *[]readonly char, path *[]readonly char) bool {
	// Set the symbol-linkage convention before any name is emitted:
	// ELF symbols are bare, Mach-O symbols carry a leading '_'.
	objEmitElf = objFmtEq(format, "elf")
	mod.FinalizeStrings()

	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)

	// Full package path; the mangler short-names it internally for
	// now (full-path migration — see pkg/binate/mangle).
	var pkgName *[]readonly char = stripQuotes(mod.Name)

	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		emitFunc(a, pkgName, f, mod.Strings, mod.Funcs)
	}

	emitFuncValueShims(a, pkgName, mod)
	emitStringTable(a, pkgName, mod.Strings)
	emitGlobals(a, pkgName, mod.Globals)
	emitFuncValueVtables(a, pkgName, mod)
	emitImplVtables(a, pkgName, mod)
	emitPackageDescriptor(a, pkgName, mod)
	// Whole-program SatEntry root (main module + native-codegen driver only;
	// gated on mod.SatRootRequested inside).  After the descriptor so this
	// module's own `_pkg_satentries` is already defined.  symPrefixed("") is the
	// active object-format linkage prefix ("" ELF / "_" Mach-O).
	common.EmitSatEntryRoot(a, symPrefixed(""), mod)

	aarch64.ResolveFixups(a)
	a.Finalize()

	// Restore the Mach-O default before returning so objEmitElf never
	// leaks past one EmitObject — direct symFor/globalSymFor callers
	// (and the next EmitObject) start from this backend's macOS default.
	var isElf bool = objEmitElf
	objEmitElf = false
	if a.HasError {
		common.ReportEmitError(a, "aarch64")
		return false
	}
	if isElf {
		return elf.WriteAArch64(a, path)
	}
	return macho.WriteARM64(a, path)
}

// emitStringTable emits, per collected string literal: a read-only byte blob
// (`Lstr_<id>`, via irdata.BuildStringBlob — exactly the literal's bytes, no NUL,
// reloc-free → rodata `__TEXT,__const`) and a static managed-slice header
// (`stringMSSym`, via irdata.BuildStringMSHeader — carries a data pointer, so weak
// + module-qualified in `data`).  The OP_RODATA_MSLICE/SLICE use-sites address
// the header directly instead of building it on the stack per use.  Reaches go
// through ADRP+ADD pairs (PAGE21+PAGEOFF12 relocs) since Mach-O has no ADR reloc
// and ADR's ±1MB range can't span a large module.
func emitStringTable(a @asm.Assembler, pkgName *[]readonly char, strings @[]ir.StringConst) {
	for i := 0; i < len(strings); i++ {
		var sc ir.StringConst = strings[i]
		common.EmitDataGlobal(a, irdata.BuildStringBlob(stringLabel(sc.ID), sc.Data))
	}
	for i := 0; i < len(strings); i++ {
		var sc ir.StringConst = strings[i]
		common.EmitDataGlobal(a,
				irdata.BuildStringMSHeader(
						stringMSSym(pkgName, sc.ID), stringLabel(sc.ID), sc.Len, irdata.DG_WEAK))
	}
}

// charEqAA64 compares two char slices for equality. Local helper
// (pkg/binate/native/arm64 doesn't pull in pkg/binate/buf's full set).
func charEqAA64(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// emitGlobals emits package-level variable storage via the shared
// irdata.BuildGlobalVar (a mutable, strong, SizeOf-byte zero blob, AlignOf-aligned)
// lowered through common.EmitDataGlobal — the same builder the LLVM backend
// uses, so the storage size can't drift (the old hand-rolled path rounded up to
// 8 bytes, vs LLVM's exact type size).  EmitDataGlobal opens the writable `data`
// section (Mach-O __DATA,__data) lazily, only for a non-extern global, so a
// module whose globals are ALL imported externs leaves no empty (malformed)
// data section behind.  Use sites reach the symbol via ADRP+ADD (emitGlobalAddr).
func emitGlobals(a @asm.Assembler, pkgName *[]readonly char, globals @[]@ir.Global) {
	for i := 0; i < len(globals); i++ {
		var g @ir.Global = globals[i]
		if g == nil { continue }
		// An imported extern var is DEFINED by its owning package's object;
		// here it is only referenced, so emit no storage (a definition would
		// be a duplicate symbol at link time) — not a DataGlobal.  The
		// reference (emitGlobalAddr) mangles to the owner's symbol and resolves
		// cross-object, exactly as the LLVM `external global` declaration does.
		if g.IsExtern { continue }
		var sz int = 8
		var al int = 8
		if g.Typ != nil {
			sz = g.Typ.SizeOf()
			al = g.Typ.AlignOf()
		}
		common.EmitDataGlobal(a, irdata.BuildGlobalVar(globalSymFor(pkgName, g.Name), sz, al))
	}
}
