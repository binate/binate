package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/native/common"

// A large aggregate copy or zero-fill is a loop rather than straight-line code, so its
// code size stays constant whatever the aggregate's size — straight-line, a [5000]uint8
// is over a thousand instructions, at every copy.  Up to aggCopyUnrollMaxBytes it stays
// straight-line: the code is still small there, and pays no loop overhead.  Each loop
// branches back with its displacement already resolved (aarch64.BcondOffset), so it
// records no fixup: the function emitter takes a fixup for a branch out of the op and
// drops its register cache, which a loop running wholly within the op does not need.

// aggCopyUnrollMaxBytes is the largest copy or zero-fill emitted straight-line (eight
// LDP / STP pairs, or sixteen zero-word stores).
const aggCopyUnrollMaxBytes int = 128

// aggCopyLoopChunk is how many bytes one iteration of a copy or zero-fill loop moves.
const aggCopyLoopChunk int = 32

// aggCopyIsLoop reports whether an sz-byte copy or zero-fill is a loop.
func aggCopyIsLoop(sz int) bool {
	return sz > aggCopyUnrollMaxBytes
}

// branchBackAarch64 emits B.cond back to the instruction at byte offset top of the
// current section (a loop's first instruction).
func branchBackAarch64(a @asm.Assembler, cond int, top int) {
	aarch64.BcondOffset(a, cond, top - a.Sections[a.Current].Len)
}

// emitAggCopyLoopAarch64 copies sz bytes from [srcBase + srcOff] to [dstBase + dstOff]
// with a loop (emitCopyLoopAarch64) over two claimed cursor registers pointed at the two
// ends, counted in a third (scratchReg, which evicts a cached value loss-free; both bases
// are marked claimed first so neither is evicted).
func emitAggCopyLoopAarch64(a @asm.Assembler, rm @common.RegMap, dstBase int, dstOff int,
		srcBase int, srcOff int, sz int) {
	rm.MarkUsed(dstBase)
	rm.MarkUsed(srcBase)
	var src int = scratchReg(rm)
	var dst int = scratchReg(rm)
	var count int = scratchReg(rm)
	aarch64.Add(a, true, src, srcBase, aarch64.Imm(srcOff))
	aarch64.Add(a, true, dst, dstBase, aarch64.Imm(dstOff))
	emitCopyLoopAarch64(a, dst, src, sz, count)
}

// emitCopyLoopAarch64 copies sz bytes (at least aggCopyLoopChunk) from [src] to [dst],
// 32 bytes per iteration: an LDP / STP of Q16 / Q17 — the full vector registers of the
// FP scratch pair, which hold nothing across ops — advancing both cursors by post-index,
// with count counting the iterations down.  The sz % 32 bytes left over are copied by
// re-copying the 32 bytes that end at sz, off the advanced cursors: that overlaps bytes
// the loop already copied, which is harmless as the source and destination are
// disjoint (or the same bytes).  It needs no register map: the three registers are the
// caller's, all distinct; the cursors are left advanced.
func emitCopyLoopAarch64(a @asm.Assembler, dst int, src int, sz int, count int) {
	if sz < aggCopyLoopChunk {
		a.SetError("native aarch64: a copy loop needs at least 32 bytes")
		return
	}
	emitConstInt64(a, count, cast(int64, sz / aggCopyLoopChunk))
	var top int = a.Sections[a.Current].Len
	aarch64.Vldp_q_post(a, aarch64.V16, aarch64.V17, src, aggCopyLoopChunk)
	aarch64.Vstp_q_post(a, aarch64.V16, aarch64.V17, dst, aggCopyLoopChunk)
	aarch64.Subs(a, true, count, count, aarch64.Imm(1))
	branchBackAarch64(a, aarch64.COND_NE, top)
	var rest int = sz % aggCopyLoopChunk
	if rest > 0 {
		aarch64.Vldr_q(a, aarch64.V16, src, rest - 32)
		aarch64.Vldr_q(a, aarch64.V17, src, rest - 16)
		aarch64.Vstr_q(a, aarch64.V16, dst, rest - 32)
		aarch64.Vstr_q(a, aarch64.V17, dst, rest - 16)
	}
}

// emitCopyAarch64 copies sz bytes from [src] to [dst] with only the registers it is
// given — t1 and t2 besides the two pointers, all distinct — for code that has no
// register map (a shim): a loop past aggCopyUnrollMaxBytes (t1 counting; the pointers
// are left advanced), else straight-line through t1 / t2.
func emitCopyAarch64(a @asm.Assembler, dst int, src int, sz int, t1 int, t2 int) {
	if aggCopyIsLoop(sz) {
		emitCopyLoopAarch64(a, dst, src, sz, t1)
		return
	}
	emitAggCopyStraightAarch64(a, dst, src, sz, t1, t2)
}

// emitFrameZeroAarch64 zero-fills the sz-byte frame region at [SP + off] (sz a multiple
// of 8, as PlanFrame rounds every region): a zero word at a time up to
// aggCopyUnrollMaxBytes, else with a loop storing 32 zero bytes per iteration (two
// post-indexed STP XZR, XZR) off a claimed cursor register, counted in another; the
// sz % 32 bytes left over follow as zero words off the advanced cursor.
func emitFrameZeroAarch64(a @asm.Assembler, rm @common.RegMap, off int, sz int) {
	if !aggCopyIsLoop(sz) {
		for bo := 0; bo < sz; bo = bo + 8 {
			aarch64.Str(a, true, aarch64.XZR, aarch64.MemImm(aarch64.SP, off + bo))
		}
		return
	}
	var cur int = scratchReg(rm)
	var count int = scratchReg(rm)
	aarch64.Add(a, true, cur, aarch64.SP, aarch64.Imm(off))
	emitConstInt64(a, count, cast(int64, sz / aggCopyLoopChunk))
	var top int = a.Sections[a.Current].Len
	aarch64.Stp(a, true, aarch64.XZR, aarch64.XZR, aarch64.MemPost(cur, 16))
	aarch64.Stp(a, true, aarch64.XZR, aarch64.XZR, aarch64.MemPost(cur, 16))
	aarch64.Subs(a, true, count, count, aarch64.Imm(1))
	branchBackAarch64(a, aarch64.COND_NE, top)
	for bo := 0; bo < sz % aggCopyLoopChunk; bo = bo + 8 {
		aarch64.Str(a, true, aarch64.XZR, aarch64.MemImm(cur, bo))
	}
}
