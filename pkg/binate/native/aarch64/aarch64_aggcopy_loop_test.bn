package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/builtins/testing"

// Tests for the copy / zero-fill loops (aarch64_aggcopy_loop.bn): past
// aggCopyUnrollMaxBytes a copy or zero-fill is a loop whose code size does not grow with
// the aggregate, branching back without a fixup.

// sameTextAA64 reports whether two assemblers emitted the same text bytes.
func sameTextAA64(a @asm.Assembler, b @asm.Assembler) bool {
	if a.Sections[0].Len != b.Sections[0].Len { return false }
	for i := 0; i < a.Sections[0].Len; i++ {
		if a.Sections[0].Data[i] != b.Sections[0].Data[i] { return false }
	}
	return true
}

// hexWordsEqAA64 reports whether a's text is the instruction words spelled in hex,
// eight digits a word, separated by single spaces.
func hexWordsEqAA64(a @asm.Assembler, hex *[]readonly char) bool {
	if a.Sections[0].Len != (len(hex) + 1) / 9 * 4 { return false }
	for i := 0; i < a.Sections[0].Len / 4; i++ {
		var want uint32 = 0
		for d := 0; d < 8; d++ {
			var c char = hex[9 * i + d]
			var v uint32 = cast(uint32, c - '0')
			if c >= 'a' { v = cast(uint32, c - 'a') + 10 }
			want = (want << 4) | v
		}
		var got uint32 = cast(uint32, a.Sections[0].Data[4 * i]) |
				(cast(uint32, a.Sections[0].Data[4 * i + 1]) << 8) |
				(cast(uint32, a.Sections[0].Data[4 * i + 2]) << 16) |
				(cast(uint32, a.Sections[0].Data[4 * i + 3]) << 24)
		if got != want { return false }
	}
	return true
}

// The copy and zero-fill loops below, as clang encodes the same instructions.
func TestAggCopyLoopClangGoldens() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitAggMemcpyAarch64(a, common.NewRegMap(callconv.AAPCS64()), aarch64.X10, aarch64.X9, 5000)
	if !hexWordsEqAA64(a,
			"9100012b 9100014c d280138d acc14570 ac814590 f10005ad 54ffffa1 "
					"3cde8170 3cdf8171 3c9e8190 3c9f8191") {
		return fail("the 5000-byte copy loop differs from clang's encoding")
	}
	var b @asm.Assembler = opsMkAssembler()
	emitFrameZeroAarch64(b, common.NewRegMap(callconv.AAPCS64()), 16, 4400)
	if !hexWordsEqAA64(b, "910043e9 d280112a a8817d3f a8817d3f f100054a 54ffffa1 f900013f f900053f") {
		return fail("the 4400-byte zero-fill loop differs from clang's encoding")
	}
	return ""
}

// A 5000-byte copy is the 32-byte LDP / STP Q loop on cursors X11 / X12 (the two
// pointers X9 / X10 claimed first), 156 iterations counted in X13, then the 8 bytes left
// over by re-copying the last 32 bytes off the advanced cursors.
func TestAggCopyLoopByteRef() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitAggMemcpyAarch64(a, common.NewRegMap(callconv.AAPCS64()), aarch64.X10, aarch64.X9, 5000)
	var ref @asm.Assembler = opsMkAssembler()
	aarch64.Add(ref, true, aarch64.X11, aarch64.X9, aarch64.Imm(0))
	aarch64.Add(ref, true, aarch64.X12, aarch64.X10, aarch64.Imm(0))
	emitConstInt64(ref, aarch64.X13, 156)
	aarch64.Vldp_q_post(ref, aarch64.V16, aarch64.V17, aarch64.X11, 32)
	aarch64.Vstp_q_post(ref, aarch64.V16, aarch64.V17, aarch64.X12, 32)
	aarch64.Subs(ref, true, aarch64.X13, aarch64.X13, aarch64.Imm(1))
	aarch64.BcondOffset(ref, aarch64.COND_NE, -12)
	aarch64.Vldr_q(ref, aarch64.V16, aarch64.X11, -24)
	aarch64.Vldr_q(ref, aarch64.V17, aarch64.X11, -8)
	aarch64.Vstr_q(ref, aarch64.V16, aarch64.X12, -24)
	aarch64.Vstr_q(ref, aarch64.V17, aarch64.X12, -8)
	if a.HasError || !sameTextAA64(a, ref) || a.Sections[0].NumFixups != 0 {
		return fail("a 5000-byte copy must be the 32-byte Q loop plus the overlapping last 32 bytes")
	}
	return ""
}

// A copy to [base + offset] that is a loop forms the destination in its cursor; a whole
// number of chunks leaves nothing over.
func TestAggCopyToLoopFoldsDestOffset() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitAggCopyToAarch64(a, common.NewRegMap(callconv.AAPCS64()), aarch64.SP, 0x40, aarch64.X9, 4096)
	var ref @asm.Assembler = opsMkAssembler()
	aarch64.Add(ref, true, aarch64.X10, aarch64.X9, aarch64.Imm(0))
	aarch64.Add(ref, true, aarch64.X11, aarch64.SP, aarch64.Imm(0x40))
	emitConstInt64(ref, aarch64.X12, 128)
	aarch64.Vldp_q_post(ref, aarch64.V16, aarch64.V17, aarch64.X10, 32)
	aarch64.Vstp_q_post(ref, aarch64.V16, aarch64.V17, aarch64.X11, 32)
	aarch64.Subs(ref, true, aarch64.X12, aarch64.X12, aarch64.Imm(1))
	aarch64.BcondOffset(ref, aarch64.COND_NE, -12)
	if a.HasError || !sameTextAA64(a, ref) {
		return fail("a 4096-byte copy to sp+0x40 must be the Q loop on a cursor at sp+0x40")
	}
	return ""
}

// At the threshold a copy stays straight-line — 128 bytes is eight LDP / STP pairs —
// and one byte more is the loop.
func TestAggCopyUnrolledAtThreshold() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitAggMemcpyAarch64(a, common.NewRegMap(callconv.AAPCS64()), aarch64.X10, aarch64.X9, 128)
	if opsBytes(a) != 64 { return fail("a 128-byte copy stays unrolled (16 instructions)") }
	var b @asm.Assembler = opsMkAssembler()
	emitAggMemcpyAarch64(b, common.NewRegMap(callconv.AAPCS64()), aarch64.X10, aarch64.X9, 129)
	if opsBytes(b) != 44 { return fail("a 129-byte copy is the loop (11 instructions)") }
	return ""
}

// A large frame region is zeroed by a loop storing two zero pairs per iteration off a
// cursor at the region, then the 16 bytes left over as zero words.
func TestFrameZeroLoopByteRef() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitFrameZeroAarch64(a, common.NewRegMap(callconv.AAPCS64()), 16, 4400)
	var ref @asm.Assembler = opsMkAssembler()
	aarch64.Add(ref, true, aarch64.X9, aarch64.SP, aarch64.Imm(16))
	emitConstInt64(ref, aarch64.X10, 137)
	aarch64.Stp(ref, true, aarch64.XZR, aarch64.XZR, aarch64.MemPost(aarch64.X9, 16))
	aarch64.Stp(ref, true, aarch64.XZR, aarch64.XZR, aarch64.MemPost(aarch64.X9, 16))
	aarch64.Subs(ref, true, aarch64.X10, aarch64.X10, aarch64.Imm(1))
	aarch64.BcondOffset(ref, aarch64.COND_NE, -12)
	aarch64.Str(ref, true, aarch64.XZR, aarch64.MemImm(aarch64.X9, 0))
	aarch64.Str(ref, true, aarch64.XZR, aarch64.MemImm(aarch64.X9, 8))
	if a.HasError || !sameTextAA64(a, ref) || a.Sections[0].NumFixups != 0 {
		return fail("a 4400-byte zero-fill must be the two-pair store loop plus two zero words")
	}
	var b @asm.Assembler = opsMkAssembler()
	emitFrameZeroAarch64(b, common.NewRegMap(callconv.AAPCS64()), 16, 128)
	if opsBytes(b) != 64 { return fail("a 128-byte zero-fill stays unrolled (16 stores)") }
	return ""
}

// A zero-fill through a pointer covers exactly the bytes asked for (the memory may end
// there): 20 bytes at [X9] are two 64-bit zero stores and a 32-bit one at byte 16; 23
// bytes add a 16-bit store at byte 20 and a byte store at 22.
func TestZeroAtExactAarch64() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitZeroAtAarch64(a, common.NewRegMap(callconv.AAPCS64()), aarch64.X9, 0, 20)
	var ref @asm.Assembler = opsMkAssembler()
	aarch64.Str(ref, true, aarch64.XZR, aarch64.MemImm(aarch64.X9, 0))
	aarch64.Str(ref, true, aarch64.XZR, aarch64.MemImm(aarch64.X9, 8))
	aarch64.StrSized(ref, 4, aarch64.XZR, aarch64.MemImm(aarch64.X9, 16))
	if a.HasError || !sameTextAA64(a, ref) { return fail("20 bytes: two words and a 32-bit store") }
	var b @asm.Assembler = opsMkAssembler()
	emitZeroAtAarch64(b, common.NewRegMap(callconv.AAPCS64()), aarch64.X9, 0, 23)
	aarch64.StrSized(ref, 2, aarch64.XZR, aarch64.MemImm(aarch64.X9, 20))
	aarch64.StrSized(ref, 1, aarch64.XZR, aarch64.MemImm(aarch64.X9, 22))
	if b.HasError || !sameTextAA64(b, ref) { return fail("23 bytes: and a 16-bit and a byte store") }
	return ""
}

// Past the unroll limit the whole words are a loop, and the sub-word tail still ends
// exactly at sz: 203 bytes at [X0] end with a 16-bit store at byte 200 and a byte store
// at 202.
func TestZeroAtLoopTailAarch64() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitZeroAtAarch64(a, common.NewRegMap(callconv.AAPCS64()), aarch64.X0, 0, 203)
	var tail @asm.Assembler = opsMkAssembler()
	aarch64.StrSized(tail, 2, aarch64.XZR, aarch64.MemImm(aarch64.X0, 200))
	aarch64.StrSized(tail, 1, aarch64.XZR, aarch64.MemImm(aarch64.X0, 202))
	var n int = a.Sections[0].Len
	if a.HasError || n > 64 { return "a 203-byte zero-fill is a loop plus its tail" }
	for i := 0; i < 8; i++ {
		if a.Sections[0].Data[n - 8 + i] != tail.Sections[0].Data[i] {
			return "the fill ends with the 16-bit and byte stores at 200 and 202"
		}
	}
	return ""
}
