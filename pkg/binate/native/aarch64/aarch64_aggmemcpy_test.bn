package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/builtins/testing"

// Tests for aarch64_aggmemcpy.bn: the aggregate copy primitives.

// emitAggMemcpyAarch64 moves 16 bytes per LDP/STP pair (two words in one
// instruction) with a single-word LDR/STR tail, so an N-word aggregate move
// costs ceil(N/2) pairs (+ one odd word) rather than N load/store pairs.  The
// 64-bit signed-offset LDP/STP opcodes have high byte 0xA9; a 64-bit LDR/STR
// (immediate) has high byte 0xF9.
func TestEmitAggMemcpy32BytesUsesTwoPairs() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitAggMemcpyAarch64(a, common.NewRegMap(callconv.AAPCS64()), 10, 9, 32)
	if opsBytes(a) != 16 { return "32-byte copy should be 2 LDP + 2 STP = 16 bytes" }
	if a.Sections[0].Data[3] != 0xA9 {
		return "first instr of a >=2-word copy should be an LDP (0xA9)"
	}
	return ""
}

func TestEmitAggMemcpy8BytesUsesSingleWord() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitAggMemcpyAarch64(a, common.NewRegMap(callconv.AAPCS64()), 10, 9, 8)
	if opsBytes(a) != 8 { return "8-byte copy should be 1 LDR + 1 STR = 8 bytes" }
	if a.Sections[0].Data[3] != 0xF9 { return "a single-word copy should use LDR (0xF9), not a pair" }
	return ""
}

func TestEmitAggMemcpy24BytesPairThenWord() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitAggMemcpyAarch64(a, common.NewRegMap(callconv.AAPCS64()), 10, 9, 24)
	// One 16-byte pair then one 8-byte word: LDP + STP + LDR + STR = 16 bytes.
	if opsBytes(a) != 16 { return "24-byte copy should be LDP+STP+LDR+STR = 16 bytes" }
	return ""
}

// emitAggMemcpySafeAarch64 must be OVERLAP-SAFE: it loads the WHOLE source before
// storing, so for a multi-word copy every LOAD (LDP/LDR, bit 22 = 1) precedes every
// STORE (STP/STR, bit 22 = 0).  A 24-byte copy is 2 loads (LDP + LDR) then 2 stores.
func TestEmitAggMemcpySafeLoadsBeforeStores() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	emitAggMemcpySafeAarch64(a, m, 10, 9, 24, true)
	var n int = opsBytes(a)
	if n != 16 { return "24-byte overlap-safe copy should be 2 loads + 2 stores = 16 bytes" }
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var d *[]uint8 = a.Sections[0].Data
	var lastLoad int = -1
	var firstStore int = -1
	for off := 0; off + 4 <= n; off = off + 4 {
		var w uint32 = cast(uint32, d[off]) | (cast(uint32, d[off + 1]) << 8) |
				(cast(uint32, d[off + 2]) << 16) | (cast(uint32, d[off + 3]) << 24)
		if ((w >> 22) & cast(uint32, 0x1)) == cast(uint32, 0x1) {
			lastLoad = off
		} else if firstStore < 0 {
			firstStore = off
		}
	}
	if lastLoad < 0 || firstStore < 0 || lastLoad >= firstStore {
		return "overlap-safe copy must emit every load before every store"
	}
	return ""
}

// instrTopByte returns the most significant byte of the i-th 4-byte instruction.
func instrTopByte(a @asm.Assembler, i int) uint8 { return a.Sections[0].Data[4 * i + 3] }

// An 11-byte copy moves one word, then the 3-byte tail exactly — LDRH/STRH and
// LDRB/STRB (top bytes 0x79 and 0x39), never a word store past byte 11, which
// would overwrite whatever follows the destination.
func TestEmitAggMemcpySubWordTailIsExact() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitAggMemcpyAarch64(a, common.NewRegMap(callconv.AAPCS64()), 10, 9, 11)
	if opsBytes(a) != 24 { return "11-byte copy should be word + halfword + byte = 6 instructions" }
	if instrTopByte(a, 3) != 0x79 || instrTopByte(a, 5) != 0x39 {
		return "the 3-byte tail should be stored as STRH then STRB"
	}
	return ""
}

// The overlap-safe copy covers a tail from 8 bytes up with one overlapping word
// ending at the size — an unscaled LDUR/STUR (top byte 0xF8) at offset 3 for an
// 11-byte copy — still loading everything before storing anything.
func TestEmitAggMemcpySafeOverlappingTailWord() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	emitAggMemcpySafeAarch64(a, m, 10, 9, 11, true)
	if opsBytes(a) != 16 { return "11-byte overlap-safe copy should be 2 loads + 2 stores" }
	if instrTopByte(a, 1) != 0xF8 || instrTopByte(a, 3) != 0xF8 {
		return "the tail word should be an unscaled LDUR/STUR ending at the size"
	}
	return ""
}

// Below 8 bytes the overlap-safe copy is two sub-word pieces at most: a 7-byte
// copy is two 4-byte words (at 0 and 3), never an 8-byte store.
func TestEmitAggMemcpySafeSevenBytes() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	emitAggMemcpySafeAarch64(a, m, 10, 9, 7, true)
	if opsBytes(a) != 16 { return "7-byte overlap-safe copy should be 2 loads + 2 stores" }
	for i := 0; i < 4; i++ {
		var top uint8 = instrTopByte(a, i)
		if top != 0xB9 && top != 0xB8 { return "a 7-byte copy should use only 32-bit accesses" }
	}
	return ""
}

// opsWord returns the i-th 4-byte instruction of a's text.
func opsWord(a @asm.Assembler, i int) uint32 {
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var d *[]uint8 = a.Sections[0].Data
	return cast(uint32, d[4 * i]) | (cast(uint32, d[4 * i + 1]) << 8) |
			(cast(uint32, d[4 * i + 2]) << 16) | (cast(uint32, d[4 * i + 3]) << 24)
}

// From 33 to 64 bytes the overlap-safe copy loads the whole source into four vector
// registers, 16 bytes each (the last chunk ending at the size), before storing any:
// ceil(size / 16) Q loads (bit 22 set), then as many Q stores.
func TestEmitAggMemcpySafeVectorChunks() testing.TestResult {
	var sizes @[]int = @[]int{36, 40, 64}
	for si := 0; si < len(sizes); si++ {
		var a @asm.Assembler = opsMkAssembler()
		emitAggMemcpySafeAarch64(a, common.NewRegMap(callconv.AAPCS64()), 10, 9, sizes[si], true)
		var n int = (sizes[si] + 15) / 16
		if opsBytes(a) != 8 * n {
			return "a vector overlap-safe copy is one Q load and one Q store per chunk"
		}
		for i := 0; i < 2 * n; i++ {
			var w uint32 = opsWord(a, i)
			var isLoad bool = ((w >> 22) & cast(uint32, 1)) == cast(uint32, 1)
			if (w & cast(uint32, 0x3E000000)) != cast(uint32, 0x3C000000) {
				return "each chunk is a 128-bit SIMD&FP load or store"
			}
			if isLoad != (i < n) { return "every chunk is loaded before any is stored" }
		}
	}
	return ""
}

// A size that is not a multiple of 16 moves its last chunk back to end exactly at the
// size, overlapping the chunk before it.
func TestAggVecChunkOff() testing.TestResult {
	if aggVecChunkOff(1, 36) != 16 || aggVecChunkOff(2, 36) != 20 {
		return "a 36-byte copy's chunks are at 0, 16 and 20"
	}
	if aggVecChunkOff(2, 40) != 24 || aggVecChunkOff(3, 64) != 48 {
		return "the last chunk ends at the size"
	}
	return ""
}

// Up to 64 bytes the overlap-safe copy is branch-free: it loads all of the source
// before storing any of it, at every size.
func TestEmitAggMemcpySafeLoadsFirstUpTo64() testing.TestResult {
	for sz := 1; sz <= 64; sz++ {
		var a @asm.Assembler = opsMkAssembler()
		emitAggMemcpySafeAarch64(a, common.NewRegMap(callconv.AAPCS64()), 10, 9, sz, true)
		var stored bool = false
		for i := 0; i < opsBytes(a) / 4; i++ {
			var w uint32 = opsWord(a, i)
			if ((w >> 25) & cast(uint32, 5)) != cast(uint32, 4) {
				return "the copy is only loads and stores"
			}
			var isLoad bool = ((w >> 22) & cast(uint32, 1)) == cast(uint32, 1)
			if isLoad && stored { return "a copy within the budget loads its whole source first" }
			if !isLoad { stored = true }
		}
	}
	return ""
}
