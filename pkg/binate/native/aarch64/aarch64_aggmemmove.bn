package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/native/common"

// The overlap-safe copy of an aggregate too large to load whole into registers: the
// store of an AGG_LOAD_IN_PLACE_OVERLAPPING load, whose destination may overlap its
// source, copies as memmove does.

// emitAggMemmoveAarch64 copies sz bytes (at least 32) from [srcPtr] to [dstPtr] as
// memmove does, right however the two overlap: ascending when the destination starts
// below the source or at or past its end, descending when it starts inside it (dst -
// src, unsigned, below sz).  It claims three scratch registers (scratchReg, which
// evicts a cached value loss-free; both pointers are marked claimed first so neither
// is evicted) for the two cursors and the count.  The two directions are straight
// blocks (emitAggMemmoveBlockAarch64), the second reached by a branch whose
// displacement is measured beforehand, so the copy records no fixup.
func emitAggMemmoveAarch64(a @asm.Assembler, rm @common.RegMap, dstPtr int, srcPtr int, sz int) {
	if sz < aggCopyLoopChunk {
		a.SetError("native aarch64: an overlap-safe copy loop needs at least 32 bytes")
		return
	}
	rm.MarkUsed(dstPtr)
	rm.MarkUsed(srcPtr)
	var s int = scratchReg(rm)
	var d int = scratchReg(rm)
	var count int = scratchReg(rm)
	aarch64.Sub(a, true, count, dstPtr, aarch64.Reg(srcPtr))
	emitConstInt64(a, s, cast(int64, sz))
	aarch64.Cmp(a, true, count, aarch64.Reg(s))
	var up int = aggMemmoveBlockBytesAarch64(true, dstPtr, srcPtr, sz, s, d, count)
	var down int = aggMemmoveBlockBytesAarch64(false, dstPtr, srcPtr, sz, s, d, count)
	// B.LO skips itself, the ascending block and the B past the descending one.
	aarch64.BcondOffset(a, aarch64.COND_LO, 8 + up)
	emitAggMemmoveBlockAarch64(a, true, dstPtr, srcPtr, sz, s, d, count)
	aarch64.BOffset(a, 4 + down)
	emitAggMemmoveBlockAarch64(a, false, dstPtr, srcPtr, sz, s, d, count)
}

// aggMemmoveBlockBytesAarch64 returns the size in bytes of emitAggMemmoveBlockAarch64's
// block for these operands, by emitting it into a scratch assembler.
func aggMemmoveBlockBytesAarch64(up bool, dstPtr int, srcPtr int, sz int, s int, d int,
		count int) int {
	var m @asm.Assembler = asm.New(8)
	m.SetSection("text", -1)
	emitAggMemmoveBlockAarch64(m, up, dstPtr, srcPtr, sz, s, d, count)
	return m.Sections[0].Len
}

// emitAggMemmoveBlockAarch64 copies sz bytes (at least 32) from [srcPtr] to [dstPtr]
// in one direction — ascending (up) or descending — 32 bytes per iteration through
// Q16 / Q17 with the cursors s and d, counting iterations down in count.  The sz % 32
// bytes the loop leaves — at the top going up, at the bottom going down — are read as
// the 32 bytes ending or starting there into Q6 / Q7 BEFORE the loop, which in that
// direction may overwrite them in the source, and stored after it.  Q16 / Q17 are the
// FP scratch pair and Q0..Q7 never a value's home (aarch64_regpools.bn), so none of
// them holds anything across the copy.  srcPtr and dstPtr stay intact.
func emitAggMemmoveBlockAarch64(a @asm.Assembler, up bool, dstPtr int, srcPtr int, sz int, s int,
		d int, count int) {
	var rest int = sz % aggCopyLoopChunk
	var step int = aggCopyLoopChunk
	if up {
		if rest != 0 {
			emitConstInt64(a, s, cast(int64, sz - aggCopyLoopChunk))
			aarch64.Add(a, true, s, srcPtr, aarch64.Reg(s))
			aarch64.Vldp_q(a, aarch64.V6, aarch64.V7, s, 0)
		}
		aarch64.Mov(a, true, s, aarch64.Reg(srcPtr))
		aarch64.Mov(a, true, d, aarch64.Reg(dstPtr))
	} else {
		if rest != 0 { aarch64.Vldp_q(a, aarch64.V6, aarch64.V7, srcPtr, 0) }
		emitConstInt64(a, count, cast(int64, sz - aggCopyLoopChunk))
		aarch64.Add(a, true, s, srcPtr, aarch64.Reg(count))
		aarch64.Add(a, true, d, dstPtr, aarch64.Reg(count))
		step = -aggCopyLoopChunk
	}
	emitConstInt64(a, count, cast(int64, sz / aggCopyLoopChunk))
	var top int = a.Sections[a.Current].Len
	aarch64.Vldp_q_post(a, aarch64.V16, aarch64.V17, s, step)
	aarch64.Vstp_q_post(a, aarch64.V16, aarch64.V17, d, step)
	aarch64.Subs(a, true, count, count, aarch64.Imm(1))
	branchBackAarch64(a, aarch64.COND_NE, top)
	if rest == 0 { return }
	if up {
		// d is dst + sz - rest; the leftover 32 bytes end at dst + sz.
		aarch64.Add(a, true, d, d, aarch64.Imm(rest))
		aarch64.Vstp_q(a, aarch64.V6, aarch64.V7, d, -aggCopyLoopChunk)
	} else {
		aarch64.Vstp_q(a, aarch64.V6, aarch64.V7, dstPtr, 0)
	}
}
