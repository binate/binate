package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for aarch64_aggmemmove.bn: the copy that picks its direction at run time.

// signExtTest sign-extends the low bits bits of v.
func signExtTest(v int, bits int) int {
	if (v & (1 << (bits - 1))) != 0 { return v - (1 << bits) }
	return v
}

// Past 64 bytes, a copy whose destination may overlap its source picks its direction
// at run time: B.LO (dst - src below the size, unsigned) to the descending block, past
// the ascending one, which ends in a B past the descending one; each block is a loop
// branching back.  A copy that cannot overlap is the plain loop, with no forward
// branch.
func TestEmitAggMemmoveBranchesAroundBlocks() testing.TestResult {
	var sizes @[]int = @[]int{65, 100, 128, 808, 5000}
	for si := 0; si < len(sizes); si++ {
		var a @asm.Assembler = opsMkAssembler()
		emitAggMemcpySafeAarch64(a, common.NewRegMap(callconv.AAPCS64()), 10, 9, cast(int64, sizes[si]),
				true)
		var n int = opsBytes(a) / 4
		var fwd int = -1
		var loops int = 0
		for i := 0; i < n; i++ {
			var w int = cast(int, opsWord(a, i))
			if (w >> 24) != 0x54 { continue }
			var off int = signExtTest((w >> 5) & 0x7FFFF, 19) * 4
			if off > 0 && fwd < 0 {
				if (w & 0xF) != aarch64.COND_LO { return "the direction branch is B.LO" }
				fwd = 4 * i + off
			} else if off < 0 {
				loops = loops + 1
			}
		}
		if fwd < 0 { return "an overlapping copy picks its direction with a forward B.cond" }
		if loops != 2 { return "each direction is a loop" }
		var bw int = cast(int, opsWord(a, fwd / 4 - 1))
		if (bw >> 26) != 5 { return "the ascending block ends in a B" }
		if fwd - 4 + signExtTest(bw & 0x3FFFFFF, 26) * 4 != opsBytes(a) {
			return "the B lands just past the descending block"
		}
		var p @asm.Assembler = opsMkAssembler()
		emitAggMemcpySafeAarch64(p, common.NewRegMap(callconv.AAPCS64()), 10, 9, cast(int64, sizes[si]),
				false)
		for i := 0; i < opsBytes(p) / 4; i++ {
			var w int = cast(int, opsWord(p, i))
			if (w >> 24) == 0x54 && signExtTest((w >> 5) & 0x7FFFF, 19) > 0 {
				return "a copy that cannot overlap has no direction branch"
			}
		}
	}
	return ""
}

// emitStructCopy copies the store of a load flagged InPlaceOverlapping (its pointer
// in its spill slot) as memmove does, branching on the direction; the same store
// unflagged is the plain copy, with no forward branch.
func TestEmitStructCopyOverlappingLoadPicksDirection() testing.TestResult {
	setTarget64()
	var t @types.Type = types.MakeArrayType(types.TypInt32(), 25)
	for flagged := 0; flagged < 2; flagged++ {
		var a @asm.Assembler = opsMkAssembler()
		var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
		m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
		m.SpillOffsets = common.AppendInt64(m.SpillOffsets, 0)
		m.AllocIDs = common.AppendInt(m.AllocIDs, 2)
		m.AllocOffsets = common.AppendInt64(m.AllocOffsets, 16)
		m.AllocSizes = common.AppendInt64(m.AllocSizes, 104)
		if flagged == 1 {
			m.InPlaceOverlapping = make_slice(bool, 3)
			m.InPlaceOverlapping[1] = true
		}
		var src @ir.Instr = make(ir.Instr)
		src.ID = 1
		src.Op = iropcode.OP_LOAD
		src.Typ = t
		var dst @ir.Instr = make(ir.Instr)
		dst.ID = 2
		var ins @ir.Instr = make(ir.Instr)
		ins.Op = iropcode.OP_STORE
		ins.Args = make_slice(@ir.Instr, 2)
		ins.Args[0] = dst
		ins.Args[1] = src
		emitStructCopy(a, "main", m, ins)
		var fwd int = 0
		for i := 0; i < opsBytes(a) / 4; i++ {
			var w int = cast(int, opsWord(a, i))
			if (w >> 24) == 0x54 && signExtTest((w >> 5) & 0x7FFFF, 19) > 0 && (w & 0xF) == aarch64.COND_LO {
				fwd = fwd + 1
			}
		}
		if fwd != flagged { return "only a flagged store's copy branches on its direction" }
	}
	return ""
}
