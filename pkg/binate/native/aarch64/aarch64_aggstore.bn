package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/native/aggcopy"
import "pkg/binate/native/common"

// Storing an aggregate into memory another party owns — a caller's sret buffer
// or tuple slot, a shim's return buffer, a C caller's buffer — writes exactly
// the aggregate's bytes: the bytes after it belong to the next object, which a
// word-granular store would overwrite whenever the size is not a multiple of 8.

// emitStoreRegWordAarch64 stores reg, which holds an aggregate's bytes from a
// word boundary on, at [base + off]; rest is how many of the aggregate's bytes
// remain from that boundary.  With rest >= 8 it stores the whole word; below
// that exactly rest bytes, in 4-, 2- and 1-byte pieces (aggcopy.TailPieces),
// each later piece shifted down from reg into scratch — reg is left unchanged,
// and scratch must differ from reg and base.
func emitStoreRegWordAarch64(a @asm.Assembler, reg int, base int, off int, rest int, scratch int) {
	if rest >= 8 {
		aarch64.Str(a, true, reg, aarch64.MemImm(base, off))
		return
	}
	var ps @[]aggcopy.Piece = aggcopy.TailPieces(0, rest, false)
	for i := 0; i < len(ps); i++ {
		var src int = reg
		if ps[i].Off > 0 {
			aarch64.Lsr(a, true, scratch, reg, aarch64.Imm(8 * ps[i].Off))
			src = scratch
		}
		var p aggcopy.Piece
		p.Off = off + ps[i].Off
		p.Width = ps[i].Width
		emitAggPieceAarch64(a, false, src, base, p)
	}
}

// emitStoreArgRegsAarch64 stores an sz-byte aggregate held in X0, X1, … at
// [base + off]: whole words, then exactly the last word's remaining bytes.
func emitStoreArgRegsAarch64(a @asm.Assembler, sz int, base int, off int, scratch int) {
	for w := 0; 8 * w < sz; w++ {
		emitStoreRegWordAarch64(a, argReg(w), base, off + 8 * w, sz - 8 * w, scratch)
	}
}

// emitAggCopyToAarch64 copies sz bytes from [srcPtr] to [dstBase + dstOff]
// exactly (emitAggMemcpyAarch64), forming the destination address in a scratch
// register when dstOff is not 0.
func emitAggCopyToAarch64(a @asm.Assembler, rm @common.RegMap, dstBase int, dstOff int, srcPtr int,
		sz int) {
	var dst int = dstBase
	if dstOff != 0 {
		dst = scratchReg(rm)
		aarch64.Add(a, true, dst, dstBase, aarch64.Imm(dstOff))
	}
	emitAggMemcpyAarch64(a, dst, srcPtr, sz, scratchReg(rm), scratchReg(rm))
}
