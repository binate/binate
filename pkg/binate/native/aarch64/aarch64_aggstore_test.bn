package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A whole remaining word is one 64-bit STR (top byte 0xF9).
func TestStoreRegWordWhole() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitStoreRegWordAarch64(a, 0, 9, 0, 8, 10)
	if opsBytes(a) != 4 || instrTopByte(a, 0) != 0xF9 { return "a whole word should be one STR X" }
	return ""
}

// Three remaining bytes are a halfword and a byte: STRH, then LSR of the source
// into the scratch (UBFM, top byte 0xD3), then STRB — never a word store.
func TestStoreRegWordThreeBytes() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitStoreRegWordAarch64(a, 0, 9, 0, 3, 10)
	if opsBytes(a) != 12 { return "3 bytes should be STRH + LSR + STRB" }
	if instrTopByte(a, 0) != 0x79 || instrTopByte(a, 1) != 0xD3 || instrTopByte(a, 2) != 0x39 {
		return "3 bytes should store the low halfword, shift, then store the byte"
	}
	return ""
}

// An 11-byte aggregate in X0, X1: X0 as a whole word, then X1's three bytes.
func TestStoreArgRegsElevenBytes() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitStoreArgRegsAarch64(a, 11, 9, 0, 10)
	if opsBytes(a) != 16 { return "11 bytes should be STR X0, then STRH + LSR + STRB of X1" }
	if instrTopByte(a, 0) != 0xF9 || instrTopByte(a, 3) != 0x39 {
		return "the last byte of an 11-byte aggregate should be a STRB"
	}
	return ""
}

// aa64TupleOf returns the multi-value result tuple of the given field types.
func aa64TupleOf(fieldTypes @[]@types.Type) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, len(fieldTypes))
	for i := 0; i < len(fieldTypes); i++ {
		fields[i] = make(types.Field)
		fields[i].Type = fieldTypes[i]
	}
	return types.MakeStructType("", fields)
}

// Collecting a (uint8, [15]char) tuple after a call stores the [15]char's first
// word whole and its last word only up to the field's end: one 64-bit STR (or
// the unscaled/X17 form at the field's odd offset — top byte 0xF8 or 0xF9) and
// no second one.
func TestCollectTupleStoresExactlyAA64() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var tuple @types.Type = aa64TupleOf(
			@[]@types.Type{types.TypUint8(), types.MakeArrayType(types.TypChar(), 15)})
	storeMultiReturnTupleFieldsAA64(a, tuple, 9, 0, 10)
	var words int = 0
	for i := 0; i < opsBytes(a) / 4; i++ {
		var top uint8 = instrTopByte(a, i)
		// A 64-bit STR / STUR (0xF9 / 0xF8) store; loads (bit 22) are not counted.
		if (top == 0xF9 || top == 0xF8) && (a.Sections[0].Data[4 * i + 2] & 0x40) == 0 {
			words = words + 1
		}
	}
	if words != 1 { return "only the [15]char's first word may be a 64-bit store" }
	return ""
}
