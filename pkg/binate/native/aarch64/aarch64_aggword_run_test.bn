package "pkg/binate/native/aarch64"

import "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/os"

// A by-value aggregate is read exactly: none of its bytes is read past its end, which
// may be the end of mapped memory.  Checked end to end on a macOS arm64 host
// (canLinkAndRun): a C driver places a 12-byte {int32, int32, int32} and a 12-byte
// {float32, float32, int32} (not an HFA) each so it ends at an inaccessible page, and
// natively compiled functions load each through its pointer -- a load small enough to
// read its source in place -- and pass it by value through a function pointer: in
// X0 / X1, and the {int32 x3} also on the stack after seven int arguments, which leave
// one argument register; and natively compiled functions return each by value
// (`return *p`, read in place) in X0 / X1.  Each case runs in a child process, where a
// read past the end faults; the driver exits 42 when every case returns the right
// result, else 100 plus a bit per failed case.

// exactArgDriverAA64 is the C side: the guard page, the callees and the checks.
var exactArgDriverAA64 *[]readonly char = "#include <sys/mman.h>\n"
		"#include <sys/wait.h>\n"
		"#include <unistd.h>\n"
		"struct S12 { int a, b, c; };\n"
		"struct SM { float a, b; int i; };\n"
		"long take12(struct S12 s) { return s.a + s.b * 10 + s.c * 100; }\n"
		"long takeMix(struct SM s) { return (long)((s.a + s.b) * 10) + s.i; }\n"
		"long take12m(long a, long b, long c, long d, long e, long f, long g, struct S12 s) {\n"
		"  return a + b + c + d + e + f + g + s.a + s.b * 10 + s.c * 100;\n"
		"}\n"
		"long callit12(void *fp, struct S12 *p);\n"
		"long callitMix(void *fp, struct SM *p);\n"
		"long callit12m(void *fp, struct S12 *p);\n"
		"struct S12 get12(struct S12 *p);\n"
		"struct SM getMix(struct SM *p);\n"
		"long via12(void *unused, void *p) {\n"
		"  struct S12 r = get12(p);\n"
		"  return r.a + r.b * 10 + r.c * 100;\n"
		"}\n"
		"long viaMix(void *unused, void *p) {\n"
		"  struct SM r = getMix(p);\n"
		"  return (long)((r.a + r.b) * 10) + r.i;\n"
		"}\n"
		"static char *guarded(long sz) {\n"
		"  long pg = getpagesize();\n"
		"  char *m = mmap(0, 2 * pg, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);\n"
		"  if (m == MAP_FAILED || mprotect(m + pg, pg, PROT_NONE) != 0) return 0;\n"
		"  return m + pg - sz;\n"
		"}\n"
		"typedef long (*callit)(void *, void *);\n"
		"static int fails(callit f, void *fp, void *p, long want) {\n"
		"  pid_t pid = fork();\n"
		"  if (pid == 0) _exit(f(fp, p) == want ? 0 : 1);\n"
		"  int st = 0;\n"
		"  if (pid < 0 || waitpid(pid, &st, 0) != pid) return 1;\n"
		"  return !(WIFEXITED(st) && WEXITSTATUS(st) == 0);\n"
		"}\n"
		"int main(void) {\n"
		"  int bad = 0;\n"
		"  struct S12 *s12 = (struct S12 *)guarded(sizeof(struct S12));\n"
		"  struct SM *sm = (struct SM *)guarded(sizeof(struct SM));\n"
		"  if (!s12 || !sm) return 99;\n"
		"  s12->a = 1; s12->b = 2; s12->c = 3;\n"
		"  sm->a = 1.5f; sm->b = 2.5f; sm->i = 5;\n"
		"  if (fails((callit)callit12, (void *)take12, s12, 321)) bad |= 1;\n"
		"  if (fails((callit)callitMix, (void *)takeMix, sm, 45)) bad |= 2;\n"
		"  if (fails((callit)callit12m, (void *)take12m, s12, 349)) bad |= 4;\n"
		"  if (fails(via12, 0, s12, 321)) bad |= 8;\n"
		"  if (fails(viaMix, 0, sm, 45)) bad |= 16;\n"
		"  return bad == 0 ? 42 : 100 + bad;\n"
		"}\n"

// aa64TestStruct returns a struct type `name` with the given field types (named:
// an anonymous struct is a multi-return tuple, which the classifiers skip).
func aa64TestStruct(name *[]readonly char, fts @[]@types.Type) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, len(fts))
	for i := 0; i < len(fts); i++ {
		fields[i] = make(types.Field)
		var fname @[]char = make_slice(char, 2)
		fname[0] = 'f'
		fname[1] = cast(char, cast(int, '0') + i)
		fields[i].Name = fname
		fields[i].Type = fts[i]
	}
	return types.MakeStructType(buf.CopyStr(name), fields)
}

// exactRetFuncAA64 builds the exported `name`(p *t) t, which returns *p.
func exactRetFuncAA64(name *[]readonly char, t @types.Type) @ir.Func {
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = t
	var f @ir.Func = ir.NewFunc("", buf.CopyStr(name), make_slice(@ir.Param, 0), results)
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = irbuild.NewParam(f, "p", types.MakePointerType(t))
	f.Params = params
	var ce @[]@[]char = make_slice(@[]char, 1)
	ce[0] = buf.CopyStr(name)
	f.CExportNames = ce
	var b @ir.Block = ir.AddBlock(f, "entry")
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = irbuild.EmitLoad(b, irbuild.NewParamRef(f, params[0]), t)
	irbuild.EmitReturn(b, rets)
	return f
}

// exactArgFuncAA64 builds the exported `name`(fp *uint8, p *t) int, which loads *p
// and passes it to fp, after the ints 1..nLead when nLead > 0.
func exactArgFuncAA64(name *[]readonly char, t @types.Type, nLead int) @ir.Func {
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", buf.CopyStr(name), make_slice(@ir.Param, 0), results)
	var params @[]@ir.Param = make_slice(@ir.Param, 2)
	params[0] = irbuild.NewParam(f, "fp", types.MakePointerType(types.TypUint8()))
	params[1] = irbuild.NewParam(f, "p", types.MakePointerType(t))
	f.Params = params
	var ce @[]@[]char = make_slice(@[]char, 1)
	ce[0] = buf.CopyStr(name)
	f.CExportNames = ce
	var b @ir.Block = ir.AddBlock(f, "entry")
	var fp @ir.Instr = irbuild.NewParamRef(f, params[0])
	var p @ir.Instr = irbuild.NewParamRef(f, params[1])
	var args @[]@ir.Instr = make_slice(@ir.Instr, nLead + 1)
	for i := 0; i < nLead; i++ {
		args[i] = irbuild.EmitConstInt(b, i + 1, types.TypInt())
	}
	args[nLead] = irbuild.EmitLoad(b, p, t)
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = irbuild.EmitCallIndirect(b, fp, args, types.TypInt())
	irbuild.EmitReturn(b, rets)
	return f
}

func TestAggregateArgReadsNoBytePastItsEndAA64() testing.TestResult {
	if !canLinkAndRun() { return "" }
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var i3 @[]@types.Type = make_slice(@types.Type, 3)
	for i := 0; i < 3; i++ { i3[i] = types.TypInt32() }
	var mix @[]@types.Type = make_slice(@types.Type, 3)
	mix[0] = types.TypFloat32()
	mix[1] = types.TypFloat32()
	mix[2] = types.TypInt32()
	var s12 @types.Type = aa64TestStruct("S12", i3)
	var sm @types.Type = aa64TestStruct("SM", mix)
	var m @ir.Module = ir.NewModule("\"main\"")
	m.AddFunc(exactArgFuncAA64("callit12", s12, 0))
	m.AddFunc(exactArgFuncAA64("callitMix", sm, 0))
	m.AddFunc(exactArgFuncAA64("callit12m", s12, 7))
	m.AddFunc(exactRetFuncAA64("get12", s12))
	m.AddFunc(exactRetFuncAA64("getMix", sm))
	var objPath @[]char = buf.Concat(dir, "/prog.o")
	if !EmitObject(m, "macho", objPath, Options{}) { return fail("EmitObject returned false") }
	var cPath @[]char = buf.Concat(dir, "/driver.c")
	f, cerr := os.Create(cPath)
	if present(cerr) { return fail("cannot create the C driver") }
	_, werr := f.Write(exactArgDriverAA64)
	_ = f.Close()
	if present(werr) { return fail("cannot write the C driver") }
	var exePath @[]char = buf.Concat(dir, "/prog")
	var largs @[]@[]char = make_slice(@[]char, 5)
	largs[0] = "-w"
	largs[1] = "-o"
	largs[2] = buf.CopyStr(exePath)
	largs[3] = buf.CopyStr(cPath)
	largs[4] = buf.CopyStr(objPath)
	if execExit("clang", largs) != 0 { return fail("building the arm64 program failed") }
	var rc int = execExit(exePath, make_slice(@[]char, 0))
	if rc == 42 { return "" }
	var msg @[]char = buf.CopyStr("by-value aggregates read past their end or arrived wrong:")
	if rc >= 101 && rc <= 131 {
		var bits int = rc - 100
		if bits % 2 == 1 { msg = buf.Concat(msg, " {int32 x3} in registers") }
		if bits / 2 % 2 == 1 { msg = buf.Concat(msg, " {float32, float32, int32}") }
		if bits / 4 % 2 == 1 { msg = buf.Concat(msg, " {int32 x3} on the stack") }
		if bits / 8 % 2 == 1 { msg = buf.Concat(msg, " a returned {int32 x3}") }
		if bits / 16 % 2 == 1 { msg = buf.Concat(msg, " a returned {float32, float32, int32}") }
	} else {
		msg = buf.Concat(msg, " (the program did not run to its checks)")
	}
	return fail(msg)
}
