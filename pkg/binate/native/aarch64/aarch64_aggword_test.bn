package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/native/aggcopy"
import "pkg/builtins/testing"

// loadAggWordAA64 reads no byte past an aggregate, which may be read in place from a
// source ending where mapped memory does: a whole word is one 64-bit load, a last word
// of 4 bytes one 32-bit load, another in an aggregate of more than 8 bytes the 8 bytes
// ending at its end shifted right, and an aggregate of 3, 5, 6 or 7 bytes its
// exact-width pieces put together.

// sameCodeAA64 reports whether a and b emitted the same bytes.
func sameCodeAA64(a @asm.Assembler, b @asm.Assembler) bool {
	if bytesWritten(a) != bytesWritten(b) { return false }
	for i := 0; i < bytesWritten(a); i++ {
		if a.Sections[0].Data[i] != b.Sections[0].Data[i] { return false }
	}
	return true
}

func TestLoadAggWordExactWidths() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	loadAggWordAA64(a, aarch64.X1, aarch64.X9, 1, 16, aarch64.X17)
	var want @asm.Assembler = mkAsm()
	aarch64.Ldr(want, true, aarch64.X1, aarch64.MemImm(aarch64.X9, 8))
	if !sameCodeAA64(a, want) { return fail("the second word of 16 bytes is one 64-bit load") }
	a = mkAsm()
	loadAggWordAA64(a, aarch64.X1, aarch64.X9, 1, 12, aarch64.X17)
	want = mkAsm()
	aarch64.Ldr(want, false, aarch64.X1, aarch64.MemImm(aarch64.X9, 8))
	if !sameCodeAA64(a, want) {
		return fail("the second word of 12 bytes is one 32-bit load of bytes 8..11")
	}
	a = mkAsm()
	loadAggWordAA64(a, aarch64.X1, aarch64.X9, 1, 15, aarch64.X17)
	want = mkAsm()
	emitAggPieceAtAarch64(want, true, aarch64.X1, aarch64.X9, 7, 8)
	aarch64.Lsr(want, true, aarch64.X1, aarch64.X1, aarch64.Imm(8))
	if !sameCodeAA64(a, want) {
		return fail("the second word of 15 bytes is bytes 7..14 shifted right past byte 7")
	}
	a = mkAsm()
	loadAggWordAA64(a, aarch64.X1, aarch64.X9, 0, 7, aarch64.X17)
	want = mkAsm()
	var p aggcopy.Piece
	p.Off = 0
	p.Width = 4
	emitAggPieceAarch64(want, true, aarch64.X1, aarch64.X9, p)
	p.Off = 4
	p.Width = 2
	emitAggPieceAarch64(want, true, aarch64.X17, aarch64.X9, p)
	aarch64.Orr(want, true, aarch64.X1, aarch64.X1, aarch64.RegShift(aarch64.X17, aarch64.LSL, 32))
	p.Off = 6
	p.Width = 1
	emitAggPieceAarch64(want, true, aarch64.X17, aarch64.X9, p)
	aarch64.Orr(want, true, aarch64.X1, aarch64.X1, aarch64.RegShift(aarch64.X17, aarch64.LSL, 48))
	if !sameCodeAA64(a, want) { return fail("7 bytes are 4, 2 and 1 bytes shifted into place") }
	a = mkAsm()
	loadAggWordAA64(a, aarch64.X1, aarch64.X9, 0, 7, aarch64.X9)
	if !a.HasError { return fail("a pieced word whose temp is its base fails loud") }
	return ""
}

// expectPiecesAA64 emits into a fresh assembler what loadAggWordAA64 puts together for
// an aggregate made of pieces (offset, width), the first into X1, the others through X17.
func expectPiecesAA64(offs @[]int, widths @[]int) @asm.Assembler {
	var want @asm.Assembler = mkAsm()
	for i := 0; i < len(offs); i++ {
		var r int = aarch64.X17
		if i == 0 { r = aarch64.X1 }
		emitAggPieceAtAarch64(want, true, r, aarch64.X9, cast(int64, offs[i]), widths[i])
		if i > 0 {
			aarch64.Orr(want, true, aarch64.X1, aarch64.X1,
					aarch64.RegShift(aarch64.X17, aarch64.LSL, 8 * offs[i]))
		}
	}
	return want
}

// A last word of 2 or 1 bytes is one load of its width; an aggregate of 3, 5 or 6 bytes
// is its pieces, widest first.
func TestLoadAggWordShortTailsAA64() testing.TestResult {
	var sizes @[]int64 = @[]int64{10, 9, 3, 5, 6}
	var words @[]int = @[]int{1, 1, 0, 0, 0}
	var offs @[]@[]int = @[]@[]int{@[]int{8}, @[]int{8}, @[]int{0, 2}, @[]int{0, 4}, @[]int{0, 4}}
	var widths @[]@[]int = @[]@[]int{@[]int{2}, @[]int{1}, @[]int{2, 1}, @[]int{4, 1}, @[]int{4, 2}}
	for i := 0; i < len(sizes); i++ {
		var a @asm.Assembler = mkAsm()
		loadAggWordAA64(a, aarch64.X1, aarch64.X9, words[i], sizes[i], aarch64.X17)
		if !sameCodeAA64(a, expectPiecesAA64(offs[i], widths[i])) {
			return fail("a short last word or aggregate is its exact-width pieces")
		}
	}
	return ""
}

// emitNamedAA64 emits function name of package main in mod into a fresh assembler.
func emitNamedAA64(mod @ir.Module, name *[]readonly char) @asm.Assembler {
	var a @asm.Assembler = mkAsm()
	var qual @[]char = mangle.QualifyName("main", name)
	for i := 0; i < len(mod.Funcs); i++ {
		if !mod.Funcs[i].IsExtern && charEqAA64(mod.Funcs[i].Name, qual) {
			emitFunc(a, "main", mod.Funcs[i], mod.Strings)
		}
	}
	return a
}

// hasLdrX1At8 reports whether a holds `LDR X1, [Xn, #8]` (sf) or `LDR W1, [Xn, #8]`.
func hasLdrX1At8(a @asm.Assembler, sf bool) bool {
	var want uint32 = 0xB9400801
	if sf { want = 0xF9400401 }
	for off := 0; off + 4 <= bytesWritten(a); off = off + 4 {
		if word32AA64(a, off) & 0xFFFFFC1F == want { return true }
	}
	return false
}

// A 12-byte struct read in place from *p and returned (alone or with another value), or
// passed by value, rides X0 and X1: X1 is a 32-bit load of bytes 8..11, never a 64-bit
// one reading 4 bytes past.
func TestInPlaceTwelveBytesLoadNoPastEnd() testing.TestResult {
	var mod @ir.Module = genFromSrc(
			"package \"main\"\ntype S struct {\n\ta int32\n\tb int32\n\tc int32\n}\n"
					"func get(p *S) S { return *p }\n"
					"func put(s S) int32 { return s.c }\n"
					"func call(p *S) int32 { return put(*p) }\n"
					"func two(p *S) (S, int32) { return *p, 7 }\n")
	var g @asm.Assembler = emitNamedAA64(mod, "get")
	if g.HasError { return fail(g.ErrorMsg) }
	if bytesWritten(g) == 0 { return fail("get: not emitted") }
	if hasLdrX1At8(g, true) || !hasLdrX1At8(g, false) {
		return fail("get: X1 is a 32-bit load of bytes 8..11")
	}
	var c @asm.Assembler = emitNamedAA64(mod, "call")
	if c.HasError { return fail(c.ErrorMsg) }
	if bytesWritten(c) == 0 { return fail("call: not emitted") }
	if hasLdrX1At8(c, true) || !hasLdrX1At8(c, false) {
		return fail("call: X1 is a 32-bit load of bytes 8..11")
	}
	var t @asm.Assembler = emitNamedAA64(mod, "two")
	if t.HasError { return fail(t.ErrorMsg) }
	if bytesWritten(t) == 0 { return fail("two: not emitted") }
	if hasLdrX1At8(t, true) || !hasLdrX1At8(t, false) {
		return fail("two: X1 is a 32-bit load of bytes 8..11")
	}
	return ""
}
