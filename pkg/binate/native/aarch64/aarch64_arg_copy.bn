package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// AAPCS64 passes an aggregate over 16 bytes (not an HFA) as a pointer to a copy the
// caller makes, which the callee may use as its own parameter and write to.  A call
// passes an argument's own data region only when the call owns it (a private copy
// nothing reads afterwards); any other such argument is first copied into the
// argument region PlanFrame reserved for it (common.RegMap.LookupArgCopy), and the
// call passes that region.

// emitArgCopiesAA64 copies each such argument of call ins (operands from base on)
// into its argument region.  It runs first in the call's lowering, before any
// argument register, X8 or X16 is set, and resets the register claims after each
// copy (a call op starts from a flushed register cache, so nothing is lost).
func emitArgCopiesAA64(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr, base int) {
	for k := base; k < len(ins.Args); k++ {
		var arg @ir.Instr = ins.Args[k]
		if arg == nil || arg.Typ == nil || !rm.CC.PassesIndirect(arg.Typ) { continue }
		if ins.ID < 0 {
			// PlanFrame keys argument regions by the call's value ID; with none, an
			// argument that needed a copy would silently pass memory it does not own.
			a.SetError("native aarch64: a call with no value ID passes a by-value aggregate")
			return
		}
		var off int = rm.LookupArgCopy(ins.ID, k)
		if off < 0 { continue }
		var ptr int = getOperand(a, rm, arg.ID)
		if ptr < 0 {
			a.SetError("native aarch64: a by-value aggregate argument with no operand to copy")
			return
		}
		emitAggCopyToAarch64(a, rm, aarch64.SP, off, ptr, arg.Typ.SizeOf())
		rm.ResetRegs()
	}
}

// argPointerAA64 returns a register holding the address call ins passes for its
// by-value aggregate operand k: the argument region emitArgCopiesAA64 filled, or the
// argument's own data region when the call owns it.  It returns -1 when the operand
// has no register (as getOperand does).
func argPointerAA64(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr, k int) int {
	var off int = rm.LookupArgCopy(ins.ID, k)
	if off < 0 { return getOperand(a, rm, ins.Args[k].ID) }
	var r int = scratchReg(rm)
	aarch64.Add(a, true, r, aarch64.SP, aarch64.Imm(off))
	return r
}
