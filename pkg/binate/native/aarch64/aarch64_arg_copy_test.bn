package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for aarch64_arg_copy.bn: a by-value aggregate argument the call does not
// own is copied into the argument region PlanFrame reserved, and the call passes
// that region.  quadTypAA64 lives in aarch64_funcvalue_packed_test.bn.

// argCopyCallAA64 returns a call (value 9) whose operand 0 is a 32-byte aggregate
// (value 7, its pointer spilled at [SP + 16]), and a register map giving that
// operand an argument region at [SP + 64].
func argCopyCallAA64() (@ir.Instr, @common.RegMap) {
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 7
	arg.Typ = quadTypAA64()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = iropcode.OP_CALL
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = arg
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	rm.SpillIDs = make_slice(int, 1)
	rm.SpillIDs[0] = 7
	rm.SpillOffsets = make_slice(int, 1)
	rm.SpillOffsets[0] = 16
	rm.ArgCopyCalls = make_slice(int, 1)
	rm.ArgCopyCalls[0] = 9
	rm.ArgCopyArgs = make_slice(int, 1)
	rm.ArgCopyArgs[0] = 0
	rm.ArgCopyOffsets = make_slice(int, 1)
	rm.ArgCopyOffsets[0] = 64
	return ins, rm
}

// The argument's bytes are copied into its region (straight-line at 32 bytes), and
// the address the call then passes is the region's.
func TestArgCopyIntoRegionAA64() testing.TestResult {
	setTarget64()
	ins, rm := argCopyCallAA64()
	var a @asm.Assembler = opsMkAssembler()
	emitArgCopiesAA64(a, rm, ins, 0)
	var r int = argPointerAA64(a, rm, ins, 0)
	var ref @asm.Assembler = opsMkAssembler()
	aarch64.Ldr(ref, true, aarch64.X9, aarch64.MemImm(aarch64.SP, 16))
	aarch64.Add(ref, true, aarch64.X10, aarch64.SP, aarch64.Imm(64))
	emitAggCopyStraightAarch64(ref, aarch64.X10, aarch64.X9, 32, aarch64.X11, aarch64.X12)
	aarch64.Add(ref, true, aarch64.X9, aarch64.SP, aarch64.Imm(64))
	if a.HasError || r != aarch64.X9 || !sameTextAA64(a, ref) {
		return "an unowned argument must be copied into its region, and the region passed"
	}
	return ""
}

// An argument with no region is passed as its own memory: no copy.
func TestArgCopyOwnedArgumentAA64() testing.TestResult {
	setTarget64()
	ins, rm := argCopyCallAA64()
	rm.ArgCopyCalls[0] = 8
	var a @asm.Assembler = opsMkAssembler()
	emitArgCopiesAA64(a, rm, ins, 0)
	if opsBytes(a) != 0 { return "an owned argument needs no copy" }
	var r int = argPointerAA64(a, rm, ins, 0)
	var ref @asm.Assembler = opsMkAssembler()
	aarch64.Ldr(ref, true, aarch64.X9, aarch64.MemImm(aarch64.SP, 16))
	if r != aarch64.X9 || !sameTextAA64(a, ref) { return "an owned argument passes its own pointer" }
	return ""
}

// countAddSpImmAA64 counts the `ADD Xd, SP, #imm` instructions (any Xd) in a's text.
func countAddSpImmAA64(a @asm.Assembler, imm int) int {
	var n int = 0
	for off := 0; off + 4 <= opsBytes(a); off = off + 4 {
		var w uint32 = cast(uint32, a.Sections[0].Data[off]) |
				(cast(uint32, a.Sections[0].Data[off + 1]) << 8) |
				(cast(uint32, a.Sections[0].Data[off + 2]) << 16) |
				(cast(uint32, a.Sections[0].Data[off + 3]) << 24)
		if (w & cast(uint32, 0xFFFFFFE0)) == (cast(uint32, 0x910003E0) | cast(uint32, imm << 10)) { n++ }
	}
	return n
}

// callWithQuadArgAA64 emits a call of opcode op (value 11) whose Args[0] is the
// callee (an interface value or function pointer, spilled at [SP + 0]) and Args[1]
// a 32-byte aggregate (value 200, its region at [SP + 16]); with region set,
// operand 1 also has an argument region at [SP + 512].
func callWithQuadArgAA64(op int, region bool) @asm.Assembler {
	setTarget64()
	var a @asm.Assembler = opsMkAssembler()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 200)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 32)
	if region {
		rm.ArgCopyCalls = common.AppendInt(rm.ArgCopyCalls, 11)
		rm.ArgCopyArgs = common.AppendInt(rm.ArgCopyArgs, 1)
		rm.ArgCopyOffsets = common.AppendInt(rm.ArgCopyOffsets, 512)
	}
	var callee @ir.Instr = make(ir.Instr)
	callee.ID = 5
	callee.Typ = types.TypInt64()
	var q @ir.Instr = make(ir.Instr)
	q.ID = 200
	q.Op = iropcode.OP_LOAD
	q.Typ = quadTypAA64()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 11
	ins.Op = op
	ins.Index = 1
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = callee
	ins.Args[1] = q
	if op == iropcode.OP_CALL_IFACE_METHOD {
		emitCallIfaceMethod(a, "main", rm, ins)
	} else {
		emitCallIndirect(a, "main", rm, ins)
	}
	return a
}

// Through an interface method or a function pointer, operand 1 (the first user
// argument) is copied into its region and the region's address passed: two
// `ADD Xd, SP, #512` — the copy's destination and the pointer passed — and none
// when the argument owns its memory.
func TestArgCopyIndirectCallOperandsAA64() testing.TestResult {
	var ops @[]int = make_slice(int, 2)
	ops[0] = iropcode.OP_CALL_IFACE_METHOD
	ops[1] = iropcode.OP_CALL_INDIRECT
	for i := 0; i < len(ops); i++ {
		var with @asm.Assembler = callWithQuadArgAA64(ops[i], true)
		var without @asm.Assembler = callWithQuadArgAA64(ops[i], false)
		if with.HasError || without.HasError { return "the call must emit without error" }
		if countAddSpImmAA64(with, 512) != 2 {
			return "the call must copy operand 1 into its region and pass that region"
		}
		if countAddSpImmAA64(without, 512) != 0 { return "an owned operand passes its own memory" }
	}
	return ""
}
