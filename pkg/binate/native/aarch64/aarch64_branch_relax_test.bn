package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/builtins/testing"

// Branch relaxation (aarch64_branch_relax.bn): conditional branches to targets beyond
// their ±1 MiB reach.  The code between branch and target is zero-filled; only the
// branch words are checked.  The targets are temporary (`L`) labels, as block labels
// are, so a branch to one resolves in place (in a Mach-O object, a non-temporary label
// starts an atom of its own).  (word32AA64 and genFromSrc are in
// aarch64_iface_vtable_test.bn.)

// relaxAsm is an empty text section to branch in.
func relaxAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// fillChecked appends n zero bytes in 64 KiB pieces, checking for islands between them
// as the function emitter does between IR instructions (isl nil: no checks).
func fillChecked(a @asm.Assembler, isl @branchIslands, n int) {
	for n > 0 {
		var piece int = n
		if piece > 65536 { piece = 65536 }
		if isl != nil { isl.check(a, false) }
		a.Fill(piece, 0)
		n = n - piece
	}
	if isl != nil { isl.check(a, false) }
}

// branch19Target is where the B.cond / CBZ / CBNZ at off branches (imm19 at bits 23:5).
func branch19Target(a @asm.Assembler, off int) int {
	var imm int = cast(int, (word32AA64(a, off) >> 5) & 0x7FFFF)
	if imm >= 0x40000 { imm = imm - 0x80000 }
	return off + 4 * imm
}

// branch26Target is where the B at off branches (imm26 at bits 25:0).
func branch26Target(a @asm.Assembler, off int) int {
	var imm int = cast(int, word32AA64(a, off) & 0x3FFFFFF)
	if imm >= 0x2000000 { imm = imm - 0x4000000 }
	return off + 4 * imm
}

// labelOffset is where label is defined.
func labelOffset(a @asm.Assembler, label *[]readonly char) int {
	return cast(int, a.Symbols[a.LookupSymbol(label)].Offset)
}

// A forward B.cond and CBNZ to a block 1.1 MiB on: without the checks the branches cannot
// reach it; with them each goes to an island stub, a B to the target, and code before
// the island jumps over it.
func TestCondBranchForwardFarUsesIsland() testing.TestResult {
	var none @branchIslands
	var bare @asm.Assembler = relaxAsm()
	emitCondBranchTo(bare, aarch64.COND_EQ, aarch64.COND_NE, -1, "LT")
	fillChecked(bare, none, 0x118000)
	bare.DefineLabel("LT")
	if aarch64.ResolveFixups(bare) { return fail("a B.cond 1.1 MiB on resolved without an island") }

	var a @asm.Assembler = relaxAsm()
	var isl @branchIslands = newBranchIslands(a)
	emitCondBranchTo(a, aarch64.COND_EQ, aarch64.COND_NE, -1, "LT")
	emitCondBranchTo(a, 0, 0, aarch64.X3, "LT")
	fillChecked(a, isl, 0x118000)
	a.DefineLabel("LT")
	if !aarch64.ResolveFixups(a) { return fail(a.ErrorMsg) }
	var t int = labelOffset(a, "LT")
	for k := 0; k < 2; k++ {
		var stub int = branch19Target(a, 4 * k)
		if stub <= 8 || stub >= t { return fail("a far branch does not go to an island stub") }
		if branch26Target(a, stub) != t { return fail("an island stub does not branch to the target") }
		if branch26Target(a, stub - 4 * (k + 1)) != stub + 4 * (2 - k) {
			return fail("the code before the island does not jump over it")
		}
	}
	if (word32AA64(a, 0) & 0xFF00001F) != 0x54000000 { return fail("the first branch is not B.EQ") }
	if (word32AA64(a, 4) & 0xFF00001F) != 0xB5000003 {
		return fail("the second branch is not CBNZ X3")
	}
	return ""
}

// A forward branch whose target comes within reach gets no island.
func TestCondBranchForwardNearNoIsland() testing.TestResult {
	var a @asm.Assembler = relaxAsm()
	var isl @branchIslands = newBranchIslands(a)
	emitCondBranchTo(a, aarch64.COND_LT, aarch64.COND_GE, -1, "LT")
	fillChecked(a, isl, 0x80000)
	a.DefineLabel("LT")
	fillChecked(a, isl, 0x100000)
	if !aarch64.ResolveFixups(a) { return fail(a.ErrorMsg) }
	if branch19Target(a, 0) != 4 + 0x80000 { return fail("a near branch does not go straight to T") }
	if a.Sections[0].Len != 4 + 0x180000 { return fail("an island was emitted") }
	return ""
}

// A backward branch beyond reach is the inverted branch over a B: B.NE over `B T` for
// B.EQ, CBZ over it for CBNZ; one within reach stays a single branch.
func TestCondBranchBackwardFar() testing.TestResult {
	var a @asm.Assembler = relaxAsm()
	a.DefineLabel("LT")
	a.Fill(0x100004, 0)
	emitCondBranchTo(a, aarch64.COND_EQ, aarch64.COND_NE, -1, "LT")
	emitCondBranchTo(a, 0, 0, aarch64.X5, "LT")
	a.DefineLabel("LN")
	a.Fill(0x100, 0)
	emitCondBranchTo(a, aarch64.COND_EQ, aarch64.COND_NE, -1, "LN")
	if !aarch64.ResolveFixups(a) { return fail(a.ErrorMsg) }
	var at int = 0x100004
	if (word32AA64(a, at) & 0xFF00001F) != 0x54000001 {
		return fail("the far B.EQ is not B.NE over a B")
	}
	if branch19Target(a, at) != at + 8 || branch26Target(a, at + 4) != 0 {
		return fail("the far B.EQ does not skip a B to T")
	}
	at = at + 8
	if (word32AA64(a, at) & 0xFF00001F) != 0xB4000005 {
		return fail("the far CBNZ is not CBZ over a B")
	}
	if branch19Target(a, at) != at + 8 || branch26Target(a, at + 4) != 0 {
		return fail("the far CBNZ does not skip a B to T")
	}
	at = at + 8 + 0x100
	if branch19Target(a, at) != at - 0x100 || a.Sections[0].Len != at + 4 {
		return fail("a near backward branch is not a single B.EQ")
	}
	return ""
}

// A backward branch exactly 1 MiB back is still in reach and stays a single branch; 4
// bytes further it is the inverted branch over a B.
func TestCondBranchBackwardReachEdge() testing.TestResult {
	var a @asm.Assembler = relaxAsm()
	a.DefineLabel("LT")
	a.Fill(0x100000, 0)
	emitCondBranchTo(a, aarch64.COND_EQ, aarch64.COND_NE, -1, "LT")
	if a.Sections[0].Len != 0x100004 { return fail("a branch at the edge of reach was relaxed") }
	var b @asm.Assembler = relaxAsm()
	b.DefineLabel("LT")
	b.Fill(0x100004, 0)
	emitCondBranchTo(b, aarch64.COND_EQ, aarch64.COND_NE, -1, "LT")
	if b.Sections[0].Len != 0x10000C { return fail("a branch past the reach was not relaxed") }
	if !aarch64.ResolveFixups(a) || !aarch64.ResolveFixups(b) {
		return fail("an edge branch did not resolve")
	}
	if branch19Target(a, 0x100000) != 0 { return fail("the edge branch does not reach its target") }
	return ""
}

// An island stubs only the branches whose targets are still undefined: one defined in
// the meantime (within reach) keeps branching straight there.
func TestCondBranchIslandSkipsDefinedTarget() testing.TestResult {
	var a @asm.Assembler = relaxAsm()
	var isl @branchIslands = newBranchIslands(a)
	emitCondBranchTo(a, aarch64.COND_EQ, aarch64.COND_NE, -1, "LA")
	emitCondBranchTo(a, aarch64.COND_NE, aarch64.COND_EQ, -1, "LB")
	isl.check(a, false)
	a.Fill(0x40000, 0)
	a.DefineLabel("LB")
	fillChecked(a, isl, 0xD0000)
	a.DefineLabel("LA")
	if !aarch64.ResolveFixups(a) { return fail(a.ErrorMsg) }
	if branch19Target(a, 4) != labelOffset(a, "LB") { return fail("the defined target was stubbed") }
	var stub int = branch19Target(a, 0)
	if branch26Target(a, stub) != labelOffset(a, "LA") {
		return fail("the waiting branch was not stubbed")
	}
	if branch26Target(a, stub - 4) != stub + 4 { return fail("the island has more than one stub") }
	return ""
}

// At a block end after a B, the island needs no `B over`, and is made at the lower
// block-end distance; at a block end after anything else it gets one.
func TestCondBranchIslandAtBlockEnd() testing.TestResult {
	var a @asm.Assembler = relaxAsm()
	var isl @branchIslands = newBranchIslands(a)
	emitCondBranchTo(a, aarch64.COND_EQ, aarch64.COND_NE, -1, "LT")
	isl.check(a, false)
	a.Fill(condIslandAtEnd, 0)
	aarch64.B(a, "LT")
	isl.check(a, true)
	var stub int = 8 + condIslandAtEnd
	if a.Sections[0].Len != stub + 4 {
		return fail("no island, or one with a jump over it, after a B")
	}
	a.DefineLabel("LT")
	if !aarch64.ResolveFixups(a) { return fail(a.ErrorMsg) }
	if branch19Target(a, 0) != stub || branch26Target(a, stub) != stub + 4 {
		return fail("the branch does not go through the block-end stub")
	}

	var b @asm.Assembler = relaxAsm()
	var isl2 @branchIslands = newBranchIslands(b)
	emitCondBranchTo(b, aarch64.COND_EQ, aarch64.COND_NE, -1, "LT")
	isl2.check(b, false)
	b.Fill(condIslandAtEnd, 0)
	isl2.check(b, true)
	if b.Sections[0].Len != 4 + condIslandAtEnd {
		return fail("an island at the lower distance mid-flow")
	}
	return ""
}

// The function emitter makes the islands: with both distances 0, the conditional branch
// of `if x > 0` goes to a stub after its block, which branches to the then-block.
func TestEmitFuncPlacesIslands() testing.TestResult {
	var mod @ir.Module = genFromSrc(
			"package \"main\"\nfunc f(x int) int {\n\tif x > 0 { return 1 }\n\treturn 2\n}\n")
	var f @ir.Func
	for i := 0; i < len(mod.Funcs); i++ {
		if !mod.Funcs[i].IsExtern { f = mod.Funcs[i] }
	}
	if f == nil { return fail("no function") }
	var a @asm.Assembler = relaxAsm()
	var mid int = condIslandMid
	var end int = condIslandAtEnd
	condIslandMid = 0
	condIslandAtEnd = 0
	emitFunc(a, "main", f, mod.Strings)
	condIslandMid = mid
	condIslandAtEnd = end
	if a.HasError || !aarch64.ResolveFixups(a) { return fail(a.ErrorMsg) }
	for off := 0; off + 4 <= a.Sections[0].Len; off = off + 4 {
		var w uint32 = word32AA64(a, off)
		if (w & 0xFF000010) != 0x54000000 && (w & 0x7F000000) != 0x35000000 { continue }
		var stub int = branch19Target(a, off)
		if !isIslandStub(symbolAt(a, stub)) {
			return fail("the conditional branch does not go to an island stub")
		}
		var then @[]char = symbolAt(a, branch26Target(a, stub))
		if len(then) == 0 { return fail("the stub does not branch to a block") }
		return ""
	}
	return fail("no conditional branch")
}

// symbolAt is the name of a temporary (`L`) label -- a block's or an island stub's --
// defined at off in the text section, or "".
func symbolAt(a @asm.Assembler, off int) @[]char {
	for i := 0; i < a.NumSymbols; i++ {
		var sym asm.Symbol = a.Symbols[i]
		if sym.Section == 0 && cast(int, sym.Offset) == off && len(sym.Name) > 0 && sym.Name[0] == 'L' {
			return sym.Name
		}
	}
	return ""
}

// isIslandStub reports whether name is an island stub's label (condBranchLabel "isl").
func isIslandStub(name *[]readonly char) bool {
	var prefix *[]readonly char = "Lcb_isl_"
	if len(name) <= len(prefix) { return false }
	for i := 0; i < len(prefix); i++ {
		if name[i] != prefix[i] { return false }
	}
	return true
}
