package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// emitCEntryThunks emits one weak `__centry.<mangled>` adaptation thunk per
// narrow-argument __c_entry target: the target's narrow GP argument-register
// normalization (the same emitCExportRegNorm a #[c_export] entry uses), then an
// unconditional BRANCH to the mangled entry.  A C caller entering the thunk
// sign-/zero-extends the narrow argument registers whose high bits AAPCS64 leaves
// unspecified, then jumps into the real body.  The branch is load-bearing: the
// thunk is a distinct symbol from the entry (a separate ld64 atom), so it can
// never fall through.  Each thunk is WEAK so ld64 / ELF / bnld coalesce the
// copies every native TU emits into one survivor program-wide — that single
// address is what delivers pkg.centry.identity.  On AArch64 an sret return uses
// X8 (a dedicated indirect-result register, not a GP argument register), so it
// causes no argument-register shift and the normalization needs no sret handling.
func emitCEntryThunks(a @asm.Assembler, pkgName *[]readonly char, targets @[]@ir.Func) {
	for ti := 0; ti < len(targets); ti++ {
		var tf @ir.Func = targets[ti]
		var rm @common.RegMap = common.NewRegMap(aarch64CC())
		var thunk @[]char = cEntryThunkSym(pkgName, tf.Name)
		a.DefineLabel(thunk)
		a.SetWeak(thunk)
		var paramTypes @[]@types.Type = make_slice(@types.Type, len(tf.Params))
		for pi := 0; pi < len(tf.Params); pi++ {
			paramTypes[pi] = tf.Params[pi].Typ
		}
		emitCExportRegNorm(a, rm, tf, paramTypes)
		var entry @[]char = symFor(pkgName, tf.Name)
		a.SetGlobal(entry)
		aarch64.B(a, entry)
	}
}
