package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// emitCEntryThunks emits one weak `__centry.<mangled>` adaptation thunk per
// __c_entry target that needs C-ABI adaptation.  Two shapes, mirroring the
// #[c_export] entry:
//   - argument-register-only: normalize the target's narrow GP argument registers
//     (the same emitCExportRegNorm a #[c_export] entry uses), then an
//     unconditional BRANCH to the mangled entry — a C caller sign-/zero-extends
//     the narrow registers AAPCS64 leaves unspecified, then jumps into the body.
//   - a divergent multi-value RETURN: the adaptation happens AFTER the body
//     returns, so a tail-branch cannot serve; the thunk becomes the #[c_export]
//     return TRAMPOLINE (emitCExportRetTrampolineAA64), which also normalizes the
//     narrow argument registers, calls the mangled entry, repacks the return into
//     the C struct-return form, and RETs.
// The branch/trampoline is load-bearing: the thunk is a distinct symbol from the
// entry (a separate ld64 atom), so it can never fall through.  Each thunk is WEAK
// so ld64 / ELF / bnld coalesce the copies every native TU emits into one survivor
// program-wide — that single address is what delivers pkg.centry.identity.  On
// AArch64 an sret return uses X8 (a dedicated indirect-result register, not a GP
// argument register), so no argument-register shift applies for this target.
func emitCEntryThunks(a @asm.Assembler, pkgName *[]readonly char, targets @[]@ir.Func) {
	for ti := 0; ti < len(targets); ti++ {
		var tf @ir.Func = targets[ti]
		var rm @common.RegMap = common.NewRegMap(aarch64CC())
		var thunk @[]char = cEntryThunkSym(pkgName, tf.Name)
		a.DefineLabel(thunk)
		a.SetWeak(thunk)
		var entry @[]char = symFor(pkgName, tf.Name)
		a.SetGlobal(entry)
		if cExportRetTrampolineKindAA64(tf, rm.CC) != common.CRET_ADAPT_NONE {
			emitCExportRetTrampolineAA64(a, rm, tf, entry)
		} else {
			emitCExportRegNorm(a, rm, tf)
			aarch64.B(a, entry)
		}
	}
}
