package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// emitCEntryThunks emits, for a narrow-argument __c_entry target, a WEAK
// `__centry.<mangled>` thunk (argument-register normalization + a branch to the
// mangled entry).  Pins: the thunk symbol is defined and weak (so copies from
// several TUs coalesce = pkg.centry.identity), the mangled entry is referenced
// (the branch target), and some code is emitted (normalization + branch).
func TestEmitCEntryThunkNarrowTarget() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var ps @[]@ir.Param = make_slice(@ir.Param, 1)
	ps[0] = make(ir.Param)
	ps[0].Typ = types.TypInt8()
	var noResults @[]@types.Type
	var tf @ir.Func = ir.NewFunc("main", "cmp", ps, noResults)
	var targets @[]@ir.Func = make_slice(@ir.Func, 1)
	targets[0] = tf
	emitCEntryThunks(a, "main", targets)
	if a.HasError {
		return fail("emitCEntryThunks should not fail on a narrow-arg target")
	}
	// A single int8 arg normalizes to one SXTB (4 bytes) then the unconditional
	// B to the entry (4 bytes) = 8; pinning 8 (not just > 0) catches a dropped
	// branch — the load-bearing "branch, not fall-through" property.
	if bytesWritten(a) != 8 {
		return fail("thunk should emit SXTB (normalization) + B (branch) = 8 bytes")
	}
	var thunkIdx int = a.LookupSymbol(cEntryThunkSym("main", tf.Name))
	if thunkIdx < 0 {
		return fail("the weak __centry thunk symbol should be defined")
	}
	if a.Symbols[thunkIdx].Binding != asm.BIND_WEAK {
		return fail("the __centry thunk symbol must be weak (one survivor program-wide)")
	}
	if a.LookupSymbol(symFor("main", tf.Name)) < 0 {
		return fail("the thunk should reference the mangled entry (its branch target)")
	}
	return ""
}

// A __c_entry target whose multi-value RETURN diverges from the C struct-return
// ABI (no narrow arg) still gets a thunk — the return-trampoline path, not a bare
// branch.  (int64,int64,int64) 24B: the C ABI sret's it (> 16 bytes) while the
// internal convention register-returns it (3 <= 8 GP), so the thunk calls the
// mangled entry and repacks the register result into the caller's X8 sret buffer.
// Pins that emitCEntryThunks routes a return-adapt target through
// emitCExportRetTrampolineAA64 (a weak __centry thunk referencing the entry).
func TestEmitCEntryThunkMultiReturnAdapt() testing.TestResult {
	setAa64Target_retadapt()
	var a @asm.Assembler = mkAsm()
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	var res @[]@types.Type = make_slice(@types.Type, 3)
	for i := 0; i < 3; i++ {
		res[i] = types.TypInt64()
	}
	var noParams @[]@ir.Param
	var tf @ir.Func = ir.NewFunc("main", "cbm", noParams, res)
	tf.MultiReturnType = tuple
	var targets @[]@ir.Func = make_slice(@ir.Func, 1)
	targets[0] = tf
	emitCEntryThunks(a, "main", targets)
	restoreTarget_retadapt()
	if a.HasError {
		return fail("multi-return-adapt thunk should emit without error")
	}
	if bytesWritten(a) == 0 {
		return fail("return-adapt thunk should emit a trampoline")
	}
	var thunkIdx int = a.LookupSymbol(cEntryThunkSym("main", tf.Name))
	if thunkIdx < 0 {
		return fail("the weak __centry thunk symbol should be defined")
	}
	if a.Symbols[thunkIdx].Binding != asm.BIND_WEAK {
		return fail("the __centry thunk symbol must be weak")
	}
	if a.LookupSymbol(symFor("main", tf.Name)) < 0 {
		return fail("the trampoline should reference the mangled entry (its call target)")
	}
	return ""
}
