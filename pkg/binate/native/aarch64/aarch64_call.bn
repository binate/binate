package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/stdx/slices"

// ============================================================
// Direct function call lowering
// ============================================================
//
// emitCall handles OP_CALL — a known callee resolved by name and
// reached via BL <symbol>. Indirect-call variants
// (OP_CALL_INDIRECT, OP_CALL_FUNC_VALUE) live in
// arm64_call_indirect.bn.

// emitAggregateArg marshals an aggregate ARG into the AAPCS64 layout its
// CallArgRegStart/CallArgStackOff report, for a native call site.  An indirect-
// large aggregate (> AggregateInRegMax) passes its data-region pointer in one
// core reg / one stack word (LLVM-AArch64 lowers `ptr byval(<T>)` the same way).
// A <= AggregateInRegMax aggregate loads its words into the assigned core regs
// and, when it STRADDLES the reg/stack boundary (regStart >= 0 AND stackOff >= 0),
// spills the tail: only 8 - regStart words ride registers, because loading all
// nWords would run past X7 (argReg clamps an index >= 8 to X7) and clobber an
// earlier word while the callee reads the split — the exact caller/callee ABI
// disagreement 992_iface_agg_spill caught.  X16 (IP0) is the stack-portion load
// temp.  Shared by emitCall (direct) and emitCallIfaceMethod (aarch64_iface.bn),
// which differ only in how they compute regStart/stackOff; each runs
// rm.ResetRegs() after the arg, so the helper does not.
func emitAggregateArg(a @asm.Assembler, rm @common.RegMap, arg @ir.Instr, regStart int,
		stackOff int) {
	var ptr int = getOperand(a, rm, arg.ID)
	if ptr < 0 { return }
	if rm.CC.IndirectLargeAggregates && arg.Typ.SizeOf() > rm.CC.AggregateInRegMax {
		if regStart >= 0 {
			if ptr != argReg(regStart) {
				aarch64.Mov(a, true, argReg(regStart), aarch64.Reg(ptr))
			}
		} else if stackOff >= 0 {
			aarch64.Str(a, true, ptr, aarch64.MemImm(aarch64.SP, stackOff))
		}
		return
	}
	var nWords int = common.ArgWords(arg.Typ)
	var regWords int = 0
	if regStart >= 0 {
		regWords = nWords
		if stackOff >= 0 { regWords = 8 - regStart }
		for w := 0; w < regWords; w++ {
			aarch64.Ldr(a, true, argReg(regStart + w), aarch64.MemImm(ptr, 8 * w))
		}
	}
	if stackOff >= 0 {
		var tmp int = aarch64.X16
		for w := regWords; w < nWords; w++ {
			aarch64.Ldr(a, true, tmp, aarch64.MemImm(ptr, 8 * w))
			aarch64.Str(a, true, tmp, aarch64.MemImm(aarch64.SP, stackOff + 8 * (w - regWords)))
		}
	}
}

// emitArgBankHomedScalarArgs pre-places every GP scalar call argument whose operand
// is homed in the ARG BANK X0..X7.  Such an operand's home register IS an argument
// register, so the marshalling loop's naive per-arg `mov argReg, home` would permute
// and corrupt when two of them cross (or when one operand's home is another arg's
// destination register).  Resolve all the register-destined ones as a single
// PARALLEL MOVE (cycle-broken through X16), and store the rare stack-destined ones
// straight from their homes (reads a home, writes memory — no permutation).  The
// marshalling loop then SKIPS these args (isArgBankReg(home) guard) since they are
// already in place.  MUST run before the loop, while every arg-bank home still holds
// its operand's value.  Only GP scalars are homed (floats / aggregates are
// non-allocatable), so no other argument kind participates.  argTypes / fixedCount /
// callIsVariadic mirror the loop's CallArg*V placement so the two agree per arg.
func emitArgBankHomedScalarArgs(a @asm.Assembler, rm @common.RegMap, args @[]@ir.Instr,
		argTypes @[]@types.Type, argSlotBase int, fixedCount int, callIsVariadic bool,
		uniformStackWord bool) {
	var srcs @[]int
	var dsts @[]int
	for ai := 0; ai < len(args); ai++ {
		var arg @ir.Instr = args[ai]
		if common.IsFloatScalarTyp(arg.Typ) || common.IsAggregateTyp(arg.Typ) { continue }
		var phome int = rm.LookupHome(arg.ID)
		if phome < 0 || !isArgBankReg(phome) { continue }
		// args[ai] occupies argTypes slot argSlotBase+ai (a shim ABI prepends
		// retbuf/data/receiver prefix slots before the user args).
		var slot int = argSlotBase + ai
		var regStart int = rm.CC.CallArgRegStartV(argTypes, slot, fixedCount, callIsVariadic)
		if regStart >= 0 {
			srcs = slices.Append[int](srcs, phome)
			dsts = slices.Append[int](dsts, argReg(regStart))
		} else {
			// Stack-passed arg-bank home (rare: > 8 GP args).  Store from the home
			// now, before the parallel move below can clobber it.  Match the caller's
			// own loop store width: a shim / indirect ABI passes every arg as a
			// uniform 8-byte dispatch word (uniformStackWord); a direct call stores a
			// narrow scalar at its natural width (StackArgStoreSize).
			var stackOff int = rm.CC.CallArgStackOffV(argTypes, slot, fixedCount, callIsVariadic)
			if stackOff >= 0 {
				if uniformStackWord {
					aarch64.Str(a, true, phome, aarch64.MemImm(aarch64.SP, stackOff))
				} else {
					aarch64.StrSized(a, rm.CC.StackArgStoreSize(arg.Typ, ai >= fixedCount), phome,
							aarch64.MemImm(aarch64.SP, stackOff))
				}
			}
		}
	}
	if len(dsts) == 0 { return }
	// X17 (IP1) is the cycle-break temp — NOT X16.  In the shim marshalling paths
	// (func-value / iface) X16 holds the handle pointer that the post-marshalling
	// shim derivation still needs, so using X16 here would clobber it whenever the
	// arg moves form a cycle.  X17 is free at every call site's pre-pass (the shim
	// target is loaded into it only AFTER marshalling), never an argument register
	// nor a home, and its assembler large-offset use is transient and already past
	// by the pure reg-to-reg moves below.
	var plan @[]int = common.PlanParallelMove(srcs, dsts, aarch64.X17)
	for k := 0; k < len(plan); k = k + 2 {
		aarch64.Mov(a, true, plan[k], aarch64.Reg(plan[k + 1]))
	}
}

// emitParallelReg2 places two operand registers into two argument registers as a
// parallel copy — {d0 <- s0, d1 <- s1} realized so neither clobbers the other's
// source when they cross (s0 in d1 and s1 in d0).  For the runtime-call setup ops
// (div/shift/bounds checks, refdec) whose operands can now be homed in the arg bank
// X0..X7 (a home pool) and thus collide with the argument registers they marshal
// into.  Cycle temp X16 — free at these sites (no handle pointer, unlike the shim
// paths that must use X17).  Identity moves are dropped.
func emitParallelReg2(a @asm.Assembler, s0 int, d0 int, s1 int, d1 int) {
	var s @[]int = make_slice(int, 2)
	var d @[]int = make_slice(int, 2)
	s[0] = s0
	d[0] = d0
	s[1] = s1
	d[1] = d1
	var plan @[]int = common.PlanParallelMove(s, d, aarch64.X16)
	for k := 0; k < len(plan); k = k + 2 {
		aarch64.Mov(a, true, plan[k], aarch64.Reg(plan[k + 1]))
	}
}

// emitCall moves args into X0..X7 and branches to the callee symbol.
// ins.StrVal is the Binate-level call name; goes through
// pkg/binate/mangle.FuncName for the C symbol.
// Declares the callee as a global so Finalize emits a relocation
// rather than failing with "undefined symbol."
func emitCall(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	// AAPCS-style argument dispatch: scalars and aggregates get
	// reg-or-stack assignments via rm.CC.CallArgRegStart /
	// CallArgStackOff (parameterised by the per-RegMap CallConv).
	// Aggregates that don't fit in remaining regs go ENTIRELY on
	// stack (no reg/stack split per arg). Stack args
	// land in the outgoing-args area at [sp+0..OutgoingArgsSize),
	// which PlanFrame reserved at the bottom of the frame so SP
	// stays stable for the surrounding spill addressing.
	var argTypes @[]@types.Type = make_slice(@types.Type, len(ins.Args))
	for i := 0; i < len(ins.Args); i++ {
		argTypes[i] = ins.Args[i].Typ
	}
	// fixedCount marks the fixed/variadic boundary for OP_C_CALL so
	// the V-variant helpers apply the darwin "every vararg on the
	// stack" rule to args at value-index >= CFixedArgs.  For OP_CALL
	// every arg is fixed (fixedCount = len → the V-variants reduce to
	// the base helpers).
	var fixedCount int = len(argTypes)
	if ins.Op == iropcode.OP_C_CALL { fixedCount = ins.CFixedArgs }
	// callIsVariadic: OP_C_CALL's authoritative CVariadic flag, threaded to the
	// V-walkers.  aarch64 uses VariadicStackOnly (per-arg k>=fixedCount), not the
	// per-CALL VfpBackfill float->GP rule, so it does not consume this flag today;
	// it is passed for signature uniformity with the arm32 caller.
	var callIsVariadic bool = ins.Op == iropcode.OP_C_CALL && ins.CVariadic
	// Pre-place arg-bank-homed GP scalar args via a parallel move (see the helper):
	// their homes ARE argument registers, so they cannot be marshalled by the naive
	// per-arg move in the loop below, which SKIPS them.
	emitArgBankHomedScalarArgs(a, rm, ins.Args, argTypes, 0, fixedCount, callIsVariadic, false)
	// AAPCS NSRN: float scalar args go to D(NSRN), separate from the GP NGRN
	// counter.  The first 8 land in D0..D7; a 9th+ float overflows to the
	// outgoing-args stack (an 8-byte slot at CallArgStackOffV, which now
	// reserves space for it), like any arg past its register budget.
	var nsrn int = 0
	for ai := 0; ai < len(ins.Args); ai++ {
		var arg @ir.Instr = ins.Args[ai]
		// Use the shared common.IsFloatScalarTyp (peels alias / readonly /
		// named), matching the callee prologue and the convention-layer NSRN
		// walkers — a divergent predicate here would mis-count NSRN and place an
		// alias-/readonly-float in the wrong register file.
		if common.IsFloatScalarTyp(arg.Typ) {
			var src int = getOperand(a, rm, arg.ID)
			if src < 0 { continue }
			if ai >= fixedCount && rm.CC.VariadicStackOnly {
				// Darwin stacks EVERY variadic argument — a variadic
				// double goes to the outgoing-args area, not D(NSRN),
				// where printf would otherwise read 0.  src holds the
				// double's bits in a GP reg; store all 8 bytes.
				var stackOff int = rm.CC.CallArgStackOffV(argTypes, ai, fixedCount, callIsVariadic)
				if stackOff >= 0 {
					aarch64.Str(a, true, src, aarch64.MemImm(aarch64.SP, stackOff))
				}
				rm.ResetRegs()
				continue
			}
			if nsrn < rm.CC.NumFpArgRegs {
				aarch64.Fmov_gp_to_fp(a, aarch64.D0 + nsrn, src)
			} else {
				// FP arg registers exhausted: the float overflows to the
				// outgoing-args stack.  src holds the float's bits in a GP reg;
				// store its natural width (4 bytes for a float32 on a
				// natural-size-stack convention, else 8) so it matches the
				// callee's read and does not overrun the next slot / the frame.
				var stackOff int = rm.CC.CallArgStackOffV(argTypes, ai, fixedCount, callIsVariadic)
				if stackOff >= 0 {
					aarch64.StrSized(a, rm.CC.StackArgStoreSize(arg.Typ, ai >= fixedCount), src,
							aarch64.MemImm(aarch64.SP, stackOff))
				}
			}
			// Count EVERY float in arg order (matching the walker / callee), so
			// the overflow decision stays correct past D7.
			nsrn = nsrn + 1
			rm.ResetRegs()
			continue
		}
		// Homogeneous Floating-point Aggregate: place each float member into a
		// consecutive FP arg register D(nsrn+m) (member m loaded from the struct
		// data at byte offset hfaW*m — HFA members are same-width, no padding).
		// All-or-nothing: on FP overflow the whole HFA goes on the outgoing-args
		// stack.  Counts NSRN by member count, matching the walkers / callee.
		hfaN, hfaW := types.HfaClassify(arg.Typ)
		if rm.CC.HfaAggregates && hfaN > 0 {
			var ptr int = getOperand(a, rm, arg.ID)
			if ptr < 0 { continue }
			// DarwinPCS stacks EVERY variadic argument, HFAs included: a variadic
			// HFA must NOT ride v(NSRN)..v(NSRN+n-1) even when the FP file has
			// room, or clang's va_arg (which reads it from the stack) gets
			// garbage.  The walker's CallArgStackOffV agrees — it closes the FP
			// file at the fixed/variadic boundary — so the reservation and this
			// store land at the same offset.
			var hfaToStack bool = ai >= fixedCount && rm.CC.VariadicStackOnly
			if !hfaToStack && nsrn + hfaN <= rm.CC.NumFpArgRegs {
				for m := 0; m < hfaN; m++ {
					aarch64.Ldr(a, hfaW == 8, aarch64.X16, aarch64.MemImm(ptr, hfaW * m))
					aarch64.Fmov_gp_to_fp(a, aarch64.D0 + nsrn + m, aarch64.X16)
				}
				nsrn = nsrn + hfaN
			} else {
				var stackOff int = rm.CC.CallArgStackOffV(argTypes, ai, fixedCount, callIsVariadic)
				var nWords int = common.ArgWords(arg.Typ)
				if stackOff >= 0 {
					for w := 0; w < nWords; w++ {
						aarch64.Ldr(a, true, aarch64.X16, aarch64.MemImm(ptr, 8 * w))
						aarch64.Str(a, true, aarch64.X16, aarch64.MemImm(aarch64.SP, stackOff + 8 * w))
					}
				}
				nsrn = rm.CC.NumFpArgRegs
			}
			rm.ResetRegs()
			continue
		}
		var regStart int = rm.CC.CallArgRegStartV(argTypes, ai, fixedCount, callIsVariadic)
		var stackOff int = rm.CC.CallArgStackOffV(argTypes, ai, fixedCount, callIsVariadic)
		if common.IsAggregateTyp(arg.Typ) {
			emitAggregateArg(a, rm, arg, regStart, stackOff)
		} else {
			var phome int = rm.LookupHome(arg.ID)
			if phome >= 0 && isArgBankReg(phome) {
				// Homed in the arg bank: already placed by the parallel-move
				// pre-pass (emitArgBankHomedScalarArgs).  Re-marshalling here would
				// read the home AFTER the pre-pass moved the operand out of it.
				rm.ResetRegs()
				continue
			}
			var src int = emitValOperand(a, pkgName, rm, arg)
			if src < 0 { continue }
			if regStart >= 0 {
				if src != argReg(regStart) {
					aarch64.Mov(a, true, argReg(regStart), aarch64.Reg(src))
				}
			} else {
				// A narrow fixed scalar (int8 / int16 / int32) packs at its
				// natural size + alignment on a natural-size-stack convention
				// (Apple-AArch64); other scalars take the full 8-byte slot.
				// StrSized matches the store width so it does not overrun a
				// neighbor's natural-sized slot (an 8-byte store would).
				aarch64.StrSized(a, rm.CC.StackArgStoreSize(arg.Typ, ai >= fixedCount), src,
						aarch64.MemImm(aarch64.SP, stackOff))
			}
		}
		// Each arg's load uses a fresh pool slot via getOperand — the
		// Mov/Str above consumes the value into argReg(N) or the stack
		// slot, so the scratch reg is dead. Reset between args so a
		// long arg list (8+) doesn't saturate the X9..X15 pool.
		// `nsrn` is the only arg-loop state we need to preserve, and
		// it's a stack-local int — ResetRegs clears the regmap, not
		// the loop variables.
		rm.ResetRegs()
	}

	// AAPCS sret: caller passes &returnBuffer in X8 before BL when
	// (a) return is an aggregate > 64 bytes (our internal Binate
	// convention) or (b) the result is a multi-return tuple > 64
	// bytes — without (b), tuples beyond X0..X7's 64 bytes silently
	// drop their tail.
	var bigMultiRet bool = ins.ID >= 0 && rm.CC.CallReturnsBigMultiReturn(ins)
	var bigRet bool = ins.ID >= 0 && (rm.CC.CallReturnsBigAggregate(ins) || bigMultiRet)
	if bigRet {
		// Multi-return tuples land in the spill slot (sized to the
		// full tuple by PlanFrame); single-aggregate returns land in
		// the data region (alloc).
		var sretOff int = -1
		if bigMultiRet {
			sretOff = rm.LookupSpill(ins.ID)
		} else {
			sretOff = rm.LookupAlloc(ins.ID)
		}
		if sretOff >= 0 {
			aarch64.Add(a, true, aarch64.X8, aarch64.SP, aarch64.Imm(sretOff))
		}
	}

	// __c_call carries a verbatim C symbol on ins.StrVal (no Binate
	// mangling); every other call op goes through symFor.  Both
	// paths still need symPrefixed for the object-format linkage
	// convention (Mach-O leading '_' vs ELF bare) — otherwise the
	// emitted `BL abs` would reference a `abs` symbol the darwin
	// linker can't find (it wants `_abs`).
	var callee @[]char
	if ins.Op == iropcode.OP_C_CALL {
		callee = symPrefixed(ins.StrVal)
	} else {
		callee = symFor(pkgName, ins.StrVal)
	}
	a.SetGlobal(callee)
	aarch64.Bl(a, callee)

	// BL clobbers X9..X15. Reset the pool, then spill this call's
	// return value(s) so later uses can reload.
	rm.ResetRegs()
	if ins.ID < 0 { return }
	// Aggregate return that isn't a multi-return TYP_STRUCT — a slice,
	// an array, or a named struct-by-value — goes into a dedicated
	// data region (pointer-in-spill form, same as MAKE_SLICE) so
	// arg-spreading and OP_EXTRACT can treat it uniformly with
	// LOAD/MAKE_SLICE results. For ≤64-byte returns the callee packs
	// X0..X(N-1) and we spill them into the region; for >64-byte sret
	// returns the callee already wrote through X8 — we just produce
	// the pointer.
	if ins.Typ != nil && common.IsAggregateTyp(ins.Typ) && !common.IsMultiReturnCall(ins) {
		var dataOff int = rm.LookupAlloc(ins.ID)
		if dataOff < 0 { return }
		var sz int = ins.Typ.SizeOf()
		if sz <= 0 { return }
		if !bigRet {
			if rm.CC.ReturnsHfaInRegs(ins.Typ) {
				// HFA result: members come back in D0..D(n-1) (SIMD),
				// so store each from its FP reg into the data region
				// at m*memW — not the GP X0.. pack below.  bigRet is
				// already false for HFAs (CallReturnsBigAggregate
				// exempts them), so control reaches here.
				n, memW := types.HfaClassify(ins.Typ)
				for m := 0; m < n; m++ {
					hfaMemberStoreFromFp(a, aarch64.D0 + m, aarch64.SP, dataOff + m * memW, memW)
				}
			} else {
				var nWords int = common.ArgWords(ins.Typ)
				for ri := 0; ri < nWords && ri < 8; ri++ {
					aarch64.Str(a, true, argReg(ri), aarch64.MemImm(aarch64.SP, dataOff + 8 * ri))
				}
			}
		}
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	}
	// Multi-return TYP_STRUCT packs the tuple bytes directly into the
	// slot. Mirror OP_RETURN's per-arg register assignment exactly:
	// scalar fields take one X-register each (sized stores keep
	// sub-word fields like uint32 from clobbering their neighbor in
	// the same 8-byte cell), aggregate fields spread across N
	// consecutive registers and write back to consecutive 8-byte
	// offsets within the field. A naive `nWords = SizeOf(tuple) / 8`
	// loses the second register entirely for `(uint32, uint32)` —
	// total size 8 bytes / 1 word, but the callee returns it in
	// X0 + X1.
	var spillOff int = rm.LookupSpill(ins.ID)
	if spillOff < 0 { return }
	// Big multi-return tuples were already written through X8 by the
	// callee — the spill slot is the X8 destination.  Nothing to
	// collect from registers.
	if bigMultiRet { return }
	if !common.IsMultiReturnCall(ins) {
		collectScalarReturn(a, rm, ins, spillOff)
		return
	}
	collectMultiReturnFields(a, rm, ins, spillOff)
}
