package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Indirect-call lowering: emitCallIndirect (OP_CALL_INDIRECT,
// dtor / free_fn / cross-mode dispatch, called via BLR Xn) and
// emitCallFuncValue (OP_CALL_FUNC_VALUE, vtable.call always-shim
// path for function-value calls). Both share the AAPCS arg-passing
// machinery emitCall in arm64_call.bn uses; only the callee-target
// load and the final BLR vs BL differ.

// emitCallIndirect emits an indirect call (BLR Xn). Args[0] is the
// fn_ptr (loaded into X17 before arg dispatch may clobber its source);
// Args[1..] are the call args, dispatched via the same AAPCS machinery
// emitCall uses (X0..X7, then stack at SP+0..). X17 is the AAPCS IP1
// scratch register, safe across MOV+arg-loads since BL is the only
// thing that clobbers X16/X17 and we haven't BL'd yet. Same return-
// value handling as emitCall.
func emitCallIndirect(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		ins @ir.Instr) {
	if len(ins.Args) < 1 { return }

	// Stash fn_ptr in X17 before the arg-dispatch loop, which writes
	// X0..X7 (and may use X16 as a load temp for stack aggregates).
	// Loading the source register here ensures the value survives
	// even if the source reg gets reused below.
	var fnSrc int = getOperand(a, rm, ins.Args[0].ID)
	if fnSrc < 0 { return }
	aarch64.Mov(a, true, aarch64.X17, aarch64.Reg(fnSrc))

	// AAPCS arg dispatch on the call args (Args[1..]).
	var nCallArgs int = len(ins.Args) - 1
	var argTypes @[]@types.Type = make_slice(@types.Type, nCallArgs)
	for i := 0; i < nCallArgs; i++ {
		argTypes[i] = ins.Args[i + 1].Typ
	}
	var nsrn int = 0
	for ai := 0; ai < nCallArgs; ai++ {
		var arg @ir.Instr = ins.Args[ai + 1]
		if isFloatTyp(arg.Typ) {
			var src int = getOperand(a, rm, arg.ID)
			if src < 0 { continue }
			if nsrn < 8 {
				aarch64.Fmov_gp_to_fp(a, aarch64.D0 + nsrn, src)
				nsrn = nsrn + 1
			}
			continue
		}
		var regStart int = rm.CC.CallArgRegStart(argTypes, ai)
		var stackOff int = rm.CC.CallArgStackOff(argTypes, ai)
		if common.IsAggregateTyp(arg.Typ) {
			var ptr int = getOperand(a, rm, arg.ID)
			if ptr < 0 { continue }
			// Indirect-large: pass the data-region pointer in 1
			// reg / 1 stack word; see emitCall (aarch64_call.bn).
			if rm.CC.IndirectLargeAggregates && arg.Typ.SizeOf() > rm.CC.AggregateInRegMax {
				if regStart >= 0 {
					if ptr != argReg(regStart) {
						aarch64.Mov(a, true, argReg(regStart), aarch64.Reg(ptr))
					}
				} else if stackOff >= 0 {
					aarch64.Str(a, true, ptr, aarch64.MemImm(aarch64.SP, stackOff))
				}
				rm.ResetRegs()
				continue
			}
			var nWords int = common.ArgWords(arg.Typ)
			if regStart >= 0 {
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true, argReg(regStart + w), aarch64.MemImm(ptr, 8 * w))
				}
			} else {
				var tmp int = aarch64.X16
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true, tmp, aarch64.MemImm(ptr, 8 * w))
					aarch64.Str(a, true, tmp, aarch64.MemImm(aarch64.SP, stackOff + 8 * w))
				}
			}
		} else {
			var src int = emitValOperand(a, pkgName, rm, arg)
			if src < 0 { continue }
			if regStart >= 0 {
				if src != argReg(regStart) {
					aarch64.Mov(a, true, argReg(regStart), aarch64.Reg(src))
				}
			} else {
				// Every emitCallIndirect arg is a uniform 8-byte dispatch
				// WORD (an `int` / pointer): OP_CALL_INDIRECT is emitted only
				// by rt._call_shim_scalar / _call_shim_aggregate, whose
				// signatures pass the shim address + data/retbuf + a0..a6 all
				// as `int`.  A narrow (int8/int16/int32 / float32) scalar never
				// reaches here, so the full 8-byte Str is correct — no
				// StackArgStoreSize / StrSized natural-size store, unlike
				// emitCall (which marshals real-typed user args).
				aarch64.Str(a, true, src, aarch64.MemImm(aarch64.SP, stackOff))
			}
		}
		// Mirror emitCall: each arg's load uses a fresh pool slot via
		// getOperand, and the value is consumed into argReg(N) or the
		// stack slot before we move on, so the scratch reg is dead.
		// Reset between args so a long arg list doesn't saturate the
		// pool (op=50 panic on pkg/binate/vm / cmd/bni under
		// builder-comp_native_aa64-comp_native_aa64).  Float args take
		// the early `continue` above, matching emitCall's pattern.
		rm.ResetRegs()
	}

	// AAPCS sret: indirect calls have no callee-symbol — only the
	// (a)/(b) cases from emitCall (big aggregate / big multi-return)
	// apply.
	var bigMultiRet bool = ins.ID >= 0 && rm.CC.CallReturnsBigMultiReturn(ins)
	var bigRet bool = ins.ID >= 0 && (rm.CC.CallReturnsBigAggregate(ins) || bigMultiRet)
	if bigRet {
		var sretOff int = -1
		if bigMultiRet {
			sretOff = rm.LookupSpill(ins.ID)
		} else {
			sretOff = rm.LookupAlloc(ins.ID)
		}
		if sretOff >= 0 {
			aarch64.Add(a, true, aarch64.X8, aarch64.SP, aarch64.Imm(sretOff))
		}
	}

	// BLR X17 — branch-and-link through the stashed fn_ptr register.
	aarch64.Blr(a, aarch64.X17)

	rm.ResetRegs()
	if ins.ID < 0 { return }

	// Aggregate single-return: spill X0..X(N-1) into the alloc region,
	// then materialize the region pointer (mirror of emitCall).
	if ins.Typ != nil && common.IsAggregateTyp(ins.Typ) && !common.IsMultiReturnCall(ins) {
		var dataOff int = rm.LookupAlloc(ins.ID)
		if dataOff < 0 { return }
		var sz int = ins.Typ.SizeOf()
		if sz <= 0 { return }
		if !bigRet {
			var nWords int = common.ArgWords(ins.Typ)
			for ri := 0; ri < nWords && ri < 8; ri++ {
				aarch64.Str(a, true, argReg(ri), aarch64.MemImm(aarch64.SP, dataOff + 8 * ri))
			}
		}
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	}

	var spillOff int = rm.LookupSpill(ins.ID)
	if spillOff < 0 { return }
	if bigMultiRet { return }
	if !common.IsMultiReturnCall(ins) {
		collectScalarReturn(a, rm, ins, spillOff)
		return
	}
	collectMultiReturnFields(a, rm, ins, spillOff)
}

// emitCallFuncValue lowers OP_CALL_FUNC_VALUE: call through a 2-word
// function value's vtable.call.  Always-shim convention.  Two calling
// conventions for the shim, distinguished by return type:
//
//   Scalar / void return: shim signature
//     `<ret>(*uint8 data, <args>)`.  Caller loads data from the
//     function value's data slot (offset 8), passes it in X0, then
//     puts user args in X1+ (one synthetic prepended *uint8 slot
//     shifts AAPCS register-start by one).
//
//   Aggregate return: shim signature
//     `void(*uint8 retbuf, *uint8 data, <args>)` — retbuf-style.
//     Caller allocates retbuf (PlanFrame's alloc region for the
//     instruction), passes retbuf in X0, data in X1, user args in
//     X2+ (TWO synthetic prepended slots).  After the call the
//     retbuf alloc region holds the return value — no X0..X(N-1)
//     spill required.  Mirrors emit_call.bn:emitCallFuncValue
//     (LLVM-side) which allocates an `<ret>` alloca + passes its
//     address.  Pre-fix this used the scalar shape (data in X0,
//     packed X0..X(N-1) return), which only worked while
//     emitFuncValueShims was scalar-only too — broke once the
//     shim grew the pack/sret aggregate paths.
//
// VM-mode dispatch is unchanged (see BC_CALL_FUNC_VALUE in
// vm_exec.bn): the bytecode short-circuits via the closure record's
// vm_func_idx and never goes through vtable.call.  This compiled
// path is the one that uses the shim.
func emitCallFuncValue(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		ins @ir.Instr) {
	if len(ins.Args) < 1 { return }

	// Two-step load to populate X17 with vtable.call:
	//   LDR X17, [fvAddr + 0]   ; X17 = vtable_ptr
	//   LDR X17, [X17 + 8]      ; X17 = vtable.call
	// Same X17 for source+dest in the second LDR is fine — AArch64
	// updates the dest after the load completes.
	var fvAddr int = getOperand(a, rm, ins.Args[0].ID)
	if fvAddr < 0 { return }
	aarch64.Ldr(a, true, aarch64.X17, aarch64.MemImm(fvAddr, types.FuncValueVtableOffset()))
	aarch64.Ldr(a, true, aarch64.X17, aarch64.MemImm(aarch64.X17, 8))

	// Aggregate-return: shim shape prepends two synthetic *uint8
	// slots (retbuf + data) before user args.  Scalar shape: one
	// (data).  `prefixSlots` is also the AAPCS reg offset for user
	// args (they start at X(prefixSlots)).  Under retbuf-for-any-multi-return
	// the shim writes EVERY multi-return through the retbuf (matching the LLVM
	// shim + caller + VM cross-mode dispatch), so a single aggregate AND any
	// multi-return (big OR small) ride the retbuf-in-X0 convention: retbuf in
	// X0, data in X1, user args X2+.  aa64 has no SretInGpArgReg, so a BIG tuple
	// ALSO passes its retbuf as the GP arg X0 (the shim does Mov X8,X0
	// internally) — the caller does NOT preset X8.  (Pre-fix a small multi-
	// return stayed on the scalar shape, passed data in X0, and collected field-
	// per-register from the return regs the LLVM shim never wrote — the 972/973
	// aa64 miscompile; a big tuple crashed because the caller passed data in X0
	// but the LLVM shim wrote retbuf in X0 — the 971 crash.)
	// Classify the RESULT with types.IsAggregateReturnTyp — the single-source-of-
	// truth retbuf-vs-scalar predicate the LLVM shim (codegen isAggregateReturn),
	// the callee, and the VM cross-mode dispatch all agree on — NOT the kind-only
	// common.IsAggregateTyp.  The two agree for every SizeOf >= 1 result; they
	// differ only for a 0-byte aggregate (`struct{}` / `[0]T`), which is void-like
	// (no retbuf).  With the kind-only predicate a 0-byte result demanded a retbuf,
	// but PlanFrame reserves no data region for it (dataSz > 0 gate), so LookupAlloc
	// returned -1 and the call was silently dropped BEFORE the BLR; and the LLVM shim
	// (usePack gated on retSz >= 1) routes it to the void tail-jump, so the call site
	// and shim disagreed.  Routing it to the scalar/void shape realigns them.
	var aggregateRet bool = ins.ID >= 0 && types.IsAggregateReturnTyp(ins.Typ) &&
			!common.IsMultiReturnCall(ins)
	var multiRet bool = ins.ID >= 0 && common.IsMultiReturnCall(ins)
	var useRetbuf bool = aggregateRet || multiRet
	var prefixSlots int = 1
	if useRetbuf { prefixSlots = 2 }

	// Build the synthetic argTypes (prepended prefix slots + the all-int-shim-ABI
	// user-arg substitutions) and marshal the user args into their slots.  Both
	// helpers are shared with emitCallIfaceMethod (aarch64_iface.bn) so the two
	// arg layouts can't drift.  Doing this before the retbuf/data loads means a
	// user arg whose source reg happens to be X0 / X1 is read before we overwrite
	// those registers.
	var nCallArgs int = len(ins.Args) - 1
	var argTypes @[]@types.Type = shimArgTypesAA64(rm.CC, ins, nCallArgs, prefixSlots)
	emitShimUserArgsAA64(a, pkgName, rm, ins, argTypes, prefixSlots, nCallArgs)

	// Load retbuf (aggregate path) and data into the AAPCS register
	// slots for arg indices 0 and 1 (typically X0 / X1).  Done AFTER
	// the user-args dispatch so any user arg whose source reg was X0
	// / X1 has already been read.
	//
	// If the arg loop ran, the per-arg ResetRegs above will have
	// reallocated slot 0 (X9 = fvAddr's reg) for an arg's scratch,
	// clobbering fvAddr's contents.  Reload before the retbuf/data
	// computation.
	if nCallArgs > 0 {
		fvAddr = getOperand(a, rm, ins.Args[0].ID)
		if fvAddr < 0 { return }
	}
	if useRetbuf {
		// X0 = retbuf (the buffer the shim writes the result through): a single
		// aggregate uses its pre-allocated alloc region; a multi-return (big OR
		// small) uses the spill slot the tuple result lands in.  The shim does
		// its own X8 sret plumbing for a big tuple — the caller does NOT set X8.
		var retbufOff int = -1
		if aggregateRet {
			retbufOff = rm.LookupAlloc(ins.ID)
		} else {
			retbufOff = rm.LookupSpill(ins.ID)
		}
		if retbufOff < 0 { return }
		aarch64.Add(a, true, argReg(0), aarch64.SP, aarch64.Imm(retbufOff))
		// X1 = [fvAddr + 8] (data).
		aarch64.Ldr(a, true, argReg(1), aarch64.MemImm(fvAddr, types.FuncValueDataOffset()))
	} else {
		var dataRegStart int = rm.CC.CallArgRegStart(argTypes, 0)
		if dataRegStart >= 0 {
			aarch64.Ldr(a, true, argReg(dataRegStart), aarch64.MemImm(fvAddr, types.FuncValueDataOffset()))
		}
	}

	aarch64.Blr(a, aarch64.X17)
	rm.ResetRegs()
	collectShimReturnAA64(a, rm, ins, aggregateRet, multiRet)
}

// shimArgTypesAA64 builds the synthetic AAPCS argTypes list for a handle/shim
// dispatch: `prefixSlots` leading *uint8 words (the shim's retbuf?/data/receiver
// prefix) followed by the user args ins.Args[1..] under the all-int shim ABI.
// Every user-arg WORD travels as a uniform 8-byte GP dispatch word, so a float
// scalar (its bits in a GP slot the shim fmov's into d/s), a by-address aggregate
// (isByAddressAggAA64 — one pointer the shim loads + re-expands, NOT its ArgWords
// value-word expansion), and a narrow (<8-byte) non-aggregate scalar (rounded to a
// full 8-byte slot so a 9th+ narrow arg isn't placed at a misaligned natural
// offset) each collapse to a single *uint8 slot.  The natural-size packing of a
// narrow scalar applies only on the shim's OUTGOING side to the lifted body, not
// to these incoming dispatch words.  Shared by emitCallFuncValue (prefixSlots 1
// scalar / 2 retbuf) and emitCallIfaceMethod (prefixSlots 2 scalar / 3 retbuf —
// one extra slot for the receiver) so the two arg layouts can't drift.
func shimArgTypesAA64(cc common.CallConv, ins @ir.Instr, nCallArgs int,
		prefixSlots int) @[]@types.Type {
	var argTypes @[]@types.Type = make_slice(@types.Type, nCallArgs + prefixSlots)
	for p := 0; p < prefixSlots; p++ {
		argTypes[p] = types.MakePointerType(types.TypUint8())
	}
	for i := 0; i < nCallArgs; i++ {
		var at @types.Type = ins.Args[i + 1].Typ
		if common.IsFloatScalarTyp(at) || isByAddressAggAA64(cc, at) ||
				(!common.IsAggregateTyp(at) && at.SizeOf() < 8) {
			at = types.MakePointerType(types.TypUint8())
		}
		argTypes[i + prefixSlots] = at
	}
	return argTypes
}

// emitShimUserArgsAA64 dispatches a handle/shim call's user args (ins.Args[1..])
// into their AAPCS slots per the all-int shim ABI: every aggregate rides
// BY-ADDRESS as ONE pointer word (reg or stack) — the shim loads + re-expands it,
// matching the LLVM cross-package shim's i8*-per-aggregate contract — and every
// other arg as an 8-byte GP dispatch word (a float scalar's bits ride a GP slot,
// a narrow scalar a rounded 8-byte slot; the natural-size narrow store is the
// spill shim's OUTGOING job, not the dispatch's).  `argTypes` is shimArgTypesAA64's
// synthetic list; user arg i occupies slot i+prefixSlots.  Per-arg ResetRegs keeps
// the scratch pool from saturating on long arg lists (the op=50 saturation
// emitCallFuncValue / emitCallIndirect guard against).  Shared by emitCallFuncValue
// and emitCallIfaceMethod.
func emitShimUserArgsAA64(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		ins @ir.Instr, argTypes @[]@types.Type, prefixSlots int, nCallArgs int) {
	for ai := 0; ai < nCallArgs; ai++ {
		var arg @ir.Instr = ins.Args[ai + 1]
		var regStart int = rm.CC.CallArgRegStart(argTypes, ai + prefixSlots)
		var stackOff int = rm.CC.CallArgStackOff(argTypes, ai + prefixSlots)
		if common.IsAggregateTyp(arg.Typ) {
			var ptr int = getOperand(a, rm, arg.ID)
			if ptr < 0 { continue }
			if regStart >= 0 {
				if ptr != argReg(regStart) {
					aarch64.Mov(a, true, argReg(regStart), aarch64.Reg(ptr))
				}
			} else if stackOff >= 0 {
				aarch64.Str(a, true, ptr, aarch64.MemImm(aarch64.SP, stackOff))
			}
			rm.ResetRegs()
			continue
		} else {
			var src int = emitValOperand(a, pkgName, rm, arg)
			if src < 0 { continue }
			if regStart >= 0 {
				if src != argReg(regStart) {
					aarch64.Mov(a, true, argReg(regStart), aarch64.Reg(src))
				}
			} else {
				aarch64.Str(a, true, src, aarch64.MemImm(aarch64.SP, stackOff))
			}
		}
		rm.ResetRegs()
	}
}

// collectShimReturnAA64 collects a handle/shim call's return value after the BLR
// (and its rm.ResetRegs()).  aggregateRet: the shim wrote the single aggregate
// THROUGH the retbuf we passed in X0 (the alloc region) — just produce the region
// pointer as this instruction's result, no X0..X(N-1) spill.  multiRet: the shim
// wrote the whole tuple through the retbuf (the spill slot) — big via its internal
// X8 sret, small via a store-through-retbuf — so nothing is collected from the
// return registers (which the shim never wrote).  Otherwise a scalar result (float
// scalars included — the shim already fmov'd a float d0/s0 into x0) comes back in
// x0; canonicalize a sub-word integer (a foreign sub-word target reached through
// the shim leaves x0 only low-bits-valid) and store x0 to the spill slot.  Shared
// by emitCallFuncValue and emitCallIfaceMethod — their shims use the identical
// retbuf/scalar return ABI, so the collect can't drift between the two.
func collectShimReturnAA64(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr, aggregateRet bool,
		multiRet bool) {
	if ins.ID < 0 { return }
	if aggregateRet {
		var dataOff int = rm.LookupAlloc(ins.ID)
		if dataOff < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	}
	var spillOff int = rm.LookupSpill(ins.ID)
	if spillOff < 0 { return }
	if multiRet { return }
	canonicalizeSubWordReturn(a, ins.Typ, argReg(0))
	aarch64.Str(a, true, argReg(0), aarch64.MemImm(aarch64.SP, spillOff))
}
