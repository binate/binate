package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Indirect-call lowering: emitCallIndirect (OP_CALL_INDIRECT,
// dtor / free_fn / cross-mode dispatch, called via BLR Xn) and
// emitCallFuncValue (OP_CALL_FUNC_VALUE, vtable.call always-shim
// path for function-value calls). Both share the AAPCS arg-passing
// machinery emitCall in arm64_call.bn uses; only the callee-target
// load and the final BLR vs BL differ.

// emitCallIndirect emits an indirect call (BLR Xn). Args[0] is the
// fn_ptr (loaded into X17 before arg dispatch may clobber its source);
// Args[1..] are the call args, dispatched via the same AAPCS machinery
// emitCall uses (X0..X7, then stack at SP+0..). X17 is the AAPCS IP1
// scratch register, safe across MOV+arg-loads since BL is the only
// thing that clobbers X16/X17 and we haven't BL'd yet. Same return-
// value handling as emitCall.
func emitCallIndirect(a @asm.Assembler, pkgName *[]readonly char,
	rm @common.RegMap, allFuncs @[]@ir.Func, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }

	// Stash fn_ptr in X17 before the arg-dispatch loop, which writes
	// X0..X7 (and may use X16 as a load temp for stack aggregates).
	// Loading the source register here ensures the value survives
	// even if the source reg gets reused below.
	var fnSrc int = getOperand(a, rm, ins.Args[0].ID)
	if fnSrc < 0 { return }
	aarch64.Mov(a, true, aarch64.X17, aarch64.Reg(fnSrc))

	// AAPCS arg dispatch on the call args (Args[1..]).
	var nCallArgs int = len(ins.Args) - 1
	var argTypes @[]@types.Type = make_slice(@types.Type, nCallArgs)
	for i := 0; i < nCallArgs; i++ {
		argTypes[i] = ins.Args[i + 1].Typ
	}
	var nsrn int = 0
	for ai := 0; ai < nCallArgs; ai++ {
		var arg @ir.Instr = ins.Args[ai + 1]
		if isFloatTyp(arg.Typ) {
			var src int = getOperand(a, rm, arg.ID)
			if src < 0 { continue }
			if nsrn < 8 {
				aarch64.Fmov_gp_to_fp(a,
					aarch64.D0 + nsrn, src)
				nsrn = nsrn + 1
			}
			continue
		}
		var regStart int = rm.CC.CallArgRegStart(argTypes, ai)
		var stackOff int = rm.CC.CallArgStackOff(argTypes, ai)
		if common.IsAggregateTyp(arg.Typ) {
			var ptr int = getOperand(a, rm, arg.ID)
			if ptr < 0 { continue }
			// Indirect-large: pass the data-region pointer in 1
			// reg / 1 stack word; see emitCall (aarch64_call.bn).
			if rm.CC.IndirectLargeAggregates &&
					arg.Typ.SizeOf() > rm.CC.AggregateInRegMax {
				if regStart >= 0 {
					if ptr != argReg(regStart) {
						aarch64.Mov(a, true,
							argReg(regStart),
							aarch64.Reg(ptr))
					}
				} else if stackOff >= 0 {
					aarch64.Str(a, true, ptr,
						aarch64.MemImm(aarch64.SP, stackOff))
				}
				rm.ResetRegs()
				continue
			}
			var nWords int = common.ArgWords(arg.Typ)
			if regStart >= 0 {
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true,
						argReg(regStart + w),
						aarch64.MemImm(ptr, 8*w))
				}
			} else {
				var tmp int = aarch64.X16
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true, tmp,
						aarch64.MemImm(ptr, 8*w))
					aarch64.Str(a, true, tmp,
						aarch64.MemImm(aarch64.SP,
							stackOff + 8*w))
				}
			}
		} else {
			var src int = emitValOperand(a, pkgName, rm, arg)
			if src < 0 { continue }
			if regStart >= 0 {
				if src != argReg(regStart) {
					aarch64.Mov(a, true,
						argReg(regStart),
						aarch64.Reg(src))
				}
			} else {
				// Every emitCallIndirect arg is a uniform 8-byte dispatch
				// WORD (an `int` / pointer): OP_CALL_INDIRECT is emitted only
				// by rt._call_shim_scalar / _call_shim_aggregate, whose
				// signatures pass the shim address + data/retbuf + a0..a6 all
				// as `int`.  A narrow (int8/int16/int32 / float32) scalar never
				// reaches here, so the full 8-byte Str is correct — no
				// StackArgStoreSize / StrSized natural-size store, unlike
				// emitCall (which marshals real-typed user args).
				aarch64.Str(a, true, src,
					aarch64.MemImm(aarch64.SP, stackOff))
			}
		}
		// Mirror emitCall: each arg's load uses a fresh pool slot via
		// getOperand, and the value is consumed into argReg(N) or the
		// stack slot before we move on, so the scratch reg is dead.
		// Reset between args so a long arg list doesn't saturate the
		// pool (op=50 panic on pkg/binate/vm / cmd/bni under
		// builder-comp_native_aa64-comp_native_aa64).  Float args take
		// the early `continue` above, matching emitCall's pattern.
		rm.ResetRegs()
	}

	// AAPCS sret: indirect calls have no callee-symbol, so
	// CalleeUsesCSret never fires here — only the (a)/(c) cases
	// from emitCall (big aggregate / big multi-return) apply.
	var bigMultiRet bool = ins.ID >= 0 &&
		rm.CC.CallReturnsBigMultiReturn(ins)
	var bigRet bool = ins.ID >= 0 &&
		(rm.CC.CallReturnsBigAggregate(ins) || bigMultiRet)
	if bigRet {
		var sretOff int = -1
		if bigMultiRet {
			sretOff = rm.LookupSpill(ins.ID)
		} else {
			sretOff = rm.LookupAlloc(ins.ID)
		}
		if sretOff >= 0 {
			aarch64.Add(a, true, aarch64.X8, aarch64.SP,
				aarch64.Imm(sretOff))
		}
	}

	// BLR X17 — branch-and-link through the stashed fn_ptr register.
	aarch64.Blr(a, aarch64.X17)

	rm.ResetRegs()
	if ins.ID < 0 { return }

	// Aggregate single-return: spill X0..X(N-1) into the alloc region,
	// then materialize the region pointer (mirror of emitCall).
	if ins.Typ != nil && common.IsAggregateTyp(ins.Typ) &&
		!common.IsMultiReturnCall(ins) {
		var dataOff int = rm.LookupAlloc(ins.ID)
		if dataOff < 0 { return }
		var sz int = ins.Typ.SizeOf()
		if sz <= 0 { return }
		if !bigRet {
			var nWords int = common.ArgWords(ins.Typ)
			for ri := 0; ri < nWords && ri < 8; ri++ {
				aarch64.Str(a, true, argReg(ri),
					aarch64.MemImm(aarch64.SP,
						dataOff + 8*ri))
			}
		}
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	}

	var spillOff int = rm.LookupSpill(ins.ID)
	if spillOff < 0 { return }
	if bigMultiRet { return }
	if !common.IsMultiReturnCall(ins) {
		collectScalarReturn(a, rm, ins, spillOff)
		return
	}
	collectMultiReturnFields(a, rm, ins, spillOff)
}

// emitCallFuncValue lowers OP_CALL_FUNC_VALUE: call through a 2-word
// function value's vtable.call.  Always-shim convention (Phase 3 of
// plan-function-values.md).  Two calling conventions for the shim,
// distinguished by return type:
//
//   Scalar / void return: shim signature
//     `<ret>(*uint8 data, <args>)`.  Caller loads data from the
//     function value's data slot (offset 8), passes it in X0, then
//     puts user args in X1+ (one synthetic prepended *uint8 slot
//     shifts AAPCS register-start by one).
//
//   Aggregate return: shim signature
//     `void(*uint8 retbuf, *uint8 data, <args>)` — retbuf-style.
//     Caller allocates retbuf (PlanFrame's alloc region for the
//     instruction), passes retbuf in X0, data in X1, user args in
//     X2+ (TWO synthetic prepended slots).  After the call the
//     retbuf alloc region holds the return value — no X0..X(N-1)
//     spill required.  Mirrors emit_call.bn:emitCallFuncValue
//     (LLVM-side) which allocates an `<ret>` alloca + passes its
//     address.  Pre-fix this used the scalar shape (data in X0,
//     packed X0..X(N-1) return), which only worked while
//     emitFuncValueShims was scalar-only too — broke once the
//     shim grew the pack/sret aggregate paths.
//
// VM-mode dispatch is unchanged (see BC_CALL_FUNC_VALUE in
// vm_exec.bn): the bytecode short-circuits via the closure record's
// vm_func_idx and never goes through vtable.call.  This compiled
// path is the one that uses the shim.
func emitCallFuncValue(a @asm.Assembler, pkgName *[]readonly char,
	rm @common.RegMap, allFuncs @[]@ir.Func, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }

	// Two-step load to populate X17 with vtable.call:
	//   LDR X17, [fvAddr + 0]   ; X17 = vtable_ptr
	//   LDR X17, [X17 + 8]      ; X17 = vtable.call
	// Same X17 for source+dest in the second LDR is fine — AArch64
	// updates the dest after the load completes.
	var fvAddr int = getOperand(a, rm, ins.Args[0].ID)
	if fvAddr < 0 { return }
	aarch64.Ldr(a, true, aarch64.X17,
		aarch64.MemImm(fvAddr, types.FuncValueVtableOffset()))
	aarch64.Ldr(a, true, aarch64.X17,
		aarch64.MemImm(aarch64.X17, 8))

	// Aggregate-return: shim shape prepends two synthetic *uint8
	// slots (retbuf + data) before user args.  Scalar shape: one
	// (data).  `prefixSlots` is also the AAPCS reg offset for user
	// args (they start at X(prefixSlots)).
	var aggregateRet bool = ins.ID >= 0 && ins.Typ != nil &&
		common.IsAggregateTyp(ins.Typ) &&
		!common.IsMultiReturnCall(ins)
	var prefixSlots int = 1
	if aggregateRet { prefixSlots = 2 }

	// Build a synthetic argTypes list with the prepended *uint8
	// slot(s) so AAPCS register-start computations account for
	// them.
	var nCallArgs int = len(ins.Args) - 1
	var argTypes @[]@types.Type =
		make_slice(@types.Type, nCallArgs + prefixSlots)
	for p := 0; p < prefixSlots; p++ {
		argTypes[p] = types.MakePointerType(types.TypUint8())
	}
	for i := 0; i < nCallArgs; i++ {
		var at @types.Type = ins.Args[i + 1].Typ
		// All-int shim ABI: every arg travels as a uniform 8-byte GP
		// dispatch WORD (a float-scalar's bits in a GP slot the shim
		// fmov's into d/s; a narrow int8/int16/int32 in a full 8-byte slot
		// so the shim's 8-byte incoming reader is uniform and a 9th+ narrow
		// arg is NOT placed at a misaligned natural offset).  Substitute a
		// 1-word *uint8 for a float scalar (so CallArgRegStart counts it in
		// the GP sequence) AND for any narrow (sub-8-byte) non-aggregate
		// scalar (so its dispatch word is the rounded 8 bytes, not the
		// underlying's natural 1/2/4).  The natural-size packing applies
		// only on the shim's OUTGOING side (to the lifted body), not to
		// these incoming dispatch words.
		if common.IsFloatScalarTyp(at) ||
				common.AggCoercedInReg(at) ||
				(!common.IsAggregateTyp(at) && at.SizeOf() < 8) {
			// A coerced in-register struct/array now rides the dispatch as one
			// by-address pointer (the shim loads + re-coerces it), so its slot
			// is a single *uint8 word like a float/narrow scalar -- not its
			// ArgWords value-word expansion.
			at = types.MakePointerType(types.TypUint8())
		}
		argTypes[i + prefixSlots] = at
	}

	// Arg dispatch for user args, indexed in the synthetic argTypes
	// (offset by prefixSlots to skip retbuf + data).  Under the all-int
	// shim ABI every arg word — float bits included — is a GP slot, so
	// there is no separate FP path here: floats flow through the scalar
	// branch via their (pointer-substituted) GP position.  User args
	// land in X(prefixSlots)+; doing this before the retbuf/data loads
	// means a user arg whose source reg happens to be X0 / X1 still
	// reads the right value before we overwrite it.
	for ai := 0; ai < nCallArgs; ai++ {
		var arg @ir.Instr = ins.Args[ai + 1]
		var regStart int = rm.CC.CallArgRegStart(argTypes,
			ai + prefixSlots)
		var stackOff int = rm.CC.CallArgStackOff(argTypes,
			ai + prefixSlots)
		if common.IsAggregateTyp(arg.Typ) {
			var ptr int = getOperand(a, rm, arg.ID)
			if ptr < 0 { continue }
			// By-address: pass the aggregate's pointer in 1 reg / 1 stack
			// word -- an indirect-large aggregate (>16B / managed-slice) AND
			// a coerced in-register struct/array (the shim loads + re-coerces
			// it).  Only a small raw slice / iface value (neither) still rides
			// its inline value words below.
			if (rm.CC.IndirectLargeAggregates &&
					arg.Typ.SizeOf() > rm.CC.AggregateInRegMax) ||
					common.AggCoercedInReg(arg.Typ) {
				if regStart >= 0 {
					if ptr != argReg(regStart) {
						aarch64.Mov(a, true,
							argReg(regStart),
							aarch64.Reg(ptr))
					}
				} else if stackOff >= 0 {
					aarch64.Str(a, true, ptr,
						aarch64.MemImm(aarch64.SP, stackOff))
				}
				rm.ResetRegs()
				continue
			}
			var nWords int = common.ArgWords(arg.Typ)
			if regStart >= 0 {
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true,
						argReg(regStart + w),
						aarch64.MemImm(ptr, 8*w))
				}
			} else {
				var tmp int = aarch64.X16
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true, tmp,
						aarch64.MemImm(ptr, 8*w))
					aarch64.Str(a, true, tmp,
						aarch64.MemImm(aarch64.SP,
							stackOff + 8*w))
				}
			}
		} else {
			var src int = emitValOperand(a, pkgName, rm, arg)
			if src < 0 { continue }
			if regStart >= 0 {
				if src != argReg(regStart) {
					aarch64.Mov(a, true,
						argReg(regStart),
						aarch64.Reg(src))
				}
			} else {
				// Uniform 8-byte dispatch WORD: a narrow scalar arg was
				// substituted to *uint8 above, so every arg here occupies a
				// rounded 8-byte slot.  The natural-size narrow store (StrSized)
				// is the SPILL shim's job on the OUTGOING side to the lifted
				// body (emitFuncvalSpillShimAA64), not the dispatch's — so the
				// full 8-byte Str is correct here.
				aarch64.Str(a, true, src,
					aarch64.MemImm(aarch64.SP, stackOff))
			}
		}
		// Mirror emitCall: per-arg ResetRegs to keep the scratch
		// pool from saturating on long arg lists.  See arm64_call.bn
		// for the rationale; pkg/binate/vm / cmd/bni hit op=50 saturation
		// (OP_CALL_INDIRECT, which is what emitCallFuncValue lowers
		// to) under builder-comp_native_aa64-comp_native_aa64 without
		// this.
		rm.ResetRegs()
	}

	// Load retbuf (aggregate path) and data into the AAPCS register
	// slots for arg indices 0 and 1 (typically X0 / X1).  Done AFTER
	// the user-args dispatch so any user arg whose source reg was X0
	// / X1 has already been read.
	//
	// If the arg loop ran, the per-arg ResetRegs above will have
	// reallocated slot 0 (X9 = fvAddr's reg) for an arg's scratch,
	// clobbering fvAddr's contents.  Reload before the retbuf/data
	// computation.
	if nCallArgs > 0 {
		fvAddr = getOperand(a, rm, ins.Args[0].ID)
		if fvAddr < 0 { return }
	}
	if aggregateRet {
		var retbufOff int = rm.LookupAlloc(ins.ID)
		if retbufOff < 0 { return }
		// X0 = SP + retbufOff (address of pre-allocated retbuf).
		aarch64.Add(a, true, argReg(0), aarch64.SP,
			aarch64.Imm(retbufOff))
		// X1 = [fvAddr + 8] (data).
		aarch64.Ldr(a, true, argReg(1),
			aarch64.MemImm(fvAddr, types.FuncValueDataOffset()))
	} else {
		var dataRegStart int = rm.CC.CallArgRegStart(argTypes, 0)
		if dataRegStart >= 0 {
			aarch64.Ldr(a, true, argReg(dataRegStart),
				aarch64.MemImm(fvAddr, types.FuncValueDataOffset()))
		}
	}

	// AAPCS sret applies only to multi-return aggregates passed
	// through the always-shim convention; single-aggregate returns
	// use the retbuf-in-X0 convention above instead.
	var bigMultiRet bool = ins.ID >= 0 &&
		rm.CC.CallReturnsBigMultiReturn(ins)
	if bigMultiRet {
		var sretOff int = rm.LookupSpill(ins.ID)
		if sretOff >= 0 {
			aarch64.Add(a, true, aarch64.X8, aarch64.SP,
				aarch64.Imm(sretOff))
		}
	}

	aarch64.Blr(a, aarch64.X17)
	rm.ResetRegs()
	if ins.ID < 0 { return }

	// Aggregate single-return: the shim wrote the result through
	// the retbuf we passed in X0.  No X0..X(N-1) spill — just
	// produce the alloc-region pointer as this instruction's
	// result.
	if aggregateRet {
		var dataOff int = rm.LookupAlloc(ins.ID)
		if dataOff < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	}

	var spillOff int = rm.LookupSpill(ins.ID)
	if spillOff < 0 { return }
	if bigMultiRet { return }
	if !common.IsMultiReturnCall(ins) {
		// All-int shim ABI: the scalar result — float scalars included —
		// comes back in x0 (the shim already fmov'd a float d0/s0 -> x0).
		// Store x0 directly; collectScalarReturn would (wrongly here)
		// read a float result from d0, where the native ABI puts it but
		// the all-int shim does not.
		aarch64.Str(a, true, argReg(0),
			aarch64.MemImm(aarch64.SP, spillOff))
		return
	}
	collectMultiReturnFields(a, rm, ins, spillOff)
}
