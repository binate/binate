package "pkg/binate/native/aarch64"

import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the aarch64 #[c_export] multi-value-return adaptation classifier
// (aarch64_cexport_retadapt.bn).  The trampoline EMISSION itself is exercised
// end-to-end by e2e/ffi-export.sh (the multiret driver) across the host arch;
// these pin the aa64-side kind decision (cExportRetTrampolineKindAA64 over the
// shared common classifier) so a regression is observable at the unit level.

func setAa64Target_retadapt() {
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	types.SetTarget(t)
	types.SetArch(types.ARCH_AA64)
}

func restoreTarget_retadapt() {
	types.SetArch(types.ARCH_UNKNOWN)
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	types.SetTarget(t)
}

// mkMultiRetFunc builds an ir.Func with the given result types and the matching
// anonymous multi-return tuple (as ir-gen's makeMultiReturnStructType does).
func mkMultiRetFunc(results @[]@types.Type) @ir.Func {
	var f @ir.Func = make(ir.Func)
	f.Name = "test.MR"
	f.Results = results
	var fields @[]@types.Field = make_slice(@types.Field, len(results))
	for i := 0; i < len(results); i++ {
		fields[i] = make(types.Field)
		fields[i].Type = results[i]
	}
	f.MultiReturnType = types.MakeStructType("", fields)
	return f
}

func res3i64() @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, 3)
	r[0] = types.TypInt64()
	r[1] = types.TypInt64()
	r[2] = types.TypInt64()
	return r
}

func res2i32() @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, 2)
	r[0] = types.TypInt32()
	r[1] = types.TypInt32()
	return r
}

func res2i64() @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, 2)
	r[0] = types.TypInt64()
	r[1] = types.TypInt64()
	return r
}

func res3f64() @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, 3)
	r[0] = types.TypFloat64()
	r[1] = types.TypFloat64()
	r[2] = types.TypFloat64()
	return r
}

// (int64,int64,int64) 24B: internal register (3 ≤ 8 GP words), C sret (>16) → SRET.
func TestCExportRetKindAA64Sret() testing.TestResult {
	setAa64Target_retadapt()
	var f @ir.Func = mkMultiRetFunc(res3i64())
	var kind int = cExportRetTrampolineKindAA64(f, aarch64CC())
	restoreTarget_retadapt()
	if kind != common.CRET_ADAPT_SRET {
		return "aa64 (i64,i64,i64) c_export return should be SRET"
	}
	return ""
}

// (int32,int32) 8B: both register-return, C packs into x0 → COERCE.
func TestCExportRetKindAA64Coerce() testing.TestResult {
	setAa64Target_retadapt()
	var f @ir.Func = mkMultiRetFunc(res2i32())
	var kind int = cExportRetTrampolineKindAA64(f, aarch64CC())
	restoreTarget_retadapt()
	if kind != common.CRET_ADAPT_COERCE {
		return "aa64 (i32,i32) c_export return should be COERCE"
	}
	return ""
}

// (int64,int64) 16B word-sized, and (f64,f64,f64) HFA: both plain alias → NONE.
func TestCExportRetKindAA64None() testing.TestResult {
	setAa64Target_retadapt()
	var wf @ir.Func = mkMultiRetFunc(res2i64())
	var hf @ir.Func = mkMultiRetFunc(res3f64())
	var wkind int = cExportRetTrampolineKindAA64(wf, aarch64CC())
	var hkind int = cExportRetTrampolineKindAA64(hf, aarch64CC())
	restoreTarget_retadapt()
	if wkind != common.CRET_ADAPT_NONE {
		return "aa64 (i64,i64) c_export return should be NONE (alias)"
	}
	if hkind != common.CRET_ADAPT_NONE {
		return "aa64 (f64,f64,f64) HFA c_export return should be NONE (alias)"
	}
	return ""
}

// A single-result function never diverges.
func TestCExportRetKindAA64SingleResult() testing.TestResult {
	setAa64Target_retadapt()
	var f @ir.Func = make(ir.Func)
	f.Name = "test.S"
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt64()
	f.Results = results
	var kind int = cExportRetTrampolineKindAA64(f, aarch64CC())
	restoreTarget_retadapt()
	if kind != common.CRET_ADAPT_NONE {
		return "single-result c_export return should be NONE"
	}
	return ""
}
