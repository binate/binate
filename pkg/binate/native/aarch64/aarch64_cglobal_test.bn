package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit test for the aarch64 OP_C_GLOBAL lowering (aarch64_dispatch.bn, plan
// §5b).  __c_global yields the ADDRESS of an external C global as a raw *T.
// aarch64 native is a PIE (macOS) link, so the address is reached GOT-indirect
// against the VERBATIM external symbol (`_environ`, Mach-O '_' prefix, no
// Binate mangling): ADRP the GOT-slot page (GOT_LOAD_PAGE21) + LDR the slot's
// contents (GOT_LOAD_PAGEOFF12) — the symbol's real address.  Helpers (mkAsm,
// bytesWritten) live in aarch64_emit_test.bn; fail() in aarch64_test.bn.
func TestCGlobalEmitsGotLoad() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_C_GLOBAL
	ins.StrVal = "environ"
	// Result is *T (raw pointer); TypeArg is the pointee T.
	ins.TypeArg = types.MakePointerType(types.TypUint8())
	ins.Typ = types.MakePointerType(ins.TypeArg)
	var noStrs @[]ir.StringConst
	emitInstr(a, "main", "caller", rm, noStrs, ins)
	if a.HasError {
		return fail("__c_global must not error on aarch64 (GOT addressing)")
	}
	// ADRP + LDR = two 4-byte instructions.
	if bytesWritten(a) != 8 {
		return fail("__c_global address is an ADRP+LDR GOT pair (8 bytes)")
	}
	// The verbatim external symbol carries the Mach-O '_' prefix but NO Binate
	// mangling (an `bn_` mangle would make `environ` unlinkable).
	var si int = a.LookupSymbol("_environ")
	if si < 0 {
		return fail("__c_global must register the verbatim external symbol _environ")
	}
	// Load-bearing: it must be an UNDEFINED external reference (Section == -1),
	// so the linker binds it to libc's real `environ` via a GOT slot — not a
	// bogus local definition that would shadow it with wrong storage.
	if a.Symbols[si].Section != -1 {
		return fail(
				"__c_global must register _environ as an UNDEFINED external "
						"(Section == -1), not a local definition")
	}
	// The two fixups must be the GOT-indirect pair, in ADRP-then-LDR order —
	// a non-GOT pair (PAGE21/PAGEOFF12) would reach the symbol directly, which
	// a PIE linker rejects for a cross-DSO datum on macOS.
	var s @asm.Section = a.Sections[0]
	if s.NumFixups != 2 {
		return fail("__c_global emits exactly two fixups (ADRP-GOT, LDR-GOT)")
	}
	if s.Fixups[0].Kind != aarch64.FIX_ADRP_GOT_HI21 {
		return fail("first fixup must be FIX_ADRP_GOT_HI21")
	}
	if s.Fixups[1].Kind != aarch64.FIX_LD_GOT_LO12 {
		return fail("second fixup must be FIX_LD_GOT_LO12")
	}
	return ""
}
