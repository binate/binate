package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/slices"

// Native aarch64 emission for the per-(literal, capture-shape) shim
// that backs a capturing function literal (B.2 of plan-function-
// values-phase-2.md).  Split from aarch64.bn to keep that file under
// the hygiene soft length cap.
//
// Two paths, mirroring pkg/binate/native/x64/x64_closure_shim.bn:
//
//   * Fast path — every outgoing arg lands in a GP arg register:
//       shim:
//         <shift user args X1..XM up to X(W+1)..X(W+M)>
//         <load capture words X(W-1)..X1 from [X0, #off_*]>
//         <load X0 from [X0, #off_0]>   // base clobbered last
//         B underlying_fn
//     W is the TOTAL capture-word count.
//
//   * Stack-spill path — any outgoing arg classifies as MEMORY or
//     gets pushed to the stack by AAPCS64's classifier (no
//     remaining GP-reg budget):
//       shim:
//         SUB sp, sp, #stkBytes        ; stkBytes already 16-aligned
//                                       ; by CallStackBytes
//         <spill stack-bound args: [X0+ofs] → X16 → [SP+sof]>
//         <move user-args incoming → outgoing positions>
//         <load reg-bound captures: [X0+ofs] → argReg(rs)>
//         BL underlying_fn
//         ADD sp, sp, #stkBytes
//         RET
//     X16 is the AAPCS64 intra-call scratch (IP0); same role as
//     RAX in the x64 stack-spill path.

// lookupClosureFuncAA64 returns the Func with the given name iff
// it is a capturing-literal closure (IsClosure=true).  Returns nil
// for non-closure refs and for cross-module references.
func lookupClosureFuncAA64(mod @ir.Module, name @[]char) @ir.Func {
	for i := 0; i < len(mod.Funcs); i++ {
		if !charEqAA64(mod.Funcs[i].Name, name) { continue }
		if !mod.Funcs[i].IsClosure { return nil }
		return mod.Funcs[i]
	}
	return nil
}

// emitClosureShim emits the per-(literal, capture-shape) shim for a
// capturing closure.  Caller has already emitted the label and
// SetWeak; this writes the shim body.  Picks fast-path or stack-
// spill based on the AAPCS64 classifier's output for the outgoing
// arg list.
//
// Constraints (apply to both paths):
//   - scalar / void return only (return size ≤ 8 bytes)
//   - incoming user-args may exceed X1..X7 — overflow words on the
//     caller's stack are read from [SP + stkBytes + offset] in the
//     stack-spill path (since the only way nUserWords > 7 is reachable
//     is when shimNeedsStackSpill is also true, which it is once
//     captures + 7-reg-user-args > 8 reg words).
//
// Outside these constraints the shim falls back to plain `B` to
// the underlying — wrong behavior but the assembler doesn't blow
// up.
func emitClosureShim(a @asm.Assembler, fnLabel @[]char,
		fvTyp @types.Type, f @ir.Func) {
	var cc common.CallConv = common.AAPCS64()
	var argTypes @[]@types.Type = buildShimArgTypesAA64(fvTyp, f)
	var nUserWords int = 0
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		nUserWords = nUserWords +
			common.ArgWords(fvTyp.Params[pi].Type)
	}
	if !shimNeedsStackSpillAA64(cc, argTypes) {
		emitClosureShimFastAA64(a, fnLabel, fvTyp, f, nUserWords)
		return
	}
	emitClosureShimStackSpillAA64(a, fnLabel, fvTyp, f, cc, argTypes,
		nUserWords)
}

// buildShimArgTypesAA64 returns the type list for the OUTGOING call
// the shim performs: captures first (in ClosureStruct field order),
// then user-args.  Same shape the CallConv classifier expects for a
// normal direct call.
func buildShimArgTypesAA64(fvTyp @types.Type,
		f @ir.Func) @[]@types.Type {
	var argTypes @[]@types.Type
	for i := 0; i < f.NumCaptureParams; i++ {
		argTypes = slices.Append[@types.Type](argTypes,
			f.ClosureStruct.Fields[i].Type)
	}
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		argTypes = slices.Append[@types.Type](argTypes,
			fvTyp.Params[pi].Type)
	}
	return argTypes
}

// shimNeedsStackSpillAA64 reports whether any arg in the outgoing
// call ends up partially or wholly on the stack
// (CallArgStackOff >= 0).  If none do, the simpler fast path (B,
// no SP adjustment) suffices.  Under AAPCS64 (SplitAggregates =
// true) an aggregate might have BOTH a regStart and a stackOff —
// the SPLIT case — which still requires the stack-spill path.
func shimNeedsStackSpillAA64(cc common.CallConv,
		argTypes @[]@types.Type) bool {
	for i := 0; i < len(argTypes); i++ {
		if cc.CallArgStackOff(argTypes, i) >= 0 { return true }
	}
	return false
}

// isIndirectLargeCapAA64 reports whether a capture-type is passed
// via the IndirectLargeAggregates convention (a single pointer in
// 1 reg / 1 stack word) at the underlying body's call boundary.
// Mirrors the classifier path in
// pkg/binate/native/common/common_callconv.bn's
// argRegWordsStackWords for the indirect-large branch.
func isIndirectLargeCapAA64(cc common.CallConv,
		t @types.Type) bool {
	return cc.IndirectLargeAggregates &&
		common.IsAggregateTyp(t) &&
		t.SizeOf() > cc.AggregateInRegMax
}

// effectiveCapWordsAA64 returns the number of GP arg-reg slots a
// capture consumes at the underlying body's call boundary — 1 for
// indirect-large aggregates (pointer-pass), ArgWords for the rest.
func effectiveCapWordsAA64(cc common.CallConv,
		t @types.Type) int {
	if isIndirectLargeCapAA64(cc, t) { return 1 }
	return common.ArgWords(t)
}

// emitClosureShimFastAA64 is the register-only path: every outgoing
// arg lands wholly in a GP arg register.  Indirect-large captures
// contribute 1 reg slot (a pointer to the closure-struct field);
// scalar / small-aggregate captures contribute their ArgWords reg
// slots (per-word loads from the closure struct).
func emitClosureShimFastAA64(a @asm.Assembler, fnLabel @[]char,
		fvTyp @types.Type, f @ir.Func, nUserWords int) {
	var cc common.CallConv = common.AAPCS64()
	var captureWords int = 0
	for i := 0; i < f.NumCaptureParams; i++ {
		captureWords = captureWords +
			effectiveCapWordsAA64(cc, f.ClosureStruct.Fields[i].Type)
	}
	if captureWords + nUserWords > 8 {
		a.SetGlobal(fnLabel)
		aarch64.B(a, fnLabel)
		return
	}
	for j := nUserWords - 1; j >= 0; j = j - 1 {
		var srcReg int = argReg(j + 1)
		var dstReg int = argReg(captureWords + j)
		if srcReg != dstReg {
			aarch64.Mov(a, true, dstReg, aarch64.Reg(srcReg))
		}
	}
	// Captures right-to-left so X0 (the closure-struct base) stays
	// valid until the final emit.  The i=0 case may clobber X0
	// (regStart 0 → ADD X0, X0, #ofs0 for indirect-large, or Ldr
	// X0, [X0, #ofs0] for scalar at offset 0); placing it last
	// keeps the base alive for earlier captures.
	var w int = captureWords
	for i := f.NumCaptureParams - 1; i >= 0; i = i - 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var baseOfs int = f.ClosureStruct.FieldOffset(i)
		if isIndirectLargeCapAA64(cc, ft) {
			w = w - 1
			// ADD argReg(w), X0, #baseOfs — pointer-pass.
			aarch64.Add(a, true, argReg(w), aarch64.X0,
				aarch64.Imm(baseOfs))
			continue
		}
		var wordCount int = common.ArgWords(ft)
		for k := wordCount - 1; k >= 0; k = k - 1 {
			w = w - 1
			aarch64.Ldr(a, true, argReg(w),
				aarch64.MemImm(aarch64.X0, baseOfs + k * 8))
		}
	}
	a.SetGlobal(fnLabel)
	aarch64.B(a, fnLabel)
}

// emitClosureShimStackSpillAA64 handles the AAPCS64 mixed-or-stack
// case: at least one outgoing arg has a stack component.  Sets up a
// proper call frame around BL.  Ordering:
//   1. SUB sp, sp, #stkBytes  — reserve the outgoing-args area.
//      stkBytes is already 16-byte-aligned by CallStackBytes, so SP
//      stays 16-aligned (LR / FP are NOT pushed: the shim is a
//      leaf-call frame, so the BL itself preserves alignment).
//   2. Spill stack-bound capture words via X16 (AAPCS intra-call
//      scratch).  Done first because X0 is the closure-struct base
//      — steps 3 / 4 may overwrite it.
//   3. Move user-args from incoming positions to outgoing positions.
//      Process right-to-left so a forward shift reads each source
//      before its slot becomes a destination.  Stack-bound outgoing
//      user-args are written via plain Str (no scratch needed).
//   4. Load register-bound capture words.  For SPLIT captures, the
//      reg part loads here; the stack part was spilled in step 2.
//      Right-to-left over captures so the i=0 case (which may write
//      X0) runs last.
//   5. BL underlying, ADD sp + RET.
func emitClosureShimStackSpillAA64(a @asm.Assembler, fnLabel @[]char,
		fvTyp @types.Type, f @ir.Func, cc common.CallConv,
		argTypes @[]@types.Type, nUserWords int) {
	var stkBytes int = cc.CallStackBytes(argTypes)
	aarch64.Sub(a, true, aarch64.SP, aarch64.SP,
		aarch64.Imm(stkBytes))

	// Step 1: spill stack-bound capture portions.  Two cases:
	//   * Indirect-large capture that overflowed to stack
	//     (regStart < 0, stackWords=1): compute the pointer (ADD
	//     X16, X0, #ofs) and Str X16 to [SP + stkOff].
	//   * SPLIT capture (AAPCS64 with SplitAggregates=true): regWords
	//     words go to regs, the rest spill — shuttle the spill
	//     portion through X16.
	// Done first because X0 is still the closure-struct base —
	// steps 2/3 may overwrite it.
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var regStart int = cc.CallArgRegStart(argTypes, i)
		var stkOff int = cc.CallArgStackOff(argTypes, i)
		var fieldOfs int = f.ClosureStruct.FieldOffset(i)
		if stkOff < 0 { continue }
		if isIndirectLargeCapAA64(cc, ft) {
			// Indirect-large capture, stack-bound: pointer-pass.
			aarch64.Add(a, true, aarch64.X16, aarch64.X0,
				aarch64.Imm(fieldOfs))
			aarch64.Str(a, true, aarch64.X16,
				aarch64.MemImm(aarch64.SP, stkOff))
			continue
		}
		var nWords int = common.ArgWords(ft)
		var firstStackWord int = 0
		if regStart >= 0 {
			firstStackWord = cc.NumGpArgRegs - regStart
		}
		for k := firstStackWord; k < nWords; k = k + 1 {
			aarch64.Ldr(a, true, aarch64.X16,
				aarch64.MemImm(aarch64.X0, fieldOfs + k * 8))
			aarch64.Str(a, true, aarch64.X16,
				aarch64.MemImm(aarch64.SP,
					stkOff + (k - firstStackWord) * 8))
		}
	}

	// Step 2: move user-args from incoming positions to outgoing
	// positions per CallConv.  Right-to-left over user-args so a
	// forward shift (low → high reg) reads each register source
	// before its slot becomes a destination.
	//
	// Incoming layout: user-arg word with global word-index
	// inIdx (0..nUserWords-1) is in X(1 + inIdx) if inIdx < 7,
	// else on the CALLER'S stack at [SP_orig + (inIdx - 7) * 8].
	// After step 0's `SUB sp, sp, #stkBytes`, the caller's SP is
	// at [SP + stkBytes], so the stack source address becomes
	// [SP + stkBytes + (inIdx - 7) * 8].
	//
	// Outgoing layout is what the classifier dictates for argIdx.
	// Four transfer shapes:
	//   * reg-source → reg-dest:   MOV  dstReg, srcReg
	//   * reg-source → stack-dest: STR  srcReg, [SP, outStkOff]
	//   * stack-source → reg-dest: LDR  dstReg, [SP, inStkOff]
	//   * stack-source → stack-dest: LDR X16, [SP, inStkOff]; STR X16, [SP, outStkOff]
	// X16 (AAPCS intra-call scratch) is safe here — step 1's
	// shuttle uses have already been consumed.
	var userArgStart int = f.NumCaptureParams
	var inRegBase int = 1 + nUserWords
	for ui := len(fvTyp.Params) - 1; ui >= 0; ui = ui - 1 {
		var ut @types.Type = fvTyp.Params[ui].Type
		var nUw int = common.ArgWords(ut)
		inRegBase = inRegBase - nUw
		var argIdx int = userArgStart + ui
		var outRegStart int = cc.CallArgRegStart(argTypes, argIdx)
		var outStkOff int = cc.CallArgStackOff(argTypes, argIdx)
		for k := nUw - 1; k >= 0; k = k - 1 {
			emitUserArgWordMoveAA64(a, inRegBase, k, stkBytes,
				outRegStart, outStkOff)
		}
		// SPLIT for user-args (reg portion + stack portion) isn't
		// reachable for scalar / pointer user-args under AAPCS64;
		// the only SPLIT-eligible user-arg shapes are aggregates,
		// which this shim path doesn't yet flow through.
	}

	// Step 3: load register-bound capture portions.  For indirect-
	// large captures with regStart >= 0 (single reg slot, pointer-
	// pass): ADD argReg(regStart), X0, #fieldOfs.  For per-word
	// captures: Ldr each word into argReg(regStart..regStart+regWords-1).
	// SPLIT captures get only their reg portion here; the stack
	// portion was spilled in step 1.  Right-to-left so the i=0
	// case (which may write X0 when regStart=0) runs last,
	// keeping X0 valid as the base for earlier reads.
	for i := f.NumCaptureParams - 1; i >= 0; i = i - 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var regStart int = cc.CallArgRegStart(argTypes, i)
		var fieldOfs int = f.ClosureStruct.FieldOffset(i)
		if regStart < 0 { continue }
		if isIndirectLargeCapAA64(cc, ft) {
			aarch64.Add(a, true, argReg(regStart), aarch64.X0,
				aarch64.Imm(fieldOfs))
			continue
		}
		var nWords int = common.ArgWords(ft)
		var regWords int = nWords
		if cc.CallArgStackOff(argTypes, i) >= 0 {
			// SPLIT: only the reg portion here.
			regWords = cc.NumGpArgRegs - regStart
		}
		for k := regWords - 1; k >= 0; k = k - 1 {
			aarch64.Ldr(a, true, argReg(regStart + k),
				aarch64.MemImm(aarch64.X0, fieldOfs + k * 8))
		}
	}

	// Step 4: BL underlying, unwind the stack frame.  The CALLER's
	// LR is still in LR (we haven't pushed it — leaf shim), so we
	// need to preserve it across BL.  BL overwrites LR with the
	// shim's return address, so before calling we save LR into
	// X16 (AAPCS intra-call scratch — already used as the shuttle,
	// but its value has been consumed by step 1 already).  After
	// BL, restore LR from X16 before RET so the shim returns to
	// the original caller.
	aarch64.Mov(a, true, aarch64.X16, aarch64.Reg(aarch64.LR))
	a.SetGlobal(fnLabel)
	aarch64.Bl(a, fnLabel)
	aarch64.Mov(a, true, aarch64.LR, aarch64.Reg(aarch64.X16))
	aarch64.Add(a, true, aarch64.SP, aarch64.SP,
		aarch64.Imm(stkBytes))
	aarch64.Ret(a)
}

// totalCaptureWordsAA64 sums the AAPCS64 register-word footprint of
// each capture-type — scalars / pointers are 1, managed-slice is 4,
// managed function-value is 2, etc.  Used by the fast path to
// budget X0..X7 and to compute the user-arg shift target index.
func totalCaptureWordsAA64(f @ir.Func) int {
	var w int = 0
	for i := 0; i < f.NumCaptureParams; i++ {
		w = w + common.ArgWords(f.ClosureStruct.Fields[i].Type)
	}
	return w
}

// emitUserArgWordMoveAA64 emits the single-word transfer for a
// user-arg word at slot k of the current user-arg, given the user-
// arg's incoming register base (inRegBase, accumulated by step 2's
// loop), the post-SUB stkBytes adjustment, and the outgoing reg/
// stack slot (one of outRegStart >= 0 OR outStkOff >= 0, never
// both — SPLIT user-args aren't reachable here).
//
// The incoming source is determined by the global word index
// `inIdx = inRegBase + k - 1` (0-based across all user-arg words):
// reg X(1 + inIdx) if inIdx < 7, else stack [SP + stkBytes +
// (inIdx - 7) * 8].
func emitUserArgWordMoveAA64(a @asm.Assembler, inRegBase int,
		k int, stkBytes int, outRegStart int, outStkOff int) {
	var inIdx int = inRegBase + k - 1
	var srcIsReg bool = inIdx < 7
	var srcReg int
	var srcStkOff int = 0
	if srcIsReg {
		srcReg = argReg(1 + inIdx)
	} else {
		srcStkOff = stkBytes + (inIdx - 7) * 8
	}
	if outRegStart >= 0 && outStkOff < 0 {
		var dstReg int = argReg(outRegStart + k)
		if srcIsReg {
			if srcReg != dstReg {
				aarch64.Mov(a, true, dstReg, aarch64.Reg(srcReg))
			}
		} else {
			aarch64.Ldr(a, true, dstReg,
				aarch64.MemImm(aarch64.SP, srcStkOff))
		}
		return
	}
	if outRegStart < 0 && outStkOff >= 0 {
		if srcIsReg {
			aarch64.Str(a, true, srcReg,
				aarch64.MemImm(aarch64.SP, outStkOff + k * 8))
		} else {
			aarch64.Ldr(a, true, aarch64.X16,
				aarch64.MemImm(aarch64.SP, srcStkOff))
			aarch64.Str(a, true, aarch64.X16,
				aarch64.MemImm(aarch64.SP, outStkOff + k * 8))
		}
	}
}
