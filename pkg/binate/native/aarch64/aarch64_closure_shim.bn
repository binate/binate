package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Native aarch64 emission for the per-(literal, capture-shape) shim
// that backs a capturing function literal (B.2 of plan-function-
// values-phase-2.md).  Split from aarch64.bn to keep that file under
// the hygiene soft length cap.
//
// Two paths, mirroring pkg/binate/native/x64/x64_closure_shim.bn:
//
//   * Fast path — every outgoing arg lands in a GP arg register:
//       shim:
//         <shift user args X1..XM up to X(W+1)..X(W+M)>
//         <load capture words X(W-1)..X1 from [X0, #off_*]>
//         <load X0 from [X0, #off_0]>   // base clobbered last
//         B underlying_fn
//     W is the TOTAL capture-word count.
//
//   * Stack-spill path — any outgoing arg classifies as MEMORY or
//     gets pushed to the stack by AAPCS64's classifier (no
//     remaining GP-reg budget):
//       shim:
//         STP fp,lr,[sp,#-16]!          ; LR survives the BL on the stack
//         MOV fp,sp
//         SUB sp, sp, #stkBytes         ; stkBytes already 16-aligned
//                                       ; by CallStackBytes
//         <spill stack-bound args: [X0+ofs] → X16 → [SP+sof]>
//         <move user-args incoming → outgoing positions>
//         <load reg-bound captures: [X0+ofs] → argReg(rs)>
//         BL underlying_fn
//         ADD sp, sp, #stkBytes
//         LDP fp,lr,[sp],#16
//         RET
//     X16 is the AAPCS64 intra-call scratch (IP0) used only as the
//     intra-shim spill shuttle (consumed before the BL); the framed
//     prologue keeps LR off X16, since the callee may clobber IP0.

// lookupClosureFuncAA64 returns the Func with the given name iff
// it is a capturing-literal closure (IsClosure=true).  Returns nil
// for non-closure refs and for cross-module references.
func lookupClosureFuncAA64(mod @ir.Module, name @[]char) @ir.Func {
	for i := 0; i < len(mod.Funcs); i++ {
		if !charEqAA64(mod.Funcs[i].Name, name) { continue }
		if !mod.Funcs[i].IsClosure { return nil }
		return mod.Funcs[i]
	}
	return nil
}

// emitClosureShim emits the per-(literal, capture-shape) shim for a
// capturing closure.  Caller has already emitted the label and
// SetWeak; this writes the shim body.  Picks fast-path or stack-
// spill based on the AAPCS64 classifier's output for the outgoing
// arg list.
//
// Constraints (apply to both paths):
//   - scalar / void return only (return size ≤ 8 bytes)
//   - incoming user-args may exceed X1..X7 — overflow words on the
//     caller's stack are read from [SP + stkBytes + offset] in the
//     stack-spill path (since the only way nUserWords > 7 is reachable
//     is when shimNeedsStackSpill is also true, which it is once
//     captures + 7-reg-user-args > 8 reg words).
//
// Outside these constraints the shim falls back to plain `B` to
// the underlying — wrong behavior but the assembler doesn't blow
// up.
func emitClosureShim(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type, f @ir.Func) {
	// A SINGLE aggregate return (struct/array) rides the retbuf-in-X0
	// caller convention, which the scalar paths below don't implement;
	// route it to the aggregate shim emitter.
	if shimReturnIsAggregate(fvTyp) {
		if closureHasFloatParts(fvTyp, f) {
			// Float captures/params combined with the retbuf/sret aggregate-
			// return convention — the float-aware aggregate shim (single
			// aggregate: multiRetTuple nil).
			emitClosureShimFloatAggregateAA64(a, fnLabel, fvTyp, f, shimReturnSize(fvTyp), nil)
			return
		}
		emitClosureShimAggregateAA64(a, fnLabel, fvTyp, f, shimReturnSize(fvTyp), nil)
		return
	}
	// Multi-return closure.  Under retbuf-for-any-multi-return the caller passes
	// a retbuf for EVERY multi-return (the scalar tail-branch no longer carries
	// it), so this rides the aggregate shim's retbuf-in-X0 convention: a BIG
	// tuple takes the sret shape (retbuf X0 → X8), a SMALL tuple takes the pack
	// shape but stores the callee's field-per-register return THROUGH retbuf via
	// the field-per-class helper (multiRetTuple selects that store).
	if len(fvTyp.Results) > 1 {
		if closureHasFloatParts(fvTyp, f) {
			// Float captures/params/result: a BIG float multi-return via sret is
			// not handled (fail-loud); a SMALL one rides the float aggregate shim's
			// pack path with the field-per-class store (float fields in D0..).
			if isBigMultiReturnAA64(fvTyp) {
				a.SetError(
						"native aarch64: float-containing closure with a big "
								"multi-return result is not yet handled")
				return
			}
			var t @types.Type = funcValMultiReturnTupleAA64(fvTyp)
			emitClosureShimFloatAggregateAA64(a, fnLabel, fvTyp, f, t.SizeOf(), t)
			return
		}
		emitClosureShimMultiRetAA64(a, fnLabel, fvTyp, f)
		return
	}
	// A float-scalar capture / param / return needs FP-register marshalling;
	// the GP-only fast / stack-spill paths below would mis-place it.  See
	// aarch64_closure_shim_float.bn.
	if closureHasFloatParts(fvTyp, f) {
		emitClosureShimFloatAA64(a, fnLabel, fvTyp, f)
		return
	}
	var cc common.CallConv = aarch64CC()
	var argTypes @[]@types.Type = buildShimArgTypesAA64(fvTyp, f)
	var nUserWords int = userWordsAA64(cc, fvTyp)
	if !shimNeedsStackSpillAA64(cc, argTypes) {
		emitClosureShimFastAA64(a, fnLabel, fvTyp, f, nUserWords)
		return
	}
	emitClosureShimStackSpillAA64(a, fnLabel, fvTyp, f, cc, argTypes, nUserWords)
}

// buildShimArgTypesAA64 returns the type list for the OUTGOING call
// the shim performs: captures first (in ClosureStruct field order),
// then user-args.  Same shape the CallConv classifier expects for a
// normal direct call.
func buildShimArgTypesAA64(fvTyp @types.Type, f @ir.Func) @[]@types.Type {
	var argTypes @[]@types.Type
	for i := 0; i < f.NumCaptureParams; i++ {
		argTypes = slices.Append[@types.Type](argTypes, f.ClosureStruct.Fields[i].Type)
	}
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		argTypes = slices.Append[@types.Type](argTypes, fvTyp.Params[pi].Type)
	}
	return argTypes
}

// shimNeedsStackSpillAA64 reports whether any arg in the outgoing
// call ends up partially or wholly on the stack
// (CallArgStackOff >= 0).  If none do, the simpler fast path (B,
// no SP adjustment) suffices.  Under AAPCS64 (SplitAggregates =
// true) an aggregate might have BOTH a regStart and a stackOff —
// the SPLIT case — which still requires the stack-spill path.
func shimNeedsStackSpillAA64(cc common.CallConv, argTypes @[]@types.Type) bool {
	for i := 0; i < len(argTypes); i++ {
		if cc.CallArgStackOff(argTypes, i) >= 0 { return true }
	}
	return false
}

// isIndirectLargeCapAA64 reports whether a capture-type is passed
// via the IndirectLargeAggregates convention (a single pointer in
// 1 reg / 1 stack word) at the underlying body's call boundary.
// Mirrors the classifier path in
// pkg/binate/native/common/common_callconv.bn's
// argRegWordsStackWords for the indirect-large branch.
func isIndirectLargeCapAA64(cc common.CallConv, t @types.Type) bool {
	return cc.IndirectLargeAggregates && common.IsAggregateTyp(t) && t.SizeOf() > cc.AggregateInRegMax
}

// effectiveCapWordsAA64 returns the number of GP arg-reg slots a
// capture consumes at the underlying body's call boundary — 1 for
// indirect-large aggregates (pointer-pass), ArgWords for the rest.
func effectiveCapWordsAA64(cc common.CallConv, t @types.Type) int {
	if isIndirectLargeCapAA64(cc, t) { return 1 }
	return common.ArgWords(t)
}

// userWordsAA64 sums the INCOMING GP dispatch-word footprint of a closure's user
// params — the count the shims use for incoming-arg positions.
// shimInWordsForTypeAA64 (not ArgWords): an indirect-large aggregate OR a
// by-address <=16B aggregate (coerced / slice / iface — option B) travels as a
// single pointer word incoming.
func userWordsAA64(cc common.CallConv, fvTyp @types.Type) int {
	var n int = 0
	for pi := 0; pi < len(fvTyp.Params); pi = pi + 1 {
		n = n + shimInWordsForTypeAA64(cc, fvTyp.Params[pi].Type)
	}
	return n
}

// emitClosureShimFastAA64 is the register-only path: every outgoing
// arg lands wholly in a GP arg register.  Indirect-large captures
// contribute 1 reg slot (a pointer to the closure-struct field);
// scalar / small-aggregate captures contribute their ArgWords reg
// slots (per-word loads from the closure struct).
//
// nUserWords is the INCOMING dispatch-word footprint (EffectiveArgWords
// per user param — 1 for a by-address aggregate).  The OUTGOING register
// footprint diverges for a coerced in-register struct/array: it arrives
// as ONE by-address pointer word but the underlying's coerced ABI reads
// its ArgWords value-words, so the shift below loads those words from the
// pointer into consecutive outgoing regs and the budget counts ArgWords.
func emitClosureShimFastAA64(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type, f @ir.Func,
		nUserWords int) {
	var cc common.CallConv = aarch64CC()
	var captureWords int = 0
	for i := 0; i < f.NumCaptureParams; i++ {
		captureWords = captureWords + effectiveCapWordsAA64(cc, f.ClosureStruct.Fields[i].Type)
	}
	// Budget the register-only routing on the OUTGOING (real ABI) GP word
	// count: a coerced in-register struct/array expands from its single
	// by-address dispatch word into ArgWords coerced regs, so counting it
	// via EffectiveArgWords (== 1) would undercount the outgoing register
	// pressure and wrongly keep a wide call on the tail-branch path.
	var outUserWords int = 0
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		if isByAddressAggAA64(cc, pt) {
			outUserWords = outUserWords + common.ArgWords(pt)
		} else {
			outUserWords = outUserWords + cc.EffectiveArgWords(pt)
		}
	}
	if captureWords + outUserWords > 8 {
		a.SetGlobal(fnLabel)
		aarch64.B(a, fnLabel)
		return
	}
	// Shift user args from their incoming dispatch slots (X1.., prefix 1
	// for the dropped data word) to their outgoing slots (X(captureWords)..).
	// Right-to-left over params — and high-word-first within a multi-word
	// arg — so each source register is read before its slot becomes a
	// destination (captures prepend an upward shift; the coerced expansion
	// only widens the outgoing side, keeping outgoing >= incoming).
	var inCursor int = nUserWords
	var outCursor int = outUserWords
	for pi := len(fvTyp.Params) - 1; pi >= 0; pi = pi - 1 {
		var pt @types.Type = fvTyp.Params[pi].Type
		var ew int = shimInWordsForTypeAA64(cc, pt)
		inCursor = inCursor - ew
		if isByAddressAggAA64(cc, pt) {
			// By-address aggregate (coerced struct/array OR a non-coerced <=16B
			// slice / iface-value): ONE incoming pointer word expands to ArgWords
			// outgoing value-words.  Copy the pointer to X16 (a scratch, not an arg
			// reg) first so the loads can't clobber it, then load each value-word
			// into its outgoing reg.  (Register-only path: the whole aggregate fits
			// in regs — no straddle to split here.)
			var n int = common.ArgWords(pt)
			outCursor = outCursor - n
			aarch64.Mov(a, true, aarch64.X16, aarch64.Reg(argReg(1 + inCursor)))
			for k := 0; k < n; k = k + 1 {
				aarch64.Ldr(a, true, argReg(captureWords + outCursor + k), aarch64.MemImm(aarch64.X16, 8 * k))
			}
			continue
		}
		outCursor = outCursor - ew
		for k := ew - 1; k >= 0; k = k - 1 {
			var srcReg int = argReg(1 + inCursor + k)
			var dstReg int = argReg(captureWords + outCursor + k)
			if srcReg != dstReg {
				aarch64.Mov(a, true, dstReg, aarch64.Reg(srcReg))
			}
		}
	}
	// Captures right-to-left so X0 (the closure-struct base) stays
	// valid until the final emit.  The i=0 case may clobber X0
	// (regStart 0 → ADD X0, X0, #ofs0 for indirect-large, or Ldr
	// X0, [X0, #ofs0] for scalar at offset 0); placing it last
	// keeps the base alive for earlier captures.
	var w int = captureWords
	for i := f.NumCaptureParams - 1; i >= 0; i = i - 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var baseOfs int = f.ClosureStruct.FieldOffset(i)
		if isIndirectLargeCapAA64(cc, ft) {
			w = w - 1
			// ADD argReg(w), X0, #baseOfs — pointer-pass.
			aarch64.Add(a, true, argReg(w), aarch64.X0, aarch64.Imm(baseOfs))
			continue
		}
		var wordCount int = common.ArgWords(ft)
		for k := wordCount - 1; k >= 0; k = k - 1 {
			w = w - 1
			aarch64.Ldr(a, true, argReg(w), aarch64.MemImm(aarch64.X0, baseOfs + k * 8))
		}
	}
	a.SetGlobal(fnLabel)
	aarch64.B(a, fnLabel)
}

// emitUserArgWordMoveAA64 emits the single-word transfer for a
// user-arg word at slot k of the current user-arg, given the user-
// arg's incoming register base (inRegBase, accumulated by step 2's
// loop) and the outgoing classifier slot (outRegStart / outStkOff).
//
// The outgoing slot has three shapes: reg-only (outStkOff < 0),
// stack-only (outRegStart < 0), or SPLIT (BOTH >= 0 — a small aggregate
// straddling the GP arg regs and the stack: its first (8 - outRegStart)
// words ride regs, the rest spill).  Word k lands in a reg when
// outRegStart >= 0 and k is within the reg portion, else on the stack.
//
// prefixRegs is how many GP regs precede the incoming user args (1 for
// the scalar/void shim where data rides X0, so args start at X1; 2 for
// the aggregate shim where retbuf+data ride X0/X1 and args start at X2).
// frameDelta is the byte distance from the current SP to the caller's
// incoming stack-arg base — STP(16) for the frame record + the inner
// outgoing-args area, the framed-prologue form both the scalar and
// aggregate stack-spill shims use.
//
// The incoming source is the global word index `inIdx = inRegBase + k - 1`
// (0-based across all user-arg words): reg X(prefixRegs + inIdx) when it
// fits the (8 - prefixRegs) incoming arg regs, else the caller stack at
// [SP + frameDelta + (inIdx - (8 - prefixRegs)) * 8].
//
// storeSize is the natural width of a stack-DEST store: a narrow
// int8/int16/int32/float32 stack arg (always 1 word) packs at its
// natural size + alignment on aarch64CC and the lifted body reads
// it there — an 8-byte store would spill into the next slot.  Full-word
// args / aggregate words use storeSize 8.
func emitUserArgWordMoveAA64(a @asm.Assembler, inRegBase int, k int, prefixRegs int, frameDelta int,
		outRegStart int, outStkOff int, storeSize int) {
	var inIdx int = inRegBase + k - 1
	var nArgRegs int = 8 - prefixRegs
	var srcIsReg bool = inIdx < nArgRegs
	var srcReg int
	var srcStkOff int = 0
	if srcIsReg {
		srcReg = argReg(prefixRegs + inIdx)
	} else {
		srcStkOff = frameDelta + (inIdx - nArgRegs) * 8
	}
	// Resolve word k's outgoing slot, honoring the SPLIT case.
	var dstIsReg bool = false
	var dstReg int = 0
	var dstStkOff int = 0
	if outRegStart >= 0 && (outStkOff < 0 || k < 8 - outRegStart) {
		dstIsReg = true
		dstReg = argReg(outRegStart + k)
	} else {
		var stkWord int = k
		if outRegStart >= 0 {
			stkWord = k - (8 - outRegStart)
		}
		dstStkOff = outStkOff + stkWord * 8
	}
	if dstIsReg {
		if srcIsReg {
			if srcReg != dstReg {
				aarch64.Mov(a, true, dstReg, aarch64.Reg(srcReg))
			}
		} else {
			aarch64.Ldr(a, true, dstReg, aarch64.MemImm(aarch64.SP, srcStkOff))
		}
		return
	}
	if srcIsReg {
		aarch64.StrSized(a, storeSize, srcReg, aarch64.MemImm(aarch64.SP, dstStkOff))
	} else {
		aarch64.Ldr(a, true, aarch64.X16, aarch64.MemImm(aarch64.SP, srcStkOff))
		aarch64.StrSized(a, storeSize, aarch64.X16, aarch64.MemImm(aarch64.SP, dstStkOff))
	}
}

// emitClosureCaptureSpillAA64 spills every stack-bound capture portion to the
// outgoing-args area [SP + stkOff], reading capture fields from [baseReg +
// fieldOfs] and shuttling through X16.  Two cases: an indirect-large capture
// that overflowed (pointer-pass: ADD X16, baseReg, #ofs; Str) and a per-word /
// SPLIT capture (the words past the last GP arg reg spill).  A narrow scalar
// capture is stored at its natural width (StackArgStoreSize) so it does not
// overrun its neighbor's natural-sized slot.  Shared by the scalar and
// aggregate closure stack-spill shims; baseReg is the closure-struct pointer
// (X0 for the scalar shim, where it is still live, or X9 for the aggregate
// shim, which parks it in a non-arg scratch).
func emitClosureCaptureSpillAA64(a @asm.Assembler, cc common.CallConv, f @ir.Func,
		argTypes @[]@types.Type, baseReg int) {
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var regStart int = cc.CallArgRegStart(argTypes, i)
		var stkOff int = cc.CallArgStackOff(argTypes, i)
		var fieldOfs int = f.ClosureStruct.FieldOffset(i)
		if stkOff < 0 { continue }
		if isIndirectLargeCapAA64(cc, ft) {
			aarch64.Add(a, true, aarch64.X16, baseReg, aarch64.Imm(fieldOfs))
			aarch64.Str(a, true, aarch64.X16, aarch64.MemImm(aarch64.SP, stkOff))
			continue
		}
		var nWords int = common.ArgWords(ft)
		var firstStackWord int = 0
		if regStart >= 0 {
			firstStackWord = cc.NumGpArgRegs - regStart
		}
		var capStoreSize int = cc.StackArgStoreSize(ft, false)
		for k := firstStackWord; k < nWords; k = k + 1 {
			aarch64.Ldr(a, true, aarch64.X16, aarch64.MemImm(baseReg, fieldOfs + k * 8))
			aarch64.StrSized(a, capStoreSize, aarch64.X16,
					aarch64.MemImm(aarch64.SP, stkOff + (k - firstStackWord) * 8))
		}
	}
}

// emitClosureCaptureRegLoadAA64 loads every register-bound capture portion into
// its outgoing arg register from [baseReg + fieldOfs].  Indirect-large captures
// pass a pointer (ADD); per-word captures Ldr each reg word; a SPLIT capture
// loads only its reg portion (the stack portion was spilled).  Iterates
// captures right-to-left so the i==0 case (which may target X0 when
// regStart==0) runs last — required when baseReg IS X0 (the scalar shim keeps
// the base live until the final load), harmless when baseReg is a separate
// scratch (the aggregate shim's X9).  Shared by both stack-spill shims.
func emitClosureCaptureRegLoadAA64(a @asm.Assembler, cc common.CallConv, f @ir.Func,
		argTypes @[]@types.Type, baseReg int) {
	for i := f.NumCaptureParams - 1; i >= 0; i = i - 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var regStart int = cc.CallArgRegStart(argTypes, i)
		var fieldOfs int = f.ClosureStruct.FieldOffset(i)
		if regStart < 0 { continue }
		if isIndirectLargeCapAA64(cc, ft) {
			aarch64.Add(a, true, argReg(regStart), baseReg, aarch64.Imm(fieldOfs))
			continue
		}
		var nWords int = common.ArgWords(ft)
		var regWords int = nWords
		if cc.CallArgStackOff(argTypes, i) >= 0 {
			regWords = cc.NumGpArgRegs - regStart
		}
		for k := regWords - 1; k >= 0; k = k - 1 {
			aarch64.Ldr(a, true, argReg(regStart + k), aarch64.MemImm(baseReg, fieldOfs + k * 8))
		}
	}
}
