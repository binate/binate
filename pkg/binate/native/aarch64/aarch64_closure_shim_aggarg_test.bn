package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A closure or function-value shim loads a by-value aggregate user argument -- passed
// to it by address, the caller's value, which may be read in place from its source --
// no further than its end: the second word of a 12-byte {int32 x3} is `LDR Wt, [ptr,
// #8]` (bytes 8..11), never `LDR Xt, [ptr, #8]` (bytes 8..15), in the closures'
// register-only, aggregate-return, stack-spill and float shims and the function values'
// marshal and spill shims.

// s12TypeAA64 returns a named 12-byte struct of three int32.
func s12TypeAA64() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		var name @[]char = make_slice(char, 1)
		name[0] = cast(char, cast(int, 'a') + i)
		fields[i].Name = name
		fields[i].Type = types.TypInt32()
	}
	return types.MakeStructType("S12", fields)
}

// closureForAA64 returns a closure with one int capture taking fv's user params and
// lifted to return fv's results.
func closureForAA64(fv @types.Type) @ir.Func {
	var f @ir.Func = closureFuncSingleIntCapture()
	var params @[]@ir.Param = make_slice(@ir.Param, 1 + len(fv.Params))
	params[0] = f.Params[0]
	for i := 0; i < len(fv.Params); i++ {
		params[1 + i] = irbuild.NewParam(f, "u", fv.Params[i].Type)
	}
	f.Params = params
	return liftedReturning(f, fv)
}

// fvTakingAA64 builds @func(lead..., S12) returning ret: nInts ints, then a float64
// when withFloat, then the S12.
func fvTakingAA64(nInts int, withFloat bool, ret @types.Type) @types.Type {
	var n int = nInts + 1
	if withFloat { n = n + 1 }
	var params @[]@types.Param = make_slice(@types.Param, n)
	for i := 0; i < n; i++ {
		params[i] = make(types.Param)
		params[i].Name = "p"
		params[i].Type = types.TypInt()
	}
	if withFloat { params[nInts].Type = types.TypFloat64() }
	params[n - 1].Type = s12TypeAA64()
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = ret
	return types.MakeFuncValueType(params, results)
}

// hasLdrAt8AA64 reports whether a holds an `LDR {X,W}t, [Xn, #8]` (64-bit when sf)
// whose base is one of the shims' pointer scratches X9..X16.
func hasLdrAt8AA64(a @asm.Assembler, sf bool) bool {
	var want uint32 = 0xB9400800
	if sf { want = 0xF9400400 }
	for off := 0; off + 4 <= bytesWritten(a); off = off + 4 {
		var w uint32 = word32AA64(a, off)
		var rn uint32 = (w >> 5) & 0x1F
		if (w & 0xFFFFFC00) == want && rn >= 9 && rn <= 16 { return true }
	}
	return false
}

// checkShimAA64 reports a's error, or whether it loads the 12-byte argument's second
// word past its end, or not at all.
func checkShimAA64(a @asm.Assembler, what *[]readonly char) testing.TestResult {
	if a.HasError { return fail(a.ErrorMsg) }
	if hasLdrAt8AA64(a, true) {
		return fail(buf.Concat(what, ": loads bytes 8..15 of a 12-byte argument"))
	}
	if !hasLdrAt8AA64(a, false) {
		return fail(buf.Concat(what, ": loads bytes 8..11 of a 12-byte argument"))
	}
	return ""
}

func TestClosureShimLoadsAggregateArgNoPastEndAA64() testing.TestResult {
	var shapes @[]@types.Type = make_slice(@types.Type, 6)
	shapes[0] = fvTakingAA64(0, false, types.TypInt())
	shapes[1] = fvTakingAA64(0, false, structTypeNInt64(3))
	shapes[2] = fvTakingAA64(7, false, types.TypInt())
	shapes[3] = fvTakingAA64(7, false, structTypeNInt64(3))
	shapes[4] = fvTakingAA64(0, true, types.TypInt())
	shapes[5] = fvTakingAA64(6, true, types.TypInt())
	for i := 0; i < len(shapes); i++ {
		var a @asm.Assembler = mkAsm()
		emitClosureShim(a, "underlying", shapes[i], closureForAA64(shapes[i]))
		var r testing.TestResult = checkShimAA64(a, "a closure shim")
		if len(r) > 0 { return r }
		if i == 1 || i == 3 { continue }
		a = mkAsm()
		emitFuncValueShims(a, "host", makeFuncValueRefModule(shapes[i]))
		r = checkShimAA64(a, "a function-value shim")
		if len(r) > 0 { return r }
	}
	return ""
}
