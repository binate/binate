package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Native aarch64 emission for the aggregate-return path of a capturing
// closure shim.  Split from aarch64_closure_shim.bn (which keeps the
// scalar / void path) to stay under the hygiene file-length cap.
//
// A capturing closure whose function-value type returns a SINGLE
// aggregate result rides the same retbuf-in-X0 caller convention the
// non-capturing shim (emitFuncValueShims) and emitCallFuncValue use:
//
//     X0 = retbuf   (address of the caller's result buffer)
//     X1 = data     (the closure-struct pointer)
//     X2.. = user args
//
// The scalar closure shim cannot serve this: it expects data in X0 and
// user args in X1.., and never threads retbuf into the lifted body's
// result location — so a capturing closure returning a struct read the
// retbuf as its data pointer and (for the sret shape) left X8 null, which
// the lifted body dereferenced → SIGSEGV.  This file adds the two
// aggregate shapes, mirroring emitFuncValueShims:
//
//   * Pack-return (retSz 1..16): the lifted body returns the aggregate
//     packed in X0..X(retWords-1).  Frame up, stash retbuf, set up the
//     underlying args, BL, then copy the packed result back through the
//     stashed retbuf.
//   * Sret-return (retSz > 16): the lifted body writes the aggregate
//     through X8 (AAPCS64 indirect result).  Move retbuf X0 → X8, set up
//     the underlying args, tail-branch (B preserves X8).
//
// Multi-return tuples stay on the scalar path (shimReturnIsAggregate is
// false for them): the call site keeps data in X0 and sets X8 itself for
// a >16-byte tuple, so the scalar shim's tail-branch already carries the
// result correctly.

// emitClosureShimAggregateAA64 emits the aggregate-return closure shim.
// retSz is the single result's SizeOf (> 0; shimReturnIsAggregate already
// gated this path).  Register-only: the underlying call's args (captures
// + user words) must fit X0..X7 and the incoming user args (X2..X7) must
// too — beyond that the shim records a compile error (a.SetError) rather
// than silently emitting wrong code, since the stack-spill aggregate path
// isn't implemented yet.
func emitClosureShimAggregateAA64(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type, f @ir.Func,
		retSz int, multiRetTuple @types.Type) {
	var cc common.CallConv = common.AAPCS64_Darwin()
	var captureWords int = 0
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		captureWords = captureWords + effectiveCapWordsAA64(cc, f.ClosureStruct.Fields[i].Type)
	}
	var nUserWords int = userWordsAA64(cc, fvTyp)
	// Register-fit budget counts the OUTGOING (real-ABI) GP words: a coerced
	// in-register struct/array arrives as ONE by-address pointer word
	// (EffectiveArgWords == 1, counted by nUserWords) but the shim expands it
	// into ArgWords coerced regs, so the register-fit test must use the
	// outgoing count or it would undercount and wrongly keep a wide call on the
	// register-only path.  The incoming-fit test (X2..X7) stays on nUserWords —
	// the dispatch caller really does place the by-address arg as one word.
	var nUserOutWords int = userOutWordsAggAA64(cc, fvTyp)
	if captureWords + nUserOutWords > 8 || nUserWords > 6 {
		// The underlying call's args don't all fit registers (captures +
		// outgoing user words exceed X0..X7, or the incoming user words exceed
		// X2..X7), so it needs a stack-spill prologue.
		var argTypes @[]@types.Type = buildShimArgTypesAA64(fvTyp, f)
		emitClosureShimAggregateStackSpillAA64(a, fnLabel, fvTyp, f, retSz, cc, argTypes, nUserWords,
				multiRetTuple)
		return
	}
	// A single aggregate srets by SIZE (> 16 B).  A SMALL multi-return
	// (multiRetTuple != nil) always packs regardless of size — e.g.
	// (i64 x5) is 40 B but 5 GP words (≤ 8), so the callee returns it field-per-
	// register (NOT via X8 sret); the SIZE rule would wrongly route it to sret.
	if retSz > 16 && multiRetTuple == nil {
		// Sret-return: retbuf X0 → X8 (set BEFORE the capture loads
		// clobber X0), data X1 → X9 scratch, set up the underlying
		// args, tail-branch.  B preserves X8, so the lifted body writes
		// the result straight through the caller's retbuf.
		aarch64.Mov(a, true, aarch64.X8, aarch64.Reg(aarch64.X0))
		aarch64.Mov(a, true, aarch64.X9, aarch64.Reg(aarch64.X1))
		loadClosureAggCallArgsAA64(a, cc, fvTyp, f, captureWords, nUserWords)
		a.SetGlobal(fnLabel)
		aarch64.B(a, fnLabel)
		return
	}
	// Pack-return (single aggregate retSz 1..16, OR any small multi-return):
	// frame of 32 bytes (FP/LR + a retbuf save slot at [SP+16] + alignment pad),
	// mirroring the non-capturing pack shim.  Stash retbuf, set up the underlying
	// args (data in X9), BL, reload retbuf into X9, copy the return through it,
	// unwind.  A single aggregate copies the packed X0..X(retWords-1); a small
	// multi-return stores the callee's field-per-register result via the field-
	// per-class helper (a whole-word dump would read GP regs the callee never
	// wrote for a float field and ignore sub-word field sizing).
	aarch64.Stp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPre(aarch64.SP, -32))
	aarch64.Mov(a, true, aarch64.FP, aarch64.Reg(aarch64.SP))
	aarch64.Str(a, true, aarch64.X0, aarch64.MemImm(aarch64.SP, 16))
	aarch64.Mov(a, true, aarch64.X9, aarch64.Reg(aarch64.X1))
	loadClosureAggCallArgsAA64(a, cc, fvTyp, f, captureWords, nUserWords)
	a.SetGlobal(fnLabel)
	aarch64.Bl(a, fnLabel)
	aarch64.Ldr(a, true, aarch64.X9, aarch64.MemImm(aarch64.SP, 16))
	if multiRetTuple != nil {
		// X10 is the field float→GP scratch (outside the return regs and X9 base).
		storeMultiReturnTupleFieldsAA64(a, multiRetTuple, aarch64.X9, 0, aarch64.X10)
	} else {
		var retWords int = retSz / 8
		if retSz % 8 != 0 { retWords = retWords + 1 }
		for ri := 0; ri < retWords; ri = ri + 1 {
			aarch64.Str(a, true, argReg(ri), aarch64.MemImm(aarch64.X9, 8 * ri))
		}
	}
	aarch64.Ldp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPost(aarch64.SP, 32))
	aarch64.Ret(a)
}

// emitClosureShimMultiRetAA64 emits the multi-return closure shim (retbuf-for-
// any-multi-return).  A BIG tuple (isBigMultiReturnAA64) rides the sret shape —
// retbuf X0 → X8, the callee writes through it (multiRetTuple nil).  A SMALL tuple
// rides the pack shape — the callee returns it field-per-register, which the shim
// stores THROUGH retbuf via the field-per-class helper (multiRetTuple selects
// that store).  Reuses emitClosureShimAggregateAA64's frame + marshalling; float-
// containing multi-return closures are fail-loud upstream (emitClosureShim).
func emitClosureShimMultiRetAA64(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type, f @ir.Func) {
	var t @types.Type = funcValMultiReturnTupleAA64(fvTyp)
	if isBigMultiReturnAA64(fvTyp) {
		emitClosureShimAggregateAA64(a, fnLabel, fvTyp, f, t.SizeOf(), nil)
		return
	}
	emitClosureShimAggregateAA64(a, fnLabel, fvTyp, f, t.SizeOf(), t)
}

// loadClosureAggCallArgsAA64 sets up the underlying lifted-body call's
// register args for an aggregate-returning closure shim.  The closure-
// struct pointer is in X9 (a non-arg caller-saved scratch the caller
// already moved data into).  Two steps, in this order:
//
//   1. Move the user args from their incoming slots X(2 + inWord) (the funcval
//      aggregate convention places user args after the retbuf+data prefix) to
//      their outgoing slots X(captureWords + outWord), per param.  The incoming
//      and outgoing word cursors usually advance together, but DIVERGE for a
//      coerced in-register struct/array, which arrives as ONE by-address
//      pointer word (incoming) yet must be expanded into its ArgWords value-
//      words across the outgoing coerced regs the underlying reads.  Direction
//      depends on captureWords vs the incoming base 2: a shift toward higher
//      registers (captureWords >= 2) goes right-to-left so each source is read
//      before its slot is overwritten; a shift toward lower registers goes
//      left-to-right.
//   2. Load the captures from [X9] into X0..X(captureWords-1) — done
//      AFTER the user-arg moves so a capture write can't clobber an
//      unread user-arg source.  X9 stays live across every load, so the
//      base never needs the scalar shim's keep-X0-alive ordering.
//      Indirect-large captures pass a pointer (ADD), per-word captures
//      load each word.
func loadClosureAggCallArgsAA64(a @asm.Assembler, cc common.CallConv, fvTyp @types.Type, f @ir.Func,
		captureWords int, nUserWords int) {
	if captureWords >= 2 {
		// Shift toward higher regs: process params high-to-low (and words
		// within a param high-to-low) so each source is read before its slot
		// is overwritten.  Walk both cursors forward to find each param's
		// bases, then emit in reverse.
		var inWord int = nUserWords
		var outWord int = userOutWordsAggAA64(cc, fvTyp)
		for pi := len(fvTyp.Params) - 1; pi >= 0; pi = pi - 1 {
			var pt @types.Type = fvTyp.Params[pi].Type
			inWord = inWord - cc.EffectiveArgWords(pt)
			outWord = outWord - userOutWordsOneAA64(cc, pt)
			moveAggUserArgAA64(a, cc, pt, inWord, outWord, captureWords, false)
		}
	} else {
		// Shift toward lower regs: process params low-to-high, words low-first.
		var inWord int = 0
		var outWord int = 0
		for pi := 0; pi < len(fvTyp.Params); pi = pi + 1 {
			var pt @types.Type = fvTyp.Params[pi].Type
			moveAggUserArgAA64(a, cc, pt, inWord, outWord, captureWords, true)
			inWord = inWord + cc.EffectiveArgWords(pt)
			outWord = outWord + userOutWordsOneAA64(cc, pt)
		}
	}
	var wi int = 0
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var baseOfs int = f.ClosureStruct.FieldOffset(i)
		if isIndirectLargeCapAA64(cc, ft) {
			aarch64.Add(a, true, argReg(wi), aarch64.X9, aarch64.Imm(baseOfs))
			wi = wi + 1
			continue
		}
		var nWords int = common.ArgWords(ft)
		for k := 0; k < nWords; k = k + 1 {
			aarch64.Ldr(a, true, argReg(wi), aarch64.MemImm(aarch64.X9, baseOfs + k * 8))
			wi = wi + 1
		}
	}
}

// userOutWordsOneAA64 is the OUTGOING (real-ABI) GP-reg-word count for a single
// user param — ArgWords for a coerced in-register struct/array (expanded from
// its single by-address dispatch word), EffectiveArgWords otherwise.  The
// per-arg counterpart of userOutWordsAggAA64's sum.
func userOutWordsOneAA64(cc common.CallConv, pt @types.Type) int {
	if common.AggCoercedInReg(pt) { return common.ArgWords(pt) }
	return cc.EffectiveArgWords(pt)
}

// moveAggUserArgAA64 moves one user param from its incoming slots
// X(2 + inWord).. to its outgoing slots X(captureWords + outWord)..  A coerced
// in-register struct/array arrives as ONE by-address pointer word: copy that
// pointer to X16 (a scratch, not an arg reg, so the loads can't clobber it),
// then load its ArgWords value-words into the consecutive outgoing regs the
// underlying's coerced ABI reads.  Every other param keeps its
// incoming-word-count == outgoing-word-count and is moved word-by-word.
// lowFirst selects the within-arg word order for the plain case: a downward
// shift (captureWords < 2) moves words low-first so word k's outgoing slot —
// which can coincide with word (k-1)'s incoming — is written only after that
// source is read; an upward shift moves high-first.
func moveAggUserArgAA64(a @asm.Assembler, cc common.CallConv, pt @types.Type, inWord int,
		outWord int, captureWords int, lowFirst bool) {
	if common.AggCoercedInReg(pt) {
		var n int = common.ArgWords(pt)
		var ptrReg int = argReg(2 + inWord)
		aarch64.Mov(a, true, aarch64.X16, aarch64.Reg(ptrReg))
		for k := 0; k < n; k = k + 1 {
			aarch64.Ldr(a, true, argReg(captureWords + outWord + k), aarch64.MemImm(aarch64.X16, 8 * k))
		}
		return
	}
	var w int = cc.EffectiveArgWords(pt)
	if lowFirst {
		for k := 0; k < w; k = k + 1 {
			moveAggUserWordAA64(a, inWord + k, outWord + k, captureWords)
		}
		return
	}
	for k := w - 1; k >= 0; k = k - 1 {
		moveAggUserWordAA64(a, inWord + k, outWord + k, captureWords)
	}
}

// moveAggUserWordAA64 moves one plain user-arg word from its incoming register
// X(2 + inWord) to its outgoing register X(captureWords + outWord), skipping the
// move when source and destination coincide.
func moveAggUserWordAA64(a @asm.Assembler, inWord int, outWord int, captureWords int) {
	var srcReg int = argReg(2 + inWord)
	var dstReg int = argReg(captureWords + outWord)
	if srcReg != dstReg {
		aarch64.Mov(a, true, dstReg, aarch64.Reg(srcReg))
	}
}

// emitClosureShimAggregateStackSpillAA64 emits the stack-spill path for an
// aggregate-return capturing closure: the underlying call's captures + user
// args do not all fit the GP arg registers, or the incoming user words exceed
// X2..X7.  It frames a proper prologue (FP/LR + an outgoing-args area for the
// stack-bound captures/args, plus a retbuf save slot for the pack shape),
// marshals captures and user args into their AAPCS64_Darwin slots (an overflow
// arg at its natural size/width), BLs the lifted body, routes the aggregate
// result through the retbuf (sret: written via X8; pack: the packed X0.. copied
// back), and unwinds.
//
// Incoming: X0 = retbuf, X1 = data (closure-struct ptr), X2.. = user args (then
// the caller stack).  retbuf -> X8 (sret) or a save slot (pack) and data -> X9
// are stashed BEFORE the marshal overwrites X0/X1; X9 (a non-arg scratch) stays
// the capture base across the marshal.  Both shapes BL, not tail-branch: the SUB
// must be undone before RET, and pack must copy the result back.
func emitClosureShimAggregateStackSpillAA64(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type,
		f @ir.Func, retSz int, cc common.CallConv, argTypes @[]@types.Type, nUserWords int,
		multiRetTuple @types.Type) {
	// A small multi-return (multiRetTuple != nil) always packs (field-per-
	// register callee return), regardless of size; only a single aggregate srets
	// by size.  See emitClosureShimAggregateAA64.
	var useSret bool = retSz > 16 && multiRetTuple == nil
	var stkBytes int = cc.CallStackBytes(argTypes)
	var retbufOff int = stkBytes
	var inner int = stkBytes
	if !useSret {
		// Pack: a 16-byte slot above the outgoing args holds the retbuf
		// across the BL (16 keeps SP 16-aligned — stkBytes already is).
		inner = inner + 16
	}
	var frameDelta int = 16 + inner

	aarch64.Stp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPre(aarch64.SP, -16))
	aarch64.Mov(a, true, aarch64.FP, aarch64.Reg(aarch64.SP))
	if inner > 0 {
		aarch64.Sub(a, true, aarch64.SP, aarch64.SP, aarch64.Imm(inner))
	}
	// Stash retbuf + data before the marshal clobbers X0/X1.  Sret rides X8
	// (the AAPCS64 indirect-result reg, preserved across the BL); pack saves
	// the retbuf above the outgoing args.
	if useSret {
		aarch64.Mov(a, true, aarch64.X8, aarch64.Reg(aarch64.X0))
	} else {
		aarch64.Str(a, true, aarch64.X0, aarch64.MemImm(aarch64.SP, retbufOff))
	}
	aarch64.Mov(a, true, aarch64.X9, aarch64.Reg(aarch64.X1))

	// Marshal, mirroring the scalar stack-spill shim's three steps but with
	// the closure base in X9 (not X0) and the incoming user-arg prefix at 2
	// (retbuf + data): (1) spill stack-bound captures, (2) move user args from
	// their incoming X2.. / caller-stack slots, (3) load reg-bound captures.
	emitClosureCaptureSpillAA64(a, cc, f, argTypes, aarch64.X9)
	var userArgStart int = f.NumCaptureParams
	if captureWordsAggAA64(cc, f) >= 2 {
		// Shift toward higher regs: high-word-first / right-to-left so each
		// source is read before its slot is overwritten.
		var inRegBase int = 1 + nUserWords
		for ui := len(fvTyp.Params) - 1; ui >= 0; ui = ui - 1 {
			inRegBase = inRegBase - cc.EffectiveArgWords(fvTyp.Params[ui].Type)
			emitAggUserArgAA64(a, cc, fvTyp, argTypes, ui, inRegBase, userArgStart, frameDelta, false)
		}
	} else {
		// Shift toward lower regs (1 capture word): low-word-first /
		// left-to-right, WITHIN each arg as well as across args — a downward
		// shift makes word k's outgoing slot coincide with word (k-1)'s
		// incoming, so a high-first order would overwrite an unread source.
		var inRegBase int = 1
		for ui := 0; ui < len(fvTyp.Params); ui = ui + 1 {
			emitAggUserArgAA64(a, cc, fvTyp, argTypes, ui, inRegBase, userArgStart, frameDelta, true)
			inRegBase = inRegBase + cc.EffectiveArgWords(fvTyp.Params[ui].Type)
		}
	}
	emitClosureCaptureRegLoadAA64(a, cc, f, argTypes, aarch64.X9)

	a.SetGlobal(fnLabel)
	aarch64.Bl(a, fnLabel)

	if !useSret {
		// Pack: copy the return through the stashed retbuf, reloaded into X9
		// (outside the return registers).  A small multi-return uses the field-
		// per-class store (X10 the float→GP scratch); a single aggregate copies
		// the packed X0..X(retWords-1).
		aarch64.Ldr(a, true, aarch64.X9, aarch64.MemImm(aarch64.SP, retbufOff))
		if multiRetTuple != nil {
			storeMultiReturnTupleFieldsAA64(a, multiRetTuple, aarch64.X9, 0, aarch64.X10)
		} else {
			var retWords int = retSz / 8
			if retSz % 8 != 0 { retWords = retWords + 1 }
			for ri := 0; ri < retWords; ri = ri + 1 {
				aarch64.Str(a, true, argReg(ri), aarch64.MemImm(aarch64.X9, 8 * ri))
			}
		}
	}

	if inner > 0 {
		aarch64.Add(a, true, aarch64.SP, aarch64.SP, aarch64.Imm(inner))
	}
	aarch64.Ldp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPost(aarch64.SP, 16))
	aarch64.Ret(a)
}

// captureWordsAggAA64 sums the GP-reg-word footprint of a closure's captures
// (1 for an indirect-large aggregate, ArgWords otherwise) — the outgoing
// register the user args shift past, which decides the user-arg move direction.
func captureWordsAggAA64(cc common.CallConv, f @ir.Func) int {
	var n int = 0
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		n = n + effectiveCapWordsAA64(cc, f.ClosureStruct.Fields[i].Type)
	}
	return n
}

// userOutWordsAggAA64 sums the OUTGOING (real-ABI) GP-reg-word footprint of a
// closure's user params — ArgWords for a coerced in-register struct/array
// (which the shim expands from its single by-address dispatch word into that
// many coerced regs), EffectiveArgWords otherwise.  This is the count for the
// register-fit budget (captures + outgoing user words <= X0..X7); the INCOMING
// dispatch-word count (userWordsAA64, EffectiveArgWords throughout) governs the
// incoming-fit budget instead, since the two now diverge for coerced aggregates.
func userOutWordsAggAA64(cc common.CallConv, fvTyp @types.Type) int {
	var n int = 0
	for pi := 0; pi < len(fvTyp.Params); pi = pi + 1 {
		var pt @types.Type = fvTyp.Params[pi].Type
		if common.AggCoercedInReg(pt) {
			n = n + common.ArgWords(pt)
		} else {
			n = n + cc.EffectiveArgWords(pt)
		}
	}
	return n
}

// emitAggUserArgAA64 moves user arg ui (all its words) from its incoming
// aggregate slots (X2.., then the caller stack) to its outgoing classifier
// slots, at the natural store width for an overflow narrow scalar.  inRegBase
// is the arg's global-word base + 1 (the scalar-shim convention the shared
// word-move helper consumes); userArgStart offsets into argTypes past the
// captures.  lowFirst selects the within-arg word order: for an upward shift
// (high-word-first, lowFirst false) each source is read before its slot is
// overwritten; for the downward shift (lowFirst true) word k's outgoing slot
// equals word (k-1)'s incoming, so the words must move low-first instead.
func emitAggUserArgAA64(a @asm.Assembler, cc common.CallConv, fvTyp @types.Type,
		argTypes @[]@types.Type, ui int, inRegBase int, userArgStart int, frameDelta int, lowFirst bool) {
	var ut @types.Type = fvTyp.Params[ui].Type
	var argIdx int = userArgStart + ui
	var outRegStart int = cc.CallArgRegStart(argTypes, argIdx)
	var outStkOff int = cc.CallArgStackOff(argTypes, argIdx)
	if common.AggCoercedInReg(ut) {
		// Coerced in-register struct/array: arrives as ONE by-address pointer
		// word (EffectiveArgWords == 1, so inRegBase already advanced by 1) but
		// the classifier placed its ArgWords value-words across outRegStart /
		// outStkOff.  Load the pointer once, then expand it into those slots.
		emitAggCoercedUserArgAA64(a, cc, ut, inRegBase, frameDelta, outRegStart, outStkOff)
		return
	}
	// EffectiveArgWords: an indirect-large aggregate user arg is one pointer
	// word in and out (matching the dispatch + classifier); ArgWords would
	// over-loop and clobber the neighbor.  A SPLIT is handled per word below.
	var nUw int = cc.EffectiveArgWords(ut)
	var storeSize int = cc.StackArgStoreSize(ut, false)
	if lowFirst {
		for k := 0; k < nUw; k = k + 1 {
			emitUserArgWordMoveAA64(a, inRegBase, k, 2, frameDelta, outRegStart, outStkOff, storeSize)
		}
		return
	}
	for k := nUw - 1; k >= 0; k = k - 1 {
		emitUserArgWordMoveAA64(a, inRegBase, k, 2, frameDelta, outRegStart, outStkOff, storeSize)
	}
}

// emitAggCoercedUserArgAA64 expands a coerced in-register struct/array user arg
// from its single by-address incoming pointer word into the ArgWords value-words
// the underlying's coerced ABI reads.  The incoming pointer is global word
// inRegBase - 1: reg X(2 + inIdx) when it fits the 6 incoming user-arg regs
// (X2..X7), else the caller stack at [SP + frameDelta + (inIdx - 6) * 8].  It is
// copied to X16 (a scratch, not an arg reg) so the value-word loads can't clobber
// it.  Value word k goes to reg argReg(outRegStart + k) when that word is a reg
// word, else (the SPLIT / overflow tail) is shuttled through X17 to its outgoing
// stack slot at outStkOff + (k - regWords) * 8 — a full 8-byte store, since an
// aggregate word is never a narrow natural-size slot.
func emitAggCoercedUserArgAA64(a @asm.Assembler, cc common.CallConv, ut @types.Type, inRegBase int,
		frameDelta int, outRegStart int, outStkOff int) {
	var inIdx int = inRegBase - 1
	if inIdx < 6 {
		aarch64.Mov(a, true, aarch64.X16, aarch64.Reg(argReg(2 + inIdx)))
	} else {
		aarch64.Ldr(a, true, aarch64.X16, aarch64.MemImm(aarch64.SP, frameDelta + (inIdx - 6) * 8))
	}
	var n int = common.ArgWords(ut)
	var regWords int = 0
	if outRegStart >= 0 {
		regWords = 8 - outRegStart
		if regWords > n { regWords = n }
	}
	for k := 0; k < n; k = k + 1 {
		if k < regWords {
			aarch64.Ldr(a, true, argReg(outRegStart + k), aarch64.MemImm(aarch64.X16, 8 * k))
			continue
		}
		aarch64.Ldr(a, true, aarch64.X17, aarch64.MemImm(aarch64.X16, 8 * k))
		aarch64.Str(a, true, aarch64.X17, aarch64.MemImm(aarch64.SP, outStkOff + (k - regWords) * 8))
	}
}
