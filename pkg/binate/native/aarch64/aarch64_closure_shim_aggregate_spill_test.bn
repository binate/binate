package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for aarch64_closure_shim_aggregate_spill.bn — the stack-spill overflow
// path of the aggregate-return / multi-return capturing-closure shim.  Each
// AArch64 instruction is 4 bytes; a closure whose captures overflow the GP arg
// registers takes the stack-spill path, which frames a prologue and spills —
// strictly more instructions than the register-only aggregate path.  End-to-end
// behavior (including the divergent-by-address staging fix) is covered by
// conformance 1030_closure_aggret_byaddr_clobber + the funcval matrix on the
// builder-comp_native_aa64 lane.  Shared helpers (closureFuncManyCaptures,
// opsMkAssembler, opsBytes, fail) live in aarch64_closure_shim_test.bn /
// aarch64_ops_test.bn / aarch64_test.bn; funcValueTypeNoArgsRetStruct lives in
// aarch64_closure_shim_aggregate_test.bn.

// A capturing closure returning a >16-byte aggregate (sret) whose TEN int captures
// overflow the AArch64 GP arg registers (X0..X7 — the retbuf rides X8, not an arg
// reg) forces the aggregate STACK-SPILL path.  It must lower without error and emit
// strictly more than the register-only 1-capture sret shim (the spill frames a
// prologue and shuttles overflow captures through the stack).
func TestEmitClosureShimAggregateStackSpillAA64() testing.TestResult {
	var fSmall @ir.Func = closureFuncManyCaptures(1)
	var fvSret @types.Type = funcValueTypeNoArgsRetStruct(3)
	var aSmall @asm.Assembler = opsMkAssembler()
	emitClosureShim(aSmall, "underlying", fvSret, fSmall)
	if aSmall.HasError {
		return fail("register-only sret closure shim must lower without error")
	}
	var bytesSmall int = opsBytes(aSmall)

	var fBig @ir.Func = closureFuncManyCaptures(10)
	var aBig @asm.Assembler = opsMkAssembler()
	emitClosureShim(aBig, "underlying", fvSret, fBig)
	if aBig.HasError {
		return fail("aggregate stack-spill closure shim must lower without error")
	}
	var bytesBig int = opsBytes(aBig)

	if bytesBig <= bytesSmall {
		return fail(
				"stack-spill aggregate closure shim (frame + spilled captures) "
						"should be larger than the register-only sret shim")
	}
	return ""
}
