package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for aarch64_closure_shim_aggregate.bn — the aggregate-return
// (pack / sret) path of the capturing-closure shim.  Byte-count shape
// pinning, matching the convention in aarch64_closure_shim_test.bn (each
// AArch64 instruction is 4 bytes).  End-to-end behavior is covered by
// conformance/regressions/capturing-closure-aggregate-return on the
// builder-comp_native_aa64-comp_native_aa64 lane; these pin the emitted
// instruction shape so a regression that drops the aggregate dispatch
// (falling back to the 8-byte scalar tail-branch) is caught.  The closure
// IR / func-value helpers (closureFuncSingleIntCapture, opsMkAssembler,
// opsBytes, fail) live in aarch64_closure_shim_test.bn / ops_test.bn.

// A capturing closure returning a >16-byte aggregate (sret shape) with 1
// int capture and 0 user args emits:
//   MOV X8, X0              ; retbuf -> indirect-result reg
//   MOV X9, X1              ; data -> scratch
//   LDR X0, [X9, #0]        ; load capture0 from the closure struct
//   B underlying_fn         ; tail-branch (X8 preserved)
// Four instrs = 16 bytes.  Pins that the aggregate return takes the
// retbuf-aware sret path, NOT the 8-byte scalar tail-branch (which would
// leave X8 unset → the lifted body writes through a null sret pointer).
func TestEmitClosureShimSretReturn() testing.TestResult {
	var fvTyp @types.Type = funcValueTypeNoArgsRetStruct(3)
	var f @ir.Func = liftedReturning(closureFuncSingleIntCapture(), fvTyp)
	var a @asm.Assembler = opsMkAssembler()
	emitClosureShim(a, "underlying", fvTyp, f)
	if opsBytes(a) != 16 {
		return fail("sret closure shim (1-cap/0-user) should emit 4 instrs (16 bytes)")
	}
	return ""
}

// A capturing closure returning a 16-byte aggregate (pack shape) with 1
// int capture and 0 user args builds a frame, stashes retbuf, calls the
// underlying, and copies the two packed return words through retbuf:
//   STP FP,LR,[SP,#-32]! / MOV FP,SP / STR X0,[SP,#16] / MOV X9,X1 /
//   LDR X0,[X9,#0] / BL underlying / LDR X9,[SP,#16] /
//   STR X0,[X9,#0] / STR X1,[X9,#8] / LDP FP,LR,[SP],#32 / RET
// Eleven instrs = 44 bytes.  Distinct from both the scalar (8) and sret
// (16) shapes.
func TestEmitClosureShimPackReturn() testing.TestResult {
	var fvTyp @types.Type = funcValueTypeNoArgsRetStruct(2)
	var f @ir.Func = liftedReturning(closureFuncSingleIntCapture(), fvTyp)
	var a @asm.Assembler = opsMkAssembler()
	emitClosureShim(a, "underlying", fvTyp, f)
	if opsBytes(a) != 44 {
		return fail("pack closure shim (1-cap/0-user, 16B) should emit 11 instrs (44 bytes)")
	}
	return ""
}

// A capturing closure returning a >16-byte aggregate with 1 int capture
// and 1 user int arg shifts the user arg down from its incoming slot X2
// (after the retbuf+data prefix) to its outgoing slot X1 (after the one
// capture):
//   MOV X8,X0 / MOV X9,X1 / MOV X1,X2 / LDR X0,[X9,#0] / B underlying
// Five instrs = 20 bytes.  Pins the captureWords<2 left-to-right user-arg
// shift-down.
func TestEmitClosureShimSretReturn1UserArg() testing.TestResult {
	var fvTyp @types.Type = funcValueType1IntArgRetStruct(3)
	var f @ir.Func = liftedReturning(closureFuncSingleIntCapture1UserArg(), fvTyp)
	var a @asm.Assembler = opsMkAssembler()
	emitClosureShim(a, "underlying", fvTyp, f)
	if opsBytes(a) != 20 {
		return fail("sret closure shim (1-cap/1-user) should emit 5 instrs (20 bytes)")
	}
	return ""
}

// ============================================================
// Helpers
// ============================================================

// structTypeNInt64 builds an n-field struct of int64 — exactly 8*n bytes
// regardless of the test runner's pointer size, so aggregate-return shim
// shapes (pack ≤ 16, sret > 16) classify deterministically.
func structTypeNInt64(n int) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		var fi @types.Field = make(types.Field)
		fi.Name = "f"
		fi.Type = types.TypInt64()
		fields[i] = fi
	}
	return types.MakeStructType("PN", fields)
}

// funcValueTypeNoArgsRetStruct builds @func() PN where PN is an n-int64
// struct (8*n bytes) — the aggregate-return shapes for the shim tests.
func funcValueTypeNoArgsRetStruct(n int) @types.Type {
	var params @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = structTypeNInt64(n)
	return types.MakeFuncValueType(params, results)
}

// funcValueType1IntArgRetStruct builds @func(int) PN (n-int64 struct).
func funcValueType1IntArgRetStruct(n int) @types.Type {
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Name = "y"
	p.Type = types.TypInt()
	params[0] = p
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = structTypeNInt64(n)
	return types.MakeFuncValueType(params, results)
}

// liftedReturning gives a lifted closure function fv's results, as IR-gen lifts it
// (a multi-return also carries its tuple type), and returns it.
func liftedReturning(f @ir.Func, fv @types.Type) @ir.Func {
	f.Results = fv.Results
	f.MultiReturnType = funcValMultiReturnTupleAA64(fv)
	return f
}

// fvReturningAA64 builds @func() returning results.
func fvReturningAA64(results @[]@types.Type) @types.Type {
	var params @[]@types.Param
	return types.MakeFuncValueType(params, results)
}

// A closure whose nine uint8 results (9 bytes) pass aarch64's eight return
// registers is compiled to return through X8, so its shim is the sret shape — the
// same bytes as a 24-byte struct's — not the pack shape.
func TestEmitClosureShimSmallSretMultiReturnAA64() testing.TestResult {
	var u8 @types.Type = types.TypUint8()
	var nine @types.Type = fvReturningAA64(@[]@types.Type{u8, u8, u8, u8, u8, u8, u8, u8, u8})
	var a @asm.Assembler = opsMkAssembler()
	emitClosureShim(a, "underlying", nine, liftedReturning(closureFuncSingleIntCapture(), nine))
	var s3 @types.Type = funcValueTypeNoArgsRetStruct(3)
	var b @asm.Assembler = opsMkAssembler()
	emitClosureShim(b, "underlying", s3, liftedReturning(closureFuncSingleIntCapture(), s3))
	if a.HasError || b.HasError { return fail("unexpected assembler error") }
	if opsBytes(a) != 16 || opsBytes(b) != 16 {
		return fail("a nine-uint8 multi-return closure's shim must be the 16-byte sret shape")
	}
	return ""
}
