package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A capture is loaded from the closure struct as a Binate caller passes it: a narrow
// integer at its own width, extended by its signedness; an aggregate's word no further
// than the aggregate's end; and a capture put together from pieces through a copy of
// the base, never into the base itself.

// captureLoadSameAA64 reports whether loadCaptureWordAA64 of word k of a capture of
// type t at [X9 + ofs] into X1 emits the bytes of want.
func captureLoadSameAA64(t @types.Type, ofs int64, k int, want @asm.Assembler) bool {
	var g @asm.Assembler = mkAsm()
	loadCaptureWordAA64(g, aarch64.X1, aarch64.X9, ofs, k, t, aarch64.X17)
	return !g.HasError && sameCodeAA64(g, want)
}

// structOfAA64 builds a struct type whose fields have the types ts.
func structOfAA64(name @[]char, ts @[]@types.Type) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, len(ts))
	for i := 0; i < len(ts); i++ {
		var fi @types.Field = make(types.Field)
		fi.Name = "f"
		fi.Type = ts[i]
		fields[i] = fi
	}
	return types.MakeStructType(name, fields)
}

// closureFuncOfCapturesAA64 builds a closure Func whose captures have the types ts.
func closureFuncOfCapturesAA64(ts @[]@types.Type) @ir.Func {
	var f @ir.Func = ir.NewFunc("", "main.__funclit_0", make_slice(@ir.Param, 0),
			make_slice(@types.Type, 0))
	var params @[]@ir.Param = make_slice(@ir.Param, len(ts))
	for i := 0; i < len(ts); i++ {
		params[i] = irbuild.NewParam(f, "c", ts[i])
	}
	f.Params = params
	f.IsClosure = true
	f.NumCaptureParams = len(ts)
	f.ClosureStruct = structOfAA64("__closure_c", ts)
	return f
}

func TestLoadCaptureWordNarrowScalarsAA64() testing.TestResult {
	setTarget64()
	var w @asm.Assembler = mkAsm()
	aarch64.Ldrsw(w, aarch64.X1, aarch64.MemImm64(aarch64.X9, 4))
	if !captureLoadSameAA64(types.TypInt32(), 4, 0, w) { return fail("an int32 capture is LDRSW") }
	w = mkAsm()
	aarch64.Ldrsb(w, true, aarch64.X1, aarch64.MemImm64(aarch64.X9, 1))
	if !captureLoadSameAA64(types.TypInt8(), 1, 0, w) { return fail("an int8 capture is LDRSB") }
	w = mkAsm()
	aarch64.Ldrsh(w, true, aarch64.X1, aarch64.MemImm64(aarch64.X9, 2))
	if !captureLoadSameAA64(types.TypInt16(), 2, 0, w) { return fail("an int16 capture is LDRSH") }
	w = mkAsm()
	aarch64.Ldrh(w, aarch64.X1, aarch64.MemImm64(aarch64.X9, 2))
	if !captureLoadSameAA64(types.TypUint16(), 2, 0, w) { return fail("a uint16 capture is LDRH") }
	w = mkAsm()
	aarch64.Ldr(w, false, aarch64.X1, aarch64.MemImm64(aarch64.X9, 4))
	if !captureLoadSameAA64(types.TypUint32(), 4, 0, w) {
		return fail("a uint32 capture is a 32-bit LDR")
	}
	w = mkAsm()
	aarch64.Ldrb(w, aarch64.X1, aarch64.MemImm64(aarch64.X9, 3))
	if !captureLoadSameAA64(types.TypBool(), 3, 0, w) { return fail("a bool capture is LDRB") }
	w = mkAsm()
	aarch64.Ldr(w, true, aarch64.X1, aarch64.MemImm64(aarch64.X9, 8))
	if !captureLoadSameAA64(types.TypInt(), 8, 0, w) { return fail("an int capture is a 64-bit LDR") }
	return ""
}

// A 12-byte struct at offset 4 is a word at 4 and a 32-bit load at 12, through byte
// 15 (its end); a 3-byte struct at 5 is a halfword and a byte shifted in above it.
func TestLoadCaptureWordAggregateBoundedAA64() testing.TestResult {
	setTarget64()
	var ts @[]@types.Type = make_slice(@types.Type, 3)
	ts[0] = types.TypInt32()
	ts[1] = types.TypInt32()
	ts[2] = types.TypInt32()
	var trip @types.Type = structOfAA64("Trip", ts)
	var w @asm.Assembler = mkAsm()
	emitAggPieceAtAarch64(w, true, aarch64.X1, aarch64.X9, 4, 8)
	if !captureLoadSameAA64(trip, 4, 0, w) {
		return fail("word 0 of a 12-byte capture at 4 is bytes 4..11")
	}
	w = mkAsm()
	emitAggPieceAtAarch64(w, true, aarch64.X1, aarch64.X9, 12, 4)
	if !captureLoadSameAA64(trip, 4, 1, w) {
		return fail("word 1 of a 12-byte capture at 4 is bytes 12..15")
	}
	var bs @[]@types.Type = make_slice(@types.Type, 3)
	bs[0] = types.TypInt8()
	bs[1] = types.TypInt8()
	bs[2] = types.TypInt8()
	var odd @types.Type = structOfAA64("Odd", bs)
	w = mkAsm()
	emitAggPieceAtAarch64(w, true, aarch64.X1, aarch64.X9, 5, 2)
	emitAggPieceAtAarch64(w, true, aarch64.X17, aarch64.X9, 7, 1)
	aarch64.Orr(w, true, aarch64.X1, aarch64.X1, aarch64.RegShift(aarch64.X17, aarch64.LSL, 16))
	if !captureLoadSameAA64(odd, 5, 0, w) { return fail("a 3-byte capture at 5 is bytes 5..7") }
	return ""
}

// Two int32 captures: the shim loads each sign-extended from its own 4 bytes (the
// second first, so X0 stays the base until the last load) and branches to the body.
func TestEmitClosureShimNarrowCapturesAA64() testing.TestResult {
	setTarget64()
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt32()
	ts[1] = types.TypInt32()
	var a @asm.Assembler = opsMkAssembler()
	emitClosureShim(a, "underlying", funcValueTypeNoArgsRetInt(), closureFuncOfCapturesAA64(ts))
	var w @asm.Assembler = opsMkAssembler()
	aarch64.Ldrsw(w, aarch64.X1, aarch64.MemImm64(aarch64.X0, 4))
	aarch64.Ldrsw(w, aarch64.X0, aarch64.MemImm64(aarch64.X0, 0))
	w.SetGlobal("underlying")
	aarch64.B(w, "underlying")
	if a.HasError || !sameCodeAA64(a, w) {
		return fail("two int32 captures are LDRSW X1, [X0, #4]; LDRSW X0, [X0]")
	}
	return ""
}

// A 3-byte capture first in the closure struct is put together in X0, so the shim
// reads it through a copy of the base in X16.
func TestEmitClosureShimPiecedCaptureAA64() testing.TestResult {
	setTarget64()
	var bs @[]@types.Type = make_slice(@types.Type, 3)
	bs[0] = types.TypInt8()
	bs[1] = types.TypInt8()
	bs[2] = types.TypInt8()
	var ts @[]@types.Type = make_slice(@types.Type, 1)
	ts[0] = structOfAA64("Odd", bs)
	var a @asm.Assembler = opsMkAssembler()
	emitClosureShim(a, "underlying", funcValueTypeNoArgsRetInt(), closureFuncOfCapturesAA64(ts))
	var w @asm.Assembler = opsMkAssembler()
	aarch64.Mov(w, true, aarch64.X16, aarch64.Reg(aarch64.X0))
	loadAggWordAtAA64(w, aarch64.X0, aarch64.X16, 0, 0, 3, aarch64.X17)
	w.SetGlobal("underlying")
	aarch64.B(w, "underlying")
	if a.HasError { return fail("a 3-byte first capture should not fail") }
	if !sameCodeAA64(a, w) { return fail("a 3-byte first capture is read through X16") }
	return ""
}
