package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Float-aware closure shim for the aarch64 native backend (claude-todo #121).
// A capturing closure with a float-scalar CAPTURE, float-scalar PARAM, or
// float-scalar RETURN cannot ride the GP-only fast / stack-spill paths: those
// move every capture word and user-arg word through X registers, but the
// lifted body reads a float leaf from the FP file (d0..d7, the AAPCS64 NSRN)
// and returns a float scalar in d0.  The shim is entered under the all-int
// dispatch ABI (closure-struct ptr in X0, user args as GP bits in X1..), so it
// must place each float leaf in its FP register and hand the bits back in x0 on
// a float return.  Sibling of #120's func-value float shim.

// closureHasFloatParts reports whether a capturing closure's underlying call or
// return involves a float scalar — a float capture, a float user-arg param, or
// a float-scalar single result — so it needs the float-aware shim rather than
// the GP-only fast / stack-spill paths.
func closureHasFloatParts(fvTyp @types.Type, f @ir.Func) bool {
	if f.ClosureStruct != nil {
		for i := 0; i < f.NumCaptureParams; i++ {
			if common.IsFloatScalarTyp(f.ClosureStruct.Fields[i].Type) {
				return true
			}
		}
	}
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		if common.IsFloatScalarTyp(fvTyp.Params[pi].Type) { return true }
	}
	return shimReturnIsFloatScalarAA64(fvTyp)
}

// emitClosureShimFloatAA64 emits the float-aware closure shim.  It moves the
// closure-struct base to X9, spills the incoming user-arg GP registers to a
// stack scratch area, then loads every underlying-call argument — captures
// (from [X9 + field offset], the lifted body's leading params) then user args
// (from the spill) — into its AAPCS64 register by CLASS: a float-scalar leaf
// via fmov into d/s[NSRN], every other leaf into x[NGRN].  Sourcing everything
// from memory (X9 struct / stack spill) makes the marshal order clobber-free
// (the dests are X0..X7 / D0..D7, neither X9 nor SP).  After the BL a
// float-scalar return is fmov'd d0/s0 -> x0/w0 for the all-int shim.
// Register-only: the underlying call must fit X0..X7 + D0..D7 and the incoming
// user args must fit X1..X7; beyond that the shim records a.SetError (the
// stack-overflow float path isn't implemented — rare, untested).
func emitClosureShimFloatAA64(a @asm.Assembler, fnLabel @[]char,
		fvTyp @types.Type, f @ir.Func) {
	// A SMALL multi-return RESULT (in-register, not sret) alongside float
	// captures/params needs no extra work: this shim marshals the float
	// captures/params into the D registers and the GP args into X registers,
	// BLs the lifted body, and the body returns the tuple field-per-class
	// (float fields in D0,D1.., GP fields in X0,X1..) exactly where the
	// dispatch caller's collectMultiReturnFields reads them.  The single-scalar
	// D0->X0 fixup below is gated on shimReturnIsFloatScalarAA64 (false for
	// len != 1), so it leaves a multi-return untouched.  A BIG (sret) multi-
	// return needs the sret-retbuf path this shim does not emit; unlike x64
	// (whose emitClosureShim_x64 has an isBigMultiReturn branch), the aarch64
	// dispatcher routes every multi-return here, so guard the BIG case below.
	// AAPCS64_Darwin (the backend's CC): the lifted body's prologue packs
	// FP-overflow float stack args at their natural size (a float32 at 4 bytes),
	// so the marshaller below must place them at the same natural offsets/width.
	var cc common.CallConv = common.AAPCS64_Darwin()
	if len(fvTyp.Results) > 1 {
		var rfs @[]@types.Field = make_slice(@types.Field, len(fvTyp.Results))
		for ri := 0; ri < len(fvTyp.Results); ri = ri + 1 {
			var rfld @types.Field = make(types.Field)
			rfld.Type = fvTyp.Results[ri]
			rfs[ri] = rfld
		}
		if cc.MultiReturnTupleNeedsSret(types.MakeStructType("", rfs)) {
			a.SetError("native aa64: float closure with a BIG (sret) "
				"multi-return result is not yet handled")
			return
		}
	}
	// Walk 1: outgoing GP/FP register counts (ngrn/nsrn) + incoming user-arg
	// GP words (nUserWords), for the register-budget bounds check.
	var ngrn int = 0
	var nsrn int = 0
	for i := 0; i < f.NumCaptureParams; i++ {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		if common.IsFloatScalarTyp(ft) {
			nsrn = nsrn + 1
		} else if isIndirectLargeCapAA64(cc, ft) {
			ngrn = ngrn + 1
		} else {
			ngrn = ngrn + common.ArgWords(ft)
		}
	}
	var nUserWords int = 0
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		if common.IsFloatScalarTyp(pt) {
			nsrn = nsrn + 1
		} else {
			ngrn = ngrn + common.ArgWords(pt)
		}
		nUserWords = nUserWords + common.ArgWords(pt)
	}
	// GP fits X0..X7 (8); incoming user args fit X1..X7 (7, X0 is the closure
	// ptr).  Float captures/params beyond the 8 FP arg registers overflow to the
	// outgoing-args stack (handled below); GP / incoming-arg overflow stays the
	// unimplemented stack-spill path.
	if ngrn > 8 || nUserWords > 7 {
		a.SetError("native aa64: float closure shim needs the unimplemented "
			"stack-overflow path (captures/args exceed the register budget)")
		return
	}
	// Frame: FP/LR are saved in their own top 16-byte frame; below them sits the
	// arg frame holding the outgoing-args area for the FP-overflow floats (the
	// 9th+ float capture/param — sequential 8-byte slots at [SP+0..], since GP
	// args stay in regs) and, above that, the incoming user-arg spill.  The
	// outgoing args MUST be at [SP+0..] at the BL (where the callee reads its
	// incoming stack args), so FP/LR cannot sit at the bottom as the no-overflow
	// shim used to do.
	var fpOverflow int = 0
	if nsrn > cc.NumFpArgRegs { fpOverflow = nsrn - cc.NumFpArgRegs }
	var outBytes int = fpOverflow * 8
	var argFrame int = outBytes + nUserWords * 8
	if argFrame % 16 != 0 { argFrame = argFrame + 8 }
	aarch64.Stp(a, true, aarch64.FP, aarch64.LR,
		aarch64.MemPre(aarch64.SP, -16))
	aarch64.Mov(a, true, aarch64.FP, aarch64.Reg(aarch64.SP))
	if argFrame > 0 {
		aarch64.Sub(a, true, aarch64.SP, aarch64.SP, aarch64.Imm(argFrame))
	}
	// X9 = closure-struct base (X0 holds it on entry).  X9 is caller-saved and
	// never an outgoing arg register, so it survives the marshal and the
	// capture loads read it without a clobber hazard.
	aarch64.Mov(a, true, aarch64.X9, aarch64.Reg(aarch64.X0))
	// Spill incoming user-arg words X1..X(nUserWords) above the outgoing-args
	// area, at [SP + outBytes + w*8].
	for w := 0; w < nUserWords; w++ {
		aarch64.Str(a, true, argReg(1 + w),
			aarch64.MemImm(aarch64.SP, outBytes + w * 8))
	}
	// Marshal the underlying call's args from memory into their AAPCS64
	// registers by class: captures from [X9 + ofs], user args from the spill at
	// [SP + outBytes + w*8]; an FP-overflow float goes to the outgoing-args area
	// at [SP + 0..].  gpDestBase 0 — the scalar/void underlying's GP args start
	// at X0.
	loadClosureFloatCallArgsAA64(a, cc, fvTyp, f, aarch64.X9, outBytes, 0)
	a.SetGlobal(fnLabel)
	aarch64.Bl(a, fnLabel)
	// Float-scalar return: the lifted body returns it in d0/s0; the all-int
	// shim hands the bits back in x0.
	if shimReturnIsFloatScalarAA64(fvTyp) {
		if common.FloatScalarIsI32(fvTyp.Results[0]) {
			aarch64.Fmov_s_to_w(a, aarch64.X0, aarch64.D0)
		} else {
			aarch64.Fmov_fp_to_gp(a, aarch64.X0, aarch64.D0)
		}
	}
	if argFrame > 0 {
		aarch64.Add(a, true, aarch64.SP, aarch64.SP, aarch64.Imm(argFrame))
	}
	aarch64.Ldp(a, true, aarch64.FP, aarch64.LR,
		aarch64.MemPost(aarch64.SP, 16))
	aarch64.Ret(a)
}

// emitFloatLoadToFpAA64 loads a float-scalar value at [base + ofs] into FP
// register fpReg through the X16 scratch (the asm has no FP load): a float64
// via a 64-bit Ldr + Fmov_gp_to_fp; a float32 via a 32-bit Ldr + Fmov_w_to_s,
// so neither the high bits of the GP word nor any bytes past a 4-byte field
// reach the S register.
func emitFloatLoadToFpAA64(a @asm.Assembler, fpReg int, base int, ofs int,
		ft @types.Type) {
	if common.FloatScalarIsI32(ft) {
		aarch64.Ldr(a, false, aarch64.X16, aarch64.MemImm(base, ofs))
		aarch64.Fmov_w_to_s(a, fpReg, aarch64.X16)
	} else {
		aarch64.Ldr(a, true, aarch64.X16, aarch64.MemImm(base, ofs))
		aarch64.Fmov_gp_to_fp(a, fpReg, aarch64.X16)
	}
}

// emitFloatToOverflowStackAA64 moves an FP-overflow float-scalar value at
// [base + ofs] to the underlying call's outgoing-args stack, at the NATURAL
// offset/width the lifted body's prologue reads it from: on a natural-size-stack
// convention (Apple-AArch64) a float32 takes a 4-byte slot, 4-aligned; a float64
// (and non-natural conventions) take an 8-byte slot.  dstOff is the running
// offset; the value is aligned + placed, and the offset just past it returned.
// Shuttles through X16 (the AAPCS intra-call scratch, never an arg register).
func emitFloatToOverflowStackAA64(a @asm.Assembler, cc common.CallConv,
		base int, ofs int, dstOff int, ft @types.Type) int {
	// A float scalar is the only overflow shape here: float32 → a 4-byte
	// slot, float64 → 8-byte (there is no sub-4-byte float).
	var sz int = cc.StackArgStoreSize(ft, false)
	if dstOff % sz != 0 { dstOff = dstOff + (sz - dstOff % sz) }
	// Load the float bits at natural width (a float32 via a 32-bit Ldr, which
	// zero-extends X16 so the slot's high bytes stay clean).
	if common.FloatScalarIsI32(ft) {
		aarch64.Ldr(a, false, aarch64.X16, aarch64.MemImm(base, ofs))
	} else {
		aarch64.Ldr(a, true, aarch64.X16, aarch64.MemImm(base, ofs))
	}
	aarch64.StrSized(a, sz, aarch64.X16, aarch64.MemImm(aarch64.SP, dstOff))
	return dstOff + sz
}

// loadClosureFloatCallArgsAA64 loads the underlying lifted-body call's args
// into their AAPCS64 registers BY CLASS: a float-scalar capture/param into
// d[nsrn], every other word into argReg(gpDestBase + ngrn).  Captures source
// [structPtr + fieldOfs]; user args source the spill area
// [SP + spillBaseOff + word*8] (the caller spilled the incoming positional-GP
// user-arg words there).  Every source is memory and every GP/FP dest is
// disjoint from the GP sources, so the loads are order-independent and
// clobber-free (X16, the emitFloatLoadToFpAA64 scratch, is the AAPCS64 intra-
// call scratch, never an arg register).  gpDestBase is the first GP arg slot
// the underlying uses (0 for every aarch64 shape — the sret pointer rides the
// dedicated X8, so explicit args always start at X0).  Shared by the float-
// scalar (emitClosureShimFloatAA64) and float-aggregate
// (emitClosureShimFloatAggregateAA64) closure shims.
func loadClosureFloatCallArgsAA64(a @asm.Assembler, cc common.CallConv,
		fvTyp @types.Type, f @ir.Func, structPtr int, spillBaseOff int,
		gpDestBase int) {
	var ngrn int = 0
	var nsrn int = 0
	// FP-overflow floats (the 9th+ float) go to the outgoing-args area at
	// [SP + fpOverflowOff], at the natural offset/width the lifted body reads
	// (emitFloatToOverflowStackAA64 advances the offset) — the scalar shim
	// reserved the space (the aggregate shim gates nsrn > NumFpArgRegs to
	// SetError, so it never reaches this path).
	var fpOverflowOff int = 0
	for i := 0; i < f.NumCaptureParams; i++ {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var ofs int = f.ClosureStruct.FieldOffset(i)
		if common.IsFloatScalarTyp(ft) {
			if nsrn < cc.NumFpArgRegs {
				emitFloatLoadToFpAA64(a, aarch64.D0 + nsrn, structPtr, ofs, ft)
			} else {
				fpOverflowOff = emitFloatToOverflowStackAA64(a, cc, structPtr,
					ofs, fpOverflowOff, ft)
			}
			nsrn = nsrn + 1
		} else if isIndirectLargeCapAA64(cc, ft) {
			aarch64.Add(a, true, argReg(gpDestBase + ngrn), structPtr,
				aarch64.Imm(ofs))
			ngrn = ngrn + 1
		} else {
			var nw int = common.ArgWords(ft)
			for k := 0; k < nw; k++ {
				aarch64.Ldr(a, true, argReg(gpDestBase + ngrn),
					aarch64.MemImm(structPtr, ofs + k * 8))
				ngrn = ngrn + 1
			}
		}
	}
	var inWord int = 0
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		if common.IsFloatScalarTyp(pt) {
			if nsrn < cc.NumFpArgRegs {
				emitFloatLoadToFpAA64(a, aarch64.D0 + nsrn, aarch64.SP,
					spillBaseOff + inWord * 8, pt)
			} else {
				fpOverflowOff = emitFloatToOverflowStackAA64(a, cc, aarch64.SP,
					spillBaseOff + inWord * 8, fpOverflowOff, pt)
			}
			nsrn = nsrn + 1
			inWord = inWord + 1
		} else {
			var nw int = common.ArgWords(pt)
			for k := 0; k < nw; k++ {
				aarch64.Ldr(a, true, argReg(gpDestBase + ngrn),
					aarch64.MemImm(aarch64.SP,
						spillBaseOff + (inWord + k) * 8))
				ngrn = ngrn + 1
			}
			inWord = inWord + nw
		}
	}
}

// emitClosureShimFloatAggregateAA64 emits the closure shim for a float-
// containing closure whose function value returns a SINGLE aggregate — the
// intersection of the float marshalling (loadClosureFloatCallArgsAA64) and the
// retbuf/sret aggregate-return convention (retbuf in X0, data in X1, user args
// in X2.. under the all-int dispatch ABI, float bits included).  Two shapes,
// mirroring emitClosureShimAggregateAA64:
//
//   * Pack (retSz 1..16): the lifted body packs the aggregate into
//     X0..X(retWords-1) REGARDLESS of field class — the single-aggregate
//     emitReturn is all-GP — so the shim copies those words straight through
//     the stashed retbuf with no FP result handling.
//   * Sret (retSz > 16): retbuf X0 -> X8 (the AAPCS64 indirect result reg); the
//     lifted body writes the result through X8.
//
// gpDestBase is 0 for both shapes (the sret pointer rides X8, outside X0..X7,
// so the underlying's explicit GP args always start at X0).  Register-only: GP
// outgoing must fit X0..X7, FP D0..D7, and the incoming user words must fit
// X2..X7 (≤ 6) — beyond that the shim records a compile error (the stack-
// overflow float path is claude-todo #121's reg-overflow case, not yet
// implemented).
func emitClosureShimFloatAggregateAA64(a @asm.Assembler, fnLabel @[]char,
		fvTyp @types.Type, f @ir.Func, retSz int) {
	var cc common.CallConv = common.AAPCS64()
	var useSret bool = retSz > 16
	// Outgoing GP/FP budget + incoming user-word count (all user words, float
	// bits included, arrive in GP slots and are spilled).
	var ngrn int = 0
	var nsrn int = 0
	for i := 0; i < f.NumCaptureParams; i++ {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		if common.IsFloatScalarTyp(ft) {
			nsrn = nsrn + 1
		} else if isIndirectLargeCapAA64(cc, ft) {
			ngrn = ngrn + 1
		} else {
			ngrn = ngrn + common.ArgWords(ft)
		}
	}
	var nUserWords int = 0
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		if common.IsFloatScalarTyp(pt) {
			nsrn = nsrn + 1
		} else {
			ngrn = ngrn + common.ArgWords(pt)
		}
		nUserWords = nUserWords + common.ArgWords(pt)
	}
	// The nsrn > NumFpArgRegs (FP overflow) arm of this guard is load-bearing:
	// the shared marshaller routes an overflow float to the outgoing-args area at
	// [SP+0..], but THIS shim's frame puts the retbuf save slot / user-arg spill
	// there (not a reserved overflow area).  Do NOT relax the FP-overflow arm
	// without first restructuring this frame to reserve [SP+0..] for outgoing
	// args (as emitClosureShimFloatAA64 does), or the overflow store corrupts the
	// retbuf/spill.
	if ngrn > 8 || nsrn > cc.NumFpArgRegs || nUserWords > 6 {
		a.SetError("native aa64: float closure with an aggregate return needs "
			"the unimplemented stack-overflow path (captures/args exceed the "
			"register budget)")
		return
	}
	if useSret {
		// Sret: retbuf X0 -> X8 (set BEFORE the marshal clobbers X0), data
		// X1 -> X9.  Frame + spill, marshal (gpDestBase 0), BL (X8 preserved ->
		// the underlying writes the result through it), tear down.
		var frameBytes int = 16 + nUserWords * 8
		if frameBytes % 16 != 0 { frameBytes = frameBytes + 8 }
		aarch64.Stp(a, true, aarch64.FP, aarch64.LR,
			aarch64.MemPre(aarch64.SP, 0 - frameBytes))
		aarch64.Mov(a, true, aarch64.FP, aarch64.Reg(aarch64.SP))
		aarch64.Mov(a, true, aarch64.X8, aarch64.Reg(aarch64.X0))
		aarch64.Mov(a, true, aarch64.X9, aarch64.Reg(aarch64.X1))
		for w := 0; w < nUserWords; w++ {
			aarch64.Str(a, true, argReg(2 + w),
				aarch64.MemImm(aarch64.SP, 16 + w * 8))
		}
		loadClosureFloatCallArgsAA64(a, cc, fvTyp, f, aarch64.X9, 16, 0)
		a.SetGlobal(fnLabel)
		aarch64.Bl(a, fnLabel)
		aarch64.Ldp(a, true, aarch64.FP, aarch64.LR,
			aarch64.MemPost(aarch64.SP, frameBytes))
		aarch64.Ret(a)
		return
	}
	// Pack (retSz 1..16): the frame holds FP/LR + a retbuf save slot ([SP+16]) +
	// the incoming user-arg spill ([SP+24 + w*8]).  Stash retbuf, data X1 -> X9,
	// spill, marshal (gpDestBase 0), BL, reload retbuf into X9, copy the all-GP
	// packed return X0..X(retWords-1) through it.
	var frameBytes int = 24 + nUserWords * 8
	if frameBytes % 16 != 0 { frameBytes = frameBytes + 8 }
	aarch64.Stp(a, true, aarch64.FP, aarch64.LR,
		aarch64.MemPre(aarch64.SP, 0 - frameBytes))
	aarch64.Mov(a, true, aarch64.FP, aarch64.Reg(aarch64.SP))
	aarch64.Str(a, true, aarch64.X0, aarch64.MemImm(aarch64.SP, 16))
	aarch64.Mov(a, true, aarch64.X9, aarch64.Reg(aarch64.X1))
	for w := 0; w < nUserWords; w++ {
		aarch64.Str(a, true, argReg(2 + w),
			aarch64.MemImm(aarch64.SP, 24 + w * 8))
	}
	loadClosureFloatCallArgsAA64(a, cc, fvTyp, f, aarch64.X9, 24, 0)
	a.SetGlobal(fnLabel)
	aarch64.Bl(a, fnLabel)
	aarch64.Ldr(a, true, aarch64.X9, aarch64.MemImm(aarch64.SP, 16))
	var retWords int = retSz / 8
	if retSz % 8 != 0 { retWords = retWords + 1 }
	for ri := 0; ri < retWords; ri = ri + 1 {
		aarch64.Str(a, true, argReg(ri), aarch64.MemImm(aarch64.X9, 8 * ri))
	}
	aarch64.Ldp(a, true, aarch64.FP, aarch64.LR,
		aarch64.MemPost(aarch64.SP, frameBytes))
	aarch64.Ret(a)
}
