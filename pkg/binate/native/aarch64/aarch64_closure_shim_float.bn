package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Float-aware closure shim for the aarch64 native backend (claude-todo #121).
// A capturing closure with a float-scalar CAPTURE, float-scalar PARAM, or
// float-scalar RETURN cannot ride the GP-only fast / stack-spill paths: those
// move every capture word and user-arg word through X registers, but the
// lifted body reads a float leaf from the FP file (d0..d7, the AAPCS64 NSRN)
// and returns a float scalar in d0.  The shim is entered under the all-int
// dispatch ABI (closure-struct ptr in X0, user args as GP bits in X1..), so it
// must place each float leaf in its FP register and hand the bits back in x0 on
// a float return.  Sibling of #120's func-value float shim.

// closureHasFloatParts reports whether a capturing closure's underlying call or
// return involves a float scalar — a float capture, a float user-arg param, or
// a float-scalar single result — so it needs the float-aware shim rather than
// the GP-only fast / stack-spill paths.
func closureHasFloatParts(fvTyp @types.Type, f @ir.Func) bool {
	if f.ClosureStruct != nil {
		for i := 0; i < f.NumCaptureParams; i++ {
			var ct @types.Type = f.ClosureStruct.Fields[i].Type
			if common.IsFloatScalarTyp(ct) || isHfaAggregate(ct) {
				return true
			}
		}
	}
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		if common.IsFloatScalarTyp(pt) || isHfaAggregate(pt) { return true }
	}
	if shimReturnIsFloatScalarAA64(fvTyp) { return true }
	return len(fvTyp.Results) == 1 && isHfaAggregate(fvTyp.Results[0])
}

// emitClosureShimFloatAA64 emits the float-aware closure shim.  It moves the
// closure-struct base to X9, spills the incoming user-arg words (X1..X7 plus any
// on the caller's stack) to a scratch area, then marshals every underlying-call
// argument — captures (from [X9 + field offset]) then user args (from the
// spill) — into its aarch64CC slot by CLASS (loadClosureFloatCallArgsAA64):
// a float-scalar leaf via fmov into d/s[NSRN], every other word into x[NGRN],
// with GP / FP overflow placed on the outgoing-args stack at the natural offset
// the lifted body reads.  Sourcing everything from memory (X9 struct / stack
// spill) makes the marshal order clobber-free.  After the BL a float-scalar
// return is fmov'd d0/s0 -> x0/w0 for the all-int shim.  Only a BIG (sret)
// multi-return result is still unhandled (a.SetError below).
func emitClosureShimFloatAA64(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type, f @ir.Func) {
	// This shim serves the SCALAR / void float-closure return only: a multi-
	// return (which under retbuf-for-any-multi-return rides the retbuf-in-X0
	// convention) is intercepted by emitClosureShim's multi-return branch — a
	// small tuple routes to emitClosureShimFloatAggregateAA64 (retbuf + field-
	// per-class store), a big tuple fails loud there — so it never reaches here.
	// The single-scalar D0->X0 fixup below is gated on shimReturnIsFloatScalarAA64.
	// aarch64CC (the backend's CC): the lifted body's prologue packs
	// FP-overflow float stack args at their natural size (a float32 at 4 bytes),
	// so the marshaller below must place them at the same natural offsets/width.
	var cc common.CallConv = aarch64CC()
	// Outgoing-args area (GP + FP overflow) sized by the classifier, and the
	// incoming user-arg word count (EffectiveArgWords: an indirect-large user
	// arg is one pointer word).
	var argTypes @[]@types.Type = buildShimArgTypesAA64(fvTyp, f)
	var nUserWords int = userWordsAA64(cc, fvTyp)
	var outBytes int = cc.CallStackBytes(argTypes)
	// Frame: FP/LR in a top 16-byte record; below it the arg frame holds the
	// outgoing-args area ([SP+0..outBytes), where the callee reads its overflow
	// stack args at the BL) and, above that, the incoming user-arg spill
	// ([SP+outBytes..]).  frameDelta = 16 (record) + argFrame reaches the
	// caller's incoming stack args.
	var argFrame int = outBytes + nUserWords * 8
	if argFrame % 16 != 0 { argFrame = argFrame + 8 }
	var frameDelta int = 16 + argFrame
	aarch64.Stp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPre(aarch64.SP, -16))
	aarch64.Mov(a, true, aarch64.FP, aarch64.Reg(aarch64.SP))
	if argFrame > 0 {
		aarch64.Sub(a, true, aarch64.SP, aarch64.SP, aarch64.Imm(argFrame))
	}
	// X9 = closure-struct base (X0 on entry) — survives the marshal (never an
	// outgoing arg register).
	aarch64.Mov(a, true, aarch64.X9, aarch64.Reg(aarch64.X0))
	// Spill the incoming user-arg words to [SP + outBytes + w*8]: X1..X7 hold
	// the first 7; any beyond arrive on the caller's stack at [SP + frameDelta].
	for w := 0; w < nUserWords; w++ {
		if w < 7 {
			aarch64.Str(a, true, argReg(1 + w), aarch64.MemImm(aarch64.SP, outBytes + w * 8))
		} else {
			aarch64.Ldr(a, true, aarch64.X16, aarch64.MemImm(aarch64.SP, frameDelta + (w - 7) * 8))
			aarch64.Str(a, true, aarch64.X16, aarch64.MemImm(aarch64.SP, outBytes + w * 8))
		}
	}
	// Marshal from memory by class: captures from [X9 + ofs], user args from the
	// spill at [SP + outBytes + w*8]; GP / FP overflow goes to the outgoing-args
	// area at [SP + 0..].  gpDestBase 0 — the scalar/void underlying's GP args
	// start at X0.
	loadClosureFloatCallArgsAA64(a, cc, fvTyp, f, aarch64.X9, outBytes, 0)
	a.SetGlobal(fnLabel)
	aarch64.Bl(a, fnLabel)
	// Float-scalar return: the lifted body returns it in d0/s0; the all-int
	// shim hands the bits back in x0.
	if shimReturnIsFloatScalarAA64(fvTyp) {
		if common.FloatScalarIsI32(fvTyp.Results[0]) {
			aarch64.Fmov_s_to_w(a, aarch64.X0, aarch64.D0)
		} else {
			aarch64.Fmov_fp_to_gp(a, aarch64.X0, aarch64.D0)
		}
	}
	if argFrame > 0 {
		aarch64.Add(a, true, aarch64.SP, aarch64.SP, aarch64.Imm(argFrame))
	}
	aarch64.Ldp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPost(aarch64.SP, 16))
	aarch64.Ret(a)
}

// emitFloatLoadToFpAA64 loads a float-scalar value at [base + ofs] into FP
// register fpReg through the X16 scratch (the asm has no FP load): a float64
// via a 64-bit Ldr + Fmov_gp_to_fp; a float32 via a 32-bit Ldr + Fmov_w_to_s,
// so neither the high bits of the GP word nor any bytes past a 4-byte field
// reach the S register.
func emitFloatLoadToFpAA64(a @asm.Assembler, fpReg int, base int, ofs int, ft @types.Type) {
	if common.FloatScalarIsI32(ft) {
		aarch64.Ldr(a, false, aarch64.X16, aarch64.MemImm(base, ofs))
		aarch64.Fmov_w_to_s(a, fpReg, aarch64.X16)
	} else {
		aarch64.Ldr(a, true, aarch64.X16, aarch64.MemImm(base, ofs))
		aarch64.Fmov_gp_to_fp(a, fpReg, aarch64.X16)
	}
}

// loadClosureFloatCallArgsAA64 marshals the underlying lifted-body call's args
// into their aarch64CC slots BY CLASS, classifier-driven so every overflow
// word lands at the offset the lifted body's prologue reads it from:
//   * float scalar -> d/s[nsrn]; an FP-overflow float -> [SP + CallArgStackOff]
//     at its natural width (a float32 is 4 bytes).
//   * a GP word -> argReg(CallArgRegStart + word) while it fits, else
//     [SP + CallArgStackOff + (word - regWords)*8] at natural width (a SPLIT
//     <=16-byte aggregate straddles reg/stack).  An indirect-large aggregate is
//     a single pointer word (EffectiveArgWords).
// Captures source [structPtr + fieldOfs] (an indirect-large capture is pointer-
// passed via ADD; a coerced in-register capture is stored inline in the closure
// struct, so its value-words are read straight from the fields); user args
// source the spill at [SP + spillBaseOff + word*8], advancing the incoming
// cursor by EffectiveArgWords (so a BY-ADDRESS user arg consumes ONE spill word).
// An indirect-large user arg's spill word is a pointer the dispatch already
// materialized, loaded straight through; a coerced in-register user arg's spill
// word is likewise a pointer, dereferenced so its ArgWords value-words feed the
// coerced register/stack slots the classifier assigned.
// gpDestBase is 0 (the sret pointer rides X8, so explicit GP args start at X0).
// X16 is the load/shuttle scratch (AAPCS intra-call, never an arg register).
// Shared by the float-scalar (emitClosureShimFloatAA64) and float-aggregate
// (emitClosureShimFloatAggregateAA64) closure shims.
func loadClosureFloatCallArgsAA64(a @asm.Assembler, cc common.CallConv, fvTyp @types.Type,
		f @ir.Func, structPtr int, spillBaseOff int, gpDestBase int) {
	var argTypes @[]@types.Type = buildShimArgTypesAA64(fvTyp, f)
	var nsrn int = 0
	for i := 0; i < f.NumCaptureParams; i++ {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		nsrn = marshalFloatShimArgAA64(a, cc, argTypes, i, ft, structPtr, f.ClosureStruct.FieldOffset(i),
				true, gpDestBase, nsrn)
	}
	var inWord int = 0
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		nsrn = marshalFloatShimArgAA64(a, cc, argTypes, f.NumCaptureParams + pi, pt, aarch64.SP,
				spillBaseOff + inWord * 8, false, gpDestBase, nsrn)
		inWord = inWord + shimInWordsForTypeAA64(cc, pt)
	}
}

// marshalFloatShimArgAA64 places one underlying-call arg (type t, classified at
// argTypes[argIdx]) from [srcBase + srcOfs] into its register/stack slot, and
// returns the FP-register cursor nsrn advanced past a float scalar.  isCapture
// selects the indirect-large form: a capture is pointer-passed from the struct
// (ADD), a user arg's pointer is already in the spill (Ldr).
//
// A BY-ADDRESS aggregate USER ARG (isByAddressAggAA64 — a coerced named struct/
// array OR a non-coerced <=16B slice / iface-value) arrives as ONE pointer word:
// the dispatch caller spilled the address, not the inline value-words.  The shim
// dereferences that pointer and then places the aggregate's ArgWords value-words
// into the register/stack slots the classifier assigned — the same per-word
// placement as the inline case, just sourced from behind the pointer.  (A coerced
// CAPTURE is stored INLINE in the closure struct — the dispatch convention never
// touched captures — so it keeps the inline per-word load.)
func marshalFloatShimArgAA64(a @asm.Assembler, cc common.CallConv, argTypes @[]@types.Type,
		argIdx int, t @types.Type, srcBase int, srcOfs int, isCapture bool, gpDestBase int,
		nsrn int) int {
	if common.IsFloatScalarTyp(t) {
		if nsrn < cc.NumFpArgRegs {
			emitFloatLoadToFpAA64(a, aarch64.D0 + nsrn, srcBase, srcOfs, t)
		} else {
			if common.FloatScalarIsI32(t) {
				aarch64.Ldr(a, false, aarch64.X16, aarch64.MemImm(srcBase, srcOfs))
			} else {
				aarch64.Ldr(a, true, aarch64.X16, aarch64.MemImm(srcBase, srcOfs))
			}
			aarch64.StrSized(a, cc.StackArgStoreSize(t, false), aarch64.X16,
					aarch64.MemImm(aarch64.SP, cc.CallArgStackOff(argTypes, argIdx)))
		}
		return nsrn + 1
	}
	if isHfaAggregate(t) {
		// HFA arg: its members ride D[nsrn..nsrn+n-1].  A capture is stored
		// INLINE in the closure struct ([srcBase+srcOfs]); a user arg arrives
		// BY-ADDRESS (the spill holds a pointer — deref it into X10).  Members
		// are contiguous at m*hw from the located base.
		hn, hw := types.HfaClassify(t)
		var memBase int = srcBase
		var memOfs int = srcOfs
		if !isCapture {
			aarch64.Ldr(a, true, aarch64.X10, aarch64.MemImm(srcBase, srcOfs))
			memBase = aarch64.X10
			memOfs = 0
		}
		if nsrn + hn <= cc.NumFpArgRegs {
			for m := 0; m < hn; m++ {
				hfaMemberLoadToFp(a, aarch64.D0 + nsrn + m, memBase, memOfs + m * hw, hw)
			}
			return nsrn + hn
		}
		// FP file exhausted: the whole HFA spills to the outgoing-args stack at
		// its natural (packed) layout; the FP file then closes for later args.
		var soff int = cc.CallArgStackOff(argTypes, argIdx)
		for m := 0; m < hn; m++ {
			aarch64.Ldr(a, hw == 8, aarch64.X16, aarch64.MemImm(memBase, memOfs + m * hw))
			aarch64.StrSized(a, hw, aarch64.X16, aarch64.MemImm(aarch64.SP, soff + m * hw))
		}
		return cc.NumFpArgRegs
	}
	var regStart int = cc.CallArgRegStart(argTypes, argIdx)
	var stackOff int = cc.CallArgStackOff(argTypes, argIdx)
	if isIndirectLargeCapAA64(cc, t) {
		// A single pointer word: ADD from the struct for a capture, or load the
		// dispatch-materialized pointer from the spill for a user arg.
		var dst int = aarch64.X16
		if regStart >= 0 { dst = argReg(gpDestBase + regStart) }
		if isCapture {
			aarch64.Add(a, true, dst, srcBase, aarch64.Imm(srcOfs))
		} else {
			aarch64.Ldr(a, true, dst, aarch64.MemImm(srcBase, srcOfs))
		}
		if regStart < 0 {
			aarch64.Str(a, true, aarch64.X16, aarch64.MemImm(aarch64.SP, stackOff))
		}
		return nsrn
	}
	// Plain GP arg: nw value-words, possibly SPLIT across reg/stack.  Source is
	// [srcBase + srcOfs] for the inline case (any capture, or an ordinary inline
	// user arg); for a coerced in-register USER ARG the spill slot holds a
	// pointer, so dereference it into X10 (a caller-saved temp, distinct from the
	// X16 overflow shuttle below) and source the value-words from [X10 + 0].
	var nw int = common.ArgWords(t)
	var valBase int = srcBase
	var valOfs int = srcOfs
	if !isCapture && isByAddressAggAA64(cc, t) {
		aarch64.Ldr(a, true, aarch64.X10, aarch64.MemImm(srcBase, srcOfs))
		valBase = aarch64.X10
		valOfs = 0
	}
	var regWords int = 0
	if regStart >= 0 {
		regWords = nw
		if stackOff >= 0 { regWords = cc.NumGpArgRegs - regStart }
	}
	var storeSize int = cc.StackArgStoreSize(t, false)
	for k := 0; k < nw; k++ {
		if k < regWords {
			aarch64.Ldr(a, true, argReg(gpDestBase + regStart + k), aarch64.MemImm(valBase, valOfs + k * 8))
		} else {
			aarch64.Ldr(a, true, aarch64.X16, aarch64.MemImm(valBase, valOfs + k * 8))
			aarch64.StrSized(a, storeSize, aarch64.X16,
					aarch64.MemImm(aarch64.SP, stackOff + (k - regWords) * 8))
		}
	}
	return nsrn
}

// emitClosureShimFloatAggregateAA64 emits the closure shim for a float-
// containing closure whose function value returns a SINGLE aggregate — the
// intersection of the float marshalling (loadClosureFloatCallArgsAA64) and the
// retbuf/sret aggregate-return convention (retbuf in X0, data in X1, user args
// in X2.. under the all-int dispatch ABI, float bits included).  Two shapes,
// mirroring emitClosureShimAggregateAA64:
//
//   * Pack (retSz 1..16): the lifted body packs the aggregate into
//     X0..X(retWords-1) REGARDLESS of field class — the single-aggregate
//     emitReturn is all-GP — so the shim copies those words straight through
//     the stashed retbuf with no FP result handling.
//   * Sret (retSz > 16): retbuf X0 -> X8 (the AAPCS64 indirect result reg); the
//     lifted body writes the result through X8.
//
// gpDestBase is 0 for both shapes (the sret pointer rides X8, outside X0..X7,
// so the underlying's explicit GP args always start at X0).  GP / FP / incoming
// overflow is handled: the frame reserves the outgoing-args area at [SP+0..]
// (where the marshaller places overflow) and spills incoming user args from
// X2..X7 plus the caller's stack, mirroring emitClosureShimFloatAA64.
func emitClosureShimFloatAggregateAA64(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type,
		f @ir.Func, retSz int, multiRetTuple @types.Type) {
	var cc common.CallConv = aarch64CC()
	// An HFA result rides D0..D3 (never sret, even a 32-byte 4x f64), so it takes
	// the pack frame but FMOVs its members into the retbuf (below).
	var retIsHfa bool = len(fvTyp.Results) == 1 && isHfaAggregate(fvTyp.Results[0])
	// A single aggregate srets by SIZE (> 16 B) and packs all-GP.  A SMALL multi-
	// return (multiRetTuple != nil) always packs regardless of size, and the
	// callee returns it FIELD-PER-CLASS (float fields in D0.., GP in X0..) — so
	// the pack store is the field-per-class helper.
	var useSret bool = retSz > 16 && !retIsHfa && multiRetTuple == nil
	var argTypes @[]@types.Type = buildShimArgTypesAA64(fvTyp, f)
	var nUserWords int = userWordsAA64(cc, fvTyp)
	var outBytes int = cc.CallStackBytes(argTypes)
	// Frame (low -> high): the outgoing-args overflow area [SP+0..outBytes)
	// (where the callee reads its GP/FP overflow stack args at the BL), the
	// incoming user-arg spill [SP+outBytes..], and (pack only) a retbuf save
	// slot above that; FP/LR ride the top 16-byte record.  Sret keeps the retbuf
	// in X8 (no save slot).  frameDelta = 16 (record) + inner reaches the
	// caller's incoming stack args.
	var retbufOff int = outBytes + nUserWords * 8
	var inner int = retbufOff
	if !useSret { inner = retbufOff + 8 }
	if inner % 16 != 0 { inner = inner + 8 }
	var frameDelta int = 16 + inner
	aarch64.Stp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPre(aarch64.SP, -16))
	aarch64.Mov(a, true, aarch64.FP, aarch64.Reg(aarch64.SP))
	if inner > 0 {
		aarch64.Sub(a, true, aarch64.SP, aarch64.SP, aarch64.Imm(inner))
	}
	// Stash retbuf + data before the marshal clobbers X0/X1.  Sret rides X8 (the
	// indirect-result reg, preserved across the BL); pack saves the retbuf above
	// the spill.
	if useSret {
		aarch64.Mov(a, true, aarch64.X8, aarch64.Reg(aarch64.X0))
	} else {
		aarch64.Str(a, true, aarch64.X0, aarch64.MemImm(aarch64.SP, retbufOff))
	}
	aarch64.Mov(a, true, aarch64.X9, aarch64.Reg(aarch64.X1))
	// Spill the incoming user-arg words to [SP + outBytes + w*8]: X2..X7 hold the
	// first 6 (X0/X1 are retbuf/data); any beyond arrive on the caller's stack at
	// [SP + frameDelta].
	for w := 0; w < nUserWords; w++ {
		if w < 6 {
			aarch64.Str(a, true, argReg(2 + w), aarch64.MemImm(aarch64.SP, outBytes + w * 8))
		} else {
			aarch64.Ldr(a, true, aarch64.X16, aarch64.MemImm(aarch64.SP, frameDelta + (w - 6) * 8))
			aarch64.Str(a, true, aarch64.X16, aarch64.MemImm(aarch64.SP, outBytes + w * 8))
		}
	}
	loadClosureFloatCallArgsAA64(a, cc, fvTyp, f, aarch64.X9, outBytes, 0)
	a.SetGlobal(fnLabel)
	aarch64.Bl(a, fnLabel)
	if !useSret {
		// Reload the stashed retbuf into X9 (outside the return registers).
		aarch64.Ldr(a, true, aarch64.X9, aarch64.MemImm(aarch64.SP, retbufOff))
		if retIsHfa {
			// HFA: the underlying returned the members in D0..D(n-1); FMOV each
			// into the retbuf instead of the all-GP pack below.
			hn, hw := types.HfaClassify(fvTyp.Results[0])
			for m := 0; m < hn; m++ {
				hfaMemberStoreFromFp(a, aarch64.D0 + m, aarch64.X9, m * hw, hw)
			}
		} else if multiRetTuple != nil {
			// Small multi-return: the callee returned it field-per-class (float
			// fields in D0.., GP in X0..); store via the field-per-class helper
			// (X10 the float→GP scratch, outside the return regs and X9 base).
			storeMultiReturnTupleFieldsAA64(a, multiRetTuple, aarch64.X9, 0, aarch64.X10)
		} else {
			// Pack: copy the all-GP packed return X0..X(retWords-1) through the
			// retbuf.
			var retWords int = retSz / 8
			if retSz % 8 != 0 { retWords = retWords + 1 }
			for ri := 0; ri < retWords; ri = ri + 1 {
				aarch64.Str(a, true, argReg(ri), aarch64.MemImm(aarch64.X9, 8 * ri))
			}
		}
	}
	if inner > 0 {
		aarch64.Add(a, true, aarch64.SP, aarch64.SP, aarch64.Imm(inner))
	}
	aarch64.Ldp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPost(aarch64.SP, 16))
	aarch64.Ret(a)
}
