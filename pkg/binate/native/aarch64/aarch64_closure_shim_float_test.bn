package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for aarch64_closure_shim_float.bn (claude-todo #121).  End-to-end
// behavior is covered by conformance/569_func_value_closure_float on
// builder-comp_native_aa64; these pin the closureHasFloatParts classifier and
// that a float closure routes through emitClosureShim to the float-aware path
// and emits a non-empty body without an assembler error.

// floatCaptureClosureFunc: an IsClosure Func capturing one float64.
func floatCaptureClosureFunc() @ir.Func {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var fx @types.Field = make(types.Field)
	fx.Name = "factor"
	fx.Type = types.TypFloat64()
	fields[0] = fx
	var f @ir.Func = make(ir.Func)
	f.Name = "main.__funclit_f"
	f.IsClosure = true
	f.NumCaptureParams = 1
	f.ClosureStruct = types.MakeStructType("__closure_f", fields)
	return f
}

// intCaptureClosureFunc: an IsClosure Func capturing one int64.
func intCaptureClosureFunc() @ir.Func {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var fx @types.Field = make(types.Field)
	fx.Name = "n"
	fx.Type = types.TypInt64()
	fields[0] = fx
	var f @ir.Func = make(ir.Func)
	f.Name = "main.__funclit_i"
	f.IsClosure = true
	f.NumCaptureParams = 1
	f.ClosureStruct = types.MakeStructType("__closure_i", fields)
	return f
}

// fvFloatArgRetFloat: @func(float64) float64 (the 569 user-signature shape).
func fvFloatArgRetFloat() @types.Type {
	var ps @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Type = types.TypFloat64()
	ps[0] = p
	var rs @[]@types.Type = make_slice(@types.Type, 1)
	rs[0] = types.TypFloat64()
	return types.MakeFuncValueType(ps, rs)
}

// fvIntArgRetInt: @func(int64) int64 — no float parts in the signature.
func fvIntArgRetInt() @types.Type {
	var ps @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Type = types.TypInt64()
	ps[0] = p
	var rs @[]@types.Type = make_slice(@types.Type, 1)
	rs[0] = types.TypInt64()
	return types.MakeFuncValueType(ps, rs)
}

// A float CAPTURE makes a closure need the float-aware path even when the
// user signature is all-int.
func TestClosureHasFloatPartsCapture() testing.TestResult {
	if !closureHasFloatParts(fvIntArgRetInt(), floatCaptureClosureFunc()) {
		return fail("a float64 capture should count as a float part")
	}
	return ""
}

// A float PARAM or float RETURN makes a closure need the float-aware path even
// when all captures are integer.
func TestClosureHasFloatPartsParamAndReturn() testing.TestResult {
	if !closureHasFloatParts(fvFloatArgRetFloat(), intCaptureClosureFunc()) {
		return fail("a float64 param/return should count as a float part")
	}
	return ""
}

// An all-int closure has no float parts → stays on the GP-only fast path.
func TestClosureHasFloatPartsNone() testing.TestResult {
	if closureHasFloatParts(fvIntArgRetInt(), intCaptureClosureFunc()) {
		return fail("an all-int closure should NOT have float parts")
	}
	return ""
}

// The 569 shape (float capture + float param + float return) routes through
// emitClosureShim to the float-aware path and emits a non-empty body with no
// assembler error.  (The GP-only paths would mis-place the floats; the
// behavioral check is conformance/569.)
func TestEmitClosureShimFloatRoutes() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitClosureShim(a, "underlying", fvFloatArgRetFloat(), floatCaptureClosureFunc())
	if a.HasError {
		return fail("float closure shim should emit without error")
	}
	if opsBytes(a) == 0 {
		return fail("float closure shim should emit a non-empty body")
	}
	return ""
}

// floatCapturesClosureFunc builds an IsClosure Func capturing n float64 fields
// — n > 8 drives the FP-overflow path of emitClosureShimFloatAA64 (the 9th+
// float capture overflows the FP arg registers to the outgoing-args stack).
func floatCapturesClosureFunc(n int) @ir.Func {
	var fields @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		var fx @types.Field = make(types.Field)
		fx.Type = types.TypFloat64()
		fields[i] = fx
	}
	var f @ir.Func = make(ir.Func)
	f.Name = "main.__funclit_fn"
	f.IsClosure = true
	f.NumCaptureParams = n
	f.ClosureStruct = types.MakeStructType("__closure_fn", fields)
	return f
}

// A closure with more than 8 float captures routes through emitClosureShim to
// the float-aware path and emits a non-empty body without error — the 9th+
// float (here 9 captures + 1 param = 10 floats, 2 overflow) goes to the
// outgoing-args stack rather than tripping the old SetError.  (Behavioral checks
// are conformance/707, 891, 892.)
func TestEmitClosureShimFloatOverflowRoutes() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitClosureShim(a, "underlying", fvFloatArgRetFloat(), floatCapturesClosureFunc(9))
	if a.HasError {
		return fail("float closure w/ >8 float captures should emit without "
				"error")
	}
	if opsBytes(a) == 0 {
		return fail("float closure w/ >8 float captures should emit a non-empty "
				"body")
	}
	return ""
}

// floatStructFuncValue: @func(float64) <struct of nFloatFields f64> — the
// aggregate-return float-closure shapes.  nFloatFields 2 (16 bytes) hits the
// pack path; 3 (24 bytes) hits the sret path.
func floatStructFuncValue(nFloatFields int) @types.Type {
	var ps @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Type = types.TypFloat64()
	ps[0] = p
	var ffields @[]@types.Field = make_slice(@types.Field, nFloatFields)
	for i := 0; i < nFloatFields; i++ {
		var fld @types.Field = make(types.Field)
		fld.Type = types.TypFloat64()
		ffields[i] = fld
	}
	var rs @[]@types.Type = make_slice(@types.Type, 1)
	rs[0] = types.MakeStructType("FloatStruct", ffields)
	return types.MakeFuncValueType(ps, rs)
}

// A float closure that ALSO returns an aggregate routes through emitClosureShim
// to emitClosureShimFloatAggregateAA64 (NOT the old SetError bail) and emits a
// non-empty body for both the pack (≤ 16 B) and sret (> 16 B) shapes.
// (Behavioral checks are conformance/706, 883, 884.)
func TestEmitClosureShimFloatAggregateRoutes() testing.TestResult {
	var aPack @asm.Assembler = opsMkAssembler()
	emitClosureShim(aPack, "underlying", floatStructFuncValue(2), floatCaptureClosureFunc())
	if aPack.HasError {
		return fail("float closure w/ pack aggregate return should emit "
				"without error")
	}
	if opsBytes(aPack) == 0 {
		return fail("float closure w/ pack aggregate return should emit a "
				"non-empty body")
	}
	var aSret @asm.Assembler = opsMkAssembler()
	emitClosureShim(aSret, "underlying", floatStructFuncValue(3), floatCaptureClosureFunc())
	if aSret.HasError {
		return fail("float closure w/ sret aggregate return should emit "
				"without error")
	}
	if opsBytes(aSret) == 0 {
		return fail("float closure w/ sret aggregate return should emit a "
				"non-empty body")
	}
	return ""
}
