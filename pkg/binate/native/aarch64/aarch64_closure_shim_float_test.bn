package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for aarch64_closure_shim_float.bn (claude-todo #121).  End-to-end
// behavior is covered by conformance/569_func_value_closure_float on
// builder-comp_native_aa64; these pin the closureHasFloatParts classifier and
// that a float closure routes through emitClosureShim to the float-aware path
// and emits a non-empty body without an assembler error.

// floatCaptureClosureFunc: an IsClosure Func capturing one float64.
func floatCaptureClosureFunc() @ir.Func {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var fx @types.Field = make(types.Field)
	fx.Name = "factor"
	fx.Type = types.TypFloat64()
	fields[0] = fx
	var f @ir.Func = make(ir.Func)
	f.Name = "main.__funclit_f"
	f.IsClosure = true
	f.NumCaptureParams = 1
	f.ClosureStruct = types.MakeStructType("__closure_f", fields)
	return f
}

// intCaptureClosureFunc: an IsClosure Func capturing one int64.
func intCaptureClosureFunc() @ir.Func {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var fx @types.Field = make(types.Field)
	fx.Name = "n"
	fx.Type = types.TypInt64()
	fields[0] = fx
	var f @ir.Func = make(ir.Func)
	f.Name = "main.__funclit_i"
	f.IsClosure = true
	f.NumCaptureParams = 1
	f.ClosureStruct = types.MakeStructType("__closure_i", fields)
	return f
}

// fvFloatArgRetFloat: @func(float64) float64 (the 569 user-signature shape).
func fvFloatArgRetFloat() @types.Type {
	var ps @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Type = types.TypFloat64()
	ps[0] = p
	var rs @[]@types.Type = make_slice(@types.Type, 1)
	rs[0] = types.TypFloat64()
	return types.MakeFuncValueType(ps, rs)
}

// fvIntArgRetInt: @func(int64) int64 — no float parts in the signature.
func fvIntArgRetInt() @types.Type {
	var ps @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Type = types.TypInt64()
	ps[0] = p
	var rs @[]@types.Type = make_slice(@types.Type, 1)
	rs[0] = types.TypInt64()
	return types.MakeFuncValueType(ps, rs)
}

// A float CAPTURE makes a closure need the float-aware path even when the
// user signature is all-int.
func TestClosureHasFloatPartsCapture() testing.TestResult {
	if !closureHasFloatParts(fvIntArgRetInt(), floatCaptureClosureFunc()) {
		return fail("a float64 capture should count as a float part")
	}
	return ""
}

// A float PARAM or float RETURN makes a closure need the float-aware path even
// when all captures are integer.
func TestClosureHasFloatPartsParamAndReturn() testing.TestResult {
	if !closureHasFloatParts(fvFloatArgRetFloat(), intCaptureClosureFunc()) {
		return fail("a float64 param/return should count as a float part")
	}
	return ""
}

// An all-int closure has no float parts → stays on the GP-only fast path.
func TestClosureHasFloatPartsNone() testing.TestResult {
	if closureHasFloatParts(fvIntArgRetInt(), intCaptureClosureFunc()) {
		return fail("an all-int closure should NOT have float parts")
	}
	return ""
}

// The 569 shape (float capture + float param + float return) routes through
// emitClosureShim to the float-aware path and emits a non-empty body with no
// assembler error.  (The GP-only paths would mis-place the floats; the
// behavioral check is conformance/569.)
func TestEmitClosureShimFloatRoutes() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitClosureShim(a, "underlying", fvFloatArgRetFloat(),
		floatCaptureClosureFunc())
	if a.HasError {
		return fail("float closure shim should emit without error")
	}
	if opsBytes(a) == 0 {
		return fail("float closure shim should emit a non-empty body")
	}
	return ""
}
