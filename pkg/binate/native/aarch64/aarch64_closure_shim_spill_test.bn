package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the closure-shim stack-spill path (aarch64_closure_shim_spill.bn).

// Nine int captures exhaust the register-arg budget, so the shim
// emits a stack-spill prologue for the overflow word: the > 8-word
// case generates a SUB sp + Ldr/Str shuttles + BL + ADD sp + RET
// sequence — much larger than a plain `B` (4 bytes), which would be a
// silent wrong-code fallback.  Assert the spill shape: strictly
// LARGER than the simplest real shim, reflecting that the 9th int's
// stack word triggers the spill path.
func TestEmitClosureShimOverBudgetStackSpill() testing.TestResult {
	var fSimple @ir.Func = closureFuncSingleIntCapture()
	var fvSimple @types.Type = funcValueTypeNoArgsRetInt()
	var aSimple @asm.Assembler = opsMkAssembler()
	emitClosureShim(aSimple, "underlying", fvSimple, fSimple)
	var bytesSimple int = opsBytes(aSimple)

	var fBig @ir.Func = closureFuncManyCaptures(9)
	var fvBig @types.Type = funcValueTypeNoArgsRetInt()
	var aBig @asm.Assembler = opsMkAssembler()
	emitClosureShim(aBig, "underlying", fvBig, fBig)
	var bytesBig int = opsBytes(aBig)

	if bytesBig <= bytesSimple {
		return fail("9-cap stack-spill shim should be larger than 1-cap fast path")
	}
	return ""
}
