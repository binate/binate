package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/native/fold"
import "pkg/binate/types"

// Integer comparison + conditional-branch lowering for the aarch64 backend:
// OP_EQ/NE/LT/LE/GT/GE (emitCompare via CMP + the CSET idiom, with CMP-immediate
// folding in emitCmpAgainst) and OP_BRANCH (emitCondBranch, including flag-branch
// fusion that reads NZCV directly).  condForOp / invertCondForOp map an IR
// comparison to the aa64 condition code (and its inverse) for the signed and
// unsigned families.  Split from aarch64_ops.bn (file length); the arithmetic
// binop/unop lowering lives there.

// emitCompare handles OP_EQ/NE/LT/LE/GT/GE by emitting CMP + CSINC with
// XZR (the CSET idiom). The assembler doesn't expose CSET directly, but
// CSET Rd, cond ≡ CSINC Rd, XZR, XZR, invert(cond).
func emitCompare(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_EQ && ins.Op != iropcode.OP_NE && ins.Op != iropcode.OP_LT &&
			ins.Op != iropcode.OP_LE && ins.Op != iropcode.OP_GT && ins.Op != iropcode.OP_GE {
		return false
	}
	if len(ins.Args) != 2 { return false }
	// Float operands need FCMP + ordered-FP condition codes, not
	// integer CMP — integer CMP would compare bit patterns, which
	// returns wrong answers for IEEE NaN (two NaNs with the same bit
	// pattern compare equal), for +0.0 vs -0.0 (different bit
	// patterns, IEEE-equal), and for Binate's ordered semantics
	// generally.  Delegate to emitFloatCompare in aarch64_float.bn.
	if ins.Args[0].Typ != nil && ins.Args[0].Typ.IsFloat() {
		return emitFloatCompare(a, rm, ins)
	}
	// tst-fold consume: `(a & b) == 0` / `!= 0` where the AND folded into a `tst`
	// emitted at the AND (which already set Z, see emitBinop).  Emit no compare —
	// Z IS the result: a fused branch tests it with b.eq/b.ne (condForOp of EQ/NE),
	// else CSET reads it.  EQ ⇒ true when Z set (invert = NE for CSINC); NE inverse.
	if fold.TstZeroCompareAndOperand(rm, ins) != nil {
		if rm.IsFusedCmp(ins.ID) { return true }
		var trd int = nextReg(rm, ins.ID)
		aarch64.Csinc(a, true, trd, aarch64.XZR, aarch64.XZR, invertCondForOp(ins.Op, false))
		return true
	}
	var lhs int = emitValOperand(a, pkgName, rm, ins.Args[0])
	if lhs < 0 { return false }
	// Emit the flag-setting compare.  A constant RHS the fold selected
	// (IsFoldedImmConst) rides the CMP/CMN immediate operand instead of being
	// materialized into a register — removing the constant's mov (and, under
	// pressure, its per-iteration spill/reload); otherwise the RHS is a register.
	if !emitCmpAgainst(a, pkgName, rm, lhs, ins.Args[1]) { return false }

	// Comparison signedness is keyed on operand type (the result is
	// always bool).  Unsigned uint values with the high bit set
	// would sort as "negative" under the signed condition codes,
	// so route those through the AArch64 unsigned forms.
	var cmpTyp @types.Type = types.StripWrappers(ins.Args[0].Typ)
	var isUnsigned bool = cmpTyp != nil && cmpTyp.IsInteger() && !cmpTyp.Signed

	// Flag-branch fusion: the comparison's only use is the immediately-following
	// conditional branch, which reads NZCV directly (see emitCondBranch), so emit
	// no 0/1 boolean — the CMP flags ARE the result.
	if rm.IsFusedCmp(ins.ID) { return true }

	var rd int = nextReg(rm, ins.ID)
	var invCond int = invertCondForOp(ins.Op, isUnsigned)
	aarch64.Csinc(a, true, rd, aarch64.XZR, aarch64.XZR, invCond)
	return true
}

// emitCmpAgainst emits the flag-setting compare of register `lhs` against the
// value operand `rhs`.  A constant RHS the fold marked (IsFoldedImmConst) rides
// as an immediate: `cmp lhs, #v` for v >= 0, or `cmn lhs, #-v` for a small
// negative (the fold guarantees such a constant is only ever a signed compare's
// RHS, so CMN — compare-against-negative — carries the right flags).  Anything
// else materializes the RHS into a register.  Returns false only if a register
// RHS could not be resolved.
func emitCmpAgainst(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, lhs int,
		rhs @ir.Instr) bool {
	if rhs != nil && rhs.Op == iropcode.OP_CONST_INT && rm.IsFoldedImmConst(rhs.ID) {
		var v int64 = rhs.IntVal
		if v >= cast(int64, 0) {
			aarch64.Cmp(a, true, lhs, aarch64.Imm(cast(int, v)))
		} else {
			aarch64.Cmn(a, true, lhs, aarch64.Imm(cast(int, cast(int64, 0) - v)))
		}
		return true
	}
	var r int = emitValOperand(a, pkgName, rm, rhs)
	if r < 0 { return false }
	aarch64.Cmp(a, true, lhs, aarch64.Reg(r))
	return true
}

// condForOp returns the AArch64 condition code that holds exactly when the IR
// comparison is TRUE — the inverse of invertCondForOp.  emitCondBranch uses it
// to branch to the then-block on a fused comparison's flags (`b.cond`), with no
// intervening boolean.  `isUnsigned` picks the unsigned condition-code family.
func condForOp(op int, isUnsigned bool) int {
	if op == iropcode.OP_EQ { return aarch64.COND_EQ }
	if op == iropcode.OP_NE { return aarch64.COND_NE }
	if isUnsigned {
		if op == iropcode.OP_LT { return aarch64.COND_LO }
		if op == iropcode.OP_LE { return aarch64.COND_LS }
		if op == iropcode.OP_GT { return aarch64.COND_HI }
		return aarch64.COND_HS // OP_GE
	}
	if op == iropcode.OP_LT { return aarch64.COND_LT }
	if op == iropcode.OP_LE { return aarch64.COND_LE }
	if op == iropcode.OP_GT { return aarch64.COND_GT }
	return aarch64.COND_GE // OP_GE
}

// emitCondBranch lowers OP_BRANCH (Args[0]=cond, Block1=then, Block2=else).
// When the condition is a branch-fused integer comparison (IsFusedCmp), the
// comparison already set NZCV, so branch on the flags directly with `b.cond`
// (no boolean register); otherwise test the materialized 0/1 boolean with cbnz.
func emitCondBranch(a @asm.Assembler, funcSym @[]char, rm @common.RegMap, ins @ir.Instr) {
	var cond @ir.Instr = ins.Args[0]
	if cond != nil && rm.IsFusedCmp(cond.ID) && len(cond.Args) >= 1 && cond.Args[0] != nil {
		var cmpTyp @types.Type = types.StripWrappers(cond.Args[0].Typ)
		var isUnsigned bool = cmpTyp != nil && cmpTyp.IsInteger() && !cmpTyp.Signed
		aarch64.Bcond(a, condForOp(cond.Op, isUnsigned), blockLabel(funcSym, ins.Block1.Label))
		aarch64.B(a, blockLabel(funcSym, ins.Block2.Label))
		return
	}
	var condReg int = getOperand(a, rm, ins.Args[0].ID)
	if condReg < 0 { return }
	aarch64.Cbnz(a, true, condReg, blockLabel(funcSym, ins.Block1.Label))
	aarch64.B(a, blockLabel(funcSym, ins.Block2.Label))
}

// invertCondForOp returns the AArch64 condition code that is the
// logical inverse of the IR comparison, so `csinc rd,xzr,xzr,invCond`
// sets rd=1 exactly when the comparison holds.  `isUnsigned` picks
// between the signed (LT/LE/GT/GE) and unsigned (LO/LS/HI/HS)
// condition-code families.
func invertCondForOp(op int, isUnsigned bool) int {
	if op == iropcode.OP_EQ { return aarch64.COND_NE }
	if op == iropcode.OP_NE { return aarch64.COND_EQ }
	if isUnsigned {
		if op == iropcode.OP_LT { return aarch64.COND_HS } // !(a <u b)  ≡  a >=u b
		if op == iropcode.OP_LE { return aarch64.COND_HI } // !(a <=u b) ≡  a >u  b
		if op == iropcode.OP_GT { return aarch64.COND_LS } // !(a >u b)  ≡  a <=u b
		return aarch64.COND_LO // OP_GE: !(a >=u b) ≡ a <u b
	}
	if op == iropcode.OP_LT { return aarch64.COND_GE } // signed
	if op == iropcode.OP_LE { return aarch64.COND_GT } // signed
	if op == iropcode.OP_GT { return aarch64.COND_LE } // signed
	return aarch64.COND_LT // OP_GE, signed
}
