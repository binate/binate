package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the integer comparison + conditional-branch lowering in
// aarch64_compare.bn (emitCompare / emitCmpAgainst / condForOp / emitCondBranch /
// invertCondForOp).  Shared helpers (opsMkAssembler, opsBytes, setTarget64) live
// in aarch64_ops_test.bn — the whole package shares them.

// invertCondForOp maps IR comparisons to the AArch64 condition codes
// that make `csinc rd,xzr,xzr,<cond>` set rd=1 iff the comparison
// holds. These are the walking-skeleton's truth table; a subtle
// off-by-one or wrong invert flips every boolean in the backend.

func TestInvertCondForOp() testing.TestResult {
	// For x == y, we want rd=1 on equality; csinc with COND_NE does
	// that (cond-true → rn=xzr; cond-false → rm+1=1).
	// Pairs: (ir op) → (expected cond code name)
	// We only check it's NOT the opposite — the exact constants live
	// in pkg/binate/asm/aarch64 and change would break this anyway.
	var eq int = invertCondForOp(iropcode.OP_EQ, false)
	var ne int = invertCondForOp(iropcode.OP_NE, false)
	if eq == ne { return "OP_EQ and OP_NE should invert to distinct conds" }

	var lt int = invertCondForOp(iropcode.OP_LT, false)
	var ge int = invertCondForOp(iropcode.OP_GE, false)
	if lt == ge { return "OP_LT and OP_GE should invert to distinct conds" }

	var le int = invertCondForOp(iropcode.OP_LE, false)
	var gt int = invertCondForOp(iropcode.OP_GT, false)
	if le == gt { return "OP_LE and OP_GT should invert to distinct conds" }

	// Unsigned variants must be distinct from their signed
	// counterparts (LO/LS/HI/HS vs LT/LE/GT/GE).  EQ / NE don't
	// depend on signedness, so they're the same as above.
	var ltU int = invertCondForOp(iropcode.OP_LT, true)
	var leU int = invertCondForOp(iropcode.OP_LE, true)
	var gtU int = invertCondForOp(iropcode.OP_GT, true)
	var geU int = invertCondForOp(iropcode.OP_GE, true)
	if ltU == lt { return "OP_LT signed/unsigned should differ" }
	if leU == le { return "OP_LE signed/unsigned should differ" }
	if gtU == gt { return "OP_GT signed/unsigned should differ" }
	if geU == ge { return "OP_GE signed/unsigned should differ" }
	if ltU == geU { return "OP_LT and OP_GE unsigned should invert to distinct conds" }
	if leU == gtU { return "OP_LE and OP_GT unsigned should invert to distinct conds" }
	return ""
}

// emitCompareBytes_aa64 emits emitCompare for an OP_LT over two spilled operands of
// type t and returns the section bytes, so a readonly operand's signedness classify
// can be compared against the plain-int and uint baselines.
func emitCompareBytes_aa64(t @types.Type) @[]uint8 {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = t
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = t
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_LT
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	emitCompare(a, "main", m, ins)
	return a.Sections[0].Data
}

// emitCompareAsm_aa64 emits emitCompare for an OP_LT over two spilled operands of
// type t and returns the assembler; when `fused` it marks the comparison
// branch-fused (rm.FusedCmp[3] set) so emitCompare emits only the flag-setting
// CMP and no 0/1-boolean CSINC — the adjacent OP_BRANCH would test the flags.
func emitCompareAsm_aa64(t @types.Type, fused bool) @asm.Assembler {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	if fused {
		var fc @[]bool = make_slice(bool, 4)
		fc[3] = true
		m.FusedCmp = fc
	}
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = t
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = t
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_LT
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	emitCompare(a, "main", m, ins)
	return a
}

// A branch-fused comparison drops the CSINC: its byte stream is the unfused
// stream (LDR, LDR, CMP, CSINC) with the trailing 4-byte CSINC removed — same
// operand reloads and CMP, no materialized boolean.
func TestEmitCompareFusedDropsCsinc() testing.TestResult {
	var au @asm.Assembler = emitCompareAsm_aa64(types.TypInt(), false)
	var af @asm.Assembler = emitCompareAsm_aa64(types.TypInt(), true)
	var lu int = opsBytes(au)
	var lf int = opsBytes(af)
	if lu == 0 || lf == 0 { return "empty compare stream" }
	if lf != lu - 4 {
		return "fused compare must be exactly one 4-byte CSINC shorter than unfused"
	}
	for i := 0; i < lf; i++ {
		if af.Sections[0].Data[i] != au.Sections[0].Data[i] {
			return "fused compare must be the unfused stream minus the trailing CSINC"
		}
	}
	return ""
}

// A compare whose constant RHS is marked folded (FoldedImmConst) emits a
// CMP-IMMEDIATE (SUBS-immediate, 64-bit, top byte 0xF1) rather than reloading the
// constant and doing a register CMP (SUBS-register, top byte 0xEB) — the value
// rides the instruction, so nothing materializes the constant.
func TestEmitCompareFoldedConstUsesImmediate() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var fc @[]bool = make_slice(bool, 3)
	fc[2] = true // the constant (id 2) folds into the immediate
	m.FoldedImmConst = fc
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Op = iropcode.OP_CONST_INT
	rhs.IntVal = cast(int64, 42)
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_LT
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	emitCompare(a, "main", m, ins)
	var foundImm bool = false
	var foundReg bool = false
	var i int = 0
	for i + 3 < a.Sections[0].Len {
		var top uint8 = a.Sections[0].Data[i + 3]
		if top == cast(uint8, 0xF1) { foundImm = true }
		if top == cast(uint8, 0xEB) { foundReg = true }
		i = i + 4
	}
	if !foundImm { return "a folded-constant compare must emit CMP #imm (SUBS-immediate)" }
	if foundReg { return "a folded-constant compare must NOT emit a register CMP" }
	return ""
}

// A `readonly int` compare operand must classify as SIGNED: StripWrappers peels to
// the int (Signed=true -> the SIGNED CSINC cond), so a readonly-int OP_LT must emit
// byte-identical code to a plain-int OP_LT and DIFFER from an unsigned OP_LT.  Live
// at -O1+ where mem2reg keeps the readonly-typed param value on the compare operand.
func TestEmitCompareReadonlyIntMatchesPlainSigned() testing.TestResult {
	var ro @[]uint8 = emitCompareBytes_aa64(types.MakeReadonlyType(types.TypInt()))
	var plain @[]uint8 = emitCompareBytes_aa64(types.TypInt())
	var uns @[]uint8 = emitCompareBytes_aa64(types.TypUint64())
	if len(ro) != len(plain) || len(ro) == 0 {
		return "readonly-int compare must emit the same-length stream as plain int"
	}
	for i := 0; i < len(ro); i++ {
		if ro[i] != plain[i] {
			return "readonly-int OP_LT must be byte-identical to plain-int (signed) — peel the wrapper"
		}
	}
	// Sanity: signed and unsigned forms genuinely differ, so the match above is meaningful.
	if len(uns) == len(plain) {
		var sameAsUns bool = true
		for i := 0; i < len(plain); i++ {
			if plain[i] != uns[i] { sameAsUns = false }
		}
		if sameAsUns { return "signed and unsigned OP_LT must differ (test would be vacuous)" }
	}
	return ""
}
