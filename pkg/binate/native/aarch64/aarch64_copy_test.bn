package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emitInstr's OP_COPY arm on float values — the copies
// iropt.EliminatePhis inserts for a float phi.

// floatCopy builds `ins := copy src` of type t, with src id 1 and ins id 2.
func floatCopy(t @types.Type) @ir.Instr {
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = t
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_COPY
	ins.Typ = t
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	return ins
}

// A float copy between two D-register homes is one FMOV Dd, Dn, with no GP
// round-trip — for a float64 and for a float32 (its home's low S-view).
func TestEmitCopyFloatBetweenFpHomesIsFmov() testing.TestResult {
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypFloat64()
	ts[1] = types.TypFloat32()
	for i := 0; i < len(ts); i++ {
		var a @asm.Assembler = mkAsm()
		var rm @common.RegMap = common.NewRegMap(callconv.AAPCS64())
		fmHome(rm, 1, aarch64.D9)
		fmHome(rm, 2, aarch64.D8)
		var noStrings @[]ir.StringConst
		emitInstr(a, "main", "fn", rm, noStrings, floatCopy(ts[i]))
		if a.HasError { return fail("a float copy between FP homes must not error") }
		var ref @asm.Assembler = mkAsm()
		aarch64.Fmov_fp_to_fp(ref, aarch64.D8, aarch64.D9)
		var r testing.TestResult = fmSameBytes(a, ref,
				"a float copy between FP homes must be one fmov d8, d9")
		if len(r) > 0 { return r }
	}
	return ""
}

// A float copy from a slot into a D-register home loads the bits into a GP
// scratch and moves them into the home at the value's width — `fmov d8, x` for a
// float64, `fmov s8, w` for a float32 (the direct D-to-D move needs both ends
// homed).
func TestEmitCopyFloatSlotToFpHome() testing.TestResult {
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypFloat64()
	ts[1] = types.TypFloat32()
	for i := 0; i < len(ts); i++ {
		var a @asm.Assembler = mkAsm()
		var rm @common.RegMap = common.NewRegMap(callconv.AAPCS64())
		rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
		rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
		fmHome(rm, 2, aarch64.D8)
		var noStrings @[]ir.StringConst
		emitInstr(a, "main", "fn", rm, noStrings, floatCopy(ts[i]))
		if a.HasError { return fail("a slot to FP-home float copy must not error") }
		var scratch int = allocReg(common.NewRegMap(callconv.AAPCS64()))
		var ref @asm.Assembler = mkAsm()
		aarch64.Ldr(ref, true, scratch, aarch64.MemImm(aarch64.SP, 16))
		if i == 0 {
			aarch64.Fmov_gp_to_fp(ref, aarch64.D8, scratch)
		} else {
			aarch64.Fmov_w_to_s(ref, aarch64.D8, scratch)
		}
		var r testing.TestResult = fmSameBytes(a, ref,
				"a slot to FP-home float copy must load the slot and fmov it into the home at its width")
		if len(r) > 0 { return r }
	}
	return ""
}
