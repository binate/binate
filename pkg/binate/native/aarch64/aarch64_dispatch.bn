package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// emitInstr — instruction selection
// ============================================================

// emitInstr lowers one IR instruction. Walking-skeleton subset only;
// instructions outside this set are silently ignored. The big op
// handlers (MAKE*, STRING_TO_CHARS, LOAD, STORE, EXTRACT, GEP, etc.)
// live in arm64_emit.bn; this is the dispatcher.
func emitInstr(a @asm.Assembler, pkgName *[]readonly char, funcSym @[]char,
	rm @common.RegMap, strings @[]ir.StringConst,
	allFuncs @[]@ir.Func, ins @ir.Instr) {
	currentEmitOp = ins.Op
	switch ins.Op {
	case iropcode.OP_CONST_INT:
		var r int = nextReg(rm, ins.ID)
		emitConstInt64(a, r, ins.IntVal)
		return
	case iropcode.OP_CONST_BOOL:
		var r int = nextReg(rm, ins.ID)
		var v int = 0
		if ins.BoolVal { v = 1 }
		aarch64.Movz(a, true, r, v, 0)
		return
	case iropcode.OP_CONST_NIL:
		emitConstNil(a, rm, ins)
		return
	case iropcode.OP_CONST_STRING:
		var id int = ir.FindStringID(strings, ins.StrVal)
		if id < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		// Strings live in __cstring (cross-section). Mach-O has no
		// reloc for ADR; use ADRP + ADD for the @PAGE / @PAGEOFF
		// pair that ld accepts.
		aarch64.Adrp(a, rd, stringLabel(id))
		aarch64.AddImmLabel(a, true, rd, rd, stringLabel(id))
		return
	case iropcode.OP_CONST_FLOAT:
		var rd int = nextReg(rm, ins.ID)
		emitConstFloat(a, rd, ins)
		return
	case iropcode.OP_RODATA_ARRAY:
		emitStringToArray(a, rm, ins)
		return
	case iropcode.OP_RODATA_MSLICE, iropcode.OP_RODATA_SLICE:
		emitRodataMSliceOrSlice(a, rm, strings, ins)
		return
	case iropcode.OP_RODATA_MSLICE_COPY:
		emitStringToCharsCopy(a, rm, ins, ins.StrVal)
		return
	case iropcode.OP_CALL:
		emitCall(a, pkgName, rm, allFuncs, ins)
		return
	case iropcode.OP_C_CALL:
		// __c_call: same arg-dispatch + return-collect as OP_CALL;
		// emitCall takes the verbatim C symbol from ins.StrVal (no
		// Binate mangling).  Stage-1 contract (scalar/pointer args
		// + return) means no sret arm fires — CalleeUsesCSret
		// short-circuits on non-OP_CALL.
		emitCall(a, pkgName, rm, allFuncs, ins)
		return
	case iropcode.OP_CALL_INDIRECT:
		emitCallIndirect(a, pkgName, rm, allFuncs, ins)
		return
	case iropcode.OP_CALL_FUNC_VALUE:
		emitCallFuncValue(a, pkgName, rm, allFuncs, ins)
		return
	case iropcode.OP_FUNC_HANDLE:
		// Phase 4 of plan-uniform-native-fnptrs.md: produce a *uint8
		// pointing at the static `___handle.<mangled>` global — a
		// 16-byte {vtable_ptr, data_ptr} aggregate whose data slot is
		// null (non-capturing).  Consumed by OP_CALL_HANDLE.  Mirrors
		// the LLVM lowering in pkg/binate/codegen/emit_instr.bn.
		if len(ins.StrVal) == 0 { return }
		var label @[]char = handleSymFor(pkgName, ins.StrVal)
		a.SetGlobal(label)
		var rd int = nextReg(rm, ins.ID)
		aarch64.Adrp(a, rd, label)
		aarch64.AddImmLabel(a, true, rd, rd, label)
		return
	case iropcode.OP_CALL_HANDLE:
		// Phase 4 dispatch: call through a 16-byte handle.  Identical
		// shape to OP_CALL_FUNC_VALUE — the handle and a constructed
		// function value have the same `{vtable_ptr, data_ptr}` layout
		// and the same "load vtable.call, call(data, args)" sequence.
		emitCallFuncValue(a, pkgName, rm, allFuncs, ins)
		return
	case iropcode.OP_IFACE_VALUE:
		// Interface-value construction.  Builds a 16-byte {data,
		// vtable} aggregate in the IR-instruction's pre-allocated
		// data region.  StrVal is the mangled vtable global name
		// (e.g. `__ivt.bn_main__T__I`) emitted by emitImplVtables.
		// Args[0] is the data pointer (already i8*-shaped via earlier
		// bitcast/movs).  Field 0 = data, field 1 = vtable.  Mirrors
		// the LLVM layout in emit_impls.bn.
		if len(ins.StrVal) == 0 || len(ins.Args) < 1 { return }
		var dataOff int = rm.LookupAlloc(ins.ID)
		if dataOff < 0 { return }
		var ivtLabel @[]char = symPrefixed(ins.StrVal)
		a.SetGlobal(ivtLabel)
		// Data ptr -> slot 0.  Get the source register BEFORE
		// allocating scratch regs so the regmap doesn't recycle it.
		// A package-global data ptr (`&g`) is a pseudo-instr with no
		// register (ID -1); materialize its address via ADRP+ADD,
		// mirroring emitLoad's global path — otherwise getOperand
		// returns < 0 and the whole construction is silently dropped.
		var dataReg int
		if isGlobalRef(ins.Args[0]) {
			dataReg = scratchReg(rm)
			emitGlobalAddr(a, pkgName, dataReg, ins.Args[0])
		} else {
			dataReg = getOperand(a, rm, ins.Args[0].ID)
			if dataReg < 0 { return }
		}
		aarch64.Str(a, true, dataReg,
			aarch64.MemImm(aarch64.SP, dataOff))
		// Vtable address -> slot 1.
		var vtTmp int = scratchReg(rm)
		aarch64.Adrp(a, vtTmp, ivtLabel)
		aarch64.AddImmLabel(a, true, vtTmp, vtTmp, ivtLabel)
		aarch64.Str(a, true, vtTmp,
			aarch64.MemImm(aarch64.SP, dataOff + 8))
		// Produce the data-region pointer as the result.
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	case iropcode.OP_CALL_IFACE_METHOD:
		emitCallIfaceMethod(a, pkgName, rm, allFuncs, ins)
		return
	case iropcode.OP_IFACE_UPCAST:
		// Rebuild an interface value with the source's data ptr and
		// a vtable pointer adjusted to land at the target's nested
		// sub-vtable within the source's concat-laid-out vtable.
		// Slot offset is statically known per (srcIface, targetIface)
		// pair, precomputed on the instr at IR-gen time.  Mirrors the LLVM
		// lowering in pkg/binate/codegen/emit_iface_upcast.bn.
		if len(ins.Args) < 1 { return }
		var dataOff int = rm.LookupAlloc(ins.ID)
		if dataOff < 0 { return }
		var srcPtr int = getOperand(a, rm, ins.Args[0].ID)
		if srcPtr < 0 { return }
		// Slot offset precomputed at IR-gen time (see EmitIfaceUpcast).
		var offsetSlots int = ins.IfaceUpcastSlotOffset
		var byteOff int = offsetSlots * 8
		if byteOff < 0 {
			// offsetSlots is -1 only for an invalid upcast (target not
			// an ancestor of source; same-interface now resolves to 0).
			// Silently leaving the vtable pointer unchanged (the old
			// `if byteOff > 0` guard) hid the corruption; abort loudly,
			// matching the LLVM lowering's assert.
			panic("iface upcast (aa64): negative vtable slot offset (target not an ancestor of source)")
		}
		// Data ptr copies straight through.
		var dataTmp int = scratchReg(rm)
		aarch64.Ldr(a, true, dataTmp, aarch64.MemImm(srcPtr, 0))
		aarch64.Str(a, true, dataTmp,
			aarch64.MemImm(aarch64.SP, dataOff))
		// New vtable ptr = source.vtable + byteOff.
		var vtTmp int = scratchReg(rm)
		aarch64.Ldr(a, true, vtTmp, aarch64.MemImm(srcPtr, 8))
		if byteOff > 0 {
			aarch64.Add(a, true, vtTmp, vtTmp,
				aarch64.Imm(byteOff))
		}
		aarch64.Str(a, true, vtTmp,
			aarch64.MemImm(aarch64.SP, dataOff + 8))
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	case iropcode.OP_IFACE_DTOR:
		// Load slot 0 (the dtor) of an interface value's vtable.
		// Args[0] is the iv (a 16-byte {data, vtable}); we read the
		// vtable pointer from offset 8, then load *(vtable+0).
		// Result type matches OP_FUNC_HANDLE — an opaque function-
		// pointer-shaped i8* — so the OP_REFDEC dtor operand path
		// can consume it uniformly.
		if len(ins.Args) < 1 { return }
		var ivPtr int = getOperand(a, rm, ins.Args[0].ID)
		if ivPtr < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		// vt = iv[1]
		aarch64.Ldr(a, true, rd, aarch64.MemImm(ivPtr, 8))
		// dtor = *(vt + 0)
		aarch64.Ldr(a, true, rd, aarch64.MemImm(rd, 0))
		return
	case iropcode.OP_FUNC_VALUE_DTOR:
		// Load slot 0 (the dtor) of a function value's vtable.
		// Args[0] is the fv (a 16-byte {vtable, data} aggregate —
		// mirror of OP_IFACE_DTOR above but with the vtable-first
		// layout that BnFuncValue uses); read the vtable pointer
		// from offset 0, then load *(vtable+0).  Used by
		// emitManagedFuncValueRefDec to feed the dtor through to
		// OP_REFDEC_DTOR.  Without this case, PlanFrame allocates
		// the SSA result slot but nothing writes to it, so the
		// later OP_REFDEC reads garbage — the
		// 521_managed_func_value_propagation crash on native.
		if len(ins.Args) < 1 { return }
		var fvPtr int = getOperand(a, rm, ins.Args[0].ID)
		if fvPtr < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		// vt = fv[0]
		aarch64.Ldr(a, true, rd, aarch64.MemImm(fvPtr, 0))
		// dtor = *(vt + 0)
		aarch64.Ldr(a, true, rd, aarch64.MemImm(rd, 0))
		return
	case iropcode.OP_FUNC_VALUE:
		// Function-value construction. Builds a 16-byte
		// {vtable_addr, data} aggregate in the IR-instruction's
		// pre-allocated data region (PlanFrame allocated it via
		// the OP_FUNC_VALUE arm in IsAggregateTyp).
		// vtable_addr is the address of the per-function vtable
		// global emitted by emitFuncValueVtables.  data is null
		// for Phase 1 non-capturing literals, or the closure-
		// struct pointer (ins.Args[0]) for B.2 capturing.
		if len(ins.StrVal) == 0 { return }
		var dataOff int = rm.LookupAlloc(ins.ID)
		if dataOff < 0 { return }
		var vtLabel @[]char = vtableSymFor(pkgName, ins.StrVal)
		a.SetGlobal(vtLabel)
		// Compute vtable address into a scratch reg via ADRP+ADD.
		var addrTmp int = scratchReg(rm)
		aarch64.Adrp(a, addrTmp, vtLabel)
		aarch64.AddImmLabel(a, true, addrTmp, addrTmp, vtLabel)
		// Store vtable_addr at dataOff+0.
		aarch64.Str(a, true, addrTmp,
			aarch64.MemImm(aarch64.SP, dataOff))
		// Store data at dataOff+8: XZR (null) for Phase 1, the
		// capture struct pointer for B.2 capturing closures.
		if len(ins.Args) == 0 {
			aarch64.Str(a, true, aarch64.XZR,
				aarch64.MemImm(aarch64.SP, dataOff + 8))
		} else {
			var dataReg int = getOperand(a, rm, ins.Args[0].ID)
			aarch64.Str(a, true, dataReg,
				aarch64.MemImm(aarch64.SP, dataOff + 8))
		}
		// Produce the data-region pointer as the result.
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	case iropcode.OP_REFINC:
		emitRefIncInline(a, rm, ins)
		return
	case iropcode.OP_REFDEC:
		emitRefDecInline(a, rm, ins)
		return
		case iropcode.OP_RETURN:
			emitReturn(a, pkgName, rm, ins)
			return
	case iropcode.OP_MANAGED_TO_RAW:
		// @[]T → *[]T: pass the source pointer through; the first 16
		// bytes of a managed-slice ARE the raw-slice representation.
		if len(ins.Args) < 1 { return }
		var src int = getOperand(a, rm, ins.Args[0].ID)
		if src < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		aarch64.Mov(a, true, rd, aarch64.Reg(src))
		return
	case iropcode.OP_BIT_CAST:
		// Reinterpret same-size bits — a plain move in a 64-bit file.
		if len(ins.Args) < 1 { return }
		var src int = emitValOperand(a, pkgName, rm, ins.Args[0])
		if src < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		aarch64.Mov(a, true, rd, aarch64.Reg(src))
		return
	case iropcode.OP_CAST:
		// Numeric conversion with explicit LSL+LSR/ASR narrowing; our
		// regmap is all X-regs, so we can't lean on 32-bit-view
		// zero-extension. emitFloatCast handles any branch where
		// either side is float (SCVTF / FCVTZS / float→float move).
		if len(ins.Args) < 1 || ins.TypeArg == nil { return }
		// emitValOperand (not getOperand): the IsGlobalRef pseudo (ID -1)
		// has no register, so a global-ref cast source (`cast(int, &G)`)
		// would otherwise be dropped, not materialized.  Cf. OP_BIT_CAST.
		var src int = emitValOperand(a, pkgName, rm, ins.Args[0])
		if src < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		if emitFloatCast(a, rd, src, ins.Args[0].Typ, ins.TypeArg) {
			return
		}
		emitCast(a, rd, src, ins.Args[0].Typ, ins.TypeArg)
		return
	case iropcode.OP_BOUNDS_CHECK:
		// Lower to a call to bn_pkg__builtins__rt__BoundsCheck(index, len). The
		// runtime aborts with "index out of bounds: %lld (len %lld)\n"
		// if the unsigned comparison fails — same fast-path the LLVM
		// backend uses, since pkg/builtins/rt provides the implementation.
		if len(ins.Args) < 2 { return }
		var idx int = getOperand(a, rm, ins.Args[0].ID)
		var ln int = getOperand(a, rm, ins.Args[1].ID)
		if idx < 0 || ln < 0 { return }
		aarch64.Mov(a, true, aarch64.X0, aarch64.Reg(idx))
		aarch64.Mov(a, true, aarch64.X1, aarch64.Reg(ln))
		var callee @[]char = symPrefixed("bn_pkg__builtins__rt__BoundsCheck")
		a.SetGlobal(callee)
		aarch64.Bl(a, callee)
		rm.ResetRegs()
		return
	case iropcode.OP_DIV_CHECK:
		// Lower to bn_pkg__builtins__rt__DivCheck(dividend, divisor,
		// signedMin, isSigned). Operands are already 64-bit (IR-gen
		// extends them); signedMin → X2 from the carried width, isSigned
		// → X3 from BoolVal.
		if len(ins.Args) < 2 { return }
		var dividend int = getOperand(a, rm, ins.Args[0].ID)
		var divisor int = getOperand(a, rm, ins.Args[1].ID)
		if dividend < 0 || divisor < 0 { return }
		aarch64.Mov(a, true, aarch64.X0, aarch64.Reg(dividend))
		aarch64.Mov(a, true, aarch64.X1, aarch64.Reg(divisor))
		emitConstInt64(a, aarch64.X2,
			types.SignedMinForWidth(cast(int, ins.IntVal)))
		var dcSigned int = 0
		if ins.BoolVal { dcSigned = 1 }
		emitConstInt64(a, aarch64.X3, cast(int64, dcSigned))
		var dcCallee @[]char = symPrefixed("bn_pkg__builtins__rt__DivCheck")
		a.SetGlobal(dcCallee)
		aarch64.Bl(a, dcCallee)
		rm.ResetRegs()
		return
	case iropcode.OP_SHIFT_CHECK:
		// Lower to rt.ShiftCheck(count): panic if the count is negative.
		// count is already 64-bit (IR-gen sign-extends it) → X0.
		if len(ins.Args) < 1 { return }
		var scCount int = getOperand(a, rm, ins.Args[0].ID)
		if scCount < 0 { return }
		aarch64.Mov(a, true, aarch64.X0, aarch64.Reg(scCount))
		var scCallee @[]char = symPrefixed("bn_pkg__builtins__rt__ShiftCheck")
		a.SetGlobal(scCallee)
		aarch64.Bl(a, scCallee)
		rm.ResetRegs()
		return
	case iropcode.OP_JUMP:
		if ins.Block1 == nil { return }
		aarch64.B(a, blockLabel(funcSym, ins.Block1.Label))
		return
	case iropcode.OP_BRANCH:
		// Args[0] = cond, Block1 = then, Block2 = else.
		if ins.Block1 == nil || ins.Block2 == nil ||
			len(ins.Args) < 1 {
			return
		}
		var condReg int = getOperand(a, rm, ins.Args[0].ID)
		if condReg < 0 { return }
		aarch64.Cbnz(a, true, condReg,
			blockLabel(funcSym, ins.Block1.Label))
		aarch64.B(a, blockLabel(funcSym, ins.Block2.Label))
		return
	case iropcode.OP_SP_RESTORE:
		// Statement-end marker for the bytecode VM. Native-side
		// no-op: PlanFrame already sized this function's frame at
		// prologue time, and spill slots are function-scoped (not
		// statement-scoped) so there's nothing to reclaim mid-
		// function. See pkg/binate/ir.bni OP_SP_RESTORE comment for the
		// per-backend semantics.
		return
	case iropcode.OP_EXTRACT:       emitExtract(a, rm, ins);             return
	case iropcode.OP_ALLOC:         emitAlloc(a, rm, ins);               return
	case iropcode.OP_MAKE:          emitMake(a, rm, ins);                return
	case iropcode.OP_BOX:           emitBox(a, rm, ins);                 return
	case iropcode.OP_MAKE_SLICE:    emitMakeSlice(a, rm, ins);           return
	case iropcode.OP_LOAD:          emitLoad(a, pkgName, rm, ins);       return
	case iropcode.OP_STORE:         emitStore(a, pkgName, rm, ins);      return
	case iropcode.OP_GET_ELEM_PTR:  emitGetElemPtr(a, pkgName, rm, ins);  return
	case iropcode.OP_GET_FIELD_PTR: emitGetFieldPtr(a, pkgName, rm, ins); return
	}

	// Arithmetic / comparison / unary families are op-RANGES handled
	// by these guarded delegates, so they sit after the per-op switch.
	if emitCompare(a, pkgName, rm, ins) { return }
	if emitBinop(a, rm, ins) { return }
	if emitUnop(a, rm, ins) { return }

	// Any other op is a no-op in this skeleton.
}
