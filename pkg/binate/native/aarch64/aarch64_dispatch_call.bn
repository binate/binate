package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"

// emitCallInstr is emitInstr's sub-dispatcher for calls and C interop: direct,
// indirect, function-value, handle and interface-method calls, `__c_call`,
// `__c_global` / local data-symbol addresses, `__c_entry` and static function
// handles.  It reports whether ins is one of these ops (true even when a guard
// skips emitting it, e.g. a dtor handle folded into its RefDec); emitInstr
// handles any other op.
func emitCallInstr(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		ins @ir.Instr) bool {
	switch ins.Op {
	case iropcode.OP_CALL, iropcode.OP_SAT_LOOKUP:
		// OP_SAT_LOOKUP carries rt.SatLookup's name + args, so it lowers
		// exactly as that call (RTTI Slice 5b-2); only the VM diverges.
		emitCall(a, pkgName, rm, ins)
		return true
	case iropcode.OP_C_CALL:
		// __c_call: same arg-dispatch + return-collect as OP_CALL;
		// emitCall takes the verbatim C symbol from ins.StrVal (no
		// Binate mangling).  An aggregate return uses the same sret /
		// register-coerce arms as OP_CALL — Binate's internal
		// aggregate-return convention is pinned to the C ABI, so the
		// generic collect handles a C-returned struct directly.
		emitCall(a, pkgName, rm, ins)
		return true
	case iropcode.OP_C_GLOBAL:
		// __c_global yields the ADDRESS of an external C global (a raw *T).
		// Under this PIE target the datum lives in another DSO (e.g. libc's
		// `environ`), so it is reached GOT-indirect: ADRP the GOT-slot page,
		// LDR the slot's contents (the symbol's real address) into rd.  The
		// symbol is verbatim (no Binate mangling).
		emitCGlobalAddr(a, nextReg(rm, ins.ID), ins.StrVal)
		return true
	case iropcode.OP_DATA_SYM_ADDR:
		// Address of a LOCAL weak Binate data global (e.g. __typeinfo/__ifaceid).
		// Unlike OP_C_GLOBAL this symbol is defined in-module, so it is reached by
		// the plain ADRP+ADD pair (the vtable-slot path), NOT a GOT-indirect load.
		var symLabel @[]char = symPrefixed(ins.StrVal)
		a.SetGlobal(symLabel)
		var rd int = nextReg(rm, ins.ID)
		aarch64.Adrp(a, rd, symLabel)
		aarch64.AddImmLabel(a, true, rd, rd, symLabel)
		return true
	case iropcode.OP_C_ENTRY:
		// __c_entry(f): the ADDRESS of f's C entry as a raw *uint8, for handing f to
		// C as a callback.  The mangled entry directly when the args are all
		// pointer/word-size/float/aggregate; otherwise the weak `__centry.<mangled>`
		// adaptation thunk (ins.CEntryThunk, set by common.EmitObject for a narrow
		// GP integer/bool argument).  See emitCEntryAddr.
		emitCEntryAddr(a, pkgName, nextReg(rm, ins.ID), ins.StrVal, ins.CEntryThunk)
		return true
	case iropcode.OP_CALL_INDIRECT:
		emitCallIndirect(a, pkgName, rm, ins)
		return true
	case iropcode.OP_CALL_FUNC_VALUE:
		emitCallFuncValue(a, pkgName, rm, ins)
		return true
	case iropcode.OP_FUNC_HANDLE:
		// Produce a *uint8
		// pointing at the static `___handle.<mangled>` global — a
		// 16-byte {vtable_ptr, data_ptr} aggregate whose data slot is
		// null (non-capturing).  Consumed by OP_CALL_HANDLE.  Mirrors
		// the LLVM lowering in pkg/binate/codegen/emit_instr.bn.
		if len(ins.StrVal) == 0 { return true }
		// A dtor handle whose only use is an inline RefDec is materialized in
		// that RefDec's slow path (past the refcount zero-test) instead, so it
		// runs only on the branch that frees.  Skip the standalone emission.
		if rm.IsFoldedDtorHandle(ins.ID) { return true }
		emitFuncHandleAddr(a, pkgName, nextReg(rm, ins.ID), ins.StrVal)
		return true
	case iropcode.OP_CALL_HANDLE:
		// Phase 4 dispatch: call through a 16-byte handle.  Identical
		// shape to OP_CALL_FUNC_VALUE — the handle and a constructed
		// function value have the same `{vtable_ptr, data_ptr}` layout
		// and the same "load vtable.call, call(data, args)" sequence.
		emitCallFuncValue(a, pkgName, rm, ins)
		return true
	case iropcode.OP_CALL_IFACE_METHOD:
		emitCallIfaceMethod(a, pkgName, rm, ins)
		return true
	}
	return false
}
