package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/builtins/testing"

// emitCallInstr claims its ops: OP_C_ENTRY lowers to ADRP+ADD (8 bytes), and an
// OP_FUNC_HANDLE with no symbol is claimed but emits nothing (its guard).
func TestEmitCallInstrClaimsItsOps() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_C_ENTRY
	ins.StrVal = "main.cmp"
	if !emitCallInstr(a, "main", rm, ins) { return fail("OP_C_ENTRY should be claimed") }
	if a.HasError || bytesWritten(a) != 8 { return fail("OP_C_ENTRY should emit ADRP+ADD (8 bytes)") }
	var b @asm.Assembler = mkAsm()
	var h @ir.Instr = make(ir.Instr)
	h.ID = 1
	h.Op = iropcode.OP_FUNC_HANDLE
	if !emitCallInstr(b, "main", rm, h) { return fail("OP_FUNC_HANDLE should be claimed") }
	if bytesWritten(b) != 0 { return fail("a symbol-less OP_FUNC_HANDLE should emit nothing") }
	return ""
}

// emitCallInstr declines every op outside its family, emitting nothing, so
// emitInstr lowers it instead.
func TestEmitCallInstrDeclinesOtherOps() testing.TestResult {
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	var ops @[]int = make_slice(int, 4)
	ops[0] = iropcode.OP_JUMP
	ops[1] = iropcode.OP_LOAD
	ops[2] = iropcode.OP_IFACE_VALUE
	ops[3] = iropcode.OP_CONST_INT
	for i := 0; i < len(ops); i++ {
		var a @asm.Assembler = mkAsm()
		var ins @ir.Instr = make(ir.Instr)
		ins.Op = ops[i]
		if emitCallInstr(a, "main", rm, ins) { return fail("a non-call op must be declined") }
		if a.HasError || bytesWritten(a) != 0 { return fail("a declined op must emit nothing") }
	}
	return ""
}
