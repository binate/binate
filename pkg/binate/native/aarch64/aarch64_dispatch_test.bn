package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Coverage for arm64_dispatch.bn — emitInstr is the per-instruction
// selector that fans out to all the op-family handlers (alloc, call,
// load/store, refcount, etc.). Most coverage is end-to-end via
// EmitObject + clang round-trips like the test below; per-handler
// unit tests live in arm64_ops_test.bn / arm64_call_test.bn /
// arm64_emit_test.bn alongside their handlers.

// Build a program equivalent to `__c_call("exit", 42)` and verify it
// links with the C runtime and that the resulting process exits 42.
// Exercises emitInstr's OP_CONST_INT + OP_C_CALL + OP_RETURN arms,
// plus the prologue/epilogue glue that wraps the dispatcher.
// Helpers (canLinkAndRun, fail) live in arm64_test.bn — same package,
// shared scope.
func TestEmitCallExitsWithCode() testing.TestResult {
	if !canLinkAndRun() { return "" }

	var m @ir.Module = ir.NewModule("\"main\"")
	// Export the entry as `main` — the unmangled `_main` global via symPrefixed —
	// so the host crt0 calls it directly and the object links with no C runtime
	// or startup shim.
	var f @ir.Func = ir.NewFunc("", "__entry", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")

	// v0 = 42 : int
	var c42 @ir.Instr = b.EmitConstInt(42, types.TypInt())
	// call exit(v0) via __c_call — void return
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = c42
	b.EmitCCall("exit", args, nil, 1)
	b.EmitReturn(noArgs)
	var ce @[]@[]char = make_slice(@[]char, 1)
	ce[0] = buf.CopyStr("main")
	f.CExportNames = ce
	m.AddFunc(f)

	var objPath *[]readonly char = "/tmp/binate_native_exit42.o"
	if !EmitObject(m, "macho", objPath) { return fail("EmitObject returned false") }

	var exePath *[]readonly char = "/tmp/binate_native_exit42"
	var largs @[]@[]char = make_slice(@[]char, 4)
	largs[0] = "-w"
	largs[1] = "-o"
	largs[2] = buf.CopyStr(exePath)
	largs[3] = buf.CopyStr(objPath)
	if execExit("clang", largs) != 0 {
		return fail("clang link failed")
	}

	var runArgs @[]@[]char = make_slice(@[]char, 0)
	var rc int = execExit(exePath, runArgs)
	if rc != 42 {
		return fail("expected exit 42")
	}
	return ""
}

// emitInstr's OP_SP_RESTORE arm is a deliberate no-op on the native
// backend: PlanFrame already sized this function's frame at prologue
// time and spill slots are function-scoped, so there's nothing to
// reclaim mid-function. Pin the byte count: an OP_SP_RESTORE Instr
// must produce ZERO bytes of code (otherwise we'd be silently
// corrupting the surrounding instruction stream). Helpers (mkAsm,
// bytesWritten) live in arm64_emit_test.bn — same package.
func TestEmitSPRestoreNativeNoop() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_SP_RESTORE
	var noStrings @[]ir.StringConst
	emitInstr(a, "main", "fn", rm, noStrings, ins)
	if bytesWritten(a) != 0 {
		return fail("OP_SP_RESTORE must emit zero bytes on native arm64")
	}
	return ""
}

// OP_COPY (emitted by ir.EliminatePhis) lowers to a reg-to-reg move, not the
// unimplemented-op fail-loud.
func TestEmitCopyIsMove() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_COPY
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	var noStrings @[]ir.StringConst
	emitInstr(a, "main", "fn", rm, noStrings, ins)
	if a.HasError {
		return fail("OP_COPY must lower to a move, not fail-loud")
	}
	if bytesWritten(a) == 0 {
		return fail("OP_COPY should emit a move")
	}
	return ""
}

// emitInstr's OP_NIL_CHECK arm is a deliberate native no-op: opt-in nil-checking
// is a VM/REPL recovery aid, and native code stays
// C-like (a nil deref is UB/SEGV).  Pin the byte count at zero, mirroring the
// OP_SP_RESTORE no-op above.
func TestEmitNilCheckNativeNoop() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_NIL_CHECK
	var noStrings @[]ir.StringConst
	emitInstr(a, "main", "fn", rm, noStrings, ins)
	if bytesWritten(a) != 0 {
		return fail("OP_NIL_CHECK must emit zero bytes on native arm64")
	}
	return ""
}

// OP_UNREACHABLE (terminator after a non-falling-through block) is a legitimate
// explicit native no-op — control never reaches it in a correct program, and
// aarch64 has no trap emitter here. It must NOT reach the fail-loud tail.
func TestEmitUnreachableNativeNoop() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_UNREACHABLE
	var noStrings @[]ir.StringConst
	emitInstr(a, "main", "fn", rm, noStrings, ins)
	if a.HasError {
		return fail("OP_UNREACHABLE must be an explicit no-op, not fail loud")
	}
	if bytesWritten(a) != 0 {
		return fail("OP_UNREACHABLE must emit zero bytes on native arm64")
	}
	return ""
}

// An op the arm64 backend does not implement (OP_UNWIND_RETURN — a VM-only
// non-local return the native backend never emits) must FAIL LOUD (SetError ->
// EmitObject false -> bnc compile error), not silently emit nothing (which would
// let a program using it miscompile). Pins the fail-loud dispatch tail.
func TestEmitInstrUnimplementedOpFailsLoud() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_UNWIND_RETURN
	var noStrings @[]ir.StringConst
	emitInstr(a, "main", "fn", rm, noStrings, ins)
	if !a.HasError {
		return fail("an unimplemented op must fail loud (SetError), not silently drop")
	}
	return ""
}

// OP_C_ENTRY (__c_entry(f)) materializes the address of f's LOCAL mangled entry
// into the result register via the ADRP+ADD pair (8 bytes), with no error and no
// GOT-indirect load — the degenerate C-callback-pointer lowering.
func TestEmitInstrCEntryMaterializesLocalAddr() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_C_ENTRY
	ins.StrVal = "main.cmp"
	var noStrings @[]ir.StringConst
	emitInstr(a, "main", "fn", rm, noStrings, ins)
	if a.HasError {
		return fail("OP_C_ENTRY should not fail on a valid function reference")
	}
	if bytesWritten(a) != 8 {
		return fail("OP_C_ENTRY should emit ADRP+ADD (8 bytes)")
	}
	if rm.LookupReg(0) < 0 {
		return fail("OP_C_ENTRY should assign the SSA id a result reg")
	}
	return ""
}
