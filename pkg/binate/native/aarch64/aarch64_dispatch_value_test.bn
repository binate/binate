package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/builtins/testing"

// emitValueInstr claims its ops: an OP_IFACE_VALUE with no data operand is
// claimed but emits nothing (its guard).
func TestEmitValueInstrClaimsItsOps() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_IFACE_VALUE
	ins.StrVal = "__ivt.x"
	if !emitValueInstr(a, "main", rm, ins) { return fail("OP_IFACE_VALUE should be claimed") }
	if a.HasError || bytesWritten(a) != 0 {
		return fail("an operand-less OP_IFACE_VALUE should emit nothing")
	}
	return ""
}

// emitValueInstr declines every op outside its family, emitting nothing, so
// emitInstr lowers it instead.
func TestEmitValueInstrDeclinesOtherOps() testing.TestResult {
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	var ops @[]int = make_slice(int, 4)
	ops[0] = iropcode.OP_JUMP
	ops[1] = iropcode.OP_LOAD
	ops[2] = iropcode.OP_CALL
	ops[3] = iropcode.OP_CAST
	for i := 0; i < len(ops); i++ {
		var a @asm.Assembler = mkAsm()
		var ins @ir.Instr = make(ir.Instr)
		ins.Op = ops[i]
		if emitValueInstr(a, "main", rm, ins) { return fail("a non-value op must be declined") }
		if a.HasError || bytesWritten(a) != 0 { return fail("a declined op must emit nothing") }
	}
	return ""
}
