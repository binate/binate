package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Op handlers extracted from emitInstr's dispatcher. Each function
// corresponds to one IR opcode; emitInstr just matches ins.Op and
// delegates. Kept in a separate file because the bodies were pushing
// arm64.bn past the file-length soft limit.

// emitAlloc: OP_ALLOC — aggregate allocas zero-init their storage to
// match LLVM's `store ... zeroinitializer`. Scalar allocas are
// uninitialized; the following STORE fills them.
func emitAlloc(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if common.IsAggregateTyp(ins.TypeArg) {
		var off int = rm.LookupAlloc(ins.ID)
		var sz int = rm.LookupAllocSize(ins.ID)
		if off >= 0 && sz > 0 {
			for bo := 0; bo < sz; bo = bo + 8 {
				aarch64.Str(a, true, aarch64.XZR,
					aarch64.MemImm(aarch64.SP, off + bo))
			}
		}
	}
}

// emitConstNil: OP_CONST_NIL — aggregate nil (nil slice, zero struct)
// zero-inits its data region and produces a pointer. Scalar nil is
// simply 0.
func emitConstNil(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if common.IsAggregateTyp(ins.Typ) {
		var dataOff int = rm.LookupAlloc(ins.ID)
		var sz int = rm.LookupAllocSize(ins.ID)
		if dataOff >= 0 && sz > 0 {
			for bo := 0; bo < sz; bo = bo + 8 {
				aarch64.Str(a, true, aarch64.XZR,
					aarch64.MemImm(aarch64.SP, dataOff + bo))
			}
			var rd int = nextReg(rm, ins.ID)
			aarch64.Add(a, true, rd, aarch64.SP,
				aarch64.Imm(dataOff))
			return
		}
	}
	var rd int = nextReg(rm, ins.ID)
	aarch64.Movz(a, true, rd, 0, 0)
}

// emitStringToCharsCopy: Stage 2b lowering. Allocates a fresh
// managed-slice via the runtime, then writes the literal bytes
// inline into the new backing. Sequence:
//
//   X0 = 1, X1 = strLen, X8 = &data_region (sret buffer)
//   bl _bn_pkg__builtins__rt__MakeManagedSlice  → writes 32-byte slice header
//                                         via X8 into data_region
//   X0 = LDR data_region[0]           (data ptr — first word of slice header)
//   ; per-byte: emitConstInt64 X9, <byte_value>; STRB W9, [X0, #i]
//   ADD rd, SP, #data_region          (produce aggregate pointer)
//
// Inline byte stores instead of a libc.Memcpy call keeps the
// generated machine code free of any libc memory primitive — see
// explorations/plan-codegen-c-free-copies.md step 6.  Same shape
// as the LLVM-codegen-side step 4 change.
func emitStringToCharsCopy(a @asm.Assembler, rm @common.RegMap,
	ins @ir.Instr, bytes @[]char) {
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	var strLen int = len(bytes)

	emitConstInt64(a, aarch64.X0, 1)
	emitConstInt64(a, aarch64.X1, cast(int64, strLen))
	aarch64.Add(a, true, aarch64.X8, aarch64.SP, aarch64.Imm(dataOff))
	var mkSym @[]char = symPrefixed("bn_pkg__builtins__rt__MakeManagedSlice")
	a.SetGlobal(mkSym)
	aarch64.Bl(a, mkSym)
	// Reload the data pointer (first word of the slice header) from
	// the data region — destination of the inline byte writes below.
	aarch64.Ldr(a, true, aarch64.X0,
		aarch64.MemImm(aarch64.SP, dataOff))
	emitInlineByteStoresAA64(a, aarch64.X0, bytes, strLen)
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
}

// emitStringToArray: OP_RODATA_ARRAY. `var s [N]char = "..."`
// allocates a fresh N-byte buffer in the data region, zeroes it,
// then memcpys the first strLen bytes from rodata into the head.
// strLen is enforced ≤ N at IR-gen time. Result is a pointer to the
// buffer; downstream OP_STORE struct-copy memcpys it into the
// destination alloca.
func emitStringToArray(a @asm.Assembler, rm @common.RegMap,
	ins @ir.Instr) {
	var bytes @[]char = ins.StrVal
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	var arrLen int = 0
	if ins.Typ != nil && ins.Typ.Kind == types.TYP_ARRAY {
		arrLen = ins.Typ.ArrayLen
	}
	if arrLen <= 0 { return }
	var strLen int = len(bytes)
	if strLen > arrLen { strLen = arrLen }

	// Zero-fill the entire reserved buffer (rounded up to 8 bytes by
	// PlanFrame) in 64-bit chunks. Covers the tail past strLen and
	// keeps any padding bytes deterministic.
	var bufSz int = rm.LookupAllocSize(ins.ID)
	var i int = 0
	for i < bufSz {
		aarch64.Str(a, true, aarch64.XZR,
			aarch64.MemImm(aarch64.SP, dataOff + i))
		i = i + 8
	}
	if strLen > 0 {
		aarch64.Add(a, true, aarch64.X0, aarch64.SP,
			aarch64.Imm(dataOff))
		emitInlineByteStoresAA64(a, aarch64.X0, bytes, strLen)
	}
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
}

// emitInlineByteStoresAA64 emits a per-byte store sequence:
//
//   movz w9, #<byte0>
//   strb w9, [<base>, #0]
//   movz w9, #<byte1>
//   strb w9, [<base>, #1]
//   ...
//
// Used by emitStringToCharsCopy / emitStringToArray to write a
// string literal's bytes into the dst buffer inline, instead of
// calling `bn_pkg__builtins__libc__Memcpy`.  X9 is the scratch register; the
// SysV/AAPCS64 ABI lets caller-saved temporaries use X9..X15
// freely after any call has returned, and we're past the call
// here.
func emitInlineByteStoresAA64(a @asm.Assembler, base int,
	data @[]char, count int) {
	for i := 0; i < count; i++ {
		var b int = 0
		if i < len(data) { b = cast(int, data[i]) }
		emitConstInt64(a, aarch64.X9, cast(int64, b))
		aarch64.Strb(a, aarch64.X9,
			aarch64.MemImm(base, i))
	}
}

// emitRodataMSliceOrSlice: OP_RODATA_MSLICE / OP_RODATA_SLICE —
// same lowering as OP_STRING_TO_CHARS but the byte sequence comes
// directly from `ins.StrVal` (no Args[0]).
func emitRodataMSliceOrSlice(a @asm.Assembler, rm @common.RegMap,
	strings @[]ir.StringConst, ins @ir.Instr) {
	emitRodataSliceHeader(a, rm, strings, ins, ins.StrVal, ins.Typ)
}

// emitRodataSliceHeader writes a slice header pointing at the
// shared rodata global for `bytes`. For managed-slice targets the
// 4-word header gets refptr=0 + backingLen=0 (RefInc/RefDec no-op
// on null refptr). For raw-slice targets only the {data, len}
// prefix is written.
func emitRodataSliceHeader(a @asm.Assembler, rm @common.RegMap,
	strings @[]ir.StringConst, ins @ir.Instr,
	bytes @[]char, sliceTyp @types.Type) {
	var sid int = ir.FindStringID(strings, bytes)
	if sid < 0 { return }
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	var dataReg int = scratchReg(rm)
	aarch64.Adrp(a, dataReg, stringLabel(sid))
	aarch64.AddImmLabel(a, true, dataReg, dataReg, stringLabel(sid))
	aarch64.Str(a, true, dataReg,
		aarch64.MemImm(aarch64.SP, dataOff))
	var lenReg int = scratchReg(rm)
	emitConstInt64(a, lenReg, cast(int64, len(bytes)))
	aarch64.Str(a, true, lenReg,
		aarch64.MemImm(aarch64.SP, dataOff + 8))
	if sliceTyp != nil && sliceTyp.Kind == types.TYP_MANAGED_SLICE {
		aarch64.Str(a, true, aarch64.XZR,
			aarch64.MemImm(aarch64.SP, dataOff + 16))
		aarch64.Str(a, true, aarch64.XZR,
			aarch64.MemImm(aarch64.SP, dataOff + 24))
	}
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
}

// emitMake: OP_MAKE — call bn_pkg__builtins__rt__Alloc(SizeOf(T)) for a fresh
// zero-initialized @T with refcount=1.
func emitMake(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if ins.TypeArg == nil { return }
	emitConstInt64(a, aarch64.X0, cast(int64, ins.TypeArg.SizeOf()))
	var callee @[]char = symPrefixed("bn_pkg__builtins__rt__Alloc")
	a.SetGlobal(callee)
	aarch64.Bl(a, callee)
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	aarch64.Mov(a, true, rd, aarch64.Reg(aarch64.X0))
}

// emitBox: OP_BOX — call bn_pkg__builtins__rt__Box(srcPtr, size) to heap-copy val.
// Two source shapes are handled:
//
//   OP_ALLOC — the alloca's stack address is srcPtr; size comes from
//   val.TypeArg.
//
//   Aggregate Load / Extract / etc. — the operand's spill slot holds
//   a pointer to the data (see common.SpillHoldsAggregatePointer);
//   use that pointer directly as srcPtr.  Required so `box(iv)` for a
//   loaded iv (`*I` / `@I`) actually emits the heap-copy call.
//   Before this branch, the early-return for non-OP_ALLOC operands
//   left p uninitialized and `(*p).Foo()` dispatched through a stack
//   alias instead of a heap iv — see conformance 444 / 445 / 450 /
//   458 (all `@(*I)` / `@(@I)` cases that used to xfail aa64-native).
func emitBox(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var val @ir.Instr = ins.Args[0]
	var sz int = 0
	if val.Op == ir.OP_ALLOC && val.TypeArg != nil {
		var allocOff int = rm.LookupAlloc(val.ID)
		if allocOff < 0 { return }
		aarch64.Add(a, true, aarch64.X0, aarch64.SP,
			aarch64.Imm(allocOff))
		sz = val.TypeArg.SizeOf()
	} else if common.IsAggregateTyp(val.Typ) {
		var src int = getOperand(a, rm, val.ID)
		if src < 0 { return }
		aarch64.Mov(a, true, aarch64.X0, aarch64.Reg(src))
		sz = val.Typ.SizeOf()
	} else {
		// Scalar / unhandled — no emit, matches the previous
		// silent-return behavior so non-Box callers don't regress.
		return
	}
	emitConstInt64(a, aarch64.X1, cast(int64, sz))
	var callee @[]char = symPrefixed("bn_pkg__builtins__rt__Box")
	a.SetGlobal(callee)
	aarch64.Bl(a, callee)
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	aarch64.Mov(a, true, rd, aarch64.Reg(aarch64.X0))
}

// emitMakeSlice: OP_MAKE_SLICE — call bn_pkg__builtins__rt__MakeManagedSlice. The
// LLVM-compiled runtime follows AAPCS-C: the 32-byte ManagedSlice
// return is materialized through the X8 sret pointer.  We hand it
// the data region reserved by common.PlanFrame and produce a pointer
// to that region.
func emitMakeSlice(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 || ins.TypeArg == nil { return }
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	emitConstInt64(a, aarch64.X0, cast(int64, ins.TypeArg.SizeOf()))
	var lenReg int = getOperand(a, rm, ins.Args[0].ID)
	if lenReg < 0 { return }
	aarch64.Mov(a, true, aarch64.X1, aarch64.Reg(lenReg))
	aarch64.Add(a, true, aarch64.X8, aarch64.SP, aarch64.Imm(dataOff))
	var callee @[]char = symPrefixed("bn_pkg__builtins__rt__MakeManagedSlice")
	a.SetGlobal(callee)
	aarch64.Bl(a, callee)
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
}

// emitExtract: OP_EXTRACT — read ins.Index-th field of an aggregate
// SSA value. Multi-return calls keep the tuple bytes directly in the
// spill slot; everything else aggregate-typed keeps a pointer in
// the spill slot and indirects through it.
//
// The field offset is tuple.FieldOffset(Index) — NOT 8*Index
// — because tuple fields can themselves be aggregates (e.g. a
// `(Tab, int)` multi-return where Tab is 5 words). For scalar
// fields we LDR the value; for aggregate fields we produce an
// address (ADD) so downstream OP_STORE struct-copy can memcpy from it.
func emitExtract(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var src @ir.Instr = ins.Args[0]
	var rd int = nextReg(rm, ins.ID)
	var fieldOff int = 8 * ins.Index
	if src.Typ != nil && src.Typ.Kind == types.TYP_STRUCT {
		fieldOff = src.Typ.FieldOffset(ins.Index)
	}
	// Scalar fields size-dispatch through emitScalarLoad: a 64-bit
	// LDR on a sub-word field would either pull in adjacent field
	// bits (when fields share an 8-byte slot, like uint32+uint32)
	// or run off the end of the spill slot. Aggregates pass through
	// as a pointer (ADD).
	var sz int = 8
	if ins.Typ != nil { sz = ins.Typ.SizeOf() }
	if sz <= 0 { sz = 8 }
	var signed bool = ins.Typ != nil && ins.Typ.Signed
	if common.SpillHoldsAggregatePointer(src) {
		var ptr int = getOperand(a, rm, src.ID)
		if ptr < 0 { return }
		if common.IsAggregateTyp(ins.Typ) {
			aarch64.Add(a, true, rd, ptr,
				aarch64.Imm(fieldOff))
		} else {
			emitScalarLoad(a, rd, ptr, fieldOff, sz, signed)
		}
		return
	}
	var srcSlot int = rm.LookupSpill(src.ID)
	if srcSlot < 0 { return }
	if common.IsAggregateTyp(ins.Typ) {
		aarch64.Add(a, true, rd, aarch64.SP,
			aarch64.Imm(srcSlot + fieldOff))
	} else {
		emitScalarLoad(a, rd, aarch64.SP, srcSlot + fieldOff, sz,
			signed)
	}
}

// emitLoad: OP_LOAD — aggregate loads pass a pointer through (LLVM's
// LOAD+STORE struct-copy idiom); scalar loads size-dispatch to
// LDRB/LDRH/LDR so a char read doesn't pull in 7 bytes of neighbors.
// Package-level globals are reached via ADRP+ADD to the __DATA symbol.
func emitLoad(a @asm.Assembler, pkgName *[]readonly char,
	rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var arg @ir.Instr = ins.Args[0]
	if common.IsAggregateTyp(ins.Typ) {
		var rd int = nextReg(rm, ins.ID)
		var allocOff int = rm.LookupAlloc(arg.ID)
		if allocOff >= 0 {
			aarch64.Add(a, true, rd, aarch64.SP,
				aarch64.Imm(allocOff))
			return
		}
		if isGlobalRef(arg) {
			emitGlobalAddr(a, pkgName, rd, arg)
			return
		}
		var src int = getOperand(a, rm, arg.ID)
		if src < 0 { return }
		aarch64.Mov(a, true, rd, aarch64.Reg(src))
		return
	}
	var sz int = 8
	if ins.Typ != nil { sz = ins.Typ.SizeOf() }
	if sz <= 0 { sz = 8 }
	var signed bool = ins.Typ != nil && ins.Typ.Signed
	var off int = rm.LookupAlloc(arg.ID)
	if off >= 0 {
		var rd int = nextReg(rm, ins.ID)
		emitScalarLoad(a, rd, aarch64.SP, off, sz, signed)
		return
	}
	if isGlobalRef(arg) {
		var addr int = scratchReg(rm)
		emitGlobalAddr(a, pkgName, addr, arg)
		var rd int = nextReg(rm, ins.ID)
		emitScalarLoad(a, rd, addr, 0, sz, signed)
		return
	}
	var ptr int = getOperand(a, rm, arg.ID)
	if ptr < 0 { return }
	var rd int = nextReg(rm, ins.ID)
	emitScalarLoad(a, rd, ptr, 0, sz, signed)
}

// emitStore: OP_STORE — aggregate stores memcpy via emitStructCopy;
// scalar stores size-dispatch to STRB/STRH/STR so a char write
// touches one byte rather than clobbering seven neighbors. For a
// global destination, ADRP+ADD to the __DATA symbol first.
func emitStore(a @asm.Assembler, pkgName *[]readonly char,
	rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	if common.IsAggregateTyp(ins.Args[1].Typ) {
		emitStructCopy(a, pkgName, rm, ins)
		return
	}
	var sz int = 8
	if ins.Args[1].Typ != nil { sz = ins.Args[1].Typ.SizeOf() }
	if sz <= 0 { sz = 8 }
	var off int = rm.LookupAlloc(ins.Args[0].ID)
	var valReg int = getOperand(a, rm, ins.Args[1].ID)
	if valReg < 0 { return }
	if off >= 0 {
		emitScalarStore(a, valReg, aarch64.SP, off, sz)
		return
	}
	if isGlobalRef(ins.Args[0]) {
		var addr int = scratchReg(rm)
		emitGlobalAddr(a, pkgName, addr, ins.Args[0])
		emitScalarStore(a, valReg, addr, 0, sz)
		return
	}
	var ptr int = getOperand(a, rm, ins.Args[0].ID)
	if ptr < 0 { return }
	emitScalarStore(a, valReg, ptr, 0, sz)
}

// emitGetElemPtr: OP_GET_ELEM_PTR — compute base + idx*elemSize. The
// GEP's Typ is *elemTyp regardless of whether the base came from array
// indexing or from a slice whose data pointer was already extracted.
// A package-level global base is reached via ADRP+ADD.
func emitGetElemPtr(a @asm.Assembler, pkgName *[]readonly char,
	rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	var elemSize int = common.ElemSizeOf(ins)
	if elemSize <= 0 { return }
	var idx int = getOperand(a, rm, ins.Args[1].ID)
	if idx < 0 { return }

	var sizeTmp int = scratchReg(rm)
	aarch64.Movz(a, true, sizeTmp, elemSize, 0)
	var byteOff int = scratchReg(rm)
	aarch64.Mul(a, true, byteOff, idx, sizeTmp)

	var rd int = nextReg(rm, ins.ID)
	var allocOff int = rm.LookupAlloc(ins.Args[0].ID)
	if allocOff >= 0 {
		aarch64.Add(a, true, rd, aarch64.SP,
			aarch64.Imm(allocOff))
		aarch64.Add(a, true, rd, rd, aarch64.Reg(byteOff))
		return
	}
	if isGlobalRef(ins.Args[0]) {
		emitGlobalAddr(a, pkgName, rd, ins.Args[0])
		aarch64.Add(a, true, rd, rd, aarch64.Reg(byteOff))
		return
	}
	var base int = getOperand(a, rm, ins.Args[0].ID)
	if base < 0 { return }
	aarch64.Add(a, true, rd, base, aarch64.Reg(byteOff))
}

// emitGetFieldPtr: OP_GET_FIELD_PTR — compute base + FieldOffset.
// A package-level global base is reached via ADRP+ADD. Slice bases
// (raw or managed) get a flat 8*Index offset — fields are
// data, len, [refptr, backingLen] in word-sized slots, matching
// types.SliceDataOffset / MSliceDataOffset etc.
func emitGetFieldPtr(a @asm.Assembler, pkgName *[]readonly char,
	rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var fieldOff int
	var baseTyp @types.Type = common.StructTypeOf(ins.Args[0])
	if baseTyp != nil {
		fieldOff = baseTyp.FieldOffset(ins.Index)
	} else if isSliceFieldBase(ins.Args[0]) {
		fieldOff = 8 * ins.Index
	} else {
		return
	}
	var rd int = nextReg(rm, ins.ID)
	var allocOff int = rm.LookupAlloc(ins.Args[0].ID)
	if allocOff >= 0 {
		aarch64.Add(a, true, rd, aarch64.SP,
			aarch64.Imm(allocOff + fieldOff))
		return
	}
	if isGlobalRef(ins.Args[0]) {
		emitGlobalAddr(a, pkgName, rd, ins.Args[0])
		if fieldOff != 0 {
			aarch64.Add(a, true, rd, rd, aarch64.Imm(fieldOff))
		}
		return
	}
	var ptr int = getOperand(a, rm, ins.Args[0].ID)
	if ptr < 0 { return }
	aarch64.Add(a, true, rd, ptr, aarch64.Imm(fieldOff))
}
