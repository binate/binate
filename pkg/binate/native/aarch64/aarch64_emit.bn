package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Op handlers extracted from emitInstr's dispatcher. Each function
// corresponds to one IR opcode; emitInstr just matches ins.Op and
// delegates. Kept in a separate file because the bodies were pushing
// arm64.bn past the file-length soft limit.

// emitAlloc: OP_ALLOC — aggregate allocas zero-init their storage to
// match LLVM's `store ... zeroinitializer`. Scalar allocas are
// uninitialized; the following STORE fills them.
func emitAlloc(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if common.IsAggregateTyp(ins.TypeArg) {
		var off int = rm.LookupAlloc(ins.ID)
		var sz int = rm.LookupAllocSize(ins.ID)
		if off >= 0 && sz > 0 {
			for bo := 0; bo < sz; bo = bo + 8 {
				aarch64.Str(a, true, aarch64.XZR, aarch64.MemImm(aarch64.SP, off + bo))
			}
		}
	}
}

// emitConstNil: OP_CONST_NIL — aggregate nil (nil slice, zero struct)
// zero-inits its data region and produces a pointer. Scalar nil is
// simply 0.
func emitConstNil(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if common.IsAggregateTyp(ins.Typ) {
		var dataOff int = rm.LookupAlloc(ins.ID)
		var sz int = rm.LookupAllocSize(ins.ID)
		if dataOff >= 0 && sz > 0 {
			for bo := 0; bo < sz; bo = bo + 8 {
				aarch64.Str(a, true, aarch64.XZR, aarch64.MemImm(aarch64.SP, dataOff + bo))
			}
			var rd int = nextReg(rm, ins.ID)
			aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
			return
		}
	}
	var rd int = nextReg(rm, ins.ID)
	aarch64.Movz(a, true, rd, 0, 0)
}

// emitMake: OP_MAKE — call `rt.Alloc`(SizeOf(T)) for a fresh
// zero-initialized @T with refcount=1.
func emitMake(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if ins.TypeArg == nil { return }
	emitConstInt64(a, aarch64.X0, cast(int64, ins.TypeArg.SizeOf()))
	var callee @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "Alloc"))
	a.SetGlobal(callee)
	aarch64.Bl(a, callee)
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	aarch64.Mov(a, true, rd, aarch64.Reg(aarch64.X0))
}

// emitBox: OP_BOX — call `rt.Box`(srcPtr, size) to heap-copy val.
// Two source shapes are handled:
//
//   OP_ALLOC — the alloca's stack address is srcPtr; size comes from
//   val.TypeArg.
//
//   Aggregate Load / Extract / etc. — the operand's spill slot holds
//   a pointer to the data (see common.SpillHoldsAggregatePointer);
//   use that pointer directly as srcPtr.  Required so `box(iv)` for a
//   loaded iv (`*I` / `@I`) actually emits the heap-copy call.
//   Before this branch, the early-return for non-OP_ALLOC operands
//   left p uninitialized and `(*p).Foo()` dispatched through a stack
//   alias instead of a heap iv — see conformance 444 / 445 / 450 /
//   458 (all `@(*I)` / `@(@I)` cases that used to xfail aa64-native).
func emitBox(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var val @ir.Instr = ins.Args[0]
	var sz int = 0
	if val.Op == iropcode.OP_ALLOC && val.TypeArg != nil {
		var allocOff int = rm.LookupAlloc(val.ID)
		if allocOff < 0 { return }
		aarch64.Add(a, true, aarch64.X0, aarch64.SP, aarch64.Imm(allocOff))
		sz = val.TypeArg.SizeOf()
	} else if common.IsAggregateTyp(val.Typ) {
		var src int = getOperand(a, rm, val.ID)
		if src < 0 { return }
		aarch64.Mov(a, true, aarch64.X0, aarch64.Reg(src))
		sz = val.Typ.SizeOf()
	} else if val.Typ != nil {
		// Scalar source: spill the value into its frame slot, then box from
		// that slot's address (rt.Box copies SizeOf(T) bytes from it).  Mirrors
		// the LLVM scalar path (codegen/emit_helpers.bn) without an extra
		// alloca — every non-void value already has a spill slot (PlanFrame),
		// reused for the function's lifetime so a box() in a loop doesn't grow
		// the native stack per iteration.
		var src int = getOperand(a, rm, val.ID)
		if src < 0 { return }
		var off int = rm.LookupSpill(val.ID)
		if off < 0 { return }
		aarch64.Str(a, true, src, aarch64.MemImm(aarch64.SP, off))
		aarch64.Add(a, true, aarch64.X0, aarch64.SP, aarch64.Imm(off))
		sz = val.Typ.SizeOf()
	} else {
		// No type info — cannot size the copy; leave unhandled.
		return
	}
	emitConstInt64(a, aarch64.X1, cast(int64, sz))
	var callee @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "Box"))
	a.SetGlobal(callee)
	aarch64.Bl(a, callee)
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	aarch64.Mov(a, true, rd, aarch64.Reg(aarch64.X0))
}

// emitMakeSlice: OP_MAKE_SLICE — call `rt.MakeManagedSlice`. The
// LLVM-compiled runtime follows AAPCS-C: the 32-byte ManagedSlice
// return is materialized through the X8 sret pointer.  We hand it
// the data region reserved by common.PlanFrame and produce a pointer
// to that region.
func emitMakeSlice(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 || ins.TypeArg == nil { return }
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	emitConstInt64(a, aarch64.X0, cast(int64, ins.TypeArg.SizeOf()))
	var lenReg int = getOperand(a, rm, ins.Args[0].ID)
	if lenReg < 0 { return }
	aarch64.Mov(a, true, aarch64.X1, aarch64.Reg(lenReg))
	aarch64.Add(a, true, aarch64.X8, aarch64.SP, aarch64.Imm(dataOff))
	var callee @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "MakeManagedSlice"))
	a.SetGlobal(callee)
	aarch64.Bl(a, callee)
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
}

// emitExtract: OP_EXTRACT — read ins.Index-th field of an aggregate
// SSA value. Multi-return calls keep the tuple bytes directly in the
// spill slot; everything else aggregate-typed keeps a pointer in
// the spill slot and indirects through it.
//
// The field offset is tuple.FieldOffset(Index) — NOT 8*Index
// — because tuple fields can themselves be aggregates (e.g. a
// `(Tab, int)` multi-return where Tab is 5 words). For scalar
// fields we LDR the value; for aggregate fields we produce an
// address (ADD) so downstream OP_STORE struct-copy can memcpy from it.
func emitExtract(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var src @ir.Instr = ins.Args[0]
	var rd int = nextReg(rm, ins.ID)
	var fieldOff int = 8 * ins.Index
	var exTyp @types.Type = types.StripWrappers(src.Typ)
	if exTyp != nil && exTyp.Kind == types.TYP_STRUCT {
		fieldOff = exTyp.FieldOffset(ins.Index)
	}
	// Scalar fields size-dispatch through emitScalarLoad: a 64-bit
	// LDR on a sub-word field would either pull in adjacent field
	// bits (when fields share an 8-byte slot, like uint32+uint32)
	// or run off the end of the spill slot. Aggregates pass through
	// as a pointer (ADD).
	var sz int = 8
	if ins.Typ != nil { sz = ins.Typ.SizeOf() }
	if sz <= 0 { sz = 8 }
	var sgnTyp @types.Type = types.StripWrappers(ins.Typ)
	var signed bool = sgnTyp != nil && sgnTyp.Signed
	if common.SpillHoldsAggregatePointer(src) {
		var ptr int = getOperand(a, rm, src.ID)
		if ptr < 0 { return }
		if common.IsAggregateTyp(ins.Typ) {
			aarch64.Add(a, true, rd, ptr, aarch64.Imm(fieldOff))
		} else {
			emitScalarLoad(a, rd, ptr, fieldOff, sz, signed)
		}
		return
	}
	var srcSlot int = rm.LookupSpill(src.ID)
	if srcSlot < 0 { return }
	if common.IsAggregateTyp(ins.Typ) {
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(srcSlot + fieldOff))
	} else {
		emitScalarLoad(a, rd, aarch64.SP, srcSlot + fieldOff, sz, signed)
	}
}

// emitAggMemcpyAarch64 copies `sz` bytes from [srcPtr] to [dstPtr] using the two
// scratch registers tmp1/tmp2.  It moves 16 bytes at a time with an LDP/STP pair —
// two words per instruction, and the pair's two registers keep the second word off
// the first word's dependency chain — then a single-word LDR/STR for a trailing odd
// word.  LDP/STP take a signed imm7-scaled offset (max byte offset 63*8 = 504), so
// any word past that reach falls back to LDR/STR (imm12, far wider) as well.  tmp1
// and tmp2 must be distinct from each other and from srcPtr/dstPtr.  This is the one
// aggregate-move primitive for the backend: both the aggregate load (into its own
// region) and the aggregate store (OP_STORE struct-copy) route through it.
func emitAggMemcpyAarch64(a @asm.Assembler, dstPtr int, srcPtr int, sz int, tmp1 int, tmp2 int) {
	var off int = 0
	for off + 16 <= sz && off <= 504 {
		aarch64.Ldp(a, true, tmp1, tmp2, aarch64.MemImm(srcPtr, off))
		aarch64.Stp(a, true, tmp1, tmp2, aarch64.MemImm(dstPtr, off))
		off = off + 16
	}
	for off + 8 <= sz {
		aarch64.Ldr(a, true, tmp1, aarch64.MemImm(srcPtr, off))
		aarch64.Str(a, true, tmp1, aarch64.MemImm(dstPtr, off))
		off = off + 8
	}
	// A final sub-word tail (sz not a multiple of 8) is copied as one full-word
	// access, matching the prior word-at-a-time loop's over-read of the padding.
	if off < sz {
		aarch64.Ldr(a, true, tmp1, aarch64.MemImm(srcPtr, off))
		aarch64.Str(a, true, tmp1, aarch64.MemImm(dstPtr, off))
	}
}

// emitAggMemcpySafeAarch64 is an OVERLAP-SAFE aggregate copy: it loads the WHOLE
// source into registers first, THEN stores — so a copy whose dst aliases (overlaps)
// its src (an elided raw-pointer `*dst = *src`) reads all of the source before
// writing any of the destination.  Used by emitStructCopy, whose source may be an
// aliased (elided) load.  Only a small aggregate (<= 4 words) fits the register
// budget; a larger copy delegates to the interleaved emitAggMemcpyAarch64 — reached
// only by NON-aliasing copies, since the S-adjacent elision that can alias is
// size-capped (<= 16 bytes) well within it.  Same op count as the interleaved form,
// just reordered.
func emitAggMemcpySafeAarch64(a @asm.Assembler, rm @common.RegMap, dstPtr int, srcPtr int, sz int) {
	var words int = (sz + 7) / 8
	if sz <= 0 || words > 4 {
		emitAggMemcpyAarch64(a, dstPtr, srcPtr, sz, scratchReg(rm), scratchReg(rm))
		return
	}
	var regs @[]int = make_slice(int, words)
	for i := 0; i < words; i = i + 1 { regs[i] = scratchReg(rm) }
	var li int = 0
	for li + 2 <= words {
		aarch64.Ldp(a, true, regs[li], regs[li + 1], aarch64.MemImm(srcPtr, li * 8))
		li = li + 2
	}
	if li < words {
		aarch64.Ldr(a, true, regs[li], aarch64.MemImm(srcPtr, li * 8))
	}
	var si int = 0
	for si + 2 <= words {
		aarch64.Stp(a, true, regs[si], regs[si + 1], aarch64.MemImm(dstPtr, si * 8))
		si = si + 2
	}
	if si < words {
		aarch64.Str(a, true, regs[si], aarch64.MemImm(dstPtr, si * 8))
	}
}

// emitAggLoad materializes an aggregate OP_LOAD: it copies the loaded
// bytes into the load's OWN data region (reserved by PlanFrame) and
// leaves rd pointing at that region.  A bare pointer pass-through aliases
// the source object, which dangles when the source is a local the
// function's cleanup RefDecs before the loaded value is consumed — e.g.
// `return container[i]`, whose element header lives in `container`'s
// backing and is read into the sret buffer only after `container`'s dtor
// has freed that backing.  Materializing at the load point (before any
// cleanup) gives the value its own storage, matching the LLVM backend.
func emitAggLoad(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr,
		arg @ir.Instr) {
	var rd int = nextReg(rm, ins.ID)
	// Source address of the aggregate being loaded.
	var srcPtr int
	var srcAlloc int = rm.LookupAlloc(arg.ID)
	if srcAlloc >= 0 {
		srcPtr = scratchReg(rm)
		aarch64.Add(a, true, srcPtr, aarch64.SP, aarch64.Imm(srcAlloc))
	} else if isGlobalRef(arg) {
		srcPtr = scratchReg(rm)
		emitGlobalAddr(a, pkgName, srcPtr, arg)
	} else {
		srcPtr = getOperand(a, rm, arg.ID)
	}
	if srcPtr < 0 { return }
	// Destination: the load's own region.  PlanFrame reserves one for
	// every aggregate load; the myAlloc < 0 fallback keeps behavior no
	// worse than the old aliasing form should that ever not hold.
	var myAlloc int = rm.LookupAlloc(ins.ID)
	if myAlloc < 0 {
		aarch64.Mov(a, true, rd, aarch64.Reg(srcPtr))
		return
	}
	aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(myAlloc))
	emitAggMemcpyAarch64(a, rd, srcPtr, ins.Typ.SizeOf(), scratchReg(rm), scratchReg(rm))
}

// emitLoad: OP_LOAD — aggregate loads materialize into their own region
// (emitAggLoad); scalar loads size-dispatch to LDRB/LDRH/LDR so a char
// read doesn't pull in 7 bytes of neighbors.  Package-level globals are
// reached via ADRP+ADD to the __DATA symbol.
func emitLoad(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var arg @ir.Instr = ins.Args[0]
	if common.IsAggregateTyp(ins.Typ) {
		emitAggLoad(a, pkgName, rm, ins, arg)
		return
	}
	var sz int = 8
	if ins.Typ != nil { sz = ins.Typ.SizeOf() }
	if sz <= 0 { sz = 8 }
	var sgnTyp @types.Type = types.StripWrappers(ins.Typ)
	var signed bool = sgnTyp != nil && sgnTyp.Signed
	var off int = rm.LookupAlloc(arg.ID)
	if off >= 0 {
		var rd int = nextReg(rm, ins.ID)
		emitScalarLoad(a, rd, aarch64.SP, off, sz, signed)
		return
	}
	if isGlobalRef(arg) {
		var addr int = scratchReg(rm)
		emitGlobalAddr(a, pkgName, addr, arg)
		var rd int = nextReg(rm, ins.ID)
		emitScalarLoad(a, rd, addr, 0, sz, signed)
		return
	}
	var ptr int = getOperand(a, rm, arg.ID)
	if ptr < 0 { return }
	var rd int = nextReg(rm, ins.ID)
	emitScalarLoad(a, rd, ptr, 0, sz, signed)
}

// emitStore: OP_STORE — aggregate stores memcpy via emitStructCopy;
// scalar stores size-dispatch to STRB/STRH/STR so a char write
// touches one byte rather than clobbering seven neighbors. For a
// global destination, ADRP+ADD to the __DATA symbol first.
func emitStore(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	if common.IsAggregateTyp(ins.Args[1].Typ) {
		emitStructCopy(a, pkgName, rm, ins)
		return
	}
	var sz int = 8
	if ins.Args[1].Typ != nil { sz = ins.Args[1].Typ.SizeOf() }
	if sz <= 0 { sz = 8 }
	var off int = rm.LookupAlloc(ins.Args[0].ID)
	var valReg int = emitValOperand(a, pkgName, rm, ins.Args[1])
	if valReg < 0 { return }
	if off >= 0 {
		emitScalarStore(a, valReg, aarch64.SP, off, sz)
		return
	}
	if isGlobalRef(ins.Args[0]) {
		var addr int = scratchReg(rm)
		emitGlobalAddr(a, pkgName, addr, ins.Args[0])
		emitScalarStore(a, valReg, addr, 0, sz)
		return
	}
	var ptr int = getOperand(a, rm, ins.Args[0].ID)
	if ptr < 0 { return }
	emitScalarStore(a, valReg, ptr, 0, sz)
}

// emitGetElemPtr: OP_GET_ELEM_PTR — compute base + idx*elemSize. The
// GEP's Typ is *elemTyp regardless of whether the base came from array
// indexing or from a slice whose data pointer was already extracted.
// A package-level global base is reached via ADRP+ADD.
func emitGetElemPtr(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	var elemSize int = common.ElemSizeOf(ins)
	if elemSize <= 0 { return }
	var idx int = getOperand(a, rm, ins.Args[1].ID)
	if idx < 0 { return }

	var sizeTmp int = scratchReg(rm)
	aarch64.Movz(a, true, sizeTmp, elemSize, 0)
	var byteOff int = scratchReg(rm)
	aarch64.Mul(a, true, byteOff, idx, sizeTmp)

	var rd int = nextReg(rm, ins.ID)
	var allocOff int = rm.LookupAlloc(ins.Args[0].ID)
	if allocOff >= 0 {
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(allocOff))
		aarch64.Add(a, true, rd, rd, aarch64.Reg(byteOff))
		return
	}
	if isGlobalRef(ins.Args[0]) {
		emitGlobalAddr(a, pkgName, rd, ins.Args[0])
		aarch64.Add(a, true, rd, rd, aarch64.Reg(byteOff))
		return
	}
	var base int = getOperand(a, rm, ins.Args[0].ID)
	if base < 0 { return }
	aarch64.Add(a, true, rd, base, aarch64.Reg(byteOff))
}

// emitGetFieldPtr: OP_GET_FIELD_PTR — compute base + FieldOffset.
// A package-level global base is reached via ADRP+ADD. Slice bases
// (raw or managed) get a flat 8*Index offset — fields are
// data, len, [refptr, backingLen] in word-sized slots, matching
// types.SliceDataOffset / MSliceDataOffset etc.
func emitGetFieldPtr(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var fieldOff int
	var baseTyp @types.Type = common.StructTypeOf(ins.Args[0])
	if baseTyp != nil {
		fieldOff = baseTyp.FieldOffset(ins.Index)
	} else if common.IsSliceFieldBase(ins.Args[0]) {
		fieldOff = 8 * ins.Index
	} else {
		return
	}
	var rd int = nextReg(rm, ins.ID)
	var allocOff int = rm.LookupAlloc(ins.Args[0].ID)
	if allocOff >= 0 {
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(allocOff + fieldOff))
		return
	}
	if isGlobalRef(ins.Args[0]) {
		emitGlobalAddr(a, pkgName, rd, ins.Args[0])
		if fieldOff != 0 {
			aarch64.Add(a, true, rd, rd, aarch64.Imm(fieldOff))
		}
		return
	}
	var ptr int = getOperand(a, rm, ins.Args[0].ID)
	if ptr < 0 { return }
	aarch64.Add(a, true, rd, ptr, aarch64.Imm(fieldOff))
}
