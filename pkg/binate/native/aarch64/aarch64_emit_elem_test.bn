package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the element/field-pointer lowering in aarch64_emit_elem.bn.
// The fused scaled-addressing element load/store emitters are exercised
// end-to-end by the conformance suite (byte-identical output across backends);
// these cover the directly-observable helpers.

// log2IfPow2 returns log2(n) for a power of two, else -1 — the index-scale shift.
func TestLog2IfPow2() testing.TestResult {
	if log2IfPow2(8) != 3 { return "log2IfPow2(8) should be 3" }
	if log2IfPow2(4) != 2 { return "log2IfPow2(4) should be 2" }
	if log2IfPow2(2) != 1 { return "log2IfPow2(2) should be 1" }
	if log2IfPow2(1) != 0 { return "log2IfPow2(1) should be 0" }
	if log2IfPow2(3) != -1 { return "log2IfPow2(3) should be -1 (not a power of two)" }
	if log2IfPow2(0) != -1 { return "log2IfPow2(0) should be -1" }
	if log2IfPow2(24) != -1 { return "log2IfPow2(24) should be -1 (not a power of two)" }
	return ""
}

// emitGetFieldPtr on a slice base: subslice (a[1:3]) lowers to a chain of
// GetFieldPtr ops indexing the four words of an alloca'd managed-slice (data,
// len, refptr, backingLen). Without slice-base support this silently no-op'd,
// leaving the destination address uninitialized.
func TestEmitGetFieldPtrManagedSliceField() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	// Allocate a 32-byte managed-slice on stack at offset 0.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 5)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 32)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 6)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 32)
	var alc @ir.Instr = make(ir.Instr)
	alc.ID = 5
	alc.Op = iropcode.OP_ALLOC
	alc.TypeArg = types.MakeManagedSliceType(types.TypInt())
	alc.Typ = types.MakePointerType(types.MakeManagedSliceType(types.TypInt()))
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 6
	ins.Op = iropcode.OP_GET_FIELD_PTR
	ins.Index = 2
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = alc
	emitGetFieldPtr(a, "main", rm, ins)
	// Should emit a single ADD rd, SP, #(0 + 8*2) = 4 bytes.
	if bytesWritten(a) != 4 {
		return "GetFieldPtr on slice base should emit one ADD"
	}
	return ""
}

// fmTwoIntStruct builds `struct { f0 int; f1 int }` — field 1 is at byte offset
// 8 on LP64, the offset the fused field load/store must encode.
func fmTwoIntStruct() @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 2)
	var a @types.Field = make(types.Field)
	a.Name = "f0"
	a.Type = types.TypInt()
	var b @types.Field = make(types.Field)
	b.Name = "f1"
	b.Type = types.TypInt()
	fs[0] = a
	fs[1] = b
	return types.MakeStructType("S", fs)
}

// fmFieldGep builds an OP_GET_FIELD_PTR for field 1 of {int,int} off a register
// base value (id 100).
func fmFieldGep() @ir.Instr {
	var base @ir.Instr = make(ir.Instr)
	base.ID = 100
	base.Typ = types.MakePointerType(fmTwoIntStruct())
	var gep @ir.Instr = make(ir.Instr)
	gep.ID = 101
	gep.Op = iropcode.OP_GET_FIELD_PTR
	gep.Index = 1
	gep.Typ = types.MakePointerType(types.TypInt())
	gep.Args = ir.MakeArgs1(base)
	return gep
}

// A fused field GEP load is one LDR at [base, #8], byte-identical to a direct
// emitScalarLoad at that offset (not the un-fused ADD + LDR).
func TestEmitFusedFieldLoadFoldsOffset() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = mkAsm()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	// base (id 100) homed to X20; load result (id 102) homed to X21.
	m.HomeIDs = common.AppendInt(m.HomeIDs, 100)
	m.HomeRegs = common.AppendInt(m.HomeRegs, aarch64.X20)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 102)
	m.HomeRegs = common.AppendInt(m.HomeRegs, aarch64.X21)

	var gep @ir.Instr = fmFieldGep()
	var ld @ir.Instr = make(ir.Instr)
	ld.ID = 102
	ld.Op = iropcode.OP_LOAD
	ld.Typ = types.TypInt()
	ld.Args = ir.MakeArgs1(gep)

	emitFusedFieldLoad(a, m, ld, gep)
	if bytesWritten(a) != 4 { return "fused field load must be one LDR (4 bytes), not ADD+LDR" }

	var ref @asm.Assembler = mkAsm()
	emitScalarLoad(ref, aarch64.X21, aarch64.X20, 8, 8, false)
	var k int = 0
	for k = 0; k < 4; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "fused field load must equal LDR X21,[X20,#8]"
		}
	}
	return ""
}

// The store analogue: one STR at [base, #8].
func TestEmitFusedFieldStoreFoldsOffset() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = mkAsm()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	// base (id 100) homed to X20; stored value (id 103) homed to X22.
	m.HomeIDs = common.AppendInt(m.HomeIDs, 100)
	m.HomeRegs = common.AppendInt(m.HomeRegs, aarch64.X20)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 103)
	m.HomeRegs = common.AppendInt(m.HomeRegs, aarch64.X22)

	var gep @ir.Instr = fmFieldGep()
	var val @ir.Instr = make(ir.Instr)
	val.ID = 103
	val.Typ = types.TypInt()
	var storeIns @ir.Instr = make(ir.Instr)
	storeIns.ID = 104
	storeIns.Op = iropcode.OP_STORE
	storeIns.Args = ir.MakeArgs2(gep, val)

	emitFusedFieldStore(a, "main", m, storeIns, gep)
	if bytesWritten(a) != 4 { return "fused field store must be one STR (4 bytes)" }

	var ref @asm.Assembler = mkAsm()
	emitScalarStore(ref, aarch64.X22, aarch64.X20, 8, 8)
	var k int = 0
	for k = 0; k < 4; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "fused field store must equal STR X22,[X20,#8]"
		}
	}
	return ""
}
