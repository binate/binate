package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the element/field-pointer lowering in aarch64_emit_elem.bn.
// The fused scaled-addressing element load/store emitters are exercised
// end-to-end by the conformance suite (byte-identical output across backends);
// these cover the directly-observable helpers.

// emitGetFieldPtr on a slice base: subslice (a[1:3]) lowers to a chain of
// GetFieldPtr ops indexing the four words of an alloca'd managed-slice (data,
// len, refptr, backingLen). Without slice-base support this silently no-op'd,
// leaving the destination address uninitialized.
func TestEmitGetFieldPtrManagedSliceField() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	// Allocate a 32-byte managed-slice on stack at offset 0.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 5)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 32)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 6)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 32)
	var alc @ir.Instr = make(ir.Instr)
	alc.ID = 5
	alc.Op = iropcode.OP_ALLOC
	alc.TypeArg = types.MakeManagedSliceType(types.TypInt())
	alc.Typ = types.MakePointerType(types.MakeManagedSliceType(types.TypInt()))
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 6
	ins.Op = iropcode.OP_GET_FIELD_PTR
	ins.Index = 2
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = alc
	emitGetFieldPtr(a, "main", rm, ins)
	// Should emit a single ADD rd, SP, #(0 + 8*2) = 4 bytes.
	if bytesWritten(a) != 4 {
		return "GetFieldPtr on slice base should emit one ADD"
	}
	return ""
}

// fmTwoIntStruct builds `struct { f0 int; f1 int }` — field 1 is at byte offset
// 8 on LP64, the offset the fused field load/store must encode.
func fmTwoIntStruct() @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 2)
	var a @types.Field = make(types.Field)
	a.Name = "f0"
	a.Type = types.TypInt()
	var b @types.Field = make(types.Field)
	b.Name = "f1"
	b.Type = types.TypInt()
	fs[0] = a
	fs[1] = b
	return types.MakeStructType("S", fs)
}

// fmFieldGep builds an OP_GET_FIELD_PTR for field 1 of {int,int} off a register
// base value (id 100).
func fmFieldGep() @ir.Instr {
	var base @ir.Instr = make(ir.Instr)
	base.ID = 100
	base.Typ = types.MakePointerType(fmTwoIntStruct())
	var gep @ir.Instr = make(ir.Instr)
	gep.ID = 101
	gep.Op = iropcode.OP_GET_FIELD_PTR
	gep.Index = 1
	gep.Typ = types.MakePointerType(types.TypInt())
	gep.Args = irbuild.MakeArgs1(base)
	return gep
}

// fmAllocaFieldGep builds an OP_GET_FIELD_PTR for field 1 of {int,int} off an
// OP_ALLOC base value (id 100) — the alloca-base fold target.
func fmAllocaFieldGep() @ir.Instr {
	var base @ir.Instr = make(ir.Instr)
	base.ID = 100
	base.Op = iropcode.OP_ALLOC
	base.Typ = types.MakePointerType(fmTwoIntStruct())
	var gep @ir.Instr = make(ir.Instr)
	gep.ID = 101
	gep.Op = iropcode.OP_GET_FIELD_PTR
	gep.Index = 1
	gep.Typ = types.MakePointerType(types.TypInt())
	gep.Args = irbuild.MakeArgs1(base)
	return gep
}

// A fused field GEP load is one LDR at [base, #8], byte-identical to a direct
// emitScalarLoad at that offset (not the un-fused ADD + LDR).
func TestEmitFusedFieldLoadFoldsOffset() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = mkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	// base (id 100) homed to X20; load result (id 102) homed to X21.
	m.HomeIDs = common.AppendInt(m.HomeIDs, 100)
	m.HomeRegs = common.AppendInt(m.HomeRegs, aarch64.X20)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 102)
	m.HomeRegs = common.AppendInt(m.HomeRegs, aarch64.X21)

	var gep @ir.Instr = fmFieldGep()
	var ld @ir.Instr = make(ir.Instr)
	ld.ID = 102
	ld.Op = iropcode.OP_LOAD
	ld.Typ = types.TypInt()
	ld.Args = irbuild.MakeArgs1(gep)

	emitFusedFieldLoad(a, m, ld, gep)
	if bytesWritten(a) != 4 { return "fused field load must be one LDR (4 bytes), not ADD+LDR" }

	var ref @asm.Assembler = mkAsm()
	emitScalarLoad(ref, aarch64.X21, aarch64.X20, 8, 8, false)
	var k int = 0
	for k = 0; k < 4; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "fused field load must equal LDR X21,[X20,#8]"
		}
	}
	return ""
}

// The store analogue: one STR at [base, #8].
func TestEmitFusedFieldStoreFoldsOffset() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = mkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	// base (id 100) homed to X20; stored value (id 103) homed to X22.
	m.HomeIDs = common.AppendInt(m.HomeIDs, 100)
	m.HomeRegs = common.AppendInt(m.HomeRegs, aarch64.X20)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 103)
	m.HomeRegs = common.AppendInt(m.HomeRegs, aarch64.X22)

	var gep @ir.Instr = fmFieldGep()
	var val @ir.Instr = make(ir.Instr)
	val.ID = 103
	val.Typ = types.TypInt()
	var storeIns @ir.Instr = make(ir.Instr)
	storeIns.ID = 104
	storeIns.Op = iropcode.OP_STORE
	storeIns.Args = irbuild.MakeArgs2(gep, val)

	emitFusedFieldStore(a, "main", m, storeIns, gep)
	if bytesWritten(a) != 4 { return "fused field store must be one STR (4 bytes)" }

	var ref @asm.Assembler = mkAsm()
	emitScalarStore(ref, aarch64.X22, aarch64.X20, 8, 8)
	var k int = 0
	for k = 0; k < 4; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "fused field store must equal STR X22,[X20,#8]"
		}
	}
	return ""
}

// An alloca-base fused field load is one LDR at [sp, #(allocOff+8)] — the alloca
// offset (32) and field offset (8) folded into the immediate, no standalone ADD.
func TestEmitFusedFieldLoadAllocaBaseFoldsOffset() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = mkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	// alloca base (id 100) at frame offset 32; load result (id 102) homed to X21.
	m.AllocIDs = common.AppendInt(m.AllocIDs, 100)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 32)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 16)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 102)
	m.HomeRegs = common.AppendInt(m.HomeRegs, aarch64.X21)

	var gep @ir.Instr = fmAllocaFieldGep()
	var ld @ir.Instr = make(ir.Instr)
	ld.ID = 102
	ld.Op = iropcode.OP_LOAD
	ld.Typ = types.TypInt()
	ld.Args = irbuild.MakeArgs1(gep)

	emitFusedFieldLoad(a, m, ld, gep)
	if bytesWritten(a) != 4 { return "alloca-base fused load must be one LDR (no ADD)" }

	var ref @asm.Assembler = mkAsm()
	emitScalarLoad(ref, aarch64.X21, aarch64.SP, 40, 8, false)
	var k int = 0
	for k = 0; k < 4; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "alloca-base fused load must equal LDR X21,[SP,#40] (no ADD)"
		}
	}
	return ""
}

// The alloca-base store analogue: one STR at [sp, #(allocOff+8)].
func TestEmitFusedFieldStoreAllocaBaseFoldsOffset() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = mkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	// alloca base (id 100) at frame offset 32; stored value (id 103) homed to X22.
	m.AllocIDs = common.AppendInt(m.AllocIDs, 100)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 32)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 16)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 103)
	m.HomeRegs = common.AppendInt(m.HomeRegs, aarch64.X22)

	var gep @ir.Instr = fmAllocaFieldGep()
	var val @ir.Instr = make(ir.Instr)
	val.ID = 103
	val.Typ = types.TypInt()
	var storeIns @ir.Instr = make(ir.Instr)
	storeIns.ID = 104
	storeIns.Op = iropcode.OP_STORE
	storeIns.Args = irbuild.MakeArgs2(gep, val)

	emitFusedFieldStore(a, "main", m, storeIns, gep)
	if bytesWritten(a) != 4 { return "alloca-base fused field store must be one STR (4 bytes)" }

	var ref @asm.Assembler = mkAsm()
	emitScalarStore(ref, aarch64.X22, aarch64.SP, 40, 8)
	var k int = 0
	for k = 0; k < 4; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "alloca-base fused store must equal STR X22,[SP,#40] (no ADD)"
		}
	}
	return ""
}

// fmTwoI16Struct builds `struct { f0 int16; f1 int16 }` — field 1 at byte offset
// 2, a SIGNED sub-word field (its fused load is an LDRSH).
func fmTwoI16Struct() @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 2)
	var a @types.Field = make(types.Field)
	a.Name = "f0"
	a.Type = types.TypInt16()
	var b @types.Field = make(types.Field)
	b.Name = "f1"
	b.Type = types.TypInt16()
	fs[0] = a
	fs[1] = b
	return types.MakeStructType("S16", fs)
}

// A signed sub-word (int16) field off an alloca base folds to one LDRSH at
// [sp, #(allocOff+2)] — exercising the `signed` sub-word path through the alloca
// branch (int-field tests use sz==8, where sign is irrelevant).
func TestEmitFusedFieldLoadAllocaBaseSignedSubword() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = mkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	// alloca base (id 100) at frame offset 32; load result (id 102) homed to X21.
	m.AllocIDs = common.AppendInt(m.AllocIDs, 100)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 32)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 8)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 102)
	m.HomeRegs = common.AppendInt(m.HomeRegs, aarch64.X21)

	var base @ir.Instr = make(ir.Instr)
	base.ID = 100
	base.Op = iropcode.OP_ALLOC
	base.Typ = types.MakePointerType(fmTwoI16Struct())
	var gep @ir.Instr = make(ir.Instr)
	gep.ID = 101
	gep.Op = iropcode.OP_GET_FIELD_PTR
	gep.Index = 1
	gep.Typ = types.MakePointerType(types.TypInt16())
	gep.Args = irbuild.MakeArgs1(base)
	var ld @ir.Instr = make(ir.Instr)
	ld.ID = 102
	ld.Op = iropcode.OP_LOAD
	ld.Typ = types.TypInt16()
	ld.Args = irbuild.MakeArgs1(gep)

	emitFusedFieldLoad(a, m, ld, gep)
	if bytesWritten(a) != 4 { return "signed sub-word alloca fused load must be one LDRSH (4 bytes)" }

	var ref @asm.Assembler = mkAsm()
	emitScalarLoad(ref, aarch64.X21, aarch64.SP, 34, 2, true)
	var k int = 0
	for k = 0; k < 4; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "signed sub-word alloca fused load must equal LDRSH X21,[SP,#34]"
		}
	}
	return ""
}

// fmFloatStruct builds `struct { i int; d float64; s float32 }` — on LP64 field
// d is at byte offset 8 and s at 16: the float fields the fused float field
// load/store tests address.
func fmFloatStruct() @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 3)
	var fi @types.Field = make(types.Field)
	fi.Name = "i"
	fi.Type = types.TypInt()
	var fd @types.Field = make(types.Field)
	fd.Name = "d"
	fd.Type = types.TypFloat64()
	var fsg @types.Field = make(types.Field)
	fsg.Name = "s"
	fsg.Type = types.TypFloat32()
	fs[0] = fi
	fs[1] = fd
	fs[2] = fsg
	return types.MakeStructType("F", fs)
}

// fmFloatFieldGep builds an OP_GET_FIELD_PTR (id 101) for field `index` of
// fmFloatStruct, typed pointer-to-`elem`, off base id 100 — an OP_ALLOC when
// alloca is set, else a register value.
func fmFloatFieldGep(index int, elem @types.Type, alloca bool) @ir.Instr {
	var base @ir.Instr = make(ir.Instr)
	base.ID = 100
	if alloca { base.Op = iropcode.OP_ALLOC }
	base.Typ = types.MakePointerType(fmFloatStruct())
	var gep @ir.Instr = make(ir.Instr)
	gep.ID = 101
	gep.Op = iropcode.OP_GET_FIELD_PTR
	gep.Index = index
	gep.Typ = types.MakePointerType(elem)
	gep.Args = irbuild.MakeArgs1(base)
	return gep
}

// fmFloatLoad builds the OP_LOAD (id 102, type t) through gep.
func fmFloatLoad(gep @ir.Instr, t @types.Type) @ir.Instr {
	var ld @ir.Instr = make(ir.Instr)
	ld.ID = 102
	ld.Op = iropcode.OP_LOAD
	ld.Typ = t
	ld.Args = irbuild.MakeArgs1(gep)
	return ld
}

// fmFloatStore builds the OP_STORE (id 104) of value id 103 (type t) through gep.
func fmFloatStore(gep @ir.Instr, t @types.Type) @ir.Instr {
	var val @ir.Instr = make(ir.Instr)
	val.ID = 103
	val.Typ = t
	var st @ir.Instr = make(ir.Instr)
	st.ID = 104
	st.Op = iropcode.OP_STORE
	st.Args = irbuild.MakeArgs2(gep, val)
	return st
}

// fmHome records SSA id's home register in m.
func fmHome(m @common.RegMap, id int, reg int) {
	m.HomeIDs = common.AppendInt(m.HomeIDs, id)
	m.HomeRegs = common.AppendInt(m.HomeRegs, reg)
}

// fmAlloca records id 100 as a 24-byte alloca at frame offset 32.
func fmAlloca(m @common.RegMap) {
	m.AllocIDs = common.AppendInt(m.AllocIDs, 100)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 32)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 24)
}

// fmSameBytes returns msg unless a emitted exactly ref's bytes.
func fmSameBytes(a @asm.Assembler, ref @asm.Assembler, msg testing.TestResult) testing.TestResult {
	if bytesWritten(a) != bytesWritten(ref) { return msg }
	var k int = 0
	for k = 0; k < bytesWritten(a); k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] { return msg }
	}
	return ""
}

// A fused field load of an FP-homed float64 is one `ldr d8, [x20, #8]` straight
// into the D-register home.
func TestEmitFusedFieldLoadFloatHomeFoldsOffset() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = mkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	fmHome(m, 100, aarch64.X20)
	fmHome(m, 102, aarch64.D8)
	var gep @ir.Instr = fmFloatFieldGep(1, types.TypFloat64(), false)
	emitFusedFieldLoad(a, m, fmFloatLoad(gep, types.TypFloat64()), gep)
	var ref @asm.Assembler = mkAsm()
	aarch64.Fldr_d(ref, aarch64.D8, aarch64.X20, 8)
	return fmSameBytes(a, ref, "fused float64 field load must be exactly LDR D8,[X20,#8]")
}

// A fused field store of an FP-homed float64 is one `str d9, [x20, #8]` straight
// from the D-register home — NOT an FMOV to a GP scratch followed by a GP STR.
func TestEmitFusedFieldStoreFloatHomeFoldsOffset() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = mkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	fmHome(m, 100, aarch64.X20)
	fmHome(m, 103, aarch64.D9)
	var gep @ir.Instr = fmFloatFieldGep(1, types.TypFloat64(), false)
	emitFusedFieldStore(a, "main", m, fmFloatStore(gep, types.TypFloat64()), gep)
	var ref @asm.Assembler = mkAsm()
	aarch64.Fstr_d(ref, aarch64.D9, aarch64.X20, 8)
	return fmSameBytes(a, ref, "fused float64 field store must be exactly STR D9,[X20,#8] (no FMOV)")
}

// A float32 field (offset 16) loads through the D home's S-view: `ldr s8, [x20, #16]`.
func TestEmitFusedFieldLoadFloat32HomeUsesSView() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = mkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	fmHome(m, 100, aarch64.X20)
	fmHome(m, 102, aarch64.D8)
	var gep @ir.Instr = fmFloatFieldGep(2, types.TypFloat32(), false)
	emitFusedFieldLoad(a, m, fmFloatLoad(gep, types.TypFloat32()), gep)
	var ref @asm.Assembler = mkAsm()
	aarch64.Fldr_s(ref, aarch64.D8, aarch64.X20, 16)
	return fmSameBytes(a, ref, "fused float32 field load must be exactly LDR S8,[X20,#16]")
}

// The float32 store analogue: `str s9, [x20, #16]`.
func TestEmitFusedFieldStoreFloat32HomeUsesSView() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = mkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	fmHome(m, 100, aarch64.X20)
	fmHome(m, 103, aarch64.D9)
	var gep @ir.Instr = fmFloatFieldGep(2, types.TypFloat32(), false)
	emitFusedFieldStore(a, "main", m, fmFloatStore(gep, types.TypFloat32()), gep)
	var ref @asm.Assembler = mkAsm()
	aarch64.Fstr_s(ref, aarch64.D9, aarch64.X20, 16)
	return fmSameBytes(a, ref, "fused float32 field store must be exactly STR S9,[X20,#16]")
}

// An alloca-base float field folds allocaOffset (32) + fieldOffset (8) into one
// SP-relative `ldr d8, [sp, #40]` — no ADD, no GP bridge.
func TestEmitFusedFieldLoadFloatAllocaBase() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = mkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	fmAlloca(m)
	fmHome(m, 102, aarch64.D8)
	var gep @ir.Instr = fmFloatFieldGep(1, types.TypFloat64(), true)
	emitFusedFieldLoad(a, m, fmFloatLoad(gep, types.TypFloat64()), gep)
	var ref @asm.Assembler = mkAsm()
	aarch64.Fldr_d(ref, aarch64.D8, aarch64.SP, 40)
	return fmSameBytes(a, ref, "alloca-base fused float64 load must be exactly LDR D8,[SP,#40]")
}

// The alloca-base store analogue: `str d9, [sp, #40]`.
func TestEmitFusedFieldStoreFloatAllocaBase() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = mkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	fmAlloca(m)
	fmHome(m, 103, aarch64.D9)
	var gep @ir.Instr = fmFloatFieldGep(1, types.TypFloat64(), true)
	emitFusedFieldStore(a, "main", m, fmFloatStore(gep, types.TypFloat64()), gep)
	var ref @asm.Assembler = mkAsm()
	aarch64.Fstr_d(ref, aarch64.D9, aarch64.SP, 40)
	return fmSameBytes(a, ref, "alloca-base fused float64 store must be exactly STR D9,[SP,#40]")
}

// A float load whose result is NOT FP-homed (a spilled float) takes the GP path:
// one `ldr x9, [x20, #8]` into a pool register, recorded as the result's register
// (the dispatcher's handleResult then stores it to the slot).
func TestEmitFusedFieldLoadFloatUnhomedUsesGp() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = mkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	fmHome(m, 100, aarch64.X20)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 102)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 48)
	var gep @ir.Instr = fmFloatFieldGep(1, types.TypFloat64(), false)
	emitFusedFieldLoad(a, m, fmFloatLoad(gep, types.TypFloat64()), gep)
	if m.LookupReg(102) != aarch64.X9 {
		return "unhomed float load result must land in pool register X9"
	}
	var ref @asm.Assembler = mkAsm()
	aarch64.Ldr(ref, true, aarch64.X9, aarch64.MemImm(aarch64.X20, 8))
	return fmSameBytes(a, ref, "unhomed fused float64 load must be exactly LDR X9,[X20,#8]")
}

// A float store whose value is NOT FP-homed reloads the value's bits from its
// slot into a GP scratch and stores them with a size-matched GP STR: for a
// float32, `ldr x9, [sp, #48]; str w9, [x20, #16]`.
func TestEmitFusedFieldStoreFloatUnhomedUsesGp() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = mkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	fmHome(m, 100, aarch64.X20)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 103)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 48)
	var gep @ir.Instr = fmFloatFieldGep(2, types.TypFloat32(), false)
	emitFusedFieldStore(a, "main", m, fmFloatStore(gep, types.TypFloat32()), gep)
	var ref @asm.Assembler = mkAsm()
	aarch64.Ldr(ref, true, aarch64.X9, aarch64.MemImm(aarch64.SP, 48))
	aarch64.Str(ref, false, aarch64.X9, aarch64.MemImm(aarch64.X20, 16))
	return fmSameBytes(a, ref, "unhomed fused float32 store must be LDR X9,[SP,#48]; STR W9,[X20,#16]")
}

// fieldFoldSet — the fold set emitFunc hands the allocator and the emitters —
// folds float fields: a float64 and a float32 load, each through its own
// single-use field GEP.  (A backend that stops opting floats in would still
// compile everything correctly, just with a standalone address per float field
// access, so only this pins the opt-in.)
func TestFieldFoldSetFoldsFloatFields() testing.TestResult {
	setTarget64()
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "t", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var base @ir.Instr = irbuild.EmitConstNil(b, types.MakePointerType(fmFloatStruct()))
	var gd @ir.Instr = irbuild.EmitGetFieldPtr(b, base, 1, types.TypFloat64())
	_ = irbuild.EmitLoad(b, gd, types.TypFloat64())
	var gs @ir.Instr = irbuild.EmitGetFieldPtr(b, base, 2, types.TypFloat32())
	_ = irbuild.EmitLoad(b, gs, types.TypFloat32())
	var fs @[]bool = fieldFoldSet(f)
	if gd.ID >= len(fs) || !fs[gd.ID] { return "a float64 field access must fold" }
	if gs.ID >= len(fs) || !fs[gs.ID] { return "a float32 field access must fold" }
	return ""
}
