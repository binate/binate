package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// emitFunc — prologue, body, epilogue
// ============================================================

// aarch64CC returns the AArch64 calling convention for the CURRENT target's
// object format.  ELF (Linux) uses textbook AAPCS64 — every stack argument
// takes a rounded 8-byte slot and variadic args fill the GP/FP registers before
// spilling.  Mach-O (Darwin/Apple) uses the AAPCS64_Darwin variant, which packs
// FIXED narrow scalar stack args at their natural size and stacks EVERY variadic
// arg.  The two are otherwise identical (same reg counts / sret / aggregate /
// HFA rules), so only stack-slot width + variadic placement flip.
//
// Selected off objEmitElf (set by EmitObject from the target format), the same
// signal symPrefixed uses: the two aarch64 targets are aarch64-darwin (Mach-O,
// Apple ABI) and aarch64-linux (ELF, AAPCS64).  The native side MUST match the
// platform ABI clang follows, since cmd/bnc compiles only the main module
// natively and every dependency package goes through LLVM/clang.  Every
// arg-marshalling site — caller, callee prologue, and the dispatch / closure /
// func-value shims — uses this ONE selector so they agree on both axes.
func aarch64CC() common.CallConv {
	if objEmitElf {
		return common.AAPCS64()
	}
	return common.AAPCS64_Darwin()
}

// emitFunc lowers one function. Prologue saves FP/LR and allocates
// the local stack frame; epilogue reverses.
func emitFunc(a @asm.Assembler, pkgName *[]readonly char, f @ir.Func, strings @[]ir.StringConst,
		allFuncs @[]@ir.Func) {
	// f.Name is dot-qualified ("pkg.Func", "pkg.Type.M", "main.main");
	// symFor → mangle.FuncName treats dotted names as pre-qualified,
	// so the pkgName arg is ignored. Kept for API stability with
	// bare-name callers (none currently in pkg/binate/ir's output).
	var sym @[]char = symFor(pkgName, f.Name)
	a.DefineLabel(sym)
	// IsLinkOnce (dtors / copy helpers, emitted into every module
	// that needs them) gets a Mach-O weak definition so ld
	// deduplicates across the linked .o set. LLVM uses
	// `linkonce_odr` for the same role.
	if f.IsLinkOnce {
		a.SetWeak(sym)
	} else {
		a.SetGlobal(sym)
	}
	// #[c_export("name")] adds an unmangled C symbol at the function's entry
	// (the SAME section offset as `sym` — no bytes are emitted yet) in addition
	// to the mangled `sym`.  symPrefixed (NOT symFor) applies only the
	// object-format link prefix — Mach-O's leading '_', empty on ELF — leaving
	// the name un-bn_-mangled, exactly like the __c_call callee path.  A C export
	// is a strong global regardless of the function's own linkage.  See
	// plan-ffi-export-detailed.md.
	for ci := 0; ci < len(f.CExportNames); ci++ {
		var alias @[]char = symPrefixed(f.CExportNames[ci])
		a.DefineLabel(alias)
		a.SetGlobal(alias)
	}

	// Target-conditional CC (aarch64CC): Darwin stacks every vararg + packs
	// narrow stack args tight; Linux/AAPCS64 fills variadic registers first +
	// rounds stack args to 8.  The V-variant arg-dispatch helpers consult
	// VariadicStackOnly; non-variadic calls reduce to the base helpers.
	var rm @common.RegMap = common.NewRegMap(aarch64CC())
	var frameSize int = rm.PlanFrame(f)

	// Prologue:
	//   stp x29, x30, [sp, #-16]!
	//   mov x29, sp
	//   sub sp, sp, #frameSize
	aarch64.Stp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPre(aarch64.SP, -16))
	aarch64.Mov(a, true, aarch64.FP, aarch64.Reg(aarch64.SP))
	if frameSize > 0 {
		aarch64.Sub(a, true, aarch64.SP, aarch64.SP, aarch64.Imm(frameSize))
	}
	// If this function returns an aggregate > 64 bytes, X8 is the
	// AAPCS indirect-result-register (sret) — caller passed a buffer
	// pointer in X8. Stash it before doing anything else; the
	// epilogue's emitReturn will copy the result through it.
	if rm.SretSlotOff >= 0 {
		aarch64.Str(a, true, aarch64.X8, aarch64.MemImm(aarch64.SP, rm.SretSlotOff))
	}

	// Spill incoming parameter registers (and read incoming stack
	// args) to their stack slots so later uses — which go through
	// getOperand → spill reload — see them. Mirrors emitCall's
	// AAPCS dispatch: the same regStart/stackOff per param.
	//
	// Incoming stack args sit in the *caller's* outgoing-args area,
	// which is now at [sp + frameSize + 16 + i*8] from the callee's
	// perspective: +frameSize undoes our `sub sp`, +16 undoes our
	// stp fp,lr push.
	var paramTypes @[]@types.Type = make_slice(@types.Type, len(f.Params))
	for pi := 0; pi < len(f.Params); pi++ {
		paramTypes[pi] = f.Params[pi].Typ
	}
	var stackArgsBase int = frameSize + 16
	// AAPCS NSRN: float-scalar params arrive in D(NSRN) (separate from
	// the GP NGRN budget tracked by CallArgRegStart). Walk parameters in
	// order so NSRN matches the caller's per-call counting.
	var nsrn int = 0
	for pi := 0; pi < len(f.Params); pi++ {
		var p @ir.Param = f.Params[pi]
		if common.IsFloatScalarTyp(p.Typ) {
			var off int = rm.LookupSpill(p.ID)
			if off >= 0 {
				if nsrn < rm.CC.NumFpArgRegs {
					// Move the float bits from D(nsrn) through a GP scratch
					// to the spill slot. Spills remain GP-addressed memory
					// (matches the float-arithmetic spill pattern).
					var tmp int = scratchReg(rm)
					aarch64.Fmov_fp_to_gp(a, tmp, aarch64.D0 + nsrn)
					aarch64.Str(a, true, tmp, aarch64.MemImm(aarch64.SP, off))
					rm.ResetRegs()
				} else {
					// FP arg registers exhausted: this float arrived on the
					// incoming-args stack (8-byte slot).  Shuttle it through
					// a GP scratch into the spill slot, like a GP stack arg.
					var fStackOff int = rm.CC.CallArgStackOff(paramTypes, pi)
					if fStackOff >= 0 {
						var tmp int = scratchReg(rm)
						aarch64.Ldr(a, true, tmp, aarch64.MemImm(aarch64.SP, stackArgsBase + fStackOff))
						aarch64.Str(a, true, tmp, aarch64.MemImm(aarch64.SP, off))
						rm.ResetRegs()
					}
				}
			}
			nsrn = nsrn + 1
			continue
		}
		// HFA parameter: the struct's float members arrive in
		// D(nsrn..nsrn+N-1) (or, on FP overflow, as words on the
		// incoming-args stack).  Like any aggregate param, the struct BYTES
		// live in the param's data region (LookupAlloc) and the 8-byte spill
		// slot holds a POINTER to that region — that is the uniform
		// representation every downstream aggregate consumer (OP_EXTRACT,
		// struct copy, address-of) resolves through.  So write each member
		// into the data region at byte offset hfaW*m (same-width members, no
		// padding), then publish the data-region pointer into the spill slot,
		// exactly as the GP-passed aggregate path below does — the only
		// difference is the source (FP registers vs GP arg registers).
		// Writing the float bits into the spill slot itself would both
		// overrun the 8-byte slot and leave the pointer unset, so downstream
		// reads would dereference raw float bits (UAF / segfault).
		hfaN, hfaW := types.HfaClassify(p.Typ)
		if rm.CC.HfaAggregates && hfaN > 0 {
			var dataOff int = rm.LookupAlloc(p.ID)
			var sz int = rm.LookupAllocSize(p.ID)
			if dataOff < 0 || sz <= 0 { continue }
			if nsrn + hfaN <= rm.CC.NumFpArgRegs {
				for m := 0; m < hfaN; m++ {
					var tmp int = scratchReg(rm)
					aarch64.Fmov_fp_to_gp(a, tmp, aarch64.D0 + nsrn + m)
					aarch64.StrSized(a, hfaW, tmp, aarch64.MemImm(aarch64.SP, dataOff + hfaW * m))
					rm.ResetRegs()
				}
				nsrn = nsrn + hfaN
			} else {
				var hsOff int = rm.CC.CallArgStackOff(paramTypes, pi)
				var hnWords int = common.ArgWords(p.Typ)
				if hsOff >= 0 {
					for w := 0; w < hnWords; w++ {
						var tmp int = scratchReg(rm)
						aarch64.Ldr(a, true, tmp, aarch64.MemImm(aarch64.SP, stackArgsBase + hsOff + 8 * w))
						aarch64.Str(a, true, tmp, aarch64.MemImm(aarch64.SP, dataOff + 8 * w))
						rm.ResetRegs()
					}
				}
				nsrn = rm.CC.NumFpArgRegs
			}
			var spillOff int = rm.LookupSpill(p.ID)
			if spillOff >= 0 {
				var tmp2 int = scratchReg(rm)
				aarch64.Add(a, true, tmp2, aarch64.SP, aarch64.Imm(dataOff))
				aarch64.Str(a, true, tmp2, aarch64.MemImm(aarch64.SP, spillOff))
			}
			rm.ResetRegs()
			continue
		}
		var regStart int = rm.CC.CallArgRegStart(paramTypes, pi)
		var stackOff int = rm.CC.CallArgStackOff(paramTypes, pi)
		if common.IsAggregateTyp(p.Typ) {
			// Indirect-large: pkg/codegen emits the function param
			// as `ptr byval(<T>) align 8`, and LLVM-AArch64 lowers
			// to "pointer in next free X reg (or 1 stack word)".
			// AAPCS byval semantics give the callee its own copy of
			// the struct — memcpy from the caller-supplied pointer
			// into the local data region so downstream
			// `paramSlots[i]` references (which natively resolve to
			// sp + AllocOff for aggregates) read the right bytes.
			// Also write the data-region pointer to the spill slot
			// (matches the slice-spread path's `Add tmp, sp,
			// AllocOff; Str` so downstream EmitLoad-then-pass paths
			// see a uniform pointer there).
			if rm.CC.IndirectLargeAggregates && p.Typ.SizeOf() > rm.CC.AggregateInRegMax {
				var dataOff int = rm.LookupAlloc(p.ID)
				var sz int = rm.LookupAllocSize(p.ID)
				if dataOff < 0 || sz <= 0 { continue }
				// Get the byval pointer into a known register.
				var ptr int = aarch64.X16
				if regStart >= 0 {
					if argReg(regStart) != ptr {
						aarch64.Mov(a, true, ptr, aarch64.Reg(argReg(regStart)))
					}
				} else if stackOff >= 0 {
					aarch64.Ldr(a, true, ptr, aarch64.MemImm(aarch64.SP, stackArgsBase + stackOff))
				}
				// Copy struct words from *ptr to sp+dataOff.
				var nWords int = common.ArgWords(p.Typ)
				var tmp int = scratchReg(rm)
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true, tmp, aarch64.MemImm(ptr, 8 * w))
					aarch64.Str(a, true, tmp, aarch64.MemImm(aarch64.SP, dataOff + 8 * w))
				}
				var spillOff int = rm.LookupSpill(p.ID)
				if spillOff >= 0 {
					var tmp2 int = scratchReg(rm)
					aarch64.Add(a, true, tmp2, aarch64.SP, aarch64.Imm(dataOff))
					aarch64.Str(a, true, tmp2, aarch64.MemImm(aarch64.SP, spillOff))
				}
				rm.ResetRegs()
				continue
			}
			var dataOff int = rm.LookupAlloc(p.ID)
			var sz int = rm.LookupAllocSize(p.ID)
			if dataOff < 0 || sz <= 0 { continue }
			var nWords int = common.ArgWords(p.Typ)
			// ≤ AggregateInRegMax: spread/split per AAPCS § 5.4.2 —
			// store regs first to the data region, then copy any
			// overflow words from caller's outgoing-args area.  With
			// both regStart and stackOff non-negative the arg straddles
			// the X0..X7 boundary.
			var regWords int = 0
			if regStart >= 0 {
				regWords = nWords
				if stackOff >= 0 { regWords = 8 - regStart }
				for w := 0; w < regWords; w++ {
					aarch64.Str(a, true, argReg(regStart + w), aarch64.MemImm(aarch64.SP, dataOff + 8 * w))
				}
			}
			if stackOff >= 0 {
				var tmp int = scratchReg(rm)
				for w := regWords; w < nWords; w++ {
					aarch64.Ldr(a, true, tmp,
							aarch64.MemImm(aarch64.SP, stackArgsBase + stackOff + 8 * (w - regWords)))
					aarch64.Str(a, true, tmp, aarch64.MemImm(aarch64.SP, dataOff + 8 * w))
				}
			}
			var spillOff int = rm.LookupSpill(p.ID)
			if spillOff >= 0 {
				var tmp2 int = scratchReg(rm)
				aarch64.Add(a, true, tmp2, aarch64.SP, aarch64.Imm(dataOff))
				aarch64.Str(a, true, tmp2, aarch64.MemImm(aarch64.SP, spillOff))
			}
			rm.ResetRegs()
		} else {
			var off int = rm.LookupSpill(p.ID)
			if off < 0 { continue }
			if regStart >= 0 {
				aarch64.Str(a, true, argReg(regStart), aarch64.MemImm(aarch64.SP, off))
			} else {
				var tmp int = scratchReg(rm)
				aarch64.Ldr(a, true, tmp, aarch64.MemImm(aarch64.SP, stackArgsBase + stackOff))
				aarch64.Str(a, true, tmp, aarch64.MemImm(aarch64.SP, off))
				rm.ResetRegs()
			}
		}
	}

	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		if bi > 0 {
			a.DefineLabel(blockLabel(sym, b.Label))
		}
		// Each block starts with a fresh regmap. Cross-block values
		// flow through spill slots.
		rm.ResetRegs()
		for ii := 0; ii < len(b.Instrs); ii++ {
			emitInstr(a, pkgName, sym, rm, strings, allFuncs, b.Instrs[ii])
			// Spill the result (if this instruction produced a value)
			// and reset the register pool. emitCall handles its own
			// spill/reset internally, so this is a no-op for calls.
			spillAndReset(a, rm, b.Instrs[ii])
		}
	}

	// Safety net: emit an epilogue if the IR didn't end with OP_RETURN.
	emitEpilogueAndRet(a, frameSize)
}
