package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// emitFunc — prologue, body, epilogue
// ============================================================

// aarch64CC returns the AArch64 calling convention for the CURRENT target's
// object format.  ELF (Linux) uses textbook AAPCS64 — every stack argument
// takes a rounded 8-byte slot and variadic args fill the GP/FP registers before
// spilling.  Mach-O (Darwin/Apple) uses the AAPCS64_Darwin variant, which packs
// FIXED narrow scalar stack args at their natural size and stacks EVERY variadic
// arg.  The two are otherwise identical (same reg counts / sret / aggregate /
// HFA rules), so only stack-slot width + variadic placement flip.
//
// Selected off objEmitElf (set by EmitObject from the target format), the same
// signal symPrefixed uses: the two aarch64 targets are aarch64-darwin (Mach-O,
// Apple ABI) and aarch64-linux (ELF, AAPCS64).  The native side MUST match the
// platform ABI clang follows, since cmd/bnc compiles only the main module
// natively and every dependency package goes through LLVM/clang.  Every
// arg-marshalling site — caller, callee prologue, and the dispatch / closure /
// func-value shims — uses this ONE selector so they agree on both axes.
func aarch64CC() common.CallConv {
	if objEmitElf {
		return common.AAPCS64()
	}
	return common.AAPCS64_Darwin()
}

// emitFunc lowers one function. Prologue saves FP/LR and allocates
// the local stack frame; epilogue reverses.
func emitFunc(a @asm.Assembler, pkgName *[]readonly char, f @ir.Func, strings @[]ir.StringConst) {
	// f.Name is dot-qualified ("pkg.Func", "pkg.Type.M", "main.main");
	// symFor → mangle.FuncName treats dotted names as pre-qualified,
	// so the pkgName arg is ignored. Kept for API stability with
	// bare-name callers (none currently in pkg/binate/ir's output).
	var sym @[]char = symFor(pkgName, f.Name)
	// Target-conditional CC (aarch64CC): Darwin stacks every vararg + packs
	// narrow stack args tight; Linux/AAPCS64 fills variadic registers first +
	// rounds stack args to 8.  The V-variant arg-dispatch helpers consult
	// VariadicStackOnly; non-variadic calls reduce to the base helpers.
	var rm @common.RegMap = common.NewRegMap(aarch64CC())
	var paramTypes @[]@types.Type = make_slice(@types.Type, len(f.Params))
	for pi := 0; pi < len(f.Params); pi++ {
		paramTypes[pi] = f.Params[pi].Typ
	}
	// #[c_export("name")] C-entry thunk: emit the unmangled C name(s) as a label, then a
	// narrow-argument normalization, then a branch to the mangled `sym` — so a C caller
	// (entering at the alias) sign-/zero-extends the narrow argument registers whose high
	// bits AAPCS64 leaves unspecified and jumps into the body, while a native caller
	// (entering at `sym`, already passing extended narrow args) skips it.  The branch is
	// load-bearing: when the normalization is non-empty the alias is a distinct, smaller
	// symbol than `sym`, and ld64 links per-symbol atoms without keeping them adjacent — a
	// bare fall-through would land in inter-atom padding.  When the normalization is empty
	// the alias and `sym` share the entry offset (one atom), so no branch is emitted.
	// symPrefixed (NOT symFor) applies only the object-format link prefix — Mach-O's leading
	// '_', empty on ELF — leaving the name un-bn_-mangled, like the __c_call callee path.  A
	// C export is a strong global regardless of the function's own linkage.
	for ci := 0; ci < len(f.CExportNames); ci++ {
		var alias @[]char = symPrefixed(f.CExportNames[ci])
		a.DefineLabel(alias)
		a.SetGlobal(alias)
	}
	if len(f.CExportNames) > 0 {
		var preOff uint = a.CurrentOffset()
		emitCExportRegNorm(a, rm, f)
		if a.CurrentOffset() > preOff {
			aarch64.B(a, sym)
		}
	}
	a.DefineLabel(sym)
	// IsLinkOnce (dtors / copy helpers, emitted into every module that needs them) gets a
	// Mach-O weak definition so ld deduplicates across the linked .o set. LLVM uses
	// `linkonce_odr` for the same role.
	if f.IsLinkOnce {
		a.SetWeak(sym)
	} else {
		a.SetGlobal(sym)
	}
	// Register allocation (before PlanFrame, which reserves the callee-saved
	// save area): home scalar SSA values in the callee-saved pool X19..X28 —
	// disjoint from the X9..X17 scratch pool, so the existing operand-reload /
	// op-internal-scratch path is untouched, and callee-saved so a homed value
	// survives calls.  A leaf / all-spilled function homes nothing and keeps
	// the pure spill-everything path.  f is phi-free here (common.EmitObject
	// runs ir.EliminatePhis before EmitFunc), so the liveness pass is valid.
	// CallerSaved is deliberately EMPTY: with no caller-saved pool, LinearScan
	// draws every home register from CalleeSaved, so every homed value is
	// callee-saved — it survives calls with no clobber-spill AND is recorded in
	// rm.SavedRegs (so the prologue/epilogue save/restore it).  That is what
	// makes the clobber machinery (spansClobber / ClobberPositions) inert here.
	// Populating CallerSaved would activate that path: a call-spanning value
	// could then take an unsaved caller-saved home and be clobbered across the
	// call, so that step must come with the clobber-spill handling (a later
	// stage), not on its own.
	var rdesc common.RegClassDesc
	rdesc.CalleeSaved = aarch64AllocatablePool()
	rm.AllocateRegisters(f, 8, rdesc)
	var frameSize int = rm.PlanFrame(f)
	// Lazy spill (dead-store elimination): stamp the assembler back-channel so
	// allocReg can spill a dirty value it must evict, and precompute the
	// per-instruction live-before sets that gate which dirty values to spill at
	// each cache-drop point (vs. drop unstored — a dead store).
	rm.CurAsm = a
	var liveBefore @[]@[]@[]bool = common.ComputeLiveBeforeAll(f, 8)

	// Prologue:
	//   stp x29, x30, [sp, #-16]!
	//   mov x29, sp
	//   sub sp, sp, #frameSize
	aarch64.Stp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPre(aarch64.SP, -16))
	aarch64.Mov(a, true, aarch64.FP, aarch64.Reg(aarch64.SP))
	if frameSize > 0 {
		aarch64.Sub(a, true, aarch64.SP, aarch64.SP, aarch64.Imm(frameSize))
	}
	// Save the callee-saved registers the allocator used, into the frame's
	// save area (at SavedRegsOff, inside `sub sp` and BELOW the fp/lr pair, so
	// the x29 -> {fp,lr} chain the Darwin unwinder and OP_STACK_FRAMES walk is
	// intact).  Done before any param lands in a home register, so the
	// caller's register values are preserved first.  The epilogue restores.
	for si := 0; si < len(rm.SavedRegs); si++ {
		aarch64.Str(a, true, rm.SavedRegs[si], aarch64.MemImm(aarch64.SP, rm.SavedRegsOff + 8 * si))
	}
	// If this function returns an aggregate > 64 bytes, X8 is the
	// AAPCS indirect-result-register (sret) — caller passed a buffer
	// pointer in X8. Stash it before doing anything else; the
	// epilogue's emitReturn will copy the result through it.
	if rm.SretSlotOff >= 0 {
		aarch64.Str(a, true, aarch64.X8, aarch64.MemImm(aarch64.SP, rm.SretSlotOff))
	}

	// Spill incoming parameter registers (and read incoming stack
	// args) to their stack slots so later uses — which go through
	// getOperand → spill reload — see them. Mirrors emitCall's
	// AAPCS dispatch: the same regStart/stackOff per param.
	//
	// Incoming stack args sit in the *caller's* outgoing-args area,
	// which is now at [sp + frameSize + 16 + i*8] from the callee's
	// perspective: +frameSize undoes our `sub sp`, +16 undoes our
	// stp fp,lr push.
	var stackArgsBase int = frameSize + 16
	// AAPCS NSRN: float-scalar params arrive in D(NSRN) (separate from
	// the GP NGRN budget tracked by CallArgRegStart). Walk parameters in
	// order so NSRN matches the caller's per-call counting.
	var nsrn int = 0
	for pi := 0; pi < len(f.Params); pi++ {
		var p @ir.Param = f.Params[pi]
		if common.IsFloatScalarTyp(p.Typ) {
			var off int = rm.LookupSpill(p.ID)
			if off >= 0 {
				if nsrn < rm.CC.NumFpArgRegs {
					// Move the float bits from D(nsrn) through a GP scratch
					// to the spill slot. Spills remain GP-addressed memory
					// (matches the float-arithmetic spill pattern).
					var tmp int = scratchReg(rm)
					aarch64.Fmov_fp_to_gp(a, tmp, aarch64.D0 + nsrn)
					aarch64.Str(a, true, tmp, aarch64.MemImm(aarch64.SP, off))
					rm.ResetRegs()
				} else {
					// FP arg registers exhausted: this float arrived on the
					// incoming-args stack (8-byte slot).  Shuttle it through
					// a GP scratch into the spill slot, like a GP stack arg.
					var fStackOff int = rm.CC.CallArgStackOff(paramTypes, pi)
					if fStackOff >= 0 {
						var tmp int = scratchReg(rm)
						spillScalarStackArg(a, tmp, aarch64.MemImm(aarch64.SP, stackArgsBase + fStackOff), rm.CC,
								p.Typ)
						aarch64.Str(a, true, tmp, aarch64.MemImm(aarch64.SP, off))
						rm.ResetRegs()
					}
				}
			}
			nsrn = nsrn + 1
			continue
		}
		// HFA parameter: the struct's float members arrive in
		// D(nsrn..nsrn+N-1) (or, on FP overflow, as words on the
		// incoming-args stack).  Like any aggregate param, the struct BYTES
		// live in the param's data region (LookupAlloc) and the 8-byte spill
		// slot holds a POINTER to that region — that is the uniform
		// representation every downstream aggregate consumer (OP_EXTRACT,
		// struct copy, address-of) resolves through.  So write each member
		// into the data region at byte offset hfaW*m (same-width members, no
		// padding), then publish the data-region pointer into the spill slot,
		// exactly as the GP-passed aggregate path below does — the only
		// difference is the source (FP registers vs GP arg registers).
		// Writing the float bits into the spill slot itself would both
		// overrun the 8-byte slot and leave the pointer unset, so downstream
		// reads would dereference raw float bits (UAF / segfault).
		hfaN, hfaW := types.HfaClassify(p.Typ)
		if rm.CC.HfaAggregates && hfaN > 0 {
			var dataOff int = rm.LookupAlloc(p.ID)
			var sz int = rm.LookupAllocSize(p.ID)
			if dataOff < 0 || sz <= 0 { continue }
			if nsrn + hfaN <= rm.CC.NumFpArgRegs {
				for m := 0; m < hfaN; m++ {
					var tmp int = scratchReg(rm)
					aarch64.Fmov_fp_to_gp(a, tmp, aarch64.D0 + nsrn + m)
					aarch64.StrSized(a, hfaW, tmp, aarch64.MemImm(aarch64.SP, dataOff + hfaW * m))
					rm.ResetRegs()
				}
				nsrn = nsrn + hfaN
			} else {
				var hsOff int = rm.CC.CallArgStackOff(paramTypes, pi)
				var hnWords int = common.ArgWords(p.Typ)
				if hsOff >= 0 {
					for w := 0; w < hnWords; w++ {
						var tmp int = scratchReg(rm)
						aarch64.Ldr(a, true, tmp, aarch64.MemImm(aarch64.SP, stackArgsBase + hsOff + 8 * w))
						aarch64.Str(a, true, tmp, aarch64.MemImm(aarch64.SP, dataOff + 8 * w))
						rm.ResetRegs()
					}
				}
				nsrn = rm.CC.NumFpArgRegs
			}
			var spillOff int = rm.LookupSpill(p.ID)
			if spillOff >= 0 {
				var tmp2 int = scratchReg(rm)
				aarch64.Add(a, true, tmp2, aarch64.SP, aarch64.Imm(dataOff))
				aarch64.Str(a, true, tmp2, aarch64.MemImm(aarch64.SP, spillOff))
			}
			rm.ResetRegs()
			continue
		}
		var regStart int = rm.CC.CallArgRegStart(paramTypes, pi)
		var stackOff int = rm.CC.CallArgStackOff(paramTypes, pi)
		if common.IsAggregateTyp(p.Typ) {
			// Indirect-large: pkg/codegen emits the function param
			// as `ptr byval(<T>) align 8`, and LLVM-AArch64 lowers
			// to "pointer in next free X reg (or 1 stack word)".
			// AAPCS byval semantics give the callee its own copy of
			// the struct — memcpy from the caller-supplied pointer
			// into the local data region so downstream
			// `paramSlots[i]` references (which natively resolve to
			// sp + AllocOff for aggregates) read the right bytes.
			// Also write the data-region pointer to the spill slot
			// (matches the slice-spread path's `Add tmp, sp,
			// AllocOff; Str` so downstream EmitLoad-then-pass paths
			// see a uniform pointer there).
			if rm.CC.IndirectLargeAggregates && p.Typ.SizeOf() > rm.CC.AggregateInRegMax {
				var dataOff int = rm.LookupAlloc(p.ID)
				var sz int = rm.LookupAllocSize(p.ID)
				if dataOff < 0 || sz <= 0 { continue }
				// Get the byval pointer into a known register.
				var ptr int = aarch64.X16
				if regStart >= 0 {
					if argReg(regStart) != ptr {
						aarch64.Mov(a, true, ptr, aarch64.Reg(argReg(regStart)))
					}
				} else if stackOff >= 0 {
					aarch64.Ldr(a, true, ptr, aarch64.MemImm(aarch64.SP, stackArgsBase + stackOff))
				}
				// Copy struct words from *ptr to sp+dataOff.
				var nWords int = common.ArgWords(p.Typ)
				var tmp int = scratchReg(rm)
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true, tmp, aarch64.MemImm(ptr, 8 * w))
					aarch64.Str(a, true, tmp, aarch64.MemImm(aarch64.SP, dataOff + 8 * w))
				}
				var spillOff int = rm.LookupSpill(p.ID)
				if spillOff >= 0 {
					var tmp2 int = scratchReg(rm)
					aarch64.Add(a, true, tmp2, aarch64.SP, aarch64.Imm(dataOff))
					aarch64.Str(a, true, tmp2, aarch64.MemImm(aarch64.SP, spillOff))
				}
				rm.ResetRegs()
				continue
			}
			var dataOff int = rm.LookupAlloc(p.ID)
			var sz int = rm.LookupAllocSize(p.ID)
			if dataOff < 0 || sz <= 0 { continue }
			var nWords int = common.ArgWords(p.Typ)
			// ≤ AggregateInRegMax: spread/split per AAPCS § 5.4.2 —
			// store regs first to the data region, then copy any
			// overflow words from caller's outgoing-args area.  With
			// both regStart and stackOff non-negative the arg straddles
			// the X0..X7 boundary.
			var regWords int = 0
			if regStart >= 0 {
				regWords = nWords
				if stackOff >= 0 { regWords = 8 - regStart }
				for w := 0; w < regWords; w++ {
					aarch64.Str(a, true, argReg(regStart + w), aarch64.MemImm(aarch64.SP, dataOff + 8 * w))
				}
			}
			if stackOff >= 0 {
				var tmp int = scratchReg(rm)
				for w := regWords; w < nWords; w++ {
					aarch64.Ldr(a, true, tmp,
							aarch64.MemImm(aarch64.SP, stackArgsBase + stackOff + 8 * (w - regWords)))
					aarch64.Str(a, true, tmp, aarch64.MemImm(aarch64.SP, dataOff + 8 * w))
				}
			}
			var spillOff int = rm.LookupSpill(p.ID)
			if spillOff >= 0 {
				var tmp2 int = scratchReg(rm)
				aarch64.Add(a, true, tmp2, aarch64.SP, aarch64.Imm(dataOff))
				aarch64.Str(a, true, tmp2, aarch64.MemImm(aarch64.SP, spillOff))
			}
			rm.ResetRegs()
		} else {
			var off int = rm.LookupSpill(p.ID)
			if off < 0 { continue }
			var phome int = rm.LookupHome(p.ID)
			if regStart >= 0 {
				if phome >= 0 {
					// Register-allocated param: move it from its arg register to
					// its home register (off the volatile X0..X7 before the
					// first clobbering op).
					aarch64.Mov(a, true, phome, aarch64.Reg(argReg(regStart)))
				} else {
					aarch64.Str(a, true, argReg(regStart), aarch64.MemImm(aarch64.SP, off))
				}
			} else if phome >= 0 {
				// Register-allocated param arriving on the incoming-args stack:
				// load it (sized / sign-extended) straight into its home register.
				spillScalarStackArg(a, phome, aarch64.MemImm(aarch64.SP, stackArgsBase + stackOff), rm.CC,
						p.Typ)
			} else {
				var tmp int = scratchReg(rm)
				spillScalarStackArg(a, tmp, aarch64.MemImm(aarch64.SP, stackArgsBase + stackOff), rm.CC, p.Typ)
				aarch64.Str(a, true, tmp, aarch64.MemImm(aarch64.SP, off))
				rm.ResetRegs()
			}
		}
	}

	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		if bi > 0 {
			a.DefineLabel(blockLabel(sym, b.Label))
		}
		// Each block starts with a fresh regmap. Cross-block values
		// flow through spill slots.
		rm.ResetRegs()
		var lb @[]@[]bool = liveBefore[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			// Fresh current-instruction register-claim set; the retained value
			// cache (IDs/Regs) carries forward within the block so a use reads a
			// register instead of reloading.
			rm.ClearUsed()
			// Pre-op barrier: an op whose emitter drops the register cache
			// mid-emission (an internal rm.ResetRegs, reloading its operands from
			// their slots) or clobbers a pool register directly must find the
			// values live INTO it already spilled — spill them, then reset.  This
			// is a DENYLIST: the returning-BL family (calls / make / box /
			// make-slice / iface / sat-lookup / stack-frames / div-shift guards /
			// refdec — EmitsReturningBl), OP_RETURN's multi-return sret store, and
			// OP_RODATA_ARRAY's inline byte-store loop (which resets and writes X9
			// directly, and emits no fixup so the post-op branchEmitted barrier
			// would miss it).  A NEW op whose emitter resets the cache or writes a
			// pool register outside allocReg MUST be added here.
			if common.EmitsReturningBl(ins.Op) || ins.Op == iropcode.OP_RETURN ||
					ins.Op == iropcode.OP_RODATA_ARRAY {
				spillDirtyLive(a, rm, lb[ii])
				rm.ResetRegs()
			}
			// A block-terminating branch (OP_JUMP / OP_BRANCH) transfers control
			// away, so any value live OUT of the block that is still dirty in a pool
			// register must be stored to its slot BEFORE the branch.  The post-op /
			// block-end spill runs AFTER emitInstr, which for a branch places the
			// store past the branch: dead on the taken path, and wholly unreachable
			// after an unconditional back-edge — so a loop counter's `i = i + 1`
			// never persists to its slot and the loop reloads the stale value
			// forever (an infinite loop).  spillDirtyLive keeps the values CACHED
			// (it only marks them clean, never evicts), so an OP_BRANCH's condition
			// operand is still readable by emitInstr; the post-op ResetRegs still
			// drops the cache afterward, and the now-clean post-op / block-end
			// spills become no-ops.
			if ins.Op == iropcode.OP_JUMP || ins.Op == iropcode.OP_BRANCH {
				spillDirtyLive(a, rm, lb[ii + 1])
			}
			var fixupsBefore int = a.Sections[a.Current].NumFixups
			emitInstr(a, pkgName, sym, rm, strings, ins)
			var branchEmitted bool = a.Sections[a.Current].NumFixups != fixupsBefore
			// Record the result: allocatable scalar dirty-marked (deferred /
			// elided store), non-allocatable eagerly stored.
			handleResult(a, rm, ins)
			// X16/X17 (AAPCS IP0/IP1) are never retained across a call / shim /
			// large-imm base that uses them directly; a value the last-resort
			// allocator parked there must not survive.  Evict every instruction
			// (spill-aware); a no-op when they hold nothing.
			storeDirtyOnEvict(rm, aarch64.X16)
			rm.EvictReg(aarch64.X16)
			storeDirtyOnEvict(rm, aarch64.X17)
			rm.EvictReg(aarch64.X17)
			// A returning BL clobbers every caller-saved pool register, and a
			// branch to a skipped inline block may too — spill the values live
			// OUT of this op, then drop the cache.
			if branchEmitted || common.EmitsReturningBl(ins.Op) {
				spillDirtyLive(a, rm, lb[ii + 1])
				rm.ResetRegs()
			}
		}
		// Block end: spill the dirty values live OUT of the block; the next
		// block's entry ResetRegs drops the dead remainder unstored.
		spillDirtyLive(a, rm, lb[len(b.Instrs)])
	}

	// Safety net: emit an epilogue if the IR didn't end with OP_RETURN.
	emitEpilogueAndRet(a, rm)
}

// aarch64AllocatablePool returns the registers the linear-scan allocator
// homes scalar values in: the callee-saved bank X19..X28.  Callee-saved so a
// homed value survives every call (preserved by our own prologue/epilogue and
// by callees), and disjoint from the X9..X17 scratch pool so operand reloads
// and op-internal scratch are unaffected.
func aarch64AllocatablePool() @[]int {
	var p @[]int = make_slice(int, 10)
	for i := 0; i < 10; i++ { p[i] = aarch64.X19 + i }
	return p
}
