package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// emitFunc is exercised end-to-end by arm64_test.bn's EmitObject
// round-trips and by every conformance test running through
// boot-comp_native_aa64-*.  This file pins narrow invariants
// directly on emitFunc so a regression in prologue/epilogue
// emission stays observable at the unit-test level.

// TestEmitFuncEmitsLabelAndProlog verifies that lowering a trivial
// zero-arg, zero-block-instruction function (`func f() {}`) at
// minimum emits the function's exported symbol label and a
// non-empty text section (the AAPCS64 prologue stp+mov + the
// safety-net epilogue is the minimum any function gets).
func TestEmitFuncEmitsLabelAndProlog() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)

	var f @ir.Func = make(ir.Func)
	f.Name = "test.f"
	var noParams @[]@ir.Param
	f.Params = noParams
	var noResults @[]@types.Type
	f.Results = noResults
	var entry @ir.Block = make(ir.Block)
	entry.Label = "entry.0"
	var noInstrs @[]@ir.Instr
	entry.Instrs = noInstrs
	f.Blocks = appendBlockPtr_aa64test(f.Blocks, entry)

	var strings @[]ir.StringConst

	emitFunc(a, "test", f, strings)

	if a.Sections[0].Len == 0 {
		return fail("emitFunc should emit at least the prologue + safety-net ret")
	}
	// At minimum: stp (4 bytes) + mov (4 bytes) + ret-style epilogue
	// → > 8 bytes.  We don't pin the exact count — emitEpilogueAndRet
	// can vary — only that the function isn't empty.
	if a.Sections[0].Len < 8 {
		return fail("emitFunc emitted suspiciously few bytes")
	}
	return ""
}

// #[c_export] mints a second, unmangled strong-global symbol for the function's C
// entry.  With NO narrow reg params (this test's no-param `Add`) the C-entry
// normalization prefix is empty, so the alias sits at the SAME section + offset as
// the mangled symbol.  (A narrow reg param makes the prefix non-empty and moves the
// mangled symbol after it — see TestEmitFuncCExportNarrowParamPrefix.)  The lookup
// uses the same symPrefixed() the emitter uses, so it matches regardless of the
// default object-symbol prefix.
func TestEmitFuncCExportAlias() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)

	var f @ir.Func = make(ir.Func)
	f.Name = "test.Add"
	var noParams @[]@ir.Param
	f.Params = noParams
	var noResults @[]@types.Type
	f.Results = noResults
	var entry @ir.Block = make(ir.Block)
	entry.Label = "entry.0"
	var noInstrs @[]@ir.Instr
	entry.Instrs = noInstrs
	f.Blocks = appendBlockPtr_aa64test(f.Blocks, entry)
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr("add_ints"))
	f.CExportNames = names

	var strings @[]ir.StringConst
	emitFunc(a, "test", f, strings)

	var mangledIdx int = a.LookupSymbol(symFor("test", "test.Add"))
	if mangledIdx < 0 {
		return fail("mangled function symbol missing")
	}
	var aliasIdx int = a.LookupSymbol(symPrefixed("add_ints"))
	if aliasIdx < 0 {
		return fail("c_export alias symbol `add_ints` missing")
	}
	if a.Symbols[aliasIdx].Offset != a.Symbols[mangledIdx].Offset {
		return fail("c_export alias must sit at the function's entry offset")
	}
	if a.Symbols[aliasIdx].Section != a.Symbols[mangledIdx].Section {
		return fail("c_export alias must be in the function's section")
	}
	if a.Symbols[aliasIdx].Binding != asm.BIND_GLOBAL {
		return fail("c_export alias must be a strong global")
	}
	return ""
}

// A #[c_export] function with a NARROW reg param gets a non-empty C-entry thunk: the alias
// sits BEFORE the mangled symbol, and the thunk is the argument-register normalization plus
// a branch to the mangled entry (a C caller enters at the alias, extends the dirty high
// bits, and branches into the body; a native caller enters at the mangled symbol and skips
// it).  The branch is load-bearing — ld64 links the alias as its own atom, so a bare
// fall-through would break.  Pins the thunk PLACEMENT (alias offset < mangled offset) and
// CONTENT (SXTW for the single int32 arg register, then the branch).
func TestEmitFuncCExportNarrowParamPrefix() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)

	var f @ir.Func = make(ir.Func)
	f.Name = "test.Sgn"
	var p @ir.Param = make(ir.Param)
	p.ID = 1
	p.Typ = types.TypInt32()
	f.Params = slices.Append[@ir.Param](f.Params, p)
	var noResults @[]@types.Type
	f.Results = noResults
	var entry @ir.Block = make(ir.Block)
	entry.Label = "entry.0"
	var noInstrs @[]@ir.Instr
	entry.Instrs = noInstrs
	f.Blocks = appendBlockPtr_aa64test(f.Blocks, entry)
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr("ffi_sgn"))
	f.CExportNames = names

	var strings @[]ir.StringConst
	emitFunc(a, "test", f, strings)

	var mangledIdx int = a.LookupSymbol(symFor("test", "test.Sgn"))
	var aliasIdx int = a.LookupSymbol(symPrefixed("ffi_sgn"))
	if mangledIdx < 0 || aliasIdx < 0 {
		return fail("c_export narrow-param: alias or mangled symbol missing")
	}
	var aliasOff int = cast(int, a.Symbols[aliasIdx].Offset)
	var mangledOff int = cast(int, a.Symbols[mangledIdx].Offset)
	if aliasOff >= mangledOff {
		return fail("narrow-param c_export alias must precede the mangled entry (non-empty prefix)")
	}
	// The thunk is SXTW x0, w0 (the sole int32 arg register) then a branch to the mangled
	// entry (the branch is emitted as its placeholder opcode pre-fixup, matching here).
	var want @asm.Assembler = asm.New(8)
	want.SetSection("text", -1)
	aarch64.Sxtw(want, aarch64.X0, aarch64.X0)
	aarch64.B(want, symFor("test", "test.Sgn"))
	if mangledOff - aliasOff != want.Sections[0].Len {
		return fail("c_export thunk length must equal SXTW + branch")
	}
	var gd @[]uint8 = a.Sections[0].Data
	var wd @[]uint8 = want.Sections[0].Data
	for i := 0; i < want.Sections[0].Len; i++ {
		if gd[aliasOff + i] != wd[i] {
			return fail("c_export thunk bytes must be the int32 SXTW + branch")
		}
	}
	return ""
}

// TestAarch64CCSelectsByObjFormat pins the target-conditional calling
// convention: ELF (aarch64-linux) uses textbook AAPCS64 — 8-byte-rounded stack
// slots and register-then-stack variadics — while Mach-O (aarch64-darwin) uses
// Apple's AAPCS64_Darwin variant (natural-size narrow stack args + every
// variadic on the stack).  Those two flags are exactly what diverges, so
// pinning them guards against re-hardcoding the Apple ABI on Linux (which
// mismarshals narrow / variadic args vs clang — conformance 896 / 500).
func TestAarch64CCSelectsByObjFormat() testing.TestResult {
	objEmitElf = true
	var elf common.CallConv = aarch64CC()
	objEmitElf = false // restore the backend's Mach-O default before asserting
	var macho common.CallConv = aarch64CC()
	if elf.NaturalSizeStackArgs {
		return fail("ELF/AAPCS64 must round narrow stack args to 8 bytes, not pack natural-size")
	}
	if elf.VariadicStackOnly {
		return fail("ELF/AAPCS64 must fill variadic registers before spilling to the stack")
	}
	if !macho.NaturalSizeStackArgs {
		return fail("Mach-O/Apple must pack narrow scalar stack args at natural size")
	}
	if !macho.VariadicStackOnly {
		return fail("Mach-O/Apple must stack every variadic arg")
	}
	return ""
}

func appendBlockPtr_aa64test(s @[]@ir.Block, v @ir.Block) @[]@ir.Block {
	var n @[]@ir.Block = make_slice(@ir.Block, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}
