package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Incoming-parameter spilling for the AAPCS64 prologue: land each register /
// stack parameter into its frame slot (or home register), with narrow-scalar
// re-extension and the #[c_export] C-entry register normalization.  Split from
// aarch64_emit_func.bn along the natural parameter-handling boundary.

// spillScalarStackArg loads an incoming SCALAR stack argument into rt, sized AND
// sign-/zero-extended to the arg's packed footprint.  Darwin aarch64 packs sub-word
// stack args at their natural size (bool/int8 at 1, int16 at 2, int32/float32 at 4), so
// a full 8-byte load would pull in the ADJACENT packed arg's bytes + uninitialized slot
// padding — wrong once mem2reg promotes the arg and a 64-bit CMP/CBNZ tests it.  The
// backend keeps a sub-word value SIGN-extended in its 64-bit home and reloads it with a
// plain 8-byte LDR that does NOT re-extend (getOperand; see emitSubWordNarrow /
// conformance 416), so a SIGNED narrow arg must be sign-extended HERE (LDRSB/LDRSH/LDRSW)
// and a bool / unsigned / float zero-extended (LDRB/LDRH/32-bit LDR).  natSize 0 or >= 8
// (a full-word / 8-byte-slotted arg) loads the whole 8-byte word.
//
// On a non-packing convention (AAPCS64-linux, StackArgNaturalSize == 0) the natural-size
// extend is applied UNCONDITIONALLY: a C caller (a #[c_export] entry, or a function reached
// through a `__c_entry` callback pointer) stores only the arg's low natural-size bytes into
// the 8-byte slot and leaves the rest junk, so a narrow integer / bool arg is loaded at its
// natural size and extended rather than as a contaminated 8-byte word.  A native caller
// stores the full extended word (aarch64_call.bn's 8-byte stack-arg store), so the
// narrow-size load reproduces the same value — idempotent, one-for-one instruction swap.
// Doing it here at the mangled entry (which every caller reaches) also covers a
// non-#[c_export] `__c_entry` target whose callback thunk normalizes only the argument
// registers.  Floats / aggregates are excluded.  On darwin StackArgNaturalSize is already
// non-zero, so this branch is inert.
func spillScalarStackArg(a @asm.Assembler, rt int, mem aarch64.Operand, cc callconv.CallConv,
		t @types.Type) {
	var natSize int = cc.StackArgNaturalSize(t, false)
	if natSize == 0 && !callconv.IsAggregateTyp(t) && !callconv.IsFloatScalarTyp(t) {
		var sz int = t.SizeOf()
		if sz > 0 && sz < 8 {
			natSize = sz
		}
	}
	var signed bool
	_, signed = common.SubWordNarrow(t, 64)
	if natSize == 1 {
		if signed {
			aarch64.Ldrsb(a, true, rt, mem)
		} else {
			aarch64.Ldrb(a, rt, mem)
		}
	} else if natSize == 2 {
		if signed {
			aarch64.Ldrsh(a, true, rt, mem)
		} else {
			aarch64.Ldrh(a, rt, mem)
		}
	} else if natSize == 4 {
		if signed {
			aarch64.Ldrsw(a, rt, mem)
		} else {
			aarch64.Ldr(a, false, rt, mem)
		}
	} else {
		aarch64.Ldr(a, true, rt, mem)
	}
}

// normalizeNarrowRegParam restores the sign-/zero-extension invariant for a narrow GP
// register parameter of a #[c_export] function.  Binate's own calls keep a sub-word value
// sign-extended (signed) / zero-extended (bool / unsigned) in its 64-bit home, and the
// backend reloads it with a plain 8-byte LDR that does NOT re-extend; a C caller only
// guarantees the low bits (AAPCS64 leaves the argument register's high bits unspecified),
// so a promoted -O1+ 64-bit use of such a param would read garbage.  Extend the argument
// register in place before the spill.  Word-sized / pointer params emit nothing.
func normalizeNarrowRegParam(a @asm.Assembler, reg int, t @types.Type) {
	var sz int = t.SizeOf()
	if sz <= 0 || sz >= 8 {
		return
	}
	var signed bool
	_, signed = common.SubWordNarrow(t, 64)
	if sz == 1 {
		if signed {
			aarch64.Sxtb(a, true, reg, reg)
		} else {
			aarch64.Uxtb(a, reg, reg)
		}
	} else if sz == 2 {
		if signed {
			aarch64.Sxth(a, true, reg, reg)
		} else {
			aarch64.Uxth(a, reg, reg)
		}
	} else if sz == 4 {
		if signed {
			aarch64.Sxtw(a, reg, reg)
		} else {
			aarch64.Uxtw(a, reg, reg)
		}
	}
}

// emitCExportRegNorm emits the #[c_export] C-entry prefix: for each narrow GP scalar
// parameter passed in an argument register, sign-/zero-extend it in place.  The register set
// comes from callconv.CEntryRegNormWalk — the same classification the __c_entry thunk-emission
// decision uses (AAPCS64 puts sret in X8, not a GP arg reg, so it applies no arg shift; HFAs
// are aggregates and are excluded), so the argReg mapping matches the mangled entry's spill.
// Emitted as the c_export C-entry thunk (before the mangled `sym`, which the caller branches
// to): a C caller entering at the alias, whose high argument-register bits AAPCS64 leaves
// unspecified, runs these extends; a native caller entering at `sym` skips them.
func emitCExportRegNorm(a @asm.Assembler, rm @common.RegMap, f @ir.Func) {
	var regStarts @[]int
	var regTypes @[]@types.Type
	regStarts, regTypes = callconv.CEntryRegNormWalk(f, rm.CC)
	for i := 0; i < len(regStarts); i++ {
		normalizeNarrowRegParam(a, argReg(regStarts[i]), regTypes[i])
	}
}

// spillAggregateParamAA64 lands incoming aggregate parameter p — index pi of the
// classification types paramTypes — for the prologue, returning the FP argument
// cursor (NSRN) past it and true, or nsrn and false when p is not an aggregate.  The
// parameter's value is a pointer to its bytes, kept in its spill slot.  Where they
// arrive in memory the callee owns — a pointer to the caller's copy (PassesIndirect),
// or the stack (an HFA past the FP registers, an aggregate wholly on the stack) —
// it is the address of those bytes (PlanFrame gives the parameter no region);
// otherwise the parameter's data region, filled from its FP registers (an HFA:
// member m at byte hfaW*m, same-width members, no padding) or its GP registers.
func spillAggregateParamAA64(a @asm.Assembler, rm @common.RegMap, p @ir.Param,
		paramTypes @[]@types.Type, pi int, stackArgsBase int, nsrn int) (int, bool) {
	hfaN, hfaW := types.HfaClassify(p.Typ)
	if rm.CC.HfaAggregates && hfaN > 0 {
		if nsrn + hfaN > rm.CC.NumFpArgRegs {
			var hso int = rm.CC.CallArgStackOff(paramTypes, pi)
			if hso >= 0 { emitParamAddrToSpillAA64(a, rm, p, stackArgsBase + hso) }
			rm.ResetRegs()
			return rm.CC.NumFpArgRegs, true
		}
		var hdata int = rm.NeedAlloc(a, p.ID, "native arm64: an aggregate parameter")
		if hdata < 0 || rm.LookupAllocSize(p.ID) <= 0 { return nsrn + hfaN, true }
		for m := 0; m < hfaN; m++ {
			var tmp int = scratchReg(rm)
			aarch64.Fmov_fp_to_gp(a, tmp, aarch64.D0 + nsrn + m)
			aarch64.StrSized(a, hfaW, tmp, aarch64.MemImm(aarch64.SP, hdata + hfaW * m))
			rm.ResetRegs()
		}
		emitParamAddrToSpillAA64(a, rm, p, hdata)
		rm.ResetRegs()
		return nsrn + hfaN, true
	}
	if !callconv.IsAggregateTyp(p.Typ) { return nsrn, false }
	// A zero-size aggregate has no bytes and no region.
	if p.Typ.SizeOf() <= 0 { return nsrn, true }
	var regStart int = rm.CC.CallArgRegStart(paramTypes, pi)
	var stackOff int = rm.CC.CallArgStackOff(paramTypes, pi)
	if rm.CC.PassesIndirect(p.Typ) {
		// The pointer, in the next free X register or one stack word.
		var ptr int = aarch64.X16
		if regStart >= 0 {
			if argReg(regStart) != ptr { aarch64.Mov(a, true, ptr, aarch64.Reg(argReg(regStart))) }
		} else if stackOff >= 0 {
			aarch64.Ldr(a, true, ptr, aarch64.MemImm(aarch64.SP, stackArgsBase + stackOff))
		}
		var ptrSpill int = rm.NeedSpill(a, p.ID, "native arm64: a parameter")
		if ptrSpill >= 0 { aarch64.Str(a, true, ptr, aarch64.MemImm(aarch64.SP, ptrSpill)) }
		rm.ResetRegs()
		return nsrn, true
	}
	if regStart < 0 {
		if stackOff >= 0 { emitParamAddrToSpillAA64(a, rm, p, stackArgsBase + stackOff) }
		rm.ResetRegs()
		return nsrn, true
	}
	var dataOff int = rm.NeedAlloc(a, p.ID, "native arm64: an aggregate parameter")
	if dataOff < 0 || rm.LookupAllocSize(p.ID) <= 0 { return nsrn, true }
	// In registers: AAPCS64 never splits an aggregate (regWordsAA64 reports a split
	// placement as a classifier bug).
	var regWords int = regWordsAA64(a, regStart, stackOff, callconv.ArgWords(p.Typ))
	for w := 0; w < regWords; w++ {
		aarch64.Str(a, true, argReg(regStart + w), aarch64.MemImm(aarch64.SP, dataOff + 8 * w))
	}
	emitParamAddrToSpillAA64(a, rm, p, dataOff)
	rm.ResetRegs()
	return nsrn, true
}

// emitParamAddrToSpillAA64 stores the address [SP + off] of an aggregate parameter's
// bytes — its data region, or where they arrived in memory the callee owns — into the
// parameter's spill slot, the pointer every use of its value reads.
func emitParamAddrToSpillAA64(a @asm.Assembler, rm @common.RegMap, p @ir.Param, off int) {
	var spillOff int = rm.NeedSpill(a, p.ID, "native arm64: a parameter")
	if spillOff < 0 { return }
	var tmp int = scratchReg(rm)
	aarch64.Add(a, true, tmp, aarch64.SP, aarch64.Imm(off))
	aarch64.Str(a, true, tmp, aarch64.MemImm(aarch64.SP, spillOff))
}
