package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// The handlers in arm64_emit.bn are exercised end-to-end by
// arm64_test.bn's EmitObject round-trips and by the conformance
// suite. These narrow unit tests verify the simplest observable
// property — that each handler emits the right number of bytes on a
// well-formed IR input — to guard against accidental regressions that
// would otherwise only surface at the conformance level.

func mkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func bytesWritten(a @asm.Assembler) int { return a.Sections[0].Len }

// emitAlloc on a scalar is a no-op (zero-init only applies to
// aggregates).
func TestEmitAllocScalarIsNoOp() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_ALLOC
	ins.TypeArg = types.TypInt()
	emitAlloc(a, rm, ins)
	if bytesWritten(a) != 0 { return "scalar alloc should emit nothing" }
	return ""
}

// emitAlloc on an aggregate emits a run of `str xzr, [sp, #off]`
// instructions — one per 8 bytes.
func TestEmitAllocAggregateZeroInits() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 7)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Op = iropcode.OP_ALLOC
	ins.TypeArg = types.MakeSliceType(types.TypInt())
	emitAlloc(a, rm, ins)
	// Two STR XZR instructions for the 16-byte slot = 8 bytes.
	if bytesWritten(a) != 8 {
		return "aggregate alloc should emit two STR XZR for 16-byte slot"
	}
	return ""
}

// emitConstInt64 with nonzero 16-bit chunks only at shift 0 and
// shift 48 must emit MOVZ + MOVK (8 bytes).  The high chunk
// (val >> 48) is reachable only because val is int64; with a 32-bit
// host `int` the value would truncate and the chunk would be lost,
// emitting just the MOVZ (4 bytes).
func TestEmitConstInt64HighChunkReachable() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var val int64 = (cast(int64, 1) << cast(int64, 48)) | cast(int64, 5)
	emitConstInt64(a, 0, val)
	if bytesWritten(a) != 8 {
		return "MOVZ+MOVK expected; high chunk at shift 48 must survive"
	}
	return ""
}

// emitConstNil on a scalar emits a single MOVZ rd, #0.
func TestEmitConstNilScalarIsSingleMovz() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 3)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_CONST_NIL
	ins.Typ = types.TypInt()
	emitConstNil(a, rm, ins)
	if bytesWritten(a) != 4 {
		return "scalar const_nil should emit a single 4-byte MOVZ"
	}
	return ""
}

// emitMake emits a non-trivial sequence (movz size, bl
// _bn_F3_3_pkg8_builtins2_rt1_5_Alloc, mov rd, x0). Not checking exact
// encoding — just that it fires.
func TestEmitMakeEmitsInstructions() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 5
	ins.Op = iropcode.OP_MAKE
	ins.TypeArg = types.TypInt()
	emitMake(a, rm, ins)
	if bytesWritten(a) == 0 {
		return "make should emit at least one instruction"
	}
	return ""
}

// emitConstNil on an aggregate type must zero-init its data region
// and produce a pointer to it (aggregate-pointer form). Distinct
// from the scalar path, which is just `movz rd, #0`.
func TestEmitConstNilAggregateZeroesAndPoints() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	// Planted data region and spill slot (as common.PlanFrame would).
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 11)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 11)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 11
	ins.Op = iropcode.OP_CONST_NIL
	ins.Typ = types.MakeSliceType(types.TypInt())
	emitConstNil(a, rm, ins)
	// Expect: 2× STR XZR (zero-init 16 bytes) + 1× ADD (pointer) =
	// 12 bytes.
	if bytesWritten(a) != 12 {
		return "aggregate const_nil should emit 2×STR XZR + 1×ADD"
	}
	return ""
}

// emitBox must use the OP_ALLOC fast path: compute the alloca's
// address into X0, load the size into X1, BL _bn_F3_3_pkg8_builtins2_rt1_3_Box. Missing
// the alloca check would silently fall through and produce garbage.
func TestEmitBoxFromAlloca() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	// Allocated struct of 16 bytes at offset 0.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 2)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 3)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	var alc @ir.Instr = make(ir.Instr)
	alc.ID = 2
	alc.Op = iropcode.OP_ALLOC
	alc.TypeArg = types.MakeArrayType(types.TypInt(), 2)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_BOX
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = alc
	emitBox(a, rm, ins)
	// ADD X0,SP,#off + MOVZ X1,#16 + BL + MOV rd,X0 = 16 bytes.
	if bytesWritten(a) != 16 {
		return "box-from-alloca should emit ADD+MOVZ+BL+MOV (16 bytes)"
	}
	return ""
}

// emitBox aggregate-load case: `box(iv)` for a loaded iv-value
// must emit the _bn_F3_3_pkg8_builtins2_rt1_3_Box call using the operand's spill-slot
// pointer as srcPtr.  Pre-fix this path silently returned (the
// early-return guard only handled OP_ALLOC), leaving the
// downstream `@`-pointer uninitialized.  Conformance 444 / 445 /
// 450 / 458 exercise this end-to-end; this unit test pins it at
// the emit layer.
func TestEmitBoxFromAggregateLoad() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = make(common.RegMap)
	// The operand is a 16-byte aggregate (an iv) spilled at offset
	// 0; the spill slot holds a pointer to the data, per
	// SpillHoldsAggregatePointer.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 6)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	// Build the iv-typed source instr.  No Op needed — we go
	// through the IsAggregateTyp branch which keys off val.Typ.
	var src @ir.Instr = make(ir.Instr)
	src.ID = 5
	src.Op = iropcode.OP_LOAD
	// Build an iv type by wrapping a placeholder iface.
	var iface @types.Type = types.MakeInterfaceType("test", "I")
	src.Typ = types.MakeInterfaceValueType(iface)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 6
	ins.Op = iropcode.OP_BOX
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	emitBox(a, rm, ins)
	// LDR (operand pointer from spill) + MOV X0,src + MOVZ X1,#16 +
	// BL _bn_F3_3_pkg8_builtins2_rt1_3_Box + MOV rd,X0 = 5 insns = 20 bytes.
	if bytesWritten(a) != 20 {
		return "box-from-aggregate-load should emit LDR+MOV+MOVZ+BL+MOV (20 bytes)"
	}
	return ""
}

// emitMakeSlice emits the sret form post round-5: MOVZ X0 (elem
// size), LDR len, MOV X1 (len reg), ADD X8 (sret = &dataRegion),
// BL _bn_F3_3_pkg8_builtins2_rt1_16_MakeManagedSlice, ADD rd (pointer to dataRegion)
// = 6 insns / 24 bytes.  No post-BL packed-register spill because
// the runtime wrote the 4-word header through X8.
func TestEmitMakeSliceSpillsFourWords() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 5)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 32)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 6)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 32)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 40)
	var lenArg @ir.Instr = make(ir.Instr)
	lenArg.ID = 6
	lenArg.Op = iropcode.OP_CONST_INT
	lenArg.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 5
	ins.Op = iropcode.OP_MAKE_SLICE
	ins.Typ = types.MakeManagedSliceType(types.TypInt())
	ins.TypeArg = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = lenArg
	emitMakeSlice(a, rm, ins)
	// MOVZ X0 + LDR len + MOV X1 + ADD X8 + BL + ADD rd = 6 insns.
	if bytesWritten(a) != 24 {
		return "make_slice should emit 6 instructions (24 bytes) sret form"
	}
	return ""
}

// emitAggMemcpyAarch64 moves 16 bytes per LDP/STP pair (two words in one
// instruction) with a single-word LDR/STR tail, so an N-word aggregate move
// costs ceil(N/2) pairs (+ one odd word) rather than N load/store pairs.  The
// 64-bit signed-offset LDP/STP opcodes have high byte 0xA9; a 64-bit LDR/STR
// (immediate) has high byte 0xF9.
func TestEmitAggMemcpy32BytesUsesTwoPairs() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitAggMemcpyAarch64(a, 10, 9, 32, 11, 12)
	if opsBytes(a) != 16 { return "32-byte copy should be 2 LDP + 2 STP = 16 bytes" }
	if a.Sections[0].Data[3] != 0xA9 {
		return "first instr of a >=2-word copy should be an LDP (0xA9)"
	}
	return ""
}

func TestEmitAggMemcpy8BytesUsesSingleWord() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitAggMemcpyAarch64(a, 10, 9, 8, 11, 12)
	if opsBytes(a) != 8 { return "8-byte copy should be 1 LDR + 1 STR = 8 bytes" }
	if a.Sections[0].Data[3] != 0xF9 { return "a single-word copy should use LDR (0xF9), not a pair" }
	return ""
}

func TestEmitAggMemcpy24BytesPairThenWord() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitAggMemcpyAarch64(a, 10, 9, 24, 11, 12)
	// One 16-byte pair then one 8-byte word: LDP + STP + LDR + STR = 16 bytes.
	if opsBytes(a) != 16 { return "24-byte copy should be LDP+STP+LDR+STR = 16 bytes" }
	return ""
}

func TestEmitAggMemcpyBeyondLdpRangeFallsBackToWords() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	// 528 bytes: 32 pairs cover the first 512 bytes (offsets 0..496, the last
	// pair whose base offset <= 504); the remaining two words are past LDP's
	// signed imm7-scaled reach, so they emit as single LDR/STR.  32*2 + 2*2 =
	// 68 instrs = 272 bytes, and the final instruction is a word STR (0xF9).
	emitAggMemcpyAarch64(a, 10, 9, 528, 11, 12)
	if opsBytes(a) != 272 { return "528-byte copy should be 32 pairs + 2 word tail = 272 bytes" }
	if a.Sections[0].Data[271] != 0xF9 {
		return "tail past LDP range should fall back to a word LDR/STR (0xF9)"
	}
	return ""
}

// emitAggMemcpySafeAarch64 must be OVERLAP-SAFE: it loads the WHOLE source before
// storing, so for a multi-word copy every LOAD (LDP/LDR, bit 22 = 1) precedes every
// STORE (STP/STR, bit 22 = 0).  A 24-byte copy is 2 loads (LDP + LDR) then 2 stores.
func TestEmitAggMemcpySafeLoadsBeforeStores() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	emitAggMemcpySafeAarch64(a, m, 10, 9, 24)
	var n int = opsBytes(a)
	if n != 16 { return "24-byte overlap-safe copy should be 2 loads + 2 stores = 16 bytes" }
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var d *[]uint8 = a.Sections[0].Data
	var lastLoad int = -1
	var firstStore int = -1
	for off := 0; off + 4 <= n; off = off + 4 {
		var w uint32 = cast(uint32, d[off]) | (cast(uint32, d[off + 1]) << 8) |
				(cast(uint32, d[off + 2]) << 16) | (cast(uint32, d[off + 3]) << 24)
		if ((w >> 22) & cast(uint32, 0x1)) == cast(uint32, 0x1) {
			lastLoad = off
		} else if firstStore < 0 {
			firstStore = off
		}
	}
	if lastLoad < 0 || firstStore < 0 || lastLoad >= firstStore {
		return "overlap-safe copy must emit every load before every store"
	}
	return ""
}

// instrTopByte returns the most significant byte of the i-th 4-byte instruction.
func instrTopByte(a @asm.Assembler, i int) uint8 { return a.Sections[0].Data[4 * i + 3] }

// An 11-byte copy moves one word, then the 3-byte tail exactly — LDRH/STRH and
// LDRB/STRB (top bytes 0x79 and 0x39), never a word store past byte 11, which
// would overwrite whatever follows the destination.
func TestEmitAggMemcpySubWordTailIsExact() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitAggMemcpyAarch64(a, 10, 9, 11, 11, 12)
	if opsBytes(a) != 24 { return "11-byte copy should be word + halfword + byte = 6 instructions" }
	if instrTopByte(a, 3) != 0x79 || instrTopByte(a, 5) != 0x39 {
		return "the 3-byte tail should be stored as STRH then STRB"
	}
	return ""
}

// The overlap-safe copy covers a tail from 8 bytes up with one overlapping word
// ending at the size — an unscaled LDUR/STUR (top byte 0xF8) at offset 3 for an
// 11-byte copy — still loading everything before storing anything.
func TestEmitAggMemcpySafeOverlappingTailWord() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	emitAggMemcpySafeAarch64(a, m, 10, 9, 11)
	if opsBytes(a) != 16 { return "11-byte overlap-safe copy should be 2 loads + 2 stores" }
	if instrTopByte(a, 1) != 0xF8 || instrTopByte(a, 3) != 0xF8 {
		return "the tail word should be an unscaled LDUR/STUR ending at the size"
	}
	return ""
}

// Below 8 bytes the overlap-safe copy is two sub-word pieces at most: a 7-byte
// copy is two 4-byte words (at 0 and 3), never an 8-byte store.
func TestEmitAggMemcpySafeSevenBytes() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	emitAggMemcpySafeAarch64(a, m, 10, 9, 7)
	if opsBytes(a) != 16 { return "7-byte overlap-safe copy should be 2 loads + 2 stores" }
	for i := 0; i < 4; i++ {
		var top uint8 = instrTopByte(a, i)
		if top != 0xB9 && top != 0xB8 { return "a 7-byte copy should use only 32-bit accesses" }
	}
	return ""
}

// An aggregate OP_ALLOC marked NoZeroInit (fully written before anything reads
// it) emits no zeroing stores.
func TestEmitAllocNoZeroInit() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 7)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Op = iropcode.OP_ALLOC
	ins.TypeArg = types.MakeSliceType(types.TypInt())
	ins.NoZeroInit = true
	emitAlloc(a, rm, ins)
	if bytesWritten(a) != 0 { return "a NoZeroInit slot should emit no zeroing stores" }
	return ""
}
