package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/macho"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// aarch64Emitter is the aarch64 impl of common.ArchEmitter: it routes the
// shared common.EmitObject skeleton's per-arch steps to this package's
// emission helpers.  Stateless — the object-format linkage prefix lives in
// the package-global objEmitElf, set/cleared via SetPrefix/ClearPrefix.  Each
// method realises the like-named common.ArchEmitter method (contract there).
type aarch64Emitter struct {
}

// WordBytes — AArch64 is LP64.
func (e *aarch64Emitter) WordBytes() int { return 8 }

// CallConv returns the AArch64 calling convention for the current object format
// (aarch64CC selects AAPCS64 / AAPCS64_Darwin off objEmitElf, set by SetPrefix,
// which EmitObject calls before it reads the CallConv).
func (e *aarch64Emitter) CallConv() common.CallConv { return aarch64CC() }

// SetPrefix installs the linkage prefix: ELF symbols are bare, Mach-O
// symbols carry a leading '_'.
func (e *aarch64Emitter) SetPrefix(format *[]readonly char) {
	objEmitElf = common.ObjFmtEq(format, "elf")
}

// ClearPrefix restores this backend's macOS (Mach-O) default.
func (e *aarch64Emitter) ClearPrefix() {
	objEmitElf = false
}

// SymPrefixed applies the active object-format linkage prefix.
func (e *aarch64Emitter) SymPrefixed(name *[]readonly char) @[]char {
	return symPrefixed(name)
}

// ArchName is the tag for a ReportEmitError diagnostic.
func (e *aarch64Emitter) ArchName() *[]readonly char {
	return "aarch64"
}

// EmitFunc lowers one function's text.
func (e *aarch64Emitter) EmitFunc(a @asm.Assembler, pkgName *[]readonly char, f @ir.Func,
		strings @[]ir.StringConst) {
	emitFunc(a, pkgName, f, strings)
}

// EmitCEntryThunks lowers the weak __c_entry adaptation thunks.
func (e *aarch64Emitter) EmitCEntryThunks(a @asm.Assembler, pkgName *[]readonly char,
		targets @[]@ir.Func) {
	emitCEntryThunks(a, pkgName, targets)
}

// EmitFuncValueShims lowers the module's function-value call shims.
func (e *aarch64Emitter) EmitFuncValueShims(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	emitFuncValueShims(a, pkgName, mod)
}

// EmitStringTable lowers the collected string-literal table.
func (e *aarch64Emitter) EmitStringTable(a @asm.Assembler, pkgName *[]readonly char,
		strings @[]ir.StringConst) {
	emitStringTable(a, pkgName, strings)
}

// EmitGlobals lowers package-level variable storage.
func (e *aarch64Emitter) EmitGlobals(a @asm.Assembler, pkgName *[]readonly char,
		globals @[]@ir.Global) {
	emitGlobals(a, pkgName, globals)
}

// EmitFuncValueVtables lowers the function-value vtables.
func (e *aarch64Emitter) EmitFuncValueVtables(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	emitFuncValueVtables(a, pkgName, mod)
}

// EmitImplVtables lowers the interface-impl vtables.
func (e *aarch64Emitter) EmitImplVtables(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	emitImplVtables(a, pkgName, mod)
}

// EmitPackageDescriptor lowers the reflect / package descriptor.
func (e *aarch64Emitter) EmitPackageDescriptor(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	emitPackageDescriptor(a, pkgName, mod)
}

// ResolveFixups patches same-section fixups.
func (e *aarch64Emitter) ResolveFixups(a @asm.Assembler) {
	aarch64.ResolveFixups(a)
}

// ElfTextMappingSymbol is "$x" (A64 code) for ELF output; Mach-O (this backend's
// default darwin format) has no mapping symbols, so "".
func (e *aarch64Emitter) ElfTextMappingSymbol(format *[]readonly char) *[]readonly char {
	if common.ObjFmtEq(format, "elf") {
		return "$x"
	}
	return ""
}

// WriteObject — the writer follows the object-format axis: ELF (Linux) vs
// Mach-O (macOS, this backend's default).
func (e *aarch64Emitter) WriteObject(a @asm.Assembler, format *[]readonly char,
		path *[]readonly char) bool {
	if common.ObjFmtEq(format, "elf") {
		return elf.WriteAArch64(a, path)
	}
	return macho.WriteARM64(a, path)
}

impl *aarch64Emitter : common.ArchEmitter
