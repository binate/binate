package "pkg/binate/native/aarch64"

import "pkg/binate/native/common"
import "pkg/builtins/testing"

// aarch64Emitter is the aarch64 impl of common.ArchEmitter.  The full
// emission path is exercised end-to-end by the emit-shape tests + native
// conformance; here we pin the arch constants it feeds the shared
// EmitObject skeleton and that it satisfies the interface (dispatch through
// a *common.ArchEmitter, the path common.EmitObject takes).

func TestAArch64EmitterWordBytes() testing.TestResult {
	var em aarch64Emitter
	var p *aarch64Emitter = &em
	if p.WordBytes() != 8 {
		return fail("aarch64 word size should be 8 (LP64)")
	}
	return ""
}

func TestAArch64EmitterArchName() testing.TestResult {
	var em aarch64Emitter
	var p *aarch64Emitter = &em
	if !charEq(p.ArchName(), "aarch64") {
		return fail("arch name should be aarch64")
	}
	return ""
}

func TestAArch64EmitterSatisfiesArchEmitter() testing.TestResult {
	// Dispatch through the interface vtable (as common.EmitObject does):
	// WordBytes via *common.ArchEmitter must agree with the concrete call.
	var em aarch64Emitter
	var e *common.ArchEmitter = &em
	if e.WordBytes() != 8 {
		return fail("interface dispatch: word size should be 8")
	}
	return ""
}

// ElfTextMappingSymbol is "$x" (A64 code) for ELF output and "" for Mach-O
// (the darwin default, which has no mapping symbols).
func TestAArch64EmitterElfTextMappingSymbol() testing.TestResult {
	var em aarch64Emitter
	var e *common.ArchEmitter = &em
	var s *[]readonly char = e.ElfTextMappingSymbol("elf")
	if len(s) != 2 || s[0] != '$' || s[1] != 'x' {
		return fail("aarch64 ELF text mapping symbol should be $x")
	}
	if len(e.ElfTextMappingSymbol("macho")) != 0 {
		return fail("aarch64 Mach-O should have no text mapping symbol")
	}
	return ""
}
