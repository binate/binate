package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Floating-point lowering for the AArch64 backend.
//
// Strategy (see explorations/plan-native-floats.md): all values
// (including floats) live in 8-byte GP-spill slots.  Float values
// briefly occupy D regs only for the duration of one arithmetic
// op, FMOV'd in from a GP scratch and back out.  This avoids a
// separate FP regalloc and lets all spill traffic continue to use
// the existing X-LDR/STR.
//
// We use D16 / D17 as inline FP scratch — caller-saved per AAPCS,
// no save/restore needed.
//
// The decimal-literal → IEEE 754 bit pattern converter lives in
// pkg/binate/native/common (ParseFloatLitToBits): it's pure integer
// arithmetic and every native backend produces the same bits for
// the same literal text.

// FP_SCRATCH_A is the inline FP scratch register holding the LHS / first operand.
const FP_SCRATCH_A int = aarch64.D16

// FP_SCRATCH_B is the inline FP scratch register holding the RHS / second operand.
const FP_SCRATCH_B int = aarch64.D17

// IsFloatTyp reports whether t is a TYP_FLOAT or TYP_UNTYPED_FLOAT
// (peeling a named distinct float type, e.g. `type F float32`, to its
// underlying — otherwise a named float bypasses all FP lowering and
// emits integer instructions on float values).
func isFloatTyp(t @types.Type) bool {
	if t == nil { return false }
	t = common.UnwrapNamed(t)
	return t.Kind == types.TYP_FLOAT || t.Kind == types.TYP_UNTYPED_FLOAT
}

// ============================================================
// FP op emitters
// ============================================================

// emitConstFloat: OP_CONST_FLOAT — convert the literal to IEEE 754
// bits and load via the standard MOVZ+MOVK chain. The bits live in
// the GP scratch / spill slot like any other 64-bit value.
func emitConstFloat(a @asm.Assembler, rd int, ins @ir.Instr) {
	var bits uint64 = common.ParseFloatLitToBits(ins.StrVal)
	// A float32-typed constant materializes its narrowed 32-bit value
	// (round-to-nearest-even), not the low half of the float64 pattern;
	// otherwise bit_cast(int32, C) would read the wrong bits.
	if floatBitWidth(ins.Typ) == 32 {
		bits = cast(uint64, common.F64BitsToF32Bits(bits))
	}
	// cast(int64, …) reinterprets the full 64-bit IEEE pattern;
	// cast(int, …) would drop the high 32 bits on a 32-bit host.
	emitConstInt64(a, rd, cast(int64, bits))
}

// emitFloatBinop: OP_ADD/SUB/MUL/DIV when the result is float. Operands
// are spilled GP regs; we FMOV them into D scratches, run the FP
// instruction, and FMOV the result back. Returns true if the op was
// handled (i.e. ins.Typ was a float).
func emitFloatBinop(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if !isFloatTyp(ins.Typ) { return false }
	if len(ins.Args) < 2 { return false }
	var ra int = getOperand(a, rm, ins.Args[0].ID)
	var rb int = getOperand(a, rm, ins.Args[1].ID)
	if ra < 0 || rb < 0 { return false }
	if floatBitWidth(ins.Typ) == 32 {
		// float32: round at single precision.  The operands' f32 bit
		// patterns sit in the low 32 bits of their GP slots; move them
		// into the S view of the scratch regs and use the single-precision
		// ops.  Computing in double on the raw f32 bits would reinterpret
		// them as a garbage double.  Fmov_s_to_w zero-extends the result's
		// high 32 bits, so the slot stays clean.
		aarch64.Fmov_w_to_s(a, FP_SCRATCH_A, ra)
		aarch64.Fmov_w_to_s(a, FP_SCRATCH_B, rb)
		if ins.Op == iropcode.OP_ADD {
			aarch64.Fadd_s(a, FP_SCRATCH_A, FP_SCRATCH_A, FP_SCRATCH_B)
		} else if ins.Op == iropcode.OP_SUB {
			aarch64.Fsub_s(a, FP_SCRATCH_A, FP_SCRATCH_A, FP_SCRATCH_B)
		} else if ins.Op == iropcode.OP_MUL {
			aarch64.Fmul_s(a, FP_SCRATCH_A, FP_SCRATCH_A, FP_SCRATCH_B)
		} else if ins.Op == iropcode.OP_DIV {
			aarch64.Fdiv_s(a, FP_SCRATCH_A, FP_SCRATCH_A, FP_SCRATCH_B)
		} else {
			return false
		}
		var rd32 int = nextReg(rm, ins.ID)
		aarch64.Fmov_s_to_w(a, rd32, FP_SCRATCH_A)
		return true
	}
	aarch64.Fmov_gp_to_fp(a, FP_SCRATCH_A, ra)
	aarch64.Fmov_gp_to_fp(a, FP_SCRATCH_B, rb)
	if ins.Op == iropcode.OP_ADD {
		aarch64.Fadd(a, FP_SCRATCH_A, FP_SCRATCH_A, FP_SCRATCH_B)
	} else if ins.Op == iropcode.OP_SUB {
		aarch64.Fsub(a, FP_SCRATCH_A, FP_SCRATCH_A, FP_SCRATCH_B)
	} else if ins.Op == iropcode.OP_MUL {
		aarch64.Fmul(a, FP_SCRATCH_A, FP_SCRATCH_A, FP_SCRATCH_B)
	} else if ins.Op == iropcode.OP_DIV {
		aarch64.Fdiv(a, FP_SCRATCH_A, FP_SCRATCH_A, FP_SCRATCH_B)
	} else {
		return false
	}
	var rd int = nextReg(rm, ins.ID)
	aarch64.Fmov_fp_to_gp(a, rd, FP_SCRATCH_A)
	return true
}

// emitFloatCompare: OP_EQ/NE/LT/LE/GT/GE when operands are float.
// Emits FCMP + CSINC honouring IEEE 754 / Go semantics: `==` and the
// four relationals are ORDERED (false vs NaN), while `!=` is UNORDERED
// (true vs NaN) so it stays the exact complement of `==`.  Returns true
// when the float path fired so the caller skips the integer-CMP
// fallback.
//
// Condition-code mapping (we use CSINC Rd, XZR, XZR, invCond to
// realize CSET Rd, cond; that gives Rd = 1 when `cond` holds — so
// invCond below is the LOGICAL INVERSE of the condition we want):
//
//   OP_EQ  ↔ ordered EQ  (Z=1; NaN sets Z=0 → false ✓) — invert = NE.
//   OP_NE  ↔ UNORDERED NE.  `CSET NE` alone gives rd = 1 iff a != b OR
//                          unordered (NaN sets Z=0 → true) — exactly
//                          the IEEE complement of EQ, no extra gating
//                          — invert = EQ.
//   OP_LT  ↔ ordered LT  (N=1; NaN sets N=0) — invert = PL.
//   OP_LE  ↔ ordered LE  (C=0 OR Z=1; NaN sets C=1,Z=0 so neither
//                          holds → false ✓) — invert = HI.
//   OP_GT  ↔ ordered GT  (Z=0 AND N==V; NaN sets V=1,N=0 → fail ✓)
//                          — invert = LE.
//   OP_GE  ↔ ordered GE  (N==V; NaN sets V=1,N=0 → fail ✓) —
//                          invert = LT.
func emitFloatCompare(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_EQ && ins.Op != iropcode.OP_NE && ins.Op != iropcode.OP_LT &&
			ins.Op != iropcode.OP_LE && ins.Op != iropcode.OP_GT && ins.Op != iropcode.OP_GE {
		return false
	}
	if len(ins.Args) != 2 { return false }
	if ins.Args[0].Typ == nil || !isFloatTyp(ins.Args[0].Typ) {
		return false
	}
	var ra int = getOperand(a, rm, ins.Args[0].ID)
	var rb int = getOperand(a, rm, ins.Args[1].ID)
	if ra < 0 || rb < 0 { return false }
	if floatBitWidth(ins.Args[0].Typ) == 32 {
		// float32: compare at single precision.  A double FCMP on the raw
		// f32 bits reinterprets them as garbage doubles (a negative f32
		// becomes a large positive double), flipping the order.  FCMP.S
		// sets the same NZCV flags, so the condition logic below is shared.
		aarch64.Fmov_w_to_s(a, FP_SCRATCH_A, ra)
		aarch64.Fmov_w_to_s(a, FP_SCRATCH_B, rb)
		aarch64.Fcmp_s(a, FP_SCRATCH_A, FP_SCRATCH_B)
	} else {
		aarch64.Fmov_gp_to_fp(a, FP_SCRATCH_A, ra)
		aarch64.Fmov_gp_to_fp(a, FP_SCRATCH_B, rb)
		aarch64.Fcmp(a, FP_SCRATCH_A, FP_SCRATCH_B)
	}
	var rd int = nextReg(rm, ins.ID)
	var invCond int = invertFloatCondForOp(ins.Op)
	aarch64.Csinc(a, true, rd, aarch64.XZR, aarch64.XZR, invCond)
	return true
}

// invertFloatCondForOp returns the AArch64 condition code that
// inverts the FP relation for `op`, for use with the
// `csinc rd,xzr,xzr,invCond` CSET idiom (sets rd=1 when the relation
// holds).  `==` and the relationals are ordered, `!=` unordered; see
// emitFloatCompare's table.
func invertFloatCondForOp(op int) int {
	if op == iropcode.OP_EQ { return aarch64.COND_NE }
	if op == iropcode.OP_NE { return aarch64.COND_EQ }
	if op == iropcode.OP_LT { return aarch64.COND_PL }
	if op == iropcode.OP_LE { return aarch64.COND_HI }
	if op == iropcode.OP_GT { return aarch64.COND_LE }
	return aarch64.COND_LT // OP_GE
}

// emitFloatNeg: OP_NEG on a float. FNEG via D scratch.
func emitFloatNeg(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if !isFloatTyp(ins.Typ) { return false }
	if len(ins.Args) < 1 { return false }
	var ra int = getOperand(a, rm, ins.Args[0].ID)
	if ra < 0 { return false }
	if floatBitWidth(ins.Typ) == 32 {
		// float32 negate flips the f32 sign bit (bit 31); a double FNEG
		// would flip bit 63 and leave the f32 sign untouched.
		aarch64.Fmov_w_to_s(a, FP_SCRATCH_A, ra)
		aarch64.Fneg_s(a, FP_SCRATCH_A, FP_SCRATCH_A)
		var rd32 int = nextReg(rm, ins.ID)
		aarch64.Fmov_s_to_w(a, rd32, FP_SCRATCH_A)
		return true
	}
	aarch64.Fmov_gp_to_fp(a, FP_SCRATCH_A, ra)
	aarch64.Fneg(a, FP_SCRATCH_A, FP_SCRATCH_A)
	var rd int = nextReg(rm, ins.ID)
	aarch64.Fmov_fp_to_gp(a, rd, FP_SCRATCH_A)
	return true
}

// floatBitWidth returns 32 for float32, 64 for float64 / untyped-float
// (peeling a named distinct float type to its underlying).
func floatBitWidth(t @types.Type) int {
	if t == nil { return 64 }
	t = common.UnwrapNamed(t)
	if t.Kind == types.TYP_UNTYPED_FLOAT { return 64 }
	if t.Kind == types.TYP_FLOAT && t.Width == 32 { return 32 }
	return 64
}

// emitFloatCast: OP_CAST when source or target is a float. Returns
// true if handled. Cases:
//   int → float64    : SCVTF (D, X)
//   int → float32    : SCVTF (D, X), FCVT (S, D), FMOV (W, S)
//   float64 → int    : FCVTZS (X, D), round-toward-zero
//   float32 → int    : FMOV (S, W), FCVT (D, S), FCVTZS (X, D)
//   float32 → float64: FMOV (S, W), FCVT (D, S), FMOV (X, D)
//   float64 → float32: FMOV (D, X), FCVT (S, D), FMOV (W, S)
//   same-width float→float: plain Mov.
//
// Spill slot for float32 holds the 32-bit pattern in the low half
// (STR W). float64 fills all 8 bytes.
func emitFloatCast(a @asm.Assembler, rd int, src int, srcTyp @types.Type, dstTyp @types.Type) bool {
	var srcF bool = isFloatTyp(srcTyp)
	var dstF bool = isFloatTyp(dstTyp)
	if !srcF && !dstF { return false }
	var srcW int = 64
	var dstW int = 64
	if srcF { srcW = floatBitWidth(srcTyp) }
	if dstF { dstW = floatBitWidth(dstTyp) }

	if srcF && dstF {
		if srcW == dstW {
			aarch64.Mov(a, true, rd, aarch64.Reg(src))
			return true
		}
		if srcW == 32 && dstW == 64 {
			// f32 → f64: load low 32 bits into S, widen, dump back to GP.
			aarch64.Fmov_w_to_s(a, FP_SCRATCH_A, src)
			aarch64.Fcvt_s_to_d(a, FP_SCRATCH_A, FP_SCRATCH_A)
			aarch64.Fmov_fp_to_gp(a, rd, FP_SCRATCH_A)
			return true
		}
		// f64 → f32.
		aarch64.Fmov_gp_to_fp(a, FP_SCRATCH_A, src)
		aarch64.Fcvt_d_to_s(a, FP_SCRATCH_A, FP_SCRATCH_A)
		aarch64.Fmov_s_to_w(a, rd, FP_SCRATCH_A)
		return true
	}
	if !srcF && dstF {
		// Int → float. Go via D first, then narrow if dst is f32.  The
		// source's signedness picks the conversion: an unsigned source
		// with its high bit set must become a large positive double, not
		// a negative one (Scvtf would).
		if common.IsUnsignedIntType(srcTyp) {
			aarch64.Ucvtf(a, FP_SCRATCH_A, src)
		} else {
			aarch64.Scvtf(a, FP_SCRATCH_A, src)
		}
		if dstW == 32 {
			aarch64.Fcvt_d_to_s(a, FP_SCRATCH_A, FP_SCRATCH_A)
			aarch64.Fmov_s_to_w(a, rd, FP_SCRATCH_A)
		} else {
			aarch64.Fmov_fp_to_gp(a, rd, FP_SCRATCH_A)
		}
		return true
	}
	// Float → int. If src is f32, widen to D first; FCVTZS/U work on D.
	if srcW == 32 {
		aarch64.Fmov_w_to_s(a, FP_SCRATCH_A, src)
		aarch64.Fcvt_s_to_d(a, FP_SCRATCH_A, FP_SCRATCH_A)
	} else {
		aarch64.Fmov_gp_to_fp(a, FP_SCRATCH_A, src)
	}
	// Destination signedness picks the truncating convert: an unsigned
	// destination must use FCVTZU so a value in [2^63, 2^64) lands as
	// the right large unsigned, not the saturated FCVTZS result.
	if common.IsUnsignedIntType(dstTyp) {
		aarch64.Fcvtzu(a, rd, FP_SCRATCH_A)
	} else {
		aarch64.Fcvtzs(a, rd, FP_SCRATCH_A)
	}
	return true
}
