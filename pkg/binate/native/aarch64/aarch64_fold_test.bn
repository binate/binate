package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/native/fold"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for aarch64_fold.bn's compare and add/sub immediate folds: the aa64
// immediate-fold predicate (aa64ImmFits, run through fold.ImmOperandConsts over
// irbuild-built IR), the add/sub immediate emitter (emitAddSubImmFold via
// emitBinop), the folded compare, and the emitters' loud failure on a folded
// constant that does not fit its position.

// foldFunc_aa64test returns an empty function with an entry block.
func foldFunc_aa64test() (@ir.Func, @ir.Block) {
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "t", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	return f, entry
}

// foldParam_aa64test makes a non-constant operand of type t (an OP_PARAM
// reference to a fresh parameter of f).
func foldParam_aa64test(f @ir.Func, t @types.Type) @ir.Instr {
	var p @ir.Param = irbuild.NewParam(f, "x", t)
	return irbuild.NewParamRef(f, p)
}

// foldFlags_aa64test runs the aa64 predicate over f.
func foldFlags_aa64test(f @ir.Func) @[]bool {
	return fold.ImmOperandConsts(f, aa64ImmFits)
}

// A compare RHS in 0..4095 folds, for a signed and an unsigned compare alike.
func TestAa64ImmFitsCompareRhsInRange() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = foldFunc_aa64test()
	var x @ir.Instr = foldParam_aa64test(f, types.TypInt())
	var u @ir.Instr = foldParam_aa64test(f, types.TypUint64())
	var c0 @ir.Instr = irbuild.EmitConstInt(b, 0, types.TypInt())
	var cMax @ir.Instr = irbuild.EmitConstInt(b, 4095, types.TypInt())
	var cu @ir.Instr = irbuild.EmitConstInt(b, 4095, types.TypUint64())
	_ = irbuild.EmitBinop(b, iropcode.OP_LT, x, c0, types.TypBool())
	_ = irbuild.EmitBinop(b, iropcode.OP_EQ, x, cMax, types.TypBool())
	_ = irbuild.EmitBinop(b, iropcode.OP_GE, u, cu, types.TypBool())
	var flags @[]bool = foldFlags_aa64test(f)
	if !flags[c0.ID] { return "compare RHS 0 must fold" }
	if !flags[cMax.ID] { return "compare RHS 4095 must fold" }
	if !flags[cu.ID] { return "unsigned compare RHS 4095 must fold" }
	return ""
}

// A constant compare LHS never folds: the LHS is the compare's register operand.
func TestAa64ImmFitsCompareLhsNever() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = foldFunc_aa64test()
	var x @ir.Instr = foldParam_aa64test(f, types.TypInt())
	var c @ir.Instr = irbuild.EmitConstInt(b, 5, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_LT, c, x, types.TypBool())
	if foldFlags_aa64test(f)[c.ID] { return "a constant compare LHS must NOT fold" }
	return ""
}

// A value outside the 12-bit immediate does not fold, as a compare RHS or as an
// add operand, positive or negative.
func TestAa64ImmFitsOutOfRange() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = foldFunc_aa64test()
	var x @ir.Instr = foldParam_aa64test(f, types.TypInt())
	var cmpBig @ir.Instr = irbuild.EmitConstInt(b, 4096, types.TypInt())
	var cmpNeg @ir.Instr = irbuild.EmitConstInt(b, -4096, types.TypInt())
	var addBig @ir.Instr = irbuild.EmitConstInt(b, 4096, types.TypInt())
	var addNeg @ir.Instr = irbuild.EmitConstInt(b, -4096, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_LT, x, cmpBig, types.TypBool())
	_ = irbuild.EmitBinop(b, iropcode.OP_LT, x, cmpNeg, types.TypBool())
	_ = irbuild.EmitBinop(b, iropcode.OP_ADD, x, addBig, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_ADD, x, addNeg, types.TypInt())
	var flags @[]bool = foldFlags_aa64test(f)
	if flags[cmpBig.ID] { return "compare RHS 4096 must NOT fold" }
	if flags[cmpNeg.ID] { return "compare RHS -4096 must NOT fold" }
	if flags[addBig.ID] { return "add operand 4096 must NOT fold" }
	if flags[addNeg.ID] { return "add operand -4096 must NOT fold" }
	return ""
}

// A small negative compare RHS folds (as CMN) only for a SIGNED compare; in an
// unsigned compare it denotes a near-2^64 value.
func TestAa64ImmFitsNegativeSignedCompareOnly() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = foldFunc_aa64test()
	var x @ir.Instr = foldParam_aa64test(f, types.TypInt())
	var u @ir.Instr = foldParam_aa64test(f, types.TypUint64())
	var sNeg @ir.Instr = irbuild.EmitConstInt(b, -5, types.TypInt())
	var sMin @ir.Instr = irbuild.EmitConstInt(b, -4095, types.TypInt())
	var uNeg @ir.Instr = irbuild.EmitConstInt(b, -5, types.TypUint64())
	_ = irbuild.EmitBinop(b, iropcode.OP_LT, x, sNeg, types.TypBool())
	_ = irbuild.EmitBinop(b, iropcode.OP_GT, x, sMin, types.TypBool())
	_ = irbuild.EmitBinop(b, iropcode.OP_LT, u, uNeg, types.TypBool())
	var flags @[]bool = foldFlags_aa64test(f)
	if !flags[sNeg.ID] { return "signed compare RHS -5 must fold (CMN #5)" }
	if !flags[sMin.ID] { return "signed compare RHS -4095 must fold (CMN #4095)" }
	if flags[uNeg.ID] { return "unsigned compare RHS -5 must NOT fold" }
	return ""
}

// ADD is commutative: a constant on either side folds, including a small
// negative (the sign-swapped SUB).
func TestAa64ImmFitsAddEitherSide() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = foldFunc_aa64test()
	var x @ir.Instr = foldParam_aa64test(f, types.TypInt())
	var rhs @ir.Instr = irbuild.EmitConstInt(b, 7, types.TypInt())
	var lhs @ir.Instr = irbuild.EmitConstInt(b, 9, types.TypInt())
	var neg @ir.Instr = irbuild.EmitConstInt(b, -4095, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_ADD, x, rhs, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_ADD, lhs, x, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_ADD, x, neg, types.TypInt())
	var flags @[]bool = foldFlags_aa64test(f)
	if !flags[rhs.ID] { return "an ADD constant RHS must fold" }
	if !flags[lhs.ID] { return "an ADD constant LHS must fold" }
	if !flags[neg.ID] { return "an ADD constant -4095 must fold (SUB #4095)" }
	return ""
}

// A SUB folds its subtrahend but never a constant minuend.
func TestAa64ImmFitsSubPositions() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = foldFunc_aa64test()
	var x @ir.Instr = foldParam_aa64test(f, types.TypInt())
	var sub @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt())
	var min @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_SUB, x, sub, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_SUB, min, x, types.TypInt())
	var flags @[]bool = foldFlags_aa64test(f)
	if !flags[sub.ID] { return "a SUB subtrahend must fold" }
	if flags[min.ID] { return "a SUB minuend must NOT fold" }
	return ""
}

// A const+const ADD folds neither operand: one must supply the register.
func TestAa64ImmFitsConstPlusConstNot() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = foldFunc_aa64test()
	var c @ir.Instr = irbuild.EmitConstInt(b, 1, types.TypInt())
	var d @ir.Instr = irbuild.EmitConstInt(b, 2, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_ADD, c, d, types.TypInt())
	var flags @[]bool = foldFlags_aa64test(f)
	if flags[c.ID] || flags[d.ID] { return "a const+const ADD must fold neither operand" }
	return ""
}

// A constant used both as a compare RHS and as an ADD operand folds when both
// uses fit; one also used by a MUL (no immediate form) does not.
func TestAa64ImmFitsCompareAndAddFolds() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = foldFunc_aa64test()
	var x @ir.Instr = foldParam_aa64test(f, types.TypInt())
	var both @ir.Instr = irbuild.EmitConstInt(b, 100, types.TypInt())
	var withMul @ir.Instr = irbuild.EmitConstInt(b, 100, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_LT, x, both, types.TypBool())
	_ = irbuild.EmitBinop(b, iropcode.OP_ADD, x, both, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_LT, x, withMul, types.TypBool())
	_ = irbuild.EmitBinop(b, iropcode.OP_MUL, x, withMul, types.TypInt())
	var flags @[]bool = foldFlags_aa64test(f)
	if !flags[both.ID] { return "a compare-RHS + ADD-operand constant must fold" }
	if flags[withMul.ID] { return "a constant also used by a MUL must NOT fold" }
	return ""
}

// aa64 registers are 64 bits wide, so an int64 compare or add constant folds
// (no multi-word register-pair form as on a 32-bit target).
func TestAa64ImmFitsInt64Folds() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = foldFunc_aa64test()
	var x @ir.Instr = foldParam_aa64test(f, types.TypInt64())
	var cmp @ir.Instr = irbuild.EmitConstInt(b, 10, types.TypInt64())
	var add @ir.Instr = irbuild.EmitConstInt(b, 20, types.TypInt64())
	_ = irbuild.EmitBinop(b, iropcode.OP_LT, x, cmp, types.TypBool())
	_ = irbuild.EmitBinop(b, iropcode.OP_ADD, x, add, types.TypInt64())
	var flags @[]bool = foldFlags_aa64test(f)
	if !flags[cmp.ID] { return "an int64 compare RHS must fold on aa64" }
	if !flags[add.ID] { return "an int64 ADD operand must fold on aa64" }
	return ""
}

// errIs_aa64test reports whether `a` recorded an error whose message is exactly
// `want` — so a test pins which check fired, not merely that one did.
func errIs_aa64test(a @asm.Assembler, want *[]readonly char) bool {
	if !a.HasError || len(a.ErrorMsg) != len(want) { return false }
	for i := 0; i < len(want); i++ {
		if a.ErrorMsg[i] != want[i] { return false }
	}
	return true
}

// addSubFold_aa64test lowers `op` through emitBinop over a register operand
// (id 1, an OP_PARAM spilled at slot 0) and a FoldedImm constant (id 2, value v)
// at Args[constIdx], with operand/result type t.  Returns the assembler and
// emitBinop's result.
func addSubFold_aa64test(op int, constIdx int, v int64, t @types.Type) (@asm.Assembler, bool) {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var fc @[]bool = make_slice(bool, 4)
	fc[2] = true
	m.FoldedImm = fc
	var reg @ir.Instr = make(ir.Instr)
	reg.ID = 1
	reg.Op = iropcode.OP_PARAM
	reg.Typ = t
	var c @ir.Instr = make(ir.Instr)
	c.ID = 2
	c.Op = iropcode.OP_CONST_INT
	c.Typ = t
	c.IntVal = v
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = op
	ins.Typ = t
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[constIdx] = c
	ins.Args[1 - constIdx] = reg
	var ok bool = emitBinop(a, m, ins)
	return a, ok
}

// A folded ADD constant rides the ADD immediate: `add rd, rn, #v` (ADD-immediate
// 64-bit, top byte 0x91) — NOT a register ADD (0x8B) — with nothing materialized.
func TestEmitBinopAddImmFoldEmitsImm() testing.TestResult {
	var a @asm.Assembler
	var ok bool
	a, ok = addSubFold_aa64test(iropcode.OP_ADD, 1, cast(int64, 5), types.TypInt())
	if !ok || a.HasError { return "emitBinop should lower a FoldedImm ADD" }
	if !hasWordHi(a, 0x91) { return "a folded ADD constant must emit ADD-immediate (0x91)" }
	if hasWordHi(a, 0x8B) { return "a folded ADD constant must NOT emit a register ADD (0x8B)" }
	return ""
}

// A folded NEGATIVE add constant sign-swaps the operation: `x + (-5)` emits
// `sub rd, rn, #5` (SUB-immediate 64-bit, top byte 0xD1), not an ADD.
func TestEmitBinopAddImmFoldNegativeEmitsSub() testing.TestResult {
	var a @asm.Assembler
	var ok bool
	a, ok = addSubFold_aa64test(iropcode.OP_ADD, 1, cast(int64, -5), types.TypInt())
	if !ok || a.HasError { return "emitBinop should lower a FoldedImm ADD" }
	if !hasWordHi(a, 0xD1) { return "x + (-5) must emit SUB-immediate (0xD1)" }
	if hasWordHi(a, 0x91) { return "x + (-5) must NOT emit ADD-immediate (0x91)" }
	return ""
}

// ADD is commutative: a folded constant on the LHS (Args[0]) rides the ADD
// immediate too (0x91), with the register operand taken from Args[1].
func TestEmitBinopAddImmFoldCommutesLhs() testing.TestResult {
	var a @asm.Assembler
	var ok bool
	a, ok = addSubFold_aa64test(iropcode.OP_ADD, 0, cast(int64, 7), types.TypInt())
	if !ok || a.HasError { return "emitBinop should lower a commuted FoldedImm ADD" }
	if !hasWordHi(a, 0x91) { return "a folded ADD const on the LHS must emit ADD-immediate (0x91)" }
	if hasWordHi(a, 0x8B) { return "a folded LHS const must NOT emit a register ADD (0x8B)" }
	return ""
}

// A folded SUB subtrahend rides the SUB immediate: `x - #5` emits `sub rd, rn, #5`
// (SUB-immediate 64-bit, 0xD1), NOT a register SUB (0xCB).
func TestEmitBinopSubImmFoldSubtrahend() testing.TestResult {
	var a @asm.Assembler
	var ok bool
	a, ok = addSubFold_aa64test(iropcode.OP_SUB, 1, cast(int64, 5), types.TypInt())
	if !ok || a.HasError { return "emitBinop should lower a FoldedImm SUB subtrahend" }
	if !hasWordHi(a, 0xD1) { return "a folded SUB subtrahend must emit SUB-immediate (0xD1)" }
	if hasWordHi(a, 0xCB) { return "a folded SUB subtrahend must NOT emit a register SUB (0xCB)" }
	return ""
}

// A folded uint32 ADD uses the 32-bit w-form immediate (0x11) — which self-clears
// bits [32,64) — so it emits NO 64-bit op (0x91) and NO re-narrow (matching the
// register path's w-form handling); the fold preserves the exact width behavior.
func TestEmitBinopAddImmFoldUint32WForm() testing.TestResult {
	var a @asm.Assembler
	var ok bool
	a, ok = addSubFold_aa64test(iropcode.OP_ADD, 1, cast(int64, 3), types.TypUint32())
	if !ok || a.HasError { return "emitBinop should lower a uint32 FoldedImm ADD" }
	if !hasWordHi(a, 0x11) {
		return "a folded uint32 ADD must use the 32-bit w-form immediate (0x11)"
	}
	if hasWordHi(a, 0x91) { return "a folded uint32 ADD must NOT use the 64-bit immediate (0x91)" }
	if hasWordHi(a, 0xD3) {
		return "a folded uint32 ADD must NOT emit a UXTW narrow (UBFM.64, 0xD3)"
	}
	return ""
}

// A FoldedImm ADD constant whose value does not fit the 12-bit immediate is an
// analysis/emitter mismatch: emitBinop records an error and encodes nothing —
// neither a truncated ADD-immediate nor a register ADD reading the never-
// materialized constant.
func TestEmitBinopAddImmFoldOutOfRangeFailsLoud() testing.TestResult {
	var a @asm.Assembler
	var ok bool
	a, ok = addSubFold_aa64test(iropcode.OP_ADD, 1, cast(int64, 4096), types.TypInt())
	if !a.HasError { return "a folded ADD constant 4096 must SetError" }
	if !ok { return "emitBinop must treat the rejected fold as handled (no register fallback)" }
	if hasWordHi(a, 0x91) || hasWordHi(a, 0xD1) {
		return "an unfit fold must NOT emit ADD/SUB #imm"
	}
	if hasWordHi(a, 0x8B) { return "an unfit fold must NOT fall back to a register ADD" }
	return ""
}

// A FoldedImm SUB minuend (a position with no immediate form) fails loud, and
// the register SUB (0xCB) is not emitted.
func TestEmitBinopSubFoldedMinuendFailsLoud() testing.TestResult {
	var a @asm.Assembler
	var ok bool
	a, ok = addSubFold_aa64test(iropcode.OP_SUB, 0, cast(int64, 5), types.TypInt())
	if !a.HasError { return "a folded SUB minuend must SetError" }
	if !ok { return "emitBinop must treat the rejected fold as handled (no register fallback)" }
	if hasWordHi(a, 0xCB) || hasWordHi(a, 0xD1) { return "a folded minuend must NOT emit a SUB" }
	return ""
}

// A fitting folded ADD constant whose register operand cannot be resolved (id 1
// unmapped: neither homed, cached nor spilled) fails loud with the emitter's own
// message and emits nothing.
func TestEmitBinopAddImmFoldNoRegisterFailsLoud() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	var fc @[]bool = make_slice(bool, 4)
	fc[2] = true
	m.FoldedImm = fc
	var reg @ir.Instr = make(ir.Instr)
	reg.ID = 1
	reg.Op = iropcode.OP_PARAM
	reg.Typ = types.TypInt()
	var c @ir.Instr = make(ir.Instr)
	c.ID = 2
	c.Op = iropcode.OP_CONST_INT
	c.Typ = types.TypInt()
	c.IntVal = cast(int64, 5)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_ADD
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = reg
	ins.Args[1] = c
	var ok bool = emitBinop(a, m, ins)
	if !errIs_aa64test(a, "native arm64: add/sub with a folded immediate has no register operand") ||
			!ok {
		return "a folded ADD with an unresolvable register operand must fail loud"
	}
	if a.Sections[0].Len != 0 { return "an ADD with no register operand must emit nothing" }
	return ""
}

// cmpFold_aa64test lowers `x < c` through emitCompare with x (id 1, type t,
// spilled at slot 0) and a FoldedImm constant c (id 2, value v).
func cmpFold_aa64test(v int64, t @types.Type) (@asm.Assembler, bool) {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var fc @[]bool = make_slice(bool, 4)
	fc[2] = true
	m.FoldedImm = fc
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Op = iropcode.OP_PARAM
	lhs.Typ = t
	var c @ir.Instr = make(ir.Instr)
	c.ID = 2
	c.Op = iropcode.OP_CONST_INT
	c.Typ = t
	c.IntVal = v
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_LT
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = c
	var ok bool = emitCompare(a, "main", m, ins)
	return a, ok
}

// A small negative FoldedImm RHS of a signed compare emits CMN #k (ADDS-immediate
// 64-bit, top byte 0xB1), not CMP.
func TestEmitCompareFoldedNegativeUsesCmn() testing.TestResult {
	var a @asm.Assembler
	var ok bool
	a, ok = cmpFold_aa64test(cast(int64, -5), types.TypInt())
	if !ok || a.HasError { return "a folded signed compare against -5 must lower" }
	if !hasWordHi(a, 0xB1) { return "a folded signed compare against -5 must emit CMN #5 (0xB1)" }
	if hasWordHi(a, 0xF1) { return "a folded negative RHS must NOT emit CMP #imm (0xF1)" }
	return ""
}

// A FoldedImm compare RHS that does not fit — out of range, or a negative in an
// unsigned compare — fails loud and emits neither an immediate nor a register
// compare.
func TestEmitCompareFoldedUnfitFailsLoud() testing.TestResult {
	var a @asm.Assembler
	var ok bool
	a, ok = cmpFold_aa64test(cast(int64, 4096), types.TypInt())
	if !a.HasError || ok { return "a folded compare RHS 4096 must SetError and fail" }
	if hasWordHi(a, 0xF1) || hasWordHi(a, 0xEB) { return "an unfit fold must NOT emit a CMP" }
	a, ok = cmpFold_aa64test(cast(int64, -5), types.TypUint64())
	if !a.HasError || ok { return "a folded unsigned compare RHS -5 must SetError and fail" }
	if hasWordHi(a, 0xB1) || hasWordHi(a, 0xF1) || hasWordHi(a, 0xEB) {
		return "an unsigned compare against a folded -5 must NOT emit CMN/CMP"
	}
	return ""
}
