package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A function whose frame passes the target's address space (common.CheckFrameFits)
// is a compile error naming it, not a wrapped frame: emitFunc reports it and emits
// no body.

// bigLocalsFuncAA64 builds `func name()` with one byte-array local of each size.
func bigLocalsFuncAA64(name *[]readonly char, sizes @[]int64) @ir.Func {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", buf.CopyStr(name), noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	for i := 0; i < len(sizes); i++ {
		irbuild.EmitAlloc(b, types.MakeArrayType(types.TypUint8(), sizes[i]))
	}
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(b, noArgs)
	return f
}

// errNamesAA64 reports whether msg holds name.
func errNamesAA64(msg *[]readonly char, name *[]readonly char) bool {
	for i := 0; i + len(name) <= len(msg); i++ {
		var k int = 0
		for k < len(name) && msg[i + k] == name[k] { k = k + 1 }
		if k == len(name) { return true }
	}
	return false
}

func TestEmitFuncFrameTooLargeAA64() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var strs @[]ir.StringConst
	emitFunc(a, "main",
			bigLocalsFuncAA64("main.big", @[]int64{0x7000000000000000, 0x7000000000000000}), strs)
	if !a.HasError || !errNamesAA64(a.ErrorMsg, "main.big") {
		return fail("a frame past the address space should be an error naming the function")
	}
	return ""
}

// emittedHasWordAA64 reports whether a's text holds the instruction word w.
func emittedHasWordAA64(a @asm.Assembler, w uint32) bool {
	var d @[]uint8 = a.Sections[0].Data
	for i := 0; i + 4 <= a.Sections[0].Len; i = i + 4 {
		var v uint32 = cast(uint32, d[i]) | (cast(uint32, d[i + 1]) << 8) |
				(cast(uint32, d[i + 2]) << 16) | (cast(uint32, d[i + 3]) << 24)
		if v == w { return true }
	}
	return false
}

// A frame past 4 GiB that fits the address space compiles, with no local past 2 GiB
// (so no type size passes a 32-bit host's int): the prologue subtracts it through X17
// (SUB SP, SP, X17, UXTX), and the last local, past 4 GiB, is zeroed through an
// address formed in X17 (STR XZR, [X17]) — every offset reaching the assembler as
// int64.
func TestEmitFuncFramePast4GiBAA64() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var strs @[]ir.StringConst
	emitFunc(a, "main",
			bigLocalsFuncAA64("main.huge", @[]int64{0x60000000, 0x60000000, 0x60000000, 64}), strs)
	if a.HasError { return buf.Concat("a frame past 4 GiB must compile: ", a.ErrorMsg) }
	if !emittedHasWordAA64(a, 0xcb3163ff) {
		return fail("the prologue should subtract the frame through X17")
	}
	if !emittedHasWordAA64(a, 0xf900023f) {
		return fail("the local past 4 GiB should be zeroed through X17")
	}
	return ""
}
