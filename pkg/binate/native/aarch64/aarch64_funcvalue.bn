package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Function-value backing emission for the AArch64 native backend:
// collecting OP_FUNC_VALUE / OP_FUNC_HANDLE references and emitting the
// per-function vtable + handle globals (relocatable-read-only section,
// rodata_relro).  The per-function
// shim text-section emission lives in aarch64_funcvalue_shim.bn; split
// from aarch64.bn (the object-emission driver) so each stays under the
// hygiene length cap; mirrors x64_funcvalue.bn.  EmitObject in aarch64.bn
// drives these in order: shims, then vtables.

// collectFuncValueRefs walks the module for OP_FUNC_VALUE and
// OP_FUNC_HANDLE references and returns the unique (name, fvTyp)
// pairs.  fvTyp is the instruction's Typ for OP_FUNC_VALUE
// (TYP_FUNC_VALUE / TYP_MANAGED_FUNC_VALUE) and synthesized from the
// target function's signature for OP_FUNC_HANDLE (whose IR result
// type is the opaque *uint8).  Cross-module references — those
// whose qualified function name doesn't resolve in mod.Funcs — are
// excluded: the defining module's LLVM-emitted __handle / __vt /
// __shim triplet is already in its .o, and the linker resolves the
// reference cross-TU; emitting our own definitions would be wasteful
// and risks the previous attempt's duplicate-symbol pitfall.
func collectFuncValueRefs(mod @ir.Module) (@[]@[]char, @[]@types.Type) {
	var seen @[]@[]char
	var sigs @[]@types.Type
	// Pre-pass: emit triplets for every IsLinkOnce function defined
	// in this TU (dtors + copy helpers from gen_dtor_emit /
	// gen_copy_emit, marked IsLinkOnce=true).  Without this, only
	// packages that internally reference their own dtor as an
	// OP_FUNC_HANDLE would emit the __vt/__handle/__shim triplet —
	// every consumer would then have to emit its own weak copy to
	// dispatch through the handle, which silently collides on
	// Mach-O strict-symbol semantics (the dtor-vt cluster the
	// macOS aa64 lane was failing on).  The matching consumer-side
	// skip lives in lookupFuncValueTypeAA64's IsExtern gate below.
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		if !f.IsLinkOnce { continue }
		var params @[]@types.Param
		for j := 0; j < len(f.Params); j++ {
			var p @types.Param = make(types.Param)
			p.Name = f.Params[j].Name
			p.Type = f.Params[j].Typ
			params = slices.Append[@types.Param](params, p)
		}
		var fvTyp @types.Type = types.MakeFuncValueType(params, f.Results)
		seen = slices.Append[@[]char](seen, f.Name)
		sigs = slices.Append[@types.Type](sigs, fvTyp)
	}
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		for j := 0; j < len(f.Blocks); j++ {
			var blk @ir.Block = f.Blocks[j]
			for k := 0; k < len(blk.Instrs); k++ {
				var ins @ir.Instr = blk.Instrs[k]
				if ins.Op != iropcode.OP_FUNC_VALUE && ins.Op != iropcode.OP_FUNC_HANDLE {
					continue
				}
				var dup bool = false
				for s := 0; s < len(seen); s++ {
					if charEqAA64(seen[s], ins.StrVal) {
						dup = true
						break
					}
				}
				if dup { continue }
				var sigTyp @types.Type = ins.Typ
				if ins.Op == iropcode.OP_FUNC_HANDLE {
					sigTyp = lookupFuncValueTypeAA64(mod, ins.StrVal)
					if sigTyp == nil { continue }
				}
				seen = slices.Append[@[]char](seen, ins.StrVal)
				sigs = slices.Append[@types.Type](sigs, sigTyp)
			}
		}
	}
	// Force-emit: add every .bni-exported, non-extern function so its
	// triple is emitted even when nothing references it as a function
	// value — the per-package
	// Functions table's Value field symrefs @__handle.<exported fn>, which
	// must be a defined symbol.  Mirrors codegen's addExportedFuncsToSeen.
	// Dedups by f.Name (the form OP_FUNC_HANDLE stores); a func with no
	// synthesizable func-value type is skipped.
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		// + own-package struct dtors (ir.Func.IsStructDtor) + lang's primitive methods
		// (ir.Func.IsPrimitiveMethod), injectable when native-only.
		if !f.Exported && !f.IsStructDtor && !f.IsPrimitiveMethod { continue }
		var dup bool = false
		for s := 0; s < len(seen); s++ {
			if charEqAA64(seen[s], f.Name) {
				dup = true
				break
			}
		}
		if dup { continue }
		var sigTyp @types.Type = lookupFuncValueTypeAA64(mod, f.Name)
		if sigTyp == nil { continue }
		seen = slices.Append[@[]char](seen, f.Name)
		sigs = slices.Append[@types.Type](sigs, sigTyp)
	}
	// Force-emit: add every NON-generic impl's interface-method references so
	// the per-function triple backing each `@__handle.<method>` the parallel
	// `__ivtshim` vtable (emitOneImplShimVtable) references is emitted.  An iface
	// impl method on an UNEXPORTED receiver type (e.g. errors.errorImpl.Error)
	// is not reached by the .bni-exported force-emit loop above, so without this
	// its handle dangles as an undefined symbol at link time.  Mirrors the LLVM
	// addImplMethodsToSeen / addIfaceMethodsToSeen in emit_funcvals_dtor.bn.
	seen, sigs = collectImplMethodRefsAA64(mod, seen, sigs)
	// Force-emit the synthesized __Package accessor's triple so the
	// per-package Functions table's __Package self-entry has a defined
	// ___handle to point at.  Keyed on the FQ <pkg>.__Package (like every
	// other entry): FuncName mangles the dotted name to the function symbol
	// for <pkg>.__Package, matching the descriptor's accessor and the
	// self-entry's Value.  No-op when reflect wasn't loaded for this
	// module (PackageAccessorSig nil) — then the table omits __Package.
	if mod.PackageAccessorSig != nil {
		var qn @[]char = mangle.QualifyName(common.StripQuotes(mod.Name), "__Package")
		var dupP bool = false
		for s := 0; s < len(seen); s++ {
			if charEqAA64(seen[s], qn) { dupP = true; break }
		}
		if !dupP {
			seen = slices.Append[@[]char](seen, qn)
			sigs = slices.Append[@types.Type](sigs, mod.PackageAccessorSig)
		}
	}
	return seen, sigs
}

// collectImplMethodRefsAA64 appends each impl's interface-method references to
// `seen` + `sigs` so collectFuncValueRefs emits their (shim, vt, handle) triples.
// The raw @__ivt vtable (emitOneImplVtable, useHandles=true) now holds
// @__handle.<method> in EVERY method slot for EVERY impl; without this pre-pass
// those handles dangle as undefined symbols (an iface impl method on an unexported
// receiver type is not reached by the .bni-exported force-emit loop).  Mirrors the
// LLVM addImplMethodsToSeen in emit_funcvals_dtor.bn.
//
// Unlike the parallel @__ivtshim vtable / the descriptor Vtables table (both gated
// non-generic, because a bytecode importer re-lowers its own copy of a generic
// instantiation), this is NOT gated: emitOneImplVtable emits the raw @__ivt for
// generic-instantiation impls too, so their method handles must exist.  A generic-
// inst method whose func-value type can't be resolved (not in mod.Funcs) is skipped
// by collectIfaceMethodRefsAA64, so nothing dangles the other way.
func collectImplMethodRefsAA64(mod @ir.Module, seen @[]@[]char,
		sigs @[]@types.Type) (@[]@[]char, @[]@types.Type) {
	for i := 0; i < len(mod.Impls); i++ {
		var info @ir.ImplInfo = mod.Impls[i]
		if info == nil { continue }
		seen, sigs = collectIfaceMethodRefsAA64(mod, info, info.IfacePkg, info.IfaceName, seen, sigs)
	}
	return seen, sigs
}

// collectIfaceMethodRefsAA64 adds the method references for one (impl, iface)
// level and recurses into the iface's parents — the same own-then-parents walk
// collectImplVtableSlotsNative uses, so the seen set exactly covers the shim
// vtable's method slots.  Skips a method whose func-value type can't be
// resolved or that is already seen (dedup against OP_FUNC_HANDLE refs / other
// impls sharing it).  Mirrors the LLVM addIfaceMethodsToSeen.
func collectIfaceMethodRefsAA64(mod @ir.Module, info @ir.ImplInfo, ifacePkg *[]readonly char,
		ifaceName *[]readonly char, seen @[]@[]char, sigs @[]@types.Type) (@[]@[]char, @[]@types.Type) {
	var parentPkgs @[]@[]char = ir.IfaceParentPkgs(mod, ifacePkg, ifaceName)
	var parentNames @[]@[]char = ir.IfaceParentNames(mod, ifacePkg, ifaceName)
	for i := 0; i < len(parentPkgs); i++ {
		seen, sigs = collectIfaceMethodRefsAA64(mod, info, parentPkgs[i], parentNames[i], seen, sigs)
	}
	var ownMethods @[]@[]char = ir.IfaceOwnMethodNames(mod, ifacePkg, ifaceName)
	for i := 0; i < len(ownMethods); i++ {
		var qualified @[]char = buildMethodFuncNameNative(info.RecvPkg, info.RecvTypeName, ownMethods[i])
		var slotName @[]char = ir.LookupVtableSlotName(mod, qualified)
		var sigTyp @types.Type = lookupFuncValueTypeAA64(mod, slotName)
		if sigTyp == nil { continue }
		var dup bool = false
		for s := 0; s < len(seen); s++ {
			if charEqAA64(seen[s], slotName) { dup = true; break }
		}
		if dup { continue }
		seen = slices.Append[@[]char](seen, slotName)
		sigs = slices.Append[@types.Type](sigs, sigTyp)
	}
	return seen, sigs
}

// lookupFuncValueTypeAA64 finds a function in the module by qualified
// name and synthesizes a TYP_FUNC_VALUE from its parameter / result
// signature.  Mirrors lookupFuncValueType in pkg/binate/codegen — used to
// back OP_FUNC_HANDLE references (whose IR result is opaque *uint8)
// with the same per-function shim/vtable/handle emission as
// OP_FUNC_VALUE.  Returns nil for cross-module references (function
// not in mod.Funcs); the caller skips local emission, since the
// defining TU already provides the triplet.
func lookupFuncValueTypeAA64(mod @ir.Module, qname @[]char) @types.Type {
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		// Extern entries (gen_import.bn:NewExternFunc, e.g. a cross-package
		// managed-type dtor declared via declareExternDtor) ARE matched: the
		// OP_FUNC_HANDLE that references them needs a per-function (shim, vt,
		// handle) triple, and the defining TU does not always provide it —
		// notably a managed type declared in an INTERFACE-ONLY package
		// (reflect.FunctionInfo) whose dtor no .bn module emits.  The triple
		// is WEAK (SetWeak), so a defining-TU copy and this consumer copy
		// dedup at link (N_WEAK_DEF), matching the LLVM consumer-side
		// EmitFuncHandle path; the shim tail-branches to the (extern) target.
		if !charEqAA64(f.Name, qname) { continue }
		// ir.Param has Name + Typ; types.Param has Name + Type.
		// Copy field-by-field into a fresh @[]@types.Param.
		var params @[]@types.Param
		for j := 0; j < len(f.Params); j++ {
			var p @types.Param = make(types.Param)
			p.Name = f.Params[j].Name
			p.Type = f.Params[j].Typ
			params = slices.Append[@types.Param](params, p)
		}
		return types.MakeFuncValueType(params, f.Results)
	}
	return nil
}

// emitFuncValueVtables walks the module for OP_FUNC_VALUE and
// OP_FUNC_HANDLE references and emits the per-function backing
// globals each one needs:
//
//   <vt label>                   ; aa64-style vtable, weak.
//                                ;   .quad 0                ; dtor
//                                ;   .quad <shim label>     ; call
//   ___handle.<mangled-fn>       ; LLVM-shape handle, weak (Phase 4).
//                                ;   .quad <vt label>       ; vtable
//                                ;   .quad 0                ; data
//
// Two distinct vtable symbols coexist: the aa64-style one is what
// OP_FUNC_VALUE construction reaches via vtableSymFor, while the
// LLVM-shape handle's vt slot points at the same aa64 vtable (layout
// agrees — `{dtor, call}` either way).  OP_FUNC_HANDLE references
// read the handle via handleSymFor; OP_CALL_HANDLE loads
// handle.vtable.call from that, dispatches as `call(data, args)`.
func emitFuncValueVtables(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	var seen @[]@[]char
	var ignored @[]@types.Type
	seen, ignored = collectFuncValueRefs(mod)
	if len(ignored) > 0 || len(seen) == 0 {
		// Use ignored to silence unused warnings; sigs are consumed by the
		// shim emitter, not the vtable layout (built by irdata.BuildFuncValue).
	}
	if len(seen) == 0 { return }
	for i := 0; i < len(seen); i++ {
		var vtLabel @[]char = vtableSymFor(pkgName, seen[i])
		var shimLabel @[]char = shimSymFor(pkgName, seen[i])
		var handleLabel @[]char = handleSymFor(pkgName, seen[i])
		// Mark the call-slot target (the shim) global so its relocation
		// resolves; funcValueDtorHandleSym does the same for the dtor handle
		// and returns it (empty -> a null dtor slot).  The byte layout —
		// vtable { dtor, call } + handle { vtable, data=null } — is built
		// once by irdata.BuildFuncValue and lowered through common.EmitDataGlobal,
		// shared with the LLVM + x64 backends so the three cannot drift.
		a.SetGlobal(shimLabel)
		var dtorSym @[]char = funcValueDtorHandleSym(a, pkgName, mod, seen[i])
		var dgs @[]@irdata.DataGlobal = irdata.BuildFuncValue(vtLabel, dtorSym, shimLabel, handleLabel)
		for j := 0; j < len(dgs); j++ {
			common.EmitDataGlobal(a, dgs[j])
		}
	}
}

// funcValueDtorHandleSym returns the closure-struct dtor's HANDLE symbol
// (`___handle.<dtor>`) for a capturing @func whose closure struct needs
// destruction — marking it global so its relocation resolves — else an empty
// slice (the vtable's dtor slot is then a null pointer).
//
// Slot 0 carries the dtor's HANDLE pointer, not a raw fn pointer, because
// OP_FUNC_VALUE_DTOR -> rt.ZeroRefDestroy dispatches it as
// `handle.vtable.call(handle.data, ptr)` (an OP_CALL_HANDLE) — the same
// convention the LLVM backend uses.  The referenced `___handle.<dtor>` triple
// is already emitted by this pass's IsLinkOnce pre-pass (collectFuncValueRefs
// adds every local IsLinkOnce func — closure-struct dtors among them — to
// `seen`).  Its symbol resolves the same whether keyed on the dtor func's
// qualified Name (the pre-pass) or the unqualified f.ClosureStructDtorName
// here: mangle.FuncName folds a same-package qualifier prefix and a
// pkgName-prefixed unqualified name to the identical `bn_F`-mangled dtor symbol,
// so handleSymFor(pkgName, f.ClosureStructDtorName) names exactly that triple's
// handle — no new global, no dangling reference.
func funcValueDtorHandleSym(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module,
		qname @[]char) @[]char {
	var f @ir.Func = lookupClosureFuncAA64(mod, qname)
	if f == nil || !f.IsManagedFuncValue || f.ClosureStruct == nil ||
			!f.ClosureStruct.NeedsDestruction() || len(f.ClosureStructDtorName) == 0 {
		var none @[]char
		return none
	}
	var h @[]char = handleSymFor(pkgName, f.ClosureStructDtorName)
	a.SetGlobal(h)
	return h
}

// shimSymFor returns the underscore-prefixed Mach-O label for a
// function's per-function shim global: "_<mangled-fn>__shim".
func shimSymFor(pkgName *[]readonly char, fnName *[]readonly char) @[]char {
	var fn @[]char = symFor(pkgName, fnName)
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(fn)
	cb.Write("__shim")
	return buf.CopyStr(cb.String())
}

// vtableSymFor returns the underscore-prefixed Mach-O label for a
// function's vtable global: "_<mangled-fn>__vt".
func vtableSymFor(pkgName *[]readonly char, fnName *[]readonly char) @[]char {
	var fn @[]char = symFor(pkgName, fnName)
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(fn)
	cb.Write("__vt")
	return buf.CopyStr(cb.String())
}
