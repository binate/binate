package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Function-value backing emission for the AArch64 native backend:
// collecting OP_FUNC_VALUE / OP_FUNC_HANDLE references, the per-function
// shims (text section), and the per-function vtable + handle globals
// (data section).  Split from aarch64.bn (the object-emission driver) so
// each stays under the hygiene length cap; mirrors x64_funcvalue.bn.
// EmitObject in aarch64.bn drives these in order: shims, then vtables.

// collectFuncValueRefs walks the module for OP_FUNC_VALUE and
// OP_FUNC_HANDLE references and returns the unique (name, fvTyp)
// pairs.  fvTyp is the instruction's Typ for OP_FUNC_VALUE
// (TYP_FUNC_VALUE / TYP_MANAGED_FUNC_VALUE) and synthesized from the
// target function's signature for OP_FUNC_HANDLE (whose IR result
// type is the opaque *uint8).  Cross-module references — those
// whose qualified function name doesn't resolve in mod.Funcs — are
// excluded: the defining module's LLVM-emitted __handle / __vt /
// __shim triplet is already in its .o, and the linker resolves the
// reference cross-TU; emitting our own definitions would be wasteful
// and risks the previous attempt's duplicate-symbol pitfall
// (plan-uniform-native-fnptrs.md Phase 4).
func collectFuncValueRefs(mod @ir.Module) (@[]@[]char, @[]@types.Type) {
	var seen @[]@[]char
	var sigs @[]@types.Type
	// Pre-pass: emit triplets for every IsLinkOnce function defined
	// in this TU (dtors + copy helpers from gen_dtor_emit /
	// gen_copy_emit, marked IsLinkOnce=true).  Without this, only
	// packages that internally reference their own dtor as an
	// OP_FUNC_HANDLE would emit the __vt/__handle/__shim triplet —
	// every consumer would then have to emit its own weak copy to
	// dispatch through the handle, which silently collides on
	// Mach-O strict-symbol semantics (the dtor-vt cluster the
	// macOS aa64 lane was failing on).  The matching consumer-side
	// skip lives in lookupFuncValueTypeAA64's IsExtern gate below.
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		if !f.IsLinkOnce { continue }
		var params @[]@types.Param
		for j := 0; j < len(f.Params); j++ {
			var p @types.Param = make(types.Param)
			p.Name = f.Params[j].Name
			p.Type = f.Params[j].Typ
			params = slices.Append[@types.Param](params, p)
		}
		var fvTyp @types.Type =
			types.MakeFuncValueType(params, f.Results)
		seen = slices.Append[@[]char](seen, f.Name)
		sigs = slices.Append[@types.Type](sigs, fvTyp)
	}
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		for j := 0; j < len(f.Blocks); j++ {
			var blk @ir.Block = f.Blocks[j]
			for k := 0; k < len(blk.Instrs); k++ {
				var ins @ir.Instr = blk.Instrs[k]
				if ins.Op != ir.OP_FUNC_VALUE &&
						ins.Op != ir.OP_FUNC_HANDLE {
					continue
				}
				var dup bool = false
				for s := 0; s < len(seen); s++ {
					if charEqAA64(seen[s], ins.StrVal) {
						dup = true
						break
					}
				}
				if dup { continue }
				var sigTyp @types.Type = ins.Typ
				if ins.Op == ir.OP_FUNC_HANDLE {
					sigTyp = lookupFuncValueTypeAA64(mod, ins.StrVal)
					if sigTyp == nil { continue }
				}
				seen = slices.Append[@[]char](seen, ins.StrVal)
				sigs = slices.Append[@types.Type](sigs, sigTyp)
			}
		}
	}
	return seen, sigs
}

// lookupFuncValueTypeAA64 finds a function in the module by qualified
// name and synthesizes a TYP_FUNC_VALUE from its parameter / result
// signature.  Mirrors lookupFuncValueType in pkg/binate/codegen — used to
// back OP_FUNC_HANDLE references (whose IR result is opaque *uint8)
// with the same per-function shim/vtable/handle emission as
// OP_FUNC_VALUE.  Returns nil for cross-module references (function
// not in mod.Funcs); the caller skips local emission, since the
// defining TU already provides the triplet.
func lookupFuncValueTypeAA64(mod @ir.Module, qname @[]char) @types.Type {
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		// Skip extern entries — they're cross-module imports
		// (gen_import.bn:NewExternFunc).  Returning a non-nil
		// sigTyp for an extern would cause emitFuncValueVtables to
		// re-emit __vt/__handle/__shim locally, duplicating the
		// defining TU's emission and breaking Mach-O strict-symbol
		// link.  The defining TU's `collectFuncValueRefs` pre-pass
		// (above) already emits the triplet for every IsLinkOnce
		// function it defines, so cross-TU references resolve
		// correctly at link time.
		if f.IsExtern { continue }
		if !charEqAA64(f.Name, qname) { continue }
		// ir.Param has Name + Typ; types.Param has Name + Type.
		// Copy field-by-field into a fresh @[]@types.Param.
		var params @[]@types.Param
		for j := 0; j < len(f.Params); j++ {
			var p @types.Param = make(types.Param)
			p.Name = f.Params[j].Name
			p.Type = f.Params[j].Typ
			params = slices.Append[@types.Param](params, p)
		}
		return types.MakeFuncValueType(params, f.Results)
	}
	return nil
}

// shimReturnSize returns the byte size of a function value's
// single-result return type, or 0 for void / multi-return.  Multi-
// return funcvalues stay on the scalar shim path (packed return into
// X0..X(N-1)); only single-result aggregates take the pack/sret
// shim shapes.  emitCallFuncValue's `aggregateRet` flag agrees:
// multi-return funcvalues use the scalar caller convention.
func shimReturnSize(fvTyp @types.Type) int {
	if fvTyp == nil { return 0 }
	if len(fvTyp.Results) != 1 { return 0 }
	if fvTyp.Results[0] == nil { return 0 }
	return fvTyp.Results[0].SizeOf()
}

// shimReturnIsAggregate reports whether a function value's single result is an
// aggregate (struct/array).  The pack/sret shim shapes are for aggregate
// returns; a scalar result (≤ 8 bytes by nature) tail-branches.  Size alone
// can't distinguish a ≤ 8-byte aggregate from a scalar, so the aggregate shim
// floor keys on this, not just shimReturnSize.
func shimReturnIsAggregate(fvTyp @types.Type) bool {
	if fvTyp == nil { return false }
	if len(fvTyp.Results) != 1 { return false }
	if fvTyp.Results[0] == nil { return false }
	return common.IsAggregateTyp(fvTyp.Results[0])
}

// emitFuncValueShims emits a per-function shim for each
// OP_FUNC_VALUE reference.  Three shapes depending on the function
// value's return type:
//
//   Scalar / void return (a NON-aggregate result — ≤ 8 bytes by
//   nature — or void): the shim has signature
//     `<ret>(*uint8 data, <args>)` — call passes data in X0 and
//     user args in X1+.  Shim shifts X1..XN → X0..X(N-1) (data
//     discarded) and tail-branches to the real fn.
//
//   Pack-return aggregate (an aggregate result, SizeOf 1..16 bytes —
//   one or two words; a ≤ 8-byte aggregate packs into one): the shim
//   has signature
//     `void(*uint8 retbuf, *uint8 data, <args>)` — call passes
//   retbuf in X0, data in X1, user args in X2+.  Shim builds a
//   real frame, stashes retbuf, shifts user args X2..X(N+1) →
//   X0..X(N-1), BL's the underlying fn, then copies X0..X(R-1)
//   (the underlying's packed register return) through the stashed
//   retbuf.  Matches what rt._call_shim_aggregate's caller expects:
//   the aggregate result materialized at retbuf.
//
//   Sret-return aggregate (SizeOf > 16 bytes): same incoming shape
//   as pack-return, but underlying uses AAPCS sret (X8 = retbuf
//   pointer).  Shim moves retbuf X0 → X8, shifts user args, tail-
//   branches.  Multi-return tuples > 16 bytes go through here too
//   (sret-via-X8 is universal for big returns).
//
// Bootstrap-subset constraint: scalar args only (no floats; no
// aggregate args).  Pack-return path also requires nUserWords ≤ 6
// (X2..X7 after retbuf in X0 and dropped data in X1) so all user
// args fit in registers — stack-arg shuffling for >6 register-
// words isn't implemented.
func emitFuncValueShims(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	var seen @[]@[]char
	var sigs @[]@types.Type
	seen, sigs = collectFuncValueRefs(mod)
	if len(seen) == 0 { return }
	a.SetSection("text", -1)
	for i := 0; i < len(seen); i++ {
		var fnLabel @[]char = symFor(pkgName, seen[i])
		var shimLabel @[]char = shimSymFor(pkgName, seen[i])
		var fvTyp @types.Type = sigs[i]
		a.DefineLabel(shimLabel)
		a.SetWeak(shimLabel)
		// B.2 of plan-function-values-phase-2.md: if the referenced
		// function is a capturing closure, branch to the closure-
		// aware shim emitter which loads captures from the data
		// pointer (X0) into the leading arg registers before the
		// tail-branch.  Non-closure path (Phase 1) stays unchanged.
		var closureFunc @ir.Func = lookupClosureFuncAA64(mod, seen[i])
		if closureFunc != nil {
			emitClosureShim(a, fnLabel, fvTyp, closureFunc)
			continue
		}
		// Count REGISTER WORDS, not params: a slice / managed-slice
		// param occupies 2 / 4 consecutive arg registers and the
		// shim has to shift all of them, not just the first.  Before
		// the per-arg-words fix (7096a94), a
		// `*func(*[]readonly char) int` shim ran a single MOV X0, X1
		// and left the slice's len in X2 dangling.
		var nUserWords int = 0
		for pi := 0; pi < len(fvTyp.Params); pi++ {
			nUserWords = nUserWords +
				common.ArgWords(fvTyp.Params[pi].Type)
		}
		if nUserWords > 8 {
			// Stack-passed args would need their own shuffling.
			// Beyond the bootstrap subset; clamp to 8 register
			// words and accept the truncation.
			nUserWords = 8
		}
		var retSz int = shimReturnSize(fvTyp)
		var retIsAgg bool = shimReturnIsAggregate(fvTyp)
		var useSret bool = retSz > 16
		// An aggregate result of 1..16 bytes is returned to the caller through
		// the retbuf it passed in X0 — INCLUDING a ≤ 8-byte aggregate, which is
		// packed into one word.  (A scalar result is also ≤ 8 bytes but is NOT
		// an aggregate, so it stays on the tail-branch scalar shape — hence the
		// retIsAgg gate rather than a bare size floor.)
		var usePack bool = retIsAgg && retSz >= 1 && retSz <= 16
		if usePack && nUserWords <= 6 {
			// Pack-return aggregate shim — see top of function.
			// Frame: 32 bytes (16 for FP/LR, 16 for the retbuf save
			// slot + alignment pad).  Saves retbuf at [SP+16];
			// X19+ are unnecessary because the only inter-BL state
			// we need is retbuf, and we reload it from the stack
			// after BL into a caller-saved reg (no need to preserve
			// across the call ourselves).
			aarch64.Stp(a, true, aarch64.FP, aarch64.LR,
				aarch64.MemPre(aarch64.SP, -32))
			aarch64.Mov(a, true, aarch64.FP,
				aarch64.Reg(aarch64.SP))
			aarch64.Str(a, true, aarch64.X0,
				aarch64.MemImm(aarch64.SP, 16))
			// Shift user args X2..X(N+1) → X0..X(N-1).  Left-to-
			// right preserves correctness (each src read before
			// its dest is overwritten).
			for ai := 0; ai < nUserWords; ai++ {
				aarch64.Mov(a, true, argReg(ai),
					aarch64.Reg(argReg(ai + 2)))
			}
			a.SetGlobal(fnLabel)
			aarch64.Bl(a, fnLabel)
			// X0..X(retWords-1) hold underlying's packed return.
			// The pack-return path covers an aggregate retSz 1..16 —
			// at most 2 words → X0..X1 (a ≤ 8-byte aggregate is just
			// X0, retWords == 1).  Reload retbuf into X9
			// (outside both the arg and return register banks) so
			// the reload can never clobber the return registers,
			// matching the convention used elsewhere in this file.
			aarch64.Ldr(a, true, aarch64.X9,
				aarch64.MemImm(aarch64.SP, 16))
			var retWords int = retSz / 8
			if retSz % 8 != 0 { retWords = retWords + 1 }
			for ri := 0; ri < retWords; ri++ {
				aarch64.Str(a, true, argReg(ri),
					aarch64.MemImm(aarch64.X9, 8 * ri))
			}
			aarch64.Ldp(a, true, aarch64.FP, aarch64.LR,
				aarch64.MemPost(aarch64.SP, 32))
			aarch64.Ret(a)
		} else if useSret {
			// Sret-return aggregate shim: retbuf → X8, drop data,
			// shift user args X2..X(N+1) → X0..X(N-1), tail-branch.
			// X8 must be set BEFORE the X2..→X0.. shifts because
			// X0 itself is one of the shift sources.
			aarch64.Mov(a, true, aarch64.X8,
				aarch64.Reg(aarch64.X0))
			for ai := 0; ai < nUserWords; ai++ {
				aarch64.Mov(a, true, argReg(ai),
					aarch64.Reg(argReg(ai + 2)))
			}
			a.SetGlobal(fnLabel)
			aarch64.B(a, fnLabel)
		} else {
			// Scalar / void shim: data was in X0; drop it and shift
			// user args X1..XN → X0..X(N-1).
			for ai := 0; ai < nUserWords; ai++ {
				aarch64.Mov(a, true, argReg(ai),
					aarch64.Reg(argReg(ai + 1)))
			}
			a.SetGlobal(fnLabel)
			aarch64.B(a, fnLabel)
		}
	}
	// Pad back up to instruction alignment for subsequent emissions.
	a.Align(4)
}

// emitFuncValueVtables walks the module for OP_FUNC_VALUE and
// OP_FUNC_HANDLE references and emits the per-function backing
// globals each one needs:
//
//   _bn_<pkg>__<fn>__vt           ; aa64-style vtable, weak.
//                                ;   .quad 0                ; dtor
//                                ;   .quad _bn_..__shim     ; call
//   ___handle.bn_<pkg>__<fn>     ; LLVM-shape handle, weak (Phase 4).
//                                ;   .quad <vt label>       ; vtable
//                                ;   .quad 0                ; data
//
// Two distinct vtable symbols coexist: the aa64-style one is what
// OP_FUNC_VALUE construction reaches via vtableSymFor, while the
// LLVM-shape handle's vt slot points at the same aa64 vtable (layout
// agrees — `{dtor, call}` either way).  OP_FUNC_HANDLE references
// read the handle via handleSymFor; OP_CALL_HANDLE loads
// handle.vtable.call from that, dispatches as `call(data, args)`.
// Phase 4 of plan-uniform-native-fnptrs.md.
func emitFuncValueVtables(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	var seen @[]@[]char
	var ignored @[]@types.Type
	seen, ignored = collectFuncValueRefs(mod)
	if len(ignored) > 0 || len(seen) == 0 {
		// Use ignored to silence unused warnings; sigs aren't used in
		// vtable emit (they're consumed by emitFuncValueShims).
	}
	if len(seen) == 0 { return }
	a.SetSection("data", -1)
	for i := 0; i < len(seen); i++ {
		var vtLabel @[]char = vtableSymFor(pkgName, seen[i])
		var shimLabel @[]char = shimSymFor(pkgName, seen[i])
		a.DefineLabel(vtLabel)
		a.SetWeak(vtLabel)
		// Reference shimLabel so the assembler resolves it as a relocation.
		a.SetGlobal(shimLabel)
		// dtor slot.  Null for the *func form and for non-capturing
		// literals (data is nil, nothing to destruct).  For a capturing
		// @func whose closure struct needs destruction, point at the
		// closure-struct dtor's HANDLE so the managed-ptr RefDec at the
		// @func variable's scope-end walks the vtable, releases each
		// managed capture, then frees the closure struct itself.  Without
		// this the slot stays null, OP_FUNC_VALUE_DTOR yields null,
		// rt.ZeroRefDestroy skips the dtor, and the captured value's ref
		// leaks (conformance 550 read rt.Refcount 2 instead of 1).
		// Mirrors emitFuncValueVtableDtor in pkg/binate/codegen.
		emitFuncValueVtableDtorSlot(a, pkgName, mod, seen[i])
		// call slot: pointer to the per-function shim (always-shim
		// convention). The linker resolves the relocation to the
		// shim's runtime address.
		a.EmitAddr(shimLabel)

		// Phase 4 handle global — points at the vtable above; data
		// slot is null (non-capturing).  Mirrors emitFuncValueHandle
		// in pkg/binate/codegen.  Weak (N_WEAK_DEF) so an LLVM-emitted dep
		// that happens to export the same symbol gets deduped by the
		// linker rather than producing a duplicate-definition error.
		var handleLabel @[]char = handleSymFor(pkgName, seen[i])
		a.DefineLabel(handleLabel)
		a.SetWeak(handleLabel)
		a.EmitAddr(vtLabel)
		a.Zero(8)
	}
}

// emitFuncValueVtableDtorSlot writes the 8-byte dtor slot (slot 0) of
// the function value vtable for `qname`.  For a capturing @func whose
// closure struct needs destruction it emits a pointer to the closure-
// struct dtor's HANDLE (`___handle.<dtor>`); otherwise 8 bytes of zero.
//
// Slot 0 carries the dtor's HANDLE pointer, not a raw fn pointer,
// because OP_FUNC_VALUE_DTOR -> rt.ZeroRefDestroy dispatches it as
// `handle.vtable.call(handle.data, ptr)` (an OP_CALL_HANDLE) — the
// same convention the LLVM backend uses (emitFuncValueVtableDtor).
//
// The referenced `___handle.<dtor>` triple is already emitted by this
// pass's IsLinkOnce pre-pass (collectFuncValueRefs adds every local
// IsLinkOnce func — closure-struct dtors among them — to `seen`).  Its
// symbol resolves the same whether keyed on the dtor func's qualified
// Name (what the pre-pass uses) or on the unqualified
// f.ClosureStructDtorName here: mangle.FuncName folds a same-package
// qualifier prefix and a pkgName-prefixed unqualified name to the
// identical `bn_<pkg>__<dtor>` symbol, so handleSymFor(pkgName,
// f.ClosureStructDtorName) names exactly that triple's handle — no new
// global, no dangling reference.
func emitFuncValueVtableDtorSlot(a @asm.Assembler,
		pkgName *[]readonly char, mod @ir.Module, qname @[]char) {
	var f @ir.Func = lookupClosureFuncAA64(mod, qname)
	if f == nil || !f.IsManagedFuncValue || f.ClosureStruct == nil ||
			!f.ClosureStruct.NeedsDestruction() ||
			len(f.ClosureStructDtorName) == 0 {
		a.Zero(8)
		return
	}
	var h @[]char = handleSymFor(pkgName, f.ClosureStructDtorName)
	a.SetGlobal(h)
	a.EmitAddr(h)
}

// shimSymFor returns the underscore-prefixed Mach-O label for a
// function's per-function shim global: "_bn_<pkg>__<name>__shim".
func shimSymFor(pkgName *[]readonly char, fnName *[]readonly char) @[]char {
	var fn @[]char = symFor(pkgName, fnName)
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(fn)
	cb = cb.WriteStr("__shim")
	return cb.Bytes()
}

// vtableSymFor returns the underscore-prefixed Mach-O label for a
// function's vtable global: "_bn_<pkg>__<name>__vt".
func vtableSymFor(pkgName *[]readonly char, fnName *[]readonly char) @[]char {
	var fn @[]char = symFor(pkgName, fnName)
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(fn)
	cb = cb.WriteStr("__vt")
	return cb.Bytes()
}
