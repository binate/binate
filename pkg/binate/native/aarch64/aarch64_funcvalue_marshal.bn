package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/binate/types/abi"

// emitShimArgMarshalAA64 marshals the func-value shim's incoming all-int,
// positional-GP user args into the AAPCS64 layout the underlying function
// expects, FOR THE REGISTER-ONLY CASE (every word in a GP/FP register).  The
// shim is entered under the uniform all-int dispatch ABI (the VM's
// rt._call_shim_scalar and the compiled emitCallFuncValue both place every arg
// word — float bits included — in a GP register): incoming user-arg word w
// sits in argReg(prefix + w), where `prefix` is the count of leading GP words
// to drop (1 = data, for the scalar/void shape; 2 = retbuf + data, for the
// pack/sret aggregate shapes).
//
// Each float-scalar param is `fmov`'d from its GP slot into the FP register
// the underlying reads (d/s[nsrn], an independent FP-register counter — the
// NSRN of AAPCS64); every other param stays in GP and shifts down past the
// dropped prefix (the NGRN sequence).  This is the native half of the float
// shim ABI; the LLVM shim does the same bitcast in IR.
//
// Clobber-safety: the GP destination index never exceeds the GP source index
// (ngrn <= srcWord and prefix >= 1, so dst < src), hence left-to-right MOVs
// read each source before it is overwritten; FMOVs target the disjoint FP
// register file, so they never clobber a GP source either.
//
// This path assumes everything fits in registers — callers gate it on the
// register budget and route genuine overflow to emitFuncvalSpillShimAA64.
func emitShimArgMarshalAA64(a @asm.Assembler, cc callconv.CallConv, fvTyp @types.Type, prefix int) {
	// Clobber-safe staging, ONLY when a coerced aggregate is present.  Such an
	// arg makes the OUTGOING register cursor (ArgWords words) advance faster
	// than the INCOMING by-address cursor (one pointer word), so an outgoing
	// write below can land in a LATER param's not-yet-read incoming arg register
	// (neither direction is safe — a register-permutation hazard).  Without a
	// coerced aggregate, incoming and outgoing advance in lockstep (a constant
	// down-shift), which is already clobber-safe, so we skip staging (and its
	// per-arg overhead).  When staging: copy every incoming user-arg dispatch
	// word from argReg(prefix+w) into a scratch register X9.. (X9..X15, disjoint
	// from the X0..X7 outgoing bank and the X16/X17 assembler temps; nIn <= the
	// <= 7 shim budget), then read each incoming word from X9.. below.
	var needStage bool = false
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		if isByAddressAggAA64(cc, fvTyp.Params[pi].Type) { needStage = true }
	}
	if needStage {
		var nIn int = 0
		for pi := 0; pi < len(fvTyp.Params); pi++ {
			nIn = nIn + shimInWordsForTypeAA64(cc, fvTyp.Params[pi].Type)
		}
		for w := 0; w < nIn; w++ {
			aarch64.Mov(a, true, aarch64.X9 + w, aarch64.Reg(argReg(prefix + w)))
		}
	}
	var ngrn int = 0
	var nsrn int = 0
	var srcWord int = 0
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		if callconv.IsFloatScalarTyp(pt) {
			if nsrn < 8 {
				var fsrc int = argReg(prefix + srcWord)
				if needStage { fsrc = aarch64.X9 + srcWord }
				if callconv.FloatScalarIsI32(pt) {
					aarch64.Fmov_w_to_s(a, aarch64.D0 + nsrn, fsrc)
				} else {
					aarch64.Fmov_gp_to_fp(a, aarch64.D0 + nsrn, fsrc)
				}
				nsrn = nsrn + 1
			}
			srcWord = srcWord + 1
			continue
		}
		hn, hw := abi.HfaClassify(pt)
		if cc.HfaAggregates && hn > 0 && callconv.AggCoercedInReg(pt) {
			// HFA arg: arrives as ONE by-address pointer word (staged in
			// X9+srcWord like any coerced aggregate), but the underlying reads
			// its members from the FP file — load member m into D[nsrn+m].
			// Must precede the AggCoercedInReg GP-expansion below (an HFA is
			// also AggCoercedInReg).  The register-only shim path only reaches
			// here within the FP budget (a single HFA is <=4 members); wider FP
			// arg lists route to the stack-spill shim.
			var ptrReg int = argReg(prefix + srcWord)
			if needStage { ptrReg = aarch64.X9 + srcWord }
			for m := 0; m < hn; m++ {
				hfaMemberLoadToFp(a, aarch64.D0 + nsrn + m, ptrReg, m * hw, hw)
			}
			nsrn = nsrn + hn
			srcWord = srcWord + 1
			continue
		}
		if isByAddressAggAA64(cc, pt) {
			// By-address aggregate (coerced in-register struct/array OR a
			// non-coerced <=16B slice / iface-value): arrives as ONE by-address
			// pointer word (staged in X9+srcWord — needStage is true here);
			// load its ArgWords value-words into the consecutive GP regs the
			// underlying's real ABI reads.  The staged pointer reg (X9..) is
			// disjoint from the X0..X7 outgoing bank, so the loads can't clobber it.
			// (Register-only path: the caller gated on the budget, so the whole
			// aggregate fits in regs — no reg/stack straddle to split here.)
			var n int = callconv.ArgWords(pt)
			var ptrReg int = aarch64.X9 + srcWord
			for k := 0; k < n; k++ {
				aarch64.Ldr(a, true, argReg(ngrn + k), aarch64.MemImm(ptrReg, 8 * k))
			}
			ngrn = ngrn + n
			srcWord = srcWord + 1
			continue
		}
		// Remaining kinds ride their dispatch words directly (a register shift):
		// a non-float scalar (1 word) or an indirect-large aggregate (1 pointer
		// word — the dispatch caller placed it as one).  shimInWordsForTypeAA64
		// gives the incoming-word count (== EffectiveArgWords for these).
		var w int = shimInWordsForTypeAA64(cc, pt)
		for k := 0; k < w; k++ {
			var dst int = argReg(ngrn + k)
			var src int = argReg(prefix + srcWord + k)
			if needStage { src = aarch64.X9 + srcWord + k }
			if dst != src {
				aarch64.Mov(a, true, dst, aarch64.Reg(src))
			}
		}
		// Re-extend a narrow reg-passed slot the foreign producer may have left
		// dirty (abi/03 §3.3): the native callee reads the full 64-bit register.
		// canonicalizeSubWordReturn is a no-op for pointer/word-size/float; w is 1.
		canonicalizeSubWordReturn(a, pt, argReg(ngrn))
		ngrn = ngrn + w
		srcWord = srcWord + w
	}
}
