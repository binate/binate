package "pkg/binate/native/aarch64"

import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Func-value multi-return classification (AArch64)
// ============================================================
//
// The func-value SHIM and caller must classify a multi-return tuple's return
// shape (in-register field-per-register vs sret through X8) IDENTICALLY to the
// callee (emitMultiReturnPack / emitMultiReturnSret) and the direct call sites
// (collectMultiReturnFields) — otherwise the shim and the underlying disagree on
// whether a retbuf pointer is passed, mismarshaling the native↔LLVM boundary.
// Mirrors arm32_funcvalue_multiret.bn / x64_funcvalue_shim.bn's tuple helpers.

// funcValMultiReturnTupleAA64 builds the anonymous multi-return tuple struct for
// a function value's results (one field per result type, in order — field names
// don't affect layout), or nil when the function value isn't a multi-return
// (len(Results) <= 1).  Mirrors funcValMultiReturnTuple_x64.
func funcValMultiReturnTupleAA64(fvTyp @types.Type) @types.Type {
	if fvTyp == nil { return nil }
	if len(fvTyp.Results) <= 1 { return nil }
	var fields @[]@types.Field = make_slice(@types.Field, len(fvTyp.Results))
	for i := 0; i < len(fvTyp.Results); i++ {
		var f @types.Field = make(types.Field)
		f.Type = fvTyp.Results[i]
		fields[i] = f
	}
	return types.MakeStructType("", fields)
}

// isBigMultiReturnAA64 reports whether the function value's multi-return tuple is
// returned via an sret pointer (X8) rather than field-per-register in X0..X7 /
// D0..D7.  It uses the SAME register-count rule (AAPCS64.MultiReturnTupleNeedsSret
// — a tuple whose GP + FP field classes exceed the return-register budget, or > 64
// bytes) the callee (FuncReturnsBigMultiReturn) and the regular call sites use, so
// the funcval shim agrees with the callee — a size-only rule would disagree for
// e.g. (i64 x8) (64 bytes, but 8 GP words → in-register) at the native↔LLVM
// boundary.
func isBigMultiReturnAA64(fvTyp @types.Type) bool {
	var t @types.Type = funcValMultiReturnTupleAA64(fvTyp)
	if t == nil { return false }
	return aarch64CC().MultiReturnTupleNeedsSret(t)
}
