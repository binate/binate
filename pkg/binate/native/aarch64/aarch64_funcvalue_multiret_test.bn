package "pkg/binate/native/aarch64"

import "pkg/binate/types"
import "pkg/builtins/testing"

// mkMultiRetFvAA64test builds a func-value type with n int64 results and no
// params, i.e. a multi-return func value whose tuple is n GP words on AAPCS64.
func mkMultiRetFvAA64test(n int) @types.Type {
	var noParams @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, n)
	for i := 0; i < n; i++ { results[i] = types.TypInt64() }
	return types.MakeFuncValueType(noParams, results)
}

// isBigMultiReturnAA64 uses the register-count rule: (int64 x8) = 8 GP words fits
// X0..X7 (in-register, not big); (int64 x9) = 9 GP words overflows to X8 sret
// (big).  It must classify identically to the callee / caller or the shim
// boundary mismarshals at the native↔LLVM boundary.
func TestIsBigMultiReturnAA64RegisterCount() testing.TestResult {
	if isBigMultiReturnAA64(mkMultiRetFvAA64test(8)) {
		return "(int64 x8) = 8 GP words must be in-register (X0..X7), not big"
	}
	if !isBigMultiReturnAA64(mkMultiRetFvAA64test(9)) {
		return "(int64 x9) = 9 GP words must be a big (sret via X8) multi-return"
	}
	if isBigMultiReturnAA64(mkMultiRetFvAA64test(1)) {
		return "a single result is not a multi-return"
	}
	return ""
}

// funcValMultiReturnTupleAA64 builds the anonymous (unnamed) tuple struct for a
// multi-return func value's results, and nil for a single-result / void func
// value.  The tuple's fields must match the results in order.
func TestFuncValMultiReturnTupleAA64() testing.TestResult {
	var t @types.Type = funcValMultiReturnTupleAA64(mkMultiRetFvAA64test(3))
	if t == nil {
		return "a 3-result func value must yield a tuple type"
	}
	if len(t.Name) != 0 {
		return "the multi-return tuple must be anonymous (no name)"
	}
	if len(t.Fields) != 3 {
		return "the tuple must have one field per result (3)"
	}
	if funcValMultiReturnTupleAA64(mkMultiRetFvAA64test(1)) != nil {
		return "a single-result func value is not a multi-return tuple"
	}
	return ""
}
