package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for aarch64_funcvalue_packed.bn: the per-function packed-dispatch shim
// (__shimP) the func-value vtable's slot-2 call_packed target points at.
// __shimP gathers the VM caller's packed int-slot args into __shim's incoming
// all-int dispatch ABI and branches/calls __shim (which does the real
// marshalling); the register-only case tail-branches (no frame), the > budget
// case frames a spill.

// packedShimForNIntsAA64 emits __shimP for an IsLinkOnce func value with nParams
// int64 params (scalar return) and returns (byteLen, hadError).  Mirrors the
// spill-shim tests' wideShimEmitsAA64 module shape, but drives the packed emitter.
func packedShimForNIntsAA64(nParams int) (int, bool) {
	var mod @ir.Module = ir.NewModule("\"main\"")
	var params @[]@ir.Param
	for i := 0; i < nParams; i++ {
		var p @ir.Param = make(ir.Param)
		p.Name = "x"
		p.Typ = types.TypInt64()
		params = appendIrParam_spilltest_aa64(params, p)
	}
	var f @ir.Func = ir.NewFunc("", "pk", params, scalarResult_spilltest_aa64())
	f.IsLinkOnce = true
	mod.AddFunc(f)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitFuncValuePackedShims(a, "main", mod)
	return a.Sections[0].Len, a.HasError
}

// A func value gets a non-empty __shimP, emitted without error.
func TestPackedShimEmitted() testing.TestResult {
	var n int
	var err bool
	n, err = packedShimForNIntsAA64(2)
	if err {
		return "packed shim emission must not SetError"
	}
	if n == 0 {
		return "a func value must emit a non-empty __shimP"
	}
	return ""
}

// The > register-budget (spill) __shimP frames an outgoing-args area and BLs
// (then unwinds), so it is strictly longer than the register-only tail-branch
// __shimP.  9 int64 user words exceed the scalar-shape budget (7 = X1..X7), so
// two words spill; 2 words stay register-only.  A regression that dropped the
// spill frame (or capped arity) would collapse the two lengths.
func TestPackedShimSpillLongerThanRegisterOnly() testing.TestResult {
	var regOnly int
	var spill int
	var e1 bool
	var e2 bool
	regOnly, e1 = packedShimForNIntsAA64(2)
	spill, e2 = packedShimForNIntsAA64(9)
	if e1 || e2 {
		return "packed shim emission must not SetError"
	}
	if spill <= regOnly {
		return "the >7-arg (spill) __shimP must be longer than the register-only one"
	}
	return ""
}

// quadTypAA64 returns a 32-byte struct of four int64s — an aggregate AAPCS64 passes
// as a pointer to a copy.
func quadTypAA64() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 4)
	for i := 0; i < 4; i++ {
		fields[i] = make(types.Field)
		fields[i].Name = "f"
		fields[i].Type = types.TypInt64()
	}
	return types.MakeStructType("Quad", fields)
}

// A __shimP whose func value takes a 32-byte struct copies it out of the VM's
// storage into its frame (X10 = the VM's pointer, X11 = the copy) and passes the
// copy's address — the underlying may write its parameter in place — so it frames
// even though both words fit the registers.
func TestPackedShimCopiesIndirectAggregate() testing.TestResult {
	setTarget64()
	var ps @[]@types.Param = make_slice(@types.Param, 2)
	ps[0] = make(types.Param)
	ps[0].Type = quadTypAA64()
	ps[1] = make(types.Param)
	ps[1].Type = types.TypInt64()
	var rs @[]@types.Type = make_slice(@types.Type, 1)
	rs[0] = types.TypInt64()
	var fv @types.Type = types.MakeFuncValueType(ps, rs)
	var a @asm.Assembler = opsMkAssembler()
	emitOnePackedShimAA64(a, callconv.AAPCS64(), buf.CopyStr("s"), fv)
	var ref @asm.Assembler = opsMkAssembler()
	aarch64.Mov(ref, true, aarch64.X9, aarch64.Reg(aarch64.X1))
	aarch64.Stp(ref, true, aarch64.FP, aarch64.LR, aarch64.MemPre(aarch64.SP, -16))
	aarch64.Mov(ref, true, aarch64.FP, aarch64.Reg(aarch64.SP))
	aarch64.Sub(ref, true, aarch64.SP, aarch64.SP, aarch64.Imm(32))
	aarch64.Ldr(ref, true, aarch64.X10, aarch64.MemImm(aarch64.X9, 0))
	aarch64.Add(ref, true, aarch64.X11, aarch64.SP, aarch64.Imm(0))
	emitAggCopyStraightAarch64(ref, aarch64.X11, aarch64.X10, 32, aarch64.X12, aarch64.X13)
	aarch64.Add(ref, true, aarch64.X1, aarch64.SP, aarch64.Imm(0))
	aarch64.Ldr(ref, true, aarch64.X2, aarch64.MemImm(aarch64.X9, 8))
	aarch64.Bl(ref, "s")
	aarch64.Add(ref, true, aarch64.SP, aarch64.SP, aarch64.Imm(32))
	aarch64.Ldp(ref, true, aarch64.FP, aarch64.LR, aarch64.MemPost(aarch64.SP, 16))
	aarch64.Ret(ref)
	if a.HasError || !sameTextAA64(a, ref) {
		return "a __shimP must copy a 32-byte aggregate argument into its frame and pass the copy"
	}
	return ""
}

// Past the straight-line size the __shimP copy is the copy loop: a func value taking
// one 200-byte struct (25 int64s) copies it with the 32-byte Q loop into a 208-byte
// frame area.
func TestPackedShimCopiesLargeAggregateWithLoop() testing.TestResult {
	setTarget64()
	var fields @[]@types.Field = make_slice(@types.Field, 25)
	for i := 0; i < 25; i++ {
		fields[i] = make(types.Field)
		fields[i].Name = "f"
		fields[i].Type = types.TypInt64()
	}
	var ps @[]@types.Param = make_slice(@types.Param, 1)
	ps[0] = make(types.Param)
	ps[0].Type = types.MakeStructType("W25", fields)
	var fv @types.Type = types.MakeFuncValueType(ps, make_slice(@types.Type, 0))
	var a @asm.Assembler = opsMkAssembler()
	emitOnePackedShimAA64(a, callconv.AAPCS64(), buf.CopyStr("s"), fv)
	var ref @asm.Assembler = opsMkAssembler()
	aarch64.Mov(ref, true, aarch64.X9, aarch64.Reg(aarch64.X1))
	aarch64.Stp(ref, true, aarch64.FP, aarch64.LR, aarch64.MemPre(aarch64.SP, -16))
	aarch64.Mov(ref, true, aarch64.FP, aarch64.Reg(aarch64.SP))
	aarch64.Sub(ref, true, aarch64.SP, aarch64.SP, aarch64.Imm(208))
	aarch64.Ldr(ref, true, aarch64.X10, aarch64.MemImm(aarch64.X9, 0))
	aarch64.Add(ref, true, aarch64.X11, aarch64.SP, aarch64.Imm(0))
	emitCopyLoopAarch64(ref, aarch64.X11, aarch64.X10, 200, aarch64.X12)
	aarch64.Add(ref, true, aarch64.X1, aarch64.SP, aarch64.Imm(0))
	aarch64.Bl(ref, "s")
	aarch64.Add(ref, true, aarch64.SP, aarch64.SP, aarch64.Imm(208))
	aarch64.Ldp(ref, true, aarch64.FP, aarch64.LR, aarch64.MemPost(aarch64.SP, 16))
	aarch64.Ret(ref)
	if a.HasError || !sameTextAA64(a, ref) {
		return "a __shimP must copy a 200-byte aggregate argument with the copy loop"
	}
	return ""
}
