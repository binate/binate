package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/binate/types/abi"

// isByAddressAggAA64 reports whether an aggregate func-value ARG rides the shim
// ABI BY-ADDRESS (one pointer word the shim loads + re-expands): a coerced
// in-register named struct/array (AggCoercedInReg, incl. HFAs) OR any other
// <=16-byte non-indirect-large aggregate — a raw slice / iface-value.  This
// matches the LLVM cross-package shim, which declares every such aggregate `i8*`.
// (An indirect-large > AggregateInRegMax aggregate ALSO rides by-address, but the
// callconv already models it as one pointer word — EffectiveArgWords == 1,
// CallArgRegStart one reg — so it is excluded here and needs no substitution.)
// This is the aa64 counterpart of arm32's isByAddressAggArm32: a non-coerced
// slice / iface-value passed first-class would desync with the LLVM shim.
func isByAddressAggAA64(cc callconv.CallConv, pt @types.Type) bool {
	if callconv.AggCoercedInReg(pt) { return true }
	if !callconv.IsAggregateTyp(pt) { return false }
	if cc.IndirectLargeAggregates && pt.SizeOf() > cc.AggregateInRegMax { return false }
	return pt.SizeOf() <= cc.AggregateInRegMax
}

// shimInWordsForTypeAA64 is the number of INCOMING dispatch words a func-value
// arg of type pt occupies: 1 for a by-address aggregate (isByAddressAggAA64 — the
// shim re-expands its ArgWords value-words from the one pointer), else
// cc.EffectiveArgWords (which already returns 1 for an indirect-large aggregate).
func shimInWordsForTypeAA64(cc callconv.CallConv, pt @types.Type) int {
	if isByAddressAggAA64(cc, pt) { return 1 }
	return cc.EffectiveArgWords(pt)
}

// Per-function func-value SHIM body emission for the AArch64 backend —
// the text-section half of the func-value triple.  Reference collection
// and the vtable / handle data globals live in aarch64_funcvalue.bn;
// EmitObject drives emitFuncValueShims (here) before emitFuncValueVtables
// (there).  Split out to keep each file under the hygiene length cap;
// mirrors x64_funcvalue_shim.bn.
//
// The shim is entered under the uniform all-int dispatch ABI (the VM's
// rt._call_shim_scalar and the compiled emitCallFuncValue both place
// every arg WORD — float bits included — positionally in a GP register,
// after a leading data slot, or retbuf+data for the aggregate shapes).
// The shim re-marshals those words into the real AAPCS64 layout the
// underlying function expects, then tail-branches (when every outgoing
// arg is in a register) or BLs with a frame (when the underlying needs
// outgoing-args on the stack, or the return must be post-processed).

// shimReturnSize returns the byte size of a function value's
// single-result return type, or 0 for void / multi-return.  Multi-
// return funcvalues stay on the scalar shim path (packed return into
// X0..X(N-1)); only single-result aggregates take the pack/sret
// shim shapes.  emitCallFuncValue's `aggregateRet` flag agrees:
// multi-return funcvalues use the scalar caller convention.
func shimReturnSize(fvTyp @types.Type) int {
	if fvTyp == nil { return 0 }
	if len(fvTyp.Results) != 1 { return 0 }
	if fvTyp.Results[0] == nil { return 0 }
	return fvTyp.Results[0].SizeOf()
}

// shimReturnIsAggregate reports whether a function value's single result rides
// the retbuf (pack/sret) shim shape rather than the scalar/void tail-branch.  It
// delegates to abi.IsAggregateReturnTyp — the single-source-of-truth predicate
// the LLVM shim (codegen isAggregateReturn), the call site, and the VM cross-mode
// dispatch all agree on — so the closure dispatch and the retIsAgg gate classify a
// result exactly as the LLVM-emitted shim does.  For every SizeOf >= 1 aggregate
// this matches the kind-only callconv.IsAggregateTyp; it differs only for a 0-byte
// aggregate (`struct{}` / `[0]T`), which is void-like (no retbuf) and must NOT take
// the pack shim — it would store a garbage word through a 0-byte retbuf the caller
// never allocated.  (The non-closure retIsAgg use also gates usePack on
// retSz >= 1, so the difference matters only for the CLOSURE dispatch's 0-byte
// routing.)
func shimReturnIsAggregate(fvTyp @types.Type) bool {
	if fvTyp == nil { return false }
	if len(fvTyp.Results) != 1 { return false }
	return abi.IsAggregateReturnTyp(fvTyp.Results[0])
}

// shimReturnIsFloatScalarAA64 reports whether a func value's single result is
// a float scalar.  Such a return can't ride the scalar tail-branch: the
// underlying returns it in d0/s0 (the FP register file), but the all-int shim
// ABI hands the bits back in x0, so the shim must BL and fmov d0/s0 -> x0/w0.
func shimReturnIsFloatScalarAA64(fvTyp @types.Type) bool {
	if fvTyp == nil { return false }
	if len(fvTyp.Results) != 1 { return false }
	return callconv.IsFloatScalarTyp(fvTyp.Results[0])
}

// emitFuncValueShims emits a per-function shim for each
// OP_FUNC_VALUE reference.  Three shapes depending on the function
// value's return type:
//
//   Scalar / void return (a NON-aggregate result — ≤ 8 bytes by
//   nature — or void): the shim has signature
//     `<ret>(*uint8 data, <args>)` — call passes data in X0 and
//     user args in X1+.  Shim shifts X1..XN → X0..X(N-1) (data
//     discarded) and tail-branches to the real fn.
//
//   Pack-return aggregate (an aggregate result, SizeOf 1..16 bytes —
//   one or two words; a ≤ 8-byte aggregate packs into one): the shim
//   has signature
//     `void(*uint8 retbuf, *uint8 data, <args>)` — call passes
//   retbuf in X0, data in X1, user args in X2+.  Shim builds a
//   real frame, stashes retbuf, shifts user args X2..X(N+1) →
//   X0..X(N-1), BL's the underlying fn, then copies X0..X(R-1)
//   (the underlying's packed register return) through the stashed
//   retbuf.  Matches what rt._call_shim_aggregate's caller expects:
//   the aggregate result materialized at retbuf.
//
//   Sret-return aggregate (SizeOf > 16 bytes): same incoming shape
//   as pack-return, but underlying uses AAPCS sret (X8 = retbuf
//   pointer).  Shim moves retbuf X0 → X8, shifts user args, tail-
//   branches.  Multi-return tuples > 16 bytes go through here too
//   (sret-via-X8 is universal for big returns).
//
// Float-scalar args are reconciled GP -> FP by emitShimArgMarshalAA64
// (the all-int dispatch ABI delivers them in GP registers); a float-
// scalar RETURN takes a fourth shape — BL + fmov d0/s0 -> x0/w0 + RET
// — because the underlying returns it in the FP file but the all-int
// shim hands the bits back in x0.  When the user-arg effective words
// exceed the register budget, each shape routes to its stack-spill
// variant (emitFuncvalSpillShimAA64) instead of failing.
func emitFuncValueShims(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	var seen @[]@[]char
	var sigs @[]@types.Type
	seen, sigs = collectFuncValueRefs(mod)
	if len(seen) == 0 { return }
	a.SetSection("text", -1)
	// aarch64CC (matching the lifted body's prologue and the
	// closure-float shim): the body packs a narrow FP/GP overflow stack arg
	// at its natural size, so the shim's OUTGOING marshal must place it at the
	// same natural offset/width.  The INCOMING dispatch words stay a uniform
	// 8-byte (emitCallFuncValue substitutes narrow args to *uint8 words).
	var cc callconv.CallConv = aarch64CC()
	for i := 0; i < len(seen); i++ {
		var fnLabel @[]char = symFor(pkgName, seen[i])
		var shimLabel @[]char = shimSymFor(pkgName, seen[i])
		var fvTyp @types.Type = sigs[i]
		a.DefineLabel(shimLabel)
		a.SetWeak(shimLabel)
		// If the referenced
		// function is a capturing closure, branch to the closure-
		// aware shim emitter which loads captures from the data
		// pointer (X0) into the leading arg registers before the
		// tail-branch.  Any other function takes the plain shim below.
		var closureFunc @ir.Func = lookupClosureFuncAA64(mod, seen[i])
		if closureFunc != nil {
			emitClosureShim(a, fnLabel, fvTyp, closureFunc)
			continue
		}
		// Count EFFECTIVE register words: a small slice (2 words) /
		// in-reg aggregate occupies that many consecutive arg registers
		// and the shim shifts all of them; an indirect-large aggregate
		// (managed-slice 4 words / struct > 16 B) is passed as a SINGLE
		// pointer (1 word), matching the dispatch caller and the
		// underlying AAPCS64.  Counting it via raw ArgWords would
		// over-count and spuriously trip the budget guard.
		var nUserWords int = 0
		var nUserFpRegs int = 0
		// nInWords is the INCOMING dispatch-word count, budgeted separately: a
		// zero-size by-address aggregate takes one incoming word (its address) but
		// no outgoing one, so the outgoing count alone can fit the registers while
		// the incoming words run onto the caller's stack, which the register-only
		// shapes cannot read.
		var nInWords int = funcvalPackedWordsAA64(cc, fvTyp)
		for pi := 0; pi < len(fvTyp.Params); pi++ {
			var pt @types.Type = fvTyp.Params[pi].Type
			// Budget the SHIM's register/spill routing on the OUTGOING (real
			// ABI) GP word count: a coerced in-register struct/array arrives as
			// ONE by-address pointer word (EffectiveArgWords == 1) but the shim
			// expands it into ArgWords coerced regs, so counting it via
			// EffectiveArgWords would undercount the outgoing register pressure
			// and wrongly keep a wide call on the register-only path.
			//
			// An HFA rides the FP file, not GP: it must be checked BEFORE
			// AggCoercedInReg (an HFA is also AggCoercedInReg) and counted toward
			// nUserFpRegs (its member count), NOT the GP-word budget — counting it
			// as ArgWords would both over-count GP (spuriously spilling a
			// register-fittable call) and, worse, MISS an FP-file overflow (a
			// multi-f32 HFA is 2 ArgWords but 4 FP regs), letting the register
			// path place members past v7 into the callee-saved v8+.  It still
			// consumes one INCOMING dispatch word (its by-address pointer), so it
			// adds EffectiveArgWords (== 1) to nUserWords for the incoming budget.
			// A float scalar likewise rides one FP register.
			if isHfaAggregate(pt) {
				nUserFpRegs = nUserFpRegs + abi.HfaMemberCount(pt)
				nUserWords = nUserWords + cc.EffectiveArgWords(pt)
			} else if isByAddressAggAA64(cc, pt) {
				// By-address aggregate (coerced OR non-coerced slice/iface): one
				// INCOMING pointer word, but the shim re-expands it into ArgWords
				// outgoing GP regs — budget the OUTGOING pressure (ArgWords) so a
				// wide call is routed to the spill shim, not kept register-only.
				nUserWords = nUserWords + callconv.ArgWords(pt)
			} else {
				if callconv.IsFloatScalarTyp(pt) && cc.NumFpArgRegs > 0 {
					nUserFpRegs = nUserFpRegs + 1
				}
				nUserWords = nUserWords + cc.EffectiveArgWords(pt)
			}
		}
		var retSz int = shimReturnSize(fvTyp)
		var retIsAgg bool = shimReturnIsAggregate(fvTyp)
		// An HFA result comes back from the underlying in D0..D3, not GP-packed
		// and not sret — even a >16-byte one (3x/4x f64).  It still travels to
		// the shim's caller through the retbuf (aggregate dispatch shape), so it
		// uses the pack frame but FMOVs the members into the retbuf.
		var retIsHfa bool = len(fvTyp.Results) == 1 && cc.ReturnsHfaInRegs(fvTyp.Results[0])
		var useSret bool = retSz > 16 && !retIsHfa
		// Multi-return classification.  aa64 has no SretInGpArgReg, so under
		// retbuf-for-any-multi-return the caller passes the retbuf in X0 (data in
		// X1) for EVERY multi-return.  A BIG tuple (MultiReturnTupleNeedsSret) is
		// written by the callee through X8, so the shim moves retbuf X0 → X8
		// internally and tail-branches (useSretMulti).  A SMALL tuple comes back
		// field-per-register (X0../D0..), so the shim CALLs, then stores the fields
		// through retbuf (usePackMulti).  Both consume X0+X1, so both carry a
		// 2-slot prefix and userBudget 6.  (The scalar tail-branch would never set X8
		// for a big tuple, and would read retbuf as data — conformance 979 crashes.)
		var isMultiRet bool = len(fvTyp.Results) > 1
		var useSretMulti bool = isMultiRet && isBigMultiReturnAA64(fvTyp)
		var usePackMulti bool = isMultiRet && !useSretMulti
		// An aggregate result of 1..16 bytes is returned to the caller through
		// the retbuf it passed in X0 — INCLUDING a ≤ 8-byte aggregate, which is
		// packed into one word.  (A scalar result is also ≤ 8 bytes but is NOT
		// an aggregate, so it stays on the tail-branch scalar shape — hence the
		// retIsAgg gate rather than a bare size floor.)
		var usePack bool = retIsAgg && retSz >= 1 && retSz <= 16 && !retIsHfa
		// Register budget for the tail-branch / register-only shapes below:
		// they can't read stack-passed incoming user args nor write stack-
		// passed outgoing ones.  The pack/sret and both multi-return shapes
		// consume X0+X1 for retbuf+data, leaving X2..X7 = 6 user words; the
		// scalar/float shapes consume only X0 (data), leaving 7.  Beyond that,
		// route to the stack-spill shim, which reserves an outgoing-args frame and
		// reads/writes the overflow words there.  (Silently clamping at
		// `nUserWords > 8` instead would miscompile wide funcvals.)
		var userBudget int = 7
		if usePack || useSret || retIsHfa || useSretMulti || usePackMulti {
			userBudget = 6
		}
		// Route to the stack-spill shim when EITHER the incoming/outgoing GP
		// words exceed the register budget OR the FP arg registers overflow (a
		// multi-HFA / float-heavy call whose members would spill past v7).  The
		// register-only path below has no outgoing frame, so it cannot place any
		// stack arg; both overflows must go to the spill shim.
		if nUserWords > userBudget || nInWords > userBudget || nUserFpRegs > cc.NumFpArgRegs {
			emitFuncvalSpillShimAA64(a, cc, fnLabel, fvTyp, retSz, usePack, useSret,
					shimReturnIsFloatScalarAA64(fvTyp), retIsHfa, usePackMulti, useSretMulti)
			continue
		}
		if retIsHfa {
			// HFA-return shim: same retbuf frame as the pack path, but the
			// underlying returns the 1-4 float members in D0..D(n-1), so FMOV
			// each into the retbuf rather than Str'ing GP words.  Covers every
			// HFA size (a 32-byte 4x f64 HFA still rides v0..v3, never sret).
			aarch64.Stp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPre(aarch64.SP, -32))
			aarch64.Mov(a, true, aarch64.FP, aarch64.Reg(aarch64.SP))
			aarch64.Str(a, true, aarch64.X0, aarch64.MemImm(aarch64.SP, 16))
			emitShimArgMarshalAA64(a, cc, fvTyp, 2)
			a.SetGlobal(fnLabel)
			aarch64.Bl(a, fnLabel)
			aarch64.Ldr(a, true, aarch64.X9, aarch64.MemImm(aarch64.SP, 16))
			hn, hw := abi.HfaClassify(fvTyp.Results[0])
			for m := 0; m < hn; m++ {
				hfaMemberStoreFromFp(a, aarch64.D0 + m, aarch64.X9, cast(int64, m * hw), hw)
			}
			aarch64.Ldp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPost(aarch64.SP, 32))
			aarch64.Ret(a)
		} else if usePack {
			// Pack-return aggregate shim — see top of function.
			// Frame: 32 bytes (16 for FP/LR, 16 for the retbuf save
			// slot + alignment pad).  Saves retbuf at [SP+16];
			// X19+ are unnecessary because the only inter-BL state
			// we need is retbuf, and we reload it from the stack
			// after BL into a caller-saved reg (no need to preserve
			// across the call ourselves).
			aarch64.Stp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPre(aarch64.SP, -32))
			aarch64.Mov(a, true, aarch64.FP, aarch64.Reg(aarch64.SP))
			aarch64.Str(a, true, aarch64.X0, aarch64.MemImm(aarch64.SP, 16))
			// Marshal user args (incoming X2..) into the underlying's
			// AAPCS64 layout: float scalars -> d/s regs, the rest
			// shifted down past retbuf + data.
			emitShimArgMarshalAA64(a, cc, fvTyp, 2)
			a.SetGlobal(fnLabel)
			aarch64.Bl(a, fnLabel)
			// X0..X(retWords-1) hold underlying's packed return.
			// The pack-return path covers an aggregate retSz 1..16 —
			// at most 2 words → X0..X1 (a ≤ 8-byte aggregate is just
			// X0, retWords == 1).  Reload retbuf into X9
			// (outside both the arg and return register banks) so
			// the reload can never clobber the return registers,
			// matching the convention used elsewhere in this file.
			aarch64.Ldr(a, true, aarch64.X9, aarch64.MemImm(aarch64.SP, 16))
			emitStoreArgRegsAarch64(a, retSz, aarch64.X9, 0, aarch64.X10)
			aarch64.Ldp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPost(aarch64.SP, 32))
			aarch64.Ret(a)
		} else if useSret {
			// Sret-return aggregate shim: retbuf → X8, drop data,
			// shift user args X2..X(N+1) → X0..X(N-1), tail-branch.
			// X8 must be set BEFORE the X2..→X0.. shifts because
			// X0 itself is one of the shift sources.
			aarch64.Mov(a, true, aarch64.X8, aarch64.Reg(aarch64.X0))
			emitShimArgMarshalAA64(a, cc, fvTyp, 2)
			a.SetGlobal(fnLabel)
			aarch64.B(a, fnLabel)
		} else if useSretMulti {
			// Big multi-return tuple: the callee writes it through X8 (AAPCS64
			// indirect result).  Same shape as a > 16-byte single aggregate —
			// move retbuf X0 → X8 BEFORE the arg shift (X0 is a shift source),
			// drop data, tail-branch (B preserves X8).
			aarch64.Mov(a, true, aarch64.X8, aarch64.Reg(aarch64.X0))
			emitShimArgMarshalAA64(a, cc, fvTyp, 2)
			a.SetGlobal(fnLabel)
			aarch64.B(a, fnLabel)
		} else if usePackMulti {
			// Small multi-return tuple: the callee returns it FIELD-PER-REGISTER
			// (X0../D0..), so the shim CALLs (a frame preserves LR), stashes
			// retbuf, marshals user args, then stores the fields THROUGH retbuf.
			// Same retbuf-save frame as the single-aggregate pack path, but the
			// store is the field-per-class helper (NOT a whole-word X0..X(N-1)
			// dump — that would read GP regs the callee never wrote for a float
			// field and ignore sub-word field sizing).
			aarch64.Stp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPre(aarch64.SP, -32))
			aarch64.Mov(a, true, aarch64.FP, aarch64.Reg(aarch64.SP))
			aarch64.Str(a, true, aarch64.X0, aarch64.MemImm(aarch64.SP, 16))
			emitShimArgMarshalAA64(a, cc, fvTyp, 2)
			a.SetGlobal(fnLabel)
			aarch64.Bl(a, fnLabel)
			// Reload retbuf into X9 (outside the arg + return register banks),
			// then store the field-per-register tuple through it.  X10 is the
			// field float→GP scratch (outside the return regs and X9 the base).
			aarch64.Ldr(a, true, aarch64.X9, aarch64.MemImm(aarch64.SP, 16))
			storeMultiReturnTupleFieldsAA64(a, funcValMultiReturnTupleAA64(fvTyp), aarch64.X9, 0,
					aarch64.X10)
			aarch64.Ldp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPost(aarch64.SP, 32))
			aarch64.Ret(a)
		} else if shimReturnIsFloatScalarAA64(fvTyp) {
			// Scalar shim whose result is a float scalar: the all-int
			// shim ABI returns the bits in x0, but the underlying
			// returns them in d0/s0, so this can't tail-branch.  Build
			// a minimal frame, marshal args (drop data), BL, fmov the
			// result d0/s0 -> x0/w0, unwind, RET.
			aarch64.Stp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPre(aarch64.SP, -16))
			aarch64.Mov(a, true, aarch64.FP, aarch64.Reg(aarch64.SP))
			emitShimArgMarshalAA64(a, cc, fvTyp, 1)
			a.SetGlobal(fnLabel)
			aarch64.Bl(a, fnLabel)
			if callconv.FloatScalarIsI32(fvTyp.Results[0]) {
				aarch64.Fmov_s_to_w(a, aarch64.X0, aarch64.D0)
			} else {
				aarch64.Fmov_fp_to_gp(a, aarch64.X0, aarch64.D0)
			}
			aarch64.Ldp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPost(aarch64.SP, 16))
			aarch64.Ret(a)
		} else {
			// Scalar / void shim: data was in X0; drop it and marshal
			// user args (float scalars -> d/s regs, the rest shifted
			// X1..XN -> X0..X(N-1)), then tail-branch.
			emitShimArgMarshalAA64(a, cc, fvTyp, 1)
			a.SetGlobal(fnLabel)
			aarch64.B(a, fnLabel)
		}
	}
	// Pad back up to instruction alignment for subsequent emissions.
	a.Align(4)
}
