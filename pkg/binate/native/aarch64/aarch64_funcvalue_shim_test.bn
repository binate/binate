package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for aarch64_funcvalue_shim.bn: the per-shape shim-body emission.

// shimLenForParam1AA64 emits the register-only func-value shim for a single-
// parameter function value `func(pty) int` and returns the shim's byte length.
func shimLenForParam1AA64(pty @types.Type) int {
	var mod @ir.Module = ir.NewModule("\"main\"")
	var p @ir.Param = make(ir.Param)
	p.Name = "x"
	p.Typ = pty
	var params @[]@ir.Param
	params = appendIrParam_spilltest_aa64(params, p)
	var f @ir.Func = ir.NewFunc("", "f", params, scalarResult_spilltest_aa64())
	f.IsLinkOnce = true
	mod.AddFunc(f)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitFuncValueShims(a, "main", mod)
	return a.Sections[0].Len
}

// A narrow (sub-word) GP register param must be re-extended in the func-value
// shim before the underlying native callee reads its full register — a foreign
// (LLVM) dispatch caller may leave the high bits dirty (abi/03 §3.3).  The
// re-extend is one extra instruction, so a narrow-param shim is strictly longer
// than the otherwise-identical word-size-param shim; if the fix regresses (the
// shim forwards the slot with a bare full-width move), the lengths match.  bool
// is included because it is the canonical 64-bit-TEST case yet SubWordNarrow
// reports it non-narrow — the shim keys off SizeOf so it is extended too.
func TestFuncValueShimReextendsNarrowRegParamAA64() testing.TestResult {
	var wide int = shimLenForParam1AA64(types.TypInt64())
	if shimLenForParam1AA64(types.TypInt8()) <= wide {
		return "int8 shim must re-extend the narrow reg param (longer than the int64 shim)"
	}
	if shimLenForParam1AA64(types.TypInt16()) <= wide {
		return "int16 shim must re-extend the narrow reg param (longer than the int64 shim)"
	}
	if shimLenForParam1AA64(types.TypBool()) <= wide {
		return "bool shim must re-extend the narrow reg param (longer than the int64 shim)"
	}
	return ""
}

// shimDataForParam1AA64 emits the single-param func-value shim and returns its
// exact bytes.
func shimDataForParam1AA64(pty @types.Type) @[]uint8 {
	var mod @ir.Module = ir.NewModule("\"main\"")
	var p @ir.Param = make(ir.Param)
	p.Name = "x"
	p.Typ = pty
	var params @[]@ir.Param
	params = appendIrParam_spilltest_aa64(params, p)
	var f @ir.Func = ir.NewFunc("", "f", params, scalarResult_spilltest_aa64())
	f.IsLinkOnce = true
	mod.AddFunc(f)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitFuncValueShims(a, "main", mod)
	var out @[]uint8 = make_slice(uint8, a.Sections[0].Len)
	for i := 0; i < a.Sections[0].Len; i++ { out[i] = a.Sections[0].Data[i] }
	return out
}

// bytesEqualAA64 reports whether two byte slices are identical.
func bytesEqualAA64(x @[]uint8, y @[]uint8) bool {
	if len(x) != len(y) { return false }
	for i := 0; i < len(x); i++ {
		if x[i] != y[i] { return false }
	}
	return true
}

// The re-extend must honor the param's SIGNEDNESS (Sxtb for int8 vs Uxtb for
// uint8), not use a fixed extend — else a signed narrow arg with the sign bit set
// reads a large positive value.  The two shims are otherwise identical, so their
// bytes differ iff the extend's signedness differs; a regression to a fixed extend
// makes them equal.
func TestFuncValueShimNarrowExtendHonorsSignAA64() testing.TestResult {
	var signed @[]uint8 = shimDataForParam1AA64(types.TypInt8())
	var unsigned @[]uint8 = shimDataForParam1AA64(types.TypUint8())
	if bytesEqualAA64(signed, unsigned) {
		return "int8 and uint8 shims must differ (Sxtb vs Uxtb) — extend must honor signedness"
	}
	return ""
}

// emitFuncValueShims on a module with no OP_FUNC_VALUE / OP_FUNC_HANDLE
// refs should be a no-op.  Pins the shim emitter so a regression that
// always-emits something gets caught.
func TestEmitFuncValueShimsEmptyNoOpAA64() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var mod @ir.Module = ir.NewModule("\"main\"")
	emitFuncValueShims(a, "main", mod)
	if a.Sections[0].Len != 0 {
		return "empty module should produce no shims"
	}
	return ""
}
