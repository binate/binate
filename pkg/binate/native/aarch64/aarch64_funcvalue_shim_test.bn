package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for aarch64_funcvalue_shim.bn: the per-shape shim-body emission.

// bytesEqualAA64 reports whether two byte slices are identical.
func bytesEqualAA64(x @[]uint8, y @[]uint8) bool {
	if len(x) != len(y) { return false }
	for i := 0; i < len(x); i++ {
		if x[i] != y[i] { return false }
	}
	return true
}

// emitFuncValueShims on a module with no OP_FUNC_VALUE / OP_FUNC_HANDLE
// refs should be a no-op.  Pins the shim emitter so a regression that
// always-emits something gets caught.
func TestEmitFuncValueShimsEmptyNoOpAA64() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var mod @ir.Module = ir.NewModule("\"main\"")
	emitFuncValueShims(a, "main", mod)
	if a.Sections[0].Len != 0 {
		return "empty module should produce no shims"
	}
	return ""
}

// spillShimDataAA64 emits the OVER-BUDGET (spill-path) func-value shim for a func
// value whose first param is firstTy and remaining 7 are int64 — 8 user words
// exceed the aa64 dispatch register budget (7), so emitSpillMarshalAA64 runs
// instead of the register-only fast path — and returns the shim's bytes.  The
// narrow first param is register-resident, so the spill path must re-extend it too.
func spillShimDataAA64(firstTy @types.Type) @[]uint8 {
	var mod @ir.Module = ir.NewModule("\"main\"")
	var params @[]@ir.Param
	var p0 @ir.Param = make(ir.Param)
	p0.Name = "x"
	p0.Typ = firstTy
	params = appendIrParam_spilltest_aa64(params, p0)
	for i := 0; i < 7; i++ {
		var p @ir.Param = make(ir.Param)
		p.Name = "y"
		p.Typ = types.TypInt64()
		params = appendIrParam_spilltest_aa64(params, p)
	}
	var f @ir.Func = ir.NewFunc("", "f", params, scalarResult_spilltest_aa64())
	f.IsLinkOnce = true
	mod.AddFunc(f)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitFuncValueShims(a, "main", mod)
	var out @[]uint8 = make_slice(uint8, a.Sections[0].Len)
	for i := 0; i < a.Sections[0].Len; i++ { out[i] = a.Sections[0].Data[i] }
	return out
}

// The SPILL-path shim (over-budget func value) must re-extend a register-resident
// narrow param too, not just the register-only fast path.  Same length + signedness
// guards as the register-only test, on the spill shim.
func TestFuncvalSpillShimReextendsNarrowRegParamAA64() testing.TestResult {
	var wide int = len(spillShimDataAA64(types.TypInt64()))
	if len(spillShimDataAA64(types.TypInt8())) <= wide {
		return "spill shim int8 first param must re-extend (longer than the int64-first spill shim)"
	}
	var signed @[]uint8 = spillShimDataAA64(types.TypInt8())
	var unsigned @[]uint8 = spillShimDataAA64(types.TypUint8())
	if bytesEqualAA64(signed, unsigned) {
		return "spill shim int8 vs uint8 must differ (Sxtb vs Uxtb) — extend must honor signedness"
	}
	return ""
}
