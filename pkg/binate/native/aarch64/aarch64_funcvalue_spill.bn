package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Genuine-overflow stack-spill path for the non-closure func-value shims
// (AArch64 / AAPCS64).  Reached from emitFuncValueShims when a func
// value's EFFECTIVE user-arg words exceed the register budget the tail-
// branch / register-only shapes can serve.  Mirrors
// emitClosureShimStackSpillAA64 (the capturing-closure analogue),
// specialized to the no-captures case plus the func-value return shapes
// (scalar/void, sret, pack, float-ret).
//
// The shim is entered under the uniform all-int dispatch ABI: dispatch
// word g (g=0 is the leading data slot, or retbuf+data for the aggregate
// shapes) is in argReg(g) if g < 8, else on the dispatch CALLER's stack
// at [sp_entry + (g-8)*8] (AAPCS64's BL pushes no return address).  The
// shim re-marshals the user words into the underlying's real AAPCS64
// layout — reg words shifted down by the dropped prefix, AAPCS SPLIT
// honored, overflow words written to a reserved outgoing-args area —
// then BLs (NOT tail-branches: LR must be preserved and the frame torn
// down before RET) and unwinds.
//
// Most args occupy as many dispatch words incoming as outgoing words the
// real ABI reads, so a single per-arg count drives both the incoming-source
// cursor and the outgoing placement.  A coerced in-register struct/array
// (AggCoercedInReg) breaks that symmetry: it arrives as ONE by-address
// dispatch word (EffectiveArgWords == 1) yet the real ABI reads its ArgWords
// value-words from that buffer — so the incoming cursor advances by 1 while
// the outgoing placement spans ArgWords reg/stack slots (see
// emitSpillCoercedAggAA64).
//
// Frame: STP FP,LR,[sp,#-16]! preserves LR across the BL and lays a frame
// record; the outgoing-args area (+ a retbuf save slot for pack) is
// carved below with a further SUB.  X16 (the AAPCS intra-call scratch) is
// the spill shuttle, and also parks a coerced aggregate's by-address pointer
// while its value-words are loaded.  Reg-shift clobber-safety matches the x64
// path: each shifted word moves down by a constant, so an outgoing reg is read
// as a source only at a strictly lower, already-consumed word index (left-to-
// right); a coerced aggregate sources its value-words from MEMORY via the
// X16-parked pointer, immune to the GP-reg shift.

// emitFuncvalSpillShimAA64 emits the over-budget func-value shim.  retSz is the
// single-result SizeOf (0 for void / multi-return).  At most one of usePack /
// useSret / usePackMulti / useSretMulti is set; isFloatRet / retIsHfa only with
// none of those.  Under retbuf-for-any-multi-return the dispatch caller passes
// the retbuf in X0 (data X1) for every multi-return: a BIG tuple (useSretMulti)
// takes the sret shape (retbuf X0 → X8, tail-branch, callee writes through X8); a
// SMALL tuple (usePackMulti) takes the pack shape (stash retbuf, BL, store the
// field-per-register result THROUGH the stashed retbuf).
func emitFuncvalSpillShimAA64(a @asm.Assembler, cc common.CallConv, fnLabel @[]char,
		fvTyp @types.Type, retSz int, usePack bool, useSret bool, isFloatRet bool, retIsHfa bool,
		usePackMulti bool, useSretMulti bool) {
	var userTypes @[]@types.Type = shimUserTypesAA64(fvTyp)
	// An HFA result rides D0..D3 but still travels to the shim's caller through
	// the retbuf (aggregate dispatch shape), so it uses the same retbuf frame /
	// prefix as a pack return; only the post-BL return handling differs (FMOV
	// the members into the retbuf instead of copying GP words).  A small multi-
	// return (usePackMulti) also stashes retbuf + stores through it post-BL, so
	// it shares the retbuf frame.  A big multi-return (useSretMulti) shares the
	// sret shape (retbuf → X8), so it folds into the useSret arm.
	var sretShape bool = useSret || useSretMulti
	var useRetbuf bool = usePack || retIsHfa || usePackMulti
	// Incoming prefix words to drop: 1 (data) for scalar/void/float, 2
	// (retbuf + data) for the aggregate / multi-return shapes.  The sret pointer
	// rides X8 (not a GP arg reg), so user args always start at X0 — no
	// gpDestBase, ccOut == cc.
	var srcPrefix int = 1
	if usePack || useSret || retIsHfa || usePackMulti || useSretMulti {
		srcPrefix = 2
	}
	var outBytes int = cc.CallStackBytes(userTypes)
	var retbufOff int = outBytes
	// Stage the incoming GP dispatch regs to the frame ONLY when a coerced
	// aggregate is present (mirrors the x64 twin and the register-only
	// emitShimArgMarshalAA64's needStage).  Such an arg makes the OUTGOING cursor
	// (ArgWords value-words) outrun the INCOMING by-address cursor (1 pointer), so
	// an outgoing reg write can land in a LATER param's not-yet-read incoming reg
	// — saving every incoming GP arg reg first, then marshalling from the frame,
	// removes it.  Without one, incoming and outgoing advance in lockstep (a
	// constant down-shift, the outgoing reg index never exceeding the incoming),
	// already clobber-safe, so the marshal reads live regs directly and the
	// staging area is dropped.  stageOff and NumGpArgRegs*8 (= 64) are both
	// multiples of 16, so innerBytes stays 16-aligned either way and SP stays
	// aligned.
	var needStage bool = shimHasCoercedAggAA64(userTypes)
	// Frame layout (low→high in the inner area): [0, outBytes) outgoing-args;
	// for pack a 16-byte retbuf save slot; then [stageOff, +NumGpArgRegs*8) the
	// clobber-safe staging area (present only when needStage).
	var stageOff int = outBytes
	if useRetbuf { stageOff = outBytes + 16 }
	var innerBytes int = stageOff
	if needStage { innerBytes = stageOff + cc.NumGpArgRegs * 8 }
	// frameDelta = the total sp decrement from shim entry (16 for the
	// FP/LR record + the inner area), used to address incoming caller-
	// stack words after the frame is set up.
	var frameDelta int = 16 + innerBytes

	aarch64.Stp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPre(aarch64.SP, -16))
	if innerBytes > 0 {
		aarch64.Sub(a, true, aarch64.SP, aarch64.SP, aarch64.Imm(innerBytes))
	}
	if needStage {
		// Stage every incoming GP dispatch reg before any outgoing write (the
		// marshal helpers then read register-source words from [sp + stageOff + 8*g]).
		for g := 0; g < cc.NumGpArgRegs; g++ {
			aarch64.Str(a, true, argReg(g), aarch64.MemImm(aarch64.SP, stageOff + 8 * g))
		}
	}
	if sretShape {
		// retbuf X0 → X8 (the AAPCS indirect-result reg) BEFORE the
		// marshal overwrites X0; survives the BL, so the underlying
		// writes the result straight through the caller's buffer.  Covers a
		// > 16-byte single aggregate (useSret) AND a big multi-return tuple
		// (useSretMulti) — both are AAPCS64 sret-via-X8.
		aarch64.Mov(a, true, aarch64.X8, aarch64.Reg(aarch64.X0))
	}
	if useRetbuf {
		// Stash retbuf (X0) above the outgoing-args area (pack / HFA / small-
		// multiret returns store through it post-BL).
		aarch64.Str(a, true, aarch64.X0, aarch64.MemImm(aarch64.SP, retbufOff))
	}
	emitSpillMarshalAA64(a, cc, userTypes, srcPrefix, frameDelta, stageOff, needStage)
	a.SetGlobal(fnLabel)
	aarch64.Bl(a, fnLabel)
	if retIsHfa {
		// The underlying returned the HFA members in D0..D(n-1); FMOV each into
		// the stashed retbuf (reloaded into X9, outside the return regs and the
		// X16 scratch hfaMemberStoreFromFp uses).
		aarch64.Ldr(a, true, aarch64.X9, aarch64.MemImm(aarch64.SP, retbufOff))
		hn, hw := types.HfaClassify(fvTyp.Results[0])
		for m := 0; m < hn; m++ {
			hfaMemberStoreFromFp(a, aarch64.D0 + m, aarch64.X9, m * hw, hw)
		}
	} else if usePack {
		// X0..X(retWords-1) hold the packed return; copy through the
		// stashed retbuf (reloaded into X9, outside the return regs).
		aarch64.Ldr(a, true, aarch64.X9, aarch64.MemImm(aarch64.SP, retbufOff))
		var retWords int = retSz / 8
		if retSz % 8 != 0 { retWords = retWords + 1 }
		for ri := 0; ri < retWords; ri++ {
			aarch64.Str(a, true, argReg(ri), aarch64.MemImm(aarch64.X9, 8 * ri))
		}
	} else if usePackMulti {
		// The callee returned the tuple FIELD-PER-REGISTER (X0../D0..); store it
		// through the stashed retbuf (reloaded into X9, outside the return regs).
		// X10 is the field float→GP scratch (outside the return regs and X9 base).
		aarch64.Ldr(a, true, aarch64.X9, aarch64.MemImm(aarch64.SP, retbufOff))
		storeMultiReturnTupleFieldsAA64(a, funcValMultiReturnTupleAA64(fvTyp), aarch64.X9, 0, aarch64.X10)
	} else if isFloatRet {
		// The underlying returns the float in d0/s0; the all-int dispatch
		// ABI expects the bits in x0/w0.
		if common.FloatScalarIsI32(fvTyp.Results[0]) {
			aarch64.Fmov_s_to_w(a, aarch64.X0, aarch64.D0)
		} else {
			aarch64.Fmov_fp_to_gp(a, aarch64.X0, aarch64.D0)
		}
	}
	if innerBytes > 0 {
		aarch64.Add(a, true, aarch64.SP, aarch64.SP, aarch64.Imm(innerBytes))
	}
	aarch64.Ldp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPost(aarch64.SP, 16))
	aarch64.Ret(a)
}

// shimUserTypesAA64 extracts the func-value's parameter types into a
// @[]@types.Type the CallConv classifier consumes.
func shimUserTypesAA64(fvTyp @types.Type) @[]@types.Type {
	var ts @[]@types.Type
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		ts = appendShimType(ts, fvTyp.Params[pi].Type)
	}
	return ts
}

// appendShimType appends a @types.Type to a @[]@types.Type.
func appendShimType(dst @[]@types.Type, v @types.Type) @[]@types.Type {
	var n int = len(dst)
	var ns @[]@types.Type = make_slice(@types.Type, n + 1)
	for i := 0; i < n; i++ { ns[i] = dst[i] }
	ns[n] = v
	return ns
}

// emitSpillMarshalAA64 moves the user args from their incoming all-int
// dispatch positions into the underlying's AAPCS64 layout.  Float scalars
// peel to d/s[nsrn]; a coerced in-register struct/array arrives as one
// by-address dispatch word and its ArgWords value-words are loaded from that
// buffer to the classifier's reg / stack slots (emitSpillCoercedAggAA64); every
// other arg's effective words shift directly to the classifier's reg / stack
// slots — all honoring AAPCS SPLIT (an aggregate may straddle the last GP regs
// and the stack).  inWord (the incoming-dispatch cursor) advances by the
// EFFECTIVE word count (1 for a by-address coerced aggregate), which diverges
// from the OUTGOING word count the classifier places.
func emitSpillMarshalAA64(a @asm.Assembler, cc common.CallConv, userTypes @[]@types.Type,
		srcPrefix int, frameDelta int, stageOff int, staged bool) {
	var nsrn int = 0
	var inWord int = 0
	for i := 0; i < len(userTypes); i++ {
		var pt @types.Type = userTypes[i]
		if common.IsFloatScalarTyp(pt) {
			if nsrn < cc.NumFpArgRegs {
				emitSpillSrcToFpAA64(a, cc, srcPrefix + inWord, frameDelta, stageOff, aarch64.D0 + nsrn,
						common.FloatScalarIsI32(pt), staged)
			} else {
				// FP arg registers exhausted: the float overflows to the
				// underlying's outgoing-args stack at its natural offset/width
				// (a float32 packs at 4 bytes on AAPCS64_Darwin).
				emitSpillSrcToMemAA64(a, cc, srcPrefix + inWord, frameDelta, stageOff,
						cc.CallArgStackOff(userTypes, i), cc.StackArgStoreSize(pt, false), staged)
			}
			nsrn = nsrn + 1
			inWord = inWord + 1
			continue
		}
		if isHfaAggregate(pt) {
			// HFA arg: like a coerced aggregate it arrives as ONE by-address
			// dispatch word (inWord += 1), but its members ride the FP file.
			// Park the buffer pointer in X9 (hfaMemberLoadToFp's X16 scratch
			// would clobber X16) and load member m into D[nsrn+m]; on FP-file
			// overflow the whole HFA spills to the outgoing-args stack (natural
			// packed layout).  It must precede the AggCoercedInReg branch (an HFA
			// is also AggCoercedInReg) and forces staging (shimHasCoercedAggAA64).
			hn, hw := types.HfaClassify(pt)
			emitSpillSrcToRegAA64(a, cc, srcPrefix + inWord, frameDelta, stageOff, aarch64.X9, staged)
			if nsrn + hn <= cc.NumFpArgRegs {
				for m := 0; m < hn; m++ {
					hfaMemberLoadToFp(a, aarch64.D0 + nsrn + m, aarch64.X9, m * hw, hw)
				}
				nsrn = nsrn + hn
			} else {
				var so int = cc.CallArgStackOff(userTypes, i)
				for m := 0; m < hn; m++ {
					aarch64.Ldr(a, hw == 8, aarch64.X16, aarch64.MemImm(aarch64.X9, m * hw))
					aarch64.StrSized(a, hw, aarch64.X16, aarch64.MemImm(aarch64.SP, so + m * hw))
				}
				nsrn = cc.NumFpArgRegs
			}
			inWord = inWord + 1
			continue
		}
		if common.AggCoercedInReg(pt) {
			// Coerced in-register struct/array: arrives as ONE by-address
			// dispatch word (EffectiveArgWords == 1, so inWord advances by 1),
			// but the underlying's real ABI reads its ArgWords value-words from
			// that buffer, spread across the classifier's reg/stack slots
			// (CallArgRegStart / CallArgStackOff, computed from raw ArgWords) —
			// possibly straddling the last GP regs and the outgoing-args stack.
			emitSpillCoercedAggAA64(a, cc, userTypes, i, srcPrefix + inWord, frameDelta, stageOff, staged)
			inWord = inWord + 1
			continue
		}
		var w int = cc.EffectiveArgWords(pt)
		var rs int = cc.CallArgRegStart(userTypes, i)
		var so int = cc.CallArgStackOff(userTypes, i)
		var regWords int = 0
		if rs >= 0 {
			if so >= 0 {
				regWords = cc.NumGpArgRegs - rs
			} else {
				regWords = w
			}
		}
		for k := 0; k < regWords; k++ {
			emitSpillSrcToRegAA64(a, cc, srcPrefix + inWord + k, frameDelta, stageOff, argReg(rs + k),
					staged)
		}
		for k := regWords; k < w; k++ {
			emitSpillSrcToMemAA64(a, cc, srcPrefix + inWord + k, frameDelta, stageOff,
					so + (k - regWords) * 8, cc.StackArgStoreSize(pt, false), staged)
		}
		inWord = inWord + w
	}
}

// shimHasCoercedAggAA64 reports whether any user param is a coerced in-register
// struct/array — the only arg shape whose incoming (by-address, 1 word) and
// outgoing (ArgWords value-words) cursors diverge, which is what forces the
// spill marshal to stage the incoming GP regs (see emitFuncvalSpillShimAA64).
func shimHasCoercedAggAA64(userTypes @[]@types.Type) bool {
	for i := 0; i < len(userTypes); i++ {
		if common.AggCoercedInReg(userTypes[i]) { return true }
	}
	return false
}

// emitSpillCoercedAggAA64 marshals one coerced in-register struct/array
// (AggCoercedInReg) that arrives as a SINGLE by-address dispatch word.  The
// dispatch word g (translated by emitSpillSrcToRegAA64: an arg reg if
// g < NumGpArgRegs, else the dispatch caller's stack at frameDelta) holds the
// pointer to the value buffer; the underlying's real ABI reads ArgWords value-
// words from that buffer.  The pointer is parked in X16 (the AAPCS intra-call
// scratch, not an arg/return reg) first, so the value-word loads can't clobber
// it; then each value-word is loaded from [X16, 8*k] and placed at its outgoing
// slot per the classifier (CallArgRegStart / CallArgStackOff): the first
// regWords go to GP arg regs argReg(rs..), any remainder (AAPCS SPLIT) goes to
// the outgoing-args stack at [sp + so + (k-regWords)*8].  A stack-destined word
// shuttles through X9 (outside the arg/return banks and distinct from the X16
// pointer) since memory→memory needs a GP temp; the OUTGOING store width is the
// arg's StackArgStoreSize (8 for an aggregate — it never narrows).
// (staged is always true when this runs — a coerced aggregate is exactly what
// makes shimHasCoercedAggAA64 / needStage true — but it is threaded through so
// emitSpillSrcToRegAA64 reads the pointer word from its staging slot.)
func emitSpillCoercedAggAA64(a @asm.Assembler, cc common.CallConv, userTypes @[]@types.Type, i int,
		g int, frameDelta int, stageOff int, staged bool) {
	var pt @types.Type = userTypes[i]
	var n int = common.ArgWords(pt)
	var rs int = cc.CallArgRegStart(userTypes, i)
	var so int = cc.CallArgStackOff(userTypes, i)
	var regWords int = 0
	if rs >= 0 {
		if so >= 0 {
			regWords = cc.NumGpArgRegs - rs
		} else {
			regWords = n
		}
	}
	emitSpillSrcToRegAA64(a, cc, g, frameDelta, stageOff, aarch64.X16, staged)
	for k := 0; k < regWords; k++ {
		aarch64.Ldr(a, true, argReg(rs + k), aarch64.MemImm(aarch64.X16, 8 * k))
	}
	for k := regWords; k < n; k++ {
		aarch64.Ldr(a, true, aarch64.X9, aarch64.MemImm(aarch64.X16, 8 * k))
		aarch64.StrSized(a, cc.StackArgStoreSize(pt, false), aarch64.X9,
				aarch64.MemImm(aarch64.SP, so + (k - regWords) * 8))
	}
}

// emitSpillSrcToRegAA64 moves incoming dispatch word g into dstReg.  A
// register-passed word (g < cc.NumGpArgRegs) is read from its staging slot
// [sp + stageOff + 8*g] when `staged`, else straight from the live argReg(g)
// (safe without staging: the outgoing reg index never exceeds the incoming, so
// the source is untouched at read time).  An overflow word is read from the
// dispatch caller's stack at [sp + frameDelta + (g - NumGpArgRegs)*8].
func emitSpillSrcToRegAA64(a @asm.Assembler, cc common.CallConv, g int, frameDelta int,
		stageOff int, dstReg int, staged bool) {
	if g < cc.NumGpArgRegs && !staged {
		if dstReg != argReg(g) {
			aarch64.Mov(a, true, dstReg, aarch64.Reg(argReg(g)))
		}
		return
	}
	var off int = frameDelta + (g - cc.NumGpArgRegs) * 8
	if g < cc.NumGpArgRegs {
		off = stageOff + 8 * g
	}
	aarch64.Ldr(a, true, dstReg, aarch64.MemImm(aarch64.SP, off))
}

// emitSpillSrcToMemAA64 moves incoming dispatch word g to the outgoing-
// args stack at [sp + dstOff].  A staged register word is read from its staging
// slot (see emitSpillSrcToRegAA64) via X16; an un-staged live register word
// stores directly; an overflow word shuttles through X16 from the caller stack.
// The un-staged register-source case is defensive and currently unreachable: a
// register source only reaches the outgoing STACK via a coerced-aggregate
// straddle, which forces needStage/staged true, so without staging the
// down-shift keeps every register source in a register.  Keep it — dropping it
// would make a future reg→stack word read the unpopulated staging slot.
// The incoming word is a full 8-byte dispatch slot, but the OUTGOING store is
// the arg's natural width storeSize (1/2/4 for an int8/int16/int32 or float32
// the lifted body reads at natural size, else 8) — an 8-byte store of a narrow
// arg would overrun its neighbor's slot.
func emitSpillSrcToMemAA64(a @asm.Assembler, cc common.CallConv, g int, frameDelta int,
		stageOff int, dstOff int, storeSize int, staged bool) {
	if g < cc.NumGpArgRegs && !staged {
		aarch64.StrSized(a, storeSize, argReg(g), aarch64.MemImm(aarch64.SP, dstOff))
		return
	}
	var off int = frameDelta + (g - cc.NumGpArgRegs) * 8
	if g < cc.NumGpArgRegs {
		off = stageOff + 8 * g
	}
	aarch64.Ldr(a, true, aarch64.X16, aarch64.MemImm(aarch64.SP, off))
	aarch64.StrSized(a, storeSize, aarch64.X16, aarch64.MemImm(aarch64.SP, dstOff))
}

// emitSpillSrcToFpAA64 moves incoming dispatch word g (float bits in a GP
// slot under the all-int dispatch ABI) into the FP register fpReg.  A staged /
// overflow word is loaded into X16 first (fmov takes a GP source); an un-staged
// live register word moves straight from argReg(g).
func emitSpillSrcToFpAA64(a @asm.Assembler, cc common.CallConv, g int, frameDelta int, stageOff int,
		fpReg int, isI32 bool, staged bool) {
	var srcReg int = aarch64.X16
	if g < cc.NumGpArgRegs && !staged {
		srcReg = argReg(g)
	} else {
		var off int = frameDelta + (g - cc.NumGpArgRegs) * 8
		if g < cc.NumGpArgRegs {
			off = stageOff + 8 * g
		}
		aarch64.Ldr(a, true, aarch64.X16, aarch64.MemImm(aarch64.SP, off))
	}
	if isI32 {
		aarch64.Fmov_w_to_s(a, fpReg, srcReg)
	} else {
		aarch64.Fmov_gp_to_fp(a, fpReg, srcReg)
	}
}
