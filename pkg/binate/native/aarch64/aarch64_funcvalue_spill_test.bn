package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for aarch64_funcvalue_spill.bn: a func value whose EFFECTIVE
// user-arg words exceed the register-only budget must route to the stack-
// spill shim and emit WITHOUT recording an assembler error.  Before
// Stage B the aa64 over-budget shapes silently clamped (miscompile) or —
// after the Stage A loud guard — SetError'd; the regression these pin is
// that emission now succeeds (emitted-byte correctness is covered end-to-
// end by conformance 697 / 698 across the native lanes).

// Scalar return, 8 int64 user words > the aa64 scalar budget (7): spills.
func TestFuncvalSpillWideScalarNoErrorAA64() testing.TestResult {
	return wideShimEmitsAA64(8, scalarResult_spilltest_aa64())
}

// Sret return (24-byte struct > 16) with 7 int64 user words > the aa64
// sret budget (6): spills, retbuf moved to X8 ahead of the frame.
func TestFuncvalSpillWideSretNoErrorAA64() testing.TestResult {
	return wideShimEmitsAA64(7, structResult_spilltest_aa64(3))
}

// Pack return (16-byte struct) with 7 int64 user words > the aa64 pack
// budget (6): spills, packed return copied through the stashed retbuf.
func TestFuncvalSpillWidePackNoErrorAA64() testing.TestResult {
	return wideShimEmitsAA64(7, structResult_spilltest_aa64(2))
}

// wideShimEmitsAA64 builds a single IsLinkOnce func with nParams int64
// params and the given result, runs the shim emitter, and asserts the
// over-budget func value emitted a non-empty shim without error.
func wideShimEmitsAA64(nParams int, result @[]@types.Type) testing.TestResult {
	var mod @ir.Module = ir.NewModule("\"main\"")
	var params @[]@ir.Param
	for i := 0; i < nParams; i++ {
		var p @ir.Param = make(ir.Param)
		p.Name = "x"
		p.Typ = types.TypInt64()
		params = appendIrParam_spilltest_aa64(params, p)
	}
	var f @ir.Func = ir.NewFunc("", "wide", params, result)
	f.IsLinkOnce = true
	mod.AddFunc(f)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitFuncValueShims(a, "main", mod)
	if a.HasError {
		return "over-budget func value must not SetError (spill path)"
	}
	if a.Sections[0].Len == 0 {
		return "over-budget func value must emit a shim"
	}
	return ""
}

// scalarResult_spilltest_aa64 builds the result list for an int64-
// returning func value (a single scalar result).
func scalarResult_spilltest_aa64() @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, 1)
	r[0] = types.TypInt64()
	return r
}

// structResult_spilltest_aa64 builds the result list for a func value
// returning an n-int64 struct (8*n bytes: n=2 → 16 B pack shape, n=3 →
// 24 B sret shape).
func structResult_spilltest_aa64(n int) @[]@types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		var fld @types.Field = make(types.Field)
		fld.Type = types.TypInt64()
		fields[i] = fld
	}
	var r @[]@types.Type = make_slice(@types.Type, 1)
	r[0] = types.MakeStructType("", fields)
	return r
}

// appendIrParam_spilltest_aa64 appends a @ir.Param to a @[]@ir.Param.
func appendIrParam_spilltest_aa64(dst @[]@ir.Param,
		v @ir.Param) @[]@ir.Param {
	var n int = len(dst)
	var ns @[]@ir.Param = make_slice(@ir.Param, n + 1)
	for i := 0; i < n; i++ { ns[i] = dst[i] }
	ns[n] = v
	return ns
}
