package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for funcValueDtorHandleSym (aarch64_funcvalue.bn): which symbol
// the function-value vtable's dtor slot (slot 0) points at.  For a capturing
// @func whose closure struct needs destruction it returns the closure-struct
// dtor's HANDLE symbol (and marks it global so its relocation resolves), so
// the @func variable's scope-end RefDec walks the vtable, runs the dtor, and
// releases each managed capture (conformance 550 read rt.Refcount 2 instead of
// 1 when this slot was left null).  Every other form returns an empty slice ->
// a null dtor slot.  (The slot's bytes are laid by ir.BuildFuncValue +
// common.EmitDataGlobal — covered by common_data_global_test.bn.)
//
// mkAsm comes from aarch64_emit_test.bn (same package); charEqAA64 /
// handleSymFor / funcValueDtorHandleSym from aarch64_funcvalue.bn.

// dtorSlotManagedClosure builds an @ir.Func standing in for a capturing
// `@func` literal: IsClosure (so lookupClosureFuncAA64 resolves it),
// IsManagedFuncValue (the heap-closure @func flavour), a closure struct
// with a managed field (so NeedsDestruction holds), and the unqualified
// dtor name gen_func_lit records in ClosureStructDtorName.
func dtorSlotManagedClosure() @ir.Func {
	var fld @types.Field = make(types.Field)
	fld.Name = "c"
	fld.Type = types.MakeManagedPtrType(types.TypInt())
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	fields[0] = fld
	var closureStruct @types.Type = types.MakeStructType("__closure_x", fields)

	var f @ir.Func = make(ir.Func)
	f.Name = "main.__funclit_0"
	f.IsClosure = true
	f.IsManagedFuncValue = true
	f.NumCaptureParams = 1
	f.ClosureStruct = closureStruct
	f.ClosureStructDtorName = "__dtor___closure_x"
	return f
}

// A capturing @func whose closure struct needs destruction: the dtor slot
// resolves to the closure-struct dtor's HANDLE — exactly the `___handle.<dtor>`
// symbol the IsLinkOnce pre-pass emits — and that symbol is marked global so
// the relocation resolves.
func TestFuncValueDtorSlotCapturingManagedEmitsHandle() testing.TestResult {
	var f @ir.Func = dtorSlotManagedClosure()
	var mod @ir.Module = ir.NewModule("main")
	mod.AddFunc(f)
	var a @asm.Assembler = mkAsm()
	var got @[]char = funcValueDtorHandleSym(a, "main", mod, "main.__funclit_0")
	var want @[]char = handleSymFor("main", "__dtor___closure_x")
	if !charEqAA64(got, want) {
		return "capturing managed closure dtor slot must be the closure-struct "
				"dtor handle (___handle.<dtor>)"
	}
	var si int = a.LookupSymbol(want)
	if si < 0 || a.Symbols[si].Binding != asm.BIND_GLOBAL {
		return "the dtor handle must be marked global so its relocation resolves"
	}
	return ""
}

// A non-closure reference (e.g. a plain *func of a top-level function):
// lookupClosureFuncAA64 returns nil, so the slot stays null (empty sym).
func TestFuncValueDtorSlotNonClosureEmitsZero() testing.TestResult {
	var f @ir.Func = make(ir.Func)
	f.Name = "main.Plain"
	f.IsClosure = false
	var mod @ir.Module = ir.NewModule("main")
	mod.AddFunc(f)
	var a @asm.Assembler = mkAsm()
	var got @[]char = funcValueDtorHandleSym(a, "main", mod, "main.Plain")
	if len(got) != 0 {
		return "non-closure dtor slot must be null (empty sym)"
	}
	return ""
}

// A capturing *func (raw, non-managed) closure also takes the null path:
// only the @func flavour owns the heap closure struct through its data
// slot and releases it via the vtable dtor.  A *func's stack-allocated
// closure is destructed at frame end via emitDecForManagedLocals, so its
// vtable dtor slot must stay null (a non-null one would double-free).
func TestFuncValueDtorSlotRawFuncCaptureEmitsZero() testing.TestResult {
	var f @ir.Func = dtorSlotManagedClosure()
	f.IsManagedFuncValue = false
	var mod @ir.Module = ir.NewModule("main")
	mod.AddFunc(f)
	var a @asm.Assembler = mkAsm()
	var got @[]char = funcValueDtorHandleSym(a, "main", mod, "main.__funclit_0")
	if len(got) != 0 {
		return "*func capture dtor slot must be null (vtable dtor is "
				"only for the @func heap-closure flavour)"
	}
	return ""
}

// A capturing @func whose closure struct has NO managed fields needs no
// dtor: NeedsDestruction is false, so the slot stays null even though
// the func is a managed closure.  Guards against emitting a dangling
// handle for a closure whose dtor the IsLinkOnce pre-pass never created.
func TestFuncValueDtorSlotManagedNoDestructEmitsZero() testing.TestResult {
	var f @ir.Func = dtorSlotManagedClosure()
	var emptyFields @[]@types.Field
	f.ClosureStruct = types.MakeStructType("__closure_y", emptyFields)
	var mod @ir.Module = ir.NewModule("main")
	mod.AddFunc(f)
	var a @asm.Assembler = mkAsm()
	var got @[]char = funcValueDtorHandleSym(a, "main", mod, "main.__funclit_0")
	if len(got) != 0 {
		return "managed closure with no managed captures needs no dtor; "
				"slot must be null"
	}
	return ""
}

// lookupFuncValueTypeAA64 must SYNTHESIZE a sig for IsExtern entries (cross-
// package handle targets, e.g. a managed type's dtor whose interface-only
// defining package emits no triple).  An OP_FUNC_HANDLE to such a target needs
// a WEAK (shim, vt, handle) triple emitted by the consumer; returning nil — the
// old skip — left ___handle.<dtor> undefined at link for reflect.FunctionInfo.
// x64 parity: x64_funcvalue_test.bn TestLookupFuncValueTypeSynthesizesExtern.
func TestLookupFuncValueTypeSynthesizesExternAA64() testing.TestResult {
	var mod @ir.Module = ir.NewModule("\"main\"")
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var ef @ir.Func = ir.NewExternFunc("", "ext_dtor", noP, noR)
	mod.AddFunc(ef)
	var sigTyp @types.Type = lookupFuncValueTypeAA64(mod, ef.Name)
	if sigTyp == nil {
		return "lookup must synthesize a sig for an extern handle target"
	}
	return ""
}
