package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the value-operand global-ref materialization
// (emitValOperand in aarch64_regmap.bn): taking a top-level global's
// address as an rvalue (`&G`) in a value-operand position — store
// value, call argument, return value, comparison operand — must emit an
// ADRP+ADD that puts the runtime address in a register, not resolve the
// IsGlobalRef pseudo (ID -1) through getOperand (which misses and drops
// the operand).  Conformance 551 / 573 cover the routed sites
// end-to-end; these pin the emit shape directly.
//
// mkAsm / bytesWritten come from aarch64_emit_test.bn (same package).

// emitStore whose VALUE operand is a package global's address (`&G`,
// the IsGlobalRef pseudo: ID -1, no spill/alloc slot) must materialize
// that address via ADRP+ADD before the STR — the value-operand analogue
// of the address-side global handling.  Pre-fix the value resolved
// through getOperand(ID -1) -> -1, so `if valReg < 0 { return }` dropped
// the store entirely (`&G` never written; conformance 551 on
// native_aa64).  Shape for `var p *int = &G` (store into p's alloca):
//   ADRP valTmp, _bn_G1_4_main1_1_G
//   ADD  valTmp, valTmp, #lo12   ; emitGlobalAddr -> &G
//   STR  valTmp, [SP, #pOff]
// Three 4-byte AArch64 instructions = 12 bytes; 0 means the global-ref
// value was dropped instead of materialized.
func TestEmitStoreGlobalRefValueMaterializesAddr() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	// Store target: p's alloca (ID 7) at offset 16.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 7)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)

	var dst @ir.Instr = make(ir.Instr)
	dst.ID = 7

	// Value: &G — IsGlobalRef pseudo, ID -1, no register.
	var val @ir.Instr = make(ir.Instr)
	val.ID = -1
	val.IsGlobalRef = true
	val.StrVal = "G"
	val.Typ = types.MakePointerType(types.TypInt())

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = iropcode.OP_STORE
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = dst
	ins.Args[1] = val

	emitStore(a, "main", rm, ins)
	if bytesWritten(a) != 12 {
		return "emitStore of a global-ref value should emit ADRP+ADD+STR "
			"(12 bytes); 0 means the &G value was dropped, not materialized"
	}
	return ""
}

// emitValOperand defers to getOperand for an ordinary instruction (a
// value already live in / reloadable to a register) and emits nothing
// extra; only the IsGlobalRef pseudo triggers ADRP+ADD materialization.
// Pin both arms: a spilled value reloads to a register with one LDR (4
// bytes), a global-ref value materializes with ADRP+ADD (8 bytes).
func TestEmitValOperandGlobalVsOrdinary() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)

	var ord @ir.Instr = make(ir.Instr)
	ord.ID = 5
	if emitValOperand(a, "main", rm, ord) < 0 {
		return "emitValOperand should reload a spilled ordinary value"
	}
	if bytesWritten(a) != 4 {
		return "ordinary value should reload with one LDR (4 bytes)"
	}

	var b @asm.Assembler = mkAsm()
	var rm2 @common.RegMap = common.NewRegMap(common.AAPCS64())
	var g @ir.Instr = make(ir.Instr)
	g.ID = -1
	g.IsGlobalRef = true
	g.StrVal = "G"
	if emitValOperand(b, "main", rm2, g) < 0 {
		return "emitValOperand should materialize a global-ref address"
	}
	if bytesWritten(b) != 8 {
		return "global-ref value should materialize with ADRP+ADD (8 bytes)"
	}
	return ""
}

// OP_BIT_CAST whose source is a global's address (`bit_cast(int, &G)`)
// is a value-operand position the dispatcher routes through
// emitValOperand: the source must be materialized (ADRP+ADD) before the
// reinterpret MOV.  Pre-fix the IsGlobalRef source resolved through
// getOperand(ID -1) -> -1 and the cast moved garbage.  Shape: ADRP + ADD
// (materialize &G) + MOV (bit_cast) = 12 bytes; fewer means the source
// was not materialized.
func TestEmitBitCastGlobalRefSourceMaterializes() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	var noStrings @[]ir.StringConst

	var src @ir.Instr = make(ir.Instr)
	src.ID = -1
	src.IsGlobalRef = true
	src.StrVal = "G"

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 4
	ins.Op = iropcode.OP_BIT_CAST
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src

	emitInstr(a, "main", "fn", rm, noStrings, nilFuncs(), ins)
	if bytesWritten(a) != 12 {
		return "bit_cast of a global-ref source should emit ADRP+ADD+MOV "
			"(12 bytes); fewer means the source was not materialized"
	}
	return ""
}

// A bit_cast to a SUB-WORD integer re-narrows the reinterpret MOV to the
// target's value range: `bit_cast(uint8, v)` used DIRECTLY must hold its
// 0..255 range, not leak the source's high bits.  emitSubWordNarrow emits a
// UXTB (UBFM) here — pin it (the native half of the bit_cast sub-word leak,
// conformance spec/15-builtins/040).
func TestEmitBitCastSubWordNarrows() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var noStrings @[]ir.StringConst

	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypInt32()

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_BIT_CAST
	ins.TypeArg = types.TypUint8()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src

	emitInstr(a, "main", "fn", rm, noStrings, nilFuncs(), ins)
	if !hasUbfmWord(a) {
		return "bit_cast to uint8 should re-narrow with a UXTB (UBFM)"
	}
	return ""
}

// Control: a bit_cast to a host-word type (int64) needs no narrow — the
// UXTB stays gated on sub-word targets, so a host-word reinterpret is a
// bare MOV.
func TestEmitBitCastHostWordNoNarrow() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var noStrings @[]ir.StringConst

	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypInt64()

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_BIT_CAST
	ins.TypeArg = types.TypInt64()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src

	emitInstr(a, "main", "fn", rm, noStrings, nilFuncs(), ins)
	if hasUbfmWord(a) {
		return "bit_cast to int64 should not emit a UBFM narrow"
	}
	return ""
}

// OP_CAST whose source is a global's address (`cast(int, &G)`) is the
// value-preserving sibling of bit_cast: the dispatcher must route the
// source through emitValOperand so it is materialized (ADRP+ADD) before
// the conversion.  Pre-fix the OP_CAST arm used a bare getOperand(ID -1)
// -> -1, so `if src < 0 { return }` emitted NOTHING (`cast(int, &G)`
// round-trip read the unchanged global; conformance 669 on native_aa64).
// Shape for a ptr->int cast: ADRP + ADD (materialize &G) + MOV (the
// same-width conversion) = 12 bytes; 0 means the source was dropped.
func TestEmitCastGlobalRefSourceMaterializes() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	var noStrings @[]ir.StringConst

	var src @ir.Instr = make(ir.Instr)
	src.ID = -1
	src.IsGlobalRef = true
	src.StrVal = "G"
	src.Typ = types.MakePointerType(types.TypInt())

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 4
	ins.Op = iropcode.OP_CAST
	ins.TypeArg = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src

	emitInstr(a, "main", "fn", rm, noStrings, nilFuncs(), ins)
	if bytesWritten(a) != 12 {
		return "cast of a global-ref source should emit ADRP+ADD+MOV "
			"(12 bytes); 0 means the source was dropped, not materialized"
	}
	return ""
}
