package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Runtime guard lowerings (bounds / divide / shift checks)
// ============================================================
//
// Dispatched from emitInstr (aarch64_dispatch.bn).  Bounds is lowered INLINE
// (compare + branch, cold fail-only call); divide/shift lower to a direct rt.*
// call (their guards are cheaper than the marshaling saved, and they aren't
// per-array-access hot spots).  Mirrors the x64 split (x64_guards.bn).

// emitBoundsCheck lowers OP_BOUNDS_CHECK inline instead of calling
// rt.BoundsCheck: the in-bounds path is ONE compare + a not-taken branch (no
// cross-TU call round-trip), and only the cold fail path calls the noreturn
// rt.BoundsFail(idx, len) — the same abort sink rt.BoundsCheck uses, so the
// diagnostic is byte-identical.
//
// SINGLE UNSIGNED compare: `idx < 0 || idx >= len` is exactly the unsigned test
// `(u64)idx >= (u64)len` — a negative idx is a huge unsigned that is >= len, and
// idx >= len is direct. Sound because EVERY OP_BOUNDS_CHECK length operand is
// non-negative: element/array checks pass the collection length (>= 0); a slice
// s[lo:hi] passes len+1 for the hi check (>= 1) and hi+1 for the lo check, where
// hi+1 >= 1 holds because gen_slice emits the hi check first and it aborts when
// hi < 0 (gen_slice.bn — the hi-before-lo ordering is load-bearing for this
// form). A future OP_BOUNDS_CHECK site that could pass a negative length would
// need the two-compare form. AArch64 only — x64/arm32 keep the two-compare form.
//
// Labels come from the per-function RegMap.BoundsSeq (the void op's Instr.ID
// is -1).  See emit_bounds.bn (LLVM twin) and plan-inline-bounds-check.md.
func emitBoundsCheck(a @asm.Assembler, funcSym @[]char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	var idx int = getOperand(a, rm, ins.Args[0].ID)
	var ln int = getOperand(a, rm, ins.Args[1].ID)
	if idx < 0 || ln < 0 { return }
	var seq int = rm.BoundsSeq
	rm.BoundsSeq = rm.BoundsSeq + 1
	var okLbl @[]char = common.BoundsLabel(funcSym, seq, false)
	aarch64.Cmp(a, true, idx, aarch64.Reg(ln))
	aarch64.Bcond(a, aarch64.COND_LO, okLbl) // (unsigned) idx < len → in bounds
	// fail (cold): fall-through when idx is out of range; the branch above jumps
	// over this block, so it needs no label of its own.
	aarch64.Mov(a, true, aarch64.X0, aarch64.Reg(idx))
	aarch64.Mov(a, true, aarch64.X1, aarch64.Reg(ln))
	var callee @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "BoundsFail"))
	a.SetGlobal(callee)
	aarch64.Bl(a, callee)
	a.DefineLabel(okLbl)
}

// emitDivCheck lowers OP_DIV_CHECK to `rt.DivCheck(dividend, divisor,
// signedMin, isSigned)`.  Operands are already 64-bit (IR-gen extends them);
// signedMin → X2 from the carried width, isSigned → X3 from BoolVal.
func emitDivCheck(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	var dividend int = getOperand(a, rm, ins.Args[0].ID)
	var divisor int = getOperand(a, rm, ins.Args[1].ID)
	if dividend < 0 || divisor < 0 { return }
	aarch64.Mov(a, true, aarch64.X0, aarch64.Reg(dividend))
	aarch64.Mov(a, true, aarch64.X1, aarch64.Reg(divisor))
	emitConstInt64(a, aarch64.X2, types.SignedMinForWidth(cast(int, ins.IntVal)))
	var dcSigned int = 0
	if ins.BoolVal { dcSigned = 1 }
	emitConstInt64(a, aarch64.X3, cast(int64, dcSigned))
	var dcCallee @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "DivCheck"))
	a.SetGlobal(dcCallee)
	aarch64.Bl(a, dcCallee)
	rm.ResetRegs()
}

// emitShiftCheck lowers OP_SHIFT_CHECK to rt.ShiftCheck(count): panic if the
// count is negative.  count is already 64-bit (IR-gen sign-extends it) → X0.
func emitShiftCheck(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var scCount int = getOperand(a, rm, ins.Args[0].ID)
	if scCount < 0 { return }
	aarch64.Mov(a, true, aarch64.X0, aarch64.Reg(scCount))
	var scCallee @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "ShiftCheck"))
	a.SetGlobal(scCallee)
	aarch64.Bl(a, scCallee)
	rm.ResetRegs()
}
