package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/builtins/testing"

// emitInstr's OP_BOUNDS_CHECK arm lowers INLINE: the in-bounds path is a
// compare + branch, and only the cold fail path calls the noreturn
// rt.BoundsFail (NOT rt.BoundsCheck).  Pin: BoundsFail is registered global
// (so the cold BL links) and BoundsCheck is NOT (no longer called).  A second
// check in the same function must get a DISTINCT label — the void op's
// Instr.ID is -1 for both, so labels come from RegMap.BoundsSeq; a duplicate
// label would set a.HasError.
func TestEmitBoundsCheckInline() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	// Spill slots for the two operand IDs (idx=5, len=6).
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 6)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	var idxArg @ir.Instr = make(ir.Instr)
	idxArg.ID = 5
	var lenArg @ir.Instr = make(ir.Instr)
	lenArg.ID = 6
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_BOUNDS_CHECK
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = idxArg
	ins.Args[1] = lenArg
	var noStrings @[]ir.StringConst
	emitInstr(a, "main", "fn", rm, noStrings, ins)
	// Single unsigned-compare form: 2x LDR (reload the spilled idx/len) + CMP +
	// B.LO + 2x MOV (X0/X1) + BL = 7 insns = 28 bytes. The two-signed-compare
	// form would be 36; this pins the single-compare so a regression is loud.
	if bytesWritten(a) != 28 {
		return "OP_BOUNDS_CHECK should emit the single-unsigned-compare form (7 insns, 28 bytes)"
	}
	var symIdx int = a.LookupSymbol("_bn_F3_3_pkg8_builtins2_rt1_10_BoundsFail")
	if symIdx < 0 {
		return "OP_BOUNDS_CHECK fail path should register _bn_...BoundsFail as global"
	}
	if a.Symbols[symIdx].Binding != asm.BIND_GLOBAL {
		return "_bn_...BoundsFail must be marked BIND_GLOBAL for linkage"
	}
	if a.LookupSymbol("_bn_F3_3_pkg8_builtins2_rt1_11_BoundsCheck") >= 0 {
		return "OP_BOUNDS_CHECK should NOT call rt.BoundsCheck (now inlined)"
	}
	// Second check, same function, same (void, ID=-1) op: labels must not
	// collide.  With ins.ID keying they would both be Lfn__bc-1{f,o}.
	emitInstr(a, "main", "fn", rm, noStrings, ins)
	if a.HasError {
		return "two bounds checks must get distinct labels (RegMap.BoundsSeq); duplicate-label error"
	}
	return ""
}

// OP_SHIFT_CHECK lowers to a CALL of the runtime negative-shift-count guard,
// marshalling the (64-bit) count into X0.
func TestEmitShiftCheckCallsRuntime() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	// Spill slot for the count operand ID (5).
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var cntArg @ir.Instr = make(ir.Instr)
	cntArg.ID = 5
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_SHIFT_CHECK
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = cntArg
	var noStrings @[]ir.StringConst
	emitInstr(a, "main", "fn", rm, noStrings, ins)
	// 1× LDR (count) + 1× MOV (X0) + BL = 3 insns = 12 bytes.
	if bytesWritten(a) != 12 {
		return "OP_SHIFT_CHECK should emit 3 insns (12 bytes)"
	}
	var symIdx int = a.LookupSymbol("_bn_F3_3_pkg8_builtins2_rt1_10_ShiftCheck")
	if symIdx < 0 {
		return "OP_SHIFT_CHECK should register _bn_F3_3_pkg8_builtins2_rt1_10_ShiftCheck"
	}
	if a.Symbols[symIdx].Binding != asm.BIND_GLOBAL {
		return "_bn_F3_3_pkg8_builtins2_rt1_10_ShiftCheck must be marked BIND_GLOBAL for linkage"
	}
	return ""
}
