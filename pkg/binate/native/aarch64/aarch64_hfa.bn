package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/types"

// HFA (Homogeneous Floating-point Aggregate) SIMD-register marshalling for
// AArch64.  An HFA — a struct/array folding to 1-4 same-width float members —
// travels in consecutive SIMD registers (v0..v3, i.e. D0..D3 in the disjoint FP
// namespace) under AAPCS64, not as a GP aggregate.  Because the assembler has no
// FP load/store (see asm/aarch64/aarch64_fp.bn — floats round-trip through a GP
// register via LDR/STR-X + FMOV), each member is moved memory<->FP through the
// X16 scratch.  Members are contiguous at memOfs = m * memW (all same-width
// floats pack with no padding), so the callers iterate m and pass m*memW.
//
// memW is the member byte width (4 = float32 → S register / 32-bit access, 8 =
// float64 → D register / 64-bit access), from types.HfaClassify.  These are only
// reached when cc.HfaAggregates (= types.HfaInSimd()) is on, so they are dormant
// until the cross-backend HFA gate flips.

// isHfaAggregate reports whether t is an HFA aggregate passed/returned in SIMD
// registers for the current target — a named struct/array folding to 1-4
// same-width float members, when types.HfaInSimd() is on.  The
// AggInRegCoercedKind guard excludes a bare float scalar (which folds as a
// 1-member HFA but is handled by the scalar-float path) and the anonymous
// multi-return tuple; it is the same set as types.hfaSimdAggregate and
// common.ReturnsHfaInRegs.  Used by the shim classifiers that lack a CallConv
// (closureHasFloatParts) to decide FP-vs-GP marshalling.
func isHfaAggregate(t @types.Type) bool {
	return types.HfaInSimd() && types.AggInRegCoercedKind(t) &&
		types.HfaMemberCount(t) > 0
}

// hfaMemberLoadToFp loads an HFA member of byte width memW from [base + memOfs]
// into FP register fpReg, through the X16 scratch (32-bit LDR + Fmov_w_to_s for
// float32 so no high GP bits reach the S register; 64-bit LDR + Fmov_gp_to_fp
// for float64).
func hfaMemberLoadToFp(a @asm.Assembler, fpReg int, base int, memOfs int, memW int) {
	if memW == 4 {
		aarch64.Ldr(a, false, aarch64.X16, aarch64.MemImm(base, memOfs))
		aarch64.Fmov_w_to_s(a, fpReg, aarch64.X16)
	} else {
		aarch64.Ldr(a, true, aarch64.X16, aarch64.MemImm(base, memOfs))
		aarch64.Fmov_gp_to_fp(a, fpReg, aarch64.X16)
	}
}

// hfaMemberStoreFromFp stores FP register fpReg (an HFA member of byte width
// memW) to [base + memOfs], through the X16 scratch (Fmov to a GP reg then a
// width-matched STR — the asm has no FP store).  The 32-bit form writes only 4
// bytes, so a float32 member never clobbers its neighbor in the packed layout.
func hfaMemberStoreFromFp(a @asm.Assembler, fpReg int, base int, memOfs int, memW int) {
	if memW == 4 {
		aarch64.Fmov_s_to_w(a, aarch64.X16, fpReg)
		aarch64.Str(a, false, aarch64.X16, aarch64.MemImm(base, memOfs))
	} else {
		aarch64.Fmov_fp_to_gp(a, aarch64.X16, fpReg)
		aarch64.Str(a, true, aarch64.X16, aarch64.MemImm(base, memOfs))
	}
}
