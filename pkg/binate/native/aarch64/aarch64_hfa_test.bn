package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/builtins/testing"

// hfaMemberLoadToFp / hfaMemberStoreFromFp each emit exactly two instructions —
// the assembler has no FP load/store, so an HFA member round-trips through a GP
// scratch (LDR/STR-X + FMOV).  Runtime correctness (the members land in the
// right D registers and offsets) is covered end-to-end by the native HFA
// conformance path; these pin the two-instruction shape for both member widths.

func TestHfaMemberLoadEmitsPair() testing.TestResult {
	var a64 @asm.Assembler = opsMkAssembler()
	hfaMemberLoadToFp(a64, aarch64.D0, aarch64.X0, 0, 8) // f64: LDR X16 + FMOV D0,X16
	if opsBytes(a64) != 8 {
		return "f64 HFA member load should emit 2 instructions (8 bytes)"
	}
	var a32 @asm.Assembler = opsMkAssembler()
	hfaMemberLoadToFp(a32, aarch64.D1, aarch64.X0, 4, 4) // f32: LDR(32) X16 + FMOV S1,X16
	if opsBytes(a32) != 8 {
		return "f32 HFA member load should emit 2 instructions (8 bytes)"
	}
	return ""
}

func TestHfaMemberStoreEmitsPair() testing.TestResult {
	var a64 @asm.Assembler = opsMkAssembler()
	hfaMemberStoreFromFp(a64, aarch64.D0, aarch64.X0, 0, 8) // f64: FMOV X16,D0 + STR X16
	if opsBytes(a64) != 8 {
		return "f64 HFA member store should emit 2 instructions (8 bytes)"
	}
	var a32 @asm.Assembler = opsMkAssembler()
	hfaMemberStoreFromFp(a32, aarch64.D2, aarch64.X0, 8, 4) // f32: FMOV W16,S2 + STR(32) X16
	if opsBytes(a32) != 8 {
		return "f32 HFA member store should emit 2 instructions (8 bytes)"
	}
	return ""
}
