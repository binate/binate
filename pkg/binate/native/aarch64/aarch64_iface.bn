package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/stdx/slices"

// ============================================================
// Interface dispatch — emitCallIfaceMethod, emitImplVtables
//
// Mirrors the LLVM lowering in pkg/binate/codegen/emit_impls.bn: each
// `impl T : I` declaration produces one `__ivt.bn_V...`
// global containing [dtor, *TypeInfo, m1, m2, ...] pointers, where every
// method slot holds the method's function-value HANDLE (@__handle.<m>, like
// slot 0's dtor); an `OP_IFACE_VALUE` site packs {data, vtable_global_addr}
// into a 16-byte aggregate; `OP_CALL_IFACE_METHOD` loads vtable[Index] (Index
// is the ABSOLUTE vtable slot, already past the two-word any-block — dtor +
// *TypeInfo) as a handle and dispatches THROUGH its marshaling shim, with the
// iv's data ptr (iv[0]) as the receiver; `OP_IFACE_DTOR` loads vtable[0] for
// the @Iface scope-exit cleanup path.
// ============================================================

// emitCallIfaceMethod lowers OP_CALL_IFACE_METHOD.  Args[0] is the iv value (a
// 16-byte {data, vtable} aggregate held at the alloc region pointed to by
// getOperand); Args[1..] are user args; Index is the ABSOLUTE vtable slot (slots
// 0-1 = any-block: dtor, *TypeInfo; first method = slot 2; an extended interface's
// inherited methods land at nested absolute offsets) — dispatched raw as `8 *
// Index`, no +2 (findInterfaceMethodFromBase already added it).
//
// Every @__ivt method slot holds the method's function-value HANDLE
// (@__handle.<m>, emitOneImplVtable useHandles=true) — the same convention slot 0
// (the dtor) already uses — so dispatch goes THROUGH the handle's marshaling shim
// exactly like OP_CALL_FUNC_VALUE.  That is what lets a native-emitted iface
// dispatch reach an impl whose @__ivt was emitted by ANOTHER backend (the
// hybrid native-main / LLVM-dep build): both sides agree on the handle+shim
// contract.  Mirrors emitCallFuncValue, but (a) the handle is LOADED from the
// vtable slot at iv.vtable + 8*Index instead of being the func-value's own
// address, and (b) the RECEIVER (iv[0]) is prepended as the shim's first arg
// after the handle's data.  See emit_iface_call.bn:emitCallIfaceMethod (the LLVM
// reference).
func emitCallIfaceMethod(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		allFuncs @[]@ir.Func, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }

	// Load the method HANDLE from the vtable slot, then extract its marshaling shim
	// into X17 (the BLR target), holding the handle pointer in X16:
	//   X16 = iv.vtable          (LDR X16, [ivAddr + IfaceValueVtableOffset()])
	//   X16 = vt[Index]          (LDR X16, [X16 + 8*Index])   ; the @__handle ptr
	//   X17 = handle.vtable      (LDR X17, [X16 + FuncValueVtableOffset()])
	//   X17 = handle.vtable.call (LDR X17, [X17 + 8])          ; the shim
	// X16 (IP0) and X17 (IP1) survive the arg loop: emitShimUserArgsAA64's per-arg
	// ResetRegs keeps the scratch pool below index 7, so neither is handed out from
	// the pool, and the loop never touches X16/X17 directly (see aarch64_regmap.bn's
	// X16/X17 direct-use discipline).
	var ivAddr int = getOperand(a, rm, ins.Args[0].ID)
	if ivAddr < 0 { return }
	aarch64.Ldr(a, true, aarch64.X16, aarch64.MemImm(ivAddr, types.IfaceValueVtableOffset()))
	aarch64.Ldr(a, true, aarch64.X16, aarch64.MemImm(aarch64.X16, 8 * ins.Index))
	aarch64.Ldr(a, true, aarch64.X17, aarch64.MemImm(aarch64.X16, types.FuncValueVtableOffset()))
	aarch64.Ldr(a, true, aarch64.X17, aarch64.MemImm(aarch64.X17, 8))

	// Shim shape (mirrors emitCallFuncValue) with one EXTRA prefix slot for the
	// receiver: an iface method's func-value type is `(receiver, args)`, so its
	// shim is `<ret>(data, receiver, args)` (scalar/void) or
	// `void(retbuf, data, receiver, args)` (aggregate/multi return).  So the prefix
	// is [data, receiver] (prefixSlots 2) or [retbuf, data, receiver] (prefixSlots
	// 3), and user args start one slot later than the func-value path.  The
	// retbuf-vs-scalar decision uses the same single-source-of-truth predicates as
	// the shim (emitted over the method's func-value type) so caller and shim agree.
	var aggregateRet bool = ins.ID >= 0 && types.IsAggregateReturnTyp(ins.Typ) &&
			!common.IsMultiReturnCall(ins)
	var multiRet bool = ins.ID >= 0 && common.IsMultiReturnCall(ins)
	var useRetbuf bool = aggregateRet || multiRet
	var prefixSlots int = 2
	if useRetbuf { prefixSlots = 3 }

	// Marshal user args into their shim-ABI slots (shared helpers, so the func-value
	// and iface layouts can't drift), before the prefix loads so a user arg sourced
	// from a prefix register was read first.
	var nCallArgs int = len(ins.Args) - 1
	var argTypes @[]@types.Type = shimArgTypesAA64(rm.CC, ins, nCallArgs, prefixSlots)
	emitShimUserArgsAA64(a, pkgName, rm, ins, argTypes, prefixSlots, nCallArgs)

	// If the arg loop ran, its per-arg ResetRegs reallocated the pool reg holding
	// ivAddr for an arg's scratch, clobbering it.  Reload before reading the
	// receiver (iv[0]).  (X16 = handle ptr and X17 = shim are unaffected — not pool
	// regs.)
	if nCallArgs > 0 {
		ivAddr = getOperand(a, rm, ins.Args[0].ID)
		if ivAddr < 0 { return }
	}

	// Load the shim's prefix registers: retbuf (aggregate/multi) into X0, then
	// data = handle.data (from X16) and receiver = iv[0] into the next two slots.
	var dataSlot int = 0
	var recvSlot int = 1
	if useRetbuf {
		// X0 = retbuf: a single aggregate uses its pre-allocated alloc region; a
		// multi-return (big OR small) uses the spill slot the tuple lands in.  The
		// shim does its own X8 sret plumbing for a big tuple — the caller does NOT
		// set X8.  data/receiver then shift to X1/X2.
		var retbufOff int = -1
		if aggregateRet {
			retbufOff = rm.LookupAlloc(ins.ID)
		} else {
			retbufOff = rm.LookupSpill(ins.ID)
		}
		if retbufOff < 0 { return }
		aarch64.Add(a, true, argReg(0), aarch64.SP, aarch64.Imm(retbufOff))
		dataSlot = 1
		recvSlot = 2
	}
	var dataRegStart int = rm.CC.CallArgRegStart(argTypes, dataSlot)
	if dataRegStart >= 0 {
		aarch64.Ldr(a, true, argReg(dataRegStart),
				aarch64.MemImm(aarch64.X16, types.FuncValueDataOffset()))
	}
	var recvRegStart int = rm.CC.CallArgRegStart(argTypes, recvSlot)
	if recvRegStart >= 0 {
		aarch64.Ldr(a, true, argReg(recvRegStart), aarch64.MemImm(ivAddr, types.IfaceValueDataOffset()))
	}

	aarch64.Blr(a, aarch64.X17)
	rm.ResetRegs()
	collectShimReturnAA64(a, rm, ins, aggregateRet, multiRet)
}

// emitImplVtables emits one `__ivt.<...>` constant for each
// (impl, iface) pair the module defines.  Layout matches the
// LLVM backend's emit_impls.bn:
//   slot 0:        dtor pointer (or 0 if the type has no dtor)
//   slot 1:        *TypeInfo (RTTI; 0 placeholder until populated)
//   slots 2..N+1:  method pointers in interface-declaration order
// where N is the number of methods on the interface (own-only —
// no parent recursion for non-extending interfaces, which is the
// only shape used by current conformance tests).  Each slot is an
// 8-byte (.quad) absolute fixup against the function or dtor
// symbol; clang/ld resolves them at link time.
//
// The vtables live in the relocatable-read-only section (rodata_relro
// → Mach-O __DATA_CONST,__const / ELF .data.rel.ro) with global
// visibility so cross-TU OP_IFACE_VALUE sites can reach them through a
// single shared symbol.  They are read-only (only ever read at
// dispatch) yet bear relocations — Mach-O's `.quad <label>` produces an
// ARM64_RELOC_UNSIGNED reloc that the linker fixes up — so they cannot
// live in __TEXT,__const; the loader makes the section read-only once
// the fixups are applied.
func emitImplVtables(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	if len(mod.Impls) == 0 { return }
	for i := 0; i < len(mod.Impls); i++ {
		var info @ir.ImplInfo = mod.Impls[i]
		if info == nil { continue }
		emitOneImplVtable(a, pkgName, mod, info)
		// Parallel shim vtable (method slots hold @__handle handles) so the
		// bytecode VM can dispatch this package's iface methods through their
		// marshaling shims when the package is injected native-only.  Gated to
		// non-generic impls — the same set the descriptor's Vtables table lists
		// (generic instantiations re-lower at the bytecode importer).
		if !common.RecvTypeIsGenericInst(info.RecvTypeName) {
			emitOneImplShimVtable(a, pkgName, mod, info)
		}
	}
	emitTypeInfosNative(a, pkgName, mod)
	emitIfaceIdsNative(a, mod)
	emitSatEntriesNative(a, mod)
}

// dtorSlotSymNative returns the destructor-handle slot symbol for receiver dtor
// `dtorName` — the object-format-prefixed `__handle.<dtor>` — or empty (a null
// slot) when the type needs no destruction (empty name) or the dtor is not
// present in this module.  Used for BOTH the vtable any-block slot 0 and the
// TypeInfo record's word 0, so the two agree by construction.
func dtorSlotSymNative(pkgName *[]readonly char, mod @ir.Module,
		dtorName *[]readonly char) @[]char {
	var none @[]char
	if len(dtorName) == 0 { return none }
	if lookupModuleFunc(mod, dtorName) == nil { return none }
	return handleSymFor(pkgName, dtorName)
}

// emitOneImplVtable writes a single __ivt.<...> array of pointers
// with the concat-recursive layout:
//   slots 0-1:               R's any-block (dtor, then *TypeInfo)
//   per parent P, recursively: full vtable of (R, P)
//   per own method m:         R's method function-value HANDLE (@__handle.<m>)
// For non-extending interfaces this collapses to [dtor, *TypeInfo, m1, m2, ...].
// The recursion supports upcasts: `*Child → *Parent` becomes a pointer +offset
// that lands at the parent's any-block, where the parent-typed dispatch path
// expects to find a dtor + the parent's full layout.
//
// useHandles=true: every method slot holds the method's function-value HANDLE
// (@__handle.<m>), the same convention slot 0 (dtor) already uses.  Interface
// method dispatch (emitCallIfaceMethod, and the LLVM backend's) therefore goes
// through the handle's marshaling shim uniformly, so a native-emitted dispatch can
// reach an impl whose @__ivt was emitted by another backend (the hybrid native-
// main / LLVM-dep build).  This makes @__ivt and the parallel @__ivtshim identical
// content.  Matches emit_impls.bn:emitImplVtable.
func emitOneImplVtable(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module,
		info @ir.ImplInfo) {
	var slots @[]@[]char = collectImplVtableSlotsNative(pkgName, mod, info, info.IfacePkg,
			info.IfaceName, true)
	markImplSlotsGlobalNative(a, slots)
	common.EmitDataGlobal(a, irdata.BuildImplVtable(implVtableNameNative(info), slots))
}

// emitOneImplShimVtable writes the parallel `__ivtshim.<...>` array for an
// (R, I) impl: the same byte-identical slot layout as emitOneImplVtable, but
// each METHOD slot holds the method's function-value HANDLE
// (`@__handle.<mangled>`, the same form the dtor slot already uses) instead of
// the raw method fn.  The bytecode VM resolves this from the raw `@__ivt`
// address (descriptor's VtableInfo.ShimAddr) and dispatches an injected native-
// only package's iface methods through the handle's marshaling shim, so it
// never replicates the native arg/return ABI.  Mirrors
// pkg/binate/codegen/emit_impls.bn:emitImplShimVtable.
func emitOneImplShimVtable(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module,
		info @ir.ImplInfo) {
	var slots @[]@[]char = collectImplVtableSlotsNative(pkgName, mod, info, info.IfacePkg,
			info.IfaceName, true)
	markImplSlotsGlobalNative(a, slots)
	common.EmitDataGlobal(a, irdata.BuildImplVtable(implShimVtableNameNative(info), slots))
}

// collectImplVtableSlotsNative returns the ordered slot symbols for one (R, X)
// sub-block of the recursive layout: dtor, then each parent's nested layout
// (inline), then X's own methods on R.  Mirrors collectImplVtableSlots_x64 and
// the LLVM collectImplVtableSlots.  An empty slot symbol is a null pointer;
// irdata.BuildImplVtable lays the bytes.
//
// useHandles=true (both @__ivt via emitOneImplVtable and @__ivtshim via
// emitOneImplShimVtable now use it — the two are identical content) makes every
// method slot hold the method's function-value `@__handle`, threaded through the
// parent recursion so every nested sub-block uses the same form.  useHandles=false
// would instead hold the raw method fn symbol; no live caller uses it (kept as a
// parameter to mirror the LLVM collectImplVtableSlots signature).
func collectImplVtableSlotsNative(pkgName *[]readonly char, mod @ir.Module, info @ir.ImplInfo,
		ifacePkg *[]readonly char, ifaceName *[]readonly char, useHandles bool) @[]@[]char {
	var slots @[]@[]char
	// Slot 0: dtor HANDLE pointer (or empty = null).  _call_dtor (invoked by
	// ZeroRefDestroy) lowers as OP_CALL_HANDLE and expects a BnFuncValue handle,
	// not a raw fn pointer (binate dc46ac7f; conformance/520).
	slots = slices.Append[@[]char](slots, dtorSlotSymNative(pkgName, mod, info.DtorFuncName))
	// Slot 1: the concrete type's *TypeInfo (two-word any-block, RTTI —
	// spec §7.13.8/§7.13.14) — the `__typeinfo.<T>` record emitted weak by
	// emitTypeInfosNative.  Keyed on the receiver type so every nested
	// sub-vtable carries the SAME leaf-type record.  Its payload is a
	// zero/null placeholder for now; its address is the type's identity.
	var typeInfoSlot @[]char = symPrefixed(
			mangle.TypeInfoName(info.RecvPkg, info.RecvTypeName))
	slots = slices.Append[@[]char](slots, typeInfoSlot)
	var parentPkgs @[]@[]char = ir.IfaceParentPkgs(mod, ifacePkg, ifaceName)
	var parentNames @[]@[]char = ir.IfaceParentNames(mod, ifacePkg, ifaceName)
	for i := 0; i < len(parentPkgs); i++ {
		var ps @[]@[]char = collectImplVtableSlotsNative(pkgName, mod, info, parentPkgs[i],
				parentNames[i], useHandles)
		for j := 0; j < len(ps); j++ {
			slots = slices.Append[@[]char](slots, ps[j])
		}
	}
	// X's own methods on R, in interface-declaration order.  The slot is the
	// iv-dispatch thunk for value-receiver methods (LookupVtableSlotName) —
	// without it a `*Iface`-reached value-receiver impl reads the iv-data
	// pointer as the receiver value (conformance 410_iface_value_recv_dispatch).
	var ownMethods @[]@[]char = ir.IfaceOwnMethodNames(mod, ifacePkg, ifaceName)
	for mi := 0; mi < len(ownMethods); mi++ {
		var qualified @[]char = buildMethodFuncNameNative(info.RecvPkg, info.RecvTypeName, ownMethods[mi])
		var slotName @[]char = ir.LookupVtableSlotName(mod, qualified)
		var mLabel @[]char = symFor(pkgName, slotName)
		if useHandles {
			mLabel = handleSymFor(pkgName, slotName)
		}
		slots = slices.Append[@[]char](slots, mLabel)
	}
	return slots
}

// markImplSlotsGlobalNative marks each non-empty slot target (a dtor handle / a
// method fn or handle) global so its relocation resolves; a null slot needs no
// symbol.
func markImplSlotsGlobalNative(a @asm.Assembler, slots @[]@[]char) {
	for i := 0; i < len(slots); i++ {
		if len(slots[i]) > 0 {
			a.SetGlobal(slots[i])
		}
	}
}

// implVtableNameNative builds the underscore-prefixed Mach-O
// symbol for an (R, I) impl vtable.  Matches the canonical
// `__ivt.bn_V...`
// form from pkg/binate/codegen/emit_impls.bn:implVtableName, with the
// Mach-O `_` prefix prepended.
func implVtableNameNative(info @ir.ImplInfo) @[]char {
	// Delegate the bare name to mangle.ImplVtableName (the single source of
	// truth shared with IR-gen / codegen / VM), then add the object-format
	// prefix (Mach-O leading '_').
	return symPrefixed(
			mangle.ImplVtableName(info.RecvPkg, info.RecvTypeName, info.IfacePkg, info.IfaceName))
}

// implShimVtableNameNative builds the object-format-prefixed symbol for an
// (R, I) impl's parallel shim vtable via mangle.ImplVtableShimName, so the
// descriptor's ShimAddr fixup names exactly the symbol this backend defines
// and the cross-mode VM lookup matches.
func implShimVtableNameNative(info @ir.ImplInfo) @[]char {
	return symPrefixed(
			mangle.ImplVtableShimName(info.RecvPkg, info.RecvTypeName, info.IfacePkg, info.IfaceName))
}

// buildMethodFuncNameNative mirrors the LLVM
// emit_impls.bn:buildMethodFuncName — `<recvPkg>.<recvName>.<methodName>`.
// Duplicated here so the native path doesn't reach into pkg/binate/codegen.
func buildMethodFuncNameNative(recvPkg *[]readonly char, recvName *[]readonly char,
		methodName *[]readonly char) @[]char {
	var b @[]char
	b = common.AppendStr(b, recvPkg)
	b = common.AppendStr(b, ".")
	b = common.AppendStr(b, recvName)
	b = common.AppendStr(b, ".")
	b = common.AppendStr(b, methodName)
	return b
}

// lookupModuleFunc returns the ir.Func with the given canonical
// name in mod.Funcs, or nil if absent.  Used by the vtable dtor
// slot to fall back to a null pointer when the dtor function
// wasn't emitted in this translation unit (e.g. the receiver has
// no managed fields).
func lookupModuleFunc(mod @ir.Module, name *[]readonly char) @ir.Func {
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f == nil { continue }
		if charEqIface(f.Name, name) { return f }
	}
	return nil
}

// charEqIface is a local byte-compare for char slices, kept inside
// this file so the iface module stays self-contained.
func charEqIface(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
