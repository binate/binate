package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/stdx/slices"

// ============================================================
// Interface dispatch — emitCallIfaceMethod, emitImplVtables
//
// Mirrors the LLVM lowering in pkg/binate/codegen/emit_impls.bn: each
// `impl T : I` declaration produces one `__ivt.bn_V...`
// global containing [dtor, *TypeInfo, m1, m2, ...] pointers; an
// `OP_IFACE_VALUE` site packs {data, vtable_global_addr} into a
// 16-byte aggregate; `OP_CALL_IFACE_METHOD` loads
// vtable[Index] (Index is the ABSOLUTE vtable slot, already past
// the two-word any-block — dtor + *TypeInfo) and calls it indirectly
// with `data` as the first arg; `OP_IFACE_DTOR`
// loads vtable[0] for the @Iface scope-exit cleanup path.
// See plan-interface-syntax-revision.md slices 2.3a / 2.5.
// ============================================================

// emitCallIfaceMethod lowers OP_CALL_IFACE_METHOD.  Args[0] is the
// iv value (a 16-byte {data, vtable} aggregate held at the alloc
// region pointed to by getOperand); Args[1..] are user args;
// Index is the ABSOLUTE vtable slot (slots 0-1 = any-block: dtor,
// *TypeInfo; first method = slot 2; an extended interface's inherited
// methods land at nested absolute offsets) — dispatched raw as
// `8 * Index`, no +2.
//
// Shape mirrors emitCallFuncValue, but with iv's slot ordering:
// vtable lives at offset 8 (not 0 like func value); data at 0.
func emitCallIfaceMethod(a @asm.Assembler, pkgName *[]readonly char,
	rm @common.RegMap, allFuncs @[]@ir.Func, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }

	// Two-step load into X17:
	//   X17 = iv.vtable     (LDR X17, [ivAddr + 8])
	//   X17 = vt[Index]     (LDR X17, [X17 + 8 * Index])
	// `ins.Index` is the ABSOLUTE vtable slot (already accounting
	// for the two-word any-block — dtor + *TypeInfo — plus any parent
	// sub-vtable inlining) — see
	// pkg/binate/ir/gen_iface.bn:findInterfaceMethodFromBase, which
	// computes `cursor = base + 2` (skipping the any-block) before
	// adding the method's own offset.  Matches LLVM emission in
	// pkg/binate/codegen/emit_impls.bn:emitCallIfaceMethod which also
	// uses `instr.Index` raw.  (Earlier draft of this code added
	// `+1` here too, which double-shifted past the real slot and
	// dispatched into garbage on every method call.)
	var ivAddr int = getOperand(a, rm, ins.Args[0].ID)
	if ivAddr < 0 { return }
	aarch64.Ldr(a, true, aarch64.X17,
		aarch64.MemImm(ivAddr, types.IfaceValueVtableOffset()))
	aarch64.Ldr(a, true, aarch64.X17,
		aarch64.MemImm(aarch64.X17, 8 * ins.Index))

	// Synthetic argTypes list with *uint8 prepended for the data
	// (receiver) slot so AAPCS register-start computations account
	// for it.  Identical to emitCallFuncValue's pattern.
	var nCallArgs int = len(ins.Args) - 1
	var argTypes @[]@types.Type =
		make_slice(@types.Type, nCallArgs + 1)
	argTypes[0] = types.MakePointerType(types.TypUint8())
	for i := 0; i < nCallArgs; i++ {
		argTypes[i + 1] = ins.Args[i + 1].Typ
	}

	// User args land in X1+ (X0 reserved for data).  Read these
	// before the data load so any user arg whose source reg is X0
	// is read before X0 is overwritten.
	var nsrn int = 0
	for ai := 0; ai < nCallArgs; ai++ {
		var arg @ir.Instr = ins.Args[ai + 1]
		if isFloatTyp(arg.Typ) {
			var src int = getOperand(a, rm, arg.ID)
			if src < 0 { continue }
			if nsrn < 8 {
				aarch64.Fmov_gp_to_fp(a,
					aarch64.D0 + nsrn, src)
				nsrn = nsrn + 1
			}
			continue
		}
		hn, hw := types.HfaClassify(arg.Typ)
		if rm.CC.HfaAggregates && hn > 0 {
			// HFA arg: place each member in D[nsrn+m] (loaded from the data
			// region); on FP overflow the whole HFA spills to the outgoing-args
			// stack.  Mirrors emitCall's HFA arg branch.
			var ptr int = getOperand(a, rm, arg.ID)
			if ptr >= 0 {
				if nsrn + hn <= rm.CC.NumFpArgRegs {
					for m := 0; m < hn; m++ {
						hfaMemberLoadToFp(a, aarch64.D0 + nsrn + m,
							ptr, m * hw, hw)
					}
					nsrn = nsrn + hn
				} else {
					var soff int = rm.CC.CallArgStackOff(argTypes, ai + 1)
					var nWords int = common.ArgWords(arg.Typ)
					if soff >= 0 {
						for w := 0; w < nWords; w++ {
							aarch64.Ldr(a, true, aarch64.X16,
								aarch64.MemImm(ptr, 8*w))
							aarch64.Str(a, true, aarch64.X16,
								aarch64.MemImm(aarch64.SP, soff + 8*w))
						}
					}
					nsrn = rm.CC.NumFpArgRegs
				}
			}
			rm.ResetRegs()
			continue
		}
		var regStart int = rm.CC.CallArgRegStart(argTypes, ai + 1)
		var stackOff int = rm.CC.CallArgStackOff(argTypes, ai + 1)
		if common.IsAggregateTyp(arg.Typ) {
			var ptr int = getOperand(a, rm, arg.ID)
			if ptr < 0 { continue }
			// Indirect-large: pass the data-region pointer in 1
			// reg / 1 stack word (mirror of emitCall's branch).
			if rm.CC.IndirectLargeAggregates &&
					arg.Typ.SizeOf() > rm.CC.AggregateInRegMax {
				if regStart >= 0 {
					if ptr != argReg(regStart) {
						aarch64.Mov(a, true,
							argReg(regStart),
							aarch64.Reg(ptr))
					}
				} else if stackOff >= 0 {
					aarch64.Str(a, true, ptr,
						aarch64.MemImm(aarch64.SP, stackOff))
				}
				rm.ResetRegs()
				continue
			}
			var nWords int = common.ArgWords(arg.Typ)
			if regStart >= 0 {
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true,
						argReg(regStart + w),
						aarch64.MemImm(ptr, 8*w))
				}
			} else {
				var tmp int = aarch64.X16
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true, tmp,
						aarch64.MemImm(ptr, 8*w))
					aarch64.Str(a, true, tmp,
						aarch64.MemImm(aarch64.SP,
							stackOff + 8*w))
				}
			}
		} else {
			// emitValOperand (not bare getOperand) so a global address
			// passed to an iface method (`i.m(&G)`) is materialized — the
			// IsGlobalRef pseudo (ID -1) has no SSA register, so getOperand
			// misses it and the arg is silently dropped.  Mirrors the x64
			// iface-arg path; a global ref is always a scalar pointer, so
			// only this branch needs it (the float / aggregate branches
			// never carry one).
			var src int = emitValOperand(a, pkgName, rm, arg)
			if src < 0 { continue }
			if regStart >= 0 {
				if src != argReg(regStart) {
					aarch64.Mov(a, true,
						argReg(regStart),
						aarch64.Reg(src))
				}
			} else {
				// A narrow fixed scalar (int8 / int16 / int32 / float32) packs
				// at its natural size + alignment on a natural-size-stack
				// convention (Apple-AArch64); an over-wide store here would
				// overrun the now-natural-sized outgoing-args area into the
				// caller's frame.  Mirrors emitCall.
				aarch64.StrSized(a,
					rm.CC.StackArgStoreSize(arg.Typ, false), src,
					aarch64.MemImm(aarch64.SP, stackOff))
			}
		}
		// Mirror emitCall: per-arg ResetRegs to keep the scratch
		// pool from saturating on long arg lists.  Without this, an
		// iface dispatch with 9+ scalar args trips the X9..X17 pool
		// (same op=50 / OP_CALL_INDIRECT-class saturation that
		// emitCallFuncValue and emitCallIndirect now guard against).
		rm.ResetRegs()
	}

	// If the arg loop ran, ResetRegs reallocated slot 0 (X9 =
	// ivAddr's reg) for an arg's scratch, clobbering ivAddr's
	// contents.  Reload before the data read below.
	if nCallArgs > 0 {
		ivAddr = getOperand(a, rm, ins.Args[0].ID)
		if ivAddr < 0 { return }
	}
	// Load data (iv[0]) into the AAPCS register for arg 0.
	var dataRegStart int = rm.CC.CallArgRegStart(argTypes, 0)
	if dataRegStart >= 0 {
		aarch64.Ldr(a, true, argReg(dataRegStart),
			aarch64.MemImm(ivAddr, types.IfaceValueDataOffset()))
	}

	// AAPCS sret for big aggregate / multi-return results.
	var bigMultiRet bool = ins.ID >= 0 &&
		rm.CC.CallReturnsBigMultiReturn(ins)
	var bigRet bool = ins.ID >= 0 &&
		(rm.CC.CallReturnsBigAggregate(ins) || bigMultiRet)
	if bigRet {
		var sretOff int = -1
		if bigMultiRet {
			sretOff = rm.LookupSpill(ins.ID)
		} else {
			sretOff = rm.LookupAlloc(ins.ID)
		}
		if sretOff >= 0 {
			aarch64.Add(a, true, aarch64.X8, aarch64.SP,
				aarch64.Imm(sretOff))
		}
	}

	aarch64.Blr(a, aarch64.X17)
	rm.ResetRegs()
	if ins.ID < 0 { return }

	// Aggregate single-return: spill X0..X(N-1) into the alloc
	// region and produce its pointer.  Same as emitCallFuncValue.
	if ins.Typ != nil && common.IsAggregateTyp(ins.Typ) &&
		!common.IsMultiReturnCall(ins) {
		var dataOff int = rm.LookupAlloc(ins.ID)
		if dataOff < 0 { return }
		var sz int = ins.Typ.SizeOf()
		if sz <= 0 { return }
		if !bigRet {
			if rm.CC.ReturnsHfaInRegs(ins.Typ) {
				// HFA result: members come back in D0..D(n-1); store each
				// from its FP reg (mirrors emitCall's collect).
				hn, hw := types.HfaClassify(ins.Typ)
				for m := 0; m < hn; m++ {
					hfaMemberStoreFromFp(a, aarch64.D0 + m,
						aarch64.SP, dataOff + m * hw, hw)
				}
			} else {
				var nWords int = common.ArgWords(ins.Typ)
				for ri := 0; ri < nWords && ri < 8; ri++ {
					aarch64.Str(a, true, argReg(ri),
						aarch64.MemImm(aarch64.SP,
							dataOff + 8*ri))
				}
			}
		}
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	}

	var spillOff int = rm.LookupSpill(ins.ID)
	if spillOff < 0 { return }
	if bigMultiRet { return }
	if !common.IsMultiReturnCall(ins) {
		collectScalarReturn(a, rm, ins, spillOff)
		return
	}
	collectMultiReturnFields(a, rm, ins, spillOff)
}

// emitImplVtables emits one `__ivt.<...>` constant for each
// (impl, iface) pair the module defines.  Layout matches the
// LLVM backend's emit_impls.bn:
//   slot 0:        dtor pointer (or 0 if the type has no dtor)
//   slot 1:        *TypeInfo (RTTI; 0 placeholder until populated)
//   slots 2..N+1:  method pointers in interface-declaration order
// where N is the number of methods on the interface (own-only —
// no parent recursion for non-extending interfaces, which is the
// only shape used by current conformance tests).  Each slot is an
// 8-byte (.quad) absolute fixup against the function or dtor
// symbol; clang/ld resolves them at link time.
//
// The vtables live in the relocatable-read-only section (rodata_relro
// → Mach-O __DATA_CONST,__const / ELF .data.rel.ro) with global
// visibility so cross-TU OP_IFACE_VALUE sites can reach them through a
// single shared symbol.  They are read-only (only ever read at
// dispatch) yet bear relocations — Mach-O's `.quad <label>` produces an
// ARM64_RELOC_UNSIGNED reloc that the linker fixes up — so they cannot
// live in __TEXT,__const; the loader makes the section read-only once
// the fixups are applied.
func emitImplVtables(a @asm.Assembler, pkgName *[]readonly char,
	mod @ir.Module) {
	if len(mod.Impls) == 0 { return }
	for i := 0; i < len(mod.Impls); i++ {
		var info @ir.ImplInfo = mod.Impls[i]
		if info == nil { continue }
		emitOneImplVtable(a, pkgName, mod, info)
		// Parallel shim vtable (method slots hold @__handle handles) so the
		// bytecode VM can dispatch this package's iface methods through their
		// marshaling shims when the package is injected native-only.  Gated to
		// non-generic impls — the same set the descriptor's Vtables table lists
		// (generic instantiations re-lower at the bytecode importer).
		if !common.RecvTypeIsGenericInst(info.RecvTypeName) {
			emitOneImplShimVtable(a, pkgName, mod, info)
		}
	}
	emitTypeInfosNative(a, pkgName, mod)
	emitIfaceIdsNative(a, mod)
}

// dtorSlotSymNative returns the destructor-handle slot symbol for receiver dtor
// `dtorName` — the object-format-prefixed `__handle.<dtor>` — or empty (a null
// slot) when the type needs no destruction (empty name) or the dtor is not
// present in this module.  Used for BOTH the vtable any-block slot 0 and the
// TypeInfo record's word 0, so the two agree by construction.
func dtorSlotSymNative(pkgName *[]readonly char, mod @ir.Module,
	dtorName *[]readonly char) @[]char {
	var none @[]char
	if len(dtorName) == 0 { return none }
	if lookupModuleFunc(mod, dtorName) == nil { return none }
	return handleSymFor(pkgName, dtorName)
}

// emitOneImplVtable writes a single __ivt.<...> array of pointers
// with the concat-recursive layout from plan-interface-embedding.md
// Slice E.3:
//   slots 0-1:               R's any-block (dtor, then *TypeInfo)
//   per parent P, recursively: full vtable of (R, P)
//   per own method m:         R's mangled <m> function pointer
// For non-extending interfaces this collapses to [dtor, *TypeInfo, m1, m2, ...]
// — the original Slice 2.5 layout.  The recursion supports Slice E.4
// upcasts: `*Child → *Parent` becomes a pointer +offset that lands
// at the parent's any-block, where the parent-typed dispatch path
// expects to find a dtor + the parent's full layout.
func emitOneImplVtable(a @asm.Assembler, pkgName *[]readonly char,
	mod @ir.Module, info @ir.ImplInfo) {
	var slots @[]@[]char = collectImplVtableSlotsNative(pkgName, mod, info,
		info.IfacePkg, info.IfaceName, false)
	markImplSlotsGlobalNative(a, slots)
	common.EmitDataGlobal(a,
		ir.BuildImplVtable(implVtableNameNative(info), slots))
}

// emitOneImplShimVtable writes the parallel `__ivtshim.<...>` array for an
// (R, I) impl: the same byte-identical slot layout as emitOneImplVtable, but
// each METHOD slot holds the method's function-value HANDLE
// (`@__handle.<mangled>`, the same form the dtor slot already uses) instead of
// the raw method fn.  The bytecode VM resolves this from the raw `@__ivt`
// address (descriptor's VtableInfo.ShimAddr) and dispatches an injected native-
// only package's iface methods through the handle's marshaling shim, so it
// never replicates the native arg/return ABI.  Mirrors
// pkg/binate/codegen/emit_impls.bn:emitImplShimVtable.
func emitOneImplShimVtable(a @asm.Assembler, pkgName *[]readonly char,
	mod @ir.Module, info @ir.ImplInfo) {
	var slots @[]@[]char = collectImplVtableSlotsNative(pkgName, mod, info,
		info.IfacePkg, info.IfaceName, true)
	markImplSlotsGlobalNative(a, slots)
	common.EmitDataGlobal(a,
		ir.BuildImplVtable(implShimVtableNameNative(info), slots))
}

// collectImplVtableSlotsNative returns the ordered slot symbols for one (R, X)
// sub-block of the recursive layout: dtor, then each parent's nested layout
// (inline), then X's own methods on R.  Mirrors collectImplVtableSlots_x64 and
// the LLVM collectImplVtableSlots.  An empty slot symbol is a null pointer;
// ir.BuildImplVtable lays the bytes.
//
// useHandles=false gives the raw `@__ivt` layout (method slots hold the raw
// method fn symbol); useHandles=true gives the parallel `@__ivtshim` layout
// (method slots hold the method's `@__handle`), threaded through the parent
// recursion so every nested sub-block uses the same form.
func collectImplVtableSlotsNative(pkgName *[]readonly char, mod @ir.Module,
	info @ir.ImplInfo, ifacePkg *[]readonly char,
	ifaceName *[]readonly char, useHandles bool) @[]@[]char {
	var slots @[]@[]char
	// Slot 0: dtor HANDLE pointer (or empty = null).  _call_dtor (invoked by
	// ZeroRefDestroy) lowers as OP_CALL_HANDLE and expects a BnFuncValue handle,
	// not a raw fn pointer (binate dc46ac7f; conformance/520).
	slots = slices.Append[@[]char](slots,
		dtorSlotSymNative(pkgName, mod, info.DtorFuncName))
	// Slot 1: the concrete type's *TypeInfo (two-word any-block, RTTI —
	// spec §7.13.8/§7.13.14) — the `__typeinfo.<T>` record emitted weak by
	// emitTypeInfosNative.  Keyed on the receiver type so every nested
	// sub-vtable carries the SAME leaf-type record.  Its payload is a
	// zero/null placeholder for now; its address is the type's identity.
	var typeInfoSlot @[]char = symPrefixed(
		mangle.TypeInfoName(info.RecvPkg, info.RecvTypeName))
	slots = slices.Append[@[]char](slots, typeInfoSlot)
	var parentPkgs @[]@[]char = ir.IfaceParentPkgs(mod, ifacePkg, ifaceName)
	var parentNames @[]@[]char = ir.IfaceParentNames(mod, ifacePkg, ifaceName)
	for i := 0; i < len(parentPkgs); i++ {
		var ps @[]@[]char = collectImplVtableSlotsNative(pkgName, mod, info,
			parentPkgs[i], parentNames[i], useHandles)
		for j := 0; j < len(ps); j++ {
			slots = slices.Append[@[]char](slots, ps[j])
		}
	}
	// X's own methods on R, in interface-declaration order.  The slot is the
	// iv-dispatch thunk for value-receiver methods (LookupVtableSlotName) —
	// without it a `*Iface`-reached value-receiver impl reads the iv-data
	// pointer as the receiver value (conformance 410_iface_value_recv_dispatch).
	var ownMethods @[]@[]char = ir.IfaceOwnMethodNames(mod, ifacePkg, ifaceName)
	for mi := 0; mi < len(ownMethods); mi++ {
		var qualified @[]char = buildMethodFuncNameNative(info.RecvPkg,
			info.RecvTypeName, ownMethods[mi])
		var slotName @[]char = ir.LookupVtableSlotName(mod, qualified)
		var mLabel @[]char = symFor(pkgName, slotName)
		if useHandles {
			mLabel = handleSymFor(pkgName, slotName)
		}
		slots = slices.Append[@[]char](slots, mLabel)
	}
	return slots
}

// markImplSlotsGlobalNative marks each non-empty slot target (a dtor handle / a
// method fn or handle) global so its relocation resolves; a null slot needs no
// symbol.
func markImplSlotsGlobalNative(a @asm.Assembler, slots @[]@[]char) {
	for i := 0; i < len(slots); i++ {
		if len(slots[i]) > 0 {
			a.SetGlobal(slots[i])
		}
	}
}

// implVtableNameNative builds the underscore-prefixed Mach-O
// symbol for an (R, I) impl vtable.  Matches the canonical
// `__ivt.bn_V...`
// form from pkg/binate/codegen/emit_impls.bn:implVtableName, with the
// Mach-O `_` prefix prepended.
func implVtableNameNative(info @ir.ImplInfo) @[]char {
	// Delegate the bare name to mangle.ImplVtableName (the single source of
	// truth shared with IR-gen / codegen / VM), then add the object-format
	// prefix (Mach-O leading '_').
	return symPrefixed(mangle.ImplVtableName(info.RecvPkg, info.RecvTypeName,
		info.IfacePkg, info.IfaceName))
}

// implShimVtableNameNative builds the object-format-prefixed symbol for an
// (R, I) impl's parallel shim vtable via mangle.ImplVtableShimName, so the
// descriptor's ShimAddr fixup names exactly the symbol this backend defines
// and the cross-mode VM lookup matches.
func implShimVtableNameNative(info @ir.ImplInfo) @[]char {
	return symPrefixed(mangle.ImplVtableShimName(info.RecvPkg,
		info.RecvTypeName, info.IfacePkg, info.IfaceName))
}

// buildMethodFuncNameNative mirrors the LLVM
// emit_impls.bn:buildMethodFuncName — `<recvPkg>.<recvName>.<methodName>`.
// Duplicated here so the native path doesn't reach into pkg/binate/codegen.
func buildMethodFuncNameNative(recvPkg *[]readonly char,
	recvName *[]readonly char, methodName *[]readonly char) @[]char {
	var b @[]char
	b = common.AppendStr(b, recvPkg)
	b = common.AppendStr(b, ".")
	b = common.AppendStr(b, recvName)
	b = common.AppendStr(b, ".")
	b = common.AppendStr(b, methodName)
	return b
}

// lookupModuleFunc returns the ir.Func with the given canonical
// name in mod.Funcs, or nil if absent.  Used by the vtable dtor
// slot to fall back to a null pointer when the dtor function
// wasn't emitted in this translation unit (e.g. the receiver has
// no managed fields).
func lookupModuleFunc(mod @ir.Module, name *[]readonly char) @ir.Func {
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f == nil { continue }
		if charEqIface(f.Name, name) { return f }
	}
	return nil
}

// charEqIface is a local byte-compare for char slices, kept inside
// this file so the iface module stays self-contained.
func charEqIface(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
