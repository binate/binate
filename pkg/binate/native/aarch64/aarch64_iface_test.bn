package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the interface-vtable / call helpers in arm64_iface.bn.
// End-to-end emission is exercised by the conformance suite under
// builder-comp_native_aa64-comp_native_aa64; these unit tests pin the pure helpers
// (name mangling + the common.AppendStr slice append) so a regression
// in the names doesn't slip through silently.

// TestImplVtableNameNative pins the underscore-prefixed Mach-O
// symbol for an (R, I) impl vtable: matches the LLVM
// `__ivt.bn_<recv_pkg>__<recv_name>__<iface_pkg>__<iface_name>`
// mangling from pkg/binate/codegen/emit_impls.bn:implVtableName, with the
// Mach-O `_` C-linkage prefix prepended.
func TestImplVtableNameNative() testing.TestResult {
	var info @ir.ImplInfo = make(ir.ImplInfo)
	info.RecvPkg = "main"
	info.RecvTypeName = "T"
	info.IfacePkg = "main"
	info.IfaceName = "I"
	var got @[]char = implVtableNameNative(info)
	if !charEq(got, "___ivt.bn_main__T__main__I") {
		return fail("expected ___ivt.bn_main__T__main__I")
	}
	return ""
}

// TestImplVtableNameNativeCrossPkg covers the cross-package shape
// (Slice 2.6 of plan-cross-package-interfaces.md): the iface's
// own package name appears between RecvName and IfaceName even
// when impl and iface live in different packages.
func TestImplVtableNameNativeCrossPkg() testing.TestResult {
	var info @ir.ImplInfo = make(ir.ImplInfo)
	info.RecvPkg = "geom"
	info.RecvTypeName = "Point"
	info.IfacePkg = "fmt"
	info.IfaceName = "Stringer"
	var got @[]char = implVtableNameNative(info)
	if !charEq(got, "___ivt.bn_geom__Point__fmt__Stringer") {
		return fail("expected ___ivt.bn_geom__Point__fmt__Stringer")
	}
	return ""
}

// TestBuildMethodFuncNameNative pins the dotted-name format used
// when looking up a method's mangled function symbol from a
// vtable slot.  Format: `<recvPkg>.<recvName>.<methodName>` —
// matches pkg/binate/codegen/emit_impls.bn:buildMethodFuncName.
func TestBuildMethodFuncNameNative() testing.TestResult {
	var got @[]char = buildMethodFuncNameNative(
		"geom", "Point", "String")
	if !charEq(got, "geom.Point.String") {
		return fail("expected geom.Point.String")
	}
	return ""
}

// emitCallIfaceMethod with no user args + void return emits:
//   LDR ivAddr, [SP, #...]      ; getOperand reload
//   LDR X17, [ivAddr + 8]       ; iv.vtable
//   LDR X17, [X17 + 8*Index]    ; vtable[Index]
//   LDR X0, [ivAddr + 0]        ; iv.data → arg 0
//   BLR X17
// Five 4-byte AArch64 instructions = 20 bytes. Pins the call-site
// shape (matches emitCallFuncValue's 20-byte shape on the same args).
func TestEmitCallIfaceMethodNoArgsVoid() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)

	var ivAddr @ir.Instr = make(ir.Instr)
	ivAddr.ID = 5

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL_IFACE_METHOD
	ins.Index = 1
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = ivAddr

	emitCallIfaceMethod(a, "main", m, nilFuncs(), ins)
	if opsBytes(a) != 20 {
		return fail("iface-method call (no user args, void) should emit 5 instrs (20 bytes)")
	}
	return ""
}

// emitCallIfaceMethod must use `ins.Index` raw as the vtable slot —
// not `ins.Index + 1`.  Earlier draft of arm64_iface.bn added a `+1`
// to "skip the dtor", but findInterfaceMethodFromBase in
// pkg/binate/ir/gen_iface.bn already returns the ABSOLUTE slot (it walks
// `cursor = base + 1` to skip the dtor before adding the method
// offset).  The buggy `+1` dispatched one slot past the real method
// on every iface call, producing SIGBUS on every iface conformance.
//
// LDR (immediate, unsigned offset, 64-bit) encoding:
//   bits 31-24 = 0xF9, bits 22-23 = 01 (LDR), bits 21-10 = imm12,
//   bits 9-5 = Rn (5 bits), bits 4-0 = Rt (5 bits).
// For LDR X17, [X17, #8] (Index=1 → byte offset 8 / scale 8 → 1):
//   word = 0xF9_4006_31 (little-endian: 31 06 40 F9).
// For LDR X17, [X17, #16] (the buggy Index+1 path with Index=1):
//   word = 0xF9_400A_31 (little-endian: 31 0A 40 F9).
// Byte 9 of emitCallIfaceMethod's output (= byte 1 of the 3rd
// instruction, which is the vtable-slot LDR) distinguishes the two:
//   0x06 = correct (matches the post-7096a94 fix),
//   0x0A = the off-by-one regression.
func TestEmitCallIfaceMethodSlotOffsetIsRaw() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)

	var ivAddr @ir.Instr = make(ir.Instr)
	ivAddr.ID = 5

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL_IFACE_METHOD
	ins.Index = 1
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = ivAddr

	emitCallIfaceMethod(a, "main", m, nilFuncs(), ins)
	if opsBytes(a) != 20 {
		return fail("slot-offset test needs 5-instr emission")
	}
	// 3rd instruction = vtable-slot LDR (bytes 8..11).
	var byteSlotLow uint8 = a.Sections[0].Data[8]
	var byteSlotImm uint8 = a.Sections[0].Data[9]
	var byteSlotHi1 uint8 = a.Sections[0].Data[10]
	var byteSlotHi2 uint8 = a.Sections[0].Data[11]
	if byteSlotLow != cast(uint8, 0x31) {
		return fail("slot LDR low byte should be 0x31 (Rt/Rn=X17)")
	}
	if byteSlotImm != cast(uint8, 0x06) {
		return fail(
			"slot LDR imm byte should be 0x06 (offset 8 = Index*8); "
			"0x0A means the off-by-one regression is back")
	}
	if byteSlotHi1 != cast(uint8, 0x40) {
		return fail("slot LDR byte 2 should be 0x40 (LDR opc)")
	}
	if byteSlotHi2 != cast(uint8, 0xF9) {
		return fail("slot LDR byte 3 should be 0xF9 (64-bit LDR)")
	}
	return ""
}

// emitCallIfaceMethod with Index=2 widens the slot LDR offset to 16
// (imm12 = 2 → byte 9 = 0x0A).  Pairs with the Index=1 test above to
// pin the linear dependence — i.e. slot = 8*Index, not 8*(Index+1)
// nor 8*Index + constant.
func TestEmitCallIfaceMethodSlotOffsetIndex2() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)

	var ivAddr @ir.Instr = make(ir.Instr)
	ivAddr.ID = 5

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL_IFACE_METHOD
	ins.Index = 2
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = ivAddr

	emitCallIfaceMethod(a, "main", m, nilFuncs(), ins)
	if opsBytes(a) != 20 { return fail("Index=2 should still emit 20 bytes") }
	if a.Sections[0].Data[9] != cast(uint8, 0x0A) {
		return fail("Index=2 slot LDR imm byte should be 0x0A (offset 16)")
	}
	return ""
}

// Defensive guard: emitCallIfaceMethod must early-out on a malformed
// instruction with no Args, never emitting any bytes.  Without the
// guard a missing Args[0] would crash the encoder.
func TestEmitCallIfaceMethodEmptyArgsIsNoOp() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL_IFACE_METHOD
	emitCallIfaceMethod(a, "main", m, nilFuncs(), ins)
	if opsBytes(a) != 0 {
		return fail("iface-method call with no Args should emit nothing")
	}
	return ""
}

// emitCallIfaceMethod with many scalar user args walks len(args)
// getOperand calls.  Pre-fix, each consumed a fresh scratch slot
// without per-arg ResetRegs, so an iface dispatch with 8+ scalar
// args would saturate the X9..X17 pool.  Same op=50-class panic
// that hit emitCallIndirect / emitCallFuncValue.  Mirrors
// TestEmitReturnManyValues / TestEmitCallIndirectManyArgs.
// Survival is the test.
func TestEmitCallIfaceMethodManyArgsDoesNotSaturateRegPool() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	// iv at spill 0, plus 9 int scalar args at unique spills.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var nArgs int = 9
	var args @[]@ir.Instr = make_slice(@ir.Instr, nArgs + 1)
	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 5
	args[0] = iv
	for i := 0; i < nArgs; i++ {
		rm.SpillIDs = common.AppendInt(rm.SpillIDs, 100 + i)
		rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8 + 8 * i)
		var arg @ir.Instr = make(ir.Instr)
		arg.ID = 100 + i
		arg.Typ = types.TypInt()
		args[i + 1] = arg
	}
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL_IFACE_METHOD
	ins.Index = 1
	ins.Args = args
	emitCallIfaceMethod(a, "main", rm, nilFuncs(), ins)
	if opsBytes(a) == 0 {
		return fail("OP_CALL_IFACE_METHOD many-args must emit at least one instruction")
	}
	return ""
}
