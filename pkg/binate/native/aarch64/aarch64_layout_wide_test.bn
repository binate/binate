package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Field offsets, element sizes and copy lengths past 2^31 (an aggregate may pass 2
// GiB): they reach the asm layer as int64, which materializes one past an immediate in
// X17, so a 32-bit host compiles them too.  The golden encodings are clang's for the
// same instructions.

// wideBigAA64 returns struct { pad [0x80000000]uint8; x int64 }, whose x is at 2^31.
func wideBigAA64() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.MakeArrayType(types.TypUint8(), 0x80000000)
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt64()
	return types.MakeStructType("Big", fields)
}

// wideRegMapAA64 returns a RegMap with IDs 1..n spilled at [sp + 8 * (id - 1)].
func wideRegMapAA64(n int) @common.RegMap {
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	for id := 1; id <= n; id++ {
		m.SpillIDs = common.AppendInt(m.SpillIDs, id)
		m.SpillOffsets = common.AppendInt64(m.SpillOffsets, cast(int64, 8 * (id - 1)))
	}
	return m
}

// widePtrToAA64 returns an instruction with the given ID holding a *Big.
func widePtrToAA64(id int) @ir.Instr {
	var p @ir.Instr = make(ir.Instr)
	p.ID = id
	p.Typ = types.MakePointerType(wideBigAA64())
	return p
}

// wideHexAA64 returns a's text as instruction words, eight hex digits a word separated
// by single spaces (hexWordsEqAA64's form).
func wideHexAA64(a @asm.Assembler) @[]char {
	var n int = a.Sections[0].Len / 4
	if n == 0 { return make_slice(char, 0) }
	var digits *[]readonly char = "0123456789abcdef"
	var out @[]char = make_slice(char, n * 9 - 1)
	for i := 0; i < n; i++ {
		var w uint32 = cast(uint32, a.Sections[0].Data[4 * i]) |
				(cast(uint32, a.Sections[0].Data[4 * i + 1]) << 8) |
				(cast(uint32, a.Sections[0].Data[4 * i + 2]) << 16) |
				(cast(uint32, a.Sections[0].Data[4 * i + 3]) << 24)
		for d := 0; d < 8; d++ {
			out[9 * i + d] = digits[cast(int, (w >> cast(uint32, 28 - 4 * d)) & 15)]
		}
		if i + 1 < n { out[9 * i + 8] = ' ' }
	}
	return out
}

// wideGoldenAA64 checks that a recorded no error and emitted exactly the words spelled
// by want (hexWordsEqAA64); on a mismatch it returns what with the words emitted.
func wideGoldenAA64(a @asm.Assembler, want *[]readonly char,
		what *[]readonly char) testing.TestResult {
	if a.HasError { return buf.Concat(what, ": unexpected assembler error") }
	if hexWordsEqAA64(a, want) { return "" }
	var head @[]char = buf.Concat(what, ": emitted ")
	return buf.Concat(head, wideHexAA64(a))
}

// A field pointer at 2^31 through a pointer: the offset is formed in X17.
func TestFieldPtrPast2GiBAA64() testing.TestResult {
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_GET_FIELD_PTR
	ins.Index = 1
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = widePtrToAA64(1)
	var a @asm.Assembler = mkAsm()
	emitGetFieldPtr(a, "main", wideRegMapAA64(2), ins)
	return wideGoldenAA64(a, "f94003ea d2b00011 8b110149",
			"a field pointer at 2^31: ldr x10, [sp]; mov x17, #0x80000000; add x9, x10, x17")
}

// An element of 2^31 + 8 bytes scales the index by the size in a register.
func TestElemPtrPast2GiBAA64() testing.TestResult {
	var base @ir.Instr = make(ir.Instr)
	base.ID = 1
	var idx @ir.Instr = make(ir.Instr)
	idx.ID = 2
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_GET_ELEM_PTR
	ins.Typ = types.MakePointerType(wideBigAA64())
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = base
	ins.Args[1] = idx
	var a @asm.Assembler = mkAsm()
	emitGetElemPtr(a, "main", wideRegMapAA64(3), ins)
	return wideGoldenAA64(a, "f94007e9 d280010a f2b0000a 9b0a7d2b f94003ed 8b0b01ac",
			"an element of 2^31 + 8 bytes: mov / movk x10; mul x11, x9, x10; add x12, x13, x11")
}

// A fused field load and store at 2^31 through a pointer, and an OP_EXTRACT of the
// field from an aggregate held by pointer, address it through X17.
func TestFieldAccessPast2GiBAA64() testing.TestResult {
	var gep @ir.Instr = make(ir.Instr)
	gep.ID = 2
	gep.Op = iropcode.OP_GET_FIELD_PTR
	gep.Index = 1
	gep.Args = make_slice(@ir.Instr, 1)
	gep.Args[0] = widePtrToAA64(1)
	var ld @ir.Instr = make(ir.Instr)
	ld.ID = 3
	ld.Op = iropcode.OP_LOAD
	ld.Typ = types.TypInt64()
	ld.Args = make_slice(@ir.Instr, 1)
	ld.Args[0] = gep
	var a @asm.Assembler = mkAsm()
	emitFusedFieldLoad(a, wideRegMapAA64(3), ld, gep)
	var r testing.TestResult = wideGoldenAA64(a, "f94003e9 d2b00011 8b110131 f940022a",
			"a fused field load at 2^31: the address in x17, then ldr x10, [x17]")
	if len(r) > 0 { return r }
	var val @ir.Instr = make(ir.Instr)
	val.ID = 3
	val.Typ = types.TypInt64()
	var st @ir.Instr = make(ir.Instr)
	st.Op = iropcode.OP_STORE
	st.Args = make_slice(@ir.Instr, 2)
	st.Args[0] = gep
	st.Args[1] = val
	a = mkAsm()
	emitFusedFieldStore(a, "main", wideRegMapAA64(3), st, gep)
	r = wideGoldenAA64(a, "f9400be9 f94003ea d2b00011 8b110151 f9000229",
			"a fused field store at 2^31: the address in x17, then str x9, [x17]")
	if len(r) > 0 { return r }
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Op = iropcode.OP_LOAD
	src.Typ = wideBigAA64()
	var ex @ir.Instr = make(ir.Instr)
	ex.ID = 2
	ex.Op = iropcode.OP_EXTRACT
	ex.Index = 1
	ex.Typ = types.TypInt64()
	ex.Args = make_slice(@ir.Instr, 1)
	ex.Args[0] = src
	a = mkAsm()
	emitExtract(a, wideRegMapAA64(2), ex)
	return wideGoldenAA64(a, "f94003ea d2b00011 8b110151 f9400229",
			"an OP_EXTRACT of the field at 2^31: the address in x17, then ldr x9, [x17]")
}

// OP_MAKE of a type past 2^31 passes its size to rt.Alloc in X0.
func TestMakePast2GiBAA64() testing.TestResult {
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_MAKE
	ins.TypeArg = wideBigAA64()
	var a @asm.Assembler = mkAsm()
	emitMake(a, wideRegMapAA64(1), ins)
	if a.HasError { return "unexpected assembler error" }
	if !hasWord(a, 0xd2800100) || !hasWord(a, 0xf2b00000) {
		return "rt.Alloc's size should be 0x80000008 in X0 (mov x0, #8; movk x0, #0x8000, lsl #16)"
	}
	return ""
}

// A copy of 4 GiB + 8 bytes is the loop, its iteration count 2^27, its 8 bytes left
// re-copied as the 32 that end the aggregate.
func TestCopyPast4GiBAA64() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitAggMemcpyAarch64(a, common.NewRegMap(callconv.AAPCS64()), aarch64.X0, aarch64.X1, 0x100000008)
	return wideGoldenAA64(a,
			"91000029 9100000a d2a1000b acc14530 ac814550 f100056b 54ffffa1 3cde8130 3cdf8131 3c9e8150 "
					"3c9f8151",
			"a loop copy of 4 GiB + 8 bytes: count 0x8000000, then the 32 bytes ending at the size")
}

// The float and HFA-member loads the closure shims use take an int64 offset: one past
// 2^31 is loaded through X16 with its address formed in X17.
func TestCaptureLoadPast2GiBAA64() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitFloatLoadToFpAA64(a, aarch64.D0, aarch64.X0, 0x80000010, types.TypFloat64())
	hfaMemberLoadToFp(a, aarch64.D1, aarch64.X0, 0x80000000, 4)
	return wideGoldenAA64(a,
			"d2800211 f2b00011 8b110011 f9400230 9e670200 d2b00011 8b110011 b9400230 1e270201",
			"a float64 capture and a float32 HFA member past 2^31: through x17 and x16")
}

// A packed func-value shim copies each indirect argument into its frame; the copies'
// offsets and total are int64, so two 1.5 GiB arguments take 3 GiB (an int total
// wraps negative on a 32-bit host), and the frame's SUB / ADD of SP go through X17.
func TestPackedShimCopiesPast2GiBAA64() testing.TestResult {
	setTarget64()
	var params @[]@types.Param = make_slice(@types.Param, 2)
	for i := 0; i < 2; i++ {
		var p @types.Param = make(types.Param)
		p.Type = types.MakeArrayType(types.TypUint8(), 0x60000000)
		params[i] = p
	}
	var fvTyp @types.Type = types.MakeFuncValueType(params, make_slice(@types.Type, 0))
	var cc callconv.CallConv = callconv.AAPCS64()
	var w int = funcvalPackedWordsAA64(cc, fvTyp)
	var offs @[]int64 = packedArgCopyOffsetsAA64(cc, fvTyp, w)
	if w != 2 || offs[0] != 0 || offs[1] != 0x60000000 {
		return "the two copies should sit at offsets 0 and 0x60000000"
	}
	if packedArgCopyBytesAA64(cc, fvTyp) != 0xC0000000 { return "the copies should take 3 GiB" }
	var a @asm.Assembler = mkAsm()
	emitOnePackedShimAA64(a, cc, "shim", fvTyp)
	if a.HasError { return "unexpected assembler error" }
	if !hasWord(a, 0xcb3163ff) || !hasWord(a, 0x8b3163ff) {
		return "the frame should be SUB SP, SP, X17 and ADD SP, SP, X17"
	}
	return ""
}
