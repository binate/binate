package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the aa64 logical (AND/OR/XOR) immediate fold in aarch64_fold.bn: the
// predicate (aa64LogicImm through aa64ImmFits), the logical and tst immediate
// emitters (emitLogicImmFold and emitTstImmFold via emitBinop), their loud
// failure on a folded constant that does not fit, and the fold end to end
// through emitFunc.  The encodings are pinned to clang's (`clang -target
// aarch64-linux-gnu`) for the same instruction.

// ---- Logical (AND/OR/XOR) immediate fold: the predicate ----

// A bitmask immediate at the X width folds as an AND/OR/XOR operand; a value
// that is no bitmask (an irregular pattern, 0, or an all-ones AND/OR) does not.
func TestAa64ImmFitsLogicBitmaskXForm() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = foldFunc_aa64test()
	var x @ir.Instr = foldParam_aa64test(f, types.TypInt())
	var and8 @ir.Instr = irbuild.EmitConstInt(b, 0xFF, types.TypInt())
	var orHi @ir.Instr = irbuild.EmitConstInt(b, 0xFF00, types.TypInt())
	// 0xFFFFFFFF00000000: a run of 32 ones in the high half.
	var xorTop @ir.Instr = irbuild.EmitConstInt64(b, cast(int64, -4294967296), types.TypInt())
	var andOdd @ir.Instr = irbuild.EmitConstInt(b, 0x1234, types.TypInt())
	var orZero @ir.Instr = irbuild.EmitConstInt(b, 0, types.TypInt())
	var andOnes @ir.Instr = irbuild.EmitConstInt(b, -1, types.TypInt())
	var xor5 @ir.Instr = irbuild.EmitConstInt(b, 5, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_AND, x, and8, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_OR, x, orHi, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_XOR, x, xorTop, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_AND, x, andOdd, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_OR, x, orZero, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_AND, x, andOnes, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_XOR, x, xor5, types.TypInt())
	var flags @[]bool = foldFlags_aa64test(f)
	if !flags[and8.ID] { return "AND #0xff must fold" }
	if !flags[orHi.ID] { return "OR #0xff00 must fold" }
	if !flags[xorTop.ID] { return "XOR #0xffffffff00000000 must fold" }
	if flags[andOdd.ID] { return "AND #0x1234 (no bitmask) must NOT fold" }
	if flags[orZero.ID] { return "OR #0 (no bitmask) must NOT fold" }
	if flags[andOnes.ID] { return "AND #-1 (all ones, no bitmask) must NOT fold" }
	if flags[xor5.ID] { return "XOR #5 (two runs, no bitmask) must NOT fold" }
	return ""
}

// AND/OR/XOR are commutative: a constant LHS folds like a constant RHS.
func TestAa64ImmFitsLogicEitherSide() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = foldFunc_aa64test()
	var x @ir.Instr = foldParam_aa64test(f, types.TypInt())
	var cAnd @ir.Instr = irbuild.EmitConstInt(b, 0xF0, types.TypInt())
	var cOr @ir.Instr = irbuild.EmitConstInt(b, 0xF0, types.TypInt())
	var cXor @ir.Instr = irbuild.EmitConstInt(b, 0xF0, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_AND, cAnd, x, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_OR, cOr, x, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_XOR, cXor, x, types.TypInt())
	var flags @[]bool = foldFlags_aa64test(f)
	if !flags[cAnd.ID] { return "a constant AND LHS must fold" }
	if !flags[cOr.ID] { return "a constant OR LHS must fold" }
	if !flags[cXor.ID] { return "a constant XOR LHS must fold" }
	return ""
}

// A const-const AND/OR/XOR folds neither operand: one must supply the register.
func TestAa64ImmFitsLogicConstConstNot() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = foldFunc_aa64test()
	var c @ir.Instr = irbuild.EmitConstInt(b, 0xFF, types.TypInt())
	var d @ir.Instr = irbuild.EmitConstInt(b, 0xF0, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_AND, c, d, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_OR, c, d, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_XOR, c, d, types.TypInt())
	var flags @[]bool = foldFlags_aa64test(f)
	if flags[c.ID] || flags[d.ID] { return "a const-const logical op must fold neither operand" }
	return ""
}

// The bitmask is judged at the op width.  A uint32 op runs the W form, so
// 0xF000000F — a bitmask of the 32-bit element (one run wrapping bit 31 to bit
// 0) but not of the 64-bit one (two runs) — folds for a uint32 AND and does not
// for an int or uint64 AND, which run the X form.
func TestAa64ImmFitsLogicWFormMask() testing.TestResult {
	var mask int64 = 0xF000000F
	if aarch64.LogicalImmFits(true, mask) { return "0xF000000F must not be a 64-bit bitmask" }
	if !aarch64.LogicalImmFits(false, mask) { return "0xF000000F must be a 32-bit bitmask" }
	var f @ir.Func
	var b @ir.Block
	f, b = foldFunc_aa64test()
	var u32 @ir.Instr = foldParam_aa64test(f, types.TypUint32())
	var i64 @ir.Instr = foldParam_aa64test(f, types.TypInt())
	var u64 @ir.Instr = foldParam_aa64test(f, types.TypUint64())
	var cU32 @ir.Instr = irbuild.EmitConstInt64(b, mask, types.TypUint32())
	var cInt @ir.Instr = irbuild.EmitConstInt64(b, mask, types.TypInt())
	var cU64 @ir.Instr = irbuild.EmitConstInt64(b, mask, types.TypUint64())
	_ = irbuild.EmitBinop(b, iropcode.OP_AND, u32, cU32, types.TypUint32())
	_ = irbuild.EmitBinop(b, iropcode.OP_AND, i64, cInt, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_AND, u64, cU64, types.TypUint64())
	var flags @[]bool = foldFlags_aa64test(f)
	if !flags[cU32.ID] { return "a uint32 AND #0xF000000F must fold (W-form bitmask)" }
	if flags[cInt.ID] { return "an int AND #0xF000000F must NOT fold (no X-form bitmask)" }
	if flags[cU64.ID] { return "a uint64 AND #0xF000000F must NOT fold (no X-form bitmask)" }
	return ""
}

// All-ones at the op width is never a bitmask: an AND/OR with it does not fold,
// but an XOR with it folds as MVN.  0xFFFFFFFF is all-ones only at the W width:
// in an int op it is a 32-one bitmask and rides EOR, not MVN.
func TestAa64ImmFitsLogicAllOnes() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = foldFunc_aa64test()
	var x @ir.Instr = foldParam_aa64test(f, types.TypInt())
	var u @ir.Instr = foldParam_aa64test(f, types.TypUint32())
	var xorX @ir.Instr = irbuild.EmitConstInt(b, -1, types.TypInt())
	var orX @ir.Instr = irbuild.EmitConstInt(b, -1, types.TypInt())
	var xorW @ir.Instr = irbuild.EmitConstInt64(b, 0xFFFFFFFF, types.TypUint32())
	var orW @ir.Instr = irbuild.EmitConstInt64(b, 0xFFFFFFFF, types.TypUint32())
	var andW @ir.Instr = irbuild.EmitConstInt64(b, 0xFFFFFFFF, types.TypUint32())
	var orLow32 @ir.Instr = irbuild.EmitConstInt64(b, 0xFFFFFFFF, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_XOR, x, xorX, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_OR, x, orX, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_XOR, u, xorW, types.TypUint32())
	_ = irbuild.EmitBinop(b, iropcode.OP_OR, u, orW, types.TypUint32())
	_ = irbuild.EmitBinop(b, iropcode.OP_AND, u, andW, types.TypUint32())
	_ = irbuild.EmitBinop(b, iropcode.OP_OR, x, orLow32, types.TypInt())
	var flags @[]bool = foldFlags_aa64test(f)
	if !flags[xorX.ID] { return "an int XOR #-1 must fold (MVN)" }
	if flags[orX.ID] { return "an int OR #-1 must NOT fold" }
	if !flags[xorW.ID] { return "a uint32 XOR #0xFFFFFFFF must fold (MVN)" }
	if flags[orW.ID] { return "a uint32 OR #0xFFFFFFFF must NOT fold" }
	if flags[andW.ID] { return "a uint32 AND #0xFFFFFFFF must NOT fold" }
	if !flags[orLow32.ID] { return "an int OR #0xFFFFFFFF must fold (a 32-one bitmask)" }
	return ""
}

// aa64LogicImm's width and value: a uint32 op is the W form with the constant's
// low 32 bits; every other integer is the X form with the full IntVal (a signed
// sub-word constant sign-extended, as the register path materializes it); the
// XOR-with-all-ones MVN form is reported only at the op width's all-ones.
func TestAa64LogicImmWidthAndValue() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = foldFunc_aa64test()
	var u @ir.Instr = foldParam_aa64test(f, types.TypUint32())
	var s @ir.Instr = foldParam_aa64test(f, types.TypInt32())
	var x @ir.Instr = foldParam_aa64test(f, types.TypInt())
	var cU @ir.Instr = irbuild.EmitConstInt64(b, 0xFFFFFFF0, types.TypUint32())
	var cS @ir.Instr = irbuild.EmitConstInt(b, -16, types.TypInt32())
	var cX @ir.Instr = irbuild.EmitConstInt64(b, 0xFFFFFFFF, types.TypInt())
	var andU @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_AND, u, cU, types.TypUint32())
	var andS @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_AND, s, cS, types.TypInt32())
	var xorX @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_XOR, x, cX, types.TypInt())
	var imm int64
	var sf bool
	var notForm bool
	var ok bool
	imm, sf, notForm, ok = aa64LogicImm(andU, 1)
	if !ok || sf || notForm || imm != cast(int64, 0xFFFFFFF0) {
		return "a uint32 AND #0xFFFFFFF0 must be the W form with imm 0xFFFFFFF0"
	}
	imm, sf, notForm, ok = aa64LogicImm(andS, 1)
	if !ok || !sf || notForm || imm != cast(int64, -16) {
		return "an int32 AND #-16 must be the X form with the sign-extended imm -16"
	}
	imm, sf, notForm, ok = aa64LogicImm(xorX, 1)
	if !ok || !sf || notForm || imm != cast(int64, 0xFFFFFFFF) {
		return "an int XOR #0xFFFFFFFF must be an X-form EOR bitmask, not MVN"
	}
	_, _, _, ok = aa64LogicImm(andU, 0)
	if ok { return "the register operand of an AND is no immediate position" }
	return ""
}

// aa64 registers are 64 bits wide, so an int64 / uint64 logical op folds (no
// multi-word register-pair form as on a 32-bit target; no aa64 integer type is
// wider than the word).  A float- or nil-typed op has no integer immediate.
func TestAa64ImmFitsLogicWidthAndType() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = foldFunc_aa64test()
	var x @ir.Instr = foldParam_aa64test(f, types.TypInt64())
	var u @ir.Instr = foldParam_aa64test(f, types.TypUint64())
	var c64 @ir.Instr = irbuild.EmitConstInt(b, 0xFF, types.TypInt64())
	var cU64 @ir.Instr = irbuild.EmitConstInt(b, 0xFF, types.TypUint64())
	var cFlt @ir.Instr = irbuild.EmitConstInt(b, 0xFF, types.TypInt())
	var cNil @ir.Instr = irbuild.EmitConstInt(b, 0xFF, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_AND, x, c64, types.TypInt64())
	_ = irbuild.EmitBinop(b, iropcode.OP_XOR, u, cU64, types.TypUint64())
	_ = irbuild.EmitBinop(b, iropcode.OP_AND, x, cFlt, types.TypFloat64())
	var nilOr @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_OR, x, cNil, types.TypInt())
	nilOr.Typ = nil
	var flags @[]bool = foldFlags_aa64test(f)
	if !flags[c64.ID] { return "an int64 AND operand must fold on aa64" }
	if !flags[cU64.ID] { return "a uint64 XOR operand must fold on aa64" }
	if flags[cFlt.ID] { return "a float-typed AND operand must NOT fold" }
	if flags[cNil.ID] { return "a nil-typed OR operand must NOT fold" }
	return ""
}

// A constant used both by an AND and by an ADD folds when it fits both
// immediates; one whose ADD use is out of range, or whose AND use is no bitmask,
// does not.
func TestAa64ImmFitsLogicAndAddShared() testing.TestResult {
	var f @ir.Func
	var b @ir.Block
	f, b = foldFunc_aa64test()
	var x @ir.Instr = foldParam_aa64test(f, types.TypInt())
	var both @ir.Instr = irbuild.EmitConstInt(b, 0xFF, types.TypInt())
	var addBig @ir.Instr = irbuild.EmitConstInt(b, 0x1000, types.TypInt())
	var andOdd @ir.Instr = irbuild.EmitConstInt(b, 5, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_AND, x, both, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_ADD, x, both, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_AND, x, addBig, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_ADD, x, addBig, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_AND, x, andOdd, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_ADD, x, andOdd, types.TypInt())
	var flags @[]bool = foldFlags_aa64test(f)
	if !flags[both.ID] { return "a constant 0xFF used by an AND and an ADD must fold" }
	if flags[addBig.ID] { return "a constant 0x1000 also used by an ADD (> 4095) must NOT fold" }
	if flags[andOdd.ID] { return "a constant 5 also used by an AND (no bitmask) must NOT fold" }
	return ""
}

// ---- Logical immediate fold: the emitters ----

// logicIns_aa64test builds `op` of type t over a register operand (id 1, homed
// in X20) and a constant (id 2, value v) at Args[constIdx], with the result (id
// 3) homed in X21.  When folded, the constant is FoldedImm (never materialized);
// otherwise it is homed in X22, so emitBinop takes the register path.
func logicIns_aa64test(op int, constIdx int, v int64, t @types.Type,
		folded bool) (@common.RegMap, @ir.Instr) {
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	m.HomeIDs = common.AppendInt(m.HomeIDs, 1)
	m.HomeRegs = common.AppendInt(m.HomeRegs, aarch64.X20)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 3)
	m.HomeRegs = common.AppendInt(m.HomeRegs, aarch64.X21)
	if folded {
		var fc @[]bool = make_slice(bool, 4)
		fc[2] = true
		m.FoldedImm = fc
	} else {
		m.HomeIDs = common.AppendInt(m.HomeIDs, 2)
		m.HomeRegs = common.AppendInt(m.HomeRegs, aarch64.X22)
	}
	var reg @ir.Instr = make(ir.Instr)
	reg.ID = 1
	reg.Op = iropcode.OP_PARAM
	reg.Typ = t
	var c @ir.Instr = make(ir.Instr)
	c.ID = 2
	c.Op = iropcode.OP_CONST_INT
	c.Typ = t
	c.IntVal = v
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = op
	ins.Typ = t
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[constIdx] = c
	ins.Args[1 - constIdx] = reg
	return m, ins
}

// logicFold_aa64test lowers logicIns_aa64test's instruction through emitBinop,
// returning the assembler and emitBinop's result.
func logicFold_aa64test(op int, constIdx int, v int64, t @types.Type,
		folded bool) (@asm.Assembler, bool) {
	var m @common.RegMap
	var ins @ir.Instr
	m, ins = logicIns_aa64test(op, constIdx, v, t, folded)
	var a @asm.Assembler = opsMkAssembler()
	var ok bool = emitBinop(a, m, ins)
	return a, ok
}

// foldWord_aa64test returns the little-endian instruction word at word index i
// of the text section.
func foldWord_aa64test(a @asm.Assembler, i int) uint32 {
	var d @[]uint8 = a.Sections[0].Data
	var off int = i * 4
	return cast(uint32, d[off]) | (cast(uint32, d[off + 1]) << 8) | (cast(uint32, d[off + 2]) << 16) |
			(cast(uint32, d[off + 3]) << 24)
}

// logicGolden_aa64test lowers a FoldedImm logical op and checks that it emits
// exactly the words w0 (and w1 when nonzero) with no error: the immediate op and
// its re-narrow only — no materialized constant and no register-form op.
func logicGolden_aa64test(op int, constIdx int, v int64, t @types.Type, w0 uint32, w1 uint32) bool {
	var a @asm.Assembler
	var ok bool
	a, ok = logicFold_aa64test(op, constIdx, v, t, true)
	if !ok || a.HasError { return false }
	var n int = 1
	if w1 != cast(uint32, 0) { n = 2 }
	if a.Sections[0].Len != n * 4 { return false }
	if foldWord_aa64test(a, 0) != w0 { return false }
	return n == 1 || foldWord_aa64test(a, 1) == w1
}

// X-form immediates, matching clang: `and x21, x20, #0xff` (0x92401E95), `orr
// x21, x20, #0xff00` with the constant on the LHS (0xB2781E95), and `eor x21, x20,
// #0xffffffff00000000` (0xD2607E95).
func TestEmitBinopLogicImmFoldXFormGoldens() testing.TestResult {
	var z uint32 = 0
	if !logicGolden_aa64test(iropcode.OP_AND, 1, cast(int64, 0xFF), types.TypInt(), 0x92401E95, z) {
		return "int AND #0xff must emit exactly `and x21, x20, #0xff`"
	}
	if !logicGolden_aa64test(iropcode.OP_OR, 0, cast(int64, 0xFF00), types.TypInt(), 0xB2781E95, z) {
		return "int OR with a constant LHS 0xff00 must emit exactly `orr x21, x20, #0xff00`"
	}
	if !logicGolden_aa64test(iropcode.OP_XOR, 1, cast(int64, -4294967296), types.TypInt(), 0xD2607E95,
			z) {
		return "int XOR #0xffffffff00000000 must emit exactly `eor x21, x20, #0xffffffff00000000`"
	}
	return ""
}

// W-form immediates for a uint32 op, matching clang, with no re-narrow (the
// W-form op self-clears bits [32,64), as on the register path): `and w21, w20,
// #0xf000000f` (0x12041E95), `orr w21, w20, #0xff00ff` (0x32009E95) and `eor w21,
// w20, #0xfffffff0` (0x521C6E95).
func TestEmitBinopLogicImmFoldWFormGoldens() testing.TestResult {
	var z uint32 = 0
	if !logicGolden_aa64test(iropcode.OP_AND, 1, cast(int64, 0xF000000F), types.TypUint32(),
			0x12041E95, z) {
		return "uint32 AND #0xf000000f must emit exactly `and w21, w20, #0xf000000f`"
	}
	if !logicGolden_aa64test(iropcode.OP_OR, 1, cast(int64, 0x00FF00FF), types.TypUint32(), 0x32009E95,
			z) {
		return "uint32 OR #0xff00ff must emit exactly `orr w21, w20, #0xff00ff`"
	}
	if !logicGolden_aa64test(iropcode.OP_XOR, 0, cast(int64, 0xFFFFFFF0), types.TypUint32(),
			0x521C6E95, z) {
		return "uint32 XOR #0xfffffff0 must emit exactly `eor w21, w20, #0xfffffff0`"
	}
	return ""
}

// An XOR with all-ones at the op width lowers to MVN, matching clang: `mvn x21,
// x20` (0xAA3403F5) for an int, `mvn w21, w20` (0x2A3403F5) for a uint32, on
// either operand side.
func TestEmitBinopLogicImmFoldXorAllOnesMvn() testing.TestResult {
	var z uint32 = 0
	if !logicGolden_aa64test(iropcode.OP_XOR, 1, cast(int64, -1), types.TypInt(), 0xAA3403F5, z) {
		return "int XOR #-1 must emit exactly `mvn x21, x20`"
	}
	if !logicGolden_aa64test(iropcode.OP_XOR, 0, cast(int64, -1), types.TypInt(), 0xAA3403F5, z) {
		return "int XOR with a constant LHS -1 must emit exactly `mvn x21, x20`"
	}
	if !logicGolden_aa64test(iropcode.OP_XOR, 1, cast(int64, 0xFFFFFFFF), types.TypUint32(),
			0x2A3403F5, z) {
		return "uint32 XOR #0xffffffff must emit exactly `mvn w21, w20`"
	}
	return ""
}

// A sub-word result runs the X form and is re-narrowed, matching clang: int32
// AND #-16 is `and x21, x20, #0xfffffffffffffff0` + `sxtw x21, w21` (0x927CEE95,
// 0x93407EB5); int8 XOR #1 is `eor x21, x20, #0x1` + `sxtb x21, w21`
// (0xD2400295, 0x93401EB5); int8 XOR #-1 is `mvn x21, x20` + `sxtb`.
func TestEmitBinopLogicImmFoldSubWordGoldens() testing.TestResult {
	if !logicGolden_aa64test(iropcode.OP_AND, 1, cast(int64, -16), types.TypInt32(), 0x927CEE95,
			0x93407EB5) {
		return "int32 AND #-16 must emit exactly `and x21, x20, #-16` + `sxtw x21, w21`"
	}
	if !logicGolden_aa64test(iropcode.OP_XOR, 1, cast(int64, 1), types.TypInt8(), 0xD2400295,
			0x93401EB5) {
		return "int8 XOR #1 must emit exactly `eor x21, x20, #0x1` + `sxtb x21, w21`"
	}
	if !logicGolden_aa64test(iropcode.OP_XOR, 1, cast(int64, -1), types.TypInt8(), 0xAA3403F5,
			0x93401EB5) {
		return "int8 XOR #-1 must emit exactly `mvn x21, x20` + `sxtb x21, w21`"
	}
	return ""
}

// sameNarrow_aa64test reports whether the FoldedImm lowering of `op` (constant v,
// type t) emits the same instructions after its first as the register path over
// the same operands: the re-narrow is exactly the register path's.
func sameNarrow_aa64test(op int, v int64, t @types.Type) bool {
	var fa @asm.Assembler
	var ra @asm.Assembler
	var ok bool
	fa, ok = logicFold_aa64test(op, 1, v, t, true)
	if !ok || fa.HasError { return false }
	ra, ok = logicFold_aa64test(op, 1, v, t, false)
	if !ok || ra.HasError { return false }
	var n int = fa.Sections[0].Len
	if n != ra.Sections[0].Len || n < 4 { return false }
	for i := 1; i < n / 4; i++ {
		if foldWord_aa64test(fa, i) != foldWord_aa64test(ra, i) { return false }
	}
	return true
}

// Every sub-word width re-narrows exactly as the register path does (sxtb/sxth/
// sxtw, uxtb/uxth), and a uint32 / host-word op emits no narrow on either path.
func TestEmitBinopLogicImmFoldNarrowMatchesRegisterPath() testing.TestResult {
	if !sameNarrow_aa64test(iropcode.OP_AND, cast(int64, 0x0F), types.TypInt8()) {
		return "int8 AND #0xf must re-narrow like the register path"
	}
	if !sameNarrow_aa64test(iropcode.OP_OR, cast(int64, 0xF0), types.TypUint8()) {
		return "uint8 OR #0xf0 must re-narrow like the register path"
	}
	if !sameNarrow_aa64test(iropcode.OP_XOR, cast(int64, -1), types.TypInt16()) {
		return "int16 XOR #-1 (MVN) must re-narrow like the register path"
	}
	if !sameNarrow_aa64test(iropcode.OP_AND, cast(int64, 0xFF0), types.TypUint16()) {
		return "uint16 AND #0xff0 must re-narrow like the register path"
	}
	if !sameNarrow_aa64test(iropcode.OP_OR, cast(int64, -16), types.TypInt32()) {
		return "int32 OR #-16 must re-narrow like the register path"
	}
	if !sameNarrow_aa64test(iropcode.OP_XOR, cast(int64, 0xFF), types.TypUint32()) {
		return "uint32 XOR #0xff must match the register path (no narrow)"
	}
	if !sameNarrow_aa64test(iropcode.OP_AND, cast(int64, 0xFF), types.TypInt()) {
		return "int AND #0xff must match the register path (no narrow)"
	}
	return ""
}

// unfitLogic_aa64test reports whether a FoldedImm logical op that the fold
// could not have marked is rejected by the emitter's own fit check (its error
// message, not an encoder's), is treated as handled, and encodes nothing —
// neither a mis-encoded immediate nor a register op reading the never-
// materialized constant.
func unfitLogic_aa64test(op int, v int64, t @types.Type) bool {
	var a @asm.Assembler
	var ok bool
	a, ok = logicFold_aa64test(op, 1, v, t, true)
	return errIs_aa64test(a, "native arm64: folded immediate does not fit the logical op") && ok &&
			a.Sections[0].Len == 0
}

// A FoldedImm AND/OR/XOR constant that is no bitmask at the op width is an
// analysis/emitter mismatch and fails loud: an irregular X-form value, zero, an
// all-ones OR at the W width, and a W-form-only mask on an X-form op.
func TestEmitBinopLogicImmFoldUnfitFailsLoud() testing.TestResult {
	if !unfitLogic_aa64test(iropcode.OP_AND, cast(int64, 0x1234), types.TypInt()) {
		return "a folded AND #0x1234 must SetError and emit nothing"
	}
	if !unfitLogic_aa64test(iropcode.OP_OR, cast(int64, 0), types.TypInt()) {
		return "a folded OR #0 must SetError and emit nothing"
	}
	if !unfitLogic_aa64test(iropcode.OP_OR, cast(int64, 0xFFFFFFFF), types.TypUint32()) {
		return "a folded uint32 OR #0xffffffff must SetError and emit nothing"
	}
	if !unfitLogic_aa64test(iropcode.OP_AND, cast(int64, 0xF000000F), types.TypUint64()) {
		return "a folded uint64 AND #0xf000000f must SetError and emit nothing"
	}
	return ""
}

// A FoldedImm constant whose sibling is also a constant (a position the fold
// never marks) fails loud rather than reading the sibling as the register.
func TestEmitBinopLogicFoldedConstSiblingFailsLoud() testing.TestResult {
	var m @common.RegMap
	var ins @ir.Instr
	m, ins = logicIns_aa64test(iropcode.OP_AND, 1, cast(int64, 0xFF), types.TypInt(), true)
	ins.Args[0].Op = iropcode.OP_CONST_INT
	var a @asm.Assembler = opsMkAssembler()
	var ok bool = emitBinop(a, m, ins)
	if !errIs_aa64test(a, "native arm64: folded immediate does not fit the logical op") || !ok {
		return "a folded AND constant with a constant sibling must fail the emitter's fit check"
	}
	if a.Sections[0].Len != 0 { return "a folded const-const AND must emit nothing" }
	return ""
}

// noRegLogic_aa64test lowers logicIns_aa64test's folded AND (0xff on the RHS),
// tst-folded when tst, with its register operand (id 1) unmapped — neither
// homed, cached nor spilled — so getOperand cannot resolve it.
func noRegLogic_aa64test(tst bool) (@asm.Assembler, bool) {
	var m @common.RegMap
	var ins @ir.Instr
	m, ins = logicIns_aa64test(iropcode.OP_AND, 1, cast(int64, 0xFF), types.TypInt(), true)
	m.HomeIDs[0] = 99
	if tst {
		var tf @[]bool = make_slice(bool, 4)
		tf[3] = true
		m.TstFoldedAnd = tf
	}
	var a @asm.Assembler = opsMkAssembler()
	var ok bool = emitBinop(a, m, ins)
	return a, ok
}

// A fitting folded constant whose register operand cannot be resolved fails
// loud with the emitter's own message and emits nothing, for the logical op and
// the tst-fold alike.
func TestEmitBinopLogicImmFoldNoRegisterFailsLoud() testing.TestResult {
	var a @asm.Assembler
	var ok bool
	var msg *[]readonly char = "native arm64: logical op with a folded immediate has no register opera"
			"nd"
	a, ok = noRegLogic_aa64test(false)
	if !errIs_aa64test(a, msg) || !ok {
		return "a folded AND with an unresolvable register operand must fail loud"
	}
	if a.Sections[0].Len != 0 { return "an AND with no register operand must emit nothing" }
	msg = "native arm64: tst with a folded immediate has no register operand"
	a, ok = noRegLogic_aa64test(true)
	if !errIs_aa64test(a, msg) || !ok {
		return "a tst-folded AND with an unresolvable register operand must fail loud"
	}
	if a.Sections[0].Len != 0 { return "a tst with no register operand must emit nothing" }
	return ""
}

// ---- Logical immediate fold: the tst-fold ----

// tstFold_aa64test lowers a tst-folded AND (m.TstFoldedAnd) through emitBinop,
// built like logicIns_aa64test.
func tstFold_aa64test(constIdx int, v int64, t @types.Type, folded bool) (@asm.Assembler, bool) {
	var m @common.RegMap
	var ins @ir.Instr
	m, ins = logicIns_aa64test(iropcode.OP_AND, constIdx, v, t, folded)
	var tf @[]bool = make_slice(bool, 4)
	tf[3] = true
	m.TstFoldedAnd = tf
	var a @asm.Assembler = opsMkAssembler()
	var ok bool = emitBinop(a, m, ins)
	return a, ok
}

// tstGolden_aa64test reports whether the tst-folded AND emits exactly word w.
func tstGolden_aa64test(constIdx int, v int64, t @types.Type, folded bool, w uint32) bool {
	var a @asm.Assembler
	var ok bool
	a, ok = tstFold_aa64test(constIdx, v, t, folded)
	if !ok || a.HasError || a.Sections[0].Len != 4 { return false }
	return foldWord_aa64test(a, 0) == w
}

// A tst-folded AND with a FoldedImm constant emits TST #imm at the aa64LogicImm
// width and value, matching clang: `tst x20, #0xff` (0xF2401E9F, either operand
// side), `tst w20, #0xf000000f` for a uint32 (0x72041E9F), and `tst x20,
// #0xfffffffffffffff0` for an int32 -16 (0xF27CEE9F).  With the constant in a
// register it keeps the register form, `tst x20, x22` (0xEA16029F).
func TestEmitBinopTstImmFoldGoldens() testing.TestResult {
	if !tstGolden_aa64test(1, cast(int64, 0xFF), types.TypInt(), true, 0xF2401E9F) {
		return "a tst-folded AND #0xff must emit exactly `tst x20, #0xff`"
	}
	if !tstGolden_aa64test(0, cast(int64, 0xFF), types.TypInt(), true, 0xF2401E9F) {
		return "a tst-folded AND with a constant LHS 0xff must emit exactly `tst x20, #0xff`"
	}
	if !tstGolden_aa64test(1, cast(int64, 0xF000000F), types.TypUint32(), true, 0x72041E9F) {
		return "a tst-folded uint32 AND #0xf000000f must emit exactly `tst w20, #0xf000000f`"
	}
	if !tstGolden_aa64test(1, cast(int64, -16), types.TypInt32(), true, 0xF27CEE9F) {
		return "a tst-folded int32 AND #-16 must emit exactly `tst x20, #-16`"
	}
	if !tstGolden_aa64test(1, cast(int64, 0xFF), types.TypInt(), false, 0xEA16029F) {
		return "a tst-folded AND over registers must emit exactly `tst x20, x22`"
	}
	return ""
}

// A tst-folded AND whose FoldedImm constant is no bitmask fails loud and emits
// nothing — neither a TST immediate nor a register TST reading the
// never-materialized constant.
func TestEmitBinopTstImmFoldUnfitFailsLoud() testing.TestResult {
	var a @asm.Assembler
	var ok bool
	var msg *[]readonly char = "native arm64: folded immediate does not fit the tst"
	a, ok = tstFold_aa64test(1, cast(int64, 0x1234), types.TypInt(), true)
	if !errIs_aa64test(a, msg) || !ok { return "a tst-folded AND #0x1234 must fail the tst fit check" }
	if a.Sections[0].Len != 0 { return "an unfit tst fold must emit nothing" }
	a, ok = tstFold_aa64test(1, cast(int64, 0xFFFFFFFF), types.TypUint32(), true)
	if !errIs_aa64test(a, msg) || !ok {
		return "a tst-folded uint32 AND #0xffffffff must fail the tst fit check"
	}
	if a.Sections[0].Len != 0 { return "an unfit W-form tst fold must emit nothing" }
	return ""
}

// logicWordCount_aa64test counts the text words w with (w & mask) == want.
func logicWordCount_aa64test(a @asm.Assembler, mask uint32, want uint32) int {
	var n int = 0
	for i := 0; i < a.Sections[0].Len / 4; i++ {
		if (foldWord_aa64test(a, i) & mask) == want { n = n + 1 }
	}
	return n
}

// emitFunc wires the logical fold end to end, with the tst-fold: in
// `if (x & 0xff) == 0 { return x ^ 0xff00 } return x | 1`, no constant is
// materialized (no `movz #0xff` / `#0xff00` / `#1`), the AND rides `tst xN,
// #0xff`, the XOR `eor xD, xN, #0xff00` and the OR `orr xD, xN, #0x1`.
func TestEmitFuncFoldsLogicImmediates() testing.TestResult {
	setTarget64()
	var p @ir.Param = make(ir.Param)
	p.Name = "x"
	p.Typ = types.TypInt()
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = p
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "test.logicfold", params, results)
	var x @ir.Instr = irbuild.NewParamRef(f, p)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var elseB @ir.Block = ir.AddBlock(f, "else")
	var cMask @ir.Instr = irbuild.EmitConstInt(entry, 0xFF, types.TypInt())
	var masked @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_AND, x, cMask, types.TypInt())
	var c0 @ir.Instr = irbuild.EmitConstInt(entry, 0, types.TypInt())
	var isZero @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_EQ, masked, c0, types.TypBool())
	irbuild.EmitBranch(entry, isZero, thenB, elseB)
	var cHi @ir.Instr = irbuild.EmitConstInt(thenB, 0xFF00, types.TypInt())
	var flipped @ir.Instr = irbuild.EmitBinop(thenB, iropcode.OP_XOR, x, cHi, types.TypInt())
	var r1 @[]@ir.Instr = make_slice(@ir.Instr, 1)
	r1[0] = flipped
	irbuild.EmitReturn(thenB, r1)
	var c1 @ir.Instr = irbuild.EmitConstInt(elseB, 1, types.TypInt())
	var ored @ir.Instr = irbuild.EmitBinop(elseB, iropcode.OP_OR, x, c1, types.TypInt())
	var r2 @[]@ir.Instr = make_slice(@ir.Instr, 1)
	r2[0] = ored
	irbuild.EmitReturn(elseB, r2)

	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var strings @[]ir.StringConst
	emitFunc(a, "test", f, strings)
	if a.HasError { return "emitFunc must lower the logic-folded function without error" }
	// MOVZ (64-bit) with Rd masked out: 0xD2800000 | imm16 << 5.
	if logicWordCount_aa64test(a, 0xFFFFFFE0, 0xD2801FE0) != 0 {
		return "the folded constant 0xff must NOT be materialized (movz #0xff)"
	}
	if logicWordCount_aa64test(a, 0xFFFFFFE0, 0xD29FE000) != 0 {
		return "the folded constant 0xff00 must NOT be materialized (movz #0xff00)"
	}
	if logicWordCount_aa64test(a, 0xFFFFFFE0, 0xD2800020) != 0 {
		return "the folded constant 1 must NOT be materialized (movz #1)"
	}
	// Rn (bits [9:5]) masked out; TST writes XZR (Rd 31).
	if logicWordCount_aa64test(a, 0xFFFFFC1F, 0xF2401C1F) != 1 {
		return "(x & 0xff) == 0 must ride `tst xN, #0xff`"
	}
	// Rn and Rd (bits [9:0]) masked out.
	if logicWordCount_aa64test(a, 0xFFFFFC00, 0xD2781C00) != 1 {
		return "x ^ 0xff00 must ride `eor xD, xN, #0xff00`"
	}
	if logicWordCount_aa64test(a, 0xFFFFFC00, 0xB2400000) != 1 {
		return "x | 1 must ride `orr xD, xN, #0x1`"
	}
	return ""
}
