package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"

// Constant multiply/divide/modulo strength reduction.  When the second operand
// of an OP_MUL / OP_DIV / OP_REM is a compile-time constant, emit a specialized
// sequence — a magic-number multiply (Granlund-Montgomery, via
// common.ComputeMagic*) instead of a hardware `sdiv`/`udiv`, or a shift for a
// power-of-two divisor, or a bare move/neg for ±1 — instead of the generic
// register form.  aarch64 works at 64 bits: operands are kept sign/zero-extended
// to the host word, so a 64-bit magic divide of the extended value equals the
// true (possibly sub-word) divide, and the caller re-narrows the result.

// wordW is the width the multiply-high is taken at on aarch64.
const wordW int = 64

// constDivisor returns (value, true) when ins's second operand is a compile-time
// integer constant.
func constDivisor(ins @ir.Instr) (int64, bool) {
	if len(ins.Args) != 2 {
		return cast(int64, 0), false
	}
	var b @ir.Instr = ins.Args[1]
	if b == nil || b.Op != iropcode.OP_CONST_INT {
		return cast(int64, 0), false
	}
	return b.IntVal, true
}

// pow2Log returns k when v == 2^k for k in [1, 63], else -1 (v == 1 is caller-
// handled as a move, not a shift).
func pow2Log(v uint64) int {
	if v == cast(uint64, 0) || (v & (v - cast(uint64, 1))) != cast(uint64, 0) {
		return -1
	}
	var k int = 0
	var x uint64 = v
	for x > cast(uint64, 1) {
		x = x >> cast(uint64, 1)
		k = k + 1
	}
	return k
}

// absU64 returns |c| as a uint64.
func absU64(c int64) uint64 {
	if c < cast(int64, 0) {
		return cast(uint64, 0) - cast(uint64, c)
	}
	return cast(uint64, c)
}

// emitConstMulDiv dispatches the constant-operand fast path.  Returns true when
// it emitted a specialized sequence; false to fall through to the generic form.
func emitConstMulDiv(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr, lhs int, rd int, c int64,
		isUnsigned bool) bool {
	if ins.Op == iropcode.OP_MUL {
		return emitConstMul(a, lhs, rd, c)
	}
	if ins.Op == iropcode.OP_DIV {
		return emitConstDiv(a, rm, lhs, rd, c, isUnsigned)
	}
	if ins.Op == iropcode.OP_REM {
		return emitConstRem(a, rm, ins, lhs, rd, c, isUnsigned)
	}
	return false
}

// emitConstMul reduces `lhs * c`: 0 -> zero, 1 -> move, -1 -> neg, ±2^k ->
// shift (+ neg).  A general constant falls through to the register multiply.
func emitConstMul(a @asm.Assembler, lhs int, rd int, c int64) bool {
	if c == cast(int64, 0) {
		aarch64.Mov(a, true, rd, aarch64.Imm(0))
		return true
	}
	if c == cast(int64, 1) {
		aarch64.Mov(a, true, rd, aarch64.Reg(lhs))
		return true
	}
	if c == cast(int64, -1) {
		aarch64.Neg(a, true, rd, aarch64.Reg(lhs))
		return true
	}
	var k int = pow2Log(absU64(c))
	if k >= 1 {
		aarch64.Lsl(a, true, rd, lhs, aarch64.Imm(k))
		if c < cast(int64, 0) {
			aarch64.Neg(a, true, rd, aarch64.Reg(rd))
		}
		return true
	}
	return false
}

// emitConstDiv reduces `lhs / c` (c != 0).
func emitConstDiv(a @asm.Assembler, rm @common.RegMap, lhs int, rd int, c int64,
		isUnsigned bool) bool {
	if c == cast(int64, 0) {
		return false
	}
	if isUnsigned {
		return emitConstUDiv(a, rm, lhs, rd, cast(uint64, c))
	}
	return emitConstSDiv(a, rm, lhs, rd, c)
}

// emitConstUDiv writes `lhs / d` (unsigned) into rd.
func emitConstUDiv(a @asm.Assembler, rm @common.RegMap, lhs int, rd int, d uint64) bool {
	if d == cast(uint64, 1) {
		aarch64.Mov(a, true, rd, aarch64.Reg(lhs))
		return true
	}
	var k int = pow2Log(d)
	if k >= 1 {
		aarch64.Lsr(a, true, rd, lhs, aarch64.Imm(k))
		return true
	}
	var mg common.MagicUnsigned = common.ComputeMagicUnsigned(d, wordW)
	// The magic sequence reads lhs after writing its accumulator, so compute
	// into a scratch when rd would alias lhs.
	var q int = rd
	if q == lhs {
		q = scratchReg(rm)
	}
	var mreg int = scratchReg(rm)
	emitConstInt64(a, mreg, cast(int64, mg.M))
	aarch64.Umulh(a, q, mreg, lhs)
	if !mg.Add {
		if mg.Shift > 0 {
			aarch64.Lsr(a, true, q, q, aarch64.Imm(mg.Shift))
		}
	} else {
		var t int = scratchReg(rm)
		aarch64.Sub(a, true, t, lhs, aarch64.Reg(q))
		aarch64.Lsr(a, true, t, t, aarch64.Imm(1))
		aarch64.Add(a, true, t, t, aarch64.Reg(q))
		if mg.Shift - 1 > 0 {
			aarch64.Lsr(a, true, q, t, aarch64.Imm(mg.Shift - 1))
		} else {
			aarch64.Mov(a, true, q, aarch64.Reg(t))
		}
	}
	if q != rd {
		aarch64.Mov(a, true, rd, aarch64.Reg(q))
	}
	return true
}

// emitConstSDiv writes `lhs / d` (signed) into rd.
func emitConstSDiv(a @asm.Assembler, rm @common.RegMap, lhs int, rd int, d int64) bool {
	if d == cast(int64, 1) {
		aarch64.Mov(a, true, rd, aarch64.Reg(lhs))
		return true
	}
	if d == cast(int64, -1) {
		aarch64.Neg(a, true, rd, aarch64.Reg(lhs))
		return true
	}
	var k int = pow2Log(absU64(d))
	if k >= 1 {
		emitSignedPow2Div(a, rm, lhs, rd, k, d < cast(int64, 0))
		return true
	}
	var mg common.MagicSigned = common.ComputeMagicSigned(d, wordW)
	var q int = rd
	if q == lhs {
		q = scratchReg(rm)
	}
	var mreg int = scratchReg(rm)
	emitConstInt64(a, mreg, mg.M)
	aarch64.Smulh(a, q, mreg, lhs)
	if mg.AddN {
		aarch64.Add(a, true, q, q, aarch64.Reg(lhs))
	}
	if mg.SubN {
		aarch64.Sub(a, true, q, q, aarch64.Reg(lhs))
	}
	if mg.Shift > 0 {
		aarch64.Asr(a, true, q, q, aarch64.Imm(mg.Shift))
	}
	// Round toward zero: add the sign bit (logical-shift-right by W-1 is 1 iff q<0).
	aarch64.Add(a, true, q, q, aarch64.RegShift(q, aarch64.LSR, wordW - 1))
	if q != rd {
		aarch64.Mov(a, true, rd, aarch64.Reg(q))
	}
	return true
}

// emitSignedPow2Div writes signed `lhs / (±2^k)` into rd (k >= 1).  Adds the
// round-toward-zero bias (2^k - 1 for a negative dividend, 0 otherwise) before
// the arithmetic shift, then negates for a negative divisor.  tmp is a scratch,
// and rd is written only by the final shift/neg, so rd may alias lhs.
func emitSignedPow2Div(a @asm.Assembler, rm @common.RegMap, lhs int, rd int, k int, neg bool) {
	var tmp int = scratchReg(rm)
	if k == 1 {
		aarch64.Lsr(a, true, tmp, lhs, aarch64.Imm(wordW - 1))
	} else {
		aarch64.Asr(a, true, tmp, lhs, aarch64.Imm(k - 1))
		aarch64.Lsr(a, true, tmp, tmp, aarch64.Imm(wordW - k))
	}
	aarch64.Add(a, true, tmp, lhs, aarch64.Reg(tmp))
	aarch64.Asr(a, true, rd, tmp, aarch64.Imm(k))
	if neg {
		aarch64.Neg(a, true, rd, aarch64.Reg(rd))
	}
}

// emitConstRem writes `lhs % c` into rd.  n % (±1) is 0; unsigned power-of-two
// is a low-bit mask; otherwise compute the quotient and back out the remainder
// with MSUB (r = n - q*c), reusing the constant divisor's own register.
func emitConstRem(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr, lhs int, rd int, c int64,
		isUnsigned bool) bool {
	if c == cast(int64, 0) {
		return false
	}
	if c == cast(int64, 1) || c == cast(int64, -1) {
		aarch64.Mov(a, true, rd, aarch64.Imm(0))
		return true
	}
	if isUnsigned {
		var k int = pow2Log(cast(uint64, c))
		if k >= 1 {
			// n mod 2^k == low k bits == (n << (W-k)) >>logical (W-k)
			aarch64.Lsl(a, true, rd, lhs, aarch64.Imm(wordW - k))
			aarch64.Lsr(a, true, rd, rd, aarch64.Imm(wordW - k))
			return true
		}
	}
	var qreg int = scratchReg(rm)
	var ok bool
	if isUnsigned {
		ok = emitConstUDiv(a, rm, lhs, qreg, cast(uint64, c))
	} else {
		ok = emitConstSDiv(a, rm, lhs, qreg, c)
	}
	if !ok {
		return false
	}
	// Reuse the divisor's materialized register (the OP_CONST_INT operand); fall
	// back to a fresh materialization if it is not currently mapped.
	var dreg int = getOperand(a, rm, ins.Args[1].ID)
	if dreg < 0 {
		dreg = scratchReg(rm)
		emitConstInt64(a, dreg, c)
	}
	aarch64.Msub(a, true, rd, qreg, dreg, lhs)
	return true
}
