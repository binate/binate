package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Fixed-bit signatures (Rm[20:16], Rn[9:5], Rd[4:0] masked out via 0xFFE0FC00).
const opMask uint32 = 0xFFE0FC00

const sdiv64 uint32 = 0x9AC00C00

const udiv64 uint32 = 0x9AC00800

const smulh uint32 = 0x9B407C00

const umulh uint32 = 0x9BC07C00

const mul64 uint32 = 0x9B007C00 // MADD with Ra = XZR

func countOpWord(a @asm.Assembler, fixed uint32) int {
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var count int = 0
	for i := 0; i + 4 <= n; i = i + 4 {
		var w uint32 = cast(uint32, data[i]) | (cast(uint32, data[i + 1]) << 8) |
				(cast(uint32, data[i + 2]) << 16) | (cast(uint32, data[i + 3]) << 24)
		if (w & opMask) == fixed { count = count + 1 }
	}
	return count
}

// emitConstBinop builds `lhs <op> C` with a constant second operand and emits it.
// lhs is spilled id 1, the constant is id 2, the result id 3.
func emitConstBinop(op int, t @types.Type, c int64) @asm.Assembler {
	setTarget64()
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = t
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Op = iropcode.OP_CONST_INT
	rhs.IntVal = c
	rhs.Typ = t
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = op
	ins.Typ = t
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	emitBinop(a, m, ins)
	return a
}

// Signed constant division by a non-power-of-two uses the SMULH magic multiply,
// never a hardware SDIV.
func TestConstSignedDivMagic() testing.TestResult {
	var a @asm.Assembler = emitConstBinop(iropcode.OP_DIV, types.TypInt(), cast(int64, 139968))
	if countOpWord(a, smulh) < 1 {
		return "signed const DIV should emit SMULH"
	}
	if countOpWord(a, sdiv64) != 0 {
		return "signed const DIV must NOT emit a hardware SDIV"
	}
	return ""
}

// Unsigned constant division uses UMULH, never a hardware UDIV.
func TestConstUnsignedDivMagic() testing.TestResult {
	var a @asm.Assembler = emitConstBinop(iropcode.OP_DIV, types.TypUint64(), cast(int64, 139968))
	if countOpWord(a, umulh) < 1 {
		return "unsigned const DIV should emit UMULH"
	}
	if countOpWord(a, udiv64) != 0 {
		return "unsigned const DIV must NOT emit a hardware UDIV"
	}
	return ""
}

// Signed constant modulo backs the remainder out with MSUB after the magic
// quotient — still no SDIV.
func TestConstRemMagic() testing.TestResult {
	var a @asm.Assembler = emitConstBinop(iropcode.OP_REM, types.TypInt(), cast(int64, 139968))
	if countOpWord(a, smulh) < 1 {
		return "signed const REM should emit SMULH for the quotient"
	}
	if countOpWord(a, sdiv64) != 0 {
		return "signed const REM must NOT emit a hardware SDIV"
	}
	return ""
}

// Multiply by 1 is strength-reduced to a move — no MUL/MADD.
func TestConstMulByOneNoMul() testing.TestResult {
	var a @asm.Assembler = emitConstBinop(iropcode.OP_MUL, types.TypInt(), cast(int64, 1))
	if countOpWord(a, mul64) != 0 {
		return "multiply by 1 must NOT emit a MUL"
	}
	return ""
}

// Multiply by a power of two uses a shift, not a MUL.
func TestConstMulByPow2NoMul() testing.TestResult {
	var a @asm.Assembler = emitConstBinop(iropcode.OP_MUL, types.TypInt(), cast(int64, 8))
	if countOpWord(a, mul64) != 0 {
		return "multiply by 8 must NOT emit a MUL (uses LSL)"
	}
	return ""
}

// Regression guard: a VARIABLE (non-constant) divisor still lowers to SDIV — the
// magic path must not swallow the generic form.
func TestVariableDivStillSdiv() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_DIV
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	emitBinop(a, m, ins)
	if countOpWord(a, sdiv64) != 1 {
		return "variable-divisor DIV must still emit SDIV"
	}
	return ""
}
