package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// ============================================================
// Name helpers
// ============================================================

// symFor mangles a Binate (pkgName, funcName) pair to a symbol name,
// routing through symPrefixed so the object-format linkage convention
// (Mach-O '_' vs ELF bare) is applied in exactly one place.
func symFor(pkgName *[]readonly char, funcName *[]readonly char) @[]char {
	var mangled @[]char = mangle.FuncName(pkgName, funcName)
	return symPrefixed(mangled)
}

// globalSymFor mangles a package-level variable to its Mach-O symbol
// ('_' + `bn_G...`). Different from symFor because globals go
// through mangle.GlobalName (no special case for main.main).
func globalSymFor(pkgName *[]readonly char, name *[]readonly char) @[]char {
	var mangled @[]char = mangle.GlobalName(pkgName, name)
	return symPrefixed(mangled)
}

// isGlobalRef reports whether ins is the pseudo-Instr the IR produces
// for a package-level variable reference. Uses Instr.IsGlobalRef
// (set by lookupVar's global-fallback path) — a name-based check
// would falsely match local allocas whose variable name collides
// with a global. These reach their address via ADRP+ADD
// (cross-segment) rather than SP-relative allocas or spill reloads.
func isGlobalRef(ins @ir.Instr) bool {
	if ins == nil { return false }
	return ins.IsGlobalRef
}

// emitGlobalAddr emits the ADRP+ADD pair that places the runtime
// address of a package-level variable in rd. The two fixups
// (FIX_ADRP_HI21 → PAGE21, FIX_ADD_LO12 → PAGEOFF12) let the linker
// resolve the cross-segment address to __DATA.
func emitGlobalAddr(a @asm.Assembler, pkgName *[]readonly char, rd int, ins @ir.Instr) {
	var label @[]char = globalSymFor(pkgName, ins.StrVal)
	a.SetGlobal(label)
	aarch64.Adrp(a, rd, label)
	aarch64.AddImmLabel(a, true, rd, rd, label)
}

// objEmitElf selects the object-format linkage convention for
// symPrefixed: false (the zero value) keeps the Mach-O leading-'_'
// that is this backend's default on macOS; true emits ELF-bare
// symbols.  EmitObject sets it from the target object format and
// restores false on exit, so direct symFor/globalSymFor callers
// (e.g. the name unit tests) always see the Mach-O default.  Phase 4
// of plan-backend-objformat-decoupling.md.  (amd64 uses the inverse
// default — ELF/bare — because that's its native format; see
// objSymPrefix there.)
var objEmitElf bool

// symPrefixed applies the active object-format symbol-linkage prefix
// to an already-mangled name: the Mach-O leading '_' unless ELF is
// active.  This is the single place arm64 applies the prefix —
// symFor, globalSymFor, runtime-helper refs, and vtable/handle
// labels all route through it.
func symPrefixed(s *[]readonly char) @[]char {
	var out @strings.Builder = strings.NewBuilder()
	if !objEmitElf {
		out.Write("_")
	}
	out.Write(s)
	return buf.CopyStr(out.String())
}

// handleSymFor returns the Mach-O label for the LLVM-shape handle global
// `___handle.<mangled-fn>`.  Mirrors the @__handle.<mangled> globals
// pkg/binate/codegen emits via emitFuncValueHandle so cross-mode references
// (compiled-side function-value handle consumed by an aa64-emitted main,
// or vice versa) resolve to a single weak_odr definition at link time.
// Phase 4 of plan-uniform-native-fnptrs.md.
func handleSymFor(pkgName *[]readonly char, funcName *[]readonly char) @[]char {
	var mangled @[]char = mangle.FuncName(pkgName, funcName)
	var out @strings.Builder = strings.NewBuilder()
	out.Write("___handle.")
	out.Write(mangled)
	return buf.CopyStr(out.String())
}

// argReg returns the AArch64 register that carries the i-th integer
// arg under the Procedure Call Standard (X0..X7).
func argReg(i int) int {
	if i == 0 { return aarch64.X0 }
	if i == 1 { return aarch64.X1 }
	if i == 2 { return aarch64.X2 }
	if i == 3 { return aarch64.X3 }
	if i == 4 { return aarch64.X4 }
	if i == 5 { return aarch64.X5 }
	if i == 6 { return aarch64.X6 }
	return aarch64.X7
}

// stringLabel is the local asm label for string constant <id>.
func stringLabel(id int) @[]char {
	var out @strings.Builder = strings.NewBuilder()
	out.Write("Lstr_")
	stringutils.WriteInt(out, id)
	return buf.CopyStr(out.String())
}

// stringMSSym is the module-qualified WEAK symbol for string constant <id>'s
// static managed-slice header.  Unlike the byte blob (a same-segment-local
// `Lstr_<id>` label, resolvable at assembly time), the `.ms` carries a
// relocation so it lives in the `data` segment; a `data` symbol reached from
// text via ADRP+ADD must be a symbol-table entry, so it goes through the global
// mangler (module-qualified → two modules' string 0 don't collide).
func stringMSSym(pkgName *[]readonly char, id int) @[]char {
	var nm @strings.Builder = strings.NewBuilder()
	nm.Write("__strms_")
	stringutils.WriteInt(nm, id)
	return symPrefixed(mangle.GlobalName(pkgName, nm.String()))
}

// blockLabel mints a function-scoped label name for a basic block.
// The 'L' prefix keeps it out of the exported symbol list.
func blockLabel(funcSym @[]char, blockLabel @[]char) @[]char {
	var out @strings.Builder = strings.NewBuilder()
	out.Write("L")
	out.Write(funcSym)
	out.Write("__")
	out.Write(blockLabel)
	return buf.CopyStr(out.String())
}

// stripQuotes strips surrounding '"' from a string (if present).
func stripQuotes(s *[]readonly char) *[]readonly char {
	if len(s) >= 2 && s[0] == '"' && s[len(s) - 1] == '"' {
		return s[1:len(s) - 1]
	}
	return s
}
