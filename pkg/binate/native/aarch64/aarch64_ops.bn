package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Binary / unary / compare ops
// ============================================================

// emitSubWordNarrow re-reduces rd to t's value range after a
// width-agnostic op computed it in a full 64-bit register: sign-extend
// (signed) or zero-extend (unsigned) from the type's width.  A no-op for
// host-word-wide or non-integer types.  common.SubWordNarrow is the one
// classifier shared with the VM and x64 backend.
func emitSubWordNarrow(a @asm.Assembler, rd int, t @types.Type) {
	var w int
	var signed bool
	w, signed = common.SubWordNarrow(t, 64)
	if w == 0 { return }
	if signed {
		if w == 8 { aarch64.Sxtb(a, true, rd, rd); return }
		if w == 16 { aarch64.Sxth(a, true, rd, rd); return }
		aarch64.Sxtw(a, rd, rd)
		return
	}
	if w == 8 { aarch64.Uxtb(a, rd, rd); return }
	if w == 16 { aarch64.Uxth(a, rd, rd); return }
	aarch64.Uxtw(a, rd, rd)
}

// emitBinop handles the integer arithmetic, bitwise, and shift ops.
// Returns true if it matched and emitted code; false otherwise.
func emitBinop(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_ADD &&
		ins.Op != iropcode.OP_SUB &&
		ins.Op != iropcode.OP_MUL &&
		ins.Op != iropcode.OP_DIV &&
		ins.Op != iropcode.OP_REM &&
		ins.Op != iropcode.OP_AND &&
		ins.Op != iropcode.OP_OR  &&
		ins.Op != iropcode.OP_XOR &&
		ins.Op != iropcode.OP_SHL &&
		ins.Op != iropcode.OP_SHR &&
		ins.Op != iropcode.OP_LAND &&
		ins.Op != iropcode.OP_LOR {
		return false
	}
	if len(ins.Args) != 2 { return false }

	// Float arithmetic: dispatch on result type. emitFloatBinop
	// only matches OP_ADD/SUB/MUL/DIV; integer ops on floats
	// don't exist and would fall through to the int path below.
	if emitFloatBinop(a, rm, ins) { return true }

	var lhs int = getOperand(a, rm, ins.Args[0].ID)
	var rhs int = getOperand(a, rm, ins.Args[1].ID)
	if lhs < 0 || rhs < 0 { return false }

	var rd int = nextReg(rm, ins.ID)
	var rhsOp aarch64.Operand = aarch64.Reg(rhs)

	// Unsigned-int DIV / REM / SHR need their unsigned aa64 forms;
	// signed Sdiv on a uint with the high bit set gives the wrong
	// answer (uint64Max / 7 evaluated signed is 0), and Asr would
	// shift in sign bits on a logically-unsigned right-shift.
	var uTyp @types.Type = common.UnwrapNamed(ins.Typ)
	var isUnsigned bool = uTyp != nil &&
		uTyp.IsInteger() && !uTyp.Signed

	var matched bool = false
	if ins.Op == iropcode.OP_ADD { aarch64.Add(a, true, rd, lhs, rhsOp); matched = true }
	if ins.Op == iropcode.OP_SUB { aarch64.Sub(a, true, rd, lhs, rhsOp); matched = true }
	if ins.Op == iropcode.OP_MUL { aarch64.Mul(a, true, rd, lhs, rhs);   matched = true }
	if ins.Op == iropcode.OP_DIV {
		if isUnsigned {
			aarch64.Udiv(a, true, rd, lhs, rhs)
		} else {
			aarch64.Sdiv(a, true, rd, lhs, rhs)
		}
		matched = true
	}
	// OP_REM: synthesize via DIV + MSUB (rd = lhs - (lhs/rhs)*rhs);
	// dispatch on signedness for the DIV step.
	if ins.Op == iropcode.OP_REM {
		if isUnsigned {
			aarch64.Udiv(a, true, rd, lhs, rhs)
		} else {
			aarch64.Sdiv(a, true, rd, lhs, rhs)
		}
		aarch64.Msub(a, true, rd, rd, rhs, lhs)
		matched = true
	}
	if ins.Op == iropcode.OP_AND { aarch64.And(a, true, rd, lhs, rhsOp); matched = true }
	if ins.Op == iropcode.OP_OR  { aarch64.Orr(a, true, rd, lhs, rhsOp); matched = true }
	// OP_LAND / OP_LOR — used by switch case lists (`case 1, 2, 3:`)
	// where all comparisons are always evaluated. Plain bitwise on
	// bool registers gives the right result. User-level `&&` / `||`
	// short-circuit through the IR's branch-form lowering and never
	// reach here.
	if ins.Op == iropcode.OP_LAND { aarch64.And(a, true, rd, lhs, rhsOp); matched = true }
	if ins.Op == iropcode.OP_LOR  { aarch64.Orr(a, true, rd, lhs, rhsOp); matched = true }
	if ins.Op == iropcode.OP_XOR { aarch64.Eor(a, true, rd, lhs, rhsOp); matched = true }
	if ins.Op == iropcode.OP_SHL { aarch64.Lsl(a, true, rd, lhs, rhsOp); matched = true }
	if ins.Op == iropcode.OP_SHR {
		if isUnsigned {
			aarch64.Lsr(a, true, rd, lhs, rhsOp)
		} else {
			aarch64.Asr(a, true, rd, lhs, rhsOp)
		}
		matched = true
	}
	if !matched { return false }
	// Re-narrow a sub-word result so its dirty upper bits can't corrupt a
	// later shift, unsigned compare, division, or widening read.  rd is
	// spilled to its slot after this returns, so the narrowed value is
	// what every later reload sees.  The VM and LLVM hold the same
	// invariant (LLVM for free via true-width SSA).
	emitSubWordNarrow(a, rd, ins.Typ)
	return true
}

// emitCompare handles OP_EQ/NE/LT/LE/GT/GE by emitting CMP + CSINC with
// XZR (the CSET idiom). The assembler doesn't expose CSET directly, but
// CSET Rd, cond ≡ CSINC Rd, XZR, XZR, invert(cond).
func emitCompare(a @asm.Assembler, pkgName *[]readonly char,
	rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_EQ && ins.Op != iropcode.OP_NE &&
		ins.Op != iropcode.OP_LT && ins.Op != iropcode.OP_LE &&
		ins.Op != iropcode.OP_GT && ins.Op != iropcode.OP_GE {
		return false
	}
	if len(ins.Args) != 2 { return false }
	// Float operands need FCMP + ordered-FP condition codes, not
	// integer CMP — integer CMP would compare bit patterns, which
	// returns wrong answers for IEEE NaN (two NaNs with the same bit
	// pattern compare equal), for +0.0 vs -0.0 (different bit
	// patterns, IEEE-equal), and for Binate's ordered semantics
	// generally.  Delegate to emitFloatCompare in aarch64_float.bn.
	if ins.Args[0].Typ != nil && ins.Args[0].Typ.IsFloat() {
		return emitFloatCompare(a, rm, ins)
	}
	var lhs int = emitValOperand(a, pkgName, rm, ins.Args[0])
	var rhs int = emitValOperand(a, pkgName, rm, ins.Args[1])
	if lhs < 0 || rhs < 0 { return false }

	var rd int = nextReg(rm, ins.ID)
	aarch64.Cmp(a, true, lhs, aarch64.Reg(rhs))

	// Comparison signedness is keyed on operand type (the result is
	// always bool).  Unsigned uint values with the high bit set
	// would sort as "negative" under the signed condition codes,
	// so route those through the AArch64 unsigned forms.
	var cmpTyp @types.Type = common.UnwrapNamed(ins.Args[0].Typ)
	var isUnsigned bool = cmpTyp != nil &&
		cmpTyp.IsInteger() && !cmpTyp.Signed
	var invCond int = invertCondForOp(ins.Op, isUnsigned)
	aarch64.Csinc(a, true, rd, aarch64.XZR, aarch64.XZR, invCond)
	return true
}

// invertCondForOp returns the AArch64 condition code that is the
// logical inverse of the IR comparison, so `csinc rd,xzr,xzr,invCond`
// sets rd=1 exactly when the comparison holds.  `isUnsigned` picks
// between the signed (LT/LE/GT/GE) and unsigned (LO/LS/HI/HS)
// condition-code families.
func invertCondForOp(op int, isUnsigned bool) int {
	if op == iropcode.OP_EQ { return aarch64.COND_NE }
	if op == iropcode.OP_NE { return aarch64.COND_EQ }
	if isUnsigned {
		if op == iropcode.OP_LT { return aarch64.COND_HS }  // !(a <u b)  ≡  a >=u b
		if op == iropcode.OP_LE { return aarch64.COND_HI }  // !(a <=u b) ≡  a >u  b
		if op == iropcode.OP_GT { return aarch64.COND_LS }  // !(a >u b)  ≡  a <=u b
		return aarch64.COND_LO                         // OP_GE: !(a >=u b) ≡ a <u b
	}
	if op == iropcode.OP_LT { return aarch64.COND_GE }  // signed
	if op == iropcode.OP_LE { return aarch64.COND_GT }  // signed
	if op == iropcode.OP_GT { return aarch64.COND_LE }  // signed
	return aarch64.COND_LT                         // OP_GE, signed
}

// emitUnop handles unary ops (-, ~, !). Returns true if matched.
func emitUnop(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_NEG && ins.Op != iropcode.OP_BITNOT && ins.Op != iropcode.OP_NOT {
		return false
	}
	if len(ins.Args) != 1 { return false }

	// Float negation goes through FNEG via D scratch.
	if ins.Op == iropcode.OP_NEG && emitFloatNeg(a, rm, ins) { return true }

	var src int = getOperand(a, rm, ins.Args[0].ID)
	if src < 0 { return false }

	var rd int = nextReg(rm, ins.ID)
	// Re-narrow a sub-word NEG/BITNOT result: the op runs at host width, so a
	// uint8/16/32 (or int8/16/32) result keeps dirty upper bits that would
	// corrupt a later shift, unsigned compare, division, or widening read.
	// emitSubWordNarrow is a no-op for host-word and non-integer results.
	// OP_NOT is exempt — it already produces a 0/1 bool.
	if ins.Op == iropcode.OP_NEG {
		aarch64.Neg(a, true, rd, aarch64.Reg(src))
		emitSubWordNarrow(a, rd, ins.Typ)
		return true
	}
	if ins.Op == iropcode.OP_BITNOT {
		aarch64.Mvn(a, true, rd, aarch64.Reg(src))
		emitSubWordNarrow(a, rd, ins.Typ)
		return true
	}
	// OP_NOT: logical negation on a bool. Flip bit 0.
	if ins.Op == iropcode.OP_NOT {
		aarch64.Eor(a, true, rd, src, aarch64.Imm(1))
		return true
	}
	return false
}


// emitScalarLoad picks the right LDR variant for the given byte size
// (1/2/4/8) and emits a load into rd from [base, #off].  `signed`
// selects sign-extending variants (LDRSB/LDRSH/LDRSW) for sizes 1/2/4
// when the loaded value is a signed narrow int (int8 / int16 /
// int32); zero-extending variants (LDRB/LDRH/LDR-W) otherwise.  Size
// 8 loads are full-width so the signed flag is irrelevant.
//
// The signed path matters whenever a signed narrow int is loaded
// into an X register and then operated on with 64-bit arithmetic /
// comparison.  Without sign extension the high bits stay zero and a
// negative value compares as a large positive — which broke
// `int8 < 0` for int8 = -5 (loaded as 251, compares ≥ 0) until this
// flag was added.  See conformance 416_narrow_int_sign_ext.
//
// The aarch64 lib handles oversize offsets internally (materializing
// via X17), so callers don't need to size-check off.
func emitScalarLoad(a @asm.Assembler, rd int, base int, off int, sz int,
		signed bool) {
	if sz == 1 {
		if signed {
			aarch64.Ldrsb(a, true, rd, aarch64.MemImm(base, off))
		} else {
			aarch64.Ldrb(a, rd, aarch64.MemImm(base, off))
		}
		return
	}
	if sz == 2 {
		if signed {
			aarch64.Ldrsh(a, true, rd, aarch64.MemImm(base, off))
		} else {
			aarch64.Ldrh(a, rd, aarch64.MemImm(base, off))
		}
		return
	}
	if sz == 4 {
		if signed {
			aarch64.Ldrsw(a, rd, aarch64.MemImm(base, off))
		} else {
			aarch64.Ldr(a, false, rd, aarch64.MemImm(base, off))
		}
		return
	}
	aarch64.Ldr(a, true, rd, aarch64.MemImm(base, off))
}

// emitScalarStore is the symmetric STRB/STRH/STR dispatcher. The
// aarch64 lib handles oversize offsets internally; callers don't
// need to size-check off.
func emitScalarStore(a @asm.Assembler, rt int, base int, off int, sz int) {
	if sz == 1 {
		aarch64.Strb(a, rt, aarch64.MemImm(base, off))
		return
	}
	if sz == 2 {
		aarch64.Strh(a, rt, aarch64.MemImm(base, off))
		return
	}
	if sz == 4 {
		aarch64.Str(a, false, rt, aarch64.MemImm(base, off))
		return
	}
	aarch64.Str(a, true, rt, aarch64.MemImm(base, off))
}

// emitConstInt64 loads a 64-bit integer constant into rd using a
// movz+movk chain — one MOVZ for the first non-zero 16-bit chunk,
// MOVKs for subsequent non-zero chunks. A single MOVZ suffices for
// small positives; larger values (e.g. 0x80000000 from test 151)
// need the chain.
//
// Negative values with bit 63 set are NOT handled here — they'd need
// MOVN. The IR typically emits positive IntVal with OP_NEG for
// negation, so this covers the common case.
func emitConstInt64(a @asm.Assembler, rd int, val int64) {
	if val == 0 {
		aarch64.Movz(a, true, rd, 0, 0)
		return
	}
	var first bool = true
	for i := 0; i < 4; i++ {
		var shift int = 16 * i
		// val is int64 so the high chunks (shift 32/48) are
		// addressable even when the compiler's host `int` is 32-bit.
		var chunk int = cast(int, (val >> cast(int64, shift)) & cast(int64, 0xFFFF))
		if chunk == 0 { continue }
		if first {
			aarch64.Movz(a, true, rd, chunk, shift)
			first = false
		} else {
			aarch64.Movk(a, true, rd, chunk, shift)
		}
	}
	if first {
		// All chunks were zero but val != 0 — shouldn't happen for
		// finite values. Defensive fallback.
		aarch64.Movz(a, true, rd, 0, 0)
	}
}

// emitCast truncates src to the width of target (uint32/int32/…),
// storing the result in rd. For unsigned targets, zero-extend via
// LSL+LSR; for signed, sign-extend via LSL+ASR. For 64-bit targets
// (or target.Width == 0, meaning the predeclared `int`), pass
// through unchanged.
func emitCast(a @asm.Assembler, rd int, src int, srcTyp @types.Type,
		target @types.Type) {
	// Peel TYP_NAMED so a named distinct scalar's cast narrows/widens by
	// its underlying's width and signedness — a bare TYP_NAMED has Width
	// 0 / Signed false, which skips the shift entirely (no truncation,
	// no sign-extension).
	srcTyp = common.UnwrapNamed(srcTyp)
	target = common.UnwrapNamed(target)
	var tw int = 0
	if target != nil { tw = target.Width }
	if tw > 0 && tw < 64 {
		// Narrowing to a sub-word target: keep the low tw bits, canonical
		// per the target's signedness.
		var shift int = 64 - tw
		aarch64.Lsl(a, true, rd, src, aarch64.Imm(shift))
		if target != nil && target.Signed {
			aarch64.Asr(a, true, rd, rd, aarch64.Imm(shift))
		} else {
			aarch64.Lsr(a, true, rd, rd, aarch64.Imm(shift))
		}
		return
	}
	// Widening to a host-word target: re-establish the value from the
	// SOURCE width per the source's signedness.  The register may be
	// non-canonical — a bit_cast result is a bare reinterpret MOV, so
	// e.g. bit_cast(int32, <negative float32>) leaves the high bits zero,
	// not sign-extended.  The VM (BC_SEXT/BC_ZEXT) and LLVM (sext/zext)
	// extend per the source here too; a plain MOV would silently keep the
	// wrong upper bits.
	var sw int = 0
	if srcTyp != nil { sw = srcTyp.Width }
	if sw > 0 && sw < 64 {
		var shift int = 64 - sw
		aarch64.Lsl(a, true, rd, src, aarch64.Imm(shift))
		if srcTyp != nil && srcTyp.Signed {
			aarch64.Asr(a, true, rd, rd, aarch64.Imm(shift))
		} else {
			aarch64.Lsr(a, true, rd, rd, aarch64.Imm(shift))
		}
		return
	}
	aarch64.Mov(a, true, rd, aarch64.Reg(src))
}

// emitEpilogueAndRet tears down the frame.
func emitEpilogueAndRet(a @asm.Assembler, frameSize int) {
	if frameSize > 0 {
		aarch64.Add(a, true, aarch64.SP, aarch64.SP, aarch64.Imm(frameSize))
	}
	aarch64.Ldp(a, true, aarch64.FP, aarch64.LR,
		aarch64.MemPost(aarch64.SP, 16))
	aarch64.Ret(a)
}
