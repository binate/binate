package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// opsMkAssembler: minimal assembler for direct-emit tests.
func opsMkAssembler() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// setTarget64 pins types' live target to a 64-bit configuration.
// pkg/binate/native/aarch64 targets the AAPCS64 ABI exclusively; its tests'
// size / alignment / aggregate-classification assertions are LP64-
// specific.  On a 32-bit-host test runner the lazy default would
// otherwise reflect the host and skew the assertions.
func setTarget64() {
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	types.SetTarget(t)
}

func opsBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// nilFuncs returns an empty @[]@ir.Func for tests that don't need
// callee-lookup (CalleeUsesCSret returns false on an empty list).
func nilFuncs() @[]@ir.Func {
	var empty @[]@ir.Func
	return empty
}

// OP_LOR / OP_LAND are emitted by switch case-OR generation
// (`case 1, 2, 3:` chains) where short-circuit doesn't apply.
// emitBinop must dispatch them or the chain silently no-ops, leaving
// the BRANCH cond uninitialized — the regression that broke
// 083_multi_case_switch.
func TestEmitBinopHandlesLor() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypBool()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypBool()
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_LOR
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitBinop(a, m, ins) {
		return "emitBinop should match OP_LOR"
	}
	// 2× LDR (operand reloads) + 1× ORR = 12 bytes.
	if opsBytes(a) != 12 {
		return "OP_LOR should emit LDR + LDR + ORR"
	}
	return ""
}
// emitScalarLoad dispatches by size: 1→LDRB, 2→LDRH, 4→LDR(W),
// 8→LDR(X). A regression that treats char as 8 bytes (pre-size-
// dispatch bug) would fail the size=1 case, and char handling across
// ~10 tests would silently break.
func TestEmitScalarLoadSizeOneIsLdrb() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitScalarLoad(a, aarch64.X9, aarch64.SP, 0, 1, false)
	if opsBytes(a) != 4 { return "LDRB should be 4 bytes" }
	// LDRB (unsigned immediate) opcode top byte is 0x39.
	if a.Sections[0].Data[3] != cast(uint8, 0x39) {
		return "size=1 should emit LDRB (top byte 0x39)"
	}
	return ""
}
// signed=true on a size-1 load picks LDRSB instead of LDRB so the
// loaded byte is sign-extended into the 64-bit register.  Pre-fix
// this returned LDRB always, so an int8 = -5 loaded as 251 and
// `i8 < 0` evaluated false.  Conformance 416_narrow_int_sign_ext.
//
// Encoding: 00_111001_10_imm12_Rn_Rt for LDRSB (X) — opc=10 sets
// 64-bit destination (sign-extend to full X register).  Top byte
// 0x39 (same family as LDRB), byte 2 = 0x80 (opc=10 in bits 23-22
// + zero imm12 high bits).  A swap of the sf branches in aarch64
// Ldrsb (which we hit pre-fix) gave 0xC0 here instead → W-form
// (sign-extend only to 32 bits, upper 32 zero-filled), which is
// the actual root cause behind 416.
func TestEmitScalarLoadSizeOneSignedIsLdrsb() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitScalarLoad(a, aarch64.X9, aarch64.SP, 0, 1, true)
	if opsBytes(a) != 4 { return "LDRSB should be 4 bytes" }
	if a.Sections[0].Data[3] != cast(uint8, 0x39) {
		return "signed size=1 LDRSB should keep 0x39 top byte"
	}
	if a.Sections[0].Data[2] != cast(uint8, 0x80) {
		return "signed size=1 should be LDRSB (X) — byte 2 = 0x80"
	}
	return ""
}
// Symmetric: size=2 signed picks LDRSH (X-form, opc=10).
// Top byte 0x79; byte 2 = 0x80.
func TestEmitScalarLoadSizeTwoSignedIsLdrsh() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitScalarLoad(a, aarch64.X9, aarch64.SP, 0, 2, true)
	if opsBytes(a) != 4 { return "LDRSH should be 4 bytes" }
	if a.Sections[0].Data[3] != cast(uint8, 0x79) {
		return "signed size=2 LDRSH top byte should be 0x79"
	}
	if a.Sections[0].Data[2] != cast(uint8, 0x80) {
		return "signed size=2 should be LDRSH (X) — byte 2 = 0x80"
	}
	return ""
}
// Size=4 signed picks LDRSW (always X-form: sign-extends 32→64).
// Opcode top byte 0xB9 (vs 0xB9 for LDR-W zero-extend at top byte but
// different in the opc field — top byte for LDRSW is 0xB9 with bit 23
// set, distinguishing it from LDR-W).
func TestEmitScalarLoadSizeFourSignedIsLdrsw() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitScalarLoad(a, aarch64.X9, aarch64.SP, 0, 4, true)
	if opsBytes(a) != 4 { return "LDRSW should be 4 bytes" }
	if a.Sections[0].Data[3] != cast(uint8, 0xB9) {
		return "signed size=4 LDRSW top byte should be 0xB9"
	}
	if a.Sections[0].Data[2] != cast(uint8, 0x80) {
		return "signed size=4 should be LDRSW — byte 2 = 0x80 (not 0x40 for LDR-W)"
	}
	return ""
}
func TestEmitScalarLoadSizeEightIsLdrX() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitScalarLoad(a, aarch64.X9, aarch64.SP, 0, 8, false)
	if opsBytes(a) != 4 { return "LDR X should be 4 bytes" }
	// LDR (X, unsigned immediate) opcode top byte is 0xF9.
	if a.Sections[0].Data[3] != cast(uint8, 0xF9) {
		return "size=8 should emit LDR X (top byte 0xF9)"
	}
	return ""
}
func TestEmitScalarStoreSizeOneIsStrb() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitScalarStore(a, aarch64.X9, aarch64.SP, 0, 1)
	if opsBytes(a) != 4 { return "STRB should be 4 bytes" }
	// STRB opcode top byte is 0x39.
	if a.Sections[0].Data[3] != cast(uint8, 0x39) {
		return "size=1 should emit STRB (top byte 0x39)"
	}
	return ""
}
// STRB's imm12 isn't scaled — the encodable range is 0..4095. For an
// offset above 4095, aarch64.Strb would silently mask to the low 12
// bits and store at the wrong address. emitScalarStore must detect
// this and materialize the full address into X17 first. Regression
// guard: pkg/binate/native/aarch64.TestEmitCallAggregateReturnSpillsAllWords
// crashed pre-fix because emitCall's `var bigMultiRet bool` ended up
// with an alloca offset of 0x1158, which Strb truncated to 0x158 —
// inside the alloca for argTypes (32 bytes at 0x148) — corrupting
// argTypes.refptr to 1.
func TestEmitScalarStoreLargeOffsetUsesAddrMaterialization() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	// Offset 0x1158 = 4440 doesn't fit in STRB's 12-bit immediate.
	emitScalarStore(a, aarch64.X9, aarch64.SP, 0x1158, 1)
	// Expect: ADD X17, SP, #0x1000 (sh=1) + ADD X17, X17, #0x158 +
	// STRB X9, [X17, #0] = 3 instrs = 12 bytes. Pre-fix this was a
	// single 4-byte STRB with the offset truncated.
	if opsBytes(a) != 12 {
		return "large STRB offset should ADD twice + STRB (12 bytes)"
	}
	return ""
}
func TestEmitScalarLoadLargeOffsetUsesAddrMaterialization() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitScalarLoad(a, aarch64.X9, aarch64.SP, 0x1158, 1, false)
	if opsBytes(a) != 12 {
		return "large LDRB offset should ADD twice + LDRB (12 bytes)"
	}
	return ""
}
// 8-byte STR scales the imm12 by 8, so the encodable range goes up
// to 0x7FF8 (32760). 0x800 fits at 0x800/8 = 256 (well within imm12).
// 0x10000 doesn't fit (8192 > 4095 limit) — must materialize.
func TestEmitScalarStoreSize8FitsLargerOffsets() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitScalarStore(a, aarch64.X9, aarch64.SP, 0x800, 8)
	// Should be a single STR — fits in scaled imm12.
	if opsBytes(a) != 4 { return "0x800/8=256 fits — should be 1 STR" }
	a = opsMkAssembler()
	emitScalarStore(a, aarch64.X9, aarch64.SP, 0x10000, 8)
	// 0x10000/8 = 8192 > 4095 — must materialize via X17. ADD imm
	// encoding handles 0x10000 as a single shifted-imm12 ADD (hi=0x10,
	// lo=0), so total is ADD + STR = 8 bytes.
	if opsBytes(a) != 8 {
		return "0x10000 needs ADD (shifted-imm12) + STR = 8 bytes"
	}
	return ""
}
// invertCondForOp maps IR comparisons to the AArch64 condition codes
// that make `csinc rd,xzr,xzr,<cond>` set rd=1 iff the comparison
// holds. These are the walking-skeleton's truth table; a subtle
// off-by-one or wrong invert flips every boolean in the backend.

func TestInvertCondForOp() testing.TestResult {
	// For x == y, we want rd=1 on equality; csinc with COND_NE does
	// that (cond-true → rn=xzr; cond-false → rm+1=1).
	// Pairs: (ir op) → (expected cond code name)
	// We only check it's NOT the opposite — the exact constants live
	// in pkg/binate/asm/aarch64 and change would break this anyway.
	var eq int = invertCondForOp(ir.OP_EQ, false)
	var ne int = invertCondForOp(ir.OP_NE, false)
	if eq == ne { return "OP_EQ and OP_NE should invert to distinct conds" }

	var lt int = invertCondForOp(ir.OP_LT, false)
	var ge int = invertCondForOp(ir.OP_GE, false)
	if lt == ge { return "OP_LT and OP_GE should invert to distinct conds" }

	var le int = invertCondForOp(ir.OP_LE, false)
	var gt int = invertCondForOp(ir.OP_GT, false)
	if le == gt { return "OP_LE and OP_GT should invert to distinct conds" }

	// Unsigned variants must be distinct from their signed
	// counterparts (LO/LS/HI/HS vs LT/LE/GT/GE).  EQ / NE don't
	// depend on signedness, so they're the same as above.
	var ltU int = invertCondForOp(ir.OP_LT, true)
	var leU int = invertCondForOp(ir.OP_LE, true)
	var gtU int = invertCondForOp(ir.OP_GT, true)
	var geU int = invertCondForOp(ir.OP_GE, true)
	if ltU == lt { return "OP_LT signed/unsigned should differ" }
	if leU == le { return "OP_LE signed/unsigned should differ" }
	if gtU == gt { return "OP_GT signed/unsigned should differ" }
	if geU == ge { return "OP_GE signed/unsigned should differ" }
	if ltU == geU { return "OP_LT and OP_GE unsigned should invert to distinct conds" }
	if leU == gtU { return "OP_LE and OP_GT unsigned should invert to distinct conds" }
	return ""
}
// (TestArgRegOrdering / TestUnderscorePrefix moved to
// arm64_names_test.bn alongside the helpers themselves.)

// TestInvertFloatCondForOp pins the ARM-condition mapping used by
// the FCMP + CSET idiom in emitFloatCompare.  Each op must map to a
// distinct ordered-FP condition, and the mapping must be the
// *inverse* of the relation we want to land — because `csinc rd,xzr,
// xzr,cond` sets rd=1 iff cond is FALSE.  See emitFloatCompare's
// comment for the table.
//
// We can't check the exact constants from here (they live in
// pkg/binate/asm/aarch64.bni); we check the structural invariants the bug
// would violate.
func TestInvertFloatCondForOp() testing.TestResult {
	var eq int = invertFloatCondForOp(ir.OP_EQ)
	var ne int = invertFloatCondForOp(ir.OP_NE)
	if eq == ne { return "OP_EQ and OP_NE should invert to distinct conds" }

	var lt int = invertFloatCondForOp(ir.OP_LT)
	var ge int = invertFloatCondForOp(ir.OP_GE)
	if lt == ge { return "OP_LT and OP_GE should invert to distinct conds" }

	var le int = invertFloatCondForOp(ir.OP_LE)
	var gt int = invertFloatCondForOp(ir.OP_GT)
	if le == gt { return "OP_LE and OP_GT should invert to distinct conds" }

	// The float ordered-FP conditions must differ from the integer
	// ones for the non-equality ops (the integer path uses GE/GT/LE/
	// LT for signed; the float ordered path uses PL/LE/HI/LT).  EQ
	// and NE share the integer mapping in spirit, so don't pin them
	// as "distinct" — the test only catches a regression that copied
	// the integer signed/unsigned table verbatim into the float
	// path, which would produce wrong semantics for NaN.
	var ltI int = invertCondForOp(ir.OP_LT, false)  // signed integer LT
	if lt == ltI {
		return "OP_LT float and signed-int inversions must differ"
	}
	var leI int = invertCondForOp(ir.OP_LE, false)
	if le == leI {
		return "OP_LE float and signed-int inversions must differ"
	}
	return ""
}
