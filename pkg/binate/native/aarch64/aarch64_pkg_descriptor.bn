package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/stdx/slices"

// emitPackageDescriptor emits this module's reflect.Package descriptor node
// (shared layout via common.EmitPackageDescriptorData), its exported-function
// FunctionInfo table, plus the generated `_Package() @reflect.Package`
// accessor.  The native counterpart to the LLVM backend's emitPackageDescriptor
// (pkg/binate/codegen/emit_pkg_descriptor.bn): both produce the same `_Package`
// symbol (mangle.FuncName) and static-managed layout, so a cross-mode
// reference — e.g. the bytecode VM's RegisterStandardExterns taking `*func()
// @reflect.Package = rt._Package` — resolves to one definition regardless of
// which backend compiled the owning package.  Without the native half, any
// native-compiled module that another TU references `pkg._Package` from fails
// to link (undefined `_Package`).  Emitted for every module; the linker dead-
// strips it where `_Package` is unreferenced, so it costs nothing for unused
// ones.
func emitPackageDescriptor(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	var pkgInfoSym @[]char = globalSymFor(pkgName, "_pkg_info")
	var pkgNameSym @[]char = globalSymFor(pkgName, "_pkgname")
	var funcSym @[]char = symFor(pkgName, "_Package")
	var funcsArraySym @[]char = globalSymFor(pkgName, "_pkg_funcs")
	var globalsArraySym @[]char = globalSymFor(pkgName, "_pkg_globals")

	// One FunctionInfo node per .bni-exported, non-extern func — the same set
	// collectFuncValueRefs force-emits a __handle for (so Value resolves).
	// Collect the node symbols for the Functions pointer array.
	var nodeSyms @[]@[]char
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		if !f.Exported { continue }
		var fv @types.Type = lookupFuncValueTypeAA64(mod, f.Name)
		if fv == nil { continue }
		var base @[]char = symFor(pkgName, f.Name)
		var nameSym @[]char = catSymAA64(base, "__fnname")
		var sigSym @[]char = catSymAA64(base, "__fnsig")
		var nodeSym @[]char = catSymAA64(base, "__fninfo")
		var handleSym @[]char = handleSymFor(pkgName, f.Name)
		common.EmitFunctionInfoNode(a, pkgInfoSym, nodeSym, nameSym, f.Name,
			sigSym, fv.SigString(), handleSym, common.FuncResultSize(fv),
			len(fv.Params))
		nodeSyms = slices.Append[@[]char](nodeSyms, nodeSym)
	}
	// Self-list the compiler-synthesized _Package accessor as the LAST
	// entry (mirrors emit_pkg_functions.bn).  Name is the FQ <pkg>._Package
	// (the VM lookup key); its triple is force-emitted by
	// collectFuncValueRefs.  Guarded on PackageAccessorSig — nil when
	// reflect wasn't loaded for this module.
	if mod.PackageAccessorSig != nil {
		var fvP @types.Type = mod.PackageAccessorSig
		var nameP @[]char = mangle.QualifyName(pkgName, "_Package")
		var baseP @[]char = symFor(pkgName, nameP)
		var nameSymP @[]char = catSymAA64(baseP, "__fnname")
		var sigSymP @[]char = catSymAA64(baseP, "__fnsig")
		var nodeSymP @[]char = catSymAA64(baseP, "__fninfo")
		var handleSymP @[]char = handleSymFor(pkgName, nameP)
		common.EmitFunctionInfoNode(a, pkgInfoSym, nodeSymP, nameSymP, nameP,
			sigSymP, fvP.SigString(), handleSymP, common.FuncResultSize(fvP),
			len(fvP.Params))
		nodeSyms = slices.Append[@[]char](nodeSyms, nodeSymP)
	}
	var funcCount int = len(nodeSyms)
	if funcCount > 0 {
		common.EmitFunctionsArray(a, funcsArraySym, nodeSyms)
	}

	// One GlobalInfo node per .bni-exported, non-extern global; collect the
	// node symbols for the Globals pointer array.  Name is the FULLY-QUALIFIED
	// form (a package's own global has a bare g.Name — qualify it, the form
	// lookupGlobalAddr keys on); Addr is the global's storage cell symbol.
	var globalNodeSyms @[]@[]char
	for i := 0; i < len(mod.Globals); i++ {
		var g @ir.Global = mod.Globals[i]
		if g.IsExtern { continue }
		if !g.Exported { continue }
		var storageSym @[]char = globalSymFor(pkgName, g.Name)
		var glNameSym @[]char = catSymAA64(storageSym, "__glname")
		var glNodeSym @[]char = catSymAA64(storageSym, "__glinfo")
		common.EmitGlobalInfoNode(a, glNodeSym, glNameSym,
			mangle.QualifyName(pkgName, g.Name), storageSym)
		globalNodeSyms = slices.Append[@[]char](globalNodeSyms, glNodeSym)
	}
	var globalCount int = len(globalNodeSyms)
	if globalCount > 0 {
		common.EmitGlobalsArray(a, globalsArraySym, globalNodeSyms)
	}

	common.EmitPackageDescriptorData(a, pkgInfoSym, pkgNameSym, pkgName,
		funcsArraySym, funcCount, globalsArraySym, globalCount)

	// The accessor returns the payload pointer (node + the 2 managed-header
	// words = 16 bytes on the 64-bit native target) in X0.  A leaf with no
	// frame — address-of-node, += header, return.
	a.SetSection("text", -1)
	a.DefineLabel(funcSym)
	a.SetGlobal(funcSym)
	aarch64.Adrp(a, 0, pkgInfoSym)                 // X0 = page(node)
	aarch64.AddImmLabel(a, true, 0, 0, pkgInfoSym) // X0 += pageoff(node)
	aarch64.Add(a, true, 0, 0, aarch64.Imm(16))    // X0 += managed-header bytes
	aarch64.Ret(a)
}

// catSymAA64 concatenates a suffix onto a symbol name, returning a fresh slice
// (for the per-func __fnname / __fnsig / __fninfo symbols).
func catSymAA64(base @[]char, suffix *[]readonly char) @[]char {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(base)
	cb.Write(suffix)
	return buf.CopyStr(cb.String())
}
