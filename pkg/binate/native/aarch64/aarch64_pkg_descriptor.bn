package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// emitPackageDescriptor emits this module's reflect.Package descriptor — its
// FunctionInfo / GlobalInfo / VtableInfo tables, the descriptor node + name,
// and the generated `__Package() @reflect.Package` accessor.  The native
// counterpart to the LLVM backend's emitPackageDescriptor
// (pkg/binate/codegen/emit_pkg_descriptor.bn): the ENTIRE descriptor byte
// layout is built once by irdata.BuildPackageDescriptors (the single source of
// truth both backends lower through EmitDataGlobal — they cannot drift), so
// this gather only resolves the aarch64 symbol names + payload scalars per row.
// Both backends produce the same `__Package` symbol + layout, so a cross-mode
// reference (the interpreter host's registerPackageDescriptorExterns) resolves
// to one definition regardless of which backend compiled the owning package.
// Emitted for every module; the linker dead-strips an unreferenced `__Package`.
func emitPackageDescriptor(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	var pkgInfoSym @[]char = globalSymFor(pkgName, "_pkg_info")
	var pkgNameSym @[]char = globalSymFor(pkgName, "_pkgname")
	var funcSym @[]char = symFor(pkgName, "__Package")
	var funcsArraySym @[]char = globalSymFor(pkgName, "_pkg_funcs")
	var globalsArraySym @[]char = globalSymFor(pkgName, "_pkg_globals")
	var vtablesArraySym @[]char = globalSymFor(pkgName, "_pkg_vtables")
	var satentriesArraySym @[]char = globalSymFor(pkgName, "_pkg_satentries")

	var funcs @[]@irdata.PkgFuncEntry = collectFuncsAA64(pkgInfoSym, pkgName, mod)
	var globals @[]@irdata.PkgGlobalEntry = collectGlobalsAA64(pkgName, mod)
	var vtables @[]@irdata.PkgVtableEntry = collectVtablesAA64(pkgName, mod)
	var satEntrySyms @[]@[]char = collectSatEntriesAA64(mod)

	var dgs @[]@irdata.DataGlobal = irdata.BuildPackageDescriptors(
			common.STATIC_MANAGED_REFCOUNT, pkgInfoSym, pkgNameSym, buf.CopyStr(pkgName), funcsArraySym,
			funcs, globalsArraySym, globals, vtablesArraySym, vtables, satentriesArraySym, satEntrySyms)
	for i := 0; i < len(dgs); i++ {
		common.EmitDataGlobal(a, dgs[i])
	}

	// The accessor returns the payload pointer (node + the managed header, 2
	// pointer-sized words = 16 on the LP64 native targets) in X0.  Uses
	// ManagedHeaderSize (the canonical 2*ptrSize helper) — the header is
	// POINTER-sized, not int-sized (identical on every shipping ABI, where
	// int == pointer), so this agrees with the data side's node-payload offset.
	// A leaf with no frame — address-of-node, += header, return.
	var hdr int = types.ManagedHeaderSize()
	a.SetSection("text", -1)
	a.DefineLabel(funcSym)
	a.SetGlobal(funcSym)
	aarch64.Adrp(a, 0, pkgInfoSym) // X0 = page(node)
	aarch64.AddImmLabel(a, true, 0, 0, pkgInfoSym) // X0 += pageoff(node)
	aarch64.Add(a, true, 0, 0, aarch64.Imm(hdr)) // X0 += managed-header bytes
	aarch64.Ret(a)
}

// collectFuncsAA64 gathers the FunctionInfo rows: one per .bni-exported,
// non-extern func (the set collectFuncValueRefs force-emits a __handle for) plus
// own-package struct dtors, then — when reflect was loaded — the synthesized
// `__Package` accessor itself (LAST).  Symbols are aarch64-prefixed via symFor /
// handleSymFor; the Name field is f.Name verbatim (the FQ VM lookup key).
func collectFuncsAA64(pkgInfoSym @[]char, pkgName *[]readonly char,
		mod @ir.Module) @[]@irdata.PkgFuncEntry {
	var funcs @[]@irdata.PkgFuncEntry
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		// + own-package struct dtors (IsStructDtor) + lang's primitive methods
		// (IsPrimitiveMethod, reached by direct call), injectable when native-only.
		if !f.Exported && !f.IsStructDtor && !f.IsPrimitiveMethod { continue }
		var fv @types.Type = lookupFuncValueTypeAA64(mod, f.Name)
		if fv == nil { continue }
		funcs = slices.Append[@irdata.PkgFuncEntry](funcs, funcEntryAA64(pkgName, f.Name, fv))
	}
	if mod.PackageAccessorSig != nil {
		var nameP @[]char = mangle.QualifyName(pkgName, "__Package")
		funcs = slices.Append[@irdata.PkgFuncEntry](funcs,
				funcEntryAA64(pkgName, nameP, mod.PackageAccessorSig))
	}
	return funcs
}

// funcEntryAA64 builds one FunctionInfo row from a func-value type: the
// __fninfo/__fnname/__fnsig symbols off symFor, the @__handle.<mangled> Value
// target, and the VM-dispatch RetbufSize + ParamSlots.
func funcEntryAA64(pkgName *[]readonly char, name *[]readonly char,
		fv @types.Type) @irdata.PkgFuncEntry {
	var base @[]char = symFor(pkgName, name)
	return irdata.NewPkgFuncEntry(catSymAA64(base, "__fninfo"), catSymAA64(base, "__fnname"),
			buf.CopyStr(name), catSymAA64(base, "__fnsig"), buf.CopyStr(fv.SigString()),
			handleSymFor(pkgName, name), common.FuncRetbufSize(fv), len(fv.Params))
}

// collectGlobalsAA64 gathers the GlobalInfo rows: one per .bni-exported,
// non-extern global.  Name is the FULLY-QUALIFIED form (a package's own global
// carries a bare g.Name — qualify it, the form lookupGlobalAddr keys on); Addr
// is the global's storage cell symbol.
func collectGlobalsAA64(pkgName *[]readonly char, mod @ir.Module) @[]@irdata.PkgGlobalEntry {
	var globals @[]@irdata.PkgGlobalEntry
	for i := 0; i < len(mod.Globals); i++ {
		var g @ir.Global = mod.Globals[i]
		if g.IsExtern { continue }
		if !g.Exported { continue }
		var storageSym @[]char = globalSymFor(pkgName, g.Name)
		globals = slices.Append[@irdata.PkgGlobalEntry](globals,
				irdata.NewPkgGlobalEntry(catSymAA64(storageSym, "__glinfo"), catSymAA64(storageSym, "__glname"),
						mangle.QualifyName(pkgName, g.Name), storageSym))
	}
	return globals
}

// collectVtablesAA64 gathers the VtableInfo rows: one per NON-generic impl this
// package defines.  Name is the BARE canonical vtable name (the VM's
// findIfaceVtable / BC_IFACE_VALUE key); Addr/ShimAddr target the
// format-prefixed @__ivt / @__ivtshim globals (implVtableNameNative).
func collectVtablesAA64(pkgName *[]readonly char, mod @ir.Module) @[]@irdata.PkgVtableEntry {
	var vtables @[]@irdata.PkgVtableEntry
	for i := 0; i < len(mod.Impls); i++ {
		var info @ir.ImplInfo = mod.Impls[i]
		if info == nil { continue }
		if common.RecvTypeIsGenericInst(info.RecvTypeName) { continue }
		var bareName @[]char = common.ImplVtableBareName(info.RecvPkg, info.RecvTypeName, info.IfacePkg,
				info.IfaceName)
		var vtableSym @[]char = implVtableNameNative(info)
		vtables = slices.Append[@irdata.PkgVtableEntry](vtables,
				irdata.NewPkgVtableEntry(catSymAA64(vtableSym, "__vtinfo"), catSymAA64(vtableSym, "__vtname"),
						bareName, vtableSym, implShimVtableNameNative(info),
						ir.IfaceFullVtableSize(mod, info.IfacePkg, info.IfaceName)))
	}
	return vtables
}

// collectSatEntriesAA64 gathers the SatEntries table's node symbols: the
// object-format-prefixed `__satentry.<T,J>` symbol per distinct (T, J) in mod
// (ir.CollectSatEntries), matching the prefixed nodes emitSatEntriesNative
// emits.  The descriptor's backing array points at each (past its header).
func collectSatEntriesAA64(mod @ir.Module) @[]@[]char {
	var descs @[]@irdata.SatEntryDesc = ir.CollectSatEntries(mod)
	var syms @[]@[]char
	for i := 0; i < len(descs); i++ {
		syms = slices.Append[@[]char](syms, symPrefixed(descs[i].Sym))
	}
	return syms
}

// catSymAA64 concatenates a suffix onto a symbol name, returning a fresh slice
// (for the per-entry __fnname / __fninfo / __glname / __vtname symbols).
func catSymAA64(base @[]char, suffix *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(base)
	cb.Write(suffix)
	return buf.CopyStr(cb.String())
}
