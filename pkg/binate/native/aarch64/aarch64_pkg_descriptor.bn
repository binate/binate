package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/native/common"

// emitPackageDescriptor emits this module's reflect.Package descriptor node
// (shared layout via common.EmitPackageDescriptorData) plus the generated
// `_Package() @reflect.Package` accessor.  The native counterpart to the LLVM
// backend's emitPackageDescriptor (pkg/binate/codegen/emit_pkg_descriptor.bn):
// both produce the same `_Package` symbol (mangle.FuncName) and static-managed
// layout, so a cross-mode reference — e.g. the bytecode VM's
// RegisterStandardExterns taking `*func() @reflect.Package = rt._Package` —
// resolves to one definition regardless of which backend compiled the owning
// package.  Without the native half, any native-compiled module that another
// TU references `pkg._Package` from fails to link (undefined `_Package`).
// Emitted for every module; the linker dead-strips it where `_Package` is
// unreferenced, so unconditional emission costs nothing for unused ones.
func emitPackageDescriptor(a @asm.Assembler, pkgName *[]readonly char) {
	var pkgInfoSym @[]char = globalSymFor(pkgName, "_pkg_info")
	var pkgNameSym @[]char = globalSymFor(pkgName, "_pkgname")
	var funcSym @[]char = symFor(pkgName, "_Package")

	common.EmitPackageDescriptorData(a, pkgInfoSym, pkgNameSym, pkgName)

	// The accessor returns the payload pointer (node + the 2 managed-header
	// words = 16 bytes on the 64-bit native target) in X0.  A leaf with no
	// frame — address-of-node, += header, return.
	a.SetSection("text", -1)
	a.DefineLabel(funcSym)
	a.SetGlobal(funcSym)
	aarch64.Adrp(a, 0, pkgInfoSym)                 // X0 = page(node)
	aarch64.AddImmLabel(a, true, 0, 0, pkgInfoSym) // X0 += pageoff(node)
	aarch64.Add(a, true, 0, 0, aarch64.Imm(16))    // X0 += managed-header bytes
	aarch64.Ret(a)
}
