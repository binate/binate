package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/builtins/testing"

// emitPackageDescriptor must define the exported `__Package` accessor (the
// symbol cross-mode code references — e.g. the interpreter host's
// registerPackageDescriptorExterns) and the descriptor node, and emit the accessor as
// a 4-instruction leaf (adrp + add + add + ret = 16 bytes) returning the
// payload pointer.  End-to-end behavior is covered by conformance/532 on the
// native modes; this pins the symbols + accessor shape.
func TestEmitPackageDescriptorAA64() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitPackageDescriptor(a, "pkg/x", ir.NewModule("\"pkg/x\""))

	if a.LookupSymbol(symFor("pkg/x", "__Package")) < 0 {
		return "__Package accessor symbol not defined"
	}
	if a.LookupSymbol(globalSymFor("pkg/x", "__pkg_info")) < 0 {
		return "__pkg_info descriptor node not defined"
	}
	// The accessor lands in the "text" section (index 0, set by mkAsm-style
	// setup above): adrp + add(pageoff) + add(#16) + ret = 4 * 4 bytes.
	if a.Sections[0].Len != 16 {
		return "accessor should be 16 bytes (adrp+add+add+ret)"
	}
	return ""
}

// With PackageAccessorSig set (as IR-gen does for every reflect-loaded
// module), emitPackageDescriptor self-lists the __Package accessor — so even a
// module with NO exported funcs emits a (1-entry) __pkg_funcs array (funcCount
// > 0) plus the __Package FunctionInfo node + its name rodata.  The plain test
// above (no PackageAccessorSig) emits no array — that contrast is the guard.
// Byte-parity of the entry with the LLVM emitter is covered end-to-end by
// conformance/725 on the native modes.
func TestEmitPackageDescriptorSelfListsPackageAA64() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var mod @ir.Module = ir.NewModule("\"pkg/x\"")
	// Synthesize the func() @reflect.Package accessor type IR-gen stashes on
	// PackageAccessorSig: a managed pointer to a struct named exactly as the
	// real reflect.Package (so SigString matches).
	var noFields @[]@types.Field
	var reflectStruct @types.Type = types.MakeStructType("pkg/builtins/reflect.Package", noFields)
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.MakeManagedPtrType(reflectStruct)
	var noParams @[]@types.Param
	mod.PackageAccessorSig = types.MakeFuncValueType(noParams, results)
	emitPackageDescriptor(a, "pkg/x", mod)

	if a.LookupSymbol(globalSymFor("pkg/x", "__pkg_funcs")) < 0 {
		return "self-listed __Package should emit a __pkg_funcs array"
	}
	var base @[]char = symFor("pkg/x", mangle.QualifyName("pkg/x", "__Package"))
	if a.LookupSymbol(catSymAA64(base, "__fninfo")) < 0 {
		return "__Package FunctionInfo node symbol not defined"
	}
	if a.LookupSymbol(catSymAA64(base, "__fnname")) < 0 {
		return "__Package name rodata not defined"
	}
	return ""
}

// ifaceIdModuleAA64 builds a module "pkg/x" whose one function looks a box up
// with interface J (an OP_SAT_LOOKUP on J's marker), as an interface-target
// assertion does.
func ifaceIdModuleAA64() @ir.Module {
	var m @ir.Module = ir.NewModule("\"pkg/x\"")
	var f @ir.Func = ir.NewFunc("pkg/x", "f", make_slice(@ir.Param, 0), make_slice(@types.Type, 0))
	var b @ir.Block = ir.AddBlock(f, "entry")
	var rawPtr @types.Type = types.MakePointerType(types.TypUint8())
	irbuild.EmitSatLookup(b, irbuild.EmitConstNil(b, rawPtr),
			irbuild.EmitDataSymAddr(b, mangle.IfaceIdName("pkg/x", "J"), types.TypUint8()))
	m.AddFunc(f)
	return m
}

// A module whose code looks a box up with J lists J's marker in the descriptor's
// IfaceIds table: the row names the NEUTRAL marker (the VM's key) and targets the
// object-format-prefixed one this backend defines, and the descriptor defines the
// row's weak node and the `__pkg_ifaceids` array.
func TestEmitPackageDescriptorIfaceIdsAA64() testing.TestResult {
	var mod @ir.Module = ifaceIdModuleAA64()
	var marker @[]char = mangle.IfaceIdName("pkg/x", "J")
	var rows @[]@irdata.PkgIfaceIdEntry = collectIfaceIdsAA64(mod)
	if len(rows) != 1 { return fail("expected one IfaceIds row, for J") }
	if !charEq(rows[0].Name, marker) { return fail("the row should name the neutral marker") }
	if !charEq(rows[0].MarkerSym, symPrefixed(marker)) {
		return fail("the row should target the marker symbol this backend defines")
	}
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitPackageDescriptor(a, "pkg/x", mod)
	if a.LookupSymbol(globalSymFor("pkg/x", "__pkg_ifaceids")) < 0 {
		return fail("the descriptor should define the __pkg_ifaceids array")
	}
	if a.LookupSymbol(rows[0].NodeSym) < 0 {
		return fail("the descriptor should define J's IfaceIdInfo node")
	}
	return ""
}

// A module that looks nothing up lists no marker.
func TestEmitPackageDescriptorNoIfaceIdsAA64() testing.TestResult {
	if len(collectIfaceIdsAA64(ir.NewModule("\"pkg/x\""))) != 0 {
		return fail("a module with no satisfaction lookup should list no marker")
	}
	return ""
}
