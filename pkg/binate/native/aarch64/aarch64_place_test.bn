package "pkg/binate/native/aarch64"

import "pkg/binate/irbuild"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/native/place"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Function-placement filler on aarch64: BRK #0x5EED words, in 4-byte units,
// immediately before each function.

// placeFillWord is BRK #place.PLACE_FILL_IMM (0xD4200000 | imm16 << 5).
const placeFillWord uint32 = 0xD42BDDA0

// placeCapture is an ArchEmitter that forwards to inner and, instead of writing
// an object, keeps the assembler EmitObject finished in `out`, so a test sees the
// text EmitObject produced.
type placeCapture struct {
	inner *common.ArchEmitter
	out   @asm.Assembler
}

func (e *placeCapture) WordBytes() int { return e.inner.WordBytes() }

func (e *placeCapture) CallConv() callconv.CallConv { return e.inner.CallConv() }

func (e *placeCapture) SetPrefix(format *[]readonly char) { e.inner.SetPrefix(format) }

func (e *placeCapture) ClearPrefix() { e.inner.ClearPrefix() }

func (e *placeCapture) SymPrefixed(name *[]readonly char) @[]char {
	return e.inner.SymPrefixed(name)
}

func (e *placeCapture) ArchName() *[]readonly char { return e.inner.ArchName() }

func (e *placeCapture) ElfTextMappingSymbol(format *[]readonly char) *[]readonly char {
	return e.inner.ElfTextMappingSymbol(format)
}

func (e *placeCapture) PlaceUnit() int { return e.inner.PlaceUnit() }

func (e *placeCapture) EmitPlaceFill(a @asm.Assembler, nbytes int) {
	e.inner.EmitPlaceFill(a, nbytes)
}

func (e *placeCapture) EmitFunc(a @asm.Assembler, pkgName *[]readonly char, f @ir.Func,
		strings @[]ir.StringConst) {
	e.inner.EmitFunc(a, pkgName, f, strings)
}

func (e *placeCapture) EmitCEntryThunks(a @asm.Assembler, pkgName *[]readonly char,
		targets @[]@ir.Func) {
	e.inner.EmitCEntryThunks(a, pkgName, targets)
}

func (e *placeCapture) EmitFuncValueShims(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	e.inner.EmitFuncValueShims(a, pkgName, mod)
}

func (e *placeCapture) EmitStringTable(a @asm.Assembler, pkgName *[]readonly char,
		strings @[]ir.StringConst) {
	e.inner.EmitStringTable(a, pkgName, strings)
}

func (e *placeCapture) EmitGlobals(a @asm.Assembler, pkgName *[]readonly char,
		globals @[]@ir.Global) {
	e.inner.EmitGlobals(a, pkgName, globals)
}

func (e *placeCapture) EmitFuncValueVtables(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	e.inner.EmitFuncValueVtables(a, pkgName, mod)
}

func (e *placeCapture) EmitImplVtables(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	e.inner.EmitImplVtables(a, pkgName, mod)
}

func (e *placeCapture) EmitPackageDescriptor(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	e.inner.EmitPackageDescriptor(a, pkgName, mod)
}

func (e *placeCapture) ResolveFixups(a @asm.Assembler) { e.inner.ResolveFixups(a) }

func (e *placeCapture) WriteObject(a @asm.Assembler, format *[]readonly char,
		path *[]readonly char) bool {
	e.out = a
	return true
}

impl *placeCapture : common.ArchEmitter

// placeFuncs are the functions of the module placeEmit emits, in order.
func placeFuncs() @[]@[]char {
	return @[]@[]char{"main.First", "main.Sgn", "main.Loop", "main.Last"}
}

// placeCExportIdx is the index in placeFuncs of the #[c_export("ffi_sgn")]
// function.
const placeCExportIdx int = 1

// placeFunc builds placeFuncs()[i]: `{ return }`, except main.Sgn, a
// #[c_export("ffi_sgn")] function with an int8 parameter (so a C-entry
// normalization sits between its alias and its mangled entry), and main.Loop, a
// loop whose body branches back to its header.
func placeFunc(i int) @ir.Func {
	if i == placeCExportIdx {
		var params @[]@ir.Param = make_slice(@ir.Param, 1)
		params[0] = make(ir.Param)
		params[0].ID = 1
		params[0].Name = "b"
		params[0].Typ = types.TypInt8()
		var sgn @ir.Func = ir.NewFunc("", placeFuncs()[i], params, noResults)
		irbuild.EmitReturn(ir.AddBlock(sgn, "entry"), noArgs)
		var names @[]@[]char = make_slice(@[]char, 1)
		names[0] = buf.CopyStr("ffi_sgn")
		sgn.CExportNames = names
		return sgn
	}
	var f @ir.Func = ir.NewFunc("", placeFuncs()[i], noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	if i != 2 {
		irbuild.EmitReturn(entry, noArgs)
		return f
	}
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	irbuild.EmitJump(entry, header)
	irbuild.EmitBranch(header, irbuild.EmitConstBool(header, false), body, exit)
	irbuild.EmitJump(body, header)
	irbuild.EmitReturn(exit, noArgs)
	return f
}

// placeEmit runs EmitObject over placeFuncs in format under placement and returns
// the text it produced (nil on failure).
func placeEmit(format *[]readonly char, placement place.PlaceOptions) @asm.Assembler {
	var m @ir.Module = ir.NewModule("\"main\"")
	for i := 0; i < len(placeFuncs()); i++ {
		m.AddFunc(placeFunc(i))
	}
	var em aarch64Emitter
	var c placeCapture
	c.inner = &em
	var e *common.ArchEmitter = &c
	if !common.EmitObject(e, m, format, "unused.o", placement) {
		var none @asm.Assembler
		return none
	}
	return c.out
}

// placeAlone returns function i emitted on its own at offset 0 for format (fixups
// resolved): the bytes it must keep wherever placement puts it.
func placeAlone(format *[]readonly char, i int) @asm.Assembler {
	var em aarch64Emitter
	var e *common.ArchEmitter = &em
	e.SetPrefix(format)
	var a @asm.Assembler = mkAsm()
	var noStrings @[]ir.StringConst
	emitFunc(a, "main", placeFunc(i), noStrings)
	aarch64.ResolveFixups(a)
	e.ClearPrefix()
	return a
}

// placeSymOffset returns the offset of symbol name in a, or -1.
func placeSymOffset(a @asm.Assembler, name *[]readonly char) int {
	var i int = a.LookupSymbol(name)
	if i < 0 { return -1 }
	return cast(int, a.Symbols[i].Offset)
}

// placePrefix is format's symbol-linkage prefix: "_" on Mach-O, none on ELF.
func placePrefix(format *[]readonly char) *[]readonly char {
	if common.ObjFmtEq(format, "elf") { return "" }
	return "_"
}

// placeEntry returns the offset in a (emitted in format) of function i's first
// entry point: its C-export alias if it has one, else its mangled symbol.
func placeEntry(a @asm.Assembler, format *[]readonly char, i int) int {
	if i == placeCExportIdx { return placeSymOffset(a, buf.Concat(placePrefix(format), "ffi_sgn")) }
	return placeSymOffset(a, buf.Concat(placePrefix(format), mangle.FuncName("main", placeFuncs()[i])))
}

// placeWordAt returns the little-endian 32-bit word at byte offset off of a's text.
func placeWordAt(a @asm.Assembler, off int) uint32 {
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var d *[]uint8 = a.Sections[0].Data
	return cast(uint32, d[off]) | (cast(uint32, d[off + 1]) << 8) | (cast(uint32, d[off + 2]) << 16) |
			(cast(uint32, d[off + 3]) << 24)
}

// checkPlacedText checks the text of placeEmit(format, placement): each
// function's first entry point lies right after the previous function's end plus
// exactly the fill PlaceFillAfter asks for after that function and the fill
// PlaceFillBefore asks for before this one, all BRK #0x5EED words; each function
// keeps its bytes, the C-export function's mangled entry follows its alias, and
// the ELF "$x" mapping symbol stays at offset 0.  Some function must get a
// nonzero fill.
func checkPlacedText(format *[]readonly char, placement place.PlaceOptions) testing.TestResult {
	var a @asm.Assembler = placeEmit(format, placement)
	if a == nil || a.HasError { return fail("EmitObject must succeed") }
	if common.ObjFmtEq(format, "elf") && placeSymOffset(a, "$x") != 0 {
		return fail("$x must stay at .text offset 0")
	}
	var end int = 0
	// The fill after the previous function (a probed one has some).
	var post int = 0
	var total int = 0
	for i := 0; i < len(placeFuncs()); i++ {
		var sym @[]char = mangle.FuncName("main", placeFuncs()[i])
		var fill int = place.PlaceFillBefore(placement, sym, 4, end + post)
		var start int = placeEntry(a, format, i)
		if start != end + post + fill { return fail("a function must start right after its fill") }
		for k := end; k < start; k = k + 4 {
			if placeWordAt(a, k) != placeFillWord { return fail("the fill must be BRK #0x5EED") }
		}
		if i == placeCExportIdx && placeSymOffset(a, buf.Concat(placePrefix(format), sym)) <= start {
			return fail("the C-export normalization must sit between the alias and the mangled entry")
		}
		var alone @asm.Assembler = placeAlone(format, i)
		var n int = alone.Sections[0].Len
		for k := 0; k < n; k++ {
			if a.Sections[0].Data[start + k] != alone.Sections[0].Data[k] {
				return fail("placement must not change a function's bytes")
			}
		}
		end = start + n
		post = place.PlaceFillAfter(placement, sym, fill)
		total = total + fill + post
	}
	for k := end; k < end + post; k = k + 4 {
		if placeWordAt(a, k) != placeFillWord {
			return fail("the fill after a function must be BRK #0x5EED")
		}
	}
	if total == 0 { return fail("the seed should fill before some function") }
	return ""
}

// EmitPlaceFill emits BRK #0x5EED words and rejects a fill that is not a
// non-negative multiple of 4.
func TestAArch64EmitPlaceFill() testing.TestResult {
	var em aarch64Emitter
	var e *common.ArchEmitter = &em
	if e.PlaceUnit() != 4 { return fail("the aarch64 filler unit is 4 bytes") }
	var a @asm.Assembler = mkAsm()
	e.EmitPlaceFill(a, 12)
	if a.HasError || a.Sections[0].Len != 12 { return fail("a 12-byte fill emits 12 bytes") }
	for k := 0; k < 12; k = k + 4 {
		if placeWordAt(a, k) != placeFillWord { return fail("the fill must be BRK #0x5EED") }
	}
	var odd @asm.Assembler = mkAsm()
	e.EmitPlaceFill(odd, 6)
	if !odd.HasError { return fail("a fill that is not a multiple of 4 must be an error") }
	var neg @asm.Assembler = mkAsm()
	e.EmitPlaceFill(neg, -4)
	if !neg.HasError { return fail("a negative fill must be an error") }
	return ""
}

// Seed 0 emits exactly the text emitted without placement.
func TestAArch64PlaceSeedZeroUnchanged() testing.TestResult {
	setTarget64()
	var off place.PlaceOptions
	var zero place.PlaceOptions
	zero.Mode = place.PLACE_PHASE
	var a @asm.Assembler = placeEmit("elf", off)
	var b @asm.Assembler = placeEmit("elf", zero)
	if a == nil || b == nil { return fail("EmitObject must succeed") }
	if a.Sections[0].Len != b.Sections[0].Len { return fail("seed 0 must leave the text unchanged") }
	for k := 0; k < a.Sections[0].Len; k++ {
		if a.Sections[0].Data[k] != b.Sections[0].Data[k] {
			return fail("seed 0 must leave the text unchanged")
		}
	}
	if a.Sections[0].Align != b.Sections[0].Align { return fail("seed 0 must keep .text's alignment") }
	return ""
}

// In shift mode each function lands after its fill and keeps its bytes, in ELF
// and Mach-O.
func TestAArch64PlaceShiftKeepsFunctions() testing.TestResult {
	setTarget64()
	var placement place.PlaceOptions
	placement.Seed = 12345
	placement.Mode = place.PLACE_SHIFT
	var r testing.TestResult = checkPlacedText("elf", placement)
	if len(r) > 0 { return r }
	return checkPlacedText("macho", placement)
}

// In phase mode .text is 64-aligned and each function's first entry point (the
// C-export alias for main.Sgn) lands on its phase, at the same offset in ELF and
// Mach-O objects.
func TestAArch64PlacePhaseLandsOnPhase() testing.TestResult {
	setTarget64()
	var placement place.PlaceOptions
	placement.Seed = 7
	placement.Mode = place.PLACE_PHASE
	var r testing.TestResult = checkPlacedText("elf", placement)
	if len(r) > 0 { return r }
	r = checkPlacedText("macho", placement)
	if len(r) > 0 { return r }
	var elfText @asm.Assembler = placeEmit("elf", placement)
	var machoText @asm.Assembler = placeEmit("macho", placement)
	if elfText.Sections[0].Align != place.PLACE_SPAN ||
			machoText.Sections[0].Align != place.PLACE_SPAN {
		return fail("phase mode aligns .text to 64")
	}
	var k uint32 = cast(uint32, place.PLACE_SPAN / 4)
	for i := 0; i < len(placeFuncs()); i++ {
		var sym @[]char = mangle.FuncName("main", placeFuncs()[i])
		var phi int = 4 * cast(int, place.PlaceHash(placement.Seed, sym) % k)
		var eo int = placeEntry(elfText, "elf", i)
		if eo % place.PLACE_SPAN != phi { return fail("an ELF entry is off its phase") }
		if placeEntry(machoText, "macho", i) != eo {
			return fail("Mach-O must put a function where ELF does")
		}
	}
	return ""
}
