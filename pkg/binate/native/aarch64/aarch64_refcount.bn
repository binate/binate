package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// Inline refcount op handlers (OP_REFINC / OP_REFDEC) and the
// struct/array byte-copy (an OP_STORE of an aggregate) — extracted from
// aarch64_ops.bn to keep that file under the length cap.

// refincSeq is a module-scoped counter for unique skip labels in
// emitRefIncInline. Local labels (Lri_skip_<seq>) need to be unique
// across the entire emitted text section, not just per-function.
var refincSeq int

// refincSkipLabel formats the per-emission unique skip label.
func refincSkipLabel(seq int) @[]char {
	var out @strings.Builder = strings.NewBuilder()
	out.Write("Lri_skip_")
	stringutils.WriteInt(out, seq)
	return buf.CopyStr(out.String())
}

// emitRefIncInline lowers OP_REFINC to an inline RefInc fast path:
// nil-check, read the refcount header at a negative unscaled offset, then
// add+store.
//
// A negative refcount marks immortal static-managed data
// (rt.STATIC_REFCOUNT): TBNZ on the sign bit skips the count mutation.
//
//   CBZ  ptrReg, .Lri_skip_<seq>
//   LDUR refcount, [ptrReg, #-16]        ; header word; ptrReg untouched
//   TBNZ refcount, #63, .Lri_skip_<seq>  ; negative → immortal, skip
//   ADD  refcount, refcount, #1
//   STUR refcount, [ptrReg, #-16]
// .Lri_skip_<seq>:
//
// ptrReg is NOT mutated: LDUR/STUR are the UNSCALED, NON-writeback forms, so
// `[ptrReg, #-16]` reads/writes the header while leaving ptrReg holding the
// object pointer.  This matters because the register allocator may keep the
// managed pointer live in ptrReg across this op — a pre-index writeback
// (`LDR ..., [ptrReg, #-16]!`) would instead rewrite ptrReg to the header
// address and corrupt the value (a home-allocated pointer silently becoming
// ptr-16, surfaced as a make(T) returning a pointer 16 bytes low).  The
// earlier form computed the header into a scratch via `SUB`; LDUR/STUR fold
// the -16 into the access, dropping both the SUB and the scratch register.
func emitRefIncInline(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var ptrReg int = getOperand(a, rm, ins.Args[0].ID)
	if ptrReg < 0 { return }
	// The managed header is 2 pointer-sized words [refcount, free_fn]; the
	// refcount is one such word, whose immortal-static sentinel is its high
	// (sign) bit.  Derive header size + word width from ManagedHeaderSize()
	// (= 2 * ptrSize) so the fast-path is correct on an ILP32-on-aarch64 ABI
	// (arm64_32: 8-byte header, 32-bit refcount word, sentinel bit 31) as well
	// as LP64 (16-byte header, 64-bit refcount, bit 63).  Use ManagedHeaderSize
	// / ptrSize, NOT types.GetTarget().IntSize — the managed header is 2
	// POINTER-sized words, so its layout is pointer-derived; int-derived sizing
	// would be wrong on any ILP32-with-wide-int ABI (even though int == pointer
	// on every shipping target).  A 32-bit pointer is zero-extended in the 64-bit
	// register, so the pointer ops (CBZ, the address base) stay 64-bit; only
	// the refcount VALUE ops track the word width.
	var hdrBytes int = types.ManagedHeaderSize()
	var wordBytes int = hdrBytes / 2
	var rcW bool = wordBytes == 8
	var signBit int = wordBytes * 8 - 1
	var refcountReg int = scratchReg(rm)
	var skipLabel @[]char = refincSkipLabel(refincSeq)
	refincSeq = refincSeq + 1
	aarch64.Cbz(a, true, ptrReg, skipLabel)
	aarch64.Ldr(a, rcW, refcountReg, aarch64.MemUnscaled(ptrReg, -hdrBytes))
	aarch64.Tbnz(a, refcountReg, signBit, skipLabel) // negative → immortal static-managed
	aarch64.Add(a, rcW, refcountReg, refcountReg, aarch64.Imm(1))
	aarch64.Str(a, rcW, refcountReg, aarch64.MemUnscaled(ptrReg, -hdrBytes))
	a.DefineLabel(skipLabel)
}

// refdecSeq is a module-scoped counter for unique skip labels in
// emitRefDecInline (parallel to refincSeq).
var refdecSeq int

// emitFuncHandleAddr materializes the address of a function's static handle
// (`&___handle.<mangled>`) into rd via ADRP+ADD.  Shared by the OP_FUNC_HANDLE
// dispatch and the inline RefDec slow path, which sinks a folded dtor handle
// here so the ADRP+ADD runs only on the branch that frees.
func emitFuncHandleAddr(a @asm.Assembler, pkgName *[]readonly char, rd int,
		funcName *[]readonly char) {
	var label @[]char = handleSymFor(pkgName, funcName)
	a.SetGlobal(label)
	aarch64.Adrp(a, rd, label)
	aarch64.AddImmLabel(a, true, rd, rd, label)
}

// refdecSkipLabel formats the per-emission unique skip label.
func refdecSkipLabel(seq int) @[]char {
	var out @strings.Builder = strings.NewBuilder()
	out.Write("Lrd_skip_")
	stringutils.WriteInt(out, seq)
	return buf.CopyStr(out.String())
}

// emitRefDecInline lowers OP_REFDEC: nil-check + inline header
// load/sub/store, with a slow-path call to `rt.ZeroRefDestroy`
// when the decrement leaves the refcount at zero.
//
//   CBZ  ptrReg, .Lrd_skip_<seq>            ; nil → skip
//   LDUR refcount, [ptrReg, #-16]           ; header word; ptrReg untouched
//   TBNZ refcount, #63, .Lrd_skip_<seq>     ; negative → immortal, skip
//   SUB  refcount, refcount, #1
//   STUR refcount, [ptrReg, #-16]
//   CBNZ refcount, .Lrd_skip_<seq>          ; refcount > 0 → skip
//   ; slow path: refcount hit zero
//   MOV  X0, ptrReg
//   MOV  X1, dtorReg     (or MOVZ X1, #0 if no dtor)
//   BL   <`rt.ZeroRefDestroy`>
// .Lrd_skip_<seq>:
//
// Args[1] is the optional destructor; passed via X1 to the runtime
// helper. The BL clobbers caller-saved registers (X0–X18) but the
// branch target is the skip label, so no further uses follow within
// this emission. LDUR/STUR access the header at `[ptrReg, #-16]` without a
// writeback, so ptrReg still holds the object pointer for the X0 mov on the
// zero path (see emitRefIncInline for why the non-writeback unscaled form is
// required, and why it lets the SUB + scratch header register go).
func emitRefDecInline(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var ptrReg int = getOperand(a, rm, ins.Args[0].ID)
	if ptrReg < 0 { return }
	// See emitRefIncInline: header size, refcount width, and sentinel bit are
	// target-derived so the fast-path is ILP32-on-aarch64 correct; the pointer
	// op (CBZ) and the LDUR/STUR base stay 64-bit, only the refcount VALUE ops
	// track the word width.
	var hdrBytes int = types.ManagedHeaderSize()
	var wordBytes int = hdrBytes / 2
	var rcW bool = wordBytes == 8
	var signBit int = wordBytes * 8 - 1
	var refcountReg int = scratchReg(rm)
	var skipLabel @[]char = refdecSkipLabel(refdecSeq)
	refdecSeq = refdecSeq + 1
	aarch64.Cbz(a, true, ptrReg, skipLabel)
	aarch64.Ldr(a, rcW, refcountReg, aarch64.MemUnscaled(ptrReg, -hdrBytes))
	aarch64.Tbnz(a, refcountReg, signBit, skipLabel) // negative → immortal static-managed
	aarch64.Sub(a, rcW, refcountReg, refcountReg, aarch64.Imm(1))
	aarch64.Str(a, rcW, refcountReg, aarch64.MemUnscaled(ptrReg, -hdrBytes))
	aarch64.Cbnz(a, rcW, refcountReg, skipLabel)
	// Slow path: refcount hit zero. Set up X0=ptr, X1=dtor, call
	// `rt.ZeroRefDestroy`.
	if len(ins.Args) > 1 && ins.Args[1].Op == iropcode.OP_FUNC_HANDLE {
		// Static dtor handle: materialize `&___handle.<dtor>` HERE, past the
		// zero-test, rather than before it (so the ADRP+ADD runs only on the
		// branch that actually frees).  ptr -> X0 first; the handle
		// materialization writes only X1 and reads no operand, so a ptr homed in
		// X1 is safely copied out before X1 is overwritten.
		aarch64.Mov(a, true, aarch64.X0, aarch64.Reg(ptrReg))
		emitFuncHandleAddr(a, pkgName, aarch64.X1, ins.Args[1].StrVal)
	} else if len(ins.Args) > 1 {
		// Runtime-loaded dtor (OP_FUNC_VALUE_DTOR): ptr and dtor are both SSA
		// operands that may be homed in the arg bank (X0/X1); if they cross (ptr
		// in X1, dtor in X0) two naive moves would clobber each other, so realize
		// {X0<-ptr, X1<-dtor} as a parallel move (identity moves dropped, cycles
		// broken through X16).
		var dtorReg int = getOperand(a, rm, ins.Args[1].ID)
		if dtorReg < 0 { return }
		var mvSrcs @[]int = make_slice(int, 2)
		var mvDsts @[]int = make_slice(int, 2)
		mvSrcs[0] = ptrReg
		mvDsts[0] = aarch64.X0
		mvSrcs[1] = dtorReg
		mvDsts[1] = aarch64.X1
		var plan @[]int = common.PlanParallelMove(mvSrcs, mvDsts, aarch64.X16)
		for k := 0; k < len(plan); k = k + 2 {
			aarch64.Mov(a, true, plan[k], aarch64.Reg(plan[k + 1]))
		}
	} else {
		// ptr only (no dtor): X0 <- ptr (no-op if already X0), X1 = 0.  ptr is read
		// into X0 before X1 is zeroed, so a ptr homed in X1 is still safe.
		aarch64.Mov(a, true, aarch64.X0, aarch64.Reg(ptrReg))
		aarch64.Movz(a, true, aarch64.X1, 0, 0)
	}
	var callee @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "ZeroRefDestroy"))
	a.SetGlobal(callee)
	aarch64.Bl(a, callee)
	a.DefineLabel(skipLabel)
}

// emitStructCopy lowers an OP_STORE that is copying a struct (or
// array) as a byte-for-byte memcpy. Source pointer comes from Args[1]
// (which, per OP_LOAD's struct handling, is a pointer in a register);
// dest from Args[0]. Either endpoint may be a package-level global,
// reached via ADRP+ADD to the __DATA symbol.
func emitStructCopy(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	var sz int = ins.Args[1].Typ.SizeOf()
	if sz <= 0 { return }

	var srcPtr int
	if isGlobalRef(ins.Args[1]) {
		srcPtr = scratchReg(rm)
		emitGlobalAddr(a, pkgName, srcPtr, ins.Args[1])
	} else if common.IsMultiReturnCall(ins.Args[1]) {
		// Multi-return spill holds the N*8 bytes themselves; we
		// need the address of those bytes, not their first word.
		var srcOff int = rm.LookupSpill(ins.Args[1].ID)
		if srcOff < 0 { return }
		srcPtr = scratchReg(rm)
		aarch64.Add(a, true, srcPtr, aarch64.SP, aarch64.Imm(srcOff))
	} else {
		srcPtr = getOperand(a, rm, ins.Args[1].ID)
	}
	if srcPtr < 0 { return }

	var dstPtr int
	var allocOff int = rm.LookupAlloc(ins.Args[0].ID)
	if allocOff >= 0 {
		dstPtr = scratchReg(rm)
		aarch64.Add(a, true, dstPtr, aarch64.SP, aarch64.Imm(allocOff))
	} else if isGlobalRef(ins.Args[0]) {
		dstPtr = scratchReg(rm)
		emitGlobalAddr(a, pkgName, dstPtr, ins.Args[0])
	} else {
		dstPtr = getOperand(a, rm, ins.Args[0].ID)
	}
	if dstPtr < 0 { return }

	emitAggMemcpySafeAarch64(a, rm, dstPtr, srcPtr, sz)
}
