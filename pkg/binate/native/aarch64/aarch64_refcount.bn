package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// Inline refcount op handlers (OP_REFINC / OP_REFDEC) and the
// struct/array byte-copy (an OP_STORE of an aggregate) — extracted from
// aarch64_ops.bn to keep that file under the length cap.

// refincSeq is a module-scoped counter for unique skip labels in
// emitRefIncInline. Local labels (Lri_skip_<seq>) need to be unique
// across the entire emitted text section, not just per-function.
var refincSeq int

// refincSkipLabel formats the per-emission unique skip label.
func refincSkipLabel(seq int) @[]char {
	var out buf.CharBuf = buf.New()
	out = out.WriteStr("Lri_skip_")
	out = out.WriteInt(seq)
	return out.Bytes()
}

// emitRefIncInline lowers OP_REFINC to an inline RefInc fast path:
// nil-check, then a pre-indexed load that updates ptr to the header
// address and reads the refcount in one instruction, then add+store.
//
// A negative refcount marks immortal static-managed data
// (rt.STATIC_REFCOUNT): TBNZ on the sign bit skips the count mutation.
//
//   CBZ  ptrReg, .Lri_skip_<seq>
//   LDR  refcount, [ptrReg, #-16]!    ; ptrReg = ptr-16; refcount = *ptrReg
//   TBNZ refcount, #63, .Lri_skip_<seq> ; negative → immortal, skip
//   ADD  refcount, refcount, #1
//   STR  refcount, [ptrReg, #0]
// .Lri_skip_<seq>:
//
// Reusing ptrReg as the post-decrement header pointer is safe because
// spillAndReset clears the regmap after every instruction; subsequent
// uses of the SSA value reload from its spill slot.
func emitRefIncInline(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var ptrReg int = getOperand(a, rm, ins.Args[0].ID)
	if ptrReg < 0 { return }
	var refcountReg int = scratchReg(rm)
	var skipLabel @[]char = refincSkipLabel(refincSeq)
	refincSeq = refincSeq + 1
	aarch64.Cbz(a, true, ptrReg, skipLabel)
	aarch64.Ldr(a, true, refcountReg, aarch64.MemPre(ptrReg, -16))
	aarch64.Tbnz(a, refcountReg, 63, skipLabel)  // negative → immortal static-managed
	aarch64.Add(a, true, refcountReg, refcountReg, aarch64.Imm(1))
	aarch64.Str(a, true, refcountReg, aarch64.MemImm(ptrReg, 0))
	a.DefineLabel(skipLabel)
}

// refdecSeq is a module-scoped counter for unique skip labels in
// emitRefDecInline (parallel to refincSeq).
var refdecSeq int

// refdecSkipLabel formats the per-emission unique skip label.
func refdecSkipLabel(seq int) @[]char {
	var out buf.CharBuf = buf.New()
	out = out.WriteStr("Lrd_skip_")
	out = out.WriteInt(seq)
	return out.Bytes()
}

// emitRefDecInline lowers OP_REFDEC: nil-check + inline header
// load/sub/store, with a slow-path call to bn_pkg__builtins__rt__ZeroRefDestroy
// when the decrement leaves the refcount at zero.
//
//   CBZ  ptrReg, .Lrd_skip_<seq>            ; nil → skip
//   SUB  hdrReg, ptrReg, #16                ; hdrReg = ptr-16
//   LDR  refcount, [hdrReg, #0]
//   TBNZ refcount, #63, .Lrd_skip_<seq>     ; negative → immortal, skip
//   SUB  refcount, refcount, #1
//   STR  refcount, [hdrReg, #0]
//   CBNZ refcount, .Lrd_skip_<seq>          ; refcount > 0 → skip
//   ; slow path: refcount hit zero
//   MOV  X0, ptrReg
//   MOV  X1, dtorReg     (or MOVZ X1, #0 if no dtor)
//   BL   bn_pkg__builtins__rt__ZeroRefDestroy
// .Lrd_skip_<seq>:
//
// Args[1] is the optional destructor; passed via X1 to the runtime
// helper. The BL clobbers caller-saved registers (X0–X18) but the
// branch target is the skip label, so no further uses follow within
// this emission. Computing hdrReg via SUB rather than reusing a pre-
// indexed addressing trick keeps ptrReg alive for the X0 mov.
func emitRefDecInline(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var ptrReg int = getOperand(a, rm, ins.Args[0].ID)
	if ptrReg < 0 { return }
	var hdrReg int = scratchReg(rm)
	var refcountReg int = scratchReg(rm)
	var skipLabel @[]char = refdecSkipLabel(refdecSeq)
	refdecSeq = refdecSeq + 1
	aarch64.Cbz(a, true, ptrReg, skipLabel)
	aarch64.Sub(a, true, hdrReg, ptrReg, aarch64.Imm(16))
	aarch64.Ldr(a, true, refcountReg, aarch64.MemImm(hdrReg, 0))
	aarch64.Tbnz(a, refcountReg, 63, skipLabel)  // negative → immortal static-managed
	aarch64.Sub(a, true, refcountReg, refcountReg, aarch64.Imm(1))
	aarch64.Str(a, true, refcountReg, aarch64.MemImm(hdrReg, 0))
	aarch64.Cbnz(a, true, refcountReg, skipLabel)
	// Slow path: refcount hit zero. Set up X0=ptr, X1=dtor, call
	// bn_pkg__builtins__rt__ZeroRefDestroy. ptrReg may be X0 already, but Mov
	// is a no-op in that case; keep the line for clarity.
	aarch64.Mov(a, true, aarch64.X0, aarch64.Reg(ptrReg))
	if len(ins.Args) > 1 {
		var dtorReg int = getOperand(a, rm, ins.Args[1].ID)
		if dtorReg < 0 { return }
		aarch64.Mov(a, true, aarch64.X1, aarch64.Reg(dtorReg))
	} else {
		aarch64.Movz(a, true, aarch64.X1, 0, 0)
	}
	var callee @[]char = symPrefixed("bn_pkg__builtins__rt__ZeroRefDestroy")
	a.SetGlobal(callee)
	aarch64.Bl(a, callee)
	a.DefineLabel(skipLabel)
}

// emitStructCopy lowers an OP_STORE that is copying a struct (or
// array) as a byte-for-byte memcpy. Source pointer comes from Args[1]
// (which, per OP_LOAD's struct handling, is a pointer in a register);
// dest from Args[0]. Either endpoint may be a package-level global,
// reached via ADRP+ADD to the __DATA symbol.
func emitStructCopy(a @asm.Assembler, pkgName *[]readonly char,
	rm @common.RegMap, ins @ir.Instr) {
	var sz int = ins.Args[1].Typ.SizeOf()
	if sz <= 0 { return }

	var srcPtr int
	if isGlobalRef(ins.Args[1]) {
		srcPtr = scratchReg(rm)
		emitGlobalAddr(a, pkgName, srcPtr, ins.Args[1])
	} else if common.IsMultiReturnCall(ins.Args[1]) {
		// Multi-return spill holds the N*8 bytes themselves; we
		// need the address of those bytes, not their first word.
		var srcOff int = rm.LookupSpill(ins.Args[1].ID)
		if srcOff < 0 { return }
		srcPtr = scratchReg(rm)
		aarch64.Add(a, true, srcPtr, aarch64.SP, aarch64.Imm(srcOff))
	} else {
		srcPtr = getOperand(a, rm, ins.Args[1].ID)
	}
	if srcPtr < 0 { return }

	var dstPtr int
	var allocOff int = rm.LookupAlloc(ins.Args[0].ID)
	if allocOff >= 0 {
		dstPtr = scratchReg(rm)
		aarch64.Add(a, true, dstPtr, aarch64.SP, aarch64.Imm(allocOff))
	} else if isGlobalRef(ins.Args[0]) {
		dstPtr = scratchReg(rm)
		emitGlobalAddr(a, pkgName, dstPtr, ins.Args[0])
	} else {
		dstPtr = getOperand(a, rm, ins.Args[0].ID)
	}
	if dstPtr < 0 { return }

	var tmp int = scratchReg(rm)
	for off := 0; off < sz; off = off + 8 {
		aarch64.Ldr(a, true, tmp, aarch64.MemImm(srcPtr, off))
		aarch64.Str(a, true, tmp, aarch64.MemImm(dstPtr, off))
	}
}
