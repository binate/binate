package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/builtins/testing"

// Tests for the inline refcount op handlers in aarch64_refcount.bn.
// The opsMkAssembler / opsBytes helpers live in aarch64_ops_test.bn
// (same package), so they are shared rather than redefined here.

// emitRefIncInline lowers OP_REFINC to an inline fast path inside a
// CBZ-guarded diamond, plus the LDR-from-spill that getOperand emits to
// reload the pointer.  The header word is reached with LDUR/STUR at the
// negative unscaled offset [ptr, #-16] (non-writeback), so the pointer operand
// is never mutated — the register allocator may keep it live across this op —
// and no scratch header register or SUB is needed:
//   LDR (reload ptr):        4 bytes
//   CBZ ptr, skip:           4 bytes
//   LDUR refcount, [ptr,-16]:4 bytes
//   TBNZ #63, skip:          4 bytes (immortal static-managed short-circuit)
//   ADD #1:                  4 bytes
//   STUR refcount, [ptr,-16]:4 bytes
//   = 24 bytes total. No BL — inline form makes no runtime call.
func TestEmitRefIncInline() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_REFINC
	ins.Args = make_slice(@ir.Instr, 1)
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 5
	ins.Args[0] = arg
	emitRefIncInline(a, m, ins)
	if opsBytes(a) != 24 {
		return "OP_REFINC inline should emit LDR+CBZ+LDUR+TBNZ+ADD+STUR (24 bytes)"
	}
	return ""
}

// emitRefDecInline lowers OP_REFDEC to an inline sequence (no-dtor case) plus
// the LDR-from-spill that getOperand emits to reload the pointer.  The header
// word is reached with LDUR/STUR at [ptr, #-16] (non-writeback), so ptr stays
// live for the slow-path X0 mov and no SUB/scratch header register is needed:
//   LDR (reload ptr):        4 bytes
//   CBZ ptr, skip:           4 bytes
//   LDUR refcount, [ptr,-16]:4 bytes
//   TBNZ #63, skip:          4 bytes (immortal static-managed short-circuit)
//   SUB refcount, #1:        4 bytes
//   STUR refcount, [ptr,-16]:4 bytes
//   CBNZ refcount, skip:     4 bytes
//   MOV X0, ptr:             4 bytes
//   MOVZ X1, #0:             4 bytes (no-dtor case)
//   BL ZeroRefDestroy:       4 bytes
//   = 40 bytes total (no-dtor). With a dtor, an extra LDR (reload
//   from spill) + MOV X1 brings it to 48.
func TestEmitRefDecInline() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_REFDEC
	ins.Args = make_slice(@ir.Instr, 1)
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 5
	ins.Args[0] = arg
	emitRefDecInline(a, "m", m, ins)
	if opsBytes(a) != 40 {
		return "OP_REFDEC inline (no dtor) should emit 40 bytes"
	}
	return ""
}

// TestEmitRefDecInlineWithDtor: with-dtor case adds an LDR (reload
// dtor from spill) + MOV X1 in place of the no-dtor MOVZ X1, #0.
// Net +4 bytes over the no-dtor 40 → 44 bytes total.
func TestEmitRefDecInlineWithDtor() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 6)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_REFDEC
	ins.Args = make_slice(@ir.Instr, 2)
	var arg0 @ir.Instr = make(ir.Instr)
	arg0.ID = 5
	ins.Args[0] = arg0
	var arg1 @ir.Instr = make(ir.Instr)
	arg1.ID = 6
	ins.Args[1] = arg1
	emitRefDecInline(a, "m", m, ins)
	if opsBytes(a) != 44 {
		return "OP_REFDEC inline (with dtor) should emit 44 bytes"
	}
	return ""
}

// TestEmitRefDecInlineFuncHandleDtor: a static dtor handle (OP_FUNC_HANDLE) is
// materialized IN the slow path (MOV X0, ptr; ADRP X1; ADD X1) rather than
// reloaded from a spill slot before the zero-test.  No spill slot is registered
// for the handle — the emitter must not need one.
func TestEmitRefDecInlineFuncHandleDtor() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_REFDEC
	ins.Args = make_slice(@ir.Instr, 2)
	var arg0 @ir.Instr = make(ir.Instr)
	arg0.ID = 5
	ins.Args[0] = arg0
	var dtor @ir.Instr = make(ir.Instr)
	dtor.ID = 6
	dtor.Op = iropcode.OP_FUNC_HANDLE
	dtor.StrVal = "somedtor"
	ins.Args[1] = dtor
	emitRefDecInline(a, "m", m, ins)
	// Same instruction count as the no-dtor case: the MOVZ X1,#0 is replaced by
	// ADRP X1 + ADD X1 while the ptr MOV stays — but the reload the runtime-dtor
	// path needs is gone, and the ADRP/ADD sit AFTER the CBNZ zero-test.
	if opsBytes(a) != 44 {
		return "OP_REFDEC inline (func-handle dtor) should emit 44 bytes"
	}
	return ""
}

// The RefInc header read is a genuine LDUR (unscaled, negative offset), not a
// SUB-then-LDR.  Decode the 3rd emitted word (reload LDR, CBZ, then the header
// access): it must be a 64-bit load/store in the unscaled form — size=11 with
// the load/store-unscaled bits (top byte 0xF8), opc=01 (load, bit 22 set),
// addressing-mode bits [11:10] = 00 — with the imm9 sign bit (instruction bit
// 20) set, i.e. a NEGATIVE offset.  Checking the sign bit rather than the exact
// magnitude keeps this correct on both LP64 (-16) and ILP32 (-8) targets.  A
// byte count alone would not catch a wrong same-size encoding.
func TestEmitRefIncInlineHeaderIsLdurNeg() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_REFINC
	ins.Args = make_slice(@ir.Instr, 1)
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 5
	ins.Args[0] = arg
	emitRefIncInline(a, m, ins)
	var w uint32 = word32AA64(a, 8) // 3rd word = header access
	if ((w >> 24) & cast(uint32, 0xff)) != cast(uint32, 0xf8) {
		return "refinc header access must be a 64-bit LDUR/STUR (top byte 0xF8)"
	}
	if ((w >> 22) & cast(uint32, 1)) != cast(uint32, 1) {
		return "refinc header access must be a load (opc bit 22 set)"
	}
	if ((w >> 10) & cast(uint32, 0x3)) != cast(uint32, 0) {
		return "refinc header access must be the unscaled form (bits [11:10] = 00)"
	}
	if ((w >> 20) & cast(uint32, 1)) != cast(uint32, 1) {
		return "refinc header LDUR must use a negative offset (imm9 sign bit set)"
	}
	return ""
}
