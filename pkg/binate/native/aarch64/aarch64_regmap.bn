package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/std/fmt"

// ============================================================
// AArch64-specific register allocation over common.RegMap
// ============================================================
//
// Frame layout, lookups, and type predicates live in pkg/binate/native/common.
// This file owns the pieces that touch AArch64 registers or emit
// instructions: the scratch-register pool, the Ldr-on-use reload in
// getOperand, and the Str-on-result spill in spillAndReset.

// regPool is the callee-clobbered scratch set we hand out to values.
// X0..X7 are reserved for args/returns; X9..X15 are the primary
// caller-saved scratches (7 slots, indexed 0..6); X16/X17 are AAPCS
// IP0/IP1 — caller-saved intra-procedure scratches that the linker
// reserves for PLT veneers, so their contents are *undefined after
// any BL*.  We use them as the last two fallback slots (indexed 7..8)
// for the rare op patterns whose simultaneously-live scratch demand
// exceeds 7.
//
// Two disciplines must hold for the fallback slots to be safe:
//
//   1. BL discipline.  No emitter may read a pool-allocated reg after
//      a BL/BLR (the call clobbers X16/X17 from the linker side AND
//      X9..X15 by AAPCS).  Within an op this holds because emitters
//      read their operands before the BL (or ResetRegs after it — see
//      arm64_call.bn, arm64_call_indirect.bn, arm64_emit.bn's memcpy /
//      MakeManagedSlice sites).  ACROSS ops the retained value cache
//      (within-block retention) could otherwise carry a register past a
//      clobbering call, so spillAndReset drops the whole cache after any
//      instruction that emitted a branch or is an EmitsReturningBl op
//      (which covers arm64_ops.bn's RefDec slow path, whose ZeroRefDestroy
//      BL has no internal ResetRegs).  Tests pin the per-arg reset in
//      emitCall/emitReturn so a future refactor doesn't quietly drop it.
//   2. X16/X17 direct-use discipline.  emitCall (stack-arg load) and
//      emitCallIndirect (fn_ptr stash + stack-arg load) reference
//      X16/X17 directly outside the pool.  These uses are safe
//      because emitCall/emitCallIndirect call `rm.ResetRegs()` per
//      arg, which clears the occupancy claim set so allocReg keeps
//      handing out X9..X15 (never the X16/X17 last-resort slots)
//      inside those ops.  Any new op that wants to mix direct X16/X17
//      use with high pool pressure must apply the same per-arg reset.
//
// Index 9 still panics; that signals an op pattern wants 10+
// simultaneously-live scratches and structurally needs a different
// approach (spill-on-exhaustion, or per-arg reset like emitCall did).
// The panic prints `currentEmitOp` so the offending op identifies
// itself rather than requiring an instrumented rebuild to chase.
func regPool(i int) int {
	if i == 0 { return aarch64.X9 }
	if i == 1 { return aarch64.X10 }
	if i == 2 { return aarch64.X11 }
	if i == 3 { return aarch64.X12 }
	if i == 4 { return aarch64.X13 }
	if i == 5 { return aarch64.X14 }
	if i == 6 { return aarch64.X15 }
	if i == 7 { return aarch64.X16 }
	if i == 8 { return aarch64.X17 }
	fmt.Print("native arm64: regPool exhausted while emitting op=", currentEmitOp, "\n")
	panic(
			"native arm64: regPool exhausted (X9..X17 saturated); "
					"any op needing 10+ live scratches needs a per-arg "
					"ResetRegs or a spill strategy — see arm64_call.bn for "
					"the per-arg pattern")
	return 0 // unreachable
}

// currentEmitOp is set by emitInstr at the start of each lowering to
// the integer ir.OP_* constant of the instruction being emitted.  Used
// only by the regPool-exhaustion panic to identify which op pattern
// hit the saturation point — kept as a package-level var rather than
// threaded through the call chain because the panic is rare and the
// diagnostic value is high relative to the cost of an extra parameter.
var currentEmitOp int

// allocReg hands out a pool register (X9..X17) for the currently-emitting
// instruction, occupancy-aware for within-block value retention: it prefers a
// genuinely FREE register (one holding no retained value), and only under
// register pressure evicts a retained value — whose spill slot still holds it,
// so eviction is loss-free.  Registers this instruction already claimed
// (CurUsed) are never handed out again (nor is a still-needed operand
// evicted).  The returned register is marked used here.
func allocReg(m @common.RegMap) int {
	// Prefer a genuinely FREE cacheable register (X9..X15, regPool 0..6): not
	// claimed by this instruction, holding no retained value.
	for i := 0; i <= 6; i = i + 1 {
		var r int = regPool(i)
		if !m.IsUsed(r) && m.RegHeldBy(r) < 0 {
			m.MarkUsed(r)
			return r
		}
	}
	// Under register pressure, evict a retained value from a cacheable register
	// (its spill slot still holds it, so this is loss-free) and reuse it.
	for i := 0; i <= 6; i = i + 1 {
		var r int = regPool(i)
		if !m.IsUsed(r) {
			m.EvictReg(r)
			m.MarkUsed(r)
			return r
		}
	}
	// Last resort for a >7-live-scratch instruction: X16 (regPool 7), never
	// retained.  X17 (regPool 8) is deliberately NOT allocated to a value — the
	// assembler materialises a large `[sp,#imm]` LDR/STR base into X17, so a
	// value parked there would collide (rt=X17); keeping values out of X17
	// makes that conflict unreachable.
	if !m.IsUsed(regPool(7)) {
		m.MarkUsed(regPool(7))
		return regPool(7)
	}
	// Every allocatable pool register is claimed by the current instruction:
	// the pre-existing exhaustion case, reported by regPool's own panic.
	return regPool(9)
}

// scratchReg hands out an ephemeral register (not registered in the
// id→reg map). Used when we need working registers that won't outlive
// the current instruction.
func scratchReg(m @common.RegMap) int {
	return allocReg(m)
}

// nextReg allocates a register to hold SSA id's result.  A
// register-allocated value computes directly into its stable HOME register
// (callee-saved, X19..X28) — bypassing the transient scratch pool, so it is
// not stored back by spillAndReset and survives ResetRegs / block
// boundaries.  A spilled value takes a scratch-pool register and is recorded
// in the transient map (spillAndReset then stores it to its slot).
func nextReg(m @common.RegMap, id int) int {
	var home int = m.LookupHome(id)
	if home >= 0 { return home }
	var r int = allocReg(m)
	return m.AssignReg(id, r)
}

// getOperand returns the register holding SSA id. If the value isn't
// in the current regmap, it's reloaded from the spill slot into a
// fresh scratch register. For OP_ALLOC values — whose SSA identity is
// "pointer to the alloca's storage" — we materialize that pointer on
// demand as `add rd, sp, #alloc_off`. This lets `p := &x` work
// transparently: the IR doesn't have a separate OP_ADDR_OF; it just
// uses the alloca's own ID as the pointer value. Returns -1 if none
// of the mappings apply.
func getOperand(a @asm.Assembler, m @common.RegMap, id int) int {
	// A register-allocated value lives in its home register for its whole
	// lifetime — return it directly, with no reload.
	var home int = m.LookupHome(id)
	if home >= 0 { return home }
	// A retained value cached in a pool register (within-block retention) —
	// read it from the register, no reload.  Mark the register used so this
	// instruction's later scratch/result allocation won't reuse it.
	var r int = m.LookupReg(id)
	if r >= 0 {
		m.MarkUsed(r)
		return r
	}
	var allocOff int = m.LookupAlloc(id)
	if allocOff >= 0 {
		// An alloca address is `sp + off`, constant for the whole function, so
		// caching it (nextReg) for within-block reuse is always valid.
		var rd int = nextReg(m, id)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(allocOff))
		return rd
	}
	var off int = m.LookupSpill(id)
	if off >= 0 {
		// Reload the spilled value and cache it (nextReg) for within-block reuse.
		var rd int = nextReg(m, id)
		aarch64.Ldr(a, true, rd, aarch64.MemImm(aarch64.SP, off))
		return rd
	}
	return -1
}

// emitValOperand resolves an instruction to a register holding its
// VALUE — the value-operand analogue of getOperand, IsGlobalRef-aware.
// The IsGlobalRef pseudo (a top-level global's address used as an
// rvalue: `var p *int = &G`, `f(&G)`, `return &G`, `&G == &H`) has
// ID -1 and no SSA register, so getOperand misses every lookup and
// returns -1 — the value-operand site then drops the operand (call
// args / return) or stores garbage. Materialize the address into a
// fresh scratch register via ADRP+ADD (emitGlobalAddr) instead;
// otherwise defer to getOperand. Two distinct globals in one
// instruction (`&G == &H`) each get their own scratch, so neither
// clobbers the other. Mirrors emitValRef in pkg/binate/codegen and the
// address-position emitGlobalAddr handling in emitLoad/emitStore.
func emitValOperand(a @asm.Assembler, pkgName *[]readonly char, m @common.RegMap,
		ins @ir.Instr) int {
	if isGlobalRef(ins) {
		var rd int = scratchReg(m)
		emitGlobalAddr(a, pkgName, rd, ins)
		return rd
	}
	return getOperand(a, m, ins.ID)
}

// spillAndReset stores the result of a just-emitted instruction to its
// stack slot (if any) and clears the register map. Called after every
// instruction — the "spill everything" policy means each op loads
// operands, computes, then hands off to memory.
func spillAndReset(a @asm.Assembler, m @common.RegMap, ins @ir.Instr, branchEmitted bool) {
	if ins.ID >= 0 {
		var reg int = m.LookupReg(ins.ID)
		if reg >= 0 {
			var off int = m.LookupSpill(ins.ID)
			if off >= 0 {
				aarch64.Str(a, true, reg, aarch64.MemImm(aarch64.SP, off))
			}
		}
	}
	// Within-block value retention: keep the IDs/Regs cache live ACROSS
	// instructions so a later use reads a register (getOperand's LookupReg hit)
	// instead of reloading its spill slot.  The store above still runs for
	// every result, so a value stays recoverable from its slot after it is
	// evicted under register pressure or when the block ends.
	//
	// X16/X17 (AAPCS IP0/IP1) are never retained: call / closure / shim
	// emitters use them directly, bypassing the pool, so a value parked there
	// could be clobbered without an eviction.
	m.EvictReg(aarch64.X16)
	m.EvictReg(aarch64.X17)
	// A returning BL clobbers every caller-saved pool register (X9..X17); so
	// does any instruction that emitted a branch to an inline block the runtime
	// mainline skips (a bounds-check / refcount-inline fail path, or an inline
	// dtor BL — its fixup count grew).  Drop the whole cache after either so a
	// later instruction reloads from slots rather than reading a clobbered
	// register.  This runs after each instruction, so it also covers the
	// EmitsReturningBl ops whose BL has no internal ResetRegs (e.g.
	// emitRefDecInline's ZeroRefDestroy call).
	if branchEmitted || common.EmitsReturningBl(ins.Op) {
		m.ResetRegs()
	}
}
