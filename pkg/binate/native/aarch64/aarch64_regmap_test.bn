package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/native/common"
import "pkg/builtins/testing"

// Tests for the arm64-specific register allocation helpers. The
// arch-agnostic regmap / frame / predicate logic is tested in
// pkg/binate/native/common/common_test.bn; the aarch64.Ldr/Str paths
// (getOperand reload, handleResult / spillDirtyLive lazy spill) get
// end-to-end coverage from arm64_test.bn's EmitObject round-trips.

func nrm() @common.RegMap { return common.NewRegMap(common.AAPCS64()) }

func mkAssembler() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func TestNextRegAdvancesPool() testing.TestResult {
	var m @common.RegMap = nrm()
	var a int = nextReg(m, 1)
	var b int = nextReg(m, 2)
	if a == b { return "nextReg should hand out distinct regs" }
	if m.LookupReg(1) != a { return "id 1 should map to first reg" }
	if m.LookupReg(2) != b { return "id 2 should map to second reg" }
	return ""
}

// scratchReg hands out working registers from the pool (X9..X17) that are
// not registered in the id->reg map.  The occupancy-aware allocator returns
// a distinct register each call and marks it used (CurUsed), so a later
// scratch/operand/result allocation in the same instruction won't reuse it.
func TestScratchRegReturnsDistinctAndMarksUsed() testing.TestResult {
	var m @common.RegMap = nrm()
	var r0 int = scratchReg(m)
	var r1 int = scratchReg(m)
	if r0 == r1 { return "scratchReg should return distinct regs early on" }
	if !m.IsUsed(r0) || !m.IsUsed(r1) {
		return "scratchReg should mark each returned reg used"
	}
	return ""
}

// Pool capacity is 9 slots (X9..X17).  X16/X17 are the AAPCS IP0/IP1
// fallback slots — see regPool's contract.  Pin all nine to catch
// any silent narrowing back to 7.
func TestRegPoolCapacityNine() testing.TestResult {
	if regPool(0) != aarch64.X9 { return "slot 0 should be X9" }
	if regPool(1) != aarch64.X10 { return "slot 1 should be X10" }
	if regPool(2) != aarch64.X11 { return "slot 2 should be X11" }
	if regPool(3) != aarch64.X12 { return "slot 3 should be X12" }
	if regPool(4) != aarch64.X13 { return "slot 4 should be X13" }
	if regPool(5) != aarch64.X14 { return "slot 5 should be X14" }
	if regPool(6) != aarch64.X15 { return "slot 6 should be X15" }
	if regPool(7) != aarch64.X16 { return "slot 7 should be X16 (AAPCS IP0 fallback)" }
	if regPool(8) != aarch64.X17 { return "slot 8 should be X17 (AAPCS IP1 fallback)" }
	return ""
}

// getOperand on an alloca ID must materialize its address with
// `add rd, sp, #off` — the IR uses OP_ALLOC's own SSA value as the
// `&x` expression, so a regression here silently breaks any code
// that takes the address of a local or stores a struct through a
// variable. This was the +30-conformance-test fix; guard it.
func TestGetOperandMaterializesAllocaPointer() testing.TestResult {
	var a @asm.Assembler = mkAssembler()
	var m @common.RegMap = nrm()
	// Plant an alloca at SP-relative offset 8.
	m.AllocIDs = common.AppendInt(m.AllocIDs, 17)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 8)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 8)
	var r int = getOperand(a, m, 17)
	if r < 0 { return "getOperand on an alloca should not return -1" }
	// Expect a single ADD rd, SP, #8 = 4 bytes.
	if a.Sections[0].Len != 4 {
		return "alloca path should emit exactly one ADD"
	}
	// Subsequent calls for the same id should reuse the register
	// (common.LookupReg hit), so no new bytes are emitted.
	var r2 int = getOperand(a, m, 17)
	if r2 != r { return "second getOperand should return the same reg" }
	if a.Sections[0].Len != 4 {
		return "reuse of a live alloca reg must not emit"
	}
	return ""
}

// getOperand on an ID that's neither in the reg table, the alloc
// table, nor the spill table returns -1. Used as a bail-out by the
// emit handlers when an arg's provenance is unknown.
func TestGetOperandReturnsMinusOneForUnknownID() testing.TestResult {
	var a @asm.Assembler = mkAssembler()
	var m @common.RegMap = nrm()
	if getOperand(a, m, 42) != -1 {
		return "unknown id should return -1"
	}
	if a.Sections[0].Len != 0 {
		return "miss path shouldn't emit anything"
	}
	return ""
}

// getOperand on a spill-slot ID emits a single LDR to reload.
func TestGetOperandReloadsFromSpillSlot() testing.TestResult {
	var a @asm.Assembler = mkAssembler()
	var m @common.RegMap = nrm()
	m.SpillIDs = common.AppendInt(m.SpillIDs, 9)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var r int = getOperand(a, m, 9)
	if r < 0 { return "spill lookup should succeed" }
	if a.Sections[0].Len != 4 {
		return "spill reload should emit exactly one LDR"
	}
	return ""
}

// foldedAwayRegMap_aa64test returns a RegMap whose id 9 has a spill slot and is
// flagged in fold set `which` (0 FoldedImm, 1 FusedCmp, 2 TstFoldedAnd,
// 3 FusableGep, 4 FusableFieldGep, 5 FoldedDtor).
func foldedAwayRegMap_aa64test(which int) @common.RegMap {
	var m @common.RegMap = nrm()
	m.SpillIDs = common.AppendInt(m.SpillIDs, 9)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var flags @[]bool = make_slice(bool, 10)
	flags[9] = true
	if which == 0 { m.FoldedImm = flags }
	if which == 1 { m.FusedCmp = flags }
	if which == 2 { m.TstFoldedAnd = flags }
	if which == 3 { m.FusableGep = flags }
	if which == 4 { m.FusableFieldGep = flags }
	if which == 5 { m.FoldedDtor = flags }
	return m
}

// getOperand on a folded-away id (a folded immediate, fused compare, tst-folded
// AND, fused GEP, or folded dtor handle) fails loud — SetError and -1 — and emits
// nothing, even though the id has a spill slot: that slot is never written, so a
// reload would read garbage.  Without a fold flag the same id reloads (control).
func TestGetOperandFoldedAwayFailsLoud() testing.TestResult {
	for which := 0; which < 6; which++ {
		var a @asm.Assembler = mkAssembler()
		var m @common.RegMap = foldedAwayRegMap_aa64test(which)
		if getOperand(a, m, 9) != -1 { return "a folded-away id must return -1" }
		if !a.HasError { return "a folded-away id must SetError" }
		if a.Sections[0].Len != 0 { return "a folded-away id must not emit a reload" }
	}
	var ca @asm.Assembler = mkAssembler()
	var cm @common.RegMap = foldedAwayRegMap_aa64test(-1)
	if getOperand(ca, cm, 9) < 0 || ca.HasError { return "an unflagged spilled id must reload" }
	return ""
}

// isFpReg is exactly D0..D31: X registers, SP and XZR (whose value lies above the
// FP range) are GP-class.
func TestIsFpRegExactlyTheDRange() testing.TestResult {
	if !isFpReg(aarch64.D0) || !isFpReg(aarch64.D31) { return "D0 / D31 must be FP registers" }
	if isFpReg(aarch64.X0) || isFpReg(aarch64.X30) { return "X0 / X30 are not FP registers" }
	if isFpReg(aarch64.SP) || isFpReg(aarch64.XZR) { return "SP / XZR are not FP registers" }
	return ""
}
