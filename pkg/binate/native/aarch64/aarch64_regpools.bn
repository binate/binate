package "pkg/binate/native/aarch64"

import "pkg/binate/asm/aarch64"
import "pkg/binate/iropcode"

// Register pools handed to the linear-scan allocator: the GP class (AllocateRegisters)
// and the FP class (AllocateFpRegisters).

// aarch64AllocatablePool returns the registers the linear-scan allocator
// homes scalar values in: the callee-saved bank X19..X28.  Callee-saved so a
// homed value survives every call (preserved by our own prologue/epilogue and
// by callees), and disjoint from the X9..X17 scratch pool so operand reloads
// and op-internal scratch are unaffected.
func aarch64AllocatablePool() @[]int {
	var p @[]int = make_slice(int, 10)
	for i := 0; i < 10; i++ { p[i] = aarch64.X19 + i }
	return p
}

// aarch64CallerSavedHomePool returns the caller-saved registers the linear-scan
// allocator homes NON-clobber-spanning scalar values in: the AAPCS argument bank
// X0..X7.  Caller-saved (no prologue save), and only ever handed to values that
// do not live across a call, so a call clobbering them is harmless.  Disjoint from
// the X9..X17 scratch pool.  A value homed here is placed at calls/returns/entry by
// a parallel move (its home is itself an argument register), never a naive move.
func aarch64CallerSavedHomePool() @[]int {
	var p @[]int = make_slice(int, 8)
	for i := 0; i < 8; i++ { p[i] = aarch64.X0 + i }
	return p
}

// aarch64FpAllocatablePool returns the callee-saved FP registers the FP
// linear-scan pass homes call-spanning float values in: D8..D15.  Callee-saved
// per AAPCS (the prologue saves/restores whichever are used, via Fstr_d/Fldr_d),
// so a homed float survives every call.  D16/D17 are reserved as inline FP
// scratch (aarch64_float.bn), so they are excluded.
func aarch64FpAllocatablePool() @[]int {
	var p @[]int = make_slice(int, 8)
	for i := 0; i < 8; i++ { p[i] = aarch64.D8 + i }
	return p
}

// aarch64FpCallerSavedPool returns the caller-saved FP registers the FP pass
// homes NON-call-spanning float values in: D18..D31.  The arg/return registers
// D0..D7 are deliberately EXCLUDED (kept as pure arg/scratch), so an FP home
// never collides with an arriving or outgoing float arg register — call-arg /
// return marshalling needs no parallel move (it round-trips through the
// getOperand GP bridge), and float-param landing is a plain D->D move.
func aarch64FpCallerSavedPool() @[]int {
	var p @[]int = make_slice(int, 14)
	for i := 0; i < 14; i++ { p[i] = aarch64.D18 + i }
	return p
}

// aarch64TieOps returns the opcodes whose GP lowering reads every operand before
// it writes the result, so the allocator may give the result the register of an
// operand that dies there (RegClassDesc.TieOps): OP_COPY, and integer
// ADD/SUB/AND/OR/XOR/SHL/SHR, whose register and immediate-fold forms are each
// a single three-address instruction (plus an in-place narrow of rd).  MUL,
// DIV and REM are excluded: REM writes rd before its last read of lhs.
func aarch64TieOps() @[]int {
	var ops @[]int = make_slice(int, 8)
	ops[0] = iropcode.OP_COPY
	ops[1] = iropcode.OP_ADD
	ops[2] = iropcode.OP_SUB
	ops[3] = iropcode.OP_AND
	ops[4] = iropcode.OP_OR
	ops[5] = iropcode.OP_XOR
	ops[6] = iropcode.OP_SHL
	ops[7] = iropcode.OP_SHR
	return ops
}

// aarch64FpTieOps returns the FP pass's tie opcodes: OP_COPY only, whose float
// form reads the source through the GP bridge before it writes the D home.
func aarch64FpTieOps() @[]int {
	var ops @[]int = make_slice(int, 1)
	ops[0] = iropcode.OP_COPY
	return ops
}
