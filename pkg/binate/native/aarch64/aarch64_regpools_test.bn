package "pkg/binate/native/aarch64"

import "pkg/binate/asm/aarch64"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// The FP register pools handed to AllocateFpRegisters: callee-saved D8..D15 and
// caller-saved D18..D31.  The D0..D7 arg/return registers and D16/D17 scratch are
// deliberately excluded (see aarch64FpCallerSavedPool).
func TestFpRegisterPools() testing.TestResult {
	var callee @[]int = aarch64FpAllocatablePool()
	if len(callee) != 8 { return "FP callee pool must be D8..D15 (8 regs)" }
	if callee[0] != aarch64.D8 || callee[7] != aarch64.D15 {
		return "FP callee pool must span D8..D15"
	}
	var caller @[]int = aarch64FpCallerSavedPool()
	if len(caller) != 14 { return "FP caller pool must be D18..D31 (14 regs)" }
	if caller[0] != aarch64.D18 || caller[13] != aarch64.D31 {
		return "FP caller pool must span D18..D31"
	}
	// D0..D17 (arg registers + inline scratch) must be excluded.
	for i := 0; i < len(caller); i++ {
		if caller[i] >= aarch64.D0 && caller[i] <= aarch64.D17 {
			return "FP caller pool must exclude D0..D17 (args + scratch)"
		}
	}
	return ""
}

// The GP pools: callee-saved home bank X19..X28, caller-saved arg bank X0..X7.
func TestGpRegisterPools() testing.TestResult {
	var callee @[]int = aarch64AllocatablePool()
	if len(callee) != 10 { return "GP callee pool must be X19..X28 (10 regs)" }
	if callee[0] != aarch64.X19 || callee[9] != aarch64.X28 {
		return "GP callee pool must span X19..X28"
	}
	var caller @[]int = aarch64CallerSavedHomePool()
	if len(caller) != 8 { return "GP caller pool must be X0..X7 (8 regs)" }
	if caller[0] != aarch64.X0 || caller[7] != aarch64.X7 {
		return "GP caller pool must span X0..X7"
	}
	return ""
}

// The tie opcodes are exactly the audited ones: OP_COPY and integer
// ADD/SUB/AND/OR/XOR/SHL/SHR.  MUL, DIV and REM stay out.
func TestTieOps() testing.TestResult {
	var ops @[]int = aarch64TieOps()
	if len(ops) != 8 { return "the tie opcodes should be COPY and seven integer ops" }
	var want @[]int = make_slice(int, 8)
	want[0] = iropcode.OP_COPY
	want[1] = iropcode.OP_ADD
	want[2] = iropcode.OP_SUB
	want[3] = iropcode.OP_AND
	want[4] = iropcode.OP_OR
	want[5] = iropcode.OP_XOR
	want[6] = iropcode.OP_SHL
	want[7] = iropcode.OP_SHR
	for i := 0; i < 8; i++ {
		if ops[i] != want[i] { return "unexpected tie opcode" }
		if ops[i] == iropcode.OP_MUL || ops[i] == iropcode.OP_DIV || ops[i] == iropcode.OP_REM {
			return "MUL/DIV/REM must not tie"
		}
	}
	return ""
}

// The FP pass ties only copies.
func TestFpTieOps() testing.TestResult {
	var ops @[]int = aarch64FpTieOps()
	if len(ops) != 1 || ops[0] != iropcode.OP_COPY { return "the FP pass should tie only OP_COPY" }
	return ""
}
