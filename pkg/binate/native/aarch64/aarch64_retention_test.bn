package "pkg/binate/native/aarch64"

import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// Unit tests for aarch64RetentionSafe (aarch64_retention.bn): which ops the
// within-block retained value cache may flow through.  aarch64 is LP64 with a
// hardware FP file, so the classifier keys purely on the op code (no per-type
// refinement, unlike arm32's soft-float / int64-pair paths).

// The arithmetic / compare / cast / unary / pointer / load-store / copy ops are
// retention-safe (allocReg-clean, no cache reset, no hardcoded pool register).
func TestAarch64RetentionSafeCleanOps() testing.TestResult {
	if !aarch64RetentionSafe(iropcode.OP_ADD) { return "OP_ADD must be retention-safe" }
	if !aarch64RetentionSafe(iropcode.OP_LT) { return "OP_LT must be retention-safe" }
	if !aarch64RetentionSafe(iropcode.OP_LOAD) { return "OP_LOAD must be retention-safe" }
	if !aarch64RetentionSafe(iropcode.OP_GET_FIELD_PTR) {
		return "OP_GET_FIELD_PTR must be retention-safe"
	}
	return ""
}

// Ops whose emitter resets the cache / emits a returning call / materializes via
// a hardcoded path (calls, const materialization, refcount, guards) are NOT
// retention-safe, so the driver barriers before them.
func TestAarch64RetentionSafeBarrierOps() testing.TestResult {
	if aarch64RetentionSafe(iropcode.OP_CALL) { return "OP_CALL must NOT be retention-safe" }
	if aarch64RetentionSafe(iropcode.OP_CONST_INT) {
		return "OP_CONST_INT must NOT be retention-safe"
	}
	if aarch64RetentionSafe(iropcode.OP_BRANCH) { return "OP_BRANCH must NOT be retention-safe" }
	return ""
}
