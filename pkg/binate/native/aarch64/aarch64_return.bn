package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// emitReturn lowers OP_RETURN on AArch64.  Four shapes: a single
// aggregate >64 bytes via AAPCS sret (memcpy through the X8 pointer
// stashed at SretSlotOff); a multi-return tuple >64 bytes via sret,
// written per-field at the MultiReturnType offsets; a single float
// scalar in D0; and otherwise the value(s) packed into X0..X7 (an
// aggregate spreads across consecutive regs).  Split out of
// aarch64_dispatch.bn (the dispatcher delegates here) for file-size
// hygiene.
func emitReturn(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	// A single HFA return rides its 1-4 float members in D0..D(n-1) (SIMD),
	// not GP-packed and not sret — must precede the general-aggregate branch
	// below, since an HFA is also an aggregate.  Members are contiguous at
	// m*memW in the value's memory image, so load each into D0+m.
	if len(ins.Args) == 1 && rm.CC.ReturnsHfaInRegs(ins.Args[0].Typ) {
		var hptr int = getOperand(a, rm, ins.Args[0].ID)
		if hptr >= 0 {
			n, memW := types.HfaClassify(ins.Args[0].Typ)
			for m := 0; m < n; m++ {
				hfaMemberLoadToFp(a, aarch64.D0 + m, hptr, m * memW, memW)
			}
		}
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	// A single aggregate return: pack into X0..X(N-1) when N≤8
	// (size ≤ 64 bytes). For sizes > 64 bytes, AAPCS sret —
	// memcpy through the X8 pointer the caller stashed in
	// SretSlotOff, then return void.
	if len(ins.Args) == 1 && common.IsAggregateTyp(ins.Args[0].Typ) {
		var ptr int = getOperand(a, rm, ins.Args[0].ID)
		if ptr >= 0 {
			var nWords int = common.ArgWords(ins.Args[0].Typ)
			if rm.SretSlotOff >= 0 {
				var dstPtr int = scratchReg(rm)
				aarch64.Ldr(a, true, dstPtr, aarch64.MemImm(aarch64.SP, rm.SretSlotOff))
				var tmp int = scratchReg(rm)
				for ri := 0; ri < nWords; ri++ {
					aarch64.Ldr(a, true, tmp, aarch64.MemImm(ptr, 8 * ri))
					aarch64.Str(a, true, tmp, aarch64.MemImm(dstPtr, 8 * ri))
				}
			} else {
				for ri := 0; ri < nWords && ri < 8; ri++ {
					aarch64.Ldr(a, true, argReg(ri), aarch64.MemImm(ptr, 8 * ri))
				}
			}
		}
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	// Multi-return tuple > 64 bytes: AAPCS-style sret. The caller
	// stashed &tupleBuffer in our SretSlotOff at entry; load it
	// back, then write each return value through it at the
	// MultiReturnType field offset. Mirrors the single-aggregate
	// sret path above, but per-arg.
	if rm.SretSlotOff >= 0 && rm.MultiReturnType != nil && len(ins.Args) > 1 {
		// dstPtr stays live across the loop; reload it from the
		// sret slot each iteration into a fresh scratch reg so
		// the per-arg ResetRegs below doesn't strand it.  Reload
		// is two instructions cheaper than the alternative of
		// holding a callee-saved reg dedicated to dstPtr.
		for ai := 0; ai < len(ins.Args); ai++ {
			var dstPtr int = scratchReg(rm)
			aarch64.Ldr(a, true, dstPtr, aarch64.MemImm(aarch64.SP, rm.SretSlotOff))
			var arg @ir.Instr = ins.Args[ai]
			var fldOff int = rm.MultiReturnType.FieldOffset(ai)
			if common.IsAggregateTyp(arg.Typ) {
				var ptr int = getOperand(a, rm, arg.ID)
				if ptr < 0 {
					rm.ResetRegs()
					continue
				}
				var nWords int = common.ArgWords(arg.Typ)
				var tmp int = scratchReg(rm)
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true, tmp, aarch64.MemImm(ptr, 8 * w))
					aarch64.Str(a, true, tmp, aarch64.MemImm(dstPtr, fldOff + 8 * w))
				}
			} else {
				var src int = emitValOperand(a, pkgName, rm, arg)
				if src < 0 {
					rm.ResetRegs()
					continue
				}
				var sz int = arg.Typ.SizeOf()
				if sz <= 0 { sz = 8 }
				emitScalarStore(a, src, dstPtr, fldOff, sz)
			}
			// Each arg's scratch regs (dstPtr, ptr/src, tmp) are
			// dead after the Ldr/Str sequence consumes them into
			// the sret buffer.  Mirrors emitCall's per-arg reset
			// (arm64_call.bn) to keep the X9..X15 pool from
			// saturating on long multi-return signatures.
			rm.ResetRegs()
		}
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	// Single float scalar: AAPCS64 returns it in D0, not X0.  Every
	// native value lives in a GP spill slot, so FMOV the bits from a
	// GP reg into D0 (mirrors x64's XMM0 return).  Without this the
	// callee would leave the result in X0 and an AAPCS64 caller —
	// LLVM-compiled or native after the matching caller-side fix —
	// reads 0 from D0.  Multi-return tuples below still pack their
	// fields into X0..X7.
	if len(ins.Args) == 1 && common.IsFloatScalarTyp(ins.Args[0].Typ) {
		var src int = emitValOperand(a, pkgName, rm, ins.Args[0])
		if src >= 0 {
			aarch64.Fmov_gp_to_fp(a, aarch64.D0, src)
		}
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	// Multi-return / scalar-tuple return ≤64 bytes: pack values per the
	// per-field register-class convention LLVM lowers a tuple by — integer
	// / aggregate words into X0.. (ngrn), float scalars into D0.. (nsrn) —
	// so `(int, float64)` packs X0 + D0 (not X0:X1) and `(float64,
	// float64)` packs D0,D1.  Packing a float into a GP reg would leave the
	// D reg the caller (LLVM or the matching native collect) reads as 0
	// (conformance/683).
	var ngrn int = 0
	var nsrn int = 0
	for ai := 0; ai < len(ins.Args); ai++ {
		var arg @ir.Instr = ins.Args[ai]
		if common.IsFloatScalarTyp(arg.Typ) {
			var src int = emitValOperand(a, pkgName, rm, arg)
			if src < 0 { continue }
			if nsrn < 8 {
				aarch64.Fmov_gp_to_fp(a, aarch64.D0 + nsrn, src)
			}
			nsrn = nsrn + 1
		} else if common.IsAggregateTyp(arg.Typ) {
			var ptr int = getOperand(a, rm, arg.ID)
			if ptr < 0 { continue }
			var nWords int = common.ArgWords(arg.Typ)
			for w := 0; w < nWords && ngrn < 8; w++ {
				aarch64.Ldr(a, true, argReg(ngrn), aarch64.MemImm(ptr, 8 * w))
				ngrn = ngrn + 1
			}
		} else {
			var src int = emitValOperand(a, pkgName, rm, arg)
			if src < 0 { continue }
			if ngrn < 8 && src != argReg(ngrn) {
				aarch64.Mov(a, true, argReg(ngrn), aarch64.Reg(src))
			}
			ngrn = ngrn + 1
		}
		// Per-arg scratch is dead once consumed into its return reg.
		// Mirrors emitCall's per-arg reset (arm64_call.bn) — long
		// return-arg lists (e.g. 8+ returns or aggregate-loaded
		// arg slots) otherwise saturate X9..X15.
		rm.ResetRegs()
	}
	emitEpilogueAndRet(a, rm.FrameSize())
	return
}
