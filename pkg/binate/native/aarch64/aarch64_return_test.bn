package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Coverage for aarch64_return.bn — emitReturn, the OP_RETURN lowering
// (single-aggregate sret, multi-return sret, single-float D0, and the
// X0..X7 pack).  Most return behavior is exercised end-to-end by the
// conformance abi matrix; this pins the reg-pool-reset invariant directly.
// mkAsm / bytesWritten / fail come from aarch64_emit_test.bn (same package).

// OP_RETURN multi-return (pack into X0..X7) walks `len(ins.Args)`
// getOperand calls and must reset the regmap between args.  Each
// getOperand on a spill-mapped ID advances rm.Next; without the reset
// nine scalar return values saturate the X9..X15 scratch pool and trip
// the regPool panic ("regPool exhausted while emitting op=45
// (OP_RETURN)").  emitCall (aarch64_call.bn) resets between args the
// same way.
func TestEmitReturnManyValuesDoesNotSaturateRegPool() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS64())
	// Build nine scalar int return values, each backed by a unique
	// spill slot so getOperand has to reload.  Without the per-arg
	// regmap reset the 8th iteration's nextReg(rm) panics; with it
	// the loop produces nine moves (or Ldrs into argReg) and
	// reaches the epilogue.
	var nArgs int = 9
	var args @[]@ir.Instr = make_slice(@ir.Instr, nArgs)
	for i := 0; i < nArgs; i++ {
		rm.SpillIDs = common.AppendInt(rm.SpillIDs, 100 + i)
		rm.SpillOffsets = common.AppendInt64(rm.SpillOffsets, cast(int64, 8 * i))
		var arg @ir.Instr = make(ir.Instr)
		arg.ID = 100 + i
		arg.Typ = types.TypInt()
		args[i] = arg
	}
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_RETURN
	ins.Args = args
	var noStrings @[]ir.StringConst
	emitInstr(a, "main", "fn", rm, noStrings, ins)
	// Survival is the test — without the reset this panics on the 8th arg.
	// The exact byte count varies with epilogue layout; just check
	// something was emitted.
	if bytesWritten(a) == 0 {
		return fail("OP_RETURN multi-return must emit at least one instruction")
	}
	return ""
}
