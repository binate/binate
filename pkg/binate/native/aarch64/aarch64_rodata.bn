package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"

// String / rodata materialization op handlers — OP_STRING_TO_CHARS,
// OP_RODATA_ARRAY, OP_RODATA_MSLICE / OP_RODATA_SLICE, and the inline
// byte-store helper they share.  Extracted from aarch64_emit.bn to keep
// that file under the length cap.

// emitStringToCharsCopy: Stage 2b lowering. Allocates a fresh
// managed-slice via the runtime, then writes the literal bytes
// inline into the new backing. Sequence:
//
//   X0 = 1, X1 = strLen, X8 = &data_region (sret buffer)
//   calls `rt.MakeManagedSlice`            → writes 32-byte slice header
//                                         via X8 into data_region
//   X0 = LDR data_region[0]           (data ptr — first word of slice header)
//   ; per-byte: emitConstInt64 X9, <byte_value>; STRB W9, [X0, #i]
//   ADD rd, SP, #data_region          (produce aggregate pointer)
//
// Inline byte stores instead of a libc.Memcpy call keeps the
// generated machine code free of any libc memory primitive.  Same
// shape as the LLVM-codegen side.
func emitStringToCharsCopy(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr,
		bytes *[]readonly char) {
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	var strLen int = len(bytes)

	emitConstInt64(a, aarch64.X0, 1)
	emitConstInt64(a, aarch64.X1, cast(int64, strLen))
	aarch64.Add(a, true, aarch64.X8, aarch64.SP, aarch64.Imm(dataOff))
	var mkSym @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "MakeManagedSlice"))
	a.SetGlobal(mkSym)
	aarch64.Bl(a, mkSym)
	// Reload the data pointer (first word of the slice header) from
	// the data region — destination of the inline byte writes below.
	aarch64.Ldr(a, true, aarch64.X0, aarch64.MemImm(aarch64.SP, dataOff))
	emitInlineByteStoresAA64(a, aarch64.X0, bytes, strLen)
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
}

// emitStringToArray: OP_RODATA_ARRAY. `var s [N]char = "..."`
// allocates a fresh N-byte buffer in the data region, zeroes it,
// then memcpys the first strLen bytes from rodata into the head.
// strLen is enforced ≤ N at IR-gen time. Result is a pointer to the
// buffer; downstream OP_STORE struct-copy memcpys it into the
// destination alloca.
func emitStringToArray(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	var bytes @[]char = ins.StrVal
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	var arrLen int = 0
	var arrTyp @types.Type = common.UnwrapNamed(ins.Typ)
	if arrTyp != nil && arrTyp.Kind == types.TYP_ARRAY {
		arrLen = arrTyp.ArrayLen
	}
	if arrLen <= 0 { return }
	var strLen int = len(bytes)
	if strLen > arrLen { strLen = arrLen }

	// Zero-fill the entire reserved buffer (rounded up to 8 bytes by
	// PlanFrame) in 64-bit chunks. Covers the tail past strLen and
	// keeps any padding bytes deterministic.
	var bufSz int = rm.LookupAllocSize(ins.ID)
	var i int = 0
	for i < bufSz {
		aarch64.Str(a, true, aarch64.XZR, aarch64.MemImm(aarch64.SP, dataOff + i))
		i = i + 8
	}
	if strLen > 0 {
		aarch64.Add(a, true, aarch64.X0, aarch64.SP, aarch64.Imm(dataOff))
		emitInlineByteStoresAA64(a, aarch64.X0, bytes, strLen)
	}
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
}

// emitInlineByteStoresAA64 emits a per-byte store sequence:
//
//   movz w9, #<byte0>
//   strb w9, [<base>, #0]
//   movz w9, #<byte1>
//   strb w9, [<base>, #1]
//   ...
//
// Used by emitStringToCharsCopy / emitStringToArray to write a
// string literal's bytes into the dst buffer inline, instead of
// calling `libc.Memcpy`.  X9 is the scratch register; the
// SysV/AAPCS64 ABI lets caller-saved temporaries use X9..X15
// freely after any call has returned, and we're past the call
// here.
func emitInlineByteStoresAA64(a @asm.Assembler, base int, data *[]readonly char, count int) {
	for i := 0; i < count; i++ {
		var b int = 0
		if i < len(data) { b = cast(int, data[i]) }
		emitConstInt64(a, aarch64.X9, cast(int64, b))
		aarch64.Strb(a, aarch64.X9, aarch64.MemImm(base, i))
	}
}

// emitRodataMSliceOrSlice (OP_RODATA_MSLICE / OP_RODATA_SLICE): the result is a
// pointer to the string's static managed-slice header `stringMSSym` — the
// 4-word { data, len, null refptr, backing_len=len } header emitted once by
// emitStringTable (via irdata.BuildStringMSHeader).  A managed-slice consumer reads
// all 4 words; a raw-slice consumer reads the {data, len} prefix.  No per-use
// stack construction — the header is immortal static data, so sharing one
// across uses is safe (matches the LLVM backend, which loads the same static
// `@.str.<id>.ms`).  The `.ms` is a weak data symbol, so reaching it from text
// goes through SetGlobal + ADRP+ADD (the emitGlobalAddr / iface-vtable pattern).
func emitRodataMSliceOrSlice(a @asm.Assembler, rm @common.RegMap, pkgName *[]readonly char,
		strings @[]ir.StringConst, ins @ir.Instr) {
	var sid int = ir.FindStringID(strings, ins.StrVal)
	if sid < 0 { return }
	var ms @[]char = stringMSSym(pkgName, sid)
	a.SetGlobal(ms)
	var rd int = nextReg(rm, ins.ID)
	aarch64.Adrp(a, rd, ms)
	aarch64.AddImmLabel(a, true, rd, rd, ms)
}
