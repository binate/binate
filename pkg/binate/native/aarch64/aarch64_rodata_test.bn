package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the string / rodata materialization op handlers in
// aarch64_rodata.bn.  Assembler / byte-count helpers live in
// aarch64_emit_test.bn (same package) and are shared.

// emitRodataMSliceOrSlice (OP_RODATA_MSLICE) returns a pointer to the string's
// STATIC managed-slice header (emitted once by emitStringTable) via ADRP + ADD
// = 2 insns = 8 bytes targeting that weak symbol — no per-use stack header
// construction.  (ADRP+ADD instead of ADR because Mach-O can't relocate ADR
// cross-section.)
func TestEmitStringToCharsManaged() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	// Pre-registered string id=0, any contents.
	var strings @[]ir.StringConst = make_slice(ir.StringConst, 1)
	var sc ir.StringConst
	sc.ID = 0
	sc.Data = "hi"
	strings[0] = sc
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 9)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = iropcode.OP_RODATA_MSLICE
	ins.Typ = types.MakeManagedSliceType(types.TypChar())
	ins.StrVal = "hi"
	emitRodataMSliceOrSlice(a, rm, "main", strings, ins)
	// ADRP + ADD = 2 insns = 8 bytes — just the address of the static .ms.
	if bytesWritten(a) != 8 {
		return "OP_RODATA_MSLICE should be ADRP+ADD of the static .ms (8 bytes)"
	}
	// The ADRP/ADD target the static managed-slice header symbol, NOT the blob.
	var msSym @[]char = stringMSSym("main", 0)
	var foundMSFixup bool = false
	for i := 0; i < a.Sections[0].NumFixups; i++ {
		if charEqAA64(a.Sections[0].Fixups[i].Label, msSym) {
			foundMSFixup = true
		}
	}
	if !foundMSFixup {
		return "the ADRP/ADD should target the static managed-slice header symbol"
	}
	return ""
}

// emitStringToCharsCopy: Stage 2b lowering, dispatched via the
// OP_RODATA_MSLICE_COPY op. Allocates a fresh managed-slice via the
// runtime then writes the literal bytes inline — `var s @[]char =
// "..."` must own its bytes (aliasing rodata and writing would
// SIGBUS).
//
// Sequence after plan-codegen-c-free-copies step 6 (inline byte
// stores replace memcpy): 2 MOVZ (elem=1, len) + ADD X8 (sret
// buffer) + BL MakeManagedSlice + LDR X0 (data ptr) + per-byte
// (MOVZ + STRB) for each of 2 bytes ("hi") + ADD rd.  6 fixed +
// 2*2 per-byte = 10 insns = 40 bytes.
func TestEmitStringToCharsStage2bCopy() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 9)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 32)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 9)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 32)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = iropcode.OP_RODATA_MSLICE_COPY
	ins.Typ = types.MakeManagedSliceType(types.TypChar())
	ins.StrVal = "hi"
	emitStringToCharsCopy(a, rm, ins, ins.StrVal)
	if bytesWritten(a) != 40 {
		return "Stage 2b copy should emit 10 insns / 40 bytes"
	}
	return ""
}

// emitStringToArray (now driven by OP_RODATA_ARRAY): zero-fill the
// buffer in 64-bit chunks then write strLen literal bytes inline.
// For [5]char (rounded up to 8 by PlanFrame): 1 STR XZR + ADD dst +
// per-byte (MOVZ + STRB) for each of 5 bytes ("abcde") + ADD rd.
// 3 fixed + 5*2 per-byte = 13 insns = 52 bytes.
func TestEmitStringToArray() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	// PlanFrame would round 5 up to 8; mirror that here.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 9)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 9)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = iropcode.OP_RODATA_ARRAY
	ins.Typ = types.MakeArrayType(types.TypChar(), 5)
	ins.StrVal = "abcde"
	emitStringToArray(a, rm, ins)
	if bytesWritten(a) != 52 {
		return "OP_RODATA_ARRAY [5]char should emit 13 insns / 52 bytes (inline byte stores)"
	}
	return ""
}
