package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the aa64 shift-count immediate fold (aa64ImmFits and
// emitShiftImmFold in aarch64_fold.bn).  Encodings are pinned to llvm-mc's
// (aarch64) for the same instruction, with the shifted value in X20 and the
// result in X21 (logicIns_aa64test's layout).

// shiftFolded_aa64test builds `x OP v` (the constant as the shifted value when
// constLhs) over type t and reports whether the constant folds.
func shiftFolded_aa64test(op int, t @types.Type, v int, constLhs bool) bool {
	var f @ir.Func
	var entry @ir.Block
	f, entry = foldFunc_aa64test()
	var c @ir.Instr = irbuild.EmitConstInt(entry, v, t)
	var x @ir.Instr = foldParam_aa64test(f, t)
	if constLhs {
		_ = irbuild.EmitBinop(entry, op, c, x, t)
	} else {
		_ = irbuild.EmitBinop(entry, op, x, c, t)
	}
	return foldFlags_aa64test(f)[c.ID]
}

// A constant count in [0, width) folds; a count at or above the width, a
// negative count and a constant shifted value do not.
func TestAa64ImmFitsShiftCount() testing.TestResult {
	if !shiftFolded_aa64test(iropcode.OP_SHL, types.TypInt(), 63, false) {
		return "int << 63 must fold"
	}
	if !shiftFolded_aa64test(iropcode.OP_SHR, types.TypUint32(), 0, false) {
		return "uint32 >> 0 must fold"
	}
	if shiftFolded_aa64test(iropcode.OP_SHL, types.TypInt(), 64, false) {
		return "int << 64 must not fold"
	}
	if shiftFolded_aa64test(iropcode.OP_SHR, types.TypUint8(), 8, false) {
		return "uint8 >> 8 must not fold"
	}
	if shiftFolded_aa64test(iropcode.OP_SHR, types.TypInt(), -1, false) {
		return "a negative count must not fold"
	}
	if shiftFolded_aa64test(iropcode.OP_SHL, types.TypInt(), 3, true) {
		return "a constant shifted value must not fold"
	}
	return ""
}

// shiftGolden_aa64test lowers `x OP v` of type t with a FoldedImm count and
// checks that it emits exactly the words w0 (and w1 when nonzero) with no error.
func shiftGolden_aa64test(op int, v int64, t @types.Type, w0 uint32, w1 uint32) bool {
	return logicGolden_aa64test(op, 1, v, t, w0, w1)
}

// X-form shifts: `lsl x21, x20, #3`, `asr x21, x20, #3` for a signed `>>`, `lsr
// x21, x20, #3` for an unsigned one, and a zero count (`lsr x21, x20, #0`, the
// UBFM that LSL #0 and LSR #0 share).
func TestEmitBinopShiftImmFoldXFormGoldens() testing.TestResult {
	var z uint32 = 0
	if !shiftGolden_aa64test(iropcode.OP_SHL, cast(int64, 3), types.TypInt(), 0xD37DF295, z) {
		return "int << 3 must emit exactly `lsl x21, x20, #3`"
	}
	if !shiftGolden_aa64test(iropcode.OP_SHR, cast(int64, 3), types.TypInt(), 0x9343FE95, z) {
		return "int >> 3 must emit exactly `asr x21, x20, #3`"
	}
	if !shiftGolden_aa64test(iropcode.OP_SHR, cast(int64, 3), types.TypUint(), 0xD343FE95, z) {
		return "uint >> 3 must emit exactly `lsr x21, x20, #3`"
	}
	if !shiftGolden_aa64test(iropcode.OP_SHL, cast(int64, 0), types.TypInt(), 0xD340FE95, z) {
		return "int << 0 must emit exactly the UBFM `lsr x21, x20, #0`"
	}
	return ""
}

// A uint32 shift runs in the W form with no re-narrow (`lsl w21, w20, #31`); an
// int8 shift runs in the X form and is re-narrowed (`asr x21, x20, #2` then
// `sxtb x21, w21`), as on the register path.
func TestEmitBinopShiftImmFoldWidths() testing.TestResult {
	var z uint32 = 0
	if !shiftGolden_aa64test(iropcode.OP_SHL, cast(int64, 31), types.TypUint32(), 0x53010295, z) {
		return "uint32 << 31 must emit exactly `lsl w21, w20, #31`"
	}
	if !shiftGolden_aa64test(iropcode.OP_SHR, cast(int64, 2), types.TypInt8(), 0x9342FE95,
			0x93401EB5) {
		return "int8 >> 2 must emit exactly `asr x21, x20, #2; sxtb x21, w21`"
	}
	return ""
}

// A count marked FoldedImm that does not fit (64 on an int shift) fails loud
// rather than encoding a masked shift or reading the unmaterialized constant.
func TestEmitBinopShiftImmFoldMisfitFailsLoud() testing.TestResult {
	var a @asm.Assembler
	a, _ = logicFold_aa64test(iropcode.OP_SHL, 1, cast(int64, 64), types.TypInt(), true)
	if !a.HasError { return "a folded int shift count of 64 must record an error" }
	return ""
}
