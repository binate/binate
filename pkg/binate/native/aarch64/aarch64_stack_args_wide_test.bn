package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Stack-argument, staging and closure-capture offsets past 2^31: the shims' frames are
// int64, and the asm layer forms an offset that does not fit a load or store in X17, so
// a 32-bit host compiles one too, and the shims shuttle a word through another
// register.  The golden encodings are clang's for the same instructions.

// A closure capturing a Big (indirect-large: passed by pointer) and then an int64 holds
// the int64 at 2^31 + 8 in its closure struct; the shim's capture loads reach it through
// X17, and pass the Big's address.  callconv lays out the capture arguments with the Big
// as one pointer word, without a word count past the host's int.
func TestCaptureRegLoadPast2GiBAA64() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = wideBigAA64()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt64()
	var f @ir.Func = make(ir.Func)
	f.Name = "main.__funclit_f"
	f.IsClosure = true
	f.NumCaptureParams = 2
	f.ClosureStruct = types.MakeStructType("__closure_f", fields)
	var argTypes @[]@types.Type = @[]@types.Type{fields[0].Type, fields[1].Type}
	var a @asm.Assembler = mkAsm()
	emitClosureCaptureRegLoadAA64(a, callconv.AAPCS64(), f, argTypes, aarch64.X9)
	return wideGoldenAA64(a, "d2800111 f2b00011 8b110131 f9400221 91000120",
			"a capture at 2^31 + 8 after a Big passed by pointer: ldr x1 through x17; add x0, x9, #0")
}

// A shim moving a user-argument word from the caller's stack, at 2^31 above its SP, to
// an outgoing stack slot at 2^31 + 16 reads and writes both through X17, shuttling the
// word in X16.
func TestUserArgWordMovePast2GiBAA64() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	// Word 7 of the user arguments, after the data word in X0: past the seven argument
	// registers X1..X7, so it is read from [SP + frameDelta].
	emitUserArgWordMoveAA64(a, 8, 0, 1, 0x80000000, -1, 0x80000010, 8, -1, types.TypInt64())
	return wideGoldenAA64(a, "d2b00011 8b3163f1 f9400230 d2800211 f2b00011 8b3163f1 f9000230",
			"a stack word moved from 2^31 to 2^31 + 16: ldr / str x16 through x17")
}

// The aggregate stack-spill shim stages seven incoming user words at 2^31: six from
// X2..X7, and one from the caller's stack at 2^31 + 2^28, shuttled in X16 since X17
// forms each address.
func TestStageUserWordsPast2GiBAA64() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitStageUserWordsAA64(a, callconv.AAPCS64(), 7, 2, 0x90000000, 0x80000000)
	return wideGoldenAA64(a,
			"d2b00011 8b3163f1 f9000222 d2800111 f2b00011 8b3163f1 f9000223 d2800211 f2b00011 "
					"8b3163f1 f9000224 d2800311 f2b00011 8b3163f1 f9000225 d2800411 f2b00011 8b3163f1 "
					"f9000226 d2800511 f2b00011 8b3163f1 f9000227 d2b20011 8b3163f1 f9400230 d2800611 "
					"f2b00011 8b3163f1 f9000230",
			"seven user words staged at 2^31, the last from the caller's stack through x16")
}

// A by-address 16-byte user argument the aggregate stack-spill shim places on the stack
// at 2^31: its pointer arrives in X2, and each word is shuttled in X10 to a slot whose
// address X17 forms.
func TestAggCoercedUserArgPast2GiBAA64() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitAggCoercedUserArgAA64(a, callconv.AAPCS64(), structTypeNInt64(2), 1, 0, -1, 0x80000000, -1)
	return wideGoldenAA64(a,
			"aa0203f0 f940020a d2b00011 8b3163f1 f900022a f940060a d2800111 f2b00011 8b3163f1 f900022a",
			"a by-address argument's two words stored at 2^31 and 2^31 + 8 through x10")
}
