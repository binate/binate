package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/native/common"

// emitStackFrames lowers OP_STACK_FRAMES (pkg/std/debug's from-code stacktrace
// capture) — the native-backend counterpart of codegen.emitStackFrames.  Where
// the LLVM backend seeds the walk with llvm.frameaddress(0), the native backend
// keeps the frame pointer in X29 (see the prologue: `stp x29,x30,[sp,#-16]!; mov
// x29,sp`), so X29/FP IS the current frame — no intrinsic needed.  It calls
// rt.CaptureNativeFrames(fp, skip, data, len), whose int result (frames at/above
// skip) becomes this instruction's value.
//
// Args[0] = skip (scalar), Args[1] = buf *[]Frame (a raw slice — an aggregate, so
// getOperand hands back a POINTER to its {data,len} image).  AAPCS64 args:
// X0=fp, X1=skip, X2=data, X3=len; result in X0.
//
// No parallel-move hazard: only two getOperand calls run, so the operands land in
// the first two pool registers (X9, X10 — see regPool), disjoint from the arg
// registers X0..X3 and from X29.  So each arg register is written directly with
// no risk of clobbering a still-needed source.
func emitStackFrames(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	var skipReg int = getOperand(a, rm, ins.Args[0].ID)
	var bufPtr int = getOperand(a, rm, ins.Args[1].ID)
	if skipReg < 0 || bufPtr < 0 { return }
	// buf's {data,len} words → X2, X3 (bufPtr is X9/X10, disjoint from X2/X3).
	aarch64.Ldr(a, true, aarch64.X2, aarch64.MemImm(bufPtr, 0)) // data
	aarch64.Ldr(a, true, aarch64.X3, aarch64.MemImm(bufPtr, 8)) // len
	aarch64.Mov(a, true, aarch64.X1, aarch64.Reg(skipReg)) // skip
	aarch64.Mov(a, true, aarch64.X0, aarch64.Reg(aarch64.FP)) // fp = X29
	var callee @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "CaptureNativeFrames"))
	a.SetGlobal(callee)
	aarch64.Bl(a, callee)
	// BL clobbers the caller-saved pool; free it before allocating the result.
	rm.ResetRegs()
	if ins.ID < 0 { return }
	var rd int = nextReg(rm, ins.ID)
	if rd != aarch64.X0 {
		aarch64.Mov(a, true, rd, aarch64.Reg(aarch64.X0))
	}
}
