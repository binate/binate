package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// OP_STACK_FRAMES (pkg/std/debug capture) lowers to a call to
// rt.CaptureNativeFrames — NOT silently dropped.  buf *[]Frame is an aggregate
// (registered as an alloc so getOperand yields a pointer to its {data,len}
// image); skip is a scalar.  Asserts the call target is declared (the whole
// lowering ran through the BL) and that bytes were emitted, guarding against a
// regression to the silent-drop default.  The X29=fp seed and X0..X3 marshaling
// are covered by review + the eventual native-main end-to-end (deps are
// LLVM-compiled today, so OP_STACK_FRAMES reaches native only for a debug main).
func TestEmitStackFrames() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 2)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	var skip @ir.Instr = make(ir.Instr)
	skip.ID = 1
	skip.Typ = types.TypInt()
	var buf @ir.Instr = make(ir.Instr)
	buf.ID = 2
	buf.Typ = types.MakeSliceType(types.TypInt()) // a raw-slice aggregate
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_STACK_FRAMES
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = skip
	ins.Args[1] = buf
	var noStrings @[]ir.StringConst
	emitInstr(a, "main", "fn", rm, noStrings, ins)
	if bytesWritten(a) == 0 {
		return fail("OP_STACK_FRAMES must not be silently dropped on arm64")
	}
	var callee @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "CaptureNativeFrames"))
	if a.LookupSymbol(callee) < 0 {
		return fail("OP_STACK_FRAMES should call rt.CaptureNativeFrames")
	}
	return ""
}
