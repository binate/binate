package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/os"

// --- Module-level empties (pattern from pkg/binate/ir/ir_test.bn). ---
var noParams @[]@ir.Param

var noResults @[]@types.Type

var noArgs @[]@ir.Instr

// --- Helpers ---

func fail(msg *[]readonly char) testing.TestResult {
	var r @[]char = buf.CopyStr(msg)
	return r
}

func charEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// canLinkAndRun — proxy for "macOS host" (otool is macOS-only).
func canLinkAndRun() bool {
	var args @[]@[]char = make_slice(@[]char, 1)
	args[0] = "--version"
	return execExit("otool", args) == 0
}

// buildMainFoo returns a module "main" with one empty function
// `main.foo` — emits the symbol bn_F1_4_main1_3_foo (or
// _bn_F1_4_main1_3_foo under Mach-O linkage).
func buildMainFoo() @ir.Module {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func = ir.NewFunc("", "main.foo", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	b.EmitReturn(noArgs)
	m.AddFunc(f)
	return m
}

// fileContainsStr reads up to 64 KB of path and reports whether
// `needle` appears in those bytes.  Tiny single-function objects fit
// well under the cap.
func fileContainsStr(path *[]readonly char, needle *[]readonly char) bool {
	f, oerr := os.Open(path)
	if present(oerr) { return false }
	var data @[]uint8 = make_slice(uint8, 65536)
	n, _ := f.Read(data)
	_ = f.Close()
	var nl int = len(needle)
	if nl == 0 { return true }
	for i := 0; i + nl <= n; i++ {
		var match bool = true
		for j := 0; j < nl; j++ {
			if data[i + j] != cast(uint8, needle[j]) {
				match = false
				break
			}
		}
		if match { return true }
	}
	return false
}

// fileByte0 returns byte 0 of path (0xFF sentinel on read failure).
func fileByte0(path *[]readonly char) uint8 {
	f, oerr := os.Open(path)
	if present(oerr) { return cast(uint8, 0xFF) }
	var data @[]uint8 = make_slice(uint8, 4)
	n, _ := f.Read(data)
	_ = f.Close()
	if n < 1 { return cast(uint8, 0xFF) }
	return data[0]
}

// arm64 EmitObject selects both the writer and the symbol-linkage prefix by the
// object format.  format=macho → Mach-O object (magic byte 0xCF) with
// '_'-prefixed symbols; format=elf → ELF object (magic 0x7F) with
// bare symbols.  Header magic is independent of the (otherwise
// macOS-only) toolchain, so this runs everywhere.
func TestArm64FormatSelectsWriterAndPrefix() testing.TestResult {
	var mp *[]readonly char = "/tmp/binate_aa64_fmt_macho.o"
	if !EmitObject(buildMainFoo(), "macho", mp) {
		return fail("macho EmitObject should succeed")
	}
	if fileByte0(mp) != cast(uint8, 0xCF) {
		return fail("format=macho should emit a Mach-O object (magic 0xCF)")
	}
	if !fileContainsStr(mp, "_bn_F1_4_main1_3_foo") {
		return fail("macho symbols should carry the '_' prefix")
	}

	var ep *[]readonly char = "/tmp/binate_aa64_fmt_elf.o"
	if !EmitObject(buildMainFoo(), "elf", ep) {
		return fail("elf EmitObject should succeed")
	}
	if fileByte0(ep) != cast(uint8, 0x7F) {
		return fail("format=elf should emit an ELF object (magic 0x7F)")
	}
	if fileContainsStr(ep, "_bn_F1_4_main1_3_foo") {
		return fail("elf symbols must not carry a leading '_'")
	}
	if !fileContainsStr(ep, "bn_F1_4_main1_3_foo") {
		return fail("elf object should contain the bare symbol bn_F1_4_main1_3_foo")
	}
	return ""
}

// objEmitElf must reset to the Mach-O default on EmitObject exit, so a
// direct symFor after an ELF emit still produces the '_'-prefixed
// (macOS-default) symbol — order-independent.
func TestArm64ObjEmitElfResetAfterElf() testing.TestResult {
	EmitObject(buildMainFoo(), "elf", "/tmp/binate_aa64_reset.o")
	var s @[]char = symFor("main", "main")
	if !charEq(s, "_bn_F1_4_main1_4_main") {
		return fail("objEmitElf leaked after ELF emit — symFor must restore the Mach-O '_'")
	}
	return ""
}

// --- symFor ---

func TestSymForMainPkg() testing.TestResult {
	// `main` in pkg `main` mangles to `bn_F1_4_main1_4_main` like
	// any other free function (no special case anymore — `bn_entry`
	// is now the C-runtime-visible entry).
	var s @[]char = symFor("main", "main")
	if !charEq(s, "_bn_F1_4_main1_4_main") {
		return fail("expected _bn_F1_4_main1_4_main")
	}
	return ""
}

func TestSymForNonMainPkg() testing.TestResult {
	var s @[]char = symFor("parser", "parseExpr")
	if !charEq(s, "_bn_F1_6_parser1_9_parseExpr") {
		return fail("expected _bn_F1_6_parser1_9_parseExpr")
	}
	return ""
}

// --- EmitObject end-to-end ---

// Build a module with just main { return } and check EmitObject writes a
// Mach-O object.  Skipped off-macOS.
func TestEmitEmptyMainObject() testing.TestResult {
	if !canLinkAndRun() { return "" }

	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func = ir.NewFunc("", "main", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	b.EmitReturn(noArgs)
	m.AddFunc(f)

	var path *[]readonly char = "/tmp/binate_native_empty_main.o"
	var ok bool = EmitObject(m, "macho", path)
	if !ok { return fail("EmitObject returned false") }
	oFi, oErr := os.Stat(path)
	if present(oErr) || oFi.IsDir() { return fail("no .o file written") }

	// Disassemble with otool -tv; the test passes if otool accepts the file.
	var args @[]@[]char = make_slice(@[]char, 2)
	args[0] = "-tv"
	args[1] = buf.CopyStr(path)
	if execExit("otool", args) != 0 {
		return fail("otool -tv rejected the .o file")
	}
	return ""
}

// Check the full link+run path: clang links our self-contained .o and the
// result exits 0.
func TestEmitEmptyMainLinksAndRuns() testing.TestResult {
	if !canLinkAndRun() { return "" }

	var m @ir.Module = ir.NewModule("\"main\"")
	// Export the entry as `main` — the unmangled `_main` global via symPrefixed —
	// so the host crt0 calls it directly and the object links with no C runtime
	// or startup shim.  Return int 0 so crt0's `exit(main())` yields a 0 exit.
	var resInt @[]@types.Type = make_slice(@types.Type, 1)
	resInt[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "__entry", noParams, resInt)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var c0 @ir.Instr = b.EmitConstInt(0, types.TypInt())
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = c0
	b.EmitReturn(retArgs)
	var ce @[]@[]char = make_slice(@[]char, 1)
	ce[0] = buf.CopyStr("main")
	f.CExportNames = ce
	m.AddFunc(f)

	var objPath *[]readonly char = "/tmp/binate_native_link_empty.o"
	if !EmitObject(m, "macho", objPath) { return fail("EmitObject returned false") }

	var exePath *[]readonly char = "/tmp/binate_native_link_empty"
	var args @[]@[]char = make_slice(@[]char, 4)
	args[0] = "-w"
	args[1] = "-o"
	args[2] = buf.CopyStr(exePath)
	args[3] = buf.CopyStr(objPath)
	if execExit("clang", args) != 0 {
		return fail("clang link failed")
	}

	var runArgs @[]@[]char = make_slice(@[]char, 0)
	if execExit(exePath, runArgs) != 0 {
		return fail("binary exited non-zero")
	}
	return ""
}

// TestEmitCallExitsWithCode moved to arm64_dispatch_test.bn — it
// most directly exercises emitInstr's OP_CONST_INT + OP_CALL +
// OP_RETURN dispatch, which is what arm64_dispatch.bn provides.

// (TestEmitCallBuiltinPrintsInt was removed in an earlier step:
// bn_print_int / bn_print_newline / bn_exit all migrated out of
// the C runtime, leaving the manifest empty. The OP_CALL_BUILTIN
// IR op + dispatch plumbing was removed wholesale in a follow-up
// — there's no special builtin-call form to E2E-link against. A
// future runtime function would just be a regular OP_CALL.)

// An imported extern var (IsExtern — a `.bni`-declared `var X T` from
// another package) must NOT be defined here: its owning package's object
// file provides the definition, so a definition here would be a duplicate
// symbol at link time (the builder-comp_native_aa64-comp_native_aa64
// self-host link previously failed with 62 such dups).  The package's own
// global is still defined.
func TestEmitGlobalsSkipsExtern() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var own @ir.Global = make(ir.Global)
	own.Name = "ownvar"
	own.Typ = types.TypInt()
	var ext @ir.Global = make(ir.Global)
	ext.Name = "pkg/other.theirvar"
	ext.Typ = types.TypInt()
	ext.IsExtern = true
	var globals @[]@ir.Global = make_slice(@ir.Global, 2)
	globals[0] = own
	globals[1] = ext
	emitGlobals(a, "main", globals)
	if a.LookupSymbol("_bn_G1_4_main1_6_ownvar") < 0 {
		return fail("a package's own global must be defined")
	}
	if a.LookupSymbol("_bn_G2_3_pkg5_other1_8_theirvar") >= 0 {
		return fail("an IsExtern global must NOT be defined (dup at link)")
	}
	return ""
}

// A global is exactly SizeOf bytes — the Inc 5b unification dropped the old
// round-up-to-8.  A lone 1-byte char global lands as exactly 1 data byte.
func TestEmitGlobalsExactSize() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var g @ir.Global = make(ir.Global)
	g.Name = "b"
	g.Typ = types.TypChar()
	var globals @[]@ir.Global = make_slice(@ir.Global, 1)
	globals[0] = g
	emitGlobals(a, "main", globals)
	var di int = -1
	for i := 0; i < a.NumSections; i++ {
		if charEqAA64(a.Sections[i].Name, "data") { di = i }
	}
	if di < 0 { return fail("a non-extern global must open the data section") }
	if a.Sections[di].Len != 1 {
		return fail("a 1-byte char global must be 1 byte, not rounded up to 8")
	}
	return ""
}

// EmitDataGlobal aligns each global to its AlignOf (replacing the old blanket
// round-to-8): a 1-byte char followed by an 8-byte int still lands the int at
// an 8-aligned offset.
func TestEmitGlobalsAlignsFollowing() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var g0 @ir.Global = make(ir.Global)
	g0.Name = "b"
	g0.Typ = types.TypChar()
	var g1 @ir.Global = make(ir.Global)
	g1.Name = "w"
	g1.Typ = types.TypInt()
	var globals @[]@ir.Global = make_slice(@ir.Global, 2)
	globals[0] = g0
	globals[1] = g1
	emitGlobals(a, "main", globals)
	var s1 int = a.LookupSymbol(globalSymFor("main", "w"))
	if s1 < 0 { return fail("the int global must be defined") }
	if cast(int, a.Symbols[s1].Offset) % 8 != 0 {
		return fail("an 8-byte global must start at an 8-aligned offset")
	}
	return ""
}

// A module whose globals are ALL imported extern vars must not open the
// __DATA section: emitGlobals defers SetSection until a real (non-extern)
// global is emitted, so no empty data section is left behind (an empty
// section becomes a malformed Mach-O load command at write time).
// NumSections staying put proves nothing new was opened.
func TestEmitGlobalsAllExternNoDataSection() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var sectionsBefore int = a.NumSections
	var ext @ir.Global = make(ir.Global)
	ext.Name = "pkg/other.theirvar"
	ext.Typ = types.TypInt()
	ext.IsExtern = true
	var globals @[]@ir.Global = make_slice(@ir.Global, 1)
	globals[0] = ext
	emitGlobals(a, "main", globals)
	if a.NumSections != sectionsBefore {
		return fail("all-extern globals must not open an empty data section")
	}
	return ""
}
