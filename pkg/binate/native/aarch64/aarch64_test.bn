package "pkg/binate/native/aarch64"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/bootstrap"
import "pkg/builtins/testing"

// --- Module-level empties (pattern from pkg/binate/ir/ir_test.bn). ---
var noParams @[]@ir.Param
var noResults @[]@types.Type
var noArgs @[]@ir.Instr

// --- Helpers ---

func fail(msg *[]const char) testing.TestResult {
	var r @[]char = buf.CopyStr(msg)
	return r
}

func charEq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// canLinkAndRun — proxy for "macOS host" (otool is macOS-only).
func canLinkAndRun() bool {
	var args @[]@[]char = make_slice(@[]char, 1)
	args[0] = buf.CopyStr("--version")
	return bootstrap.Exec("otool", args) == 0
}

// buildMainFoo returns a module "main" with one empty function
// `main.foo` — emits the symbol bn_main__foo (or _bn_main__foo under
// Mach-O linkage).
func buildMainFoo() @ir.Module {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func = ir.NewFunc("main.foo", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	b.EmitReturn(noArgs)
	m.AddFunc(f)
	return m
}

// fileContainsStr reads up to 64 KB of path and reports whether
// `needle` appears in those bytes.  Tiny single-function objects fit
// well under the cap.
func fileContainsStr(path *[]const char, needle *[]const char) bool {
	var fd int = bootstrap.Open(path, bootstrap.O_RDONLY)
	if fd < 0 { return false }
	var data @[]uint8 = make_slice(uint8, 65536)
	var n int = bootstrap.Read(fd, data)
	bootstrap.Close(fd)
	var nl int = len(needle)
	if nl == 0 { return true }
	for i := 0; i + nl <= n; i++ {
		var match bool = true
		for j := 0; j < nl; j++ {
			if data[i + j] != cast(uint8, needle[j]) {
				match = false
				break
			}
		}
		if match { return true }
	}
	return false
}

// fileByte0 returns byte 0 of path (0xFF sentinel on read failure).
func fileByte0(path *[]const char) uint8 {
	var fd int = bootstrap.Open(path, bootstrap.O_RDONLY)
	if fd < 0 { return cast(uint8, 0xFF) }
	var data @[]uint8 = make_slice(uint8, 4)
	var n int = bootstrap.Read(fd, data)
	bootstrap.Close(fd)
	if n < 1 { return cast(uint8, 0xFF) }
	return data[0]
}

// Phase 4 of plan-backend-objformat-decoupling.md: arm64 EmitObject
// selects both the writer and the symbol-linkage prefix by the
// object format.  format=macho → Mach-O object (magic byte 0xCF) with
// '_'-prefixed symbols; format=elf → ELF object (magic 0x7F) with
// bare symbols.  Header magic is independent of the (otherwise
// macOS-only) toolchain, so this runs everywhere.
func TestArm64FormatSelectsWriterAndPrefix() testing.TestResult {
	var mp *[]const char = "/tmp/binate_aa64_fmt_macho.o"
	if !EmitObject(buildMainFoo(), "macho", mp) {
		return fail("macho EmitObject should succeed")
	}
	if fileByte0(mp) != cast(uint8, 0xCF) {
		return fail("format=macho should emit a Mach-O object (magic 0xCF)")
	}
	if !fileContainsStr(mp, "_bn_main__foo") {
		return fail("macho symbols should carry the '_' prefix")
	}

	var ep *[]const char = "/tmp/binate_aa64_fmt_elf.o"
	if !EmitObject(buildMainFoo(), "elf", ep) {
		return fail("elf EmitObject should succeed")
	}
	if fileByte0(ep) != cast(uint8, 0x7F) {
		return fail("format=elf should emit an ELF object (magic 0x7F)")
	}
	if fileContainsStr(ep, "_bn_main__foo") {
		return fail("elf symbols must not carry a leading '_'")
	}
	if !fileContainsStr(ep, "bn_main__foo") {
		return fail("elf object should contain the bare symbol bn_main__foo")
	}
	return ""
}

// objEmitElf must reset to the Mach-O default on EmitObject exit, so a
// direct symFor after an ELF emit still produces the '_'-prefixed
// (macOS-default) symbol — order-independent.
func TestArm64ObjEmitElfResetAfterElf() testing.TestResult {
	EmitObject(buildMainFoo(), "elf", "/tmp/binate_aa64_reset.o")
	var s @[]char = symFor("main", "main")
	if !charEq(s, "_bn_main__main") {
		return fail("objEmitElf leaked after ELF emit — symFor must restore the Mach-O '_'")
	}
	return ""
}

// --- symFor ---

func TestSymForMainPkg() testing.TestResult {
	// `main` in pkg `main` mangles to `bn_main__main` like any
	// other free function (no special case anymore — `bn_entry`
	// is now the C-runtime-visible entry).
	var s @[]char = symFor("main", "main")
	if !charEq(s, "_bn_main__main") {
		return fail("expected _bn_main__main")
	}
	return ""
}

func TestSymForNonMainPkg() testing.TestResult {
	var s @[]char = symFor("parser", "parseExpr")
	if !charEq(s, "_bn_parser__parseExpr") {
		return fail("expected _bn_parser__parseExpr")
	}
	return ""
}

// --- EmitObject end-to-end ---

// Build a module with just main { return } and check EmitObject writes a
// Mach-O object.  Skipped off-macOS.
func TestEmitEmptyMainObject() testing.TestResult {
	if !canLinkAndRun() { return "" }

	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func = ir.NewFunc("main", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	b.EmitReturn(noArgs)
	m.AddFunc(f)

	var path *[]const char = "/tmp/binate_native_empty_main.o"
	var ok bool = EmitObject(m, "macho", path)
	if !ok { return fail("EmitObject returned false") }
	if bootstrap.Stat(path) != 1 { return fail("no .o file written") }

	// Disassemble with otool -tv; the test passes if otool accepts the file.
	var args @[]@[]char = make_slice(@[]char, 2)
	args[0] = buf.CopyStr("-tv")
	args[1] = buf.CopyStr(path)
	if bootstrap.Exec("otool", args) != 0 {
		return fail("otool -tv rejected the .o file")
	}
	return ""
}

// Check the full link+run path: clang links our .o with the C runtime and
// the result exits 0.
func TestEmitEmptyMainLinksAndRuns() testing.TestResult {
	if !canLinkAndRun() { return "" }

	var rt @[]char = findRuntimePath()
	if len(rt) == 0 { return "" } // no runtime to link against — skip
	var stubs @[]char = findTestStubsPath()
	if len(stubs) == 0 { return "" } // stubs missing — skip

	var m @ir.Module = ir.NewModule("\"main\"")
	// `__entry` mangles to `bn_entry` (the C runtime's entry point)
	// when the module's package is "main"; naming it `main` would
	// produce `bn_main__main` and leave bn_entry undefined.
	var f @ir.Func = ir.NewFunc("__entry", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	b.EmitReturn(noArgs)
	m.AddFunc(f)

	var objPath *[]const char = "/tmp/binate_native_link_empty.o"
	if !EmitObject(m, "macho", objPath) { return fail("EmitObject returned false") }

	var exePath *[]const char = "/tmp/binate_native_link_empty"
	var args @[]@[]char = make_slice(@[]char, 6)
	args[0] = buf.CopyStr("-w")
	args[1] = buf.CopyStr("-o")
	args[2] = buf.CopyStr(exePath)
	args[3] = buf.CopyStr(objPath)
	args[4] = buf.CopyStr(rt)
	args[5] = buf.CopyStr(stubs)
	if bootstrap.Exec("clang", args) != 0 {
		return fail("clang link failed")
	}

	var runArgs @[]@[]char = make_slice(@[]char, 0)
	if bootstrap.Exec(exePath, runArgs) != 0 {
		return fail("binary exited non-zero")
	}
	return ""
}

// TestEmitCallExitsWithCode moved to arm64_dispatch_test.bn — it
// most directly exercises emitInstr's OP_CONST_INT + OP_CALL +
// OP_RETURN dispatch, which is what arm64_dispatch.bn provides.

// (TestEmitCallBuiltinPrintsInt was removed in an earlier step:
// bn_print_int / bn_print_newline / bn_exit all migrated out of
// the C runtime, leaving the manifest empty. The OP_CALL_BUILTIN
// IR op + dispatch plumbing was removed wholesale in a follow-up
// — there's no special builtin-call form to E2E-link against. A
// future runtime function would just be a regular OP_CALL.)

// findRuntimePath probes the known worktree layouts. Returns empty
// slice if none of the candidates exists. Prefers `runtime/...`
// (relative to the test runner's CWD, which is the repo root for
// scripts/unittest/run.sh) so the local worktree's runtime is used —
// avoids the bug where one worktree's edits were invisible because
// an absolute-path probe in another worktree resolved first.
func findRuntimePath() @[]char {
	return findRuntimeFile("binate_runtime.c")
}

// findTestStubsPath returns the path to the C stub file with weak
// definitions for pkg/rt symbols that binate_runtime.c references.
// Used by the link-and-run tests to satisfy bn_pkg__rt__RawFree (etc.)
// without linking pkg/rt's compiled body. Lives alongside
// binate_runtime.c.
func findTestStubsPath() @[]char {
	return findRuntimeFile("native_test_stubs.c")
}

// findRuntimeFile probes for a file named `name` under runtime/ in
// the known worktree layouts. Returns empty slice if not found.
func findRuntimeFile(name *[]const char) @[]char {
	var c @[]@[]char = make_slice(@[]char, 4)
	c[0] = buf.Concat("runtime/", name)
	c[1] = buf.Concat("../../runtime/", name)
	c[2] = buf.Concat("/Users/vtl/binate/binate/runtime/", name)
	c[3] = buf.Concat("/Users/vtl/binate/temp-binate-3/runtime/", name)
	for i := 0; i < len(c); i++ {
		if bootstrap.Stat(c[i]) == 1 { return c[i] }
	}
	var empty @[]char
	return empty
}
