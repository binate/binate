package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/builtins/testing"

// Tests for per-type RTTI record emission (aarch64_typeinfo.bn:
// emitTypeInfosNative).  genFromSrc / opsMkAssembler / relroSectionBytes are
// shared helpers from the sibling iface test files (same package).  The record's
// byte layout is covered on the LLVM side (emit_impls_test.bn); here we pin the
// native-specific behavior via section placement (the x64 counterpart is
// x64_typeinfo_test.bn): a reloc-free record (no dtor) lands in "rodata", while a
// record whose word-0 destructor handle emits a relocation lands in
// "rodata_relro" — the same dtor word the vtable any-block slot 0 uses.

// rodataSectionBytes returns the byte count of the plain read-only "rodata"
// section (reloc-free blobs); 0 if none was emitted.  Sibling of
// relroSectionBytes.
func rodataSectionBytes(a @asm.Assembler) int {
	for i := 0; i < a.NumSections; i++ {
		if charEqAA64(a.Sections[i].Name, "rodata") {
			return a.Sections[i].Len
		}
	}
	return 0
}

// A type with no managed field (no dtor) has a NULL word-0 slot, so its 7-word
// (56-byte) TypeInfo record is reloc-free and lands in "rodata", with nothing in
// the relocatable-read-only section.
func TestEmitTypeInfoNativeNoDtorInRodata() testing.TestResult {
	var src *[]readonly char =
		"package \"main\"\n"
		"interface I { foo() }\n"
		"type T struct { x int }\n"
		"func (t *T) foo() { }\n"
		"impl *T : I\n"
		"func main() { }\n"
	var mod @ir.Module = genFromSrc(src)

	var a @asm.Assembler = opsMkAssembler()
	emitTypeInfosNative(a, "main", mod)
	if rodataSectionBytes(a) != 56 {
		return "reloc-free TypeInfo record should be 56 bytes in rodata (7 words x 8)"
	}
	if relroSectionBytes(a) != 0 {
		return "a no-dtor TypeInfo record must be reloc-free (nothing in rodata_relro)"
	}
	return ""
}

// A type that needs destruction (a managed `@Inner` field) has a non-null word-0
// destructor handle; that relocation moves the 56-byte record into the
// relocatable-read-only section.
func TestEmitTypeInfoNativeDtorInRelro() testing.TestResult {
	var src *[]readonly char =
		"package \"main\"\n"
		"interface I { foo() int }\n"
		"type Inner struct { V int }\n"
		"type T struct { Inner @Inner }\n"
		"func (t *T) foo() int { return t.Inner.V }\n"
		"impl *T : I\n"
		"func main() { }\n"
	var mod @ir.Module = genFromSrc(src)

	var a @asm.Assembler = opsMkAssembler()
	emitTypeInfosNative(a, "main", mod)
	if relroSectionBytes(a) != 56 {
		return "a managed-field type's TypeInfo record (with a dtor-handle "
			"relocation) should be 56 bytes in rodata_relro"
	}
	// The whole record moved to relro — nothing reloc-free is left in rodata
	// (guards against a spurious second, reloc-free record).
	if rodataSectionBytes(a) != 0 {
		return "a dtor type's TypeInfo record should be entirely in relro, not rodata"
	}
	return ""
}
