package "pkg/binate/native/aarch64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/builtins/testing"

// Tests for per-type RTTI record emission (aarch64_typeinfo.bn:
// emitTypeInfosNative).  genFromSrc / opsMkAssembler / relroSectionBytes are
// shared helpers from the sibling iface test files (same package).  The record's
// exact byte layout is covered on the LLVM side (emit_impls_test.bn); here we pin
// the native-specific behavior via section placement (the x64 counterpart is
// x64_typeinfo_test.bn): the 40-byte record carries a name pointer (and, for a
// type that needs destruction, a dtor handle), so it bears a relocation and
// lands in "rodata_relro", while its reloc-free name blob lands in plain
// "rodata".

// rodataSectionBytes returns the byte count of the plain read-only "rodata"
// section (reloc-free blobs — e.g. the TypeInfo name blob); 0 if none was
// emitted.  Sibling of relroSectionBytes.
func rodataSectionBytes(a @asm.Assembler) int {
	for i := 0; i < a.NumSections; i++ {
		if charEqAA64(a.Sections[i].Name, "rodata") {
			return a.Sections[i].Len
		}
	}
	return 0
}

// A boxable struct's 8-word record bears name-pointer + field-table relocations
// (so it lands in "rodata_relro"), as does its field-table blob (field-name
// relocations); the reloc-free name / field-name blobs land in plain "rodata".
func TestEmitTypeInfoNativeRecordInRelroWithNameBlob() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() }\n"
			"type T struct { x int }\n"
			"func (t *T) foo() { }\n"
			"impl *T : I\n"
			"func main() { }\n"
	var mod @ir.Module = genFromSrc(src)

	var a @asm.Assembler = opsMkAssembler()
	emitTypeInfosNative(a, "main", mod)
	if relroSectionBytes(a) != 128 {
		return "the TypeInfo record (64 bytes) plus its field-table blob (64 bytes, "
				"for the one-field struct) — both bearing relocations — should land in "
				"rodata_relro"
	}
	// The name blob is reloc-free → rodata (non-empty: the type has a name).
	if rodataSectionBytes(a) == 0 {
		return "the TypeInfo name blob should land in rodata (a non-empty name)"
	}
	return ""
}

// A type that needs destruction (a managed `@Inner` field) additionally carries
// a word-0 dtor-handle relocation; the record (64 bytes) plus its field-table
// blob (64 bytes) are relro, with the name blob in rodata.  The `@Inner` field is
// a pointer field, so P4b-2 also force-emits the pointee Inner's own record +
// field-table (another 64+64) into relro.
func TestEmitTypeInfoNativeDtorRecordInRelro() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() int }\n"
			"type Inner struct { V int }\n"
			"type T struct { Inner @Inner }\n"
			"func (t *T) foo() int { return t.Inner.V }\n"
			"impl *T : I\n"
			"func main() { }\n"
	var mod @ir.Module = genFromSrc(src)

	var a @asm.Assembler = opsMkAssembler()
	emitTypeInfosNative(a, "main", mod)
	if relroSectionBytes(a) != 256 {
		return "a managed-field type's TypeInfo record (64 bytes; name + dtor + "
				"fields relocations) + its field-table blob (64 bytes), plus the "
				"force-emitted `@Inner` pointee's record (64) + field-table (64), "
				"should be 256 bytes in rodata_relro"
	}
	if rodataSectionBytes(a) == 0 {
		return "the TypeInfo name blob should land in rodata"
	}
	return ""
}

// emitIfaceIdsNative emits a weak 1-byte `__ifaceid.<J>` marker per canonical
// interface into plain rodata (reloc-free — only the address matters).  The
// declared I's marker symbol is defined; nothing lands in relro.
func TestEmitIfaceIdNativeMarker() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() }\n"
			"type T struct { x int }\n"
			"func (t *T) foo() { }\n"
			"impl *T : I\n"
			"func main() { }\n"
	var mod @ir.Module = genFromSrc(src)

	var a @asm.Assembler = opsMkAssembler()
	emitIfaceIdsNative(a, mod)
	if findSymbolByNameIface(a, "___ifaceid.bn_S1_4_main1_1_I") < 0 {
		return "expected the ___ifaceid marker symbol for interface I"
	}
	if rodataSectionBytes(a) == 0 {
		return "IfaceId markers should land in rodata"
	}
	if relroSectionBytes(a) != 0 {
		return "IfaceId markers are reloc-free (nothing in rodata_relro)"
	}
	return ""
}

// emitSatEntriesNative emits one weak `__satentry.<T,J>` record per (T, J) in
// m.Impls: a 72-byte node (2-word header + 3 payload symrefs + 2 {data,len}
// symbol-name slices → all relro) plus two reloc-free symbol-name blobs in plain
// rodata.  For a non-extending `impl *T : I` there is one entry.
func TestEmitSatEntryNative() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() }\n"
			"type T struct { x int }\n"
			"func (t *T) foo() { }\n"
			"impl *T : I\n"
			"func main() { }\n"
	var mod @ir.Module = genFromSrc(src)

	var a @asm.Assembler = opsMkAssembler()
	emitSatEntriesNative(a, mod)
	if findSymbolByNameIface(a, "___satentry.bn_V1_4_main1_T1_4_main1_I") < 0 {
		return "expected the ___satentry symbol for (T,I)"
	}
	if relroSectionBytes(a) != 72 {
		return "one (T,I) satisfaction-entry node (header + 3 payload symrefs + "
				"2 sym-name slices) should be 72 bytes in rodata_relro"
	}
	if rodataSectionBytes(a) == 0 {
		return "the two symbol-name blobs (TypeSym/IfaceSym) should land in plain rodata"
	}
	return ""
}
