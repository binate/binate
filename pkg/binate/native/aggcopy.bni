// Package aggcopy — the byte-exact access plan for a native backend's aggregate
// copy.  A backend copies an aggregate in whole machine words; the plan covers
// the sub-word tail left after them exactly, so the copy never writes past the
// aggregate's size.
package "pkg/binate/native/aggcopy"

// Piece is one memory access of an aggregate copy: Width bytes (8, 4, 2 or 1)
// at byte offset Off from the start of the aggregate.
type Piece struct {
	Off   int
	Width int
}

// TailPieces plans the copy of an aggregate's sub-word tail — the bytes
// [off, sz) left after its whole 8-byte words (off a multiple of 8, 0 < sz - off
// < 8) — as accesses whose union is exactly [off, sz): none reaches past sz,
// where the NEXT object lies when the size is not a multiple of 8 (a [3]char
// field, a 3-byte struct).  Without overlap it is 4-, 2- and 1-byte pieces
// from off upward, each at an offset that is a multiple of its width.  With
// overlap it is at most two pieces, the last ending at sz and re-copying bytes
// an earlier access already copied (valid when the source does not overlap the
// destination, or is read in full before any byte is written): one 8-byte word
// when sz >= 8, two 4-byte words for a 5- to 7-byte aggregate, and otherwise
// the same pieces as without overlap.
func TailPieces(off int, sz int, overlap bool) @[]Piece
