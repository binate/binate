package "pkg/binate/native/aggcopy"

// TailPieces covers a tail without overlap greedily, widest piece first: a
// tail of 7 bytes is 4 + 2 + 1, of 3 bytes 2 + 1.  Because off is a multiple of
// 8 and the pieces shrink, each piece's offset is a multiple of its width — the
// alignment a backend's scaled immediate-offset forms require (an offset past
// their range still takes the backend's long form); an overlapping piece's
// offset generally is not a multiple of its width.
func TailPieces(off int, sz int, overlap bool) @[]Piece {
	var none @[]Piece
	if off >= sz { return none }
	if overlap && sz >= 8 {
		var one @[]Piece = make_slice(Piece, 1)
		one[0].Off = sz - 8
		one[0].Width = 8
		return one
	}
	if overlap && sz - off > 4 {
		var two @[]Piece = make_slice(Piece, 2)
		two[0].Off = off
		two[0].Width = 4
		two[1].Off = sz - 4
		two[1].Width = 4
		return two
	}
	var n int = 0
	var widths [3]int = [3]int{4, 2, 1}
	var pieces @[]Piece = make_slice(Piece, 3)
	var at int = off
	for i := 0; i < 3; i++ {
		if sz - at >= widths[i] {
			pieces[n].Off = at
			pieces[n].Width = widths[i]
			at = at + widths[i]
			n = n + 1
		}
	}
	return pieces[:n]
}
