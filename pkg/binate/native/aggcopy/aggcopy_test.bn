package "pkg/binate/native/aggcopy"

import "pkg/builtins/testing"

// piecesAre reports whether ps is exactly the (offset, width) list want, given
// as flattened pairs.
func piecesAre(ps @[]Piece, want *[]int) bool {
	if len(ps) * 2 != len(want) { return false }
	for i := 0; i < len(ps); i++ {
		if ps[i].Off != want[2 * i] || ps[i].Width != want[2 * i + 1] { return false }
	}
	return true
}

// Every tail is covered exactly — never a byte past the aggregate's size.
func TestTailPiecesExactCover() testing.TestResult {
	for sz := 1; sz <= 40; sz++ {
		var off int = sz / 8 * 8
		for o := 0; o < 2; o++ {
			var ps @[]Piece = TailPieces(off, sz, o == 1)
			var covered [48]int
			for i := 0; i < len(ps); i++ {
				var w int = ps[i].Width
				if w != 8 && w != 4 && w != 2 && w != 1 { return "a piece width is not 8, 4, 2 or 1" }
				if ps[i].Off < 0 || ps[i].Off + w > sz { return "a piece reaches outside the aggregate" }
				if o == 0 && ps[i].Off % w != 0 {
					return "a piece without overlap is not aligned to its width"
				}
				for k := ps[i].Off; k < ps[i].Off + w; k++ { covered[k] = 1 }
			}
			for k := off; k < sz; k++ {
				if covered[k] == 0 { return "a tail byte is not copied" }
			}
			if o == 1 && len(ps) > 2 { return "an overlapping tail takes more than two pieces" }
		}
	}
	return ""
}

// The decomposition and the overlapping-word form, spelled out.
func TestTailPiecesShapes() testing.TestResult {
	if len(TailPieces(16, 16, false)) != 0 { return "a word-multiple size has no tail" }
	if !piecesAre(TailPieces(0, 7, false), [6]int{0, 4, 4, 2, 6, 1}[:]) {
		return "a 7-byte aggregate is 4 + 2 + 1"
	}
	if !piecesAre(TailPieces(0, 3, true), [4]int{0, 2, 2, 1}[:]) {
		return "a 3-byte aggregate is 2 + 1 with overlap too"
	}
	if !piecesAre(TailPieces(0, 7, true), [4]int{0, 4, 3, 4}[:]) {
		return "a 7-byte aggregate with overlap is two 4-byte words"
	}
	if !piecesAre(TailPieces(8, 11, false), [4]int{8, 2, 10, 1}[:]) {
		return "an 11-byte tail is 2 + 1 after the word"
	}
	if !piecesAre(TailPieces(8, 11, true), [2]int{3, 8}[:]) {
		return "an overlapping tail is the word ending at the size"
	}
	return ""
}
