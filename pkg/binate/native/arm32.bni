// Package arm32 is the native (direct IR→object) backend for 32-bit ARM
// (ARMv7-A, A32 mode, soft-float), the sibling of pkg/binate/native/aarch64
// and pkg/binate/native/x64.  It mirrors the aarch64 backend's file
// decomposition 1:1 but targets the arm32 assembler (pkg/binate/asm/arm32)
// and always emits an ELF32 object (arm32 has no Mach-O), so symbols are
// always bare (no leading '_').
//
// Walking-skeleton stage: enough of the emit path for a trivial program (an
// empty `func main() {}` — i.e. `main.__entry` (bn_entry) → `bn_init` +
// `main.main`) to link via the existing clang/crt0/baremetal.ld pipeline and
// boot under `qemu-system-arm -M virt -semihosting`.  Ops outside this subset are
// no-ops (the dispatcher's default) except where a partial lowering would
// silently miscompile.
package "pkg/binate/native/arm32"

import "pkg/binate/ir"
import "pkg/binate/native/place"

// Options holds the arm32 backend's code-generation switches; the zero value is
// the default codegen.
type Options struct {
	// Place positions functions with BKPT #place.PLACE_FILL_IMM filler, in 4-byte
	// units, before each function and right after a probed function
	// (place.PlaceOptions; bnc -fnative-place-seed / -fnative-place-probe).  The
	// zero value adds none.
	Place place.PlaceOptions
	// BlockLayout (bnc -fnative-block-layout) is the block-layout mode each
	// function's blocks are laid out under (blockplan.BLOCK_LAYOUT_*); the zero value
	// is BLOCK_LAYOUT_SOURCE, the IR order with every block ending in a transfer.
	// A value that is not a mode fails EmitObject.
	BlockLayout int
}

// EmitObject lowers an IR module to ARM32 and writes an ELF32 .o at `path`,
// with the code-generation switches in opts.
// `format` is accepted for signature parity with the aarch64 / x64 backends
// but is ignored — arm32 only ever emits ELF (elf.WriteARM32).  Caller links
// the resulting object with the arm32 runtime (crt0.s / semihost.s /
// baremetal.ld).  Returns true on success.
func EmitObject(mod @ir.Module, format *[]readonly char, path *[]readonly char, opts Options) bool
