// Package arm32 is the native (direct IR→object) backend for 32-bit ARM
// (ARMv7-A, A32 mode, soft-float), the sibling of pkg/binate/native/aarch64
// and pkg/binate/native/x64.  It mirrors the aarch64 backend's file
// decomposition 1:1 but targets the arm32 assembler (pkg/binate/asm/arm32)
// and always emits an ELF32 object (arm32 has no Mach-O), so symbols are
// always bare (no leading '_').
//
// Walking-skeleton stage: enough of the emit path for a trivial program (an
// empty `func main() {}` — i.e. `main.__entry` → `main.__init_all` +
// `main.main`, all void with a single OP_RETURN) to link via the existing
// clang/crt0/baremetal.ld pipeline and boot under
// `qemu-system-arm -M virt -semihosting`.  Ops outside this subset are
// no-ops (the dispatcher's default) except where a partial lowering would
// silently miscompile.
package "pkg/binate/native/arm32"

import "pkg/binate/ir"

// EmitObject lowers an IR module to ARM32 and writes an ELF32 .o at `path`.
// `format` is accepted for signature parity with the aarch64 / x64 backends
// but is ignored — arm32 only ever emits ELF (elf.WriteARM32).  Caller links
// the resulting object with the arm32 runtime (crt0.s / semihost.s /
// baremetal.ld).  Returns true on success.
func EmitObject(mod @ir.Module, format *[]readonly char, path *[]readonly char) bool
