package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/elf"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// ============================================================
// EmitObject — module entry
// ============================================================

// EmitObject lowers an IR module to an ELF32 ARM object.  `format` is
// accepted for signature parity with the aarch64 / x64 backends but is
// ignored — arm32 has no Mach-O, so the object is always ELF and symbols are
// always bare.  The emit sequence mirrors aarch64.bn's EmitObject 1:1
// (FinalizeStrings, one text section, per-function lowering, then the
// func-value / string / global / vtable / descriptor passes, fixup
// resolution, finalize, write) so the two backends can't drift on structure.
// For a trivial program most of the later passes emit nothing.
func EmitObject(mod @ir.Module, format *[]readonly char, path *[]readonly char) bool {
	mod.FinalizeStrings()

	// ILP32: 4-byte assembler word (aarch64 / x64 use 8).
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)

	// Full package path; the mangler short-names it internally.
	var pkgName *[]readonly char = stripQuotes(mod.Name)

	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		emitFunc(a, pkgName, f, mod.Strings, mod.Funcs)
	}

	emitFuncValueShims(a, pkgName, mod)
	emitStringTable(a, pkgName, mod.Strings)
	emitGlobals(a, pkgName, mod.Globals)
	emitFuncValueVtables(a, pkgName, mod)
	emitImplVtables(a, pkgName, mod)
	emitPackageDescriptor(a, pkgName, mod)

	arm32.ResolveFixups(a)
	a.Finalize()

	if a.HasError {
		common.ReportEmitError(a, "arm32")
		return false
	}
	return elf.WriteARM32(a, path)
}

// emitStringTable emits, per collected string literal, a read-only byte blob
// (`Lstr_<id>`, exactly the literal's bytes, reloc-free) and a static
// managed-slice header (`stringMSSym`, WEAK + module-qualified, carrying a
// data pointer).  Use sites address the header directly; reaches go through
// the MOVW/MOVT-ABS pair.  Mirrors aarch64.bn's emitStringTable, sharing the
// same ir.Build* builders so the byte layout can't drift.
func emitStringTable(a @asm.Assembler, pkgName *[]readonly char, strings @[]ir.StringConst) {
	for i := 0; i < len(strings); i++ {
		var sc ir.StringConst = strings[i]
		common.EmitDataGlobal(a, ir.BuildStringBlob(stringLabel(sc.ID), sc.Data))
	}
	for i := 0; i < len(strings); i++ {
		var sc ir.StringConst = strings[i]
		common.EmitDataGlobal(a,
				ir.BuildStringMSHeader(
						stringMSSym(pkgName, sc.ID), stringLabel(sc.ID), sc.Len, ir.DG_WEAK))
	}
}

// emitGlobals emits package-level variable storage via ir.BuildGlobalVar (a
// mutable, strong, SizeOf-byte zero blob, AlignOf-aligned) lowered through
// common.EmitDataGlobal — the same builder the LLVM backend uses, so the
// storage size can't drift.  An imported extern var is DEFINED by its owning
// package's object, so it gets no storage here (only referenced).  Mirrors
// aarch64.bn's emitGlobals.
func emitGlobals(a @asm.Assembler, pkgName *[]readonly char, globals @[]@ir.Global) {
	for i := 0; i < len(globals); i++ {
		var g @ir.Global = globals[i]
		if g == nil { continue }
		if g.IsExtern { continue }
		var sz int = 4
		var al int = 4
		if g.Typ != nil {
			sz = g.Typ.SizeOf()
			al = g.Typ.AlignOf()
		}
		common.EmitDataGlobal(a, ir.BuildGlobalVar(globalSymFor(pkgName, g.Name), sz, al))
	}
}
