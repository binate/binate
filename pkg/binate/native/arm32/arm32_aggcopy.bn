package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Strict-align aggregate copy (MMU-less arm32)
// ============================================================
//
// MMU-less arm32 runs with memory that requires natural alignment (an unaligned
// word LDR/STR faults, and there is no fault-and-fixup handler).  The language's
// packed struct layout can place a SUB-word-aligned aggregate (AlignOf < wordBytes
// — a struct/array whose fields are all int8/int16) at a non-word-aligned address,
// e.g. the `t` field of `struct { x int8; t Tri }` at byte 1.  So every native
// aggregate memory copy routes through the alignment-aware helper here, which
// copies BYTE-WISE for such an aggregate and word-by-word for a >= word-aligned one
// (always at a word-aligned address).  Keeping the rule in one place means a new
// copy site can't silently reintroduce a faulting word access.

// emitAggMemcpyArm32 copies `sz` bytes from srcPtr to dstPtr.  When `byteWise` (the
// aggregate's AlignOf < wordBytes — see aggNeedsBytewiseArm32) it copies BYTE-WISE
// (LDRB/STRB) so a non-word-aligned aggregate never triggers a faulting word access.
// Otherwise it copies word-aligned data: a LEADING chunk of up to the free-pool-
// register count moves in ONE LDM/STM pair (many words per instruction), and any
// remaining words fall to a word-at-a-time LDR/STR loop.  LDM/STM take no address
// offset, so only that leading chunk — based at srcPtr/dstPtr, byte offset 0 — can
// use them; the remainder is addressed with ordinary base+offset loads.  `rm`
// supplies the register allocator so the LDM register set is drawn only from
// genuinely-free pool registers (never srcPtr/dstPtr, never one holding a live
// value), so the multi-register move clobbers nothing.  Same mask on the LDM and the
// STM keeps ascending register ↔ ascending address, so the copy is faithful whatever
// registers are chosen.  `tmp` holds each word of the remainder loop; both `tmp` and
// `scratch` must differ from srcPtr/dstPtr (scratch materializes a > 4KB offset
// inside emitBase{,Scalar}{Load,Store}); tmp must differ from scratch.
func emitAggMemcpyArm32(a @asm.Assembler, rm @common.RegMap, dstPtr int, srcPtr int, sz int,
		byteWise bool, tmp int, scratch int) {
	if byteWise {
		for off := 0; off < sz; off = off + 1 {
			emitBaseScalarLoad(a, tmp, srcPtr, off, 1, false, scratch)
			emitBaseScalarStore(a, tmp, dstPtr, off, 1, scratch)
		}
		return
	}
	var w int = wordBytes()
	var maxWords int = sz / w
	var mask int = 0
	var chunkWords int = 0
	for i := 0; i <= 6 && chunkWords < maxWords; i = i + 1 {
		var r int = regPool(i)
		if r == srcPtr || r == dstPtr { continue }
		if rm.IsUsed(r) || rm.RegHeldBy(r) >= 0 { continue }
		mask = mask | (1 << r)
		chunkWords = chunkWords + 1
	}
	var off int = 0
	// A single-word aggregate never beats a plain LDR/STR, so only use LDM/STM
	// when at least two free registers cover at least two words.
	if chunkWords >= 2 {
		arm32.Ldm(a, arm32.COND_AL, srcPtr, false, mask)
		arm32.Stm(a, arm32.COND_AL, dstPtr, false, mask)
		off = chunkWords * w
	}
	for ; off < sz; off = off + w {
		emitBaseLoad(a, tmp, srcPtr, off, scratch)
		emitBaseStore(a, tmp, dstPtr, off, scratch)
	}
	return
}

// emitAggMemcpySafeArm32 is an OVERLAP-SAFE aggregate copy for a small word-aligned
// aggregate: it loads ALL words with ONE LDM into distinct pool registers, then
// stores them with ONE STM — so a copy whose dst aliases (overlaps) its src (an
// elided raw-pointer `*dst = *src`) reads all of src before writing any of dst.
// Unlike emitAggMemcpyArm32's best-effort leading chunk (which SKIPS retained live
// registers and falls back to an interleaved word tail when too few are free),
// scratchReg here EVICTS retained values loss-free, so the single LDM always covers
// every word even under register pressure.  srcPtr/dstPtr are marked used first so
// they can never land in the register mask (an LDM/STM base in its own list is
// invalid).  A byte-wise (sub-word-aligned) aggregate or one over 16 bytes (> 4
// arm32 words, beyond the pool budget) delegates to emitAggMemcpyArm32 — reached only
// by NON-aliasing copies, since S-adjacent elision excludes both.
func emitAggMemcpySafeArm32(a @asm.Assembler, rm @common.RegMap, dstPtr int, srcPtr int, sz int,
		byteWise bool, tmp int, scratch int) {
	if byteWise || sz <= 0 || sz > 16 {
		emitAggMemcpyArm32(a, rm, dstPtr, srcPtr, sz, byteWise, tmp, scratch)
		return
	}
	var w int = wordBytes()
	var words int = (sz + w - 1) / w
	rm.MarkUsed(srcPtr)
	rm.MarkUsed(dstPtr)
	var mask int = 0
	for i := 0; i < words; i = i + 1 {
		mask = mask | (1 << scratchReg(rm))
	}
	arm32.Ldm(a, arm32.COND_AL, srcPtr, false, mask)
	arm32.Stm(a, arm32.COND_AL, dstPtr, false, mask)
}

// aggNeedsBytewiseArm32 reports whether an aggregate of type `t` must be copied
// byte-wise on strict-align arm32 — its natural alignment is below the word size, so
// the layout can place it (or a sub-field of it) at a non-word-aligned address.  A
// nil / >= word-aligned type copies word-by-word.
func aggNeedsBytewiseArm32(t @types.Type) bool {
	return t != nil && t.AlignOf() < wordBytes()
}

// emitBytewiseWordLoadArm32 loads `nBytes` (1..wordBytes) LITTLE-ENDIAN from
// [base + byteOff] into `dst`, assembling via LDRB + ORR-shift so a NON-word-aligned
// source never triggers a faulting word LDR on strict-align arm32.  Used to marshal a
// sub-word-aligned aggregate capture (packed at an odd offset in the closure struct)
// into an outgoing arg register / stack word (see the closure-shim spill helpers).
//
// The field address is materialized into `tmpA` FIRST (base is read exactly once, in
// the Add), then every byte is read from [tmpA + i] — so `dst` may alias `base` (the
// right-to-left reg-load loads capture 0 into the closure-struct base register LAST,
// after which the base is dead) and a > imm12 field offset is handled uniformly.
// `tmpB` holds each loaded byte before it is OR-shifted into `dst`.  `dst`, `tmpA`,
// `tmpB` must be mutually distinct and distinct from `base` (base is read-only, but
// `tmpA` == base would clobber it in the Add).
func emitBytewiseWordLoadArm32(a @asm.Assembler, dst int, base int, byteOff int, nBytes int,
		tmpA int, tmpB int) {
	emitConstInt32(a, tmpA, byteOff)
	arm32.Add(a, arm32.COND_AL, false, tmpA, base, arm32.Reg(tmpA))
	arm32.Ldrb(a, arm32.COND_AL, dst, arm32.MemImm(tmpA, 0))
	for bi := 1; bi < nBytes; bi = bi + 1 {
		arm32.Ldrb(a, arm32.COND_AL, tmpB, arm32.MemImm(tmpA, bi))
		arm32.Orr(a, arm32.COND_AL, false, dst, dst, arm32.RegShift(tmpB, arm32.LSL, 8 * bi))
	}
	return
}
