package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/builtins/testing"

// Tests for the copy / zero-fill loops (arm32_aggcopy_loop.bn): past
// aggCopyUnrollMaxBytes (word-aligned) or aggCopyUnrollMaxBytewise (byte by byte) a copy
// is a loop whose code size does not grow with the aggregate.  asmTextEqMarshal lives in
// arm32_funcvalue_marshal_test.bn.

// A 68-byte word-aligned copy with the pool free is an LDM/STM loop: cursors R4 / R5
// claimed and pointed at the source and destination, data R6..R9 (16 bytes a chunk), four
// iterations counted in the scratch with the branch back already resolved, then the
// 4-byte remainder off the advanced cursors.
func TestAggCopyLdmLoopByteRef() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	emitAggMemcpyArm32(a, rm, arm32.R0, arm32.R1, 68, false, arm32.R2, arm32.R3)
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	var mask int = (1 << arm32.R6) | (1 << arm32.R7) | (1 << arm32.R8) | (1 << arm32.R9)
	emitAddImm(ref, arm32.R4, arm32.R1, 0, arm32.R3)
	emitAddImm(ref, arm32.R5, arm32.R0, 0, arm32.R3)
	emitConstInt32(ref, arm32.R3, 4)
	arm32.Ldm(ref, arm32.COND_AL, arm32.R4, true, mask)
	arm32.Stm(ref, arm32.COND_AL, arm32.R5, true, mask)
	arm32.Sub(ref, arm32.COND_AL, true, arm32.R3, arm32.R3, arm32.Imm(1))
	arm32.BOffset(ref, arm32.COND_NE, false, -12)
	arm32.Ldr(ref, arm32.COND_AL, arm32.R6, arm32.MemImm(arm32.R4, 0))
	arm32.Str(ref, arm32.COND_AL, arm32.R6, arm32.MemImm(arm32.R5, 0))
	if !asmTextEqMarshal(a, ref) || a.Sections[0].NumFixups != 0 {
		return fail(
				"a 68-byte copy with a free pool must be an LDM/STM loop of 16-byte chunks plus "
						"the remainder word, branching back without a fixup")
	}
	return ""
}

// With fewer than two pool registers free past the two cursors, a large word copy is the
// indexed loop: cursors R8 / R9, one word per iteration through R10, the scratch counting
// down from the last word's offset.
func TestAggCopyIndexedLoopWhenPoolBusy() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	for i := 0; i < 4; i++ { rm.MarkUsed(regPool(i)) }
	emitAggMemcpyArm32(a, rm, arm32.R0, arm32.R1, 68, false, arm32.R2, arm32.R3)
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	emitAddImm(ref, arm32.R8, arm32.R1, 0, arm32.R3)
	emitAddImm(ref, arm32.R9, arm32.R0, 0, arm32.R3)
	emitConstInt32(ref, arm32.R3, 64)
	arm32.Ldr(ref, arm32.COND_AL, arm32.R10, arm32.MemReg(arm32.R8, arm32.R3))
	arm32.Str(ref, arm32.COND_AL, arm32.R10, arm32.MemReg(arm32.R9, arm32.R3))
	arm32.Sub(ref, arm32.COND_AL, true, arm32.R3, arm32.R3, arm32.Imm(4))
	arm32.BOffset(ref, arm32.COND_PL, false, -12)
	if !asmTextEqMarshal(a, ref) {
		return fail("a large word copy with a busy pool must be the indexed one-word loop")
	}
	return ""
}

// A 5001-byte byte-wise copy is the indexed loop moving one byte per iteration, through
// cursors R4 / R5 and R6.
func TestAggCopyBytewiseLoopByteRef() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	emitAggMemcpyArm32(a, rm, arm32.R0, arm32.R1, 5001, true, arm32.R2, arm32.R3)
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	emitAddImm(ref, arm32.R4, arm32.R1, 0, arm32.R3)
	emitAddImm(ref, arm32.R5, arm32.R0, 0, arm32.R3)
	emitConstInt32(ref, arm32.R3, 5000)
	arm32.Ldrb(ref, arm32.COND_AL, arm32.R6, arm32.MemReg(arm32.R4, arm32.R3))
	arm32.Strb(ref, arm32.COND_AL, arm32.R6, arm32.MemReg(arm32.R5, arm32.R3))
	arm32.Sub(ref, arm32.COND_AL, true, arm32.R3, arm32.R3, arm32.Imm(1))
	arm32.BOffset(ref, arm32.COND_PL, false, -12)
	if !asmTextEqMarshal(a, ref) {
		return fail("a 5001-byte byte-wise copy must be the indexed one-byte loop")
	}
	return ""
}

// At the thresholds a copy stays straight-line: 64 bytes is one 7-word LDM/STM chunk
// and nine word moves (20 instructions); 16 bytes byte-wise is 16 byte moves.
func TestAggCopyUnrolledAtThreshold() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	emitAggMemcpyArm32(a, rm, arm32.R0, arm32.R1, 64, false, arm32.R2, arm32.R3)
	if a.Sections[0].Len != 80 { return fail("a 64-byte copy stays unrolled (20 instructions)") }
	var b @asm.Assembler = asm.New(4)
	b.SetSection("text", -1)
	emitAggMemcpyArm32(b, rm, arm32.R0, arm32.R1, 16, true, arm32.R2, arm32.R3)
	if b.Sections[0].Len != 128 {
		return fail("a 16-byte byte-wise copy stays unrolled (32 instructions)")
	}
	return ""
}

// A large frame region is zeroed by a loop storing one zero word per iteration off a
// pool base register, indexed by IP.
func TestFrameZeroLoopByteRef() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	emitFrameZeroArm32(a, rm, 8, 4400, arm32.R2)
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Mov(ref, arm32.COND_AL, false, arm32.R2, arm32.Imm(0))
	emitFrameAddr(ref, arm32.R4, 8)
	emitConstInt32(ref, arm32.IP, 4396)
	arm32.Str(ref, arm32.COND_AL, arm32.R2, arm32.MemReg(arm32.R4, arm32.IP))
	arm32.Sub(ref, arm32.COND_AL, true, arm32.IP, arm32.IP, arm32.Imm(4))
	arm32.BOffset(ref, arm32.COND_PL, false, -8)
	if !asmTextEqMarshal(a, ref) {
		return fail("a 4400-byte zero-fill must be the one-word store loop")
	}
	return ""
}

// A shim's word copy is an LDM/STM loop of two words per iteration through {R4, LR},
// advancing the cursors and counted in IP; an odd word follows through R4.
func TestShimCopyLoopByteRef() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitShimCopyLoopArm32(a, arm32.R3, arm32.R2, 4404, false)
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	var mask int = (1 << arm32.R4) | (1 << arm32.LR)
	emitConstInt32(ref, arm32.IP, 550)
	arm32.Ldm(ref, arm32.COND_AL, arm32.R2, true, mask)
	arm32.Stm(ref, arm32.COND_AL, arm32.R3, true, mask)
	arm32.Sub(ref, arm32.COND_AL, true, arm32.IP, arm32.IP, arm32.Imm(1))
	arm32.BOffset(ref, arm32.COND_NE, false, -12)
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.R2, 0))
	arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.R3, 0))
	if !asmTextEqMarshal(a, ref) {
		return fail("a shim's 4404-byte copy must be the two-word LDM/STM loop plus the odd word")
	}
	return ""
}
