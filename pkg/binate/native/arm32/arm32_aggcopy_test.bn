package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/types"
import "pkg/builtins/testing"

// emitAggMemcpyArm32 with byteWise=true copies PER BYTE (LDRB + STRB each) so a
// sub-word-aligned aggregate never triggers a faulting word access on strict-align
// arm32.  A 3-byte copy is 3 * (LDRB + STRB) = 6 instructions = 24 bytes.
func TestAggMemcpyByteWiseIsPerByte() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitAggMemcpyArm32(a, arm32.R0, arm32.R1, 3, true, arm32.R2, arm32.R3)
	if a.Sections[0].Len != 24 {
		return fail("byte-wise memcpy of 3 bytes should emit 6 instrs (24 bytes)")
	}
	return ""
}

// emitAggMemcpyArm32 with byteWise=false copies PER WORD (LDR + STR).  A 4-byte copy
// is one word = LDR + STR = 2 instructions = 8 bytes (a single word regardless of the
// live target's word size, since 4 <= wordBytes on every target).
func TestAggMemcpyWordWiseIsPerWord() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitAggMemcpyArm32(a, arm32.R0, arm32.R1, 4, false, arm32.R2, arm32.R3)
	if a.Sections[0].Len != 8 {
		return fail("word-wise memcpy of 4 bytes should emit 2 instrs (8 bytes)")
	}
	return ""
}

// aggNeedsBytewiseArm32 is true exactly for a sub-word-aligned aggregate (which the
// layout can place at a non-word-aligned address): a 3-int8 struct (align 1) needs
// byte-wise; a struct with an int field (word-aligned) does not; nil does not.
func TestAggNeedsBytewiseClassify() testing.TestResult {
	var f3 @[]@types.Field = make_slice(@types.Field, 3)
	f3[0] = make(types.Field)
	f3[0].Type = types.TypInt8()
	f3[1] = make(types.Field)
	f3[1].Type = types.TypInt8()
	f3[2] = make(types.Field)
	f3[2].Type = types.TypInt8()
	if !aggNeedsBytewiseArm32(types.MakeStructType("", f3)) {
		return fail("a 3-int8 struct (align 1) must be byte-wise")
	}
	var f1 @[]@types.Field = make_slice(@types.Field, 1)
	f1[0] = make(types.Field)
	f1[0].Type = types.TypInt()
	if aggNeedsBytewiseArm32(types.MakeStructType("", f1)) {
		return fail("a word-aligned struct (int field) must be word-wise")
	}
	if aggNeedsBytewiseArm32(nil) {
		return fail("nil type must not be byte-wise")
	}
	return ""
}
