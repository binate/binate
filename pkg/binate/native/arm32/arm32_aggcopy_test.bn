package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// emitAggMemcpyArm32 with byteWise=true copies PER BYTE (LDRB + STRB each) so a
// sub-word-aligned aggregate never triggers a faulting word access on strict-align
// arm32.  A 3-byte copy is 3 * (LDRB + STRB) = 6 instructions = 24 bytes.
func TestAggMemcpyByteWiseIsPerByte() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	emitAggMemcpyArm32(a, rm, arm32.R0, arm32.R1, 3, true, arm32.R2, arm32.R3)
	if a.Sections[0].Len != 24 {
		return fail("byte-wise memcpy of 3 bytes should emit 6 instrs (24 bytes)")
	}
	return ""
}

// emitAggMemcpyArm32 with byteWise=false, one word: a single word never beats a plain
// LDR + STR, so it does NOT use LDM/STM.  A 4-byte copy is LDR + STR = 8 bytes.
func TestAggMemcpyWordWiseIsPerWord() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	emitAggMemcpyArm32(a, rm, arm32.R0, arm32.R1, 4, false, arm32.R2, arm32.R3)
	if a.Sections[0].Len != 8 {
		return fail("word-wise memcpy of 4 bytes should emit 2 instrs (8 bytes)")
	}
	return ""
}

// A >= 2-word word-aligned copy moves the leading chunk with a SINGLE LDM + STM
// (many words in two instructions) rather than a per-word LDR/STR loop.  With a
// fresh RegMap the whole 16-byte (4-word) aggregate fits one LDM/STM pair drawn
// from the free pool registers R4..R7 → 2 instrs = 8 bytes, versus 32 bytes for a
// word loop.  The first instruction is an LDM (LDMIA opcode, high byte 0xE8).
func TestAggMemcpyWordWiseUsesLdmStm() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	emitAggMemcpyArm32(a, rm, arm32.R0, arm32.R1, 16, false, arm32.R2, arm32.R3)
	if a.Sections[0].Len != 8 {
		return fail("16-byte word-wise copy should be one LDM + STM = 8 bytes")
	}
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	if data[3] != cast(uint8, 0xE8) {
		return fail("leading chunk should be an LDM (LDMIA high byte 0xE8)")
	}
	return ""
}

// aggNeedsBytewiseArm32 is true exactly for a sub-word-aligned aggregate (which the
// layout can place at a non-word-aligned address): a 3-int8 struct (align 1) needs
// byte-wise; a struct with an int field (word-aligned) does not; nil does not.
func TestAggNeedsBytewiseClassify() testing.TestResult {
	var f3 @[]@types.Field = make_slice(@types.Field, 3)
	f3[0] = make(types.Field)
	f3[0].Type = types.TypInt8()
	f3[1] = make(types.Field)
	f3[1].Type = types.TypInt8()
	f3[2] = make(types.Field)
	f3[2].Type = types.TypInt8()
	if !aggNeedsBytewiseArm32(types.MakeStructType("", f3)) {
		return fail("a 3-int8 struct (align 1) must be byte-wise")
	}
	var f1 @[]@types.Field = make_slice(@types.Field, 1)
	f1[0] = make(types.Field)
	f1[0].Type = types.TypInt()
	if aggNeedsBytewiseArm32(types.MakeStructType("", f1)) {
		return fail("a word-aligned struct (int field) must be word-wise")
	}
	if aggNeedsBytewiseArm32(nil) {
		return fail("nil type must not be byte-wise")
	}
	return ""
}

// emitAggMemcpySafeArm32 loads ALL words with a single LDM (then one STM) so an
// aliasing `*dst = *src` reads all of src before writing dst.  A 16-byte (4-word)
// copy is one LDM(popcount 4) + one STM = 8 bytes, with no interleaved word tail.
func TestAggMemcpySafeArm32SingleLdmAllWords() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	emitAggMemcpySafeArm32(a, rm, arm32.R0, arm32.R1, 16, false, arm32.R2, arm32.IP)
	if a.Sections[0].Len != 8 {
		return fail("16-byte overlap-safe copy should be one LDM + one STM (8 bytes)")
	}
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var d *[]uint8 = a.Sections[0].Data
	if d[3] != cast(uint8, 0xE8) { return fail("first instr should be an LDM (LDMIA, 0xE8)") }
	var mask int = cast(int, d[0]) | (cast(int, d[1]) << 8)
	var pc int = 0
	for b := 0; b < 16; b = b + 1 { if ((mask >> b) & 1) == 1 { pc = pc + 1 } }
	if pc != 4 { return fail("LDM must cover all 4 words (register-mask popcount 4)") }
	return ""
}

// Under register pressure — pool registers holding retained values — the single LDM
// must STILL cover all 4 words: scratchReg evicts the retained values loss-free
// (the fix for emitAggMemcpyArm32's best-effort chunk that would skip them).
func TestAggMemcpySafeArm32LdmCoversAllUnderPressure() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// Retain values in five of the seven pool registers (R4..R8), leaving only R9,R10
	// free; src/dst/tmp are home registers so they do not consume the pool.
	rm.AssignReg(1, arm32.R4)
	rm.AssignReg(2, arm32.R5)
	rm.AssignReg(3, arm32.R6)
	rm.AssignReg(4, arm32.R7)
	rm.AssignReg(5, arm32.R8)
	emitAggMemcpySafeArm32(a, rm, arm32.R0, arm32.R1, 16, false, arm32.R2, arm32.IP)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var d *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	// Find the LDM (0xE8.. with the L bit) and assert its mask popcount is 4.
	var found bool = false
	for off := 0; off + 4 <= n; off = off + 4 {
		if d[off + 3] == cast(uint8, 0xE8) && (d[off + 2] & cast(uint8, 0x10)) != cast(uint8, 0) {
			var mask int = cast(int, d[off]) | (cast(int, d[off + 1]) << 8)
			var pc int = 0
			for b := 0; b < 16; b = b + 1 { if ((mask >> b) & 1) == 1 { pc = pc + 1 } }
			if pc == 4 { found = true }
		}
	}
	if !found {
		return fail("under pressure the LDM must still cover all 4 words (evict retained)")
	}
	return ""
}
