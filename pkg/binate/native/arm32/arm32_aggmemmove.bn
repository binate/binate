package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/native/common"

// The overlap-safe copy of an aggregate too large to load whole into registers: the
// store of an AGG_LOAD_IN_PLACE_OVERLAPPING load, whose destination may overlap its
// source, copies as memmove does.

// emitAggMemmoveArm32 copies sz bytes (a whole number of words, from word-aligned
// addresses) from [srcPtr] to [dstPtr] as memmove does, right however the two overlap:
// ascending when the destination starts below the source or at or past its end,
// descending when it starts inside it (dst - src, unsigned, below sz).  It claims two
// pool registers as cursors and the free pool registers, up to four, as an LDM/STM
// chunk — at least two, evicting cached values loss-free (scratchReg) when fewer are
// free; both pointers are marked claimed first so neither is evicted.  scratch (IP,
// not a pool register) holds the direction test, then counts the loop.  The two
// directions are straight blocks (emitAggMemmoveBlockArm32), the second reached by a
// branch whose displacement is measured beforehand, so the copy records no fixup.
func emitAggMemmoveArm32(a @asm.Assembler, rm @common.RegMap, dstPtr int, srcPtr int, sz int,
		scratch int) {
	var w int = wordBytes()
	if sz <= 0 || sz % w != 0 {
		a.SetError("native arm32: an overlap-safe copy needs a whole number of words")
		return
	}
	rm.MarkUsed(dstPtr)
	rm.MarkUsed(srcPtr)
	var s int = scratchReg(rm)
	var d int = scratchReg(rm)
	var mask int = 0
	var nData int = 0
	var first int = -1
	for i := 0; i <= 6 && nData < 4; i = i + 1 {
		var r int = regPool(i)
		if rm.IsUsed(r) || rm.RegHeldBy(r) >= 0 { continue }
		rm.MarkUsed(r)
		mask = mask | (1 << r)
		nData = nData + 1
		if first < 0 { first = r }
	}
	for nData < 2 {
		var r int = scratchReg(rm)
		mask = mask | (1 << r)
		nData = nData + 1
		if first < 0 { first = r }
	}
	emitConstInt32(a, s, sz)
	arm32.Sub(a, arm32.COND_AL, false, scratch, dstPtr, arm32.Reg(srcPtr))
	arm32.Cmp(a, arm32.COND_AL, scratch, arm32.Reg(s))
	var up int = aggMemmoveBlockBytesArm32(true, dstPtr, srcPtr, sz, s, d, mask, nData, first, scratch)
	var down int = aggMemmoveBlockBytesArm32(false, dstPtr, srcPtr, sz, s, d, mask, nData, first,
			scratch)
	// BLO skips itself, the ascending block and the B past the descending one.
	arm32.BOffset(a, arm32.COND_LO, false, 8 + up)
	emitAggMemmoveBlockArm32(a, true, dstPtr, srcPtr, sz, s, d, mask, nData, first, scratch)
	arm32.BOffset(a, arm32.COND_AL, false, 4 + down)
	emitAggMemmoveBlockArm32(a, false, dstPtr, srcPtr, sz, s, d, mask, nData, first, scratch)
}

// aggMemmoveBlockBytesArm32 returns the size in bytes of emitAggMemmoveBlockArm32's
// block for these operands, by emitting it into a scratch assembler.
func aggMemmoveBlockBytesArm32(up bool, dstPtr int, srcPtr int, sz int, s int, d int, mask int,
		nData int, first int, count int) int {
	var m @asm.Assembler = asm.New(4)
	m.SetSection("text", -1)
	emitAggMemmoveBlockArm32(m, up, dstPtr, srcPtr, sz, s, d, mask, nData, first, count)
	return m.Sections[0].Len
}

// emitAggMemmoveBlockArm32 copies sz word-aligned bytes from [srcPtr] to [dstPtr] in one
// direction with an LDM/STM loop over the nData registers in mask (the lowest of them
// `first`), through the cursors s and d, counting iterations in count.  Ascending (up)
// it is emitLdmCopyLoopArm32 from the bottom; descending, LDMDB / STMDB from the top,
// the words left over (fewer than a chunk) following at the bottom.  Either way the
// words left over are read after the loop, which in that direction never writes them
// in the source, one word at a time, each read before it is written.  srcPtr and dstPtr
// stay intact.
func emitAggMemmoveBlockArm32(a @asm.Assembler, up bool, dstPtr int, srcPtr int, sz int, s int,
		d int, mask int, nData int, first int, count int) {
	if up {
		arm32.Mov(a, arm32.COND_AL, false, s, arm32.Reg(srcPtr))
		arm32.Mov(a, arm32.COND_AL, false, d, arm32.Reg(dstPtr))
		emitLdmCopyLoopArm32(a, d, s, sz, mask, nData, first, count)
		return
	}
	var w int = wordBytes()
	var chunk int = nData * w
	emitConstInt32(a, count, sz)
	arm32.Add(a, arm32.COND_AL, false, s, srcPtr, arm32.Reg(count))
	arm32.Add(a, arm32.COND_AL, false, d, dstPtr, arm32.Reg(count))
	if sz >= chunk {
		emitConstInt32(a, count, sz / chunk)
		var top int = a.Sections[a.Current].Len
		arm32.Ldmdb(a, arm32.COND_AL, s, true, mask)
		arm32.Stmdb(a, arm32.COND_AL, d, true, mask)
		arm32.Sub(a, arm32.COND_AL, true, count, count, arm32.Imm(1))
		branchBackArm32(a, arm32.COND_NE, top)
	}
	for off := w; off <= sz % chunk; off = off + w {
		arm32.Ldr(a, arm32.COND_AL, first, arm32.MemImm(s, -off))
		arm32.Str(a, arm32.COND_AL, first, arm32.MemImm(d, -off))
	}
}
