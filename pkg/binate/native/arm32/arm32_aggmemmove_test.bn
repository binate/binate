package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for arm32_aggmemmove.bn: the copy that picks its direction at run time.

// branchTargetArm32 returns the byte target of the B at word i of a (offsets are from
// the instruction's address plus 8).
func branchTargetArm32(w int, i int) int {
	var off int = w & 0xFFFFFF
	if (off & 0x800000) != 0 { off = off - 0x1000000 }
	return 4 * i + 8 + 4 * off
}

// Past what it loads whole into registers (16 bytes soft-float, 48 hard-float), a
// word-aligned copy whose destination may overlap its source picks its direction at
// run time: BLO (dst - src below the size, unsigned) to the descending block — an
// LDMDB / STMDB loop — past the ascending one, an LDM / STM loop ending in a B past
// the descending one, which ends the copy.
func TestEmitAggMemmoveArm32Branches() testing.TestResult {
	var old types.TargetInfo = stampArm32HardFull()
	defer { types.SetTarget(old) }
	for pass := 0; pass < 2; pass++ {
		var sizes @[]int = @[]int{52, 100, 808}
		if pass == 1 {
			types.SetFloatABI(types.FLOAT_ABI_DEFAULT)
			sizes = @[]int{20, 64, 100, 808}
		}
		for si := 0; si < len(sizes); si++ {
			var a @asm.Assembler = asm.New(4)
			a.SetSection("text", -1)
			emitAggMemcpySafeArm32(a, common.NewRegMap(callconv.AAPCS32()), arm32.R0, arm32.R1, sizes[si],
					false, arm32.R2, arm32.IP, true)
			var n int = a.Sections[0].Len / 4
			var down int = -1
			var ia int = 0
			var db int = 0
			for i := 0; i < n; i++ {
				var w int = arm32TestWord(a, i)
				var isB bool = ((w >> 24) & 0xF) == 0xA
				if isB && down < 0 && branchTargetArm32(w, i) > 4 * i {
					if ((w >> 28) & 0xF) != arm32.COND_LO { return fail("the direction branch is BLO") }
					down = branchTargetArm32(w, i)
				}
				if ((w >> 25) & 7) == 4 && ((w >> 20) & 1) == 1 {
					if ((w >> 23) & 3) == 1 { ia = ia + 1 }
					if ((w >> 23) & 3) == 2 { db = db + 1 }
				}
			}
			if down < 0 { return fail("an overlapping copy picks its direction with a forward BLO") }
			if ia != 1 || db != 1 { return fail("an ascending LDM loop and a descending LDMDB loop") }
			var bw int = arm32TestWord(a, down / 4 - 1)
			if ((bw >> 24) & 0xF) != 0xA || ((bw >> 28) & 0xF) != arm32.COND_AL {
				return fail("the ascending block ends in a B")
			}
			if branchTargetArm32(bw, down / 4 - 1) != a.Sections[0].Len {
				return fail("the B lands just past the descending block")
			}
		}
	}
	return ""
}

// emitStructCopy copies the store of a load flagged InPlaceOverlapping (its pointer in
// its spill slot) as memmove does — past 64 bytes too, where the plain copy is a loop
// — branching on the direction to an LDMDB loop; the same store unflagged is the plain
// loop, with neither.
func TestEmitStructCopyOverlappingLoadPicksDirection() testing.TestResult {
	var old types.TargetInfo = types.GetTarget()
	defer { types.SetTarget(old) }
	setArm32Target()
	var sizes @[]int = @[]int{25, 202}
	for si := 0; si < len(sizes); si++ {
		var t @types.Type = types.MakeArrayType(types.TypInt32(), cast(int64, sizes[si]))
		for flagged := 0; flagged < 2; flagged++ {
			var a @asm.Assembler = asm.New(4)
			a.SetSection("text", -1)
			var m @common.RegMap = common.NewRegMap(callconv.AAPCS32())
			m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
			m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
			m.AllocIDs = common.AppendInt(m.AllocIDs, 2)
			m.AllocOffsets = common.AppendInt(m.AllocOffsets, 8)
			m.AllocSizes = common.AppendInt(m.AllocSizes, 4 * sizes[si])
			if flagged == 1 {
				m.InPlaceOverlapping = make_slice(bool, 3)
				m.InPlaceOverlapping[1] = true
			}
			var src @ir.Instr = make(ir.Instr)
			src.ID = 1
			src.Op = iropcode.OP_LOAD
			src.Typ = t
			var dst @ir.Instr = make(ir.Instr)
			dst.ID = 2
			var ins @ir.Instr = make(ir.Instr)
			ins.Op = iropcode.OP_STORE
			ins.Args = make_slice(@ir.Instr, 2)
			ins.Args[0] = dst
			ins.Args[1] = src
			emitStructCopy(a, "main", m, ins)
			var blo int = 0
			var db int = 0
			for i := 0; i < a.Sections[0].Len / 4; i++ {
				var w int = arm32TestWord(a, i)
				if ((w >> 24) & 0xF) == 0xA && ((w >> 28) & 0xF) == arm32.COND_LO &&
						branchTargetArm32(w, i) > 4 * i {
					blo = blo + 1
				}
				if ((w >> 25) & 7) == 4 && ((w >> 20) & 1) == 1 && ((w >> 23) & 3) == 2 { db = db + 1 }
			}
			if blo != flagged || db != flagged {
				return fail("only a flagged store's copy branches on its direction to an LDMDB loop")
			}
		}
	}
	return ""
}
