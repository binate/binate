package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emitBoundsCheck64 (arm32_int64_guard.bn): the bounds check of an
// index wider than int — an int64 register pair on this ILP32 target.

// stampIlp32 stamps an ILP32 arm32 target (where int64 is wider than int) and
// returns the prior target for the caller to restore.
func stampIlp32() types.TargetInfo {
	var old types.TargetInfo = types.GetTarget()
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
	types.SetArch(types.ARCH_ARM32)
	return old
}

// boundsCheckOf builds OP_BOUNDS_CHECK(index id 1 of type idxTyp, length id 2).
func boundsCheckOf(idxTyp @types.Type) @ir.Instr {
	var idx @ir.Instr = make(ir.Instr)
	idx.ID = 1
	idx.Typ = idxTyp
	var ln @ir.Instr = make(ir.Instr)
	ln.ID = 2
	ln.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_BOUNDS_CHECK
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = idx
	ins.Args[1] = ln
	return ins
}

// An int64 index is checked as its whole value: both words are loaded, `cmp hi,
// #0` then `cmpeq lo, len` decide `blo ok` (in bounds only with a zero high word
// and a low word below the length), and the fail path passes the pair in R0:R1
// and the length in R2 to rt.BoundsFail64.
func TestBoundsCheckWideIndexChecksWholeValue() testing.TestResult {
	var oldTarget types.TargetInfo = stampIlp32()
	defer types.SetTarget(oldTarget)
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	addSpill(rm, 1, 0)
	addSpill(rm, 2, 8)
	emitBoundsCheck(a, "fn", rm, boundsCheckOf(types.TypInt64()))
	if a.HasError { return fail("a wide-index bounds check must not error") }

	var refRm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	var lo int = allocReg(refRm)
	var hi int = allocReg(refRm)
	var ln int = allocReg(refRm)
	var ref @asm.Assembler = mkAsm()
	emitFrameLoad(ref, lo, 0)
	emitFrameLoad(ref, hi, 4)
	emitFrameLoad(ref, ln, 8)
	var okLbl @[]char = common.BoundsLabel("fn", 0, false)
	arm32.Cmp(ref, arm32.COND_AL, hi, arm32.Imm(0))
	arm32.Cmp(ref, arm32.COND_EQ, lo, arm32.Reg(ln))
	arm32.B(ref, arm32.COND_LO, okLbl)
	arm32.Mov(ref, arm32.COND_AL, false, arm32.R2, arm32.Reg(ln))
	arm32.Mov(ref, arm32.COND_AL, false, arm32.R0, arm32.Reg(lo))
	arm32.Mov(ref, arm32.COND_AL, false, arm32.R1, arm32.Reg(hi))
	var callee @[]char = symPrefixed(mangleRtFunc("BoundsFail64"))
	ref.SetGlobal(callee)
	arm32.Bl(ref, arm32.COND_AL, callee)
	ref.DefineLabel(okLbl)
	if !sameBytes(a, ref) {
		return fail("a wide-index bounds check must test the whole pair and call rt.BoundsFail64")
	}
	return ""
}

// A word-sized (int) index keeps the one-compare check and rt.BoundsFail.
func TestBoundsCheckIntIndexUnchanged() testing.TestResult {
	var oldTarget types.TargetInfo = stampIlp32()
	defer types.SetTarget(oldTarget)
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	addSpill(rm, 1, 0)
	addSpill(rm, 2, 8)
	emitBoundsCheck(a, "fn", rm, boundsCheckOf(types.TypInt()))
	if a.HasError { return fail("an int-index bounds check must not error") }
	var refRm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	var idx int = allocReg(refRm)
	var ln int = allocReg(refRm)
	var ref @asm.Assembler = mkAsm()
	emitFrameLoad(ref, idx, 0)
	emitFrameLoad(ref, ln, 8)
	arm32.Cmp(ref, arm32.COND_AL, idx, arm32.Reg(ln))
	if !containsWord(a, word32(ref, 8)) {
		return fail("an int-index bounds check should still be one unsigned compare")
	}
	return ""
}

// A length homed in an argument register (R0, R1 or R2 — caller-saved homes on
// this target) is read straight from its home and moved into R2 BEFORE the index
// pair is written to R0:R1, so a length in R0 or R1 is not overwritten first.
func TestBoundsCheckWideIndexHomedLengthMarshalsFirst() testing.TestResult {
	var oldTarget types.TargetInfo = stampIlp32()
	defer types.SetTarget(oldTarget)
	var homes @[]int = make_slice(int, 3)
	homes[0] = arm32.R0
	homes[1] = arm32.R1
	homes[2] = arm32.R2
	for i := 0; i < len(homes); i++ {
		var home int = homes[i]
		var a @asm.Assembler = mkAsm()
		var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
		addSpill(rm, 1, 0)
		rm.HomeIDs = common.AppendInt(rm.HomeIDs, 2)
		rm.HomeRegs = common.AppendInt(rm.HomeRegs, home)
		emitBoundsCheck(a, "fn", rm, boundsCheckOf(types.TypInt64()))
		if a.HasError { return fail("a wide-index check with a homed length must not error") }

		var refRm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
		var lo int = allocReg(refRm)
		var hi int = allocReg(refRm)
		var ref @asm.Assembler = mkAsm()
		emitFrameLoad(ref, lo, 0)
		emitFrameLoad(ref, hi, 4)
		var okLbl @[]char = common.BoundsLabel("fn", 0, false)
		arm32.Cmp(ref, arm32.COND_AL, hi, arm32.Imm(0))
		arm32.Cmp(ref, arm32.COND_EQ, lo, arm32.Reg(home))
		arm32.B(ref, arm32.COND_LO, okLbl)
		if home != arm32.R2 {
			arm32.Mov(ref, arm32.COND_AL, false, arm32.R2, arm32.Reg(home))
		}
		arm32.Mov(ref, arm32.COND_AL, false, arm32.R0, arm32.Reg(lo))
		arm32.Mov(ref, arm32.COND_AL, false, arm32.R1, arm32.Reg(hi))
		var callee @[]char = symPrefixed(mangleRtFunc("BoundsFail64"))
		ref.SetGlobal(callee)
		arm32.Bl(ref, arm32.COND_AL, callee)
		ref.DefineLabel(okLbl)
		if !sameBytes(a, ref) {
			return fail("a homed length must move to R2 before the index pair fills R0:R1")
		}
	}
	return ""
}
