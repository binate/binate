package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// emitCEntryThunks emits one weak `__centry.<mangled>` adaptation thunk per
// narrow-argument __c_entry target: the target's narrow GP argument-register
// normalization (the same emitCExportRegNormArm32 a #[c_export] entry uses), then
// an unconditional BRANCH to the mangled entry.  A C caller entering the thunk
// sign-/zero-extends the narrow argument registers whose high bits AAPCS32 leaves
// unspecified (int8/int16 — int/int32 is word-sized on arm32, so most narrow args
// do not occur here), then jumps into the real body.  The branch is load-bearing:
// the thunk is a distinct symbol from the entry, so it can never fall through.
// Each thunk is WEAK so the copies every native TU emits coalesce into one
// survivor program-wide — that single address is what delivers pkg.centry.identity.
// emitCExportRegNormArm32 derives the AAPCS32 sret shift (an aggregate return takes
// the hidden R0 pointer — SretInGpArgReg — shifting the GP argument registers) from
// the target's own signature via CEntryRegNormWalk, so the fresh RegMap here needs
// only its calling convention — no PlanFrame.
func emitCEntryThunks(a @asm.Assembler, pkgName *[]readonly char, targets @[]@ir.Func) {
	for ti := 0; ti < len(targets); ti++ {
		var tf @ir.Func = targets[ti]
		var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
		var thunk @[]char = cEntryThunkSym(pkgName, tf.Name)
		a.DefineLabel(thunk)
		a.SetWeak(thunk)
		emitCExportRegNormArm32(a, rm, tf)
		var entry @[]char = symFor(pkgName, tf.Name)
		a.SetGlobal(entry)
		arm32.B(a, arm32.COND_AL, entry)
	}
}
