package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// emitCEntryThunks emits one weak `__centry.<mangled>` adaptation thunk per
// __c_entry target that needs C-ABI adaptation.  Two shapes, mirroring the
// #[c_export] entry:
//   - argument-register-only: normalize the target's narrow GP argument registers
//     (the same emitCExportRegNormArm32 a #[c_export] entry uses), then an
//     unconditional BRANCH to the mangled entry — a C caller sign-/zero-extends
//     the narrow registers AAPCS32 leaves unspecified (int8/int16 — int/int32 is
//     word-sized on arm32, so most narrow args do not occur here), then jumps into
//     the body.
//   - a divergent multi-value RETURN: the adaptation happens AFTER the body
//     returns, so a tail-branch cannot serve; the thunk becomes the #[c_export]
//     TRAMPOLINE (emitCExportTrampolineArm32), which re-marshals the arguments,
//     calls the mangled entry, repacks the return into the C struct-return form,
//     and returns.
// The branch/trampoline is load-bearing: the thunk is a distinct symbol from the
// entry, so it can never fall through.  Each thunk is WEAK so the copies every
// native TU emits coalesce into one survivor program-wide — that single address is
// what delivers pkg.centry.identity.  Both paths derive the AAPCS32 sret shift (an
// aggregate / sret'd multi-return takes the hidden R0 pointer — SretInGpArgReg —
// shifting the GP argument registers) from the target's own signature, so the fresh
// RegMap here needs only its calling convention — no PlanFrame.
func emitCEntryThunks(a @asm.Assembler, pkgName *[]readonly char, targets @[]@ir.Func) {
	for ti := 0; ti < len(targets); ti++ {
		var tf @ir.Func = targets[ti]
		var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
		var thunk @[]char = cEntryThunkSym(pkgName, tf.Name)
		a.DefineLabel(thunk)
		a.SetWeak(thunk)
		var entry @[]char = symFor(pkgName, tf.Name)
		a.SetGlobal(entry)
		if cExportRetTrampolineKindArm32(tf, rm.CC) != common.CRET_ADAPT_NONE {
			emitCExportTrampolineArm32(a, rm, tf, entry)
		} else {
			emitCExportRegNormArm32(a, rm, tf)
			arm32.B(a, arm32.COND_AL, entry)
		}
	}
}
