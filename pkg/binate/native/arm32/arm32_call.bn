package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Direct function call lowering (walking-skeleton subset)
// ============================================================
//
// emitCall handles OP_CALL / OP_C_CALL — a known callee resolved by name and
// reached via `BL <symbol>`.  The skeleton supports scalar / pointer args
// (R0..R3, then stack) and a single scalar / void return; aggregate args,
// 64-bit register pairs, sret, and multi-return collection are P3 territory.
// A shape outside that subset (an aggregate/float arg or return, or an arg
// operand that can't be materialized) fails LOUDLY via a.SetError rather than
// being silently dropped / split into the wrong registers.  Mirrors the
// reduced shape of aarch64_call.bn.

// emitCall moves scalar args into R0..R3 (overflow to the outgoing-args stack
// area) and branches to the callee symbol.  ins.StrVal is the Binate-level
// call name (mangled via symFor) for OP_CALL, or a verbatim C symbol for
// OP_C_CALL.  Declares the callee global so Finalize emits a relocation.
func emitCall(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
	allFuncs @[]@ir.Func, ins @ir.Instr) {
	var argTypes @[]@types.Type = make_slice(@types.Type, len(ins.Args))
	for i := 0; i < len(ins.Args); i++ {
		argTypes[i] = ins.Args[i].Typ
	}
	for ai := 0; ai < len(ins.Args); ai++ {
		var arg @ir.Instr = ins.Args[ai]
		if common.IsAggregateTyp(arg.Typ) || common.IsFloatScalarTyp(arg.Typ) {
			// P3: aggregate spread / float pairing.  Silently dropping such an
			// arg would leave a live value unmarshaled and miscompile the call,
			// so fail LOUDLY instead of emitting a wrong binary.
			a.SetError("native arm32: call with aggregate/float arg not "
				"implemented (P3)")
			return
		}
		var regStart int = rm.CC.CallArgRegStart(argTypes, ai)
		var stackOff int = rm.CC.CallArgStackOff(argTypes, ai)
		var src int = emitValOperand(a, pkgName, rm, arg)
		if src < 0 {
			// The arg operand couldn't be materialized (an unsupported value
			// shape); dropping it would pass garbage in its register, so fail
			// LOUDLY rather than continue.
			a.SetError("native arm32: call arg operand not materializable "
				"(P3/P4)")
			return
		}
		if regStart >= 0 {
			if src != argReg(regStart) {
				arm32.Mov(a, arm32.COND_AL, false, argReg(regStart),
					arm32.Reg(src))
			}
		} else if stackOff >= 0 {
			arm32.Str(a, arm32.COND_AL, src,
				arm32.MemImm(arm32.SP, stackOff))
		}
		// Each arg's scratch reg is dead once consumed into argReg / the
		// stack slot; reset so a long arg list doesn't saturate the pool.
		rm.ResetRegs()
	}

	// __c_call carries a verbatim C symbol (no Binate mangling); every other
	// call op goes through symFor.  Both are ELF-bare on arm32.
	var callee @[]char
	if ins.Op == iropcode.OP_C_CALL {
		callee = symPrefixed(ins.StrVal)
	} else {
		callee = symFor(pkgName, ins.StrVal)
	}
	a.SetGlobal(callee)
	arm32.Bl(a, arm32.COND_AL, callee)

	// BL clobbers R0-R3 and R12.  Reset the pool, then spill this call's
	// return value (a single scalar in R0) so later uses can reload.
	rm.ResetRegs()
	if ins.ID < 0 { return }
	if ins.Typ != nil && common.IsAggregateTyp(ins.Typ) {
		// P3: aggregate return collection (data region / sret).  The call
		// produces a live aggregate result that we can't yet collect; dropping
		// it would spill garbage, so fail LOUDLY.
		a.SetError("native arm32: call with aggregate return not implemented "
			"(P3)")
		return
	}
	if common.IsFloatScalarTyp(ins.Typ) {
		// P3: a float scalar return arrives in a different location under
		// hard-float; collecting R0 here would be wrong.  Fail LOUDLY.
		a.SetError("native arm32: call with float return not implemented (P3)")
		return
	}
	var spillOff int = rm.LookupSpill(ins.ID)
	if spillOff < 0 { return }
	arm32.Str(a, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.SP, spillOff))
}
