package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Direct function call lowering
// ============================================================
//
// emitCall handles OP_CALL / OP_C_CALL — a known callee resolved by name and
// reached via `BL <symbol>`.  It supports scalar / pointer args (R0..R3, then
// stack), a 64-bit-pair scalar arg (int64 / uint64 / float64, placed as an
// even-aligned register pair) and a float32 arg (a single GP word, soft-float),
// and aggregate args that fit AAPCS32's ≤16-byte-in-regs / split rules (a raw
// slice is 8 bytes = 2 words, a managed-slice is 16 bytes = 4 words); on the
// return side a scalar / pointer / 64-bit-pair (r0:r1) / float32 (R0) return, a
// BIG single-aggregate return (SizeOf > InternalSretBytes = 4) via AAPCS32 sret,
// and a SMALL (SizeOf <= 4) aggregate return collected by value from R0 into the
// result's data region.  A float64 as a multi-return TUPLE FIELD is the one
// direct-call shape still deferred (P5.3) — it fails LOUDLY via emitScalarStore's
// sz==8 guard rather than being mis-registered.  Mirrors aarch64_call.bn adapted
// to the AAPCS32 register model (WordBytes 4).

// emitCall dispatches args per AAPCS32, sets up the sret pointer if the callee
// returns a big aggregate, branches to the callee, then collects the return
// value.  ins.StrVal is the Binate call name (mangled via symFor) for OP_CALL,
// or a verbatim C symbol for OP_C_CALL.
func emitCall(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, allFuncs @[]@ir.Func,
		ins @ir.Instr) {
	// AAPCS32 sret: a call returning a single aggregate larger than
	// InternalSretBytes (4) — on ILP32 that is EVERY slice / struct — OR a
	// BIG multi-return tuple (gpWords > 4) passes a hidden buffer pointer in R0
	// (the first GP arg register), shifting every user arg up by one register.
	// Model the shift by synthesising a pointer-typed leading entry in argTypes,
	// so CallArgRegStart places user arg i at register slot i+1 (matching
	// x64_call.bn's RDI-shift).  A C-extern callee whose >CExternSretBytes
	// aggregate return uses the same hidden-pointer sret is covered by
	// CalleeUsesCSret.  A SMALL (in-register) multi-return needs no sret pointer
	// — it comes back field-per-register in r0..r3 (collectMultiReturnFields).
	var bigMultiRet bool = ins.ID >= 0 && rm.CC.CallReturnsBigMultiReturn(ins)
	var bigRet bool = ins.ID >= 0 &&
			(rm.CC.CallReturnsBigAggregate(ins) || rm.CC.CalleeUsesCSret(allFuncs, ins) || bigMultiRet)

	var nDispatchArgs int = len(ins.Args)
	if bigRet { nDispatchArgs = nDispatchArgs + 1 }
	var argTypes @[]@types.Type = make_slice(@types.Type, nDispatchArgs)
	if bigRet {
		// First slot is the hidden sret-buffer pointer — a single word that
		// consumes R0.  Going through the classifier (rather than hand-adding 1
		// to a raw reg index) keeps the ILP32 even-align pad correct: after the
		// 1-word prepend ngrn=1 is odd, so a following int64 pads to R2:R3.
		argTypes[0] = types.TypInt()
		for i := 0; i < len(ins.Args); i++ {
			argTypes[i + 1] = ins.Args[i].Typ
		}
	} else {
		for i := 0; i < len(ins.Args); i++ {
			argTypes[i] = ins.Args[i].Typ
		}
	}

	for ai := 0; ai < len(ins.Args); ai++ {
		// User arg ai lives at dispatch slot ai (no sret) or ai+1 (sret — the
		// synthesised pointer takes slot 0).
		var dispatchIdx int = ai
		if bigRet { dispatchIdx = ai + 1 }
		emitCallArg(a, pkgName, rm, argTypes, ins.Args[ai], dispatchIdx)
		if a.HasError { return }
		// Each arg's scratch reg is dead once consumed into argReg / the stack
		// slot; reset so a long arg list doesn't saturate the pool.
		rm.ResetRegs()
	}

	// sret setup: materialize &returnBuffer into R0 AFTER placing args (which
	// occupy R1..) and while IP is free — emitFrameAddr uses IP as its address
	// scratch.  A big multi-return tuple lands in the call result's spill slot
	// (LookupSpill — PlanFrame sized it to the full tuple); a single-aggregate
	// return lands in the alloc data region (LookupAlloc).  Either way the callee
	// writes the bytes through R0.  This is the R0 analogue of x64's
	// `Lea RDI, [RSP + sretOff]`.
	if bigRet {
		var sretOff int = -1
		if bigMultiRet {
			sretOff = rm.LookupSpill(ins.ID)
		} else {
			sretOff = rm.LookupAlloc(ins.ID)
		}
		if sretOff >= 0 {
			emitFrameAddr(a, arm32.R0, sretOff)
		}
	}

	// __c_call carries a verbatim C symbol (no Binate mangling); every other
	// call op goes through symFor.  Both are ELF-bare on arm32.
	var callee @[]char
	if ins.Op == iropcode.OP_C_CALL {
		callee = symPrefixed(ins.StrVal)
	} else {
		callee = symFor(pkgName, ins.StrVal)
	}
	a.SetGlobal(callee)
	arm32.Bl(a, arm32.COND_AL, callee)

	// BL clobbers R0-R3 and R12.  Reset the pool, then collect this call's
	// return value(s) so later uses can reload.
	rm.ResetRegs()
	emitCallReturn(a, rm, allFuncs, ins)
}

// emitCallArg marshals one argument into its AAPCS32 register(s) / stack slot.
// dispatchIdx is the arg's position in argTypes, which — for a big-aggregate-
// return call — carries a synthesised leading sret-pointer slot, so the user
// arg's dispatchIdx is one past its positional index.  A scalar/pointer goes
// into argReg(regStart) or a stack slot; a 64-bit-pair scalar (int64 / uint64 /
// float64) is placed as an even-aligned register pair; an aggregate (raw /
// managed slice) spreads its words across argReg(regStart..) and, on overflow,
// into the outgoing-args area.  A float32 rides the scalar single-word GP path
// like an int32 — soft-float has no FP register file.
func emitCallArg(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		argTypes @[]@types.Type, arg @ir.Instr, dispatchIdx int) {
	var regStart int = rm.CC.CallArgRegStart(argTypes, dispatchIdx)
	var stackOff int = rm.CC.CallArgStackOff(argTypes, dispatchIdx)
	// A 64-bit-pair scalar (int64 / uint64 / float64) is a register PAIR
	// (even-aligned r0:r1 / r2:r3) or an 8-byte stack slot — the CallConv walkers
	// already give the low reg / stack offset; place both words.
	if isPair64Typ(arg.Typ) {
		var lo int
		var hi int
		lo, hi = load64(a, rm, arg)
		if lo < 0 {
			a.SetError("native arm32: 64-bit call arg not materializable (P3)")
			return
		}
		placeInt64Arg(a, lo, hi, regStart, stackOff)
		return
	}
	if common.IsAggregateTyp(arg.Typ) {
		emitAggregateArg(a, rm, arg, regStart, stackOff)
		return
	}
	var src int = emitValOperand(a, pkgName, rm, arg)
	if src < 0 {
		a.SetError("native arm32: call arg operand not materializable (P3/P4)")
		return
	}
	if regStart >= 0 {
		if src != argReg(regStart) {
			arm32.Mov(a, arm32.COND_AL, false, argReg(regStart), arm32.Reg(src))
		}
	} else if stackOff >= 0 {
		// Outgoing stack-arg offset can exceed the 12-bit immediate for a call
		// with a large stack-arg footprint; emitFrameStore materializes in IP.
		emitFrameStore(a, src, stackOff)
	}
}

// emitAggregateArg spreads an aggregate arg's words across its AAPCS32 arg
// registers and stack overflow.  The value already lives contiguously in a
// data region (getOperand returns a pointer to it); we load word w to
// argReg(regStart+w) for the in-reg words and copy the rest into the outgoing-
// args area.  AAPCS32 (SplitAggregates) allows straddling the R0..R3 boundary.
// An indirect-large aggregate (> AggregateInRegMax) is passed as a single
// pointer word instead.  Mirrors aarch64_call.bn's aggregate arm with word=4
// and R12 (IP) as the stack-copy temp.
func emitAggregateArg(a @asm.Assembler, rm @common.RegMap, arg @ir.Instr, regStart int,
		stackOff int) {
	var ptr int = getOperand(a, rm, arg.ID)
	if ptr < 0 {
		a.SetError("native arm32: aggregate call arg not materializable (P3)")
		return
	}
	if rm.CC.IndirectLargeAggregates && arg.Typ.SizeOf() > rm.CC.AggregateInRegMax {
		if regStart >= 0 {
			if ptr != argReg(regStart) {
				arm32.Mov(a, arm32.COND_AL, false, argReg(regStart), arm32.Reg(ptr))
			}
		} else if stackOff >= 0 {
			// Large-footprint call: outgoing offset may exceed the 12-bit
			// immediate, so materialize the SP store address via IP.
			emitFrameStore(a, ptr, stackOff)
		}
		return
	}
	var w int = wordBytes()
	var nWords int = rm.CC.ArgWords(arg.Typ)
	var regWords int = 0
	if regStart >= 0 {
		regWords = nWords
		if stackOff >= 0 { regWords = rm.CC.NumGpArgRegs - regStart }
		for wi := 0; wi < regWords; wi++ {
			arm32.Ldr(a, arm32.COND_AL, argReg(regStart + wi), arm32.MemImm(ptr, w * wi))
		}
	}
	if stackOff >= 0 {
		// The outgoing-args offset can exceed the 12-bit immediate for a call
		// with a large stack-arg footprint, so the SP store routes through the
		// IP-materializing emitFrameStore.  The copy value therefore lands in a
		// POOL register (not IP) — IP is emitFrameStore's own address scratch.
		var tmp int = scratchReg(rm)
		for wi := regWords; wi < nWords; wi++ {
			emitBaseLoad(a, tmp, ptr, w * wi, arm32.IP)
			emitFrameStore(a, tmp, stackOff + w * (wi - regWords))
		}
	}
}

// emitCallReturn collects the call's result after the BL.  A single (non-multi-
// return) BIG aggregate return (SizeOf > InternalSretBytes = 4 — every slice,
// most structs) arrived via AAPCS32 sret: the callee wrote its bytes through the
// R0 buffer pointer directly into the call result's alloc data region, so there
// is no post-call byte copy — the data region IS the result; LEA a pointer to it
// into the result register (matching x64's `Lea rd, [RSP + dataOff]`) so
// downstream consumers see a pointer to the bytes.  A SMALL aggregate (SizeOf <=
// 4) is NOT sret — AAPCS32 returns it by value in R0 — so it is collected by
// storing R0 into the result's data region first, then LEAing that region
// pointer.  A MULTI-return tuple lands in the call's spill slot: a big tuple was
// already written through the R0 sret buffer (nothing to collect); a small one
// comes back field-per-register in r0..r3 (collectMultiReturnFields).  Otherwise
// the result is a scalar / pointer; a 64-bit-pair scalar (int64 / uint64 /
// float64) returns in r0:r1, and every other scalar (incl. float32) returns in
// R0 and spills to the result's slot.
func emitCallReturn(a @asm.Assembler, rm @common.RegMap, allFuncs @[]@ir.Func, ins @ir.Instr) {
	if ins.ID < 0 { return }
	// A single-value aggregate return (a slice / array / named struct-by-value,
	// NOT a multi-return TYP_STRUCT) uses the alloc-region convention below; a
	// multi-return tuple (also a TYP_STRUCT that IsAggregateTyp matches) is
	// collected into its spill slot further down.
	if ins.Typ != nil && common.IsAggregateTyp(ins.Typ) && !common.IsMultiReturnCall(ins) {
		// A big aggregate came back via AAPCS32 sret (the callee wrote through the
		// R0 buffer into the call result's alloc data region), so there is nothing
		// to store — just LEA the data-region pointer.  A small (<=4-byte)
		// aggregate came back BY VALUE in R0 (one word), so store it into the data
		// region first, then LEA.  Either way downstream consumers see a pointer
		// to the bytes.  Mirrors x64's big-agg Lea / !bigRet RAX-store + Lea.
		var bigRet bool = rm.CC.CallReturnsBigAggregate(ins) || rm.CC.CalleeUsesCSret(allFuncs, ins)
		var dataOff int = rm.LookupAlloc(ins.ID)
		if dataOff < 0 { return }
		if !bigRet {
			emitFrameStore(a, arm32.R0, dataOff)
		}
		var rd int = nextReg(rm, ins.ID)
		emitFrameAddr(a, rd, dataOff)
		return
	}
	var spillOff int = rm.LookupSpill(ins.ID)
	if spillOff < 0 { return }
	// Multi-return tuple: a big tuple (gpWords > 4) was already written through
	// the R0 sret buffer into this spill slot by the callee — nothing to collect.
	// A small tuple comes back field-per-register in r0..r3.
	if common.IsMultiReturnCall(ins) {
		if rm.CC.CallReturnsBigMultiReturn(ins) { return }
		collectMultiReturnFields(a, rm, ins, spillOff)
		return
	}
	// A 64-bit-pair scalar return (int64 / uint64 / float64) comes back in r0:r1;
	// store both words to the slot.  A float32 returns in R0 like a 32-bit scalar.
	if isPair64Typ(ins.Typ) {
		emitFrameStore(a, arm32.R0, spillOff)
		emitFrameStore(a, arm32.R1, spillOff + 4)
		return
	}
	// Canonicalize a sub-word integer return in R0 before the spill (see
	// aarch64.collectScalarReturn): AAPCS32 only guarantees the low width of a
	// sub-word result, so a FOREIGN (C / cross-ABI) int8/int16 return must be
	// sign/zero-extended to R0's full width before native code uses it directly (a
	// compare / arithmetic), else `if c_signed_char_func() == -1` is false.  int32 IS
	// the full ILP32 word, so only 1/2-byte returns need this.
	var retSz int = 0
	if ins.Typ != nil { retSz = ins.Typ.SizeOf() }
	if retSz == 1 || retSz == 2 {
		var u @types.Type = common.UnwrapNamed(ins.Typ)
		var signed bool = u != nil && u.Signed
		emitWidthExtend(a, arm32.R0, arm32.R0, retSz * 8, signed)
	}
	emitFrameStore(a, arm32.R0, spillOff)
}

// collectMultiReturnFields spills an IN-REGISTER multi-return tuple (gpWords <=
// NumGpRetRegs = 4) from its AAPCS32 return registers r0..r3 into ins's stack
// slot at spillOff, by the per-field register-class convention LLVM lowers a
// tuple by: each field's words come from consecutive GP return registers
// (soft-float folds float fields into GP — there is no FP file, so a single
// retGp counter, unlike aarch64's retGp/retFp split), placed at the field's true
// tuple FieldOffset with sized sub-word stores.  Delegates to the shared
// storeMultiReturnTupleFieldsArm32 (base = SP, baseOff = the spill slot, scratch
// = IP for large frame offsets) so the direct / func-value (and, later, iface)
// caller collects share ONE implementation with the func-value SHIM store — they
// cannot drift.  Mirrors aarch64_call.bn's collectMultiReturnFields.
func collectMultiReturnFields(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr, spillOff int) {
	storeMultiReturnTupleFieldsArm32(a, ins.Typ, arm32.SP, spillOff, rm.CC.NumGpRetRegs, wordBytes(),
			arm32.IP)
}

// storeMultiReturnTupleFieldsArm32 is the field-per-register-by-class store loop
// shared by collectMultiReturnFields (the RegMap-driven caller collect: base = SP,
// baseOff = the result spill offset) and the func-value SHIM store-through-retbuf
// path (base = the retbuf register, baseOff = 0).  A single implementation so the
// caller collect and the shim store provably agree (they cannot drift).  It
// reproduces the AAPCS32 per-field convention: soft-float folds float fields into
// GP (no FP file, so a single retGp counter, unlike aarch64's retGp/retFp split),
// so each field's words come from consecutive return regs r0..r3 and land at
// base + baseOff + FieldOffset(fi) — an aggregate field strides its words by
// wByte; a sub-word scalar stores SIZED so it doesn't clobber a neighbor in the
// same word cell.  numGpRetRegs is the GP return-register budget (AAPCS32: 4) =
// the sret threshold, so the retGp guard never drops a live field (an over-budget
// tuple was routed to sret).  `scratch` materializes a large base+off (only the
// collect side reaches a large frame offset; a tuple's own field offsets always
// fit); it must not alias a return reg or `base`.  A MANAGED field rides the
// non-float GP path as a plain pointer-word store (ownership transfers from the
// return reg into the slot; no RefInc/RefDec).  An int64 / uint64 field rides a
// CONSECUTIVE return-register pair (no even-pair bump — the small-aggregate return
// coercion packs fields into r0..r3 in field order; C.3's even rule is
// argument-only): lo/hi are stored at fldOff / +4 and retGp advances by 2.  A
// soft-float float64 field rides the SAME consecutive return-register pair
// (isPair64Typ) as an int64 — the identical two-word lo/hi store.
func storeMultiReturnTupleFieldsArm32(a @asm.Assembler, tupleTyp @types.Type, base int, baseOff int,
		numGpRetRegs int, wByte int, scratch int) {
	var retGp int = 0
	for fi := 0; fi < len(tupleTyp.Fields); fi++ {
		var fldTyp @types.Type = tupleTyp.Fields[fi].Type
		var fldOff int = baseOff + tupleTyp.FieldOffset(fi)
		if common.IsAggregateTyp(fldTyp) {
			// A 0-byte aggregate field (`struct{}` / `[0]T`) occupies NO return
			// register and carries no bytes — LLVM's first-class `{...}` struct
			// return places nothing for it (matching x64's storeMultiReturnTupleFields_x64,
			// whose `w*8 < fldSz` loop is empty for a 0-byte field).  argWordsArm32
			// reports 0 words for it, so the loop below stores nothing and does NOT
			// consume a retGp slot; storing a junk word here would shift every later
			// field's register by one — desyncing this store from the callee return
			// lowering (emitMultiReturnPack, same skip) and from the LLVM shim.
			var nWords int = argWordsArm32(fldTyp, wByte)
			var fldSz int = fldTyp.SizeOf()
			if fldSz > 0 && fldOff % wByte != 0 {
				// An aggregate field at a NON-word-aligned tuple offset — a sub-word
				// aggregate (align < wByte, e.g. a 3-byte `struct{3×int8}`) preceded by a
				// sub-word scalar, so it lands at an odd byte (the trailing field of
				// `(int8, Tri)`).  A full-word STR at an odd address FAULTS on strict-align
				// bare-metal; store the field's exact bytes byte-wise instead.
				retGp = retGp +
						storeAggFieldBytewiseArm32(a, base, fldOff, retGp, fldSz, numGpRetRegs, wByte, scratch)
			} else {
				for wi := 0; wi < nWords && retGp < numGpRetRegs; wi++ {
					emitBaseStore(a, argReg(retGp), base, fldOff + wByte * wi, scratch)
					retGp = retGp + 1
				}
			}
		} else if isPair64Typ(fldTyp) {
			// An int64 / uint64 / float64 field returns as a CONSECUTIVE register pair
			// — NO even-register bump.  AAPCS §6.5 C.3's even-pair rule governs ARGUMENT
			// passing; the small-aggregate RETURN, which LLVM lowers by coercing the
			// tuple to consecutive r0..r3 words in field order, does NOT 8-align a
			// 64-bit field's register (verified against the LLVM sibling: for
			// {int32, int64} the int64 comes back in r1:r2, not r2:r3).  So the pair
			// is argReg(retGp):argReg(retGp+1) — lo/hi stored at [base+fldOff] / [+4]
			// (fldOff keeps the tuple's 8-aligned FieldOffset for the memory layout,
			// independent of the register cursor).  A soft-float float64 field is the
			// same two-word copy as an int64.  Advancing retGp by 2 keeps later fields
			// in lockstep with the LLVM coercion.
			if retGp + 1 < numGpRetRegs {
				emitBaseStore(a, argReg(retGp), base, fldOff, scratch)
				emitBaseStore(a, argReg(retGp + 1), base, fldOff + 4, scratch)
				retGp = retGp + 2
			}
		} else {
			if retGp < numGpRetRegs {
				var fldSz int = fldTyp.SizeOf()
				if fldSz <= 0 { fldSz = wByte }
				emitBaseScalarStore(a, argReg(retGp), base, fldOff, fldSz, scratch)
				retGp = retGp + 1
			}
		}
	}
}

// storeAggFieldBytewiseArm32 stores a `fldSz`-byte aggregate FIELD byte-wise at
// base+fldOff, pulling its bytes from consecutive return registers starting at retGp.
// Used by storeMultiReturnTupleFieldsArm32 for an aggregate field at a NON-word-aligned
// tuple offset (a sub-word aggregate like a 3-byte struct at an odd byte), where a
// full-word STR would fault on strict-align bare-metal.  `scratch` (distinct from base
// and every return reg) holds the field base address base+fldOff once, so each byte STRB
// uses a small [scratch, #k] immediate; each return register is dead after its field, so
// the low byte is stored then the register is shifted right 8 in place for the next byte.
// Returns the number of return registers consumed (ceil(fldSz/wByte)), capped at the GP
// return budget so it stays in lockstep with the pack + LLVM coercion.
func storeAggFieldBytewiseArm32(a @asm.Assembler, base int, fldOff int, retGp int, fldSz int,
		numGpRetRegs int, wByte int, scratch int) int {
	emitConstInt32(a, scratch, fldOff)
	arm32.Add(a, arm32.COND_AL, false, scratch, base, arm32.Reg(scratch))
	var nWords int = (fldSz + wByte - 1) / wByte
	var bi int = 0
	var used int = 0
	for wi := 0; wi < nWords && retGp + wi < numGpRetRegs; wi++ {
		var reg int = argReg(retGp + wi)
		var nb int = wByte
		if fldSz - bi < nb {
			nb = fldSz - bi
		}
		for bj := 0; bj < nb; bj++ {
			arm32.Strb(a, arm32.COND_AL, reg, arm32.MemImm(scratch, bi))
			if bj + 1 < nb {
				arm32.Mov(a, arm32.COND_AL, false, reg, arm32.RegShift(reg, arm32.LSR, 8))
			}
			bi = bi + 1
		}
		used = used + 1
	}
	return used
}

// argWordsArm32 is the AAPCS32 (wByte-word) argument word count without needing a
// CallConv — ceil(SizeOf / wByte).  storeMultiReturnTupleFieldsArm32 uses it in the
// shim (no RegMap → no cc.ArgWords).  A zero-size aggregate reports 0 words (no
// bytes → no register/stack, matching common.argWords and LLVM); it must NOT be
// clamped to 1 (see common.argWords / conformance 1029).
func argWordsArm32(t @types.Type, wByte int) int {
	if t == nil { return 1 }
	var sz int = t.SizeOf()
	return (sz + wByte - 1) / wByte
}

// isReg64Scalar reports whether t is a 64-bit fundamental integer scalar
// (int64 / uint64) — a value that AAPCS32 passes / returns in a register PAIR.
// Slices and other aggregates are NOT this (they are handled by the aggregate
// paths); a nil or sub-64-bit type is not this either.  Peels ALL transparent
// wrappers (types.StripWrappers: alias / readonly / named), because a
// `readonly int64` / a `type Id int64` has the identical register-pair value
// shape — and MUST classify the same way the ABI / shim classifiers do (which
// peel transparent), or a wrapped 64-bit arg is mis-placed as a single word.
func isReg64Scalar(t @types.Type) bool {
	if t == nil { return false }
	var u @types.Type = types.StripWrappers(t)
	if u == nil { return false }
	if u.Kind != types.TYP_INT { return false }
	return u.Width == 64
}
