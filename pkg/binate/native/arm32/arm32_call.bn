package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Direct function call lowering
// ============================================================
//
// emitCall handles OP_CALL / OP_C_CALL — a known callee resolved by name and
// reached via `BL <symbol>`.  It supports scalar / pointer args (R0..R3, then
// stack) and aggregate args that fit AAPCS32's ≤16-byte-in-regs / split rules
// (a raw slice is 8 bytes = 2 words, a managed-slice is 16 bytes = 4 words),
// plus a single scalar / pointer return and a BIG single-aggregate return
// (SizeOf > InternalSretBytes = 4) via AAPCS32 sret.  Shapes still outside the
// increment's scope — a float arg/return (soft-float is a later increment), a
// 64-bit-pair scalar arg, and a SMALL (SizeOf <= 4) aggregate return that comes
// back by value in R0 (its in-register collection isn't implemented) — fail
// LOUDLY via a.SetError rather than being silently dropped / mis-registered.
// Mirrors aarch64_call.bn adapted to the AAPCS32 register model (WordBytes 4).

// emitCall dispatches args per AAPCS32, sets up the sret pointer if the callee
// returns a big aggregate, branches to the callee, then collects the return
// value.  ins.StrVal is the Binate call name (mangled via symFor) for OP_CALL,
// or a verbatim C symbol for OP_C_CALL.
func emitCall(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
	allFuncs @[]@ir.Func, ins @ir.Instr) {
	// A multi-return call collects its result tuple from the return registers
	// (or, for a big tuple, an sret buffer) — neither of those shapes is
	// implemented yet, so reject it BEFORE placing any args (which would go in
	// R0..) so no half-marshaled call is emitted.  This guard fires ahead of
	// the single-aggregate-sret path below, which handles only a single-value
	// aggregate return.
	if ins.ID >= 0 && common.IsMultiReturnCall(ins) {
		a.SetError("native arm32: multi-return call collection not "
			"implemented (P4)")
		return
	}

	// AAPCS32 sret: a call returning a single aggregate larger than
	// InternalSretBytes (4) — on ILP32 that is EVERY slice / struct — passes a
	// hidden buffer pointer in R0 (the first GP arg register), shifting every
	// user arg up by one register.  Model the shift by synthesising a
	// pointer-typed leading entry in argTypes, so CallArgRegStart places user
	// arg i at register slot i+1 (matching x64_call.bn's RDI-shift).  A
	// C-extern callee whose >CExternSretBytes aggregate return uses the same
	// hidden-pointer sret is covered by CalleeUsesCSret.
	var bigRet bool = ins.ID >= 0 &&
		(rm.CC.CallReturnsBigAggregate(ins) ||
		 rm.CC.CalleeUsesCSret(allFuncs, ins))

	var nDispatchArgs int = len(ins.Args)
	if bigRet { nDispatchArgs = nDispatchArgs + 1 }
	var argTypes @[]@types.Type = make_slice(@types.Type, nDispatchArgs)
	if bigRet {
		// First slot is the hidden sret-buffer pointer — a single word that
		// consumes R0.  Going through the classifier (rather than hand-adding 1
		// to a raw reg index) keeps the ILP32 even-align pad correct: after the
		// 1-word prepend ngrn=1 is odd, so a following int64 pads to R2:R3.
		argTypes[0] = types.TypInt()
		for i := 0; i < len(ins.Args); i++ {
			argTypes[i+1] = ins.Args[i].Typ
		}
	} else {
		for i := 0; i < len(ins.Args); i++ {
			argTypes[i] = ins.Args[i].Typ
		}
	}

	for ai := 0; ai < len(ins.Args); ai++ {
		// User arg ai lives at dispatch slot ai (no sret) or ai+1 (sret — the
		// synthesised pointer takes slot 0).
		var dispatchIdx int = ai
		if bigRet { dispatchIdx = ai + 1 }
		emitCallArg(a, pkgName, rm, argTypes, ins.Args[ai], dispatchIdx)
		if a.HasError { return }
		// Each arg's scratch reg is dead once consumed into argReg / the stack
		// slot; reset so a long arg list doesn't saturate the pool.
		rm.ResetRegs()
	}

	// sret setup: materialize &returnBuffer into R0 AFTER placing args (which
	// occupy R1..) and while IP is free — emitFrameAddr uses IP as its address
	// scratch.  A single-aggregate return lands in the call result's own alloc
	// data region (LookupAlloc); the callee writes the bytes through R0.  This
	// is the R0 analogue of x64's `Lea RDI, [RSP + sretOff]`.
	if bigRet {
		var sretOff int = rm.LookupAlloc(ins.ID)
		if sretOff >= 0 {
			emitFrameAddr(a, arm32.R0, sretOff)
		}
	}

	// __c_call carries a verbatim C symbol (no Binate mangling); every other
	// call op goes through symFor.  Both are ELF-bare on arm32.
	var callee @[]char
	if ins.Op == iropcode.OP_C_CALL {
		callee = symPrefixed(ins.StrVal)
	} else {
		callee = symFor(pkgName, ins.StrVal)
	}
	a.SetGlobal(callee)
	arm32.Bl(a, arm32.COND_AL, callee)

	// BL clobbers R0-R3 and R12.  Reset the pool, then collect this call's
	// return value(s) so later uses can reload.
	rm.ResetRegs()
	emitCallReturn(a, rm, allFuncs, ins)
}

// emitCallArg marshals one argument into its AAPCS32 register(s) / stack slot.
// dispatchIdx is the arg's position in argTypes, which — for a big-aggregate-
// return call — carries a synthesised leading sret-pointer slot, so the user
// arg's dispatchIdx is one past its positional index.  A float arg (soft-float
// lowering is a later increment) and a 64-bit-pair scalar arg fail LOUDLY.  A
// scalar/pointer goes into argReg(regStart) or a stack slot; an aggregate (raw /
// managed slice) spreads its words across argReg(regStart..) and, on overflow,
// into the outgoing-args area.
func emitCallArg(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
	argTypes @[]@types.Type, arg @ir.Instr, dispatchIdx int) {
	if common.IsFloatScalarTyp(arg.Typ) {
		a.SetError("native arm32: call with float arg not implemented (P5)")
		return
	}
	var regStart int = rm.CC.CallArgRegStart(argTypes, dispatchIdx)
	var stackOff int = rm.CC.CallArgStackOff(argTypes, dispatchIdx)
	// A 64-bit scalar (int64 / uint64) is a register PAIR (even-aligned r0:r1 /
	// r2:r3) or an 8-byte stack slot — the CallConv walkers already give the low
	// reg / stack offset; place both words.
	if isReg64Scalar(arg.Typ) {
		var lo int
		var hi int
		lo, hi = load64(a, rm, arg)
		if lo < 0 {
			a.SetError("native arm32: 64-bit call arg not materializable (P3)")
			return
		}
		placeInt64Arg(a, lo, hi, regStart, stackOff)
		return
	}
	if common.IsAggregateTyp(arg.Typ) {
		emitAggregateArg(a, rm, arg, regStart, stackOff)
		return
	}
	var src int = emitValOperand(a, pkgName, rm, arg)
	if src < 0 {
		a.SetError("native arm32: call arg operand not materializable (P3/P4)")
		return
	}
	if regStart >= 0 {
		if src != argReg(regStart) {
			arm32.Mov(a, arm32.COND_AL, false, argReg(regStart),
				arm32.Reg(src))
		}
	} else if stackOff >= 0 {
		arm32.Str(a, arm32.COND_AL, src, arm32.MemImm(arm32.SP, stackOff))
	}
}

// emitAggregateArg spreads an aggregate arg's words across its AAPCS32 arg
// registers and stack overflow.  The value already lives contiguously in a
// data region (getOperand returns a pointer to it); we load word w to
// argReg(regStart+w) for the in-reg words and copy the rest into the outgoing-
// args area.  AAPCS32 (SplitAggregates) allows straddling the R0..R3 boundary.
// An indirect-large aggregate (> AggregateInRegMax) is passed as a single
// pointer word instead.  Mirrors aarch64_call.bn's aggregate arm with word=4
// and R12 (IP) as the stack-copy temp.
func emitAggregateArg(a @asm.Assembler, rm @common.RegMap, arg @ir.Instr,
	regStart int, stackOff int) {
	var ptr int = getOperand(a, rm, arg.ID)
	if ptr < 0 {
		a.SetError("native arm32: aggregate call arg not materializable (P3)")
		return
	}
	if rm.CC.IndirectLargeAggregates &&
			arg.Typ.SizeOf() > rm.CC.AggregateInRegMax {
		if regStart >= 0 {
			if ptr != argReg(regStart) {
				arm32.Mov(a, arm32.COND_AL, false, argReg(regStart),
					arm32.Reg(ptr))
			}
		} else if stackOff >= 0 {
			arm32.Str(a, arm32.COND_AL, ptr, arm32.MemImm(arm32.SP, stackOff))
		}
		return
	}
	var w int = wordBytes()
	var nWords int = rm.CC.ArgWords(arg.Typ)
	var regWords int = 0
	if regStart >= 0 {
		regWords = nWords
		if stackOff >= 0 { regWords = rm.CC.NumGpArgRegs - regStart }
		for wi := 0; wi < regWords; wi++ {
			arm32.Ldr(a, arm32.COND_AL, argReg(regStart + wi),
				arm32.MemImm(ptr, w * wi))
		}
	}
	if stackOff >= 0 {
		for wi := regWords; wi < nWords; wi++ {
			arm32.Ldr(a, arm32.COND_AL, arm32.IP, arm32.MemImm(ptr, w * wi))
			arm32.Str(a, arm32.COND_AL, arm32.IP,
				arm32.MemImm(arm32.SP, stackOff + w * (wi - regWords)))
		}
	}
}

// emitCallReturn collects the call's result after the BL.  A multi-return
// result was already rejected (fail-loud) up front in emitCall.  A BIG single
// aggregate return (SizeOf > InternalSretBytes = 4 — every slice, most structs)
// arrived via AAPCS32 sret: the callee wrote its bytes through the R0 buffer
// pointer directly into the call result's alloc data region, so there is no
// post-call byte copy — the data region IS the result; LEA a pointer to it into
// the result register (matching x64's `Lea rd, [RSP + dataOff]`) so downstream
// consumers see a pointer to the bytes.  A SMALL aggregate (SizeOf <= 4) is NOT
// sret — AAPCS32 returns it by value in R0 — so its in-register collection is a
// different shape, not implemented yet, and fails LOUDLY (LEAing the buffer
// would hand downstream a pointer to an UNWRITTEN data region).  Otherwise the
// result is a scalar / pointer; a float return fails LOUDLY, a 64-bit-pair
// scalar returns in r0:r1, and every other scalar returns in R0 and spills to
// the result's slot.
func emitCallReturn(a @asm.Assembler, rm @common.RegMap, allFuncs @[]@ir.Func,
	ins @ir.Instr) {
	if ins.ID < 0 { return }
	if common.IsFloatScalarTyp(ins.Typ) {
		a.SetError("native arm32: call with float return not implemented (P5)")
		return
	}
	if ins.Typ != nil && common.IsAggregateTyp(ins.Typ) {
		// A big aggregate came back via AAPCS32 sret (the callee wrote through
		// the R0 buffer into the call result's alloc data region); LEA the
		// data-region pointer into the result reg.  A small (<=4-byte) aggregate
		// is returned by value in R0 instead — collecting that into the data
		// region isn't implemented, so fail LOUDLY rather than LEA an unwritten
		// region (the callee likewise fails loud; see arm32_return.bn / P4).
		var bigRet bool = rm.CC.CallReturnsBigAggregate(ins) ||
			rm.CC.CalleeUsesCSret(allFuncs, ins)
		if !bigRet {
			a.SetError("native arm32: small (<=4-byte) in-register aggregate "
				"call return not implemented (P4)")
			return
		}
		var dataOff int = rm.LookupAlloc(ins.ID)
		if dataOff < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		emitFrameAddr(a, rd, dataOff)
		return
	}
	var spillOff int = rm.LookupSpill(ins.ID)
	if spillOff < 0 { return }
	// A 64-bit scalar return comes back in r0:r1; store both words to the slot.
	if isReg64Scalar(ins.Typ) {
		emitFrameStore(a, arm32.R0, spillOff)
		emitFrameStore(a, arm32.R1, spillOff + 4)
		return
	}
	emitFrameStore(a, arm32.R0, spillOff)
}

// isReg64Scalar reports whether t is a 64-bit fundamental integer scalar
// (int64 / uint64) — a value that AAPCS32 passes / returns in a register PAIR,
// which this increment DEFERS (a known ABI subtlety).  Slices and other
// aggregates are NOT this (they are handled by the aggregate paths); a nil or
// sub-64-bit type is not this either.
func isReg64Scalar(t @types.Type) bool {
	if t == nil { return false }
	var u @types.Type = common.UnwrapNamed(t)
	if u == nil { return false }
	if u.Kind != types.TYP_INT { return false }
	return u.Width == 64
}
