package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the hard-float (AAPCS-VFP) DIRECT-CALL / RETURN / PARAM movement
// (arm32_call_hard.bn).  Each test STAMPS an arm32 hard-float target (via the
// shared stampHard, arm32_float_hard_test.bn) BEFORE building the RegMap — the
// CallConv captures VfpBackfill / NumFpArgRegs off types.Arm32HardFloat() at
// construction — emits, then RESTORES the prior target before asserting.  The
// assertions pin the CONCRETE VFP register each float lands in (float args cross
// via VMOV, an FP-register return/param VSTRs to its slot), the float64 PEEL off
// the r-pair path onto a single D register, the AAPCS-VFP back-fill at the call
// site, the >1020-offset address materialization, the multi-return float-field
// placement (pinned against clang -target arm-linux-gnueabihf -mfloat-abi=hard),
// and a soft-target negative control.  Reused helpers (stampHard / restoreTarget /
// containsWord / mkAsm / fail / appendInstrPtr_arm32calltest) live in the
// float-hard / ops / call test files.

// hardRm builds a RegMap on the hard-float AAPCS32 CallConv — MUST be called after
// stampHard so AAPCS32() reads types.Arm32HardFloat() == true and sets VfpBackfill.
func hardRm() @common.RegMap {
	return common.NewRegMap(common.AAPCS32())
}

// addSpill records a spill slot (id -> byte offset) on rm.
func addSpill(rm @common.RegMap, id int, off int) {
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, id)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, off)
}

// floatArg builds a float scalar arg instruction with SSA id and type.
func floatArg(id int, typ @types.Type) @ir.Instr {
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = id
	ins.Typ = typ
	return ins
}

// voidCall builds a void OP_CALL to main.f carrying args.
func voidCall(args @[]@ir.Instr) @ir.Instr {
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.f"
	ins.Args = args
	ins.Typ = types.TypVoid()
	return ins
}

// ============================================================
// Call ARG placement (Site A)
// ============================================================

// A hard-float float32 arg crosses its GP value word into its CallArgFpReg
// single-precision register (S0 for the sole arg) via VMOV — not a GP Mov to R0.
func TestHardCallFloat32ArgVmovToS0() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = hardRm()
	addSpill(rm, 5, 0)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, floatArg(5, types.TypFloat32()))
	emitCall(a, "main", rm, voidCall(args))
	var hadErr bool = a.HasError
	restoreTarget(oldArch, oldAbi)
	if hadErr { return fail("hard float32 arg must not error") }
	// src is R4 (first pool reg after getOperand reloads the spilled arg).
	var ref @asm.Assembler = mkAsm()
	arm32.VmovCoreToSingle(ref, arm32.COND_AL, arm32.S0, arm32.R4)
	if !containsWord(a, word32(ref, 0)) {
		return fail("hard float32 arg must VMOV its GP word into S0")
	}
	return ""
}

// A hard-float float64 arg is PEELED off the int64 r-pair path onto a single D
// register: its lo/hi words VMOV into D0 (VmovCoresToDouble), not an r0:r1 pair.
func TestHardCallFloat64ArgVmovToD0() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = hardRm()
	addSpill(rm, 5, 0)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, floatArg(5, types.TypFloat64()))
	emitCall(a, "main", rm, voidCall(args))
	var hadErr bool = a.HasError
	restoreTarget(oldArch, oldAbi)
	if hadErr { return fail("hard float64 arg must not error") }
	var ref @asm.Assembler = mkAsm()
	arm32.VmovCoresToDouble(ref, arm32.COND_AL, arm32.D0, arm32.R4, arm32.R5)
	if !containsWord(a, word32(ref, 0)) {
		return fail("hard float64 arg must VMOV its lo/hi words into a single D register (D0)")
	}
	return ""
}

// The AAPCS-VFP back-fill worked example at the CALL SITE: args (d, f, d, f) land
// in D0, S2, D2, S3 — the second float32 back-fills the hole the first float64's
// even-alignment left, which a naive +2/+1 cursor would miss.
func TestHardCallVfpBackfillDFDF() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = hardRm()
	addSpill(rm, 10, 0)
	addSpill(rm, 11, 8)
	addSpill(rm, 12, 16)
	addSpill(rm, 13, 24)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, floatArg(10, types.TypFloat64()))
	args = appendInstrPtr_arm32calltest(args, floatArg(11, types.TypFloat32()))
	args = appendInstrPtr_arm32calltest(args, floatArg(12, types.TypFloat64()))
	args = appendInstrPtr_arm32calltest(args, floatArg(13, types.TypFloat32()))
	emitCall(a, "main", rm, voidCall(args))
	var hadErr bool = a.HasError
	restoreTarget(oldArch, oldAbi)
	if hadErr { return fail("backfill call must not error") }
	// Each arg resets the pool, so every value reloads into R4 (a float64 into R4:R5).
	if !containsWord(a, vmovD(arm32.D0)) { return fail("arg0 (d) must land in D0") }
	if !containsWord(a, vmovS(arm32.S2)) { return fail("arg1 (f) must land in S2") }
	if !containsWord(a, vmovD(arm32.D2)) { return fail("arg2 (d) must land in D2") }
	if !containsWord(a, vmovS(arm32.S3)) { return fail("arg3 (f) must back-fill S3") }
	return ""
}

// vmovS builds the VmovCoreToSingle(S<reg>, R4) word — a float32 arg/field VMOV
// crossing its (reloaded-into-R4) GP word into single register `sReg`.
func vmovS(sReg int) uint32 {
	var ref @asm.Assembler = mkAsm()
	arm32.VmovCoreToSingle(ref, arm32.COND_AL, sReg, arm32.R4)
	return word32(ref, 0)
}

// vmovD builds the VmovCoresToDouble(D<reg>, R4, R5) word — a float64 arg/field
// VMOV crossing its (reloaded-into-R4:R5) GP pair into double register `dReg`.
func vmovD(dReg int) uint32 {
	var ref @asm.Assembler = mkAsm()
	arm32.VmovCoresToDouble(ref, arm32.COND_AL, dReg, arm32.R4, arm32.R5)
	return word32(ref, 0)
}

// ============================================================
// Call RETURN collect (Site B)
// ============================================================

// A hard-float float64 return rides D0 and VSTRs directly to the result slot; a
// float32 return rides S0 (VSTR .32).
func TestHardCallFloatReturnVstr() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var a64 @asm.Assembler = mkAsm()
	var rm64x @common.RegMap = hardRm()
	addSpill(rm64x, 0, 0)
	emitCall(a64, "main", rm64x, retCall(types.TypFloat64()))
	var a32 @asm.Assembler = mkAsm()
	var rm32x @common.RegMap = hardRm()
	addSpill(rm32x, 0, 0)
	emitCall(a32, "main", rm32x, retCall(types.TypFloat32()))
	var err bool = a64.HasError || a32.HasError
	restoreTarget(oldArch, oldAbi)
	if err { return fail("hard float return must not error") }
	var r64 @asm.Assembler = mkAsm()
	arm32.Vstr64(r64, arm32.COND_AL, arm32.D0, arm32.SP, 0)
	if !containsWord(a64, word32(r64, 0)) {
		return fail("hard float64 return must VSTR D0 to the result slot")
	}
	var r32 @asm.Assembler = mkAsm()
	arm32.Vstr32(r32, arm32.COND_AL, arm32.S0, arm32.SP, 0)
	if !containsWord(a32, word32(r32, 0)) {
		return fail("hard float32 return must VSTR S0 to the result slot")
	}
	return ""
}

// retCall builds a scalar-returning OP_CALL (result id 0) of type typ.
func retCall(typ @types.Type) @ir.Instr {
	var noArgs @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.f"
	ins.Args = noArgs
	ins.Typ = typ
	return ins
}

// ============================================================
// PARAM spill (Site D)
// ============================================================

// A hard-float float64 param arrives in D0 and VSTRs to its frame slot; a float32
// param arrives in S0 (VSTR .32).
func TestHardSpillFloatParamVstr() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var a64 @asm.Assembler = mkAsm()
	var rm64x @common.RegMap = hardRm()
	addSpill(rm64x, 7, 0)
	var p64 @ir.Param = floatParam(7, types.TypFloat64())
	emitSpillParam(a64, rm64x, p64, oneTypeSlice(types.TypFloat64()), 0, 0, false)
	var a32 @asm.Assembler = mkAsm()
	var rm32x @common.RegMap = hardRm()
	addSpill(rm32x, 7, 0)
	var p32 @ir.Param = floatParam(7, types.TypFloat32())
	emitSpillParam(a32, rm32x, p32, oneTypeSlice(types.TypFloat32()), 0, 0, false)
	var err bool = a64.HasError || a32.HasError
	restoreTarget(oldArch, oldAbi)
	if err { return fail("hard float param spill must not error") }
	var r64 @asm.Assembler = mkAsm()
	arm32.Vstr64(r64, arm32.COND_AL, arm32.D0, arm32.SP, 0)
	if !containsWord(a64, word32(r64, 0)) {
		return fail("hard float64 param must VSTR D0 to its frame slot")
	}
	var r32 @asm.Assembler = mkAsm()
	arm32.Vstr32(r32, arm32.COND_AL, arm32.S0, arm32.SP, 0)
	if !containsWord(a32, word32(r32, 0)) {
		return fail("hard float32 param must VSTR S0 to its frame slot")
	}
	return ""
}

// floatParam builds a float scalar ir.Param with id and type.
func floatParam(id int, typ @types.Type) @ir.Param {
	var p @ir.Param = make(ir.Param)
	p.ID = id
	p.Typ = typ
	return p
}

// oneTypeSlice builds a one-element @[]@types.Type (a param/arg type list).
func oneTypeSlice(t @types.Type) @[]@types.Type {
	var ts @[]@types.Type = make_slice(@types.Type, 1)
	ts[0] = t
	return ts
}

// ============================================================
// >1020 offset — address materialization
// ============================================================

// A float64 param whose frame slot exceeds VLDR/VSTR's ±1020 reach materializes
// the slot address in IP and stores [IP, #0] — the direct-offset VSTR (which
// would fault vfpOffset's range check) must NOT be emitted.
func TestHardSpillFloatParamLargeOffset() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = hardRm()
	addSpill(rm, 7, 2048)
	emitSpillParam(a, rm, floatParam(7, types.TypFloat64()), oneTypeSlice(types.TypFloat64()), 0, 0,
			false)
	var hadErr bool = a.HasError
	restoreTarget(oldArch, oldAbi)
	if hadErr { return fail("large-offset float param spill must not error") }
	var ref @asm.Assembler = mkAsm()
	arm32.Vstr64(ref, arm32.COND_AL, arm32.D0, arm32.IP, 0)
	if !containsWord(a, word32(ref, 0)) {
		return fail("a >1020 slot offset must materialize the address in IP and VSTR [IP, #0]")
	}
	return ""
}

// ============================================================
// MULTI-RETURN float tuple placement (pinned against clang)
// ============================================================

// Packing a {float32, float64} tuple return places field0 in S0 and field1 in D1
// — the float64 BACK-FILLS to the even pair (s2,s3 = D1) past the float32's s0,
// exactly clang -mfloat-abi=hard's literal-FCA return lowering (a naive cursor
// would wrongly use D0).
func TestHardMultiReturnPackF32F64() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = hardRm()
	addSpill(rm, 10, 0)
	addSpill(rm, 11, 8)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, floatArg(10, types.TypFloat32()))
	args = appendInstrPtr_arm32calltest(args, floatArg(11, types.TypFloat64()))
	var ins @ir.Instr = make(ir.Instr)
	ins.Args = args
	emitMultiReturnPack(a, "main", rm, ins)
	var hadErr bool = a.HasError
	restoreTarget(oldArch, oldAbi)
	if hadErr { return fail("hard multi-return pack must not error") }
	if !containsWord(a, vmovS(arm32.S0)) { return fail("tuple field0 (f32) must pack into S0") }
	if !containsWord(a, vmovD(arm32.D1)) {
		return fail("tuple field1 (f64) must BACK-FILL into D1, not D0")
	}
	return ""
}

// Collecting a {float64, float32} tuple return (from a CALL) VSTRs field0 from D0
// and field1 from S2 into the result slot at each field's tuple offset — the
// float32 takes the next free single past the float64's D0 (s0,s1).
func TestHardMultiReturnCollectF64F32() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = hardRm()
	addSpill(rm, 0, 0)
	emitCall(a, "main", rm, multiRetCall(types.TypFloat64(), types.TypFloat32()))
	var hadErr bool = a.HasError
	restoreTarget(oldArch, oldAbi)
	if hadErr { return fail("hard multi-return collect must not error") }
	// field0 float64 at tuple offset 0 -> VSTR D0 [SP, #0]; field1 float32 at
	// offset 8 -> VSTR S2 [SP, #8].
	var r0 @asm.Assembler = mkAsm()
	arm32.Vstr64(r0, arm32.COND_AL, arm32.D0, arm32.SP, 0)
	if !containsWord(a, word32(r0, 0)) { return fail("field0 (f64) must VSTR D0 at slot+0") }
	var r1 @asm.Assembler = mkAsm()
	arm32.Vstr32(r1, arm32.COND_AL, arm32.S2, arm32.SP, 8)
	if !containsWord(a, word32(r1, 0)) { return fail("field1 (f32) must VSTR S2 at slot+8") }
	return ""
}

// multiRetCall builds an OP_CALL returning a 2-field tuple (t0, t1) with result
// id 0, so emitCallReturn drives collectMultiReturnFields.  The tuple is a NAMELESS
// TYP_STRUCT (MakeStructType ""), which IsMultiReturnCall recognizes.
func multiRetCall(t0 @types.Type, t1 @types.Type) @ir.Instr {
	var f @[]@types.Field = make_slice(@types.Field, 2)
	f[0] = make(types.Field)
	f[0].Type = t0
	f[1] = make(types.Field)
	f[1].Type = t1
	var tuple @types.Type = types.MakeStructType("", f)
	var noArgs @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.f"
	ins.Args = noArgs
	ins.Typ = tuple
	return ins
}

// ============================================================
// SHIM store-through-retbuf dispatcher (inc 3f b3)
// ============================================================

// mkTuple2 builds a nameless 2-field tuple type (t0, t1) — the multi-return tuple the
// shim store-through-retbuf writes field-by-class.
func mkTuple2(t0 @types.Type, t1 @types.Type) @types.Type {
	var f @[]@types.Field = make_slice(@types.Field, 2)
	f[0] = make(types.Field)
	f[0].Type = t0
	f[1] = make(types.Field)
	f[1].Type = t1
	return types.MakeStructType("", f)
}

// The shim store dispatcher, under hard-float, VSTRs a {float64, float32} tuple's float
// fields from their VFP return registers THROUGH the retbuf register (R4, baseOff 0):
// field0 (f64) from D0 at [R4, #0], field1 (f32) from S2 (the next single past D0=s0,s1)
// at tuple offset 8 — the same CPRC back-fill the caller collect uses, but based at the
// retbuf rather than SP.  This is the func-value / closure / spill shim store path (b3).
func TestStoreMultiRetShimHardVfpThroughRetbuf() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var cc common.CallConv = common.AAPCS32()
	var tuple @types.Type = mkTuple2(types.TypFloat64(), types.TypFloat32())
	var a @asm.Assembler = mkAsm()
	storeMultiReturnTupleFieldsShimArm32(a, cc, tuple, arm32.R4, 0, arm32.IP)
	var hadErr bool = a.HasError
	var r0 @asm.Assembler = mkAsm()
	arm32.Vstr64(r0, arm32.COND_AL, arm32.D0, arm32.R4, 0)
	var d0 bool = containsWord(a, word32(r0, 0))
	var r1 @asm.Assembler = mkAsm()
	arm32.Vstr32(r1, arm32.COND_AL, arm32.S2, arm32.R4, 8)
	var s2 bool = containsWord(a, word32(r1, 0))
	restoreTarget(oldArch, oldAbi)
	if hadErr { return fail("hard-float multiret shim store must not error") }
	if !d0 { return fail("field0 (f64) must VSTR D0 through retbuf R4 at offset 0") }
	if !s2 { return fail("field1 (f32) must VSTR S2 through retbuf R4 at offset 8") }
	return ""
}

// A FLOAT-FREE tuple takes the GP-only store even under hard-float (no float field to
// divert): the dispatcher's output must be byte-identical to the GP store directly.
func TestStoreMultiRetShimHardFloatFreeUsesGp() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var cc common.CallConv = common.AAPCS32()
	var tuple @types.Type = mkTuple2(types.TypInt(), types.TypInt())
	var got @asm.Assembler = mkAsm()
	storeMultiReturnTupleFieldsShimArm32(got, cc, tuple, arm32.R4, 0, arm32.IP)
	var ref @asm.Assembler = mkAsm()
	storeMultiReturnTupleFieldsArm32(ref, tuple, arm32.R4, 0, cc.NumGpRetRegs, cc.WordBytes, arm32.IP)
	var eq bool = asmTextEqMarshal(got, ref)
	restoreTarget(oldArch, oldAbi)
	if !eq {
		return fail("a float-free tuple must take the GP store even under hard-float")
	}
	return ""
}

// On a SOFT-float target the dispatcher forwards a float tuple to the GP-only store (no
// VFP) — byte-identical to the GP store directly.  Pins that b3 leaves soft-float
// unchanged (its guards are all gated on Arm32HardFloat()).
func TestStoreMultiRetShimSoftUsesGp() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	types.SetFloatABI(types.FLOAT_ABI_SOFT)
	var cc common.CallConv = common.AAPCS32()
	var tuple @types.Type = mkTuple2(types.TypFloat64(), types.TypFloat32())
	var got @asm.Assembler = mkAsm()
	storeMultiReturnTupleFieldsShimArm32(got, cc, tuple, arm32.R4, 0, arm32.IP)
	var ref @asm.Assembler = mkAsm()
	storeMultiReturnTupleFieldsArm32(ref, tuple, arm32.R4, 0, cc.NumGpRetRegs, cc.WordBytes, arm32.IP)
	var eq bool = asmTextEqMarshal(got, ref)
	restoreTarget(oldArch, oldAbi)
	if !eq {
		return fail("soft-float multiret store must be GP-only, byte-identical to the GP store")
	}
	return ""
}

// ============================================================
// Negative control — soft target GP path unchanged
// ============================================================

// With an arm32 SOFT target the call arg path is unchanged: a float32 arg rides
// the GP path (Mov into R0) and NO VFP VMOV is emitted; a float64 arg stays on the
// r-pair path (no VmovCoresToDouble).
func TestSoftCallFloatArgNoVfp() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	types.SetFloatABI(types.FLOAT_ABI_SOFT)
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	addSpill(rm, 5, 0)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, floatArg(5, types.TypFloat32()))
	emitCall(a, "main", rm, voidCall(args))
	var hadErr bool = a.HasError
	restoreTarget(oldArch, oldAbi)
	if hadErr { return fail("soft float32 arg must not error") }
	if containsWord(a, vmovS(arm32.S0)) {
		return fail("soft float32 arg must NOT emit a VFP VMOV to S0")
	}
	// The GP path moves the arg into R0.
	var ref @asm.Assembler = mkAsm()
	arm32.Mov(ref, arm32.COND_AL, false, arm32.R0, arm32.Reg(arm32.R4))
	if !containsWord(a, word32(ref, 0)) {
		return fail("soft float32 arg must ride the GP path (Mov into R0)")
	}
	return ""
}

// A VARIADIC float scalar (past the __c_call `...` boundary) must ride the GP
// core registers under AAPCS-VFP — a variadic double is passed by the base
// standard, in an even GP register pair, NOT a d-register.  For printf(fmt,
// (double)x): fmt (fixed pointer) takes r0, so the variadic double 8-aligns to
// the even pair r2:r3 — CallArgRegStartV reports low-reg index 2.  This is the
// VariadicFloatInGp path (inc 3c/3e); without it the double would classify as an
// in-VFP-reg float (regStart -1) and silently mis-pass.
func TestVariadicFloatArgRidesGpEvenPair() testing.TestResult {
	var oldT types.TargetInfo = stampArm32HardFull()
	var cc common.CallConv = common.AAPCS32()
	var argTypes @[]@types.Type = make_slice(@types.Type, 2)
	argTypes[0] = types.TypInt() // fmt pointer (fixed)
	argTypes[1] = types.TypFloat64() // the variadic double
	// fixedCount = 1: arg index 1 (the double) is variadic.
	var rs int = cc.CallArgRegStartV(argTypes, 1, 1)
	types.SetTarget(oldT)
	if rs != 2 {
		return fail("variadic float64 must ride the GP even pair r2:r3 (regStart index 2)")
	}
	return ""
}

// Negative control: the SAME float64, when FIXED (fixedCount covers it), keeps
// the hard-float VFP-register placement (regStart -1) — the GP routing is
// scoped to the variadic tail, not floats in general.
func TestFixedFloatArgKeepsVfp() testing.TestResult {
	var oldT types.TargetInfo = stampArm32HardFull()
	var cc common.CallConv = common.AAPCS32()
	var argTypes @[]@types.Type = make_slice(@types.Type, 2)
	argTypes[0] = types.TypInt()
	argTypes[1] = types.TypFloat64()
	// fixedCount = 2: arg index 1 is FIXED → rides VFP.
	var rs int = cc.CallArgRegStartV(argTypes, 1, 2)
	types.SetTarget(oldT)
	if rs != -1 {
		return fail("a FIXED float64 must ride a VFP register (regStart -1), not GP")
	}
	return ""
}

// End of the fix at the EMIT level: a VARIADIC float64 __c_call arg is loaded
// from its spill and placed in the GP even pair (r2:r3) via the ordinary
// int64-pair path — NOT peeled to a VFP register.  This is the first caller of
// load64 for a hard-float float64 (a FIXED hard float never reaches it — it is
// peeled to VFP first), so it also pins that load64's spill path materializes
// the value cleanly (no "not materializable" error).  printf(fmt, (double)x):
// fmt (fixed pointer) -> r0; the variadic double from spill -> r2:r3.
func TestVariadicFloatCallArgEmitsGpPair() testing.TestResult {
	var oldT types.TargetInfo = stampArm32HardFull()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = hardRm()
	addSpill(rm, 5, 0) // fmt pointer, spill slot 0
	addSpill(rm, 6, 8) // the double, spill slot 8
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, floatArg(5, types.TypInt())) // fmt (fixed)
	args = appendInstrPtr_arm32calltest(args, floatArg(6, types.TypFloat64())) // variadic double
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_C_CALL
	ins.StrVal = "printf"
	ins.CFixedArgs = 1
	ins.Args = args
	ins.Typ = types.TypInt()
	emitCall(a, "main", rm, ins)
	var hadErr bool = a.HasError
	types.SetTarget(oldT)
	if hadErr {
		return fail("variadic float64 __c_call arg must be materializable via load64's spill path")
	}
	// The pair lands in r2:r3 from load64's scratch regs (R4=lo, R5=hi, fresh
	// after the per-arg ResetRegs).  placeInt64Arg moves lo->R2, hi->R3.
	var refLo @asm.Assembler = mkAsm()
	arm32.Mov(refLo, arm32.COND_AL, false, arm32.R2, arm32.Reg(arm32.R4))
	if !containsWord(a, word32(refLo, 0)) {
		return fail("variadic float64 low word must move into R2 (GP even pair)")
	}
	var refHi @asm.Assembler = mkAsm()
	arm32.Mov(refHi, arm32.COND_AL, false, arm32.R3, arm32.Reg(arm32.R5))
	if !containsWord(a, word32(refHi, 0)) {
		return fail("variadic float64 high word must move into R3 (GP even pair)")
	}
	return ""
}

// A VARIADIC float32 arg must fail LOUDLY (not silently mis-pass): C promotes a
// variadic float to double, but the frontend does not yet apply that promotion,
// so the 4-byte float32 can't be placed as the callee's 8-byte double.  Until
// float32->float64 promotion is implemented, emitCallArg errors.
func TestVariadicFloat32CallArgFailsLoud() testing.TestResult {
	var oldT types.TargetInfo = stampArm32HardFull()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = hardRm()
	addSpill(rm, 5, 0)
	addSpill(rm, 6, 8)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, floatArg(5, types.TypInt())) // fmt (fixed)
	args = appendInstrPtr_arm32calltest(args, floatArg(6, types.TypFloat32())) // variadic float32
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_C_CALL
	ins.StrVal = "printf"
	ins.CFixedArgs = 1
	ins.Args = args
	ins.Typ = types.TypInt()
	emitCall(a, "main", rm, ins)
	var hadErr bool = a.HasError
	types.SetTarget(oldT)
	if !hadErr {
		return fail(
				"variadic float32 arg must fail loud (needs float->double promotion), not silently mis-pass")
	}
	return ""
}

// stampArm32HardFull pins the FULL ILP32 hard-float arm32 target — PointerSize /
// IntSize = 4, MaxAlign = 8, Arch = ARM32, FloatABI = HARD — and returns the
// prior target so the caller restores it with types.SetTarget(old).  Unlike
// stampHard (which sets only Arch + FloatABI, per SetArch's contract), this also
// sets PointerSize = 4, so NeedsEvenReg / word-count logic matches real arm32
// compilation regardless of the ambient host/lane target.  The variadic GP-pair
// tests need this: a variadic float64 lands in the even pair r2:r3 only when
// PointerSize == 4 (on the LP64 host default it would be a single word), so
// stampHard alone left those tests riding whatever PointerSize a prior test had
// stamped — order-dependent, and it diverged between the host and arm32-linux
// unit lanes.
func stampArm32HardFull() types.TargetInfo {
	var old types.TargetInfo = types.GetTarget()
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
	types.SetArch(types.ARCH_ARM32)
	types.SetFloatABI(types.FLOAT_ABI_HARD)
	return old
}
