package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Indirect-call lowering
// ============================================================
//
// emitCallIndirect (OP_CALL_INDIRECT — dtor / free_fn / cross-mode dispatch,
// reached via `BLX IP`) and emitCallFuncValue (OP_CALL_FUNC_VALUE /
// OP_CALL_HANDLE — call through a 2-word {vtable, data} function value's
// vtable.call, always-shim convention).  Both reuse the direct-call machinery
// (emitCallArg for AAPCS32 arg placement, emitCallReturn for return collection);
// only the callee-target load and the final `BLX IP` (vs `BL <symbol>`) differ.
//
// Unlike AArch64 — which holds the call target in the intra-call scratch X17
// across the whole arg loop — arm32's only intra-call scratch is IP (R12), which
// emitAggregateArg (arm32_call.bn) and emitFrameAddr both clobber.  So the target
// is NOT held live across the arg loop: it is reloaded from its operand's spill
// slot AFTER the args are placed and materialized into IP as the last step before
// `BLX` (this also covers a void call, which has no result slot to stash into).
// Mirrors x64_call_indirect.bn, which likewise cannot hold the target in a
// regPool register across the loop.

// callInstrHasFloatArm32 reports whether an indirect / func-value / iface CALL
// instruction moves a float across the boundary the GP-only lowering can't place
// under hard-float (AAPCS-VFP): any USER arg (Args[1..], since Args[0] is the
// call target / interface value) or the RETURN (ins.Typ) has a float leaf — a
// float scalar, or a float nested in an aggregate / multi-return tuple
// (typHasFloatLeafArm32 walks recursively).  On soft-float a float rides GP like
// its same-width integer, so callers consult this ONLY under Arm32HardFloat();
// re-adds (and broadens from float64-only to ANY float leaf, plus the return) the
// deferral guard the soft-float shim work dropped.
func callInstrHasFloatArm32(ins @ir.Instr) bool {
	for i := 1; i < len(ins.Args); i++ {
		if ins.Args[i] != nil && typHasFloatLeafArm32(ins.Args[i].Typ) { return true }
	}
	return typHasFloatLeafArm32(ins.Typ)
}

// emitCallIndirect lowers OP_CALL_INDIRECT.  Args[0] is the function pointer;
// Args[1..] are the call args, dispatched via the same AAPCS32 machinery emitCall
// uses (no sret prefix — matches callDispatchArgTypesAnyOp's OP_CALL_INDIRECT
// sizing).  The target is reloaded into IP after the arg loop, then `BLX IP`.
// A scalar / void / 64-bit-pair return is collected by emitCallReturn; an
// aggregate or multi-return (which OP_CALL_INDIRECT never carries — it is emitted
// only for dtors / free_fn / cross-mode trampolines) fails LOUDLY rather than
// mishandling silently.
func emitCallIndirect(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		allFuncs @[]@ir.Func, ins @ir.Instr) {
	if len(ins.Args) < 1 {
		a.SetError("native arm32: indirect call with no target (P4)")
		return
	}
	// Under hard-float a REGISTER-RESIDENT SCALAR float arg / return rides VFP, which
	// emitCallArg / emitCallReturn already place there (inc 3f(b1)).  The float shapes
	// still unhandled — a float nested in an aggregate arg, a float leaf in a multi-
	// return tuple result (inc 3f(b2)/(b3)), or a VFP-bank-spilled float arg — fail LOUD
	// rather than silently miscompile.  (An aggregate / multi-return RESULT of an
	// indirect call also fails loud just below, but this reports the float reason.)
	// Inert on soft-float.
	if types.Arm32HardFloat() && callInstrUnhandledFloatB1Arm32(rm.CC, ins) {
		a.SetError(
				"native arm32 hard-float: float-in-aggregate / multi-return / "
						"VFP-bank-spill through indirect call not yet "
						"implemented (inc 3f b2/b3)")
		return
	}
	// Reject shapes the return collection can't handle BEFORE placing any args,
	// so no half-marshaled call is emitted.  OP_CALL_INDIRECT never carries a
	// multi-return or aggregate return today; guard anyway (fail-loud, not
	// silent-wrong).
	if ins.ID >= 0 && common.IsMultiReturnCall(ins) {
		a.SetError("native arm32: multi-return indirect call collection not "
				"implemented (P4)")
		return
	}
	if ins.ID >= 0 && ins.Typ != nil && common.IsAggregateTyp(ins.Typ) {
		a.SetError("native arm32: indirect call with aggregate return not "
				"implemented (P4)")
		return
	}

	// AAPCS32 arg dispatch on the call args (Args[1..]).  emitCallArg handles the
	// scalar / pointer / aggregate / 64-bit-pair / float cases (a float scalar
	// rides the GP path directly — OP_CALL_INDIRECT calls its target with no shim).
	var nCallArgs int = len(ins.Args) - 1
	var argTypes @[]@types.Type = make_slice(@types.Type, nCallArgs)
	for i := 0; i < nCallArgs; i++ {
		argTypes[i] = ins.Args[i + 1].Typ
	}
	for ai := 0; ai < nCallArgs; ai++ {
		emitCallArg(a, pkgName, rm, argTypes, ins.Args[ai + 1], ai)
		if a.HasError { return }
		// Each arg's scratch reg is dead once consumed; reset so a long arg list
		// doesn't saturate the (tighter than aarch64) R4..R10 pool.
		rm.ResetRegs()
	}

	// Reload the function pointer into IP as the LAST step before the branch:
	// getOperand reloads from the operand's spill slot (valid across the arg
	// loop), and IP would have been clobbered by emitAggregateArg / emitFrameAddr
	// during dispatch.  Covers a void call (no result slot to stash into) too.
	var fnReg int = getOperand(a, rm, ins.Args[0].ID)
	if fnReg < 0 {
		a.SetError("native arm32: indirect call target not materializable (P4)")
		return
	}
	if fnReg != arm32.IP {
		arm32.Mov(a, arm32.COND_AL, false, arm32.IP, arm32.Reg(fnReg))
	}
	arm32.Blx(a, arm32.COND_AL, arm32.IP)

	// BLX clobbers R0-R3 and IP.  Reset the pool, then collect the return value.
	rm.ResetRegs()
	emitCallReturn(a, rm, allFuncs, ins)
}

// emitCallFuncValue lowers OP_CALL_FUNC_VALUE (and, via dispatch, OP_CALL_HANDLE:
// a handle and a constructed func value share the {vtable, data} layout).  The
// call goes through vtable.call — always the marshaling shim.  The shim shape
// depends on the return type:
//
//   Scalar / void / SMALL multi-return: shim `<ret>(*uint8 data, <args>)` — data
//   in R0, user args in R1.. (one synthetic prepended slot shifts AAPCS
//   register-start by one).  A scalar result rides back in R0 / r0:r1; a small
//   multi-return tuple comes back field-per-register in r0..r3 and is collected
//   into the spill slot (collectMultiReturnFields).
//
//   Single aggregate return (big OR small) / BIG multi-return: shim `void(*uint8
//   retbuf, *uint8 data, <args>)` — retbuf in R0, data in R1, user args in R2..
//   (two synthetic prepended slots).  After the call the retbuf region holds the
//   result (a single big return / big multi-return via the R0 sret buffer; a
//   small single aggregate via the pack shim's store-through-retbuf), so it is
//   produced as a region pointer / spill slot.
//
// User args follow the all-int shim ABI: a by-address aggregate — a coerced
// in-register array / named struct / source-level anon struct
// (common.AggCoercedInReg; a source-level anon struct is coerced, IR-gen names it
// `__anon_N`), a non-coerced small slice / iface-value / managed-slice / func-value
// (isByAddressAggArm32 branch 2), OR an indirect-large aggregate — all ride
// BY-ADDRESS as ONE pointer word (the shim re-expands / dereferences it), matching
// the LLVM-emitted shim of a cross-package func value (which declares every aggregate
// i8*).  A float scalar rides the GP path like its same-width integer twin
// (soft-float): a float32 in one GP word, a float64 in the 2-word even-aligned pair
// (isPair64Typ), so no float arg fails loud.  Mirrors x64_call_indirect.bn with
// WordBytes = 4 and IP as the call-target scratch.
func emitCallFuncValue(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		allFuncs @[]@ir.Func, ins @ir.Instr) {
	if len(ins.Args) < 1 {
		a.SetError("native arm32: func-value call with no target (P4)")
		return
	}
	// Under hard-float a REGISTER-RESIDENT SCALAR float user arg / return rides VFP,
	// which emitCallArg / emitCallReturn (via emitShimUserArgsArm32 /
	// collectShimReturnArm32) already place there (inc 3f(b1)) — the synthetic GP data/
	// retbuf prefix does not perturb VFP allocation.  The float shapes still unhandled —
	// a float nested in an aggregate arg/return, a float leaf in a multi-return tuple
	// (inc 3f(b2)/(b3)), or a VFP-bank-spilled float arg — fail LOUD rather than silently
	// miscompile.  Inert on soft-float.
	if types.Arm32HardFloat() && callInstrUnhandledFloatB1Arm32(rm.CC, ins) {
		a.SetError(
				"native arm32 hard-float: float-in-aggregate / multi-return / "
						"VFP-bank-spill through func-value call not yet "
						"implemented (inc 3f b2/b3)")
		return
	}
	// Both a big (>4-byte) and a small (<=4-byte) single aggregate return ride
	// the retbuf-in-R0 convention on the CONSUMER side: pass a retbuf in R0 and
	// read the result from the retbuf region post-call.  The SHIM differs by size
	// (a big return tail-branches through the R0 sret buffer; a small return's
	// pack shim stores the by-value R0 word through the retbuf), but the consumer
	// is identical.  Mirrors x64/aarch64, which also treat both aggregate sizes
	// uniformly here.
	// Classify the RESULT with types.IsAggregateReturnTyp — the single-source-of-
	// truth retbuf-vs-scalar predicate the LLVM shim (codegen isAggregateReturn),
	// the callee return lowering, and the VM cross-mode dispatch all agree on — NOT
	// the kind-only common.IsAggregateTyp.  For any result of SizeOf >= 1 the two
	// agree; they differ only for a 0-byte aggregate (`struct{}` / `[0]T`), which
	// IsAggregateReturnTyp classifies as void-like so it does NOT take a retbuf.
	// The kind-only predicate wrongly demanded a retbuf for a 0-byte result, but
	// PlanFrame reserves no data region for it (dataSz > 0 gate), so LookupAlloc
	// returned -1 and emitCallFuncValue bailed BEFORE the BLX — silently dropping
	// the call (and its side effects).  The 0-byte result now rides the scalar/void
	// shim, matching the LLVM shim (which routes it to the void tail-branch).
	var aggregateRet bool = ins.ID >= 0 && types.IsAggregateReturnTyp(ins.Typ) &&
			!common.IsMultiReturnCall(ins)
	// Under retbuf-for-any-multi-return the shim writes EVERY multi-return
	// through the retbuf (matching the LLVM shim + caller + VM cross-mode
	// dispatch), so a single aggregate AND any multi-return (big OR small) ride
	// the retbuf-in-R0 convention: retbuf in R0, data in R1, user args R2+.  A
	// BIG tuple's shim tail-branches with retbuf in R0 (AAPCS32 sret via R0); a
	// SMALL tuple's shim CALLs, then stores the field-per-register result THROUGH
	// retbuf.  Either way the consumer reads the result from the spill slot post-
	// call.  (Pre-fix a small multi-return stayed on the scalar shape and
	// collected field-per-register from r0..r3 the LLVM shim never wrote — the
	// 972/973 arm32 miscompile.)
	var multiRet bool = ins.ID >= 0 && common.IsMultiReturnCall(ins)

	// Prepend synthetic slots for the shim's leading args: 1 (data) for a scalar
	// return, 2 (retbuf + data) for a single aggregate OR any multi-return.
	// prefixSlots is also the AAPCS32 reg offset for user args.
	var useRetbuf bool = aggregateRet || multiRet
	var prefixSlots int = 1
	if useRetbuf { prefixSlots = 2 }

	var nCallArgs int = len(ins.Args) - 1
	var argTypes @[]@types.Type = shimArgTypesArm32(rm.CC, ins, nCallArgs, prefixSlots)

	// Place user args first (dispatchIdx offset by prefixSlots), so a user arg
	// whose source reg is R0 / R1 is read before the retbuf / data loads
	// overwrite those registers.  Shared with emitCallIfaceMethod (arm32_iface_
	// dispatch.bn) so the two shim arg layouts can't drift.
	emitShimUserArgsArm32(a, pkgName, rm, ins, argTypes, prefixSlots, nCallArgs)
	if a.HasError { return }

	// Reload the func-value pointer (the arg loop's ResetRegs stranded it): its
	// data slot feeds R0/R1 and its vtable.call slot feeds IP.
	var fvAddr int = getOperand(a, rm, ins.Args[0].ID)
	if fvAddr < 0 {
		a.SetError("native arm32: func-value pointer not materializable (P4)")
		return
	}

	// Place the shim's leading args into R0/R1.  emitFrameAddr uses IP as its
	// scratch, so do this BEFORE loading the call target into IP.
	if useRetbuf {
		// A single aggregate lands in the alloc data region; a multi-return tuple
		// (big OR small) lands in the spill slot (PlanFrame sized it to the full
		// tuple).
		var retbufOff int = -1
		if multiRet {
			retbufOff = rm.LookupSpill(ins.ID)
		} else {
			retbufOff = rm.LookupAlloc(ins.ID)
		}
		if retbufOff < 0 { return }
		// R0 = &retbuf (the AAPCS32 sret pointer the shim writes through).
		emitFrameAddr(a, arm32.R0, retbufOff)
		// R1 = data.
		arm32.Ldr(a, arm32.COND_AL, arm32.R1, arm32.MemImm(fvAddr, types.FuncValueDataOffset()))
	} else {
		var dataRegStart int = rm.CC.CallArgRegStart(argTypes, 0)
		if dataRegStart >= 0 {
			arm32.Ldr(a, arm32.COND_AL, argReg(dataRegStart),
					arm32.MemImm(fvAddr, types.FuncValueDataOffset()))
		}
	}

	// Two-step load of vtable.call into IP, LAST (emitFrameAddr above clobbered
	// IP):
	//   IP = [fvAddr + FuncValueVtableOffset()]  ; vtable ptr
	//   IP = [IP + WordBytes]                     ; slot 1 = call (slot 0 = dtor)
	// The second offset is WordBytes (4), NOT the literal 8 — the {vtable, data}
	// value is 8 bytes on ILP32, so slot 1 is at offset 4.
	arm32.Ldr(a, arm32.COND_AL, arm32.IP, arm32.MemImm(fvAddr, types.FuncValueVtableOffset()))
	arm32.Ldr(a, arm32.COND_AL, arm32.IP, arm32.MemImm(arm32.IP, wordBytes()))
	arm32.Blx(a, arm32.COND_AL, arm32.IP)

	rm.ResetRegs()
	collectShimReturnArm32(a, rm, allFuncs, ins, aggregateRet, multiRet)
}

// shimArgTypesArm32 builds the synthetic AAPCS32 argTypes list for a handle/shim
// dispatch: `prefixSlots` leading *uint8 words (the shim's retbuf?/data[/receiver]
// prefix) followed by the user args ins.Args[1..] under the shim ABI.  A by-address
// aggregate — a coerced array / named struct / source-level anon struct OR a
// non-coerced small slice / iface-value / managed-slice / func-value
// (isByAddressAggArm32) — rides the dispatch BY-ADDRESS as ONE *uint8 pointer word
// (the shim loads + re-expands it), NOT its ArgWords value-word expansion, so
// CallArgRegStart places one word and it matches the LLVM cross-package shim's
// i8*-per-aggregate contract.  Every OTHER arg keeps its real type: a float scalar
// is NOT substituted (soft-float rides GP like the same-width integer — a float32
// one 4-aligned word, a float64 a 2-word even-aligned pair), a narrow scalar keeps
// its type (AAPCS32 does not set NaturalSizeStackArgs), and an indirect-large
// aggregate keeps its type (already one pointer word).  Shared by emitCallFuncValue
// (prefixSlots 1 scalar / 2 retbuf) and emitCallIfaceMethod (prefixSlots 2 scalar /
// 3 retbuf — one extra slot for the receiver) so the two arg layouts can't drift.
func shimArgTypesArm32(cc common.CallConv, ins @ir.Instr, nCallArgs int,
		prefixSlots int) @[]@types.Type {
	var argTypes @[]@types.Type = make_slice(@types.Type, nCallArgs + prefixSlots)
	for p := 0; p < prefixSlots; p++ {
		argTypes[p] = types.MakePointerType(types.TypUint8())
	}
	for i := 0; i < nCallArgs; i++ {
		var at @types.Type = ins.Args[i + 1].Typ
		if isByAddressAggArm32(cc, at) {
			at = types.MakePointerType(types.TypUint8())
		}
		argTypes[i + prefixSlots] = at
	}
	return argTypes
}

// emitShimUserArgsArm32 marshals a handle/shim call's user args (ins.Args[1..])
// into their AAPCS32 slots per the shim ABI: a by-address aggregate rides
// BY-ADDRESS as ONE pointer word (reg or stack) — the shim loads + re-expands it,
// matching the LLVM cross-package shim's i8*-per-aggregate contract — and every
// other arg via the shared emitCallArg (a float scalar via the soft-float GP path,
// a 64-bit-pair scalar via its two value-words).  `argTypes` is shimArgTypesArm32's
// synthetic list; user arg ai occupies slot ai+prefixSlots.  Per-arg ResetRegs
// keeps the tight R4..R10 scratch pool from saturating on long arg lists.  Shared
// by emitCallFuncValue and emitCallIfaceMethod.
func emitShimUserArgsArm32(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		ins @ir.Instr, argTypes @[]@types.Type, prefixSlots int, nCallArgs int) {
	for ai := 0; ai < nCallArgs; ai++ {
		var arg @ir.Instr = ins.Args[ai + 1]
		if common.IsAggregateTyp(arg.Typ) && isByAddressAggArm32(rm.CC, arg.Typ) {
			// A by-address aggregate: pass its data-region pointer in ONE dispatch
			// word (reg or stack) — NOT its inline value-words (which the shim would
			// mis-read as a pointer).  An indirect-large aggregate is NOT by-address
			// here: emitCallArg -> emitAggregateArg passes it as one pointer already.
			var regStart int = rm.CC.CallArgRegStart(argTypes, ai + prefixSlots)
			var stackOff int = rm.CC.CallArgStackOff(argTypes, ai + prefixSlots)
			var ptr int = getOperand(a, rm, arg.ID)
			if ptr < 0 {
				a.SetError("native arm32: shim aggregate arg not materializable (P4)")
				return
			}
			if regStart >= 0 {
				if ptr != argReg(regStart) {
					arm32.Mov(a, arm32.COND_AL, false, argReg(regStart), arm32.Reg(ptr))
				}
			} else if stackOff >= 0 {
				// Outgoing offset may exceed the 12-bit immediate for a
				// large-footprint dispatch call; materialize via IP.
				emitFrameStore(a, ptr, stackOff)
			}
			rm.ResetRegs()
			continue
		}
		emitCallArg(a, pkgName, rm, argTypes, arg, ai + prefixSlots)
		if a.HasError { return }
		rm.ResetRegs()
	}
}

// collectShimReturnArm32 collects a handle/shim call's return value after the BLX
// (and its rm.ResetRegs()).  aggregateRet: the shim wrote the single aggregate
// THROUGH the retbuf we passed in R0 (the alloc region) — just produce the region
// pointer as this instruction's result.  multiRet: the shim wrote the whole tuple
// through the retbuf (the spill slot) — big via AAPCS32 R0-sret, small via a
// store-through-retbuf — so nothing is collected from r0..r3 (which the shim never
// wrote).  Otherwise a scalar / void / 64-bit-pair result rides back in R0 / r0:r1
// and emitCallReturn spills it (a float32 from R0, a float64 pair from r0:r1 —
// soft-float rides GP like the same-width integer).  Shared by emitCallFuncValue
// and emitCallIfaceMethod — their shims use the identical retbuf/scalar return ABI,
// so the collect can't drift between the two.
func collectShimReturnArm32(a @asm.Assembler, rm @common.RegMap, allFuncs @[]@ir.Func,
		ins @ir.Instr, aggregateRet bool, multiRet bool) {
	if ins.ID < 0 { return }
	if aggregateRet {
		var dataOff int = rm.LookupAlloc(ins.ID)
		if dataOff < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		emitFrameAddr(a, rd, dataOff)
		return
	}
	if multiRet { return }
	emitCallReturn(a, rm, allFuncs, ins)
}
