package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// callIndAsm builds a minimal text-section assembler for indirect-call tests.
func callIndAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	return a
}

// hasBlxInstr scans the emitted text for a BLX (register) instruction — the
// indirect branch both emitCallIndirect and emitCallFuncValue end on.  BLX Rm
// encodes as `cond 0x012FFF3 Rm`, so masking off the condition and Rm nibbles
// leaves 0x012FFF30.
func hasBlxInstr(a @asm.Assembler) bool {
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var i int = 0
	for i + 3 < n {
		var w uint32 = cast(uint32, data[i]) | (cast(uint32, data[i + 1]) << 8) |
				(cast(uint32, data[i + 2]) << 16) | (cast(uint32, data[i + 3]) << 24)
		if (w & cast(uint32, 0x0ffffff0)) == cast(uint32, 0x012fff30) {
			return true
		}
		i = i + 4
	}
	return false
}

// ptrOperand makes a spilled pointer-typed operand (an fn-ptr / func-value
// pointer) at SSA id `id`, and registers its spill slot in rm.
func ptrOperand(rm @common.RegMap, id int, off int) @ir.Instr {
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, id)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, off)
	var p @ir.Instr = make(ir.Instr)
	p.ID = id
	p.Typ = types.MakePointerType(types.TypUint8())
	return p
}

// A void OP_CALL_INDIRECT loads the target and ends on BLX; it must lower
// without error and emit the indirect branch.
func TestEmitCallIndirectVoidEmitsBlx() testing.TestResult {
	var a @asm.Assembler = callIndAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var fn @ir.Instr = ptrOperand(rm, 0, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL_INDIRECT
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = fn
	var allFuncs @[]@ir.Func
	emitCallIndirect(a, "main", rm, allFuncs, ins)
	if a.HasError {
		return fail("void indirect call should not fail")
	}
	if !hasBlxInstr(a) {
		return fail("OP_CALL_INDIRECT should emit a BLX (indirect branch)")
	}
	return ""
}

// A scalar-returning OP_CALL_INDIRECT collects R0 into its spill slot; it must
// lower without error.
func TestEmitCallIndirectScalarReturnNoError() testing.TestResult {
	var a @asm.Assembler = callIndAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var fn @ir.Instr = ptrOperand(rm, 0, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 4)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL_INDIRECT
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = fn
	var allFuncs @[]@ir.Func
	emitCallIndirect(a, "main", rm, allFuncs, ins)
	if a.HasError {
		return fail("scalar-return indirect call should not fail")
	}
	if !hasBlxInstr(a) {
		return fail("OP_CALL_INDIRECT should emit a BLX")
	}
	return ""
}

// OP_CALL_INDIRECT is emitted only for dtors / free_fn / cross-mode dispatch,
// which never return an aggregate; an aggregate return must fail LOUDLY rather
// than mishandle silently.
func TestEmitCallIndirectAggregateReturnSetsError() testing.TestResult {
	var a @asm.Assembler = callIndAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var fn @ir.Instr = ptrOperand(rm, 0, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL_INDIRECT
	ins.Typ = aggPairType()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = fn
	var allFuncs @[]@ir.Func
	emitCallIndirect(a, "main", rm, allFuncs, ins)
	if !a.HasError {
		return fail("indirect call with aggregate return must fail loud (P4)")
	}
	return ""
}

// A scalar-returning OP_CALL_FUNC_VALUE loads vtable.call into IP, places the
// data pointer in R0, and ends on BLX; it must lower without error.
func TestEmitCallFuncValueScalarReturnEmitsBlx() testing.TestResult {
	var a @asm.Assembler = callIndAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var fv @ir.Instr = ptrOperand(rm, 0, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 4)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL_FUNC_VALUE
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = fv
	var allFuncs @[]@ir.Func
	emitCallFuncValue(a, "main", rm, allFuncs, ins)
	if a.HasError {
		return fail("scalar-return func-value call should not fail")
	}
	if !hasBlxInstr(a) {
		return fail("OP_CALL_FUNC_VALUE should emit a BLX through vtable.call")
	}
	return ""
}

// A func-value call with a scalar float64 ARG now lowers cleanly (P5.3): soft-float
// places the float64 in a 2-word even-aligned GP pair (like an int64) via the same
// emitCallArg lowering the direct call uses — no *uint8 one-word coercion — so the
// consumer emits the marshaling + BLX with no error.  The float64 arg (Args[1]) sits
// after the shim's data slot (R0), so AAPCS §6.5 C.3 even-aligns it to R2:R3 (R1
// padded); this test pins that the call is emitted, with conformance covering the
// end-to-end value.
func TestEmitCallFuncValueFloat64ArgNoError() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = callIndAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var fv @ir.Instr = ptrOperand(rm, 0, 0)
	// The float64 user arg lives in a spill slot; emitCallArg loads its two words as
	// an even-aligned register pair (the soft-float int64-pair path).
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 2
	arg.Typ = types.TypFloat64()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL_FUNC_VALUE
	ins.Typ = types.TypVoid()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = fv
	ins.Args[1] = arg
	var allFuncs @[]@ir.Func
	emitCallFuncValue(a, "main", rm, allFuncs, ins)
	if a.HasError {
		return fail("a func-value call with a float64 arg must lower cleanly (P5.3)")
	}
	if !hasBlxInstr(a) {
		return fail("a float64-arg func-value call should emit a BLX through vtable.call")
	}
	return ""
}

// A big-aggregate-returning OP_CALL_FUNC_VALUE uses the retbuf-in-R0 convention:
// the retbuf alloc region is passed in R0 and produced as the result pointer.
// Pins the ILP32 target so the 2-int struct is 8 bytes (> 4) → big-aggregate.
func TestEmitCallFuncValueBigAggregateReturnNoError() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = callIndAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var fv @ir.Instr = ptrOperand(rm, 0, 0)
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL_FUNC_VALUE
	ins.Typ = aggPairType()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = fv
	var allFuncs @[]@ir.Func
	emitCallFuncValue(a, "main", rm, allFuncs, ins)
	if a.HasError {
		return fail("big-aggregate func-value call should not fail (retbuf-in-R0)")
	}
	if !hasBlxInstr(a) {
		return fail("OP_CALL_FUNC_VALUE (big-agg) should emit a BLX")
	}
	if rm.LookupReg(1) < 0 {
		return fail("big-aggregate func-value call should produce a result reg")
	}
	return ""
}

// A small (<=4-byte) aggregate func-value return uses the retbuf-in-R0
// convention on the consumer side (identical to big-agg — the pack shim stores
// the by-value R0 word through the retbuf); the consumer produces the alloc
// region pointer as the result.
func TestEmitCallFuncValueSmallAggregateReturnCollects() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = callIndAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var fv @ir.Instr = ptrOperand(rm, 0, 0)
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL_FUNC_VALUE
	ins.Typ = aggSmallType()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = fv
	var allFuncs @[]@ir.Func
	emitCallFuncValue(a, "main", rm, allFuncs, ins)
	if a.HasError {
		return fail("small-agg func-value return should collect via retbuf, not fail")
	}
	if !hasBlxInstr(a) {
		return fail("small-agg func-value call should emit a BLX")
	}
	if rm.LookupReg(1) < 0 {
		return fail("small-agg func-value call should produce a result reg")
	}
	return ""
}

// A coerced in-register aggregate arg (a small named struct) rides the shim ABI
// BY-ADDRESS: the consumer passes its data-region pointer as ONE dispatch word
// (not its spread inline words), matching a cross-package func value's
// LLVM-emitted shim.  Must lower without error and emit the BLX.  Pins the ILP32
// target so the 2-int struct is a coerced-in-register aggregate.
func TestEmitCallFuncValueAggregateArgByAddress() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = callIndAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var fv @ir.Instr = ptrOperand(rm, 0, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 4)
	// The aggregate arg lives in a data region (getOperand -> region pointer).
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 2)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 8)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	var aggArg @ir.Instr = make(ir.Instr)
	aggArg.ID = 2
	aggArg.Typ = aggPairType()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL_FUNC_VALUE
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = fv
	ins.Args[1] = aggArg
	var allFuncs @[]@ir.Func
	emitCallFuncValue(a, "main", rm, allFuncs, ins)
	if a.HasError {
		return fail("aggregate-arg func-value call should lower by-address, not fail")
	}
	if !hasBlxInstr(a) {
		return fail("aggregate-arg func-value call should emit a BLX")
	}
	return ""
}

// A NON-coerced in-register aggregate arg (a managed-slice — not a coerced named
// struct/array) rides the shim ABI by-address, but the consumer's spread
// marshaling would mismatch the LLVM cross-pkg shim.  Marshaling it by-address is
// deferred (a known cross-backend gap), so it must fail LOUDLY rather than
// silently miscompile.
func TestEmitCallFuncValueNonCoercedAggregateArgSetsError() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = callIndAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var fv @ir.Instr = ptrOperand(rm, 0, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 4)
	var aggArg @ir.Instr = make(ir.Instr)
	aggArg.ID = 2
	aggArg.Typ = types.MakeManagedSliceType(types.TypInt())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL_FUNC_VALUE
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = fv
	ins.Args[1] = aggArg
	var allFuncs @[]@ir.Func
	emitCallFuncValue(a, "main", rm, allFuncs, ins)
	if !a.HasError {
		return fail(
				"non-coerced aggregate (managed-slice) func-value arg must "
						"fail loud, not silently spread")
	}
	return ""
}

// scalarArgs builds n spilled int operands (user args) and registers their spill
// slots in rm, returning them for splicing into ins.Args after the fn/fv operand.
func scalarArgs(rm @common.RegMap, n int) @[]@ir.Instr {
	var args @[]@ir.Instr = make_slice(@ir.Instr, n)
	for i := 0; i < n; i++ {
		var id int = 10 + i
		rm.SpillIDs = common.AppendInt(rm.SpillIDs, id)
		rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 100 + i * 4)
		var arg @ir.Instr = make(ir.Instr)
		arg.ID = id
		arg.Typ = types.TypInt()
		args[i] = arg
	}
	return args
}

// Many user args must not saturate the R4..R10 scratch pool (only 7 slots —
// tighter than aarch64/x64): the per-arg rm.ResetRegs() in the arg loop keeps at
// most a couple of scratches live at once.  10 int args is a meaningful guard —
// without the per-arg reset, the 8th getOperand would exhaust the pool and PANIC
// (regPool index 7), so this pins that the reset is present.  The args fill R0/R1
// prefix + R1..R3, then overflow to the stack; the emitter must place them all
// and end on BLX without erroring.  Mirrors aarch64/x64's pool-saturation pins;
// arm32 hits saturation soonest, so this guards the most fragile backend.  Pins
// the ILP32 target so each int is one GP word.
func TestEmitCallFuncValueManyArgsDoesNotSaturateRegPool() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = callIndAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var fv @ir.Instr = ptrOperand(rm, 0, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 4)
	var users @[]@ir.Instr = scalarArgs(rm, 10)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL_FUNC_VALUE
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 11)
	ins.Args[0] = fv
	for i := 0; i < 10; i++ { ins.Args[i + 1] = users[i] }
	var allFuncs @[]@ir.Func
	emitCallFuncValue(a, "main", rm, allFuncs, ins)
	if a.HasError {
		return fail("many-arg func-value call must not saturate the reg pool")
	}
	if !hasBlxInstr(a) {
		return fail("many-arg func-value call should still emit a BLX")
	}
	return ""
}

// The same pool-saturation guard for emitCallIndirect's arg loop.
func TestEmitCallIndirectManyArgsDoesNotSaturateRegPool() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = callIndAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var fn @ir.Instr = ptrOperand(rm, 0, 0)
	var users @[]@ir.Instr = scalarArgs(rm, 10)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL_INDIRECT
	ins.Args = make_slice(@ir.Instr, 11)
	ins.Args[0] = fn
	for i := 0; i < 10; i++ { ins.Args[i + 1] = users[i] }
	var allFuncs @[]@ir.Func
	emitCallIndirect(a, "main", rm, allFuncs, ins)
	if a.HasError {
		return fail("many-arg indirect call must not saturate the reg pool")
	}
	if !hasBlxInstr(a) {
		return fail("many-arg indirect call should still emit a BLX")
	}
	return ""
}

// Under retbuf-for-any-multi-return a SMALL multi-return func-value call
// ((int, int) = 2 GP words) passes a retbuf (the spill slot) in R0 and does NOT
// collect field-per-register post-call — the shim (native OR LLVM) stores the
// whole tuple THROUGH retbuf.  An anonymous (empty-name) struct result is what
// IsMultiReturnCall keys on.  The call must lower (no error) and still end on the
// BLX indirect branch.
func TestEmitCallFuncValueSmallMultiReturnUsesRetbuf() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = callIndAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var fv @ir.Instr = ptrOperand(rm, 0, 0)
	// Result spill slot doubles as the retbuf (PlanFrame sizes it to the full
	// tuple).
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt32()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt32()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL_FUNC_VALUE
	ins.Typ = types.MakeStructType("", fields)
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = fv
	var allFuncs @[]@ir.Func
	emitCallFuncValue(a, "main", rm, allFuncs, ins)
	if a.HasError {
		return fail("small multi-return func-value call must lower, not error")
	}
	if !hasBlxInstr(a) {
		return fail("small multi-return func-value call should emit a BLX")
	}
	return ""
}
