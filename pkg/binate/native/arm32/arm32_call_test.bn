package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A zero-arg void OP_CALL lowers to a single BL (4 bytes) and registers the
// callee symbol so Finalize emits a relocation rather than erroring.
func TestCallZeroArgVoid() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var noArgs2 @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.main"
	ins.Args = noArgs2
	ins.Typ = types.TypVoid()
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, ins)
	if a.Sections[0].Len != 4 {
		return fail("zero-arg void call should emit a single BL (4 bytes)")
	}
	if a.LookupSymbol("bn_F1_4_main1_4_main") < 0 {
		return fail("emitCall should register the callee symbol")
	}
	return ""
}

// appendInstrPtr_arm32calltest grows a @[]@ir.Instr by one (the arm32 subset
// has no builtin append).
func appendInstrPtr_arm32calltest(s @[]@ir.Instr, v @ir.Instr) @[]@ir.Instr {
	var n @[]@ir.Instr = make_slice(@ir.Instr, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}

// A call passing an AGGREGATE arg is P3 territory and must fail LOUDLY
// (a.SetError -> EmitObject aborts) rather than silently dropping the
// unmarshaled value into a wrong binary.
func TestCallAggregateArgSetsError() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var argIns @ir.Instr = make(ir.Instr)
	argIns.ID = -1
	argIns.Typ = types.MakeManagedSliceType(types.TypInt())
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, argIns)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.f"
	ins.Args = args
	ins.Typ = types.TypVoid()
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, ins)
	if !a.HasError {
		return fail("call with an aggregate arg must set a compile error")
	}
	return ""
}

// A call returning an AGGREGATE value is P3 territory and must fail LOUDLY:
// the R0-only collection path would spill garbage.
func TestCallAggregateReturnSetsError() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var noArgs2 @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.f"
	ins.Args = noArgs2
	ins.Typ = types.MakeManagedSliceType(types.TypInt())
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, ins)
	if !a.HasError {
		return fail("call with an aggregate return must set a compile error")
	}
	return ""
}

// OP_C_CALL uses the verbatim C symbol (no Binate mangling) as the BL target.
func TestCCallVerbatimSymbol() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var noArgs2 @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_C_CALL
	ins.StrVal = "abort"
	ins.Args = noArgs2
	ins.Typ = types.TypVoid()
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, ins)
	if a.LookupSymbol("abort") < 0 {
		return fail("OP_C_CALL should target the verbatim C symbol 'abort'")
	}
	return ""
}
