package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A zero-arg void OP_CALL lowers to a single BL (4 bytes) and registers the
// callee symbol so Finalize emits a relocation rather than erroring.
func TestCallZeroArgVoid() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var noArgs2 @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.main"
	ins.Args = noArgs2
	ins.Typ = types.TypVoid()
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, ins)
	if a.Sections[0].Len != 4 {
		return fail("zero-arg void call should emit a single BL (4 bytes)")
	}
	if a.LookupSymbol("bn_F1_4_main1_4_main") < 0 {
		return fail("emitCall should register the callee symbol")
	}
	return ""
}

// appendInstrPtr_arm32calltest grows a @[]@ir.Instr by one (the arm32 subset
// has no builtin append).
func appendInstrPtr_arm32calltest(s @[]@ir.Instr, v @ir.Instr) @[]@ir.Instr {
	var n @[]@ir.Instr = make_slice(@ir.Instr, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}

// A call passing a FLOAT arg is a later increment (soft-float) and must fail
// LOUDLY (a.SetError -> EmitObject aborts) rather than silently dropping the
// unmarshaled value into a wrong binary.  A float scalar is chosen (not an
// aggregate) because aggregate args ARE now lowered (spread across R0..R3 /
// stack); the float register/soft-float marshaling is what's still deferred.
func TestCallFloatArgSetsError() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var argIns @ir.Instr = make(ir.Instr)
	argIns.ID = -1
	argIns.Typ = types.TypFloat64()
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, argIns)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.f"
	ins.Args = args
	ins.Typ = types.TypVoid()
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, ins)
	if !a.HasError {
		return fail("call with a float arg must set a compile error")
	}
	return ""
}

// A call returning a FLOAT scalar is a later increment (soft-float): the R0
// collection path would read the wrong location, so it must fail LOUDLY.
// (An aggregate return also fails loud — see TestCallAggregateReturnSetsError.)
func TestCallFloatReturnSetsError() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var noArgs2 @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.f"
	ins.Args = noArgs2
	ins.Typ = types.TypFloat64()
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, ins)
	if !a.HasError {
		return fail("call with a float return must set a compile error")
	}
	return ""
}

// A call returning an aggregate (a 16-byte managed-slice > the ILP32 sret
// threshold) uses AAPCS32 sret, whose R0 arg-register shift this increment
// defers — so emitCall must fail LOUDLY rather than silently miscompile a call
// whose args would collide with the sret pointer in R0.  (rt.MakeManagedSlice
// is unaffected: it's lowered by emitMakeSlice, not emitCall.)
func TestCallAggregateReturnSetsError() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var noArgs2 @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.f"
	ins.Args = noArgs2
	ins.Typ = types.MakeManagedSliceType(types.TypInt())
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, ins)
	if !a.HasError {
		return fail("aggregate-return call must set a compile error (deferred)")
	}
	return ""
}

// OP_C_CALL uses the verbatim C symbol (no Binate mangling) as the BL target.
func TestCCallVerbatimSymbol() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var noArgs2 @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_C_CALL
	ins.StrVal = "abort"
	ins.Args = noArgs2
	ins.Typ = types.TypVoid()
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, ins)
	if a.LookupSymbol("abort") < 0 {
		return fail("OP_C_CALL should target the verbatim C symbol 'abort'")
	}
	return ""
}
