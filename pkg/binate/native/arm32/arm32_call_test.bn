package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A zero-arg void OP_CALL lowers to a single BL (4 bytes) and registers the
// callee symbol so Finalize emits a relocation rather than erroring.
func TestCallZeroArgVoid() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var noArgs2 @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.main"
	ins.Args = noArgs2
	ins.Typ = types.TypVoid()
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, ins)
	if a.Sections[0].Len != 4 {
		return fail("zero-arg void call should emit a single BL (4 bytes)")
	}
	if a.LookupSymbol("bn_F1_4_main1_4_main") < 0 {
		return fail("emitCall should register the callee symbol")
	}
	return ""
}

// appendInstrPtr_arm32calltest grows a @[]@ir.Instr by one (the arm32 subset
// has no builtin append).
func appendInstrPtr_arm32calltest(s @[]@ir.Instr, v @ir.Instr) @[]@ir.Instr {
	var n @[]@ir.Instr = make_slice(@ir.Instr, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}

// A call passing a FLOAT arg is a later increment (soft-float) and must fail
// LOUDLY (a.SetError -> EmitObject aborts) rather than silently dropping the
// unmarshaled value into a wrong binary.  A float scalar is chosen (not an
// aggregate) because aggregate args ARE now lowered (spread across R0..R3 /
// stack); the float register/soft-float marshaling is what's still deferred.
func TestCallFloatArgSetsError() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var argIns @ir.Instr = make(ir.Instr)
	argIns.ID = -1
	argIns.Typ = types.TypFloat64()
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, argIns)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.f"
	ins.Args = args
	ins.Typ = types.TypVoid()
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, ins)
	if !a.HasError {
		return fail("call with a float arg must set a compile error")
	}
	return ""
}

// A call returning a FLOAT scalar is a later increment (soft-float): the R0
// collection path would read the wrong location, so it must fail LOUDLY.
// (An aggregate return is lowered via AAPCS32 sret — see
// TestCallAggregateReturnMaterializesSretBuffer.)
func TestCallFloatReturnSetsError() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var noArgs2 @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.f"
	ins.Args = noArgs2
	ins.Typ = types.TypFloat64()
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, ins)
	if !a.HasError {
		return fail("call with a float return must set a compile error")
	}
	return ""
}

// A call returning an aggregate (a 16-byte managed-slice > the ILP32 sret
// threshold — on ILP32 EVERY slice / struct is sret) uses AAPCS32 sret: the
// caller materializes a pointer to the result's alloc data region into R0 (the
// hidden buffer pointer), the callee writes through it, and after the BL the
// caller LEAs that data-region pointer into the result register.  Pin that the
// call lowers (no error), registers the callee, and emits an epilogue-free
// stream ending in the LEA (an ADD, not a BL).  A zero-arg call keeps R0 free
// for the sret pointer with no arg collision to test here (the shift itself is
// exercised by the common-layer classifier tests + conformance).
func TestCallAggregateReturnMaterializesSretBuffer() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// The call result's own data region (16-byte managed-slice) + pointer spill.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 0)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 0)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	var noArgs2 @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.f"
	ins.Args = noArgs2
	ins.Typ = types.MakeManagedSliceType(types.TypInt())
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, ins)
	if a.HasError {
		return fail("aggregate-return call must lower via sret, not error")
	}
	// First instruction is emitFrameAddr into R0 (`add r0, sp, #0` — DP ADD
	// opcode 0x4, Rd = R0, Rn = SP): the hidden sret buffer pointer.
	if dpOpcodeAt(a, 0) != cast(uint32, 0x4) || rdAt(a, 0) != cast(uint32, arm32.R0) {
		return fail("aggregate-return call must materialize sret buffer into R0")
	}
	if rnAt(a, 0) != cast(uint32, arm32.SP) {
		return fail("sret buffer materialization must be SP-relative")
	}
	// Setup ADD (@0), BL (@4), result-register LEA ADD (@8): three words.
	if a.Sections[0].Len < 12 {
		return fail("aggregate-return sret call should emit setup + BL + LEA")
	}
	// The BL branch-with-link opcode is 0b1011 in bits [27:24].
	if (word32(a, 4) >> 24) & cast(uint32, 0xf) != cast(uint32, 0xB) {
		return fail("aggregate-return sret call must emit the BL to the callee")
	}
	return ""
}

// callRm builds a RegMap whose int64 arg-operand SSA ids have 8-byte spill
// slots (so load64 reloads each pair via two LDRs) and whose int32 arg-operand
// ids have 4-byte spill slots.  `ids` are the operand SSA ids in order; each is
// given a fresh slot 8 bytes apart (int64-safe for every entry).
func callRm(ids @[]int) @common.RegMap {
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	for i := 0; i < len(ids); i++ {
		rm.SpillIDs = common.AppendInt(rm.SpillIDs, ids[i])
		rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, i * 8)
	}
	return rm
}

// callArg builds a spilled SSA operand instr with the given id + type.
func callArg(id int, t @types.Type) @ir.Instr {
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = id
	arg.Typ = t
	return arg
}

// callWithArgs builds an OP_CALL to "main.f" with the given already-built args
// and a void return.
func callWithArgs(args @[]@ir.Instr) @ir.Instr {
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.f"
	ins.Args = args
	ins.Typ = types.TypVoid()
	return ins
}

// A single int64 first arg lands in the r0:r1 pair (AAPCS32 places an 8-byte-
// aligned scalar starting at an EVEN core register, and NGRN starts at 0): lo →
// r0, hi → r1.  Emission order for a spilled operand: load64 (LDR lo @0, LDR hi
// @4), then placeInt64Arg's two MOVs (MOV r0,lo @8 ; MOV r1,hi @12) — since the
// scratch regs load64 hands back are r4+, both MOVs are emitted.
func TestCallInt64ArgInR0R1Pair() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var ids @[]int
	ids = common.AppendInt(ids, 10)
	var rm @common.RegMap = callRm(ids)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, callArg(10, types.TypInt64()))
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, callWithArgs(args))
	if a.HasError {
		return fail("an int64 first arg must lower, not error")
	}
	// The two placement MOVs follow the two load64 LDRs.
	if dpOpcodeAt(a, 8) != cast(uint32, 0xD) || rdAt(a, 8) != cast(uint32, arm32.R0) {
		return fail("int64 arg lo word must be MOV'd into r0")
	}
	if dpOpcodeAt(a, 12) != cast(uint32, 0xD) || rdAt(a, 12) != cast(uint32, arm32.R1) {
		return fail("int64 arg hi word must be MOV'd into r1")
	}
	return ""
}

// An int64 arg AFTER a leading int32 arg lands EVEN-ALIGNED in the r2:r3 pair:
// the int32 takes r0 (NGRN → 1); the int64 needs an even start, so the odd r1 is
// PADDED over (AAPCS32 §6.5 stage C.3) and the pair takes r2:r3.  This exercises
// the odd-register pad.  Emission: int32 arg — load (LDR @0) + MOV r0 (@4);
// ResetRegs; int64 arg — load64 (LDR lo @8, LDR hi @12) + MOV r2,lo (@16) +
// MOV r3,hi (@20).  (TypInt32, not TypInt: a unit test runs on the host, where
// `int` locks to the host's LP64 64-bit width — see types.SetTarget — so TypInt
// would be a 64-bit pair, not the 32-bit leading arg this scenario needs.)
func TestCallInt64ArgEvenAlignedInR2R3AfterInt32() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var ids @[]int
	ids = common.AppendInt(ids, 10)
	ids = common.AppendInt(ids, 11)
	var rm @common.RegMap = callRm(ids)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, callArg(10, types.TypInt32()))
	args = appendInstrPtr_arm32calltest(args, callArg(11, types.TypInt64()))
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, callWithArgs(args))
	if a.HasError {
		return fail("an int32-then-int64 arg list must lower, not error")
	}
	// int32 arg: LDR @0 reloads the spilled value; MOV r0 @4 places it.
	if dpOpcodeAt(a, 4) != cast(uint32, 0xD) || rdAt(a, 4) != cast(uint32, arm32.R0) {
		return fail("int32 arg must be MOV'd into r0")
	}
	// int64 arg placed even-aligned into r2:r3 (r1 is the skipped odd-reg pad).
	if dpOpcodeAt(a, 16) != cast(uint32, 0xD) || rdAt(a, 16) != cast(uint32, arm32.R2) {
		return fail("even-aligned int64 arg lo word must be MOV'd into r2")
	}
	if dpOpcodeAt(a, 20) != cast(uint32, 0xD) || rdAt(a, 20) != cast(uint32, arm32.R3) {
		return fail("even-aligned int64 arg hi word must be MOV'd into r3")
	}
	// The CallConv the emitter drives must agree: int64 (arg 1) starts at r2.
	var at @[]@types.Type = make_slice(@types.Type, 2)
	at[0] = types.TypInt32()
	at[1] = types.TypInt64()
	if rm.CC.CallArgRegStart(at, 1) != 2 {
		return fail("AAPCS32 CallArgRegStart must place the int64 arg at r2 (even)")
	}
	return ""
}

// OP_C_CALL uses the verbatim C symbol (no Binate mangling) as the BL target.
func TestCCallVerbatimSymbol() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var noArgs2 @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_C_CALL
	ins.StrVal = "abort"
	ins.Args = noArgs2
	ins.Typ = types.TypVoid()
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, ins)
	if a.LookupSymbol("abort") < 0 {
		return fail("OP_C_CALL should target the verbatim C symbol 'abort'")
	}
	return ""
}

// A call whose result is a SMALL aggregate (SizeOf <= InternalSretBytes = 4) is
// NOT sret — AAPCS32 returns it BY VALUE in R0 — so bigRet is false.
// emitCallReturn stores the R0 word into the call result's alloc data region and
// produces a pointer to that region.  [4]uint8 is 4 bytes on any target.
func TestCallSmallAggregateReturnCollectsR0() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 0)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	var noArgs2 @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.f"
	ins.Args = noArgs2
	ins.Typ = types.MakeArrayType(types.TypUint8(), 4)
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, ins)
	if a.HasError {
		return fail("small (<=4-byte) aggregate call return should collect R0, "
			"not fail")
	}
	if rm.LookupReg(0) < 0 {
		return fail("small aggregate call return should produce a region pointer")
	}
	return ""
}

// A call returning a BIG aggregate (sret) with one int32 user arg: the hidden
// sret buffer pointer occupies R0, so the user arg shifts to R1.  emitCall must
// place it in R1 (not R0), driven by the ai+1 dispatch index through the CallConv
// (which, after the 1-word sret prepend, returns R1).  Pins the caller-side arg
// shift end-to-end — a classifier-only test can't catch a wrong dispatchIdx in
// emitCall.  (TypInt32, not TypInt, for the user arg: a host unit test locks
// `int` to the LP64 64-bit width, which would be a register pair, not the
// single-word arg here.  setArm32Target likewise pins ILP32 so emitCall's
// synthesised TypInt sret slot is a SINGLE word — under the LP64 host default it
// would be 2 words, consuming R0:R1 and shifting the user arg to R2, not R1.)
func TestCallSretReturnShiftsArgToR1() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// Big-aggregate result: alloc data region (16-byte managed-slice) + arg spill.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 0)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 10)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, callArg(10, types.TypInt32()))
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.f"
	ins.Args = args
	ins.Typ = types.MakeManagedSliceType(types.TypInt())
	var allFuncs @[]@ir.Func
	emitCall(a, "main", rm, allFuncs, ins)
	if a.HasError {
		return fail("sret-return call with an int32 arg must lower, not error")
	}
	// int32 arg: LDR @0 reloads the spilled value; MOV r1 @4 places it (shifted
	// off R0, which the sret buffer pointer occupies) — DP MOV opcode 0xD.
	if dpOpcodeAt(a, 4) != cast(uint32, 0xD) ||
			rdAt(a, 4) != cast(uint32, arm32.R1) {
		return fail("sret call's user arg 0 must shift to R1, not R0")
	}
	// The CallConv the emitter drives must agree: with the 1-word sret prepend,
	// user arg 0 (dispatch index 1) starts at R1.
	var at @[]@types.Type = make_slice(@types.Type, 2)
	at[0] = types.TypInt()
	at[1] = types.TypInt32()
	if rm.CC.CallArgRegStart(at, 1) != 1 {
		return fail("AAPCS32 CallArgRegStart must place user arg 0 at R1 after "
			"the sret prepend")
	}
	return ""
}
