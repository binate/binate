package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests that a variadic __c_call's float result is collected from the core registers
// on arm32 hard-float: AAPCS-VFP uses the base standard for the whole of a variadic
// call, so a C function `double f(int, ...)` returns in r0:r1 (a float32 one in r0),
// not d0 / s0 — while a non-variadic __c_call's float result stays in VFP.

// floatCCallRet emits a __c_call to `f` (variadic or not) returning t into result id 0,
// spilled at [sp, #8] or homed in home when home >= 0, on a hard-float RegMap.
func floatCCallRet(t @types.Type, variadic bool, home int) @asm.Assembler {
	oldArch, oldAbi := stampHard()
	var rm @common.RegMap = hardRm()
	addSpill(rm, 0, 8)
	if home >= 0 {
		rm.HomeIDs = common.AppendInt(rm.HomeIDs, 0)
		rm.HomeRegs = common.AppendInt(rm.HomeRegs, home)
	}
	var noArgs @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_C_CALL
	ins.StrVal = "f"
	ins.Args = noArgs
	ins.Typ = t
	ins.CVariadic = variadic
	var a @asm.Assembler = mkAsm()
	emitCall(a, "main", rm, ins)
	restoreTarget(oldArch, oldAbi)
	return a
}

// A variadic __c_call returning float64 stores r0:r1 to the result slot; one returning
// float32 stores r0.  Neither reads d0 / s0.
func TestVariadicCCallFloatResultFromCoreRegs() testing.TestResult {
	var a64 @asm.Assembler = floatCCallRet(types.TypFloat64(), true, -1)
	var a32 @asm.Assembler = floatCCallRet(types.TypFloat32(), true, -1)
	if a64.HasError || a32.HasError { return fail("a variadic float-returning __c_call must lower") }
	if !containsWord(a64, strWord(arm32.R0, arm32.SP, 8)) ||
			!containsWord(a64, strWord(arm32.R1, arm32.SP, 12)) {
		return fail("a variadic float64 result must be stored from r0:r1")
	}
	if containsWord(a64, vstrWord(true, vfp.D0, arm32.SP, 8)) {
		return fail("it must not come from d0")
	}
	if !containsWord(a32, strWord(arm32.R0, arm32.SP, 8)) {
		return fail("a variadic float32 result must come from r0")
	}
	if containsWord(a32, vstrWord(false, vfp.S0, arm32.SP, 8)) {
		return fail("it must not come from s0")
	}
	return ""
}

// An FP-homed variadic float result moves into its home from the core registers.
func TestVariadicCCallFloatResultHomed() testing.TestResult {
	var a64 @asm.Assembler = floatCCallRet(types.TypFloat64(), true, vfp.D8)
	var a32 @asm.Assembler = floatCCallRet(types.TypFloat32(), true, vfp.D9)
	if a64.HasError || a32.HasError { return fail("a homed variadic float result must lower") }
	var ref @asm.Assembler = mkAsm()
	vfp.VmovCoresToDouble(ref, arm32.COND_AL, vfp.D8, arm32.R0, arm32.R1)
	vfp.VmovCoreToSingle(ref, arm32.COND_AL, vfp.S18, arm32.R0)
	if !containsWord(a64, word32(ref, 0)) {
		return fail("a homed float64 result must move r0:r1 into d8")
	}
	if !containsWord(a32, word32(ref, 4)) {
		return fail("a homed float32 result must move r0 into s18 (d9)")
	}
	return ""
}

// The control: a NON-variadic __c_call's float64 / float32 result still comes from
// d0 / s0.
func TestFixedCCallFloatResultFromVfp() testing.TestResult {
	var a @asm.Assembler = floatCCallRet(types.TypFloat64(), false, -1)
	var b @asm.Assembler = floatCCallRet(types.TypFloat32(), false, -1)
	if a.HasError || b.HasError { return fail("a fixed float-returning __c_call must lower") }
	if !containsWord(a, vstrWord(true, vfp.D0, arm32.SP, 8)) {
		return fail("its float64 result comes from d0")
	}
	if containsWord(a, strWord(arm32.R0, arm32.SP, 8)) { return fail("it must not be stored from r0") }
	if !containsWord(b, vstrWord(false, vfp.S0, arm32.SP, 8)) {
		return fail("its float32 result comes from s0")
	}
	if containsWord(b, strWord(arm32.R0, arm32.SP, 8)) { return fail("it must not be stored from r0") }
	return ""
}
