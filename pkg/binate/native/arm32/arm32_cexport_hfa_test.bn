package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for HFA params in the #[c_export] / __c_entry adapter trampoline
// (arm32_cexport_trampoline.bn), hard-float with cc.HfaAggregates forced on.  The
// trampoline here exists for its (int, int) result, which C returns through a hidden
// sret pointer and Binate in r0:r1; an HFA param rides the same VFP registers under
// both conventions, so one in registers is left in place and one past the VFP bank is
// copied from the C stack slot to the body's.

// hfaTrampoline emits the adapter trampoline for `func F(ps...) (int, int)` with HFA
// passing on, on an ILP32 hard-float target.
func hfaTrampoline(ps @[]@types.Type) @asm.Assembler {
	setArm32Target()
	oldArch, oldAbi := stampHard()
	var params @[]@ir.Param = make_slice(@ir.Param, len(ps))
	for i := 0; i < len(ps); i++ {
		params[i] = make(ir.Param)
		params[i].ID = i + 1
		params[i].Name = "p"
		params[i].Typ = ps[i]
	}
	var rs @[]@types.Type = make_slice(@types.Type, 2)
	rs[0] = types.TypInt()
	rs[1] = types.TypInt()
	var fn @ir.Func = ir.NewFunc("", "main.F", params, rs)
	var tup @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		tup[i] = make(types.Field)
		tup[i].Type = types.TypInt()
	}
	fn.MultiReturnType = types.MakeStructType("", tup)
	var a @asm.Assembler = mkAsm()
	emitCExportTrampolineArm32(a, common.NewRegMap(hfaShimCC()), fn, "bn_F")
	restoreTarget(oldArch, oldAbi)
	return a
}

// An F2 param in s0-s1 is already where the body expects it: the trampoline emits
// exactly what it emits with no param at all (no store of it to the frame).
func TestCExportTrampolineHfaParamLeftInVfp() testing.TestResult {
	var none @[]@types.Type
	var a @asm.Assembler = hfaTrampoline(typesOf1(hfaType("F2", types.TypFloat32(), 2)))
	var bare @asm.Assembler = hfaTrampoline(none)
	if a.HasError || bare.HasError { return fail("an HFA-param trampoline must lower") }
	if bytesWritten(a) != bytesWritten(bare) {
		return fail("an HFA param in VFP registers must be left in place")
	}
	return ""
}

// (D4, D4, F1): F1 is past the VFP bank, on the stack for C and body alike — C's slot
// at the incoming [SP + 40] (above the 32-byte frame and the {r4, lr} save), the
// body's at the outgoing [SP]; its word moves through R4.
func TestCExportTrampolineHfaParamPastBankCopied() testing.TestResult {
	var d4 @types.Type = hfaType("D4", types.TypFloat64(), 4)
	var ps @[]@types.Type = make_slice(@types.Type, 3)
	ps[0] = d4
	ps[1] = d4
	ps[2] = hfaType("F1", types.TypFloat32(), 1)
	var a @asm.Assembler = hfaTrampoline(ps)
	if a.HasError { return fail("an HFA past the bank must lower") }
	if !containsWord(a, ldrWord(arm32.R4, arm32.SP, 40)) ||
			!containsWord(a, strWord(arm32.R4, arm32.SP, 0)) {
		return fail("F1's word must move from C's stack slot to the body's")
	}
	return ""
}
