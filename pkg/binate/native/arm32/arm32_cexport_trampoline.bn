package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// funcHasByvalParamArm32 reports whether f has a >16-byte by-value aggregate
// parameter — the case whose AAPCS32 C-ABI form (by value, split across r0-r3 and
// the stack) differs from Binate's internal single-pointer form and so needs an
// adapting entry, not the in-place narrow-register prefix.
func funcHasByvalParamArm32(f @ir.Func) bool {
	for i := 0; i < len(f.Params); i++ {
		if f.Params[i].Typ.IsByvalParam() {
			return true
		}
	}
	return false
}

// cExportRetTrampolineKindArm32 classifies f's #[c_export] multi-value-return
// adaptation (common.CRET_ADAPT_NONE / _SRET / _COERCE); NONE for a single /
// scalar / void return.  arm32 never hits COERCE_FROM_SRET (its 4-GP-word budget
// exceeds the > 4-byte C sret cutoff, so C-register ⟹ internal-register).
func cExportRetTrampolineKindArm32(f @ir.Func, cc common.CallConv) int {
	if len(f.Results) <= 1 || f.MultiReturnType == nil {
		return common.CRET_ADAPT_NONE
	}
	return cc.CExportMultiReturnAdaptKind(f.MultiReturnType)
}

// cExportNeedsTrampolineArm32 reports whether f's #[c_export] entry needs an
// adapter trampoline: a >16-byte by-value aggregate PARAMETER or a divergent
// multi-value RETURN.
func cExportNeedsTrampolineArm32(f @ir.Func, cc common.CallConv) bool {
	return funcHasByvalParamArm32(f) || cExportRetTrampolineKindArm32(f, cc) != common.CRET_ADAPT_NONE
}

// loadCoercedTupleReturn_arm32 loads the memory image of an in-register multi-
// return tuple at [sp+baseOff] into the GP return registers r0.. in clang's C
// struct-return coerced form.  An arm32 in-register (C-register) tuple is ≤ 4
// bytes (the AAPCS32 sret cutoff), so this is one word into r0 — but the general
// per-word loop keeps it robust.  Pure GP: a ≤ 4-byte tuple cannot carry a float
// scalar field (a float is a whole 4-byte field and a 2+-field tuple then exceeds
// the cutoff → sret), so no VFP load is needed.
func loadCoercedTupleReturn_arm32(a @asm.Assembler, t @types.Type, baseOff int) {
	var w int = wordBytes()
	var words int = (t.SizeOf() + w - 1) / w
	for wi := 0; wi < words; wi++ {
		emitFrameLoad(a, argReg(wi), baseOff + w * wi)
	}
}

// emitCExportTrampolineArm32 emits the #[c_export] C entry for a function whose
// parameters and/or multi-value return need C-ABI adaptation.  It re-marshals each
// argument from its C-ABI position to `sym`'s internal position, calls `sym`, then
// adapts the return, and returns via `pop {r4, pc}`.
//
// Two register cursors — the C-facing one (paramTypesC, with a hidden sret pointer
// in R0 iff the C ABI sret's the result) and the internal one (paramTypesInt, the
// mangled body's) — disagree only when the C ABI sret's a tuple the internal
// convention register-returns: the C args are then shifted one GP register down
// (R0 holds the C sret buffer).  `shift` is that difference; 0 whenever the two
// conventions agree.  AAPCS32 may split an aggregate across r0-r3 and the stack, so
// each word is placed by its own register-vs-stack test on both sides.  A >16-byte
// aggregate param is GATHERED into a contiguous slot and handed over as a pointer.
// Register writes never clobber a live source: phase 1 stages r0-r3, phase 2 reads
// only from that staging or the incoming stack.  A native caller enters at `sym`.
func emitCExportTrampolineArm32(a @asm.Assembler, rm @common.RegMap, f @ir.Func,
		sym *[]readonly char) {
	var cc common.CallConv = rm.CC
	var ccC common.CallConv = cc.ForCBoundary()
	var w int = wordBytes()

	var intSret bool = rm.SretSlotOff >= 0
	var isMulti bool = len(f.Results) > 1 && f.MultiReturnType != nil
	var retKind int = common.CRET_ADAPT_NONE
	var cSret bool = intSret
	if isMulti {
		retKind = cc.CExportMultiReturnAdaptKind(f.MultiReturnType)
		cSret = common.CMultiReturnTupleNeedsSret(f.MultiReturnType)
	}
	var intPfx int = 0
	if intSret {
		intPfx = 1
	}
	var cPfx int = 0
	if cSret {
		cPfx = 1
	}
	var shift int = cPfx - intPfx
	var paramTypesInt @[]@types.Type = make_slice(@types.Type, len(f.Params) + intPfx)
	if intSret {
		paramTypesInt[0] = types.MakePointerType(types.TypUint8())
	}
	for pi := 0; pi < len(f.Params); pi++ {
		paramTypesInt[intPfx + pi] = f.Params[pi].Typ
	}
	var paramTypesC @[]@types.Type = make_slice(@types.Type, len(f.Params) + cPfx)
	if cSret {
		paramTypesC[0] = types.MakePointerType(types.TypUint8())
	}
	for pi := 0; pi < len(f.Params); pi++ {
		paramTypesC[cPfx + pi] = f.Params[pi].Typ
	}

	// Frame (below the {r4,lr} save):
	//   [sp+0 .. outBytes)              sym's outgoing stack args
	//   [sp+stageOff .. +NumGpArgRegs*w) staging for the incoming GP arg regs r0-r3
	//   [sp+gatherOff .. )              a contiguous copy per >16-byte aggregate
	//   [sp+retSlotOff .. +8)           in-register-coercion repack slot
	var outBytes int = cc.CallStackBytes(paramTypesInt)
	var stageOff int = outBytes
	var gatherOff int = stageOff + cc.NumGpArgRegs * w
	var gatherBytes int = 0
	for i := 0; i < len(paramTypesInt); i++ {
		if paramTypesInt[i].IsByvalParam() {
			gatherBytes = gatherBytes + cc.ArgWords(paramTypesInt[i]) * w
		}
	}
	var retSlotOff int = gatherOff + gatherBytes
	var frameSz int = retSlotOff + 8
	if frameSz % cc.StackAlign != 0 {
		frameSz = frameSz + (cc.StackAlign - frameSz % cc.StackAlign)
	}
	var savedBytes int = 8 // {r4, lr}
	var inBase int = frameSz + savedBytes

	arm32.Push(a, arm32.COND_AL, 0x4010) // {r4, lr}
	if frameSz > 0 {
		emitSpAdjust(a, false, frameSz)
	}
	for r := 0; r < cc.NumGpArgRegs; r++ {
		emitFrameStore(a, argReg(r), stageOff + w * r)
	}

	var gatherCursor int = gatherOff
	for i := 0; i < len(paramTypesInt); i++ {
		var t @types.Type = paramTypesInt[i]
		var nReg int = cc.CallArgRegStart(paramTypesInt, i)
		var nOff int = cc.CallArgStackOff(paramTypesInt, i)
		var cIdx int = i + shift

		if types.Arm32HardFloat() && common.IsFloatScalarTyp(t) {
			// Hard-float scalar rides a VFP register, unshifted by a GP aggregate or
			// the sret pointer — a register float is already where sym expects it.  A
			// stack float (VFP bank exhausted) is copied by word.  Soft-float falls
			// through to the GP path (a float is a GP word there).
			if nOff >= 0 {
				var cOff int = ccC.CallArgStackOff(paramTypesC, cIdx)
				var fw int = cc.ArgWords(t)
				for wi := 0; wi < fw; wi++ {
					emitBaseLoad(a, arm32.R4, arm32.SP, inBase + cOff + w * wi, arm32.IP)
					emitFrameStore(a, arm32.R4, nOff + w * wi)
				}
			}
			continue
		}

		var nWords int = cc.ArgWords(t)
		var cReg int = ccC.CallArgRegStart(paramTypesC, cIdx)
		var cOff int = ccC.CallArgStackOff(paramTypesC, cIdx)
		var cRegWords int = 0
		if cReg >= 0 {
			cRegWords = nWords
			if cOff >= 0 {
				cRegWords = cc.NumGpArgRegs - cReg
			}
		}

		if t.IsByvalParam() {
			var slot int = gatherCursor
			gatherCursor = gatherCursor + nWords * w
			for wi := 0; wi < nWords; wi++ {
				if wi < cRegWords {
					emitFrameLoad(a, arm32.R4, stageOff + w * (cReg + wi))
				} else {
					emitBaseLoad(a, arm32.R4, arm32.SP, inBase + cOff + w * (wi - cRegWords), arm32.IP)
				}
				emitFrameStore(a, arm32.R4, slot + w * wi)
			}
			if nReg >= 0 {
				emitFrameAddr(a, argReg(nReg), slot)
			} else {
				emitFrameAddr(a, arm32.R4, slot)
				emitFrameStore(a, arm32.R4, nOff)
			}
			continue
		}

		var isScalar bool = !common.IsAggregateTyp(t)
		for wi := 0; wi < nWords; wi++ {
			if wi < cRegWords {
				emitFrameLoad(a, arm32.R4, stageOff + w * (cReg + wi))
			} else {
				emitBaseLoad(a, arm32.R4, arm32.SP, inBase + cOff + w * (wi - cRegWords), arm32.IP)
			}
			if isScalar {
				normalizeNarrowRegParamArm32(a, arm32.R4, t)
			}
			var iRegWords int = 0
			if nReg >= 0 {
				iRegWords = nWords
				if nOff >= 0 {
					iRegWords = cc.NumGpArgRegs - nReg
				}
			}
			if wi < iRegWords {
				arm32.Mov(a, arm32.COND_AL, false, argReg(nReg + wi), arm32.Reg(arm32.R4))
			} else {
				emitFrameStore(a, arm32.R4, nOff + w * (wi - iRegWords))
			}
		}
	}

	arm32.Bl(a, arm32.COND_AL, sym)

	if retKind == common.CRET_ADAPT_SRET {
		// The C ABI sret's the tuple but the body register-returned it: store the
		// register result into the caller's buffer (its pointer is the incoming R0,
		// staged at stageOff), then return the buffer pointer in R0 per AAPCS32.
		emitFrameLoad(a, arm32.R4, stageOff)
		storeMultiReturnTupleFieldsShimArm32(a, cc, f.MultiReturnType, arm32.R4, 0, arm32.IP)
		arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Reg(arm32.R4))
	} else if retKind == common.CRET_ADAPT_COERCE {
		// Both register-return, but the C ABI packs sub-word fields per word: store
		// the field-per-register result to the local slot, then reload clang's
		// coerced form into the GP return registers.
		storeMultiReturnTupleFieldsShimArm32(a, cc, f.MultiReturnType, arm32.SP, retSlotOff, arm32.IP)
		loadCoercedTupleReturn_arm32(a, f.MultiReturnType, retSlotOff)
	}

	if frameSz > 0 {
		emitSpAdjust(a, true, frameSz)
	}
	arm32.Pop(a, arm32.COND_AL, 0x8010) // {r4, pc}
}
