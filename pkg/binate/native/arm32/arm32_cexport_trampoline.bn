package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"
import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/binate/types/abi"

// cExportRetTrampolineKindArm32 classifies f's #[c_export] multi-value-return
// adaptation (callconv.CRET_ADAPT_*); NONE for a single / scalar / void return.
// COERCE_FROM_SRET arises only for a hard-float FP-HFA tuple whose struct / array
// fields exceed the 4 GP return words (e.g. (D3, float64)): any other tuple C
// register-returns is ≤ 4 bytes, within the internal 4-GP-word budget.
func cExportRetTrampolineKindArm32(f @ir.Func, cc callconv.CallConv) int {
	if len(f.Results) <= 1 || f.MultiReturnType == nil {
		return callconv.CRET_ADAPT_NONE
	}
	return cc.CExportMultiReturnAdaptKind(f.MultiReturnType)
}

// cExportNeedsTrampolineArm32 reports whether f's #[c_export] entry needs an
// adapter trampoline: a divergent multi-value RETURN.  Parameters never need one —
// AAPCS32 by value is Binate's convention too.
func cExportNeedsTrampolineArm32(f @ir.Func, cc callconv.CallConv) bool {
	return cExportRetTrampolineKindArm32(f, cc) != callconv.CRET_ADAPT_NONE
}

// loadCoercedTupleReturn_arm32 loads the memory image of an in-register multi-
// return tuple at [sp+baseOff] into the GP return registers r0.. in clang's C
// struct-return coerced form.  An arm32 in-register (C-register) tuple is ≤ 4
// bytes (the AAPCS32 sret cutoff), so this is one word into r0 — but the general
// per-word loop keeps it robust.  Pure GP: a ≤ 4-byte tuple cannot carry a float
// scalar field (a float is a whole 4-byte field and a 2+-field tuple then exceeds
// the cutoff → sret), so no VFP load is needed.
func loadCoercedTupleReturn_arm32(a @asm.Assembler, t @types.Type, baseOff int64) {
	var w int = wordBytes()
	var words int = (sizeArm32(t) + w - 1) / w
	for wi := 0; wi < words; wi++ {
		emitFrameLoad(a, argReg(wi), baseOff + cast(int64, w * wi))
	}
}

// loadHfaTupleReturn_arm32 loads the memory image of a hard-float FP-HFA multi-
// return tuple at [sp+baseOff] into its AAPCS-VFP return registers: n float32
// members into s0..s(n-1), n float64 members into d0..d(n-1).
func loadHfaTupleReturn_arm32(a @asm.Assembler, t @types.Type, baseOff int64) {
	n, memberBytes := abi.HfaClassify(t)
	for m := 0; m < n; m++ {
		if memberBytes == 8 {
			vfpLoadBaseHard(a, true, vfp.D0 + m, arm32.SP, baseOff + cast(int64, 8 * m), arm32.IP)
		} else {
			vfpLoadBaseHard(a, false, vfp.S0 + m, arm32.SP, baseOff + cast(int64, 4 * m), arm32.IP)
		}
	}
}

// emitCExportTrampolineArm32 emits the #[c_export] C entry for a function whose
// parameters and/or multi-value return need C-ABI adaptation.  It re-marshals each
// argument from its C-ABI position to `sym`'s internal position, calls `sym`, then
// adapts the return, and returns via `pop {r4, pc}`.
//
// Two register cursors — the C-facing one (paramTypesC, with a hidden sret pointer
// in R0 iff the C ABI sret's the result) and the internal one (paramTypesInt, the
// mangled body's) — disagree only when the C ABI sret's a tuple the internal
// convention register-returns: the C args are then shifted one GP register down
// (R0 holds the C sret buffer), or — COERCE_FROM_SRET — C register-returns a tuple
// the internal convention sret's: the internal args then sit one GP register up, R0
// carrying a local buffer for the body to write.  `shift` is that difference; 0
// whenever the two conventions agree.  AAPCS32 may split an aggregate across r0-r3
// and the stack, so each word is placed by its own register-vs-stack test on both
// sides.  Register writes never clobber a live source: r0-r3 are staged first, each
// argument's long stack run is then copied with a loop before any register is placed
// (emitCExportStackRunsArm32), and the per-word moves read only from that staging or the
// incoming stack.  A native caller enters at `sym`.
func emitCExportTrampolineArm32(a @asm.Assembler, rm @common.RegMap, f @ir.Func,
		sym *[]readonly char) {
	var cc callconv.CallConv = rm.CC
	var w int = wordBytes()

	// The internal (sret-vs-register) return shape comes from f directly, not a
	// planned frame's SretSlotOff — the __c_entry thunk reuses this trampoline with
	// a bare RegMap (no PlanFrame).  For a #[c_export] entry the two agree: PlanFrame
	// sets SretSlotOff >= 0 from exactly this predicate.
	var intSret bool = cc.FuncReturnsViaInternalSret(f)
	var isMulti bool = len(f.Results) > 1 && f.MultiReturnType != nil
	var retKind int = callconv.CRET_ADAPT_NONE
	var cSret bool = intSret
	if isMulti {
		retKind = cc.CExportMultiReturnAdaptKind(f.MultiReturnType)
		cSret = callconv.CMultiReturnTupleNeedsSret(f.MultiReturnType)
	}
	var intPfx int = 0
	if intSret {
		intPfx = 1
	}
	var cPfx int = 0
	if cSret {
		cPfx = 1
	}
	var shift int = cPfx - intPfx
	var paramTypesInt @[]@types.Type = make_slice(@types.Type, len(f.Params) + intPfx)
	if intSret {
		paramTypesInt[0] = types.MakePointerType(types.TypUint8())
	}
	for pi := 0; pi < len(f.Params); pi++ {
		paramTypesInt[intPfx + pi] = f.Params[pi].Typ
	}
	var paramTypesC @[]@types.Type = make_slice(@types.Type, len(f.Params) + cPfx)
	if cSret {
		paramTypesC[0] = types.MakePointerType(types.TypUint8())
	}
	for pi := 0; pi < len(f.Params); pi++ {
		paramTypesC[cPfx + pi] = f.Params[pi].Typ
	}

	// Frame (below the {r4,lr} save):
	//   [sp+0 .. outBytes)              sym's outgoing stack args
	//   [sp+stageOff .. +NumGpArgRegs*w) staging for the incoming GP arg regs r0-r3
	//   [sp+retSlotOff .. +retSlotBytes) the repack slot (COERCE), or the body's sret
	//                                    buffer (COERCE_FROM_SRET) — up to a 32-byte
	//                                    FP-HFA tuple
	var outBytes int64 = cc.CallStackBytes(paramTypesInt)
	var stageOff int64 = outBytes
	var retSlotOff int64 = stageOff + cast(int64, cc.NumGpArgRegs * w)
	var retSlotBytes int = 8
	var repacks bool = retKind == callconv.CRET_ADAPT_COERCE ||
			retKind == callconv.CRET_ADAPT_COERCE_FROM_SRET
	if repacks && sizeArm32(f.MultiReturnType) > retSlotBytes {
		retSlotBytes = (sizeArm32(f.MultiReturnType) + 7) / 8 * 8
	}
	var frameSz int64 = alignFrameArm32(cc, retSlotOff + cast(int64, retSlotBytes))
	var savedBytes int64 = 8 // {r4, lr}
	var inBase int64 = frameSz + savedBytes
	// The trampoline reads its caller's stack arguments right above its own frame, so the
	// two must fit the address space together.
	if !common.CheckShimFrameFits(a, inBase + cc.CallStackBytes(paramTypesC), f.Name) { return }

	arm32.Push(a, arm32.COND_AL, 0x4010) // {r4, lr}
	if frameSz > 0 {
		emitSpAdjust(a, false, wordArm32(frameSz))
	}
	for r := 0; r < cc.NumGpArgRegs; r++ {
		emitFrameStore(a, argReg(r), stageOff + cast(int64, w * r))
	}
	emitCExportStackRunsArm32(a, cc, paramTypesInt, paramTypesC, shift, intSret && !cSret, inBase)

	for i := 0; i < len(paramTypesInt); i++ {
		var t @types.Type = paramTypesInt[i]
		var nReg int = cc.CallArgRegStart(paramTypesInt, i)
		var nOff int64 = cc.CallArgStackOff(paramTypesInt, i)
		var cIdx int = i + shift

		if intSret && !cSret && i == 0 {
			// COERCE_FROM_SRET: the internal sret pointer (R0) is the local buffer the
			// entry reloads clang's form from; C passed no sret pointer.
			emitAddImm(a, arm32.R0, arm32.SP, wordArm32(retSlotOff), arm32.IP)
			continue
		}
		if abi.Arm32HardFloat() && (callconv.IsFloatScalarTyp(t) || isVfpHfaArm32(cc, t)) {
			// A hard-float scalar — or an HFA (cc.HfaAggregates) — rides VFP registers,
			// unshifted by a GP aggregate or the sret pointer: in registers it is already
			// where sym expects it.  One on the stack (VFP bank exhausted) is copied by
			// word.  Soft-float falls through to the GP path (a float is a GP word there).
			if nOff >= 0 {
				var cOff int64 = cc.CallArgStackOff(paramTypesC, cIdx)
				var fw int = ccArgWordsArm32(cc, t)
				for wi := 0; wi < fw; wi++ {
					emitBaseLoad(a, arm32.R4, arm32.SP, inBase + cOff + cast(int64, w * wi), arm32.IP)
					emitFrameStore(a, arm32.R4, nOff + cast(int64, w * wi))
				}
			}
			continue
		}

		var nWords int = ccArgWordsArm32(cc, t)
		var cReg int = cc.CallArgRegStart(paramTypesC, cIdx)
		var cOff int64 = cc.CallArgStackOff(paramTypesC, cIdx)
		var cRegWords int = gpRegWordsArm32(cc, cReg, cOff, nWords)
		var iRegWords int = gpRegWordsArm32(cc, nReg, nOff, nWords)
		// The words past both register parts, a long run of them, were copied by the
		// pre-pass (emitCExportStackRunsArm32).
		var stop int = nWords
		k0, isLoop := cexportStackRunArm32(cc, t, nWords, cRegWords, iRegWords)
		if isLoop { stop = k0 }

		var isScalar bool = !callconv.IsAggregateTyp(t)
		for wi := 0; wi < stop; wi++ {
			if wi < cRegWords {
				emitFrameLoad(a, arm32.R4, stageOff + cast(int64, w * (cReg + wi)))
			} else {
				emitBaseLoad(a, arm32.R4, arm32.SP, inBase + cOff + cast(int64, w * (wi - cRegWords)), arm32.IP)
			}
			if isScalar {
				normalizeNarrowRegParamArm32(a, arm32.R4, t)
			}
			if wi < iRegWords {
				arm32.Mov(a, arm32.COND_AL, false, argReg(nReg + wi), arm32.Reg(arm32.R4))
			} else {
				emitFrameStore(a, arm32.R4, nOff + cast(int64, w * (wi - iRegWords)))
			}
		}
	}

	arm32.Bl(a, arm32.COND_AL, sym)

	if retKind == callconv.CRET_ADAPT_SRET {
		// The C ABI sret's the tuple but the body register-returned it: store the
		// register result into the caller's buffer (its pointer is the incoming R0,
		// staged at stageOff), then return the buffer pointer in R0 per AAPCS32.
		emitFrameLoad(a, arm32.R4, stageOff)
		storeMultiReturnTupleFieldsShimArm32(a, cc, f.MultiReturnType, arm32.R4, 0, arm32.IP)
		arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Reg(arm32.R4))
	} else if retKind == callconv.CRET_ADAPT_COERCE {
		// Both register-return, but placed differently (sub-word fields the C ABI
		// packs per word, or an FP-HFA tuple's struct / array field the internal
		// convention returns in GP): store the field-per-register result to the local
		// slot, then reload clang's form — VFP registers for an FP-HFA, else GP.
		storeMultiReturnTupleFieldsShimArm32(a, cc, f.MultiReturnType, arm32.SP, retSlotOff, arm32.IP)
		if callconv.CMultiReturnTupleReturnsHfaInFpRegs(f.MultiReturnType) {
			loadHfaTupleReturn_arm32(a, f.MultiReturnType, retSlotOff)
		} else {
			loadCoercedTupleReturn_arm32(a, f.MultiReturnType, retSlotOff)
		}
	} else if retKind == callconv.CRET_ADAPT_COERCE_FROM_SRET {
		// The body wrote the tuple into the local buffer: reload the FP-HFA members.
		loadHfaTupleReturn_arm32(a, f.MultiReturnType, retSlotOff)
	}

	if frameSz > 0 {
		emitSpAdjust(a, true, wordArm32(frameSz))
	}
	arm32.Pop(a, arm32.COND_AL, 0x8010) // {r4, pc}
}

// gpRegWordsArm32 returns how many of an argument's nWords travel in GP registers, given
// its first register reg and stack offset off: none when it has no register, all when it
// has no stack part, else the registers left from reg (AAPCS32 splits it there).
func gpRegWordsArm32(cc callconv.CallConv, reg int, off int64, nWords int) int {
	if reg < 0 { return 0 }
	if off < 0 { return nWords }
	return cc.NumGpArgRegs - reg
}

// cexportStackRunArm32 returns the first word k0 of an nWords argument of type t that is
// on the stack on both sides of the trampoline -- past its C register words cRegWords and
// its internal ones iRegWords -- and whether the run from k0 is an aggregate's, long
// enough to be copied with a loop (aggCopyIsLoop) rather than word by word.
func cexportStackRunArm32(cc callconv.CallConv, t @types.Type, nWords int, cRegWords int,
		iRegWords int) (int, bool) {
	var k0 int = cRegWords
	if iRegWords > k0 { k0 = iRegWords }
	return k0, callconv.IsAggregateTyp(t) && aggCopyIsLoop(stackRunBytesArm32(cc, nWords - k0), false)
}

// stackRunBytesArm32 returns the bytes of n argument words as int: an argument of the
// largest type's size rounds up to 2^31 bytes of words, so it is formed in int64, and
// narrows fail-loud past a 32-bit host's int.
func stackRunBytesArm32(cc callconv.CallConv, n int) int {
	return types.HostInt(cast(int64, cc.WordBytes) * cast(int64, n))
}

// emitCExportStackRunsArm32 copies, before the trampoline writes any argument register,
// each GP argument's long stack run (cexportStackRunArm32) from the C caller's stack
// arguments, at inBase above SP, to sym's outgoing ones, with a loop
// (emitShimCopyLoopArm32): R2 (the source) and R3 (the destination) as cursors, through
// R4 / LR, counted in IP.  All are free here: r0-r3 are staged, R4 and LR are saved, and
// nothing is placed yet.  A large by-value aggregate is otherwise one load and store a
// word -- 2^29 of each for one of 2 GiB.  skipFirst marks the internal sret
// pointer, which C does not pass (paramTypesInt[0] is no argument of C's); shift is the
// C index of internal argument i, less i.
func emitCExportStackRunsArm32(a @asm.Assembler, cc callconv.CallConv, paramTypesInt @[]@types.Type,
		paramTypesC @[]@types.Type, shift int, skipFirst bool, inBase int64) {
	var w int = cc.WordBytes
	for i := 0; i < len(paramTypesInt); i++ {
		var t @types.Type = paramTypesInt[i]
		if skipFirst && i == 0 { continue }
		if abi.Arm32HardFloat() && (callconv.IsFloatScalarTyp(t) || isVfpHfaArm32(cc, t)) { continue }
		var nWords int = ccArgWordsArm32(cc, t)
		var nOff int64 = cc.CallArgStackOff(paramTypesInt, i)
		var cOff int64 = cc.CallArgStackOff(paramTypesC, i + shift)
		var cRegWords int = gpRegWordsArm32(cc, cc.CallArgRegStart(paramTypesC, i + shift), cOff, nWords)
		var iRegWords int = gpRegWordsArm32(cc, cc.CallArgRegStart(paramTypesInt, i), nOff, nWords)
		k0, isLoop := cexportStackRunArm32(cc, t, nWords, cRegWords, iRegWords)
		if !isLoop { continue }
		emitFrameAddr(a, arm32.R2, inBase + cOff + cast(int64, w * (k0 - cRegWords)))
		emitFrameAddr(a, arm32.R3, nOff + cast(int64, w * (k0 - iRegWords)))
		emitShimCopyLoopArm32(a, arm32.R3, arm32.R2, stackRunBytesArm32(cc, nWords - k0), false)
	}
}
