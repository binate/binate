package "pkg/binate/native/arm32"

import "pkg/binate/irbuild"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for the #[c_export] entry of a function taking a >16-byte by-value aggregate
// (arm32_cexport_trampoline.bn).  asm.New / fail / symFor / symPrefixed / emitFunc
// live in the arm32 package.

// A #[c_export] function whose only adaptation-worthy feature is a >16-byte by-value
// aggregate param needs no trampoline: AAPCS32 passes the aggregate by value split
// across r0-r3 + the stack for C and Binate alike, so the C name aliases the mangled
// entry itself.  End-to-end correctness is covered by e2e/ffi-export.sh under qemu.
func TestEmitFuncCExportBigAggParamAliasArm32() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Name = "f"
		fields[i].Type = types.TypInt64()
	}
	var big @types.Type = types.MakeStructType("Big", fields) // 24B => >16, byval
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].ID = 1
	params[0].Name = "x"
	params[0].Typ = big
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.Take", params, noR)
	var blk @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(blk, noArgs)
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr("ffi_big"))
	f.CExportNames = names
	var strings @[]ir.StringConst
	emitFunc(a, "main", f, strings)

	var mangledIdx int = a.LookupSymbol(symFor("main", "main.Take"))
	var aliasIdx int = a.LookupSymbol(symPrefixed("ffi_big"))
	if mangledIdx < 0 || aliasIdx < 0 {
		return fail("big-agg c_export: alias or mangled symbol missing")
	}
	if a.Symbols[aliasIdx].Offset != a.Symbols[mangledIdx].Offset {
		return fail(
				"a >16-byte by-value param needs no trampoline: the C name must alias the "
						"mangled entry")
	}
	return ""
}

// A #[c_export] `f(Big, float32) (int, int)` — a >16-byte aggregate followed by a
// float, with a two-int result C returns through a hidden sret pointer in r0 but
// Binate in r0:r1 — needs a trampoline that shifts every C argument one GP register
// back, and exercises the float-ABI split.  On SOFT-float the float rides the GP
// registers / stack after the aggregate, at a different stack word C-side (the sret
// pointer and the aggregate's even-register pad shift it), so the trampoline MUST move
// it.  On HARD-float it rides a VFP register (unshifted by the GP arguments) and is
// left untouched.  So the soft-float trampoline is strictly LONGER.  Regression for a
// missing `types.Arm32HardFloat()` guard on the float branch, which made soft-float
// wrongly take the "leave it in VFP" path and skip the float.
func TestEmitFuncCExportBigAggTrampolineArm32SoftFloatMarshal() testing.TestResult {
	var softLen int = bigFloatTrampolineLenArm32(types.FLOAT_ABI_SOFT)
	var hardLen int = bigFloatTrampolineLenArm32(types.FLOAT_ABI_HARD)
	if softLen <= hardLen {
		return fail(
				"soft-float trampoline must marshal a GP float after a >16 aggregate — "
						"expected longer than the hard-float trampoline, which leaves it in VFP")
	}
	return ""
}

// bigFloatTrampolineLenArm32 emits the #[c_export] trampoline for `f(Big, float32)
// (int, int)` under the given arm32 float ABI and returns the trampoline's byte length
// (the mangled entry's offset, since the alias/trampoline start at offset 0).
func bigFloatTrampolineLenArm32(abi int) int {
	var old types.TargetInfo = types.GetTarget()
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
	types.SetArch(types.ARCH_ARM32)
	types.SetFloatABI(abi)

	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Name = "f"
		fields[i].Type = types.TypInt64()
	}
	var big @types.Type = types.MakeStructType("Big", fields)
	var params @[]@ir.Param = make_slice(@ir.Param, 2)
	params[0] = make(ir.Param)
	params[0].ID = 1
	params[0].Name = "x"
	params[0].Typ = big
	params[1] = make(ir.Param)
	params[1].ID = 2
	params[1].Name = "f"
	params[1].Typ = types.TypFloat32()
	var rs @[]@types.Type = make_slice(@types.Type, 2)
	rs[0] = types.TypInt()
	rs[1] = types.TypInt()
	var fn @ir.Func = ir.NewFunc("", "main.Take", params, rs)
	var tup @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		tup[i] = make(types.Field)
		tup[i].Type = types.TypInt()
	}
	fn.MultiReturnType = types.MakeStructType("", tup)
	var blk @ir.Block = ir.AddBlock(fn, "entry")
	var vals @[]@ir.Instr = make_slice(@ir.Instr, 2)
	vals[0] = irbuild.EmitConstInt(blk, 1, types.TypInt())
	vals[1] = irbuild.EmitConstInt(blk, 2, types.TypInt())
	irbuild.EmitReturn(blk, vals)
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr("ffi_bigfloat"))
	fn.CExportNames = names
	var strings @[]ir.StringConst
	emitFunc(a, "main", fn, strings)

	var idx int = a.LookupSymbol(symFor("main", "main.Take"))
	var mangledOff int = 0
	if idx >= 0 {
		mangledOff = cast(int, a.Symbols[idx].Offset)
	}
	types.SetTarget(old)
	return mangledOff
}
