package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Test for the #[c_export] >16-byte by-value aggregate param adapter trampoline
// (arm32_cexport_trampoline.bn).  asm.New / fail / symFor / symPrefixed / emitFunc
// live in the arm32 package.

// A #[c_export] function with a >16-byte by-value aggregate param gets an adapter
// TRAMPOLINE, not the in-place narrow-register prefix: AAPCS32 passes the aggregate
// by value split across r0-r3 + the stack, but the mangled entry expects a pointer
// in a register, so the args must be re-marshaled and the mangled entry CALLed
// (`bl`).  A byte-exact check would be brittle (many instructions), so pin the
// structural shape: the alias precedes the mangled entry, and the trampoline ends
// in `pop {r4, pc}` — the frame-based call adapter, unlike the branch-based narrow
// prefix.  End-to-end correctness is covered by e2e/ffi-export.sh under qemu.
func TestEmitFuncCExportBigAggTrampolineArm32() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Name = "f"
		fields[i].Type = types.TypInt64()
	}
	var big @types.Type = types.MakeStructType("Big", fields) // 24B => >16, byval
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].ID = 1
	params[0].Name = "x"
	params[0].Typ = big
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.Take", params, noR)
	var blk @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	blk.EmitReturn(noArgs)
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr("ffi_big"))
	f.CExportNames = names
	var strings @[]ir.StringConst
	emitFunc(a, "main", f, strings)

	var mangledIdx int = a.LookupSymbol(symFor("main", "main.Take"))
	var aliasIdx int = a.LookupSymbol(symPrefixed("ffi_big"))
	if mangledIdx < 0 || aliasIdx < 0 {
		return fail("big-agg c_export: alias or mangled symbol missing")
	}
	var aliasOff int = cast(int, a.Symbols[aliasIdx].Offset)
	var mangledOff int = cast(int, a.Symbols[mangledIdx].Offset)
	if aliasOff >= mangledOff {
		return fail("big-agg c_export trampoline must precede the mangled entry")
	}
	// The trampoline ends in `pop {r4, pc}` (a frame-based call adapter), not a `b`
	// branch (the narrow prefix) — assemble a reference word and match the tail.
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Pop(ref, arm32.COND_AL, 0x8010)
	var refLen int = ref.Sections[0].Len
	var refData @[]uint8 = ref.Sections[0].Data
	var gd @[]uint8 = a.Sections[0].Data
	if mangledOff < refLen {
		return fail("big-agg c_export trampoline too short")
	}
	for i := 0; i < refLen; i++ {
		if gd[mangledOff - refLen + i] != refData[i] {
			return fail("big-agg c_export trampoline must end in `pop {r4, pc}`")
		}
	}
	return ""
}

// A #[c_export] `f(Big, float32)` — a >16-byte aggregate followed by a float —
// exercises the float-ABI split.  On SOFT-float the float rides the GP registers:
// after the aggregate (a pointer in r0) it lands in r1, and C-side it is a stack
// arg, so the trampoline MUST marshal it into r1.  On HARD-float it rides a VFP
// register (unshifted by the GP aggregate) and is left untouched.  So the
// soft-float trampoline is strictly LONGER (the extra GP marshal).  Regression for
// a missing `types.Arm32HardFloat()` guard on the float branch, which made
// soft-float wrongly take the "leave it in VFP" path and skip the float, leaving
// garbage in r1.
func TestEmitFuncCExportBigAggTrampolineArm32SoftFloatMarshal() testing.TestResult {
	var softLen int = bigFloatTrampolineLenArm32(types.FLOAT_ABI_SOFT)
	var hardLen int = bigFloatTrampolineLenArm32(types.FLOAT_ABI_HARD)
	if softLen <= hardLen {
		return fail(
				"soft-float trampoline must marshal a GP float after a >16 aggregate — "
						"expected longer than the hard-float trampoline, which leaves it in VFP")
	}
	return ""
}

// bigFloatTrampolineLenArm32 emits the #[c_export] trampoline for `f(Big, float32)`
// under the given arm32 float ABI and returns the trampoline's byte length (the
// mangled entry's offset, since the alias/trampoline start at offset 0).
func bigFloatTrampolineLenArm32(abi int) int {
	var old types.TargetInfo = types.GetTarget()
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
	types.SetArch(types.ARCH_ARM32)
	types.SetFloatABI(abi)

	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Name = "f"
		fields[i].Type = types.TypInt64()
	}
	var big @types.Type = types.MakeStructType("Big", fields)
	var params @[]@ir.Param = make_slice(@ir.Param, 2)
	params[0] = make(ir.Param)
	params[0].ID = 1
	params[0].Name = "x"
	params[0].Typ = big
	params[1] = make(ir.Param)
	params[1].ID = 2
	params[1].Name = "f"
	params[1].Typ = types.TypFloat32()
	var noR @[]@types.Type
	var fn @ir.Func = ir.NewFunc("", "main.Take", params, noR)
	var blk @ir.Block = ir.AddBlock(fn, "entry")
	var noArgs @[]@ir.Instr
	blk.EmitReturn(noArgs)
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr("ffi_bigfloat"))
	fn.CExportNames = names
	var strings @[]ir.StringConst
	emitFunc(a, "main", fn, strings)

	var idx int = a.LookupSymbol(symFor("main", "main.Take"))
	var mangledOff int = 0
	if idx >= 0 {
		mangledOff = cast(int, a.Symbols[idx].Offset)
	}
	types.SetTarget(old)
	return mangledOff
}
