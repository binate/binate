package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit test for the arm32 OP_C_GLOBAL lowering (arm32_dispatch.bn, plan §5a).
//
// __c_global yields the ADDRESS of an external C global as a raw *T.  arm32
// native is the non-PIE / static (baremetal) link, so the address is
// materialized with the absolute MOVW/MOVT-ABS reloc pair (emitSymAddr) against
// the VERBATIM external symbol — no GOT, no Binate mangling.  The symbol is
// registered global so the object writer emits R_ARM_MOVW_ABS_NC /
// R_ARM_MOVT_ABS relocations the linker resolves against whatever object
// defines the C global.
func TestCGlobalEmitsAbsSymAddr() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_C_GLOBAL
	ins.StrVal = "environ"
	// Result is *T (raw pointer, 32-bit on arm32); TypeArg is the pointee T.
	ins.TypeArg = types.MakePointerType(types.TypUint8())
	ins.Typ = types.MakePointerType(ins.TypeArg)
	var noStrs @[]ir.StringConst
	emitInstr(a, "main", "caller", rm, noStrs, ins)
	if a.HasError {
		return fail("__c_global must not error on arm32 (absolute addressing)")
	}
	// MOVW + MOVT = two 4-byte instructions.
	if bytesWritten(a) != 8 {
		return fail("__c_global address is a MOVW+MOVT-ABS pair (8 bytes)")
	}
	// The verbatim external symbol (no `bn_` mangling) must be registered so its
	// MOVW_ABS_NC / MOVT_ABS relocations resolve at link time.
	var si int = a.LookupSymbol("environ")
	if si < 0 {
		return fail("__c_global must register the verbatim external symbol")
	}
	// Load-bearing: it must be an UNDEFINED external reference (Section == -1),
	// so the linker binds it to the REAL C global — not a bogus local definition
	// that would shadow it with wrong / zero-filled storage.
	if a.Symbols[si].Section != -1 {
		return fail(
				"__c_global must register environ as an UNDEFINED external "
						"(Section == -1), not a local definition")
	}
	return ""
}
