package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Native arm32 emission for the per-(literal, capture-shape) shim backing a
// CAPTURING function literal or a METHOD VALUE.  Split from arm32_funcvalue.bn
// to keep each file under the hygiene length cap.
//
// A method value rides this path FREE: gen_method_value.bn marks the wrapper
// IsClosure=true with one capture (the bound receiver), so lookupClosureFuncArm32
// matches it and the same shim serves it — no method-value-specific code, exactly
// as on aarch64 / x64.
//
// The shim is entered under the uniform all-int dispatch ABI `<ret>(data, user
// args…)` — the capture-struct pointer in R0, user args in R1..  The underlying
// lifted function's REAL ABI PREPENDS the captures as leading params
// (`underlying(captures…, user_args…)`), unpacked field-by-field into the leading
// GP arg registers.  So the fast (register-only) shim:
//
//   1. UP-shifts the incoming user args (R1..) into their post-capture outgoing
//      slots R(captureWords).. — via emitShimArgMarshalArm32 with
//      gpDestBase = captureWords and forceStage (an UP-shift needs staging for
//      clobber-safety; see that function's forceStage note).
//   2. Loads each capture word from [R0 + FieldOffset] into R0..R(captureWords-1),
//      RIGHT-TO-LEFT (capture i=0, at offset 0, loads LAST so the R0 base survives
//      until the final load).
//   3. Tail-branches (B) to the underlying.
//
// The SCALAR / void-return shape is handled across two paths: the fast
// (register-only) path above, and — when captures + users exceed R0..R3, or a
// capture takes an AAPCS §6.5 C.3 even-pair pad — the framed-BL stack-spill shim
// (emitClosureShimSpillArm32 in arm32_closure_shim_spill.bn, P4-d Phase B).  An
// AGGREGATE result (Phase C.1 big-sret / C.2 small-pack) and a MULTI-RETURN result
// (Phase C.3 — big-sret via the C.1 emitter, small field-per-register via the C.2 pack
// framing) are handled by the aggregate / multiret dispatch below.  A float part rides
// the GP path like its same-width integer (soft-float — P5.3): a float capture is loaded
// by-word like an int capture, a float param rides the shared marshal (isPair64Typ), a
// float scalar / aggregate-field result rides the GP tail-branch / sret / pack (bytes).
// The ONLY shape that routes to a CLEAN a.SetError (never a silent miscompile) is an
// indirect-large (>16-byte) aggregate capture (no pointer-pass capture-load path on
// either arm32 path).  Mirrors aarch64_closure_shim.bn's emitClosureShim, with AAPCS32's
// 4-GP-arg-reg budget and IP (R12) as the intra-shim scratch.

// funcValueDtorHandleSymArm32 returns the closure-struct dtor's HANDLE symbol
// (`__handle.<dtor>`) for a capturing @func whose closure struct needs
// destruction — marking it global so its relocation resolves — else an empty
// slice (the vtable's dtor slot is then a null pointer).  Mirrors aarch64's
// funcValueDtorHandleSym.
//
// Slot 0 carries the dtor's HANDLE pointer, not a raw fn pointer, because
// OP_FUNC_VALUE_DTOR -> rt.ZeroRefDestroy dispatches it as
// `handle.vtable.call(handle.data, ptr)` (an OP_CALL_HANDLE) — the same
// convention the LLVM / aarch64 / x64 backends use.  The referenced
// `__handle.<dtor>` triple is already emitted by emitFuncValueVtables' IsLinkOnce
// pre-pass (collectFuncValueRefs adds every local IsLinkOnce func — closure-struct
// dtors among them — to `seen`), so handleSymFor(pkgName, f.ClosureStructDtorName)
// names an already-defined symbol — no new global, no dangling reference.
//
// A NULL dtor slot on a managed capturing @func would silently LEAK its capture
// block: OP_FUNC_VALUE_DTOR loads vtable slot 0 -> rt.ZeroRefDestroy, which no-ops
// on a null slot, so the capture struct (and its RefInc'd managed captures) is
// never released.  This is why construction (the data-slot store, emitFuncValue)
// and this dtor emission must land together.
func funcValueDtorHandleSymArm32(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module,
		qname @[]char) @[]char {
	var f @ir.Func = lookupClosureFuncArm32(mod, qname)
	if f == nil || !f.IsManagedFuncValue || f.ClosureStruct == nil ||
			!f.ClosureStruct.NeedsDestruction() || len(f.ClosureStructDtorName) == 0 {
		var none @[]char
		return none
	}
	var h @[]char = handleSymFor(pkgName, f.ClosureStructDtorName)
	a.SetGlobal(h)
	return h
}

// emitClosureShimArm32 emits the per-(literal, capture-shape) shim for a
// capturing closure or method value.  The caller (emitFuncValueShims) has already
// defined the label and marked it weak; this writes the shim body for every result
// shape (scalar/void, big-sret / small-pack single aggregate, big / small multi-
// return), with float parts riding the GP path like their same-width integer
// (soft-float — P5.3), or fails LOUDLY on an indirect-large capture.
func emitClosureShimArm32(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type, f @ir.Func) {
	var cc common.CallConv = common.AAPCS32()
	// Under hard-float (AAPCS-VFP) a REGISTER-RESIDENT scalar float PARAM / scalar float
	// single-return rides VFP untouched (the shared GP marshal skips it —
	// hardFloatShimSkipArm32; non-float captures don't consume VFP, so the float param lands
	// in the same VFP slot the underlying reads — inc 3f b1b); a float nested in a single
	// aggregate (param, return, or capture) rides the float-agnostic GP path (inc 3f b2);
	// and a float leaf in a multi-return result is stored FP-aware / written through the
	// retbuf (inc 3f b3).  Still fail-loud: a scalar float CAPTURE (it lives in the closure
	// data block and the underlying takes it as a leading VFP param — needs a memory->VFP
	// load the GP-only capture load can't do, inc 3f b4), a scalar float param with an
	// aggregate/multi-return result (routes to the GP-only pack arg-marshal — inc 3f b4),
	// and a VFP-argument-bank-spilling scalar float param.  Inert on soft-float, where a
	// float rides GP like its same-width integer (see the note below).
	if types.Arm32HardFloat() && closureShimUnhandledFloatB1bArm32(cc, fvTyp, f) {
		a.SetError(
				"native arm32 hard-float: scalar float capture / scalar-float-param-with-"
						"aggregate-or-multi-return-result / VFP-bank-spill through closure "
						"func value not yet implemented (inc 3f b4)")
		return
	}
	// On soft-float a float capture / param / return needs no float-specific handling:
	// a float scalar rides GP like its same-width integer (float32 = one word, float64
	// = an even-aligned register pair), so a float PARAM rides the shared marshal
	// (emitShimArgMarshalArm32, which handles isPair64Typ — P5.3 pt 1), a float CAPTURE
	// is loaded by-word like an int capture (emitClosureCaptureRegLoadArm32, with a
	// float64's even-pair pad routing it to the spill shim via closureCaptureNeedsPad),
	// and a float RESULT (scalar or a float FIELD of an aggregate / tuple) rides the
	// GP-only tail-branch / sret / pack — a soft-float aggregate is just bytes, so the
	// float fields need no FP path.
	var argTypes @[]@types.Type = buildShimArgTypesArm32(fvTyp, f)
	// An indirect-large (>16-byte) aggregate capture rides ONE by-address pointer word
	// (EffectiveArgWords 1), not its ArgWords value-words, and NEITHER the fast nor the
	// spill capture-load path has a pointer-pass (ADD R0, R0, #ofs) branch for it — so
	// it fails LOUDLY BY INTENT on both paths (the nit-fix explicit guard).  Checked up
	// front, before routing, since it is out of scope for Phase B too.
	if closureHasIndirectLargeCaptureArm32(cc, f) {
		a.SetError(
				"native arm32: closure func value with an indirect-large "
						"(>16-byte) aggregate capture not implemented (P4-d Phase C)")
		return
	}
	// A BIG single-aggregate result (SizeOf > InternalSretBytes = 4) rides the R0-retbuf
	// sret convention (Phase C.1): route it to the aggregate emitter, which reuses the
	// non-closure sret machinery with a capture-prefix classify.
	if shimReturnIsBigSretAggregateArm32(cc, fvTyp) {
		emitClosureShimSretArm32(a, fnLabel, fvTyp, f, cc, argTypes)
		return
	}
	// A SMALL single-aggregate result (SizeOf <= InternalSretBytes = 4) rides the PACK
	// convention (Phase C.2): the underlying returns the aggregate BY VALUE in R0 (no
	// retbuf arg), so the shim runs a framed BL, saves the retbuf, and stores the
	// returned R0 word through it.  Route it to the pack emitter, which reuses the
	// non-closure spill machinery with a CAPTURE (no-sret-prefix) classify.
	if shimReturnIsSmallPackAggregateArm32(cc, fvTyp) {
		emitClosureShimPackArm32(a, fnLabel, fvTyp, f, cc, argTypes)
		return
	}
	// A MULTI-RETURN tuple result (Phase C.3, the last Phase-C sub-shape) composes the
	// C.1 + C.2 machinery: a BIG tuple (gpWords > 4) rides the C.1 sret emitter (retbuf
	// stays in R0, the underlying writes each field through it) and a SMALL tuple
	// (gpWords <= 4) rides the C.2 pack framing with a field-per-register post-BL store —
	// split by isBigMultiReturnArm32, the same word-count rule the callee and the caller
	// use.  With this cut ALL closure/method-value result shapes are handled (a soft-float
	// float part rides the GP path like its same-width integer); only an indirect-large
	// capture remains fail-loud (rejected above), so no shape silently miscompiles.
	if shimReturnIsNonScalarArm32(fvTyp) {
		emitClosureShimMultiRetArm32(a, fnLabel, fvTyp, f, cc, argTypes)
		return
	}
	// Any arg (capture or user) that spills to the outgoing stack — or a capture that
	// takes an AAPCS §6.5 C.3 even-pair pad, which shifts the user-arg base off the
	// dense captureWords the fast path assumes — needs the framed-BL stack-spill shim
	// (emitClosureShimSpillArm32).  It classifies over the FULL captures++users list at
	// gpDestBase = NumCaptureParams, so it places every capture and user arg at its
	// authoritative classifier position (pads / SPLITs and all).  On AAPCS32's 4 GP arg
	// regs this triggers far sooner than on aa64's 8.
	if shimClosureNeedsSpillArm32(cc, argTypes) || closureCaptureNeedsPadArm32(cc, f, argTypes) ||
			closureCaptureNeedsBytewiseArm32(f) {
		emitClosureShimSpillArm32(a, fnLabel, fvTyp, f, cc, argTypes)
		return
	}
	// captureWords is the dense GP-word footprint of the captures (Σ ArgWords) — valid
	// here because the indirect-large-capture and capture-even-pair-pad cases are
	// already routed away above (the pad check confirmed each capture's authoritative
	// classifier position equals its running dense cursor).  The user args start at
	// gpDestBase = captureWords.
	var captureWords int = 0
	for i := 0; i < f.NumCaptureParams; i++ {
		captureWords = captureWords + cc.ArgWords(f.ClosureStruct.Fields[i].Type)
	}
	// Classify the user args over the FULL captures++users register parity via
	// gpDestBase = captureWords: shimOutRegs applies the same even-pair pads the
	// callee does, keyed on the ABSOLUTE (post-capture) register index, and
	// fails LOUDLY on an unmodeled user-arg shape.
	var nOut int = shimOutRegs(a, cc, fvTyp, captureWords)
	if nOut < 0 { return }
	if !shimArgsFitRegisters(cc, fvTyp, 1, captureWords, nOut) {
		// The user args (with the prepended captures) exceed R0..R3 — route to the
		// framed-BL spill shim rather than marshal into a nonexistent register.
		emitClosureShimSpillArm32(a, fnLabel, fvTyp, f, cc, argTypes)
		return
	}
	// Step 1: UP-shift the user args (incoming R1.., srcPrefix 1 drops the data word)
	// to their post-capture outgoing slots R(captureWords)..  forceStage makes this
	// clobber-safe for the UP-shift (gpDestBase = captureWords > srcPrefix = 1).  The
	// balanced SP scratch is freed before the capture loads, and the marshal never
	// touches R0 (gpDestBase >= 1) — so R0 stays live as the capture base.
	emitShimArgMarshalArm32(a, cc, fvTyp, 1, captureWords, true)
	// Step 2: load each capture word from [R0 + FieldOffset] into R0..R(captureWords
	// -1), RIGHT-TO-LEFT (i=0 loads last so R0 stays a valid base until the final
	// load, whose destination may be R0 itself).
	emitClosureCaptureRegLoadArm32(a, cc, f, captureWords, arm32.R0, 0)
	// Step 3: tail-branch to the underlying.
	a.SetGlobal(fnLabel)
	arm32.B(a, arm32.COND_AL, fnLabel)
}

// typHasFloatLeafArm32 reports whether t contains a float scalar leaf anywhere —
// t itself is a float scalar, or (recursively) any struct field / array element
// is.  Peels type-alias / readonly / named wrappers via StripWrappers before
// inspecting the kind, matching the ABI-level view the layout / HFA code uses.
func typHasFloatLeafArm32(t @types.Type) bool {
	if t == nil { return false }
	if common.IsFloatScalarTyp(t) { return true }
	var s @types.Type = types.StripWrappers(t)
	if s == nil { return false }
	if s.Kind == types.TYP_STRUCT {
		for i := 0; i < len(s.Fields); i++ {
			if typHasFloatLeafArm32(s.Fields[i].Type) { return true }
		}
		return false
	}
	if s.Kind == types.TYP_ARRAY {
		return typHasFloatLeafArm32(s.Elem)
	}
	return false
}

// funcValueShimHasFloatArm32 reports whether a NON-closure func-value type carries
// any float leaf in a param or result (a scalar, or a float nested in an aggregate /
// multi-return tuple).  Used as a fast early-out by funcValueShimUnhandledFloatB1Arm32
// — a float-free type is trivially handled, so the detailed classification is skipped.
func funcValueShimHasFloatArm32(fvTyp @types.Type) bool {
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		if typHasFloatLeafArm32(fvTyp.Params[pi].Type) { return true }
	}
	for ri := 0; ri < len(fvTyp.Results); ri++ {
		if typHasFloatLeafArm32(fvTyp.Results[ri]) { return true }
	}
	return false
}

// shimReturnIsNonScalarArm32 reports whether the closure's result is an aggregate
// (any size) or a multi-return tuple — the shapes that ride a retbuf convention
// the Phase-A scalar/void tail-branch shim does not implement.  A single non-
// aggregate scalar / pointer (incl. a 64-bit register-pair int64 / uint64) or void
// is scalar/void.  Both single-aggregate sizes are routed away before this predicate
// runs (Phase C.1 shimReturnIsBigSretAggregateArm32, C.2
// shimReturnIsSmallPackAggregateArm32), so here it gates the MULTI-RETURN dispatch
// (Phase C.3 — emitClosureShimMultiRetArm32): the only remaining non-scalar shape once
// the single-aggregate sizes are excluded is a multi-return tuple (len(Results) > 1).
func shimReturnIsNonScalarArm32(fvTyp @types.Type) bool {
	if len(fvTyp.Results) > 1 { return true }
	if len(fvTyp.Results) == 1 && fvTyp.Results[0] != nil {
		// Gate on IsAggregateReturnTyp: a 0-byte single aggregate (`struct{}` /
		// `[0]T`) is void-like (no retbuf, no bytes), so it is NOT non-scalar — it
		// must fall through to the scalar/void tail-branch, matching the LLVM shim.
		// (The big-sret / small-pack single-aggregate sizes are already routed away
		// before this predicate runs; here it gates the multi-return dispatch, and a
		// single 0-byte aggregate is neither big/small pack nor multi-return.)
		return types.IsAggregateReturnTyp(fvTyp.Results[0])
	}
	return false
}

// shimReturnIsBigSretAggregateArm32 reports whether the closure's result is a SINGLE
// aggregate larger than InternalSretBytes (4) — the big-sret sub-shape Phase C.1
// implements (returned through the R0 retbuf).  A <=4-byte single aggregate (pack,
// C.2 — shimReturnIsSmallPackAggregateArm32) and a multi-return tuple (C.3) are
// excluded (the size gate rejects the pack, and len > 1 fails the single-result gate).
func shimReturnIsBigSretAggregateArm32(cc common.CallConv, fvTyp @types.Type) bool {
	if len(fvTyp.Results) != 1 || fvTyp.Results[0] == nil { return false }
	var rt @types.Type = fvTyp.Results[0]
	return common.IsAggregateTyp(rt) && rt.SizeOf() > cc.InternalSretBytes
}

// shimReturnIsSmallPackAggregateArm32 reports whether the closure's result is a SINGLE
// aggregate no larger than InternalSretBytes (4) — the pack sub-shape Phase C.2
// implements (the underlying returns it BY VALUE in R0; the shim stores that word
// through the retbuf).  A big single aggregate (sret, C.1 —
// shimReturnIsBigSretAggregateArm32) and a multi-return tuple (C.3) are excluded (the
// size gate rejects the big aggregate, and len > 1 fails the single-result gate).
func shimReturnIsSmallPackAggregateArm32(cc common.CallConv, fvTyp @types.Type) bool {
	if len(fvTyp.Results) != 1 || fvTyp.Results[0] == nil { return false }
	var rt @types.Type = fvTyp.Results[0]
	// Gate on IsAggregateReturnTyp so a 0-byte aggregate result (`struct{}` /
	// `[0]T`) is NOT a pack shape: it has no bytes to store through the retbuf and
	// the caller passes no retbuf for it (types.IsAggregateReturnTyp is false).  It
	// falls through the closure dispatch to the scalar/void tail-branch, matching
	// the LLVM shim (isAggregateReturn false) and the fixed call site.  For every
	// SizeOf >= 1 aggregate the two predicates agree, so this is a pure 0-byte
	// carve-out.
	return types.IsAggregateReturnTyp(rt) && rt.SizeOf() <= cc.InternalSretBytes
}

// buildShimArgTypesArm32 returns the type list for the OUTGOING call the shim
// performs: captures first (in ClosureStruct field order), then user args — the
// same shape the AAPCS32 classifier expects for a direct call to the underlying.
// Mirrors buildShimArgTypesAA64.
func buildShimArgTypesArm32(fvTyp @types.Type, f @ir.Func) @[]@types.Type {
	var argTypes @[]@types.Type
	for i := 0; i < f.NumCaptureParams; i++ {
		argTypes = slices.Append[@types.Type](argTypes, f.ClosureStruct.Fields[i].Type)
	}
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		argTypes = slices.Append[@types.Type](argTypes, fvTyp.Params[pi].Type)
	}
	return argTypes
}

// shimClosureNeedsSpillArm32 reports whether any arg in the outgoing captures++
// users call lands (partially or wholly) on the stack (CallArgStackOff >= 0).
// On AAPCS32's 4 GP arg regs this triggers far sooner than on aa64's 8; the
// framed-BL stack-spill shim is Phase B, so Phase A fails LOUDLY here.  Mirrors
// shimNeedsStackSpillAA64.
func shimClosureNeedsSpillArm32(cc common.CallConv, argTypes @[]@types.Type) bool {
	for i := 0; i < len(argTypes); i++ {
		if cc.CallArgStackOff(argTypes, i) >= 0 { return true }
	}
	return false
}

// closureHasIndirectLargeCaptureArm32 reports whether any capture is a >16-byte
// aggregate the AAPCS32 convention passes INDIRECTLY as one by-address pointer word
// (EffectiveArgWords 1, not its ArgWords value-words).  Neither the fast nor the
// spill capture-load path has a pointer-pass branch for it (unlike aa64's ADD-
// pointer form), so it fails LOUDLY on both — checked up front, before routing.
func closureHasIndirectLargeCaptureArm32(cc common.CallConv, f @ir.Func) bool {
	for i := 0; i < f.NumCaptureParams; i++ {
		if isIndirectLargeArm32(cc, f.ClosureStruct.Fields[i].Type) { return true }
	}
	return false
}

// closureCaptureNeedsBytewiseArm32 reports whether any capture is a SUB-word-aligned
// aggregate (aggNeedsBytewiseArm32) — the closure struct packs it at a possibly
// non-word-aligned offset, so marshaling it with a word LDR from [captureBase +
// FieldOffset] would fault on strict-align (MMU-less) arm32.  Such a closure routes to
// the FRAMED spill path, whose capture-read helpers load the packed field byte-wise
// (emitBytewiseWordLoadArm32) — the frameless fast path has too few free scratch
// registers (only IP) to byte-assemble a word, so the framed path (R4 saved + the
// staged arg regs free) is required.
func closureCaptureNeedsBytewiseArm32(f @ir.Func) bool {
	for i := 0; i < f.NumCaptureParams; i++ {
		if aggNeedsBytewiseArm32(f.ClosureStruct.Fields[i].Type) { return true }
	}
	return false
}

// closureCaptureNeedsPadArm32 reports whether any capture takes an AAPCS §6.5 C.3
// even-pair pad — i.e. its authoritative classifier position (CallArgRegStart over
// captures++users) diverges from its running DENSE cursor (Σ preceding ArgWords).
// A padded capture (e.g. an int64 capture at an odd boundary) shifts the user-arg
// base off the dense captureWords the fast path assumes, so it routes to the spill
// shim, which places each capture at its classifier position (pad and all) rather
// than a dense cursor.  Callers must have already excluded indirect-large captures
// (closureHasIndirectLargeCaptureArm32), whose ArgWords over-count would corrupt the
// dense cursor here.
func closureCaptureNeedsPadArm32(cc common.CallConv, f @ir.Func, argTypes @[]@types.Type) bool {
	var dense int = 0
	for i := 0; i < f.NumCaptureParams; i++ {
		if cc.CallArgRegStart(argTypes, i) != dense { return true }
		dense = dense + cc.ArgWords(f.ClosureStruct.Fields[i].Type)
	}
	return false
}

// emitClosureCaptureRegLoadArm32 loads every register-bound capture word into its
// outgoing GP arg register from [captureBase + FieldOffset(i)], iterating captures
// RIGHT-TO-LEFT and, within a multi-word capture, high word first.  Right-to-left keeps
// captureBase (the closure-struct pointer) live until the final load: the base register
// is also capture i=0's destination, so loading capture 0 LAST means every earlier
// capture load still reads a valid base.  captureBase / regBase select the base pointer
// and the outgoing-register origin: (R0, 0) for the scalar/void shim (the data pointer
// arrives in R0, captures fill R0..), and (R1, 1) for a Phase-C sret shape (R0 holds the
// retbuf, so captures fill R1.. — the same dense placement shifted up by the 1-slot sret
// prefix).  captureWords is the dense capture footprint the caller verified has no even-
// pair pad, so the captures occupy argReg(regBase .. regBase+captureWords) densely.
// Mirrors emitClosureCaptureRegLoadAA64 at the register-only surface (no indirect-large /
// SPLIT capture — those spill, and the spill shape is emitClosureCaptureRegLoadSpillArm32).
func emitClosureCaptureRegLoadArm32(a @asm.Assembler, cc common.CallConv, f @ir.Func,
		captureWords int, captureBase int, regBase int) {
	var w int = captureWords
	for i := f.NumCaptureParams - 1; i >= 0; i = i - 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var fieldOfs int = f.ClosureStruct.FieldOffset(i)
		var nWords int = cc.ArgWords(ft)
		for k := nWords - 1; k >= 0; k = k - 1 {
			w = w - 1
			arm32.Ldr(a, arm32.COND_AL, argReg(regBase + w),
					arm32.MemImm(captureBase, fieldOfs + k * cc.WordBytes))
		}
	}
}
