package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Byte-level tests for the arm32 big-single-aggregate SRET capturing-closure /
// method-value STACK-SPILL shim (arm32_closure_shim_aggregate_spill.bn, P4-d Phase
// C.1): a big-sret closure whose [retbuf]++captures++users overflow R0..R3 routes to
// the framed-BL sret spill.  Each shape is compared byte-for-byte against a hand-built
// reference so the frame, the incoming-reg staging, the user-arg marshal at the SRET-
// PREFIX classify (classifyBase = 1 + NumCaptureParams), the captureBase = R1 right-
// to-left register-capture loads, the BL, and the frame teardown are all pinned.  This
// is the over-budget sibling of the frameless fast path in
// arm32_closure_shim_aggregate_test.bn (which pins the tail-branch shape).
//
// Shared helpers (mkIntCaptureClosure / intParams / closureFvType / aggPairType /
// setArm32Target / packShim{Push,Pop}Mask / emitSpAdjust / asmTextEqSpill / fail) live
// in the sibling arm32 native test files (same package).

// A 3-int-capture / 1-int-user closure returning a BIG aggregate OVER-BUDGETS the 4
// GP arg regs under the sret prefix ([retbuf R0, cap0 R1, cap1 R2, cap2 R3] fills the
// file; user0 spills), so it routes to the framed-BL SRET SPILL shim.  Byte-compared
// against the hand-built reference:
//   PUSH {r4, lr}
//   SUB SP, SP, #24         ; stageOff = outBytes(8) ; innerBytes = 8 + 4*4 = 24
//   STR R0, [SP, #8]        ; stage g=0 (retbuf)
//   STR R1, [SP, #12]       ; stage g=1 (data)
//   STR R2, [SP, #16]       ; stage g=2 (user0 incoming, srcPrefix 2)
//   STR R3, [SP, #20]       ; stage g=3 (unused)
//   ; (no stack-bound captures: caps 0..2 ride R1..R3)
//   ; user marshal, SRET-PREFIX classify (classifyBase = 1 + 3 = 4, srcPrefix = 2):
//   LDR R4, [SP, #16]       ; user0 (staged g=2) -> outgoing stack[0] via R4
//   STR R4, [SP, #0]
//   ; register captures right-to-left (i=0 last keeps R1 base), captureBase = R1:
//   LDR R3, [R1, #8]        ; capture2 -> R3
//   LDR R2, [R1, #4]        ; capture1 -> R2
//   LDR R1, [R1, #0]        ; capture0 -> R1 (last)
//   BL underlying           ; R0 = retbuf stays
//   ADD SP, SP, #24
//   POP {r4, pc}
// MUTATION-VERIFY: the SRET-PREFIX classify (classifyBase = 1 + NumCaptureParams = 4,
// captureBase = R1) is what puts caps at R1..R3 and spills user0.  A scalar-style
// classify (classifyBase = 3, captureBase = R0) would put cap0 at R0 — clobbering the
// retbuf — and read captures from R0.  This reference FAILS under that mutation.
func TestClosureShimSret3Cap1UserStackSpillByteRef() testing.TestResult {
	setArm32Target()
	var f @ir.Func = mkIntCaptureClosure(3, intParams(1))
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = aggPairType()
	var fv @types.Type = closureFvType(intParams(1), results)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitClosureShimArm32(got, "bn_ul", fv, f)
	if got.HasError { return fail("3-cap/1-user sret closure spill shim must not error") }

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Push(ref, arm32.COND_AL, packShimPushMask()) // push {r4, lr}
	emitSpAdjust(ref, false, 24) // sub sp, sp, #24
	arm32.Str(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.SP, 8)) // stage g=0 (retbuf)
	arm32.Str(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.SP, 12)) // stage g=1 (data)
	arm32.Str(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.SP, 16)) // stage g=2 (user0)
	arm32.Str(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.SP, 20)) // stage g=3
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 16)) // user0 -> stack[0]
	arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 0))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.R1, 8)) // capture2 -> R3
	arm32.Ldr(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.R1, 4)) // capture1 -> R2
	arm32.Ldr(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.R1, 0)) // capture0 -> R1 (last)
	ref.SetGlobal("bn_ul")
	arm32.Bl(ref, arm32.COND_AL, "bn_ul")
	emitSpAdjust(ref, true, 24) // add sp, sp, #24
	arm32.Pop(ref, arm32.COND_AL, packShimPopMask()) // pop {r4, pc}

	if !asmTextEqSpill(got, ref) {
		return fail(
				"3-cap/1-user sret closure spill shim bytes must match the framed-BL "
						"reference (stage r0..r3, user0 spilled at the SRET-PREFIX classifyBase=4, "
						"captureBase=R1 right-to-left capture loads, bl, teardown)")
	}
	return ""
}
