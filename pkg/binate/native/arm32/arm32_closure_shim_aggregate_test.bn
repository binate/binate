package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Byte-level tests for the arm32 big-single-aggregate SRET capturing-closure /
// method-value FAST (frameless) shim (arm32_closure_shim_aggregate.bn, P4-d Phase
// C.1), plus soft-float aggregate-result lowering (a float field is bytes).  Each shape is
// compared byte-for-byte against a hand-built reference so the SRET register
// choreography is pinned: retbuf STAYS in R0, captures load from R1 (captureBase =
// R1, not R0), user args classify past the [retbuf]++captures prefix (gpDestBase = 1
// + captureWords), and the shim tail-branches (retbuf untouched, the underlying
// writes the result through R0).  The over-budget SRET SPILL path is tested in
// arm32_closure_shim_aggregate_spill_test.bn.  End-to-end behavior is covered by
// conformance (capturing-closure-aggregate-return, 906/907/921-925, method-value sret
// 948/952) in builder-comp_native_arm32_baremetal; these pin the register-level
// correctness a smoke run cannot see.
//
// Shared helpers (mkIntCaptureClosure / intParams / closureFvType / aggPairType /
// aggSmallType / setArm32Target / emitSpAdjust / asmTextEqMarshal / fail) live in the
// sibling arm32 native test files (same package).

// A 1-int-capture / 0-user closure returning a BIG (8-byte) aggregate is the minimal
// SRET fast shape.  Entered as (retbuf R0, data R1); the underlying is
// underlying(retbuf@R0, capture@R1).  No user args, so just the capture self-load
// from R1 and the tail-branch (retbuf stays in R0):
//   LDR R1, [R1, #0]   ; capture0 -> R1 (captureBase = R1, dense +1 past retbuf)
//   B underlying       ; tail-branch, R0 = retbuf untouched
// MUTATION-VERIFY: the scalar shim would load the capture from R0 into R0 (LDR
// R0,[R0,#0]) — reading the RETBUF as the capture base and clobbering it.  This
// reference (capture from R1 into R1) FAILS under that captureBase=R0 mutation.
func TestClosureShimSret1Cap0UserByteRef() testing.TestResult {
	setArm32Target()
	var f @ir.Func = mkIntCaptureClosure(1, intParams(0))
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = aggPairType() // 8-byte struct -> big-sret return (> 4)
	var noParams @[]@types.Param
	var fv @types.Type = closureFvType(noParams, results)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitClosureShimArm32(got, "bn_ul", fv, f)
	if got.HasError { return fail("1-cap/0-user sret closure shim must not error") }

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Ldr(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.R1, 0)) // capture0 -> R1
	ref.SetGlobal("bn_ul")
	arm32.B(ref, arm32.COND_AL, "bn_ul")

	if !asmTextEqMarshal(got, ref) {
		return fail(
				"1-cap/0-user sret closure shim bytes must match the R1-based capture "
						"load + tail-branch (retbuf stays R0)")
	}
	return ""
}

// A 1-int-capture / 1-int-user closure returning a BIG aggregate.  The user args
// classify past [retbuf R0]++[capture R1] to R2 (gpDestBase = 1 + captureWords = 2),
// srcPrefix = 2 (drop retbuf + data), forceStage.  The single user rides incoming R2
// and up-shifts to outgoing R2 (a same-register no-op after staging), then the
// capture loads from R1:
//   SUB SP, SP, #8       ; stage 1 word -> 4 -> StackAlign 8
//   STR R2, [SP, #0]     ; stage user0 (incoming R2, srcPrefix 2)
//   LDR R2, [SP, #0]     ; user0 -> R2 (gpDestBase 2 = 1 + captureWords)
//   ADD SP, SP, #8
//   LDR R1, [R1, #0]     ; capture0 -> R1
//   B underlying         ; retbuf stays R0
// MUTATION-VERIFY: a scalar-style gpDestBase (captureWords = 1, no retbuf slot)
// would place the user at R1 — clobbering the capture register.  This reference
// (user at R2, capture from R1) FAILS under that missing-sret-prefix mutation.
func TestClosureShimSret1Cap1UserByteRef() testing.TestResult {
	setArm32Target()
	var f @ir.Func = mkIntCaptureClosure(1, intParams(1))
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = aggPairType()
	var fv @types.Type = closureFvType(intParams(1), results)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitClosureShimArm32(got, "bn_ul", fv, f)
	if got.HasError { return fail("1-cap/1-user sret closure shim must not error") }

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	emitSpAdjust(ref, false, 8) // SUB allocates 1-word stage (8-aligned)
	arm32.Str(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.SP, 0)) // stage user0 (R2)
	arm32.Ldr(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.SP, 0)) // user0 -> R2
	emitSpAdjust(ref, true, 8) // ADD frees
	arm32.Ldr(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.R1, 0)) // capture0 -> R1
	ref.SetGlobal("bn_ul")
	arm32.B(ref, arm32.COND_AL, "bn_ul")

	if !asmTextEqMarshal(got, ref) {
		return fail(
				"1-cap/1-user sret closure shim bytes must match the user-at-R2 "
						"(gpDestBase = 1 + captureWords) + R1 capture-load reference")
	}
	return ""
}

// A closure whose BIG aggregate result contains a FLOAT FIELD lowers cleanly (P5.3):
// arm32 is soft-float with no HFA, so a float leaf in the result is just bytes the
// GP-only sret store moves like any other field — no FP path needed.
func TestClosureShimSretFloatFieldResultLowers() testing.TestResult {
	setArm32Target()
	var f @ir.Func = mkIntCaptureClosure(1, intParams(0))
	// A >4-byte struct with a float field: { int, float32 } (8 bytes) -> big-sret by
	// SIZE; the float32 field rides the GP sret store as bytes.
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypFloat32()
	var floaty @types.Type = types.MakeStructType("FloatPair", fields)
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = floaty
	var noParams @[]@types.Param
	var fv @types.Type = closureFvType(noParams, results)

	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitClosureShimArm32(a, "bn_ul", fv, f)
	if a.HasError {
		return fail("a float-field aggregate-result closure shim must lower cleanly (P5.3)")
	}
	if bytesWritten(a) == 0 {
		return fail("the closure sret shim must emit a body")
	}
	return ""
}

// A closure whose BIG aggregate result contains a float field NESTED inside an array
// / inner struct ALSO lowers cleanly — the sret store is byte-wise, so a nested float
// leaf is no different.  { [2]float32 } (8 bytes) -> big-sret by size.
func TestClosureShimSretNestedFloatResultLowers() testing.TestResult {
	setArm32Target()
	var f @ir.Func = mkIntCaptureClosure(1, intParams(0))
	var arr @types.Type = types.MakeArrayType(types.TypFloat32(), 2)
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	fields[0] = make(types.Field)
	fields[0].Type = arr
	var nested @types.Type = types.MakeStructType("NestedFloat", fields)
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = nested
	var noParams @[]@types.Param
	var fv @types.Type = closureFvType(noParams, results)

	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitClosureShimArm32(a, "bn_ul", fv, f)
	if a.HasError {
		return fail("a nested-float aggregate-result closure shim must lower cleanly (P5.3)")
	}
	if bytesWritten(a) == 0 {
		return fail("the closure sret shim must emit a body")
	}
	return ""
}
