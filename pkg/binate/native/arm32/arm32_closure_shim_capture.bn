package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/native/callconv"
import "pkg/binate/types"

// loadCaptureWordArm32 loads word k of a word-aligned capture of type t at [base + ofs]
// into dst the way a Binate caller passes a parameter of type t.  A 1- or 2-byte scalar
// (int8, int16, their unsigned twins, bool) is loaded at its own width, sign- or
// zero-extended from it: it is not a word in the closure struct (the next capture may
// follow it, or the struct end), and the body reads its register at full 32-bit width.
// Any other capture word is a whole word inside the capture.  A sub-word-aligned
// aggregate is not loaded here: its words are put together byte-wise
// (emitBytewiseWordLoadArm32).  scratch materializes an offset past the instruction's
// immediate and differs from base.
func loadCaptureWordArm32(a @asm.Assembler, dst int, base int, ofs int64, k int, t @types.Type,
		scratch int) {
	var sz int = sizeArm32(t)
	if !callconv.IsAggregateTyp(t) && (sz == 1 || sz == 2) {
		var u @types.Type = types.StripWrappers(t)
		emitBaseScalarLoad(a, dst, base, ofs, sz, u != nil && u.Signed, scratch)
		return
	}
	emitBaseLoad(a, dst, base, ofs + cast(int64, 4 * k), scratch)
}

// captureBytewiseArm32 reports whether a capture of type t is an aggregate aligned below
// the word (aggNeedsBytewiseArm32), which the closure struct may place at an offset a word
// LDR faults on with strict alignment, so that its words are put together byte-wise.  A
// narrow scalar is not: it is aligned to its own width, so loadCaptureWordArm32 loads it
// in one instruction, extended as its type says.
func captureBytewiseArm32(t @types.Type) bool {
	return callconv.IsAggregateTyp(t) && aggNeedsBytewiseArm32(t)
}
