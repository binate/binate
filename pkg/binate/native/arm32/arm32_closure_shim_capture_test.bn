package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A capture is loaded from the closure struct as a Binate caller passes it: a 1- or
// 2-byte integer or a bool at its own width, extended by its signedness (through IP
// past the instruction's immediate), anything else a whole word at a time.

// newAsmArm32 is an empty text-section assembler.
func newAsmArm32() @asm.Assembler {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	return a
}

// captureLoadSameArm32 reports whether loadCaptureWordArm32 of word k of a capture of
// type t at [R0 + ofs] into R1 emits the bytes of want.
func captureLoadSameArm32(t @types.Type, ofs int64, k int, want @asm.Assembler) bool {
	var g @asm.Assembler = newAsmArm32()
	loadCaptureWordArm32(g, arm32.R1, arm32.R0, ofs, k, t, arm32.IP)
	return !g.HasError && asmTextEqMarshal(g, want)
}

// closureOfCapturesArm32 builds a closure Func whose captures have the types ts.
func closureOfCapturesArm32(ts @[]@types.Type) @ir.Func {
	var fields @[]@types.Field = make_slice(@types.Field, len(ts))
	for i := 0; i < len(ts); i++ {
		fields[i] = make(types.Field)
		fields[i].Name = "c"
		fields[i].Type = ts[i]
	}
	var f @ir.Func = make(ir.Func)
	f.Name = "main.__funclit_x"
	f.IsClosure = true
	f.NumCaptureParams = len(ts)
	f.ClosureStruct = types.MakeStructType("__closure_x", fields)
	var noP @[]@ir.Param
	f.Params = noP
	var noR @[]@types.Type
	f.Results = noR
	return f
}

func TestLoadCaptureWordNarrowScalarsArm32() testing.TestResult {
	setArm32Target()
	var w @asm.Assembler = newAsmArm32()
	arm32.Ldrsb(w, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.R0, 1))
	if !captureLoadSameArm32(types.TypInt8(), 1, 0, w) { return fail("an int8 capture is LDRSB") }
	w = newAsmArm32()
	arm32.Ldrsh(w, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.R0, 2))
	if !captureLoadSameArm32(types.TypInt16(), 2, 0, w) { return fail("an int16 capture is LDRSH") }
	w = newAsmArm32()
	arm32.Ldrh(w, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.R0, 2))
	if !captureLoadSameArm32(types.TypUint16(), 2, 0, w) { return fail("a uint16 capture is LDRH") }
	w = newAsmArm32()
	arm32.Ldrb(w, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.R0, 3))
	if !captureLoadSameArm32(types.TypBool(), 3, 0, w) { return fail("a bool capture is LDRB") }
	w = newAsmArm32()
	arm32.Ldr(w, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.R0, 4))
	if !captureLoadSameArm32(types.TypInt32(), 4, 0, w) {
		return fail("an int32 capture is a word LDR")
	}
	w = newAsmArm32()
	arm32.Ldr(w, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.R0, 12))
	if !captureLoadSameArm32(types.TypInt64(), 8, 1, w) {
		return fail("word 1 of an int64 capture at 8 is at 12")
	}
	return ""
}

// An int8 capture past LDRSB's 8-bit immediate is addressed through IP.
func TestLoadCaptureWordNarrowFarArm32() testing.TestResult {
	setArm32Target()
	var w @asm.Assembler = newAsmArm32()
	emitConstInt32(w, arm32.IP, 300)
	arm32.Add(w, arm32.COND_AL, false, arm32.IP, arm32.R0, arm32.Reg(arm32.IP))
	arm32.Ldrsb(w, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.IP, 0))
	if !captureLoadSameArm32(types.TypInt8(), 300, 0, w) {
		return fail("an int8 capture at 300 is LDRSB through IP")
	}
	return ""
}

// Two int8 captures: the fast shim loads each sign-extended from its own byte (the
// second first, so R0 stays the base until the last load) and branches to the body.
func TestClosureShimNarrowCapturesArm32() testing.TestResult {
	setArm32Target()
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt8()
	ts[1] = types.TypInt8()
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var noParams @[]@types.Param
	var got @asm.Assembler = newAsmArm32()
	emitClosureShimArm32(got, callconv.AAPCS32(), "bn_ul", closureFvType(noParams, results),
			closureOfCapturesArm32(ts))
	if got.HasError { return fail("a two-int8-capture shim must not error") }
	var ref @asm.Assembler = newAsmArm32()
	arm32.Ldrsb(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.R0, 1))
	arm32.Ldrsb(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R0, 0))
	ref.SetGlobal("bn_ul")
	arm32.B(ref, arm32.COND_AL, "bn_ul")
	if !asmTextEqMarshal(got, ref) {
		return fail("two int8 captures are LDRSB R1, [R0, #1]; LDRSB R0, [R0]")
	}
	return ""
}
