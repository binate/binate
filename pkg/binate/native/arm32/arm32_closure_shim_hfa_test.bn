package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for HFAs in the closure shims: an HFA capture loaded from the closure data
// block into its VFP registers (or, past the bank, spilled to the outgoing stack), an
// HFA param of the fast path loaded into VFP registers, and an HFA result stored from
// s0.. / d0.. through the retbuf by the pack core.  Each emits the shim on an arm32
// hard-float target with cc.HfaAggregates on (or, as a control, off).

// emitHfaClosureShim stamps an ILP32 hard-float target, emits the closure shim for f
// with user params ps and results rs, HFA passing on (hfa) or off, and restores the
// target.
func emitHfaClosureShim(f @ir.Func, ps @[]@types.Type, rs @[]@types.Type, hfa bool) @asm.Assembler {
	setArm32Target()
	oldArch, oldAbi := stampHard()
	var cc callconv.CallConv = callconv.AAPCS32()
	cc.HfaAggregates = hfa
	var a @asm.Assembler = mkAsm()
	emitClosureShimArm32(a, cc, "bn_ul", hfaShimFv(ps, rs), f)
	restoreTarget(oldArch, oldAbi)
	return a
}

// captures2 returns the two capture types (t0, t1).
func captures2(t0 @types.Type, t1 @types.Type) @[]@types.Type {
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = t0
	ts[1] = t1
	return ts
}

// Captures (int, D2): D2 sits at offset 8 of the closure data block and loads into
// d0-d1 from the data pointer (R0) — it takes no core register.  With HFA passing off
// it is a GP capture and loads into no VFP register.
func TestClosureShimHfaCaptureLoadsVfp() testing.TestResult {
	var f @ir.Func = mkCaptureClosureArm32(
			captures2(types.TypInt(), hfaType("D2", types.TypFloat64(), 2)))
	var none @[]@types.Type
	var a @asm.Assembler = emitHfaClosureShim(f, none, none, true)
	var off @asm.Assembler = emitHfaClosureShim(f, none, none, false)
	if a.HasError || off.HasError { return fail("an HFA-capture closure shim must lower") }
	if !containsWord(a, vldrWord(true, arm32.D0, arm32.R0, 8)) ||
			!containsWord(a, vldrWord(true, arm32.D1, arm32.R0, 16)) {
		return fail("D2's members must load into d0-d1 from the data block")
	}
	if containsWord(off, vldrWord(true, arm32.D0, arm32.R0, 8)) {
		return fail("with HFAs off, the D2 capture must not load into VFP registers")
	}
	return ""
}

// Captures (D4, D4, F1): F1 is past the VFP bank, so its word goes from the data block
// (offset 64) to the outgoing stack at [SP] through R4.
func TestClosureShimHfaCapturePastBankSpills() testing.TestResult {
	var d4 @types.Type = hfaType("D4", types.TypFloat64(), 4)
	var caps @[]@types.Type = make_slice(@types.Type, 3)
	caps[0] = d4
	caps[1] = d4
	caps[2] = hfaType("F1", types.TypFloat32(), 1)
	var none @[]@types.Type
	var a @asm.Assembler = emitHfaClosureShim(mkCaptureClosureArm32(caps), none, none, true)
	if a.HasError { return fail("an HFA capture past the bank must lower") }
	if !containsWord(a, vldrWord(true, arm32.D7, arm32.R0, 56)) {
		return fail("the second D4 must end in d7")
	}
	if !containsWord(a, ldrWord(arm32.R4, arm32.R0, 64)) ||
			!containsWord(a, strWord(arm32.R4, arm32.SP, 0)) {
		return fail("F1's word must go from the data block to the outgoing [SP]")
	}
	return ""
}

// One int capture and an F2 param: the fast path — no frame pushed, a tail branch
// last — loads F2's members from its address into s0-s1 (the int capture takes r0, no
// VFP register).
func TestClosureShimHfaParamFastPath() testing.TestResult {
	var none @[]@types.Type
	var a @asm.Assembler = emitHfaClosureShim(mkIntCaptureClosure(1, intParams(0)),
			typesOf1(hfaType("F2", types.TypFloat32(), 2)), none, true)
	if a.HasError { return fail("an HFA-param closure shim must lower") }
	if !containsWord(a, vldrWord(false, arm32.S0, arm32.IP, 0)) ||
			!containsWord(a, vldrWord(false, arm32.S1, arm32.IP, 4)) {
		return fail("F2's members must load into s0-s1")
	}
	var push @asm.Assembler = mkAsm()
	arm32.Push(push, arm32.COND_AL, packShimPushMask())
	arm32.Push(push, arm32.COND_AL, packClosurePushMask())
	if containsWord(a, word32(push, 0)) || containsWord(a, word32(push, 4)) {
		return fail("the fast path pushes no frame")
	}
	var last uint32 = word32(a, bytesWritten(a) - 4)
	if (last >> 24) & cast(uint32, 0xf) != cast(uint32, 0xa) {
		return fail("the fast path ends in a tail branch")
	}
	return ""
}

// An F2 result (8 bytes) comes back in s0-s1: the pack core stores the members through
// the reloaded retbuf (R4).  With HFA passing off it is an sret result and nothing is
// stored from s0.
func TestClosureShimHfaReturnStoresThroughRetbuf() testing.TestResult {
	var none @[]@types.Type
	var rs @[]@types.Type = typesOf1(hfaType("F2", types.TypFloat32(), 2))
	var f @ir.Func = mkIntCaptureClosure(1, intParams(0))
	var a @asm.Assembler = emitHfaClosureShim(f, none, rs, true)
	var off @asm.Assembler = emitHfaClosureShim(f, none, rs, false)
	if a.HasError || off.HasError { return fail("an HFA-return closure shim must lower") }
	if !containsWord(a, vstrWord(false, arm32.S0, arm32.R4, 0)) ||
			!containsWord(a, vstrWord(false, arm32.S1, arm32.R4, 4)) {
		return fail("F2's members must be stored from s0-s1 through the retbuf")
	}
	if containsWord(off, vstrWord(false, arm32.S0, arm32.R4, 0)) {
		return fail("with HFAs off, F2 is sret and nothing is stored from s0")
	}
	return ""
}

// indexOfWord returns the byte offset of the first occurrence of w in a, or -1.
func indexOfWord(a @asm.Assembler, w uint32) int {
	for off := 0; off + 4 <= bytesWritten(a); off = off + 4 {
		if word32(a, off) == w { return off }
	}
	return -1
}

// An HFA capture in the pack core loads from the re-homed data base R5: captures (D2)
// with a 4-byte struct result put D2 in d0-d1 from [R5].
func TestClosureShimHfaCapturePackCore() testing.TestResult {
	var f @ir.Func = mkCaptureClosureArm32(typesOf1(hfaType("D2", types.TypFloat64(), 2)))
	var none @[]@types.Type
	var a @asm.Assembler = emitHfaClosureShim(f, none, typesOf1(hfaType("S1", types.TypInt32(), 1)),
			true)
	if a.HasError { return fail("a pack-result closure with an HFA capture must lower") }
	if !containsWord(a, vldrWord(true, arm32.D0, arm32.R5, 0)) ||
			!containsWord(a, vldrWord(true, arm32.D1, arm32.R5, 8)) {
		return fail("D2's members must load into d0-d1 from R5")
	}
	return ""
}

// An HFA capture in the sret spill shim is classified past the sret pointer and loads
// from the data base R1: captures (int, D2) with a 12-byte struct result put D2 in
// d0-d1 from [R1 + 8].
func TestClosureShimHfaCaptureSretSpill() testing.TestResult {
	var f @ir.Func = mkCaptureClosureArm32(
			captures2(types.TypInt(), hfaType("D2", types.TypFloat64(), 2)))
	var none @[]@types.Type
	var a @asm.Assembler = emitHfaClosureShim(f, none, typesOf1(hfaType("G3", types.TypInt32(), 3)),
			true)
	if a.HasError { return fail("an sret-result closure with an HFA capture must lower") }
	if !containsWord(a, vldrWord(true, arm32.D0, arm32.R1, 8)) ||
			!containsWord(a, vldrWord(true, arm32.D1, arm32.R1, 16)) {
		return fail("D2's members must load into d0-d1 from R1")
	}
	return ""
}

// A 32-byte D4 result — sret with HFA passing off — comes back in d0-d3, stored through
// the retbuf by the pack core.
func TestClosureShimHfaReturnD4() testing.TestResult {
	var none @[]@types.Type
	var a @asm.Assembler = emitHfaClosureShim(mkIntCaptureClosure(1, intParams(0)), none,
			typesOf1(hfaType("D4", types.TypFloat64(), 4)), true)
	if a.HasError { return fail("a D4-result closure shim must lower") }
	for m := 0; m < 4; m++ {
		if !containsWord(a, vstrWord(true, arm32.D0 + m, arm32.R4, 8 * m)) {
			return fail("D4's members must be stored from d0-d3 through the retbuf")
		}
	}
	return ""
}

// With only VFP captures a GP user arg lands in the data base register R0: captures (D2)
// and an int32 param.  The capture must load off R0 before the marshal overwrites R0
// with the param (from its staged word at [SP + 4]).
func TestClosureShimHfaCaptureLoadsBeforeMarshal() testing.TestResult {
	var f @ir.Func = mkCaptureClosureArm32(typesOf1(hfaType("D2", types.TypFloat64(), 2)))
	var none @[]@types.Type
	var a @asm.Assembler = emitHfaClosureShim(f, typesOf1(types.TypInt32()), none, true)
	if a.HasError { return fail("a VFP-capture closure with an int param must lower") }
	var load int = indexOfWord(a, vldrWord(true, arm32.D1, arm32.R0, 8))
	var marshal int = indexOfWord(a, ldrWord(arm32.R0, arm32.SP, 4))
	if load < 0 || marshal < 0 {
		return fail("the capture load and the param's move into R0 must both be there")
	}
	if load > marshal { return fail("the HFA capture must load off R0 before the marshal writes R0") }
	return ""
}
