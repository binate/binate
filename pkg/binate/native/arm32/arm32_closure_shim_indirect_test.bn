package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for a closure / method-value shim whose capture is an indirect-large
// (>16-byte) aggregate: AAPCS32 passes it by address, so the shim hands the
// underlying the capture's address in the closure struct (captureBase +
// FieldOffset) — one register or one outgoing stack word — and routes the closure to
// the framed path, whose loaders place it at its classifier position.

// big20Arm32 is a 5 x int32 struct: 20 bytes, 4-aligned, so it is indirect-large on
// AAPCS32 without taking an even-register pad.
func big20Arm32() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 5)
	for i := 0; i < 5; i++ {
		fields[i] = make(types.Field)
		fields[i].Name = "f"
		fields[i].Type = types.TypInt32()
	}
	return types.MakeStructType("Big20", fields)
}

// mkCaptureClosureArm32 builds an IsClosure Func whose captures have the given types
// (the ClosureStruct fields, in order).
func mkCaptureClosureArm32(capTypes @[]@types.Type) @ir.Func {
	var fields @[]@types.Field = make_slice(@types.Field, len(capTypes))
	for i := 0; i < len(capTypes); i++ {
		fields[i] = make(types.Field)
		fields[i].Name = "c"
		fields[i].Type = capTypes[i]
	}
	var f @ir.Func = make(ir.Func)
	f.Name = "main.__funclit_big"
	f.IsClosure = true
	f.NumCaptureParams = len(capTypes)
	f.ClosureStruct = types.MakeStructType("__closure_big", fields)
	var noP @[]@ir.Param
	f.Params = noP
	var noR @[]@types.Type
	f.Results = noR
	return f
}

// An int capture, a Big20 capture and one int user arg: cap0 -> R0, cap1 (by
// address) -> R1, user0 -> R2.  The closure routes to the framed spill path:
//   PUSH {r4, lr} ; SUB SP, SP, #16 ; STR R0..R3, [SP, #0..#12]   ; stage
//   LDR R2, [SP, #4]        ; user0 (incoming R1) -> R2
//   ADD R1, R0, #4          ; cap1: its address in the closure struct
//   LDR R0, [R0, #0]        ; cap0 (last, keeps the R0 base)
//   BL ; ADD SP, SP, #16 ; POP {r4, pc}
func TestClosureShimIndirectLargeCaptureInRegByteRef() testing.TestResult {
	setArm32Target()
	var caps @[]@types.Type = make_slice(@types.Type, 2)
	caps[0] = types.TypInt()
	caps[1] = big20Arm32()
	var f @ir.Func = mkCaptureClosureArm32(caps)
	var noResults @[]@types.Type
	var fv @types.Type = closureFvType(intParams(1), noResults)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitClosureShimArm32(got, "bn_ul", fv, f)
	if got.HasError { return fail("an indirect-large capture closure shim must lower") }

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Push(ref, arm32.COND_AL, packShimPushMask())
	emitSpAdjust(ref, false, 16)
	arm32.Str(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.SP, 0))
	arm32.Str(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.SP, 4))
	arm32.Str(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.SP, 8))
	arm32.Str(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.SP, 12))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.SP, 4))
	arm32.Add(ref, arm32.COND_AL, false, arm32.R1, arm32.R0, arm32.Imm(4))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R0, 0))
	ref.SetGlobal("bn_ul")
	arm32.Bl(ref, arm32.COND_AL, "bn_ul")
	emitSpAdjust(ref, true, 16)
	arm32.Pop(ref, arm32.COND_AL, packShimPopMask())

	if !asmTextEqSpill(got, ref) {
		return fail(
				"an indirect-large capture in a register must get its address in the "
						"closure struct (ADD R1, R0, #4), on the framed path")
	}
	return ""
}

// Four int captures and a Big20 capture: caps 0..3 -> R0..R3, cap4 (by address) ->
// the outgoing stack word 0.
//   PUSH {r4, lr} ; SUB SP, SP, #24 ; STR R0..R3, [SP, #8..#20]   ; stage
//   ADD R4, R0, #16 ; STR R4, [SP, #0]   ; cap4: its address, spilled via R4
//   LDR R3, [R0, #12] ... LDR R0, [R0, #0]   ; register captures right-to-left
//   BL ; ADD SP, SP, #24 ; POP {r4, pc}
func TestClosureShimIndirectLargeCaptureOnStackByteRef() testing.TestResult {
	setArm32Target()
	var caps @[]@types.Type = make_slice(@types.Type, 5)
	for i := 0; i < 4; i++ {
		caps[i] = types.TypInt()
	}
	caps[4] = big20Arm32()
	var f @ir.Func = mkCaptureClosureArm32(caps)
	var noResults @[]@types.Type
	var noParams @[]@types.Param
	var fv @types.Type = closureFvType(noParams, noResults)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitClosureShimArm32(got, "bn_ul", fv, f)
	if got.HasError { return fail("a stack-bound indirect-large capture closure shim must lower") }

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Push(ref, arm32.COND_AL, packShimPushMask())
	emitSpAdjust(ref, false, 24)
	arm32.Str(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.SP, 8))
	arm32.Str(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.SP, 12))
	arm32.Str(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.SP, 16))
	arm32.Str(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.SP, 20))
	arm32.Add(ref, arm32.COND_AL, false, arm32.R4, arm32.R0, arm32.Imm(16))
	arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 0))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.R0, 12))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.R0, 8))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.R0, 4))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R0, 0))
	ref.SetGlobal("bn_ul")
	arm32.Bl(ref, arm32.COND_AL, "bn_ul")
	emitSpAdjust(ref, true, 24)
	arm32.Pop(ref, arm32.COND_AL, packShimPopMask())

	if !asmTextEqSpill(got, ref) {
		return fail(
				"a stack-bound indirect-large capture must get its address in the closure "
						"struct stored to its outgoing stack word (ADD R4, R0, #16; STR R4, [SP, #0])")
	}
	return ""
}

// Every result shape lowers with an indirect-large capture: a big struct (sret), a
// <=4-byte struct (pack), a small and a big multi-return, a scalar and none.
func TestClosureShimIndirectLargeCaptureAllResultShapesLower() testing.TestResult {
	setArm32Target()
	var smallFields @[]@types.Field = make_slice(@types.Field, 1)
	smallFields[0] = make(types.Field)
	smallFields[0].Name = "v"
	smallFields[0].Type = types.TypInt8()
	var small @types.Type = types.MakeStructType("Small1", smallFields)
	var shapes @[]@[]@types.Type = make_slice(@[]@types.Type, 6)
	shapes[0] = make_slice(@types.Type, 1)
	shapes[0][0] = big20Arm32()
	shapes[1] = make_slice(@types.Type, 1)
	shapes[1][0] = small
	shapes[2] = make_slice(@types.Type, 2)
	shapes[3] = make_slice(@types.Type, 5)
	for i := 0; i < 2; i++ { shapes[2][i] = types.TypInt() }
	for i := 0; i < 5; i++ { shapes[3][i] = types.TypInt() }
	shapes[4] = make_slice(@types.Type, 1)
	shapes[4][0] = types.TypInt()
	var caps @[]@types.Type = make_slice(@types.Type, 1)
	caps[0] = big20Arm32()
	for i := 0; i < len(shapes); i++ {
		var f @ir.Func = mkCaptureClosureArm32(caps)
		var a @asm.Assembler = asm.New(4)
		a.SetSection("text", -1)
		emitClosureShimArm32(a, "bn_ul", closureFvType(intParams(1), shapes[i]), f)
		if a.HasError {
			return fail("an indirect-large capture closure shim must lower for every result "
					"shape")
		}
	}
	return ""
}

// big24Arm32 is a 3 x int64 struct: 24 bytes and 8-aligned, so an indirect-large arg
// of it takes AAPCS §6.5 C.3's even-register pad.
func big24Arm32() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Name = "f"
		fields[i].Type = types.TypInt64()
	}
	return types.MakeStructType("Big24", fields)
}

// emitFramedShimRefArm32 emits the framed spill shim's frame (push {r4, lr}, a 16-byte
// inner area staging r0..r3), `body`'s capture loads, and the BL / teardown — the shape
// every test below shares (no outgoing stack words, no user args).
func emitFramedShimRefArm32(ref @asm.Assembler, body *func(@asm.Assembler)) {
	arm32.Push(ref, arm32.COND_AL, packShimPushMask())
	emitSpAdjust(ref, false, 16)
	arm32.Str(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.SP, 0))
	arm32.Str(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.SP, 4))
	arm32.Str(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.SP, 8))
	arm32.Str(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.SP, 12))
	body(ref)
	ref.SetGlobal("bn_ul")
	arm32.Bl(ref, arm32.COND_AL, "bn_ul")
	emitSpAdjust(ref, true, 16)
	arm32.Pop(ref, arm32.COND_AL, packShimPopMask())
}

// shimForCapturesArm32 emits the closure shim for captures caps, no user args, and
// the given results.
func shimForCapturesArm32(caps @[]@types.Type, results @[]@types.Type) @asm.Assembler {
	var noParams @[]@types.Param
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitClosureShimArm32(a, "bn_ul", closureFvType(noParams, results), mkCaptureClosureArm32(caps))
	return a
}

// An int capture then an 8-aligned Big24 capture: the pointer pads to R2 (R1 is the
// even-pair pad), as the callee's classifier places it.
//   ADD R2, R0, #8 ; LDR R0, [R0, #0]
func TestClosureShimIndirectLargeCaptureEvenPadByteRef() testing.TestResult {
	setArm32Target()
	var caps @[]@types.Type = make_slice(@types.Type, 2)
	caps[0] = types.TypInt()
	caps[1] = big24Arm32()
	var noResults @[]@types.Type
	var got @asm.Assembler = shimForCapturesArm32(caps, noResults)
	if got.HasError { return fail("a padded indirect-large capture closure shim must lower") }
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	emitFramedShimRefArm32(ref,
			func(r @asm.Assembler) {
				arm32.Add(r, arm32.COND_AL, false, arm32.R2, arm32.R0, arm32.Imm(8))
				arm32.Ldr(r, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R0, 0))
			})
	if !asmTextEqSpill(got, ref) {
		return fail("an 8-aligned indirect-large capture after an int must take R2 (R1 padded)")
	}
	return ""
}

// A Big24 capture with a big-aggregate (sret) result: R0 holds the retbuf and R1 the
// closure struct, so the pointer pads past R1 to R2.
//   ADD R2, R1, #0
func TestClosureShimIndirectLargeCaptureSretEvenPadByteRef() testing.TestResult {
	setArm32Target()
	var caps @[]@types.Type = make_slice(@types.Type, 1)
	caps[0] = big24Arm32()
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = big20Arm32()
	var got @asm.Assembler = shimForCapturesArm32(caps, results)
	if got.HasError { return fail("an sret indirect-large capture closure shim must lower") }
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	emitFramedShimRefArm32(ref,
			func(r @asm.Assembler) {
				arm32.Add(r, arm32.COND_AL, false, arm32.R2, arm32.R1, arm32.Imm(0))
			})
	if !asmTextEqSpill(got, ref) {
		return fail("an 8-aligned indirect-large capture of an sret shim must take R2 off the R1 base")
	}
	return ""
}

// A [1028]uint8 capture then a Big20 at field offset 1028, which no ADD immediate
// encodes: the address is built through IP.
//   MOV IP, #1028 (emitConstInt32) ; ADD R1, R0, IP ; ADD R0, R0, #0
func TestClosureShimIndirectLargeCaptureLargeOffsetByteRef() testing.TestResult {
	setArm32Target()
	var caps @[]@types.Type = make_slice(@types.Type, 2)
	caps[0] = types.MakeArrayType(types.TypUint8(), 1028)
	caps[1] = big20Arm32()
	var noResults @[]@types.Type
	var got @asm.Assembler = shimForCapturesArm32(caps, noResults)
	if got.HasError { return fail("a far indirect-large capture closure shim must lower") }
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	emitFramedShimRefArm32(ref,
			func(r @asm.Assembler) {
				emitConstInt32(r, arm32.IP, 1028)
				arm32.Add(r, arm32.COND_AL, false, arm32.R1, arm32.R0, arm32.Reg(arm32.IP))
				arm32.Add(r, arm32.COND_AL, false, arm32.R0, arm32.R0, arm32.Imm(0))
			})
	if !asmTextEqSpill(got, ref) {
		return fail(
				"an indirect-large capture at a large field offset must build its address "
						"through IP")
	}
	return ""
}
