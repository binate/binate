package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Native arm32 emission for the MULTI-RETURN-RESULT path of a capturing closure /
// method-value shim (Phase C.3) — the last Phase C
// sub-phase.  Split out to stay under the hygiene file-length cap.  It COMPOSES the
// C.1 + C.2 machinery rather than reinventing it: a multi-return tuple result is
// either returned via an sret pointer in R0 (BIG — gpWords > NumGpRetRegs = 4) or
// field-per-register in r0..r3 (SMALL — gpWords <= 4), split by isBigMultiReturnArm32
// (arm32_funcvalue_multiret.bn), the SAME word-count rule the callee's return
// lowering (emitMultiReturnPack / emitMultiReturnSret) and the non-closure caller
// (collectMultiReturnFields / emitMultiRetPackShim) use — a size-only rule would
// disagree for e.g. (int64, int64) (16 bytes but 4 GP words → field-per-register).
//
// BIG multi-return (sret): the tuple is returned through the R0 retbuf — the
// underlying writes each field through it — which is EXACTLY the C.1 big-single-
// aggregate SRET shape (retbuf STAYS in R0, no post-BL routing).  So it reuses the
// C.1 emitter (emitClosureShimSretArm32) UNCHANGED: that emitter is result-shape-
// agnostic past the retbuf-in-R0 contract (it only marshals the outgoing
// [retbuf]++captures++users and tail-branches / spills; it never touches the result),
// so a big-multiret result rides it with no adapter.
//
// SMALL multi-return (field-per-register): the underlying returns the tuple FIELD-
// PER-REGISTER in r0..r3 (NOT a single packed R0 word), so it reuses the C.2 PACK
// framing (emitClosureShimPackCoreArm32 — framed BL, R5-re-homed clobber-safe capture
// base, retbuf stash, {r4,r5,r6,lr} frame) with ONE delta: the post-BL store is the
// field-per-register storeMultiReturnTupleFieldsArm32 (through the reloaded-into-R4
// retbuf) instead of a single STR R0.  This is the SAME store the callee's return
// lowering emits, so the shim and the callee provably agree on r0..r3 → retbuf-field
// placement.

// emitClosureShimMultiRetArm32 emits the multi-return-result capturing-closure /
// method-value shim (Phase C.3).  It dispatches on isBigMultiReturnArm32 (the shared
// word-count sret rule): a BIG tuple (gpWords > 4) rides the C.1 sret emitter (retbuf
// stays in R0, the underlying writes each field through it — no post-BL routing); a
// SMALL tuple (gpWords <= 4) rides the C.2 pack framing with a field-per-register post-
// BL store.  argTypes is the outgoing captures++users type list the caller
// (emitClosureShimArm32) already built.  A float SCALAR field is stored via the hard/soft
// dispatcher (storeMultiReturnTupleFieldsShimArm32): on soft-float it folds into the GP
// field store bit-for-bit like an integer (a tuple is just bytes; a float64 field routes
// through isPair64Typ); under hard-float the field rides its VFP return register and the
// dispatcher VSTRs it (inc 3f b3).  A scalar float PARAM/CAPTURE stays fail-loud (the
// GP-only pack arg-marshal / capture load can't place it — inc 3f b4).
func emitClosureShimMultiRetArm32(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type, f @ir.Func,
		cc common.CallConv, argTypes @[]@types.Type) {
	if isBigMultiReturnArm32(fvTyp) {
		// BIG multi-return: the tuple is returned via the R0 retbuf, EXACTLY the C.1
		// big-single-aggregate sret shape — reuse it unchanged (retbuf stays in R0, the
		// underlying wrote each field through it, so there is no post-BL routing).
		emitClosureShimSretArm32(a, fnLabel, fvTyp, f, cc, argTypes)
		return
	}
	// SMALL multi-return: the underlying returns the tuple field-per-register in r0..r3.
	// Reuse the C.2 pack framing (R5-re-homed capture base + retbuf stash) with the field-
	// per-register post-BL store selected by passing the multi-return tuple as retTuple.
	emitClosureShimPackCoreArm32(a, fnLabel, fvTyp, f, cc, argTypes,
			funcValMultiReturnTupleArm32(fvTyp))
}
