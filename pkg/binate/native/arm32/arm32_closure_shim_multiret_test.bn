package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Byte-level tests for the arm32 MULTI-RETURN-result capturing-closure / method-value
// shim (arm32_closure_shim_multiret.bn, P4-d Phase C.3), plus the float-in-tuple-result
// P5 fail-loud guard.  Each shape is compared byte-for-byte against a hand-built
// reference so the composition of C.1 (big → sret) + C.2 (small → pack framing with a
// FIELD-PER-REGISTER post-BL store) is pinned:
//   - SMALL multi-return (gpWords <= 4): the C.2 PACK framing (framed BL, R5-re-homed
//     clobber-safe capture base — THE CRUX, retbuf stash, {r4,r5,r6,lr} frame) with the
//     post-BL store swapped to storeMultiReturnTupleFieldsArm32 — the returned tuple
//     fields r0..rN stored through the reloaded-into-R4 retbuf at each field's offset.
//   - BIG multi-return (gpWords > 4): the C.1 SRET shape reused unchanged (retbuf stays
//     in R0, captures load from R1, the underlying writes each field through R0).
// End-to-end behavior is covered by conformance (regressions/capturing-closure-multi-
// return, 950_method_value_multiret) in builder-comp_native_arm32_baremetal; these pin
// the register-level correctness a smoke run cannot see.
//
// Shared helpers (mkIntCaptureClosure / intParams / closureFvType / setArm32Target /
// packClosure{Push,Pop}Mask / emitSpAdjust / asmTextEqSpill / asmTextEqMarshal / fail)
// live in the sibling arm32 native test files (same package).

// intResultsMulti builds an n-result all-int func-value result list (a small multi-
// return when n <= 4, a big one when n > 4 — each int is one ILP32 GP word).
func intResultsMulti(n int) @[]@types.Type {
	var results @[]@types.Type = make_slice(@types.Type, n)
	for i := 0; i < n; i++ {
		results[i] = types.TypInt()
	}
	return results
}

// A 1-int-capture / 0-user closure returning a SMALL multi-return (int, int) — gpWords
// 2 <= 4, so it rides the C.2 PACK framing with a FIELD-PER-REGISTER post-BL store.
// Entered as (retbuf R0, data R1); the underlying is underlying(capture@R0) returning
// the tuple field-per-register in r0:r1.  Framed, staged:
//   PUSH {r4, r5, r6, lr}
//   SUB SP, SP, #24         ; retbufOff=0, stageOff=4, innerBytes=4+4*4=20 -> 24
//   STR R0, [SP, #4]        ; stage g=0 (retbuf)
//   STR R1, [SP, #8]        ; stage g=1 (data)
//   STR R2, [SP, #12]       ; stage g=2 (unused)
//   STR R3, [SP, #16]       ; stage g=3 (unused)
//   STR R0, [SP, #0]        ; stash retbuf (retbufOff=0)
//   LDR R5, [SP, #8]        ; re-home data base -> R5 (staged data g=1)
//   LDR R0, [R5, #0]        ; capture0 -> R0 from the R5 base (NOT live R1)
//   BL underlying           ; returns the (int,int) tuple field-per-register in r0:r1
//   LDR R4, [SP, #0]        ; reload retbuf
//   STR R0, [R4, #0]        ; store tuple field0 (r0) through retbuf at offset 0
//   STR R1, [R4, #4]        ; store tuple field1 (r1) through retbuf at offset 4
//   ADD SP, SP, #24
//   POP {r4, r5, r6, pc}
// MUTATION-VERIFY (wrong field-store register): storing R2 (or R0) for field1 instead
// of R1 would emit `STR R2, [R4, #4]`; this reference (field1 = R1) FAILS that mutation.
func TestClosureShimMultiRetSmall1Cap0UserByteRef() testing.TestResult {
	setArm32Target()
	var f @ir.Func = mkIntCaptureClosure(1, intParams(0))
	var results @[]@types.Type = intResultsMulti(2) // (int, int) -> gpWords 2 -> small pack
	var noParams @[]@types.Param
	var fv @types.Type = closureFvType(noParams, results)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitClosureShimArm32(got, "bn_ul", fv, f)
	if got.HasError { return fail("1-cap/0-user small-multiret closure shim must not error") }

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Push(ref, arm32.COND_AL, packClosurePushMask()) // push {r4, r5, r6, lr}
	emitSpAdjust(ref, false, 24) // sub sp, sp, #24
	arm32.Str(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.SP, 4)) // stage g=0 (retbuf)
	arm32.Str(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.SP, 8)) // stage g=1 (data)
	arm32.Str(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.SP, 12)) // stage g=2
	arm32.Str(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.SP, 16)) // stage g=3
	arm32.Str(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.SP, 0)) // stash retbuf
	arm32.Ldr(ref, arm32.COND_AL, arm32.R5, arm32.MemImm(arm32.SP, 8)) // re-home data -> R5
	arm32.Ldr(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R5, 0)) // capture0 -> R0 (from R5)
	ref.SetGlobal("bn_ul")
	arm32.Bl(ref, arm32.COND_AL, "bn_ul")
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 0)) // reload retbuf
	arm32.Str(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R4, 0)) // tuple field0 (r0) -> [R4+0]
	arm32.Str(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.R4, 4)) // tuple field1 (r1) -> [R4+4]
	emitSpAdjust(ref, true, 24) // add sp, sp, #24
	arm32.Pop(ref, arm32.COND_AL, packClosurePopMask()) // pop {r4, r5, r6, pc}

	if !asmTextEqSpill(got, ref) {
		return fail(
				"1-cap/0-user small-multiret closure shim bytes must match the framed-BL "
						"reference (stage r0..r3, re-home data to R5, capture from R5, bl, store "
						"tuple fields r0->[R4+0] / r1->[R4+4] through the reloaded retbuf)")
	}
	return ""
}

// THE CRUX capture-base-survival mutation test, for the SMALL multi-return shape.  A
// 2-int-capture / 0-user closure returning (int, int): capture 0 -> R0, capture 1 -> R1.
// The captures load RIGHT-TO-LEFT (capture 1 first, capture 0 last).  If the base were
// the LIVE R1 (the entry data pointer), loading capture 1 (LDR R1, [R1, #4]) would
// CLOBBER the base before capture 0 (LDR R0, [R1, #0]) reads its field — a silent
// miscompile.  The pack framing re-homes the base into R5, so both loads read [R5 + ofs];
// then the tuple field-per-register store writes r0->[R4+0] / r1->[R4+4]:
//   ... push / sub / stage r0..r3 / stash retbuf / re-home data -> R5 ...
//   LDR R1, [R5, #4]        ; capture1 -> R1 (right-to-left, first) from the R5 base
//   LDR R0, [R5, #0]        ; capture0 -> R0 (last) from the R5 base
//   BL underlying ; reload retbuf ; STR R0,[R4,#0] ; STR R1,[R4,#4] ; teardown
// MUTATION-VERIFY: a captureBase = live R1 (instead of R5) would emit
// `LDR R1,[R1,#4]; LDR R0,[R1,#0]` — clobbering the base at capture 1.  This reference
// (both loads from R5) FAILS under that captureBase=R1 mutation, proving the base
// survives even under the multi-return post-BL store.
func TestClosureShimMultiRetSmall2Cap0UserCaptureBaseSurvivesByteRef() testing.TestResult {
	setArm32Target()
	var f @ir.Func = mkIntCaptureClosure(2, intParams(0))
	var results @[]@types.Type = intResultsMulti(2)
	var noParams @[]@types.Param
	var fv @types.Type = closureFvType(noParams, results)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitClosureShimArm32(got, "bn_ul", fv, f)
	if got.HasError { return fail("2-cap/0-user small-multiret closure shim must not error") }

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Push(ref, arm32.COND_AL, packClosurePushMask())
	emitSpAdjust(ref, false, 24)
	arm32.Str(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.SP, 4)) // stage g=0 (retbuf)
	arm32.Str(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.SP, 8)) // stage g=1 (data)
	arm32.Str(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.SP, 12)) // stage g=2
	arm32.Str(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.SP, 16)) // stage g=3
	arm32.Str(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.SP, 0)) // stash retbuf
	arm32.Ldr(ref, arm32.COND_AL, arm32.R5, arm32.MemImm(arm32.SP, 8)) // re-home data -> R5
	arm32.Ldr(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.R5, 4)) // capture1 -> R1 (from R5)
	arm32.Ldr(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R5, 0)) // capture0 -> R0 (from R5)
	ref.SetGlobal("bn_ul")
	arm32.Bl(ref, arm32.COND_AL, "bn_ul")
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 0)) // reload retbuf
	arm32.Str(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R4, 0)) // tuple field0 (r0) -> [R4+0]
	arm32.Str(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.R4, 4)) // tuple field1 (r1) -> [R4+4]
	emitSpAdjust(ref, true, 24)
	arm32.Pop(ref, arm32.COND_AL, packClosurePopMask())

	if !asmTextEqSpill(got, ref) {
		return fail(
				"2-cap/0-user small-multiret closure shim bytes must match the R5-based "
						"capture loads (capture1 -> R1 and capture0 -> R0 BOTH from [R5], not the "
						"live R1 base) — the capture-base-survival crux, under the tuple store")
	}
	return ""
}

// A 1-int-capture / 0-user closure returning a BIG multi-return (int, int, int, int, int)
// — gpWords 5 > NumGpRetRegs (4), so it rides the C.1 SRET shape UNCHANGED (retbuf stays
// in R0, the underlying writes each of the 5 fields through R0; no post-BL routing).
// Byte-identical to the C.1 big-single-aggregate sret 1-cap/0-user reference (the sret
// emitter is result-shape-agnostic past the retbuf-in-R0 contract):
//   LDR R1, [R1, #0]   ; capture0 -> R1 (captureBase = R1, dense +1 past retbuf)
//   B underlying       ; tail-branch, R0 = retbuf untouched
// MUTATION-VERIFY: a small (field-per-register) misclassification would emit the PACK
// framing (a PUSH + framed BL) instead of this tail-branch; this reference (bare capture
// load + B) FAILS that mis-split, pinning the big/small word-count boundary.
func TestClosureShimMultiRetBig1Cap0UserByteRef() testing.TestResult {
	setArm32Target()
	var f @ir.Func = mkIntCaptureClosure(1, intParams(0))
	var results @[]@types.Type = intResultsMulti(5) // (int x5) -> gpWords 5 -> big sret
	var noParams @[]@types.Param
	var fv @types.Type = closureFvType(noParams, results)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitClosureShimArm32(got, "bn_ul", fv, f)
	if got.HasError { return fail("1-cap/0-user big-multiret closure shim must not error") }

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Ldr(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.R1, 0)) // capture0 -> R1
	ref.SetGlobal("bn_ul")
	arm32.B(ref, arm32.COND_AL, "bn_ul")

	if !asmTextEqMarshal(got, ref) {
		return fail(
				"1-cap/0-user big-multiret closure shim bytes must match the C.1 sret "
						"reference (R1-based capture load + tail-branch, retbuf stays R0) — a "
						"big multi-return reuses the sret path unchanged")
	}
	return ""
}

// A closure whose MULTI-RETURN tuple result contains a FLOAT FIELD must fail LOUDLY (P5):
// arm32 is soft-float with no HFA, so a float leaf anywhere in the tuple is a float scalar
// the GP-only field store would mis-place.  closureHasFloatPartsArm32 only rejects a float
// SCALAR single result — the separate closureResultHasFloatPartArm32 guard walks EVERY
// result field of a multi-return, so a (int, float32) tuple trips the P5 guard before the
// multi-return dispatch (had the guard only checked Results[0], the float in Results[1]
// would silently ride the GP field store — the guard-must-cover-tuple-fields crux).
func TestClosureShimMultiRetFloatFieldResultSetsError() testing.TestResult {
	setArm32Target()
	var f @ir.Func = mkIntCaptureClosure(1, intParams(0))
	// (int, float32): a small (gpWords 2) multi-return by shape, but the float SECOND
	// field must trip the P5 guard — proving the guard walks past Results[0].
	var results @[]@types.Type = make_slice(@types.Type, 2)
	results[0] = types.TypInt()
	results[1] = types.TypFloat32()
	var noParams @[]@types.Param
	var fv @types.Type = closureFvType(noParams, results)

	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitClosureShimArm32(a, "bn_ul", fv, f)
	if !a.HasError {
		return fail("a float-field multi-return-result closure shim must fail loud (P5)")
	}
	return ""
}
