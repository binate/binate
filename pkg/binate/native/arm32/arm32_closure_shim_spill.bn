package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Native arm32 closure-shim STACK-SPILL path: the over-budget capturing-closure /
// method-value shim (captures + user args exceed R0..R3, or a capture takes an
// AAPCS §6.5 C.3 even-pair pad), split out of arm32_closure_shim.bn to keep each
// file under the hygiene length cap.  Mirrors
// aarch64_closure_shim_spill.bn's emitClosureShimStackSpillAA64 for the AAPCS32
// (4-GP-arg-reg, soft-float) case, reusing the non-closure spill marshal
// (emitSpillMarshalArm32 in arm32_funcvalue_spill.bn) with a CAPTURE-PREFIX classify.
//
// The shim is entered under the uniform all-int dispatch ABI `<ret>(data, user
// args…)` — the capture-struct pointer in R0, user args in R1..  The underlying's
// REAL ABI PREPENDS the captures as leading params (`underlying(captures…,
// user_args…)`); on AAPCS32's 4 GP arg regs the total captures + user words spill
// to the stack far sooner than on aa64's 8, so this framed-BL shim is common.
//
// The single load-bearing correctness surface (a SILENT MISCOMPILE if wrong) is the
// CAPTURE-PREFIX classify: the user args must classify over the FULL captures++users
// type list (argTypes) at classifyBase = NumCaptureParams — so the classifier's
// running NGRN reaches each capture and user arg at its ABSOLUTE (post-capture)
// register index, and the AAPCS §6.5 C.3 even-pair pads land at the same parity the
// callee reads.  captureWords + a dense cursor would drop the pads (see
// aarch64_closure_shim_spill.bn's userArgStart = f.NumCaptureParams — the identical
// structure).  Captures and users are placed at their authoritative
// CallArgRegStart(argTypes, k) / CallArgStackOff(argTypes, k) positions, so a
// capture-even-pair pad or a SPLIT capture is handled here (unlike the fast path's
// dense-cursor capture load).  An indirect-large (>16-byte) aggregate capture still
// fails LOUDLY upstream (no pointer-pass capture-load path on arm32) — the caller
// routes it away before reaching this shim.

// emitClosureShimSpillArm32 emits the framed-BL over-budget capturing shim.  Frame
// and ordering (mirrors emitClosureShimStackSpillAA64, with AAPCS32's push/pop
// frame and IP/R4 in place of X16/X9):
//   1. push {r4, lr}                 -- save the caller's R4 (memory→memory shuttle)
//                                       and LR (BL clobbers it); 2 regs keep SP
//                                       8-aligned.
//      sub sp, sp, #innerBytes       -- reserve outgoing-args + staging.
//   2. Stage every incoming GP dispatch reg (r0..r3) to the frame.  The captures
//      prepend into the low outgoing regs, so the user args UP-shift (outgoing reg
//      index > incoming) — an outgoing write could clobber a later user arg's
//      not-yet-read incoming reg, so every source is read from the staged frame
//      (the emitShimArgMarshalArm32 forceStage rationale, applied to the spill
//      marshal).  Staging R0 too is harmless — R0 the REGISTER stays live through the
//      capture loads that need it: for a GP capture the user args start at reg index
//      >= captureWords >= 1 (a GP capture consumes a GP reg), so the marshal never
//      writes R0 and step 5's right-to-left GP reg-load reads it safely.  Under
//      hard-float a float-ONLY-capture set consumes NO GP word, so a GP user arg CAN
//      land in R0 and the marshal DOES write it — but the float captures are already
//      VLDR'd off R0 in step 3b (before the marshal), and float-only captures have no
//      step-5 GP reg-load, so the clobber is harmless (inc 3f b4a).
//   3. Spill stack-bound capture words from [R0 + FieldOffset] to their outgoing
//      stack offsets (via IP), while R0 is live.
//   3b. Load hard-float scalar float captures into their VFP registers from [R0 +
//      FieldOffset] (emitClosureCaptureVfpLoadArm32), BEFORE the marshal while R0 is
//      live.  Inert on soft-float.
//   4. Marshal the user args incoming→outgoing via the shared spill marshal, with the
//      CAPTURE-PREFIX classify (argTypes = captures++users, classifyBase =
//      NumCaptureParams, srcPrefix = 1).
//   5. Load register-bound (GP) capture words from [R0 + FieldOffset] into their
//      outgoing arg regs, RIGHT-TO-LEFT (i=0 last so R0 stays a valid base until the
//      final load, whose destination may be R0 itself).
//   6. bl underlying; add sp, sp, #innerBytes; pop {r4, pc}.  BL (not a tail-branch):
//      LR is saved on the stack and the frame must be torn down before RET.
func emitClosureShimSpillArm32(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type, f @ir.Func,
		cc common.CallConv, argTypes @[]@types.Type) {
	// A SCALAR float PARAM is handled here: emitSpillMarshalArm32 SKIPS it
	// (hardFloatShimSkipArm32; it rides VFP), and emitClosureParamVfpUpShiftArm32 relocates it to
	// its outgoing slot — a VFP register (up-shifted past the float captures, inc 3f b4b) or, once
	// the float captures push it past d0..d7, its outgoing STACK slot (inc 3f b5).  A scalar float
	// CAPTURE is loaded into its VFP register by emitClosureCaptureVfpLoadArm32 (inc 3f b4a), or
	// spilled as raw stack words if bank-overflowed.  A float nested in an AGGREGATE param/capture
	// is float-agnostic on the GP path.  A back-fill DOWN-MOVE reorder is handled by the up-shift's
	// cycle-agnostic parallel move.  Inert on soft-float.
	// outBytes = the outgoing-args area for the FULL captures++users call (both a
	// stack-bound capture's SPLIT tail and an over-budget user arg spill here).
	// CallStackBytes already rounds to StackAlign (8).
	var outBytes int = cc.CallStackBytes(argTypes)
	var savedBytes int = 8
	// Staging sits above the outgoing-args area; every incoming GP dispatch reg is
	// staged so the up-shifted user marshal reads clobber-safe sources.
	var stageOff int = outBytes
	var innerBytes int = stageOff + cc.NumGpArgRegs * cc.WordBytes
	if innerBytes % cc.StackAlign != 0 {
		innerBytes = innerBytes + (cc.StackAlign - innerBytes % cc.StackAlign)
	}
	// frameDelta = the SP decrement from shim entry ({r4,lr} save + inner area), used
	// by the spill marshal to address the dispatch caller's incoming-overflow words.
	var frameDelta int = savedBytes + innerBytes

	arm32.Push(a, arm32.COND_AL, packShimPushMask())
	if innerBytes > 0 {
		emitSpAdjust(a, false, innerBytes)
	}
	// Stage r0..r3 before any outgoing write; the marshal reads register-source words
	// from [sp + stageOff + WordBytes*g].  emitFrameStore (not a raw STR) materializes a
	// large stageOff into IP as its address scratch — a many-capture closure's staging
	// area sits above a > 4095-byte outgoing-args area — so the store stays correct
	// instead of tripping imm12Offset's loud range error (argReg(g) is R0..R3, never the
	// IP scratch, so no aliasing).
	for g := 0; g < cc.NumGpArgRegs; g++ {
		emitFrameStore(a, argReg(g), stageOff + cc.WordBytes * g)
	}
	// Step 3: spill stack-bound capture words from the closure-struct base (R0, live).
	emitClosureCaptureSpillArm32(a, cc, f, argTypes, 0, arm32.R0)
	// Step 3a: relocate the scalar float USER params to their outgoing slots (up-shift past float
	// captures, and place any that spill the VFP bank on the outgoing stack) — BEFORE the capture
	// VFP load, whose LOW capture slots may overlap a param's incoming slot (inc 3f b4b/b5).
	emitClosureParamVfpUpShiftArm32(a, cc, fvTyp, f, argTypes, 0, frameDelta)
	// Step 3b: load hard-float scalar float captures into their VFP registers from
	// [R0 + FieldOffset] — BEFORE the marshal, while R0 is live (a float capture consumes no
	// GP word, so a GP user arg can land in R0 and the marshal would clobber it; inc 3f b4a).
	emitClosureCaptureVfpLoadArm32(a, cc, f, argTypes, 0, arm32.R0)
	// Step 4: marshal the user args over the CAPTURE-PREFIX classify (argTypes =
	// captures++users, classifyBase = NumCaptureParams, srcPrefix = 1 drops the data
	// word).  staged = true (every incoming word was staged above).
	var userTypes @[]@types.Type = shimUserTypesArm32(fvTyp)
	emitSpillMarshalArm32(a, cc, argTypes, f.NumCaptureParams, userTypes, 1, frameDelta, stageOff,
			true)
	// Step 5: load register-bound capture words from R0 into their outgoing regs,
	// right-to-left so R0 survives until the last (i=0) load.
	emitClosureCaptureRegLoadSpillArm32(a, cc, f, argTypes, 0, arm32.R0)
	// Step 6: BL, tear down the frame, and return.
	a.SetGlobal(fnLabel)
	arm32.Bl(a, arm32.COND_AL, fnLabel)
	if innerBytes > 0 {
		emitSpAdjust(a, true, innerBytes)
	}
	arm32.Pop(a, arm32.COND_AL, packShimPopMask())
}

// emitClosureCaptureSpillArm32 spills every STACK-BOUND capture word to the outgoing-
// args area at [SP + CallArgStackOff(classifyTypes, classifyOff + i)], reading each capture
// word from [captureBase + FieldOffset] into R4 — a word LDR (emitBaseLoad) for a word-
// aligned capture, or a BYTE-WISE build (emitBytewiseWordLoadArm32) for a sub-word-aligned
// aggregate whose packed offset a word LDR could not reach on strict-align arm32 — and
// storing them through emitFrameStore.  classifyOff / classifyTypes / captureBase select
// the shape: (0, argTypes = captures++users, R0) for the scalar/void shim, and (1,
// sretTypes = [*uint8]++captures++users, R1) for a Phase-C sret shape whose R0 holds the
// retbuf — so capture i classifies at classifyOff + i and loads from the live closure-
// struct pointer captureBase.  A
// capture that SPLITs (some words in regs, the rest on the stack) spills only its stack
// tail here; the reg part is loaded by emitClosureCaptureRegLoadSpillArm32.  The outgoing
// store is a plain WordBytes STR (AAPCS32 does not pack narrow stack args —
// NaturalSizeStackArgs is unset, so every stack word is a full 4-byte slot).
//
// LARGE OFFSETS.  Both the field LOAD and the outgoing STORE go through the address-
// materializing wrappers (emitBaseLoad / emitFrameStore) — never the raw arm32.Ldr/Str,
// which trips imm12Offset's LOUD range error past the 12-bit LDR/STR immediate (4095).
// The two offsets diverge and each can cross 4095 independently: the field offset grows
// with the closure struct, while the stack offset grows 4 bytes PER stack-bound capture
// even for a sub-word (char / int16) capture — which packs to 1-2 bytes in the struct but
// takes a full 4-byte outgoing slot — so the STACK offset can pass 4095 while the FIELD
// offset stays small (e.g. ~1100 char captures: field offset ~1028, stack offset ~4096).
//
// The VALUE shuttles through R4, NOT IP, precisely because of that store materialization:
// with the value in IP, emitFrameStore's `emitConstInt32(IP, off)` for a > 4095 stack
// offset would OVERWRITE the loaded capture with the offset constant and store garbage —
// the exact rt == scratch == IP aliasing emitBaseStore forbids (the hazard arm32_iface.bn
// already shuttles around).  R4 is saved by the shim's entry push {r4, lr}, so it is a
// legal callee-preserved shuttle — the same value/address split (R4 value, IP address)
// the non-closure spill emitSpillSrcToMemArm32 uses.
//
// Indirect-large captures are excluded upstream (no pointer-pass path), so every capture
// here is a per-word scalar / small-aggregate whose value-words load directly (word-aligned)
// or byte-wise (sub-word-aligned aggregate).  Mirrors emitClosureCaptureSpillAA64 at the
// arm32 (no indirect-large, no natural-narrow-store) surface; the byte-wise build is the
// strict-align addition AA64 (unaligned-tolerant) does not need.
func emitClosureCaptureSpillArm32(a @asm.Assembler, cc common.CallConv, f @ir.Func,
		classifyTypes @[]@types.Type, classifyOff int, captureBase int) {
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var regStart int = cc.CallArgRegStart(classifyTypes, classifyOff + i)
		var stkOff int = cc.CallArgStackOff(classifyTypes, classifyOff + i)
		var fieldOfs int = f.ClosureStruct.FieldOffset(i)
		if stkOff < 0 { continue }
		var nWords int = cc.ArgWords(ft)
		// A SUB-word-aligned aggregate capture is packed at a possibly non-word offset,
		// so its words must be assembled BYTE-WISE (a word LDR would fault on strict-align
		// arm32); a word-aligned capture rides the fast word load.  The byte-wise word
		// build shuttles through R4 (the value), IP (field-address scratch), and R2 (byte
		// temp — a staged, non-captureBase arg reg, free before the step-4 marshal).
		var byteWise bool = aggNeedsBytewiseArm32(ft)
		var ftSz int = ft.SizeOf()
		// The first firstStackWord words rode registers (a SPLIT capture); only the
		// tail spills.  A wholly-stack capture has regStart < 0 -> firstStackWord 0.
		var firstStackWord int = 0
		if regStart >= 0 {
			firstStackWord = cc.NumGpArgRegs - regStart
		}
		for k := firstStackWord; k < nWords; k = k + 1 {
			if byteWise {
				var nb int = cc.WordBytes
				if ftSz - k * cc.WordBytes < nb { nb = ftSz - k * cc.WordBytes }
				emitBytewiseWordLoadArm32(a, arm32.R4, captureBase, fieldOfs + k * cc.WordBytes, nb, arm32.IP,
						arm32.R2)
			} else {
				emitBaseLoad(a, arm32.R4, captureBase, fieldOfs + k * cc.WordBytes, arm32.IP)
			}
			emitFrameStore(a, arm32.R4, stkOff + (k - firstStackWord) * cc.WordBytes)
		}
	}
}

// emitClosureCaptureRegLoadSpillArm32 loads every REGISTER-BOUND capture word into
// its outgoing arg register from [captureBase + FieldOffset], using the capture's
// authoritative classifier position CallArgRegStart(classifyTypes, classifyOff + i) — so
// an even-pair-padded or SPLIT capture lands on the correctly-aligned register (the reg
// part; the stack part was spilled by emitClosureCaptureSpillArm32).  classifyOff /
// classifyTypes / captureBase are (0, captures++users, R0) for the scalar/void shim and
// (1, [*uint8]++captures++users, R1) for a Phase-C sret shape (R0 = retbuf).  Iterates
// captures RIGHT-TO-LEFT and, within a capture, high word first, so the i=0 case (which
// targets captureBase's own register) runs LAST — keeping captureBase (the closure-struct
// pointer) live until the final load.  Unlike the fast path's emitClosureCaptureRegLoadArm32 (dense
// captureWords cursor, no pads), this reads the classifier position directly and so
// serves the padded / SPLIT captures the fast path routes here.  A sub-word-aligned
// aggregate capture (packed at a possibly non-word offset) is assembled BYTE-WISE
// (emitBytewiseWordLoadArm32, R4 field-address scratch + IP byte temp — both free at this
// post-marshal step) rather than a faulting word LDR; the strict-align closure captures
// route here (closureCaptureNeedsBytewiseArm32) precisely so this path serves them.  Mirrors
// emitClosureCaptureRegLoadAA64 at the arm32 (no indirect-large pointer-pass) surface.
func emitClosureCaptureRegLoadSpillArm32(a @asm.Assembler, cc common.CallConv, f @ir.Func,
		classifyTypes @[]@types.Type, classifyOff int, captureBase int) {
	for i := f.NumCaptureParams - 1; i >= 0; i = i - 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var regStart int = cc.CallArgRegStart(classifyTypes, classifyOff + i)
		var fieldOfs int = f.ClosureStruct.FieldOffset(i)
		if regStart < 0 { continue }
		var nWords int = cc.ArgWords(ft)
		// A SUB-word-aligned aggregate capture is packed at a possibly non-word offset, so
		// each reg word is assembled BYTE-WISE (a word LDR would fault on strict-align
		// arm32).  The build shuttles the field address through R4 and each byte through IP
		// (both free at this post-marshal reg-load step); the destination is the capture's
		// own outgoing arg register, so capture 0's base-aliasing dst is safe (the base is
		// read once into R4 before any write, and capture 0 loads last).
		var byteWise bool = aggNeedsBytewiseArm32(ft)
		var ftSz int = ft.SizeOf()
		// A SPLIT capture loads only its reg portion (the tail spilled to the stack).
		var regWords int = nWords
		if cc.CallArgStackOff(classifyTypes, classifyOff + i) >= 0 {
			regWords = cc.NumGpArgRegs - regStart
		}
		for k := regWords - 1; k >= 0; k = k - 1 {
			if byteWise {
				var nb int = cc.WordBytes
				if ftSz - k * cc.WordBytes < nb { nb = ftSz - k * cc.WordBytes }
				emitBytewiseWordLoadArm32(a, argReg(regStart + k), captureBase, fieldOfs + k * cc.WordBytes, nb,
						arm32.R4, arm32.IP)
			} else {
				arm32.Ldr(a, arm32.COND_AL, argReg(regStart + k),
						arm32.MemImm(captureBase, fieldOfs + k * cc.WordBytes))
			}
		}
	}
}

// emitClosureCaptureVfpLoadArm32 loads every hard-float SCALAR float CAPTURE that rides a
// VFP register into that register, VLDR'ing it from [captureBase + FieldOffset] via
// vfpLoadBaseHard (inc 3f b4a).  It MUST be called BEFORE the user-arg marshal, while the
// closure data base (captureBase) is still live: a float capture consumes NO GP word, so a
// GP user arg can land in captureBase itself, and the marshal would then clobber the base
// before any post-marshal capture load reads it — loading the VFP captures first sidesteps
// that.  (A GP capture, by contrast, consumes a GP reg and so keeps user args off the base,
// which is why the GP reg-load helper stays safe running AFTER the marshal; the pack core's
// re-homed R5 base survives the marshal regardless.)  The VFP file is disjoint from the GP
// base register, so these loads need no right-to-left ordering.  A float capture that BANK-
// OVERFLOWED (CallArgFpReg hwSlot < 0) rode the outgoing stack instead — spilled as raw
// words by emitClosureCaptureSpillArm32 — so it is skipped here.  classifyOff / classifyTypes
// / captureBase mirror the sibling capture helpers: (0, captures++users, R0 / R5) for the
// scalar-void & pack shims, (1, [*uint8]++captures++users, R1) for the sret shim.  IP is the
// >1020 address scratch (free at this pre-marshal step).  Inert on soft-float, where a float
// capture rides GP and is loaded by the GP reg-load / spill helpers instead.
func emitClosureCaptureVfpLoadArm32(a @asm.Assembler, cc common.CallConv, f @ir.Func,
		classifyTypes @[]@types.Type, classifyOff int, captureBase int) {
	if !types.Arm32HardFloat() { return }
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		if !common.IsFloatScalarTyp(ft) { continue }
		var hwSlot int
		var isDouble bool
		hwSlot, isDouble = cc.CallArgFpReg(classifyTypes, classifyOff + i)
		if hwSlot < 0 { continue }
		vfpLoadBaseHard(a, isDouble, fpRegForSlot(hwSlot, isDouble), captureBase,
				f.ClosureStruct.FieldOffset(i), arm32.IP)
	}
}

// emitClosureParamVfpUpShiftArm32 relocates a closure's scalar float USER params from their
// INCOMING VFP slots (CallArgFpReg over the users-only allocation, where the dispatch caller
// placed them; the GP data/retbuf prefix consumes no VFP) to their OUTGOING slots (CallArgFpReg
// over captures++users, classifyOff + NumCaptureParams + j).  When the closure has float
// captures those captures occupy the leading VFP slots, so a param shifts UP — but AAPCS-VFP
// back-fill can also drop a NARROWER param DOWN into the odd hole a wider param's even-alignment
// left, so the relocation is a general PERMUTATION (possibly with cycles), NOT a monotonic shift.
// It is done cycle-agnostically as a MEMORY-STAGED parallel move: reserve nFloat 8-byte scratch
// slots (SUB sp), VSTR every incoming float param to its slot, VLDR every one into its outgoing
// VFP register, then release (ADD sp).  Every incoming value reaches memory before any outgoing
// write, so no move clobbers a not-yet-read source regardless of the permutation — this is what a
// prior single-order VMOV shift got wrong for a back-fill down-move (a silent-miscompile 2-cycle).
// MUST run BEFORE the capture VFP load (its LOW capture slots may equal a param's incoming slot);
// the SUB/ADD are balanced so the staged r0..r3 and the GP captureBase are untouched by the
// following capture load / marshal.  classifyTypes / classifyOff mirror the capture load:
// (argTypes, 0) for the scalar-void & pack shims, (sretTypes, 1) for the sret shim (the leading
// *uint8 retbuf is GP, so it does not shift the VFP slots).  Each incoming value is read into its
// scratch slot from wherever the dispatch delivered it — a VFP register (ih >= 0) via VSTR, or,
// when the declared float params exceed the VFP bank so the param arrives STACKED (ih < 0), from
// the caller's stack at [SP + stageBytes + frameDelta + CallArgStackOff(userTypes, j)] (frameDelta
// = the shim's entry SP decrement).  Each is then placed at its outgoing slot — a VFP register
// (oh >= 0) via VLDR, or, if its captures++users slot spills the bank (oh < 0), copied to its
// outgoing STACK slot.  So all four incoming/outgoing reg/stack combinations are handled (inc 3f
// b4b up-shift + b5 outgoing/incoming spill) — a cycle-agnostic parallel move.  Runs only
// in the FRAMED shims (the frameless tail-branch shims pass a stacked float straight through, so
// they never call this); inert when no float param needs relocation (no captures + every param
// register-resident on both sides — incoming == outgoing) and on soft-float.
func emitClosureParamVfpUpShiftArm32(a @asm.Assembler, cc common.CallConv, fvTyp @types.Type,
		f @ir.Func, classifyTypes @[]@types.Type, classifyOff int, frameDelta int) {
	if !types.Arm32HardFloat() { return }
	var userTypes @[]@types.Type = funcValueParamTypesArm32(fvTyp)
	var n int = len(userTypes)
	// Relocation is needed when the float captures shift the VFP file (up-shift), OR when a float
	// param's INCOMING or OUTGOING slot spills the VFP bank (a stacked float the shim's frame
	// moves).  With no float captures and every float param register-resident on both sides,
	// incoming == outgoing and there is nothing to do (the frameless tail-branch shims never call
	// this).
	var nFloat int = 0
	var needsReloc bool = anyCaptureHasScalarFloatArm32(f)
	for j := 0; j < n; j = j + 1 {
		if !common.IsFloatScalarTyp(userTypes[j]) { continue }
		nFloat = nFloat + 1
		var ci int
		ci, _ = cc.CallArgFpReg(userTypes, j)
		var co int
		co, _ = cc.CallArgFpReg(classifyTypes, classifyOff + f.NumCaptureParams + j)
		if ci < 0 || co < 0 { needsReloc = true }
	}
	if nFloat == 0 || !needsReloc { return }
	// Reserve nFloat 8-byte stage slots below SP (nFloat*8 is 8-aligned, so SP stays
	// AAPCS32-aligned).  The SUB/ADD are balanced within this helper, so the staged r0..r3 and
	// the GP captureBase register are untouched by the marshal / capture load that follow.
	var stageBytes int = nFloat * 8
	emitSpAdjust(a, false, stageBytes)
	// Stage 1 — read every incoming float param into its scratch slot.  A register-resident param
	// (ih >= 0) is VSTR'd from its incoming VFP reg (where the dispatch caller placed it per the
	// users-only allocation).  An INCOMING-SPILLED param (ih < 0 — the declared float params exceed
	// the VFP bank, so the dispatch delivers it stacked) is copied word-by-word from the caller's
	// stack at [SP + stageBytes + frameDelta + CallArgStackOff(userTypes, j)]: frameDelta is the
	// shim's entry SP decrement, and the GP data/retbuf prefix rides registers so the users-only
	// allocation gives the caller-side float stack offset.  Shuttle via R4 (value) + IP (address).
	var slot int = 0
	for j := 0; j < n; j = j + 1 {
		if !common.IsFloatScalarTyp(userTypes[j]) { continue }
		var ih int
		var id bool
		ih, id = cc.CallArgFpReg(userTypes, j)
		if ih >= 0 {
			vfpStoreBaseHard(a, id, fpRegForSlot(ih, id), arm32.SP, slot * 8, arm32.IP)
		} else {
			var inStk int = cc.CallArgStackOff(userTypes, j)
			var words int = userTypes[j].SizeOf() / cc.WordBytes
			for w := 0; w < words; w = w + 1 {
				emitBaseLoad(a, arm32.R4, arm32.SP, stageBytes + frameDelta + inStk + w * cc.WordBytes,
						arm32.IP)
				emitFrameStore(a, arm32.R4, slot * 8 + w * cc.WordBytes)
			}
		}
		slot = slot + 1
	}
	// Stage 2 — place every param at its OUTGOING slot (captures++users allocation).  All
	// incoming values are now in memory, so a param whose outgoing slot equals another param's
	// incoming slot (an AAPCS-VFP back-fill down-move / cycle) reads the memory copy, never a
	// clobbered register — a cycle-agnostic parallel move.  A param whose outgoing slot fits the
	// VFP bank (oh >= 0) is VLDR'd into that register; one whose outgoing slot SPILLS the bank
	// (oh < 0 — the float captures or an over-budget float-param list pushed it past the 16 S / 8 D
	// arg slots) is copied to its outgoing STACK slot instead — the underlying reads it there.
	slot = 0
	for j := 0; j < n; j = j + 1 {
		if !common.IsFloatScalarTyp(userTypes[j]) { continue }
		var oh int
		var od bool
		oh, od = cc.CallArgFpReg(classifyTypes, classifyOff + f.NumCaptureParams + j)
		if oh >= 0 {
			vfpLoadBaseHard(a, od, fpRegForSlot(oh, od), arm32.SP, slot * 8, arm32.IP)
		} else {
			// OUTGOING VFP-bank spill: copy the staged param (at [SP + slot*8]) to its outgoing
			// stack slot.  SP is currently stageBytes below the shim's outgoing-args area, so the
			// slot's authoritative offset CallArgStackOff(...) is reached at SP + stageBytes + oStk
			// (it survives the balancing ADD SP below — it lives in the outgoing-args area, not the
			// released scratch).  The value shuttles through R4 (free at this pre-marshal step) and
			// IP (emitBaseLoad / emitFrameStore's large-offset address scratch); a float64 is two
			// words, a float32 one.
			var oStk int = cc.CallArgStackOff(classifyTypes, classifyOff + f.NumCaptureParams + j)
			var words int = userTypes[j].SizeOf() / cc.WordBytes
			for w := 0; w < words; w = w + 1 {
				emitBaseLoad(a, arm32.R4, arm32.SP, slot * 8 + w * cc.WordBytes, arm32.IP)
				emitFrameStore(a, arm32.R4, stageBytes + oStk + w * cc.WordBytes)
			}
		}
		slot = slot + 1
	}
	emitSpAdjust(a, true, stageBytes)
}
