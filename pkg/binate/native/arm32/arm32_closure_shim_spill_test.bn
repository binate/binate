package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Byte-level tests for the arm32 capturing-closure / method-value STACK-SPILL shim
// (arm32_closure_shim_spill.bn, P4-d Phase B): a closure whose captures + user args
// overflow R0..R3, or whose captures take an AAPCS §6.5 C.3 even-pair pad, routes to
// the framed-BL spill shim.  Each shape is compared byte-for-byte against a hand-
// built reference so the frame, the incoming-reg staging, the stack-bound-capture
// spill (value via R4), the user-arg marshal at the CAPTURE-PREFIX classify (classifyBase =
// NumCaptureParams), the right-to-left register-capture loads, the BL, and the frame
// teardown are all pinned.  End-to-end behavior is covered by conformance 523/524/898
// /899 (+ many-arg method values) in builder-comp_native_arm32_baremetal.
//
// Shared helpers (mkIntCaptureClosure / intParams / closureFvType / setArm32Target /
// packShim{Push,Pop}Mask / emitSpAdjust / asmTextEqSpill / fail) live in the sibling
// arm32 native test files (same package).

// A closure whose captures + user args overflow R0..R3 now emits the framed-BL
// STACK-SPILL shim (P4-d Phase B) — it used to fail loud.  3 int captures + 3 int
// users = 6 words > 4 GP regs.  Byte-compared against the hand-built reference:
//   ; frame + stage the 4 incoming GP dispatch regs
//   PUSH {r4, lr}
//   SUB SP, SP, #24         ; innerBytes = stageOff(8) + 4*4 = 24 (8-aligned)
//   STR R0, [SP, #8]        ; stage g=0 (data)
//   STR R1, [SP, #12]       ; stage g=1 (user0 incoming)
//   STR R2, [SP, #16]       ; stage g=2 (user1 incoming)
//   STR R3, [SP, #20]       ; stage g=3 (user2 incoming)
//   ; (no stack-bound captures: caps 0..2 ride R0..R2)
//   ; user marshal, CAPTURE-PREFIX classify (classifyBase=3, srcPrefix=1):
//   LDR R3, [SP, #12]       ; user0 -> R3 (classifier index 3, from staged g=1)
//   LDR R4, [SP, #16]       ; user1 -> outgoing stack[0] (staged g=2, via R4)
//   STR R4, [SP, #0]
//   LDR R4, [SP, #20]       ; user2 -> outgoing stack[4] (staged g=3, via R4)
//   STR R4, [SP, #4]
//   ; register captures right-to-left (i=0 last keeps R0 base):
//   LDR R2, [R0, #8]        ; capture2 -> R2
//   LDR R1, [R0, #4]        ; capture1 -> R1
//   LDR R0, [R0, #0]        ; capture0 -> R0 (last)
//   BL underlying
//   ADD SP, SP, #24
//   POP {r4, pc}
// MUTATION-VERIFY: the CAPTURE-PREFIX classify (classifyBase = NumCaptureParams = 3)
// is what places user0 at R3 (past the 3 captures at R0..R2) and spills user1/user2.
// A classify-over-users-only (classifyBase 0) would place user0 at R0 — clobbering
// capture0's register and reading the wrong incoming slots — a different byte
// sequence this reference FAILS under.
func TestClosureShimRegisterOverflowStackSpillByteRef() testing.TestResult {
	setArm32Target()
	var f @ir.Func = mkIntCaptureClosure(3, intParams(3))
	var noResults @[]@types.Type
	var fv @types.Type = closureFvType(intParams(3), noResults)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitClosureShimArm32(got, "bn_ul", fv, f)
	if got.HasError { return fail("3-cap/3-user closure spill shim must not error") }

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Push(ref, arm32.COND_AL, packShimPushMask()) // push {r4, lr}
	emitSpAdjust(ref, false, 24) // sub sp, sp, #24
	arm32.Str(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.SP, 8)) // stage g=0
	arm32.Str(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.SP, 12)) // stage g=1
	arm32.Str(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.SP, 16)) // stage g=2
	arm32.Str(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.SP, 20)) // stage g=3
	arm32.Ldr(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.SP, 12)) // user0 -> R3
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 16)) // user1 -> stack[0]
	arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 0))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 20)) // user2 -> stack[4]
	arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 4))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.R0, 8)) // capture2 -> R2
	arm32.Ldr(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.R0, 4)) // capture1 -> R1
	arm32.Ldr(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R0, 0)) // capture0 -> R0 (last)
	ref.SetGlobal("bn_ul")
	arm32.Bl(ref, arm32.COND_AL, "bn_ul")
	emitSpAdjust(ref, true, 24) // add sp, sp, #24
	arm32.Pop(ref, arm32.COND_AL, packShimPopMask()) // pop {r4, pc}

	if !asmTextEqSpill(got, ref) {
		return fail(
				"3-cap/3-user closure spill shim bytes must match the framed-BL reference "
						"(stage r0..r3, user0->R3 + user1/user2 spilled at the CAPTURE-PREFIX "
						"classifyBase=3, right-to-left capture loads, bl, teardown)")
	}
	return ""
}

// A closure with MORE captures than GP arg regs: 5 int captures + 1 int user.  The
// 5th capture (cap4) rides the outgoing stack, so the STACK-BOUND-CAPTURE spill path
// (Step 1) fires: cap4's word is read from [R0, #16] and stored to the outgoing-args
// stack, while caps 0..3 load into R0..R3 (right-to-left) and the user rides the
// stack too.  Layout: caps 0..3 -> R0..R3, cap4 -> stack[0], user0 -> stack[4].
//   PUSH {r4, lr}
//   SUB SP, SP, #24
//   STR R0..R3, [SP, #8..#20]   ; stage
//   LDR R4, [R0, #16] ; STR R4, [SP, #0]   ; cap4 (stack-bound) spill via R4
//   LDR R4, [SP, #12] ; STR R4, [SP, #4]   ; user0 (staged g=1) -> stack[4] via R4
//   LDR R3, [R0, #12] ; ... ; LDR R0,[R0,#0]  ; register captures right-to-left
//   BL ; ADD SP ; POP
// This pins the Step-1 stack-bound-capture spill (value in R4, IP reserved for
// emitBaseLoad/emitFrameStore address materialization), distinct from the
// register-only capture case above.
func TestClosureShimStackBoundCaptureSpillByteRef() testing.TestResult {
	setArm32Target()
	var f @ir.Func = mkIntCaptureClosure(5, intParams(1))
	var noResults @[]@types.Type
	var fv @types.Type = closureFvType(intParams(1), noResults)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitClosureShimArm32(got, "bn_ul", fv, f)
	if got.HasError { return fail("5-cap/1-user closure spill shim must not error") }

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Push(ref, arm32.COND_AL, packShimPushMask())
	emitSpAdjust(ref, false, 24)
	arm32.Str(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.SP, 8)) // stage g=0
	arm32.Str(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.SP, 12)) // stage g=1 (user0)
	arm32.Str(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.SP, 16)) // stage g=2
	arm32.Str(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.SP, 20)) // stage g=3
	// Step 1: cap4 (stack-bound) spilled from [R0,#16] to outgoing stack[0] via R4
	// (value in R4, IP reserved as emitBaseLoad/emitFrameStore's address scratch).
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.R0, 16))
	arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 0))
	// Step 4: user0 (staged g=1) -> outgoing stack[4] via R4.
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 12))
	arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 4))
	// Step 5: register captures 3..0 right-to-left.
	arm32.Ldr(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.R0, 12))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.R0, 8))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.R0, 4))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R0, 0)) // (last)
	ref.SetGlobal("bn_ul")
	arm32.Bl(ref, arm32.COND_AL, "bn_ul")
	emitSpAdjust(ref, true, 24)
	arm32.Pop(ref, arm32.COND_AL, packShimPopMask())

	if !asmTextEqSpill(got, ref) {
		return fail(
				"5-cap/1-user closure spill shim bytes must match the stack-bound-capture "
						"reference (cap4 spilled from [R0,#16] via R4, user0 spilled, register "
						"captures 3..0 right-to-left)")
	}
	return ""
}

// A capture EVEN-PAIR pad routes to the spill shim even without a stack overflow: an
// (int32 cap, int64 cap) closure.  The int64 capture is 8-aligned, so after the int32
// at R0 it takes an AAPCS §6.5 C.3 pad (R1 wasted) and lands at R2:R3 — NOT the dense
// R1:R2 the fast path's captureWords cursor would use.  Everything fits R0..R3 (no
// stack), so this exercises the pad handling via the classifier-position capture load
// (no stack-bound captures, no user args).  Frame is push {r4,lr} + stage + BL:
//   PUSH {r4, lr}
//   SUB SP, SP, #16      ; stageOff = outBytes(0) = 0, innerBytes = 4*4 = 16
//   STR R0..R3, [SP, #0..#12]   ; stage (unused — no user args — but always emitted)
//   ; register captures right-to-left, at CLASSIFIER positions:
//   LDR R3, [R0, #12]    ; int64.hi (cap1 word 1) -> R3
//   LDR R2, [R0, #8]     ; int64.lo (cap1 word 0) -> R2  (regStart 2, the pad!)
//   LDR R0, [R0, #0]     ; int32 (cap0) -> R0 (last)
//   BL ; ADD SP, #16 ; POP
// MUTATION-VERIFY: the fast path's dense cursor would load the int64 at R1:R2 (dense
// captureWords). This reference (int64 at R2:R3, from the classifier pad) FAILS under
// that dense-cursor mutation.
func TestClosureShimCaptureEvenPairPadByteRef() testing.TestResult {
	setArm32Target()
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt32()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt64()
	var f @ir.Func = make(ir.Func)
	f.Name = "main.__funclit_pad"
	f.IsClosure = true
	f.NumCaptureParams = 2
	f.ClosureStruct = types.MakeStructType("__closure_pad", fields)
	var noP @[]@ir.Param
	f.Params = noP
	var noR @[]@types.Type
	f.Results = noR
	var noResults @[]@types.Type
	var noParams @[]@types.Param
	var fv @types.Type = closureFvType(noParams, noResults)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitClosureShimArm32(got, "bn_ul", fv, f)
	if got.HasError { return fail("int32/int64 capture-pad closure spill shim must not error") }

	// int64 (cap1) is 8-byte aligned, so ClosureStruct field offsets: cap0 int32 @0,
	// cap1 int64 @8 (a 4-byte pad after the int32).  Classifier over [int32, int64]:
	// cap0 -> R0, cap1 (8-aligned) even-pair-pads to R2:R3.  No stack, no users.
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Push(ref, arm32.COND_AL, packShimPushMask())
	emitSpAdjust(ref, false, 16) // stageOff 0, innerBytes = 4*4 = 16
	arm32.Str(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.SP, 0)) // stage g=0
	arm32.Str(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.SP, 4)) // stage g=1
	arm32.Str(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.SP, 8)) // stage g=2
	arm32.Str(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.SP, 12)) // stage g=3
	// cap1 int64 at classifier R2:R3, right-to-left (hi then lo), from field offset 8.
	arm32.Ldr(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.R0, 12)) // int64.hi -> R3
	arm32.Ldr(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.R0, 8)) // int64.lo -> R2 (pad R1)
	arm32.Ldr(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R0, 0)) // int32 cap0 -> R0 (last)
	ref.SetGlobal("bn_ul")
	arm32.Bl(ref, arm32.COND_AL, "bn_ul")
	emitSpAdjust(ref, true, 16)
	arm32.Pop(ref, arm32.COND_AL, packShimPopMask())

	if !asmTextEqSpill(got, ref) {
		return fail(
				"int32/int64 capture-pad closure shim must place the int64 capture at the "
						"even-pair-padded classifier position R2:R3 (NOT the dense R1:R2) — this "
						"pins the classifier-position capture load the pad routes to the spill path for")
	}
	return ""
}

// A closure with MANY captures drives a stack-bound capture's FIELD offset, and the
// incoming-register STAGING and outgoing STACK offsets, past the 12-bit LDR/STR immediate
// (4095): every such site must materialize the address in IP (emitFrameStore / emitBaseLoad
// / emitFrameLoad) with values shuttled through R0..R4 — NOT emit a raw arm32.Ldr/Str that
// trips imm12Offset's LOUD range error.  1200 int captures: caps 4..1199 spill (stack
// offsets to ~4784), cap 1024's field offset is 4096, and the staging area sits at
// stageOff ~4784.  This pins that a large-scalar-capture closure COMPILES rather than
// tripping the imm12 range error (the raw-offset regression the materializing wrappers fix).
func TestClosureShimLargeCaptureOffsetCompiles() testing.TestResult {
	setArm32Target()
	var noParams @[]@types.Param
	var f @ir.Func = mkIntCaptureClosure(1200, noParams)
	var noResults @[]@types.Type
	var fv @types.Type = closureFvType(noParams, noResults)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitClosureShimArm32(got, "bn_ul", fv, f)
	if got.HasError {
		return fail(
				"1200-capture closure spill must compile: the staging stores, the "
						"stack-bound-capture field load/store, and the user marshal past offset 4095 "
						"must materialize the address in IP, not trip the raw LDR/STR imm12 range error")
	}
	return ""
}

// A closure spilling past a 4095-byte frame that ALSO takes a by-address AGGREGATE
// argument: IP holds the aggregate's value-buffer pointer across its value-word loads and
// R4 carries the value, leaving no third register free to materialize a > 4095 outgoing
// stack offset — so emitSpillByAddrAggArm32 RE-READS the pointer per stack word (R4 free at
// the top of each word) and materializes the offset into IP.  This must COMPILE, not trip
// the raw imm12 error.  1030 int captures push an 8-byte (2-word) struct user arg wholly
// onto the stack at offset ~4104 (both words > 4095, so both take the re-read branch).
func TestClosureShimByAddrAggLargeFrameCompiles() testing.TestResult {
	setArm32Target()
	var structFields @[]@types.Field = make_slice(@types.Field, 2)
	structFields[0] = make(types.Field)
	structFields[0].Type = types.TypInt()
	structFields[1] = make(types.Field)
	structFields[1].Type = types.TypInt()
	var structTy @types.Type = types.MakeStructType("S8", structFields)
	var params @[]@types.Param = make_slice(@types.Param, 1)
	params[0] = make(types.Param)
	params[0].Type = structTy

	var noParams @[]@types.Param
	var f @ir.Func = mkIntCaptureClosure(1030, noParams)
	var noResults @[]@types.Type
	var fv @types.Type = closureFvType(params, noResults)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitClosureShimArm32(got, "bn_ul", fv, f)
	if got.HasError {
		return fail(
				"closure spilling past a 4095-byte frame with a by-address aggregate argument "
						"must compile via the by-address-agg re-read path, not trip the raw imm12 error")
	}
	return ""
}

// Byte-level pin of the by-address-aggregate RE-READ sequence emitSpillByAddrAggArm32 emits
// for a > 4095 outgoing offset: the pointer load, then per stack word — re-read the pointer
// into IP, load the value word from [IP, k*WordBytes], materialize the outgoing offset into
// IP, store [SP, IP].  Conformance cannot reach this (it needs > ~1024 spilled words), so
// this is the only byte-level coverage of the re-read path.  1030 ints push a 2-word struct
// wholly onto the stack at so ~4104 (both words > 4095 → both take the re-read branch).
func TestSpillByAddrAggReReadByteRef() testing.TestResult {
	setArm32Target()
	var cc common.CallConv = common.AAPCS32()
	var n int = 1030
	var ctypes @[]@types.Type = make_slice(@types.Type, n + 1)
	for i := 0; i < n; i++ {
		ctypes[i] = types.TypInt()
	}
	var structFields @[]@types.Field = make_slice(@types.Field, 2)
	structFields[0] = make(types.Field)
	structFields[0].Type = types.TypInt()
	structFields[1] = make(types.Field)
	structFields[1].Type = types.TypInt()
	var structTy @types.Type = types.MakeStructType("S8", structFields)
	ctypes[n] = structTy

	var srcG int = 1
	var frameDelta int = 16
	var stageOff int = 8
	var so int = cc.CallArgStackOff(ctypes, n)
	if so <= 0xfff {
		return fail("test setup: the struct's stack offset must exceed 4095 to exercise re-read")
	}

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitSpillByAddrAggArm32(got, cc, ctypes, n, structTy, srcG, frameDelta, stageOff, true)

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	// Wholly-stack agg: pointer load into IP, no reg value words.
	emitSpillSrcToRegArm32(ref, cc, srcG, frameDelta, stageOff, arm32.IP, true)
	// Two stack words, both > 4095: re-read pointer, load value, materialize offset, store.
	for k := 0; k < 2; k = k + 1 {
		emitSpillSrcToRegArm32(ref, cc, srcG, frameDelta, stageOff, arm32.IP, true)
		arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.IP, cc.WordBytes * k))
		emitConstInt32(ref, arm32.IP, so + cc.WordBytes * k)
		arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemReg(arm32.SP, arm32.IP))
	}

	if !asmTextEqSpill(got, ref) {
		return fail(
				"by-address-agg re-read sequence must match: pointer load, then per stack word "
						"re-read pointer + load value + materialize offset + store [SP, IP]")
	}
	return ""
}
