package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Comparison ops
// ============================================================
//
// arm32 has no CSINC/CSET.  The aarch64 idiom `CMP; CSINC rd, xzr, xzr, invCond`
// (rd = 1 iff the comparison holds) becomes the arm32 conditional-move idiom:
//
//   CMP    lhs, rhs
//   MOV    rd, #0            ; default false, unconditional
//   MOV<C> rd, #1            ; set true only when condition <C> holds
//
// where <C> is the DIRECT condition for the IR op (not the inverted one the
// aarch64 CSINC form needs), because we conditionally set the TRUE value rather
// than conditionally increment the false one.  64-bit-pair operands don't reach
// here (they fail loud in the dispatcher's tail before the compare delegate).

// emitCompare handles OP_EQ/NE/LT/LE/GT/GE via CMP + conditional MOV.  Returns
// true if it matched and emitted code.  Signedness is keyed on the OPERAND type
// (the result is always bool): an unsigned value with the high bit set sorts as
// "negative" under the signed condition codes, so unsigned operands route
// through the arm32 unsigned condition family (HS/HI/LS/LO).  Mirrors
// aarch64_ops.bn's emitCompare.
func emitCompare(a @asm.Assembler, pkgName *[]readonly char,
	rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_EQ && ins.Op != iropcode.OP_NE &&
		ins.Op != iropcode.OP_LT && ins.Op != iropcode.OP_LE &&
		ins.Op != iropcode.OP_GT && ins.Op != iropcode.OP_GE {
		return false
	}
	if len(ins.Args) != 2 { return false }
	// A float compare needs FCMP + ordered-FP conditions (DEFERRED, soft-float
	// is a later increment); integer CMP on float bits returns wrong answers for
	// NaN / signed-zero.  Fail loud rather than compare bit patterns.
	if ins.Args[0].Typ != nil && ins.Args[0].Typ.IsFloat() {
		a.SetError("native arm32: float comparison not implemented (P5)")
		return true
	}
	var lhs int = emitValOperand(a, pkgName, rm, ins.Args[0])
	var rhs int = emitValOperand(a, pkgName, rm, ins.Args[1])
	if lhs < 0 || rhs < 0 { return false }

	var rd int = nextReg(rm, ins.ID)
	arm32.Cmp(a, arm32.COND_AL, lhs, arm32.Reg(rhs))

	var cmpTyp @types.Type = common.UnwrapNamed(ins.Args[0].Typ)
	var isUnsigned bool = cmpTyp != nil &&
		cmpTyp.IsInteger() && !cmpTyp.Signed
	var cond int = condForOp(ins.Op, isUnsigned)
	// rd = 0 (false), then rd = 1 conditionally (true) — the arm32 analog of
	// aarch64's CSINC-from-XZR.  Both MOVs use the rotated-immediate form
	// (0 and 1 both encode trivially).
	arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Imm(0))
	arm32.Mov(a, cond, false, rd, arm32.Imm(1))
	return true
}

// condForOp returns the arm32 condition code that is TRUE exactly when the IR
// comparison holds, so `mov<cond> rd, #1` (after a preceding `mov rd, #0`) sets
// rd=1 iff the comparison is satisfied.  `isUnsigned` picks between the signed
// (LT/LE/GT/GE) and unsigned (LO/LS/HI/HS) condition-code families.  This is the
// DIRECT (non-inverted) condition — the inverse of aarch64_ops.bn's
// invertCondForOp, since that helper feeds a conditional-INCREMENT of the false
// path whereas we conditionally set the true path.
func condForOp(op int, isUnsigned bool) int {
	if op == iropcode.OP_EQ { return arm32.COND_EQ }
	if op == iropcode.OP_NE { return arm32.COND_NE }
	if isUnsigned {
		if op == iropcode.OP_LT { return arm32.COND_LO }  // a <u b
		if op == iropcode.OP_LE { return arm32.COND_LS }  // a <=u b
		if op == iropcode.OP_GT { return arm32.COND_HI }  // a >u b
		return arm32.COND_HS                          // OP_GE: a >=u b
	}
	if op == iropcode.OP_LT { return arm32.COND_LT }  // signed
	if op == iropcode.OP_LE { return arm32.COND_LE }  // signed
	if op == iropcode.OP_GT { return arm32.COND_GT }  // signed
	return arm32.COND_GE                          // OP_GE, signed
}
