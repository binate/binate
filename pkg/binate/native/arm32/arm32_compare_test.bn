package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for emitCompare (CMP + conditional-MOV, the arm32 analog of
// aarch64's CSINC).  Also hosts the shared two-operand instr builder used by the
// compare and the compute (arm32_ops_test.bn) tests.

// twoOpArm32 builds a binop/compare-shaped OP_<op> instr with two operands of
// type `typ`, whose SSA ids (10, 11) are pre-assigned registers in rm so
// getOperand resolves them without a spill reload.  The result instr is id 0.
func twoOpArm32(rm @common.RegMap, op int, typ @types.Type) @ir.Instr {
	rm.AssignReg(10, arm32.R5)
	rm.AssignReg(11, arm32.R6)
	var l @ir.Instr = make(ir.Instr)
	l.ID = 10
	l.Typ = typ
	var r @ir.Instr = make(ir.Instr)
	r.ID = 11
	r.Typ = typ
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, l)
	args = appendInstr_arm32cmptest(args, r)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = op
	ins.Typ = typ
	ins.Args = args
	return ins
}

// appendInstr_arm32cmptest grows a @[]@ir.Instr by one.
func appendInstr_arm32cmptest(s @[]@ir.Instr, v @ir.Instr) @[]@ir.Instr {
	var n @[]@ir.Instr = make_slice(@ir.Instr, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}

// emitCompare emits CMP + `mov rd, #0` + `mov<cond> rd, #1` (12 bytes) — the
// arm32 analog of aarch64's CSINC — and the conditional MOV carries the DIRECT
// condition for the op (LT for a signed OP_LT).
func TestCompareSignedLtEmitsCmpAndCondMov() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = twoOpArm32(rm, iropcode.OP_LT, types.TypInt())
	if !emitCompare(a, "main", rm, ins) {
		return fail("emitCompare must match OP_LT")
	}
	if bytesWritten(a) != 12 {
		return fail("compare should be CMP + MOV #0 + MOV<cond> #1 (12 bytes)")
	}
	// The third instruction is the conditional true-set; its condition code
	// (bits [31:28]) must be LT for a signed less-than.
	var w uint32 = word32(a, 8)
	if (w >> 28) != cast(uint32, arm32.COND_LT) {
		return fail("signed OP_LT's true-set MOV must be conditioned LT")
	}
	return ""
}

// emitCompare on an UNSIGNED operand uses the unsigned condition family (LO for
// `<u`), not the signed LT — a high-bit-set uint would otherwise sort negative.
func TestCompareUnsignedLtUsesLo() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = twoOpArm32(rm, iropcode.OP_LT, types.TypUint32())
	if !emitCompare(a, "main", rm, ins) {
		return fail("emitCompare must match OP_LT")
	}
	var w uint32 = word32(a, 8)
	if (w >> 28) != cast(uint32, arm32.COND_LO) {
		return fail("unsigned OP_LT's true-set MOV must be conditioned LO")
	}
	return ""
}

// The signedness classifier must peel ALL transparent wrappers (StripWrappers),
// not just TYP_NAMED.  `.Signed` is a Type FIELD that does NOT delegate through
// the TYP_READONLY wrapper (whose Signed field defaults to false), so a named-only
// peel (the old UnwrapNamed) reads Signed=false for a `readonly int32` and picks
// the UNSIGNED family (LO) — mis-comparing a negative value.  StripWrappers peels
// to the int32, whose Signed=true selects the SIGNED family (LT).  (The checker
// currently strips readonly for compare rvalues, so this is defense-in-depth;
// constructing the wrapped type directly exercises the peel.)
func TestCompareReadonlySignedLtUsesLt() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = twoOpArm32(rm, iropcode.OP_LT, types.MakeReadonlyType(types.TypInt32()))
	if !emitCompare(a, "main", rm, ins) {
		return fail("emitCompare must match OP_LT")
	}
	var w uint32 = word32(a, 8)
	if (w >> 28) != cast(uint32, arm32.COND_LT) {
		return fail("a readonly-int32 OP_LT must use the SIGNED LT condition (peel the wrapper)")
	}
	return ""
}

// emitCompare EQ carries the direct COND_EQ on the true-set MOV.
func TestCompareEqUsesEq() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = twoOpArm32(rm, iropcode.OP_EQ, types.TypInt())
	if !emitCompare(a, "main", rm, ins) {
		return fail("emitCompare must match OP_EQ")
	}
	var w uint32 = word32(a, 8)
	if (w >> 28) != cast(uint32, arm32.COND_EQ) {
		return fail("OP_EQ's true-set MOV must be conditioned EQ")
	}
	return ""
}
