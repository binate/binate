package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// emitCopy lowers OP_COPY — the move iropt.EliminatePhis inserts when it destructs
// SSA (removes OP_PHI): one per predecessor edge, all carrying the phi's id, so
// they land in the phi's one home or slot.  A copy whose source and destination
// share a home (the allocator tied them) is already done.
//
//   - Both ends homed in VFP D-registers (hard-float floats): VMOV.F64, with no
//     GP round-trip.  The whole D register carries an f32 in its low S-view too.
//   - A 64-bit value (int64, or a float64 — a GP pair under soft-float, a D-home or
//     an 8-byte slot under hard-float): both words, through load64 / store64,
//     which bridge a D-home on either side.  A one-word MOV would drop the high
//     word.
//   - Anything else is one word: a MOV into the phi's register, whose store to the
//     slot is deferred (lazy spill); an FP-homed f32 on either side goes through
//     the getOperand / handleResult S-view bridge.
func emitCopy(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	if rm.SameHome(ins.ID, ins.Args[0].ID) { return }
	var dHome int = rm.LookupHome(ins.ID)
	var sHome int = rm.LookupHome(ins.Args[0].ID)
	if isFpReg(dHome) && isFpReg(sHome) {
		arm32.VmovF64(a, arm32.COND_AL, dHome, sHome)
		return
	}
	if isPair64Typ(ins.Typ) {
		var lo int
		var hi int
		lo, hi = load64(a, rm, ins.Args[0])
		if lo < 0 { return }
		store64(a, rm, ins, lo, hi)
		return
	}
	var src int = getOperand(a, rm, ins.Args[0].ID)
	if src < 0 { return }
	var rd int = nextReg(rm, ins.ID)
	arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Reg(src))
}
