package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for emitCopy (arm32_copy.bn): the OP_COPY moves iropt.EliminatePhis
// inserts for a phi, for the value shapes that are not one GP word.

// copyOf builds `ins := copy src` of type t, with src id 1 and ins id 2.
func copyOf(t @types.Type) @ir.Instr {
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = t
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_COPY
	ins.Typ = t
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	return ins
}

// sameBytes reports whether a emitted exactly ref's bytes.
func sameBytes(a @asm.Assembler, ref @asm.Assembler) bool {
	if bytesWritten(a) != bytesWritten(ref) { return false }
	for off := 0; off + 4 <= bytesWritten(a); off = off + 4 {
		if word32(a, off) != word32(ref, off) { return false }
	}
	return true
}

// A 64-bit copy between two slots moves BOTH words — the low word from [slot+0] and
// the high word from [slot+4] — for an int64 and for a (soft-float) float64.
func TestCopyPairBetweenSlotsMovesBothWords() testing.TestResult {
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt64()
	ts[1] = types.TypFloat64()
	for i := 0; i < len(ts); i++ {
		var a @asm.Assembler = mkAsm()
		var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
		addSpill(rm, 1, 0)
		addSpill(rm, 2, 8)
		emitCopy(a, rm, copyOf(ts[i]))
		if a.HasError { return fail("a 64-bit copy between slots must not error") }
		var refRm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
		var lo int = scratchReg(refRm)
		var hi int = scratchReg(refRm)
		var ref @asm.Assembler = mkAsm()
		emitFrameLoad(ref, lo, 0)
		emitFrameLoad(ref, hi, 4)
		emitFrameStore(ref, lo, 8)
		emitFrameStore(ref, hi, 12)
		if !sameBytes(a, ref) {
			return fail("a 64-bit copy must load both source words and store both to the phi's slot")
		}
	}
	return ""
}

// A hard-float copy between two D-register homes is one VMOV.F64 — for a float64
// and for a float32 (its home's low S-view rides along).
func TestCopyBetweenDHomesIsVmov() testing.TestResult {
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypFloat64()
	ts[1] = types.TypFloat32()
	for i := 0; i < len(ts); i++ {
		var oldArch int
		var oldAbi int
		oldArch, oldAbi = stampHard()
		var a @asm.Assembler = mkAsm()
		var rm @common.RegMap = hardRm()
		rm.HomeIDs = common.AppendInt(rm.HomeIDs, 1)
		rm.HomeRegs = common.AppendInt(rm.HomeRegs, vfp.D9)
		rm.HomeIDs = common.AppendInt(rm.HomeIDs, 2)
		rm.HomeRegs = common.AppendInt(rm.HomeRegs, vfp.D8)
		emitCopy(a, rm, copyOf(ts[i]))
		var hadErr bool = a.HasError
		restoreTarget(oldArch, oldAbi)
		if hadErr { return fail("a copy between D-homes must not error") }
		var ref @asm.Assembler = mkAsm()
		vfp.VmovF64(ref, arm32.COND_AL, vfp.D8, vfp.D9)
		if !sameBytes(a, ref) { return fail("a copy between D-homes must be one vmov.f64 d8, d9") }
	}
	return ""
}

// A hard-float float64 copy from a D-register home into a slot moves the home's
// two words out (VMOV to a GP pair) and stores both.
func TestCopyFloat64DHomeToSlot() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = hardRm()
	rm.HomeIDs = common.AppendInt(rm.HomeIDs, 1)
	rm.HomeRegs = common.AppendInt(rm.HomeRegs, vfp.D8)
	addSpill(rm, 2, 8)
	emitCopy(a, rm, copyOf(types.TypFloat64()))
	var hadErr bool = a.HasError
	restoreTarget(oldArch, oldAbi)
	if hadErr { return fail("a D-home to slot float64 copy must not error") }
	var refRm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	var lo int = scratchReg(refRm)
	var hi int = scratchReg(refRm)
	var ref @asm.Assembler = mkAsm()
	vfp.VmovDoubleToCores(ref, arm32.COND_AL, lo, hi, vfp.D8)
	emitFrameStore(ref, lo, 8)
	emitFrameStore(ref, hi, 12)
	if !sameBytes(a, ref) {
		return fail("a D-home to slot float64 copy must vmov the home to a GP pair and store both words")
	}
	return ""
}

// A hard-float float64 copy from a slot into a D-register home loads both words and
// moves them into the home.
func TestCopyFloat64SlotToDHome() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = hardRm()
	addSpill(rm, 1, 0)
	rm.HomeIDs = common.AppendInt(rm.HomeIDs, 2)
	rm.HomeRegs = common.AppendInt(rm.HomeRegs, vfp.D8)
	emitCopy(a, rm, copyOf(types.TypFloat64()))
	var hadErr bool = a.HasError
	restoreTarget(oldArch, oldAbi)
	if hadErr { return fail("a slot to D-home float64 copy must not error") }
	var refRm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	var lo int = scratchReg(refRm)
	var hi int = scratchReg(refRm)
	var ref @asm.Assembler = mkAsm()
	emitFrameLoad(ref, lo, 0)
	emitFrameLoad(ref, hi, 4)
	vfp.VmovCoresToDouble(ref, arm32.COND_AL, vfp.D8, lo, hi)
	if !sameBytes(a, ref) {
		return fail("a slot to D-home float64 copy must load both words and vmov them into the home")
	}
	return ""
}
