package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"

// ============================================================
// emitInstr — instruction selection (walking-skeleton subset)
// ============================================================

// emitInstr lowers one IR instruction.  Walking-skeleton subset only: the ops
// a trivial program hits (OP_CALL / OP_C_CALL, OP_RETURN, OP_CONST_INT,
// OP_CONST_STRING and the rodata forms for a constant println, plus OP_JUMP).
// Any op outside this set fails LOUDLY via a.SetError (see the tail).  Unlike
// the complete aarch64/x64 backends — whose "unhandled op" tail is effectively
// unreachable — this skeleton omits most ops, so a silent no-op would let a
// real program compile to a WRONG binary.  Cases are added here as P3+
// implements them; the guard is never relaxed.
func emitInstr(a @asm.Assembler, pkgName *[]readonly char, funcSym @[]char,
	rm @common.RegMap, strings @[]ir.StringConst,
	allFuncs @[]@ir.Func, ins @ir.Instr) {
	currentEmitOp = ins.Op
	switch ins.Op {
	case iropcode.OP_CONST_INT:
		var r int = nextReg(rm, ins.ID)
		emitConstInt32(a, r, cast(int, ins.IntVal))
		return
	case iropcode.OP_CONST_BOOL:
		var r int = nextReg(rm, ins.ID)
		var v int = 0
		if ins.BoolVal { v = 1 }
		emitConstInt32(a, r, v)
		return
	case iropcode.OP_CONST_STRING:
		// A string literal used as a value: its rodata blob address
		// (`Lstr_<id>`) via the MOVW/MOVT-ABS reloc pair (arm32's ADRP+ADD
		// analog).  Higher-level println lowerings usually go through the
		// OP_RODATA_* forms; a bare pointer-to-bytes value lands here.
		var id int = ir.FindStringID(strings, ins.StrVal)
		if id < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		emitSymAddr(a, rd, stringLabel(id))
		return
	case iropcode.OP_CALL:
		emitCall(a, pkgName, rm, allFuncs, ins)
		return
	case iropcode.OP_C_CALL:
		emitCall(a, pkgName, rm, allFuncs, ins)
		return
	case iropcode.OP_RETURN:
		emitReturn(a, pkgName, rm, ins)
		return
	case iropcode.OP_JUMP:
		if ins.Block1 == nil { return }
		arm32.B(a, arm32.COND_AL, blockLabel(funcSym, ins.Block1.Label))
		return
	case iropcode.OP_SP_RESTORE:
		// Statement-end marker for the bytecode VM; native no-op (PlanFrame
		// sized the frame once at prologue time; spill slots are function-
		// scoped).  Mirrors aarch64_dispatch.bn.
		return
	}

	// Any other op is not yet implemented in the arm32 walking skeleton.
	// Fail LOUDLY (a.SetError -> EmitObject returns false -> bnc reports a
	// compile error) rather than emitting nothing: a silent no-op here would
	// let a program using an unimplemented op compile to a WRONG binary
	// (garbage values / UB), surfacing only as a runtime hang or a mismatch.
	// P3+ fills in arithmetic, comparison, memory, aggregate, and refcount
	// lowering — each lands by adding a case above, never by relaxing this.
	var msg @[]char
	msg = common.AppendStr(msg, "native arm32: unimplemented IR op ")
	msg = common.AppendStr(msg, iropcode.OpName(ins.Op))
	a.SetError(msg)
}
