package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// emitInstr — instruction selection
// ============================================================

// emitInstr lowers one IR instruction.  The integer-completeness subset (P3
// increment 1): consts, integer arithmetic / comparison / unary / cast, control
// flow, scalar + aggregate memory ops, calls, and refcount.  Any op outside the
// implemented set fails LOUDLY via a.SetError (see the tail).  Unlike the
// complete aarch64/x64 backends — whose "unhandled op" tail is effectively
// unreachable — this backend still omits shapes (64-bit register pairs, floats,
// interface dispatch, closures), so a silent no-op would let a program using an
// unimplemented op compile to a WRONG binary.  Cases are added by adding a
// handler, never by relaxing the guard.
func emitInstr(a @asm.Assembler, pkgName *[]readonly char, funcSym @[]char, rm @common.RegMap,
		strings @[]ir.StringConst, allFuncs @[]@ir.Func, ins @ir.Instr) {
	currentEmitOp = ins.Op
	// 64-bit (int64 / uint64) ops are register PAIRS on this ILP32 target — a
	// separate lowering family (arm32_int64*.bn).  Intercept them first so the
	// 32-bit const / arithmetic / compare / cast paths below only ever see
	// same-width (<= 32-bit) operands.  Ops touching memory / calls / returns
	// (OP_LOAD / OP_STORE / OP_CALL / OP_RETURN / OP_DIV_CHECK / OP_SHIFT_CHECK)
	// route their own 64-bit handling in their dedicated emitters, not here.
	if instrIs64(ins) {
		if emitInstr64(a, pkgName, rm, ins) { return }
	}
	switch ins.Op {
	case iropcode.OP_CONST_INT:
		var r int = nextReg(rm, ins.ID)
		emitConstInt32(a, r, cast(int, ins.IntVal))
		return
	case iropcode.OP_CONST_BOOL:
		var r int = nextReg(rm, ins.ID)
		var v int = 0
		if ins.BoolVal { v = 1 }
		emitConstInt32(a, r, v)
		return
	case iropcode.OP_CONST_NIL:
		emitConstNil(a, rm, ins)
		return
	case iropcode.OP_CONST_STRING:
		// A string literal used as a value: its rodata blob address
		// (`Lstr_<id>`) via the MOVW/MOVT-ABS reloc pair (arm32's ADRP+ADD
		// analog).  Higher-level println lowerings usually go through the
		// OP_RODATA_* forms; a bare pointer-to-bytes value lands here.
		var id int = ir.FindStringID(strings, ins.StrVal)
		if id < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		emitSymAddr(a, rd, stringLabel(id))
		return
	case iropcode.OP_RODATA_ARRAY:
		emitStringToArray(a, rm, ins)
		return
	case iropcode.OP_RODATA_MSLICE, iropcode.OP_RODATA_SLICE:
		emitRodataMSliceOrSlice(a, rm, pkgName, strings, ins)
		return
	case iropcode.OP_RODATA_MSLICE_COPY:
		emitStringToCharsCopy(a, rm, ins, ins.StrVal)
		return
	case iropcode.OP_CALL:
		emitCall(a, pkgName, rm, allFuncs, ins)
		return
	case iropcode.OP_C_CALL:
		emitCall(a, pkgName, rm, allFuncs, ins)
		return
	case iropcode.OP_C_GLOBAL:
		// __c_global: the ADDRESS of an external C global as a raw *T.  arm32
		// native is the non-PIE / static (baremetal) link, where the symbol
		// resolves to a fixed address, so the MOVW/MOVT-ABS reloc pair
		// (emitSymAddr) materializes it directly — no GOT.  The symbol is
		// verbatim (symPrefixed, no Binate mangling), marked global so the
		// object writer emits an undefined-external reference the linker
		// resolves against whatever (driver / board-support) object defines it.
		// See plan-c-global.md §5a.  (PIE targets — x64/aarch64 — need GOT
		// instead; that is §5b.)
		emitSymAddr(a, nextReg(rm, ins.ID), symPrefixed(ins.StrVal))
		return
	case iropcode.OP_DATA_SYM_ADDR:
		// Address of a LOCAL weak Binate data global (e.g. __typeinfo/__ifaceid).
		// On arm32's non-PIE / static link there is no GOT distinction from a C
		// global, so the same MOVW/MOVT-ABS reloc pair (emitSymAddr) materializes
		// the address; the symbol is a Binate mangled name, symPrefixed.
		emitSymAddr(a, nextReg(rm, ins.ID), symPrefixed(ins.StrVal))
		return
	case iropcode.OP_CALL_INDIRECT:
		emitCallIndirect(a, pkgName, rm, allFuncs, ins)
		return
	case iropcode.OP_CALL_FUNC_VALUE:
		emitCallFuncValue(a, pkgName, rm, allFuncs, ins)
		return
	case iropcode.OP_CALL_HANDLE:
		// A handle and a constructed func value share the {vtable, data}
		// layout and the "load vtable.call, call(data, args)" sequence, so
		// dispatch through the same lowering.  Mirrors aarch64_dispatch.bn.
		emitCallFuncValue(a, pkgName, rm, allFuncs, ins)
		return
	case iropcode.OP_FUNC_HANDLE:
		// Produce a *uint8 pointing at the static `___handle.<mangled>` global —
		// an 8-byte {vtable, data=null} aggregate (ILP32) whose data slot is null
		// (non-capturing).  Consumed by OP_CALL_HANDLE.  arm32 has no ADRP, so
		// materialize the address via the MOVW/MOVT-ABS reloc pair (emitSymAddr).
		if len(ins.StrVal) == 0 { return }
		var handleLbl @[]char = handleSymFor(pkgName, ins.StrVal)
		a.SetGlobal(handleLbl)
		var hrd int = nextReg(rm, ins.ID)
		emitSymAddr(a, hrd, handleLbl)
		return
	case iropcode.OP_FUNC_VALUE:
		emitFuncValue(a, pkgName, rm, ins)
		return
	case iropcode.OP_FUNC_VALUE_DTOR:
		// Load slot 0 (the dtor) of a function value's vtable: read the vtable
		// pointer from the fv's {vtable, data} aggregate (offset
		// FuncValueVtableOffset), then load *(vtable + 0).  Feeds
		// emitManagedFuncValueRefDec -> OP_REFDEC_DTOR.  Without this case
		// PlanFrame reserves the SSA result slot but nothing writes it, so the
		// later OP_REFDEC reads garbage.  Mirrors aarch64_dispatch.bn.
		if len(ins.Args) < 1 { return }
		var fvp int = getOperand(a, rm, ins.Args[0].ID)
		if fvp < 0 { return }
		var drd int = nextReg(rm, ins.ID)
		arm32.Ldr(a, arm32.COND_AL, drd, arm32.MemImm(fvp, types.FuncValueVtableOffset()))
		arm32.Ldr(a, arm32.COND_AL, drd, arm32.MemImm(drd, 0))
		return
	case iropcode.OP_IFACE_VALUE:
		// Interface-value construction (P4-c.2): build the two-word {data, vtable}
		// aggregate in the instruction's pre-allocated alloc region.
		emitIfaceValue(a, pkgName, rm, ins)
		return
	case iropcode.OP_IFACE_UPCAST:
		// Interface upcast (P4-c.2): rebuild the {data, vtable} value with the
		// vtable pointer advanced to the target ancestor's nested sub-vtable.
		emitIfaceUpcast(a, rm, ins)
		return
	case iropcode.OP_CALL_IFACE_METHOD:
		// Interface method dispatch (P4-c.3): load the method pointer from the iv's
		// vtable and call it (BLX IP), passing the iv's data pointer as the receiver.
		emitCallIfaceMethod(a, pkgName, rm, allFuncs, ins)
		return
	case iropcode.OP_IFACE_DTOR:
		// Managed-iface-value scope-exit dtor load (P4-c.4): load slot 0 (the dtor
		// HANDLE) of the iv's vtable — NOT a call.  The handle feeds the later
		// OP_REFDEC dtor operand (rt.ZeroRefDestroy), which invokes it (and guards a
		// null slot) when the refcount hits zero.  Mirror of OP_FUNC_VALUE_DTOR above
		// with the iface {data, vtable} offset.  See arm32_iface.bn:emitIfaceDtor.
		emitIfaceDtor(a, rm, ins)
		return
	case iropcode.OP_RETURN:
		emitReturn(a, pkgName, rm, ins)
		return
	case iropcode.OP_JUMP:
		if ins.Block1 == nil { return }
		arm32.B(a, arm32.COND_AL, blockLabel(funcSym, ins.Block1.Label))
		return
	case iropcode.OP_BRANCH:
		emitBranch(a, funcSym, rm, ins)
		return
	case iropcode.OP_CAST:
		emitCastOp(a, pkgName, rm, ins)
		return
	case iropcode.OP_BIT_CAST:
		emitBitCast(a, pkgName, rm, ins)
		return
	case iropcode.OP_MANAGED_TO_RAW:
		// @[]T → *[]T: pass the source pointer through; the first two words of
		// a managed-slice ARE the raw-slice representation.
		if len(ins.Args) < 1 { return }
		var src int = getOperand(a, rm, ins.Args[0].ID)
		if src < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Reg(src))
		return
	case iropcode.OP_DIV_CHECK:
		emitDivCheck(a, rm, ins)
		return
	case iropcode.OP_SHIFT_CHECK:
		emitShiftCheck(a, rm, ins)
		return
	case iropcode.OP_BOUNDS_CHECK:
		emitBoundsCheck(a, rm, ins)
		return
	case iropcode.OP_REFINC:
		emitRefIncInline(a, rm, ins)
		return
	case iropcode.OP_REFDEC:
		emitRefDecInline(a, rm, ins)
		return
	case iropcode.OP_EXTRACT:       emitExtract(a, rm, ins); return
	case iropcode.OP_ALLOC:         emitAlloc(a, rm, ins); return
	case iropcode.OP_MAKE:          emitMake(a, rm, ins); return
	case iropcode.OP_BOX:           emitBox(a, rm, ins); return
	case iropcode.OP_MAKE_SLICE:    emitMakeSlice(a, rm, ins); return
	case iropcode.OP_LOAD:          emitLoad(a, pkgName, rm, ins); return
	case iropcode.OP_STORE:         emitStore(a, pkgName, rm, ins); return
	case iropcode.OP_GET_ELEM_PTR:  emitGetElemPtr(a, pkgName, rm, ins); return
	case iropcode.OP_GET_FIELD_PTR: emitGetFieldPtr(a, pkgName, rm, ins); return
	case iropcode.OP_SP_RESTORE:
		// Statement-end marker for the bytecode VM; native no-op (PlanFrame
		// sized the frame once at prologue time; spill slots are function-
		// scoped).  Mirrors aarch64_dispatch.bn.
		return
	case iropcode.OP_UNREACHABLE:
		// Terminator the IR appends after a block that can't fall through (e.g.
		// a switch/if whose every arm returns, or after a panic).  Control
		// never reaches it in a correct program; emit a BKPT so that IF it ever
		// does (a codegen bug), execution traps loudly rather than running off
		// into whatever follows.  aarch64/x64 no-op it via their silent tail;
		// the explicit trap is strictly safer and keeps arm32's fail-loud
		// discipline (an unhandled op errors; a handled one is a real case).
		arm32.Bkpt(a, 0)
		return
	}

	// Arithmetic / comparison / unary families are op-RANGES handled by these
	// guarded delegates, so they sit after the per-op switch.  Each returns
	// true only when it matched and emitted; a compare on float operands
	// SetErrors loudly (returning true) rather than mis-comparing bit patterns.
	if emitCompare(a, pkgName, rm, ins) { return }
	if emitBinop(a, rm, ins) { return }
	if emitUnop(a, rm, ins) { return }

	// Any other op is not yet implemented in the arm32 backend.  Fail LOUDLY
	// (a.SetError -> EmitObject returns false -> bnc reports a compile error)
	// rather than emitting nothing: a silent no-op here would let a program
	// using an unimplemented op (64-bit pairs, floats, interfaces, closures)
	// compile to a WRONG binary.  Later increments fill these in by adding a
	// case / delegate above, never by relaxing this guard.
	var msg @[]char
	msg = common.AppendStr(msg, "native arm32: unimplemented IR op ")
	msg = common.AppendStr(msg, iropcode.OpName(ins.Op))
	a.SetError(msg)
}

// emitBranch lowers OP_BRANCH: Args[0] = cond (a 0/1 bool in a register),
// Block1 = then, Block2 = else.  arm32 has no CBNZ, so test the condition with
// CMP #0 then branch NE to the then-block, falling through to an unconditional
// B to the else-block.  Mirrors aarch64_dispatch.bn's OP_BRANCH (CBNZ + B) at
// the arm32 flag-setting-compare model.
func emitBranch(a @asm.Assembler, funcSym @[]char, rm @common.RegMap, ins @ir.Instr) {
	if ins.Block1 == nil || ins.Block2 == nil || len(ins.Args) < 1 { return }
	var condReg int = getOperand(a, rm, ins.Args[0].ID)
	if condReg < 0 { return }
	arm32.Cmp(a, arm32.COND_AL, condReg, arm32.Imm(0))
	arm32.B(a, arm32.COND_NE, blockLabel(funcSym, ins.Block1.Label))
	arm32.B(a, arm32.COND_AL, blockLabel(funcSym, ins.Block2.Label))
}

// emitCastOp lowers OP_CAST — a numeric width/signedness conversion.  Uses
// emitValOperand (not getOperand) so an IsGlobalRef pseudo source (`cast(int,
// &G)`, ID -1, no register) is materialized rather than dropped.  emitCast
// itself fails loud on a 64-bit target (register pair, deferred).
func emitCastOp(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 || ins.TypeArg == nil { return }
	if common.IsFloatScalarTyp(ins.TypeArg) || common.IsFloatScalarTyp(ins.Args[0].Typ) {
		a.SetError("native arm32: float cast not implemented (P5)")
		return
	}
	var src int = emitValOperand(a, pkgName, rm, ins.Args[0])
	if src < 0 { return }
	var rd int = nextReg(rm, ins.ID)
	emitCast(a, rd, src, ins.Args[0].Typ, ins.TypeArg)
}

// emitBitCast lowers OP_BIT_CAST — a same-size reinterpret (a plain MOV in a
// 32-bit file) followed by a re-narrow to the TARGET type's width, so a sub-word
// target used directly holds its own value range rather than leaked high bits.
// A float source/target needs the VFP/soft-float move path (deferred); fail loud.
func emitBitCast(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	if common.IsFloatScalarTyp(ins.TypeArg) || common.IsFloatScalarTyp(ins.Args[0].Typ) {
		a.SetError("native arm32: float bit_cast not implemented (P5)")
		return
	}
	var src int = emitValOperand(a, pkgName, rm, ins.Args[0])
	if src < 0 { return }
	var rd int = nextReg(rm, ins.ID)
	arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Reg(src))
	emitSubWordNarrow(a, rd, ins.TypeArg)
}

// emitDivCheck lowers OP_DIV_CHECK to a call to rt.DivCheck(dividend, divisor,
// signedMin, isSigned).  rt.DivCheck's Binate signature takes `int64` for
// dividend / divisor / signedMin, and IR-gen widens the operands to int64
// (ensureInt64ForCheck) so the guard sees uniform 64-bit operands on every
// target.  On AAPCS32 (ILP32) each int64 arg occupies an even-aligned register
// PAIR (dividend R0:R1, divisor R2:R3, signedMin + isSigned on the stack); the
// register-pair marshaling lives in arm32_int64_guard.bn.
func emitDivCheck(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	emitDivCheck64(a, rm, ins)
}

// emitShiftCheck lowers OP_SHIFT_CHECK to rt.ShiftCheck(count).  rt.ShiftCheck's
// signature takes `int64` and IR-gen sign-extends the count to int64, so on
// AAPCS32 the count arrives in a register PAIR (R0:R1).  Constant-count shifts
// (e.g. `1 << 4`) carry no guard at all (shiftInrange nil in IR-gen), so they
// never reach here.  The pair marshaling lives in arm32_int64_guard.bn.
func emitShiftCheck(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	emitShiftCheck64(a, rm, ins)
}

// emitBoundsCheck lowers OP_BOUNDS_CHECK to rt.BoundsCheck(index, len): the
// runtime aborts if the unsigned comparison fails.  index → R0, len → R1.
func emitBoundsCheck(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	var idx int = getOperand(a, rm, ins.Args[0].ID)
	var ln int = getOperand(a, rm, ins.Args[1].ID)
	if idx < 0 || ln < 0 { return }
	arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Reg(idx))
	arm32.Mov(a, arm32.COND_AL, false, arm32.R1, arm32.Reg(ln))
	var callee @[]char = symPrefixed(mangleRtFunc("BoundsCheck"))
	a.SetGlobal(callee)
	arm32.Bl(a, arm32.COND_AL, callee)
	rm.ResetRegs()
}
