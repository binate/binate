package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/builtins/testing"

// emitInstr's dispatch is exercised end-to-end by arm32_test.bn's EmitObject
// round-trip; these pin the individual ops it must lower for the walking
// skeleton.

// OP_CONST_INT of a small value lowers to a single MOV (4 bytes), recorded in
// the regmap for the SSA id.
func TestDispatchConstIntSmall() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CONST_INT
	ins.IntVal = cast(int64, 3)
	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.Sections[0].Len != 4 {
		return fail("OP_CONST_INT small should emit one MOV (4 bytes)")
	}
	if rm.LookupReg(0) != arm32.R4 {
		return fail("OP_CONST_INT should assign the SSA id its scratch reg (R4)")
	}
	return ""
}

// OP_JUMP lowers to a single unconditional branch (4 bytes) targeting the
// block label.
func TestDispatchJump() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var target @ir.Block = make(ir.Block)
	target.Label = "L1"
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_JUMP
	ins.Block1 = target
	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.Sections[0].Len != 4 {
		return fail("OP_JUMP should emit one branch (4 bytes)")
	}
	return ""
}

// OP_SP_RESTORE is an EXPLICITLY-handled native no-op — a statement-end
// marker for the bytecode VM; the frame is sized once at prologue time so
// there's nothing to reclaim.  This is distinct from an UNIMPLEMENTED op,
// which fails loudly (see TestDispatchUnimplementedOpSetsError).
func TestDispatchSpRestoreIsNoOp() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_SP_RESTORE
	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.Sections[0].Len != 0 {
		return fail("OP_SP_RESTORE should be a native no-op")
	}
	return ""
}

// An op the backend does NOT yet implement must fail LOUDLY (a.SetError ->
// EmitObject returns false -> bnc compile error), not silently emit nothing:
// a no-op would let a program using that op compile to a wrong binary.
// OP_CALL_INDIRECT (indirect call / function value dispatch) is a later-
// increment op — the integer-completeness increment lowers direct calls and
// memory ops but not the func-value machinery — so it exercises the loud tail.
func TestDispatchUnimplementedOpSetsError() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL_INDIRECT
	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if !a.HasError {
		return fail("an unimplemented op must set a compile error, not no-op")
	}
	return ""
}
