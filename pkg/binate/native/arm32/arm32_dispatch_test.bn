package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// emitInstr's dispatch is exercised end-to-end by arm32_test.bn's EmitObject
// round-trip; these pin the individual ops it must lower for the walking
// skeleton.

// OP_CONST_INT of a small value lowers to a single MOV (4 bytes), recorded in
// the regmap for the SSA id.
func TestDispatchConstIntSmall() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CONST_INT
	ins.IntVal = cast(int64, 3)
	var strings @[]ir.StringConst
	emitInstr(a, "main", "bn_entry", rm, strings, ins)
	if a.Sections[0].Len != 4 {
		return fail("OP_CONST_INT small should emit one MOV (4 bytes)")
	}
	if rm.LookupReg(0) != arm32.R4 {
		return fail("OP_CONST_INT should assign the SSA id its scratch reg (R4)")
	}
	return ""
}

// OP_COPY (emitted by ir.EliminatePhis) lowers to a reg-to-reg move, not the
// unimplemented-op fail-loud.  (No type needed: the move is id-keyed.)
func TestDispatchCopy() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_COPY
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	var strings @[]ir.StringConst
	emitInstr(a, "main", "bn_entry", rm, strings, ins)
	if a.HasError {
		return fail("OP_COPY must lower to a move, not fail-loud")
	}
	if a.Sections[0].Len == 0 {
		return fail("OP_COPY should emit a move")
	}
	return ""
}

// OP_JUMP lowers to a single unconditional branch (4 bytes) targeting the
// block label.
func TestDispatchJump() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var target @ir.Block = make(ir.Block)
	target.Label = "L1"
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_JUMP
	ins.Block1 = target
	var strings @[]ir.StringConst
	emitInstr(a, "main", "bn_entry", rm, strings, ins)
	if a.Sections[0].Len != 4 {
		return fail("OP_JUMP should emit one branch (4 bytes)")
	}
	return ""
}

// OP_SP_RESTORE is an EXPLICITLY-handled native no-op — a statement-end
// marker for the bytecode VM; the frame is sized once at prologue time so
// there's nothing to reclaim.  This is distinct from an UNIMPLEMENTED op,
// which fails loudly (see TestDispatchUnimplementedOpSetsError).
func TestDispatchSpRestoreIsNoOp() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_SP_RESTORE
	var strings @[]ir.StringConst
	emitInstr(a, "main", "bn_entry", rm, strings, ins)
	if a.Sections[0].Len != 0 {
		return fail("OP_SP_RESTORE should be a native no-op")
	}
	return ""
}

// OP_NIL_CHECK is another EXPLICITLY-handled native no-op — opt-in nil-checking
// is a VM/REPL recovery aid, and arm32 stays C-like
// (a nil deref is UB/SEGV).  The explicit arm keeps it OFF the fail-loud tail
// (see TestDispatchUnimplementedOpSetsError): it must emit zero bytes AND set no
// error — a legitimately VM-only op is not "unimplemented".
func TestDispatchNilCheckIsNoOp() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_NIL_CHECK
	var strings @[]ir.StringConst
	emitInstr(a, "main", "bn_entry", rm, strings, ins)
	if a.Sections[0].Len != 0 {
		return fail("OP_NIL_CHECK should be a native no-op (zero bytes)")
	}
	if a.HasError {
		return fail("OP_NIL_CHECK is a VM-only op, not unimplemented — must not fail loudly")
	}
	return ""
}

// An op the backend does NOT handle must fail LOUDLY (a.SetError ->
// EmitObject returns false -> bnc compile error), not silently emit nothing:
// a no-op would let a program using that op compile to a wrong binary.  Every
// REAL op is now implemented (the P4 iface / P5 float buckets that used to be
// the example here have all landed), so this exercises the defensive tail with a
// synthetic out-of-range opcode that no case, delegate, or float/int64 router
// claims.
func TestDispatchUnimplementedOpSetsError() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = 100000 // no handler — must reach the fail-loud tail
	var strings @[]ir.StringConst
	emitInstr(a, "main", "bn_entry", rm, strings, ins)
	if !a.HasError {
		return fail("an op with no handler must set a compile error, not a silent no-op")
	}
	return ""
}

// OP_FUNC_HANDLE materializes the address of the static ___handle.<mangled>
// global into the result register via the MOVW/MOVT-ABS reloc pair (arm32's
// ADRP+ADD analog) — two instructions, 8 bytes — and records the result reg.
func TestDispatchFuncHandleMaterializesAddr() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_FUNC_HANDLE
	ins.StrVal = "main.foo"
	var strings @[]ir.StringConst
	emitInstr(a, "main", "bn_entry", rm, strings, ins)
	if a.HasError {
		return fail("OP_FUNC_HANDLE should not fail on a valid handle ref")
	}
	if a.Sections[0].Len != 8 {
		return fail("OP_FUNC_HANDLE should emit MOVW+MOVT (8 bytes)")
	}
	if rm.LookupReg(0) < 0 {
		return fail("OP_FUNC_HANDLE should assign the SSA id a result reg")
	}
	return ""
}

// OP_FUNC_VALUE builds the {vtable_addr, data=null} aggregate in the
// instruction's pre-allocated data region and produces a pointer to it — it must
// lower without error for a non-capturing literal (zero args).
func TestDispatchFuncValueBuildsAggregate() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 0)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_FUNC_VALUE
	ins.StrVal = "main.foo"
	var strings @[]ir.StringConst
	emitInstr(a, "main", "bn_entry", rm, strings, ins)
	if a.HasError {
		return fail("OP_FUNC_VALUE (non-capturing) should not fail")
	}
	if a.Sections[0].Len == 0 {
		return fail("OP_FUNC_VALUE should emit the {vtable,data} construction")
	}
	if rm.LookupReg(0) < 0 {
		return fail("OP_FUNC_VALUE should produce the data-region pointer")
	}
	return ""
}

// A CAPTURING OP_FUNC_VALUE (Args[0] carries the capture-struct pointer) stores
// that pointer into the func value's data slot (P4-d construction) — it must
// lower WITHOUT error and emit the {vtable, data} construction, mirroring the
// non-capturing case but with the capture pointer in the data slot rather than
// null.  The capture operand is registered as a spill so getOperand can
// materialize it.
func TestDispatchFuncValueCapturingStoresDataSlot() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 0)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	// The capture-struct pointer operand (id 5) lives in a spill slot so
	// getOperand can reload it for the data-slot store.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	var cap @ir.Instr = make(ir.Instr)
	cap.ID = 5
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_FUNC_VALUE
	ins.StrVal = "main.__funclit_c"
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = cap
	var strings @[]ir.StringConst
	emitInstr(a, "main", "bn_entry", rm, strings, ins)
	if a.HasError {
		return fail("a capturing func value should store the data slot, not fail (P4-d)")
	}
	if a.Sections[0].Len == 0 {
		return fail("a capturing OP_FUNC_VALUE should emit the {vtable, data} construction")
	}
	if rm.LookupReg(0) < 0 {
		return fail("a capturing OP_FUNC_VALUE should produce the data-region pointer")
	}
	return ""
}

// OP_FUNC_VALUE_DTOR loads slot 0 (the dtor) of a function value's vtable: read
// the vtable pointer from the fv, then *(vtable + 0).  It must lower without
// error given a materializable fv operand and its result slot.
func TestDispatchFuncValueDtorLoadsSlot0() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 0)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var fvp @ir.Instr = make(ir.Instr)
	fvp.ID = 0
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_FUNC_VALUE_DTOR
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = fvp
	var strings @[]ir.StringConst
	emitInstr(a, "main", "bn_entry", rm, strings, ins)
	if a.HasError {
		return fail("OP_FUNC_VALUE_DTOR should not fail on a valid fv operand")
	}
	if rm.LookupReg(1) < 0 {
		return fail("OP_FUNC_VALUE_DTOR should assign the dtor a result reg")
	}
	return ""
}

// OP_CONST_STRING references its rodata blob Lstr_<id> WITHOUT promoting it to
// global.  The blob is defined LOCAL in this object by emitStringTable, so a
// promotion would make two packages' identical Lstr_<id> collide at link
// ("multiple definition").  This drives the real dispatch path (a revert of the
// emitSymAddrLocal call site to emitSymAddr would fail here), emitting the
// reference in "text" before defining the blob in "rodata" — the actual
// EmitFunc-before-EmitStringTable order that made the buggy global binding stick.
func TestDispatchConstStringBlobStaysLocal() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var strings @[]ir.StringConst
	var sc ir.StringConst
	sc.ID = 0
	sc.Len = 2
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CONST_STRING
	ins.StrVal = "hi"
	sc.Data = ins.StrVal
	strings = slices.Append[ir.StringConst](strings, sc)
	emitInstr(a, "main", "bn_entry", rm, strings, ins)
	// Define the blob as emitStringTable would (in rodata), then check binding.
	a.SetSection("rodata", -1)
	a.DefineLabel(common.StringLabel(0))
	var si int = a.LookupSymbol(common.StringLabel(0))
	if si < 0 { return fail("string blob Lstr_0 should be defined") }
	if a.Symbols[si].Binding != asm.BIND_LOCAL {
		return fail("OP_CONST_STRING must reference the blob without promoting it to global")
	}
	return ""
}
