package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/native/strength"
import "pkg/binate/types"

// Memory / aggregate op handlers extracted from the dispatcher.  Each function
// corresponds to one IR opcode; emitInstr matches ins.Op and delegates.
// Mirrors aarch64_emit.bn, adapted to the ILP32 word size (4 bytes) — the
// aarch64 backend's word-stride constants (8) and slice-field flat offsets
// (8 * Index) become the target pointer size here, read from types.GetTarget().

// wordBytes returns the target pointer/word size (4 on arm32).  The whole
// compiler runs with types configured for the arm32 target during a native
// arm32 build, so GetTarget().PointerSize is 4; slice fields, aggregate word
// copies, and register-word strides all use it rather than a hardcoded 8 (the
// aarch64 constant).
func wordBytes() int {
	return types.GetTarget().PointerSize
}

// emitAlloc: OP_ALLOC — an aggregate alloca zero-inits its storage to match the
// LLVM `store ... zeroinitializer`.  Scalar allocas are left uninitialized; the
// following STORE fills them.  Zeroing stores a zeroed scratch word by word, or in a
// loop for a large region (emitFrameZeroArm32); the data region is a multiple of the
// word size (PlanFrame rounds up).  A slot marked NoZeroInit (fully written before
// anything reads it) is not zeroed.
func emitAlloc(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if !callconv.IsAggregateTyp(ins.TypeArg) || ins.NoZeroInit { return }
	var off int = rm.LookupAlloc(ins.ID)
	var sz int = rm.LookupAllocSize(ins.ID)
	if off < 0 || sz <= 0 { return }
	emitFrameZeroArm32(a, rm, off, sz, scratchReg(rm))
}

// emitConstNil: OP_CONST_NIL — an aggregate nil (nil slice, zero struct) zero-
// inits its data region and produces a pointer to it.  A scalar nil is simply 0.
func emitConstNil(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if callconv.IsAggregateTyp(ins.Typ) {
		var dataOff int = rm.LookupAlloc(ins.ID)
		var sz int = rm.LookupAllocSize(ins.ID)
		if dataOff >= 0 && sz > 0 {
			emitFrameZeroArm32(a, rm, dataOff, sz, scratchReg(rm))
			var rd int = nextReg(rm, ins.ID)
			emitFrameAddr(a, rd, dataOff)
			return
		}
	}
	var rd int = nextReg(rm, ins.ID)
	arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Imm(0))
}

// emitExtract: OP_EXTRACT — read ins.Index-th field of an aggregate SSA value.
// Multi-return calls keep the tuple bytes directly in the spill slot; every
// other aggregate keeps a pointer in the spill slot and indirects through it.
// The field offset is tuple.FieldOffset(Index) for a real struct — NOT a flat
// word*Index — because tuple fields can themselves be aggregates.  Scalar fields
// size-dispatch through emitScalarLoad; aggregate fields pass through as an
// address (ADD).  Mirrors aarch64_emit.bn's emitExtract with word=4.
func emitExtract(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var src @ir.Instr = ins.Args[0]
	if isPair64Typ(ins.Typ) {
		// A 64-bit field (int64 / uint64 / float64) is a register PAIR: load lo/hi
		// and store64 to ins's own slot (the value model), NOT a single nextReg
		// register.  Handled before nextReg so no bogus single-register mapping is
		// recorded for it.
		emitExtract64(a, rm, ins, src)
		return
	}
	var rd int = nextReg(rm, ins.ID)
	var fieldOff int = wordBytes() * ins.Index
	var exTyp @types.Type = types.StripWrappers(src.Typ)
	if exTyp != nil && exTyp.Kind == types.TYP_STRUCT {
		fieldOff = exTyp.FieldOffset(ins.Index)
	}
	var sz int = wordBytes()
	if ins.Typ != nil { sz = ins.Typ.SizeOf() }
	if sz <= 0 { sz = wordBytes() }
	var sgnTyp @types.Type = types.StripWrappers(ins.Typ)
	var signed bool = sgnTyp != nil && sgnTyp.Signed
	if common.SpillHoldsAggregatePointer(src) {
		var ptr int = getOperand(a, rm, src.ID)
		if ptr < 0 { return }
		if callconv.IsAggregateTyp(ins.Typ) {
			emitAddImm(a, rd, ptr, fieldOff, arm32.IP)
		} else {
			// fieldOff is usually small — a field read (`.field`) lowers to GEP+LOAD, and
			// built-in-header EXTRACTs (slice / iface / func-value / managed-slice) sit at
			// <= 16 bytes — but it is NOT bounded: SROA's whole-store scalarization EXTRACTs
			// each SCALAR field of a first-class user struct value at FieldOffset(i), which
			// for a large struct can exceed 4095.  Routing through the guarded
			// emitBaseScalarLoad (the load analogue of the store side) handles any offset;
			// IP is the address scratch (dead across the load, never a pool value, so it
			// can't alias ptr or rd).
			emitBaseScalarLoad(a, rd, ptr, fieldOff, sz, signed, arm32.IP)
		}
		return
	}
	var srcSlot int = rm.LookupSpill(src.ID)
	if srcSlot < 0 { return }
	if callconv.IsAggregateTyp(ins.Typ) {
		emitFrameAddr(a, rd, srcSlot + fieldOff)
	} else {
		emitFrameScalarLoad(a, rd, srcSlot + fieldOff, sz, signed)
	}
}

// emitAggLoad materializes an aggregate OP_LOAD into the load's OWN data region
// (reserved by PlanFrame), leaving rd pointing at it.  A bare pointer pass-
// through would alias the source object, which dangles when the source is a
// local the function's cleanup RefDecs before the loaded value is consumed.
// Materializing at the load point (before any cleanup) gives the value its own
// storage.  Mirrors aarch64_emit.bn's emitAggLoad with word=4.
func emitAggLoad(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr,
		arg @ir.Instr) {
	var rd int = nextReg(rm, ins.ID)
	var srcPtr int
	var srcAlloc int = rm.LookupAlloc(arg.ID)
	if srcAlloc >= 0 {
		srcPtr = scratchReg(rm)
		emitFrameAddr(a, srcPtr, srcAlloc)
	} else if isGlobalRef(arg) {
		srcPtr = scratchReg(rm)
		emitGlobalAddr(a, pkgName, srcPtr, arg)
	} else {
		srcPtr = getOperand(a, rm, arg.ID)
	}
	if srcPtr < 0 { return }
	var myAlloc int = rm.LookupAlloc(ins.ID)
	if myAlloc < 0 {
		arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Reg(srcPtr))
		return
	}
	emitFrameAddr(a, rd, myAlloc)
	var sz int = ins.Typ.SizeOf()
	// Byte-wise for a sub-word-aligned aggregate (the source may be a sub-field at a
	// non-word-aligned address, e.g. `s.t` where `t` is a 3-byte struct at byte 1 — a
	// word LDR there faults on strict-align MMU-less arm32); word-wise otherwise.  IP
	// materializes a > 4KB offset (srcPtr / rd / tmp are pool registers, never IP).
	var byteWise bool = aggNeedsBytewiseArm32(ins.Typ)
	if aggCopyIsLoop(sz, byteWise) {
		emitAggCopyLoopArm32(a, rm, rd, 0, srcPtr, 0, sz, byteWise, arm32.IP)
		return
	}
	emitAggMemcpyArm32(a, rm, rd, srcPtr, sz, byteWise, scratchReg(rm), arm32.IP)
}

// emitLoad: OP_LOAD — aggregate loads materialize into their own region
// (emitAggLoad); scalar loads size-dispatch to LDRB/LDRH/LDR so a char read
// doesn't pull in neighbors.  Package-level globals are reached via MOVW/MOVT.
func emitLoad(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var arg @ir.Instr = ins.Args[0]
	if callconv.IsAggregateTyp(ins.Typ) {
		emitAggLoad(a, pkgName, rm, ins, arg)
		return
	}
	if isPair64Typ(ins.Typ) {
		emitLoad64(a, pkgName, rm, ins, arg)
		return
	}
	if arg.Op == iropcode.OP_GET_FIELD_PTR && rm.IsFusableFieldGep(arg.ID) {
		emitFusedFieldLoad(a, rm, ins, arg)
		return
	}
	if emitFloatLoadToHome(a, pkgName, rm, ins, arg) { return }
	var sz int = wordBytes()
	if ins.Typ != nil { sz = ins.Typ.SizeOf() }
	if sz <= 0 { sz = wordBytes() }
	var sgnTyp @types.Type = types.StripWrappers(ins.Typ)
	var signed bool = sgnTyp != nil && sgnTyp.Signed
	var off int = rm.LookupAlloc(arg.ID)
	if off >= 0 {
		var rd int = nextReg(rm, ins.ID)
		emitFrameScalarLoad(a, rd, off, sz, signed)
		return
	}
	if isGlobalRef(arg) {
		var addr int = scratchReg(rm)
		emitGlobalAddr(a, pkgName, addr, arg)
		var rd int = nextReg(rm, ins.ID)
		emitScalarLoad(a, rd, addr, 0, sz, signed)
		return
	}
	var ptr int = getOperand(a, rm, arg.ID)
	if ptr < 0 { return }
	var rd int = nextReg(rm, ins.ID)
	emitScalarLoad(a, rd, ptr, 0, sz, signed)
}

// emitStore: OP_STORE — aggregate stores memcpy via emitStructCopy; scalar
// stores size-dispatch to STRB/STRH/STR.  A global destination is reached via
// MOVW/MOVT first.
func emitStore(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	if callconv.IsAggregateTyp(ins.Args[1].Typ) {
		emitStructCopy(a, pkgName, rm, ins)
		return
	}
	if isPair64Typ(ins.Args[1].Typ) {
		emitStore64(a, pkgName, rm, ins)
		return
	}
	if ins.Args[0].Op == iropcode.OP_GET_FIELD_PTR && rm.IsFusableFieldGep(ins.Args[0].ID) {
		emitFusedFieldStore(a, pkgName, rm, ins, ins.Args[0])
		return
	}
	if emitFloatStoreFromHome(a, pkgName, rm, ins) { return }
	var sz int = wordBytes()
	if ins.Args[1].Typ != nil { sz = ins.Args[1].Typ.SizeOf() }
	if sz <= 0 { sz = wordBytes() }
	var off int = rm.LookupAlloc(ins.Args[0].ID)
	var valReg int = emitValOperand(a, pkgName, rm, ins.Args[1])
	if valReg < 0 { return }
	if off >= 0 {
		emitFrameScalarStore(a, valReg, off, sz)
		return
	}
	if isGlobalRef(ins.Args[0]) {
		var addr int = scratchReg(rm)
		emitGlobalAddr(a, pkgName, addr, ins.Args[0])
		emitScalarStore(a, valReg, addr, 0, sz)
		return
	}
	var ptr int = getOperand(a, rm, ins.Args[0].ID)
	if ptr < 0 { return }
	emitScalarStore(a, valReg, ptr, 0, sz)
}

// emitStructCopy lowers an OP_STORE that copies a struct / array / slice as a
// word-by-word memcpy.  Source pointer from Args[1], dest from Args[0]; either
// endpoint may be a package-level global (MOVW/MOVT) or a multi-return spill
// (whose bytes live directly in the slot).  Mirrors aarch64_refcount.bn's
// emitStructCopy with word=4.
func emitStructCopy(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	var sz int = ins.Args[1].Typ.SizeOf()
	if sz <= 0 { return }
	var srcPtr int
	if isGlobalRef(ins.Args[1]) {
		srcPtr = scratchReg(rm)
		emitGlobalAddr(a, pkgName, srcPtr, ins.Args[1])
	} else if callconv.IsMultiReturnCall(ins.Args[1]) {
		var srcOff int = rm.LookupSpill(ins.Args[1].ID)
		if srcOff < 0 { return }
		srcPtr = scratchReg(rm)
		emitFrameAddr(a, srcPtr, srcOff)
	} else {
		srcPtr = getOperand(a, rm, ins.Args[1].ID)
	}
	if srcPtr < 0 { return }
	var dstPtr int
	var allocOff int = rm.LookupAlloc(ins.Args[0].ID)
	if allocOff >= 0 {
		dstPtr = scratchReg(rm)
		emitFrameAddr(a, dstPtr, allocOff)
	} else if isGlobalRef(ins.Args[0]) {
		dstPtr = scratchReg(rm)
		emitGlobalAddr(a, pkgName, dstPtr, ins.Args[0])
	} else {
		dstPtr = getOperand(a, rm, ins.Args[0].ID)
	}
	if dstPtr < 0 { return }
	// Byte-wise for a sub-word-aligned aggregate (may sit at a non-word-aligned
	// address → a word LDR/STR would fault on strict-align MMU-less arm32); word-wise
	// otherwise.  The per-element offset can exceed the 12-bit immediate for a > 4KB
	// aggregate, so IP materializes the address (srcPtr / dstPtr / tmp are pool
	// registers, never IP).  A large copy is a loop, never an aliasing one.
	var byteWise bool = aggNeedsBytewiseArm32(ins.Args[1].Typ)
	if aggCopyIsLoop(sz, byteWise) {
		emitAggCopyLoopArm32(a, rm, dstPtr, 0, srcPtr, 0, sz, byteWise, arm32.IP)
		return
	}
	emitAggMemcpySafeArm32(a, rm, dstPtr, srcPtr, sz, byteWise, scratchReg(rm), arm32.IP)
}

// emitGetElemPtr: OP_GET_ELEM_PTR — compute base + idx*elemSize.  A package-
// level global base is reached via MOVW/MOVT.  A power-of-two elemSize folds
// the scaling into the ADD's shifted-register operand (`add rd, base, idx, lsl
// #k`); any other size materializes the size and MULs into a scratch.
func emitGetElemPtr(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	var elemSize int = common.ElemSizeOf(ins)
	if elemSize <= 0 { return }
	var idx int = getOperand(a, rm, ins.Args[1].ID)
	if idx < 0 { return }

	var byteOff arm32.Operand
	var shift int = strength.Pow2Log(cast(uint64, elemSize))
	if shift == 0 {
		byteOff = arm32.Reg(idx)
	} else if shift > 0 {
		byteOff = arm32.RegShift(idx, arm32.LSL, shift)
	} else {
		var sizeTmp int = scratchReg(rm)
		emitConstInt32(a, sizeTmp, elemSize)
		var prod int = scratchReg(rm)
		arm32.Mul(a, arm32.COND_AL, false, prod, idx, sizeTmp)
		byteOff = arm32.Reg(prod)
	}

	// A frame or global base is materialized into a scratch rather than into
	// rd: byteOff may still read idx, and rd may share idx's register when idx
	// dies at this instruction.
	var rd int
	var allocOff int = rm.LookupAlloc(ins.Args[0].ID)
	if allocOff >= 0 {
		var fb int = scratchReg(rm)
		emitFrameAddr(a, fb, allocOff)
		rd = nextReg(rm, ins.ID)
		arm32.Add(a, arm32.COND_AL, false, rd, fb, byteOff)
		return
	}
	if isGlobalRef(ins.Args[0]) {
		var gb int = scratchReg(rm)
		emitGlobalAddr(a, pkgName, gb, ins.Args[0])
		rd = nextReg(rm, ins.ID)
		arm32.Add(a, arm32.COND_AL, false, rd, gb, byteOff)
		return
	}
	var base int = getOperand(a, rm, ins.Args[0].ID)
	if base < 0 { return }
	rd = nextReg(rm, ins.ID)
	arm32.Add(a, arm32.COND_AL, false, rd, base, byteOff)
}

// emitGetFieldPtr: OP_GET_FIELD_PTR — compute base + FieldOffset.  A slice base
// (raw or managed) gets a flat wordBytes*Index offset — its fields are
// data / len / [refptr / backingLen] in pointer-sized slots, matching
// types.SliceDataOffset / MSliceDataOffset (both ptrSize-strided).  A real
// struct base uses the struct's FieldOffset.  A package-level global base is
// reached via MOVW/MOVT.  Mirrors aarch64_emit.bn's emitGetFieldPtr with word=4.
func emitGetFieldPtr(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	// A fusable field GEP folds into its sole consuming load/store's immediate
	// offset (emitFusedFieldLoad / emitFusedFieldStore rederive the address from
	// this GEP's base + FieldByteOffset), so emit nothing here.
	if rm.IsFusableFieldGep(ins.ID) { return }
	var fieldOff int
	var baseTyp @types.Type = common.StructTypeOf(ins.Args[0])
	if baseTyp != nil {
		fieldOff = baseTyp.FieldOffset(ins.Index)
	} else if common.IsSliceFieldBase(ins.Args[0]) {
		fieldOff = wordBytes() * ins.Index
	} else {
		return
	}
	var rd int = nextReg(rm, ins.ID)
	var allocOff int = rm.LookupAlloc(ins.Args[0].ID)
	if allocOff >= 0 {
		emitFrameAddr(a, rd, allocOff + fieldOff)
		return
	}
	if isGlobalRef(ins.Args[0]) {
		emitGlobalAddr(a, pkgName, rd, ins.Args[0])
		if fieldOff != 0 {
			emitAddImm(a, rd, rd, fieldOff, arm32.IP)
		}
		return
	}
	var ptr int = getOperand(a, rm, ins.Args[0].ID)
	if ptr < 0 { return }
	emitAddImm(a, rd, ptr, fieldOff, arm32.IP)
}
