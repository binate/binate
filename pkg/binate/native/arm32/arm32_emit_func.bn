package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// emitFunc — prologue, body, epilogue
// ============================================================

// SAVED_LOW is the callee-saved register set pushed on entry and restored on
// exit: r4-r12 (the callee-saved scratch pool + frame pointer, plus r12/IP).
// r4..r12 = bits 4..12 = 0x1FF0.  r12 rounds the pushed count to an EVEN 10
// registers so SP stays 8-aligned at every call boundary — see SAVED_BYTES.
const SAVED_LOW int = 0x1FF0

// PUSH_REGMASK adds LR (r14, bit 14 = 0x4000) to the saved-low set, so the
// prologue's `push {r4-r12, lr}` stores the return address alongside the
// callee-saved registers.
const PUSH_REGMASK int = 0x5FF0

// POP_REGMASK adds PC (r15, bit 15 = 0x8000) to the saved-low set, so the
// epilogue's `pop {r4-r12, pc}` reloads the saved registers AND jumps to the
// saved return address in one instruction (writing PC from the stack returns).
const POP_REGMASK int = 0x9FF0

// SAVED_BYTES is the size (in bytes) that the entry `push` reserves: 10
// registers (r4-r12 + lr) × 4 = 40.  The count is deliberately EVEN so that
// SAVED_BYTES % 8 == 0 (the AAPCS32 8-byte stack alignment invariant): since
// PlanFrame returns a 16-aligned frameSize, an even 40-byte push keeps SP
// 8-aligned across the `sub sp` — a 9-register (36-byte) push would leave SP
// 4-misaligned at every call boundary, violating AAPCS32.  Incoming stack args
// sit above it, at [sp + frameSize + SAVED_BYTES + i*4] from the callee's
// perspective.
const SAVED_BYTES int = 40

// emitFunc lowers one function.  The prologue saves the callee-saved
// registers + LR and allocates the local stack frame; the epilogue reverses
// (popping PC to return).  Mirrors aarch64_emit_func.bn but with the AAPCS32
// register set and 4-byte word.
func emitFunc(a @asm.Assembler, pkgName *[]readonly char, f @ir.Func, strings @[]ir.StringConst,
		allFuncs @[]@ir.Func) {
	// f.Name is dot-qualified ("pkg.Func", "main.main", "main.__entry");
	// symFor → mangle.FuncName treats dotted names as pre-qualified, so the
	// pkgName arg is ignored.  main.__entry folds to the reserved bn_entry.
	var sym @[]char = symFor(pkgName, f.Name)
	a.DefineLabel(sym)
	// IsLinkOnce (dtors / copy helpers, emitted into every module that needs
	// them) gets a weak definition so the linker deduplicates across the
	// linked .o set.  LLVM uses linkonce_odr for the same role.
	if f.IsLinkOnce {
		a.SetWeak(sym)
	} else {
		a.SetGlobal(sym)
	}

	// AAPCS32 (soft-float): 4 GP arg registers, 64-bit args in even-aligned
	// register pairs, 8-byte stack alignment, floats in GP registers.
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var frameSize int = rm.PlanFrame(f)

	// Prologue:
	//   push {r4-r12, lr}      ; STMDB sp!, {r4-r12, lr}
	//   sub  sp, sp, #frameSize
	arm32.Push(a, arm32.COND_AL, PUSH_REGMASK)
	if frameSize > 0 {
		emitSpAdjust(a, false, frameSize)
	}

	// AAPCS32 sret: a function returning an aggregate (or multi-return tuple)
	// above the sret threshold receives the hidden buffer pointer in R0 (the
	// first GP arg register).  Stash it at SP+SretSlotOff so emitReturn can
	// read it back when copying the result.  PlanFrame sets SretSlotOff >= 0
	// iff this function is sret-returning.  This must run before the param-spill
	// loop, which shifts params to R1.. and would otherwise treat R0 as param 0.
	if rm.SretSlotOff >= 0 {
		emitFrameStore(a, arm32.R0, rm.SretSlotOff)
	}

	// Spill incoming parameter registers (and read incoming stack args) to
	// their stack slots so later uses — which go through getOperand → spill
	// reload — see them.  Mirrors the AAPCS32 arg dispatch: the same
	// regStart/stackOff per param.  The trivial skeleton has no params, so
	// this loop is empty for main.__entry / main.__init_all / main.main.
	//
	// Incoming stack args sit in the caller's outgoing-args area, now at
	// [sp + frameSize + SAVED_BYTES + i*4] from the callee's perspective:
	// +frameSize undoes our `sub sp`, +SAVED_BYTES undoes the entry push.
	//
	// When this function returns via sret (SretSlotOff >= 0), every user param
	// shifts by one GP register — param 0 arrives in R1, not R0 (R0 holds the
	// hidden buffer pointer stashed above).  Model the shift the same way
	// emitCall does: synthesise a pointer-typed leading entry in paramTypes so
	// CallArgRegStart returns the user param's actual reg index (pi + 1).
	var sretShift bool = rm.SretSlotOff >= 0
	var nDispatch int = len(f.Params)
	if sretShift { nDispatch = nDispatch + 1 }
	var paramTypes @[]@types.Type = make_slice(@types.Type, nDispatch)
	if sretShift {
		paramTypes[0] = types.MakePointerType(types.TypUint8())
		for pi := 0; pi < len(f.Params); pi++ {
			paramTypes[pi + 1] = f.Params[pi].Typ
		}
	} else {
		for pi := 0; pi < len(f.Params); pi++ {
			paramTypes[pi] = f.Params[pi].Typ
		}
	}
	var stackArgsBase int = frameSize + SAVED_BYTES
	for pi := 0; pi < len(f.Params); pi++ {
		var dispatchIdx int = pi
		if sretShift { dispatchIdx = pi + 1 }
		emitSpillParam(a, rm, f.Params[pi], paramTypes, dispatchIdx, stackArgsBase)
	}

	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		if bi > 0 {
			a.DefineLabel(blockLabel(sym, b.Label))
		}
		// Each block starts with a fresh regmap.  Cross-block values flow
		// through spill slots.
		rm.ResetRegs()
		for ii := 0; ii < len(b.Instrs); ii++ {
			emitInstr(a, pkgName, sym, rm, strings, allFuncs, b.Instrs[ii])
			spillAndReset(a, rm, b.Instrs[ii])
		}
	}

	// Safety net: emit an epilogue if the IR didn't end with OP_RETURN.
	emitEpilogueAndRet(a, frameSize)
}

// emitSpillParam stores one incoming parameter to its frame slot so later uses
// (which reload via getOperand) see it.  dispatchIdx is the param's position in
// paramTypes, which — for an sret-returning function — carries a synthesised
// leading sret-pointer slot, so a user param's dispatchIdx is one past its
// positional index.  A scalar param spills its register (or reloads its incoming
// stack slot); an aggregate param (raw / managed slice) is reconstructed into
// its data region and a pointer to that region is written to the spill slot.  A
// float param (soft-float lowering is a later increment) and a 64-bit-pair
// scalar param fail LOUDLY: silently not spilling them would leave later uses
// reading an uninitialized slot (garbage).
func emitSpillParam(a @asm.Assembler, rm @common.RegMap, p @ir.Param, paramTypes @[]@types.Type,
		dispatchIdx int, stackArgsBase int) {
	if common.IsFloatScalarTyp(p.Typ) {
		a.SetError("native arm32: float parameter not implemented (P5)")
		return
	}
	var regStart int = rm.CC.CallArgRegStart(paramTypes, dispatchIdx)
	var stackOff int = rm.CC.CallArgStackOff(paramTypes, dispatchIdx)
	// A 64-bit scalar param arrives as an even-aligned register pair
	// (argReg(regStart):argReg(regStart+1)) or an 8-byte incoming stack slot;
	// spill both words to its frame slot so later uses reload the pair.
	if isReg64Scalar(p.Typ) {
		emitSpillParam64(a, rm, p, regStart, stackOff, stackArgsBase)
		return
	}
	if common.IsAggregateTyp(p.Typ) {
		emitSpillAggregateParam(a, rm, p, regStart, stackOff, stackArgsBase)
		return
	}
	var off int = rm.LookupSpill(p.ID)
	if off < 0 { return }
	if regStart >= 0 {
		emitFrameStore(a, argReg(regStart), off)
	} else if stackOff >= 0 {
		var tmp int = scratchReg(rm)
		emitFrameLoad(a, tmp, stackArgsBase + stackOff)
		emitFrameStore(a, tmp, off)
		rm.ResetRegs()
	}
}

// emitSpillParam64 spills an incoming 64-bit (int64 / uint64) parameter to its
// frame slot.  A register-pair param copies argReg(regStart) → [slot+0] and
// argReg(regStart+1) → [slot+4]; a stack param (past r0-r3) copies the two words
// from the caller's outgoing-args area.  Later uses reload the pair via load64.
func emitSpillParam64(a @asm.Assembler, rm @common.RegMap, p @ir.Param, regStart int, stackOff int,
		stackArgsBase int) {
	var off int = rm.LookupSpill(p.ID)
	if off < 0 { return }
	if regStart >= 0 {
		emitFrameStore(a, argReg(regStart), off)
		emitFrameStore(a, argReg(regStart + 1), off + 4)
		return
	}
	if stackOff >= 0 {
		var tmp int = scratchReg(rm)
		emitFrameLoad(a, tmp, stackArgsBase + stackOff)
		emitFrameStore(a, tmp, off)
		emitFrameLoad(a, tmp, stackArgsBase + stackOff + 4)
		emitFrameStore(a, tmp, off + 4)
		rm.ResetRegs()
	}
}

// emitSpillAggregateParam reconstructs an incoming aggregate parameter into its
// data region and writes a pointer to that region into its spill slot, so
// downstream uses see a uniform pointer.  In-reg words come from argReg(regStart
// + w); overflow words are copied from the caller's outgoing-args area.  An
// indirect-large aggregate (> AggregateInRegMax) arrives as a single pointer,
// whose pointee is memcpy'd into the local region (AAPCS byval gives the callee
// its own copy).  Mirrors aarch64_emit_func.bn's aggregate param arm with word=4
// and R12 (IP) as the marshaling temp.
func emitSpillAggregateParam(a @asm.Assembler, rm @common.RegMap, p @ir.Param, regStart int,
		stackOff int, stackArgsBase int) {
	var dataOff int = rm.LookupAlloc(p.ID)
	var allocSz int = rm.LookupAllocSize(p.ID)
	if dataOff < 0 || allocSz <= 0 { return }
	var w int = wordBytes()
	var nWords int = rm.CC.ArgWords(p.Typ)
	if rm.CC.IndirectLargeAggregates && p.Typ.SizeOf() > rm.CC.AggregateInRegMax {
		// Get the byval pointer into IP, then memcpy *IP → sp+dataOff.
		if regStart >= 0 {
			if argReg(regStart) != arm32.IP {
				arm32.Mov(a, arm32.COND_AL, false, arm32.IP, arm32.Reg(argReg(regStart)))
			}
		} else if stackOff >= 0 {
			arm32.Ldr(a, arm32.COND_AL, arm32.IP, arm32.MemImm(arm32.SP, stackArgsBase + stackOff))
		}
		var tmp int = scratchReg(rm)
		for wi := 0; wi < nWords; wi++ {
			arm32.Ldr(a, arm32.COND_AL, tmp, arm32.MemImm(arm32.IP, w * wi))
			arm32.Str(a, arm32.COND_AL, tmp, arm32.MemImm(arm32.SP, dataOff + w * wi))
		}
		writeAggParamSpillPtr(a, rm, p, dataOff)
		rm.ResetRegs()
		return
	}
	// ≤ AggregateInRegMax: store in-reg words to the region, then copy any
	// overflow words from the caller's outgoing-args area.
	var regWords int = 0
	if regStart >= 0 {
		regWords = nWords
		if stackOff >= 0 { regWords = rm.CC.NumGpArgRegs - regStart }
		for wi := 0; wi < regWords; wi++ {
			arm32.Str(a, arm32.COND_AL, argReg(regStart + wi), arm32.MemImm(arm32.SP, dataOff + w * wi))
		}
	}
	if stackOff >= 0 {
		var tmp int = scratchReg(rm)
		for wi := regWords; wi < nWords; wi++ {
			arm32.Ldr(a, arm32.COND_AL, tmp,
					arm32.MemImm(arm32.SP, stackArgsBase + stackOff + w * (wi - regWords)))
			arm32.Str(a, arm32.COND_AL, tmp, arm32.MemImm(arm32.SP, dataOff + w * wi))
		}
	}
	writeAggParamSpillPtr(a, rm, p, dataOff)
	rm.ResetRegs()
}

// writeAggParamSpillPtr stores a pointer to an aggregate param's data region
// (sp + dataOff) into its spill slot, so downstream getOperand reloads a uniform
// pointer for the value.
func writeAggParamSpillPtr(a @asm.Assembler, rm @common.RegMap, p @ir.Param, dataOff int) {
	var spillOff int = rm.LookupSpill(p.ID)
	if spillOff < 0 { return }
	var tmp int = scratchReg(rm)
	emitFrameAddr(a, tmp, dataOff)
	emitFrameStore(a, tmp, spillOff)
}
