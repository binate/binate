package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/native/fold"
import "pkg/binate/types"

// ============================================================
// emitFunc — prologue, body, epilogue
// ============================================================

// The prologue saves the same callee-saved set as a clang -fno-omit-frame-pointer
// arm32 frame — r4-r12 + LR — but in TWO pushes so it can establish a walkable
// AAPCS frame-pointer chain: `push {fp,lr}; mov fp,sp` makes fp point at a
// `{caller fp, return addr}` record ([fp]=caller fp, [fp+4]=ret addr — the same
// shape x64/aa64 use, scaled by the 4-byte word), then `push {r4-r10,r12}` saves
// the rest.  rt.CaptureNativeFrames (pkg/std/debug stacktraces) walks that chain.

// FP_LR_MASK = {fp (r11, bit 11 = 0x800), lr (r14, bit 14 = 0x4000)} — the frame
// record pushed FIRST, so fp can point at it.
const FP_LR_MASK int = 0x4800

// LOW_SAVED_MASK = {r4-r10 (bits 4-10 = 0x7F0), r12/IP (bit 12 = 0x1000)} — the
// remaining callee-saved registers, pushed AFTER the frame record.  Including r12
// keeps the two pushes at 2+8 registers so SP stays 8-aligned (see SAVED_BYTES).
const LOW_SAVED_MASK int = 0x17F0

// FP_PC_MASK = {fp (r11), pc (r15, bit 15 = 0x8000)} — the epilogue's final pop
// reloads the caller's fp AND returns (writing PC from the stack) in one op.
const FP_PC_MASK int = 0x8800

// SAVED_BYTES is the total the two entry pushes reserve: 10 registers
// (r4-r12 + fp + lr) × 4 = 40.  Deliberately EVEN so SAVED_BYTES % 8 == 0 (the
// AAPCS32 8-byte stack alignment invariant): since PlanFrame returns a 16-aligned
// frameSize, an even 40-byte save keeps SP 8-aligned across the `sub sp`.
// Incoming stack args sit above it, at [sp + frameSize + SAVED_BYTES + i*4] from
// the callee's perspective — the split into two pushes does not change this total
// nor the final SP position, so every spill/param/stack-arg offset is unchanged.
const SAVED_BYTES int = 40

// emitFunc lowers one function.  The prologue saves the callee-saved
// registers + LR and allocates the local stack frame; the epilogue reverses
// (popping PC to return).  Mirrors aarch64_emit_func.bn but with the AAPCS32
// register set and 4-byte word.
func emitFunc(a @asm.Assembler, pkgName *[]readonly char, f @ir.Func, strings @[]ir.StringConst) {
	// f.Name is dot-qualified ("pkg.Func", "main.main", "main.__entry");
	// symFor → mangle.FuncName treats dotted names as pre-qualified, so the
	// pkgName arg is ignored.  main.__entry folds to the reserved bn_entry.
	var sym @[]char = symFor(pkgName, f.Name)
	// AAPCS32 (soft-float): 4 GP arg registers, 64-bit args in even-aligned
	// register pairs, 8-byte stack alignment, floats in GP registers.
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// Register allocation (before PlanFrame): home scalar SSA values in the
	// CALLER-saved bank R0..R3.  Unlike aarch64/x64 (callee-saved homes), arm32
	// has no free callee-saved register — R4..R10 are the scratch pool and R11
	// is the frame pointer — so homes are caller-saved and CalleeSaved is empty.
	// Caller-saved homes need NO prologue/epilogue save/restore, but they ARE
	// destroyed by any returning call, so the clobber machinery is ACTIVE here:
	// Int64OpsClobber + SoftFloatOpsClobber mark arm32's AEABI libcalls (int64
	// mul/div/rem/shl/shr and int64<->float cast, plus — under soft-float —
	// float arith/compare/cast) as clobbers on top of common.EmitsReturningBl,
	// so the allocator only homes a value in R0..R3 when it is NOT live across
	// any such op (spansClobber); a call-spanning value spills.  Since R0..R3
	// are also the arg/return registers, param landing uses spill-then-reload
	// (below) and emitCall parallel-moves homed args into place.  f is phi-free
	// here (EliminatePhis ran in EmitObject).  wordBytes=4 (ILP32), so int64 is
	// non-allocatable (a register pair) and never homed.
	var rdesc common.RegClassDesc
	rdesc.CallerSaved = arm32AllocatablePool()
	rdesc.Int64OpsClobber = true
	rdesc.SoftFloatOpsClobber = !types.Arm32HardFloat()
	// Flag the fold candidates BEFORE allocation so their never-read results stay
	// unhomed (wordBytes=4, so int64 register-pair GEPs / pair-compares are
	// excluded): a field GEP folds into a load/store's immediate offset
	// (emitGetFieldPtr skips it; the access rederives the address inline), and a
	// 32-bit integer compare folds into its consuming conditional branch (a
	// flag-setting CMP + conditional B, no 0/1 boolean materialized).
	rm.FusableFieldGep = common.FusableFieldGeps(f, 4)
	rm.FusedCmp = fold.BranchFusedCmps(f, 4)
	// Flag integer constants used only as compare RHS immediates: they ride the
	// CMP/CMN immediate operand, so emitConstInt32 skips materializing them and the
	// allocator leaves them unhomed.  Range is 0..255 (and -255..-1 for a signed
	// compare via CMN) — every value there is a valid rotation-0 modified immediate;
	// larger encodable modified immediates are left unfolded (conservative).
	rm.FoldedImmConst = fold.ImmFoldableConsts(f, cast(int64, 255), cast(int64, -255))
	rm.AllocateRegisters(f, 4, rdesc, true)
	// Caller-saved homes (R0..R3) OVERLAP the argument / target / return
	// registers, so a value homed in R0..R3 that is marshalled INTO those
	// registers would be clobbered by the marshalling itself.  Two families do
	// that marshalling, and BOTH can shuffle >1 value through R0..R3 (a
	// multi-value permutation the naive per-value `mov` order can corrupt):
	//   - a call's argument-and-target setup (every common.EmitsReturningBl op —
	//     direct / indirect / handle / iface / c-call, plus make / box /
	//     make-slice / refdec / the guard calls; the target address of an
	//     indirect / handle / iface call is one of its Args); and
	//   - OP_RETURN's value pack (a multi-return tuple places its fields in the
	//     R0..R3 return registers — e.g. fields homed in r3,r2,r1 moving to
	//     r0,r1,r2 is a cycle that `mov r1,r2; mov r2,r1` corrupts).
	// Rather than teach every marshalling path a parallel move, simply do NOT
	// home the values it consumes: un-home the arguments of every such op.  They
	// revert to the spill-everything path (PlanFrame reserved their slots), so
	// the marshalling reads them from memory (disjoint from R0..R3).  Values
	// never used as a call/return operand (loop counters, locals) still home,
	// and a call/return RESULT still homes (landed by the home-aware collection).
	for bi := 0; bi < len(f.Blocks); bi++ {
		var eb @ir.Block = f.Blocks[bi]
		for ei := 0; ei < len(eb.Instrs); ei++ {
			var ei2 @ir.Instr = eb.Instrs[ei]
			if common.EmitsReturningBl(ei2.Op) || ei2.Op == iropcode.OP_RETURN {
				for ea := 0; ea < len(ei2.Args); ea++ {
					if ei2.Args[ea] != nil { rm.UnhomeID(ei2.Args[ea].ID) }
				}
			}
		}
	}
	// Second linear-scan pass over the FP register class (hard-float only): home
	// float values in callee-saved VFP D8..D15 instead of round-tripping them
	// through GP spill slots.  Soft-float passes an empty descriptor, so
	// AllocateFpRegisters homes nothing and the AEABI-libcall float path is
	// unchanged.  No FP un-homing is needed (unlike the GP R0..R3 loop above): the
	// D8..D15 home pool is disjoint from the D0..D7 arg/return CPRC bank, so FP
	// call-arg/return marshalling never collides with a home.
	var fpdesc common.RegClassDesc
	if types.Arm32HardFloat() {
		fpdesc.CalleeSaved = arm32FpAllocatablePool()
	}
	rm.AllocateFpRegisters(f, 4, fpdesc)
	// f64-only homes for now: un-home any f32 value the FP pass homed.  An f32
	// homes in a D-register's low S-view, but its producer sites (const / load /
	// extract / bit_cast / phi / param / return, all single-word) are not yet
	// FP-home-aware — only the f64 register-pair path (load64/store64) is.  So
	// leave f32 values GP-slotted (unchanged); f32 homing is a follow-up.
	unhomeF32Values(rm, f)
	var frameSize int = rm.PlanFrame(f)
	// Lazy spill (dead-store elimination): stamp the assembler back-channel so
	// allocReg can spill a dirty value it must evict, and precompute the
	// per-instruction live-before sets that gate which dirty values to spill at
	// each cache-drop point (vs. drop unstored — a dead store).
	rm.CurAsm = a
	var liveBefore @[]@[]@[]bool = common.ComputeLiveBeforeAllFused(f, 4,
			common.UnionFusable(rm.FusableGep, rm.FusableFieldGep))
	// Parameter dispatch types (shared by the #[c_export] prefix below and the param-spill
	// loop).  When this function returns via sret (SretSlotOff >= 0), every user param shifts
	// by one GP register — param 0 arrives in R1, not R0 (R0 holds the hidden buffer pointer)
	// — modeled by a synthesised pointer-typed leading entry so CallArgRegStart returns the
	// actual reg index (pi + 1).
	var sretShift bool = rm.SretSlotOff >= 0
	var nDispatch int = len(f.Params)
	if sretShift {
		nDispatch = nDispatch + 1
	}
	var paramTypes @[]@types.Type = make_slice(@types.Type, nDispatch)
	if sretShift {
		paramTypes[0] = types.MakePointerType(types.TypUint8())
		for pi := 0; pi < len(f.Params); pi++ {
			paramTypes[pi + 1] = f.Params[pi].Typ
		}
	} else {
		for pi := 0; pi < len(f.Params); pi++ {
			paramTypes[pi] = f.Params[pi].Typ
		}
	}
	// #[c_export("name")] C-entry thunk: emit the unmangled C name(s) as a label, then a
	// narrow-argument normalization, then a branch to the mangled `sym` — so a C caller
	// (entering at the alias) sign-/zero-extends the narrow argument registers whose high bits
	// AAPCS32 leaves unspecified and jumps into the body, while a native caller (entering at
	// `sym`, already passing extended narrow args) skips it.  The branch keeps the alias a
	// self-contained atom independent of the mangled entry's placement (matching the aa64/x64
	// backends, whose ld64 splits per-symbol atoms).  When the normalization is empty (int32
	// is word-sized on AAPCS32, so most narrow args do not need it) the alias and `sym` share
	// the entry offset and no branch is emitted.  symPrefixed (NOT symFor) applies only the
	// object-format link prefix (ELF-bare on arm32), leaving the name un-bn_-mangled — the
	// __c_call callee discipline.  A C export is a strong global regardless of linkage.
	for ci := 0; ci < len(f.CExportNames); ci++ {
		var alias @[]char = symPrefixed(f.CExportNames[ci])
		a.DefineLabel(alias)
		a.SetGlobal(alias)
	}
	if len(f.CExportNames) > 0 {
		if cExportNeedsTrampolineArm32(f, rm.CC) {
			// A >16-byte by-value aggregate param (AAPCS32 splits it across r0-r3 +
			// the stack, vs `sym`'s pointer-in-register) or a divergent multi-value
			// return (C struct-return ABI vs the internal register return) — an
			// in-place fixup + branch cannot serve, so emit an adapter trampoline that
			// re-marshals the args, calls `sym`, and adapts the return.
			emitCExportTrampolineArm32(a, rm, f, sym)
		} else {
			var preOff uint = a.CurrentOffset()
			emitCExportRegNormArm32(a, rm, f)
			if a.CurrentOffset() > preOff {
				arm32.B(a, arm32.COND_AL, sym)
			}
		}
	}
	a.DefineLabel(sym)
	// IsLinkOnce (dtors / copy helpers, emitted into every module that needs them) gets a
	// weak definition so the linker deduplicates across the linked .o set.  LLVM uses
	// linkonce_odr for the same role.
	if f.IsLinkOnce {
		a.SetWeak(sym)
	} else {
		a.SetGlobal(sym)
	}

	// Prologue (establishes the frame-pointer chain so a stacktrace can walk it):
	//   push {fp, lr}          ; frame record: [fp]=caller fp, [fp+4]=ret addr
	//   mov  fp, sp            ; fp -> the record
	//   push {r4-r10, r12}     ; remaining callee-saved registers
	//   sub  sp, sp, #frameSize
	arm32.Push(a, arm32.COND_AL, FP_LR_MASK)
	arm32.Mov(a, arm32.COND_AL, false, arm32.FP, arm32.Reg(arm32.SP))
	arm32.Push(a, arm32.COND_AL, LOW_SAVED_MASK)
	if frameSize > 0 {
		emitSpAdjust(a, false, frameSize)
	}
	// Save the callee-saved VFP homes (hard-float) the FP pass used, into the FP
	// save area (at SavedFpRegsOff, inside the frame).  Empty until the FP pass
	// runs.  IP is a safe large-offset scratch here (already pushed, not yet
	// holding a param).  emitEpilogueAndRet restores.
	for fi := 0; fi < len(rm.SavedFpRegs); fi++ {
		vfpStoreBaseHard(a, true, rm.SavedFpRegs[fi], arm32.SP, rm.SavedFpRegsOff + 8 * fi, arm32.IP)
	}

	// AAPCS32 sret: a function returning an aggregate (or multi-return tuple)
	// above the sret threshold receives the hidden buffer pointer in R0 (the
	// first GP arg register).  Stash it at SP+SretSlotOff so emitReturn can
	// read it back when copying the result.  PlanFrame sets SretSlotOff >= 0
	// iff this function is sret-returning.  This must run before the param-spill
	// loop, which shifts params to R1.. and would otherwise treat R0 as param 0.
	if rm.SretSlotOff >= 0 {
		emitFrameStore(a, arm32.R0, rm.SretSlotOff)
	}

	// Spill incoming parameter registers (and read incoming stack args) to
	// their stack slots so later uses — which go through getOperand → spill
	// reload — see them.  Mirrors the AAPCS32 arg dispatch: the same
	// regStart/stackOff per param.  The trivial skeleton has no params, so
	// this loop is empty for main.__entry / bn_init / main.main.
	//
	// Incoming stack args sit in the caller's outgoing-args area, now at
	// [sp + frameSize + SAVED_BYTES + i*4] from the callee's perspective:
	// +frameSize undoes our `sub sp`, +SAVED_BYTES undoes the entry push.
	var stackArgsBase int = frameSize + SAVED_BYTES
	for pi := 0; pi < len(f.Params); pi++ {
		var dispatchIdx int = pi
		if sretShift { dispatchIdx = pi + 1 }
		emitSpillParam(a, rm, f.Params[pi], paramTypes, dispatchIdx, stackArgsBase)
	}

	// Register-allocated (homed) GP scalar params: spillIncomingParams above wrote
	// EVERY param to its stack slot (reading the incoming arg registers, never
	// writing R0..R3), so the incoming values are now safely in memory.  Load
	// each homed param from its slot into its home register.  This spill-then-
	// reload avoids the register shuffle a direct arg-reg -> home-reg landing
	// would hit (homes overlap the arg registers R0..R3): the spill phase above
	// touches no R0..R3, so no incoming arg value is clobbered before it is
	// saved; this phase reads only memory and writes homes.  An FP-homed float
	// param is EXCLUDED here: it was already moved into its D-register home by
	// emitSpillParamFloatHard (a VFP register move, safe because the FP home pool
	// D8..D15 is disjoint from the D0..D7 arg bank — no shuffle hazard), and its
	// GP-addressed emitFrameLoad here would mis-encode the D-home number as a GP
	// register (the low 4 bits of D15's number are r15/PC).
	for pi := 0; pi < len(f.Params); pi++ {
		var phome int = rm.LookupHome(f.Params[pi].ID)
		if phome >= 0 && !isFpReg(phome) {
			var poff int = rm.LookupSpill(f.Params[pi].ID)
			if poff >= 0 {
				emitFrameLoad(a, phome, poff)
			}
		}
	}

	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		if bi > 0 {
			a.DefineLabel(blockLabel(sym, b.Label))
		}
		// Each block starts with a fresh regmap.  Cross-block values flow
		// through spill slots.
		rm.ResetRegs()
		var lb @[]@[]bool = liveBefore[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			// Fresh current-instruction claim set; the retained value cache
			// (IDs/Regs) carries forward within the block so a use reads a
			// register instead of reloading.
			rm.ClearUsed()
			// Pre-op barrier: an op whose emitter drops the register cache
			// mid-emission (an internal rm.ResetRegs, reloading its operands from
			// their slots) or writes a pool register outside allocReg must find
			// the values live INTO it already spilled.  This is a safe-by-default
			// ALLOWLIST: retention flows THROUGH only the proven-clean 32-bit
			// integer ops (arm32RetentionSafe — arithmetic/compare/cast/load/store
			// /copy/alloc/pointer, all scratched via allocReg); everything else
			// barriers — the soft-float and int64-pair libcall families (which
			// reset), the returning-BL family, OP_RETURN, the rodata byte-store
			// loops, and any new op — so a missed reset-y op can never drop a
			// dirty value.
			if !arm32RetentionSafe(ins) {
				spillDirtyLive(a, rm, lb[ii])
				rm.ResetRegs()
			}
			var fixupsBefore int = a.Sections[a.Current].NumFixups
			emitInstr(a, pkgName, sym, rm, strings, ins)
			var branchEmitted bool = a.Sections[a.Current].NumFixups != fixupsBefore
			// Record the result: allocatable 32-bit scalar dirty-marked (deferred
			// / elided store), non-allocatable eagerly stored.
			handleResult(a, rm, ins)
			// A returning BL clobbers the caller-saved scratch, and a branch to a
			// skipped inline block desyncs the cache — spill the values live OUT
			// of this op, then drop the cache.
			if branchEmitted || common.EmitsReturningBl(ins.Op) {
				spillDirtyLive(a, rm, lb[ii + 1])
				rm.ResetRegs()
			}
		}
		// Block end: spill the dirty values live OUT of the block; the next
		// block's entry ResetRegs drops the dead remainder unstored.
		spillDirtyLive(a, rm, lb[len(b.Instrs)])
	}

	// Safety net: emit an epilogue if the IR didn't end with OP_RETURN.
	emitEpilogueAndRet(a, rm, frameSize)
}

// arm32AllocatablePool returns the registers the linear-scan allocator homes
// scalar values in: the AAPCS32 caller-saved bank R0..R3.  These are also the
// argument/return registers, so a homed value is destroyed by any returning
// call — the active clobber model (Int64OpsClobber / SoftFloatOpsClobber, plus
// common.EmitsReturningBl) keeps a call-spanning value out of them — and param
// / arg placement must route around them (spill-then-reload for incoming
// params; emitCall's parallel move for outgoing args).  R4..R10 are the scratch
// pool and R11 is the frame pointer, so no callee-saved register is free for a
// home; the caller-saved choice needs no prologue save/restore.
func arm32AllocatablePool() @[]int {
	var p @[]int = make_slice(int, 4)
	p[0] = arm32.R0
	p[1] = arm32.R1
	p[2] = arm32.R2
	p[3] = arm32.R3
	return p
}
