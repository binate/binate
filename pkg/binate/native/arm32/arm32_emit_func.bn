package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// emitFunc — prologue, body, epilogue
// ============================================================

// The prologue saves the same callee-saved set as a clang -fno-omit-frame-pointer
// arm32 frame — r4-r12 + LR — but in TWO pushes so it can establish a walkable
// AAPCS frame-pointer chain: `push {fp,lr}; mov fp,sp` makes fp point at a
// `{caller fp, return addr}` record ([fp]=caller fp, [fp+4]=ret addr — the same
// shape x64/aa64 use, scaled by the 4-byte word), then `push {r4-r10,r12}` saves
// the rest.  rt.CaptureNativeFrames (pkg/std/debug stacktraces) walks that chain.

// FP_LR_MASK = {fp (r11, bit 11 = 0x800), lr (r14, bit 14 = 0x4000)} — the frame
// record pushed FIRST, so fp can point at it.
const FP_LR_MASK int = 0x4800

// LOW_SAVED_MASK = {r4-r10 (bits 4-10 = 0x7F0), r12/IP (bit 12 = 0x1000)} — the
// remaining callee-saved registers, pushed AFTER the frame record.  Including r12
// keeps the two pushes at 2+8 registers so SP stays 8-aligned (see SAVED_BYTES).
const LOW_SAVED_MASK int = 0x17F0

// FP_PC_MASK = {fp (r11), pc (r15, bit 15 = 0x8000)} — the epilogue's final pop
// reloads the caller's fp AND returns (writing PC from the stack) in one op.
const FP_PC_MASK int = 0x8800

// SAVED_BYTES is the total the two entry pushes reserve: 10 registers
// (r4-r12 + fp + lr) × 4 = 40.  Deliberately EVEN so SAVED_BYTES % 8 == 0 (the
// AAPCS32 8-byte stack alignment invariant): since PlanFrame returns a 16-aligned
// frameSize, an even 40-byte save keeps SP 8-aligned across the `sub sp`.
// Incoming stack args sit above it, at [sp + frameSize + SAVED_BYTES + i*4] from
// the callee's perspective — the split into two pushes does not change this total
// nor the final SP position, so every spill/param/stack-arg offset is unchanged.
const SAVED_BYTES int = 40

// emitFunc lowers one function.  The prologue saves the callee-saved
// registers + LR and allocates the local stack frame; the epilogue reverses
// (popping PC to return).  Mirrors aarch64_emit_func.bn but with the AAPCS32
// register set and 4-byte word.
func emitFunc(a @asm.Assembler, pkgName *[]readonly char, f @ir.Func, strings @[]ir.StringConst) {
	// f.Name is dot-qualified ("pkg.Func", "main.main", "main.__entry");
	// symFor → mangle.FuncName treats dotted names as pre-qualified, so the
	// pkgName arg is ignored.  main.__entry folds to the reserved bn_entry.
	var sym @[]char = symFor(pkgName, f.Name)
	a.DefineLabel(sym)
	// IsLinkOnce (dtors / copy helpers, emitted into every module that needs
	// them) gets a weak definition so the linker deduplicates across the
	// linked .o set.  LLVM uses linkonce_odr for the same role.
	if f.IsLinkOnce {
		a.SetWeak(sym)
	} else {
		a.SetGlobal(sym)
	}
	// #[c_export("name")] adds an unmangled C symbol at the function's entry
	// (the SAME section offset as `sym` — no bytes are emitted yet) in addition
	// to the mangled `sym`.  symPrefixed (NOT symFor) applies only the
	// object-format link prefix (ELF-bare on arm32), leaving the name
	// un-bn_-mangled — exactly the __c_call callee discipline.  A C export is a
	// strong global regardless of the function's own linkage.
	for ci := 0; ci < len(f.CExportNames); ci++ {
		var alias @[]char = symPrefixed(f.CExportNames[ci])
		a.DefineLabel(alias)
		a.SetGlobal(alias)
	}

	// AAPCS32 (soft-float): 4 GP arg registers, 64-bit args in even-aligned
	// register pairs, 8-byte stack alignment, floats in GP registers.
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var frameSize int = rm.PlanFrame(f)

	// Prologue (establishes the frame-pointer chain so a stacktrace can walk it):
	//   push {fp, lr}          ; frame record: [fp]=caller fp, [fp+4]=ret addr
	//   mov  fp, sp            ; fp -> the record
	//   push {r4-r10, r12}     ; remaining callee-saved registers
	//   sub  sp, sp, #frameSize
	arm32.Push(a, arm32.COND_AL, FP_LR_MASK)
	arm32.Mov(a, arm32.COND_AL, false, arm32.FP, arm32.Reg(arm32.SP))
	arm32.Push(a, arm32.COND_AL, LOW_SAVED_MASK)
	if frameSize > 0 {
		emitSpAdjust(a, false, frameSize)
	}

	// AAPCS32 sret: a function returning an aggregate (or multi-return tuple)
	// above the sret threshold receives the hidden buffer pointer in R0 (the
	// first GP arg register).  Stash it at SP+SretSlotOff so emitReturn can
	// read it back when copying the result.  PlanFrame sets SretSlotOff >= 0
	// iff this function is sret-returning.  This must run before the param-spill
	// loop, which shifts params to R1.. and would otherwise treat R0 as param 0.
	if rm.SretSlotOff >= 0 {
		emitFrameStore(a, arm32.R0, rm.SretSlotOff)
	}

	// Spill incoming parameter registers (and read incoming stack args) to
	// their stack slots so later uses — which go through getOperand → spill
	// reload — see them.  Mirrors the AAPCS32 arg dispatch: the same
	// regStart/stackOff per param.  The trivial skeleton has no params, so
	// this loop is empty for main.__entry / main.__init_all / main.main.
	//
	// Incoming stack args sit in the caller's outgoing-args area, now at
	// [sp + frameSize + SAVED_BYTES + i*4] from the callee's perspective:
	// +frameSize undoes our `sub sp`, +SAVED_BYTES undoes the entry push.
	//
	// When this function returns via sret (SretSlotOff >= 0), every user param
	// shifts by one GP register — param 0 arrives in R1, not R0 (R0 holds the
	// hidden buffer pointer stashed above).  Model the shift the same way
	// emitCall does: synthesise a pointer-typed leading entry in paramTypes so
	// CallArgRegStart returns the user param's actual reg index (pi + 1).
	var sretShift bool = rm.SretSlotOff >= 0
	var nDispatch int = len(f.Params)
	if sretShift { nDispatch = nDispatch + 1 }
	var paramTypes @[]@types.Type = make_slice(@types.Type, nDispatch)
	if sretShift {
		paramTypes[0] = types.MakePointerType(types.TypUint8())
		for pi := 0; pi < len(f.Params); pi++ {
			paramTypes[pi + 1] = f.Params[pi].Typ
		}
	} else {
		for pi := 0; pi < len(f.Params); pi++ {
			paramTypes[pi] = f.Params[pi].Typ
		}
	}
	var stackArgsBase int = frameSize + SAVED_BYTES
	for pi := 0; pi < len(f.Params); pi++ {
		var dispatchIdx int = pi
		if sretShift { dispatchIdx = pi + 1 }
		emitSpillParam(a, rm, f.Params[pi], paramTypes, dispatchIdx, stackArgsBase,
				len(f.CExportNames) > 0)
	}

	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		if bi > 0 {
			a.DefineLabel(blockLabel(sym, b.Label))
		}
		// Each block starts with a fresh regmap.  Cross-block values flow
		// through spill slots.
		rm.ResetRegs()
		for ii := 0; ii < len(b.Instrs); ii++ {
			emitInstr(a, pkgName, sym, rm, strings, b.Instrs[ii])
			spillAndReset(a, rm, b.Instrs[ii])
		}
	}

	// Safety net: emit an epilogue if the IR didn't end with OP_RETURN.
	emitEpilogueAndRet(a, frameSize)
}

// emitSpillParam stores one incoming parameter to its frame slot so later uses
// (which reload via getOperand) see it.  dispatchIdx is the param's position in
// paramTypes, which — for an sret-returning function — carries a synthesised
// leading sret-pointer slot, so a user param's dispatchIdx is one past its
// positional index.  A scalar param spills its register (or reloads its incoming
// stack slot); an aggregate param (raw / managed slice) is reconstructed into
// its data region and a pointer to that region is written to the spill slot.  A
// emitFrameLoadSized loads a sub-word stack arg from [SP + off] into rd, sized AND
// sign-/zero-extended to the arg's packed footprint.  Defensive / inert today: AAPCS32
// uses 4-byte word stack-arg slots and never packs sub-word args (NaturalSizeStackArgs is
// Darwin-aarch64 only), so StackArgNaturalSize returns 0 here and this is the plain word
// emitFrameLoad — mirroring the aarch64 fix (sign-extend a signed narrow arg via
// LDRSB/LDRSH, zero-extend a bool/unsigned via LDRB/LDRH) so a future packed convention
// wouldn't read a contaminated or mis-signed word.  Addresses via IP (LDR[S]H's 8-bit
// immediate can't reach a large frame offset).
func emitFrameLoadSized(a @asm.Assembler, rd int, off int, cc common.CallConv, t @types.Type) {
	var natSize int = cc.StackArgNaturalSize(t, false)
	if natSize != 1 && natSize != 2 {
		emitFrameLoad(a, rd, off)
		return
	}
	var signed bool
	_, signed = common.SubWordNarrow(t, 64)
	emitConstInt32(a, arm32.IP, off)
	if natSize == 1 {
		if signed {
			arm32.Ldrsb(a, arm32.COND_AL, rd, arm32.MemReg(arm32.SP, arm32.IP))
		} else {
			arm32.Ldrb(a, arm32.COND_AL, rd, arm32.MemReg(arm32.SP, arm32.IP))
		}
	} else {
		if signed {
			arm32.Ldrsh(a, arm32.COND_AL, rd, arm32.MemReg(arm32.SP, arm32.IP))
		} else {
			arm32.Ldrh(a, arm32.COND_AL, rd, arm32.MemReg(arm32.SP, arm32.IP))
		}
	}
}

// normalizeNarrowRegParamArm32 sign-/zero-extends an incoming narrow GP register param
// (int8/int16 — int32 is word-sized on AAPCS32) to its type width before spill.  Applied
// ONLY to #[c_export] functions: a non-native (C) caller may leave a narrow reg arg's high
// bits UNSPECIFIED, and a native callee spills the whole 4-byte register, so a promoted
// -O1+ use would read garbage.  Idempotent for a native caller; no-op for word params.
func normalizeNarrowRegParamArm32(a @asm.Assembler, reg int, t @types.Type) {
	var sz int = t.SizeOf()
	if sz != 1 && sz != 2 {
		return
	}
	var signed bool
	_, signed = common.SubWordNarrow(t, 64)
	if sz == 1 {
		if signed {
			arm32.Sxtb(a, arm32.COND_AL, reg, reg)
		} else {
			arm32.Uxtb(a, arm32.COND_AL, reg, reg)
		}
	} else {
		if signed {
			arm32.Sxth(a, arm32.COND_AL, reg, reg)
		} else {
			arm32.Uxth(a, arm32.COND_AL, reg, reg)
		}
	}
}

// float32 param rides the scalar single-word path like an int32; a float64 param
// arrives as a register pair like an int64 (soft-float — no FP register file).
func emitSpillParam(a @asm.Assembler, rm @common.RegMap, p @ir.Param, paramTypes @[]@types.Type,
		dispatchIdx int, stackArgsBase int, cExport bool) {
	var regStart int = rm.CC.CallArgRegStart(paramTypes, dispatchIdx)
	var stackOff int = rm.CC.CallArgStackOff(paramTypes, dispatchIdx)
	// Hard-float (AAPCS-VFP): a float scalar param arrives in a VFP register (S/D,
	// allocated by CallArgFpReg's CPRC back-fill), so VSTR it directly to its frame
	// slot — PEELED off the GP paths BEFORE isPair64Typ (a float64 that stayed there
	// would emitSpillParam64 from the unwritten incoming r-pair).  Returns false for
	// an FP-file OVERFLOW param, whose bits arrived on the incoming stack and are
	// handled by the GP paths below exactly as a GP stack param.  Inert unless
	// types.Arm32HardFloat().
	if types.Arm32HardFloat() && common.IsFloatScalarTyp(p.Typ) {
		if emitSpillParamFloatHard(a, rm, p, paramTypes, dispatchIdx) {
			return
		}
	}
	// A 64-bit-pair scalar param (int64 / uint64 / float64) arrives as an
	// even-aligned register pair (argReg(regStart):argReg(regStart+1)) or an
	// 8-byte incoming stack slot; spill both words to its frame slot so later uses
	// reload the pair.
	if isPair64Typ(p.Typ) {
		emitSpillParam64(a, rm, p, regStart, stackOff, stackArgsBase)
		return
	}
	if common.IsAggregateTyp(p.Typ) {
		emitSpillAggregateParam(a, rm, p, regStart, stackOff, stackArgsBase)
		return
	}
	var off int = rm.LookupSpill(p.ID)
	if off < 0 { return }
	if regStart >= 0 {
		if cExport {
			normalizeNarrowRegParamArm32(a, argReg(regStart), p.Typ)
		}
		emitFrameStore(a, argReg(regStart), off)
	} else if stackOff >= 0 {
		var tmp int = scratchReg(rm)
		emitFrameLoadSized(a, tmp, stackArgsBase + stackOff, rm.CC, p.Typ)
		emitFrameStore(a, tmp, off)
		rm.ResetRegs()
	}
}

// emitSpillParam64 spills an incoming 64-bit (int64 / uint64) parameter to its
// frame slot.  A register-pair param copies argReg(regStart) → [slot+0] and
// argReg(regStart+1) → [slot+4]; a stack param (past r0-r3) copies the two words
// from the caller's outgoing-args area.  Later uses reload the pair via load64.
func emitSpillParam64(a @asm.Assembler, rm @common.RegMap, p @ir.Param, regStart int, stackOff int,
		stackArgsBase int) {
	var off int = rm.LookupSpill(p.ID)
	if off < 0 { return }
	if regStart >= 0 {
		emitFrameStore(a, argReg(regStart), off)
		emitFrameStore(a, argReg(regStart + 1), off + 4)
		return
	}
	if stackOff >= 0 {
		var tmp int = scratchReg(rm)
		emitFrameLoad(a, tmp, stackArgsBase + stackOff)
		emitFrameStore(a, tmp, off)
		emitFrameLoad(a, tmp, stackArgsBase + stackOff + 4)
		emitFrameStore(a, tmp, off + 4)
		rm.ResetRegs()
	}
}

// emitSpillAggregateParam reconstructs an incoming aggregate parameter into its
// data region and writes a pointer to that region into its spill slot, so
// downstream uses see a uniform pointer.  In-reg words come from argReg(regStart
// + w); overflow words are copied from the caller's outgoing-args area.  An
// indirect-large aggregate (> AggregateInRegMax) arrives as a single pointer,
// whose pointee is memcpy'd into the local region (AAPCS byval gives the callee
// its own copy).  Mirrors aarch64_emit_func.bn's aggregate param arm with word=4
// and R12 (IP) as the marshaling temp.
func emitSpillAggregateParam(a @asm.Assembler, rm @common.RegMap, p @ir.Param, regStart int,
		stackOff int, stackArgsBase int) {
	var dataOff int = rm.LookupAlloc(p.ID)
	var allocSz int = rm.LookupAllocSize(p.ID)
	if dataOff < 0 || allocSz <= 0 { return }
	var w int = wordBytes()
	var nWords int = rm.CC.ArgWords(p.Typ)
	if rm.CC.IndirectLargeAggregates && p.Typ.SizeOf() > rm.CC.AggregateInRegMax {
		// memcpy the byval pointee → sp+dataOff.  The byval pointer lands in a
		// POOL register (not IP) so IP stays free as the address-materialization
		// scratch for both the source load (w*wi reaches the aggregate SizeOf —
		// 8000 bytes for a `[2000]int` param) and the SP-relative store (dataOff
		// can itself exceed 4095 in a large frame).  emitBaseLoad / emitFrameStore
		// use IP one access at a time; srcReg / tmp are pool registers, never IP.
		var srcReg int = scratchReg(rm)
		if regStart >= 0 {
			if argReg(regStart) != srcReg {
				arm32.Mov(a, arm32.COND_AL, false, srcReg, arm32.Reg(argReg(regStart)))
			}
		} else if stackOff >= 0 {
			emitFrameLoad(a, srcReg, stackArgsBase + stackOff)
		}
		var tmp int = scratchReg(rm)
		var dstPtr int = scratchReg(rm)
		emitFrameAddr(a, dstPtr, dataOff)
		// Byte-wise for a sub-word-aligned byval pointee (its address, the caller's
		// copy, may be non-word-aligned → a word LDR faults on strict-align MMU-less
		// arm32); word-wise otherwise.  IP materializes a > 4KB offset (srcReg /
		// dstPtr / tmp are pool registers, never IP).
		emitAggMemcpyArm32(a, dstPtr, srcReg, p.Typ.SizeOf(), aggNeedsBytewiseArm32(p.Typ), tmp, arm32.IP)
		writeAggParamSpillPtr(a, rm, p, dataOff)
		rm.ResetRegs()
		return
	}
	// ≤ AggregateInRegMax: store in-reg words to the region, then copy any
	// overflow words from the caller's outgoing-args area.
	// Every SP-relative access here goes through emitFrame{Load,Store}: even a
	// small (≤16-byte) aggregate's data region / incoming-stack-slot offset can
	// exceed the 12-bit immediate when the FRAME is large (dataOff and
	// stackArgsBase = frameSize + SAVED_BYTES both scale with frame size), so a
	// bare MemImm(SP, ...) would trip imm12Offset's range error.
	var regWords int = 0
	if regStart >= 0 {
		regWords = nWords
		if stackOff >= 0 { regWords = rm.CC.NumGpArgRegs - regStart }
		for wi := 0; wi < regWords; wi++ {
			emitFrameStore(a, argReg(regStart + wi), dataOff + w * wi)
		}
	}
	if stackOff >= 0 {
		var tmp int = scratchReg(rm)
		for wi := regWords; wi < nWords; wi++ {
			emitFrameLoad(a, tmp, stackArgsBase + stackOff + w * (wi - regWords))
			emitFrameStore(a, tmp, dataOff + w * wi)
		}
	}
	writeAggParamSpillPtr(a, rm, p, dataOff)
	rm.ResetRegs()
}

// writeAggParamSpillPtr stores a pointer to an aggregate param's data region
// (sp + dataOff) into its spill slot, so downstream getOperand reloads a uniform
// pointer for the value.
func writeAggParamSpillPtr(a @asm.Assembler, rm @common.RegMap, p @ir.Param, dataOff int) {
	var spillOff int = rm.LookupSpill(p.ID)
	if spillOff < 0 { return }
	var tmp int = scratchReg(rm)
	emitFrameAddr(a, tmp, dataOff)
	emitFrameStore(a, tmp, spillOff)
}
