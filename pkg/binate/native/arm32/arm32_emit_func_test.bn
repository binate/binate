package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// emitFunc is exercised end-to-end by arm32_test.bn's EmitObject round-trips
// and by every conformance test running through
// builder-comp_native_arm32_baremetal.  This pins the prologue invariant
// directly so a regression stays observable at the unit-test level.

// A trivial zero-arg, zero-instruction function emits its frame-pointer prologue
// — push {fp,lr} (0xE92D4800), mov fp,sp (0xE1A0B00D), push {r4-r10,r12}
// (0xE92D17F0) — as its first three instructions, plus a safety-net epilogue.
// The two pushes save an EVEN 10 registers (r4-r12 + fp + lr = 40 bytes)
// precisely so SAVED_BYTES % 8 == 0 — the AAPCS32 8-byte stack-alignment
// invariant that an odd register count would violate.
func TestEmitFuncPrologue() testing.TestResult {
	// Pin the 8-alignment invariant the even push exists to preserve.
	if SAVED_BYTES % 8 != 0 {
		return fail("SAVED_BYTES must be a multiple of 8 (AAPCS32 SP alignment)")
	}
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)

	var f @ir.Func = make(ir.Func)
	f.Name = "test.f"
	var noP @[]@ir.Param
	f.Params = noP
	var noR @[]@types.Type
	f.Results = noR
	var entry @ir.Block = make(ir.Block)
	entry.Label = "entry.0"
	var noI @[]@ir.Instr
	entry.Instrs = noI
	f.Blocks = appendBlockPtr_arm32test(f.Blocks, entry)

	var strings @[]ir.StringConst

	emitFunc(a, "test", f, strings)

	if a.Sections[0].Len < 8 {
		return fail("emitFunc should emit prologue + safety-net epilogue")
	}
	// The frame-pointer prologue is three instructions: push {fp,lr} (the frame
	// record), mov fp,sp (point fp at it), push {r4-r10,r12} (rest of the
	// callee-saved set).  This keeps native arm32 frames walkable for stacktraces.
	if word32(a, 0) != cast(uint32, 0xE92D4800) {
		return fail("prologue[0] must be push {fp, lr} = 0xE92D4800")
	}
	if word32(a, 4) != cast(uint32, 0xE1A0B00D) {
		return fail("prologue[1] must be mov fp, sp = 0xE1A0B00D")
	}
	if word32(a, 8) != cast(uint32, 0xE92D17F0) {
		return fail("prologue[2] must be push {r4-r10, r12} = 0xE92D17F0")
	}
	return ""
}

// #[c_export] mints a second, unmangled symbol at the function's entry — the
// SAME section + offset as the mangled symbol — as a strong global.  The lookup
// uses the same symPrefixed() the emitter uses (ELF-bare on arm32).
func TestEmitFuncCExportAlias() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)

	var f @ir.Func = make(ir.Func)
	f.Name = "test.Add"
	var noP @[]@ir.Param
	f.Params = noP
	var noR @[]@types.Type
	f.Results = noR
	var entry @ir.Block = make(ir.Block)
	entry.Label = "entry.0"
	var noI @[]@ir.Instr
	entry.Instrs = noI
	f.Blocks = appendBlockPtr_arm32test(f.Blocks, entry)
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr("add_ints"))
	f.CExportNames = names

	var strings @[]ir.StringConst
	emitFunc(a, "test", f, strings)

	var mangledIdx int = a.LookupSymbol(symFor("test", "test.Add"))
	if mangledIdx < 0 {
		return fail("mangled function symbol missing")
	}
	var aliasIdx int = a.LookupSymbol(symPrefixed("add_ints"))
	if aliasIdx < 0 {
		return fail("c_export alias symbol `add_ints` missing")
	}
	if a.Symbols[aliasIdx].Offset != a.Symbols[mangledIdx].Offset {
		return fail("c_export alias must sit at the function's entry offset")
	}
	if a.Symbols[aliasIdx].Section != a.Symbols[mangledIdx].Section {
		return fail("c_export alias must be in the function's section")
	}
	if a.Symbols[aliasIdx].Binding != asm.BIND_GLOBAL {
		return fail("c_export alias must be a strong global")
	}
	return ""
}

// A #[c_export] function with a NARROW reg param (int8/int16 — int32 is word-sized on
// AAPCS32 and needs no extend) gets a non-empty C-entry thunk: the alias sits BEFORE the
// mangled symbol, and the thunk is the argument-register normalization plus a branch to the
// mangled entry.  A C caller enters at the alias, sign-/zero-extends the dirty high bits
// AAPCS32 leaves unspecified, and branches into the body; a native caller enters at the
// mangled symbol and skips it.  Pins the thunk PLACEMENT (alias offset < mangled offset) and
// CONTENT (SXTB of the single signed int8 arg register R0, then the branch).  The branch is
// emitted as its FIX_BRANCH24 placeholder (0xEA000000) pre-Finalize, which the `want`
// comparison matches (neither assembler is resolved).
func TestEmitFuncCExportNarrowParamPrefix() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)

	var f @ir.Func = make(ir.Func)
	f.Name = "test.Sgn"
	var p @ir.Param = make(ir.Param)
	p.ID = 1
	p.Typ = types.TypInt8()
	f.Params = slices.Append[@ir.Param](f.Params, p)
	var noR @[]@types.Type
	f.Results = noR
	var entry @ir.Block = make(ir.Block)
	entry.Label = "entry.0"
	var noI @[]@ir.Instr
	entry.Instrs = noI
	f.Blocks = appendBlockPtr_arm32test(f.Blocks, entry)
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr("ffi_sgn"))
	f.CExportNames = names

	var strings @[]ir.StringConst
	emitFunc(a, "test", f, strings)

	var mangledIdx int = a.LookupSymbol(symFor("test", "test.Sgn"))
	var aliasIdx int = a.LookupSymbol(symPrefixed("ffi_sgn"))
	if mangledIdx < 0 || aliasIdx < 0 {
		return fail("c_export narrow-param: alias or mangled symbol missing")
	}
	var aliasOff int = cast(int, a.Symbols[aliasIdx].Offset)
	var mangledOff int = cast(int, a.Symbols[mangledIdx].Offset)
	if aliasOff >= mangledOff {
		return fail("narrow-param c_export alias must precede the mangled entry (non-empty prefix)")
	}
	// The thunk is SXTB r0, r0 (the sole signed int8 arg register) then a branch to the
	// mangled entry (emitted as its FIX_BRANCH24 placeholder pre-Finalize, matching here).
	var want @asm.Assembler = asm.New(4)
	want.SetSection("text", -1)
	arm32.Sxtb(want, arm32.COND_AL, argReg(0), argReg(0))
	arm32.B(want, arm32.COND_AL, symFor("test", "test.Sgn"))
	if mangledOff - aliasOff != want.Sections[0].Len {
		return fail("c_export thunk length must equal SXTB + branch")
	}
	var gd @[]uint8 = a.Sections[0].Data
	var wd @[]uint8 = want.Sections[0].Data
	for i := 0; i < want.Sections[0].Len; i++ {
		if gd[aliasOff + i] != wd[i] {
			return fail("c_export thunk bytes must be the int8 SXTB + branch")
		}
	}
	return ""
}

// appendParam_arm32functest grows a @[]@ir.Param by one.
func appendParam_arm32functest(s @[]@ir.Param, v @ir.Param) @[]@ir.Param {
	var n @[]@ir.Param = make_slice(@ir.Param, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}

// AAPCS32 sret param shift: a function returning a slice (>4 bytes → sret) and
// taking one int32 param receives the hidden buffer pointer in R0 and its param
// in R1 (shifted).  emitFunc must, right after the prologue, STR R0 into the
// SretSlotOff stash (so emitReturn can reload the buffer pointer); and the param
// spill must read R1 (the shifted register), NOT R0.  Pin both the R0 stash and
// the R1-shift so the sret param handling stays observable at the unit level.
// setArm32Target pins the ILP32 layout so the synthesised sret-pointer slot is a
// single GP word (4 bytes) — under the LP64 host default it would be 8 bytes = 2
// words and shift the param to R2 instead of R1.
func TestEmitFuncSretStashesR0AndShiftsParam() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var f @ir.Func = make(ir.Func)
	f.Name = "main.g"
	var p @ir.Param = make(ir.Param)
	p.ID = 0
	p.Typ = types.TypInt32()
	f.Params = appendParam_arm32functest(f.Params, p)
	// A slice result is 8 bytes on ILP32 (> InternalSretBytes 4), so sret.
	var res @[]@types.Type = make_slice(@types.Type, 1)
	res[0] = types.MakeSliceType(types.TypInt32())
	f.Results = res
	var entry @ir.Block = make(ir.Block)
	entry.Label = "entry.0"
	var noI @[]@ir.Instr
	entry.Instrs = noI
	f.Blocks = appendBlockPtr_arm32test(f.Blocks, entry)
	var strings @[]ir.StringConst
	// Determine the sret slot + param spill offsets PlanFrame will assign, so the
	// assertions below can locate the STRs by offset.
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.PlanFrame(f)
	if rm.SretSlotOff < 0 {
		return fail("a slice-returning function must be sret (SretSlotOff >= 0)")
	}
	var paramOff int = rm.LookupSpill(0)
	if paramOff < 0 {
		return fail("the int32 param must have a spill slot")
	}
	emitFunc(a, "main", f, strings)
	if a.HasError {
		return fail("sret function with a param must lower, not error")
	}
	// Prologue is push{fp,lr}(@0) + mov fp,sp(@4) + push{r4-r10,r12}(@8) + sub
	// sp(@12).  The R0 stash is next (@16): STR r0, [sp, #SretSlotOff].
	// STR: bits[27:26]=01, L(bit20)=0; Rt = R0.
	if rdAt(a, 16) != cast(uint32, arm32.R0) || rnAt(a, 16) != cast(uint32, arm32.SP) ||
			imm12At(a, 16) != cast(uint32, rm.SretSlotOff) {
		return fail("sret prologue must STR R0 into the SretSlotOff stash")
	}
	// Param spill follows (@20): STR r1, [sp, #paramOff] — the param shifted to
	// R1 because R0 holds the sret buffer pointer.
	if rdAt(a, 20) != cast(uint32, arm32.R1) || rnAt(a, 20) != cast(uint32, arm32.SP) ||
			imm12At(a, 20) != cast(uint32, paramOff) {
		return fail("sret function's param 0 must spill from the shifted R1")
	}
	return ""
}

// emitSpillParam64 of a REGISTER-PAIR incoming int64 param (regStart 0 = r0:r1)
// stores BOTH words to its 8-byte frame slot: lo (r0) → [slot+0], hi (r1) →
// [slot+4].  With a small slot offset each store is a single STR [SP, #off].
func TestEmitSpillParam64RegisterPairStoresBothWords() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 0)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var p @ir.Param = make(ir.Param)
	p.ID = 0
	p.Typ = types.TypInt64()
	// A single int64 param starts at r0 (regStart 0), even-aligned, no stack.
	emitSpillParam64(a, rm, p, 0, -1, 40)
	if a.HasError {
		return fail("register-pair int64 param spill must lower, not error")
	}
	// STR r0, [sp, #0] then STR r1, [sp, #4].  STR: bits[27:26]=01, L(bit20)=0.
	if rdAt(a, 0) != cast(uint32, arm32.R0) || rnAt(a, 0) != cast(uint32, arm32.SP) ||
			imm12At(a, 0) != cast(uint32, 0) {
		return fail("int64 param lo word (r0) must store to [sp, #slot+0]")
	}
	if rdAt(a, 4) != cast(uint32, arm32.R1) || rnAt(a, 4) != cast(uint32, arm32.SP) ||
			imm12At(a, 4) != cast(uint32, 4) {
		return fail("int64 param hi word (r1) must store to [sp, #slot+4]")
	}
	return ""
}

// emitSpillParam64 of a STACK-passed int64 param (regStart -1, past r0-r3)
// copies the two words from the caller's outgoing-args area (at
// stackArgsBase + stackOff / +4) into the frame slot, via a scratch temp:
// LDR tmp,[sp,#base+off]; STR tmp,[sp,#slot+0]; LDR tmp,[sp,#base+off+4];
// STR tmp,[sp,#slot+4].  The stackOff is what the AAPCS32 CallConv assigns an
// int64 that follows four int32 args (which fill r0-r3), confirming faithfulness.
func TestEmitSpillParam64StackPassedCopiesBothWords() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	// An int64 after four int32s (which consume r0-r3) is stack-passed at
	// stackOff 0; assert the CallConv agrees before driving emitSpillParam64.
	// TypInt32 (not TypInt): a host unit test locks `int` to the host's 64-bit
	// width (types.SetTarget), so four TypInt fillers would be int64 pairs and
	// overflow the reg file differently — TypInt32 models genuine 32-bit args.
	var pt @[]@types.Type = make_slice(@types.Type, 5)
	pt[0] = types.TypInt32()
	pt[1] = types.TypInt32()
	pt[2] = types.TypInt32()
	pt[3] = types.TypInt32()
	pt[4] = types.TypInt64()
	if rm.CC.CallArgRegStart(pt, 4) != -1 {
		return fail("int64 after four int32s must be stack-passed (regStart -1)")
	}
	var stackOff int = rm.CC.CallArgStackOff(pt, 4)
	if stackOff < 0 {
		return fail("stack-passed int64 must have a stack offset")
	}
	var p @ir.Param = make(ir.Param)
	p.ID = 5
	p.Typ = types.TypInt64()
	var stackArgsBase int = 40
	emitSpillParam64(a, rm, p, -1, stackOff, stackArgsBase)
	if a.HasError {
		return fail("stack-passed int64 param spill must lower, not error")
	}
	// LDR tmp, [sp, #base+off] — bit20 (L) = 1; base is SP.
	if rnAt(a, 0) != cast(uint32, arm32.SP) ||
			imm12At(a, 0) != cast(uint32, stackArgsBase + stackOff) {
		return fail("lo word must LOAD from [sp, #base+stackOff]")
	}
	// STR tmp, [sp, #slot+0] — the frame slot is at offset 8.
	if rnAt(a, 4) != cast(uint32, arm32.SP) || imm12At(a, 4) != cast(uint32, 8) {
		return fail("lo word must STORE to [sp, #slot+0]")
	}
	// LDR tmp, [sp, #base+off+4].
	if imm12At(a, 8) != cast(uint32, stackArgsBase + stackOff + 4) {
		return fail("hi word must LOAD from [sp, #base+stackOff+4]")
	}
	// STR tmp, [sp, #slot+4].
	if imm12At(a, 12) != cast(uint32, 12) {
		return fail("hi word must STORE to [sp, #slot+4]")
	}
	return ""
}

// emitSpillParam of a float64 incoming parameter spills its r0:r1 pair to the
// frame slot exactly like an int64 (soft-float: floats ride GP), NOT a fail-loud.
func TestEmitSpillParamFloat64Spills() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 0)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	var p @ir.Param = make(ir.Param)
	p.ID = 0
	p.Typ = types.TypFloat64()
	var paramTypes @[]@types.Type = make_slice(@types.Type, 1)
	paramTypes[0] = p.Typ
	emitSpillParam(a, rm, p, paramTypes, 0, 40)
	if a.HasError {
		return fail("a float64 param spill must lower via the soft-float pair, not error")
	}
	// STR r0 -> [sp, #slot+0] (@0) and STR r1 -> [sp, #slot+4] (@4); slot is 8.
	if rnAt(a, 0) != cast(uint32, arm32.SP) || imm12At(a, 0) != cast(uint32, 8) {
		return fail("float64 param lo word must STORE to [sp, #slot+0]")
	}
	if imm12At(a, 4) != cast(uint32, 12) {
		return fail("float64 param hi word must STORE to [sp, #slot+4]")
	}
	return ""
}

func appendBlockPtr_arm32test(s @[]@ir.Block, v @ir.Block) @[]@ir.Block {
	var n @[]@ir.Block = make_slice(@ir.Block, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}
