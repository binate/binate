package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// emitFunc is exercised end-to-end by arm32_test.bn's EmitObject round-trips
// and by every conformance test running through
// builder-comp_native_arm32_baremetal.  This pins the prologue invariant
// directly so a regression stays observable at the unit-test level.

// A trivial zero-arg, zero-instruction function emits, at minimum, its
// `push {r4-r12, lr}` prologue (0xE92D5FF0) as the first instruction and a
// non-empty text section (prologue + safety-net epilogue).  The push saves an
// EVEN 10 registers (r4-r12 + lr = 40 bytes) precisely so SAVED_BYTES % 8 == 0
// — the AAPCS32 8-byte stack-alignment invariant that a 9-register push would
// violate (36 bytes ≡ 4 mod 8, leaving SP 4-misaligned at every call).
func TestEmitFuncPrologue() testing.TestResult {
	// Pin the 8-alignment invariant the even push exists to preserve.
	if SAVED_BYTES % 8 != 0 {
		return fail("SAVED_BYTES must be a multiple of 8 (AAPCS32 SP alignment)")
	}
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)

	var f @ir.Func = make(ir.Func)
	f.Name = "test.f"
	var noP @[]@ir.Param
	f.Params = noP
	var noR @[]@types.Type
	f.Results = noR
	var entry @ir.Block = make(ir.Block)
	entry.Label = "entry.0"
	var noI @[]@ir.Instr
	entry.Instrs = noI
	f.Blocks = appendBlockPtr_arm32test(f.Blocks, entry)

	var strings @[]ir.StringConst
	var emptyFuncs @[]@ir.Func
	var allFuncs @[]@ir.Func = appendFuncPtr_arm32test(emptyFuncs, f)

	emitFunc(a, "test", f, strings, allFuncs)

	if a.Sections[0].Len < 8 {
		return fail("emitFunc should emit prologue + safety-net epilogue")
	}
	var d *[]uint8 = a.Sections[0].Data
	var w0 uint32 = cast(uint32, d[0]) | (cast(uint32, d[1]) << 8) |
		(cast(uint32, d[2]) << 16) | (cast(uint32, d[3]) << 24)
	if w0 != cast(uint32, 0xE92D5FF0) {
		return fail("prologue must be push {r4-r12, lr} = 0xE92D5FF0")
	}
	return ""
}

// emitSpillParam of an AGGREGATE incoming parameter is now lowered: a 16-byte
// managed-slice param (4 words, all in R0..R3 under AAPCS32) is reconstructed
// into its data region and a pointer written to its spill slot.  It must NOT set
// an error, and must emit code (the 4 register STRs into the region + the
// data-pointer store).  A frame is planned so the param's alloc/spill offsets
// exist.  (Float params still fail loud — see TestEmitSpillParamFloatSetsError.)
func TestEmitSpillParamAggregateLowered() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var f @ir.Func = make(ir.Func)
	f.Name = "main.h"
	var p @ir.Param = make(ir.Param)
	p.ID = 0
	p.Typ = types.MakeManagedSliceType(types.TypInt())
	f.Params = appendParam_arm32functest(f.Params, p)
	rm.PlanFrame(f)
	var paramTypes @[]@types.Type = make_slice(@types.Type, 1)
	paramTypes[0] = p.Typ
	emitSpillParam(a, rm, p, paramTypes, 0, 40)
	if a.HasError {
		return fail("aggregate parameter spill must be lowered, not error")
	}
	if a.Sections[0].Len == 0 {
		return fail("aggregate parameter spill must emit marshaling code")
	}
	return ""
}

// appendParam_arm32functest grows a @[]@ir.Param by one.
func appendParam_arm32functest(s @[]@ir.Param, v @ir.Param) @[]@ir.Param {
	var n @[]@ir.Param = make_slice(@ir.Param, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}

// emitSpillParam of a FLOAT incoming parameter likewise fails LOUDLY.
func TestEmitSpillParamFloatSetsError() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var p @ir.Param = make(ir.Param)
	p.ID = 0
	p.Typ = types.TypFloat64()
	var paramTypes @[]@types.Type = make_slice(@types.Type, 1)
	paramTypes[0] = p.Typ
	emitSpillParam(a, rm, p, paramTypes, 0, 40)
	if !a.HasError {
		return fail("float parameter spill must set a compile error")
	}
	return ""
}

func appendBlockPtr_arm32test(s @[]@ir.Block, v @ir.Block) @[]@ir.Block {
	var n @[]@ir.Block = make_slice(@ir.Block, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}

func appendFuncPtr_arm32test(s @[]@ir.Func, v @ir.Func) @[]@ir.Func {
	var n @[]@ir.Func = make_slice(@ir.Func, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}
