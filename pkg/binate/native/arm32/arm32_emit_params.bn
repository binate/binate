package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Incoming-parameter landing for the AAPCS32 prologue: load each register /
// stack parameter into its frame slot (with narrow-scalar re-extension and the
// #[c_export] C-entry register normalization), and the sized sub-word stack-arg
// load helper it uses.  Split from arm32_emit_func.bn along the natural
// parameter-handling boundary (mirrors aarch64_emit_params.bn).

// emitFrameLoadSized loads a sub-word stack arg from [SP + off] into rd, sized AND
// sign-/zero-extended to the arg's packed footprint.  AAPCS32 uses 4-byte word stack-arg
// slots and never packs sub-word args (NaturalSizeStackArgs is Darwin-aarch64 only), so
// StackArgNaturalSize returns 0 and this is the plain word emitFrameLoad for most functions
// — int32 is already the full 4-byte word, so only int8 / int16 could be sub-word.
//
// An int8 / int16 arg is loaded at its natural size and sign-/zero-extended (LDRSB/LDRSH
// signed, LDRB/LDRH bool/unsigned) rather than as a full word — UNCONDITIONALLY.  This
// normalizes the entry against a C caller (a #[c_export] entry, or a function reached through
// a `__c_entry` callback pointer) that stores only the arg's low 1 / 2 bytes into the 4-byte
// slot and leaves the rest junk — else that junk lands in the 32-bit canonical home and
// corrupts a promoted use.  A native caller stores the full extended word (arm32_call.bn's
// 4-byte stack-arg store), so the narrow-size load reproduces the same value — idempotent.
// Doing it here at the mangled entry (which every caller reaches) also covers a non-#[c_export]
// `__c_entry` target whose callback thunk normalizes only the argument registers.  Floats /
// aggregates never reach here as sub-word.  Addresses via IP (LDR[S]H's 8-bit immediate can't
// reach a large frame offset).
func emitFrameLoadSized(a @asm.Assembler, rd int, off int, cc common.CallConv, t @types.Type) {
	var natSize int = cc.StackArgNaturalSize(t, false)
	if natSize == 0 && !common.IsAggregateTyp(t) && !common.IsFloatScalarTyp(t) {
		var sz int = t.SizeOf()
		if sz > 0 && sz < 4 {
			natSize = sz
		}
	}
	if natSize != 1 && natSize != 2 {
		emitFrameLoad(a, rd, off)
		return
	}
	var signed bool
	_, signed = common.SubWordNarrow(t, 32)
	emitConstInt32(a, arm32.IP, off)
	if natSize == 1 {
		if signed {
			arm32.Ldrsb(a, arm32.COND_AL, rd, arm32.MemReg(arm32.SP, arm32.IP))
		} else {
			arm32.Ldrb(a, arm32.COND_AL, rd, arm32.MemReg(arm32.SP, arm32.IP))
		}
	} else {
		if signed {
			arm32.Ldrsh(a, arm32.COND_AL, rd, arm32.MemReg(arm32.SP, arm32.IP))
		} else {
			arm32.Ldrh(a, arm32.COND_AL, rd, arm32.MemReg(arm32.SP, arm32.IP))
		}
	}
}

// normalizeNarrowRegParamArm32 sign-/zero-extends an incoming narrow GP register param
// (int8/int16 — int32 is word-sized on AAPCS32) to its type width before spill.  Applied
// ONLY to #[c_export] functions: a non-native (C) caller may leave a narrow reg arg's high
// bits UNSPECIFIED, and a native callee spills the whole 4-byte register, so a promoted
// -O1+ use would read garbage.  Idempotent for a native caller; no-op for word params.
func normalizeNarrowRegParamArm32(a @asm.Assembler, reg int, t @types.Type) {
	var sz int = t.SizeOf()
	if sz != 1 && sz != 2 {
		return
	}
	var signed bool
	_, signed = common.SubWordNarrow(t, 32)
	if sz == 1 {
		if signed {
			arm32.Sxtb(a, arm32.COND_AL, reg, reg)
		} else {
			arm32.Uxtb(a, arm32.COND_AL, reg, reg)
		}
	} else {
		if signed {
			arm32.Sxth(a, arm32.COND_AL, reg, reg)
		} else {
			arm32.Uxth(a, arm32.COND_AL, reg, reg)
		}
	}
}

// emitCExportRegNormArm32 emits the #[c_export] C-entry prefix: for each narrow GP scalar
// parameter passed in an argument register, sign-/zero-extend it in place.  The register set
// comes from common.CEntryRegNormWalk — the same classification the __c_entry thunk-emission
// decision uses (float scalars, 64-bit pairs, and aggregates are excluded as non-narrow-GP;
// AAPCS32 puts sret in R0, a GP arg reg, so CEntryRegNormWalk applies the R1.. shift when f
// sret-returns) — so the argReg mapping matches the mangled entry's spill.  Emitted BEFORE the
// mangled `sym` label so a C caller (entering at the alias) runs it and falls through, while a
// native caller (at `sym`) skips it.
func emitCExportRegNormArm32(a @asm.Assembler, rm @common.RegMap, f @ir.Func) {
	var regStarts @[]int
	var regTypes @[]@types.Type
	regStarts, regTypes = common.CEntryRegNormWalk(f, rm.CC)
	for i := 0; i < len(regStarts); i++ {
		normalizeNarrowRegParamArm32(a, argReg(regStarts[i]), regTypes[i])
	}
}

// float32 param rides the scalar single-word path like an int32; a float64 param
// arrives as a register pair like an int64 (soft-float — no FP register file).
func emitSpillParam(a @asm.Assembler, rm @common.RegMap, p @ir.Param, paramTypes @[]@types.Type,
		dispatchIdx int, stackArgsBase int) {
	var regStart int = rm.CC.CallArgRegStart(paramTypes, dispatchIdx)
	var stackOff int = rm.CC.CallArgStackOff(paramTypes, dispatchIdx)
	// Hard-float (AAPCS-VFP): a float scalar param arrives in a VFP register (S/D,
	// allocated by CallArgFpReg's CPRC back-fill), so VSTR it directly to its frame
	// slot — PEELED off the GP paths BEFORE isPair64Typ (a float64 that stayed there
	// would emitSpillParam64 from the unwritten incoming r-pair).  Returns false for
	// an FP-file OVERFLOW param, whose bits arrived on the incoming stack and are
	// handled by the GP paths below exactly as a GP stack param.  Inert unless
	// types.Arm32HardFloat().
	if types.Arm32HardFloat() && common.IsFloatScalarTyp(p.Typ) {
		if emitSpillParamFloatHard(a, rm, p, paramTypes, dispatchIdx, stackArgsBase, stackOff) {
			return
		}
	}
	// A 64-bit-pair scalar param (int64 / uint64 / float64) arrives as an
	// even-aligned register pair (argReg(regStart):argReg(regStart+1)) or an
	// 8-byte incoming stack slot; spill both words to its frame slot so later uses
	// reload the pair.
	if isPair64Typ(p.Typ) {
		emitSpillParam64(a, rm, p, regStart, stackOff, stackArgsBase)
		return
	}
	if common.IsAggregateTyp(p.Typ) {
		emitSpillAggregateParam(a, rm, p, regStart, stackOff, stackArgsBase)
		return
	}
	var off int = rm.LookupSpill(p.ID)
	if off < 0 { return }
	if regStart >= 0 {
		emitFrameStore(a, argReg(regStart), off)
	} else if stackOff >= 0 {
		var tmp int = scratchReg(rm)
		emitFrameLoadSized(a, tmp, stackArgsBase + stackOff, rm.CC, p.Typ)
		emitFrameStore(a, tmp, off)
		rm.ResetRegs()
	}
}

// emitSpillParam64 spills an incoming 64-bit (int64 / uint64) parameter to its
// frame slot.  A register-pair param copies argReg(regStart) → [slot+0] and
// argReg(regStart+1) → [slot+4]; a stack param (past r0-r3) copies the two words
// from the caller's outgoing-args area.  Later uses reload the pair via load64.
func emitSpillParam64(a @asm.Assembler, rm @common.RegMap, p @ir.Param, regStart int, stackOff int,
		stackArgsBase int) {
	var off int = rm.LookupSpill(p.ID)
	if off < 0 { return }
	if regStart >= 0 {
		emitFrameStore(a, argReg(regStart), off)
		emitFrameStore(a, argReg(regStart + 1), off + 4)
		return
	}
	if stackOff >= 0 {
		var tmp int = scratchReg(rm)
		emitFrameLoad(a, tmp, stackArgsBase + stackOff)
		emitFrameStore(a, tmp, off)
		emitFrameLoad(a, tmp, stackArgsBase + stackOff + 4)
		emitFrameStore(a, tmp, off + 4)
		rm.ResetRegs()
	}
}
