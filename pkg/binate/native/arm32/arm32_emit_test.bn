package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the memory / aggregate op handlers (arm32_emit.bn).
//
// Note: wordBytes() reads the GLOBAL target pointer size, which is 4 only during
// an actual `--target arm32-baremetal` compile — the unit-test harness runs on
// the host target, so these tests avoid asserting the exact 4-byte stride and
// instead check structural properties (single ADD, non-empty zero-init, no
// error) that hold regardless of the harness's word size.  The ILP32 stride is
// exercised end-to-end by the conformance suite (slice indexing / for-in).

// emitGetFieldPtr on a raw-slice base computes a flat wordBytes*Index offset
// (data at 0, len at 4 on ILP32).  Field 1 of a slice alloca resolves to
// SP + allocOff + 4.  Build a one-block function with an OP_ALLOC of a raw
// slice so PlanFrame assigns the alloca an offset, then take field 1.
func TestGetFieldPtrSliceLenOffsetIsFour() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var sliceTyp @types.Type = types.MakeSliceType(types.TypUint8())
	var f @ir.Func = make(ir.Func)
	f.Name = "main.f"
	var blk @ir.Block = make(ir.Block)
	blk.Label = "entry"
	var alloc @ir.Instr = make(ir.Instr)
	alloc.ID = 5
	alloc.Op = iropcode.OP_ALLOC
	alloc.TypeArg = sliceTyp
	alloc.Typ = types.MakePointerType(sliceTyp)
	blk.Instrs = appendInstr_arm32emittest(blk.Instrs, alloc)
	f.Blocks = appendBlock_arm32emittest(f.Blocks, blk)
	rm.PlanFrame(f)
	var allocOff int = rm.LookupAlloc(5)
	if allocOff < 0 {
		return fail("PlanFrame must reserve an alloca offset for the slice")
	}
	// GET_FIELD_PTR field 1 (len) of the slice alloca.
	var gfp @ir.Instr = make(ir.Instr)
	gfp.ID = 6
	gfp.Op = iropcode.OP_GET_FIELD_PTR
	gfp.Index = 1
	gfp.Typ = types.MakePointerType(types.TypInt())
	var base @ir.Instr = make(ir.Instr)
	base.ID = 5
	base.TypeArg = sliceTyp
	gfp.Args = appendInstr_arm32emittest(gfp.Args, base)
	emitGetFieldPtr(a, "main", rm, gfp)
	if a.HasError {
		return fail("get-field-ptr on a slice base must not error")
	}
	// The emitted ADD computes SP + (allocOff + 4).  For a rot-imm-encodable
	// offset it's a single ADD whose immediate decodes to allocOff + 4.
	if bytesWritten(a) != 4 {
		return fail("field-ptr for an encodable offset should be a single ADD")
	}
	return ""
}

// emitAlloc zero-inits an aggregate alloca's storage (a raw slice is 2 words),
// emitting the MOV #0 + word STRs.  A scalar alloca emits nothing (the STORE
// fills it).
func TestAllocAggregateZeroInits() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var sliceTyp @types.Type = types.MakeSliceType(types.TypUint8())
	var f @ir.Func = make(ir.Func)
	f.Name = "main.f"
	var blk @ir.Block = make(ir.Block)
	blk.Label = "entry"
	var alloc @ir.Instr = make(ir.Instr)
	alloc.ID = 5
	alloc.Op = iropcode.OP_ALLOC
	alloc.TypeArg = sliceTyp
	blk.Instrs = appendInstr_arm32emittest(blk.Instrs, alloc)
	f.Blocks = appendBlock_arm32emittest(f.Blocks, blk)
	rm.PlanFrame(f)
	emitAlloc(a, rm, alloc)
	if a.HasError {
		return fail("aggregate alloc zeroing must not error")
	}
	if bytesWritten(a) == 0 {
		return fail("an aggregate alloca must zero-init its storage")
	}
	return ""
}

// emitMake emits a BL to rt.Alloc(SizeOf(T)) and moves the returned managed
// pointer (R0) into the result register.
func TestMakeCallsRtAlloc() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Op = iropcode.OP_MAKE
	ins.TypeArg = types.MakeSliceType(types.TypUint8())
	ins.Typ = types.MakePointerType(ins.TypeArg)
	emitMake(a, rm, ins)
	if a.HasError {
		return fail("make must not error")
	}
	if a.LookupSymbol(symPrefixed(mangleRtFunc("Alloc"))) < 0 {
		return fail("make must emit a BL to rt.Alloc")
	}
	if rm.LookupReg(7) < 0 {
		return fail("make must assign the alloc result to a register")
	}
	return ""
}

// emitBox of an OP_ALLOC operand heap-copies the alloca's storage: it emits a BL
// to rt.Box with the source pointer materialized from the alloca offset (assigned
// by PlanFrame) and the result managed pointer moved into the result register.
func TestBoxAllocaCallsRtBox() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var elemTyp @types.Type = types.MakeSliceType(types.TypUint8())
	var f @ir.Func = make(ir.Func)
	f.Name = "main.f"
	var blk @ir.Block = make(ir.Block)
	blk.Label = "entry"
	var alloc @ir.Instr = make(ir.Instr)
	alloc.ID = 5
	alloc.Op = iropcode.OP_ALLOC
	alloc.TypeArg = elemTyp
	alloc.Typ = types.MakePointerType(elemTyp)
	blk.Instrs = appendInstr_arm32emittest(blk.Instrs, alloc)
	f.Blocks = appendBlock_arm32emittest(f.Blocks, blk)
	rm.PlanFrame(f)
	if rm.LookupAlloc(5) < 0 {
		return fail("PlanFrame must reserve an alloca offset for the box source")
	}
	var boxIns @ir.Instr = make(ir.Instr)
	boxIns.ID = 6
	boxIns.Op = iropcode.OP_BOX
	boxIns.Typ = types.MakePointerType(elemTyp)
	var val @ir.Instr = make(ir.Instr)
	val.ID = 5
	val.Op = iropcode.OP_ALLOC
	val.TypeArg = elemTyp
	boxIns.Args = appendInstr_arm32emittest(boxIns.Args, val)
	emitBox(a, rm, boxIns)
	if a.HasError {
		return fail("box of an alloca must not error")
	}
	if a.LookupSymbol(symPrefixed(mangleRtFunc("Box"))) < 0 {
		return fail("box must emit a BL to rt.Box")
	}
	if rm.LookupReg(6) < 0 {
		return fail("box must assign the result to a register")
	}
	return ""
}

// emitBox of an aggregate operand boxes the operand's data region: getOperand
// resolves the aggregate value (here an alloc data region) to a pointer, which is
// moved to R0 before the BL to rt.Box.
func TestBoxAggregateCallsRtBox() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var elemTyp @types.Type = types.MakeSliceType(types.TypUint8())
	// The aggregate value's data region: an alloc at offset 0.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 5)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	var boxIns @ir.Instr = make(ir.Instr)
	boxIns.ID = 6
	boxIns.Op = iropcode.OP_BOX
	boxIns.Typ = types.MakePointerType(elemTyp)
	// A non-OP_ALLOC aggregate operand → emitBox's aggregate branch.
	var val @ir.Instr = make(ir.Instr)
	val.ID = 5
	val.Op = iropcode.OP_MAKE_SLICE
	val.Typ = elemTyp
	boxIns.Args = appendInstr_arm32emittest(boxIns.Args, val)
	emitBox(a, rm, boxIns)
	if a.HasError {
		return fail("box of an aggregate operand must not error")
	}
	if a.LookupSymbol(symPrefixed(mangleRtFunc("Box"))) < 0 {
		return fail("box of an aggregate must emit a BL to rt.Box")
	}
	if rm.LookupReg(6) < 0 {
		return fail("box must assign the result to a register")
	}
	return ""
}

// emitBox of a scalar operand boxes directly from the value's spill slot address
// (its authoritative full-width home) — no re-store, so it is width-agnostic (an
// int32 and an int64 pair both box the whole slot).
func TestBoxScalarCallsRtBox() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// The scalar value's authoritative home: a spill slot at offset 0.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var boxIns @ir.Instr = make(ir.Instr)
	boxIns.ID = 6
	boxIns.Op = iropcode.OP_BOX
	boxIns.Typ = types.MakePointerType(types.TypInt32())
	var val @ir.Instr = make(ir.Instr)
	val.ID = 5
	val.Op = iropcode.OP_CONST_INT
	val.Typ = types.TypInt32()
	boxIns.Args = appendInstr_arm32emittest(boxIns.Args, val)
	emitBox(a, rm, boxIns)
	if a.HasError {
		return fail("box of a scalar operand must not error")
	}
	if a.LookupSymbol(symPrefixed(mangleRtFunc("Box"))) < 0 {
		return fail("box of a scalar must emit a BL to rt.Box")
	}
	if rm.LookupReg(6) < 0 {
		return fail("box must assign the result to a register")
	}
	return ""
}

// appendInstr_arm32emittest grows a @[]@ir.Instr by one.
func appendInstr_arm32emittest(s @[]@ir.Instr, v @ir.Instr) @[]@ir.Instr {
	var n @[]@ir.Instr = make_slice(@ir.Instr, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}

// appendBlock_arm32emittest grows a @[]@ir.Block by one.
func appendBlock_arm32emittest(s @[]@ir.Block, v @ir.Block) @[]@ir.Block {
	var n @[]@ir.Block = make_slice(@ir.Block, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}
