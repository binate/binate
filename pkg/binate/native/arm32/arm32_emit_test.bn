package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the memory / aggregate op handlers (arm32_emit.bn).
//
// Note: wordBytes() reads the GLOBAL target pointer size, which is 4 only during
// an actual `--target arm32-baremetal` compile — the unit-test harness runs on
// the host target, so these tests avoid asserting the exact 4-byte stride and
// instead check structural properties (single ADD, non-empty zero-init, no
// error) that hold regardless of the harness's word size.  The ILP32 stride is
// exercised end-to-end by the conformance suite (slice indexing / for-in).

// emitGetFieldPtr on a raw-slice base computes a flat wordBytes*Index offset
// (data at 0, len at 4 on ILP32).  Field 1 of a slice alloca resolves to
// SP + allocOff + 4.  Build a one-block function with an OP_ALLOC of a raw
// slice so PlanFrame assigns the alloca an offset, then take field 1.
func TestGetFieldPtrSliceLenOffsetIsFour() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	var sliceTyp @types.Type = types.MakeSliceType(types.TypUint8())
	var f @ir.Func = make(ir.Func)
	f.Name = "main.f"
	var blk @ir.Block = make(ir.Block)
	blk.Label = "entry"
	var alloc @ir.Instr = make(ir.Instr)
	alloc.ID = 5
	alloc.Op = iropcode.OP_ALLOC
	alloc.TypeArg = sliceTyp
	alloc.Typ = types.MakePointerType(sliceTyp)
	blk.Instrs = appendInstr_arm32emittest(blk.Instrs, alloc)
	f.Blocks = appendBlock_arm32emittest(f.Blocks, blk)
	rm.PlanFrame(f)
	var allocOff int = rm.LookupAlloc(5)
	if allocOff < 0 {
		return fail("PlanFrame must reserve an alloca offset for the slice")
	}
	// GET_FIELD_PTR field 1 (len) of the slice alloca.
	var gfp @ir.Instr = make(ir.Instr)
	gfp.ID = 6
	gfp.Op = iropcode.OP_GET_FIELD_PTR
	gfp.Index = 1
	gfp.Typ = types.MakePointerType(types.TypInt())
	var base @ir.Instr = make(ir.Instr)
	base.ID = 5
	base.TypeArg = sliceTyp
	gfp.Args = appendInstr_arm32emittest(gfp.Args, base)
	emitGetFieldPtr(a, "main", rm, gfp)
	if a.HasError {
		return fail("get-field-ptr on a slice base must not error")
	}
	// The emitted ADD computes SP + (allocOff + 4).  For a rot-imm-encodable
	// offset it's a single ADD whose immediate decodes to allocOff + 4.
	if bytesWritten(a) != 4 {
		return fail("field-ptr for an encodable offset should be a single ADD")
	}
	return ""
}

// emitAlloc zero-inits an aggregate alloca's storage (a raw slice is 2 words),
// emitting the MOV #0 + word STRs.  A scalar alloca emits nothing (the STORE
// fills it).
func TestAllocAggregateZeroInits() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	var sliceTyp @types.Type = types.MakeSliceType(types.TypUint8())
	var f @ir.Func = make(ir.Func)
	f.Name = "main.f"
	var blk @ir.Block = make(ir.Block)
	blk.Label = "entry"
	var alloc @ir.Instr = make(ir.Instr)
	alloc.ID = 5
	alloc.Op = iropcode.OP_ALLOC
	alloc.TypeArg = sliceTyp
	blk.Instrs = appendInstr_arm32emittest(blk.Instrs, alloc)
	f.Blocks = appendBlock_arm32emittest(f.Blocks, blk)
	rm.PlanFrame(f)
	emitAlloc(a, rm, alloc)
	if a.HasError {
		return fail("aggregate alloc zeroing must not error")
	}
	if bytesWritten(a) == 0 {
		return fail("an aggregate alloca must zero-init its storage")
	}
	return ""
}

// appendInstr_arm32emittest grows a @[]@ir.Instr by one.
func appendInstr_arm32emittest(s @[]@ir.Instr, v @ir.Instr) @[]@ir.Instr {
	var n @[]@ir.Instr = make_slice(@ir.Instr, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}

// appendBlock_arm32emittest grows a @[]@ir.Block by one.
func appendBlock_arm32emittest(s @[]@ir.Block, v @ir.Block) @[]@ir.Block {
	var n @[]@ir.Block = make_slice(@ir.Block, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}

// gepElemInstr builds an OP_GET_ELEM_PTR (ID 3) of base ID 1 and index ID 2
// whose element type is elem.
func gepElemInstr(elem @types.Type) @ir.Instr {
	var ptrTyp @types.Type = make(types.Type)
	ptrTyp.Kind = types.TYP_POINTER
	ptrTyp.Elem = elem
	var base @ir.Instr = make(ir.Instr)
	base.ID = 1
	var idx @ir.Instr = make(ir.Instr)
	idx.ID = 2
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_GET_ELEM_PTR
	ins.Typ = ptrTyp
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = base
	ins.Args[1] = idx
	return ins
}

// gepHomedRegMap homes the base (ID 1) in R1, the index (ID 2) in R2 and the
// GEP result (ID 3) in R0, so the emitted ADD's registers are known.
func gepHomedRegMap() @common.RegMap {
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	rm.HomeIDs = common.AppendInt(rm.HomeIDs, 1)
	rm.HomeRegs = common.AppendInt(rm.HomeRegs, arm32.R1)
	rm.HomeIDs = common.AppendInt(rm.HomeIDs, 2)
	rm.HomeRegs = common.AppendInt(rm.HomeRegs, arm32.R2)
	rm.HomeIDs = common.AppendInt(rm.HomeIDs, 3)
	rm.HomeRegs = common.AppendInt(rm.HomeRegs, arm32.R0)
	return rm
}

// A power-of-two element size scales through the ADD's shifted-register
// operand: one `add r0, r1, r2, lsl #4` for a 16-byte element, no MUL.
func TestEmitGetElemPtrPow2FoldsShiftIntoAdd() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var elem @types.Type = types.MakeArrayType(types.TypUint8(), 16)
	emitGetElemPtr(a, "main", gepHomedRegMap(), gepElemInstr(elem))
	if bytesWritten(a) != 4 { return fail("16-byte element GEP should be a single ADD") }
	if word32(a, 0) != cast(uint32, 0xE0810202) { return fail("expected add r0, r1, r2, lsl #4") }
	return ""
}

// A 1-byte element needs no scaling: a plain `add r0, r1, r2`.
func TestEmitGetElemPtrByteElemPlainAdd() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitGetElemPtr(a, "main", gepHomedRegMap(), gepElemInstr(types.TypUint8()))
	if bytesWritten(a) != 4 { return fail("1-byte element GEP should be a single ADD") }
	if word32(a, 0) != cast(uint32, 0xE0810002) { return fail("expected add r0, r1, r2") }
	return ""
}

// A non-power-of-two element size still multiplies by the materialized size.
func TestEmitGetElemPtrNonPow2UsesMul() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var elem @types.Type = types.MakeArrayType(types.TypUint8(), 12)
	emitGetElemPtr(a, "main", gepHomedRegMap(), gepElemInstr(elem))
	var muls int = 0
	for off := 0; off + 3 < bytesWritten(a); off = off + 4 {
		// MUL: bits 27..21 = 0 and bits 7..4 = 0b1001.
		var w uint32 = word32(a, off)
		if (w & cast(uint32, 0x0FE000F0)) == cast(uint32, 0x00000090) { muls = muls + 1 }
	}
	if muls != 1 { return fail("12-byte element GEP should emit one MUL") }
	return ""
}

// A frame (alloca) base is materialized into a scratch, not into rd: with the
// index and the result both in R0, writing the frame address into R0 first
// would destroy the index before the shifted ADD reads it.
func TestEmitGetElemPtrFrameBaseKeepsIndex() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 8)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 64)
	rm.HomeIDs = common.AppendInt(rm.HomeIDs, 2)
	rm.HomeRegs = common.AppendInt(rm.HomeRegs, arm32.R0)
	rm.HomeIDs = common.AppendInt(rm.HomeIDs, 3)
	rm.HomeRegs = common.AppendInt(rm.HomeRegs, arm32.R0)
	emitGetElemPtr(a, "main", rm, gepElemInstr(types.MakeArrayType(types.TypUint8(), 16)))
	if bytesWritten(a) != 8 {
		return fail("frame-base GEP should be the frame ADD plus the scaled ADD")
	}
	var frameAdd uint32 = word32(a, 0)
	var scaled uint32 = word32(a, 4)
	var fb uint32 = (frameAdd >> 12) & cast(uint32, 0xF)
	if fb == cast(uint32, arm32.R0) {
		return fail("frame address must not be written into the index's register")
	}
	if ((scaled >> 16) & cast(uint32, 0xF)) != fb {
		return fail("scaled ADD must read the frame address register")
	}
	if (scaled & cast(uint32, 0xFFF0FFFF)) != cast(uint32, 0xE0800200) {
		return fail("expected add r0, <fb>, r0, lsl #4")
	}
	return ""
}

// A global base (MOVW/MOVT) is likewise materialized into a scratch, not into
// rd: with the index and the result both in R0, the shifted ADD must still see
// the index.
func TestEmitGetElemPtrGlobalBaseKeepsIndex() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	rm.HomeIDs = common.AppendInt(rm.HomeIDs, 2)
	rm.HomeRegs = common.AppendInt(rm.HomeRegs, arm32.R0)
	rm.HomeIDs = common.AppendInt(rm.HomeIDs, 3)
	rm.HomeRegs = common.AppendInt(rm.HomeRegs, arm32.R0)
	var ins @ir.Instr = gepElemInstr(types.MakeArrayType(types.TypUint8(), 16))
	ins.Args[0].IsGlobalRef = true
	ins.Args[0].StrVal = "g"
	emitGetElemPtr(a, "main", rm, ins)
	if bytesWritten(a) != 12 {
		return fail("global-base GEP should be MOVW, MOVT, then the scaled ADD")
	}
	var gb uint32 = (word32(a, 0) >> 12) & cast(uint32, 0xF)
	if gb == cast(uint32, arm32.R0) {
		return fail("global address must not be written into the index's register")
	}
	if ((word32(a, 4) >> 12) & cast(uint32, 0xF)) != gb {
		return fail("MOVT must target the MOVW register")
	}
	var scaled uint32 = word32(a, 8)
	if ((scaled >> 16) & cast(uint32, 0xF)) != gb {
		return fail("scaled ADD must read the global address register")
	}
	if (scaled & cast(uint32, 0xFFF0FFFF)) != cast(uint32, 0xE0800200) {
		return fail("expected add r0, <gb>, r0, lsl #4")
	}
	return ""
}

// An aggregate OP_ALLOC marked NoZeroInit (fully written before anything reads
// it) emits no zeroing stores.
func TestAllocNoZeroInit() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	var f @ir.Func = make(ir.Func)
	f.Name = "main.f"
	var blk @ir.Block = make(ir.Block)
	blk.Label = "entry"
	var alloc @ir.Instr = make(ir.Instr)
	alloc.ID = 5
	alloc.Op = iropcode.OP_ALLOC
	alloc.TypeArg = types.MakeSliceType(types.TypUint8())
	alloc.NoZeroInit = true
	blk.Instrs = appendInstr_arm32emittest(blk.Instrs, alloc)
	f.Blocks = appendBlock_arm32emittest(f.Blocks, blk)
	rm.PlanFrame(f)
	emitAlloc(a, rm, alloc)
	if bytesWritten(a) != 0 { return fail("a NoZeroInit slot should emit no zeroing stores") }
	return ""
}
