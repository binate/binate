package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/elf"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// arm32Emitter is the ARM32 (ILP32, AAPCS32 soft-float) impl of
// common.ArchEmitter: it routes the shared common.EmitObject skeleton's
// per-arch steps to this package's emission helpers.  ARM32 is ELF-only, so
// there is no object-format linkage prefix: SetPrefix/ClearPrefix are no-ops
// and SymPrefixed is the identity.  Each method realises the like-named
// common.ArchEmitter method (contract there).
type arm32Emitter struct {
}

// WordBytes — ARM32 is ILP32.
func (e *arm32Emitter) WordBytes() int { return 4 }

// SetPrefix is a no-op: ELF symbols are bare, and ARM32 emits only ELF.
func (e *arm32Emitter) SetPrefix(format *[]readonly char) {}

// ClearPrefix is a no-op (no prefix state; see SetPrefix).
func (e *arm32Emitter) ClearPrefix() {}

// SymPrefixed is the identity on this ELF-only backend.
func (e *arm32Emitter) SymPrefixed(name *[]readonly char) @[]char {
	return symPrefixed(name)
}

// ArchName is the tag for a ReportEmitError diagnostic.
func (e *arm32Emitter) ArchName() *[]readonly char {
	return "arm32"
}

// EmitFunc lowers one function's text.
func (e *arm32Emitter) EmitFunc(a @asm.Assembler, pkgName *[]readonly char, f @ir.Func,
		strings @[]ir.StringConst, allFuncs @[]@ir.Func) {
	emitFunc(a, pkgName, f, strings, allFuncs)
}

// EmitFuncValueShims lowers the module's function-value call shims.
func (e *arm32Emitter) EmitFuncValueShims(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	emitFuncValueShims(a, pkgName, mod)
}

// EmitStringTable lowers the collected string-literal table.
func (e *arm32Emitter) EmitStringTable(a @asm.Assembler, pkgName *[]readonly char,
		strings @[]ir.StringConst) {
	emitStringTable(a, pkgName, strings)
}

// EmitGlobals lowers package-level variable storage.
func (e *arm32Emitter) EmitGlobals(a @asm.Assembler, pkgName *[]readonly char,
		globals @[]@ir.Global) {
	emitGlobals(a, pkgName, globals)
}

// EmitFuncValueVtables lowers the function-value vtables.
func (e *arm32Emitter) EmitFuncValueVtables(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	emitFuncValueVtables(a, pkgName, mod)
}

// EmitImplVtables lowers the interface-impl vtables.
func (e *arm32Emitter) EmitImplVtables(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	emitImplVtables(a, pkgName, mod)
}

// EmitPackageDescriptor lowers the reflect / package descriptor.
func (e *arm32Emitter) EmitPackageDescriptor(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	emitPackageDescriptor(a, pkgName, mod)
}

// ResolveFixups patches same-section fixups.
func (e *arm32Emitter) ResolveFixups(a @asm.Assembler) {
	arm32.ResolveFixups(a)
}

// WriteObject writes an ARM32 ELF object (this backend's only format).
func (e *arm32Emitter) WriteObject(a @asm.Assembler, format *[]readonly char,
		path *[]readonly char) bool {
	return elf.WriteARM32(a, path)
}

impl *arm32Emitter : common.ArchEmitter
