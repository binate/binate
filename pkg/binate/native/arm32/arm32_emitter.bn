package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/elf"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/native/blockplan"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/native/place"
import "pkg/binate/stringutils"
import "pkg/binate/types/abi"
import "pkg/std/strings"

// arm32Emitter is the ARM32 (ILP32, AAPCS32 soft-float) impl of
// common.ArchEmitter: it routes the shared common.EmitObject skeleton's
// per-arch steps to this package's emission helpers.  ARM32 is ELF-only, so
// there is no object-format linkage prefix: SetPrefix/ClearPrefix are no-ops
// and SymPrefixed is the identity.  Each method realises the like-named
// common.ArchEmitter method (contract there).
type arm32Emitter struct {
}

// WordBytes — ARM32 is ILP32.
func (e *arm32Emitter) WordBytes() int { return 4 }

// CallConv returns the AAPCS32 calling convention (constant for this backend).
func (e *arm32Emitter) CallConv() callconv.CallConv { return callconv.AAPCS32() }

// SetPrefix is a no-op: ELF symbols are bare, and ARM32 emits only ELF.
func (e *arm32Emitter) SetPrefix(format *[]readonly char) {}

// ClearPrefix is a no-op (no prefix state; see SetPrefix).
func (e *arm32Emitter) ClearPrefix() {}

// SymPrefixed is the identity on this ELF-only backend.
func (e *arm32Emitter) SymPrefixed(name *[]readonly char) @[]char {
	return symPrefixed(name)
}

// ArchName is the tag for a ReportEmitError diagnostic.
func (e *arm32Emitter) ArchName() *[]readonly char {
	return "arm32"
}

// AlignsLoops is false: this backend pads no loop to a boundary.
func (e *arm32Emitter) AlignsLoops() bool { return false }

// EmitFunc lowers one function's text, laid out as plan says.
func (e *arm32Emitter) EmitFunc(a @asm.Assembler, pkgName *[]readonly char, f @ir.Func,
		strings @[]ir.StringConst, plan @blockplan.BlockPlan) {
	emitFuncPlanned(a, pkgName, f, strings, plan)
}

// EmitFuncValueShims lowers the module's function-value call shims.
func (e *arm32Emitter) EmitFuncValueShims(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	emitFuncValueShims(a, pkgName, mod)
	emitFuncValuePackedShimsArm32(a, pkgName, mod)
}

// EmitCEntryThunks lowers the weak __c_entry adaptation thunks.
func (e *arm32Emitter) EmitCEntryThunks(a @asm.Assembler, pkgName *[]readonly char,
		targets @[]@ir.Func) {
	emitCEntryThunks(a, pkgName, targets)
}

// EmitStringTable lowers the collected string-literal table.
func (e *arm32Emitter) EmitStringTable(a @asm.Assembler, pkgName *[]readonly char,
		strings @[]ir.StringConst) {
	emitStringTable(a, pkgName, strings)
}

// EmitGlobals lowers package-level variable storage.
func (e *arm32Emitter) EmitGlobals(a @asm.Assembler, pkgName *[]readonly char,
		globals @[]@ir.Global) {
	emitGlobals(a, pkgName, globals)
}

// EmitFuncValueVtables lowers the function-value vtables.
func (e *arm32Emitter) EmitFuncValueVtables(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	emitFuncValueVtables(a, pkgName, mod)
}

// EmitImplVtables lowers the interface-impl vtables.
func (e *arm32Emitter) EmitImplVtables(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	emitImplVtables(a, pkgName, mod)
}

// EmitPackageDescriptor lowers the reflect / package descriptor.
func (e *arm32Emitter) EmitPackageDescriptor(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	emitPackageDescriptor(a, pkgName, mod)
}

// ResolveFixups patches the branches to local labels in their own section, and bakes every
// other fixup's addend into its field for the REL relocation (arm32.ResolveFixups).
func (e *arm32Emitter) ResolveFixups(a @asm.Assembler) {
	arm32.ResolveFixups(a)
}

// ARM32_PLACE_UNIT is the granularity of function-placement filler: whole A32
// instructions.  Every .text offset is a multiple of it (this backend puts only
// instructions in .text), so a fill puts the next entry exactly at the offset
// place.PlaceFillBefore's phase mode aims for.
const ARM32_PLACE_UNIT int = 4

// PlaceUnit is ARM32_PLACE_UNIT.
func (e *arm32Emitter) PlaceUnit() int {
	return ARM32_PLACE_UNIT
}

// EmitPlaceFill emits nbytes / ARM32_PLACE_UNIT of BKPT #place.PLACE_FILL_IMM.  Real A32 code,
// so .text stays one run of code (its one `$a` mapping symbol, at offset 0); nbytes must be a
// non-negative multiple of ARM32_PLACE_UNIT.
func (e *arm32Emitter) EmitPlaceFill(a @asm.Assembler, nbytes int) {
	if nbytes < 0 || nbytes % ARM32_PLACE_UNIT != 0 {
		var msg @strings.Builder = strings.NewBuilder()
		msg.Write("arm32: function-placement fill must be a non-negative multiple of ")
		stringutils.WriteInt(msg, ARM32_PLACE_UNIT)
		msg.Write(" bytes")
		a.SetError(msg.String())
		return
	}
	for i := 0; i < nbytes / ARM32_PLACE_UNIT; i++ {
		arm32.Bkpt(a, place.PLACE_FILL_IMM)
	}
}

// WriteObject writes an ARM32 ELF object (this backend's only format).
func (e *arm32Emitter) WriteObject(a @asm.Assembler, format *[]readonly char,
		path *[]readonly char) bool {
	// The build attributes the object's code needs beyond armv7ve's (elf.WriteARM32).  A
	// hard-float target's code uses scalar VFPv3, no NEON, and passes floating-point
	// arguments in VFP registers (Tag_ABI_VFP_args, which GNU ld checks against the rest of
	// the link); abi.Arm32HardFloat() is the gate the calling convention and codegen also
	// read, so the attributes and the code agree.  Bare metal is soft-float and runs with
	// strict alignment checking, so its code makes no unaligned access
	// (Tag_CPU_unaligned_access 0, as clang's -mno-unaligned-access).
	if abi.Arm32HardFloat() {
		a.ArmFPU = buf.CopyStr("vfpv3")
		a.SetArmAttr(asm.ARM_TAG_ABI_VFP_ARGS, 1, "")
	} else {
		a.SetArmAttr(asm.ARM_TAG_CPU_UNALIGNED_ACCESS, 0, "")
	}
	return elf.WriteARM32(a, path)
}

impl *arm32Emitter : common.ArchEmitter
