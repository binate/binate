package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/os"

// arm32Emitter is the ARM32 impl of common.ArchEmitter.  The full emission
// path is exercised end-to-end by the emit-shape tests + native conformance;
// here we pin the arch constants it feeds the shared EmitObject skeleton
// (ILP32 word size) and that it satisfies the interface (dispatch through a
// *common.ArchEmitter).

func TestArm32EmitterWordBytes() testing.TestResult {
	var em arm32Emitter
	var p *arm32Emitter = &em
	if p.WordBytes() != 4 {
		return fail("arm32 word size should be 4 (ILP32)")
	}
	return ""
}

func TestArm32EmitterArchName() testing.TestResult {
	var em arm32Emitter
	var p *arm32Emitter = &em
	if !charEq(p.ArchName(), "arm32") {
		return fail("arch name should be arm32")
	}
	return ""
}

// This backend pads no loop to a boundary, so its block plans need not mark loop
// tops and the loop analysis never runs for it.
func TestArm32EmitterAlignsNoLoops() testing.TestResult {
	var em arm32Emitter
	if em.AlignsLoops() { return fail("the arm32 emitter must not ask for loop tops") }
	return ""
}

func TestArm32EmitterSatisfiesArchEmitter() testing.TestResult {
	// Dispatch through the interface vtable (as common.EmitObject does).
	var em arm32Emitter
	var e *common.ArchEmitter = &em
	if e.WordBytes() != 4 {
		return fail("interface dispatch: word size should be 4")
	}
	return ""
}

// attrHexBytes returns the bytes the lowercase hex string h spells.
func attrHexBytes(h *[]readonly char) @[]char {
	var out @[]char = make_slice(char, len(h) / 2)
	for i := 0; i < len(out); i++ { out[i] = attrHexDigit(h[2 * i]) * 16 + attrHexDigit(h[2 * i + 1]) }
	return out
}

// attrHexDigit returns the value of the lowercase hex digit c.
func attrHexDigit(c char) char {
	if c >= 'a' { return c - 'a' + 10 }
	return c - '0'
}

// writeObjectAttrsAre writes a one-instruction object in dir through the backend's WriteObject
// for an arm32 target of float ABI floatABI (types.FLOAT_ABI_*), restoring the target after,
// and reports whether the object holds the .ARM.attributes section hex spells.
func writeObjectAttrsAre(dir *[]readonly char, floatABI int, hex *[]readonly char) bool {
	var old types.TargetInfo = types.GetTarget()
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
	types.SetArch(types.ARCH_ARM32)
	types.SetFloatABI(floatABI)
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.EmitInstrUint32(0xE12FFF1E) // bx lr
	var em arm32Emitter
	var p *arm32Emitter = &em
	var path @[]char = buf.Concat(dir, "/attrs.o")
	var ok bool = a.Finalize() && p.WriteObject(a, "elf", path)
	types.SetArch(types.ARCH_UNKNOWN)
	types.SetFloatABI(types.FLOAT_ABI_DEFAULT)
	types.SetTarget(old)
	return ok && fileContainsStr(path, attrHexBytes(hex))
}

// The build attributes the backend's objects carry, byte for byte as clang (Apple clang 21)
// writes them for the same claims: armv7ve's, plus on a hard-float target VFPv3 without NEON
// and Tag_ABI_VFP_args (`.fpu vfpv3`, `.eabi_attribute 28, 1`, arm-linux-gnueabihf), and on a
// soft-float, bare-metal one no FPU and no unaligned access (arm-none-eabi -mfloat-abi=soft
// -mno-unaligned-access).
func TestArm32WriteObjectAttributes() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	if !writeObjectAttrsAre(dir, types.FLOAT_ABI_HARD,
			"41230000006165616269000119000000060a0741080109020a031c0122012a012c024403") {
		return fail("the hard-float attributes are not VFPv3 with VFP arguments")
	}
	if !writeObjectAttrsAre(dir, types.FLOAT_ABI_SOFT,
			"411f0000006165616269000115000000060a07410801090222002a012c024403") {
		return fail("the soft-float attributes are not bare metal's")
	}
	return ""
}
