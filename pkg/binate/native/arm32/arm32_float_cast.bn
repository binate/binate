package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Float conversions (OP_CAST with a float endpoint) via AEABI helpers
// ============================================================
//
// Every numeric conversion touching a float has an AEABI helper (soft-float has
// no VFP VCVT), named for its (source, dest) pair and confirmed against
// `arm-none-eabi-gcc -mfloat-abi=soft`:
//   int  -> float : __aeabi_{i,ui,l,ul}2{f,d}   (signed/unsigned, 32/64 src)
//   float -> int  : __aeabi_{f,d}2{i,ui,l,ul}z  (z = round-toward-zero / trunc)
//   float -> float: __aeabi_f2d (widen) / __aeabi_d2f (narrow)
// The operand rides r0 (32-bit) or r0:r1 (64-bit) and the result comes back the
// same way, exactly like the int64 libcalls.  Float→int truncates toward zero;
// the IR's saturation guard (gen_cast_float.bn) brackets the value first, so the
// raw truncating helper is what's wanted here.

// emitFloatCast lowers OP_CAST when either endpoint is a float, dispatching to
// the int→float, float→int, or float→float family.
func emitFloatCast(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) != 1 || ins.TypeArg == nil {
		a.SetError("native arm32: float cast expects 1 operand and a target type")
		return
	}
	var srcTyp @types.Type = ins.Args[0].Typ
	var dstTyp @types.Type = ins.TypeArg
	var srcF bool = isFloatTyp(srcTyp)
	var dstF bool = isFloatTyp(dstTyp)
	if srcF && dstF {
		emitFloatToFloat(a, pkgName, rm, ins, srcTyp, dstTyp)
		return
	}
	if dstF {
		emitIntToFloat(a, pkgName, rm, ins, srcTyp, dstTyp)
		return
	}
	emitFloatToInt(a, pkgName, rm, ins, srcTyp, dstTyp)
}

// emitFloatToFloat lowers float32↔float64.  A same-width cast (a named-distinct
// float to/from its underlying) is a shape-preserving copy; a widen calls
// __aeabi_f2d and a narrow __aeabi_d2f.
func emitFloatToFloat(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr,
		srcTyp @types.Type, dstTyp @types.Type) {
	var srcW int = floatBitWidth(srcTyp)
	var dstW int = floatBitWidth(dstTyp)
	if srcW == dstW {
		if dstW == 64 {
			emitCast64Identity(a, rm, ins)
		} else {
			emitFloatSingleIdentity(a, pkgName, rm, ins)
		}
		return
	}
	if !placeConvArg(a, pkgName, rm, ins.Args[0], srcW == 64) {
		a.SetError("native arm32: float-to-float cast operand not materializable")
		return
	}
	if srcW == 32 {
		emitAeabiCall(a, "__aeabi_f2d")
	} else {
		emitAeabiCall(a, "__aeabi_d2f")
	}
	collectConvResult(a, rm, ins, dstW == 64, nil)
}

// emitIntToFloat lowers int→float via __aeabi_{i,ui,l,ul}2{f,d}.  A sub-word
// integer source is already sign-/zero-extended to a canonical 32-bit word in
// its slot, so the 32-bit i2f/ui2f helper reads it directly.
func emitIntToFloat(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr,
		srcTyp @types.Type, dstTyp @types.Type) {
	var srcPair bool = is64Typ(srcTyp)
	var dstPair bool = isFloat64Typ(dstTyp)
	var unsigned bool = common.IsUnsignedIntType(srcTyp)
	if !placeConvArg(a, pkgName, rm, ins.Args[0], srcPair) {
		a.SetError("native arm32: int-to-float cast operand not materializable")
		return
	}
	emitAeabiCall(a, intToFloatHelper(srcPair, dstPair, unsigned))
	collectConvResult(a, rm, ins, dstPair, nil)
}

// emitFloatToInt lowers float→int via __aeabi_{f,d}2{i,ui,l,ul}z (truncating).
// A sub-word integer target re-narrows the 32-bit helper result to its width.
func emitFloatToInt(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr,
		srcTyp @types.Type, dstTyp @types.Type) {
	var srcPair bool = isFloat64Typ(srcTyp)
	var dstPair bool = is64Typ(dstTyp)
	var unsigned bool = common.IsUnsignedIntType(dstTyp)
	if !placeConvArg(a, pkgName, rm, ins.Args[0], srcPair) {
		a.SetError("native arm32: float-to-int cast operand not materializable")
		return
	}
	emitAeabiCall(a, floatToIntHelper(srcPair, dstPair, unsigned))
	collectConvResult(a, rm, ins, dstPair, dstTyp)
}

// intToFloatHelper selects the int→float AEABI symbol.  srcPair picks the 64-bit
// (l/ul) family over 32-bit (i/ui); unsigned picks the u-prefixed form; dstPair
// picks double (2d) over single (2f).
func intToFloatHelper(srcPair bool, dstPair bool, unsigned bool) *[]readonly char {
	if srcPair {
		if unsigned {
			if dstPair { return "__aeabi_ul2d" }
			return "__aeabi_ul2f"
		}
		if dstPair { return "__aeabi_l2d" }
		return "__aeabi_l2f"
	}
	if unsigned {
		if dstPair { return "__aeabi_ui2d" }
		return "__aeabi_ui2f"
	}
	if dstPair { return "__aeabi_i2d" }
	return "__aeabi_i2f"
}

// floatToIntHelper selects the float→int AEABI symbol (all round-toward-zero,
// the `z` suffix).  srcPair picks the double (d2) family; dstPair picks the
// 64-bit (2l/2ul) result; unsigned picks the u form.
func floatToIntHelper(srcPair bool, dstPair bool, unsigned bool) *[]readonly char {
	if srcPair {
		if dstPair {
			if unsigned { return "__aeabi_d2ulz" }
			return "__aeabi_d2lz"
		}
		if unsigned { return "__aeabi_d2uiz" }
		return "__aeabi_d2iz"
	}
	if dstPair {
		if unsigned { return "__aeabi_f2ulz" }
		return "__aeabi_f2lz"
	}
	if unsigned { return "__aeabi_f2uiz" }
	return "__aeabi_f2iz"
}

// placeConvArg marshals a single conversion operand into the AAPCS arg
// register(s): r0:r1 for a 64-bit pair (int64 / uint64 / float64), r0 for a
// single word (int / sub-word int / float32).  Returns false if the operand is
// not materializable.
func placeConvArg(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, arg @ir.Instr,
		isPair bool) bool {
	if isPair {
		var lo int
		var hi int
		lo, hi = load64(a, rm, arg)
		if lo < 0 { return false }
		arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Reg(lo))
		arm32.Mov(a, arm32.COND_AL, false, arm32.R1, arm32.Reg(hi))
		return true
	}
	var s int = emitValOperand(a, pkgName, rm, arg)
	if s < 0 { return false }
	arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Reg(s))
	return true
}

// collectConvResult reads a conversion's result after the AEABI call: a 64-bit
// result (r0:r1) stores to the value's pair slot; a single-word result (r0)
// registers via nextReg (spilled by the following spillAndReset), re-narrowed to
// `narrowTyp`'s width when that is a sub-word integer (nil skips the narrow, e.g.
// for a float or 32-bit result).  Resets the register pool first — the AEABI BL
// clobbered r0-r3 / r12, so no pre-call scratch survives.
func collectConvResult(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr, isPair bool,
		narrowTyp @types.Type) {
	rm.ResetRegs()
	if isPair {
		var rlo int = scratchReg(rm)
		arm32.Mov(a, arm32.COND_AL, false, rlo, arm32.Reg(arm32.R0))
		var rhi int = scratchReg(rm)
		arm32.Mov(a, arm32.COND_AL, false, rhi, arm32.Reg(arm32.R1))
		store64(a, rm, ins, rlo, rhi)
		return
	}
	var rd int = nextReg(rm, ins.ID)
	arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Reg(arm32.R0))
	if narrowTyp != nil {
		emitSubWordNarrow(a, rd, narrowTyp)
	}
}

// emitFloatSingleIdentity copies a single-word float value unchanged (a
// float32↔named-float32 cast), MOVing the operand into the result register.
func emitFloatSingleIdentity(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		ins @ir.Instr) {
	var src int = emitValOperand(a, pkgName, rm, ins.Args[0])
	if src < 0 {
		a.SetError("native arm32: float32 identity cast operand not materializable")
		return
	}
	var rd int = nextReg(rm, ins.ID)
	arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Reg(src))
}
