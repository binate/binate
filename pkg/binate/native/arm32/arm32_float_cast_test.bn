package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the float conversions (arm32_float_cast.bn): each (source,
// dest) pair must reference its correct __aeabi_* helper — calling the wrong
// one (e.g. i2f for a double target, or the signed helper for an unsigned) is a
// silent miscompile.  The register marshaling is exercised by the float cast
// conformance tests.  castFloat / rm64 live in the sibling test files.

// castRefsHelper emits a float cast (srcTyp -> dstTyp) and reports whether the
// expected AEABI symbol was referenced.
func castRefsHelper(srcTyp @types.Type, dstTyp @types.Type, sym *[]readonly char) bool {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	if !emitInstrFloat(a, "main", rm, castFloat(srcTyp, dstTyp)) { return false }
	return a.LookupSymbol(sym) >= 0
}

// int→float conversions select the signed/unsigned, 32/64-source, single/double
// AEABI helper.
func TestIntToFloatHelpers() testing.TestResult {
	if !castRefsHelper(types.TypInt(), types.TypFloat64(), "__aeabi_i2d") {
		return fail("int->float64 must reference __aeabi_i2d")
	}
	if !castRefsHelper(types.TypInt(), types.TypFloat32(), "__aeabi_i2f") {
		return fail("int->float32 must reference __aeabi_i2f")
	}
	if !castRefsHelper(types.TypUint(), types.TypFloat64(), "__aeabi_ui2d") {
		return fail("uint->float64 must reference __aeabi_ui2d")
	}
	if !castRefsHelper(types.TypInt64(), types.TypFloat64(), "__aeabi_l2d") {
		return fail("int64->float64 must reference __aeabi_l2d")
	}
	if !castRefsHelper(types.TypUint64(), types.TypFloat64(), "__aeabi_ul2d") {
		return fail("uint64->float64 must reference __aeabi_ul2d")
	}
	return ""
}

// float→int conversions select the truncating (z) helper by source width, dest
// width, and signedness.
func TestFloatToIntHelpers() testing.TestResult {
	if !castRefsHelper(types.TypFloat64(), types.TypInt(), "__aeabi_d2iz") {
		return fail("float64->int must reference __aeabi_d2iz")
	}
	if !castRefsHelper(types.TypFloat32(), types.TypInt(), "__aeabi_f2iz") {
		return fail("float32->int must reference __aeabi_f2iz")
	}
	if !castRefsHelper(types.TypFloat64(), types.TypUint(), "__aeabi_d2uiz") {
		return fail("float64->uint must reference __aeabi_d2uiz")
	}
	if !castRefsHelper(types.TypFloat64(), types.TypInt64(), "__aeabi_d2lz") {
		return fail("float64->int64 must reference __aeabi_d2lz")
	}
	if !castRefsHelper(types.TypFloat32(), types.TypUint64(), "__aeabi_f2ulz") {
		return fail("float32->uint64 must reference __aeabi_f2ulz")
	}
	return ""
}

// float32↔float64 conversions widen via __aeabi_f2d and narrow via __aeabi_d2f.
func TestFloatToFloatHelpers() testing.TestResult {
	if !castRefsHelper(types.TypFloat32(), types.TypFloat64(), "__aeabi_f2d") {
		return fail("float32->float64 must reference __aeabi_f2d (widen)")
	}
	if !castRefsHelper(types.TypFloat64(), types.TypFloat32(), "__aeabi_d2f") {
		return fail("float64->float32 must reference __aeabi_d2f (narrow)")
	}
	return ""
}
