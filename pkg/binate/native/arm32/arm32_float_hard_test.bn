package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the hard-float VFP compute path (arm32_float_hard.bn).  Each
// test STAMPS an arm32 hard-float target (types.SetArch(ARCH_ARM32) +
// SetFloatABI(FLOAT_ABI_HARD)) so types.Arm32HardFloat() is true, emits the op,
// then RESTORES the prior Arch / FloatABI BEFORE any assertion-return — an early
// failure return must not leak the hard stamp into the other tests.  Assertions
// pin that the backend SELECTS the right VFP instruction (comparing against the
// inc-1 encoders, which are themselves arm-none-eabi-as-verified), the NaN-safe
// compare cond code, the GP-materialized const (no VFP round-trip, no pool), and
// that int64<->float still routes to AEABI.  Shared builders (bin64 / un64 /
// castFloat / constFloat / rm64 / mkAsm / word32 / fail) live in the int64 /
// soft-float test files; a float value uses the same 8-byte pair slots.

// containsWord reports whether any 32-bit word in the text section equals w.
func containsWord(a @asm.Assembler, w uint32) bool {
	var n int = a.Sections[0].Len
	for off := 0; off + 4 <= n; off = off + 4 {
		if word32(a, off) == w { return true }
	}
	return false
}

// stampHard stamps an arm32 hard-float target and returns the prior (arch, abi)
// so the caller can restore it before asserting.
func stampHard() (int, int) {
	var oldArch int = types.GetTarget().Arch
	var oldAbi int = types.GetTarget().FloatABI
	types.SetArch(types.ARCH_ARM32)
	types.SetFloatABI(types.FLOAT_ABI_HARD)
	return oldArch, oldAbi
}

// restoreTarget puts back the (arch, abi) stampHard captured.
func restoreTarget(oldArch int, oldAbi int) {
	types.SetArch(oldArch)
	types.SetFloatABI(oldAbi)
}

// emitHardFloat stamps hard-float, emits ins into a fresh assembler, and
// restores the target — so the returned assembler holds the hard-path bytes and
// the global target is clean before the caller asserts.
func emitHardFloat(ins @ir.Instr) @asm.Assembler {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	emitInstrFloat(a, "main", rm, ins)
	restoreTarget(oldArch, oldAbi)
	return a
}

// ============================================================
// Arithmetic — the VFP instruction per op / width
// ============================================================

// f64 arithmetic emits VADD/VSUB/VMUL/VDIV.F64 on D0,D0,D1 (and references no
// AEABI arithmetic helper).
func TestHardFloat64ArithEmitsVfp() testing.TestResult {
	var ops @[]int = intList4(iropcode.OP_ADD, iropcode.OP_SUB, iropcode.OP_MUL, iropcode.OP_DIV)
	for i := 0; i < len(ops); i = i + 1 {
		var a @asm.Assembler = emitHardFloat(bin64(ops[i], types.TypFloat64()))
		var ref @asm.Assembler = mkAsm()
		emitVfpArithF64(ref, ops[i], arm32.D0, arm32.D0, arm32.D1)
		if !containsWord(a, word32(ref, 0)) {
			return fail("hard float64 arith must emit its VFP .F64 instruction")
		}
		if a.LookupSymbol("__aeabi_dadd") >= 0 {
			return fail("hard float64 arith must not reference an AEABI helper")
		}
	}
	return ""
}

// f32 arithmetic emits VADD/VSUB/VMUL/VDIV.F32 on S4,S4,S5.
func TestHardFloat32ArithEmitsVfp() testing.TestResult {
	var ops @[]int = intList4(iropcode.OP_ADD, iropcode.OP_SUB, iropcode.OP_MUL, iropcode.OP_DIV)
	for i := 0; i < len(ops); i = i + 1 {
		var a @asm.Assembler = emitHardFloat(bin64(ops[i], types.TypFloat32()))
		var ref @asm.Assembler = mkAsm()
		emitVfpArithF32(ref, ops[i], arm32.S4, arm32.S4, arm32.S5)
		if !containsWord(a, word32(ref, 0)) {
			return fail("hard float32 arith must emit its VFP .F32 instruction")
		}
		if a.LookupSymbol("__aeabi_fadd") >= 0 {
			return fail("hard float32 arith must not reference an AEABI helper")
		}
	}
	return ""
}

// ============================================================
// Negate — VNEG, no libcall
// ============================================================

// f64 negate emits VNEG.F64; f32 negate emits VNEG.F32 (a true FP negate, not
// the soft path's sign-bit EOR).
func TestHardFloatNegEmitsVneg() testing.TestResult {
	var a64 @asm.Assembler = emitHardFloat(un64(iropcode.OP_NEG, types.TypFloat64()))
	var ref64 @asm.Assembler = mkAsm()
	arm32.VnegF64(ref64, arm32.COND_AL, arm32.D0, arm32.D0)
	if !containsWord(a64, word32(ref64, 0)) {
		return fail("hard float64 neg must emit VNEG.F64")
	}
	var a32 @asm.Assembler = emitHardFloat(un64(iropcode.OP_NEG, types.TypFloat32()))
	var ref32 @asm.Assembler = mkAsm()
	arm32.VnegF32(ref32, arm32.COND_AL, arm32.S4, arm32.S4)
	if !containsWord(a32, word32(ref32, 0)) {
		return fail("hard float32 neg must emit VNEG.F32")
	}
	return ""
}

// ============================================================
// Compare — VCMP + VMRS + NaN-safe cond-mov
// ============================================================

// A hard float64 `<` emits VCMP.F64, VMRS APSR_nzcv, a Mov #0, and a
// CONDITIONAL Mov #1 under the NaN-safe condition MI (not LT).
func TestHardFloat64CompareEmitsVcmpMi() testing.TestResult {
	var a @asm.Assembler = emitHardFloat(bin64(iropcode.OP_LT, types.TypFloat64()))
	var refCmp @asm.Assembler = mkAsm()
	arm32.VcmpF64(refCmp, arm32.COND_AL, arm32.D0, arm32.D1)
	if !containsWord(a, word32(refCmp, 0)) {
		return fail("hard float64 compare must emit VCMP.F64")
	}
	var refVmrs @asm.Assembler = mkAsm()
	arm32.VmrsApsrNzcv(refVmrs, arm32.COND_AL)
	if !containsWord(a, word32(refVmrs, 0)) {
		return fail("hard float compare must emit VMRS APSR_nzcv")
	}
	// The result lands in R4 (nextReg's first slot after ResetRegs): Mov{MI} R4, #1.
	var refMov @asm.Assembler = mkAsm()
	arm32.Mov(refMov, arm32.COND_MI, false, arm32.R4, arm32.Imm(1))
	if !containsWord(a, word32(refMov, 0)) {
		return fail("hard float `<` must set the bool under the NaN-safe MI cond")
	}
	// The naive signed LT cond (fires on unordered/NaN) must NOT appear.
	var refLt @asm.Assembler = mkAsm()
	arm32.Mov(refLt, arm32.COND_LT, false, arm32.R4, arm32.Imm(1))
	if containsWord(a, word32(refLt, 0)) {
		return fail("hard float `<` must NOT use the NaN-firing signed LT cond")
	}
	return ""
}

// floatCompareCond maps each relation to its NaN-safe ARM condition, mirroring
// the aarch64 sibling: `<`->MI and `<=`->LS (NOT the signed LT/LE, which fire on
// unordered/NaN); `>`->GT, `>=`->GE, `==`->EQ, `!=`->NE.
func TestFloatCompareCondCodes() testing.TestResult {
	if floatCompareCond(iropcode.OP_EQ) != arm32.COND_EQ {
		return fail("== must map to COND_EQ")
	}
	if floatCompareCond(iropcode.OP_NE) != arm32.COND_NE {
		return fail("!= must map to COND_NE")
	}
	if floatCompareCond(iropcode.OP_LT) != arm32.COND_MI {
		return fail("< must map to COND_MI (NaN-safe), not COND_LT")
	}
	if floatCompareCond(iropcode.OP_LE) != arm32.COND_LS {
		return fail("<= must map to COND_LS (NaN-safe), not COND_LE")
	}
	if floatCompareCond(iropcode.OP_GT) != arm32.COND_GT {
		return fail("> must map to COND_GT")
	}
	if floatCompareCond(iropcode.OP_GE) != arm32.COND_GE {
		return fail(">= must map to COND_GE")
	}
	return ""
}

// ============================================================
// Casts — VCVT for 32-bit int and float<->float; int64 stays AEABI
// ============================================================

// A hard int32->float64 cast crosses the int into an S reg and emits
// VCVT.F64.S32 (signed); an unsigned source emits VCVT.F64.U32.
func TestHardInt32ToFloatEmitsVcvt() testing.TestResult {
	var aS @asm.Assembler = emitHardFloat(castFloat(types.TypInt32(), types.TypFloat64()))
	var refS @asm.Assembler = mkAsm()
	arm32.VcvtF64S32(refS, arm32.COND_AL, arm32.D0, arm32.S4)
	if !containsWord(aS, word32(refS, 0)) {
		return fail("hard int32->float64 must emit VCVT.F64.S32")
	}
	var aU @asm.Assembler = emitHardFloat(castFloat(types.TypUint32(), types.TypFloat64()))
	var refU @asm.Assembler = mkAsm()
	arm32.VcvtF64U32(refU, arm32.COND_AL, arm32.D0, arm32.S4)
	if !containsWord(aU, word32(refU, 0)) {
		return fail("hard uint32->float64 must emit VCVT.F64.U32")
	}
	return ""
}

// A hard float64->int32 cast emits a round-toward-zero VCVT.S32.F64 (trunc), the
// VFP analogue of the AEABI `d2iz` helper.
func TestHardFloatToInt32EmitsVcvt() testing.TestResult {
	var a @asm.Assembler = emitHardFloat(castFloat(types.TypFloat64(), types.TypInt32()))
	var ref @asm.Assembler = mkAsm()
	arm32.VcvtS32F64(ref, arm32.COND_AL, arm32.S4, arm32.D0)
	if !containsWord(a, word32(ref, 0)) {
		return fail("hard float64->int32 must emit VCVT.S32.F64 (trunc)")
	}
	if a.LookupSymbol("__aeabi_d2iz") >= 0 {
		return fail("hard float64->int32 must not reference an AEABI helper")
	}
	return ""
}

// A hard float32->float64 widen emits VCVT.F64.F32; a float64->float32 narrow
// emits VCVT.F32.F64.
func TestHardFloatToFloatEmitsVcvt() testing.TestResult {
	var aW @asm.Assembler = emitHardFloat(castFloat(types.TypFloat32(), types.TypFloat64()))
	var refW @asm.Assembler = mkAsm()
	arm32.VcvtF64F32(refW, arm32.COND_AL, arm32.D0, arm32.S4)
	if !containsWord(aW, word32(refW, 0)) {
		return fail("hard float32->float64 widen must emit VCVT.F64.F32")
	}
	var aN @asm.Assembler = emitHardFloat(castFloat(types.TypFloat64(), types.TypFloat32()))
	var refN @asm.Assembler = mkAsm()
	arm32.VcvtF32F64(refN, arm32.COND_AL, arm32.S4, arm32.D0)
	if !containsWord(aN, word32(refN, 0)) {
		return fail("hard float64->float32 narrow must emit VCVT.F32.F64")
	}
	return ""
}

// A hard int64->float64 cast has NO single VFP VCVT (VCVT is 32-bit-int only),
// so it STAYS on the AEABI libcall — references __aeabi_l2d and emits no VCVT.
func TestHardInt64ToFloatStillAeabi() testing.TestResult {
	var a @asm.Assembler = emitHardFloat(castFloat(types.TypInt64(), types.TypFloat64()))
	if a.LookupSymbol("__aeabi_l2d") < 0 {
		return fail("hard int64->float64 must stay on the AEABI __aeabi_l2d libcall")
	}
	var ref @asm.Assembler = mkAsm()
	arm32.VcvtF64S32(ref, arm32.COND_AL, arm32.D0, arm32.S4)
	if containsWord(a, word32(ref, 0)) {
		return fail("hard int64->float64 must NOT emit a 32-bit VCVT")
	}
	return ""
}

// ============================================================
// Const / bit_cast — ABI-independent (bits live in a GP slot)
// ============================================================

// A float const is a pure GP materialization (its IEEE bits live in the GP value
// slot in BOTH ABIs), so the hard-float output is byte-identical to soft — no
// VFP round-trip, no literal-pool load.  (See the deviation note in
// arm32_float_hard.bn: mirroring the aarch64 sibling, which materializes const
// bits in GP with no FP move.)
func TestHardConstFloatByteIdenticalToSoft() testing.TestResult {
	var aHard @asm.Assembler = emitHardFloat(constFloat("0.5", types.TypFloat64()))
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	types.SetFloatABI(types.FLOAT_ABI_SOFT)
	var aSoft @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	emitInstrFloat(aSoft, "main", rm, constFloat("0.5", types.TypFloat64()))
	restoreTarget(oldArch, oldAbi)
	if !sameText(aHard, aSoft) {
		return fail("hard float const must be byte-identical to the soft GP materialization")
	}
	return ""
}

// A float bit_cast is a same-representation reinterpret (bits already in GP in
// both ABIs), so the hard output is byte-identical to soft — no VFP move.
func TestHardBitCastByteIdenticalToSoft() testing.TestResult {
	var insHard @ir.Instr = castFloat(types.TypFloat64(), types.TypInt64())
	insHard.Op = iropcode.OP_BIT_CAST
	var aHard @asm.Assembler = emitHardFloat(insHard)
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	types.SetFloatABI(types.FLOAT_ABI_SOFT)
	var aSoft @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var insSoft @ir.Instr = castFloat(types.TypFloat64(), types.TypInt64())
	insSoft.Op = iropcode.OP_BIT_CAST
	emitInstrFloat(aSoft, "main", rm, insSoft)
	restoreTarget(oldArch, oldAbi)
	if !sameText(aHard, aSoft) {
		return fail("hard float bit_cast must be byte-identical to the soft GP move")
	}
	return ""
}

// ============================================================
// Negative control — soft target still routes to AEABI
// ============================================================

// With an arm32 SOFT target the compute path is unchanged: a float64 ADD
// references __aeabi_dadd and emits no VFP VADD.
func TestSoftFloatAddUnchanged() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	types.SetFloatABI(types.FLOAT_ABI_SOFT)
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	emitInstrFloat(a, "main", rm, bin64(iropcode.OP_ADD, types.TypFloat64()))
	restoreTarget(oldArch, oldAbi)
	if a.LookupSymbol("__aeabi_dadd") < 0 {
		return fail("soft float64 ADD must reference __aeabi_dadd")
	}
	var ref @asm.Assembler = mkAsm()
	arm32.VaddF64(ref, arm32.COND_AL, arm32.D0, arm32.D0, arm32.D1)
	if containsWord(a, word32(ref, 0)) {
		return fail("soft float64 ADD must NOT emit a VFP VADD.F64")
	}
	return ""
}

// sameText reports whether two assemblers' text sections are byte-identical.
func sameText(a @asm.Assembler, b @asm.Assembler) bool {
	if a.Sections[0].Len != b.Sections[0].Len { return false }
	for off := 0; off + 4 <= a.Sections[0].Len; off = off + 4 {
		if word32(a, off) != word32(b, off) { return false }
	}
	return true
}

// intList4 builds a 4-element @[]int (the BUILDER subset has no variadics /
// composite-literal helper here, so the four arithmetic ops are appended).
func intList4(a int, b int, c int, d int) @[]int {
	var xs @[]int
	xs = common.AppendInt(xs, a)
	xs = common.AppendInt(xs, b)
	xs = common.AppendInt(xs, c)
	xs = common.AppendInt(xs, d)
	return xs
}
