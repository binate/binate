package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// Plain (unfused) float load/store for an FP-homed value: VLDR/VSTR straight
// between the value's D-register home (a float32 through its low S-view) and
// memory, rather than through a GP register (LDR + VMOV into the home, or VMOV
// out of the home + STR).  The address is any the plain load/store handles: a
// frame alloca (SP-relative), a package global (MOVW/MOVT into a scratch), or a
// pointer in a register.  VLDR/VSTR reach only 1020, so vfpLoadBaseHard /
// vfpStoreBaseHard materialize a larger alloca offset in IP.  A value that is
// not FP-homed (spilled, or soft-float, which has no FP homes) keeps the GP path.
// A fused field GEP address never reaches here — the fused emitters take it first.

// emitFloatLoadToHome lowers OP_LOAD `ins` from address `arg` straight into the
// result's FP home.  Returns false, emitting nothing, when the result is not
// FP-homed.
func emitFloatLoadToHome(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		ins @ir.Instr, arg @ir.Instr) bool {
	var home int = rm.LookupHome(ins.ID)
	if !isFpReg(home) { return false }
	var isDouble bool = isFloat64Typ(ins.Typ)
	var vreg int = home
	if !isDouble { vreg = lowSingleOf(home) }
	var off int = rm.LookupAlloc(arg.ID)
	if off >= 0 {
		vfpLoadBaseHard(a, isDouble, vreg, arm32.SP, off, arm32.IP)
		return true
	}
	var addr int = floatMemAddr(a, pkgName, rm, arg)
	if addr < 0 {
		a.SetError("native arm32: float load address not materializable")
		return true
	}
	vfpLoadBaseHard(a, isDouble, vreg, addr, 0, arm32.IP)
	return true
}

// emitFloatStoreFromHome lowers OP_STORE `ins` of an FP-homed float value
// (Args[1]) straight from its home to the address Args[0].  Returns false,
// emitting nothing, when the stored value is not an FP-homed float.
func emitFloatStoreFromHome(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		ins @ir.Instr) bool {
	var val @ir.Instr = ins.Args[1]
	if !isFloatTyp(val.Typ) { return false }
	var home int = rm.LookupHome(val.ID)
	if !isFpReg(home) { return false }
	var isDouble bool = isFloat64Typ(val.Typ)
	var vreg int = home
	if !isDouble { vreg = lowSingleOf(home) }
	var off int = rm.LookupAlloc(ins.Args[0].ID)
	if off >= 0 {
		vfpStoreBaseHard(a, isDouble, vreg, arm32.SP, off, arm32.IP)
		return true
	}
	var addr int = floatMemAddr(a, pkgName, rm, ins.Args[0])
	if addr < 0 {
		a.SetError("native arm32: float store address not materializable")
		return true
	}
	vfpStoreBaseHard(a, isDouble, vreg, addr, 0, arm32.IP)
	return true
}

// floatMemAddr materializes a non-alloca load/store address: a package global's
// address into a fresh scratch, else the pointer operand's register.  -1 when
// the operand has no register.
func floatMemAddr(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		ptr @ir.Instr) int {
	if isGlobalRef(ptr) {
		var addr int = scratchReg(rm)
		emitGlobalAddr(a, pkgName, addr, ptr)
		return addr
	}
	return getOperand(a, rm, ptr.ID)
}
