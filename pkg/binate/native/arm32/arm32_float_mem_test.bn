package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Emit-level tests for the plain (unfused) float load/store of an FP-homed value
// (arm32_float_mem.bn), driven through emitLoad / emitStore so the float64 case
// also covers the 64-bit routing: VLDR/VSTR straight to/from the D home, never a
// GP round trip.

// fmPtr builds the address operand (id 100) of a plain load/store: an OP_ALLOC
// when alloca is set, else a register-valued pointer.
func fmPtr(elem @types.Type, alloca bool) @ir.Instr {
	var p @ir.Instr = make(ir.Instr)
	p.ID = 100
	if alloca { p.Op = iropcode.OP_ALLOC }
	p.Typ = types.MakePointerType(elem)
	return p
}

// fmPlainLoad builds OP_LOAD (id 102, type t) of ptr.
func fmPlainLoad(ptr @ir.Instr, t @types.Type) @ir.Instr {
	var ld @ir.Instr = make(ir.Instr)
	ld.ID = 102
	ld.Op = iropcode.OP_LOAD
	ld.Typ = t
	ld.Args = irbuild.MakeArgs1(ptr)
	return ld
}

// fmPlainStore builds OP_STORE (id 104) of value id 103 (type t) to ptr.
func fmPlainStore(ptr @ir.Instr, t @types.Type) @ir.Instr {
	var val @ir.Instr = make(ir.Instr)
	val.ID = 103
	val.Typ = t
	var st @ir.Instr = make(ir.Instr)
	st.ID = 104
	st.Op = iropcode.OP_STORE
	st.Args = irbuild.MakeArgs2(ptr, val)
	return st
}

// fmPlainMap returns a RegMap with id 100 as an alloca at frame offset allocOff
// (allocOff < 0: none — the caller homes the pointer instead).
func fmPlainMap(allocOff int) @common.RegMap {
	var m @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	if allocOff >= 0 {
		m.AllocIDs = common.AppendInt(m.AllocIDs, 100)
		m.AllocOffsets = common.AppendInt(m.AllocOffsets, allocOff)
		m.AllocSizes = common.AppendInt(m.AllocSizes, 8)
	}
	return m
}

// An FP-homed float32 loaded from an alloca is one VLDR.32 into the home's low
// S-view (D8 -> S16): VLDR.32 S16,[SP,#32].
func TestPlainFloat32LoadAllocaToHome() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = fmPlainMap(32)
	ffHome(m, 102, arm32.D8)
	emitLoad(a, "main", m, fmPlainLoad(fmPtr(types.TypFloat32(), true), types.TypFloat32()))
	var ref @asm.Assembler = ffMkAsm()
	arm32.Vldr32(ref, arm32.COND_AL, arm32.S16, arm32.SP, 32)
	return ffSameBytes(a, ref, "homed float32 alloca load must be exactly VLDR.32 S16,[SP,#32]")
}

// An FP-homed float64 loaded through a pointer takes emitLoad's 64-bit route and
// is one VLDR.64 D8,[R1] — not LDR/LDR + VMOV into the home.
func TestPlainFloat64LoadPointerToHome() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = fmPlainMap(-1)
	ffHome(m, 100, arm32.R1)
	ffHome(m, 102, arm32.D8)
	emitLoad(a, "main", m, fmPlainLoad(fmPtr(types.TypFloat64(), false), types.TypFloat64()))
	var ref @asm.Assembler = ffMkAsm()
	arm32.Vldr64(ref, arm32.COND_AL, arm32.D8, arm32.R1, 0)
	return ffSameBytes(a, ref, "homed float64 pointer load must be exactly VLDR.64 D8,[R1]")
}

// An FP-homed float32 stored through a pointer is one VSTR.32 S18,[R1].
func TestPlainFloat32StorePointerFromHome() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = fmPlainMap(-1)
	ffHome(m, 100, arm32.R1)
	ffHome(m, 103, arm32.D9)
	emitStore(a, "main", m, fmPlainStore(fmPtr(types.TypFloat32(), false), types.TypFloat32()))
	var ref @asm.Assembler = ffMkAsm()
	arm32.Vstr32(ref, arm32.COND_AL, arm32.S18, arm32.R1, 0)
	return ffSameBytes(a, ref, "homed float32 pointer store must be exactly VSTR.32 S18,[R1]")
}

// An FP-homed float64 stored to an alloca past VSTR's 1020 reach materializes the
// address in IP: IP = SP + 2000; VSTR.64 D9,[IP].
func TestPlainFloat64StoreAllocaLargeOffsetFromHome() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = fmPlainMap(2000)
	ffHome(m, 103, arm32.D9)
	emitStore(a, "main", m, fmPlainStore(fmPtr(types.TypFloat64(), true), types.TypFloat64()))
	var ref @asm.Assembler = ffMkAsm()
	emitAddImm(ref, arm32.IP, arm32.SP, 2000, arm32.IP)
	arm32.Vstr64(ref, arm32.COND_AL, arm32.D9, arm32.IP, 0)
	return ffSameBytes(a, ref, "large-offset homed float64 store must be IP=SP+2000; VSTR.64 D9,[IP]")
}

// A float whose value is NOT FP-homed (spilled, or soft-float) keeps the GP path:
// the helpers decline, and emitLoad emits LDR R4,[R1] into a pool register.
func TestPlainFloatUnhomedKeepsGpPath() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = fmPlainMap(-1)
	ffHome(m, 100, arm32.R1)
	ffSpill(m, 102, 48)
	var ld @ir.Instr = fmPlainLoad(fmPtr(types.TypFloat32(), false), types.TypFloat32())
	if emitFloatLoadToHome(a, "main", m, ld, ld.Args[0]) {
		return "an unhomed float load must not take the FP-home path"
	}
	if ffBytes(a) != 0 { return "declining must emit nothing" }
	emitLoad(a, "main", m, ld)
	var ref @asm.Assembler = ffMkAsm()
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.R1, 0))
	return ffSameBytes(a, ref, "unhomed float32 pointer load must be exactly LDR R4,[R1]")
}
