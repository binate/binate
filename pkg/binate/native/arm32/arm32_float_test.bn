package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for soft-float lowering (arm32_float.bn / arm32_float_cast.bn):
// classification, const materialization, and the AEABI helper each compute op
// references.  The register marshaling is exercised end-to-end by the float
// conformance suite; here we assert the CORRECT __aeabi_* symbol (the one bug
// that would silently miscompile — e.g. calling fadd for a subtract, or fcmpeq
// for a `<`).  Shared builders (rm64 / bin64 / un64 / mkAsm) live in the int64
// test files; a float value uses the same 8-byte pair slots.

// castFloat builds an OP_CAST instr from srcTyp (operand id 10, slot 0) to
// dstTyp (result id 0, slot 16), the shape emitFloatCast reads.
func castFloat(srcTyp @types.Type, dstTyp @types.Type) @ir.Instr {
	var s @ir.Instr = make(ir.Instr)
	s.ID = 10
	s.Typ = srcTyp
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, s)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CAST
	ins.Typ = dstTyp
	ins.TypeArg = dstTyp
	ins.Args = args
	return ins
}

// constFloat builds an OP_CONST_FLOAT instr (result id 0, slot 16) of type typ.
func constFloat(text @[]char, typ @types.Type) @ir.Instr {
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CONST_FLOAT
	ins.Typ = typ
	ins.StrVal = text
	return ins
}

// ============================================================
// Classification
// ============================================================

// instrIsFloat claims a float-result arithmetic op and a float-operand compare,
// but NOT their integer counterparts (those route to the int32 / int64 paths).
func TestInstrIsFloatClassifies() testing.TestResult {
	if !instrIsFloat(bin64(iropcode.OP_ADD, types.TypFloat64())) {
		return fail("a float64 OP_ADD must classify as a float op")
	}
	if !instrIsFloat(bin64(iropcode.OP_ADD, types.TypFloat32())) {
		return fail("a float32 OP_ADD must classify as a float op")
	}
	if instrIsFloat(bin64(iropcode.OP_ADD, types.TypInt64())) {
		return fail("an int64 OP_ADD must NOT classify as a float op")
	}
	if !instrIsFloat(bin64(iropcode.OP_LT, types.TypFloat64())) {
		return fail("a compare on float operands must classify as a float op")
	}
	if !instrIsFloat(constFloat("1.5", types.TypFloat64())) {
		return fail("OP_CONST_FLOAT must classify as a float op")
	}
	return ""
}

// A float64↔int64 cast classifies as float (routes to the AEABI convert
// helpers), NOT to the integer-pair path which cannot convert.
func TestInstrIsFloatClaimsInt64FloatCast() testing.TestResult {
	if !instrIsFloat(castFloat(types.TypInt64(), types.TypFloat64())) {
		return fail("int64->float64 cast must classify as a float op")
	}
	if !instrIsFloat(castFloat(types.TypFloat64(), types.TypInt64())) {
		return fail("float64->int64 cast must classify as a float op")
	}
	return ""
}

// ============================================================
// Constant
// ============================================================

// A float64 const stores BOTH pair words (store64), recording no single result
// register — so the following spillAndReset is inert.
func TestConstFloat64StoresPair() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	if !emitInstrFloat(a, "main", rm, constFloat("0.5", types.TypFloat64())) {
		return fail("emitInstrFloat must handle a float64 OP_CONST_FLOAT")
	}
	if rm.LookupReg(0) >= 0 {
		return fail("a float64 const must not register a single result reg")
	}
	return ""
}

// A float32 const materializes a single word registered via nextReg (spilled by
// the following spillAndReset), so LookupReg finds it.
func TestConstFloat32RegistersSingle() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	if !emitInstrFloat(a, "main", rm, constFloat("0.5", types.TypFloat32())) {
		return fail("emitInstrFloat must handle a float32 OP_CONST_FLOAT")
	}
	if rm.LookupReg(0) < 0 {
		return fail("a float32 const must register a single result reg")
	}
	return ""
}

// ============================================================
// Arithmetic — the AEABI helper per op / width
// ============================================================

// binopRefsHelper emits a float binop of the given op/type and reports whether
// the expected AEABI symbol was referenced.
func binopRefsHelper(op int, typ @types.Type, sym *[]readonly char) bool {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	if !emitInstrFloat(a, "main", rm, bin64(op, typ)) { return false }
	return a.LookupSymbol(sym) >= 0
}

// float64 arithmetic references __aeabi_d{add,sub,mul,div}.
func TestFloat64ArithHelpers() testing.TestResult {
	if !binopRefsHelper(iropcode.OP_ADD, types.TypFloat64(), "__aeabi_dadd") {
		return fail("float64 ADD must reference __aeabi_dadd")
	}
	if !binopRefsHelper(iropcode.OP_SUB, types.TypFloat64(), "__aeabi_dsub") {
		return fail("float64 SUB must reference __aeabi_dsub")
	}
	if !binopRefsHelper(iropcode.OP_MUL, types.TypFloat64(), "__aeabi_dmul") {
		return fail("float64 MUL must reference __aeabi_dmul")
	}
	if !binopRefsHelper(iropcode.OP_DIV, types.TypFloat64(), "__aeabi_ddiv") {
		return fail("float64 DIV must reference __aeabi_ddiv")
	}
	return ""
}

// float32 arithmetic references __aeabi_f{add,sub,mul,div}.
func TestFloat32ArithHelpers() testing.TestResult {
	if !binopRefsHelper(iropcode.OP_ADD, types.TypFloat32(), "__aeabi_fadd") {
		return fail("float32 ADD must reference __aeabi_fadd")
	}
	if !binopRefsHelper(iropcode.OP_SUB, types.TypFloat32(), "__aeabi_fsub") {
		return fail("float32 SUB must reference __aeabi_fsub")
	}
	if !binopRefsHelper(iropcode.OP_MUL, types.TypFloat32(), "__aeabi_fmul") {
		return fail("float32 MUL must reference __aeabi_fmul")
	}
	if !binopRefsHelper(iropcode.OP_DIV, types.TypFloat32(), "__aeabi_fdiv") {
		return fail("float32 DIV must reference __aeabi_fdiv")
	}
	return ""
}

// ============================================================
// Compare — the AEABI helper per op; NE folds to fcmpeq
// ============================================================

// cmpRefsHelper emits a float compare and reports whether the expected AEABI
// symbol was referenced.
func cmpRefsHelper(op int, typ @types.Type, sym *[]readonly char) bool {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	if !emitInstrFloat(a, "main", rm, bin64(op, typ)) { return false }
	return a.LookupSymbol(sym) >= 0
}

// The five ordered float64 relations map to __aeabi_dcmp{eq,lt,le,gt,ge}.
func TestFloat64CompareHelpers() testing.TestResult {
	if !cmpRefsHelper(iropcode.OP_EQ, types.TypFloat64(), "__aeabi_dcmpeq") {
		return fail("float64 EQ must reference __aeabi_dcmpeq")
	}
	if !cmpRefsHelper(iropcode.OP_LT, types.TypFloat64(), "__aeabi_dcmplt") {
		return fail("float64 LT must reference __aeabi_dcmplt")
	}
	if !cmpRefsHelper(iropcode.OP_LE, types.TypFloat64(), "__aeabi_dcmple") {
		return fail("float64 LE must reference __aeabi_dcmple")
	}
	if !cmpRefsHelper(iropcode.OP_GT, types.TypFloat64(), "__aeabi_dcmpgt") {
		return fail("float64 GT must reference __aeabi_dcmpgt")
	}
	if !cmpRefsHelper(iropcode.OP_GE, types.TypFloat64(), "__aeabi_dcmpge") {
		return fail("float64 GE must reference __aeabi_dcmpge")
	}
	return ""
}

// float32 relations map to __aeabi_fcmp{eq,lt}; NE folds to fcmpeq (the
// unordered complement is realized by the inverted 0/1 normalization, so no
// separate "fcmpne" helper exists).
func TestFloat32CompareHelpers() testing.TestResult {
	if !cmpRefsHelper(iropcode.OP_EQ, types.TypFloat32(), "__aeabi_fcmpeq") {
		return fail("float32 EQ must reference __aeabi_fcmpeq")
	}
	if !cmpRefsHelper(iropcode.OP_LT, types.TypFloat32(), "__aeabi_fcmplt") {
		return fail("float32 LT must reference __aeabi_fcmplt")
	}
	if !cmpRefsHelper(iropcode.OP_NE, types.TypFloat32(), "__aeabi_fcmpeq") {
		return fail("float32 NE must reference __aeabi_fcmpeq (folded, then inverted)")
	}
	return ""
}

// ============================================================
// Negate — sign-bit flip, no libcall
// ============================================================

// Float negate references NO AEABI helper (it is a pure sign-bit EOR); it also
// must not SetError.
func TestFloatNegNoLibcall() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	if !emitInstrFloat(a, "main", rm, un64(iropcode.OP_NEG, types.TypFloat64())) {
		return fail("emitInstrFloat must handle a float64 OP_NEG")
	}
	if a.HasError {
		return fail("float64 NEG must not SetError")
	}
	if a.LookupSymbol("__aeabi_dneg") >= 0 {
		return fail("float NEG must be an inline sign flip, not a libcall")
	}
	return ""
}

// ============================================================
// bit_cast — same-size reinterpret, no libcall
// ============================================================

// A float bit_cast references NO AEABI helper (soft-float bits already ride GP)
// and does not SetError; the 64-bit form copies the pair, the 32-bit form MOVs.
func TestFloatBitCastNoLibcall() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = castFloat(types.TypFloat64(), types.TypInt64())
	ins.Op = iropcode.OP_BIT_CAST
	if !emitInstrFloat(a, "main", rm, ins) {
		return fail("emitInstrFloat must handle a float64 bit_cast")
	}
	if a.HasError {
		return fail("float64<->int64 bit_cast must not SetError")
	}
	return ""
}

// ============================================================
// Fail-loud
// ============================================================

// A float binop whose operands have no spill slot (empty RegMap) and a non-const
// Op must fail LOUDLY (SetError) rather than emit a call on garbage registers.
func TestFloatBinopUnmaterializableOperandSetsError() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32()) // no spill slots
	var ins @ir.Instr = bin64(iropcode.OP_ADD, types.TypFloat64())
	ins.Args[0].Op = iropcode.OP_ADD
	ins.Args[1].Op = iropcode.OP_ADD
	if !emitInstrFloat(a, "main", rm, ins) {
		return fail("emitInstrFloat must claim a float64 OP_ADD")
	}
	if !a.HasError {
		return fail("float binop on an unmaterializable operand must SetError")
	}
	return ""
}
