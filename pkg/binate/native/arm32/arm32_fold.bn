package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/native/fold"

// arm32ImmPosMax and arm32ImmNegMin bound the constants the immediate fold
// carries in an operand2 modified immediate — the CMP/CMN compare immediate and
// the ADD/SUB immediate alike: 0..255 rides directly, and -255..-1 rides the
// sign-swapped form (CMN, or SUB for ADD / ADD for SUB).  Every magnitude in
// 0..255 is a valid rotation-0 modified immediate, so the emitters' bare
// arm32.Imm forms always encode; larger encodable modified immediates (rotated
// 8-bit values) stay unfolded at these positions.  arm32CmpImm and
// arm32AddSubImm read these, so arm32ImmFits and the compare and add/sub fold
// emitters agree on the range.  The AND/ORR/EOR fold is not bounded by them: it
// takes any modified immediate (see arm32LogicImm).
const arm32ImmPosMax int64 = 255

// arm32ImmNegMin is the most negative constant the immediate fold carries (see
// arm32ImmPosMax).
const arm32ImmNegMin int64 = -255

// arm32ImmWordBytes is the word size the immediate-fold position rules take on
// this ILP32 target: an operand or result wider than one 32-bit register
// (int64 / uint64, a register pair) has no single-register immediate form.
const arm32ImmWordBytes int = 4

// arm32CmpImm returns (value, true) iff operand argIdx of `user` is a constant in
// a compare-RHS position (fold.CmpImmOperand) whose value fits the CMP/CMN
// immediate range.  arm32ImmFits and emitCmpAgainst both decide through it, so
// the analysis and the emitter cannot disagree.
func arm32CmpImm(user @ir.Instr, argIdx int) (int64, bool) {
	var v int64
	var isUns bool
	var ok bool
	v, isUns, ok = fold.CmpImmOperand(user, argIdx, arm32ImmWordBytes)
	if !ok || !fold.CmpImmFits(v, isUns, arm32ImmPosMax, arm32ImmNegMin) {
		return cast(int64, 0), false
	}
	return v, true
}

// arm32AddSubImm returns (value, true) iff operand argIdx of `user` is a constant
// in an add/sub-immediate position (fold.AddSubImmOperand) whose value fits the
// ADD/SUB immediate range.  arm32ImmFits and emitAddSubImmFoldArm32 both decide
// through it.
func arm32AddSubImm(user @ir.Instr, argIdx int) (int64, bool) {
	var v int64
	var ok bool
	v, ok = fold.AddSubImmOperand(user, argIdx, arm32ImmWordBytes)
	if !ok || !fold.AddSubImmFits(v, arm32ImmPosMax, arm32ImmNegMin) {
		return cast(int64, 0), false
	}
	return v, true
}

// arm32LogicFormAnd is the arm32LogicImm form `and rd, rn, #imm`: an AND whose
// constant's 32-bit pattern is a modified immediate (imm is that pattern).
const arm32LogicFormAnd int = 1

// arm32LogicFormOrr is the arm32LogicImm form `orr rd, rn, #imm`: an OR whose
// constant's 32-bit pattern is a modified immediate (imm is that pattern).
const arm32LogicFormOrr int = 2

// arm32LogicFormEor is the arm32LogicImm form `eor rd, rn, #imm`: an XOR whose
// constant's 32-bit pattern is a modified immediate (imm is that pattern).
const arm32LogicFormEor int = 3

// arm32LogicFormBic is the arm32LogicImm form `bic rd, rn, #imm`: an AND whose
// constant's 32-bit pattern c is not a modified immediate but whose complement
// ~c is (x & c is x & ~(~c), the BIC operation), and imm is that complement.
const arm32LogicFormBic int = 4

// arm32LogicFormMvn is the arm32LogicImm form `mvn rd, rn`: an XOR whose
// constant's 32-bit pattern is all ones (x ^ 0xFFFFFFFF is ~x), which takes no
// immediate (imm is 0).
const arm32LogicFormMvn int = 5

// arm32LogicImm returns (form, imm, true) iff operand argIdx of `user` is a
// constant in a bitwise-logic position (fold.LogicImmOperand) that one
// register-and-immediate instruction can carry; form is one of the
// arm32LogicForm* constants and imm is the modified immediate that form encodes.
// The decision is made on the constant's 32-bit pattern — the low 32 bits of
// its value, exactly what emitConstInt32 would materialize for the register
// form — so the folded instruction computes the same register bits:
//   - AND takes the pattern as an AND immediate when it is a modified immediate
//     (an 8-bit value rotated right by an even amount, arm32.EncodeRotImm), else
//     its complement as a BIC immediate when that is one;
//   - OR takes the pattern as an ORR immediate when it is a modified immediate
//     (arm32 has no ORN, so no complemented form);
//   - XOR with the all-ones pattern is MVN of the register; any other pattern
//     rides an EOR immediate when it is a modified immediate.
// imm is non-negative (0..2^32-1 where int is wider than 32 bits), within the
// data-processing immediate range the assembler checks.  When ok is false,
// form and imm are 0, which names no form.  arm32ImmFits and
// emitLogicImmFoldArm32 both decide through it.
func arm32LogicImm(user @ir.Instr, argIdx int) (int, int, bool) {
	var v int64
	var ok bool
	v, ok = fold.LogicImmOperand(user, argIdx, arm32ImmWordBytes)
	if !ok { return 0, 0, false }
	var allOnes uint32 = cast(uint32, 0xFFFFFFFF)
	var pat uint32 = cast(uint32, v)
	var v32 int = cast(int, pat)
	var ri arm32.RotImmResult = arm32.EncodeRotImm(v32)
	var enc bool = ri.Ok
	if user.Op == iropcode.OP_AND {
		if enc { return arm32LogicFormAnd, v32, true }
		var inv int = cast(int, pat ^ allOnes)
		var riInv arm32.RotImmResult = arm32.EncodeRotImm(inv)
		if riInv.Ok { return arm32LogicFormBic, inv, true }
		return 0, 0, false
	}
	if user.Op == iropcode.OP_OR {
		if enc { return arm32LogicFormOrr, v32, true }
		return 0, 0, false
	}
	// fold.LogicImmOperand admits only AND, OR and XOR, so this is the XOR.
	if pat == allOnes { return arm32LogicFormMvn, 0, true }
	if enc { return arm32LogicFormEor, v32, true }
	return 0, 0, false
}

// arm32ImmFits is the predicate this backend hands fold.ImmOperandConsts:
// operand argIdx of `user` may ride an immediate iff it is a compare RHS that
// fits CMP/CMN (arm32CmpImm), an ADD/SUB operand that fits ADD/SUB
// (arm32AddSubImm), or an AND/OR/XOR operand one AND/BIC/ORR/EOR/MVN carries
// (arm32LogicImm) — the same helpers the consuming emitters re-check with.
func arm32ImmFits(user @ir.Instr, argIdx int) bool {
	var ok bool
	_, ok = arm32CmpImm(user, argIdx)
	if ok { return true }
	_, ok = arm32AddSubImm(user, argIdx)
	if ok { return true }
	_, _, ok = arm32LogicImm(user, argIdx)
	return ok
}

// isFoldedImmArm32 reports whether operand `arg` is an OP_CONST_INT the fold
// marked to ride an immediate (IsFoldedImm) — so it was left unhomed and
// skip-emitted, and must be consumed as an immediate, never via getOperand.
func isFoldedImmArm32(rm @common.RegMap, arg @ir.Instr) bool {
	return arg != nil && arg.Op == iropcode.OP_CONST_INT && rm.IsFoldedImm(arg.ID)
}

// emitAddSubImmFoldArm32 lowers an OP_ADD / OP_SUB with a constant operand the
// fold marked (IsFoldedImm): the constant rides the ADD/SUB operand2 immediate
// (`add`/`sub rd, rn, #v`).  arm32 modified immediates are UNSIGNED, so a small
// negative is folded by swapping the operation (x + (-k) ≡ x - k, x - (-k) ≡
// x + k); |v| <= arm32ImmPosMax is always a valid rotation-0 modified immediate,
// so the bare arm32.Add/Sub immediate form is safe.  ADD is commutative so the
// constant may be either operand (the other supplies the register addend); SUB
// folds only its subtrahend (Args[1]).  A sub-word result is re-narrowed exactly
// as the register path does, so the folded result is bit-identical.
//
// Returns false when neither operand is a folded constant, leaving emitBinop's
// register path to run.  Once a folded constant is present the register path
// must not run (it would read the never-materialized constant), so every other
// outcome returns true: the folded constant is re-checked with arm32AddSubImm —
// the helper arm32ImmFits uses — and a constant that does not fit this position
// (a minuend, a const+const pair, a wide result, an out-of-range value) fails
// loud via a.SetError, as does an unmaterializable register operand.
func emitAddSubImmFoldArm32(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_ADD && ins.Op != iropcode.OP_SUB { return false }
	if len(ins.Args) != 2 { return false }
	var c0 bool = isFoldedImmArm32(rm, ins.Args[0])
	var c1 bool = isFoldedImmArm32(rm, ins.Args[1])
	if !c0 && !c1 { return false }

	// The constant is the RHS when that is folded, else the LHS; the other operand
	// supplies the register.
	var ci int = 1
	if !c1 { ci = 0 }
	var cval int64
	var ok bool
	cval, ok = arm32AddSubImm(ins, ci)
	if !ok {
		a.SetError("native arm32: folded immediate does not fit the ADD/SUB operand")
		return true
	}
	var reg int = getOperand(a, rm, ins.Args[1 - ci].ID)
	if reg < 0 {
		a.SetError("native arm32: ADD/SUB register operand not materializable")
		return true
	}
	var rd int = nextReg(rm, ins.ID)

	var doAdd bool = ins.Op == iropcode.OP_ADD
	var mag int64 = cval
	if cval < cast(int64, 0) {
		doAdd = !doAdd
		mag = cast(int64, 0) - cval
	}
	if doAdd {
		arm32.Add(a, arm32.COND_AL, false, rd, reg, arm32.Imm(cast(int, mag)))
	} else {
		arm32.Sub(a, arm32.COND_AL, false, rd, reg, arm32.Imm(cast(int, mag)))
	}
	emitSubWordNarrow(a, rd, ins.Typ)
	return true
}

// emitLogicImmFoldArm32 lowers an OP_AND / OP_OR / OP_XOR with a constant operand
// the fold marked (IsFoldedImm): the constant rides the operand2 immediate of the
// form arm32LogicImm picks — `and`/`bic`/`orr`/`eor rd, rn, #imm`, or `mvn rd,
// rn` for an XOR with all ones.  All three ops are commutative, so the constant
// may be either operand (the other supplies the register).  A sub-word result is
// re-narrowed exactly as the register path does, so the folded result is
// bit-identical.
//
// Returns false when neither operand is a folded constant, leaving emitBinop's
// register path to run.  Once a folded constant is present the register path
// must not run (it would read the never-materialized constant), so every other
// outcome returns true: the folded constant is re-checked with arm32LogicImm —
// the helper arm32ImmFits uses — and a constant that does not fit this position
// (a const-const pair, a wide result, a pattern no form carries) fails loud via
// a.SetError, as does an unmaterializable register operand.
func emitLogicImmFoldArm32(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_AND && ins.Op != iropcode.OP_OR && ins.Op != iropcode.OP_XOR {
		return false
	}
	if len(ins.Args) != 2 { return false }
	var c0 bool = isFoldedImmArm32(rm, ins.Args[0])
	var c1 bool = isFoldedImmArm32(rm, ins.Args[1])
	if !c0 && !c1 { return false }

	// The constant is the RHS when that is folded, else the LHS; the other operand
	// supplies the register.
	var ci int = 1
	if !c1 { ci = 0 }
	var form int
	var imm int
	var ok bool
	form, imm, ok = arm32LogicImm(ins, ci)
	if !ok {
		a.SetError("native arm32: folded immediate does not fit the AND/ORR/EOR operand")
		return true
	}
	var reg int = getOperand(a, rm, ins.Args[1 - ci].ID)
	if reg < 0 {
		a.SetError("native arm32: AND/ORR/EOR register operand not materializable")
		return true
	}
	var rd int = nextReg(rm, ins.ID)

	switch form {
	case arm32LogicFormAnd:
		arm32.And(a, arm32.COND_AL, false, rd, reg, arm32.Imm(imm))
	case arm32LogicFormBic:
		arm32.Bic(a, arm32.COND_AL, false, rd, reg, arm32.Imm(imm))
	case arm32LogicFormOrr:
		arm32.Orr(a, arm32.COND_AL, false, rd, reg, arm32.Imm(imm))
	case arm32LogicFormEor:
		arm32.Eor(a, arm32.COND_AL, false, rd, reg, arm32.Imm(imm))
	case arm32LogicFormMvn:
		arm32.Mvn(a, arm32.COND_AL, false, rd, arm32.Reg(reg))
	default:
		a.SetError("native arm32: unknown AND/ORR/EOR immediate form")
		return true
	}
	emitSubWordNarrow(a, rd, ins.Typ)
	return true
}

// ============================================================
// Fold-candidate marking
// ============================================================

// markFoldCandidates sets rm's fold flag sets for f.  emitFunc calls it BEFORE
// register allocation, so the allocator leaves every flagged value — one whose
// result is never read as a register — unhomed, and the dispatch skips its
// standalone emission.
func markFoldCandidates(f @ir.Func, rm @common.RegMap) {
	// With wordBytes=4, int64 register-pair GEPs / pair-compares are excluded.  A
	// field GEP folds into a load/store's immediate offset
	// (emitGetFieldPtr skips it; the access rederives the address inline), and a
	// 32-bit integer compare folds into its consuming conditional branch (a
	// flag-setting CMP + conditional B, no 0/1 boolean materialized).
	rm.FusableFieldGep = fieldFoldSet(f)
	rm.FusedCmp = fold.BranchFusedCmps(f, 4)
	// Flag integer constants whose every use is an immediate operand that fits
	// (arm32ImmFits): a compare RHS riding the CMP/CMN immediate, or an ADD/SUB
	// operand riding the ADD/SUB immediate, each within arm32ImmPosMax /
	// arm32ImmNegMin (every such magnitude is a valid rotation-0 modified
	// immediate); or an AND/OR/XOR operand riding an AND/BIC/ORR/EOR modified
	// immediate (or an MVN for an XOR with all ones); each no wider than a 32-bit
	// register.  The compare / add-sub / logic emitters take a flagged constant
	// as an immediate.
	rm.FoldedImm = fold.ImmOperandConsts(f, arm32ImmFits)
}
