package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"

// isFoldedAddConstArm32 reports whether operand `arg` is an OP_CONST_INT the fold
// marked to ride an add/sub immediate (FoldedAddImmConst) — so it was left
// unhomed and skip-emitted, and must be consumed as an immediate, never via
// getOperand (which would return -1).
func isFoldedAddConstArm32(rm @common.RegMap, arg @ir.Instr) bool {
	return arg != nil && arg.Op == iropcode.OP_CONST_INT && rm.IsFoldedAddImmConst(arg.ID)
}

// emitAddSubImmFoldArm32 lowers an OP_ADD / OP_SUB whose constant operand was
// marked FoldedAddImmConst: the constant rides the ADD/SUB operand2 immediate
// (`add`/`sub rd, rn, #v`).  arm32 modified immediates are UNSIGNED, so a small
// negative is folded by swapping the operation (x + (-k) ≡ x - k, x - (-k) ≡
// x + k) — the fold analysis bounds |cval| to 0..255, always a valid rotation-0
// modified immediate, so the bare arm32.Add/Sub immediate form is safe (no
// EncodeRotImm fallback needed).  ADD is commutative so the constant may be
// either operand (the other supplies the register addend); SUB folds only its
// subtrahend (Args[1]).  A sub-word result is re-narrowed exactly as the register
// path does, so the folded result is bit-identical.  Returns false when neither
// operand is a folded constant, leaving emitBinop's register path to run.
func emitAddSubImmFoldArm32(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_ADD && ins.Op != iropcode.OP_SUB { return false }
	if len(ins.Args) != 2 { return false }
	var c0 bool = isFoldedAddConstArm32(rm, ins.Args[0])
	var c1 bool = isFoldedAddConstArm32(rm, ins.Args[1])
	// SUB folds only its subtrahend; the analysis never marks a minuend, so with
	// c1 false there is nothing here to fold — defer to the register path.
	if ins.Op == iropcode.OP_SUB && !c1 { return false }
	if !c0 && !c1 { return false }

	// The register operand is the non-constant one; the analysis guarantees at most
	// one operand is marked (it requires the sibling to be a non-constant).
	var regArg @ir.Instr = ins.Args[0]
	var cval int64 = 0
	if c1 {
		cval = ins.Args[1].IntVal
	} else {
		regArg = ins.Args[1]
		cval = ins.Args[0].IntVal
	}
	var reg int = getOperand(a, rm, regArg.ID)
	if reg < 0 { return false }
	var rd int = nextReg(rm, ins.ID)

	var doAdd bool = ins.Op == iropcode.OP_ADD
	var mag int64 = cval
	if cval < cast(int64, 0) {
		doAdd = !doAdd
		mag = cast(int64, 0) - cval
	}
	if doAdd {
		arm32.Add(a, arm32.COND_AL, false, rd, reg, arm32.Imm(cast(int, mag)))
	} else {
		arm32.Sub(a, arm32.COND_AL, false, rd, reg, arm32.Imm(cast(int, mag)))
	}
	emitSubWordNarrow(a, rd, ins.Typ)
	return true
}
