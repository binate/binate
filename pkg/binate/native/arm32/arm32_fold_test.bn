package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/native/fold"
import "pkg/binate/types"
import "pkg/builtins/testing"

// arm32FoldAddSubAsm builds an ADD/SUB `ins` of result type `rt` over an int32
// register-resident operand (R5) and an int32 FoldedImm constant `cval`, placing
// the const at argIdx (0 or 1), emits it through emitBinop, and returns the
// assembler.
func arm32FoldAddSubAsm(op int, cval int64, argIdx int, rt @types.Type) @asm.Assembler {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AssignReg(10, 5) // R5
	var reg @ir.Instr = make(ir.Instr)
	reg.ID = 10
	reg.Op = iropcode.OP_PARAM // a non-constant (the zero Op is OP_CONST_INT)
	reg.Typ = types.TypInt32()
	var c @ir.Instr = make(ir.Instr)
	c.ID = 11
	c.Op = iropcode.OP_CONST_INT
	c.Typ = types.TypInt32()
	c.IntVal = cval
	var fc @[]bool = make_slice(bool, 12)
	fc[11] = true
	rm.FoldedImm = fc
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = op
	ins.Typ = rt
	ins.Args = make_slice(@ir.Instr, 2)
	if argIdx == 0 {
		ins.Args[0] = c
		ins.Args[1] = reg
	} else {
		ins.Args[0] = reg
		ins.Args[1] = c
	}
	_ = emitBinop(a, rm, ins)
	return a
}

// arm32FoldAddSub is arm32FoldAddSubAsm at int32, returning the leading
// instruction word (the register operand is resident, so the ADD/SUB is the
// first instruction).
func arm32FoldAddSub(op int, cval int64, argIdx int) uint32 {
	return word32(arm32FoldAddSubAsm(op, cval, argIdx, types.TypInt32()), 0)
}

// arm32ImmBitSet reports whether the DP instruction's I (immediate) bit (25) is set.
func arm32ImmBitSet(w uint32) bool {
	return ((w >> cast(uint32, 25)) & cast(uint32, 1)) == cast(uint32, 1)
}

// arm32DpOpcode extracts the data-processing opcode field (bits [24:21]):
// ADD = 0b0100 = 4, SUB = 0b0010 = 2.
func arm32DpOpcode(w uint32) uint32 {
	return (w >> cast(uint32, 21)) & cast(uint32, 0xF)
}

// arm32HasSubstr reports whether `sub` occurs in `s`.
func arm32HasSubstr(s *[]readonly char, sub *[]readonly char) bool {
	for i := 0; i + len(sub) <= len(s); i++ {
		var match bool = true
		for j := 0; j < len(sub); j++ {
			if s[i + j] != sub[j] {
				match = false
				break
			}
		}
		if match { return true }
	}
	return false
}

// A folded ADD constant (RHS) rides the modified-immediate operand: I bit set,
// opcode ADD (4).
func TestArm32AddImmFoldRhsEmitsImm() testing.TestResult {
	var w uint32 = arm32FoldAddSub(iropcode.OP_ADD, cast(int64, 5), 1)
	if !arm32ImmBitSet(w) { return "a folded ADD const must set the I (immediate) bit" }
	if arm32DpOpcode(w) != cast(uint32, 4) { return "a folded ADD must keep the ADD opcode (4)" }
	return ""
}

// ADD is commutative: a folded constant on the LHS folds too.
func TestArm32AddImmFoldLhsCommutes() testing.TestResult {
	var w uint32 = arm32FoldAddSub(iropcode.OP_ADD, cast(int64, 7), 0)
	if !arm32ImmBitSet(w) { return "a folded ADD const on the LHS must set the I bit" }
	if arm32DpOpcode(w) != cast(uint32, 4) {
		return "a commuted folded ADD must keep the ADD opcode (4)"
	}
	return ""
}

// A folded SUB subtrahend rides the immediate: I bit set, opcode SUB (2).
func TestArm32SubImmFoldSubtrahend() testing.TestResult {
	var w uint32 = arm32FoldAddSub(iropcode.OP_SUB, cast(int64, 5), 1)
	if !arm32ImmBitSet(w) { return "a folded SUB subtrahend must set the I bit" }
	if arm32DpOpcode(w) != cast(uint32, 2) { return "a folded SUB must keep the SUB opcode (2)" }
	return ""
}

// A small negative ADD constant sign-swaps to SUB (arm32 modified immediates are
// unsigned): I bit set, opcode SUB (2).
func TestArm32AddImmFoldNegativeEmitsSub() testing.TestResult {
	var w uint32 = arm32FoldAddSub(iropcode.OP_ADD, cast(int64, 0) - cast(int64, 5), 1)
	if !arm32ImmBitSet(w) { return "x + (-5) must set the I bit" }
	if arm32DpOpcode(w) != cast(uint32, 2) {
		return "x + (-5) must sign-swap to the SUB opcode (2)"
	}
	return ""
}

// The range edges ride the immediate: +255 and -255 (sign-swapped) both fold.
func TestArm32AddImmFoldRangeEdges() testing.TestResult {
	var a @asm.Assembler = arm32FoldAddSubAsm(iropcode.OP_ADD, arm32ImmPosMax, 1, types.TypInt32())
	if a.HasError { return "x + 255 is in range and must fold without error" }
	if !arm32ImmBitSet(word32(a, 0)) { return "x + 255 must set the I bit" }
	var b @asm.Assembler = arm32FoldAddSubAsm(iropcode.OP_SUB, arm32ImmNegMin, 1, types.TypInt32())
	if b.HasError { return "x - (-255) is in range and must fold without error" }
	if arm32DpOpcode(word32(b, 0)) != cast(uint32, 4) {
		return "x - (-255) must sign-swap to the ADD opcode (4)"
	}
	return ""
}

// A FoldedImm ADD/SUB constant that does not fit its position fails loud and
// encodes nothing — an out-of-range value, a SUB minuend, or a result wider than
// the 32-bit word — rather than silently encoding a wrong immediate or reading
// the never-materialized constant through the register path.
func TestArm32AddImmFoldMisfitFailsLoud() testing.TestResult {
	var over @asm.Assembler = arm32FoldAddSubAsm(iropcode.OP_ADD, cast(int64, 256), 1,
			types.TypInt32())
	if !over.HasError { return "a folded ADD constant of 256 must SetError" }
	if !arm32HasSubstr(over.ErrorMsg, "folded immediate does not fit") {
		return "the misfit error must name the folded immediate"
	}
	if bytesWritten(over) != 0 { return "a misfit folded ADD constant must encode nothing" }
	var minuend @asm.Assembler = arm32FoldAddSubAsm(iropcode.OP_SUB, cast(int64, 5), 0,
			types.TypInt32())
	if !minuend.HasError { return "a folded SUB minuend must SetError" }
	if bytesWritten(minuend) != 0 { return "a folded SUB minuend must encode nothing" }
	var i64 @types.Type = types.TypInt64()
	var wide @asm.Assembler = arm32FoldAddSubAsm(iropcode.OP_ADD, cast(int64, 5), 1, i64)
	if !wide.HasError { return "a folded constant in an int64 ADD must SetError" }
	if bytesWritten(wide) != 0 { return "a folded int64 ADD constant must encode nothing" }
	return ""
}

// arm32FoldCmpAsm builds `lhs OP #cval` with a register-resident LHS (R5) of type
// ot and a FoldedImm constant RHS, emits it through emitCompare, and returns the
// assembler.
func arm32FoldCmpAsm(op int, ot @types.Type, cval int64) @asm.Assembler {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AssignReg(10, 5) // R5
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 10
	lhs.Op = iropcode.OP_PARAM // a non-constant (the zero Op is OP_CONST_INT)
	lhs.Typ = ot
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 11
	rhs.Op = iropcode.OP_CONST_INT
	rhs.Typ = ot
	rhs.IntVal = cval
	var fc @[]bool = make_slice(bool, 12)
	fc[11] = true
	rm.FoldedImm = fc
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = op
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	_ = emitCompare(a, "main", rm, ins)
	return a
}

// A FoldedImm compare constant that does not fit fails loud and encodes nothing:
// an out-of-range value, a negative in an unsigned compare (a near-2^32 value
// CMN cannot carry), or a compare wider than the 32-bit word.
func TestArm32CmpImmFoldMisfitFailsLoud() testing.TestResult {
	var over @asm.Assembler = arm32FoldCmpAsm(iropcode.OP_LT, types.TypInt32(), cast(int64, 256))
	if !over.HasError { return "a folded compare constant of 256 must SetError" }
	if !arm32HasSubstr(over.ErrorMsg, "folded immediate does not fit") {
		return "the misfit error must name the folded immediate"
	}
	if bytesWritten(over) != 0 { return "a misfit folded compare constant must encode nothing" }
	var uneg @asm.Assembler = arm32FoldCmpAsm(iropcode.OP_LT, types.TypUint32(),
			cast(int64, 0) - cast(int64, 5))
	if !uneg.HasError { return "a folded negative in an unsigned compare must SetError" }
	if bytesWritten(uneg) != 0 { return "a folded unsigned negative must encode nothing" }
	var wide @asm.Assembler = arm32FoldCmpAsm(iropcode.OP_EQ, types.TypInt64(), cast(int64, 5))
	if !wide.HasError { return "a folded constant in an int64 compare must SetError" }
	return ""
}

// A folded small negative in a SIGNED compare rides CMN (opcode 0b1011 = 11) with
// the I bit set.
func TestArm32CmpImmFoldSignedNegativeEmitsCmn() testing.TestResult {
	var a @asm.Assembler = arm32FoldCmpAsm(iropcode.OP_LT, types.TypInt32(),
			cast(int64, 0) - cast(int64, 255))
	if a.HasError { return "a folded -255 in a signed compare must not error" }
	var w uint32 = word32(a, 0)
	if !arm32ImmBitSet(w) { return "a folded signed negative compare must set the I bit" }
	if arm32DpOpcode(w) != cast(uint32, 11) { return "a folded signed negative must emit CMN" }
	return ""
}

// arm32FitsFunc returns a fresh empty function with an entry block, for the
// arm32ImmFits predicate tests.
func arm32FitsFunc() @ir.Func {
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "t", noParams, noResults)
	_ = ir.AddBlock(f, "entry")
	return f
}

// arm32FitsParam makes a non-constant value of type t (an OP_PARAM reference).
func arm32FitsParam(f @ir.Func, t @types.Type) @ir.Instr {
	var p @ir.Param = ir.NewParam(f, "x", t)
	return ir.NewParamRef(f, p)
}

// arm32FoldedByFits runs fold.ImmOperandConsts with arm32ImmFits over f and
// reports whether constant c is flagged.
func arm32FoldedByFits(f @ir.Func, c @ir.Instr) bool {
	return fold.ImmOperandConsts(f, arm32ImmFits)[c.ID]
}

// arm32FitsCmpRhs reports whether a constant `val` of type t, used only as the
// RHS of `x OP val`, is flagged by the arm32 predicate.
func arm32FitsCmpRhs(op int, t @types.Type, val int) bool {
	var f @ir.Func = arm32FitsFunc()
	var c @ir.Instr = irbuild.EmitConstInt(f.Blocks[0], val, t)
	_ = irbuild.EmitBinop(f.Blocks[0], op, arm32FitsParam(f, t), c, types.TypBool())
	return arm32FoldedByFits(f, c)
}

// arm32FitsAdd reports whether a constant `val` of type t, used only as operand
// argIdx of `x OP val` / `val OP x` (OP an ADD or SUB), is flagged.
func arm32FitsAdd(op int, t @types.Type, val int, argIdx int) bool {
	var f @ir.Func = arm32FitsFunc()
	var c @ir.Instr = irbuild.EmitConstInt(f.Blocks[0], val, t)
	var x @ir.Instr = arm32FitsParam(f, t)
	if argIdx == 0 {
		_ = irbuild.EmitBinop(f.Blocks[0], op, c, x, t)
	} else {
		_ = irbuild.EmitBinop(f.Blocks[0], op, x, c, t)
	}
	return arm32FoldedByFits(f, c)
}

// A compare RHS in 0..255 folds for every compare op (EQ/NE/LT/LE/GT/GE), signed
// or unsigned; the range edge 255 folds.
func TestArm32ImmFitsCmpRhsInRange() testing.TestResult {
	var ops @[]int = make_slice(int, 6)
	ops[0] = iropcode.OP_EQ
	ops[1] = iropcode.OP_NE
	ops[2] = iropcode.OP_LT
	ops[3] = iropcode.OP_LE
	ops[4] = iropcode.OP_GT
	ops[5] = iropcode.OP_GE
	for i := 0; i < len(ops); i++ {
		if !arm32FitsCmpRhs(ops[i], types.TypInt32(), 42) {
			return "an int32 compare RHS of 42 must fold for every compare op"
		}
		if !arm32FitsCmpRhs(ops[i], types.TypUint32(), 42) {
			return "a uint32 compare RHS of 42 must fold for every compare op"
		}
	}
	if !arm32FitsCmpRhs(iropcode.OP_EQ, types.TypUint32(), 0) {
		return "a uint32 compare RHS of 0 must fold"
	}
	if !arm32FitsCmpRhs(iropcode.OP_GE, types.TypInt32(), 255) {
		return "a compare RHS of 255 (the range edge) must fold"
	}
	return ""
}

// A constant compare LHS never folds: the LHS is the CMP's register operand.
func TestArm32ImmFitsCmpLhsNever() testing.TestResult {
	var f @ir.Func = arm32FitsFunc()
	var c @ir.Instr = irbuild.EmitConstInt(f.Blocks[0], 5, types.TypInt32())
	var x @ir.Instr = arm32FitsParam(f, types.TypInt32())
	_ = irbuild.EmitBinop(f.Blocks[0], iropcode.OP_LT, c, x, types.TypBool())
	if arm32FoldedByFits(f, c) { return "a constant compare LHS must NOT fold" }
	return ""
}

// Values outside 0..255 / -255..-1 never fold, at a compare RHS or an ADD/SUB.
func TestArm32ImmFitsOutOfRange() testing.TestResult {
	if arm32FitsCmpRhs(iropcode.OP_LT, types.TypInt32(), 256) {
		return "a compare RHS of 256 must NOT fold"
	}
	if arm32FitsCmpRhs(iropcode.OP_LT, types.TypInt32(), -256) {
		return "a compare RHS of -256 must NOT fold"
	}
	if arm32FitsAdd(iropcode.OP_ADD, types.TypInt32(), 256, 1) {
		return "an ADD constant of 256 must NOT fold"
	}
	if arm32FitsAdd(iropcode.OP_SUB, types.TypInt32(), -256, 1) {
		return "a SUB constant of -256 must NOT fold"
	}
	return ""
}

// A small negative compare RHS folds (via CMN) only for a SIGNED compare; in an
// unsigned compare it denotes a near-2^32 value.  An ADD/SUB negative folds for
// either signedness (the sign-swapped operation).
func TestArm32ImmFitsNegativeSignedOnly() testing.TestResult {
	if !arm32FitsCmpRhs(iropcode.OP_LT, types.TypInt32(), -255) {
		return "a signed compare RHS of -255 must fold"
	}
	if arm32FitsCmpRhs(iropcode.OP_LT, types.TypUint32(), -5) {
		return "an unsigned compare RHS of -5 must NOT fold"
	}
	if !arm32FitsAdd(iropcode.OP_ADD, types.TypUint32(), -5, 1) {
		return "a uint32 ADD constant of -5 must fold (sign-swapped SUB)"
	}
	return ""
}

// An ADD constant folds on either side (ADD commutes); a SUB folds its subtrahend
// but never its minuend.
func TestArm32ImmFitsAddSubPositions() testing.TestResult {
	if !arm32FitsAdd(iropcode.OP_ADD, types.TypInt32(), 7, 1) {
		return "an ADD RHS constant must fold"
	}
	if !arm32FitsAdd(iropcode.OP_ADD, types.TypInt32(), 7, 0) {
		return "an ADD LHS constant must fold"
	}
	if !arm32FitsAdd(iropcode.OP_SUB, types.TypInt32(), 7, 1) {
		return "a SUB subtrahend constant must fold"
	}
	if arm32FitsAdd(iropcode.OP_SUB, types.TypInt32(), 7, 0) {
		return "a SUB minuend constant must NOT fold"
	}
	return ""
}

// A const+const ADD folds neither operand: one operand must supply the register.
func TestArm32ImmFitsConstPlusConstNo() testing.TestResult {
	var f @ir.Func = arm32FitsFunc()
	var c @ir.Instr = irbuild.EmitConstInt(f.Blocks[0], 3, types.TypInt32())
	var d @ir.Instr = irbuild.EmitConstInt(f.Blocks[0], 4, types.TypInt32())
	_ = irbuild.EmitBinop(f.Blocks[0], iropcode.OP_ADD, c, d, types.TypInt32())
	var flags @[]bool = fold.ImmOperandConsts(f, arm32ImmFits)
	if flags[c.ID] || flags[d.ID] { return "a const+const ADD must fold neither constant" }
	return ""
}

// A constant used as BOTH a compare RHS and an ADD operand, in range at each,
// folds; the same constant with an extra non-immediate use (a MUL) does not.
func TestArm32ImmFitsCmpAndAddMixedFolds() testing.TestResult {
	var f @ir.Func = arm32FitsFunc()
	var c @ir.Instr = irbuild.EmitConstInt(f.Blocks[0], 9, types.TypInt32())
	var x @ir.Instr = arm32FitsParam(f, types.TypInt32())
	_ = irbuild.EmitBinop(f.Blocks[0], iropcode.OP_LT, x, c, types.TypBool())
	_ = irbuild.EmitBinop(f.Blocks[0], iropcode.OP_ADD, x, c, types.TypInt32())
	if !arm32FoldedByFits(f, c) {
		return "a compare-RHS + ADD-operand constant in range at both uses must fold"
	}
	_ = irbuild.EmitBinop(f.Blocks[0], iropcode.OP_MUL, x, c, types.TypInt32())
	if arm32FoldedByFits(f, c) { return "a constant also used by a MUL must NOT fold" }
	return ""
}

// On this ILP32 target an int64 / uint64 compare or ADD is a register-pair
// sequence with no single immediate form, so its constant never folds.
func TestArm32ImmFitsInt64NotFolded() testing.TestResult {
	if arm32FitsCmpRhs(iropcode.OP_LT, types.TypInt64(), 5) {
		return "an int64 compare RHS must NOT fold"
	}
	if arm32FitsCmpRhs(iropcode.OP_EQ, types.TypUint64(), 5) {
		return "a uint64 compare RHS must NOT fold"
	}
	if arm32FitsAdd(iropcode.OP_ADD, types.TypInt64(), 5, 1) {
		return "an int64 ADD constant must NOT fold"
	}
	if arm32FitsAdd(iropcode.OP_SUB, types.TypInt64(), 5, 1) {
		return "an int64 SUB constant must NOT fold"
	}
	return ""
}
