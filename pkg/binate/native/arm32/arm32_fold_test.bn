package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/native/fold"
import "pkg/binate/types"
import "pkg/builtins/testing"

// arm32FoldBinopIns builds a binop `ins` (id 0) of opcode op and result type
// `rt` over a non-constant operand (id 10) and a constant `cval` (id 11), both of
// type rt, placing the constant at argIdx (0 or 1), and flags the constant
// FoldedImm in rm.  The caller decides whether operand 10 is register-resident.
func arm32FoldBinopIns(rm @common.RegMap, op int, cval int64, argIdx int,
		rt @types.Type) @ir.Instr {
	var reg @ir.Instr = make(ir.Instr)
	reg.ID = 10
	reg.Op = iropcode.OP_PARAM // a non-constant (the zero Op is OP_CONST_INT)
	reg.Typ = rt
	var c @ir.Instr = make(ir.Instr)
	c.ID = 11
	c.Op = iropcode.OP_CONST_INT
	c.Typ = rt
	c.IntVal = cval
	var fc @[]bool = make_slice(bool, 12)
	fc[11] = true
	rm.FoldedImm = fc
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = op
	ins.Typ = rt
	ins.Args = make_slice(@ir.Instr, 2)
	if argIdx == 0 {
		ins.Args[0] = c
		ins.Args[1] = reg
	} else {
		ins.Args[0] = reg
		ins.Args[1] = c
	}
	return ins
}

// arm32FoldBinopAsm builds (arm32FoldBinopIns) an ADD/SUB/AND/OR/XOR `ins` of
// result type `rt` over a register-resident operand (R5) and a FoldedImm constant
// `cval` at argIdx (0 or 1), emits it through emitBinop, and returns the
// assembler.  The result lands in R4, the first free pool register.
func arm32FoldBinopAsm(op int, cval int64, argIdx int, rt @types.Type) @asm.Assembler {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AssignReg(10, 5) // R5
	var ins @ir.Instr = arm32FoldBinopIns(rm, op, cval, argIdx, rt)
	_ = emitBinop(a, rm, ins)
	return a
}

// arm32FoldAddSub is arm32FoldBinopAsm at int32, returning the leading
// instruction word (the register operand is resident, so the ADD/SUB is the
// first instruction).
func arm32FoldAddSub(op int, cval int64, argIdx int) uint32 {
	return word32(arm32FoldBinopAsm(op, cval, argIdx, types.TypInt32()), 0)
}

// arm32ImmBitSet reports whether the DP instruction's I (immediate) bit (25) is set.
func arm32ImmBitSet(w uint32) bool {
	return ((w >> cast(uint32, 25)) & cast(uint32, 1)) == cast(uint32, 1)
}

// arm32DpOpcode extracts the data-processing opcode field (bits [24:21]):
// ADD = 0b0100 = 4, SUB = 0b0010 = 2.
func arm32DpOpcode(w uint32) uint32 {
	return (w >> cast(uint32, 21)) & cast(uint32, 0xF)
}

// arm32HasSubstr reports whether `sub` occurs in `s`.
func arm32HasSubstr(s *[]readonly char, sub *[]readonly char) bool {
	for i := 0; i + len(sub) <= len(s); i++ {
		var match bool = true
		for j := 0; j < len(sub); j++ {
			if s[i + j] != sub[j] {
				match = false
				break
			}
		}
		if match { return true }
	}
	return false
}

// A folded ADD constant (RHS) rides the modified-immediate operand: I bit set,
// opcode ADD (4).
func TestArm32AddImmFoldRhsEmitsImm() testing.TestResult {
	var w uint32 = arm32FoldAddSub(iropcode.OP_ADD, cast(int64, 5), 1)
	if !arm32ImmBitSet(w) { return "a folded ADD const must set the I (immediate) bit" }
	if arm32DpOpcode(w) != cast(uint32, 4) { return "a folded ADD must keep the ADD opcode (4)" }
	return ""
}

// ADD is commutative: a folded constant on the LHS folds too.
func TestArm32AddImmFoldLhsCommutes() testing.TestResult {
	var w uint32 = arm32FoldAddSub(iropcode.OP_ADD, cast(int64, 7), 0)
	if !arm32ImmBitSet(w) { return "a folded ADD const on the LHS must set the I bit" }
	if arm32DpOpcode(w) != cast(uint32, 4) {
		return "a commuted folded ADD must keep the ADD opcode (4)"
	}
	return ""
}

// A folded SUB subtrahend rides the immediate: I bit set, opcode SUB (2).
func TestArm32SubImmFoldSubtrahend() testing.TestResult {
	var w uint32 = arm32FoldAddSub(iropcode.OP_SUB, cast(int64, 5), 1)
	if !arm32ImmBitSet(w) { return "a folded SUB subtrahend must set the I bit" }
	if arm32DpOpcode(w) != cast(uint32, 2) { return "a folded SUB must keep the SUB opcode (2)" }
	return ""
}

// A small negative ADD constant sign-swaps to SUB (arm32 modified immediates are
// unsigned): I bit set, opcode SUB (2).
func TestArm32AddImmFoldNegativeEmitsSub() testing.TestResult {
	var w uint32 = arm32FoldAddSub(iropcode.OP_ADD, cast(int64, 0) - cast(int64, 5), 1)
	if !arm32ImmBitSet(w) { return "x + (-5) must set the I bit" }
	if arm32DpOpcode(w) != cast(uint32, 2) {
		return "x + (-5) must sign-swap to the SUB opcode (2)"
	}
	return ""
}

// The range edges ride the immediate: +255 and -255 (sign-swapped) both fold.
func TestArm32AddImmFoldRangeEdges() testing.TestResult {
	var a @asm.Assembler = arm32FoldBinopAsm(iropcode.OP_ADD, arm32ImmPosMax, 1, types.TypInt32())
	if a.HasError { return "x + 255 is in range and must fold without error" }
	if !arm32ImmBitSet(word32(a, 0)) { return "x + 255 must set the I bit" }
	var b @asm.Assembler = arm32FoldBinopAsm(iropcode.OP_SUB, arm32ImmNegMin, 1, types.TypInt32())
	if b.HasError { return "x - (-255) is in range and must fold without error" }
	if arm32DpOpcode(word32(b, 0)) != cast(uint32, 4) {
		return "x - (-255) must sign-swap to the ADD opcode (4)"
	}
	return ""
}

// A FoldedImm ADD/SUB constant that does not fit its position fails loud and
// encodes nothing — an out-of-range value, a SUB minuend, or a result wider than
// the 32-bit word — rather than silently encoding a wrong immediate or reading
// the never-materialized constant through the register path.
func TestArm32AddImmFoldMisfitFailsLoud() testing.TestResult {
	var over @asm.Assembler = arm32FoldBinopAsm(iropcode.OP_ADD, cast(int64, 256), 1, types.TypInt32())
	if !over.HasError { return "a folded ADD constant of 256 must SetError" }
	if !arm32HasSubstr(over.ErrorMsg, "folded immediate does not fit") {
		return "the misfit error must name the folded immediate"
	}
	if bytesWritten(over) != 0 { return "a misfit folded ADD constant must encode nothing" }
	var minuend @asm.Assembler = arm32FoldBinopAsm(iropcode.OP_SUB, cast(int64, 5), 0,
			types.TypInt32())
	if !minuend.HasError { return "a folded SUB minuend must SetError" }
	if bytesWritten(minuend) != 0 { return "a folded SUB minuend must encode nothing" }
	var i64 @types.Type = types.TypInt64()
	var wide @asm.Assembler = arm32FoldBinopAsm(iropcode.OP_ADD, cast(int64, 5), 1, i64)
	if !wide.HasError { return "a folded constant in an int64 ADD must SetError" }
	if bytesWritten(wide) != 0 { return "a folded int64 ADD constant must encode nothing" }
	return ""
}

// arm32FoldCmpAsm builds `lhs OP #cval` with a register-resident LHS (R5) of type
// ot and a FoldedImm constant RHS, emits it through emitCompare, and returns the
// assembler.
func arm32FoldCmpAsm(op int, ot @types.Type, cval int64) @asm.Assembler {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AssignReg(10, 5) // R5
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 10
	lhs.Op = iropcode.OP_PARAM // a non-constant (the zero Op is OP_CONST_INT)
	lhs.Typ = ot
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 11
	rhs.Op = iropcode.OP_CONST_INT
	rhs.Typ = ot
	rhs.IntVal = cval
	var fc @[]bool = make_slice(bool, 12)
	fc[11] = true
	rm.FoldedImm = fc
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = op
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	_ = emitCompare(a, "main", rm, ins)
	return a
}

// A FoldedImm compare constant that does not fit fails loud and encodes nothing:
// an out-of-range value, a negative in an unsigned compare (a near-2^32 value
// CMN cannot carry), or a compare wider than the 32-bit word.
func TestArm32CmpImmFoldMisfitFailsLoud() testing.TestResult {
	var over @asm.Assembler = arm32FoldCmpAsm(iropcode.OP_LT, types.TypInt32(), cast(int64, 256))
	if !over.HasError { return "a folded compare constant of 256 must SetError" }
	if !arm32HasSubstr(over.ErrorMsg, "folded immediate does not fit") {
		return "the misfit error must name the folded immediate"
	}
	if bytesWritten(over) != 0 { return "a misfit folded compare constant must encode nothing" }
	var uneg @asm.Assembler = arm32FoldCmpAsm(iropcode.OP_LT, types.TypUint32(),
			cast(int64, 0) - cast(int64, 5))
	if !uneg.HasError { return "a folded negative in an unsigned compare must SetError" }
	if bytesWritten(uneg) != 0 { return "a folded unsigned negative must encode nothing" }
	var wide @asm.Assembler = arm32FoldCmpAsm(iropcode.OP_EQ, types.TypInt64(), cast(int64, 5))
	if !wide.HasError { return "a folded constant in an int64 compare must SetError" }
	return ""
}

// A folded small negative in a SIGNED compare rides CMN (opcode 0b1011 = 11) with
// the I bit set.
func TestArm32CmpImmFoldSignedNegativeEmitsCmn() testing.TestResult {
	var a @asm.Assembler = arm32FoldCmpAsm(iropcode.OP_LT, types.TypInt32(),
			cast(int64, 0) - cast(int64, 255))
	if a.HasError { return "a folded -255 in a signed compare must not error" }
	var w uint32 = word32(a, 0)
	if !arm32ImmBitSet(w) { return "a folded signed negative compare must set the I bit" }
	if arm32DpOpcode(w) != cast(uint32, 11) { return "a folded signed negative must emit CMN" }
	return ""
}

// arm32FitsFunc returns a fresh empty function with an entry block, for the
// arm32ImmFits predicate tests.
func arm32FitsFunc() @ir.Func {
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "t", noParams, noResults)
	_ = ir.AddBlock(f, "entry")
	return f
}

// arm32FitsParam makes a non-constant value of type t (an OP_PARAM reference).
func arm32FitsParam(f @ir.Func, t @types.Type) @ir.Instr {
	var p @ir.Param = irbuild.NewParam(f, "x", t)
	return irbuild.NewParamRef(f, p)
}

// arm32FoldedByFits runs fold.ImmOperandConsts with arm32ImmFits over f and
// reports whether constant c is flagged.
func arm32FoldedByFits(f @ir.Func, c @ir.Instr) bool {
	return fold.ImmOperandConsts(f, arm32ImmFits)[c.ID]
}

// arm32FitsCmpRhs reports whether a constant `val` of type t, used only as the
// RHS of `x OP val`, is flagged by the arm32 predicate.
func arm32FitsCmpRhs(op int, t @types.Type, val int) bool {
	var f @ir.Func = arm32FitsFunc()
	var c @ir.Instr = irbuild.EmitConstInt(f.Blocks[0], val, t)
	_ = irbuild.EmitBinop(f.Blocks[0], op, arm32FitsParam(f, t), c, types.TypBool())
	return arm32FoldedByFits(f, c)
}

// arm32FitsBinop reports whether a constant `val` of type t, used only as
// operand argIdx of `x OP val` / `val OP x` (OP an ADD, SUB, AND, OR or XOR), is
// flagged.
func arm32FitsBinop(op int, t @types.Type, val int, argIdx int) bool {
	var f @ir.Func = arm32FitsFunc()
	var c @ir.Instr = irbuild.EmitConstInt(f.Blocks[0], val, t)
	var x @ir.Instr = arm32FitsParam(f, t)
	if argIdx == 0 {
		_ = irbuild.EmitBinop(f.Blocks[0], op, c, x, t)
	} else {
		_ = irbuild.EmitBinop(f.Blocks[0], op, x, c, t)
	}
	return arm32FoldedByFits(f, c)
}

// A compare RHS in 0..255 folds for every compare op (EQ/NE/LT/LE/GT/GE), signed
// or unsigned; the range edge 255 folds.
func TestArm32ImmFitsCmpRhsInRange() testing.TestResult {
	var ops @[]int = make_slice(int, 6)
	ops[0] = iropcode.OP_EQ
	ops[1] = iropcode.OP_NE
	ops[2] = iropcode.OP_LT
	ops[3] = iropcode.OP_LE
	ops[4] = iropcode.OP_GT
	ops[5] = iropcode.OP_GE
	for i := 0; i < len(ops); i++ {
		if !arm32FitsCmpRhs(ops[i], types.TypInt32(), 42) {
			return "an int32 compare RHS of 42 must fold for every compare op"
		}
		if !arm32FitsCmpRhs(ops[i], types.TypUint32(), 42) {
			return "a uint32 compare RHS of 42 must fold for every compare op"
		}
	}
	if !arm32FitsCmpRhs(iropcode.OP_EQ, types.TypUint32(), 0) {
		return "a uint32 compare RHS of 0 must fold"
	}
	if !arm32FitsCmpRhs(iropcode.OP_GE, types.TypInt32(), 255) {
		return "a compare RHS of 255 (the range edge) must fold"
	}
	return ""
}

// A constant compare LHS never folds: the LHS is the CMP's register operand.
func TestArm32ImmFitsCmpLhsNever() testing.TestResult {
	var f @ir.Func = arm32FitsFunc()
	var c @ir.Instr = irbuild.EmitConstInt(f.Blocks[0], 5, types.TypInt32())
	var x @ir.Instr = arm32FitsParam(f, types.TypInt32())
	_ = irbuild.EmitBinop(f.Blocks[0], iropcode.OP_LT, c, x, types.TypBool())
	if arm32FoldedByFits(f, c) { return "a constant compare LHS must NOT fold" }
	return ""
}

// Values outside 0..255 / -255..-1 never fold, at a compare RHS or an ADD/SUB.
func TestArm32ImmFitsOutOfRange() testing.TestResult {
	if arm32FitsCmpRhs(iropcode.OP_LT, types.TypInt32(), 256) {
		return "a compare RHS of 256 must NOT fold"
	}
	if arm32FitsCmpRhs(iropcode.OP_LT, types.TypInt32(), -256) {
		return "a compare RHS of -256 must NOT fold"
	}
	if arm32FitsBinop(iropcode.OP_ADD, types.TypInt32(), 256, 1) {
		return "an ADD constant of 256 must NOT fold"
	}
	if arm32FitsBinop(iropcode.OP_SUB, types.TypInt32(), -256, 1) {
		return "a SUB constant of -256 must NOT fold"
	}
	return ""
}

// A small negative compare RHS folds (via CMN) only for a SIGNED compare; in an
// unsigned compare it denotes a near-2^32 value.  An ADD/SUB negative folds for
// either signedness (the sign-swapped operation).
func TestArm32ImmFitsNegativeSignedOnly() testing.TestResult {
	if !arm32FitsCmpRhs(iropcode.OP_LT, types.TypInt32(), -255) {
		return "a signed compare RHS of -255 must fold"
	}
	if arm32FitsCmpRhs(iropcode.OP_LT, types.TypUint32(), -5) {
		return "an unsigned compare RHS of -5 must NOT fold"
	}
	if !arm32FitsBinop(iropcode.OP_ADD, types.TypUint32(), -5, 1) {
		return "a uint32 ADD constant of -5 must fold (sign-swapped SUB)"
	}
	return ""
}

// An ADD constant folds on either side (ADD commutes); a SUB folds its subtrahend
// but never its minuend.
func TestArm32ImmFitsAddSubPositions() testing.TestResult {
	if !arm32FitsBinop(iropcode.OP_ADD, types.TypInt32(), 7, 1) {
		return "an ADD RHS constant must fold"
	}
	if !arm32FitsBinop(iropcode.OP_ADD, types.TypInt32(), 7, 0) {
		return "an ADD LHS constant must fold"
	}
	if !arm32FitsBinop(iropcode.OP_SUB, types.TypInt32(), 7, 1) {
		return "a SUB subtrahend constant must fold"
	}
	if arm32FitsBinop(iropcode.OP_SUB, types.TypInt32(), 7, 0) {
		return "a SUB minuend constant must NOT fold"
	}
	return ""
}

// A const+const ADD folds neither operand: one operand must supply the register.
func TestArm32ImmFitsConstPlusConstNo() testing.TestResult {
	var f @ir.Func = arm32FitsFunc()
	var c @ir.Instr = irbuild.EmitConstInt(f.Blocks[0], 3, types.TypInt32())
	var d @ir.Instr = irbuild.EmitConstInt(f.Blocks[0], 4, types.TypInt32())
	_ = irbuild.EmitBinop(f.Blocks[0], iropcode.OP_ADD, c, d, types.TypInt32())
	var flags @[]bool = fold.ImmOperandConsts(f, arm32ImmFits)
	if flags[c.ID] || flags[d.ID] { return "a const+const ADD must fold neither constant" }
	return ""
}

// A constant used as BOTH a compare RHS and an ADD operand, in range at each,
// folds; the same constant with an extra non-immediate use (a MUL) does not.
func TestArm32ImmFitsCmpAndAddMixedFolds() testing.TestResult {
	var f @ir.Func = arm32FitsFunc()
	var c @ir.Instr = irbuild.EmitConstInt(f.Blocks[0], 9, types.TypInt32())
	var x @ir.Instr = arm32FitsParam(f, types.TypInt32())
	_ = irbuild.EmitBinop(f.Blocks[0], iropcode.OP_LT, x, c, types.TypBool())
	_ = irbuild.EmitBinop(f.Blocks[0], iropcode.OP_ADD, x, c, types.TypInt32())
	if !arm32FoldedByFits(f, c) {
		return "a compare-RHS + ADD-operand constant in range at both uses must fold"
	}
	_ = irbuild.EmitBinop(f.Blocks[0], iropcode.OP_MUL, x, c, types.TypInt32())
	if arm32FoldedByFits(f, c) { return "a constant also used by a MUL must NOT fold" }
	return ""
}

// On this ILP32 target an int64 / uint64 compare or ADD is a register-pair
// sequence with no single immediate form, so its constant never folds.
func TestArm32ImmFitsInt64NotFolded() testing.TestResult {
	if arm32FitsCmpRhs(iropcode.OP_LT, types.TypInt64(), 5) {
		return "an int64 compare RHS must NOT fold"
	}
	if arm32FitsCmpRhs(iropcode.OP_EQ, types.TypUint64(), 5) {
		return "a uint64 compare RHS must NOT fold"
	}
	if arm32FitsBinop(iropcode.OP_ADD, types.TypInt64(), 5, 1) {
		return "an int64 ADD constant must NOT fold"
	}
	if arm32FitsBinop(iropcode.OP_SUB, types.TypInt64(), 5, 1) {
		return "an int64 SUB constant must NOT fold"
	}
	return ""
}

// arm32LogicImmIs reports whether arm32LogicImm, asked about the constant `val`
// of type t in `x OP val` (argIdx 1), returns (wantForm, wantImm, true).
func arm32LogicImmIs(op int, t @types.Type, val int64, wantForm int, wantImm uint32) bool {
	var f @ir.Func = arm32FitsFunc()
	var c @ir.Instr = irbuild.EmitConstInt64(f.Blocks[0], val, t)
	var user @ir.Instr = irbuild.EmitBinop(f.Blocks[0], op, arm32FitsParam(f, t), c, t)
	var form int
	var imm int
	var ok bool
	form, imm, ok = arm32LogicImm(user, 1)
	return ok && form == wantForm && cast(uint32, imm) == wantImm
}

// arm32LogicImmNo reports whether arm32LogicImm rejects the constant `val` of
// type t in `x OP val` (argIdx 1), with the form and immediate both 0.
func arm32LogicImmNo(op int, t @types.Type, val int64) bool {
	var f @ir.Func = arm32FitsFunc()
	var c @ir.Instr = irbuild.EmitConstInt64(f.Blocks[0], val, t)
	var user @ir.Instr = irbuild.EmitBinop(f.Blocks[0], op, arm32FitsParam(f, t), c, t)
	var form int
	var imm int
	var ok bool
	form, imm, ok = arm32LogicImm(user, 1)
	return !ok && form == 0 && imm == 0
}

// An AND takes its 32-bit pattern as the AND immediate when that is a modified
// immediate — including a rotated one and a negative int32 whose pattern is one
// (passed as the non-negative pattern) — else its complement as the BIC
// immediate; a pattern neither side encodes is rejected.
func TestArm32LogicImmAndForms() testing.TestResult {
	var i32 @types.Type = types.TypInt32()
	var u32 @types.Type = types.TypUint32()
	var and int = iropcode.OP_AND
	if !arm32LogicImmIs(and, i32, 255, arm32LogicFormAnd, 255) { return "x & 255 must be AND #255" }
	if !arm32LogicImmIs(and, u32, 0xF0000000, arm32LogicFormAnd, 0xF0000000) {
		return "x & 0xF0000000 must be AND #0xF0000000 (a rotated modified immediate)"
	}
	if !arm32LogicImmIs(and, i32, -268435456, arm32LogicFormAnd, 0xF0000000) {
		return "int32 x & -2^28 must be AND with the non-negative pattern 0xF0000000"
	}
	if !arm32LogicImmIs(and, u32, 0xFFFFFF00, arm32LogicFormBic, 255) {
		return "uint32 x & 0xFFFFFF00 must be BIC #255"
	}
	if !arm32LogicImmIs(and, i32, -256, arm32LogicFormBic, 255) {
		return "int32 x & -256 must be BIC #255"
	}
	if !arm32LogicImmIs(and, i32, -1, arm32LogicFormBic, 0) { return "x & -1 must be BIC #0" }
	if !arm32LogicImmNo(and, i32, 0x1234) {
		return "x & 0x1234 (neither it nor its complement encodes) must be rejected"
	}
	if !arm32LogicImmNo(and, i32, 0x101) { return "x & 0x101 must be rejected" }
	return ""
}

// An OR takes only its own pattern as the ORR immediate: arm32 has no ORN, so a
// value whose complement encodes (and all ones) is rejected.
func TestArm32LogicImmOrrForms() testing.TestResult {
	var i32 @types.Type = types.TypInt32()
	var or int = iropcode.OP_OR
	if !arm32LogicImmIs(or, i32, 0x3FC, arm32LogicFormOrr, 0x3FC) { return "x | 0x3FC must be ORR" }
	if !arm32LogicImmIs(or, i32, 0, arm32LogicFormOrr, 0) { return "x | 0 must be ORR #0" }
	if !arm32LogicImmNo(or, i32, 0x101) { return "x | 0x101 must be rejected" }
	if !arm32LogicImmNo(or, i32, -256) { return "x | -256 (no ORN) must be rejected" }
	if !arm32LogicImmNo(or, i32, -1) { return "x | -1 must be rejected" }
	return ""
}

// An XOR with the all-ones 32-bit pattern (int32 -1, uint32 0xFFFFFFFF, int8 -1)
// is MVN; any other pattern rides EOR when it encodes and is rejected otherwise.
func TestArm32LogicImmEorAndMvnForms() testing.TestResult {
	var i32 @types.Type = types.TypInt32()
	var xor int = iropcode.OP_XOR
	if !arm32LogicImmIs(xor, i32, -1, arm32LogicFormMvn, 0) { return "int32 x ^ -1 must be MVN" }
	if !arm32LogicImmIs(xor, types.TypUint32(), 0xFFFFFFFF, arm32LogicFormMvn, 0) {
		return "uint32 x ^ 0xFFFFFFFF must be MVN"
	}
	if !arm32LogicImmIs(xor, types.TypInt8(), -1, arm32LogicFormMvn, 0) {
		return "int8 x ^ -1 must be MVN (re-narrowed after)"
	}
	if !arm32LogicImmIs(xor, i32, 0xFF00, arm32LogicFormEor, 0xFF00) {
		return "x ^ 0xFF00 must be EOR #0xFF00"
	}
	if !arm32LogicImmIs(xor, types.TypUint8(), 0xFF, arm32LogicFormEor, 0xFF) {
		return "uint8 x ^ 0xFF must be EOR #255 (its 32-bit pattern is not all ones)"
	}
	if !arm32LogicImmNo(xor, i32, -256) {
		return "x ^ -256 (not all ones, not a modified immediate) must be rejected"
	}
	if !arm32LogicImmNo(xor, i32, 0x101) { return "x ^ 0x101 must be rejected" }
	return ""
}

// The fold predicate flags an encodable AND/OR/XOR constant on either side (all
// three commute) and a BIC-able AND and an all-ones XOR; it leaves an
// unencodable one unflagged.
func TestArm32ImmFitsLogicPositions() testing.TestResult {
	var i32 @types.Type = types.TypInt32()
	var ops @[]int = make_slice(int, 3)
	ops[0] = iropcode.OP_AND
	ops[1] = iropcode.OP_OR
	ops[2] = iropcode.OP_XOR
	for i := 0; i < len(ops); i++ {
		if !arm32FitsBinop(ops[i], i32, 0xFF00, 1) {
			return "an encodable AND/OR/XOR RHS constant must fold"
		}
		if !arm32FitsBinop(ops[i], i32, 0xFF00, 0) {
			return "an encodable AND/OR/XOR LHS constant must fold (the ops commute)"
		}
		if arm32FitsBinop(ops[i], i32, 0x1234, 1) {
			return "an unencodable AND/OR/XOR constant must NOT fold"
		}
	}
	if !arm32FitsBinop(iropcode.OP_AND, i32, -256, 1) { return "a BIC-able AND constant must fold" }
	if !arm32FitsBinop(iropcode.OP_XOR, i32, -1, 0) { return "an all-ones XOR constant must fold" }
	if arm32FitsBinop(iropcode.OP_OR, i32, -256, 1) { return "x | -256 must NOT fold (no ORN)" }
	if !arm32FitsBinop(iropcode.OP_AND, types.TypUint8(), 0xF0, 1) {
		return "a sub-word (uint8) AND constant must fold"
	}
	return ""
}

// A const-const AND/OR/XOR folds neither operand, and on this ILP32 target an
// int64 / uint64 AND/OR/XOR (a register-pair sequence) never folds its constant.
func TestArm32ImmFitsLogicConstConstAndWide() testing.TestResult {
	var f @ir.Func = arm32FitsFunc()
	var c @ir.Instr = irbuild.EmitConstInt(f.Blocks[0], 3, types.TypInt32())
	var d @ir.Instr = irbuild.EmitConstInt(f.Blocks[0], 4, types.TypInt32())
	_ = irbuild.EmitBinop(f.Blocks[0], iropcode.OP_AND, c, d, types.TypInt32())
	var flags @[]bool = fold.ImmOperandConsts(f, arm32ImmFits)
	if flags[c.ID] || flags[d.ID] { return "a const-const AND must fold neither constant" }
	if arm32FitsBinop(iropcode.OP_AND, types.TypInt64(), 255, 1) {
		return "an int64 AND constant must NOT fold"
	}
	if arm32FitsBinop(iropcode.OP_OR, types.TypUint64(), 255, 1) {
		return "a uint64 OR constant must NOT fold"
	}
	if arm32FitsBinop(iropcode.OP_XOR, types.TypInt64(), -1, 1) {
		return "an int64 XOR constant must NOT fold"
	}
	return ""
}

// A constant used by both an AND and an ADD folds when it fits both positions;
// one that fits the AND but not the ADD range (0xFF00) does not.
func TestArm32ImmFitsLogicAndAddShared() testing.TestResult {
	var i32 @types.Type = types.TypInt32()
	var f @ir.Func = arm32FitsFunc()
	var c @ir.Instr = irbuild.EmitConstInt(f.Blocks[0], 7, i32)
	var x @ir.Instr = arm32FitsParam(f, i32)
	_ = irbuild.EmitBinop(f.Blocks[0], iropcode.OP_AND, x, c, i32)
	_ = irbuild.EmitBinop(f.Blocks[0], iropcode.OP_ADD, c, x, i32)
	if !arm32FoldedByFits(f, c) { return "a constant 7 used by an AND and an ADD must fold" }
	var g @ir.Func = arm32FitsFunc()
	var k @ir.Instr = irbuild.EmitConstInt(g.Blocks[0], 0xFF00, i32)
	var y @ir.Instr = arm32FitsParam(g, i32)
	_ = irbuild.EmitBinop(g.Blocks[0], iropcode.OP_AND, y, k, i32)
	_ = irbuild.EmitBinop(g.Blocks[0], iropcode.OP_ADD, y, k, i32)
	if arm32FoldedByFits(g, k) {
		return "a constant 0xFF00 also used by an ADD (outside its range) must NOT fold"
	}
	return ""
}

// arm32FoldLogicWord emits a folded int32 logic op and reports whether it is
// exactly the one instruction `want` with no error — no register-form op and no
// materialized constant.
func arm32FoldLogicWord(op int, cval int64, argIdx int, want uint32) bool {
	var a @asm.Assembler = arm32FoldBinopAsm(op, cval, argIdx, types.TypInt32())
	return !a.HasError && bytesWritten(a) == 4 && word32(a, 0) == want
}

// Each folded logic form encodes as clang encodes it (llvm-mc, armv7a), with the
// register operand in R5 and the result in R4, as one instruction.
func TestArm32LogicImmFoldGoldens() testing.TestResult {
	// and r4, r5, #255
	if !arm32FoldLogicWord(iropcode.OP_AND, cast(int64, 255), 1, cast(uint32, 0xE20540FF)) {
		return "x & 255 must be exactly `and r4, r5, #255`"
	}
	// and r4, r5, #0xF0000000 (the constant on the LHS)
	if !arm32FoldLogicWord(iropcode.OP_AND, cast(int64, -268435456), 0, cast(uint32, 0xE205420F)) {
		return "-2^28 & x must be exactly `and r4, r5, #0xF0000000`"
	}
	// bic r4, r5, #255
	if !arm32FoldLogicWord(iropcode.OP_AND, cast(int64, -256), 1, cast(uint32, 0xE3C540FF)) {
		return "x & -256 must be exactly `bic r4, r5, #255`"
	}
	// orr r4, r5, #1020
	if !arm32FoldLogicWord(iropcode.OP_OR, cast(int64, 0x3FC), 1, cast(uint32, 0xE3854FFF)) {
		return "x | 0x3FC must be exactly `orr r4, r5, #1020`"
	}
	// eor r4, r5, #65280 (the constant on the LHS)
	if !arm32FoldLogicWord(iropcode.OP_XOR, cast(int64, 0xFF00), 0, cast(uint32, 0xE2254CFF)) {
		return "0xFF00 ^ x must be exactly `eor r4, r5, #65280`"
	}
	// mvn r4, r5
	if !arm32FoldLogicWord(iropcode.OP_XOR, cast(int64, -1), 1, cast(uint32, 0xE1E04005)) {
		return "x ^ -1 must be exactly `mvn r4, r5`"
	}
	return ""
}

// arm32LogicNarrowMatches emits the logic op `op` of sub-word type t both folded
// (constant cval) and through the register path (the constant resident in R6),
// and reports whether the folded op is exactly `want` followed by the same
// re-narrowing instruction the register path emits, `narrow`.
func arm32LogicNarrowMatches(op int, t @types.Type, cval int64, want uint32, narrow uint32) bool {
	var f @asm.Assembler = arm32FoldBinopAsm(op, cval, 1, t)
	if f.HasError || bytesWritten(f) != 8 { return false }
	var r @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	if !emitBinop(r, rm, twoOpArm32(rm, op, t)) { return false }
	if r.HasError || bytesWritten(r) != 8 { return false }
	return word32(f, 0) == want && word32(f, 4) == narrow && word32(r, 4) == narrow
}

// A folded sub-word logic result is re-narrowed exactly as the register path
// re-narrows it: UXTB / SXTB / UXTH / SXTH after the immediate op.
func TestArm32LogicImmFoldSubWordNarrow() testing.TestResult {
	// and r4, r5, #240 ; uxtb r4, r4
	if !arm32LogicNarrowMatches(iropcode.OP_AND, types.TypUint8(), cast(int64, 0xF0),
			cast(uint32, 0xE20540F0), cast(uint32, 0xE6EF4074)) {
		return "uint8 x & 0xF0 must be `and r4, r5, #240` then the register path's UXTB"
	}
	// mvn r4, r5 ; sxtb r4, r4
	if !arm32LogicNarrowMatches(iropcode.OP_XOR, types.TypInt8(), cast(int64, -1),
			cast(uint32, 0xE1E04005), cast(uint32, 0xE6AF4074)) {
		return "int8 x ^ -1 must be `mvn r4, r5` then the register path's SXTB"
	}
	// orr r4, r5, #128 ; sxth r4, r4
	if !arm32LogicNarrowMatches(iropcode.OP_OR, types.TypInt16(), cast(int64, 0x80),
			cast(uint32, 0xE3854080), cast(uint32, 0xE6BF4074)) {
		return "int16 x | 0x80 must be `orr r4, r5, #128` then the register path's SXTH"
	}
	// eor r4, r5, #15 ; uxth r4, r4
	if !arm32LogicNarrowMatches(iropcode.OP_XOR, types.TypUint16(), cast(int64, 0x0F),
			cast(uint32, 0xE225400F), cast(uint32, 0xE6FF4074)) {
		return "uint16 x ^ 0xF must be `eor r4, r5, #15` then the register path's UXTH"
	}
	return ""
}

// arm32LogicMisfit reports whether emitting a FoldedImm logic constant that its
// position does not carry fails loud (naming the folded immediate) and encodes
// nothing.
func arm32LogicMisfit(op int, cval int64, argIdx int, rt @types.Type) bool {
	var a @asm.Assembler = arm32FoldBinopAsm(op, cval, argIdx, rt)
	if !a.HasError || bytesWritten(a) != 0 { return false }
	return arm32HasSubstr(a.ErrorMsg, "folded immediate does not fit")
}

// A FoldedImm AND/OR/XOR constant that does not fit fails loud and encodes
// nothing — an unencodable pattern, an OR whose complement alone encodes, an
// XOR that is neither all ones nor encodable, or a result wider than the 32-bit
// word — rather than silently encoding a wrong immediate or reading the
// never-materialized constant through the register path.
func TestArm32LogicImmFoldMisfitFailsLoud() testing.TestResult {
	var i32 @types.Type = types.TypInt32()
	if !arm32LogicMisfit(iropcode.OP_AND, cast(int64, 0x1234), 1, i32) {
		return "a folded AND constant 0x1234 must SetError and encode nothing"
	}
	if !arm32LogicMisfit(iropcode.OP_OR, cast(int64, -256), 0, i32) {
		return "a folded OR constant -256 must SetError and encode nothing"
	}
	if !arm32LogicMisfit(iropcode.OP_XOR, cast(int64, -256), 1, i32) {
		return "a folded XOR constant -256 must SetError and encode nothing"
	}
	if !arm32LogicMisfit(iropcode.OP_AND, cast(int64, 255), 1, types.TypInt64()) {
		return "a folded constant in an int64 AND must SetError and encode nothing"
	}
	return ""
}

// A FoldedImm constant in a const-const AND (both operands flagged) fails loud,
// as does a folded constant whose register operand cannot be materialized; both
// encode nothing.
func TestArm32LogicImmFoldConstConstAndNoRegFailLoud() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = arm32FoldBinopIns(rm, iropcode.OP_AND, cast(int64, 255), 1, types.TypInt32())
	ins.Args[0].Op = iropcode.OP_CONST_INT
	ins.Args[0].IntVal = cast(int64, 15)
	rm.FoldedImm[10] = true
	_ = emitBinop(a, rm, ins)
	if !a.HasError { return "a const-const AND with both constants folded must SetError" }
	if bytesWritten(a) != 0 { return "a folded const-const AND must encode nothing" }
	var b @asm.Assembler = mkAsm()
	var rn @common.RegMap = common.NewRegMap(common.AAPCS32())
	_ = emitBinop(b, rn, arm32FoldBinopIns(rn, iropcode.OP_OR, cast(int64, 1), 1, types.TypInt32()))
	if !b.HasError { return "a folded OR with an unmaterializable register must SetError" }
	if !arm32HasSubstr(b.ErrorMsg, "register operand not materializable") {
		return "the error must name the unmaterializable register operand"
	}
	if bytesWritten(b) != 0 { return "a folded OR with no register must encode nothing" }
	return ""
}

// arm32FoldCountWords counts the text words w of `a` with (w & mask) == want.
func arm32FoldCountWords(a @asm.Assembler, mask uint32, want uint32) int {
	var n int = 0
	for off := 0; off + 4 <= bytesWritten(a); off = off + 4 {
		if (word32(a, off) & mask) == want { n = n + 1 }
	}
	return n
}

// End to end through emitFunc: in `((x & 255) + 255) ^ -1 | 0x3FC` over int32,
// the constant 255 — used by both the AND and the ADD — rides `and rd, rn, #255`
// and `add rd, rn, #255`, the XOR with all ones becomes `mvn rd, rn`, and the OR
// rides `orr rd, rn, #0x3FC`; no constant is materialized (no MOV/MVN/MOVW
// immediate), and no register-form AND/ADD/EOR/ORR remains.
func TestArm32EmitFuncFoldsLogicAndAddImmConsts() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var i32 @types.Type = types.TypInt32()
	var noP @[]@ir.Param
	var res @[]@types.Type = make_slice(@types.Type, 1)
	res[0] = i32
	var f @ir.Func = ir.NewFunc("", "test.f", noP, res)
	var p @ir.Param = irbuild.NewParam(f, "x", i32)
	var ps @[]@ir.Param = make_slice(@ir.Param, 1)
	ps[0] = p
	f.Params = ps
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.NewParamRef(f, p)
	var c255 @ir.Instr = irbuild.EmitConstInt64(entry, cast(int64, 255), i32)
	var cAll @ir.Instr = irbuild.EmitConstInt64(entry, cast(int64, -1), i32)
	var c3fc @ir.Instr = irbuild.EmitConstInt64(entry, cast(int64, 0x3FC), i32)
	var m @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_AND, x, c255, i32)
	var s @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, m, c255, i32)
	var n @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_XOR, s, cAll, i32)
	var o @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_OR, c3fc, n, i32)
	var rs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rs[0] = o
	irbuild.EmitReturn(entry, rs)
	var strings @[]ir.StringConst
	emitFunc(a, "test", f, strings)
	if a.HasError { return "emitFunc must lower the folded constants without error" }
	// Each mask includes cond (AL, 1110).  Data-processing immediate: cond, 001,
	// opcode, S=0, Rn, Rd, imm12.
	var dpImm uint32 = cast(uint32, 0xFFF00FFF)
	if arm32FoldCountWords(a, dpImm, cast(uint32, 0xE20000FF)) != 1 {
		return "the AND must ride `and rd, rn, #255`"
	}
	if arm32FoldCountWords(a, dpImm, cast(uint32, 0xE28000FF)) != 1 {
		return "the ADD must ride `add rd, rn, #255`"
	}
	if arm32FoldCountWords(a, dpImm, cast(uint32, 0xE3800FFF)) != 1 {
		return "the OR must ride `orr rd, rn, #0x3FC` (0xFF ror 30)"
	}
	// MVN register (I=0, Rn=0, no shift) is the XOR's complement form.
	if arm32FoldCountWords(a, cast(uint32, 0xFFFF0FF0), cast(uint32, 0xE1E00000)) != 1 {
		return "the XOR with all ones must become `mvn rd, rn`"
	}
	// No immediate materialization: MOV/MVN immediate (opcode 1101/1111 with
	// I=1) or MOVW / MOVT.
	if arm32FoldCountWords(a, cast(uint32, 0xFFE00000), cast(uint32, 0xE3A00000)) != 0 ||
			arm32FoldCountWords(a, cast(uint32, 0xFFE00000), cast(uint32, 0xE3E00000)) != 0 ||
			arm32FoldCountWords(a, cast(uint32, 0xFFF00000), cast(uint32, 0xE3000000)) != 0 ||
			arm32FoldCountWords(a, cast(uint32, 0xFFF00000), cast(uint32, 0xE3400000)) != 0 {
		return "no constant may be materialized (MOV/MVN/MOVW/MOVT immediate)"
	}
	// No register-form AND / ADD / EOR / ORR (I=0 data-processing, S=0).
	if arm32FoldCountWords(a, cast(uint32, 0xFFF00010), cast(uint32, 0xE0000000)) != 0 ||
			arm32FoldCountWords(a, cast(uint32, 0xFFF00010), cast(uint32, 0xE0800000)) != 0 ||
			arm32FoldCountWords(a, cast(uint32, 0xFFF00010), cast(uint32, 0xE0200000)) != 0 ||
			arm32FoldCountWords(a, cast(uint32, 0xFFF00010), cast(uint32, 0xE1800000)) != 0 {
		return "no register-form AND/ADD/EOR/ORR may remain"
	}
	return ""
}
