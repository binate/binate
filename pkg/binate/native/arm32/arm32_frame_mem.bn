package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// ============================================================
// Frame- and base-relative memory access helpers
// ============================================================

// emitFrameAddr emits `rd = SP + off` for an arbitrary frame offset, using IP
// (r12) as the fallback scratch — the AAPCS intra-procedure register, dead
// across this single address computation, and never a pool-allocated value.
// The one insertion point for "address of a frame slot" in the native emitters.
func emitFrameAddr(a @asm.Assembler, rd int, off int) {
	emitAddImm(a, rd, arm32.SP, off, arm32.IP)
}

// emitFrameLoad emits `LDR rd, [SP, #off]` for an arbitrary frame offset.  The
// LDR immediate offset is a 12-bit unsigned field (max 4095); a larger frame
// offset would trip imm12Offset's loud range error, so materialize the address
// in IP first and load `[IP]`.  Keeps a large frame's spill reloads correct
// rather than either wrapping (silent) or aborting (loud) on a > 4095 offset.
func emitFrameLoad(a @asm.Assembler, rd int, off int) {
	if off <= 0xfff {
		arm32.Ldr(a, arm32.COND_AL, rd, arm32.MemImm(arm32.SP, off))
		return
	}
	emitConstInt32(a, arm32.IP, off)
	arm32.Ldr(a, arm32.COND_AL, rd, arm32.MemReg(arm32.SP, arm32.IP))
}

// emitBaseLoad emits `LDR rd, [base, #off]` for an arbitrary offset from an
// arbitrary base register, materializing `off` into `scratch` and addressing
// `[base, scratch]` when off exceeds the 12-bit LDR immediate field — the load
// analogue of emitBaseStore.  The word-by-word aggregate copies (emitAggLoad /
// emitStructCopy / the sret + multi-return packs / aggregate-arg spreads) stride
// their per-word offset up to the aggregate's SizeOf, which exceeds 4095 for an
// aggregate larger than ~4KB (a `[2000]int` local is 8000 bytes); routing each
// element load through here keeps a large aggregate's copy correct instead of
// tripping imm12Offset's loud range error.  scratch must not alias rd or base
// (IP is the usual choice — the dedicated address scratch, dead across a single
// load and never a pool value).
func emitBaseLoad(a @asm.Assembler, rd int, base int, off int, scratch int) {
	if off <= 0xfff {
		arm32.Ldr(a, arm32.COND_AL, rd, arm32.MemImm(base, off))
		return
	}
	emitConstInt32(a, scratch, off)
	arm32.Ldr(a, arm32.COND_AL, rd, arm32.MemReg(base, scratch))
}

// emitBaseStore emits `STR rt, [base, #off]` for an arbitrary offset from an
// arbitrary base register, materializing `off` into `scratch` and addressing
// `[base, scratch]` when off exceeds the 12-bit STR immediate field.  The
// frame-relative case is base = SP, scratch = IP (emitFrameStore); a func-value
// shim passes the retbuf register as base (its tuple field offsets always fit,
// so the scratch path is never taken there).  scratch must not alias rt or base;
// rt must not be the scratch (no native caller stores IP itself).
func emitBaseStore(a @asm.Assembler, rt int, base int, off int, scratch int) {
	if off <= 0xfff {
		arm32.Str(a, arm32.COND_AL, rt, arm32.MemImm(base, off))
		return
	}
	emitConstInt32(a, scratch, off)
	arm32.Str(a, arm32.COND_AL, rt, arm32.MemReg(base, scratch))
}

// emitFrameStore emits `STR rt, [SP, #off]` for an arbitrary frame offset,
// materializing the address in IP for offsets past the 12-bit LDR/STR field.
// rt must not be IP (the address-materialization scratch); no native caller
// stores IP itself, so this holds.
func emitFrameStore(a @asm.Assembler, rt int, off int) {
	emitBaseStore(a, rt, arm32.SP, off, arm32.IP)
}

// emitBaseScalarLoad is the size-dispatched scalar LOAD from `base + off` — the
// load analogue of emitBaseScalarStore — materializing `base + off` into
// `scratch` (then loading from `[scratch]`) when off exceeds the size's immediate
// field (LDRB/LDRH: 8-bit/255; LDR: 12-bit/4095).  The frame-relative case is
// base = SP, scratch = IP (emitFrameScalarLoad).  scratch must not alias base; it
// may equal rd (rd is written last, by the load).
func emitBaseScalarLoad(a @asm.Assembler, rd int, base int, off int, sz int, signed bool,
		scratch int) {
	var maxImm int = 0xfff
	if sz == 1 || sz == 2 { maxImm = 0xff }
	if off <= maxImm {
		emitScalarLoad(a, rd, base, off, sz, signed)
		return
	}
	emitConstInt32(a, scratch, off)
	arm32.Add(a, arm32.COND_AL, false, scratch, base, arm32.Reg(scratch))
	emitScalarLoad(a, rd, scratch, 0, sz, signed)
}

// emitFrameScalarLoad emits a size-dispatched scalar load from `SP + off`,
// materializing the base in IP for offsets past the size's immediate field
// (LDRB/LDRH: 8-bit/255; LDR: 12-bit/4095), so a large frame's sub-word field
// reads stay correct.  For a fitting offset it loads `[SP, #off]` directly.
func emitFrameScalarLoad(a @asm.Assembler, rd int, off int, sz int, signed bool) {
	emitBaseScalarLoad(a, rd, arm32.SP, off, sz, signed, arm32.IP)
}

// emitBaseScalarStore is the size-dispatched scalar store to `base + off`,
// materializing `base + off` into `scratch` (then storing at `[scratch]`) when
// off exceeds the size's immediate field (LDRB/LDRH: 8-bit/255; LDR: 12-bit/
// 4095).  The frame-relative case is base = SP, scratch = IP
// (emitFrameScalarStore); a func-value shim passes the retbuf register as base
// (small tuple offsets, so the scratch path is never taken there).  scratch must
// not alias rt or base; rt must not be the scratch.
func emitBaseScalarStore(a @asm.Assembler, rt int, base int, off int, sz int, scratch int) {
	var maxImm int = 0xfff
	if sz == 1 || sz == 2 { maxImm = 0xff }
	if off <= maxImm {
		emitScalarStore(a, rt, base, off, sz)
		return
	}
	emitConstInt32(a, scratch, off)
	arm32.Add(a, arm32.COND_AL, false, scratch, base, arm32.Reg(scratch))
	emitScalarStore(a, rt, scratch, 0, sz)
}

// emitFrameScalarStore is the symmetric size-dispatched scalar store to
// `SP + off`, materializing the base in IP for large offsets.  rt must not be
// IP (the address scratch); no native caller stores IP itself.
func emitFrameScalarStore(a @asm.Assembler, rt int, off int, sz int) {
	emitBaseScalarStore(a, rt, arm32.SP, off, sz, arm32.IP)
}

// emitScalarLoad picks the right LDR variant for the given byte size (1/2/4)
// and emits a load into rd from [base, #off].  `signed` selects sign-extending
// variants (LDRSB/LDRSH) for sizes 1/2 when the loaded value is a signed narrow
// int; zero-extending variants (LDRB/LDRH) otherwise.  Size-4 loads are full
// word (LDR), where the signed flag is irrelevant.  A size of 8 (a 64-bit
// scalar) is NOT loadable in a single arm32 register — it needs a pair, which
// is DEFERRED — so fail loud rather than truncate to the low word.  Mirrors
// aarch64_ops.bn's emitScalarLoad minus the size-8 word case.
func emitScalarLoad(a @asm.Assembler, rd int, base int, off int, sz int, signed bool) {
	if sz == 1 {
		if signed {
			arm32.Ldrsb(a, arm32.COND_AL, rd, arm32.MemImm(base, off))
		} else {
			arm32.Ldrb(a, arm32.COND_AL, rd, arm32.MemImm(base, off))
		}
		return
	}
	if sz == 2 {
		if signed {
			arm32.Ldrsh(a, arm32.COND_AL, rd, arm32.MemImm(base, off))
		} else {
			arm32.Ldrh(a, arm32.COND_AL, rd, arm32.MemImm(base, off))
		}
		return
	}
	if sz == 4 {
		arm32.Ldr(a, arm32.COND_AL, rd, arm32.MemImm(base, off))
		return
	}
	a.SetError("native arm32: 8-byte scalar load needs register pair (P3+)")
}

// emitScalarStore is the symmetric STRB/STRH/STR dispatcher.  A size-8 store
// (64-bit scalar) needs a register pair (DEFERRED); fail loud rather than write
// only the low word and leave the high word of the destination stale.
func emitScalarStore(a @asm.Assembler, rt int, base int, off int, sz int) {
	if sz == 1 {
		arm32.Strb(a, arm32.COND_AL, rt, arm32.MemImm(base, off))
		return
	}
	if sz == 2 {
		arm32.Strh(a, arm32.COND_AL, rt, arm32.MemImm(base, off))
		return
	}
	if sz == 4 {
		arm32.Str(a, arm32.COND_AL, rt, arm32.MemImm(base, off))
		return
	}
	a.SetError("native arm32: 8-byte scalar store needs register pair (P3+)")
}
