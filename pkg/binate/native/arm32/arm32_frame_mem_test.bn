package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// emitFrameScalarStore with a size-1 (byte) offset past the extra-load 8-bit
// field (255) must materialize the base in IP rather than trip the encoder — so
// it emits more than a single STRB.
func TestEmitFrameScalarStoreLargeByteOffset() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitFrameScalarStore(a, arm32.R4, 300, 1)
	if bytesWritten(a) <= 4 {
		return fail("a byte store past offset 255 must materialize the base in IP")
	}
	if a.HasError {
		return fail("a large byte-store offset must not error (routed through IP)")
	}
	return ""
}

// emitBaseScalarLoad's fast path (offset within the size's immediate field) is a
// single LDR — identical to a bare emitScalarLoad — so an in-range word load from
// a non-SP base is exactly 4 bytes and never touches the scratch.
func TestEmitBaseScalarLoadSmallOffsetIsSingleLoad() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitBaseScalarLoad(a, arm32.R4, arm32.R5, 8, 4, false, arm32.IP)
	if bytesWritten(a) != 4 {
		return fail("an in-range word load should be a single LDR (4 bytes)")
	}
	if a.HasError {
		return fail("an in-range load must not error")
	}
	return ""
}

// A word field offset past the 12-bit LDR immediate (4095) must materialize the
// address in the scratch and load register-form, not trip imm12Offset's range
// error — so it emits more than one instruction and sets no error.
func TestEmitBaseScalarLoadLargeWordOffsetMaterializes() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitBaseScalarLoad(a, arm32.R4, arm32.R5, 5000, 4, false, arm32.IP)
	if bytesWritten(a) <= 4 {
		return fail("a word offset past 4095 must materialize the scratch, not a lone LDR")
	}
	if a.HasError {
		return fail("a large word-load offset must not error (routed through the scratch)")
	}
	return ""
}

// A sub-word (byte) load uses the 8-bit LDRB immediate (max 255); an offset past
// it likewise materializes in the scratch rather than erroring.
func TestEmitBaseScalarLoadLargeByteOffsetMaterializes() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitBaseScalarLoad(a, arm32.R4, arm32.R5, 300, 1, false, arm32.IP)
	if bytesWritten(a) <= 4 {
		return fail("a byte load past offset 255 must materialize the address in the scratch")
	}
	if a.HasError {
		return fail("a large byte-load offset must not error (routed through the scratch)")
	}
	return ""
}
