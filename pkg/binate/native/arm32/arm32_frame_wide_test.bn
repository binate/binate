package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Frames and aggregates past 2 GiB on arm32, a 32-bit target whose frame may approach
// 4 GiB: offsets reach the emitters as int64 and are narrowed only to the target's 32-bit
// word (wordArm32), and the copy / zero loops count their index unsigned, so a size past
// 2^31 does not end them after one unit.  The words are llvm-mc's: BHS / BCS has the
// condition and branch byte 0x2a, BPL 0x5a.

// armWords returns a's text as 32-bit little-endian words.
func armWords(a @asm.Assembler) @[]uint32 {
	var n int = a.Sections[0].Len / 4
	var w @[]uint32 = make_slice(uint32, n)
	var d @[]uint8 = a.Sections[0].Data
	for i := 0; i < n; i++ {
		w[i] = cast(uint32, d[4 * i]) | (cast(uint32, d[4 * i + 1]) << 8) |
				(cast(uint32, d[4 * i + 2]) << 16) | (cast(uint32, d[4 * i + 3]) << 24)
	}
	return w
}

// countTopByte counts the words of a whose top byte (condition and B opcode) is top.
func countTopByte(a @asm.Assembler, top uint32) int {
	var w @[]uint32 = armWords(a)
	var n int = 0
	for i := 0; i < len(w); i++ {
		if (w[i] >> 24) == top { n = n + 1 }
	}
	return n
}

// hasWord reports whether a's text holds the word want.
func hasWord(a @asm.Assembler, want uint32) bool {
	var w @[]uint32 = armWords(a)
	for i := 0; i < len(w); i++ {
		if w[i] == want { return true }
	}
	return false
}

// A frame past 2 GiB compiles: the prologue subtracts it through IP (SUB SP, SP, IP),
// the two 1.5 GiB locals are zeroed by loops that branch back on BCS, and the local
// past 2 GiB is zeroed through an offset materialized in IP (STR rX, [SP, IP]).
func TestEmitFuncFramePast2GiBArm32() testing.TestResult {
	var old types.TargetInfo = types.GetTarget()
	types.SetTarget(types.TargetInfo{PointerSize: 4, IntSize: 4, MaxAlign: 8})
	defer { types.SetTarget(old) }
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var strs @[]ir.StringConst
	emitFunc(a, "main", bigLocalsFuncArm32("main.huge", @[]int64{0x60000000, 0x60000000, 64}), strs)
	if a.HasError { return fail("a frame past 2 GiB should compile on arm32") }
	if !hasWord(a, 0xe04dd00c) { return fail("the prologue should subtract the frame through IP") }
	if countTopByte(a, 0x2a) != 2 {
		return fail("each 1.5 GiB zero-fill loop should branch back on BCS")
	}
	if countTopByte(a, 0x5a) != 0 { return fail("no loop may end on the sign flag (BPL)") }
	return ""
}

// A frame offset past 2^31 is materialized from its 32-bit target word: MOVW / MOVT IP
// (or one MOV for a rotated immediate), then [SP, IP]; an address that is a rotated
// immediate is a single ADD.
func TestFrameOffsetPast2GiBWordArm32() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitFrameLoad(a, arm32.R0, 0x80001234)
	var w @[]uint32 = armWords(a)
	if a.HasError || len(w) != 3 || w[0] != 0xe301c234 || w[1] != 0xe348c000 || w[2] != 0xe79d000c {
		return fail("LDR R0 at SP + 0x80001234 should be MOVW / MOVT IP; LDR R0, [SP, IP]")
	}
	var c @asm.Assembler = asm.New(4)
	c.SetSection("text", -1)
	emitFrameLoad(c, arm32.R0, 0x80000010)
	var u @[]uint32 = armWords(c)
	if c.HasError || len(u) != 2 || u[0] != 0xe3a0c142 || u[1] != 0xe79d000c {
		return fail("LDR R0 at SP + 0x80000010 should be MOV IP, #0x80000010; LDR R0, [SP, IP]")
	}
	var b @asm.Assembler = asm.New(4)
	b.SetSection("text", -1)
	emitFrameAddr(b, arm32.R0, 0x80000000)
	var v @[]uint32 = armWords(b)
	if b.HasError || len(v) != 1 || v[0] != 0xe28d0102 {
		return fail("SP + 0x80000000 should be ADD R0, SP, #0x80000000")
	}
	return ""
}

// The frame zero-fill's loop for a region past 2^31 branches back on BCS: its first
// index, size - 4, has the sign bit set, which BPL would read as the end.
func TestFrameZeroPast2GiBLoopsUnsignedArm32() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitFrameZeroArm32(a, common.NewRegMap(callconv.AAPCS32()), 16, 0x80000010, arm32.R5)
	if a.HasError { return fail("unexpected assembler error") }
	if countTopByte(a, 0x2a) != 1 || countTopByte(a, 0x5a) != 0 {
		return fail("the zero-fill loop should branch back on BCS, not BPL")
	}
	return ""
}

// The indexed copy loop and the zero-through-pointer loop count unsigned too.
func TestCopyAndZeroLoopsCountUnsignedArm32() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitIndexedCopyLoopArm32(a, arm32.R0, arm32.R1, 256, false, arm32.R2, arm32.R3)
	if a.HasError || countTopByte(a, 0x2a) != 1 || countTopByte(a, 0x5a) != 0 {
		return fail("the indexed copy loop should branch back on BCS")
	}
	var b @asm.Assembler = asm.New(4)
	b.SetSection("text", -1)
	emitZeroThroughArm32(b, arm32.R0, types.MakeArrayType(types.TypInt32(), 256), arm32.R1)
	if b.HasError || countTopByte(b, 0x2a) != 1 || countTopByte(b, 0x5a) != 0 {
		return fail("the zero-through loop should branch back on BCS")
	}
	return ""
}

// Under register pressure a string-to-array copy stores its bytes through a register it
// claimed, never the one it was handed as the buffer's base.  With R4..R8 holding
// retained values and R9, R10 free, the zero-fill takes R9 and its loop R10, so the
// base evicts R4: the byte stores go through R9 (STRB R9, [R4]), not R4 (STRB R4, [R4]).
func TestStringToArrayByteScratchClaimedArm32() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 7)
	rm.AllocOffsets = common.AppendInt64(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt64(rm.AllocSizes, 100)
	for r := 4; r <= 8; r++ { rm.AssignReg(100 + r, arm32.R0 + r) }
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.StrVal = buf.CopyStr("hi")
	ins.Typ = types.MakeArrayType(types.TypChar(), 100)
	emitStringToArray(a, rm, ins)
	if a.HasError { return fail("unexpected assembler error") }
	if hasWord(a, 0xe5c44000) { return fail("a byte stored through the base register R4") }
	if !hasWord(a, 0xe5c49000) { return fail("the first byte should be stored as STRB R9, [R4]") }
	return ""
}
