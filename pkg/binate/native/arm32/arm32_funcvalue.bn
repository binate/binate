package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// ============================================================
// Function-value backing (walking-skeleton subset)
// ============================================================
//
// The func-value triple — a per-function `@__vt` vtable { dtor, call }, an
// LLVM-shape `@__handle` block { vtable, data=null }, and a per-function
// marshaling SHIM — is what every OP_FUNC_VALUE / OP_FUNC_HANDLE reference AND
// the package descriptor's FunctionInfo.Value point at.  Even a trivial
// program needs the synthesized `__Package` accessor's triple, because the
// descriptor self-lists it (see arm32_pkg_descriptor.bn); so this is NOT a
// no-op even for an empty main.
//
// The backend emits the vtable/handle data (shared irdata.BuildFuncValue) for every
// collected reference, and a marshaling SHIM for the return shapes it supports:
// SCALAR/VOID (drop the leading data word, marshal user args down, tail-branch),
// big-aggregate SRET (a >4-byte result returns through a hidden R0 buffer, which
// — unlike AAPCS64's dedicated X8 — stays in R0 across the shim, so the shim
// keeps R0, drops data, marshals user args down, and tail-branches), and small
// (<=4-byte) aggregate PACK (a by-value R0 result: the shim saves the retbuf,
// calls the underlying, and stores the returned R0 word through the retbuf).  The
// arg marshal (emitShimArgMarshalArm32 in arm32_funcvalue_marshal.bn) re-expands a
// by-address in-register aggregate ARG — a coerced array / named struct / source-level
// anon struct (P1; a source-level anon struct is COERCED because IR-gen names it
// `__anon_N`, so it rides this branch like a named struct) OR a genuinely non-coerced
// slice / iface-value / managed-slice (P2, option B; all >= 8 bytes) — from its
// by-address dispatch pointer into the underlying's AAPCS32 GP regs (GP-only — arm32
// is soft-float, so no HFA/FP path).  There is no <=4-byte non-coerced aggregate: the
// only sub-word aggregate is a source-level anon struct, which is coerced.  Arg words
// beyond the register budget route to the framed-BL stack-spill shim
// (emitFuncvalSpillShimArm32 in arm32_funcvalue_spill.bn), which reserves an
// outgoing-args area, marshals the overflow words into it, BLs the underlying, and
// tears the frame down.  A soft-float FLOAT arg / return rides the GP path like its
// same-width integer (a float32 in one word, a float64 in the even-aligned register
// pair), so this non-closure shim marshals it with no float-specific code.  A
// CAPTURING closure routes to emitClosureShimArm32, which still fails LOUDLY on a
// float part or an indirect-large capture (P5.3 increment 2) rather than emitting a
// wrong shim.
// Mirrors aarch64_funcvalue{,_shim}.bn / x64_funcvalue_shim.bn at the reduced
// surface, with AAPCS32's R0-sret-stays convention (like x64's RDI-stays) in place
// of AAPCS64's X0->X8 move.

// shimSymFor returns the bare ELF label for a function's per-function shim
// global: "<mangled-fn>__shim".
func shimSymFor(pkgName *[]readonly char, fnName *[]readonly char) @[]char {
	var fn @[]char = symFor(pkgName, fnName)
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(fn)
	cb.Write("__shim")
	return buf.CopyStr(cb.String())
}

// vtableSymFor returns the bare ELF label for a function's vtable global:
// "<mangled-fn>__vt".
func vtableSymFor(pkgName *[]readonly char, fnName *[]readonly char) @[]char {
	var fn @[]char = symFor(pkgName, fnName)
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(fn)
	cb.Write("__vt")
	return buf.CopyStr(cb.String())
}

// collectFuncValueRefs walks the module for the functions whose (shim, vtable,
// handle) triple must be emitted: every IsLinkOnce helper (dtors / copy
// helpers), every OP_FUNC_VALUE / OP_FUNC_HANDLE reference, every .bni-exported
// func (whose descriptor Value symrefs its handle), every non-generic impl
// method, and the synthesized `__Package` accessor.  Returns parallel
// (name, func-value-type) slices.  Mirrors collectFuncValueRefs in
// aarch64_funcvalue.bn.
func collectFuncValueRefs(mod @ir.Module) (@[]@[]char, @[]@types.Type) {
	var seen @[]@[]char
	var sigs @[]@types.Type
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		if !f.IsLinkOnce { continue }
		var fvTyp @types.Type = funcValueTypeOf(f)
		seen = slices.Append[@[]char](seen, f.Name)
		sigs = slices.Append[@types.Type](sigs, fvTyp)
	}
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		for j := 0; j < len(f.Blocks); j++ {
			var blk @ir.Block = f.Blocks[j]
			for k := 0; k < len(blk.Instrs); k++ {
				var ins @ir.Instr = blk.Instrs[k]
				if ins.Op != iropcode.OP_FUNC_VALUE && ins.Op != iropcode.OP_FUNC_HANDLE {
					continue
				}
				if seenContains(seen, ins.StrVal) { continue }
				var sigTyp @types.Type = ins.Typ
				if ins.Op == iropcode.OP_FUNC_HANDLE {
					sigTyp = lookupFuncValueTypeArm32(mod, ins.StrVal)
					if sigTyp == nil { continue }
				}
				seen = slices.Append[@[]char](seen, ins.StrVal)
				sigs = slices.Append[@types.Type](sigs, sigTyp)
			}
		}
	}
	// Exported funcs + struct dtors: the descriptor Functions table symrefs
	// @__handle.<fn>, which must be a defined symbol.
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		// + own-package struct dtors (IsStructDtor), copies (IsStructCopy), + lang's primitive methods
		// (IsPrimitiveMethod), injectable when native-only.
		if !f.Exported && !f.IsStructDtor && !f.IsStructCopy && !f.IsPrimitiveMethod { continue }
		if seenContains(seen, f.Name) { continue }
		var sigTyp @types.Type = lookupFuncValueTypeArm32(mod, f.Name)
		if sigTyp == nil { continue }
		seen = slices.Append[@[]char](seen, f.Name)
		sigs = slices.Append[@types.Type](sigs, sigTyp)
	}
	seen, sigs = collectImplMethodRefsArm32(mod, seen, sigs)
	// The synthesized __Package accessor (keyed on FQ <pkg>.__Package).
	if mod.PackageAccessorSig != nil {
		var qn @[]char = mangle.QualifyName(common.StripQuotes(mod.Name), "__Package")
		if !seenContains(seen, qn) {
			seen = slices.Append[@[]char](seen, qn)
			sigs = slices.Append[@types.Type](sigs, mod.PackageAccessorSig)
		}
	}
	return seen, sigs
}

// collectImplMethodRefsArm32 appends each impl's interface-method references so
// their (shim, vt, handle) triples get emitted.  The raw @__ivt vtable
// (emitOneImplVtable, useHandles=true) now holds @__handle.<method> in EVERY method
// slot for EVERY impl; without this pre-pass those handles dangle as undefined
// symbols (an iface impl method on an unexported receiver type is not reached by the
// .bni-exported force-emit loop).  Mirrors collectImplMethodRefsAA64.
//
// Unlike the parallel @__ivtshim vtable / the descriptor Vtables table (both gated
// non-generic, because a bytecode importer re-lowers its own copy of a generic
// instantiation), this is NOT gated: emitOneImplVtable emits the raw @__ivt for
// generic-instantiation impls too, so their method handles must exist.  A generic-
// inst method whose func-value type can't be resolved (not in mod.Funcs) is skipped
// by collectIfaceMethodRefsArm32, so nothing dangles the other way.
func collectImplMethodRefsArm32(mod @ir.Module, seen @[]@[]char,
		sigs @[]@types.Type) (@[]@[]char, @[]@types.Type) {
	for i := 0; i < len(mod.Impls); i++ {
		var info @ir.ImplInfo = mod.Impls[i]
		if info == nil { continue }
		seen, sigs = collectIfaceMethodRefsArm32(mod, info, info.IfacePkg, info.IfaceName, seen, sigs)
	}
	return seen, sigs
}

// collectIfaceMethodRefsArm32 adds one (impl, iface) level's method refs and
// recurses into iface parents (own-then-parents walk).  Mirrors
// collectIfaceMethodRefsAA64.
func collectIfaceMethodRefsArm32(mod @ir.Module, info @ir.ImplInfo, ifacePkg *[]readonly char,
		ifaceName *[]readonly char, seen @[]@[]char, sigs @[]@types.Type) (@[]@[]char, @[]@types.Type) {
	var parentPkgs @[]@[]char = ir.IfaceParentPkgs(mod, ifacePkg, ifaceName)
	var parentNames @[]@[]char = ir.IfaceParentNames(mod, ifacePkg, ifaceName)
	for i := 0; i < len(parentPkgs); i++ {
		seen, sigs = collectIfaceMethodRefsArm32(mod, info, parentPkgs[i], parentNames[i], seen, sigs)
	}
	var ownMethods @[]@[]char = ir.IfaceOwnMethodNames(mod, ifacePkg, ifaceName)
	for i := 0; i < len(ownMethods); i++ {
		var qualified @[]char = buildMethodFuncNameArm32(info.RecvPkg, info.RecvTypeName, ownMethods[i])
		var slotName @[]char = ir.LookupVtableSlotName(mod, qualified)
		var sigTyp @types.Type = lookupFuncValueTypeArm32(mod, slotName)
		if sigTyp == nil { continue }
		if seenContains(seen, slotName) { continue }
		seen = slices.Append[@[]char](seen, slotName)
		sigs = slices.Append[@types.Type](sigs, sigTyp)
	}
	return seen, sigs
}

// buildMethodFuncNameArm32 mirrors the LLVM buildMethodFuncName —
// `<recvPkg>.<recvName>.<methodName>`.
func buildMethodFuncNameArm32(recvPkg *[]readonly char, recvName *[]readonly char,
		methodName *[]readonly char) @[]char {
	var b @[]char
	b = common.AppendStr(b, recvPkg)
	b = common.AppendStr(b, ".")
	b = common.AppendStr(b, recvName)
	b = common.AppendStr(b, ".")
	b = common.AppendStr(b, methodName)
	return b
}

// funcValueTypeOf builds a func-value type from an ir.Func's params/results.
func funcValueTypeOf(f @ir.Func) @types.Type {
	var params @[]@types.Param
	for j := 0; j < len(f.Params); j++ {
		var p @types.Param = make(types.Param)
		p.Name = f.Params[j].Name
		p.Type = f.Params[j].Typ
		params = slices.Append[@types.Param](params, p)
	}
	return types.MakeFuncValueType(params, f.Results)
}

// seenContains reports whether name is already in the seen set.
func seenContains(seen @[]@[]char, name *[]readonly char) bool {
	for s := 0; s < len(seen); s++ {
		if charEqArm32(seen[s], name) { return true }
	}
	return false
}

// emitFuncValueVtables emits the per-function { dtor, call } vtable and
// { vtable, data=null } handle for every collected reference, via the shared
// irdata.BuildFuncValue (byte layout can't drift from the LLVM / aarch64 / x64
// backends).  Mirrors aarch64_funcvalue.bn's emitFuncValueVtables: the dtor slot
// is the closure-struct dtor's HANDLE for a capturing @func whose struct needs
// destruction (funcValueDtorHandleSymArm32), else a null pointer.
func emitFuncValueVtables(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	var seen @[]@[]char
	seen, _ = collectFuncValueRefs(mod)
	if len(seen) == 0 { return }
	for i := 0; i < len(seen); i++ {
		var vtLabel @[]char = vtableSymFor(pkgName, seen[i])
		var shimLabel @[]char = shimSymFor(pkgName, seen[i])
		var handleLabel @[]char = handleSymFor(pkgName, seen[i])
		// A universal trampoline (vm.TrampolineScalar / 64 / Aggregate) bypasses the
		// __shim: its call slot is the RAW function, because its `data` parameter IS
		// the closure record the shim would otherwise strip.  Shared decision via
		// mangle.IsUniversalTrampoline (same as LLVM / aarch64 / x64), so no drift.
		var callLabel @[]char = shimLabel
		if mangle.IsUniversalTrampoline(mangle.FuncName(pkgName, seen[i])) {
			callLabel = symFor(pkgName, seen[i])
		}
		a.SetGlobal(callLabel)
		var dtorSym @[]char = funcValueDtorHandleSymArm32(a, pkgName, mod, seen[i])
		var dgs @[]@irdata.DataGlobal = irdata.BuildFuncValue(vtLabel, dtorSym, callLabel, handleLabel)
		for j := 0; j < len(dgs); j++ {
			common.EmitDataGlobal(a, dgs[j])
		}
	}
}

// emitFuncValueShims emits a per-function marshaling shim for every collected
// reference (see emitFuncValueShimBody for the per-return-shape lowering: a
// scalar/void tail-branch, or the big-aggregate R0-sret shim).  A CAPTURING
// closure (or method value) routes to emitClosureShimArm32, which UP-shifts the
// user args past the prepended captures and unpacks the capture-struct fields
// from the R0 data pointer (P4-d Phase A); out-of-Phase-A closure shapes fail
// LOUDLY there.  Mirrors aarch64's emitFuncValueShims.
func emitFuncValueShims(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	var seen @[]@[]char
	var sigs @[]@types.Type
	seen, sigs = collectFuncValueRefs(mod)
	if len(seen) == 0 { return }
	a.SetSection("text", -1)
	for i := 0; i < len(seen); i++ {
		var fnLabel @[]char = symFor(pkgName, seen[i])
		var shimLabel @[]char = shimSymFor(pkgName, seen[i])
		var fvTyp @types.Type = sigs[i]
		a.DefineLabel(shimLabel)
		a.SetWeak(shimLabel)
		var closureFunc @ir.Func = lookupClosureFuncArm32(mod, seen[i])
		if closureFunc != nil {
			emitClosureShimArm32(a, fnLabel, fvTyp, closureFunc)
			if a.HasError { return }
			continue
		}
		emitFuncValueShimBody(a, fnLabel, fvTyp)
		if a.HasError { return }
	}
}

// lookupClosureFuncArm32 returns the Func with the given name iff it is a
// capturing-literal closure (IsClosure=true); nil for non-closure refs and
// cross-module references.  Mirrors lookupClosureFunc_x64.
func lookupClosureFuncArm32(mod @ir.Module, name *[]readonly char) @ir.Func {
	for i := 0; i < len(mod.Funcs); i++ {
		if !charEqArm32(mod.Funcs[i].Name, name) { continue }
		if !mod.Funcs[i].IsClosure { return nil }
		return mod.Funcs[i]
	}
	return nil
}

// emitFuncValue lowers OP_FUNC_VALUE — function-value construction.  It builds
// the 8-byte {vtable_addr, data} aggregate (ILP32) in the instruction's
// pre-allocated data region (PlanFrame reserved it for OP_FUNC_VALUE): the vtable
// global's address (emitFuncValueVtables emitted it) goes at
// FuncValueVtableOffset, and the data slot at FuncValueDataOffset holds a null
// pointer for a non-capturing Phase-1 literal (len(ins.Args) == 0) or the
// capture-struct pointer (ins.Args[0]) for a B.2 capturing closure.  The result
// is a pointer to the data region.  Mirrors aarch64_dispatch.bn's OP_FUNC_VALUE
// arm with WordBytes = 4 and MOVW/MOVT-ABS (no ADRP) address materialization.
func emitFuncValue(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.StrVal) == 0 { return }
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	var vtLabel @[]char = vtableSymFor(pkgName, ins.StrVal)
	a.SetGlobal(vtLabel)
	// Slot 0 = &vtable.
	var addrTmp int = scratchReg(rm)
	emitSymAddr(a, addrTmp, vtLabel)
	emitFrameStore(a, addrTmp, dataOff + types.FuncValueVtableOffset())
	// Slot 1 = data: null for a non-capturing literal, else the capture-struct
	// pointer carried in ins.Args[0] (a B.2 capturing closure).  arm32 has no zero
	// register, so materialize 0 in a scratch for the null case.
	if len(ins.Args) == 0 {
		var zeroTmp int = scratchReg(rm)
		emitConstInt32(a, zeroTmp, 0)
		emitFrameStore(a, zeroTmp, dataOff + types.FuncValueDataOffset())
	} else {
		var dataReg int = getOperand(a, rm, ins.Args[0].ID)
		emitFrameStore(a, dataReg, dataOff + types.FuncValueDataOffset())
	}
	// Produce the data-region pointer as the result.
	var rd int = nextReg(rm, ins.ID)
	emitFrameAddr(a, rd, dataOff)
}
