package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// ============================================================
// Function-value backing (walking-skeleton subset)
// ============================================================
//
// The func-value triple — a per-function `@__vt` vtable { dtor, call }, an
// LLVM-shape `@__handle` block { vtable, data=null }, and a per-function
// marshaling SHIM — is what every OP_FUNC_VALUE / OP_FUNC_HANDLE reference AND
// the package descriptor's FunctionInfo.Value point at.  Even a trivial
// program needs the synthesized `__Package` accessor's triple, because the
// descriptor self-lists it (see arm32_pkg_descriptor.bn); so this is NOT a
// no-op even for an empty main.
//
// The skeleton emits the vtable/handle data (shared ir.BuildFuncValue) for
// every collected reference, and a SCALAR/VOID shim (drop the leading data
// word, tail-branch) for the shapes it supports: non-closure functions whose
// args + return fit R0..R3 as plain single-word scalar/pointer values.  Shapes
// it can't yet marshal — closures, float or aggregate args/returns, 64-bit
// register-pair scalars, or arg words beyond the register budget — fail LOUDLY
// via a.SetError (they are P4 work) rather than emitting a wrong shim.  Mirrors
// aarch64_funcvalue{,_shim}.bn at the reduced surface.

// SHIM_ARG_REG_BUDGET is the number of user-arg words a scalar/void shim can
// re-marshal in the register-only fast path: R0 carries the dropped `data`
// prefix, leaving R1..R3 = 3 words for user args.
const SHIM_ARG_REG_BUDGET int = 3

// shimSymFor returns the bare ELF label for a function's per-function shim
// global: "<mangled-fn>__shim".
func shimSymFor(pkgName *[]readonly char, fnName *[]readonly char) @[]char {
	var fn @[]char = symFor(pkgName, fnName)
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(fn)
	cb.Write("__shim")
	return buf.CopyStr(cb.String())
}

// vtableSymFor returns the bare ELF label for a function's vtable global:
// "<mangled-fn>__vt".
func vtableSymFor(pkgName *[]readonly char, fnName *[]readonly char) @[]char {
	var fn @[]char = symFor(pkgName, fnName)
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(fn)
	cb.Write("__vt")
	return buf.CopyStr(cb.String())
}

// collectFuncValueRefs walks the module for the functions whose (shim, vtable,
// handle) triple must be emitted: every IsLinkOnce helper (dtors / copy
// helpers), every OP_FUNC_VALUE / OP_FUNC_HANDLE reference, every .bni-exported
// func (whose descriptor Value symrefs its handle), every non-generic impl
// method, and the synthesized `__Package` accessor.  Returns parallel
// (name, func-value-type) slices.  Mirrors collectFuncValueRefs in
// aarch64_funcvalue.bn.
func collectFuncValueRefs(mod @ir.Module) (@[]@[]char, @[]@types.Type) {
	var seen @[]@[]char
	var sigs @[]@types.Type
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		if !f.IsLinkOnce { continue }
		var fvTyp @types.Type = funcValueTypeOf(f)
		seen = slices.Append[@[]char](seen, f.Name)
		sigs = slices.Append[@types.Type](sigs, fvTyp)
	}
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		for j := 0; j < len(f.Blocks); j++ {
			var blk @ir.Block = f.Blocks[j]
			for k := 0; k < len(blk.Instrs); k++ {
				var ins @ir.Instr = blk.Instrs[k]
				if ins.Op != iropcode.OP_FUNC_VALUE &&
						ins.Op != iropcode.OP_FUNC_HANDLE {
					continue
				}
				if seenContains(seen, ins.StrVal) { continue }
				var sigTyp @types.Type = ins.Typ
				if ins.Op == iropcode.OP_FUNC_HANDLE {
					sigTyp = lookupFuncValueTypeArm32(mod, ins.StrVal)
					if sigTyp == nil { continue }
				}
				seen = slices.Append[@[]char](seen, ins.StrVal)
				sigs = slices.Append[@types.Type](sigs, sigTyp)
			}
		}
	}
	// Exported funcs + struct dtors: the descriptor Functions table symrefs
	// @__handle.<fn>, which must be a defined symbol.
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		if !f.Exported && !f.IsStructDtor { continue }
		if seenContains(seen, f.Name) { continue }
		var sigTyp @types.Type = lookupFuncValueTypeArm32(mod, f.Name)
		if sigTyp == nil { continue }
		seen = slices.Append[@[]char](seen, f.Name)
		sigs = slices.Append[@types.Type](sigs, sigTyp)
	}
	seen, sigs = collectImplMethodRefsArm32(mod, seen, sigs)
	// The synthesized __Package accessor (keyed on FQ <pkg>.__Package).
	if mod.PackageAccessorSig != nil {
		var qn @[]char = mangle.QualifyName(stripQuotes(mod.Name), "__Package")
		if !seenContains(seen, qn) {
			seen = slices.Append[@[]char](seen, qn)
			sigs = slices.Append[@types.Type](sigs, mod.PackageAccessorSig)
		}
	}
	return seen, sigs
}

// collectImplMethodRefsArm32 appends each non-generic impl's interface-method
// references so their handle triples get emitted.  Mirrors
// collectImplMethodRefsAA64.
func collectImplMethodRefsArm32(mod @ir.Module, seen @[]@[]char,
		sigs @[]@types.Type) (@[]@[]char, @[]@types.Type) {
	for i := 0; i < len(mod.Impls); i++ {
		var info @ir.ImplInfo = mod.Impls[i]
		if info == nil { continue }
		if common.RecvTypeIsGenericInst(info.RecvTypeName) { continue }
		seen, sigs = collectIfaceMethodRefsArm32(mod, info, info.IfacePkg,
			info.IfaceName, seen, sigs)
	}
	return seen, sigs
}

// collectIfaceMethodRefsArm32 adds one (impl, iface) level's method refs and
// recurses into iface parents (own-then-parents walk).  Mirrors
// collectIfaceMethodRefsAA64.
func collectIfaceMethodRefsArm32(mod @ir.Module, info @ir.ImplInfo,
		ifacePkg *[]readonly char, ifaceName *[]readonly char,
		seen @[]@[]char, sigs @[]@types.Type) (@[]@[]char, @[]@types.Type) {
	var parentPkgs @[]@[]char = ir.IfaceParentPkgs(mod, ifacePkg, ifaceName)
	var parentNames @[]@[]char = ir.IfaceParentNames(mod, ifacePkg, ifaceName)
	for i := 0; i < len(parentPkgs); i++ {
		seen, sigs = collectIfaceMethodRefsArm32(mod, info, parentPkgs[i],
			parentNames[i], seen, sigs)
	}
	var ownMethods @[]@[]char = ir.IfaceOwnMethodNames(mod, ifacePkg, ifaceName)
	for i := 0; i < len(ownMethods); i++ {
		var qualified @[]char = buildMethodFuncNameArm32(info.RecvPkg,
			info.RecvTypeName, ownMethods[i])
		var slotName @[]char = ir.LookupVtableSlotName(mod, qualified)
		var sigTyp @types.Type = lookupFuncValueTypeArm32(mod, slotName)
		if sigTyp == nil { continue }
		if seenContains(seen, slotName) { continue }
		seen = slices.Append[@[]char](seen, slotName)
		sigs = slices.Append[@types.Type](sigs, sigTyp)
	}
	return seen, sigs
}

// buildMethodFuncNameArm32 mirrors the LLVM buildMethodFuncName —
// `<recvPkg>.<recvName>.<methodName>`.
func buildMethodFuncNameArm32(recvPkg *[]readonly char,
	recvName *[]readonly char, methodName *[]readonly char) @[]char {
	var b @[]char
	b = common.AppendStr(b, recvPkg)
	b = common.AppendStr(b, ".")
	b = common.AppendStr(b, recvName)
	b = common.AppendStr(b, ".")
	b = common.AppendStr(b, methodName)
	return b
}

// funcValueTypeOf builds a func-value type from an ir.Func's params/results.
func funcValueTypeOf(f @ir.Func) @types.Type {
	var params @[]@types.Param
	for j := 0; j < len(f.Params); j++ {
		var p @types.Param = make(types.Param)
		p.Name = f.Params[j].Name
		p.Type = f.Params[j].Typ
		params = slices.Append[@types.Param](params, p)
	}
	return types.MakeFuncValueType(params, f.Results)
}

// seenContains reports whether name is already in the seen set.
func seenContains(seen @[]@[]char, name *[]readonly char) bool {
	for s := 0; s < len(seen); s++ {
		if charEqArm32(seen[s], name) { return true }
	}
	return false
}

// emitFuncValueVtables emits the per-function { dtor, call } vtable and
// { vtable, data=null } handle for every collected reference, via the shared
// ir.BuildFuncValue (byte layout can't drift from the LLVM / aarch64 / x64
// backends).  Mirrors aarch64_funcvalue.bn's emitFuncValueVtables (skeleton:
// non-capturing only, so the dtor slot is always a null pointer).
func emitFuncValueVtables(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	var seen @[]@[]char
	var ignored @[]@types.Type
	seen, ignored = collectFuncValueRefs(mod)
	if len(seen) == 0 { return }
	for i := 0; i < len(seen); i++ {
		var vtLabel @[]char = vtableSymFor(pkgName, seen[i])
		var shimLabel @[]char = shimSymFor(pkgName, seen[i])
		var handleLabel @[]char = handleSymFor(pkgName, seen[i])
		a.SetGlobal(shimLabel)
		var emptyDtor @[]char
		var dgs @[]@ir.DataGlobal = ir.BuildFuncValue(vtLabel, emptyDtor,
			shimLabel, handleLabel)
		for j := 0; j < len(dgs); j++ {
			common.EmitDataGlobal(a, dgs[j])
		}
	}
}

// emitFuncValueShims emits a per-function marshaling shim for every collected
// reference.  The skeleton handles the scalar/void shape: the shim is entered
// with the func value's `data` pointer in R0 and the user args in R1.., drops
// data, shifts the args down to R0.., and tail-branches to the real function.
// A CAPTURING closure is rejected LOUDLY up front (its data pointer carries the
// captures, which the scalar shim would drop — a silent miscompile), and any
// shape the scalar shim can't marshal (a 2-word register-pair scalar, a
// float/aggregate arg or return, or more arg words than R1..R3 hold) likewise
// fails LOUDLY.  Rejecting closures before vtable emission also makes the
// null-dtor-slot moot — a managed closure's captures never reach the
// force-nulled dtor path.  Mirrors the scalar/void arm of aarch64's
// emitFuncValueShims.
func emitFuncValueShims(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	var seen @[]@[]char
	var sigs @[]@types.Type
	seen, sigs = collectFuncValueRefs(mod)
	if len(seen) == 0 { return }
	a.SetSection("text", -1)
	for i := 0; i < len(seen); i++ {
		var fnLabel @[]char = symFor(pkgName, seen[i])
		var shimLabel @[]char = shimSymFor(pkgName, seen[i])
		var fvTyp @types.Type = sigs[i]
		a.DefineLabel(shimLabel)
		a.SetWeak(shimLabel)
		// A capturing closure func value carries its capture/data pointer in R0;
		// the scalar shim drops R0, so reject it LOUDLY rather than silently
		// miscompiling the capture away.
		if lookupClosureFuncArm32(mod, seen[i]) != nil {
			a.SetError("native arm32: closure func value not implemented (P4)")
			return
		}
		emitScalarVoidShim(a, fnLabel, fvTyp)
		if a.HasError { return }
	}
}

// lookupClosureFuncArm32 returns the Func with the given name iff it is a
// capturing-literal closure (IsClosure=true); nil for non-closure refs and
// cross-module references.  Mirrors lookupClosureFunc_x64.
func lookupClosureFuncArm32(mod @ir.Module, name @[]char) @ir.Func {
	for i := 0; i < len(mod.Funcs); i++ {
		if !charEqArm32(mod.Funcs[i].Name, name) { continue }
		if !mod.Funcs[i].IsClosure { return nil }
		return mod.Funcs[i]
	}
	return nil
}

// emitScalarVoidShim emits the scalar/void shim body: drop the data word (R0),
// shift user args R1..RN down to R0..R(N-1), tail-branch to fnLabel.  Fails
// LOUDLY (a.SetError) on shapes outside the skeleton's reach: float/aggregate
// returns, aggregate/float args, a 2-word register-pair scalar arg (a 64-bit
// int on ILP32 — it is neither aggregate nor float, so it slips the other
// guards but needs a register pair the naive single-word shift can't place), or
// more user-arg words than R1..R3 hold.
func emitScalarVoidShim(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type) {
	// Per-param GP word count under the AAPCS32 dispatch convention: a 64-bit
	// scalar is TWO words (a register pair) on ILP32, which the single-word
	// shift below can't marshal.
	var cc common.CallConv = common.AAPCS32()
	var nWords int = 0
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		if common.IsAggregateTyp(pt) || common.IsFloatScalarTyp(pt) {
			a.SetError("native arm32: func-value shim with aggregate/float arg "
				"not implemented (P4)")
			return
		}
		var pw int = cc.ArgWords(pt)
		if pw != 1 {
			a.SetError("native arm32: func-value shim with a multi-word "
				"(register-pair) scalar arg not implemented (P4)")
			return
		}
		nWords = nWords + pw
	}
	if len(fvTyp.Results) == 1 && fvTyp.Results[0] != nil &&
			(common.IsAggregateTyp(fvTyp.Results[0]) ||
			 common.IsFloatScalarTyp(fvTyp.Results[0])) {
		a.SetError("native arm32: func-value shim with aggregate/float return "
			"not implemented (P4)")
		return
	}
	if nWords > SHIM_ARG_REG_BUDGET {
		a.SetError("native arm32: func-value shim with >3 arg words needs "
			"stack spill (P4)")
		return
	}
	// Shift each user-arg word down one register: incoming R(1+w) -> R(w).
	// Left-to-right is clobber-safe (dst index < src index).
	for w := 0; w < nWords; w++ {
		arm32.Mov(a, arm32.COND_AL, false, argReg(w), arm32.Reg(argReg(w + 1)))
	}
	a.SetGlobal(fnLabel)
	arm32.B(a, arm32.COND_AL, fnLabel)
}
