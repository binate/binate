package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// ============================================================
// Function-value backing (walking-skeleton subset)
// ============================================================
//
// The func-value triple — a per-function `@__vt` vtable { dtor, call }, an
// LLVM-shape `@__handle` block { vtable, data=null }, and a per-function
// marshaling SHIM — is what every OP_FUNC_VALUE / OP_FUNC_HANDLE reference AND
// the package descriptor's FunctionInfo.Value point at.  Even a trivial
// program needs the synthesized `__Package` accessor's triple, because the
// descriptor self-lists it (see arm32_pkg_descriptor.bn); so this is NOT a
// no-op even for an empty main.
//
// The backend emits the vtable/handle data (shared ir.BuildFuncValue) for every
// collected reference, and a marshaling SHIM for the return shapes it supports:
// SCALAR/VOID (drop the leading data word, shift user args down, tail-branch),
// big-aggregate SRET (a >4-byte result returns through a hidden R0 buffer, which
// — unlike AAPCS64's dedicated X8 — stays in R0 across the shim, so the shim
// keeps R0, drops data, shifts user args down, and tail-branches), and small
// (<=4-byte) aggregate PACK (a by-value R0 result: the shim saves the retbuf,
// calls the underlying, and stores the returned R0 word through the retbuf).
// Shapes it can't yet marshal — closures (P4-d), float args/returns (P5), a
// 64-bit register-pair scalar arg, or arg words beyond the register budget — fail
// LOUDLY via a.SetError rather than emitting a wrong shim.  Mirrors
// aarch64_funcvalue{,_shim}.bn at the reduced surface, with AAPCS32's R0-sret in
// place of X8.

// SHIM_ARG_REG_BUDGET is the number of user-arg words a scalar/void shim can
// re-marshal in the register-only fast path: R0 carries the dropped `data`
// prefix, leaving R1..R3 = 3 words for user args.  The sret shim has one fewer
// (SHIM_ARG_REG_BUDGET - 1 = 2: R0 = retbuf, R1 = data, R2..R3 = user args).
const SHIM_ARG_REG_BUDGET int = 3

// shimSymFor returns the bare ELF label for a function's per-function shim
// global: "<mangled-fn>__shim".
func shimSymFor(pkgName *[]readonly char, fnName *[]readonly char) @[]char {
	var fn @[]char = symFor(pkgName, fnName)
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(fn)
	cb.Write("__shim")
	return buf.CopyStr(cb.String())
}

// vtableSymFor returns the bare ELF label for a function's vtable global:
// "<mangled-fn>__vt".
func vtableSymFor(pkgName *[]readonly char, fnName *[]readonly char) @[]char {
	var fn @[]char = symFor(pkgName, fnName)
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(fn)
	cb.Write("__vt")
	return buf.CopyStr(cb.String())
}

// collectFuncValueRefs walks the module for the functions whose (shim, vtable,
// handle) triple must be emitted: every IsLinkOnce helper (dtors / copy
// helpers), every OP_FUNC_VALUE / OP_FUNC_HANDLE reference, every .bni-exported
// func (whose descriptor Value symrefs its handle), every non-generic impl
// method, and the synthesized `__Package` accessor.  Returns parallel
// (name, func-value-type) slices.  Mirrors collectFuncValueRefs in
// aarch64_funcvalue.bn.
func collectFuncValueRefs(mod @ir.Module) (@[]@[]char, @[]@types.Type) {
	var seen @[]@[]char
	var sigs @[]@types.Type
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		if !f.IsLinkOnce { continue }
		var fvTyp @types.Type = funcValueTypeOf(f)
		seen = slices.Append[@[]char](seen, f.Name)
		sigs = slices.Append[@types.Type](sigs, fvTyp)
	}
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		for j := 0; j < len(f.Blocks); j++ {
			var blk @ir.Block = f.Blocks[j]
			for k := 0; k < len(blk.Instrs); k++ {
				var ins @ir.Instr = blk.Instrs[k]
				if ins.Op != iropcode.OP_FUNC_VALUE &&
						ins.Op != iropcode.OP_FUNC_HANDLE {
					continue
				}
				if seenContains(seen, ins.StrVal) { continue }
				var sigTyp @types.Type = ins.Typ
				if ins.Op == iropcode.OP_FUNC_HANDLE {
					sigTyp = lookupFuncValueTypeArm32(mod, ins.StrVal)
					if sigTyp == nil { continue }
				}
				seen = slices.Append[@[]char](seen, ins.StrVal)
				sigs = slices.Append[@types.Type](sigs, sigTyp)
			}
		}
	}
	// Exported funcs + struct dtors: the descriptor Functions table symrefs
	// @__handle.<fn>, which must be a defined symbol.
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		if !f.Exported && !f.IsStructDtor { continue }
		if seenContains(seen, f.Name) { continue }
		var sigTyp @types.Type = lookupFuncValueTypeArm32(mod, f.Name)
		if sigTyp == nil { continue }
		seen = slices.Append[@[]char](seen, f.Name)
		sigs = slices.Append[@types.Type](sigs, sigTyp)
	}
	seen, sigs = collectImplMethodRefsArm32(mod, seen, sigs)
	// The synthesized __Package accessor (keyed on FQ <pkg>.__Package).
	if mod.PackageAccessorSig != nil {
		var qn @[]char = mangle.QualifyName(stripQuotes(mod.Name), "__Package")
		if !seenContains(seen, qn) {
			seen = slices.Append[@[]char](seen, qn)
			sigs = slices.Append[@types.Type](sigs, mod.PackageAccessorSig)
		}
	}
	return seen, sigs
}

// collectImplMethodRefsArm32 appends each non-generic impl's interface-method
// references so their handle triples get emitted.  Mirrors
// collectImplMethodRefsAA64.
func collectImplMethodRefsArm32(mod @ir.Module, seen @[]@[]char,
		sigs @[]@types.Type) (@[]@[]char, @[]@types.Type) {
	for i := 0; i < len(mod.Impls); i++ {
		var info @ir.ImplInfo = mod.Impls[i]
		if info == nil { continue }
		if common.RecvTypeIsGenericInst(info.RecvTypeName) { continue }
		seen, sigs = collectIfaceMethodRefsArm32(mod, info, info.IfacePkg,
			info.IfaceName, seen, sigs)
	}
	return seen, sigs
}

// collectIfaceMethodRefsArm32 adds one (impl, iface) level's method refs and
// recurses into iface parents (own-then-parents walk).  Mirrors
// collectIfaceMethodRefsAA64.
func collectIfaceMethodRefsArm32(mod @ir.Module, info @ir.ImplInfo,
		ifacePkg *[]readonly char, ifaceName *[]readonly char,
		seen @[]@[]char, sigs @[]@types.Type) (@[]@[]char, @[]@types.Type) {
	var parentPkgs @[]@[]char = ir.IfaceParentPkgs(mod, ifacePkg, ifaceName)
	var parentNames @[]@[]char = ir.IfaceParentNames(mod, ifacePkg, ifaceName)
	for i := 0; i < len(parentPkgs); i++ {
		seen, sigs = collectIfaceMethodRefsArm32(mod, info, parentPkgs[i],
			parentNames[i], seen, sigs)
	}
	var ownMethods @[]@[]char = ir.IfaceOwnMethodNames(mod, ifacePkg, ifaceName)
	for i := 0; i < len(ownMethods); i++ {
		var qualified @[]char = buildMethodFuncNameArm32(info.RecvPkg,
			info.RecvTypeName, ownMethods[i])
		var slotName @[]char = ir.LookupVtableSlotName(mod, qualified)
		var sigTyp @types.Type = lookupFuncValueTypeArm32(mod, slotName)
		if sigTyp == nil { continue }
		if seenContains(seen, slotName) { continue }
		seen = slices.Append[@[]char](seen, slotName)
		sigs = slices.Append[@types.Type](sigs, sigTyp)
	}
	return seen, sigs
}

// buildMethodFuncNameArm32 mirrors the LLVM buildMethodFuncName —
// `<recvPkg>.<recvName>.<methodName>`.
func buildMethodFuncNameArm32(recvPkg *[]readonly char,
	recvName *[]readonly char, methodName *[]readonly char) @[]char {
	var b @[]char
	b = common.AppendStr(b, recvPkg)
	b = common.AppendStr(b, ".")
	b = common.AppendStr(b, recvName)
	b = common.AppendStr(b, ".")
	b = common.AppendStr(b, methodName)
	return b
}

// funcValueTypeOf builds a func-value type from an ir.Func's params/results.
func funcValueTypeOf(f @ir.Func) @types.Type {
	var params @[]@types.Param
	for j := 0; j < len(f.Params); j++ {
		var p @types.Param = make(types.Param)
		p.Name = f.Params[j].Name
		p.Type = f.Params[j].Typ
		params = slices.Append[@types.Param](params, p)
	}
	return types.MakeFuncValueType(params, f.Results)
}

// seenContains reports whether name is already in the seen set.
func seenContains(seen @[]@[]char, name *[]readonly char) bool {
	for s := 0; s < len(seen); s++ {
		if charEqArm32(seen[s], name) { return true }
	}
	return false
}

// emitFuncValueVtables emits the per-function { dtor, call } vtable and
// { vtable, data=null } handle for every collected reference, via the shared
// ir.BuildFuncValue (byte layout can't drift from the LLVM / aarch64 / x64
// backends).  Mirrors aarch64_funcvalue.bn's emitFuncValueVtables (skeleton:
// non-capturing only, so the dtor slot is always a null pointer).
func emitFuncValueVtables(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	var seen @[]@[]char
	seen, _ = collectFuncValueRefs(mod)
	if len(seen) == 0 { return }
	for i := 0; i < len(seen); i++ {
		var vtLabel @[]char = vtableSymFor(pkgName, seen[i])
		var shimLabel @[]char = shimSymFor(pkgName, seen[i])
		var handleLabel @[]char = handleSymFor(pkgName, seen[i])
		a.SetGlobal(shimLabel)
		var emptyDtor @[]char
		var dgs @[]@ir.DataGlobal = ir.BuildFuncValue(vtLabel, emptyDtor,
			shimLabel, handleLabel)
		for j := 0; j < len(dgs); j++ {
			common.EmitDataGlobal(a, dgs[j])
		}
	}
}

// emitFuncValueShims emits a per-function marshaling shim for every collected
// reference (see emitFuncValueShimBody for the per-return-shape lowering: a
// scalar/void tail-branch, or the big-aggregate R0-sret shim).  A CAPTURING
// closure is rejected LOUDLY up front — its data pointer carries the captures,
// which the shim's data-drop would discard (a silent miscompile); rejecting it
// before vtable emission also makes the null-dtor-slot moot, since a managed
// closure's captures never reach the force-nulled dtor path.  Mirrors aarch64's
// emitFuncValueShims at the reduced surface.
func emitFuncValueShims(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	var seen @[]@[]char
	var sigs @[]@types.Type
	seen, sigs = collectFuncValueRefs(mod)
	if len(seen) == 0 { return }
	a.SetSection("text", -1)
	for i := 0; i < len(seen); i++ {
		var fnLabel @[]char = symFor(pkgName, seen[i])
		var shimLabel @[]char = shimSymFor(pkgName, seen[i])
		var fvTyp @types.Type = sigs[i]
		a.DefineLabel(shimLabel)
		a.SetWeak(shimLabel)
		// A capturing closure func value carries its capture/data pointer in R0;
		// the scalar shim drops R0, so reject it LOUDLY rather than silently
		// miscompiling the capture away.
		if lookupClosureFuncArm32(mod, seen[i]) != nil {
			a.SetError("native arm32: closure func value not implemented (P4)")
			return
		}
		emitFuncValueShimBody(a, fnLabel, fvTyp)
		if a.HasError { return }
	}
}

// lookupClosureFuncArm32 returns the Func with the given name iff it is a
// capturing-literal closure (IsClosure=true); nil for non-closure refs and
// cross-module references.  Mirrors lookupClosureFunc_x64.
func lookupClosureFuncArm32(mod @ir.Module, name @[]char) @ir.Func {
	for i := 0; i < len(mod.Funcs); i++ {
		if !charEqArm32(mod.Funcs[i].Name, name) { continue }
		if !mod.Funcs[i].IsClosure { return nil }
		return mod.Funcs[i]
	}
	return nil
}

// shimUserArgWords validates the shim's user args and returns their total GP
// word count, or -1 (after a.SetError) for a shape the register-shift can't
// marshal.  The shift can only re-place single-word scalar/pointer args: an
// aggregate or float arg (P4-b / P5), or a 2-word register-pair scalar (a 64-bit
// int on ILP32 — neither aggregate nor float, so it slips the other guards but
// needs a register pair the single-word shift can't place), fails LOUDLY.
// Shared by the scalar/void and sret shim shapes.
func shimUserArgWords(a @asm.Assembler, cc common.CallConv,
		fvTyp @types.Type) int {
	var nWords int = 0
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		if common.IsAggregateTyp(pt) || common.IsFloatScalarTyp(pt) {
			a.SetError("native arm32: func-value shim with aggregate/float arg "
				"not implemented (P4)")
			return -1
		}
		var pw int = cc.ArgWords(pt)
		if pw != 1 {
			a.SetError("native arm32: func-value shim with a multi-word "
				"(register-pair) scalar arg not implemented (P4)")
			return -1
		}
		nWords = nWords + pw
	}
	return nWords
}

// shimShiftArgsDown moves nWords user-arg words from their incoming registers
// argReg(srcBase + w) down into argReg(dstBase + w), for w in 0..nWords.  Callers
// pass srcBase > dstBase (a downward shift), so left-to-right is clobber-safe
// (each dst index is below every not-yet-read src).  The shapes: scalar/void
// drops the data word (dstBase=0, srcBase=1); sret keeps the retbuf in R0 and
// drops data (dstBase=1, srcBase=2); the pack shim first saves retbuf out of R0,
// then drops both retbuf and data (dstBase=0, srcBase=2).
func shimShiftArgsDown(a @asm.Assembler, nWords int, dstBase int, srcBase int) {
	for w := 0; w < nWords; w++ {
		arm32.Mov(a, arm32.COND_AL, false, argReg(dstBase + w),
			arm32.Reg(argReg(srcBase + w)))
	}
}

// emitFuncValueShimBody classifies the func value's return shape and emits the
// matching shim.  A big (>InternalSretBytes = 4) aggregate return goes through
// the AAPCS32 R0-sret path (emitSretShim); a SMALL (<=4-byte) aggregate return
// goes through the pack shim (emitPackShim — it comes back by value in R0, which
// the shim stores through the retbuf); void, a scalar/pointer, or a 64-bit pair
// return (r0:r1) — none of which the shim touches — go through emitScalarVoidShim.
// Only a float-scalar return (P5) still fails LOUDLY.
func emitFuncValueShimBody(a @asm.Assembler, fnLabel @[]char,
		fvTyp @types.Type) {
	if len(fvTyp.Results) == 1 && fvTyp.Results[0] != nil {
		var rt @types.Type = fvTyp.Results[0]
		if common.IsFloatScalarTyp(rt) {
			a.SetError("native arm32: func-value shim with float return not "
				"implemented (P5)")
			return
		}
		if common.IsAggregateTyp(rt) {
			var cc common.CallConv = common.AAPCS32()
			if rt.SizeOf() > cc.InternalSretBytes {
				// Big aggregate (>4 bytes): returned through the R0 sret buffer —
				// tail-branch shim (retbuf stays in R0).
				emitSretShim(a, fnLabel, fvTyp)
			} else {
				// Small aggregate (<=4 bytes): returned BY VALUE in R0 — the pack
				// shim calls the underlying and stores the returned word through
				// the retbuf.
				emitPackShim(a, fnLabel, fvTyp)
			}
			return
		}
	}
	emitScalarVoidShim(a, fnLabel, fvTyp)
}

// emitScalarVoidShim emits the scalar/void shim body: drop the data word (R0),
// shift user args R1..RN down to R0..R(N-1), tail-branch to fnLabel.  A void or
// scalar/pointer return (incl. a 64-bit-pair return in r0:r1) rides straight
// back through the tail-branch — the shim never touches the return value.  Fails
// LOUDLY on arg shapes the single-word shift can't marshal (shimUserArgWords) or
// on more user-arg words than R1..R3 hold (a stack-spill shim is a later
// increment).  Callers reach it via emitFuncValueShimBody, which has already
// ruled out the aggregate/float return shapes.
func emitScalarVoidShim(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type) {
	var cc common.CallConv = common.AAPCS32()
	var nWords int = shimUserArgWords(a, cc, fvTyp)
	if nWords < 0 { return }
	if nWords > SHIM_ARG_REG_BUDGET {
		a.SetError("native arm32: func-value shim with too many arg words needs "
			"stack spill (P4)")
		return
	}
	shimShiftArgsDown(a, nWords, 0, 1)
	a.SetGlobal(fnLabel)
	arm32.B(a, arm32.COND_AL, fnLabel)
}

// emitSretShim emits the big-aggregate (>InternalSretBytes = 4) return shim.  It
// is entered under the aggregate-return dispatch ABI as
// `void(retbuf=R0, data=R1, args=R2..)`.  AAPCS32 passes the sret buffer pointer
// in R0 (SretInGpArgReg) — and the underlying function ALSO expects it in R0 —
// so, unlike AAPCS64's `Mov X8, X0`, the retbuf simply STAYS in R0 across the
// shim: keep R0, drop the data word (R1), shift user args R2.. down to R1.., and
// tail-branch (the underlying writes the result through R0).  Fails LOUDLY on the
// same arg shapes as the scalar shim, and when the user args exceed R2..R3 — the
// retbuf + data prefix leaves one fewer arg register than the scalar shape.
func emitSretShim(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type) {
	var cc common.CallConv = common.AAPCS32()
	var nWords int = shimUserArgWords(a, cc, fvTyp)
	if nWords < 0 { return }
	if nWords > SHIM_ARG_REG_BUDGET - 1 {
		a.SetError("native arm32: func-value sret shim with too many arg words "
			"needs stack spill (P4)")
		return
	}
	shimShiftArgsDown(a, nWords, 1, 2)
	a.SetGlobal(fnLabel)
	arm32.B(a, arm32.COND_AL, fnLabel)
}

// emitPackShim emits the small (<=InternalSretBytes = 4) in-register aggregate
// return shim.  Unlike the tail-branch scalar/sret shims, a packed return needs
// a real call: the underlying function returns the aggregate BY VALUE in R0 (one
// word for a <=4-byte result), which the shim must then store through the retbuf.
// It is entered under the aggregate-return dispatch ABI as
// `void(retbuf=R0, data=R1, args=R2..)`; it saves retbuf in R4 (callee-saved, so
// the underlying call preserves it — and the push restores the caller's R4),
// drops retbuf + data by shifting user args R2.. down to R0.., BLs the
// underlying, stores the returned R0 word through retbuf, and returns.  Mirrors
// x64/aarch64's usePack shim, with arm32's explicit push/pop frame (no red zone).
// Over-budget arg counts (needing a stack-spill shim) fail LOUDLY (P4).
func emitPackShim(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type) {
	var cc common.CallConv = common.AAPCS32()
	var nWords int = shimUserArgWords(a, cc, fvTyp)
	if nWords < 0 { return }
	if nWords > SHIM_ARG_REG_BUDGET - 1 {
		a.SetError("native arm32: func-value pack shim with too many arg words "
			"needs stack spill (P4)")
		return
	}
	// push {r4, lr}: save the caller's R4 (reused for retbuf) and LR (the BL
	// clobbers it).  Two registers keep SP 8-aligned across the call (AAPCS32).
	arm32.Push(a, arm32.COND_AL, packShimPushMask())
	// retbuf (R0) -> R4: survives the BL (R4 is callee-saved).
	arm32.Mov(a, arm32.COND_AL, false, arm32.R4, arm32.Reg(arm32.R0))
	// Drop retbuf + data; shift user args R2.. down to R0.. (the underlying is a
	// small-aggregate function — it returns by value, so it has no sret arg).
	shimShiftArgsDown(a, nWords, 0, 2)
	a.SetGlobal(fnLabel)
	arm32.Bl(a, arm32.COND_AL, fnLabel)
	// The underlying returned the <=4-byte aggregate by value in R0 (one word);
	// store it through the retbuf.
	arm32.Str(a, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R4, 0))
	// pop {r4, pc}: restore the caller's R4 and return (writing PC).
	arm32.Pop(a, arm32.COND_AL, packShimPopMask())
}

// packShimPushMask is the {r4, lr} register mask (bit i = register i) for the
// pack shim's entry push: save the caller's R4 (reused to hold the retbuf) and LR.
func packShimPushMask() int {
	return (1 << arm32.R4) | (1 << arm32.LR)
}

// packShimPopMask is the {r4, pc} register mask for the pack shim's exit pop:
// restore the caller's R4 and load the saved LR into PC to return.
func packShimPopMask() int {
	return (1 << arm32.R4) | (1 << arm32.PC)
}

// emitFuncValue lowers OP_FUNC_VALUE — function-value construction.  It builds
// the 8-byte {vtable_addr, data} aggregate (ILP32) in the instruction's
// pre-allocated data region (PlanFrame reserved it for OP_FUNC_VALUE): the vtable
// global's address (emitFuncValueVtables emitted it) goes at
// FuncValueVtableOffset, and a null data pointer at FuncValueDataOffset for a
// non-capturing Phase-1 literal.  The result is a pointer to the data region.  A
// CAPTURING closure (Args[0] carries the capture-struct pointer) is P4-d and
// fails LOUDLY — the shim rejects it too, so the null-dtor slot stays sound.
// Mirrors aarch64_dispatch.bn's OP_FUNC_VALUE arm with WordBytes = 4 and
// MOVW/MOVT-ABS (no ADRP) address materialization.
func emitFuncValue(a @asm.Assembler, pkgName *[]readonly char,
		rm @common.RegMap, ins @ir.Instr) {
	if len(ins.StrVal) == 0 { return }
	if len(ins.Args) > 0 {
		a.SetError("native arm32: capturing closure func value not implemented "
			"(P4-d)")
		return
	}
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	var vtLabel @[]char = vtableSymFor(pkgName, ins.StrVal)
	a.SetGlobal(vtLabel)
	// Slot 0 = &vtable.
	var addrTmp int = scratchReg(rm)
	emitSymAddr(a, addrTmp, vtLabel)
	emitFrameStore(a, addrTmp, dataOff + types.FuncValueVtableOffset())
	// Slot 1 = null data (non-capturing literal).  arm32 has no zero register, so
	// materialize 0 in a scratch and store it.
	var zeroTmp int = scratchReg(rm)
	emitConstInt32(a, zeroTmp, 0)
	emitFrameStore(a, zeroTmp, dataOff + types.FuncValueDataOffset())
	// Produce the data-region pointer as the result.
	var rd int = nextReg(rm, ins.ID)
	emitFrameAddr(a, rd, dataOff)
}
