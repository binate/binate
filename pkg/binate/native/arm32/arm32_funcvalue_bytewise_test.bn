package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for a func-value shim whose by-address aggregate is less aligned than a word
// or larger than 4 KiB.  The dispatch hands the shim the aggregate's address, which
// for a byte array may be odd (a field of another aggregate value, or a pointer the VM
// supplies), so the shim assembles its words byte by byte; and the words of a > 4 KiB
// aggregate sit past the 12-bit offset an LDR encodes.  refBytewiseWordArm32 lives in
// arm32_closure_shim_large_test.bn.

// A func value taking a [20]uint8 routes to the framed spill shim (only it has the R4 /
// LR scratch a byte-wise load needs), which stages r0..r3 and reads the array's address
// from the staged R1:
//   PUSH {r4, lr} ; SUB SP, SP, #24 ; STR R0..R3, [SP, #8..#20]   ; stage
//   LDR IP, [SP, #12]                     ; the array's address
//   R0..R3 <- bytes 0..15, byte-wise (LR addresses the bytes, R4 carries each)
//   LDR IP, [SP, #12] ; R4 <- bytes 16..19 (IP carries each) ; STR R4, [SP, #0]
//   BL ; ADD SP, SP, #24 ; POP {r4, pc}
func TestFuncvalSubwordAggBytewiseByteRefArm32() testing.TestResult {
	setArm32Target()
	var noResults @[]@types.Type
	var fv @types.Type = fvOneParam_marshaltest(types.MakeArrayType(types.TypUint8(), 20), noResults)
	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitScalarVoidShim(got, "bn_ref", fv)
	if got.HasError { return fail("a [20]uint8 func-value shim must lower") }

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Push(ref, arm32.COND_AL, packShimPushMask())
	emitSpAdjust(ref, false, 24)
	for k := 0; k < 4; k++ {
		arm32.Str(ref, arm32.COND_AL, k, arm32.MemImm(arm32.SP, 8 + 4 * k))
	}
	arm32.Ldr(ref, arm32.COND_AL, arm32.IP, arm32.MemImm(arm32.SP, 12))
	for k := 0; k < 4; k++ {
		refBytewiseWordArm32(ref, k, arm32.IP, 4 * k, 4, arm32.LR, arm32.R4)
	}
	arm32.Ldr(ref, arm32.COND_AL, arm32.IP, arm32.MemImm(arm32.SP, 12))
	refBytewiseWordArm32(ref, arm32.R4, arm32.IP, 16, 4, arm32.LR, arm32.IP)
	arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 0))
	ref.SetGlobal("bn_ref")
	arm32.Bl(ref, arm32.COND_AL, "bn_ref")
	emitSpAdjust(ref, true, 24)
	arm32.Pop(ref, arm32.COND_AL, packShimPopMask())

	if !asmTextEqMarshal(got, ref) {
		return fail(
				"a [20]uint8 func-value shim must assemble the array's words byte by byte on "
						"the framed spill path")
	}
	return ""
}

// A func value taking a [1100]int32 (4400 bytes) lowers: the words past offset 4095
// load through an LR-held offset rather than an LDR immediate that cannot encode it.
func TestFuncvalHugeAggLowersArm32() testing.TestResult {
	setArm32Target()
	var noResults @[]@types.Type
	var fv @types.Type = fvOneParam_marshaltest(types.MakeArrayType(types.TypInt32(), 1100), noResults)
	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitScalarVoidShim(got, "bn_ref", fv)
	if got.HasError { return fail("a [1100]int32 func-value shim must lower") }
	return ""
}
