package "pkg/binate/native/arm32"

import "pkg/binate/native/callconv"
import "pkg/binate/types"

// Argument-shape CLASSIFICATION for the arm32 func-value / iface / closure dispatch
// seam — the pure predicates the marshal (arm32_funcvalue_marshal.bn), the caller
// (arm32_call_indirect.bn), and the spill path (arm32_funcvalue_spill.bn) all key on.
// Split from arm32_funcvalue_marshal.bn to keep each file under the hygiene length cap.
// The two seam concerns they encode: (1) which aggregates ride BY-ADDRESS as one
// pointer word and must be re-expanded (isByAddressAggArm32 / shimInWordsForTypeArm32);
// and (2) the even-register-pair rule, which the OUTGOING cursor always applies
// (cc.NeedsEvenReg).  The INCOMING positional seam is FLAT under
// both float ABIs (no even-pair pad) — a 64-bit scalar rides two consecutive slots, a
// float its GP bit-image slot(s), an aggregate one pointer slot.

// isByAddressAggArm32 reports whether pt is an aggregate the func-value shim
// receives BY-ADDRESS as ONE dispatch pointer word and must re-expand into the
// underlying's AAPCS32 register/stack slots (its ArgWords value-words spread per the
// classifier).  Two branches:
//   - Branch 1 (AggCoercedInReg, PIECE 1): a COERCED in-register aggregate — any
//     array, any NAMED struct, AND any source-level ANONYMOUS struct.  A
//     source-level anon struct type is not nameless at this layer: IR-gen assigns it
//     a synthetic `__anon_N` name (gen_type_resolve.bn), so AggInRegCoercedKind
//     (len(Name) > 0) — and hence AggCoercedInReg — is TRUE for it, INCLUDING a
//     <=4-byte one.  So a <=WordBytes anon struct rides THIS branch (by-address,
//     coerced), matching the LLVM cross-package shim, which likewise declares such an
//     arg i8* (coerced [1 x i32]) via aggParamCoerced.
//   - Branch 2: every other aggregate — a raw slice / iface-value / func-value (8
//     bytes, 2 words), a managed-slice (16 bytes, 4 words), and a >16-byte aggregate,
//     which AAPCS32 passes by value like any composite (split across r0-r3 + stack).
//     A >16-byte one may be less aligned than a word (a byte array), so its words are
//     then assembled byte by byte (shimHasBytewiseByAddrAggArm32).
// This single predicate replaces the scattered AggCoercedInReg checks in the shim
// path, so every by-address aggregate follows the SAME re-expansion as a coerced one.
func isByAddressAggArm32(cc callconv.CallConv, pt @types.Type) bool {
	if callconv.AggCoercedInReg(pt) { return true }
	return callconv.IsAggregateTyp(pt) && !cc.PassesIndirect(pt)
}

// shimInWordsForTypeArm32 returns the INCOMING dispatch words type pt occupies in
// the func-value shim ABI: ONE for a by-address aggregate (the dispatch caller places
// a single pointer word — see emitCallFuncValue's i8* substitution), else
// cc.EffectiveArgWords(pt).  It is arm32-LOCAL because option B makes arm32 the only
// native backend that passes a NON-coerced small aggregate by-address: the shared
// cc.EffectiveArgWords returns its ArgWords (2/4) — correct for aa64/x64's INLINE
// convention but wrong for the incoming count here, where a by-address aggregate is
// one pointer word.  (For a coerced or >16-byte aggregate EffectiveArgWords
// already returns 1, so this only diverges for a non-coerced small aggregate.)
func shimInWordsForTypeArm32(cc callconv.CallConv, pt @types.Type) int {
	if isByAddressAggArm32(cc, pt) { return 1 }
	return cc.EffectiveArgWords(pt)
}
