package "pkg/binate/native/arm32"

import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Classification-predicate tests for arm32_funcvalue_classify.bn: the by-address
// aggregate predicate (isByAddressAggArm32 / shimInWordsForTypeArm32) and the
// even-register-pair predicate (paddedKeepsTypeArm32).  The shared test builders
// (rawSlice_marshaltest, smallAnonStruct_marshaltest, indirectLarge8Aligned_marshaltest,
// coercedStruct8Aligned_marshaltest, fail) live in arm32_funcvalue_marshal_test.bn — the
// same package — alongside the emission tests that also use them.

// MUTATION-VERIFY: isByAddressAggArm32 MUST classify a NON-coerced small aggregate
// (raw slice) as by-address.  If the predicate were NOT widened past coerced (i.e.
// only AggCoercedInReg), a slice would fall to the generic inline down-shift and
// shimInWordsArm32 would count it as 2 incoming words instead of 1 — the exact
// miscompile PIECE 2 fixes.  This asserts both the classification and the 1-word
// incoming count, so it FAILS if the by-address widening is reverted.
func TestSliceIsByAddressAggArm32() testing.TestResult {
	setArm32Target()
	var cc common.CallConv = common.AAPCS32()
	var slice @types.Type = rawSlice_marshaltest()
	if !isByAddressAggArm32(cc, slice) {
		return fail("a raw slice must be a by-address aggregate under option B")
	}
	if !isByAddressAggArm32(cc, managedSlice_marshaltest()) {
		return fail("a managed-slice must be a by-address aggregate under option B")
	}
	// The incoming count for a by-address slice is ONE pointer word, NOT its 2
	// ArgWords — the count shimInWordsArm32 gates the register budget on.
	if shimInWordsForTypeArm32(cc, slice) != 1 {
		return fail("a by-address slice must count as ONE incoming dispatch word")
	}
	// An indirect-large aggregate is NOT by-address here (it rides the generic
	// 1-pointer down-shift): a 20-byte struct (> AggregateInRegMax 16).
	var bigFields @[]@types.Field = make_slice(@types.Field, 5)
	for i := 0; i < 5; i++ {
		bigFields[i] = make(types.Field)
		bigFields[i].Type = types.TypInt()
	}
	var big @types.Type = types.MakeStructType("Big20_marshaltest", bigFields)
	if isByAddressAggArm32(cc, big) {
		return fail("a >16-byte indirect-large aggregate must NOT be a by-address aggregate")
	}
	// A plain scalar is not an aggregate.
	if isByAddressAggArm32(cc, types.TypInt()) {
		return fail("a scalar int must not be a by-address aggregate")
	}
	return ""
}

// A source-level ANONYMOUS struct is COERCED, hence by-address.  IR-gen names an
// anon struct type `__anon_N` (gen_type_resolve.bn), so AggInRegCoercedKind
// (len(Name) > 0) — and AggCoercedInReg — is TRUE for it, INCLUDING a <=4-byte one.
// So a small anon struct is classified by-address via branch 1 (AggCoercedInReg),
// exactly like a named struct, and rides ONE by-address pointer dispatch word — the
// SAME contract the LLVM cross-package shim uses (it declares the arg i8*, coerced
// [1 x i32]).  This pins the corrected understanding: there is no <=4-byte
// non-coerced aggregate, so the by-address predicate needs no sub-word lower bound.
// Conformance 1004/1005 prove the runtime round-trip (same-package + cross-package
// arm32<->LLVM).
func TestSmallAnonStructIsByAddressAggArm32() testing.TestResult {
	setArm32Target()
	var cc common.CallConv = common.AAPCS32()
	var anon @types.Type = smallAnonStruct_marshaltest()
	if !common.IsAggregateTyp(anon) {
		return fail("a single-int anon struct must be an aggregate type")
	}
	// A named anon struct (`__anon_N`) IS coerced-in-register — the key fact.
	if !common.AggCoercedInReg(anon) {
		return fail(
				"a source-level anon struct (synthetic `__anon_N` name) must be "
						"coerced-in-register — IR-gen names it, so len(Name) > 0")
	}
	if anon.SizeOf() != cc.WordBytes {
		return fail("the anon struct must be exactly WordBytes (4 on ILP32) for this case")
	}
	// The core assertion: it IS by-address (via the AggCoercedInReg branch), even at
	// <=WordBytes — no sub-word non-coerced aggregate exists.
	if !isByAddressAggArm32(cc, anon) {
		return fail(
				"a <=4-byte source-level anon struct must be a by-address aggregate "
						"(via AggCoercedInReg), matching the LLVM coerced-i8* shim")
	}
	// Its incoming dispatch count is ONE by-address pointer word.
	if shimInWordsForTypeArm32(cc, anon) != 1 {
		return fail("a by-address anon struct must count as ONE incoming dispatch word")
	}
	// EffectiveArgWords also collapses a coerced aggregate to ONE by-address word.
	if cc.EffectiveArgWords(anon) != 1 {
		return fail("a coerced 4-byte anon struct must have EffectiveArgWords 1 (by-address)")
	}
	return ""
}

// paddedKeepsTypeArm32 must be a SUPERSET of isReg64Scalar (so the int64 pad sites stay
// green) and must EXCLUDE by-address aggregates (so they are not double-padded).  This
// pins that classification directly, independent of the byte-ref placement tests.
func TestPaddedKeepsTypeArm32Classification() testing.TestResult {
	setArm32Target()
	var cc common.CallConv = common.AAPCS32()
	// An 8-aligned indirect-large aggregate: NeedsEvenReg, NOT by-address, NOT float.
	var big @types.Type = indirectLarge8Aligned_marshaltest()
	if !paddedKeepsTypeArm32(cc, big) {
		return fail("an 8-aligned indirect-large aggregate must be paddedKeepsType")
	}
	// int64 / uint64 register-pair scalars: the pre-existing case, still in the set.
	if !paddedKeepsTypeArm32(cc, types.TypInt64()) {
		return fail("int64 must be paddedKeepsType (superset of isReg64Scalar)")
	}
	if !paddedKeepsTypeArm32(cc, types.TypUint64()) {
		return fail("uint64 must be paddedKeepsType (superset of isReg64Scalar)")
	}
	// A by-address 8-aligned coerced aggregate (S8 = struct{int64}) is EXCLUDED: it
	// rides a 4-aligned *uint8 dispatch slot and carries its own pad in the
	// isByAddressAggArm32 branch, so paddedKeepsType must NOT also pad it.
	if paddedKeepsTypeArm32(cc, coercedStruct8Aligned_marshaltest()) {
		return fail("a by-address 8-aligned aggregate must NOT be paddedKeepsType (avoid double-pad)")
	}
	// A soft-float float64 is a register-pair scalar (NeedsEvenReg, align 8, not
	// by-address), so it IS paddedKeepsType — the P5.3 generalization of the int64-only
	// set (paddedKeepsType is a SUPERSET of isPair64Typ).
	if !paddedKeepsTypeArm32(cc, types.TypFloat64()) {
		return fail("float64 must be paddedKeepsType (soft-float register pair, like int64)")
	}
	// A 4-aligned scalar / pointer never needs an even-pair pad.
	if paddedKeepsTypeArm32(cc, types.TypInt32()) {
		return fail("a 4-aligned int32 must not be paddedKeepsType")
	}
	// A float32 is one 4-aligned word — NOT paddedKeepsType (rides the generic 1-word path).
	if paddedKeepsTypeArm32(cc, types.TypFloat32()) {
		return fail("a 4-aligned float32 must not be paddedKeepsType")
	}
	// A 4-aligned indirect-large aggregate (Big20 = 5×int, align 4) is NOT paddedKeepsType.
	var bigFields @[]@types.Field = make_slice(@types.Field, 5)
	for i := 0; i < 5; i++ {
		bigFields[i] = make(types.Field)
		bigFields[i].Type = types.TypInt()
	}
	if paddedKeepsTypeArm32(cc, types.MakeStructType("Big20_pkt_marshaltest", bigFields)) {
		return fail("a 4-aligned indirect-large aggregate must not be paddedKeepsType")
	}
	return ""
}
