package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Func-value SHIM argument marshaling for the arm32 backend, register-only case
// (every incoming/outgoing word in a GP register).  Split from arm32_funcvalue.bn
// so each file stays under the hygiene length cap; the shape dispatch and the
// vtable/handle emission stay there.  Mirrors aarch64_funcvalue_shim.bn's
// emitShimArgMarshalAA64 / x64_funcvalue_shim.bn's emitShimArgMarshal_x64, at the
// GP-only (arm32 soft-float — no HFA/FP register file) reduced surface, and with
// AAPCS32's R0-sret-stays convention (like x64's RDI-stays, unlike aarch64's
// X0->X8 move).
//
// The shim is entered under the uniform all-int dispatch ABI (the VM's
// rt._call_shim_scalar and the compiled emitCallFuncValue both place every arg
// WORD positionally in a GP register, after a leading data slot, or retbuf+data
// for the aggregate shapes).  A coerced in-register named struct/array (SizeOf in
// [1, 16]) rides that convention BY-ADDRESS — as ONE pointer word — which the shim
// re-expands into the underlying's AAPCS32 coerced layout (its ArgWords value-
// words loaded word-by-word from the pointed-to image into consecutive GP regs).
//
// AAPCS §6.5 stage C.3 even-register-pair alignment: an 8-byte-aligned coerced
// aggregate (a <=16-byte named struct/array with AlignOf >= 8, i.e. carrying an
// int64/uint64/float64 field) must start on an EVEN outgoing core register.  The
// callee (emitSpillParam -> CallArgRegStart -> argRegWordsStackWords) applies this
// pad, so the shim MUST place the aggregate on the same even register — via the
// SHARED cc.NeedsEvenReg predicate argRegWordsStackWords uses — or the callee
// would read it from the next register.  The INCOMING dispatch cursor does NOT
// bump for a by-address aggregate: emitCallFuncValue substitutes a *uint8
// (4-aligned) for each coerced / non-coerced-small aggregate before placing it, so
// the by-address pointer rides ONE 4-aligned word.
//
// The two cursors DIVERGE on the even-pair rule.  The OUTGOING cursor targets the
// underlying's real AAPCS32 convention, so an int64 / uint64 / float64 register-pair
// scalar or an 8-aligned indirect-large aggregate (paddedKeepsTypeArm32) even-pair-pads
// there, under BOTH float ABIs.  The INCOMING cursor is the POSITIONAL all-integer
// dispatch seam (spec abi/03 §3.3) — a flat sequence of 32-bit slots with NO even-pair
// pad — so under SOFT-float it advances flatly, matching the caller
// (emitShimUserArgsFlatArm32) and the two reference producers (the LLVM pre-split shim
// signature and the VM's argSlots).  Under HARD-float the caller still routes seam args
// through the AAPCS32 machinery pending the GP-bit-image rework, so the incoming cursor
// mirrors that (seamIncomingEvenPairArm32).  See seamIncomingEvenPairArm32 and its gate
// sites in shimInWordsArm32 / emitShimArgMarshalArm32 (and emitSpillMarshalArm32 for the
// spill path); the outgoing pad stays paddedKeepsTypeArm32 / cc.NeedsEvenReg.

// shimOutRegs walks the shim's user args exactly as emitShimArgMarshalArm32 does
// and returns the final OUTGOING GP register count (RELATIVE to gpDestBase),
// INCLUDING any AAPCS §6.5 C.3 even-register-pair pad words, or -1 (after
// a.SetError) for a shape the register-only marshal can't place.  Sharing this ONE
// walk with the marshal is what keeps the budget check and the actual register
// placement from diverging: an even-pair bump that pushes a coerced aggregate past
// R3 must be visible to shimArgsFitRegisters so the shape routes to the stack-spill
// path instead of silently miscompiling.  gpDestBase is the first GP reg the
// underlying uses (0 normally; 1 for the sret shape, where R0 holds the sret
// buffer) — it sets the ABSOLUTE register index the even-pair test keys on, so a
// first-arg 8-aligned aggregate that would sit at an even relative index can still
// need a pad when gpDestBase makes the absolute index odd.
//
// A float arg is ACCEPTED (soft-float rides GP like the same-width integer): a
// float32 advances one outgoing word like an int32; a float64 rides the 2-word
// even-aligned pair (isPair64Typ) exactly like an int64.  A 64-bit register-pair
// SCALAR (int64 / uint64 / float64 on ILP32, 2 words) takes the same AAPCS §6.5 C.3
// even-pair bump as an 8-aligned aggregate, then advances 2 outgoing words.  A
// coerced (P1) OR non-coerced small in-register aggregate (P2, option B) is ACCEPTED
// too: both ride by-address and re-expand their ArgWords value-words into the
// outgoing GP regs.  Any OTHER multi-word non-aggregate scalar (none exists today)
// stays fail-loud — an unmodeled shape must not be silently accepted.
func shimOutRegs(a @asm.Assembler, cc common.CallConv, fvTyp @types.Type, gpDestBase int) int {
	var ngrn int = 0
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		if hardFloatShimSkipArm32(pt) { continue } // float scalar rides VFP, not GP
		if isByAddressAggArm32(cc, pt) {
			// AAPCS §6.5 C.3: an 8-aligned by-address aggregate starts on an EVEN
			// outgoing register.  The ABSOLUTE index is gpDestBase + ngrn; when it is
			// odd, waste the odd register (a pad, later left unwritten — AAPCS pads
			// are undefined).  Byte-identical to argRegWordsStackWords' bump.
			if cc.NeedsEvenReg(pt) && (gpDestBase + ngrn) % 2 != 0 {
				ngrn = ngrn + 1
			}
			// A by-address aggregate (coerced array/named/anon struct OR non-coerced
			// slice / iface-value / managed-slice) arrives BY-ADDRESS (one incoming
			// pointer word) but re-expands into its ArgWords value-words in the
			// outgoing GP regs.  Use the TARGET-
			// parameterised cc.ArgWords (WordBytes 4 on ILP32): the free
			// common.ArgWords is LP64 (8-byte words), which would undercount an 8-byte
			// slice/struct as 1 word and misplace the expansion.
			ngrn = ngrn + cc.ArgWords(pt)
			continue
		}
		// An indirect-large (>16-byte) aggregate and every scalar / pointer keep the
		// generic down-shift.  cc.EffectiveArgWords counts an indirect-large aggregate
		// as ONE pointer word, so pw == 1 for it and every 32-bit scalar / pointer.
		// The multi-word case that reaches here is a 64-bit register-pair SCALAR (an
		// int64 / uint64 on ILP32, 2 words) — a slice's 2 words go through the
		// by-address branch above, so they never reach here.
		var pw int = cc.EffectiveArgWords(pt)
		if pw == 1 {
			// An 8-aligned indirect-large aggregate (>16-byte, AlignOf 8) is a
			// paddedKeepsTypeArm32 arg that rides ONE pointer word: the dispatch caller
			// and callee even-pair-pad its pointer, so shimOutRegs must count that pad —
			// else nOut under-counts and shimArgsFitRegisters mis-routes the shape (this
			// budget MUST match emitShimArgMarshalArm32's generic-branch pad).  A 32-bit
			// scalar / pointer is NOT paddedKeepsType (align 4), so it never pads here.
			if paddedKeepsTypeArm32(cc, pt) && (gpDestBase + ngrn) % 2 != 0 {
				ngrn = ngrn + 1
			}
			ngrn = ngrn + pw
			continue
		}
		if pw == 2 && isPair64Typ(pt) {
			// A 64-bit register-pair scalar (int64 / uint64 / float64): AAPCS §6.5 C.3
			// places it on an EVEN outgoing core register pair.  When the ABSOLUTE index
			// gpDestBase + ngrn is odd, waste the odd register (a pad, left unwritten).
			// Byte-identical to the by-address branch's bump and argRegWordsStackWords.
			// (A soft-float float64 rides this pair bit-for-bit like an int64.)
			if cc.NeedsEvenReg(pt) && (gpDestBase + ngrn) % 2 != 0 {
				ngrn = ngrn + 1
			}
			ngrn = ngrn + pw
			continue
		}
		// Any other multi-word non-aggregate scalar is unmodeled (none exists today —
		// only int64 / uint64 / float64 are 2-word non-aggregate scalars on ILP32, and
		// all three ride the isPair64Typ branch above).  Fail LOUDLY rather than
		// silently accept an unhandled shape.
		a.SetError(
				"native arm32: func-value shim with a multi-word "
						"(register-pair) scalar arg not implemented (P4)")
		return -1
	}
	return ngrn
}

// shimArgsFitRegisters reports whether the shim's user args fit the register-only
// marshal (both the INCOMING dispatch words and the OUTGOING coerced/shifted/pad
// words stay within R0..R3).  A false result routes the shape to the framed-BL
// stack-spill shim (emitFuncvalSpillShimArm32); the caller has already run
// shimOutRegs, which fails LOUDLY only on an unmodeled multi-word non-aggregate
// scalar (none exists on ILP32 today) — a 64-bit register-pair (int64 / uint64 /
// float64) is placed by-value, and a float32 rides one word, so neither fails loud.
// srcPrefix is the leading GP words the shape drops before the user args
// (1 = data; 2 = retbuf + data); gpDestBase is the first GP reg the underlying uses
// (0 normally; 1 for sret, where R0 holds the sret buffer).  nOut is shimOutRegs's
// outgoing register count RELATIVE to gpDestBase, already including any even-pair
// pad — so an 8-aligned coerced aggregate whose pad pushes it past R3 spills here
// rather than being marshaled to a nonexistent register.
func shimArgsFitRegisters(cc common.CallConv, fvTyp @types.Type, srcPrefix int, gpDestBase int,
		nOut int) bool {
	var nIn int = shimInWordsArm32(cc, fvTyp, srcPrefix)
	if nIn > cc.NumGpArgRegs - srcPrefix || nOut + gpDestBase > cc.NumGpArgRegs {
		return false
	}
	return true
}

// shimNeedStageArm32 reports whether the shim's user-arg list contains a by-address
// aggregate — the ONLY case that makes the OUTGOING GP register cursor (ArgWords
// words, plus any even-pair pad) advance faster than the INCOMING by-address cursor
// (one pointer word), so an outgoing write could land in a LATER param's not-yet-read
// incoming arg register (a register-permutation hazard).  Without one, incoming and
// outgoing advance in lockstep (a constant down-shift), which is already clobber-
// safe, so the marshal reads live incoming regs and skips staging.  Mirrors
// aarch64's needStage loop / x64's needStage loop.
func shimNeedStageArm32(cc common.CallConv, fvTyp @types.Type) bool {
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		if isByAddressAggArm32(cc, fvTyp.Params[pi].Type) { return true }
	}
	return false
}

// shimInWordsArm32 returns the total INCOMING dispatch words the shim's user args
// occupy, on the POSITIONAL all-integer seam (spec abi/03 §3.3): each arg contributes
// shimInWordsForTypeArm32 (one pointer word for an aggregate of any size; two for a
// 64-bit register-pair scalar; one otherwise).  Under SOFT-float there is NO even-pair
// pad — the seam is flat.  Under HARD-float the caller still even-aligns a
// paddedKeepsTypeArm32 arg's incoming pair pending the GP-bit-image rework
// (seamIncomingEvenPairArm32): when the running ABSOLUTE incoming cursor srcPrefix + n
// is odd, it wastes a pad word first, and this walk MUST count it or the staged-frame
// size and the incoming-register pressure gate under-count and desync the list.  A
// by-address aggregate never pads (it rides a 4-aligned *uint8), so it is excluded on
// both ABIs.  srcPrefix
// (1 = data; 2 = retbuf + data) sets the absolute-parity origin.  This is the
// incoming-register pressure the shim reads from R(prefix)..; callers gate it
// against R(prefix)..R3.
func shimInWordsArm32(cc common.CallConv, fvTyp @types.Type, srcPrefix int) int {
	var n int = 0
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		if hardFloatShimSkipArm32(pt) { continue } // float scalar rides VFP, not GP
		// Incoming even-pair pad — HARD-float only (seamIncomingEvenPairArm32): there the
		// caller still even-aligns a paddedKeepsTypeArm32 arg's incoming pair, so mirror
		// it on the absolute incoming cursor srcPrefix + n.  Under soft-float the seam is
		// flat and this never fires.
		if seamIncomingEvenPairArm32(cc, pt) && (srcPrefix + n) % 2 != 0 {
			n = n + 1
		}
		n = n + shimInWordsForTypeArm32(cc, pt)
	}
	return n
}

// emitShimArgMarshalArm32 marshals the shim's incoming all-int, positional-GP
// user args into the AAPCS32 layout the underlying expects, FOR THE REGISTER-ONLY
// CASE.  Incoming user-arg word w sits in argReg(srcPrefix + w) — srcPrefix is the
// count of leading GP words to drop (1 = data, for scalar/void; 2 = retbuf + data,
// for the pack/sret/multiret shapes).  gpDestBase is the first GP arg register the
// underlying uses: 0 normally, but 1 for the sret shape (R0 holds the sret buffer
// pointer, so explicit args start at R1).
//
// A by-address aggregate (coerced array/named/anon struct OR non-coerced slice /
// iface-value / managed-slice) arrives as ONE by-address pointer word; the marshal
// parks that pointer in a scratch and loads its ArgWords value-words from
// [scratch + 4k] into the consecutive outgoing GP regs the underlying's ABI reads.
// An 8-byte-aligned by-address aggregate (cc.NeedsEvenReg) starts on an EVEN outgoing
// register (AAPCS §6.5 C.3): when the absolute index gpDestBase+ngrn is odd, the
// outgoing cursor skips the odd register (a pad left UNWRITTEN — AAPCS pads are
// undefined), matching the callee's argRegWordsStackWords placement.  The incoming
// cursor (srcWord) advances by 1 word and takes NO even-pair bump (the dispatch
// caller placed the by-address pointer as a 4-aligned *uint8), so the two cursors
// DIVERGE at each by-address aggregate.
//
// A 64-bit register-pair scalar (int64 / uint64) arrives INLINE as its two
// value-words — NOT by-address — even-aligned on BOTH sides: the dispatch caller
// keeps its real type, so it even-aligns the incoming pair too (unlike the by-address
// pointer above).  So the int64 branch bumps BOTH cursors: OUTGOING on gpDestBase+ngrn
// and INCOMING on srcPrefix+srcWord.  Omitting the incoming bump would read the value
// from the wrong (pre-pad) registers — a silent miscompile.  A scalar int64 never
// SPLITs (the classifier sends an over-budget one whole to the 8-aligned stack, not
// straddling), so a register-only int64 is always a full even pair; an over-budget one
// routes to the spill path.  Other non-by-address args (32-bit scalars, indirect-large
// single pointers) keep the generic register down-shift.
//
// Clobber-safety: when a by-address aggregate is present (shimNeedStageArm32) the
// outgoing cursor can outrun the incoming one, so an outgoing write could clobber a
// later arg's not-yet-read incoming register.  arm32 (unlike aarch64) has no
// caller-saved register bank to stage into (only R12/IP; R4..R11 are callee-saved),
// so — like x64 — the incoming dispatch words are staged to a BALANCED scratch
// stack area (Sub SP to ALLOCATE, then Str, read back below, Add SP to FREE before
// the branch/BL, so the caller shape's SP is untouched at the tail-branch).  IP is
// the transient pointer/load scratch (an intra-call scratch, not an AAPCS32 arg or
// return reg, so it can't clobber an outgoing arg reg or the return).  Without a
// by-address aggregate the GP destination index never exceeds the source index, so
// left-to-right MOVs read each source before it is overwritten — no staging needed
// (an int64's two words are moved lo-then-hi, which stays clobber-safe even when the
// flat soft-float seam overlaps the outgoing/incoming pairs by one register — the hi
// move can only clobber the already-read lo source; see the isPair64Typ branch).
func emitShimArgMarshalArm32(a @asm.Assembler, cc common.CallConv, fvTyp @types.Type, srcPrefix int,
		gpDestBase int, forceStage bool) {
	// forceStage makes the marshal stage the incoming words to a balanced SP
	// scratch even without a by-address aggregate.  Its non-staged fast path does
	// left-to-right MOVs whose clobber-safety relies on gpDestBase <= srcPrefix (a
	// DOWN-shift: the destination register index never exceeds the source's).  The
	// capturing-closure shim breaks that: it prepends captureWords into the low
	// registers and marshals user args with gpDestBase = captureWords > srcPrefix (an
	// UP-shift), so a later arg's not-yet-read incoming register would be clobbered by
	// an earlier arg's outgoing write.  Sourcing every word from the staged frame makes
	// the placement order-independent, so the caller sets forceStage for the UP-shift.
	var needStage bool = forceStage || shimNeedStageArm32(cc, fvTyp)
	var frame int = 0
	if needStage {
		var nIn int = shimInWordsArm32(cc, fvTyp, srcPrefix)
		frame = nIn * cc.WordBytes
		// Keep SP 8-aligned across the marshal (AAPCS32 stack alignment); the
		// staged area is a private scratch, freed before the branch/BL.
		if frame % cc.StackAlign != 0 { frame = frame + cc.WordBytes }
		if frame > 0 {
			// ARM stack grows DOWN, so ALLOCATE the scratch with a SUB (grow=false),
			// spilling the incoming words BELOW entry-SP.
			emitSpAdjust(a, false, frame)
			for w := 0; w < nIn; w++ {
				arm32.Str(a, arm32.COND_AL, argReg(srcPrefix + w), arm32.MemImm(arm32.SP, cc.WordBytes * w))
			}
		}
	}
	var ngrn int = 0
	var srcWord int = 0
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		if hardFloatShimSkipArm32(pt) { continue } // float scalar rides VFP, pass-through
		if isByAddressAggArm32(cc, pt) {
			// AAPCS §6.5 C.3 even-register-pair pad on the OUTGOING cursor only —
			// byte-identical to shimOutRegs / argRegWordsStackWords.  The pad register
			// is left UNWRITTEN (undefined by the ABI).
			if cc.NeedsEvenReg(pt) && (gpDestBase + ngrn) % 2 != 0 {
				ngrn = ngrn + 1
			}
			emitShimByAddrAggArm32(a, cc, pt, gpDestBase, ngrn, argReg(srcPrefix + srcWord), srcWord,
					frame > 0)
			ngrn = ngrn + cc.ArgWords(pt)
			srcWord = srcWord + 1
			continue
		}
		if isPair64Typ(pt) {
			// A 64-bit register-pair scalar (int64 / uint64 / float64) arrives INLINE as
			// its two value-words (NOT by-address).  (A soft-float float64 rides this pair
			// bit-for-bit like an int64 — the same two-word lo/hi copy.)  The OUTGOING pair
			// always even-pair-pads (→ the underlying's AAPCS32 convention), keyed on
			// gpDestBase + ngrn.  The INCOMING side is the positional seam: flat under
			// soft-float (the two value-words ride consecutive slots — a straddle across
			// the reg/stack boundary is the caller's business, never here since an
			// over-budget pair routes to the spill path), and even-pair-padded ONLY under
			// hard-float (seamIncomingEvenPairArm32), keyed on srcPrefix + srcWord.  A
			// register-only pair never SPLITs (the incoming budget check routes an
			// over-budget one to the spill path via shimArgsFitRegisters), never
			// here.
			if cc.NeedsEvenReg(pt) && (gpDestBase + ngrn) % 2 != 0 {
				ngrn = ngrn + 1
			}
			if seamIncomingEvenPairArm32(cc, pt) && (srcPrefix + srcWord) % 2 != 0 {
				srcWord = srcWord + 1
			}
			// Move the 2 inline value-words to argReg(gpDestBase+ngrn){,+1}.  The
			// register-only path only ever DOWN-shifts (gpDestBase <= srcPrefix), and the
			// moves are emitted lo-THEN-hi, which is clobber-safe for any down-shift: the
			// hi move can only overwrite loSrc (never hiSrc), so reading loSrc first is
			// enough.  On the FLAT soft-float seam the pairs can overlap by exactly ONE
			// register (outgoing R0:R1, incoming R1:R2 — hiDst == loSrc), so this order is
			// LOAD-BEARING, not immaterial.  Under hard-float both pads even-align their
			// cursor, so the pairs are IDENTICAL or disjoint by >= 2 and order is moot.
			// With staging both reads come from the frame, likewise safe.
			var loDst int = argReg(gpDestBase + ngrn)
			var hiDst int = argReg(gpDestBase + ngrn + 1)
			if frame > 0 {
				arm32.Ldr(a, arm32.COND_AL, loDst, arm32.MemImm(arm32.SP, cc.WordBytes * srcWord))
				arm32.Ldr(a, arm32.COND_AL, hiDst, arm32.MemImm(arm32.SP, cc.WordBytes * (srcWord + 1)))
			} else {
				var loSrc int = argReg(srcPrefix + srcWord)
				var hiSrc int = argReg(srcPrefix + srcWord + 1)
				if loDst != loSrc {
					arm32.Mov(a, arm32.COND_AL, false, loDst, arm32.Reg(loSrc))
				}
				if hiDst != hiSrc {
					arm32.Mov(a, arm32.COND_AL, false, hiDst, arm32.Reg(hiSrc))
				}
			}
			ngrn = ngrn + 2
			srcWord = srcWord + 2
			continue
		}
		// Even-pair pad for an arg that keeps its real type in the dispatch
		// (paddedKeepsTypeArm32).  The int64 / uint64 branch is peeled off above, so the
		// ONLY such arg reaching here is an 8-ALIGNED INDIRECT-LARGE aggregate (>16 bytes,
		// AlignOf 8 — e.g. struct{int64,int64,int64}), riding ONE pointer word through the
		// generic loop below.  The OUTGOING cursor (gpDestBase + ngrn) always pads (→ the
		// callee's AAPCS32 placement) — else it writes the pointer one register below
		// where the callee reads it.  The INCOMING cursor (srcPrefix + srcWord) is the
		// positional seam: flat under soft-float, padded ONLY under hard-float
		// (seamIncomingEvenPairArm32) — else it reads the pointer from the wrong slot.
		// (A by-address aggregate rides a 4-aligned *uint8 and is excluded, so it is not
		// double-padded.)
		if paddedKeepsTypeArm32(cc, pt) && (gpDestBase + ngrn) % 2 != 0 {
			ngrn = ngrn + 1
		}
		if seamIncomingEvenPairArm32(cc, pt) && (srcPrefix + srcWord) % 2 != 0 {
			srcWord = srcWord + 1
		}
		// Effective words: an indirect-large aggregate is 1 pointer word (the
		// dispatch caller placed it as one), NOT its ArgWords expansion.  (A
		// by-address aggregate is peeled off above, so this counts scalars / pointers
		// / indirect-large only — where shimInWordsForTypeArm32 equals EffectiveArgWords.)
		var w int = shimInWordsForTypeArm32(cc, pt)
		for k := 0; k < w; k++ {
			var dst int = argReg(gpDestBase + ngrn + k)
			if frame > 0 {
				arm32.Ldr(a, arm32.COND_AL, dst, arm32.MemImm(arm32.SP, cc.WordBytes * (srcWord + k)))
			} else {
				var src int = argReg(srcPrefix + srcWord + k)
				if dst != src {
					arm32.Mov(a, arm32.COND_AL, false, dst, arm32.Reg(src))
				}
			}
		}
		ngrn = ngrn + w
		srcWord = srcWord + w
	}
	if frame > 0 {
		// FREE the balanced scratch with an ADD (grow=true) so SP returns to entry
		// before the tail-branch/BL — the frameless shapes stay frameless.
		emitSpAdjust(a, true, frame)
	}
}

// emitShimByAddrAggArm32 re-expands one by-address in-register aggregate arg (a
// coerced array/named/anon struct OR a non-coerced slice / iface-value /
// managed-slice).  Its by-address pointer is the srcWord-th
// incoming dispatch word: staged at [SP + WordBytes*srcWord] when `staged`, else
// live in liveReg (the incoming arg register).  Park it in IP, then load its
// ArgWords value-words from [IP + 4k] into the consecutive outgoing GP regs
// argReg(gpDestBase + ngrn + k) the underlying's AAPCS32 ABI reads (word-by-word
// from the value image, matching emitAggregateArg / the callee's
// writeAggParamSpillPtr layout).  ngrn already carries any even-register-pair pad
// the caller inserted, so the value-words land on the correctly-aligned register.
// IP is disjoint from the R0..R3 outgoing bank and the R0/R0:R1 return, so the
// loads can't clobber an outgoing arg or the result.  (The register-only marshal
// always stages when any by-address aggregate is present, so `staged` is true on
// the exercised path; the live-register branch keeps this correct if the staging
// invariant ever changes.)
func emitShimByAddrAggArm32(a @asm.Assembler, cc common.CallConv, pt @types.Type, gpDestBase int,
		ngrn int, liveReg int, srcWord int, staged bool) {
	if staged {
		arm32.Ldr(a, arm32.COND_AL, arm32.IP, arm32.MemImm(arm32.SP, cc.WordBytes * srcWord))
	} else {
		arm32.Mov(a, arm32.COND_AL, false, arm32.IP, arm32.Reg(liveReg))
	}
	var n int = cc.ArgWords(pt)
	for k := 0; k < n; k++ {
		arm32.Ldr(a, arm32.COND_AL, argReg(gpDestBase + ngrn + k),
				arm32.MemImm(arm32.IP, cc.WordBytes * k))
	}
}
