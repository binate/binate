package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Byte-level tests for the register-only coerced-aggregate ARG marshaling in
// arm32_funcvalue_marshal.bn (P1): a <=16-byte by-value named struct arg arrives
// as ONE by-address dispatch pointer word and must be re-expanded into the
// underlying's AAPCS32 coerced GP regs.  Each shape (scalar/void, sret, pack,
// multiret-pack) is compared byte-for-byte against a hand-built reference shim so
// the exact expansion — park the incoming pointer in IP, load its value-words into
// consecutive GP regs at the right positions — is pinned, matching the aarch64 /
// x64 twins and the needStage staging discipline for mixed scalar+aggregate lists.

// coercedStruct2_marshaltest is an 8-byte (ILP32) named 2-int struct — a coerced
// in-register aggregate (AggCoercedInReg true), 2 ArgWords.
func coercedStruct2_marshaltest() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt()
	return types.MakeStructType("S2_marshaltest", fields)
}

// coercedStruct3_marshaltest is a 12-byte (ILP32) named 3-int struct — 3 ArgWords,
// the widest coerced aggregate that still fits the scalar/void register budget
// (R0..R2, prefix 1 leaves R1..R3 incoming = 1 pointer word).
func coercedStruct3_marshaltest() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	return types.MakeStructType("S3_marshaltest", fields)
}

// coercedStruct8Aligned_marshaltest is an 8-byte (ILP32) named struct with a
// single int64 field — SizeOf 8, AlignOf 8 (so cc.NeedsEvenReg is true), 2
// ArgWords.  This is the case that triggers the AAPCS §6.5 C.3 even-register-pair
// pad on the outgoing shim cursor.
func coercedStruct8Aligned_marshaltest() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt64()
	return types.MakeStructType("S8_marshaltest", fields)
}

// fvOneParam_marshaltest builds a func-value type with one param `pt` and the
// given results.
func fvOneParam_marshaltest(pt @types.Type, results @[]@types.Type) @types.Type {
	var params @[]@types.Param = make_slice(@types.Param, 1)
	params[0] = make(types.Param)
	params[0].Type = pt
	return types.MakeFuncValueType(params, results)
}

// fvTwoParams_marshaltest builds a func-value type with two params (pt0, pt1) and
// the given results.
func fvTwoParams_marshaltest(pt0 @types.Type, pt1 @types.Type, results @[]@types.Type) @types.Type {
	var params @[]@types.Param = make_slice(@types.Param, 2)
	params[0] = make(types.Param)
	params[0].Type = pt0
	params[1] = make(types.Param)
	params[1].Type = pt1
	return types.MakeFuncValueType(params, results)
}

// emitStageOneAggMarshalRef emits the reference register-only marshal for a shim
// whose SOLE user arg is one coerced aggregate of `argWords` words: stage the one
// incoming pointer word (from argReg(srcPrefix)) to [SP,#0], park it in IP, load
// its value-words into argReg(gpDestBase + k), balanced SP scratch.  Mirrors
// emitShimArgMarshalArm32's needStage path for a single-aggregate arg list.
func emitStageOneAggMarshalRef(a @asm.Assembler, cc common.CallConv, argWords int, srcPrefix int,
		gpDestBase int) {
	// One incoming pointer word; frame rounded up to StackAlign (8).  ARM stack
	// grows DOWN: SUB to ALLOCATE the scratch, ADD to FREE it.
	var frame int = cc.WordBytes
	if frame % cc.StackAlign != 0 { frame = frame + cc.WordBytes }
	emitSpAdjust(a, false, frame)
	arm32.Str(a, arm32.COND_AL, argReg(srcPrefix), arm32.MemImm(arm32.SP, 0))
	arm32.Ldr(a, arm32.COND_AL, arm32.IP, arm32.MemImm(arm32.SP, 0))
	for k := 0; k < argWords; k++ {
		arm32.Ldr(a, arm32.COND_AL, argReg(gpDestBase + k), arm32.MemImm(arm32.IP, cc.WordBytes * k))
	}
	emitSpAdjust(a, true, frame)
}

// The scalar/void shim with a single coerced 2-int aggregate arg re-expands the
// by-address pointer into R0:R1 (gpDestBase 0), staging the incoming R1 pointer,
// then tail-branches.  Byte-compared against the hand-built reference.
func TestScalarVoidShimCoercedAggExpands() testing.TestResult {
	setArm32Target()
	var cc common.CallConv = common.AAPCS32()
	var noResults @[]@types.Type
	var fv @types.Type = fvOneParam_marshaltest(coercedStruct2_marshaltest(), noResults)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitScalarVoidShim(got, "bn_ref", fv)
	if got.HasError { return fail("scalar/void coerced-agg shim must not error") }

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	emitStageOneAggMarshalRef(ref, cc, 2, 1, 0)
	ref.SetGlobal("bn_ref")
	arm32.B(ref, arm32.COND_AL, "bn_ref")

	if !asmTextEqMarshal(got, ref) {
		return fail(
				"scalar/void coerced-agg shim bytes must match the reference "
						"(stage R1, park in IP, LDR R0/R1 from [IP], tail-branch)")
	}
	return ""
}

// A 3-int coerced aggregate expands into R0:R1:R2 (3 ArgWords) — the widest that
// fits the scalar/void budget — proving the value-word count follows ArgWords.
func TestScalarVoidShimCoerced3WordAggExpands() testing.TestResult {
	setArm32Target()
	var cc common.CallConv = common.AAPCS32()
	var noResults @[]@types.Type
	var fv @types.Type = fvOneParam_marshaltest(coercedStruct3_marshaltest(), noResults)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitScalarVoidShim(got, "bn_ref", fv)
	if got.HasError { return fail("scalar/void 3-word coerced-agg shim must not error") }

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	emitStageOneAggMarshalRef(ref, cc, 3, 1, 0)
	ref.SetGlobal("bn_ref")
	arm32.B(ref, arm32.COND_AL, "bn_ref")

	if !asmTextEqMarshal(got, ref) {
		return fail(
				"scalar/void 3-word coerced-agg shim bytes must match the reference "
						"(LDR R0/R1/R2 from [IP])")
	}
	return ""
}

// The SRET shim keeps R0 = retbuf and re-expands a coerced aggregate arg into the
// underlying's R1.. (gpDestBase 1), staging the incoming R2 pointer (srcPrefix 2 —
// R0 retbuf, R1 data), then tail-branches.  A 2-int agg -> R1:R2.
func TestSretShimCoercedAggExpands() testing.TestResult {
	setArm32Target()
	var cc common.CallConv = common.AAPCS32()
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = aggPairType() // 8-byte struct return -> sret shape (> 4)
	var fv @types.Type = fvOneParam_marshaltest(coercedStruct2_marshaltest(), results)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitFuncValueShimBody(got, "bn_ref", fv)
	if got.HasError { return fail("sret coerced-agg shim must not error") }

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	emitStageOneAggMarshalRef(ref, cc, 2, 2, 1)
	ref.SetGlobal("bn_ref")
	arm32.B(ref, arm32.COND_AL, "bn_ref")

	if !asmTextEqMarshal(got, ref) {
		return fail(
				"sret coerced-agg shim bytes must match the reference "
						"(retbuf stays R0; stage R2, LDR R1/R2 from [IP], tail-branch)")
	}
	return ""
}

// The PACK shim (small <=4-byte aggregate return, by value in R0) frames up
// (push {r4,lr}; mov r4,r0 = retbuf save), re-expands a coerced aggregate arg into
// R0.. (gpDestBase 0, srcPrefix 2), BLs, stores R0 through retbuf, pops.  The
// marshal's balanced SP scratch composes with the push frame (R4 untouched).
func TestPackShimCoercedAggExpands() testing.TestResult {
	setArm32Target()
	var cc common.CallConv = common.AAPCS32()
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = aggSmallType() // 4-byte struct return -> pack shape (<= 4)
	var fv @types.Type = fvOneParam_marshaltest(coercedStruct2_marshaltest(), results)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitFuncValueShimBody(got, "bn_ref", fv)
	if got.HasError { return fail("pack coerced-agg shim must not error") }

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Push(ref, arm32.COND_AL, packShimPushMask())
	arm32.Mov(ref, arm32.COND_AL, false, arm32.R4, arm32.Reg(arm32.R0))
	emitStageOneAggMarshalRef(ref, cc, 2, 2, 0)
	ref.SetGlobal("bn_ref")
	arm32.Bl(ref, arm32.COND_AL, "bn_ref")
	arm32.Str(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R4, 0))
	arm32.Pop(ref, arm32.COND_AL, packShimPopMask())

	if !asmTextEqMarshal(got, ref) {
		return fail(
				"pack coerced-agg shim bytes must match the reference "
						"(push, mov r4,r0, stage+expand to R0:R1, bl, str r0,[r4], pop)")
	}
	return ""
}

// The MULTIRET-pack shim (small multi-return, field-per-register) frames up like
// pack, re-expands a coerced aggregate arg into R0.. (gpDestBase 0, srcPrefix 2),
// BLs, then stores the tuple fields through retbuf.  Assert the ARG-MARSHAL PREFIX
// (push, mov r4,r0, stage+expand, up to the BL) matches the reference — the
// post-BL field stores are covered by the return-shape tests.
func TestMultiRetPackShimCoercedAggExpands() testing.TestResult {
	setArm32Target()
	var cc common.CallConv = common.AAPCS32()
	// Two int32 results -> small multi-return (2 GP words, field-per-register).
	var results @[]@types.Type = make_slice(@types.Type, 2)
	results[0] = types.TypInt32()
	results[1] = types.TypInt32()
	var fv @types.Type = fvOneParam_marshaltest(coercedStruct2_marshaltest(), results)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitFuncValueShimBody(got, "bn_ref", fv)
	if got.HasError { return fail("multiret-pack coerced-agg shim must not error") }

	// Reference: the marshal prefix through the BL (push, mov r4,r0, stage+expand).
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Push(ref, arm32.COND_AL, packShimPushMask())
	arm32.Mov(ref, arm32.COND_AL, false, arm32.R4, arm32.Reg(arm32.R0))
	emitStageOneAggMarshalRef(ref, cc, 2, 2, 0)
	if !textPrefixEqMarshal(got, ref) {
		return fail(
				"multiret-pack coerced-agg shim's arg-marshal prefix must match "
						"the reference (push, mov r4,r0, stage R2, LDR R0/R1 from [IP])")
	}
	return ""
}

// A MIXED scalar+aggregate arg list (int, S2) MUST stage: the aggregate expands
// R0:R1:R2 while the incoming ints sit in R1..R3, so an un-staged outgoing write
// would clobber a not-yet-read incoming reg.  Byte-compare against the reference
// staged marshal (stage both incoming words, then place from the frame / IP).
func TestShimMixedScalarAggStagesClobberSafe() testing.TestResult {
	setArm32Target()
	var cc common.CallConv = common.AAPCS32()
	var noResults @[]@types.Type
	var params @[]@types.Param = make_slice(@types.Param, 2)
	params[0] = make(types.Param)
	params[0].Type = types.TypInt()
	params[1] = make(types.Param)
	params[1].Type = coercedStruct2_marshaltest()
	var fv @types.Type = types.MakeFuncValueType(params, noResults)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitScalarVoidShim(got, "bn_ref", fv)
	if got.HasError { return fail("mixed scalar+agg shim must not error") }

	// Reference (scalar/void, srcPrefix 1, gpDestBase 0): stage the 2 incoming
	// words (int in R1, &S in R2) to [SP,#0]/[SP,#4]; place the int from [SP,#0]
	// into R0; expand the aggregate (park [SP,#4] in IP, LDR R1/R2 from [IP]).
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	emitSpAdjust(ref, false, 8) // 2 words -> 8, already StackAlign-aligned; SUB allocates
	arm32.Str(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.SP, 0))
	arm32.Str(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.SP, 4))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.SP, 0)) // int -> R0
	arm32.Ldr(ref, arm32.COND_AL, arm32.IP, arm32.MemImm(arm32.SP, 4)) // &S -> IP
	arm32.Ldr(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.IP, 0)) // S.f0 -> R1
	arm32.Ldr(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.IP, 4)) // S.f1 -> R2
	emitSpAdjust(ref, true, 8) // ADD frees
	ref.SetGlobal("bn_ref")
	arm32.B(ref, arm32.COND_AL, "bn_ref")

	if !asmTextEqMarshal(got, ref) {
		return fail(
				"mixed scalar+agg shim must stage both incoming words and expand "
						"clobber-safely (bytes must match the staged reference)")
	}
	return ""
}

// shimNeedStageArm32 is true exactly when the arg list contains a coerced
// in-register aggregate — the register-permutation hazard that forces staging.
func TestShimNeedStagePredicateArm32() testing.TestResult {
	setArm32Target()
	var noResults @[]@types.Type
	var allScalar @[]@types.Param = make_slice(@types.Param, 2)
	allScalar[0] = make(types.Param)
	allScalar[0].Type = types.TypInt()
	allScalar[1] = make(types.Param)
	allScalar[1].Type = types.MakeManagedPtrType(types.TypInt())
	if shimNeedStageArm32(types.MakeFuncValueType(allScalar, noResults)) {
		return fail("an all-scalar arg list must not need staging")
	}
	var withAgg @[]@types.Param = make_slice(@types.Param, 2)
	withAgg[0] = make(types.Param)
	withAgg[0].Type = types.TypInt()
	withAgg[1] = make(types.Param)
	withAgg[1].Type = coercedStruct2_marshaltest()
	if !shimNeedStageArm32(types.MakeFuncValueType(withAgg, noResults)) {
		return fail("a coerced-aggregate arg list must need staging")
	}
	return ""
}

// An 8-byte-aligned coerced aggregate (S8 = struct{int64}) after a leading int32
// obeys AAPCS §6.5 C.3: the int32 takes R0 (outgoing cursor 1, ODD), so the
// aggregate skips R1 (an even-pair PAD, left unwritten) and expands into R2:R3 —
// matching where the callee (argRegWordsStackWords) reads it.  A plain linear
// cursor would place it at R1:R2, which the callee would then MISread.  Byte-
// compared against the reference that stages both incoming words, places the int32
// into R0, and expands the aggregate into R2:R3 (the R1 pad register untouched).
func TestScalarVoidShim8AlignedAggEvenPairBump() testing.TestResult {
	setArm32Target()
	var cc common.CallConv = common.AAPCS32()
	var noResults @[]@types.Type
	var fv @types.Type = fvTwoParams_marshaltest(types.TypInt32(), coercedStruct8Aligned_marshaltest(),
			noResults)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitScalarVoidShim(got, "bn_ref", fv)
	if got.HasError { return fail("scalar/void 8-aligned-agg shim must not error") }

	// Reference: stage the 2 incoming words (int32 in R1, &S8 in R2) to [SP,#0]/
	// [SP,#4]; int32 -> R0; even-pair pad skips R1; expand &S8 (park [SP,#4] in IP,
	// LDR R2/R3 from [IP]).
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	emitSpAdjust(ref, false, 8) // SUB allocates 2-word scratch
	arm32.Str(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.SP, 0))
	arm32.Str(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.SP, 4))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.SP, 0)) // int32 -> R0
	arm32.Ldr(ref, arm32.COND_AL, arm32.IP, arm32.MemImm(arm32.SP, 4)) // &S8 -> IP (R1 padded)
	arm32.Ldr(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.IP, 0)) // S8.lo -> R2
	arm32.Ldr(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.IP, 4)) // S8.hi -> R3
	emitSpAdjust(ref, true, 8) // ADD frees
	ref.SetGlobal("bn_ref")
	arm32.B(ref, arm32.COND_AL, "bn_ref")

	if !asmTextEqMarshal(got, ref) {
		return fail(
				"scalar/void 8-aligned-agg shim must even-pair-pad R1 and expand into "
						"R2:R3 (bytes must match the padded reference)")
	}
	return ""
}

// In the SRET shape the aggregate's ABSOLUTE outgoing register index is
// gpDestBase (1, since R0 holds the sret buffer) + the cursor.  A FIRST-arg
// 8-aligned aggregate is therefore at absolute index 1 (ODD) even with an empty
// cursor, so it takes an even-pair pad and expands into R2:R3 (skipping R1) —
// proving the pad keys on the ABSOLUTE index, not the relative one.
func TestSretShim8AlignedAggEvenPairBump() testing.TestResult {
	setArm32Target()
	var cc common.CallConv = common.AAPCS32()
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = aggPairType() // 8-byte struct return -> sret shape (> 4)
	var fv @types.Type = fvOneParam_marshaltest(coercedStruct8Aligned_marshaltest(), results)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitFuncValueShimBody(got, "bn_ref", fv)
	if got.HasError { return fail("sret 8-aligned-agg shim must not error") }

	// Reference (sret, srcPrefix 2, gpDestBase 1): stage the incoming &S8 (R2) to
	// [SP,#0]; absolute index 1 is odd so R1 is a pad; expand &S8 into R2:R3.
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	emitSpAdjust(ref, false, 8) // 1 word -> 4 -> StackAlign 8; SUB allocates
	arm32.Str(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.SP, 0)) // &S8 (srcPrefix 2)
	arm32.Ldr(ref, arm32.COND_AL, arm32.IP, arm32.MemImm(arm32.SP, 0)) // &S8 -> IP (R1 padded)
	arm32.Ldr(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.IP, 0)) // S8.lo -> R2
	arm32.Ldr(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.IP, 4)) // S8.hi -> R3
	emitSpAdjust(ref, true, 8) // ADD frees
	ref.SetGlobal("bn_ref")
	arm32.B(ref, arm32.COND_AL, "bn_ref")

	if !asmTextEqMarshal(got, ref) {
		return fail(
				"sret 8-aligned-agg shim must even-pair-pad R1 (absolute index 1) and "
						"expand into R2:R3 (bytes must match the padded reference)")
	}
	return ""
}

// An 8-aligned aggregate whose absolute outgoing register index is already EVEN
// takes NO pad — proving the bump is conditional, not unconditional.  In the
// scalar/void shape a sole S8 arg is at absolute index 0 (even), so it expands
// straight into R0:R1, byte-identical to the single-aggregate reference (which
// models no pad).
func TestScalarVoidShim8AlignedAggNoPadWhenEven() testing.TestResult {
	setArm32Target()
	var cc common.CallConv = common.AAPCS32()
	var noResults @[]@types.Type
	var fv @types.Type = fvOneParam_marshaltest(coercedStruct8Aligned_marshaltest(), noResults)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitScalarVoidShim(got, "bn_ref", fv)
	if got.HasError { return fail("scalar/void even-index 8-aligned-agg shim must not error") }

	// Reference: no pad; expand into R0:R1 (2 ArgWords) from the staged pointer.
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	emitStageOneAggMarshalRef(ref, cc, 2, 1, 0)
	ref.SetGlobal("bn_ref")
	arm32.B(ref, arm32.COND_AL, "bn_ref")

	if !asmTextEqMarshal(got, ref) {
		return fail(
				"scalar/void 8-aligned-agg at an EVEN absolute index must take no pad "
						"(expand into R0:R1, bytes must match the unpadded reference)")
	}
	return ""
}

// An 8-aligned coerced aggregate whose even-pair pad pushes it PAST the register
// budget must FAIL LOUDLY (the stack-spill path), NOT silently miscompile.  In the
// sret shape (gpDestBase 1) a first-arg S8 pads to R2:R3 (absolute index 1 odd),
// leaving the trailing int32 at R4 — beyond R3.  Without the pad it would fit
// (S8 R1:R2, int32 R3), so the OVERFLOW IS CAUSED BY THE PAD: the budget accounting
// must see the pad, so this SetErrors and emits nothing.
func TestSretShim8AlignedAggPadOverflowsFailsLoud() testing.TestResult {
	setArm32Target()
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = aggPairType() // sret shape (gpDestBase 1)
	var fv @types.Type = fvTwoParams_marshaltest(coercedStruct8Aligned_marshaltest(), types.TypInt32(),
			results)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitFuncValueShimBody(got, "bn_ref", fv)
	if !got.HasError {
		return fail("an 8-aligned agg whose even-pair pad overflows R3 must fail loud")
	}
	if got.Sections[0].Len != 0 {
		return fail("a fail-loud over-budget shim must emit no text (return before emitting)")
	}
	return ""
}

// asmTextEqMarshal reports whether two assemblers emitted byte-identical text
// sections (length + bytes).  Proves the shim marshal matches a hand-built
// reference instruction-for-instruction.
func asmTextEqMarshal(a0 @asm.Assembler, a1 @asm.Assembler) bool {
	if a0.Sections[0].Len != a1.Sections[0].Len { return false }
	// bnlint:allow managed-to-raw-assign - live @Assembler fields; outlive the read
	var d0 *[]uint8 = a0.Sections[0].Data
	// bnlint:allow managed-to-raw-assign - live @Assembler fields; outlive the read
	var d1 *[]uint8 = a1.Sections[0].Data
	for i := 0; i < a0.Sections[0].Len; i++ {
		if d0[i] != d1[i] { return false }
	}
	return true
}

// textPrefixEqMarshal reports whether the first a1.Len bytes of a0's text match
// a1's text — used to pin a shim's arg-marshal PREFIX (through the BL) while
// leaving its shape-specific tail (post-call field stores) to other tests.
func textPrefixEqMarshal(a0 @asm.Assembler, a1 @asm.Assembler) bool {
	if a0.Sections[0].Len < a1.Sections[0].Len { return false }
	// bnlint:allow managed-to-raw-assign - live @Assembler fields; outlive the read
	var d0 *[]uint8 = a0.Sections[0].Data
	// bnlint:allow managed-to-raw-assign - live @Assembler fields; outlive the read
	var d1 *[]uint8 = a1.Sections[0].Data
	for i := 0; i < a1.Sections[0].Len; i++ {
		if d0[i] != d1[i] { return false }
	}
	return true
}
