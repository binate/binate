package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Func-value multi-return classification
// ============================================================
//
// The func-value SHIM must classify a multi-return tuple's return shape
// (in-register field-per-register vs sret through R0) IDENTICALLY to the callee
// (emitMultiReturnPack / emitMultiReturnSret in arm32_return.bn) and the caller
// (collectMultiReturnFields in arm32_call.bn) — otherwise the shim and the
// underlying disagree on whether a retbuf pointer is passed, mismarshaling the
// boundary.  Mirrors x64_funcvalue_shim.bn's funcValMultiReturnTuple_x64 /
// isBigMultiReturn_x64.

// funcValMultiReturnTupleArm32 builds the anonymous multi-return tuple struct for
// a function value's results (one field per result type, in order — field names
// don't affect layout), or nil when the function value isn't a multi-return
// (len(Results) <= 1).
func funcValMultiReturnTupleArm32(fvTyp @types.Type) @types.Type {
	if fvTyp == nil { return nil }
	if len(fvTyp.Results) <= 1 { return nil }
	var fields @[]@types.Field = make_slice(@types.Field, len(fvTyp.Results))
	for i := 0; i < len(fvTyp.Results); i++ {
		var f @types.Field = make(types.Field)
		f.Type = fvTyp.Results[i]
		fields[i] = f
	}
	return types.MakeStructType("", fields)
}

// isBigMultiReturnArm32 reports whether the function value's multi-return tuple
// is returned via an sret pointer (in R0) rather than field-per-register in
// r0..r3.  It uses the SAME register-count rule (common.AAPCS32().
// MultiReturnTupleNeedsSret — gpWords > NumGpRetRegs = 4, soft-float folding
// float fields into the GP count) the callee and the regular call sites use, so
// the funcval call site and shim agree with the callee — a size-only rule would
// disagree for e.g. (int64 x2) (16 bytes, but 4 GP words → in-register) at the
// native<->LLVM boundary.
func isBigMultiReturnArm32(fvTyp @types.Type) bool {
	var t @types.Type = funcValMultiReturnTupleArm32(fvTyp)
	if t == nil { return false }
	return common.AAPCS32().MultiReturnTupleNeedsSret(t)
}

// emitMultiRetPackShim emits the SMALL multi-return (gpWords <= 4) framed CALL
// shim.  Under retbuf-for-any-multi-return the caller passes the retbuf in R0,
// data in R1, user args in R2.. — but the underlying returns the tuple FIELD-PER-
// REGISTER in r0..r3 (no sret arg), so the shim must save the retbuf, drop the
// retbuf+data prefix (shifting user args R2.. down to R0..), BL the underlying,
// then store the returned r0..r3 THROUGH the saved retbuf at each field's offset
// (AAPCS32 8-alignment discipline in the tuple layout).  It saves retbuf in R4
// (callee-saved, so the BL preserves it — and the push restores the caller's R4),
// mirroring emitPackShim's frame (packShimPushMask / packShimPopMask in
// arm32_funcvalue.bn).  Over-budget arg counts route to the framed-BL small-
// multiret stack-spill shim (usePackMulti).  Float returns are fail-loud upstream,
// so a float field can't reach the (soft-float, GP-only) field store here.
func emitMultiRetPackShim(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type) {
	var cc common.CallConv = common.AAPCS32()
	// The underlying returns the tuple field-per-register (no sret arg), so its user
	// args start at R0 (gpDestBase 0); the incoming dispatch drops retbuf + data
	// (srcPrefix 2).
	var nOut int = shimOutRegs(a, cc, fvTyp, 0)
	if nOut < 0 { return }
	if !shimArgsFitRegisters(cc, fvTyp, 2, 0, nOut) {
		// Over-budget: the framed-BL small-multiret spill (retbuf stashed to the
		// frame; the underlying returns the tuple field-per-register in r0..r3,
		// which the spill stores through the reloaded retbuf — usePackMulti).
		emitFuncvalSpillShimArm32(a, cc, fnLabel, fvTyp, 0, false, false, true, false)
		return
	}
	// push {r4, lr}: save the caller's R4 (reused for retbuf) and LR (the BL
	// clobbers it).  Two registers keep SP 8-aligned across the call (AAPCS32).
	arm32.Push(a, arm32.COND_AL, packShimPushMask())
	// retbuf (R0) -> R4: survives the BL (R4 is callee-saved).
	arm32.Mov(a, arm32.COND_AL, false, arm32.R4, arm32.Reg(arm32.R0))
	// Drop retbuf + data; marshal user args (incoming R2..) down to R0.., re-
	// expanding any coerced in-register aggregate by-address (emitShimArgMarshalArm32,
	// which stages to a balanced SP scratch when one is present — freed before the BL;
	// R4 is untouched).
	emitShimArgMarshalArm32(a, cc, fvTyp, 2, 0, false)
	a.SetGlobal(fnLabel)
	arm32.Bl(a, arm32.COND_AL, fnLabel)
	// Store the field-per-register tuple (r0..r3) through the saved retbuf (R4).
	// baseOff 0 (R4 points at the tuple); IP is the large-offset scratch, unused
	// here since a tuple's own field offsets always fit the STR immediate.
	storeMultiReturnTupleFieldsArm32(a, funcValMultiReturnTupleArm32(fvTyp), arm32.R4, 0,
			cc.NumGpRetRegs, cc.WordBytes, arm32.IP)
	// pop {r4, pc}: restore the caller's R4 and return (writing PC).
	arm32.Pop(a, arm32.COND_AL, packShimPopMask())
}
