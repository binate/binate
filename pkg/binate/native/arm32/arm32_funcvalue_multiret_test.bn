package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// isBigMultiReturnArm32 uses the register-count rule: (int32 x4) = 4 GP words is
// in-register (not big); (int32 x5) = 5 GP words srets (big).  It must classify
// identically to the callee / caller or the shim boundary mismarshals.
// mkMultiReturnFv_arm32test lives in arm32_funcvalue_test.bn (same package).
func TestIsBigMultiReturnArm32RegisterCount() testing.TestResult {
	setArm32Target()
	if isBigMultiReturnArm32(mkMultiReturnFv_arm32test(4)) {
		return fail("(int32 x4) = 4 GP words must be in-register, not big")
	}
	if !isBigMultiReturnArm32(mkMultiReturnFv_arm32test(5)) {
		return fail("(int32 x5) = 5 GP words must be a big (sret) multi-return")
	}
	if isBigMultiReturnArm32(mkMultiReturnFv_arm32test(1)) {
		return fail("a single result is not a multi-return")
	}
	return ""
}

// funcValMultiReturnTupleArm32 builds the anonymous (unnamed) tuple struct for a
// multi-return func value's results, and nil for a single-result / void func
// value.  The tuple's fields must match the results in order.
func TestFuncValMultiReturnTupleArm32() testing.TestResult {
	var t @types.Type = funcValMultiReturnTupleArm32(mkMultiReturnFv_arm32test(3))
	if t == nil {
		return fail("a 3-result func value must yield a tuple type")
	}
	if len(t.Name) != 0 {
		return fail("the multi-return tuple must be anonymous (no name)")
	}
	if len(t.Fields) != 3 {
		return fail("the tuple must have one field per result (3)")
	}
	if funcValMultiReturnTupleArm32(mkMultiReturnFv_arm32test(1)) != nil {
		return fail("a single-result func value is not a multi-return tuple")
	}
	return ""
}

// storeMultiReturnTupleFieldsArm32 is the ONE store loop shared by the caller
// collect (collectMultiReturnFields, base = SP + spill offset) and the func-value
// shim store-through-retbuf (base = the retbuf register, baseOff 0) — a single
// implementation so they cannot drift.  For an (int32 x3) tuple it stores r0,r1,r2
// one-per-field at base+0/+4/+8: three word stores, none dropped, no error.
func TestStoreMultiReturnTupleFieldsArm32PerField() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = mkAsm()
	var cc common.CallConv = common.AAPCS32()
	storeMultiReturnTupleFieldsArm32(a, funcValMultiReturnTupleArm32(
			mkMultiReturnFv_arm32test(3)), arm32.R4, 0, cc.NumGpRetRegs, cc.WordBytes, arm32.IP)
	if a.HasError {
		return fail("storing an (int32 x3) tuple must not error")
	}
	if bytesWritten(a) != 12 {
		return fail("an (int32 x3) tuple must emit 3 word stores (12 bytes)")
	}
	return ""
}
