package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for arm32_funcvalue_packed.bn: the per-function packed-dispatch shim
// (__shimP) the func-value vtable's slot-2 call_packed target points at.  It
// gathers the VM caller's packed int-slot args into __shim's incoming AAPCS32
// dispatch ABI and branches/calls __shim; register-only tail-branches (B),
// > budget frames a spill (push {r4,lr} + SUB sp) and BLs.

// packedShimForNIntsArm32 emits __shimP for an IsLinkOnce func value with nParams
// int params (scalar return) and returns (byteLen, hadError).  Mirrors the spill
// tests' wideShimEmitsArm32 module (setArm32Target + TypInt params, one word each
// on ILP32), but drives the packed emitter.
func packedShimForNIntsArm32(nParams int) (int, bool) {
	setArm32Target()
	var mod @ir.Module = ir.NewModule("\"main\"")
	var params @[]@ir.Param
	for i := 0; i < nParams; i++ {
		var p @ir.Param = make(ir.Param)
		p.Name = "x"
		p.Typ = types.TypInt()
		params = appendIrParam_spilltest_arm32(params, p)
	}
	var f @ir.Func = ir.NewFunc("", "pk", params, scalarResult_spilltest_arm32())
	f.IsLinkOnce = true
	mod.AddFunc(f)
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitFuncValuePackedShimsArm32(a, "main", mod)
	return a.Sections[0].Len, a.HasError
}

// A func value gets a non-empty __shimP, emitted without error.
func TestPackedShimEmittedArm32() testing.TestResult {
	var n int
	var err bool
	n, err = packedShimForNIntsArm32(2)
	if err {
		return "packed shim emission must not SetError"
	}
	if n == 0 {
		return "a func value must emit a non-empty __shimP"
	}
	return ""
}

// The > register-budget (spill) __shimP frames an outgoing-args area (push
// {r4,lr} + SUB sp) and BLs, so it is strictly longer than the register-only
// tail-branch __shimP.  5 int user words exceed the AAPCS32 scalar-shape budget
// (3 = R1..R3), so two spill; 2 words stay register-only.  A dropped spill frame
// (or an arity cap) would collapse the two lengths.
func TestPackedShimSpillLongerThanRegisterOnlyArm32() testing.TestResult {
	var regOnly int
	var spill int
	var e1 bool
	var e2 bool
	regOnly, e1 = packedShimForNIntsArm32(2)
	spill, e2 = packedShimForNIntsArm32(5)
	if e1 || e2 {
		return "packed shim emission must not SetError"
	}
	if spill <= regOnly {
		return "the >3-arg (spill) __shimP must be longer than the register-only one"
	}
	return ""
}
