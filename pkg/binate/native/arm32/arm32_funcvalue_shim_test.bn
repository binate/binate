package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the func-value shim BODIES in arm32_funcvalue_shim.bn:
// emitFuncValueShimBody return-shape classification and the scalar/void,
// R0-sret, and small-aggregate pack shim shapes it dispatches to.  The general
// ILP32 target setter (setArm32Target) lives in the sibling arm32_funcvalue_test.bn
// (same package), shared with the non-shim func-value tests.

// A no-arg scalar/void shim is a single tail-branch (`B <fn>`, 4 bytes): there
// are no user args to shift down past the dropped data word.  This is exactly
// the __Package accessor's shim shape.
func TestScalarVoidShimNoArgIsTailBranch() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var noParams2 @[]@types.Param
	var noResults2 @[]@types.Type
	var fv @types.Type = types.MakeFuncValueType(noParams2, noResults2)
	emitScalarVoidShim(a, "bn_F1_4_main1_4_main", fv)
	if a.Sections[0].Len != 4 {
		return fail("no-arg scalar/void shim should be a single tail-branch (4 bytes)")
	}
	return ""
}

// A shim with one scalar arg shifts R1 -> R0 (one MOV) then tail-branches
// (2 instructions, 8 bytes).  Pins the ILP32 target so `int` is a single GP
// word (as on the real arm32 target), not the LP64 host default's 2 words.
func TestScalarVoidShimOneArgShifts() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Name = "x"
	p.Type = types.TypInt()
	params[0] = p
	var noResults2 @[]@types.Type
	var fv @types.Type = types.MakeFuncValueType(params, noResults2)
	emitScalarVoidShim(a, "bn_F1_4_main1_4_main", fv)
	if a.Sections[0].Len != 8 {
		return fail("one-arg shim should be MOV + tail-branch (8 bytes)")
	}
	return ""
}

// aggPairType is an 8-byte (ILP32) struct — > InternalSretBytes (4), so a func
// value returning it takes the big-aggregate R0-sret shim shape.  Shared by the
// call-indirect tests too.
func aggPairType() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Name = "a"
	fields[0].Type = types.TypInt()
	fields[1] = make(types.Field)
	fields[1].Name = "b"
	fields[1].Type = types.TypInt()
	return types.MakeStructType("Pair", fields)
}

// aggSmallType is a 4-byte (ILP32) struct — <= InternalSretBytes (4), the small
// in-register aggregate return shape deferred to P4-b.
func aggSmallType() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	fields[0] = make(types.Field)
	fields[0].Name = "a"
	fields[0].Type = types.TypInt()
	return types.MakeStructType("One", fields)
}

// A func value returning a big (>4-byte) aggregate takes the AAPCS32 R0-sret shim
// shape: the retbuf stays in R0 (unlike AAPCS64's X8), the data word (R1) is
// dropped, user args shift down, and the shim tail-branches.  A no-arg
// big-aggregate shim is thus a single tail-branch (4 bytes) — no args to shift.
// Pins the ILP32 target so a 2-int struct is 8 bytes (> 4) → sret.
func TestFuncValueShimBigAggregateReturnIsSret() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var noParams @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = aggPairType()
	var fv @types.Type = types.MakeFuncValueType(noParams, results)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main", fv)
	if a.HasError {
		return fail("a big-aggregate return should use the sret shim, not fail")
	}
	if a.Sections[0].Len != 4 {
		return fail("a no-arg sret shim should be a single tail-branch (4 bytes)")
	}
	return ""
}

// The sret shim keeps R0 (retbuf) and shifts user args down from R2.. to R1..:
// one user arg is one MOV (R1 <- R2) then the tail-branch (8 bytes).  Contrast
// the scalar shim, whose one-arg form shifts R1 -> R0.
func TestFuncValueShimSretOneArgShiftsFromR2() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Name = "x"
	p.Type = types.TypInt()
	params[0] = p
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = aggPairType()
	var fv @types.Type = types.MakeFuncValueType(params, results)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main", fv)
	if a.HasError {
		return fail("a one-arg big-aggregate sret shim should not fail")
	}
	if a.Sections[0].Len != 8 {
		return fail("a one-arg sret shim should be MOV + tail-branch (8 bytes)")
	}
	return ""
}

// A func value returning a SMALL (<=4-byte) aggregate comes back BY VALUE in R0,
// so its shim is the PACK shim: unlike the tail-branch scalar/sret shims, it
// builds a frame, saves the retbuf, BLs the underlying, stores the returned R0
// word through the retbuf, and returns.  A no-arg pack shim is exactly 5
// instructions (push {r4,lr}; mov r4,r0; bl; str r0,[r4]; pop {r4,pc}) = 20
// bytes.  A single-int struct is 4 bytes on ILP32.
func TestFuncValueShimSmallAggregateReturnIsPack() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var noParams @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = aggSmallType()
	var fv @types.Type = types.MakeFuncValueType(noParams, results)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main", fv)
	if a.HasError {
		return fail("a small (<=4-byte) aggregate return should use the pack shim")
	}
	if a.Sections[0].Len != 20 {
		return fail(
				"a no-arg pack shim should be 5 instructions (20 bytes): "
						"push, mov, bl, str, pop")
	}
	return ""
}

// emptyStructType is a 0-byte struct (`struct{}` / a named empty struct) — SizeOf 0.
// A func value returning it is VOID-LIKE (types.IsAggregateReturnTyp false), so its
// shim must be the scalar/void tail-branch, NOT the pack shim.
func emptyStructType() @types.Type {
	var noFields @[]@types.Field
	return types.MakeStructType("Empty", noFields)
}

// A func value returning a 0-byte aggregate (`struct{}`) is void-like: the caller
// passes NO retbuf (types.IsAggregateReturnTyp is false), and the LLVM shim routes
// it to the void tail-branch (codegen isAggregateReturn false).  So the native shim
// must be the SCALAR/VOID tail-branch — a single `B <fn>` (4 bytes) for a no-arg
// func value — NOT the 20-byte pack shim (which would STR a garbage word through a
// 0-byte retbuf the caller never allocated).  This is the shim-side of the fix that
// realigns the native RESULT classification with types.IsAggregateReturnTyp.
func TestFuncValueShimEmptyStructReturnIsVoidTailBranch() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var noParams @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = emptyStructType()
	var fv @types.Type = types.MakeFuncValueType(noParams, results)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main", fv)
	if a.HasError {
		return fail("a 0-byte aggregate return should use the void tail-branch shim")
	}
	if a.Sections[0].Len != 4 {
		return fail(
				"a no-arg struct{}-return shim must be a single tail-branch (4 bytes) — "
						"the void shim, NOT the 20-byte pack shim")
	}
	return ""
}

// A `func(x int) struct{}` func value: the 0-byte result routes to the void shim,
// so the shim is the scalar/void arg-shift — the data word (R0) is dropped and the
// one user arg shifts R1 -> R0 (one MOV), then tail-branch = 2 instructions (8
// bytes).  Same shape as the int-returning TestScalarVoidShimOneArgShifts — proving
// the 0-byte result does not perturb the arg marshal (no retbuf prefix).
func TestFuncValueShimEmptyStructReturnOneArgShifts() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Name = "x"
	p.Type = types.TypInt()
	params[0] = p
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = emptyStructType()
	var fv @types.Type = types.MakeFuncValueType(params, results)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main", fv)
	if a.HasError {
		return fail("a struct{}-return func value with one arg should use the void shim")
	}
	if a.Sections[0].Len != 8 {
		return fail(
				"a one-arg struct{}-return shim must be MOV + tail-branch (8 bytes): the "
						"void shim shifts R1 -> R0 with no retbuf prefix")
	}
	return ""
}

// mkMultiReturnFv_arm32test builds a func-value type with n int32 results and no
// params, i.e. a multi-return func value whose tuple is n GP words.
func mkMultiReturnFv_arm32test(n int) @types.Type {
	var noParams @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, n)
	for i := 0; i < n; i++ { results[i] = types.TypInt32() }
	return types.MakeFuncValueType(noParams, results)
}

// Under retbuf-for-any-multi-return the caller passes a retbuf in R0 for a SMALL
// multi-return func value too (gpWords <= 4), so its shim is a FRAMED CALL shim:
// it saves the retbuf, BLs the underlying (which returns the tuple field-per-
// register in r0..r3), then stores each field THROUGH the retbuf.  A no-arg
// (int32, int32) shim is: push {r4,lr}, mov r4,r0, bl, str (field 0), str
// (field 1), pop {r4,pc} = 6 instructions (24 bytes) — NOT a bare tail-branch
// (4 bytes), which would leave the caller's retbuf unwritten.
func TestFuncValueShimSmallMultiReturnIsFramedRetbufShim() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main", mkMultiReturnFv_arm32test(2))
	if a.HasError {
		return fail("a small multi-return shim should emit a framed retbuf shim, "
				"not fail")
	}
	if a.Sections[0].Len != 24 {
		return fail(
				"a no-arg (int32,int32) small multi-return shim should be a "
						"framed retbuf shim: push, mov, bl, str, str, pop (24 bytes)")
	}
	return ""
}

// A BIG multi-return func value (gpWords > 4) srets through R0, so its shim takes
// the AAPCS32 sret shape (retbuf stays in R0, data R1 dropped, tail-branch) —
// identical to the single big-aggregate sret shim.  A no-arg such shim is a
// single tail-branch (4 bytes).
func TestFuncValueShimBigMultiReturnIsSret() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main", mkMultiReturnFv_arm32test(5))
	if a.HasError {
		return fail("a big multi-return shim should use the sret shim, not fail")
	}
	if a.Sections[0].Len != 4 {
		return fail("a no-arg big multi-return sret shim should be a single "
				"tail-branch (4 bytes)")
	}
	return ""
}

// Under HARD-float a non-closure func-value shim with a SCALAR float RETURN lowers
// CLEANLY (inc 3f(b1)): the underlying returns the float in the VFP return register
// (S0 / D0) and the scalar/void tail-branch shim forwards it untouched — the GP
// marshal never reads or writes the VFP file — so a no-arg float-return shim is a
// single `B <fn>` (4 bytes), byte-identical to the soft twin.  The target is stamped
// hard-float and RESTORED before the assertion so the stamp does not leak.
func TestFuncValueShimFloatReturnHardLowers() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var noParams @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypFloat32()
	var fv @types.Type = types.MakeFuncValueType(noParams, results)
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main", fv)
	var hadErr bool = a.HasError
	var n int = a.Sections[0].Len
	restoreTarget(oldArch, oldAbi)
	if hadErr {
		return fail("a hard-float func-value shim with a scalar float return must lower cleanly")
	}
	if n != 4 {
		return fail("a no-arg float-return shim should be a single tail-branch (4 bytes)")
	}
	return ""
}

// The soft-float twin: under a SOFT target Arm32HardFloat() is false, so the P6
// guard is inert and a float32 scalar return rides the scalar/void tail-branch
// shim untouched (float in R0, soft-float — P5.3) — a no-arg shim is a single
// `B <fn>` (4 bytes).  Pins that the P6 guard did not regress the soft
// float-return path.
func TestFuncValueShimFloatReturnSoftLowers() testing.TestResult {
	setArm32Target()
	var noParams @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypFloat32()
	var fv @types.Type = types.MakeFuncValueType(noParams, results)
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main", fv)
	if a.HasError {
		return fail("a soft-float func-value shim with a float return must lower cleanly")
	}
	if a.Sections[0].Len != 4 {
		return fail("a no-arg float-return shim should be a single tail-branch (4 bytes)")
	}
	return ""
}

// floatPairStructType is an 8-byte (ILP32) struct {float32, float32} — an HFA
// candidate.  Under hard-float with HfaAggregates false it rides the GP-coerce /
// sret path (not VFP); inc 3f(b1) has NOT un-guarded a float-in-aggregate return, so
// a shim returning it stays fail-loud until inc 3f(b2).
func floatPairStructType() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Name = "a"
	fields[0].Type = types.TypFloat32()
	fields[1] = make(types.Field)
	fields[1].Name = "b"
	fields[1].Type = types.TypFloat32()
	return types.MakeStructType("FloatPair", fields)
}

// Under HARD-float a func-value shim with a SCALAR float PARAM and no other arg
// lowers to a single tail-branch (4 bytes): the float rides VFP on both the shim's
// incoming ABI and the underlying's, so hardFloatShimSkipArm32 drops it from the GP
// marshal — it is neither shifted to a GP register (which would add a MOV, 8 bytes)
// nor mishandled.  The 4-vs-8-byte delta against the soft twin below is the proof the
// float param passes through VFP untouched.
func TestFuncValueShimFloatParamHardSkipsToVfp() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Name = "x"
	p.Type = types.TypFloat32()
	params[0] = p
	var noResults @[]@types.Type
	var fv @types.Type = types.MakeFuncValueType(params, noResults)
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main", fv)
	var hadErr bool = a.HasError
	var n int = a.Sections[0].Len
	restoreTarget(oldArch, oldAbi)
	if hadErr {
		return fail("a hard-float func-value shim with a scalar float param must lower cleanly")
	}
	if n != 4 {
		return fail(
				"a hard-float float-param shim must skip the VFP arg (single "
						"tail-branch, 4 bytes), not shift it to a GP register")
	}
	return ""
}

// The soft twin: under a SOFT target the float32 param is a GP word, so the scalar/
// void shim shifts R1 -> R0 (a MOV) then tail-branches — 8 bytes.  Pins that the
// hard-float skip did not regress the soft float-param path, and documents the
// 4-vs-8-byte delta the hard test relies on.
func TestFuncValueShimFloatParamSoftShifts() testing.TestResult {
	setArm32Target()
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Name = "x"
	p.Type = types.TypFloat32()
	params[0] = p
	var noResults @[]@types.Type
	var fv @types.Type = types.MakeFuncValueType(params, noResults)
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main", fv)
	if a.HasError {
		return fail("a soft-float func-value shim with a float param must lower cleanly")
	}
	if a.Sections[0].Len != 8 {
		return fail("a soft-float float-param shim shifts the GP word (MOV + branch, 8 bytes)")
	}
	return ""
}

// Under HARD-float a func-value shim returning a float-bearing SINGLE AGGREGATE
// (struct {float32, float32}) still fails LOUD (inc 3f(b2), not yet implemented): the
// aggregate rides the GP-coerce / sret path, which inc 3f(b1) has not un-guarded.
// funcValueShimUnhandledFloatB1Arm32 routes it to the fail-loud guard.
func TestFuncValueShimFloatInAggReturnHardLowers() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var noParams @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = floatPairStructType()
	var fv @types.Type = types.MakeFuncValueType(noParams, results)
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main", fv)
	var hadErr bool = a.HasError
	var n int = a.Sections[0].Len
	restoreTarget(oldArch, oldAbi)
	// struct{float32,float32} is 8 bytes (> InternalSretBytes 4) -> the big-aggregate
	// R0-sret shim, which is float-AGNOSTIC (the retbuf pointer stays in R0 and the
	// underlying writes the bytes) — inc 3f(b2) un-guards it.  A no-arg sret shim is a
	// single tail-branch (4 bytes), byte-identical to the int-aggregate sret shim.
	if hadErr {
		return fail("a hard-float shim returning a float-in-aggregate must lower (inc 3f b2)")
	}
	if n != 4 {
		return fail("a no-arg float-in-agg sret shim should be a single tail-branch (4 bytes)")
	}
	return ""
}

// Under HARD-float a func-value shim returning a MULTI-RETURN tuple with a float leaf
// still fails LOUD (inc 3f(b3), not yet implemented): a register-returned tuple places
// its float field in a VFP return register (d0..d3) via emitMultiReturnPackHard, but
// the shim's GP-only field store (storeMultiReturnTupleFieldsArm32) would read it from
// a GP register — un-guarding it would silently miscompile, so it must stay fail-loud
// until the FP-aware multiret collect lands.
func TestFuncValueShimMultiRetFloatHardSetsError() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var noParams @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 2)
	results[0] = types.TypFloat32()
	results[1] = types.TypInt()
	var fv @types.Type = types.MakeFuncValueType(noParams, results)
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main", fv)
	var hadErr bool = a.HasError
	restoreTarget(oldArch, oldAbi)
	if !hadErr {
		return fail("a hard-float shim with a float multi-return must fail loud (inc 3f b3)")
	}
	return ""
}
