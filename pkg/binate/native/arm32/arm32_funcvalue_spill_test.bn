package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for arm32_funcvalue_spill.bn: a func value whose EFFECTIVE user-arg words
// exceed the register-only budget (R0..R3 incoming, R0..R3 outgoing under AAPCS32)
// must route to the framed-BL stack-spill shim and emit WITHOUT recording an
// assembler error.  Before PIECE 1 the arm32 over-budget shapes fail-loud'd via
// shimArgsFitRegisters; the regression these pin is that emission now succeeds.  A
// byte-level reference test pins the exact scalar-spill instruction stream (frame
// SUB via push, marshal MOV/LDR, BL, teardown, RET); the wide-shape "NoError" tests
// mirror the aarch64 / x64 twins at the ILP32 budgets, and end-to-end correctness is
// covered by conformance 994.

// The scalar/void spill for a 4-int func value (incoming budget 3 = R1..R3, so the
// 4th arg overflows to the dispatch caller's stack; outgoing 4 words = R0..R3).
// Byte-compared against the hand-built framed-BL reference: push {r4,lr}, shift
// R1/R2/R3 -> R0/R1/R2, load the spilled 4th word from [SP,#frameDelta], BL, pop.
func TestFuncvalSpillScalarByteRefArm32() testing.TestResult {
	setArm32Target()
	var noResults @[]@types.Type
	var params @[]@types.Param = make_slice(@types.Param, 4)
	for i := 0; i < 4; i++ {
		params[i] = make(types.Param)
		params[i].Type = types.TypInt()
	}
	var fv @types.Type = types.MakeFuncValueType(params, noResults)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitScalarVoidShim(got, "bn_ref", fv)
	if got.HasError { return fail("4-int scalar spill shim must not error") }

	// Reference: no coerced agg (no staging), no outgoing stack args (all 4 fit
	// R0..R3), so innerBytes = 0 and frameDelta = 8 (the {r4,lr} save).  The 4th
	// incoming word (g=4) is at [SP + 8 + (4-4)*4] = [SP,#8].
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Push(ref, arm32.COND_AL, packShimPushMask())
	arm32.Mov(ref, arm32.COND_AL, false, arm32.R0, arm32.Reg(arm32.R1)) // arg0: R1 -> R0
	arm32.Mov(ref, arm32.COND_AL, false, arm32.R1, arm32.Reg(arm32.R2)) // arg1: R2 -> R1
	arm32.Mov(ref, arm32.COND_AL, false, arm32.R2, arm32.Reg(arm32.R3)) // arg2: R3 -> R2
	arm32.Ldr(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.SP, 8)) // arg3: [SP,#8] -> R3
	ref.SetGlobal("bn_ref")
	arm32.Bl(ref, arm32.COND_AL, "bn_ref")
	arm32.Pop(ref, arm32.COND_AL, packShimPopMask())

	if !asmTextEqSpill(got, ref) {
		return fail(
				"4-int scalar spill shim bytes must match the framed-BL reference "
						"(push, shift R1/R2/R3->R0/R1/R2, ldr r3,[sp,#8], bl, pop)")
	}
	return ""
}

// Scalar return, 4 int user words > the arm32 scalar budget (3): spills.
func TestFuncvalSpillWideScalarNoErrorArm32() testing.TestResult {
	return wideShimEmitsArm32(4, scalarResult_spilltest_arm32())
}

// Sret return (8-byte struct > 4) with 4 int user words > the arm32 sret budget
// (2 = R2..R3, since R0 = retbuf, R1 = data): spills, retbuf stays in R0.
func TestFuncvalSpillWideSretNoErrorArm32() testing.TestResult {
	return wideShimEmitsArm32(4, structResult_spilltest_arm32(2))
}

// Pack return (4-byte struct) with 4 int user words > the arm32 pack budget (2):
// spills, packed return copied through the stashed retbuf.
func TestFuncvalSpillWidePackNoErrorArm32() testing.TestResult {
	return wideShimEmitsArm32(4, smallStructResult_spilltest_arm32())
}

// Small multi-return (two int32 = 2 GP words, field-per-register) with 4 int user
// words > the pack budget (2): spills, tuple stored field-per-register through the
// stashed retbuf.
func TestFuncvalSpillWideMultiRetPackNoErrorArm32() testing.TestResult {
	var r @[]@types.Type = make_slice(@types.Type, 2)
	r[0] = types.TypInt32()
	r[1] = types.TypInt32()
	return wideShimEmitsArm32(4, r)
}

// A by-address aggregate arg makes the spill STAGE the incoming GP regs (the
// needStage path); an all-scalar list does not (the marshal reads live regs).
// shimHasByAddrAggArm32 is the gate emitFuncvalSpillShimArm32 keys that decision on.
func TestSpillNeedStagePredicateArm32() testing.TestResult {
	setArm32Target()
	var cc common.CallConv = common.AAPCS32()
	var allInt @[]@types.Type = make_slice(@types.Type, 3)
	allInt[0] = types.TypInt()
	allInt[1] = types.TypInt()
	allInt[2] = types.TypInt()
	if shimHasByAddrAggArm32(cc, allInt) {
		return fail("all-int arg list must not need staging")
	}
	var withAgg @[]@types.Type = make_slice(@types.Type, 2)
	withAgg[0] = types.TypInt()
	withAgg[1] = coercedStruct2_spilltest_arm32()
	if !shimHasByAddrAggArm32(cc, withAgg) {
		return fail("coerced-struct arg list must need staging")
	}
	// A non-coerced small aggregate (raw slice, 2 words) is ALSO by-address under
	// option B, so it must need staging too — proving the predicate widened past the
	// coerced case.
	var withSlice @[]@types.Type = make_slice(@types.Type, 2)
	withSlice[0] = types.TypInt()
	withSlice[1] = types.MakeSliceType(types.TypInt())
	if !shimHasByAddrAggArm32(cc, withSlice) {
		return fail("a non-coerced slice arg list must need staging (option B by-address)")
	}
	return ""
}

// Five 16-byte {int64,int64} coerced-agg args (the 992 / 994 shape): 5 incoming
// by-address words > 3, and each struct expands to 4 outgoing words + even-pair
// pads — far past R0..R3.  Pre-PIECE-1 this fail-loud'd; the staged spill now emits
// a valid shim.  Emit must succeed without error; end-to-end correctness is covered
// by conformance 994 (and the iface path by 992).
func TestFuncvalSpillCoercedAggStagesNoErrorArm32() testing.TestResult {
	setArm32Target()
	var mod @ir.Module = ir.NewModule("\"main\"")
	var params @[]@ir.Param
	for i := 0; i < 5; i++ {
		var p @ir.Param = make(ir.Param)
		p.Name = "s"
		p.Typ = coercedStruct2x64_spilltest_arm32()
		params = appendIrParam_spilltest_arm32(params, p)
	}
	var f @ir.Func = ir.NewFunc("", "wideAgg", params, scalarResult_spilltest_arm32())
	f.IsLinkOnce = true
	mod.AddFunc(f)
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitFuncValueShims(a, "main", mod)
	if a.HasError {
		return fail("coerced-agg over-budget func value must not SetError (staged spill)")
	}
	if a.Sections[0].Len == 0 {
		return fail("coerced-agg over-budget func value must emit a shim")
	}
	return ""
}

// The SRET-return even-pair spill reproducer: a func value returning a BIG
// aggregate via sret (retbuf in R0) and taking (int, {int64,int64}).  The sret
// shape's outgoing classification must run over the SAME prefixed sret-pointer +
// full-cc type list the callee uses — [*uint8, int, {int64,int64}] — so the
// classifier's running NGRN reaches the {int64,int64} at ABSOLUTE index 2 (even),
// splitting it across R2:R3 + two outgoing-args stack words, EXACTLY as the callee
// (emitSpillParam) reads it.  This test byte-compares against that CORRECT absolute
// placement; the pre-fix reduce-NumGpArgRegs model reached the aggregate at a
// RELATIVE index that dropped the even-pair parity and misplaced the value words
// (word 0 to R3, remainder over three stack words) — a SILENT MISCOMPILE the byte
// reference below pins against.  The aggregate is coerced-in-register, so the shim
// stages the incoming GP regs first (needStage); the int arg (arg0) rides R1, the
// aggregate pointer arrives by-address as one dispatch word.
//
// Frame: outBytes = CallStackBytes([*uint8,int,{int64,int64}]) = 8 (the two SPLIT
// tail words, StackAlign-8 rounded); no retbuf save (sret); needStage → stageOff =
// outBytes = 8, innerBytes = 8 + NumGpArgRegs*4 = 24 (8-rounded), frameDelta = 32.
// Incoming dispatch: R0 = retbuf, R1 = data, R2 = int arg0, R3 = &{int64,int64}.
func TestFuncvalSpillSretEvenPairByteRefArm32() testing.TestResult {
	setArm32Target()
	var params @[]@types.Param = make_slice(@types.Param, 2)
	params[0] = make(types.Param)
	params[0].Type = types.TypInt()
	params[1] = make(types.Param)
	params[1].Type = coercedStruct2x64_spilltest_arm32() // {int64,int64}, NeedsEvenReg
	// A 12-byte {int,int,int} result (> InternalSretBytes 4) forces the sret shape.
	var results @[]@types.Type = structResult_spilltest_arm32(3)
	var fv @types.Type = types.MakeFuncValueType(params, results)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitSretShim(got, "bn_ref", fv)
	if got.HasError { return fail("sret + {int64,int64} spill shim must not error") }

	// Reference: the CORRECT absolute placement mirroring the callee.
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Push(ref, arm32.COND_AL, packShimPushMask()) // push {r4, lr}
	arm32.Sub(ref, arm32.COND_AL, false, arm32.SP, arm32.SP, arm32.Imm(24)) // sub sp, sp, #24
	// Stage the incoming GP dispatch regs (needStage): r0..r3 -> [sp,#8..#20].
	arm32.Str(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.SP, 8))
	arm32.Str(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.SP, 12))
	arm32.Str(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.SP, 16))
	arm32.Str(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.SP, 20))
	// arg0 int: staged dispatch word g=2 ([sp,#16]) -> R1 (its ABSOLUTE reg).
	arm32.Ldr(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.SP, 16))
	// arg1 {int64,int64}: pointer is staged dispatch word g=3 ([sp,#20]) -> IP.
	arm32.Ldr(ref, arm32.COND_AL, arm32.IP, arm32.MemImm(arm32.SP, 20))
	// Value words 0,1 -> R2,R3 (even-pair aligned ABSOLUTE start, NOT R3+stack).
	arm32.Ldr(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.IP, 0))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.IP, 4))
	// SPLIT tail: value words 2,3 -> outgoing-args stack [sp,#0], [sp,#4], via R4.
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.IP, 8))
	arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 0))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.IP, 12))
	arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 4))
	ref.SetGlobal("bn_ref")
	arm32.Bl(ref, arm32.COND_AL, "bn_ref")
	arm32.Add(ref, arm32.COND_AL, false, arm32.SP, arm32.SP, arm32.Imm(24)) // add sp, sp, #24
	arm32.Pop(ref, arm32.COND_AL, packShimPopMask()) // pop {r4, pc}

	if !asmTextEqSpill(got, ref) {
		return fail(
				"sret + {int64,int64} spill shim bytes must match the callee's ABSOLUTE "
						"placement (retbuf R0, int R1, {int64,int64} at R2:R3 + [sp,#0]/[sp,#4]; "
						"R1 an even-pair-padded start, NOT R3 + three stack words)")
	}
	return ""
}

// A func value returning a BIG aggregate via sret AND taking an 8-aligned coerced
// aggregate ({int64,int64}) positioned so it spills: emits a valid shim without
// error (the simpler !HasError companion to the byte-level reproducer above).
func TestFuncvalSpillSretCoercedAggNoErrorArm32() testing.TestResult {
	setArm32Target()
	var mod @ir.Module = ir.NewModule("\"main\"")
	var params @[]@ir.Param
	var p0 @ir.Param = make(ir.Param)
	p0.Name = "a"
	p0.Typ = types.TypInt()
	params = appendIrParam_spilltest_arm32(params, p0)
	var p1 @ir.Param = make(ir.Param)
	p1.Name = "s"
	p1.Typ = coercedStruct2x64_spilltest_arm32()
	params = appendIrParam_spilltest_arm32(params, p1)
	// A 12-byte {int,int,int} result forces the sret shape.
	var f @ir.Func = ir.NewFunc("", "sretAgg", params, structResult_spilltest_arm32(3))
	f.IsLinkOnce = true
	mod.AddFunc(f)
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitFuncValueShims(a, "main", mod)
	if a.HasError {
		return fail("sret + coerced-agg over-budget func value must not SetError (staged spill)")
	}
	if a.Sections[0].Len == 0 {
		return fail("sret + coerced-agg over-budget func value must emit a shim")
	}
	return ""
}

// PIECE 2 (option B): a NON-coerced managed-slice (4-word) arg positioned so its
// SPLIT tail straddles the last GP reg(s) and the outgoing-args stack, pinning the
// R4 memory→memory shuttle and the by-address expansion in the SPILL path.  In the
// sret shape (retbuf R0, data R1) a sole managed-slice classifies over
// [*uint8, @[]int] at ABSOLUTE index 1: it starts at R1 and, being 4 words with only
// R1..R3 (3) left, SPLITs to R1:R2:R3 + ONE outgoing-args stack word (AAPCS §6.5).
// The managed-slice arrives BY-ADDRESS as ONE dispatch word (g=2, srcPrefix 2), so
// the spill stages the incoming GP regs (needStage) and re-expands from the pointer.
//
// Frame: outBytes = CallStackBytes([*uint8, @[]int]) = 8 (the ONE SPLIT-tail word,
// StackAlign-8 rounded); no retbuf save (sret); needStage -> stageOff = outBytes = 8,
// innerBytes = 8 + NumGpArgRegs*4 = 24 (8-rounded), frameDelta = 32.  Incoming
// dispatch: R0 = retbuf, R1 = data, R2 = &managed-slice.
func TestFuncvalSpillSretManagedSliceStraddleByteRefArm32() testing.TestResult {
	setArm32Target()
	var params @[]@types.Param = make_slice(@types.Param, 1)
	params[0] = make(types.Param)
	params[0].Type = types.MakeManagedSliceType(types.TypInt()) // @[]int, 4 ArgWords, align 4
	// A 12-byte {int,int,int} result (> InternalSretBytes 4) forces the sret shape.
	var results @[]@types.Type = structResult_spilltest_arm32(3)
	var fv @types.Type = types.MakeFuncValueType(params, results)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitSretShim(got, "bn_ref", fv)
	if got.HasError { return fail("sret + managed-slice spill shim must not error") }

	// Reference: the CORRECT absolute placement mirroring the callee.
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Push(ref, arm32.COND_AL, packShimPushMask()) // push {r4, lr}
	arm32.Sub(ref, arm32.COND_AL, false, arm32.SP, arm32.SP, arm32.Imm(24)) // sub sp, sp, #24
	// Stage the incoming GP dispatch regs (needStage): r0..r3 -> [sp,#8..#20].
	arm32.Str(ref, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.SP, 8))
	arm32.Str(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.SP, 12))
	arm32.Str(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.SP, 16))
	arm32.Str(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.SP, 20))
	// arg0 @[]int: pointer is staged dispatch word g=2 ([sp,#16]) -> IP.
	arm32.Ldr(ref, arm32.COND_AL, arm32.IP, arm32.MemImm(arm32.SP, 16))
	// Value words 0,1,2 -> R1,R2,R3 (absolute reg start 1, no even-pair pad — align 4).
	arm32.Ldr(ref, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.IP, 0))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.IP, 4))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.IP, 8))
	// SPLIT tail: value word 3 -> outgoing-args stack [sp,#0], via R4.
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.IP, 12))
	arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 0))
	ref.SetGlobal("bn_ref")
	arm32.Bl(ref, arm32.COND_AL, "bn_ref")
	arm32.Add(ref, arm32.COND_AL, false, arm32.SP, arm32.SP, arm32.Imm(24)) // add sp, sp, #24
	arm32.Pop(ref, arm32.COND_AL, packShimPopMask()) // pop {r4, pc}

	if !asmTextEqSpill(got, ref) {
		return fail(
				"sret + managed-slice spill shim bytes must match the callee's ABSOLUTE "
						"placement (retbuf R0, @[]int at R1:R2:R3 + [sp,#0]; by-address expand "
						"from the staged pointer, SPLIT tail via R4)")
	}
	return ""
}

// A wide `(int, int, int, int64)` scalar/void func value spills: the three ints fill
// R0..R2 outgoing, and the int64 (8-aligned, NeedsEvenReg) even-rounds to R4 — past
// the register file — so it goes WHOLE to the 8-aligned outgoing-args stack (a scalar
// int64 never SPLITs).  This pins the int64 in the spill marshal on BOTH cursors: the
// INCOMING int64 is at ABSOLUTE dispatch position 4 (data R0, three ints R1..R3, then
// the cursor is at 4 — already even, no incoming pad), so both its incoming words are
// on the dispatch caller's overflow stack; each shuttles through R4 to the outgoing
// stack slot.  No by-address aggregate, so no staging (the ints down-shift live).
//
// Frame: outBytes = CallStackBytes([int,int,int,int64]) = 8 (the int64's two words,
// 8-aligned); no retbuf save, no stage; innerBytes = 8, frameDelta = savedBytes(8) +
// innerBytes(8) = 16.  Incoming overflow word g is at [SP + 16 + (g-4)*4].
func TestFuncvalSpillInt64ScalarByteRefArm32() testing.TestResult {
	setArm32Target()
	var noResults @[]@types.Type
	var params @[]@types.Param = make_slice(@types.Param, 4)
	params[0] = make(types.Param)
	params[0].Type = types.TypInt()
	params[1] = make(types.Param)
	params[1].Type = types.TypInt()
	params[2] = make(types.Param)
	params[2].Type = types.TypInt()
	params[3] = make(types.Param)
	params[3].Type = types.TypInt64()
	var fv @types.Type = types.MakeFuncValueType(params, noResults)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitScalarVoidShim(got, "bn_ref", fv)
	if got.HasError { return fail("(int,int,int,int64) spill shim must not error") }

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Push(ref, arm32.COND_AL, packShimPushMask()) // push {r4, lr}
	emitSpAdjust(ref, false, 8) // sub sp, sp, #8 (int64's 8 outgoing stack bytes)
	arm32.Mov(ref, arm32.COND_AL, false, arm32.R0, arm32.Reg(arm32.R1)) // int0: R1 -> R0
	arm32.Mov(ref, arm32.COND_AL, false, arm32.R1, arm32.Reg(arm32.R2)) // int1: R2 -> R1
	arm32.Mov(ref, arm32.COND_AL, false, arm32.R2, arm32.Reg(arm32.R3)) // int2: R3 -> R2
	// int64 whole-stack: lo from dispatch overflow g=4 ([SP,#16]) -> [SP,#0] via R4.
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 16))
	arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 0))
	// int64 hi from dispatch overflow g=5 ([SP,#20]) -> [SP,#4] via R4.
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 20))
	arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 4))
	ref.SetGlobal("bn_ref")
	arm32.Bl(ref, arm32.COND_AL, "bn_ref")
	emitSpAdjust(ref, true, 8) // add sp, sp, #8
	arm32.Pop(ref, arm32.COND_AL, packShimPopMask()) // pop {r4, pc}

	if !asmTextEqSpill(got, ref) {
		return fail(
				"(int,int,int,int64) spill shim must down-shift the 3 ints and place the "
						"int64 WHOLE on the 8-aligned outgoing stack ([sp,#0]/[sp,#4] from the "
						"dispatch overflow words [sp,#16]/[sp,#20] via R4)")
	}
	return ""
}

// The POSITIONAL incoming seam in the SPILL marshal (MUTATION-VERIFY): a func value
// returning a big aggregate via sret (retbuf R0) taking `(int, int64)`.  In the sret
// shape (srcPrefix 2 = retbuf + data, gpDestBase 1) the INCOMING dispatch is
// [retbuf R0, data R1, int R2, int64 ...]: the seam is flat all-integer (spec abi/03
// §3.3), so under soft-float the int64 rides the two CONSECUTIVE slots after the int
// — g=3 and g=4, NO even-pair pad.  g=3 is still a register (R3); g=4 overflows to the
// dispatch stack, so the incoming int64 STRADDLES R3 and the stack — a shape the
// positional seam allows but AAPCS32 never produced.  The OUTGOING classification over
// [*uint8, int, int64] places the int at R1 and the int64 (even-aligned) at R2:R3.
// So the shim moves the int R2 -> R1, the int64.lo R3 -> R2, and loads the int64.hi
// from the overflow stack -> R3.  A cursor that RE-INTRODUCED the even-pair pad would
// read g=4,5 (both stack), the pre-positional miscompile this byte reference pins.
//
// The int64 fits the OUTGOING registers (R2:R3), but the shape spills because the
// INCOMING budget overflows: nIn = int(1) + int64(2) = 3 > NumGpArgRegs - srcPrefix
// (2).  No by-address aggregate -> no staging.
//
// Frame: outBytes = CallStackBytes([*uint8, int, int64]) = 0 (int64 fits R2:R3, no
// outgoing stack); no retbuf save (sret), no stage; innerBytes = 0, frameDelta =
// savedBytes(8) + 0 = 8.  Incoming overflow word g is at [SP + 8 + (g-4)*4], so the
// int64.hi at g=4 is [SP,#8].
func TestFuncvalSpillSretInt64IncomingPadByteRefArm32() testing.TestResult {
	setArm32Target()
	var params @[]@types.Param = make_slice(@types.Param, 2)
	params[0] = make(types.Param)
	params[0].Type = types.TypInt()
	params[1] = make(types.Param)
	params[1].Type = types.TypInt64()
	// A 12-byte {int,int,int} result (> InternalSretBytes 4) forces the sret shape.
	var results @[]@types.Type = structResult_spilltest_arm32(3)
	var fv @types.Type = types.MakeFuncValueType(params, results)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	emitSretShim(got, "bn_ref", fv)
	if got.HasError { return fail("sret + (int, int64) spill shim must not error") }

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	arm32.Push(ref, arm32.COND_AL, packShimPushMask()) // push {r4, lr} (frameDelta 8)
	// arg0 int: incoming dispatch word g=2 (R2, live, un-staged) -> outgoing R1.
	arm32.Mov(ref, arm32.COND_AL, false, arm32.R1, arm32.Reg(arm32.R2))
	// arg1 int64: flat, no incoming pad, so it straddles — int64.lo at g=3 (R3, a
	// live register) -> outgoing R2, int64.hi at g=4 (dispatch overflow [SP,#8]) ->
	// outgoing R3.  MOV R2,R3 reads R3 before the LDR overwrites it (lo before hi).
	arm32.Mov(ref, arm32.COND_AL, false, arm32.R2, arm32.Reg(arm32.R3)) // int64.lo -> R2
	arm32.Ldr(ref, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.SP, 8)) // int64.hi -> R3
	ref.SetGlobal("bn_ref")
	arm32.Bl(ref, arm32.COND_AL, "bn_ref")
	arm32.Pop(ref, arm32.COND_AL, packShimPopMask()) // pop {r4, pc}

	if !asmTextEqSpill(got, ref) {
		return fail(
				"sret + (int, int64) spill shim must read the int64 flat (straddling): lo "
						"from g=3 (R3) and hi from g=4 ([sp,#8]) into R2:R3 — reading g=4,5 "
						"(both stack) is the pre-positional even-pair miscompile this pins")
	}
	return ""
}

// coercedStruct2_spilltest_arm32 builds an 8-byte (ILP32) named 2-int struct — a
// coerced-in-register aggregate (AggCoercedInReg true), 2 ArgWords.
func coercedStruct2_spilltest_arm32() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt()
	return types.MakeStructType("S8_spilltest_arm32", fields)
}

// coercedStruct2x64_spilltest_arm32 builds a 16-byte {int64,int64} named struct —
// an 8-byte-aligned coerced-in-register aggregate (AggCoercedInReg true,
// NeedsEvenReg true), 4 ArgWords.  The 992 / 994 shape.
func coercedStruct2x64_spilltest_arm32() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt64()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt64()
	return types.MakeStructType("S16_spilltest_arm32", fields)
}

// wideShimEmitsArm32 builds a single IsLinkOnce func with nParams int params and the
// given result, runs the shim emitter, and asserts the over-budget func value
// emitted a non-empty shim without error.
func wideShimEmitsArm32(nParams int, result @[]@types.Type) testing.TestResult {
	setArm32Target()
	var mod @ir.Module = ir.NewModule("\"main\"")
	var params @[]@ir.Param
	for i := 0; i < nParams; i++ {
		var p @ir.Param = make(ir.Param)
		p.Name = "x"
		p.Typ = types.TypInt()
		params = appendIrParam_spilltest_arm32(params, p)
	}
	var f @ir.Func = ir.NewFunc("", "wide", params, result)
	f.IsLinkOnce = true
	mod.AddFunc(f)
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitFuncValueShims(a, "main", mod)
	if a.HasError {
		return fail("over-budget func value must not SetError (spill path)")
	}
	if a.Sections[0].Len == 0 {
		return fail("over-budget func value must emit a shim")
	}
	return ""
}

// scalarResult_spilltest_arm32 builds the result list for an int-returning func
// value (a single scalar result).
func scalarResult_spilltest_arm32() @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, 1)
	r[0] = types.TypInt()
	return r
}

// structResult_spilltest_arm32 builds the result list for a func value returning an
// n-int struct (4*n bytes: n=2 -> 8 B, > InternalSretBytes 4 -> sret shape).
func structResult_spilltest_arm32(n int) @[]@types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		var fld @types.Field = make(types.Field)
		fld.Type = types.TypInt()
		fields[i] = fld
	}
	var r @[]@types.Type = make_slice(@types.Type, 1)
	r[0] = types.MakeStructType("", fields)
	return r
}

// smallStructResult_spilltest_arm32 builds the result list for a func value
// returning a 4-byte (single-int) struct — <= InternalSretBytes (4) -> pack shape.
func smallStructResult_spilltest_arm32() @[]@types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	var r @[]@types.Type = make_slice(@types.Type, 1)
	r[0] = types.MakeStructType("", fields)
	return r
}

// appendIrParam_spilltest_arm32 appends a @ir.Param to a @[]@ir.Param.
func appendIrParam_spilltest_arm32(dst @[]@ir.Param, v @ir.Param) @[]@ir.Param {
	var n int = len(dst)
	var ns @[]@ir.Param = make_slice(@ir.Param, n + 1)
	for i := 0; i < n; i++ { ns[i] = dst[i] }
	ns[n] = v
	return ns
}

// asmTextEqSpill reports whether two assemblers emitted byte-identical text
// sections (length + bytes).  Proves the spill shim matches a hand-built reference
// instruction-for-instruction.
func asmTextEqSpill(a0 @asm.Assembler, a1 @asm.Assembler) bool {
	if a0.Sections[0].Len != a1.Sections[0].Len { return false }
	// bnlint:allow managed-to-raw-assign - live @Assembler fields; outlive the read
	var d0 *[]uint8 = a0.Sections[0].Data
	// bnlint:allow managed-to-raw-assign - live @Assembler fields; outlive the read
	var d1 *[]uint8 = a1.Sections[0].Data
	for i := 0; i < a0.Sections[0].Len; i++ {
		if d0[i] != d1[i] { return false }
	}
	return true
}
