package "pkg/binate/native/arm32"

import "pkg/binate/native/common"
import "pkg/binate/types"

// Type-list helpers for the arm32 func-value spill shim: building the CallConv
// classifier's arg-type view (user params, with an optional leading *uint8 sret
// pointer) and the by-address-aggregate probe that decides whether the spill
// marshal must stage its incoming GP registers.  Split from arm32_funcvalue_spill.bn
// to keep each file under the hygiene length cap.

// shimUserTypesArm32 extracts the func-value's parameter types into a
// @[]@types.Type the CallConv classifier consumes.
func shimUserTypesArm32(fvTyp @types.Type) @[]@types.Type {
	var ts @[]@types.Type
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		ts = appendShimTypeArm32(ts, fvTyp.Params[pi].Type)
	}
	return ts
}

// appendShimTypeArm32 appends a @types.Type to a @[]@types.Type.
func appendShimTypeArm32(dst @[]@types.Type, v @types.Type) @[]@types.Type {
	var n int = len(dst)
	var ns @[]@types.Type = make_slice(@types.Type, n + 1)
	for i := 0; i < n; i++ { ns[i] = dst[i] }
	ns[n] = v
	return ns
}

// prependSretPtrArm32 builds the sret-shape CLASSIFY type list: a leading
// *uint8 sret-buffer-pointer slot followed by the user types.  It mirrors the
// callee's paramTypes construction (arm32_emit_func.bn emitFunc, sretShift arm:
// paramTypes[0] = types.MakePointerType(types.TypUint8())), so the shim's
// outgoing classification walks the SAME NGRN sequence the callee's incoming
// classification does — the leading pointer occupies R0 and forces the AAPCS
// §6.5 C.3 even-register-pair parity on the following args (a *uint8 is a
// 1-word, 4-aligned GP scalar: 1 GP reg, no even-pair pad of its own, matching
// the callee's leading slot).
func prependSretPtrArm32(userTypes @[]@types.Type) @[]@types.Type {
	var n int = len(userTypes)
	var ns @[]@types.Type = make_slice(@types.Type, n + 1)
	ns[0] = types.MakePointerType(types.TypUint8())
	for i := 0; i < n; i++ { ns[i + 1] = userTypes[i] }
	return ns
}

// shimHasByAddrAggArm32 reports whether any user param is a by-address in-register
// aggregate (a coerced array / named struct / source-level anon struct OR a
// non-coerced small slice / iface-value / managed-slice) — the only arg shape whose
// incoming (by-address, 1
// word) and outgoing (ArgWords value-words) cursors diverge, which is what forces
// the spill marshal to stage the incoming GP regs (see emitFuncvalSpillShimArm32).
func shimHasByAddrAggArm32(cc common.CallConv, userTypes @[]@types.Type) bool {
	for i := 0; i < len(userTypes); i++ {
		if isByAddressAggArm32(cc, userTypes[i]) { return true }
	}
	return false
}
