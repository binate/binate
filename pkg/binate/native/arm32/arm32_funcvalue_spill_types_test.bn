package "pkg/binate/native/arm32"

import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the spill-shim type-list helpers in arm32_funcvalue_spill_types.bn:
// shimUserTypesArm32 / appendShimTypeArm32 / prependSretPtrArm32 /
// shimHasByAddrAggArm32.

// shimUserTypesArm32 extracts a func value's parameter types in order.
func TestShimUserTypesArm32Extracts() testing.TestResult {
	setArm32Target()
	var params @[]@types.Param = make_slice(@types.Param, 2)
	params[0] = make(types.Param)
	params[0].Type = types.TypInt()
	params[1] = make(types.Param)
	params[1].Type = types.TypInt64()
	var noResults @[]@types.Type
	var fv @types.Type = types.MakeFuncValueType(params, noResults)

	var ts @[]@types.Type = shimUserTypesArm32(fv)
	if len(ts) != 2 {
		return fail("shimUserTypesArm32 must extract one entry per param")
	}
	if ts[0].Kind != types.TYP_INT || ts[0].Width != 32 {
		return fail("shimUserTypesArm32[0] must be the int param")
	}
	if ts[1].Kind != types.TYP_INT || ts[1].Width != 64 {
		return fail("shimUserTypesArm32[1] must be the int64 param")
	}
	return ""
}

// appendShimTypeArm32 grows the list by one, preserving order.
func TestAppendShimTypeArm32() testing.TestResult {
	setArm32Target()
	var ts @[]@types.Type
	ts = appendShimTypeArm32(ts, types.TypInt())
	ts = appendShimTypeArm32(ts, types.TypInt64())
	if len(ts) != 2 {
		return fail("appendShimTypeArm32 must append one entry per call")
	}
	if ts[0].Width != 32 || ts[1].Width != 64 {
		return fail("appendShimTypeArm32 must preserve append order")
	}
	return ""
}

// prependSretPtrArm32 inserts a leading *uint8 sret-pointer slot and shifts the
// user types up by one.
func TestPrependSretPtrArm32() testing.TestResult {
	setArm32Target()
	var user @[]@types.Type = make_slice(@types.Type, 1)
	user[0] = types.TypInt()
	var ts @[]@types.Type = prependSretPtrArm32(user)
	if len(ts) != 2 {
		return fail("prependSretPtrArm32 must add exactly one leading slot")
	}
	if ts[0].Kind != types.TYP_POINTER {
		return fail("prependSretPtrArm32[0] must be the *uint8 sret pointer")
	}
	if ts[1].Kind != types.TYP_INT {
		return fail("prependSretPtrArm32 must shift the user types after the sret slot")
	}
	return ""
}

// shimHasByAddrAggArm32 is true iff some user param rides the seam by-address (a
// slice here), false for an all-scalar list.
func TestShimHasByAddrAggArm32() testing.TestResult {
	setArm32Target()
	var cc common.CallConv = common.AAPCS32()

	var scalars @[]@types.Type = make_slice(@types.Type, 2)
	scalars[0] = types.TypInt()
	scalars[1] = types.TypInt64()
	if shimHasByAddrAggArm32(cc, scalars) {
		return fail("an all-scalar arg list must have no by-address aggregate")
	}

	var withSlice @[]@types.Type = make_slice(@types.Type, 2)
	withSlice[0] = types.TypInt()
	withSlice[1] = types.MakeSliceType(types.TypInt()) // raw slice: by-address on the seam
	if !shimHasByAddrAggArm32(cc, withSlice) {
		return fail("a raw-slice arg must be detected as a by-address aggregate")
	}
	return ""
}
