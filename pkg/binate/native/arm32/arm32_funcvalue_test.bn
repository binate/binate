package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// shimSymFor / vtableSymFor decorate the bare mangled function symbol with the
// canonical __shim / __vt suffixes the func-value triple uses.
func TestShimVtableSymNames() testing.TestResult {
	var shim @[]char = shimSymFor("main", "main.main")
	if !charEq(shim, "bn_F1_4_main1_4_main__shim") {
		return fail("expected bn_F1_4_main1_4_main__shim")
	}
	var vt @[]char = vtableSymFor("main", "main.main")
	if !charEq(vt, "bn_F1_4_main1_4_main__vt") {
		return fail("expected bn_F1_4_main1_4_main__vt")
	}
	return ""
}

// setArm32Target pins types' live layout to the ILP32 configuration the arm32
// backend runs under (PointerSize / IntSize = 4, MaxAlign = 8 — AAPCS aligns
// int64 / double to 8 even though int / pointer are 4).  Matches setArm32Layout
// in cmd/bnc/target.bn and setTarget32 in native/common's tests.  Shim tests
// whose word-count assertions depend on the target int/pointer size must call
// this so `int` counts as 1 word (as it does in real compilation), not the LP64
// host default (8 bytes = 2 words).
func setArm32Target() {
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
}

// A capturing closure func value (single int capture, no user args) carries its
// capture pointer in R0; emitFuncValueShims now emits the P4-d closure shim for
// it (LDR R0,[R0,#0]; B underlying) rather than rejecting it.  The closure is
// collected via the IsLinkOnce path in collectFuncValueRefs.
func TestClosureFuncValueShimEmitsShim() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var m @ir.Module = ir.NewModule("\"main\"")
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var fx @types.Field = make(types.Field)
	fx.Name = "n"
	fx.Type = types.TypInt()
	fields[0] = fx
	var f @ir.Func = make(ir.Func)
	f.Name = "main.__funclit_c"
	f.IsClosure = true
	f.IsLinkOnce = true
	f.NumCaptureParams = 1
	f.ClosureStruct = types.MakeStructType("__closure_c", fields)
	var noP @[]@ir.Param
	f.Params = noP
	var noR @[]@types.Type
	f.Results = noR
	var noB @[]@ir.Block
	f.Blocks = noB
	var funcs @[]@ir.Func = make_slice(@ir.Func, 1)
	funcs[0] = f
	m.Funcs = funcs
	emitFuncValueShims(a, "main", m)
	if a.HasError {
		return fail("a capturing closure func value should emit the P4-d shim, not error")
	}
	// 1 capture, 0 user args: LDR R0,[R0,#0] + B = 2 instrs (8 bytes).  No marshal
	// (no user args), then the single capture self-load, then the tail-branch.
	if a.Sections[0].Len != 8 {
		return fail("a 1-cap/0-user closure shim should be LDR + tail-branch (8 bytes)")
	}
	return ""
}

// lookupClosureFuncArm32 returns the Func only for a capturing closure; a
// plain (non-closure) func of the same name is not matched.
func TestLookupClosureFuncArm32() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var plain @ir.Func = make(ir.Func)
	plain.Name = "main.plain"
	var funcs @[]@ir.Func = make_slice(@ir.Func, 1)
	funcs[0] = plain
	m.Funcs = funcs
	if lookupClosureFuncArm32(m, "main.plain") != nil {
		return fail("a non-closure func must not be treated as a closure")
	}
	plain.IsClosure = true
	if lookupClosureFuncArm32(m, "main.plain") == nil {
		return fail("a closure func must be matched")
	}
	return ""
}

// The func-value collection self-lists the synthesized __Package accessor when
// the module carries a PackageAccessorSig, so its handle triple is defined.
func TestCollectRefsIncludesPackageAccessor() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var noParams2 @[]@types.Param
	var pkgResults @[]@types.Type = make_slice(@types.Type, 1)
	pkgResults[0] = types.MakeManagedPtrType(types.TypInt())
	m.PackageAccessorSig = types.MakeFuncValueType(noParams2, pkgResults)
	var seen @[]@[]char
	seen, _ = collectFuncValueRefs(m)
	if len(seen) != 1 {
		return fail("collectFuncValueRefs should self-list __Package")
	}
	if !charEq(seen[0], "main.__Package") {
		return fail("expected the __Package accessor keyed on main.__Package")
	}
	return ""
}
