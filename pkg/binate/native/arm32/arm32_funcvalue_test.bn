package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// shimSymFor / vtableSymFor decorate the bare mangled function symbol with the
// canonical __shim / __vt suffixes the func-value triple uses.
func TestShimVtableSymNames() testing.TestResult {
	var shim @[]char = shimSymFor("main", "main.main")
	if !charEq(shim, "bn_F1_4_main1_4_main__shim") {
		return fail("expected bn_F1_4_main1_4_main__shim")
	}
	var vt @[]char = vtableSymFor("main", "main.main")
	if !charEq(vt, "bn_F1_4_main1_4_main__vt") {
		return fail("expected bn_F1_4_main1_4_main__vt")
	}
	return ""
}

// A no-arg scalar/void shim is a single tail-branch (`B <fn>`, 4 bytes): there
// are no user args to shift down past the dropped data word.  This is exactly
// the __Package accessor's shim shape.
func TestScalarVoidShimNoArgIsTailBranch() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var noParams2 @[]@types.Param
	var noResults2 @[]@types.Type
	var fv @types.Type = types.MakeFuncValueType(noParams2, noResults2)
	emitScalarVoidShim(a, "bn_F1_4_main1_4_main", fv)
	if a.Sections[0].Len != 4 {
		return fail("no-arg scalar/void shim should be a single tail-branch (4 bytes)")
	}
	return ""
}

// setArm32Target pins types' live layout to the ILP32 configuration the arm32
// backend runs under (PointerSize / IntSize = 4, MaxAlign = 8 — AAPCS aligns
// int64 / double to 8 even though int / pointer are 4).  Matches setArm32Layout
// in cmd/bnc/target.bn and setTarget32 in native/common's tests.  Shim tests
// whose word-count assertions depend on the target int/pointer size must call
// this so `int` counts as 1 word (as it does in real compilation), not the LP64
// host default (8 bytes = 2 words).
func setArm32Target() {
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
}

// A shim with one scalar arg shifts R1 -> R0 (one MOV) then tail-branches
// (2 instructions, 8 bytes).  Pins the ILP32 target so `int` is a single GP
// word (as on the real arm32 target), not the LP64 host default's 2 words.
func TestScalarVoidShimOneArgShifts() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Name = "x"
	p.Type = types.TypInt()
	params[0] = p
	var noResults2 @[]@types.Type
	var fv @types.Type = types.MakeFuncValueType(params, noResults2)
	emitScalarVoidShim(a, "bn_F1_4_main1_4_main", fv)
	if a.Sections[0].Len != 8 {
		return fail("one-arg shim should be MOV + tail-branch (8 bytes)")
	}
	return ""
}

// A shim with a 64-bit register-pair scalar arg (int64 on ILP32 = 2 GP words)
// must fail LOUDLY: it is neither aggregate nor float, so it slips the other
// guards, but the naive single-word shift would misplace the register pair.
func TestScalarVoidShimInt64ArgSetsError() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Name = "x"
	p.Type = types.TypInt64()
	params[0] = p
	var noResults2 @[]@types.Type
	var fv @types.Type = types.MakeFuncValueType(params, noResults2)
	emitScalarVoidShim(a, "bn_F1_4_main1_4_main", fv)
	if !a.HasError {
		return fail("shim with a 64-bit register-pair arg must set an error")
	}
	return ""
}

// aggPairType is an 8-byte (ILP32) struct — > InternalSretBytes (4), so a func
// value returning it takes the big-aggregate R0-sret shim shape.  Shared by the
// call-indirect tests too.
func aggPairType() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Name = "a"
	fields[0].Type = types.TypInt()
	fields[1] = make(types.Field)
	fields[1].Name = "b"
	fields[1].Type = types.TypInt()
	return types.MakeStructType("Pair", fields)
}

// aggSmallType is a 4-byte (ILP32) struct — <= InternalSretBytes (4), the small
// in-register aggregate return shape deferred to P4-b.
func aggSmallType() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	fields[0] = make(types.Field)
	fields[0].Name = "a"
	fields[0].Type = types.TypInt()
	return types.MakeStructType("One", fields)
}

// A func value returning a big (>4-byte) aggregate takes the AAPCS32 R0-sret shim
// shape: the retbuf stays in R0 (unlike AAPCS64's X8), the data word (R1) is
// dropped, user args shift down, and the shim tail-branches.  A no-arg
// big-aggregate shim is thus a single tail-branch (4 bytes) — no args to shift.
// Pins the ILP32 target so a 2-int struct is 8 bytes (> 4) → sret.
func TestFuncValueShimBigAggregateReturnIsSret() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var noParams @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = aggPairType()
	var fv @types.Type = types.MakeFuncValueType(noParams, results)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main", fv)
	if a.HasError {
		return fail("a big-aggregate return should use the sret shim, not fail")
	}
	if a.Sections[0].Len != 4 {
		return fail("a no-arg sret shim should be a single tail-branch (4 bytes)")
	}
	return ""
}

// The sret shim keeps R0 (retbuf) and shifts user args down from R2.. to R1..:
// one user arg is one MOV (R1 <- R2) then the tail-branch (8 bytes).  Contrast
// the scalar shim, whose one-arg form shifts R1 -> R0.
func TestFuncValueShimSretOneArgShiftsFromR2() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Name = "x"
	p.Type = types.TypInt()
	params[0] = p
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = aggPairType()
	var fv @types.Type = types.MakeFuncValueType(params, results)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main", fv)
	if a.HasError {
		return fail("a one-arg big-aggregate sret shim should not fail")
	}
	if a.Sections[0].Len != 8 {
		return fail("a one-arg sret shim should be MOV + tail-branch (8 bytes)")
	}
	return ""
}

// A func value returning a SMALL (<=4-byte) aggregate comes back BY VALUE in R0,
// so its shim is the PACK shim: unlike the tail-branch scalar/sret shims, it
// builds a frame, saves the retbuf, BLs the underlying, stores the returned R0
// word through the retbuf, and returns.  A no-arg pack shim is exactly 5
// instructions (push {r4,lr}; mov r4,r0; bl; str r0,[r4]; pop {r4,pc}) = 20
// bytes.  A single-int struct is 4 bytes on ILP32.
func TestFuncValueShimSmallAggregateReturnIsPack() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var noParams @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = aggSmallType()
	var fv @types.Type = types.MakeFuncValueType(noParams, results)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main", fv)
	if a.HasError {
		return fail("a small (<=4-byte) aggregate return should use the pack shim")
	}
	if a.Sections[0].Len != 20 {
		return fail("a no-arg pack shim should be 5 instructions (20 bytes): "
			"push, mov, bl, str, pop")
	}
	return ""
}

// mkMultiReturnFv_arm32test builds a func-value type with n int32 results and no
// params, i.e. a multi-return func value whose tuple is n GP words.
func mkMultiReturnFv_arm32test(n int) @types.Type {
	var noParams @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, n)
	for i := 0; i < n; i++ { results[i] = types.TypInt32() }
	return types.MakeFuncValueType(noParams, results)
}

// A SMALL multi-return func value (gpWords <= 4) packs its fields into r0..r3;
// the underlying does the packing and the shim never touches the return
// registers, so it takes the scalar/void (tail-branch) shim.  A no-arg such shim
// is a single tail-branch (4 bytes), like the scalar/void no-arg shim — NOT the
// pack shim's frame (20 bytes).
func TestFuncValueShimSmallMultiReturnIsTailBranch() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main",
		mkMultiReturnFv_arm32test(2))
	if a.HasError {
		return fail("a small multi-return shim should tail-branch, not fail")
	}
	if a.Sections[0].Len != 4 {
		return fail("a no-arg small multi-return shim should be a single "
			"tail-branch (4 bytes)")
	}
	return ""
}

// A BIG multi-return func value (gpWords > 4) srets through R0, so its shim takes
// the AAPCS32 sret shape (retbuf stays in R0, data R1 dropped, tail-branch) —
// identical to the single big-aggregate sret shim.  A no-arg such shim is a
// single tail-branch (4 bytes).
func TestFuncValueShimBigMultiReturnIsSret() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitFuncValueShimBody(a, "bn_F1_4_main1_4_main",
		mkMultiReturnFv_arm32test(5))
	if a.HasError {
		return fail("a big multi-return shim should use the sret shim, not fail")
	}
	if a.Sections[0].Len != 4 {
		return fail("a no-arg big multi-return sret shim should be a single "
			"tail-branch (4 bytes)")
	}
	return ""
}

// A capturing closure func value carries its capture pointer in R0, which the
// scalar shim would drop — emitFuncValueShims must reject it LOUDLY.  The
// closure is collected via the IsLinkOnce path in collectFuncValueRefs.
func TestClosureFuncValueShimSetsError() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var m @ir.Module = ir.NewModule("\"main\"")
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var fx @types.Field = make(types.Field)
	fx.Name = "n"
	fx.Type = types.TypInt()
	fields[0] = fx
	var f @ir.Func = make(ir.Func)
	f.Name = "main.__funclit_c"
	f.IsClosure = true
	f.IsLinkOnce = true
	f.NumCaptureParams = 1
	f.ClosureStruct = types.MakeStructType("__closure_c", fields)
	var noP @[]@ir.Param
	f.Params = noP
	var noR @[]@types.Type
	f.Results = noR
	var noB @[]@ir.Block
	f.Blocks = noB
	var funcs @[]@ir.Func = make_slice(@ir.Func, 1)
	funcs[0] = f
	m.Funcs = funcs
	emitFuncValueShims(a, "main", m)
	if !a.HasError {
		return fail("a capturing closure func value must set a compile error")
	}
	return ""
}

// lookupClosureFuncArm32 returns the Func only for a capturing closure; a
// plain (non-closure) func of the same name is not matched.
func TestLookupClosureFuncArm32() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var plain @ir.Func = make(ir.Func)
	plain.Name = "main.plain"
	var funcs @[]@ir.Func = make_slice(@ir.Func, 1)
	funcs[0] = plain
	m.Funcs = funcs
	if lookupClosureFuncArm32(m, "main.plain") != nil {
		return fail("a non-closure func must not be treated as a closure")
	}
	plain.IsClosure = true
	if lookupClosureFuncArm32(m, "main.plain") == nil {
		return fail("a closure func must be matched")
	}
	return ""
}

// The func-value collection self-lists the synthesized __Package accessor when
// the module carries a PackageAccessorSig, so its handle triple is defined.
func TestCollectRefsIncludesPackageAccessor() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var noParams2 @[]@types.Param
	var pkgResults @[]@types.Type = make_slice(@types.Type, 1)
	pkgResults[0] = types.MakeManagedPtrType(types.TypInt())
	m.PackageAccessorSig = types.MakeFuncValueType(noParams2, pkgResults)
	var seen @[]@[]char
	seen, _ = collectFuncValueRefs(m)
	if len(seen) != 1 {
		return fail("collectFuncValueRefs should self-list __Package")
	}
	if !charEq(seen[0], "main.__Package") {
		return fail("expected the __Package accessor keyed on main.__Package")
	}
	return ""
}
