package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Emit-level tests for the fused field load/store (arm32_fused_mem.bn): the
// folded GEP is elided and the load/store rederives the address as
// [base, #offset] — one instruction, byte-identical to a direct emitScalarLoad/
// Store at that offset (not the un-fused ADD + LDR/STR).

func ffMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	return a
}

func ffBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// ffTarget32 pins the ILP32 target so wordBytes()==4 and
// FieldOffset({int,int}, 1) == 4 (int is 4 bytes here).
func ffTarget32() {
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
}

// ffTwoIntStruct builds `struct { f0 int; f1 int }` — field 1 is at byte offset
// 4 on ILP32, the offset the fused field load/store must encode.
func ffTwoIntStruct() @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 2)
	var a @types.Field = make(types.Field)
	a.Name = "f0"
	a.Type = types.TypInt()
	var b @types.Field = make(types.Field)
	b.Name = "f1"
	b.Type = types.TypInt()
	fs[0] = a
	fs[1] = b
	return types.MakeStructType("S", fs)
}

// ffFieldGep builds an OP_GET_FIELD_PTR for field 1 of {int,int} off a register
// base value (id 100).
func ffFieldGep() @ir.Instr {
	var base @ir.Instr = make(ir.Instr)
	base.ID = 100
	base.Typ = types.MakePointerType(ffTwoIntStruct())
	var gep @ir.Instr = make(ir.Instr)
	gep.ID = 101
	gep.Op = iropcode.OP_GET_FIELD_PTR
	gep.Index = 1
	gep.Typ = types.MakePointerType(types.TypInt())
	gep.Args = ir.MakeArgs1(base)
	return gep
}

// ffAllocaFieldGep builds an OP_GET_FIELD_PTR for field 1 of {int,int} off an
// OP_ALLOC base value (id 100) — the alloca-base fold target.
func ffAllocaFieldGep() @ir.Instr {
	var base @ir.Instr = make(ir.Instr)
	base.ID = 100
	base.Op = iropcode.OP_ALLOC
	base.Typ = types.MakePointerType(ffTwoIntStruct())
	var gep @ir.Instr = make(ir.Instr)
	gep.ID = 101
	gep.Op = iropcode.OP_GET_FIELD_PTR
	gep.Index = 1
	gep.Typ = types.MakePointerType(types.TypInt())
	gep.Args = ir.MakeArgs1(base)
	return gep
}

// A fused field GEP load is one LDR at [base, #4], byte-identical to a direct
// emitScalarLoad at that offset (not the un-fused ADD + LDR).
func TestEmitFusedFieldLoadFoldsOffset() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(common.AAPCS32())
	// base (id 100) homed to R4; load result (id 102) homed to R5.
	m.HomeIDs = common.AppendInt(m.HomeIDs, 100)
	m.HomeRegs = common.AppendInt(m.HomeRegs, arm32.R4)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 102)
	m.HomeRegs = common.AppendInt(m.HomeRegs, arm32.R5)

	var gep @ir.Instr = ffFieldGep()
	var ld @ir.Instr = make(ir.Instr)
	ld.ID = 102
	ld.Op = iropcode.OP_LOAD
	ld.Typ = types.TypInt()
	ld.Args = ir.MakeArgs1(gep)

	emitFusedFieldLoad(a, m, ld, gep)
	var n int = ffBytes(a)
	if n == 0 { return "fused field load emitted nothing" }

	var ref @asm.Assembler = ffMkAsm()
	emitScalarLoad(ref, arm32.R5, arm32.R4, 4, 4, false)
	if ffBytes(ref) != n { return "fused field load byte count must match LDR R5,[R4,#4]" }
	var k int = 0
	for k = 0; k < n; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "fused field load must equal LDR R5,[R4,#4]"
		}
	}
	return ""
}

// The store analogue: one STR at [base, #4].
func TestEmitFusedFieldStoreFoldsOffset() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(common.AAPCS32())
	// base (id 100) homed to R4; stored value (id 103) homed to R6.
	m.HomeIDs = common.AppendInt(m.HomeIDs, 100)
	m.HomeRegs = common.AppendInt(m.HomeRegs, arm32.R4)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 103)
	m.HomeRegs = common.AppendInt(m.HomeRegs, arm32.R6)

	var gep @ir.Instr = ffFieldGep()
	var val @ir.Instr = make(ir.Instr)
	val.ID = 103
	val.Typ = types.TypInt()
	var storeIns @ir.Instr = make(ir.Instr)
	storeIns.ID = 104
	storeIns.Op = iropcode.OP_STORE
	storeIns.Args = ir.MakeArgs2(gep, val)

	emitFusedFieldStore(a, "main", m, storeIns, gep)
	var n int = ffBytes(a)
	if n == 0 { return "fused field store emitted nothing" }

	var ref @asm.Assembler = ffMkAsm()
	emitScalarStore(ref, arm32.R6, arm32.R4, 4, 4)
	if ffBytes(ref) != n { return "fused field store byte count must match STR R6,[R4,#4]" }
	var k int = 0
	for k = 0; k < n; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "fused field store must equal STR R6,[R4,#4]"
		}
	}
	return ""
}

// An alloca-base fused field load with a small combined offset (allocOff 8 +
// field 4 = 12 ≤ 255) is one LDR at [sp, #12] — allocOff+fieldOff folded into
// the immediate, no standalone ADD.
func TestEmitFusedFieldLoadAllocaBaseSmallOffset() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(common.AAPCS32())
	// alloca base (id 100) at frame offset 8; load result (id 102) homed to R5.
	m.AllocIDs = common.AppendInt(m.AllocIDs, 100)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 8)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 8)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 102)
	m.HomeRegs = common.AppendInt(m.HomeRegs, arm32.R5)

	var gep @ir.Instr = ffAllocaFieldGep()
	var ld @ir.Instr = make(ir.Instr)
	ld.ID = 102
	ld.Op = iropcode.OP_LOAD
	ld.Typ = types.TypInt()
	ld.Args = ir.MakeArgs1(gep)

	emitFusedFieldLoad(a, m, ld, gep)
	var n int = ffBytes(a)
	if n == 0 { return "alloca-base fused field load emitted nothing" }

	var ref @asm.Assembler = ffMkAsm()
	emitScalarLoad(ref, arm32.R5, arm32.SP, 12, 4, false)
	if ffBytes(ref) != n { return "alloca-base fused load byte count must match LDR R5,[SP,#12]" }
	var k int = 0
	for k = 0; k < n; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "alloca-base fused load must equal LDR R5,[SP,#12] (no standalone ADD)"
		}
	}
	return ""
}

// An alloca-base fused field load with a large combined offset (allocOff 300 +
// field 4 = 304 > 255) materializes the address in IP (emitFrameAddr) then loads
// [IP] — the scratch fallback, still correct and no worse than the standalone
// GEP it replaces.
func TestEmitFusedFieldLoadAllocaBaseLargeOffset() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(common.AAPCS32())
	// alloca base (id 100) at frame offset 300; load result (id 102) homed to R5.
	m.AllocIDs = common.AppendInt(m.AllocIDs, 100)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 300)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 8)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 102)
	m.HomeRegs = common.AppendInt(m.HomeRegs, arm32.R5)

	var gep @ir.Instr = ffAllocaFieldGep()
	var ld @ir.Instr = make(ir.Instr)
	ld.ID = 102
	ld.Op = iropcode.OP_LOAD
	ld.Typ = types.TypInt()
	ld.Args = ir.MakeArgs1(gep)

	emitFusedFieldLoad(a, m, ld, gep)
	var n int = ffBytes(a)
	if n == 0 { return "alloca-base large-offset fused field load emitted nothing" }

	var ref @asm.Assembler = ffMkAsm()
	emitFrameAddr(ref, arm32.IP, 304)
	emitScalarLoad(ref, arm32.R5, arm32.IP, 0, 4, false)
	if ffBytes(ref) != n {
		return "alloca-base large-offset fused load must match emitFrameAddr(IP,304)+LDR R5,[IP]"
	}
	var k int = 0
	for k = 0; k < n; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "alloca-base large-offset fused load must equal emitFrameAddr(IP,304)+LDR R5,[IP]"
		}
	}
	return ""
}

// The alloca-base store analogue (small offset): one STR at [sp, #12].
func TestEmitFusedFieldStoreAllocaBaseSmallOffset() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(common.AAPCS32())
	// alloca base (id 100) at frame offset 8; stored value (id 103) homed to R6.
	m.AllocIDs = common.AppendInt(m.AllocIDs, 100)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 8)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 8)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 103)
	m.HomeRegs = common.AppendInt(m.HomeRegs, arm32.R6)

	var gep @ir.Instr = ffAllocaFieldGep()
	var val @ir.Instr = make(ir.Instr)
	val.ID = 103
	val.Typ = types.TypInt()
	var storeIns @ir.Instr = make(ir.Instr)
	storeIns.ID = 104
	storeIns.Op = iropcode.OP_STORE
	storeIns.Args = ir.MakeArgs2(gep, val)

	emitFusedFieldStore(a, "main", m, storeIns, gep)
	var n int = ffBytes(a)
	if n == 0 { return "alloca-base fused field store emitted nothing" }

	var ref @asm.Assembler = ffMkAsm()
	emitScalarStore(ref, arm32.R6, arm32.SP, 12, 4)
	if ffBytes(ref) != n { return "alloca-base fused store byte count must match STR R6,[SP,#12]" }
	var k int = 0
	for k = 0; k < n; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "alloca-base fused store must equal STR R6,[SP,#12] (no standalone ADD)"
		}
	}
	return ""
}

// The alloca-base store with a large combined offset (allocOff 300 + field 4 =
// 304 > 255) materializes the address in IP (emitFrameAddr) then stores [IP] —
// the store's scratch-fallback path.  IP (r12) is reserved outside the pool, so
// it never aliases the stored value's register (R6 here).
func TestEmitFusedFieldStoreAllocaBaseLargeOffset() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(common.AAPCS32())
	// alloca base (id 100) at frame offset 300; stored value (id 103) homed to R6.
	m.AllocIDs = common.AppendInt(m.AllocIDs, 100)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 300)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 8)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 103)
	m.HomeRegs = common.AppendInt(m.HomeRegs, arm32.R6)

	var gep @ir.Instr = ffAllocaFieldGep()
	var val @ir.Instr = make(ir.Instr)
	val.ID = 103
	val.Typ = types.TypInt()
	var storeIns @ir.Instr = make(ir.Instr)
	storeIns.ID = 104
	storeIns.Op = iropcode.OP_STORE
	storeIns.Args = ir.MakeArgs2(gep, val)

	emitFusedFieldStore(a, "main", m, storeIns, gep)
	var n int = ffBytes(a)
	if n == 0 { return "alloca-base large-offset fused field store emitted nothing" }

	var ref @asm.Assembler = ffMkAsm()
	emitFrameAddr(ref, arm32.IP, 304)
	emitScalarStore(ref, arm32.R6, arm32.IP, 0, 4)
	if ffBytes(ref) != n {
		return "alloca-base large-offset fused store must match emitFrameAddr(IP,304)+STR R6,[IP]"
	}
	var k int = 0
	for k = 0; k < n; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "alloca-base large-offset fused store must equal emitFrameAddr(IP,304)+STR R6,[IP]"
		}
	}
	return ""
}

// ffFloatStruct builds `struct { i int; s float32; d float64 }` — on ILP32 field
// s is at byte offset 4 and d (8-aligned) at 8: the float fields the fused float
// field load/store tests address.
func ffFloatStruct() @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 3)
	var fi @types.Field = make(types.Field)
	fi.Name = "i"
	fi.Type = types.TypInt()
	var fsg @types.Field = make(types.Field)
	fsg.Name = "s"
	fsg.Type = types.TypFloat32()
	var fd @types.Field = make(types.Field)
	fd.Name = "d"
	fd.Type = types.TypFloat64()
	fs[0] = fi
	fs[1] = fsg
	fs[2] = fd
	return types.MakeStructType("F", fs)
}

// ffFloatFieldGep builds an OP_GET_FIELD_PTR (id 101) for field `index` of
// ffFloatStruct, typed pointer-to-`elem`, off base id 100 — an OP_ALLOC when
// alloca is set, else a register value.
func ffFloatFieldGep(index int, elem @types.Type, alloca bool) @ir.Instr {
	var base @ir.Instr = make(ir.Instr)
	base.ID = 100
	if alloca { base.Op = iropcode.OP_ALLOC }
	base.Typ = types.MakePointerType(ffFloatStruct())
	var gep @ir.Instr = make(ir.Instr)
	gep.ID = 101
	gep.Op = iropcode.OP_GET_FIELD_PTR
	gep.Index = index
	gep.Typ = types.MakePointerType(elem)
	gep.Args = ir.MakeArgs1(base)
	return gep
}

// ffFloatLoad builds the OP_LOAD (id 102, type t) through gep.
func ffFloatLoad(gep @ir.Instr, t @types.Type) @ir.Instr {
	var ld @ir.Instr = make(ir.Instr)
	ld.ID = 102
	ld.Op = iropcode.OP_LOAD
	ld.Typ = t
	ld.Args = ir.MakeArgs1(gep)
	return ld
}

// ffFloatStore builds the OP_STORE (id 104) of value id 103 (type t) through gep.
func ffFloatStore(gep @ir.Instr, t @types.Type) @ir.Instr {
	var val @ir.Instr = make(ir.Instr)
	val.ID = 103
	val.Typ = t
	var st @ir.Instr = make(ir.Instr)
	st.ID = 104
	st.Op = iropcode.OP_STORE
	st.Args = ir.MakeArgs2(gep, val)
	return st
}

// ffFloatMap returns a RegMap with the fixture GEP (id 101) marked fusable, as
// FusableFieldGeps would, so the tests drive the full emitLoad / emitStore
// dispatch — including the 64-bit routing a float64 takes before the fused check.
func ffFloatMap() @common.RegMap {
	var m @common.RegMap = common.NewRegMap(common.AAPCS32())
	m.FusableFieldGep = make_slice(bool, 110)
	m.FusableFieldGep[101] = true
	return m
}

// ffHome records SSA id's home register in m.
func ffHome(m @common.RegMap, id int, reg int) {
	m.HomeIDs = common.AppendInt(m.HomeIDs, id)
	m.HomeRegs = common.AppendInt(m.HomeRegs, reg)
}

// ffSpill records SSA id's spill slot in m.
func ffSpill(m @common.RegMap, id int, off int) {
	m.SpillIDs = common.AppendInt(m.SpillIDs, id)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, off)
}

// ffAlloca records id 100 as a 16-byte alloca at frame offset allocOff.
func ffAlloca(m @common.RegMap, allocOff int) {
	m.AllocIDs = common.AppendInt(m.AllocIDs, 100)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, allocOff)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 16)
}

// ffSameBytes returns msg unless a emitted exactly ref's bytes.
func ffSameBytes(a @asm.Assembler, ref @asm.Assembler, msg testing.TestResult) testing.TestResult {
	if ffBytes(a) != ffBytes(ref) { return msg }
	var k int = 0
	for k = 0; k < ffBytes(a); k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] { return msg }
	}
	return ""
}

// A fused field load of an FP-homed float32 is one VLDR.32 into the home's low
// S-view (D8 -> S16) — not an LDR into a GP scratch followed by a VMOV.
func TestEmitFusedFieldLoadFloat32HomeIsVldr() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = ffFloatMap()
	ffHome(m, 100, arm32.R1)
	ffHome(m, 102, arm32.D8)
	var gep @ir.Instr = ffFloatFieldGep(1, types.TypFloat32(), false)
	emitLoad(a, "main", m, ffFloatLoad(gep, types.TypFloat32()))
	var ref @asm.Assembler = ffMkAsm()
	arm32.Vldr32(ref, arm32.COND_AL, arm32.S16, arm32.R1, 4)
	return ffSameBytes(a, ref, "fused float32 field load must be exactly VLDR.32 S16,[R1,#4]")
}

// The store analogue: one VSTR.32 from the value's low S-view (D9 -> S18).
func TestEmitFusedFieldStoreFloat32HomeIsVstr() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = ffFloatMap()
	ffHome(m, 100, arm32.R1)
	ffHome(m, 103, arm32.D9)
	var gep @ir.Instr = ffFloatFieldGep(1, types.TypFloat32(), false)
	emitStore(a, "main", m, ffFloatStore(gep, types.TypFloat32()))
	var ref @asm.Assembler = ffMkAsm()
	arm32.Vstr32(ref, arm32.COND_AL, arm32.S18, arm32.R1, 4)
	return ffSameBytes(a, ref, "fused float32 field store must be exactly VSTR.32 S18,[R1,#4]")
}

// An alloca-base float32 field folds allocaOffset (32) + fieldOffset (4) into one
// SP-relative VLDR.32 S16,[SP,#36].
func TestEmitFusedFieldLoadFloat32AllocaBase() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = ffFloatMap()
	ffAlloca(m, 32)
	ffHome(m, 102, arm32.D8)
	var gep @ir.Instr = ffFloatFieldGep(1, types.TypFloat32(), true)
	emitLoad(a, "main", m, ffFloatLoad(gep, types.TypFloat32()))
	var ref @asm.Assembler = ffMkAsm()
	arm32.Vldr32(ref, arm32.COND_AL, arm32.S16, arm32.SP, 36)
	return ffSameBytes(a, ref, "alloca-base fused float32 load must be exactly VLDR.32 S16,[SP,#36]")
}

// VLDR/VSTR reach only 1020: an alloca-base float field past it (2000 + 4)
// materializes the address in IP and addresses [IP, #0].
func TestEmitFusedFieldStoreFloat32AllocaBaseLargeOffset() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = ffFloatMap()
	ffAlloca(m, 2000)
	ffHome(m, 103, arm32.D9)
	var gep @ir.Instr = ffFloatFieldGep(1, types.TypFloat32(), true)
	emitStore(a, "main", m, ffFloatStore(gep, types.TypFloat32()))
	var ref @asm.Assembler = ffMkAsm()
	emitAddImm(ref, arm32.IP, arm32.SP, 2004, arm32.IP)
	arm32.Vstr32(ref, arm32.COND_AL, arm32.S18, arm32.IP, 0)
	return ffSameBytes(a, ref, "large-offset fused float32 store must be IP=SP+2004; VSTR.32 S18,[IP]")
}

// A float32 load whose result is NOT FP-homed (a spilled float, or soft-float)
// takes the GP path: one LDR R4,[R1,#4] into a pool register, recorded as the
// result's register (the dispatcher's handleResult then stores it to the slot).
func TestEmitFusedFieldLoadFloat32UnhomedUsesGp() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = ffFloatMap()
	ffHome(m, 100, arm32.R1)
	ffSpill(m, 102, 48)
	var gep @ir.Instr = ffFloatFieldGep(1, types.TypFloat32(), false)
	emitLoad(a, "main", m, ffFloatLoad(gep, types.TypFloat32()))
	if m.LookupReg(102) != arm32.R4 {
		return "unhomed float32 load result must land in pool register R4"
	}
	var ref @asm.Assembler = ffMkAsm()
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.R1, 4))
	return ffSameBytes(a, ref, "unhomed fused float32 load must be exactly LDR R4,[R1,#4]")
}

// A float32 store whose value is NOT FP-homed reloads its bits from the slot into
// a GP scratch and stores them: LDR R4,[SP,#48]; STR R4,[R1,#4].
func TestEmitFusedFieldStoreFloat32UnhomedUsesGp() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = ffFloatMap()
	ffHome(m, 100, arm32.R1)
	ffSpill(m, 103, 48)
	var gep @ir.Instr = ffFloatFieldGep(1, types.TypFloat32(), false)
	emitStore(a, "main", m, ffFloatStore(gep, types.TypFloat32()))
	var ref @asm.Assembler = ffMkAsm()
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 48))
	arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.R1, 4))
	return ffSameBytes(a, ref, "unhomed fused float32 store must be LDR R4,[SP,#48]; STR R4,[R1,#4]")
}

// A float64 load goes through emitLoad64 (every 64-bit load does) and, with a
// fused field GEP, must NOT fall to its address-in-a-register path — the GEP was
// never emitted.  An FP-homed result is one VLDR.64 into the D home.
func TestEmitFusedFieldLoadFloat64HomeIsVldr() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = ffFloatMap()
	ffHome(m, 100, arm32.R1)
	ffHome(m, 102, arm32.D8)
	var gep @ir.Instr = ffFloatFieldGep(2, types.TypFloat64(), false)
	emitLoad(a, "main", m, ffFloatLoad(gep, types.TypFloat64()))
	var ref @asm.Assembler = ffMkAsm()
	arm32.Vldr64(ref, arm32.COND_AL, arm32.D8, arm32.R1, 8)
	return ffSameBytes(a, ref, "fused float64 field load must be exactly VLDR.64 D8,[R1,#8]")
}

// The store analogue through emitStore64: one VSTR.64 from the D home.
func TestEmitFusedFieldStoreFloat64HomeIsVstr() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = ffFloatMap()
	ffHome(m, 100, arm32.R1)
	ffHome(m, 103, arm32.D9)
	var gep @ir.Instr = ffFloatFieldGep(2, types.TypFloat64(), false)
	emitStore(a, "main", m, ffFloatStore(gep, types.TypFloat64()))
	var ref @asm.Assembler = ffMkAsm()
	arm32.Vstr64(ref, arm32.COND_AL, arm32.D9, arm32.R1, 8)
	return ffSameBytes(a, ref, "fused float64 field store must be exactly VSTR.64 D9,[R1,#8]")
}

// An alloca-base float64 field past VLDR's 1020 reach (2000 + 8) materializes the
// address in IP: IP = SP + 2008; VLDR.64 D8,[IP].
func TestEmitFusedFieldLoadFloat64AllocaBaseLargeOffset() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = ffFloatMap()
	ffAlloca(m, 2000)
	ffHome(m, 102, arm32.D8)
	var gep @ir.Instr = ffFloatFieldGep(2, types.TypFloat64(), true)
	emitLoad(a, "main", m, ffFloatLoad(gep, types.TypFloat64()))
	var ref @asm.Assembler = ffMkAsm()
	emitAddImm(ref, arm32.IP, arm32.SP, 2008, arm32.IP)
	arm32.Vldr64(ref, arm32.COND_AL, arm32.D8, arm32.IP, 0)
	return ffSameBytes(a, ref, "large-offset fused float64 load must be IP=SP+2008; VLDR.64 D8,[IP]")
}

// An UNHOMED float64 fused field load (spilled, or soft-float) reads its two
// words straight off the base — LDR R4,[R1,#8]; LDR R5,[R1,#12] — and stores the
// pair to its slot.
func TestEmitFusedFieldLoadFloat64UnhomedIsWordPair() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = ffFloatMap()
	ffHome(m, 100, arm32.R1)
	ffSpill(m, 102, 16)
	var gep @ir.Instr = ffFloatFieldGep(2, types.TypFloat64(), false)
	emitLoad(a, "main", m, ffFloatLoad(gep, types.TypFloat64()))
	var ref @asm.Assembler = ffMkAsm()
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.R1, 8))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R5, arm32.MemImm(arm32.R1, 12))
	arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 16))
	arm32.Str(ref, arm32.COND_AL, arm32.R5, arm32.MemImm(arm32.SP, 20))
	return ffSameBytes(a, ref,
			"unhomed fused float64 load must be LDR/LDR off the base + the slot pair store")
}

// An UNHOMED float64 fused field store reloads the value's pair from its slot and
// writes the two words off the base: LDR R4,[SP,#48]; LDR R5,[SP,#52];
// STR R4,[R1,#8]; STR R5,[R1,#12].
func TestEmitFusedFieldStoreFloat64UnhomedIsWordPair() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = ffFloatMap()
	ffHome(m, 100, arm32.R1)
	ffSpill(m, 103, 48)
	var gep @ir.Instr = ffFloatFieldGep(2, types.TypFloat64(), false)
	emitStore(a, "main", m, ffFloatStore(gep, types.TypFloat64()))
	var ref @asm.Assembler = ffMkAsm()
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 48))
	arm32.Ldr(ref, arm32.COND_AL, arm32.R5, arm32.MemImm(arm32.SP, 52))
	arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.R1, 8))
	arm32.Str(ref, arm32.COND_AL, arm32.R5, arm32.MemImm(arm32.R1, 12))
	return ffSameBytes(a, ref,
			"unhomed fused float64 store must be the slot pair reload + STR/STR off the base")
}

// fieldFoldSet — the fold set emitFunc hands the allocator and the emitters —
// folds float fields, float64 included on this 32-bit target: a float64 and a
// float32 load, each through its own single-use field GEP.  (A backend that
// stops opting floats in would still compile everything correctly, just with a
// standalone address per float field access, so only this pins the opt-in.)
func TestFieldFoldSetFoldsFloatFields() testing.TestResult {
	ffTarget32()
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "t", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var base @ir.Instr = irbuild.EmitConstNil(b, types.MakePointerType(ffFloatStruct()))
	var gd @ir.Instr = irbuild.EmitGetFieldPtr(b, base, 2, types.TypFloat64())
	_ = irbuild.EmitLoad(b, gd, types.TypFloat64())
	var gs @ir.Instr = irbuild.EmitGetFieldPtr(b, base, 1, types.TypFloat32())
	_ = irbuild.EmitLoad(b, gs, types.TypFloat32())
	var fs @[]bool = fieldFoldSet(f)
	if gd.ID >= len(fs) || !fs[gd.ID] { return "a float64 field access must fold" }
	if gs.ID >= len(fs) || !fs[gs.ID] { return "a float32 field access must fold" }
	return ""
}

// A fused float32 field access whose base pointer is SPILLED (not homed) reloads
// the base into a pool register and addresses off it: LDR R4,[SP,#40] then
// VLDR.32 S16,[R4,#4] (load) / VSTR.32 S18,[R4,#4] (store).
func TestEmitFusedFieldFloat32SpilledBase() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = ffFloatMap()
	ffSpill(m, 100, 40)
	ffHome(m, 102, arm32.D8)
	var gep @ir.Instr = ffFloatFieldGep(1, types.TypFloat32(), false)
	emitLoad(a, "main", m, ffFloatLoad(gep, types.TypFloat32()))
	var ref @asm.Assembler = ffMkAsm()
	arm32.Ldr(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 40))
	arm32.Vldr32(ref, arm32.COND_AL, arm32.S16, arm32.R4, 4)
	var r testing.TestResult = ffSameBytes(a, ref,
			"spilled-base fused float32 load must be LDR R4,[SP,#40]; VLDR.32 S16,[R4,#4]")
	if len(r) != 0 { return r }

	var a2 @asm.Assembler = ffMkAsm()
	var m2 @common.RegMap = ffFloatMap()
	ffSpill(m2, 100, 40)
	ffHome(m2, 103, arm32.D9)
	var gep2 @ir.Instr = ffFloatFieldGep(1, types.TypFloat32(), false)
	emitStore(a2, "main", m2, ffFloatStore(gep2, types.TypFloat32()))
	var ref2 @asm.Assembler = ffMkAsm()
	arm32.Ldr(ref2, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 40))
	arm32.Vstr32(ref2, arm32.COND_AL, arm32.S18, arm32.R4, 4)
	return ffSameBytes(a2, ref2,
			"spilled-base fused float32 store must be LDR R4,[SP,#40]; VSTR.32 S18,[R4,#4]")
}

// An UNHOMED float64 field of an alloca past the 12-bit LDR reach (5000 + 8)
// loads each word through an IP-materialized offset (emitBaseLoad's large-offset
// form) and stores the pair to its slot.
func TestEmitFusedFieldLoadFloat64UnhomedAllocaPast4095() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = ffFloatMap()
	ffAlloca(m, 5000)
	ffSpill(m, 102, 16)
	var gep @ir.Instr = ffFloatFieldGep(2, types.TypFloat64(), true)
	emitLoad(a, "main", m, ffFloatLoad(gep, types.TypFloat64()))
	var ref @asm.Assembler = ffMkAsm()
	emitBaseLoad(ref, arm32.R4, arm32.SP, 5008, arm32.IP)
	emitBaseLoad(ref, arm32.R5, arm32.SP, 5012, arm32.IP)
	arm32.Str(ref, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, 16))
	arm32.Str(ref, arm32.COND_AL, arm32.R5, arm32.MemImm(arm32.SP, 20))
	if ffBytes(ref) <= 16 { return "reference must use the large-offset LDR form" }
	return ffSameBytes(a, ref,
			"unhomed float64 load at alloca offset 5008 must use the IP large-offset LDR pair")
}
