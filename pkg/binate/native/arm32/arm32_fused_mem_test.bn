package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Emit-level tests for the fused field load/store (arm32_fused_mem.bn): the
// folded GEP is elided and the load/store rederives the address as
// [base, #offset] — one instruction, byte-identical to a direct emitScalarLoad/
// Store at that offset (not the un-fused ADD + LDR/STR).

func ffMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	return a
}

func ffBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// ffTarget32 pins the ILP32 target so wordBytes()==4 and
// FieldOffset({int,int}, 1) == 4 (int is 4 bytes here).
func ffTarget32() {
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
}

// ffTwoIntStruct builds `struct { f0 int; f1 int }` — field 1 is at byte offset
// 4 on ILP32, the offset the fused field load/store must encode.
func ffTwoIntStruct() @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 2)
	var a @types.Field = make(types.Field)
	a.Name = "f0"
	a.Type = types.TypInt()
	var b @types.Field = make(types.Field)
	b.Name = "f1"
	b.Type = types.TypInt()
	fs[0] = a
	fs[1] = b
	return types.MakeStructType("S", fs)
}

// ffFieldGep builds an OP_GET_FIELD_PTR for field 1 of {int,int} off a register
// base value (id 100).
func ffFieldGep() @ir.Instr {
	var base @ir.Instr = make(ir.Instr)
	base.ID = 100
	base.Typ = types.MakePointerType(ffTwoIntStruct())
	var gep @ir.Instr = make(ir.Instr)
	gep.ID = 101
	gep.Op = iropcode.OP_GET_FIELD_PTR
	gep.Index = 1
	gep.Typ = types.MakePointerType(types.TypInt())
	gep.Args = ir.MakeArgs1(base)
	return gep
}

// A fused field GEP load is one LDR at [base, #4], byte-identical to a direct
// emitScalarLoad at that offset (not the un-fused ADD + LDR).
func TestEmitFusedFieldLoadFoldsOffset() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(common.AAPCS32())
	// base (id 100) homed to R4; load result (id 102) homed to R5.
	m.HomeIDs = common.AppendInt(m.HomeIDs, 100)
	m.HomeRegs = common.AppendInt(m.HomeRegs, arm32.R4)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 102)
	m.HomeRegs = common.AppendInt(m.HomeRegs, arm32.R5)

	var gep @ir.Instr = ffFieldGep()
	var ld @ir.Instr = make(ir.Instr)
	ld.ID = 102
	ld.Op = iropcode.OP_LOAD
	ld.Typ = types.TypInt()
	ld.Args = ir.MakeArgs1(gep)

	emitFusedFieldLoad(a, m, ld, gep)
	var n int = ffBytes(a)
	if n == 0 { return "fused field load emitted nothing" }

	var ref @asm.Assembler = ffMkAsm()
	emitScalarLoad(ref, arm32.R5, arm32.R4, 4, 4, false)
	if ffBytes(ref) != n { return "fused field load byte count must match LDR R5,[R4,#4]" }
	var k int = 0
	for k = 0; k < n; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "fused field load must equal LDR R5,[R4,#4]"
		}
	}
	return ""
}

// The store analogue: one STR at [base, #4].
func TestEmitFusedFieldStoreFoldsOffset() testing.TestResult {
	ffTarget32()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(common.AAPCS32())
	// base (id 100) homed to R4; stored value (id 103) homed to R6.
	m.HomeIDs = common.AppendInt(m.HomeIDs, 100)
	m.HomeRegs = common.AppendInt(m.HomeRegs, arm32.R4)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 103)
	m.HomeRegs = common.AppendInt(m.HomeRegs, arm32.R6)

	var gep @ir.Instr = ffFieldGep()
	var val @ir.Instr = make(ir.Instr)
	val.ID = 103
	val.Typ = types.TypInt()
	var storeIns @ir.Instr = make(ir.Instr)
	storeIns.ID = 104
	storeIns.Op = iropcode.OP_STORE
	storeIns.Args = ir.MakeArgs2(gep, val)

	emitFusedFieldStore(a, "main", m, storeIns, gep)
	var n int = ffBytes(a)
	if n == 0 { return "fused field store emitted nothing" }

	var ref @asm.Assembler = ffMkAsm()
	emitScalarStore(ref, arm32.R6, arm32.R4, 4, 4)
	if ffBytes(ref) != n { return "fused field store byte count must match STR R6,[R4,#4]" }
	var k int = 0
	for k = 0; k < n; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "fused field store must equal STR R6,[R4,#4]"
		}
	}
	return ""
}
