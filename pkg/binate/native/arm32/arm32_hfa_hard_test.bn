package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the hard-float HFA movement at the direct call / return / parameter
// boundary (arm32_hfa_hard.bn).  Each stamps an arm32 hard-float target, builds the
// RegMap on AAPCS32 (which passes HFAs in VFP registers), emits, restores the target,
// then pins the VLDR / VSTR of each member to the VFP register the back-fill allocator
// gives it — and, as controls, the GP placement of an HFA in a variadic call, one
// past the bank, and one with HfaAggregates turned off.

// hfaRm is the hard-float AAPCS32 RegMap, HFA passing in VFP registers included —
// call it after stampHard.
func hfaRm() @common.RegMap {
	var rm @common.RegMap = hardRm()
	rm.CC.HfaAggregates = true
	return rm
}

// hfaOffRm is hfaRm with HFA passing turned off.
func hfaOffRm() @common.RegMap {
	var rm @common.RegMap = hardRm()
	rm.CC.HfaAggregates = false
	return rm
}

// hfaType is a named struct of n members of type mem.
func hfaType(name @[]char, mem @types.Type, n int) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		fields[i] = make(types.Field)
		fields[i].Name = "m"
		fields[i].Type = mem
	}
	return types.MakeStructType(name, fields)
}

// addAllocArm32Hfa records a data region (id -> byte offset, size) on rm.
func addAllocArm32Hfa(rm @common.RegMap, id int, off int, size int) {
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, id)
	rm.AllocOffsets = common.AppendInt64(rm.AllocOffsets, cast(int64, off))
	rm.AllocSizes = common.AppendInt64(rm.AllocSizes, cast(int64, size))
}

// vldrWord / vstrWord encode a VLDR / VSTR of the S (isDouble false) or D register
// reg at [base + off].
func vldrWord(isDouble bool, reg int, base int, off int) uint32 {
	var ref @asm.Assembler = mkAsm()
	if isDouble {
		vfp.Vldr64(ref, arm32.COND_AL, reg, base, off)
	} else {
		vfp.Vldr32(ref, arm32.COND_AL, reg, base, off)
	}
	return word32(ref, 0)
}

func vstrWord(isDouble bool, reg int, base int, off int) uint32 {
	var ref @asm.Assembler = mkAsm()
	if isDouble {
		vfp.Vstr64(ref, arm32.COND_AL, reg, base, off)
	} else {
		vfp.Vstr32(ref, arm32.COND_AL, reg, base, off)
	}
	return word32(ref, 0)
}

// ldrWord encodes LDR rd, [base, #off].
func ldrWord(rd int, base int, off int) uint32 {
	var ref @asm.Assembler = mkAsm()
	arm32.Ldr(ref, arm32.COND_AL, rd, arm32.MemImm(base, off))
	return word32(ref, 0)
}

// vfpLoadCount counts a's VLDRs of the 16 S and D registers from [R4 + off] for off
// in 0..28 (an argument's pointer is reloaded into R4).
func vfpLoadCount(a @asm.Assembler) int {
	var loads @[]uint32 = make_slice(uint32, 256)
	for r := 0; r < 16; r++ {
		for k := 0; k < 8; k++ {
			loads[16 * r + 2 * k] = vldrWord(false, vfp.S0 + r, arm32.R4, 4 * k)
			loads[16 * r + 2 * k + 1] = vldrWord(true, vfp.D0 + r, arm32.R4, 4 * k)
		}
	}
	var n int = 0
	for off := 0; off + 4 <= a.Sections[0].Len; off = off + 4 {
		var w uint32 = word32(a, off)
		for i := 0; i < len(loads); i++ {
			if w == loads[i] { n = n + 1 }
		}
	}
	return n
}

// hfaArgCall emits a call of op (OP_CALL, or a variadic OP_C_CALL when variadic) with
// args of the given types, each a pointer / value spilled at 8 * its index.
func hfaArgCall(rm @common.RegMap, argTypes @[]@types.Type, variadic bool) @asm.Assembler {
	var args @[]@ir.Instr
	for i := 0; i < len(argTypes); i++ {
		addSpill(rm, 10 + i, 8 * i)
		args = appendInstrPtr_arm32calltest(args, floatArg(10 + i, argTypes[i]))
	}
	var ins @ir.Instr = voidCall(args)
	if variadic {
		ins.Op = iropcode.OP_C_CALL
		ins.StrVal = "f"
		ins.CVariadic = true
		ins.CFixedArgs = len(args)
	}
	var a @asm.Assembler = mkAsm()
	emitCall(a, "main", rm, ins)
	return a
}

// (f32, F2): the float32 takes s0 and the two-float32 HFA s1-s2, each member loaded
// from the argument's bytes (pointer reloaded into R4) — no core register written.
func TestHfaCallArgFloat32Members() testing.TestResult {
	oldArch, oldAbi := stampHard()
	var f2 @types.Type = hfaType("F2", types.TypFloat32(), 2)
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypFloat32()
	ts[1] = f2
	var a @asm.Assembler = hfaArgCall(hfaRm(), ts, false)
	restoreTarget(oldArch, oldAbi)
	if a.HasError { return fail("an HFA call arg must lower") }
	if !containsWord(a, vmovS(vfp.S0)) { return fail("the float32 must take s0") }
	if !containsWord(a, vldrWord(false, vfp.S1, arm32.R4, 0)) {
		return fail("F2.m0 must load into s1")
	}
	if !containsWord(a, vldrWord(false, vfp.S2, arm32.R4, 4)) {
		return fail("F2.m1 must load into s2")
	}
	return ""
}

// A non-variadic __c_call passes an HFA in VFP registers too: F2 alone takes s0-s1.
func TestHfaCCallArgFixed() testing.TestResult {
	oldArch, oldAbi := stampHard()
	var rm @common.RegMap = hfaRm()
	addSpill(rm, 10, 0)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, floatArg(10, hfaType("F2", types.TypFloat32(), 2)))
	var ins @ir.Instr = voidCall(args)
	ins.Op = iropcode.OP_C_CALL
	ins.StrVal = "f"
	ins.CFixedArgs = 1
	var a @asm.Assembler = mkAsm()
	emitCall(a, "main", rm, ins)
	restoreTarget(oldArch, oldAbi)
	if a.HasError { return fail("a fixed __c_call HFA arg must lower") }
	if !containsWord(a, vldrWord(false, vfp.S0, arm32.R4, 0)) ||
			!containsWord(a, vldrWord(false, vfp.S1, arm32.R4, 4)) {
		return fail("a fixed __c_call's F2 must take s0-s1")
	}
	return ""
}

// (f32, D2): the two-float64 HFA takes the lowest free D pair, d1-d2 (s0 holds the
// float32).
func TestHfaCallArgFloat64Members() testing.TestResult {
	oldArch, oldAbi := stampHard()
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypFloat32()
	ts[1] = hfaType("D2", types.TypFloat64(), 2)
	var a @asm.Assembler = hfaArgCall(hfaRm(), ts, false)
	restoreTarget(oldArch, oldAbi)
	if a.HasError { return fail("an HFA call arg must lower") }
	if !containsWord(a, vldrWord(true, vfp.D1, arm32.R4, 0)) {
		return fail("D2.m0 must load into d1")
	}
	if !containsWord(a, vldrWord(true, vfp.D2, arm32.R4, 8)) {
		return fail("D2.m1 must load into d2")
	}
	return ""
}

// (D4, D4, D2): the third HFA does not fit the bank, so it goes wholly to the stack —
// its four words stored to the outgoing area from offset 0 — and loads into no VFP
// register.
func TestHfaCallArgOverflowToStack() testing.TestResult {
	oldArch, oldAbi := stampHard()
	var d4 @types.Type = hfaType("D4", types.TypFloat64(), 4)
	var ts @[]@types.Type = make_slice(@types.Type, 3)
	ts[0] = d4
	ts[1] = d4
	ts[2] = hfaType("D2", types.TypFloat64(), 2)
	var a @asm.Assembler = hfaArgCall(hfaRm(), ts, false)
	restoreTarget(oldArch, oldAbi)
	if a.HasError { return fail("an overflowing HFA call arg must lower") }
	if !containsWord(a, vldrWord(true, vfp.D7, arm32.R4, 24)) {
		return fail("the second D4 must end in d7")
	}
	if vfpLoadCount(a) != 8 {
		return fail("only the two D4s' eight members may load into VFP registers")
	}
	var ref @asm.Assembler = mkAsm()
	emitFrameStore(ref, arm32.R5, 12)
	if !containsWord(a, word32(ref, 0)) {
		return fail("the third HFA's last word must go to [sp, #12]")
	}
	return ""
}

// In a variadic call an HFA follows the base standard: F2 rides r0-r1 and loads into
// no VFP register.
func TestHfaCallArgVariadicRidesGp() testing.TestResult {
	oldArch, oldAbi := stampHard()
	var ts @[]@types.Type = make_slice(@types.Type, 1)
	ts[0] = hfaType("F2", types.TypFloat32(), 2)
	var a @asm.Assembler = hfaArgCall(hfaRm(), ts, true)
	restoreTarget(oldArch, oldAbi)
	if a.HasError { return fail("a variadic HFA call arg must lower") }
	if !containsWord(a, ldrWord(arm32.R0, arm32.R4, 0)) ||
			!containsWord(a, ldrWord(arm32.R1, arm32.R4, 4)) {
		return fail("a variadic F2 must ride r0-r1")
	}
	if vfpLoadCount(a) != 0 { return fail("a variadic HFA must not load into VFP registers") }
	return ""
}

// With HfaAggregates off an HFA is a GP aggregate: F2 rides r0-r1.
func TestHfaCallArgOffRidesGp() testing.TestResult {
	oldArch, oldAbi := stampHard()
	var ts @[]@types.Type = make_slice(@types.Type, 1)
	ts[0] = hfaType("F2", types.TypFloat32(), 2)
	var a @asm.Assembler = hfaArgCall(hfaOffRm(), ts, false)
	restoreTarget(oldArch, oldAbi)
	if a.HasError { return fail("an HFA call arg must lower") }
	if !containsWord(a, ldrWord(arm32.R0, arm32.R4, 0)) {
		return fail("with HFAs off, F2 must ride r0-r1")
	}
	if vfpLoadCount(a) != 0 { return fail("with HFAs off, F2 must not load into VFP registers") }
	return ""
}

// An HFA param arriving in VFP registers is stored member by member into its data
// region: (f64, F3) puts F3 in s2-s4 (d0 holds the float64), stored at the region's
// offsets 0, 4, 8.
func TestHfaSpillParamStoresMembers() testing.TestResult {
	oldArch, oldAbi := stampHard()
	var rm @common.RegMap = hfaRm()
	addSpill(rm, 7, 32)
	addAllocArm32Hfa(rm, 7, 16, 12)
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypFloat64()
	ts[1] = hfaType("F3", types.TypFloat32(), 3)
	var p @ir.Param = floatParam(7, ts[1])
	var a @asm.Assembler = mkAsm()
	emitSpillParam(a, rm, p, ts, 1, 0)
	restoreTarget(oldArch, oldAbi)
	if a.HasError { return fail("an HFA param spill must lower") }
	for m := 0; m < 3; m++ {
		if !containsWord(a, vstrWord(false, vfp.S2 + m, arm32.SP, 16 + 4 * m)) {
			return fail("each F3 member must be stored from s2.. into the data region")
		}
	}
	var lea @asm.Assembler = mkAsm()
	emitFrameAddr(lea, arm32.R4, 16)
	emitFrameStore(lea, arm32.R4, 32)
	if !containsWord(a, word32(lea, 0)) || !containsWord(a, word32(lea, 4)) {
		return fail("the param's spill slot must get the data region's address")
	}
	return ""
}

// A data region past VSTR's 1020-byte reach is addressed through IP: F2.m1 of a param
// whose region is at offset 2000 is stored at [IP] after IP = SP + 2004.
func TestHfaSpillParamLargeOffset() testing.TestResult {
	oldArch, oldAbi := stampHard()
	var rm @common.RegMap = hfaRm()
	addSpill(rm, 7, 32)
	addAllocArm32Hfa(rm, 7, 2000, 8)
	var ts @[]@types.Type = make_slice(@types.Type, 1)
	ts[0] = hfaType("F2", types.TypFloat32(), 2)
	var a @asm.Assembler = mkAsm()
	emitSpillParam(a, rm, floatParam(7, ts[0]), ts, 0, 0)
	restoreTarget(oldArch, oldAbi)
	if a.HasError { return fail("an HFA param spill at a large offset must lower") }
	var ref @asm.Assembler = mkAsm()
	emitAddImm(ref, arm32.IP, arm32.SP, 2004, arm32.IP)
	if !containsWord(a, word32(ref, 0)) || !containsWord(a, vstrWord(false, vfp.S1, arm32.IP, 0)) {
		return fail("F2.m1 must be stored at [IP] with IP = SP + 2004")
	}
	return ""
}

// An HFA result is produced in d0.. (float64 members) from the result's bytes, and
// a call's HFA result is collected from s0.. into its data region.
func TestHfaReturnAndCollect() testing.TestResult {
	oldArch, oldAbi := stampHard()
	var d3 @types.Type = hfaType("D3", types.TypFloat64(), 3)
	var rm @common.RegMap = hfaRm()
	addSpill(rm, 4, 0)
	var res @ir.Instr = floatArg(4, d3)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, res)
	var ret @ir.Instr = make(ir.Instr)
	ret.Op = iropcode.OP_RETURN
	ret.Args = args
	var a @asm.Assembler = mkAsm()
	emitReturn(a, "main", rm, ret)
	var rc @common.RegMap = hfaRm()
	addAllocArm32Hfa(rc, 0, 8, 16)
	var c @asm.Assembler = mkAsm()
	emitCall(c, "main", rc, retCall(hfaType("F4", types.TypFloat32(), 4)))
	restoreTarget(oldArch, oldAbi)
	if a.HasError || c.HasError { return fail("an HFA return / collect must lower") }
	for m := 0; m < 3; m++ {
		if !containsWord(a, vldrWord(true, vfp.D0 + m, arm32.R4, 8 * m)) {
			return fail("each D3 member must load into d0..d2")
		}
	}
	for m := 0; m < 4; m++ {
		if !containsWord(c, vstrWord(false, vfp.S0 + m, arm32.SP, 8 + 4 * m)) {
			return fail("each F4 result member must be stored from s0..s3 into the data region")
		}
	}
	var lea @asm.Assembler = mkAsm()
	emitFrameAddr(lea, arm32.R4, 8)
	if !containsWord(c, word32(lea, 0)) {
		return fail("the call result must point at its data region")
	}
	return ""
}

// A 4-byte HFA result of a non-variadic call comes back in s0, not in r0 (where a
// 4-byte GP aggregate would).
func TestHfaCallReturnF1UsesS0() testing.TestResult {
	oldArch, oldAbi := stampHard()
	var rm @common.RegMap = hfaRm()
	addAllocArm32Hfa(rm, 0, 8, 4)
	var a @asm.Assembler = mkAsm()
	emitCall(a, "main", rm, retCall(hfaType("F1", types.TypFloat32(), 1)))
	restoreTarget(oldArch, oldAbi)
	if a.HasError { return fail("an F1-returning call must lower") }
	if !containsWord(a, vstrWord(false, vfp.S0, arm32.SP, 8)) {
		return fail("F1 must be stored from s0")
	}
	var ref @asm.Assembler = mkAsm()
	emitFrameStore(ref, arm32.R0, 8)
	if containsWord(a, word32(ref, 0)) { return fail("F1 must not be stored from r0") }
	return ""
}

// A variadic __c_call returning a 4-byte HFA follows the base standard: the result
// comes back in r0, not s0.
func TestHfaVariadicCallReturnUsesR0() testing.TestResult {
	oldArch, oldAbi := stampHard()
	var rm @common.RegMap = hfaRm()
	addAllocArm32Hfa(rm, 0, 8, 4)
	var ins @ir.Instr = retCall(hfaType("F1", types.TypFloat32(), 1))
	ins.Op = iropcode.OP_C_CALL
	ins.StrVal = "f"
	ins.CVariadic = true
	var a @asm.Assembler = mkAsm()
	emitCall(a, "main", rm, ins)
	restoreTarget(oldArch, oldAbi)
	if a.HasError { return fail("a variadic HFA-returning __c_call must lower") }
	var ref @asm.Assembler = mkAsm()
	emitFrameStore(ref, arm32.R0, 8)
	if !containsWord(a, word32(ref, 0)) {
		return fail("the variadic F1 result must be stored from r0")
	}
	if containsWord(a, vstrWord(false, vfp.S0, arm32.SP, 8)) {
		return fail("it must not come from s0")
	}
	return ""
}
