package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"

// ============================================================
// Interface-impl vtables (P4 — stubbed in the P2 skeleton)
// ============================================================
//
// Interface support (impl vtable emission, iface-value construction, method
// dispatch) is P4 work in plan-native-arm32.md.  The walking skeleton does
// not use interfaces, so this pass emits nothing.  It panics LOUDLY if the
// module defines any impl — a silent no-op there would drop a vtable that
// iface dispatch / the package descriptor references.

// emitImplVtables is the P4 impl-vtable pass; a no-op in the skeleton
// (panics if the module defines any impl).
func emitImplVtables(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	if len(mod.Impls) == 0 { return }
	panic("native arm32: impl vtables not implemented (P4); "
		"module defines an interface impl")
}
