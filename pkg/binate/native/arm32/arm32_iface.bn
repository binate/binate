package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/stdx/slices"

// ============================================================
// Interface-impl vtables + RTTI records (P4-c.1 — the DATA side)
// ============================================================
//
// Mirrors the LLVM lowering in pkg/binate/codegen/emit_impls.bn and the
// aarch64 backend (pkg/binate/native/aarch64/aarch64_iface.bn): each
// `impl R : I` declaration produces one `__ivt.<...>` global containing
// [dtor, *TypeInfo, m1, m2, ...] pointers (parent sub-vtables inlined for
// extended interfaces), a parallel `__ivtshim.<...>` whose method slots hold
// the method HANDLES (for bytecode-VM dispatch of injected native packages),
// and the per-type / per-iface / per-(type,iface) RTTI records emitted by
// arm32_typeinfo.bn.  Method DISPATCH (OP_IFACE_VALUE, OP_CALL_IFACE_METHOD,
// OP_IFACE_UPCAST, OP_IFACE_DTOR) is P4-c.2/.3/.4 and still fails loud in the
// dispatch tail — this pass only emits the data so a module with impls LINKS
// its vtables.
//
// The slot byte layout is laid by the SHARED ir.BuildImplVtable (each slot is
// one target word — `types.GetTarget().IntSize`, 4 bytes on this ILP32 target,
// vs 8 on aarch64/x64), so it cannot drift from the LLVM backend that arm32
// native main links against.  Do NOT reorder the slots here.

// emitImplVtables emits one `__ivt.<...>` constant for each (impl, iface) pair
// the module defines, plus the parallel `__ivtshim.<...>` shim vtable and the
// TypeInfo / IfaceId / satisfaction-entry RTTI records.  Layout matches the
// LLVM backend's emit_impls.bn and aarch64_iface.bn:
//   slot 0:        dtor HANDLE pointer (or 0 if the type has no dtor)
//   slot 1:        *TypeInfo (RTTI; §7.13.8 / §7.13.14)
//   slots 2..N+1:  method pointers in interface-declaration order (parent
//                  sub-vtables inlined for an extended interface)
// Each slot is one target word (4 bytes on ILP32); a symref term becomes a
// word-sized absolute relocation the linker fixes up.
//
// The vtables live in the relocatable-read-only section (rodata_relro → ELF
// `.data.rel.ro`) with global visibility so cross-TU OP_IFACE_VALUE sites can
// reach them through a single shared symbol.
func emitImplVtables(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	if len(mod.Impls) == 0 { return }
	for i := 0; i < len(mod.Impls); i++ {
		var info @ir.ImplInfo = mod.Impls[i]
		if info == nil { continue }
		// Generic-impl instantiations re-lower at the bytecode importer and are
		// not yet supported on this backend; fail LOUD rather than emit a wrong
		// / partial vtable (a silent-miscompile at the cross-TU link boundary).
		// See plan-native-arm32.md P4-c (non-generic only for now).
		if common.RecvTypeIsGenericInst(info.RecvTypeName) {
			a.SetError(
					"native arm32: generic-impl vtable emission not implemented "
							"(P4-c is non-generic only); see plan-native-arm32.md")
			return
		}
		emitOneImplVtable(a, pkgName, mod, info)
		// Parallel shim vtable (method slots hold @__handle handles) so the
		// bytecode VM can dispatch this package's iface methods through their
		// marshaling shims when the package is injected native-only.
		emitOneImplShimVtable(a, pkgName, mod, info)
	}
	emitTypeInfosNative(a, pkgName, mod)
	emitIfaceIdsNative(a, mod)
	emitSatEntriesNative(a, mod)
}

// dtorSlotSymNative returns the destructor-handle slot symbol for receiver dtor
// `dtorName` — the object-format-prefixed `__handle.<dtor>` — or empty (a null
// slot) when the type needs no destruction (empty name) or the dtor is not
// present in this module.  Used for BOTH the vtable any-block slot 0 and the
// TypeInfo record's word 0, so the two agree by construction.
func dtorSlotSymNative(pkgName *[]readonly char, mod @ir.Module,
		dtorName *[]readonly char) @[]char {
	var none @[]char
	if len(dtorName) == 0 { return none }
	if lookupModuleFunc(mod, dtorName) == nil { return none }
	return handleSymFor(pkgName, dtorName)
}

// emitOneImplVtable writes a single __ivt.<...> array of pointers with the
// concat-recursive layout from plan-interface-embedding.md Slice E.3:
//   slots 0-1:               R's any-block (dtor, then *TypeInfo)
//   per parent P, recursively: full vtable of (R, P)
//   per own method m:         R's mangled <m> function pointer
// For non-extending interfaces this collapses to [dtor, *TypeInfo, m1, m2, ...]
// — the original Slice 2.5 layout.  The recursion supports Slice E.4 upcasts:
// `*Child → *Parent` becomes a pointer +offset that lands at the parent's
// any-block, where the parent-typed dispatch path expects to find a dtor + the
// parent's full layout.
func emitOneImplVtable(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module,
		info @ir.ImplInfo) {
	var slots @[]@[]char = collectImplVtableSlotsNative(pkgName, mod, info, info.IfacePkg,
			info.IfaceName, false)
	markImplSlotsGlobalNative(a, slots)
	common.EmitDataGlobal(a, ir.BuildImplVtable(implVtableNameNative(info), slots))
}

// emitOneImplShimVtable writes the parallel `__ivtshim.<...>` array for an
// (R, I) impl: the same byte-identical slot layout as emitOneImplVtable, but
// each METHOD slot holds the method's function-value HANDLE
// (`@__handle.<mangled>`, the same form the dtor slot already uses) instead of
// the raw method fn.  The bytecode VM resolves this from the raw `@__ivt`
// address (descriptor's VtableInfo.ShimAddr) and dispatches an injected native-
// only package's iface methods through the handle's marshaling shim, so it
// never replicates the native arg/return ABI.  Mirrors
// pkg/binate/codegen/emit_impls.bn:emitImplShimVtable.
func emitOneImplShimVtable(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module,
		info @ir.ImplInfo) {
	var slots @[]@[]char = collectImplVtableSlotsNative(pkgName, mod, info, info.IfacePkg,
			info.IfaceName, true)
	markImplSlotsGlobalNative(a, slots)
	common.EmitDataGlobal(a, ir.BuildImplVtable(implShimVtableNameNative(info), slots))
}

// collectImplVtableSlotsNative returns the ordered slot symbols for one (R, X)
// sub-block of the recursive layout: dtor, then each parent's nested layout
// (inline), then X's own methods on R.  Mirrors the aarch64 / x64 backends and
// the LLVM collectImplVtableSlots.  An empty slot symbol is a null pointer;
// ir.BuildImplVtable lays the bytes.
//
// useHandles=false gives the raw `@__ivt` layout (method slots hold the raw
// method fn symbol); useHandles=true gives the parallel `@__ivtshim` layout
// (method slots hold the method's `@__handle`), threaded through the parent
// recursion so every nested sub-block uses the same form.
func collectImplVtableSlotsNative(pkgName *[]readonly char, mod @ir.Module, info @ir.ImplInfo,
		ifacePkg *[]readonly char, ifaceName *[]readonly char, useHandles bool) @[]@[]char {
	var slots @[]@[]char
	// Slot 0: dtor HANDLE pointer (or empty = null).  _call_dtor (invoked by
	// ZeroRefDestroy) lowers as OP_CALL_HANDLE and expects a BnFuncValue handle,
	// not a raw fn pointer (binate dc46ac7f; conformance/520).
	slots = slices.Append[@[]char](slots, dtorSlotSymNative(pkgName, mod, info.DtorFuncName))
	// Slot 1: the concrete type's *TypeInfo (two-word any-block, RTTI —
	// spec §7.13.8/§7.13.14) — the `__typeinfo.<T>` record emitted weak by
	// emitTypeInfosNative.  Keyed on the receiver type so every nested
	// sub-vtable carries the SAME leaf-type record.
	var typeInfoSlot @[]char = symPrefixed(
			mangle.TypeInfoName(info.RecvPkg, info.RecvTypeName))
	slots = slices.Append[@[]char](slots, typeInfoSlot)
	var parentPkgs @[]@[]char = ir.IfaceParentPkgs(mod, ifacePkg, ifaceName)
	var parentNames @[]@[]char = ir.IfaceParentNames(mod, ifacePkg, ifaceName)
	for i := 0; i < len(parentPkgs); i++ {
		var ps @[]@[]char = collectImplVtableSlotsNative(pkgName, mod, info, parentPkgs[i],
				parentNames[i], useHandles)
		for j := 0; j < len(ps); j++ {
			slots = slices.Append[@[]char](slots, ps[j])
		}
	}
	// X's own methods on R, in interface-declaration order.  The slot is the
	// iv-dispatch thunk for value-receiver methods (LookupVtableSlotName) —
	// without it a `*Iface`-reached value-receiver impl reads the iv-data
	// pointer as the receiver value (conformance 410_iface_value_recv_dispatch).
	var ownMethods @[]@[]char = ir.IfaceOwnMethodNames(mod, ifacePkg, ifaceName)
	for mi := 0; mi < len(ownMethods); mi++ {
		var qualified @[]char = buildMethodFuncNameNative(info.RecvPkg, info.RecvTypeName, ownMethods[mi])
		var slotName @[]char = ir.LookupVtableSlotName(mod, qualified)
		var mLabel @[]char = symFor(pkgName, slotName)
		if useHandles {
			mLabel = handleSymFor(pkgName, slotName)
		}
		slots = slices.Append[@[]char](slots, mLabel)
	}
	return slots
}

// markImplSlotsGlobalNative marks each non-empty slot target (a dtor handle / a
// method fn or handle) global so its relocation resolves; a null slot needs no
// symbol.
func markImplSlotsGlobalNative(a @asm.Assembler, slots @[]@[]char) {
	for i := 0; i < len(slots); i++ {
		if len(slots[i]) > 0 {
			a.SetGlobal(slots[i])
		}
	}
}

// implVtableNameNative builds the bare ELF symbol for an (R, I) impl vtable via
// mangle.ImplVtableName (the single source of truth shared with IR-gen / codegen
// / VM).  symPrefixed is the identity on ELF, so the emitted symbol is exactly
// the `__ivt.bn_V...` core — byte-identical to the LLVM backend's cross-TU
// reference.
func implVtableNameNative(info @ir.ImplInfo) @[]char {
	return symPrefixed(
			mangle.ImplVtableName(info.RecvPkg, info.RecvTypeName, info.IfacePkg, info.IfaceName))
}

// implShimVtableNameNative builds the bare ELF symbol for an (R, I) impl's
// parallel shim vtable via mangle.ImplVtableShimName, so the descriptor's
// ShimAddr fixup names exactly the symbol this backend defines and the
// cross-mode VM lookup matches.
func implShimVtableNameNative(info @ir.ImplInfo) @[]char {
	return symPrefixed(
			mangle.ImplVtableShimName(info.RecvPkg, info.RecvTypeName, info.IfacePkg, info.IfaceName))
}

// buildMethodFuncNameNative mirrors the LLVM
// emit_impls.bn:buildMethodFuncName — `<recvPkg>.<recvName>.<methodName>`.
// Duplicated here so the native path doesn't reach into pkg/binate/codegen.
func buildMethodFuncNameNative(recvPkg *[]readonly char, recvName *[]readonly char,
		methodName *[]readonly char) @[]char {
	var b @[]char
	b = common.AppendStr(b, recvPkg)
	b = common.AppendStr(b, ".")
	b = common.AppendStr(b, recvName)
	b = common.AppendStr(b, ".")
	b = common.AppendStr(b, methodName)
	return b
}

// lookupModuleFunc returns the ir.Func with the given canonical name in
// mod.Funcs, or nil if absent.  Used by the vtable dtor slot to fall back to a
// null pointer when the dtor function wasn't emitted in this translation unit
// (e.g. the receiver has no managed fields).
func lookupModuleFunc(mod @ir.Module, name *[]readonly char) @ir.Func {
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f == nil { continue }
		if charEqIface(f.Name, name) { return f }
	}
	return nil
}

// charEqIface is a local byte-compare for char slices, kept inside this file so
// the iface module stays self-contained.
func charEqIface(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// ============================================================
// Interface-VALUE construction — emitIfaceValue, emitIfaceUpcast (P4-c.2)
// ============================================================
//
// The pure construction ops: build / rebuild the two-word {data, vtable}
// interface value in the instruction's pre-allocated alloc region.  Method
// DISPATCH (OP_CALL_IFACE_METHOD) and the @Iface scope-exit dtor load
// (OP_IFACE_DTOR) are P4-c.3/.4 and still fail loud in the dispatch tail.
//
// The two-word layout is the SHARED types-layer contract (IfaceValueDataOffset =
// 0, IfaceValueVtableOffset = ptrSize() = 4 on this ILP32 target) so it matches
// the LLVM backend an arm32-native main links against — do NOT hardcode 8.

// emitIfaceValue lowers OP_IFACE_VALUE — interface-value construction.  Builds
// the two-word {data, vtable} aggregate (8 bytes on ILP32) in the instruction's
// pre-allocated data region (PlanFrame reserved it): the data pointer at
// IfaceValueDataOffset (0), and the vtable global's address at
// IfaceValueVtableOffset (ptrSize() = 4).  StrVal is the mangled vtable symbol
// (e.g. `__ivt.bn_V...`) emitImplVtables emits; Args[0] is the data pointer.  The
// result is a pointer to the data region.  Mirrors aarch64_dispatch.bn's
// OP_IFACE_VALUE arm with WordBytes = 4 and MOVW/MOVT-ABS (no ADRP) address
// materialization.
func emitIfaceValue(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.StrVal) == 0 || len(ins.Args) < 1 { return }
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	var ivtLabel @[]char = symPrefixed(ins.StrVal)
	// Data ptr -> slot 0.  Read the source register BEFORE allocating scratch
	// regs so the regmap doesn't recycle it.  A package-global data ptr (`&g`)
	// is a pseudo-instr with no register (ID -1); materialize its address via
	// MOVW/MOVT (emitGlobalAddr) — otherwise getOperand returns < 0 and the whole
	// construction is silently dropped (cf. the aa64 global-ref path).
	var dataReg int
	if isGlobalRef(ins.Args[0]) {
		dataReg = scratchReg(rm)
		emitGlobalAddr(a, pkgName, dataReg, ins.Args[0])
	} else {
		dataReg = getOperand(a, rm, ins.Args[0].ID)
		if dataReg < 0 { return }
	}
	emitBaseStore(a, dataReg, arm32.SP, dataOff + types.IfaceValueDataOffset(), arm32.IP)
	// Vtable address -> slot 1.  emitSymAddr marks the symbol global and emits the
	// MOVW/MOVT-ABS reloc pair (arm32's ADRP+ADD analog).
	var vtTmp int = scratchReg(rm)
	emitSymAddr(a, vtTmp, ivtLabel)
	emitBaseStore(a, vtTmp, arm32.SP, dataOff + types.IfaceValueVtableOffset(), arm32.IP)
	// Produce the data-region pointer as the result.
	var rd int = nextReg(rm, ins.ID)
	emitFrameAddr(a, rd, dataOff)
}

// emitIfaceUpcast lowers OP_IFACE_UPCAST — rebuild an interface value with the
// source's data pointer and a vtable pointer adjusted to land at the target's
// nested sub-vtable within the source's concat-laid-out vtable.  The slot offset
// is statically known per (srcIface, targetIface) pair, precomputed on the instr
// at IR-gen time (EmitIfaceUpcast); byte offset = offsetSlots * wordBytes() (each
// vtable slot is one target word = 4 bytes on ILP32, matching the LLVM GEP over
// i8* elements).  Mirrors aarch64_dispatch.bn's OP_IFACE_UPCAST pointer
// arithmetic with WordBytes = 4.
//
// An INVALID upcast (offsetSlots < 0 — target is not an ancestor of source; the
// checker should never produce this) fails LOUD via a.SetError, per this
// backend's fail-loud discipline: adjusting the vtable by a negative slot would
// walk the pointer one slot BEFORE its base (silent vtable corruption / SIGSEGV).
// (aa64 panics here; arm32 SetErrors so EmitObject returns false and bnc reports
// a compile error rather than aborting the compiler.)
func emitIfaceUpcast(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	var srcPtr int = getOperand(a, rm, ins.Args[0].ID)
	if srcPtr < 0 { return }
	var offsetSlots int = ins.IfaceUpcastSlotOffset
	if offsetSlots < 0 {
		a.SetError(
				"native arm32: invalid iface upcast (negative vtable slot offset — "
						"target not an ancestor of source)")
		return
	}
	var byteOff int = offsetSlots * wordBytes()
	// Data ptr copies straight through: load iv.data (offset 0) from the source,
	// store it into the result region's data slot.
	var dataTmp int = scratchReg(rm)
	arm32.Ldr(a, arm32.COND_AL, dataTmp, arm32.MemImm(srcPtr, types.IfaceValueDataOffset()))
	emitBaseStore(a, dataTmp, arm32.SP, dataOff + types.IfaceValueDataOffset(), arm32.IP)
	// New vtable ptr = source.vtable + byteOff.
	var vtTmp int = scratchReg(rm)
	arm32.Ldr(a, arm32.COND_AL, vtTmp, arm32.MemImm(srcPtr, types.IfaceValueVtableOffset()))
	if byteOff > 0 {
		emitAddImm(a, vtTmp, vtTmp, byteOff, arm32.IP)
	}
	emitBaseStore(a, vtTmp, arm32.SP, dataOff + types.IfaceValueVtableOffset(), arm32.IP)
	// Produce the data-region pointer as the result.
	var rd int = nextReg(rm, ins.ID)
	emitFrameAddr(a, rd, dataOff)
}

// ============================================================
// Interface method DISPATCH — emitCallIfaceMethod (P4-c.3)
// ============================================================
//
// Loads the method pointer from the interface value's vtable and calls it
// indirectly (BLX IP), passing the iv's data pointer as the receiver.  Ported
// from x64_iface.bn (the [sret, data, args...] 2-slot-prefix model), NOT the
// aa64 X8-sret one-slot model: AAPCS32 carries the sret pointer in a GP arg
// register (R0), so a big return prepends TWO synthetic slots (sret + data)
// ahead of the user args — matching common_call.bn's OP_CALL_IFACE_METHOD sizer,
// which sets prefixSlots=2 exactly when `bigRet && SretInGpArgReg` (AAPCS32 sets
// SretInGpArgReg=true).  The caller-side prefix MUST match that reservation or a
// big-return iface call silently miscompiles.

// emitCallIfaceMethod lowers OP_CALL_IFACE_METHOD.  Args[0] is the iv value (an
// 8-byte {data, vtable} aggregate held at the alloc region getOperand points at,
// ILP32); Args[1..] are user args; ins.Index is the ABSOLUTE vtable slot (already
// past the two-word any-block — dtor@0, *TypeInfo@1 — and any parent sub-vtable
// inlining) — see pkg/binate/ir/gen_iface.bn:findInterfaceMethodFromBase and the
// LLVM emission in pkg/binate/codegen/emit_impls.bn.  It is dispatched raw as
// `Index * wordBytes()`, no +2.
//
// Unlike aa64 (which holds the method pointer live in X17 across the arg loop),
// arm32's only intra-call scratch is IP (R12), which emitAggregateArg /
// emitFrameAddr clobber — so the loaded method pointer is SPILLED to a stack slot
// before the arg loop and RELOADED into IP just before BLX (the same spill/reload
// discipline emitCallIndirect / emitCallFuncValue use).  The spill must bracket
// the ENTIRE arg loop, or the call jumps through garbage.
//
// Scalar / void / single-aggregate (sret) / multi-return results are all in scope
// (collected via the shared emitCallReturn-style paths below).  A float
// arg/return (P5 soft-float) and a 64-bit-pair arg fail LOUDLY via emitCallArg;
// an int64/float64 field INSIDE a multi-return tuple (ILP32 even-aligned-pair
// placement, deferred per P4-b2) fails LOUDLY via storeMultiReturnTupleFieldsArm32.
func emitCallIfaceMethod(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		allFuncs @[]@ir.Func, ins @ir.Instr) {
	if len(ins.Args) < 1 {
		a.SetError("native arm32: iface dispatch with no interface value (P4-c.3)")
		return
	}

	// Two-step load of the method pointer into IP:
	//   IP = iv.vtable     (LDR IP, [ivAddr + IfaceValueVtableOffset()])
	//   IP = vt[Index]     (LDR IP, [IP + Index * wordBytes()])
	// wordBytes() = 4 on this ILP32 target (each vtable slot is one target word),
	// NOT the literal 8 the LP64 backends use.
	var ivAddr int = getOperand(a, rm, ins.Args[0].ID)
	if ivAddr < 0 {
		a.SetError("native arm32: iface value not materializable (P4-c.3)")
		return
	}
	arm32.Ldr(a, arm32.COND_AL, arm32.IP, arm32.MemImm(ivAddr, types.IfaceValueVtableOffset()))
	arm32.Ldr(a, arm32.COND_AL, arm32.IP, arm32.MemImm(arm32.IP, wordBytes() * ins.Index))

	// Spill the loaded method pointer immediately: the arg loop below freely calls
	// getOperand / ResetRegs and emitAggregateArg / emitFrameAddr clobber IP, so it
	// CANNOT be held live.  Reload just before BLX.  Prefer the result spill slot;
	// fall back to the alloc region when the call has no result slot (void return —
	// PlanFrame always reserves an alloc region for an iface call, since the iv
	// receiver is an aggregate).  This mirrors x64_iface.bn's fnPtrSlot stash.
	var fnPtrSlot int = -1
	if ins.ID >= 0 {
		fnPtrSlot = rm.LookupSpill(ins.ID)
	}
	if fnPtrSlot < 0 {
		fnPtrSlot = rm.LookupAlloc(ins.ID)
	}
	if fnPtrSlot < 0 {
		a.SetError("native arm32: iface dispatch has no spill slot for the method "
				"pointer (P4-c.3)")
		return
	}
	// Spill via a POOL reg, not IP: for a large frame (fnPtrSlot > 4095)
	// emitFrameStore uses IP as its own address scratch — storing IP directly would
	// overwrite the method pointer with the materialized offset and spill garbage
	// (silent wrong-code: the later BLX would branch through the offset). A pool reg
	// (R4-R10) never aliases IP/SP, so the spill is correct at any frame size.
	var fnPtrReg int = scratchReg(rm)
	arm32.Mov(a, arm32.COND_AL, false, fnPtrReg, arm32.Reg(arm32.IP))
	emitFrameStore(a, fnPtrReg, fnPtrSlot)

	// A big-aggregate single return OR a big multi-return tuple travels via AAPCS32
	// sret (a hidden buffer pointer in R0), which shifts the data receiver and all
	// user args up one register — so prepend a SECOND synthetic pointer slot ahead
	// of the data slot.  This is the x64 [sret, data, args...] shape; SretInGpArgReg
	// is true on AAPCS32, so it matches common_call.bn's OP_CALL_IFACE_METHOD sizer
	// (prefixSlots = 2 when bigRet && SretInGpArgReg).  A small return uses
	// prefixSlots = 1 (just the data slot).
	var bigMultiRet bool = ins.ID >= 0 && rm.CC.CallReturnsBigMultiReturn(ins)
	var bigRet bool = ins.ID >= 0 && (rm.CC.CallReturnsBigAggregate(ins) || bigMultiRet)
	var prefixSlots int = 1
	if bigRet { prefixSlots = 2 }

	// Synthetic argTypes: prefixSlots leading pointer slots (sret + data, or just
	// data), then the user args.  Going through the classifier keeps the ILP32
	// even-align pad correct for a following int64-pair user arg.
	var nCallArgs int = len(ins.Args) - 1
	var argTypes @[]@types.Type = make_slice(@types.Type, nCallArgs + prefixSlots)
	for p := 0; p < prefixSlots; p++ {
		argTypes[p] = types.MakePointerType(types.TypUint8())
	}
	for i := 0; i < nCallArgs; i++ {
		argTypes[i + prefixSlots] = ins.Args[i + 1].Typ
	}

	// Marshal user args via the shared AAPCS32 path (emitCallArg handles scalar /
	// pointer / aggregate / global-ref, and fail-louds a float or 64-bit-pair arg).
	// User arg ai lands at dispatch slot ai + prefixSlots (the prefix takes the
	// leading register slots).  Per-arg ResetRegs keeps the (tight) R4..R10 scratch
	// pool from saturating on a long arg list.
	for ai := 0; ai < nCallArgs; ai++ {
		emitCallArg(a, pkgName, rm, argTypes, ins.Args[ai + 1], ai + prefixSlots)
		if a.HasError { return }
		rm.ResetRegs()
	}

	// Reload the iv pointer — the arg loop's ResetRegs may have stranded it — then
	// load the data (receiver) pointer into its AAPCS32 register.  Without sret the
	// data slot is R0 (slot 0); with sret it is R1 (slot 1; sret takes R0).
	// emitFrameAddr uses IP as its scratch, so do the data load BEFORE loading the
	// call target into IP below.
	ivAddr = getOperand(a, rm, ins.Args[0].ID)
	if ivAddr < 0 {
		a.SetError("native arm32: iface value not reloadable after arg loop (P4-c.3)")
		return
	}
	arm32.Ldr(a, arm32.COND_AL, argReg(prefixSlots - 1),
			arm32.MemImm(ivAddr, types.IfaceValueDataOffset()))

	// AAPCS32 sret: materialize &returnBuffer into R0 (the hidden sret pointer the
	// callee writes through).  A big multi-return tuple lands in the result spill
	// slot (PlanFrame sized it to the full tuple); a single big aggregate lands in
	// the alloc data region.  This is the R0 analogue of x64's `Lea RDI, [RSP+off]`.
	if bigRet {
		var sretOff int = -1
		if bigMultiRet {
			sretOff = rm.LookupSpill(ins.ID)
		} else {
			sretOff = rm.LookupAlloc(ins.ID)
		}
		if sretOff >= 0 {
			emitFrameAddr(a, arm32.R0, sretOff)
		}
	}

	// Reload the method pointer from its spill slot into IP as the LAST step, then
	// BLX IP.  (emitFrameAddr / the data load above clobbered IP.)
	emitFrameLoad(a, arm32.IP, fnPtrSlot)
	arm32.Blx(a, arm32.COND_AL, arm32.IP)

	// BLX clobbers R0-R3 and IP.  Reset the pool, then collect the return value(s).
	rm.ResetRegs()
	if ins.ID < 0 { return }

	// Single-aggregate return: a big aggregate came back via AAPCS32 sret (the
	// callee wrote through the R0 buffer into the alloc data region — nothing to
	// store); a small (<=InternalSretBytes) aggregate came back BY VALUE in R0
	// (store it into the data region first).  Either way, produce the data-region
	// pointer.  Mirrors emitCallReturn's aggregate arm and x64's post-CALL agg path.
	if ins.Typ != nil && common.IsAggregateTyp(ins.Typ) && !common.IsMultiReturnCall(ins) {
		var dataOff int = rm.LookupAlloc(ins.ID)
		if dataOff < 0 { return }
		if !bigRet {
			emitFrameStore(a, arm32.R0, dataOff)
		}
		var rd int = nextReg(rm, ins.ID)
		emitFrameAddr(a, rd, dataOff)
		return
	}
	if ins.Typ != nil && ins.Typ.Kind == types.TYP_VOID { return }

	var spillOff int = rm.LookupSpill(ins.ID)
	if spillOff < 0 { return }
	// Multi-return tuple: a big tuple was already written through the R0 sret buffer
	// into this spill slot (nothing to collect); a small tuple comes back field-per-
	// register in r0..r3, collected by the SHARED collectMultiReturnFields (which
	// delegates to storeMultiReturnTupleFieldsArm32 — the same store the direct /
	// func-value collect and the func-value shim use, so the field layout cannot
	// drift from arm32_return.bn's pack/sret side).
	if common.IsMultiReturnCall(ins) {
		if bigMultiRet { return }
		collectMultiReturnFields(a, rm, ins, spillOff)
		return
	}
	// A float scalar return fails LOUDLY (P5 soft-float).
	if common.IsFloatScalarTyp(ins.Typ) {
		a.SetError("native arm32: iface dispatch with float return not implemented (P5)")
		return
	}
	// A 64-bit-pair scalar return comes back in r0:r1; store both words.  Every
	// other scalar / pointer returns in R0.
	if isReg64Scalar(ins.Typ) {
		emitFrameStore(a, arm32.R0, spillOff)
		emitFrameStore(a, arm32.R1, spillOff + 4)
		return
	}
	emitFrameStore(a, arm32.R0, spillOff)
}
