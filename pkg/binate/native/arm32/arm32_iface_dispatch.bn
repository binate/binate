package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Interface method-value DISPATCH (the runtime side of P4-c)
// ============================================================
//
// The RUNTIME lowering of interface ops: value construction (OP_IFACE_VALUE /
// OP_IFACE_UPCAST), method dispatch (OP_CALL_IFACE_METHOD), and the scope-exit
// dtor load (OP_IFACE_DTOR).  The DATA side — the `__ivt` / `__ivtshim` vtables
// and the TypeInfo / IfaceId / satisfaction RTTI records these dispatch through —
// lives in arm32_iface.bn.  Split out from that file so neither exceeds the .bn
// length cap.
// ============================================================
// Interface-VALUE construction — emitIfaceValue, emitIfaceUpcast (P4-c.2)
// ============================================================
//
// The pure construction ops: build / rebuild the two-word {data, vtable}
// interface value in the instruction's pre-allocated alloc region.  Method
// DISPATCH (OP_CALL_IFACE_METHOD, P4-c.3) and the @Iface scope-exit dtor load
// (OP_IFACE_DTOR, P4-c.4) are lowered further down this file.
//
// The two-word layout is the SHARED types-layer contract (IfaceValueDataOffset =
// 0, IfaceValueVtableOffset = ptrSize() = 4 on this ILP32 target) so it matches
// the LLVM backend an arm32-native main links against — do NOT hardcode 8.

// emitIfaceValue lowers OP_IFACE_VALUE — interface-value construction.  Builds
// the two-word {data, vtable} aggregate (8 bytes on ILP32) in the instruction's
// pre-allocated data region (PlanFrame reserved it): the data pointer at
// IfaceValueDataOffset (0), and the vtable global's address at
// IfaceValueVtableOffset (ptrSize() = 4).  StrVal is the mangled vtable symbol
// (e.g. `__ivt.bn_V...`) emitImplVtables emits; Args[0] is the data pointer.  The
// result is a pointer to the data region.  Mirrors aarch64_dispatch.bn's
// OP_IFACE_VALUE arm with WordBytes = 4 and MOVW/MOVT-ABS (no ADRP) address
// materialization.
func emitIfaceValue(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	// STATIC form (StrVal non-empty): the vtable address is the MOVW/MOVT-ABS
	// pair of the __ivt symbol.  DYNAMIC form (StrVal empty): the vtable is a
	// RUNTIME value in Args[1]'s register (interface-assertion recovery, RTTI
	// Slice 5), so no symbol / SetGlobal / emitSymAddr.
	var dynamic bool = len(ins.StrVal) == 0
	if len(ins.Args) < 1 { return } // data always required
	if dynamic && len(ins.Args) < 2 { return } // dynamic needs the vtable reg
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	// Fetch BOTH operands (data, and dynamic-only the vtable) BEFORE allocating
	// any scratch/result reg so the regmap does not recycle them.  A package-
	// global data ptr (`&g`) is a pseudo-instr with no register (ID -1);
	// materialize its address via MOVW/MOVT (emitGlobalAddr), otherwise
	// getOperand returns < 0 and the whole construction is silently dropped
	// (cf. the aa64 global-ref path).
	var dataReg int
	if isGlobalRef(ins.Args[0]) {
		dataReg = scratchReg(rm)
		emitGlobalAddr(a, pkgName, dataReg, ins.Args[0])
	} else {
		dataReg = getOperand(a, rm, ins.Args[0].ID)
		if dataReg < 0 { return }
	}
	// Dynamic: read the vtable register HERE, so both operands are in hand
	// before any scratch/result reg is taken.
	var vtReg int = -1
	if dynamic {
		vtReg = getOperand(a, rm, ins.Args[1].ID)
		if vtReg < 0 { return }
	}
	// Data ptr -> slot 0.  (Emitted before the static vtable materialization
	// so the static path's instruction sequence is unchanged.)
	emitBaseStore(a, dataReg, arm32.SP, dataOff + types.IfaceValueDataOffset(), arm32.IP)
	// Vtable -> slot 1.  Static: a scratch holding the MOVW/MOVT-ABS reloc
	// pair (emitSymAddr, arm32's ADRP+ADD analog) of the __ivt symbol.
	// Dynamic: the register fetched above.
	var vtTmp int = vtReg
	if !dynamic {
		var ivtLabel @[]char = symPrefixed(ins.StrVal)
		vtTmp = scratchReg(rm)
		emitSymAddr(a, vtTmp, ivtLabel)
	}
	emitBaseStore(a, vtTmp, arm32.SP, dataOff + types.IfaceValueVtableOffset(), arm32.IP)
	// Produce the data-region pointer as the result.
	var rd int = nextReg(rm, ins.ID)
	emitFrameAddr(a, rd, dataOff)
}

// emitIfaceUpcast lowers OP_IFACE_UPCAST — rebuild an interface value with the
// source's data pointer and a vtable pointer adjusted to land at the target's
// nested sub-vtable within the source's concat-laid-out vtable.  The slot offset
// is statically known per (srcIface, targetIface) pair, precomputed on the instr
// at IR-gen time (EmitIfaceUpcast); byte offset = offsetSlots * wordBytes() (each
// vtable slot is one target word = 4 bytes on ILP32, matching the LLVM GEP over
// i8* elements).  Mirrors aarch64_dispatch.bn's OP_IFACE_UPCAST pointer
// arithmetic with WordBytes = 4.
//
// An INVALID upcast (offsetSlots < 0 — target is not an ancestor of source; the
// checker should never produce this) fails LOUD via a.SetError, per this
// backend's fail-loud discipline: adjusting the vtable by a negative slot would
// walk the pointer one slot BEFORE its base (silent vtable corruption / SIGSEGV).
// (aa64 panics here; arm32 SetErrors so EmitObject returns false and bnc reports
// a compile error rather than aborting the compiler.)
func emitIfaceUpcast(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	var srcPtr int = getOperand(a, rm, ins.Args[0].ID)
	if srcPtr < 0 { return }
	var offsetSlots int = ins.IfaceUpcastSlotOffset
	if offsetSlots < 0 {
		a.SetError(
				"native arm32: invalid iface upcast (negative vtable slot offset — "
						"target not an ancestor of source)")
		return
	}
	var byteOff int = offsetSlots * wordBytes()
	// Data ptr copies straight through: load iv.data (offset 0) from the source,
	// store it into the result region's data slot.
	var dataTmp int = scratchReg(rm)
	arm32.Ldr(a, arm32.COND_AL, dataTmp, arm32.MemImm(srcPtr, types.IfaceValueDataOffset()))
	emitBaseStore(a, dataTmp, arm32.SP, dataOff + types.IfaceValueDataOffset(), arm32.IP)
	// New vtable ptr = source.vtable + byteOff.
	var vtTmp int = scratchReg(rm)
	arm32.Ldr(a, arm32.COND_AL, vtTmp, arm32.MemImm(srcPtr, types.IfaceValueVtableOffset()))
	if byteOff > 0 {
		emitAddImm(a, vtTmp, vtTmp, byteOff, arm32.IP)
	}
	emitBaseStore(a, vtTmp, arm32.SP, dataOff + types.IfaceValueVtableOffset(), arm32.IP)
	// Produce the data-region pointer as the result.
	var rd int = nextReg(rm, ins.ID)
	emitFrameAddr(a, rd, dataOff)
}

// ============================================================
// Interface method DISPATCH — emitCallIfaceMethod (P4-c.3)
// ============================================================
//
// Every @__ivt method slot holds the method's function-value HANDLE
// (@__handle.<m>, emitOneImplVtable useHandles=true) — the same convention slot 0
// (the dtor) already uses — so interface dispatch goes THROUGH the handle's
// marshaling shim, exactly like OP_CALL_FUNC_VALUE.  That is what lets a native-
// emitted iface dispatch reach an impl whose @__ivt was emitted by ANOTHER backend
// (the hybrid native-main / LLVM-dep build): both sides agree on the handle+shim
// contract.  The shim re-marshals the incoming dispatch words to the real method,
// so the caller here uses the SAME shim ABI (and the SAME shared helpers) as the
// func-value call path.  See emit_iface_call.bn:emitCallIfaceMethod (the LLVM
// reference), aarch64_iface.bn, and explorations/plan-iface-crossmode.md.

// emitCallIfaceMethod lowers OP_CALL_IFACE_METHOD.  Args[0] is the iv value (an
// 8-byte {data, vtable} aggregate held at the alloc region getOperand points at,
// ILP32); Args[1..] are user args; ins.Index is the ABSOLUTE vtable slot (already
// past the two-word any-block — dtor@0, *TypeInfo@1 — and any parent sub-vtable
// inlining) — see pkg/binate/ir/gen_iface.bn:findInterfaceMethodFromBase and the
// LLVM emission in pkg/binate/codegen/emit_impls.bn.  The HANDLE is loaded from
// vt[Index] (Index * wordBytes(), no +2), and dispatch goes through its marshaling
// shim.
//
// Mirrors emitCallFuncValue (shared shim helpers, so the two arg layouts can't
// drift), with two differences: (a) the handle is LOADED from the vtable slot at
// iv.vtable + wordBytes()*Index instead of being a func-value operand, and (b) the
// RECEIVER (iv[0]) is prepended as the shim's first arg after the handle's data —
// so the prefix is [data, receiver] (prefixSlots 2, scalar/void) or [retbuf, data,
// receiver] (prefixSlots 3, aggregate/multi return), one more than the func-value
// path.  Everything the dispatch needs derives from the iv pointer, which
// getOperand reloads after the arg loop (just as emitCallFuncValue reloads its
// func-value operand): the handle ptr = vt[Index], the shim = handle.vtable.call,
// data = handle.data, receiver = iv.data.
//
// arm32's only intra-call scratch is IP (R12), which emitAggregateArg /
// emitFrameAddr clobber, so the shim call target is materialized into IP as the
// LAST step before BLX (after all the prefix loads).  The handle ptr rides a POOL
// reg across the prefix loads — never a frame slot — so a large frame never needs a
// method-pointer spill (unlike the pre-handle raw-call shape).
//
// Scalar / void / single-aggregate / multi-return results — including aggregates
// with float FIELDS, and float scalar args / returns — are all in scope; the shim
// ABI marshals a float scalar on the soft-float GP path (a float32 in one word, a
// float64 in the even-aligned register pair), matching the func-value call path.
func emitCallIfaceMethod(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		allFuncs @[]@ir.Func, ins @ir.Instr) {
	if len(ins.Args) < 1 {
		a.SetError("native arm32: iface dispatch with no interface value (P4-c.3)")
		return
	}
	// Under hard-float a float user arg or a float return rides VFP, which the
	// GP-only arg marshal + return collection below place in GP by soft-float
	// coincidence — fail LOUD rather than silently miscompile (VFP marshaling
	// through the dispatch is a later P6 increment).  Checked BEFORE the method-
	// pointer slot lookup so a float-bearing call fails for THIS reason, not an
	// unrelated missing-slot error.  Inert on soft-float.
	if types.Arm32HardFloat() && callInstrHasFloatArm32(ins) {
		a.SetError(
				"native arm32 hard-float: float through iface dispatch not "
						"yet implemented (P6 follow-up)")
		return
	}

	// Classify the return under the shim convention (a retbuf for ANY aggregate /
	// multi return — the shim writes every one THROUGH the retbuf, matching the LLVM
	// shim + VM cross-mode dispatch), single-source-of-truth via IsAggregateReturnTyp
	// / IsMultiReturnCall so the caller and shim agree.  The prefix is [data,
	// receiver] (prefixSlots 2) for a scalar/void return or [retbuf, data, receiver]
	// (prefixSlots 3) for a retbuf return — one more slot than emitCallFuncValue's,
	// for the receiver.
	var aggregateRet bool = ins.ID >= 0 && types.IsAggregateReturnTyp(ins.Typ) &&
			!common.IsMultiReturnCall(ins)
	var multiRet bool = ins.ID >= 0 && common.IsMultiReturnCall(ins)
	var useRetbuf bool = aggregateRet || multiRet
	var prefixSlots int = 2
	if useRetbuf { prefixSlots = 3 }

	// Synthetic argTypes + user-arg marshalling via the shared shim helpers (so the
	// func-value and iface layouts can't drift), BEFORE the prefix loads so a user
	// arg sourced from a prefix register is read first.
	var nCallArgs int = len(ins.Args) - 1
	var argTypes @[]@types.Type = shimArgTypesArm32(rm.CC, ins, nCallArgs, prefixSlots)
	emitShimUserArgsArm32(a, pkgName, rm, ins, argTypes, prefixSlots, nCallArgs)
	if a.HasError { return }

	// Reload the iv pointer (the arg loop's ResetRegs may have stranded it), then
	// recompute the method HANDLE pointer into a POOL reg:
	//   handleReg = iv.vtable   (LDR handleReg, [ivAddr + IfaceValueVtableOffset()])
	//   handleReg = vt[Index]   (LDR handleReg, [handleReg + Index*wordBytes()])
	// wordBytes() = 4 on this ILP32 target (each vtable slot is one target word), NOT
	// the literal 8 the LP64 backends use.  The slot offset scales with ins.Index, so
	// it overflows the 12-bit LDR immediate for an interface with > 1023 methods;
	// emitBaseLoad materializes it via IP (dead here — IP takes the shim only at the
	// very end).  For the common fitting offset it emits the identical bare
	// `LDR handleReg, [handleReg, #off]`.
	var ivAddr int = getOperand(a, rm, ins.Args[0].ID)
	if ivAddr < 0 {
		a.SetError("native arm32: iface value not materializable (P4-c.3)")
		return
	}
	var handleReg int = scratchReg(rm)
	arm32.Ldr(a, arm32.COND_AL, handleReg, arm32.MemImm(ivAddr, types.IfaceValueVtableOffset()))
	emitBaseLoad(a, handleReg, handleReg, wordBytes() * ins.Index, arm32.IP)

	// Place the shim's prefix registers.  emitFrameAddr uses IP as its scratch, so do
	// the retbuf materialization + the (plain-LDR) data / receiver loads BEFORE
	// loading the call target into IP below.  With a retbuf, R0 = &retbuf and
	// data / receiver shift to R1 / R2; without, data = R0, receiver = R1.
	var dataSlot int = 0
	var recvSlot int = 1
	if useRetbuf {
		// R0 = &retbuf (the AAPCS32 sret pointer the shim writes the whole result
		// through): a single aggregate uses its pre-allocated alloc region; a multi-
		// return (big OR small) uses the spill slot the tuple lands in.  The shim does
		// its own R0-sret plumbing internally — the caller just supplies the buffer.
		var retbufOff int = -1
		if multiRet {
			retbufOff = rm.LookupSpill(ins.ID)
		} else {
			retbufOff = rm.LookupAlloc(ins.ID)
		}
		if retbufOff < 0 { return }
		emitFrameAddr(a, arm32.R0, retbufOff)
		dataSlot = 1
		recvSlot = 2
	}
	// data = handle.data (from the handle ptr); receiver = iv.data (iv[0]).
	var dataRegStart int = rm.CC.CallArgRegStart(argTypes, dataSlot)
	if dataRegStart >= 0 {
		arm32.Ldr(a, arm32.COND_AL, argReg(dataRegStart),
				arm32.MemImm(handleReg, types.FuncValueDataOffset()))
	}
	var recvRegStart int = rm.CC.CallArgRegStart(argTypes, recvSlot)
	if recvRegStart >= 0 {
		arm32.Ldr(a, arm32.COND_AL, argReg(recvRegStart),
				arm32.MemImm(ivAddr, types.IfaceValueDataOffset()))
	}

	// Two-step load of the shim (handle.vtable.call) into IP, LAST (emitFrameAddr
	// above clobbered IP):
	//   IP = handle.vtable        (LDR IP, [handleReg + FuncValueVtableOffset()])
	//   IP = [IP + wordBytes()]                ; slot 1 = call (slot 0 = dtor)
	// wordBytes() (4), NOT the literal 8: the {vtable, data} handle is 8 bytes on
	// ILP32, so slot 1 is at offset 4.
	arm32.Ldr(a, arm32.COND_AL, arm32.IP, arm32.MemImm(handleReg, types.FuncValueVtableOffset()))
	arm32.Ldr(a, arm32.COND_AL, arm32.IP, arm32.MemImm(arm32.IP, wordBytes()))
	arm32.Blx(a, arm32.COND_AL, arm32.IP)

	// BLX clobbers R0-R3 and IP.  Reset the pool, then collect the return value(s)
	// via the shared shim-return helper (so the collect can't drift from the
	// func-value path).
	rm.ResetRegs()
	collectShimReturnArm32(a, rm, allFuncs, ins, aggregateRet, multiRet)
}

// ============================================================
// Interface-value scope-exit dtor load — emitIfaceDtor (P4-c.4)
// ============================================================
//
// OP_IFACE_DTOR does NOT itself call the destructor: it LOADS slot 0 (the dtor
// HANDLE) of a managed interface value's vtable, producing an opaque function-
// pointer-shaped value (the same shape OP_FUNC_HANDLE yields) that the later
// OP_REFDEC dtor-operand path (emitRefDecInline -> rt.ZeroRefDestroy) consumes
// and invokes when the refcount hits zero.  It is the mirror of the sibling
// OP_FUNC_VALUE_DTOR (arm32_dispatch.bn) — same two-step vtable load — differing
// only in the vtable pointer's offset within the value: a func-value is laid out
// {vtable, data} (vtable at offset 0), whereas an iface value is {data, vtable}
// (vtable at IfaceValueVtableOffset() = ptrSize() = 4 on this ILP32 target).
//
// A NULL dtor slot (a concrete type with NO destructor — dtorSlotSymNative
// emitted an empty slot 0) loads a null handle here; the no-op is enforced at
// RUNTIME by rt.ZeroRefDestroy, which is only reached when the refcount hits
// zero and guards a null dtor handle before dispatching through it.  There is
// therefore no null-check (and no call) in this lowering — mirroring the aa64 /
// x64 OP_IFACE_DTOR arms, which also emit only the two loads.
//
// Because this is a plain load (no arg marshaling, no BLX), IP is NOT held live
// across any clobbering call, so the emitCallIfaceMethod pool-reg spill/reload
// discipline does not apply — the loaded handle lands directly in the result
// register.
func emitIfaceDtor(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 {
		a.SetError("native arm32: iface dtor with no interface value (P4-c.4)")
		return
	}
	var ivp int = getOperand(a, rm, ins.Args[0].ID)
	if ivp < 0 {
		a.SetError("native arm32: iface value not materializable for dtor load (P4-c.4)")
		return
	}
	var rd int = nextReg(rm, ins.ID)
	// vt = iv.vtable  (LDR rd, [ivp + IfaceValueVtableOffset()])
	arm32.Ldr(a, arm32.COND_AL, rd, arm32.MemImm(ivp, types.IfaceValueVtableOffset()))
	// dtor = *(vt + 0)  (LDR rd, [rd + 0])
	arm32.Ldr(a, arm32.COND_AL, rd, arm32.MemImm(rd, 0))
}
