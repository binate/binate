package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/builtins/testing"

// emitImplVtables is a no-op for a module with no impls (the walking-skeleton
// case).  It emits nothing rather than crashing.
func TestEmitImplVtablesNoImplsIsNoOp() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var m @ir.Module = ir.NewModule("\"main\"")
	emitImplVtables(a, "main", m)
	if a.Sections[0].Len != 0 {
		return fail("emitImplVtables should emit nothing when there are no impls")
	}
	return ""
}
