package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the interface backend in arm32_iface.bn / arm32_typeinfo.bn: the
// impl-vtable + RTTI DATA emission (P4-c.1) pinned against the shared
// ir.BuildImplVtable / mangle.* (so any DRIFT from the LLVM backend that arm32
// native main links against is caught at unit-test time, not at link time), the
// iface-value construction ops (P4-c.2), method DISPATCH shape (P4-c.3:
// OP_CALL_IFACE_METHOD), and the managed-iface scope-exit dtor load (P4-c.4:
// OP_IFACE_DTOR).  End-to-end emission is exercised by the conformance suite under
// builder-comp_native_arm32_baremetal (the NATIVE mode; the non-native
// builder-comp_arm32_baremetal is the LLVM cross-compile and does not run this
// backend).
//
// The slot stride is one target word — 4 bytes on this ILP32 target (vs 8 on
// aarch64/x64), so the byte counts below are half the aarch64 equivalents.

// setArm32TargetIface pins the ILP32 layout (int / pointer = 4 bytes) so
// ir.BuildImplVtable lays 4-byte vtable slots — the real arm32 target width, not
// the LP64 host default.  Local to this file (setArm32Target lives in
// arm32_funcvalue_test.bn); duplicated so an iface-only test run is
// self-contained.
func setArm32TargetIface() {
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
}

// ifaceMkAssembler builds a fresh ELF32 assembler (4-byte word) with a text
// section selected, mirroring the arm32 test convention (asm.New(4)).
func ifaceMkAssembler() @asm.Assembler {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	return a
}

// genFromSrcIface parses Binate source through the standard parser → ir.GenModule
// pipeline, which populates the per-module iface/impl registries (Interfaces /
// ImplInfo) that emitImplVtables walks for parents / own methods.  Lighter-weight
// than a full EmitObject + link.
func genFromSrcIface(src *[]readonly char) @ir.Module {
	var b @[]uint8 = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		b[i] = cast(uint8, src[i])
	}
	var p @parser.Parser = parser.New(b, "test")
	var file @ast.File = p.ParseFile()
	return ir.GenModule(nil, file)
}

// relroSectionBytesIface returns the byte count of the assembler's
// "rodata_relro" section (where impl vtables + RTTI records land — read-only but
// bearing relocations to dtor / method / TypeInfo symbols).  Returns 0 if no
// relro section was emitted.  Iterates NumSections (the Sections slice is
// over-allocated by SetSection's growth strategy).
func relroSectionBytesIface(a @asm.Assembler) int {
	for i := 0; i < a.NumSections; i++ {
		if charEqArm32(a.Sections[i].Name, "rodata_relro") {
			return a.Sections[i].Len
		}
	}
	return 0
}

// emitImplVtablesOnlyIface emits just the per-(R, I) __ivt / __ivtshim vtables
// for each impl in mod (mirroring emitImplVtables' loop) — WITHOUT the TypeInfo /
// IfaceId / satisfaction-entry globals emitImplVtables also emits.  The shape
// tests use it to measure vtable bytes in isolation, so they stay immune to
// growth in those RTTI satellites (which land in the same relro).
func emitImplVtablesOnlyIface(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	for i := 0; i < len(mod.Impls); i++ {
		var info @ir.ImplInfo = mod.Impls[i]
		if info == nil { continue }
		emitOneImplVtable(a, pkgName, mod, info)
		if !common.RecvTypeIsGenericInst(info.RecvTypeName) {
			emitOneImplShimVtable(a, pkgName, mod, info)
		}
	}
}

// TestImplVtableNameNative pins the bare ELF symbol for an (R, I) impl vtable:
// the `__ivt.`-decorated bn_V core (recvPkg, recvType, ifacePkg, ifaceName) from
// mangle.ImplVtableName.  On arm32 (ELF) there is NO leading '_' Mach-O prefix,
// so the name has exactly TWO leading underscores (`__ivt.`), not three like the
// aarch64 Mach-O form.
func TestImplVtableNameNative() testing.TestResult {
	var info @ir.ImplInfo = make(ir.ImplInfo)
	info.RecvPkg = "main"
	info.RecvTypeName = "T"
	info.IfacePkg = "main"
	info.IfaceName = "I"
	var got @[]char = implVtableNameNative(info)
	if !charEq(got, "__ivt.bn_V1_4_main1_T1_4_main1_I") {
		return fail("expected __ivt.bn_V1_4_main1_T1_4_main1_I")
	}
	return ""
}

// TestImplVtableNameNativeCrossPkg covers the cross-package shape (Slice 2.6 of
// plan-cross-package-interfaces.md): the iface's own package name appears between
// RecvName and IfaceName even when impl and iface live in different packages.
func TestImplVtableNameNativeCrossPkg() testing.TestResult {
	var info @ir.ImplInfo = make(ir.ImplInfo)
	info.RecvPkg = "geom"
	info.RecvTypeName = "Point"
	info.IfacePkg = "fmt"
	info.IfaceName = "Stringer"
	var got @[]char = implVtableNameNative(info)
	if !charEq(got, "__ivt.bn_V1_4_geom5_Point1_3_fmt8_Stringer") {
		return fail("expected __ivt.bn_V1_4_geom5_Point1_3_fmt8_Stringer")
	}
	return ""
}

// TestImplShimVtableNameNative pins the parallel shim-vtable symbol
// (`__ivtshim.` on a bn_W core) via mangle.ImplVtableShimName — bare on ELF.
func TestImplShimVtableNameNative() testing.TestResult {
	var info @ir.ImplInfo = make(ir.ImplInfo)
	info.RecvPkg = "main"
	info.RecvTypeName = "T"
	info.IfacePkg = "main"
	info.IfaceName = "I"
	var got @[]char = implShimVtableNameNative(info)
	if !charEq(got, "__ivtshim.bn_W1_4_main1_T1_4_main1_I") {
		return fail("expected __ivtshim.bn_W1_4_main1_T1_4_main1_I")
	}
	return ""
}

// TestBuildMethodFuncNameNative pins the dotted-name format used when looking up
// a method's mangled function symbol from a vtable slot.  Format:
// `<recvPkg>.<recvName>.<methodName>` — matches
// pkg/binate/codegen/emit_impls.bn:buildMethodFuncName.
func TestBuildMethodFuncNameNative() testing.TestResult {
	var got @[]char = buildMethodFuncNameNative("geom", "Point", "String")
	if !charEq(got, "geom.Point.String") {
		return fail("expected geom.Point.String")
	}
	return ""
}

// TestEmitImplVtablesNoImplsIsNoOp: emitImplVtables emits nothing for a module
// with no impls (the walking-skeleton case).
func TestEmitImplVtablesNoImplsIsNoOp() testing.TestResult {
	setArm32TargetIface()
	var a @asm.Assembler = ifaceMkAssembler()
	var m @ir.Module = ir.NewModule("\"main\"")
	emitImplVtables(a, "main", m)
	if relroSectionBytesIface(a) != 0 {
		return fail("emitImplVtables should emit nothing when there are no impls")
	}
	return ""
}

// TestEmitImplVtablesNonExtendingShape: for a non-extending interface, each
// vtable layout collapses to [dtor, *TypeInfo, m1, m2, ...] = (2 any-block + N
// method) slots × 4 bytes (ILP32).  `interface I { foo() }; impl *T : I` for a
// struct T with no managed fields → 3 slots × 4 = 12 bytes raw; the parallel
// __ivtshim is the same layout = 12 bytes.  Total = 24 bytes (half the aarch64
// 48-byte count because slots are 4 bytes, not 8).
func TestEmitImplVtablesNonExtendingShape() testing.TestResult {
	setArm32TargetIface()
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() }\n"
			"type T struct { x int }\n"
			"func (t *T) foo() { }\n"
			"impl *T : I\n"
			"func main() { }\n"
	var mod @ir.Module = genFromSrcIface(src)

	var a @asm.Assembler = ifaceMkAssembler()
	emitImplVtablesOnlyIface(a, "main", mod)
	// Flake guard: if the ILP32 target is not in effect at emit time, ir.BuildImplVtable
	// strides 8-byte (LP64) slots and this doubles (24->48). Assert the target FIRST so a
	// leaked-LP64 flake reports its true cause here, not as a confusing byte-count mismatch.
	if types.GetTarget().IntSize != 4 {
		return fail("ILP32 target not in effect at emit time (IntSize != 4) — target leaked to LP64")
	}
	if relroSectionBytesIface(a) != 24 {
		return fail("non-extending (T,I) raw+shim vtables should be 24 bytes (2×3 slots × 4)")
	}
	if a.LookupSymbol("__ivt.bn_V1_4_main1_T1_4_main1_I") < 0 {
		return fail("non-extending impl should define the __ivt vtable symbol")
	}
	if a.LookupSymbol("__ivtshim.bn_W1_4_main1_T1_4_main1_I") < 0 {
		return fail("non-extending impl should define the __ivtshim shim vtable symbol")
	}
	return ""
}

// TestEmitImplVtablesExtendedConcatShape: plan-interface-embedding.md Slice E.3.
// For an extended interface `RC : Closer { Read() int }`, the (T, RC) vtable uses
// the concat layout — RC's two-word any-block + Closer's full sub-vtable inlined
// + RC's own methods — for 2 + 3 + 1 = 6 slots × 4 = 24 bytes.  `impl *T : RC`
// also registers (T, Closer) transitively, so the relro contains BOTH vtables:
// RC (24 bytes) + Closer (3 slots × 4 = 12 bytes) = 36 bytes — and each gets a
// byte-identical-layout shim vtable → 36 × 2 = 72 bytes total.
func TestEmitImplVtablesExtendedConcatShape() testing.TestResult {
	setArm32TargetIface()
	var src *[]readonly char = "package \"main\"\n"
			"interface Closer { Close() }\n"
			"interface RC : Closer { Read() int }\n"
			"type T struct { x int }\n"
			"func (t *T) Close() { }\n"
			"func (t *T) Read() int { return 0 }\n"
			"impl *T : RC\n"
			"func main() { }\n"
	var mod @ir.Module = genFromSrcIface(src)

	var a @asm.Assembler = ifaceMkAssembler()
	emitImplVtablesOnlyIface(a, "main", mod)
	if types.GetTarget().IntSize != 4 {
		return fail("ILP32 target not in effect at emit time (IntSize != 4) — target leaked to LP64")
	}
	if relroSectionBytesIface(a) != 72 {
		return fail("(T,RC)+(T,Closer) raw+shim vtables should total 72 bytes (ILP32)")
	}
	return ""
}

// TestEmitImplVtableSlot0IsHandleNotRawFn: slot 0 of an impl vtable references
// the dtor HANDLE symbol `__handle.bn_F1_4_main1_8___dtor_T`, NOT the raw dtor fn
// symbol `bn_F1_4_main1_8___dtor_T`.  _call_dtor (the indirect call
// ZeroRefDestroy makes) lowers as OP_CALL_HANDLE and dereferences the value as a
// {vtable, data} handle — a raw fn pointer there would call into garbage
// (conformance/520).  emitImplVtables does not emit the raw dtor symbol (the
// handle global's emitter does), so running only emitImplVtables here, the raw
// symbol must be absent.
func TestEmitImplVtableSlot0IsHandleNotRawFn() testing.TestResult {
	setArm32TargetIface()
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() int }\n"
			"type Inner struct { V int }\n"
			"type T struct { Inner @Inner }\n"
			"func (t *T) foo() int { return t.Inner.V }\n"
			"impl *T : I\n"
			"func main() { }\n"
	var mod @ir.Module = genFromSrcIface(src)

	var a @asm.Assembler = ifaceMkAssembler()
	emitImplVtables(a, "main", mod)

	if a.LookupSymbol("__handle.bn_F1_4_main1_8___dtor_T") < 0 {
		return fail("impl vtable slot 0 must reference __handle.bn_F1_4_main1_8___dtor_T")
	}
	if a.LookupSymbol("bn_F1_4_main1_8___dtor_T") >= 0 {
		return fail("impl vtable slot 0 must NOT reference the raw fn bn_F1_4_main1_8___dtor_T directly")
	}
	return ""
}

// TestCollectImplVtableSlotsOrderNative fences the vtable slot ORDER against a
// silent divergence from the LLVM backend (slot0=dtor handle, slot1=*TypeInfo,
// slot2+=methods). The byte-count/symbol-presence shape tests above do NOT catch
// a reorder — swapping or reversing the slot list leaves them green — so this
// asserts the per-slot symbol from collectImplVtableSlotsNative directly. Slot 1
// is checked against the SHARED mangle.TypeInfoName (the cross-backend source of
// truth), so a slot0<->slot1 swap or a full reversal makes slot 1 no longer the
// *TypeInfo and fails here.
func TestCollectImplVtableSlotsOrderNative() testing.TestResult {
	setArm32TargetIface()
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() }\n"
			"type Inner struct { V int }\n"
			"type T struct { Inner @Inner }\n"
			"func (t *T) foo() { }\n"
			"impl *T : I\n"
			"func main() { }\n"
	var mod @ir.Module = genFromSrcIface(src)
	var info @ir.ImplInfo = nil
	for i := 0; i < len(mod.Impls); i++ {
		if mod.Impls[i] == nil { continue }
		if charEqIface(mod.Impls[i].IfaceName, "I") { info = mod.Impls[i] }
	}
	if info == nil {
		return fail("expected a (T, I) impl in the generated module")
	}
	var slots @[]@[]char = collectImplVtableSlotsNative("main", mod, info, info.IfacePkg,
			info.IfaceName, false)
	// [dtor handle, *TypeInfo, foo] — three slots, in that order.
	if len(slots) != 3 {
		return fail("non-extending (T, I) vtable must have 3 slots: dtor, *TypeInfo, foo")
	}
	if !charEqIface(slots[0], dtorSlotSymNative("main", mod, info.DtorFuncName)) {
		return fail("slot 0 must be the dtor handle")
	}
	if !charEqIface(slots[1], symPrefixed(mangle.TypeInfoName(info.RecvPkg, info.RecvTypeName))) {
		return fail("slot 1 must be the *TypeInfo (catches a slot0<->slot1 swap / reversal)")
	}
	if charEqIface(slots[2], slots[0]) || charEqIface(slots[2], slots[1]) {
		return fail("slot 2 must be the foo method, distinct from the dtor / *TypeInfo slots")
	}
	return ""
}

// ============================================================
// Interface-VALUE construction shape tests (P4-c.2)
// ============================================================
//
// These pin the instruction shapes emitInstr lowers for OP_IFACE_VALUE and
// OP_IFACE_UPCAST — the two-word {data, vtable} construction / rebuild — mirroring
// the aarch64 vtable-test shapes but with ILP32 4-byte slots and MOVW/MOVT-ABS
// address materialization (no ADRP+ADD).  Byte counts are pinned against the
// SHARED types-layer offset constants (IfaceValueDataOffset / VtableOffset) where
// they drive an offset, so DRIFT from the LLVM layout an arm32-native main links
// against is caught here, not at link time.

// TestEmitOpIfaceValueShape: OP_IFACE_VALUE with a local (spilled) data ptr
// builds the two-word {data, vtable} aggregate.  Shape:
//   LDR  dataReg, [SP, #...]      ; getOperand reload of the data-ptr arg
//   STR  dataReg, [SP, #dataOff+0]
//   MOVW vtTmp, :lower16:__ivt... ; emitSymAddr MOVW/MOVT-ABS pair -> vtable addr
//   MOVT vtTmp, :upper16:__ivt...
//   STR  vtTmp, [SP, #dataOff+4]  ; IfaceValueVtableOffset() = ptrSize() = 4
//   ADD  rd, SP, #dataOff         ; result = data-region pointer
// Six 4-byte arm32 instructions = 24 bytes.  Pins the handler; without it
// OP_IFACE_VALUE would fail loud (unimplemented) or emit 0 bytes.
func TestEmitOpIfaceValueShape() testing.TestResult {
	setArm32TargetIface()
	var a @asm.Assembler = ifaceMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// data-ptr arg: spill slot at offset 0 (ID=5).
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	// destination iv region: two words (8 bytes) at offset 16 (ID=7).
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 7)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)

	var dataArg @ir.Instr = make(ir.Instr)
	dataArg.ID = 5

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Op = iropcode.OP_IFACE_VALUE
	ins.StrVal = "__ivt.bn_V1_4_main1_T1_4_main1_I"
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = dataArg

	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.HasError {
		return fail("OP_IFACE_VALUE (local data ptr) should not fail loud")
	}
	if a.Sections[0].Len != 24 {
		return fail("OP_IFACE_VALUE should emit 6 instrs (24 bytes); 0 means the handler regressed")
	}
	if rm.LookupReg(7) < 0 {
		return fail("OP_IFACE_VALUE should produce the data-region pointer")
	}
	// The vtable symbol must be referenced (marked global for its relocation).
	if a.LookupSymbol("__ivt.bn_V1_4_main1_T1_4_main1_I") < 0 {
		return fail("OP_IFACE_VALUE must reference the vtable symbol for its slot-1 store")
	}
	return ""
}

// TestEmitOpIfaceValueFromGlobalShape: OP_IFACE_VALUE whose data ptr is a package
// global (`&g`, an IsGlobalRef pseudo with ID -1 and no spill slot) must
// materialize the global's address via MOVW/MOVT rather than a register reload —
// the pre-fix getOperand path returned < 0 and dropped the entire construction.
// Shape:
//   MOVW dataTmp, :lower16:g      ; emitGlobalAddr MOVW/MOVT -> data addr
//   MOVT dataTmp, :upper16:g
//   STR  dataTmp, [SP, #dataOff+0]
//   MOVW vtTmp, :lower16:__ivt...
//   MOVT vtTmp, :upper16:__ivt...
//   STR  vtTmp, [SP, #dataOff+4]
//   ADD  rd, SP, #dataOff
// Seven 4-byte instructions = 28 bytes — one more than the local case (24)
// because the data ptr is MOVW/MOVT (2 instrs), not a single LDR.
func TestEmitOpIfaceValueFromGlobalShape() testing.TestResult {
	setArm32TargetIface()
	var a @asm.Assembler = ifaceMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 7)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)

	// Global-ref data ptr: ID -1, no spill/alloc slot, IsGlobalRef.
	var dataArg @ir.Instr = make(ir.Instr)
	dataArg.ID = -1
	dataArg.IsGlobalRef = true
	dataArg.StrVal = "g"

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Op = iropcode.OP_IFACE_VALUE
	ins.StrVal = "__ivt.bn_V1_4_main1_T1_4_main1_I"
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = dataArg

	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.HasError {
		return fail("OP_IFACE_VALUE (global data ptr) should not fail loud")
	}
	if a.Sections[0].Len != 28 {
		return fail(
				"OP_IFACE_VALUE from a global should emit 7 instrs (28 bytes); "
						"24 means the global-ref data ptr wasn't materialized via MOVW/MOVT")
	}
	return ""
}

// TestEmitOpIfaceValueDynamicVtableFromRegister: a DYNAMIC OP_IFACE_VALUE
// (StrVal="", Args=[data, vtableReg]) takes the vtable from a REGISTER
// (interface-assertion recovery, RTTI Slice 2b) instead of the static __ivt
// symbol.  It must reference NO vtable symbol and emit NO MOVW/MOVT-ABS
// materialization; the vtable is Args[1]'s register.  Shape:
//   LDR  dataReg, [SP, #...]      ; getOperand reload of the data ptr
//   LDR  vtReg,   [SP, #...]      ; getOperand reload of the register vtable
//   STR  dataReg, [SP, #dataOff+0]
//   STR  vtReg,   [SP, #dataOff+4]
//   ADD  rd, SP, #dataOff         ; result = data-region pointer
// Five 4-byte arm32 instructions = 20 bytes — one fewer than the static local
// case (24) because the vtable is a single LDR, not a MOVW/MOVT pair.
func TestEmitOpIfaceValueDynamicVtableFromRegister() testing.TestResult {
	setArm32TargetIface()
	var a @asm.Assembler = ifaceMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// data-ptr arg (ID=5) and vtable-ptr arg (ID=6): spill slots.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 6)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 4)
	// destination iv region: two words (8 bytes) at offset 16 (ID=7).
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 7)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)

	var dataArg @ir.Instr = make(ir.Instr)
	dataArg.ID = 5
	var vtArg @ir.Instr = make(ir.Instr)
	vtArg.ID = 6

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Op = iropcode.OP_IFACE_VALUE
	// StrVal left EMPTY -> dynamic form; Args = [data, vtable].
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = dataArg
	ins.Args[1] = vtArg

	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.HasError {
		return fail("dynamic OP_IFACE_VALUE should not fail loud")
	}
	if a.NumSymbols != 0 {
		return fail("dynamic OP_IFACE_VALUE must reference NO vtable symbol (register vtable)")
	}
	if a.Sections[0].Len != 20 {
		return fail(
				"dynamic OP_IFACE_VALUE should emit 5 instrs (20 bytes): 2 LDRs, 2 STRs, ADD "
						"— no MOVW/MOVT vtable materialization")
	}
	if rm.LookupReg(7) < 0 {
		return fail("dynamic OP_IFACE_VALUE should produce the data-region pointer")
	}
	// An instr count can't see a data<->vtable slot SWAP: retargeting the data
	// STR to IfaceValueVtableOffset() (and the vtable STR to
	// IfaceValueDataOffset()) leaves the count at 5 but corrupts every downstream
	// dispatch (which reads the vtable at IfaceValueVtableOffset()).  Decode the
	// two SP-relative STR displacements in EMISSION ORDER — the data ptr is stored
	// first, the register vtable second (see arm32_iface.bn's emitIfaceValue) —
	// and pin each against the shared offset constant, so a swap or a
	// wrong/dropped offset fails here.  dataOff is the id-7 alloc offset (16).
	// (TestEmitOpIfaceValueDataStoreAtOffsetZero pins the CONSTANTS; this pins the
	// actual emitted store TARGETS.)
	var dataOff int = 16
	if nthStrSpImm(a, 0) != dataOff + types.IfaceValueDataOffset() {
		return fail("dynamic OP_IFACE_VALUE data ptr must STR at IfaceValueDataOffset()")
	}
	if nthStrSpImm(a, 1) != dataOff + types.IfaceValueVtableOffset() {
		return fail("dynamic OP_IFACE_VALUE register vtable must STR at IfaceValueVtableOffset()")
	}
	return ""
}

// nthStrSpImm returns the #imm of the k-th (0-based) `STR Rt, [SP, #imm]`
// (positive-offset word store, cond=AL) in the text stream, or -1 if there are
// fewer than k+1.  Encoding (arm32_mem.bn:ldrstrEnc, store word to an OP_MEM_IMM
// with positive offset): cond=AL(0xE) | 01 (bits[27:26]) | P=1 | U=1 | B=0 |
// W=0 | L=0 | Rn=SP(13) at [19:16] | Rt at [15:12] | imm12 at [11:0].  The fixed
// bits (0xFFFF0000 mask) are 0xE58D0000; imm = word & 0xFFF.  emitIfaceValue's
// two data-region stores are exactly this shape (base SP, byte offset), so k=0
// is the data store and k=1 is the vtable store.  The getOperand reloads are
// LDRs and the result is an ADD, so neither inflates this.
func nthStrSpImm(a @asm.Assembler, k int) int {
	var n int = a.Sections[0].Len
	var c int = 0
	for i := 0; i + 3 < n; i = i + 4 {
		var w uint32 = word32(a, i)
		if (w & cast(uint32, 0xFFFF0000)) != cast(uint32, 0xE58D0000) { continue }
		if c == k { return cast(int, w & cast(uint32, 0xFFF)) }
		c = c + 1
	}
	return -1
}

// TestEmitOpIfaceValueDataStoreAtOffsetZero: the data ptr must land at
// IfaceValueDataOffset (0) and the vtable at IfaceValueVtableOffset (ptrSize() =
// 4 on ILP32).  A slot0<->slot1 swap (data at 4, vtable at 0) would corrupt every
// downstream dispatch (which reads vtable at offset 4).  Byte-count shape can't
// see a swap, so pin the two offsets against the shared constants directly.
func TestEmitOpIfaceValueDataStoreAtOffsetZero() testing.TestResult {
	setArm32TargetIface()
	if types.IfaceValueDataOffset() != 0 {
		return fail("IfaceValueDataOffset must be 0 (data at slot 0)")
	}
	if types.IfaceValueVtableOffset() != 4 {
		return fail("IfaceValueVtableOffset must be ptrSize() = 4 on ILP32 (vtable at slot 1)")
	}
	return ""
}

// TestEmitOpIfaceUpcastNoOffset: OP_IFACE_UPCAST with offsetSlots = 0 copies the
// data ptr and the (unadjusted) vtable ptr into a new iv region.  Shape:
//   LDR  srcPtr, [SP, #...]        ; getOperand reload of the source iv pointer
//   LDR  dataTmp, [srcPtr, #0]     ; iv.data (IfaceValueDataOffset)
//   STR  dataTmp, [SP, #dataOff+0]
//   LDR  vtTmp,   [srcPtr, #4]     ; iv.vtable (IfaceValueVtableOffset = 4)
//   STR  vtTmp,   [SP, #dataOff+4] ; no ADD — offset 0
//   ADD  rd, SP, #dataOff          ; result = new iv region pointer
// Six 4-byte instructions = 24 bytes.  Pins the handler's presence.
func TestEmitOpIfaceUpcastNoOffset() testing.TestResult {
	setArm32TargetIface()
	var a @asm.Assembler = ifaceMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// source iv pointer: spill slot at offset 0 (ID=5).
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	// destination iv region: two words (8 bytes) at offset 16 (ID=7).
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 7)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)

	var src @ir.Instr = make(ir.Instr)
	src.ID = 5

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Op = iropcode.OP_IFACE_UPCAST
	ins.IfaceUpcastSlotOffset = 0
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src

	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.HasError {
		return fail("OP_IFACE_UPCAST (offset 0) should not fail loud")
	}
	if a.Sections[0].Len != 24 {
		return fail("OP_IFACE_UPCAST (no offset) should emit 6 instrs (24 bytes)")
	}
	if rm.LookupReg(7) < 0 {
		return fail("OP_IFACE_UPCAST should produce the new iv region pointer")
	}
	return ""
}

// TestEmitOpIfaceUpcastWithOffset: OP_IFACE_UPCAST with offsetSlots = 2 adjusts
// the vtable pointer by offsetSlots * wordBytes() = 2 * 4 = 8 bytes via one extra
// ADD (the byte offset fits the rotated-immediate form).  Shape is the no-offset
// case (24 bytes) plus that ADD → 28 bytes.  Pins the slot->byte conversion:
// dropping the *wordBytes() (or using the LP64 *8) would compute the wrong offset.
func TestEmitOpIfaceUpcastWithOffset() testing.TestResult {
	setArm32TargetIface()
	var a @asm.Assembler = ifaceMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 7)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)

	var src @ir.Instr = make(ir.Instr)
	src.ID = 5

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Op = iropcode.OP_IFACE_UPCAST
	ins.IfaceUpcastSlotOffset = 2
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src

	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.HasError {
		return fail("OP_IFACE_UPCAST (offset 2) should not fail loud")
	}
	if a.Sections[0].Len != 28 {
		return fail(
				"OP_IFACE_UPCAST (offset 2) should emit 7 instrs (28 bytes) — the extra ADD "
						"adds offsetSlots * wordBytes() = 8 to the vtable ptr")
	}
	return ""
}

// TestEmitOpIfaceUpcastInvalidSetsError: an invalid upcast (offsetSlots < 0 —
// target not an ancestor of source; the checker should never produce this) must
// fail LOUD via a.SetError, per arm32's fail-loud discipline (aa64 panics here).
// Adjusting the vtable by a negative slot would walk the pointer before its base
// (silent vtable corruption / SIGSEGV); the loud error surfaces the codegen bug.
func TestEmitOpIfaceUpcastInvalidSetsError() testing.TestResult {
	setArm32TargetIface()
	var a @asm.Assembler = ifaceMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 7)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)

	var src @ir.Instr = make(ir.Instr)
	src.ID = 5

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Op = iropcode.OP_IFACE_UPCAST
	ins.IfaceUpcastSlotOffset = -1
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src

	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if !a.HasError {
		return fail("an invalid iface upcast (offsetSlots < 0) must fail loud (a.SetError)")
	}
	return ""
}

// ============================================================
// Interface method DISPATCH shape tests (P4-c.3)
// ============================================================
//
// These pin the instruction shapes emitCallIfaceMethod lowers for
// OP_CALL_IFACE_METHOD — the two-step vtable LDR, the IP spill/reload bracketing
// the arg loop, the BLX indirect call, the [sret, data, args...] 2-slot prefix for
// a big return, and the field-per-register small-multi-return collect.  Ported
// from x64_iface_test.bn (the [sret, data] shift model), adapted to AAPCS32 (R0
// sret, R1 data) with 4-byte vtable slots.

// scanForBlxIp reports whether the emitted text stream contains a `BLX IP`
// (0xE12FFF3C little-endian: cond=AL, BLX register form, Rm=IP=R12).  The two-step
// vtable load + BLX is the dispatch fingerprint; without the reload+BLX the call
// jumps through garbage.
func scanForBlxIp(a @asm.Assembler) bool {
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	for i := 0; i + 3 < n; i = i + 4 {
		if data[i] == cast(uint8, 0x3c) && data[i + 1] == cast(uint8, 0xff) &&
				data[i + 2] == cast(uint8, 0x2f) && data[i + 3] == cast(uint8, 0xe1) {
			return true
		}
	}
	return false
}

// TestEmitCallIfaceMethodVoidNoArgShape: a no-arg void dispatch emits the two-step
// vtable LDR (vtable ptr, then vt[Index]), spills the method ptr, reloads it into
// IP, loads the data receiver into R0, and BLX IP — with no arg loop and no return
// collection.  Pins the core dispatch shape (spill + reload + BLX present).
func TestEmitCallIfaceMethodVoidNoArgShape() testing.TestResult {
	setArm32TargetIface()
	var a @asm.Assembler = ifaceMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// iv arg (ID 1): alloc region (8 bytes) + spill slot holding its pointer.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	// Result slot (ID 2): a void call still needs an alloc region for the fnPtr
	// spill fallback; give it one.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 2)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)

	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 1
	iv.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_CALL_IFACE_METHOD
	ins.Index = 2 // first user method (slots 0-1 = any-block: dtor, *TypeInfo)
	ins.Typ = types.TypVoid()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = iv

	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.HasError {
		return fail("OP_CALL_IFACE_METHOD (void, no args) should not fail loud (P4-c.3)")
	}
	if !scanForBlxIp(a) {
		return fail("iface dispatch must emit BLX IP (the indirect call through the method ptr)")
	}
	return ""
}

// TestEmitCallIfaceMethodWithArgShape: a dispatch with one scalar user arg places
// the data receiver in R0 (prefix slot 0) and the user arg in R1 (slot 1), then
// BLX IP.  Pins that the user arg is shifted past the single data prefix slot (a
// missing shift would clobber the receiver).
func TestEmitCallIfaceMethodWithArgShape() testing.TestResult {
	setArm32TargetIface()
	var a @asm.Assembler = ifaceMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	// user arg (ID 3): spill slot holding its value.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 3)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 12)
	// result slot (ID 2): int scalar return in a spill slot.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)

	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 1
	iv.Typ = types.MakePointerType(types.TypUint8())
	var uarg @ir.Instr = make(ir.Instr)
	uarg.ID = 3
	uarg.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_CALL_IFACE_METHOD
	ins.Index = 2
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = iv
	ins.Args[1] = uarg

	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.HasError {
		return fail("OP_CALL_IFACE_METHOD (one scalar arg) should not fail loud (P4-c.3)")
	}
	if !scanForBlxIp(a) {
		return fail("iface dispatch with an arg must still emit BLX IP")
	}
	// A scalar return is collected by storing R0 into the result spill slot (arm32's
	// spill-everything convention — no result reg is held live; getOperand reloads
	// on demand), so there is at least one STR after the BLX.  Pin that the collect
	// happened rather than asserting a (non-existent) held result reg.
	if countStrImmAfterBlxIface(a) < 1 {
		return fail("iface dispatch with a scalar return must STR R0 into the result slot")
	}
	return ""
}

// countStrImmAfterBlxIface counts STR-immediate stores (single-data-transfer
// class bits[27:26]=0b01, L-bit[20]=0) at or past the first BLX IP — i.e. the
// return-collect stores.  Local to this file so the iface dispatch tests are
// self-contained (blOffset_arm32calltest / countStrImmAfter_arm32calltest live in
// arm32_call_test.bn).
func countStrImmAfterBlxIface(a @asm.Assembler) int {
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var blx int = -1
	for i := 0; i + 3 < n; i = i + 4 {
		if data[i] == cast(uint8, 0x3c) && data[i + 1] == cast(uint8, 0xff) &&
				data[i + 2] == cast(uint8, 0x2f) && data[i + 3] == cast(uint8, 0xe1) {
			blx = i
		}
	}
	if blx < 0 { return 0 }
	var c int = 0
	for off := blx + 4; off + 4 <= n; off = off + 4 {
		// word bits[27:26] and [20] from the little-endian bytes.
		var b3 int = cast(int, data[off + 3])
		var b2 int = cast(int, data[off + 2])
		if ((b3 >> 2) & 0x3) == 0x1 && ((b2 >> 4) & 0x1) == 0x0 {
			c = c + 1
		}
	}
	return c
}

// TestEmitCallIfaceMethodBigReturnSretPrefix: a dispatch returning a managed-slice
// (16 bytes on ILP32 > InternalSretBytes) travels via AAPCS32 sret — R0 holds the
// hidden buffer pointer (prefixSlots = 2), so the data receiver shifts to R1.  Pins
// that a big return does NOT fail loud (aggregate-sret IS in P4-c.3 scope) and that
// the sret buffer address is materialized into R0.  A prefixSlots mismatch vs
// common_call.bn's sizer would silently miscompile — this fences the caller side.
func TestEmitCallIfaceMethodBigReturnSretPrefix() testing.TestResult {
	setArm32TargetIface()
	var a @asm.Assembler = ifaceMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	// result (ID 2): a 16-byte managed-slice → sret-returning; alloc data region.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 2)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 32)

	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 1
	iv.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_CALL_IFACE_METHOD
	ins.Index = 2
	ins.Typ = types.MakeManagedSliceType(types.TypUint8())
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = iv

	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.HasError {
		return fail("OP_CALL_IFACE_METHOD (big-aggregate sret return) should not fail loud (P4-c.3)")
	}
	if !scanForBlxIp(a) {
		return fail("big-return iface dispatch must still emit BLX IP")
	}
	// The big aggregate is returned via sret: the callee wrote through R0 into the
	// alloc data region, so the result is that region's pointer.
	if rm.LookupReg(2) < 0 {
		return fail("big-return iface dispatch must produce the alloc-region pointer")
	}
	return ""
}

// TestEmitCallIfaceMethodSmallMultiReturnCollect: a dispatch returning a small
// (in-register) multi-return tuple `(int, int)` (8 bytes ≤ 16, no sret) comes back
// field-per-register in r0..r3 and is collected into the result spill slot via the
// SHARED collectMultiReturnFields.  Pins that a small multi-return is in scope
// (does not fail loud) and reuses the shared collect (no reinvented field order).
func TestEmitCallIfaceMethodSmallMultiReturnCollect() testing.TestResult {
	setArm32TargetIface()
	var a @asm.Assembler = ifaceMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	// result (ID 2): the multi-return tuple lands in a spill slot (8 bytes).
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)

	// Build an anonymous multi-return tuple struct {int32, int32} (8 bytes ≤ 16 →
	// small, field-per-register).  An unnamed TYP_STRUCT is what IsMultiReturnCall
	// keys on (len(Name) == 0).
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt32()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt32()
	var tuple @types.Type = types.MakeStructType("", fields)

	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 1
	iv.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_CALL_IFACE_METHOD
	ins.Index = 2
	ins.Typ = tuple
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = iv

	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.HasError {
		return fail("OP_CALL_IFACE_METHOD (small multi-return) should not fail loud (P4-c.3)")
	}
	if !scanForBlxIp(a) {
		return fail("small-multi-return iface dispatch must still emit BLX IP")
	}
	return ""
}

// nthLdrImm returns the #imm of the k-th (0-based) `LDR Rd, [Rn, #imm]`
// (positive-offset word load, cond=AL) in the text stream, or -1 if there are
// fewer than k+1.  LDR (imm, P=1 U=1 W=0, load, word) = 0xE59R_R000 | (Rn<<16) |
// (Rd<<12) | imm12; the fixed bits (0xFFF00000 mask) are 0xE5900000.  The dtor's
// two-step vtable walk emits two such LDRs in order — vtable ptr, then slot 0 —
// so k=0 is the iv.vtable read and k=1 is the dtor-slot read.
func nthLdrImm(a @asm.Assembler, k int) int {
	var n int = a.Sections[0].Len
	var c int = 0
	for i := 0; i + 3 < n; i = i + 4 {
		var w uint32 = word32(a, i)
		if (w & cast(uint32, 0xFFF00000)) != cast(uint32, 0xE5900000) { continue }
		if c == k { return cast(int, w & cast(uint32, 0xFFF)) }
		c = c + 1
	}
	return -1
}

// countLdr returns how many `LDR Rd, [Rn, #imm]` (positive-imm word loads,
// cond=AL) the text stream contains — used to pin the dtor's two-step vtable walk
// (the getOperand iv reload is an ADD, not an LDR, so it does not inflate this).
func countLdr(a @asm.Assembler) int {
	var n int = a.Sections[0].Len
	var c int = 0
	for i := 0; i + 3 < n; i = i + 4 {
		var w uint32 = word32(a, i)
		if (w & cast(uint32, 0xFFF00000)) == cast(uint32, 0xE5900000) { c = c + 1 }
	}
	return c
}

// TestEmitOpIfaceDtorShape: OP_IFACE_DTOR (P4-c.4 — the managed-iface-value
// scope-exit dtor load) is NOT a call; it LOADS slot 0 (the dtor HANDLE) of the
// iv's vtable, producing the value the later OP_REFDEC dtor-operand path invokes.
// Shape (iv held in an alloc region here, so getOperand materializes its address
// with one ADD):
//   ADD  rd, SP, #ivOff           ; getOperand(iv) — pointer to the iv aggregate
//   LDR  rd, [rd, #IfaceValueVtableOffset]  ; vt = iv.vtable  (offset 4 on ILP32)
//   LDR  rd, [rd, #0]                        ; dtor = *(vt + 0)
// Three 4-byte ARM instructions = 12 bytes, mirroring the aa64 OP_IFACE_DTOR
// shape.  Pins: exactly the two vtable-walk LDRs, the first reading
// IfaceValueVtableOffset() (NOT the LP64 8), and a result register assigned so the
// OP_REFDEC scope-exit path has an operand.  No BLX — this op never calls.
func TestEmitOpIfaceDtorShape() testing.TestResult {
	setArm32TargetIface()
	var a @asm.Assembler = ifaceMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// iv arg (ID 1): its {data, vtable} aggregate lives in an alloc region, so
	// getOperand yields a pointer to it via a single ADD.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 8)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)

	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 1
	iv.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_IFACE_DTOR
	ins.Typ = types.MakePointerType(types.TypUint8())
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = iv

	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.HasError {
		return fail("OP_IFACE_DTOR should lower without error (P4-c.4)")
	}
	if a.Sections[0].Len != 12 {
		return fail("OP_IFACE_DTOR should emit ADD + 2 LDR (12 bytes): 1 iv-addr + vtable walk")
	}
	if countLdr(a) != 2 {
		return fail("OP_IFACE_DTOR should emit exactly two LDRs (vtable ptr, then dtor slot 0)")
	}
	if rm.LookupReg(2) < 0 {
		return fail("OP_IFACE_DTOR should assign the loaded dtor handle a result register")
	}
	// The two-step walk: LDR #0 reads iv.vtable at IfaceValueVtableOffset() (4 on
	// ILP32, NOT the LP64 8); LDR #1 reads the dtor at vtable slot 0 (offset 0).
	if nthLdrImm(a, 0) != types.IfaceValueVtableOffset() {
		return fail(
				"OP_IFACE_DTOR first LDR must read iv.vtable at IfaceValueVtableOffset() (4 on ILP32)")
	}
	if nthLdrImm(a, 1) != 0 {
		return fail("OP_IFACE_DTOR second LDR must read the dtor at vtable slot 0 (offset 0)")
	}
	return ""
}

// TestEmitOpIfaceDtorNullSlotIsRuntimeNoOp documents that a NULL dtor slot (a
// concrete type with no destructor — dtorSlotSymNative emitted an empty slot 0)
// is handled at RUNTIME, not here: OP_IFACE_DTOR unconditionally loads slot 0
// (which is a null handle for such a type), and the no-op is enforced by
// rt.ZeroRefDestroy (reached only when the refcount hits zero), which guards a
// null dtor handle before dispatching.  So the lowering is byte-identical
// regardless of whether the concrete type has a dtor — it always emits the two
// vtable-walk LDRs and never a null-check or a call.  This pins that OP_IFACE_DTOR
// does NOT branch on the slot value (a spurious null-check here would be dead code
// and could mask a real null the runtime must see).
func TestEmitOpIfaceDtorNullSlotIsRuntimeNoOp() testing.TestResult {
	setArm32TargetIface()
	var a @asm.Assembler = ifaceMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 8)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)

	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 1
	iv.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_IFACE_DTOR
	ins.Typ = types.MakePointerType(types.TypUint8())
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = iv

	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.HasError {
		return fail("OP_IFACE_DTOR must lower unconditionally (the null-slot no-op is a runtime concern)")
	}
	// No conditional branch (no CMP / Bcc) — the walk is straight-line.  BLX absence
	// also holds (never a call).  ADD + 2 LDR only.
	if scanForBlxIp(a) {
		return fail("OP_IFACE_DTOR must not emit a call (BLX) — it only LOADS the dtor handle")
	}
	if a.Sections[0].Len != 12 {
		return fail("OP_IFACE_DTOR null-slot lowering must be identical (ADD + 2 LDR, 12 bytes)")
	}
	return ""
}

// TestEmitOpIfaceUpcastEmptyArgsIsNoOp fences emitIfaceUpcast's defensive
// `len(Args) < 1` guard: with no source operand it silently emits nothing (no
// bytes, no error) rather than crashing or partially emitting. Well-formed IR
// always carries the source iv, so the guard never fires in practice; this pins
// it (parity with aa64's equivalent) so a future edit can't turn the silent guard
// into a fault or a half-built value.
func TestEmitOpIfaceUpcastEmptyArgsIsNoOp() testing.TestResult {
	setArm32TargetIface()
	var a @asm.Assembler = ifaceMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 7)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Op = iropcode.OP_IFACE_UPCAST
	ins.IfaceUpcastSlotOffset = 0
	// No Args (len < 1) — the guard should silently return.
	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.HasError {
		return fail("empty-Args OP_IFACE_UPCAST must not fail loud (defensive no-op)")
	}
	if a.Sections[0].Len != 0 {
		return fail("empty-Args OP_IFACE_UPCAST must emit nothing")
	}
	return ""
}

// hasMovIpToRegIface reports whether the text stream contains a `MOV Rd, IP`
// (Rd != IP) — the P4-c.3 dispatch moves the loaded method pointer OUT of IP into a
// pool reg before spilling it, so a large fnPtrSlot offset (which makes
// emitFrameStore clobber IP with the materialized offset) cannot corrupt the
// method pointer. Its absence means the pointer is spilled straight from IP (the
// pre-fix silent-wrong-code bug). MOV Rd,Rm (reg, no shift) =
// 0xE1A00000 | (Rd<<12) | Rm; Rm = IP = 0xC.
func hasMovIpToRegIface(a @asm.Assembler) bool {
	var n int = a.Sections[0].Len
	for i := 0; i + 3 < n; i = i + 4 {
		var w uint32 = word32(a, i)
		if (w & cast(uint32, 0xFFFF0FFF)) == cast(uint32, 0xE1A0000C) {
			if ((w >> 12) & cast(uint32, 0xF)) != cast(uint32, 0xC) {
				return true
			}
		}
	}
	return false
}

// methodSlotLdrImm returns the #imm of the `LDR IP, [IP, #imm]` that loads the
// method pointer from vtable[Index] (the second of the two-step vtable walk;
// Rn = Rd = IP, unique in the dispatch since the vtable load's base is a pool reg
// and the reload's base is SP), or -1 if absent. LDR Rd,[Rn,#imm] =
// 0xE5900000 | (Rn<<16) | (Rd<<12) | imm12, so LDR IP,[IP,#imm] = 0xE59CC000 | imm12.
func methodSlotLdrImm(a @asm.Assembler) int {
	var n int = a.Sections[0].Len
	for i := 0; i + 3 < n; i = i + 4 {
		var w uint32 = word32(a, i)
		if (w & cast(uint32, 0xFFFFF000)) == cast(uint32, 0xE59CC000) {
			return cast(int, w & cast(uint32, 0xFFF))
		}
	}
	return -1
}

// TestEmitCallIfaceMethodLargeFrameSpillsViaPoolReg: when the method-pointer spill
// slot lands past the 4095-byte ARM immediate range, the pointer must be moved out
// of IP into a pool reg before the spill — emitFrameStore uses IP as its own
// address scratch for a large offset, so spilling IP directly would overwrite the
// pointer with the offset (silent wrong-code: the later BLX branches through
// garbage). Also covered end-to-end by conformance/990_native_arm32_iface_large_frame
// (the pre-existing large-frame COMPILE_ERROR that previously shadowed this path is
// now fixed); this unit test additionally pins the exact MOV-out-of-IP-then-spill
// instruction sequence that conformance verifies only behaviorally.
func TestEmitCallIfaceMethodLargeFrameSpillsViaPoolReg() testing.TestResult {
	setArm32TargetIface()
	var a @asm.Assembler = ifaceMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	// Result slot (ID 2) spilled PAST #4095 — this is the fnPtrSlot (LookupSpill).
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 5000)

	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 1
	iv.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_CALL_IFACE_METHOD
	ins.Index = 2
	ins.Typ = types.TypVoid()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = iv

	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.HasError {
		return fail("large-frame iface dispatch must not fail loud in the emitter")
	}
	if !scanForBlxIp(a) {
		return fail("large-frame iface dispatch must still emit BLX IP")
	}
	if !hasMovIpToRegIface(a) {
		return fail(
				"large fnPtrSlot: the method pointer must be MOV'd out of IP into a "
						"pool reg before the spill (else emitFrameStore clobbers it with the offset)")
	}
	return ""
}

// TestEmitCallIfaceMethodSlotIndexScaled: the method-pointer load reads
// vtable[Index] at byte offset Index * wordBytes() (4 on ILP32). A wrong scale
// (*8 like LP64, or a stray +2) would dispatch the WRONG method — a silent
// miscompile — so pin the LDR immediate for a non-trivial Index.
func TestEmitCallIfaceMethodSlotIndexScaled() testing.TestResult {
	setArm32TargetIface()
	var a @asm.Assembler = ifaceMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 2)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)

	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 1
	iv.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_CALL_IFACE_METHOD
	ins.Index = 3
	ins.Typ = types.TypVoid()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = iv

	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.HasError {
		return fail("iface dispatch (Index 3) must not fail loud")
	}
	if methodSlotLdrImm(a) != wordBytes() * 3 {
		return fail("method-slot LDR must read vtable at Index * wordBytes() (3*4 = 12)")
	}
	return ""
}

// OP_DATA_SYM_ADDR materializes a LOCAL weak data symbol's address via the
// MOVW/MOVT-ABS reloc pair (emitSymAddr) and declares the symbol global — on
// arm32's non-PIE link the same idiom as OP_C_GLOBAL, no GOT.
func TestEmitDataSymAddrShape() testing.TestResult {
	setArm32TargetIface()
	var a @asm.Assembler = ifaceMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_DATA_SYM_ADDR
	ins.StrVal = "__typeinfo.bn_V1_4_main1_T"
	var strings @[]ir.StringConst
	var allFuncs @[]@ir.Func
	emitInstr(a, "main", "bn_entry", rm, strings, allFuncs, ins)
	if a.HasError {
		return fail("OP_DATA_SYM_ADDR should not fail loud")
	}
	if a.Sections[0].Len < 8 {
		return fail("OP_DATA_SYM_ADDR should emit at least a MOVW/MOVT pair (8 bytes)")
	}
	if a.LookupSymbol(symPrefixed("__typeinfo.bn_V1_4_main1_T")) < 0 {
		return fail("OP_DATA_SYM_ADDR should declare the symbol global")
	}
	return ""
}
