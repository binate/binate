package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the 64-bit cast (widen to / narrow from int64) and compare
// lowerings (arm32_int64_cast.bn).  rm64 / bin64 / dpOpcodeAt / sBitAt / condAt
// live in arm32_int64_test.bn.

// int64 signed LT lowers to SUBS lo + SBCS hi + MOV #0 + MOV<LT> #1: the
// full-width subtract sets flags and the conditional true-set reads LT.  After
// load64 a + load64 b (16 bytes): SUBS @16, SBCS @20, MOV #0 @24, MOV<c> #1 @28.
func TestCompare64SignedLtUsesLt() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = bin64(iropcode.OP_LT, types.TypInt64())
	ins.Typ = types.TypBool()
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle int64 OP_LT")
	}
	if dpOpcodeAt(a, 16) != cast(uint32, 0x2) || sBitAt(a, 16) != cast(uint32, 1) {
		return fail("int64 compare low word must be SUBS (opcode 0x2, S=1)")
	}
	if dpOpcodeAt(a, 20) != cast(uint32, 0x6) || sBitAt(a, 20) != cast(uint32, 1) {
		return fail("int64 compare high word must be SBCS (opcode 0x6, S=1)")
	}
	if condAt(a, 28) != cast(uint32, arm32.COND_LT) {
		return fail("signed int64 LT true-set must be conditioned LT")
	}
	return ""
}

// int64 UNSIGNED LT uses the LO condition on the true-set MOV (a high-bit-set
// uint64 must not sort negative).
func TestCompare64UnsignedLtUsesLo() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = bin64(iropcode.OP_LT, types.TypUint64())
	ins.Typ = types.TypBool()
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle uint64 OP_LT")
	}
	if condAt(a, 28) != cast(uint32, arm32.COND_LO) {
		return fail("unsigned int64 LT true-set must be conditioned LO")
	}
	return ""
}

// int64 signed GT is realized as LT with the operands swapped, so the surviving
// condition is still LT (b < a).  The swap must not change the condition family.
func TestCompare64SignedGtUsesLtSwapped() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = bin64(iropcode.OP_GT, types.TypInt64())
	ins.Typ = types.TypBool()
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle int64 OP_GT")
	}
	if condAt(a, 28) != cast(uint32, arm32.COND_LT) {
		return fail("signed int64 GT (b<a) true-set must be conditioned LT")
	}
	return ""
}

// int64 unsigned LE is realized as GE with the operands swapped (a<=b == b>=a),
// so the surviving condition is HS (unsigned >=).
func TestCompare64UnsignedLeUsesHsSwapped() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = bin64(iropcode.OP_LE, types.TypUint64())
	ins.Typ = types.TypBool()
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle uint64 OP_LE")
	}
	if condAt(a, 28) != cast(uint32, arm32.COND_HS) {
		return fail("unsigned int64 LE (b>=a) true-set must be conditioned HS")
	}
	return ""
}

// int64 EQ folds the words with EOR + EOR + ORRS then a conditional-EQ MOV;
// SBCS's Z alone can't express 64-bit equality, so EQ takes the EOR/ORR path.
// After 4 LDRs: EOR lo @16, EOR hi @20, ORRS @24, MOV #0 @28, MOV<EQ> #1 @32.
func TestCompare64EqUsesEorOrr() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = bin64(iropcode.OP_EQ, types.TypInt64())
	ins.Typ = types.TypBool()
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle int64 OP_EQ")
	}
	if dpOpcodeAt(a, 16) != cast(uint32, 0x1) ||
			dpOpcodeAt(a, 20) != cast(uint32, 0x1) {
		return fail("int64 EQ must EOR both words (opcode 0x1)")
	}
	if dpOpcodeAt(a, 24) != cast(uint32, 0xC) || sBitAt(a, 24) != cast(uint32, 1) {
		return fail("int64 EQ must ORRS the differences (opcode 0xC, S=1)")
	}
	if condAt(a, 32) != cast(uint32, arm32.COND_EQ) {
		return fail("int64 EQ true-set must be conditioned EQ")
	}
	return ""
}

// castWiden builds a widening OP_CAST from a 32-bit source (id 10, reg R5) to a
// 64-bit target, with a result spill slot at 0.
func castWiden(rm @common.RegMap, srcTyp @types.Type,
		tgtTyp @types.Type) @ir.Instr {
	rm.AssignReg(10, arm32.R5)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 0)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 10
	src.Typ = srcTyp
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, src)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CAST
	ins.Typ = tgtTyp
	ins.TypeArg = tgtTyp
	ins.Args = args
	return ins
}

// hasAsr31Mov reports whether any emitted instruction is a MOV (opcode 0xD)
// with an ASR shift by 31 — the sign-fill of a widening cast's high word.
func hasAsr31Mov(a @asm.Assembler) bool {
	for off := 0; off + 4 <= bytesWritten(a); off = off + 4 {
		var w uint32 = word32(a, off)
		if ((w >> 21) & cast(uint32, 0xf)) == cast(uint32, 0xD) &&
				((w >> 5) & cast(uint32, 0x3)) == cast(uint32, arm32.ASR) &&
				((w >> 7) & cast(uint32, 0x1f)) == cast(uint32, 31) {
			return true
		}
	}
	return false
}

// A widening cast int32 -> int64 (signed source) sign-fills the high word via
// MOV rd, lo ASR #31.
func TestCast64WidenSignedSignFills() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = castWiden(rm, types.TypInt(), types.TypInt64())
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle a widening cast to int64")
	}
	if !hasAsr31Mov(a) {
		return fail("signed widen must sign-fill hi via MOV ... ASR #31")
	}
	return ""
}

// A widening cast uint32 -> uint64 zero-fills the high word (no ASR-shift MOV).
func TestCast64WidenUnsignedZeroFills() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = castWiden(rm, types.TypUint32(), types.TypUint64())
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle a widening cast to uint64")
	}
	if hasAsr31Mov(a) {
		return fail("unsigned widen must NOT sign-fill (no ASR #31)")
	}
	return ""
}

// A narrowing cast int64 -> int takes the lo word into a registered 32-bit
// result (registered via nextReg, so the normal spill-reset stores it).
func TestCast64NarrowToIntTakesLoWord() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 10)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 10
	src.Typ = types.TypInt64()
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, src)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CAST
	ins.Typ = types.TypInt()
	ins.TypeArg = types.TypInt()
	ins.Args = args
	if !instrIs64(ins) {
		return fail("a narrowing cast from int64 must classify as 64-bit")
	}
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle a narrowing cast from int64")
	}
	if rm.LookupReg(0) < 0 {
		return fail("narrow result must be a registered 32-bit value")
	}
	return ""
}

// A 64-bit bit_cast (int64 <-> uint64) is a same-size bit reinterpret — a
// two-word pass-through.  emitInstr64 MUST handle OP_BIT_CAST (return true); the
// bug this pins was emitInstr64 having no OP_BIT_CAST case, so it fell through
// to the 32-bit OP_BIT_CAST path (a single-word MOV) and silently dropped the
// high word (produced wrong output on the int64 bit_cast conformance tests).
func TestBitCast64IsTwoWordPassThrough() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// source (id 10) at 64-bit spill slot 0; result (id 0) at slot 8.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 10)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 0)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 10
	src.Typ = types.TypInt64()
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, src)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_BIT_CAST
	ins.Typ = types.TypUint64()
	ins.TypeArg = types.TypUint64()
	ins.Args = args
	if !instrIs64(ins) {
		return fail("a 64-bit bit_cast must classify as 64-bit")
	}
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle a 64-bit OP_BIT_CAST (two-word "
			"pass-through), not fall through to the 32-bit single-word path")
	}
	return ""
}
