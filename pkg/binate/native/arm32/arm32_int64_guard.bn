package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Divide / shift guard calls (now that int64 args are register pairs)
// ============================================================
//
// rt.DivCheck(dividend int64, divisor int64, signedMin int64, isSigned int) and
// rt.ShiftCheck(count int64) take int64 args that IR-gen widens the checked
// operands to (so a variable int32 `/`/`%` and every int64 divide guard the
// same way).  On AAPCS32 an int64 arg occupies an even-aligned GP register pair
// (r0:r1 / r2:r3) or an 8-byte-aligned stack slot; the common CallConv walkers
// (CallArgRegStart / CallArgStackOff) place each arg, and PlanFrame reserves the
// outgoing-args tail for DivCheck's stack-spilled signedMin + isSigned (see
// isCallOp / callDispatchArgTypesAnyOp).

// placeInt64Arg marshals a 64-bit value (already in scratch regs lo/hi) into its
// AAPCS32 destination for a guard call: an even-aligned register pair
// (argReg(regStart):argReg(regStart+1)) or an 8-byte stack slot at
// [SP + stackOff] (lo) / [SP + stackOff + 4] (hi).
func placeInt64Arg(a @asm.Assembler, lo int, hi int, regStart int, stackOff int) {
	if regStart >= 0 {
		if lo != argReg(regStart) {
			arm32.Mov(a, arm32.COND_AL, false, argReg(regStart), arm32.Reg(lo))
		}
		if hi != argReg(regStart + 1) {
			arm32.Mov(a, arm32.COND_AL, false, argReg(regStart + 1), arm32.Reg(hi))
		}
		return
	}
	if stackOff >= 0 {
		arm32.Str(a, arm32.COND_AL, lo, arm32.MemImm(arm32.SP, stackOff))
		arm32.Str(a, arm32.COND_AL, hi, arm32.MemImm(arm32.SP, stackOff + 4))
	}
}

// placeInt32Arg marshals a 32-bit value in `src` into its AAPCS32 destination:
// argReg(regStart) or [SP + stackOff].
func placeInt32Arg(a @asm.Assembler, src int, regStart int, stackOff int) {
	if regStart >= 0 {
		if src != argReg(regStart) {
			arm32.Mov(a, arm32.COND_AL, false, argReg(regStart), arm32.Reg(src))
		}
		return
	}
	if stackOff >= 0 {
		arm32.Str(a, arm32.COND_AL, src, arm32.MemImm(arm32.SP, stackOff))
	}
}

// divCheckArgTypes is the AAPCS32 arg-type sequence for rt.DivCheck, used to
// drive CallArgRegStart / CallArgStackOff so the emitter and PlanFrame's
// outgoing-args sizing agree on where each arg lands.
func divCheckArgTypes() @[]@types.Type {
	var ts @[]@types.Type = make_slice(@types.Type, 4)
	ts[0] = types.TypInt64()
	ts[1] = types.TypInt64()
	ts[2] = types.TypInt64()
	ts[3] = types.TypInt()
	return ts
}

// emitDivCheck64 lowers OP_DIV_CHECK: call rt.DivCheck(dividend, divisor,
// signedMin, isSigned) with the int64 register-pair ABI.  dividend/divisor are
// the widened int64 operands (ins.Args[0]/[1]); signedMin comes from the carried
// width (ins.IntVal) and isSigned from ins.BoolVal.  Replaces the fail-loud stub
// now that int64 pairs work.
func emitDivCheck64(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 {
		a.SetError("native arm32: int64 div-check expects 2 operands")
		return
	}
	var ats @[]@types.Type = divCheckArgTypes()
	// Load the two int64 operands into scratch pairs, then place them into the
	// register pairs.  Load BOTH before placing so a load's frame-reload
	// (emitFrameLoad may use IP) can't clobber an arg register already set.
	var dlo int
	var dhi int
	dlo, dhi = load64(a, rm, ins.Args[0])
	if dlo < 0 {
		a.SetError("native arm32: int64 div-check dividend not materializable")
		return
	}
	var vlo int
	var vhi int
	vlo, vhi = load64(a, rm, ins.Args[1])
	if vlo < 0 {
		a.SetError("native arm32: int64 div-check divisor not materializable")
		return
	}
	// signedMin (int64) and isSigned (int) into scratch registers before any
	// arg-register placement (materializing them uses IP for large consts, and
	// argReg(0..3) must not be live yet).
	var signedMin int64 = types.SignedMinForWidth(cast(int, ins.IntVal))
	var smlo int = scratchReg(rm)
	materializeWord(a, smlo, cast(int, signedMin & cast(int64, 0xFFFFFFFF)))
	var smhi int = scratchReg(rm)
	materializeWord(a, smhi, cast(int, (signedMin >> cast(int64, 32)) & cast(int64, 0xFFFFFFFF)))
	var isSignedReg int = scratchReg(rm)
	var isSignedVal int = 0
	if ins.BoolVal { isSignedVal = 1 }
	emitConstInt32(a, isSignedReg, isSignedVal)
	// Place all args (registers first is fine — every source is a pool scratch,
	// none of which is r0-r3).
	placeInt64Arg(a, dlo, dhi, rm.CC.CallArgRegStart(ats, 0), rm.CC.CallArgStackOff(ats, 0))
	placeInt64Arg(a, vlo, vhi, rm.CC.CallArgRegStart(ats, 1), rm.CC.CallArgStackOff(ats, 1))
	placeInt64Arg(a, smlo, smhi, rm.CC.CallArgRegStart(ats, 2), rm.CC.CallArgStackOff(ats, 2))
	placeInt32Arg(a, isSignedReg, rm.CC.CallArgRegStart(ats, 3), rm.CC.CallArgStackOff(ats, 3))
	var callee @[]char = symPrefixed(mangleRtFunc("DivCheck"))
	a.SetGlobal(callee)
	arm32.Bl(a, arm32.COND_AL, callee)
	rm.ResetRegs()
}

// emitShiftCheck64 lowers OP_SHIFT_CHECK: call rt.ShiftCheck(count) with the
// count's int64 register pair in r0:r1.  count is ins.Args[0] (sign-extended to
// int64 by IR-gen).  Replaces the fail-loud stub.
func emitShiftCheck64(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 {
		a.SetError("native arm32: int64 shift-check expects 1 operand")
		return
	}
	var clo int
	var chi int
	clo, chi = load64(a, rm, ins.Args[0])
	if clo < 0 {
		a.SetError("native arm32: int64 shift-check count not materializable")
		return
	}
	// ShiftCheck(count int64): count -> r0:r1 (no stack).
	placeInt64Arg(a, clo, chi, 0, -1)
	var callee @[]char = symPrefixed(mangleRtFunc("ShiftCheck"))
	a.SetGlobal(callee)
	arm32.Bl(a, arm32.COND_AL, callee)
	rm.ResetRegs()
}
