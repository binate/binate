package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the divide / shift guard calls now that int64 args are
// register pairs (arm32_int64_guard.bn).

// gcRegMap builds a RegMap with two int64 operand spill slots (ids 10, 11 at
// offsets 0 / 8) and an outgoing-args area large enough for rt.DivCheck's
// stack-spilled tail (signedMin + isSigned = 12 bytes, rounded).  Callers that
// only exercise ShiftCheck (no stack args) still get the operand slots.
func gcRegMap() @common.RegMap {
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.OutgoingArgsSize = 16
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 10)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 11)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	return rm
}

// int64Operand builds an int64 operand instr with the given SSA id.
func int64Operand(id int) @ir.Instr {
	var o @ir.Instr = make(ir.Instr)
	o.ID = id
	o.Typ = types.TypInt64()
	return o
}

// OP_DIV_CHECK lowers to a BL rt.DivCheck and registers the callee symbol.  The
// two int64 operands go in r0:r1 / r2:r3 and signedMin + isSigned overflow to
// the outgoing-args area — the emitter must not error given a reserved region.
func TestDivCheckCallsRtDivCheck() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = gcRegMap()
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, int64Operand(10))
	args = appendInstr_arm32cmptest(args, int64Operand(11))
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_DIV_CHECK
	ins.Args = args
	ins.IntVal = cast(int64, 32)  // carried width (int32) for signedMin
	ins.BoolVal = true            // signed
	emitDivCheck(a, rm, ins)
	if a.HasError {
		return fail("DivCheck lowering must not error with a reserved args area")
	}
	if a.LookupSymbol(mangleRtFunc("DivCheck")) < 0 {
		return fail("DivCheck must reference the rt.DivCheck symbol")
	}
	return ""
}

// OP_SHIFT_CHECK lowers to a BL rt.ShiftCheck with the count's int64 pair in
// r0:r1 (no stack args) and registers the callee.
func TestShiftCheckCallsRtShiftCheck() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = gcRegMap()
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, int64Operand(10))
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_SHIFT_CHECK
	ins.Args = args
	emitShiftCheck(a, rm, ins)
	if a.HasError {
		return fail("ShiftCheck lowering must not error")
	}
	if a.LookupSymbol(mangleRtFunc("ShiftCheck")) < 0 {
		return fail("ShiftCheck must reference the rt.ShiftCheck symbol")
	}
	return ""
}

// The AAPCS32 walker places rt.DivCheck's four args as: dividend r0:r1,
// divisor r2:r3, signedMin on the stack (offset 0), isSigned on the stack
// (offset 8).  Pin this so the register-pair even-alignment + stack overflow is
// exactly what PlanFrame's outgoing-args sizing reserves.
func TestDivCheckArgPlacement() testing.TestResult {
	var cc common.CallConv = common.AAPCS32()
	var ats @[]@types.Type = make_slice(@types.Type, 4)
	ats[0] = types.TypInt64()
	ats[1] = types.TypInt64()
	ats[2] = types.TypInt64()
	ats[3] = types.TypInt()
	if cc.CallArgRegStart(ats, 0) != 0 {
		return fail("dividend (int64) must start at r0 (pair r0:r1)")
	}
	if cc.CallArgRegStart(ats, 1) != 2 {
		return fail("divisor (int64) must start at r2 (pair r2:r3)")
	}
	if cc.CallArgRegStart(ats, 2) != -1 || cc.CallArgStackOff(ats, 2) != 0 {
		return fail("signedMin (int64) must overflow to stack offset 0")
	}
	if cc.CallArgRegStart(ats, 3) != -1 || cc.CallArgStackOff(ats, 3) != 8 {
		return fail("isSigned (int) must land at stack offset 8")
	}
	return ""
}
