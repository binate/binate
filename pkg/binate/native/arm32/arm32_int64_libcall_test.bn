package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the __aeabi-libcall 64-bit ops (arm32_int64_libcall.bn):
// mul / divide / remainder / shift.  Each asserts the correct AEABI helper
// symbol is referenced (the register marshaling is exercised end-to-end by the
// conformance suite).  rm64 / bin64 live in arm32_int64_test.bn.

// int64 MUL calls __aeabi_lmul and registers the symbol.
func TestMul64CallsAeabiLmul() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = bin64(iropcode.OP_MUL, types.TypInt64())
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle int64 OP_MUL")
	}
	if a.LookupSymbol("__aeabi_lmul") < 0 {
		return fail("int64 MUL must reference __aeabi_lmul")
	}
	return ""
}

// int64 signed DIV calls __aeabi_ldivmod; uint64 DIV calls __aeabi_uldivmod.
func TestDiv64SignedCallsLdivmod() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = bin64(iropcode.OP_DIV, types.TypInt64())
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle int64 OP_DIV")
	}
	if a.LookupSymbol("__aeabi_ldivmod") < 0 {
		return fail("signed int64 DIV must reference __aeabi_ldivmod")
	}
	return ""
}

func TestDiv64UnsignedCallsUldivmod() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = bin64(iropcode.OP_DIV, types.TypUint64())
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle uint64 OP_DIV")
	}
	if a.LookupSymbol("__aeabi_uldivmod") < 0 {
		return fail("unsigned int64 DIV must reference __aeabi_uldivmod")
	}
	return ""
}

// int64 REM reuses __aeabi_ldivmod (remainder comes back in r2:r3 from the same
// helper as the quotient).
func TestRem64SignedCallsLdivmod() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = bin64(iropcode.OP_REM, types.TypInt64())
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle int64 OP_REM")
	}
	if a.LookupSymbol("__aeabi_ldivmod") < 0 {
		return fail("signed int64 REM must reference __aeabi_ldivmod")
	}
	return ""
}

// int64 SHL calls __aeabi_llsl; signed SHR calls __aeabi_lasr; unsigned SHR
// calls __aeabi_llsr.
func TestShl64CallsLlsl() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = bin64(iropcode.OP_SHL, types.TypInt64())
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle int64 OP_SHL")
	}
	if a.LookupSymbol("__aeabi_llsl") < 0 {
		return fail("int64 SHL must reference __aeabi_llsl")
	}
	return ""
}

func TestShr64SignedCallsLasr() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = bin64(iropcode.OP_SHR, types.TypInt64())
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle signed int64 OP_SHR")
	}
	if a.LookupSymbol("__aeabi_lasr") < 0 {
		return fail("signed int64 SHR must reference __aeabi_lasr (arithmetic)")
	}
	return ""
}

func TestShr64UnsignedCallsLlsr() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = bin64(iropcode.OP_SHR, types.TypUint64())
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle unsigned int64 OP_SHR")
	}
	if a.LookupSymbol("__aeabi_llsr") < 0 {
		return fail("unsigned int64 SHR must reference __aeabi_llsr (logical)")
	}
	return ""
}
