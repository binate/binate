package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// 64-bit load / store (two 32-bit LDR/STR at +0 / +4)
// ============================================================
//
// An int64 in memory is two little-endian words: lo at [addr+0], hi at
// [addr+4].  A single 64-bit LDRD/STRD would work but needs new assembler
// encoders; two LDR/STR is simpler and correct.  Address resolution mirrors the
// scalar emitLoad / emitStore: a frame alloca (SP-relative, via emitFrameLoad /
// emitFrameStore), a package-level global (MOVW/MOVT), or a pointer in a
// register.

// emitLoad64 lowers OP_LOAD of an int64 / uint64: read lo/hi from the source
// address and store the pair into the loaded value's spill slot.
func emitLoad64(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr,
		arg @ir.Instr) {
	var lo int = scratchReg(rm)
	var hi int = scratchReg(rm)
	var off int = rm.LookupAlloc(arg.ID)
	if off >= 0 {
		emitFrameLoad(a, lo, off)
		emitFrameLoad(a, hi, off + 4)
		store64(a, rm, ins, lo, hi)
		return
	}
	var addr int
	if isGlobalRef(arg) {
		addr = scratchReg(rm)
		emitGlobalAddr(a, pkgName, addr, arg)
	} else {
		addr = getOperand(a, rm, arg.ID)
	}
	if addr < 0 {
		a.SetError("native arm32: int64 load address not materializable")
		return
	}
	arm32.Ldr(a, arm32.COND_AL, lo, arm32.MemImm(addr, 0))
	arm32.Ldr(a, arm32.COND_AL, hi, arm32.MemImm(addr, 4))
	store64(a, rm, ins, lo, hi)
}

// emitStore64 lowers OP_STORE of an int64 / uint64: load the value's pair
// (Args[1]) and write lo/hi to the destination address (Args[0]).
func emitStore64(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	var lo int
	var hi int
	lo, hi = load64(a, rm, ins.Args[1])
	if lo < 0 {
		a.SetError("native arm32: int64 store value not materializable")
		return
	}
	var off int = rm.LookupAlloc(ins.Args[0].ID)
	if off >= 0 {
		emitFrameStore(a, lo, off)
		emitFrameStore(a, hi, off + 4)
		return
	}
	var addr int
	if isGlobalRef(ins.Args[0]) {
		addr = scratchReg(rm)
		emitGlobalAddr(a, pkgName, addr, ins.Args[0])
	} else {
		addr = getOperand(a, rm, ins.Args[0].ID)
	}
	if addr < 0 {
		a.SetError("native arm32: int64 store address not materializable")
		return
	}
	arm32.Str(a, arm32.COND_AL, lo, arm32.MemImm(addr, 0))
	arm32.Str(a, arm32.COND_AL, hi, arm32.MemImm(addr, 4))
}

// emitExtract64 lowers OP_EXTRACT of an int64 / uint64 field: read the field's
// lo/hi words and store the pair into ins's spill slot (the register-pair value
// model), rather than a single register.  Two source shapes mirror emitExtract's
// scalar arms: when the source spill holds a POINTER to the aggregate
// (SpillHoldsAggregatePointer — built-in headers whose 64-bit field is <= 16
// bytes in), read [ptr+fieldOff] / [+4]; otherwise the source spill holds the
// tuple bytes DIRECTLY (multi-return destructuring), so read [SP+srcSlot+fieldOff]
// / [+4].  The field offset comes from FieldOffset for a struct source (its
// 8-aligned int64 field), else word*Index.  IP is the address scratch for a large
// SP-relative offset; the load scratches are pool registers, never IP.
func emitExtract64(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr, src @ir.Instr) {
	var w int = 4
	var fieldOff int = w * ins.Index
	var exTyp @types.Type = types.StripWrappers(src.Typ)
	if exTyp != nil && exTyp.Kind == types.TYP_STRUCT {
		fieldOff = exTyp.FieldOffset(ins.Index)
	}
	var lo int = scratchReg(rm)
	var hi int = scratchReg(rm)
	if common.SpillHoldsAggregatePointer(src) {
		var ptr int = getOperand(a, rm, src.ID)
		if ptr < 0 { return }
		emitBaseLoad(a, lo, ptr, fieldOff, arm32.IP)
		emitBaseLoad(a, hi, ptr, fieldOff + 4, arm32.IP)
		store64(a, rm, ins, lo, hi)
		return
	}
	var srcSlot int = rm.LookupSpill(src.ID)
	if srcSlot < 0 { return }
	emitFrameLoad(a, lo, srcSlot + fieldOff)
	emitFrameLoad(a, hi, srcSlot + fieldOff + 4)
	store64(a, rm, ins, lo, hi)
}

// emitPackReturnPair64 packs an int64 / uint64 multi-return field into the
// consecutive return-register pair argReg(retGp):argReg(retGp+1) — lo → retGp,
// hi → retGp+1 — for emitMultiReturnPack.  It loads the two words DIRECTLY into
// the destination return registers (from the value's spill slot, or materialized
// for an inline const), avoiding a pool-scratch intermediary and the parallel-move
// hazard that a scratch aliasing a return register would create.  Consecutive,
// NOT even-bumped, so a caller that collects this pair reads the same registers.
func emitPackReturnPair64(a @asm.Assembler, rm @common.RegMap, arg @ir.Instr, retGp int) {
	var loDst int = argReg(retGp)
	var hiDst int = argReg(retGp + 1)
	var off int = rm.LookupSpill(arg.ID)
	if off >= 0 {
		emitFrameLoad(a, loDst, off)
		emitFrameLoad(a, hiDst, off + 4)
		return
	}
	if arg.Op == iropcode.OP_CONST_INT {
		materializeWord(a, loDst, cast(int, arg.IntVal & cast(int64, 0xFFFFFFFF)))
		materializeWord(a, hiDst, cast(int, (arg.IntVal >> cast(int64, 32)) & cast(int64, 0xFFFFFFFF)))
		return
	}
	a.SetError("native arm32: int64 multi-return field not materializable")
}
