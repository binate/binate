package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for 64-bit load / store (arm32_int64_mem.bn): two LDR / STR words
// at +0 / +4.  rm64 / dpOpcodeAt live in arm32_int64_test.bn.

// countLdr / countStr count LDR / STR (word, immediate) instructions among the
// emitted words.  LDR/STR word-immediate: bits [27:26]=01, B(bit22)=0; L(bit20)
// selects load (1) vs store (0).
func countLdrStr(a @asm.Assembler, load bool) int {
	var want uint32 = cast(uint32, 0)
	if load { want = cast(uint32, 1) }
	var n int = 0
	for off := 0; off + 4 <= bytesWritten(a); off = off + 4 {
		var w uint32 = word32(a, off)
		if ((w >> 26) & cast(uint32, 0x3)) == cast(uint32, 0x1) &&
				((w >> 22) & cast(uint32, 0x1)) == cast(uint32, 0) && ((w >> 20) & cast(uint32, 0x1)) == want {
			n = n + 1
		}
	}
	return n
}

// emitLoad64 reads a 64-bit value from a frame-alloca source (two LDR) and
// stores the pair into the result slot (two STR).
func TestLoad64FromAllocaTwoLdrTwoStr() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// Source int64 lives in an alloca at frame offset 32; result spill slot at 0.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 10)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 32)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 0)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var ptr @ir.Instr = make(ir.Instr)
	ptr.ID = 10
	ptr.Typ = types.MakePointerType(types.TypInt64())
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, ptr)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_LOAD
	ins.Typ = types.TypInt64()
	ins.Args = args
	emitLoad(a, "main", rm, ins)
	if a.HasError {
		return fail("int64 load from an alloca must not error")
	}
	if countLdrStr(a, true) < 2 {
		return fail("int64 load must read both lo and hi words (2 LDR)")
	}
	if countLdrStr(a, false) < 2 {
		return fail("int64 load must store the pair to its slot (2 STR)")
	}
	return ""
}

// emitStore64 reads the value pair (two LDR from the value's slot) and writes
// both words to the destination alloca (two STR).
func TestStore64ToAllocaTwoLdrTwoStr() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// Destination alloca at 32; the stored int64 value lives in slot at 0.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 20)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 32)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 21)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var dst @ir.Instr = make(ir.Instr)
	dst.ID = 20
	dst.Typ = types.MakePointerType(types.TypInt64())
	var val @ir.Instr = make(ir.Instr)
	val.ID = 21
	val.Typ = types.TypInt64()
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, dst)
	args = appendInstr_arm32cmptest(args, val)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_STORE
	ins.Typ = types.TypVoid()
	ins.Args = args
	emitStore(a, "main", rm, ins)
	if a.HasError {
		return fail("int64 store to an alloca must not error")
	}
	if countLdrStr(a, true) < 2 {
		return fail("int64 store must load both value words (2 LDR)")
	}
	if countLdrStr(a, false) < 2 {
		return fail("int64 store must write both lo and hi words (2 STR)")
	}
	return ""
}

// emitExtract of an int64 field from a multi-return tuple whose bytes live
// directly in the source spill slot reads both lo/hi words (2 LDR) and stores
// the pair to the destination slot (2 STR) — NOT a single-register scalar load
// (which would fail loud / drop the high word).
func TestExtract64FromTupleSlotTwoLdrTwoStr() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// Tuple (int32, int64): field 0 int32 @0, field 1 int64 @8.  The tuple bytes
	// live directly in the source value's spill slot at frame offset 16; the
	// extracted int64's own result slot is at 0.
	var f @[]@types.Field = make_slice(@types.Field, 2)
	f[0] = make(types.Field)
	f[0].Type = types.TypInt32()
	f[1] = make(types.Field)
	f[1].Type = types.TypInt64()
	var tup @types.Type = types.MakeStructType("", f)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 30) // source tuple
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 0) // extracted int64 result
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 30
	src.Typ = tup
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, src)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_EXTRACT
	ins.Index = 1
	ins.Typ = types.TypInt64()
	ins.Args = args
	emitExtract(a, rm, ins)
	if a.HasError {
		return fail("int64 OP_EXTRACT from a tuple slot must not error")
	}
	if countLdrStr(a, true) < 2 {
		return fail("int64 extract must read both lo and hi words (2 LDR)")
	}
	if countLdrStr(a, false) < 2 {
		return fail("int64 extract must store the pair to its slot (2 STR)")
	}
	return ""
}

// extract64TupleBytes emits an int64-field OP_EXTRACT from a (int32, int64) tuple
// whose bytes live in the source spill slot, and returns the emitted text bytes.
// `wrap` optionally wraps the source type in a readonly modifier.
func extract64TupleBytes(wrap bool) @[]uint8 {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var f @[]@types.Field = make_slice(@types.Field, 2)
	f[0] = make(types.Field)
	f[0].Type = types.TypInt32()
	f[1] = make(types.Field)
	f[1].Type = types.TypInt64()
	var tup @types.Type = types.MakeStructType("", f)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 30) // source tuple @ frame offset 16
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 0) // extracted int64 result @ 0
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 30
	src.Typ = tup
	if wrap { src.Typ = types.MakeReadonlyType(tup) }
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, src)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_EXTRACT
	ins.Index = 1
	ins.Typ = types.TypInt64()
	ins.Args = args
	emitExtract(a, rm, ins)
	var out @[]uint8
	for off := 0; off + 4 <= bytesWritten(a); off = off + 4 {
		var w uint32 = word32(a, off)
		out = appendByte_arm32memtest(out, cast(uint8, w & cast(uint32, 0xff)))
		out = appendByte_arm32memtest(out, cast(uint8, (w >> 8) & cast(uint32, 0xff)))
		out = appendByte_arm32memtest(out, cast(uint8, (w >> 16) & cast(uint32, 0xff)))
		out = appendByte_arm32memtest(out, cast(uint8, (w >> 24) & cast(uint32, 0xff)))
	}
	return out
}

func appendByte_arm32memtest(s @[]uint8, v uint8) @[]uint8 {
	var n @[]uint8 = make_slice(uint8, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}

// emitExtract64's struct field-OFFSET decision reads `.Kind` (a Type FIELD that
// does NOT delegate through the TYP_READONLY wrapper), so it must peel ALL
// transparent wrappers via StripWrappers: extracting the int64 field must emit
// the SAME code whether the source struct is plain or readonly-wrapped.  A
// named-only peel (the old UnwrapNamed) left a readonly src TYP_READONLY — not
// TYP_STRUCT — so it used a flat word*index offset instead of FieldOffset(1) = 8,
// a different (wrong) byte stream.  (Defense-in-depth: the checker strips readonly
// for extract srcs; the wrapper is built here to exercise the peel directly.)
func TestExtract64ReadonlyStructMatchesPlain() testing.TestResult {
	var plain @[]uint8 = extract64TupleBytes(false)
	var ro @[]uint8 = extract64TupleBytes(true)
	if len(plain) != len(ro) || len(plain) == 0 {
		return fail("readonly-wrapped-struct extract must emit the same-length stream as plain")
	}
	for i := 0; i < len(plain); i++ {
		if plain[i] != ro[i] {
			return fail("readonly-wrapped-struct extract must be byte-identical to plain (peel the wrapper)")
		}
	}
	return ""
}
