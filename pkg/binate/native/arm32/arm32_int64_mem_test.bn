package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for 64-bit load / store (arm32_int64_mem.bn): two LDR / STR words
// at +0 / +4.  rm64 / dpOpcodeAt live in arm32_int64_test.bn.

// countLdr / countStr count LDR / STR (word, immediate) instructions among the
// emitted words.  LDR/STR word-immediate: bits [27:26]=01, B(bit22)=0; L(bit20)
// selects load (1) vs store (0).
func countLdrStr(a @asm.Assembler, load bool) int {
	var want uint32 = cast(uint32, 0)
	if load { want = cast(uint32, 1) }
	var n int = 0
	for off := 0; off + 4 <= bytesWritten(a); off = off + 4 {
		var w uint32 = word32(a, off)
		if ((w >> 26) & cast(uint32, 0x3)) == cast(uint32, 0x1) &&
				((w >> 22) & cast(uint32, 0x1)) == cast(uint32, 0) && ((w >> 20) & cast(uint32, 0x1)) == want {
			n = n + 1
		}
	}
	return n
}

// emitLoad64 reads a 64-bit value from a frame-alloca source (two LDR) and
// stores the pair into the result slot (two STR).
func TestLoad64FromAllocaTwoLdrTwoStr() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// Source int64 lives in an alloca at frame offset 32; result spill slot at 0.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 10)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 32)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 0)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var ptr @ir.Instr = make(ir.Instr)
	ptr.ID = 10
	ptr.Typ = types.MakePointerType(types.TypInt64())
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, ptr)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_LOAD
	ins.Typ = types.TypInt64()
	ins.Args = args
	emitLoad(a, "main", rm, ins)
	if a.HasError {
		return fail("int64 load from an alloca must not error")
	}
	if countLdrStr(a, true) < 2 {
		return fail("int64 load must read both lo and hi words (2 LDR)")
	}
	if countLdrStr(a, false) < 2 {
		return fail("int64 load must store the pair to its slot (2 STR)")
	}
	return ""
}

// emitStore64 reads the value pair (two LDR from the value's slot) and writes
// both words to the destination alloca (two STR).
func TestStore64ToAllocaTwoLdrTwoStr() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// Destination alloca at 32; the stored int64 value lives in slot at 0.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 20)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 32)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 21)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var dst @ir.Instr = make(ir.Instr)
	dst.ID = 20
	dst.Typ = types.MakePointerType(types.TypInt64())
	var val @ir.Instr = make(ir.Instr)
	val.ID = 21
	val.Typ = types.TypInt64()
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, dst)
	args = appendInstr_arm32cmptest(args, val)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_STORE
	ins.Typ = types.TypVoid()
	ins.Args = args
	emitStore(a, "main", rm, ins)
	if a.HasError {
		return fail("int64 store to an alloca must not error")
	}
	if countLdrStr(a, true) < 2 {
		return fail("int64 store must load both value words (2 LDR)")
	}
	if countLdrStr(a, false) < 2 {
		return fail("int64 store must write both lo and hi words (2 STR)")
	}
	return ""
}
