package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Byte-level tests for int64 / uint64 fields in a MULTI-RETURN tuple on native
// arm32 (ILP32): the caller-collect (storeMultiReturnTupleFieldsArm32), the
// callee in-register pack (emitMultiReturnPack), and the callee sret write
// (emitMultiReturnSret).  An int64 field is a CONSECUTIVE register pair — no
// even-pair bump (AAPCS §6.5 C.3's even rule is argument-only; the small-aggregate
// return coercion packs fields into r0..r3 in field order).  Each shape is pinned
// against a hand-built reference of the exact two-word sequence.  Shared helpers
// (setArm32Target / asmTextEqMarshal / mkAsm / word32 / bytesWritten / fail /
// appendInstr_arm32cmptest) live in sibling arm32 native test files.

// tupI64I32 builds a tuple (int64, int32): int64 @0 (r0:r1), int32 @8 (r2).
func tupI64I32() @types.Type {
	var f @[]@types.Field = make_slice(@types.Field, 2)
	f[0] = make(types.Field)
	f[0].Type = types.TypInt64()
	f[1] = make(types.Field)
	f[1].Type = types.TypInt32()
	return types.MakeStructType("", f)
}

// tupI32I64 builds a tuple (int32, int64): int32 @0 (r0), int64 @8 (r1:r2,
// consecutive — NOT r2:r3).
func tupI32I64() @types.Type {
	var f @[]@types.Field = make_slice(@types.Field, 2)
	f[0] = make(types.Field)
	f[0].Type = types.TypInt32()
	f[1] = make(types.Field)
	f[1].Type = types.TypInt64()
	return types.MakeStructType("", f)
}

// The caller-collect of an int64-FIRST tuple (int64, int32) stores r0→[base,0],
// r1→[base,4] (the int64 pair) then r2→[base,8] (the int32) — byte-identical to a
// hand-built reference of exactly those three word stores.
func TestCollectTupleInt64FirstConsecutivePair() testing.TestResult {
	setArm32Target()
	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	storeMultiReturnTupleFieldsArm32(got, tupI64I32(), arm32.SP, 0, 4, 4, arm32.IP)

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	emitBaseStore(ref, argReg(0), arm32.SP, 0, arm32.IP) // int64 lo @0
	emitBaseStore(ref, argReg(1), arm32.SP, 4, arm32.IP) // int64 hi @4
	emitBaseStore(ref, argReg(2), arm32.SP, 8, arm32.IP) // int32 @8

	if !asmTextEqMarshal(got, ref) {
		return fail("collect (int64,int32): int64 must land in r0:r1 at [0]/[4], int32 in r2 at [8]")
	}
	return ""
}

// The caller-collect of an int64 at a NON-first, 8-aligned offset (int32, int64)
// places the int64 pair in the CONSECUTIVE registers r1:r2 (no even-pair bump to
// r2:r3) while storing at the tuple's 8-aligned FieldOffset (8 / 12).  Reference:
// r0→[0] (int32), r1→[8] (int64 lo), r2→[12] (int64 hi).
func TestCollectTupleInt64NonFirstConsecutivePair() testing.TestResult {
	setArm32Target()
	var tup @types.Type = tupI32I64()
	if tup.FieldOffset(1) != 8 {
		return fail("test setup: int64 field of (int32,int64) must be at offset 8 (8-aligned)")
	}
	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	storeMultiReturnTupleFieldsArm32(got, tup, arm32.SP, 0, 4, 4, arm32.IP)

	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	emitBaseStore(ref, argReg(0), arm32.SP, 0, arm32.IP) // int32 @0
	emitBaseStore(ref, argReg(1), arm32.SP, 8, arm32.IP) // int64 lo @8 (r1, consecutive)
	emitBaseStore(ref, argReg(2), arm32.SP, 12, arm32.IP) // int64 hi @12 (r2)

	if !asmTextEqMarshal(got, ref) {
		return fail("collect (int32,int64): int64 must land CONSECUTIVELY in r1:r2, not r2:r3")
	}
	return ""
}

// A uint64 field collects the same way as int64 (isReg64Scalar matches both):
// consecutive pair, byte-identical to the int64-first reference.
func TestCollectTupleUint64FirstSameAsInt64() testing.TestResult {
	setArm32Target()
	var f @[]@types.Field = make_slice(@types.Field, 2)
	f[0] = make(types.Field)
	f[0].Type = types.TypUint64()
	f[1] = make(types.Field)
	f[1].Type = types.TypInt32()
	var tupU @types.Type = types.MakeStructType("", f)

	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	storeMultiReturnTupleFieldsArm32(got, tupU, arm32.SP, 0, 4, 4, arm32.IP)
	var ref @asm.Assembler = asm.New(4)
	ref.SetSection("text", -1)
	storeMultiReturnTupleFieldsArm32(ref, tupI64I32(), arm32.SP, 0, 4, 4, arm32.IP)

	if !asmTextEqMarshal(got, ref) {
		return fail("uint64 tuple field must collect identically to int64 (consecutive pair)")
	}
	return ""
}

// The in-register callee pack of a (int64, int32) return loads the int64 value's
// two words directly into the consecutive return registers r0:r1, then the int32
// into r2.  The int64 value lives in its spill slot (frame offset 8); the int32 in
// slot at 24.  Two LDR (the int64 pair into r0/r1) precede the int32's own load.
func TestPackReturnInt64FirstConsecutivePair() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.MultiReturnType = tupI64I32()
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 40) // int64 field value
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 41) // int32 field value
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 24)

	var v0 @ir.Instr = make(ir.Instr)
	v0.ID = 40
	v0.Typ = types.TypInt64()
	var v1 @ir.Instr = make(ir.Instr)
	v1.ID = 41
	v1.Typ = types.TypInt32()
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, v0)
	args = appendInstr_arm32cmptest(args, v1)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_RETURN
	ins.Args = args
	emitMultiReturnPack(a, "main", rm, ins)
	if a.HasError {
		return fail("int64 in-register multi-return pack must not fail loud")
	}
	// The int64 field's two words load into r0 and r1 (the consecutive pair);
	// confirm both LDRs target r0 then r1 (Rd in bits [15:12]).
	if !hasLdrIntoReg(a, arm32.R0) || !hasLdrIntoReg(a, arm32.R1) {
		return fail("int64 return field must load lo→r0 and hi→r1 (consecutive pair)")
	}
	return ""
}

// A soft-float float64 tuple field is still unhandled: the pack must fail LOUDLY
// rather than misplace it (only int64/uint64 are supported; float64 is P5).
func TestPackReturnFloat64FieldFailsLoud() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var f @[]@types.Field = make_slice(@types.Field, 2)
	f[0] = make(types.Field)
	f[0].Type = types.TypFloat64()
	f[1] = make(types.Field)
	f[1].Type = types.TypInt32()
	rm.MultiReturnType = types.MakeStructType("", f)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 50)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 51)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 24)
	var v0 @ir.Instr = make(ir.Instr)
	v0.ID = 50
	v0.Typ = types.TypFloat64()
	var v1 @ir.Instr = make(ir.Instr)
	v1.ID = 51
	v1.Typ = types.TypInt32()
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, v0)
	args = appendInstr_arm32cmptest(args, v1)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_RETURN
	ins.Args = args
	emitMultiReturnPack(a, "main", rm, ins)
	if !a.HasError {
		return fail("a float64 multi-return field must still fail loud (P5)")
	}
	return ""
}

// A BIG multi-return tuple carrying an int64 field is written through the sret
// buffer: the int64 field emits TWO STRs (lo/hi at fldOff / +4), each other field
// one.  {int64, int32, int32, int32, int32} is 6 GP words (> 4 → sret) and must
// emit 5 field-stores + 1 = 6 STR total (2 for the int64, 4 for the int32s), NOT
// fail loud.
func TestSretMultiReturnInt64FieldWritesPair() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SretSlotOff = 0 // sret active for the big multi-return
	var fields @[]@types.Field = make_slice(@types.Field, 5)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt64()
	var args @[]@ir.Instr
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 60)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 100)
	var i64arg @ir.Instr = make(ir.Instr)
	i64arg.ID = 60
	i64arg.Typ = types.TypInt64()
	args = appendInstr_arm32cmptest(args, i64arg)
	for i := 1; i < 5; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt32()
		rm.SpillIDs = common.AppendInt(rm.SpillIDs, 60 + i)
		rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 120 + 4 * i)
		var arg @ir.Instr = make(ir.Instr)
		arg.ID = 60 + i
		arg.Typ = types.TypInt32()
		args = appendInstr_arm32cmptest(args, arg)
	}
	rm.MultiReturnType = types.MakeStructType("", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_RETURN
	ins.Args = args
	emitReturn(a, "main", rm, ins)
	if a.HasError {
		return fail("a big multi-return sret with an int64 field must lower, not error")
	}
	// The int64 field's two words + the four int32 fields = 6 STR field-stores.
	if countStrImm(a) != 6 {
		return fail("sret int64 field must emit 2 STR (lo/hi) + 4 for the int32s = 6 total")
	}
	return ""
}

// hasLdrIntoReg reports whether any LDR (word, immediate) among the emitted words
// targets register rd (Rd in bits [15:12]).  LDR word-immediate: bits [27:26]=01,
// B(bit22)=0, L(bit20)=1.
func hasLdrIntoReg(a @asm.Assembler, rd int) bool {
	for off := 0; off + 4 <= bytesWritten(a); off = off + 4 {
		var w uint32 = word32(a, off)
		if ((w >> 26) & cast(uint32, 0x3)) == cast(uint32, 0x1) &&
				((w >> 22) & cast(uint32, 0x1)) == cast(uint32, 0) &&
				((w >> 20) & cast(uint32, 0x1)) == cast(uint32, 0x1) &&
				cast(int, (w >> 12) & cast(uint32, 0xF)) == rd {
			return true
		}
	}
	return false
}
