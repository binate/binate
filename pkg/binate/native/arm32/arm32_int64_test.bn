package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the 64-bit (int64 / uint64) register-pair core lowering
// (arm32_int64.bn): classification, const materialization, the per-word
// add / sub / bitwise binops, and the unary neg / bitnot.  Also hosts the
// shared int64-test builders used by the libcall / cast / mem test files.
// The pair lives in an 8-byte frame slot (lo at +0, hi at +4); load64 reloads
// both words, store64 writes them back.

// rm64 builds a RegMap with three int64 spill slots: operand a at 0, operand b
// at 8, and the result at 16.  Frame offsets are 8-byte-granular, matching
// PlanFrame's real layout.
func rm64() @common.RegMap {
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 10) // operand a
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 11) // operand b
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 0) // result
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	return rm
}

// bin64 builds a two-operand int64 OP_<op> instr (ids 10, 11 -> result 0) of
// type `typ`, with the operand spill slots rm64 lays out.
func bin64(op int, typ @types.Type) @ir.Instr {
	var l @ir.Instr = make(ir.Instr)
	l.ID = 10
	l.Typ = typ
	var r @ir.Instr = make(ir.Instr)
	r.ID = 11
	r.Typ = typ
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, l)
	args = appendInstr_arm32cmptest(args, r)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = op
	ins.Typ = typ
	ins.Args = args
	return ins
}

// un64 builds a one-operand int64 OP_<op> instr (id 10 -> result 0).
func un64(op int, typ @types.Type) @ir.Instr {
	var l @ir.Instr = make(ir.Instr)
	l.ID = 10
	l.Typ = typ
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, l)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = op
	ins.Typ = typ
	ins.Args = args
	return ins
}

// dpOpcodeAt returns the data-processing opcode field (bits [24:21]) of the
// instruction at byte offset `off`.
func dpOpcodeAt(a @asm.Assembler, off int) uint32 {
	return (word32(a, off) >> 21) & cast(uint32, 0xf)
}

// sBitAt returns the S (set-flags) bit (bit 20) of the instruction at `off`.
func sBitAt(a @asm.Assembler, off int) uint32 {
	return (word32(a, off) >> 20) & cast(uint32, 0x1)
}

// condAt returns the condition field (bits [31:28]) of the instruction at `off`.
func condAt(a @asm.Assembler, off int) uint32 {
	return word32(a, off) >> 28
}

// rdAt returns the destination register field (bits [15:12]) of the instruction
// at `off` — Rd for a data-processing op (MOV), Rt for a load/store (LDR/STR).
func rdAt(a @asm.Assembler, off int) uint32 {
	return (word32(a, off) >> 12) & cast(uint32, 0xf)
}

// rnAt returns the base/first-operand register field (bits [19:16]) of the
// instruction at `off` — Rn for a data-processing op, the base register for a
// load/store.
func rnAt(a @asm.Assembler, off int) uint32 {
	return (word32(a, off) >> 16) & cast(uint32, 0xf)
}

// imm12At returns the 12-bit immediate offset (bits [11:0]) of a load/store
// with an immediate offset at `off`.
func imm12At(a @asm.Assembler, off int) uint32 {
	return word32(a, off) & cast(uint32, 0xfff)
}

// instrIs64 classifies an int64-result binop for the 64-bit path.
func TestInstrIs64ClassifiesInt64Result() testing.TestResult {
	var ins @ir.Instr = bin64(iropcode.OP_ADD, types.TypInt64())
	if !instrIs64(ins) {
		return fail("an int64 OP_ADD must classify as a 64-bit op")
	}
	var ins32 @ir.Instr = bin64(iropcode.OP_ADD, types.TypInt())
	if instrIs64(ins32) {
		return fail("a 32-bit OP_ADD must NOT classify as a 64-bit op")
	}
	return ""
}

// instrIs64 classifies an int64-OPERAND compare (bool result) as 64-bit.
func TestInstrIs64ClassifiesInt64Compare() testing.TestResult {
	var ins @ir.Instr = bin64(iropcode.OP_LT, types.TypInt64())
	ins.Typ = types.TypBool()
	if !instrIs64(ins) {
		return fail("a compare on int64 operands must classify as 64-bit")
	}
	return ""
}

// emitInstr64 lowers int64 ADD as ADDS lo (S=1) + ADC hi (S=0): the low word
// carry-sets the flags, the high word consumes them.  Sequence after the 4 LDRs
// (load64 a + load64 b): ADDS @16, ADC @20.
func TestAdd64EmitsAddsAdc() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = bin64(iropcode.OP_ADD, types.TypInt64())
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle int64 OP_ADD")
	}
	if dpOpcodeAt(a, 16) != cast(uint32, 0x4) || sBitAt(a, 16) != cast(uint32, 1) {
		return fail("int64 ADD low word must be ADDS (opcode 0x4, S=1)")
	}
	if dpOpcodeAt(a, 20) != cast(uint32, 0x5) || sBitAt(a, 20) != cast(uint32, 0) {
		return fail("int64 ADD high word must be ADC (opcode 0x5, S=0)")
	}
	return ""
}

// int64 SUB is SUBS lo (S=1) + SBC hi (S=0).
func TestSub64EmitsSubsSbc() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = bin64(iropcode.OP_SUB, types.TypInt64())
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle int64 OP_SUB")
	}
	if dpOpcodeAt(a, 16) != cast(uint32, 0x2) || sBitAt(a, 16) != cast(uint32, 1) {
		return fail("int64 SUB low word must be SUBS (opcode 0x2, S=1)")
	}
	if dpOpcodeAt(a, 20) != cast(uint32, 0x6) || sBitAt(a, 20) != cast(uint32, 0) {
		return fail("int64 SUB high word must be SBC (opcode 0x6, S=0)")
	}
	return ""
}

// int64 AND is two independent AND ops (opcode 0x0), no carry chain.
func TestAnd64EmitsPerWordAnd() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = bin64(iropcode.OP_AND, types.TypInt64())
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle int64 OP_AND")
	}
	if dpOpcodeAt(a, 16) != cast(uint32, 0x0) || dpOpcodeAt(a, 20) != cast(uint32, 0x0) {
		return fail("int64 AND must be two AND ops (opcode 0x0)")
	}
	return ""
}

// int64 XOR is two EOR ops (opcode 0x1).
func TestXor64EmitsPerWordEor() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = bin64(iropcode.OP_XOR, types.TypInt64())
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle int64 OP_XOR")
	}
	if dpOpcodeAt(a, 16) != cast(uint32, 0x1) || dpOpcodeAt(a, 20) != cast(uint32, 0x1) {
		return fail("int64 XOR must be two EOR ops (opcode 0x1)")
	}
	return ""
}

// int64 NEG is RSBS lo,#0 (opcode 0x3, S=1) + RSC hi,#0 (opcode 0x7, S=0).
// After load64 (2 LDR): RSBS @8, RSC @12.
func TestNeg64EmitsRsbsRsc() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = un64(iropcode.OP_NEG, types.TypInt64())
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle int64 OP_NEG")
	}
	if dpOpcodeAt(a, 8) != cast(uint32, 0x3) || sBitAt(a, 8) != cast(uint32, 1) {
		return fail("int64 NEG low word must be RSBS (opcode 0x3, S=1)")
	}
	if dpOpcodeAt(a, 12) != cast(uint32, 0x7) || sBitAt(a, 12) != cast(uint32, 0) {
		return fail("int64 NEG high word must be RSC (opcode 0x7, S=0)")
	}
	return ""
}

// int64 BITNOT is MVN lo + MVN hi (opcode 0xF).
func TestBitnot64EmitsMvnMvn() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = rm64()
	var ins @ir.Instr = un64(iropcode.OP_BITNOT, types.TypInt64())
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle int64 OP_BITNOT")
	}
	if dpOpcodeAt(a, 8) != cast(uint32, 0xF) || dpOpcodeAt(a, 12) != cast(uint32, 0xF) {
		return fail("int64 BITNOT must be two MVN ops (opcode 0xF)")
	}
	return ""
}

// An int64 emitter must fail LOUDLY (a.SetError) — not silently drop the value
// — when an operand can't be materialized.  With the operand SSA ids given NO
// spill slot (an empty RegMap) and a non-const operand Op (so load64's inline-
// const path is not taken either), load64 returns (-1, -1); the value-producing
// emitBinop64Simple must SetError rather than emit nothing for a value-producing
// op.  Mirrors TestDispatchUnimplementedOpSetsError's fail-loud contract.
func TestBinop64UnmaterializableOperandSetsError() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32()) // no spill slots
	var ins @ir.Instr = bin64(iropcode.OP_ADD, types.TypInt64())
	// The operands default to Op 0; force a non-const Op so load64 cannot take
	// its inline-OP_CONST_INT materialization branch and instead misses (-1).
	ins.Args[0].Op = iropcode.OP_ADD
	ins.Args[1].Op = iropcode.OP_ADD
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must claim int64 OP_ADD (and SetError on miss)")
	}
	if !a.HasError {
		return fail("int64 binop on an unmaterializable operand must SetError")
	}
	return ""
}

// The int64 guard emitters (OP_DIV_CHECK) must likewise fail LOUDLY on an
// unmaterializable operand rather than silently ELIDE the divide-by-zero /
// INT64_MIN-÷-1 trap call — a dropped guard is a silent correctness hole.
func TestDivCheck64UnmaterializableOperandSetsError() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32()) // no spill slots
	var ins @ir.Instr = bin64(iropcode.OP_DIV, types.TypInt64())
	ins.Op = iropcode.OP_DIV_CHECK
	ins.Args[0].Op = iropcode.OP_ADD
	ins.Args[1].Op = iropcode.OP_ADD
	emitDivCheck64(a, rm, ins)
	if !a.HasError {
		return fail("int64 div-check on an unmaterializable operand must SetError")
	}
	return ""
}

// int64 constant materialization stores BOTH words to the slot (no single-reg
// spillAndReset), so load64 later sees the full 64-bit value.
func TestConst64StoresBothWords() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 0)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CONST_INT
	ins.Typ = types.TypInt64()
	ins.IntVal = cast(int64, 0x100000001) // hi word 1, lo word 1
	if !emitInstr64(a, "main", rm, ins) {
		return fail("emitInstr64 must handle an int64 OP_CONST_INT")
	}
	// The result must NOT be recorded as a single register (store64 writes the
	// pair directly), so a following spillAndReset is inert.
	if rm.LookupReg(0) >= 0 {
		return fail("int64 const must not register a single result reg")
	}
	// Two STRs (lo, hi) must appear among the emitted instructions.
	var strCount int = 0
	for off := 0; off + 4 <= bytesWritten(a); off = off + 4 {
		var w uint32 = word32(a, off)
		// STR (word, immediate offset): bits [27:26]=01, L(bit20)=0, B(bit22)=0.
		if ((w >> 26) & cast(uint32, 0x3)) == cast(uint32, 0x1) &&
				((w >> 20) & cast(uint32, 0x1)) == cast(uint32, 0) &&
				((w >> 22) & cast(uint32, 0x1)) == cast(uint32, 0) {
			strCount = strCount + 1
		}
	}
	if strCount < 2 {
		return fail("int64 const must store both lo and hi words")
	}
	return ""
}
