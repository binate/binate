package "pkg/binate/native/arm32"

import "pkg/binate/types"

// A type's layout on arm32 fits a 32-bit int: no type may be larger than the target
// int's maximum (spec type.layout.max-size) -- the checker rejects one, and types'
// Size() / Offset() fail loud on one that reaches layout -- so a size, a field offset or
// an array length narrows to int exactly on any host.  A frame may still pass 2^31 (the
// sum of its regions), which is why frame offsets stay int64.

// layoutIntArm32 returns v, a layout value of an arm32 type, as int, failing loud on
// one that does not fit a 32-bit int.
func layoutIntArm32(v int64) int {
	if v < -0x80000000 || v > 0x7FFFFFFF {
		panic("native arm32: a type's layout value past a 32-bit target's object size")
	}
	return cast(int, v)
}

// sizeArm32 returns t's size as int.
func sizeArm32(t @types.Type) int {
	return layoutIntArm32(t.Size())
}

// offsetArm32 returns the offset of t's field i as int.
func offsetArm32(t @types.Type, i int) int {
	return layoutIntArm32(t.Offset(i))
}

// arrayLenArm32 returns t's array length as int.
func arrayLenArm32(t @types.Type) int {
	return layoutIntArm32(t.ArrayLen)
}
