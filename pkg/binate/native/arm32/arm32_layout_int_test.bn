package "pkg/binate/native/arm32"

import "pkg/binate/types"
import "pkg/builtins/testing"

// A type just under the 32-bit target's object size (2^31 - 1 bytes) has a size and
// field offsets that narrow to int exactly, on a 64-bit or a 32-bit host.
func TestLayoutIntNearObjectLimitArm32() testing.TestResult {
	setArm32Target()
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.MakeArrayType(types.TypUint8(), 0x7FFFFFF0)
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt32()
	var t @types.Type = types.MakeStructType("Big", fields)
	if offsetArm32(t, 1) != 0x7FFFFFF0 { return fail("the int32 field should sit at 0x7FFFFFF0") }
	if sizeArm32(t) != 0x7FFFFFF4 { return fail("the struct should be 0x7FFFFFF4 bytes") }
	if arrayLenArm32(fields[0].Type) != 0x7FFFFFF0 {
		return fail("the array should have 0x7FFFFFF0 elements")
	}
	if layoutIntArm32(0x7FFFFFFF) != 0x7FFFFFFF { return fail("2^31 - 1 narrows exactly") }
	return ""
}
