package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Managed allocations: OP_MAKE_SLICE, OP_MAKE and OP_BOX, each a call into the
// runtime (rt.MakeManagedSlice / rt.Alloc / rt.Box).  Mirrors x64_managed.bn.

// emitMakeSlice: OP_MAKE_SLICE — call `rt.MakeManagedSlice(elemSize, len)`.  The
// LLVM-compiled runtime materializes the ManagedSlice return through the AAPCS32
// sret pointer (a 16-byte managed-slice on ILP32 exceeds the AAPCS32 4-byte sret
// threshold, so it is returned via a hidden pointer arg in R0).  We hand it the
// data region reserved
// by PlanFrame and produce a pointer to that region.  AAPCS32 shifts the real
// args right by one for the sret pointer: elemSize → R1, len → R2, sret → R0.
func emitMakeSlice(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 || ins.TypeArg == nil { return }
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	var lenReg int = getOperand(a, rm, ins.Args[0].ID)
	if lenReg < 0 { return }
	// Move len before clobbering the arg registers: len → R2, elemSize → R1.
	arm32.Mov(a, arm32.COND_AL, false, arm32.R2, arm32.Reg(lenReg))
	emitConstInt32(a, arm32.R1, ins.TypeArg.SizeOf())
	// sret pointer to the data region → R0.  emitFrameAddr uses IP as its
	// large-offset scratch, which is safe here: R1/R2 (already set) and R0 are
	// untouched by it.
	emitFrameAddr(a, arm32.R0, dataOff)
	var callee @[]char = symPrefixed(mangleRtFunc("MakeManagedSlice"))
	a.SetGlobal(callee)
	arm32.Bl(a, arm32.COND_AL, callee)
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	emitFrameAddr(a, rd, dataOff)
}

// emitMake: OP_MAKE — call rt.Alloc(SizeOf(T)) for a fresh, zero-initialized @T
// with refcount 1.  The payload size goes in R0 (rt.Alloc(payloadSize int)); the
// fresh managed pointer comes back in R0 and moves to the result register.
// Mirrors aarch64_emit.bn emitMake with the ILP32 word size.
func emitMake(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if ins.TypeArg == nil { return }
	emitConstInt32(a, arm32.R0, ins.TypeArg.SizeOf())
	var callee @[]char = symPrefixed(mangleRtFunc("Alloc"))
	a.SetGlobal(callee)
	arm32.Bl(a, arm32.COND_AL, callee)
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Reg(arm32.R0))
}

// emitBox: OP_BOX — call rt.Box(srcPtr, size) to heap-copy the operand's value,
// whose type is the boxed type (ir.BoxedType, which gives the size), into a
// fresh managed cell.  Two source shapes, mirroring aarch64_emit.bn emitBox:
//   - aggregate operand: getOperand resolves it to a pointer to its data region;
//     use that pointer directly as srcPtr.
//   - scalar operand, a pointer included even when it is a slot's or a global's
//     address (`box(&x)`, `box(&G)`): read it home-aware (a register-homed
//     scalar — GP home, or an FP-homed float in a D-register — lives in its home,
//     not a slot; emitValOperand materializes a global's address) and store it
//     into the box's own spill slot, free until the box's result is written, then
//     box from that slot's address.  A 64-bit pair (int64 / float64) writes both
//     words via load64; a 32-bit scalar one word.
// Missing type or frame information is an internal error, reported rather than
// leaving the box's result unwritten.  R0 = srcPtr, R1 = size; the fresh managed
// pointer returns in R0.
func emitBox(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	var boxed @types.Type = ir.BoxedType(ins)
	if len(ins.Args) < 1 || boxed == nil {
		a.SetError("native arm32: an OP_BOX without an operand or a managed result type")
		return
	}
	var val @ir.Instr = ins.Args[0]
	if callconv.IsAggregateTyp(val.Typ) != callconv.IsAggregateTyp(boxed) {
		a.SetError("native arm32: an OP_BOX operand whose type is not the boxed type")
		return
	}
	var sz int = boxed.SizeOf()
	if callconv.IsAggregateTyp(val.Typ) {
		var src int = getOperand(a, rm, val.ID)
		if src < 0 {
			a.SetError("native arm32: an OP_BOX operand with no register")
			return
		}
		arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Reg(src))
	} else {
		var off int = rm.LookupSpill(ins.ID)
		if off < 0 {
			a.SetError("native arm32: an OP_BOX with no spill slot")
			return
		}
		if isPair64Typ(val.Typ) {
			var lo int
			var hi int
			lo, hi = load64(a, rm, val)
			if lo < 0 {
				a.SetError("native arm32: a 64-bit OP_BOX operand with no registers")
				return
			}
			emitFrameStore(a, lo, off)
			emitFrameStore(a, hi, off + 4)
		} else {
			var src int = emitValOperand(a, pkgName, rm, val)
			if src < 0 {
				a.SetError("native arm32: an OP_BOX operand with no register")
				return
			}
			emitFrameStore(a, src, off)
		}
		emitFrameAddr(a, arm32.R0, off)
	}
	emitConstInt32(a, arm32.R1, sz)
	var callee @[]char = symPrefixed(mangleRtFunc("Box"))
	a.SetGlobal(callee)
	arm32.Bl(a, arm32.COND_AL, callee)
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Reg(arm32.R0))
}
