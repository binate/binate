package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the managed-allocation handlers (arm32_managed.bn).

// managedEmitted reports whether a's text contains ref's text as a byte run.
func managedEmitted(a @asm.Assembler, ref @asm.Assembler) bool {
	var n int = ref.Sections[0].Len
	for i := 0; i + n <= a.Sections[0].Len; i++ {
		var equal bool = true
		for k := 0; k < n; k++ {
			if a.Sections[0].Data[i + k] != ref.Sections[0].Data[k] { equal = false }
		}
		if equal { return true }
	}
	return false
}

// emitMake emits a BL to rt.Alloc(SizeOf(T)) and moves the returned managed
// pointer (R0) into the result register.
func TestMakeCallsRtAlloc() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Op = iropcode.OP_MAKE
	ins.TypeArg = types.MakeSliceType(types.TypUint8())
	ins.Typ = types.MakePointerType(ins.TypeArg)
	emitMake(a, rm, ins)
	if a.HasError {
		return fail("make must not error")
	}
	if a.LookupSymbol(symPrefixed(mangleRtFunc("Alloc"))) < 0 {
		return fail("make must emit a BL to rt.Alloc")
	}
	if rm.LookupReg(7) < 0 {
		return fail("make must assign the alloc result to a register")
	}
	return ""
}

// emitBox of a slot's address (`box(&x)`: the operand an OP_ALLOC, boxed as the
// pointer it is) boxes the address: it is stored into the box's own spill slot
// (assigned by PlanFrame), a BL to rt.Box follows, and the result managed
// pointer moves into the result register.
func TestBoxOfSlotAddressCallsRtBox() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	var elemTyp @types.Type = types.MakeSliceType(types.TypUint8())
	var f @ir.Func = make(ir.Func)
	f.Name = "main.f"
	var blk @ir.Block = make(ir.Block)
	blk.Label = "entry"
	var alloc @ir.Instr = make(ir.Instr)
	alloc.ID = 5
	alloc.Op = iropcode.OP_ALLOC
	alloc.TypeArg = elemTyp
	alloc.Typ = types.MakePointerType(elemTyp)
	var boxIns @ir.Instr = make(ir.Instr)
	boxIns.ID = 6
	boxIns.Op = iropcode.OP_BOX
	boxIns.Typ = types.MakeManagedPtrType(alloc.Typ)
	boxIns.Args = appendInstr_arm32emittest(boxIns.Args, alloc)
	blk.Instrs = appendInstr_arm32emittest(blk.Instrs, alloc)
	blk.Instrs = appendInstr_arm32emittest(blk.Instrs, boxIns)
	f.Blocks = appendBlock_arm32emittest(f.Blocks, blk)
	rm.PlanFrame(f)
	if rm.LookupAlloc(5) < 0 {
		return fail("PlanFrame must reserve an alloca offset for the boxed address")
	}
	if rm.LookupSpill(6) < 0 {
		return fail("PlanFrame must reserve the box's spill slot")
	}
	emitBox(a, "", rm, boxIns)
	if a.HasError {
		return fail("box of a slot's address must not error")
	}
	if a.LookupSymbol(symPrefixed(mangleRtFunc("Box"))) < 0 {
		return fail("box must emit a BL to rt.Box")
	}
	if rm.LookupReg(6) < 0 {
		return fail("box must assign the result to a register")
	}
	// The size argument is the 4-byte address, not the slot's 8-byte raw slice.
	var ref @asm.Assembler = mkAsm()
	emitConstInt32(ref, arm32.R1, 4)
	if !managedEmitted(a, ref) { return fail("box of a slot's address must pass size 4 in R1") }
	return ""
}

// emitBox of a global's address (`box(&G)`, the IsGlobalRef pseudo, ID -1) is
// materialized by emitValOperand and boxed as the 4-byte pointer it is.
func TestBoxOfGlobalAddressCallsRtBox() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 6)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var g @ir.Instr = make(ir.Instr)
	g.ID = -1
	g.Op = iropcode.OP_ALLOC
	g.IsGlobalRef = true
	g.StrVal = "G"
	g.TypeArg = types.TypInt32()
	g.Typ = types.MakePointerType(types.TypInt32())
	var boxIns @ir.Instr = make(ir.Instr)
	boxIns.ID = 6
	boxIns.Op = iropcode.OP_BOX
	boxIns.Typ = types.MakeManagedPtrType(g.Typ)
	boxIns.Args = appendInstr_arm32emittest(boxIns.Args, g)
	emitBox(a, "main", rm, boxIns)
	if a.HasError {
		return fail("box of a global's address must not error")
	}
	if a.LookupSymbol(symPrefixed(mangleRtFunc("Box"))) < 0 {
		return fail("box must emit a BL to rt.Box")
	}
	var ref @asm.Assembler = mkAsm()
	emitConstInt32(ref, arm32.R1, 4)
	if !managedEmitted(a, ref) { return fail("box of a global's address must pass size 4 in R1") }
	return ""
}

// emitBox of an aggregate operand boxes the operand's data region: getOperand
// resolves the aggregate value (here an alloc data region) to a pointer, which is
// moved to R0 before the BL to rt.Box.
func TestBoxAggregateCallsRtBox() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	var elemTyp @types.Type = types.MakeSliceType(types.TypUint8())
	// The aggregate value's data region: an alloc at offset 0.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 5)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	var boxIns @ir.Instr = make(ir.Instr)
	boxIns.ID = 6
	boxIns.Op = iropcode.OP_BOX
	boxIns.Typ = types.MakeManagedPtrType(elemTyp)
	// A non-OP_ALLOC aggregate operand → emitBox's aggregate branch.
	var val @ir.Instr = make(ir.Instr)
	val.ID = 5
	val.Op = iropcode.OP_MAKE_SLICE
	val.Typ = elemTyp
	boxIns.Args = appendInstr_arm32emittest(boxIns.Args, val)
	emitBox(a, "", rm, boxIns)
	if a.HasError {
		return fail("box of an aggregate operand must not error")
	}
	if a.LookupSymbol(symPrefixed(mangleRtFunc("Box"))) < 0 {
		return fail("box of an aggregate must emit a BL to rt.Box")
	}
	if rm.LookupReg(6) < 0 {
		return fail("box must assign the result to a register")
	}
	return ""
}

// emitBox of a scalar operand stores the value into the box's own spill slot and
// boxes from that slot's address.
func TestBoxScalarCallsRtBox() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	// The scalar value's spill slot at offset 0, the box's at offset 8.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 6)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	var boxIns @ir.Instr = make(ir.Instr)
	boxIns.ID = 6
	boxIns.Op = iropcode.OP_BOX
	boxIns.Typ = types.MakeManagedPtrType(types.TypInt32())
	var val @ir.Instr = make(ir.Instr)
	val.ID = 5
	val.Op = iropcode.OP_CONST_INT
	val.Typ = types.TypInt32()
	boxIns.Args = appendInstr_arm32emittest(boxIns.Args, val)
	emitBox(a, "", rm, boxIns)
	if a.HasError {
		return fail("box of a scalar operand must not error")
	}
	if a.LookupSymbol(symPrefixed(mangleRtFunc("Box"))) < 0 {
		return fail("box of a scalar must emit a BL to rt.Box")
	}
	if rm.LookupReg(6) < 0 {
		return fail("box must assign the result to a register")
	}
	return ""
}
