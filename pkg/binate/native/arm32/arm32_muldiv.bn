package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"

// Constant-divisor strength reduction for the arm32 backend (the 32-bit
// int/int32/uint32 path).  A compile-time-constant OP_DIV / OP_REM lowers to a
// Granlund-Montgomery magic-number multiply (SMULL/UMULL → the high word) plus
// shifts, a power-of-two shift, or a bare move/neg — instead of a hardware
// SDIV/UDIV.  OP_MUL by 0/1/-1/±2^k is strength-reduced too.  The magic-constant
// math is the shared common.ComputeMagic* helper, taken at width 32.
//
// The 64-bit (int64/uint64) path is handled elsewhere via __aeabi libcalls and
// is not touched here.

const armWordW int = 32

// constDivisorArm32 returns (value, true) when ins's second operand is a
// compile-time integer constant.
func constDivisorArm32(ins @ir.Instr) (int64, bool) {
	if len(ins.Args) != 2 {
		return cast(int64, 0), false
	}
	var b @ir.Instr = ins.Args[1]
	if b == nil || b.Op != iropcode.OP_CONST_INT {
		return cast(int64, 0), false
	}
	return b.IntVal, true
}

// pow2LogArm32 returns k when v == 2^k for k in [1, 63], else -1.
func pow2LogArm32(v uint64) int {
	if v == cast(uint64, 0) || (v & (v - cast(uint64, 1))) != cast(uint64, 0) {
		return -1
	}
	var k int = 0
	var x uint64 = v
	for x > cast(uint64, 1) {
		x = x >> cast(uint64, 1)
		k = k + 1
	}
	return k
}

// absU64Arm32 returns |c| as a uint64.
func absU64Arm32(c int64) uint64 {
	if c < cast(int64, 0) {
		return cast(uint64, 0) - cast(uint64, c)
	}
	return cast(uint64, c)
}

// magicMask32 returns the low 32 bits of c as a uint64 (the arm32 divisor).
func magicMask32(c int64) uint64 {
	return cast(uint64, c) & cast(uint64, 0xFFFFFFFF)
}

// emitConstMulDivArm32 is the hook invoked from emitBinop for a constant-divisor
// OP_MUL / OP_DIV / OP_REM.  rd/lhs are already resolved; `rhs` holds the
// materialized constant (reused as the divisor for the REM multiply).  Returns
// true when it emitted a specialized sequence.
func emitConstMulDivArm32(a @asm.Assembler, rm @common.RegMap, rd int, lhs int, rhs int, op int,
		c int64, isUnsigned bool) bool {
	if op == iropcode.OP_MUL {
		return emitConstMulArm32(a, rd, lhs, c)
	}
	if c == cast(int64, 0) {
		return false
	}
	if op == iropcode.OP_DIV {
		return emitConstDivArm32(a, rm, rd, lhs, c, isUnsigned)
	}
	if op == iropcode.OP_REM {
		return emitConstRemArm32(a, rm, rd, lhs, rhs, c, isUnsigned)
	}
	return false
}

// emitConstMulArm32 reduces `lhs * c`.
func emitConstMulArm32(a @asm.Assembler, rd int, lhs int, c int64) bool {
	if c == cast(int64, 0) {
		arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Imm(0))
		return true
	}
	if c == cast(int64, 1) {
		arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Reg(lhs))
		return true
	}
	if c == cast(int64, -1) {
		arm32.Rsb(a, arm32.COND_AL, false, rd, lhs, arm32.Imm(0))
		return true
	}
	var k int = pow2LogArm32(absU64Arm32(c))
	if k >= 1 {
		arm32.Mov(a, arm32.COND_AL, false, rd, arm32.RegShift(lhs, arm32.LSL, k))
		if c < cast(int64, 0) {
			arm32.Rsb(a, arm32.COND_AL, false, rd, rd, arm32.Imm(0))
		}
		return true
	}
	return false
}

// emitConstDivArm32 writes `lhs / c` into rd (c not 0).
func emitConstDivArm32(a @asm.Assembler, rm @common.RegMap, rd int, lhs int, c int64,
		isUnsigned bool) bool {
	if c == cast(int64, 1) {
		arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Reg(lhs))
		return true
	}
	if !isUnsigned && c == cast(int64, -1) {
		arm32.Rsb(a, arm32.COND_AL, false, rd, lhs, arm32.Imm(0))
		return true
	}
	var qres int = computeConstQuotientArm32(a, rm, lhs, c, isUnsigned)
	if rd != qres {
		arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Reg(qres))
	}
	return true
}

// emitConstRemArm32 writes `lhs % c` into rd (c not 0).
func emitConstRemArm32(a @asm.Assembler, rm @common.RegMap, rd int, lhs int, rhs int, c int64,
		isUnsigned bool) bool {
	if c == cast(int64, 1) || c == cast(int64, -1) {
		arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Imm(0))
		return true
	}
	if isUnsigned {
		var k int = pow2LogArm32(cast(uint64, c) & cast(uint64, 0xFFFFFFFF))
		if k >= 1 {
			arm32.Mov(a, arm32.COND_AL, false, rd, arm32.RegShift(lhs, arm32.LSL, armWordW - k))
			arm32.Mov(a, arm32.COND_AL, false, rd, arm32.RegShift(rd, arm32.LSR, armWordW - k))
			return true
		}
	}
	var qres int = computeConstQuotientArm32(a, rm, lhs, c, isUnsigned)
	// r = lhs - q*c, reusing the materialized divisor register `rhs`.
	arm32.Mul(a, arm32.COND_AL, false, qres, qres, rhs)
	arm32.Sub(a, arm32.COND_AL, false, rd, lhs, arm32.Reg(qres))
	return true
}

// computeConstQuotientArm32 emits `lhs / c` (c not 0, not ±1) into a fresh
// scratch and returns it.
func computeConstQuotientArm32(a @asm.Assembler, rm @common.RegMap, lhs int, c int64,
		isUnsigned bool) int {
	var k int = pow2LogArm32(absU64Arm32(c))
	if k >= 1 {
		return computeConstPow2QuotientArm32(a, rm, lhs, c, k, isUnsigned)
	}
	return computeConstMagicQuotientArm32(a, rm, lhs, c, isUnsigned)
}

// computeConstPow2QuotientArm32 emits signed/unsigned `lhs / (±2^k)` into a
// fresh scratch and returns it (unsigned: a logical shift; signed: the
// round-toward-zero bias then an arithmetic shift, negated for a negative divisor).
func computeConstPow2QuotientArm32(a @asm.Assembler, rm @common.RegMap, lhs int, c int64, k int,
		isUnsigned bool) int {
	var qres int = scratchReg(rm)
	if isUnsigned {
		arm32.Mov(a, arm32.COND_AL, false, qres, arm32.RegShift(lhs, arm32.LSR, k))
		return qres
	}
	// Signed: bias by (2^k - 1) when the dividend is negative, then ASR.
	var tmp int = scratchReg(rm)
	if k == 1 {
		arm32.Mov(a, arm32.COND_AL, false, tmp, arm32.RegShift(lhs, arm32.LSR, armWordW - 1))
	} else {
		arm32.Mov(a, arm32.COND_AL, false, tmp, arm32.RegShift(lhs, arm32.ASR, k - 1))
		arm32.Mov(a, arm32.COND_AL, false, tmp, arm32.RegShift(tmp, arm32.LSR, armWordW - k))
	}
	arm32.Add(a, arm32.COND_AL, false, qres, lhs, arm32.Reg(tmp))
	arm32.Mov(a, arm32.COND_AL, false, qres, arm32.RegShift(qres, arm32.ASR, k))
	if c < cast(int64, 0) {
		arm32.Rsb(a, arm32.COND_AL, false, qres, qres, arm32.Imm(0))
	}
	return qres
}

// computeConstMagicQuotientArm32 emits the SMULL/UMULL magic-number multiply for
// a non-power-of-two |c| >= 2, returning the scratch holding the quotient.
func computeConstMagicQuotientArm32(a @asm.Assembler, rm @common.RegMap, lhs int, c int64,
		isUnsigned bool) int {
	var mreg int = scratchReg(rm)
	var rdlo int = scratchReg(rm)
	var qres int = scratchReg(rm)
	if isUnsigned {
		var mg common.MagicUnsigned = common.ComputeMagicUnsigned(magicMask32(c), armWordW)
		emitConstInt32(a, mreg, cast(int, mg.M & cast(uint64, 0xFFFFFFFF)))
		arm32.Umull(a, arm32.COND_AL, false, rdlo, qres, mreg, lhs) // qres = high32(M*n)
		if !mg.Add {
			if mg.Shift > 0 {
				arm32.Mov(a, arm32.COND_AL, false, qres, arm32.RegShift(qres, arm32.LSR, mg.Shift))
			}
		} else {
			// t = (n - q) >> 1 ; q = (t + q) >> (shift-1)  — rdlo is dead, reuse as t.
			arm32.Sub(a, arm32.COND_AL, false, rdlo, lhs, arm32.Reg(qres))
			arm32.Mov(a, arm32.COND_AL, false, rdlo, arm32.RegShift(rdlo, arm32.LSR, 1))
			arm32.Add(a, arm32.COND_AL, false, rdlo, rdlo, arm32.Reg(qres))
			if mg.Shift - 1 > 0 {
				arm32.Mov(a, arm32.COND_AL, false, qres, arm32.RegShift(rdlo, arm32.LSR, mg.Shift - 1))
			} else {
				arm32.Mov(a, arm32.COND_AL, false, qres, arm32.Reg(rdlo))
			}
		}
		return qres
	}
	var mg common.MagicSigned = common.ComputeMagicSigned(c, armWordW)
	emitConstInt32(a, mreg, cast(int, mg.M))
	arm32.Smull(a, arm32.COND_AL, false, rdlo, qres, mreg, lhs) // qres = high32(signed M*n)
	if mg.AddN {
		arm32.Add(a, arm32.COND_AL, false, qres, qres, arm32.Reg(lhs))
	}
	if mg.SubN {
		arm32.Sub(a, arm32.COND_AL, false, qres, qres, arm32.Reg(lhs))
	}
	if mg.Shift > 0 {
		arm32.Mov(a, arm32.COND_AL, false, qres, arm32.RegShift(qres, arm32.ASR, mg.Shift))
	}
	// Round toward zero: add the sign bit (logical-shift-right by W-1 → 0/1).
	arm32.Add(a, arm32.COND_AL, false, qres, qres, arm32.RegShift(qres, arm32.LSR, armWordW - 1))
	return qres
}

// emitMulAddArm32 lowers the fused OP_MADD (Args[0]*Args[1] + Args[2]) / OP_MSUB
// (Args[2] - Args[0]*Args[1]) into a single arm32 MLA / MLS.  The fusion pass
// emits OP_MADD/OP_MSUB only for integers that fit the 32-bit GP registers, so a
// 64-bit-typed fused op never reaches here — a 64-bit result is intercepted by
// instrIs64 -> emitInstr64 (which never fuses).  All three source registers are
// read before rd is written (ARMv7 permits rd to alias a source), and nextReg
// picks rd after the operands are marked used.  Returns false if ins is not a
// fused multiply-add, so the dispatch falls through to the next delegate.
func emitMulAddArm32(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_MADD && ins.Op != iropcode.OP_MSUB {
		return false
	}
	if len(ins.Args) != 3 {
		return false
	}
	var ra int = getOperand(a, rm, ins.Args[0].ID)
	var rb int = getOperand(a, rm, ins.Args[1].ID)
	var rc int = getOperand(a, rm, ins.Args[2].ID)
	if ra < 0 || rb < 0 || rc < 0 { return false }
	var rd int = nextReg(rm, ins.ID)
	if ins.Op == iropcode.OP_MADD {
		arm32.Mla(a, arm32.COND_AL, false, rd, ra, rb, rc)
	} else {
		arm32.Mls(a, arm32.COND_AL, rd, ra, rb, rc)
	}
	emitSubWordNarrow(a, rd, ins.Typ)
	return true
}
