package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Fixed-bit signatures (cond and register fields masked out).
const smullMask uint32 = 0x0FE000F0

const smullFixed uint32 = 0x00C00090

const umullFixed uint32 = 0x00800090

const sdivMask uint32 = 0x0FF000F0

const sdivFixed uint32 = 0x07100010

// hasArmWord reports whether any emitted 32-bit word matches (w & mask) == fixed.
func hasArmWord(a @asm.Assembler, fixed uint32, mask uint32) bool {
	var n int = a.Sections[0].Len
	var off int = 0
	for off + 4 <= n {
		if (word32(a, off) & mask) == fixed {
			return true
		}
		off = off + 4
	}
	return false
}

// constOpArm32 builds `lhs <op> C` with a constant second operand: lhs homed in
// R5, the constant in R6 (its materialized home), result id 0.
func constOpArm32(rm @common.RegMap, op int, typ @types.Type, c int64) @ir.Instr {
	rm.AssignReg(10, arm32.R5)
	rm.AssignReg(11, arm32.R6)
	var l @ir.Instr = make(ir.Instr)
	l.ID = 10
	l.Typ = typ
	var r @ir.Instr = make(ir.Instr)
	r.ID = 11
	r.Op = iropcode.OP_CONST_INT
	r.IntVal = c
	r.Typ = typ
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = op
	ins.Typ = typ
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = l
	ins.Args[1] = r
	return ins
}

// Signed constant division uses the SMULL magic multiply, not a hardware SDIV.
func TestConstSignedDivArm32Magic() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = constOpArm32(rm, iropcode.OP_DIV, types.TypInt(), cast(int64, 7))
	emitBinop(a, rm, ins)
	if !hasArmWord(a, smullFixed, smullMask) {
		return "signed const DIV should emit SMULL"
	}
	if hasArmWord(a, sdivFixed, sdivMask) {
		return "signed const DIV must NOT emit SDIV"
	}
	return ""
}

// Unsigned constant division uses UMULL.
func TestConstUnsignedDivArm32Magic() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = constOpArm32(rm, iropcode.OP_DIV, types.TypUint32(), cast(int64, 7))
	emitBinop(a, rm, ins)
	if !hasArmWord(a, umullFixed, smullMask) {
		return "unsigned const DIV should emit UMULL"
	}
	return ""
}

// Signed constant modulo uses the SMULL magic quotient, then MUL+SUB — no SDIV.
func TestConstRemArm32Magic() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = constOpArm32(rm, iropcode.OP_REM, types.TypInt(), cast(int64, 7))
	emitBinop(a, rm, ins)
	if !hasArmWord(a, smullFixed, smullMask) {
		return "signed const REM should emit SMULL for the quotient"
	}
	if hasArmWord(a, sdivFixed, sdivMask) {
		return "signed const REM must NOT emit SDIV"
	}
	return ""
}

// A VARIABLE divisor still lowers to the hardware SDIV.
func TestVariableDivArm32StillSdiv() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = twoOpArm32(rm, iropcode.OP_DIV, types.TypInt())
	emitBinop(a, rm, ins)
	if !hasArmWord(a, sdivFixed, sdivMask) {
		return "variable-divisor DIV must still emit SDIV"
	}
	return ""
}
