package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Golden AAPCS-VFP ABI conformance for hard-float MULTI-RETURN tuples with MIXED
// float/integer fields (and 3+ floats).  Because Binate does separate
// compilation + binary distribution, the native arm32 backend must place every
// multi-return field in the EXACT register clang -mfloat-abi=hard uses, or a
// native object and an LLVM object are not link-compatible.  arm32_call_hard_test
// already pins the pure-float 2-field shapes ({f32,f64} pack, {f64,f32} collect);
// these pin the cases those miss — the FP and GP return-register cursors advancing
// INDEPENDENTLY (a non-float field must consume NO FP slot, and a float field must
// consume NO GP slot), plus a 3-single tuple.  Placements pinned against clang:
//   {float, i32, float}  -> s0, r0, s1
//   {i32, double, i32}   -> r0, D0, r1
//   {float, float, float}-> s0, s1, s2

// multiRetCall3 builds an OP_CALL returning a nameless 3-field tuple (t0,t1,t2)
// with result id 0 — emitCall drives collectMultiReturnFields over it, the twin
// of multiRetCall's 2-field tuple.
func multiRetCall3(t0 @types.Type, t1 @types.Type, t2 @types.Type) @ir.Instr {
	var f @[]@types.Field = make_slice(@types.Field, 3)
	f[0] = make(types.Field)
	f[0].Type = t0
	f[1] = make(types.Field)
	f[1].Type = t1
	f[2] = make(types.Field)
	f[2].Type = t2
	var noArgs @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "main.f"
	ins.Args = noArgs
	ins.Typ = types.MakeStructType("", f)
	return ins
}

// Collecting {float32, int32, float32}: the int32 field consumes NO FP slot, so
// field2 (f32) rides S1 — the next single past field0's S0 — NOT S2.  The FP
// return-register cursor must advance independently of the interleaved GP field.
func TestHardMultiReturnCollectF32I32F32() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = hardRm()
	addSpill(rm, 0, 0)
	var call @ir.Instr = multiRetCall3(types.TypFloat32(), types.TypInt32(), types.TypFloat32())
	emitCall(a, "main", rm, call)
	var hadErr bool = a.HasError
	var off0 int = call.Typ.FieldOffset(0)
	var off1 int = call.Typ.FieldOffset(1)
	var off2 int = call.Typ.FieldOffset(2)
	restoreTarget(oldArch, oldAbi)
	if hadErr { return fail("hard mixed multi-return collect must not error") }
	var r0 @asm.Assembler = mkAsm()
	arm32.Vstr32(r0, arm32.COND_AL, arm32.S0, arm32.SP, off0)
	if !containsWord(a, word32(r0, 0)) { return fail("field0 (f32) must VSTR S0") }
	var r2 @asm.Assembler = mkAsm()
	arm32.Vstr32(r2, arm32.COND_AL, arm32.S1, arm32.SP, off2)
	if !containsWord(a, word32(r2, 0)) {
		return fail("field2 (f32) must VSTR S1 — the int32 consumes no FP slot")
	}
	var wrong @asm.Assembler = mkAsm()
	arm32.Vstr32(wrong, arm32.COND_AL, arm32.S2, arm32.SP, off2)
	if containsWord(a, word32(wrong, 0)) {
		return fail("field2 must NOT ride S2 — FP cursor must not advance for the int32 field")
	}
	// The int32 rides the GP cursor's first slot (r0) — the reciprocal invariant:
	// the float fields consumed no GP slot.
	var g1 @asm.Assembler = mkAsm()
	emitBaseScalarStore(g1, argReg(0), arm32.SP, off1, 4, arm32.IP)
	if !containsWord(a, word32(g1, 0)) { return fail("field1 (i32) must Str r0") }
	return ""
}

// Collecting {int32, float64, int32}: the leading int32 consumes NO FP slot, so
// field1 (f64) rides D0 — NOT D1.  Pins the double placement past an interleaved
// GP field.
func TestHardMultiReturnCollectI32F64I32() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = hardRm()
	addSpill(rm, 0, 0)
	var call @ir.Instr = multiRetCall3(types.TypInt32(), types.TypFloat64(), types.TypInt32())
	emitCall(a, "main", rm, call)
	var hadErr bool = a.HasError
	var off0 int = call.Typ.FieldOffset(0)
	var off1 int = call.Typ.FieldOffset(1)
	var off2 int = call.Typ.FieldOffset(2)
	restoreTarget(oldArch, oldAbi)
	if hadErr { return fail("hard mixed multi-return collect must not error") }
	var r1 @asm.Assembler = mkAsm()
	arm32.Vstr64(r1, arm32.COND_AL, arm32.D0, arm32.SP, off1)
	if !containsWord(a, word32(r1, 0)) {
		return fail("field1 (f64) must VSTR D0 — the leading int32 consumes no FP slot")
	}
	var wrong @asm.Assembler = mkAsm()
	arm32.Vstr64(wrong, arm32.COND_AL, arm32.D1, arm32.SP, off1)
	if containsWord(a, word32(wrong, 0)) {
		return fail("field1 must NOT ride D1 — FP cursor must not advance for the int32 field")
	}
	// field0 int32 -> r0, field2 int32 -> r1: the f64 consumed NO GP slot (else the
	// trailing int32 would land in r2), the reciprocal of the FP-cursor check above.
	var g0 @asm.Assembler = mkAsm()
	emitBaseScalarStore(g0, argReg(0), arm32.SP, off0, 4, arm32.IP)
	if !containsWord(a, word32(g0, 0)) { return fail("field0 (i32) must Str r0") }
	var g2 @asm.Assembler = mkAsm()
	emitBaseScalarStore(g2, argReg(1), arm32.SP, off2, 4, arm32.IP)
	if !containsWord(a, word32(g2, 0)) {
		return fail("field2 (i32) must Str r1 — the f64 consumes no GP slot")
	}
	var wrongGp @asm.Assembler = mkAsm()
	emitBaseScalarStore(wrongGp, argReg(2), arm32.SP, off2, 4, arm32.IP)
	if containsWord(a, word32(wrongGp, 0)) {
		return fail("field2 must NOT Str r2 — GP cursor must not advance for the f64 field")
	}
	return ""
}

// Packing {float32, int32, float32}: field0 VMOVs into S0, field2 into S1 (NOT
// S2) — the produce side mirrors the collect side's independent FP/GP cursors.
func TestHardMultiReturnPackF32I32F32() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = hardRm()
	addSpill(rm, 10, 0)
	addSpill(rm, 11, 4)
	addSpill(rm, 12, 8)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, floatArg(10, types.TypFloat32()))
	args = appendInstrPtr_arm32calltest(args, floatArg(11, types.TypInt32()))
	args = appendInstrPtr_arm32calltest(args, floatArg(12, types.TypFloat32()))
	var ins @ir.Instr = make(ir.Instr)
	ins.Args = args
	emitMultiReturnPack(a, "main", rm, ins)
	var hadErr bool = a.HasError
	restoreTarget(oldArch, oldAbi)
	if hadErr { return fail("hard mixed multi-return pack must not error") }
	if !containsWord(a, vmovS(arm32.S0)) { return fail("field0 (f32) must pack into S0") }
	if !containsWord(a, vmovS(arm32.S1)) {
		return fail("field2 (f32) must pack into S1 — the int32 consumes no FP slot")
	}
	if containsWord(a, vmovS(arm32.S2)) {
		return fail("no field may pack into S2 — FP cursor must not advance for the int32 field")
	}
	return ""
}

// Packing {float32, float32, float32}: three singles fill S0, S1, S2 in order —
// extends the pure-float pack coverage past two fields.
func TestHardMultiReturnPackF32F32F32() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = hardRm()
	addSpill(rm, 10, 0)
	addSpill(rm, 11, 4)
	addSpill(rm, 12, 8)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, floatArg(10, types.TypFloat32()))
	args = appendInstrPtr_arm32calltest(args, floatArg(11, types.TypFloat32()))
	args = appendInstrPtr_arm32calltest(args, floatArg(12, types.TypFloat32()))
	var ins @ir.Instr = make(ir.Instr)
	ins.Args = args
	emitMultiReturnPack(a, "main", rm, ins)
	var hadErr bool = a.HasError
	restoreTarget(oldArch, oldAbi)
	if hadErr { return fail("hard 3-float multi-return pack must not error") }
	if !containsWord(a, vmovS(arm32.S0)) { return fail("field0 (f32) must pack into S0") }
	if !containsWord(a, vmovS(arm32.S1)) { return fail("field1 (f32) must pack into S1") }
	if !containsWord(a, vmovS(arm32.S2)) { return fail("field2 (f32) must pack into S2") }
	return ""
}

// Collecting {float32, float32, float32}: three singles VSTR from S0, S1, S2 into
// the result slot at each field's offset — the collect twin of the 3-single pack.
func TestHardMultiReturnCollectF32F32F32() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = hardRm()
	addSpill(rm, 0, 0)
	var call @ir.Instr = multiRetCall3(types.TypFloat32(), types.TypFloat32(), types.TypFloat32())
	emitCall(a, "main", rm, call)
	var hadErr bool = a.HasError
	var off0 int = call.Typ.FieldOffset(0)
	var off1 int = call.Typ.FieldOffset(1)
	var off2 int = call.Typ.FieldOffset(2)
	restoreTarget(oldArch, oldAbi)
	if hadErr { return fail("hard 3-float multi-return collect must not error") }
	var r0 @asm.Assembler = mkAsm()
	arm32.Vstr32(r0, arm32.COND_AL, arm32.S0, arm32.SP, off0)
	if !containsWord(a, word32(r0, 0)) { return fail("field0 (f32) must VSTR S0") }
	var r1 @asm.Assembler = mkAsm()
	arm32.Vstr32(r1, arm32.COND_AL, arm32.S1, arm32.SP, off1)
	if !containsWord(a, word32(r1, 0)) { return fail("field1 (f32) must VSTR S1") }
	var r2 @asm.Assembler = mkAsm()
	arm32.Vstr32(r2, arm32.COND_AL, arm32.S2, arm32.SP, off2)
	if !containsWord(a, word32(r2, 0)) { return fail("field2 (f32) must VSTR S2") }
	return ""
}

// Packing {int32, float64, int32}: field1 (f64) VMOVs into D0 — the pack twin of
// the {i32,f64,i32} collect, confirming the produce side also places the double
// in D0 past the leading int32 (which consumes no FP slot).
func TestHardMultiReturnPackI32F64I32() testing.TestResult {
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = hardRm()
	addSpill(rm, 10, 0)
	addSpill(rm, 11, 8)
	addSpill(rm, 12, 16)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32calltest(args, floatArg(10, types.TypInt32()))
	args = appendInstrPtr_arm32calltest(args, floatArg(11, types.TypFloat64()))
	args = appendInstrPtr_arm32calltest(args, floatArg(12, types.TypInt32()))
	var ins @ir.Instr = make(ir.Instr)
	ins.Args = args
	emitMultiReturnPack(a, "main", rm, ins)
	var hadErr bool = a.HasError
	restoreTarget(oldArch, oldAbi)
	if hadErr { return fail("hard mixed multi-return pack must not error") }
	if !containsWord(a, vmovD(arm32.D0)) {
		return fail("field1 (f64) must pack into D0 — the leading int32 consumes no FP slot")
	}
	if containsWord(a, vmovD(arm32.D1)) {
		return fail("no field may pack into D1 — FP cursor must not advance for the int32 field")
	}
	return ""
}
