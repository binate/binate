package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// ============================================================
// Name helpers
// ============================================================
//
// arm32 emits ELF only, so every symbol is BARE — there is no Mach-O
// leading-'_' convention and no objEmitElf toggle (cf. the aarch64 backend,
// which flips between the two).  symPrefixed is therefore the identity; it is
// kept so the emit sites read structurally the same as their aarch64 / x64
// counterparts and a future object-format axis has a single insertion point.

// symPrefixed returns the ELF-bare symbol name for an already-mangled name.
// The identity function on arm32 (ELF has no linkage prefix); a fresh copy is
// returned so callers may retain it independently of the input's backing.
func symPrefixed(s *[]readonly char) @[]char {
	return buf.CopyStr(s)
}

// symFor mangles a Binate (pkgName, funcName) pair to its bare ELF symbol.
// funcName is dot-qualified ("pkg.Func", "main.main"); mangle.FuncName treats
// dotted names as pre-qualified, so pkgName is ignored for those — it is kept
// for API parity with bare-name callers.  main.__entry special-cases to the
// reserved `bn_entry` symbol inside mangle.FuncName.
func symFor(pkgName *[]readonly char, funcName *[]readonly char) @[]char {
	return symPrefixed(mangle.FuncName(pkgName, funcName))
}

// mangleRtFunc mangles a `pkg/builtins/rt` runtime helper's name (Alloc, Box,
// MakeManagedSlice, ZeroRefDestroy, DivCheck, ShiftCheck, BoundsCheck) to its
// bare mangled symbol.  The runtime is LLVM-compiled and linked in, so the
// native side must reference the exact mangled name.  A single insertion point
// so every rt.* call site (calls, make-slice, refcount, guards) agrees.
func mangleRtFunc(name *[]readonly char) @[]char {
	return mangle.FuncName("pkg/builtins/rt", name)
}

// globalSymFor mangles a package-level variable to its bare ELF symbol.
// Distinct from symFor because globals route through mangle.GlobalName (no
// main.main / main.__entry special case).
func globalSymFor(pkgName *[]readonly char, name *[]readonly char) @[]char {
	return symPrefixed(mangle.GlobalName(pkgName, name))
}

// isGlobalRef reports whether ins is the pseudo-Instr the IR produces for a
// package-level variable reference (Instr.IsGlobalRef, set by lookupVar's
// global-fallback path).  Such refs reach their address via MOVW/MOVT-ABS
// rather than an SP-relative alloca or spill reload.
func isGlobalRef(ins @ir.Instr) bool {
	if ins == nil { return false }
	return ins.IsGlobalRef
}

// emitGlobalAddr materializes the runtime address of a package-level variable
// in rd via the MOVW/MOVT-ABS reloc pair (the arm32 analog of aarch64's
// ADRP+ADD): MovwLabel writes the low 16 bits (R_ARM_MOVW_ABS_NC), MovtLabel
// the high 16 (R_ARM_MOVT_ABS), and the linker resolves the full 32-bit
// address of the symbol.
func emitGlobalAddr(a @asm.Assembler, pkgName *[]readonly char, rd int, ins @ir.Instr) {
	var label @[]char = globalSymFor(pkgName, ins.StrVal)
	a.SetGlobal(label)
	arm32.MovwLabel(a, arm32.COND_AL, rd, label)
	arm32.MovtLabel(a, arm32.COND_AL, rd, label)
}

// emitSymAddr materializes the runtime address of an arbitrary (already-
// prefixed) symbol into rd via the MOVW/MOVT-ABS reloc pair.  Marks the
// symbol global so its relocation resolves.  Used for string blobs / vtables /
// descriptor nodes — anything reached by address rather than by branch.
func emitSymAddr(a @asm.Assembler, rd int, label @[]char) {
	a.SetGlobal(label)
	arm32.MovwLabel(a, arm32.COND_AL, rd, label)
	arm32.MovtLabel(a, arm32.COND_AL, rd, label)
}

// argReg returns the arm32 register that carries the i-th integer arg under
// AAPCS32 (R0..R3).  The i-th slot past R3 is passed on the stack, so callers
// must only invoke this for i < 4.
func argReg(i int) int {
	if i == 0 { return arm32.R0 }
	if i == 1 { return arm32.R1 }
	if i == 2 { return arm32.R2 }
	return arm32.R3
}

// stringMSSym is the module-qualified WEAK symbol for string constant <id>'s
// static managed-slice header.  Reached from text via the MOVW/MOVT reloc
// pair, so it must be a symbol-table entry (module-qualified so two modules'
// string 0 don't collide) rather than a same-section-local `Lstr_` label.
func stringMSSym(pkgName *[]readonly char, id int) @[]char {
	var nm @strings.Builder = strings.NewBuilder()
	nm.Write("__strms_")
	stringutils.WriteInt(nm, id)
	return symPrefixed(mangle.GlobalName(pkgName, nm.String()))
}

// blockLabel mints a function-scoped label name for a basic block.  The 'L'
// prefix keeps it out of the exported symbol list.
func blockLabel(funcSym @[]char, block @[]char) @[]char {
	var out @strings.Builder = strings.NewBuilder()
	out.Write("L")
	out.Write(funcSym)
	out.Write("__")
	out.Write(block)
	return buf.CopyStr(out.String())
}
