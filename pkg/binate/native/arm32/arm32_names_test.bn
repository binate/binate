package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// argReg maps integer arg indices 0..3 to R0..R3 (AAPCS32), saturating at R3
// for out-of-range indices (callers pass those on the stack).
func TestArgRegSlots() testing.TestResult {
	if argReg(0) != arm32.R0 { return fail("argReg(0)") }
	if argReg(1) != arm32.R1 { return fail("argReg(1)") }
	if argReg(2) != arm32.R2 { return fail("argReg(2)") }
	if argReg(3) != arm32.R3 { return fail("argReg(3)") }
	if argReg(4) != arm32.R3 { return fail("argReg(4) saturates at R3") }
	return ""
}

// symFor mangles a dotted (pre-qualified) name; arm32 is ELF-bare, so no
// leading '_'.  main.main is a normal free function (bn_entry is reserved for
// main.__entry only).
func TestSymForMainMain() testing.TestResult {
	var s @[]char = symFor("main", "main")
	if !charEq(s, "bn_F1_4_main1_4_main") {
		return fail("expected bn_F1_4_main1_4_main")
	}
	return ""
}

// main.__entry folds to the reserved bn_entry symbol (the crt0 entry point).
func TestSymForEntry() testing.TestResult {
	var s @[]char = symFor("main", "main.__entry")
	if !charEq(s, "bn_entry") { return fail("main.__entry should fold to bn_entry") }
	return ""
}

// symPrefixed is the identity on arm32 (ELF has no linkage prefix).
func TestSymPrefixedIsIdentity() testing.TestResult {
	var s @[]char = symPrefixed("bn_foo")
	if !charEq(s, "bn_foo") { return fail("symPrefixed must be identity on ELF") }
	return ""
}

// A LOCAL symbol — a string blob Lstr_<id>, defined in THIS object by
// emitStringTable — referenced via emitSymAddrLocal must STAY local: the ELF
// reloc resolves against its local symbol index, and promoting it to global
// would make two objects' identical Lstr_<id> collide at link ("multiple
// definition"), which breaks every multi-package native arm32 link.
//
// The reference is emitted BEFORE the definition, matching the real order (a
// function body references the blob in EmitFunc, which runs before the blob is
// defined in EmitStringTable).  This exercises the exact root-cause path: the
// buggy emitSymAddr's SetGlobal would pre-create an undefined GLOBAL Lstr_0, and
// the later DefineLabel would fill it while KEEPING the global binding.
// emitSymAddrLocal adds only a fixup (no symbol), so DefineLabel then creates a
// fresh BIND_LOCAL symbol.
func TestEmitSymAddrLocalKeepsLabelLocal() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitSymAddrLocal(a, arm32.R4, "Lstr_0")
	a.SetSection("rodata", -1)
	a.DefineLabel("Lstr_0")
	var si int = a.LookupSymbol("Lstr_0")
	if si < 0 { return fail("Lstr_0 should be defined") }
	if a.Symbols[si].Binding != asm.BIND_LOCAL {
		return fail("emitSymAddrLocal must not promote a local blob to global")
	}
	return ""
}

// emitSymAddr (the EXTERNAL/exported variant) DOES register its target global,
// so a cross-object reference — a C global, an imported __ivt, a func-value
// vtable — resolves at link.  The local string blob deliberately uses
// emitSymAddrLocal instead; emitSymAddr would promote it and cause the
// duplicate-symbol collision above.
func TestEmitSymAddrPromotesToGlobal() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitSymAddr(a, arm32.R4, "some_extern")
	var si int = a.LookupSymbol("some_extern")
	if si < 0 { return fail("emitSymAddr must register its target symbol") }
	if a.Symbols[si].Binding != asm.BIND_GLOBAL {
		return fail("emitSymAddr must promote an external target to global")
	}
	return ""
}
