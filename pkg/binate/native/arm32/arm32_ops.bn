package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Constant materialization + frame-adjust helpers
// ============================================================

// emitConstInt32 loads a 32-bit integer constant into rd.  A value that fits
// the ARM rotated-immediate form (EncodeRotImm) takes a single MOV; otherwise
// MOVW (low 16) + MOVT (high 16) always works.  The IR carries int64 IntVal
// but arm32 registers are 32-bit — the low 32 bits are what a same-width
// scalar needs (a genuine 64-bit value is a register pair: emitConst64).  The
// value is reduced to its 32-bit pattern here, explicitly: the assembler
// rejects an immediate outside the 32-bit range rather than truncating it.
func emitConstInt32(a @asm.Assembler, rd int, val int) {
	var v int = cast(int, cast(uint32, val))
	var lo int = v & 0xFFFF
	var hi int = (v >> 16) & 0xFFFF
	// Single MOV when the whole value fits the rotated-immediate encoding.
	var ri arm32.RotImmResult = arm32.EncodeRotImm(v)
	if ri.Ok {
		arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Imm(v))
		return
	}
	arm32.Movw(a, arm32.COND_AL, rd, lo)
	if hi != 0 {
		arm32.Movt(a, arm32.COND_AL, rd, hi)
	}
}

// emitSpAdjust changes SP by `amount` bytes: `add sp, sp, #amount` when grow
// is true, `sub sp, sp, #amount` otherwise.  A frame that fits the rotated-
// immediate form adjusts in one instruction; a larger frame materializes the
// amount in IP (r12, the intra-procedure scratch) via emitConstInt32 first,
// then adds/subtracts the register.  PlanFrame keeps the frame 8-byte aligned
// (AAPCS32 StackAlign), so SP stays 8-aligned across the adjust.
func emitSpAdjust(a @asm.Assembler, grow bool, amount int) {
	var ri arm32.RotImmResult = arm32.EncodeRotImm(amount)
	if ri.Ok {
		if grow {
			arm32.Add(a, arm32.COND_AL, false, arm32.SP, arm32.SP, arm32.Imm(amount))
		} else {
			arm32.Sub(a, arm32.COND_AL, false, arm32.SP, arm32.SP, arm32.Imm(amount))
		}
		return
	}
	// Large frame: build the amount in IP, then add/sub the register.
	emitConstInt32(a, arm32.IP, amount)
	if grow {
		arm32.Add(a, arm32.COND_AL, false, arm32.SP, arm32.SP, arm32.Reg(arm32.IP))
	} else {
		arm32.Sub(a, arm32.COND_AL, false, arm32.SP, arm32.SP, arm32.Reg(arm32.IP))
	}
}

// emitAddImm emits `rd = rn + imm` for an ARBITRARY 32-bit immediate.  An ADD
// immediate must be an 8-bit value rotated right by an even amount, and the bare
// `arm32.Add(..., arm32.Imm(imm))` sets an assembler error (emitting nothing)
// for any other value — a frame offset like 1268, for instance.  So when
// arm32.EncodeRotImm finds no such form for imm, this helper materializes imm in
// `tmp` and emits the register form `ADD rd, rn, tmp` instead.  It is the single
// SP/base-plus-offset ADD every native emitter routes through.  `tmp` is the
// scratch used for the fallback materialization (IP for the ADD-SP frame cases,
// where IP is the AAPCS intra-procedure scratch, dead across a single op).
func emitAddImm(a @asm.Assembler, rd int, rn int, imm int, tmp int) {
	var ri arm32.RotImmResult = arm32.EncodeRotImm(imm)
	if ri.Ok {
		arm32.Add(a, arm32.COND_AL, false, rd, rn, arm32.Imm(imm))
		return
	}
	emitConstInt32(a, tmp, imm)
	arm32.Add(a, arm32.COND_AL, false, rd, rn, arm32.Reg(tmp))
}

// emitSubWordNarrow re-reduces rd to t's value range after a width-agnostic op
// computed it in a full 32-bit register: sign-extend (signed) or zero-extend
// (unsigned) from the type's width.  A no-op for host-word-wide (32-bit) or
// non-integer types.  common.SubWordNarrow is the one classifier shared with
// the VM and the other native backends; here wordBits is 32 (the arm32 GP
// register width), so int32/uint32/int (all 32-bit) narrow to nothing and only
// int8/int16 (and their unsigned forms) get an SXTB/SXTH/UXTB/UXTH.  Mirrors
// aarch64_ops.bn's emitSubWordNarrow at wordBits=32.
func emitSubWordNarrow(a @asm.Assembler, rd int, t @types.Type) {
	var w int
	var signed bool
	w, signed = common.SubWordNarrow(t, 32)
	if w == 0 { return }
	if signed {
		if w == 8 { arm32.Sxtb(a, arm32.COND_AL, rd, rd); return }
		arm32.Sxth(a, arm32.COND_AL, rd, rd)
		return
	}
	if w == 8 { arm32.Uxtb(a, arm32.COND_AL, rd, rd); return }
	arm32.Uxth(a, arm32.COND_AL, rd, rd)
}

// emitBinop handles the 32-bit integer arithmetic, bitwise, and shift ops.
// Returns true if it matched and emitted code; false otherwise.  Mirrors
// aarch64_ops.bn's emitBinop for the integer subset — 64-bit register-pair
// operands (int64 / uint64) are NOT handled here: they arrive as aggregate/pair
// values the dispatcher's fail-loud tail rejects, so a same-width read never
// reaches this with a 64-bit type.  Divide / remainder use the ARMv7-A hardware
// SDIV/UDIV the assembler provides (cortex-a15 has integer divide); the IR
// emits an OP_DIV_CHECK guard call before the DIV so a zero / INT_MIN/-1
// divisor traps in the runtime, exactly as on aarch64.
func emitBinop(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_ADD && ins.Op != iropcode.OP_SUB && ins.Op != iropcode.OP_MUL &&
			ins.Op != iropcode.OP_DIV && ins.Op != iropcode.OP_REM && ins.Op != iropcode.OP_AND &&
			ins.Op != iropcode.OP_OR && ins.Op != iropcode.OP_XOR && ins.Op != iropcode.OP_SHL &&
			ins.Op != iropcode.OP_SHR && ins.Op != iropcode.OP_LAND && ins.Op != iropcode.OP_LOR {
		return false
	}
	if len(ins.Args) != 2 { return false }

	// Constant immediate folds: a constant operand marked FoldedImm rides the
	// ADD/SUB modified immediate, the AND/BIC/ORR/EOR modified immediate (or an
	// MVN), or a shifted-register shift amount, per arm32ImmFits, instead of being
	// materialized and — under pressure — spilled/reloaded.  It was neither
	// emitted standalone nor homed.
	if emitAddSubImmFoldArm32(a, rm, ins) { return true }
	if emitLogicImmFoldArm32(a, rm, ins) { return true }
	if emitShiftImmFoldArm32(a, rm, ins) { return true }

	var lhs int = getOperand(a, rm, ins.Args[0].ID)
	var rhs int = getOperand(a, rm, ins.Args[1].ID)
	if lhs < 0 || rhs < 0 { return false }

	var rd int = nextReg(rm, ins.ID)

	// Unsigned-int DIV / REM / SHR need their unsigned arm32 forms; a signed
	// SDIV on a uint with the high bit set gives the wrong answer, and ASR
	// would shift in sign bits on a logically-unsigned right-shift.
	var uTyp @types.Type = types.StripWrappers(ins.Typ)
	var isUnsigned bool = uTyp != nil && uTyp.IsInteger() && !uTyp.Signed

	// Constant multiply/divide/modulo strength reduction (magic-number multiply,
	// power-of-two shift, ×0/1/-1) for the 32-bit path — see arm32_muldiv.bn.
	if ins.Op == iropcode.OP_MUL || ins.Op == iropcode.OP_DIV || ins.Op == iropcode.OP_REM {
		var cval int64
		var isConst bool
		cval, isConst = constDivisorArm32(ins)
		if isConst && emitConstMulDivArm32(a, rm, rd, lhs, rhs, ins.Op, cval, isUnsigned) {
			emitSubWordNarrow(a, rd, ins.Typ)
			return true
		}
	}

	var matched bool = emitBinopArith(a, rd, lhs, rhs, ins.Op, isUnsigned)
	if !matched { return false }
	// Re-narrow a sub-word result so its dirty upper bits can't corrupt a
	// later shift, unsigned compare, division, or widening read.  rd is
	// spilled to its slot after this returns, so the narrowed value is what
	// every later reload sees.  The VM and LLVM hold the same invariant.
	emitSubWordNarrow(a, rd, ins.Typ)
	return true
}

// emitBinopArith emits the register-form arm32 instruction for op, writing the
// result to rd from operands lhs / rhs.  `isUnsigned` selects UDIV vs SDIV and
// LSR vs ASR for the sign-sensitive ops.  Returns whether op was one of the
// binary-arithmetic opcodes (false leaves rd untouched).  Split out of emitBinop
// so that function stays short and the opcode→instruction mapping is one table.
func emitBinopArith(a @asm.Assembler, rd int, lhs int, rhs int, op int, isUnsigned bool) bool {
	if op == iropcode.OP_ADD {
		arm32.Add(a, arm32.COND_AL, false, rd, lhs, arm32.Reg(rhs))
		return true
	}
	if op == iropcode.OP_SUB {
		arm32.Sub(a, arm32.COND_AL, false, rd, lhs, arm32.Reg(rhs))
		return true
	}
	if op == iropcode.OP_MUL {
		arm32.Mul(a, arm32.COND_AL, false, rd, lhs, rhs)
		return true
	}
	if op == iropcode.OP_DIV {
		emitDiv(a, rd, lhs, rhs, isUnsigned)
		return true
	}
	// OP_REM: rd = lhs - (lhs/rhs)*rhs.  Compute the quotient into IP (r12) —
	// caller-saved, dead after this op, and not a pool register — then a single
	// MLS gives the remainder directly.
	if op == iropcode.OP_REM {
		emitDiv(a, arm32.IP, lhs, rhs, isUnsigned)
		arm32.Mls(a, arm32.COND_AL, rd, arm32.IP, rhs, lhs)
		return true
	}
	if op == iropcode.OP_AND || op == iropcode.OP_LAND {
		// OP_LAND / OP_LOR feed switch case-lists where all comparisons are
		// evaluated; plain bitwise on 0/1 bool registers is correct.  User `&&`
		// / `||` short-circuit through branch-form lowering and never reach here.
		arm32.And(a, arm32.COND_AL, false, rd, lhs, arm32.Reg(rhs))
		return true
	}
	if op == iropcode.OP_OR || op == iropcode.OP_LOR {
		arm32.Orr(a, arm32.COND_AL, false, rd, lhs, arm32.Reg(rhs))
		return true
	}
	if op == iropcode.OP_XOR {
		arm32.Eor(a, arm32.COND_AL, false, rd, lhs, arm32.Reg(rhs))
		return true
	}
	if op == iropcode.OP_SHL {
		arm32.Mov(a, arm32.COND_AL, false, rd, arm32.RegSReg(lhs, arm32.LSL, rhs))
		return true
	}
	if op == iropcode.OP_SHR {
		var sh int = arm32.ASR
		if isUnsigned { sh = arm32.LSR }
		arm32.Mov(a, arm32.COND_AL, false, rd, arm32.RegSReg(lhs, sh, rhs))
		return true
	}
	return false
}

// emitDiv emits the ARMv7-A hardware divide into rd (UDIV for unsigned, SDIV
// for signed).  The IR guards every DIV/REM with a preceding OP_DIV_CHECK call
// (rt.DivCheck), so divide-by-zero and INT_MIN/-1 overflow trap in the runtime
// before we reach the hardware instruction — matching aarch64.
func emitDiv(a @asm.Assembler, rd int, lhs int, rhs int, isUnsigned bool) {
	if isUnsigned {
		arm32.Udiv(a, arm32.COND_AL, rd, lhs, rhs)
	} else {
		arm32.Sdiv(a, arm32.COND_AL, rd, lhs, rhs)
	}
}

// emitUnop handles unary ops (-, ~, !).  Returns true if matched.  Negation is
// RSB rd, src, #0 (0 - src); bitwise-not is MVN; boolean-not flips bit 0 with
// EOR #1.  Mirrors aarch64_ops.bn's emitUnop; 64-bit-pair operands don't reach
// here (they fail loud upstream).
func emitUnop(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_NEG && ins.Op != iropcode.OP_BITNOT && ins.Op != iropcode.OP_NOT {
		return false
	}
	if len(ins.Args) != 1 { return false }

	var src int = getOperand(a, rm, ins.Args[0].ID)
	if src < 0 { return false }

	var rd int = nextReg(rm, ins.ID)
	// NEG / BITNOT run at host width, so a sub-word result keeps dirty upper
	// bits that would corrupt a later shift / unsigned compare / widening read.
	// emitSubWordNarrow is a no-op for 32-bit and non-integer results.  NOT is
	// exempt — it already produces a 0/1 bool.
	if ins.Op == iropcode.OP_NEG {
		arm32.Rsb(a, arm32.COND_AL, false, rd, src, arm32.Imm(0))
		emitSubWordNarrow(a, rd, ins.Typ)
		return true
	}
	if ins.Op == iropcode.OP_BITNOT {
		arm32.Mvn(a, arm32.COND_AL, false, rd, arm32.Reg(src))
		emitSubWordNarrow(a, rd, ins.Typ)
		return true
	}
	// OP_NOT: logical negation on a bool.  Flip bit 0.
	arm32.Eor(a, arm32.COND_AL, false, rd, src, arm32.Imm(1))
	return true
}

// emitCast narrows/widens src to target's width, storing the result in rd.  For
// a sub-word target the value is re-canonicalized to the target's signedness by
// SXTB/SXTH (signed) or UXTB/UXTH (unsigned); a 32-bit (or width-0 predeclared
// `int`) target passes through unchanged.  For a widening cast the value is
// re-established from the SOURCE width per the source's signedness (a bit_cast
// result may be a bare reinterpret MOV whose high bits aren't canonical), so
// e.g. bit_cast(int32, <negative float32>) then cast(int, …) sign-extends
// correctly.  On arm32 both source and host word are 32-bit, so a 32→32 widen
// is a no-op; only an 8/16-bit source needs re-extension.  Mirrors the shape of
// aarch64_ops.bn's emitCast but uses the P1 extend encoders (no LSL/ASR pair,
// since the arm32 sub-word widths line up exactly with SXTB/SXTH/UXTB/UXTH).
func emitCast(a @asm.Assembler, rd int, src int, srcTyp @types.Type, target @types.Type) {
	srcTyp = types.StripWrappers(srcTyp)
	target = types.StripWrappers(target)
	var tw int = 0
	if target != nil { tw = target.Width }
	if tw == 8 || tw == 16 {
		var tsigned bool = target != nil && target.Signed
		emitWidthExtend(a, rd, src, tw, tsigned)
		return
	}
	if tw == 32 || tw == 0 {
		// Target is exactly the 32-bit host word (or the width-0 predeclared
		// `int`, which is 32-bit here): re-establish the value from the SOURCE
		// width per the source's signedness.  A 32-bit source is already
		// canonical, so this is a plain MOV; an 8/16-bit source gets re-extended
		// (a bit_cast source may have non-canonical high bits).
		var sw int = 0
		if srcTyp != nil { sw = srcTyp.Width }
		if sw == 8 || sw == 16 {
			var ssigned bool = srcTyp != nil && srcTyp.Signed
			emitWidthExtend(a, rd, src, sw, ssigned)
			return
		}
		if rd != src {
			arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Reg(src))
		}
		return
	}
	// A >32-bit target (int64 / uint64, tw == 64) would need a register pair;
	// such a cast is DEFERRED and must not silently truncate.  Fail loud rather
	// than emit a wrong MOV that drops the high word.
	a.SetError("native arm32: cast to 64-bit target needs register pair "
			"(P3, deferred)")
}

// emitWidthExtend re-canonicalizes src to a w-bit (8 or 16) value in rd, sign-
// extending when signed and zero-extending otherwise.  The single insertion
// point for the sub-word extend encoders so emitCast and any future caller
// agree on the SXTB/SXTH/UXTB/UXTH selection.
func emitWidthExtend(a @asm.Assembler, rd int, src int, w int, signed bool) {
	if signed {
		if w == 8 { arm32.Sxtb(a, arm32.COND_AL, rd, src); return }
		arm32.Sxth(a, arm32.COND_AL, rd, src)
		return
	}
	if w == 8 { arm32.Uxtb(a, arm32.COND_AL, rd, src); return }
	arm32.Uxth(a, arm32.COND_AL, rd, src)
}
