package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// ============================================================
// Constant materialization + frame-adjust helpers
// ============================================================

// emitConstInt32 loads a 32-bit integer constant into rd.  A value that fits
// the ARM rotated-immediate form (EncodeRotImm) takes a single MOV; otherwise
// MOVW (low 16) + MOVT (high 16) always works.  The IR carries int64 IntVal
// but arm32 registers are 32-bit — the low 32 bits are what a same-width
// scalar needs; a genuine 64-bit value is a register pair handled in P3.
func emitConstInt32(a @asm.Assembler, rd int, val int) {
	var lo int = val & 0xFFFF
	var hi int = (val >> 16) & 0xFFFF
	// Single MOV when the whole value fits the rotated-immediate encoding.
	var ri arm32.RotImmResult = arm32.EncodeRotImm(val)
	if ri.Ok {
		arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Imm(val))
		return
	}
	arm32.Movw(a, arm32.COND_AL, rd, lo)
	if hi != 0 {
		arm32.Movt(a, arm32.COND_AL, rd, hi)
	}
}

// emitSpAdjust changes SP by `amount` bytes: `add sp, sp, #amount` when grow
// is true, `sub sp, sp, #amount` otherwise.  A frame that fits the rotated-
// immediate form adjusts in one instruction; a larger frame materializes the
// amount in IP (r12, the intra-procedure scratch) via emitConstInt32 first,
// then adds/subtracts the register.  PlanFrame keeps the frame 8-byte aligned
// (AAPCS32 StackAlign), so SP stays 8-aligned across the adjust.
func emitSpAdjust(a @asm.Assembler, grow bool, amount int) {
	var ri arm32.RotImmResult = arm32.EncodeRotImm(amount)
	if ri.Ok {
		if grow {
			arm32.Add(a, arm32.COND_AL, false, arm32.SP, arm32.SP,
				arm32.Imm(amount))
		} else {
			arm32.Sub(a, arm32.COND_AL, false, arm32.SP, arm32.SP,
				arm32.Imm(amount))
		}
		return
	}
	// Large frame: build the amount in IP, then add/sub the register.
	emitConstInt32(a, arm32.IP, amount)
	if grow {
		arm32.Add(a, arm32.COND_AL, false, arm32.SP, arm32.SP,
			arm32.Reg(arm32.IP))
	} else {
		arm32.Sub(a, arm32.COND_AL, false, arm32.SP, arm32.SP,
			arm32.Reg(arm32.IP))
	}
}

// emitEpilogueAndRet tears down the frame and returns:
//   add sp, sp, #frameSize
//   pop {r4-r12, pc}          ; LDM sp!, {r4-r12, pc} — loading PC returns
func emitEpilogueAndRet(a @asm.Assembler, frameSize int) {
	if frameSize > 0 {
		emitSpAdjust(a, true, frameSize)
	}
	arm32.Pop(a, arm32.COND_AL, POP_REGMASK)
}
