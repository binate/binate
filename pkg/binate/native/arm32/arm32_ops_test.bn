package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// mkAsm builds a fresh assembler with an open text section, ILP32 word.
func mkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	return a
}

func bytesWritten(a @asm.Assembler) int { return a.Sections[0].Len }

// word32 reads the little-endian 32-bit instruction at byte offset `off`.
func word32(a @asm.Assembler, off int) uint32 {
	var d *[]uint8 = a.Sections[0].Data
	var b0 uint32 = cast(uint32, d[off])
	var b1 uint32 = cast(uint32, d[off + 1])
	var b2 uint32 = cast(uint32, d[off + 2])
	var b3 uint32 = cast(uint32, d[off + 3])
	return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

// A small immediate that fits the rotated-immediate form materializes in a
// single MOV (4 bytes).
func TestEmitConstInt32SmallIsSingleMov() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitConstInt32(a, arm32.R0, 5)
	if bytesWritten(a) != 4 {
		return fail("small constant should be a single MOV (4 bytes)")
	}
	// MOV R0, #5 = 0xE3A00005.
	if word32(a, 0) != cast(uint32, 0xE3A00005) {
		return fail("expected MOV R0, #5 = 0xE3A00005")
	}
	return ""
}

// A value that doesn't fit the rotated-immediate form needs MOVW + MOVT
// (8 bytes): 0x12345 has a nonzero high half.
func TestEmitConstInt32WideIsMovwMovt() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitConstInt32(a, arm32.R0, 0x12345)
	if bytesWritten(a) != 8 {
		return fail("wide constant should be MOVW+MOVT (8 bytes)")
	}
	return ""
}

// A wide value whose high half is zero but low half doesn't fit rot-imm needs
// only MOVW (4 bytes) — MOVT is skipped when hi == 0.
func TestEmitConstInt32LowOnlyIsMovwOnly() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitConstInt32(a, arm32.R0, 0x1234)
	if bytesWritten(a) != 4 {
		return fail("low-half-only wide constant should be MOVW only (4 bytes)")
	}
	return ""
}

// The epilogue for a zero-size frame is a single `pop {r4-r12, pc}`
// (LDM sp!, {r4-r12,pc} = 0xE8BD9FF0).
func TestEpilogueZeroFrame() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitEpilogueAndRet(a, 0)
	if bytesWritten(a) != 4 {
		return fail("zero-frame epilogue should be a single POP (4 bytes)")
	}
	if word32(a, 0) != cast(uint32, 0xE8BD9FF0) {
		return fail("expected pop {r4-r12, pc} = 0xE8BD9FF0")
	}
	return ""
}

// A nonzero frame adds `add sp, sp, #frameSize` before the pop (8 bytes).
func TestEpilogueNonzeroFrame() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitEpilogueAndRet(a, 16)
	if bytesWritten(a) != 8 {
		return fail("nonzero-frame epilogue should be ADD SP + POP (8 bytes)")
	}
	return ""
}
