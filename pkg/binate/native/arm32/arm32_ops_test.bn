package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// mkAsm builds a fresh assembler with an open text section, ILP32 word.
func mkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	return a
}

func bytesWritten(a @asm.Assembler) int { return a.Sections[0].Len }

// word32 reads the little-endian 32-bit instruction at byte offset `off`.
func word32(a @asm.Assembler, off int) uint32 {
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var d *[]uint8 = a.Sections[0].Data
	var b0 uint32 = cast(uint32, d[off])
	var b1 uint32 = cast(uint32, d[off + 1])
	var b2 uint32 = cast(uint32, d[off + 2])
	var b3 uint32 = cast(uint32, d[off + 3])
	return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

// A small immediate that fits the rotated-immediate form materializes in a
// single MOV (4 bytes).
func TestEmitConstInt32SmallIsSingleMov() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitConstInt32(a, arm32.R0, 5)
	if bytesWritten(a) != 4 {
		return fail("small constant should be a single MOV (4 bytes)")
	}
	// MOV R0, #5 = 0xE3A00005.
	if word32(a, 0) != cast(uint32, 0xE3A00005) {
		return fail("expected MOV R0, #5 = 0xE3A00005")
	}
	return ""
}

// A value that doesn't fit the rotated-immediate form needs MOVW + MOVT
// (8 bytes): 0x12345 has a nonzero high half.
func TestEmitConstInt32WideIsMovwMovt() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitConstInt32(a, arm32.R0, 0x12345)
	if bytesWritten(a) != 8 {
		return fail("wide constant should be MOVW+MOVT (8 bytes)")
	}
	return ""
}

// A wide value whose high half is zero but low half doesn't fit rot-imm needs
// only MOVW (4 bytes) — MOVT is skipped when hi == 0.
func TestEmitConstInt32LowOnlyIsMovwOnly() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitConstInt32(a, arm32.R0, 0x1234)
	if bytesWritten(a) != 4 {
		return fail("low-half-only wide constant should be MOVW only (4 bytes)")
	}
	return ""
}

// The epilogue for a zero-size frame is a single `pop {r4-r12, pc}`
// (LDM sp!, {r4-r12,pc} = 0xE8BD9FF0).
func TestEpilogueZeroFrame() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitEpilogueAndRet(a, 0)
	if bytesWritten(a) != 4 {
		return fail("zero-frame epilogue should be a single POP (4 bytes)")
	}
	if word32(a, 0) != cast(uint32, 0xE8BD9FF0) {
		return fail("expected pop {r4-r12, pc} = 0xE8BD9FF0")
	}
	return ""
}

// A nonzero frame adds `add sp, sp, #frameSize` before the pop (8 bytes).
func TestEpilogueNonzeroFrame() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitEpilogueAndRet(a, 16)
	if bytesWritten(a) != 8 {
		return fail("nonzero-frame epilogue should be ADD SP + POP (8 bytes)")
	}
	return ""
}

// emitAddImm with a rotated-immediate-encodable offset is a single ADD (4
// bytes) — no scratch materialization.
func TestEmitAddImmSmallIsSingleAdd() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitAddImm(a, arm32.R4, arm32.SP, 8, arm32.IP)
	if bytesWritten(a) != 4 {
		return fail("a rot-imm-encodable offset should be a single ADD (4 bytes)")
	}
	return ""
}

// emitAddImm with an offset that does NOT fit the ARM rotated-immediate form
// (e.g. 1268) must materialize it in the scratch first, then ADD the register —
// NOT silently encode #0 (the frame-offset corruption that read slice headers
// at sp+0 → `index out of bounds: 0 (len 0)`).  So it emits MORE than one
// instruction and the final word is a register-form ADD, not `add rd, rn, #0`.
func TestEmitAddImmLargeMaterializes() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitAddImm(a, arm32.R4, arm32.SP, 1268, arm32.IP)
	if bytesWritten(a) <= 4 {
		return fail("a non-rot-imm offset must materialize a scratch, not a lone ADD")
	}
	// The final instruction is the register-form ADD R4, SP, IP; its low bits
	// carry IP (r12) as the Operand2 register (I=0), NOT a #0 immediate.
	var last uint32 = word32(a, bytesWritten(a) - 4)
	if (last & cast(uint32, 0x02000000)) != 0 {
		return fail("final ADD must be register-form (I=0), not an immediate")
	}
	if (last & cast(uint32, 0xf)) != cast(uint32, arm32.IP) {
		return fail("final ADD's Operand2 must be the IP scratch register")
	}
	return ""
}

// emitFrameScalarStore with a size-1 (byte) offset past the extra-load 8-bit
// field (255) must materialize the base in IP rather than trip the encoder — so
// it emits more than a single STRB.
func TestEmitFrameScalarStoreLargeByteOffset() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitFrameScalarStore(a, arm32.R4, 300, 1)
	if bytesWritten(a) <= 4 {
		return fail("a byte store past offset 255 must materialize the base in IP")
	}
	if a.HasError {
		return fail("a large byte-store offset must not error (routed through IP)")
	}
	return ""
}

// emitBinop matches OP_ADD and emits a single register-form ADD (4 bytes) whose
// Operand2 is the RHS register.  twoOpArm32 (arm32_compare_test.bn) sets the
// operand registers.  ADD is data-processing opcode 0x4 in bits [24:21].
func TestBinopAddEmitsAdd() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = twoOpArm32(rm, iropcode.OP_ADD, types.TypInt())
	if !emitBinop(a, rm, ins) {
		return fail("emitBinop must match OP_ADD")
	}
	if bytesWritten(a) != 4 {
		return fail("int ADD should be a single instruction (4 bytes)")
	}
	var w uint32 = word32(a, 0)
	if ((w >> 21) & cast(uint32, 0xf)) != cast(uint32, 0x4) {
		return fail("expected an ADD data-processing opcode (0x4)")
	}
	return ""
}

// emitBinop routes an unsigned right-shift through the LSR shift form (not ASR),
// so a logically-unsigned value's high bits aren't sign-filled.  The shift is
// realized as MOV rd, rn LSR rs (data-processing MOV, opcode 0xD).
func TestBinopUnsignedShrIsLsr() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = twoOpArm32(rm, iropcode.OP_SHR, types.TypUint32())
	if !emitBinop(a, rm, ins) {
		return fail("emitBinop must match OP_SHR")
	}
	var w uint32 = word32(a, 0)
	if ((w >> 21) & cast(uint32, 0xf)) != cast(uint32, 0xD) {
		return fail("a register shift should be a MOV data-processing op (0xD)")
	}
	if ((w >> 5) & cast(uint32, 0x3)) != cast(uint32, arm32.LSR) {
		return fail("unsigned SHR must use the LSR shift type, not ASR")
	}
	return ""
}

// emitBinop divide routes through the ARMv7-A hardware SDIV for a signed type,
// a single instruction.  SDIV base word is 0x0710F010.
func TestBinopSignedDivIsSdiv() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = twoOpArm32(rm, iropcode.OP_DIV, types.TypInt())
	if !emitBinop(a, rm, ins) {
		return fail("emitBinop must match OP_DIV")
	}
	if bytesWritten(a) != 4 {
		return fail("signed DIV should be a single SDIV (4 bytes)")
	}
	var w uint32 = word32(a, 0)
	if (w & cast(uint32, 0x0FF000F0)) != cast(uint32, 0x0710F010 & 0x0FF000F0) {
		return fail("expected an SDIV encoding")
	}
	return ""
}

// emitUnop negates via RSB rd, src, #0 (0 - src) — reverse-subtract with an
// immediate 0, one instruction (data-processing opcode 0x3).
func TestUnopNegIsRsb() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AssignReg(10, arm32.R5)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 10
	src.Typ = types.TypInt()
	var args @[]@ir.Instr
	args = appendInstr_arm32cmptest(args, src)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_NEG
	ins.Typ = types.TypInt()
	ins.Args = args
	if !emitUnop(a, rm, ins) {
		return fail("emitUnop must match OP_NEG")
	}
	var w uint32 = word32(a, 0)
	if ((w >> 21) & cast(uint32, 0xf)) != cast(uint32, 0x3) {
		return fail("NEG must be an RSB data-processing op (0x3)")
	}
	return ""
}

// emitCast narrowing to int8 uses SXTB (sign-extend byte).  SXTB base is
// 0x06AF0070 (with cond AL); check the opcode/selector bits.
func TestCastToInt8IsSxtb() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitCast(a, arm32.R4, arm32.R5, types.TypInt(), types.TypInt8())
	if bytesWritten(a) != 4 {
		return fail("narrowing cast to int8 should be a single SXTB (4 bytes)")
	}
	var w uint32 = word32(a, 0)
	if (w & cast(uint32, 0x0FF00070)) != cast(uint32, 0x06A00070 & 0x0FF00070) {
		return fail("expected an SXTB extend encoding")
	}
	return ""
}

// emitCast to a 64-bit target needs a register pair (deferred) and must fail
// LOUDLY rather than silently truncate to the low word.
func TestCastTo64BitSetsError() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	emitCast(a, arm32.R4, arm32.R5, types.TypInt(), types.TypInt64())
	if !a.HasError {
		return fail("a cast to a 64-bit target must set a compile error (deferred)")
	}
	return ""
}
