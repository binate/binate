package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/builtins/testing"

// emitPackageDescriptor always emits the descriptor node + name + the
// `__Package` accessor function, even for a module with no exported
// funcs/globals/vtables.  The accessor is a leaf: materialize the node address
// (MOVW/MOVT), += managed header, `bx lr`.  A trivial module still produces a
// non-empty text section from the accessor.
func TestPackageDescriptorEmitsAccessor() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var m @ir.Module = ir.NewModule("\"main\"")
	emitPackageDescriptor(a, "main", m)
	// Accessor: MOVW + MOVT + ADD + BX LR = 4 instructions = 16 bytes.
	if a.Sections[0].Len < 16 {
		return fail("emitPackageDescriptor should emit the __Package accessor")
	}
	// The accessor's own symbol must be defined.
	if a.LookupSymbol("bn_F1_4_main1_9___Package") < 0 {
		return fail("emitPackageDescriptor should define the __Package symbol")
	}
	return ""
}

// A module with an impl must DEFINE its `__pkg_satentries` backing array (the
// descriptor lists the __satentry nodes it emits).  Passing `noSatEntries` while
// still emitting the nodes would leave `__pkg_satentries` undefined, and the
// package's own `__pkg_satfrag` node symrefs `__pkg_satentries` in the same object
// (an undefined symbol at native emit).  Pin that the descriptor defines it.
func TestPackageDescriptorEmitsSatEntries() testing.TestResult {
	setArm32TargetIface()
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() }\n"
			"type T struct { x int }\n"
			"func (t *T) foo() { }\n"
			"impl *T : I\n"
			"func main() { }\n"
	var mod @ir.Module = genFromSrcIface(src)
	var a @asm.Assembler = ifaceMkAssembler()
	emitPackageDescriptor(a, "main", mod)
	if a.LookupSymbol(globalSymFor("main", "__pkg_satentries")) < 0 {
		return fail("descriptor must define __pkg_satentries for a module with an impl")
	}
	return ""
}

// handleSymFor produces the BARE ELF handle label with exactly TWO leading
// underscores (`__handle.<mangled>`), matching the @__handle.<mangled> globals
// pkg/binate/codegen (x64/ELF reference) emits.  A three-underscore
// `___handle.` form is the Mach-O-decorated shape and would fail to link
// against LLVM/x64-compiled ELF deps — pin the 2-underscore form so a
// `___handle.` form fails here.  Mirrors
// x64_funcvalue_test.bn's handleSymFor_x64 assertion.
func TestHandleSymForIsBareElf() testing.TestResult {
	var h @[]char = handleSymFor("main", "main.main")
	if !charEq(h, "__handle.bn_F1_4_main1_4_main") {
		return fail("handleSymFor must be bare 2-underscore __handle.<mangled>")
	}
	// Guard against the Mach-O 3-underscore form specifically.
	if len(h) >= 3 && h[0] == cast(char, '_') && h[1] == cast(char, '_') && h[2] == cast(char, '_') {
		return fail("handleSymFor must not use the 3-underscore ___handle. form")
	}
	return ""
}

// collectVtablesArm32 returns no rows for a module with no impls.
func TestCollectVtablesEmpty() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var vtables @[]@irdata.PkgVtableEntry = collectVtablesArm32("main", m)
	if len(vtables) != 0 {
		return fail("collectVtablesArm32 should be empty with no impls")
	}
	return ""
}

// ifaceIdModuleArm32 builds a module "pkg/x" whose one function looks a box up
// with interface J (an OP_SAT_LOOKUP on J's marker), as an interface-target
// assertion does.
func ifaceIdModuleArm32() @ir.Module {
	var m @ir.Module = ir.NewModule("\"pkg/x\"")
	var f @ir.Func = ir.NewFunc("pkg/x", "f", make_slice(@ir.Param, 0), make_slice(@types.Type, 0))
	var b @ir.Block = ir.AddBlock(f, "entry")
	var rawPtr @types.Type = types.MakePointerType(types.TypUint8())
	irbuild.EmitSatLookup(b, irbuild.EmitConstNil(b, rawPtr),
			irbuild.EmitDataSymAddr(b, mangle.IfaceIdName("pkg/x", "J"), types.TypUint8()))
	m.AddFunc(f)
	return m
}

// A module whose code looks a box up with J lists J's marker in the descriptor's
// IfaceIds table: the row names the NEUTRAL marker (the VM's key) and targets the
// object-format-prefixed one this backend defines, and the descriptor defines the
// row's weak node and the `__pkg_ifaceids` array.
func TestEmitPackageDescriptorIfaceIdsArm32() testing.TestResult {
	setArm32TargetIface()
	var mod @ir.Module = ifaceIdModuleArm32()
	var marker @[]char = mangle.IfaceIdName("pkg/x", "J")
	var rows @[]@irdata.PkgIfaceIdEntry = collectIfaceIdsArm32(mod)
	if len(rows) != 1 { return fail("expected one IfaceIds row, for J") }
	if !charEq(rows[0].Name, marker) { return fail("the row should name the neutral marker") }
	if !charEq(rows[0].MarkerSym, symPrefixed(marker)) {
		return fail("the row should target the marker symbol this backend defines")
	}
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitPackageDescriptor(a, "pkg/x", mod)
	if a.LookupSymbol(globalSymFor("pkg/x", "__pkg_ifaceids")) < 0 {
		return fail("the descriptor should define the __pkg_ifaceids array")
	}
	if a.LookupSymbol(rows[0].NodeSym) < 0 {
		return fail("the descriptor should define J's IfaceIdInfo node")
	}
	return ""
}

// A module that looks nothing up lists no marker.
func TestEmitPackageDescriptorNoIfaceIdsArm32() testing.TestResult {
	setArm32TargetIface()
	if len(collectIfaceIdsArm32(ir.NewModule("\"pkg/x\""))) != 0 {
		return fail("a module with no satisfaction lookup should list no marker")
	}
	return ""
}
