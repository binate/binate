package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/builtins/testing"

// emitPackageDescriptor always emits the descriptor node + name + the
// `__Package` accessor function, even for a module with no exported
// funcs/globals/vtables.  The accessor is a leaf: materialize the node address
// (MOVW/MOVT), += managed header, `bx lr`.  A trivial module still produces a
// non-empty text section from the accessor.
func TestPackageDescriptorEmitsAccessor() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var m @ir.Module = ir.NewModule("\"main\"")
	emitPackageDescriptor(a, "main", m)
	// Accessor: MOVW + MOVT + ADD + BX LR = 4 instructions = 16 bytes.
	if a.Sections[0].Len < 16 {
		return fail("emitPackageDescriptor should emit the __Package accessor")
	}
	// The accessor's own symbol must be defined.
	if a.LookupSymbol("bn_F1_4_main1_9___Package") < 0 {
		return fail("emitPackageDescriptor should define the __Package symbol")
	}
	return ""
}

// handleSymFor produces the BARE ELF handle label with exactly TWO leading
// underscores (`__handle.<mangled>`), matching the @__handle.<mangled> globals
// pkg/binate/codegen (x64/ELF reference) emits.  A three-underscore
// `___handle.` form is the Mach-O-decorated shape and would fail to link
// against LLVM/x64-compiled ELF deps — pin the 2-underscore form so a
// regression back to `___handle.` stays observable.  Mirrors
// x64_funcvalue_test.bn's handleSymFor_x64 assertion.
func TestHandleSymForIsBareElf() testing.TestResult {
	var h @[]char = handleSymFor("main", "main.main")
	if !charEq(h, "__handle.bn_F1_4_main1_4_main") {
		return fail("handleSymFor must be bare 2-underscore __handle.<mangled>")
	}
	// Guard against the Mach-O 3-underscore regression specifically.
	if len(h) >= 3 && h[0] == cast(char, '_') && h[1] == cast(char, '_') && h[2] == cast(char, '_') {
		return fail("handleSymFor must not use the 3-underscore ___handle. form")
	}
	return ""
}

// collectVtablesArm32 returns no rows for a module with no impls.
func TestCollectVtablesEmpty() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var vtables @[]@ir.PkgVtableEntry = collectVtablesArm32("main", m)
	if len(vtables) != 0 {
		return fail("collectVtablesArm32 should be empty with no impls")
	}
	return ""
}
