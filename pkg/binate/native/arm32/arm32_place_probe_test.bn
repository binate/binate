package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/mangle"
import "pkg/binate/native/place"
import "pkg/binate/types"
import "pkg/builtins/testing"

// The placement probe on arm32: the probed function's first entry point lands on
// each phase in turn while every other byte of .text stays where it was.

// probeAt returns PlaceOptions{seed, mode} probing placeFuncs()[i] at phase.
func probeAt(seed int, mode int, i int, phase int) place.PlaceOptions {
	var p place.PlaceOptions
	p.Seed = seed
	p.Mode = mode
	p.ProbeSym = mangle.FuncName("main", placeFuncs()[i])
	p.ProbePhase = phase
	return p
}

// probeEnd returns where function i ends in a: its first entry plus its own
// bytes.
func probeEnd(a @asm.Assembler, i int) int {
	return placeEntry(a, i) + placeAlone("elf", i).Sections[0].Len
}

// checkProbeEveryPhase probes function i at every phase the 4-byte unit allows,
// under seed and mode: each text passes checkPlacedText, aligns .text to
// PLACE_SPAN and puts the probed entry on its phase, and all of them have the same
// length, the same bytes before the probed function's leading filler and after
// its trailing filler, and the same later entry points.
func checkProbeEveryPhase(seed int, mode int, i int) testing.TestResult {
	var first @asm.Assembler
	var firstHi int = 0
	for phase := 0; phase < place.PLACE_SPAN; phase = phase + 4 {
		var p place.PlaceOptions = probeAt(seed, mode, i, phase)
		var r testing.TestResult = checkPlacedText(p)
		if len(r) > 0 { return r }
		var a @asm.Assembler = placeEmit("elf", p)
		if a.Sections[0].Align != place.PLACE_SPAN { return fail("a probe aligns .text to 64") }
		if placeEntry(a, i) % place.PLACE_SPAN != phase { return fail("the probe is off its phase") }
		// The leading filler starts where the previous function ends.
		var lo int = 0
		if i > 0 { lo = probeEnd(a, i - 1) }
		var pre int = place.PlaceFillBefore(p, p.ProbeSym, 4, lo)
		var hi int = probeEnd(a, i) + place.PlaceFillAfter(p, p.ProbeSym, pre)
		if first == nil {
			first = a
			firstHi = hi
			continue
		}
		if hi != firstHi { return fail("the code after the probe moved with its phase") }
		var n int = a.Sections[0].Len
		if n != first.Sections[0].Len { return fail("the probe phase changed .text's length") }
		for k := 0; k < n; k++ {
			if (k < lo || k >= hi) && a.Sections[0].Data[k] != first.Sections[0].Data[k] {
				return fail("a byte outside the probed function changed with its phase")
			}
		}
		for k := i + 1; k < len(placeFuncs()); k++ {
			if placeEntry(a, k) != placeEntry(first, k) { return fail("a later entry point moved") }
		}
	}
	return ""
}

// Probing each function, the first in .text included, at seed 0 and under a seed
// in each mode, moves only the probed function.
func TestArm32PlaceProbeEveryPhase() testing.TestResult {
	var old types.TargetInfo = stampIlp32()
	defer { types.SetTarget(old) }
	for i := 0; i < len(placeFuncs()); i++ {
		var r testing.TestResult = checkProbeEveryPhase(0, place.PLACE_PHASE, i)
		if len(r) > 0 { return r }
		r = checkProbeEveryPhase(7, place.PLACE_PHASE, i)
		if len(r) > 0 { return r }
		r = checkProbeEveryPhase(12345, place.PLACE_SHIFT, i)
		if len(r) > 0 { return r }
	}
	return ""
}

// A probe phase that is not a multiple of 4 fails EmitObject on arm32.
func TestArm32PlaceProbeRejectsSubUnitPhase() testing.TestResult {
	var old types.TargetInfo = stampIlp32()
	defer { types.SetTarget(old) }
	if placeEmit("elf", probeAt(0, place.PLACE_PHASE, 2, 6)) != nil {
		return fail("phase 6 is not a multiple of the arm32 filler unit")
	}
	if placeEmit("elf", probeAt(0, place.PLACE_PHASE, 2, 8)) == nil { return fail("phase 8 is valid") }
	return ""
}
