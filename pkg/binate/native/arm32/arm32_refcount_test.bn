package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the inline refcount handlers (emitRefIncInline /
// emitRefDecInline) — the ILP32 fast paths mirroring aarch64_refcount.bn with
// CMP/TST + conditional B in place of CBZ/TBNZ/CBNZ.

// oneArgRefOp builds an OP_REFINC / OP_REFDEC instr with a single managed-ptr
// operand (id 10) pre-assigned register R5.
func oneArgRefOp(rm @common.RegMap, op int) @ir.Instr {
	rm.AssignReg(10, arm32.R5)
	var p @ir.Instr = make(ir.Instr)
	p.ID = 10
	p.Typ = types.MakeManagedSliceType(types.TypInt())
	var args @[]@ir.Instr
	args = appendInstr_arm32rctest(args, p)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = op
	ins.Args = args
	return ins
}

// appendInstr_arm32rctest grows a @[]@ir.Instr by one.
func appendInstr_arm32rctest(s @[]@ir.Instr, v @ir.Instr) @[]@ir.Instr {
	var n @[]@ir.Instr = make_slice(@ir.Instr, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}

// emitRefIncInline emits the nil-check + header load/add/store fast path and
// defines its skip label.  The first instruction is a CMP against #0 (the
// nil-check); the sequence is several words and the skip label resolves (no
// unresolved-fixup error at Finalize).
func TestRefIncInlineEmitsNilCheck() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = oneArgRefOp(rm, 0)  // op value irrelevant; handler is direct
	emitRefIncInline(a, rm, ins)
	if a.HasError {
		return fail("refinc fast path must not error")
	}
	if bytesWritten(a) < 20 {
		return fail("refinc should emit the CMP/B nil-check + header load/add/store")
	}
	// First word is CMP R5, #0 — a compare (data-processing opcode 0xA, S=1,
	// Rn = R5).  Check the opcode + Rn fields.
	var w uint32 = word32(a, 0)
	if ((w >> 21) & cast(uint32, 0xf)) != cast(uint32, 0xA) {
		return fail("first refinc instruction must be a CMP (opcode 0xA)")
	}
	if ((w >> 16) & cast(uint32, 0xf)) != cast(uint32, arm32.R5) {
		return fail("the CMP's Rn must be the managed-ptr register (R5)")
	}
	return ""
}

// emitRefDecInline emits the nil-check + header dec + refcount==0 test + the
// slow-path rt.ZeroRefDestroy call, registering that callee symbol so the link
// resolves.
func TestRefDecInlineCallsZeroRefDestroy() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = oneArgRefOp(rm, 1)
	emitRefDecInline(a, rm, ins)
	if a.HasError {
		return fail("refdec fast path must not error")
	}
	if a.LookupSymbol("bn_F3_3_pkg8_builtins2_rt1_14_ZeroRefDestroy") < 0 {
		return fail("refdec slow path must reference rt.ZeroRefDestroy")
	}
	return ""
}
