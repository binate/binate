package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/std/fmt"

// ============================================================
// ARM32-specific register allocation over common.RegMap
// ============================================================
//
// Frame layout, lookups, and type predicates live in pkg/binate/native/common.
// This file owns the pieces that touch ARM registers or emit instructions:
// the scratch-register pool, the Ldr-on-use reload in getOperand, and the
// Str-on-result spill in spillAndReset.  Mirrors aarch64_regmap.bn.

// regPool is the callee-saved scratch set we hand out to values.  R0-R3 are
// reserved for args/returns; R4-R10 are the ONLY allocatable scratches —
// exactly 7 slots, indexed 0..6 — and the prologue saves/restores them so we
// may clobber them freely across the function.  R11 is the frame pointer
// (reserved); R12 (IP) is the dedicated frame-offset / div-quotient /
// aggregate-overflow scratch and is NOT in the pool (see the body); R13/R14/R15
// are SP/LR/PC.
//
// Register pressure is far tighter than aarch64 (X9..X17), so the pool is
// exhausted sooner.  Index 7 (and beyond) panics; that signals an op pattern
// needing 8+ simultaneously-live scratches, which structurally needs a
// different approach (spill-on-exhaustion or a per-arg ResetRegs like
// emitCall).  The panic prints currentEmitOp so the offending op identifies
// itself.  (The current worst cases — emitCompare64Eq / emitDivCheck64 — use
// exactly 7 scratches, at the ceiling with zero headroom.)
//
// BL discipline: R12 is clobbered by any BL (AAPCS caller-saved / linker
// veneer scratch), so no emitter may read a pool-allocated reg after a BL
// without an intervening ResetRegs.  Every call site in this package resets
// the pool after the branch, keeping this safe.
func regPool(i int) int {
	if i == 0 { return arm32.R4 }
	if i == 1 { return arm32.R5 }
	if i == 2 { return arm32.R6 }
	if i == 3 { return arm32.R7 }
	if i == 4 { return arm32.R8 }
	if i == 5 { return arm32.R9 }
	if i == 6 { return arm32.R10 }
	// R12/IP is deliberately NOT in the allocatable pool: it is the
	// dedicated scratch the frame-offset materialization (emitAddImm /
	// emitFrame*), the div/rem quotient temp, and the aggregate-arg
	// overflow-copy temp all clobber freely.  Were it also a value
	// register, a live value in R12 would be silently destroyed the
	// moment one of those helpers ran under register pressure — the
	// exact silent-miscompile the fail-loud discipline forbids.  Mirrors
	// aarch64 reserving X16/X17 outside its X9..X15 pool.
	fmt.Print("native arm32: regPool exhausted while emitting op=", currentEmitOp, "\n")
	panic(
			"native arm32: regPool exhausted (R4..R10 saturated); "
					"any op needing 8+ live scratches needs a per-arg ResetRegs "
					"or a spill strategy (R12/IP is reserved as dedicated scratch)")
	return 0 // unreachable
}

// currentEmitOp is set by emitInstr at the start of each lowering to the
// integer ir.OP_* constant of the instruction being emitted.  Used only by
// the regPool-exhaustion panic to identify which op pattern hit saturation.
var currentEmitOp int

// scratchReg hands out an ephemeral register (not recorded in the id→reg
// map).  Used for working registers that won't outlive the current
// instruction.
// allocReg hands out a pool register (R4..R10) for the currently-emitting
// instruction, occupancy-aware for within-block value retention: it prefers a
// genuinely FREE register (one holding no retained value), and only under
// register pressure evicts a retained value — whose spill slot still holds it,
// so eviction is loss-free.  Registers this instruction already claimed
// (CurUsed) are never handed out again.  The returned register is marked used.
//
// The pool (R4..R10) is the callee-saved bank, disjoint from the R0..R3
// caller-saved home bank and from R12/IP (the reserved frame/div/copy scratch),
// so a retained pool value never collides with a home or an IP-clobbering
// helper.  The one mainline emitter that writes a pool register directly (the
// inline string-byte store's R4, in emitStringToArray / emitStringToCharsCopy)
// is safe by loss-free eviction: a retained value in R4 still lives in its
// spill slot, nothing reads a cached value between that write and the emitter's
// own rm.ResetRegs(), and the op resets the cache afterward — so no later use
// ever reads the clobbered R4.
func allocReg(m @common.RegMap) int {
	for i := 0; i <= 6; i = i + 1 {
		var r int = regPool(i)
		if !m.IsUsed(r) && m.RegHeldBy(r) < 0 {
			m.MarkUsed(r)
			return r
		}
	}
	for i := 0; i <= 6; i = i + 1 {
		var r int = regPool(i)
		if !m.IsUsed(r) {
			m.EvictReg(r)
			m.MarkUsed(r)
			return r
		}
	}
	// Every pool register is claimed by the current instruction: the
	// pre-existing exhaustion case, reported by regPool's own panic.
	return regPool(7)
}

// scratchReg hands out an ephemeral register (not registered in the id→reg
// map).  Used when an emitter needs a working register that won't outlive the
// current instruction.
func scratchReg(m @common.RegMap) int {
	return allocReg(m)
}

// nextReg allocates a register to hold SSA id's result.  A register-allocated
// value computes directly into its stable HOME register (caller-saved, R0..R3)
// — bypassing the transient scratch pool, so it is not stored back by
// spillAndReset and survives ResetRegs / block boundaries.  A spilled value
// takes a scratch-pool register and is recorded in the transient map
// (spillAndReset then stores it to its slot).  Homes are caller-saved, so
// (unlike aarch64/x64) the prologue/epilogue does NOT save/restore them; the
// allocator only homes a value there when it is not live across a clobber
// (ClobberPositions), so no call can destroy a homed value.
func nextReg(m @common.RegMap, id int) int {
	var home int = m.LookupHome(id)
	if home >= 0 { return home }
	var r int = allocReg(m)
	return m.AssignReg(id, r)
}

// getOperand returns the register holding SSA id, reloading it from its spill
// slot into a fresh scratch if it isn't already live.  For OP_ALLOC values —
// whose SSA identity is "pointer to the alloca's storage" — it materializes
// that pointer on demand as `add rd, sp, #alloc_off`.  Returns -1 on miss.
func getOperand(a @asm.Assembler, m @common.RegMap, id int) int {
	// A register-allocated value lives in its home register for its whole
	// lifetime — return it directly, with no reload.
	var home int = m.LookupHome(id)
	if home >= 0 { return home }
	var r int = m.LookupReg(id)
	if r >= 0 {
		// A retained value cached in a pool register (within-block retention).
		// Mark it used so this instruction's later scratch/result allocation
		// won't reuse it.
		m.MarkUsed(r)
		return r
	}
	var allocOff int = m.LookupAlloc(id)
	if allocOff >= 0 {
		var rd int = nextReg(m, id)
		emitFrameAddr(a, rd, allocOff)
		return rd
	}
	var off int = m.LookupSpill(id)
	if off >= 0 {
		var rd int = nextReg(m, id)
		emitFrameLoad(a, rd, off)
		return rd
	}
	return -1
}

// emitValOperand resolves an instruction to a register holding its VALUE — the
// IsGlobalRef-aware value-operand analogue of getOperand.  The IsGlobalRef
// pseudo (a top-level global's address used as an rvalue) has ID -1 and no SSA
// register, so getOperand would miss and return -1; materialize its address
// into a fresh scratch via emitGlobalAddr (MOVW/MOVT) instead.
func emitValOperand(a @asm.Assembler, pkgName *[]readonly char, m @common.RegMap,
		ins @ir.Instr) int {
	if isGlobalRef(ins) {
		var rd int = scratchReg(m)
		emitGlobalAddr(a, pkgName, rd, ins)
		return rd
	}
	return getOperand(a, m, ins.ID)
}

// spillAndReset stores the result of a just-emitted instruction to its stack
// slot (if any) and clears the register map.  Called after every instruction
// — the "spill everything" policy means each op loads operands, computes,
// then hands off to memory.
func spillAndReset(a @asm.Assembler, m @common.RegMap, ins @ir.Instr, branchEmitted bool) {
	if ins.ID >= 0 {
		var reg int = m.LookupReg(ins.ID)
		if reg >= 0 {
			var off int = m.LookupSpill(ins.ID)
			if off >= 0 {
				emitFrameStore(a, reg, off)
			}
		}
	}
	// Within-block value retention: keep the IDs/Regs cache live ACROSS
	// instructions so a later use reads a register (getOperand's LookupReg hit)
	// instead of reloading its spill slot.  The store above still runs for every
	// result, so a value stays recoverable from its slot after eviction or at
	// block end.  Drop the whole cache after any instruction that emitted a
	// branch (an inline fail-path the mainline skips desyncs the emit-time cache
	// from the mainline register state) or is a returning-call op.  The R4..R10
	// pool is callee-saved so a retained value technically survives a call, but
	// resetting there is the conservative, uniform choice the other backends
	// make; a later pass could retain across calls for extra reuse.
	if branchEmitted || common.EmitsReturningBl(ins.Op) {
		m.ResetRegs()
	}
}
