package "pkg/binate/native/arm32"

import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// regPool hands out the callee-saved scratch set R4..R10 (indices 0..6) then
// R12/IP (index 7).  The pool must avoid R0..R3 (args/returns), R11 (frame
// pointer), and SP/LR/PC.
func TestRegPoolSlots() testing.TestResult {
	if regPool(0) != arm32.R4  { return fail("regPool(0) != R4") }
	if regPool(6) != arm32.R10 { return fail("regPool(6) != R10") }
	if regPool(7) != arm32.R12 { return fail("regPool(7) != R12 (IP)") }
	return ""
}

// The scratch pool must never hand out an arg register, the frame pointer, or
// a special register — those would corrupt call args / the frame / control.
func TestRegPoolAvoidsReserved() testing.TestResult {
	for i := 0; i < 8; i++ {
		var r int = regPool(i)
		if r >= arm32.R0 && r <= arm32.R3 {
			return fail("regPool handed out an arg register (R0..R3)")
		}
		if r == arm32.FP { return fail("regPool handed out the frame pointer (R11)") }
		if r == arm32.SP || r == arm32.LR || r == arm32.PC {
			return fail("regPool handed out SP/LR/PC")
		}
	}
	return ""
}

// Each pool slot is distinct — an accidental duplicate would alias two live
// values into one register.
func TestRegPoolDistinct() testing.TestResult {
	for i := 0; i < 8; i++ {
		for j := i + 1; j < 8; j++ {
			if regPool(i) == regPool(j) {
				return fail("regPool slots collide")
			}
		}
	}
	return ""
}
