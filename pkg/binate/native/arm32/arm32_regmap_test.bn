package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/native/common"
import "pkg/builtins/testing"

// regPool hands out exactly the callee-saved scratch set R4..R10 (indices
// 0..6).  R12/IP is deliberately EXCLUDED — it is the dedicated frame-offset /
// div-quotient / aggregate-overflow scratch, so having it in the value pool
// would let a helper silently clobber a live value under register pressure.
// The pool must avoid R0..R3 (args/returns), R11 (frame pointer), R12 (IP
// scratch), and SP/LR/PC.
func TestRegPoolSlots() testing.TestResult {
	if regPool(0) != arm32.R4 { return fail("regPool(0) != R4") }
	if regPool(6) != arm32.R10 { return fail("regPool(6) != R10 (last pool slot)") }
	return ""
}

// The scratch pool must never hand out an arg register, the frame pointer, the
// dedicated IP scratch, or a special register — those would corrupt call args /
// the frame / the IP-materialized offsets / control.
func TestRegPoolAvoidsReserved() testing.TestResult {
	for i := 0; i < 7; i++ {
		var r int = regPool(i)
		if r >= arm32.R0 && r <= arm32.R3 {
			return fail("regPool handed out an arg register (R0..R3)")
		}
		if r == arm32.FP { return fail("regPool handed out the frame pointer (R11)") }
		if r == arm32.IP { return fail("regPool handed out the dedicated IP scratch (R12)") }
		if r == arm32.SP || r == arm32.LR || r == arm32.PC {
			return fail("regPool handed out SP/LR/PC")
		}
	}
	return ""
}

// Each pool slot is distinct — an accidental duplicate would alias two live
// values into one register.
func TestRegPoolDistinct() testing.TestResult {
	for i := 0; i < 7; i++ {
		for j := i + 1; j < 7; j++ {
			if regPool(i) == regPool(j) {
				return fail("regPool slots collide")
			}
		}
	}
	return ""
}

// getOperand on a value a fold flagged fails loud: it returns -1 and sets an
// assembler error naming the value, encoding nothing, rather than reloading the
// never-written spill slot.  Checked for a FoldedImm constant and a fused field
// GEP, each of which also has a register recorded (AssignReg), so without the
// fold check getOperand would return that register.  An unflagged value still
// resolves (control).
func TestGetOperandFoldedAwayFailsLoud() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AssignReg(10, arm32.R5)
	rm.AssignReg(11, arm32.R6)
	var fi @[]bool = make_slice(bool, 13)
	fi[11] = true
	rm.FoldedImm = fi
	if getOperand(a, rm, 10) != arm32.R5 { return fail("an unflagged value must resolve") }
	if a.HasError { return fail("an unflagged value must not SetError") }
	if getOperand(a, rm, 11) != -1 { return fail("a FoldedImm value must return -1") }
	if !a.HasError { return fail("a FoldedImm operand read must SetError") }
	if !arm32HasSubstr(a.ErrorMsg, "operand v11 is folded away") {
		return fail("the folded-away error must name the value (v11)")
	}
	if bytesWritten(a) != 0 { return fail("a folded-away operand read must encode nothing") }

	var b @asm.Assembler = mkAsm()
	var gm @common.RegMap = common.NewRegMap(common.AAPCS32())
	gm.AssignReg(12, arm32.R7)
	var fg @[]bool = make_slice(bool, 13)
	fg[12] = true
	gm.FusableFieldGep = fg
	if getOperand(b, gm, 12) != -1 { return fail("a fused field GEP must return -1") }
	if !b.HasError { return fail("a fused field GEP operand read must SetError") }
	return ""
}

// evictMkAsm returns a fresh 32-bit assembler on a text section.
func evictMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	return a
}

// storeDirtyOnEvict stores a dirty value live at the emit point before its
// register is reused, and drops one that is dead there unstored (nothing reads
// its slot again).  Either way the value ends clean.
func TestStoreDirtyOnEvictLiveVsDead() testing.TestResult {
	var live @[]bool = make_slice(bool, 4)
	live[3] = true
	var a @asm.Assembler = evictMkAsm()
	var m @common.RegMap = common.NewRegMap(common.AAPCS32())
	m.CurAsm = a
	m.CurLive = live
	m.SpillIDs = common.AppendInt(common.AppendInt(m.SpillIDs, 3), 2)
	m.SpillOffsets = common.AppendInt(common.AppendInt(m.SpillOffsets, 16), 24)
	m.AssignReg(2, arm32.R4)
	m.MarkDirty(2)
	storeDirtyOnEvict(m, arm32.R4)
	if a.Sections[0].Len != 0 { return "a dead dirty value must not be stored on eviction" }
	if m.IsDirty(2) { return "a dropped dead value must end clean" }
	m.EvictReg(arm32.R4)
	m.AssignReg(3, arm32.R4)
	m.MarkDirty(3)
	storeDirtyOnEvict(m, arm32.R4)
	if a.Sections[0].Len == 0 { return "a live dirty value must be stored on eviction" }
	if m.IsDirty(3) { return "a stored value must end clean" }
	return ""
}
