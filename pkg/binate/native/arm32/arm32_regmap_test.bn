package "pkg/binate/native/arm32"

import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// regPool hands out exactly the callee-saved scratch set R4..R10 (indices
// 0..6).  R12/IP is deliberately EXCLUDED — it is the dedicated frame-offset /
// div-quotient / aggregate-overflow scratch, so having it in the value pool
// would let a helper silently clobber a live value under register pressure.
// The pool must avoid R0..R3 (args/returns), R11 (frame pointer), R12 (IP
// scratch), and SP/LR/PC.
func TestRegPoolSlots() testing.TestResult {
	if regPool(0) != arm32.R4  { return fail("regPool(0) != R4") }
	if regPool(6) != arm32.R10 { return fail("regPool(6) != R10 (last pool slot)") }
	return ""
}

// The scratch pool must never hand out an arg register, the frame pointer, the
// dedicated IP scratch, or a special register — those would corrupt call args /
// the frame / the IP-materialized offsets / control.
func TestRegPoolAvoidsReserved() testing.TestResult {
	for i := 0; i < 7; i++ {
		var r int = regPool(i)
		if r >= arm32.R0 && r <= arm32.R3 {
			return fail("regPool handed out an arg register (R0..R3)")
		}
		if r == arm32.FP { return fail("regPool handed out the frame pointer (R11)") }
		if r == arm32.IP { return fail("regPool handed out the dedicated IP scratch (R12)") }
		if r == arm32.SP || r == arm32.LR || r == arm32.PC {
			return fail("regPool handed out SP/LR/PC")
		}
	}
	return ""
}

// Each pool slot is distinct — an accidental duplicate would alias two live
// values into one register.
func TestRegPoolDistinct() testing.TestResult {
	for i := 0; i < 7; i++ {
		for j := i + 1; j < 7; j++ {
			if regPool(i) == regPool(j) {
				return fail("regPool slots collide")
			}
		}
	}
	return ""
}
