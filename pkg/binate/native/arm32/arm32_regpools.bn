package "pkg/binate/native/arm32"

import "pkg/binate/asm/arm32"
import "pkg/binate/iropcode"

// arm32FpAllocatablePool returns the callee-saved VFP registers the FP
// linear-scan pass homes float values in: D8..D15 (= S16..S31), the AAPCS-VFP
// callee-saved bank.  All floats (f32 and f64) home in whole D-registers; an f32
// uses the low S-view of its D-home (lowSingleOf), so the allocator only ever
// hands out D-numbers and there is no S/D aliasing to model.
//
// Callee-saved D8..D15 are the ONLY FP homes: D0..D7 are the arg/return CPRC
// bank (and the inline compute scratch D0/D1/S4/S5), and D16..D31 do not exist on
// VFPv3-D16 parts (non-portable) — so the FP caller-saved pool is empty and the
// prologue/epilogue save exactly the used D8..D15.  Hard-float only; soft-float
// passes an empty descriptor and homes nothing.
func arm32FpAllocatablePool() @[]int {
	var p @[]int = make_slice(int, 8)
	for i := 0; i < 8; i++ {
		p[i] = arm32.D8 + i
	}
	return p
}

// arm32TieOps returns the opcodes whose GP lowering reads every operand before it
// writes the result, so the allocator may give the result the register of an
// operand that dies there (RegClassDesc.TieOps): OP_COPY, and integer
// ADD/SUB/AND/OR/XOR/SHL/SHR, whose register and immediate-fold forms are each
// a single three-address instruction (plus an in-place narrow of rd).  Int64
// ops never tie: an int64 is a register pair, not allocatable on this target.
// The FP pass gets no tie opcodes.
func arm32TieOps() @[]int {
	var ops @[]int = make_slice(int, 8)
	ops[0] = iropcode.OP_COPY
	ops[1] = iropcode.OP_ADD
	ops[2] = iropcode.OP_SUB
	ops[3] = iropcode.OP_AND
	ops[4] = iropcode.OP_OR
	ops[5] = iropcode.OP_XOR
	ops[6] = iropcode.OP_SHL
	ops[7] = iropcode.OP_SHR
	return ops
}
