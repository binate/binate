package "pkg/binate/native/arm32"

import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// arm32FpAllocatablePool returns the callee-saved VFP registers the FP
// linear-scan pass homes float values in: D8..D15 (= S16..S31), the AAPCS-VFP
// callee-saved bank.  All floats (f32 and f64) home in whole D-registers; an f32
// uses the low S-view of its D-home (lowSingleOf), so the allocator only ever
// hands out D-numbers and there is no S/D aliasing to model.
//
// Callee-saved D8..D15 are the ONLY FP homes: D0..D7 are the arg/return CPRC
// bank (and the inline compute scratch D0/D1/S4/S5), and D16..D31 do not exist on
// VFPv3-D16 parts (non-portable) — so the FP caller-saved pool is empty and the
// prologue/epilogue save exactly the used D8..D15.  Hard-float only; soft-float
// passes an empty descriptor and homes nothing.
func arm32FpAllocatablePool() @[]int {
	var p @[]int = make_slice(int, 8)
	for i := 0; i < 8; i++ {
		p[i] = arm32.D8 + i
	}
	return p
}

// unhomeF32Values un-homes every float32-typed value the FP pass placed in a
// D-register, so only float64 values keep FP homes.  f32 homing (via the low
// S-view of a D-register) needs its single-word producer sites — const / load /
// extract / bit_cast / phi / param / return — made FP-home-aware; until then a
// homed f32 would have its D-home written as a GP register.  The f64 path
// (load64/store64 register pairs) is fully home-aware, so f64 values stay homed.
func unhomeF32Values(rm @common.RegMap, f @ir.Func) {
	for pi := 0; pi < len(f.Params); pi++ {
		if common.FloatScalarIsI32(f.Params[pi].Typ) {
			rm.UnhomeID(f.Params[pi].ID)
		}
	}
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			if common.FloatScalarIsI32(b.Instrs[ii].Typ) {
				rm.UnhomeID(b.Instrs[ii].ID)
			}
		}
	}
}
