package "pkg/binate/native/arm32"

import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// arm32FpAllocatablePool is the callee-saved VFP home pool the hard-float FP
// linear-scan pass draws from: exactly D8..D15 (the AAPCS-VFP callee-saved bank),
// in ascending order.
func TestArm32FpAllocatablePool() testing.TestResult {
	var p @[]int = arm32FpAllocatablePool()
	if len(p) != 8 {
		return fail("FP allocatable pool must hold 8 registers (D8..D15)")
	}
	for i := 0; i < 8; i++ {
		if p[i] != arm32.D8 + i {
			return fail("FP allocatable pool must be D8..D15 in ascending order")
		}
	}
	return ""
}

// unhomeF32Values enforces the f64-only-homes policy: it drops the FP home of
// every float32 value the FP pass placed in a D-register (their single-word
// producer sites are not yet FP-home-aware) while leaving float64 homes intact
// (the f64 register-pair path is fully home-aware).
func TestUnhomeF32Values() testing.TestResult {
	// Two params: id 0 float32 (must be un-homed), id 1 float64 (must stay homed).
	var params @[]@ir.Param = make_slice(@ir.Param, 2)
	params[0] = make(ir.Param)
	params[0].ID = 0
	params[0].Typ = types.TypFloat32()
	params[1] = make(ir.Param)
	params[1].ID = 1
	params[1].Typ = types.TypFloat64()
	var f @ir.Func = ir.NewFunc("", "t", params, make_slice(@types.Type, 0))

	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// Home both values in D-registers (as the FP pass would).
	rm.HomeIDs = common.AppendInt(rm.HomeIDs, 0)
	rm.HomeRegs = common.AppendInt(rm.HomeRegs, arm32.D8)
	rm.HomeIDs = common.AppendInt(rm.HomeIDs, 1)
	rm.HomeRegs = common.AppendInt(rm.HomeRegs, arm32.D9)

	unhomeF32Values(rm, f)

	if rm.LookupHome(0) >= 0 {
		return fail("a float32 value must be un-homed by unhomeF32Values")
	}
	if rm.LookupHome(1) != arm32.D9 {
		return fail("a float64 value must keep its FP home")
	}
	return ""
}
