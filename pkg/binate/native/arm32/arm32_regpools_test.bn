package "pkg/binate/native/arm32"

import "pkg/binate/asm/arm32"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// arm32FpAllocatablePool is the callee-saved VFP home pool the hard-float FP
// linear-scan pass draws from: exactly D8..D15 (the AAPCS-VFP callee-saved bank),
// in ascending order.
func TestArm32FpAllocatablePool() testing.TestResult {
	var p @[]int = arm32FpAllocatablePool()
	if len(p) != 8 {
		return fail("FP allocatable pool must hold 8 registers (D8..D15)")
	}
	for i := 0; i < 8; i++ {
		if p[i] != arm32.D8 + i {
			return fail("FP allocatable pool must be D8..D15 in ascending order")
		}
	}
	return ""
}

// The tie opcodes are exactly the audited ones: OP_COPY and integer
// ADD/SUB/AND/OR/XOR/SHL/SHR.  MUL, DIV and REM stay out.
func TestTieOps() testing.TestResult {
	var ops @[]int = arm32TieOps()
	if len(ops) != 8 { return "the tie opcodes should be COPY and seven integer ops" }
	var want @[]int = make_slice(int, 8)
	want[0] = iropcode.OP_COPY
	want[1] = iropcode.OP_ADD
	want[2] = iropcode.OP_SUB
	want[3] = iropcode.OP_AND
	want[4] = iropcode.OP_OR
	want[5] = iropcode.OP_XOR
	want[6] = iropcode.OP_SHL
	want[7] = iropcode.OP_SHR
	for i := 0; i < 8; i++ {
		if ops[i] != want[i] { return "unexpected tie opcode" }
		if ops[i] == iropcode.OP_MUL || ops[i] == iropcode.OP_DIV || ops[i] == iropcode.OP_REM {
			return "MUL/DIV/REM must not tie"
		}
	}
	return ""
}
