package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Stores into memory another party owns — a func-value shim's retbuf, a caller's tuple
// slot — write exactly the stored aggregate's bytes: the dispatch seam lets the callee
// write only the result's natural size, and the bytes after it are the caller's.  These
// pin the partial last word (emitStoreRegBytesArm32) at each place an aggregate held in
// a register is stored: a multi-value tuple's aggregate field, and the pack shim's
// small aggregate result.  setArm32Target lives in arm32_funcvalue_test.bn.

// tailMatchesArm32 reports whether the last want.Len bytes of g's text equal want's.
func tailMatchesArm32(g @asm.Assembler, want @asm.Assembler) bool {
	var gl int = g.Sections[0].Len
	var wl int = want.Sections[0].Len
	if gl < wl {
		return false
	}
	var gd @[]uint8 = g.Sections[0].Data
	var wd @[]uint8 = want.Sections[0].Data
	for i := 0; i < wl; i++ {
		if gd[gl - wl + i] != wd[i] {
			return false
		}
	}
	return true
}

// containsSeqArm32 reports whether want's text bytes occur, word-aligned, in g's text.
func containsSeqArm32(g @asm.Assembler, want @asm.Assembler) bool {
	var gl int = g.Sections[0].Len
	var wl int = want.Sections[0].Len
	var gd @[]uint8 = g.Sections[0].Data
	var wd @[]uint8 = want.Sections[0].Data
	for st := 0; st + wl <= gl; st = st + 4 {
		if bytesMatchAt(gd, st, wd, wl) {
			return true
		}
	}
	return false
}

// bytesMatchAt reports whether the n bytes of hay at off equal the first n of needle.
func bytesMatchAt(hay *[]uint8, off int, needle *[]uint8, n int) bool {
	for i := 0; i < n; i++ {
		if hay[off + i] != needle[i] {
			return false
		}
	}
	return true
}

// exact3StoreR0 is the exact store of a 3-byte result from R0 through the retbuf in R4.
func exact3StoreR0() @asm.Assembler {
	var want @asm.Assembler = newTextAsmArm32()
	arm32.Strh(want, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R4, 0))
	arm32.Mov(want, arm32.COND_AL, false, arm32.R0, arm32.RegShift(arm32.R0, arm32.LSR, 16))
	arm32.Strb(want, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R4, 2))
	return want
}

// newTextAsmArm32 is a fresh 4-byte-word assembler positioned in a text section.
func newTextAsmArm32() @asm.Assembler {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	return a
}

// int8x3Struct is a 3-byte, 1-aligned struct.
func int8x3Struct() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt8()
	}
	fields[0].Name = "a"
	fields[1].Name = "b"
	fields[2].Name = "c"
	return types.MakeStructType("B3", fields)
}

// One, two and four bytes are one sized store; three bytes are a halfword, then a byte
// from the register shifted right 16.
func TestStoreRegBytesArm32() testing.TestResult {
	setArm32Target()
	for sz := 1; sz <= 4; sz++ {
		var g @asm.Assembler = newTextAsmArm32()
		emitStoreRegBytesArm32(g, arm32.R2, arm32.R4, 4, sz, arm32.IP)
		var want @asm.Assembler = newTextAsmArm32()
		if sz == 1 {
			arm32.Strb(want, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.R4, 4))
		} else if sz == 2 {
			arm32.Strh(want, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.R4, 4))
		} else if sz == 3 {
			arm32.Strh(want, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.R4, 4))
			arm32.Mov(want, arm32.COND_AL, false, arm32.R2, arm32.RegShift(arm32.R2, arm32.LSR, 16))
			arm32.Strb(want, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.R4, 6))
		} else {
			arm32.Str(want, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.R4, 4))
		}
		if g.Sections[0].Len != want.Sections[0].Len || !tailMatchesArm32(g, want) {
			return "emitStoreRegBytesArm32 stores the wrong instructions for the byte count"
		}
	}
	return ""
}

// (int8, [3]int8, [3]int8) is a 7-byte, 1-aligned tuple returned in r0..r2; its last
// field sits word-aligned at offset 4, so a whole-word store of r2 would write byte 7,
// past the tuple.  The store is a halfword and a byte instead.
func TestStoreTupleWordAlignedPartialFieldArm32() testing.TestResult {
	setArm32Target()
	var fieldTypes @[]@types.Type = make_slice(@types.Type, 3)
	fieldTypes[0] = types.TypInt8()
	fieldTypes[1] = types.MakeArrayType(types.TypInt8(), 3)
	fieldTypes[2] = types.MakeArrayType(types.TypInt8(), 3)
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = fieldTypes[i]
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	if tuple.Size() != 7 || tuple.Offset(2) != 4 {
		return "test setup: expected a 7-byte tuple with its last field at offset 4"
	}
	var g @asm.Assembler = newTextAsmArm32()
	storeMultiReturnTupleFieldsArm32(g, tuple, arm32.R4, 0, 4, 4, arm32.IP)
	var want @asm.Assembler = newTextAsmArm32()
	arm32.Strh(want, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.R4, 4))
	arm32.Mov(want, arm32.COND_AL, false, arm32.R2, arm32.RegShift(arm32.R2, arm32.LSR, 16))
	arm32.Strb(want, arm32.COND_AL, arm32.R2, arm32.MemImm(arm32.R4, 6))
	if g.HasError || !tailMatchesArm32(g, want) {
		return "the word-aligned 3-byte last field must be stored as STRH + STRB, not a word"
	}
	return ""
}

// A func value returning a 3-byte struct takes the pack shim (returned by value in R0),
// which must store exactly three bytes through the retbuf: push; mov r4, r0; bl; strh
// r0, [r4]; mov r0, r0 lsr #16; strb r0, [r4, #2]; pop — 7 instructions.
func TestPackShimStoresExactResultBytesArm32() testing.TestResult {
	setArm32Target()
	var g @asm.Assembler = newTextAsmArm32()
	var noParams @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = int8x3Struct()
	emitFuncValueShimBody(g, callconv.AAPCS32(), "bn_F1_4_main1_4_main",
			types.MakeFuncValueType(noParams, results))
	if g.HasError || g.Sections[0].Len != 28 {
		return "a no-arg pack shim for a 3-byte result should be 7 instructions (28 bytes)"
	}
	var want @asm.Assembler = newTextAsmArm32()
	arm32.Strh(want, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R4, 0))
	arm32.Mov(want, arm32.COND_AL, false, arm32.R0, arm32.RegShift(arm32.R0, arm32.LSR, 16))
	arm32.Strb(want, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R4, 2))
	arm32.Pop(want, arm32.COND_AL, packShimPopMask())
	if !tailMatchesArm32(g, want) {
		return "the pack shim must store the 3-byte result as STRH + STRB through the retbuf"
	}
	return ""
}

// The closure pack shim stores a 3-byte result the same exact way.
func TestClosurePackShimStoresExactResultBytesArm32() testing.TestResult {
	setArm32Target()
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = int8x3Struct()
	var noParams @[]@types.Param
	var g @asm.Assembler = newTextAsmArm32()
	var fv @types.Type = closureFvType(noParams, results)
	emitClosureShimArm32(g, callconv.AAPCS32(), "bn_ul", fv, mkIntCaptureClosure(1, intParams(0)))
	if g.HasError || !containsSeqArm32(g, exact3StoreR0()) {
		return "the closure pack shim must store the 3-byte result as STRH + STRB through the retbuf"
	}
	return ""
}

// Five int arguments overflow the four argument registers, so the pack shim takes the
// framed stack-spill form — which stores a 3-byte result the same exact way.
func TestSpillPackShimStoresExactResultBytesArm32() testing.TestResult {
	setArm32Target()
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = int8x3Struct()
	var g @asm.Assembler = newTextAsmArm32()
	emitFuncValueShimBody(g, callconv.AAPCS32(), "bn_F1_4_main1_4_main",
			types.MakeFuncValueType(intParams(5), results))
	if g.HasError || !containsSeqArm32(g, exact3StoreR0()) {
		return "the spill pack shim must store the 3-byte result as STRH + STRB through the retbuf"
	}
	return ""
}
