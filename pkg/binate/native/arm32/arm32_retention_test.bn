package "pkg/binate/native/arm32"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for arm32RetentionSafe (arm32_retention.bn): a 32-bit integer op
// carries the retained value cache; float / int64 ops (which lower via AEABI
// libcalls that reset the cache) and non-listed ops do not.

func retInstr(op int, t @types.Type) @ir.Instr {
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = op
	ins.Typ = t
	return ins
}

// A 32-bit integer arithmetic/compare op is retention-safe.
func TestArm32RetentionSafeIntOp() testing.TestResult {
	if !arm32RetentionSafe(retInstr(iropcode.OP_ADD, types.TypInt())) {
		return "a 32-bit int OP_ADD must be retention-safe"
	}
	if !arm32RetentionSafe(retInstr(iropcode.OP_LT, types.TypBool())) {
		return "a 32-bit int compare must be retention-safe"
	}
	return ""
}

// A float op lowers via an AEABI soft-float libcall that resets the cache — not
// retention-safe (excluded by instrIsFloat before the op-code list).
func TestArm32RetentionSafeFloatExcluded() testing.TestResult {
	if arm32RetentionSafe(retInstr(iropcode.OP_ADD, types.TypFloat64())) {
		return "a float OP_ADD must NOT be retention-safe (soft-float libcall resets)"
	}
	return ""
}

// A 64-bit op is a register-pair libcall sequence on ILP32 — not retention-safe.
func TestArm32RetentionSafeInt64Excluded() testing.TestResult {
	if arm32RetentionSafe(retInstr(iropcode.OP_ADD, types.TypInt64())) {
		return "an int64 OP_ADD must NOT be retention-safe (int64 pair libcall)"
	}
	return ""
}

// An op outside the safe list (a call) barriers the cache — not retention-safe.
func TestArm32RetentionSafeCallExcluded() testing.TestResult {
	if arm32RetentionSafe(retInstr(iropcode.OP_CALL, types.TypInt())) {
		return "OP_CALL must NOT be retention-safe"
	}
	return ""
}
