package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// emitReturn lowers OP_RETURN on ARM32 (walking-skeleton subset).  A void
// return (no args — the trivial program's every function) just tears down the
// frame.  A single integer/pointer scalar returns in R0.  Aggregate returns,
// multi-return tuples, and float scalars are P3+ territory: rather than falling
// through to the epilogue with garbage in R0, each fails LOUDLY via
// a.SetError.  Mirrors aarch64_return.bn's shape at the reduced op set.
func emitReturn(a @asm.Assembler, pkgName *[]readonly char,
	rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) == 0 {
		// Void return: just tear down the frame.
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	if len(ins.Args) != 1 {
		// Multi-value tuple return (needs the return-marshaling / sret machinery
		// P3 adds).  Falling through would return garbage R0, so fail LOUDLY.
		a.SetError("native arm32: multi-value return not implemented (P3)")
		return
	}
	if common.IsAggregateTyp(ins.Args[0].Typ) {
		a.SetError("native arm32: aggregate return not implemented (P3)")
		return
	}
	if common.IsFloatScalarTyp(ins.Args[0].Typ) {
		a.SetError("native arm32: float return not implemented (P3)")
		return
	}
	// Single scalar / pointer return: AAPCS32 returns it in R0.
	var src int = emitValOperand(a, pkgName, rm, ins.Args[0])
	if src >= 0 && src != arm32.R0 {
		arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Reg(src))
	}
	emitEpilogueAndRet(a, rm.FrameSize())
}
