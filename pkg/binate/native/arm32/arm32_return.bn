package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// emitReturn lowers OP_RETURN on ARM32.  Sret-returning functions come FIRST:
// when PlanFrame set SretSlotOff >= 0, the callee received a hidden buffer
// pointer in R0 (stashed at SP+SretSlotOff by emitFunc) and must write the
// result through it, then return the pointer in R0 per AAPCS32.  A single
// aggregate return uses emitSretReturn; a BIG multi-return tuple (gpWords > 4)
// that also set SretSlotOff uses emitMultiReturnSret (per-field write-through at
// the tuple's FieldOffsets).  For non-sret returns: a void return tears down the
// frame; an IN-REGISTER multi-return (gpWords <= 4) packs its fields field-per-
// register into r0..r3 (emitMultiReturnPack); a single integer/pointer scalar
// returns in R0; a 64-bit-pair scalar returns in r0:r1; a float scalar
// (soft-float) fails LOUDLY; and a SMALL aggregate (SizeOf <= InternalSretBytes =
// 4 — e.g. a 4-byte struct) is returned BY VALUE in R0 via a one-word pack load
// (the AAPCS32 in-register return, the analogue of x64's emitAggregateReturnPack).
// Mirrors aarch64_return.bn's shape (WordBytes = 4, NumGpRetRegs = 4, no FP file).
func emitReturn(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	// Sret-returning function: the callee writes the result through the hidden
	// R0 buffer (stashed by emitFunc at SretSlotOff), then returns the buffer
	// pointer in R0.  A single-aggregate return writes contiguously; a big
	// multi-return tuple (which also sets SretSlotOff) writes each field at its
	// tuple FieldOffset.
	if rm.SretSlotOff >= 0 {
		if len(ins.Args) == 1 && common.IsAggregateTyp(ins.Args[0].Typ) {
			emitSretReturn(a, rm, ins)
			emitEpilogueAndRet(a, rm.FrameSize())
			return
		}
		if rm.MultiReturnType != nil && len(ins.Args) > 1 {
			emitMultiReturnSret(a, pkgName, rm, ins)
			emitEpilogueAndRet(a, rm.FrameSize())
			return
		}
		a.SetError("native arm32: sret return shape not implemented (P4)")
		return
	}
	if len(ins.Args) == 0 {
		// Void return: just tear down the frame.
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	if len(ins.Args) != 1 {
		// In-register multi-return tuple (gpWords <= 4, so it was NOT given an
		// sret slot above): pack each field field-per-register into r0..r3.
		emitMultiReturnPack(a, pkgName, rm, ins)
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	// Hard-float (AAPCS-VFP): a single float scalar return rides S0 (float32) / D0
	// (float64), not R0 / r0:r1 — VMOV its GP value word(s) into the FP return
	// register, PEELED off the GP paths BEFORE isPair64Typ (a float64 that stayed
	// there would move into r0:r1, which an AAPCS-VFP caller never reads).  Inert
	// unless types.Arm32HardFloat().
	if types.Arm32HardFloat() && common.IsFloatScalarTyp(ins.Args[0].Typ) {
		emitReturnScalarFloatHard(a, pkgName, rm, ins.Args[0])
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	// A 64-bit-pair scalar return (int64 / uint64 / float64) goes back in the
	// r0:r1 register pair; a float32 returns in R0 via the scalar path below.
	if isPair64Typ(ins.Args[0].Typ) {
		var lo int
		var hi int
		lo, hi = load64(a, rm, ins.Args[0])
		if lo >= 0 {
			if lo != arm32.R0 {
				arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Reg(lo))
			}
			if hi != arm32.R1 {
				arm32.Mov(a, arm32.COND_AL, false, arm32.R1, arm32.Reg(hi))
			}
		}
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	// A 0-byte single aggregate result (`struct{}` / `[0]T`) is void-like: it
	// carries no bytes, PlanFrame reserved no data region for it (dataSz > 0
	// gate), and the LLVM lowering returns nothing.  So emit no value load — just
	// tear the frame down.  Without this the IsAggregateTyp arm below would `Ldr
	// R0, [aggPtr]` from an unreserved region (junk in R0), and the scalar arm
	// would try to materialize a 0-byte struct value.
	if common.IsAggregateTyp(ins.Args[0].Typ) && !types.IsAggregateReturnTyp(ins.Args[0].Typ) {
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	// A SMALL single aggregate (SizeOf <= InternalSretBytes = 4 — a struct that
	// is NOT sret, so SretSlotOff stayed -1 above) is returned BY VALUE in R0
	// per AAPCS32.  It occupies a single word (ceil(SizeOf/4) == 1 for SizeOf
	// <= 4), so load it from its data region into R0.  Mirrors x64's
	// emitAggregateReturnPack (MOV RAX, [src]) with WordBytes = 4; the data
	// region is word-rounded, so a full-word load never reads out of bounds.
	// (A 0-byte aggregate was handled void-like just above, so IsAggregateTyp
	// here always has bytes to load.)
	if common.IsAggregateTyp(ins.Args[0].Typ) {
		var aggPtr int = getOperand(a, rm, ins.Args[0].ID)
		if aggPtr >= 0 {
			arm32.Ldr(a, arm32.COND_AL, arm32.R0, arm32.MemImm(aggPtr, 0))
		}
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	// Single scalar / pointer return: AAPCS32 returns it in R0.
	var src int = emitValOperand(a, pkgName, rm, ins.Args[0])
	if src >= 0 && src != arm32.R0 {
		arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Reg(src))
	}
	emitEpilogueAndRet(a, rm.FrameSize())
}

// emitSretReturn copies a single-aggregate result into the caller's sret buffer
// and reloads R0 with the buffer pointer per AAPCS32.  The buffer pointer was
// stashed at SP+SretSlotOff by emitFunc; load it into a scratch, then memcpy the
// argument's data region into it in 4-byte words (the WordBytes analogue of
// x64's 8-byte-MOV loop).  R0 is reloaded LAST — after the copy — so the memcpy
// scratches (R4.., never R0) can't clobber the returned pointer.
func emitSretReturn(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	// Load the saved sret-buffer pointer into a scratch reg (R4..).
	var dstPtr int = scratchReg(rm)
	emitFrameLoad(a, dstPtr, rm.SretSlotOff)
	// Source data pointer: an aggregate operand resolves to a pointer to its
	// bytes (getOperand → the alloc data region / spilled pointer).
	var srcPtr int = getOperand(a, rm, ins.Args[0].ID)
	if srcPtr >= 0 {
		var sz int = ins.Args[0].Typ.SizeOf()
		var tmp int = scratchReg(rm)
		// Byte-wise for a sub-word-aligned result (may be at a non-word-aligned
		// address → a word LDR/STR faults on strict-align MMU-less arm32); word-wise
		// otherwise.  IP materializes a > 4KB offset (dstPtr / srcPtr / tmp are pool
		// registers, never IP).
		emitAggMemcpyArm32(a, dstPtr, srcPtr, sz, aggNeedsBytewiseArm32(ins.Args[0].Typ), tmp, arm32.IP)
	}
	// AAPCS32 requires an sret-returning function to return the buffer pointer
	// in R0.  Reload it (the memcpy scratches never touched R0).
	emitFrameLoad(a, arm32.R0, rm.SretSlotOff)
}

// emitMultiReturnPack packs an IN-REGISTER multi-return tuple (gpWords <= 4)
// into r0..r3 field-per-register, per the AAPCS32 convention LLVM lowers a
// first-class-struct return by: each field's words fill consecutive GP return
// registers in field order (soft-float folds float fields into GP too — there is
// no FP file, so unlike aarch64's ngrn/nsrn split this uses a single retGp
// counter).  An aggregate field spreads its ArgWords words to argReg(retGp)++ (
// loaded from its data region at WordBytes*w); a ONE-WORD scalar / pointer /
// float32-bits field loads into argReg(retGp), retGp++.  The retGp < NumGpRetRegs
// (4) guard matches MultiReturnTupleNeedsSret's budget: an over-budget tuple was
// routed to sret (emitMultiReturnSret) instead, so the guard never drops a live
// field.  An int64 / uint64 / float64 field packs into a CONSECUTIVE register pair
// (argReg(retGp):argReg(retGp+1), retGp += 2 — no even-pair bump, matching the
// caller-collect's consecutive read; a soft-float float64 is the identical two-word
// pack as an int64, isPair64Typ).  Mirrors aarch64_return.bn's small-multi-return
// pack (WordBytes = 4).
func emitMultiReturnPack(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		ins @ir.Instr) {
	// Hard-float (AAPCS-VFP): a float tuple field packs into a VFP return register
	// (S/D via the CPRC back-fill = CallArgFpReg), NOT the GP return budget — route
	// a float-containing tuple to the FP-aware pack (it reuses the shared GP field
	// packer for the non-float fields).  A tuple with no float field is
	// byte-identical on the GP loop below.  Inert unless types.Arm32HardFloat().
	if types.Arm32HardFloat() && multiReturnHasFloatArg(ins) {
		emitMultiReturnPackHard(a, pkgName, rm, ins)
		return
	}
	var retGp int = 0
	for ai := 0; ai < len(ins.Args); ai++ {
		var adv int = packMultiReturnFieldGpArm32(a, pkgName, rm, ins.Args[ai], retGp)
		if adv < 0 { return }
		retGp = retGp + adv
		// Each field's scratch regs are dead once loaded into their return
		// register; reset so a long tuple doesn't saturate the R4..R10 pool.
		rm.ResetRegs()
	}
}

// packMultiReturnFieldGpArm32 packs one multi-return field that rides the GP
// return registers r0..r(NumGpRetRegs-1), starting at cursor retGp, and returns
// the number of GP return registers it consumed — or -1 if the field shape is
// unmodeled (a.SetError already emitted).  Shared by the soft-float pack loop
// above (which packs EVERY field here — a float64 via isPair64Typ, a float32 via
// the 1-word scalar tail) and the hard-float pack (emitMultiReturnPackHard, which
// peels every float field to an FP return register BEFORE calling this).  An
// aggregate field spreads its words to consecutive regs (a 0-byte aggregate
// consumes none — a junk word would shift every later field, desyncing the pack
// from the collect + LLVM shim); an int64 / uint64 field (isPair64Typ; a float64
// is peeled off in hard mode) packs a CONSECUTIVE pair via emitPackReturnPair64;
// a 1-word scalar moves into argReg(retGp).  Any OTHER multi-word scalar shape is
// unmodeled (none exists today) — fail LOUDLY rather than guess (native<->LLVM
// parity).
func packMultiReturnFieldGpArm32(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		arg @ir.Instr, retGp int) int {
	if common.IsAggregateTyp(arg.Typ) && arg.Typ.SizeOf() == 0 {
		return 0
	}
	if common.IsAggregateTyp(arg.Typ) {
		var ptr int = getOperand(a, rm, arg.ID)
		var used int = 0
		if ptr >= 0 {
			var w int = wordBytes()
			var nWords int = rm.CC.ArgWords(arg.Typ)
			for wi := 0; wi < nWords && retGp + used < rm.CC.NumGpRetRegs; wi++ {
				arm32.Ldr(a, arm32.COND_AL, argReg(retGp + used), arm32.MemImm(ptr, w * wi))
				used = used + 1
			}
		}
		return used
	}
	if isPair64Typ(arg.Typ) {
		if retGp + 1 < rm.CC.NumGpRetRegs {
			emitPackReturnPair64(a, rm, arg, retGp)
			return 2
		}
		return 0
	}
	if rm.CC.ArgWords(arg.Typ) != 1 {
		a.SetError(
				"native arm32: in-register multi-return with an unmodeled "
						"multi-word scalar field not implemented")
		return -1
	}
	var src int = emitValOperand(a, pkgName, rm, arg)
	if src >= 0 && retGp < rm.CC.NumGpRetRegs {
		if src != argReg(retGp) {
			arm32.Mov(a, arm32.COND_AL, false, argReg(retGp), arm32.Reg(src))
		}
		return 1
	}
	return 0
}

// emitMultiReturnSret writes a BIG multi-return tuple (gpWords > 4) through the
// hidden sret buffer pointer the caller stashed at SP+SretSlotOff (emitFunc saved
// the incoming R0 there), placing each field at its tuple FieldOffset, then
// reloads R0 = buffer pointer LAST (AAPCS32 returns the sret ptr in R0).  Within
// an aggregate field the words stride by WordBytes = 4; a scalar field uses a
// sized store so a sub-word field (uint16 / bool) doesn't clobber its neighbor.
// The buffer pointer is reloaded from the sret slot each iteration into a fresh
// scratch (the per-field ResetRegs would otherwise strand it), mirroring
// aarch64_return.bn's sret multi-return arm (WordBytes = 4).  An int64 / uint64 /
// float64 field writes its two words to [buffer + fldOff] / [+4] (a soft-float
// float64 is the identical two-word memory store as an int64, isPair64Typ).
func emitMultiReturnSret(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		ins @ir.Instr) {
	var w int = wordBytes()
	for ai := 0; ai < len(ins.Args); ai++ {
		var arg @ir.Instr = ins.Args[ai]
		if common.IsAggregateTyp(arg.Typ) && arg.Typ.SizeOf() == 0 {
			// A 0-byte aggregate field (`struct{}` / `[0]T`) has no bytes to write
			// through the sret buffer — LLVM's `store {...}` places nothing at its
			// offset.  Its FieldOffset coincides with the next field's start, so a
			// spurious word store here would corrupt that neighbor.  Skip it.
			continue
		}
		var dstPtr int = scratchReg(rm)
		emitFrameLoad(a, dstPtr, rm.SretSlotOff)
		var fldOff int = rm.MultiReturnType.FieldOffset(ai)
		if common.IsAggregateTyp(arg.Typ) {
			var ptr int = getOperand(a, rm, arg.ID)
			if ptr >= 0 {
				var tmp int = scratchReg(rm)
				// Materialize the field's destination address (dstPtr + fldOff) so the
				// copy addresses it from offset 0.  Byte-wise for a sub-word-aligned
				// field (its fldOff can be non-word-aligned -> a word STR faults on
				// strict-align MMU-less arm32); word-wise otherwise.  IP materializes a
				// > 4KB offset (ptr / dstPtr / dstFld / tmp are pool registers, never IP).
				var dstFld int = scratchReg(rm)
				emitConstInt32(a, dstFld, fldOff)
				arm32.Add(a, arm32.COND_AL, false, dstFld, dstPtr, arm32.Reg(dstFld))
				emitAggMemcpyArm32(a, dstFld, ptr, arg.Typ.SizeOf(), aggNeedsBytewiseArm32(arg.Typ), tmp,
						arm32.IP)
			}
		} else if isPair64Typ(arg.Typ) {
			// An int64 / uint64 / float64 field is written to the sret buffer as two words
			// at [dstPtr + fldOff] / [+4] — a pure memory layout at the tuple's 8-aligned
			// FieldOffset (no register-placement question here, unlike the in-register
			// pack).  load64 reloads the value's pair into pool scratches; both stores
			// route through the IP-materializing emitBaseStore for a large fldOff.  A
			// soft-float float64 field is the identical two-word memory store as an int64.
			var lo int
			var hi int
			lo, hi = load64(a, rm, arg)
			if lo >= 0 {
				emitBaseStore(a, lo, dstPtr, fldOff, arm32.IP)
				emitBaseStore(a, hi, dstPtr, fldOff + 4, arm32.IP)
			}
		} else {
			var src int = emitValOperand(a, pkgName, rm, arg)
			if src >= 0 {
				var sz int = arg.Typ.SizeOf()
				if sz <= 0 { sz = w }
				// fldOff can reach the tuple SizeOf; emitBaseScalarStore
				// materializes the field address in IP for a large offset.
				emitBaseScalarStore(a, src, dstPtr, fldOff, sz, arm32.IP)
			}
		}
		// Reload R0 = buffer pointer LAST (after every field is written), so the
		// per-field scratches (dstPtr, ptr/src, tmp — all R4..) never clobber it.
		rm.ResetRegs()
	}
	emitFrameLoad(a, arm32.R0, rm.SretSlotOff)
}
