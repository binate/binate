package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// emitReturn lowers OP_RETURN on ARM32.  A void return just tears down the
// frame.  A single integer/pointer scalar returns in R0.  A single SMALL
// aggregate (≤ NumGpRetRegs words — a raw slice is 2 words, a managed-slice is
// 4) is packed into R0..R(N-1).  Shapes still deferred fail LOUDLY: a
// multi-value tuple return, a BIG aggregate needing sret (the prologue doesn't
// yet stash the R0 sret pointer), a 64-bit-pair scalar, and a float scalar
// (soft-float).  Mirrors aarch64_return.bn's shape at the implemented op set.
func emitReturn(a @asm.Assembler, pkgName *[]readonly char,
	rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) == 0 {
		// Void return: just tear down the frame.
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	if len(ins.Args) != 1 {
		// Multi-value tuple return (needs the return-marshaling / sret
		// machinery).  Falling through would return garbage R0, so fail LOUDLY.
		a.SetError("native arm32: multi-value return not implemented (P3)")
		return
	}
	if common.IsAggregateTyp(ins.Args[0].Typ) {
		// AAPCS32 returns any aggregate larger than InternalSretBytes (4) via
		// sret, which on ILP32 is EVERY slice / struct return (a raw slice is 8
		// bytes, a managed-slice 16).  The sret path has an unresolved arg-
		// register-shift subtlety — the sret buffer pointer takes R0, so a
		// function's own params must shift to R1.. and the caller-side
		// arg dispatch must reserve R0 for the sret pointer — which
		// CallArgRegStart does NOT yet model for internal sret callees.
		// Emitting it now would silently miscompile a slice-returning function
		// that also takes args (the sret pointer clobbers arg 0), so fail
		// LOUDLY and defer the whole single-aggregate-sret path.  See
		// claude-todo.md (arm32 single-aggregate-sret arg shift).
		a.SetError("native arm32: aggregate return uses AAPCS32 sret with an "
			"unresolved arg-register-shift for the R0 buffer pointer "
			"(P3, deferred)")
		return
	}
	if common.IsFloatScalarTyp(ins.Args[0].Typ) {
		a.SetError("native arm32: float return not implemented (P5)")
		return
	}
	// A 64-bit scalar return goes back in the r0:r1 register pair.
	if isReg64Scalar(ins.Args[0].Typ) {
		var lo int
		var hi int
		lo, hi = load64(a, rm, ins.Args[0])
		if lo >= 0 {
			if lo != arm32.R0 {
				arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Reg(lo))
			}
			if hi != arm32.R1 {
				arm32.Mov(a, arm32.COND_AL, false, arm32.R1, arm32.Reg(hi))
			}
		}
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	// Single scalar / pointer return: AAPCS32 returns it in R0.
	var src int = emitValOperand(a, pkgName, rm, ins.Args[0])
	if src >= 0 && src != arm32.R0 {
		arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Reg(src))
	}
	emitEpilogueAndRet(a, rm.FrameSize())
}
