package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A void return (no args) emits just the epilogue: with a zero-size frame,
// a single `pop {r4-r12, pc}` (4 bytes).
func TestReturnVoidIsEpilogue() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var noArgs2 @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Args = noArgs2
	emitReturn(a, "main", rm, ins)
	if a.Sections[0].Len != 8 {
		return fail("void return should be the two-POP epilogue (8 bytes)")
	}
	if word32Ret(a, 0) != cast(uint32, 0xE8BD17F0) {
		return fail("void return epilogue must start with pop {r4-r10, r12}")
	}
	if word32Ret(a, 4) != cast(uint32, 0xE8BD8800) {
		return fail("void return epilogue must end with pop {fp, pc}")
	}
	return ""
}

func word32Ret(a @asm.Assembler, off int) uint32 {
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var d *[]uint8 = a.Sections[0].Data
	return cast(uint32, d[off]) | (cast(uint32, d[off + 1]) << 8) | (cast(uint32, d[off + 2]) << 16) |
			(cast(uint32, d[off + 3]) << 24)
}

// appendInstrPtr_arm32rettest grows a @[]@ir.Instr by one (no builtin append
// in the arm32 subset).
func appendInstrPtr_arm32rettest(s @[]@ir.Instr, v @ir.Instr) @[]@ir.Instr {
	var n @[]@ir.Instr = make_slice(@ir.Instr, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}

// countStrImm counts STR-immediate instructions (single-data-transfer class,
// bits[27:26] = 0b01, store L-bit[20] = 0) across the emitted text section.  A
// data-processing op (bits[27:26]=00), a block transfer / pop (0b10), and every
// LDR (L = 1) are excluded, so in an sret-return body this counts exactly the
// copy-stores.
func countStrImm(a @asm.Assembler) int {
	var n int = a.Sections[0].Len
	var c int = 0
	for off := 0; off + 4 <= n; off = off + 4 {
		var w uint32 = word32Ret(a, off)
		if ((w >> 26) & cast(uint32, 0x3)) == cast(uint32, 0x1) &&
				((w >> 20) & cast(uint32, 0x1)) == cast(uint32, 0x0) {
			c = c + 1
		}
	}
	return c
}

// isLdrImm reports whether the instruction at `off` is an LDR-immediate
// (single-data-transfer class bits[27:26] = 0b01, load L-bit[20] = 1).
func isLdrImm(a @asm.Assembler, off int) bool {
	var w uint32 = word32Ret(a, off)
	return ((w >> 26) & cast(uint32, 0x3)) == cast(uint32, 0x1) &&
			((w >> 20) & cast(uint32, 0x1)) == cast(uint32, 0x1)
}

// A BIG aggregate return (SizeOf > InternalSretBytes = 4) is sret: PlanFrame set
// SretSlotOff >= 0 and emitFunc stashed the R0 buffer pointer there.  emitReturn
// memcpys the result's data region into that buffer (a wordBytes-granular LDR/STR
// loop — SizeOf/wordBytes pairs) and reloads R0 with the buffer pointer, then
// emits the epilogue.  Pin the ILP32 target so wordBytes = 4 (SizeOf = 32 → 8
// copy words), then assert (a) exactly 8 STR copy-stores, (b) the R0 reload right
// before the epilogue (dropping it — a real AAPCS32 ABI break — must fail here),
// and (c) the trailing pop epilogue.
func TestReturnSretAggregateMemcpysAndRet() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SretSlotOff = 0 // simulate PlanFrame's sret-active state
	// The returned aggregate's data region (an 8-int = 32-byte array on ILP32).
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 7)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 8)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 32)
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 7
	arg.Typ = types.MakeArrayType(types.TypInt(), 8)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32rettest(args, arg)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Args = args
	emitReturn(a, "main", rm, ins)
	if a.HasError {
		return fail("an sret aggregate return must lower, not error")
	}
	var n int = a.Sections[0].Len
	// (a) exactly SizeOf/wordBytes copy-stores.
	var expectWords int = arg.Typ.SizeOf() / wordBytes()
	if countStrImm(a) != expectWords {
		return fail("sret return must emit SizeOf/wordBytes STR copy-stores")
	}
	// (b) R0 reload just before the two-POP epilogue (8 bytes): LDR R0, [SP,
	// #SretSlotOff].
	if !isLdrImm(a, n - 12) || rdAt(a, n - 12) != cast(uint32, arm32.R0) ||
			rnAt(a, n - 12) != cast(uint32, arm32.SP) {
		return fail("sret return must reload R0 with the buffer pointer "
				"before the epilogue")
	}
	// (c) Trailing word is the `pop {fp, pc}` that ends the epilogue.
	if word32Ret(a, n - 4) != cast(uint32, 0xE8BD8800) {
		return fail("sret aggregate return must end with pop {fp, pc}")
	}
	return ""
}

// A BIG multi-return tuple (gpWords > 4) is sret: PlanFrame set SretSlotOff >= 0,
// stashed rm.MultiReturnType, and emitFunc saved the R0 buffer pointer at
// SretSlotOff.  emitReturn writes each field through that buffer at its tuple
// FieldOffset, then reloads R0 = buffer pointer LAST.  Use {i32 x5} (5 GP words →
// sret): assert (a) exactly 5 STR field-stores, and (b) the R0 reload right
// before the epilogue.  Each field is a spilled scalar operand so emitValOperand
// LDRs it into a scratch before the STR through the buffer.
func TestReturnMultiReturnSretWritesFields() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SretSlotOff = 0 // sret active for the big multi-return
	var fields @[]@types.Field = make_slice(@types.Field, 5)
	var args @[]@ir.Instr
	for i := 0; i < 5; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt32()
		// Give each field-arg a spill slot so emitValOperand resolves it.
		rm.SpillIDs = common.AppendInt(rm.SpillIDs, 20 + i)
		rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 100 + 4 * i)
		var arg @ir.Instr = make(ir.Instr)
		arg.ID = 20 + i
		arg.Typ = types.TypInt32()
		args = appendInstrPtr_arm32rettest(args, arg)
	}
	rm.MultiReturnType = types.MakeStructType("", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Args = args
	emitReturn(a, "main", rm, ins)
	if a.HasError {
		return fail("a big multi-return sret must lower, not error")
	}
	// (a) exactly one STR field-store per field (5).
	if countStrImm(a) != 5 {
		return fail("big multi-return sret must emit one STR per field")
	}
	// (b) R0 reload just before the two-POP epilogue (8 bytes): LDR R0, [SP,
	// #SretSlotOff].
	var n int = a.Sections[0].Len
	if !isLdrImm(a, n - 12) || rdAt(a, n - 12) != cast(uint32, arm32.R0) ||
			rnAt(a, n - 12) != cast(uint32, arm32.SP) {
		return fail(
				"big multi-return sret must reload R0 with the buffer "
						"pointer before the epilogue")
	}
	return ""
}

// A float64 return goes back in the r0:r1 register pair exactly like an int64
// (soft-float: floats ride GP), NOT a fail-loud: load64 reloads the spilled pair
// and emitReturn MOVs lo -> r0 (@8) and hi -> r1 (@12).
func TestReturnFloat64InR0R1Pair() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 10)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 10
	arg.Typ = types.TypFloat64()
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32rettest(args, arg)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Args = args
	emitReturn(a, "main", rm, ins)
	if a.HasError {
		return fail("a float64 return must lower via the soft-float pair, not error")
	}
	if dpOpcodeAt(a, 8) != cast(uint32, 0xD) || rdAt(a, 8) != cast(uint32, arm32.R0) {
		return fail("float64 return lo word must be MOV'd into r0")
	}
	if dpOpcodeAt(a, 12) != cast(uint32, 0xD) || rdAt(a, 12) != cast(uint32, arm32.R1) {
		return fail("float64 return hi word must be MOV'd into r1")
	}
	return ""
}

// An int64 return goes back in the r0:r1 register pair: lo → r0, hi → r1.  The
// returned value is a spilled SSA operand, so load64 reloads it (LDR lo @0, LDR
// hi @4) into scratch regs (r4+), then emitReturn MOVs lo → r0 (@8) and hi → r1
// (@12) — both MOVs emit since a scratch never already equals r0/r1.  The
// epilogue follows.
func TestReturnInt64InR0R1Pair() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 10)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 10
	arg.Typ = types.TypInt64()
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32rettest(args, arg)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Args = args
	emitReturn(a, "main", rm, ins)
	if a.HasError {
		return fail("an int64 return must lower, not error")
	}
	// MOV r0, lo (@8) then MOV r1, hi (@12) — DP_MOV opcode 0xD.
	if dpOpcodeAt(a, 8) != cast(uint32, 0xD) || rdAt(a, 8) != cast(uint32, arm32.R0) {
		return fail("int64 return lo word must be MOV'd into r0")
	}
	if dpOpcodeAt(a, 12) != cast(uint32, 0xD) || rdAt(a, 12) != cast(uint32, arm32.R1) {
		return fail("int64 return hi word must be MOV'd into r1")
	}
	return ""
}

// mkScalarMultiReturn_arm32 builds an OP_RETURN of n scalar fields of type t,
// each backed by a spill slot so emitValOperand resolves it, and stashes the
// tuple type on rm.MultiReturnType (as PlanFrame would).  Returns the built
// instruction.
func mkScalarMultiReturn_arm32(rm @common.RegMap, n int, t @types.Type) @ir.Instr {
	var fields @[]@types.Field = make_slice(@types.Field, n)
	var args @[]@ir.Instr
	for i := 0; i < n; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = t
		rm.SpillIDs = common.AppendInt(rm.SpillIDs, 30 + i)
		rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 200 + 4 * i)
		var arg @ir.Instr = make(ir.Instr)
		arg.ID = 30 + i
		arg.Typ = t
		args = appendInstrPtr_arm32rettest(args, arg)
	}
	rm.MultiReturnType = types.MakeStructType("", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Args = args
	return ins
}

// movDestIsReg_arm32 reports whether the emitted text contains a DP_MOV (opcode
// 0xD) whose destination is register `reg` — i.e. a field packed into that
// return register.
func movDestIsReg_arm32(a @asm.Assembler, reg int) bool {
	var n int = a.Sections[0].Len
	for off := 0; off + 4 <= n; off = off + 4 {
		if dpOpcodeAt(a, off) == cast(uint32, 0xD) && rdAt(a, off) == cast(uint32, reg) {
			return true
		}
	}
	return false
}

// An IN-REGISTER multi-return (gpWords <= NumGpRetRegs = 4) packs each field
// field-per-register into r0..r3.  (int32, int32) is 2 GP words → r0, r1: each
// spilled field-arg is LDR'd into a scratch then MOV'd into its return register.
func TestReturnMultiReturnPacksTwoIntoR0R1() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = mkScalarMultiReturn_arm32(rm, 2, types.TypInt32())
	emitReturn(a, "main", rm, ins)
	if a.HasError {
		return fail("an in-register (int32,int32) multi-return must lower")
	}
	if !movDestIsReg_arm32(a, arm32.R0) || !movDestIsReg_arm32(a, arm32.R1) {
		return fail("(int32,int32) must pack fields into r0 and r1")
	}
	if movDestIsReg_arm32(a, arm32.R2) {
		return fail("(int32,int32) must not touch r2")
	}
	return ""
}

// (int32 x4) is 4 GP words — exactly the r0..r3 budget — so every field packs
// into a distinct return register with none dropped.
func TestReturnMultiReturnPacksFourIntoR0R3() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var ins @ir.Instr = mkScalarMultiReturn_arm32(rm, 4, types.TypInt32())
	emitReturn(a, "main", rm, ins)
	if a.HasError {
		return fail("an in-register (int32 x4) multi-return must lower")
	}
	if !movDestIsReg_arm32(a, arm32.R0) || !movDestIsReg_arm32(a, arm32.R1) ||
			!movDestIsReg_arm32(a, arm32.R2) || !movDestIsReg_arm32(a, arm32.R3) {
		return fail("(int32 x4) must pack fields into r0..r3")
	}
	return ""
}

// An int64 scalar field in an IN-REGISTER multi-return packs into a CONSECUTIVE
// register pair (no even-pair bump — the small-aggregate return coercion packs
// fields into r0..r3 in field order; C.3's even rule is argument-only).  For
// (int32, int64) — 3 GP words, in-register budget — the int32 goes to r0 and the
// int64 to the consecutive pair r1:r2 (loaded from its spill slot), NOT r2:r3.
func TestReturnMultiReturnInt64FieldPacksConsecutivePair() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt32()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt64()
	rm.MultiReturnType = types.MakeStructType("", fields)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 40)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 41)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	var a0 @ir.Instr = make(ir.Instr)
	a0.ID = 40
	a0.Typ = types.TypInt32()
	var a1 @ir.Instr = make(ir.Instr)
	a1.ID = 41
	a1.Typ = types.TypInt64()
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32rettest(args, a0)
	args = appendInstrPtr_arm32rettest(args, a1)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Args = args
	emitReturn(a, "main", rm, ins)
	if a.HasError {
		return fail("in-register multi-return with an int64 field must lower")
	}
	// The int64 field's two words load into the consecutive pair r1:r2.
	if !hasLdrIntoReg(a, arm32.R1) || !hasLdrIntoReg(a, arm32.R2) {
		return fail("(int32,int64) int64 field must load into consecutive r1:r2, not r2:r3")
	}
	return ""
}

// A float64 scalar field in an IN-REGISTER multi-return is a 2-word register pair on
// soft-float AAPCS32 (ArgWords(float64)=2) that packs into a CONSECUTIVE return-
// register pair exactly like an int64 (isPair64Typ) — the return coercion places
// fields into r0..r3 in field order with no even-register bump, so the float64's two
// words are stored bit-for-bit like an int64's.  (int32, float64) is 3 GP words
// (in-register budget), so it reaches the pack path: int32 in R0, the float64 pair in
// R1:R2 — lowered with no error.
func TestReturnMultiReturnFloat64FieldPacksPair() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt32()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypFloat64()
	rm.MultiReturnType = types.MakeStructType("", fields)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 40)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 41)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	var a0 @ir.Instr = make(ir.Instr)
	a0.ID = 40
	a0.Typ = types.TypInt32()
	var a1 @ir.Instr = make(ir.Instr)
	a1.ID = 41
	a1.Typ = types.TypFloat64()
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32rettest(args, a0)
	args = appendInstrPtr_arm32rettest(args, a1)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Args = args
	emitReturn(a, "main", rm, ins)
	if a.HasError {
		return fail("in-register multi-return with a float64 field must lower cleanly (P5.3)")
	}
	if bytesWritten(a) == 0 {
		return fail("float64-field multi-return must emit the pair pack")
	}
	return ""
}

// A SMALL aggregate return (SizeOf <= InternalSretBytes = 4) is NOT sret —
// AAPCS32 returns it BY VALUE in R0 — so PlanFrame leaves SretSlotOff = -1
// (NewRegMap's default) and emitReturn takes the pack path: it loads the single
// <=4-byte word from the aggregate's data region into R0, then emits the
// epilogue.  [4]uint8 is 4 bytes on any target (uint8 is a fixed 1-byte type),
// so this needs no target pin.  The arg is given an alloc region so getOperand
// resolves it to a region pointer for the pack load.
func TestReturnSmallAggregatePacksIntoR0() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 0)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 0
	arg.Typ = types.MakeArrayType(types.TypUint8(), 4)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32rettest(args, arg)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Args = args
	emitReturn(a, "main", rm, ins)
	if a.HasError {
		return fail("small (<=4-byte) aggregate return should pack into R0, not fail")
	}
	// The pack loads the <=4-byte value from its data region into R0 (an LDR-imm);
	// the epilogue's pop is a block transfer, not an LDR-imm, so this pins the
	// pack load specifically.
	var foundLdr bool = false
	var n int = a.Sections[0].Len
	for off := 0; off + 4 <= n; off = off + 4 {
		if isLdrImm(a, off) { foundLdr = true }
	}
	if !foundLdr {
		return fail("small aggregate return should LDR the value into R0")
	}
	return ""
}
