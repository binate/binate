package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A void return (no args) emits just the epilogue: with a zero-size frame,
// a single `pop {r4-r12, pc}` (4 bytes).
func TestReturnVoidIsEpilogue() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var noArgs2 @[]@ir.Instr
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Args = noArgs2
	emitReturn(a, "main", rm, ins)
	if a.Sections[0].Len != 4 {
		return fail("void return should be a single POP epilogue (4 bytes)")
	}
	if word32Ret(a, 0) != cast(uint32, 0xE8BD9FF0) {
		return fail("void return epilogue must be pop {r4-r12, pc}")
	}
	return ""
}

func word32Ret(a @asm.Assembler, off int) uint32 {
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var d *[]uint8 = a.Sections[0].Data
	return cast(uint32, d[off]) | (cast(uint32, d[off + 1]) << 8) |
		(cast(uint32, d[off + 2]) << 16) | (cast(uint32, d[off + 3]) << 24)
}

// appendInstrPtr_arm32rettest grows a @[]@ir.Instr by one (no builtin append
// in the arm32 subset).
func appendInstrPtr_arm32rettest(s @[]@ir.Instr, v @ir.Instr) @[]@ir.Instr {
	var n @[]@ir.Instr = make_slice(@ir.Instr, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}

// returnOfType builds an OP_RETURN whose single arg has the given type.
func returnOfType(t @types.Type) @ir.Instr {
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = -1
	arg.Typ = t
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32rettest(args, arg)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Args = args
	return ins
}

// countStrImm counts STR-immediate instructions (single-data-transfer class,
// bits[27:26] = 0b01, store L-bit[20] = 0) across the emitted text section.  A
// data-processing op (bits[27:26]=00), a block transfer / pop (0b10), and every
// LDR (L = 1) are excluded, so in an sret-return body this counts exactly the
// copy-stores.
func countStrImm(a @asm.Assembler) int {
	var n int = a.Sections[0].Len
	var c int = 0
	for off := 0; off + 4 <= n; off = off + 4 {
		var w uint32 = word32Ret(a, off)
		if ((w >> 26) & cast(uint32, 0x3)) == cast(uint32, 0x1) &&
				((w >> 20) & cast(uint32, 0x1)) == cast(uint32, 0x0) {
			c = c + 1
		}
	}
	return c
}

// isLdrImm reports whether the instruction at `off` is an LDR-immediate
// (single-data-transfer class bits[27:26] = 0b01, load L-bit[20] = 1).
func isLdrImm(a @asm.Assembler, off int) bool {
	var w uint32 = word32Ret(a, off)
	return ((w >> 26) & cast(uint32, 0x3)) == cast(uint32, 0x1) &&
		((w >> 20) & cast(uint32, 0x1)) == cast(uint32, 0x1)
}

// A BIG aggregate return (SizeOf > InternalSretBytes = 4) is sret: PlanFrame set
// SretSlotOff >= 0 and emitFunc stashed the R0 buffer pointer there.  emitReturn
// memcpys the result's data region into that buffer (a wordBytes-granular LDR/STR
// loop — SizeOf/wordBytes pairs) and reloads R0 with the buffer pointer, then
// emits the epilogue.  Pin the ILP32 target so wordBytes = 4 (SizeOf = 32 → 8
// copy words), then assert (a) exactly 8 STR copy-stores, (b) the R0 reload right
// before the epilogue (dropping it — a real AAPCS32 ABI break — must fail here),
// and (c) the trailing pop epilogue.
func TestReturnSretAggregateMemcpysAndRet() testing.TestResult {
	setArm32Target()
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SretSlotOff = 0  // simulate PlanFrame's sret-active state
	// The returned aggregate's data region (an 8-int = 32-byte array on ILP32).
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 7)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 8)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 32)
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 7
	arg.Typ = types.MakeArrayType(types.TypInt(), 8)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32rettest(args, arg)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Args = args
	emitReturn(a, "main", rm, ins)
	if a.HasError {
		return fail("an sret aggregate return must lower, not error")
	}
	var n int = a.Sections[0].Len
	// (a) exactly SizeOf/wordBytes copy-stores.
	var expectWords int = arg.Typ.SizeOf() / wordBytes()
	if countStrImm(a) != expectWords {
		return fail("sret return must emit SizeOf/wordBytes STR copy-stores")
	}
	// (b) R0 reload just before the epilogue: LDR R0, [SP, #SretSlotOff].
	if !isLdrImm(a, n - 8) || rdAt(a, n - 8) != cast(uint32, arm32.R0) ||
			rnAt(a, n - 8) != cast(uint32, arm32.SP) {
		return fail("sret return must reload R0 with the buffer pointer "
			"before the epilogue")
	}
	// (c) Trailing word is the `pop {r4-r12, pc}` epilogue.
	if word32Ret(a, n - 4) != cast(uint32, 0xE8BD9FF0) {
		return fail("sret aggregate return must end with pop {r4-r12, pc}")
	}
	return ""
}

// A big MULTI-return that also set SretSlotOff is P4 territory: emitReturn's
// sret branch handles ONLY a single aggregate, so a return with a non-single-
// aggregate shape under SretSlotOff >= 0 must fail LOUDLY rather than emit
// garbage.
func TestReturnMultiReturnSretSetsError() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SretSlotOff = 0  // sret active, but the return is not a single aggregate
	var a0 @ir.Instr = make(ir.Instr)
	a0.ID = -1
	a0.Typ = types.TypInt()
	var a1 @ir.Instr = make(ir.Instr)
	a1.ID = -1
	a1.Typ = types.TypInt()
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32rettest(args, a0)
	args = appendInstrPtr_arm32rettest(args, a1)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Args = args
	emitReturn(a, "main", rm, ins)
	if !a.HasError {
		return fail("multi-return sret must set a compile error (P4)")
	}
	return ""
}

// A FLOAT-scalar return is P3 territory and must fail LOUDLY.
func TestReturnFloatSetsError() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	emitReturn(a, "main", rm, returnOfType(types.TypFloat64()))
	if !a.HasError {
		return fail("float return must set a compile error")
	}
	return ""
}

// An int64 return goes back in the r0:r1 register pair: lo → r0, hi → r1.  The
// returned value is a spilled SSA operand, so load64 reloads it (LDR lo @0, LDR
// hi @4) into scratch regs (r4+), then emitReturn MOVs lo → r0 (@8) and hi → r1
// (@12) — both MOVs emit since a scratch never already equals r0/r1.  The
// epilogue follows.
func TestReturnInt64InR0R1Pair() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 10)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 10
	arg.Typ = types.TypInt64()
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32rettest(args, arg)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Args = args
	emitReturn(a, "main", rm, ins)
	if a.HasError {
		return fail("an int64 return must lower, not error")
	}
	// MOV r0, lo (@8) then MOV r1, hi (@12) — DP_MOV opcode 0xD.
	if dpOpcodeAt(a, 8) != cast(uint32, 0xD) || rdAt(a, 8) != cast(uint32, arm32.R0) {
		return fail("int64 return lo word must be MOV'd into r0")
	}
	if dpOpcodeAt(a, 12) != cast(uint32, 0xD) || rdAt(a, 12) != cast(uint32, arm32.R1) {
		return fail("int64 return hi word must be MOV'd into r1")
	}
	return ""
}

// A MULTI-VALUE return (len(Args) != 1) is P3 territory and must fail LOUDLY.
func TestReturnMultiValueSetsError() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var a0 @ir.Instr = make(ir.Instr)
	a0.ID = -1
	a0.Typ = types.TypInt()
	var a1 @ir.Instr = make(ir.Instr)
	a1.ID = -1
	a1.Typ = types.TypInt()
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32rettest(args, a0)
	args = appendInstrPtr_arm32rettest(args, a1)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Args = args
	emitReturn(a, "main", rm, ins)
	if !a.HasError {
		return fail("multi-value return must set a compile error")
	}
	return ""
}

// A SMALL aggregate return (SizeOf <= InternalSretBytes = 4) is NOT sret —
// AAPCS32 returns it BY VALUE in R0 — so PlanFrame leaves SretSlotOff = -1
// (NewRegMap's default) and emitReturn takes the pack path: it loads the single
// <=4-byte word from the aggregate's data region into R0, then emits the
// epilogue.  [4]uint8 is 4 bytes on any target (uint8 is a fixed 1-byte type),
// so this needs no target pin.  The arg is given an alloc region so getOperand
// resolves it to a region pointer for the pack load.
func TestReturnSmallAggregatePacksIntoR0() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 0)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 0
	arg.Typ = types.MakeArrayType(types.TypUint8(), 4)
	var args @[]@ir.Instr
	args = appendInstrPtr_arm32rettest(args, arg)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Args = args
	emitReturn(a, "main", rm, ins)
	if a.HasError {
		return fail("small (<=4-byte) aggregate return should pack into R0, not fail")
	}
	// The pack loads the <=4-byte value from its data region into R0 (an LDR-imm);
	// the epilogue's pop is a block transfer, not an LDR-imm, so this pins the
	// pack load specifically.
	var foundLdr bool = false
	var n int = a.Sections[0].Len
	for off := 0; off + 4 <= n; off = off + 4 {
		if isLdrImm(a, off) { foundLdr = true }
	}
	if !foundLdr {
		return fail("small aggregate return should LDR the value into R0")
	}
	return ""
}
