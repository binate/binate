package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// String / rodata materialization op handlers — OP_RODATA_SLICE /
// OP_RODATA_MSLICE (pointer to a string's static managed-slice header),
// OP_RODATA_ARRAY (`var s [N]char = "..."`), and OP_RODATA_MSLICE_COPY (a fresh
// heap managed-slice initialized from a literal).  Mirror aarch64_rodata.bn,
// adapted to the arm32 MOVW/MOVT address materialization and the ILP32 word
// size (a managed-slice header is 4 * 4 = 16 bytes here, not 32).

// emitRodataMSliceOrSlice (OP_RODATA_MSLICE / OP_RODATA_SLICE): the result is a
// pointer to the string's static managed-slice header `stringMSSym` — the
// 4-word { data, len, null refptr, backing_len } header emitted once by
// emitStringTable.  A managed-slice consumer reads all 4 words; a raw-slice
// consumer reads the {data, len} prefix.  The header is immortal static data,
// so sharing one pointer across uses is safe (matches the LLVM backend).
// Reaching the weak data symbol from text goes through the MOVW/MOVT-ABS pair
// (emitSymAddr), the arm32 analog of aarch64's ADRP+ADD.
func emitRodataMSliceOrSlice(a @asm.Assembler, rm @common.RegMap, pkgName *[]readonly char,
		strings @[]ir.StringConst, ins @ir.Instr) {
	var sid int = ir.FindStringID(strings, ins.StrVal)
	if sid < 0 { return }
	var ms @[]char = stringMSSym(pkgName, sid)
	var rd int = nextReg(rm, ins.ID)
	emitSymAddr(a, rd, ms)
}

// emitStringToArray: OP_RODATA_ARRAY.  `var s [N]char = "..."` allocates a
// fresh N-byte buffer in the data region, zeroes it, then writes the first
// strLen literal bytes into the head (strLen ≤ N enforced at IR-gen time).  The
// result is a pointer to the buffer; a downstream OP_STORE struct-copy memcpys
// it into the destination alloca.  Mirrors aarch64_rodata.bn's emitStringToArray
// with the ILP32 word size.
func emitStringToArray(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	var bytes @[]char = ins.StrVal
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	var arrLen int = 0
	var arrTyp @types.Type = types.StripWrappers(ins.Typ)
	if arrTyp != nil && arrTyp.Kind == types.TYP_ARRAY {
		arrLen = arrTyp.ArrayLen
	}
	if arrLen <= 0 { return }
	var strLen int = len(bytes)
	if strLen > arrLen { strLen = arrLen }

	// Zero-fill the entire reserved buffer (rounded up by PlanFrame) in
	// word-sized chunks so the tail past strLen and any padding are
	// deterministic.
	var bufSz int = rm.LookupAllocSize(ins.ID)
	var zero int = scratchReg(rm)
	arm32.Mov(a, arm32.COND_AL, false, zero, arm32.Imm(0))
	var w int = wordBytes()
	var i int = 0
	for i < bufSz {
		emitFrameStore(a, zero, dataOff + i)
		i = i + w
	}
	if strLen > 0 {
		// Base pointer for the byte-store loop.  Use a POOL scratch (r4-r10),
		// NOT r0-r3: this op emits no call, so r0-r3 buy nothing here, and the
		// register allocator homes scalar values in r0-r3 — a base in r0 would
		// silently clobber a home live across this OP_RODATA_ARRAY (which is not
		// a clobber op).  emitInlineByteStores uses R4 as its byte scratch and IP
		// for large offsets; scratchReg here yields the next free pool slot
		// (distinct from those), and the value is dead at the trailing ResetRegs.
		var base int = scratchReg(rm)
		emitFrameAddr(a, base, dataOff)
		emitInlineByteStores(a, base, bytes, strLen)
	}
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	emitFrameAddr(a, rd, dataOff)
}

// emitStringToCharsCopy: OP_RODATA_MSLICE_COPY.  Allocates a fresh managed-slice
// via rt.MakeManagedSlice (returned through the AAPCS32 sret pointer in R0 for
// the 16-byte ILP32 header), then writes the literal bytes inline into the new
// backing.  Inline byte stores keep the generated code free of any libc memory
// primitive.  Mirrors aarch64_rodata.bn's emitStringToCharsCopy; the AAPCS32
// sret shifts the real args right by one: sret → R0, elemSize(1) → R1,
// strLen → R2.
func emitStringToCharsCopy(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr,
		bytes *[]readonly char) {
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	var strLen int = len(bytes)

	emitConstInt32(a, arm32.R2, strLen)
	emitConstInt32(a, arm32.R1, 1)
	emitFrameAddr(a, arm32.R0, dataOff)
	var mkSym @[]char = symPrefixed(mangleRtFunc("MakeManagedSlice"))
	a.SetGlobal(mkSym)
	arm32.Bl(a, arm32.COND_AL, mkSym)
	// Reload the data pointer (first word of the slice header just written) —
	// destination of the inline byte writes below.
	emitFrameLoad(a, arm32.R0, dataOff)
	emitInlineByteStores(a, arm32.R0, bytes, strLen)
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	emitFrameAddr(a, rd, dataOff)
}

// emitInlineByteStores writes a string literal's bytes into the dst buffer one
// byte at a time (`mov r4, #<byte>; strb r4, [base, #i]`), instead of calling a
// libc memory primitive.  R4 is the byte scratch; it is a callee-saved pool
// register, and we are past any call when this runs, so clobbering it is safe.
func emitInlineByteStores(a @asm.Assembler, base int, data *[]readonly char, count int) {
	for i := 0; i < count; i++ {
		var b int = 0
		if i < len(data) { b = cast(int, data[i]) }
		emitConstInt32(a, arm32.R4, b)
		// STRB's immediate offset is only 8 bits (max 255), so a string literal
		// longer than 255 bytes needs the address materialized; emitBaseScalarStore
		// (sz=1) does that in IP for i past the limit.  R4 (the byte scratch) and
		// base are never IP, so IP is free as the address scratch.
		emitBaseScalarStore(a, arm32.R4, base, i, 1, arm32.IP)
	}
}
