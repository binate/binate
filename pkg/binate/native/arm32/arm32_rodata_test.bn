package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/builtins/testing"

// Unit tests for the rodata string-materialization handlers (arm32_rodata.bn).

// emitRodataMSliceOrSlice produces a pointer to the string's static managed-
// slice header via the MOVW/MOVT-ABS pair (emitSymAddr), and registers that
// header symbol as global so its relocations resolve.  Two instructions (MOVW +
// MOVT), no per-use stack construction.
func TestRodataSliceEmitsSymAddr() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	// A one-entry string table so FindStringID resolves the literal "hi".  Build
	// the StringConst value with a managed-slice Data (BuildStringMSHeader et al.
	// read StrVal at use sites; FindStringID matches on Data).
	var data @[]char = make_slice(char, 2)
	data[0] = 'h'
	data[1] = 'i'
	var sc ir.StringConst
	sc.ID = 0
	sc.Data = data
	sc.Len = 2
	var strings @[]ir.StringConst
	strings = appendStrConst_arm32rodatatest(strings, sc)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.StrVal = "hi"
	emitRodataMSliceOrSlice(a, rm, "main", strings, ins)
	if a.HasError {
		return fail("rodata mslice/slice must not error")
	}
	if bytesWritten(a) != 8 {
		return fail("rodata slice header address is MOVW+MOVT (8 bytes)")
	}
	// The header symbol must be registered so the linker resolves its
	// MOVW_ABS_NC / MOVT_ABS relocations.
	var ms @[]char = stringMSSym("main", 0)
	if a.LookupSymbol(ms) < 0 {
		return fail("rodata slice must register the string header symbol as global")
	}
	return ""
}

// appendStrConst_arm32rodatatest grows a @[]ir.StringConst by one.
func appendStrConst_arm32rodatatest(s @[]ir.StringConst,
	v ir.StringConst) @[]ir.StringConst {
	var n @[]ir.StringConst = make_slice(ir.StringConst, len(s) + 1)
	for i := 0; i < len(s); i++ { n[i] = s[i] }
	n[len(s)] = v
	return n
}
