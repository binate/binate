package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the arm32 shift-count immediate fold (arm32ImmFits and
// emitShiftImmFoldArm32 in arm32_fold.bn).  Encodings are pinned to llvm-mc's
// (armv7a) for the same instruction, with the shifted value in R5 and the
// result in R4.

// arm32FitsShift reports whether a constant count `val`, used only as the count
// of `x OP val` on a value of type t, is flagged by the arm32 predicate.
func arm32FitsShift(op int, t @types.Type, val int) bool {
	return arm32FitsBinop(op, t, val, 1)
}

// A constant count in [0, width) of a 32-bit-or-narrower shift folds; a count at
// or above the width, a negative count, a constant shifted value and an int64
// shift (a register-pair sequence) do not.
func TestArm32ImmFitsShiftCount() testing.TestResult {
	if !arm32FitsShift(iropcode.OP_SHL, types.TypInt32(), 3) { return "int32 << 3 must fold" }
	if !arm32FitsShift(iropcode.OP_SHR, types.TypUint32(), 31) { return "uint32 >> 31 must fold" }
	if !arm32FitsShift(iropcode.OP_SHR, types.TypInt8(), 0) { return "int8 >> 0 must fold" }
	if arm32FitsShift(iropcode.OP_SHL, types.TypInt32(), 32) { return "int32 << 32 must not fold" }
	if arm32FitsShift(iropcode.OP_SHL, types.TypUint8(), 8) { return "uint8 << 8 must not fold" }
	if arm32FitsShift(iropcode.OP_SHR, types.TypInt32(), -1) {
		return "a negative count must not fold"
	}
	if arm32FitsShift(iropcode.OP_SHL, types.TypInt64(), 3) { return "an int64 shift must not fold" }
	if arm32FitsBinop(iropcode.OP_SHL, types.TypInt32(), 3, 0) {
		return "a constant shifted value must not fold"
	}
	return ""
}

// A count shared with a position that cannot take an immediate (a MUL operand)
// stays materialized; shared with an ADD it still folds.
func TestArm32ImmFitsShiftCountSharedUses() testing.TestResult {
	var f @ir.Func = arm32FitsFunc()
	var c @ir.Instr = irbuild.EmitConstInt(f.Blocks[0], 3, types.TypInt32())
	var x @ir.Instr = arm32FitsParam(f, types.TypInt32())
	_ = irbuild.EmitBinop(f.Blocks[0], iropcode.OP_SHL, x, c, types.TypInt32())
	_ = irbuild.EmitBinop(f.Blocks[0], iropcode.OP_ADD, x, c, types.TypInt32())
	if !arm32FoldedByFits(f, c) { return "a count also used by an ADD must fold" }
	_ = irbuild.EmitBinop(f.Blocks[0], iropcode.OP_MUL, x, c, types.TypInt32())
	if arm32FoldedByFits(f, c) { return "a count also used by a MUL must not fold" }
	return ""
}

// arm32FoldShiftWord emits `x OP cval` of type t with a FoldedImm count and
// reports whether it is exactly the one instruction `want`.
func arm32FoldShiftWord(op int, t @types.Type, cval int64, want uint32) bool {
	var a @asm.Assembler = arm32FoldBinopAsm(op, cval, 1, t)
	return !a.HasError && bytesWritten(a) == 4 && word32(a, 0) == want
}

// Each folded shift is one MOV with a shifted-register operand: LSL for `<<`,
// LSR for an unsigned `>>`, ASR for a signed `>>`, and a plain MOV for a zero
// count.
func TestArm32ShiftImmFoldGoldens() testing.TestResult {
	if !arm32FoldShiftWord(iropcode.OP_SHL, types.TypInt32(), cast(int64, 3),
			cast(uint32, 0xE1A04185)) {
		return "int32 x << 3 must be exactly `lsl r4, r5, #3`"
	}
	if !arm32FoldShiftWord(iropcode.OP_SHR, types.TypUint32(), cast(int64, 31),
			cast(uint32, 0xE1A04FA5)) {
		return "uint32 x >> 31 must be exactly `lsr r4, r5, #31`"
	}
	if !arm32FoldShiftWord(iropcode.OP_SHR, types.TypInt32(), cast(int64, 5),
			cast(uint32, 0xE1A042C5)) {
		return "int32 x >> 5 must be exactly `asr r4, r5, #5`"
	}
	if !arm32FoldShiftWord(iropcode.OP_SHR, types.TypInt32(), cast(int64, 0),
			cast(uint32, 0xE1A04005)) {
		return "int32 x >> 0 must be exactly `mov r4, r5`"
	}
	return ""
}

// arm32ShiftNarrowMatches emits the sub-word shift `op` of type t both folded
// (count cval) and through the register path (the count resident in R6), and
// reports whether the folded shift is exactly `want` followed by the same
// re-narrowing instruction the register path emits, `narrow`.
func arm32ShiftNarrowMatches(op int, t @types.Type, cval int64, want uint32, narrow uint32) bool {
	var f @asm.Assembler = arm32FoldBinopAsm(op, cval, 1, t)
	if f.HasError || bytesWritten(f) != 8 { return false }
	var r @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	if !emitBinop(r, rm, twoOpArm32(rm, op, t)) { return false }
	if r.HasError || bytesWritten(r) != 8 { return false }
	return word32(f, 0) == want && word32(f, 4) == narrow && word32(r, 4) == narrow
}

// A folded sub-word shift is re-narrowed exactly as the register path
// re-narrows it.
func TestArm32ShiftImmFoldSubWordNarrow() testing.TestResult {
	// asr r4, r5, #2 ; sxtb r4, r4
	if !arm32ShiftNarrowMatches(iropcode.OP_SHR, types.TypInt8(), cast(int64, 2),
			cast(uint32, 0xE1A04145), cast(uint32, 0xE6AF4074)) {
		return "int8 x >> 2 must be `asr r4, r5, #2` then the register path's SXTB"
	}
	// lsl r4, r5, #15 ; uxth r4, r4
	if !arm32ShiftNarrowMatches(iropcode.OP_SHL, types.TypUint16(), cast(int64, 15),
			cast(uint32, 0xE1A04785), cast(uint32, 0xE6FF4074)) {
		return "uint16 x << 15 must be `lsl r4, r5, #15` then the register path's UXTH"
	}
	return ""
}

// A count marked FoldedImm that does not fit (32 on an int32 shift) fails loud
// rather than encoding a masked shift or reading the unmaterialized constant.
func TestArm32ShiftImmFoldMisfitFailsLoud() testing.TestResult {
	var a @asm.Assembler = arm32FoldBinopAsm(iropcode.OP_SHL, cast(int64, 32), 1, types.TypInt32())
	if !a.HasError { return "a folded int32 shift count of 32 must record an error" }
	if bytesWritten(a) != 0 { return "a misfit folded shift count must emit nothing" }
	return ""
}
