package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/native/callconv"
import "pkg/binate/types"

// A by-address aggregate in a func-value / closure spill shim: the dispatch hands the
// shim its address in one word, and the underlying's real ABI reads its value words
// from the GP registers and the outgoing stack.

// emitSpillByAddrAggArm32 marshals one by-address in-register aggregate (a coerced
// array / named struct / source-level anon struct OR a non-coerced small slice /
// iface-value / managed-slice) that arrives as a SINGLE by-address dispatch word.  The
// dispatch word srcG (translated by emitSpillSrcToRegArm32: an arg reg if srcG <
// NumGpArgRegs, else the dispatch caller's stack at frameDelta) holds the pointer to
// the value buffer; the underlying's real ABI reads ArgWords value-words from that
// buffer.  classifyIdx is the aggregate's ABSOLUTE index in classifyTypes (i +
// classifyBase — past the prepended sret-pointer slot for the sret shape), so the
// classifier (over the FULL cc) returns the aggregate's real AAPCS32 placement — the
// same even-pair-padded, possibly-SPLIT slots the callee reads.  The pointer is parked
// in IP (the AAPCS intra-procedure scratch, not an arg/return reg) first, so the
// value-word loads can't clobber it; then each value-word is loaded from
// [IP, WordBytes*k] and placed at its outgoing slot per the classifier
// (CallArgRegStart / CallArgStackOff): the first regWords go to GP arg regs
// argReg(rs..) — rs ABSOLUTE, so no separate base offset — any remainder (AAPCS §6.5
// SPLIT) goes to the outgoing-args stack at [sp + so + (k-regWords)*WordBytes].  A
// stack-destined word shuttles through R4 (the frame-saved memory→memory shuttle,
// distinct from the IP pointer base) since a memory→memory move needs a GP temp; the
// OUTGOING store is a plain WordBytes STR (an aggregate word never narrows, and
// AAPCS32 does not pack narrow stack args), matching the callee's emitAggregateArg.
// The small-offset store uses arm32.Str (MemImm) directly with IP as the live pointer
// base.  A > 4095 outgoing offset can't (IP is busy holding the pointer, R4 carries the
// value, and there is no third GP register free to materialize the address), so the stack
// loop below RE-READS the pointer per word and materializes the offset into IP — full
// large-frame support, no fail-loud.  (staged is always true when this runs — a by-address
// aggregate is exactly what makes shimHasByAddrAggArm32 / needStage true — but it is
// threaded through so emitSpillSrcToRegArm32 reads the pointer word from its staging slot.)
// A large stack part (spillAggStackPartIsLoop) was already copied, with a loop, by
// emitSpillLargeAggStackPartsArm32 before the marshal, so only the register words are
// loaded here.
func emitSpillByAddrAggArm32(a @asm.Assembler, cc callconv.CallConv, classifyTypes @[]@types.Type,
		classifyIdx int, pt @types.Type, srcG int, frameDelta int, stageOff int, staged bool) {
	var n int = cc.ArgWords(pt)
	var rs int = cc.CallArgRegStart(classifyTypes, classifyIdx)
	var so int = cc.CallArgStackOff(classifyTypes, classifyIdx)
	var regWords int = 0
	if rs >= 0 {
		if so >= 0 {
			regWords = cc.NumGpArgRegs - rs
		} else {
			regWords = n
		}
	}
	// A sub-word-aligned aggregate's pointer may be at any address, so its words are
	// assembled byte by byte (a word LDR there faults on strict-align arm32): LR — saved at
	// entry and free until the BL — addresses the bytes, and R4 (register words) or IP
	// (stack words, after the pointer has been used) carries each byte.
	var bytewise bool = aggNeedsBytewiseArm32(pt)
	var sz int = pt.SizeOf()
	var preCopied bool = spillAggStackPartIsLoop(cc, pt, regWords, so)
	if preCopied && regWords == 0 { return }
	emitSpillSrcToRegArm32(a, cc, srcG, frameDelta, stageOff, arm32.IP, staged)
	for k := 0; k < regWords; k++ {
		if bytewise {
			emitBytewiseWordLoadArm32(a, argReg(rs + k), arm32.IP, cc.WordBytes * k,
					aggWordBytesArm32(sz, cc.WordBytes, k), arm32.LR, arm32.R4)
		} else {
			arm32.Ldr(a, arm32.COND_AL, argReg(rs + k), arm32.MemImm(arm32.IP, cc.WordBytes * k))
		}
	}
	// Stack-destined value words.  A word at a > 4095 outgoing offset cannot be stored with
	// the pointer live in IP and the value in R4 — there is no third register to materialize
	// the address — so it RE-READS the pointer into IP (R4 is free at the top of each word:
	// the prior word's value is already stored), loads the value word from [IP, k*WordBytes],
	// then materializes the outgoing offset into IP (clobbering the pointer) and stores
	// [SP, IP].  destOff is monotonic in k, so once a word takes the large branch every later
	// word does too — the small branch's assumption that IP still holds the pointer therefore
	// always holds (no large word runs before a small one).  emitSpillSrcToRegArm32 handles a
	// large pointer-source offset itself (R4 scratch for the IP dest).  The value word's own
	// offset in a > 4 KiB aggregate can pass 4095 too, so it loads through emitBaseLoad with
	// LR as its offset scratch.  A byte-wise word re-reads the pointer every time, since its
	// byte temp is IP.
	if preCopied { return }
	for k := regWords; k < n; k++ {
		var destOff int = so + (k - regWords) * cc.WordBytes
		var srcOff int = cc.WordBytes * k
		if bytewise {
			emitSpillSrcToRegArm32(a, cc, srcG, frameDelta, stageOff, arm32.IP, staged)
			emitBytewiseWordLoadArm32(a, arm32.R4, arm32.IP, srcOff, aggWordBytesArm32(sz, cc.WordBytes, k),
					arm32.LR, arm32.IP)
			emitFrameStore(a, arm32.R4, destOff)
		} else if destOff <= 0xfff {
			emitBaseLoad(a, arm32.R4, arm32.IP, srcOff, arm32.LR)
			arm32.Str(a, arm32.COND_AL, arm32.R4, arm32.MemImm(arm32.SP, destOff))
		} else {
			emitSpillSrcToRegArm32(a, cc, srcG, frameDelta, stageOff, arm32.IP, staged)
			emitBaseLoad(a, arm32.R4, arm32.IP, srcOff, arm32.LR)
			emitConstInt32(a, arm32.IP, destOff)
			arm32.Str(a, arm32.COND_AL, arm32.R4, arm32.MemReg(arm32.SP, arm32.IP))
		}
	}
}

// spillAggStackPartBytes returns how many bytes of by-address aggregate pt go to the
// outgoing stack after its regWords register words: its whole remaining bytes for a
// byte-wise (sub-word-aligned) one, else its remaining words.
func spillAggStackPartBytes(cc callconv.CallConv, pt @types.Type, regWords int) int {
	if aggNeedsBytewiseArm32(pt) { return pt.SizeOf() - cc.WordBytes * regWords }
	return cc.WordBytes * (cc.ArgWords(pt) - regWords)
}

// spillAggStackPartIsLoop reports whether by-address aggregate pt's stack part (so >= 0)
// is large enough to be copied with a loop — by emitSpillLargeAggStackPartsArm32,
// before the marshal — rather than word by word.
func spillAggStackPartIsLoop(cc callconv.CallConv, pt @types.Type, regWords int, so int) bool {
	return so >= 0 &&
			aggCopyIsLoop(spillAggStackPartBytes(cc, pt, regWords), aggNeedsBytewiseArm32(pt))
}

// emitSpillLargeAggStackPartsArm32 copies, before the spill marshal writes any outgoing
// register, the large stack part (spillAggStackPartIsLoop) of every by-address aggregate
// user arg with a loop (emitShimCopyLoopArm32): R2 (the source) and R3 (the destination)
// as cursors, through R4 / LR, counted in IP.  All are free here in every spill shim: the
// incoming registers are staged, R4 is the frame-saved shuttle, LR is saved and unused
// until the BL, and R0 / R1 / R5 (a retbuf or the closure-struct base) are left alone.
// The aggregate's address is reloaded from its staged dispatch word;
// emitSpillByAddrAggArm32 then skips those words.  An unstaged shim never has a
// by-address aggregate (staging is what one forces), so finding one there is reported
// rather than copied over live registers.
func emitSpillLargeAggStackPartsArm32(a @asm.Assembler, cc callconv.CallConv,
		classifyTypes @[]@types.Type, classifyBase int, userTypes @[]@types.Type, srcPrefix int,
		frameDelta int, stageOff int, staged bool) {
	var inWord int = 0
	for i := 0; i < len(userTypes); i++ {
		var pt @types.Type = userTypes[i]
		if isByAddressAggArm32(cc, pt) {
			var rs int = cc.CallArgRegStart(classifyTypes, i + classifyBase)
			var so int = cc.CallArgStackOff(classifyTypes, i + classifyBase)
			var regWords int = 0
			if rs >= 0 { regWords = cc.NumGpArgRegs - rs }
			if spillAggStackPartIsLoop(cc, pt, regWords, so) {
				if !staged {
					a.SetError("native arm32: a large by-address aggregate in an unstaged spill shim")
					return
				}
				emitSpillSrcToRegArm32(a, cc, srcPrefix + inWord, frameDelta, stageOff, arm32.R2, staged)
				emitAddImm(a, arm32.R2, arm32.R2, cc.WordBytes * regWords, arm32.IP)
				emitFrameAddr(a, arm32.R3, so)
				emitShimCopyLoopArm32(a, arm32.R3, arm32.R2, spillAggStackPartBytes(cc, pt, regWords),
						aggNeedsBytewiseArm32(pt))
			}
		}
		inWord = inWord + shimInWordsForTypeArm32(cc, pt)
	}
}
