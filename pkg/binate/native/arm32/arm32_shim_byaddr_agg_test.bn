package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for a by-value aggregate in a spill shim (arm32_shim_byaddr_agg.bn): its stack
// part's size, when that part is copied with a loop before the marshal, and the shims'
// resulting code size.  fvOneParam_marshaltest lives in arm32_funcvalue_marshal_test.bn,
// shimForCapturesArm32 in arm32_closure_shim_large_test.bn.

// The stack part is the words after the register words, or — byte-wise — the
// aggregate's remaining bytes; it is a loop copy past the unroll thresholds.
func TestSpillAggStackPartSize() testing.TestResult {
	setArm32Target()
	var cc callconv.CallConv = callconv.AAPCS32()
	var words @types.Type = types.MakeArrayType(types.TypInt32(), 1100)
	var bytes @types.Type = types.MakeArrayType(types.TypUint8(), 5001)
	var w17 @types.Type = types.MakeArrayType(types.TypInt32(), 17)
	if spillAggStackPartBytes(cc, words, 3) != 4388 {
		return fail("1100 words after 3 in registers: 4388 bytes")
	}
	if spillAggStackPartBytes(cc, bytes, 4) != 4985 {
		return fail("5001 bytes after 16 in registers: 4985")
	}
	if spillAggStackPartIsLoop(cc, w17, 4, 0) { return fail("52 stack bytes stay unrolled") }
	if !spillAggStackPartIsLoop(cc, w17, 0, 0) { return fail("68 stack bytes are a loop copy") }
	if spillAggStackPartIsLoop(cc, words, 3, -1) { return fail("no stack part, no loop") }
	return ""
}

// The func-value and closure shims of a huge by-value array copy its stack part with a
// loop: each is a few dozen instructions, where a word or byte at a time it was
// thousands.
func TestShimHugeAggStackPartIsLoopArm32() testing.TestResult {
	setArm32Target()
	var noResults @[]@types.Type
	var words @types.Type = types.MakeArrayType(types.TypInt32(), 1100)
	var bytes @types.Type = types.MakeArrayType(types.TypUint8(), 5000)
	var kinds @[]@types.Type = make_slice(@types.Type, 2)
	kinds[0] = words
	kinds[1] = bytes
	for k := 0; k < 2; k++ {
		var fv @asm.Assembler = asm.New(4)
		fv.SetSection("text", -1)
		emitScalarVoidShim(fv, "bn_ref", fvOneParam_marshaltest(kinds[k], noResults))
		if fv.HasError || fv.Sections[0].Len > 256 {
			return fail("a func-value shim of a huge array must copy its stack part with a loop")
		}
		var caps @[]@types.Type = make_slice(@types.Type, 2)
		caps[0] = types.TypUint8()
		caps[1] = kinds[k]
		var cl @asm.Assembler = shimForCapturesArm32(caps, noResults)
		if cl.HasError || cl.Sections[0].Len > 256 {
			return fail("a closure shim capturing a huge array must copy its stack part with a loop")
		}
	}
	return ""
}
