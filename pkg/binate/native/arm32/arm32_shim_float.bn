package "pkg/binate/native/arm32"

import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Hard-float (AAPCS-VFP) float classification for the func-value / method-value /
// iface / indirect / closure SHIMS.  Under hard-float a float SCALAR rides a VFP
// register (s0..s15 / d0..d7), which the GP-only shim marshal cannot place; a float
// nested in an AGGREGATE, by contrast, is GP-coerced (HfaInSimd() is false for arm32,
// so neither the native nor the LLVM backend uses VFP-HFA) and rides the float-agnostic
// GP paths (by-address re-expand / sret / pack / by-word capture load).  These
// predicates decide — per func-value type / call instruction / closure — which float
// shapes are HANDLED and which must still fail LOUD (never a silent GP<->VFP mismatch).
//
// HANDLED: a register-resident SCALAR float param/return (rides VFP, prefix-insensitive
// via cc.CallArgFpReg; the GP marshal skips it — hardFloatShimSkipArm32); a float nested
// in a single aggregate as a param / return / capture (float-agnostic GP path); a float
// leaf in a MULTI-RETURN tuple result — a small (register-returned) tuple is stored
// field-by-class via the FP-aware shim store (storeMultiReturnTupleFieldsShimArm32, inc
// 3f b3) and a big (sret) tuple is written through the retbuf by the underlying; a scalar
// float CAPTURE — the closure routes to its framed variant, whose capture load VLDRs it from
// the data block into its VFP register (emitClosureCaptureVfpLoadArm32, inc 3f b4a); and a
// scalar float PARAM through a framed CLOSURE emitter — the GP marshal skips it and it is
// passed through untouched (no float captures) or VFP-up-shifted past the float captures
// (emitClosureParamVfpUpShiftArm32, inc 3f b4b).
//
// STILL FAIL-LOUD — only a users-only INCOMING VFP-ARGUMENT-BANK SPILL: a scalar float param the
// dispatch delivers on the stack (the closure/func value declares > 8 float params), which the
// register-only marshal does not relocate (funcValueShimUnhandledFloatB1Arm32).  A closure param
// whose captures++users OUTGOING slot spills once the float captures fill the bank is now placed
// at its outgoing stack slot by the memory-staged parallel move (emitClosureParamVfpUpShiftArm32,
// inc 3f b5), and a back-fill DOWN-MOVE reorder is likewise handled by that cycle-agnostic move
// (inc 3f b4b/b4c).

// hardFloatShimSkipArm32 reports whether the shared GP shim marshal
// (shimOutRegs / shimInWordsArm32 / emitShimArgMarshalArm32) must SKIP param pt.
// Under hard-float a float scalar rides VFP, consuming no GP word, so it is invisible
// to the GP cursor and passes through to the underlying untouched — the marshal only
// shifts the GP words down past the dropped data/retbuf/receiver prefix.  Inert on
// soft-float, where a float rides GP like its same-width integer.
func hardFloatShimSkipArm32(pt @types.Type) bool {
	return types.Arm32HardFloat() && common.IsFloatScalarTyp(pt)
}

// anyFloatScalarSpillsVfpArm32 reports whether any scalar-float type in `ts` spills
// the AAPCS-VFP argument bank (all 16 S / 8 D slots taken, with back-fill) to the
// stack — a shape the register-resident marshal does not place (it stays
// fail-loud until the VFP-spill follow-up, since a stacked float would be neither in
// its VFP register nor relocated by the GP-only marshal).  VFP allocation ignores GP
// args, so walking the float scalars over their own type list reproduces the S/D
// assignment cc.CallArgFpReg computes at the call site (prefix-insensitive); a
// spilled float yields hwSlot < 0.
func anyFloatScalarSpillsVfpArm32(cc common.CallConv, ts @[]@types.Type) bool {
	for i := 0; i < len(ts); i++ {
		if common.IsFloatScalarTyp(ts[i]) {
			var hw int
			hw, _ = cc.CallArgFpReg(ts, i)
			if hw < 0 { return true }
		}
	}
	return false
}

// funcValueParamTypesArm32 extracts a func-value type's parameter types into a
// @[]@types.Type — the VFP-allocation view anyFloatScalarSpillsVfpArm32 consumes.
func funcValueParamTypesArm32(fvTyp @types.Type) @[]@types.Type {
	var n int = len(fvTyp.Params)
	var ts @[]@types.Type = make_slice(@types.Type, n)
	for i := 0; i < n; i++ {
		ts[i] = fvTyp.Params[i].Type
	}
	return ts
}

// funcValueShimUnhandledFloatB1Arm32 reports whether a NON-closure func-value type
// carries a float shape the shim body does NOT yet handle — so emitFuncValueShimBody
// must still fail LOUD.  HANDLED (NOT flagged): a register-resident SCALAR float
// param/return (rides VFP; the GP marshal skips it); a float nested in a SINGLE aggregate
// param or return (GP-coerce / by-address / sret / pack — float-AGNOSTIC raw words on
// which native and LLVM agree, HfaInSimd() false for arm32); and ANY float leaf in a
// MULTI-RETURN tuple — a BIG (sret) tuple is written field-by-field through the retbuf by
// the underlying (float-agnostic), and a SMALL (register-returned) tuple is stored by the
// FP-aware shim store (storeMultiReturnTupleFieldsShimArm32, inc 3f b3), each float field
// VSTR'd from its VFP return register.  Unhandled (returns true): a scalar float param
// that spills the VFP ARGUMENT bank (a stacked float the register-only marshal can't
// place — a VFP-spill follow-up).  A register-resident scalar float that overflows the GP
// registers routes to the over-budget spill shim, guarded there (scalar-float-param-only)
// — not here.
func funcValueShimUnhandledFloatB1Arm32(cc common.CallConv, fvTyp @types.Type) bool {
	if !funcValueShimHasFloatArm32(fvTyp) {
		return false
	}
	return anyFloatScalarSpillsVfpArm32(cc, funcValueParamTypesArm32(fvTyp))
}

// callInstrUnhandledFloatB1Arm32 is the call-site twin of
// funcValueShimUnhandledFloatB1Arm32: it reports whether an indirect / func-value /
// iface CALL instruction moves a float the call site cannot place, so the site must
// still fail LOUD.  Args[0] is the call target / iface value, so user args are
// Args[1..].  Handled: a register-resident scalar float arg (emitCallArg ->
// emitCallArgFloatHard -> VFP), a scalar float single-return (emitCallReturn -> VFP), a
// float nested in a single aggregate arg (passed by-address as a GP pointer) or return
// (retbuf) — float-agnostic GP paths — and a float leaf in a MULTI-RETURN tuple result:
// emitCallReturn collects it via collectMultiReturnFields, which already diverts a
// float-containing tuple to the FP-aware collectMultiReturnFieldsHard (each float field
// read from its VFP return register).  Unhandled (returns true): a scalar float arg that
// spills the VFP ARGUMENT bank (a stacked float the register-only marshal can't place — a
// VFP-spill follow-up).  Kept in lockstep with funcValueShimUnhandledFloatB1Arm32.
func callInstrUnhandledFloatB1Arm32(cc common.CallConv, ins @ir.Instr) bool {
	if !callInstrHasFloatArm32(ins) {
		return false
	}
	// The user-arg type list feeds the VFP-spill check only: a float nested in an
	// aggregate arg rides by-address as a GP pointer (float-agnostic), so it is NOT
	// flagged — only a scalar float arg that spills the VFP bank is.
	var nUser int = len(ins.Args) - 1
	var ts @[]@types.Type = make_slice(@types.Type, nUser)
	for i := 0; i < nUser; i++ {
		var arg @ir.Instr = ins.Args[i + 1]
		if arg != nil {
			ts[i] = arg.Typ // nil arg -> ts[i] stays nil (contributes no float)
		}
	}
	return anyFloatScalarSpillsVfpArm32(cc, ts)
}

// anyCaptureHasScalarFloatArm32 reports whether any of the closure's captures is a
// BARE SCALAR float.  Under hard-float the underlying takes such a capture as a leading
// VFP param, and the framed capture load VLDRs it from the closure data block into its VFP
// register (emitClosureCaptureVfpLoadArm32, inc 3f b4a).  This predicate is now the ROUTING
// gate — it diverts a float-capture closure to its framed variant (the fast path's dense GP
// captureWords cursor can't host a float capture) — and one input to the cap+param fail-loud
// (a float capture coexisting with a float scalar param still needs the b4b up-shift).  A
// float nested in an AGGREGATE capture is float-agnostic (the underlying GP-coerces the
// aggregate capture-param), so it is NOT flagged.
func anyCaptureHasScalarFloatArm32(f @ir.Func) bool {
	if f == nil || f.ClosureStruct == nil {
		return false
	}
	for i := 0; i < f.NumCaptureParams; i++ {
		if common.IsFloatScalarTyp(f.ClosureStruct.Fields[i].Type) {
			return true
		}
	}
	return false
}
