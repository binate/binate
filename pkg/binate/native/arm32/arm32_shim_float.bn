package "pkg/binate/native/arm32"

import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Hard-float (AAPCS-VFP) float classification / helpers for the func-value / method-
// value / iface / indirect / closure SHIMS.  On the POSITIONAL all-integer dispatch
// seam (spec abi/03 §3.3) a scalar float crosses as its GP bit image — float32 in one
// slot, float64 in two — exactly like soft-float; the shim's GP marshal then VMOVs those
// incoming bits into the underlying's real AAPCS-VFP register (or, for a VFP-bank spill,
// copies them to the underlying's outgoing stack slot), and a scalar float RETURN is
// VMOV'd from S0 / D0 back to the GP-return seam.  So the GP↔VFP boundary lives entirely
// in the shim — the seam itself is float-ABI-agnostic.  A float nested in an AGGREGATE is
// GP-coerced (HfaInSimd() is false for arm32, so neither the native nor the LLVM backend
// uses VFP-HFA) and rides the float-agnostic GP paths (by-address re-expand / sret / pack
// / by-word capture load).  A scalar float CAPTURE never crosses the seam — it rides the
// closure data block and is VLDR'd into its VFP register by emitClosureCaptureVfpLoadArm32.
//
// All scalar-float shim shapes — a register-resident OR VFP-bank-spilling param, a
// register-resident OR bank-spilling return, and the mix of a spilling float param with
// GP/aggregate params — are now handled by the marshal + framed shims; the DIRECT
// indirect-call path (emitCallIndirect, a real AAPCS-VFP callee, no shim) is what still
// consults the fail-loud predicates below (callInstrUnhandledFloatB1Arm32).

// hardFloatShimSkipArm32 reports whether the OUTGOING GP-register walk (shimOutRegs)
// must SKIP param pt.  Under hard-float a float scalar rides a VFP register, consuming
// NO outgoing GP word, so it is invisible to the outgoing GP cursor — the marshal places
// its VFP register separately.  (The INCOMING cursor, by contrast, DOES count a float's
// GP bit-image slot(s), so this skip is used only by the outgoing walk, not the incoming
// word count.)  Inert on soft-float, where a float rides GP like its same-width integer.
func hardFloatShimSkipArm32(pt @types.Type) bool {
	return types.Arm32HardFloat() && common.IsFloatScalarTyp(pt)
}

// anyFloatScalarSpillsVfpArm32 reports whether any scalar-float type in `ts` spills
// the AAPCS-VFP argument bank (all 16 S / 8 D slots taken, with back-fill) to the
// stack.  Consulted by the DIRECT indirect-call path (callInstrUnhandledFloatB1Arm32),
// which is a real AAPCS-VFP callee with no shim: a stacked float there is a not-yet-
// implemented shape it fails loud on.  (The func-value / iface / closure SHIM seam, by
// contrast, now handles a VFP-bank-spilling float — the shim copies its GP bit image to
// the underlying's outgoing stack slot.)  VFP allocation ignores GP args, so walking the
// float scalars over their own type list reproduces the S/D assignment cc.CallArgFpReg
// computes (prefix-insensitive); a spilled float yields hwSlot < 0.
func anyFloatScalarSpillsVfpArm32(cc common.CallConv, ts @[]@types.Type) bool {
	for i := 0; i < len(ts); i++ {
		if common.IsFloatScalarTyp(ts[i]) {
			var hw int
			hw, _ = cc.CallArgFpReg(ts, i)
			if hw < 0 { return true }
		}
	}
	return false
}

// funcValueParamTypesArm32 extracts a func-value type's parameter types into a
// @[]@types.Type — the fpDestTypes view the register-only shim marshal
// (emitShimArgMarshalArm32) allocates a non-closure float param's VFP register over.
func funcValueParamTypesArm32(fvTyp @types.Type) @[]@types.Type {
	var n int = len(fvTyp.Params)
	var ts @[]@types.Type = make_slice(@types.Type, n)
	for i := 0; i < n; i++ {
		ts[i] = fvTyp.Params[i].Type
	}
	return ts
}

// callInstrUnhandledFloatB1Arm32 reports whether a DIRECT indirect CALL instruction
// (OP_CALL_INDIRECT — a dtor / free_fn / cross-mode target invoked with the real
// AAPCS-VFP convention, NO shim) moves a float the site cannot place, so it must fail
// LOUD.  Args[0] is the call target, so user args are Args[1..].  Handled: a register-
// resident scalar float arg (emitCallArg -> emitCallArgFloatHard -> VFP), a scalar float
// single-return (emitCallReturn -> VFP), a float nested in a single aggregate arg (by-
// address as a GP pointer) or return (retbuf), and a float leaf in a MULTI-RETURN tuple
// result (collectMultiReturnFieldsHard).  Unhandled (returns true): a scalar float arg
// that spills the VFP ARGUMENT bank (a stacked float the direct path does not yet place).
// (The func-value / iface / closure SHIM seam is separate — its floats ride the positional
// GP seam and the shim re-marshals them, VFP-bank spill included.)
func callInstrUnhandledFloatB1Arm32(cc common.CallConv, ins @ir.Instr) bool {
	if !callInstrHasFloatArm32(ins) {
		return false
	}
	// The user-arg type list feeds the VFP-spill check only: a float nested in an
	// aggregate arg rides by-address as a GP pointer (float-agnostic), so it is NOT
	// flagged — only a scalar float arg that spills the VFP bank is.
	var nUser int = len(ins.Args) - 1
	var ts @[]@types.Type = make_slice(@types.Type, nUser)
	for i := 0; i < nUser; i++ {
		var arg @ir.Instr = ins.Args[i + 1]
		if arg != nil {
			ts[i] = arg.Typ // nil arg -> ts[i] stays nil (contributes no float)
		}
	}
	return anyFloatScalarSpillsVfpArm32(cc, ts)
}

// anyCaptureHasScalarFloatArm32 reports whether any of the closure's captures is a
// BARE SCALAR float.  Under hard-float the underlying takes such a capture as a leading
// VFP param, and the framed capture load VLDRs it from the closure data block into its VFP
// register (emitClosureCaptureVfpLoadArm32).  This predicate is the ROUTING gate — it
// diverts a float-capture closure to its framed variant (the fast path's dense GP
// captureWords cursor can't host a float capture, and the framed spill marshal is what
// places a float param into its capture-shifted VFP slot).  A float nested in an AGGREGATE
// capture is float-agnostic (the underlying GP-coerces the aggregate capture-param), so it
// is NOT flagged.
func anyCaptureHasScalarFloatArm32(f @ir.Func) bool {
	if f == nil || f.ClosureStruct == nil {
		return false
	}
	for i := 0; i < f.NumCaptureParams; i++ {
		if common.IsFloatScalarTyp(f.CaptureFieldType(i)) {
			return true
		}
	}
	return false
}
