package "pkg/binate/native/arm32"

import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Hard-float (AAPCS-VFP) float classification for the func-value / method-value /
// iface / indirect SHIMS (inc 3f(b) of plan-native-arm32.md).  Under hard-float a
// float scalar rides a VFP register (s0..s15 / d0..d7), which the GP-only shim
// marshal cannot place; these predicates decide — per func-value type or per call
// instruction — whether a float shape is one the CURRENT increment handles or one
// that must still fail LOUD (never a silent GP<->VFP mismatch).
//
// Increment 3f(b1) handles exactly a REGISTER-RESIDENT SCALAR float param and a
// SCALAR float single-return through the func-value / method-value / iface /
// indirect call sites and the func-value/method shim bodies: such a float rides VFP
// on BOTH the shim's incoming ABI and the underlying's ABI, because the synthetic GP
// data/retbuf/receiver prefix words do NOT consume VFP registers (cc.CallArgFpReg
// walks a float-only S-occupancy mask, so it is prefix-insensitive).  The float
// therefore passes through untouched while the GP marshal shifts only the GP words
// (hardFloatShimSkipArm32 drops it from the GP walk).  Every OTHER float shape stays
// fail-loud here: a float nested in an aggregate (rides the GP-coerce / sret path —
// inc 3f(b2)), a float leaf in a multi-return tuple (inc 3f(b3)), a scalar float that
// spills the VFP argument bank, a float through a closure (inc 3f(b1b)/(b4)) or the
// over-budget spill shim.

// hardFloatShimSkipArm32 reports whether the shared GP shim marshal
// (shimOutRegs / shimInWordsArm32 / emitShimArgMarshalArm32) must SKIP param pt.
// Under hard-float a float scalar rides VFP, consuming no GP word, so it is invisible
// to the GP cursor and passes through to the underlying untouched — the marshal only
// shifts the GP words down past the dropped data/retbuf/receiver prefix.  Inert on
// soft-float, where a float rides GP like its same-width integer.
func hardFloatShimSkipArm32(pt @types.Type) bool {
	return types.Arm32HardFloat() && common.IsFloatScalarTyp(pt)
}

// anyFloatScalarSpillsVfpArm32 reports whether any scalar-float type in `ts` spills
// the AAPCS-VFP argument bank (all 16 S / 8 D slots taken, with back-fill) to the
// stack — a shape inc 3f(b1)'s register-resident marshal does not place (it stays
// fail-loud until the VFP-spill follow-up, since a stacked float would be neither in
// its VFP register nor relocated by the GP-only marshal).  VFP allocation ignores GP
// args, so walking the float scalars over their own type list reproduces the S/D
// assignment cc.CallArgFpReg computes at the call site (prefix-insensitive); a
// spilled float yields hwSlot < 0.
func anyFloatScalarSpillsVfpArm32(cc common.CallConv, ts @[]@types.Type) bool {
	for i := 0; i < len(ts); i++ {
		if common.IsFloatScalarTyp(ts[i]) {
			var hw int
			hw, _ = cc.CallArgFpReg(ts, i)
			if hw < 0 { return true }
		}
	}
	return false
}

// funcValueParamTypesArm32 extracts a func-value type's parameter types into a
// @[]@types.Type — the VFP-allocation view anyFloatScalarSpillsVfpArm32 consumes.
func funcValueParamTypesArm32(fvTyp @types.Type) @[]@types.Type {
	var n int = len(fvTyp.Params)
	var ts @[]@types.Type = make_slice(@types.Type, n)
	for i := 0; i < n; i++ {
		ts[i] = fvTyp.Params[i].Type
	}
	return ts
}

// funcValueShimUnhandledFloatB1Arm32 reports whether a NON-closure func-value type
// carries a float shape the inc 3f(b1) shim body does NOT yet handle — so
// emitFuncValueShimBody must still fail LOUD.  Handled (returns false): a
// register-resident scalar float param, a scalar float single-return, and any
// float-free shape.  Unhandled (returns true): a float nested in an aggregate
// param/return (inc 3f(b2)), any float leaf in a multi-return tuple (inc 3f(b3)), or
// a scalar float param that spills the VFP bank (follow-up).  A register-resident
// scalar float that overflows the GP registers routes to the over-budget spill shim,
// which stays GP-only and is guarded there — not here.
func funcValueShimUnhandledFloatB1Arm32(cc common.CallConv, fvTyp @types.Type) bool {
	if !funcValueShimHasFloatArm32(fvTyp) {
		return false
	}
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		if typHasFloatLeafArm32(pt) && !common.IsFloatScalarTyp(pt) {
			return true
		}
	}
	if anyFloatScalarSpillsVfpArm32(cc, funcValueParamTypesArm32(fvTyp)) {
		return true
	}
	if len(fvTyp.Results) == 1 && fvTyp.Results[0] != nil {
		var rt @types.Type = fvTyp.Results[0]
		if typHasFloatLeafArm32(rt) && !common.IsFloatScalarTyp(rt) {
			return true
		}
	}
	if len(fvTyp.Results) > 1 {
		for ri := 0; ri < len(fvTyp.Results); ri++ {
			if typHasFloatLeafArm32(fvTyp.Results[ri]) {
				return true
			}
		}
	}
	return false
}

// callInstrUnhandledFloatB1Arm32 is the call-site twin of
// funcValueShimUnhandledFloatB1Arm32: it reports whether an indirect / func-value /
// iface CALL instruction moves a float the inc 3f(b1) call site cannot place, so the
// site must still fail LOUD.  Args[0] is the call target / iface value, so user args
// are Args[1..].  Handled: a register-resident scalar float arg (emitCallArg ->
// emitCallArgFloatHard -> VFP) and a scalar float single-return (emitCallReturn ->
// emitCallReturnFloatHard -> VFP).  Unhandled: a float nested in an aggregate arg or
// return (inc 3f(b2)), a float leaf in a multi-return tuple result (inc 3f(b3)), and a
// scalar float arg that spills the VFP bank (follow-up).  Kept in lockstep with
// funcValueShimUnhandledFloatB1Arm32 so the call site and the shim body agree on
// which shapes are live.
func callInstrUnhandledFloatB1Arm32(cc common.CallConv, ins @ir.Instr) bool {
	if !callInstrHasFloatArm32(ins) {
		return false
	}
	var nUser int = len(ins.Args) - 1
	var ts @[]@types.Type = make_slice(@types.Type, nUser)
	for i := 0; i < nUser; i++ {
		var arg @ir.Instr = ins.Args[i + 1]
		if arg == nil {
			continue // nil arg contributes no float (ts[i] stays nil); mirrors callInstrHasFloatArm32
		}
		var at @types.Type = arg.Typ
		ts[i] = at
		if typHasFloatLeafArm32(at) && !common.IsFloatScalarTyp(at) {
			return true
		}
	}
	if anyFloatScalarSpillsVfpArm32(cc, ts) {
		return true
	}
	// The return: a bare scalar float rides VFP (handled); any other float-bearing
	// return — a float nested in a single aggregate (inc 3f(b2)) or a multi-return
	// tuple with a float leaf (inc 3f(b3)) — is not yet handled.  ins.Typ is the
	// aggregate / multi-return tuple type; typHasFloatLeafArm32 walks it recursively.
	if ins.ID >= 0 && ins.Typ != nil && typHasFloatLeafArm32(ins.Typ) &&
			!common.IsFloatScalarTyp(ins.Typ) {
		return true
	}
	return false
}
