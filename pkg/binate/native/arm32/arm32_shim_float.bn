package "pkg/binate/native/arm32"

import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Hard-float (AAPCS-VFP) float classification for the func-value / method-value /
// iface / indirect / closure SHIMS.  Under hard-float a float SCALAR rides a VFP
// register (s0..s15 / d0..d7), which the GP-only shim marshal cannot place; a float
// nested in an AGGREGATE, by contrast, is GP-coerced (HfaInSimd() is false for arm32,
// so neither the native nor the LLVM backend uses VFP-HFA) and rides the float-agnostic
// GP paths (by-address re-expand / sret / pack / by-word capture load).  These
// predicates decide — per func-value type / call instruction / closure — which float
// shapes are HANDLED and which must still fail LOUD (never a silent GP<->VFP mismatch).
//
// HANDLED: a register-resident SCALAR float param/return (rides VFP, prefix-insensitive
// via cc.CallArgFpReg; the GP marshal skips it — hardFloatShimSkipArm32), and a float
// nested in a single aggregate as a param / return / capture (float-agnostic GP path).
//
// STILL FAIL-LOUD: a scalar float that spills the VFP argument bank; a float leaf in a
// MULTI-RETURN tuple (VFP return regs the GP-only multiret store can't read — inc
// 3f(b3)); a SCALAR float CAPTURE (needs a memory->VFP load — inc 3f(b4)); a scalar
// float param with an aggregate/multi-return result (routes to the GP-only pack/sret
// marshal); and any scalar float reaching the over-budget spill shim.

// hardFloatShimSkipArm32 reports whether the shared GP shim marshal
// (shimOutRegs / shimInWordsArm32 / emitShimArgMarshalArm32) must SKIP param pt.
// Under hard-float a float scalar rides VFP, consuming no GP word, so it is invisible
// to the GP cursor and passes through to the underlying untouched — the marshal only
// shifts the GP words down past the dropped data/retbuf/receiver prefix.  Inert on
// soft-float, where a float rides GP like its same-width integer.
func hardFloatShimSkipArm32(pt @types.Type) bool {
	return types.Arm32HardFloat() && common.IsFloatScalarTyp(pt)
}

// anyFloatScalarSpillsVfpArm32 reports whether any scalar-float type in `ts` spills
// the AAPCS-VFP argument bank (all 16 S / 8 D slots taken, with back-fill) to the
// stack — a shape the register-resident marshal does not place (it stays
// fail-loud until the VFP-spill follow-up, since a stacked float would be neither in
// its VFP register nor relocated by the GP-only marshal).  VFP allocation ignores GP
// args, so walking the float scalars over their own type list reproduces the S/D
// assignment cc.CallArgFpReg computes at the call site (prefix-insensitive); a
// spilled float yields hwSlot < 0.
func anyFloatScalarSpillsVfpArm32(cc common.CallConv, ts @[]@types.Type) bool {
	for i := 0; i < len(ts); i++ {
		if common.IsFloatScalarTyp(ts[i]) {
			var hw int
			hw, _ = cc.CallArgFpReg(ts, i)
			if hw < 0 { return true }
		}
	}
	return false
}

// funcValueParamTypesArm32 extracts a func-value type's parameter types into a
// @[]@types.Type — the VFP-allocation view anyFloatScalarSpillsVfpArm32 consumes.
func funcValueParamTypesArm32(fvTyp @types.Type) @[]@types.Type {
	var n int = len(fvTyp.Params)
	var ts @[]@types.Type = make_slice(@types.Type, n)
	for i := 0; i < n; i++ {
		ts[i] = fvTyp.Params[i].Type
	}
	return ts
}

// funcValueShimUnhandledFloatB1Arm32 reports whether a NON-closure func-value type
// carries a float shape the shim body does NOT yet handle — so emitFuncValueShimBody
// must still fail LOUD.  A float nested in a SINGLE aggregate (param or return) is
// HANDLED and NOT flagged: it rides the GP-coerce / by-address / sret / pack path,
// which is float-AGNOSTIC (raw words) and on which native and LLVM agree — HfaInSimd()
// is false for arm32, so NEITHER backend uses VFP-HFA (both GP-coerce).  A register-
// resident SCALAR float param/return rides VFP (handled).  Unhandled (returns true):
// a scalar float param that spills the VFP argument bank (follow-up), and ANY float
// leaf in a MULTI-RETURN tuple (a register-returned tuple places float fields in VFP
// return regs the GP-only multiret store can't read — inc 3f(b3)).  A register-resident
// scalar float that overflows the GP registers routes to the over-budget spill shim,
// guarded there (scalar-float-only) — not here.
func funcValueShimUnhandledFloatB1Arm32(cc common.CallConv, fvTyp @types.Type) bool {
	if !funcValueShimHasFloatArm32(fvTyp) {
		return false
	}
	if anyFloatScalarSpillsVfpArm32(cc, funcValueParamTypesArm32(fvTyp)) {
		return true
	}
	if len(fvTyp.Results) > 1 {
		for ri := 0; ri < len(fvTyp.Results); ri++ {
			if typHasFloatLeafArm32(fvTyp.Results[ri]) {
				return true
			}
		}
	}
	return false
}

// funcValueShimHasScalarFloatParamArm32 reports whether a func-value type has a BARE
// SCALAR float PARAM.  The over-budget spill / pack / big-sret-spill emitters marshal
// user args via the GP-only emitSpillMarshalArm32, which places a scalar float PARAM in
// a GP register/stack slot by soft-float coincidence — wrong under hard-float, where it
// rides VFP.  NOT flagged: a float nested in an AGGREGATE param (float-agnostic there —
// re-expanded as raw words), and a scalar float RETURN (it rides a VFP return register
// the spill's GP-only arg-marshal + teardown never touch; a multi-return float is caught
// upstream by funcValueShimUnhandledFloatB1Arm32 instead).
func funcValueShimHasScalarFloatParamArm32(fvTyp @types.Type) bool {
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		if common.IsFloatScalarTyp(fvTyp.Params[pi].Type) {
			return true
		}
	}
	return false
}

// callInstrUnhandledFloatB1Arm32 is the call-site twin of
// funcValueShimUnhandledFloatB1Arm32: it reports whether an indirect / func-value /
// iface CALL instruction moves a float the call site cannot place, so the site must
// still fail LOUD.  Args[0] is the call target / iface value, so user args are
// Args[1..].  Handled: a register-resident scalar float arg (emitCallArg ->
// emitCallArgFloatHard -> VFP), a scalar float single-return (emitCallReturn -> VFP),
// and a float nested in a single aggregate arg (passed by-address as a GP pointer) or
// return (retbuf) — float-agnostic GP paths.  Unhandled (returns true): a scalar float
// arg that spills the VFP bank (follow-up), and a float leaf in a MULTI-RETURN tuple
// result (VFP return regs the GP-only multiret collection can't read — inc 3f(b3)).
// Kept in lockstep with funcValueShimUnhandledFloatB1Arm32.
func callInstrUnhandledFloatB1Arm32(cc common.CallConv, ins @ir.Instr) bool {
	if !callInstrHasFloatArm32(ins) {
		return false
	}
	// The user-arg type list feeds the VFP-spill check only: a float nested in an
	// aggregate arg rides by-address as a GP pointer (float-agnostic), so it is NOT
	// flagged — only a scalar float arg that spills the VFP bank is.
	var nUser int = len(ins.Args) - 1
	var ts @[]@types.Type = make_slice(@types.Type, nUser)
	for i := 0; i < nUser; i++ {
		var arg @ir.Instr = ins.Args[i + 1]
		if arg != nil {
			ts[i] = arg.Typ // nil arg -> ts[i] stays nil (contributes no float)
		}
	}
	if anyFloatScalarSpillsVfpArm32(cc, ts) {
		return true
	}
	// The return: a scalar float rides VFP and a float nested in a single aggregate
	// rides the retbuf (both handled).  A float leaf in a MULTI-RETURN tuple result
	// rides a VFP return reg the GP-only multiret collection can't read — inc 3f(b3).
	if ins.ID >= 0 && ins.Typ != nil && common.IsMultiReturnCall(ins) &&
			typHasFloatLeafArm32(ins.Typ) {
		return true
	}
	return false
}

// closureShimUnhandledFloatB1bArm32 is the closure-shim twin of
// funcValueShimUnhandledFloatB1Arm32.  A closure's register-resident scalar float
// PARAM / scalar float single-return rides VFP untouched (the shared GP marshal skips
// it; non-float captures don't consume VFP, so the float lands in the same VFP slot on
// both sides).  A float nested in a single aggregate (param, return, OR capture) rides
// the float-agnostic GP path (by-address re-expand / sret / pack / by-word capture
// load), so it is HANDLED.  Still fail-loud: a SCALAR float CAPTURE (it lives in the
// data block and the underlying takes it as a leading VFP param, needing a memory->VFP
// load the GP-only capture load can't do — inc 3f(b4)); the func-value-side unhandled
// shapes (a VFP-bank-spilled scalar float param, a float leaf in a multi-return tuple
// -> b3); and a scalar float PARAM with an aggregate/multi-return result (see below).
func closureShimUnhandledFloatB1bArm32(cc common.CallConv, fvTyp @types.Type, f @ir.Func) bool {
	if funcValueShimUnhandledFloatB1Arm32(cc, fvTyp) {
		return true
	}
	if anyCaptureHasScalarFloatArm32(f) {
		return true
	}
	// A scalar float PARAM is handled ONLY when the closure takes the SCALAR/VOID shim
	// shape (the fast tail-branch or the scalar/void spill).  An AGGREGATE or
	// MULTI-RETURN result routes to the pack / big-sret-spill emitters, which marshal
	// user args via the GP-only emitSpillMarshalArm32 (NO float skip) — so a scalar
	// float param there would be counted as a GP dispatch word and desync the marshal (a
	// silent miscompile).  Keep it fail-loud until that path is float-aware (a follow-up
	// with inc 3f(b3)).  (A float-in-aggregate param is float-agnostic on that GP path,
	// so anyFloatScalarParamArm32 — not typHasFloatLeaf — is the right test.)
	return closureResultIsAggOrMultiArm32(fvTyp) && anyFloatScalarParamArm32(fvTyp)
}

// anyFloatScalarParamArm32 reports whether any of the func value's params is a bare
// float scalar (the param shape inc 3f(b1) rides through VFP).
func anyFloatScalarParamArm32(fvTyp @types.Type) bool {
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		if common.IsFloatScalarTyp(fvTyp.Params[pi].Type) {
			return true
		}
	}
	return false
}

// closureResultIsAggOrMultiArm32 reports whether the closure's result routes to the
// pack / sret / multi-return emitter (an aggregate of SizeOf >= 1, or a multi-return
// tuple) rather than the scalar/void tail-branch.  A 0-byte aggregate is void-like
// (IsAggregateReturnTyp false) and rides the scalar/void shim, so it is NOT flagged.
func closureResultIsAggOrMultiArm32(fvTyp @types.Type) bool {
	if len(fvTyp.Results) > 1 {
		return true
	}
	if len(fvTyp.Results) == 1 && fvTyp.Results[0] != nil {
		return types.IsAggregateReturnTyp(fvTyp.Results[0])
	}
	return false
}

// anyCaptureHasScalarFloatArm32 reports whether any of the closure's captures is a
// BARE SCALAR float.  Under hard-float the underlying takes such a capture as a leading
// VFP param, but it lives in the closure data block and the GP-only capture load
// (emitClosureCaptureRegLoadArm32 / the spill capture reads) can only move it to a GP
// register — so it stays fail-loud until a memory->VFP capture load lands (inc 3f(b4)).
// A float nested in an AGGREGATE capture is float-agnostic on that GP by-word load
// (the underlying GP-coerces the aggregate capture-param), so it is NOT flagged.
func anyCaptureHasScalarFloatArm32(f @ir.Func) bool {
	if f == nil || f.ClosureStruct == nil {
		return false
	}
	for i := 0; i < f.NumCaptureParams; i++ {
		if common.IsFloatScalarTyp(f.ClosureStruct.Fields[i].Type) {
			return true
		}
	}
	return false
}
