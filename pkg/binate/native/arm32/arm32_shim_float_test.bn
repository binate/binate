package "pkg/binate/native/arm32"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the hard-float shim float-classification predicates in
// arm32_shim_float.bn: anyFloatScalarSpillsVfpArm32 (the VFP-bank spill check) and
// callInstrUnhandledFloatB1Arm32 (the DIRECT indirect-call float guard).  The func-value
// / iface / closure SHIM seam now carries floats positionally as GP bit images and the
// shim VMOVs them to VFP, so it has no float fail-loud predicate — only the direct
// indirect-call path (a real AAPCS-VFP callee) still fails loud on a VFP-bank spill.
// Each test stamps hard-float so common.AAPCS32() carries VfpBackfill (the flag the VFP
// allocator cc.CallArgFpReg keys on) and restores the target before asserting so the
// stamp does not leak.

// fvParamsFromTypes builds a @[]@types.Param (one unnamed param per type).
func fvParamsFromTypes(ts @[]@types.Type) @[]@types.Param {
	var ps @[]@types.Param = make_slice(@types.Param, len(ts))
	for i := 0; i < len(ts); i++ {
		var p @types.Param = make(types.Param)
		p.Name = "x"
		p.Type = ts[i]
		ps[i] = p
	}
	return ps
}

// oneType wraps a single type in a @[]@types.Type.
func oneType(t @types.Type) @[]@types.Type {
	var ts @[]@types.Type = make_slice(@types.Type, 1)
	ts[0] = t
	return ts
}

// EIGHT float64 args fit the VFP argument bank (D0..D7), so anyFloatScalarSpillsVfpArm32
// reports no spill — the boundary just below overflow.  (fvParamsFromTypes / oneType are
// shared with the func-value-shim and closure-shim test files.)
func TestAnyFloatScalarSpillsVfpEightDoublesFit() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var cc common.CallConv = common.AAPCS32()
	var pts @[]@types.Type = make_slice(@types.Type, 8)
	for i := 0; i < 8; i++ {
		pts[i] = types.TypFloat64()
	}
	var spills bool = anyFloatScalarSpillsVfpArm32(cc, pts)
	restoreTarget(oldArch, oldAbi)
	if spills {
		return fail("eight float64s fit D0..D7 — none spills the VFP bank")
	}
	return ""
}

// A NINTH float64 overflows the VFP bank (only D0..D7 exist), so
// anyFloatScalarSpillsVfpArm32 reports a spill — the shape the DIRECT indirect-call path
// still fails loud on (the SHIM seam now handles it by copying the GP bit image to the
// underlying's outgoing stack slot).
func TestAnyFloatScalarSpillsVfpNineDoublesSpill() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var cc common.CallConv = common.AAPCS32()
	var pts @[]@types.Type = make_slice(@types.Type, 9)
	for i := 0; i < 9; i++ {
		pts[i] = types.TypFloat64()
	}
	var spills bool = anyFloatScalarSpillsVfpArm32(cc, pts)
	restoreTarget(oldArch, oldAbi)
	if !spills {
		return fail("a ninth float64 spills the VFP bank")
	}
	return ""
}

// A float32 back-fills a hole a float64's even-alignment leaves — pins that
// anyFloatScalarSpillsVfpArm32 uses the real AAPCS-VFP back-fill allocator, not a
// monotonic cursor.  (float32, float64) x7 uses S0 + D1..D7 with S1 a back-fill hole,
// then a trailing float32 back-fills S1 rather than spilling.
func TestAnyFloatScalarSpillsVfpBackfillNoSpill() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var cc common.CallConv = common.AAPCS32()
	var pts @[]@types.Type = make_slice(@types.Type, 2)
	pts[0] = types.TypFloat64()
	pts[1] = types.TypFloat32()
	var spills bool = anyFloatScalarSpillsVfpArm32(cc, pts)
	restoreTarget(oldArch, oldAbi)
	if spills {
		return fail("a float32 after a float64 back-fills S1 — no spill")
	}
	return ""
}

// mkFloatCallInstr builds a minimal OP_CALL_FUNC_VALUE instruction: Args[0] is the
// call target (a *uint8), Args[1] is a user arg of type argTyp.  retTyp is the result
// (nil / void => ID -1, no return-value classification).
func mkFloatCallInstr(argTyp @types.Type, retTyp @types.Type) @ir.Instr {
	var tgt @ir.Instr = make(ir.Instr)
	tgt.Typ = types.MakePointerType(types.TypUint8())
	var arg @ir.Instr = make(ir.Instr)
	arg.Typ = argTyp
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CALL_FUNC_VALUE
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = tgt
	ins.Args[1] = arg
	if retTyp == nil {
		ins.ID = -1
	} else {
		ins.ID = 1
		ins.Typ = retTyp
	}
	return ins
}

// The direct indirect-call guard: a register-resident SCALAR float arg is HANDLED
// (emitCallArgFloatHard places it in VFP), so callInstrUnhandledFloatB1Arm32 returns false.
func TestCallInstrUnhandledB1ScalarFloatArgHandled() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var cc common.CallConv = common.AAPCS32()
	var ins @ir.Instr = mkFloatCallInstr(types.TypFloat32(), nil)
	var unhandled bool = callInstrUnhandledFloatB1Arm32(cc, ins)
	restoreTarget(oldArch, oldAbi)
	if unhandled {
		return fail("a scalar float call arg must be handled (inc 3f b1)")
	}
	return ""
}

// A float-in-aggregate call arg is HANDLED — passed by-address as a GP pointer — so
// callInstrUnhandledFloatB1Arm32 returns false.
func TestCallInstrUnhandledB1FloatInAggArgHandled() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var cc common.CallConv = common.AAPCS32()
	var ins @ir.Instr = mkFloatCallInstr(floatPairStructType(), nil)
	var unhandled bool = callInstrUnhandledFloatB1Arm32(cc, ins)
	restoreTarget(oldArch, oldAbi)
	if unhandled {
		return fail("a float-in-aggregate call arg must be handled by-address (inc 3f b2)")
	}
	return ""
}

// mkMultiRetFloatCallInstr builds a minimal OP_CALL_FUNC_VALUE whose result is a small
// (float32, int) multi-return tuple (a nameless TYP_STRUCT — IsMultiReturnCall matches)
// and whose only arg is the call target (no float user args).
func mkMultiRetFloatCallInstr() @ir.Instr {
	var tgt @ir.Instr = make(ir.Instr)
	tgt.Typ = types.MakePointerType(types.TypUint8())
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypFloat32()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CALL_FUNC_VALUE
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = tgt
	ins.ID = 1
	ins.Typ = types.MakeStructType("", fields)
	return ins
}

// A float leaf in a MULTI-RETURN tuple RESULT is HANDLED — emitCallReturn collects it via
// the FP-aware collectMultiReturnFieldsHard — so callInstrUnhandledFloatB1Arm32 returns
// false.
func TestCallInstrUnhandledB1MultiRetFloatHandled() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var cc common.CallConv = common.AAPCS32()
	var ins @ir.Instr = mkMultiRetFloatCallInstr()
	var unhandled bool = callInstrUnhandledFloatB1Arm32(cc, ins)
	restoreTarget(oldArch, oldAbi)
	if unhandled {
		return fail("a float multi-return call result must be handled (inc 3f b3)")
	}
	return ""
}
