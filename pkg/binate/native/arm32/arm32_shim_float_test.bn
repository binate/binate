package "pkg/binate/native/arm32"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the hard-float shim float-classification predicates in
// arm32_shim_float.bn (inc 3f b1/b2): funcValueShimUnhandledFloatB1Arm32,
// callInstrUnhandledFloatB1Arm32, funcValueShimHasScalarFloatParamArm32, and the
// anyFloatScalarSpillsVfpArm32 VFP-bank spill check.  Each stamps hard-float so
// common.AAPCS32() carries
// VfpBackfill (the flag the VFP allocator cc.CallArgFpReg keys on) and restores the
// target before asserting so the stamp does not leak.

// fvParamsFromTypes builds a @[]@types.Param (one unnamed param per type).
func fvParamsFromTypes(ts @[]@types.Type) @[]@types.Param {
	var ps @[]@types.Param = make_slice(@types.Param, len(ts))
	for i := 0; i < len(ts); i++ {
		var p @types.Param = make(types.Param)
		p.Name = "x"
		p.Type = ts[i]
		ps[i] = p
	}
	return ps
}

// oneType wraps a single type in a @[]@types.Type.
func oneType(t @types.Type) @[]@types.Type {
	var ts @[]@types.Type = make_slice(@types.Type, 1)
	ts[0] = t
	return ts
}

// A register-resident SCALAR float param is HANDLED by inc 3f(b1): it rides VFP, so
// funcValueShimUnhandledFloatB1Arm32 returns false.
func TestUnhandledB1ScalarFloatParamHandled() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var cc common.CallConv = common.AAPCS32()
	var noResults @[]@types.Type
	var fv @types.Type = types.MakeFuncValueType(fvParamsFromTypes(oneType(types.TypFloat32())),
			noResults)
	var unhandled bool = funcValueShimUnhandledFloatB1Arm32(cc, fv)
	restoreTarget(oldArch, oldAbi)
	if unhandled {
		return fail("a register-resident scalar float param must be handled (inc 3f b1)")
	}
	return ""
}

// A SCALAR float single-return is HANDLED by inc 3f(b1) (rides the VFP return
// register through the tail-branch).
func TestUnhandledB1ScalarFloatReturnHandled() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var cc common.CallConv = common.AAPCS32()
	var noParams @[]@types.Param
	var fv @types.Type = types.MakeFuncValueType(noParams, oneType(types.TypFloat64()))
	var unhandled bool = funcValueShimUnhandledFloatB1Arm32(cc, fv)
	restoreTarget(oldArch, oldAbi)
	if unhandled {
		return fail("a scalar float single-return must be handled (inc 3f b1)")
	}
	return ""
}

// A float-free func value is HANDLED (the guard never fires) — pins the early-out.
func TestUnhandledB1NoFloatHandled() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var cc common.CallConv = common.AAPCS32()
	var fv @types.Type = types.MakeFuncValueType(fvParamsFromTypes(oneType(types.TypInt())),
			oneType(types.TypInt()))
	var unhandled bool = funcValueShimUnhandledFloatB1Arm32(cc, fv)
	restoreTarget(oldArch, oldAbi)
	if unhandled {
		return fail("a float-free func value must be handled")
	}
	return ""
}

// A float leaf nested in a SINGLE aggregate param is HANDLED (inc 3f(b2)): the
// aggregate is GP-coerced / passed by-address (float-agnostic; native<->LLVM agree via
// HfaInSimd()==false), so funcValueShimUnhandledFloatB1Arm32 returns false.
func TestUnhandledB1FloatInAggParamHandled() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var cc common.CallConv = common.AAPCS32()
	var noResults @[]@types.Type
	var fv @types.Type = types.MakeFuncValueType(
			fvParamsFromTypes(oneType(floatPairStructType())), noResults)
	var unhandled bool = funcValueShimUnhandledFloatB1Arm32(cc, fv)
	restoreTarget(oldArch, oldAbi)
	if unhandled {
		return fail("a float-in-aggregate param must be handled via GP-coerce (inc 3f b2)")
	}
	return ""
}

// A float LEAF in a MULTI-RETURN tuple is UNHANDLED (rides a VFP return register the
// GP-only multiret store can't read) — must stay fail-loud until inc 3f(b3).
func TestUnhandledB1MultiRetFloatUnhandled() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var cc common.CallConv = common.AAPCS32()
	var noParams @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 2)
	results[0] = types.TypFloat32()
	results[1] = types.TypInt()
	var fv @types.Type = types.MakeFuncValueType(noParams, results)
	var unhandled bool = funcValueShimUnhandledFloatB1Arm32(cc, fv)
	restoreTarget(oldArch, oldAbi)
	if !unhandled {
		return fail("a float multi-return must stay fail-loud (inc 3f b3)")
	}
	return ""
}

// EIGHT float64 params fit the VFP argument bank (D0..D7), so they are all
// register-resident and HANDLED — the boundary just below the spill.
func TestUnhandledB1EightDoublesHandled() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var cc common.CallConv = common.AAPCS32()
	var pts @[]@types.Type = make_slice(@types.Type, 8)
	for i := 0; i < 8; i++ {
		pts[i] = types.TypFloat64()
	}
	var noResults @[]@types.Type
	var fv @types.Type = types.MakeFuncValueType(fvParamsFromTypes(pts), noResults)
	var unhandled bool = funcValueShimUnhandledFloatB1Arm32(cc, fv)
	restoreTarget(oldArch, oldAbi)
	if unhandled {
		return fail("eight float64 params fit D0..D7 and must be handled (inc 3f b1)")
	}
	return ""
}

// NINE float64 params overflow the VFP bank (only D0..D7 exist), so the ninth spills
// to the stack — a shape inc 3f(b1)'s register-resident marshal does not place, so it
// stays fail-loud (VFP-spill follow-up).  Pins anyFloatScalarSpillsVfpArm32.
func TestUnhandledB1NineDoublesSpillUnhandled() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var cc common.CallConv = common.AAPCS32()
	var pts @[]@types.Type = make_slice(@types.Type, 9)
	for i := 0; i < 9; i++ {
		pts[i] = types.TypFloat64()
	}
	var noResults @[]@types.Type
	var fv @types.Type = types.MakeFuncValueType(fvParamsFromTypes(pts), noResults)
	var unhandled bool = funcValueShimUnhandledFloatB1Arm32(cc, fv)
	restoreTarget(oldArch, oldAbi)
	if !unhandled {
		return fail("a ninth float64 param spills the VFP bank and must stay fail-loud")
	}
	return ""
}

// mkFloatCallInstr builds a minimal OP_CALL_FUNC_VALUE instruction: Args[0] is the
// call target (a *uint8), Args[1] is a user arg of type argTyp.  retTyp is the result
// (nil / void => ID -1, no return-value classification).
func mkFloatCallInstr(argTyp @types.Type, retTyp @types.Type) @ir.Instr {
	var tgt @ir.Instr = make(ir.Instr)
	tgt.Typ = types.MakePointerType(types.TypUint8())
	var arg @ir.Instr = make(ir.Instr)
	arg.Typ = argTyp
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CALL_FUNC_VALUE
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = tgt
	ins.Args[1] = arg
	if retTyp == nil {
		ins.ID = -1
	} else {
		ins.ID = 1
		ins.Typ = retTyp
	}
	return ins
}

// The call-site twin: a register-resident SCALAR float arg is HANDLED, so
// callInstrUnhandledFloatB1Arm32 returns false.
func TestCallInstrUnhandledB1ScalarFloatArgHandled() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var cc common.CallConv = common.AAPCS32()
	var ins @ir.Instr = mkFloatCallInstr(types.TypFloat32(), nil)
	var unhandled bool = callInstrUnhandledFloatB1Arm32(cc, ins)
	restoreTarget(oldArch, oldAbi)
	if unhandled {
		return fail("a scalar float call arg must be handled (inc 3f b1)")
	}
	return ""
}

// The call-site twin: a float-in-aggregate call arg is HANDLED (inc 3f(b2)) — passed
// by-address as a GP pointer — so callInstrUnhandledFloatB1Arm32 returns false.
func TestCallInstrUnhandledB1FloatInAggArgHandled() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	var cc common.CallConv = common.AAPCS32()
	var ins @ir.Instr = mkFloatCallInstr(floatPairStructType(), nil)
	var unhandled bool = callInstrUnhandledFloatB1Arm32(cc, ins)
	restoreTarget(oldArch, oldAbi)
	if unhandled {
		return fail("a float-in-aggregate call arg must be handled by-address (inc 3f b2)")
	}
	return ""
}

// funcValueShimHasScalarFloatParamArm32 (the spill/pack/sret-spill backstop predicate)
// flags a bare scalar float PARAM but NOT a scalar float RETURN: the over-budget spill
// marshal mishandles a scalar float ARG (GP), but a scalar float return rides a VFP
// return register the spill's GP teardown never touches.  So a func value with only a
// scalar float RETURN (and float-agnostic aggregate params) rides the spill fine.
func TestSpillGuardScalarFloatReturnNotFlagged() testing.TestResult {
	setArm32Target()
	var oldArch int
	var oldAbi int
	oldArch, oldAbi = stampHard()
	// func(float64-aggregate) float64 : an aggregate param (GP-coerced) + a scalar
	// float return -> NOT flagged (the return is not marshaled by the GP spill).
	var retFv @types.Type = types.MakeFuncValueType(
			fvParamsFromTypes(oneType(floatPairStructType())), oneType(types.TypFloat64()))
	var retFlagged bool = funcValueShimHasScalarFloatParamArm32(retFv)
	// func(float32) void : a scalar float PARAM -> flagged (the GP spill can't place it).
	var noResults @[]@types.Type
	var paramFv @types.Type = types.MakeFuncValueType(
			fvParamsFromTypes(oneType(types.TypFloat32())), noResults)
	var paramFlagged bool = funcValueShimHasScalarFloatParamArm32(paramFv)
	restoreTarget(oldArch, oldAbi)
	if retFlagged {
		return fail(
				"a scalar float RETURN must NOT be flagged by the spill guard "
						"(it rides VFP untouched)")
	}
	if !paramFlagged {
		return fail("a scalar float PARAM must be flagged by the spill guard (GP-only marshal)")
	}
	return ""
}
