package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/binate/types/abi"

// Hard-float (AAPCS-VFP) HFAs in the func-value / closure / interface shims.  On the
// all-integer dispatch seam (spec abi/03 §3.3) an HFA, like every aggregate passed by
// value, crosses BY ADDRESS — one pointer word in — and comes back through the retbuf.
// With cc.HfaAggregates the underlying takes it as one co-processor register candidate,
// so the shim loads each member from that pointer into the VFP register cc.CallArgFpReg
// gives (it takes no core register), and an HFA result, which the underlying returns
// in s0.. / d0.., is stored member by member through the retbuf after the call.  An HFA
// argument past the VFP bank goes to the underlying's stack like a by-address aggregate
// with no register words.

// isVfpHfaArm32 reports whether t is an HFA cc passes as one co-processor register
// candidate (cc.HfaAggregates under the AAPCS-VFP back-fill allocator): in VFP
// registers, or on the stack once the bank is used up — never in core registers.
func isVfpHfaArm32(cc callconv.CallConv, t @types.Type) bool {
	if !cc.VfpBackfill || !cc.HfaAggregates || !callconv.IsAggregateTyp(t) { return false }
	return abi.HfaMemberCount(t) > 0
}

// shimVfpOverflowArm32 reports whether any of the n user arguments at
// fpDestTypes[fpDestOff..] is a co-processor register candidate — a float scalar or an
// HFA — that the underlying takes on the stack because the VFP bank is used up.  The
// register-only marshal places no stack argument, so such a shim takes the spill path.
func shimVfpOverflowArm32(cc callconv.CallConv, fpDestTypes @[]@types.Type, fpDestOff int,
		n int) bool {
	if !cc.VfpBackfill { return false }
	for i := 0; i < n; i++ {
		var t @types.Type = fpDestTypes[fpDestOff + i]
		if callconv.IsFloatScalarTyp(t) || isVfpHfaArm32(cc, t) {
			hwSlot, _ := cc.CallArgFpReg(fpDestTypes, fpDestOff + i)
			if hwSlot < 0 { return true }
		}
	}
	return false
}

// emitShimHfaParamArm32 places an HFA user argument of the register-only marshal in its
// VFP registers: the address arrived as incoming word srcWord — staged at [SP +
// WordBytes*srcWord] when staged, else live in liveReg — and goes into IP, from which
// each member loads.  Returns false (after a.SetError) when the HFA is not in VFP
// registers, which shimArgsFitRegisters routes to the spill shim instead.
func emitShimHfaParamArm32(a @asm.Assembler, cc callconv.CallConv, pt @types.Type,
		fpDestTypes @[]@types.Type, fpDestIdx int, liveReg int, srcWord int, staged bool) bool {
	hwSlot, isDouble := cc.CallArgFpReg(fpDestTypes, fpDestIdx)
	if hwSlot < 0 {
		a.SetError(
				"native arm32 hard-float: register-only shim marshal reached an HFA param past the "
						"VFP bank (should have routed to the spill shim)")
		return false
	}
	if staged {
		arm32.Ldr(a, arm32.COND_AL, arm32.IP, arm32.MemImm(arm32.SP, cc.WordBytes * srcWord))
	} else {
		arm32.Mov(a, arm32.COND_AL, false, arm32.IP, arm32.Reg(liveReg))
	}
	n, memW := abi.HfaClassify(pt)
	emitHfaLoadPtrArm32(a, hwSlot, isDouble, n, memW, arm32.IP)
	return true
}

// emitHfaRetToRetbufArm32 stores an HFA result of type rt, arriving in s0.. / d0..,
// through the retbuf address in rb.
func emitHfaRetToRetbufArm32(a @asm.Assembler, rt @types.Type, rb int) {
	n, memW := abi.HfaClassify(rt)
	emitHfaStorePtrArm32(a, 0, memW == 8, n, memW, rb)
}

// emitHfaRetShimArm32 emits the func-value shim for an HFA result in VFP registers
// (cc.ReturnsHfaInRegs).  Entered under the aggregate-return dispatch ABI as
// `void(retbuf=R0, data=R1, args=R2..)`, like the pack shim it saves the retbuf in R4,
// marshals the user args down to R0.., BLs the underlying — which returns the HFA in
// s0.. / d0.. — and stores each member through the retbuf.  Over-budget args route to
// the framed spill shim, which does the same store after its BL.
func emitHfaRetShimArm32(a @asm.Assembler, cc callconv.CallConv, fnLabel @[]char,
		fvTyp @types.Type) {
	var fpDest @[]@types.Type = funcValueParamTypesArm32(fvTyp)
	var nOut int = shimOutRegs(a, cc, fvTyp, 0)
	if nOut < 0 { return }
	if !shimArgsFitRegisters(cc, fvTyp, 2, 0, nOut, fpDest, 0) {
		emitFuncvalSpillShimArm32(a, cc, fnLabel, fvTyp, 0, false, false, false, false)
		return
	}
	// push {r4, lr}; the retbuf (R0) survives the BL in the callee-saved R4.
	arm32.Push(a, arm32.COND_AL, packShimPushMask())
	arm32.Mov(a, arm32.COND_AL, false, arm32.R4, arm32.Reg(arm32.R0))
	emitShimArgMarshalArm32(a, cc, fvTyp, 2, 0, false, fpDest, 0)
	a.SetGlobal(fnLabel)
	arm32.Bl(a, arm32.COND_AL, fnLabel)
	emitHfaRetToRetbufArm32(a, fvTyp.Results[0], arm32.R4)
	arm32.Pop(a, arm32.COND_AL, packShimPopMask())
}
