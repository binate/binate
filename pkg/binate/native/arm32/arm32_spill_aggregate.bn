package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"

// emitSpillAggregateParam writes into an incoming aggregate parameter's spill slot
// a pointer to its bytes, which downstream uses read.  One passed wholly or partly
// on the stack is used in place (PlanFrame gives it no region): wholly on the stack
// its bytes are in the caller's outgoing-args area, which the callee owns; split,
// the prologue stored its register part right below its stack part (the split save
// area, emitSplitSaveArm32).  One passed in registers alone is stored into its data
// region from argReg(regStart + w).
func emitSpillAggregateParam(a @asm.Assembler, rm @common.RegMap, p @ir.Param, regStart int,
		stackOff int, stackArgsBase int) {
	if p.Typ.SizeOf() <= 0 { return }
	var w int = wordBytes()
	if stackOff >= 0 {
		var regWords int = 0
		if regStart >= 0 { regWords = rm.CC.NumGpArgRegs - regStart }
		writeAggParamSpillPtr(a, rm, p, stackArgsBase + stackOff - w * regWords)
		rm.ResetRegs()
		return
	}
	var dataOff int = rm.NeedAlloc(a, p.ID, "native arm32: an aggregate parameter")
	var allocSz int = rm.LookupAllocSize(p.ID)
	if dataOff < 0 || allocSz <= 0 { return }
	var nWords int = rm.CC.ArgWords(p.Typ)
	// Every SP-relative access here goes through emitFrameStore: a data region's
	// offset can exceed the 12-bit immediate when the frame is large, so a bare
	// MemImm(SP, ...) would trip imm12Offset's range error.
	if regStart >= 0 {
		for wi := 0; wi < nWords; wi++ {
			emitFrameStore(a, argReg(regStart + wi), dataOff + w * wi)
		}
	}
	writeAggParamSpillPtr(a, rm, p, dataOff)
	rm.ResetRegs()
}

// writeAggParamSpillPtr stores a pointer to an aggregate param's bytes (sp + dataOff:
// its data region, or where they arrived) into its spill slot, so downstream
// getOperand reloads a uniform pointer for the value.
func writeAggParamSpillPtr(a @asm.Assembler, rm @common.RegMap, p @ir.Param, dataOff int) {
	var spillOff int = rm.NeedSpill(a, p.ID, "native arm32: an aggregate parameter")
	if spillOff < 0 { return }
	var tmp int = scratchReg(rm)
	emitFrameAddr(a, tmp, dataOff)
	emitFrameStore(a, tmp, spillOff)
}

// emitSplitSaveArm32 sets up the split save area (common.RegMap.SplitSaveBytes) at
// function entry, before anything else moves SP: the register part of the one
// aggregate parameter AAPCS32 splits between r0-r3 and the stack is stored right
// below its stack part — the area's top words, any 4-byte pad below them — so the
// parameter's bytes are contiguous and it uses them in place.  emitEpilogueAndRet
// releases the area.  paramTypes is the parameters' classification (sret-led).
func emitSplitSaveArm32(a @asm.Assembler, rm @common.RegMap, paramTypes @[]@types.Type) {
	if rm.SplitSaveBytes <= 0 { return }
	for k := 0; k < len(paramTypes); k++ {
		var t @types.Type = paramTypes[k]
		if !callconv.IsAggregateTyp(t) || rm.CC.PassesIndirect(t) { continue }
		var rs int = rm.CC.CallArgRegStart(paramTypes, k)
		var so int = rm.CC.CallArgStackOff(paramTypes, k)
		if rs < 0 || so < 0 { continue }
		// The register part goes right below the incoming stack arguments, so the
		// stack part must start them: AAPCS32 closes the core registers once an
		// argument goes on the stack, which makes a split argument the first there.
		if so != 0 {
			a.SetError("native arm32: a split aggregate parameter does not start the stack arguments")
		}
		var regWords int = rm.CC.NumGpArgRegs - rs
		emitSpAdjust(a, false, rm.SplitSaveBytes)
		for wi := 0; wi < regWords; wi++ {
			arm32.Str(a, arm32.COND_AL, argReg(rs + wi),
					arm32.MemImm(arm32.SP, rm.SplitSaveBytes - 4 * regWords + 4 * wi))
		}
		return
	}
	a.SetError("native arm32: a split save area with no split parameter")
}
