package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// emitSpillParam of an AGGREGATE incoming parameter is now lowered: a 16-byte
// managed-slice param (4 words, all in R0..R3 under AAPCS32) is reconstructed
// into its data region and a pointer written to its spill slot.  It must NOT set
// an error, and must emit code (the 4 register STRs into the region + the
// data-pointer store).  A frame is planned so the param's alloc/spill offsets
// exist.  (Float params spill as GP scalars/pairs — see TestEmitSpillParamFloat64Spills.)
func TestEmitSpillParamAggregateLowered() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	var f @ir.Func = make(ir.Func)
	f.Name = "main.h"
	var p @ir.Param = make(ir.Param)
	p.ID = 0
	p.Typ = types.MakeManagedSliceType(types.TypInt())
	f.Params = appendParam_arm32functest(f.Params, p)
	rm.PlanFrame(f)
	var paramTypes @[]@types.Type = make_slice(@types.Type, 1)
	paramTypes[0] = p.Typ
	emitSpillParam(a, rm, p, paramTypes, 0, 40, false)
	if a.HasError {
		return fail("aggregate parameter spill must be lowered, not error")
	}
	if a.Sections[0].Len == 0 {
		return fail("aggregate parameter spill must emit marshaling code")
	}
	return ""
}
