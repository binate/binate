package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the split save area (emitSplitSaveArm32 and emitEpilogueAndRet): the
// register part of a by-value aggregate AAPCS32 splits between r0-r3 and the stack is
// stored right below its stack part, so the parameter's bytes are contiguous and it
// uses them in place.

// splitParamFuncArm32 emits `func f(k int, q Big8)` — eight ints: k in r0, q in
// r1-r3 and 20 stack bytes — with a lone return, on soft-float ILP32 arm32, and
// returns the assembler.
func splitParamFuncArm32() @asm.Assembler {
	var old types.TargetInfo = types.GetTarget()
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
	types.SetArch(types.ARCH_ARM32)
	var fields @[]@types.Field = make_slice(@types.Field, 8)
	for i := 0; i < 8; i++ {
		fields[i] = make(types.Field)
		fields[i].Name = "f"
		fields[i].Type = types.TypInt()
	}
	var params @[]@ir.Param = make_slice(@ir.Param, 2)
	params[0] = make(ir.Param)
	params[0].Name = "k"
	params[0].Typ = types.TypInt()
	params[1] = make(ir.Param)
	params[1].Name = "q"
	params[1].Typ = types.MakeStructType("Big8", fields)
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.f", params, noR)
	var blk @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(blk, noArgs)
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var strings @[]ir.StringConst
	emitFunc(a, "main", f, strings)
	types.SetTarget(old)
	return a
}

// The prologue reserves the 16-byte area (r1-r3, padded to keep SP 8-aligned) before
// the frame record: sub sp, sp, #16; str r1, [sp, #4]; str r2, [sp, #8];
// str r3, [sp, #12]; push {fp, lr}.
func TestSplitSaveAreaPrologueArm32() testing.TestResult {
	var a @asm.Assembler = splitParamFuncArm32()
	var want @[]uint32 = make_slice(uint32, 5)
	want[0] = cast(uint32, 0xE24DD010)
	want[1] = cast(uint32, 0xE58D1004)
	want[2] = cast(uint32, 0xE58D2008)
	want[3] = cast(uint32, 0xE58D300C)
	want[4] = cast(uint32, 0xE92D4800)
	for i := 0; i < len(want); i++ {
		if word32(a, 4 * i) != want[i] {
			return fail("the split save area is set up before push {fp, lr}")
		}
	}
	return ""
}

// The epilogue pops {fp, lr}, releases the area and returns with bx lr: pop {fp, lr};
// add sp, sp, #16; bx lr.  A pop into pc would return with the area still reserved.
func TestSplitSaveAreaEpilogueArm32() testing.TestResult {
	var a @asm.Assembler = splitParamFuncArm32()
	var found bool = false
	for off := 0; off + 12 <= a.Sections[0].Len; off = off + 4 {
		if word32(a, off) == cast(uint32, 0xE8BD8800) {
			return fail("no pop {fp, pc} with a split save area")
		}
		if word32(a, off) == cast(uint32, 0xE8BD4800) && word32(a, off + 4) == cast(uint32, 0xE28DD010) &&
				word32(a, off + 8) == cast(uint32, 0xE12FFF1E) {
			found = true
		}
	}
	if !found { return fail("the epilogue releases the split save area and returns with bx lr") }
	return ""
}
