package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Stack arguments past 2 GiB on arm32: no type passes 2^31 - 1 bytes, but AAPCS32 passes
// an aggregate by value, so a call's stack arguments, and the frame of a shim that lays
// them out, can.  The shims' frames are int64, narrowed only to the target's 32-bit word
// (wordArm32), and one past the address space is a compile error.  The words are
// llvm-mc's.

// bigParamsFvArm32 returns a function value type taking n by-value arrays of size bytes.
func bigParamsFvArm32(n int, size int64) @types.Type {
	var params @[]@types.Param = make_slice(@types.Param, n)
	for i := 0; i < n; i++ {
		params[i] = make(types.Param)
		params[i].Type = types.MakeArrayType(types.TypUint8(), size)
	}
	var noResults @[]@types.Type
	return types.MakeFuncValueType(params, noResults)
}

// A func-value shim for three 1.25 GiB arguments lays out a 3.75 GiB frame: the third
// argument's stack part, copied by a loop, starts at 0x9FFFFFF0, past 2^31, whose address
// is formed through IP (MOVW / MOVT, ADD R3, SP, IP).
func TestFuncvalShimFramePast2GiBArm32() testing.TestResult {
	var old types.TargetInfo = types.GetTarget()
	setArm32Target()
	defer { types.SetTarget(old) }
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitScalarVoidShim(a, callconv.AAPCS32(), "bn_ref", bigParamsFvArm32(3, 0x50000000))
	if a.HasError { return fail(a.ErrorMsg) }
	if !hasWord(a, 0xe24dd20f) || !hasWord(a, 0xe28dd20f) {
		return fail("the frame should be SUB SP, SP, #0xF0000000, released by ADD SP, SP, #0xF0000000")
	}
	if !hasWord(a, 0xe349cfff) || !hasWord(a, 0xe08d300c) {
		return fail("the third argument's stack part should start at SP + 0x9FFFFFF0, formed in IP")
	}
	return ""
}

// A fourth such argument takes the shim's frame past 4 GiB, the target's address space:
// a compile error naming the function the shim calls, not a frame size wrapped mod 2^32.
func TestFuncvalShimFramePast4GiBArm32() testing.TestResult {
	var old types.TargetInfo = types.GetTarget()
	setArm32Target()
	defer { types.SetTarget(old) }
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitScalarVoidShim(a, callconv.AAPCS32(), "bn_ref", bigParamsFvArm32(4, 0x50000000))
	if !a.HasError ||
			!arm32HasSubstr(a.ErrorMsg, "the frame of the shim of bn_ref is larger than the target allows") {
		return fail("a shim frame past 4 GiB should be a compile error")
	}
	return ""
}

// Five 1.75 GiB arguments take more words than a 32-bit host's int holds: the register-
// fit count stops past the register file instead of wrapping negative (which made the shim
// emit nothing, with no error), so the spill shim reports its frame.
func TestFuncvalShimManyBigArgsArm32() testing.TestResult {
	var old types.TargetInfo = types.GetTarget()
	setArm32Target()
	defer { types.SetTarget(old) }
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	emitScalarVoidShim(a, callconv.AAPCS32(), "bn_ref", bigParamsFvArm32(5, 0x70000000))
	if !a.HasError ||
			!arm32HasSubstr(a.ErrorMsg, "the frame of the shim of bn_ref is larger than the target allows") {
		return fail("five 1.75 GiB arguments should report the spill shim's frame")
	}
	return ""
}

// An int64 parameter arriving past 2^31 above the incoming stack arguments' base is read
// through an offset formed in IP, both words (MOVW / MOVT IP; LDR, [SP, IP]).
func TestSpillParam64Past2GiBArm32() testing.TestResult {
	var old types.TargetInfo = types.GetTarget()
	setArm32Target()
	defer { types.SetTarget(old) }
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt64(rm.SpillOffsets, 8)
	var p @ir.Param = make(ir.Param)
	p.ID = 5
	p.Typ = types.TypInt64()
	emitSpillParam64(a, rm, p, -1, 0x80001000, 40)
	if a.HasError { return fail(a.ErrorMsg) }
	if !hasWord(a, 0xe301c028) || !hasWord(a, 0xe348c000) || !hasWord(a, 0xe301c02c) {
		return fail("the two words should be read at SP + 0x80001028 and + 0x8000102C, formed in IP")
	}
	return ""
}

// closureShimFrameErrArm32 reports whether the closure shim for one int capture, four
// 1.25 GiB user arguments and results fails with the frame error, its frame being past
// 4 GiB.
func closureShimFrameErrArm32(results @[]@types.Type) bool {
	var old types.TargetInfo = types.GetTarget()
	setArm32Target()
	defer { types.SetTarget(old) }
	var big @types.Type = bigParamsFvArm32(4, 0x50000000)
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var f @ir.Func = mkIntCaptureClosure(1, big.Params)
	f.Results = results
	emitClosureShimArm32(a, callconv.AAPCS32(), "bn_ul", closureFvType(big.Params, results), f)
	return a.HasError &&
			arm32HasSubstr(a.ErrorMsg, "the frame of the shim of bn_ul is larger than the target allows")
}

// structOfArm32 returns a struct of n fields of type t.
func structOfArm32(n int, t @types.Type) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = t
	}
	return types.MakeStructType("S", fields)
}

// The closure shims for each result shape lay out the same outgoing arguments, so a frame
// past 4 GiB is a compile error from each: the scalar spill shim (no result), the sret
// spill shim (a 12-byte struct) and the pack shim (a 1-byte struct).
func TestClosureSpillShimFramePast4GiBArm32() testing.TestResult {
	var noResults @[]@types.Type
	if !closureShimFrameErrArm32(noResults) {
		return fail("the scalar spill shim should fail past 4 GiB")
	}
	return ""
}

// The sret spill shim (a 12-byte result).
func TestClosureSretShimFramePast4GiBArm32() testing.TestResult {
	if !closureShimFrameErrArm32(@[]@types.Type{structOfArm32(3, types.TypInt32())}) {
		return fail("the sret spill shim should fail past 4 GiB")
	}
	return ""
}

// The pack shim (a 1-byte result).
func TestClosurePackShimFramePast4GiBArm32() testing.TestResult {
	if !closureShimFrameErrArm32(@[]@types.Type{structOfArm32(1, types.TypUint8())}) {
		return fail("the pack shim should fail past 4 GiB")
	}
	return ""
}

// The #[c_export] trampoline of a function taking two arguments of nearly 1 GiB reads the
// second from its caller's stack arguments at SP + 0xBFFD0004, past 2^31, copying it with a
// loop (MOVW / MOVT IP; ADD R2, SP, IP).  Its frame and its caller's arguments together
// fill all but 256 KiB of the address space.
func TestCExportTrampolinePast2GiBArm32() testing.TestResult {
	a, trampLen := cexportBigArgsArm32(2, 0x3FFF0000)
	if a.HasError { return fail(a.ErrorMsg) }
	if trampLen <= 0 || trampLen >= 1024 {
		return fail("the trampoline should copy the two arguments with loops")
	}
	if !hasWord(a, 0xe300c004) || !hasWord(a, 0xe34bcffd) || !hasWord(a, 0xe08d200c) {
		return fail("the second argument should be read from SP + 0xBFFD0004, formed in IP")
	}
	return ""
}

// Three 1.25 GiB arguments take the trampoline's frame and its caller's arguments past
// 4 GiB: a compile error naming the function it calls.
func TestCExportTrampolineFramePast4GiBArm32() testing.TestResult {
	a, _ := cexportBigArgsArm32(3, 0x50000000)
	if !a.HasError ||
			!arm32HasSubstr(a.ErrorMsg,
					"the frame of the shim of main.Take is larger than the target allows") {
		return fail("a C-export trampoline frame past 4 GiB should be a compile error naming main.Take")
	}
	return ""
}
