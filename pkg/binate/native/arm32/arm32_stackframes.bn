package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// emitStackFrames lowers OP_STACK_FRAMES (pkg/std/debug's from-code stacktrace
// capture) — the arm32 counterpart of x64/aa64 emitStackFrames.  The native arm32
// prologue now establishes the frame pointer in FP/r11 (see emitFunc: `push
// {fp,lr}; mov fp,sp`), giving `[fp]`=caller fp, `[fp+4]`=return addr — the same
// walkable shape x64/aa64 use.  It calls rt.CaptureNativeFrames(fp, skip, data,
// len), whose int result (frames at/above skip) becomes this instruction's value.
//
// Args[0] = skip (scalar), Args[1] = buf *[]Frame (a raw slice — an aggregate, so
// getOperand hands back a POINTER to its {data,len} image).  AAPCS32 args:
// R0=fp, R1=skip, R2=data, R3=len; result in R0.
//
// No parallel-move hazard: only two getOperand calls run, so the operands land in
// the first two pool registers (R4, R5 — see regPool), disjoint from the arg
// registers R0..R3 and from FP.  So each arg register is written directly.
func emitStackFrames(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	var skipReg int = getOperand(a, rm, ins.Args[0].ID)
	var bufPtr int = getOperand(a, rm, ins.Args[1].ID)
	if skipReg < 0 || bufPtr < 0 { return }
	// buf's {data,len} words → R2, R3 (bufPtr is R4/R5, disjoint from R2/R3).
	arm32.Ldr(a, arm32.COND_AL, arm32.R2, arm32.MemImm(bufPtr, 0)) // data
	arm32.Ldr(a, arm32.COND_AL, arm32.R3, arm32.MemImm(bufPtr, 4)) // len
	arm32.Mov(a, arm32.COND_AL, false, arm32.R1, arm32.Reg(skipReg)) // skip
	arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Reg(arm32.FP)) // fp
	var callee @[]char = symPrefixed(mangleRtFunc("CaptureNativeFrames"))
	a.SetGlobal(callee)
	arm32.Bl(a, arm32.COND_AL, callee)
	// BL clobbers the caller-saved pool; free it before allocating the result.
	rm.ResetRegs()
	if ins.ID < 0 { return }
	var rd int = nextReg(rm, ins.ID)
	if rd != arm32.R0 {
		arm32.Mov(a, arm32.COND_AL, false, rd, arm32.Reg(arm32.R0))
	}
}
