package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// OP_STACK_FRAMES (pkg/std/debug capture) lowers to a call to
// rt.CaptureNativeFrames — NOT the fail-loud tail.  buf *[]Frame is an aggregate
// (registered as an alloc so getOperand yields a pointer to its {data,len}
// image); skip is a scalar.  Asserts the call target is declared (the whole
// lowering ran through the BL) and that bytes were emitted.  The FP(r11)=fp seed
// and R0..R3 marshaling are covered by review + the native arm32 baremetal e2e.
func TestEmitStackFrames() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	var rm @common.RegMap = common.NewRegMap(common.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 2)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	var skip @ir.Instr = make(ir.Instr)
	skip.ID = 1
	skip.Typ = types.TypInt()
	var buf @ir.Instr = make(ir.Instr)
	buf.ID = 2
	buf.Typ = types.MakeSliceType(types.TypInt()) // a raw-slice aggregate
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_STACK_FRAMES
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = skip
	ins.Args[1] = buf
	var strings @[]ir.StringConst
	emitInstr(a, "main", "bn_entry", rm, strings, ins)
	if a.Sections[0].Len == 0 {
		return fail("OP_STACK_FRAMES must not be silently dropped on arm32")
	}
	var callee @[]char = symPrefixed(mangleRtFunc("CaptureNativeFrames"))
	if a.LookupSymbol(callee) < 0 {
		return fail("OP_STACK_FRAMES should call rt.CaptureNativeFrames")
	}
	return ""
}
