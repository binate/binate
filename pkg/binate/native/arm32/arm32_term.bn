package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// emitTerm lowers ins, the terminator of a block, and reports whether the block
// ended in a transfer of control (a B, a pop into PC or a BKPT, after which
// control never reaches the following code).  next is the block laid out right
// after this one when the plan lets a block fall through into it
// (blockplan.PlanNext), else nil.  Every terminator is lowered by emitInstr, with an
// explicit B even to next, so the block always ends in a transfer.
func emitTerm(a @asm.Assembler, pkgName *[]readonly char, funcSym @[]char, rm @common.RegMap,
		strings @[]ir.StringConst, ins @ir.Instr, next @ir.Block) bool {
	emitInstr(a, pkgName, funcSym, rm, strings, ins)
	return true
}
