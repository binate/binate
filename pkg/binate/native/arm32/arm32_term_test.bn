package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// emitTerm, the lowering of a block's terminator.

// termRegMap returns a register map with value 1 spilled at offset 0.
func termRegMap() @common.RegMap {
	var rm @common.RegMap = common.NewRegMap(callconv.AAPCS32())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt64(rm.SpillOffsets, 0)
	return rm
}

// termLowersAsInstr reports whether emitTerm, with next as the block laid out
// after ins's block, emits exactly what emitInstr does for ins and reports a
// transfer.
func termLowersAsInstr(ins @ir.Instr, next @ir.Block) bool {
	var noStrings @[]ir.StringConst
	var want @asm.Assembler = asm.New(4)
	want.SetSection("text", -1)
	emitInstr(want, "main", "bn_main__main", termRegMap(), noStrings, ins)
	var got @asm.Assembler = asm.New(4)
	got.SetSection("text", -1)
	if !emitTerm(got, "main", "bn_main__main", termRegMap(), noStrings, ins, next) { return false }
	if want.HasError || got.HasError || want.Sections[0].Len == 0 { return false }
	if got.Sections[0].Len != want.Sections[0].Len { return false }
	if got.Sections[0].NumFixups != want.Sections[0].NumFixups { return false }
	for i := 0; i < want.Sections[0].Len; i++ {
		if got.Sections[0].Data[i] != want.Sections[0].Data[i] { return false }
	}
	return true
}

// termFunc returns an empty function to own termInstr's targets.
func termFunc() @ir.Func {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	return ir.NewFunc("", "main.main", noP, noR)
}

// termInstr returns a terminator with opcode op whose targets are new blocks of f,
// which owns them: a jump to `then` (f.Blocks[0]), a branch on value 1 to `then` /
// `else` (f.Blocks[0] / f.Blocks[1]), or an unreachable.
func termInstr(f @ir.Func, op int) @ir.Instr {
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = op
	if op == iropcode.OP_JUMP || op == iropcode.OP_BRANCH { ins.Block1 = ir.AddBlock(f, "then") }
	if op == iropcode.OP_BRANCH {
		var cond @ir.Instr = make(ir.Instr)
		cond.ID = 1
		cond.Typ = types.TypBool()
		ins.Args = make_slice(@ir.Instr, 1)
		ins.Args[0] = cond
		ins.Block2 = ir.AddBlock(f, "else")
	}
	return ins
}

// emitTerm lowers each terminator as emitInstr does and reports a transfer, with
// or without a block laid out next, even when that block is a target of the
// terminator.
func TestEmitTermLowersAsEmitInstr() testing.TestResult {
	var none @ir.Block
	var jf @ir.Func = termFunc()
	var jump @ir.Instr = termInstr(jf, iropcode.OP_JUMP)
	if !termLowersAsInstr(jump, none) { return fail("a jump") }
	if !termLowersAsInstr(jump, jf.Blocks[0]) { return fail("a jump to the next block") }
	var bf @ir.Func = termFunc()
	var branch @ir.Instr = termInstr(bf, iropcode.OP_BRANCH)
	if !termLowersAsInstr(branch, none) { return fail("a branch") }
	if !termLowersAsInstr(branch, bf.Blocks[0]) || !termLowersAsInstr(branch, bf.Blocks[1]) {
		return fail("a branch to the next block")
	}
	if !termLowersAsInstr(termInstr(termFunc(), iropcode.OP_UNREACHABLE), none) {
		return fail("an unreachable")
	}
	return ""
}
