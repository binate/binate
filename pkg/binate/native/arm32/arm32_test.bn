package "pkg/binate/native/arm32"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/os"

// --- Module-level empties (pattern from aarch64_test.bn). ---
var noParams @[]@ir.Param

var noResults @[]@types.Type

var noArgs @[]@ir.Instr

// --- Shared test helpers ---

func fail(msg *[]readonly char) testing.TestResult {
	return buf.CopyStr(msg)
}

func charEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// buildMainEntry returns a module "main" with a single `main.__entry`
// function that just returns.  __entry mangles to the reserved `bn_entry`
// (the arm32 crt0's sole entry into Binate), so this exercises the entry
// symbol special case + the prologue/epilogue emit path.
func buildMainEntry() @ir.Module {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func = ir.NewFunc("", "__entry", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	b.EmitReturn(noArgs)
	m.AddFunc(f)
	return m
}

// fileByte0 returns byte 0 of path (0xFF sentinel on read failure).
func fileByte0(path *[]readonly char) uint8 {
	f, oerr := os.Open(path)
	if present(oerr) { return cast(uint8, 0xFF) }
	var data @[]uint8 = make_slice(uint8, 4)
	n, _ := f.Read(data)
	_ = f.Close()
	if n < 1 { return cast(uint8, 0xFF) }
	return data[0]
}

// fileContainsStr reads up to 64 KB of path and reports whether `needle`
// appears in those bytes.  Tiny single-function objects fit under the cap.
func fileContainsStr(path *[]readonly char, needle *[]readonly char) bool {
	f, oerr := os.Open(path)
	if present(oerr) { return false }
	var data @[]uint8 = make_slice(uint8, 65536)
	n, _ := f.Read(data)
	_ = f.Close()
	var nl int = len(needle)
	if nl == 0 { return true }
	for i := 0; i + nl <= n; i++ {
		var match bool = true
		for j := 0; j < nl; j++ {
			if data[i + j] != cast(uint8, needle[j]) {
				match = false
				break
			}
		}
		if match { return true }
	}
	return false
}

// EmitObject writes an ELF32 object (arm32 has no Mach-O): first byte is the
// ELF magic 0x7F, and symbols are bare (no leading '_').  The header magic is
// toolchain-independent, so this runs on any host.
func TestEmitObjectWritesElf() testing.TestResult {
	var path *[]readonly char = "/tmp/binate_arm32_entry.o"
	if !EmitObject(buildMainEntry(), "elf", path) {
		return fail("EmitObject should succeed")
	}
	if fileByte0(path) != cast(uint8, 0x7F) {
		return fail("arm32 EmitObject must emit an ELF object (magic 0x7F)")
	}
	if !fileContainsStr(path, "bn_entry") {
		return fail("emitted object should define the bn_entry symbol")
	}
	return ""
}

// arm32 symbols are always bare (ELF-only); the emitted object must NOT carry
// a Mach-O-style leading '_' on its mangled symbols.
func TestEmitObjectSymbolsAreBare() testing.TestResult {
	var path *[]readonly char = "/tmp/binate_arm32_bare.o"
	if !EmitObject(buildMainEntry(), "elf", path) {
		return fail("EmitObject should succeed")
	}
	if fileContainsStr(path, "_bn_entry") {
		return fail("arm32 symbols must be bare — no leading '_'")
	}
	return ""
}
