package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/native/common"

// Per-type / per-iface / per-(type,iface) RTTI record emission for the arm32
// backend (P4-c.1 — the data side).  Each record's layout is laid by the shared
// ir.Build* builders (so the byte layout cannot drift from the LLVM backend);
// this gathers the object-format-prefixed symbols — bare on ELF, via symPrefixed
// — and lowers each record through common.EmitDataGlobal.  The vtable any-block
// slot 1 references the __typeinfo records (spec §7.13.8 / §7.13.14); the
// __ifaceid markers + __satentry records are the distributed interface-
// satisfaction registry (spec §11.12 `iface.rtti`).  Mirrors
// aarch64_typeinfo.bn 1:1.

// emitTypeInfosNative emits one weak `__typeinfo.<T>` RTTI record per distinct
// boxable receiver type (ir.CollectTypeInfoDescs), object-format prefixed.  The
// record's address is the type's identity; word 0 carries the destructor handle
// (byte-identical to the vtable any-block slot 0).  Weak linkage coalesces the
// same type emitted from several TUs.
func emitTypeInfosNative(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	var descs @[]@irdata.TypeInfoDesc = ir.CollectTypeInfoDescs(mod)
	for i := 0; i < len(descs); i++ {
		var pd @irdata.TypeInfoDesc = make(irdata.TypeInfoDesc)
		pd.Sym = symPrefixed(descs[i].Sym)
		pd.Size = descs[i].Size
		pd.Align = descs[i].Align
		// Word 0's dtor handle uses the same helper as the vtable any-block
		// slot 0 (dtorSlotSymNative), so the record's dtor word is byte-
		// identical to that slot.
		pd.DtorSym = dtorSlotSymNative(pkgName, mod, descs[i].DtorFuncName)
		// Name is the blob CONTENT (a string, unprefixed); NameSym is the blob
		// SYMBOL (object-format prefixed, like Sym).
		pd.Name = descs[i].Name
		pd.NameSym = symPrefixed(descs[i].NameSym)
		var dgs @[]@irdata.DataGlobal = irdata.BuildTypeInfo(pd)
		for j := 0; j < len(dgs); j++ {
			common.EmitDataGlobal(a, dgs[j])
		}
	}
}

// emitIfaceIdsNative emits one weak `__ifaceid.<J>` 1-byte marker per canonical
// interface (ir.CollectIfaceIdSyms), object-format prefixed.  Only the marker's
// address is meaningful (spec §11.12 `iface.rtti`); weak linkage coalesces the
// same interface emitted from several TUs.
func emitIfaceIdsNative(a @asm.Assembler, mod @ir.Module) {
	var syms @[]@[]char = ir.CollectIfaceIdSyms(mod)
	for i := 0; i < len(syms); i++ {
		common.EmitDataGlobal(a, irdata.BuildIfaceId(symPrefixed(syms[i])))
	}
}

// emitSatEntriesNative emits one weak `__satentry.<T,J>` record per (T, J) in
// mod.Impls (ir.CollectSatEntries), object-format prefixed — the distributed
// interface-satisfaction registry (spec §11.12 `iface.rtti`).  Each records
// `{&TypeInfo(T), &IfaceId(J), &__ivt.<T>__<J>}`; all four symbols (its own +
// the three referents) go through symPrefixed, matching def+ref.
func emitSatEntriesNative(a @asm.Assembler, mod @ir.Module) {
	var descs @[]@irdata.SatEntryDesc = ir.CollectSatEntries(mod)
	for i := 0; i < len(descs); i++ {
		var pd @irdata.SatEntryDesc = make(irdata.SatEntryDesc)
		pd.Sym = symPrefixed(descs[i].Sym)
		pd.TypeInfoSym = symPrefixed(descs[i].TypeInfoSym)
		pd.IfaceIdSym = symPrefixed(descs[i].IfaceIdSym)
		pd.SubvtabSym = symPrefixed(descs[i].SubvtabSym)
		common.EmitDataGlobal(a, irdata.BuildSatEntry(common.STATIC_MANAGED_REFCOUNT, pd))
	}
}
