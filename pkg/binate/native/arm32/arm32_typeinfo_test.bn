package "pkg/binate/native/arm32"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/builtins/testing"

// Tests for per-type / per-iface / per-(type,iface) RTTI record emission in
// arm32_typeinfo.bn (emitTypeInfosNative / emitIfaceIdsNative /
// emitSatEntriesNative).  genFromSrcIface / ifaceMkAssembler /
// relroSectionBytesIface / setArm32TargetIface are shared helpers from the
// sibling arm32_iface_test.bn (same package).  The record's exact byte layout is
// covered on the LLVM side (emit_impls_test.bn); here we pin the native-specific
// section placement (mirroring aarch64_typeinfo_test.bn / x64_typeinfo_test.bn),
// with the ILP32 word size (4 bytes): a TypeInfo / SatEntry record is 5 words ×
// 4 = 20 bytes here (vs 40 on 64-bit), the reloc-bearing records land in
// "rodata_relro", and reloc-free blobs / markers land in plain "rodata".

// rodataSectionBytesIface returns the byte count of the plain read-only "rodata"
// section (reloc-free blobs — e.g. the TypeInfo name blob, IfaceId markers); 0 if
// none was emitted.  Sibling of relroSectionBytesIface.
func rodataSectionBytesIface(a @asm.Assembler) int {
	for i := 0; i < a.NumSections; i++ {
		if charEqArm32(a.Sections[i].Name, "rodata") {
			return a.Sections[i].Len
		}
	}
	return 0
}

// A boxable struct's 8-word record (32 bytes on ILP32) bears name-pointer +
// field-table relocations, so it lands in "rodata_relro"; so does its 8-word
// field-table blob (32 bytes, field-name relocations).  The reloc-free name /
// field-name blobs land in plain "rodata".
func TestEmitTypeInfoNativeRecordInRelroWithNameBlob() testing.TestResult {
	setArm32TargetIface()
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() }\n"
			"type T struct { x int }\n"
			"func (t *T) foo() { }\n"
			"impl *T : I\n"
			"func main() { }\n"
	var mod @ir.Module = genFromSrcIface(src)

	var a @asm.Assembler = ifaceMkAssembler()
	emitTypeInfosNative(a, "main", mod)
	if relroSectionBytesIface(a) != 64 {
		return fail(
				"the TypeInfo record (32 bytes on ILP32) plus its field-table blob "
						"(32 bytes, one-field struct) should land in rodata_relro")
	}
	if rodataSectionBytesIface(a) == 0 {
		return fail("the TypeInfo name blob should land in rodata (a non-empty name)")
	}
	return ""
}

// A type that needs destruction (a managed `@Inner` field) additionally carries
// a word-0 dtor-handle relocation; the record (32 bytes on ILP32) plus its
// field-table blob (32 bytes) are relro, with the name blob in rodata.  The
// `@Inner` field is a pointer field, so P4b-2 also force-emits the pointee Inner's
// own record + field-table (another 32+32) into relro.
func TestEmitTypeInfoNativeDtorRecordInRelro() testing.TestResult {
	setArm32TargetIface()
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() int }\n"
			"type Inner struct { V int }\n"
			"type T struct { Inner @Inner }\n"
			"func (t *T) foo() int { return t.Inner.V }\n"
			"impl *T : I\n"
			"func main() { }\n"
	var mod @ir.Module = genFromSrcIface(src)

	var a @asm.Assembler = ifaceMkAssembler()
	emitTypeInfosNative(a, "main", mod)
	if relroSectionBytesIface(a) != 128 {
		return fail(
				"a managed-field type's TypeInfo record (32 bytes on ILP32; name + "
						"dtor + fields relocs) + its field-table blob (32 bytes), plus the "
						"force-emitted `@Inner` pointee's record (32) + field-table (32), "
						"should be 128 bytes in rodata_relro")
	}
	if rodataSectionBytesIface(a) == 0 {
		return fail("the TypeInfo name blob should land in rodata")
	}
	return ""
}

// emitIfaceIdsNative emits a weak 1-byte `__ifaceid.<J>` marker per canonical
// interface into plain rodata (reloc-free — only the address matters).  The
// declared I's marker symbol is defined (bare on ELF); nothing lands in relro.
func TestEmitIfaceIdNativeMarker() testing.TestResult {
	setArm32TargetIface()
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() }\n"
			"type T struct { x int }\n"
			"func (t *T) foo() { }\n"
			"impl *T : I\n"
			"func main() { }\n"
	var mod @ir.Module = genFromSrcIface(src)

	var a @asm.Assembler = ifaceMkAssembler()
	emitIfaceIdsNative(a, mod)
	if a.LookupSymbol("__ifaceid.bn_S1_4_main1_1_I") < 0 {
		return fail("expected the __ifaceid marker symbol for interface I")
	}
	if rodataSectionBytesIface(a) == 0 {
		return fail("IfaceId markers should land in rodata")
	}
	if relroSectionBytesIface(a) != 0 {
		return fail("IfaceId markers are reloc-free (nothing in rodata_relro)")
	}
	return ""
}

// emitSatEntriesNative emits one weak `__satentry.<T,J>` record per (T, J) in
// m.Impls: a 36-byte node on ILP32 (2-word header + 3 payload symrefs + 2
// {data,len} symbol-name slices = 9 words × 4 → all relro) plus two reloc-free
// symbol-name blobs in plain rodata.  For a non-extending `impl *T : I` there is
// one entry; its symbol (bare on ELF) is defined.
func TestEmitSatEntryNative() testing.TestResult {
	setArm32TargetIface()
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() }\n"
			"type T struct { x int }\n"
			"func (t *T) foo() { }\n"
			"impl *T : I\n"
			"func main() { }\n"
	var mod @ir.Module = genFromSrcIface(src)

	var a @asm.Assembler = ifaceMkAssembler()
	emitSatEntriesNative(a, mod)
	if a.LookupSymbol("__satentry.bn_V1_4_main1_T1_4_main1_I") < 0 {
		return fail("expected the __satentry symbol for (T,I)")
	}
	if relroSectionBytesIface(a) != 36 {
		return fail(
				"one (T,I) satisfaction-entry node (header + 3 payload symrefs + "
						"2 sym-name slices) should be 36 bytes in rodata_relro (ILP32)")
	}
	if rodataSectionBytesIface(a) == 0 {
		return fail("the two symbol-name blobs (TypeSym/IfaceSym) should land in plain rodata")
	}
	return ""
}
