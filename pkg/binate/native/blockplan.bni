// Package blockplan is the block layout of the native backends: the modes that
// pick how a function's blocks are laid out (bnc -fnative-block-layout), the plan
// of one function's blocks that common.EmitObject makes under a mode and hands
// each backend's ArchEmitter.EmitFunc, and the checks a backend makes of a plan
// and of the end of each block it emits.
package "pkg/binate/native/blockplan"

import "pkg/binate/asm"
import "pkg/binate/ir"

// BLOCK_LAYOUT_SOURCE, the default block-layout mode (bnc
// -fnative-block-layout=source), lays a function's blocks out in IR order, each
// ending in an explicit branch, return or trap.
const BLOCK_LAYOUT_SOURCE int = 0

// BLOCK_LAYOUT_FALLTHROUGH (bnc -fnative-block-layout=fallthrough) keeps the IR
// order and lets a backend drop the branch from a block to the block laid out right
// after it, so that control falls through (BlockPlan.FallThrough).
const BLOCK_LAYOUT_FALLTHROUGH int = 1

// BlockLayoutByName returns the block-layout mode named name ("source" or
// "fallthrough"), or -1 when no mode has that name.
func BlockLayoutByName(name *[]readonly char) int

// BlockLayoutName returns the name of block-layout mode mode (the inverse of
// BlockLayoutByName), or "" when mode is not a block-layout mode.
func BlockLayoutName(mode int) *[]readonly char

// BlockLayoutCheck validates block-layout mode mode: "" when it is one, otherwise
// the reason.  common.EmitObject fails with the reason before emitting anything.
func BlockLayoutCheck(mode int) @[]readonly char

// BlockPlan is the layout of one function's blocks that common.EmitObject hands
// common.ArchEmitter.EmitFunc (PlanBlocks makes it).
//   - Order lists the indices into f.Blocks in the order the blocks are emitted:
//     every block once, the entry block (0) first, since the function's code
//     starts with it.
//   - AlignTop, indexed by block, marks the blocks a backend that aligns loops
//     pads to its loop boundary.  It is empty in a plan made for a backend that
//     aligns none (common.ArchEmitter.AlignsLoops).
//   - FallThrough lets the backend end a block whose successor is laid out right
//     after it without a branch to that successor, so that control falls through.
type BlockPlan struct {
	Order       @[]int
	AlignTop    @[]bool
	FallThrough bool
}

// PlanBlocks returns f's BlockPlan under block-layout mode mode, or nil when mode
// is not a block-layout mode.  Both modes keep the IR order; FallThrough is set
// only under BLOCK_LAYOUT_FALLTHROUGH.  With alignLoops, AlignTop marks f's loop
// headers (iropt.ComputeLoopHeaders); without it AlignTop is empty and the loop
// analysis does not run.  f is phi-free, as common.EmitObject hands it to EmitFunc.
func PlanBlocks(f @ir.Func, mode int, alignLoops bool) @BlockPlan

// CheckBlockPlan reports whether plan is a layout of f's blocks a backend can
// emit: a plan whose Order lists every block once, the entry block first, and
// whose AlignTop, when alignLoops, has an entry for every block.  Otherwise it
// sets an error on a naming f, and returns false.
func CheckBlockPlan(a @asm.Assembler, f @ir.Func, plan @BlockPlan, alignLoops bool) bool

// PlanNext returns the block that the block at position k of plan.Order may fall
// through into: the next one in Order when plan.FallThrough is set, and nil when it
// is not or when k is the last position.
func PlanNext(f @ir.Func, plan @BlockPlan, k int) @ir.Block

// CheckBlockEnd sets an error on a when block b of f ends wrongly, which a backend
// checks at the end of every block, before anything it places between blocks
// (such as a branch island):
//   - when code was emitted in b after its terminator, which ended at offset termEnd
//     of the current section.  Were control to fall through into the next block
//     that code would run on one path only, and after a branch it would never run.
//   - when the terminator lets control fall through (endedInTransfer is false)
//     and no block is laid out after b to fall into (next is nil).
func CheckBlockEnd(a @asm.Assembler, f @ir.Func, b @ir.Block, termEnd uint, endedInTransfer bool,
		next @ir.Block)
