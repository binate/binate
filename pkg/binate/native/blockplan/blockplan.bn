package "pkg/binate/native/blockplan"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropt"
import "pkg/std/strconv"

// BlockLayoutByName — see blockplan.bni.
func BlockLayoutByName(name *[]readonly char) int {
	for mode := BLOCK_LAYOUT_SOURCE; mode <= BLOCK_LAYOUT_FALLTHROUGH; mode++ {
		if nameEq(name, BlockLayoutName(mode)) { return mode }
	}
	return -1
}

// nameEq reports whether a and b hold the same characters.
func nameEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// BlockLayoutName — see blockplan.bni.
func BlockLayoutName(mode int) *[]readonly char {
	if mode == BLOCK_LAYOUT_SOURCE { return "source" }
	if mode == BLOCK_LAYOUT_FALLTHROUGH { return "fallthrough" }
	return ""
}

// BlockLayoutCheck — see blockplan.bni.
func BlockLayoutCheck(mode int) @[]readonly char {
	if len(BlockLayoutName(mode)) > 0 { return "" }
	return buf.Concat("block layout: unknown mode ", strconv.Itoa(mode))
}

// PlanBlocks — see blockplan.bni.
func PlanBlocks(f @ir.Func, mode int, alignLoops bool) @BlockPlan {
	if len(BlockLayoutName(mode)) == 0 {
		var none @BlockPlan
		return none
	}
	var plan @BlockPlan = make(BlockPlan)
	plan.Order = make_slice(int, len(f.Blocks))
	for bi := 0; bi < len(f.Blocks); bi++ { plan.Order[bi] = bi }
	if alignLoops { plan.AlignTop = iropt.ComputeLoopHeaders(f) }
	plan.FallThrough = mode == BLOCK_LAYOUT_FALLTHROUGH
	return plan
}

// CheckBlockPlan — see blockplan.bni.
func CheckBlockPlan(a @asm.Assembler, f @ir.Func, plan @BlockPlan, alignLoops bool) bool {
	var why *[]readonly char = blockPlanProblem(f, plan, alignLoops)
	if len(why) == 0 { return true }
	a.SetError(buf.Concat(buf.Concat(buf.Concat("native: function ", f.Name), ": "), why))
	return false
}

// blockPlanProblem returns what is wrong with plan as a layout of f's blocks
// (CheckBlockPlan), or "" when nothing is.
func blockPlanProblem(f @ir.Func, plan @BlockPlan, alignLoops bool) *[]readonly char {
	if plan == nil { return "no block plan" }
	var n int = len(f.Blocks)
	if len(plan.Order) != n { return "the block plan's order does not list every block once" }
	if n > 0 && plan.Order[0] != 0 { return "the block plan does not start with the entry block" }
	var seen @[]bool = make_slice(bool, n)
	for k := 0; k < n; k++ {
		var bi int = plan.Order[k]
		if bi < 0 || bi >= n || seen[bi] {
			return "the block plan's order does not list every block once"
		}
		seen[bi] = true
	}
	if alignLoops && len(plan.AlignTop) != n { return "the block plan does not mark loop tops" }
	return ""
}

// PlanNext — see blockplan.bni.
func PlanNext(f @ir.Func, plan @BlockPlan, k int) @ir.Block {
	var none @ir.Block
	if !plan.FallThrough || k + 1 >= len(plan.Order) { return none }
	return f.Blocks[plan.Order[k + 1]]
}

// CheckBlockEnd — see blockplan.bni.
func CheckBlockEnd(a @asm.Assembler, f @ir.Func, b @ir.Block, termEnd uint, endedInTransfer bool,
		next @ir.Block) {
	if a.CurrentOffset() != termEnd {
		a.SetError(blockEndMessage(f, b, ": code was emitted after the block's terminator"))
		return
	}
	if !endedInTransfer && next == nil {
		a.SetError(blockEndMessage(f, b, ": the block falls through, but no block is laid out after it"))
	}
}

// blockEndMessage returns a CheckBlockEnd error for block b of f: what names the
// problem.
func blockEndMessage(f @ir.Func, b @ir.Block, what *[]readonly char) @[]char {
	var msg @[]char = buf.Concat(buf.Concat("native: function ", f.Name), ", block ")
	return buf.Concat(buf.Concat(msg, b.Label), what)
}
