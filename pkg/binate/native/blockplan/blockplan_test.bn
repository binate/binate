package "pkg/binate/native/blockplan"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropt"
import "pkg/binate/types"
import "pkg/builtins/testing"

// The layout modes, PlanBlocks, and the checks a backend makes of a plan and of
// each block's end.  EmitObject's use of the plan is tested in package common.

// setTarget64 pins types' live target to the LP64 configuration the IR below is
// built for.
func setTarget64() {
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	types.SetTarget(t)
}

// planLoopFunc builds `entry -> header; header: branch body, exit; body -> header;
// exit: return`, whose one loop header is block 1.
func planLoopFunc() @ir.Func {
	var params @[]@ir.Param
	var results @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.loop", params, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	irbuild.EmitJump(entry, header)
	irbuild.EmitBranch(header, irbuild.EmitConstBool(header, false), body, exit)
	irbuild.EmitJump(body, header)
	var none @[]@ir.Instr
	irbuild.EmitReturn(exit, none)
	return f
}

// planIsIdentity reports whether plan's Order lists f's blocks in IR order.
func planIsIdentity(f @ir.Func, plan @BlockPlan) bool {
	if len(plan.Order) != len(f.Blocks) { return false }
	for k := 0; k < len(plan.Order); k++ {
		if plan.Order[k] != k { return false }
	}
	return true
}

// planAlignsHeaders reports whether plan's AlignTop marks exactly f's loop headers.
func planAlignsHeaders(f @ir.Func, plan @BlockPlan) bool {
	var headers @[]bool = iropt.ComputeLoopHeaders(f)
	if len(plan.AlignTop) != len(headers) { return false }
	for bi := 0; bi < len(headers); bi++ {
		if plan.AlignTop[bi] != headers[bi] { return false }
	}
	return true
}

// A mode's name maps to the mode and back; a name or a mode that is not one is
// reported, not mapped to a default.
func TestBlockLayoutNames() testing.TestResult {
	if BlockLayoutByName("source") != BLOCK_LAYOUT_SOURCE { return "\"source\" must name SOURCE" }
	if BlockLayoutByName("fallthrough") != BLOCK_LAYOUT_FALLTHROUGH {
		return "\"fallthrough\" must name FALLTHROUGH"
	}
	if BLOCK_LAYOUT_SOURCE != 0 { return "SOURCE must be 0, the zero value of a layout" }
	var bad @[]@[]char = @[]@[]char{"", "Source", "fall", "fallthroughx", "loops"}
	for i := 0; i < len(bad); i++ {
		if BlockLayoutByName(bad[i]) != -1 { return "an unknown name must give -1" }
	}
	if !nameEq(BlockLayoutName(BLOCK_LAYOUT_SOURCE), "source") { return "SOURCE is \"source\"" }
	if !nameEq(BlockLayoutName(BLOCK_LAYOUT_FALLTHROUGH), "fallthrough") {
		return "FALLTHROUGH is \"fallthrough\""
	}
	if len(BlockLayoutName(-1)) != 0 || len(BlockLayoutName(BLOCK_LAYOUT_FALLTHROUGH + 1)) != 0 {
		return "a mode that is not one must have no name"
	}
	return ""
}

// BlockLayoutCheck passes each mode and gives a reason for anything else.
func TestBlockLayoutCheck() testing.TestResult {
	if len(BlockLayoutCheck(BLOCK_LAYOUT_SOURCE)) != 0 { return "SOURCE must pass" }
	if len(BlockLayoutCheck(BLOCK_LAYOUT_FALLTHROUGH)) != 0 { return "FALLTHROUGH must pass" }
	var bad @[]int = @[]int{-1, BLOCK_LAYOUT_FALLTHROUGH + 1, 99}
	for i := 0; i < len(bad); i++ {
		if len(BlockLayoutCheck(bad[i])) == 0 { return "a mode that is not one must fail" }
	}
	return ""
}

// SOURCE keeps the IR order and never falls through; AlignTop marks the loop
// headers only when a backend aligns loops.
func TestPlanBlocksSource() testing.TestResult {
	setTarget64()
	var f @ir.Func = planLoopFunc()
	var plan @BlockPlan = PlanBlocks(f, BLOCK_LAYOUT_SOURCE, false)
	if plan == nil { return "SOURCE must give a plan" }
	if !planIsIdentity(f, plan) { return "SOURCE must keep the IR order" }
	if plan.FallThrough { return "SOURCE must not fall through" }
	if len(plan.AlignTop) != 0 { return "a backend that does not align loops gets no AlignTop" }
	var aligned @BlockPlan = PlanBlocks(f, BLOCK_LAYOUT_SOURCE, true)
	if !planIsIdentity(f, aligned) || aligned.FallThrough {
		return "alignLoops must not change the rest"
	}
	if !planAlignsHeaders(f, aligned) { return "AlignTop must mark the loop headers" }
	if !aligned.AlignTop[1] { return "the loop header is block 1" }
	return ""
}

// FALLTHROUGH keeps the IR order and falls through.
func TestPlanBlocksFallThrough() testing.TestResult {
	setTarget64()
	var f @ir.Func = planLoopFunc()
	var plan @BlockPlan = PlanBlocks(f, BLOCK_LAYOUT_FALLTHROUGH, false)
	if plan == nil { return "FALLTHROUGH must give a plan" }
	if !planIsIdentity(f, plan) { return "FALLTHROUGH must keep the IR order" }
	if !plan.FallThrough { return "FALLTHROUGH must fall through" }
	if len(plan.AlignTop) != 0 { return "a backend that does not align loops gets no AlignTop" }
	var aligned @BlockPlan = PlanBlocks(f, BLOCK_LAYOUT_FALLTHROUGH, true)
	if !planIsIdentity(f, aligned) || !aligned.FallThrough {
		return "alignLoops must not change the rest"
	}
	if !planAlignsHeaders(f, aligned) { return "AlignTop must mark the loop headers" }
	return ""
}

// A mode that is not a block-layout mode gives no plan.
func TestPlanBlocksUnknownMode() testing.TestResult {
	setTarget64()
	if PlanBlocks(planLoopFunc(), -1, false) != nil { return "mode -1 must give no plan" }
	if PlanBlocks(planLoopFunc(), BLOCK_LAYOUT_FALLTHROUGH + 1, true) != nil {
		return "an unknown mode must give no plan"
	}
	return ""
}

// planRejected reports whether CheckBlockPlan rejects plan for f, setting an error.
func planRejected(f @ir.Func, plan @BlockPlan, alignLoops bool) bool {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	if CheckBlockPlan(a, f, plan, alignLoops) { return false }
	return a.HasError
}

// planWithOrder returns a SOURCE plan of f with order as its Order.
func planWithOrder(f @ir.Func, order @[]int) @BlockPlan {
	var plan @BlockPlan = PlanBlocks(f, BLOCK_LAYOUT_SOURCE, false)
	plan.Order = order
	return plan
}

// CheckBlockPlan accepts a plan that lists every block once, entry first (and marks
// loop tops when the backend aligns loops), and rejects anything else.
func TestCheckBlockPlan() testing.TestResult {
	setTarget64()
	var f @ir.Func = planLoopFunc()
	var a @asm.Assembler = asm.New(8)
	if !CheckBlockPlan(a, f, PlanBlocks(f, BLOCK_LAYOUT_SOURCE, false), false) || a.HasError {
		return "a SOURCE plan must pass"
	}
	if !CheckBlockPlan(a, f, PlanBlocks(f, BLOCK_LAYOUT_FALLTHROUGH, true), true) || a.HasError {
		return "a FALLTHROUGH plan with AlignTop must pass a backend that aligns loops"
	}
	if !CheckBlockPlan(a, f, planWithOrder(f, @[]int{0, 3, 1, 2}), false) || a.HasError {
		return "any permutation that starts with the entry must pass"
	}
	var none @BlockPlan
	if !planRejected(f, none, false) { return "no plan must be rejected" }
	if !planRejected(f, planWithOrder(f, @[]int{0, 1, 2}), false) { return "a short Order must fail" }
	if !planRejected(f, planWithOrder(f, @[]int{0, 1, 2, 3, 3}), false) {
		return "a long Order must fail"
	}
	if !planRejected(f, planWithOrder(f, @[]int{1, 0, 2, 3}), false) {
		return "an Order that does not start with the entry must fail"
	}
	if !planRejected(f, planWithOrder(f, @[]int{0, 1, 1, 3}), false) {
		return "an Order that repeats a block must fail"
	}
	if !planRejected(f, planWithOrder(f, @[]int{0, 1, 2, 4}), false) ||
			!planRejected(f, planWithOrder(f, @[]int{0, 1, 2, -1}), false) {
		return "an Order naming no block must fail"
	}
	if !planRejected(f, PlanBlocks(f, BLOCK_LAYOUT_SOURCE, false), true) {
		return "a plan without AlignTop must fail a backend that aligns loops"
	}
	return ""
}

// PlanNext is the block laid out next only when the plan falls through.
func TestPlanNext() testing.TestResult {
	setTarget64()
	var f @ir.Func = planLoopFunc()
	var src @BlockPlan = PlanBlocks(f, BLOCK_LAYOUT_SOURCE, false)
	for k := 0; k < len(src.Order); k++ {
		if PlanNext(f, src, k) != nil { return "SOURCE must give no next block" }
	}
	var ft @BlockPlan = planWithOrder(f, @[]int{0, 2, 3, 1})
	ft.FallThrough = true
	if PlanNext(f, ft, 0) != f.Blocks[2] { return "the entry's next block must be Order[1]" }
	if PlanNext(f, ft, 1) != f.Blocks[3] || PlanNext(f, ft, 2) != f.Blocks[1] {
		return "each block's next block must be the one after it in Order"
	}
	if PlanNext(f, ft, 3) != nil { return "the last block must have no next block" }
	return ""
}

// blockEndFails runs CheckBlockEnd on a block whose terminator ended `after` bytes
// before the block's end, and reports whether it set an error.
func blockEndFails(after int, endedInTransfer bool, next @ir.Block) bool {
	var f @ir.Func = planLoopFunc()
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.Fill(8, 0x90)
	var termEnd uint = a.CurrentOffset()
	if after > 0 { a.Fill(after, 0x90) }
	CheckBlockEnd(a, f, f.Blocks[1], termEnd, endedInTransfer, next)
	return a.HasError
}

// CheckBlockEnd fails a block with code after its terminator, whether or not the
// terminator falls through, and a block that falls through with no block after it.
func TestCheckBlockEnd() testing.TestResult {
	setTarget64()
	var next @ir.Block = planLoopFunc().Blocks[2]
	var none @ir.Block
	if blockEndFails(0, true, none) || blockEndFails(0, true, next) {
		return "a block ending at its transfer must pass"
	}
	if blockEndFails(0, false, next) { return "a block falling through into the next must pass" }
	if !blockEndFails(4, true, none) || !blockEndFails(1, true, next) {
		return "code after a transfer must fail"
	}
	if !blockEndFails(4, false, next) { return "code after a fall-through must fail" }
	if !blockEndFails(0, false, none) { return "falling through into no block must fail" }
	return ""
}
