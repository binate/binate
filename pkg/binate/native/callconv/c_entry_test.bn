package "pkg/binate/native/callconv"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// cEntryFunc builds a void function whose parameters have the given types.
func cEntryFunc(paramTypes @[]@types.Type) @ir.Func {
	var ps @[]@ir.Param = make_slice(@ir.Param, len(paramTypes))
	for i := 0; i < len(paramTypes); i++ {
		var p @ir.Param = make(ir.Param)
		p.Typ = paramTypes[i]
		ps[i] = p
	}
	return ir.NewFunc("", "main.f", ps, makeNoResults())
}

// A narrow integer passed in a register needs the adaptation thunk, which
// re-extends that register: CEntryRegNormWalk reports it (GP register 0) and
// its type.
func TestCEntryNarrowRegParamWalk() testing.TestResult {
	setTarget64()
	var pt @[]@types.Type = make_slice(@types.Type, 1)
	pt[0] = types.TypInt8()
	var f @ir.Func = cEntryFunc(pt)
	var cc CallConv = SysV_AMD64()
	if !cc.CEntryNeedsThunk(f) { return "a narrow register parameter needs a thunk" }
	var regs @[]int
	var tys @[]@types.Type
	regs, tys = CEntryRegNormWalk(f, cc)
	if len(regs) != 1 || regs[0] != 0 || len(tys) != 1 || tys[0] != pt[0] {
		return "the walk should report GP register 0 with the int8 type"
	}
	return ""
}

// Word-size and float parameters need no adaptation.
func TestCEntryWordAndFloatParamsNoThunk() testing.TestResult {
	setTarget64()
	var pt @[]@types.Type = make_slice(@types.Type, 2)
	pt[0] = types.TypInt()
	pt[1] = types.TypFloat64()
	var f @ir.Func = cEntryFunc(pt)
	var cc CallConv = SysV_AMD64()
	if cc.CEntryNeedsThunk(f) { return "word-size and float parameters need no thunk" }
	var regs @[]int
	var tys @[]@types.Type
	regs, tys = CEntryRegNormWalk(f, cc)
	if len(regs) != 0 || len(tys) != 0 { return "the walk should report nothing" }
	return ""
}

// A narrow parameter after a word-size one is reported at its own register.
func TestCEntryWalkRegisterIndex() testing.TestResult {
	setTarget64()
	var pt @[]@types.Type = make_slice(@types.Type, 2)
	pt[0] = types.TypInt()
	pt[1] = types.TypInt16()
	var f @ir.Func = cEntryFunc(pt)
	var regs @[]int
	var tys @[]@types.Type
	regs, tys = CEntryRegNormWalk(f, SysV_AMD64())
	if len(regs) != 1 || regs[0] != 1 || tys[0] != pt[1] {
		return "the int16 parameter should be reported at GP register 1"
	}
	return ""
}
