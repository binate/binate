package "pkg/binate/native/callconv"

import "pkg/binate/types"

// argWords returns the word count of an argument of type t in
// wordBytes-sized words: ceil(SizeOf(t) / wordBytes).  The unified core of
// both the free ArgWords (LP64) and the cc.ArgWords method
// (target-parameterised).  A scalar's SizeOf is in [1, 8], so on LP64
// (wordBytes 8) every scalar rounds to 1 word — matching the old
// scalar-is-1 special case — while on ILP32 (wordBytes 4) a 64-bit scalar
// is 2 words.  A nil type reports 1 (as the old ArgWords did for a
// non-aggregate), so callers threading an absent type don't fault.
//
// A ZERO-SIZE aggregate (`struct{}` / `[0]T`) reports 0 words: it carries
// no bytes, so it occupies no register and no stack — matching LLVM, which
// passes a zero-size struct by value in zero registers/stack.  This must NOT
// be clamped up to 1: doing so made a by-value zero-size argument (e.g. a
// method receiver of type `struct{}` fetched from a slice element) consume a
// word that the caller filled from the uninitialized value slot and the
// callee then dereferenced — a SIGSEGV (conformance/1029).  Because both the
// placement classifier (argRegWordsStackWords) and the per-arg emit loops
// read argWords, 0 keeps caller, callee, and shims consistent: nothing is
// placed and no cursor advances.
func argWords(t @types.Type, wordBytes int) int {
	if t == nil { return 1 }
	var sz int = t.SizeOf()
	return (sz + wordBytes - 1) / wordBytes
}

// ArgWords is the LP64 (8-byte-word) argument word count, retained for the
// aarch64 / x64 backend call sites (both LP64).  The target-parameterised
// form is the cc.ArgWords method.  Scalars (and managed/raw pointers) are
// 1; aggregates are SizeOf(t) / 8 rounded up to at least 1.
func ArgWords(t @types.Type) int {
	return argWords(t, 8)
}

// ArgWords (CallConv method) is the target-parameterised argument word
// count, rounding in cc.WordBytes-sized words (see callconv.bni).  On
// AAPCS32 (WordBytes 4) a 64-bit scalar is 2 words and a 16-byte
// managed-slice is 4; on LP64 it agrees with the free ArgWords.
func (cc CallConv) ArgWords(t @types.Type) int {
	return argWords(t, cc.WordBytes)
}

// argNeeds8Align reports whether t requires 8-byte (double-word)
// alignment for argument placement — a 64-bit fundamental type (int64 /
// uint64 / float64) or an aggregate whose alignment is 8.  Drives the
// AAPCS32 even-register-pair and 8-byte stack-slot rules (AAPCS §6.5
// stage C.3); on LP64, where every argument is already 8-aligned, it is
// inert.
func argNeeds8Align(t @types.Type) bool {
	if t == nil { return false }
	return t.AlignOf() >= 8
}

// NeedsEvenReg reports whether arg t obeys the AAPCS §6.5 stage C.3
// even-register-pair rule under this convention: an 8-byte-aligned argument
// (int64 / uint64 / float64 or an 8-aligned aggregate) on an ILP32 convention
// (WordBytes < 8) must start on an EVEN core register, so a placement cursor at
// an ODD index wastes the odd register.  On LP64 (WordBytes 8), where every
// argument is already 8-aligned relative to an 8-byte word, no pad ever applies
// and this is always false.  This is the single source of truth for the
// even-pair condition: argRegWordsStackWords applies it to the DISPATCH cursor,
// and a func-value shim's arg marshal applies the same test to its OUTGOING GP
// cursor so the shim ↔ callee register placement stays byte-identical.
func (cc CallConv) NeedsEvenReg(t @types.Type) bool {
	return cc.WordBytes < 8 && argNeeds8Align(t)
}
