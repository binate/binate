package "pkg/binate/native/callconv"

import "pkg/binate/types"
import "pkg/builtins/testing"

// AAPCS64 never splits an aggregate between the GP argument registers and the stack
// (C.12-C.13): one that does not fit the registers left goes wholly to the stack and
// closes them, as clang and LLVM's `[N x i64]` lowering place it.  Also cross-checks
// types.Aapcs64ArgGpStart (the codegen-side walk) against this package's AAPCS64 walk.

// aaSevenThen builds [i64 x7, x, i64]: x arrives with only x7 left.
func aaSevenThen(x @types.Type) @[]@types.Type {
	var s @[]@types.Type = make_slice(@types.Type, 9)
	for i := 0; i < 7; i++ { s[i] = types.TypInt64() }
	s[7] = x
	s[8] = types.TypInt64()
	return s
}

// A 16-byte struct or a raw slice arriving with only x7 left goes wholly to [sp, #0]
// and the trailing int64 to [sp, #16]; x7 stays unused.
func TestAapcs64AggregateDoesNotSplit() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	defer types.SetArch(types.ARCH_UNKNOWN)
	var cc CallConv = AAPCS64()
	var i64 @types.Type = types.TypInt64()
	var kinds @[]@types.Type = make_slice(@types.Type, 2)
	kinds[0] = amStruct2("I2", i64, i64)
	kinds[1] = types.MakeSliceType(i64)
	for k := 0; k < 2; k++ {
		var ts @[]@types.Type = aaSevenThen(kinds[k])
		if cc.CallArgRegStart(ts, 7) != -1 { return "the 16-byte aggregate must not take x7" }
		if cc.CallArgStackOff(ts, 7) != 0 { return "the 16-byte aggregate goes wholly to [sp, #0]" }
		if cc.CallArgRegStart(ts, 8) != -1 || cc.CallArgStackOff(ts, 8) != 16 {
			return "the trailing int64 follows at [sp, #16] (x7 closed)"
		}
		if cc.CallStackBytes(ts) != 32 { return "24 stack bytes, rounded to 32" }
	}
	return ""
}

// TestAapcs64GpStartMatchesNativeWalk pins types.Aapcs64ArgGpStart against
// AAPCS64().CallArgRegStart for every argument of a battery of signatures: GP
// straddles of each aggregate kind, floats and HFAs between them, >16-byte pointers,
// and empty aggregates (which take no register but keep their position).
func TestAapcs64GpStartMatchesNativeWalk() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	defer types.SetArch(types.ARCH_UNKNOWN)
	var cc CallConv = AAPCS64()
	var i64 @types.Type = types.TypInt64()
	var f64 @types.Type = types.TypFloat64()
	var noFields @[]@types.Field
	var empty @types.Type = types.MakeStructType("Empty", noFields)
	var sigs @[]@[]@types.Type = make_slice(@[]@types.Type, 8)
	sigs[0] = aaSevenThen(amStruct2("I2", i64, i64))
	sigs[1] = aaSevenThen(types.MakeSliceType(i64))
	sigs[2] = aaSevenThen(types.MakeInterfaceValueType(types.MakeInterfaceType("m", "Iface")))
	sigs[3] = aaSevenThen(amStruct3("Big24", i64, i64, i64))
	sigs[4] = aaSevenThen(amStruct2("F2", f64, f64))
	sigs[5] = aaSevenThen(types.MakeManagedSliceType(i64))
	var mixed @[]@types.Type = make_slice(@types.Type, 8)
	mixed[0] = f64
	mixed[1] = amStruct2("I2", i64, i64)
	mixed[2] = i64
	mixed[3] = f64
	mixed[4] = types.MakeSliceType(i64)
	mixed[5] = amStruct2("F2", f64, f64)
	mixed[6] = amStruct2("I2", i64, i64)
	mixed[7] = i64
	sigs[6] = mixed
	var withEmpty @[]@types.Type = aaSevenThen(empty)
	withEmpty[0] = empty
	sigs[7] = withEmpty
	for s := 0; s < len(sigs); s++ {
		for i := 0; i < len(sigs[s]); i++ {
			if types.Aapcs64ArgGpStart(sigs[s], i) != cc.CallArgRegStart(sigs[s], i) {
				return "types.Aapcs64ArgGpStart disagrees with the native AAPCS64 walk"
			}
		}
	}
	return ""
}
