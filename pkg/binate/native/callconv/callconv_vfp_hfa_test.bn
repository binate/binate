package "pkg/binate/native/callconv"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for homogeneous float aggregates (HFAs) in the AAPCS-VFP allocator
// (callconv_vfp.bn): with cc.HfaAggregates set, an HFA is one co-processor register
// candidate — n float32 members the lowest run of n free S registers, n float64
// members the lowest run of n free D registers — never split, and past the bank it
// goes to the stack and latches it; in a variadic call it is a GP aggregate (the base
// standard).  AAPCS32 hard-float sets HfaAggregates; the controls turn it off
// (vfpHfaOffCC) to pin the GP placement a CallConv without HFA passing gives.

// vfpHfaTestCC is the arm32 hard-float CallConv, which passes HFAs in VFP registers
// (TestAAPCS32HardFloatGated pins that).
func vfpHfaTestCC() CallConv { return vfpTestCC() }

// vfpHfaOffCC is the arm32 hard-float CallConv with HFA passing turned off.
func vfpHfaOffCC() CallConv {
	var cc CallConv = vfpTestCC()
	cc.HfaAggregates = false
	return cc
}

func hfaF(n int) @types.Type { return mkNamedStruct("F", tsN(types.TypFloat32(), n)) }

func hfaD(n int) @types.Type { return mkNamedStruct("D", tsN(types.TypFloat64(), n)) }

func ts4(a @types.Type, b @types.Type, c @types.Type, d @types.Type) @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, 4)
	r[0] = a
	r[1] = b
	r[2] = c
	r[3] = d
	return r
}

// An HFA alone starts at s0 / d0 and takes no core register or stack slot; the float
// after it takes the next register.
func TestVfpHfaAlone() testing.TestResult {
	var cc CallConv = vfpHfaTestCC()
	var f32 @types.Type = types.TypFloat32()
	var f64 @types.Type = types.TypFloat64()
	var a @[]@types.Type = ts2(hfaF(4), f32)
	r0, d0 := cc.CallArgFpReg(a, 0)
	r1, d1 := cc.CallArgFpReg(a, 1)
	if r0 != 0 || d0 || r1 != 4 || d1 {
		return "(F4, f32): F4 should take s0-s3 and the float32 s4"
	}
	if cc.CallArgRegStart(a, 0) != -1 || cc.CallArgStackOff(a, 0) != -1 {
		return "an in-register HFA takes no core register and no stack slot"
	}
	var b @[]@types.Type = ts2(hfaD(3), f64)
	q0, e0 := cc.CallArgFpReg(b, 0)
	q1, e1 := cc.CallArgFpReg(b, 1)
	if q0 != 0 || !e0 || q1 != 3 || !e1 {
		return "(D3, f64): D3 should take d0-d2 and the float64 d3"
	}
	return ""
}

// An HFA back-fills like a scalar, as one run: (f32, f64, F1) puts F1 in the s1 hole;
// (f32, f64, F2) cannot use the one-slot hole, so F2 takes s4-s5; (f32, D2, f32) puts
// D2 at d1-d2 and the second float32 back in s1.
func TestVfpHfaBackfill() testing.TestResult {
	var cc CallConv = vfpHfaTestCC()
	var f32 @types.Type = types.TypFloat32()
	var f64 @types.Type = types.TypFloat64()
	r, d := cc.CallArgFpReg(ts3(f32, f64, hfaF(1)), 2)
	if r != 1 || d { return "(f32, f64, F1): F1 should back-fill s1" }
	r, d = cc.CallArgFpReg(ts3(f32, f64, hfaF(2)), 2)
	if r != 4 || d { return "(f32, f64, F2): F2 should take s4-s5, not the one-slot s1 hole" }
	var c @[]@types.Type = ts3(f32, hfaD(2), f32)
	r, d = cc.CallArgFpReg(c, 1)
	if r != 1 || !d { return "(f32, D2, f32): D2 should take d1-d2" }
	r, d = cc.CallArgFpReg(c, 2)
	if r != 1 || d { return "(f32, D2, f32): the second float32 should back-fill s1" }
	return ""
}

// A float32 HFA needs no alignment beyond one S register: (f32, F2, f64) puts F2 at
// s1-s2 and the float64 at d2 (s4-s5); (f32, F4) puts F4 at s1-s4.
func TestVfpHfaFloat32Unaligned() testing.TestResult {
	var cc CallConv = vfpHfaTestCC()
	var f32 @types.Type = types.TypFloat32()
	var a @[]@types.Type = ts3(f32, hfaF(2), types.TypFloat64())
	r, d := cc.CallArgFpReg(a, 1)
	if r != 1 || d { return "(f32, F2, f64): F2 should take s1-s2" }
	r, d = cc.CallArgFpReg(a, 2)
	if r != 2 || !d { return "(f32, F2, f64): the float64 should take d2" }
	r, d = cc.CallArgFpReg(ts2(f32, hfaF(4)), 1)
	if r != 1 || d { return "(f32, F4): F4 should take s1-s4" }
	return ""
}

// Six float64s leave d6-d7: a three-float64 HFA does not fit, so it goes wholly to the
// stack (offset 0, 24 bytes, 8-aligned) and latches the bank — the float32 after it
// goes to the stack too (offset 24) although s12-s15 are free.
func TestVfpHfaOverflowLatch() testing.TestResult {
	var cc CallConv = vfpHfaTestCC()
	var ts @[]@types.Type = make_slice(@types.Type, 8)
	for k := 0; k < 6; k++ {
		ts[k] = types.TypFloat64()
	}
	ts[6] = hfaD(3)
	ts[7] = types.TypFloat32()
	r6, _ := cc.CallArgFpReg(ts, 6)
	r7, _ := cc.CallArgFpReg(ts, 7)
	if r6 != -1 || r7 != -1 { return "the overflowing HFA and the float after it ride no register" }
	if cc.CallArgRegStart(ts, 6) != -1 { return "an overflowing HFA takes no core register" }
	if cc.CallArgStackOff(ts, 6) != 0 { return "the overflowing HFA should be at stack offset 0" }
	if cc.CallArgStackOff(ts, 7) != 24 { return "the latched float32 should follow at offset 24" }
	if cc.CallStackBytes(ts) != 32 { return "28 stack bytes, rounded to the 8-byte stack alignment" }
	return ""
}

// floatsThen is n float32s followed by the types in tail.
func floatsThen(n int, tail @[]@types.Type) @[]@types.Type {
	var ts @[]@types.Type = make_slice(@types.Type, n + len(tail))
	for k := 0; k < n; k++ {
		ts[k] = types.TypFloat32()
	}
	for k := 0; k < len(tail); k++ {
		ts[n + k] = tail[k]
	}
	return ts
}

// Sixteen float32s fill the bank: an F1 after them goes to the stack at offset 0, and
// a D1 after that is 8-aligned at offset 8.  Fifteen float32s leave s15 free but no
// D register: the float64 goes to the stack and latches the bank, so the F1 after it
// goes to the stack too (offset 8) instead of back-filling s15.
func TestVfpHfaLatchAfterFullBank() testing.TestResult {
	var cc CallConv = vfpHfaTestCC()
	var a @[]@types.Type = floatsThen(16, ts2(hfaF(1), hfaD(1)))
	if cc.CallArgStackOff(a, 16) != 0 || cc.CallArgStackOff(a, 17) != 8 {
		return "16 float32s, F1, D1: F1 should be at stack offset 0 and D1 at 8"
	}
	if cc.CallStackBytes(a) != 16 { return "16 float32s, F1, D1: 16 stack bytes" }
	var b @[]@types.Type = floatsThen(15, ts2(types.TypFloat64(), hfaF(1)))
	r, _ := cc.CallArgFpReg(b, 16)
	if r != -1 { return "15 float32s, f64, F1: the latch must keep F1 out of s15" }
	if cc.CallArgStackOff(b, 15) != 0 || cc.CallArgStackOff(b, 16) != 8 {
		return "15 float32s, f64, F1: the float64 should be at stack offset 0 and F1 at 8"
	}
	return ""
}

// An HFA uses no core register: the int32 after one takes r0.  Once an HFA has gone to
// the stack, an integer struct that does not fit the core registers left goes wholly
// to the stack (no register / stack split, AAPCS32 C.5).
func TestVfpHfaCoreRegisters() testing.TestResult {
	var cc CallConv = vfpHfaTestCC()
	var i32 @types.Type = types.TypInt32()
	if cc.CallArgRegStart(ts2(hfaF(2), i32), 1) != 0 { return "(F2, int32): the int32 should take r0" }
	var g3 @types.Type = mkNamedStruct("G3", tsN(i32, 3))
	var ts @[]@types.Type = make_slice(@types.Type, 7)
	ts[0] = hfaD(4)
	ts[1] = hfaD(4)
	ts[2] = hfaD(2)
	ts[3] = i32
	ts[4] = i32
	ts[5] = i32
	ts[6] = g3
	r, d := cc.CallArgFpReg(ts, 1)
	if r != 4 || !d { return "the second D4 should take d4-d7" }
	if cc.CallArgStackOff(ts, 2) != 0 { return "the third HFA should overflow to stack offset 0" }
	if cc.CallArgRegStart(ts, 5) != 2 { return "the int32s should take r0-r2" }
	if cc.CallArgRegStart(ts, 6) != -1 || cc.CallArgStackOff(ts, 6) != 16 {
		return "after the HFA went to the stack, G3 must not split r3 / stack: wholly at offset 16"
	}
	return ""
}

// In a variadic call (the base standard) an HFA is a GP aggregate: (F2, int32) puts F2
// in r0-r1 and the int32 in r2; (int32, D2) starts the 8-aligned, 16-byte D2 on the
// even r2 and splits it: r2-r3, then 8 bytes on the stack.
func TestVfpHfaVariadicBaseStandard() testing.TestResult {
	var cc CallConv = vfpHfaTestCC()
	var i32 @types.Type = types.TypInt32()
	var a @[]@types.Type = ts2(hfaF(2), i32)
	if cc.CallArgRegStartV(a, 0, 1, true) != 0 || cc.CallArgRegStartV(a, 1, 1, true) != 2 {
		return "variadic (F2, int32): F2 should take r0-r1 and the int32 r2"
	}
	var b @[]@types.Type = ts2(i32, hfaD(2))
	if cc.CallArgRegStartV(b, 1, 1, true) != 2 {
		return "variadic (int32, D2): the 8-aligned D2 should start on the even r2"
	}
	if cc.CallArgStackOffV(b, 1, 1, true) != 0 || cc.CallStackBytesV(b, 1, true) != 8 {
		return "variadic (int32, D2): D2's last 8 bytes should be at stack offset 0"
	}
	return ""
}

// With HfaAggregates off an HFA is a GP aggregate: (F2, int32, F1) puts F2 in r0-r1,
// the int32 in r2, F1 in r3, and no HFA in a VFP register.
func TestVfpHfaOffIsGp() testing.TestResult {
	var cc CallConv = vfpHfaOffCC()
	var i32 @types.Type = types.TypInt32()
	var ts @[]@types.Type = ts3(hfaF(2), i32, hfaF(1))
	if cc.CallArgRegStart(ts, 0) != 0 || cc.CallArgRegStart(ts, 1) != 2 ||
			cc.CallArgRegStart(ts, 2) != 3 {
		return "with HFAs off, (F2, int32, F1) should take r0-r1, r2, r3"
	}
	r, _ := cc.CallArgFpReg(ts, 0)
	if r != -1 { return "with HFAs off, an HFA takes no VFP register" }
	var f32 @types.Type = types.TypFloat32()
	var u @[]@types.Type = ts4(f32, hfaF(1), f32, i32)
	q, _ := cc.CallArgFpReg(u, 2)
	if q != 1 { return "with HFAs off, the float32 after F1 takes s1 (F1 is in a core register)" }
	return ""
}

// A multi-value tuple's fields are placed as scalars even with HfaAggregates on: in
// (F2, f32) the F2 field takes GP words, so the float32 field is in s0 — where a call
// argument list of the same types would put it in s2.
func TestVfpHfaTupleFieldsAreScalar() testing.TestResult {
	var cc CallConv = vfpHfaTestCC()
	var fields @[]@types.Type = ts2(hfaF(2), types.TypFloat32())
	r, d := cc.CallArgFpReg(fields, 1)
	if r != 2 || d { return "as call arguments, (F2, f32) puts the float32 in s2" }
	r, d = cc.MultiReturnFieldFpReg(fields, 1)
	if r != 0 || d { return "as tuple fields, (F2, f32) puts the float32 in s0" }
	r, _ = cc.MultiReturnFieldFpReg(fields, 0)
	if r != -1 { return "as a tuple field, F2 takes no VFP register" }
	return ""
}

// hfaCall is a call instruction op returning t, variadic or not.
func hfaCall(op int, t @types.Type, variadic bool) @ir.Instr {
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = op
	ins.Typ = t
	ins.CVariadic = variadic
	return ins
}

// An HFA result comes back in VFP registers whatever its size, never through sret —
// except from a variadic `__c_call`, whose result follows the base standard (sret
// above 4 bytes, r0 at 4).  With HfaAggregates off a 32-byte HFA is sret.
func TestVfpHfaReturns() testing.TestResult {
	var cc CallConv = vfpHfaTestCC()
	var d4 @types.Type = hfaD(4)
	if !cc.CallReturnsHfaInRegs(hfaCall(iropcode.OP_CALL, d4, false)) ||
			cc.CallReturnsBigAggregate(hfaCall(iropcode.OP_CALL, d4, false)) {
		return "a call returning D4 should get it in d0-d3, not through sret"
	}
	if !cc.CallReturnsHfaInRegs(hfaCall(iropcode.OP_C_CALL, hfaD(2), false)) {
		return "a non-variadic __c_call returning D2 should get it in d0-d1"
	}
	var v4 @ir.Instr = hfaCall(iropcode.OP_C_CALL, d4, true)
	if cc.CallReturnsHfaInRegs(v4) || !cc.CallReturnsBigAggregate(v4) {
		return "a variadic __c_call returning D4 follows the base standard: sret"
	}
	var v1 @ir.Instr = hfaCall(iropcode.OP_C_CALL, hfaF(1), true)
	if cc.CallReturnsHfaInRegs(v1) || cc.CallReturnsBigAggregate(v1) {
		return "a variadic __c_call returning F1 (4 bytes) follows the base standard: r0"
	}
	var off CallConv = vfpHfaOffCC()
	if off.CallReturnsHfaInRegs(hfaCall(iropcode.OP_CALL, d4, false)) ||
			!off.CallReturnsBigAggregate(hfaCall(iropcode.OP_CALL, d4, false)) {
		return "with HFAs off, a call returning D4 gets it through sret"
	}
	return ""
}
