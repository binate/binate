package "pkg/binate/native/callconv"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the AAPCS-VFP float-argument back-fill allocator in
// callconv/callconv_vfp.bn (cc.VfpBackfill): the s0..s15 = d0..d7 shared-bank
// allocation with float64 even-alignment, float32 back-fill into the holes an
// earlier double's alignment leaves, the stack-poison latch, and the concrete
// register CallArgFpReg reports.  The allocator is INERT until a target is stamped
// FLOAT_ABI_HARD, so these tests stamp arm32 hard-float to BUILD the CallConv, then
// RESTORE the global target immediately (the CallConv captures VfpBackfill /
// WordBytes at construction; the methods read cc + the arg types, not the global
// target) so no test pollutes another.

// vfpTestCC builds the arm32 hard-float (AAPCS-VFP) CallConv, restoring the global
// target to its unstamped state before returning so assertions run clean.
func vfpTestCC() CallConv {
	types.SetArch(types.ARCH_ARM32)
	types.SetFloatABI(types.FLOAT_ABI_HARD)
	var cc CallConv = AAPCS32()
	types.SetFloatABI(types.FLOAT_ABI_DEFAULT)
	types.SetArch(types.ARCH_UNKNOWN)
	return cc
}

// The worked example: f(d0:float64, f0:float32, d1:float64, f1:float32).
//   d0 → D0 (s0,s1);  f0 → S2;  d1 → D2 (s4,s5 — s2 taken, leaving s3 a hole);
//   f1 → S3, BACK-FILLING the hole d1's even-alignment left.
// A naive +2/+1 cursor would put f1 in s6 — the ABI mismatch this allocator fixes.
func TestVfpBackfillWorkedExample() testing.TestResult {
	var cc CallConv = vfpTestCC()
	var ts @[]@types.Type = make_slice(@types.Type, 4)
	ts[0] = types.TypFloat64()
	ts[1] = types.TypFloat32()
	ts[2] = types.TypFloat64()
	ts[3] = types.TypFloat32()
	r0, d0 := cc.CallArgFpReg(ts, 0)
	if r0 != 0 || !d0 { return "arg0 float64 should land in D0" }
	r1, d1 := cc.CallArgFpReg(ts, 1)
	if r1 != 2 || d1 { return "arg1 float32 should land in S2" }
	r2, d2 := cc.CallArgFpReg(ts, 2)
	if r2 != 2 || !d2 { return "arg2 float64 should land in D2 (s2 taken)" }
	r3, d3 := cc.CallArgFpReg(ts, 3)
	if r3 != 3 || d3 { return "arg3 float32 should back-fill S3, not S6" }
	// All four ride FP registers: no GP reg, no stack.
	for i := 0; i < 4; i++ {
		if cc.CallArgRegStart(ts, i) != -1 { return "VFP float takes no GP reg" }
		if cc.CallArgStackOff(ts, i) != -1 { return "in-reg VFP float has no stack slot" }
	}
	if cc.CallStackBytes(ts) != 0 { return "worked example has no stack args" }
	return ""
}

// All-float32: s0..s15 fill in order, then overflow to the stack (4 bytes each,
// StackAlign-rounded).  Pins the single-slot allocation + overflow.
func TestVfpAllFloat32() testing.TestResult {
	var cc CallConv = vfpTestCC()
	var ts @[]@types.Type = make_slice(@types.Type, 18)
	for i := 0; i < 18; i++ { ts[i] = types.TypFloat32() }
	for i := 0; i < 16; i++ {
		r, isD := cc.CallArgFpReg(ts, i)
		if r != i || isD { return "float32 #i should ride S<i>" }
		if cc.CallArgStackOff(ts, i) != -1 { return "in-reg float32 has no stack slot" }
	}
	r16, _ := cc.CallArgFpReg(ts, 16)
	if r16 != -1 { return "17th float32 has no FP register (bank full)" }
	if cc.CallArgStackOff(ts, 16) != 0 { return "17th float32 spills to stack offset 0" }
	if cc.CallArgStackOff(ts, 17) != 4 { return "18th float32 at natural 4-byte offset 4" }
	if cc.CallStackBytes(ts) != 8 { return "two overflow float32 need 8 stack bytes" }
	return ""
}

// All-float64: d0..d7 fill (all 16 S-slots), then overflow to the stack (8 bytes,
// 8-aligned).  Pins the even-aligned S-pair allocation + overflow.
func TestVfpAllFloat64() testing.TestResult {
	var cc CallConv = vfpTestCC()
	var ts @[]@types.Type = make_slice(@types.Type, 10)
	for i := 0; i < 10; i++ { ts[i] = types.TypFloat64() }
	for i := 0; i < 8; i++ {
		r, isD := cc.CallArgFpReg(ts, i)
		if r != i || !isD { return "float64 #i should ride D<i>" }
		if cc.CallArgStackOff(ts, i) != -1 { return "in-reg float64 has no stack slot" }
	}
	r8, _ := cc.CallArgFpReg(ts, 8)
	if r8 != -1 { return "9th float64 has no FP register (bank full)" }
	if cc.CallArgStackOff(ts, 8) != 0 { return "9th float64 spills to stack offset 0" }
	if cc.CallArgStackOff(ts, 9) != 8 { return "10th float64 at 8-aligned offset 8" }
	if cc.CallStackBytes(ts) != 16 { return "two overflow float64 need 16 stack bytes" }
	return ""
}

// Overflow past a full bank: 8 float64 consume all 16 S-slots, so a following
// float32 finds no free slot and spills — even though it is a single.
func TestVfpBankFullThenSingleSpills() testing.TestResult {
	var cc CallConv = vfpTestCC()
	var ts @[]@types.Type = make_slice(@types.Type, 9)
	for i := 0; i < 8; i++ { ts[i] = types.TypFloat64() }
	ts[8] = types.TypFloat32()
	r7, d7 := cc.CallArgFpReg(ts, 7)
	if r7 != 7 || !d7 { return "8th float64 should ride D7" }
	r8, _ := cc.CallArgFpReg(ts, 8)
	if r8 != -1 { return "float32 after a full bank has no FP register" }
	if cc.CallArgStackOff(ts, 8) != 0 { return "spilled float32 at stack offset 0" }
	return ""
}

// Stack-poison latch: 15 float32 fill S0..S14 (S15 free); a float64 then finds no
// even-aligned pair and SPILLS, latching the bank exhausted; a following float32
// that WOULD fit the free S15 must nonetheless go to the stack.
func TestVfpStackPoisonDisablesBackfill() testing.TestResult {
	var cc CallConv = vfpTestCC()
	var ts @[]@types.Type = make_slice(@types.Type, 17)
	for i := 0; i < 15; i++ { ts[i] = types.TypFloat32() }
	ts[15] = types.TypFloat64()
	ts[16] = types.TypFloat32()
	r14, d14 := cc.CallArgFpReg(ts, 14)
	if r14 != 14 || d14 { return "15th float32 should ride S14 (S15 still free)" }
	r15, _ := cc.CallArgFpReg(ts, 15)
	if r15 != -1 { return "float64 with no even pair should spill" }
	if cc.CallArgStackOff(ts, 15) != 0 { return "spilled float64 at stack offset 0" }
	r16, _ := cc.CallArgFpReg(ts, 16)
	if r16 != -1 { return "poisoned float32 must stack even though S15 is free" }
	if cc.CallArgStackOff(ts, 16) != 8 { return "poisoned float32 after the 8-byte double at 8" }
	return ""
}

// Regression guard: the monotonic-NSRN conventions are untouched by VfpBackfill.
// AAPCS64 keeps VfpBackfill false — a float rides the NSRN path (regStart -1, no
// stack while NSRN < 8) and CallArgFpReg is inert there (returns -1); soft-float
// AAPCS32 keeps floats on the GP path (a float32 lands in r0).
func TestVfpBackfillOffLeavesMonotonicPath() testing.TestResult {
	var aa CallConv = AAPCS64()
	if aa.VfpBackfill { return "AAPCS64 must not set VfpBackfill" }
	var fs @[]@types.Type = make_slice(@types.Type, 2)
	fs[0] = types.TypFloat64()
	fs[1] = types.TypFloat64()
	if aa.CallArgRegStart(fs, 0) != -1 { return "aa64 float rides NSRN, no GP reg" }
	if aa.CallArgStackOff(fs, 0) != -1 { return "aa64 float in D0, no stack" }
	if aa.CallStackBytes(fs) != 0 { return "two aa64 floats need no stack" }
	r, isD := aa.CallArgFpReg(fs, 0)
	if r != -1 || isD { return "CallArgFpReg is inert on a non-VfpBackfill CallConv" }

	// Soft-float arm32: NumFpArgRegs 0, VfpBackfill false — a float rides GP.
	types.SetArch(types.ARCH_UNKNOWN)
	types.SetFloatABI(types.FLOAT_ABI_DEFAULT)
	var soft CallConv = AAPCS32()
	if soft.VfpBackfill { return "soft-float AAPCS32 must not set VfpBackfill" }
	if soft.NumFpArgRegs != 0 { return "soft-float AAPCS32 has 0 FP arg regs" }
	var ts @[]@types.Type = make_slice(@types.Type, 1)
	ts[0] = types.TypFloat32()
	if soft.CallArgRegStart(ts, 0) != 0 { return "soft-float float32 rides GP r0" }
	sr, sd := soft.CallArgFpReg(ts, 0)
	if sr != -1 || sd { return "CallArgFpReg is inert under soft-float" }
	return ""
}

// vfpOverflowTypes returns nine float64 (the ninth overflows the VFP bank to the
// stack), an int32, the aggregate t, and a trailing int32.
func vfpOverflowTypes(nDoubles int, t @types.Type) @[]@types.Type {
	var ts @[]@types.Type = make_slice(@types.Type, nDoubles + 3)
	for i := 0; i < nDoubles; i++ { ts[i] = types.TypFloat64() }
	ts[nDoubles] = types.TypInt32()
	ts[nDoubles + 1] = t
	ts[nDoubles + 2] = types.TypInt32()
	return ts
}

// int32Struct builds a named struct of n int32 fields.
func int32Struct(name @[]char, n int) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt32()
	}
	return types.MakeStructType(name, fields)
}

// AAPCS32 C.5: an aggregate splits across r0-r3 and the stack only while nothing is on
// the stack yet.  After a ninth float64 overflows the VFP bank to [sp, #0], an int32
// takes r0 and a 24-byte struct that does not fit r1-r3 goes wholly to the stack at 8,
// closing the core registers — the trailing int32 follows it at 32, not in r1 (clang's
// placement).  The same holds for a 16-byte struct.  With only eight float64 nothing is
// on the stack, so the 24-byte struct splits (r1-r3 + 12 bytes) and the int32 follows.
func TestVfpOverflowThenAggregateDoesNotSplit() testing.TestResult {
	setTarget32()
	var cc CallConv = vfpTestCC()
	var ts @[]@types.Type = vfpOverflowTypes(9, int32Struct("Six", 6))
	if cc.CallArgStackOff(ts, 8) != 0 { return "the ninth float64 overflows to [sp, #0]" }
	if cc.CallArgRegStart(ts, 9) != 0 { return "the int32 takes r0" }
	if cc.CallArgRegStart(ts, 10) != -1 {
		return "the 24-byte struct must not split after a stack arg"
	}
	if cc.CallArgStackOff(ts, 10) != 8 { return "the 24-byte struct goes wholly to [sp, #8]" }
	if cc.CallArgRegStart(ts, 11) != -1 || cc.CallArgStackOff(ts, 11) != 32 {
		return "the trailing int32 follows on the stack at 32 (core registers closed)"
	}
	if cc.CallStackBytes(ts) != 40 { return "8 + 24 + 4 stack bytes, rounded to 40" }
	var ts16 @[]@types.Type = vfpOverflowTypes(9, int32Struct("Four", 4))
	if cc.CallArgRegStart(ts16, 10) != -1 || cc.CallArgStackOff(ts16, 10) != 8 {
		return "a 16-byte struct must not split after a stack arg either"
	}
	var ts12 @[]@types.Type = vfpOverflowTypes(9, int32Struct("Three", 3))
	if cc.CallArgRegStart(ts12, 10) != 1 || cc.CallArgStackOff(ts12, 10) != -1 {
		return "a 12-byte struct that fits r1-r3 still takes them"
	}
	var split @[]@types.Type = vfpOverflowTypes(8, int32Struct("Six", 6))
	if cc.CallArgRegStart(split, 9) != 1 || cc.CallArgStackOff(split, 9) != 0 {
		return "with nothing on the stack the 24-byte struct splits from r1"
	}
	if cc.CallArgStackOff(split, 10) != 12 { return "the trailing int32 follows the split's 12 bytes" }
	return ""
}
