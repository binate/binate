package "pkg/binate/native/callconv"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Argument words and stack offsets past 2^31: an aggregate may pass 2 GiB, so the
// layout is int64 (the ...64 forms), and an argument passed as a pointer takes its one
// word without its size's word count being taken.  These run on a 32-bit host too.

// wideBytes returns [n]uint8.
func wideBytes(n int64) @types.Type {
	return types.MakeArrayType(types.TypUint8(), n)
}

// SysV passes each of three 1.5 GiB aggregates on the stack (MEMORY class): the third
// starts at 3 GiB and the area is 4.5 GiB.
func TestStackOffsetsPast2GiBSysV() testing.TestResult {
	setTarget64()
	var cc CallConv = SysV_AMD64()
	var big @types.Type = wideBytes(0x60000000)
	var args @[]@types.Type = @[]@types.Type{big, big, big}
	if ArgWords64(big) != 0x0C000000 { return "1.5 GiB is 0x0C000000 eightbytes" }
	if cc.CallArgRegStart(args, 2) != -1 { return "a 1.5 GiB aggregate takes no register" }
	if cc.CallArgStackOff64(args, 1) != 0x60000000 || cc.CallArgStackOff64(args, 2) != 0xC0000000 {
		return "the second and third should start at 1.5 GiB and 3 GiB"
	}
	if cc.CallStackBytes64(args) != 0x120000000 { return "the area should be 4.5 GiB" }
	if cc.CallStackBytesV64(args, 3, false) != 0x120000000 { return "the V form agrees" }
	if cc.CallArgStackOffV64(args, 2, 3, false) != 0xC0000000 { return "the V form agrees" }
	return ""
}

// AAPCS64 passes an aggregate past 2 GiB as one pointer, in a register while one is
// left; the argument after it takes the next register.
func TestIndirectPast2GiBAAPCS64() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var huge @types.Type = wideBytes(0x100000008)
	var args @[]@types.Type = @[]@types.Type{huge, types.TypInt64(), huge}
	if cc.CallArgRegStart(args, 0) != 0 || cc.CallArgRegStart(args, 1) != 1 ||
			cc.CallArgRegStart(args, 2) != 2 {
		return "each 4 GiB aggregate is a pointer in the next register"
	}
	if cc.CallStackBytes64(args) != 0 { return "nothing goes on the stack" }
	if cc.EffectiveArgWords(huge) != 1 { return "the dispatch passes it as one word" }
	if cc.ArgWords64(huge) != 0x20000001 { return "its size is 0x20000001 words" }
	return ""
}

// AAPCS32 splits the first of three 1.5 GiB aggregates across r0-r3 and the stack;
// the third starts past 2^31 in the argument area.
func TestStackOffsetsPast2GiBAAPCS32() testing.TestResult {
	setTarget32()
	defer { setTarget64() }
	var cc CallConv = AAPCS32()
	var big @types.Type = wideBytes(0x60000000)
	var args @[]@types.Type = @[]@types.Type{big, big, big}
	if cc.CallArgRegStart(args, 0) != 0 || cc.CallArgStackOff64(args, 0) != 0 {
		return "the first splits: r0-r3, then the stack from offset 0"
	}
	if cc.CallArgStackOff64(args, 1) != 0x5FFFFFF0 || cc.CallArgStackOff64(args, 2) != 0xBFFFFFF0 {
		return "the second and third follow the first's 0x5FFFFFF0 stack bytes"
	}
	if cc.CallStackBytes64(args) != 0x11FFFFFF0 { return "the area should be 0x11FFFFFF0 bytes" }
	return ""
}

// AAPCS-VFP: a ninth float64 spills to the stack (offset 0), so none of the three
// 1.5 GiB aggregates after it may split (the stack is in use): each goes wholly on the
// stack, from offset 8, the third at 0xC0000008.
func TestStackOffsetsPast2GiBVfp() testing.TestResult {
	setTarget32()
	defer { setTarget64() }
	var cc CallConv = vfpTestCC()
	var big @types.Type = wideBytes(0x60000000)
	var args @[]@types.Type = make_slice(@types.Type, 12)
	for i := 0; i < 9; i++ { args[i] = types.TypFloat64() }
	for i := 9; i < 12; i++ { args[i] = big }
	if cc.CallArgStackOff64(args, 8) != 0 { return "the ninth float64 spills to offset 0" }
	if cc.CallArgRegStart(args, 9) != -1 { return "the first aggregate may not split" }
	if cc.CallArgStackOff64(args, 9) != 8 || cc.CallArgStackOff64(args, 11) != 0xC0000008 {
		return "the aggregates should start at 8 and, the third, at 0xC0000008"
	}
	if cc.CallStackBytes64(args) != 0x120000008 { return "the area should be 0x120000008 bytes" }
	return ""
}

// AAPCS64 passes an aggregate past 2 GiB that finds no register left as one pointer
// word on the stack.
func TestIndirectPointerOnStackAAPCS64() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var args @[]@types.Type = make_slice(@types.Type, 9)
	for i := 0; i < 8; i++ { args[i] = types.TypInt64() }
	args[8] = wideBytes(0x100000008)
	if cc.CallArgRegStart(args, 8) != -1 || cc.CallArgStackOff64(args, 8) != 0 {
		return "the ninth argument's pointer goes on the stack at offset 0"
	}
	if cc.CallStackBytes64(args) != 16 { return "one word, rounded to 16" }
	return ""
}

// AAPCS32: an 8-aligned 1.5 GiB aggregate after an int32 starts on the even register
// r2, splits, and the next two follow on the stack at 8-aligned offsets.
func TestEvenPairPast2GiBAAPCS32() testing.TestResult {
	setTarget32()
	defer { setTarget64() }
	var cc CallConv = AAPCS32()
	var big8 @types.Type = types.MakeArrayType(types.TypInt64(), 0x0C000000)
	var args @[]@types.Type = @[]@types.Type{types.TypInt32(), big8, big8, big8}
	if cc.CallArgRegStart(args, 1) != 2 || cc.CallArgStackOff64(args, 1) != 0 {
		return "the first aggregate starts on r2 and splits to the stack at 0"
	}
	if cc.CallArgStackOff64(args, 2) != 0x5FFFFFF8 || cc.CallArgStackOff64(args, 3) != 0xBFFFFFF8 {
		return "the next two follow at 0x5FFFFFF8 and 0xBFFFFFF8"
	}
	if cc.CallStackBytes64(args) != 0x11FFFFFF8 { return "the area should be 0x11FFFFFF8 bytes" }
	return ""
}

// Darwin passes every variadic argument on the stack: a 4 GiB aggregate's pointer,
// then an int64 after it.
func TestVariadicPast2GiBDarwin() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64_Darwin()
	var args @[]@types.Type = @[]@types.Type{types.TypInt64(), wideBytes(0x100000008),
			types.TypInt64()}
	if cc.CallArgStackOffV64(args, 1, 1, true) != 0 || cc.CallArgStackOffV64(args, 2, 1, true) != 8 {
		return "the variadic pointer and int64 go on the stack at 0 and 8"
	}
	if cc.CallStackBytesV64(args, 1, true) != 16 { return "two words, 16 bytes" }
	return ""
}

// A multi-value tuple with a field past 4 GiB counts its words in int64 and is
// returned through the caller's buffer.
func TestMultiReturnHugeFieldNeedsSret() testing.TestResult {
	setTarget64()
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = wideBytes(0x100000008)
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt64()
	if !AAPCS64().MultiReturnTupleNeedsSret(types.MakeStructType("", fields)) {
		return "a tuple with a 4 GiB field is returned through a buffer"
	}
	return ""
}
