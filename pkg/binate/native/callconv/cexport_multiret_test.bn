package "pkg/binate/native/callconv"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the #[c_export] multi-value-return C-ABI classification
// (cexport_multiret.bn): CExportMultiReturnAdaptKind across every target
// whose C struct-return budget differs from the internal register-count budget,
// so a per-target off-by-one in the divergence classification shows up.

// mkTuple builds an anonymous multi-return tuple struct from a field-type list —
// the same shape ir-gen's makeMultiReturnStructType builds.
func mkTuple(fieldTypes @[]@types.Type) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, len(fieldTypes))
	for i := 0; i < len(fieldTypes); i++ {
		fields[i] = make(types.Field)
		fields[i].Type = fieldTypes[i]
	}
	return types.MakeStructType("", fields)
}

func ts2(a @types.Type, b @types.Type) @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, 2)
	r[0] = a
	r[1] = b
	return r
}

func ts3(a @types.Type, b @types.Type, c @types.Type) @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, 3)
	r[0] = a
	r[1] = b
	r[2] = c
	return r
}

func tsN(elem @types.Type, n int) @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, n)
	for i := 0; i < n; i++ {
		r[i] = elem
	}
	return r
}

func setAa64() {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
}

func setX64() {
	setTarget64()
	types.SetArch(types.ARCH_X64)
}

func setArm32Soft() {
	setTarget32()
	types.SetArch(types.ARCH_ARM32)
	types.SetFloatABI(types.FLOAT_ABI_DEFAULT)
}

func setArm32Hard() {
	setTarget32()
	types.SetArch(types.ARCH_ARM32)
	types.SetFloatABI(types.FLOAT_ABI_HARD)
}

func restoreTarget() {
	types.SetFloatABI(types.FLOAT_ABI_DEFAULT)
	types.SetArch(types.ARCH_UNKNOWN)
	setTarget64()
}

// ---- aarch64: C sret cutoff 16B; internal 8 GP words / 8 FP; HFA in v-regs. ----

func TestCExportKindAa64() testing.TestResult {
	setAa64()
	var cc CallConv = AAPCS64()
	var i64 @types.Type = types.TypInt64()
	var i32 @types.Type = types.TypInt32()
	var f64 @types.Type = types.TypFloat64()
	// (i64,i64,i64) 24B: C sret (>16), internal register (3 ≤ 8 words) → SRET.
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts3(i64, i64, i64))) != CRET_ADAPT_SRET {
		restoreTarget()
		return "aa64 (i64,i64,i64) should be SRET"
	}
	// (f64,f64,f64) 24B: HFA (v0..v2 both ways) → NONE (alias).
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts3(f64, f64, f64))) != CRET_ADAPT_NONE {
		restoreTarget()
		return "aa64 (f64,f64,f64) HFA should be NONE"
	}
	// (i32,i32) 8B: C packs into x0, internal spreads w0/w1 → COERCE.
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(i32, i32))) != CRET_ADAPT_COERCE {
		restoreTarget()
		return "aa64 (i32,i32) should be COERCE"
	}
	// (i64,f64) 16B: word-sized MIXED — C returns wholly in x0/x1 but the internal
	// convention puts the f64 in d0 → COERCE (aarch64 non-HFA GP-return divergence).
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(i64, f64))) != CRET_ADAPT_COERCE {
		restoreTarget()
		return "aa64 (i64,f64) should be COERCE (float field in a non-HFA GP-return tuple)"
	}
	// (f64,i64) — same divergence, float field first.
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(f64, i64))) != CRET_ADAPT_COERCE {
		restoreTarget()
		return "aa64 (f64,i64) should be COERCE"
	}
	// (i64,i64) 16B: word-sized, both x0/x1 → NONE (alias).
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(i64, i64))) != CRET_ADAPT_NONE {
		restoreTarget()
		return "aa64 (i64,i64) should be NONE"
	}
	// (i8 × 9) 9B: C register (x0/x1), internal sret (9 > 8 GP words) →
	// COERCE_FROM_SRET.
	if cc.CExportMultiReturnAdaptKind(mkTuple(tsN(types.TypInt8(), 9))) !=
			CRET_ADAPT_COERCE_FROM_SRET {
		restoreTarget()
		return "aa64 (i8 x9) should be COERCE_FROM_SRET"
	}
	// (i64 × 9) 72B: both sret (>64 internal, >16 C) → NONE (alias).
	if cc.CExportMultiReturnAdaptKind(mkTuple(tsN(i64, 9))) != CRET_ADAPT_NONE {
		restoreTarget()
		return "aa64 (i64 x9) both-sret should be NONE"
	}
	restoreTarget()
	return ""
}

// ---- x86-64: C sret cutoff 16B; internal 3 GP words (narrower!) → COERCE_FROM_SRET. ----

func TestCExportKindX64() testing.TestResult {
	setX64()
	var cc CallConv = SysV_AMD64()
	var i64 @types.Type = types.TypInt64()
	var i32 @types.Type = types.TypInt32()
	var i16 @types.Type = types.TypInt16()
	var f64 @types.Type = types.TypFloat64()
	// (i64,i64,i64) 24B: C sret, internal register (3 ≤ 3 words) → SRET.
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts3(i64, i64, i64))) != CRET_ADAPT_SRET {
		restoreTarget()
		return "x64 (i64,i64,i64) should be SRET"
	}
	// (i64,f64) 16B: word-sized mixed — on x86-64 each eightbyte rides its own class
	// (RAX + XMM0) under BOTH conventions, so NO coerce (unlike aarch64) → NONE.
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(i64, f64))) != CRET_ADAPT_NONE {
		restoreTarget()
		return "x64 (i64,f64) should be NONE (per-eightbyte SSE matches)"
	}
	// (i32,i32) 8B: C packs into RAX, internal spreads → COERCE.
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(i32, i32))) != CRET_ADAPT_COERCE {
		restoreTarget()
		return "x64 (i32,i32) should be COERCE"
	}
	// (i32 × 4) 16B: C register (2 eightbytes) but internal sret (4 > 3 GP words)
	// → COERCE_FROM_SRET (the x64-only inversion).
	if cc.CExportMultiReturnAdaptKind(mkTuple(tsN(i32, 4))) != CRET_ADAPT_COERCE_FROM_SRET {
		restoreTarget()
		return "x64 (i32 x4) should be COERCE_FROM_SRET"
	}
	// (i16 × 4) 8B: C register (1 eightbyte) but internal sret (4 > 3) → COERCE_FROM_SRET.
	if cc.CExportMultiReturnAdaptKind(mkTuple(tsN(i16, 4))) != CRET_ADAPT_COERCE_FROM_SRET {
		restoreTarget()
		return "x64 (i16 x4) should be COERCE_FROM_SRET"
	}
	// (i64,i64) 16B: word-sized, RAX/RDX → NONE.
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(i64, i64))) != CRET_ADAPT_NONE {
		restoreTarget()
		return "x64 (i64,i64) should be NONE"
	}
	// A struct field in an SSE eightbyte: C returns it in XMM, the internal convention
	// in GP → COERCE, whichever side the struct is on, and for two of them.
	var f32 @types.Type = types.TypFloat32()
	var v2 @types.Type = mkNamedStruct("V2", ts2(f32, f32))
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(v2, i64))) != CRET_ADAPT_COERCE {
		restoreTarget()
		return "x64 (V2,i64) should be COERCE"
	}
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(i64, v2))) != CRET_ADAPT_COERCE {
		restoreTarget()
		return "x64 (i64,V2) should be COERCE"
	}
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(v2, v2))) != CRET_ADAPT_COERCE {
		restoreTarget()
		return "x64 (V2,V2) should be COERCE"
	}
	// An array field and a struct after a float64 are SSE eightbytes too → COERCE.
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(types.MakeArrayType(f32, 2), i64))) !=
			CRET_ADAPT_COERCE {
		restoreTarget()
		return "x64 ([2]f32,i64) should be COERCE"
	}
	var sd @types.Type = mkNamedStruct("SD", tsN(f64, 1))
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(f64, sd))) != CRET_ADAPT_COERCE {
		restoreTarget()
		return "x64 (f64,SD) should be COERCE"
	}
	// {f32, i32} merges to one INTEGER eightbyte: C and the internal convention both
	// use GP → NONE.
	var fi @types.Type = mkNamedStruct("FI", ts2(f32, types.TypInt32()))
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(fi, i64))) != CRET_ADAPT_NONE {
		restoreTarget()
		return "x64 (FI,i64) should be NONE"
	}
	// An all-integer struct field shares no SSE eightbyte, and the float64 scalar is in
	// XMM both ways → NONE.
	var si @types.Type = mkNamedStruct("SI", tsN(i64, 1))
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(si, f64))) != CRET_ADAPT_NONE {
		restoreTarget()
		return "x64 (SI,f64) should be NONE"
	}
	restoreTarget()
	return ""
}

// ---- arm32: C sret cutoff 4B; internal 4 GP words; HFA in VFP only on hard-float. ----

func TestCExportKindArm32Soft() testing.TestResult {
	setArm32Soft()
	var cc CallConv = AAPCS32()
	var i32 @types.Type = types.TypInt32()
	var i16 @types.Type = types.TypInt16()
	var i64 @types.Type = types.TypInt64()
	// (i32,i32) 8B: C sret (>4), internal register (2 ≤ 4 words) → SRET.
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(i32, i32))) != CRET_ADAPT_SRET {
		restoreTarget()
		return "arm32 (i32,i32) should be SRET"
	}
	// (i16,i16) 4B: C register (r0), internal spreads r0/r1 → COERCE.
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(i16, i16))) != CRET_ADAPT_COERCE {
		restoreTarget()
		return "arm32 (i16,i16) should be COERCE"
	}
	// (i64,i64,i64) 24B: internal sret (6 > 4 words) AND C sret (>4) → NONE.
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts3(i64, i64, i64))) != CRET_ADAPT_NONE {
		restoreTarget()
		return "arm32 (i64,i64,i64) both-sret should be NONE"
	}
	restoreTarget()
	return ""
}

func TestCExportKindArm32HardHfa() testing.TestResult {
	setArm32Hard()
	var cc CallConv = AAPCS32()
	var f32 @types.Type = types.TypFloat32()
	var i32 @types.Type = types.TypInt32()
	// (f32,f32,f32) 12B: hard-float HFA (s0..s2 both ways) → NONE (alias).
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts3(f32, f32, f32))) != CRET_ADAPT_NONE {
		restoreTarget()
		return "arm32-hard (f32,f32,f32) HFA should be NONE"
	}
	// (i32,i32) 8B still SRET on hard-float (int tuple, C sret > 4).
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(i32, i32))) != CRET_ADAPT_SRET {
		restoreTarget()
		return "arm32-hard (i32,i32) should be SRET"
	}
	restoreTarget()
	return ""
}

// mkNamedStruct builds a named struct from a field-type list — a struct the ABI
// layer classifies by its members (an HFA when they are 1-4 same-width floats).
func mkNamedStruct(name @[]char, fieldTypes @[]@types.Type) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, len(fieldTypes))
	for i := 0; i < len(fieldTypes); i++ {
		fields[i] = make(types.Field)
		fields[i].Type = fieldTypes[i]
	}
	return types.MakeStructType(name, fields)
}

// An FP-HFA tuple with a struct / array field: C returns every member in d0.. /
// s0.., the internal convention returns the aggregate field in GP registers, so
// the entry repacks (COERCE) — unlike a float-scalar-only HFA tuple (NONE).
func TestCExportKindAa64HfaAggregateField() testing.TestResult {
	setAa64()
	var cc CallConv = AAPCS64()
	var f32 @types.Type = types.TypFloat32()
	var f64 @types.Type = types.TypFloat64()
	var v2d @types.Type = mkNamedStruct("V2d", ts2(f64, f64))
	var v2f @types.Type = mkNamedStruct("V2f", ts2(f32, f32))
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(v2d, f64))) != CRET_ADAPT_COERCE {
		restoreTarget()
		return "aa64 (V2d,f64) should be COERCE"
	}
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(f64, v2d))) != CRET_ADAPT_COERCE {
		restoreTarget()
		return "aa64 (f64,V2d) should be COERCE"
	}
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(v2f, f32))) != CRET_ADAPT_COERCE {
		restoreTarget()
		return "aa64 (V2f,f32) should be COERCE"
	}
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(types.MakeArrayType(f64, 2), f64))) !=
			CRET_ADAPT_COERCE {
		restoreTarget()
		return "aa64 ([2]f64,f64) should be COERCE"
	}
	// (V2d,V2d) 32B: a 4-member HFA (d0..d3 in C), 4 GP words internally → COERCE.
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(v2d, v2d))) != CRET_ADAPT_COERCE {
		restoreTarget()
		return "aa64 (V2d,V2d) should be COERCE"
	}
	// (V2d,V2d,f64): 5 members is no HFA → C sret (40B), internal registers → SRET.
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts3(v2d, v2d, f64))) != CRET_ADAPT_SRET {
		restoreTarget()
		return "aa64 (V2d,V2d,f64) should be SRET"
	}
	restoreTarget()
	return ""
}

// arm32 hard-float: the same repack; a tuple whose aggregate fields exceed the 4 GP
// return words is sret internally yet register-returned by C → COERCE_FROM_SRET.
func TestCExportKindArm32HardHfaAggregateField() testing.TestResult {
	setArm32Hard()
	var cc CallConv = AAPCS32()
	var f32 @types.Type = types.TypFloat32()
	var f64 @types.Type = types.TypFloat64()
	var v2f @types.Type = mkNamedStruct("V2f", ts2(f32, f32))
	var d2 @types.Type = mkNamedStruct("D2", ts2(f64, f64))
	var d3 @types.Type = mkNamedStruct("D3", ts3(f64, f64, f64))
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(v2f, f32))) != CRET_ADAPT_COERCE {
		restoreTarget()
		return "arm32-hard (V2f,f32) should be COERCE"
	}
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(d2, f64))) != CRET_ADAPT_COERCE {
		restoreTarget()
		return "arm32-hard (D2,f64) should be COERCE"
	}
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(d3, f64))) != CRET_ADAPT_COERCE_FROM_SRET {
		restoreTarget()
		return "arm32-hard (D3,f64) should be COERCE_FROM_SRET"
	}
	restoreTarget()
	// Soft-float: no FP-HFA return, so (V2f,f32) is C sret (12B > 4) and register-
	// returned internally (3 GP words) → SRET, as before.
	setArm32Soft()
	cc = AAPCS32()
	if cc.CExportMultiReturnAdaptKind(mkTuple(ts2(v2f, f32))) != CRET_ADAPT_SRET {
		restoreTarget()
		return "arm32-soft (V2f,f32) should be SRET"
	}
	restoreTarget()
	return ""
}

// A nil (non-multi) tuple must classify NONE, not crash.
func TestCExportKindNilTuple() testing.TestResult {
	setAa64()
	var cc CallConv = AAPCS64()
	var nilT @types.Type
	if cc.CExportMultiReturnAdaptKind(nilT) != CRET_ADAPT_NONE {
		restoreTarget()
		return "nil tuple should classify NONE"
	}
	restoreTarget()
	return ""
}
