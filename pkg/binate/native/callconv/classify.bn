package "pkg/binate/native/callconv"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"

// IsAggregateTyp reports whether a type is a struct, array, slice, or
// function value — i.e., not an in-register value. OP_LOAD passes a
// pointer through rather than materializing the bytes; OP_STORE does
// a memcpy. Function values share this category because their 2-word
// {vtable, data} layout doesn't fit in a single register.
func IsAggregateTyp(t @types.Type) bool {
	if t == nil { return false }
	t = types.StripWrappers(t)
	return t.Kind == types.TYP_STRUCT || t.Kind == types.TYP_ARRAY ||
			t.Kind == types.TYP_MANAGED_SLICE || t.Kind == types.TYP_SLICE ||
			t.Kind == types.TYP_FUNC_VALUE || t.Kind == types.TYP_MANAGED_FUNC_VALUE ||
			t.Kind == types.TYP_INTERFACE_VALUE || t.Kind == types.TYP_INTERFACE_VALUE_MANAGED
}

// IsFloatScalarTyp reports whether t is a float scalar (TYP_FLOAT or
// TYP_UNTYPED_FLOAT). Float scalars travel in the FP register file
// (D0..D7) under AAPCS64, separately from GP X-registers, so the
// NGRN-based dispatch helpers below skip them when counting X-reg
// budget. The NSRN counter for float args is tracked at the call site.
func IsFloatScalarTyp(t @types.Type) bool {
	if t == nil { return false }
	t = types.StripWrappers(t)
	return t.Kind == types.TYP_FLOAT || t.Kind == types.TYP_UNTYPED_FLOAT
}

// FloatScalarIsI32 reports whether a float scalar occupies a 32-bit integer
// slot (a float32) rather than a 64-bit one (float64 / untyped-float) in the
// all-int func-value shim ABI.  Mirrors floatSlotIsI32 in the LLVM backend
// (pkg/binate/codegen/emit_funcvals.bn): only a concrete TYP_FLOAT of Width 32
// is i32; float64 and untyped-float take the i64 slot.  The result is only
// meaningful when IsFloatScalarTyp(t) holds.
func FloatScalarIsI32(t @types.Type) bool {
	if t == nil { return false }
	t = types.StripWrappers(t)
	return t.Kind == types.TYP_FLOAT && t.Width == 32
}

// IsMultiReturnCall reports whether ins is a call whose result is an
// anonymous TYP_STRUCT — the IR's encoding for a function with multiple
// return values. Name="" distinguishes these from a real (named)
// struct-by-value return, which is an aggregate that needs pointer-form
// storage so downstream arg-spreading and struct-copy see it the same as
// LOAD / MAKE_SLICE results.
//
// The op set is exactly the three call ops the IR attaches a
// makeMultiReturnStructType result to: OP_CALL (gen_call.bn direct call),
// OP_CALL_FUNC_VALUE (gen_call.bn func-value call), and
// OP_CALL_IFACE_METHOD (gen_iface.bn — the CR-2 SEAM types a multi-return
// interface method as the same tuple struct). Recognizing the iface case
// is load-bearing: every downstream native site keys on this predicate
// (PlanFrame tuple-vs-pointer spill, the per-arch return collect, EXTRACT's
// SpillHoldsAggregatePointer split, CallReturnsBigMultiReturn). Without the
// iface arm an iface multi-return falls into the aggregate-single-return
// path, whose register-collect reads ArgWords words — which on aa64 (one
// register per tuple field) drops every field past the first eightbyte
// (e.g. `(uint16, uint16)` loses field 1). OP_CALL_INDIRECT / OP_CALL_HANDLE
// are absent because the IR never attaches a multi-return struct to them.
func IsMultiReturnCall(ins @ir.Instr) bool {
	if ins == nil || ins.Typ == nil { return false }
	if ins.Op != iropcode.OP_CALL && ins.Op != iropcode.OP_CALL_FUNC_VALUE &&
			ins.Op != iropcode.OP_CALL_IFACE_METHOD {
		return false
	}
	if ins.Typ.Kind != types.TYP_STRUCT { return false }
	return len(ins.Typ.Name) == 0
}
