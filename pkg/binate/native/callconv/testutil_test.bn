package "pkg/binate/native/callconv"

import "pkg/binate/ir"
import "pkg/binate/types"

// Shared helpers for this package's tests.

// setTarget64 pins types' live target to a 64-bit configuration (LP64), so
// size, word-count and stack-byte assertions are host-independent.
func setTarget64() {
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	types.SetTarget(t)
}

// setTarget32 pins types' live target to the ILP32 configuration the arm32
// backend uses (PointerSize / IntSize = 4, MaxAlign = 8 — AAPCS aligns int64
// / double to 8).  Tests that call it restore the 64-bit default afterwards
// with setTarget64 when later assertions are LP64-specific.
func setTarget32() {
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
}

// makeNoParams returns an empty parameter list.
func makeNoParams() @[]@ir.Param {
	var p @[]@ir.Param
	return p
}

// makeNoResults returns an empty result-type list.
func makeNoResults() @[]@types.Type {
	var r @[]@types.Type
	return r
}

// catStr returns dst followed by src as a new managed char slice.
func catStr(dst *[]readonly char, src *[]readonly char) @[]char {
	var n int = len(dst)
	var out @[]char = make_slice(char, n + len(src))
	for i := 0; i < n; i++ { out[i] = dst[i] }
	for i := 0; i < len(src); i++ { out[n + i] = src[i] }
	return out
}
