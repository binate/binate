// Package common holds the arch-agnostic pieces of the native backend:
// the per-function register map + stack layout, frame planning, the
// type predicates that classify SSA values into the lowering strategies
// every arch needs, and the register allocator.  The calling-convention
// model (CallConv and its queries) is package callconv.
//
// Each pkg/binate/native/<arch>/ package consumes this alongside the
// arch-specific register pool, scratch-register allocator, and
// instruction emission helpers.
package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/native/callconv"
import "pkg/binate/types"

// ArchEmitter is the per-arch primitive set that the shared EmitObject
// object-emission skeleton dispatches through — one impl per backend
// (aarch64/x64/arm32).  Everything that varied across the three EmitObject
// bodies (word size, the object-format linkage prefix, per-arch function /
// vtable / descriptor emission, fixup resolution, and the object-file
// writer) is a method here; the invariant algorithm lives once in
// EmitObject.
interface ArchEmitter {
	WordBytes() int
	CallConv() callconv.CallConv
	SetPrefix(format *[]readonly char)
	ClearPrefix()
	SymPrefixed(name *[]readonly char) @[]char
	ArchName() *[]readonly char
	ElfTextMappingSymbol(format *[]readonly char) *[]readonly char
	EmitFunc(a @asm.Assembler, pkgName *[]readonly char, f @ir.Func, strings @[]ir.StringConst)
	EmitCEntryThunks(a @asm.Assembler, pkgName *[]readonly char, targets @[]@ir.Func)
	EmitFuncValueShims(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module)
	EmitStringTable(a @asm.Assembler, pkgName *[]readonly char, strings @[]ir.StringConst)
	EmitGlobals(a @asm.Assembler, pkgName *[]readonly char, globals @[]@ir.Global)
	EmitFuncValueVtables(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module)
	EmitImplVtables(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module)
	EmitPackageDescriptor(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module)
	ResolveFixups(a @asm.Assembler)
	WriteObject(a @asm.Assembler, format *[]readonly char, path *[]readonly char) bool
}

// EmitObject is the object-emission skeleton shared by every native
// backend: it drives `e`'s per-arch primitives through the invariant
// sequence (set prefix → new assembler → per-func text → shims / strings /
// globals / vtables / descriptor / __pkg_satfrag node → resolve fixups →
// finalize → write).  Each backend's own EmitObject constructs its
// ArchEmitter and delegates here.
func EmitObject(e *ArchEmitter, mod @ir.Module, format *[]readonly char, path *[]readonly char) bool

// RegMap tracks live register assignments and the per-function stack
// layout. The same structure works across architectures: individual
// Regs entries are arch-specific register numbers, but the algorithms
// below — lookup, frame planning, slot assignment — don't care. Per-
// arch emitters consume RegMap through the lookups and through
// their own nextReg / scratchReg / getOperand helpers.
// Under the "spill everything" policy in PlanFrame, the register table
// only holds values live within a single instruction; the alloc and
// spill slot tables describe the stable stack frame.
type RegMap struct {
	IDs  @[]int // SSA IDs (index aligns with Regs)
	Regs @[]int // arch-specific register number (parallel to IDs)
	Next int // index of next free register in the arch's pool

	// CurUsed holds the arch-register numbers claimed by the CURRENTLY-
	// emitting instruction (its operands / scratch / result).  A backend
	// that keeps the IDs/Regs map live ACROSS instructions (within-block
	// value retention, so a later use reads a register instead of reloading
	// its spill slot) allocates registers occupancy-aware: it must not hand
	// out a register this instruction already claimed, nor clobber a still-
	// needed operand.  Reset per instruction (ClearUsed) and by ResetRegs.
	// Backends that keep the pure spill-everything policy leave it empty.
	CurUsed @[]int

	// DirtyIDs is the set of cached SSA ids whose value has NOT yet been
	// written to its spill slot: lazy spill defers a spilled scalar's store
	// until it is evicted or dropped while still live (dead-store
	// elimination), and elides it entirely when the value is used only from
	// its register.  A backend on the eager-spill path never adds to it, so
	// it stays empty and has no effect.  Cleared by ResetRegs with the cache.
	DirtyIDs @[]int

	// CurAsm is a transient back-channel to the assembler the current
	// emitFunc is emitting into, stamped once per function so the occupancy-
	// aware allocator (allocReg) can emit a spill store when it must evict a
	// dirty (lazy-spilled) value — the allocator is reached from many emitter
	// call sites without an assembler param.  nil on the eager-spill path.
	CurAsm @asm.Assembler

	// CurLive is the id-indexed set of values live at the point the emit loop
	// is emitting — before the current instruction while it is emitted, after
	// it once it has been — stamped by the loop so an eviction can skip storing
	// a dirty value nothing reads again (StoreOnEvict).  Empty outside the
	// loop, where every dirty victim is stored.
	CurLive @[]bool

	// BoundsSeq is a per-function monotonic counter for inline
	// bounds-check labels (L<funcSym>__bc<seq>{f,o}).  The void
	// OP_BOUNDS_CHECK has no usable Instr.ID (it is -1), so its fail /
	// ok local labels are numbered from here instead; it resets per
	// function with the rest of the RegMap (make(RegMap) zeroes it).
	// See common.BoundsLabel.
	BoundsSeq int

	// Stack-slot map for OP_ALLOC. An alloca's address is stable for
	// the whole function; LOAD/STORE through it references the same
	// frame slot every time.
	AllocIDs     @[]int
	AllocOffsets @[]int
	AllocSizes   @[]int

	// Spill-slot map: every non-void SSA value is spilled here after
	// computation so a later use can reload.
	SpillIDs     @[]int
	SpillOffsets @[]int

	// FrameSize is set by PlanFrame and returned by FrameSize() so
	// epilogue emission stays in sync with prologue. Spill slots
	// aren't uniformly 8 bytes (aggregates reserve dedicated data
	// regions; multi-return packs N*8), so we cache the value rather
	// than recomputing it from slot counts.
	FrameSize int

	// OutgoingArgsSize is the byte count reserved at the bottom of
	// the frame ([sp+0..OutgoingArgsSize)) for AAPCS-style stack-
	// passed arguments. PlanFrame walks every OP_CALL in f and
	// takes the max stack-arg space; spills/allocas land at offsets
	// >= OutgoingArgsSize. A callee reads incoming stack args at
	// [sp + FrameSize + 16 + i*8] (the +16 covers the saved fp/lr
	// pushed on entry).
	OutgoingArgsSize int

	// SretSlotOff is the offset of the hidden 8-byte slot that
	// holds the sret buffer pointer when this function returns an
	// aggregate (or multi-return tuple) above the target's sret
	// threshold. -1 if the function doesn't use sret (a small or
	// scalar return). The prologue stores the incoming sret pointer
	// into this slot (from X8 on AAPCS64, or the first GP arg reg —
	// RDI / R0 — on SysV-AMD64 / AAPCS32); emitReturn loads it back
	// to copy the result bytes.
	SretSlotOff int

	// MultiReturnType is f.MultiReturnType captured at PlanFrame
	// time for emitReturn's use. nil if the function doesn't have
	// a multi-return tuple (single-result or void). When the
	// tuple is above the target's sret threshold, emitReturn writes
	// each return value through the sret buffer pointer at
	// FieldOffset(MultiReturnType, i) instead of packing into the
	// return registers.
	MultiReturnType @types.Type

	// CC is the target calling convention. Backends stamp it onto
	// the RegMap before calling PlanFrame; the parameterised
	// helpers in package callconv (CallStackBytes,
	// FuncReturnsBigAggregate, etc.) read it via rm.CC.X(...).
	// Zero-valued CC means "not set" — PlanFrame requires at least
	// NumGpArgRegs > 0 to plan a frame.
	CC callconv.CallConv

	// Home-register allocation (the linear-scan result), distinct from
	// the transient IDs/Regs scratch map above.  HomeIDs[k] -> HomeRegs[k]
	// is the STABLE physical register a value lives in for its whole
	// lifetime; unlike IDs/Regs it survives ResetRegs and block
	// boundaries.  Populated by AllocateRegisters (empty until then, so a
	// backend that never calls it keeps the pure spill-everything path).
	HomeIDs  @[]int
	HomeRegs @[]int

	// SavedRegs is the set of callee-saved registers AllocateRegisters
	// handed out (sorted, deduplicated) — the prologue saves and the
	// epilogue restores exactly these.  SavedRegsBytes is their frame
	// reservation (len*8 rounded to 16 for SP alignment), which PlanFrame
	// lays down at SavedRegsOff (just above the outgoing-args area, inside
	// the frame so it does not perturb the fp/lr chain or the incoming
	// stack-arg base).  All zero/empty when AllocateRegisters was not run.
	SavedRegs      @[]int
	SavedRegsBytes int
	SavedRegsOff   int

	// SavedFpRegs is the FP-class analogue of SavedRegs: the callee-saved FP
	// (V/D) registers the FP linear-scan pass (AllocateFpRegisters) handed out,
	// which the prologue saves and the epilogue restores with the D-register
	// load/store forms (not GP Str/Ldr — a D-number masks to the wrong X reg).
	// Kept separate from SavedRegs because the GP save loop and its len*8 byte
	// count assume GP stores.  SavedFpRegsBytes is their frame reservation
	// (len*8 rounded to 16); PlanFrame lays it down at SavedFpRegsOff.  Empty on
	// backends that do not run the FP pass.
	SavedFpRegs      @[]int
	SavedFpRegsBytes int
	SavedFpRegsOff   int

	// FoldedDtor is a dense id-indexed flag set (element [id] true iff the
	// OP_FUNC_HANDLE value id is used only as an OP_REFDEC destructor operand),
	// populated by AllocateRegisters when foldRefDecDtorHandles is set (all three
	// native backends set it).  Such a handle is materialized lazily in the inline
	// RefDec slow path, so the backend skips its standalone emission and the
	// allocator leaves it unhomed.  Empty when a backend passes false.
	FoldedDtor @[]bool

	// FusableGep is a dense id-indexed flag set (element [id] true iff the
	// OP_GET_ELEM_PTR value id folds into a scaled register-offset load/store —
	// see FusableElemGeps).  A backend that supports the fold (aa64) sets this
	// BEFORE AllocateRegisters, so the allocator leaves those GEP results unhomed
	// (nothing reads them as a register) and the emitter skips their standalone
	// emission.  Empty on backends without the fold (x64 / arm32 today).
	FusableGep @[]bool

	// FusableFieldGep is the constant-offset analogue of FusableGep for
	// OP_GET_FIELD_PTR: element [id] true iff the field GEP folds into its sole
	// consuming load/store's memory operand (`[base, #FieldByteOffset]`) — see
	// FusableFieldGeps.  Set by the backend BEFORE AllocateRegisters, which
	// unions it into the liveness fusable set and skips homing the folded GEPs.
	// Independent of FusableGep (a value is at most one GEP kind), and supported
	// on all three backends (aa64 / x64 / arm32) since every one has a
	// constant-displacement memory form.
	FusableFieldGep @[]bool

	// Fold-candidate flag sets — dense id-indexed flags (element [id] true iff that
	// value is a fold candidate), each produced by the named fold analysis and
	// assigned by a backend BEFORE AllocateRegisters: the allocator then leaves the
	// folded value unhomed (nothing reads it as a register) and the emitter skips
	// its standalone emission, riding it in the consuming instruction instead.  Each
	// is empty on a backend that does not enable that fold.
	//   FusedCmp     — an integer compare fuses into its consuming conditional
	//                  branch (flag-setting compare + condition-coded branch, no
	//                  0/1 boolean); BranchFusedCmps.
	//   FoldedImm    — an OP_CONST_INT every use of which rides its user's
	//                  immediate operand (`cmp #imm`, `add #imm`, ...), as decided
	//                  by the backend's fit predicate; fold.ImmOperandConsts.
	//   TstFoldedAnd — an OP_AND folds with its `== 0` / `!= 0` compare into one
	//                  flag-setting `tst` tested via Z; fold.TstFoldableAnds.
	FusedCmp     @[]bool
	FoldedImm    @[]bool
	TstFoldedAnd @[]bool

	// Memoized id->index side tables for the O(1) Lookup{Home,Spill,Alloc}
	// accessors, which the emitters hit once per operand — a linear scan over
	// the parallel arrays is O(operands * table).  Each is an id-indexed slot
	// array (dense ids in [0, NextID); -1 = absent) paired with the backing
	// array length it was built for; a lookup rebuilds it iff that length has
	// changed.  Length is a sound freshness key because the backing tables are
	// only appended to (PlanFrame / AllocateRegisters) or shrunk (UnhomeIDs) or
	// cleared — never element-mutated in place at a fixed length.  Lazily
	// populated (empty until the first lookup), so make(RegMap) needs no setup.
	spillIdx    @[]int
	spillIdxLen int
	allocIdx    @[]int
	allocIdxLen int
	homeIdx     @[]int
	homeIdxLen  int
}

// RegClassDesc is the per-arch register inventory the linear-scan
// allocator draws from (opaque physical register numbers; see
// native/common/regalloc_scan.bn).  A backend constructs one and passes it
// to RegMap.AllocateRegisters.
type RegClassDesc struct {
	// CallerSaved is the caller-saved allocatable pool — destroyed by any
	// returning call, so only values not live across a clobber may use it.
	CallerSaved @[]int
	// CalleeSaved is the callee-saved allocatable pool — preserved across a
	// call (the prologue saves/restores whichever are used).
	CalleeSaved @[]int
	// ExtraClobberOps are ops whose lowering UNCONDITIONALLY (regardless of
	// operand type) clobbers caller-saved on THIS backend beyond
	// common.EmitsReturningBl — a backend that lowers some op to a runtime call
	// its peers inline lists it here so a value live across it is not left in a
	// caller-saved register.  Currently empty on all backends (every backend now
	// inlines RefInc/RefDec; RefDec's conditional free-path call is already
	// covered by EmitsReturningBl).
	ExtraClobberOps @[]int
	// Int64OpsClobber: on this backend the 64-bit integer ops that have no
	// hardware form lower to library calls that clobber caller-saved registers
	// (arm32 __aeabi_l*): OP_MUL / OP_DIV / OP_REM / OP_SHL / OP_SHR with a
	// 64-bit integer result, AND an OP_CAST between a 64-bit integer and a
	// float (no VFP 64-bit-int<->float convert, so it is a libcall on BOTH the
	// soft- and hard-float ABIs — hence covered here, not by SoftFloatOpsClobber).
	// false where these are hardware instructions (aarch64/x64).  Inline
	// register-pair sequences (int64 ADD/SUB/AND/OR/XOR/compare, int-int64
	// widen/narrow CAST) never trigger it.
	Int64OpsClobber bool
	// SoftFloatOpsClobber: on this backend floating-point arithmetic /
	// comparison / (non-int64) conversion lowers to soft-float library calls
	// that clobber caller-saved registers (arm32 soft-float __aeabi_[fd]*).
	// false where FP is hardware (aarch64/x64, or arm32 under Arm32HardFloat —
	// VFP touches no GP register).  int64<->float CAST is NOT gated by this (it
	// is a libcall even under hard-float); it lives under Int64OpsClobber.
	SoftFloatOpsClobber bool
	// TieOps are the opcodes whose lowering on THIS backend, in this register
	// class, reads every operand before writing the result, so the result may
	// share the register of an operand that dies at the instruction (see
	// native/common/regalloc_coalesce.bn).  Empty disables sharing at any
	// position where both values are live.
	TieOps @[]int
}

// Lookups. Return -1 on miss.
func (m @RegMap) LookupAlloc(id int) int

func (m @RegMap) LookupAllocSize(id int) int

func (m @RegMap) LookupSpill(id int) int

func (m @RegMap) LookupReg(id int) int

// AssignReg records that SSA id = reg (the arch-specific register
// number). Returns reg. ResetRegs clears the live-register table but
// preserves the stable stack-frame tables.
func (m @RegMap) AssignReg(id int, reg int) int

func (m @RegMap) ResetRegs()

// Current-instruction register-claim tracking, for occupancy-aware
// allocation under within-block value retention (see RegMap.CurUsed).
func (m @RegMap) MarkUsed(reg int)

func (m @RegMap) IsUsed(reg int) bool

func (m @RegMap) ClearUsed()

func (m @RegMap) RegHeldBy(reg int) int

func (m @RegMap) EvictReg(reg int)

// NewRegMap returns a freshly-constructed RegMap with cc pre-stamped.
// The preferred constructor — backends should never `make(RegMap)`
// directly, since that would leave m.CC zero-valued.
func NewRegMap(cc callconv.CallConv) @RegMap

// AppendInt is exposed because per-arch code sometimes grows its own
// tables (e.g. recording param data regions in the prologue).
func AppendInt(s @[]int, v int) @[]int

// PlanFrame sizes and lays out the frame for f, filling in m. The
// returned size is 16-byte aligned; it's also cached on m.FrameSize
// (use m.FrameSize() in the epilogue). Requires m.CC to be set.  If
// AllocateRegisters was called first, PlanFrame reserves the callee-saved
// save area (m.SavedRegsBytes at m.SavedRegsOff).
func (m @RegMap) PlanFrame(f @ir.Func) int

func (m @RegMap) FrameSize() int

// AllocateRegisters runs the linear-scan register allocator for f (liveness
// -> range-list intervals -> clobber points -> scan) and records the result
// on m: HomeIDs/HomeRegs (the stable id -> physical-register map),
// SavedRegs (the callee-saved registers used), and SavedRegsBytes /
// SavedRegsOff will be honored by a subsequent PlanFrame.  Call it BEFORE
// PlanFrame.  wordBytes is the target word size (8 for aa64/x64, 4 for
// arm32); it must match the active types target.  A backend that never
// calls this keeps the pure spill-everything path.
//
// foldRefDecDtorHandles enables the RefDec dtor-handle fold (every native
// backend's inline RefDec materializes the `&__handle.<dtor>` operand in its
// slow path): it populates m.FoldedDtor and excludes those handles from homing.
// Pass false on a backend whose RefDec always consumes the handle.
func (m @RegMap) AllocateRegisters(f @ir.Func, wordBytes int, desc RegClassDesc,
		foldRefDecDtorHandles bool)

// LookupHome returns the stable home register assigned to SSA id, or -1 if
// id is spilled or was not register-allocated.
func (m @RegMap) LookupHome(id int) int

// StoreOnEvict reports whether a dirty value id evicted from its register must
// first be stored to its slot: true unless the emit loop's CurLive says id is
// dead at this point.
func (m @RegMap) StoreOnEvict(id int) bool

// SameHome reports whether ids a and b are both homed in the same register (the
// allocator tied them), so a copy from one to the other needs no code.
func (m @RegMap) SameHome(a int, b int) bool

// IsFoldedDtorHandle reports whether the OP_FUNC_HANDLE value id was folded
// into an inline RefDec's slow path (see FoldedDtor / AllocateRegisters).  The
// aa64 / arm32 dispatch skips the standalone emission of such a handle.  Always
// false when the fold was not enabled.
func (m @RegMap) IsFoldedDtorHandle(id int) bool

// IsFusableElemGep reports whether the OP_GET_ELEM_PTR value id folds into a
// scaled register-offset load/store (see FusableGep / FusableElemGeps).  The
// aa64 emitter skips the GEP's standalone emission and rederives the address in
// the consuming load/store.  Always false when the fold was not enabled.
func (m @RegMap) IsFusableElemGep(id int) bool

// IsFusableFieldGep reports whether the OP_GET_FIELD_PTR value id folds into a
// constant-offset load/store (see FusableFieldGep / FusableFieldGeps).  The
// emitter skips the GEP's standalone emission and rederives the address in the
// consuming load/store.  Always false when the fold was not enabled.
func (m @RegMap) IsFusableFieldGep(id int) bool

// IsFusedCmp reports whether the integer-comparison value id fuses into the
// conditional branch that consumes it (see FusedCmp / BranchFusedCmps).  A
// backend that supports flag-branch fusion emits only a flag-setting compare for
// the value and tests the flags at the branch, so nothing reads its 0/1 boolean
// as a register.  Always false when the fusion was not enabled.
func (m @RegMap) IsFusedCmp(id int) bool

// IsFoldedImm reports whether the OP_CONST_INT value id rides the immediate
// operand of every one of its users (see FoldedImm / fold.ImmOperandConsts) —
// the backend skips materializing it and each consuming emitter takes its value
// as an immediate.  Always false when the fold was not enabled.
func (m @RegMap) IsFoldedImm(id int) bool

// IsTstFoldedAnd reports whether the OP_AND value id folds into a `tst` with its
// consuming `== 0` / `!= 0` compare (see TstFoldedAnd / fold.TstFoldableAnds).
// Always false when the fold was not enabled.
func (m @RegMap) IsTstFoldedAnd(id int) bool

// IsFoldedAway reports whether value id is flagged in any fold set — FoldedImm,
// FusedCmp, TstFoldedAnd, FusableGep, FusableFieldGep, or FoldedDtor.  Such a
// value is never materialized into a register or its spill slot (the allocator
// leaves it unhomed and the emitter skips it or rides it in its consumer), so no
// emitter may read it as an operand: a backend's operand fetch fails loud on it
// rather than reloading a slot that was never written.
func (m @RegMap) IsFoldedAway(id int) bool

// UnhomeIDs removes from the home map every id flagged in drop (id-indexed; an
// id outside it is kept), reverting each to its spill slot, in one pass over the
// map.  A backend calls this after AllocateRegisters to opt values out of homing
// — e.g. arm32 un-homes call operands, whose caller-saved home (R0..R3) would be
// clobbered by the call's argument/target setup.
func (m @RegMap) UnhomeIDs(drop @[]bool)

// RequireTerminated panics unless f has at least one block and each of its
// blocks ends in a terminator.  The native emitters lay a function's blocks out
// back to back with nothing after the last one, so a block that did not end in a
// terminator would run on into whatever follows it; IR-gen ends every block in
// one, so this fires only on malformed IR.
func RequireTerminated(f @ir.Func)

// EmitsReturningBl reports whether op's native lowering emits a call that can
// RETURN to the next instruction (the arch-neutral core of the clobber model:
// the call family, make / box / make-slice, refdec's conditional dtor call, the
// div/shift guards, sat-lookup, stack-frames, rodata-mslice-copy).  A backend
// consults it to find the ops whose lowering marshals operands into the
// argument registers (arm32 un-homes those operands).
func EmitsReturningBl(op int) bool

// IsAllocatableDef reports whether ins produces a register-allocatable scalar
// (the liveness universe: non-void, non-aggregate, non-float, non-alloca, not a
// 32-bit-target int64).  A backend uses it to gate lazy spill: an allocatable
// result is dirty-marked (its store deferred), a non-allocatable result keeps
// the eager store.
func IsAllocatableDef(ins @ir.Instr, wordBytes int) bool

// ComputeLiveBeforeAll returns per-block, per-instruction live-BEFORE sets:
// result[bi][ii] is the allocatable ids live just before instruction ii of
// block bi, and result[bi][len(block.Instrs)] is LiveOut[bi] (live after the
// last instruction).  Lazy spill consults it at cache-drop points to spill the
// still-live dirty values and elide the dead ones.
func ComputeLiveBeforeAll(f @ir.Func, wordBytes int) @[]@[]@[]bool

// ComputeLiveBeforeAllFused is ComputeLiveBeforeAll with the fusable element-GEP
// set (aa64), so lazy spill sees a folded GEP's base+index live to the consuming
// load/store rather than to the elided GEP.  Pass an empty set for no fold.
func ComputeLiveBeforeAllFused(f @ir.Func, wordBytes int, fusable @[]bool) @[]@[]@[]bool

// FusableElemGeps returns a dense id-indexed flag set: element [id] true iff the
// OP_GET_ELEM_PTR value id can fold into a scaled register-offset load/store (a
// single-use 8-byte GP element access off a register base).  A backend with the
// addressing mode assigns it to m.FusableGep before AllocateRegisters.
func FusableElemGeps(f @ir.Func, allowFloat bool) @[]bool

// FusableFieldGeps returns a dense id-indexed flag set: element [id] true iff the
// OP_GET_FIELD_PTR value id can fold into a constant-offset load/store (a
// single-use scalar field access off a register or alloca base, with a
// resolvable field offset — which, for a register base on a 32-bit target, must
// also be in range; an alloca base's combined offset is range-checked by the
// backend's emitter instead).  A backend
// assigns it to m.FusableFieldGep before AllocateRegisters.  wordBytes is the
// target word size (8 on aa64/x64, 4 on arm32), matching AllocateRegisters.
// allowFloat admits float-typed field accesses — set it only when the backend's
// fused field load/store handles a float value (moving an FP-homed one straight
// between its FP home and memory).  On a 32-bit target it also admits float64
// fields, so a 32-bit backend that sets it must fold the field GEP in its
// separate 64-bit load/store path too.
func FusableFieldGeps(f @ir.Func, wordBytes int, allowFloat bool) @[]bool

// FieldByteOffset returns the byte offset an OP_GET_FIELD_PTR addresses (struct
// FieldOffset, or wordBytes*Index for a slice-descriptor field), and ok=false
// when the base is neither.  The fused load/store consumers compute the folded
// offset with it, so all backends agree with FusableFieldGeps' offset gate.
func FieldByteOffset(gep @ir.Instr, wordBytes int) (int, bool)

// UnionFusable returns the id-indexed OR of two GEP fold flag sets (element and
// field), sized to the longer, for a backend to feed the combined set to
// ComputeLiveBeforeAllFused — matching the union AllocateRegisters forms
// internally.  Returns the non-empty operand unchanged when the other is empty.
func UnionFusable(a @[]bool, b @[]bool) @[]bool

// Type / value predicates used by the lowering rules.
func InstrIsVoid(ins @ir.Instr) bool

func CallReturnsVoid(ins @ir.Instr) bool

// StringLabel returns the local symbol for string constant `id` (`lstr_<id>`): local,
// so never exported, and — like clang's `l_.str` — not an assembler temporary (`L`),
// so a Mach-O object lists it and each literal is its own atom (dead-stripped on
// its own, and referenced without an offset from a section anchor).
// Object-format- and arch-independent; shared by every native backend.
func StringLabel(id int) @[]char

// BoundsLabel returns the local assembler label for an inline bounds check's
// fail (fail=true) or ok-continuation (fail=false) target
// (`L<funcSym>__bc<seq>{f,o}`) — 'L'-prefixed local, namespaced by funcSym +
// the per-function RegMap.BoundsSeq so it never collides.  Shared by every
// native backend's inline OP_BOUNDS_CHECK lowering.
func BoundsLabel(funcSym @[]char, seq int, fail bool) @[]char

// StripQuotes drops a surrounding pair of double quotes from `s` (e.g. a quoted
// module name), returning `s` unchanged when it is not so wrapped.
func StripQuotes(s *[]readonly char) *[]readonly char

// ObjFmtEq reports whether two object-format name slices are byte-equal (used to
// test a `format` argument against "elf" / "macho").
func ObjFmtEq(a *[]readonly char, b *[]readonly char) bool

// EmitDataGlobal lays one irdata.DataGlobal (a backend-neutral named static blob)
// into the assembler's data/rodata section — the native half of the
// irdata.DataGlobal unification, walking the same Init terms the LLVM
// emitDataGlobal does so the two backends cannot drift on byte layout.
func EmitDataGlobal(a @asm.Assembler, dg @irdata.DataGlobal)

// EmitPkgSatFrag lays this module's `__pkg_satfrag` graph node (decentralized
// satentry enumeration; the LLVM half is codegen.emitPkgSatFrag).  Emitted for
// EVERY package, AFTER emitPackageDescriptor so this module's own
// `__pkg_satentries` is defined first.  `prefix` is the active object-format
// linkage prefix; dep frags are SetGlobal (strong undefined refs) — every
// compiled package emits a node, so they resolve, and a strong ref pulls the
// defining object from a static archive.  See
// native/common/common_pkg_satfrag.bn.
func EmitPkgSatFrag(a @asm.Assembler, prefix *[]readonly char, mod @ir.Module)

// ReportEmitError prints the assembler's specific error message when a native
// EmitObject has failed, so the precise a.SetError reason (an unimplemented
// shape, or a frame offset the backend cannot encode) reaches the compile
// driver's output instead of being swallowed into the driver's generic "native
// backend failed to emit object (arch=...)" line.  Each backend's EmitObject
// calls this at its `if a.HasError` failure point; a no-op when a has no error.
func ReportEmitError(a @asm.Assembler, arch *[]readonly char)

// STATIC_MANAGED_REFCOUNT is the sentinel Refcount in an immortal
// static-managed header (mirrors rt.STATIC_REFCOUNT + the codegen copy) — the
// per-arch reflect-descriptor gather passes it to irdata.BuildPackageDescriptors.
const STATIC_MANAGED_REFCOUNT int = -1073741824

// ImplVtableBareName builds the canonical UNPREFIXED vtable name
// `__ivt.bn_V...` — the bytecode
// VM's lookup key (matches IR-gen / LLVM codegen / VM lowering).
func ImplVtableBareName(recvPkg *[]readonly char, recvTypeName *[]readonly char,
		ifacePkg *[]readonly char, ifaceName *[]readonly char) @[]char

// RecvTypeIsGenericInst reports whether an impl receiver type name carries the
// `__bn_inst__` monomorphization marker (such impls re-lower at the importer's
// use site, so the native descriptor excludes them).
func RecvTypeIsGenericInst(recvName *[]readonly char) bool

// FuncRetbufSize returns the VM-dispatch RetbufSize of a func-value type
// (0 void / SizeOf single result / multi-return tuple SizeOf).
func FuncRetbufSize(fv @types.Type) int

// SubWordNarrow reports how a sub-word integer result must be reduced
// to its type's value range: the width in bits (0 = no narrow needed)
// and whether the reduction is signed (sign-extend) vs unsigned
// (zero-extend).  Shared by the VM and native backends; wordBits is the
// target register width.
func SubWordNarrow(t @types.Type, wordBits int) (int, bool)

// IsUnsignedIntType reports whether t is a concrete unsigned integer
// type (excludes untyped int, which defaults to signed).  Picks the
// unsigned int↔float conversion across the VM and native backends.
func IsUnsignedIntType(t @types.Type) bool

// AggLoadElidable reports whether the aggregate OP_LOAD ld of f may read its
// source in place instead of copying it first: the source provably keeps the
// loaded bytes until ld's last use (a confined stack slot not re-stored before
// then, or nothing that writes or frees memory in between — scalar field reads
// of any size, whole copies of at most 16 bytes), and every use is a read in
// ld's block.  Shared by the native backends' frame planning and the LLVM
// backend's memory-backed loads, so both skip the same copies.
func AggLoadElidable(f @ir.Func, ld @ir.Instr) bool

// ParamRegionElidable reports whether p, a by-value aggregate parameter passed as
// a pointer to a copy of it, may use that incoming memory as its value instead of
// copying it into a region of its own: every use of p is the store of p into a
// stack slot at the top of the entry block, before anything that could write the
// caller's memory.  PlanFrame reserves no region for such a parameter, and each
// native backend's parameter spill then stores the incoming pointer itself.
func ParamRegionElidable(f @ir.Func, p @ir.Param) bool

func SpillHoldsAggregatePointer(ins @ir.Instr) bool

func ElemSizeOf(gep @ir.Instr) int

func StructTypeOf(ins @ir.Instr) @types.Type

// IsSliceFieldBase reports whether ins names a base whose
// OP_GET_FIELD_PTR fields are word-sized (managed-)slice fields rather
// than a struct's; peels transparent wrappers so a named-distinct
// slice (`type Buf @[]int`) is recognized.
func IsSliceFieldBase(ins @ir.Instr) bool

// AppendStr concatenates a raw `@[]char` buffer with another string —
// the native arches thread raw `@[]char` buffers (rather than CharBuf)
// while building symbol names.
func AppendStr(dst *[]readonly char, src *[]readonly char) @[]char

// ParseFloatLitToBits converts a decimal or hex float-literal text (which
// may carry a leading sign) to its IEEE 754 double-precision bit pattern.
// Delegates to pkg/std/strconv.ParseFloat — exact, correctly-rounded
// (round-half-to-even) — so every backend lowers the same literal to the
// same bits.
func ParseFloatLitToBits(text *[]readonly char) uint64

// F64BitsToF32Bits narrows an IEEE-754 double bit pattern to the single
// (float32) bit pattern, rounding to nearest with ties to even (handling
// overflow→±Inf and underflow→±denormal/zero).  Materializes a float32
// CONSTANT: a float32-typed literal carries its narrowed 32-bit value,
// not the low 32 bits of the float64 pattern.
func F64BitsToF32Bits(b uint64) uint32

// PlanParallelMove returns the ordered register moves realizing the parallel copy
// { dsts[i] <- srcs[i] } — after emitting each returned [dst,src] pair as `mov
// dst, src` in order, every dst holds the value its src held on entry, even when
// the moves permute or chain.  Cycles are broken through `temp` (must be neither a
// src nor a dst of any move).  Identity moves are dropped; dsts must be distinct.
// Used by call marshalling once values can be homed in the ABI argument registers.
func PlanParallelMove(srcs @[]int, dsts @[]int, temp int) @[]int
