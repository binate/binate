package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"

// LookupAlloc returns the SP-relative offset of an OP_ALLOC value (or
// of any op that reserves a dedicated data region via AllocIDs —
// notably OP_MAKE_SLICE and aggregate OP_CONST_NIL), or -1 if id has
// no such region.
func (m @RegMap) LookupAlloc(id int) int {
	for i := 0; i < len(m.AllocIDs); i++ {
		if m.AllocIDs[i] == id { return m.AllocOffsets[i] }
	}
	return -1
}

// LookupAllocSize returns the byte size of an alloca/data-region slot,
// or -1.
func (m @RegMap) LookupAllocSize(id int) int {
	for i := 0; i < len(m.AllocIDs); i++ {
		if m.AllocIDs[i] == id { return m.AllocSizes[i] }
	}
	return -1
}

// LookupSpill returns the SP-relative offset of a spilled SSA value,
// or -1 if not spilled.
func (m @RegMap) LookupSpill(id int) int {
	for i := 0; i < len(m.SpillIDs); i++ {
		if m.SpillIDs[i] == id { return m.SpillOffsets[i] }
	}
	return -1
}

// LookupReg returns the arch-specific register holding SSA id, or -1
// if not found.
func (m @RegMap) LookupReg(id int) int {
	for i := 0; i < len(m.IDs); i++ {
		if m.IDs[i] == id { return m.Regs[i] }
	}
	return -1
}

// AssignReg records that SSA id = reg (the arch-specific register
// number) and returns reg. Callers typically use this after picking a
// register from their arch's pool (e.g. the arm64 regPool).
func (m @RegMap) AssignReg(id int, reg int) int {
	m.IDs = AppendInt(m.IDs, id)
	m.Regs = AppendInt(m.Regs, reg)
	return reg
}

// ResetRegs clears the register map but leaves alloc/spill tables
// intact — those describe the stable stack frame, not transient live
// values.
func (m @RegMap) ResetRegs() {
	var emptyIDs @[]int
	var emptyRegs @[]int
	m.IDs = emptyIDs
	m.Regs = emptyRegs
	m.Next = 0
}

// NewRegMap returns a freshly-constructed RegMap pre-stamped with the
// caller's CallConv. Every backend should reach RegMap through this
// constructor so PlanFrame and the CC-parameterised helpers always
// see a non-zero NumGpArgRegs.  SretSlotOff is pre-initialised to
// -1 (PlanFrame sets it to >= 0 only for sret-returning functions);
// without this, unit tests that construct a RegMap without running
// PlanFrame would see the default 0, which is a valid stack offset
// and trips sret-detection branches like
// `if rm.SretSlotOff >= 0`.
func NewRegMap(cc CallConv) @RegMap {
	var m @RegMap = make(RegMap)
	m.CC = cc
	m.SretSlotOff = -1
	return m
}

// AppendInt grows an @[]int by one. O(n) copy; fine for the small
// (per-function) sizes here.
func AppendInt(s @[]int, v int) @[]int {
	var out @[]int = make_slice(int, len(s)+1)
	for i := 0; i < len(s); i++ {
		out[i] = s[i]
	}
	out[len(s)] = v
	return out
}

// ============================================================
// Frame planning
// ============================================================

// PlanFrame assigns a stack slot to every function parameter and every
// value-producing SSA instruction. Returns the 16-byte-aligned total
// frame size (also cached on m.FrameSize).
//
// Slot sizes:
//   - OP_ALLOC: TypeArg.SizeOf(), rounded up to 8.
//   - Aggregate-producing OPs whose SSA value is a *pointer* to a
//     dedicated data region (OP_MAKE_SLICE; aggregate OP_CONST_NIL):
//     a Typ.SizeOf() data region (via AllocIDs) PLUS an 8-byte
//     spill slot for the pointer.
//   - Multi-return calls (OP_CALL returning TYP_STRUCT):
//     N*8-byte spill slot so X0..X(N-1) can be packed at slot + 8*i.
//   - Aggregate params: same as OP_MAKE_SLICE — data region + pointer
//     spill slot. Callee prologue writes the N arg-reg words into the
//     data region.
//   - Everything else: 8-byte spill slot.
//
// Under the "spill everything" policy, the register allocator is
// trivial: a rotating small pool, with operands reloaded from their
// slot on use. Correct but slow; a real allocator can reclaim later.
func (m @RegMap) PlanFrame(f @ir.Func) int {
	// Walk every call in f to find the largest outgoing-args area
	// any single call needs. That region sits at [sp+0..outgoing) so
	// the caller can write stack args without disturbing its own SP.
	// Spill/alloc offsets are shifted up by `outgoing` below.
	var outgoing int = 0
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if !isCallOp(ins.Op) {
				continue
			}
			// OP_C_CALL variadic args may need extra stack
			// reservation on darwin-arm64 (Apple stacks every
			// vararg); fixedCount = len for OP_CALL so the V-variant
			// sizing reduces to the base helper there.
			// callDispatchArgTypesAnyOp handles each call op's
			// arg-shape (direct vs func-value vs indirect-ptr) —
			// must include func-value / handle / indirect, or the
			// outgoing-args area won't be reserved for those calls
			// and closure-struct locals overlap with outgoing args
			// at the call site (the 523_closure_many_user_args
			// bug).
			var argTypes @[]@types.Type =
				callDispatchArgTypesAnyOp(m.CC, ins)
			var fixedCount int = len(argTypes)
			if ins.Op == iropcode.OP_C_CALL {
				fixedCount = ins.CFixedArgs
				if len(argTypes) > len(ins.Args) {
					// Sret pointer was prepended — it's a fixed
					// (non-variadic) leading arg; shift the
					// caller-supplied fixed/variadic split up by 1.
					fixedCount = fixedCount + 1
				}
			}
			var sb int = m.CC.CallStackBytesV(argTypes, fixedCount)
			if sb > outgoing { outgoing = sb }
		}
	}
	m.OutgoingArgsSize = outgoing
	m.SretSlotOff = -1
	m.MultiReturnType = f.MultiReturnType
	var offset int = outgoing

	// If f returns a single aggregate larger than the internal sret
	// threshold (cc.InternalSretBytes — 16 on AAPCS64), or a multi-
	// return tuple whose total size exceeds it, AAPCS-style sret:
	// the caller hands a buffer pointer in X8, the callee writes
	// the result through it. We stash X8 in a hidden 8-byte slot at
	// function entry so emitReturn can load it back.
	if m.CC.FuncReturnsBigAggregate(f) || m.CC.FuncReturnsBigMultiReturn(f) {
		m.SretSlotOff = offset
		offset = offset + 8
	}

	// Parameters come first so entry-point register stores can find
	// their slots by ID. Aggregate (slice) params are passed spread
	// across multiple arg registers; we reserve a data region for the
	// bytes plus an 8-byte spill slot that holds a pointer to that
	// region, matching OP_MAKE_SLICE / OP_LOAD's aggregate form so
	// downstream OP_STORE-struct-copy and OP_EXTRACT just work.
	for pi := 0; pi < len(f.Params); pi++ {
		var p @ir.Param = f.Params[pi]
		if IsAggregateTyp(p.Typ) {
			var dataSz int = p.Typ.SizeOf()
			if dataSz > 0 {
				m.AllocIDs = AppendInt(m.AllocIDs, p.ID)
				m.AllocSizes = AppendInt(m.AllocSizes, dataSz)
				m.AllocOffsets = AppendInt(m.AllocOffsets, offset)
				offset = offset + dataSz
			}
		}
		m.SpillIDs = AppendInt(m.SpillIDs, p.ID)
		m.SpillOffsets = AppendInt(m.SpillOffsets, offset)
		offset = offset + 8
	}

	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if ins.Op == iropcode.OP_ALLOC {
				var sz int = 8
				if ins.TypeArg != nil { sz = ins.TypeArg.SizeOf() }
				if sz < 8 { sz = 8 }
				if sz % 8 != 0 { sz = sz + (8 - sz % 8) }
				m.AllocIDs = AppendInt(m.AllocIDs, ins.ID)
				m.AllocSizes = AppendInt(m.AllocSizes, sz)
				m.AllocOffsets = AppendInt(m.AllocOffsets, offset)
				offset = offset + sz
			} else if ins.ID >= 0 &&
					(!InstrIsVoid(ins) || isIndirectCallOp(ins.Op)) {
				// These ops produce an aggregate VALUE that must live in
				// the frame: each gets a dedicated data region, and its
				// spill slot then holds a *pointer* to that region, so
				// downstream OP_EXTRACT / OP_STORE can treat every
				// aggregate value uniformly (a pointer to its bytes).
				//
				// OP_LOAD is included so an aggregate load OWNS its bytes
				// rather than aliasing the source object.  The alias is
				// unsound when the source is a local the function's
				// cleanup RefDecs before the loaded value is consumed —
				// e.g. `return container[i]`, whose element header lives
				// in `container`'s backing and is copied into the sret
				// buffer only after `container`'s dtor has freed that
				// backing, yielding an empty/garbage result.  Copying at
				// the load point (before any cleanup) matches the LLVM
				// backend, which loads the aggregate into an SSA value at
				// the load site.
				if (ins.Op == iropcode.OP_MAKE_SLICE ||
					(ins.Op == iropcode.OP_LOAD &&
						IsAggregateTyp(ins.Typ)) ||
					(ins.Op == iropcode.OP_CONST_NIL &&
						IsAggregateTyp(ins.Typ)) ||
					(ins.Op == iropcode.OP_RODATA_MSLICE &&
						IsAggregateTyp(ins.Typ)) ||
					(ins.Op == iropcode.OP_RODATA_SLICE &&
						IsAggregateTyp(ins.Typ)) ||
					(ins.Op == iropcode.OP_RODATA_ARRAY &&
						IsAggregateTyp(ins.Typ)) ||
					(ins.Op == iropcode.OP_RODATA_MSLICE_COPY &&
						IsAggregateTyp(ins.Typ)) ||
					ins.Op == iropcode.OP_FUNC_VALUE ||
					ins.Op == iropcode.OP_IFACE_VALUE ||
					ins.Op == iropcode.OP_IFACE_UPCAST ||
					(ins.Op == iropcode.OP_CALL &&
						IsAggregateTyp(ins.Typ) &&
						!IsMultiReturnCall(ins)) ||
					(ins.Op == iropcode.OP_CALL_FUNC_VALUE &&
						IsAggregateTyp(ins.Typ) &&
						!IsMultiReturnCall(ins)) ||
					(ins.Op == iropcode.OP_CALL_IFACE_METHOD &&
						IsAggregateTyp(ins.Typ) &&
						!IsMultiReturnCall(ins))) &&
					ins.Typ != nil {
					var dataSz int = ins.Typ.SizeOf()
					if dataSz > 0 {
						// Round up to 8-byte multiple so subsequent
						// 64-bit STR/LDR stay aligned and so that
						// emitStringToArray's word-wise zero-fill
						// doesn't run past the buffer end (e.g. a
						// [5]char array gets 8 bytes here).
						if dataSz % 8 != 0 {
							dataSz = dataSz + (8 - dataSz % 8)
						}
						m.AllocIDs = AppendInt(m.AllocIDs, ins.ID)
						m.AllocSizes = AppendInt(m.AllocSizes, dataSz)
						m.AllocOffsets = AppendInt(m.AllocOffsets, offset)
						offset = offset + dataSz
					}
				}
				m.SpillIDs = AppendInt(m.SpillIDs, ins.ID)
				m.SpillOffsets = AppendInt(m.SpillOffsets, offset)
				// Multi-return calls reserve enough contiguous bytes
				// for the entire tuple so X0..X(N-1) can land at
				// FieldOffset(tuple, i). Named struct returns go
				// through the pointer-form branch above instead, so
				// we key on IsMultiReturnCall rather than bare
				// TYP_STRUCT. The byte count is tuple.SizeOf()
				// — fields can themselves be aggregates (e.g. a
				// multi-return of `(Tab, int)` where Tab is 5 words)
				// so 8 * field-count would under-allocate.
				var slotSz int = 8
				if IsMultiReturnCall(ins) {
					slotSz = ins.Typ.SizeOf()
					if slotSz % 8 != 0 {
						slotSz = slotSz + (8 - slotSz % 8)
					}
					if slotSz < 8 { slotSz = 8 }
				}
				offset = offset + slotSz
			}
		}
	}
	var size int = offset
	if size % 16 != 0 {
		size = size + (16 - size % 16)
	}
	m.FrameSize = size
	return size
}

// FrameSize returns the frame size computed by PlanFrame.
func (m @RegMap) FrameSize() int { return m.FrameSize }


// ============================================================
// Type predicates
// ============================================================

// InstrIsVoid reports whether an instruction produces no SSA value.
func InstrIsVoid(ins @ir.Instr) bool {
	if ins.ID < 0 { return true }
	if ins.Typ == nil { return true }
	return ins.Typ.Kind == types.TYP_VOID
}

// isIndirectCallOp reports whether op is one of the indirect-call
// IR ops whose native lowering needs a SpillID slot to stash the
// function-pointer across the arg-dispatch loop — independent of
// whether the call returns a value.  Reason: on SysV-AMD64 the
// fn-ptr-stash scratch (R11) lives in the regPool, so the arg loop
// can clobber it; emitCallIndirect (and emitCallFuncValue) reload
// from the SpillID slot just before CALL.  If the call is void the
// outer condition's `!InstrIsVoid` would suppress the spill alloc,
// the reload becomes a no-op, and CALL fires with garbage in R11
// (the bug surfaced by pkg/vm.TestExternRtMakeManagedSliceViaRegistry
// on builder-comp_native_x64_darwin — the `_call_shim_aggregate`
// indirect call is void-returning).  AArch64 dodges the problem
// because it stashes in X17 (intra-call scratch, not in regPool).
func isIndirectCallOp(op int) bool {
	return op == iropcode.OP_CALL_INDIRECT ||
		op == iropcode.OP_CALL_FUNC_VALUE ||
		op == iropcode.OP_CALL_HANDLE ||
		op == iropcode.OP_CALL_IFACE_METHOD
}

// CallReturnsVoid reports whether an OP_CALL has no result (e.g.
// bootstrap.Exit).
func CallReturnsVoid(ins @ir.Instr) bool {
	if ins.Typ == nil { return true }
	return ins.Typ.Kind == types.TYP_VOID
}

// IsAggregateTyp reports whether a type is a struct, array, slice, or
// function value — i.e., not an in-register value. OP_LOAD passes a
// pointer through rather than materializing the bytes; OP_STORE does
// a memcpy. Function values share this category because their 2-word
// {vtable, data} layout doesn't fit in a single register.
func IsAggregateTyp(t @types.Type) bool {
	if t == nil { return false }
	t = peelTransparent(t)
	return t.Kind == types.TYP_STRUCT ||
		t.Kind == types.TYP_ARRAY ||
		t.Kind == types.TYP_MANAGED_SLICE ||
		t.Kind == types.TYP_SLICE ||
		t.Kind == types.TYP_FUNC_VALUE ||
		t.Kind == types.TYP_MANAGED_FUNC_VALUE ||
		t.Kind == types.TYP_INTERFACE_VALUE ||
		t.Kind == types.TYP_INTERFACE_VALUE_MANAGED
}

// IsFloatScalarTyp reports whether t is a float scalar (TYP_FLOAT or
// TYP_UNTYPED_FLOAT). Float scalars travel in the FP register file
// (D0..D7) under AAPCS64, separately from GP X-registers, so the
// NGRN-based dispatch helpers below skip them when counting X-reg
// budget. The NSRN counter for float args is tracked at the call site.
func IsFloatScalarTyp(t @types.Type) bool {
	if t == nil { return false }
	t = peelTransparent(t)
	return t.Kind == types.TYP_FLOAT || t.Kind == types.TYP_UNTYPED_FLOAT
}

// FloatScalarIsI32 reports whether a float scalar occupies a 32-bit integer
// slot (a float32) rather than a 64-bit one (float64 / untyped-float) in the
// all-int func-value shim ABI.  Mirrors floatSlotIsI32 in the LLVM backend
// (pkg/binate/codegen/emit_funcvals.bn): only a concrete TYP_FLOAT of Width 32
// is i32; float64 and untyped-float take the i64 slot.  The result is only
// meaningful when IsFloatScalarTyp(t) holds.
func FloatScalarIsI32(t @types.Type) bool {
	if t == nil { return false }
	t = peelTransparent(t)
	return t.Kind == types.TYP_FLOAT && t.Width == 32
}

// IsMultiReturnCall reports whether ins is a call whose result is an
// anonymous TYP_STRUCT — the IR's encoding for a function with multiple
// return values. Name="" distinguishes these from a real (named)
// struct-by-value return, which is an aggregate that needs pointer-form
// storage so downstream arg-spreading and struct-copy see it the same as
// LOAD / MAKE_SLICE results.
//
// The op set is exactly the three call ops the IR attaches a
// makeMultiReturnStructType result to: OP_CALL (gen_call.bn direct call),
// OP_CALL_FUNC_VALUE (gen_call.bn func-value call), and
// OP_CALL_IFACE_METHOD (gen_iface.bn — the CR-2 SEAM types a multi-return
// interface method as the same tuple struct). Recognizing the iface case
// is load-bearing: every downstream native site keys on this predicate
// (PlanFrame tuple-vs-pointer spill, the per-arch return collect, EXTRACT's
// SpillHoldsAggregatePointer split, CallReturnsBigMultiReturn). Without the
// iface arm an iface multi-return falls into the aggregate-single-return
// path, whose register-collect reads ArgWords words — which on aa64 (one
// register per tuple field) drops every field past the first eightbyte
// (e.g. `(uint16, uint16)` loses field 1). OP_CALL_INDIRECT / OP_CALL_HANDLE
// are absent because the IR never attaches a multi-return struct to them.
func IsMultiReturnCall(ins @ir.Instr) bool {
	if ins == nil || ins.Typ == nil { return false }
	if ins.Op != iropcode.OP_CALL && ins.Op != iropcode.OP_CALL_FUNC_VALUE &&
		ins.Op != iropcode.OP_CALL_IFACE_METHOD {
		return false
	}
	if ins.Typ.Kind != types.TYP_STRUCT { return false }
	return len(ins.Typ.Name) == 0
}

// SpillHoldsAggregatePointer reports whether ins's 8-byte spill slot
// holds a pointer to its data (as opposed to the data itself). True
// for every aggregate SSA value EXCEPT multi-return calls, which pack
// their N*8 bytes directly into the spill slot. This matters for
// OP_EXTRACT, which must indirect through the pointer in the former
// case but read at slot+8*Index in the latter.
func SpillHoldsAggregatePointer(ins @ir.Instr) bool {
	if ins == nil || !IsAggregateTyp(ins.Typ) { return false }
	if IsMultiReturnCall(ins) { return false }
	return true
}

// ElemSizeOf returns the element byte size for an OP_GET_ELEM_PTR
// instruction. The GEP's own result type is `*elemTyp` (set by
// ir.EmitGetElemPtr), which covers both array indexing and slice
// indexing (where the base pointer has already been extracted to a raw
// i8* and the element type lives only on the GEP itself).
func ElemSizeOf(gep @ir.Instr) int {
	if gep == nil || gep.Typ == nil || gep.Typ.Elem == nil { return 0 }
	return gep.Typ.Elem.SizeOf()
}

// StructTypeOf returns the struct type underlying a pointer-valued
// instruction, or nil if not a struct pointer.
func StructTypeOf(ins @ir.Instr) @types.Type {
	if ins == nil { return nil }
	// peelTransparent (not UnwrapNamed): a `readonly`/alias-wrapped struct
	// IS a struct for layout — peel the transparent wrappers so a field
	// access through a `readonly Big` pointer resolves its struct type.
	var ta @types.Type = peelTransparent(ins.TypeArg)
	if ta != nil && ta.Kind == types.TYP_STRUCT {
		return ta
	}
	if ins.Typ != nil {
		var el @types.Type = peelTransparent(ins.Typ.Elem)
		if el != nil && el.Kind == types.TYP_STRUCT { return el }
	}
	return nil
}

// AppendStr concatenates the raw byte slice src onto the managed @[]char
// dst and returns the resulting buffer.  O(n) per call — used when the
// native backends build mangled symbol names incrementally.  The same
// shape used to live in pkg/binate/native/{x64,aarch64}/_iface.bn as duplicate
// helpers (appendStrIface / appendStrLocal); shared here so both arches
// pick up future tweaks together.
func AppendStr(dst @[]char, src *[]readonly char) @[]char {
	var n int = len(dst)
	var ns @[]char = make_slice(char, n + len(src))
	for i := 0; i < n; i++ { ns[i] = dst[i] }
	for i := 0; i < len(src); i++ { ns[n + i] = src[i] }
	return ns
}

// AppendPkgIdent appends pkg's path to b, replacing every `/` with `__`
// so the result is identifier-safe.  Used by the native backends when
// folding package paths into vtable / method symbols.  Mirrors
// mangle.writePathIdent's transform on a CharBuf, applied here to a
// raw `@[]char` because the native iface code threads that shape
// rather than a CharBuf.  Previously duplicated as
// appendPkgIdent_x64 / appendPkgIdentNative.
func AppendPkgIdent(b @[]char, pkg *[]readonly char) @[]char {
	var start int = 0
	for i := 0; i < len(pkg); i++ {
		if pkg[i] == '/' {
			b = AppendStr(b, pkg[start:i])
			b = AppendStr(b, "__")
			start = i + 1
		}
	}
	b = AppendStr(b, pkg[start:len(pkg)])
	return b
}
