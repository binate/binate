package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/std/fmt"

// ============================================================
// Type predicates
// ============================================================

// InstrIsVoid reports whether an instruction produces no SSA value.
func InstrIsVoid(ins @ir.Instr) bool {
	if ins.ID < 0 { return true }
	if ins.Typ == nil { return true }
	return ins.Typ.Kind == types.TYP_VOID
}

// isIndirectCallOp reports whether op is one of the indirect-call
// IR ops whose native lowering needs a SpillID slot to stash the
// function-pointer across the arg-dispatch loop — independent of
// whether the call returns a value.  Reason: on SysV-AMD64 the
// fn-ptr-stash scratch (R11) lives in the regPool, so the arg loop
// can clobber it; emitCallIndirect (and emitCallFuncValue) reload
// from the SpillID slot just before CALL.  If the call is void the
// outer condition's `!InstrIsVoid` would suppress the spill alloc,
// the reload becomes a no-op, and CALL fires with garbage in R11
// (the bug surfaced by pkg/vm.TestExternRtMakeManagedSliceViaRegistry
// on builder-comp_native_x64_darwin — the `_call_shim_aggregate`
// indirect call is void-returning).  AArch64 dodges the problem
// because it stashes in X17 (intra-call scratch, not in regPool).
func isIndirectCallOp(op int) bool {
	return op == iropcode.OP_CALL_INDIRECT || op == iropcode.OP_CALL_FUNC_VALUE ||
			op == iropcode.OP_CALL_HANDLE || op == iropcode.OP_CALL_IFACE_METHOD
}

// CallReturnsVoid reports whether an OP_CALL has no result (e.g. a call to
// a void-returning function like os.Exit).
func CallReturnsVoid(ins @ir.Instr) bool {
	if ins.Typ == nil { return true }
	return ins.Typ.Kind == types.TYP_VOID
}

// SpillHoldsAggregatePointer reports whether ins's 8-byte spill slot
// holds a pointer to its data (as opposed to the data itself). True
// for every aggregate SSA value EXCEPT multi-return calls, which pack
// their N*8 bytes directly into the spill slot. This matters for
// OP_EXTRACT, which must indirect through the pointer in the former
// case but read at slot+8*Index in the latter.
func SpillHoldsAggregatePointer(ins @ir.Instr) bool {
	if ins == nil || !callconv.IsAggregateTyp(ins.Typ) { return false }
	if callconv.IsMultiReturnCall(ins) { return false }
	return true
}

// ElemSizeOf returns the element byte size for an OP_GET_ELEM_PTR
// instruction. The GEP's own result type is `*elemTyp` (set by
// ir.EmitGetElemPtr), which covers both array indexing and slice
// indexing (where the base pointer has already been extracted to a raw
// i8* and the element type lives only on the GEP itself).
func ElemSizeOf(gep @ir.Instr) int {
	if gep == nil || gep.Typ == nil || gep.Typ.Elem == nil { return 0 }
	return gep.Typ.Elem.SizeOf()
}

// StructTypeOf returns the struct type an OP_GET_FIELD_PTR's base `ins` points
// at, or nil if it points at no struct (ir.FieldPtrBaseType decides, as for
// every backend).
func StructTypeOf(ins @ir.Instr) @types.Type {
	var t @types.Type = ir.FieldPtrBaseType(ins)
	if t == nil || t.Kind == types.TYP_SLICE || t.Kind == types.TYP_MANAGED_SLICE {
		return nil
	}
	return t
}

// IsSliceFieldBase reports whether ins names a base whose
// OP_GET_FIELD_PTR fields are word-sized slice fields (data / len /
// refptr / backingLen) rather than a real struct's: its pointee
// (ir.FieldPtrBaseType, which peels a distinct named slice such as
// `type Buf @[]int` to its slice type) is a (managed-)slice.
func IsSliceFieldBase(ins @ir.Instr) bool {
	var t @types.Type = ir.FieldPtrBaseType(ins)
	return t != nil && (t.Kind == types.TYP_SLICE || t.Kind == types.TYP_MANAGED_SLICE)
}

// AppendStr concatenates the raw byte slice src onto the managed @[]char
// dst and returns the resulting buffer.  O(n) per call — used when the
// native backends build mangled symbol names incrementally.  The same
// shape used to live in pkg/binate/native/{x64,aarch64}/_iface.bn as duplicate
// helpers (appendStrIface / appendStrLocal); shared here so both arches
// pick up future tweaks together.
func AppendStr(dst *[]readonly char, src *[]readonly char) @[]char {
	var n int = len(dst)
	var ns @[]char = make_slice(char, n + len(src))
	for i := 0; i < n; i++ { ns[i] = dst[i] }
	for i := 0; i < len(src); i++ { ns[n + i] = src[i] }
	return ns
}

// RequireTerminated panics unless f has at least one block and each of its
// blocks ends in a terminator.  The native emitters lay a function's blocks out
// back to back with nothing after the last one, so a block that did not end in a
// terminator would run on into whatever follows it (and a function with no
// blocks would be a prologue running into the next function).  IR-gen ends every
// block in one (the LLVM backend's output would not assemble otherwise), so this
// fires only on malformed IR.
func RequireTerminated(f @ir.Func) {
	if len(f.Blocks) == 0 {
		fmt.Print("native: function ", f.Name, " has no blocks\n")
		panic("internal error: a function reaching native emission has no blocks")
	}
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		var n int = len(b.Instrs)
		if n == 0 || !b.Instrs[n - 1].IsTerminator() {
			fmt.Print("native: function ", f.Name, ": block ", b.Label, " does not end in a terminator\n")
			panic("internal error: a block reaching native emission does not end in a terminator")
		}
	}
}
