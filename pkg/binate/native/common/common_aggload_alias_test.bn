package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// AggLoadElidable and aliases of the loaded value: an instruction that passes an
// aggregate's pointer on (an aggregate field, a raw view, a cast) instead of
// copying it, whose consumers read the load's source at their own position.

// elisionNestedSmallTyp builds Outer{inner {int32, int32}, tail int32}: 12 bytes,
// 4-aligned (within the S-adjacent 16-byte cap), with an aggregate field.  Returns
// the outer type and the inner field's type.
func elisionNestedSmallTyp() (@types.Type, @types.Type) {
	var inf @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i = i + 1 {
		var g @types.Field = make(types.Field)
		g.Type = types.TypInt32()
		inf[i] = g
	}
	var inner @types.Type = types.MakeStructType("In", inf)
	var of @[]@types.Field = make_slice(@types.Field, 2)
	var g0 @types.Field = make(types.Field)
	g0.Name = "inner"
	g0.Type = inner
	of[0] = g0
	var g1 @types.Field = make(types.Field)
	g1.Name = "tail"
	g1.Type = types.TypInt32()
	of[1] = g1
	return types.MakeStructType("Outer", of), inner
}

// aliasFixture is a function whose entry block loads an Outer from an unknown
// pointer (the S-adjacent shape): f, the block, the load, the inner type, and a
// spare int slot and inner-typed slot for writes and consumers.
type aliasFixture struct {
	f     @ir.Func
	e     @ir.Block
	ld    @ir.Instr
	inner @types.Type
	c     @ir.Instr
	b     @ir.Instr
}

// newAliasFixture builds the aliasFixture preamble.
func newAliasFixture() aliasFixture {
	setTarget64()
	var outer @types.Type
	var fx aliasFixture
	outer, fx.inner = elisionNestedSmallTyp()
	fx.f = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	fx.e = ir.AddBlock(fx.f, "entry")
	fx.b = irbuild.EmitAlloc(fx.e, fx.inner)
	fx.c = irbuild.EmitAlloc(fx.e, types.TypInt())
	var p @ir.Instr = irbuild.EmitAlloc(fx.e, types.MakePointerType(outer))
	var ptr @ir.Instr = irbuild.EmitLoad(fx.e, p, types.MakePointerType(outer))
	fx.ld = irbuild.EmitLoad(fx.e, ptr, outer)
	return fx
}

// emitWrite emits an impure store into the fixture's spare int slot.
func (fx aliasFixture) emitWrite() {
	irbuild.EmitStore(fx.e, fx.c, irbuild.EmitConstInt(fx.e, 0, types.TypInt()))
}

// (S-adjacent) An aggregate-typed extract is an address inside the load's source,
// read by whatever consumes it: here a store after an impure op.  The consumer's
// read is part of the load's use range, so the op between blocks elision (else the
// copy reads the source after the op may have written it).
func TestAggLoadNotElidableAggregateExtractConsumedAfterWrite() testing.TestResult {
	var fx aliasFixture = newAliasFixture()
	var x @ir.Instr = irbuild.EmitExtract(fx.e, fx.ld, 0, fx.inner)
	fx.emitWrite()
	irbuild.EmitStore(fx.e, fx.b, x)
	irbuild.EmitReturn(fx.e, elisionNoRets())
	if AggLoadElidable(fx.f, fx.ld) {
		return "an aggregate extract consumed after a write must block S-adjacent elision"
	}
	return ""
}

// (S-alloca) The same through a confined alloca: a store to the source between the
// aggregate extract and its consumer blocks elision.
func TestAggLoadNotElidableAggregateExtractAfterSourceStore() testing.TestResult {
	setTarget64()
	var outer @types.Type
	var inner @types.Type
	outer, inner = elisionNestedSmallTyp()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Instr = irbuild.EmitAlloc(e, outer)
	var o @ir.Instr = irbuild.EmitAlloc(e, outer)
	var b @ir.Instr = irbuild.EmitAlloc(e, inner)
	var v @ir.Instr = irbuild.EmitLoad(e, a, outer)
	var x @ir.Instr = irbuild.EmitExtract(e, v, 0, inner)
	irbuild.EmitStore(e, a, irbuild.EmitLoad(e, o, outer)) // reassign the source
	irbuild.EmitStore(e, b, x)
	irbuild.EmitReturn(e, elisionNoRets())
	if AggLoadElidable(f, v) {
		return "a store to the source before an aggregate extract's consumer must block elision"
	}
	return ""
}

// An aggregate extract consumed with nothing in between stays elidable: the
// consumer's read is within a range that nothing writes.
func TestAggLoadElidableAggregateExtractConsumedAdjacent() testing.TestResult {
	var fx aliasFixture = newAliasFixture()
	var x @ir.Instr = irbuild.EmitExtract(fx.e, fx.ld, 0, fx.inner)
	irbuild.EmitStore(fx.e, fx.b, x)
	irbuild.EmitReturn(fx.e, elisionNoRets())
	if !AggLoadElidable(fx.f, fx.ld) {
		return "an aggregate extract consumed right away should stay elidable"
	}
	return ""
}

// (S-alloca) A managed-slice's raw view is the same pointer: a store to the source
// between the view and its consumer blocks elision.
func TestAggLoadNotElidableRawViewAfterSourceStore() testing.TestResult {
	setTarget64()
	var ms @types.Type = types.MakeManagedSliceType(types.TypInt())
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Instr = irbuild.EmitAlloc(e, ms)
	var o @ir.Instr = irbuild.EmitAlloc(e, ms)
	var r @ir.Instr = irbuild.EmitAlloc(e, types.MakeSliceType(types.TypInt()))
	var v @ir.Instr = irbuild.EmitLoad(e, a, ms)
	var view @ir.Instr = irbuild.EmitManagedToRaw(e, v)
	irbuild.EmitStore(e, a, irbuild.EmitLoad(e, o, ms)) // reassign the source
	irbuild.EmitStore(e, r, view)
	irbuild.EmitReturn(e, elisionNoRets())
	if AggLoadElidable(f, v) {
		return "a store to the source before a raw view's consumer must block elision"
	}
	return ""
}

// An alias of an alias (a cast of an aggregate field) is followed too: a write
// before the inner consumer blocks elision.
func TestAggLoadNotElidableAliasChainConsumedAfterWrite() testing.TestResult {
	var fx aliasFixture = newAliasFixture()
	var x @ir.Instr = irbuild.EmitExtract(fx.e, fx.ld, 0, fx.inner)
	var cx @ir.Instr = irbuild.EmitCast(fx.e, x, fx.inner)
	fx.emitWrite()
	irbuild.EmitStore(fx.e, fx.b, cx)
	irbuild.EmitReturn(fx.e, elisionNoRets())
	if AggLoadElidable(fx.f, fx.ld) {
		return "a write before an alias chain's consumer must block elision"
	}
	return ""
}

// An alias used in another block cannot be range-checked, so it blocks elision.
func TestAggLoadNotElidableAliasUsedInOtherBlock() testing.TestResult {
	var fx aliasFixture = newAliasFixture()
	var next @ir.Block = ir.AddBlock(fx.f, "next")
	var x @ir.Instr = irbuild.EmitExtract(fx.e, fx.ld, 0, fx.inner)
	irbuild.EmitJump(fx.e, next)
	irbuild.EmitStore(next, fx.b, x)
	irbuild.EmitReturn(next, elisionNoRets())
	if AggLoadElidable(fx.f, fx.ld) { return "an alias used in another block must block elision" }
	return ""
}

// An alias written through (a store destination) would write the source.
func TestAggLoadNotElidableAliasStoredThrough() testing.TestResult {
	var fx aliasFixture = newAliasFixture()
	var x @ir.Instr = irbuild.EmitExtract(fx.e, fx.ld, 0, fx.inner)
	irbuild.EmitStore(fx.e, x, irbuild.EmitLoad(fx.e, fx.b, fx.inner))
	irbuild.EmitReturn(fx.e, elisionNoRets())
	if AggLoadElidable(fx.f, fx.ld) { return "a store through an alias must block elision" }
	return ""
}

// An OP_COPY of an alias names the copy's phi elsewhere, where the range check
// cannot see it, so it blocks elision.
func TestAggLoadNotElidableAliasCopied() testing.TestResult {
	var fx aliasFixture = newAliasFixture()
	var x @ir.Instr = irbuild.EmitExtract(fx.e, fx.ld, 0, fx.inner)
	irbuild.EmitReturn(fx.e, elisionNoRets())
	// Insert `copy <- x` before the return (irbuild has no copy emitter).
	var cp @ir.Instr = make(ir.Instr)
	cp.Op = iropcode.OP_COPY
	cp.Typ = fx.inner
	cp.ID = fx.f.NextID
	fx.f.NextID = fx.f.NextID + 1
	cp.Args = make_slice(@ir.Instr, 1)
	cp.Args[0] = x
	var n int = len(fx.e.Instrs)
	var out @[]@ir.Instr = make_slice(@ir.Instr, n + 1)
	for i := 0; i < n - 1; i++ { out[i] = fx.e.Instrs[i] }
	out[n - 1] = cp
	out[n] = fx.e.Instrs[n - 1]
	fx.e.Instrs = out
	if AggLoadElidable(fx.f, fx.ld) { return "a copy of an alias must block elision" }
	return ""
}

// An alias nothing reads adds nothing to the range: the load, consumed right away,
// stays elidable.
func TestAggLoadElidableUnusedAlias() testing.TestResult {
	var fx aliasFixture = newAliasFixture()
	_ = irbuild.EmitExtract(fx.e, fx.ld, 0, fx.inner)
	irbuild.EmitStore(fx.e, fx.b, irbuild.EmitExtract(fx.e, fx.ld, 0, fx.inner))
	irbuild.EmitReturn(fx.e, elisionNoRets())
	if !AggLoadElidable(fx.f, fx.ld) { return "an unused alias should not block elision" }
	return ""
}

// A phi at the top of the load's own block that names it through the back edge
// reads it before its definition in block order, outside the forward range
// analysis: elision is refused.
func TestAggLoadNotElidableEarlierPhiUse() testing.TestResult {
	setTarget64()
	var outer @types.Type
	var inner @types.Type
	outer, inner = elisionNestedSmallTyp()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var loop @ir.Block = ir.AddBlock(f, "loop")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var b @ir.Instr = irbuild.EmitAlloc(entry, inner)
	var p @ir.Instr = irbuild.EmitAlloc(entry, types.MakePointerType(outer))
	var ptr @ir.Instr = irbuild.EmitLoad(entry, p, types.MakePointerType(outer))
	var init @ir.Instr = irbuild.EmitLoad(entry, ptr, outer)
	irbuild.EmitJump(entry, loop)
	var es @[]ir.PhiEntry = make_slice(ir.PhiEntry, 2)
	es[0].Block = entry
	es[0].Val = init
	es[1].Block = entry
	es[1].Val = init
	var phi @ir.Instr = irbuild.EmitPhi(loop, outer, es)
	var v @ir.Instr = irbuild.EmitLoad(loop, ptr, outer)
	irbuild.EmitStore(loop, b, irbuild.EmitExtract(loop, v, 0, inner))
	var c @ir.Instr = irbuild.EmitConstBool(loop, true)
	irbuild.EmitBranch(loop, c, loop, exit)
	phi.Phis[1].Block = loop
	phi.Phis[1].Val = v
	irbuild.EmitReturn(exit, elisionNoRets())
	if AggLoadElidable(f, v) { return "a phi use before the load in its own block must block elision" }
	return ""
}
