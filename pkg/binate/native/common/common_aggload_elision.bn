package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"

// AggLoadElidable reports whether the aggregate `OP_LOAD` `ld` in function `f` may
// SKIP its private materialization region (reserved by PlanFrame) and instead ALIAS
// its source pointer — so `emitAggLoad`'s no-region path leaves `ld`'s spill slot
// pointing at the source and a downstream struct-copy reads the source DIRECTLY.
// That removes one full-width aggregate copy (the src->temp half of src->temp->dst).
// See explorations/plan-native-aggcopy-fusion.md.
//
// A false positive is silent memory corruption — a use-after-free if the source is
// freed before a use, a wrong value if it is overwritten — so this defaults hard to
// "not elidable" and only the provably-safe shape is accepted:
//
//   S-alloca: `ld` loads WHOLE from a stack `OP_ALLOC` `A` whose address is CONFINED
//     to whole load/store of `A` (never taken, never a value operand, never in a
//     fault pad). Then `A` is a non-escaping frame slot: it is never freed, and the
//     ONLY writer of its bytes is a direct `OP_STORE` to `A`. So `refdec`/`refinc`,
//     calls, and stores to OTHER slots between the load and its uses cannot disturb
//     `A`'s bytes. Aliasing is safe as long as no store to `A` (a reassignment of the
//     source) falls between `ld` and its last use. (Captures `b = a`, `b.s = a`.)
//
//   S-adjacent: the source is anything else — a raw `*T` deref, a heap element — so
//     nothing is assumed about it. Aliasing is safe only when NOTHING that could write
//     or free memory falls between the load and its last use: every intervening
//     instruction must be a pure read / address-computation / register op. (Captures
//     `*dst = *src`, whose store follows the load with at most the destination-address
//     computation between.)
//
//   S-extract: the source is anything, but EVERY use of `ld` is an `OP_EXTRACT` (a
//     field-precise scalar read, never an overlapping full-width copy). The extracts
//     read fields directly from the source, so — unlike the copy shapes — there is no
//     overlap to reason about and the S-adjacent <= 16-byte size cap does not apply.
//     Aliasing is safe under the same "nothing writes or frees memory in between"
//     condition as S-adjacent. (Captures `r := heapElem; use r.f0; ...; use r.f7`,
//     the field-read chain a size cap would otherwise force to materialize.)
//
// Additionally every use of `ld`'s value must be a read-only consumer in the SAME
// block, after `ld`: a cross-block use, a fault-pad use, a use that writes through the
// value (as an `OP_STORE` destination) or takes its address, or a `__c_call` argument
// use is conservatively rejected.
func AggLoadElidable(f @ir.Func, ld @ir.Instr) bool {
	if ld.Op != iropcode.OP_LOAD { return false }
	if !IsAggregateTyp(ld.Typ) { return false }
	if len(ld.Args) < 1 { return false }

	// Locate ld's block and index.
	var blk @ir.Block = nil
	var li int = -1
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			if b.Instrs[ii] == ld {
				blk = b
				li = ii
			}
		}
	}
	if blk == nil || li < 0 { return false }

	// Reject any use of ld outside its own block, or inside a fault pad: the
	// same-block use-range analysis below cannot reason about those.
	if valueUsedInOtherBlockOrPad(f, blk, ld) { return false }

	// Every same-block use must be a read-only consumer at/after li; get the last.
	var lastUse int = lastReadOnlyUseIndex(blk, li, ld)
	if lastUse < 0 { return false }

	var src @ir.Instr = ld.Args[0]

	// (S-alloca) source is a confined, non-escaping stack alloca: it is never freed
	// and is written only by a direct store to it, so refcount ops, calls, and stores
	// to OTHER slots between the load and its uses cannot disturb it — only a store to
	// the source alloca (a reassignment) is a barrier.
	if src != nil && src.Op == iropcode.OP_ALLOC && allocaAddrConfinedToLoadStore(f, src) &&
			!storeToDestStrictlyBetween(blk, li, lastUse, src) {
		return true
	}

	// (S-extract) EVERY use of `ld` is an `OP_EXTRACT` — a field-precise scalar read,
	// never an overlapping full-width copy — so the S-adjacent <= 16-byte overlap cap
	// does NOT apply here: a load of ANY size may alias its source when nothing writes
	// or frees memory between it and its last extract (onlyPureOpsStrictlyBetween).
	// The extracts read individual fields DIRECTLY from the source, so refcount
	// behavior is unchanged — a managed field's +1, when a copy would take one, is an
	// explicit `OP_REFINC` on the extract RESULT (identical whether the load aliased or
	// materialized), and any refcount / call / store op in the interval is impure and
	// blocks elision anyway.  The word-alignment guard (AlignOf >= 4) is retained
	// conservatively so each per-field access stays aligned on strict-align arm32.
	// Captures the `r := heapElem; use r.f0; ...; use r.f7` field-read chain that a
	// size <= 16 cap would otherwise force to materialize (e.g. an 8-field record).
	if allSameBlockUsesAreExtracts(blk, li, lastUse, ld) && ld.Typ != nil && ld.Typ.AlignOf() >= 4 &&
			onlyPureOpsStrictlyBetween(blk, li, lastUse) {
		return true
	}

	// (S-adjacent) source is anything else (a raw `*T` deref, a heap element, ...) —
	// nothing is assumed about it, so it is safe to alias only when NOTHING that could
	// write or free memory falls between the load and its last use.  Every intervening
	// instruction must be a pure read / address-computation / register op (see
	// opIsPureBetween); a store, call, refcount op, allocation, or aggregate
	// materializer forces materialization.  Captures `*dst = *src`.
	//
	// A SUB-WORD-aligned aggregate (AlignOf < 4) is excluded: the packed layout can
	// place it at a non-word-aligned address (e.g. a 3-byte struct at byte offset 1),
	// and a consumer that reads it word-wise (an aggregate call argument / return
	// marshal) would fault on strict-align arm32.  The materialization region is always
	// word-aligned, so such an aggregate must keep materializing.  (S-alloca is
	// unaffected: alloca frame slots are 8-byte aligned, so their address is always
	// word-aligned regardless of the aggregate's own alignment.)
	//
	// Size cap <= 16 bytes: for an UNKNOWN source the alias defers the read to the
	// consuming store, so `*dst = *src` where dst overlaps src must still read all of
	// src before writing dst (spec stmt.assign.parallel is RHS-first).  The elided
	// copy is overlap-safe only when it loads the whole aggregate before storing.
	// emitStructCopy routes every backend through an overlap-safe load-all-then-store
	// helper (emitAggMemcpySafe{Aarch64,X64,Arm32}); on arm32 that is one LDM covering
	// all words, which the register pool bounds to <= 16 bytes = 4 arm32 words.  Beyond
	// 16 bytes the copy interleaves loads and stores, so such loads keep materializing.
	// (S-alloca is unaffected: an alloca source never overlaps the store destination,
	// so any size copies safely.)
	if ld.Typ != nil && ld.Typ.AlignOf() >= 4 && ld.Typ.SizeOf() <= 16 &&
			onlyPureOpsStrictlyBetween(blk, li, lastUse) {
		return true
	}
	return false
}

// valueUsedInOtherBlockOrPad reports whether value v is referenced in any block
// other than `home`, or in any fault pad.  Fault pads are VM-only (native never
// emits them), so a pad reference is treated conservatively as a use that blocks
// elision rather than reasoned about.
func valueUsedInOtherBlockOrPad(f @ir.Func, home @ir.Block, v @ir.Instr) bool {
	for bi := 0; bi < len(f.Blocks); bi++ {
		if f.Blocks[bi] == home { continue }
		if blockReferencesValue(f.Blocks[bi], v) { return true }
	}
	for pi := 0; pi < len(f.FaultPads); pi++ {
		if blockReferencesValue(f.FaultPads[pi], v) { return true }
	}
	return false
}

// blockReferencesValue reports whether any instruction in b (other than v's own
// definition) names v as an argument or a phi entry.
func blockReferencesValue(b @ir.Block, v @ir.Instr) bool {
	for ii := 0; ii < len(b.Instrs); ii++ {
		var ins @ir.Instr = b.Instrs[ii]
		if ins == v { continue }
		for k := 0; k < len(ins.Args); k++ {
			if ins.Args[k] == v { return true }
		}
		for k := 0; k < len(ins.Phis); k++ {
			if ins.Phis[k].Val == v { return true }
		}
	}
	return false
}

// lastReadOnlyUseIndex scans blk after index li and returns the index of the last
// instruction that reads ld as a value, or -1 if ld has no use or any use is NOT a
// read-only consumer.  A use is disqualifying (returns -1) when ld appears as an
// `OP_STORE` destination (Args[0]) — a write through the value — or as the base of a
// field/element pointer (an aggregate value is not an address), or as a phi entry.
func lastReadOnlyUseIndex(blk @ir.Block, li int, ld @ir.Instr) int {
	var last int = -1
	for ii := li + 1; ii < len(blk.Instrs); ii++ {
		var ins @ir.Instr = blk.Instrs[ii]
		for k := 0; k < len(ins.Phis); k++ {
			if ins.Phis[k].Val == ld { return -1 }
		}
		var uses bool = false
		for k := 0; k < len(ins.Args); k++ {
			if ins.Args[k] != ld { continue }
			uses = true
			if ins.Op == iropcode.OP_STORE && k == 0 { return -1 }
			if ins.Op == iropcode.OP_GET_FIELD_PTR || ins.Op == iropcode.OP_GET_ELEM_PTR {
				return -1
			}
			// A `__c_call` argument is NOT read-only for a large by-value aggregate:
			// where the C ABI passes it indirectly (AAPCS64 passes a pointer with NO
			// caller copy), the load's private materialization region IS the
			// caller-owned copy the ABI requires, and a C callee may write through it.
			// Aliasing the source would let the callee corrupt it.  Refuse elision for
			// any `__c_call` value use (conservative across targets/sizes).
			if ins.Op == iropcode.OP_C_CALL { return -1 }
		}
		if uses { last = ii }
	}
	return last
}

// allSameBlockUsesAreExtracts reports whether `ld` has at least one use in blk over
// (li, lastUse] and EVERY instruction there that reads `ld` is an `OP_EXTRACT`.  The
// caller has already established (via lastReadOnlyUseIndex + valueUsedInOtherBlockOrPad)
// that ld's only uses are read-only and same-block within this range; this narrows
// that to the field-read-only shape the S-extract elision needs, rejecting a mixed
// consumer such as a store value operand, a by-value call argument, or a return.
func allSameBlockUsesAreExtracts(blk @ir.Block, li int, lastUse int, ld @ir.Instr) bool {
	var sawUse bool = false
	for ii := li + 1; ii <= lastUse; ii++ {
		var ins @ir.Instr = blk.Instrs[ii]
		var usesLd bool = false
		for k := 0; k < len(ins.Args); k++ {
			if ins.Args[k] == ld { usesLd = true }
		}
		if usesLd {
			sawUse = true
			if ins.Op != iropcode.OP_EXTRACT { return false }
			// The extract must be a SCALAR field read — the read happens AT the
			// extract (within the guarded interval), so the source is provably
			// byte-stable for it.  An AGGREGATE-typed extract instead emits a bare
			// address-of-sub-object (a pointer aliasing the source); the actual
			// read is deferred to whatever consumes that pointer, which uses the
			// extract — not `ld` — and so lies OUTSIDE (li, lastUse] and unchecked.
			// Reject it: the source could be freed before that deferred read.
			if IsAggregateTyp(ins.Typ) { return false }
		}
	}
	return sawUse
}

// allocaAddrConfinedToLoadStore reports whether every appearance of alloca `a` in
// f — across all blocks AND all fault pads — is the Args[0] pointer of a whole
// `OP_LOAD` or whole `OP_STORE`.  Any other appearance (a value operand, a call
// argument, an `OP_STORE` value `Args[1]`, a field/element-ptr base, a phi entry, or
// any fault-pad reference) means `a`'s address escapes or `a`'s bytes may be written
// indirectly, so the confinement — and with it the "only a direct store to `a`
// writes `a`" guarantee this elision relies on — does not hold.
func allocaAddrConfinedToLoadStore(f @ir.Func, a @ir.Instr) bool {
	for bi := 0; bi < len(f.Blocks); bi++ {
		if !blockAllocaOnlyLoadStore(f.Blocks[bi], a) { return false }
	}
	for pi := 0; pi < len(f.FaultPads); pi++ {
		if blockReferencesValue(f.FaultPads[pi], a) { return false }
	}
	return true
}

// blockAllocaOnlyLoadStore is allocaAddrConfinedToLoadStore restricted to one block.
func blockAllocaOnlyLoadStore(b @ir.Block, a @ir.Instr) bool {
	for ii := 0; ii < len(b.Instrs); ii++ {
		var ins @ir.Instr = b.Instrs[ii]
		if ins == a { continue }
		for k := 0; k < len(ins.Phis); k++ {
			if ins.Phis[k].Val == a { return false }
		}
		for k := 0; k < len(ins.Args); k++ {
			if ins.Args[k] != a { continue }
			var okLoad bool = ins.Op == iropcode.OP_LOAD && k == 0
			var okStore bool = ins.Op == iropcode.OP_STORE && k == 0
			if !okLoad && !okStore { return false }
		}
	}
	return true
}

// storeToDestStrictlyBetween reports whether any `OP_STORE` whose destination
// (Args[0]) is `dst` occurs at an index strictly between li and lastUse.  Such a
// store reassigns the source between the load and a later use, so aliasing would
// read the overwritten bytes.  The load index and the last-use index are excluded:
// the last use only reads the source (a self-store `store dst, ld` at lastUse would
// alias to a no-op).
func storeToDestStrictlyBetween(blk @ir.Block, li int, lastUse int, dst @ir.Instr) bool {
	for ii := li + 1; ii < lastUse; ii++ {
		var ins @ir.Instr = blk.Instrs[ii]
		if ins.Op == iropcode.OP_STORE && len(ins.Args) >= 1 && ins.Args[0] == dst {
			return true
		}
	}
	return false
}

// onlyPureOpsStrictlyBetween reports whether every instruction strictly between li
// and lastUse in blk is pure — a read / address-computation / register op that cannot
// write memory or free anything (opIsPureBetween).  Used by the S-adjacent shape,
// whose source is unknown: any impure op between the load and a use could overwrite
// or free the source before the use reads it.
func onlyPureOpsStrictlyBetween(blk @ir.Block, li int, lastUse int) bool {
	for ii := li + 1; ii < lastUse; ii++ {
		if !opIsPureBetween(blk.Instrs[ii].Op) { return false }
	}
	return true
}

// opIsPureBetween reports whether `op` provably neither writes memory nor frees
// anything, so it is safe between an aggregate load and its consuming use even when
// the load's source is unknown.  This is a WHITELIST (default false): reads and
// address computations (load / extract / field- and elem-ptr), scalar constants,
// pure register arithmetic / comparison / conversion, and read-only checks.
// Everything NOT listed — every store, call, refcount op, allocation, aggregate
// materializer (make / make_slice / const-nil / rodata / struct-lit / iface / func
// value / box), deref, phi, control op — is treated as a barrier.
func opIsPureBetween(op int) bool {
	// Reads and pure address computation.
	if op == iropcode.OP_LOAD || op == iropcode.OP_EXTRACT || op == iropcode.OP_GET_FIELD_PTR ||
			op == iropcode.OP_GET_ELEM_PTR || op == iropcode.OP_DATA_SYM_ADDR ||
			op == iropcode.OP_MANAGED_TO_RAW {
		return true
	}
	// Scalar constants (aggregate OP_CONST_NIL is excluded — it writes a region).
	if op == iropcode.OP_CONST_INT || op == iropcode.OP_CONST_FLOAT || op == iropcode.OP_CONST_BOOL {
		return true
	}
	// Read-only checks (may fault-abort, which prevents the use; never write).
	if op == iropcode.OP_BOUNDS_CHECK || op == iropcode.OP_NIL_CHECK || op == iropcode.OP_DIV_CHECK ||
			op == iropcode.OP_SHIFT_CHECK || op == iropcode.OP_STACK_CHECK {
		return true
	}
	// Pure register arithmetic / bitwise / comparison / conversion.
	if op == iropcode.OP_ADD || op == iropcode.OP_SUB || op == iropcode.OP_MUL ||
			op == iropcode.OP_MADD || op == iropcode.OP_MSUB || op == iropcode.OP_DIV ||
			op == iropcode.OP_REM || op == iropcode.OP_AND || op == iropcode.OP_OR ||
			op == iropcode.OP_XOR || op == iropcode.OP_SHL || op == iropcode.OP_SHR ||
			op == iropcode.OP_BITNOT || op == iropcode.OP_NEG || op == iropcode.OP_NOT ||
			op == iropcode.OP_EQ || op == iropcode.OP_NE || op == iropcode.OP_LT || op == iropcode.OP_LE ||
			op == iropcode.OP_GT || op == iropcode.OP_GE || op == iropcode.OP_CAST ||
			op == iropcode.OP_BIT_CAST {
		return true
	}
	return false
}
