package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A two-int struct — a POD aggregate whose whole load/store go through
// emitStructCopy, the shape AggLoadElision reasons about.
func elisionPairTyp() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var f0 @types.Field = make(types.Field)
	f0.Name = "a"
	f0.Type = types.TypInt()
	fields[0] = f0
	var f1 @types.Field = make(types.Field)
	f1.Name = "b"
	f1.Type = types.TypInt()
	fields[1] = f1
	return types.MakeStructType("Pair", fields)
}

// A four-int struct — a POD aggregate that is 32 bytes on LP64 (> 16), used to
// exercise the S-extract shape where the S-adjacent <= 16-byte cap would block.
func elisionQuadTyp() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 4)
	for i := 0; i < 4; i = i + 1 {
		var g @types.Field = make(types.Field)
		g.Type = types.TypInt()
		fields[i] = g
	}
	return types.MakeStructType("Quad", fields)
}

// aggLoadElidable reports whether ld reads its source in place (AggLoadElision is not
// AGG_LOAD_COPIED).
func aggLoadElidable(f @ir.Func, ld @ir.Instr) bool {
	return AggLoadElision(f, ld) != AGG_LOAD_COPIED
}

func elisionNoParams() @[]@ir.Param { return make_slice(@ir.Param, 0) }

func elisionNoResults() @[]@types.Type { return make_slice(@types.Type, 0) }

func elisionNoRets() @[]@ir.Instr { return make_slice(@ir.Instr, 0) }

// A whole aggregate load from a stack alloca whose address is confined to whole
// load/store, consumed by a store into a DIFFERENT slot with no store to the source
// between, is elidable — the `b = a` shape.
func TestAggLoadElidableConfinedAllocaSource() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var agg @types.Type = elisionPairTyp()
	var a @ir.Instr = irbuild.EmitAlloc(e, agg)
	var b @ir.Instr = irbuild.EmitAlloc(e, agg)
	var v @ir.Instr = irbuild.EmitLoad(e, a, agg)
	irbuild.EmitStore(e, b, v)
	irbuild.EmitReturn(e, elisionNoRets())
	if !aggLoadElidable(f, v) {
		return "load from a confined alloca, stored to another slot, should be elidable"
	}
	return ""
}

// A store to the SOURCE alloca between the load and a later use — the `a, b = b, a`
// swap shape — must block elision (else the use reads the overwritten value).
func TestAggLoadNotElidableStoreToSourceBetween() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var agg @types.Type = elisionPairTyp()
	var a @ir.Instr = irbuild.EmitAlloc(e, agg)
	var b @ir.Instr = irbuild.EmitAlloc(e, agg)
	var va @ir.Instr = irbuild.EmitLoad(e, a, agg)
	var vb @ir.Instr = irbuild.EmitLoad(e, b, agg)
	irbuild.EmitStore(e, a, vb) // reassign the source a — a barrier for va
	irbuild.EmitStore(e, b, va) // use of va after a was overwritten
	irbuild.EmitReturn(e, elisionNoRets())
	if aggLoadElidable(f, va) {
		return "a store to the source between load and use (swap) must block elision"
	}
	return ""
}

// A load whose source is NOT a bare alloca (here a field pointer into the alloca) is
// conservatively not elidable — only a direct whole load of an alloca is accepted.
// (S-adjacent) A load from a NON-alloca source (a field pointer — a raw address) is
// elidable when its consuming store is adjacent with nothing between: nothing can
// write or free the source before the store reads it.  This is the `*dst = *src`
// shape.
func TestAggLoadElidableSAdjacentAdjacentStore() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var agg @types.Type = elisionPairTyp()
	var b @ir.Instr = irbuild.EmitAlloc(e, agg)
	// Load from a field pointer of a pointer-typed slot — a non-alloca (raw address)
	// source, so S-alloca does not apply; the store is adjacent.
	var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(agg))
	var ptr @ir.Instr = irbuild.EmitLoad(e, p, types.MakePointerType(agg))
	var v @ir.Instr = irbuild.EmitLoad(e, ptr, agg)
	irbuild.EmitStore(e, b, v)
	irbuild.EmitReturn(e, elisionNoRets())
	if !aggLoadElidable(f, v) {
		return "a non-alloca source with an adjacent store should be elidable (S-adjacent)"
	}
	return ""
}

// (S-adjacent) An impure op (here a store to another slot) between the load and its
// use blocks elision — with an unknown source, any such op could write or free it.
func TestAggLoadNotElidableSAdjacentStoreBetween() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var agg @types.Type = elisionPairTyp()
	var b @ir.Instr = irbuild.EmitAlloc(e, agg)
	var c @ir.Instr = irbuild.EmitAlloc(e, types.TypInt())
	var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(agg))
	var ptr @ir.Instr = irbuild.EmitLoad(e, p, types.MakePointerType(agg))
	var v @ir.Instr = irbuild.EmitLoad(e, ptr, agg)
	// an impure op between → barrier
	irbuild.EmitStore(e, c, irbuild.EmitConstInt(e, 0, types.TypInt()))
	irbuild.EmitStore(e, b, v)
	irbuild.EmitReturn(e, elisionNoRets())
	if aggLoadElidable(f, v) {
		return "a store between the load and its use must block S-adjacent elision"
	}
	return ""
}

// A use of the loaded value in a DIFFERENT block blocks elision — the same-block
// use-range analysis cannot reason across blocks.
func TestAggLoadNotElidableCrossBlockUse() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var e2 @ir.Block = ir.AddBlock(f, "b2")
	var agg @types.Type = elisionPairTyp()
	var a @ir.Instr = irbuild.EmitAlloc(e, agg)
	var b @ir.Instr = irbuild.EmitAlloc(e, agg)
	var v @ir.Instr = irbuild.EmitLoad(e, a, agg)
	irbuild.EmitStore(e2, b, v) // use of v in another block
	if aggLoadElidable(f, v) {
		return "a use of the loaded value in another block must block elision"
	}
	return ""
}

// The source alloca's address ESCAPING (used as a store value, not a whole
// load/store destination) breaks the confinement, so it is not elidable.
func TestAggLoadNotElidableEscapingAlloca() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var agg @types.Type = elisionPairTyp()
	var a @ir.Instr = irbuild.EmitAlloc(e, agg)
	var b @ir.Instr = irbuild.EmitAlloc(e, agg)
	var ptrslot @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(agg))
	var v @ir.Instr = irbuild.EmitLoad(e, a, agg)
	irbuild.EmitStore(e, ptrslot, a) // a's ADDRESS escapes as a stored value
	irbuild.EmitStore(e, b, v)
	irbuild.EmitReturn(e, elisionNoRets())
	if aggLoadElidable(f, v) {
		return "an alloca whose address escapes must not be elidable"
	}
	return ""
}

// A load feeding a `__c_call` argument must NOT be elidable: where the C ABI passes
// a large aggregate indirectly (AAPCS64), the load's private region is the required
// caller copy, and a C callee may write through it.  (Built by retagging an internal
// OP_CALL as OP_C_CALL — the predicate keys on the op.)
func TestAggLoadNotElidableCCallArg() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var agg @types.Type = elisionPairTyp()
	var a @ir.Instr = irbuild.EmitAlloc(e, agg)
	var v @ir.Instr = irbuild.EmitLoad(e, a, agg)
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = v
	var ci @ir.Instr = irbuild.EmitCall(e, "poke", args, agg)
	ci.Op = iropcode.OP_C_CALL
	irbuild.EmitReturn(e, elisionNoRets())
	if aggLoadElidable(f, v) {
		return "a load feeding a __c_call argument must not be elidable"
	}
	return ""
}

// (S-adjacent) A SUB-word-aligned aggregate (a 3-int8 struct, AlignOf 1) is NOT
// elidable even when adjacent: its packed layout can place it at a non-word-aligned
// address, which a word-wise consumer would fault on for strict-align arm32.
func TestAggLoadNotElidableSubWordAlignedSAdjacent() testing.TestResult {
	var f3 @[]@types.Field = make_slice(@types.Field, 3)
	var g0 @types.Field = make(types.Field)
	g0.Type = types.TypInt8()
	f3[0] = g0
	var g1 @types.Field = make(types.Field)
	g1.Type = types.TypInt8()
	f3[1] = g1
	var g2 @types.Field = make(types.Field)
	g2.Type = types.TypInt8()
	f3[2] = g2
	var tri @types.Type = types.MakeStructType("Tri", f3)

	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var b @ir.Instr = irbuild.EmitAlloc(e, tri)
	var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(tri))
	var ptr @ir.Instr = irbuild.EmitLoad(e, p, types.MakePointerType(tri))
	var v @ir.Instr = irbuild.EmitLoad(e, ptr, tri) // non-alloca source, adjacent store
	irbuild.EmitStore(e, b, v)
	irbuild.EmitReturn(e, elisionNoRets())
	if aggLoadElidable(f, v) {
		return "a sub-word-aligned aggregate must not be S-adjacent-elided (arm32 fault)"
	}
	return ""
}

// (S-adjacent) An aggregate LARGER than 16 bytes is NOT elidable even when adjacent,
// unless its one use is the return or a whole store (which copies as memmove does):
// a consumer such as a call argument copies it without regard to overlap.
func TestAggLoadNotElidableSAdjacentTooLarge() testing.TestResult {
	// LP64-specific: Quad is 4*int = 32B on LP64 but 16B on ILP32, which the arm32
	// runner would wrongly deem elidable (SizeOf <= 16).  Pin the 64-bit ABI.
	setTarget64()
	var f4 @[]@types.Field = make_slice(@types.Field, 4)
	for i := 0; i < 4; i = i + 1 {
		var g @types.Field = make(types.Field)
		g.Type = types.TypInt()
		f4[i] = g
	}
	var big @types.Type = types.MakeStructType("Quad", f4) // 32 bytes

	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(big))
	var ptr @ir.Instr = irbuild.EmitLoad(e, p, types.MakePointerType(big))
	var v @ir.Instr = irbuild.EmitLoad(e, ptr, big) // non-alloca source, adjacent, but > 16 bytes
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = v
	irbuild.EmitCall(e, "g", args, types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	if aggLoadElidable(f, v) {
		return "an aggregate larger than 16 bytes passed to a call must not be S-adjacent-elided"
	}
	return ""
}

// (S-extract) A > 16-byte aggregate loaded from a NON-alloca source (a raw pointer)
// and consumed ONLY by field extracts is elidable even though it exceeds the
// S-adjacent copy cap: the extracts read fields directly, so there is no overlap and
// the size cap does not apply.  This is the `r := heapElem; use r.f0; use r.f1` shape.
func TestAggLoadElidableExtractOnlyLargeSource() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var agg @types.Type = elisionQuadTyp() // 32 bytes on LP64
	var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(agg))
	var ptr @ir.Instr = irbuild.EmitLoad(e, p, types.MakePointerType(agg))
	var v @ir.Instr = irbuild.EmitLoad(e, ptr, agg) // non-alloca source
	irbuild.EmitExtract(e, v, 0, types.TypInt())
	irbuild.EmitExtract(e, v, 2, types.TypInt())
	irbuild.EmitReturn(e, elisionNoRets())
	if !aggLoadElidable(f, v) {
		return "a > 16-byte load consumed only by extracts should be elidable (S-extract)"
	}
	return ""
}

// A load consumed by a MIX of extracts and a copy (store value operand) is NOT
// extract-only, so S-extract does not apply; with a > 16-byte non-alloca source the
// S-adjacent size cap then forbids it too — the mixed consumer keeps it materializing.
func TestAggLoadNotElidableExtractPlusStore() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var agg @types.Type = elisionQuadTyp()
	var b @ir.Instr = irbuild.EmitAlloc(e, agg)
	var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(agg))
	var ptr @ir.Instr = irbuild.EmitLoad(e, p, types.MakePointerType(agg))
	var v @ir.Instr = irbuild.EmitLoad(e, ptr, agg)
	irbuild.EmitExtract(e, v, 0, types.TypInt())
	irbuild.EmitStore(e, b, v) // a copy consumer alongside the extract → not extract-only
	irbuild.EmitReturn(e, elisionNoRets())
	if aggLoadElidable(f, v) {
		return "a load with a mixed extract+store consumer (> 16 bytes) must not be elidable"
	}
	return ""
}

// (S-extract) An impure op (a store to another slot) between the load and its last
// extract blocks S-extract elision: with an unknown source, that op could write or
// free the source before the extract reads it.
func TestAggLoadNotElidableExtractImpureBetween() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var agg @types.Type = elisionQuadTyp()
	var c @ir.Instr = irbuild.EmitAlloc(e, types.TypInt())
	var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(agg))
	var ptr @ir.Instr = irbuild.EmitLoad(e, p, types.MakePointerType(agg))
	var v @ir.Instr = irbuild.EmitLoad(e, ptr, agg)
	irbuild.EmitExtract(e, v, 0, types.TypInt())
	irbuild.EmitStore(e, c, irbuild.EmitConstInt(e, 0, types.TypInt())) // impure op between
	irbuild.EmitExtract(e, v, 2, types.TypInt()) // a later extract keeps the store in-range
	irbuild.EmitReturn(e, elisionNoRets())
	if aggLoadElidable(f, v) {
		return "an impure op between the load and a later extract must block S-extract"
	}
	return ""
}

// (S-extract) A SUB-word-aligned aggregate (a 3-int8 struct, AlignOf 1) is NOT
// extract-elidable even when consumed only by extracts: the word-alignment guard is
// retained conservatively so per-field reads stay aligned on strict-align arm32.
func TestAggLoadNotElidableExtractSubWordAligned() testing.TestResult {
	var f3 @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i = i + 1 {
		var g @types.Field = make(types.Field)
		g.Type = types.TypInt8()
		f3[i] = g
	}
	var tri @types.Type = types.MakeStructType("Tri", f3)
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(tri))
	var ptr @ir.Instr = irbuild.EmitLoad(e, p, types.MakePointerType(tri))
	var v @ir.Instr = irbuild.EmitLoad(e, ptr, tri)
	irbuild.EmitExtract(e, v, 0, types.TypInt8())
	irbuild.EmitReturn(e, elisionNoRets())
	if aggLoadElidable(f, v) {
		return "a sub-word-aligned aggregate must not be extract-elided (arm32 fault)"
	}
	return ""
}

// (S-extract) A load whose sole use is an AGGREGATE-typed extract is NOT
// extract-elidable: an aggregate extract emits an address-of-sub-object aliasing the
// source, and the actual read is deferred to a consumer of THAT pointer (outside the
// (li, lastUse] window the elision guards) — so the source could be freed first.
// Only field-precise scalar extracts, which read within the window, qualify.
func TestAggLoadNotElidableAggregateExtract() testing.TestResult {
	setTarget64()
	var pair @types.Type = elisionPairTyp() // 16 bytes, an aggregate field
	var of @[]@types.Field = make_slice(@types.Field, 2)
	var g0 @types.Field = make(types.Field)
	g0.Name = "inner"
	g0.Type = pair
	of[0] = g0
	var g1 @types.Field = make(types.Field)
	g1.Name = "tail"
	g1.Type = types.TypInt()
	of[1] = g1
	var outer @types.Type = types.MakeStructType("Outer", of) // 24 bytes on LP64

	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(outer))
	var ptr @ir.Instr = irbuild.EmitLoad(e, p, types.MakePointerType(outer))
	var v @ir.Instr = irbuild.EmitLoad(e, ptr, outer) // non-alloca source
	irbuild.EmitExtract(e, v, 0, pair) // AGGREGATE-typed extract — deferred read
	irbuild.EmitReturn(e, elisionNoRets())
	if aggLoadElidable(f, v) {
		return "a load consumed by an aggregate-typed extract must not be S-extract-elided"
	}
	return ""
}

// A whole load from a package GLOBAL (an IsGlobalRef OP_ALLOC — a fresh pseudo per
// use, so its address always looks confined) with a call between the load and its
// use is NOT elidable: the call may write the global, so an alias would read the
// global after the call — `show(gt, bump())` with bump writing gt.
func TestAggLoadNotElidableGlobalSourceCallBetween() testing.TestResult {
	var m @ir.Module = ir.NewModule("test")
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var agg @types.Type = elisionPairTyp()
	var g @ir.Instr = irbuild.NewGlobalRef(m, "gt", agg)
	var b @ir.Instr = irbuild.EmitAlloc(e, agg)
	var v @ir.Instr = irbuild.EmitLoad(e, g, agg)
	irbuild.EmitCall(e, "bump", make_slice(@ir.Instr, 0), types.TypInt())
	irbuild.EmitStore(e, b, v)
	irbuild.EmitReturn(e, elisionNoRets())
	if aggLoadElidable(f, v) {
		return "a load from a global with a call before its use must not be elidable"
	}
	return ""
}

// A fault pad naming the source slot and the load does not block the elision: only
// the VM runs fault pads, and the backends this serves emit none.
func TestAggLoadElidableIgnoresFaultPads() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var agg @types.Type = elisionPairTyp()
	var a @ir.Instr = irbuild.EmitAlloc(e, agg)
	var b @ir.Instr = irbuild.EmitAlloc(e, agg)
	var v @ir.Instr = irbuild.EmitLoad(e, a, agg)
	irbuild.EmitStore(e, b, v)
	irbuild.EmitReturn(e, elisionNoRets())
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	var args @[]@ir.Instr = make_slice(@ir.Instr, 2)
	args[0] = a
	args[1] = v
	irbuild.EmitCall(pad, "release", args, types.TypVoid())
	irbuild.EmitReturn(pad, elisionNoRets())
	if !aggLoadElidable(f, v) {
		return "a fault pad naming the source or the load does not block the elision"
	}
	return ""
}

// A stack slot named only in a fault pad is still confined: a load of it too wide
// for the adjacent-store rule, with a call before its use, is elided by the
// stack-slot rule.
func TestAggLoadElidableConfinedSlotNamedInFaultPad() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var q @types.Type = elisionQuadTyp()
	var a @ir.Instr = irbuild.EmitAlloc(e, q)
	var b @ir.Instr = irbuild.EmitAlloc(e, q)
	var v @ir.Instr = irbuild.EmitLoad(e, a, q)
	irbuild.EmitCall(e, "work", noInstrs(), types.TypVoid())
	irbuild.EmitStore(e, b, v)
	irbuild.EmitReturn(e, elisionNoRets())
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	irbuild.EmitCall(pad, "release", oneArg(a), types.TypVoid())
	irbuild.EmitReturn(pad, elisionNoRets())
	if !aggLoadElidable(f, v) {
		return "a slot named only in a fault pad is still confined: the load is elided"
	}
	return ""
}

// wideReturnFunc returns a function returning a Quad (32 bytes, too wide for the
// 16-byte S-adjacent cap) whose entry block loads it through a raw pointer read from
// a slot — an unknown source — with the entry block and the load; the caller adds
// the rest.
func wideReturnFunc() (@ir.Func, @ir.Block, @ir.Instr) {
	setTarget64()
	var q @types.Type = elisionQuadTyp()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), quadResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(q))
	var ptr @ir.Instr = irbuild.EmitLoad(e, p, types.MakePointerType(q))
	return f, e, irbuild.EmitLoad(e, ptr, q)
}

// `return *p` of a wide aggregate: the return copies it into the caller's result
// buffer, which overlaps no source, so the load reads *p in place at any size.
func TestAggLoadElidableReturnedWide() testing.TestResult {
	f, e, v := wideReturnFunc()
	irbuild.EmitReturn(e, retOf(v))
	if !aggLoadElidable(f, v) { return "a wide load returned whole reads its source in place" }
	return ""
}

// A wide load with another use besides its return, or with a call between it and
// its return, still materializes.
func TestAggLoadNotElidableReturnedWideOtherwise() testing.TestResult {
	f, e, v := wideReturnFunc()
	var dst @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	irbuild.EmitStore(e, dst, v)
	irbuild.EmitReturn(e, retOf(v))
	if aggLoadElidable(f, v) { return "a wide load also stored elsewhere keeps the cap" }
	g, ge, gv := wideReturnFunc()
	irbuild.EmitCall(ge, "work", noInstrs(), types.TypVoid())
	irbuild.EmitReturn(ge, retOf(gv))
	if aggLoadElidable(g, gv) { return "a call between the load and its return blocks the elision" }
	return ""
}

// fieldReadFunc returns a function whose entry block declares a Quad slot a and a
// destination slot b, loads a whole, and then derives a field pointer of a — with
// the entry block, a, b, the load and the field pointer; the caller uses them and
// adds the rest.
func fieldReadFunc() (@ir.Func, @ir.Block, @ir.Instr, @ir.Instr, @ir.Instr, @ir.Instr) {
	setTarget64()
	var q @types.Type = elisionQuadTyp()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Instr = irbuild.EmitAlloc(e, q)
	var b @ir.Instr = irbuild.EmitAlloc(e, q)
	var v @ir.Instr = irbuild.EmitLoad(e, a, q)
	return f, e, a, b, v, irbuild.EmitGetFieldPtr(e, a, 0, types.TypInt())
}

// A slot whose field is only read through a field pointer (`t := x.n; y = x`)
// stays confined: its whole load is elided under S-alloca, even past a call.
func TestAggLoadElidableSlotWithFieldRead() testing.TestResult {
	f, e, _, b, v, fp := fieldReadFunc()
	irbuild.EmitLoad(e, fp, types.TypInt())
	irbuild.EmitCall(e, "work", noInstrs(), types.TypVoid())
	irbuild.EmitStore(e, b, v)
	irbuild.EmitReturn(e, elisionNoRets())
	if !aggLoadElidable(f, v) { return "a slot only read through a field pointer stays confined" }
	return ""
}

// A field pointer reaching an element pointer read only (`x.arr[i]`) keeps the slot
// confined too.
func TestAggLoadElidableSlotWithElementRead() testing.TestResult {
	setTarget64()
	var arr @types.Type = types.MakeArrayType(types.TypInt(), 4)
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var names @[]@[]char = @[]@[]char{"a", "b"}
	for i := 0; i < 2; i++ {
		var fl @types.Field = make(types.Field)
		fl.Name = names[i]
		fl.Type = arr
		fields[i] = fl
	}
	var st @types.Type = types.MakeStructType("TwoArr", fields)
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Instr = irbuild.EmitAlloc(e, st)
	var b @ir.Instr = irbuild.EmitAlloc(e, st)
	var v @ir.Instr = irbuild.EmitLoad(e, a, st)
	var fp @ir.Instr = irbuild.EmitGetFieldPtr(e, a, 1, arr)
	var ep @ir.Instr = irbuild.EmitGetElemPtr(e, fp, irbuild.EmitConstInt(e, 2, types.TypInt()),
			types.TypInt())
	irbuild.EmitLoad(e, ep, types.TypInt())
	irbuild.EmitCall(e, "work", noInstrs(), types.TypVoid())
	irbuild.EmitStore(e, b, v)
	irbuild.EmitReturn(e, elisionNoRets())
	if !aggLoadElidable(f, v) { return "a slot only read through an element pointer stays confined" }
	return ""
}

// A store through a field pointer, or a field pointer passed to a call, can write
// the slot: its whole load is not elided under S-alloca.
func TestAggLoadNotElidableSlotWrittenThroughField() testing.TestResult {
	f, e, _, b, v, fp := fieldReadFunc()
	irbuild.EmitStore(e, fp, irbuild.EmitConstInt(e, 5, types.TypInt()))
	irbuild.EmitCall(e, "work", noInstrs(), types.TypVoid())
	irbuild.EmitStore(e, b, v)
	irbuild.EmitReturn(e, elisionNoRets())
	if aggLoadElidable(f, v) { return "a store through a field pointer writes the slot: not confined" }
	g, ge, _, gb, gv, gfp := fieldReadFunc()
	irbuild.EmitCall(ge, "use", oneArg(gfp), types.TypVoid())
	irbuild.EmitStore(ge, gb, gv)
	irbuild.EmitReturn(ge, elisionNoRets())
	if aggLoadElidable(g, gv) { return "a field pointer passed to a call escapes: not confined" }
	return ""
}

// A wide load from an unknown source whose one use is a whole store reads its source
// in place at any size, its store copying as memmove does
// (AGG_LOAD_IN_PLACE_OVERLAPPING) — not with another use besides the store.
func TestAggLoadElisionStoredWhole() testing.TestResult {
	setTarget64()
	var shapes @[]@types.Type = @[]@types.Type{elisionQuadTyp(),
			types.MakeArrayType(types.TypInt(), 101)}
	for ti := 0; ti < len(shapes); ti++ {
		var q @types.Type = shapes[ti]
		var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
		var e @ir.Block = ir.AddBlock(f, "entry")
		var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(q))
		var dst @ir.Instr = irbuild.EmitAlloc(e, q)
		var v @ir.Instr = irbuild.EmitLoad(e, irbuild.EmitLoad(e, p, types.MakePointerType(q)), q)
		irbuild.EmitStore(e, dst, v)
		irbuild.EmitReturn(e, elisionNoRets())
		if AggLoadElision(f, v) != AGG_LOAD_IN_PLACE_OVERLAPPING || !aggLoadElidable(f, v) {
			return "a load stored whole reads its source in place, at any size"
		}
	}
	var q2 @types.Type = elisionQuadTyp()
	var g @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var ge @ir.Block = ir.AddBlock(g, "entry")
	var gp @ir.Instr = irbuild.EmitAlloc(ge, types.MakePointerType(q2))
	var gdst @ir.Instr = irbuild.EmitAlloc(ge, q2)
	var gother @ir.Instr = irbuild.EmitAlloc(ge, q2)
	var gv @ir.Instr = irbuild.EmitLoad(ge, irbuild.EmitLoad(ge, gp, types.MakePointerType(q2)), q2)
	irbuild.EmitStore(ge, gdst, gv)
	irbuild.EmitStore(ge, gother, gv)
	irbuild.EmitReturn(ge, elisionNoRets())
	if AggLoadElision(g, gv) != AGG_LOAD_COPIED {
		return "a load stored twice is not stored whole once"
	}
	return ""
}

// Frame planning reads a wide load stored whole in place and flags it, so its store
// copies as memmove does (InPlaceOverlapping), with no data region of its own; one of
// at most 16 bytes is read in place unflagged — every backend copies it by loading
// all of it before storing any.
func TestPlanFrameFlagsOverlappingStoredLoad() testing.TestResult {
	setTarget64()
	var shapes @[]@types.Type = @[]@types.Type{types.MakeArrayType(types.TypInt(), 101),
			types.MakeArrayType(types.TypInt(), 2)}
	for ti := 0; ti < len(shapes); ti++ {
		var t @types.Type = shapes[ti]
		var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
		var e @ir.Block = ir.AddBlock(f, "entry")
		var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(t))
		var dst @ir.Instr = irbuild.EmitAlloc(e, t)
		var v @ir.Instr = irbuild.EmitLoad(e, irbuild.EmitLoad(e, p, types.MakePointerType(t)), t)
		irbuild.EmitStore(e, dst, v)
		irbuild.EmitReturn(e, elisionNoRets())
		var rm @RegMap = nrm()
		rm.PlanFrame(f)
		if rm.LookupAlloc(v.ID) >= 0 { return "a load stored whole is read in place: no data region" }
		var wide bool = ti == 0
		if rm.IsInPlaceOverlapping(v.ID) != wide {
			return "a wide load stored whole is flagged for a memmove copy; a 16-byte one is not"
		}
		var want int = AGG_LOAD_IN_PLACE
		if wide { want = AGG_LOAD_IN_PLACE_OVERLAPPING }
		if AggLoadElision(f, v) != want { return "the classification matches the plan" }
	}
	return ""
}
