package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A sub-word-aligned aggregate (a byte array) of more than 16 bytes is read in place by a
// whole store, which copies it as memmove does, or by a return of it, which copies it
// into the caller's result buffer: a copy staged in the frame would cost its size in
// stack.  Any other use, or a load of at most 16 bytes, keeps the word-aligned copy a
// strict-align arm32 consumer needs.

// subWordStoreFunc returns a function loading a value of type t through a pointer and
// storing it whole into stores slots, and the load.
func subWordStoreFunc(t @types.Type, stores int) (@ir.Func, @ir.Instr) {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(t))
	var dsts @[]@ir.Instr = make_slice(@ir.Instr, stores)
	for i := 0; i < stores; i++ {
		dsts[i] = irbuild.EmitAlloc(e, t)
	}
	var v @ir.Instr = irbuild.EmitLoad(e, irbuild.EmitLoad(e, p, types.MakePointerType(t)), t)
	for i := 0; i < stores; i++ {
		irbuild.EmitStore(e, dsts[i], v)
	}
	irbuild.EmitReturn(e, elisionNoRets())
	return f, v
}

// A byte array of 17 bytes, or of 16 MiB, stored whole reads its source in place, its
// store copying as memmove does; one of 16 bytes keeps its copy.
func TestAggLoadElisionStoredWholeSubWord() testing.TestResult {
	var sizes @[]int64 = @[]int64{17, 0x1000000}
	for i := 0; i < len(sizes); i++ {
		f, v := subWordStoreFunc(types.MakeArrayType(types.TypUint8(), sizes[i]), 1)
		if AggLoadElision(f, v) != AGG_LOAD_IN_PLACE_OVERLAPPING {
			return "a sub-word-aligned load of more than 16 bytes stored whole is read in place"
		}
	}
	g, w := subWordStoreFunc(types.MakeArrayType(types.TypUint8(), 16), 1)
	if AggLoadElision(g, w) != AGG_LOAD_COPIED {
		return "a sub-word-aligned load of 16 bytes keeps its copy"
	}
	return ""
}

// A sub-word-aligned load stored twice is not stored whole once: it keeps its copy.
func TestAggLoadElisionSubWordStoredTwice() testing.TestResult {
	f, v := subWordStoreFunc(types.MakeArrayType(types.TypUint8(), 64), 2)
	if AggLoadElision(f, v) != AGG_LOAD_COPIED { return "a load stored twice keeps its copy" }
	return ""
}

// subWordLoadFunc returns a function with results whose entry block loads a value of
// type t through a raw pointer read from a slot (an unknown source), with the block and
// the load; the caller adds the rest.
func subWordLoadFunc(t @types.Type, results @[]@types.Type) (@ir.Func, @ir.Block, @ir.Instr) {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), results)
	var e @ir.Block = ir.AddBlock(f, "entry")
	var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(t))
	return f, e, irbuild.EmitLoad(e, irbuild.EmitLoad(e, p, types.MakePointerType(t)), t)
}

// A sub-word-aligned load of more than 16 bytes keeps its copy for anything but a whole
// store or a return of it with only pure ops before: a call between the load and its
// store, or field reads alone (the S-extract rule leaves sub-word types out).  A stack
// slot allocated between the load and its store does not stop it (`var x T = *p`).
func TestAggLoadElisionSubWordOtherUses() testing.TestResult {
	var t @types.Type = types.MakeArrayType(types.TypUint8(), 64)
	f, e, v := subWordLoadFunc(t, elisionNoResults())
	var dst @ir.Instr = irbuild.EmitAlloc(e, t)
	irbuild.EmitCall(e, "work", noInstrs(), types.TypVoid())
	irbuild.EmitStore(e, dst, v)
	irbuild.EmitReturn(e, elisionNoRets())
	if AggLoadElision(f, v) != AGG_LOAD_COPIED {
		return "a call between the load and its store forces the copy"
	}
	g, ge, gv := subWordLoadFunc(t, @[]@types.Type{t})
	irbuild.EmitReturn(ge, retOf(gv))
	if AggLoadElision(g, gv) != AGG_LOAD_IN_PLACE {
		return "a sub-word-aligned load of more than 16 bytes returned whole is read in place"
	}
	var t16 @types.Type = types.MakeArrayType(types.TypUint8(), 16)
	r, re, rv := subWordLoadFunc(t16, @[]@types.Type{t16})
	irbuild.EmitReturn(re, retOf(rv))
	if AggLoadElision(r, rv) != AGG_LOAD_COPIED {
		return "a sub-word-aligned load of 16 bytes returned whole keeps its copy"
	}
	var t17 @types.Type = types.MakeArrayType(types.TypUint8(), 17)
	q, qe, qv := subWordLoadFunc(t17, @[]@types.Type{t17})
	irbuild.EmitReturn(qe, retOf(qv))
	if AggLoadElision(q, qv) != AGG_LOAD_IN_PLACE {
		return "a sub-word-aligned load of 17 bytes returned whole is read in place"
	}
	m, me, mv := subWordLoadFunc(t, @[]@types.Type{t})
	irbuild.EmitCall(me, "work", noInstrs(), types.TypVoid())
	irbuild.EmitReturn(me, retOf(mv))
	if AggLoadElision(m, mv) != AGG_LOAD_COPIED {
		return "a call between the load and its return forces the copy"
	}
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypUint8()
	fields[1] = make(types.Field)
	fields[1].Type = t
	var st @types.Type = types.MakeStructType("Bytes", fields)
	h, he, hv := subWordLoadFunc(st, elisionNoResults())
	irbuild.EmitExtract(he, hv, 0, types.TypUint8())
	irbuild.EmitReturn(he, elisionNoRets())
	if AggLoadElision(h, hv) != AGG_LOAD_COPIED {
		return "field reads alone of a sub-word-aligned load keep its copy"
	}
	k, ke, kv := subWordLoadFunc(t, elisionNoResults())
	var kdst @ir.Instr = irbuild.EmitAlloc(ke, t)
	irbuild.EmitStore(ke, kdst, kv)
	irbuild.EmitReturn(ke, elisionNoRets())
	if AggLoadElision(k, kv) != AGG_LOAD_IN_PLACE_OVERLAPPING {
		return "a stack slot allocated between the load and its store does not stop it reading in place"
	}
	return ""
}
