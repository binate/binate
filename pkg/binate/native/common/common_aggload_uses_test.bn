package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for AggLoadElision's whole-function questions, which it answers from the
// function's use index: a phi in another block naming the load, a source slot whose
// address reaches a phi or a store through pointers derived from it, the index asked
// about one slot twice, and AggLoadElider.  (An alias used in another block is in
// common_aggload_alias_test.bn.)

// confinedLoadFunc returns a function whose entry block loads a Pair slot a, calls
// `work` (so only the confined-slot shape can elide) and stores the load into slot b,
// with its entry block, a, and the load; the entry block is left open.
func confinedLoadFunc() (@ir.Func, @ir.Block, @ir.Instr, @ir.Instr) {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Instr = irbuild.EmitAlloc(e, elisionPairTyp())
	var b @ir.Instr = irbuild.EmitAlloc(e, elisionPairTyp())
	var v @ir.Instr = irbuild.EmitLoad(e, a, elisionPairTyp())
	irbuild.EmitCall(e, "work", noInstrs(), types.TypVoid())
	irbuild.EmitStore(e, b, v)
	return f, e, a, v
}

// A field pointer of the source slot flowing into a phi (in another block) is an
// address the confinement check cannot follow: the load is copied.
func TestAggLoadNotElidableFieldPointerInPhi() testing.TestResult {
	setTarget64()
	f, e, _, v := confinedLoadFunc()
	irbuild.EmitReturn(e, elisionNoRets())
	if !aggLoadElidable(f, v) { return "the confined-slot load elides without the phi" }
	g, ge, ga, gv := confinedLoadFunc()
	var fp @ir.Instr = irbuild.EmitGetFieldPtr(ge, ga, 0, types.TypInt())
	var next @ir.Block = ir.AddBlock(g, "next")
	irbuild.EmitJump(ge, next)
	irbuild.EmitPhi(next, types.MakePointerType(types.TypInt()), twoPE(ge, fp, ge, fp))
	irbuild.EmitReturn(next, elisionNoRets())
	if aggLoadElidable(g, gv) { return "a field pointer reaching a phi breaks the confinement" }
	return ""
}

// A phi in another block naming the load is a use outside the load's block: the load
// is copied.
func TestAggLoadNotElidablePhiUseInOtherBlock() testing.TestResult {
	setTarget64()
	f, e, _, v := confinedLoadFunc()
	var next @ir.Block = ir.AddBlock(f, "next")
	irbuild.EmitJump(e, next)
	irbuild.EmitPhi(next, elisionPairTyp(), twoPE(e, v, e, v))
	irbuild.EmitReturn(next, elisionNoRets())
	if aggLoadElidable(f, v) { return "a phi of the load in another block keeps the copy" }
	return ""
}

// The confinement check on one index asked twice about the same slot — two loads of
// it, as PlanFrame asks — fails both times when a field pointer of the slot is a store
// address; a store two levels down (through an element pointer of a field pointer)
// and the slot itself as a phi entry break the confinement too.
func TestAggLoadNotElidableConfinementBroken() testing.TestResult {
	setTarget64()
	f, e, a, v := confinedLoadFunc()
	var b @ir.Instr = irbuild.EmitAlloc(e, elisionPairTyp())
	var v2 @ir.Instr = irbuild.EmitLoad(e, a, elisionPairTyp())
	irbuild.EmitCall(e, "work", noInstrs(), types.TypVoid())
	irbuild.EmitStore(e, b, v2)
	irbuild.EmitStore(e, irbuild.EmitGetFieldPtr(e, a, 0, types.TypInt()),
			irbuild.EmitConstInt(e, 7, types.TypInt()))
	irbuild.EmitReturn(e, elisionNoRets())
	var el @AggLoadElider = NewAggLoadElider(f)
	if el.Elision(v) != AGG_LOAD_COPIED || el.Elision(v2) != AGG_LOAD_COPIED {
		return "a store through a field pointer breaks the confinement for every load of the slot"
	}
	g, ge, ga, gv := confinedLoadFunc()
	var fp @ir.Instr = irbuild.EmitGetFieldPtr(ge, ga, 0, types.TypInt())
	var ep @ir.Instr = irbuild.EmitGetElemPtr(ge, fp, irbuild.EmitConstInt(ge, 0, types.TypInt()),
			types.TypInt())
	irbuild.EmitStore(ge, ep, irbuild.EmitConstInt(ge, 7, types.TypInt()))
	irbuild.EmitReturn(ge, elisionNoRets())
	if aggLoadElidable(g, gv) { return "a store two levels down breaks the confinement" }
	h, he, ha, hv := confinedLoadFunc()
	var next @ir.Block = ir.AddBlock(h, "next")
	irbuild.EmitJump(he, next)
	irbuild.EmitPhi(next, types.MakePointerType(elisionPairTyp()), twoPE(he, ha, he, ha))
	irbuild.EmitReturn(next, elisionNoRets())
	if aggLoadElidable(h, hv) { return "the slot itself as a phi entry breaks the confinement" }
	return ""
}

// The elider gives AggLoadElision's answer for each load of its function.
func TestAggLoadEliderMatchesAggLoadElision() testing.TestResult {
	setTarget64()
	f, e, a, v := confinedLoadFunc()
	var b @ir.Instr = irbuild.EmitAlloc(e, elisionPairTyp())
	var v2 @ir.Instr = irbuild.EmitLoad(e, a, elisionPairTyp())
	var next @ir.Block = ir.AddBlock(f, "next")
	irbuild.EmitJump(e, next)
	irbuild.EmitStore(next, b, v2)
	irbuild.EmitReturn(next, elisionNoRets())
	var el @AggLoadElider = NewAggLoadElider(f)
	if el.Elision(v) != AggLoadElision(f, v) || el.Elision(v2) != AggLoadElision(f, v2) {
		return "the elider answers as AggLoadElision does"
	}
	if el.Elision(v) == AGG_LOAD_COPIED || el.Elision(v2) != AGG_LOAD_COPIED {
		return "the first load elides; the one used in another block does not"
	}
	return ""
}
