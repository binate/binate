package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"

// The whole-use shapes of AggLoadElision's S-adjacent rule: a load whose one use returns
// it, passes it to a call or stores it whole is read in place past the rule's 16-byte cap.

// returnedWhole reports whether load ld's only use (in blk, after index li, where it
// is) is the OP_RETURN returning it as f's one result.  The return reads the source
// before anything else touches it — into registers, or, for a result returned in
// memory, into the caller's result buffer — and no result buffer is reachable by the
// callee, so the copy cannot overlap the source at any size.  Every buffer a caller
// passes is a fresh temporary (a call result's region or alloca, the VM's on its
// stack), a local whose address never leaves the caller (CallResultSlots), or the
// caller's own incoming buffer passed on (ReturnedCallResults, RetbufLocal and the
// calls writing it), private in turn; a C caller's aliases nothing either (a C
// compiler uses a temporary when the destination may be aliased).
func returnedWhole(f @ir.Func, blk @ir.Block, li int, ld @ir.Instr) bool {
	if len(f.Results) != 1 { return false }
	var found bool = false
	for ii := li + 1; ii < len(blk.Instrs); ii++ {
		var ins @ir.Instr = blk.Instrs[ii]
		var uses bool = false
		for k := 0; k < len(ins.Args); k++ {
			if ins.Args[k] == ld { uses = true }
		}
		if !uses { continue }
		if found || ins.Op != iropcode.OP_RETURN || len(ins.Args) != 1 { return false }
		found = true
	}
	return found
}

// passedWhole reports whether load ld's only use (in blk, after index li, where it is)
// is one by-value argument of a direct, indirect, function-value, handle or interface
// method call — not its callee, and not a `__c_call`'s argument, which
// lastReadOnlyUseIndex refuses (a C callee may write an AAPCS64 indirect argument in
// place).  The call reads the source as its lowering begins, before anything else
// touches it, and copies it into memory no pointer of the program reaches: argument
// registers, the outgoing argument area, or an argument region of the call's own
// (planArgCopies: AAPCS64's aggregates over 16 bytes, which the callee may write — an
// in-place load has no region of its own to pass).  A function-value or interface
// method call passes the address to the target's shim (or the VM's trampoline), which
// only reads it to lay the arguments out again.  So the copy cannot overlap the source
// at any size.
func passedWhole(blk @ir.Block, li int, ld @ir.Instr) bool {
	var found bool = false
	for ii := li + 1; ii < len(blk.Instrs); ii++ {
		var ins @ir.Instr = blk.Instrs[ii]
		var base int = callArgBase(ins.Op)
		var isCall bool = ins.Op == iropcode.OP_CALL || isIndirectCallOp(ins.Op)
		for k := 0; k < len(ins.Args); k++ {
			if ins.Args[k] != ld { continue }
			if found || !isCall || k < base { return false }
			found = true
		}
	}
	return found
}

// storedWhole reports whether load ld's only use (in blk, after index li, where it is)
// is a whole OP_STORE of it — the value stored, not the address stored into.
func storedWhole(blk @ir.Block, li int, ld @ir.Instr) bool {
	var found bool = false
	for ii := li + 1; ii < len(blk.Instrs); ii++ {
		var ins @ir.Instr = blk.Instrs[ii]
		var uses bool = false
		for k := 0; k < len(ins.Args); k++ {
			if ins.Args[k] == ld { uses = true }
		}
		if !uses { continue }
		if found || ins.Op != iropcode.OP_STORE || len(ins.Args) != 2 || ins.Args[0] == ld {
			return false
		}
		found = true
	}
	return found
}
