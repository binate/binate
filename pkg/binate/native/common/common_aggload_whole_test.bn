package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A load from an unknown source whose one use is a by-value argument of a call is read
// in place past the 16-byte cap, at any alignment: the call copies it into its argument
// registers, its outgoing area or an argument region of its own (or a shim reads it to
// lay it out again), memory no pointer of the program reaches.  A call between the load
// and its call, a second use or a `__c_call` keeps the copy.

// The call shapes argCall emits: direct, function value, interface method, raw function
// pointer, function-value handle.
const ARG_CALL_KINDS int = 5

// argCallName names call shape kind (argCall) for a failure message.
func argCallName(kind int) *[]readonly char {
	if kind == 0 { return "a direct call" }
	if kind == 1 { return "a function-value call" }
	if kind == 2 { return "an interface method call" }
	if kind == 3 { return "a raw function pointer call" }
	return "a handle call"
}

// argLoadFunc returns a function whose entry block holds a function value, an interface
// value and a raw function pointer, then a load of a value of type t through a raw
// pointer read from a slot (an unknown source) -- with the block, the load and the
// three callees; the caller adds the rest.
func argLoadFunc(t @types.Type) (@ir.Func, @ir.Block, @ir.Instr, @ir.Instr, @ir.Instr, @ir.Instr) {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var p0 @types.Param = make(types.Param)
	p0.Type = t
	params[0] = p0
	var fv @ir.Instr = irbuild.EmitConstNil(e, types.MakeFuncValueType(params, elisionNoResults()))
	var ivTyp @types.Type = make(types.Type)
	ivTyp.Kind = types.TYP_INTERFACE_VALUE
	var dp @ir.Instr = irbuild.EmitConstInt(e, 0, types.MakePointerType(types.TypUint8()))
	var iv @ir.Instr = irbuild.EmitIfaceValue(e, dp, "__ivt.bn_test__T__test__I", ivTyp)
	var fp @ir.Instr = irbuild.EmitConstInt(e, 0, types.MakePointerType(types.TypUint8()))
	var slot @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(t))
	var ld @ir.Instr = irbuild.EmitLoad(e, irbuild.EmitLoad(e, slot, types.MakePointerType(t)), t)
	return f, e, ld, fv, iv, fp
}

// argCall emits a void call of shape kind (argCallName) with arguments args: to "g",
// through fv, iv's method 0, fp, or fp as a handle -- a function-value or interface
// method call after its stack check, as IR-gen emits it (the compiled backends emit
// nothing for one).
func argCall(e @ir.Block, kind int, args @[]@ir.Instr, fv @ir.Instr, iv @ir.Instr, fp @ir.Instr) {
	if kind == 0 {
		irbuild.EmitCall(e, "g", args, types.TypVoid())
	} else if kind == 1 {
		irbuild.EmitStackCheckFV(e, fv)
		irbuild.EmitCallFuncValue(e, fv, args, types.TypVoid())
	} else if kind == 2 {
		irbuild.EmitStackCheckIM(e, iv, 0)
		irbuild.EmitCallIfaceMethod(e, iv, args, 0, types.TypVoid())
	} else if kind == 3 {
		irbuild.EmitCallIndirect(e, fp, args, types.TypVoid())
	} else {
		irbuild.EmitCallHandle(e, fp, args, types.TypVoid())
	}
}

// argList returns the argument list holding vs.
func argList(vs ...@ir.Instr) @[]@ir.Instr {
	var out @[]@ir.Instr = make_slice(@ir.Instr, len(vs))
	for i := 0; i < len(vs); i++ { out[i] = vs[i] }
	return out
}

// argFail returns a failure message naming what was checked, the call shape and the
// argument's type.
func argFail(what *[]readonly char, kind int, typ *[]readonly char) testing.TestResult {
	return buf.Concat(buf.Concat(what, ", through "),
			buf.Concat(argCallName(kind), buf.Concat(", ", typ)))
}

// A 32-byte struct, and byte arrays of 17 bytes and 16 MiB, passed as the one argument of
// each call shape are read in place; a 16-byte byte array keeps the word-aligned copy a
// strict-align arm32 consumer needs.
func TestAggLoadElisionPassedToCall() testing.TestResult {
	setTarget64()
	var ts @[]@types.Type = @[]@types.Type{elisionQuadTyp(), types.MakeArrayType(types.TypUint8(), 17),
			types.MakeArrayType(types.TypUint8(), 0x1000000), types.MakeArrayType(types.TypUint8(), 16)}
	var names @[]*[]readonly char = @[]*[]readonly char{"a 32-byte struct", "a 17-byte array",
			"a 16 MiB array", "a 16-byte array"}
	for i := 0; i < len(ts); i++ {
		var want int = AGG_LOAD_IN_PLACE
		if i == 3 { want = AGG_LOAD_COPIED }
		for kind := 0; kind < ARG_CALL_KINDS; kind++ {
			f, e, ld, fv, iv, fp := argLoadFunc(ts[i])
			argCall(e, kind, argList(ld), fv, iv, fp)
			irbuild.EmitReturn(e, elisionNoRets())
			if AggLoadElision(f, ld) != want {
				return argFail("the load passed as an argument", kind, names[i])
			}
		}
	}
	return ""
}

// The load keeps its copy when a call runs between it and the call it is passed to (`g(*p,
// h())`, h possibly writing *p), when it is passed twice or also stored, and when a
// `__c_call` takes it (a C callee may write an AAPCS64 indirect argument in place).
func TestAggLoadElisionPassedOtherwise() testing.TestResult {
	setTarget64()
	var q @types.Type = elisionQuadTyp()
	for kind := 0; kind < ARG_CALL_KINDS; kind++ {
		f, e, ld, fv, iv, fp := argLoadFunc(q)
		var h @ir.Instr = irbuild.EmitCall(e, "h", noInstrs(), types.TypInt())
		argCall(e, kind, argList(ld, h), fv, iv, fp)
		irbuild.EmitReturn(e, elisionNoRets())
		if AggLoadElision(f, ld) != AGG_LOAD_COPIED {
			return argFail("a call before the argument's call", kind, "a 32-byte struct")
		}
		g, ge, gl, gfv, giv, gfp := argLoadFunc(q)
		argCall(ge, kind, argList(gl, gl), gfv, giv, gfp)
		irbuild.EmitReturn(ge, elisionNoRets())
		if AggLoadElision(g, gl) != AGG_LOAD_COPIED {
			return argFail("the load passed twice", kind, "a 32-byte struct")
		}
		k, ke, kl, kfv, kiv, kfp := argLoadFunc(q)
		irbuild.EmitStore(ke, irbuild.EmitAlloc(ke, q), kl)
		argCall(ke, kind, argList(kl), kfv, kiv, kfp)
		irbuild.EmitReturn(ke, elisionNoRets())
		if AggLoadElision(k, kl) != AGG_LOAD_COPIED {
			return argFail("the load also stored", kind, "a 32-byte struct")
		}
	}
	c, ce, cl, _, _, _ := argLoadFunc(q)
	irbuild.EmitCCall(ce, "c", argList(cl), types.TypVoid(), 1, false)
	irbuild.EmitReturn(ce, elisionNoRets())
	if AggLoadElision(c, cl) != AGG_LOAD_COPIED { return "a __c_call argument keeps its copy" }
	return ""
}
