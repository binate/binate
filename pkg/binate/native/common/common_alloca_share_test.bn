package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/containers/vec"

// Tests for common_alloca_share.bn: allocas shared by scope.

// scopedSlot appends to b an int slot of f in scope s, written whole, and returns it.
func scopedSlot(f @ir.Func, b @ir.Block, s int) @ir.Instr {
	var a @ir.Instr = irbuild.EmitAlloc(b, types.TypInt())
	a.Scope = s
	irbuild.EmitStore(b, a, irbuild.EmitConstInt(b, 1, types.TypInt()))
	return a
}

// noPlaced returns an inplace.CallResultSlots table of f with no call placed into a slot.
func noPlaced(f @ir.Func) @[]int {
	var p @[]int = make_slice(int, f.NextID)
	for i := 0; i < len(p); i++ { p[i] = -1 }
	return p
}

// shareOf runs planSharedAllocas over f's slots (8 bytes each) and returns their
// offsets and the bytes they take.
func shareOf(f @ir.Func, slots @[]@ir.Instr) (@[]int64, int64) {
	var ids @[]int = make_slice(int, len(slots))
	var sizes @[]int64 = make_slice(int64, len(slots))
	for k := 0; k < len(slots); k++ {
		ids[k] = slots[k].ID
		sizes[k] = 8
	}
	return planSharedAllocas(f, newLiveCFG(f), ids, sizes, eightAligned(len(ids)), noPlaced(f))
}

// eightAligned returns n alignments of 8, a 64-bit target's for any slot.
func eightAligned(n int) @[]int64 {
	var aligns @[]int64 = make_slice(int64, n)
	for k := 0; k < n; k++ { aligns[k] = 8 }
	return aligns
}

// two returns a two-element list of x and y.
func two(x @ir.Instr, y @ir.Instr) @[]@ir.Instr {
	var l @[]@ir.Instr = make_slice(@ir.Instr, 2)
	l[0] = x
	l[1] = y
	return l
}

// The slots of two scopes one after the other share bytes; nested ones do not.
func TestSharedAllocasSiblingsShareNestedDoNot() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s1 int = irbuild.NewScope(f)
	var s2 int = irbuild.NewScope(f)
	var a @ir.Instr = scopedSlot(f, e, s1)
	irbuild.EmitScopeEnd(e, s1)
	var b @ir.Instr = scopedSlot(f, e, s2)
	irbuild.EmitScopeEnd(e, s2)
	irbuild.EmitReturn(e, elisionNoRets())
	offs, total := shareOf(f, two(a, b))
	if offs[0] != offs[1] || total != 8 { return "the slots of sibling scopes share their 8 bytes" }

	f = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	e = ir.AddBlock(f, "entry")
	s1 = irbuild.NewScope(f)
	s2 = irbuild.NewScope(f)
	a = scopedSlot(f, e, s1)
	b = scopedSlot(f, e, s2)
	irbuild.EmitScopeEnd(e, s2)
	irbuild.EmitScopeEnd(e, s1)
	irbuild.EmitReturn(e, elisionNoRets())
	offs, total = shareOf(f, two(a, b))
	if offs[0] == offs[1] || total != 16 {
		return "the slots of nested scopes keep bytes of their own"
	}
	return ""
}

// Slots of different sizes pack first fit: a 24-byte slot shares with two 8-byte
// slots of a later scope, which do not share with each other.
func TestSharedAllocasFirstFit() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s1 int = irbuild.NewScope(f)
	var s2 int = irbuild.NewScope(f)
	var big @ir.Instr = irbuild.EmitAlloc(e, types.MakeArrayType(types.TypInt64(), 3))
	big.Scope = s1
	irbuild.EmitScopeEnd(e, s1)
	var b @ir.Instr = scopedSlot(f, e, s2)
	var c @ir.Instr = scopedSlot(f, e, s2)
	irbuild.EmitScopeEnd(e, s2)
	irbuild.EmitReturn(e, elisionNoRets())
	var ids @[]int = make_slice(int, 3)
	ids[0] = big.ID
	ids[1] = b.ID
	ids[2] = c.ID
	var sizes @[]int64 = make_slice(int64, 3)
	sizes[0] = 24
	sizes[1] = 8
	sizes[2] = 8
	offs, total := planSharedAllocas(f, newLiveCFG(f), ids, sizes, eightAligned(3), noPlaced(f))
	if offs[0] != 0 || offs[1] != 0 || offs[2] != 8 || total != 24 {
		return "b and c fit in big's 24 bytes, b at 0 and c at 8"
	}
	return ""
}

// A loop body's slot, ended each iteration, shares bytes with a slot after the loop.
func TestSharedAllocasLoopBody() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var head @ir.Block = ir.AddBlock(f, "head")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var s1 int = irbuild.NewScope(f)
	var s2 int = irbuild.NewScope(f)
	var cond @ir.Instr = irbuild.EmitConstBool(entry, true)
	irbuild.EmitJump(entry, head)
	irbuild.EmitBranch(head, cond, body, exit)
	var a @ir.Instr = scopedSlot(f, body, s1)
	_ = irbuild.EmitLoad(body, a, types.TypInt())
	irbuild.EmitScopeEnd(body, s1)
	irbuild.EmitJump(body, head)
	var b @ir.Instr = scopedSlot(f, exit, s2)
	irbuild.EmitScopeEnd(exit, s2)
	irbuild.EmitReturn(exit, elisionNoRets())
	offs, _ := shareOf(f, two(a, b))
	if offs[0] != offs[1] { return "the loop body's slot and the slot after the loop share" }
	return ""
}

// A call that writes its result into a slot before the slot's OP_ALLOC (a NoZeroInit
// declaration whose initializer is the call) writes the slot's bytes at the call: a
// slot the call reads there -- its argument -- must not share them.
func TestSharedAllocasPlacedCallInterferes() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s1 int = irbuild.NewScope(f)
	var s2 int = irbuild.NewScope(f)
	var x @ir.Instr = scopedSlot(f, e, s1)
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = x
	var call @ir.Instr = irbuild.EmitCall(e, "g", args, types.TypInt())
	irbuild.EmitScopeEnd(e, s1)
	var y @ir.Instr = irbuild.EmitAlloc(e, types.TypInt())
	y.Scope = s2
	y.NoZeroInit = true
	irbuild.EmitStore(e, y, call)
	irbuild.EmitScopeEnd(e, s2)
	irbuild.EmitReturn(e, elisionNoRets())
	var placed @[]int = noPlaced(f)
	var ids @[]int = make_slice(int, 2)
	ids[0] = x.ID
	ids[1] = y.ID
	var sizes @[]int64 = make_slice(int64, 2)
	sizes[0] = 8
	sizes[1] = 8
	offs, _ := planSharedAllocas(f, newLiveCFG(f), ids, sizes, eightAligned(2), placed)
	if offs[0] != offs[1] { return "setup: with no call placed, x and y share" }
	placed[call.ID] = y.ID
	offs, _ = planSharedAllocas(f, newLiveCFG(f), ids, sizes, eightAligned(2), placed)
	if offs[0] == offs[1] { return "the call writes y while it reads x: they must not share" }
	return ""
}

// readAcrossFunc builds `{ a } { b }` (a in scope 1, b in scope 2, each written),
// then, after both scopes, a load of a (loaded) or a store of a's address into an
// unscoped slot (loaded false), and returns it with a and b.
func readAcrossFunc(loaded bool) (@ir.Func, @ir.Instr, @ir.Instr) {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s1 int = irbuild.NewScope(f)
	var s2 int = irbuild.NewScope(f)
	var a @ir.Instr = scopedSlot(f, e, s1)
	irbuild.EmitScopeEnd(e, s1)
	var b @ir.Instr = scopedSlot(f, e, s2)
	irbuild.EmitScopeEnd(e, s2)
	if loaded {
		_ = irbuild.EmitLoad(e, a, types.TypInt())
	} else {
		var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(types.TypInt()))
		irbuild.EmitStore(e, p, a)
	}
	irbuild.EmitReturn(e, elisionNoRets())
	return f, a, b
}

// A slot's address used past its scope (kept in a pointer, not read through) leaves
// it sharing; a load of it past the scope -- a read through a dangling pointer,
// undefined -- gives it bytes of its own, so the read sees what it would unshared.
func TestSharedAllocasReadAcrossEnd() testing.TestResult {
	f, a, b := readAcrossFunc(false)
	offs, _ := shareOf(f, two(a, b))
	if offs[0] != offs[1] { return "an address used past the scope does not stop sharing" }
	f, a, b = readAcrossFunc(true)
	offs, _ = shareOf(f, two(a, b))
	if offs[0] == offs[1] { return "a slot loaded past its scope keeps bytes of its own" }
	return ""
}

// A load on the iteration after the slot's scope ended (its write is before the loop)
// gives the slot bytes of its own too.
func TestSharedAllocasReadAcrossEndInLoop() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var head @ir.Block = ir.AddBlock(f, "head")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var s1 int = irbuild.NewScope(f)
	var s2 int = irbuild.NewScope(f)
	var cond @ir.Instr = irbuild.EmitConstBool(entry, true)
	var a @ir.Instr = scopedSlot(f, entry, s1)
	irbuild.EmitJump(entry, head)
	irbuild.EmitBranch(head, cond, body, exit)
	_ = irbuild.EmitLoad(body, a, types.TypInt())
	irbuild.EmitScopeEnd(body, s1)
	var b @ir.Instr = scopedSlot(f, body, s2)
	irbuild.EmitScopeEnd(body, s2)
	irbuild.EmitJump(body, head)
	irbuild.EmitReturn(exit, elisionNoRets())
	offs, _ := shareOf(f, two(a, b))
	if offs[0] == offs[1] { return "a slot loaded on the next iteration keeps bytes of its own" }
	return ""
}

// A scope ended on one path of a diamond only stays live along the other into the
// merge, where a later scope's slot then may not share its bytes.
func TestSharedAllocasEndOnOnePath() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var then @ir.Block = ir.AddBlock(f, "then")
	var other @ir.Block = ir.AddBlock(f, "other")
	var merge @ir.Block = ir.AddBlock(f, "merge")
	var s1 int = irbuild.NewScope(f)
	var s2 int = irbuild.NewScope(f)
	var cond @ir.Instr = irbuild.EmitConstBool(entry, true)
	var a @ir.Instr = scopedSlot(f, entry, s1)
	irbuild.EmitBranch(entry, cond, then, other)
	irbuild.EmitScopeEnd(then, s1)
	irbuild.EmitJump(then, merge)
	irbuild.EmitJump(other, merge)
	var b @ir.Instr = scopedSlot(f, merge, s2)
	irbuild.EmitScopeEnd(merge, s2)
	irbuild.EmitReturn(merge, elisionNoRets())
	offs, _ := shareOf(f, two(a, b))
	if offs[0] == offs[1] { return "a, still live on one path into the merge, may not share with b" }
	return ""
}

// PlanFrame gives a call writing its result into a shared slot that slot's region:
// the slots are laid down before the calls are placed.
func TestPlanFramePlacedCallIntoSharedSlot() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s1 int = irbuild.NewScope(f)
	var s2 int = irbuild.NewScope(f)
	var x @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	x.Scope = s1
	irbuild.EmitScopeEnd(e, s1)
	var y @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	y.Scope = s2
	var noArgs @[]@ir.Instr
	var r @ir.Instr = irbuild.EmitCall(e, "g", noArgs, elisionQuadTyp())
	irbuild.EmitStore(e, y, r)
	irbuild.EmitScopeEnd(e, s2)
	irbuild.EmitReturn(e, elisionNoRets())
	var m @RegMap = nrm()
	m.PlanFrame(f)
	if m.CallResultSlot(r.ID) != y.ID { return "setup: the call writes its result into y" }
	if m.LookupAlloc(x.ID) != m.LookupAlloc(y.ID) { return "x and y share" }
	if m.LookupAlloc(r.ID) != m.LookupAlloc(y.ID) { return "the call's result region is y's" }
	return ""
}

// PlanFrame gives the slots of sibling scopes one region, and a slot with no scope
// one of its own.
func TestPlanFrameSharesScopedAllocas() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s1 int = irbuild.NewScope(f)
	var s2 int = irbuild.NewScope(f)
	var a @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	a.Scope = s1
	irbuild.EmitScopeEnd(e, s1)
	var b @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	b.Scope = s2
	irbuild.EmitScopeEnd(e, s2)
	var c @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	irbuild.EmitReturn(e, elisionNoRets())
	var m @RegMap = nrm()
	var shared int64 = m.PlanFrame(f)
	if m.LookupAlloc(a.ID) < 0 || m.LookupAlloc(a.ID) != m.LookupAlloc(b.ID) {
		return "a and b share one region"
	}
	if m.LookupAlloc(c.ID) == m.LookupAlloc(a.ID) { return "c has a region of its own" }
	a.Scope = 0
	b.Scope = 0
	var m2 @RegMap = nrm()
	if m2.PlanFrame(f) <= shared { return "sharing a and b makes the frame smaller" }
	return ""
}

// A slot is placed at its own alignment: with a 4-byte slot at 0 nested with an
// 8-aligned one (both live at once), the latter goes at 8, not right after it at 4.
func TestSharedAllocasKeepAlignment() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s1 int = irbuild.NewScope(f)
	var s2 int = irbuild.NewScope(f)
	var a @ir.Instr = scopedSlot(f, e, s1)
	var b @ir.Instr = scopedSlot(f, e, s2)
	irbuild.EmitScopeEnd(e, s2)
	irbuild.EmitScopeEnd(e, s1)
	irbuild.EmitReturn(e, elisionNoRets())
	var ids @[]int = make_slice(int, 2)
	ids[0] = a.ID
	ids[1] = b.ID
	var sizes @[]int64 = make_slice(int64, 2)
	sizes[0] = 4
	sizes[1] = 8
	var aligns @[]int64 = make_slice(int64, 2)
	aligns[0] = 4
	aligns[1] = 8
	offs, total := planSharedAllocas(f, newLiveCFG(f), ids, sizes, aligns, noPlaced(f))
	if offs[0] != 0 || offs[1] != 8 || total != 16 {
		return "the 8-aligned slot goes at 8, past the 4-byte one"
	}
	return ""
}

// placeSharedAllocas starts its area at its slots' largest alignment and ends it
// 8-aligned, for the regions after it: an 8-aligned slot laid down from 4 goes at 8, and
// a lone 4-byte slot from 0 ends the area at 8.
func TestPlaceSharedAllocasAlignsItsArea() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s1 int = irbuild.NewScope(f)
	var a @ir.Instr = scopedSlot(f, e, s1)
	irbuild.EmitScopeEnd(e, s1)
	irbuild.EmitReturn(e, elisionNoRets())
	var at @[]int64 = placeOne(f, a, 8, 8, 4)
	if at[0] != 8 || at[1] != 16 { return "an 8-aligned slot laid down from 4 goes at 8" }
	at = placeOne(f, a, 4, 4, 0)
	if at[0] != 0 || at[1] != 8 { return "a lone 4-byte slot from 0 ends the area at 8" }
	return ""
}

// placeOne lays slot a of f (sz bytes, aligned to align) down from offset with
// placeSharedAllocas and returns its offset and the offset past the area.
func placeOne(f @ir.Func, a @ir.Instr, sz int64, align int64, offset int64) @[]int64 {
	var ids @vec.Vec[int] = vec.New[int]()
	ids.Push(a.ID)
	var sizes @vec.Vec[int64] = vec.New[int64]()
	sizes.Push(sz)
	var aligns @vec.Vec[int64] = vec.New[int64]()
	aligns.Push(align)
	var allocIDs @vec.Vec[int] = vec.New[int]()
	var allocSizes @vec.Vec[int64] = vec.New[int64]()
	var allocOffsets @vec.Vec[int64] = vec.New[int64]()
	var past int64 = placeSharedAllocas(f, newLiveCFG(f), ids, sizes, aligns, noPlaced(f), allocIDs,
			allocSizes, allocOffsets, offset)
	var at @[]int64 = make_slice(int64, 2)
	at[0] = allocOffsets.Get(0)
	at[1] = past
	return at
}
