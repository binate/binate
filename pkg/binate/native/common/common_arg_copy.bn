package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/std/containers/vec"

// A by-value aggregate argument passed as a pointer to a copy of it
// (callconv.CallConv.PassesIndirect — AAPCS64's aggregates over 16 bytes) must point
// at memory the call owns: AAPCS64 lets the callee use that memory as its parameter
// and write to it.  An argument is passed as its own data region only when that
// region is a private copy nothing reads after the call (argOwnsRegion); for every
// other one PlanFrame reserves an argument region (LookupArgCopy), into which the
// call copies the value before passing the region's address.  A call fills its
// argument regions only as its lowering begins — after every call nested in its
// arguments has returned — and they are dead once it returns, so each is in use only
// at its call's position: it shares bytes with the other calls' argument regions and
// with the data regions not in use there (placeSharedRegions).

// argCopyPlan is the argument regions of a function's calls (collectArgCopies):
// region i is for operand args[i] of the call with value ID calls[i], sizes[i] bytes
// (8-byte rounded), in use at pos[i], the call's position in the function's liveness
// (-1 for a call the entry does not reach), and placed at offs[i]
// (placeSharedRegions).
type argCopyPlan struct {
	calls @vec.Vec[int]
	args  @vec.Vec[int]
	sizes @vec.Vec[int64]
	pos   @vec.Vec[int]
	offs  @[]int64
}

// argOwnsRegion reports whether argument v of call may be passed as the address of
// v's own data region: v has bytes of its own (owns, regionPlan — never a parameter,
// whose region is the function's own), the call is v's only use, and the call is in
// v's block — so each fill of the region reaches the call at most once (a call in a
// loop whose body does not recompute v would otherwise pass, from its second
// iteration on, a region an earlier callee may have written).  A load reading its slot
// in place for this one use (IsLastUseArgLoad) passes the slot.  uses counts each
// value's operand references; blockOf gives each value's block index (-1 outside the
// function's blocks).
func (m @RegMap) argOwnsRegion(call @ir.Instr, v @ir.Instr, uses @[]int, blockOf @[]int,
		owns @[]bool) bool {
	if v.ID < 0 || v.ID >= len(uses) || call.ID < 0 || call.ID >= len(blockOf) { return false }
	// A load reading its slot in place, the slot dead after the call
	// (inplace.LastUseArgLoads), passes the slot itself.
	if m.IsLastUseArgLoad(v.ID) { return true }
	if v.Op == iropcode.OP_PARAM || v.ID >= len(owns) || !owns[v.ID] || uses[v.ID] != 1 {
		return false
	}
	return blockOf[v.ID] >= 0 && blockOf[v.ID] == blockOf[call.ID]
}

// countValueUses returns, indexed by value ID (below limit), how many operands
// across blocks reference each value — instruction arguments and phi incomings.
func countValueUses(uses @[]int, blocks @[]@ir.Block, limit int) {
	for bi := 0; bi < len(blocks); bi++ {
		var b @ir.Block = blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			for k := 0; k < len(ins.Args); k++ {
				var v @ir.Instr = ins.Args[k]
				if v != nil && v.ID >= 0 && v.ID < limit { uses[v.ID] = uses[v.ID] + 1 }
			}
			for k := 0; k < len(ins.Phis); k++ {
				var pv *ir.Instr = ins.Phis[k].Val
				if pv != nil && pv.ID >= 0 && pv.ID < limit { uses[pv.ID] = uses[pv.ID] + 1 }
			}
		}
	}
}

// collectArgCopies returns the argument regions f's calls need: one for every
// PassesIndirect argument that does not own its region (argOwnsRegion, given the
// values with bytes of their own, owns), in use at its call's position over cfg.  It
// runs once m.LastUseLoads is recorded.  A call with no value ID (never one built by
// ir.NewInstr) gets none; the backend reports one that needs them.
func (m @RegMap) collectArgCopies(f @ir.Func, cfg @LiveCFG, owns @[]bool) @argCopyPlan {
	var plan @argCopyPlan = make(argCopyPlan)
	plan.calls = vec.New[int]()
	plan.args = vec.New[int]()
	plan.sizes = vec.New[int64]()
	plan.pos = vec.New[int]()
	var uses @[]int
	var blockOf @[]int
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		var from int = -1
		if bi < len(cfg.blockFrom) { from = cfg.blockFrom[bi] }
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			var base int = callconv.CallArgBase(ins.Op)
			if base < 0 || ins.ID < 0 { continue }
			for k := base; k < len(ins.Args); k++ {
				var v @ir.Instr = ins.Args[k]
				if v == nil || v.Typ == nil || !m.CC.PassesIndirect(v.Typ) { continue }
				if len(uses) == 0 {
					uses = make_slice(int, f.NextID)
					// f's fault pads are left out: only the VM runs them.
					countValueUses(uses, f.Blocks, f.NextID)
					blockOf = valueBlocks(f)
				}
				if m.argOwnsRegion(ins, v, uses, blockOf, owns) { continue }
				plan.calls.Push(ins.ID)
				plan.args.Push(k)
				plan.sizes.Push(roundUp8(v.Typ.Size()))
				var p int = -1
				if from >= 0 { p = from + ii }
				plan.pos.Push(p)
			}
		}
	}
	plan.offs = make_slice(int64, plan.calls.Len())
	return plan
}

// noteArgCopies records plan's placed argument regions for LookupArgCopy.
func (m @RegMap) noteArgCopies(plan @argCopyPlan) {
	m.ArgCopyCalls = plan.calls.Items()
	m.ArgCopyArgs = plan.args.Items()
	m.ArgCopyOffsets = plan.offs
}

// valueBlocks returns, indexed by value ID, the index of the block of f that
// defines each value (-1 for one defined nowhere in f.Blocks, e.g. a parameter).
func valueBlocks(f @ir.Func) @[]int {
	var out @[]int = make_slice(int, f.NextID)
	for i := 0; i < len(out); i++ { out[i] = -1 }
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var id int = b.Instrs[ii].ID
			if id >= 0 && id < len(out) { out[id] = bi }
		}
	}
	return out
}

// LookupArgCopy returns the SP-relative offset of the argument region PlanFrame
// reserved for operand k of the call whose value ID is callID — the region the call
// copies that argument into and passes instead of the argument's own memory — or -1
// when the argument is passed as its own region (or is not a PassesIndirect one).
func (m @RegMap) LookupArgCopy(callID int, k int) int64 {
	for i := 0; i < len(m.ArgCopyCalls); i++ {
		if m.ArgCopyCalls[i] == callID && m.ArgCopyArgs[i] == k { return m.ArgCopyOffsets[i] }
	}
	return -1
}
