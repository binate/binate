package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the argument regions of by-value aggregates passed as a pointer to a
// copy (common_arg_copy.bn): a call passes an argument's own region only when it
// owns it — a private copy, read by nothing else, made in the call's block.

// argCopyFunc returns an empty function with an entry block.
func argCopyFunc() (@ir.Func, @ir.Block) {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	return f, ir.AddBlock(f, "entry")
}

// oneArg returns a one-element argument list.
func oneArg(v @ir.Instr) @[]@ir.Instr {
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = v
	return args
}

// A call result passed straight to a call in its block, and used nowhere else, is
// the call's own copy: no argument region.
func TestArgCopyOwnedCallResult() testing.TestResult {
	setTarget64()
	f, e := argCopyFunc()
	var x @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), elisionQuadTyp())
	var c @ir.Instr = irbuild.EmitCall(e, "g", oneArg(x), types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	if rm.LookupArgCopy(c.ID, 0) >= 0 {
		return "a single-use call result must be passed as its own region"
	}
	return ""
}

// A value two calls read is copied for each: either callee may write its copy.  The
// two calls' regions share the argument area — each is dead once its call returns.
func TestArgCopyTwoUses() testing.TestResult {
	setTarget64()
	f, e := argCopyFunc()
	var x @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), elisionQuadTyp())
	var c1 @ir.Instr = irbuild.EmitCall(e, "g", oneArg(x), types.TypVoid())
	var c2 @ir.Instr = irbuild.EmitCall(e, "g", oneArg(x), types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	var o1 int = rm.LookupArgCopy(c1.ID, 0)
	var o2 int = rm.LookupArgCopy(c2.ID, 0)
	if o1 < 0 || o2 < 0 { return "a value two calls read needs a region per call" }
	if o1 != o2 { return "two calls' argument regions share the argument area" }
	if rm.FrameSize() < o2 + 32 { return "the argument regions must lie inside the frame" }
	return ""
}

// The same value passed twice to one call is copied once per operand, into
// distinct regions: the callee may write one and read the other.
func TestArgCopySameValueTwiceInOneCall() testing.TestResult {
	setTarget64()
	f, e := argCopyFunc()
	var x @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), elisionQuadTyp())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 2)
	args[0] = x
	args[1] = x
	var c @ir.Instr = irbuild.EmitCall(e, "g", args, types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	var o0 int = rm.LookupArgCopy(c.ID, 0)
	var o1 int = rm.LookupArgCopy(c.ID, 1)
	if o0 < 0 || o1 < 0 || o0 == o1 {
		return "one value passed twice to a call needs two distinct regions"
	}
	if o1 < o0 + 32 && o0 < o1 + 32 { return "the two regions must not overlap" }
	return ""
}

// A parameter passed on is the function's own incoming memory, which it may read
// again: the call copies it.
func TestArgCopyParam() testing.TestResult {
	setTarget64()
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].Typ = elisionQuadTyp()
	var f @ir.Func = ir.NewFunc("", "t", params, elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitCall(e, "g", oneArg(irbuild.NewParamRef(f, params[0])),
			types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	if rm.LookupArgCopy(c.ID, 0) < 0 { return "a parameter passed on must be copied" }
	return ""
}

// A load that aliases its source (an elided load of a confined stack slot) is the
// source's memory, so the call copies it.
func TestArgCopyElidedLoad() testing.TestResult {
	setTarget64()
	f, e := argCopyFunc()
	var s @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	var v @ir.Instr = irbuild.EmitLoad(e, s, elisionQuadTyp())
	var c @ir.Instr = irbuild.EmitCall(e, "g", oneArg(v), types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	if !AggLoadElidable(f, v) { return "precondition: the load of a confined slot is elided" }
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	if rm.LookupArgCopy(c.ID, 0) < 0 {
		return "an elided load is its source's memory and must be copied"
	}
	return ""
}

// A value made in another block is copied: a call in a loop would otherwise pass,
// from its second iteration on, a region an earlier callee wrote.
func TestArgCopyOtherBlock() testing.TestResult {
	setTarget64()
	f, e := argCopyFunc()
	var b2 @ir.Block = ir.AddBlock(f, "next")
	var x @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), elisionQuadTyp())
	irbuild.EmitJump(e, b2)
	var c @ir.Instr = irbuild.EmitCall(b2, "g", oneArg(x), types.TypVoid())
	irbuild.EmitReturn(b2, elisionNoRets())
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	if rm.LookupArgCopy(c.ID, 0) < 0 { return "a value from another block must be copied" }
	return ""
}

// Where an aggregate is not passed as a pointer to a copy (SysV x86-64 lays it on
// the stack), no argument region is reserved.
func TestArgCopyNoneOffAAPCS64() testing.TestResult {
	setTarget64()
	f, e := argCopyFunc()
	var x @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), elisionQuadTyp())
	irbuild.EmitCall(e, "g", oneArg(x), types.TypVoid())
	irbuild.EmitCall(e, "g", oneArg(x), types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	var rm @RegMap = NewRegMap(callconv.SysV_AMD64())
	rm.PlanFrame(f)
	if len(rm.ArgCopyCalls) != 0 { return "SysV x86-64 needs no argument regions" }
	return ""
}
