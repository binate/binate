package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the argument regions of by-value aggregates passed as a pointer to a
// copy (common_arg_copy.bn): a call passes an argument's own region only when it
// owns it — a private copy, read by nothing else, made in the call's block.

// argCopyFunc returns an empty function with an entry block.
func argCopyFunc() (@ir.Func, @ir.Block) {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	return f, ir.AddBlock(f, "entry")
}

// oneArg returns a one-element argument list.
func oneArg(v @ir.Instr) @[]@ir.Instr {
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = v
	return args
}

// A call result passed straight to a call in its block, and used nowhere else, is
// the call's own copy: no argument region.
func TestArgCopyOwnedCallResult() testing.TestResult {
	setTarget64()
	f, e := argCopyFunc()
	var x @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), elisionQuadTyp())
	var c @ir.Instr = irbuild.EmitCall(e, "g", oneArg(x), types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	if rm.LookupArgCopy(c.ID, 0) >= 0 {
		return "a single-use call result must be passed as its own region"
	}
	return ""
}

// A value two calls read is copied for each: either callee may write its copy.  The
// two calls' regions share bytes — each is in use only at its call.
func TestArgCopyTwoUses() testing.TestResult {
	setTarget64()
	f, e := argCopyFunc()
	var x @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), elisionQuadTyp())
	var c1 @ir.Instr = irbuild.EmitCall(e, "g", oneArg(x), types.TypVoid())
	var c2 @ir.Instr = irbuild.EmitCall(e, "g", oneArg(x), types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	var o1 int64 = rm.LookupArgCopy(c1.ID, 0)
	var o2 int64 = rm.LookupArgCopy(c2.ID, 0)
	if o1 < 0 || o2 < 0 { return "a value two calls read needs a region per call" }
	if o1 != o2 { return "two calls' argument regions share bytes" }
	if !apart(o1, 32, rm.LookupAlloc(x.ID), 32) {
		return "an argument region shares no bytes with the value it copies"
	}
	if rm.FrameSize < cast(int64, o2 + 32) { return "the argument regions must lie inside the frame" }
	return ""
}

// The same value passed twice to one call is copied once per operand, into
// distinct regions: the callee may write one and read the other.
func TestArgCopySameValueTwiceInOneCall() testing.TestResult {
	setTarget64()
	f, e := argCopyFunc()
	var x @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), elisionQuadTyp())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 2)
	args[0] = x
	args[1] = x
	var c @ir.Instr = irbuild.EmitCall(e, "g", args, types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	var o0 int64 = rm.LookupArgCopy(c.ID, 0)
	var o1 int64 = rm.LookupArgCopy(c.ID, 1)
	if o0 < 0 || o1 < 0 || o0 == o1 {
		return "one value passed twice to a call needs two distinct regions"
	}
	if o1 < o0 + 32 && o0 < o1 + 32 { return "the two regions must not overlap" }
	return ""
}

// A parameter passed on is the function's own incoming memory, which it may read
// again: the call copies it.
func TestArgCopyParam() testing.TestResult {
	setTarget64()
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].Typ = elisionQuadTyp()
	var f @ir.Func = ir.NewFunc("", "t", params, elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitCall(e, "g", oneArg(irbuild.NewParamRef(f, params[0])),
			types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	if rm.LookupArgCopy(c.ID, 0) < 0 { return "a parameter passed on must be copied" }
	return ""
}

// A load that aliases its source (an elided load of a confined stack slot) is the
// source's memory; with the source read again after the call, the call copies it.
func TestArgCopyElidedLoad() testing.TestResult {
	setTarget64()
	f, e := argCopyFunc()
	var s @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	var v @ir.Instr = irbuild.EmitLoad(e, s, elisionQuadTyp())
	var c @ir.Instr = irbuild.EmitCall(e, "g", oneArg(v), types.TypVoid())
	irbuild.EmitExtract(e, irbuild.EmitLoad(e, s, elisionQuadTyp()), 0, types.TypInt())
	irbuild.EmitReturn(e, elisionNoRets())
	if !aggLoadElidable(f, v) { return "precondition: the load of a confined slot is elided" }
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	if rm.LookupArgCopy(c.ID, 0) < 0 {
		return "an elided load is its source's memory and must be copied"
	}
	return ""
}

// A value made in another block is copied: a call in a loop would otherwise pass,
// from its second iteration on, a region an earlier callee wrote.
func TestArgCopyOtherBlock() testing.TestResult {
	setTarget64()
	f, e := argCopyFunc()
	var b2 @ir.Block = ir.AddBlock(f, "next")
	var x @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), elisionQuadTyp())
	irbuild.EmitJump(e, b2)
	var c @ir.Instr = irbuild.EmitCall(b2, "g", oneArg(x), types.TypVoid())
	irbuild.EmitReturn(b2, elisionNoRets())
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	if rm.LookupArgCopy(c.ID, 0) < 0 { return "a value from another block must be copied" }
	return ""
}

// Where an aggregate is not passed as a pointer to a copy (SysV x86-64 lays it on
// the stack), no argument region is reserved.
func TestArgCopyNoneOffAAPCS64() testing.TestResult {
	setTarget64()
	f, e := argCopyFunc()
	var x @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), elisionQuadTyp())
	irbuild.EmitCall(e, "g", oneArg(x), types.TypVoid())
	irbuild.EmitCall(e, "g", oneArg(x), types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	var rm @RegMap = NewRegMap(callconv.SysV_AMD64())
	rm.PlanFrame(f)
	if len(rm.ArgCopyCalls) != 0 { return "SysV x86-64 needs no argument regions" }
	return ""
}

// A fault pad's use of a call result does not count as a second use (only the VM
// runs fault pads): the call still passes the result as its own region.
func TestArgCopyIgnoresFaultPads() testing.TestResult {
	setTarget64()
	f, e := argCopyFunc()
	var x @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), elisionQuadTyp())
	var c @ir.Instr = irbuild.EmitCall(e, "g", oneArg(x), types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	irbuild.EmitCall(pad, "release", oneArg(x), types.TypVoid())
	irbuild.EmitReturn(pad, elisionNoRets())
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	if rm.LookupArgCopy(c.ID, 0) >= 0 {
		return "a fault pad's use does not make the call copy the value"
	}
	return ""
}

// A load through a pointer passed straight to a call reads its source in place: it has
// no region of its own, so the call copies the source into an argument region, which
// the callee may write -- never the source.  Under SysV the call copies the source
// onto the stack and reserves no region.
func TestArgCopyInPlaceLoad() testing.TestResult {
	setTarget64()
	var ccs @[]callconv.CallConv = @[]callconv.CallConv{callconv.AAPCS64(), callconv.SysV_AMD64()}
	for i := 0; i < len(ccs); i++ {
		f, e := argCopyFunc()
		var q @types.Type = elisionQuadTyp()
		var slot @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(q))
		var v @ir.Instr = irbuild.EmitLoad(e, irbuild.EmitLoad(e, slot, types.MakePointerType(q)), q)
		var c @ir.Instr = irbuild.EmitCall(e, "g", oneArg(v), types.TypVoid())
		irbuild.EmitReturn(e, elisionNoRets())
		var rm @RegMap = NewRegMap(ccs[i])
		rm.PlanFrame(f)
		if rm.LookupAlloc(v.ID) >= 0 {
			return "a load passed to a call reads its source in place: no region"
		}
		if (i == 0) != (rm.LookupArgCopy(c.ID, 0) >= 0) {
			return "only AAPCS64 copies the in-place load into an argument region of the call's own"
		}
	}
	return ""
}

// An argument region shares bytes with a data region not in use at its call: a and b,
// live together and dead before x is made, take 64 bytes; x then takes a's, and the
// copy of x for the first call (x is read by two) takes b's, rather than bytes of its own.
func TestArgCopySharesDeadDataRegion() testing.TestResult {
	setTarget64()
	f, e := argCopyFunc()
	var a @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), elisionQuadTyp())
	var b @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), elisionQuadTyp())
	readField(e, a)
	readField(e, b)
	var x @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), elisionQuadTyp())
	var c1 @ir.Instr = irbuild.EmitCall(e, "g", oneArg(x), types.TypVoid())
	irbuild.EmitCall(e, "g", oneArg(x), types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	if rm.LookupAlloc(a.ID) == rm.LookupAlloc(b.ID) { return "setup: a and b are live together" }
	if rm.LookupAlloc(x.ID) != rm.LookupAlloc(a.ID) { return "setup: x takes a's bytes" }
	if rm.LookupArgCopy(c1.ID, 0) != rm.LookupAlloc(b.ID) {
		return "the argument region takes the bytes of b, dead at the call"
	}
	return ""
}

// apart reports whether the size1 bytes at off1 and the size2 bytes at off2 share none.
func apart(off1 int64, size1 int64, off2 int64, size2 int64) bool {
	return off1 + size1 <= off2 || off2 + size2 <= off1
}

// An argument region is in use at its call, as are the values the call reads and its
// result: it shares bytes with none of them -- not the value it copies (x, read again
// by a later call), nor one the call passes as its own region (z, last read there).
func TestArgCopyApartFromSourceAndResult() testing.TestResult {
	setTarget64()
	f, e := argCopyFunc()
	var x @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), elisionQuadTyp())
	var z @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), elisionQuadTyp())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 2)
	args[0] = z
	args[1] = x
	var c1 @ir.Instr = irbuild.EmitCall(e, "g", args, elisionQuadTyp())
	var c2 @ir.Instr = irbuild.EmitCall(e, "g", oneArg(x), types.TypVoid())
	readField(e, c1)
	irbuild.EmitReturn(e, elisionNoRets())
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	if rm.LookupArgCopy(c1.ID, 0) >= 0 { return "setup: z, read only by c1, is passed as its region" }
	var o1 int64 = rm.LookupArgCopy(c1.ID, 1)
	var o2 int64 = rm.LookupArgCopy(c2.ID, 0)
	var ox int64 = rm.LookupAlloc(x.ID)
	var oz int64 = rm.LookupAlloc(z.ID)
	var ores int64 = rm.LookupAlloc(c1.ID)
	if o1 < 0 || o2 < 0 || ox < 0 || oz < 0 || ores < 0 { return "setup: every region has bytes" }
	if !apart(o1, 32, ox, 32) || !apart(o1, 32, oz, 32) || !apart(o1, 32, ores, 32) {
		return "c1's argument region shares bytes with a value c1 reads or with its result"
	}
	if !apart(o2, 32, ox, 32) || !apart(o2, 32, ores, 32) {
		return "c2's argument region shares bytes with the value it copies or a live result"
	}
	return ""
}

// A member extracted from a call result has no region of its own: passed to a call it
// is copied, and the copy shares no bytes with the result it lies in, which is in use
// through the member's uses.
func TestArgCopyMemberOfCallResult() testing.TestResult {
	setTarget64()
	f, e := argCopyFunc()
	var mem @ir.Instr = mkMember(e)
	var c @ir.Instr = irbuild.EmitCall(e, "g", oneArg(mem), types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	var o int64 = rm.LookupArgCopy(c.ID, 0)
	var op int64 = rm.LookupAlloc(mem.Args[0].ID)
	if o < 0 || op < 0 { return "setup: the member is copied, and the result has a region" }
	if !apart(o, 32, op, 64) { return "the copy shares bytes with the result its source lies in" }
	return ""
}

// The argument regions of calls the entry does not reach have no position to share by:
// they lie in one area, shared by those calls, apart from everything else.
func TestArgCopyUnreachableCallsShareAnArea() testing.TestResult {
	setTarget64()
	f, e := argCopyFunc()
	var x @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), elisionQuadTyp())
	var c1 @ir.Instr = irbuild.EmitCall(e, "g", oneArg(x), types.TypVoid())
	irbuild.EmitCall(e, "g", oneArg(x), types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	var d @ir.Block = ir.AddBlock(f, "dead")
	var y @ir.Instr = irbuild.EmitCall(d, "mk", elisionNoRets(), elisionQuadTyp())
	var c2 @ir.Instr = irbuild.EmitCall(d, "g", oneArg(y), types.TypVoid())
	var c3 @ir.Instr = irbuild.EmitCall(d, "g", oneArg(y), types.TypVoid())
	irbuild.EmitReturn(d, elisionNoRets())
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	var o2 int64 = rm.LookupArgCopy(c2.ID, 0)
	var others @[]int64 = make_slice(int64, 3)
	others[0] = rm.LookupArgCopy(c1.ID, 0)
	others[1] = rm.LookupAlloc(x.ID)
	others[2] = rm.LookupAlloc(y.ID)
	if o2 < 0 || others[0] < 0 || others[1] < 0 || others[2] < 0 {
		return "setup: the copies and the values all have bytes"
	}
	if rm.LookupArgCopy(c3.ID, 0) != o2 { return "the unreachable calls share their area" }
	for k := 0; k < 3; k++ {
		if !apart(o2, 32, others[k], 32) { return "the unreachable calls' area shares no bytes" }
	}
	if rm.FrameSize < o2 + 32 { return "the area lies inside the frame" }
	return ""
}
