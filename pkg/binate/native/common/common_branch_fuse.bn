package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"

// BranchFusedCmps returns a dense ID-indexed flag set (sized to f.NextID):
// element [id] is true iff the integer-comparison value with that SSA id can be
// fused into the conditional branch that consumes it — so the comparison lowers
// to a flag-setting `cmp`/`cmn`/`tst` immediately followed by a condition-coded
// `b.cond` (aa64) / `jcc` (x64) / `b<cond>` (arm32), with NO materialized 0/1
// boolean (`cset` / `setcc`) in between.
//
// A backend consulting this set skips the boolean-producing tail of the
// comparison's lowering (it emits only the flag-setting compare) and, at the
// branch, tests the flags directly instead of re-testing a boolean register.
// AllocateRegisters (with the set assigned to m.FusedCmp before it runs) leaves
// the fused comparison's result unhomed, since nothing reads it as a register.
//
// The conditions are exactly what makes the fusion correct:
//   - the value is an INTEGER comparison (OP_EQ/NE/LT/LE/GT/GE with non-float
//     operands).  Float comparisons set flags via FCMP under different condition
//     codes and are left to the boolean path for now.
//   - the operand is no WIDER than the target word (`wordBytes`): a compare of
//     operands wider than a register is a multi-word sequence (e.g. arm32's
//     int64 pair CMP via emitCompare64) that does NOT leave a single set of
//     condition flags a branch can read, so it must keep the boolean path.  On a
//     64-bit target (wordBytes=8) int64 is one register wide and fuses.
//   - it is used EXACTLY ONCE, and that use is the branch condition — a second
//     use would still need the 0/1 boolean in a register, so the tail cannot be
//     dropped.
//   - the consuming OP_BRANCH is the VERY NEXT instruction in the same block
//     (adjacency).  This guarantees nothing between the `cmp` and the `b.cond`
//     clobbers the condition flags: the only code the backend emits in the gap
//     is the branch's own block-boundary spill barrier, which is stores (and the
//     unconditional else-branch), none of which write NZCV.  A non-adjacent
//     single use is left unfused (still correct, just not optimized).
func BranchFusedCmps(f @ir.Func, wordBytes int) @[]bool {
	var n int = f.NextID
	var useCount @[]int = make_slice(int, n)
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			for ai := 0; ai < len(ins.Args); ai++ {
				bumpUse(useCount, ins.Args[ai])
			}
			for pi := 0; pi < len(ins.Phis); pi++ {
				bumpUse(useCount, ins.Phis[pi].Val)
			}
		}
	}

	var fusable @[]bool = make_slice(bool, n)
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if !isIntCompareOp(ins.Op) || ins.ID < 0 || ins.ID >= n {
				continue
			}
			if len(ins.Args) != 2 || ins.Args[0] == nil {
				continue
			}
			// Float comparisons use FCMP + FP condition codes — not this path.
			if ins.Args[0].Typ != nil && ins.Args[0].Typ.IsFloat() {
				continue
			}
			// An operand wider than the target word compares via a multi-word
			// sequence (arm32's int64 pair CMP) that leaves no single flag state a
			// branch can read — keep it on the boolean path.  On a 64-bit target
			// int64 is one word wide, so this excludes nothing there.
			if ins.Args[0].Typ != nil && ins.Args[0].Typ.SizeOf() > wordBytes {
				continue
			}
			if useCount[ins.ID] != 1 {
				continue
			}
			if j + 1 >= len(blk.Instrs) {
				continue
			}
			var next @ir.Instr = blk.Instrs[j + 1]
			if next.Op != iropcode.OP_BRANCH || len(next.Args) < 1 || next.Args[0] == nil {
				continue
			}
			if next.Args[0].ID != ins.ID {
				continue
			}
			fusable[ins.ID] = true
		}
	}
	return fusable
}

// isIntCompareOp reports whether op is one of the six integer relational ops
// that lower to a flag-setting compare.
func isIntCompareOp(op int) bool {
	return op == iropcode.OP_EQ || op == iropcode.OP_NE || op == iropcode.OP_LT ||
			op == iropcode.OP_LE || op == iropcode.OP_GT || op == iropcode.OP_GE
}

// bumpUse records one operand reference against its in-range SSA id.
func bumpUse(useCount @[]int, arg @ir.Instr) {
	if arg == nil || arg.ID < 0 || arg.ID >= len(useCount) {
		return
	}
	useCount[arg.ID] = useCount[arg.ID] + 1
}
