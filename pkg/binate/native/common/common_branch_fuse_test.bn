package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for BranchFusedCmps (common_branch_fuse.bn): which integer comparisons
// fuse into the conditional branch that consumes them.

// bfCmpBranch builds an entry block ending in `cmp lhs OP rhs; branch cmp`, plus
// then/else targets, and returns the comparison instr and the function.
func bfCmpBranch(op int, lhsT @types.Type, rhsT @types.Type) (@ir.Instr, @ir.Func) {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var elseB @ir.Block = ir.AddBlock(f, "else")
	var lhs @ir.Instr = irbuild.EmitConstInt(entry, 5, lhsT)
	var rhs @ir.Instr = irbuild.EmitConstInt(entry, 10, rhsT)
	var cmp @ir.Instr = irbuild.EmitBinop(entry, op, lhs, rhs, types.TypBool())
	irbuild.EmitBranch(entry, cmp, thenB, elseB)
	return cmp, f
}

// A single-use integer comparison immediately followed by the branch it feeds
// fuses.
func TestBranchFuseSingleUseAdjacent() testing.TestResult {
	var cmp @ir.Instr
	var f @ir.Func
	cmp, f = bfCmpBranch(iropcode.OP_LT, types.TypInt(), types.TypInt())
	var fused @[]bool = BranchFusedCmps(f)
	if cmp.ID < 0 || cmp.ID >= len(fused) { return "cmp id out of range" }
	if !fused[cmp.ID] { return "a single-use int compare feeding the next-instr branch must fuse" }
	return ""
}

// A comparison used a SECOND time (here in the then-block) still needs its 0/1
// boolean, so it does not fuse even though the branch is adjacent.
func TestBranchFuseSecondUseNotFused() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var elseB @ir.Block = ir.AddBlock(f, "else")
	var lhs @ir.Instr = irbuild.EmitConstInt(entry, 5, types.TypInt())
	var rhs @ir.Instr = irbuild.EmitConstInt(entry, 10, types.TypInt())
	var cmp @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_LT, lhs, rhs, types.TypBool())
	irbuild.EmitBranch(entry, cmp, thenB, elseB)
	// Cross-block second use of cmp: keeps the branch adjacent in entry but drives
	// the use count to 2.
	var other @ir.Instr = irbuild.EmitConstBool(thenB, true)
	_ = irbuild.EmitBinop(thenB, iropcode.OP_LOR, cmp, other, types.TypBool())
	var fused @[]bool = BranchFusedCmps(f)
	if fused[cmp.ID] { return "a compare with a second use must not fuse" }
	return ""
}

// A comparison whose branch is NOT the immediately-following instruction does
// not fuse: an intervening instruction could clobber the condition flags.
func TestBranchFuseNonAdjacentNotFused() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var elseB @ir.Block = ir.AddBlock(f, "else")
	var lhs @ir.Instr = irbuild.EmitConstInt(entry, 5, types.TypInt())
	var rhs @ir.Instr = irbuild.EmitConstInt(entry, 10, types.TypInt())
	var cmp @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_LT, lhs, rhs, types.TypBool())
	// An unrelated instruction between the compare and the branch.
	_ = irbuild.EmitBinop(entry, iropcode.OP_ADD, lhs, rhs, types.TypInt())
	irbuild.EmitBranch(entry, cmp, thenB, elseB)
	var fused @[]bool = BranchFusedCmps(f)
	if fused[cmp.ID] { return "a compare not adjacent to its branch must not fuse" }
	return ""
}

// A float comparison uses FCMP + FP condition codes; it is left to the boolean
// path and does not fuse here.
func TestBranchFuseFloatNotFused() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var elseB @ir.Block = ir.AddBlock(f, "else")
	var lhs @ir.Instr = irbuild.EmitConstFloat(entry, "1.0", types.TypFloat64())
	var rhs @ir.Instr = irbuild.EmitConstFloat(entry, "2.0", types.TypFloat64())
	var cmp @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_LT, lhs, rhs, types.TypBool())
	irbuild.EmitBranch(entry, cmp, thenB, elseB)
	var fused @[]bool = BranchFusedCmps(f)
	if fused[cmp.ID] { return "a float compare must not fuse (FP condition codes)" }
	return ""
}
