package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"

// __c_entry (OP_C_ENTRY) yields the ADDRESS of a Binate function's C entry so it
// can be handed to C as a callback pointer.  The DEGENERATE native lowering
// references the function's mangled entry directly (no thunk); that is a correct
// C entry only when the callback's argument registers need no re-normalization.
// A NARROW GP integer/bool parameter (int8/int16, plus int32 on the 64-bit
// backends) arrives from a C caller with unspecified high bits (the same hazard
// #[c_export] fixes at its entry via normalizeNarrowRegParam), which the mangled
// entry does not fix up.  For such a target the backend instead emits — and
// references — a WEAK `__centry.<mangled>` adaptation thunk that normalizes the
// narrow argument registers and BRANCHES to the mangled entry; the weak-def
// coalescing gives one survivor program-wide (pkg.centry.identity).

// collectCEntryThunkTargets scans mod for OP_C_ENTRY instructions, marks each
// whose target has a narrow GP integer/bool parameter (relative to wordBytes) so
// the backend references its thunk (ins.CEntryThunk = true), and returns the
// deduplicated set of those targets (as @ir.Func — real or synthetic) for the
// backend to emit thunks for.  Returns (targets, false) — recording an emit
// error on `a` — only if an OP_C_ENTRY names a function the module has no
// signature for (the checker admits only declared functions, so that is an
// internal inconsistency, not a case to wave through as degenerate).
func collectCEntryThunkTargets(a @asm.Assembler, wordBytes int,
		mod @ir.Module) (@[]@ir.Func, bool) {
	var targets @[]@ir.Func
	for fi := 0; fi < len(mod.Funcs); fi++ {
		var f @ir.Func = mod.Funcs[fi]
		if f.IsExtern { continue }
		for bi := 0; bi < len(f.Blocks); bi++ {
			var blk @ir.Block = f.Blocks[bi]
			for ii := 0; ii < len(blk.Instrs); ii++ {
				var ins @ir.Instr = blk.Instrs[ii]
				if ins.Op != iropcode.OP_C_ENTRY { continue }
				var tf @ir.Func
				var found bool
				tf, found = ir.CEntryTargetFunc(mod, ins.StrVal)
				if !found {
					var msg @[]char
					msg = AppendStr(msg, "native __c_entry: no signature for callback target ")
					msg = AppendStr(msg, ins.StrVal)
					msg = AppendStr(msg, " (internal inconsistency)")
					a.SetError(msg)
					var none @[]@ir.Func
					return none, false
				}
				if funcHasNarrowGPParam(tf, wordBytes) {
					ins.CEntryThunk = true
					targets = appendCEntryTargetUnique(targets, tf)
				}
			}
		}
	}
	return targets, true
}

// appendCEntryTargetUnique appends tf to targets unless a target with the same
// canonical name is already present — the same function __c_entry'd at several
// sites needs only one weak thunk.
func appendCEntryTargetUnique(targets @[]@ir.Func, tf @ir.Func) @[]@ir.Func {
	for i := 0; i < len(targets); i++ {
		if cEntryNameEq(targets[i].Name, tf.Name) { return targets }
	}
	return appendFunc(targets, tf)
}

// appendFunc grows an @[]@ir.Func by one (the vec/slices helpers are not in this
// package's import set, and this list is short — one entry per distinct
// narrow-arg callback in a module).
func appendFunc(dst @[]@ir.Func, f @ir.Func) @[]@ir.Func {
	var out @[]@ir.Func = make_slice(@ir.Func, len(dst) + 1)
	for i := 0; i < len(dst); i++ { out[i] = dst[i] }
	out[len(dst)] = f
	return out
}

// cEntryNameEq compares two canonical function names for equality.
func cEntryNameEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// funcHasNarrowGPParam reports whether any of tf's parameters is a narrow GP
// integer/bool scalar under a target word size of wordBytes bytes.
func funcHasNarrowGPParam(tf @ir.Func, wordBytes int) bool {
	for pi := 0; pi < len(tf.Params); pi++ {
		if cEntryParamNeedsThunk(tf.Params[pi].Typ, wordBytes) { return true }
	}
	return false
}

// cEntryParamNeedsThunk reports whether a parameter of type t is a narrow GP
// integer/bool scalar under a target whose word size is wordBytes bytes — i.e. a
// parameter a C caller may leave with dirty high bits when it is passed in a
// register, and that the degenerate __c_entry reference can't normalize.  Floats
// (a separate register file) and aggregates (passed by reference / in multiple
// registers) are excluded, matching the float/aggregate skips in
// normalizeNarrowRegParam{,X64,Arm32}; pointers are word-size, so the
// `< wordBytes` bound already excludes them.  The bool trap: SubWordNarrow
// reports bool non-narrow (it is not IsInteger), but a bool param IS a 1-byte GP
// arg the c_export path still zero-extends, so keying off SizeOf (which is 1 for
// bool) — not SubWordNarrow — correctly flags it.
func cEntryParamNeedsThunk(t @types.Type, wordBytes int) bool {
	if t == nil { return false }
	if IsFloatScalarTyp(t) { return false }
	if IsAggregateTyp(t) { return false }
	var sz int = t.SizeOf()
	return sz > 0 && sz < wordBytes
}
