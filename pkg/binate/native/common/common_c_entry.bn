package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"

// __c_entry (OP_C_ENTRY) yields the ADDRESS of a Binate function's C entry so it
// can be handed to C as a callback pointer.  The DEGENERATE native lowering
// references the function's mangled entry directly (no thunk); that is a correct
// C entry only when the callback's argument REGISTERS need no re-normalization, its
// PARAMETERS need no by-value re-marshaling, AND its RETURN needs no C-ABI
// adaptation.  Three things force a WEAK `__centry.<mangled>` adaptation thunk
// instead:
//
//   - a NARROW GP integer/bool parameter (int8/int16, plus int32 on the 64-bit
//     backends) passed in a REGISTER arrives from a C caller with unspecified
//     high bits (the same hazard #[c_export] fixes via normalizeNarrowRegParam);
//     the mangled entry spills the whole register as-is and does not re-extend it.
//     A narrow STACK-passed arg needs no thunk help — the mangled entry's own
//     spill (spillScalarStackArg{,X64} / emitFrameLoadSized) sizes-and-extends
//     every sub-word stack arg UNCONDITIONALLY — so this trigger is
//     REGISTER-passed narrow args only (funcHasNarrowGPRegParam / CEntryRegNormWalk).
//   - a >16-byte by-value aggregate PARAMETER whose C passing form diverges from
//     the internal single-pointer form (funcNeedsCEntryByvalParamThunk): SysV-AMD64
//     passes it MEMORY class (bytes on the stack) and AAPCS32 by value (split
//     r0-r3 + stack), so a C caller of the raw entry hands over the struct while the
//     mangled entry expects a pointer.  AAPCS64 passes it indirectly BOTH ways, so
//     it needs no thunk.  The thunk reuses the per-arch #[c_export] trampoline, which
//     gathers the by-value struct and hands the mangled entry a pointer.
//   - a multi-value RETURN whose C struct-return ABI diverges from the internal
//     register-return convention (cc.CExportMultiReturnRetAdaptKind != NONE): the
//     mangled entry returns the tuple in Binate's INTERNAL form, so a C caller of
//     the raw entry reads the wrong registers / misses the sret buffer.  This is
//     the SAME divergence #[c_export] adapts; the thunk reuses the per-arch
//     #[c_export] return trampoline (calls the mangled entry, repacks the return).
//
// The weak-def coalescing gives one survivor program-wide (pkg.centry.identity).
// A target that needs neither adaptation is referenced degenerate (no thunk).

// collectCEntryThunkTargets scans mod for OP_C_ENTRY instructions, marks each
// whose target needs a `__centry.` thunk (cc.CEntryNeedsThunk) so the backend
// references it (ins.CEntryThunk = true), and returns the deduplicated set of those
// targets (as @ir.Func — real or synthetic) for the backend to emit thunks for.
// Returns (targets, false) — recording an emit error on `a` — only if an
// OP_C_ENTRY names a function the module has no signature for (the checker admits
// only declared functions, so that is an internal inconsistency, not a case to
// wave through as degenerate).
func collectCEntryThunkTargets(a @asm.Assembler, cc callconv.CallConv,
		mod @ir.Module) (@[]@ir.Func, bool) {
	var targets @[]@ir.Func
	for fi := 0; fi < len(mod.Funcs); fi++ {
		var f @ir.Func = mod.Funcs[fi]
		if f.IsExtern { continue }
		for bi := 0; bi < len(f.Blocks); bi++ {
			var blk @ir.Block = f.Blocks[bi]
			for ii := 0; ii < len(blk.Instrs); ii++ {
				var ins @ir.Instr = blk.Instrs[ii]
				if ins.Op != iropcode.OP_C_ENTRY { continue }
				var tf @ir.Func
				var found bool
				tf, found = ir.CEntryTargetFunc(mod, ins.StrVal)
				if !found {
					var msg @[]char
					msg = AppendStr(msg, "native __c_entry: no signature for callback target ")
					msg = AppendStr(msg, ins.StrVal)
					msg = AppendStr(msg, " (internal inconsistency)")
					a.SetError(msg)
					var none @[]@ir.Func
					return none, false
				}
				if cc.CEntryNeedsThunk(tf) {
					ins.CEntryThunk = true
					targets = appendCEntryTargetUnique(targets, tf)
				}
			}
		}
	}
	return targets, true
}

// appendCEntryTargetUnique appends tf to targets unless a target with the same
// canonical name is already present — the same function __c_entry'd at several
// sites needs only one weak thunk.
func appendCEntryTargetUnique(targets @[]@ir.Func, tf @ir.Func) @[]@ir.Func {
	for i := 0; i < len(targets); i++ {
		if cEntryNameEq(targets[i].Name, tf.Name) { return targets }
	}
	return appendFunc(targets, tf)
}

// appendFunc grows an @[]@ir.Func by one (the vec/slices helpers are not in this
// package's import set, and this list is short — one entry per distinct
// narrow-arg callback in a module).
func appendFunc(dst @[]@ir.Func, f @ir.Func) @[]@ir.Func {
	var out @[]@ir.Func = make_slice(@ir.Func, len(dst) + 1)
	for i := 0; i < len(dst); i++ { out[i] = dst[i] }
	out[len(dst)] = f
	return out
}

// cEntryNameEq compares two canonical function names for equality.
func cEntryNameEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
