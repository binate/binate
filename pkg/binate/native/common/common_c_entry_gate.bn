package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"

// __c_entry (OP_C_ENTRY) yields the ADDRESS of a Binate function's mangled
// entry so it can be handed to C as a callback pointer.  The degenerate native
// lowering references that mangled entry directly (no adaptation thunk), which
// is a correct C entry ONLY when the C caller's argument registers need no
// re-normalization.  A NARROW GP integer/bool parameter (int8/int16, plus int32
// on the 64-bit backends) arrives from a C caller with unspecified high bits
// (the same hazard #[c_export] normalizes at its entry via
// normalizeNarrowRegParam), and the mangled entry does NOT fix them up — so
// referencing it for such a callback would miscompile.  Until the c_export-style
// per-arg normalization thunk exists for __c_entry, the emit fails LOUD on that
// case rather than silently emitting a wrong callback address.

// CheckCEntryNarrowArgs scans mod for any OP_C_ENTRY whose target function has a
// narrow GP integer/bool parameter (relative to this target's word size) and, if
// found, records an emit error on `a` and returns false.  Returns true when no
// __c_entry target has such a parameter.  Runs as a pre-pass in EmitObject,
// before any code is emitted.  The check is conservative — it flags a narrow GP
// scalar by TYPE, without modeling the reg/stack argument split, so it also
// rejects the safe case of a narrow arg that would land on the STACK (which the
// callee prologue re-extends itself); rejecting a valid callback is safe (the
// user falls back to LLVM), never a miscompile.  The B2 narrow-arg adaptation
// thunk will remove this gate entirely.
func CheckCEntryNarrowArgs(a @asm.Assembler, wordBytes int, mod @ir.Module) bool {
	for fi := 0; fi < len(mod.Funcs); fi++ {
		var f @ir.Func = mod.Funcs[fi]
		if f.IsExtern { continue }
		for bi := 0; bi < len(f.Blocks); bi++ {
			var blk @ir.Block = f.Blocks[bi]
			for ii := 0; ii < len(blk.Instrs); ii++ {
				var ins @ir.Instr = blk.Instrs[ii]
				if ins.Op != iropcode.OP_C_ENTRY { continue }
				if !cEntryTargetOk(a, wordBytes, mod, ins.StrVal) {
					return false
				}
			}
		}
	}
	return true
}

// cEntryTargetOk reports whether the __c_entry target named `name` is
// degenerate-safe, recording an emit error on `a` (and returning false) when it
// is not.  A target the module has no signature for is itself an error: the
// checker only admits declared functions, so a missing signature means an
// internal inconsistency, not a safe case to wave through.
func cEntryTargetOk(a @asm.Assembler, wordBytes int, mod @ir.Module, name *[]readonly char) bool {
	var params @[]@types.Type
	var found bool
	params, found = ir.FuncParamTypesByName(mod, name)
	if !found {
		var msg @[]char
		msg = AppendStr(msg, "native __c_entry: no signature for callback target ")
		msg = AppendStr(msg, name)
		msg = AppendStr(msg, " (internal inconsistency)")
		a.SetError(msg)
		return false
	}
	for pi := 0; pi < len(params); pi++ {
		if cEntryParamNeedsThunk(params[pi], wordBytes) {
			var msg @[]char
			msg = AppendStr(msg, "native __c_entry: callback ")
			msg = AppendStr(msg, name)
			msg = AppendStr(msg,
					" has a narrow integer/bool parameter; an adaptation "
							"thunk for narrow-argument C callbacks is not yet implemented on "
							"the native backend — pass only pointer/word-size/float/aggregate "
							"arguments, or use the LLVM backend")
			a.SetError(msg)
			return false
		}
	}
	return true
}

// cEntryParamNeedsThunk reports whether a parameter of type t is a narrow GP
// integer/bool scalar under a target whose word size is wordBytes bytes — i.e. a
// parameter a C caller may leave with dirty high bits when it is passed in a
// register, and that the degenerate __c_entry lowering can't normalize.  Floats
// (a separate register file) and aggregates (passed by reference / in multiple
// registers) are excluded, matching the float/aggregate skips in
// normalizeNarrowRegParam{,X64,Arm32}; pointers are word-size, so the
// `< wordBytes` bound already excludes them.  This does NOT model the reg/stack
// split — a narrow arg that would land on the stack is degenerate-safe (the
// callee prologue re-extends it) yet is still flagged here, an intentionally
// conservative over-rejection (see CheckCEntryNarrowArgs).  The bool trap:
// SubWordNarrow reports bool non-narrow (it is not IsInteger), but a bool param
// IS a 1-byte GP arg the c_export path still zero-extends, so keying off SizeOf
// (which is 1 for bool) — not SubWordNarrow — correctly flags it.
func cEntryParamNeedsThunk(t @types.Type, wordBytes int) bool {
	if t == nil { return false }
	if IsFloatScalarTyp(t) { return false }
	if IsAggregateTyp(t) { return false }
	var sz int = t.SizeOf()
	return sz > 0 && sz < wordBytes
}
