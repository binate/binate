package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the native __c_entry narrow-arg gate (common_c_entry_gate.bn).
// CheckCEntryNarrowArgs scans a module for OP_C_ENTRY and fails loud when a
// callback target has a narrow GP integer/bool parameter (relative to the
// target word size), since the degenerate lowering can't normalize it.

// gateParam wraps a type in an ir.Param.
func gateParam(t @types.Type) @ir.Param {
	var p @ir.Param = make(ir.Param)
	p.Typ = t
	return p
}

// gateModule builds a `main` module with a callback `cmp` taking cbParams and a
// `caller` that returns __c_entry(cmp).  When defineCb is false, `cmp` is NOT
// added, so the __c_entry references a name the module has no signature for.
func gateModule(cbParams @[]@ir.Param, defineCb bool) @ir.Module {
	var m @ir.Module = ir.NewModule("\"main\"")
	if defineCb {
		var noResults @[]@types.Type
		var cb @ir.Func = ir.NewFunc("main", "cmp", cbParams, noResults)
		var cbEntry @ir.Block = ir.AddBlock(cb, "entry")
		var noRet @[]@ir.Instr
		cbEntry.EmitReturn(noRet)
		m.AddFunc(cb)
	}
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.MakePointerType(types.TypUint8())
	var caller @ir.Func = ir.NewFunc("main", "caller", noParams, results)
	var entry @ir.Block = ir.AddBlock(caller, "entry")
	var ce @ir.Instr = entry.EmitCEntry("cmp")
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = ce
	entry.EmitReturn(retArgs)
	m.AddFunc(caller)
	return m
}

// oneParam builds a single-param slice for a callback.
func oneParam(t @types.Type) @[]@ir.Param {
	var ps @[]@ir.Param = make_slice(@ir.Param, 1)
	ps[0] = gateParam(t)
	return ps
}

// A callback whose args are all pointer / word-size / float is degenerate-safe:
// the gate passes with no error.
func TestCEntryDegenerateSafePasses() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var ps @[]@ir.Param = make_slice(@ir.Param, 2)
	ps[0] = gateParam(types.TypInt64())
	ps[1] = gateParam(types.TypFloat64())
	var m @ir.Module = gateModule(ps, true)
	if !CheckCEntryNarrowArgs(a, 8, m) {
		return "degenerate-safe callback (int64+float64) should pass the gate"
	}
	if a.HasError { return "gate must not set an error for a safe callback" }
	return ""
}

// A callback with a narrow GP integer parameter (int8) fails loud on a 64-bit
// target.
func TestCEntryNarrowIntFailsLoud() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var m @ir.Module = gateModule(oneParam(types.TypInt8()), true)
	if CheckCEntryNarrowArgs(a, 8, m) {
		return "int8-parameter callback must fail the gate on a 64-bit target"
	}
	if !a.HasError { return "gate must set an emit error for a narrow-arg callback" }
	return ""
}

// int32 is narrow on a 64-bit target (word 8) but NOT on a 32-bit target (word
// 4) — pins the target-word-size sensitivity.
func TestCEntryInt32NarrowByWordSize() testing.TestResult {
	var a64 @asm.Assembler = asm.New(8)
	var m64 @ir.Module = gateModule(oneParam(types.TypInt32()), true)
	if CheckCEntryNarrowArgs(a64, 8, m64) {
		return "int32 callback must fail the gate on a 64-bit target"
	}
	var a32 @asm.Assembler = asm.New(4)
	var m32 @ir.Module = gateModule(oneParam(types.TypInt32()), true)
	if !CheckCEntryNarrowArgs(a32, 4, m32) {
		return "int32 callback must pass the gate on a 32-bit target (word-size arg)"
	}
	return ""
}

// A float parameter is passed in the FP register file, not a narrow GP reg — the
// gate excludes it even though float32's size is below the word size.
func TestCEntryFloatParamNotNarrow() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var m @ir.Module = gateModule(oneParam(types.TypFloat32()), true)
	if !CheckCEntryNarrowArgs(a, 8, m) {
		return "float32-parameter callback should pass the gate (FP arg, not narrow GP)"
	}
	return ""
}

// An __c_entry whose target has no known signature in the module fails loud
// rather than being waved through — the checker only admits declared functions,
// so a missing signature is an internal inconsistency.
func TestCEntryUnknownTargetFailsLoud() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var noParams @[]@ir.Param
	var m @ir.Module = gateModule(noParams, false)
	if CheckCEntryNarrowArgs(a, 8, m) {
		return "an __c_entry with no known target signature must fail the gate"
	}
	if !a.HasError { return "gate must set an emit error for an unknown target" }
	return ""
}

// A bool parameter (1 byte) is a narrow GP arg the c_export path zero-extends;
// SubWordNarrow reports bool non-narrow (bool is not IsInteger), so this pins
// that the gate keys off SizeOf, not SubWordNarrow, and still flags bool.
func TestCEntryBoolParamFailsLoud() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var m @ir.Module = gateModule(oneParam(types.TypBool()), true)
	if CheckCEntryNarrowArgs(a, 8, m) {
		return "bool-parameter callback must fail the gate (1-byte GP arg)"
	}
	if !a.HasError { return "gate must set an emit error for a bool-param callback" }
	return ""
}

// A `readonly int8` parameter peels to a narrow int and is flagged — pinning
// that the gate peels transparent wrappers (via SizeOf / the shared predicates)
// rather than only matching bare int types.
func TestCEntryReadonlyNarrowFailsLoud() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var m @ir.Module = gateModule(oneParam(types.MakeReadonlyType(types.TypInt8())), true)
	if CheckCEntryNarrowArgs(a, 8, m) {
		return "readonly-int8 callback must fail the gate (peels to a narrow int)"
	}
	return ""
}
