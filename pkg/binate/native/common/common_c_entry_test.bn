package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the native __c_entry thunk preparation (common_c_entry.bn).
// collectCEntryThunkTargets scans a module for OP_C_ENTRY, marks each whose
// target has a narrow GP integer/bool parameter (relative to the target word
// size) so the backend references its weak adaptation thunk (ins.CEntryThunk),
// and returns the deduplicated targets to emit thunks for.  It fails loud only on
// an internal inconsistency (a target with no known signature).

// ceParam wraps a type in an ir.Param.
func ceParam(t @types.Type) @ir.Param {
	var p @ir.Param = make(ir.Param)
	p.Typ = t
	return p
}

// ceModule builds a `main` module with a callback `cmp` taking cbParams and a
// `caller` whose body returns __c_entry(cmp).  When defineCb is false, `cmp` is
// NOT added, so the __c_entry references a name the module has no signature for.
func ceModule(cbParams @[]@ir.Param, defineCb bool) @ir.Module {
	var m @ir.Module = ir.NewModule("\"main\"")
	if defineCb {
		var noResults @[]@types.Type
		var cb @ir.Func = ir.NewFunc("main", "cmp", cbParams, noResults)
		var cbEntry @ir.Block = ir.AddBlock(cb, "entry")
		var noRet @[]@ir.Instr
		cbEntry.EmitReturn(noRet)
		m.AddFunc(cb)
	}
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.MakePointerType(types.TypUint8())
	var caller @ir.Func = ir.NewFunc("main", "caller", noParams, results)
	var entry @ir.Block = ir.AddBlock(caller, "entry")
	var ce @ir.Instr = entry.EmitCEntry("cmp")
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = ce
	entry.EmitReturn(retArgs)
	m.AddFunc(caller)
	return m
}

// oneParam builds a single-param slice for a callback.
func oneParam(t @types.Type) @[]@ir.Param {
	var ps @[]@ir.Param = make_slice(@ir.Param, 1)
	ps[0] = ceParam(t)
	return ps
}

// findCEntry returns the first OP_C_ENTRY instruction in m (nil if none).
func findCEntry(m @ir.Module) @ir.Instr {
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @ir.Func = m.Funcs[fi]
		for bi := 0; bi < len(f.Blocks); bi++ {
			var blk @ir.Block = f.Blocks[bi]
			for ii := 0; ii < len(blk.Instrs); ii++ {
				if blk.Instrs[ii].Op == iropcode.OP_C_ENTRY { return blk.Instrs[ii] }
			}
		}
	}
	return nil
}

// A callback whose args are all pointer / word-size / float is degenerate-safe:
// no thunk target, no flag, no error.
func TestCEntryDegenerateNoThunk() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var ps @[]@ir.Param = make_slice(@ir.Param, 2)
	ps[0] = ceParam(types.TypInt64())
	ps[1] = ceParam(types.TypFloat64())
	var m @ir.Module = ceModule(ps, true)
	var targets @[]@ir.Func
	var ok bool
	targets, ok = collectCEntryThunkTargets(a, 8, m)
	if !ok || a.HasError { return "degenerate callback should not error" }
	if len(targets) != 0 { return "degenerate callback should need no thunk" }
	if findCEntry(m).CEntryThunk { return "degenerate OP_C_ENTRY should not set CEntryThunk" }
	return ""
}

// A callback with a narrow GP integer parameter (int8) on a 64-bit target needs a
// thunk: one target, the flag set, no error (B2 handles it — no fail-loud).
func TestCEntryNarrowIntNeedsThunk() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var m @ir.Module = ceModule(oneParam(types.TypInt8()), true)
	var targets @[]@ir.Func
	var ok bool
	targets, ok = collectCEntryThunkTargets(a, 8, m)
	if !ok || a.HasError { return "narrow-arg callback must NOT fail loud in B2" }
	if len(targets) != 1 { return "int8-parameter callback should need one thunk" }
	if !findCEntry(m).CEntryThunk { return "narrow OP_C_ENTRY should set CEntryThunk" }
	return ""
}

// int32 needs a thunk on a 64-bit target (word 8) but NOT on a 32-bit target
// (word 4) — pins the target-word-size sensitivity.
func TestCEntryInt32ThunkByWordSize() testing.TestResult {
	var a64 @asm.Assembler = asm.New(8)
	var m64 @ir.Module = ceModule(oneParam(types.TypInt32()), true)
	var t64 @[]@ir.Func
	var ok64 bool
	t64, ok64 = collectCEntryThunkTargets(a64, 8, m64)
	if !ok64 || len(t64) != 1 || !findCEntry(m64).CEntryThunk {
		return "int32 callback should need a thunk on a 64-bit target"
	}
	var a32 @asm.Assembler = asm.New(4)
	var m32 @ir.Module = ceModule(oneParam(types.TypInt32()), true)
	var t32 @[]@ir.Func
	var ok32 bool
	t32, ok32 = collectCEntryThunkTargets(a32, 4, m32)
	if !ok32 || len(t32) != 0 || findCEntry(m32).CEntryThunk {
		return "int32 callback should be degenerate on a 32-bit target (word-size arg)"
	}
	return ""
}

// A float parameter is passed in the FP register file, not a narrow GP reg — no
// thunk, even though float32's size is below the word size.
func TestCEntryFloatParamNoThunk() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var m @ir.Module = ceModule(oneParam(types.TypFloat32()), true)
	var targets @[]@ir.Func
	var ok bool
	targets, ok = collectCEntryThunkTargets(a, 8, m)
	if !ok || len(targets) != 0 || findCEntry(m).CEntryThunk {
		return "float32-parameter callback should need no thunk (FP arg, not narrow GP)"
	}
	return ""
}

// A bool parameter (1 byte) is a narrow GP arg — SubWordNarrow reports bool
// non-narrow (bool is not IsInteger), so this pins that the classifier keys off
// SizeOf and still needs a thunk for it.
func TestCEntryBoolParamNeedsThunk() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var m @ir.Module = ceModule(oneParam(types.TypBool()), true)
	var targets @[]@ir.Func
	var ok bool
	targets, ok = collectCEntryThunkTargets(a, 8, m)
	if !ok || len(targets) != 1 || !findCEntry(m).CEntryThunk {
		return "bool-parameter callback should need a thunk (1-byte GP arg)"
	}
	return ""
}

// A `readonly int8` parameter peels to a narrow int and needs a thunk — pinning
// that the classifier peels transparent wrappers (via SizeOf).
func TestCEntryReadonlyNarrowNeedsThunk() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var m @ir.Module = ceModule(oneParam(types.MakeReadonlyType(types.TypInt8())), true)
	var targets @[]@ir.Func
	var ok bool
	targets, ok = collectCEntryThunkTargets(a, 8, m)
	if !ok || len(targets) != 1 || !findCEntry(m).CEntryThunk {
		return "readonly-int8 callback should need a thunk (peels to a narrow int)"
	}
	return ""
}

// An __c_entry whose target has no known signature still fails loud — the checker
// admits only declared functions, so a missing signature is an internal
// inconsistency, not a case to silently treat as degenerate.
func TestCEntryUnknownTargetFailsLoud() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var noParams @[]@ir.Param
	var m @ir.Module = ceModule(noParams, false)
	var targets @[]@ir.Func
	var ok bool
	targets, ok = collectCEntryThunkTargets(a, 8, m)
	if ok { return "an __c_entry with no known target signature must fail loud" }
	if !a.HasError { return "gate must set an emit error for an unknown target" }
	if len(targets) != 0 { return "a failed collect should return no targets" }
	return ""
}

// int16 is a narrow GP arg (like int8) — a second width to pin that the
// classifier is width-general, not int8-specific.
func TestCEntryInt16NeedsThunk() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var m @ir.Module = ceModule(oneParam(types.TypInt16()), true)
	var targets @[]@ir.Func
	var ok bool
	targets, ok = collectCEntryThunkTargets(a, 8, m)
	if !ok || len(targets) != 1 || !findCEntry(m).CEntryThunk {
		return "int16-parameter callback should need a thunk"
	}
	return ""
}

// Two __c_entry(cmp) sites for the SAME narrow target collapse to ONE thunk
// target (dedup by name) — the single weak survivor is what delivers
// pkg.centry.identity, and a duplicate would emit a duplicate `__centry.` label.
func TestCEntryDedupSameTarget() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var m @ir.Module = ir.NewModule("\"main\"")
	var noResults @[]@types.Type
	var cb @ir.Func = ir.NewFunc("main", "cmp", oneParam(types.TypInt8()), noResults)
	var cbEntry @ir.Block = ir.AddBlock(cb, "entry")
	var noRet @[]@ir.Instr
	cbEntry.EmitReturn(noRet)
	m.AddFunc(cb)
	var noParams @[]@ir.Param
	var res @[]@types.Type = make_slice(@types.Type, 1)
	res[0] = types.MakePointerType(types.TypUint8())
	var caller @ir.Func = ir.NewFunc("main", "caller", noParams, res)
	var entry @ir.Block = ir.AddBlock(caller, "entry")
	var ce1 @ir.Instr = entry.EmitCEntry("cmp")
	var ce2 @ir.Instr = entry.EmitCEntry("cmp")
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = ce1
	entry.EmitReturn(retArgs)
	m.AddFunc(caller)
	var targets @[]@ir.Func
	var ok bool
	targets, ok = collectCEntryThunkTargets(a, 8, m)
	if !ok { return "dedup module should collect ok" }
	if len(targets) != 1 { return "two __c_entry(cmp) sites should dedup to one thunk target" }
	if !ce1.CEntryThunk || !ce2.CEntryThunk { return "both OP_C_ENTRY sites should be flagged" }
	return ""
}
