package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"

// ============================================================
// Call argument helpers (CallConv-independent)
// ============================================================
//
// The CallConv-parameterised dispatch (CallArgRegStart /
// CallArgStackOff / CallStackBytes / the return classifiers) lives in
// common_callconv.bn. The helpers here are shared by every backend
// regardless of calling convention.

// ArgWords returns the 8-byte word count for an argument of type t.
// Scalars (and managed/raw pointers) are 1; aggregates are
// SizeOf(t) / 8 rounded up to at least 1.
//
// Word size is 8 on every backend we currently target (AAPCS64 and
// SysV-AMD64 are both LP64). 32-bit targets will need this
// parameterised on the target pointer/word size.
func ArgWords(t @types.Type) int {
	if !IsAggregateTyp(t) { return 1 }
	var sz int = t.SizeOf()
	var w int = (sz + 7) / 8
	if w < 1 { w = 1 }
	return w
}

// callArgTypes returns the types of an OP_CALL's arguments in a fresh
// slice, used by PlanFrame to feed CallStackBytes without exposing the
// IR-instruction shape there.
func callArgTypes(ins @ir.Instr) @[]@types.Type {
	var ts @[]@types.Type = make_slice(@types.Type, len(ins.Args))
	for i := 0; i < len(ins.Args); i++ {
		ts[i] = ins.Args[i].Typ
	}
	return ts
}

// callDispatchArgTypes returns the arg-type sequence the call
// dispatch ACTUALLY sees — same as callArgTypes, except when the
// callee returns a big aggregate via sret AND the calling convention
// passes the sret pointer in a GP arg register (SysV-AMD64 uses
// RDI), in which case a leading TypInt() is prepended to model the
// hidden sret slot.  PlanFrame uses this for the outgoing-args
// reservation so the call's stack-spilled tail doesn't overlap the
// caller's own sret-stash at SP+SretSlotOff.
//
// Mirrors the synthesis loop in pkg/binate/native/x64/x64_call.bn
// (emitCall's `bigRet { argTypes[0] = TypInt() }` branch) — both
// must agree on what the call's effective arg list looks like.
//
// CalleeUsesCSret(allFuncs, ins) is NOT consulted here (PlanFrame
// doesn't have the funcs list); CExternSretBytes / CallReturnsBig-
// MultiReturn cover the Binate-internal sret cases that surface in
// practice.  A C-extern callee with a >16-byte aggregate return
// whose visible-arg count saturates the GP arg-reg pool would still
// trip the same overlap bug — track separately if it surfaces.
func callDispatchArgTypes(cc CallConv,
		ins @ir.Instr) @[]@types.Type {
	var bigRet bool = ins.ID >= 0 && cc.SretInGpArgReg &&
		(cc.CallReturnsBigAggregate(ins) ||
			cc.CallReturnsBigMultiReturn(ins))
	if !bigRet {
		return callArgTypes(ins)
	}
	var ts @[]@types.Type =
		make_slice(@types.Type, len(ins.Args) + 1)
	ts[0] = types.TypInt()
	for i := 0; i < len(ins.Args); i++ {
		ts[i+1] = ins.Args[i].Typ
	}
	return ts
}

// callDispatchArgTypesAnyOp returns the dispatch-side arg-type
// sequence for any IR call op — direct (OP_CALL / OP_C_CALL),
// func-value (OP_CALL_FUNC_VALUE / OP_CALL_HANDLE), or
// indirect-ptr (OP_CALL_INDIRECT).  Used by PlanFrame to size the
// outgoing-args stack reservation uniformly across all call
// shapes; before this helper, only OP_CALL / OP_C_CALL were
// counted, which let the closure-struct local overlap the
// outgoing-args area for func-value calls with enough user-args
// to spill (the 523_closure_many_user_args bug).
//
// Shapes:
//   - OP_CALL / OP_C_CALL: same as callDispatchArgTypes (incl. the
//     SretInGpArgReg-prepend for big-aggregate returns).
//   - OP_CALL_FUNC_VALUE / OP_CALL_HANDLE: skip Args[0] (the
//     func-value), prepend `prefixSlots` TypInt() slots — 1 for
//     scalar returns (just the data ptr in RDI / X0) or 2 for
//     aggregate returns (retbuf + data).  Mirrors the emitter's
//     own prefixSlots computation.
//   - OP_CALL_INDIRECT: skip Args[0] (the function ptr); no
//     prefix slots — emitter passes user-args straight in
//     RDI..R9 / X0..X7.
func callDispatchArgTypesAnyOp(cc CallConv,
		ins @ir.Instr) @[]@types.Type {
	if ins.Op == iropcode.OP_CALL || ins.Op == iropcode.OP_C_CALL {
		return callDispatchArgTypes(cc, ins)
	}
	if ins.Op == iropcode.OP_CALL_FUNC_VALUE ||
			ins.Op == iropcode.OP_CALL_HANDLE {
		var prefixSlots int = 1
		var aggregateRet bool = ins.ID >= 0 && ins.Typ != nil &&
			IsAggregateTyp(ins.Typ) && !IsMultiReturnCall(ins)
		if aggregateRet { prefixSlots = 2 }
		var nUserArgs int = len(ins.Args) - 1
		if nUserArgs < 0 { nUserArgs = 0 }
		var ts @[]@types.Type =
			make_slice(@types.Type, nUserArgs + prefixSlots)
		for p := 0; p < prefixSlots; p++ {
			ts[p] = types.TypInt()
		}
		for i := 0; i < nUserArgs; i++ {
			// Mirror emitCallFuncValue's all-int shim-ABI substitution so the
			// outgoing-args SIZE this feeds PlanFrame matches what the emitter
			// actually spills: a float-scalar arg rides a GP slot (the shim
			// re-marshals it into the FP file), and on a natural-size-stack-arg
			// CC a narrow (<8-byte) non-aggregate scalar rides a rounded 8-byte
			// GP slot.  Without this the sizer classifies a float as FP-passed
			// (reserving too little), and PlanFrame places a caller local inside
			// the region the emitter overruns (see claude-todo "func-value
			// dispatch UNDER-COUNTS outgoing-args when float args spill").
			var at @types.Type = ins.Args[i + 1].Typ
			if IsFloatScalarTyp(at) ||
					(cc.NaturalSizeStackArgs && !IsAggregateTyp(at) &&
						at.SizeOf() < 8) {
				at = types.MakePointerType(types.TypUint8())
			}
			ts[prefixSlots + i] = at
		}
		return ts
	}
	if ins.Op == iropcode.OP_CALL_INDIRECT {
		var nUserArgs int = len(ins.Args) - 1
		if nUserArgs < 0 { nUserArgs = 0 }
		var ts @[]@types.Type =
			make_slice(@types.Type, nUserArgs)
		for i := 0; i < nUserArgs; i++ {
			ts[i] = ins.Args[i + 1].Typ
		}
		return ts
	}
	if ins.Op == iropcode.OP_CALL_IFACE_METHOD {
		// Args[0] is the interface value; the dispatch passes its data
		// (receiver) pointer as the first arg slot, then the user args.
		// A big-aggregate / big-multi return adds a leading sret-pointer
		// slot ONLY where sret travels in a GP arg register (SysV RDI);
		// AArch64 carries it in X8, off the arg-reg sequence, so it adds
		// no slot — exactly the native emitCallIfaceMethod layouts.
		var prefixSlots int = 1
		var bigRet bool = ins.ID >= 0 &&
			(cc.CallReturnsBigAggregate(ins) ||
				cc.CallReturnsBigMultiReturn(ins))
		if bigRet && cc.SretInGpArgReg { prefixSlots = 2 }
		var nUserArgs int = len(ins.Args) - 1
		if nUserArgs < 0 { nUserArgs = 0 }
		var ts @[]@types.Type =
			make_slice(@types.Type, nUserArgs + prefixSlots)
		for p := 0; p < prefixSlots; p++ {
			ts[p] = types.TypInt()
		}
		for i := 0; i < nUserArgs; i++ {
			ts[prefixSlots + i] = ins.Args[i + 1].Typ
		}
		return ts
	}
	var empty @[]@types.Type
	return empty
}

// isCallOp reports whether ins.Op is one of the call ops that
// dispatch through outgoing arg-registers + outgoing-args stack
// area, and therefore should contribute to PlanFrame's outgoing-
// args reservation.
func isCallOp(op int) bool {
	if op == iropcode.OP_CALL { return true }
	if op == iropcode.OP_C_CALL { return true }
	if op == iropcode.OP_CALL_FUNC_VALUE { return true }
	if op == iropcode.OP_CALL_HANDLE { return true }
	if op == iropcode.OP_CALL_INDIRECT { return true }
	if op == iropcode.OP_CALL_IFACE_METHOD { return true }
	return false
}

// charSliceEq compares two char slices byte-for-byte. Used by the
// callee-name lookup in CallConv.CalleeUsesCSret.
func charSliceEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
