package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/types"

// ============================================================
// Call argument helpers (CallConv-independent)
// ============================================================
//
// The CallConv-parameterised dispatch (CallArgRegStart /
// CallArgStackOff / CallStackBytes / the return classifiers) lives in
// common_callconv.bn. The helpers here are shared by every backend
// regardless of calling convention.

// ArgWords returns the 8-byte word count for an argument of type t.
// Scalars (and managed/raw pointers) are 1; aggregates are
// SizeOf(t) / 8 rounded up to at least 1.
//
// Word size is 8 on every backend we currently target (AAPCS64 and
// SysV-AMD64 are both LP64). 32-bit targets will need this
// parameterised on the target pointer/word size.
func ArgWords(t @types.Type) int {
	if !IsAggregateTyp(t) { return 1 }
	var sz int = t.SizeOf()
	var w int = sz / 8
	if w < 1 { w = 1 }
	return w
}

// callArgTypes returns the types of an OP_CALL's arguments in a fresh
// slice, used by PlanFrame to feed CallStackBytes without exposing the
// IR-instruction shape there.
func callArgTypes(ins @ir.Instr) @[]@types.Type {
	var ts @[]@types.Type = make_slice(@types.Type, len(ins.Args))
	for i := 0; i < len(ins.Args); i++ {
		ts[i] = ins.Args[i].Typ
	}
	return ts
}

// charSliceEq compares two char slices byte-for-byte. Used by the
// callee-name lookup in CallConv.CalleeUsesCSret.
func charSliceEq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
