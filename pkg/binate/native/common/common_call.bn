package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/types"

// ============================================================
// Call argument helpers (CallConv-independent)
// ============================================================
//
// The CallConv-parameterised dispatch (CallArgRegStart /
// CallArgStackOff / CallStackBytes / the return classifiers) lives in
// callconv/callconv.bn. The helpers here are shared by every backend
// regardless of calling convention.

// callArgTypes returns the types of an OP_CALL's arguments in a fresh
// slice, used by PlanFrame to feed CallStackBytes without exposing the
// IR-instruction shape there.
func callArgTypes(ins @ir.Instr) @[]@types.Type {
	var ts @[]@types.Type = make_slice(@types.Type, len(ins.Args))
	for i := 0; i < len(ins.Args); i++ {
		ts[i] = ins.Args[i].Typ
	}
	return ts
}

// callDispatchArgTypes returns the arg-type sequence the call
// dispatch ACTUALLY sees — same as callArgTypes, except when the
// callee returns a big aggregate via sret AND the calling convention
// passes the sret pointer in a GP arg register (SysV-AMD64 uses
// RDI), in which case a leading TypInt() is prepended to model the
// hidden sret slot.  PlanFrame uses this for the outgoing-args
// reservation so the call's stack-spilled tail doesn't overlap the
// caller's own sret-stash at SP+SretSlotOff.
//
// Mirrors the synthesis loop in pkg/binate/native/x64/x64_call.bn
// (emitCall's `bigRet { argTypes[0] = TypInt() }` branch) — both
// must agree on what the call's effective arg list looks like.
func callDispatchArgTypes(cc callconv.CallConv, ins @ir.Instr) @[]@types.Type {
	var bigRet bool = ins.ID >= 0 && cc.SretInGpArgReg &&
			(cc.CallReturnsBigAggregate(ins) || cc.CallReturnsBigMultiReturn(ins))
	if !bigRet {
		return callArgTypes(ins)
	}
	var ts @[]@types.Type = make_slice(@types.Type, len(ins.Args) + 1)
	ts[0] = types.TypInt()
	for i := 0; i < len(ins.Args); i++ {
		ts[i + 1] = ins.Args[i].Typ
	}
	return ts
}

// shimDispatchArgTypes returns the dispatch-side arg-type sequence for a
// handle-marshaling-shim call — OP_CALL_FUNC_VALUE / OP_CALL_HANDLE
// (extraFixedPrefix 0) or OP_CALL_IFACE_METHOD (extraFixedPrefix 1, the extra
// receiver slot).  It is a MATCHED PAIR with the per-backend shim emitters
// (emitCallFuncValue / emitCallIfaceMethod): the iface dispatch is exactly the
// func-value dispatch with ONE additional fixed prefix slot (the receiver), so
// routing both through this one function guarantees PlanFrame's outgoing-args
// reservation equals what those emitters spill.  Args[0] (the func-value / iface
// value) is skipped; the leading prefix is TypInt() slots and the user args are
// substituted to the all-int shim ABI.
//
// prefixSlots = 1 + extraFixedPrefix (the data ptr, plus the receiver for
// iface), then +1 for the retbuf when the result rides a caller-supplied buffer:
// a single aggregate return (types.IsAggregateReturnTyp, EXCLUDING a 0-byte
// aggregate, which is void-like) or ANY multi-return (IsMultiReturnCall).  This
// is the same retbuf-vs-scalar classification emitCallFuncValue /
// emitCallIfaceMethod use for their own prefixSlots, on ALL calling conventions:
// under retbuf-for-any-multi-return the shim passes a retbuf as a GP arg even on
// AAPCS64 (the retbuf rides X0; the callee's X8 sret plumbing is internal to the
// shim, not an extra prefix slot), so the count MUST NOT be gated on
// SretInGpArgReg — doing so left aa64 under-counting once it too passes the
// retbuf as a GP arg.
func shimDispatchArgTypes(cc callconv.CallConv, ins @ir.Instr,
		extraFixedPrefix int) @[]@types.Type {
	var prefixSlots int = 1 + extraFixedPrefix
	var aggregateRet bool = ins.ID >= 0 && types.IsAggregateReturnTyp(ins.Typ) &&
			!callconv.IsMultiReturnCall(ins)
	if aggregateRet || (ins.ID >= 0 && callconv.IsMultiReturnCall(ins)) {
		prefixSlots = prefixSlots + 1
	}
	var nUserArgs int = len(ins.Args) - 1
	if nUserArgs < 0 { nUserArgs = 0 }
	var ts @[]@types.Type = make_slice(@types.Type, nUserArgs + prefixSlots)
	for p := 0; p < prefixSlots; p++ {
		ts[p] = types.TypInt()
	}
	for i := 0; i < nUserArgs; i++ {
		// Mirror the shim emitters' all-int shim-ABI substitution so the outgoing-args
		// SIZE this feeds PlanFrame matches what the emitter actually spills: the
		// dispatch carries a float scalar in GP register(s) of its byte width — ONE word
		// for a float32 (and for any float on LP64, where an 8-byte float is a single
		// 8-byte word), a TWO-word even-aligned PAIR for a float64 on ILP32.  Size it as
		// the same-width GP INTEGER (a float wider than one word -> int64, else a 1-word
		// *uint8) so the sizing matches the emitter, which lets a float ride its real
		// type via the soft-float GP path.  A 1-word *uint8 for EVERY float would
		// UNDER-reserve a float64 on ILP32 (2 words), and PlanFrame would then place a
		// caller local inside the region the emitted spill overruns — a hang (see
		// conformance 565 / 888).  On a natural-size-stack-arg CC a narrow (<8-byte)
		// non-aggregate scalar rides a rounded 8-byte GP slot.
		var at @types.Type = ins.Args[i + 1].Typ
		if callconv.IsFloatScalarTyp(at) {
			if at.SizeOf() > cc.WordBytes {
				at = types.TypInt64()
			} else {
				at = types.MakePointerType(types.TypUint8())
			}
		} else if cc.NaturalSizeStackArgs && !callconv.IsAggregateTyp(at) && at.SizeOf() < 8 {
			at = types.MakePointerType(types.TypUint8())
		}
		ts[prefixSlots + i] = at
	}
	return ts
}

// callDispatchArgTypesAnyOp returns the dispatch-side arg-type
// sequence for any IR call op — direct (OP_CALL / OP_C_CALL),
// func-value (OP_CALL_FUNC_VALUE / OP_CALL_HANDLE),
// iface-method (OP_CALL_IFACE_METHOD), or indirect-ptr
// (OP_CALL_INDIRECT).  Used by PlanFrame to size the
// outgoing-args stack reservation uniformly across all call
// shapes; before this helper, only OP_CALL / OP_C_CALL were
// counted, which let the closure-struct local overlap the
// outgoing-args area for func-value calls with enough user-args
// to spill (the 523_closure_many_user_args bug).
//
// Shapes:
//   - OP_CALL / OP_C_CALL: same as callDispatchArgTypes (incl. the
//     SretInGpArgReg-prepend for big-aggregate returns).
//   - OP_CALL_FUNC_VALUE / OP_CALL_HANDLE: shimDispatchArgTypes
//     with no extra prefix — skip Args[0] (the func-value),
//     prepend [data] (+ retbuf for an aggregate / multi return),
//     then the shim-ABI user args.
//   - OP_CALL_IFACE_METHOD: shimDispatchArgTypes with ONE extra
//     fixed prefix (the receiver) — skip Args[0] (the iface
//     value), prepend [data, receiver] (+ retbuf for an aggregate
//     / multi return), then the shim-ABI user args.  Exactly the
//     func-value dispatch plus the receiver slot the native
//     emitCallIfaceMethod prepends after the handle's data.
//   - OP_CALL_INDIRECT: skip Args[0] (the function ptr); no
//     prefix slots — emitter passes user-args straight in
//     RDI..R9 / X0..X7.
func callDispatchArgTypesAnyOp(cc callconv.CallConv, ins @ir.Instr) @[]@types.Type {
	if ins.Op == iropcode.OP_CALL || ins.Op == iropcode.OP_C_CALL {
		return callDispatchArgTypes(cc, ins)
	}
	if ins.Op == iropcode.OP_CALL_FUNC_VALUE || ins.Op == iropcode.OP_CALL_HANDLE {
		// The func-value shim prefix is [data] (+ retbuf for an aggregate / multi
		// return) — no extra fixed prefix.  Matched pair with emitCallFuncValue.
		return shimDispatchArgTypes(cc, ins, 0)
	}
	if ins.Op == iropcode.OP_CALL_INDIRECT {
		var nUserArgs int = len(ins.Args) - 1
		if nUserArgs < 0 { nUserArgs = 0 }
		var ts @[]@types.Type = make_slice(@types.Type, nUserArgs)
		for i := 0; i < nUserArgs; i++ {
			ts[i] = ins.Args[i + 1].Typ
		}
		return ts
	}
	if ins.Op == iropcode.OP_DIV_CHECK {
		// rt.DivCheck(dividend int64, divisor int64, signedMin int64,
		// isSigned int).  The two IR operands (dividend, divisor) are the
		// widened-to-int64 divide operands; signedMin (int64) and isSigned
		// (int) are synthesized by the emitter from the carried width /
		// BoolVal.  On ILP32 (AAPCS32) the first two int64s fill r0:r1 / r2:r3
		// and signedMin+isSigned overflow to the stack, so PlanFrame MUST
		// reserve that outgoing-args tail; on LP64 all four fit in registers
		// (this sizes to 0).  Types, not values, drive the sizing.
		var ts @[]@types.Type = make_slice(@types.Type, 4)
		ts[0] = types.TypInt64()
		ts[1] = types.TypInt64()
		ts[2] = types.TypInt64()
		ts[3] = types.TypInt()
		return ts
	}
	if ins.Op == iropcode.OP_SHIFT_CHECK {
		// rt.ShiftCheck(count int64) — a single int64 (r0:r1 on ILP32, one X
		// on LP64), no stack.
		var ts @[]@types.Type = make_slice(@types.Type, 1)
		ts[0] = types.TypInt64()
		return ts
	}
	if ins.Op == iropcode.OP_BOUNDS_CHECK {
		// rt.BoundsCheck(index int, length int) — two host-int words, always
		// in registers on every target.
		var ts @[]@types.Type = make_slice(@types.Type, 2)
		ts[0] = types.TypInt()
		ts[1] = types.TypInt()
		return ts
	}
	if ins.Op == iropcode.OP_CALL_IFACE_METHOD {
		// The native emitCallIfaceMethod dispatches THROUGH the method's func-value
		// HANDLE + marshaling shim (like OP_CALL_FUNC_VALUE), with the interface
		// value's data (iv[0]) prepended as the shim's receiver after the handle's
		// data — so the prefix is [data, receiver] (+ retbuf for an aggregate / multi
		// return), i.e. the func-value dispatch with ONE extra fixed prefix slot.
		// shimDispatchArgTypes with extraFixedPrefix=1 produces exactly that, INCLUDING
		// the shim-ABI user-arg coercions, so the sizer stays a matched pair with the
		// emitter on every backend.  (The old raw-dispatch sizing — 1 prefix slot, no
		// receiver, raw un-coerced arg types — under-reserved outgoing-args by the
		// receiver word: a spilled user arg overran the frame slot above the outgoing
		// area, a silent stack corruption; conformance/1160, 1161.)
		return shimDispatchArgTypes(cc, ins, 1)
	}
	var empty @[]@types.Type
	return empty
}

// isCallOp reports whether ins.Op is one of the call ops that
// dispatch through outgoing arg-registers + outgoing-args stack
// area, and therefore should contribute to PlanFrame's outgoing-
// args reservation.
func isCallOp(op int) bool {
	if op == iropcode.OP_CALL { return true }
	if op == iropcode.OP_C_CALL { return true }
	if op == iropcode.OP_CALL_FUNC_VALUE { return true }
	if op == iropcode.OP_CALL_HANDLE { return true }
	if op == iropcode.OP_CALL_INDIRECT { return true }
	if op == iropcode.OP_CALL_IFACE_METHOD { return true }
	// The runtime guard calls (rt.DivCheck / rt.ShiftCheck / rt.BoundsCheck)
	// dispatch through the outgoing arg registers + stack too, so PlanFrame must
	// size their outgoing-args tail.  This matters only where a guard's args
	// overflow the arg registers: on ILP32 (AAPCS32) rt.DivCheck's int64-pair
	// args push signedMin + isSigned onto the stack, which would otherwise
	// overlap a spill slot.  On LP64 all guard args fit in registers, so this
	// sizes to 0 and changes nothing for aarch64 / x64.
	if op == iropcode.OP_DIV_CHECK { return true }
	if op == iropcode.OP_SHIFT_CHECK { return true }
	if op == iropcode.OP_BOUNDS_CHECK { return true }
	// OP_SAT_LOOKUP lowers natively as a call to rt.SatLookup (emitCall), so it
	// dispatches through the outgoing arg registers / stack too.  Its two
	// pointer args fit in registers on every current ABI (0 stack bytes), so
	// this changes nothing today — but classifying it as a call keeps PlanFrame
	// correct if that ever changes, and matches the "lowers exactly as a call"
	// contract.
	if op == iropcode.OP_SAT_LOOKUP { return true }
	return false
}
