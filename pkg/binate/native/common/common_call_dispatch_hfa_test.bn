package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// The dispatch carries an aggregate not passed indirectly as one pointer slot, so
// callDispatchArgTypesAnyOp must size it as one: a float aggregate's real type
// classifies into float registers (an aarch64 or arm32 hard-float HFA, an x86-64 SSE
// aggregate) and a zero-size one into nothing, while the pointer slot follows the
// core-register slots onto the stack — which the outgoing area must hold, or the call
// overwrites the frame below it (conformance 1652).

// fvCallWithTail builds an OP_CALL_FUNC_VALUE with n int64 user args, then `last`,
// returning a scalar.
func fvCallWithTail(n int, last @types.Type) @ir.Instr {
	var fv @ir.Instr = make(ir.Instr)
	fv.ID = 1
	fv.Op = iropcode.OP_FUNC_VALUE
	var args @[]@ir.Instr = make_slice(@ir.Instr, n + 2)
	args[0] = fv
	for i := 0; i < n; i++ {
		args[i + 1] = make(ir.Instr)
		args[i + 1].Typ = types.TypInt64()
	}
	args[n + 1] = make(ir.Instr)
	args[n + 1].Typ = last
	var call @ir.Instr = make(ir.Instr)
	call.ID = 9
	call.Op = iropcode.OP_CALL_FUNC_VALUE
	call.Typ = types.TypFloat64()
	call.Args = args
	return call
}

// fvCallArgs builds an OP_CALL_FUNC_VALUE with the given user-arg types, returning a
// scalar.
func fvCallArgs(argTypes @[]@types.Type) @ir.Instr {
	var fv @ir.Instr = make(ir.Instr)
	fv.ID = 1
	fv.Op = iropcode.OP_FUNC_VALUE
	var args @[]@ir.Instr = make_slice(@ir.Instr, len(argTypes) + 1)
	args[0] = fv
	for i := 0; i < len(argTypes); i++ {
		args[i + 1] = make(ir.Instr)
		args[i + 1].Typ = argTypes[i]
	}
	var call @ir.Instr = make(ir.Instr)
	call.ID = 9
	call.Op = iropcode.OP_CALL_FUNC_VALUE
	call.Typ = types.TypInt()
	call.Args = args
	return call
}

// emptyThenInts is (Empty, then n int64s) with Empty a zero-size named struct.
func emptyThenInts(n int) @[]@types.Type {
	var none @[]@types.Field
	var ts @[]@types.Type = make_slice(@types.Type, n + 1)
	ts[0] = types.MakeStructType("Empty", none)
	for i := 0; i < n; i++ {
		ts[i + 1] = types.TypInt64()
	}
	return ts
}

// twoFloat64 is a named struct of two float64s.
func twoFloat64() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypFloat64()
	}
	fields[0].Name = "x"
	fields[1].Name = "y"
	return types.MakeStructType("D2", fields)
}

// aarch64: [data] + seven int64s fill x0-x7, so the HFA's pointer slot is the ninth
// and needs 8 stack bytes (16 after rounding).
func TestCallDispatchFuncValueHfaPointerSlotReservesStackAA64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var cc callconv.CallConv = callconv.AAPCS64()
	var ts @[]@types.Type = callDispatchArgTypesAnyOp(cc, fvCallWithTail(7, twoFloat64()))
	var stackBytes int64 = cc.CallStackBytes(ts)
	setTarget64()
	if len(ts) != 9 || callconv.IsAggregateTyp(ts[8]) {
		return "the HFA must be sized as one pointer slot (the ninth dispatch slot)"
	}
	if stackBytes < 8 {
		return "the HFA's pointer slot is past x7: the outgoing area must reserve it"
	}
	return ""
}

// x86-64: [data] + five int64s fill the six GP argument registers, so the SSE
// aggregate's pointer slot goes to the stack.
func TestCallDispatchFuncValueSsePointerSlotReservesStackX64() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var cc callconv.CallConv = callconv.SysV_AMD64()
	var ts @[]@types.Type = callDispatchArgTypesAnyOp(cc, fvCallWithTail(5, twoFloat64()))
	var stackBytes int64 = cc.CallStackBytes(ts)
	setTarget64()
	if stackBytes < 8 {
		return "the SSE aggregate's pointer slot is past the GP registers: reserve it"
	}
	return ""
}

// A zero-size aggregate still takes a pointer slot: [data] + Empty + n int64s puts the
// last int past the core registers (x86-64: n = 5; aarch64: n = 7), where the outgoing
// area must hold it — sized by its real type, Empty would take no slot and nothing
// would be reserved.
func TestCallDispatchFuncValueZeroSizeTakesSlot() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var cx callconv.CallConv = callconv.SysV_AMD64()
	var bx int64 = cx.CallStackBytes(callDispatchArgTypesAnyOp(cx, fvCallArgs(emptyThenInts(5))))
	setTarget64()
	types.SetArch(types.ARCH_AA64)
	var ca callconv.CallConv = callconv.AAPCS64()
	var ba int64 = ca.CallStackBytes(callDispatchArgTypesAnyOp(ca, fvCallArgs(emptyThenInts(7))))
	setTarget64()
	if bx < 8 { return "x86-64: the last int64 is past the six GP registers; reserve it" }
	if ba < 8 { return "aarch64: the last int64 is past x7; reserve it" }
	return ""
}

// arm32 hard-float with HFA passing on: a three-float64 HFA rides D registers when
// passed directly, but on the dispatch it is a pointer slot after [data] + three ints
// (r0-r3), so on the stack.
func TestCallDispatchFuncValueHfaPointerSlotReservesStackArm32Hard() testing.TestResult {
	setTarget32()
	types.SetArch(types.ARCH_ARM32)
	types.SetFloatABI(types.FLOAT_ABI_HARD)
	var cc callconv.CallConv = callconv.AAPCS32()
	cc.HfaAggregates = true
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypFloat64()
	}
	var d3 @types.Type = types.MakeStructType("D3", fields)
	var ts @[]@types.Type = make_slice(@types.Type, 4)
	ts[0] = types.TypInt()
	ts[1] = types.TypInt()
	ts[2] = types.TypInt()
	ts[3] = d3
	var stackBytes int64 = cc.CallStackBytes(callDispatchArgTypesAnyOp(cc, fvCallArgs(ts)))
	types.SetFloatABI(types.FLOAT_ABI_DEFAULT)
	setTarget64()
	if stackBytes < 4 { return "the D3's pointer slot is past r3: reserve it" }
	return ""
}
