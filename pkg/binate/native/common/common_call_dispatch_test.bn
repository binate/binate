package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for callDispatchArgTypesAnyOp (common_call.bn) — the dispatch-side
// arg-type sequence PlanFrame sizes the outgoing-args reservation from, per
// call op (direct / func-value / iface-method / indirect).  Each shim case is a
// MATCHED PAIR with its per-backend emitter: the asserted prefixSlots / arg
// coercions must equal what emitCallFuncValue / emitCallIfaceMethod spill, or
// PlanFrame under-reserves and a spilled user arg corrupts a frame slot.  Split
// out of common_call_test.bn to keep each file under the length cap.

// callDispatchArgTypesAnyOp for OP_CALL_FUNC_VALUE: skips Args[0]
// (the func-value) and prepends a TypInt() for the data ptr (the
// hidden RDI / X0 arg the shim consumes).
func TestCallDispatchArgTypesFuncValueScalar() testing.TestResult {
	setTarget64()
	// Build a synthetic OP_CALL_FUNC_VALUE with 3 user args.
	var fv @ir.Instr = make(ir.Instr)
	fv.ID = 1
	fv.Op = iropcode.OP_FUNC_VALUE
	fv.Typ = nil // doesn't matter for this test
	var a1 @ir.Instr = make(ir.Instr)
	a1.Typ = types.TypInt64()
	var a2 @ir.Instr = make(ir.Instr)
	a2.Typ = types.TypInt64()
	var a3 @ir.Instr = make(ir.Instr)
	a3.Typ = types.TypInt64()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 4)
	args[0] = fv
	args[1] = a1
	args[2] = a2
	args[3] = a3
	var call @ir.Instr = make(ir.Instr)
	call.ID = 9
	call.Op = iropcode.OP_CALL_FUNC_VALUE
	call.Typ = types.TypInt64() // scalar return
	call.Args = args
	var ts @[]@types.Type = callDispatchArgTypesAnyOp(SysV_AMD64(), call)
	// Expect 4: 1 prefix (data ptr) + 3 user args.
	if len(ts) != 4 {
		return "expected 4 dispatch arg types (1 prefix + 3 user)"
	}
	if ts[0] != types.TypInt() {
		return "first slot must be TypInt (the data-ptr slot)"
	}
	return ""
}

// Regression: a func-value call `f(int, float64, int)` on AAPCS32 (ILP32) must size
// the float64 arg as a 2-word EVEN-ALIGNED pair, so the trailing int overflows to the
// outgoing-args stack and PlanFrame RESERVES it.  The old sizer substituted a float64
// to a 1-word *uint8, so all four dispatch words (data, int, float64-as-1-word, int)
// fit R0..R3 and CallStackBytes was 0 — yet emitCallFuncValue placed the float64 as a
// real 2-word pair and spilled the trailing int PAST the unreserved area, corrupting a
// caller local (a hang; conformance 565 / 888).  On LP64 a float64 is one 8-byte word,
// so this sizing is unchanged there.
func TestCallDispatchFuncValueFloat64ReservesStack() testing.TestResult {
	setTarget32()
	var fv @ir.Instr = make(ir.Instr)
	fv.ID = 1
	fv.Op = iropcode.OP_FUNC_VALUE
	var a1 @ir.Instr = make(ir.Instr)
	a1.Typ = types.TypInt()
	var a2 @ir.Instr = make(ir.Instr)
	a2.Typ = types.TypFloat64()
	var a3 @ir.Instr = make(ir.Instr)
	a3.Typ = types.TypInt()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 4)
	args[0] = fv
	args[1] = a1
	args[2] = a2
	args[3] = a3
	var call @ir.Instr = make(ir.Instr)
	call.ID = 9
	call.Op = iropcode.OP_CALL_FUNC_VALUE
	call.Typ = types.TypInt64() // scalar (register-pair) return
	call.Args = args
	// dispatch words: data(R0), int(R1), float64(R2:R3), int -> overflows to the stack.
	var ts @[]@types.Type = callDispatchArgTypesAnyOp(AAPCS32(), call)
	var stackBytes int = AAPCS32().CallStackBytes(ts)
	setTarget64()
	if stackBytes == 0 {
		return "float64 func-value arg must be sized as a 2-word pair so the trailing "
				"int overflows to a RESERVED stack slot (the old 1-word *uint8 sizing "
				"under-reserved -> hang; conformance 565 / 888)"
	}
	return ""
}

// callDispatchArgTypesAnyOp for OP_CALL_INDIRECT: skips Args[0]
// (the function pointer) — no prefix slots, since the emitter
// doesn't prepend any hidden arg.
func TestCallDispatchArgTypesIndirectNoPrefix() testing.TestResult {
	setTarget64()
	var fp @ir.Instr = make(ir.Instr)
	fp.Typ = types.MakePointerType(types.TypInt64())
	var a1 @ir.Instr = make(ir.Instr)
	a1.Typ = types.TypInt64()
	var a2 @ir.Instr = make(ir.Instr)
	a2.Typ = types.TypInt64()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 3)
	args[0] = fp
	args[1] = a1
	args[2] = a2
	var call @ir.Instr = make(ir.Instr)
	call.ID = 5
	call.Op = iropcode.OP_CALL_INDIRECT
	call.Typ = types.TypInt64()
	call.Args = args
	var ts @[]@types.Type = callDispatchArgTypesAnyOp(SysV_AMD64(), call)
	if len(ts) != 2 {
		return "expected 2 dispatch arg types (no prefix; 2 user)"
	}
	return ""
}

// callDispatchArgTypesAnyOp for OP_CALL_IFACE_METHOD: the native dispatch goes
// THROUGH the method's func-value handle + marshaling shim, prepending [data,
// receiver] (the handle's data plus the iface value's data as the shim's
// receiver) — the func-value dispatch's [data] PLUS one extra fixed prefix slot.
// So a scalar-return iface method with 3 user args sizes to 2 prefix + 3 user.
// (The pre-handle sizing dropped the receiver slot — 1 prefix — under-reserving
// outgoing-args by a word; conformance/1160.)
func TestCallDispatchArgTypesIfaceMethodScalar() testing.TestResult {
	setTarget64()
	var iv @ir.Instr = make(ir.Instr)
	iv.Typ = nil
	var a1 @ir.Instr = make(ir.Instr)
	a1.Typ = types.TypInt64()
	var a2 @ir.Instr = make(ir.Instr)
	a2.Typ = types.TypInt64()
	var a3 @ir.Instr = make(ir.Instr)
	a3.Typ = types.TypInt64()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 4)
	args[0] = iv
	args[1] = a1
	args[2] = a2
	args[3] = a3
	var call @ir.Instr = make(ir.Instr)
	call.ID = 9
	call.Op = iropcode.OP_CALL_IFACE_METHOD
	call.Typ = types.TypInt64()
	call.Args = args
	var ts @[]@types.Type = callDispatchArgTypesAnyOp(SysV_AMD64(), call)
	// 2 prefix (data, receiver) + 3 user args.
	if len(ts) != 5 {
		return "expected 5 dispatch arg types (2 prefix [data, receiver] + 3 user)"
	}
	if ts[0] != types.TypInt() || ts[1] != types.TypInt() {
		return "first two slots must be TypInt (the data + receiver prefix)"
	}
	return ""
}

// callDispatchArgTypesAnyOp for an OP_CALL_IFACE_METHOD returning a >16-byte
// aggregate via sret: the shim passes the retbuf as a GP arg on EVERY calling
// convention (INCLUDING AAPCS64, where the retbuf rides X0 — the callee's X8
// sret plumbing is internal to the shim, not an extra prefix slot), so the
// prefix is [retbuf, data, receiver] (3 slots) on both SysV and AAPCS64.  With 2
// user args that is 5 dispatch slots.  Pins the retbuf branch for iface — the
// func-value retbuf case PLUS the receiver slot.  (The pre-handle sizing gave
// SysV 2 / AAPCS64 1, both dropping the receiver and AAPCS64 also mis-modeling
// the retbuf as an X8-only slot; conformance/1161.)
func TestCallDispatchArgTypesIfaceMethodSretReturn() testing.TestResult {
	setTarget64()
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	// 24 bytes > InternalSretBytes (16) on either target.
	var big @types.Type = types.MakeStructType("Big24", fields)
	var iv @ir.Instr = make(ir.Instr)
	var a1 @ir.Instr = make(ir.Instr)
	a1.Typ = types.TypInt64()
	var a2 @ir.Instr = make(ir.Instr)
	a2.Typ = types.TypInt64()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 3)
	args[0] = iv
	args[1] = a1
	args[2] = a2
	var call @ir.Instr = make(ir.Instr)
	call.ID = 9
	call.Op = iropcode.OP_CALL_IFACE_METHOD
	call.Typ = big
	call.Args = args
	// SysV: retbuf in RDI -> 3 prefix slots (retbuf, data, receiver) + 2 user.
	var sysv @[]@types.Type = callDispatchArgTypesAnyOp(SysV_AMD64(), call)
	if len(sysv) != 5 {
		return "SysV sret iface-method: expected 3 prefix (retbuf, data, receiver) "
				"+ 2 user"
	}
	if sysv[0] != types.TypInt() || sysv[1] != types.TypInt() || sysv[2] != types.TypInt() {
		return "SysV first three slots must be TypInt (retbuf + data + receiver prefix)"
	}
	// AAPCS64: retbuf rides X0 as a GP arg (X8 sret plumbing is internal to the
	// shim), so the prefix is 3 (retbuf, data, receiver) + 2 user — same as SysV.
	var aapcs @[]@types.Type = callDispatchArgTypesAnyOp(AAPCS64(), call)
	if len(aapcs) != 5 {
		return "AAPCS64 retbuf rides X0: expected 3 prefix (retbuf, data, receiver) "
				"+ 2 user"
	}
	return ""
}

// callDispatchArgTypesAnyOp for a BIG MULTI-RETURN OP_CALL_FUNC_VALUE.  Under
// retbuf-for-any-multi-return the func-value emitter passes a retbuf as a GP arg
// for EVERY multi-return on ALL calling conventions, so the dispatch prepends TWO
// prefix slots (retbuf + data) — INCLUDING AAPCS64, where the retbuf rides X0 as
// a GP arg even for a big tuple (the callee's X8 sret plumbing is internal to the
// shim, not a third prefix slot).  The sizer must match the emitter's
// prefixSlots=2 or PlanFrame under-reserves outgoing-args and a spilled user arg
// overlaps a frame slot (a cross-module silent miscompile).  Regression for the
// big-multi-return func-value under-reservation bug.
func TestCallDispatchArgTypesFuncValueBigMultiReturn() testing.TestResult {
	// Anonymous (int64 x9) tuple = a multi-return that is big (sret) on EVERY
	// target: 9 GP words > NumGpRetRegs on SysV (2) and AAPCS64 (8), and 18 GP
	// words > 4 on ILP32/AAPCS32.  Empty struct name => IsMultiReturnCall.  (9 is
	// the first count that overflows AAPCS64's X0..X7, so this also exercises the
	// gate's inertness for a genuinely-big tuple on aa64.)
	var fields @[]@types.Field = make_slice(@types.Field, 9)
	for i := 0; i < 9; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	var fv @ir.Instr = make(ir.Instr)
	fv.ID = 1
	fv.Op = iropcode.OP_FUNC_VALUE
	var a1 @ir.Instr = make(ir.Instr)
	a1.Typ = types.TypInt64()
	var a2 @ir.Instr = make(ir.Instr)
	a2.Typ = types.TypInt64()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 3)
	args[0] = fv
	args[1] = a1
	args[2] = a2
	var call @ir.Instr = make(ir.Instr)
	call.ID = 9
	call.Op = iropcode.OP_CALL_FUNC_VALUE
	call.Typ = tuple
	call.Args = args
	setTarget64()
	if !SysV_AMD64().CallReturnsBigMultiReturn(call) {
		return "test setup: tuple must be a big multi-return on SysV"
	}
	// SysV (SretInGpArgReg): 2 prefix (retbuf + data) + 2 user.
	var sysv @[]@types.Type = callDispatchArgTypesAnyOp(SysV_AMD64(), call)
	if len(sysv) != 4 {
		return "SysV big-multi-return func value: expected 2 prefix (retbuf+data) "
				"+ 2 user"
	}
	// AAPCS64: retbuf rides X0 as a GP arg (X8 sret plumbing is internal to the
	// shim), so the prefix is 2 (retbuf + data) + 2 user — same as SysV.
	var aapcs64 @[]@types.Type = callDispatchArgTypesAnyOp(AAPCS64(), call)
	if len(aapcs64) != 4 {
		return "AAPCS64 big-multi-return func value: expected 2 prefix "
				"(retbuf+data) + 2 user"
	}
	// AAPCS32 (SretInGpArgReg): same 2-prefix reservation as SysV.
	setTarget32()
	if !AAPCS32().CallReturnsBigMultiReturn(call) {
		setTarget64()
		return "test setup: tuple must be a big multi-return on AAPCS32"
	}
	var aapcs32 @[]@types.Type = callDispatchArgTypesAnyOp(AAPCS32(), call)
	setTarget64()
	if len(aapcs32) != 4 {
		return "AAPCS32 big-multi-return func value: expected 2 prefix "
				"(retbuf+data) + 2 user"
	}
	return ""
}

// callDispatchArgTypesAnyOp for a SMALL MULTI-RETURN OP_CALL_FUNC_VALUE: (int,
// int) — packable into return registers on every target (2 GP words <=
// NumGpRetRegs everywhere).  Under retbuf-for-any-multi-return the func-value
// emitter passes a retbuf for EVERY multi-return, so the dispatch prepends TWO
// prefix slots (retbuf + data) on ALL calling conventions, INCLUDING AAPCS64 —
// the case the pre-fix gate (SretInGpArgReg-only) got wrong (it left aa64 at 1,
// under-counting outgoing-args for a spilling small-multiret func-value call).
func TestCallDispatchArgTypesFuncValueSmallMultiReturn() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	var fv @ir.Instr = make(ir.Instr)
	fv.ID = 1
	fv.Op = iropcode.OP_FUNC_VALUE
	var a1 @ir.Instr = make(ir.Instr)
	a1.Typ = types.TypInt()
	var a2 @ir.Instr = make(ir.Instr)
	a2.Typ = types.TypInt()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 3)
	args[0] = fv
	args[1] = a1
	args[2] = a2
	var call @ir.Instr = make(ir.Instr)
	call.ID = 9
	call.Op = iropcode.OP_CALL_FUNC_VALUE
	call.Typ = tuple
	call.Args = args
	setTarget64()
	if SysV_AMD64().CallReturnsBigMultiReturn(call) {
		return "test setup: (int,int) must be a SMALL multi-return on SysV"
	}
	// SysV: 2 prefix (retbuf + data) + 2 user.
	var sysv @[]@types.Type = callDispatchArgTypesAnyOp(SysV_AMD64(), call)
	if len(sysv) != 4 {
		return "SysV small-multi-return func value: expected 2 prefix "
				"(retbuf+data) + 2 user"
	}
	// AAPCS64: also 2 prefix — retbuf rides X0 as a GP arg (small tuple returns
	// field-per-register, stored through retbuf by the shim).  This is the case
	// the old SretInGpArgReg gate left at 1.
	var aapcs64 @[]@types.Type = callDispatchArgTypesAnyOp(AAPCS64(), call)
	if len(aapcs64) != 4 {
		return "AAPCS64 small-multi-return func value: expected 2 prefix "
				"(retbuf+data) + 2 user"
	}
	setTarget32()
	if AAPCS32().CallReturnsBigMultiReturn(call) {
		setTarget64()
		return "test setup: (int,int) must be a SMALL multi-return on AAPCS32"
	}
	var aapcs32 @[]@types.Type = callDispatchArgTypesAnyOp(AAPCS32(), call)
	setTarget64()
	if len(aapcs32) != 4 {
		return "AAPCS32 small-multi-return func value: expected 2 prefix "
				"(retbuf+data) + 2 user"
	}
	return ""
}

// callDispatchArgTypesAnyOp for a SMALL MULTI-RETURN OP_CALL_IFACE_METHOD: the
// iface sibling of the func-value case above — the prefix is [retbuf, data,
// receiver] (3 slots) on EVERY calling convention, one more than the func value
// for the receiver.  A small (int,int) tuple is register-returned (NOT big) on
// all three CCs, so the OLD raw-dispatch sizing left prefixSlots at 1 (bigRet
// false, no receiver) while the emitter uses 3 — under-reserving outgoing-args
// by TWO words, the exact arm32 corruption conformance/1161 exhibits.  This pins
// the retbuf-plus-receiver iface prefix so the sizer can't silently drift back.
func TestCallDispatchArgTypesIfaceMethodSmallMultiReturn() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	var iv @ir.Instr = make(ir.Instr)
	var a1 @ir.Instr = make(ir.Instr)
	a1.Typ = types.TypInt()
	var a2 @ir.Instr = make(ir.Instr)
	a2.Typ = types.TypInt()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 3)
	args[0] = iv
	args[1] = a1
	args[2] = a2
	var call @ir.Instr = make(ir.Instr)
	call.ID = 9
	call.Op = iropcode.OP_CALL_IFACE_METHOD
	call.Typ = tuple
	call.Args = args
	setTarget64()
	if SysV_AMD64().CallReturnsBigMultiReturn(call) {
		return "test setup: (int,int) must be a SMALL multi-return on SysV"
	}
	// SysV: 3 prefix (retbuf, data, receiver) + 2 user.
	var sysv @[]@types.Type = callDispatchArgTypesAnyOp(SysV_AMD64(), call)
	if len(sysv) != 5 {
		return "SysV small-multi-return iface-method: expected 3 prefix "
				"(retbuf, data, receiver) + 2 user"
	}
	// AAPCS64: also 3 prefix — retbuf rides X0 as a GP arg.
	var aapcs64 @[]@types.Type = callDispatchArgTypesAnyOp(AAPCS64(), call)
	if len(aapcs64) != 5 {
		return "AAPCS64 small-multi-return iface-method: expected 3 prefix "
				"(retbuf, data, receiver) + 2 user"
	}
	setTarget32()
	if AAPCS32().CallReturnsBigMultiReturn(call) {
		setTarget64()
		return "test setup: (int,int) must be a SMALL multi-return on AAPCS32"
	}
	// AAPCS32 (arm32, the conformance/1161 target): 3 prefix + 2 user.  The old
	// sizing gave 1 here, under-reserving by two words.
	var aapcs32 @[]@types.Type = callDispatchArgTypesAnyOp(AAPCS32(), call)
	setTarget64()
	if len(aapcs32) != 5 {
		return "AAPCS32 small-multi-return iface-method: expected 3 prefix "
				"(retbuf, data, receiver) + 2 user"
	}
	return ""
}
