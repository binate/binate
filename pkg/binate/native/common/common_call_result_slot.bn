package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/std/vec"

// A call whose aggregate result is stored whole into a stack slot can write the result
// straight into the slot.  Otherwise the result gets a buffer of its own (a native data
// region; the LLVM backend's `.sret` / `.rb`), which the store then copies into the
// slot.  The slot can stand in for that buffer when nothing can tell the difference:
// the slot's bytes change when the call returns rather than at the store, and during
// the call the callee must not be able to reach them.  So
//   - the store is the result's only use, in the call's block;
//   - the slot is a stack slot (not a package global, not a parameter's slot nor one
//     that may be a parameter's incoming copy) of the result's size whose address
//     never leaves the function: it is only ever the address of a load or a store, or
//     the base of field and element pointers that are only ever used so in turn;
//   - nothing between the call and the store references the slot or a value computed
//     from it — an aggregate load of a slot may alias the slot's bytes
//     (AggLoadElision), on the understanding that the store is their next writer;
//   - the slot's OP_ALLOC is not between the call and the store, unless it is
//     NoZeroInit (it then emits nothing): its zero-fill would land on the result.
//     Anywhere else a zero-fill runs before the call or after the store, as it does
//     without the slot standing in, since the call and the store share a block.
// The call's arguments are evaluated before the call, and a by-value argument is
// passed as a copy, so an argument read from the slot is unaffected.  The slot may
// also be the local a function keeps in its caller's result buffer (RetbufLocal): its
// bytes are then the caller's, private to the call for RetbufLocal's reasons, and a
// direct call returning through a buffer passes that buffer on (placeCallResults).

// CallResultSlots returns, indexed by value ID, the value ID of the stack slot each
// call of f may write its aggregate result into, in place of a buffer of its own (see
// above), or -1.  A backend returning the result in memory passes the slot as the
// result buffer, one returning it in registers stores them into the slot, and the
// store then copies nothing.
func CallResultSlots(f @ir.Func) @[]int {
	return newFuncUses(f).callResultSlots(InPlaceParamSlots(f))
}

// callResultSlots is CallResultSlots over u's function, whose InPlaceParamSlots are
// inPlace.
func (u @funcUses) callResultSlots(inPlace @[]int) @[]int {
	var f @ir.Func = u.f
	var out @[]int = make_slice(int, f.NextID)
	for i := 0; i < len(out); i++ { out[i] = -1 }
	// The qualifying calls, by slot: a slot's reach does not depend on the call, so it
	// is computed once for all the calls storing into the slot.
	var groups @slotGroups
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var call @ir.Instr = b.Instrs[ii]
			if !isAggregateResultCall(call) || call.ID >= len(out) || u.useCount(call.ID) != 1 { continue }
			var si int = nextUseIndex(b, ii, call)
			if si < 0 { continue }
			var st @ir.Instr = b.Instrs[si]
			if st.Op != iropcode.OP_STORE || len(st.Args) < 2 || st.Args[1].ID != call.ID { continue }
			var slot @ir.Instr = st.Args[0]
			if !isPlainStackSlot(slot) || slot.ID >= len(out) || inPlace[slot.ID] >= 0 ||
					slot.TypeArg == nil || slot.TypeArg.Size() != call.Typ.Size() {
				continue
			}
			if groups == nil { groups = newSlotGroups(f.NextID) }
			groups.add(slot.ID, bi, ii, si)
		}
	}
	if groups == nil { return out }
	var reach @idSet = newIDSet(f.NextID)
	var ptr @idSet = newIDSet(f.NextID)
	for k := 0; k < groups.slots.Len(); k++ {
		var c int = groups.last[groups.slots.Get(k)]
		var slot @ir.Instr = f.Blocks[groups.block.Get(c)].Instrs[groups.end.Get(c)].Args[0]
		if !u.slotReach(slot, reach, ptr) { continue }
		for c >= 0 {
			var b @ir.Block = f.Blocks[groups.block.Get(c)]
			var ii int = groups.at.Get(c)
			if !referencesAnyBetween(b, ii, groups.end.Get(c), reach, slot) {
				out[b.Instrs[ii].ID] = slot.ID
			}
			c = groups.prev.Get(c)
		}
	}
	return out
}

// isAggregateResultCall reports whether ins is a call producing one aggregate value.
func isAggregateResultCall(ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_CALL && ins.Op != iropcode.OP_C_CALL && !isIndirectCallOp(ins.Op) {
		return false
	}
	if ins.ID < 0 || ins.Typ == nil || !callconv.IsAggregateTyp(ins.Typ) { return false }
	return !callconv.IsMultiReturnCall(ins) && ins.Typ.Size() > 0
}

// isPlainStackSlot reports whether v is a stack slot of f's own: an OP_ALLOC that is
// neither a package global's reference nor a parameter's slot.
func isPlainStackSlot(v @ir.Instr) bool {
	return v != nil && v.Op == iropcode.OP_ALLOC && !v.IsGlobalRef && v.ParamIndex == 0 && v.ID >= 0
}

// valueUseCounts counts, indexed by value ID, the operand and phi references to each
// value of f in its blocks.  Its fault pads are left out, as by slotReach: only the
// VM runs them, and these analyses serve the compiled backends, which emit none.
func valueUseCounts(f @ir.Func) @[]int {
	var n @[]int = make_slice(int, f.NextID)
	countUsesIn(f.Blocks, n)
	return n
}

// countUsesIn adds the references made by the instructions of blocks to n.
func countUsesIn(blocks @[]@ir.Block, n @[]int) {
	for bi := 0; bi < len(blocks); bi++ {
		var b @ir.Block = blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			for k := 0; k < len(ins.Args); k++ {
				var v @ir.Instr = ins.Args[k]
				if v != nil && v.ID >= 0 && v.ID < len(n) { n[v.ID] = n[v.ID] + 1 }
			}
			for k := 0; k < len(ins.Phis); k++ {
				var pv *ir.Instr = ins.Phis[k].Val
				if pv != nil && pv.ID >= 0 && pv.ID < len(n) { n[pv.ID] = n[pv.ID] + 1 }
			}
		}
	}
}

// nextUseIndex returns the index of the first instruction of b after index from that
// has v as an operand, or -1.
func nextUseIndex(b @ir.Block, from int, v @ir.Instr) int {
	for ii := from + 1; ii < len(b.Instrs); ii++ {
		var ins @ir.Instr = b.Instrs[ii]
		for k := 0; k < len(ins.Args); k++ {
			if ins.Args[k] != nil && ins.Args[k].ID == v.ID { return ii }
		}
	}
	return -1
}

// slotReach computes the values reached from stack slot slot — the slot, the field
// and element pointers based on it, and every value computed from those — into
// reach, and its pointers (the slot and the field and element pointers based on it)
// into ptr, reporting false, the sets then meaningless, when the slot's address
// leaves the function: a pointer reached is used other than as the address of a load
// or a store or the base of a field or element pointer, or flows through a phi.  f's
// fault pads are left out (a slot holding a managed value is named in them, to be
// released on a fault), as funcUses leaves them out.  A worklist over the uses of the
// values reached costs those uses; a value is visited again when it turns from
// reached into a pointer, whose uses are held to the stricter rules.
func (u @funcUses) slotReach(slot @ir.Instr, reach @idSet, ptr @idSet) bool {
	reach.reset()
	ptr.reset()
	reach.add(slot.ID)
	ptr.add(slot.ID)
	var work @vec.Vec[int] = vec.New[int]()
	work.Push(slot.ID)
	for work.Len() > 0 {
		id, _ := work.Pop()
		var isPtr bool = ptr.has(id)
		for j := u.siteLo[id]; j < u.siteLo[id + 1]; j++ {
			var ins @ir.Instr = u.siteIns(j)
			var op int = u.siteOp[j]
			var mine bool = u.indexed(ins.ID)
			var grew bool = false
			if op < 0 {
				if isPtr { return false }
			} else if isPtr && !(ins.Op == iropcode.OP_STORE && op == 0) {
				var derives bool = (ins.Op == iropcode.OP_GET_FIELD_PTR ||
						ins.Op == iropcode.OP_GET_ELEM_PTR) && op == 0
				if !derives && !(ins.Op == iropcode.OP_LOAD && op == 0) { return false }
				// A derived pointer it cannot track would have its own uses go
				// unchecked: fail closed.
				if derives && !mine { return false }
				if derives && ptr.add(ins.ID) { grew = true }
			} else if isPtr {
				// The address a store writes through: the store reaches nothing.
				continue
			}
			if mine && reach.add(ins.ID) { grew = true }
			if grew { work.Push(ins.ID) }
		}
	}
	return true
}

// referencesAnyBetween reports whether an instruction of b strictly between indexes
// from and to is, or has as an operand, a value in reach — the slot's own OP_ALLOC
// excepted when it is NoZeroInit, since it then emits nothing.
func referencesAnyBetween(b @ir.Block, from int, to int, reach @idSet, slot @ir.Instr) bool {
	for ii := from + 1; ii < to; ii++ {
		var ins @ir.Instr = b.Instrs[ii]
		if ins.ID == slot.ID {
			if slot.NoZeroInit { continue }
			return true
		}
		if reach.has(ins.ID) { return true }
		for k := 0; k < len(ins.Args); k++ {
			var v @ir.Instr = ins.Args[k]
			if v != nil && reach.has(v.ID) { return true }
		}
		for k := 0; k < len(ins.Phis); k++ {
			var pv *ir.Instr = ins.Phis[k].Val
			if pv != nil && reach.has(pv.ID) { return true }
		}
	}
	return false
}

// placeCallResults gives each call PlanFrame found writing its result into a slot
// (placedCalls, with its result's region size in placedSizes and whether it is a direct
// call returning through a buffer in placedDirectSret; placed from CallResultSlots) the
// slot's region, and records the pair for CallResultSlot.  The slot the function keeps
// in its caller's result buffer (RetbufSlotID) has no region: a direct call returning
// through a buffer passes that buffer on instead, joining retbufCalls (as for
// ReturnedCallResults).  Any other call whose slot has no region keeps a region of its
// own, reserved at offset, and its store copies as usual.  It returns the frame offset
// past anything it reserved.
func (m @RegMap) placeCallResults(placed @[]int, placedCalls @vec.Vec[int], placedSizes @int64List,
		placedDirectSret @vec.Vec[bool], retbufCalls @vec.Vec[int], allocIDs @vec.Vec[int],
		allocSizes @int64List, allocOffsets @int64List, offset int64) int64 {
	var calls @vec.Vec[int] = vec.New[int]()
	var slots @vec.Vec[int] = vec.New[int]()
	var nAllocs int = allocIDs.Len()
	for i := 0; i < placedCalls.Len(); i++ {
		var id int = placedCalls.Get(i)
		var k int = -1
		for j := 0; j < nAllocs && k < 0; j++ {
			if allocIDs.Get(j) == placed[id] { k = j }
		}
		if k < 0 && m.RetbufSlotID >= 0 && placed[id] == m.RetbufSlotID && placedDirectSret.Get(i) {
			retbufCalls.Push(id)
			calls.Push(id)
			slots.Push(placed[id])
			continue
		}
		allocIDs.Push(id)
		if k >= 0 {
			allocSizes.Push(allocSizes.Get(k))
			allocOffsets.Push(allocOffsets.Get(k))
			calls.Push(id)
			slots.Push(placed[id])
		} else {
			allocSizes.Push(placedSizes.Get(i))
			allocOffsets.Push(offset)
			offset = frameAdd(offset, placedSizes.Get(i))
		}
	}
	m.ResultSlotCalls = calls.Items()
	m.ResultSlotSlots = slots.Items()
	return offset
}

// CallResultSlot returns the value ID of the slot the call with value ID id writes
// its result into (RegMap.ResultSlotCalls), or -1.
func (m @RegMap) CallResultSlot(id int) int {
	for i := 0; i < len(m.ResultSlotCalls); i++ {
		if m.ResultSlotCalls[i] == id { return m.ResultSlotSlots[i] }
	}
	return -1
}

// A function returning one aggregate through a buffer its caller provides (sret) can
// pass that buffer on to a call whose result it returns, `return mk(k)`: the call
// writes the caller's buffer and the return copies nothing.  Nothing else in the
// function reaches that buffer — it is the caller's memory, written only by the
// return — so only the call and the return matter: the result's only use is the
// return, in the call's block, and it is the size of the function's result.  Only a
// direct call qualifies, and only when it and the function both return through a
// buffer, which each backend checks for both sides: an equal size does not make an
// equal classification (an aarch64 HFA returns in registers, say).

// ReturnedCallResults reports, indexed by value ID, whether each direct call of f
// produces the one aggregate f returns (see above).  A backend passes its incoming
// result buffer to such a call when the function and the call both return through one.
func ReturnedCallResults(f @ir.Func) @[]bool {
	var out @[]bool = make_slice(bool, f.NextID)
	if len(f.Results) != 1 || f.Results[0] == nil { return out }
	var uses @[]int = valueUseCounts(f)
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var call @ir.Instr = b.Instrs[ii]
			if call.Op != iropcode.OP_CALL || !isAggregateResultCall(call) || call.ID >= len(out) ||
					uses[call.ID] != 1 || call.Typ.Size() != f.Results[0].Size() {
				continue
			}
			var ri int = nextUseIndex(b, ii, call)
			if ri < 0 { continue }
			var ret @ir.Instr = b.Instrs[ri]
			out[call.ID] = ret.Op == iropcode.OP_RETURN && len(ret.Args) == 1 && ret.Args[0].ID == call.ID
		}
	}
	return out
}

// CallResultToRetbuf reports whether the call with value ID id writes its result into
// the function's incoming result buffer (RegMap.RetbufCalls).
func (m @RegMap) CallResultToRetbuf(id int) bool {
	for i := 0; i < len(m.RetbufCalls); i++ {
		if m.RetbufCalls[i] == id { return true }
	}
	return false
}
