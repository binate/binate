package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for common_call_result_slot.bn: a call whose aggregate result is stored whole
// into a stack slot writes the result straight into the slot.

// noInstrs returns an empty instruction list.
func noInstrs() @[]@ir.Instr { return make_slice(@ir.Instr, 0) }

// resultSlotFunc returns a function whose entry block calls `mk` for a Quad, declares
// a slot NoZeroInit (as -O1 marks a slot whose first use is a whole store) and stores
// the result into it — the -O2 shape of `var x Quad = mk()` — with the entry block,
// the call and the slot; the caller adds the rest.
func resultSlotFunc() (@ir.Func, @ir.Block, @ir.Instr, @ir.Instr) {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitCall(e, "mk", noInstrs(), elisionQuadTyp())
	var s @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	s.NoZeroInit = true
	irbuild.EmitStore(e, s, c)
	return f, e, c, s
}

// `var x Quad = mk(); return x.a`: the result goes straight into x's slot.
func TestCallResultSlotsFieldRead() testing.TestResult {
	setTarget64()
	f, e, c, s := resultSlotFunc()
	irbuild.EmitLoad(e, irbuild.EmitGetFieldPtr(e, s, 0, types.TypInt()), types.TypInt())
	irbuild.EmitReturn(e, elisionNoRets())
	if CallResultSlots(f)[c.ID] != s.ID { return "the call's result goes straight into the slot" }
	return ""
}

// A slot whose field address is passed to a call is reachable from that callee — and
// from the one producing the result, in a loop — so it keeps its own buffer.
func TestCallResultSlotsAddressEscapes() testing.TestResult {
	setTarget64()
	f, e, c, s := resultSlotFunc()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = irbuild.EmitGetFieldPtr(e, s, 0, types.TypInt())
	irbuild.EmitCall(e, "use", args, types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	if CallResultSlots(f)[c.ID] != -1 {
		return "a slot whose address leaves the function keeps the copy"
	}
	return ""
}

// A load of the slot between the call and the store — an aggregate load may alias the
// slot until its next store — must still see the old bytes.
func TestCallResultSlotsReadBetween() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	var c @ir.Instr = irbuild.EmitCall(e, "mk", noInstrs(), elisionQuadTyp())
	var old @ir.Instr = irbuild.EmitLoad(e, s, elisionQuadTyp())
	irbuild.EmitStore(e, s, c)
	irbuild.EmitExtract(e, old, 0, types.TypInt())
	irbuild.EmitReturn(e, elisionNoRets())
	if CallResultSlots(f)[c.ID] != -1 {
		return "a read of the slot between the call and the store keeps the copy"
	}
	return ""
}

// The slot's zero-fill must not land on the result: an OP_ALLOC between the call and
// the store is placed only when NoZeroInit; one before the call, or in an earlier
// block (a local declared before a loop and assigned in it), either way.
func TestCallResultSlotsZeroFillOrder() testing.TestResult {
	setTarget64()
	f, e, c, s := resultSlotFunc()
	irbuild.EmitReturn(e, elisionNoRets())
	s.NoZeroInit = false
	if CallResultSlots(f)[c.ID] != -1 {
		return "a zero-fill after the call would overwrite the result"
	}
	var g @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var ge @ir.Block = ir.AddBlock(g, "entry")
	var gs @ir.Instr = irbuild.EmitAlloc(ge, elisionQuadTyp())
	var gc @ir.Instr = irbuild.EmitCall(ge, "mk", noInstrs(), elisionQuadTyp())
	irbuild.EmitStore(ge, gs, gc)
	irbuild.EmitReturn(ge, elisionNoRets())
	if CallResultSlots(g)[gc.ID] != gs.ID { return "a zero-fill before the call is harmless" }
	var h @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var he @ir.Block = ir.AddBlock(h, "entry")
	var hs @ir.Instr = irbuild.EmitAlloc(he, elisionQuadTyp())
	var body @ir.Block = ir.AddBlock(h, "body")
	irbuild.EmitJump(he, body)
	var hc @ir.Instr = irbuild.EmitCall(body, "mk", noInstrs(), elisionQuadTyp())
	irbuild.EmitStore(body, hs, hc)
	irbuild.EmitReturn(body, elisionNoRets())
	if CallResultSlots(h)[hc.ID] != hs.ID { return "a zero-fill in an earlier block is harmless" }
	return ""
}

// A field pointer of the slot flowing through a phi is a pointer the analysis no
// longer follows, so the slot's address counts as leaving the function.
func TestCallResultSlotsPhiEscapes() testing.TestResult {
	setTarget64()
	f, e, c, s := resultSlotFunc()
	var fp @ir.Instr = irbuild.EmitGetFieldPtr(e, s, 0, types.TypInt())
	var next @ir.Block = ir.AddBlock(f, "next")
	irbuild.EmitJump(e, next)
	var es @[]ir.PhiEntry = make_slice(ir.PhiEntry, 1)
	es[0].Block = e
	es[0].Val = fp
	var ph @ir.Instr = irbuild.EmitPhi(next, fp.Typ, es)
	irbuild.EmitLoad(next, ph, types.TypInt())
	irbuild.EmitReturn(next, elisionNoRets())
	if CallResultSlots(f)[c.ID] != -1 { return "a slot pointer through a phi counts as escaping" }
	return ""
}

// A load of the slot before the call whose value is used after the store sees the old
// bytes: the call is placed, and AggLoadElidable refuses to let the load alias the
// slot (the store to the slot falls before the load's last use), so the load copies
// the old bytes before the call overwrites them.
func TestCallResultSlotsLoadLiveAcrossCall() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	var old @ir.Instr = irbuild.EmitLoad(e, s, elisionQuadTyp())
	var c @ir.Instr = irbuild.EmitCall(e, "mk", noInstrs(), elisionQuadTyp())
	irbuild.EmitStore(e, s, c)
	irbuild.EmitExtract(e, old, 0, types.TypInt())
	irbuild.EmitReturn(e, elisionNoRets())
	if CallResultSlots(f)[c.ID] != s.ID { return "a load before the call does not stop the placement" }
	if AggLoadElidable(f, old) {
		return "a load of the slot used after the store must not alias the slot"
	}
	return ""
}

// A slot that may be a parameter's incoming copy (InPlaceParamSlots) is left alone:
// where it is used in place it has no region of its own to stand in for a buffer.
func TestCallResultSlotsInPlaceParamSlot() testing.TestResult {
	setTarget64()
	f, e, s0, _ := paramSlotFunc()
	var c @ir.Instr = irbuild.EmitCall(e, "mk", noInstrs(), elisionQuadTyp())
	irbuild.EmitStore(e, s0, c)
	irbuild.EmitReturn(e, elisionNoRets())
	if InPlaceParamSlots(f)[s0.ID] != 0 {
		return "the fixture's slot may be its parameter's incoming copy"
	}
	if CallResultSlots(f)[c.ID] != -1 { return "a parameter's in-place slot is left alone" }
	return ""
}

// A result used again besides the store, a package global, a parameter's slot and a
// slot of another size all keep the result's own buffer.
func TestCallResultSlotsRejected() testing.TestResult {
	setTarget64()
	f, e, c, _ := resultSlotFunc()
	irbuild.EmitExtract(e, c, 0, types.TypInt())
	irbuild.EmitReturn(e, elisionNoRets())
	if CallResultSlots(f)[c.ID] != -1 { return "a result used twice keeps its buffer" }
	g, ge, gc, gs := resultSlotFunc()
	irbuild.EmitReturn(ge, elisionNoRets())
	gs.IsGlobalRef = true
	if CallResultSlots(g)[gc.ID] != -1 { return "a package global is not a stack slot" }
	gs.IsGlobalRef = false
	gs.ParamIndex = 1
	if CallResultSlots(g)[gc.ID] != -1 { return "a parameter's slot is left alone" }
	gs.ParamIndex = 0
	gs.TypeArg = elisionPairTyp()
	if CallResultSlots(g)[gc.ID] != -1 { return "a slot of another size is left alone" }
	return ""
}

// PlanFrame gives the call the slot's region, whichever comes first, and records the
// pair, so the store copies nothing.
func TestPlanFrameCallResultSlot() testing.TestResult {
	setTarget64()
	f, e, c, s := resultSlotFunc()
	irbuild.EmitLoad(e, irbuild.EmitGetFieldPtr(e, s, 0, types.TypInt()), types.TypInt())
	irbuild.EmitReturn(e, elisionNoRets())
	var rm @RegMap = NewRegMap(callconv.AAPCS64())
	rm.PlanFrame(f)
	if rm.LookupAlloc(s.ID) < 0 || rm.LookupAlloc(c.ID) != rm.LookupAlloc(s.ID) {
		return "the call's result region is the slot's"
	}
	if rm.CallResultSlot(c.ID) != s.ID { return "the call is recorded as writing into the slot" }
	return ""
}

// quadResults returns a result list of one Quad.
func quadResults() @[]@types.Type {
	var rs @[]@types.Type = make_slice(@types.Type, 1)
	rs[0] = elisionQuadTyp()
	return rs
}

// `return mk()` from a function returning a Quad: the call produces the returned
// aggregate.  A result also read elsewhere, of another size, or returned from another
// block is not marked.
func TestReturnedCallResults() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), quadResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitCall(e, "mk", noInstrs(), elisionQuadTyp())
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = c
	irbuild.EmitReturn(e, rets)
	if !ReturnedCallResults(f)[c.ID] {
		return "a call returned directly produces the function's result"
	}
	var g @ir.Func = ir.NewFunc("", "t", elisionNoParams(), quadResults())
	var ge @ir.Block = ir.AddBlock(g, "entry")
	var gc @ir.Instr = irbuild.EmitCall(ge, "mk", noInstrs(), elisionQuadTyp())
	irbuild.EmitExtract(ge, gc, 0, types.TypInt())
	rets[0] = gc
	irbuild.EmitReturn(ge, rets)
	if ReturnedCallResults(g)[gc.ID] { return "a result also read elsewhere is not marked" }
	var hr @[]@types.Type = make_slice(@types.Type, 1)
	hr[0] = elisionPairTyp()
	var h @ir.Func = ir.NewFunc("", "t", elisionNoParams(), hr)
	var he @ir.Block = ir.AddBlock(h, "entry")
	var hc @ir.Instr = irbuild.EmitCall(he, "mk", noInstrs(), elisionQuadTyp())
	rets[0] = hc
	irbuild.EmitReturn(he, rets)
	if ReturnedCallResults(h)[hc.ID] {
		return "a result of another size than the function's is not marked"
	}
	var k @ir.Func = ir.NewFunc("", "t", elisionNoParams(), quadResults())
	var ke @ir.Block = ir.AddBlock(k, "entry")
	var kc @ir.Instr = irbuild.EmitCall(ke, "mk", noInstrs(), elisionQuadTyp())
	var kb @ir.Block = ir.AddBlock(k, "out")
	irbuild.EmitJump(ke, kb)
	rets[0] = kc
	irbuild.EmitReturn(kb, rets)
	if ReturnedCallResults(k)[kc.ID] { return "a result returned from another block is not marked" }
	return ""
}

// On AAPCS64 a 32-byte Quad returns through the caller's buffer, so PlanFrame gives
// the returned call no region and records it.
func TestPlanFrameReturnedCall() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), quadResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitCall(e, "mk", noInstrs(), elisionQuadTyp())
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = c
	irbuild.EmitReturn(e, rets)
	var rm @RegMap = NewRegMap(callconv.AAPCS64())
	rm.PlanFrame(f)
	if !rm.CallResultToRetbuf(c.ID) { return "the returned call writes the caller's buffer" }
	if rm.LookupAlloc(c.ID) >= 0 { return "a call writing the caller's buffer has no region" }
	if rm.SretSlotOff < 0 { return "the function keeps its caller's buffer pointer" }
	return ""
}

// Only a direct call returned as is, from a function with one result, is marked: not
// an indirect call, not a call in a function with two results, not a result reaching
// the return through a phi.
func TestReturnedCallResultsNotMarked() testing.TestResult {
	setTarget64()
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), quadResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var fp @ir.Instr = irbuild.EmitConstNil(e, types.MakePointerType(types.TypUint8()))
	var c @ir.Instr = irbuild.EmitCallIndirect(e, fp, noInstrs(), elisionQuadTyp())
	rets[0] = c
	irbuild.EmitReturn(e, rets)
	if ReturnedCallResults(f)[c.ID] { return "an indirect call is not marked" }
	var two @[]@types.Type = make_slice(@types.Type, 2)
	two[0] = elisionQuadTyp()
	two[1] = types.TypInt()
	var g @ir.Func = ir.NewFunc("", "t", elisionNoParams(), two)
	var ge @ir.Block = ir.AddBlock(g, "entry")
	var gc @ir.Instr = irbuild.EmitCall(ge, "mk", noInstrs(), elisionQuadTyp())
	var both @[]@ir.Instr = make_slice(@ir.Instr, 2)
	both[0] = gc
	both[1] = irbuild.EmitConstInt(ge, 1, types.TypInt())
	irbuild.EmitReturn(ge, both)
	if ReturnedCallResults(g)[gc.ID] { return "a function with two results marks nothing" }
	var h @ir.Func = ir.NewFunc("", "t", elisionNoParams(), quadResults())
	var he @ir.Block = ir.AddBlock(h, "entry")
	var hc @ir.Instr = irbuild.EmitCall(he, "mk", noInstrs(), elisionQuadTyp())
	var hb @ir.Block = ir.AddBlock(h, "out")
	irbuild.EmitJump(he, hb)
	var es @[]ir.PhiEntry = make_slice(ir.PhiEntry, 1)
	es[0].Block = he
	es[0].Val = hc
	rets[0] = irbuild.EmitPhi(hb, elisionQuadTyp(), es)
	irbuild.EmitReturn(hb, rets)
	if ReturnedCallResults(h)[hc.ID] {
		return "a result reaching the return through a phi is not marked"
	}
	return ""
}
