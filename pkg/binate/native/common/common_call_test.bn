package "pkg/binate/native/common"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the CallConv-independent helpers in common_call.bn —
// currently just ArgWords (callArgTypes and charSliceEq are internal,
// exercised indirectly by PlanFrame / CalleeUsesCSret tests).

// ArgWords pins the word-count rule: scalars are 1 word; aggregates
// are SizeOf/8 rounded up.  Matters because PlanFrame and every
// CallConv.CallArg* helper feed this into their NGRN bookkeeping —
// an off-by-one here would silently mis-place every aggregate arg.
func TestArgWordsAggregateRoundsUp() testing.TestResult {
	setTarget64()
	// @[]int64 = managed slice = 32 bytes = 4 words on LP64.  Using
	// int64 (not int) so the size is independent of the locked
	// TypInt singleton's host-int width.
	var ms @types.Type = types.MakeManagedSliceType(types.TypInt64())
	if ArgWords(ms) != 4 {
		return "managed slice should be 4 words"
	}
	// Plain pointer (managed-ptr): 1 word.
	if ArgWords(types.TypInt64()) != 1 {
		return "scalar should be 1 word"
	}
	return ""
}

// A 24-byte struct (3 int64s): 3 words — an exact 8-byte multiple, no
// rounding.  The rounding behaviour proper is pinned by
// TestArgWordsNon8MultipleRoundsUp below (sub-word fields pack tight,
// so struct sizes are routinely NOT 8-multiples).  int64 (not int) so
// the field size is host-independent.
func TestArgWordsAggregate3Words() testing.TestResult {
	setTarget64()
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var s @types.Type = types.MakeStructType("Triple", fields)
	if ArgWords(s) != 3 {
		return "24-byte struct should be 3 words"
	}
	return ""
}

// A struct whose size is NOT a multiple of 8 must round UP to the
// next whole word: the eightbyte holding the tail bytes still consumes
// a full register/stack slot.  Sub-word fields pack tight, so this is
// the common case, not an edge case.  Three uint32 = 12 bytes -> 2
// words; a truncating SizeOf/8 yields 1 and silently drops the 3rd
// uint32, which is the struct-param / struct-return three-u32 ABI
// miscompile.  Five uint8 = 5 bytes -> 1 word via ceil(5/8); no floor is
// involved — any NONZERO sub-word struct rounds up to at least 1.  (A
// genuinely zero-size struct is a distinct case: 0 words, pinned by
// TestArgWordsZeroSizeStructIsZero.)
func TestArgWordsNon8MultipleRoundsUp() testing.TestResult {
	setTarget64()
	var f3 @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		f3[i] = make(types.Field)
		f3[i].Type = types.TypUint32()
	}
	var threeU32 @types.Type = types.MakeStructType("ThreeU32", f3)
	if threeU32.SizeOf() != 12 {
		return "three-u32 struct should be 12 bytes"
	}
	if ArgWords(threeU32) != 2 {
		return "12-byte struct should round up to 2 words"
	}
	var f5 @[]@types.Field = make_slice(@types.Field, 5)
	for i := 0; i < 5; i++ {
		f5[i] = make(types.Field)
		f5[i].Type = types.TypUint8()
	}
	var fiveU8 @types.Type = types.MakeStructType("FiveU8", f5)
	if fiveU8.SizeOf() != 5 {
		return "five-u8 struct should be 5 bytes"
	}
	if ArgWords(fiveU8) != 1 {
		return "5-byte struct should be 1 word"
	}
	return ""
}

// A zero-size aggregate (`struct{}` / `[0]T`) is 0 argument words: it
// carries no bytes, so it occupies no register and no stack — matching
// LLVM's zero-register/zero-stack pass of a zero-size struct by value.
// This must NOT clamp up to 1: a min-of-1 floor made a by-value zero-size
// argument (e.g. a `struct{}` method receiver fetched from a slice element)
// consume a word the caller filled from the uninitialized value slot and the
// callee dereferenced — the SIGSEGV in conformance/1029.
func TestArgWordsZeroSizeStructIsZero() testing.TestResult {
	setTarget64()
	var empty @types.Type = types.MakeStructType("Empty", make_slice(@types.Field, 0))
	if empty.SizeOf() != 0 {
		return "empty struct should be 0 bytes"
	}
	if ArgWords(empty) != 0 {
		return "zero-size struct should be 0 words, not clamped to 1"
	}
	return ""
}

// isCallOp must include all five dispatch ops so PlanFrame's
// outgoing-args computation accounts for every call site.  This
// is the bug pinned by conformance/523_closure_many_user_args
// pre-fix: OP_CALL_FUNC_VALUE / OP_CALL_HANDLE / OP_CALL_INDIRECT
// were excluded, so func-value calls with stack-spilled args let
// the closure-struct local overlap the outgoing-args area.
func TestIsCallOpIncludesAllDispatchOps() testing.TestResult {
	if !isCallOp(iropcode.OP_CALL) { return "OP_CALL missing" }
	if !isCallOp(iropcode.OP_C_CALL) { return "OP_C_CALL missing" }
	if !isCallOp(iropcode.OP_CALL_FUNC_VALUE) {
		return "OP_CALL_FUNC_VALUE missing — was the 523 bug"
	}
	if !isCallOp(iropcode.OP_CALL_HANDLE) {
		return "OP_CALL_HANDLE missing"
	}
	if !isCallOp(iropcode.OP_CALL_INDIRECT) {
		return "OP_CALL_INDIRECT missing"
	}
	if !isCallOp(iropcode.OP_CALL_IFACE_METHOD) {
		return "OP_CALL_IFACE_METHOD missing (spilling iface dispatch, §3.10)"
	}
	// Non-call ops must NOT match.
	if isCallOp(iropcode.OP_LOAD) { return "OP_LOAD must not be a call op" }
	if isCallOp(iropcode.OP_STORE) { return "OP_STORE must not be a call op" }
	return ""
}
