package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the CallConv-independent helpers in common_call.bn —
// currently just ArgWords (callArgTypes and charSliceEq are internal,
// exercised indirectly by PlanFrame / CalleeUsesCSret tests).

// ArgWords pins the word-count rule: scalars are 1 word; aggregates
// are SizeOf/8 rounded up.  Matters because PlanFrame and every
// CallConv.CallArg* helper feed this into their NGRN bookkeeping —
// an off-by-one here would silently mis-place every aggregate arg.
func TestArgWordsAggregateRoundsUp() testing.TestResult {
	setTarget64()
	// @[]int64 = managed slice = 32 bytes = 4 words on LP64.  Using
	// int64 (not int) so the size is independent of the locked
	// TypInt singleton's host-int width.
	var ms @types.Type = types.MakeManagedSliceType(types.TypInt64())
	if ArgWords(ms) != 4 {
		return "managed slice should be 4 words"
	}
	// Plain pointer (managed-ptr): 1 word.
	if ArgWords(types.TypInt64()) != 1 {
		return "scalar should be 1 word"
	}
	return ""
}

// A 24-byte struct (3 int64s): 3 words — an exact 8-byte multiple, no
// rounding.  The rounding behaviour proper is pinned by
// TestArgWordsNon8MultipleRoundsUp below (sub-word fields pack tight,
// so struct sizes are routinely NOT 8-multiples).  int64 (not int) so
// the field size is host-independent.
func TestArgWordsAggregate3Words() testing.TestResult {
	setTarget64()
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var s @types.Type = types.MakeStructType("Triple", fields)
	if ArgWords(s) != 3 {
		return "24-byte struct should be 3 words"
	}
	return ""
}

// A struct whose size is NOT a multiple of 8 must round UP to the
// next whole word: the eightbyte holding the tail bytes still consumes
// a full register/stack slot.  Sub-word fields pack tight, so this is
// the common case, not an edge case.  Three uint32 = 12 bytes -> 2
// words; a truncating SizeOf/8 yields 1 and silently drops the 3rd
// uint32, which is the struct-param / struct-return three-u32 ABI
// miscompile.  Five uint8 = 5 bytes -> 1 word; here the round-up and
// the <1 floor agree, but a bare SizeOf/8 = 0 with no floor (as in the
// native return-collect paths) would drop the struct entirely.
func TestArgWordsNon8MultipleRoundsUp() testing.TestResult {
	setTarget64()
	var f3 @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		f3[i] = make(types.Field)
		f3[i].Type = types.TypUint32()
	}
	var threeU32 @types.Type = types.MakeStructType("ThreeU32", f3)
	if threeU32.SizeOf() != 12 {
		return "three-u32 struct should be 12 bytes"
	}
	if ArgWords(threeU32) != 2 {
		return "12-byte struct should round up to 2 words"
	}
	var f5 @[]@types.Field = make_slice(@types.Field, 5)
	for i := 0; i < 5; i++ {
		f5[i] = make(types.Field)
		f5[i].Type = types.TypUint8()
	}
	var fiveU8 @types.Type = types.MakeStructType("FiveU8", f5)
	if fiveU8.SizeOf() != 5 {
		return "five-u8 struct should be 5 bytes"
	}
	if ArgWords(fiveU8) != 1 {
		return "5-byte struct should be 1 word"
	}
	return ""
}

// isCallOp must include all five dispatch ops so PlanFrame's
// outgoing-args computation accounts for every call site.  This
// is the bug pinned by conformance/523_closure_many_user_args
// pre-fix: OP_CALL_FUNC_VALUE / OP_CALL_HANDLE / OP_CALL_INDIRECT
// were excluded, so func-value calls with stack-spilled args let
// the closure-struct local overlap the outgoing-args area.
func TestIsCallOpIncludesAllDispatchOps() testing.TestResult {
	if !isCallOp(iropcode.OP_CALL) { return "OP_CALL missing" }
	if !isCallOp(iropcode.OP_C_CALL) { return "OP_C_CALL missing" }
	if !isCallOp(iropcode.OP_CALL_FUNC_VALUE) {
		return "OP_CALL_FUNC_VALUE missing — was the 523 bug"
	}
	if !isCallOp(iropcode.OP_CALL_HANDLE) {
		return "OP_CALL_HANDLE missing"
	}
	if !isCallOp(iropcode.OP_CALL_INDIRECT) {
		return "OP_CALL_INDIRECT missing"
	}
	if !isCallOp(iropcode.OP_CALL_IFACE_METHOD) {
		return "OP_CALL_IFACE_METHOD missing (spilling iface dispatch, §3.10)"
	}
	// Non-call ops must NOT match.
	if isCallOp(iropcode.OP_LOAD) { return "OP_LOAD must not be a call op" }
	if isCallOp(iropcode.OP_STORE) { return "OP_STORE must not be a call op" }
	return ""
}

// callDispatchArgTypesAnyOp for OP_CALL_FUNC_VALUE: skips Args[0]
// (the func-value) and prepends a TypInt() for the data ptr (the
// hidden RDI / X0 arg the shim consumes).
func TestCallDispatchArgTypesFuncValueScalar() testing.TestResult {
	setTarget64()
	// Build a synthetic OP_CALL_FUNC_VALUE with 3 user args.
	var fv @ir.Instr = make(ir.Instr)
	fv.ID = 1
	fv.Op = iropcode.OP_FUNC_VALUE
	fv.Typ = nil  // doesn't matter for this test
	var a1 @ir.Instr = make(ir.Instr)
	a1.Typ = types.TypInt64()
	var a2 @ir.Instr = make(ir.Instr)
	a2.Typ = types.TypInt64()
	var a3 @ir.Instr = make(ir.Instr)
	a3.Typ = types.TypInt64()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 4)
	args[0] = fv; args[1] = a1; args[2] = a2; args[3] = a3
	var call @ir.Instr = make(ir.Instr)
	call.ID = 9
	call.Op = iropcode.OP_CALL_FUNC_VALUE
	call.Typ = types.TypInt64()  // scalar return
	call.Args = args
	var ts @[]@types.Type =
		callDispatchArgTypesAnyOp(SysV_AMD64(), call)
	// Expect 4: 1 prefix (data ptr) + 3 user args.
	if len(ts) != 4 {
		return "expected 4 dispatch arg types (1 prefix + 3 user)"
	}
	if ts[0] != types.TypInt() {
		return "first slot must be TypInt (the data-ptr slot)"
	}
	return ""
}

// callDispatchArgTypesAnyOp for OP_CALL_INDIRECT: skips Args[0]
// (the function pointer) — no prefix slots, since the emitter
// doesn't prepend any hidden arg.
func TestCallDispatchArgTypesIndirectNoPrefix() testing.TestResult {
	setTarget64()
	var fp @ir.Instr = make(ir.Instr)
	fp.Typ = types.MakePointerType(types.TypInt64())
	var a1 @ir.Instr = make(ir.Instr)
	a1.Typ = types.TypInt64()
	var a2 @ir.Instr = make(ir.Instr)
	a2.Typ = types.TypInt64()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 3)
	args[0] = fp; args[1] = a1; args[2] = a2
	var call @ir.Instr = make(ir.Instr)
	call.ID = 5
	call.Op = iropcode.OP_CALL_INDIRECT
	call.Typ = types.TypInt64()
	call.Args = args
	var ts @[]@types.Type =
		callDispatchArgTypesAnyOp(SysV_AMD64(), call)
	if len(ts) != 2 {
		return "expected 2 dispatch arg types (no prefix; 2 user)"
	}
	return ""
}

// callDispatchArgTypesAnyOp for OP_CALL_IFACE_METHOD: skips Args[0]
// (the interface value) and prepends one TypInt() for the data
// (receiver) pointer the vtable thunk takes as its first arg — so
// PlanFrame sizes the outgoing-args area for a spilling iface dispatch.
// A scalar return adds no sret slot.
func TestCallDispatchArgTypesIfaceMethodScalar() testing.TestResult {
	setTarget64()
	var iv @ir.Instr = make(ir.Instr)
	iv.Typ = nil
	var a1 @ir.Instr = make(ir.Instr)
	a1.Typ = types.TypInt64()
	var a2 @ir.Instr = make(ir.Instr)
	a2.Typ = types.TypInt64()
	var a3 @ir.Instr = make(ir.Instr)
	a3.Typ = types.TypInt64()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 4)
	args[0] = iv; args[1] = a1; args[2] = a2; args[3] = a3
	var call @ir.Instr = make(ir.Instr)
	call.ID = 9
	call.Op = iropcode.OP_CALL_IFACE_METHOD
	call.Typ = types.TypInt64()
	call.Args = args
	var ts @[]@types.Type =
		callDispatchArgTypesAnyOp(SysV_AMD64(), call)
	// 1 prefix (data ptr) + 3 user args.
	if len(ts) != 4 {
		return "expected 4 dispatch arg types (1 data prefix + 3 user)"
	}
	if ts[0] != types.TypInt() {
		return "first slot must be TypInt (the data-ptr slot)"
	}
	return ""
}

// callDispatchArgTypesAnyOp for an OP_CALL_IFACE_METHOD returning a
// >16-byte aggregate via sret: on SysV the sret pointer rides a GP arg
// register (RDI), so the dispatch prepends TWO slots (sret + data ptr)
// ahead of the user args — PlanFrame must size the outgoing-args for
// that.  On AAPCS64 the sret rides X8, off the arg-reg sequence, so the
// prefix stays at 1.  Pins the prefixSlots = 2 branch (added with §3.10)
// that the scalar-return case above does not reach.
func TestCallDispatchArgTypesIfaceMethodSretReturn() testing.TestResult {
	setTarget64()
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	// 24 bytes > InternalSretBytes (16) on either target.
	var big @types.Type = types.MakeStructType("Big24", fields)
	var iv @ir.Instr = make(ir.Instr)
	var a1 @ir.Instr = make(ir.Instr)
	a1.Typ = types.TypInt64()
	var a2 @ir.Instr = make(ir.Instr)
	a2.Typ = types.TypInt64()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 3)
	args[0] = iv; args[1] = a1; args[2] = a2
	var call @ir.Instr = make(ir.Instr)
	call.ID = 9
	call.Op = iropcode.OP_CALL_IFACE_METHOD
	call.Typ = big
	call.Args = args
	// SysV: sret in RDI -> 2 prefix slots + 2 user.
	var sysv @[]@types.Type =
		callDispatchArgTypesAnyOp(SysV_AMD64(), call)
	if len(sysv) != 4 {
		return "SysV sret iface-method: expected 2 prefix (sret+data) + 2 user"
	}
	if sysv[0] != types.TypInt() || sysv[1] != types.TypInt() {
		return "SysV first two slots must be TypInt (sret + data prefix)"
	}
	// AAPCS64: sret in X8 (not an arg slot) -> 1 prefix slot + 2 user.
	var aapcs @[]@types.Type =
		callDispatchArgTypesAnyOp(AAPCS64(), call)
	if len(aapcs) != 3 {
		return "AAPCS64 sret rides X8: expected 1 prefix (data) + 2 user"
	}
	return ""
}

// callDispatchArgTypesAnyOp for a BIG MULTI-RETURN OP_CALL_FUNC_VALUE.  Under
// retbuf-for-any-multi-return the func-value emitter passes a retbuf as a GP arg
// for EVERY multi-return on ALL calling conventions, so the dispatch prepends TWO
// prefix slots (retbuf + data) — INCLUDING AAPCS64, where the retbuf rides X0 as
// a GP arg even for a big tuple (the callee's X8 sret plumbing is internal to the
// shim, not a third prefix slot).  The sizer must match the emitter's
// prefixSlots=2 or PlanFrame under-reserves outgoing-args and a spilled user arg
// overlaps a frame slot (a cross-module silent miscompile).  Regression for the
// big-multi-return func-value under-reservation bug.
func TestCallDispatchArgTypesFuncValueBigMultiReturn() testing.TestResult {
	// Anonymous (int64 x9) tuple = a multi-return that is big (sret) on EVERY
	// target: 9 GP words > NumGpRetRegs on SysV (2) and AAPCS64 (8), and 18 GP
	// words > 4 on ILP32/AAPCS32.  Empty struct name => IsMultiReturnCall.  (9 is
	// the first count that overflows AAPCS64's X0..X7, so this also exercises the
	// gate's inertness for a genuinely-big tuple on aa64.)
	var fields @[]@types.Field = make_slice(@types.Field, 9)
	for i := 0; i < 9; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	var fv @ir.Instr = make(ir.Instr)
	fv.ID = 1
	fv.Op = iropcode.OP_FUNC_VALUE
	var a1 @ir.Instr = make(ir.Instr)
	a1.Typ = types.TypInt64()
	var a2 @ir.Instr = make(ir.Instr)
	a2.Typ = types.TypInt64()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 3)
	args[0] = fv; args[1] = a1; args[2] = a2
	var call @ir.Instr = make(ir.Instr)
	call.ID = 9
	call.Op = iropcode.OP_CALL_FUNC_VALUE
	call.Typ = tuple
	call.Args = args
	setTarget64()
	if !SysV_AMD64().CallReturnsBigMultiReturn(call) {
		return "test setup: tuple must be a big multi-return on SysV"
	}
	// SysV (SretInGpArgReg): 2 prefix (retbuf + data) + 2 user.
	var sysv @[]@types.Type = callDispatchArgTypesAnyOp(SysV_AMD64(), call)
	if len(sysv) != 4 {
		return "SysV big-multi-return func value: expected 2 prefix (retbuf+data) "
			"+ 2 user"
	}
	// AAPCS64: retbuf rides X0 as a GP arg (X8 sret plumbing is internal to the
	// shim), so the prefix is 2 (retbuf + data) + 2 user — same as SysV.
	var aapcs64 @[]@types.Type = callDispatchArgTypesAnyOp(AAPCS64(), call)
	if len(aapcs64) != 4 {
		return "AAPCS64 big-multi-return func value: expected 2 prefix "
			"(retbuf+data) + 2 user"
	}
	// AAPCS32 (SretInGpArgReg): same 2-prefix reservation as SysV.
	setTarget32()
	if !AAPCS32().CallReturnsBigMultiReturn(call) {
		setTarget64()
		return "test setup: tuple must be a big multi-return on AAPCS32"
	}
	var aapcs32 @[]@types.Type = callDispatchArgTypesAnyOp(AAPCS32(), call)
	setTarget64()
	if len(aapcs32) != 4 {
		return "AAPCS32 big-multi-return func value: expected 2 prefix "
			"(retbuf+data) + 2 user"
	}
	return ""
}

// callDispatchArgTypesAnyOp for a SMALL MULTI-RETURN OP_CALL_FUNC_VALUE: (int,
// int) — packable into return registers on every target (2 GP words <=
// NumGpRetRegs everywhere).  Under retbuf-for-any-multi-return the func-value
// emitter passes a retbuf for EVERY multi-return, so the dispatch prepends TWO
// prefix slots (retbuf + data) on ALL calling conventions, INCLUDING AAPCS64 —
// the case the pre-fix gate (SretInGpArgReg-only) got wrong (it left aa64 at 1,
// under-counting outgoing-args for a spilling small-multiret func-value call).
func TestCallDispatchArgTypesFuncValueSmallMultiReturn() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	var fv @ir.Instr = make(ir.Instr)
	fv.ID = 1
	fv.Op = iropcode.OP_FUNC_VALUE
	var a1 @ir.Instr = make(ir.Instr)
	a1.Typ = types.TypInt()
	var a2 @ir.Instr = make(ir.Instr)
	a2.Typ = types.TypInt()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 3)
	args[0] = fv; args[1] = a1; args[2] = a2
	var call @ir.Instr = make(ir.Instr)
	call.ID = 9
	call.Op = iropcode.OP_CALL_FUNC_VALUE
	call.Typ = tuple
	call.Args = args
	setTarget64()
	if SysV_AMD64().CallReturnsBigMultiReturn(call) {
		return "test setup: (int,int) must be a SMALL multi-return on SysV"
	}
	// SysV: 2 prefix (retbuf + data) + 2 user.
	var sysv @[]@types.Type = callDispatchArgTypesAnyOp(SysV_AMD64(), call)
	if len(sysv) != 4 {
		return "SysV small-multi-return func value: expected 2 prefix "
			"(retbuf+data) + 2 user"
	}
	// AAPCS64: also 2 prefix — retbuf rides X0 as a GP arg (small tuple returns
	// field-per-register, stored through retbuf by the shim).  This is the case
	// the old SretInGpArgReg gate left at 1.
	var aapcs64 @[]@types.Type = callDispatchArgTypesAnyOp(AAPCS64(), call)
	if len(aapcs64) != 4 {
		return "AAPCS64 small-multi-return func value: expected 2 prefix "
			"(retbuf+data) + 2 user"
	}
	setTarget32()
	if AAPCS32().CallReturnsBigMultiReturn(call) {
		setTarget64()
		return "test setup: (int,int) must be a SMALL multi-return on AAPCS32"
	}
	var aapcs32 @[]@types.Type = callDispatchArgTypesAnyOp(AAPCS32(), call)
	setTarget64()
	if len(aapcs32) != 4 {
		return "AAPCS32 small-multi-return func value: expected 2 prefix "
			"(retbuf+data) + 2 user"
	}
	return ""
}
