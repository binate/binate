package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the CallConv-independent helpers in common_call.bn —
// currently just ArgWords (callArgTypes and charSliceEq are internal,
// exercised indirectly by PlanFrame / CalleeUsesCSret tests).

// ArgWords pins the word-count rule: scalars are 1 word; aggregates
// are SizeOf/8 rounded up.  Matters because PlanFrame and every
// CallConv.CallArg* helper feed this into their NGRN bookkeeping —
// an off-by-one here would silently mis-place every aggregate arg.
func TestArgWordsAggregateRoundsUp() testing.TestResult {
	setTarget64()
	// @[]int64 = managed slice = 32 bytes = 4 words on LP64.  Using
	// int64 (not int) so the size is independent of the locked
	// TypInt singleton's host-int width.
	var ms @types.Type = types.MakeManagedSliceType(types.TypInt64())
	if ArgWords(ms) != 4 {
		return "managed slice should be 4 words"
	}
	// Plain pointer (managed-ptr): 1 word.
	if ArgWords(types.TypInt64()) != 1 {
		return "scalar should be 1 word"
	}
	return ""
}

// A 24-byte struct (3 int64s): 3 words.  Exercises the round-up
// branch for aggregates whose size isn't a clean 8-byte multiple in
// the next-power-of-two sense — 24 / 8 = 3 exact, no rounding needed
// but the loop is identical to the rounding cases.  An odd-sized
// struct (e.g. 17 bytes = 3 words after round-up to 24) would
// exercise the rounding directly; not needed since real Binate types
// are 8-aligned at the struct level.  int64 (not int) so the field
// size is host-independent.
func TestArgWordsAggregate3Words() testing.TestResult {
	setTarget64()
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var s @types.Type = types.MakeStructType("Triple", fields)
	if ArgWords(s) != 3 {
		return "24-byte struct should be 3 words"
	}
	return ""
}

// isCallOp must include all five dispatch ops so PlanFrame's
// outgoing-args computation accounts for every call site.  This
// is the bug pinned by conformance/523_closure_many_user_args
// pre-fix: OP_CALL_FUNC_VALUE / OP_CALL_HANDLE / OP_CALL_INDIRECT
// were excluded, so func-value calls with stack-spilled args let
// the closure-struct local overlap the outgoing-args area.
func TestIsCallOpIncludesAllDispatchOps() testing.TestResult {
	if !isCallOp(ir.OP_CALL) { return "OP_CALL missing" }
	if !isCallOp(ir.OP_C_CALL) { return "OP_C_CALL missing" }
	if !isCallOp(ir.OP_CALL_FUNC_VALUE) {
		return "OP_CALL_FUNC_VALUE missing — was the 523 bug"
	}
	if !isCallOp(ir.OP_CALL_HANDLE) {
		return "OP_CALL_HANDLE missing"
	}
	if !isCallOp(ir.OP_CALL_INDIRECT) {
		return "OP_CALL_INDIRECT missing"
	}
	// Non-call ops must NOT match.
	if isCallOp(ir.OP_LOAD) { return "OP_LOAD must not be a call op" }
	if isCallOp(ir.OP_STORE) { return "OP_STORE must not be a call op" }
	return ""
}

// callDispatchArgTypesAnyOp for OP_CALL_FUNC_VALUE: skips Args[0]
// (the func-value) and prepends a TypInt() for the data ptr (the
// hidden RDI / X0 arg the shim consumes).
func TestCallDispatchArgTypesFuncValueScalar() testing.TestResult {
	setTarget64()
	// Build a synthetic OP_CALL_FUNC_VALUE with 3 user args.
	var fv @ir.Instr = make(ir.Instr)
	fv.ID = 1
	fv.Op = ir.OP_FUNC_VALUE
	fv.Typ = nil  // doesn't matter for this test
	var a1 @ir.Instr = make(ir.Instr)
	a1.Typ = types.TypInt64()
	var a2 @ir.Instr = make(ir.Instr)
	a2.Typ = types.TypInt64()
	var a3 @ir.Instr = make(ir.Instr)
	a3.Typ = types.TypInt64()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 4)
	args[0] = fv; args[1] = a1; args[2] = a2; args[3] = a3
	var call @ir.Instr = make(ir.Instr)
	call.ID = 9
	call.Op = ir.OP_CALL_FUNC_VALUE
	call.Typ = types.TypInt64()  // scalar return
	call.Args = args
	var ts @[]@types.Type =
		callDispatchArgTypesAnyOp(SysV_AMD64(), call)
	// Expect 4: 1 prefix (data ptr) + 3 user args.
	if len(ts) != 4 {
		return "expected 4 dispatch arg types (1 prefix + 3 user)"
	}
	if ts[0] != types.TypInt() {
		return "first slot must be TypInt (the data-ptr slot)"
	}
	return ""
}

// callDispatchArgTypesAnyOp for OP_CALL_INDIRECT: skips Args[0]
// (the function pointer) — no prefix slots, since the emitter
// doesn't prepend any hidden arg.
func TestCallDispatchArgTypesIndirectNoPrefix() testing.TestResult {
	setTarget64()
	var fp @ir.Instr = make(ir.Instr)
	fp.Typ = types.MakePointerType(types.TypInt64())
	var a1 @ir.Instr = make(ir.Instr)
	a1.Typ = types.TypInt64()
	var a2 @ir.Instr = make(ir.Instr)
	a2.Typ = types.TypInt64()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 3)
	args[0] = fp; args[1] = a1; args[2] = a2
	var call @ir.Instr = make(ir.Instr)
	call.ID = 5
	call.Op = ir.OP_CALL_INDIRECT
	call.Typ = types.TypInt64()
	call.Args = args
	var ts @[]@types.Type =
		callDispatchArgTypesAnyOp(SysV_AMD64(), call)
	if len(ts) != 2 {
		return "expected 2 dispatch arg types (no prefix; 2 user)"
	}
	return ""
}
