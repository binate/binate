package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/types"

// AAPCS64 returns the CallConv for the AArch64 Procedure Call Standard.
// InternalSretBytes matches CExternSretBytes (both 16) so the native
// backend and LLVM-compiled callees agree on register-vs-sret return
// classification at the native↔LLVM boundary (cmd/bnc compiles only
// the main module natively; deps go through LLVM/clang, which follows
// AAPCS-C strictly: aggregates > 16 bytes are returned via X8).
func AAPCS64() CallConv {
	var cc CallConv
	cc.NumGpArgRegs = 8
	cc.NumFpArgRegs = 8
	cc.InternalSretBytes = 16
	cc.CExternSretBytes = 16
	// ≤ 16-byte aggregates pack into ≤ 2 GP arg regs (clang emits
	// `[2 x i64]` for the 16-byte case).  > 16-byte aggregates go
	// through IndirectLargeAggregates (one pointer in 1 reg slot),
	// matching clang's `ptr byval(<T>)` / textbook AAPCS §5.4.2.
	cc.AggregateInRegMax = 16
	cc.StackAlign = 16
	cc.SplitAggregates = true
	cc.IndirectLargeAggregates = true
	return cc
}

// AAPCS64_Darwin extends AAPCS64 with Apple's variadic rule: every
// variadic argument is passed on the stack regardless of remaining
// GP-register budget.  Used by the arm64 backend (which currently
// only emits Mach-O / darwin).  See V-variant helpers below.
func AAPCS64_Darwin() CallConv {
	var cc CallConv = AAPCS64()
	cc.VariadicStackOnly = true
	return cc
}

// SysV_AMD64 returns the CallConv for the System V x86-64 ABI used by
// Linux, macOS, and the BSDs. Defined here so a sibling pkg/binate/native/x64
// backend can construct it without re-declaring the convention.
func SysV_AMD64() CallConv {
	var cc CallConv
	cc.NumGpArgRegs = 6
	cc.NumFpArgRegs = 8
	cc.InternalSretBytes = 16
	cc.CExternSretBytes = 16
	cc.AggregateInRegMax = 16
	cc.StackAlign = 16
	cc.SplitAggregates = false
	// SysV-AMD64 passes the sret buffer in RDI, which is also the
	// first GP arg register — every user arg shifts up by one when
	// the callee returns via sret.  See SretInGpArgReg in common.bni.
	cc.SretInGpArgReg = true
	// pkg/codegen emits a plain `ptr` (no `byval` attribute) for
	// >16-byte aggregate params (see writeParamTypeLLVM), which
	// LLVM x86_64 lowers as "pointer in next free GP arg reg".
	// Native must match — pass the alloca pointer in 1 reg / 1
	// stack word, not the struct contents on the outgoing-args
	// stack.  This diverges from textbook SysV-MEMORY but is
	// consistent with how the LLVM-side code generation now
	// emits these calls.
	cc.IndirectLargeAggregates = true
	return cc
}

// ============================================================
// Call argument dispatch (parameterised by CallConv)
// ============================================================
//
// Per-arg classification is computed by argRegWordsStackWords below,
// which folds two shapes into one helper:
//
//   AAPCS64 (SplitAggregates = true):
//     - NGRN starts at 0.
//     - Scalar: if NGRN < NumGpArgRegs → reg, NGRN += 1, else stack.
//     - Aggregate of N words: if NGRN + N ≤ NumGpArgRegs → spread
//       across NGRN..NGRN+N-1; otherwise place the in-reg-eligible
//       words in NGRN..NumGpArgRegs-1 and the remainder on the stack
//       (SPLIT).  Matches LLVM byval lowering, which native callers of
//       LLVM-compiled callees must match (conformance 337).
//
//   SysV-AMD64 (SplitAggregates = false):
//     - NGRN starts at 0.
//     - Scalar: same as AAPCS.
//     - Aggregate of N words: if size > AggregateInRegMax (=16) or
//       NGRN + N > NumGpArgRegs → MEMORY: entire aggregate on the
//       stack, NGRN unchanged so later args can still take remaining
//       GP regs.  Otherwise fits wholly in regs at NGRN..NGRN+N-1.
//       Matches LLVM's by-value lowering of structs > 16 B on x86_64.
//
// The three exported helpers (CallArgRegStart, CallArgStackOff,
// CallStackBytes) walk the arg list calling argRegWordsStackWords to
// avoid divergence between them.

// argRegWordsStackWords classifies arg k given the running NGRN, and
// returns (regStart, regWords, stackWords): regStart is the first
// arg-reg index (or -1 if fully on stack / float), regWords is how
// many GP arg regs the caller consumes for this arg (NGRN += regWords
// after the call), and stackWords is how many 8-byte stack slots this
// arg writes to the outgoing-args area starting at the current
// running offset.
//
// Float scalars return (-1, 0, 0) — they go in FP regs tracked by a
// separate NSRN counter and don't contribute to the GP/stack tally.
func (cc CallConv) argRegWordsStackWords(t @types.Type, ngrn int) (int, int, int) {
	if IsFloatScalarTyp(t) { return -1, 0, 0 }
	var w int = ArgWords(t)
	var agg bool = IsAggregateTyp(t)
	// Indirect-large path (AAPCS64 / LLVM byval on aa64): aggregates
	// above AggregateInRegMax are passed as a SINGLE pointer arg.
	// Pointer fits in 1 GP arg reg if available; otherwise 1 stack
	// word.  Caller is responsible for placing the struct in its
	// own frame and emitting the LEA / store of the pointer.
	if cc.IndirectLargeAggregates && agg && t.SizeOf() > cc.AggregateInRegMax {
		if ngrn < cc.NumGpArgRegs {
			return ngrn, 1, 0
		}
		return -1, 0, 1
	}
	// SysV MEMORY-by-size: any aggregate larger than AggregateInRegMax
	// goes entirely on the stack regardless of remaining reg budget.
	if !cc.SplitAggregates && agg && t.SizeOf() > cc.AggregateInRegMax {
		return -1, 0, w
	}
	// Fits wholly in remaining GP regs.
	if ngrn + w <= cc.NumGpArgRegs {
		return ngrn, w, 0
	}
	// Doesn't fit.  Three sub-cases:
	//   - AAPCS SPLIT: aggregate straddles regs + stack.
	//   - SysV non-split aggregate: whole aggregate to MEMORY (stack),
	//     NGRN unchanged so later (smaller) args can still take any
	//     remaining regs.
	//   - Scalar overflow (w = 1 with ngrn already at NumGpArgRegs):
	//     single stack word; common to both ABIs.
	if cc.SplitAggregates && agg && ngrn < cc.NumGpArgRegs {
		var regWords int = cc.NumGpArgRegs - ngrn
		return ngrn, regWords, w - regWords
	}
	if !cc.SplitAggregates && agg {
		return -1, 0, w
	}
	return -1, 0, w
}

// argRegWordsStackWordsV applies the darwin variadic rule on top of
// argRegWordsStackWords: a float scalar at a variadic position
// (isVariadic) under VariadicStackOnly is forced to one stack word.
// Apple-arm64 stacks EVERY variadic argument, floats included, where
// argRegWordsStackWords would otherwise place it in an FP register and
// report (-1, 0, 0) — which is why a variadic double silently landed in
// D(NSRN) instead of on the stack.  Non-variadic args and conventions
// without VariadicStackOnly (e.g. SysV-AMD64, where variadic floats DO
// go in XMM) fall through unchanged.
func (cc CallConv) argRegWordsStackWordsV(t @types.Type, ngrn int,
		isVariadic bool) (int, int, int) {
	if isVariadic && cc.VariadicStackOnly && IsFloatScalarTyp(t) {
		return -1, 0, 1
	}
	return cc.argRegWordsStackWords(t, ngrn)
}

// CallArgRegStart returns the first arg-reg index (0..NumGpArgRegs-1)
// for arg i, or -1 if it's passed entirely on the stack. Float scalars
// don't consume GP-register budget and return -1; callers should
// detect floats via IsFloatScalarTyp first and place them in the FP
// register file (tracked separately with an NSRN counter).
func (cc CallConv) CallArgRegStart(argTypes @[]@types.Type, i int) int {
	var ngrn int = 0
	for k := 0; k <= i; k++ {
		rs, rw, _ := cc.argRegWordsStackWords(argTypes[k], ngrn)
		if k == i { return rs }
		ngrn = ngrn + rw
	}
	return -1
}

// CallArgStackOff returns the byte offset into the outgoing-args area
// for arg i's stack portion. Returns -1 if arg i is fully in registers
// (or is a float scalar — those go in FP regs). Returns >=0 when the
// arg has any words on the stack, including the AAPCS SPLIT case (some
// words in regs, overflow on stack at the returned offset) and the
// SysV MEMORY case (entire aggregate at the offset).
func (cc CallConv) CallArgStackOff(argTypes @[]@types.Type, i int) int {
	var ngrn int = 0
	var soff int = 0
	for k := 0; k <= i; k++ {
		_, rw, sw := cc.argRegWordsStackWords(argTypes[k], ngrn)
		if k == i {
			if sw > 0 { return soff }
			return -1
		}
		ngrn = ngrn + rw
		soff = soff + sw * 8
	}
	return -1
}

// CallStackBytes returns the total outgoing-args area size in bytes for
// a call with the given arg types, rounded up to StackAlign. Float
// scalars don't contribute (FP-reg passing only).  Accounts for both
// AAPCS SPLIT semantics (only words past the last GP arg reg count
// toward the stack tally) and SysV MEMORY semantics (the whole
// aggregate counts when it goes to MEMORY).
func (cc CallConv) CallStackBytes(argTypes @[]@types.Type) int {
	var ngrn int = 0
	var soff int = 0
	for k := 0; k < len(argTypes); k++ {
		_, rw, sw := cc.argRegWordsStackWords(argTypes[k], ngrn)
		ngrn = ngrn + rw
		soff = soff + sw * 8
	}
	if cc.StackAlign > 1 && soff % cc.StackAlign != 0 {
		soff = soff + (cc.StackAlign - soff % cc.StackAlign)
	}
	return soff
}

// ============================================================
// Variadic-aware dispatch (V-variants) — Stage 4 of plan-c-call.md
// ============================================================
//
// Mathematically identical to the non-V helpers when fixedCount =
// len(argTypes) (k == fixedCount never holds during the k <= i / k <
// len loop), so non-variadic callers see no behavior change.  The
// arm64 backend instantiates AAPCS64_Darwin() (VariadicStackOnly =
// true) and routes OP_C_CALL through these helpers with fixedCount =
// ins.CFixedArgs, so a variadic arg at value-index >= CFixedArgs is
// forced to the stack per Apple's rule.  Verified green on the
// native lanes by conformance/498 (non-variadic) + 500 (single
// vararg) + 526 (multi-vararg), on both aa64 and x64.

// CallArgRegStartV: see CallArgRegStart.  fixedCount marks the
// fixed/variadic split.
func (cc CallConv) CallArgRegStartV(argTypes @[]@types.Type, i int, fixedCount int) int {
	var ngrn int = 0
	for k := 0; k <= i; k++ {
		if k == fixedCount && cc.VariadicStackOnly {
			ngrn = cc.NumGpArgRegs
		}
		rs, rw, _ := cc.argRegWordsStackWordsV(argTypes[k], ngrn,
			k >= fixedCount)
		if k == i { return rs }
		ngrn = ngrn + rw
	}
	return -1
}

// CallArgStackOffV: see CallArgStackOff.  fixedCount marks the
// fixed/variadic split.
func (cc CallConv) CallArgStackOffV(argTypes @[]@types.Type, i int, fixedCount int) int {
	var ngrn int = 0
	var soff int = 0
	for k := 0; k <= i; k++ {
		if k == fixedCount && cc.VariadicStackOnly {
			ngrn = cc.NumGpArgRegs
		}
		_, rw, sw := cc.argRegWordsStackWordsV(argTypes[k], ngrn,
			k >= fixedCount)
		if k == i {
			if sw > 0 { return soff }
			return -1
		}
		ngrn = ngrn + rw
		soff = soff + sw * 8
	}
	return -1
}

// CallStackBytesV: see CallStackBytes.  fixedCount marks the
// fixed/variadic split.
func (cc CallConv) CallStackBytesV(argTypes @[]@types.Type, fixedCount int) int {
	var ngrn int = 0
	var soff int = 0
	for k := 0; k < len(argTypes); k++ {
		if k == fixedCount && cc.VariadicStackOnly {
			ngrn = cc.NumGpArgRegs
		}
		_, rw, sw := cc.argRegWordsStackWordsV(argTypes[k], ngrn,
			k >= fixedCount)
		ngrn = ngrn + rw
		soff = soff + sw * 8
	}
	if cc.StackAlign > 1 && soff % cc.StackAlign != 0 {
		soff = soff + (cc.StackAlign - soff % cc.StackAlign)
	}
	return soff
}

// ============================================================
// Return classification (parameterised by CallConv)
// ============================================================

// FuncReturnsBigAggregate reports whether f returns a single aggregate
// value larger than cc.InternalSretBytes — the threshold at which the
// calling convention switches from register-packing to sret indirection.
func (cc CallConv) FuncReturnsBigAggregate(f @ir.Func) bool {
	if len(f.Results) != 1 { return false }
	if !IsAggregateTyp(f.Results[0]) { return false }
	return f.Results[0].SizeOf() > cc.InternalSretBytes
}

// CallReturnsBigAggregate is the symmetric predicate for an OP_CALL.
// True when the callee returns a single aggregate above the internal
// sret threshold — the caller must pass the return-buffer pointer in
// the sret register before the call and skip the in-reg return-collect
// afterwards.
func (cc CallConv) CallReturnsBigAggregate(ins @ir.Instr) bool {
	if ins == nil || ins.Typ == nil { return false }
	if IsMultiReturnCall(ins) { return false }
	if !IsAggregateTyp(ins.Typ) { return false }
	return ins.Typ.SizeOf() > cc.InternalSretBytes
}

// FuncReturnsBigMultiReturn reports whether f's multi-return tuple's
// total size exceeds the internal sret threshold. Above the threshold,
// the in-reg packing path would silently drop the tail bytes, so we
// switch to sret indirection: caller passes a buffer pointer, callee
// writes each return value through it at FieldOffset(MultiReturnType, i).
func (cc CallConv) FuncReturnsBigMultiReturn(f @ir.Func) bool {
	if len(f.Results) <= 1 { return false }
	if f.MultiReturnType == nil { return false }
	return f.MultiReturnType.SizeOf() > cc.InternalSretBytes
}

// CallReturnsBigMultiReturn is the symmetric predicate for an OP_CALL
// whose result is a multi-return tuple above the internal sret
// threshold.
func (cc CallConv) CallReturnsBigMultiReturn(ins @ir.Instr) bool {
	if ins == nil || ins.Typ == nil { return false }
	if !IsMultiReturnCall(ins) { return false }
	return ins.Typ.SizeOf() > cc.InternalSretBytes
}

// CalleeUsesCSret reports whether ins (an OP_CALL) targets a C-extern
// callee whose return type triggers the C sret convention (aggregate >
// cc.CExternSretBytes). pkg/binate/codegen emits the LLVM declaration with
// `sret(...)` for these — clang lowers the corresponding C definition
// to take a hidden return-buffer pointer, write the result through it,
// and return void. The native backend must mirror that convention when
// calling into bootstrap.* / libc / etc.
//
// Returns false for internal Binate calls — they use the
// InternalSretBytes threshold via CallReturnsBigAggregate instead.
func (cc CallConv) CalleeUsesCSret(funcs @[]@ir.Func, ins @ir.Instr) bool {
	if ins == nil || ins.Typ == nil { return false }
	if ins.Op != ir.OP_CALL { return false }
	if IsMultiReturnCall(ins) { return false }
	if !IsAggregateTyp(ins.Typ) { return false }
	if ins.Typ.SizeOf() <= cc.CExternSretBytes { return false }
	for i := 0; i < len(funcs); i++ {
		var f @ir.Func = funcs[i]
		if f == nil { continue }
		if !f.IsCExtern { continue }
		if charSliceEq(f.Name, ins.StrVal) { return true }
	}
	return false
}
