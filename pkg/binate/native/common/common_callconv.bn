package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"

// ============================================================
// Call argument dispatch (parameterised by CallConv)
// ============================================================
//
// Per-arg classification is computed by argRegWordsStackWords below,
// which folds two shapes into one helper:
//
//   AAPCS64 (SplitAggregates = true):
//     - NGRN starts at 0.
//     - Scalar: if NGRN < NumGpArgRegs → reg, NGRN += 1, else stack.
//     - Aggregate of N words: if NGRN + N ≤ NumGpArgRegs → spread
//       across NGRN..NGRN+N-1; otherwise place the in-reg-eligible
//       words in NGRN..NumGpArgRegs-1 and the remainder on the stack
//       (SPLIT).  Matches LLVM byval lowering, which native callers of
//       LLVM-compiled callees must match (conformance 337).
//
//   SysV-AMD64 (SplitAggregates = false):
//     - NGRN starts at 0.
//     - Scalar: same as AAPCS.
//     - Aggregate of N words: if size > AggregateInRegMax (=16) or
//       NGRN + N > NumGpArgRegs → MEMORY: entire aggregate on the
//       stack, NGRN unchanged so later args can still take remaining
//       GP regs.  Otherwise fits wholly in regs at NGRN..NGRN+N-1.
//       Matches LLVM's by-value lowering of structs > 16 B on x86_64.
//
// The three exported helpers (CallArgRegStart, CallArgStackOff,
// CallStackBytes) walk the arg list calling argRegWordsStackWords to
// avoid divergence between them.

// argRegWordsStackWords classifies arg k given the running NGRN and NSRN, and
// returns (regStart, regWords, stackWords): regStart is the first GP arg-reg
// index (or -1 if fully on stack / in an FP reg), regWords is how many GP arg
// regs the caller consumes for this arg (NGRN += regWords after the call), and
// stackWords is how many 8-byte stack slots this arg writes to the outgoing-
// args area starting at the current running offset.  A float scalar takes no GP
// reg (regStart -1, regWords 0); it rides an FP reg while NSRN < NumFpArgRegs
// (stackWords 0) and overflows to one 8-byte stack slot beyond that — so the
// walkers MUST track NSRN (incrementing per float scalar) and pass it in.
//
// AggCoercedInReg reports whether t is a NAMED struct/array passed coerced into
// registers by the real ABI (SizeOf in [1, AggregateInRegMax]).  This is the
// case that now rides the func-value DISPATCH convention BY-ADDRESS (one pointer
// word; the per-function shim loads its ArgWords value-words and re-coerces them
// to the underlying's register layout).  Slices / managed-slices / iface-values /
// func-values / anonymous structs are NOT this — they keep their existing
// dispatch representation (an indirect-large one is the IndirectLargeAggregates
// single pointer; a small raw slice / iface value stays its inline words).
func AggCoercedInReg(t @types.Type) bool {
	if !types.AggInRegCoercedKind(t) { return false }
	if t.SizeOf() < 1 { return false }
	return !t.IsByvalParam()
}

// EffectiveArgWords is the number of positional GP/stack words an arg of
// type t occupies in the uniform func-value DISPATCH convention: 1 for any
// aggregate passed BY-ADDRESS — an indirect-large aggregate (a 32-byte
// managed-slice or a >16-byte struct, via IndirectLargeAggregates) OR a coerced
// in-register named struct/array (AggCoercedInReg) — else cc.ArgWords(t) (the
// target-parameterised count, so a 64-bit scalar is 2 words on ILP32).  The shim
// loads + re-marshals the by-address aggregate to the underlying's real ABI.
// Func-value / closure shims MUST use this, not the free (LP64) ArgWords, for
// both their word count and their per-arg register shift: the dispatch caller
// places a by-address arg as ONE pointer word, so counting it as cc.ArgWords
// (managed-slice = 4, a 12B struct = 2) would spuriously overflow the shim's
// register budget and over-advance the shift, misplacing any trailing arg.
func (cc CallConv) EffectiveArgWords(t @types.Type) int {
	if cc.IndirectLargeAggregates && IsAggregateTyp(t) &&
			t.SizeOf() > cc.AggregateInRegMax {
		return 1
	}
	if AggCoercedInReg(t) {
		return 1
	}
	return cc.ArgWords(t)
}

// hfaMemberCount returns the AAPCS64 Homogeneous Floating-point Aggregate member
// count for t — 1-4 when t folds to that many members ALL of the same fundamental
// float type (all float32 xor all float64) — else 0.  Nested structs / arrays of
// float are folded flat; any non-float leaf, a mixed float width, or >4 members
// disqualifies.  Only consulted when cc.HfaAggregates (aa64).
func hfaMemberCount(t @types.Type) int {
	n, _ := HfaClassify(t)
	return n
}

// HfaClassify returns (memberCount, memberByteWidth) for an AAPCS64 Homogeneous
// Floating-point Aggregate — 1-4 same-type float members — else (0, 0).
// memberByteWidth is 4 (a float32 HFA) or 8 (a float64 HFA).  Exported for the
// backend emitters, which place/read the members in memberCount consecutive FP
// registers of memberByteWidth each.
func HfaClassify(t @types.Type) (int, int) {
	n, w := hfaFold(t)
	if n >= 1 && n <= 4 && w > 0 { return n, w / 8 }
	return 0, 0
}

// hfaFold folds a composite into (memberCount, memberWidth): memberWidth is the
// shared float width (32 or 64) if every leaf is that float type, or -1 if any
// leaf is a non-float / the leaves mix widths (disqualifying).  A bare float is
// (1, width); an empty aggregate is (0, -1).
func hfaFold(t @types.Type) (int, int) {
	if t == nil { return 0, -1 }
	t = peelTransparent(t)
	if t.Kind == types.TYP_FLOAT { return 1, t.Width }
	if t.Kind == types.TYP_STRUCT {
		var total int = 0
		var w int = 0
		for i := 0; i < len(t.Fields); i++ {
			cn, cw := hfaFold(t.Fields[i].Type)
			if cn == 0 || cw < 0 { return total + cn, -1 }
			if w == 0 { w = cw } else if w != cw { return total + cn, -1 }
			total = total + cn
			if total > 4 { return total, w }
		}
		if total == 0 { return 0, -1 }
		return total, w
	}
	if t.Kind == types.TYP_ARRAY {
		if t.Elem == nil { return 0, -1 }
		var esz int = t.Elem.SizeOf()
		if esz <= 0 { return 0, -1 }
		var alen int = t.SizeOf() / esz
		cn, cw := hfaFold(t.Elem)
		if cn == 0 || cw < 0 || alen <= 0 { return 0, -1 }
		return cn * alen, cw
	}
	return 0, -1
}

// Float scalars are passed in FP arg registers tracked by a separate NSRN
// counter, so they never take a GP reg.  While the FP file has room
// (nsrn < NumFpArgRegs) a float reports (-1, 0, 0) — no GP, no stack.  Once the
// FP arg registers are exhausted it overflows to the stack like any other arg:
// (-1, 0, 1), one 8-byte stack word.  The caller is responsible for tracking
// NSRN and passing it in (the walkers below do).
func (cc CallConv) argRegWordsStackWords(t @types.Type, ngrn int, nsrn int) (int, int, int) {
	// Hard-float only: a float scalar rides the FP register file (NSRN),
	// never a GP register.  Under soft-float (NumFpArgRegs == 0, e.g.
	// AAPCS32-baremetal) a float is an ordinary GP value of its size, so it
	// falls through to the GP path below.
	if IsFloatScalarTyp(t) && cc.NumFpArgRegs > 0 {
		if nsrn < cc.NumFpArgRegs { return -1, 0, 0 }
		return -1, 0, 1
	}
	// Homogeneous Floating-point Aggregate (AAPCS64 §5.9.5 / §6.4.2): a struct
	// or array folding to 1-4 members ALL of the same float type rides
	// consecutive FP arg registers (v[nsrn]..v[nsrn+n-1]).  All-or-nothing: if
	// the whole HFA does not fit in the remaining FP file it goes ENTIRELY on
	// the stack (never split), and the FP file is closed for later args (the
	// walkers set nsrn = NumFpArgRegs on overflow).  Like a float scalar it
	// reports regStart -1 / no GP; the FP register index comes from NSRN.
	if cc.HfaAggregates && cc.NumFpArgRegs > 0 {
		var hn int = hfaMemberCount(t)
		if hn > 0 {
			if nsrn + hn <= cc.NumFpArgRegs { return -1, 0, 0 }
			return -1, 0, cc.ArgWords(t)
		}
	}
	var w int = cc.ArgWords(t)
	var agg bool = IsAggregateTyp(t)
	// ILP32 double-word alignment (AAPCS §6.5 stage C.3): an 8-byte-aligned
	// argument starts on an EVEN core register — round NCRN up, wasting the
	// odd register.  Inert on LP64 (WordBytes 8, nothing 8-aligned relative
	// to an 8-byte word), so the register start below stays `ngrn` there.
	var start int = ngrn
	if cc.WordBytes < 8 && argNeeds8Align(t) && start % 2 != 0 {
		start = start + 1
	}
	// Indirect-large path (AAPCS64 / LLVM byval on aa64): aggregates
	// above AggregateInRegMax are passed as a SINGLE pointer arg.
	// Pointer fits in 1 GP arg reg if available; otherwise 1 stack
	// word.  Caller is responsible for placing the struct in its
	// own frame and emitting the LEA / store of the pointer.
	if cc.IndirectLargeAggregates && agg && t.SizeOf() > cc.AggregateInRegMax {
		if start < cc.NumGpArgRegs {
			return start, 1, 0
		}
		return -1, 0, 1
	}
	// SysV MEMORY-by-size: any aggregate larger than AggregateInRegMax
	// goes entirely on the stack regardless of remaining reg budget.
	if !cc.SplitAggregates && agg && t.SizeOf() > cc.AggregateInRegMax {
		return -1, 0, w
	}
	// Fits wholly in remaining GP regs (from the padded start).
	if start + w <= cc.NumGpArgRegs {
		return start, w, 0
	}
	// Doesn't fit.  Three sub-cases:
	//   - AAPCS SPLIT: aggregate straddles regs + stack.
	//   - SysV non-split aggregate: whole aggregate to MEMORY (stack),
	//     NGRN unchanged so later (smaller) args can still take any
	//     remaining regs.
	//   - Scalar overflow (w words with start already at NumGpArgRegs,
	//     including an 8-aligned pair pushed past r4 by the pad):
	//     stack words; common to both ABIs.
	if cc.SplitAggregates && agg && start < cc.NumGpArgRegs {
		var regWords int = cc.NumGpArgRegs - start
		return start, regWords, w - regWords
	}
	if !cc.SplitAggregates && agg {
		return -1, 0, w
	}
	return -1, 0, w
}

// advanceNgrn returns the running NCRN after arg k, given its
// classification (rs, rw, sw) and type.  Under an AAPCS-family convention
// (SplitAggregates) a GP-class argument with ANY stack portion saturates
// NCRN to NumGpArgRegs: once an argument spills, every later argument
// spills too (AAPCS §6.5 stage C.6), and any even-pair pad register is
// thereby consumed.  A hard-float float overflowing to the stack does NOT
// consume GP registers, so it is excluded from saturation.  Otherwise the
// NCRN advances past the (possibly pad-shifted) register span rs+rw, or —
// for a value with no GP register (rs < 0) — is left unchanged.  On SysV
// (no split) this reduces to the historical `ngrn + rw`, and on LP64 the
// pad never applies, so both existing backends see identical NCRN walks.
func (cc CallConv) advanceNgrn(t @types.Type, ngrn int, rs int, rw int, sw int) int {
	if sw > 0 && cc.SplitAggregates &&
			!(IsFloatScalarTyp(t) && cc.NumFpArgRegs > 0) &&
			!(cc.HfaAggregates && cc.NumFpArgRegs > 0 && hfaMemberCount(t) > 0) {
		return cc.NumGpArgRegs
	}
	if rs >= 0 {
		return rs + rw
	}
	return ngrn + rw
}

// advanceNsrn returns the NSRN (next FP arg register index) after arg t.  A
// float scalar consumes one FP register; an HFA consumes its member count and,
// on overflow, closes the FP file (AAPCS64: NSRN is set to NumFpArgRegs so a
// later HFA / float scalar cannot use the leftover registers).
func (cc CallConv) advanceNsrn(t @types.Type, nsrn int) int {
	if IsFloatScalarTyp(t) { return nsrn + 1 }
	if cc.HfaAggregates && cc.NumFpArgRegs > 0 {
		var hn int = hfaMemberCount(t)
		if hn > 0 {
			if nsrn + hn <= cc.NumFpArgRegs { return nsrn + hn }
			return cc.NumFpArgRegs
		}
	}
	return nsrn
}

// argRegWordsStackWordsV applies the darwin variadic rule on top of
// argRegWordsStackWords: a float scalar at a variadic position
// (isVariadic) under VariadicStackOnly is forced to one stack word.
// Apple-arm64 stacks EVERY variadic argument, floats included, where
// argRegWordsStackWords would otherwise place it in an FP register and
// report (-1, 0, 0) — which is why a variadic double silently landed in
// D(NSRN) instead of on the stack.  Non-variadic args and conventions
// without VariadicStackOnly (e.g. SysV-AMD64, where variadic floats DO
// go in XMM) fall through unchanged.
func (cc CallConv) argRegWordsStackWordsV(t @types.Type, ngrn int, nsrn int,
		isVariadic bool) (int, int, int) {
	if isVariadic && cc.VariadicStackOnly && IsFloatScalarTyp(t) {
		return -1, 0, 1
	}
	return cc.argRegWordsStackWords(t, ngrn, nsrn)
}

// CallArgRegStart returns the first arg-reg index (0..NumGpArgRegs-1)
// for arg i, or -1 if it's passed entirely on the stack. Float scalars
// don't consume GP-register budget and return -1; callers should
// detect floats via IsFloatScalarTyp first and place them in the FP
// register file (tracked separately with an NSRN counter).
func (cc CallConv) CallArgRegStart(argTypes @[]@types.Type, i int) int {
	var ngrn int = 0
	var nsrn int = 0
	for k := 0; k <= i; k++ {
		rs, rw, sw := cc.argRegWordsStackWords(argTypes[k], ngrn, nsrn)
		if k == i { return rs }
		ngrn = cc.advanceNgrn(argTypes[k], ngrn, rs, rw, sw)
		nsrn = cc.advanceNsrn(argTypes[k], nsrn)
	}
	return -1
}

// StackArgNaturalSize returns the NATURAL byte size (1 / 2 / 4) at which a FIXED
// narrow scalar stack arg packs on a natural-size-stack convention, or 0 when the
// arg takes a rounded 8-byte slot instead.  It is non-zero only when
// NaturalSizeStackArgs is set, the arg is FIXED (not variadic), and it is a
// sub-8-byte non-aggregate scalar (int8 / int16 / int32 / float32 / char / the
// unsigned variants).  Apple's ARM64 ABI packs each such arg at its natural size
// and alignment (int8 → 1, int16 → 2, int32 / float32 → 4); 8-byte scalars,
// aggregates, variadic args, and every arg on non-natural conventions take the
// full 8-byte slot (return 0).  The natural size doubles as the slot's alignment,
// so a natural-size store/load is always scaled-immediate-encodable.
func (cc CallConv) StackArgNaturalSize(t @types.Type, isVariadic bool) int {
	if !cc.NaturalSizeStackArgs || isVariadic || IsAggregateTyp(t) {
		return 0
	}
	var sz int = t.SizeOf()
	if sz < 8 {
		return sz
	}
	return 0
}

// StackArgStoreSize returns the byte width the backend must STORE/LOAD a stack
// arg at — its natural size (1 / 2 / 4) when narrow, else the full 8-byte word.
// The store sites dispatch on this (aarch64.StrSized: 1 → STRB, 2 → STRH,
// 4 → 32-bit STR, 8 → 64-bit STR) so a narrow arg matches the LLVM-compiled
// side and does not overrun its neighbor's natural-sized slot.
func (cc CallConv) StackArgStoreSize(t @types.Type, isVariadic bool) int {
	var n int = cc.StackArgNaturalSize(t, isVariadic)
	if n > 0 {
		return n
	}
	return 8
}

// StackArgNarrow4 reports whether arg t occupies a NATURAL 4-byte stack slot
// (int32 / float32 / uint32 on a natural-size-stack convention).  A convenience
// over StackArgNaturalSize for the float-overflow store path, where the only
// narrow case is float32 (4) vs float64 (8) — there is no sub-4-byte float.
func (cc CallConv) StackArgNarrow4(t @types.Type, isVariadic bool) bool {
	return cc.StackArgNaturalSize(t, isVariadic) == 4
}

// stackArgFootprint returns the (alignment, byte size) of arg t's stack portion,
// where sw is its 8-byte-word count from argRegWordsStackWords.  A narrow arg
// packs at its natural size / natural alignment (int8 → 1, int16 → 2,
// int32 / float32 → 4); everything else keeps sw rounded 8-byte words.
func (cc CallConv) stackArgFootprint(t @types.Type, sw int, isVariadic bool) (int, int) {
	var n int = cc.StackArgNaturalSize(t, isVariadic)
	if n > 0 {
		return n, n
	}
	// A regular stack argument occupies sw WordBytes-sized words at
	// WordBytes alignment; on ILP32 an 8-byte-aligned argument (int64 /
	// double / 8-aligned aggregate) re-aligns its stack offset to 8
	// (AAPCS §6.5 stage C.7).  On LP64 (WordBytes 8) this is the original
	// (8, sw*8).
	var align int = cc.WordBytes
	if cc.WordBytes < 8 && argNeeds8Align(t) {
		align = 8
	}
	return align, sw * cc.WordBytes
}

// alignUpStack rounds n up to the next multiple of a (a power of two >= 1).
func alignUpStack(n int, a int) int {
	if a <= 1 { return n }
	if n % a == 0 { return n }
	return n + (a - n % a)
}

// CallArgStackOff returns the byte offset into the outgoing-args area
// for arg i's stack portion. Returns -1 if arg i is fully in registers
// (or is a float scalar — those go in FP regs). Returns >=0 when the
// arg has any words on the stack, including the AAPCS SPLIT case (some
// words in regs, overflow on stack at the returned offset) and the
// SysV MEMORY case (entire aggregate at the offset).
func (cc CallConv) CallArgStackOff(argTypes @[]@types.Type, i int) int {
	var ngrn int = 0
	var nsrn int = 0
	var soff int = 0
	for k := 0; k <= i; k++ {
		rs, rw, sw := cc.argRegWordsStackWords(argTypes[k], ngrn, nsrn)
		align, bytes := cc.stackArgFootprint(argTypes[k], sw, false)
		if sw > 0 {
			soff = alignUpStack(soff, align)
			if k == i { return soff }
			soff = soff + bytes
		} else if k == i {
			return -1
		}
		ngrn = cc.advanceNgrn(argTypes[k], ngrn, rs, rw, sw)
		nsrn = cc.advanceNsrn(argTypes[k], nsrn)
	}
	return -1
}

// CallStackBytes returns the total outgoing-args area size in bytes for
// a call with the given arg types, rounded up to StackAlign. Float
// scalars don't contribute (FP-reg passing only).  Accounts for both
// AAPCS SPLIT semantics (only words past the last GP arg reg count
// toward the stack tally) and SysV MEMORY semantics (the whole
// aggregate counts when it goes to MEMORY).
func (cc CallConv) CallStackBytes(argTypes @[]@types.Type) int {
	var ngrn int = 0
	var nsrn int = 0
	var soff int = 0
	for k := 0; k < len(argTypes); k++ {
		rs, rw, sw := cc.argRegWordsStackWords(argTypes[k], ngrn, nsrn)
		if sw > 0 {
			align, bytes := cc.stackArgFootprint(argTypes[k], sw, false)
			soff = alignUpStack(soff, align) + bytes
		}
		ngrn = cc.advanceNgrn(argTypes[k], ngrn, rs, rw, sw)
		nsrn = cc.advanceNsrn(argTypes[k], nsrn)
	}
	if cc.StackAlign > 1 && soff % cc.StackAlign != 0 {
		soff = soff + (cc.StackAlign - soff % cc.StackAlign)
	}
	return soff
}
