package "pkg/binate/native/common"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Cross-check that types.SysVArgInMemory (the codegen-side SysV memory-class
// predicate) agrees, for every argument position, with the native x64 walk
// (SysV_AMD64().CallArgRegStart / CallArgStackOff) that this package owns.  The
// two are INDEPENDENT implementations of the SysV all-or-nothing rule — codegen
// consults SysVArgInMemory to emit `byval` for a memory-class straddler, the
// native backend consults its own walk — so they MUST classify identically or
// the native↔LLVM boundary silently diverges again.  A battery of signatures
// pins the agreement; if the native walk ever changes, this test breaks.

// amNativeMemAgg reports whether the native SysV walk places arg i wholly in
// memory as a ≤16-byte aggregate: it has NO register portion (CallArgRegStart <
// 0) yet occupies stack (CallArgStackOff >= 0), and it is a ≤16-byte aggregate
// (so it is the straddle case, not a >16 indirect pointer that also lands on the
// stack, nor an in-register / all-SSE-in-XMM value with no stack portion).
func amNativeMemAgg(cc CallConv, argTypes @[]@types.Type, i int) bool {
	if !IsAggregateTyp(argTypes[i]) { return false }
	if argTypes[i].SizeOf() > 16 { return false }
	return cc.CallArgRegStart(argTypes, i) < 0 && cc.CallArgStackOff(argTypes, i) >= 0
}

// amCheckSig asserts SysVArgInMemory == amNativeMemAgg for every index of one
// signature; returns "" on agreement or a describing failure message.
func amCheckSig(cc CallConv, argTypes @[]@types.Type, name *[]readonly char) @[]char {
	for i := 0; i < len(argTypes); i++ {
		if types.SysVArgInMemory(argTypes, i) != amNativeMemAgg(cc, argTypes, i) {
			return AppendStr(
					AppendStr(make_slice(char, 0), "SysVArgInMemory disagrees with the native walk in signature "),
					name)
		}
	}
	return ""
}

// amStruct2 builds a named 2-field struct (a 16-byte {t0,t1} when both fields
// are 8-byte).
func amStruct2(name @[]char, t0 @types.Type, t1 @types.Type) @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 2)
	fs[0] = make(types.Field)
	fs[0].Type = t0
	fs[1] = make(types.Field)
	fs[1].Type = t1
	return types.MakeStructType(name, fs)
}

// amStruct3 builds a named 3-field struct (a 24-byte {i64,i64,i64} => >16).
func amStruct3(name @[]char, t0 @types.Type, t1 @types.Type, t2 @types.Type) @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 3)
	fs[0] = make(types.Field)
	fs[0].Type = t0
	fs[1] = make(types.Field)
	fs[1].Type = t1
	fs[2] = make(types.Field)
	fs[2].Type = t2
	return types.MakeStructType(name, fs)
}

// TestSysVArgInMemoryMatchesNativeWalk pins SysVArgInMemory against the native
// SysV walk across GP straddles, slices / iface-values (2-word aggregates that
// straddle like a 16-byte struct), SSE aggregates, >16 indirect pointers, and
// prefix (sret / data-ptr) positions.
func TestSysVArgInMemoryMatchesNativeWalk() testing.TestResult {
	setTarget64()
	types.SetArch(types.ARCH_X64)
	var cc CallConv = SysV_AMD64()

	var i64 @types.Type = types.TypInt64()
	var f64 @types.Type = types.TypFloat64()
	var ptr @types.Type = types.MakePointerType(types.TypUint8())
	var i2 @types.Type = amStruct2("I2", i64, i64) // 16B, 2 INTEGER eightbytes
	var slice @types.Type = types.MakeSliceType(i64) // 16B raw slice
	var iface @types.Type = types.MakeInterfaceValueType(types.MakeInterfaceType("m", "Iface")) // 16B
	var big @types.Type = amStruct3("Big24", i64, i64, i64) // 24B => >16, indirect
	var sseIF @types.Type = amStruct2("IF", i64, f64) // 1 INTEGER + 1 SSE eightbyte

	// isum5 shape: [dataPtr, i64,i64,i64,i64, I2,I2,I2].  After dataPtr(RDI) + 4
	// i64 (RSI,RDX,RCX,R8) NGRN=5, so each I2 straddles (R9 alone) => all three
	// in memory.
	var isum5 @[]@types.Type = make_slice(@types.Type, 8)
	isum5[0] = ptr
	isum5[1] = i64
	isum5[2] = i64
	isum5[3] = i64
	isum5[4] = i64
	isum5[5] = i2
	isum5[6] = i2
	isum5[7] = i2
	var e1 @[]char = amCheckSig(cc, isum5, "isum5")
	if len(e1) > 0 { return e1 }
	if !types.SysVArgInMemory(isum5, 5) { return "isum5 arg5 (I2) must be memory" }
	if !types.SysVArgInMemory(isum5, 7) { return "isum5 arg7 (I2) must be memory" }
	if types.SysVArgInMemory(isum5, 1) { return "isum5 arg1 (i64) must NOT be memory" }

	// dsum shape: [i64(lead), I2,I2,I2,I2].  lead->RDI(1); p1->RSI,RDX(3);
	// p2->RCX,R8(5); p3 straddles R9 => memory; p4 => memory.
	var dsum @[]@types.Type = make_slice(@types.Type, 5)
	dsum[0] = i64
	dsum[1] = i2
	dsum[2] = i2
	dsum[3] = i2
	dsum[4] = i2
	var e2 @[]char = amCheckSig(cc, dsum, "dsum")
	if len(e2) > 0 { return e2 }
	if types.SysVArgInMemory(dsum, 1) { return "dsum p1 must fit in regs (not memory)" }
	if types.SysVArgInMemory(dsum, 2) { return "dsum p2 must fit in regs (not memory)" }
	if !types.SysVArgInMemory(dsum, 3) { return "dsum p3 must straddle => memory" }
	if !types.SysVArgInMemory(dsum, 4) { return "dsum p4 => memory" }

	// Slice straddle: [i64 x5, slice].  NGRN=5 then slice (2 words) straddles.
	var sl @[]@types.Type = make_slice(@types.Type, 6)
	for i := 0; i < 5; i++ { sl[i] = i64 }
	sl[5] = slice
	var e3 @[]char = amCheckSig(cc, sl, "sliceStraddle")
	if len(e3) > 0 { return e3 }
	if !types.SysVArgInMemory(sl, 5) { return "slice straddle must be memory" }

	// Iface-value straddle: [i64 x5, iface].
	var ifv @[]@types.Type = make_slice(@types.Type, 6)
	for i := 0; i < 5; i++ { ifv[i] = i64 }
	ifv[5] = iface
	var e4 @[]char = amCheckSig(cc, ifv, "ifaceStraddle")
	if len(e4) > 0 { return e4 }
	if !types.SysVArgInMemory(ifv, 5) { return "iface-value straddle must be memory" }

	// >16 indirect pointer: [i64 x5, big24, i64].  big24 rides a pointer in R9
	// (fits), so it is NOT memory; a later i64 spills to the stack but is not an
	// aggregate.
	var bg @[]@types.Type = make_slice(@types.Type, 7)
	for i := 0; i < 5; i++ { bg[i] = i64 }
	bg[5] = big
	bg[6] = i64
	var e5 @[]char = amCheckSig(cc, bg, "big24")
	if len(e5) > 0 { return e5 }
	if types.SysVArgInMemory(bg, 5) { return "big24 (>16) rides a pointer, not memory" }

	// SSE aggregate forced to memory: [i64 x6, {i64,f64}].  GP file full (6), the
	// INTEGER eightbyte cannot be placed => whole aggregate memory.
	var se @[]@types.Type = make_slice(@types.Type, 7)
	for i := 0; i < 6; i++ { se[i] = i64 }
	se[6] = sseIF
	var e6 @[]char = amCheckSig(cc, se, "sseMem")
	if len(e6) > 0 { return e6 }
	if !types.SysVArgInMemory(se, 6) { return "SSE agg with GP file full => memory" }

	// SSE aggregate that fits: [i64 x4, {i64,f64}].  INTEGER eightbyte -> R8, SSE
	// eightbyte -> XMM0: in-register, not memory.
	var sf @[]@types.Type = make_slice(@types.Type, 5)
	for i := 0; i < 4; i++ { sf[i] = i64 }
	sf[4] = sseIF
	var e7 @[]char = amCheckSig(cc, sf, "sseFit")
	if len(e7) > 0 { return e7 }
	if types.SysVArgInMemory(sf, 4) { return "SSE agg that fits must NOT be memory" }

	return ""
}
