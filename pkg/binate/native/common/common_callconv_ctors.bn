package "pkg/binate/native/common"

import "pkg/binate/types"

// CallConv constructors for each supported ABI: AAPCS64 (+ its Darwin variadic
// variant), SysV-AMD64, and AAPCS32.  Each returns a CallConv value carrying the
// register counts, sret thresholds, alignment, and word size for that
// convention.  The classification engine that consumes them (argRegWordsStackWords,
// CallArgRegStart, CallArgStackOff, CallStackBytes, ...) lives in
// common_callconv.bn.

// AAPCS64 returns the CallConv for the AArch64 Procedure Call Standard.
// InternalSretBytes matches CExternSretBytes (both 16) so the native
// backend and LLVM-compiled callees agree on register-vs-sret return
// classification at the native↔LLVM boundary (cmd/bnc compiles only
// the main module natively; deps go through LLVM/clang, which follows
// AAPCS-C strictly: aggregates > 16 bytes are returned via X8).
func AAPCS64() CallConv {
	var cc CallConv
	cc.NumGpArgRegs = 8
	cc.NumFpArgRegs = 8
	cc.NumGpRetRegs = 8
	cc.NumFpRetRegs = 8
	// aarch64 has no x87 stack; its 8 D return regs already cover every
	// in-register float tuple, so no overflow slots.
	cc.NumX87RetRegs = 0
	cc.InternalSretBytes = 16
	cc.CExternSretBytes = 16
	// ≤ 16-byte aggregates pack into ≤ 2 GP arg regs (clang emits
	// `[2 x i64]` for the 16-byte case).  > 16-byte aggregates go
	// through IndirectLargeAggregates (one pointer in 1 reg slot),
	// matching clang's `ptr byval(<T>)` / textbook AAPCS §5.4.2.
	cc.AggregateInRegMax = 16
	cc.StackAlign = 16
	cc.SplitAggregates = true
	cc.IndirectLargeAggregates = true
	// AAPCS64 §6.4.2: a Homogeneous Floating-point Aggregate (a struct/array
	// folding to 1-4 same-type float members) is passed in consecutive SIMD
	// argument registers, not as a GP aggregate.  The classifier (types.HfaClassify
	// + the NSRN walkers) and the aa64 caller/callee emitters implement that.
	//
	// HFA passing is an ABI CONTRACT shared across the whole toolchain — the LLVM
	// backend (which compiles every dependency package under `-backend native`),
	// the native emitters, the dispatch shims (func-value / closure / interface),
	// and the variadic NSRN walkers must all classify HFAs identically or they
	// mismarshal (wrong data / SIGSEGV) at the boundaries between them.  So the
	// decision is driven by the ONE shared gate types.HfaInSimd() rather than a
	// per-backend flag, keeping every half in lockstep.  It is false today (HFAs
	// are GP-coerced everywhere); flipping it flips codegen and native together.
	// See explorations/plan-hfa-crossbackend.md.
	cc.HfaAggregates = types.HfaInSimd()
	cc.WordBytes = 8
	return cc
}

// AAPCS64_Darwin extends AAPCS64 with Apple's variadic rule: every
// variadic argument is passed on the stack regardless of remaining
// GP-register budget.  Used by the arm64 backend (which currently
// only emits Mach-O / darwin).  See V-variant helpers below.
func AAPCS64_Darwin() CallConv {
	var cc CallConv = AAPCS64()
	cc.VariadicStackOnly = true
	// Apple's ARM64 ABI packs FIXED narrow scalar stack args at their natural
	// size (int32 / float32 = 4 bytes), unlike textbook AAPCS64 / SysV which
	// round every stack arg up to 8.
	cc.NaturalSizeStackArgs = true
	return cc
}

// SysV_AMD64 returns the CallConv for the System V x86-64 ABI used by
// Linux, macOS, and the BSDs. Defined here so a sibling pkg/binate/native/x64
// backend can construct it without re-declaring the convention.
func SysV_AMD64() CallConv {
	var cc CallConv
	cc.NumGpArgRegs = 6
	cc.NumFpArgRegs = 8
	cc.NumGpRetRegs = 3
	cc.NumFpRetRegs = 2
	// A first-class-aggregate multi-return's 3rd and 4th float fields come
	// back in x87 ST0/ST1 (LLVM lowering, empirically dumped); the native
	// x64 pack/collect emits FLD/FSTP for those slots.  5+ floats sret.
	cc.NumX87RetRegs = 2
	cc.InternalSretBytes = 16
	cc.CExternSretBytes = 16
	cc.AggregateInRegMax = 16
	cc.StackAlign = 16
	cc.SplitAggregates = false
	// SysV-AMD64 passes the sret buffer in RDI, which is also the
	// first GP arg register — every user arg shifts up by one when
	// the callee returns via sret.  See SretInGpArgReg in common.bni.
	cc.SretInGpArgReg = true
	// pkg/codegen emits a plain `ptr` (no `byval` attribute) for
	// >16-byte aggregate params (see writeParamTypeLLVM), which
	// LLVM x86_64 lowers as "pointer in next free GP arg reg".
	// Native must match — pass the alloca pointer in 1 reg / 1
	// stack word, not the struct contents on the outgoing-args
	// stack.  This diverges from textbook SysV-MEMORY but is
	// consistent with how the LLVM-side code generation now
	// emits these calls.
	cc.IndirectLargeAggregates = true
	cc.WordBytes = 8
	// A <=16-byte float aggregate rides SSE eightbytes (each 8-byte chunk in an
	// XMM or a GP reg by SysV class), matching the LLVM-side coercion.  Gated on
	// the shared cross-backend gate (mirrors AAPCS64's HfaAggregates =
	// HfaInSimd()); dormant while types.SysVSseInRegs() is off.  The per-eightbyte
	// placement lives in pkg/binate/native/x64.
	cc.SseAggregates = types.SysVSseInRegs()
	return cc
}

// AAPCS32 returns the base (soft-float) 32-bit ARM AAPCS/EABI CallConv
// used by the arm32-baremetal target.  Key differences from AAPCS64:
//
//   - WordBytes = 4 (ILP32): a 64-bit scalar is 2 GP words, a 16-byte
//     managed-slice is 4.
//   - 4 GP arg registers (r0-r3) and 4 GP return registers — LLVM
//     returns a first-class-aggregate multi-return in r0-r3.
//   - Soft-float: NumFpArgRegs / NumFpRetRegs = 0, so a float rides the GP
//     registers (classified as an ordinary GP value of its size) and a
//     float tuple field counts toward the GP return budget.
//   - A composite larger than 4 bytes is returned via an sret pointer
//     (InternalSretBytes / CExternSretBytes = 4), unlike AAPCS64's 16.
//     The sret buffer pointer travels in R0 (the first GP arg register),
//     so a >4-byte return shifts every user arg up by one register
//     (R0 = sret ptr, param0 → R1, ...) — SretInGpArgReg models that,
//     exactly as SysV-AMD64 does with RDI.
//   - SplitAggregates = true (a <=16-byte aggregate straddles r0-r3 and
//     the stack); IndirectLargeAggregates = true (a >16-byte aggregate is
//     passed as a single pointer in the next GP reg).  The latter matches
//     codegen's UNIFORM plain-`ptr` lowering of >16-byte byval params on
//     every target (writeParamTypeLLVM / types.IsByvalParam's flat
//     SizeOf>16 cutoff), NOT textbook AAPCS "aggregate by value" — the
//     native↔LLVM boundary is what governs, and there a >16-byte struct
//     arrives as a pointer-in-register regardless of arch.
//   - 8-byte-aligned arguments obey the even-register-pair / 8-aligned
//     stack-slot rule via argNeeds8Align (AAPCS §6.5 stage C.3), handled
//     in argRegWordsStackWords / stackArgFootprint.
//
// The register-count / sret-threshold numbers are pinned against
// clang -target arm-none-eabi -mfloat-abi=soft: a first-class-aggregate
// (multi-return) return fills up to 4 core registers (r0-r3) before it
// sret's (NumGpRetRegs=4, empirically {i32 x4} in-reg / {i32 x5} sret,
// mirroring AAPCS64's first-class rule not the C >4-byte rule); a single
// composite >4 bytes is sret (InternalSretBytes=4, matching
// types.NeedsSret's ILP32 threshold).  The native AAPCS32 word-packing
// here (4-aligned WordBytes-sized words, argNeeds8Align only for
// genuinely 8-aligned aggregates) matches clang's `[N x i32]` coercion of
// a <=16-byte aggregate: a naturally-4-aligned struct after a leading
// scalar starts on the odd register (r1) with NO even-register bump.  The
// LLVM boundary agrees because codegen's aggCoerceLLTy is target-aware —
// it emits `[N x i32]` (4-aligned) on ILP32, matching this packing,
// instead of the 8-aligned `[N x i64]` it uses on LP64.  A hard-float VFP
// variant (arm32-linux) is a later addition.
func AAPCS32() CallConv {
	var cc CallConv
	cc.NumGpArgRegs = 4
	cc.NumFpArgRegs = 0
	cc.NumGpRetRegs = 4
	cc.NumFpRetRegs = 0
	cc.NumX87RetRegs = 0
	cc.InternalSretBytes = 4
	cc.CExternSretBytes = 4
	cc.AggregateInRegMax = 16
	cc.StackAlign = 8
	cc.SplitAggregates = true
	cc.IndirectLargeAggregates = true
	// AAPCS32 passes the sret buffer pointer in R0, which is also the
	// first GP arg register — every user arg shifts up by one when the
	// callee returns via sret.  This is SIZING-ONLY: it makes
	// callDispatchArgTypes prepend the synthetic sret slot so PlanFrame's
	// outgoing-args reservation counts it (otherwise a big-aggregate-return
	// call that also spills args past R3 under-counts, and the call's stack
	// tail overlaps the caller's own sret stash at SP+SretSlotOff).  The
	// register assignment shift itself is applied emitter-side (arm32_call /
	// arm32_emit_func / arm32_return).  See SretInGpArgReg in common.bni.
	cc.SretInGpArgReg = true
	cc.WordBytes = 4
	// Hard-float (AAPCS-VFP, arm32-linux) overrides: floats ride the VFP
	// register file instead of GP.  Gated on the ONE shared gate
	// types.Arm32HardFloat() (mirroring AAPCS64's HfaAggregates = HfaInSimd()),
	// so this same flip reaches the native arm32 backend AND codegen's
	// callConvForTarget() in lockstep.  INERT today: no target is stamped
	// FLOAT_ABI_HARD, so Arm32HardFloat() is false everywhere and AAPCS32() is
	// byte-identical to the soft-float convention above.  When the native
	// arm32-linux mode is brought up (plan-native-arm32.md P6), that increment
	// adds the classifier's AAPCS-VFP register back-fill and the emitter's
	// FP-register arg/return movement, and pins NumFpRetRegs empirically against
	// clang's literal-FCA return lowering — 4 here is the AAPCS-VFP
	// homogeneous-float-aggregate return cap (d0..d3), to be confirmed then.
	if types.Arm32HardFloat() {
		cc.NumFpArgRegs = 8
		cc.NumFpRetRegs = 4
		cc.HfaAggregates = true
		// AAPCS-VFP allocates float scalar args by the co-processor-register-
		// candidate rule (lowest-free-S-slot with back-fill + a stack-poison
		// latch over the shared s0..s15 = d0..d7 bank), not the monotonic NSRN
		// cursor — see common_callconv_vfp.bn.  aa64/x64/soft-float leave this
		// false and keep the unchanged NSRN path.
		cc.VfpBackfill = true
	}
	return cc
}
