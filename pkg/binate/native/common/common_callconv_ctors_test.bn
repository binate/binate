package "pkg/binate/native/common"

import "pkg/builtins/testing"

// Constructor pins for the per-ABI CallConv factories in
// common_callconv_ctors.bn: AAPCS64 (+ its Darwin variadic variant),
// SysV-AMD64, and AAPCS32.  Each test asserts the register counts, sret
// thresholds, alignment, split/indirect flags, and word size that the
// argument-dispatch classifier (tested in common_callconv_test.bn) reads.
// A wrong constant here is an ABI mismatch at the native↔LLVM boundary.

func TestAAPCS64Constants() testing.TestResult {
	var cc CallConv = AAPCS64()
	if cc.NumGpArgRegs != 8 {
		return "AAPCS64 should advertise 8 GP arg regs"
	}
	if cc.NumFpArgRegs != 8 {
		return "AAPCS64 should advertise 8 FP arg regs"
	}
	if cc.InternalSretBytes != 16 {
		return "AAPCS64 internal sret threshold should be 16 (match AAPCS-C for native↔LLVM agreement)"
	}
	if cc.CExternSretBytes != 16 {
		return "AAPCS64 C-extern sret threshold should be 16"
	}
	if cc.AggregateInRegMax != 16 {
		return "AAPCS64 aggregate-in-reg max should be 16 (textbook AAPCS § 5.4.2)"
	}
	if cc.StackAlign != 16 {
		return "AAPCS64 stack align should be 16"
	}
	if !cc.SplitAggregates {
		return "AAPCS64 should allow aggregate reg/stack split for ≤ AggregateInRegMax"
	}
	if !cc.IndirectLargeAggregates {
		return "AAPCS64 should use indirect-pointer-pass for > AggregateInRegMax"
	}
	if cc.NumX87RetRegs != 0 {
		return "AAPCS64 has no x87 — NumX87RetRegs should be 0"
	}
	return ""
}

// AAPCS64_Darwin is AAPCS64 plus Apple's two divergences: every variadic
// arg goes on the stack (VariadicStackOnly) and fixed narrow stack args
// keep their natural size (NaturalSizeStackArgs).  It must otherwise
// inherit AAPCS64's register counts / word size unchanged.
func TestAAPCS64DarwinConstants() testing.TestResult {
	var cc CallConv = AAPCS64_Darwin()
	if !cc.VariadicStackOnly {
		return "AAPCS64_Darwin should pass every variadic arg on the stack"
	}
	if !cc.NaturalSizeStackArgs {
		return "AAPCS64_Darwin should keep fixed narrow stack args at natural size"
	}
	if cc.NumGpArgRegs != 8 {
		return "AAPCS64_Darwin should inherit AAPCS64's 8 GP arg regs"
	}
	if cc.WordBytes != 8 {
		return "AAPCS64_Darwin should inherit AAPCS64's 8-byte word"
	}
	return ""
}

func TestSysVAMD64Constants() testing.TestResult {
	var cc CallConv = SysV_AMD64()
	if cc.NumGpArgRegs != 6 {
		return "SysV-AMD64 should advertise 6 GP arg regs"
	}
	if cc.NumFpArgRegs != 8 {
		return "SysV-AMD64 should advertise 8 FP arg regs"
	}
	if cc.InternalSretBytes != 16 {
		return "SysV-AMD64 internal sret threshold should be 16"
	}
	if cc.CExternSretBytes != 16 {
		return "SysV-AMD64 C-extern sret threshold should be 16"
	}
	if cc.AggregateInRegMax != 16 {
		return "SysV-AMD64 aggregate-in-reg max should be 16"
	}
	if cc.StackAlign != 16 {
		return "SysV-AMD64 stack align should be 16"
	}
	if cc.SplitAggregates {
		return "SysV-AMD64 must NOT split aggregates (no split for ≤ 16 B)"
	}
	if !cc.IndirectLargeAggregates {
		return "SysV-AMD64 should pass large aggregates indirect "
			"(pkg/codegen emits plain ptr — pointer-pass)"
	}
	if cc.NumX87RetRegs != 2 {
		return "SysV-AMD64 returns the 3rd/4th multi-return float in x87 "
			"ST0/ST1 — NumX87RetRegs should be 2"
	}
	return ""
}

func TestWordBytesSetByConstructors() testing.TestResult {
	if AAPCS64().WordBytes != 8 { return "AAPCS64 WordBytes should be 8" }
	if AAPCS64_Darwin().WordBytes != 8 { return "AAPCS64_Darwin WordBytes should be 8" }
	if SysV_AMD64().WordBytes != 8 { return "SysV-AMD64 WordBytes should be 8" }
	if AAPCS32().WordBytes != 4 { return "AAPCS32 WordBytes should be 4" }
	return ""
}

func TestAAPCS32Constants() testing.TestResult {
	var cc CallConv = AAPCS32()
	if cc.NumGpArgRegs != 4 {
		return "AAPCS32 should advertise 4 GP arg regs (r0-r3)"
	}
	if cc.NumFpArgRegs != 0 {
		return "AAPCS32 (soft-float) should have 0 FP arg regs"
	}
	if cc.NumGpRetRegs != 4 {
		return "AAPCS32 should return first-class aggregates in r0-r3 (4 GP ret regs)"
	}
	if cc.NumFpRetRegs != 0 {
		return "AAPCS32 (soft-float) should have 0 FP ret regs"
	}
	if cc.InternalSretBytes != 4 {
		return "AAPCS32 composite >4 bytes returns via sret (threshold 4)"
	}
	if cc.CExternSretBytes != 4 {
		return "AAPCS32 C-extern sret threshold should be 4"
	}
	if cc.StackAlign != 8 {
		return "AAPCS32 stack align should be 8"
	}
	if !cc.SplitAggregates {
		return "AAPCS32 splits aggregates across regs + stack"
	}
	if !cc.IndirectLargeAggregates {
		return "AAPCS32 passes a >16-byte aggregate as a pointer-in-reg "
			"(matches codegen's uniform plain-ptr byval lowering)"
	}
	if cc.WordBytes != 4 {
		return "AAPCS32 WordBytes should be 4 (ILP32)"
	}
	return ""
}
