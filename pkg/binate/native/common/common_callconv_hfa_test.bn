package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for ReturnsHfaInRegs (common_callconv_return.bn) — the return-side HFA
// classifier — and the HFA exemption it feeds into FuncReturnsBigAggregate.
// The predicate is gated on cc.HfaAggregates (= types.HfaInSimd(), dormant), so
// these force the field on directly to exercise the classification logic
// independent of the global gate.

// floatStruct builds a named struct of n float64 members (an HFA of n members).
func floatStruct(name @[]char, n int) @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		fs[i] = make(types.Field)
		fs[i].Type = types.TypFloat64()
	}
	return types.MakeStructType(name, fs)
}

// ReturnsHfaInRegs classifies a single float AGGREGATE result as an HFA
// returned in D0..D3.  The AggInRegCoercedKind guard is load-bearing: a bare
// float scalar folds as a 1-member HFA, so without it a plain float64 return
// would be misclassified and the emitter would deref the scalar's value as a
// pointer (this crashed a float-returning function under the flip).
func TestReturnsHfaInRegsClassification() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	cc.HfaAggregates = true  // force the classifier on (the global gate is dormant)
	// A bare float64 scalar is NOT an HFA aggregate return.
	if cc.ReturnsHfaInRegs(types.TypFloat64()) {
		return "a bare float64 scalar must NOT classify as an HFA-in-regs return"
	}
	// {f64,f64} (16B) and {f64,f64,f64} (24B) both ARE.
	if !cc.ReturnsHfaInRegs(floatStruct("D2", 2)) {
		return "{f64,f64} should classify as an HFA-in-regs return"
	}
	if !cc.ReturnsHfaInRegs(floatStruct("D3", 3)) {
		return "{f64,f64,f64} (24B) should classify as an HFA-in-regs return"
	}
	// A {i64,i64} struct is NOT (non-float members).
	var ipf @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		ipf[i] = make(types.Field)
		ipf[i].Type = types.TypInt64()
	}
	if cc.ReturnsHfaInRegs(types.MakeStructType("IP", ipf)) {
		return "a {i64,i64} struct must NOT classify as an HFA-in-regs return"
	}
	// Dormant: with HfaAggregates off (the landed default), always false.
	var off CallConv = AAPCS64()
	if off.ReturnsHfaInRegs(floatStruct("D2", 2)) {
		return "dormant: ReturnsHfaInRegs must be false while HfaAggregates is off"
	}
	return ""
}

// A >16-byte HFA (3x/4x f64 = 24/32B) is exempt from sret — it rides D0..D3
// (v0..v3), unlike a same-size non-float aggregate which sret's above 16 bytes.
func TestFuncReturnsBigAggregateHfaExempt() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	cc.HfaAggregates = true
	var f4 @ir.Func = ir.NewFunc("", "mk4", makeNoParams(), makeNoResults())
	f4.Results = make_slice(@types.Type, 1)
	f4.Results[0] = floatStruct("D4", 4)  // 32 bytes
	if cc.FuncReturnsBigAggregate(f4) {
		return "a 32-byte HFA must be exempt from sret (rides D0..D3)"
	}
	// With HfaAggregates off (dormant), the same 32-byte struct DOES sret.
	var off CallConv = AAPCS64()
	var f4b @ir.Func = ir.NewFunc("", "mk4b", makeNoParams(), makeNoResults())
	f4b.Results = make_slice(@types.Type, 1)
	f4b.Results[0] = floatStruct("D4", 4)
	if !off.FuncReturnsBigAggregate(f4b) {
		return "dormant: a 32-byte aggregate must still sret while HfaAggregates is off"
	}
	return ""
}
