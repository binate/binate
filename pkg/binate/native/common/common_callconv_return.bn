package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"

// ============================================================
// Return classification (parameterised by CallConv)
// ============================================================

// ReturnsHfaInRegs reports whether a single result of type t is a Homogeneous
// Floating-point Aggregate returned in consecutive FP return registers (D0..D3
// on aa64), NOT GP-packed and NOT via sret.  Gated on cc.HfaAggregates (=
// types.HfaInSimd()), so dormant until the cross-backend HFA gate flips.
//
// The AggInRegCoercedKind guard (a NAMED struct or array — matching codegen's
// types.hfaSimdAggregate) is LOAD-BEARING, not redundant: HfaMemberCount is 1
// for a bare float SCALAR (a scalar float folds as a 1-member HFA), so without
// it a plain `float64` return would be misclassified as an HFA and the emitter
// would deref the scalar's value as a pointer.  It also excludes the anonymous
// multi-return tuple.  This is the same predicate the LLVM backend uses, so the
// two halves classify HFAs identically at the native<->LLVM boundary.
func (cc CallConv) ReturnsHfaInRegs(t @types.Type) bool {
	return cc.HfaAggregates && cc.NumFpRetRegs > 0 &&
		types.AggInRegCoercedKind(t) && types.HfaMemberCount(t) > 0
}

// ReturnsSseInRegs reports whether a single result of type t is a SysV-AMD64
// SSE aggregate returned with its SSE eightbytes in the FP return registers
// (XMM0/XMM1) and its INTEGER eightbytes in the GP return registers (RAX/RDX),
// NOT GP-packed into RAX/RDX wholesale.  The x64 analogue of ReturnsHfaInRegs,
// gated on cc.SseAggregates (= types.SysVSseInRegs()).  Unlike an aa64 HFA (which
// can exceed 16 bytes yet ride D0..D3), an x64 SSE aggregate is always <=16 bytes,
// so it is ALREADY exempt from sret by size — this predicate only tells the x64
// return emitter to pack XMM/GP by eightbyte class rather than RAX/RDX wholesale.
// Dormant while cc.SseAggregates is false.
func (cc CallConv) ReturnsSseInRegs(t @types.Type) bool {
	return cc.SseAggregates && cc.NumFpRetRegs > 0 && types.SysVAggHasSse(t)
}

// FuncReturnsBigAggregate reports whether f returns a single aggregate
// value larger than cc.InternalSretBytes — the threshold at which the
// calling convention switches from register-packing to sret indirection.
func (cc CallConv) FuncReturnsBigAggregate(f @ir.Func) bool {
	if len(f.Results) != 1 { return false }
	if !IsAggregateTyp(f.Results[0]) { return false }
	// An HFA rides D0..D3 regardless of size (a 4x f64 HFA is 32 bytes yet
	// still returns in v0..v3), so it is never sret'd.
	if cc.ReturnsHfaInRegs(f.Results[0]) { return false }
	return f.Results[0].SizeOf() > cc.InternalSretBytes
}

// CallReturnsBigAggregate is the symmetric predicate for an OP_CALL.
// True when the callee returns a single aggregate above the internal
// sret threshold — the caller must pass the return-buffer pointer in
// the sret register before the call and skip the in-reg return-collect
// afterwards.
func (cc CallConv) CallReturnsBigAggregate(ins @ir.Instr) bool {
	if ins == nil || ins.Typ == nil { return false }
	if IsMultiReturnCall(ins) { return false }
	if !IsAggregateTyp(ins.Typ) { return false }
	// An HFA result comes back in D0..D3, never sret (mirrors
	// FuncReturnsBigAggregate on the callee side).
	if cc.ReturnsHfaInRegs(ins.Typ) { return false }
	return ins.Typ.SizeOf() > cc.InternalSretBytes
}

// MultiReturnTupleNeedsSret applies the target's register-vs-sret rule to a
// multi-return tuple type, matching how the LLVM-compiled callees (the deps at
// the native↔LLVM boundary) lower a first-class IR aggregate return.  LLVM
// lowers such a return PURELY FIELD-PER-REGISTER-BY-CLASS, with no eightbyte
// coalescing and NOT by the 16-byte single-aggregate rule: each non-float
// field's words fill the GP return regs (X0..X7 / RAX,RDX,RCX), each
// float-scalar field fills the FP return regs (D0..D7 / XMM0,XMM1), the two
// counters independent; when EITHER class overflows its register budget, the
// whole tuple goes sret.  So the rule is register-COUNT, not size:
//
//   * AAPCS64 / aa64: 8 GP + 8 FP — `(int,@errors.Error)` is 24 bytes (3 GP
//     words) yet comes back in X0,X1,X2 (conformance/526), and `{i64 x 9}` is
//     the first GP shape that sret's.  (The old SizeOf>16 rule wrongly sret'd
//     every 17..64-byte tuple, disagreeing with the LLVM-compiled callee.)
//
//   * SysV-AMD64 / x64: 3 GP + 2 FP (XMM0,XMM1) + 2 x87 (ST0,ST1) —
//     `(i64,i64,i64)` is in-register (RAX,RDX,RCX) while `(u16,u16,u16,u16)`
//     is 8 bytes yet sret (4 GP regs); a 3rd/4th float comes back in x87
//     ST0/ST1 (the native x64 pack/collect emits FLD/FSTP), so the FP-class
//     capacity is NumFpRetRegs + NumX87RetRegs (= 4) and a tuple sret's only
//     at fpCount>4.
//
// Register counts (NumGpRetRegs / NumFpRetRegs / NumX87RetRegs) are
// per-target.  Empirically dumped via clang on hand-written .ll.
func (cc CallConv) MultiReturnTupleNeedsSret(t @types.Type) bool {
	var gpWords int = 0
	var fpCount int = 0
	for fi := 0; fi < len(t.Fields); fi++ {
		var ft @types.Type = t.Fields[fi].Type
		// Soft-float (NumFpRetRegs == 0, AAPCS32) returns a float tuple
		// field in GP registers, so count it toward the GP budget; a
		// hard-float target counts it against the FP return registers.
		if IsFloatScalarTyp(ft) && cc.NumFpRetRegs > 0 {
			fpCount = fpCount + 1
		} else {
			gpWords = gpWords + cc.ArgWords(ft)
		}
	}
	return gpWords > cc.NumGpRetRegs ||
		fpCount > cc.NumFpRetRegs + cc.NumX87RetRegs
}

// FuncReturnsBigMultiReturn reports whether f's multi-return tuple is returned
// via sret (a hidden buffer pointer the caller passes and the callee writes
// each field through at FieldOffset) rather than in registers — per the
// target's register-vs-sret rule (see MultiReturnTupleNeedsSret).
func (cc CallConv) FuncReturnsBigMultiReturn(f @ir.Func) bool {
	if len(f.Results) <= 1 { return false }
	if f.MultiReturnType == nil { return false }
	return cc.MultiReturnTupleNeedsSret(f.MultiReturnType)
}

// CallReturnsBigMultiReturn is the symmetric predicate for an OP_CALL whose
// result is a multi-return tuple returned via sret.
func (cc CallConv) CallReturnsBigMultiReturn(ins @ir.Instr) bool {
	if ins == nil || ins.Typ == nil { return false }
	if !IsMultiReturnCall(ins) { return false }
	return cc.MultiReturnTupleNeedsSret(ins.Typ)
}

// CalleeUsesCSret reports whether ins (an OP_CALL) targets a C-extern
// callee whose return type triggers the C sret convention (aggregate >
// cc.CExternSretBytes). pkg/binate/codegen emits the LLVM declaration with
// `sret(...)` for these — clang lowers the corresponding C definition
// to take a hidden return-buffer pointer, write the result through it,
// and return void. The native backend must mirror that convention when
// calling into bootstrap.* / libc / etc.
//
// Returns false for internal Binate calls — they use the
// InternalSretBytes threshold via CallReturnsBigAggregate instead.
func (cc CallConv) CalleeUsesCSret(funcs @[]@ir.Func, ins @ir.Instr) bool {
	if ins == nil || ins.Typ == nil { return false }
	if ins.Op != iropcode.OP_CALL { return false }
	if IsMultiReturnCall(ins) { return false }
	if !IsAggregateTyp(ins.Typ) { return false }
	if ins.Typ.SizeOf() <= cc.CExternSretBytes { return false }
	for i := 0; i < len(funcs); i++ {
		var f @ir.Func = funcs[i]
		if f == nil { continue }
		if !f.IsCExtern { continue }
		if charSliceEq(f.Name, ins.StrVal) { return true }
	}
	return false
}
