// 24-byte struct trips sret under both AAPCS64 and SysV (both
// thresholds are 16); the native↔LLVM boundary thus agrees.
func TestCallReturnsBigAggregateThresholdAgrees() testing.TestResult {
	setTarget64()
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var t @types.Type = types.MakeStructType("Triple", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CALL
	ins.Typ = t
	var sysv CallConv = SysV_AMD64()
	if !sysv.CallReturnsBigAggregate(ins) {
		return "24-byte struct should be sret under SysV-AMD64 (>16)"
	}
	var aapcs CallConv = AAPCS64()
	if !aapcs.CallReturnsBigAggregate(ins) {
		return "24-byte struct should be sret under AAPCS64 (>16)"
	}
	return ""
}

// ============================================================
// FuncReturnsBigMultiReturn
// ============================================================

// (int, int) tuple = 2 GP words → reg-packed under AAPCS64 (X0,X1).
// AAPCS64 register-returns a multi-return tuple up to 8 GP + 8 FP regs
// (see TestAapcs64MultiReturnRegisterCountThreshold), sret'ing only when
// a class overflows.
func TestFuncReturnsBigMultiReturnAapcs64BelowThreshold() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var tupleFields @[]@types.Field = make_slice(@types.Field, 2)
	tupleFields[0] = make(types.Field)
	tupleFields[0].Type = types.TypInt()
	tupleFields[1] = make(types.Field)
	tupleFields[1].Type = types.TypInt()
	var tuple @types.Type = types.MakeStructType("", tupleFields)
	var f @ir.Func = ir.NewFunc("", "multi", makeNoParams(), makeNoResults())
	f.Results = make_slice(@types.Type, 2)
	f.Results[0] = types.TypInt()
	f.Results[1] = types.TypInt()
	f.MultiReturnType = tuple
	if cc.FuncReturnsBigMultiReturn(f) {
		return "16-byte tuple should NOT trip AAPCS64 sret (≤16)"
	}
	return ""
}

// 9-int multi-return tuple = 9 GP words > 8 → sret under AAPCS64 (the
// first GP shape that overflows X0..X7).
func TestFuncReturnsBigMultiReturnAapcs64Above() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var fields @[]@types.Field = make_slice(@types.Field, 9)
	for i := 0; i < 9; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	var f @ir.Func = ir.NewFunc("", "multi9", makeNoParams(), makeNoResults())
	f.Results = make_slice(@types.Type, 9)
	for i := 0; i < 9; i++ { f.Results[i] = types.TypInt64() }
	f.MultiReturnType = tuple
	if !cc.FuncReturnsBigMultiReturn(f) {
		return "72-byte tuple SHOULD trip AAPCS64 sret (>64)"
	}
	return ""
}

// Single-result funcs are not multi-returns; predicate must be false.
func TestFuncReturnsBigMultiReturnSingleResultFalse() testing.TestResult {
	var cc CallConv = AAPCS64()
	var f @ir.Func = ir.NewFunc("", "getInt", makeNoParams(), makeNoResults())
	f.Results = make_slice(@types.Type, 1)
	f.Results[0] = types.TypInt()
	if cc.FuncReturnsBigMultiReturn(f) {
		return "single-result func is not a multi-return"
	}
	return ""
}

// mkMrFunc builds a multi-return ir.Func whose MultiReturnType is the
// anonymous struct of fieldTypes (helper for the SysV threshold test).
func mkMrFunc(fieldTypes @[]@types.Type) @ir.Func {
	var n int = len(fieldTypes)
	var fields @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = fieldTypes[i]
	}
	var f @ir.Func = ir.NewFunc("", "mr", makeNoParams(), makeNoResults())
	f.Results = make_slice(@types.Type, n)
	for i := 0; i < n; i++ { f.Results[i] = fieldTypes[i] }
	f.MultiReturnType = types.MakeStructType("", fields)
	return f
}

// SysV-AMD64 multi-return uses the register-count rule (field-per-register, no
// eightbyte coalescing): in-register up to 3 GP-class fields (RAX,RDX,RCX) +
// 4 FP-class fields (XMM0,XMM1 then x87 ST0,ST1), sret beyond.  This differs
// from AAPCS64's SizeOf rule: (i64,i64,i64) is 24 bytes yet in-register, while
// a 4th GP word or a 5th float spills the whole tuple to sret (claude-todo
// #112).  The 3rd/4th float lands in x87 ST0/ST1 (the native x64 pack/collect
// emits FLD/FSTP for those), which is why the FP cap is 4, not 2.
func TestSysVMultiReturnRegisterCountThreshold() testing.TestResult {
	setTarget64()
	var cc CallConv = SysV_AMD64()
	// 3 GP fields (24 bytes) — in-register (RAX,RDX,RCX), NOT sret despite >16B.
	var g3 @[]@types.Type = make_slice(@types.Type, 3)
	for i := 0; i < 3; i++ { g3[i] = types.TypInt64() }
	if cc.FuncReturnsBigMultiReturn(mkMrFunc(g3)) {
		return "SysV (i64,i64,i64) = 3 GP regs should be in-register, not sret"
	}
	// 4 GP fields — sret (> 3 GP return regs).
	var g4 @[]@types.Type = make_slice(@types.Type, 4)
	for i := 0; i < 4; i++ { g4[i] = types.TypInt64() }
	if !cc.FuncReturnsBigMultiReturn(mkMrFunc(g4)) {
		return "SysV (i64 x4) = 4 GP regs should be sret"
	}
	// 2 FP fields — in-register (XMM0,XMM1).
	var f2 @[]@types.Type = make_slice(@types.Type, 2)
	for i := 0; i < 2; i++ { f2[i] = types.TypFloat64() }
	if cc.FuncReturnsBigMultiReturn(mkMrFunc(f2)) {
		return "SysV (f64,f64) = 2 FP regs should be in-register, not sret"
	}
	// 3 FP fields — in-register (XMM0,XMM1 + x87 ST0).
	var f3 @[]@types.Type = make_slice(@types.Type, 3)
	for i := 0; i < 3; i++ { f3[i] = types.TypFloat64() }
	if cc.FuncReturnsBigMultiReturn(mkMrFunc(f3)) {
		return "SysV (f64,f64,f64) = 2 XMM + 1 x87 should be in-register, not sret"
	}
	// 4 FP fields — in-register (XMM0,XMM1 + x87 ST0,ST1), the last all-in-
	// register float shape.
	var f4 @[]@types.Type = make_slice(@types.Type, 4)
	for i := 0; i < 4; i++ { f4[i] = types.TypFloat64() }
	if cc.FuncReturnsBigMultiReturn(mkMrFunc(f4)) {
		return "SysV (f64 x4) = 2 XMM + 2 x87 should be in-register, not sret"
	}
	// 5 FP fields — sret (> 2 XMM + 2 x87 = 4 FP slots).
	var f5 @[]@types.Type = make_slice(@types.Type, 5)
	for i := 0; i < 5; i++ { f5[i] = types.TypFloat64() }
	if !cc.FuncReturnsBigMultiReturn(mkMrFunc(f5)) {
		return "SysV (f64 x5) = 5 FP fields should be sret (> 4 FP slots)"
	}
	// Mixed 3 GP + 3 FP — both within budget (RAX,RDX,RCX + XMM0,XMM1,ST0),
	// in-register; pins that the GP and FP counters are independent.
	var mix @[]@types.Type = make_slice(@types.Type, 6)
	for i := 0; i < 3; i++ { mix[i] = types.TypInt64() }
	for i := 3; i < 6; i++ { mix[i] = types.TypFloat64() }
	if cc.FuncReturnsBigMultiReturn(mkMrFunc(mix)) {
		return "SysV (i64x3,f64x3) = 3 GP + 3 FP should be in-register"
	}
	return ""
}

// AAPCS64 multi-return uses the register-count rule too (field-per-register-
// by-class), NOT the 16-byte single-aggregate rule: LLVM lowers a first-class
// IR aggregate return into up to 8 GP (X0..X7) + 8 FP (D0..D7) return regs,
// sret'ing only when a class overflows.  The decisive case is conformance/526:
// a cross-package `(int64, @errors.Error)` is 24 bytes (3 GP words — int64 plus
// the 2-word managed iface value) yet comes back in X0,X1,X2.  The old
// SizeOf>16 rule wrongly sret'd it, disagreeing with the LLVM-compiled callee
// (which register-returns it) → garbage err + corrupt scalar at the boundary.
func TestAapcs64MultiReturnRegisterCountThreshold() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	// The 526 shape: (int64, @Iface).  The iface value is a 2-word
	// aggregate field, so the tuple is 1 + 2 = 3 GP words → in-register,
	// NOT sret.  Pins the exact regression.
	var ivTyp @types.Type = make(types.Type)
	ivTyp.Kind = types.TYP_INTERFACE_VALUE_MANAGED
	var mr526 @[]@types.Type = make_slice(@types.Type, 2)
	mr526[0] = types.TypInt64()
	mr526[1] = ivTyp
	if cc.FuncReturnsBigMultiReturn(mkMrFunc(mr526)) {
		return "AAPCS64 (int64,@Iface) = 3 GP words (the 526 case) must be in-register, not sret"
	}
	// Discriminating boundary: (int64 x7, @Iface) = 7 + 2 = 9 GP words → sret.
	// This fails if the iface value is mis-counted as 1 word (7 + 1 = 8 ≤ 8
	// would wrongly read in-register) — so it pins the iface's 2-word
	// contribution, which the bare in-register check above cannot.
	var mrEdge @[]@types.Type = make_slice(@types.Type, 8)
	for i := 0; i < 7; i++ { mrEdge[i] = types.TypInt64() }
	mrEdge[7] = ivTyp
	if !cc.FuncReturnsBigMultiReturn(mkMrFunc(mrEdge)) {
		return "AAPCS64 (int64 x7, @Iface) = 9 GP words (iface is 2 words) must be sret"
	}
	// 8 GP fields (64 bytes) — the last all-in-register shape (X0..X7).
	var g8 @[]@types.Type = make_slice(@types.Type, 8)
	for i := 0; i < 8; i++ { g8[i] = types.TypInt64() }
	if cc.FuncReturnsBigMultiReturn(mkMrFunc(g8)) {
		return "AAPCS64 (i64 x8) = 8 GP regs must be in-register (X0..X7)"
	}
	// 9 GP fields — the first sret shape (> 8 GP return regs).
	var g9 @[]@types.Type = make_slice(@types.Type, 9)
	for i := 0; i < 9; i++ { g9[i] = types.TypInt64() }
	if !cc.FuncReturnsBigMultiReturn(mkMrFunc(g9)) {
		return "AAPCS64 (i64 x9) = 9 GP words must be sret"
	}
	// 8 FP fields — in-register (D0..D7); 9 spills to sret.
	var fp8 @[]@types.Type = make_slice(@types.Type, 8)
	for i := 0; i < 8; i++ { fp8[i] = types.TypFloat64() }
	if cc.FuncReturnsBigMultiReturn(mkMrFunc(fp8)) {
		return "AAPCS64 (f64 x8) = 8 FP regs must be in-register (D0..D7)"
	}
	var fp9 @[]@types.Type = make_slice(@types.Type, 9)
	for i := 0; i < 9; i++ { fp9[i] = types.TypFloat64() }
	if !cc.FuncReturnsBigMultiReturn(mkMrFunc(fp9)) {
		return "AAPCS64 (f64 x9) = 9 FP fields must be sret"
	}
	// The GP and FP counters are independent: 8 GP + 8 FP both fit, in-register.
	var both @[]@types.Type = make_slice(@types.Type, 16)
	for i := 0; i < 8; i++ { both[i] = types.TypInt64() }
	for i := 8; i < 16; i++ { both[i] = types.TypFloat64() }
	if cc.FuncReturnsBigMultiReturn(mkMrFunc(both)) {
		return "AAPCS64 8 GP + 8 FP must be in-register (counters independent)"
	}
	return ""
}

// ============================================================
// CallReturnsBigMultiReturn
// ============================================================

// 9-int tuple call = 72 bytes; predicate fires under AAPCS64 because
// the call's Typ is the anonymous-struct tuple recognized by
// IsMultiReturnCall (Name="").
func TestCallReturnsBigMultiReturnAapcs64Above() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var fields @[]@types.Field = make_slice(@types.Field, 9)
	for i := 0; i < 9; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CALL
	ins.Typ = tuple
	if !cc.CallReturnsBigMultiReturn(ins) {
		return "72-byte tuple call SHOULD trip AAPCS64 sret"
	}
	return ""
}

// (int, int) tuple = 2 GP words ≤ 8; predicate must NOT fire.
func TestCallReturnsBigMultiReturnAapcs64BelowFalse() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CALL
	ins.Typ = tuple
	if cc.CallReturnsBigMultiReturn(ins) {
		return "16-byte tuple call should NOT trip AAPCS64 sret"
	}
	return ""
}

// Non-multi-return call (named struct return) must never trip the
// predicate even if the type is large — that's CallReturnsBigAggregate's
// job, not this one.  IsMultiReturnCall returns false for named struct
// types.
func TestCallReturnsBigMultiReturnNamedStructFalse() testing.TestResult {
	var cc CallConv = AAPCS64()
	var fields @[]@types.Field = make_slice(@types.Field, 10)
	for i := 0; i < 10; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var named @types.Type = types.MakeStructType("Big", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CALL
	ins.Typ = named
	if cc.CallReturnsBigMultiReturn(ins) {
		return "named struct return is not a multi-return tuple"
	}
	return ""
}

// ============================================================
// CalleeUsesCSret
// ============================================================
//
// CalleeUsesCSret applies the C-ABI threshold (>16 bytes) to
// IsCExtern callees specifically — distinct from the
// CallReturnsBigAggregate path that handles general aggregate
// returns.  pkg/binate/codegen emits LLVM `sret(...)` for IsCExtern
// callees with aggregate returns >16 bytes, so the caller must
// pass a hidden buffer pointer to match.

func TestCalleeUsesCSretConcat() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	// C-extern returning @[]char (32 bytes via X8 sret on AAPCS).
	var f @ir.Func = ir.NewFunc("", "pkg/binate/buf.Concat", makeNoParams(), makeNoResults())
	f.IsCExtern = true
	f.Results = make_slice(@types.Type, 1)
	f.Results[0] = types.MakeManagedSliceType(types.TypChar())
	var funcs @[]@ir.Func = make_slice(@ir.Func, 1)
	funcs[0] = f
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "pkg/binate/buf.Concat"
	ins.Typ = types.MakeManagedSliceType(types.TypChar())
	if !cc.CalleeUsesCSret(funcs, ins) {
		return "C-extern @[]char (32 bytes) return should trigger sret"
	}
	return ""
}

func TestCalleeUsesCSretInternalBinateNo() testing.TestResult {
	var cc CallConv = AAPCS64()
	// Internal Binate function with the same return type — does NOT
	// use C sret. (CallReturnsBigAggregate handles the internal
	// threshold separately.)
	var f @ir.Func = ir.NewFunc("", "local", makeNoParams(), makeNoResults())
	f.IsCExtern = false
	f.Results = make_slice(@types.Type, 1)
	f.Results[0] = types.MakeManagedSliceType(types.TypChar())
	var funcs @[]@ir.Func = make_slice(@ir.Func, 1)
	funcs[0] = f
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "local"
	ins.Typ = types.MakeManagedSliceType(types.TypChar())
	if cc.CalleeUsesCSret(funcs, ins) {
		return "internal Binate call should NOT trigger C sret"
	}
	return ""
}

// C-extern returning a 16-byte raw slice — at the threshold; the rule
// is "> 16", so 16-byte returns stay reg-packed.
func TestCalleeUsesCSretSmallReturnNo() testing.TestResult {
	var cc CallConv = AAPCS64()
	var f @ir.Func = ir.NewFunc("", "pkg/libc.readBytes", makeNoParams(), makeNoResults())
	f.IsCExtern = true
	f.Results = make_slice(@types.Type, 1)
	f.Results[0] = types.MakeSliceType(types.TypUint8())
	var funcs @[]@ir.Func = make_slice(@ir.Func, 1)
	funcs[0] = f
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "pkg/libc.readBytes"
	ins.Typ = types.MakeSliceType(types.TypUint8())
	if cc.CalleeUsesCSret(funcs, ins) {
		return "16-byte return should NOT use C sret"
	}
	return ""
}

// CallConv-independent: AAPCS64 and SysV-AMD64 both happen to use the
// same C-extern threshold (16 bytes), so a C-extern returning the
// same 24-byte struct triggers C sret under both — but for different
// CExternSretBytes-derived reasons. Pin the equality so a future
// SysV-only threshold tweak doesn't silently desync.
func TestCalleeUsesCSretSysVAgreesAtSixteen() testing.TestResult {
	setTarget64()
	var sysv CallConv = SysV_AMD64()
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var s @types.Type = types.MakeStructType("Triple", fields)
	var f @ir.Func = ir.NewFunc("", "pkg/libc.x", makeNoParams(), makeNoResults())
	f.IsCExtern = true
	f.Results = make_slice(@types.Type, 1)
	f.Results[0] = s
	var funcs @[]@ir.Func = make_slice(@ir.Func, 1)
	funcs[0] = f
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "pkg/libc.x"
	ins.Typ = s
	if !sysv.CalleeUsesCSret(funcs, ins) {
		return "24-byte C-extern return should trigger SysV C sret (>16)"
	}
	return ""
}

// ============================================================
// AAPCS32 (32-bit ARM, base soft-float) return classification
// ============================================================

// AAPCS32 multi-return uses the register-count rule against 4 GP ret regs;
// soft-float folds float fields into the GP count.
func TestAapcs32MultiReturnRegisterCount() testing.TestResult {
	setTarget32()
	var cc CallConv = AAPCS32()
	var g2 @[]@types.Type = make_slice(@types.Type, 2)
	g2[0] = types.TypInt32()
	g2[1] = types.TypInt32()
	if cc.FuncReturnsBigMultiReturn(mkMrFunc(g2)) {
		return "AAPCS32 (int32,int32) = 2 GP words should be in-register"
	}
	var g4 @[]@types.Type = make_slice(@types.Type, 4)
	for i := 0; i < 4; i++ { g4[i] = types.TypInt32() }
	if cc.FuncReturnsBigMultiReturn(mkMrFunc(g4)) {
		return "AAPCS32 (int32 x4) = 4 GP words should be in-register (r0-r3)"
	}
	// 5 GP words is the first sret shape — pins the exact r0-r3 boundary
	// (clang -target arm-none-eabi: {i32 x4} returns in r0-r3, {i32 x5} sret).
	var g5 @[]@types.Type = make_slice(@types.Type, 5)
	for i := 0; i < 5; i++ { g5[i] = types.TypInt32() }
	if !cc.FuncReturnsBigMultiReturn(mkMrFunc(g5)) {
		return "AAPCS32 (int32 x5) = 5 GP words should be sret (> 4 GP ret regs)"
	}
	var g3 @[]@types.Type = make_slice(@types.Type, 3)
	for i := 0; i < 3; i++ { g3[i] = types.TypInt64() }
	if !cc.FuncReturnsBigMultiReturn(mkMrFunc(g3)) {
		return "AAPCS32 (int64 x3) = 6 GP words should be sret"
	}
	var f3 @[]@types.Type = make_slice(@types.Type, 3)
	for i := 0; i < 3; i++ { f3[i] = types.TypFloat64() }
	if !cc.FuncReturnsBigMultiReturn(mkMrFunc(f3)) {
		return "AAPCS32 (float64 x3) = 6 GP words (soft-float) should be sret"
	}
	var f2 @[]@types.Type = make_slice(@types.Type, 2)
	f2[0] = types.TypFloat32()
	f2[1] = types.TypFloat32()
	if cc.FuncReturnsBigMultiReturn(mkMrFunc(f2)) {
		return "AAPCS32 (float32,float32) = 2 GP words should be in-register"
	}
	return ""
}

// A single aggregate return above 4 bytes trips sret under AAPCS32 (where
// AAPCS64 keeps up to 16 bytes in registers); a 4-byte struct stays in r0.
func TestAapcs32SingleAggregateReturnSret() testing.TestResult {
	setTarget32()
	var cc CallConv = AAPCS32()
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt32()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt32()
	var s @types.Type = types.MakeStructType("Pair", fields)
	var f @ir.Func = ir.NewFunc("", "getPair", makeNoParams(), makeNoResults())
	f.Results = make_slice(@types.Type, 1)
	f.Results[0] = s
	if !cc.FuncReturnsBigAggregate(f) {
		return "AAPCS32 8-byte struct return (>4) should be sret"
	}
	var f1 @[]@types.Field = make_slice(@types.Field, 1)
	f1[0] = make(types.Field)
	f1[0].Type = types.TypInt32()
	var s1 @types.Type = types.MakeStructType("One", f1)
	var g @ir.Func = ir.NewFunc("", "getOne", makeNoParams(), makeNoResults())
	g.Results = make_slice(@types.Type, 1)
	g.Results[0] = s1
	if cc.FuncReturnsBigAggregate(g) {
		return "AAPCS32 4-byte struct return should stay in r0 (not sret)"
	}
	return ""
}
