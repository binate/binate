package "pkg/binate/native/common"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the SysV-AMD64 SSE-aggregate ARGUMENT accounting in
// common_callconv.bn (sysvSseAggEightbyteCounts / sysvSseAggFitsInRegs / the
// argRegWordsStackWords SSE branch / advanceNsrn's SSE arm).  The accounting is
// gated on cc.SseAggregates (= types.SysVSseInRegs(), dormant), so these force
// the field on directly and use the gate-free types.SysVAggHasSse structural
// check — exercising the intricate dual-file (GP + XMM) cursor logic without the
// global flip.  This is the "unit-test the accounting" piece of
// explorations/plan-hfa-x64-native-step4.md; the emit side is covered by the
// flip + conformance/971 harness.

// struct1 builds a named 1-field struct of field type t0.
func struct1(name @[]char, t0 @types.Type) @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 1)
	fs[0] = make(types.Field)
	fs[0].Type = t0
	return types.MakeStructType(name, fs)
}

// struct2 builds a named 2-field struct of field types t0, t1.
func struct2(name @[]char, t0 @types.Type, t1 @types.Type) @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 2)
	fs[0] = make(types.Field)
	fs[0].Type = t0
	fs[1] = make(types.Field)
	fs[1].Type = t1
	return types.MakeStructType(name, fs)
}

// struct2f64 builds a named {f64,f64} — a 2-eightbyte pure-SSE aggregate.
func struct2f64(name @[]char) @types.Type {
	return struct2(name, types.TypFloat64(), types.TypFloat64())
}

// sseCc returns a SysV-AMD64 CallConv with the SSE-aggregate field forced on
// (the global gate is still dormant).
func sseCc() CallConv {
	var cc CallConv = SysV_AMD64()
	cc.SseAggregates = true
	return cc
}

// sysvSseAggEightbyteCounts splits an aggregate's eightbytes into INTEGER (GP)
// vs SSE (XMM) counts: a pure-double/float aggregate is all-SSE, a mixed one has
// one of each.
func TestSysVSseAggEightbyteCounts() testing.TestResult {
	setTarget64()
	i0, s0 := sysvSseAggEightbyteCounts(struct1("D1", types.TypFloat64()))
	if i0 != 0 || s0 != 1 { return "{f64} must be (int 0, sse 1)" }
	i1, s1 := sysvSseAggEightbyteCounts(struct2("F2", types.TypFloat32(), types.TypFloat32()))
	if i1 != 0 || s1 != 1 { return "{f32,f32} packs into one SSE eightbyte: (0, 1)" }
	i2, s2 := sysvSseAggEightbyteCounts(struct2f64("D2"))
	if i2 != 0 || s2 != 2 { return "{f64,f64} must be (0, 2)" }
	i3, s3 := sysvSseAggEightbyteCounts(struct2("DI", types.TypFloat64(), types.TypInt64()))
	if i3 != 1 || s3 != 1 { return "{f64,i64} must be (int 1, sse 1)" }
	i4, s4 := sysvSseAggEightbyteCounts(struct2("ID", types.TypInt64(), types.TypFloat64()))
	if i4 != 1 || s4 != 1 { return "{i64,f64} must be (int 1, sse 1)" }
	return ""
}

// argRegWordsStackWords SSE branch: a fitting pure-SSE aggregate takes no GP and
// no stack (its eightbytes ride XMM, accounted via advanceNsrn); a fitting mixed
// aggregate takes intCount GP regs at ngrn; a non-fitting aggregate (either file
// exhausted) goes wholly to MEMORY with ngrn/nsrn unchanged.
func TestSysVSseArgClassification() testing.TestResult {
	setTarget64()
	var cc CallConv = sseCc()
	var d2 @types.Type = struct2f64("D2")
	var di @types.Type = struct2("DI", types.TypFloat64(), types.TypInt64())
	var id @types.Type = struct2("ID", types.TypInt64(), types.TypFloat64())

	// Pure SSE {f64,f64} at fresh cursors: no GP, no stack.
	rs, rw, sw := cc.argRegWordsStackWords(d2, 0, 0)
	if rs != -1 || rw != 0 || sw != 0 { return "{f64,f64} fitting: expected (-1,0,0)" }
	if cc.advanceNsrn(d2, 0, 0) != 2 { return "{f64,f64} advances nsrn by 2" }
	if cc.advanceNgrn(d2, 0, rs, rw, sw) != 0 { return "{f64,f64} leaves ngrn unchanged" }

	// Mixed {f64,i64}: one GP reg at ngrn, one XMM.
	rs2, rw2, sw2 := cc.argRegWordsStackWords(di, 0, 0)
	if rs2 != 0 || rw2 != 1 || sw2 != 0 { return "{f64,i64} fitting: expected (0,1,0)" }
	if cc.advanceNgrn(di, 0, rs2, rw2, sw2) != 1 { return "{f64,i64} advances ngrn by 1" }
	if cc.advanceNsrn(di, 0, 0) != 1 { return "{f64,i64} advances nsrn by 1" }

	// {i64,f64} — INTEGER eightbyte first — same GP/XMM consumption.
	rs3, rw3, _ := cc.argRegWordsStackWords(id, 0, 0)
	if rs3 != 0 || rw3 != 1 { return "{i64,f64} fitting: one GP at ngrn" }
	if cc.advanceNsrn(id, 0, 0) != 1 { return "{i64,f64} advances nsrn by 1" }

	// XMM-exhausted: {f64,f64} needs 2 XMM but only 1 left (nsrn=7) -> MEMORY.
	rs4, rw4, sw4 := cc.argRegWordsStackWords(d2, 0, 7)
	if rs4 != -1 || rw4 != 0 || sw4 != 2 { return "{f64,f64} with 1 XMM left: MEMORY (-1,0,2)" }
	if cc.advanceNsrn(d2, 0, 7) != 7 { return "MEMORY {f64,f64} leaves nsrn unchanged (SysV)" }

	// GP-exhausted: {f64,i64} needs 1 GP but none left (ngrn=6) -> whole agg
	// MEMORY, and nsrn stays put even though XMM had room (both-files rule).
	rs5, rw5, sw5 := cc.argRegWordsStackWords(di, 6, 0)
	if rs5 != -1 || rw5 != 0 || sw5 != 2 { return "{f64,i64} with GP full: MEMORY (-1,0,2)" }
	if cc.advanceNsrn(di, 6, 0) != 0 { return "GP-exhausted {f64,i64}: SSE eightbyte NOT consumed" }
	return ""
}

// The dual-file cursors must advance TOGETHER: an SSE aggregate consuming one GP
// AND one XMM must shift both a later GP arg and a later float arg by one.
func TestSysVSseArgDualFileCursors() testing.TestResult {
	setTarget64()
	var cc CallConv = sseCc()
	var di @types.Type = struct2("DI", types.TypFloat64(), types.TypInt64())

	// [DI, i64 x6]: DI takes GP[0]; i64s take GP[1..5]; the 6th i64 overflows.
	var gpArgs @[]@types.Type = make_slice(@types.Type, 7)
	gpArgs[0] = di
	for i := 1; i < 7; i++ { gpArgs[i] = types.TypInt64() }
	if cc.CallArgRegStart(gpArgs, 0) != 0 { return "DI's INTEGER eightbyte takes GP[0]" }
	if cc.CallArgRegStart(gpArgs, 5) != 5 { return "5th trailing i64 takes GP[5]" }
	if cc.CallArgRegStart(gpArgs, 6) != -1 { return "6th trailing i64 spills (DI took a GP)" }

	// [DI, f64 x8]: DI takes XMM[0]; f64s take XMM[1..7]; the 8th f64 overflows.
	var fpArgs @[]@types.Type = make_slice(@types.Type, 9)
	fpArgs[0] = di
	for i := 1; i < 9; i++ { fpArgs[i] = types.TypFloat64() }
	if cc.CallArgStackOff(fpArgs, 7) != -1 { return "7th trailing f64 still in XMM[7]" }
	if cc.CallArgStackOff(fpArgs, 8) < 0 { return "8th trailing f64 spills (DI took an XMM)" }
	return ""
}

// Dormant: with cc.SseAggregates off (the landed default), an SSE aggregate is
// NOT split by class — {f64,i64} is a plain 16-byte GP aggregate (2 GP regs),
// and advanceNsrn ignores it.
func TestSysVSseArgDormant() testing.TestResult {
	setTarget64()
	var cc CallConv = SysV_AMD64()
	var di @types.Type = struct2("DI", types.TypFloat64(), types.TypInt64())
	rs, rw, sw := cc.argRegWordsStackWords(di, 0, 0)
	if rs != 0 || rw != 2 || sw != 0 { return "dormant {f64,i64}: plain GP aggregate (0,2,0)" }
	if cc.advanceNsrn(di, 0, 0) != 0 { return "dormant: advanceNsrn ignores the aggregate" }
	return ""
}
