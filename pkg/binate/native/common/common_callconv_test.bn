package "pkg/binate/native/common"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for everything declared in common_callconv.bn:
//   - CallConv struct + AAPCS64() / SysV_AMD64() constructors
//   - the 8 CallConv methods (CallArgRegStart / CallArgStackOff /
//     CallStackBytes / FuncReturnsBigAggregate /
//     CallReturnsBigAggregate / FuncReturnsBigMultiReturn /
//     CallReturnsBigMultiReturn / CalleeUsesCSret)
//
// Coverage runs both shapes (AAPCS64 = 8 GP arg regs / 64-byte
// internal sret threshold; SysV-AMD64 = 6 / 16) so any off-by-one in
// the parameterised loops shows up under one but not the other.

// ============================================================
// Constructor pins
// ============================================================

func TestAAPCS64Constants() testing.TestResult {
	var cc CallConv = AAPCS64()
	if cc.NumGpArgRegs != 8 {
		return "AAPCS64 should advertise 8 GP arg regs"
	}
	if cc.NumFpArgRegs != 8 {
		return "AAPCS64 should advertise 8 FP arg regs"
	}
	if cc.InternalSretBytes != 16 {
		return "AAPCS64 internal sret threshold should be 16 (match AAPCS-C for native↔LLVM agreement)"
	}
	if cc.CExternSretBytes != 16 {
		return "AAPCS64 C-extern sret threshold should be 16"
	}
	if cc.AggregateInRegMax != 16 {
		return "AAPCS64 aggregate-in-reg max should be 16 (textbook AAPCS § 5.4.2)"
	}
	if cc.StackAlign != 16 {
		return "AAPCS64 stack align should be 16"
	}
	if !cc.SplitAggregates {
		return "AAPCS64 should allow aggregate reg/stack split for ≤ AggregateInRegMax"
	}
	if !cc.IndirectLargeAggregates {
		return "AAPCS64 should use indirect-pointer-pass for > AggregateInRegMax"
	}
	return ""
}

func TestSysVAMD64Constants() testing.TestResult {
	var cc CallConv = SysV_AMD64()
	if cc.NumGpArgRegs != 6 {
		return "SysV-AMD64 should advertise 6 GP arg regs"
	}
	if cc.NumFpArgRegs != 8 {
		return "SysV-AMD64 should advertise 8 FP arg regs"
	}
	if cc.InternalSretBytes != 16 {
		return "SysV-AMD64 internal sret threshold should be 16"
	}
	if cc.CExternSretBytes != 16 {
		return "SysV-AMD64 C-extern sret threshold should be 16"
	}
	if cc.AggregateInRegMax != 16 {
		return "SysV-AMD64 aggregate-in-reg max should be 16"
	}
	if cc.StackAlign != 16 {
		return "SysV-AMD64 stack align should be 16"
	}
	if cc.SplitAggregates {
		return "SysV-AMD64 must NOT split aggregates (no split for ≤ 16 B)"
	}
	if !cc.IndirectLargeAggregates {
		return "SysV-AMD64 should pass large aggregates indirect "
			"(pkg/codegen emits plain ptr — pointer-pass)"
	}
	return ""
}

// ============================================================
// CallArgRegStart / CallArgStackOff / CallStackBytes (AAPCS64 shape)
// ============================================================

// Float scalars don't consume GP-arg-reg budget — they travel in the
// FP register file (NSRN) tracked separately by the call site.  Mixed
// (int, float, slice) signatures must place the slice in the GP regs
// immediately after the int, not after the int + float.
func TestCallArgRegStartAapcs64SkipsFloats() testing.TestResult {
	var cc CallConv = AAPCS64()
	var argTypes @[]@types.Type = make_slice(@types.Type, 3)
	argTypes[0] = types.TypInt()
	argTypes[1] = types.TypFloat64()
	argTypes[2] = types.MakeSliceType(types.TypUint8())
	if cc.CallArgRegStart(argTypes, 0) != 0 {
		return "int arg should be at X0"
	}
	if cc.CallArgRegStart(argTypes, 1) != -1 {
		return "float arg should not consume X-regs (regStart -1)"
	}
	if cc.CallArgRegStart(argTypes, 2) != 1 {
		return "slice after float should start at X1, not X2"
	}
	if cc.CallStackBytes(argTypes) != 0 {
		return "no stack args expected for (int, float, *[]u8)"
	}
	return ""
}

// (int, @[]int): 1 + 4 = 5 words, fits in X0..X4, zero stack.
func TestCallStackBytesAapcs64AllInRegs() testing.TestResult {
	var cc CallConv = AAPCS64()
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt()
	ts[1] = types.MakeManagedSliceType(types.TypInt())
	if cc.CallStackBytes(ts) != 0 {
		return "all-fit args should need 0 stack bytes"
	}
	if cc.CallArgRegStart(ts, 0) != 0 { return "arg 0 should be at X0" }
	if cc.CallArgRegStart(ts, 1) != 1 { return "arg 1 should start at X1" }
	if cc.CallArgStackOff(ts, 0) != -1 {
		return "arg 0 should not be on stack"
	}
	return ""
}

// (@[]int, Entry5w): both args are > 16 bytes (32 and 40), so each
// passes as an indirect pointer occupying ONE GP arg reg.  Slice's
// pointer goes in X0, Entry's pointer in X1.  Pins the textbook
// AAPCS § 5.4.2 "passed by reference" lowering that LLVM's
// `ptr byval(<T>) align 8` emits.
func TestCallArgIndirectLargeAggregateAapcs64() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.MakeManagedSliceType(types.TypInt64())
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt64()
	var entry @types.Type = types.MakeStructType("Entry", fields)
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.MakeManagedSliceType(types.TypInt64())
	ts[1] = entry
	if cc.CallArgRegStart(ts, 0) != 0 {
		return "32-byte managed-slice (> 16) should be indirect: pointer in X0"
	}
	if cc.CallArgStackOff(ts, 0) != -1 {
		return "indirect pointer fits in reg, no stack portion"
	}
	if cc.CallArgRegStart(ts, 1) != 1 {
		return "40-byte Entry (> 16) should be indirect: pointer in X1"
	}
	if cc.CallArgStackOff(ts, 1) != -1 {
		return "indirect pointer fits in reg, no stack portion"
	}
	if cc.CallStackBytes(ts) != 0 {
		return "both args indirect-in-reg → zero outgoing stack"
	}
	return ""
}

// (Tup8w, int): Tup is 64 bytes (> 16) → indirect pointer in X0;
// int takes X1 (one reg consumed for Tup's pointer leaves 7 free).
// Confirms IndirectLargeAggregates compresses any large aggregate
// to a single reg/stack slot regardless of its byte size.
func TestCallArgIndirectLargeAggregatePointerOnly() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var fields @[]@types.Field = make_slice(@types.Field, 8)
	for i := 0; i < 8; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var tup @types.Type = types.MakeStructType("Tup8", fields)
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = tup
	ts[1] = types.TypInt64()
	if cc.CallArgRegStart(ts, 0) != 0 {
		return "Tup8 (64 bytes, > 16) should be indirect pointer in X0"
	}
	if cc.CallArgStackOff(ts, 0) != -1 {
		return "indirect pointer fits in X0, no stack"
	}
	if cc.CallArgRegStart(ts, 1) != 1 {
		return "int after a single-reg indirect aggregate should take X1"
	}
	if cc.CallArgStackOff(ts, 1) != -1 {
		return "int still fits in regs"
	}
	return ""
}

// 9 scalar ints: X0..X7 used, 9th overflows to stack[0].
func TestCallStackBytesAapcs64ScalarOverflow() testing.TestResult {
	var cc CallConv = AAPCS64()
	var ts @[]@types.Type = make_slice(@types.Type, 9)
	for i := 0; i < 9; i++ {
		ts[i] = types.TypInt()
	}
	if cc.CallArgRegStart(ts, 7) != 7 { return "arg 7 should be in X7" }
	if cc.CallArgRegStart(ts, 8) != -1 { return "arg 8 should overflow" }
	if cc.CallArgStackOff(ts, 8) != 0 {
		return "arg 8 stack offset should be 0"
	}
	if cc.CallStackBytes(ts) != 16 {
		return "1-word stack arg should pad to 16 bytes"
	}
	return ""
}

// ============================================================
// CallArgRegStart / CallArgStackOff / CallStackBytes (SysV shape)
// ============================================================
//
// These pin behaviour that depends on the parameterised loop
// terminating at cc.NumGpArgRegs rather than the hardcoded 8 that
// AAPCS64-only tests would happily accept.

// 7 ints under SysV: arg 5 → R9 (last GP arg reg), arg 6 overflows.
// Same signature under AAPCS64 keeps every arg in regs.
func TestCallArgRegStartSysVOverflowAtSeven() testing.TestResult {
	var cc CallConv = SysV_AMD64()
	var ts @[]@types.Type = make_slice(@types.Type, 7)
	for i := 0; i < 7; i++ {
		ts[i] = types.TypInt()
	}
	if cc.CallArgRegStart(ts, 5) != 5 {
		return "arg 5 should land in the 6th GP arg reg"
	}
	if cc.CallArgRegStart(ts, 6) != -1 {
		return "arg 6 should overflow to stack under SysV (NumGpArgRegs=6)"
	}
	if cc.CallArgStackOff(ts, 6) != 0 {
		return "arg 6 stack offset should be 0"
	}
	if cc.CallStackBytes(ts) != 16 {
		return "1-word stack overflow should round up to 16-byte stack align"
	}
	return ""
}

// SysV indirect-large: a managed-slice (32 B > AggregateInRegMax)
// passes as a single pointer in the next free GP arg reg.  Matches
// pkg/codegen's plain-`ptr` emission for >16-byte aggregates and
// LLVM x86_64's lowering thereof.
func TestCallArgIndirectLargeAggregateSysV() testing.TestResult {
	setTarget64()
	var cc CallConv = SysV_AMD64()
	var ts @[]@types.Type = make_slice(@types.Type, 4)
	ts[0] = types.TypInt64()
	ts[1] = types.TypInt64()
	ts[2] = types.TypInt64()
	ts[3] = types.MakeManagedSliceType(types.TypInt64())
	if cc.CallArgRegStart(ts, 3) != 3 {
		return "32-byte managed-slice pointer should take RCX (slot 3)"
	}
	if cc.CallArgStackOff(ts, 3) != -1 {
		return "indirect pointer fits in reg, no stack portion"
	}
	if cc.CallStackBytes(ts) != 0 {
		return "all args in regs → zero outgoing stack"
	}
	return ""
}

// SysV no-split: a ≤ 16 B aggregate that doesn't fit in the remaining
// GP arg regs goes wholly to MEMORY, leaving NGRN unchanged so a
// later scalar can take the still-free reg.  AAPCS64 would split.
func TestCallArgSysVNoSplitFallsToMemory() testing.TestResult {
	setTarget64()
	var cc CallConv = SysV_AMD64()
	// 5 ints (NGRN advances to 5), then a 16-byte raw slice (2 words).
	// 5 + 2 > 6, so SysV puts the slice in MEMORY and leaves NGRN = 5.
	// A trailing scalar then takes reg 5 (R9), proving NGRN unchanged.
	var ts @[]@types.Type = make_slice(@types.Type, 7)
	for i := 0; i < 5; i++ {
		ts[i] = types.TypInt64()
	}
	ts[5] = types.MakeSliceType(types.TypInt64())
	ts[6] = types.TypInt64()
	if cc.CallArgRegStart(ts, 5) != -1 {
		return "16-byte raw slice in MEMORY when 2 regs aren't free "
			"under SysV"
	}
	if cc.CallArgStackOff(ts, 5) != 0 {
		return "MEMORY raw slice starts at outgoing-args offset 0"
	}
	if cc.CallArgRegStart(ts, 6) != 5 {
		return "trailing scalar takes the still-free 6th GP reg "
			"(NGRN unchanged by MEMORY)"
	}
	if cc.CallStackBytes(ts) != 16 {
		return "2-word MEMORY aggregate consumes 16 bytes"
	}
	return ""
}

// SysV fits-in-regs: a ≤ 16 B aggregate (16-byte raw slice) that fits
// in the remaining GP arg regs lands wholly in regs — no stack
// portion — matching SysV's 2-eightbyte INTEGER classification.
func TestCallArgSysVRawSliceFitsInRegs() testing.TestResult {
	var cc CallConv = SysV_AMD64()
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt()
	ts[1] = types.MakeSliceType(types.TypUint8())
	if cc.CallArgRegStart(ts, 1) != 1 {
		return "raw slice arg 1 should start at GP reg 1 (RSI)"
	}
	if cc.CallArgStackOff(ts, 1) != -1 {
		return "raw slice fully in regs → no stack portion"
	}
	if cc.CallStackBytes(ts) != 0 {
		return "all-in-regs call has zero outgoing-args bytes"
	}
	return ""
}

// 6 ints (NGRN = 6), then a 32-byte managed-slice.  Under the
// indirect-large rule, the slice's pointer takes X6 — one reg,
// no stack overflow.  Earlier shapes split the slice across X6..X7
// + stack, but textbook AAPCS § 5.4.2 passes large aggregates by
// reference, matching LLVM's `ptr byval(<T>)` lowering.
func TestCallArgIndirectAfterExhaustingScalarsAapcs64() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var ts @[]@types.Type = make_slice(@types.Type, 7)
	for i := 0; i < 6; i++ {
		ts[i] = types.TypInt64()
	}
	ts[6] = types.MakeManagedSliceType(types.TypInt64())
	if cc.CallArgRegStart(ts, 6) != 6 {
		return "32-byte managed-slice pointer should take X6"
	}
	if cc.CallArgStackOff(ts, 6) != -1 {
		return "indirect pointer fits in remaining reg, no stack"
	}
	if cc.CallStackBytes(ts) != 0 {
		return "all args in regs → zero outgoing stack"
	}
	return ""
}

// Floats still skip GP-reg budget under SysV.
func TestCallArgRegStartSysVSkipsFloats() testing.TestResult {
	var cc CallConv = SysV_AMD64()
	var ts @[]@types.Type = make_slice(@types.Type, 3)
	ts[0] = types.TypInt()
	ts[1] = types.TypFloat64()
	ts[2] = types.TypInt()
	if cc.CallArgRegStart(ts, 0) != 0 {
		return "int arg 0 should land in the 1st GP arg reg"
	}
	if cc.CallArgRegStart(ts, 1) != -1 {
		return "float arg 1 should not consume GP arg reg budget"
	}
	if cc.CallArgRegStart(ts, 2) != 1 {
		return "int arg 2 should land in the 2nd GP arg reg (float skipped)"
	}
	return ""
}

// ============================================================
// FuncReturnsBigAggregate
// ============================================================

// 80-byte struct (10 ints): above AAPCS64's 64-byte threshold → sret.
func TestFuncReturnsBigAggregateAapcs64Above() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var fields @[]@types.Field = make_slice(@types.Field, 10)
	for i := 0; i < 10; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var bigStruct @types.Type = types.MakeStructType("Big", fields)
	var f @ir.Func = ir.NewFunc("getBig", makeNoParams(), makeNoResults())
	f.Results = make_slice(@types.Type, 1)
	f.Results[0] = bigStruct
	if !cc.FuncReturnsBigAggregate(f) {
		return "80-byte aggregate return should trip sret under AAPCS64"
	}
	return ""
}

// 16-byte struct (2 ints): ≤ 16 → reg-packed.
func TestFuncReturnsBigAggregateAapcs64BelowThreshold() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var s @types.Type = types.MakeStructType("Small", fields)
	var f @ir.Func = ir.NewFunc("getSmall", makeNoParams(), makeNoResults())
	f.Results = make_slice(@types.Type, 1)
	f.Results[0] = s
	if cc.FuncReturnsBigAggregate(f) {
		return "16-byte aggregate should NOT trip AAPCS64 sret (≤16)"
	}
	return ""
}

// 24-byte struct trips sret under both AAPCS64 and SysV — both
// thresholds are 16 so the native↔LLVM boundary agrees with clang
// (AAPCS-C / SysV-AMD64): aggregates above 16 bytes use sret.
func TestFuncReturnsBigAggregateThresholdAgrees() testing.TestResult {
	setTarget64()
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var s @types.Type = types.MakeStructType("Triple", fields)
	var f @ir.Func = ir.NewFunc("getTriple", makeNoParams(), makeNoResults())
	f.Results = make_slice(@types.Type, 1)
	f.Results[0] = s
	var aapcs CallConv = AAPCS64()
	var sysv CallConv = SysV_AMD64()
	if !aapcs.FuncReturnsBigAggregate(f) {
		return "24-byte aggregate SHOULD trip AAPCS64 sret (>16)"
	}
	if !sysv.FuncReturnsBigAggregate(f) {
		return "24-byte aggregate SHOULD trip SysV sret (>16)"
	}
	return ""
}

// Scalar / void / multi-result returns must never trip FuncReturnsBig*
// (caller depends on this to decide whether to reserve an sret slot).
func TestFuncReturnsBigAggregateScalarFalse() testing.TestResult {
	var cc CallConv = AAPCS64()
	var f @ir.Func = ir.NewFunc("getInt", makeNoParams(), makeNoResults())
	f.Results = make_slice(@types.Type, 1)
	f.Results[0] = types.TypInt()
	if cc.FuncReturnsBigAggregate(f) {
		return "scalar int return should never trip sret"
	}
	return ""
}

// ============================================================
// CallReturnsBigAggregate
// ============================================================

func TestCallReturnsBigAggregateAapcs64Above() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var fields @[]@types.Field = make_slice(@types.Field, 10)
	for i := 0; i < 10; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var bigStruct @types.Type = types.MakeStructType("Big", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_CALL
	ins.Typ = bigStruct
	if !cc.CallReturnsBigAggregate(ins) {
		return "80-byte struct call should be sret under AAPCS64"
	}
	return ""
}

func TestCallReturnsBigAggregateAapcs64BelowThreshold() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var smallStruct @types.Type = types.MakeStructType("Small", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_CALL
	ins.Typ = smallStruct
	if cc.CallReturnsBigAggregate(ins) {
		return "16-byte struct call should NOT be sret under AAPCS64 (≤16)"
	}
	return ""
}

// 24-byte struct trips sret under both AAPCS64 and SysV (both
// thresholds are 16); the native↔LLVM boundary thus agrees.
func TestCallReturnsBigAggregateThresholdAgrees() testing.TestResult {
	setTarget64()
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var t @types.Type = types.MakeStructType("Triple", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_CALL
	ins.Typ = t
	var sysv CallConv = SysV_AMD64()
	if !sysv.CallReturnsBigAggregate(ins) {
		return "24-byte struct should be sret under SysV-AMD64 (>16)"
	}
	var aapcs CallConv = AAPCS64()
	if !aapcs.CallReturnsBigAggregate(ins) {
		return "24-byte struct should be sret under AAPCS64 (>16)"
	}
	return ""
}

// ============================================================
// FuncReturnsBigMultiReturn
// ============================================================

// (int, int) tuple = 16 bytes ≤ 16 → reg-packed under AAPCS64.
// Tuples above the 16-byte threshold flip to sret to avoid silently
// dropping the tail when more than two words don't fit in registers.
func TestFuncReturnsBigMultiReturnAapcs64BelowThreshold() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var tupleFields @[]@types.Field = make_slice(@types.Field, 2)
	tupleFields[0] = make(types.Field)
	tupleFields[0].Type = types.TypInt()
	tupleFields[1] = make(types.Field)
	tupleFields[1].Type = types.TypInt()
	var tuple @types.Type = types.MakeStructType("", tupleFields)
	var f @ir.Func = ir.NewFunc("multi", makeNoParams(), makeNoResults())
	f.Results = make_slice(@types.Type, 2)
	f.Results[0] = types.TypInt()
	f.Results[1] = types.TypInt()
	f.MultiReturnType = tuple
	if cc.FuncReturnsBigMultiReturn(f) {
		return "16-byte tuple should NOT trip AAPCS64 sret (≤16)"
	}
	return ""
}

// 9-int multi-return tuple = 72 bytes > 16 → sret under AAPCS64.
func TestFuncReturnsBigMultiReturnAapcs64Above() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var fields @[]@types.Field = make_slice(@types.Field, 9)
	for i := 0; i < 9; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	var f @ir.Func = ir.NewFunc("multi9", makeNoParams(), makeNoResults())
	f.Results = make_slice(@types.Type, 9)
	for i := 0; i < 9; i++ { f.Results[i] = types.TypInt64() }
	f.MultiReturnType = tuple
	if !cc.FuncReturnsBigMultiReturn(f) {
		return "72-byte tuple SHOULD trip AAPCS64 sret (>64)"
	}
	return ""
}

// Single-result funcs are not multi-returns; predicate must be false.
func TestFuncReturnsBigMultiReturnSingleResultFalse() testing.TestResult {
	var cc CallConv = AAPCS64()
	var f @ir.Func = ir.NewFunc("getInt", makeNoParams(), makeNoResults())
	f.Results = make_slice(@types.Type, 1)
	f.Results[0] = types.TypInt()
	if cc.FuncReturnsBigMultiReturn(f) {
		return "single-result func is not a multi-return"
	}
	return ""
}

// ============================================================
// CallReturnsBigMultiReturn
// ============================================================

// 9-int tuple call = 72 bytes; predicate fires under AAPCS64 because
// the call's Typ is the anonymous-struct tuple recognized by
// IsMultiReturnCall (Name="").
func TestCallReturnsBigMultiReturnAapcs64Above() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var fields @[]@types.Field = make_slice(@types.Field, 9)
	for i := 0; i < 9; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_CALL
	ins.Typ = tuple
	if !cc.CallReturnsBigMultiReturn(ins) {
		return "72-byte tuple call SHOULD trip AAPCS64 sret"
	}
	return ""
}

// (int, int) tuple = 16 bytes ≤ 16; predicate must NOT fire.
func TestCallReturnsBigMultiReturnAapcs64BelowFalse() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_CALL
	ins.Typ = tuple
	if cc.CallReturnsBigMultiReturn(ins) {
		return "16-byte tuple call should NOT trip AAPCS64 sret"
	}
	return ""
}

// Non-multi-return call (named struct return) must never trip the
// predicate even if the type is large — that's CallReturnsBigAggregate's
// job, not this one.  IsMultiReturnCall returns false for named struct
// types.
func TestCallReturnsBigMultiReturnNamedStructFalse() testing.TestResult {
	var cc CallConv = AAPCS64()
	var fields @[]@types.Field = make_slice(@types.Field, 10)
	for i := 0; i < 10; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var named @types.Type = types.MakeStructType("Big", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_CALL
	ins.Typ = named
	if cc.CallReturnsBigMultiReturn(ins) {
		return "named struct return is not a multi-return tuple"
	}
	return ""
}

// ============================================================
// CalleeUsesCSret
// ============================================================
//
// CalleeUsesCSret applies the C-ABI threshold (>16 bytes) to
// IsCExtern callees specifically — distinct from the
// CallReturnsBigAggregate path that handles general aggregate
// returns.  pkg/binate/codegen emits LLVM `sret(...)` for IsCExtern
// callees with aggregate returns >16 bytes, so the caller must
// pass a hidden buffer pointer to match.

func TestCalleeUsesCSretBootstrapConcat() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	// C-extern returning @[]char (32 bytes via X8 sret on AAPCS).
	var f @ir.Func = ir.NewFunc("pkg/binate/buf.Concat", makeNoParams(),
		makeNoResults())
	f.IsCExtern = true
	f.Results = make_slice(@types.Type, 1)
	f.Results[0] = types.MakeManagedSliceType(types.TypChar())
	var funcs @[]@ir.Func = make_slice(@ir.Func, 1)
	funcs[0] = f
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_CALL
	ins.StrVal = "pkg/binate/buf.Concat"
	ins.Typ = types.MakeManagedSliceType(types.TypChar())
	if !cc.CalleeUsesCSret(funcs, ins) {
		return "C-extern @[]char (32 bytes) return should trigger sret"
	}
	return ""
}

func TestCalleeUsesCSretInternalBinateNo() testing.TestResult {
	var cc CallConv = AAPCS64()
	// Internal Binate function with the same return type — does NOT
	// use C sret. (CallReturnsBigAggregate handles the internal
	// threshold separately.)
	var f @ir.Func = ir.NewFunc("local", makeNoParams(), makeNoResults())
	f.IsCExtern = false
	f.Results = make_slice(@types.Type, 1)
	f.Results[0] = types.MakeManagedSliceType(types.TypChar())
	var funcs @[]@ir.Func = make_slice(@ir.Func, 1)
	funcs[0] = f
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_CALL
	ins.StrVal = "local"
	ins.Typ = types.MakeManagedSliceType(types.TypChar())
	if cc.CalleeUsesCSret(funcs, ins) {
		return "internal Binate call should NOT trigger C sret"
	}
	return ""
}

// C-extern returning a 16-byte raw slice — at the threshold; the rule
// is "> 16", so 16-byte returns stay reg-packed.
func TestCalleeUsesCSretSmallReturnNo() testing.TestResult {
	var cc CallConv = AAPCS64()
	var f @ir.Func = ir.NewFunc("pkg/bootstrap.Bytes", makeNoParams(),
		makeNoResults())
	f.IsCExtern = true
	f.Results = make_slice(@types.Type, 1)
	f.Results[0] = types.MakeSliceType(types.TypUint8())
	var funcs @[]@ir.Func = make_slice(@ir.Func, 1)
	funcs[0] = f
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_CALL
	ins.StrVal = "pkg/bootstrap.Bytes"
	ins.Typ = types.MakeSliceType(types.TypUint8())
	if cc.CalleeUsesCSret(funcs, ins) {
		return "16-byte return should NOT use C sret"
	}
	return ""
}

// CallConv-independent: AAPCS64 and SysV-AMD64 both happen to use the
// same C-extern threshold (16 bytes), so a C-extern returning the
// same 24-byte struct triggers C sret under both — but for different
// CExternSretBytes-derived reasons. Pin the equality so a future
// SysV-only threshold tweak doesn't silently desync.
func TestCalleeUsesCSretSysVAgreesAtSixteen() testing.TestResult {
	setTarget64()
	var sysv CallConv = SysV_AMD64()
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var s @types.Type = types.MakeStructType("Triple", fields)
	var f @ir.Func = ir.NewFunc("pkg/libc.x", makeNoParams(), makeNoResults())
	f.IsCExtern = true
	f.Results = make_slice(@types.Type, 1)
	f.Results[0] = s
	var funcs @[]@ir.Func = make_slice(@ir.Func, 1)
	funcs[0] = f
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_CALL
	ins.StrVal = "pkg/libc.x"
	ins.Typ = s
	if !sysv.CalleeUsesCSret(funcs, ins) {
		return "24-byte C-extern return should trigger SysV C sret (>16)"
	}
	return ""
}

// ============================================================
// V-variant dispatch (Stage 4: variadic native __c_call)
// ============================================================

// AAPCS64() (Linux variant) leaves VariadicStackOnly = false; the
// V-variants behave identically to the non-V variants for every
// argument index because the saturation `if k == fixedCount &&
// cc.VariadicStackOnly` never fires.  This is the property we rely
// on to keep non-variadic OP_CALL behaviour unchanged after wiring
// the V-variants into emitCall.
func TestVVariantNoSaturationWithoutDarwin() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var ts @[]@types.Type = make_slice(@types.Type, 4)
	ts[0] = types.TypInt()
	ts[1] = types.TypInt()
	ts[2] = types.TypInt()
	ts[3] = types.TypInt()
	// fixedCount = 2 (last two are "variadic"), but VariadicStackOnly
	// is false, so all four still land in X0..X3.
	for i := 0; i < 4; i++ {
		var expect int = cc.CallArgRegStart(ts, i)
		var got int = cc.CallArgRegStartV(ts, i, 2)
		if got != expect {
			return "V-variant must mirror non-V when VariadicStackOnly is false"
		}
	}
	if cc.CallStackBytesV(ts, 2) != cc.CallStackBytes(ts) {
		return "V-variant stack bytes must mirror non-V when VariadicStackOnly is false"
	}
	return ""
}

// AAPCS64_Darwin() sets VariadicStackOnly = true.  Fixed args still
// take registers; variadic args (k >= fixedCount) saturate to the
// stack regardless of remaining GP-reg budget.  This is the Apple
// variant of AAPCS-64 — `printf("answer: %d", 42)` puts the format
// string in X0 (fixed) and the int 42 on the stack (variadic).
func TestVVariantSaturatesVariadicArgsToStack() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64_Darwin()
	if !cc.VariadicStackOnly {
		return "AAPCS64_Darwin should set VariadicStackOnly = true"
	}
	// printf-shaped signature: *[]readonly char fixed + int variadic.
	// *[]readonly char is 2 words (raw slice); int is 1 word.
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.MakeSliceType(types.MakeConstType(types.TypChar()))
	ts[1] = types.TypInt()
	// fixedCount = 1: the raw slice is fixed (goes in X0+X1), the
	// int is variadic (saturates to stack[0]).
	if cc.CallArgRegStartV(ts, 0, 1) != 0 {
		return "fixed raw-slice arg should start at X0"
	}
	if cc.CallArgRegStartV(ts, 1, 1) != -1 {
		return "variadic int arg should saturate to stack (reg -1)"
	}
	if cc.CallArgStackOffV(ts, 1, 1) != 0 {
		return "variadic int arg should be at stack offset 0"
	}
	if cc.CallStackBytesV(ts, 1) != 16 {
		return "1-word variadic stack arg should reserve 16 bytes (16-aligned)"
	}
	return ""
}

// When the fixed-arg block already spans a register boundary, the
// variadic saturation must not pull fixed args off-register: only
// args at index >= fixedCount move to stack.  Pins that the
// saturation triggers AT fixedCount, not before.
func TestVVariantFixedArgsKeepRegsUnderDarwin() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64_Darwin()
	var ts @[]@types.Type = make_slice(@types.Type, 4)
	ts[0] = types.TypInt()
	ts[1] = types.TypInt()
	ts[2] = types.TypInt()  // first variadic
	ts[3] = types.TypInt()
	// fixedCount = 2: args 0,1 in X0,X1; args 2,3 on stack.
	if cc.CallArgRegStartV(ts, 0, 2) != 0 { return "arg 0 fixed → X0" }
	if cc.CallArgRegStartV(ts, 1, 2) != 1 { return "arg 1 fixed → X1" }
	if cc.CallArgRegStartV(ts, 2, 2) != -1 { return "arg 2 variadic → stack" }
	if cc.CallArgRegStartV(ts, 3, 2) != -1 { return "arg 3 variadic → stack" }
	if cc.CallArgStackOffV(ts, 2, 2) != 0 { return "arg 2 → stack[0]" }
	if cc.CallArgStackOffV(ts, 3, 2) != 8 { return "arg 3 → stack[8]" }
	if cc.CallStackBytesV(ts, 2) != 16 { return "2 variadic ints → 16 bytes" }
	return ""
}

// fixedCount == 0 means EVERY arg is variadic (a call whose `...`
// precedes all value args).  Under AAPCS64_Darwin the saturation
// boundary at k == fixedCount fires on the very first arg, so all
// args go to the stack from index 0.  Pins the fixedCount = 0 edge
// the other V-variant tests (fixedCount >= 1) don't reach.
func TestVVariantAllVariadicSaturatesUnderDarwin() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64_Darwin()
	var ts @[]@types.Type = make_slice(@types.Type, 3)
	ts[0] = types.TypInt()
	ts[1] = types.TypInt()
	ts[2] = types.TypInt()
	// fixedCount = 0: all three are variadic → none take a register.
	if cc.CallArgRegStartV(ts, 0, 0) != -1 {
		return "arg 0 (variadic) should saturate to stack, not X0"
	}
	if cc.CallArgRegStartV(ts, 1, 0) != -1 { return "arg 1 (variadic) → stack" }
	if cc.CallArgRegStartV(ts, 2, 0) != -1 { return "arg 2 (variadic) → stack" }
	// ...and land in consecutive stack slots from offset 0.
	if cc.CallArgStackOffV(ts, 0, 0) != 0 { return "arg 0 → stack[0]" }
	if cc.CallArgStackOffV(ts, 1, 0) != 8 { return "arg 1 → stack[8]" }
	if cc.CallArgStackOffV(ts, 2, 0) != 16 { return "arg 2 → stack[16]" }
	return ""
}

// fixedCount == len(argTypes) means the call is entirely fixed
// (no variadic args at all).  The saturation never fires.  Bytes-
// for-bytes equivalent to calling the non-V variants.
func TestVVariantAllFixedEquivalentToNonV() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64_Darwin()
	var ts @[]@types.Type = make_slice(@types.Type, 3)
	ts[0] = types.TypInt()
	ts[1] = types.TypInt()
	ts[2] = types.TypInt()
	for i := 0; i < 3; i++ {
		if cc.CallArgRegStartV(ts, i, 3) != cc.CallArgRegStart(ts, i) {
			return "fully-fixed V dispatch must mirror non-V"
		}
	}
	if cc.CallStackBytesV(ts, 3) != cc.CallStackBytes(ts) {
		return "fully-fixed V stack bytes must mirror non-V"
	}
	return ""
}
