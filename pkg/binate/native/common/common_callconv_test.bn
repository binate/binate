package "pkg/binate/native/common"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the argument-dispatch classifier declared in
// common_callconv.bn: the non-V argument walkers (CallArgRegStart /
// CallArgStackOff / CallStackBytes and the StackArg* helpers).
//
// The per-ABI CallConv constructors live in common_callconv_ctors.bn and
// are pinned by common_callconv_ctors_test.bn; return classification is in
// common_callconv_return_test.bn and the variadic V-variant walkers in
// common_callconv_variadic_test.bn.
//
// Coverage runs multiple shapes (AAPCS64 = 8 GP arg regs; SysV-AMD64 =
// 6; AAPCS32 = 4 GP arg regs, soft-float, ILP32 word size) so any
// off-by-one in the parameterised loops shows up under one convention
// but not another.

// ============================================================
// CallArgRegStart / CallArgStackOff / CallStackBytes (AAPCS64 shape)
// ============================================================

// Float scalars don't consume GP-arg-reg budget — they travel in the
// FP register file (NSRN) tracked separately by the call site.  Mixed
// (int, float, slice) signatures must place the slice in the GP regs
// immediately after the int, not after the int + float.
func TestCallArgRegStartAapcs64SkipsFloats() testing.TestResult {
	var cc CallConv = AAPCS64()
	var argTypes @[]@types.Type = make_slice(@types.Type, 3)
	argTypes[0] = types.TypInt()
	argTypes[1] = types.TypFloat64()
	argTypes[2] = types.MakeSliceType(types.TypUint8())
	if cc.CallArgRegStart(argTypes, 0) != 0 {
		return "int arg should be at X0"
	}
	if cc.CallArgRegStart(argTypes, 1) != -1 {
		return "float arg should not consume X-regs (regStart -1)"
	}
	if cc.CallArgRegStart(argTypes, 2) != 1 {
		return "slice after float should start at X1, not X2"
	}
	if cc.CallStackBytes(argTypes) != 0 {
		return "no stack args expected for (int, float, *[]u8)"
	}
	return ""
}

// The first NumFpArgRegs floats ride the FP register file; a further float
// overflows to the outgoing-args stack (one 8-byte word) just like any arg past
// its register budget.  Pins the NSRN-overflow path the convention layer gained
// for the >8-float miscompile (plan-fp-arg-stack-overflow).
func TestCallArgFloatOverflowAapcs64() testing.TestResult {
	var cc CallConv = AAPCS64() // 8 FP arg regs (D0..D7)
	var ts @[]@types.Type = make_slice(@types.Type, 10)
	for i := 0; i < 10; i++ { ts[i] = types.TypFloat64() }
	// The first 8 floats ride D0..D7: no GP reg, no stack.
	for i := 0; i < 8; i++ {
		if cc.CallArgRegStart(ts, i) != -1 {
			return "in-reg float should not consume a GP reg"
		}
		if cc.CallArgStackOff(ts, i) != -1 {
			return "in-reg float should have no stack slot"
		}
	}
	if cc.CallArgStackOff(ts, 8) != 0 {
		return "9th float should overflow to stack offset 0"
	}
	if cc.CallArgStackOff(ts, 9) != 8 {
		return "10th float should overflow to stack offset 8"
	}
	if cc.CallStackBytes(ts) != 16 {
		return "two overflow floats should need 16 stack bytes"
	}
	return ""
}

// SysV-AMD64 also has 8 FP arg regs (XMM0..XMM7); same overflow contract.
func TestCallArgFloatOverflowSysV() testing.TestResult {
	var cc CallConv = SysV_AMD64()
	var ts @[]@types.Type = make_slice(@types.Type, 10)
	for i := 0; i < 10; i++ { ts[i] = types.TypFloat64() }
	if cc.CallArgStackOff(ts, 7) != -1 {
		return "8th float should still ride XMM7 (no stack)"
	}
	if cc.CallArgStackOff(ts, 8) != 0 {
		return "9th float should overflow to stack offset 0"
	}
	if cc.CallArgStackOff(ts, 9) != 8 {
		return "10th float should overflow to stack offset 8"
	}
	if cc.CallStackBytes(ts) != 16 {
		return "two overflow floats should need 16 stack bytes"
	}
	return ""
}

// Apple-AArch64 (AAPCS64_Darwin, NaturalSizeStackArgs) packs a FIXED narrow
// int32 stack arg at its natural 4-byte stride — three overflow int32 sit at
// offsets 0, 4, 8 and need 16 stack bytes (rounded).  Linux AAPCS64 and SysV
// round each to 8 (StackArgNarrow4 is false there).
func TestStackArgNaturalSizeAapcs64Darwin() testing.TestResult {
	var cc CallConv = AAPCS64_Darwin()
	var ts @[]@types.Type = make_slice(@types.Type, 11)
	for i := 0; i < 11; i++ { ts[i] = types.TypInt32() }
	if cc.CallArgStackOff(ts, 8) != 0 {
		return "9th int32 should be at stack offset 0"
	}
	if cc.CallArgStackOff(ts, 9) != 4 {
		return "10th int32 should be at the natural 4-byte offset"
	}
	if cc.CallArgStackOff(ts, 10) != 8 {
		return "11th int32 should be at offset 8"
	}
	if cc.CallStackBytes(ts) != 16 {
		return "three 4-byte stack int32 should need 16 bytes"
	}
	if !cc.StackArgNarrow4(types.TypInt32(), false) {
		return "a fixed int32 should be narrow-4 on AAPCS64_Darwin"
	}
	if cc.StackArgNarrow4(types.TypInt64(), false) {
		return "an int64 (8 bytes) should NOT be narrow-4"
	}
	if cc.StackArgNarrow4(types.TypInt32(), true) {
		return "a VARIADIC int32 should NOT be narrow-4"
	}
	if AAPCS64().StackArgNarrow4(types.TypInt32(), false) {
		return "Linux AAPCS64 rounds stack args to 8 (not narrow-4)"
	}
	if SysV_AMD64().StackArgNarrow4(types.TypInt32(), false) {
		return "SysV rounds stack args to 8 (not narrow-4)"
	}
	return ""
}

// Apple-AArch64 packs int8 / int16 stack args at their natural 1 / 2-byte size
// and alignment too (not just int32's 4).  After 8 int fillers, a run of
// int8, int16, int32, int8, int16, int32 overflow at offsets 0, 2, 4, 8, 10, 12
// (each re-aligned to its own size), needing 16 stack bytes.  StackArgStoreSize
// returns the matching store width; on non-natural conventions everything is 8.
func TestStackArgNaturalSizeSubWord() testing.TestResult {
	var cc CallConv = AAPCS64_Darwin()
	var ts @[]@types.Type = make_slice(@types.Type, 14)
	for i := 0; i < 8; i++ { ts[i] = types.TypInt() }
	ts[8] = types.TypInt8()
	ts[9] = types.TypInt16()
	ts[10] = types.TypInt32()
	ts[11] = types.TypInt8()
	ts[12] = types.TypInt16()
	ts[13] = types.TypInt32()
	if cc.CallArgStackOff(ts, 8) != 0 {
		return "int8 should be at stack offset 0"
	}
	if cc.CallArgStackOff(ts, 9) != 2 {
		return "int16 should be 2-aligned at offset 2"
	}
	if cc.CallArgStackOff(ts, 10) != 4 {
		return "int32 should be 4-aligned at offset 4"
	}
	if cc.CallArgStackOff(ts, 11) != 8 {
		return "second int8 should be at offset 8"
	}
	if cc.CallArgStackOff(ts, 12) != 10 {
		return "second int16 should be 2-aligned at offset 10"
	}
	if cc.CallArgStackOff(ts, 13) != 12 {
		return "second int32 should be 4-aligned at offset 12"
	}
	if cc.CallStackBytes(ts) != 16 {
		return "the six narrow args should pack into 16 stack bytes"
	}
	if cc.StackArgStoreSize(types.TypInt8(), false) != 1 {
		return "int8 stack store width should be 1"
	}
	if cc.StackArgStoreSize(types.TypInt16(), false) != 2 {
		return "int16 stack store width should be 2"
	}
	if cc.StackArgStoreSize(types.TypInt32(), false) != 4 {
		return "int32 stack store width should be 4"
	}
	if cc.StackArgStoreSize(types.TypInt64(), false) != 8 {
		return "int64 stack store width should be 8"
	}
	if cc.StackArgStoreSize(types.TypInt8(), true) != 8 {
		return "a VARIADIC int8 takes the full 8-byte slot"
	}
	if AAPCS64().StackArgStoreSize(types.TypInt8(), false) != 8 {
		return "Linux AAPCS64 rounds an int8 stack arg to 8"
	}
	return ""
}

// A narrow stack arg followed by an 8-byte one re-aligns to 8 (leaving a gap),
// matching Apple-AArch64: int32, int64, int32 overflow land at 0, 8, 16.
func TestStackArgNaturalSizeMixedAlign() testing.TestResult {
	var cc CallConv = AAPCS64_Darwin()
	// 8 int (8-byte) fill X0..X7, then int32, int64, int32 overflow.
	var ts @[]@types.Type = make_slice(@types.Type, 11)
	for i := 0; i < 8; i++ { ts[i] = types.TypInt() }
	ts[8] = types.TypInt32()
	ts[9] = types.TypInt64()
	ts[10] = types.TypInt32()
	if cc.CallArgStackOff(ts, 8) != 0 {
		return "int32 should be at stack offset 0"
	}
	if cc.CallArgStackOff(ts, 9) != 8 {
		return "int64 should be 8-aligned at offset 8 (after the 4-byte int32)"
	}
	if cc.CallArgStackOff(ts, 10) != 16 {
		return "trailing int32 should be at offset 16"
	}
	return ""
}

// Mixed GP + FP overflow must share ONE arg-ordered stack tally, not two.  On
// AAPCS64 (8 GP + 8 FP regs): 9 ints then 9 floats — the 9th int (index 8) is
// the first stack word (offset 0) and the 9th float (index 17) the second
// (offset 8, after the int), so the stack words interleave by argument order.
func TestCallArgMixedOverflowAapcs64() testing.TestResult {
	var cc CallConv = AAPCS64()
	var ts @[]@types.Type = make_slice(@types.Type, 18)
	for i := 0; i < 9; i++ { ts[i] = types.TypInt() }
	for i := 9; i < 18; i++ { ts[i] = types.TypFloat64() }
	if cc.CallArgStackOff(ts, 8) != 0 {
		return "9th int should overflow to stack offset 0"
	}
	if cc.CallArgStackOff(ts, 17) != 8 {
		return "9th float should overflow to stack offset 8 (after the int)"
	}
	if cc.CallStackBytes(ts) != 16 {
		return "one GP + one FP overflow word should need 16 stack bytes"
	}
	return ""
}

// (int, @[]int): 1 + 4 = 5 words, fits in X0..X4, zero stack.
func TestCallStackBytesAapcs64AllInRegs() testing.TestResult {
	var cc CallConv = AAPCS64()
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt()
	ts[1] = types.MakeManagedSliceType(types.TypInt())
	if cc.CallStackBytes(ts) != 0 {
		return "all-fit args should need 0 stack bytes"
	}
	if cc.CallArgRegStart(ts, 0) != 0 { return "arg 0 should be at X0" }
	if cc.CallArgRegStart(ts, 1) != 1 { return "arg 1 should start at X1" }
	if cc.CallArgStackOff(ts, 0) != -1 {
		return "arg 0 should not be on stack"
	}
	return ""
}

// (@[]int, Entry5w): both args are > 16 bytes (32 and 40), so each
// passes as an indirect pointer occupying ONE GP arg reg.  Slice's
// pointer goes in X0, Entry's pointer in X1.  Pins the textbook
// AAPCS § 5.4.2 "passed by reference" lowering that LLVM's
// `ptr byval(<T>) align 8` emits.
func TestCallArgIndirectLargeAggregateAapcs64() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.MakeManagedSliceType(types.TypInt64())
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt64()
	var entry @types.Type = types.MakeStructType("Entry", fields)
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.MakeManagedSliceType(types.TypInt64())
	ts[1] = entry
	if cc.CallArgRegStart(ts, 0) != 0 {
		return "32-byte managed-slice (> 16) should be indirect: pointer in X0"
	}
	if cc.CallArgStackOff(ts, 0) != -1 {
		return "indirect pointer fits in reg, no stack portion"
	}
	if cc.CallArgRegStart(ts, 1) != 1 {
		return "40-byte Entry (> 16) should be indirect: pointer in X1"
	}
	if cc.CallArgStackOff(ts, 1) != -1 {
		return "indirect pointer fits in reg, no stack portion"
	}
	if cc.CallStackBytes(ts) != 0 {
		return "both args indirect-in-reg → zero outgoing stack"
	}
	return ""
}

// (Tup8w, int): Tup is 64 bytes (> 16) → indirect pointer in X0;
// int takes X1 (one reg consumed for Tup's pointer leaves 7 free).
// Confirms IndirectLargeAggregates compresses any large aggregate
// to a single reg/stack slot regardless of its byte size.
func TestCallArgIndirectLargeAggregatePointerOnly() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var fields @[]@types.Field = make_slice(@types.Field, 8)
	for i := 0; i < 8; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var tup @types.Type = types.MakeStructType("Tup8", fields)
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = tup
	ts[1] = types.TypInt64()
	if cc.CallArgRegStart(ts, 0) != 0 {
		return "Tup8 (64 bytes, > 16) should be indirect pointer in X0"
	}
	if cc.CallArgStackOff(ts, 0) != -1 {
		return "indirect pointer fits in X0, no stack"
	}
	if cc.CallArgRegStart(ts, 1) != 1 {
		return "int after a single-reg indirect aggregate should take X1"
	}
	if cc.CallArgStackOff(ts, 1) != -1 {
		return "int still fits in regs"
	}
	return ""
}

// 9 scalar ints: X0..X7 used, 9th overflows to stack[0].
func TestCallStackBytesAapcs64ScalarOverflow() testing.TestResult {
	var cc CallConv = AAPCS64()
	var ts @[]@types.Type = make_slice(@types.Type, 9)
	for i := 0; i < 9; i++ {
		ts[i] = types.TypInt()
	}
	if cc.CallArgRegStart(ts, 7) != 7 { return "arg 7 should be in X7" }
	if cc.CallArgRegStart(ts, 8) != -1 { return "arg 8 should overflow" }
	if cc.CallArgStackOff(ts, 8) != 0 {
		return "arg 8 stack offset should be 0"
	}
	if cc.CallStackBytes(ts) != 16 {
		return "1-word stack arg should pad to 16 bytes"
	}
	return ""
}

// ============================================================
// CallArgRegStart / CallArgStackOff / CallStackBytes (SysV shape)
// ============================================================
//
// These pin behaviour that depends on the parameterised loop
// terminating at cc.NumGpArgRegs rather than the hardcoded 8 that
// AAPCS64-only tests would happily accept.

// 7 ints under SysV: arg 5 → R9 (last GP arg reg), arg 6 overflows.
// Same signature under AAPCS64 keeps every arg in regs.
func TestCallArgRegStartSysVOverflowAtSeven() testing.TestResult {
	var cc CallConv = SysV_AMD64()
	var ts @[]@types.Type = make_slice(@types.Type, 7)
	for i := 0; i < 7; i++ {
		ts[i] = types.TypInt()
	}
	if cc.CallArgRegStart(ts, 5) != 5 {
		return "arg 5 should land in the 6th GP arg reg"
	}
	if cc.CallArgRegStart(ts, 6) != -1 {
		return "arg 6 should overflow to stack under SysV (NumGpArgRegs=6)"
	}
	if cc.CallArgStackOff(ts, 6) != 0 {
		return "arg 6 stack offset should be 0"
	}
	if cc.CallStackBytes(ts) != 16 {
		return "1-word stack overflow should round up to 16-byte stack align"
	}
	return ""
}

// SysV indirect-large: a managed-slice (32 B > AggregateInRegMax)
// passes as a single pointer in the next free GP arg reg.  Matches
// pkg/codegen's plain-`ptr` emission for >16-byte aggregates and
// LLVM x86_64's lowering thereof.
func TestCallArgIndirectLargeAggregateSysV() testing.TestResult {
	setTarget64()
	var cc CallConv = SysV_AMD64()
	var ts @[]@types.Type = make_slice(@types.Type, 4)
	ts[0] = types.TypInt64()
	ts[1] = types.TypInt64()
	ts[2] = types.TypInt64()
	ts[3] = types.MakeManagedSliceType(types.TypInt64())
	if cc.CallArgRegStart(ts, 3) != 3 {
		return "32-byte managed-slice pointer should take RCX (slot 3)"
	}
	if cc.CallArgStackOff(ts, 3) != -1 {
		return "indirect pointer fits in reg, no stack portion"
	}
	if cc.CallStackBytes(ts) != 0 {
		return "all args in regs → zero outgoing stack"
	}
	return ""
}

// SysV no-split: a ≤ 16 B aggregate that doesn't fit in the remaining
// GP arg regs goes wholly to MEMORY, leaving NGRN unchanged so a
// later scalar can take the still-free reg.  AAPCS64 would split.
func TestCallArgSysVNoSplitFallsToMemory() testing.TestResult {
	setTarget64()
	var cc CallConv = SysV_AMD64()
	// 5 ints (NGRN advances to 5), then a 16-byte raw slice (2 words).
	// 5 + 2 > 6, so SysV puts the slice in MEMORY and leaves NGRN = 5.
	// A trailing scalar then takes reg 5 (R9), proving NGRN unchanged.
	var ts @[]@types.Type = make_slice(@types.Type, 7)
	for i := 0; i < 5; i++ {
		ts[i] = types.TypInt64()
	}
	ts[5] = types.MakeSliceType(types.TypInt64())
	ts[6] = types.TypInt64()
	if cc.CallArgRegStart(ts, 5) != -1 {
		return "16-byte raw slice in MEMORY when 2 regs aren't free "
			"under SysV"
	}
	if cc.CallArgStackOff(ts, 5) != 0 {
		return "MEMORY raw slice starts at outgoing-args offset 0"
	}
	if cc.CallArgRegStart(ts, 6) != 5 {
		return "trailing scalar takes the still-free 6th GP reg "
			"(NGRN unchanged by MEMORY)"
	}
	if cc.CallStackBytes(ts) != 16 {
		return "2-word MEMORY aggregate consumes 16 bytes"
	}
	return ""
}

// SysV fits-in-regs: a ≤ 16 B aggregate (16-byte raw slice) that fits
// in the remaining GP arg regs lands wholly in regs — no stack
// portion — matching SysV's 2-eightbyte INTEGER classification.
func TestCallArgSysVRawSliceFitsInRegs() testing.TestResult {
	var cc CallConv = SysV_AMD64()
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt()
	ts[1] = types.MakeSliceType(types.TypUint8())
	if cc.CallArgRegStart(ts, 1) != 1 {
		return "raw slice arg 1 should start at GP reg 1 (RSI)"
	}
	if cc.CallArgStackOff(ts, 1) != -1 {
		return "raw slice fully in regs → no stack portion"
	}
	if cc.CallStackBytes(ts) != 0 {
		return "all-in-regs call has zero outgoing-args bytes"
	}
	return ""
}

// 6 ints (NGRN = 6), then a 32-byte managed-slice.  Under the
// indirect-large rule, the slice's pointer takes X6 — one reg,
// no stack overflow.  Earlier shapes split the slice across X6..X7
// + stack, but textbook AAPCS § 5.4.2 passes large aggregates by
// reference, matching LLVM's `ptr byval(<T>)` lowering.
func TestCallArgIndirectAfterExhaustingScalarsAapcs64() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var ts @[]@types.Type = make_slice(@types.Type, 7)
	for i := 0; i < 6; i++ {
		ts[i] = types.TypInt64()
	}
	ts[6] = types.MakeManagedSliceType(types.TypInt64())
	if cc.CallArgRegStart(ts, 6) != 6 {
		return "32-byte managed-slice pointer should take X6"
	}
	if cc.CallArgStackOff(ts, 6) != -1 {
		return "indirect pointer fits in remaining reg, no stack"
	}
	if cc.CallStackBytes(ts) != 0 {
		return "all args in regs → zero outgoing stack"
	}
	return ""
}

// Floats still skip GP-reg budget under SysV.
func TestCallArgRegStartSysVSkipsFloats() testing.TestResult {
	var cc CallConv = SysV_AMD64()
	var ts @[]@types.Type = make_slice(@types.Type, 3)
	ts[0] = types.TypInt()
	ts[1] = types.TypFloat64()
	ts[2] = types.TypInt()
	if cc.CallArgRegStart(ts, 0) != 0 {
		return "int arg 0 should land in the 1st GP arg reg"
	}
	if cc.CallArgRegStart(ts, 1) != -1 {
		return "float arg 1 should not consume GP arg reg budget"
	}
	if cc.CallArgRegStart(ts, 2) != 1 {
		return "int arg 2 should land in the 2nd GP arg reg (float skipped)"
	}
	return ""
}

// ============================================================
// AAPCS32 (32-bit ARM, base soft-float) — word size + pair rule
// ============================================================
//
// These exercise the ILP32 additions to the CallConv engine: WordBytes
// (4), cc.ArgWords (64-bit scalar = 2 words), the even-aligned register
// pair rule for 8-byte args, NCRN saturation on overflow, soft-float
// (floats ride GP registers), and the >4-byte aggregate sret threshold.
// setTarget32() pins the ILP32 layout so SizeOf / AlignOf report 4-byte
// int / pointer.

// cc.ArgWords rounds in WordBytes-sized words: on ILP32 a 64-bit scalar
// is 2 words and a 16-byte managed-slice is 4, while the LP64 free
// ArgWords still counts an int64 scalar as 1 word.
func TestAapcs32ArgWords() testing.TestResult {
	setTarget32()
	var cc CallConv = AAPCS32()
	if cc.ArgWords(types.TypInt32()) != 1 { return "int32 is 1 word on ILP32" }
	if cc.ArgWords(types.TypChar()) != 1 { return "char is 1 word" }
	if cc.ArgWords(types.TypInt64()) != 2 { return "int64 is 2 words on ILP32" }
	if cc.ArgWords(types.TypFloat64()) != 2 { return "float64 is 2 words on ILP32" }
	if cc.ArgWords(types.TypFloat32()) != 1 { return "float32 is 1 word on ILP32" }
	if cc.ArgWords(types.MakeManagedSliceType(types.TypInt())) != 4 {
		return "16-byte managed-slice is 4 words on ILP32"
	}
	if ArgWords(types.TypInt64()) != 1 {
		return "free ArgWords (LP64) still counts int64 as 1 word"
	}
	return ""
}

// A 64-bit argument takes an even-aligned register pair; an odd NCRN is
// rounded up, wasting the odd register.  (int32, int64): int32 -> r0
// (NCRN 1), int64 needs even -> r2:r3 (r1 wasted).  No stack.
func TestAapcs32EvenPairAlignment() testing.TestResult {
	setTarget32()
	var cc CallConv = AAPCS32()
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt32()
	ts[1] = types.TypInt64()
	if cc.CallArgRegStart(ts, 0) != 0 { return "int32 arg should be at r0" }
	if cc.CallArgRegStart(ts, 1) != 2 {
		return "int64 after int32 should start at r2 (r1 wasted for even alignment)"
	}
	if cc.CallArgStackOff(ts, 1) != -1 { return "int64 fits in r2:r3, no stack" }
	if cc.CallStackBytes(ts) != 0 { return "(int32,int64) fits in registers" }
	return ""
}

// A 64-bit argument already at an even NCRN needs no pad: (int64, int32)
// -> int64 in r0:r1 (NCRN 2), int32 in r2.
func TestAapcs32PairNoPadWhenEven() testing.TestResult {
	setTarget32()
	var cc CallConv = AAPCS32()
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt64()
	ts[1] = types.TypInt32()
	if cc.CallArgRegStart(ts, 0) != 0 { return "int64 should be at r0:r1" }
	if cc.CallArgRegStart(ts, 1) != 2 { return "int32 after int64 should be at r2" }
	if cc.CallStackBytes(ts) != 0 { return "(int64,int32) fits in registers" }
	return ""
}

// When a 64-bit arg can't fit the remaining even pair it goes to an
// 8-aligned stack slot and NCRN saturates so later args also stack (AAPCS
// §6.5 C.6).  (int32 x3, int64, int32): three int32 -> r0,r1,r2 (NCRN 3);
// int64 needs even -> 4 -> stack[0]; trailing int32 -> stack[8] (NCRN
// saturated, r3 wasted).
func TestAapcs32PairOverflowSaturatesNcrn() testing.TestResult {
	setTarget32()
	var cc CallConv = AAPCS32()
	var ts @[]@types.Type = make_slice(@types.Type, 5)
	ts[0] = types.TypInt32()
	ts[1] = types.TypInt32()
	ts[2] = types.TypInt32()
	ts[3] = types.TypInt64()
	ts[4] = types.TypInt32()
	if cc.CallArgRegStart(ts, 2) != 2 { return "3rd int32 should be in r2" }
	if cc.CallArgRegStart(ts, 3) != -1 { return "int64 can't fit even pair -> stack" }
	if cc.CallArgStackOff(ts, 3) != 0 { return "int64 at 8-aligned stack offset 0" }
	if cc.CallArgRegStart(ts, 4) != -1 {
		return "trailing int32 stacks (NCRN saturated, r3 wasted)"
	}
	if cc.CallArgStackOff(ts, 4) != 8 { return "trailing int32 at stack offset 8" }
	if cc.CallStackBytes(ts) != 16 {
		return "int64 (8) + int32 (4) = 12, rounded to StackAlign 8 -> 16"
	}
	return ""
}

// Soft-float: a float rides GP registers (no FP file).  (float64, float64):
// float64 -> r0:r1, float64 -> r2:r3; a third float64 stacks.
func TestAapcs32SoftFloatInGpRegs() testing.TestResult {
	setTarget32()
	var cc CallConv = AAPCS32()
	var ts @[]@types.Type = make_slice(@types.Type, 3)
	ts[0] = types.TypFloat64()
	ts[1] = types.TypFloat64()
	ts[2] = types.TypFloat64()
	if cc.CallArgRegStart(ts, 0) != 0 { return "1st float64 should ride r0:r1 (soft-float)" }
	if cc.CallArgRegStart(ts, 1) != 2 { return "2nd float64 should ride r2:r3" }
	if cc.CallArgRegStart(ts, 2) != -1 { return "3rd float64 overflows to stack" }
	if cc.CallArgStackOff(ts, 2) != 0 { return "3rd float64 at 8-aligned stack offset 0" }
	if cc.CallStackBytes(ts) != 8 { return "one overflow float64 -> 8 stack bytes" }
	return ""
}

// A float32 is a single GP word (soft-float) with no pair alignment.
func TestAapcs32SoftFloat32NoPair() testing.TestResult {
	setTarget32()
	var cc CallConv = AAPCS32()
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt32()
	ts[1] = types.TypFloat32()
	if cc.CallArgRegStart(ts, 1) != 1 { return "float32 after int32 -> r1 (no pair pad)" }
	if cc.CallStackBytes(ts) != 0 { return "(int32,float32) fits in registers" }
	return ""
}

// A base-AAPCS aggregate splits across r0-r3 and the stack (not by
// reference).  A 24-byte struct (6 int32 words) as the sole arg: r0-r3
// (4 words) + 2 words on the stack.
// A >16-byte aggregate is passed as a single pointer in the next GP reg
// (IndirectLargeAggregates), matching codegen's uniform plain-`ptr` byval
// lowering — NOT split across r0-r3 + stack.  A 24-byte struct as the sole
// arg: pointer in r0, no stack.
func TestAapcs32IndirectLargeAggregate() testing.TestResult {
	setTarget32()
	var cc CallConv = AAPCS32()
	var fields @[]@types.Field = make_slice(@types.Field, 6)
	for i := 0; i < 6; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt32()
	}
	var s @types.Type = types.MakeStructType("Six", fields)  // 24 bytes > 16
	var ts @[]@types.Type = make_slice(@types.Type, 1)
	ts[0] = s
	if cc.CallArgRegStart(ts, 0) != 0 { return "24-byte struct pointer should be in r0" }
	if cc.CallArgStackOff(ts, 0) != -1 { return "indirect pointer fits in r0, no stack" }
	if cc.CallStackBytes(ts) != 0 { return "indirect aggregate -> zero outgoing stack" }
	return ""
}

// A <=16-byte aggregate that doesn't fit the remaining GP regs SPLITS
// across r0-r3 and the stack (SplitAggregates, NOT indirect).  After two
// int32 (r0,r1), a 16-byte (4-word) struct takes r2,r3 + 2 stack words.
func TestAapcs32SmallAggregateSplit() testing.TestResult {
	setTarget32()
	var cc CallConv = AAPCS32()
	var fields @[]@types.Field = make_slice(@types.Field, 4)
	for i := 0; i < 4; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt32()
	}
	var s @types.Type = types.MakeStructType("Quad", fields)  // 16 bytes = AggregateInRegMax
	var ts @[]@types.Type = make_slice(@types.Type, 3)
	ts[0] = types.TypInt32()
	ts[1] = types.TypInt32()
	ts[2] = s
	if cc.CallArgRegStart(ts, 2) != 2 { return "split struct should start at r2" }
	if cc.CallArgStackOff(ts, 2) != 0 { return "the 2 overflow words start at stack offset 0" }
	if cc.CallStackBytes(ts) != 8 { return "2 overflow words -> 8 stack bytes" }
	return ""
}

// An 8-byte-aligned AGGREGATE (a struct containing an int64) obeys the
// even-register-pair rule like a bare 64-bit scalar: after an int32 (r0)
// it starts at r2 (r1 wasted), occupying r2:r3.
func TestAapcs32AggregateEvenPair() testing.TestResult {
	setTarget32()
	var cc CallConv = AAPCS32()
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt64()
	var s @types.Type = types.MakeStructType("Wrap64", fields)  // 8 bytes, align 8
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt32()
	ts[1] = s
	if cc.CallArgRegStart(ts, 1) != 2 {
		return "8-aligned struct after int32 should start at r2 (r1 wasted)"
	}
	if cc.CallArgStackOff(ts, 1) != -1 { return "struct fits in r2:r3, no stack" }
	if cc.CallStackBytes(ts) != 0 { return "(int32, 8-aligned struct) fits in registers" }
	return ""
}

// After a SPLIT aggregate (some words in regs, rest on stack) NCRN
// saturates to r4, so a trailing scalar also stacks (AAPCS §6.5 C.6)
// rather than backfilling a free register.  int32 (r0), then a 16-byte
// struct splits r1,r2,r3 + 1 stack word, then a trailing int32 stacks.
func TestAapcs32SplitAggregateSaturatesNcrn() testing.TestResult {
	setTarget32()
	var cc CallConv = AAPCS32()
	var fields @[]@types.Field = make_slice(@types.Field, 4)
	for i := 0; i < 4; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt32()
	}
	var s @types.Type = types.MakeStructType("Quad", fields)  // 16 bytes, 4 words
	var ts @[]@types.Type = make_slice(@types.Type, 3)
	ts[0] = types.TypInt32()
	ts[1] = s
	ts[2] = types.TypInt32()
	if cc.CallArgRegStart(ts, 1) != 1 { return "split struct should start at r1" }
	if cc.CallArgStackOff(ts, 1) != 0 { return "struct overflow word at stack offset 0" }
	if cc.CallArgRegStart(ts, 2) != -1 {
		return "trailing int32 must stack (NCRN saturated by the split), not backfill"
	}
	if cc.CallArgStackOff(ts, 2) != 4 { return "trailing int32 at stack offset 4" }
	return ""
}

// argNeeds8Align: 64-bit scalars and 8-aligned aggregates need double-word
// alignment; 32-bit scalars and 4-aligned aggregates do not.
func TestArgNeeds8Align() testing.TestResult {
	setTarget32()
	if !argNeeds8Align(types.TypInt64()) { return "int64 needs 8-align" }
	if !argNeeds8Align(types.TypFloat64()) { return "float64 needs 8-align" }
	if argNeeds8Align(types.TypInt32()) { return "int32 does not need 8-align" }
	if argNeeds8Align(types.TypChar()) { return "char does not need 8-align" }
	var f8 @[]@types.Field = make_slice(@types.Field, 1)
	f8[0] = make(types.Field)
	f8[0].Type = types.TypInt64()
	if !argNeeds8Align(types.MakeStructType("W64", f8)) {
		return "struct{int64} needs 8-align"
	}
	var f4 @[]@types.Field = make_slice(@types.Field, 1)
	f4[0] = make(types.Field)
	f4[0].Type = types.TypInt32()
	if argNeeds8Align(types.MakeStructType("W32", f4)) {
		return "struct{int32} does not need 8-align"
	}
	return ""
}
