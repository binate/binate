package "pkg/binate/native/common"

import "pkg/binate/types"

// Variadic-aware call-argument dispatch (the V-variants of
// CallArgRegStart / CallArgStackOff / CallStackBytes).  Split out of
// common_callconv.bn for file length; the shared classifier
// (argRegWordsStackWords / advanceNgrn / advanceNsrn /
// stackArgFootprint) and the non-V walkers live there.

// ============================================================
// Variadic-aware dispatch (V-variants)
// ============================================================
//
// Mathematically identical to the non-V helpers when fixedCount =
// len(argTypes) (k == fixedCount never holds during the k <= i / k <
// len loop), so non-variadic callers see no behavior change.  The
// arm64 backend instantiates AAPCS64_Darwin() (VariadicStackOnly =
// true) and routes OP_C_CALL through these helpers with fixedCount =
// ins.CFixedArgs, so a variadic arg at value-index >= CFixedArgs is
// forced to the stack per Apple's rule.
//
// The rule is enforced by closing BOTH argument register files at the
// fixed/variadic boundary: ngrn = NumGpArgRegs AND nsrn = NumFpArgRegs.
// With both cursors saturated, every subsequent variadic argument —
// integer, float scalar, OR homogeneous float aggregate — overflows to
// the stack through the ordinary argRegWordsStackWords path (an HFA sees
// no room in the FP file and goes entirely on the stack), matching what
// clang's arm64-apple caller emits.  Verified on the native lanes by
// conformance/498 (non-variadic), 500 (single vararg), 527 (multi-
// vararg), 530 (stacked vararg), and e2e/c-call-variadic-hfa.sh (a real
// C va_arg callee reading a variadic HFA), on both aa64 and x64.

// variadicEffType is the type the V-walkers CLASSIFY arg t as.  For a
// VariadicFloatInGp ABI (arm32 hard-float) a float scalar in the variadic
// portion is passed like its same-width integer — GP core registers / stack,
// never VFP (AAPCS-VFP passes variadic args by the base standard).  Returning
// the uint type makes both the placement AND the NGRN/NSRN advance fall out of
// the existing GP logic unchanged: a uint is not IsFloatScalarTyp, so
// advanceNsrn won't consume a VFP slot and advanceNgrn consumes its GP words.
// Every other case (non-variadic, non-hard-float, or a VariadicStackOnly ABI)
// returns t unchanged, so no other backend's behavior moves.
func (cc CallConv) variadicEffType(t @types.Type, isVariadic bool) @types.Type {
	if isVariadic && cc.VariadicFloatInGp && IsFloatScalarTyp(t) {
		if FloatScalarIsI32(t) { return types.TypUint32() }
		return types.TypUint64()
	}
	return t
}

// CallArgRegStartV: see CallArgRegStart.  fixedCount marks the
// fixed/variadic split.
func (cc CallConv) CallArgRegStartV(argTypes @[]@types.Type, i int, fixedCount int) int {
	var ngrn int = 0
	var nsrn int = 0
	for k := 0; k <= i; k++ {
		if k == fixedCount && cc.VariadicStackOnly {
			// Close both register files: variadic ints, floats, AND HFAs
			// then overflow to the stack (see the file header).
			ngrn = cc.NumGpArgRegs
			nsrn = cc.NumFpArgRegs
		}
		var et @types.Type = cc.variadicEffType(argTypes[k], k >= fixedCount)
		rs, rw, sw := cc.argRegWordsStackWords(et, ngrn, nsrn)
		if k == i { return rs }
		nsrn = cc.advanceNsrn(et, ngrn, nsrn)
		ngrn = cc.advanceNgrn(et, ngrn, rs, rw, sw)
	}
	return -1
}

// CallArgStackOffV: see CallArgStackOff.  fixedCount marks the
// fixed/variadic split.
func (cc CallConv) CallArgStackOffV(argTypes @[]@types.Type, i int, fixedCount int) int {
	var ngrn int = 0
	var nsrn int = 0
	var soff int = 0
	for k := 0; k <= i; k++ {
		if k == fixedCount && cc.VariadicStackOnly {
			// Close both register files: variadic ints, floats, AND HFAs
			// then overflow to the stack (see the file header).
			ngrn = cc.NumGpArgRegs
			nsrn = cc.NumFpArgRegs
		}
		var et @types.Type = cc.variadicEffType(argTypes[k], k >= fixedCount)
		rs, rw, sw := cc.argRegWordsStackWords(et, ngrn, nsrn)
		align, bytes := cc.stackArgFootprint(et, sw, k >= fixedCount)
		if sw > 0 {
			soff = alignUpStack(soff, align)
			if k == i { return soff }
			soff = soff + bytes
		} else if k == i {
			return -1
		}
		nsrn = cc.advanceNsrn(et, ngrn, nsrn)
		ngrn = cc.advanceNgrn(et, ngrn, rs, rw, sw)
	}
	return -1
}

// CallStackBytesV: see CallStackBytes.  fixedCount marks the
// fixed/variadic split.
func (cc CallConv) CallStackBytesV(argTypes @[]@types.Type, fixedCount int) int {
	var ngrn int = 0
	var nsrn int = 0
	var soff int = 0
	for k := 0; k < len(argTypes); k++ {
		if k == fixedCount && cc.VariadicStackOnly {
			// Close both register files: variadic ints, floats, AND HFAs
			// then overflow to the stack (see the file header).
			ngrn = cc.NumGpArgRegs
			nsrn = cc.NumFpArgRegs
		}
		var et @types.Type = cc.variadicEffType(argTypes[k], k >= fixedCount)
		rs, rw, sw := cc.argRegWordsStackWords(et, ngrn, nsrn)
		if sw > 0 {
			align, bytes := cc.stackArgFootprint(et, sw, k >= fixedCount)
			soff = alignUpStack(soff, align) + bytes
		}
		nsrn = cc.advanceNsrn(et, ngrn, nsrn)
		ngrn = cc.advanceNgrn(et, ngrn, rs, rw, sw)
	}
	if cc.StackAlign > 1 && soff % cc.StackAlign != 0 {
		soff = soff + (cc.StackAlign - soff % cc.StackAlign)
	}
	return soff
}
