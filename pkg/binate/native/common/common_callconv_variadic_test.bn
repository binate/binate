package "pkg/binate/native/common"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the V-variant walkers in common_callconv_variadic.bn
// (CallArgRegStartV / CallArgStackOffV / CallStackBytesV): the
// variadic __c_call dispatch that saturates variadic args to the
// stack under AAPCS64_Darwin (VariadicStackOnly) while mirroring the
// non-V walkers under Linux AAPCS64.

// ============================================================
// V-variant dispatch (Stage 4: variadic native __c_call)
// ============================================================

// AAPCS64() (Linux variant) leaves VariadicStackOnly = false; the
// V-variants behave identically to the non-V variants for every
// argument index because the saturation `if k == fixedCount &&
// cc.VariadicStackOnly` never fires.  This is the property we rely
// on to keep non-variadic OP_CALL behaviour unchanged after wiring
// the V-variants into emitCall.
func TestVVariantNoSaturationWithoutDarwin() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	var ts @[]@types.Type = make_slice(@types.Type, 4)
	ts[0] = types.TypInt()
	ts[1] = types.TypInt()
	ts[2] = types.TypInt()
	ts[3] = types.TypInt()
	// fixedCount = 2 (last two are "variadic"), but VariadicStackOnly
	// is false, so all four still land in X0..X3.
	for i := 0; i < 4; i++ {
		var expect int = cc.CallArgRegStart(ts, i)
		var got int = cc.CallArgRegStartV(ts, i, 2)
		if got != expect {
			return "V-variant must mirror non-V when VariadicStackOnly is false"
		}
	}
	if cc.CallStackBytesV(ts, 2) != cc.CallStackBytes(ts) {
		return "V-variant stack bytes must mirror non-V when VariadicStackOnly is false"
	}
	return ""
}

// AAPCS64_Darwin() sets VariadicStackOnly = true.  Fixed args still
// take registers; variadic args (k >= fixedCount) saturate to the
// stack regardless of remaining GP-reg budget.  This is the Apple
// variant of AAPCS-64 — `printf("answer: %d", 42)` puts the format
// string in X0 (fixed) and the int 42 on the stack (variadic).
func TestVVariantSaturatesVariadicArgsToStack() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64_Darwin()
	if !cc.VariadicStackOnly {
		return "AAPCS64_Darwin should set VariadicStackOnly = true"
	}
	// printf-shaped signature: *[]readonly char fixed + int variadic.
	// *[]readonly char is 2 words (raw slice); int is 1 word.
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))
	ts[1] = types.TypInt()
	// fixedCount = 1: the raw slice is fixed (goes in X0+X1), the
	// int is variadic (saturates to stack[0]).
	if cc.CallArgRegStartV(ts, 0, 1) != 0 {
		return "fixed raw-slice arg should start at X0"
	}
	if cc.CallArgRegStartV(ts, 1, 1) != -1 {
		return "variadic int arg should saturate to stack (reg -1)"
	}
	if cc.CallArgStackOffV(ts, 1, 1) != 0 {
		return "variadic int arg should be at stack offset 0"
	}
	if cc.CallStackBytesV(ts, 1) != 16 {
		return "1-word variadic stack arg should reserve 16 bytes (16-aligned)"
	}
	return ""
}

// A variadic FLOAT argument under AAPCS64_Darwin must saturate to the
// stack too — Apple stacks every vararg, floats included.
// argRegWordsStackWords alone reports (-1, 0, 0) for a float (FP reg, no
// stack); the V-variants override that at variadic positions so a
// variadic double reserves an 8-byte stack slot.  Without this it landed
// in D(NSRN) and printf read 0 (printf-variadic-float).  Linux AAPCS64
// (VariadicStackOnly = false) keeps the float in an FP register.
func TestVVariantVariadicFloatSaturatesToStackDarwin() testing.TestResult {
	setTarget64()
	// (int fixed, float64 variadic), fixedCount = 1.
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt()
	ts[1] = types.TypFloat64()
	var dcc CallConv = AAPCS64_Darwin()
	if dcc.CallArgStackOffV(ts, 1, 1) != 0 {
		return "darwin variadic float should be at stack offset 0"
	}
	if dcc.CallStackBytesV(ts, 1) != 16 {
		return "darwin variadic float should reserve 16 bytes (16-aligned)"
	}
	var lcc CallConv = AAPCS64()
	if lcc.CallArgStackOffV(ts, 1, 1) != -1 {
		return "linux variadic float should stay in an FP register (no stack)"
	}
	if lcc.CallStackBytesV(ts, 1) != 0 {
		return "linux variadic float should reserve no stack"
	}
	return ""
}

// When the fixed-arg block already spans a register boundary, the
// variadic saturation must not pull fixed args off-register: only
// args at index >= fixedCount move to stack.  Pins that the
// saturation triggers AT fixedCount, not before.
func TestVVariantFixedArgsKeepRegsUnderDarwin() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64_Darwin()
	var ts @[]@types.Type = make_slice(@types.Type, 4)
	ts[0] = types.TypInt()
	ts[1] = types.TypInt()
	ts[2] = types.TypInt() // first variadic
	ts[3] = types.TypInt()
	// fixedCount = 2: args 0,1 in X0,X1; args 2,3 on stack.
	if cc.CallArgRegStartV(ts, 0, 2) != 0 { return "arg 0 fixed → X0" }
	if cc.CallArgRegStartV(ts, 1, 2) != 1 { return "arg 1 fixed → X1" }
	if cc.CallArgRegStartV(ts, 2, 2) != -1 { return "arg 2 variadic → stack" }
	if cc.CallArgRegStartV(ts, 3, 2) != -1 { return "arg 3 variadic → stack" }
	if cc.CallArgStackOffV(ts, 2, 2) != 0 { return "arg 2 → stack[0]" }
	if cc.CallArgStackOffV(ts, 3, 2) != 8 { return "arg 3 → stack[8]" }
	if cc.CallStackBytesV(ts, 2) != 16 { return "2 variadic ints → 16 bytes" }
	return ""
}

// fixedCount == 0 means EVERY arg is variadic (a call whose `...`
// precedes all value args).  Under AAPCS64_Darwin the saturation
// boundary at k == fixedCount fires on the very first arg, so all
// args go to the stack from index 0.  Pins the fixedCount = 0 edge
// the other V-variant tests (fixedCount >= 1) don't reach.
func TestVVariantAllVariadicSaturatesUnderDarwin() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64_Darwin()
	var ts @[]@types.Type = make_slice(@types.Type, 3)
	ts[0] = types.TypInt()
	ts[1] = types.TypInt()
	ts[2] = types.TypInt()
	// fixedCount = 0: all three are variadic → none take a register.
	if cc.CallArgRegStartV(ts, 0, 0) != -1 {
		return "arg 0 (variadic) should saturate to stack, not X0"
	}
	if cc.CallArgRegStartV(ts, 1, 0) != -1 { return "arg 1 (variadic) → stack" }
	if cc.CallArgRegStartV(ts, 2, 0) != -1 { return "arg 2 (variadic) → stack" }
	// ...and land in consecutive stack slots from offset 0.
	if cc.CallArgStackOffV(ts, 0, 0) != 0 { return "arg 0 → stack[0]" }
	if cc.CallArgStackOffV(ts, 1, 0) != 8 { return "arg 1 → stack[8]" }
	if cc.CallArgStackOffV(ts, 2, 0) != 16 { return "arg 2 → stack[16]" }
	return ""
}

// fixedCount == len(argTypes) means the call is entirely fixed
// (no variadic args at all).  The saturation never fires.  Bytes-
// for-bytes equivalent to calling the non-V variants.
func TestVVariantAllFixedEquivalentToNonV() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64_Darwin()
	var ts @[]@types.Type = make_slice(@types.Type, 3)
	ts[0] = types.TypInt()
	ts[1] = types.TypInt()
	ts[2] = types.TypInt()
	for i := 0; i < 3; i++ {
		if cc.CallArgRegStartV(ts, i, 3) != cc.CallArgRegStart(ts, i) {
			return "fully-fixed V dispatch must mirror non-V"
		}
	}
	if cc.CallStackBytesV(ts, 3) != cc.CallStackBytes(ts) {
		return "fully-fixed V stack bytes must mirror non-V"
	}
	return ""
}

// hfaStruct2 builds a {float64; float64} struct — a 2-member HFA (16 bytes).
func hfaStruct2() @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		fs[i] = make(types.Field)
		fs[i].Type = types.TypFloat64()
	}
	return types.MakeStructType("HfaD2", fs)
}

// A variadic Homogeneous Floating-point Aggregate under AAPCS64_Darwin must
// saturate to the stack — DarwinPCS stacks every vararg, HFAs included, where a
// FIXED HFA would ride v0..v(n-1).  An HFA uses the FP file, so its GP reg start
// is -1 regardless; the discriminator is the STACK offset (a variadic HFA lands
// on the stack, not in v-registers).  Without closing the FP cursor at the
// boundary the HFA silently stayed in v0/v1 and clang's va_arg read garbage.
func TestVVariantVariadicHfaSaturatesToStackDarwin() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64_Darwin()
	cc.HfaAggregates = true // force the HFA classifier on (global gate is target-driven)
	// (int fixed, {f64,f64} HFA variadic), fixedCount = 1.
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt()
	ts[1] = hfaStruct2()
	if cc.CallArgStackOffV(ts, 1, 1) != 0 {
		return "variadic HFA should be at stack offset 0 under DarwinPCS"
	}
	// {f64,f64} = 16 bytes = 2 words, 16-aligned.
	if cc.CallStackBytesV(ts, 1) != 16 {
		return "variadic {f64,f64} HFA should reserve 16 bytes"
	}
	return ""
}

// The fixed/variadic boundary for HFAs: a FIXED HFA still rides the FP file (no
// stack) while a VARIADIC HFA saturates to the stack.  Pins that the fix did not
// break fixed-HFA passing.
func TestVVariantFixedHfaRegsVariadicHfaStacksDarwin() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64_Darwin()
	cc.HfaAggregates = true
	// ({f64,f64} fixed, {f64,f64} variadic), fixedCount = 1.
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = hfaStruct2()
	ts[1] = hfaStruct2()
	if cc.CallArgStackOffV(ts, 0, 1) != -1 {
		return "fixed HFA should ride FP regs (no stack)"
	}
	if cc.CallArgStackOffV(ts, 1, 1) != 0 {
		return "variadic HFA should saturate to stack offset 0"
	}
	if cc.CallStackBytesV(ts, 1) != 16 {
		return "one variadic {f64,f64} HFA should reserve 16 bytes"
	}
	return ""
}

// Linux AAPCS64 (VariadicStackOnly = false) keeps a variadic HFA in the FP
// register file — the saturation is Apple-specific.  Guards against the fix
// leaking into the base standard.
func TestVVariantVariadicHfaStaysInRegsLinux() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64()
	cc.HfaAggregates = true
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt()
	ts[1] = hfaStruct2()
	if cc.CallArgStackOffV(ts, 1, 1) != -1 {
		return "linux variadic HFA should stay in FP regs (no stack)"
	}
	if cc.CallStackBytesV(ts, 1) != 0 {
		return "linux variadic HFA should reserve no stack"
	}
	return ""
}

// A variadic float scalar followed by a variadic HFA: both saturate to the
// stack (the FP cursor is closed once at the boundary) and land in consecutive
// slots.  Exercises the float-and-HFA interaction the single-shape tests miss.
func TestVVariantVariadicFloatThenHfaStacksDarwin() testing.TestResult {
	setTarget64()
	var cc CallConv = AAPCS64_Darwin()
	cc.HfaAggregates = true
	// (int fixed, float64 variadic, {f64,f64} HFA variadic), fixedCount = 1.
	var ts @[]@types.Type = make_slice(@types.Type, 3)
	ts[0] = types.TypInt()
	ts[1] = types.TypFloat64()
	ts[2] = hfaStruct2()
	if cc.CallArgStackOffV(ts, 1, 1) != 0 {
		return "variadic float should be at stack offset 0"
	}
	if cc.CallArgStackOffV(ts, 2, 1) != 8 {
		return "variadic HFA should follow the float at stack offset 8"
	}
	// 8 (float) + 16 (HFA) = 24, rounded up to the 16-byte stack alignment = 32.
	if cc.CallStackBytesV(ts, 1) != 32 {
		return "float + HFA varargs should reserve 32 bytes"
	}
	return ""
}

// ============================================================
// AAPCS-VFP (arm32 hard-float) V-walker back-fill dispatch
// ============================================================
//
// The caller-side V-walkers must route float scalars through the SAME AAPCS-VFP
// back-fill allocator the callee param setup and CallArgFpReg use (the non-V
// walkers), or a call with more than 8 in-register floats disagrees on the stack
// offset of every later stacked arg (the 9th float32 phantom-spills on the
// monotonic path while the back-fill keeps it in s8).  vfpTestCC() lives in
// common_callconv_vfp_test.bn (same package).

// Beyond 8 float32s the back-fill still has room (16 single slots): 9 float32
// ride s0..s8, so a trailing stacked arg starts at offset 0 — NOT offset 4/8 as a
// monotonic 8-slot cursor would place it after phantom-spilling the 9th float.
// The V-walkers (caller) must match the non-V walkers (callee) at every index.
func TestVfpVWalkerBeyond8Float32MatchesBackfill() testing.TestResult {
	var cc CallConv = vfpTestCC()
	// 4 int32 (r0..r3) + 9 float32 (back-fill s0..s8) + 1 int32 (stacked).
	var ts @[]@types.Type = make_slice(@types.Type, 14)
	for i := 0; i < 4; i++ { ts[i] = types.TypInt32() }
	for i := 4; i < 13; i++ { ts[i] = types.TypFloat32() }
	ts[13] = types.TypInt32()
	// The 9th float32 (index 12) rides S8, in a register — this is the datum the
	// monotonic path got wrong (it thought s0..s7 were the only slots).
	r, isD := cc.CallArgFpReg(ts, 12)
	if r != 8 || isD { return "9th float32 must ride S8 (back-fill), not spill" }
	// Every float rides an FP reg: no GP, no stack, via the V-walker.
	for i := 4; i < 13; i++ {
		if cc.CallArgRegStartV(ts, i, 14) != -1 { return "in-reg VFP float takes no GP reg" }
		if cc.CallArgStackOffV(ts, i, 14) != -1 { return "in-reg VFP float has no stack slot" }
	}
	// The trailing int (GP file already full at r0..r3) stacks at offset 0,
	// because the 9 floats consumed ZERO outgoing-stack bytes.
	if cc.CallArgStackOffV(ts, 13, 14) != 0 { return "trailing int32 must stack at offset 0" }
	if cc.CallStackBytesV(ts, 14) != 8 { return "only the trailing int32 stacks (4 B → 8 rounded)" }
	// Caller (V, fixedCount = len) must equal callee (non-V) at every index.
	for i := 0; i < 14; i++ {
		if cc.CallArgRegStartV(ts, i, 14) != cc.CallArgRegStart(ts, i) {
			return "V-walker regStart must match non-V under VfpBackfill"
		}
		if cc.CallArgStackOffV(ts, i, 14) != cc.CallArgStackOff(ts, i) {
			return "V-walker stackOff must match non-V under VfpBackfill"
		}
	}
	return ""
}

// Mixed float32/float64: 8 float32 fill s0..s7, then a float64 back-fills the even
// pair s8,s9 (= D4) — in a register.  The monotonic path would spill the float64
// (its 9th "float" past the 8-slot cursor), pushing the trailing int to a nonzero
// offset.  Back-fill keeps it in D4, so the int stacks at offset 0.
func TestVfpVWalkerMixedFloat32Float64MatchesBackfill() testing.TestResult {
	var cc CallConv = vfpTestCC()
	// 4 int32 (r0..r3) + 8 float32 (s0..s7) + 1 float64 (D4 = s8,s9) + 1 int32 (stacked).
	var ts @[]@types.Type = make_slice(@types.Type, 14)
	for i := 0; i < 4; i++ { ts[i] = types.TypInt32() }
	for i := 4; i < 12; i++ { ts[i] = types.TypFloat32() }
	ts[12] = types.TypFloat64()
	ts[13] = types.TypInt32()
	r, isD := cc.CallArgFpReg(ts, 12)
	if r != 4 || !isD { return "float64 after 8 float32 must ride D4 (back-fill), not spill" }
	if cc.CallArgStackOffV(ts, 12, 14) != -1 { return "in-reg float64 has no stack slot" }
	if cc.CallArgStackOffV(ts, 13, 14) != 0 { return "trailing int32 must stack at offset 0" }
	if cc.CallStackBytesV(ts, 14) != 8 { return "only the trailing int32 stacks (4 B → 8 rounded)" }
	for i := 0; i < 14; i++ {
		if cc.CallArgRegStartV(ts, i, 14) != cc.CallArgRegStart(ts, i) {
			return "V-walker regStart must match non-V (mixed float widths)"
		}
		if cc.CallArgStackOffV(ts, i, 14) != cc.CallArgStackOff(ts, i) {
			return "V-walker stackOff must match non-V (mixed float widths)"
		}
	}
	return ""
}

// AAPCS-VFP is per-CALL: once a call is variadic, EVERY float rides the GP base
// standard — the NAMED/fixed floats before `...`, not just the tail.  A fixed
// float in a variadic call is reclassified to its same-width integer and takes a
// GP reg / pair, NOT the VFP bank.  Contrast: the SAME fixed float in a
// NON-variadic call back-fills VFP (the per-CALL nature of the rule).
func TestVfpVWalkerVariadicFixedFloatRidesGp() testing.TestResult {
	var cc CallConv = vfpTestCC()
	// (float64 fixed, float64 variadic), fixedCount = 1 → the call IS variadic.
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypFloat64()
	ts[1] = types.TypFloat64()
	// FIXED float64 → GP pair r0:r1 (NOT VFP), because the whole call is variadic.
	if cc.CallArgRegStartV(ts, 0, 1) != 0 {
		return "fixed float64 in a variadic call must ride GP r0:r1, not VFP"
	}
	if cc.CallArgStackOffV(ts, 0, 1) != -1 { return "fixed float64 in r0:r1 has no stack slot" }
	// Variadic float64 → the next even GP pair r2:r3 (ngrn=2 after the fixed pair).
	if cc.CallArgRegStartV(ts, 1, 1) != 2 { return "variadic float64 must ride GP pair r2:r3" }
	// Per-CALL contrast: the SAME fixed float64 in a NON-variadic call
	// (fixedCount = len = 2) back-fills the VFP bank (D0), taking no GP reg.
	if cc.CallArgRegStartV(ts, 0, 2) != -1 {
		return "fixed float64 in a NON-variadic call rides VFP (D0), no GP reg"
	}
	return ""
}

// The float32 fixed-float case (4-byte GP slot, not an 8-byte pair): a fixed
// float32 in a variadic call reclassifies to uint32 and rides a single GP reg.
func TestVfpVWalkerVariadicFixedFloat32RidesGp() testing.TestResult {
	var cc CallConv = vfpTestCC()
	// (float32 fixed, int32 variadic), fixedCount = 1 → variadic call.
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypFloat32()
	ts[1] = types.TypInt32()
	// FIXED float32 → GP r0 (uint32, 4 bytes), not VFP S0.
	if cc.CallArgRegStartV(ts, 0, 1) != 0 {
		return "fixed float32 in a variadic call must ride GP r0, not VFP"
	}
	// Variadic int32 → r1.
	if cc.CallArgRegStartV(ts, 1, 1) != 1 { return "variadic int32 must ride GP r1" }
	// Contrast: fixed float32 in a NON-variadic call back-fills VFP S0 (no GP).
	if cc.CallArgRegStartV(ts, 0, 2) != -1 {
		return "fixed float32 in a NON-variadic call rides VFP (S0), no GP reg"
	}
	return ""
}
