package "pkg/binate/native/common"

import "pkg/binate/types"

// C-ABI multi-value-RETURN classification for `#[c_export]` entries.  The
// CRET_ADAPT_* kinds returned by CExportMultiReturnAdaptKind are declared in the
// package interface (common.bni).
//
// A #[c_export] function's mangled definition returns a multi-value tuple in
// Binate's INTERNAL convention (MultiReturnTupleNeedsSret / the register-count
// rule).  But a conforming C caller uses the platform's C STRUCT-RETURN ABI (the
// tuple treated as `struct { … }`), whose register/sret budget is NARROWER.  The
// C-visible entry must therefore ADAPT to the C ABI.  These predicates classify
// the C side; both the LLVM backend (codegen) and the native backends consult
// them so a mixed-backend link agrees on the boundary.  The mangled definition
// and Binate-internal callers are UNAFFECTED — they keep the internal convention.

// CMultiReturnTupleReturnsHfaInFpRegs reports whether the current target returns
// the tuple `t` (as a C struct) in FP registers because it is a Homogeneous
// Floating-point Aggregate: aarch64 always (AAPCS64), arm32 only under hard-float
// (AAPCS-VFP).  Such a tuple is NEVER sret and the internal FP-aware convention
// already matches clang's placement (e.g. aarch64 (f64,f64,f64) → d0..d2 both
// ways), so its C entry stays a plain alias.  Uses the structural HFA fold
// (HfaMemberCount) directly — the anonymous multi-return tuple is HfaMemberCount-
// classifiable even though hfaSimdAggregate excludes it from HFA *coercion*.
func CMultiReturnTupleReturnsHfaInFpRegs(t @types.Type) bool {
	if t == nil {
		return false
	}
	if !types.HfaInSimd() && !types.Arm32HardFloat() {
		return false
	}
	return types.HfaMemberCount(t) > 0
}

// CMultiReturnTupleNeedsSret reports whether a C caller of a #[c_export]
// returning tuple `t` receives it via a hidden sret buffer — i.e. `t`, treated as
// the C struct a caller declares, is memory-class under the platform C ABI.  NOT
// an FP-HFA (returned in FP registers, above), else the platform size cutoff:
// > 16 bytes on LP64, > 4 on ILP32.  Distinct from CallConv.MultiReturnTupleNeeds-
// Sret, the INTERNAL register-COUNT rule — the internal budget (up to 8 GP on
// aarch64, 3 on x86-64, 4 on arm32) is wider, so the internal convention
// register-returns tuples the C ABI sret's.
func CMultiReturnTupleNeedsSret(t @types.Type) bool {
	if t == nil {
		return false
	}
	if CMultiReturnTupleReturnsHfaInFpRegs(t) {
		return false
	}
	var cutoff int = 16
	if types.GetTarget().PointerSize == 4 {
		cutoff = 4
	}
	return t.SizeOf() > cutoff
}

// CExportMultiReturnAdaptKind classifies how a #[c_export] entry must adapt the
// multi-value return tuple `t` from the internal convention (this cc) to the C
// struct-return ABI.  CRET_ADAPT_NONE: the C form already matches (a plain alias
// / narrow-prefix entry suffices) — a both-sret tuple, an FP-HFA, or a word-sized
// register tuple.  CRET_ADAPT_SRET: the C ABI sret's a tuple this convention
// register-returns → store the register result into the caller's sret buffer.
// CRET_ADAPT_COERCE: both register-return but the C ABI packs sub-word fields per
// eightbyte → repack into clang's coerced form.  Callers pass f.MultiReturnType
// and must have already checked len(f.Results) > 1.
func (cc CallConv) CExportMultiReturnAdaptKind(t @types.Type) int {
	if t == nil {
		return CRET_ADAPT_NONE
	}
	var intSret bool = cc.MultiReturnTupleNeedsSret(t)
	if CMultiReturnTupleNeedsSret(t) {
		if intSret {
			return CRET_ADAPT_NONE // both sret: the mangled body's sret matches the C ABI
		}
		return CRET_ADAPT_SRET
	}
	// C returns in registers.  If the internal convention nonetheless sret's the
	// tuple (x86-64: > 3 narrow GP words the C ABI packs into ≤ 2 eightbytes), the
	// body writes a buffer the entry then reloads packed; otherwise both register-
	// return and only sub-word packing (if any) needs a repack.
	if intSret {
		return CRET_ADAPT_COERCE_FROM_SRET
	}
	if CMultiReturnTupleInRegCoerced(t) {
		return CRET_ADAPT_COERCE
	}
	return CRET_ADAPT_NONE
}

// CMultiReturnTupleInRegCoerced reports whether tuple `t` is returned IN registers
// by both the C ABI and the internal convention, but their register placements
// diverge so the C entry must present clang's coerced form (reinterpreted from the
// internal return).  NOT the sret case, NOT an FP-HFA (the internal FCA already
// matches clang there).  Two triggers:
//   - a field narrower than a register word: the C ABI PACKS sub-word fields per
//     eightbyte where the internal aggregate SPREADS them (e.g. aarch64
//     (int32,int32): clang packs into x0, the internal convention uses x0/x1).
//   - a float SCALAR field on aarch64: a non-HFA composite returns WHOLLY in GP
//     there, but the internal convention puts the float in a D register — so even
//     a word-sized mixed tuple like (int64,float64) / (float64,@Error) diverges.
// A tuple of word-sized non-float fields (the common (int, @Error)) needs no
// repack and stays a plain alias.
func CMultiReturnTupleInRegCoerced(t @types.Type) bool {
	if t == nil {
		return false
	}
	if CMultiReturnTupleNeedsSret(t) || CMultiReturnTupleReturnsHfaInFpRegs(t) {
		return false
	}
	var wordBytes int = 8
	if types.GetTarget().PointerSize == 4 {
		wordBytes = 4
	}
	// aarch64 returns a NON-HFA composite (which this tuple is — HFAs were exempted
	// above) WHOLLY in GP registers (x0/x1), but the internal convention places a
	// float SCALAR field in a D register (storeMultiReturnTupleFieldsAA64 /
	// clang's `{…,double}` FCA lowering).  So a float field must be repacked into
	// GP even when every field is word-sized.  x86-64 places each float eightbyte
	// in XMM under BOTH conventions (no divergence); arm32 register-returned tuples
	// are ≤ 4 bytes and cannot hold a float scalar field (both never reach here).
	if types.HfaInSimd() {
		for i := 0; i < len(t.Fields); i++ {
			if IsFloatScalarTyp(t.Fields[i].Type) {
				return true
			}
		}
	}
	for i := 0; i < len(t.Fields); i++ {
		if t.Fields[i].Type.SizeOf() < wordBytes {
			return true
		}
	}
	return false
}
