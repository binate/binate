package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"

// ImmFoldableConsts returns a dense ID-indexed flag set (sized to f.NextID):
// element [id] is true iff the OP_CONST_INT value id is used ONLY as the RHS
// (Args[1]) of integer comparisons, and its value fits each such compare's
// immediate form — so a backend folds it into a `cmp #imm` / `cmn #imm` and
// neither materializes it into a register nor homes it.
//
// A backend with an immediate compare form assigns this to m.FoldedImmConst
// BEFORE AllocateRegisters (so the allocator leaves the constant unhomed) and
// skips the constant's standalone emission; emitCompare then rides the value in
// the CMP's immediate operand.  This removes the constant materialization — and,
// under register pressure, the spill/reload of a loop-invariant named constant
// compared every iteration (the STATE_* reload pathology).
//
// The immediate range is target-specific, passed as (posMax, negMin): a value v
// fits when 0 <= v <= posMax (any signedness — `cmp #v`), or negMin <= v < 0 for
// a SIGNED compare (`cmn #-v`; a negative constant in an UNSIGNED compare is a
// huge unsigned value, not a small negative, so it does not fold).  A constant
// used anywhere else — as a compare's LHS (the register operand), by a non-
// compare op, in a phi, or out of immediate range — is not foldable.
func ImmFoldableConsts(f @ir.Func, posMax int64, negMin int64) @[]bool {
	var n int = f.NextID
	var isConst @[]bool = make_slice(bool, n)
	var used @[]bool = make_slice(bool, n)
	var disq @[]bool = make_slice(bool, n)

	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_CONST_INT && ins.ID >= 0 && ins.ID < n {
				isConst[ins.ID] = true
			}
			if isIntCompareOp(ins.Op) && len(ins.Args) == 2 {
				// LHS is the register operand of the CMP — a constant there is not
				// foldable into the immediate.
				noteConstArg(used, disq, ins.Args[0], false, posMax, negMin, false)
				// RHS folds into the immediate when the compare is integer and the
				// value fits this compare's signedness.
				var lt @types.Type = nil
				if ins.Args[0] != nil {
					lt = types.StripWrappers(ins.Args[0].Typ)
				}
				var isIntCmp bool = lt != nil && lt.IsInteger()
				var isUns bool = isIntCmp && !lt.Signed
				noteConstArg(used, disq, ins.Args[1], isIntCmp, posMax, negMin, isUns)
				continue
			}
			// Any other reference (non-compare arg, or a phi input) is a use that
			// cannot ride an immediate, so it disqualifies the constant.
			for ai := 0; ai < len(ins.Args); ai++ {
				noteConstArg(used, disq, ins.Args[ai], false, posMax, negMin, false)
			}
			for pi := 0; pi < len(ins.Phis); pi++ {
				noteConstArg(used, disq, ins.Phis[pi].Val, false, posMax, negMin, false)
			}
		}
	}

	var foldable @[]bool = make_slice(bool, n)
	for id := 0; id < n; id++ {
		foldable[id] = isConst[id] && used[id] && !disq[id]
	}
	return foldable
}

// noteConstArg records one reference to `arg`: for an in-range OP_CONST_INT it
// marks the constant used, and disqualifies it unless this reference can ride a
// compare immediate (`rhsFoldable` — the caller already knows it is the RHS of an
// integer compare — AND the value fits per cmpImmFits with the given signedness).
func noteConstArg(used @[]bool, disq @[]bool, arg @ir.Instr, rhsFoldable bool, posMax int64,
		negMin int64, isUns bool) {
	if arg == nil || arg.Op != iropcode.OP_CONST_INT || arg.ID < 0 || arg.ID >= len(used) {
		return
	}
	used[arg.ID] = true
	if !(rhsFoldable && cmpImmFits(arg.IntVal, isUns, posMax, negMin)) {
		disq[arg.ID] = true
	}
}

// cmpImmFits reports whether constant v fits a compare's immediate: an unsigned-
// range value 0..posMax rides `cmp #v` for any signedness; a small negative
// value (negMin..-1) rides `cmn #-v` only for a SIGNED compare — a negative in an
// unsigned compare denotes a near-2^N value that the small immediate can't carry.
func cmpImmFits(v int64, isUns bool, posMax int64, negMin int64) bool {
	if v >= cast(int64, 0) && v <= posMax {
		return true
	}
	if !isUns && v < cast(int64, 0) && v >= negMin {
		return true
	}
	return false
}
