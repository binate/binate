package "pkg/binate/native/common"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for common_copy_stats.bn: the aggregate-copy tally.

// statsContains reports whether needle occurs in s.
func statsContains(s *[]readonly char, needle *[]readonly char) bool {
	for i := 0; i + len(needle) <= len(s); i++ {
		var j int = 0
		for j < len(needle) && s[i + j] == needle[j] { j = j + 1 }
		if j == len(needle) { return true }
	}
	return false
}

// LoadConsumers names what reads each aggregate load: its one use storing it whole,
// passing it to a call, returning it, extracts only, several uses, or none.
func TestLoadConsumers() testing.TestResult {
	setTarget64()
	var q @types.Type = elisionQuadTyp()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var p @ir.Instr = irbuild.EmitAlloc(e, q)
	var stored @ir.Instr = irbuild.EmitLoad(e, p, q)
	irbuild.EmitStore(e, irbuild.EmitAlloc(e, q), stored)
	var passed @ir.Instr = irbuild.EmitLoad(e, p, q)
	irbuild.EmitCall(e, "g", @[]@ir.Instr{passed}, types.TypVoid())
	var extracted @ir.Instr = irbuild.EmitLoad(e, p, q)
	irbuild.EmitExtract(e, extracted, 0, types.TypInt())
	irbuild.EmitExtract(e, extracted, 1, types.TypInt())
	var several @ir.Instr = irbuild.EmitLoad(e, p, q)
	irbuild.EmitExtract(e, several, 0, types.TypInt())
	irbuild.EmitCall(e, "g", @[]@ir.Instr{several}, types.TypVoid())
	var unused @ir.Instr = irbuild.EmitLoad(e, p, q)
	var returned @ir.Instr = irbuild.EmitLoad(e, p, q)
	irbuild.EmitReturn(e, @[]@ir.Instr{returned})
	var c @[]int = LoadConsumers(f)
	if c[stored.ID] != copyLoadStored || c[passed.ID] != copyLoadArg ||
			c[returned.ID] != copyLoadReturned {
		return "a load's one use: stored whole, passed to a call, returned"
	}
	if c[extracted.ID] != copyLoadExtracts || c[several.ID] != copyLoadSeveral ||
			c[unused.ID] != copyLoadUnused {
		return "extracts only; several uses; none"
	}
	return ""
}

// With the tally on, each counted copy lands under its kind and detail — a load
// under what reads it, a store under where its value comes from — with its size;
// with the tally off nothing is counted.
func TestCountAggCopy() testing.TestResult {
	setTarget64()
	var q @types.Type = elisionQuadTyp()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var p @ir.Instr = irbuild.EmitAlloc(e, q)
	var ld @ir.Instr = irbuild.EmitLoad(e, p, q)
	irbuild.EmitStore(e, irbuild.EmitAlloc(e, q), ld)
	var call @ir.Instr = irbuild.EmitCall(e, "mk", elisionNoRets(), q)
	irbuild.EmitReturn(e, elisionNoRets())
	var m @RegMap = nrm()
	SetCopyStats(false)
	CountAggCopy(m, COPY_STORE, call, 32)
	var off @[]char = CopyStatsReport()
	SetCopyStats(true)
	m.CopyStatsUse = LoadConsumers(f)
	CountAggCopy(m, COPY_LOAD, ld, 32)
	CountAggCopy(m, COPY_STORE, call, 32)
	CountAggCopy(m, COPY_STORE, call, 300)
	CountAggCopy(nil, COPY_SHIM, nil, 8)
	var on @[]char = CopyStatsReport()
	SetCopyStats(false)
	if statsContains(off, "store   ") { return buf.Concat("the tally is off: nothing counted: ", off) }
	if !statsContains(on, "load    stored whole") || !statsContains(on, "store   call result") ||
			!statsContains(on, "shim    other") {
		return buf.Concat("each copy under its kind and detail: ", on)
	}
	if !statsContains(on, "       2         332") {
		return buf.Concat("two stores of a call result, 332 bytes: ", on)
	}
	if !statsContains(on, "total") || !statsContains(on, "       4         372") {
		return buf.Concat("totals: 4 copies, 372 bytes: ", on)
	}
	return ""
}

// An indirect call's callee (its Args[0]: a function or interface value) is not an
// argument; its other operands are.  A parameter placeholder is a parameter.
func TestCopyStatsCalleeAndParam() testing.TestResult {
	var call @ir.Instr = make(ir.Instr)
	call.Op = iropcode.OP_CALL_FUNC_VALUE
	if loadUseDetail(call, 0) != copyLoadOther || loadUseDetail(call, 1) != copyLoadArg {
		return "an indirect call's callee is no argument; its other operands are"
	}
	var direct @ir.Instr = make(ir.Instr)
	direct.Op = iropcode.OP_CALL
	if loadUseDetail(direct, 0) != copyLoadArg {
		return "a direct call's first operand is an argument"
	}
	var param @ir.Instr = make(ir.Instr)
	param.Op = iropcode.OP_PARAM
	if copyOrigin(nil, param) != copyFromParam { return "a parameter placeholder is a parameter" }
	return ""
}
