package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/ir"

// EmitDataGlobal lays one ir.DataGlobal into the assembler: select the
// section + symbol binding from its linkage / read-only flag, define the
// label, then emit each Init term contiguously (bytes / a sized integer / a
// relocation for a symref / zeros), then align.  This is the native half of
// the ir.DataGlobal unification — it walks the SAME terms the LLVM
// emitDataGlobal does, so the two backends cannot drift on the byte layout.
func EmitDataGlobal(a @asm.Assembler, dg @ir.DataGlobal) {
	// All static blobs go in "data" — the native backend's current
	// convention for every emitted constant (the _Package descriptor and its
	// tables included), and the only section whose cross-symbol relocations
	// are exercised end-to-end.  dg.ReadOnly is a semantic flag the LLVM
	// backend acts on (`constant`); a native rodata-section split is a
	// deferred refinement (it needs object-emitter support for relocations in
	// a read-only section, which the strings phase can introduce + verify).
	a.SetSection("data", asm.SF_READ | asm.SF_WRITE)
	// Align the blob's OWN start to dg.Align before defining its label, so a
	// DataGlobal honors its alignment regardless of what preceded it (matching
	// the LLVM half's `align N`, which aligns the symbol).  Without this a
	// blob's start relies on every prior emitter leaving the section aligned —
	// which holds for the descriptor today, but would let an odd-length blob
	// (a string / vtable in a later phase) land a following word-bearing blob
	// misaligned.  The trailing Align below still pads what follows.
	if dg.Align > 1 {
		a.Align(dg.Align)
	}
	a.DefineLabel(dg.Name)
	if dg.Linkage == ir.DG_GLOBAL {
		a.SetGlobal(dg.Name)
	} else if dg.Linkage == ir.DG_WEAK {
		a.SetWeak(dg.Name)
	}
	// DG_LOCAL keeps the assembler's default (local) binding — no call.
	for i := 0; i < len(dg.Init); i++ {
		emitDataTerm(a, dg.Init[i])
	}
	if dg.Align > 1 {
		a.Align(dg.Align)
	}
	return
}

// emitDataTerm lays one term's bytes into the current section.
func emitDataTerm(a @asm.Assembler, t @ir.DataTerm) {
	if t.Kind == ir.DT_INT {
		if t.Width == 1 {
			a.EmitUint8(cast(uint8, t.IntVal))
		} else if t.Width == 2 {
			a.EmitUint16(cast(uint16, t.IntVal))
		} else if t.Width == 4 {
			a.EmitUint32(cast(uint32, t.IntVal))
		} else {
			a.EmitUint64(t.IntVal)
		}
		return
	}
	if t.Kind == ir.DT_SYMREF {
		if len(t.Sym) == 0 {
			// Empty Sym means a null pointer (e.g. an empty table slice).
			a.Zero(a.WordSize)
			return
		}
		// Pointer-to-symbol: a word-sized absolute (kind 0) relocation to
		// Sym + Addend; the placeholder bytes are zeroed (the object emitter
		// patches them — ELF via r_addend, Mach-O bakes the addend inline).
		a.AddFixup(t.Sym, 0, t.Addend, a.WordSize)
		a.Fill(a.WordSize, cast(uint8, 0))
		return
	}
	if t.Kind == ir.DT_BYTES {
		for j := 0; j < len(t.Bytes); j++ {
			a.EmitUint8(t.Bytes[j])
		}
		return
	}
	// DT_ZERO
	a.Zero(t.Width)
	return
}
