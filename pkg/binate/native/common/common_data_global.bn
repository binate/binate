package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/irdata"
import "pkg/stdx/fmt"

// EmitDataGlobal lays one irdata.DataGlobal into the assembler: select the
// section + symbol binding from its linkage / read-only flag, define the
// label, then emit each Init term contiguously (bytes / a sized integer / a
// relocation for a symref / zeros), then align.  This is the native half of
// the irdata.DataGlobal unification — it walks the SAME terms the LLVM
// emitDataGlobal does, so the two backends cannot drift on the byte layout.
func EmitDataGlobal(a @asm.Assembler, dg @irdata.DataGlobal) {
	// Section selection (matching the LLVM half's `constant` vs `global`):
	//
	//   reloc-free read-only  → "rodata"        (genuinely const)
	//   relocatable read-only → "rodata_relro"  (const after load-time fixups)
	//   mutable               → "data"
	//
	// "rodata" maps to ELF `.rodata` (SHF_ALLOC) / Mach-O `__TEXT,__const`, and
	// Mach-O's linker rejects ANY relocation whose patched location is in
	// `__TEXT` ("illegal text-relocation") — so only pure-byte blobs (string
	// bytes, _pkgname, info-node name/sig) may go there.  A read-only blob that
	// emits a cross-symbol relocation — the descriptor node + its backing
	// arrays, every info node, all vtables, the string `.ms` header — goes to
	// "rodata_relro" (ELF `.data.rel.ro` via PT_GNU_RELRO / Mach-O
	// `__DATA_CONST,__const`), which permits relocations yet is made read-only
	// once the loader has applied them.  Genuinely mutable globals (top-level
	// `var`) are not ReadOnly and stay in writable "data".
	if dg.ReadOnly && !dgEmitsRelocation(dg) {
		a.SetSection("rodata", asm.SF_READ)
	} else if dg.ReadOnly {
		a.SetSection("rodata_relro", asm.SF_READ | asm.SF_WRITE)
	} else {
		a.SetSection("data", asm.SF_READ | asm.SF_WRITE)
	}
	// Align the blob's OWN start to dg.Align before defining its label, so a
	// DataGlobal honors its alignment regardless of what preceded it (matching
	// the LLVM half's `align N`, which aligns the symbol).  Without this a
	// blob's start relies on every prior emitter leaving the section aligned —
	// which holds for the descriptor today, but would let an odd-length blob
	// (a string / vtable in a later phase) land a following word-bearing blob
	// misaligned.  The trailing Align below still pads what follows.
	if dg.Align > 1 {
		a.Align(dg.Align)
	}
	a.DefineLabel(dg.Name)
	if dg.Linkage == irdata.DG_GLOBAL {
		a.SetGlobal(dg.Name)
	} else if dg.Linkage == irdata.DG_WEAK {
		a.SetWeak(dg.Name)
	}
	// DG_LOCAL keeps the assembler's default (local) binding — no call.
	for i := 0; i < len(dg.Init); i++ {
		emitDataTerm(a, dg.Init[i])
	}
	if dg.Align > 1 {
		a.Align(dg.Align)
	}
	return
}

// dgEmitsRelocation reports whether laying dg emits a cross-symbol relocation —
// i.e. any term is a symref to a real (non-empty) target.  A null symref (empty
// Sym) lays a word of zeros with NO relocation, so it doesn't count.  Used to
// keep relocatable read-only blobs out of Mach-O's reloc-hostile __TEXT,__const.
func dgEmitsRelocation(dg @irdata.DataGlobal) bool {
	for i := 0; i < len(dg.Init); i++ {
		if dg.Init[i].Kind == irdata.DT_SYMREF && len(dg.Init[i].Sym) > 0 {
			return true
		}
	}
	return false
}

// emitDataTerm lays one term's bytes into the current section.
func emitDataTerm(a @asm.Assembler, t @irdata.DataTerm) {
	if t.Kind == irdata.DT_INT {
		if t.Width == 1 {
			a.EmitUint8(cast(uint8, t.IntVal))
		} else if t.Width == 2 {
			a.EmitUint16(cast(uint16, t.IntVal))
		} else if t.Width == 4 {
			a.EmitUint32(cast(uint32, t.IntVal))
		} else {
			a.EmitUint64(t.IntVal)
		}
		return
	}
	if t.Kind == irdata.DT_SYMREF {
		if len(t.Sym) == 0 {
			// Empty Sym means a null pointer (e.g. an empty table slice).
			a.Zero(a.WordSize)
			return
		}
		// Pointer-to-symbol: a word-sized absolute (kind 0) relocation to
		// Sym + Addend; the placeholder bytes are zeroed (the object emitter
		// patches them — ELF via r_addend, Mach-O bakes the addend inline).
		a.AddFixup(t.Sym, 0, t.Addend, a.WordSize)
		a.Fill(a.WordSize, cast(uint8, 0))
		return
	}
	if t.Kind == irdata.DT_BYTES {
		for j := 0; j < len(t.Bytes); j++ {
			a.EmitUint8(t.Bytes[j])
		}
		return
	}
	// DT_ZERO
	a.Zero(t.Width)
	return
}

// ReportEmitError prints the assembler's specific error message when a native
// EmitObject has failed, so the precise a.SetError reason (e.g. an
// unimplemented shape, or a frame offset the backend cannot encode) reaches the
// compile driver's output instead of being swallowed into the driver's generic
// "native backend failed to emit object (arch=...)" line.  Each backend's
// EmitObject calls this at its `if a.HasError { return false }` point; the
// driver still prints its own one-line summary, so the two together read as a
// specific detail followed by the generic failure.  A no-op when a has no error
// (so a caller may invoke it unconditionally on the failure path).  `arch`
// names the backend for the detail line.
func ReportEmitError(a @asm.Assembler, arch *[]readonly char) {
	if !a.HasError { return }
	fmt.Print("error: native backend (arch=", arch, "): ", a.ErrorMsg, "\n")
}
