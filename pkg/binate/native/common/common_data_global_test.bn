package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// sameName reports whether two section/symbol names are byte-equal.
func sameName(x *[]readonly char, y *[]readonly char) bool {
	if len(x) != len(y) { return false }
	for i := 0; i < len(x); i++ {
		if x[i] != y[i] { return false }
	}
	return true
}

// secIdx returns the index of the section named `name`, or -1.
func secIdx(a @asm.Assembler, name *[]readonly char) int {
	for i := 0; i < a.NumSections; i++ {
		if sameName(a.Sections[i].Name, name) { return i }
	}
	return -1
}

// TestEmitDataGlobalNativeNode pins the native lowering of int + symref terms
// — a weak data blob shaped like a static-managed descriptor-node prefix
// (sentinel refcount, null freefn, a Name.data relocation, a length) — laid at
// the right offsets with a fixup for the symref and weak binding.
func TestEmitDataGlobalNativeNode() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var dg @ir.DataGlobal = ir.NewDataGlobal("g", ir.DG_WEAK, 8, true)
	dg.Init = slices.Append[@ir.DataTerm](dg.Init,
		ir.DataInt(8, bit_cast(uint64, cast(int64, -1073741824))))
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataInt(8, cast(uint64, 0)))
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataSymref("nm", 0))
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataInt(8, cast(uint64, 5)))
	EmitDataGlobal(a, dg)

	var sym int = a.LookupSymbol("g")
	if sym < 0 { return "label g not defined" }
	if a.Symbols[sym].Binding != asm.BIND_WEAK { return "g should be weak-bound" }

	// Read-only but relocatable (a real Name.data symref) -> "rodata_relro"
	// (read-only after load-time fixups), NOT the writable "data" section.
	if secIdx(a, "data") >= 0 {
		return "a relocatable read-only node must not land in writable data"
	}
	var ri int = secIdx(a, "rodata_relro")
	if ri < 0 { return "no rodata_relro section emitted" }
	if a.Sections[ri].Len != 32 { return "node should be 32 bytes" }
	if a.Sections[ri].NumFixups < 1 { return "missing Name.data relocation" }

	var data @[]uint8 = a.SectionData(ri)
	// Refcount sentinel -1073741824 = 0xFFFFFFFF_C0000000, little-endian.
	if data[3] != cast(uint8, 0xC0) || data[4] != cast(uint8, 0xFF) {
		return "first word is not the refcount sentinel"
	}
	if data[8] != cast(uint8, 0) { return "freefn word should be zero" }
	if cast(int, data[24]) != 5 { return "length field (offset 24) should be 5" }
	return ""
}

// TestEmitDataGlobalNativeBytesData pins a private mutable data blob: raw bytes
// + trailing zeros, in the data section with local binding.
func TestEmitDataGlobalNativeBytesData() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var bs @[]uint8 = make_slice(uint8, 2)
	bs[0] = cast(uint8, 'x')
	bs[1] = cast(uint8, 'y')
	var dg @ir.DataGlobal = ir.NewDataGlobal("b", ir.DG_LOCAL, 1, false)
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataBytes(bs))
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataZero(2))
	EmitDataGlobal(a, dg)

	var sym int = a.LookupSymbol("b")
	if sym < 0 { return "label b not defined" }
	if a.Symbols[sym].Binding != asm.BIND_LOCAL { return "b should be local-bound" }

	var di int = secIdx(a, "data")
	if di < 0 { return "no data section emitted" }
	if a.Sections[di].Len != 4 { return "blob should be 4 bytes (xy + 2 zero)" }
	var data @[]uint8 = a.SectionData(di)
	if data[0] != cast(uint8, 'x') || data[1] != cast(uint8, 'y') {
		return "raw bytes not laid"
	}
	if data[2] != cast(uint8, 0) || data[3] != cast(uint8, 0) {
		return "trailing zeros not laid"
	}
	return ""
}

// TestEmitDataGlobalNativeRodataRelocFree pins the read-only section split: a
// RELOC-FREE read-only blob (a string-byte / name blob) lands in "rodata", NOT
// "data" — while a read-only blob that emits a relocation goes to "rodata_relro"
// (it can't live in Mach-O's reloc-hostile __TEXT,__const).  The relocatable
// case is covered by TestEmitDataGlobalNativeNode / …SymrefAddend (both
// read-only with a symref, both asserted in "rodata_relro").
func TestEmitDataGlobalNativeRodataRelocFree() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var bs @[]uint8 = make_slice(uint8, 3)
	bs[0] = cast(uint8, 'a')
	bs[1] = cast(uint8, 'b')
	bs[2] = cast(uint8, 'c')
	var dg @ir.DataGlobal = ir.NewDataGlobal("s", ir.DG_LOCAL, 1, true)
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataBytes(bs))
	EmitDataGlobal(a, dg)
	if secIdx(a, "rodata") < 0 {
		return "a reloc-free read-only blob should land in rodata"
	}
	if secIdx(a, "data") >= 0 {
		return "a reloc-free read-only blob should not open a data section"
	}
	var ri int = secIdx(a, "rodata")
	if a.Sections[ri].Len != 3 { return "rodata blob should be 3 bytes" }
	return ""
}

// TestEmitDataGlobalNativeStartAlign pins that a blob honors its OWN alignment:
// a 1-byte (align-1) blob followed by an align-8 word-bearing blob must place
// the second blob's symbol at an 8-aligned offset (EmitDataGlobal aligns before
// the label, not only after the terms).
func TestEmitDataGlobalNativeStartAlign() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var b1 @[]uint8 = make_slice(uint8, 1)
	b1[0] = cast(uint8, 'q')
	var dg1 @ir.DataGlobal = ir.NewDataGlobal("one", ir.DG_LOCAL, 1, false)
	dg1.Init = slices.Append[@ir.DataTerm](dg1.Init, ir.DataBytes(b1))
	EmitDataGlobal(a, dg1)
	var dg2 @ir.DataGlobal = ir.NewDataGlobal("two", ir.DG_WEAK, 8, false)
	dg2.Init = slices.Append[@ir.DataTerm](dg2.Init, ir.DataInt(8, cast(uint64, 42)))
	EmitDataGlobal(a, dg2)
	var s2 int = a.LookupSymbol("two")
	if s2 < 0 { return "label two not defined" }
	if cast(int, a.Symbols[s2].Offset) % 8 != 0 {
		return "an align-8 DataGlobal must start at an 8-aligned offset"
	}
	return ""
}

// TestEmitDataGlobalNativeNullSymref pins the null-symref path (empty Sym ->
// word of zeros, NO relocation) and strong (DG_GLOBAL) binding.
func TestEmitDataGlobalNativeNullSymref() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var dg @ir.DataGlobal = ir.NewDataGlobal("n", ir.DG_GLOBAL, 8, false)
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataSymref("", 0))
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataInt(8, cast(uint64, 0)))
	EmitDataGlobal(a, dg)
	var sym int = a.LookupSymbol("n")
	if sym < 0 { return "label n not defined" }
	if a.Symbols[sym].Binding != asm.BIND_GLOBAL { return "n should be global-bound" }
	var di int = secIdx(a, "data")
	if di < 0 { return "no data section" }
	if a.Sections[di].NumFixups != 0 {
		return "a null symref must emit no relocation"
	}
	var data @[]uint8 = a.SectionData(di)
	if data[0] != cast(uint8, 0) || data[7] != cast(uint8, 0) {
		return "null symref should be zero bytes"
	}
	return ""
}

// TestEmitDataGlobalNativeSymrefAddend pins that a symref's NONZERO addend is
// carried into the relocation — the payload-pointer path a backing-array entry
// (and a FunctionInfo's Pkg field) takes to reach a node's PAYLOAD past the
// managed header (16 on a 64-bit word, 2*IntSize in general).  The zero-addend
// and null paths are covered above; this guards the addend that keeps the
// descriptor's payload pointers landing on the payload.
func TestEmitDataGlobalNativeSymrefAddend() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var dg @ir.DataGlobal = ir.NewDataGlobal("arr", ir.DG_WEAK, 8, true)
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataSymref("node", 16))
	EmitDataGlobal(a, dg)
	var di int = secIdx(a, "rodata_relro")
	if di < 0 { return "no rodata_relro section emitted" }
	if a.Sections[di].NumFixups != 1 { return "expected one relocation" }
	if a.Sections[di].Fixups[0].Addend != 16 {
		return "symref addend (16) must be carried into the relocation"
	}
	if a.Sections[di].Fixups[0].Kind != 0 {
		return "a data pointer symref should be an absolute (kind 0) reloc"
	}
	return ""
}

// On an ILP32 target (asm WordSize 4) a DT_INT(4) lays exactly 4 bytes and a
// symref lays a WORD-sized (4-byte) fill + relocation — not the LP64 8-byte
// forms.  asm.New(4) sets WordSize=4.
func TestEmitDataGlobalNativeILP32() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	var dg @ir.DataGlobal = ir.NewDataGlobal("g", ir.DG_WEAK, 4, true)
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataSymref("nm", 0))
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataInt(4, cast(uint64, 5)))
	EmitDataGlobal(a, dg)
	// Read-only but relocatable (a real symref) -> rodata_relro.
	var di int = secIdx(a, "rodata_relro")
	if di < 0 { return "no rodata_relro section emitted" }
	// 4-byte symref word + 4-byte i32 = 8 bytes (would be 16 on LP64).
	if a.Sections[di].Len != 8 {
		return "ILP32 blob should be 4 (symref) + 4 (i32) = 8 bytes"
	}
	if a.Sections[di].NumFixups != 1 {
		return "the symref should emit exactly one relocation"
	}
	return ""
}

// dgEmitsRelocation treats a NULL symref (empty Sym, no relocation) as
// reloc-free, so a READ-ONLY blob whose only symref is null routes to rodata,
// not data — the predicate's ReadOnly + only-null-symref interaction.
func TestEmitDataGlobalNativeNullSymrefRodata() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var dg @ir.DataGlobal = ir.NewDataGlobal("n", ir.DG_LOCAL, 8, true)
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataSymref("", 0))
	dg.Init = slices.Append[@ir.DataTerm](dg.Init, ir.DataInt(8, cast(uint64, 0)))
	EmitDataGlobal(a, dg)
	var ri int = secIdx(a, "rodata")
	if ri < 0 {
		return "a read-only blob with only a null symref is reloc-free -> rodata"
	}
	if secIdx(a, "data") >= 0 {
		return "such a blob should not open a data section"
	}
	if a.Sections[ri].NumFixups != 0 {
		return "a null symref must emit no relocation"
	}
	return ""
}

// TestEmitDataGlobalNativeRelroThreeWay pins the full three-way section split in
// a single assembler: a mutable blob -> "data"; a reloc-free read-only blob ->
// "rodata"; a relocatable read-only blob -> "rodata_relro".  This is the routing
// that lets relocatable-but-const data (descriptor nodes, vtables, the string
// `.ms` header) become read-only-after-load (Mach-O __DATA_CONST / ELF
// .data.rel.ro) instead of sitting in writable "data".
func TestEmitDataGlobalNativeRelroThreeWay() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	// Mutable (ro=false) -> data.
	var mut @ir.DataGlobal = ir.NewDataGlobal("mut", ir.DG_GLOBAL, 8, false)
	mut.Init = slices.Append[@ir.DataTerm](mut.Init, ir.DataInt(8, cast(uint64, 7)))
	EmitDataGlobal(a, mut)
	// Reloc-free read-only (only bytes) -> rodata.
	var b @[]uint8 = make_slice(uint8, 2)
	b[0] = cast(uint8, 'h')
	b[1] = cast(uint8, 'i')
	var ro @ir.DataGlobal = ir.NewDataGlobal("ro", ir.DG_LOCAL, 1, true)
	ro.Init = slices.Append[@ir.DataTerm](ro.Init, ir.DataBytes(b))
	EmitDataGlobal(a, ro)
	// Relocatable read-only (a real symref) -> rodata_relro.
	var rel @ir.DataGlobal = ir.NewDataGlobal("rel", ir.DG_WEAK, 8, true)
	rel.Init = slices.Append[@ir.DataTerm](rel.Init, ir.DataSymref("ro", 0))
	EmitDataGlobal(a, rel)

	if secIdx(a, "data") < 0 { return "mutable blob should open a data section" }
	if secIdx(a, "rodata") < 0 { return "reloc-free RO blob should open a rodata section" }
	if secIdx(a, "rodata_relro") < 0 {
		return "relocatable RO blob should open a rodata_relro section"
	}
	// The relro section carries the symref's relocation, not "data".
	var relroIdx int = secIdx(a, "rodata_relro")
	if a.Sections[relroIdx].NumFixups != 1 {
		return "the relro section should hold the relocatable blob's one fixup"
	}
	var dataIdx int = secIdx(a, "data")
	if a.Sections[dataIdx].NumFixups != 0 {
		return "the mutable data section should carry no relocations here"
	}
	return ""
}
