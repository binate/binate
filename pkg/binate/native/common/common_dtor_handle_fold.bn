package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"

// FoldedDtorHandles returns a dense ID-indexed flag set (sized to f.NextID):
// element [id] is true iff the OP_FUNC_HANDLE value with that SSA id is used
// ONLY as the destructor operand of an OP_REFDEC (Args[1]).
//
// Such a handle is a compile-time-constant address (`&__handle.<dtor>`).  A
// backend with an inline RefDec fast path (aarch64 / arm32 emitRefDecInline)
// materializes it lazily INSIDE the slow path — past the refcount zero-test — so
// it is computed only on the branch that actually frees, not on every
// decrement.  The standalone OP_FUNC_HANDLE emission that would otherwise
// compute the address before the zero-test is then redundant, and the backend
// skips any handle flagged here (and AllocateRegisters leaves it unhomed, since
// its only use no longer reads a register).
//
// OP_FUNC_HANDLE also materializes real function VALUES (passed to calls, stored
// in variables, dispatched through OP_CALL_HANDLE); those have a non-dtor use
// and are left false so they emit normally.  A handle used both ways is
// conservatively left false.  The runtime-loaded dtor path (OP_FUNC_VALUE_DTOR
// feeding an OP_REFDEC) is a different opcode and never appears here.
func FoldedDtorHandles(f @ir.Func) @[]bool {
	var n int = f.NextID
	var dtorUse @[]bool = make_slice(bool, n)
	var otherUse @[]bool = make_slice(bool, n)
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			var isRefDec bool = ins.Op == iropcode.OP_REFDEC
			for ai := 0; ai < len(ins.Args); ai++ {
				markHandleUse(dtorUse, otherUse, ins.Args[ai], isRefDec && ai == 1)
			}
			for pi := 0; pi < len(ins.Phis); pi++ {
				markHandleUse(dtorUse, otherUse, ins.Phis[pi].Val, false)
			}
		}
	}
	var folded @[]bool = make_slice(bool, n)
	for id := 0; id < n; id++ {
		folded[id] = dtorUse[id] && !otherUse[id]
	}
	return folded
}

// markHandleUse records one operand reference: an OP_FUNC_HANDLE operand with an
// in-range id is flagged as a destructor use (dtorPos) or as any other use.
func markHandleUse(dtorUse @[]bool, otherUse @[]bool, arg *ir.Instr, dtorPos bool) {
	if arg == nil { return }
	if arg.Op != iropcode.OP_FUNC_HANDLE { return }
	if arg.ID < 0 || arg.ID >= len(dtorUse) { return }
	if dtorPos {
		dtorUse[arg.ID] = true
	} else {
		otherUse[arg.ID] = true
	}
}
