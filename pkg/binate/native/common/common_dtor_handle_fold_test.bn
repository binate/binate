package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A func-handle whose only use is an OP_REFDEC destructor operand (Args[1]) is
// folded — the backend materializes it in the RefDec slow path instead.
func TestFoldedDtorHandleSoleRefDecUse() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var ptr @ir.Instr = irbuild.EmitConstInt(b, 0, types.TypInt())
	var dtor @ir.Instr = irbuild.EmitFuncHandle(b, "somedtor")
	irbuild.EmitRefDecDtor(b, ptr, dtor)
	var folded @[]bool = FoldedDtorHandles(f)
	if dtor.ID < 0 || dtor.ID >= len(folded) { return "dtor handle id out of range" }
	if !folded[dtor.ID] { return "a func-handle used only as a refdec dtor must be folded" }
	if folded[ptr.ID] { return "the non-func-handle ptr must not be folded" }
	return ""
}

// A func-handle that ALSO has a non-destructor use (here an OP_REFINC operand)
// is left unfolded — the standalone emission is still needed for that use.
func TestFoldedDtorHandleOtherUseNotFolded() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var ptr @ir.Instr = irbuild.EmitConstInt(b, 0, types.TypInt())
	var dtor @ir.Instr = irbuild.EmitFuncHandle(b, "somedtor")
	irbuild.EmitRefDecDtor(b, ptr, dtor) // a dtor use
	irbuild.EmitRefInc(b, dtor) // and a non-dtor use
	var folded @[]bool = FoldedDtorHandles(f)
	if dtor.ID < 0 || dtor.ID >= len(folded) { return "dtor handle id out of range" }
	if folded[dtor.ID] {
		return "a func-handle used both as a dtor and elsewhere must not be folded"
	}
	return ""
}

// AllocateRegisters with foldRefDecDtorHandles=true populates m.FoldedDtor so a
// sole-use dtor handle reports folded; with false it stays empty.
func TestAllocateRegistersFoldFlag() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var ptr @ir.Instr = irbuild.EmitConstInt(b, 0, types.TypInt())
	var dtor @ir.Instr = irbuild.EmitFuncHandle(b, "somedtor")
	irbuild.EmitRefDecDtor(b, ptr, dtor)
	irbuild.EmitReturn(b, makeNoInstrs())

	var on @RegMap = nrm()
	on.AllocateRegisters(f, 8, mkDesc(noClobbers(), mkRegs(10, 200)), true)
	if !on.IsFoldedDtorHandle(dtor.ID) {
		return "with the fold enabled, a sole-use dtor handle must report folded"
	}
	if on.LookupHome(dtor.ID) >= 0 {
		return "a folded dtor handle must not be homed"
	}

	var off @RegMap = nrm()
	off.AllocateRegisters(f, 8, mkDesc(noClobbers(), mkRegs(10, 200)), false)
	if off.IsFoldedDtorHandle(dtor.ID) {
		return "with the fold disabled, no handle may report folded"
	}
	return ""
}
