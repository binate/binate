package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"

// FusableElemGeps returns a dense ID-indexed flag set (sized to f.NextID):
// element [id] is true iff the OP_GET_ELEM_PTR value with that SSA id can be
// folded into a SCALED register-offset load/store — so its element address
// (base + index*elemSize) rides in the memory operand (`[base, index, lsl #n]`)
// instead of being materialized by a separate shift+add.
//
// A backend with a scaled register-offset addressing mode (aarch64
// MemRegScaled) skips the flagged GEP's standalone emission and rederives the
// address inside the consuming load/store from the GEP's own base+index
// operands; AllocateRegisters (with fuseElemGeps set) then leaves the GEP result
// unhomed, since nothing reads it as a register.
//
// The conditions are exactly what makes that fold correct AND a net win:
//   - elemSize is 8 or 4 — the index scales by the access size (×8 for a 64-bit,
//     ×4 for a 32-bit access), so the scaled mode matches only when elemSize
//     equals it.  A signed 4-byte load uses LDRSW (sign-extend to 64), matching
//     the non-fused emitScalarLoad convention.
//   - the result is used EXACTLY ONCE, as the ADDRESS (Args[0]) of an OP_LOAD or
//     OP_STORE — a second use would need the pointer in a register, so the GEP
//     cannot be elided; a use in any other position (incl. a phi) disqualifies.
//   - that access is a plain 4- or 8-byte scalar (not an aggregate, which is
//     handled by-address).  A FLOAT scalar folds only when the backend opts in via
//     allowFloat — it then rides the scaled register-offset FP load/store
//     (`ldr Dt,[base,idx,lsl #3]`) straight into its D-register home.
//   - the base is a register value, NOT an alloca or a global: those reach their
//     address via SP-relative / ADRP+ADD sequences that the register-offset form
//     cannot express, so they keep the standalone GEP.
func FusableElemGeps(f @ir.Func, allowFloat bool) @[]bool {
	var n int = f.NextID
	var isGep @[]bool = make_slice(bool, n)
	var useCount @[]int = make_slice(int, n)
	var addrUse @[]bool = make_slice(bool, n)

	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_GET_ELEM_PTR && ins.ID >= 0 && ins.ID < n {
				isGep[ins.ID] = true
			}
			var isMemAddr bool = (ins.Op == iropcode.OP_LOAD || ins.Op == iropcode.OP_STORE) &&
					elemAccessFusable(ins, allowFloat)
			for ai := 0; ai < len(ins.Args); ai++ {
				markGepUse(useCount, addrUse, ins.Args[ai], isMemAddr && ai == 0)
			}
			for pi := 0; pi < len(ins.Phis); pi++ {
				markGepUse(useCount, addrUse, ins.Phis[pi].Val, false)
			}
		}
	}

	var fusable @[]bool = make_slice(bool, n)
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.Op != iropcode.OP_GET_ELEM_PTR || ins.ID < 0 || ins.ID >= n {
				continue
			}
			if useCount[ins.ID] != 1 || !addrUse[ins.ID] {
				continue
			}
			var esz int = ElemSizeOf(ins)
			if esz != 8 && esz != 4 {
				continue
			}
			if !gepBaseIsRegister(ins) {
				continue
			}
			fusable[ins.ID] = true
		}
	}
	return fusable
}

// markGepUse records one operand reference: for an in-range id it bumps the use
// count, and flags addrUse when the reference is the address operand of a
// fusable element load/store.
func markGepUse(useCount @[]int, addrUse @[]bool, arg @ir.Instr, isAddr bool) {
	if arg == nil {
		return
	}
	if arg.ID < 0 || arg.ID >= len(useCount) {
		return
	}
	useCount[arg.ID] = useCount[arg.ID] + 1
	if isAddr {
		addrUse[arg.ID] = true
	}
}

// elemAccessFusable reports whether load/store `ins` accesses a plain 4- or
// 8-byte scalar the scaled register-offset fold handles: not an aggregate
// (handled by-address), and 4 or 8 bytes.  A signed 4-byte GP load is emitted as
// LDRSW (sign-extend to 64), matching the non-fused emitScalarLoad convention.  A
// FLOAT scalar is foldable only when the backend passes allowFloat=true (it has a
// scaled register-offset FP load/store — `ldr Dt,[base,idx,lsl #3]` — and its
// element emitter dispatches on the FP-home register class); a backend without
// that leaves floats GP-slotted, so allowFloat=false excludes them.
func elemAccessFusable(ins @ir.Instr, allowFloat bool) bool {
	var t @types.Type
	if ins.Op == iropcode.OP_LOAD {
		t = ins.Typ
	} else {
		if len(ins.Args) < 2 || ins.Args[1] == nil {
			return false
		}
		t = ins.Args[1].Typ
	}
	if t == nil {
		return false
	}
	if IsAggregateTyp(t) {
		return false
	}
	if IsFloatScalarTyp(t) && !allowFloat {
		return false
	}
	var sz int = t.SizeOf()
	return sz == 8 || sz == 4
}

// gepBaseIsRegister reports whether the GEP's base operand (Args[0]) is a plain
// register value — not an alloca (OP_ALLOC, SP-relative) or a package-global
// reference (ADRP+ADD), which the register-offset addressing form cannot carry.
func gepBaseIsRegister(gep @ir.Instr) bool {
	if len(gep.Args) < 1 || gep.Args[0] == nil {
		return false
	}
	var base @ir.Instr = gep.Args[0]
	return base.Op != iropcode.OP_ALLOC && !base.IsGlobalRef
}
