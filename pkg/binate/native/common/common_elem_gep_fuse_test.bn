package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for FusableElemGeps (common_elem_gep_fuse.bn): which OP_GET_ELEM_PTRs
// fold into a scaled register-offset load/store.  setTarget64 makes TypInt an
// 8-byte value (the fold's supported element size).

// regBase emits a register-valued pointer base (a nil `*int` — OP_CONST_NIL, so
// not an alloca and not a global) for a GEP.
func regBase(b @ir.Block) @ir.Instr {
	return irbuild.EmitConstNil(b, types.MakePointerType(types.TypInt()))
}

// An 8-byte GP element GEP whose sole use is a load off a register base folds.
func TestFusableGepLoadSingleUse() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var gep @ir.Instr = irbuild.EmitGetElemPtr(b, regBase(b),
			irbuild.EmitConstInt(b, 0, types.TypInt()), types.TypInt())
	_ = irbuild.EmitLoad(b, gep, types.TypInt())
	var fusable @[]bool = FusableElemGeps(f, false)
	if gep.ID < 0 || gep.ID >= len(fusable) { return "gep id out of range" }
	if !fusable[gep.ID] { return "single-use 8-byte GP element load off a register base must fuse" }
	return ""
}

// Same for a store.
func TestFusableGepStoreSingleUse() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var gep @ir.Instr = irbuild.EmitGetElemPtr(b, regBase(b),
			irbuild.EmitConstInt(b, 0, types.TypInt()), types.TypInt())
	irbuild.EmitStore(b, gep, irbuild.EmitConstInt(b, 7, types.TypInt()))
	var fusable @[]bool = FusableElemGeps(f, false)
	if !fusable[gep.ID] { return "single-use 8-byte GP element store must fuse" }
	return ""
}

// A GEP used more than once (load + a second use) cannot be elided — not fused.
func TestFusableGepTwoUsesNotFused() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var gep @ir.Instr = irbuild.EmitGetElemPtr(b, regBase(b),
			irbuild.EmitConstInt(b, 0, types.TypInt()), types.TypInt())
	_ = irbuild.EmitLoad(b, gep, types.TypInt())
	irbuild.EmitRefInc(b, gep) // a second use of the GEP pointer
	var fusable @[]bool = FusableElemGeps(f, false)
	if fusable[gep.ID] { return "a GEP with two uses must not fuse" }
	return ""
}

// An FP element rides the D-register path, not the GP load/store — not fused
// even though float64 is 8 bytes.
func TestFusableGepFloatElemNotFused() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var gep @ir.Instr = irbuild.EmitGetElemPtr(b, regBase(b),
			irbuild.EmitConstInt(b, 0, types.TypInt()), types.TypFloat64())
	_ = irbuild.EmitLoad(b, gep, types.TypFloat64())
	var fusable @[]bool = FusableElemGeps(f, false)
	if fusable[gep.ID] { return "an FP element access must not fuse" }
	return ""
}

// An alloca base reaches its address SP-relative, which the register-offset form
// cannot carry — not fused.
func TestFusableGepAllocaBaseNotFused() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var base @ir.Instr = irbuild.EmitAlloc(b, types.TypInt())
	var gep @ir.Instr = irbuild.EmitGetElemPtr(b, base, irbuild.EmitConstInt(b, 0, types.TypInt()),
			types.TypInt())
	_ = irbuild.EmitLoad(b, gep, types.TypInt())
	var fusable @[]bool = FusableElemGeps(f, false)
	if fusable[gep.ID] { return "a GEP off an alloca base must not fuse" }
	return ""
}

// A 4-byte GP element (int32) fuses too — the emitter uses LDRSW (signed) /
// LDR-W (unsigned).
func TestFusableGepElemSize4Fuses() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var gep @ir.Instr = irbuild.EmitGetElemPtr(b, regBase(b),
			irbuild.EmitConstInt(b, 0, types.TypInt()), types.TypInt32())
	_ = irbuild.EmitLoad(b, gep, types.TypInt32())
	var fusable @[]bool = FusableElemGeps(f, false)
	if !fusable[gep.ID] { return "a single-use 4-byte GP element load off a register base must fuse" }
	return ""
}

// A 4-byte FLOAT element (float32) does NOT fuse — FP rides the D-register path,
// not this GP load/store.
func TestFusableGepFloat32ElemNotFused() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var gep @ir.Instr = irbuild.EmitGetElemPtr(b, regBase(b),
			irbuild.EmitConstInt(b, 0, types.TypInt()), types.TypFloat32())
	_ = irbuild.EmitLoad(b, gep, types.TypFloat32())
	var fusable @[]bool = FusableElemGeps(f, false)
	if fusable[gep.ID] { return "a float32 element access must not fuse (FP, not GP)" }
	return ""
}

// A 2-byte element (int16) does NOT fuse (only 4- and 8-byte are handled).
func TestFusableGepElemSize2NotFused() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var gep @ir.Instr = irbuild.EmitGetElemPtr(b, regBase(b),
			irbuild.EmitConstInt(b, 0, types.TypInt()), types.TypInt16())
	_ = irbuild.EmitLoad(b, gep, types.TypInt16())
	var fusable @[]bool = FusableElemGeps(f, false)
	if fusable[gep.ID] { return "a 2-byte element access must not fuse (only 4/8-byte handled)" }
	return ""
}

// A float64 element load off a register base folds ONLY when the backend opts in
// (allowFloat=true — it has the scaled register-offset FP load); with allowFloat
// false the same access is excluded (the backend keeps floats GP-slotted).
func TestFusableGepFloatElemGatedByAllowFloat() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var base @ir.Instr = irbuild.EmitConstNil(b, types.MakePointerType(types.TypFloat64()))
	var gep @ir.Instr = irbuild.EmitGetElemPtr(b, base, irbuild.EmitConstInt(b, 0, types.TypInt()),
			types.TypFloat64())
	_ = irbuild.EmitLoad(b, gep, types.TypFloat64())
	if gep.ID < 0 { return "gep id out of range" }
	var yes @[]bool = FusableElemGeps(f, true)
	if gep.ID >= len(yes) || !yes[gep.ID] {
		return "float64 element load must fold when allowFloat=true"
	}
	var no @[]bool = FusableElemGeps(f, false)
	if gep.ID < len(no) && no[gep.ID] {
		return "float64 element load must NOT fold when allowFloat=false"
	}
	return ""
}
