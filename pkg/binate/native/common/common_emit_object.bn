package "pkg/binate/native/common"

import "pkg/binate/iropt"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/native/blockplan"
import "pkg/binate/native/place"

// EmitObject — see common.bni for the contract.  The one object-emission
// algorithm every native backend shares; each arch-specific step is an
// ArchEmitter method on `e`, so a backend's own EmitObject just builds its
// ArchEmitter and delegates here.
func EmitObject(e *ArchEmitter, mod @ir.Module, format *[]readonly char, path *[]readonly char,
		placement place.PlaceOptions, layout int) bool {
	// Set the object-format symbol-linkage prefix before any symbol is
	// emitted (ELF bare, Mach-O leading '_').
	e.SetPrefix(format)
	mod.FinalizeStrings()

	var a @asm.Assembler = asm.New(e.WordBytes())
	a.SetSection("text", -1)

	// Function placement and block layout: validate them before emitting anything.
	// Phase mode and a probe align .text to place.PLACE_SPAN (no bytes at offset 0),
	// so a function's offset modulo PLACE_SPAN in the object is its address modulo
	// PLACE_SPAN once linked.
	var perr @[]readonly char = place.PlaceCheck(placement, e.PlaceUnit())
	if len(perr) == 0 { perr = blockplan.BlockLayoutCheck(layout) }
	if len(perr) > 0 {
		a.SetError(perr)
		e.ClearPrefix()
		ReportEmitError(a, e.ArchName())
		return false
	}
	var placing bool = place.PlaceActive(placement)
	if placing {
		if placement.Mode == place.PLACE_PHASE || len(placement.ProbeSym) > 0 {
			a.AlignFill(place.PLACE_SPAN, 0)
		}
	}

	// Full package path; the mangler short-names it internally.
	var pkgName *[]readonly char = StripQuotes(mod.Name)

	// Prepare __c_entry: mark each OP_C_ENTRY whose target has a narrow GP
	// integer/bool parameter so its lowering references the weak
	// `__centry.<mangled>` adaptation thunk (ins.CEntryThunk), and collect those
	// targets so the thunks can be emitted below.  Fails loud only on an internal
	// inconsistency (a target with no known signature).  See common_c_entry.bn.
	var cEntryTargets @[]@ir.Func
	var cEntryOk bool
	cEntryTargets, cEntryOk = collectCEntryThunkTargets(a, e.CallConv(), mod)
	if !cEntryOk {
		e.ClearPrefix()
		ReportEmitError(a, e.ArchName())
		return false
	}

	var alignLoops bool = e.AlignsLoops()
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		// A pointer relabel (`@T` <-> `*T`) has no native lowering of its own: its
		// users read its operand directly.  Done in SSA form, before EliminatePhis
		// orders each edge's copies by their sources.
		forwardPointerRelabels(f)
		// Destruct SSA before lowering: the native backends have no phi opcode, so
		// iropt.EliminatePhis replaces OP_PHIs with OP_COPY moves (splitting critical
		// edges) — the shared chokepoint for all three arches.  A no-op for a
		// phi-free function (nothing emits phis yet).
		iropt.EliminatePhis(f)
		var sym @[]char
		var fill int = 0
		if placing {
			// Keyed by the symbol without the object-format prefix, so ELF and
			// Mach-O objects place a function alike.
			sym = mangle.FuncName(pkgName, f.Name)
			fill = place.PlaceFillBefore(placement, sym, e.PlaceUnit(), cast(int, a.CurrentOffset()))
			if fill > 0 { e.EmitPlaceFill(a, fill) }
		}
		// Planned after EliminatePhis, so the blocks it adds are laid out too.
		e.EmitFunc(a, pkgName, f, mod.Strings, blockplan.PlanBlocks(f, layout, alignLoops))
		if placing {
			// Only a probed function is followed by filler, which completes its
			// filler to PLACE_SPAN so the code after it does not move with its phase.
			var post int = place.PlaceFillAfter(placement, sym, fill)
			if post > 0 { e.EmitPlaceFill(a, post) }
		}
	}

	e.EmitCEntryThunks(a, pkgName, cEntryTargets)
	e.EmitFuncValueShims(a, pkgName, mod)
	e.EmitStringTable(a, pkgName, mod.Strings)
	e.EmitGlobals(a, pkgName, mod.Globals)
	e.EmitFuncValueVtables(a, pkgName, mod)
	e.EmitImplVtables(a, pkgName, mod)
	e.EmitPackageDescriptor(a, pkgName, mod)
	// Per-package `__pkg_satfrag` graph node (decentralized satentry enumeration),
	// after the descriptor so this module's own `__pkg_satentries` is defined first.
	EmitPkgSatFrag(a, e.SymPrefixed(""), mod)

	markFunctions(a)
	// Which same-section references resolve now depends on the object format.  A Mach-O
	// object's sections are divisible at its symbols, so the linker can dead-strip and
	// coalesce each function.
	a.ObjFormat = asm.OBJ_MACHO
	a.SubsectionsViaSymbols = true
	if ObjFmtEq(format, "elf") {
		a.ObjFormat = asm.OBJ_ELF
		a.SubsectionsViaSymbols = false
	}
	e.ResolveFixups(a)
	a.Finalize()

	// Restore the backend's default prefix before returning so the
	// object-format linkage state never leaks past one EmitObject call.
	var ok bool = !a.HasError
	e.ClearPrefix()
	if !ok {
		ReportEmitError(a, e.ArchName())
		return false
	}
	if !e.WriteObject(a, format, path) {
		// A relocation the object format cannot express is recorded on the
		// assembler; report it rather than only the caller's generic failure.
		ReportEmitError(a, e.ArchName())
		return false
	}
	return true
}

// markFunctions types every non-local symbol defined in an executable section a function
// (asm.SYM_FUNC), as LLVM's `.type @function` types each: a backend's text holds only
// functions (its data goes to data sections, and its block labels are local).  A linker
// interworking a Thumb caller into A32 code needs the type (bfd requires STT_FUNC), and
// debuggers and profilers read it.
func markFunctions(a @asm.Assembler) {
	for i := 0; i < a.NumSymbols; i++ {
		var s asm.Symbol = a.Symbols[i]
		if s.Section < 0 || s.Binding == asm.BIND_LOCAL { continue }
		if (a.Sections[s.Section].Flags & asm.SF_EXEC) == 0 { continue }
		a.Symbols[i].Type = asm.SYM_FUNC
	}
}
