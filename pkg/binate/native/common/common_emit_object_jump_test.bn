package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/native/blockplan"
import "pkg/binate/native/place"
import "pkg/builtins/testing"

// EmitObject's check that each function's jumps and branches target its own blocks,
// observed through relabelRecorder: a function that fails it stops the object before
// EmitFunc sees that function.

// jumpTestFunc returns a function named name, `entry: jump body; body: branch then,
// other; then: return; other: return`, and its four blocks.  A test whose function
// jumps to another's block keeps that function alive, as a module does in a compile.
func jumpTestFunc(name @[]char) (@ir.Func, @[]@ir.Block) {
	var f @ir.Func = ir.NewFunc("", name, makeNoParams(), makeNoResults())
	var bs @[]@ir.Block = make_slice(@ir.Block, 4)
	bs[0] = ir.AddBlock(f, "entry")
	bs[1] = ir.AddBlock(f, "body")
	bs[2] = ir.AddBlock(f, "then")
	bs[3] = ir.AddBlock(f, "other")
	irbuild.EmitJump(bs[0], bs[1])
	irbuild.EmitBranch(bs[1], irbuild.EmitConstBool(bs[1], true), bs[2], bs[3])
	irbuild.EmitReturn(bs[2], makeNoInstrs())
	irbuild.EmitReturn(bs[3], makeNoInstrs())
	return f, bs
}

// lastInstr returns b's last instruction (its terminator).
func lastInstr(b @ir.Block) @ir.Instr {
	return b.Instrs[len(b.Instrs) - 1]
}

// emitFuncs runs EmitObject over a module holding fs, in order, through rec.
func emitFuncs(fs @[]@ir.Func, rec *relabelRecorder) bool {
	var m @ir.Module = ir.NewModule("\"main\"")
	for i := 0; i < len(fs); i++ { m.AddFunc(fs[i]) }
	var e *ArchEmitter = rec
	var placement place.PlaceOptions
	return EmitObject(e, m, "elf", "unused.o", placement, blockplan.BLOCK_LAYOUT_SOURCE)
}

// stopsBeforeEmitting fails unless EmitObject, over first (whose targets are its own)
// followed by f, fails having handed EmitFunc only first.  what names f's fault.
func stopsBeforeEmitting(first @ir.Func, f @ir.Func, what *[]readonly char) testing.TestResult {
	var fs @[]@ir.Func = make_slice(@ir.Func, 2)
	fs[0] = first
	fs[1] = f
	var rec relabelRecorder
	if emitFuncs(fs, &rec) { return buf.Concat(what, ": EmitObject must fail") }
	if rec.funcs != 1 || rec.planned != first || rec.out != nil {
		return buf.Concat(what, ": EmitFunc must see the first function only, and no object be written")
	}
	return ""
}

// checkJumpTargets takes a function whose targets are its own and records an error
// naming the function, the block, the target and its function for one that jumps to
// another function's block.
func TestCheckJumpTargetsError() testing.TestResult {
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = jumpTestFunc("main.f")
	var ok @asm.Assembler = asm.New(8)
	if !checkJumpTargets(ok, f) || ok.HasError { return "own targets must pass" }
	var g @ir.Func
	var gb @[]@ir.Block
	g, gb = jumpTestFunc("main.g")
	lastInstr(fb[0]).Block1 = gb[1]
	var bad @asm.Assembler = asm.New(8)
	var want *[]readonly char = "native: a jump in main.f (block entry.0) has its target body.1 "
			"outside the function (a block of main.g)"
	if checkJumpTargets(bad, f) || !bad.HasError || len(bad.ErrorMsg) != len(want) ||
			!charsContainCommon(bad.ErrorMsg, want) {
		return buf.Concat("a jump to g's block must be the error; got: ", bad.ErrorMsg)
	}
	if !checkJumpTargets(ok, g) { return "g's own targets must pass" }
	return ""
}

// A module whose functions' targets are their own emits every function.
func TestEmitObjectTakesOwnJumpTargets() testing.TestResult {
	setTarget64()
	var f @ir.Func
	var g @ir.Func
	f, _ = jumpTestFunc("main.f")
	g, _ = jumpTestFunc("main.g")
	var fs @[]@ir.Func = make_slice(@ir.Func, 2)
	fs[0] = f
	fs[1] = g
	var rec relabelRecorder
	if !emitFuncs(fs, &rec) { return "EmitObject must succeed" }
	if rec.funcs != 2 { return "EmitFunc must see both functions" }
	return ""
}

// A jump to another function's block -- here one whose label f also has, which a
// label-named target would silently reach instead -- fails EmitObject before f, after
// that other function, which comes first in the module, is emitted.
func TestEmitObjectRejectsJumpToOtherFunction() testing.TestResult {
	setTarget64()
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = jumpTestFunc("main.f")
	var h @ir.Func
	var hb @[]@ir.Block
	h, hb = jumpTestFunc("main.h")
	if !ObjFmtEq(hb[1].Label, fb[1].Label) { return "both functions must have the label" }
	lastInstr(fb[0]).Block1 = hb[1]
	return stopsBeforeEmitting(h, f, "a jump to h's block")
}

// A jump with no target fails EmitObject before the function.
func TestEmitObjectRejectsNilJumpTarget() testing.TestResult {
	setTarget64()
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = jumpTestFunc("main.f")
	var none *ir.Block
	lastInstr(fb[0]).Block1 = none
	var g @ir.Func
	g, _ = jumpTestFunc("main.g")
	return stopsBeforeEmitting(g, f, "a nil jump target")
}

// A branch whose else-block is another function's fails EmitObject before the
// function.
func TestEmitObjectRejectsForeignElseBlock() testing.TestResult {
	setTarget64()
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb = jumpTestFunc("main.f")
	var h @ir.Func
	var hb @[]@ir.Block
	h, hb = jumpTestFunc("main.h")
	lastInstr(fb[1]).Block2 = hb[3]
	return stopsBeforeEmitting(h, f, "a foreign else-block")
}
