package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropt"
import "pkg/binate/native/blockplan"
import "pkg/binate/native/place"
import "pkg/builtins/testing"

// EmitObject's block layout, observed through relabelRecorder: the plan it hands
// EmitFunc, and its rejection of a layout that is not a mode.

// layoutLoopFunc builds `entry -> header; header: branch body, exit; body -> header;
// exit: return`, whose one loop header is block 1.
func layoutLoopFunc() @ir.Func {
	var f @ir.Func = ir.NewFunc("", "main.loop", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	irbuild.EmitJump(entry, header)
	irbuild.EmitBranch(header, irbuild.EmitConstBool(header, false), body, exit)
	irbuild.EmitJump(body, header)
	irbuild.EmitReturn(exit, makeNoInstrs())
	return f
}

// layoutIsIdentity reports whether plan's Order lists f's blocks in IR order.
func layoutIsIdentity(f @ir.Func, plan @blockplan.BlockPlan) bool {
	if len(plan.Order) != len(f.Blocks) { return false }
	for k := 0; k < len(plan.Order); k++ {
		if plan.Order[k] != k { return false }
	}
	return true
}

// layoutAlignsHeaders reports whether plan's AlignTop marks exactly f's loop headers.
func layoutAlignsHeaders(f @ir.Func, plan @blockplan.BlockPlan) bool {
	var headers @[]bool = iropt.ComputeLoopHeaders(f)
	if len(plan.AlignTop) != len(headers) { return false }
	for bi := 0; bi < len(headers); bi++ {
		if plan.AlignTop[bi] != headers[bi] { return false }
	}
	return true
}

// emitPlanned runs EmitObject over a module holding f, through rec, under layout.
func emitPlanned(f @ir.Func, rec *relabelRecorder, layout int) bool {
	var m @ir.Module = ir.NewModule("\"main\"")
	m.AddFunc(f)
	var e *ArchEmitter = rec
	var placement place.PlaceOptions
	return EmitObject(e, m, "elf", "unused.o", placement, layout)
}

// EmitFunc receives the function's plan under the layout EmitObject is given, with
// AlignTop only for a backend that aligns loops.
func TestEmitObjectHandsEmitFuncThePlan() testing.TestResult {
	setTarget64()
	var src relabelRecorder
	if !emitPlanned(layoutLoopFunc(), &src, blockplan.BLOCK_LAYOUT_SOURCE) {
		return "EmitObject must succeed"
	}
	if src.funcs != 1 || src.plan == nil { return "EmitFunc must receive a plan" }
	if !layoutIsIdentity(src.planned, src.plan) || src.plan.FallThrough {
		return "EmitFunc must receive the SOURCE plan"
	}
	if len(src.plan.AlignTop) != 0 { return "a backend that does not align loops gets no AlignTop" }
	var ft relabelRecorder
	ft.alignLoops = true
	if !emitPlanned(layoutLoopFunc(), &ft, blockplan.BLOCK_LAYOUT_FALLTHROUGH) {
		return "EmitObject must succeed"
	}
	if ft.plan == nil || !layoutIsIdentity(ft.planned, ft.plan) || !ft.plan.FallThrough {
		return "EmitFunc must receive the FALLTHROUGH plan"
	}
	if !layoutAlignsHeaders(ft.planned, ft.plan) {
		return "a backend that aligns loops must get the loop headers"
	}
	return ""
}

// An unknown layout fails EmitObject before anything is emitted.
func TestEmitObjectRejectsUnknownLayout() testing.TestResult {
	setTarget64()
	var modes @[]int = @[]int{-1, blockplan.BLOCK_LAYOUT_FALLTHROUGH + 1, 99}
	for i := 0; i < len(modes); i++ {
		var rec relabelRecorder
		if emitPlanned(layoutLoopFunc(), &rec, modes[i]) { return "an unknown layout must fail" }
		if rec.funcs != 0 || len(rec.log) != 0 || rec.out != nil {
			return "an unknown layout must fail before anything is emitted"
		}
	}
	return ""
}
