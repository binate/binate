package "pkg/binate/native/common"

import "pkg/binate/irbuild"
import "pkg/binate/iropt"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/blockplan"
import "pkg/binate/native/place"
import "pkg/binate/types"
import "pkg/builtins/testing"

// EmitObject's check that every operand of each function is one of its own values,
// observed through relabelRecorder: a function that fails it stops the object before
// phi elimination changes it and before EmitFunc sees it.

// operandStopsEmitting fails unless EmitObject, over m's functions -- first (whose
// operands are its own) followed by f -- fails with want on its assembler, having handed
// EmitFunc only first and written no object, and leaves f's merge block (nil for none) as
// it was: its phi not eliminated.  what names f's fault.
func operandStopsEmitting(m @ir.Module, first @ir.Func, merge @ir.Block, want *[]readonly char,
		what *[]readonly char) testing.TestResult {
	var rec relabelRecorder
	var e *ArchEmitter = &rec
	var placement place.PlaceOptions
	if EmitObject(e, m, "elf", "unused.o", placement, blockplan.BLOCK_LAYOUT_SOURCE) {
		return buf.Concat(what, ": EmitObject must fail")
	}
	if rec.funcs != 1 || rec.planned != first || rec.out != nil {
		return buf.Concat(what, ": EmitFunc must see the first function only, and no object be written")
	}
	var msg @[]char = rec.emitAsm.ErrorMsg
	if len(msg) != len(want) || !charsContainCommon(msg, want) {
		return buf.Concat(buf.Concat(what, ": the error must be the operand's; got: "), msg)
	}
	if merge != nil &&
			(countOp(merge, iropcode.OP_PHI) != 1 || countOp(merge, iropcode.OP_COPY) != 0) {
		return buf.Concat(what, ": f must be left as it was (no phi elimination)")
	}
	return ""
}

// loadTestFunc returns a function named name, `entry: l = load &gx; return l`, gx a
// global whose address pseudo it makes for m.
func loadTestFunc(m @ir.Module, name @[]char) @ir.Func {
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", name, makeNoParams(), results)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = irbuild.EmitLoad(entry, irbuild.NewGlobalRef(m, "main.gx", types.TypInt()),
			types.TypInt())
	irbuild.EmitReturn(entry, rets)
	return f
}

// checkOperands takes a function whose operands are its own and records an error naming
// the function, the block, the instruction, the operand and its function for one whose
// return reads another function's phi -- of the id of its own phi.
func TestCheckOperandsError() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb, _ = phiTestFunc("main.f")
	var g @ir.Func
	var gp @ir.Instr
	g, _, gp = phiTestFunc("main.g")
	m.AddFunc(f)
	m.AddFunc(g)
	var values @irbuild.ModuleValues = irbuild.NewModuleValues(m)
	var ok @asm.Assembler = asm.New(8)
	if !checkOperands(ok, f, values) || ok.HasError { return "own operands must pass" }
	var ret @ir.Instr = fb[3].Instrs[len(fb[3].Instrs) - 1]
	ret.Args[0] = gp
	var bad @asm.Assembler = asm.New(8)
	var want *[]readonly char = "native: a return in main.f (block merge.3) has its operand 0 (v3) "
			"outside the function (an instruction of main.g)"
	if checkOperands(bad, f, values) || !bad.HasError || len(bad.ErrorMsg) != len(want) ||
			!charsContainCommon(bad.ErrorMsg, want) {
		return buf.Concat("g's phi must be the error; got: ", bad.ErrorMsg)
	}
	if !checkOperands(ok, g, values) { return "g, whose operands are its own, must pass" }
	return ""
}

// A return reading another function's constant -- one with the id of the function's own,
// which a backend naming the operand by its id would read instead -- fails EmitObject
// before the function, after that other function, which comes first in the module, is
// emitted.
func TestEmitObjectRejectsOtherFunctionsOperand() testing.TestResult {
	setTarget64()
	var m @ir.Module = ir.NewModule("\"main\"")
	var g @ir.Func
	var gb @[]@ir.Block
	g, gb, _ = phiTestFunc("main.g")
	var f @ir.Func
	var fb @[]@ir.Block
	f, fb, _ = phiTestFunc("main.f")
	m.AddFunc(g)
	m.AddFunc(f)
	var one @ir.Instr = gb[1].Instrs[0]
	if one.ID != fb[1].Instrs[0].ID { return "both constants 1 must have the id" }
	var ret @ir.Instr = fb[3].Instrs[len(fb[3].Instrs) - 1]
	ret.Args[0] = one
	return operandStopsEmitting(m, g, fb[3],
			"native: a return in main.f (block merge.3) has its operand 0 (v1) outside the function "
					"(an instruction of main.g)",
			"g's constant")
}

// A function whose phis were eliminated before EmitObject fails it before the function: its
// operands can no longer be checked.
func TestEmitObjectRejectsPhiEliminatedFunction() testing.TestResult {
	setTarget64()
	var m @ir.Module = ir.NewModule("\"main\"")
	var g @ir.Func
	g, _, _ = phiTestFunc("main.g")
	var f @ir.Func
	f, _, _ = phiTestFunc("main.f")
	m.AddFunc(g)
	m.AddFunc(f)
	iropt.EliminatePhis(f)
	var none @ir.Block
	return operandStopsEmitting(m, g, none,
			"native: main.f has had its phis eliminated, after which its operands cannot be checked "
					"(they may read phis no block holds)",
			"f, its phis eliminated")
}

// A load of a global through the module's own global-address pseudo emits; one through
// another module's pseudo fails EmitObject before the function.
func TestEmitObjectTakesOnlyModulesGlobals() testing.TestResult {
	setTarget64()
	var m @ir.Module = ir.NewModule("\"main\"")
	var g @ir.Func
	g, _, _ = phiTestFunc("main.g")
	m.AddFunc(g)
	m.AddFunc(loadTestFunc(m, "main.f"))
	var rec relabelRecorder
	var e *ArchEmitter = &rec
	var placement place.PlaceOptions
	if !EmitObject(e, m, "elf", "unused.o", placement, blockplan.BLOCK_LAYOUT_SOURCE) {
		return buf.Concat("a load through the module's pseudo must emit; got: ", rec.emitAsm.ErrorMsg)
	}
	if rec.funcs != 2 { return "EmitFunc must see both functions" }
	m = ir.NewModule("\"main\"")
	g, _, _ = phiTestFunc("main.g")
	m.AddFunc(g)
	m.AddFunc(loadTestFunc(ir.NewModule("\"other\""), "main.f"))
	var none @ir.Block
	return operandStopsEmitting(m, g, none,
			"native: a load in main.f (block entry.0) has its operand 0, the address of main.gx, "
					"outside the module (not one of its global address pseudos)",
			"another module's pseudo")
}
