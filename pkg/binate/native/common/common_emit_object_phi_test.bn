package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// EmitObject's check that each function's phis name only its own blocks as their
// predecessors, observed through relabelRecorder: a function that fails it stops the
// object before phi elimination changes anything -- of it, or of the block outside it
// that the phi names -- and before EmitFunc sees it.

// phiTestFunc returns a function named name, `entry: branch left, right; left: jump
// merge; right: jump merge; merge: p = phi [1, left], [2, right]; return p`, its four
// blocks and its phi.
func phiTestFunc(name @[]char) (@ir.Func, @[]@ir.Block, @ir.Instr) {
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", name, makeNoParams(), results)
	var bs @[]@ir.Block = make_slice(@ir.Block, 4)
	bs[0] = ir.AddBlock(f, "entry")
	bs[1] = ir.AddBlock(f, "left")
	bs[2] = ir.AddBlock(f, "right")
	bs[3] = ir.AddBlock(f, "merge")
	irbuild.EmitBranch(bs[0], irbuild.EmitConstBool(bs[0], true), bs[1], bs[2])
	var one @ir.Instr = irbuild.EmitConstInt(bs[1], 1, types.TypInt())
	irbuild.EmitJump(bs[1], bs[3])
	var two @ir.Instr = irbuild.EmitConstInt(bs[2], 2, types.TypInt())
	irbuild.EmitJump(bs[2], bs[3])
	var p @ir.Instr = irbuild.EmitPhi(bs[3], types.TypInt(), relabelPhiEntries(bs[1], one, bs[2], two))
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = p
	irbuild.EmitReturn(bs[3], rets)
	return f, bs, p
}

// phiStopsEmitting fails unless EmitObject, over first (whose blocks are its own)
// followed by f, fails with want on its assembler, having handed EmitFunc only first and
// written no object, and leaves f as it was: its four blocks, merge still holding its
// phi.  what names f's fault.
func phiStopsEmitting(first @ir.Func, f @ir.Func, merge @ir.Block, want *[]readonly char,
		what *[]readonly char) testing.TestResult {
	var fs @[]@ir.Func = make_slice(@ir.Func, 2)
	fs[0] = first
	fs[1] = f
	var rec relabelRecorder
	if emitFuncs(fs, &rec) { return buf.Concat(what, ": EmitObject must fail") }
	if rec.funcs != 1 || rec.planned != first || rec.out != nil {
		return buf.Concat(what, ": EmitFunc must see the first function only, and no object be written")
	}
	var msg @[]char = rec.emitAsm.ErrorMsg
	if len(msg) != len(want) || !charsContainCommon(msg, want) {
		return buf.Concat(buf.Concat(what, ": the error must be the phi's; got: "), msg)
	}
	if len(f.Blocks) != 4 || countOp(merge, iropcode.OP_PHI) != 1 ||
			countOp(merge, iropcode.OP_COPY) != 0 {
		return buf.Concat(what, ": f must be left as it was (no phi elimination)")
	}
	return ""
}

// checkPhiPreds takes a function whose phis name its own blocks and records an error
// naming the function, the phi's block, the predecessor and its function for one whose
// phi names another function's block.
func TestCheckPhiPredsError() testing.TestResult {
	var f @ir.Func
	var p @ir.Instr
	f, _, p = phiTestFunc("main.f")
	var ok @asm.Assembler = asm.New(8)
	if !checkPhiPreds(ok, f) || ok.HasError { return "own predecessors must pass" }
	var g @ir.Func
	var gb @[]@ir.Block
	g, gb = jumpTestFunc("main.g")
	p.Phis[0].Block = gb[0]
	var bad @asm.Assembler = asm.New(8)
	var want *[]readonly char = "native: a phi in main.f (block merge.3) has its predecessor entry.0 "
			"outside the function (a block of main.g)"
	if checkPhiPreds(bad, f) || !bad.HasError || len(bad.ErrorMsg) != len(want) ||
			!charsContainCommon(bad.ErrorMsg, want) {
		return buf.Concat("a phi naming g's block must be the error; got: ", bad.ErrorMsg)
	}
	if !checkPhiPreds(ok, g) { return "g, which has no phis, must pass" }
	return ""
}

// A phi whose predecessor is another function's block -- here one whose label f also
// has, and which ends in a jump, before which phi elimination would put the edge's
// copies -- fails EmitObject before f, after that other function, which comes first in
// the module, is emitted, and leaves that block as it was: no copies spliced into it.
func TestEmitObjectRejectsPhiPredInOtherFunction() testing.TestResult {
	setTarget64()
	var g @ir.Func
	var gb @[]@ir.Block
	g, gb = jumpTestFunc("main.g")
	var f @ir.Func
	var fb @[]@ir.Block
	var p @ir.Instr
	f, fb, p = phiTestFunc("main.f")
	if !ObjFmtEq(gb[0].Label, fb[0].Label) { return "both functions must have the label" }
	p.Phis[0].Block = gb[0]
	var r testing.TestResult = phiStopsEmitting(g, f, fb[3],
			"native: a phi in main.f (block merge.3) has its predecessor entry.0 outside the function "
					"(a block of main.g)",
			"a predecessor in g")
	if len(r) > 0 { return r }
	if len(gb[0].Instrs) != 1 || countOp(gb[0], iropcode.OP_COPY) != 0 {
		return "g's block must be left as it was: its jump alone, no copies"
	}
	return ""
}

// A phi whose predecessor is one of the function's fault pads fails EmitObject before
// the function, and leaves the pad as it was.
func TestEmitObjectRejectsPhiPredFaultPad() testing.TestResult {
	setTarget64()
	var g @ir.Func
	g, _ = jumpTestFunc("main.g")
	var f @ir.Func
	var fb @[]@ir.Block
	var p @ir.Instr
	f, fb, p = phiTestFunc("main.f")
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	irbuild.EmitUnwindReturn(pad)
	p.Phis[1].Block = pad
	var r testing.TestResult = phiStopsEmitting(g, f, fb[3],
			"native: a phi in main.f (block merge.3) has its predecessor pad.0 outside the function's "
					"blocks (a fault pad)",
			"a fault-pad predecessor")
	if len(r) > 0 { return r }
	if len(pad.Instrs) != 1 { return "the pad must be left as it was: its unwind return alone" }
	return ""
}

// A phi entry with no predecessor fails EmitObject before the function.
func TestEmitObjectRejectsNilPhiPred() testing.TestResult {
	setTarget64()
	var g @ir.Func
	g, _ = jumpTestFunc("main.g")
	var f @ir.Func
	var fb @[]@ir.Block
	var p @ir.Instr
	f, fb, p = phiTestFunc("main.f")
	var none *ir.Block
	p.Phis[1].Block = none
	return phiStopsEmitting(g, f, fb[3], "native: a phi in main.f (block merge.3) has no predecessor",
			"a nil predecessor")
}

// A phi whose predecessor is a block a pass dropped from f.Blocks -- one of f's, which no
// backend emits, ending in a jump to the phi's block, before which phi elimination would
// put the edge's copies -- fails EmitObject before f, and leaves that block as it was.
func TestEmitObjectRejectsPhiPredDroppedBlock() testing.TestResult {
	setTarget64()
	var g @ir.Func
	g, _ = jumpTestFunc("main.g")
	var f @ir.Func
	var fb @[]@ir.Block
	var p @ir.Instr
	f, fb, p = phiTestFunc("main.f")
	var gone @ir.Block = ir.AddBlock(f, "gone")
	irbuild.EmitJump(gone, fb[3])
	f.Blocks = fb
	p.Phis[1].Block = gone
	var r testing.TestResult = phiStopsEmitting(g, f, fb[3],
			"native: a phi in main.f (block merge.3) has its predecessor gone.4 outside the "
					"function's blocks (a block dropped from them)",
			"a dropped predecessor")
	if len(r) > 0 { return r }
	if len(gone.Instrs) != 1 || countOp(gone, iropcode.OP_COPY) != 0 {
		return "the dropped block must be left as it was: its jump alone, no copies"
	}
	return ""
}
