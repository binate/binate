package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/native/place"
import "pkg/builtins/testing"

// EmitObject's function-placement filler, observed through relabelRecorder: which
// fills it asks for, where, and in what order relative to EmitFunc.

// placeFuncNames are the functions placeModule builds, in module order; the
// extern one (index placeExternIdx) gets no filler and no EmitFunc.
func placeFuncNames() @[]@[]char {
	return @[]@[]char{"main.alpha", "main.beta", "main.ext", "main.gamma", "main.delta"}
}

// placeExternIdx is the index of the extern function in placeFuncNames.
const placeExternIdx int = 2

// placeModule returns a module "main" holding placeFuncNames, each `{ return }`,
// with the one at placeExternIdx extern.
func placeModule() @ir.Module {
	var m @ir.Module = ir.NewModule("\"main\"")
	var names @[]@[]char = placeFuncNames()
	for i := 0; i < len(names); i++ {
		var f @ir.Func = ir.NewFunc("", names[i], makeNoParams(), makeNoResults())
		if i == placeExternIdx {
			f.IsExtern = true
		} else {
			irbuild.EmitReturn(ir.AddBlock(f, "entry"), makeNoInstrs())
		}
		m.AddFunc(f)
	}
	return m
}

// emitPlaced runs EmitObject over placeModule through rec under placement.
func emitPlaced(rec *relabelRecorder, placement place.PlaceOptions) bool {
	var e *ArchEmitter = rec
	return EmitObject(e, placeModule(), "elf", "unused.o", placement)
}

// textAlign returns the alignment a's text section requested (0 when nothing
// requested one), or -1 when a has no text section.
func textAlign(a @asm.Assembler) int {
	for i := 0; i < a.NumSections; i++ {
		if ObjFmtEq(a.Sections[i].Name, "text") { return a.Sections[i].Align }
	}
	return -1
}

// checkPlacedLog replays EmitObject's placement over placeModule and compares it
// with rec's log: before each non-extern function exactly the fill
// place.PlaceFillBefore asks for (none when it is 0), at the offset the previous
// call left, then the EmitFunc, then the fill place.PlaceFillAfter asks for (only
// a probed function has one).  "" when they match.
func checkPlacedLog(rec *relabelRecorder, placement place.PlaceOptions) testing.TestResult {
	var names @[]@[]char = placeFuncNames()
	var j int = 0
	var off int = 0
	for i := 0; i < len(names); i++ {
		if i == placeExternIdx { continue }
		var sym @[]char = mangle.FuncName("main", names[i])
		var want int = place.PlaceFillBefore(placement, sym, rec.PlaceUnit(), off)
		if want > 0 {
			if j >= len(rec.log) || rec.log[j] != want { return "a fill differs from PlaceFillBefore" }
			if rec.offs[j] != off { return "a fill starts at the wrong offset" }
			off = off + want
			j = j + 1
		}
		if j >= len(rec.log) || rec.log[j] != -1 { return "EmitFunc must follow its fill" }
		if rec.offs[j] != off { return "a function starts at the wrong offset" }
		off = off + rec.body
		j = j + 1
		var post int = place.PlaceFillAfter(placement, sym, want)
		if post > 0 {
			if j >= len(rec.log) || rec.log[j] != post { return "a fill differs from PlaceFillAfter" }
			if rec.offs[j] != off { return "the fill after a function starts at the wrong offset" }
			off = off + post
			j = j + 1
		}
	}
	if j != len(rec.log) { return "unexpected text calls after the last function" }
	return ""
}

// The zero PlaceOptions asks for no filler and leaves .text's alignment alone.
func TestEmitObjectZeroPlaceAddsNoFill() testing.TestResult {
	setTarget64()
	var rec relabelRecorder
	rec.body = 12
	var placement place.PlaceOptions
	if !emitPlaced(&rec, placement) { return "EmitObject must succeed" }
	if len(rec.log) != 4 { return "expected exactly the four EmitFunc calls" }
	for i := 0; i < len(rec.log); i++ {
		if rec.log[i] != -1 { return "no filler without a seed" }
	}
	if textAlign(rec.out) != 0 { return "the zero options must not align .text" }
	return ""
}

// A seed in shift mode puts exactly PlaceFillBefore's fill before each non-extern
// function and nothing before the extern one; .text keeps its alignment.
func TestEmitObjectShiftFillsBeforeEachFunc() testing.TestResult {
	setTarget64()
	var placement place.PlaceOptions
	placement.Seed = 12345
	placement.Mode = place.PLACE_SHIFT
	var rec relabelRecorder
	rec.body = 12
	if !emitPlaced(&rec, placement) { return "EmitObject must succeed" }
	var r testing.TestResult = checkPlacedLog(&rec, placement)
	if len(r) > 0 { return r }
	if len(rec.log) == 4 { return "seed 12345 should fill before some function" }
	if textAlign(rec.out) != 0 { return "shift mode must not align .text" }
	return ""
}

// Phase mode aligns .text to PLACE_SPAN and starts each function at the phase its
// hash picks, whatever the size of the code before it.
func TestEmitObjectPhaseModeLandsOnPhase() testing.TestResult {
	setTarget64()
	var placement place.PlaceOptions
	placement.Seed = 7
	placement.Mode = place.PLACE_PHASE
	var rec relabelRecorder
	rec.body = 20
	if !emitPlaced(&rec, placement) { return "EmitObject must succeed" }
	var r testing.TestResult = checkPlacedLog(&rec, placement)
	if len(r) > 0 { return r }
	if textAlign(rec.out) != place.PLACE_SPAN { return "phase mode must align .text to PLACE_SPAN" }
	var names @[]@[]char = placeFuncNames()
	var unit int = 4
	var k uint32 = cast(uint32, place.PLACE_SPAN / unit)
	var fi int = 0
	for i := 0; i < len(rec.log); i++ {
		if rec.log[i] != -1 { continue }
		if fi == placeExternIdx { fi = fi + 1 }
		var h uint32 = place.PlaceHash(placement.Seed, mangle.FuncName("main", names[fi]))
		var phi int = unit * cast(int, h % k)
		if rec.offs[i] % place.PLACE_SPAN != phi { return "a function is off its phase" }
		fi = fi + 1
	}
	return ""
}

// An invalid PlaceOptions fails EmitObject before any function is emitted, and
// no object is written.
func TestEmitObjectRejectsInvalidPlace() testing.TestResult {
	setTarget64()
	var badMode place.PlaceOptions
	badMode.Seed = 3
	badMode.Mode = 7
	var rec relabelRecorder
	if emitPlaced(&rec, badMode) { return "an unknown mode must fail EmitObject" }
	if len(rec.log) != 0 { return "nothing may be emitted under invalid options" }
	if rec.out != nil { return "no object may be written under an unknown mode" }
	var badSeed place.PlaceOptions
	badSeed.Seed = -1
	var rec2 relabelRecorder
	if emitPlaced(&rec2, badSeed) { return "a negative seed must fail EmitObject" }
	if rec2.out != nil { return "no object may be written under a negative seed" }
	var badUnit place.PlaceOptions
	badUnit.Seed = 3
	var rec3 relabelRecorder
	rec3.unit = 24
	if emitPlaced(&rec3, badUnit) { return "a unit that does not divide 64 must fail EmitObject" }
	if rec3.out != nil { return "no object may be written with a bad filler unit" }
	return ""
}
