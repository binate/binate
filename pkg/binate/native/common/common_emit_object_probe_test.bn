package "pkg/binate/native/common"

import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/binate/native/place"
import "pkg/builtins/testing"

// EmitObject's placement probe, observed through relabelRecorder: the fill around
// the probed function, .text's alignment, and what the probe leaves alone.

// probeIdx is the index in placeFuncNames of the function the tests probe: two
// emitted functions (and the extern one) precede it, and one follows it.
const probeIdx int = 3

// probePlacement returns PlaceOptions{seed, mode} probing placeFuncNames()[probeIdx]
// at phase.
func probePlacement(seed int, mode int, phase int) place.PlaceOptions {
	var p place.PlaceOptions
	p.Seed = seed
	p.Mode = mode
	p.ProbeSym = mangle.FuncName("main", placeFuncNames()[probeIdx])
	p.ProbePhase = phase
	return p
}

// funcOffsets returns the offset of each EmitFunc in rec's log, in order.
func funcOffsets(rec *relabelRecorder) @[]int {
	var out @[]int
	for i := 0; i < len(rec.log); i++ {
		if rec.log[i] == -1 { out = AppendInt(out, rec.offs[i]) }
	}
	return out
}

// A probe at seed 0 puts filler only around the probed function, totalling
// PLACE_SPAN, lands it on its phase, and aligns .text to PLACE_SPAN.
func TestEmitObjectProbeAtSeedZero() testing.TestResult {
	setTarget64()
	var placement place.PlaceOptions = probePlacement(0, place.PLACE_PHASE, 20)
	var rec relabelRecorder
	rec.body = 12
	if !emitPlaced(&rec, placement) { return "EmitObject must succeed" }
	var r testing.TestResult = checkPlacedLog(&rec, placement)
	if len(r) > 0 { return r }
	// alpha, beta, pre, gamma, post, delta.
	if len(rec.log) != 6 { return "only the probed function may get filler at seed 0" }
	if rec.log[3] != -1 || rec.offs[3] % place.PLACE_SPAN != 20 {
		return "the probed function must land on its phase"
	}
	if rec.log[2] + rec.log[4] != place.PLACE_SPAN {
		return "the probed function's filler must total PLACE_SPAN"
	}
	if textAlign(rec.out) != place.PLACE_SPAN { return "a probe must align .text to PLACE_SPAN" }
	return ""
}

// At seed 0 and under a seed in either mode, every probe phase puts the probed
// function on its phase and every other function at the same offset.
func TestEmitObjectProbeKeepsOtherOffsets() testing.TestResult {
	setTarget64()
	for c := 0; c < 3; c++ {
		var seed int = 0
		var mode int = place.PLACE_PHASE
		if c > 0 { seed = 12345 }
		if c == 2 { mode = place.PLACE_SHIFT }
		var first @[]int
		for phase := 0; phase < place.PLACE_SPAN; phase = phase + 4 {
			var placement place.PlaceOptions = probePlacement(seed, mode, phase)
			var rec relabelRecorder
			rec.body = 22
			if !emitPlaced(&rec, placement) { return "EmitObject must succeed" }
			var r testing.TestResult = checkPlacedLog(&rec, placement)
			if len(r) > 0 { return r }
			if textAlign(rec.out) != place.PLACE_SPAN { return "a probe must align .text to PLACE_SPAN" }
			var offs @[]int = funcOffsets(&rec)
			if len(offs) != 4 { return "expected four EmitFunc calls" }
			// offs[2] is the probed function (the extern one gets no EmitFunc).
			if offs[2] % place.PLACE_SPAN != phase { return "the probed function is off its phase" }
			if len(first) == 0 {
				first = offs
			} else if offs[0] != first[0] || offs[1] != first[1] || offs[3] != first[3] {
				return "a function other than the probed one moved with the probe phase"
			}
		}
	}
	return ""
}

// A probe whose symbol names no function of the module adds no filler; only
// .text's alignment changes.
func TestEmitObjectProbeMatchingNothing() testing.TestResult {
	setTarget64()
	var placement place.PlaceOptions
	placement.Mode = place.PLACE_PHASE
	placement.ProbeSym = buf.CopyStr("bn_F1_4_main1_7_nothing")
	placement.ProbePhase = 32
	var rec relabelRecorder
	rec.body = 12
	if !emitPlaced(&rec, placement) { return "EmitObject must succeed" }
	if len(rec.log) != 4 { return "a probe that matches nothing adds no filler" }
	if textAlign(rec.out) != place.PLACE_SPAN { return "a probe must align .text to PLACE_SPAN" }
	return ""
}

// rejectsProbe reports whether EmitObject fails for placement with filler unit
// unit, emitting no function and writing no object.
func rejectsProbe(placement place.PlaceOptions, unit int) bool {
	var rec relabelRecorder
	rec.unit = unit
	if emitPlaced(&rec, placement) { return false }
	return len(rec.log) == 0 && rec.out == nil
}

// A probe phase that is not a unit multiple in 0..PLACE_SPAN-1, or a probe phase
// without a probe symbol, fails EmitObject before anything is emitted.
func TestEmitObjectRejectsInvalidProbe() testing.TestResult {
	setTarget64()
	if !rejectsProbe(probePlacement(0, place.PLACE_PHASE, 6), 4) {
		return "phase 6 must fail with a 4-byte unit"
	}
	if !rejectsProbe(probePlacement(0, place.PLACE_PHASE, 8), 16) {
		return "phase 8 must fail with a 16-byte unit"
	}
	if !rejectsProbe(probePlacement(7, place.PLACE_SHIFT, 64), 4) { return "phase 64 must fail" }
	if !rejectsProbe(probePlacement(0, place.PLACE_PHASE, -4), 4) {
		return "a negative phase must fail"
	}
	var noSym place.PlaceOptions
	noSym.Mode = place.PLACE_PHASE
	noSym.ProbePhase = 16
	if !rejectsProbe(noSym, 4) { return "a probe phase without a symbol must fail" }
	return ""
}
