package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// relabelRecorder is an ArchEmitter that emits nothing and counts the functions
// EmitObject hands to EmitFunc and the OP_CASTs in them, so a test sees exactly
// the IR a backend would lower.
type relabelRecorder struct {
	casts int
	funcs int
}

func (e *relabelRecorder) WordBytes() int { return 8 }

func (e *relabelRecorder) CallConv() callconv.CallConv { return callconv.AAPCS64() }

func (e *relabelRecorder) SetPrefix(format *[]readonly char) {}

func (e *relabelRecorder) ClearPrefix() {}

func (e *relabelRecorder) SymPrefixed(name *[]readonly char) @[]char { return buf.CopyStr(name) }

func (e *relabelRecorder) ArchName() *[]readonly char { return "recorder" }

func (e *relabelRecorder) ElfTextMappingSymbol(format *[]readonly char) *[]readonly char {
	return ""
}

func (e *relabelRecorder) EmitFunc(a @asm.Assembler, pkgName *[]readonly char, f @ir.Func,
		strings @[]ir.StringConst) {
	e.funcs = e.funcs + 1
	for bi := 0; bi < len(f.Blocks); bi++ {
		e.casts = e.casts + countOp(f.Blocks[bi], iropcode.OP_CAST)
	}
}

func (e *relabelRecorder) EmitCEntryThunks(a @asm.Assembler, pkgName *[]readonly char,
		targets @[]@ir.Func) {}

func (e *relabelRecorder) EmitFuncValueShims(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {}

func (e *relabelRecorder) EmitStringTable(a @asm.Assembler, pkgName *[]readonly char,
		strings @[]ir.StringConst) {}

func (e *relabelRecorder) EmitGlobals(a @asm.Assembler, pkgName *[]readonly char,
		globals @[]@ir.Global) {}

func (e *relabelRecorder) EmitFuncValueVtables(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {}

func (e *relabelRecorder) EmitImplVtables(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {}

func (e *relabelRecorder) EmitPackageDescriptor(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {}

func (e *relabelRecorder) ResolveFixups(a @asm.Assembler) {}

func (e *relabelRecorder) WriteObject(a @asm.Assembler, format *[]readonly char,
		path *[]readonly char) bool {
	return true
}

impl *relabelRecorder : ArchEmitter

// emitRecorded runs EmitObject over a module holding just f, through rec.
func emitRecorded(f @ir.Func, rec *relabelRecorder) bool {
	var m @ir.Module = ir.NewModule("\"main\"")
	m.AddFunc(f)
	var e *ArchEmitter = rec
	return EmitObject(e, m, "macho", "unused.o")
}

// relabelPhiEntries returns a two-entry phi list: v1 from b1, v2 from b2.
func relabelPhiEntries(b1 @ir.Block, v1 @ir.Instr, b2 @ir.Block, v2 @ir.Instr) @[]ir.PhiEntry {
	var es @[]ir.PhiEntry = make_slice(ir.PhiEntry, 2)
	es[0].Block = b1
	es[0].Val = v1
	es[1].Block = b2
	es[1].Val = v2
	return es
}

// EmitObject hands a backend no pointer relabel: a managed -> raw relabel never
// reaches EmitFunc, while a pointer -> int conversion in the same function does.
func TestEmitObjectForwardsPointerRelabels() testing.TestResult {
	setTarget64()
	var thing @types.Type = relabelThingTyp("Thing")
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var mp @ir.Instr = relabelLoad(b, types.MakeManagedPtrType(thing))
	var c @ir.Instr = irbuild.EmitCast(b, mp, types.MakePointerType(thing))
	irbuild.EmitLoad(b, irbuild.EmitGetFieldPtr(b, c, 1, types.TypInt()), types.TypInt())
	irbuild.EmitCast(b, mp, types.TypInt())
	irbuild.EmitReturn(b, makeNoInstrs())
	var rec relabelRecorder
	if !emitRecorded(f, &rec) { return "EmitObject must succeed" }
	if rec.funcs != 1 { return "EmitFunc must see the one function" }
	if rec.casts != 1 { return "EmitFunc must see the int conversion and not the relabel" }
	return ""
}

// A relabel of one loop phi feeding another phi on the back edge keeps the
// copies' order: `last` takes `cur`'s value from THIS iteration, not the `next`
// that `cur` is about to receive.  (In `for cur != nil { last = cast(*T, cur);
// cur = cur.next }` the copies `cur <- next; last <- cast(cur)` would, with the
// relabel forwarded after phi elimination, become `cur <- next; last <- cur`.)
func TestEmitObjectRelabelOfPhiKeepsCopyOrder() testing.TestResult {
	setTarget64()
	var rp @types.Type = types.MakePointerType(relabelThingTyp("Thing"))
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var latch @ir.Block = ir.AddBlock(f, "latch")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var p0 @ir.Instr = relabelLoad(pre, rp)
	var q0 @ir.Instr = relabelLoad(pre, rp)
	irbuild.EmitJump(pre, header)
	var cur @ir.Instr = irbuild.EmitPhi(header, rp, relabelPhiEntries(pre, p0, pre, p0))
	var last @ir.Instr = irbuild.EmitPhi(header, rp, relabelPhiEntries(pre, q0, pre, q0))
	irbuild.EmitBranch(header, irbuild.EmitConstBool(header, true), latch, exit)
	var next @ir.Instr = relabelLoad(latch, rp)
	var c @ir.Instr = irbuild.EmitCast(latch, cur, rp)
	irbuild.EmitJump(latch, header)
	cur.Phis = relabelPhiEntries(pre, p0, latch, next)
	last.Phis = relabelPhiEntries(pre, q0, latch, c)
	irbuild.EmitReturn(exit, makeNoInstrs())
	var curID int = cur.ID
	var lastID int = last.ID
	var nextID int = next.ID
	var rec relabelRecorder
	if !emitRecorded(f, &rec) { return "EmitObject must succeed" }
	if rec.casts != 0 { return "the relabel must not reach EmitFunc" }
	// Run the latch's copies on a register file: id -> value.
	var regs @[]int = make_slice(int, f.NextID)
	regs[curID] = 100
	regs[lastID] = 200
	regs[nextID] = 300
	for i := 0; i < len(latch.Instrs); i++ {
		var ins @ir.Instr = latch.Instrs[i]
		if ins.Op == iropcode.OP_COPY { regs[ins.ID] = regs[ins.Args[0].ID] }
	}
	if regs[lastID] != 100 { return "last must take cur's value from this iteration" }
	if regs[curID] != 300 { return "cur must take next" }
	return ""
}
