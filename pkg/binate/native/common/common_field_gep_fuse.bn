package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/types"

// FusableFieldGeps returns a dense ID-indexed flag set (sized to f.NextID):
// element [id] is true iff the OP_GET_FIELD_PTR value with that SSA id can be
// folded into a CONSTANT-offset load/store — so its field address
// (base + FieldByteOffset) rides in the memory operand (`[base, #off]` on aa64 /
// arm32, `[base+disp]` on x64) instead of being materialized by a separate ADD.
//
// A backend that supports the fold skips the flagged GEP's standalone emission
// and rederives the address inside the consuming load/store from the GEP's own
// base operand + its field offset; AllocateRegisters then leaves the GEP result
// unhomed (nothing reads it as a register) — the fold flag is unioned into the
// liveness fusable set so the base stays live to the consumer, not to the
// elided GEP.
//
// The conditions are exactly what makes that fold correct AND a net win:
//   - the result is used EXACTLY ONCE, as the ADDRESS (Args[0]) of an OP_LOAD or
//     OP_STORE — a second use would need the pointer in a register, so the GEP
//     cannot be elided; a use in any other position (incl. a phi, or the stored
//     VALUE at Args[1]) disqualifies.
//   - that access is a plain scalar (see fieldAccessFusable): not an aggregate
//     (handled by-address / memcpy), and — on a 32-bit target — not a 64-bit
//     INTEGER (int64/uint64), which the backend loads/stores through a separate
//     64-bit path, not the single-word constant-offset form.
//     A FLOAT scalar folds only when the backend opts in via allowFloat: its
//     fused field load/store must move the value straight between its FP-register
//     home and `[base, #off]` (a backend that can't leaves floats unfolded).  On
//     a 32-bit target allowFloat also admits a float64 field, so a 32-bit backend
//     that sets it must fold the field GEP in its 64-bit load/store path too.
//   - the base is a register value OR an alloca — NOT a package global.  A
//     register base rides its field offset in the memory operand; an alloca base
//     is SP/frame-relative, so the fused emitter folds allocaOffset+fieldOffset
//     into the access (`[sp,#off]`) instead of a standalone `add`/`lea`.  A
//     global base (ADRP+ADD / MOVW+MOVT) needs a register for its address
//     regardless, so folding only the field offset saves nothing over the
//     standalone GEP+load — it keeps the standalone GEP.
//   - the field's byte offset is resolvable (FieldByteOffset) — a struct
//     FieldOffset, or wordBytes*Index for a slice-descriptor field.
//   - on a 32-bit target a REGISTER-base offset additionally fits arm32's
//     smallest load/store immediate (255): arm32's assembler REJECTS an
//     over-range LDR/STR offset (unlike aa64, which materializes a scratch), so
//     a larger offset keeps the standalone GEP.  An alloca base's folded offset
//     (allocaOffset+fieldOffset) isn't known until frame layout, past this pass,
//     so no bound is applied here — the arm32 fused emitter materializes a
//     scratch when that combined offset overruns.  wordBytes==8 targets
//     (aa64/x64) need no bound — aa64 materializes a scratch, x64's signed
//     32-bit displacement holds any offset below 2 GiB.
//
// wordBytes is the target pointer/int size (8 on aa64/x64, 4 on arm32), matching
// the value passed to AllocateRegisters.  allowFloat admits float-typed accesses
// (see above).
func FusableFieldGeps(f @ir.Func, wordBytes int, allowFloat bool) @[]bool {
	var n int = f.NextID
	var useCount @[]int = make_slice(int, n)
	var addrUse @[]bool = make_slice(bool, n)

	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			var isMemAddr bool = (ins.Op == iropcode.OP_LOAD || ins.Op == iropcode.OP_STORE) &&
					fieldAccessFusable(ins, wordBytes, allowFloat)
			for ai := 0; ai < len(ins.Args); ai++ {
				markGepUse(useCount, addrUse, ins.Args[ai], isMemAddr && ai == 0)
			}
			for pi := 0; pi < len(ins.Phis); pi++ {
				markGepUse(useCount, addrUse, ins.Phis[pi].Val, false)
			}
		}
	}

	var fusable @[]bool = make_slice(bool, n)
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.Op != iropcode.OP_GET_FIELD_PTR || ins.ID < 0 || ins.ID >= n {
				continue
			}
			if useCount[ins.ID] != 1 || !addrUse[ins.ID] {
				continue
			}
			if !fieldGepBaseFusable(ins) {
				continue
			}
			var off int
			var ok bool
			off, ok = FieldByteOffset(ins, wordBytes)
			if !ok {
				continue
			}
			// arm32's assembler rejects an over-range LDR/STR immediate.  A
			// register base folds the field offset ALONE into the memory operand,
			// so bound it here.  An alloca base folds allocaOffset+fieldOffset —
			// unknown until frame layout (after this pass) — and the fused emitter
			// materializes a scratch when that combined offset overruns, so it
			// needs no analysis-time bound.
			if !gepBaseIsAlloca(ins) && wordBytes == 4 && (off < 0 || off > 255) {
				continue
			}
			fusable[ins.ID] = true
		}
	}
	return fusable
}

// fieldAccessFusable reports whether load/store `ins` accesses a plain scalar the
// constant-offset fold handles: not an aggregate (handled by-address), not a
// float unless allowFloat (the backend's fused field load/store moves a float
// straight between its FP home and memory), and — on a 32-bit target — not a
// 64-bit integer (the backend's separate 64-bit load/store path; a float64 is
// admitted with allowFloat, see FusableFieldGeps).  Any
// narrower scalar size is fine — a constant-offset load/store size-dispatches to
// LDRB/LDRH/LDR (aa64) / MOVZX/MOV (x64) etc.
func fieldAccessFusable(ins @ir.Instr, wordBytes int, allowFloat bool) bool {
	var t @types.Type
	if ins.Op == iropcode.OP_LOAD {
		t = ins.Typ
	} else {
		if len(ins.Args) < 2 || ins.Args[1] == nil {
			return false
		}
		t = ins.Args[1].Typ
	}
	if t == nil {
		return false
	}
	if callconv.IsAggregateTyp(t) {
		return false
	}
	if callconv.IsFloatScalarTyp(t) && !allowFloat {
		return false
	}
	if wordBytes == 4 && t.SizeOf() > wordBytes && !(allowFloat && callconv.IsFloatScalarTyp(t)) {
		return false
	}
	return true
}

// FieldByteOffset returns the byte offset of the field an OP_GET_FIELD_PTR
// addresses, matching each backend's emitGetFieldPtr: a struct base gives
// FieldOffset(Index); a slice-descriptor base gives wordBytes*Index (data / len /
// [refptr, backingLen] in word-sized slots).  ok=false when the base is neither
// a struct nor a slice descriptor (the GEP keeps its standalone emission).  The
// fused consumers and the arm32 offset-range gate both call this, so the offset
// they emit and the offset the analysis bounds are one computation.
func FieldByteOffset(gep @ir.Instr, wordBytes int) (int, bool) {
	if len(gep.Args) < 1 || gep.Args[0] == nil {
		return 0, false
	}
	var st @types.Type = StructTypeOf(gep.Args[0])
	if st != nil {
		return st.FieldOffset(gep.Index), true
	}
	if IsSliceFieldBase(gep.Args[0]) {
		return wordBytes * gep.Index, true
	}
	return 0, false
}

// fieldGepBaseFusable reports whether the field GEP's base is one the
// constant-offset fold can carry: a plain register value (its field offset rides
// the memory operand) OR an alloca (SP/frame-relative — the fused emitter folds
// allocaOffset+fieldOffset into the access).  A package-global base (ADRP+ADD /
// MOVW+MOVT) is excluded: its address needs a register regardless, so folding
// only the field offset saves nothing over the standalone GEP+load.
func fieldGepBaseFusable(gep @ir.Instr) bool {
	return gepBaseIsRegister(gep) || gepBaseIsAlloca(gep)
}

// gepBaseIsAlloca reports whether the GEP's base operand (Args[0]) is a genuine
// stack OP_ALLOC — a slot whose address is SP/frame-relative (LookupAlloc >= 0).
// A package-global reference ALSO presents as an OP_ALLOC (the IsGlobalRef
// pseudo-instr lookupVar produces for a module-level var — see ir.Instr's
// IsGlobalRef), but its storage is a data-section global reached via ADRP/ADD,
// NOT a frame slot: it has no AllocOffset, so folding it would elide the GEP
// while the fused load found no base register (a wrong, uninitialized result).
// Exclude it so a global-var field access keeps its standalone GEP.
func gepBaseIsAlloca(gep @ir.Instr) bool {
	if len(gep.Args) < 1 || gep.Args[0] == nil {
		return false
	}
	return gep.Args[0].Op == iropcode.OP_ALLOC && !gep.Args[0].IsGlobalRef
}
