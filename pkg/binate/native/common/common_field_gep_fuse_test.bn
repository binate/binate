package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for FusableFieldGeps / FieldByteOffset (common_field_gep_fuse.bn): which
// OP_GET_FIELD_PTRs fold into a constant-offset load/store.

// twoFieldStruct builds `struct S { f0 t0; f1 t1 }` — field 1 is the fuse target
// (its offset depends on the live types target, so tests set it first).
func twoFieldStruct(t0 @types.Type, t1 @types.Type) @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 2)
	var a @types.Field = make(types.Field)
	a.Name = "f0"
	a.Type = t0
	var c @types.Field = make(types.Field)
	c.Name = "f1"
	c.Type = t1
	fs[0] = a
	fs[1] = c
	return types.MakeStructType("S", fs)
}

// structBase emits a register-valued pointer to struct st (a nil `*S` —
// OP_CONST_NIL, so not an alloca and not a global).
func structBase(b @ir.Block, st @types.Type) @ir.Instr {
	return irbuild.EmitConstNil(b, types.MakePointerType(st))
}

// A single-use scalar field load off a register struct base folds.
func TestFusableFieldLoadSingleUse() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoFieldStruct(types.TypInt(), types.TypInt())
	var gep @ir.Instr = irbuild.EmitGetFieldPtr(b, structBase(b, st), 1, types.TypInt())
	_ = irbuild.EmitLoad(b, gep, types.TypInt())
	var fusable @[]bool = FusableFieldGeps(f, 8)
	if gep.ID < 0 || gep.ID >= len(fusable) { return "gep id out of range" }
	if !fusable[gep.ID] { return "single-use scalar field load off a register base must fuse" }
	return ""
}

// Same for a store.
func TestFusableFieldStoreSingleUse() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoFieldStruct(types.TypInt(), types.TypInt())
	var gep @ir.Instr = irbuild.EmitGetFieldPtr(b, structBase(b, st), 1, types.TypInt())
	irbuild.EmitStore(b, gep, irbuild.EmitConstInt(b, 7, types.TypInt()))
	var fusable @[]bool = FusableFieldGeps(f, 8)
	if !fusable[gep.ID] { return "single-use field store must fuse" }
	return ""
}

// A field GEP used more than once (load + a second use) cannot be elided.
func TestFusableFieldTwoUsesNotFused() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoFieldStruct(types.TypInt(), types.TypInt())
	var gep @ir.Instr = irbuild.EmitGetFieldPtr(b, structBase(b, st), 1, types.TypInt())
	_ = irbuild.EmitLoad(b, gep, types.TypInt())
	irbuild.EmitRefInc(b, gep) // a second use of the field pointer
	var fusable @[]bool = FusableFieldGeps(f, 8)
	if fusable[gep.ID] { return "a field GEP with two uses must not fuse" }
	return ""
}

// An FP field rides the D-register path, not the GP load/store — not fused.
func TestFusableFieldFloatNotFused() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoFieldStruct(types.TypInt(), types.TypFloat64())
	var gep @ir.Instr = irbuild.EmitGetFieldPtr(b, structBase(b, st), 1, types.TypFloat64())
	_ = irbuild.EmitLoad(b, gep, types.TypFloat64())
	var fusable @[]bool = FusableFieldGeps(f, 8)
	if fusable[gep.ID] { return "an FP field access must not fuse" }
	return ""
}

// An aggregate field is loaded by-address (memcpy), not the scalar path.
func TestFusableFieldAggregateNotFused() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var inner @types.Type = twoFieldStruct(types.TypInt(), types.TypInt())
	var st @types.Type = twoFieldStruct(types.TypInt(), inner)
	var gep @ir.Instr = irbuild.EmitGetFieldPtr(b, structBase(b, st), 1, inner)
	_ = irbuild.EmitLoad(b, gep, inner)
	var fusable @[]bool = FusableFieldGeps(f, 8)
	if fusable[gep.ID] { return "an aggregate field access must not fuse" }
	return ""
}

// An alloca base folds allocaOffset+fieldOffset into an SP/frame-relative access
// (`[sp,#off]`), so its single-use scalar field GEP fuses (no standalone add).
func TestFusableFieldAllocaBaseFuses() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoFieldStruct(types.TypInt(), types.TypInt())
	var base @ir.Instr = irbuild.EmitAlloc(b, st)
	var gep @ir.Instr = irbuild.EmitGetFieldPtr(b, base, 1, types.TypInt())
	_ = irbuild.EmitLoad(b, gep, types.TypInt())
	var fusable @[]bool = FusableFieldGeps(f, 8)
	if !fusable[gep.ID] { return "a field off an alloca base must fuse (SP-relative fold)" }
	return ""
}

// On arm32 an alloca base fuses regardless of offset: the analysis applies NO
// bound to an alloca (its combined allocaOffset+fieldOffset isn't known until
// frame layout), and the fused emitter materializes a scratch when the offset
// overruns.  A field past 255 off an alloca still fuses — contrast the
// register-base bound (TestFusableFieldLargeOffsetArm32NotFused).
func TestFusableFieldAllocaLargeOffsetArm32Fuses() testing.TestResult {
	setTarget32()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	// field 0 = [64]int32 = 256 bytes, so field 1 (int32) lands at offset 256.
	var arrTyp @types.Type = types.MakeArrayType(types.TypInt32(), 64)
	var st @types.Type = twoFieldStruct(arrTyp, types.TypInt32())
	var base @ir.Instr = irbuild.EmitAlloc(b, st)
	var gep @ir.Instr = irbuild.EmitGetFieldPtr(b, base, 1, types.TypInt32())
	_ = irbuild.EmitLoad(b, gep, types.TypInt32())
	var fusable @[]bool = FusableFieldGeps(f, 4)
	setTarget64()
	if !fusable[gep.ID] { return "a field off an alloca base must fuse on arm32 regardless of offset" }
	return ""
}

// A global base reaches its address ADRP+ADD — kept as a standalone GEP.
func TestFusableFieldGlobalBaseNotFused() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoFieldStruct(types.TypInt(), types.TypInt())
	var base @ir.Instr = irbuild.EmitConstNil(b, types.MakePointerType(st))
	base.IsGlobalRef = true
	var gep @ir.Instr = irbuild.EmitGetFieldPtr(b, base, 1, types.TypInt())
	_ = irbuild.EmitLoad(b, gep, types.TypInt())
	var fusable @[]bool = FusableFieldGeps(f, 8)
	if fusable[gep.ID] { return "a field off a global base must not fuse" }
	return ""
}

// A package-global var reference ALSO presents as an OP_ALLOC — the IsGlobalRef
// pseudo-instr lookupVar produces for a module-level var — but its storage is a
// data-section global (ADRP/ADD), NOT a frame slot, so it must NOT fuse: folding
// it elides the GEP while the fused load finds no base register, yielding a wrong
// uninitialized result.  (`var target ...`-style field access, e.g. types.intSize
// reading target.IntSize.)
func TestFusableFieldGlobalAllocaNotFused() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoFieldStruct(types.TypInt(), types.TypInt())
	var base @ir.Instr = irbuild.EmitAlloc(b, st)
	base.IsGlobalRef = true // module-global var: OP_ALLOC-shaped but ADRP-addressed
	var gep @ir.Instr = irbuild.EmitGetFieldPtr(b, base, 1, types.TypInt())
	_ = irbuild.EmitLoad(b, gep, types.TypInt())
	var fusable @[]bool = FusableFieldGeps(f, 8)
	if fusable[gep.ID] { return "a field off a global-var (IsGlobalRef) alloca must not fuse" }
	return ""
}

// A slice-descriptor field (data / len / ...) off a register slice base folds —
// IsSliceFieldBase, offset = wordBytes*Index.
func TestFusableFieldSliceBaseFuses() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var sliceTyp @types.Type = types.MakeSliceType(types.TypInt())
	var ptrTyp @types.Type = types.MakePointerType(types.TypInt())
	var base @ir.Instr = irbuild.EmitConstNil(b, types.MakePointerType(sliceTyp))
	var gep @ir.Instr = irbuild.EmitGetFieldPtr(b, base, 0, ptrTyp)
	_ = irbuild.EmitLoad(b, gep, ptrTyp)
	var fusable @[]bool = FusableFieldGeps(f, 8)
	if !fusable[gep.ID] { return "single-use slice-descriptor field load must fuse" }
	return ""
}

// On a 32-bit target an int64 field is a register PAIR (separate two-register
// load path), so it must not fuse into the single-register constant-offset form.
func TestFusableFieldInt64Arm32NotFused() testing.TestResult {
	setTarget32()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoFieldStruct(types.TypInt64(), types.TypInt64())
	var gep @ir.Instr = irbuild.EmitGetFieldPtr(b, structBase(b, st), 1, types.TypInt64())
	_ = irbuild.EmitLoad(b, gep, types.TypInt64())
	var fusable @[]bool = FusableFieldGeps(f, 4)
	setTarget64()
	if fusable[gep.ID] { return "an int64 register-pair field must not fuse on a 32-bit target" }
	return ""
}

// On a 32-bit target a field past offset 255 must not fuse — arm32's assembler
// rejects an over-range LDR/STR immediate, so it keeps the standalone GEP.
func TestFusableFieldLargeOffsetArm32NotFused() testing.TestResult {
	setTarget32()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	// field 0 = [64]int32 = 256 bytes, so field 1 (int32) lands at offset 256.
	var arrTyp @types.Type = types.MakeArrayType(types.TypInt32(), 64)
	var st @types.Type = twoFieldStruct(arrTyp, types.TypInt32())
	var gep @ir.Instr = irbuild.EmitGetFieldPtr(b, structBase(b, st), 1, types.TypInt32())
	_ = irbuild.EmitLoad(b, gep, types.TypInt32())
	var fusable @[]bool = FusableFieldGeps(f, 4)
	setTarget64()
	if fusable[gep.ID] { return "a field at offset > 255 must not fuse on a 32-bit target" }
	return ""
}

// The offset bound is 32-bit-only: the same far field fuses on a 64-bit target
// (aa64 materializes a scratch for a big offset; x64's displacement is 32-bit).
func TestFusableFieldLargeOffset64Fuses() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var arrTyp @types.Type = types.MakeArrayType(types.TypInt(), 32) // 256 bytes
	var st @types.Type = twoFieldStruct(arrTyp, types.TypInt())
	var gep @ir.Instr = irbuild.EmitGetFieldPtr(b, structBase(b, st), 1, types.TypInt())
	_ = irbuild.EmitLoad(b, gep, types.TypInt())
	var fusable @[]bool = FusableFieldGeps(f, 8)
	if !fusable[gep.ID] { return "a far field fuses on a 64-bit target (no arm32 imm bound)" }
	return ""
}

// FieldByteOffset: field 1 of {int,int} is at offset 8 (LP64).
func TestFieldByteOffsetStruct() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var st @types.Type = twoFieldStruct(types.TypInt(), types.TypInt())
	var gep @ir.Instr = irbuild.EmitGetFieldPtr(b, structBase(b, st), 1, types.TypInt())
	var off int
	var ok bool
	off, ok = FieldByteOffset(gep, 8)
	if !ok { return "struct field offset must resolve" }
	if off != 8 { return "field 1 of {int,int} must be at offset 8" }
	return ""
}

// FieldByteOffset: a slice-descriptor field N is at wordBytes*N.
func TestFieldByteOffsetSlice() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var sliceTyp @types.Type = types.MakeSliceType(types.TypInt())
	var base @ir.Instr = irbuild.EmitConstNil(b, types.MakePointerType(sliceTyp))
	var gep @ir.Instr = irbuild.EmitGetFieldPtr(b, base, 2, types.TypInt())
	var off int
	var ok bool
	off, ok = FieldByteOffset(gep, 8)
	if !ok { return "slice field offset must resolve" }
	if off != 16 { return "slice field 2 must be at offset 16 (8*2)" }
	return ""
}
