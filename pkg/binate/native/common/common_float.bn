package "pkg/binate/native/common"

import "pkg/std/strconv"

// Decimal/hex float literal → IEEE 754 bit pattern, plus a float64 → float32
// narrowing used to materialize float32 constants.
//
// Shared by every native backend (aarch64, x64, future arches) AND the
// bytecode VM (pkg/binate/vm routes its OP_CONST_FLOAT through here), so a
// `float64 = <literal>` has ONE deterministic value across every execution
// mode.  Lives in common because it's a language-level mapping from source
// text to ABI-stable bits — what the IR says a float literal contains.
//
// ParseFloatLitToBits delegates to pkg/std/strconv.ParseFloat — the exact,
// correctly-rounded (round-half-to-even) decimal→binary conversion that
// evaluates the literal as a rational over big.Nat and so is free of the
// table-maker's dilemma.  (The previous hand-rolled fixed-width-window
// converter rounded ~38+-significant-digit literals sitting just above a
// binary tie 1 ULP low.)  ParseFloat's rounding is big.Nat integer
// arithmetic and only its final bit pattern is reinterpreted as a float here,
// so the value is identical across LLVM-built / VM-built / native-built bnc.
//
// F64BitsToF32Bits is an independent bit-level narrowing (no parsing) for
// float32 constants.

// F64BitsToF32Bits narrows an IEEE-754 double bit pattern to the single
// (float32) bit pattern, rounding to nearest, ties to even (handling
// overflow→±Inf and underflow→±denormal/zero).  Used to materialize a
// float32 CONSTANT: a float32-typed literal must carry its 32-bit float
// value, not the low 32 bits of the float64 pattern.
func F64BitsToF32Bits(b uint64) uint32 {
	var sign uint32 = cast(uint32, (b >> cast(uint64, 63)) & cast(uint64, 1))
	var exp int = cast(int, (b >> cast(uint64, 52)) & cast(uint64, 0x7FF))
	var man uint64 = b & cast(uint64, 0xFFFFFFFFFFFFF)
	if exp == 2047 {
		if man == cast(uint64, 0) {
			return (sign << cast(uint32, 31)) | (cast(uint32, 0xFF) << cast(uint32, 23))
		}
		// NaN: keep it quiet, preserving the top mantissa bits.
		var nm uint32 = cast(uint32, man >> cast(uint64, 29))
		if nm == cast(uint32, 0) {
			nm = cast(uint32, 1)
		}
		return (sign << cast(uint32, 31)) | (cast(uint32, 0xFF) << cast(uint32, 23)) |
				(nm | cast(uint32, 0x400000))
	}
	if exp == 0 {
		// Double zero, or a double subnormal — far below the float32 range, so 0.
		return sign << cast(uint32, 31)
	}
	var unbiased int = exp - 1023
	var mant53 uint64 = man | (cast(uint64, 1) << cast(uint64, 52))
	if unbiased > 127 {
		return (sign << cast(uint32, 31)) | (cast(uint32, 0xFF) << cast(uint32, 23))
	}
	if unbiased >= (cast(int, 0) - 126) {
		// Normal float32: round mant53 (leading 1 at bit 52) to 24 bits — drop
		// the low 29, round-to-even.
		var round uint64 = (mant53 >> cast(uint64, 28)) & cast(uint64, 1)
		var sticky uint64 = mant53 & ((cast(uint64, 1) << cast(uint64, 28)) - cast(uint64, 1))
		var m uint32 = cast(uint32, mant53 >> cast(uint64, 29))
		if round == cast(uint64, 1) {
			if sticky != cast(uint64, 0) || (m & cast(uint32, 1)) == cast(uint32, 1) {
				m = m + cast(uint32, 1)
			}
		}
		if m >= (cast(uint32, 1) << cast(uint32, 24)) {
			m = m >> cast(uint32, 1)
			unbiased = unbiased + 1
			if unbiased > 127 {
				return (sign << cast(uint32, 31)) | (cast(uint32, 0xFF) << cast(uint32, 23))
			}
		}
		var frac uint32 = m & cast(uint32, 0x7FFFFF)
		var bexp uint32 = cast(uint32, unbiased + 127)
		return (sign << cast(uint32, 31)) | (bexp << cast(uint32, 23)) | frac
	}
	// Denormal float32 (value < 2^-126): shift right past the implicit bit.
	var shift int = 29 + ((cast(int, 0) - 126) - unbiased)
	if shift >= 64 {
		return sign << cast(uint32, 31)
	}
	var su uint64 = cast(uint64, shift)
	var dround uint64 = (mant53 >> (su - cast(uint64, 1))) & cast(uint64, 1)
	var dsticky uint64 = mant53 & ((cast(uint64, 1) << (su - cast(uint64, 1))) - cast(uint64, 1))
	var dm uint32 = cast(uint32, mant53 >> su)
	if dround == cast(uint64, 1) {
		if dsticky != cast(uint64, 0) || (dm & cast(uint32, 1)) == cast(uint32, 1) {
			dm = dm + cast(uint32, 1)
		}
	}
	if dm >= (cast(uint32, 1) << cast(uint32, 23)) {
		// Rounded up into the smallest normal.
		return (sign << cast(uint32, 31)) | (cast(uint32, 1) << cast(uint32, 23)) |
				(dm & cast(uint32, 0x7FFFFF))
	}
	return (sign << cast(uint32, 31)) | dm
}

// ParseFloatLitToBits returns the IEEE 754 double bit pattern of the decimal
// or hex float literal `text` (which may carry a leading sign).  It is the
// codegen entry for OP_CONST_FLOAT; a float32-typed constant narrows the
// result through F64BitsToF32Bits at the emit site.
//
// strconv.ParseFloat's error is discarded: the literal reaching codegen is
// already lexically valid, and the only "error" cases — overflow and
// underflow — still return the correct bit pattern (±Inf and signed zero
// respectively), which is exactly what an out-of-range literal must compile
// to.
func ParseFloatLitToBits(text *[]readonly char) uint64 {
	f, _ := strconv.ParseFloat(text, 64)
	return bit_cast(uint64, f)
}
