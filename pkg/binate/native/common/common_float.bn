package "pkg/binate/native/common"

// Decimal float literal → IEEE 754 double-precision bit pattern.
//
// Shared by every native backend (aarch64, x64, future arches) AND the
// bytecode VM (pkg/binate/vm routes its OP_CONST_FLOAT through here), so a
// `float64 = <literal>` has ONE deterministic value across every execution
// mode.  Lives in common because it's a language-level mapping from source
// text to ABI-stable bits — what the IR says a float literal contains.
//
// The arithmetic is integer-only (no float types) so the result is identical
// across LLVM-built / VM-built / native-built bnc.  The value is computed in a
// 128-bit (hi:lo) mantissa window with a separately-tracked binary exponent:
// the decimal scaling factors 10 = 5 × 2, applying the ×2/÷2 as binary-exponent
// steps and the ×5/÷5 as 128-bit multiply/divide, then rounds the 53-bit
// significand to nearest-even (with a sticky bit carrying any precision dropped
// during the chunking).  This reproduces strconv.ParseFloat(.,64) exactly
// across the full f64 range (verified by an exhaustive differential).
//
// **Bootstrap-subset constraint**: this code is parsed and interpreted by the
// BUILDER bnc, so it stays integer-only (no floats, interfaces, or generics)
// and uses only 2-/3-value returns.

// uintBitLen returns the number of bits required to represent n
// (i.e., 1 + floor(log2(n)); 0 for n=0).
func uintBitLen(n uint64) int {
	var b int = 0
	for n > cast(uint64, 0) {
		b = b + 1
		n = n >> cast(uint64, 1)
	}
	return b
}

// topSetBit returns the position (0..127) of the highest set bit of the
// 128-bit value (hi:lo), or -1 if the value is zero.
func topSetBit(hi uint64, lo uint64) int {
	if hi != cast(uint64, 0) {
		return 64 + uintBitLen(hi) - 1
	}
	if lo != cast(uint64, 0) {
		return uintBitLen(lo) - 1
	}
	return -1
}

// shl128 shifts the 128-bit value (hi:lo) left by 1 bit.
func shl128(hi uint64, lo uint64) (uint64, uint64) {
	var newHi uint64 = (hi << cast(uint64, 1)) | (lo >> cast(uint64, 63))
	var newLo uint64 = lo << cast(uint64, 1)
	return newHi, newLo
}

// mul128bySmall returns m × (hi:lo) as (carry, newHi, newLo), where the full
// product is carry·2^128 + newHi·2^64 + newLo.  m must satisfy m·2^32 < 2^64
// (true for the small multipliers used here), so each 32-bit limb product
// fits in a uint64.  Standard base-2^32 schoolbook multiply by a scalar.
func mul128bySmall(hi uint64, lo uint64, m uint64) (uint64, uint64, uint64) {
	var MASK uint64 = cast(uint64, 0xFFFFFFFF)
	var l0 uint64 = lo & MASK
	var l1 uint64 = lo >> cast(uint64, 32)
	var l2 uint64 = hi & MASK
	var l3 uint64 = hi >> cast(uint64, 32)
	var p0 uint64 = m * l0
	var p1 uint64 = m * l1 + (p0 >> cast(uint64, 32))
	var p2 uint64 = m * l2 + (p1 >> cast(uint64, 32))
	var p3 uint64 = m * l3 + (p2 >> cast(uint64, 32))
	var newLo uint64 = (p0 & MASK) | ((p1 & MASK) << cast(uint64, 32))
	var newHi uint64 = (p2 & MASK) | ((p3 & MASK) << cast(uint64, 32))
	var carry uint64 = p3 >> cast(uint64, 32)
	return carry, newHi, newLo
}

// div128by5 divides the 128-bit value (hi:lo) by 5, returning the 128-bit
// quotient and the remainder (0..4).  MSB-first long division, one
// compare-subtract per bit.
func div128by5(hi uint64, lo uint64) (uint64, uint64, uint64) {
	var qhi uint64 = cast(uint64, 0)
	var qlo uint64 = cast(uint64, 0)
	var rem uint64 = cast(uint64, 0)
	var one uint64 = cast(uint64, 1)
	var five uint64 = cast(uint64, 5)
	for i := 127; i >= 0; i = i - 1 {
		var bit uint64
		if i >= 64 {
			bit = (hi >> cast(uint64, i - 64)) & one
		} else {
			bit = (lo >> cast(uint64, i)) & one
		}
		rem = (rem << cast(uint64, 1)) | bit
		if rem >= five {
			rem = rem - five
			if i >= 64 {
				qhi = qhi | (one << cast(uint64, i - 64))
			} else {
				qlo = qlo | (one << cast(uint64, i))
			}
		}
	}
	return qhi, qlo, rem
}

// packRounded builds the IEEE 754 double bit pattern for (hi:lo) × 2^binExp,
// rounding the 53-bit significand to nearest, ties to even.  stickyIn carries
// any nonzero bits already dropped below the (hi:lo) window during chunking,
// so the round/sticky decision accounts for the full value.  Handles normal,
// denormal, underflow-to-zero, and overflow-to-+Inf.
func packRounded(hi uint64, lo uint64, binExp int, stickyIn bool) uint64 {
	var topBit int = topSetBit(hi, lo)
	if topBit < 0 {
		return cast(uint64, 0)
	}
	var unbiasedExp int = topBit + binExp
	if unbiasedExp > 1023 {
		return cast(uint64, 0x7FF0000000000000)
	}
	// Normal keeps 53 significand bits; in the denormal range fewer bits fit
	// (the leading bit moves into the fraction field).
	var keep int = 53
	if unbiasedExp < (cast(int, 0) - 1022) {
		keep = 53 - ((cast(int, 0) - 1022) - unbiasedExp)
		if keep < 0 {
			return cast(uint64, 0)
		}
	}
	var drop int = topBit + 1 - keep
	var mant uint64 = cast(uint64, 0)
	var roundBit uint64 = cast(uint64, 0)
	var sticky bool = stickyIn
	if drop <= 0 {
		// Fewer than `keep` bits — value lives entirely in lo; left-align it.
		mant = lo << cast(uint64, 0 - drop)
	} else {
		var rbPos int = drop - 1
		if rbPos >= 64 {
			roundBit = (hi >> cast(uint64, rbPos - 64)) & cast(uint64, 1)
		} else {
			roundBit = (lo >> cast(uint64, rbPos)) & cast(uint64, 1)
		}
		// sticky = any set bit strictly below the round bit.
		if rbPos >= 64 {
			if lo != cast(uint64, 0) {
				sticky = true
			}
			if rbPos > 64 {
				var hiMask uint64 = (cast(uint64, 1) << cast(uint64, rbPos - 64)) - cast(uint64, 1)
				if (hi & hiMask) != cast(uint64, 0) {
					sticky = true
				}
			}
		} else if rbPos > 0 {
			var lowMask uint64 = (cast(uint64, 1) << cast(uint64, rbPos)) - cast(uint64, 1)
			if (lo & lowMask) != cast(uint64, 0) {
				sticky = true
			}
		}
		// mant = value >> drop.
		if drop >= 64 {
			var ds int = drop - 64
			if ds >= 64 {
				mant = cast(uint64, 0)
			} else {
				mant = hi >> cast(uint64, ds)
			}
		} else {
			mant = (hi << cast(uint64, 64 - drop)) | (lo >> cast(uint64, drop))
		}
	}
	if roundBit == cast(uint64, 1) {
		if sticky || (mant & cast(uint64, 1)) == cast(uint64, 1) {
			mant = mant + cast(uint64, 1)
		}
	}
	if unbiasedExp >= (cast(int, 0) - 1022) {
		// Normal: mant ∈ [2^52, 2^53); a round-up carry to 2^53 bumps the exp.
		if mant >= (cast(uint64, 1) << cast(uint64, 53)) {
			mant = mant >> cast(uint64, 1)
			unbiasedExp = unbiasedExp + 1
			if unbiasedExp > 1023 {
				return cast(uint64, 0x7FF0000000000000)
			}
		}
		var fracMask uint64 = (cast(uint64, 1) << cast(uint64, 52)) - cast(uint64, 1)
		var frac uint64 = mant & fracMask
		var bexp uint64 = cast(uint64, unbiasedExp + 1023)
		return (bexp << cast(uint64, 52)) | frac
	}
	// Denormal: mant is the fraction directly (no implicit leading 1).  A
	// round-up that reached 2^52 becomes the smallest normal.
	if mant >= (cast(uint64, 1) << cast(uint64, 52)) {
		return cast(uint64, 1) << cast(uint64, 52)
	}
	return mant
}

// parseLargePosExpToBits converts mantInt × 10^n (n >= 0) to double bits.
// 10^n = 5^n × 2^n: the 2^n folds into the binary exponent and the 5^n is
// applied as n successive ×5 steps on the 128-bit mantissa.  Whenever a ×5
// overflows past bit 127 the window is shifted right (the shift goes into
// binExp, the dropped low bits into sticky), so ~128 bits of precision are
// maintained throughout — far more than the 53 the result needs.
func parseLargePosExpToBits(mantInt uint64, n int) uint64 {
	var hi uint64 = cast(uint64, 0)
	var lo uint64 = mantInt
	var binExp int = n
	var sticky bool = false
	var carry uint64
	for i := 0; i < n; i = i + 1 {
		carry, hi, lo = mul128bySmall(hi, lo, cast(uint64, 5))
		if carry != cast(uint64, 0) {
			var s int = uintBitLen(carry)
			var su uint64 = cast(uint64, s)
			var mask uint64 = (cast(uint64, 1) << su) - cast(uint64, 1)
			if (lo & mask) != cast(uint64, 0) {
				sticky = true
			}
			lo = (lo >> su) | (hi << (cast(uint64, 64) - su))
			hi = (hi >> su) | (carry << (cast(uint64, 64) - su))
			binExp = binExp + s
		}
	}
	return packRounded(hi, lo, binExp, sticky)
}

// parseLargeNegExpToBits converts mantInt / 10^n (n > 0) to double bits.
// 10^-n = 5^-n × 2^-n: the 2^-n folds into the binary exponent and the 5^-n is
// applied as n successive ÷5 steps.  Before each ÷5 the 128-bit mantissa is
// left-normalized (top bit set, the shifts going into binExp) so each divide
// keeps full precision; a nonzero ÷5 remainder feeds the sticky bit.
func parseLargeNegExpToBits(mantInt uint64, n int) uint64 {
	var hi uint64 = cast(uint64, 0)
	var lo uint64 = mantInt
	var binExp int = 0 - n
	var sticky bool = false
	for i := 0; i < n; i = i + 1 {
		for (hi >> cast(uint64, 63)) == cast(uint64, 0) {
			hi, lo = shl128(hi, lo)
			binExp = binExp - 1
			if hi == cast(uint64, 0) && lo == cast(uint64, 0) {
				return cast(uint64, 0)
			}
		}
		var rem uint64
		hi, lo, rem = div128by5(hi, lo)
		if rem != cast(uint64, 0) {
			sticky = true
		}
	}
	return packRounded(hi, lo, binExp, sticky)
}

// ParseFloatLitToBits converts a decimal float literal text to its IEEE 754
// double bit pattern.  Accepts the lexer-produced forms, with an optional
// leading sign:
//
//   [+-]?<digits>
//   [+-]?<digits>.<digits>
//   [+-]?.<digits>
//   [+-]?<mantissa>[eE][+-]?<digits>
//
// A leading '-' is handled here (it sets the result's sign bit): a negative
// float literal that was const-folded carries the sign in the stored text
// rather than via an OP_NEG, so the converter must honor it (see
// conformance/541_cross_pkg_const_float).  The integer significand digits are
// accumulated into a uint64 mantInt; the net decimal exponent (explicit
// exponent minus fraction-digit count) then drives the positive/negative
// scaling path.  Reproduces strconv.ParseFloat(.,64) across the full range.
func ParseFloatLitToBits(text *[]readonly char) uint64 {
	var n int = len(text)
	if n == 0 {
		return cast(uint64, 0)
	}
	var neg bool = false
	var i int = 0
	if text[i] == '-' {
		neg = true
		i = i + 1
	} else if text[i] == '+' {
		i = i + 1
	}
	var mantInt uint64 = cast(uint64, 0)
	for i < n && text[i] >= '0' && text[i] <= '9' {
		mantInt = mantInt * cast(uint64, 10) +
			cast(uint64, cast(int, text[i]) - cast(int, '0'))
		i = i + 1
	}
	var fracDigits int = 0
	if i < n && text[i] == '.' {
		i = i + 1
		for i < n && text[i] >= '0' && text[i] <= '9' {
			mantInt = mantInt * cast(uint64, 10) +
				cast(uint64, cast(int, text[i]) - cast(int, '0'))
			fracDigits = fracDigits + 1
			i = i + 1
		}
	}
	var expSign int = 1
	var expVal int = 0
	if i < n && (text[i] == 'e' || text[i] == 'E') {
		i = i + 1
		if i < n && text[i] == '-' {
			expSign = -1
			i = i + 1
		} else if i < n && text[i] == '+' {
			i = i + 1
		}
		for i < n && text[i] >= '0' && text[i] <= '9' {
			expVal = expVal * 10 + (cast(int, text[i]) - cast(int, '0'))
			i = i + 1
		}
	}
	if expSign < 0 {
		expVal = -expVal
	}
	var signBit uint64 = cast(uint64, 0)
	if neg {
		signBit = cast(uint64, 1) << cast(uint64, 63)
	}
	if mantInt == cast(uint64, 0) {
		// (Signed) zero.
		return signBit
	}
	// value = mantInt × 10^(expVal - fracDigits); the sign bit is OR'd onto
	// the magnitude (IEEE 754 is sign-magnitude, so this also yields -Inf on
	// overflow and -0.0 on underflow of a negative literal).
	var netExp int = expVal - fracDigits
	var magnitude uint64
	if netExp >= 0 {
		magnitude = parseLargePosExpToBits(mantInt, netExp)
	} else {
		magnitude = parseLargeNegExpToBits(mantInt, 0 - netExp)
	}
	return magnitude | signBit
}
