package "pkg/binate/native/common"

// Decimal float literal → IEEE 754 double-precision bit pattern.
//
// Shared by every native backend (aarch64 originally, x64 added at the
// same shape, future arches the same).  Lives in common because it's a
// language-level mapping from source text to ABI-stable bits — what
// the IR says a `float64 = 3.14` literal contains.  The arithmetic is
// integer-only (no float types used in this file) so the result is
// deterministic across compilation modes (LLVM-built bnc / VM-built
// bnc / native-built bnc all see the same bits for the same text).
//
// **Bootstrap-subset constraint**: this code is parsed and interpreted
// by the BUILDER bnc, which used to lex no float literals at all (the
// retired Go interp's limitation).  The integer-only style outlives
// that constraint because it's still the deterministic-across-impls
// way to do the conversion.

// uintBitLen returns the number of bits required to represent n
// (i.e., 1 + floor(log2(n)); 0 for n=0).
func uintBitLen(n uint64) int {
	var b int = 0
	for n > 0 {
		b = b + 1
		n = n >> 1
	}
	return b
}

// uintToDoubleBits converts a non-negative uint64 to the bit pattern
// of its IEEE 754 double-precision representation.  Loses precision
// for k > 2^53; sufficient for the literal mantissas our tests use.
func uintToDoubleBits(k uint64) uint64 {
	if k == 0 { return cast(uint64, 0) }
	var bl int = uintBitLen(k)
	var e int = bl - 1
	var mantissa uint64
	if e <= 52 {
		mantissa = k << cast(uint64, 52 - e)
	} else {
		var shift int = e - 52
		var half uint64 = cast(uint64, 1) << cast(uint64, shift - 1)
		mantissa = (k + half) >> cast(uint64, shift)
		var limit uint64 = cast(uint64, 1) << 53
		if mantissa >= limit {
			mantissa = mantissa >> 1
			e = e + 1
		}
	}
	var fracMask uint64 = (cast(uint64, 1) << 52) - 1
	var frac uint64 = mantissa & fracMask
	var bexp uint64 = cast(uint64, e + 1023)
	return (bexp << 52) | frac
}

// divToDoubleBits converts n/d (d > 0, both non-negative) to the bit
// pattern of an IEEE 754 double.  Same precision caveat as above.
func divToDoubleBits(n uint64, d uint64) uint64 {
	if n == 0 { return cast(uint64, 0) }
	var bitsN int = uintBitLen(n)
	var bitsD int = uintBitLen(d)
	// We want (n << k) / d in [2^52, 2^53). The exponent of the
	// quotient is bitsN + k - bitsD - 1 (approximately).
	// Set k so bitsN + k - bitsD = 53 → k = 53 - bitsN + bitsD.
	var k int = 53 - bitsN + bitsD
	var nshift uint64
	if k >= 0 {
		nshift = n << cast(uint64, k)
	} else {
		nshift = n >> cast(uint64, -k)
	}
	var mantissa uint64 = nshift / d
	var rem uint64 = nshift - mantissa * d
	// Round half-to-even (simplified to half-up — sufficient for the
	// literals our tests probe).
	if 2 * rem >= d {
		mantissa = mantissa + 1
	}
	// Normalize: mantissa should land in [2^52, 2^53). If it
	// overflowed up to 2^53 (rounding), shift back; if our k
	// estimate was off by one, adjust either way.
	var hi uint64 = cast(uint64, 1) << 53
	var lo uint64 = cast(uint64, 1) << 52
	for mantissa >= hi {
		mantissa = mantissa >> 1
		k = k - 1
	}
	for mantissa < lo && mantissa > 0 {
		mantissa = mantissa << 1
		k = k + 1
	}
	// value = mantissa * 2^(-k); since mantissa = m * 2^52 (with
	// m ∈ [1, 2)), value = m * 2^(52 - k). Biased exponent = 52 - k + 1023.
	var bexp int = 52 - k + 1023
	var fracMask uint64 = (cast(uint64, 1) << 52) - 1
	var frac uint64 = mantissa & fracMask
	return (cast(uint64, bexp) << 52) | frac
}

// pow10 returns 10^n as uint64 for n in [0, ~19].  Above that, the
// caller should chain divisions; tests don't probe that range.
func pow10(n int) uint64 {
	var r uint64 = 1
	for i := 0; i < n; i++ {
		r = r * 10
	}
	return r
}

// shl128 shifts a 128-bit value (hi:lo) left by 1 bit.  The high bit
// of `lo` becomes the low bit of `hi`; the low bit of `lo` is filled
// with 0.  Used by `parseLargeNegExpToBits` to normalize 128-bit
// mantissas before each /5 divide step.
func shl128(hi uint64, lo uint64) (uint64, uint64) {
	var newHi uint64 = (hi << cast(uint64, 1)) |
		(lo >> cast(uint64, 63))
	var newLo uint64 = lo << cast(uint64, 1)
	return newHi, newLo
}

// div128by5 divides a 128-bit value (hi:lo) by 5.  Standard long
// division, MSB first, one compare-subtract per bit (128 iterations
// per call).  Used by `parseLargeNegExpToBits` to accumulate
// successive /10 = /5 × /2 steps without precision collapse — the
// /2 part is folded into a separate binary-exponent counter, so each
// step here is just /5.
func div128by5(hi uint64, lo uint64) (uint64, uint64) {
	var qhi uint64 = cast(uint64, 0)
	var qlo uint64 = cast(uint64, 0)
	var rem uint64 = cast(uint64, 0)
	var one uint64 = cast(uint64, 1)
	var five uint64 = cast(uint64, 5)
	for i := 127; i >= 0; i = i - 1 {
		var bit uint64
		if i >= 64 {
			bit = (hi >> cast(uint64, i - 64)) & one
		} else {
			bit = (lo >> cast(uint64, i)) & one
		}
		rem = (rem << cast(uint64, 1)) | bit
		if rem >= five {
			rem = rem - five
			if i >= 64 {
				qhi = qhi | (one << cast(uint64, i - 64))
			} else {
				qlo = qlo | (one << cast(uint64, i))
			}
		}
	}
	return qhi, qlo
}

// topSetBit returns the position (0..127) of the highest set bit of
// the 128-bit value (hi:lo), or -1 if the value is zero.
func topSetBit(hi uint64, lo uint64) int {
	if hi != cast(uint64, 0) {
		return 64 + uintBitLen(hi) - 1
	}
	if lo != cast(uint64, 0) {
		return uintBitLen(lo) - 1
	}
	return -1
}

// extract53 returns the 53 most-significant bits of the 128-bit
// value (hi:lo), assuming topSetBit(hi,lo) == topBit.  The result
// is right-aligned in a uint64 (low 53 bits hold the value, top 11
// bits are zero).
func extract53(hi uint64, lo uint64, topBit int) uint64 {
	if topBit < 52 {
		// All bits fit in lo; shift left to put MSB at position 52.
		return lo << cast(uint64, 52 - topBit)
	}
	// Otherwise shift right.  shiftRight bits drop off the bottom.
	var shiftRight int = topBit - 52
	if shiftRight >= 64 {
		// Result is entirely from hi.
		return hi >> cast(uint64, shiftRight - 64)
	}
	if shiftRight == 0 {
		return lo
	}
	return (hi << cast(uint64, 64 - shiftRight)) |
		(lo >> cast(uint64, shiftRight))
}

// bitsFrom128 builds the IEEE 754 double-precision bit pattern for
// the value (hi:lo) × 2^binExp.  Handles normal / denormal /
// underflow.  Used by parseLargeNegExpToBits as the final
// "normalize + pack" step after the /5 chunking is done.
func bitsFrom128(hi uint64, lo uint64, binExp int) uint64 {
	var topBit int = topSetBit(hi, lo)
	if topBit < 0 { return cast(uint64, 0) }
	var unbiasedExp int = topBit + binExp
	// Underflow well below smallest denormal (2^-1074).
	if unbiasedExp < -1075 {
		return cast(uint64, 0)
	}
	var mant53 uint64 = extract53(hi, lo, topBit)
	// Denormal range: 2^-1074 ≤ value < 2^-1022.  Biased exp = 0;
	// the leading 1 of mant53 shifts INTO the fraction field, with
	// trailing bits dropped.
	if unbiasedExp < -1022 {
		var shift int = -1022 - unbiasedExp
		if shift > 52 {
			return cast(uint64, 0)
		}
		// mant53 has leading 1 at bit 52.  Shift right by `shift`
		// to land in denormal mantissa positions.
		return mant53 >> cast(uint64, shift)
	}
	// Overflow to +Inf at biased exp ≥ 2047 (unbiasedExp ≥ 1024).
	if unbiasedExp > 1023 {
		return cast(uint64, 0x7FF0000000000000)
	}
	var fracMask uint64 =
		(cast(uint64, 1) << cast(uint64, 52)) - cast(uint64, 1)
	var frac uint64 = mant53 & fracMask
	var bexp uint64 = cast(uint64, unbiasedExp + 1023)
	return (bexp << cast(uint64, 52)) | frac
}

// parseLargeNegExpToBits handles ParseFloatLitToBits' negative-netExp
// case when -netExp > 19 (where pow10(-netExp) would overflow
// uint64).  Algorithm: maintain mantInt as a 128-bit mantissa with
// a separately-tracked binary exponent; for each of the `n =
// -netExp` decimal-place shifts, factor 10 = 5 × 2 — apply the ×2
// part as a binary-exponent decrement and the /5 part as a 128-bit
// divide.  Before each /5 step, shift the 128-bit mantissa left so
// its top bit is set (no precision loss, just rebalancing — the
// shift count goes into binExp).
//
// 128 bits of mantissa precision gives O(2^-128) relative error
// per step; after 330 steps (the deepest test case), accumulated
// error stays well below 2^-53 (one IEEE 754 double-precision
// mantissa ulp).
func parseLargeNegExpToBits(mantInt uint64, n int) uint64 {
	var hi uint64 = cast(uint64, 0)
	var lo uint64 = mantInt
	var binExp int = -n  // 10^-n = 5^-n × 2^-n; the 2^-n factor.
	for i := 0; i < n; i = i + 1 {
		// Normalize: shift left until top bit of hi is set.
		for (hi >> cast(uint64, 63)) == cast(uint64, 0) {
			hi, lo = shl128(hi, lo)
			binExp = binExp - 1
			if hi == cast(uint64, 0) && lo == cast(uint64, 0) {
				return cast(uint64, 0)
			}
		}
		hi, lo = div128by5(hi, lo)
	}
	return bitsFrom128(hi, lo, binExp)
}

// underflowsToZero reports whether `mantInt × 10^netExp` is smaller
// than the smallest IEEE 754 double-precision denormal (~4.94e-324
// = 2^-1074), in which case the IEEE-correct bit pattern is 0
// (under round-to-nearest).  Conservative bound:
//
//   log2(value) ≤ bitLen(mantInt) + netExp × log2(10)
//
// Using log2(10) ≈ 33/10 = 3.3 (under-approximates the true 3.3219;
// for negative netExp this OVER-approximates log2(value), so a
// triggered check is always safe — never reports underflow when
// the literal is actually in the denormal range).
//
//   bitLen × 10 + netExp × 33 < -10750  ⇒  log2(value) < -1075 ⇒ underflow
//
// Without this guard, pow10(-netExp) silently overflows uint64 for
// any -netExp > 19, producing garbage bit patterns for any literal
// below ~1e-19 magnitude.  This guard catches the underflow case;
// the moderately-small (denormal + just-above-denormal) range is
// still mishandled — see claude-todo.md MAJOR entry.
func underflowsToZero(mantInt uint64, netExp int) bool {
	if mantInt == 0 { return true }
	return uintBitLen(mantInt) * 10 + netExp * 33 < -10750
}

// ParseFloatLitToBits converts a decimal float literal text (no sign
// — the IR strips leading '-' into OP_NEG) to its IEEE 754 double
// bit pattern.  Accepts the lexer-produced forms:
//
//   <digits>
//   <digits>.<digits>
//   .<digits>
//   <mantissa>[eE][+-]?<digits>
func ParseFloatLitToBits(text *[]const char) uint64 {
	var n int = len(text)
	if n == 0 { return cast(uint64, 0) }

	var mantInt uint64 = 0
	var i int = 0
	for i < n && text[i] >= '0' && text[i] <= '9' {
		mantInt = mantInt * 10 +
			cast(uint64, cast(int, text[i]) - cast(int, '0'))
		i = i + 1
	}
	var fracDigits int = 0
	if i < n && text[i] == '.' {
		i = i + 1
		for i < n && text[i] >= '0' && text[i] <= '9' {
			mantInt = mantInt * 10 +
				cast(uint64, cast(int, text[i]) - cast(int, '0'))
			fracDigits = fracDigits + 1
			i = i + 1
		}
	}
	var expSign int = 1
	var expVal int = 0
	if i < n && (text[i] == 'e' || text[i] == 'E') {
		i = i + 1
		if i < n && text[i] == '-' {
			expSign = -1
			i = i + 1
		} else if i < n && text[i] == '+' {
			i = i + 1
		}
		for i < n && text[i] >= '0' && text[i] <= '9' {
			expVal = expVal * 10 +
				(cast(int, text[i]) - cast(int, '0'))
			i = i + 1
		}
	}
	if expSign < 0 { expVal = -expVal }
	// Net decimal shift: value = mantInt * 10^(expVal - fracDigits).
	var netExp int = expVal - fracDigits
	if underflowsToZero(mantInt, netExp) {
		return cast(uint64, 0)
	}
	if netExp >= 0 {
		// Integer value: mantInt * 10^netExp.
		var k uint64 = mantInt
		for j := 0; j < netExp; j++ {
			k = k * 10
		}
		return uintToDoubleBits(k)
	}
	// Fractional: mantInt / 10^(-netExp).
	// For -netExp ≤ 19, pow10 fits in uint64 and divToDoubleBits
	// handles the divide directly.  Above that, route through the
	// 128-bit chunked path to avoid pow10's overflow.
	if -netExp > 19 {
		return parseLargeNegExpToBits(mantInt, -netExp)
	}
	var d uint64 = pow10(-netExp)
	return divToDoubleBits(mantInt, d)
}
