package "pkg/binate/native/common"

import "pkg/builtins/testing"

// Tests for ParseFloatLitToBits — the integer-only IEEE 754 builder
// shared by every native backend.  Expected bit patterns are
// hard-coded IEEE 754 doubles cross-checked against `printf "%a"`
// and Go's strconv.

func TestParseFloatZero() testing.TestResult {
	var bits uint64 = ParseFloatLitToBits("0")
	if bits != cast(uint64, 0) { return "0 should be all-zero bits" }
	return ""
}

func TestParseFloatOne() testing.TestResult {
	// 1.0 = sign=0, exp=1023, frac=0 → 0x3FF0000000000000
	var bits uint64 = ParseFloatLitToBits("1")
	var expected uint64 = (cast(uint64, 0x3FF) << 52)
	if bits != expected { return "1 should be 0x3FF0000000000000" }
	return ""
}

func TestParseFloatThree() testing.TestResult {
	// 3.0 = 1.5 * 2^1 → biased exp 1024, frac 0x8000000000000
	// = 0x4008000000000000
	var bits uint64 = ParseFloatLitToBits("3")
	var expected uint64 = (cast(uint64, 0x4008) << 48)
	if bits != expected { return "3 should be 0x4008000000000000" }
	return ""
}

func TestParseFloatOnePointFive() testing.TestResult {
	// 1.5 = 1.5 * 2^0 → biased exp 1023, frac 0x8000000000000
	// = 0x3FF8000000000000
	var bits uint64 = ParseFloatLitToBits("1.5")
	var expected uint64 = (cast(uint64, 0x3FF8) << 48)
	if bits != expected { return "1.5 should be 0x3FF8000000000000" }
	return ""
}

func TestParseFloatThreePointSevenFive() testing.TestResult {
	// 3.75 = 1.875 * 2^1 → biased 1024, frac (0.875 * 2^52) = 0xE0...0
	// = 0x400E000000000000  (used by test 279)
	var bits uint64 = ParseFloatLitToBits("3.75")
	var expected uint64 = (cast(uint64, 0x400E) << 48)
	if bits != expected { return "3.75 should be 0x400E000000000000" }
	return ""
}

func TestParseFloatQuarter() testing.TestResult {
	// 0.25 = 1.0 * 2^-2 → biased 1021, frac 0
	// = 0x3FD0000000000000
	var bits uint64 = ParseFloatLitToBits("0.25")
	var expected uint64 = (cast(uint64, 0x3FD) << 52)
	if bits != expected { return "0.25 should be 0x3FD0000000000000" }
	return ""
}

func TestParseFloatExponent() testing.TestResult {
	// 1e3 = 1000 = 1.953125 * 2^9 → biased 1032, frac 0xF400000000000
	// = 0x408F400000000000  (used by tests 283 / 287)
	var bits uint64 = ParseFloatLitToBits("1e3")
	var expected uint64 = (cast(uint64, 0x408F4) << 44)
	if bits != expected { return "1e3 should be 0x408F400000000000" }
	return ""
}

func TestParseFloatLeadingDot() testing.TestResult {
	// .5 = 1.0 * 2^-1 → 0x3FE0000000000000
	var bits uint64 = ParseFloatLitToBits(".5")
	var expected uint64 = (cast(uint64, 0x3FE) << 52)
	if bits != expected { return ".5 should be 0x3FE0000000000000" }
	return ""
}

// 3.14 — the rounded value used in conformance test 330.
// IEEE 754 closest representation: 0x40091EB851EB851F.
func TestParseFloatPi() testing.TestResult {
	var bits uint64 = ParseFloatLitToBits("3.14")
	var expected uint64 = cast(uint64, 0x40091EB851EB851F)
	if bits != expected { return "3.14 should be 0x40091EB851EB851F" }
	return ""
}

// TestParseFloatTinyUnderflows: 1.0e-330 is below the smallest IEEE
// 754 double denormal (~4.94e-324) — clang even warns "magnitude
// too small for type" on this exact literal and emits 0.  Pins
// `underflowsToZero`'s gate at the 2^-1075 boundary.
func TestParseFloatTinyUnderflows() testing.TestResult {
	var bits uint64 = ParseFloatLitToBits("1.0e-330")
	if bits != cast(uint64, 0) {
		return "1.0e-330 should underflow to 0"
	}
	return ""
}

// TestParseFloatLargeNegExp pins the 128-bit chunked path for
// |netExp| > 19.  The result might be off by a few ulp from the
// IEEE-rounded-to-nearest value due to truncating /5 divides
// (parseLargeNegExpToBits uses truncate-not-round at each step),
// but must land in the right binary order of magnitude — the test
// asserts the IEEE biased exponent matches what libc / clang
// produce for the same literal, allowing ±1 of slack.
//   1.0e-30:  log2 ≈ -99.66 → unbiased exp -100 → biased 923.
//   1.0e-300: log2 ≈ -996.58 → unbiased exp -997 → biased 26.
func TestParseFloatLargeNegExp() testing.TestResult {
	var bits uint64 = ParseFloatLitToBits("1.0e-30")
	var bexp uint64 = (bits >> cast(uint64, 52)) & cast(uint64, 0x7FF)
	if bexp < cast(uint64, 922) || bexp > cast(uint64, 924) {
		return "1.0e-30 biased exp should be ~923 (±1)"
	}
	bits = ParseFloatLitToBits("1.0e-300")
	bexp = (bits >> cast(uint64, 52)) & cast(uint64, 0x7FF)
	if bexp < cast(uint64, 25) || bexp > cast(uint64, 27) {
		return "1.0e-300 biased exp should be ~26 (±1)"
	}
	return ""
}
