package "pkg/binate/native/common"

import "pkg/builtins/testing"

// Tests for ParseFloatLitToBits — the integer-only IEEE 754 builder
// shared by every native backend.  Expected bit patterns are
// hard-coded IEEE 754 doubles cross-checked against `printf "%a"`
// and Go's strconv.

func TestParseFloatZero() testing.TestResult {
	var bits uint64 = ParseFloatLitToBits("0")
	if bits != cast(uint64, 0) { return "0 should be all-zero bits" }
	return ""
}

func TestParseFloatOne() testing.TestResult {
	// 1.0 = sign=0, exp=1023, frac=0 → 0x3FF0000000000000
	var bits uint64 = ParseFloatLitToBits("1")
	var expected uint64 = (cast(uint64, 0x3FF) << 52)
	if bits != expected { return "1 should be 0x3FF0000000000000" }
	return ""
}

func TestParseFloatThree() testing.TestResult {
	// 3.0 = 1.5 * 2^1 → biased exp 1024, frac 0x8000000000000
	// = 0x4008000000000000
	var bits uint64 = ParseFloatLitToBits("3")
	var expected uint64 = (cast(uint64, 0x4008) << 48)
	if bits != expected { return "3 should be 0x4008000000000000" }
	return ""
}

func TestParseFloatOnePointFive() testing.TestResult {
	// 1.5 = 1.5 * 2^0 → biased exp 1023, frac 0x8000000000000
	// = 0x3FF8000000000000
	var bits uint64 = ParseFloatLitToBits("1.5")
	var expected uint64 = (cast(uint64, 0x3FF8) << 48)
	if bits != expected { return "1.5 should be 0x3FF8000000000000" }
	return ""
}

func TestParseFloatThreePointSevenFive() testing.TestResult {
	// 3.75 = 1.875 * 2^1 → biased 1024, frac (0.875 * 2^52) = 0xE0...0
	// = 0x400E000000000000  (used by test 279)
	var bits uint64 = ParseFloatLitToBits("3.75")
	var expected uint64 = (cast(uint64, 0x400E) << 48)
	if bits != expected { return "3.75 should be 0x400E000000000000" }
	return ""
}

func TestParseFloatQuarter() testing.TestResult {
	// 0.25 = 1.0 * 2^-2 → biased 1021, frac 0
	// = 0x3FD0000000000000
	var bits uint64 = ParseFloatLitToBits("0.25")
	var expected uint64 = (cast(uint64, 0x3FD) << 52)
	if bits != expected { return "0.25 should be 0x3FD0000000000000" }
	return ""
}

func TestParseFloatExponent() testing.TestResult {
	// 1e3 = 1000 = 1.953125 * 2^9 → biased 1032, frac 0xF400000000000
	// = 0x408F400000000000  (used by tests 283 / 287)
	var bits uint64 = ParseFloatLitToBits("1e3")
	var expected uint64 = (cast(uint64, 0x408F4) << 44)
	if bits != expected { return "1e3 should be 0x408F400000000000" }
	return ""
}

func TestParseFloatLeadingDot() testing.TestResult {
	// .5 = 1.0 * 2^-1 → 0x3FE0000000000000
	var bits uint64 = ParseFloatLitToBits(".5")
	var expected uint64 = (cast(uint64, 0x3FE) << 52)
	if bits != expected { return ".5 should be 0x3FE0000000000000" }
	return ""
}

// 3.14 — the rounded value used in conformance test 330.
// IEEE 754 closest representation: 0x40091EB851EB851F.
func TestParseFloatPi() testing.TestResult {
	var bits uint64 = ParseFloatLitToBits("3.14")
	var expected uint64 = cast(uint64, 0x40091EB851EB851F)
	if bits != expected { return "3.14 should be 0x40091EB851EB851F" }
	return ""
}

// TestParseFloatTinyUnderflows: 1.0e-330 is below the smallest IEEE
// 754 double denormal (~4.94e-324) — clang even warns "magnitude too
// small for type" on this exact literal and emits 0.  Pins the
// underflow-to-zero handling in packRounded.
func TestParseFloatTinyUnderflows() testing.TestResult {
	var bits uint64 = ParseFloatLitToBits("1.0e-330")
	if bits != cast(uint64, 0) {
		return "1.0e-330 should underflow to 0"
	}
	return ""
}

// TestParseFloatLargeNegExp pins the negative-exponent 128-bit chunked path
// with EXACT round-to-nearest bit patterns (cross-checked against Go's
// strconv.ParseFloat), down through the denormal range to the smallest
// subnormal.
func TestParseFloatLargeNegExp() testing.TestResult {
	if ParseFloatLitToBits("1e-30") != cast(uint64, 4158027847206421152) { return "1e-30 bits" }
	if ParseFloatLitToBits("1e-300") != cast(uint64, 118622047889322841) { return "1e-300 bits" }
	if ParseFloatLitToBits("1e-308") != cast(uint64, 2024022533073106) { return "1e-308 bits" }
	// 2.2250738585072014e-308 = smallest normal double.
	if ParseFloatLitToBits("2.2250738585072014e-308") != cast(uint64, 4503599627370496) {
		return "smallest normal bits"
	}
	// 5e-324 / 1e-323 = the two smallest denormals.
	if ParseFloatLitToBits("5e-324") != cast(uint64, 1) { return "smallest subnormal bits" }
	if ParseFloatLitToBits("1e-323") != cast(uint64, 2) { return "1e-323 bits" }
	return ""
}

// TestParseFloatLargePosExp pins the positive-exponent 128-bit ×5 path with
// EXACT round-to-nearest bit patterns (cross-checked against Go's
// strconv.ParseFloat), up through MaxFloat64.  Before the fix, the netExp>=0
// path multiplied in uint64 and overflowed for any |value| >= 1e20, silently
// miscompiling these literals on every native backend.
func TestParseFloatLargePosExp() testing.TestResult {
	if ParseFloatLitToBits("1e20") != cast(uint64, 4906019910204099648) { return "1e20 bits" }
	if ParseFloatLitToBits("1e22") != cast(uint64, 4936209963552724370) { return "1e22 bits" }
	if ParseFloatLitToBits("1e23") != cast(uint64, 4950912855330343670) { return "1e23 bits" }
	if ParseFloatLitToBits("1e38") != cast(uint64, 5175426328141668785) { return "1e38 bits" }
	if ParseFloatLitToBits("1e100") != cast(uint64, 6103021453049119613) { return "1e100 bits" }
	if ParseFloatLitToBits("1e308") != cast(uint64, 9214871658872686752) { return "1e308 bits" }
	// 1.7976931348623157e308 = MaxFloat64.
	if ParseFloatLitToBits("1.7976931348623157e308") != cast(uint64, 9218868437227405311) {
		return "MaxFloat64 bits"
	}
	// 2^53 + 1 (not representable; rounds to 2^53) and a mixed many-digit value.
	if ParseFloatLitToBits("9007199254740993") != cast(uint64, 4845873199050653696) {
		return "2^53+1 bits"
	}
	if ParseFloatLitToBits("123456789.123456789") != cast(uint64, 4728057454355442549) {
		return "mixed many-digit bits"
	}
	return ""
}

// TestParseFloatPosExpOverflow: above MaxFloat64 rounds to +Inf.
func TestParseFloatPosExpOverflow() testing.TestResult {
	if ParseFloatLitToBits("1e400") != cast(uint64, 0x7FF0000000000000) {
		return "1e400 should be +Inf"
	}
	return ""
}

// TestParseFloatSigned: a const-folded negative literal carries the sign in
// the text (no OP_NEG), so the converter must set the sign bit.
func TestParseFloatSigned() testing.TestResult {
	if ParseFloatLitToBits("-1.5") != cast(uint64, 0xBFF8000000000000) { return "-1.5 bits" }
	if ParseFloatLitToBits("-3.5") != cast(uint64, 0xC00C000000000000) { return "-3.5 bits" }
	if ParseFloatLitToBits("-1e100") != cast(uint64, 0xD4B249AD2594C37D) { return "-1e100 bits" }
	// -0 keeps the sign bit; '+' is accepted and is a no-op.
	if ParseFloatLitToBits("-0") != (cast(uint64, 1) << cast(uint64, 63)) { return "-0 bits" }
	if ParseFloatLitToBits("+2.5") != cast(uint64, 0x4004000000000000) { return "+2.5 bits" }
	// Sign combined with the leading-dot / trailing-dot lexer forms.
	if ParseFloatLitToBits("-.5") != cast(uint64, 0xBFE0000000000000) { return "-.5 bits" }
	if ParseFloatLitToBits("-.5e-3") != cast(uint64, 0xBF40624DD2F1A9FC) { return "-.5e-3 bits" }
	if ParseFloatLitToBits("-1.e3") != cast(uint64, 0xC08F400000000000) { return "-1.e3 bits" }
	return ""
}

// TestParseFloatRoundEdges: packRounded branches the other tests don't hit —
// a round-up carry that overflows to +Inf, one ULP below MaxFloat64, and the
// two smallest-denormal ties (keep==0 boundary).
func TestParseFloatRoundEdges() testing.TestResult {
	// Rounds up past MaxFloat64 -> +Inf (distinct from the exp>1023 early return).
	if ParseFloatLitToBits("1.7976931348623159e308") != cast(uint64, 0x7FF0000000000000) {
		return "round-up-to-Inf"
	}
	// One ULP under MaxFloat64.
	if ParseFloatLitToBits("1.7976931348623155e308") != cast(uint64, 0x7FEFFFFFFFFFFFFE) {
		return "MaxFloat64 - 1 ULP"
	}
	// Smallest-denormal ties: 7.5e-324 rounds to 2, 2.5e-324 rounds to 1.
	if ParseFloatLitToBits("7.5e-324") != cast(uint64, 2) { return "7.5e-324 -> 2" }
	if ParseFloatLitToBits("2.5e-324") != cast(uint64, 1) { return "2.5e-324 -> 1" }
	return ""
}

// TestParseFloatManyDigits: a significand of more than ~19 significant digits
// must NOT overflow (it is accumulated into the 128-bit window, not a uint64).
func TestParseFloatManyDigits() testing.TestResult {
	if ParseFloatLitToBits("3.141592653589793238462643383279") != cast(uint64, 0x400921FB54442D18) {
		return "pi 31-digit bits"
	}
	if ParseFloatLitToBits("3.1415926535897932384") != cast(uint64, 0x400921FB54442D18) {
		return "pi 20-digit bits"
	}
	if ParseFloatLitToBits("12345678901234567890.5") != cast(uint64, 0x43E56A95319D63E1) {
		return "21-digit frac bits"
	}
	if ParseFloatLitToBits("99999999999999999999") != cast(uint64, 0x4415AF1D78B58C40) {
		return "20-nines bits"
	}
	if ParseFloatLitToBits("-3.141592653589793238462643383279") != cast(uint64, 0xC00921FB54442D18) {
		return "signed pi 31-digit bits"
	}
	return ""
}

// TestParseFloatWriteOutOverflow: a value >= 2^64 written out as a float
// literal.  2^64 itself wraps a uint64 accumulator to exactly 0 (would
// collapse to +0.0); it must instead read as 2^64.
func TestParseFloatWriteOutOverflow() testing.TestResult {
	if ParseFloatLitToBits("18446744073709551616.0") != cast(uint64, 0x43F0000000000000) {
		return "2^64 written-out bits"
	}
	if ParseFloatLitToBits("100000000000000000000") != cast(uint64, 0x4415AF1D78B58C40) {
		return "1e20 written-out bits"
	}
	return ""
}

// TestParseFloatHugeExponent: an exponent past the f64 range (and past `int`
// on a 32-bit target) saturates to +Inf / 0 rather than wrapping.
func TestParseFloatHugeExponent() testing.TestResult {
	if ParseFloatLitToBits("1e4294967296") != cast(uint64, 0x7FF0000000000000) {
		return "1e4294967296 +Inf"
	}
	if ParseFloatLitToBits("-1e4294967296") != cast(uint64, 0xFFF0000000000000) {
		return "-1e4294967296 -Inf"
	}
	if ParseFloatLitToBits("1e-4294967296") != cast(uint64, 0) { return "1e-4294967296 zero" }
	if ParseFloatLitToBits("9e999999999") != cast(uint64, 0x7FF0000000000000) {
		return "9e999999999 +Inf"
	}
	// 2^31 / past 2^31: an exponent crossing the int32 boundary must still
	// saturate (the accumulation cap keeps the multiply within a 32-bit int).
	if ParseFloatLitToBits("1e2147483648") != cast(uint64, 0x7FF0000000000000) {
		return "1e2147483648 +Inf"
	}
	if ParseFloatLitToBits("1e309") != cast(uint64, 0x7FF0000000000000) { return "1e309 +Inf" }
	if ParseFloatLitToBits("1e-325") != cast(uint64, 0) { return "1e-325 zero" }
	return ""
}

// TestParseFloatDotForms: lexer-produced leading-dot and trailing-dot forms.
func TestParseFloatDotForms() testing.TestResult {
	if ParseFloatLitToBits("1.e3") != cast(uint64, 0x408F400000000000) { return "1.e3 bits" }
	if ParseFloatLitToBits("1.") != cast(uint64, 0x3FF0000000000000) { return "1. bits" }
	if ParseFloatLitToBits(".5e3") != cast(uint64, 0x407F400000000000) { return ".5e3 bits" }
	if ParseFloatLitToBits(".25e1") != cast(uint64, 0x4004000000000000) { return ".25e1 bits" }
	// Fraction with many leading zeros (each lowers netExp but keeps the window
	// small until the significant digit arrives).
	if ParseFloatLitToBits("0.0000000000000000001") != cast(uint64, 0x3BFD83C94FB6D2AC) {
		return "0.0..01 bits"
	}
	return ""
}

// TestParseFloatDenormalBoundary: rounding across the largest-denormal /
// smallest-normal boundary (2^-1022) must land on the correct side.
func TestParseFloatDenormalBoundary() testing.TestResult {
	// Rounds UP to the smallest normal.
	if ParseFloatLitToBits("2.2250738585072012e-308") != cast(uint64, 0x0010000000000000) {
		return "denormal->normal round-up"
	}
	// Stays the largest denormal.
	if ParseFloatLitToBits("2.225073858507201e-308") != cast(uint64, 0x000FFFFFFFFFFFFF) {
		return "largest denormal"
	}
	return ""
}

// TestParseFloatSaturationBoundary: the in-range value goes through the
// chunking; one decade higher saturates to +Inf.
func TestParseFloatSaturationBoundary() testing.TestResult {
	if ParseFloatLitToBits("1e308") != cast(uint64, 0x7FE1CCF385EBC8A0) { return "1e308 chunked" }
	if ParseFloatLitToBits("1e309") != cast(uint64, 0x7FF0000000000000) { return "1e309 +Inf" }
	return ""
}
