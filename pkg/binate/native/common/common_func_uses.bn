package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/std/vec"

// funcUses indexes a function's blocks for the PlanFrame analyses, which ask, value
// by value, where a value is used and where an instruction is — questions a scan of
// the whole function per value would answer at a cost quadratic in the function's
// size.  It records the block and position of each instruction and the operand
// sites of each value, in block and then instruction order, once per function (in
// time linear in its size); a query then costs the uses it reads.  f's fault pads
// are left out, as these analyses require: only the VM runs them, and the compiled
// backends the analyses serve emit none.  The analyses do not change f, so the
// index stays valid for the whole of PlanFrame.
type funcUses struct {
	f @ir.Func
	// defBlock[id] / defPos[id] locate the instruction with value id, or are -1 when
	// no instruction of f's blocks has the id, or several do (a phi's copies).
	defBlock @[]int
	defPos   @[]int
	// The uses of value id are the sites siteLo[id] .. siteLo[id + 1] - 1: site j is
	// operand siteOp[j] of instruction siteInstr[j] of block siteBlock[j], an operand
	// k >= 0 being Args[k] and -1 - k phi entry k.
	siteLo    @[]int
	siteBlock @[]int
	siteInstr @[]int
	siteOp    @[]int
	// derived is allocaAddrConfinedToLoadStore's scratch set, made at its first use
	// and reused by each query.
	derived @idSet
}

// newFuncUses indexes f (see funcUses).
func newFuncUses(f @ir.Func) @funcUses {
	var u @funcUses = make(funcUses)
	u.f = f
	var n int = f.NextID
	u.defBlock = make_slice(int, n)
	u.defPos = make_slice(int, n)
	var defCount @[]int = make_slice(int, n)
	var count @[]int = make_slice(int, n + 1)
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if ins.ID >= 0 && ins.ID < n {
				defCount[ins.ID]++
				u.defBlock[ins.ID] = bi
				u.defPos[ins.ID] = ii
			}
			for k := 0; k < len(ins.Args); k++ {
				var v @ir.Instr = ins.Args[k]
				if v != nil && v.ID >= 0 && v.ID < n { count[v.ID]++ }
			}
			for k := 0; k < len(ins.Phis); k++ {
				var pv *ir.Instr = ins.Phis[k].Val
				if pv != nil && pv.ID >= 0 && pv.ID < n { count[pv.ID]++ }
			}
		}
	}
	for id := 0; id < n; id++ {
		if defCount[id] != 1 {
			u.defBlock[id] = -1
			u.defPos[id] = -1
		}
	}
	u.siteLo = make_slice(int, n + 1)
	var total int = 0
	for id := 0; id < n; id++ {
		u.siteLo[id] = total
		total = total + count[id]
		count[id] = u.siteLo[id]
	}
	u.siteLo[n] = total
	u.siteBlock = make_slice(int, total)
	u.siteInstr = make_slice(int, total)
	u.siteOp = make_slice(int, total)
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			for k := 0; k < len(ins.Args); k++ {
				var v @ir.Instr = ins.Args[k]
				if v != nil && v.ID >= 0 && v.ID < n { u.addSite(count, v.ID, bi, ii, k) }
			}
			for k := 0; k < len(ins.Phis); k++ {
				var pv *ir.Instr = ins.Phis[k].Val
				if pv != nil && pv.ID >= 0 && pv.ID < n { u.addSite(count, pv.ID, bi, ii, -1 - k) }
			}
		}
	}
	return u
}

// addSite records the next use of id (next[id] is where it goes).
func (u @funcUses) addSite(next @[]int, id int, bi int, ii int, op int) {
	var j int = next[id]
	u.siteBlock[j] = bi
	u.siteInstr[j] = ii
	u.siteOp[j] = op
	next[id] = j + 1
}

// indexed reports whether value id is one the index records (an id in [0, NextID)).
func (u @funcUses) indexed(id int) bool { return id >= 0 && id < len(u.defBlock) }

// siteIns returns the instruction of site j.
func (u @funcUses) siteIns(j int) @ir.Instr {
	return u.f.Blocks[u.siteBlock[j]].Instrs[u.siteInstr[j]]
}

// useCount returns the number of operand and phi references to value id in f's blocks
// (0 for an id the index does not record).
func (u @funcUses) useCount(id int) int {
	if !u.indexed(id) { return 0 }
	return u.siteLo[id + 1] - u.siteLo[id]
}

// siteNames reports whether site j's operand is v itself (the same instruction, not
// merely one with v's id).
func (u @funcUses) siteNames(j int, v @ir.Instr) bool {
	var ins @ir.Instr = u.siteIns(j)
	var op int = u.siteOp[j]
	if op >= 0 { return ins.Args[op] == v }
	return ins.Phis[-1 - op].Val == v
}

// locate returns the block index and position of instruction v in f's blocks — its
// last place if it appears more than once — or (-1, -1) when it is in none.
func (u @funcUses) locate(v @ir.Instr) (int, int) {
	if u.indexed(v.ID) && u.defBlock[v.ID] >= 0 {
		var bi int = u.defBlock[v.ID]
		var ii int = u.defPos[v.ID]
		if u.f.Blocks[bi].Instrs[ii] == v { return bi, ii }
	}
	var fb int = -1
	var fi int = -1
	for bi := 0; bi < len(u.f.Blocks); bi++ {
		var b @ir.Block = u.f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			if b.Instrs[ii] == v {
				fb = bi
				fi = ii
			}
		}
	}
	return fb, fi
}

// lastIDIn returns the position of the last instruction of block bi with value id,
// or -1.
func (u @funcUses) lastIDIn(bi int, id int) int {
	if u.indexed(id) && u.defBlock[id] >= 0 {
		if u.defBlock[id] == bi { return u.defPos[id] }
		return -1
	}
	var at int = -1
	var b @ir.Block = u.f.Blocks[bi]
	for ii := 0; ii < len(b.Instrs); ii++ {
		if b.Instrs[ii].ID == id { at = ii }
	}
	return at
}

// idSet is a set of value ids in [0, n) that empties in constant time: id is a
// member when mark[id] equals stamp, and ids lists the members, each once.
type idSet struct {
	mark  @[]int
	stamp int
	ids   @vec.Vec[int]
}

// newIDSet returns an empty idSet for ids in [0, n).
func newIDSet(n int) @idSet {
	var s @idSet = make(idSet)
	s.mark = make_slice(int, n)
	s.stamp = 1
	s.ids = vec.New[int]()
	return s
}

// reset empties s.
func (s @idSet) reset() {
	s.stamp = s.stamp + 1
	s.ids = vec.New[int]()
}

// has reports whether id is in s (false for an id outside [0, n)).
func (s @idSet) has(id int) bool { return id >= 0 && id < len(s.mark) && s.mark[id] == s.stamp }

// add puts id in s, reporting whether it was not there yet.
func (s @idSet) add(id int) bool {
	if s.has(id) { return false }
	s.mark[id] = s.stamp
	s.ids.Push(id)
	return true
}

// slotGroups collects the candidates of a per-slot analysis — an instruction's block
// and two positions in it — by the stack slot they concern, so the analysis of a slot
// runs once for all of its candidates.
type slotGroups struct {
	// last[id] is the latest candidate of the slot with value id, or -1; slots lists
	// the slots with candidates, in the order of their first ones.
	last  @[]int
	slots @vec.Vec[int]
	// Candidate c is in block block[c] at positions at[c] and end[c]; prev[c] is the
	// slot's candidate added before it, or -1.
	block @vec.Vec[int]
	at    @vec.Vec[int]
	end   @vec.Vec[int]
	prev  @vec.Vec[int]
}

// newSlotGroups returns empty groups for slots with ids in [0, nid).
func newSlotGroups(nid int) @slotGroups {
	var g @slotGroups = make(slotGroups)
	g.last = make_slice(int, nid)
	for i := 0; i < nid; i++ { g.last[i] = -1 }
	g.slots = vec.New[int]()
	g.block = vec.New[int]()
	g.at = vec.New[int]()
	g.end = vec.New[int]()
	g.prev = vec.New[int]()
	return g
}

// add records a candidate of the slot with value id: block bi, positions at and end.
func (g @slotGroups) add(id int, bi int, at int, end int) {
	if g.last[id] < 0 { g.slots.Push(id) }
	g.block.Push(bi)
	g.at.Push(at)
	g.end.Push(end)
	g.prev.Push(g.last[id])
	g.last[id] = g.block.Len() - 1
}
