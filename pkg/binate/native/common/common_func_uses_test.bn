package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/iropt"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for funcUses (common_func_uses.bn): the use sites of each value, in block and
// then instruction order with their operand positions, and where each instruction is.

// A value used by two instructions of its block, by one in a later block and by a
// phi entry lists those four sites in order; a value nothing uses lists none.
func TestFuncUsesSitesInOrder() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var next @ir.Block = ir.AddBlock(f, "next")
	var a @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	var unused @ir.Instr = irbuild.EmitConstInt(entry, 2, types.TypInt())
	var b @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, a, a, types.TypInt())
	var c @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_SUB, b, a, types.TypInt())
	irbuild.EmitJump(entry, next)
	var phi @ir.Instr = irbuild.EmitPhi(next, types.TypInt(), twoPE(entry, c, entry, a))
	var d @ir.Instr = irbuild.EmitBinop(next, iropcode.OP_ADD, phi, a, types.TypInt())
	irbuild.EmitReturn(next, oneInstr(d))

	var u @funcUses = newFuncUses(f)
	// a: b's two operands (entry 2: op 0 and 1), c's second (entry 3, op 1), the phi's
	// second entry (next 0, entry -2), d's second operand (next 1, op 1).
	var lo int = u.siteLo[a.ID]
	if u.siteLo[a.ID + 1] - lo != 5 { return "a has five use sites" }
	var wantBlock @[]int = @[]int{0, 0, 0, 1, 1}
	var wantInstr @[]int = @[]int{2, 2, 3, 0, 1}
	var wantOp @[]int = @[]int{0, 1, 1, -2, 1}
	for k := 0; k < 5; k++ {
		if u.siteBlock[lo + k] != wantBlock[k] || u.siteInstr[lo + k] != wantInstr[k] ||
				u.siteOp[lo + k] != wantOp[k] {
			return "a's use sites, in block and instruction order"
		}
	}
	if u.siteLo[unused.ID + 1] != u.siteLo[unused.ID] { return "an unused value has no sites" }
	if u.defBlock[c.ID] != 0 || u.defPos[c.ID] != 3 { return "c is the entry's fourth instruction" }
	for k := 0; k < 5; k++ {
		if !u.siteNames(lo + k, a) { return "each of a's sites names a itself" }
	}
	bi, ii := u.locate(c)
	if bi != 0 || ii != 3 { return "c is located in the entry, fourth" }
	var g @ir.Func = ir.NewFunc("", "g", makeNoParams(), makeNoResults())
	var stray @ir.Instr = irbuild.EmitConstInt(ir.AddBlock(g, "entry"), 1, types.TypInt())
	sb, si := u.locate(stray)
	if sb != -1 || si != -1 { return "an instruction of another function is not located" }
	if u.useCount(a.ID) != 5 || u.useCount(unused.ID) != 0 { return "the use counts follow the sites" }
	if u.lastIDIn(1, d.ID) != 1 || u.lastIDIn(0, d.ID) != -1 { return "d is in the second block only" }
	return ""
}

// A value with several instructions — a phi's copies after phi elimination — has no
// single place, and lastIDIn finds the last one in a block by scanning it; an id with
// no instruction (a parameter) is in no block; ids outside [0, NextID) are not indexed.
func TestFuncUsesSharedAndMissingIDs() testing.TestResult {
	setTarget64()
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].Typ = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "loop", params, makeNoResults())
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var p @ir.Instr = irbuild.NewParamRef(f, f.Params[0])
	var initV @ir.Instr = irbuild.EmitConstInt(pre, 0, types.TypInt())
	irbuild.EmitJump(pre, header)
	var phi @ir.Instr = irbuild.EmitPhi(header, types.TypInt(), twoPE(pre, initV, pre, initV))
	var cond @ir.Instr = irbuild.EmitBinop(header, iropcode.OP_LT, phi, p, types.TypBool())
	irbuild.EmitBranch(header, cond, body, exit)
	var step @ir.Instr = irbuild.EmitBinop(body, iropcode.OP_ADD, phi, p, types.TypInt())
	irbuild.EmitJump(body, header)
	phi.Phis = twoPE(pre, initV, body, step)
	irbuild.EmitReturn(exit, makeNoInstrs())
	var phiID int = phi.ID
	iropt.EliminatePhis(f)

	var u @funcUses = newFuncUses(f)
	if u.defBlock[phiID] != -1 { return "a phi's copies give its id no single place" }
	for bi := 0; bi < len(f.Blocks); bi++ {
		var want int = -1
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			if b.Instrs[ii].ID == phiID { want = ii }
		}
		if u.lastIDIn(bi, phiID) != want { return "lastIDIn finds the last copy in each block" }
	}
	if u.lastIDIn(0, p.ID) != -1 || u.defBlock[p.ID] != -1 { return "a parameter is in no block" }
	if u.indexed(-1) || u.indexed(f.NextID) { return "ids outside [0, NextID) are not indexed" }
	return ""
}

// slotGroups lists the slots in the order of their first candidates and each slot's
// candidates, latest first.
func TestSlotGroups() testing.TestResult {
	var g @slotGroups = newSlotGroups(10)
	g.add(7, 0, 1, 2)
	g.add(3, 0, 4, 5)
	g.add(7, 1, 6, 8)
	if g.slots.Len() != 2 || g.slots.Get(0) != 7 || g.slots.Get(1) != 3 {
		return "the slots, in the order of their first candidates"
	}
	var c int = g.last[7]
	if g.block.Get(c) != 1 || g.at.Get(c) != 6 || g.end.Get(c) != 8 { return "7's latest candidate" }
	c = g.prev.Get(c)
	if g.block.Get(c) != 0 || g.at.Get(c) != 1 || g.end.Get(c) != 2 { return "7's first candidate" }
	if g.prev.Get(c) != -1 { return "7 has two candidates" }
	if g.prev.Get(g.last[3]) != -1 || g.last[5] != -1 { return "3 has one, 5 none" }
	return ""
}

// An idSet holds what was added, each id once, and empties on reset.
func TestIDSetAddAndReset() testing.TestResult {
	var s @idSet = newIDSet(10)
	if s.has(3) { return "a new set is empty" }
	if !s.add(3) || s.add(3) || !s.add(7) { return "add reports whether the id was new" }
	if !s.has(3) || !s.has(7) || s.has(4) || s.ids.Len() != 2 { return "the set holds 3 and 7" }
	if s.has(-1) || s.has(10) { return "ids outside the range are never members" }
	s.reset()
	if s.has(3) || s.has(7) || s.ids.Len() != 0 { return "reset empties the set" }
	if !s.add(7) || s.ids.Len() != 1 { return "a reset set takes ids again" }
	return ""
}

// Of two instructions sharing an id, a site names only the one its operand is.
func TestFuncUsesSiteNamesSharedID() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitConstInt(e, 1, types.TypInt())
	var y @ir.Instr = irbuild.EmitConstInt(e, 2, types.TypInt())
	y.ID = x.ID
	var sum @ir.Instr = irbuild.EmitBinop(e, iropcode.OP_ADD, x, y, types.TypInt())
	irbuild.EmitReturn(e, oneInstr(sum))
	var u @funcUses = newFuncUses(f)
	var lo int = u.siteLo[x.ID]
	if u.siteLo[x.ID + 1] - lo != 2 { return "both operands are sites of the shared id" }
	if !u.siteNames(lo, x) || u.siteNames(lo, y) { return "the first operand names x, not y" }
	if !u.siteNames(lo + 1, y) || u.siteNames(lo + 1, x) { return "the second operand names y, not x" }
	if u.defBlock[x.ID] != -1 { return "an id with two instructions has no single place" }
	bi, ii := u.locate(y)
	if bi != 0 || ii != 1 { return "y is located as itself" }
	return ""
}
