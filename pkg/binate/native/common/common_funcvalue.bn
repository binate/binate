package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/stdx/slices"

// FuncValueTypeOf returns the type of f's function value: its parameters and
// results — for a closure (IsClosure), only the parameters after its leading
// NumCaptureParams capture parameters, which the value's shim loads from the
// value's data rather than takes from the caller.
func FuncValueTypeOf(f @ir.Func) @types.Type {
	var first int = 0
	if f.IsClosure { first = f.NumCaptureParams }
	var params @[]@types.Param
	for j := first; j < len(f.Params); j++ {
		var p @types.Param = make(types.Param)
		p.Name = f.Params[j].Name
		p.Type = f.Params[j].Typ
		params = slices.Append[@types.Param](params, p)
	}
	return types.MakeFuncValueType(params, f.Results)
}
