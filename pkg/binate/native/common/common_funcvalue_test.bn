package "pkg/binate/native/common"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// funcWithParams builds a func with an int parameter per name and one int result.
func funcWithParams(names *[]*[]readonly char) @ir.Func {
	var noResults @[]@types.Type
	var noParams @[]@ir.Param
	var f @ir.Func = ir.NewFunc("test", "f", noParams, noResults)
	var params @[]@ir.Param
	for i := 0; i < len(names); i++ {
		params = slices.Append[@ir.Param](params,
				irbuild.NewParam(f, buf.CopyStr(names[i]), types.TypInt()))
	}
	f.Params = params
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	f.Results = results
	return f
}

// A plain function's value type takes every parameter; a closure's leaves out
// its leading capture parameters.
func TestFuncValueTypeOf() testing.TestResult {
	var names @[]*[]readonly char = make_slice(*[]readonly char, 3)
	names[0] = "recv"
	names[1] = "a"
	names[2] = "b"
	var f @ir.Func = funcWithParams(names)
	var t @types.Type = FuncValueTypeOf(f)
	if t == nil || len(t.Params) != 3 || len(t.Results) != 1 {
		return "a plain function's value type takes every parameter"
	}
	f.IsClosure = true
	f.NumCaptureParams = 1
	t = FuncValueTypeOf(f)
	if t == nil || len(t.Params) != 2 || t.Params[0].Name[0] != 'a' {
		return "a closure's value type leaves out its capture parameters"
	}
	return ""
}
