package "pkg/binate/native/common"

// int64List is a growable list of frame offsets or sizes (amortized O(1) Push),
// read back with Items.  TODO: use vec.Vec[int64] once BUILDER_VERSION includes
// binate 50d176225 — the pinned BUILDER makes vec.Vec[int64] and this package's
// vec.Vec[int] one instance.
type int64List struct {
	items @[]int64
	n     int
}

// newInt64List returns an int64List holding a copy of s.
func newInt64List(s @[]int64) @int64List {
	var l @int64List = make(int64List)
	l.items = make_slice(int64, len(s) + 8)
	for i := 0; i < len(s); i++ { l.items[i] = s[i] }
	l.n = len(s)
	return l
}

// Push appends v.
func (l @int64List) Push(v int64) {
	if l.n == len(l.items) {
		var grown @[]int64 = make_slice(int64, 2 * len(l.items) + 8)
		for i := 0; i < l.n; i++ { grown[i] = l.items[i] }
		l.items = grown
	}
	l.items[l.n] = v
	l.n = l.n + 1
}

// Get returns the i-th value.
func (l @int64List) Get(i int) int64 {
	return l.items[i]
}

// Len returns the number of values.
func (l @int64List) Len() int {
	return l.n
}

// Items returns the values as a slice of their own.
func (l @int64List) Items() @[]int64 {
	var out @[]int64 = make_slice(int64, l.n)
	for i := 0; i < l.n; i++ { out[i] = l.items[i] }
	return out
}
