package "pkg/binate/native/common"

import "pkg/builtins/testing"

// int64List grows past its starting room keeping every value, starts as a copy of
// the slice it is made from (empty included), and Items returns the values in order.
func TestInt64List() testing.TestResult {
	var l @int64List = newInt64List(make_slice(int64, 0))
	if l.Len() != 0 || len(l.Items()) != 0 { return "an empty list should hold nothing" }
	for i := 0; i < 100; i++ { l.Push(cast(int64, i) << 33) }
	if l.Len() != 100 || l.Get(0) != 0 || l.Get(99) != cast(int64, 99) << 33 {
		return "Push should keep every value, past 32 bits too, as the list grows"
	}
	var items @[]int64 = l.Items()
	if len(items) != 100 || items[57] != cast(int64, 57) << 33 {
		return "Items should return the values in order"
	}
	var c @int64List = newInt64List(@[]int64{5, 7})
	c.Push(9)
	if c.Len() != 3 || c.Get(0) != 5 || c.Get(2) != 9 {
		return "a list should start as a copy of its slice"
	}
	return ""
}
