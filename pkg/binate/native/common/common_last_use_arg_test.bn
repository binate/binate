package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for common_last_use_arg.bn: a load whose slot is dead after the call it is
// passed to reads the slot in place.

// lastUseFunc returns a function whose entry block declares a Quad slot, writes a
// field, loads the slot and passes the load to `g` — `var x Quad; x.a = 1; g(x)` —
// with the entry block, the slot, the load and the call; the caller adds the rest.
func lastUseFunc() (@ir.Func, @ir.Block, @ir.Instr, @ir.Instr, @ir.Instr) {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	irbuild.EmitStore(e, irbuild.EmitGetFieldPtr(e, s, 0, types.TypInt()),
			irbuild.EmitConstInt(e, 1, types.TypInt()))
	var ld @ir.Instr = irbuild.EmitLoad(e, s, elisionQuadTyp())
	var c @ir.Instr = irbuild.EmitCall(e, "g", retOf(ld), types.TypVoid())
	return f, e, s, ld, c
}

// The call is the slot's last use: the load reads it in place.
func TestLastUseArgLoads() testing.TestResult {
	setTarget64()
	f, e, _, ld, _ := lastUseFunc()
	irbuild.EmitReturn(e, elisionNoRets())
	if !LastUseArgLoads(f)[ld.ID] { return "the slot's last use passes it in place" }
	return ""
}

// The slot read after the call, written between the load and the call, or touched in
// another block keeps the copy.
func TestLastUseArgLoadsRejected() testing.TestResult {
	setTarget64()
	f, e, s, ld, _ := lastUseFunc()
	irbuild.EmitLoad(e, irbuild.EmitGetFieldPtr(e, s, 1, types.TypInt()), types.TypInt())
	irbuild.EmitReturn(e, elisionNoRets())
	if LastUseArgLoads(f)[ld.ID] { return "a slot read after the call is copied" }
	var g @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var ge @ir.Block = ir.AddBlock(g, "entry")
	var gs @ir.Instr = irbuild.EmitAlloc(ge, elisionQuadTyp())
	var gld @ir.Instr = irbuild.EmitLoad(ge, gs, elisionQuadTyp())
	irbuild.EmitStore(ge, irbuild.EmitGetFieldPtr(ge, gs, 0, types.TypInt()),
			irbuild.EmitConstInt(ge, 2, types.TypInt()))
	irbuild.EmitCall(ge, "g", retOf(gld), types.TypVoid())
	irbuild.EmitReturn(ge, elisionNoRets())
	if LastUseArgLoads(g)[gld.ID] { return "a slot written between the load and the call is copied" }
	h, he, hs, hld, _ := lastUseFunc()
	var hb @ir.Block = ir.AddBlock(h, "next")
	irbuild.EmitJump(he, hb)
	irbuild.EmitLoad(hb, hs, elisionQuadTyp())
	irbuild.EmitReturn(hb, elisionNoRets())
	if LastUseArgLoads(h)[hld.ID] { return "a slot touched in another block is copied" }
	var k @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var ke @ir.Block = ir.AddBlock(k, "entry")
	var ks @ir.Instr = irbuild.EmitAlloc(ke, elisionQuadTyp())
	var early @ir.Instr = irbuild.EmitLoad(ke, ks, elisionQuadTyp())
	var kld @ir.Instr = irbuild.EmitLoad(ke, ks, elisionQuadTyp())
	irbuild.EmitCall(ke, "g", retOf(kld), types.TypVoid())
	irbuild.EmitCall(ke, "h", retOf(early), types.TypVoid())
	irbuild.EmitReturn(ke, elisionNoRets())
	if LastUseArgLoads(k)[kld.ID] {
		return "an earlier load of the slot (which may alias it) used after the call: the slot is copied"
	}
	return ""
}

// In a block a loop may run again, the slot declared elsewhere must be set whole
// before it is touched: a field read first keeps the copy (the next run would read
// what the callee left), a whole store first passes the slot in place.
func TestLastUseArgLoadsReinit() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	var body @ir.Block = ir.AddBlock(f, "body")
	irbuild.EmitJump(e, body)
	irbuild.EmitLoad(body, irbuild.EmitGetFieldPtr(body, s, 0, types.TypInt()), types.TypInt())
	var ld @ir.Instr = irbuild.EmitLoad(body, s, elisionQuadTyp())
	irbuild.EmitCall(body, "g", retOf(ld), types.TypVoid())
	irbuild.EmitJump(body, body)
	if LastUseArgLoads(f)[ld.ID] { return "a field read before a whole store: the slot is copied" }
	var g @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var ge @ir.Block = ir.AddBlock(g, "entry")
	var gs @ir.Instr = irbuild.EmitAlloc(ge, elisionQuadTyp())
	var gbody @ir.Block = ir.AddBlock(g, "body")
	irbuild.EmitJump(ge, gbody)
	irbuild.EmitStore(gbody, gs, irbuild.EmitCall(gbody, "mk", noInstrs(), elisionQuadTyp()))
	var gld @ir.Instr = irbuild.EmitLoad(gbody, gs, elisionQuadTyp())
	irbuild.EmitCall(gbody, "g", retOf(gld), types.TypVoid())
	irbuild.EmitJump(gbody, gbody)
	if !LastUseArgLoads(g)[gld.ID] { return "a whole store first re-sets the slot: passed in place" }
	return ""
}

// What the call returns is not an alias of the slot: `y := transform(x)` with the
// result used after the call still passes x in place.  A parameter's slot qualifies.
// An aggregate taken out of an earlier load of the slot (which may alias it) and used
// after the call keeps the copy.
func TestLastUseArgLoadsShapes() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), quadResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	var ld @ir.Instr = irbuild.EmitLoad(e, s, elisionQuadTyp())
	var r @ir.Instr = irbuild.EmitCall(e, "transform", retOf(ld), elisionQuadTyp())
	irbuild.EmitReturn(e, retOf(r))
	if !LastUseArgLoads(f)[ld.ID] { return "a call's own result is not an alias of the slot" }
	g, ge, s0, _ := paramSlotFunc()
	var gld @ir.Instr = irbuild.EmitLoad(ge, s0, elisionQuadTyp())
	irbuild.EmitCall(ge, "g", retOf(gld), types.TypVoid())
	irbuild.EmitReturn(ge, elisionNoRets())
	if !LastUseArgLoads(g)[gld.ID] { return "a parameter's slot passed at its last use: in place" }
	var pf @[]@types.Field = make_slice(@types.Field, 2)
	pf[0] = make(types.Field)
	pf[0].Type = elisionQuadTyp()
	pf[1] = make(types.Field)
	pf[1].Type = types.TypInt()
	var outer @types.Type = types.MakeStructType("Outer", pf)
	var h @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var he @ir.Block = ir.AddBlock(h, "entry")
	var hs @ir.Instr = irbuild.EmitAlloc(he, outer)
	var hearly @ir.Instr = irbuild.EmitLoad(he, hs, outer)
	var member @ir.Instr = irbuild.EmitExtract(he, hearly, 0, elisionQuadTyp())
	var hld @ir.Instr = irbuild.EmitLoad(he, hs, outer)
	irbuild.EmitCall(he, "g", retOf(hld), types.TypVoid())
	irbuild.EmitCall(he, "h", retOf(member), types.TypVoid())
	irbuild.EmitReturn(he, elisionNoRets())
	if LastUseArgLoads(h)[hld.ID] { return "a member of an earlier load used after the call: copied" }
	return ""
}

// On AAPCS64 a Quad argument is a pointer to memory the callee owns: the load gets no
// region and the call no argument region — it passes the slot.
func TestPlanFrameLastUseArg() testing.TestResult {
	setTarget64()
	f, e, _, ld, c := lastUseFunc()
	irbuild.EmitReturn(e, elisionNoRets())
	var rm @RegMap = NewRegMap(callconv.AAPCS64())
	rm.PlanFrame(f)
	if !rm.IsLastUseArgLoad(ld.ID) || rm.LookupAlloc(ld.ID) >= 0 {
		return "the load reads the slot in place"
	}
	if rm.LookupArgCopy(c.ID, 0) >= 0 { return "the call passes the slot, not an argument copy" }
	return ""
}
