package "pkg/binate/native/common"

import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// Symbol/label naming helpers shared by every native backend.  These are
// object-format- and arch-independent: the local string label and the
// quote-stripping / format-name comparison used while lowering a module to
// an object file.  (Backend-specific naming that depends on the active
// object-format linkage prefix stays in each backend's `*_names.bn` for
// now — see the symPrefixed unification in claude-todo.md.)

// StringLabel returns the local assembler label for string constant `id`
// (`Lstr_<id>`).  Local ('L'-prefixed) so it stays out of the exported
// symbol table.
func StringLabel(id int) @[]char {
	var out @strings.Builder = strings.NewBuilder()
	out.Write("Lstr_")
	stringutils.WriteInt(out, id)
	return buf.CopyStr(out.String())
}

// BoundsLabel builds the `L`-prefixed local label for an inline bounds
// check's fail (fail=true) or ok-continuation (fail=false) target.
// Namespaced by funcSym (like block labels) plus a per-function sequence
// (RegMap.BoundsSeq) so the two targets of one check, checks within a
// function, and checks across functions never collide — the void
// OP_BOUNDS_CHECK has no usable Instr.ID to key on.  Shared by every native
// backend's inline OP_BOUNDS_CHECK lowering.
func BoundsLabel(funcSym @[]char, seq int, fail bool) @[]char {
	var out @strings.Builder = strings.NewBuilder()
	out.Write("L")
	out.Write(funcSym)
	out.Write("__bc")
	stringutils.WriteInt(out, seq)
	if fail {
		out.Write("f")
	} else {
		out.Write("o")
	}
	return buf.CopyStr(out.String())
}

// StripQuotes drops a surrounding pair of double quotes from `s` (e.g. a
// quoted module name), returning `s` unchanged when it is not so wrapped.
func StripQuotes(s *[]readonly char) *[]readonly char {
	if len(s) >= 2 && s[0] == '"' && s[len(s) - 1] == '"' {
		return s[1:len(s) - 1]
	}
	return s
}

// ObjFmtEq reports whether two object-format name slices are byte-equal
// (used to test `format` against "elf" / "macho").
func ObjFmtEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
