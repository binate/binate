package "pkg/binate/native/common"

import "pkg/builtins/testing"

// Tests for the shared native naming helpers in common_names.bn.  String
// results are compared via ObjFmtEq (the managed @[]char from StringLabel
// decays to the *[]readonly char it expects).

func TestStringLabel() testing.TestResult {
	if !ObjFmtEq(StringLabel(5), "Lstr_5") {
		return "StringLabel(5) should be Lstr_5"
	}
	if !ObjFmtEq(StringLabel(0), "Lstr_0") {
		return "StringLabel(0) should be Lstr_0"
	}
	if !ObjFmtEq(StringLabel(123), "Lstr_123") {
		return "StringLabel(123) should be Lstr_123"
	}
	return ""
}

func TestStripQuotes() testing.TestResult {
	if !ObjFmtEq(StripQuotes("\"foo\""), "foo") {
		return "StripQuotes should drop the surrounding quotes"
	}
	if !ObjFmtEq(StripQuotes("foo"), "foo") {
		return "StripQuotes should leave unquoted input unchanged"
	}
	if !ObjFmtEq(StripQuotes("\"\""), "") {
		return "StripQuotes should reduce \"\" to the empty string"
	}
	if !ObjFmtEq(StripQuotes("\""), "\"") {
		return "StripQuotes should leave a lone quote unchanged"
	}
	return ""
}

func TestObjFmtEq() testing.TestResult {
	if !ObjFmtEq("elf", "elf") {
		return "elf should equal elf"
	}
	if ObjFmtEq("elf", "macho") {
		return "elf should not equal macho"
	}
	if ObjFmtEq("elf", "elfx") {
		return "differing lengths should not be equal"
	}
	if !ObjFmtEq("", "") {
		return "empty should equal empty"
	}
	return ""
}
