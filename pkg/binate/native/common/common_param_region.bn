package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"

// ParamRegionElidable reports whether p, a by-value aggregate parameter passed
// as a pointer to a copy of it (callconv.CallConv.PassesIndirect), may use that
// incoming memory as its value instead of copying it into a region of its own.
//
// A caller may pass memory it is still using (an aggregate load that aliases its
// source), so the incoming bytes are only known to be unchanged until the callee
// first writes memory.  The copy is skipped only when every use of p is the
// store of p into a stack slot at the top of the entry block, with nothing before
// it but slot allocations and stores into stack slots — neither of which can
// write the caller's memory.  IR-gen begins every function that way, storing
// each parameter into its slot; a later read of p (an extract moved down to its
// first use, say) keeps the copy.
func ParamRegionElidable(f @ir.Func, p @ir.Param) bool {
	if len(f.Blocks) == 0 { return false }
	var total int = countParamUses(f.Blocks, p) + countParamUses(f.FaultPads, p)
	if total == 0 { return false }
	var entry @ir.Block = f.Blocks[0]
	var seen int = 0
	for ii := 0; ii < len(entry.Instrs); ii++ {
		var ins @ir.Instr = entry.Instrs[ii]
		var n int = paramUsesIn(ins, p)
		if n > 0 {
			if !isStoreToStackSlot(ins) || n != 1 || !isParamRef(ins.Args[1], p) { return false }
			seen++
			if seen == total { return true }
			continue
		}
		if ins.Op == iropcode.OP_ALLOC || isStoreToStackSlot(ins) { continue }
		return false
	}
	return false
}

// isParamRef reports whether v is a reference to parameter p.
func isParamRef(v @ir.Instr, p @ir.Param) bool {
	return v != nil && v.Op == iropcode.OP_PARAM && v.ID == p.ID
}

// paramUsesIn counts the operands of ins that reference parameter p.
func paramUsesIn(ins @ir.Instr, p @ir.Param) int {
	var n int = 0
	for k := 0; k < len(ins.Args); k++ {
		if isParamRef(ins.Args[k], p) { n++ }
	}
	for k := 0; k < len(ins.Phis); k++ {
		var v *ir.Instr = ins.Phis[k].Val
		if v != nil && v.Op == iropcode.OP_PARAM && v.ID == p.ID { n++ }
	}
	return n
}

// countParamUses counts the references to parameter p in blocks.
func countParamUses(blocks @[]@ir.Block, p @ir.Param) int {
	var n int = 0
	for bi := 0; bi < len(blocks); bi++ {
		var b @ir.Block = blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ { n = n + paramUsesIn(b.Instrs[ii], p) }
	}
	return n
}

// isStoreToStackSlot reports whether ins stores into a stack slot (an OP_ALLOC
// that is not a package global's reference).
func isStoreToStackSlot(ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_STORE || len(ins.Args) < 2 { return false }
	var a @ir.Instr = ins.Args[0]
	return a != nil && a.Op == iropcode.OP_ALLOC && !a.IsGlobalRef
}
