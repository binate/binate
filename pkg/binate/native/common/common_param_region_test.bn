package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// paramRegionFunc returns a function taking two Quad parameters, with an entry
// block whose first instructions are each parameter's slot and the store of the
// parameter into it — the shape IR-gen begins every function with.  It returns
// the function, its entry block and the two slots.
func paramRegionFunc() (@ir.Func, @ir.Block, @ir.Instr, @ir.Instr) {
	var q @types.Type = elisionQuadTyp()
	var params @[]@ir.Param = make_slice(@ir.Param, 2)
	for i := 0; i < 2; i++ {
		var p @ir.Param = make(ir.Param)
		p.Typ = q
		params[i] = p
	}
	var f @ir.Func = ir.NewFunc("", "t", params, elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s0 @ir.Instr = irbuild.EmitAlloc(e, q)
	irbuild.EmitStore(e, s0, irbuild.NewParamRef(f, params[0]))
	var s1 @ir.Instr = irbuild.EmitAlloc(e, q)
	irbuild.EmitStore(e, s1, irbuild.NewParamRef(f, params[1]))
	return f, e, s0, s1
}

// Parameters read only by their entry stores into stack slots use the incoming
// copy, even when other work (a call, here) follows the stores.
func TestParamRegionElidableEntryStores() testing.TestResult {
	f, e, _, _ := paramRegionFunc()
	irbuild.EmitCall(e, "g", elisionNoRets(), types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	if !ParamRegionElidable(f, f.Params[0]) || !ParamRegionElidable(f, f.Params[1]) {
		return "parameters read only by their entry stores should be elidable"
	}
	return ""
}

// A read of the parameter after a call — which may write the caller's memory the
// incoming pointer names — keeps the copy for that parameter alone.
func TestParamRegionElidableLaterReadKeepsCopy() testing.TestResult {
	f, e, _, _ := paramRegionFunc()
	irbuild.EmitCall(e, "g", elisionNoRets(), types.TypVoid())
	irbuild.EmitExtract(e, irbuild.NewParamRef(f, f.Params[1]), 0, types.TypInt())
	irbuild.EmitReturn(e, elisionNoRets())
	if !ParamRegionElidable(f, f.Params[0]) {
		return "a parameter read only by its entry store should stay elidable"
	}
	if ParamRegionElidable(f, f.Params[1]) {
		return "a parameter read after a call must keep its copy"
	}
	return ""
}

// paramRegionOneParam returns a function taking one Quad parameter, with an
// empty entry block.
func paramRegionOneParam() (@ir.Func, @ir.Block) {
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	var p @ir.Param = make(ir.Param)
	p.Typ = elisionQuadTyp()
	params[0] = p
	var f @ir.Func = ir.NewFunc("", "t", params, elisionNoResults())
	return f, ir.AddBlock(f, "entry")
}

// A call before the parameter's store into its slot — it may write the caller's
// memory the incoming pointer names — keeps the copy.
func TestParamRegionElidableStoreAfterCall() testing.TestResult {
	f, e := paramRegionOneParam()
	var s0 @ir.Instr = irbuild.EmitAlloc(e, f.Params[0].Typ)
	irbuild.EmitCall(e, "g", elisionNoRets(), types.TypVoid())
	irbuild.EmitStore(e, s0, irbuild.NewParamRef(f, f.Params[0]))
	irbuild.EmitReturn(e, elisionNoRets())
	if ParamRegionElidable(f, f.Params[0]) {
		return "a parameter stored after a call must keep its copy"
	}
	return ""
}

// A store of the parameter into a package global, not a stack slot, keeps the
// copy.
func TestParamRegionElidableStoreToGlobal() testing.TestResult {
	f, e := paramRegionOneParam()
	var g @ir.Instr = irbuild.EmitAlloc(e, f.Params[0].Typ)
	g.IsGlobalRef = true
	irbuild.EmitStore(e, g, irbuild.NewParamRef(f, f.Params[0]))
	irbuild.EmitReturn(e, elisionNoRets())
	if ParamRegionElidable(f, f.Params[0]) {
		return "a parameter stored into a package global must keep its copy"
	}
	return ""
}
