package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"

// A by-value aggregate parameter that arrives as a pointer to a copy the callee owns
// (AAPCS64's aggregates over 16 bytes — callconv.CallConv.PassesIndirect natively,
// IsByvalParam in the LLVM backend's aarch64 lowering) can use that copy as its
// stack slot.  IR-gen stores each parameter into a slot of its own at the top of the
// entry block; when that store is the parameter's only use, the slot may simply BE
// the incoming memory — no copy into it and no zero-fill.  A closure's captures are
// excluded: its shim passes them as pointers into the closure record, which the body
// must not write.

// InPlaceParamSlots returns, indexed by value ID, the index of the parameter whose
// incoming memory each OP_ALLOC of f may be (see above), or -1.  A slot qualifies
// when its parameter is not a capture, the parameter's only use is a store of it
// into the slot in the entry block, the slot is the parameter's size, and nothing
// in the entry block uses the slot before that store.  Whether a qualifying slot is
// used in place is the backend's decision: only where the parameter arrives as a
// pointer to a copy the callee owns.
func InPlaceParamSlots(f @ir.Func) @[]int {
	var out @[]int = make_slice(int, f.NextID)
	for i := 0; i < len(out); i++ { out[i] = -1 }
	if len(f.Blocks) == 0 { return out }
	var entry @ir.Block = f.Blocks[0]
	for pi := 0; pi < len(f.Params); pi++ {
		if f.IsClosure && pi < f.NumCaptureParams { continue }
		var p @ir.Param = f.Params[pi]
		if countParamUses(f.Blocks, p) + countParamUses(f.FaultPads, p) != 1 { continue }
		for ii := 0; ii < len(entry.Instrs); ii++ {
			var ins @ir.Instr = entry.Instrs[ii]
			if paramUsesIn(ins, p) == 0 { continue }
			if isStoreToStackSlot(ins) && isParamRef(ins.Args[1], p) {
				var slot @ir.Instr = ins.Args[0]
				if slot.ID >= 0 && slot.ID < len(out) && slot.TypeArg != nil && p.Typ != nil &&
						slot.TypeArg.SizeOf() == p.Typ.SizeOf() && slotUnusedBefore(entry, ii, slot) {
					out[slot.ID] = pi
				}
			}
			break
		}
	}
	return out
}

// slotUnusedBefore reports whether no instruction of b before index end has slot as
// an operand.
func slotUnusedBefore(b @ir.Block, end int, slot @ir.Instr) bool {
	for ii := 0; ii < end; ii++ {
		var ins @ir.Instr = b.Instrs[ii]
		for k := 0; k < len(ins.Args); k++ {
			if ins.Args[k] != nil && ins.Args[k].ID == slot.ID { return false }
		}
	}
	return true
}

// InPlaceSlotParam returns the value ID of the parameter whose incoming copy the
// OP_ALLOC with value ID id is (InPlaceSlotIDs), or -1.
func (m @RegMap) InPlaceSlotParam(id int) int {
	for i := 0; i < len(m.InPlaceSlotIDs); i++ {
		if m.InPlaceSlotIDs[i] == id { return m.InPlaceSlotParams[i] }
	}
	return -1
}

// isParamRef reports whether v is a reference to parameter p.
func isParamRef(v @ir.Instr, p @ir.Param) bool {
	return v != nil && v.Op == iropcode.OP_PARAM && v.ID == p.ID
}

// paramUsesIn counts the operands of ins that reference parameter p.
func paramUsesIn(ins @ir.Instr, p @ir.Param) int {
	var n int = 0
	for k := 0; k < len(ins.Args); k++ {
		if isParamRef(ins.Args[k], p) { n++ }
	}
	for k := 0; k < len(ins.Phis); k++ {
		var v *ir.Instr = ins.Phis[k].Val
		if v != nil && v.Op == iropcode.OP_PARAM && v.ID == p.ID { n++ }
	}
	return n
}

// countParamUses counts the references to parameter p in blocks.
func countParamUses(blocks @[]@ir.Block, p @ir.Param) int {
	var n int = 0
	for bi := 0; bi < len(blocks); bi++ {
		var b @ir.Block = blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ { n = n + paramUsesIn(b.Instrs[ii], p) }
	}
	return n
}

// isStoreToStackSlot reports whether ins stores into a stack slot (an OP_ALLOC
// that is not a package global's reference).
func isStoreToStackSlot(ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_STORE || len(ins.Args) < 2 { return false }
	var a @ir.Instr = ins.Args[0]
	return a != nil && a.Op == iropcode.OP_ALLOC && !a.IsGlobalRef
}
