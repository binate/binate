package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for common_param_slot.bn: a by-value aggregate parameter's slot may be its
// incoming copy when the entry store into it is the parameter's only use.

// paramSlotFunc returns a function taking two Quad parameters, with an entry
// block whose first instructions are each parameter's slot and the store of the
// parameter into it — the shape IR-gen begins every function with.  It returns
// the function, its entry block and the two slots.
func paramSlotFunc() (@ir.Func, @ir.Block, @ir.Instr, @ir.Instr) {
	var q @types.Type = elisionQuadTyp()
	var params @[]@ir.Param = make_slice(@ir.Param, 2)
	for i := 0; i < 2; i++ {
		var p @ir.Param = make(ir.Param)
		p.Typ = q
		params[i] = p
	}
	var f @ir.Func = ir.NewFunc("", "t", params, elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s0 @ir.Instr = irbuild.EmitAlloc(e, q)
	irbuild.EmitStore(e, s0, irbuild.NewParamRef(f, params[0]))
	var s1 @ir.Instr = irbuild.EmitAlloc(e, q)
	irbuild.EmitStore(e, s1, irbuild.NewParamRef(f, params[1]))
	return f, e, s0, s1
}

// Both parameters, each read only by its entry store, may use the incoming copy as
// their slot.
func TestInPlaceParamSlotsEntryStores() testing.TestResult {
	setTarget64()
	f, e, s0, s1 := paramSlotFunc()
	irbuild.EmitReturn(e, elisionNoRets())
	var slots @[]int = InPlaceParamSlots(f)
	if slots[s0.ID] != 0 || slots[s1.ID] != 1 {
		return "each parameter's entry slot may be its incoming copy"
	}
	return ""
}

// A parameter read again besides its entry store keeps a slot of its own: writes to
// the slot must not show through the later read.
func TestInPlaceParamSlotsLaterRead() testing.TestResult {
	setTarget64()
	f, e, s0, s1 := paramSlotFunc()
	irbuild.EmitExtract(e, irbuild.NewParamRef(f, f.Params[1]), 0, types.TypInt())
	irbuild.EmitReturn(e, elisionNoRets())
	var slots @[]int = InPlaceParamSlots(f)
	if slots[s0.ID] != 0 { return "a parameter read only by its entry store stays in place" }
	if slots[s1.ID] != -1 { return "a parameter read again must keep its own slot" }
	return ""
}

// A closure's capture parameter keeps its own slot: its shim passes a pointer into
// the closure record, which the body must not write.
func TestInPlaceParamSlotsCaptureExcluded() testing.TestResult {
	setTarget64()
	f, e, s0, s1 := paramSlotFunc()
	irbuild.EmitReturn(e, elisionNoRets())
	f.IsClosure = true
	f.NumCaptureParams = 1
	var slots @[]int = InPlaceParamSlots(f)
	if slots[s0.ID] != -1 { return "a capture parameter must keep its own slot" }
	if slots[s1.ID] != 1 { return "a user parameter after the captures may be in place" }
	return ""
}

// On AAPCS64 an in-place slot gets no region: its value is the parameter's pointer,
// read from the parameter's spill slot.  On SysV x86-64 (the aggregate arrives on the
// stack, not as a pointer) the slot keeps its region.
func TestPlanFrameInPlaceParamSlot() testing.TestResult {
	setTarget64()
	f, e, s0, _ := paramSlotFunc()
	irbuild.EmitReturn(e, elisionNoRets())
	var rm @RegMap = nrm()
	rm.PlanFrame(f)
	if rm.LookupAlloc(s0.ID) >= 0 { return "an in-place slot needs no region" }
	if rm.InPlaceSlotParam(s0.ID) != f.Params[0].ID { return "the slot must be recorded as in place" }
	var ps int = rm.LookupSpill(f.Params[0].ID)
	if ps < 0 || rm.LookupSpill(s0.ID) != ps {
		return "an in-place slot reads the parameter's spill slot"
	}
	var sx @RegMap = NewRegMap(callconv.SysV_AMD64())
	sx.PlanFrame(f)
	if sx.LookupAlloc(s0.ID) < 0 || sx.InPlaceSlotParam(s0.ID) >= 0 {
		return "SysV keeps the slot's region"
	}
	return ""
}

// A parameter stored into a package global, not a stack slot, has no in-place slot.
func TestInPlaceParamSlotsStoreToGlobal() testing.TestResult {
	setTarget64()
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].Typ = elisionQuadTyp()
	var f @ir.Func = ir.NewFunc("", "t", params, elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var g @ir.Instr = irbuild.EmitAlloc(e, f.Params[0].Typ)
	g.IsGlobalRef = true
	irbuild.EmitStore(e, g, irbuild.NewParamRef(f, f.Params[0]))
	irbuild.EmitReturn(e, elisionNoRets())
	var slots @[]int = InPlaceParamSlots(f)
	if slots[g.ID] != -1 { return "a parameter stored into a package global has no in-place slot" }
	return ""
}
