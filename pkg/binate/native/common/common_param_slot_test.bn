package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for common_param_slot.bn: a by-value aggregate parameter's slot may be its
// incoming copy when the entry store into it is the parameter's only use.

// paramSlotFunc returns a function taking two Quad parameters, with an entry
// block whose first instructions are each parameter's slot and the store of the
// parameter into it — the shape IR-gen begins every function with.  It returns
// the function, its entry block and the two slots.
func paramSlotFunc() (@ir.Func, @ir.Block, @ir.Instr, @ir.Instr) {
	var q @types.Type = elisionQuadTyp()
	var params @[]@ir.Param = make_slice(@ir.Param, 2)
	for i := 0; i < 2; i++ {
		var p @ir.Param = make(ir.Param)
		p.Typ = q
		params[i] = p
	}
	var f @ir.Func = ir.NewFunc("", "t", params, elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s0 @ir.Instr = irbuild.EmitAlloc(e, q)
	irbuild.EmitStore(e, s0, irbuild.NewParamRef(f, params[0]))
	var s1 @ir.Instr = irbuild.EmitAlloc(e, q)
	irbuild.EmitStore(e, s1, irbuild.NewParamRef(f, params[1]))
	return f, e, s0, s1
}

// Both parameters, each read only by its entry store, may use the incoming copy as
// their slot.
func TestInPlaceParamSlotsEntryStores() testing.TestResult {
	setTarget64()
	f, e, s0, s1 := paramSlotFunc()
	irbuild.EmitReturn(e, elisionNoRets())
	var slots @[]int = InPlaceParamSlots(f)
	if slots[s0.ID] != 0 || slots[s1.ID] != 1 {
		return "each parameter's entry slot may be its incoming copy"
	}
	return ""
}

// A parameter read again besides its entry store keeps a slot of its own: writes to
// the slot must not show through the later read.
func TestInPlaceParamSlotsLaterRead() testing.TestResult {
	setTarget64()
	f, e, s0, s1 := paramSlotFunc()
	irbuild.EmitExtract(e, irbuild.NewParamRef(f, f.Params[1]), 0, types.TypInt())
	irbuild.EmitReturn(e, elisionNoRets())
	var slots @[]int = InPlaceParamSlots(f)
	if slots[s0.ID] != 0 { return "a parameter read only by its entry store stays in place" }
	if slots[s1.ID] != -1 { return "a parameter read again must keep its own slot" }
	return ""
}

// A closure's capture qualifies like any parameter; PlanFrame keeps a slot of its own
// for one passed as a pointer into the closure record (a 32-byte Quad on AAPCS64),
// which the body must not write, and uses one passed on the stack (SysV) — a copy
// its shim made — in place.
func TestPlanFrameCaptureSlot() testing.TestResult {
	setTarget64()
	f, e, s0, s1 := paramSlotFunc()
	irbuild.EmitReturn(e, elisionNoRets())
	f.IsClosure = true
	f.NumCaptureParams = 1
	var slots @[]int = InPlaceParamSlots(f)
	if slots[s0.ID] != 0 || slots[s1.ID] != 1 {
		return "a capture's slot qualifies like any parameter's"
	}
	var rm @RegMap = NewRegMap(callconv.AAPCS64())
	rm.PlanFrame(f)
	if rm.InPlaceSlotParam(s0.ID) >= 0 || rm.LookupAlloc(s0.ID) < 0 {
		return "a capture passed as a pointer into the closure record keeps a slot of its own"
	}
	if rm.InPlaceSlotParam(s1.ID) != f.Params[1].ID { return "a user parameter is used in place" }
	rm = NewRegMap(callconv.SysV_AMD64())
	rm.PlanFrame(f)
	if rm.InPlaceSlotParam(s0.ID) != f.Params[0].ID {
		return "a capture passed on the stack is used in place"
	}
	return ""
}

// slotFuncOf returns a function taking parameters of types ts, each stored into a
// slot of its own at the top of the entry block, with the slots.
func slotFuncOf(ts @[]@types.Type) (@ir.Func, @[]@ir.Instr) {
	var params @[]@ir.Param = make_slice(@ir.Param, len(ts))
	for i := 0; i < len(ts); i++ {
		params[i] = make(ir.Param)
		params[i].Typ = ts[i]
	}
	var f @ir.Func = ir.NewFunc("", "t", params, elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var slots @[]@ir.Instr = make_slice(@ir.Instr, len(ts))
	for i := 0; i < len(ts); i++ {
		slots[i] = irbuild.EmitAlloc(e, ts[i])
		irbuild.EmitStore(e, slots[i], irbuild.NewParamRef(f, params[i]))
	}
	irbuild.EmitReturn(e, elisionNoRets())
	return f, slots
}

// A parameter whose bytes arrive in memory the callee owns — a pointer to the
// caller's copy on AAPCS64, the stack on SysV x86-64 (a 32-byte struct is MEMORY
// class) — gets no region: its in-place slot reads the parameter's spill slot.
func TestPlanFrameInPlaceParamSlot() testing.TestResult {
	setTarget64()
	f, e, s0, _ := paramSlotFunc()
	irbuild.EmitReturn(e, elisionNoRets())
	var ccs @[]callconv.CallConv = make_slice(callconv.CallConv, 2)
	ccs[0] = callconv.AAPCS64()
	ccs[1] = callconv.SysV_AMD64()
	for i := 0; i < len(ccs); i++ {
		var rm @RegMap = NewRegMap(ccs[i])
		rm.PlanFrame(f)
		if rm.LookupAlloc(s0.ID) >= 0 || rm.LookupAlloc(f.Params[0].ID) >= 0 {
			return "an in-place slot and its parameter need no region"
		}
		if rm.InPlaceSlotParam(s0.ID) != f.Params[0].ID { return "the slot must be recorded as in place" }
		var ps int = rm.LookupSpill(f.Params[0].ID)
		if ps < 0 || rm.LookupSpill(s0.ID) != ps {
			return "an in-place slot reads the parameter's spill slot"
		}
	}
	return ""
}

// A 16-byte struct arrives in two SysV registers, not memory: it keeps its region
// and its slot.
func TestPlanFrameRegisterParamKeepsRegion() testing.TestResult {
	setTarget64()
	var ts @[]@types.Type = make_slice(@types.Type, 1)
	ts[0] = elisionPairTyp()
	f, slots := slotFuncOf(ts)
	var rm @RegMap = NewRegMap(callconv.SysV_AMD64())
	rm.PlanFrame(f)
	if rm.LookupAlloc(f.Params[0].ID) < 0 || rm.LookupAlloc(slots[0].ID) < 0 {
		return "a register-passed aggregate keeps its region and its slot"
	}
	if rm.InPlaceSlotParam(slots[0].ID) >= 0 { return "its slot is not in place" }
	return ""
}

// On AAPCS32 a 32-byte struct after an int is split: r1-r3 and the stack.  The
// prologue's split save area holds the three register words (12 bytes, 16 with
// the alignment pad) and the parameter is used in place.
func TestPlanFrameSplitSaveArea() testing.TestResult {
	setTarget32()
	var fields @[]@types.Field = make_slice(@types.Field, 8)
	for i := 0; i < 8; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt()
	ts[1] = types.MakeStructType("Big8", fields)
	f, slots := slotFuncOf(ts)
	var rm @RegMap = NewRegMap(callconv.AAPCS32())
	rm.PlanFrame(f)
	setTarget64()
	if rm.SplitSaveBytes != 16 { return "the split save area holds r1-r3, padded to 16 bytes" }
	if rm.LookupAlloc(f.Params[1].ID) >= 0 || rm.InPlaceSlotParam(slots[1].ID) != f.Params[1].ID {
		return "the split parameter is used in place"
	}
	return ""
}

// A parameter stored into a package global, not a stack slot, has no in-place slot.
func TestInPlaceParamSlotsStoreToGlobal() testing.TestResult {
	setTarget64()
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].Typ = elisionQuadTyp()
	var f @ir.Func = ir.NewFunc("", "t", params, elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var g @ir.Instr = irbuild.EmitAlloc(e, f.Params[0].Typ)
	g.IsGlobalRef = true
	irbuild.EmitStore(e, g, irbuild.NewParamRef(f, f.Params[0]))
	irbuild.EmitReturn(e, elisionNoRets())
	var slots @[]int = InPlaceParamSlots(f)
	if slots[g.ID] != -1 { return "a parameter stored into a package global has no in-place slot" }
	return ""
}
