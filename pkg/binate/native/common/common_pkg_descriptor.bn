package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"

// Per-package reflect.Package descriptor — the data half for the native
// backends.  The node + name-bytes layout is built once by
// ir.BuildPackageDescriptor (shared with the LLVM backend) and lowered through
// EmitDataGlobal; the two backends walk the same terms, so they cannot drift
// (the bound this enforces — what the now-deleted hand-rolled layout could not).

// STATIC_MANAGED_REFCOUNT mirrors rt.STATIC_REFCOUNT (ifaces/core/
// pkg/builtins/rt.bni) and the LLVM backend's identically-named constant
// (pkg/binate/codegen/emit_static_managed.bn): the sentinel Refcount in an
// immortal static-managed header.  A negative refcount marks an object that
// RefInc/RefDec must never count or free.  Mirrored rather than imported
// because cross-package const-folding of rt.STATIC_REFCOUNT isn't available at
// codegen time.  Keep in sync with rt.bni + the codegen copy.
const STATIC_MANAGED_REFCOUNT int = -1073741824

// EmitPackageDescriptorData lays the module's reflect.Package descriptor node
// (immortal static-managed header + { Name, Functions, Globals, Vtables }
// payload) + the package-name bytes into the data section.  Each table slice
// points at its backing array (EmitFunctionsArray / EmitGlobalsArray /
// EmitVtablesArray, emitted separately and named here) when its count > 0,
// else the empty slice { null, 0 }.  The per-arch caller emits the exported
// `_Package` accessor returning the payload pointer (node + 2 header words).
func EmitPackageDescriptorData(a @asm.Assembler, pkgInfoSym *[]readonly char,
		pkgNameSym *[]readonly char, nameBytes *[]readonly char,
		funcsArraySym *[]readonly char, funcCount int,
		globalsArraySym *[]readonly char, globalCount int,
		vtablesArraySym *[]readonly char, vtableCount int) {
	// buf.CopyStr owns the symbol/name strings the DataGlobals retain.
	var dgs @[]@ir.DataGlobal = ir.BuildPackageDescriptor(
		STATIC_MANAGED_REFCOUNT, buf.CopyStr(pkgInfoSym),
		buf.CopyStr(pkgNameSym), buf.CopyStr(nameBytes),
		buf.CopyStr(funcsArraySym), funcCount,
		buf.CopyStr(globalsArraySym), globalCount,
		buf.CopyStr(vtablesArraySym), vtableCount)
	for i := 0; i < len(dgs); i++ {
		EmitDataGlobal(a, dgs[i])
	}
	return
}
