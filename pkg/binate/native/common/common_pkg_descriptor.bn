package "pkg/binate/native/common"

import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/binate/types"

// Shared reflect.Package-descriptor helpers for the native backends — the
// static-managed refcount sentinel passed to irdata.BuildPackageDescriptors plus
// the per-entry payload-scalar / name helpers both arch gather passes
// (aarch64 / x64 _pkg_descriptor.bn) call.  The descriptor's byte layout itself
// lives in irdata.BuildPackageDescriptors (the single source of truth both backends
// lower through EmitDataGlobal); these are the backend-neutral bits the gather
// needs, shared so the two arches stay in lockstep.

// FuncRetbufSize returns the VM-dispatch RetbufSize for a func-value type: the
// aggregate retbuf byte size (rounded to N*8) when the function returns via a
// retbuf, or 0 for a scalar / void return — a nonzero value is the
// scalar-vs-aggregate discriminator AND the retbuf byte count.  Delegates to
// the shared types.AggregateReturnSize (the LLVM gather calls it directly) so
// both backends and the VM agree on the shim shape.
func FuncRetbufSize(fv @types.Type) int {
	if fv == nil { return 0 }
	return types.AggregateReturnSize(fv.Results)
}

// ImplVtableBareName builds the canonical, UNPREFIXED vtable name (the
// `__ivt.` decoration on a bn_V core) — the form the bytecode VM keys on
// (findIfaceVtable / lookupVtableAddr / BC_IFACE_VALUE), identical across
// IR-gen, the LLVM codegen, and VM lowering.  Delegates to
// mangle.ImplVtableName (the single source of truth); the native backends'
// object symbols add a format-specific prefix (Mach-O `_`) on top, while the
// descriptor's VtableInfo.Name stores this BARE form so the VM lookup matches
// regardless of which backend compiled the package.
func ImplVtableBareName(recvPkg *[]readonly char, recvTypeName *[]readonly char,
		ifacePkg *[]readonly char, ifaceName *[]readonly char) @[]char {
	return mangle.ImplVtableName(recvPkg, recvTypeName, ifacePkg, ifaceName)
}

// RecvTypeIsGenericInst reports whether an impl's receiver type name is a
// monomorphized generic instantiation (carries the `__bn_inst__` marker).  Such
// impls re-lower at any bytecode importer's use site, so they are NOT injected
// by name — the native descriptor excludes them, matching emit_pkg_descriptor's
// recvTypeIsGenericInst on the LLVM side.  Delegates to
// mangle.IsInstantiationName (the single source for the marker check).
func RecvTypeIsGenericInst(recvName *[]readonly char) bool {
	return mangle.IsInstantiationName(recvName)
}
