package "pkg/binate/native/common"

import "pkg/binate/asm"

// Per-package reflect.Package descriptor — the data half, shared by the
// native backends.  This is the native counterpart to the LLVM backend's
// emit_pkg_descriptor.bn / emit_static_managed.bn; the two MUST agree on the
// symbol names and the static-managed layout, because the descriptor's
// `_Package()` accessor is referenced cross-mode (e.g. the bytecode VM's
// RegisterStandardExterns takes `*func() @reflect.Package = rt._Package`).
// Keeping the layout in one shared place — consumed by both arch backends —
// is the bound on that LLVM/native drift.

// STATIC_MANAGED_REFCOUNT mirrors rt.STATIC_REFCOUNT (ifaces/core/
// pkg/builtins/rt.bni) and the LLVM backend's identically-named constant
// (pkg/binate/codegen/emit_static_managed.bn): the sentinel Refcount in an
// immortal static-managed header.  A negative refcount marks an object that
// RefInc/RefDec must never count or free.  Mirrored rather than imported
// because cross-package const-folding of rt.STATIC_REFCOUNT isn't available
// at codegen time.  Keep in sync with rt.bni + the codegen copy.
const STATIC_MANAGED_REFCOUNT int = -1073741824

// EmitPackageDescriptorData lays the module's reflect.Package descriptor node
// into the data section: a 2-word managed header (Refcount = the negative
// static sentinel, FreeFn = 0) immediately followed by the reflect.Package
// payload `{ Name.data -> pkgNameSym, Name.len = len(nameBytes) }`, then the
// package-name bytes at pkgNameSym.  The layout matches the LLVM backend's
// emitStaticManagedGlobal: a by-pointer consumer takes the payload pointer
// (node + the 2 header words) and treats it as `@reflect.Package`, so the
// header sits exactly that far behind it, where RefInc/RefDec read the
// Refcount.  64-bit word layout (the native backends are aarch64 / x86-64).
// Both symbols are made global so the cross-section relocations (the
// accessor's address-of-node, and Name.data -> name bytes) resolve the same
// way emitGlobalAddr's do; the per-arch caller emits the exported `_Package`
// accessor returning node + 2 words.
func EmitPackageDescriptorData(a @asm.Assembler, pkgInfoSym *[]readonly char,
		pkgNameSym *[]readonly char, nameBytes *[]readonly char,
		funcsArraySym *[]readonly char, funcCount int) {
	a.SetSection("data", -1)
	a.DefineLabel(pkgInfoSym)
	a.SetGlobal(pkgInfoSym)
	// Managed header: Refcount = static sentinel, FreeFn = null.
	a.EmitUint64(cast(uint64, cast(int64, STATIC_MANAGED_REFCOUNT)))
	a.EmitUint64(cast(uint64, 0))
	// reflect.Package payload { Name, Functions } — two raw slices.
	// Name.data is an absolute relocation to the name bytes (linker fills
	// the final address — same fixup shape vtable slots use).
	a.AddFixup(pkgNameSym, 0, 0, 8)
	a.Fill(8, cast(uint8, 0))
	a.EmitUint64(cast(uint64, len(nameBytes)))
	// Functions raw slice { data, len }.  Points at the FunctionInfo pointer
	// array (emitted by EmitFunctionsArray) when the module has exported
	// funcs; otherwise the empty slice {null, 0}.  Field order matches
	// reflect.Package (Name then Functions then Globals).
	if funcCount > 0 {
		a.AddFixup(funcsArraySym, 0, 0, 8)
		a.Fill(8, cast(uint8, 0))
		a.EmitUint64(cast(uint64, funcCount))
	} else {
		a.EmitUint64(cast(uint64, 0))
		a.EmitUint64(cast(uint64, 0))
	}
	// Globals raw slice { data, len } — the empty slice {null, 0} until the
	// globals emitter populates it (must stay in field order with
	// reflect.Package, after Functions).
	a.EmitUint64(cast(uint64, 0))
	a.EmitUint64(cast(uint64, 0))
	// The name bytes — exactly len(nameBytes), no NUL (the slice carries
	// its own length).
	a.DefineLabel(pkgNameSym)
	a.SetGlobal(pkgNameSym)
	for i := 0; i < len(nameBytes); i++ {
		a.EmitUint8(cast(uint8, nameBytes[i]))
	}
	a.Align(8)
}
