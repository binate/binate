package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// dataSecIdx returns the index of the assembler's "data" section, or -1.
func dataSecIdx(a @asm.Assembler) int {
	for i := 0; i < a.NumSections; i++ {
		var nm @[]char = a.Sections[i].Name
		if len(nm) == 4 && nm[0] == 'd' && nm[1] == 'a' &&
				nm[2] == 't' && nm[3] == 'a' {
			return i
		}
	}
	return -1
}

// EmitPackageDescriptorData must lay the static-managed reflect.Package node
// in the exact layout the LLVM backend's emitStaticManagedGlobal produces, so
// a by-pointer @reflect.Package consumer finds the sentinel refcount two words
// behind the payload.  Pins that contract (it's what must not drift between
// the two backends): 64-bit node = { RC sentinel, FreeFn=0, Name.data->sym,
// Name.len } followed by the name bytes, 8-byte aligned, both labels defined.
func TestEmitPackageDescriptorDataLayout() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	EmitPackageDescriptorData(a, "_info", "_name", "pkg/x")

	if a.LookupSymbol("_info") < 0 { return "node label _info not defined" }
	if a.LookupSymbol("_name") < 0 { return "name label _name not defined" }

	var di int = dataSecIdx(a)
	if di < 0 { return "no data section emitted" }
	// header(16) + Name(16) + Functions(16) + 5 name bytes = 53 -> Align(8) -> 56.
	if a.Sections[di].Len != 56 { return "data section size should be 56" }
	// Name.data carries a relocation to the name label.
	if a.Sections[di].NumFixups < 1 { return "missing Name.data relocation" }

	var data @[]uint8 = a.SectionData(di)
	// Refcount sentinel -1073741824 = 0xFFFFFFFF_C0000000, little-endian.
	if data[3] != cast(uint8, 0xC0) || data[4] != cast(uint8, 0xFF) {
		return "first word is not the static-managed refcount sentinel"
	}
	// FreeFn word (offset 8) is null.
	if data[8] != cast(uint8, 0) || data[15] != cast(uint8, 0) {
		return "FreeFn word should be zero"
	}
	// Name.len (offset 24, low byte) = len("pkg/x") = 5.
	if cast(int, data[24]) != 5 { return "Name.len should be 5" }
	// Functions raw slice (offset 32 = data, 40 = len) is empty {0, 0}.
	if data[32] != cast(uint8, 0) || data[40] != cast(uint8, 0) {
		return "Functions slice should be empty {null, 0}"
	}
	// Name bytes follow the 48-byte node: "pkg/x".
	if data[48] != cast(uint8, 'p') || data[52] != cast(uint8, 'x') {
		return "name bytes not laid after the node"
	}
	return ""
}

// An empty package name (nameLen 0) still lays a valid node: the header + the
// {Name, Functions} payload total exactly 48 bytes (a multiple of 8), so the
// trailing Align(8) is a no-op and there are no name bytes.  (The LLVM
// reference emits the [0 x i8] name global as zeroinitializer.)
func TestEmitPackageDescriptorDataEmptyName() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	EmitPackageDescriptorData(a, "_ei", "_en", "")
	if a.LookupSymbol("_ei") < 0 { return "node label not defined (empty name)" }
	if a.LookupSymbol("_en") < 0 { return "name label not defined (empty name)" }
	var di int = dataSecIdx(a)
	if di < 0 { return "no data section (empty name)" }
	if a.Sections[di].Len != 48 {
		return "empty-name node should be exactly 48 bytes"
	}
	return ""
}
