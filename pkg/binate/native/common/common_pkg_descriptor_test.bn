package "pkg/binate/native/common"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for common_pkg_descriptor.bn — the shared reflect-descriptor gather
// helpers both native arches call (the descriptor's byte layout is built + unit-
// tested in ir; this covers the backend-neutral payload-scalar / name helpers).

// vtCharsEq compares an owned @[]char against a literal — a local helper so the
// name-building tests don't depend on a cross-package string-equal.
func vtCharsEq(a @[]char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// FuncRetbufSize: 0 for void / scalar, the aggregate retbuf size otherwise.
func TestFuncRetbufSize() testing.TestResult {
	// FuncRetbufSize rides types.AggregateReturnSize, which is
	// target-dependent (the ILP32 sret threshold differs from LP64), so
	// pin the 64-bit layout these size assertions assume rather than rely
	// on the ambient target a prior test may have changed.
	setTarget64()
	var noParams @[]@types.Param
	var noResults @[]@types.Type
	var fvVoid @types.Type = types.MakeFuncValueType(noParams, noResults)
	if FuncRetbufSize(fvVoid) != 0 {
		return "void result size should be 0"
	}
	// FuncRetbufSize is the aggregate RETBUF size (0 for a scalar return), not
	// the raw byte size: a scalar int64 returns in a register, so 0.
	var r1 @[]@types.Type = make_slice(@types.Type, 1)
	r1[0] = types.TypInt64()
	var fv1 @types.Type = types.MakeFuncValueType(noParams, r1)
	if FuncRetbufSize(fv1) != 0 {
		return "scalar int64 result has no retbuf (size 0)"
	}
	// A <= 8-byte NAMED struct is returned via the coerced retbuf shim, so its
	// retbuf size is nonzero (8) even though it fits in a register.
	var sf @[]@types.Field = make_slice(@types.Field, 1)
	var fld @types.Field = make(types.Field)
	fld.Type = types.TypInt64()
	sf[0] = fld
	var s8 @[]@types.Type = make_slice(@types.Type, 1)
	s8[0] = types.MakeStructType("S8", sf)
	var fvS8 @types.Type = types.MakeFuncValueType(noParams, s8)
	if FuncRetbufSize(fvS8) != 8 {
		return "<=8-byte named struct returns via retbuf (size 8)"
	}
	// Multi-return: the tuple is aggregate; (int64, int64) is a 16-byte retbuf.
	var r2 @[]@types.Type = make_slice(@types.Type, 2)
	r2[0] = types.TypInt64()
	r2[1] = types.TypInt64()
	var fv2 @types.Type = types.MakeFuncValueType(noParams, r2)
	if FuncRetbufSize(fv2) != 16 {
		return "(int64,int64) multi-return retbuf size should be 16"
	}
	return ""
}

// ImplVtableBareName builds the canonical unprefixed `__ivt.` decoration on
// a bn_V core — the VM's findIfaceVtable / lookupVtableAddr key.
func TestImplVtableBareName() testing.TestResult {
	var n @[]char = ImplVtableBareName("pkg/std/strings", "Builder",
		"pkg/std/io", "Writer")
	if !vtCharsEq(n,
			"__ivt.bn_V3_3_pkg3_std7_strings7_Builder3_3_pkg3_std2_io6_Writer") {
		return "unexpected bare vtable name"
	}
	return ""
}

// RecvTypeIsGenericInst detects the __bn_inst__ monomorphization marker (such
// impls are excluded from the descriptor — they re-lower at the importer).
func TestRecvTypeIsGenericInst() testing.TestResult {
	if !RecvTypeIsGenericInst("G__bn_inst__int") {
		return "should detect a generic instantiation"
	}
	if RecvTypeIsGenericInst("Builder") {
		return "a plain receiver name is not a generic instantiation"
	}
	return ""
}
