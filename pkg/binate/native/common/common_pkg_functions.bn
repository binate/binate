package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/types"

// FunctionInfo-table data layout for the per-package reflect descriptor — the
// native counterpart to codegen's emit_pkg_functions.bn (B0 step 3b-ii of
// plan-package-introspection-phase-b.md).  The byte layout here is the ABI the
// LLVM emitter, both native backends, and the descriptor-consuming VM share;
// the per-arch callers (x64/aarch64 _pkg_descriptor.bn) gather the exported
// funcs and resolve the per-arch symbol names, then drive these emitters.
//
// 64-bit only (the native backends are aarch64 / x86-64), matching
// EmitPackageDescriptorData's 64-bit node layout.  Pointer fields are absolute
// relocations (AddFixup kind 0); a field that points at a static-managed
// PAYLOAD carries a +16 addend to skip the node's two header words.

// EmitFunctionInfoNode emits, into the data section, one reflect.FunctionInfo:
// the Name + Sig rodata byte arrays, then the immortal static-managed node
// (2-word header + the 8-word payload).  Payload field order matches
// reflect.bni: Pkg, Name(data,len), Value, ResultSize, ParamSlots, Sig(data,
// len).  `pkgInfoSym` is the package descriptor node (Pkg points at its
// payload); `handleSym` is the `@__handle.<mangled>` function-value block
// (Value); `nodeSym` / `nameSym` / `sigSym` are this entry's symbols.
func EmitFunctionInfoNode(a @asm.Assembler, pkgInfoSym *[]readonly char,
		nodeSym *[]readonly char, nameSym *[]readonly char,
		name *[]readonly char, sigSym *[]readonly char, sig *[]readonly char,
		handleSym *[]readonly char, resultSize int, paramSlots int) {
	a.SetSection("data", -1)
	// Name + Sig rodata (byte arrays, no NUL — the slices carry their len), and
	// the node, must use the SAME linkage as the LLVM emitter so a cross-backend
	// link agrees on these symbols: for an instantiation's reflect entry (an
	// IsLinkOnce func, e.g. a generic dtor) the same defining-package-qualified
	// `<func>__fnname`/`__fnsig`/`__fninfo` are emitted into EVERY consumer's
	// object.  The name/sig are referenced only by this object's node, so they
	// are LOCAL (LLVM `private`); the node is WEAK (LLVM `weak_odr`) so the
	// linker MERGES the cross-object copies instead of rejecting duplicate
	// strong definitions.  Strong-global here would be a link-time duplicate
	// symbol once two objects share an instantiation.
	a.DefineLabel(nameSym)
	for i := 0; i < len(name); i++ {
		a.EmitUint8(cast(uint8, name[i]))
	}
	a.DefineLabel(sigSym)
	for i := 0; i < len(sig); i++ {
		a.EmitUint8(cast(uint8, sig[i]))
	}
	// The node — 8-byte aligned (it holds 8-byte words).
	a.Align(8)
	a.DefineLabel(nodeSym)
	a.SetWeak(nodeSym)
	// Managed header: Refcount = static sentinel, FreeFn = null.
	a.EmitUint64(bit_cast(uint64, cast(int64, STATIC_MANAGED_REFCOUNT)))
	a.EmitUint64(cast(uint64, 0))
	// Pkg @Package -> the package node's PAYLOAD (node + 16 header bytes).
	a.AddFixup(pkgInfoSym, 0, 16, 8)
	a.Fill(8, cast(uint8, 0))
	// Name { data -> nameSym, len }.
	a.AddFixup(nameSym, 0, 0, 8)
	a.Fill(8, cast(uint8, 0))
	a.EmitUint64(cast(uint64, len(name)))
	// Value -> @__handle.<mangled> (the function-value block; no header).
	a.AddFixup(handleSym, 0, 0, 8)
	a.Fill(8, cast(uint8, 0))
	// ResultSize, ParamSlots.
	a.EmitUint64(cast(uint64, resultSize))
	a.EmitUint64(cast(uint64, paramSlots))
	// Sig { data -> sigSym, len }.
	a.AddFixup(sigSym, 0, 0, 8)
	a.Fill(8, cast(uint8, 0))
	a.EmitUint64(cast(uint64, len(sig)))
}

// EmitFunctionsArray emits the `funcsArraySym` pointer array (the backing
// store for reflect.Package.Functions, a *[]@FunctionInfo raw slice): one
// 8-byte pointer per FunctionInfo node, to that node's PAYLOAD (node + the two
// header words).  Caller passes the node symbols in declaration order.
func EmitFunctionsArray(a @asm.Assembler, funcsArraySym *[]readonly char,
		nodeSyms @[]@[]char) {
	a.SetSection("data", -1)
	a.Align(8)
	a.DefineLabel(funcsArraySym)
	a.SetGlobal(funcsArraySym)
	for i := 0; i < len(nodeSyms); i++ {
		a.AddFixup(nodeSyms[i], 0, 16, 8)
		a.Fill(8, cast(uint8, 0))
	}
}

// FuncResultSize returns the VM-dispatch ResultSize for a func-value type: the
// aggregate retbuf byte size (rounded to N*8) when the function returns via a
// retbuf, or 0 for a scalar / void return — a nonzero value is the
// scalar-vs-aggregate discriminator AND the retbuf byte count.  Delegates to
// the shared types.AggregateReturnSize (= codegen's functionResultSize) so both
// backends and the VM agree on the shim shape.
func FuncResultSize(fv @types.Type) int {
	if fv == nil { return 0 }
	return types.AggregateReturnSize(fv.Results)
}
