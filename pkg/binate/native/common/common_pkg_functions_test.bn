package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/types"
import "pkg/builtins/testing"

// EmitFunctionInfoNode must lay the Name + Sig rodata then an 8-byte-aligned
// static-managed node (16-byte header + 64-byte payload), with four pointer
// fixups in the payload (Pkg, Name.data, Value, Sig.data).  dataSecIdx comes
// from common_pkg_descriptor_test.bn (same package).
func TestEmitFunctionInfoNode() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	EmitFunctionInfoNode(a, "_info", "_node", "_nm", "abc", "_sg", "()",
		"_h", 8, 1)

	if a.LookupSymbol("_node") < 0 { return "node label not defined" }
	if a.LookupSymbol("_nm") < 0 { return "name rodata label not defined" }
	if a.LookupSymbol("_sg") < 0 { return "sig rodata label not defined" }

	var di int = dataSecIdx(a)
	if di < 0 { return "no data section emitted" }
	// name(3) + sig(2) = 5 -> Align(8) -> 8, + node(16 header + 64 payload).
	if a.Sections[di].Len != 88 {
		return "expected 88 bytes (rodata + pad + 80-byte node)"
	}
	// Four pointer fields carry relocations: Pkg, Name.data, Value, Sig.data.
	if a.Sections[di].NumFixups != 4 {
		return "expected 4 node fixups (Pkg, Name, Value, Sig)"
	}
	return ""
}

// EmitFunctionsArray must lay one 8-byte pointer per node symbol, each a
// relocation to the node's payload.
func TestEmitFunctionsArray() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var syms @[]@[]char = make_slice(@[]char, 2)
	syms[0] = "_n0"
	syms[1] = "_n1"
	EmitFunctionsArray(a, "_arr", syms)

	if a.LookupSymbol("_arr") < 0 { return "array label not defined" }
	var di int = dataSecIdx(a)
	if di < 0 { return "no data section emitted" }
	if a.Sections[di].Len != 16 { return "expected 16 bytes (2 pointers)" }
	if a.Sections[di].NumFixups != 2 { return "expected 2 array fixups" }
	return ""
}

// FuncResultSize: 0 for void, SizeOf for a single result.
func TestFuncResultSize() testing.TestResult {
	var noParams @[]@types.Param
	var noResults @[]@types.Type
	var fvVoid @types.Type = types.MakeFuncValueType(noParams, noResults)
	if FuncResultSize(fvVoid) != 0 {
		return "void result size should be 0"
	}
	var r1 @[]@types.Type = make_slice(@types.Type, 1)
	r1[0] = types.TypInt64()
	var fv1 @types.Type = types.MakeFuncValueType(noParams, r1)
	if FuncResultSize(fv1) != 8 {
		return "int64 result size should be 8"
	}
	return ""
}
