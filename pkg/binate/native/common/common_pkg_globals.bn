package "pkg/binate/native/common"

import "pkg/binate/asm"

// GlobalInfo-table data layout for the per-package reflect descriptor — the
// native counterpart to codegen's emit_pkg_globals.bn (the global-injection
// descriptor surface).  The byte layout here is the ABI the LLVM emitter, both
// native backends, and the descriptor-consuming VM share; the per-arch callers
// (x64/aarch64 _pkg_descriptor.bn) gather the exported globals and resolve the
// per-arch symbol names, then drive these emitters.
//
// 64-bit only (the native backends are aarch64 / x86-64), matching
// EmitPackageDescriptorData's node layout.  Pointer fields are absolute
// relocations (AddFixup kind 0); a field that points at a static-managed
// PAYLOAD carries a +16 addend to skip the node's two header words, but the
// Addr field targets a `var` storage cell directly (addend 0 — no header,
// unlike FunctionInfo.Value, which targets a static-managed handle).

// EmitGlobalInfoNode emits, into the data section, one reflect.GlobalInfo: the
// FULLY-QUALIFIED Name rodata byte array, then the immortal static-managed node
// (2-word header + the { Name(data,len), Addr } payload).  Payload field order
// matches reflect.bni: Name, Addr.  `globalSym` is the global's storage cell
// symbol (Addr); `name` is its fully-qualified name (lookupGlobalAddr's key);
// `nodeSym` / `nameSym` are this entry's symbols.
func EmitGlobalInfoNode(a @asm.Assembler, nodeSym *[]readonly char,
		nameSym *[]readonly char, name *[]readonly char,
		globalSym *[]readonly char) {
	a.SetSection("data", -1)
	// Name rodata (byte array, no NUL — the slice carries its len).
	a.DefineLabel(nameSym)
	a.SetGlobal(nameSym)
	for i := 0; i < len(name); i++ {
		a.EmitUint8(cast(uint8, name[i]))
	}
	// The node — 8-byte aligned (it holds 8-byte words).
	a.Align(8)
	a.DefineLabel(nodeSym)
	a.SetGlobal(nodeSym)
	// Managed header: Refcount = static sentinel, FreeFn = null.
	a.EmitUint64(cast(uint64, cast(int64, STATIC_MANAGED_REFCOUNT)))
	a.EmitUint64(cast(uint64, 0))
	// Name { data -> nameSym, len }.
	a.AddFixup(nameSym, 0, 0, 8)
	a.Fill(8, cast(uint8, 0))
	a.EmitUint64(cast(uint64, len(name)))
	// Addr -> the global's storage cell (a `var` cell; no static-managed
	// header, so the relocation has addend 0).
	a.AddFixup(globalSym, 0, 0, 8)
	a.Fill(8, cast(uint8, 0))
}

// EmitGlobalsArray emits the `globalsArraySym` pointer array (the backing store
// for reflect.Package.Globals, a *[]@GlobalInfo raw slice): one 8-byte pointer
// per GlobalInfo node, to that node's PAYLOAD (node + the two header words).
// Caller passes the node symbols in declaration order.
func EmitGlobalsArray(a @asm.Assembler, globalsArraySym *[]readonly char,
		nodeSyms @[]@[]char) {
	a.SetSection("data", -1)
	a.Align(8)
	a.DefineLabel(globalsArraySym)
	a.SetGlobal(globalsArraySym)
	for i := 0; i < len(nodeSyms); i++ {
		a.AddFixup(nodeSyms[i], 0, 16, 8)
		a.Fill(8, cast(uint8, 0))
	}
}
