package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// EmitGlobalInfoNode lays one static-managed reflect.GlobalInfo: the FQ-name
// rodata, then a 2-word managed header + the { Name(data,len), Addr } payload
// (40-byte node).  dataSecIdx lives in common_pkg_descriptor_test.bn.
func TestEmitGlobalInfoNodeLayout() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	// FQ name "pkg/x.Sentinel" (14 bytes); Addr targets storage symbol "_g".
	EmitGlobalInfoNode(a, "_gni", "_gnm", "pkg/x.Sentinel", "_g")

	if a.LookupSymbol("_gni") < 0 { return "node label _gni not defined" }
	if a.LookupSymbol("_gnm") < 0 { return "name label _gnm not defined" }

	var di int = dataSecIdx(a)
	if di < 0 { return "no data section emitted" }
	var data @[]uint8 = a.SectionData(di)
	// name bytes (14) -> Align(8) -> 16, then node: header(16) +
	// Name{data,len}(16) + Addr(8) = 40.  Total = 16 + 40 = 56.
	if a.Sections[di].Len != 56 { return "data section size should be 56" }
	// Node starts at offset 16 (after the aligned 14-byte name); its first word
	// is the static-managed refcount sentinel 0xFFFFFFFF_C0000000.
	if data[19] != cast(uint8, 0xC0) || data[20] != cast(uint8, 0xFF) {
		return "node header is not the static refcount sentinel"
	}
	// Name.len at node offset 24 (= section offset 40) = len("pkg/x.Sentinel").
	if cast(int, data[40]) != 14 { return "Name.len should be 14" }
	// Two relocations: Name.data -> nameSym and Addr -> the storage symbol.
	if a.Sections[di].NumFixups < 2 {
		return "expected Name.data + Addr relocations"
	}
	return ""
}

// EmitGlobalsArray lays one 8-byte pointer per GlobalInfo node (to its payload,
// node + 16 header bytes), with a relocation per entry.
func TestEmitGlobalsArrayLayout() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var nodeSyms @[]@[]char = make_slice(@[]char, 2)
	nodeSyms[0] = "_n0"
	nodeSyms[1] = "_n1"
	EmitGlobalsArray(a, "_arr", nodeSyms)

	if a.LookupSymbol("_arr") < 0 { return "array label _arr not defined" }
	var di int = dataSecIdx(a)
	if di < 0 { return "no data section emitted" }
	// Two 8-byte pointer slots = 16 bytes, one relocation each.
	if a.Sections[di].Len != 16 { return "array should be two 8-byte slots" }
	if a.Sections[di].NumFixups < 2 { return "expected one relocation per entry" }
	return ""
}
