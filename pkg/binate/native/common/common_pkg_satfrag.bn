package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/stdx/slices"

// EmitPkgSatFrag lays this module's `_pkg_satfrag` graph node — the native half
// of the decentralized satentry enumeration (the LLVM half is codegen's
// emitPkgSatFrag).  Emitted for EVERY package, AFTER the descriptor so this
// module's own `_pkg_satentries` (which the node points at) is already defined.
// The node carries entriesPtr (= `_pkg_satentries`, or null when the package has
// no satentries and thus emits no backing array) + ownCount, then symrefs to its
// DIRECT dependencies' `_pkg_satfrag` nodes.  Each dep frag is SetGlobal (a
// STRONG undefined ref): every compiled package emits a node, so the ref always
// resolves; and a strong ref pulls the defining object from a static archive
// (the opaque-binary-distribution goal) and fails loud if a dependency ever
// emits no node, rather than silently dropping its satentries.  Mirrors
// EmitSatEntryRoot's SetGlobal-declared deps (no auto-declare pass exists).
//
// `prefix` is the object-format linkage prefix ("" ELF / "_" Mach-O), applied so
// the node's symbol and its cross-object dep symrefs match the LLVM-compiled
// dependency objects (clang prepends the same '_').
func EmitPkgSatFrag(a @asm.Assembler, prefix *[]readonly char, mod @ir.Module) {
	var pkgName *[]readonly char = StripQuotes(mod.Name)
	var fragSym @[]char = buf.Concat(prefix, mangle.GlobalName(pkgName, "_pkg_satfrag"))
	var entriesSym @[]char = buf.Concat(prefix, mangle.GlobalName(pkgName, "_pkg_satentries"))
	var ownCount int = len(ir.CollectSatEntries(mod))

	// Direct-dependency frag symbols from the EFFECTIVE import set
	// (mod.ImportAliasPaths — includes the compiler-injected rt/lang/expose-closure,
	// so a primitive's lang-provided satentries stay reachable), deduped so a path
	// reached via two aliases yields one edge, and with this module's own path
	// skipped (a self-edge would be a strong ref to fragSym, defined here).
	var depFragSyms @[]@[]char
	for i := 0; i < len(mod.ImportAliasPaths); i++ {
		if pathSeenAt(mod.ImportAliasPaths, i) { continue }
		if sameCharSlice(mod.ImportAliasPaths[i], pkgName) { continue }
		var depSym @[]char = buf.Concat(prefix,
				mangle.GlobalName(mod.ImportAliasPaths[i], "_pkg_satfrag"))
		a.SetGlobal(depSym)
		depFragSyms = slices.Append[@[]char](depFragSyms, depSym)
	}

	var dgs @[]@irdata.DataGlobal = irdata.BuildPkgSatFrag(fragSym, entriesSym, ownCount, depFragSyms)
	for i := 0; i < len(dgs); i++ {
		EmitDataGlobal(a, dgs[i])
	}
	return
}

// pathSeenAt reports whether paths[idx] already appears at a lower index — a
// first-occurrence dedup so a package imported under two aliases yields one edge.
func pathSeenAt(paths @[]@[]char, idx int) bool {
	for i := 0; i < idx; i++ {
		if sameCharSlice(paths[i], paths[idx]) { return true }
	}
	return false
}

// sameCharSlice reports whether two char slices are byte-equal.
func sameCharSlice(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
