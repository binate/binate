package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for common_pkg_satfrag.bn (the native half of the decentralized satentry
// enumeration).  Prefix "" (ELF-style, no Mach-O '_') keeps emitted symbols equal
// to their bare mangled names, so LookupSymbol can find them.

// mkFragModule builds a `main` module whose effective import set is two
// dependency packages, used to exercise EmitPkgSatFrag's dep-edge seeding.
func mkFragModule() @ir.Module {
	var m @ir.Module = ir.NewModule("\"main\"")
	var paths @[]@[]char
	paths = slices.Append[@[]char](paths, "pkg/dep0")
	paths = slices.Append[@[]char](paths, "pkg/dep1")
	m.ImportAliasPaths = paths
	return m
}

// EmitPkgSatFrag defines this module's STRONG `_pkg_satfrag` node and, for each
// direct dependency, a WEAK empty DEFINITION (the overridable fallback) — so this
// object links standalone even when the dep's object is absent, while the dep's
// own strong node overrides the fallback wherever both are linked.
func TestEmitPkgSatFragNative() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	EmitPkgSatFrag(a, "", mkFragModule())

	var fragSym int = a.LookupSymbol(mangle.GlobalName("main", "_pkg_satfrag"))
	if fragSym < 0 { return "own _pkg_satfrag node not defined" }
	if a.Symbols[fragSym].Binding != asm.BIND_GLOBAL { return "own node should be strong (global)" }

	// Each dep frag is a WEAK DEFINITION (Section >= 0), not a strong undefined
	// reference (Section == -1) — that is what lets the object link standalone.
	var dep0 int = a.LookupSymbol(mangle.GlobalName("pkg/dep0", "_pkg_satfrag"))
	if dep0 < 0 { return "dep0 _pkg_satfrag fallback not emitted" }
	if a.Symbols[dep0].Binding != asm.BIND_WEAK {
		return "dep0 _pkg_satfrag fallback should be weak"
	}
	if a.Symbols[dep0].Section < 0 {
		return "dep0 _pkg_satfrag fallback should be a definition, not an undefined ref"
	}
	var dep1 int = a.LookupSymbol(mangle.GlobalName("pkg/dep1", "_pkg_satfrag"))
	if dep1 < 0 { return "dep1 _pkg_satfrag fallback not emitted" }
	if a.Symbols[dep1].Binding != asm.BIND_WEAK {
		return "dep1 _pkg_satfrag fallback should be weak"
	}
	if a.Symbols[dep1].Section < 0 {
		return "dep1 _pkg_satfrag fallback should be a definition, not an undefined ref"
	}
	return ""
}

// Every package emits its node even with no deps (a graph waypoint), so a
// dependency-free module still defines `_pkg_satfrag`.
func TestEmitPkgSatFragNoDeps() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var a @asm.Assembler = asm.New(8)
	EmitPkgSatFrag(a, "", m)
	if a.LookupSymbol(mangle.GlobalName("main", "_pkg_satfrag")) < 0 {
		return "a dependency-free module should still define its _pkg_satfrag node"
	}
	return ""
}

// A dep entry equal to the module's own path is skipped (a self-edge would emit a
// weak fallback DEFINITION of the very symbol this object already defines strong —
// a duplicate label); real deps still get their weak fallback.
func TestEmitPkgSatFragSkipsSelf() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var paths @[]@[]char
	paths = slices.Append[@[]char](paths, "main") // self — must be skipped
	paths = slices.Append[@[]char](paths, "pkg/dep0")
	m.ImportAliasPaths = paths
	var a @asm.Assembler = asm.New(8)
	EmitPkgSatFrag(a, "", m)
	var own int = a.LookupSymbol(mangle.GlobalName("main", "_pkg_satfrag"))
	if own < 0 {
		return "own node should be defined even when self appears in imports"
	}
	if a.Symbols[own].Binding != asm.BIND_GLOBAL {
		return "own node should stay strong (not demoted to a weak fallback) when self is in imports"
	}
	var dep0 int = a.LookupSymbol(mangle.GlobalName("pkg/dep0", "_pkg_satfrag"))
	if dep0 < 0 { return "the real dep should still get its fallback when self is skipped" }
	if a.Symbols[dep0].Binding != asm.BIND_WEAK {
		return "the real dep should be a weak fallback definition"
	}
	return ""
}
