package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/mangle"

// VtableInfo-table data layout for the per-package reflect descriptor — the
// native counterpart to codegen's emit_pkg_vtables.bn (the interface-impl
// vtable injection surface).  The byte layout here is the ABI the LLVM emitter,
// both native backends, and the descriptor-consuming VM share; the per-arch
// callers (x64/aarch64 _pkg_descriptor.bn) gather the package's impl vtables and
// resolve the per-arch symbol names, then drive these emitters.
//
// Structurally identical to common_pkg_globals.bn (VtableInfo and GlobalInfo
// share a {Name, Addr} layout): the Addr field targets the `@__ivt` vtable
// global directly (addend 0 — a constant array, no static-managed header).
// 64-bit only, matching EmitPackageDescriptorData's node layout.

// ImplVtableBareName builds the canonical, UNPREFIXED vtable name (the
// `__ivt.` decoration on a bn_V core) — the form the bytecode VM keys on
// (findIfaceVtable / lookupVtableAddr / BC_IFACE_VALUE), identical across
// IR-gen, the LLVM codegen, and VM lowering.  Delegates to
// mangle.ImplVtableName (the single source of truth); the native backends'
// object symbols add a format-specific prefix (Mach-O `_`) on top, while the
// descriptor's VtableInfo.Name stores this BARE form so the VM lookup matches
// regardless of which backend compiled the package.
func ImplVtableBareName(recvPkg *[]readonly char, recvTypeName *[]readonly char,
		ifacePkg *[]readonly char, ifaceName *[]readonly char) @[]char {
	return mangle.ImplVtableName(recvPkg, recvTypeName, ifacePkg, ifaceName)
}

// RecvTypeIsGenericInst reports whether an impl's receiver type name is a
// monomorphized generic instantiation (carries the `__bn_inst__` marker).  Such
// impls re-lower at any bytecode importer's use site, so they are NOT injected
// by name — the native descriptor excludes them, matching emit_pkg_vtables.bn's
// recvTypeIsGenericInst on the LLVM side.  Delegates to
// mangle.IsInstantiationName (the single source for the marker check).
func RecvTypeIsGenericInst(recvName *[]readonly char) bool {
	return mangle.IsInstantiationName(recvName)
}

// EmitVtableInfoNode emits, into the data section, one reflect.VtableInfo: the
// mangled Name rodata byte array, then the immortal static-managed node (2-word
// header + the { Name(data,len), Addr, ShimAddr } payload).  Payload field
// order matches reflect.bni: Name, Addr, ShimAddr.  `vtableSym` is the `@__ivt`
// vtable global symbol (Addr); `shimSym` is the parallel `@__ivtshim` shim
// vtable global symbol (ShimAddr, method slots hold method handles); `name` is
// its mangled lookup name (lookupVtableAddr's key); `nodeSym` / `nameSym` are
// this entry's symbols.
func EmitVtableInfoNode(a @asm.Assembler, nodeSym *[]readonly char,
		nameSym *[]readonly char, name *[]readonly char,
		vtableSym *[]readonly char, shimSym *[]readonly char) {
	a.SetSection("data", -1)
	// Name rodata (byte array, no NUL — the slice carries its len).
	a.DefineLabel(nameSym)
	a.SetGlobal(nameSym)
	for i := 0; i < len(name); i++ {
		a.EmitUint8(cast(uint8, name[i]))
	}
	// The node — 8-byte aligned (it holds 8-byte words).
	a.Align(8)
	a.DefineLabel(nodeSym)
	a.SetGlobal(nodeSym)
	// Managed header: Refcount = static sentinel, FreeFn = null.
	a.EmitUint64(bit_cast(uint64, cast(int64, STATIC_MANAGED_REFCOUNT)))
	a.EmitUint64(cast(uint64, 0))
	// Name { data -> nameSym, len }.
	a.AddFixup(nameSym, 0, 0, 8)
	a.Fill(8, cast(uint8, 0))
	a.EmitUint64(cast(uint64, len(name)))
	// Addr -> the `@__ivt` vtable global (a constant array; no static-managed
	// header, so the relocation has addend 0).
	a.AddFixup(vtableSym, 0, 0, 8)
	a.Fill(8, cast(uint8, 0))
	// ShimAddr -> the parallel `@__ivtshim` vtable global (same shape: a
	// constant array, no header, addend 0).
	a.AddFixup(shimSym, 0, 0, 8)
	a.Fill(8, cast(uint8, 0))
}

// EmitVtablesArray emits the `vtablesArraySym` pointer array (the backing store
// for reflect.Package.Vtables, a *[]@VtableInfo raw slice): one 8-byte pointer
// per VtableInfo node, to that node's PAYLOAD (node + the two header words).
// Caller passes the node symbols in declaration order.
func EmitVtablesArray(a @asm.Assembler, vtablesArraySym *[]readonly char,
		nodeSyms @[]@[]char) {
	a.SetSection("data", -1)
	a.Align(8)
	a.DefineLabel(vtablesArraySym)
	a.SetGlobal(vtablesArraySym)
	for i := 0; i < len(nodeSyms); i++ {
		a.AddFixup(nodeSyms[i], 0, 16, 8)
		a.Fill(8, cast(uint8, 0))
	}
}
