package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Tests for common_pkg_vtables.bn — the native reflect.VtableInfo table (the
// interface-impl vtable injection surface).  dataSecIdx lives in
// common_pkg_descriptor_test.bn.

// vtCharsEq compares an owned @[]char against a literal — a local helper so the
// name-building tests don't depend on a cross-package string-equal.
func vtCharsEq(a @[]char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// EmitVtableInfoNode lays one static-managed reflect.VtableInfo: the bare-name
// rodata, then a 2-word header + { Name(data,len), Addr, ShimAddr } payload.
func TestEmitVtableInfoNodeLayout() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	// bare name "__ivt.bn_x" (10 bytes); Addr -> "_ivt", ShimAddr -> "_ivtshim".
	EmitVtableInfoNode(a, "_vni", "_vnm", "__ivt.bn_x", "_ivt", "_ivtshim")

	if a.LookupSymbol("_vni") < 0 { return "node label _vni not defined" }
	if a.LookupSymbol("_vnm") < 0 { return "name label _vnm not defined" }

	var di int = dataSecIdx(a)
	if di < 0 { return "no data section emitted" }
	// name(10) -> Align(8) -> 16, then node: header(16) + Name{data,len}(16) +
	// Addr(8) + ShimAddr(8) = 48.  Total = 16 + 48 = 64.
	if a.Sections[di].Len != 64 { return "data section size should be 64" }
	// Three relocations: Name.data, Addr, ShimAddr.
	if a.Sections[di].NumFixups < 3 {
		return "expected Name.data + Addr + ShimAddr relocations"
	}
	return ""
}

// EmitVtablesArray lays one 8-byte pointer per VtableInfo node, one reloc each.
func TestEmitVtablesArrayLayout() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var nodeSyms @[]@[]char = make_slice(@[]char, 2)
	nodeSyms[0] = "_v0"
	nodeSyms[1] = "_v1"
	EmitVtablesArray(a, "_varr", nodeSyms)

	if a.LookupSymbol("_varr") < 0 { return "array label _varr not defined" }
	var di int = dataSecIdx(a)
	if di < 0 { return "no data section emitted" }
	if a.Sections[di].Len != 16 { return "array should be two 8-byte slots" }
	if a.Sections[di].NumFixups < 2 { return "expected one relocation per entry" }
	return ""
}

// ImplVtableBareName builds the canonical unprefixed __ivt.bn_<R>__<I> name —
// the VM's findIfaceVtable / lookupVtableAddr key.
func TestImplVtableBareName() testing.TestResult {
	var n @[]char = ImplVtableBareName("pkg/std/strings", "Builder",
		"pkg/std/io", "Writer")
	if !vtCharsEq(n,
			"__ivt.bn_pkg__std__strings__Builder__pkg__std__io__Writer") {
		return "unexpected bare vtable name"
	}
	return ""
}

// RecvTypeIsGenericInst detects the __bn_inst__ monomorphization marker (such
// impls are excluded from the descriptor — they re-lower at the importer).
func TestRecvTypeIsGenericInst() testing.TestResult {
	if !RecvTypeIsGenericInst("G__bn_inst__int") {
		return "should detect a generic instantiation"
	}
	if RecvTypeIsGenericInst("Builder") {
		return "a plain receiver name is not a generic instantiation"
	}
	return ""
}
