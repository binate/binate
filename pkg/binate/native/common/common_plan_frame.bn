package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/inplace"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/containers/vec"
import "pkg/std/strings"

// PlanFrame assigns a stack slot to every function parameter and to every
// value-producing SSA instruction that needs one (needsSpillSlot: not a value the
// register allocator homes for its whole life, which never touches a slot, one a fold
// elides, nor one with bytes of its own, regionPlan), and to every indirect call where
// the backend keeps the call's target in the call's slot (StashesCallTarget), void
// ones and ones with bytes of their own included.  It
// runs after AllocateRegisters / AllocateFpRegisters; values whose live spans they
// recorded, and aggregate values (whose spans it computes, noteAggregateSpans), share
// spill slots where the spans do not meet (planSharedSpills).
// f must have no phis (EliminatePhis has run), as for the register allocators: the
// data regions' spans come from the same liveness (regionSpans).
// Returns the 16-byte-aligned total
// frame size (also cached on m.FrameSize).  Sizes and offsets are int64 (a
// 64-bit target's frame may pass a 32-bit host's int), summed saturating; a frame
// past the target's address space sets m.FrameTooLarge, which the backend reports
// (CheckFrameFits).
//
// Slot sizes:
//   - OP_ALLOC: its type's size rounded up to a word, at its type's alignment, each at
//     least a word's (allocaSlotBytes).  One with a scope shares bytes with the slots
//     whose scopes it never meets (placeSharedAllocas).
//   - Aggregate-producing OPs whose SSA value is a *pointer* to a
//     dedicated data region (OP_MAKE_SLICE; aggregate OP_CONST_NIL):
//     a Typ.Size() data region (via AllocIDs) and no spill slot, the value being
//     the region's address (regionPlan).  A region whose span is known shares bytes
//     with the regions whose spans it never meets (regionSpans, placeSharedRegions).
//     An aggregate value with no bytes of its own (a member extracted from another,
//     a load read in place) has a word-sized slot holding their address, shared by the
//     value's own live span like a scalar's (noteAggregateSpans).
//   - Multi-return calls (OP_CALL returning TYP_STRUCT):
//     N*8-byte spill slot so X0..X(N-1) can be packed at slot + 8*i.
//   - Aggregate params whose bytes arrive in registers: a data region,
//     into which the callee prologue writes the N arg-reg words, and no
//     spill slot.  A zero-size aggregate param: a zero-byte data region and no spill
//     slot.  Any other param: a spill slot sized as below.
//   - Everything else that needs a slot: a word, or 8 bytes for a value wider than a
//     word (spillSlotBytes: a 64-bit scalar on a 32-bit target), at an offset aligned
//     to its size.  Each area starts 8-aligned.
func (m @RegMap) PlanFrame(f @ir.Func) int64 {
	// Walk every call in f to find the largest outgoing-args area
	// any single call needs. That region sits at [sp+0..outgoing) so
	// the caller can write stack args without disturbing its own SP.
	// Spill/alloc offsets are shifted up by `outgoing` below.
	var outgoing int64 = 0
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if !isCallOp(ins.Op) {
				continue
			}
			// OP_C_CALL variadic args may need extra stack
			// reservation on darwin-arm64 (Apple stacks every
			// vararg); fixedCount = len for OP_CALL so the V-variant
			// sizing reduces to the base helper there.
			// callDispatchArgTypesAnyOp handles each call op's
			// arg-shape (direct vs func-value vs indirect-ptr) —
			// must include func-value / handle / indirect, or the
			// outgoing-args area won't be reserved for those calls
			// and closure-struct locals overlap with outgoing args
			// at the call site (the 523_closure_many_user_args
			// bug).
			var argTypes @[]@types.Type = callDispatchArgTypesAnyOp(m.CC, ins)
			var fixedCount int = len(argTypes)
			if ins.Op == iropcode.OP_C_CALL {
				fixedCount = ins.CFixedArgs
				if len(argTypes) > len(ins.Args) {
					// Sret pointer was prepended — it's a fixed
					// (non-variadic) leading arg; shift the
					// caller-supplied fixed/variadic split up by 1.
					fixedCount = fixedCount + 1
				}
			}
			var callCC callconv.CallConv = m.CC
			// callIsVariadic: OP_C_CALL's authoritative CVariadic flag (not the
			// fixedCount<len inference — a zero-trailing-vararg call is variadic yet
			// leaves fixedCount==len).  Drives the per-CALL AAPCS-VFP float->GP
			// reclassification in the outgoing-args sizing, matching the emitter.
			var callIsVariadic bool = ins.Op == iropcode.OP_C_CALL && ins.CVariadic
			var sb int64 = callCC.CallStackBytesV(argTypes, fixedCount, callIsVariadic)
			if sb > outgoing { outgoing = sb }
		}
	}
	m.OutgoingArgsSize = outgoing
	m.SretSlotOff = -1
	m.RetbufSlotID = -1
	m.MultiReturnType = f.MultiReturnType
	m.FrameTooLarge = false
	var offset int64 = outgoing

	// Callee-saved save area (set by AllocateRegisters; 0 when the register
	// allocator was not run).  Placed just above the outgoing-args region and
	// inside the frame, so the prologue's fp/lr push and x29 chain are
	// untouched and the incoming stack-arg base (frameSize + 16) self-adjusts.
	m.SavedRegsOff = offset
	offset = frameAdd(offset, cast(int64, m.SavedRegsBytes))

	// FP callee-saved save area (set by AllocateFpRegisters), laid down right
	// above the GP save area.  Both are 16-aligned, so their sum keeps the frame
	// aligned.  Zero (no-op) until the FP pass runs.
	m.SavedFpRegsOff = offset
	offset = frameAdd(offset, cast(int64, m.SavedFpRegsBytes))

	// If f returns a single aggregate larger than the internal sret
	// threshold (cc.InternalSretBytes — 16 on AAPCS64), or a multi-
	// return tuple with more fields than the return registers hold
	// (MultiReturnTupleNeedsSret, whatever its size), AAPCS-style sret:
	// the caller hands a buffer pointer in X8, the callee writes
	// the result through it. We stash X8 in a hidden word-sized slot at
	// function entry so emitReturn can load it back.
	if m.CC.FuncReturnsBigAggregate(f) || m.CC.FuncReturnsBigMultiReturn(f) {
		m.SretSlotOff = offset
		offset = frameAdd(offset, cast(int64, m.CC.WordBytes))
	}

	// Parameters come first so entry-point register stores can find
	// their slots by ID. Aggregate (slice) params are passed spread
	// across multiple arg registers; we reserve a data region for the
	// bytes, whose address is the parameter's value (getOperand), and
	// no spill slot.  Every other parameter has a spill slot (slotBytesOf),
	// where the prologue lands it (or, for an aggregate whose bytes
	// arrive in memory the callee owns, their address).
	// The slot tables grow with the function, so they are built with amortized
	// appends and stored back once at the end.
	var allocIDs @vec.Vec[int] = intVecFrom(m.AllocIDs)
	var allocSizes @vec.Vec[int64] = int64VecFrom(m.AllocSizes)
	var allocOffsets @vec.Vec[int64] = int64VecFrom(m.AllocOffsets)
	var spillIDs @vec.Vec[int] = intVecFrom(m.SpillIDs)
	var spillOffsets @vec.Vec[int64] = int64VecFrom(m.SpillOffsets)
	var paramSpill @[]int64 = make_slice(int64, len(f.Params))
	var inPlace @[]int = inplace.InPlaceParamSlots(f)
	var targets @[]bool = indirectCallTargets(f)
	// One index of f's uses serves the slot analyses below.
	var fu @inplace.FuncUses = inplace.NewFuncUses(f)
	var placed @[]int = fu.CallResultSlots(inPlace)
	var sharedIDs @vec.Vec[int] = vec.New[int]()
	var sharedSizes @vec.Vec[int64] = vec.New[int64]()
	var sharedAligns @vec.Vec[int64] = vec.New[int64]()
	var toRetbuf @[]bool
	if m.CC.FuncReturnsBigAggregate(f) { toRetbuf = inplace.ReturnedCallResults(f) }
	var rbSlot int = -1
	var rbLoads @[]bool
	if m.CC.FuncReturnsBigAggregate(f) { rbSlot, rbLoads = fu.RetbufLocal(inPlace) }
	var rbLoadIDs @vec.Vec[int] = vec.New[int]()
	var lastUse @[]bool = fu.LastUseArgLoads()
	if copyStatsOn { m.CopyStatsUse = LoadConsumers(f) }
	var lastUseIDs @vec.Vec[int] = vec.New[int]()
	cts, cbase := m.paramClassifyTypes(f)
	m.SplitSaveBytes = m.splitSaveBytes(cts)
	var inPlaceIDs @vec.Vec[int] = vec.New[int]()
	var inPlaceParams @vec.Vec[int] = vec.New[int]()
	for pi := 0; pi < len(f.Params); pi++ {
		var p @ir.Param = f.Params[pi]
		// A zero-size aggregate parameter has no bytes, so no prologue writes anything
		// for it: its value is the address of a zero-byte data region, which nothing reads
		// through (as nothing reads through any zero-size value), and it has no slot.  It
		// takes no argument word, so it never arrives in memory the callee owns, and no
		// local is used in place of it (paramInCallerMemory).
		if callconv.IsAggregateTyp(p.Typ) && p.Typ.Size() <= 0 {
			allocIDs.Push(p.ID)
			allocSizes.Push(0)
			allocOffsets.Push(offset)
			paramSpill[pi] = -1
			continue
		}
		// A parameter whose bytes arrive in memory the callee owns
		// (paramInCallerMemory) uses them as its value: no region of its own.
		if callconv.IsAggregateTyp(p.Typ) && !m.paramInCallerMemory(cts, cbase + pi) {
			var dataSz int64 = p.Typ.Size()
			if dataSz > 0 {
				// Round up to an 8-byte multiple, as the aggregate-value
				// data-region branches below do.  Two
				// reasons: (1) emitSpillAggregateParam writes ArgWords whole
				// words (ceil(Size/WordBytes)) into this region, so a
				// sub-word-tail struct (five-u8 = 5 bytes = 2 words) needs 8
				// bytes reserved or the last word-store runs past the region;
				// (2) a non-8-multiple advance leaves `offset` — and thus
				// EVERY later frame slot — mis-aligned.  On arm32 that
				// mis-aligns the pointers built from those slots (`add rN,
				// sp, #odd`), and a downstream deref hits an
				// unaligned/out-of-bounds address → Data Abort → the
				// bare-metal default vector loops forever.
				dataSz = roundUp8(dataSz)
				offset = roundUp8(offset)
				allocIDs.Push(p.ID)
				allocSizes.Push(dataSz)
				allocOffsets.Push(offset)
				offset = frameAdd(offset, dataSz)
				// Its value is the region's address (getOperand): no spill slot.
				paramSpill[pi] = -1
				continue
			}
		}
		var paramSlot int64 = slotBytesOf(p.Typ, m.CC.WordBytes)
		offset = roundUpPow2(offset, paramSlot)
		spillIDs.Push(p.ID)
		spillOffsets.Push(offset)
		paramSpill[pi] = offset
		offset = frameAdd(offset, paramSlot)
	}
	offset = roundUp8(offset)
	// Aggregate values' live hulls: their pointer slots share by them (noteAggregateSpans,
	// planSharedSpills), their data regions by their alias closures' (placeSharedRegions).
	var cfg @LiveCFG = m.liveCFGOf(f)
	aggLo, aggHi := aggregateHulls(f, cfg, m.CC.WordBytes,
			UnionFusable(m.FusableGep, m.FusableFieldGep))
	m.noteAggregateSpans(f, aggLo, aggHi)
	// Where each aggregate value's bytes live is settled first: a value with bytes of its
	// own needs no spill slot (regionPlan).
	var rp @regionPlan = m.planRegions(f, fu, toRetbuf, rbSlot, rbLoads, lastUse, placed)
	for id := 0; id < len(lastUse); id++ {
		if lastUse[id] { lastUseIDs.Push(id) }
	}
	m.LastUseLoads = lastUseIDs.Items()
	// The calls' argument regions, placed with the data regions (placeSharedRegions).
	var copies @argCopyPlan = m.collectArgCopies(f, cfg, rp.owns)
	shared, sharedPast := m.planSharedSpills(f, targets, rp.owns, spillIDs, spillOffsets, offset)
	offset = sharedPast

	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			var slotOf int = -1
			if ins.Op == iropcode.OP_ALLOC && ins.ID >= 0 && ins.ID < len(inPlace) {
				slotOf = inPlace[ins.ID]
			}
			if slotOf >= 0 && m.paramInCallerMemory(cts, cbase + slotOf) &&
					!(inplace.IsCaptureParam(f, slotOf) && m.CC.PassesIndirect(f.Params[slotOf].Typ)) {
				// The parameter's slot is its incoming copy (inplace.InPlaceParamSlots): no
				// region; its value is the parameter's pointer, read from the
				// parameter's spill slot.  A capture passed as a pointer into the
				// closure record keeps a slot of its own.
				spillIDs.Push(ins.ID)
				spillOffsets.Push(paramSpill[slotOf])
				inPlaceIDs.Push(ins.ID)
				inPlaceParams.Push(f.Params[slotOf].ID)
			} else if ins.Op == iropcode.OP_ALLOC && ins.ID == rbSlot {
				// The local the function returns lives in the caller's buffer
				// (inplace.RetbufLocal): no region; its value is the buffer's pointer, read
				// from the sret slot.
				spillIDs.Push(ins.ID)
				spillOffsets.Push(m.SretSlotOff)
				m.RetbufSlotID = ins.ID
			} else if ins.Op == iropcode.OP_ALLOC {
				sz, align := m.allocaSlotBytes(ins)
				if ins.Scope > 0 {
					// Laid down after the walk, sharing bytes by scope.
					sharedIDs.Push(ins.ID)
					sharedSizes.Push(sz)
					sharedAligns.Push(align)
				} else {
					offset = roundUpPow2(offset, align)
					allocIDs.Push(ins.ID)
					allocSizes.Push(sz)
					allocOffsets.Push(offset)
					offset = frameAdd(offset, sz)
				}
			} else if ins.ID >= 0 &&
					(!InstrIsVoid(ins) || m.StashesCallTarget && callconv.IsIndirectCallOp(ins.Op)) {
				// An indirect call has a slot even when it is void where the backend keeps
				// the callee there while it places the arguments (StashesCallTarget: x64,
				// whose scratch R11 is in the pool the argument loop allocates from).  A
				// value with bytes of its own (rp.owns) has none: it is read as their
				// address (needsSpillSlot).
				if !m.needsSpillSlot(ins, targets, rp.owns) || (ins.ID < len(shared) && shared[ins.ID]) {
					continue
				}
				// Multi-return calls reserve enough contiguous bytes
				// for the entire tuple so X0..X(N-1) can land at
				// Offset(tuple, i). Named struct returns have
				// data regions instead (regionPlan), so
				// we key on IsMultiReturnCall rather than bare
				// TYP_STRUCT. The byte count is tuple.Size()
				// — fields can themselves be aggregates (e.g. a
				// multi-return of `(Tab, int)` where Tab is 5 words)
				// so 8 * field-count would under-allocate.  Any other value's
				// slot is spillSlotBytes long.
				var slotSz int64 = m.spillSlotBytes(ins)
				if callconv.IsMultiReturnCall(ins) {
					slotSz = roundUp8(ins.Typ.Size())
					if slotSz < 8 { slotSz = 8 }
				}
				if slotSz >= 8 { offset = roundUp8(offset) }
				spillIDs.Push(ins.ID)
				spillOffsets.Push(offset)
				offset = frameAdd(offset, slotSz)
			}
		}
	}
	offset = roundUp8(offset)
	offset = placeSharedRegions(f, aggLo, aggHi, rp.regionIDs, rp.regionSizes, copies, allocIDs,
			allocSizes, allocOffsets, offset)
	m.noteArgCopies(copies)
	// Before placeCallResults, which gives a call writing into a slot that slot's offset.
	offset = placeSharedAllocas(f, cfg, sharedIDs, sharedSizes, sharedAligns, placed, allocIDs,
			allocSizes, allocOffsets, offset)
	offset = m.placeCallResults(placed, rp.placedCalls, rp.placedSizes, rp.placedToRetbuf,
			rp.retbufCalls, allocIDs, allocSizes, allocOffsets, offset)
	m.RetbufCalls = rp.retbufCalls.Items()
	// Every returned load is recorded, an elided one (inplace.AggLoadElision: no region
	// either way) too, so no return copies the buffer onto itself.
	for id := 0; m.RetbufSlotID >= 0 && id < len(rbLoads); id++ {
		if rbLoads[id] { rbLoadIDs.Push(id) }
	}
	m.RetbufLoads = rbLoadIDs.Items()
	m.AllocIDs = allocIDs.Items()
	m.AllocSizes = allocSizes.Items()
	m.AllocOffsets = allocOffsets.Items()
	m.SpillIDs = spillIDs.Items()
	m.SpillOffsets = spillOffsets.Items()
	m.InPlaceSlotIDs = inPlaceIDs.Items()
	m.InPlaceSlotParams = inPlaceParams.Items()
	reportUnplacedOwner(m.unplacedOwner(rp.owns))
	var size int64 = roundUpPow2(offset, 16)
	// A saturated size (frameAdd) is the int64 maximum, which no frame rounded to 16
	// can be, so it is too large even where it does not pass types.FrameLimit.
	m.FrameTooLarge = size > types.FrameLimit() || size == frameSaturated
	m.FrameSize = size
	return size
}

// frameSaturated is the value a frame size or offset saturates to (the int64
// maximum) instead of wrapping: frameAdd, roundUpPow2.
const frameSaturated int64 = 0x7FFFFFFFFFFFFFFF

// frameAdd returns a + b for frame sizes and offsets a, b >= 0, saturating at
// frameSaturated instead of wrapping.
func frameAdd(a int64, b int64) int64 {
	if b > frameSaturated - a { return frameSaturated }
	return a + b
}

// roundUp8 rounds the frame size n >= 0 up to a multiple of 8 (saturating).
func roundUp8(n int64) int64 {
	return roundUpPow2(n, 8)
}

// roundUpPow2 rounds n >= 0 up to a multiple of the power of two p (saturating at
// frameSaturated).
func roundUpPow2(n int64, p int64) int64 {
	if n > frameSaturated - (p - 1) { return frameSaturated }
	return (n + (p - 1)) & ~(p - 1)
}

// CheckFrameFits reports whether the frame PlanFrame planned for m, the frame of the
// function named name, fits the target (FrameTooLarge), recording an error on a when
// it does not: a function whose frame passes the target's address space is a compile
// error.
func CheckFrameFits(a @asm.Assembler, m @RegMap, name *[]readonly char) bool {
	if !m.FrameTooLarge { return true }
	reportFrameTooLarge(a, "", name)
	return false
}

// CheckShimFrameFits reports whether a shim's frame of size bytes fits the target,
// recording an error naming the function the shim calls when it does not.
func CheckShimFrameFits(a @asm.Assembler, size int64, target *[]readonly char) bool {
	if size <= types.FrameLimit() { return true }
	reportFrameTooLarge(a, "the shim of ", target)
	return false
}

// reportFrameTooLarge records on a that the frame of what, then name, is larger than the
// target allows.
func reportFrameTooLarge(a @asm.Assembler, what *[]readonly char, name *[]readonly char) {
	var msg @strings.Builder = strings.NewBuilder()
	msg.Write("the frame of ")
	msg.Write(what)
	msg.Write(name)
	msg.Write(" is larger than the target allows (at most ")
	stringutils.WriteInt64(msg, types.FrameLimit())
	msg.Write(" bytes)")
	a.SetError(msg.String())
}

// instrHasDataRegion reports whether ins produces an aggregate value that PlanFrame
// gives a data region of its own (the value is then the region's address, regionPlan):
// a made slice, an aggregate load that is copied (loadKind, its inplace.AggLoadElision), an
// aggregate nil, a read-only-data array or managed-slice copy, a function or interface
// value, an interface upcast, or the aggregate result of a call that is not a
// multi-value return.
func instrHasDataRegion(ins @ir.Instr, loadKind int) bool {
	if ins.Typ == nil { return false }
	var agg bool = callconv.IsAggregateTyp(ins.Typ)
	var op int = ins.Op
	if op == iropcode.OP_MAKE_SLICE || op == iropcode.OP_FUNC_VALUE || op == iropcode.OP_IFACE_VALUE ||
			op == iropcode.OP_IFACE_UPCAST {
		return true
	}
	if !agg { return false }
	if op == iropcode.OP_LOAD { return loadKind == inplace.AGG_LOAD_COPIED }
	if op == iropcode.OP_CONST_NIL || op == iropcode.OP_RODATA_ARRAY ||
			op == iropcode.OP_RODATA_MSLICE_COPY || op == iropcode.OP_C_CALL {
		return true
	}
	if op == iropcode.OP_CALL || op == iropcode.OP_CALL_FUNC_VALUE ||
			op == iropcode.OP_CALL_IFACE_METHOD {
		return !callconv.IsMultiReturnCall(ins)
	}
	return false
}

// IsInPlaceOverlapping reports whether the aggregate OP_LOAD value id was planned
// inplace.AGG_LOAD_IN_PLACE_OVERLAPPING (m.InPlaceOverlapping).
func (m @RegMap) IsInPlaceOverlapping(id int) bool {
	return id >= 0 && id < len(m.InPlaceOverlapping) && m.InPlaceOverlapping[id]
}
