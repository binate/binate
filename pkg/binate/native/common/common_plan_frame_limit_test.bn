package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// The frame PlanFrame lays out is held to the target's address space (frameLimit,
// spec §21.4): sizes and offsets are int64 and summed saturating, a frame past the
// limit sets FrameTooLarge, and CheckFrameFits reports it, naming the function.

// localsFunc returns a function "f" with one byte-array local of each size.
func localsFunc(sizes @[]int64) @ir.Func {
	var f @ir.Func = ir.NewFunc("", "f", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	for i := 0; i < len(sizes); i++ {
		irbuild.EmitAlloc(b, types.MakeArrayType(types.TypUint8(), sizes[i]))
	}
	irbuild.EmitReturn(b, makeNoInstrs())
	return f
}

// planFrame32 plans f's frame for a 32-bit (AAPCS32) target.
func planFrame32(f @ir.Func) @RegMap {
	setTarget32()
	var m @RegMap = NewRegMap(callconv.AAPCS32())
	m.PlanFrame(f)
	setTarget64()
	return m
}

// On a 32-bit target a frame may fill the address space: two 1.75 GiB locals lay out
// exactly (the second at 1.75 GiB), as does one local of the largest type's size
// beside the rest of the frame; a frame of 0xFFFFFFF0 bytes fits, the next multiple
// of 16 does not.
func TestPlanFrameHeldToAddressSpace32() testing.TestResult {
	var f @ir.Func = localsFunc(@[]int64{0x70000000, 0x70000000})
	var m @RegMap = planFrame32(f)
	if m.FrameTooLarge || m.FrameSize != 0xE0000000 ||
			m.LookupAlloc64(f.Blocks[0].Instrs[1].ID) != 0x70000000 {
		return "two 1.75 GiB locals should lay out exactly on a 32-bit target"
	}
	if planFrame32(localsFunc(@[]int64{0x7FFFFFF0, 8})).FrameTooLarge {
		return "a local of nearly 2^31 bytes should fit a 32-bit target's frame"
	}
	var full @RegMap = planFrame32(localsFunc(@[]int64{0x7FFFFFF8, 0x7FFFFFF8}))
	if full.FrameTooLarge || full.FrameSize != 0xFFFFFFF0 {
		return "a 0xFFFFFFF0-byte frame should fit"
	}
	var over @RegMap = planFrame32(localsFunc(@[]int64{0x7FFFFFF8, 0x7FFFFFF8, 8}))
	if !over.FrameTooLarge { return "a frame past 2^32 should be too large for a 32-bit target" }
	var a @asm.Assembler = asm.New(4)
	if CheckFrameFits(a, over, "main.f") || !a.HasError || !charsContainCommon(a.ErrorMsg, "main.f") {
		return "CheckFrameFits should report a frame past the address space, naming the function"
	}
	var b @asm.Assembler = asm.New(4)
	if !CheckFrameFits(b, full, "main.f") || b.HasError {
		return "CheckFrameFits should accept a frame that fits"
	}
	return ""
}

// On a 64-bit target the same two locals lay out exactly too.
func TestPlanFrameHeldToAddressSpace64() testing.TestResult {
	setTarget64()
	var f @ir.Func = localsFunc(@[]int64{0x70000000, 0x70000000})
	var m @RegMap = nrm()
	var size int64 = m.PlanFrame(f)
	if m.FrameTooLarge || size != 0xE0000000 ||
			m.LookupAlloc64(f.Blocks[0].Instrs[1].ID) != 0x70000000 {
		return "two 1.75 GiB locals should lay out exactly on a 64-bit target"
	}
	return ""
}

// Sizes and offsets past the int64 maximum saturate rather than wrap: a frame of two
// near-maximal locals is too large instead of wrapping to a small size, and the
// rounding saturates too.
func TestPlanFrameSaturates() testing.TestResult {
	setTarget64()
	var m @RegMap = nrm()
	var size int64 = m.PlanFrame(localsFunc(@[]int64{0x7000000000000000, 0x7000000000000000}))
	if !m.FrameTooLarge || size != frameSaturated {
		return "an overflowing frame should saturate and be too large"
	}
	if frameAdd(frameSaturated - 4, 8) != frameSaturated || frameAdd(16, 8) != 24 {
		return "frameAdd should saturate, and add below the limit"
	}
	if roundUpPow2(frameSaturated - 3, 16) != frameSaturated || roundUpPow2(17, 16) != 32 ||
			roundUpPow2(32, 16) != 32 || roundUpPow2(0, 16) != 0 {
		return "roundUpPow2 should round up exactly, and saturate past the limit"
	}
	return ""
}

// charsContainCommon reports whether s holds sub.
func charsContainCommon(s *[]readonly char, sub *[]readonly char) bool {
	for i := 0; i + len(sub) <= len(s); i++ {
		var k int = 0
		for k < len(sub) && s[i + k] == sub[k] { k = k + 1 }
		if k == len(sub) { return true }
	}
	return false
}
