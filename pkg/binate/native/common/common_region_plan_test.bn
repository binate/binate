package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/native/callconv"
import "pkg/binate/native/inplace"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for common_region_plan.bn: where PlanFrame puts each aggregate value's bytes,
// and the spill slots that follow from it.

// planRegions marks the values with bytes of their own -- call results with data
// regions -- and lists the regions in order; a member extracted from one owns none.
func TestPlanRegionsMarksOwners() testing.TestResult {
	setTarget64()
	f, e := regionFunc()
	var a @ir.Instr = mkQuad(e)
	var x @ir.Instr = mkMember(e)
	readField(e, a)
	readField(e, x)
	irbuild.EmitReturn(e, elisionNoRets())
	var pair @ir.Instr = x.Args[0]
	var none @[]bool
	var fu @inplace.FuncUses = inplace.NewFuncUses(f)
	var m @RegMap = nrm()
	var rp @regionPlan = m.planRegions(f, fu, none, -1, none, none,
			fu.CallResultSlots(inplace.InPlaceParamSlots(f)))
	if !rp.owns[a.ID] || !rp.owns[pair.ID] { return "a call result owns its region" }
	if rp.owns[x.ID] { return "a member owns no bytes" }
	if rp.regionIDs.Len() != 2 || rp.regionIDs.Get(0) != a.ID || rp.regionIDs.Get(1) != pair.ID {
		return "the regions are listed in order"
	}
	if rp.regionSizes.Get(0) != 32 || rp.regionSizes.Get(1) != 64 {
		return "a region is its value's size"
	}
	return ""
}

// A call writing its result into a slot owns the slot's bytes, so it has no spill
// slot.
func TestPlanFramePlacedCallHasNoSpillSlot() testing.TestResult {
	setTarget64()
	f, e, c, s := resultSlotFunc()
	irbuild.EmitLoad(e, irbuild.EmitGetFieldPtr(e, s, 0, types.TypInt()), types.TypInt())
	irbuild.EmitReturn(e, elisionNoRets())
	var m @RegMap = nrm()
	m.PlanFrame(f)
	if m.CallResultSlot(c.ID) != s.ID { return "setup: the call writes its result into s" }
	if m.LookupAlloc(c.ID) < 0 { return "the call's result region is the slot's" }
	if m.LookupSpill(c.ID) >= 0 { return "a call writing into a slot has no spill slot" }
	return ""
}

// A value reading bytes it does not own keeps a slot holding their address: a load
// read in place, and a call writing the caller's buffer.
func TestPlanFrameNonOwnersKeepSpillSlots() testing.TestResult {
	setTarget64()
	var t @types.Type = types.MakeArrayType(types.TypInt(), 2)
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(t))
	var dst @ir.Instr = irbuild.EmitAlloc(e, t)
	var v @ir.Instr = irbuild.EmitLoad(e, irbuild.EmitLoad(e, p, types.MakePointerType(t)), t)
	irbuild.EmitStore(e, dst, v)
	irbuild.EmitReturn(e, elisionNoRets())
	var m @RegMap = nrm()
	m.PlanFrame(f)
	if inplace.AggLoadElision(f, v) != inplace.AGG_LOAD_IN_PLACE {
		return "setup: the load is read in place"
	}
	if m.LookupAlloc(v.ID) >= 0 || m.LookupSpill(v.ID) < 0 {
		return "a load read in place has no region and keeps its slot"
	}
	f = ir.NewFunc("", "t", elisionNoParams(), quadResults())
	e = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitCall(e, "mk", noInstrs(), elisionQuadTyp())
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = c
	irbuild.EmitReturn(e, rets)
	m = nrm()
	m.PlanFrame(f)
	if !m.CallResultToRetbuf(c.ID) { return "setup: the call writes the caller's buffer" }
	if m.LookupAlloc(c.ID) >= 0 || m.LookupSpill(c.ID) < 0 {
		return "a call writing the caller's buffer has no region and keeps its slot"
	}
	return ""
}

// An indirect call with bytes of its own keeps its slot only for the call itself, where
// the backend keeps the call's target there while it places the arguments
// (StashesCallTarget: x64), so the slot's span is that one position: two such calls
// whose results are live at once share one slot.  With no stash it has no slot.
func TestPlanFrameOwningIndirectCallSlotIsItsCall() testing.TestResult {
	setTarget64()
	f, e := regionFunc()
	var dp @ir.Instr = irbuild.EmitConstInt(e, 0, types.MakePointerType(types.TypUint8()))
	var ivTyp @types.Type = make(types.Type)
	ivTyp.Kind = types.TYP_INTERFACE_VALUE
	var iv @ir.Instr = irbuild.EmitIfaceValue(e, dp, "__ivt.bn_test__T__test__I", ivTyp)
	var noCallArgs @[]@ir.Instr
	var a @ir.Instr = irbuild.EmitCallIfaceMethod(e, iv, noCallArgs, 1, elisionQuadTyp())
	var b @ir.Instr = irbuild.EmitCallIfaceMethod(e, iv, noCallArgs, 1, elisionQuadTyp())
	readField(e, a)
	readField(e, b)
	irbuild.EmitReturn(e, elisionNoRets())
	var n @RegMap = nrm()
	n.PlanFrame(f)
	if n.LookupSpill(a.ID) >= 0 { return "with no stash an owning indirect call has no slot" }
	var m @RegMap = nrm()
	m.StashesCallTarget = true
	m.PlanFrame(f)
	if m.LookupAlloc(a.ID) < 0 || m.LookupAlloc(b.ID) < 0 { return "setup: the results have regions" }
	if m.LookupAlloc(a.ID) == m.LookupAlloc(b.ID) { return "setup: the results are live at once" }
	if m.LookupSpill(a.ID) < 0 || m.LookupSpill(a.ID) != m.LookupSpill(b.ID) {
		return "the calls' slots, each used only by its call, are one"
	}
	return ""
}

// unplacedOwner finds nothing when every value counted as owning its bytes got a region
// -- as PlanFrame, which checks it, leaves them -- and names one that has none.
func TestUnplacedOwner() testing.TestResult {
	setTarget64()
	f, e := regionFunc()
	var a @ir.Instr = mkQuad(e)
	var x @ir.Instr = readField(e, a)
	irbuild.EmitReturn(e, elisionNoRets())
	var m @RegMap = nrm()
	m.PlanFrame(f)
	var owns @[]bool = make_slice(bool, f.NextID)
	owns[a.ID] = true
	if m.unplacedOwner(owns) != -1 { return "an owner PlanFrame placed has a region" }
	owns[x.ID] = true
	if m.unplacedOwner(owns) != x.ID { return "an owner with no region is named" }
	return ""
}

// Where the backend keeps an indirect call's target in the call's slot (StashesCallTarget),
// a void indirect call's slot is used by that call alone, so two of them share one.
func TestPlanFrameVoidIndirectCallsShareTheStash() testing.TestResult {
	setTarget64()
	f, e := regionFunc()
	var fnPtr @ir.Instr = irbuild.EmitConstInt(e, 0, types.TypInt())
	var noArgs @[]@ir.Instr
	var c1 @ir.Instr = irbuild.EmitCallIndirect(e, fnPtr, noArgs, types.TypVoid())
	var c2 @ir.Instr = irbuild.EmitCallIndirect(e, fnPtr, noArgs, types.TypVoid())
	irbuild.EmitReturn(e, elisionNoRets())
	var m @RegMap = NewRegMap(callconv.SysV_AMD64())
	m.StashesCallTarget = true
	m.PlanFrame(f)
	if m.LookupSpill(c1.ID) < 0 || m.LookupSpill(c1.ID) != m.LookupSpill(c2.ID) {
		return "two void indirect calls' stashes share one slot"
	}
	return ""
}
