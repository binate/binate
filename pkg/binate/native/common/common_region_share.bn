package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/inplace"
import "pkg/std/containers/vec"

// Data regions shared by lifetime.  An aggregate value given a data region of its own
// (instrHasDataRegion) has its bytes written by the instruction defining it and read
// through its pointer: by its uses, and by the uses of every value that passes the
// pointer on -- an aggregate alias (inplace.IsAggregateAlias: an aggregate member extracted, an
// aggregate cast or managed-to-raw conversion) -- transitively.  (There are no aggregate
// phis to pass it on: EliminatePhis rejects them.)  The liveness of aggregate values
// (REGCLASS_AGG), over the positions the register allocator's liveness uses, gives each
// such value an interval; a region is in use over the hull of its value's and its
// aliases' intervals, from the write at the definition to the last read, and regions
// whose spans never meet share bytes (placeSharedRegions), as do the calls' argument
// regions (collectArgCopies), each in use only at its call's position.

// aggregateHulls returns, indexed by value id, the live hull of each aggregate value of
// f -- the start and end of its interval (buildHulls) in the liveness of aggregate values
// (REGCLASS_AGG) over f's LiveCFG cfg, with the GEPs the backend folds into their loads
// and stores (fusable, as the GP allocator's liveness has them), whose bases are read at
// the load or store -- or -1 for a value with none; both empty for a function with no
// aggregate values.
func aggregateHulls(f @ir.Func, cfg @LiveCFG, wordBytes int, fusable @[]bool) (@[]int, @[]int) {
	var empty @[]int
	if !hasAggregateValue(f) { return empty, empty }
	return buildHulls(f, computeLivenessOn(f, cfg, wordBytes, fusable, REGCLASS_AGG))
}

// hasAggregateValue reports whether an instruction of f has an aggregate value.
func hasAggregateValue(f @ir.Func) bool {
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if ins.ID >= 0 && callconv.IsAggregateTyp(ins.Typ) { return true }
		}
	}
	return false
}

// regionSpans returns, indexed by value id, the [start, end) span over which the data
// region of each aggregate value of f is in use -- the hull of the live hulls (lo / hi,
// from aggregateHulls) of the value and of the values that alias it -- or -1 for a
// value whose span is not known: one the liveness gives no interval, or one that an
// instruction uses in a way not known to stay where the instruction stands
// (readsInPlace), which might pass a pointer into its bytes on.  (A value defined and
// never used has an interval at its definition, which writes its region.)  f must have
// no phis (EliminatePhis has run).
func regionSpans(f @ir.Func, lo @[]int, hi @[]int) (@[]int, @[]int) {
	var n int = f.NextID
	var starts @[]int = make_slice(int, n)
	var ends @[]int = make_slice(int, n)
	for i := 0; i < n; i++ {
		starts[i] = -1
		ends[i] = -1
		if i < len(lo) && i < len(hi) {
			starts[i] = lo[i]
			ends[i] = hi[i]
		}
	}
	var unknown @[]bool = make_slice(bool, n)
	for i := 0; i < n; i++ { unknown[i] = starts[i] < 0 }
	// Alias edges, as pairs (the operand, the value passing its pointer on), in the order
	// of the instructions defining the second.
	var edges @vec.Vec[int] = vec.New[int]()
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			for k := 0; k < len(ins.Args); k++ {
				var a @ir.Instr = ins.Args[k]
				if a == nil || a.ID < 0 || a.ID >= n || !callconv.IsAggregateTyp(a.Typ) { continue }
				if k == 0 && ins.ID >= 0 && ins.ID < n && inplace.IsAggregateAlias(ins) {
					edges.Push(a.ID)
					edges.Push(ins.ID)
				} else if !readsInPlace(ins) {
					unknown[a.ID] = true
				}
			}
		}
	}
	// A value's span covers its aliases'; one unknown makes it unknown.  An alias mostly
	// follows its operand, so the edges are taken last to first, which carries a chain
	// in one pass; a block listed before the one defining an alias's operand can hold
	// the alias, so this runs until nothing changes.
	var changed bool = true
	for changed {
		changed = false
		for e := edges.Len() - 2; e >= 0; e = e - 2 {
			var p int = edges.Get(e)
			var c int = edges.Get(e + 1)
			if unknown[c] {
				if !unknown[p] {
					unknown[p] = true
					changed = true
				}
				continue
			}
			if unknown[p] { continue }
			if starts[c] < starts[p] {
				starts[p] = starts[c]
				changed = true
			}
			if ends[c] > ends[p] {
				ends[p] = ends[c]
				changed = true
			}
		}
	}
	for i := 0; i < n; i++ {
		if unknown[i] {
			starts[i] = -1
			ends[i] = -1
		}
	}
	return starts, ends
}

// readsInPlace reports whether ins, not an alias (inplace.IsAggregateAlias), uses an aggregate
// operand's bytes only where ins stands, passing no pointer into them on: it has no
// result (a store copies the bytes), it is a call (which reads a by-reference argument,
// or whose callee writes it, during the call), or its result is read out of the bytes --
// a scalar member, a comparison, a boxed copy, an upcast interface, an interface's type
// info, an interface or function value's destructor.  Anything else (a field or element
// pointer, a cast to a pointer, a value built around the operand) might keep a pointer
// into them.
func readsInPlace(ins @ir.Instr) bool {
	if InstrIsVoid(ins) || isCallOp(ins.Op) { return true }
	var op int = ins.Op
	if op == iropcode.OP_EXTRACT { return !callconv.IsAggregateTyp(ins.Typ) }
	return op == iropcode.OP_EQ || op == iropcode.OP_NE || op == iropcode.OP_BOX ||
			op == iropcode.OP_IFACE_UPCAST || op == iropcode.OP_IFACE_TYPEINFO ||
			op == iropcode.OP_IFACE_DTOR || op == iropcode.OP_FUNC_VALUE_DTOR
}

// placeSharedRegions lays down, from offset, the data regions ids (sizes, each a
// positive multiple of 8) of f (lo / hi: aggregateHulls), appending each to allocIDs /
// allocSizes / allocOffsets, and the argument regions of copies, setting each one's
// offset (copies.offs); it returns the offset past them.  A data region is in use over
// its span (regionSpans, computed when there are two or more regions, one of them a
// data region); an argument region only at its call's position.  A data region whose
// span regionSpans cannot follow keeps bytes of its own; the argument regions of calls
// the entry does not reach lie in one area, each such call's side by side, as large as
// the largest call's; the others share bytes where their spans do not meet
// (packByStart).
func placeSharedRegions(f @ir.Func, lo @[]int, hi @[]int, ids @vec.Vec[int], sizes @vec.Vec[int64],
		copies @argCopyPlan, allocIDs @vec.Vec[int], allocSizes @vec.Vec[int64],
		allocOffsets @vec.Vec[int64], offset int64) int64 {
	var n int = ids.Len()
	var nc int = copies.calls.Len()
	if n + nc == 0 { return offset }
	var starts @[]int
	var ends @[]int
	if n >= 1 && n + nc >= 2 { starts, ends = regionSpans(f, lo, hi) }
	// The regions whose spans are known, as items: k < n is data region k, n + i the
	// argument region i.
	var itemOf @vec.Vec[int] = vec.New[int]()
	var itemStarts @vec.Vec[int] = vec.New[int]()
	var itemEnds @vec.Vec[int] = vec.New[int]()
	var itemSizes @vec.Vec[int64] = vec.New[int64]()
	for k := 0; k < n; k++ {
		var id int = ids.Get(k)
		if id < len(starts) && starts[id] >= 0 {
			itemOf.Push(k)
			itemStarts.Push(starts[id])
			itemEnds.Push(ends[id])
			itemSizes.Push(sizes.Get(k))
			continue
		}
		allocIDs.Push(id)
		allocSizes.Push(sizes.Get(k))
		allocOffsets.Push(offset)
		offset = frameAdd(offset, sizes.Get(k))
	}
	// A call's regions are listed together (collectArgCopies).
	var deadCall int = -1
	var deadBytes int64 = 0
	var deadArea int64 = 0
	for i := 0; i < nc; i++ {
		var p int = copies.pos.Get(i)
		if p >= 0 {
			itemOf.Push(n + i)
			itemStarts.Push(p)
			itemEnds.Push(p + 1)
			itemSizes.Push(copies.sizes.Get(i))
			continue
		}
		if copies.calls.Get(i) != deadCall {
			deadCall = copies.calls.Get(i)
			deadBytes = 0
		}
		copies.offs[i] = frameAdd(offset, deadBytes)
		deadBytes = frameAdd(deadBytes, copies.sizes.Get(i))
		if deadBytes > deadArea { deadArea = deadBytes }
	}
	offset = frameAdd(offset, deadArea)
	if itemOf.Len() == 0 { return offset }
	offs, total := packByStart(itemStarts.Items(), itemEnds.Items(), itemSizes.Items())
	for j := 0; j < itemOf.Len(); j++ {
		var k int = itemOf.Get(j)
		if k < n {
			allocIDs.Push(ids.Get(k))
			allocSizes.Push(sizes.Get(k))
			allocOffsets.Push(frameAdd(offset, offs[j]))
		} else {
			copies.offs[k - n] = frameAdd(offset, offs[j])
		}
	}
	return frameAdd(offset, total)
}

// packByStart places items (starts / ends: their half-open spans; sizes) so that two
// whose spans meet never share bytes: each, in order of span start (orderByStart), at
// the lowest offset clear of the ones placed before it.  The ones in use at an item's
// start are the placed ones whose spans have not ended there; they all hold that
// position, so their bytes are disjoint, and they are kept in order of offset for the
// search.  It returns each item's offset from 0 and the bytes the items take.
func packByStart(starts @[]int, ends @[]int, sizes @[]int64) (@[]int64, int64) {
	var n int = len(starts)
	var maxStart int = 0
	for k := 0; k < n; k++ {
		if starts[k] > maxStart { maxStart = starts[k] }
	}
	var order @[]int = orderByStart(starts, maxStart)
	var offs @[]int64 = make_slice(int64, n)
	var act @[]int = make_slice(int, n)
	var na int = 0
	var total int64 = 0
	for i := 0; i < n; i++ {
		var k int = order[i]
		var s int = starts[k]
		var sz int64 = sizes[k]
		var w int = 0
		for j := 0; j < na; j++ {
			if ends[act[j]] > s {
				act[w] = act[j]
				w++
			}
		}
		na = w
		var at int64 = 0
		var pos int = na
		for j := 0; j < na; j++ {
			if frameAdd(at, sz) <= offs[act[j]] {
				pos = j
				break
			}
			var e int64 = frameAdd(offs[act[j]], sizes[act[j]])
			if e > at { at = e }
		}
		for j := na; j > pos; j-- { act[j] = act[j - 1] }
		act[pos] = k
		na++
		offs[k] = at
		if frameAdd(at, sz) > total { total = frameAdd(at, sz) }
	}
	return offs, total
}

// orderByStart returns the indexes of starts (none past maxStart) in order of start, a
// counting sort that keeps their order among equal starts.
func orderByStart(starts @[]int, maxStart int) @[]int {
	var first @[]int = make_slice(int, maxStart + 2)
	for i := 0; i < len(starts); i++ {
		var after int = starts[i] + 1
		first[after] = first[after] + 1
	}
	for p := 1; p < len(first); p++ { first[p] = first[p] + first[p - 1] }
	var order @[]int = make_slice(int, len(starts))
	for i := 0; i < len(starts); i++ {
		var s int = starts[i]
		order[first[s]] = i
		first[s] = first[s] + 1
	}
	return order
}
