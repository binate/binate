package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"

import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for common_region_share.bn.  setTarget64 and the elision* helpers are shared test
// helpers.

// regionFunc returns a function t whose entry block makes two Quad call results, a and
// b, and the entry block: the caller reads them as its case needs, then returns.
func regionFunc() (@ir.Func, @ir.Block) {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), elisionNoResults())
	return f, ir.AddBlock(f, "entry")
}

// mkQuad emits a call to mk returning a Quad (its result gets a data region).
func mkQuad(e @ir.Block) @ir.Instr {
	return irbuild.EmitCall(e, "mk", make_slice(@ir.Instr, 0), elisionQuadTyp())
}

// readField emits an extract of field 0 of v (an int), a use of v.
func readField(e @ir.Block, v @ir.Instr) @ir.Instr {
	return irbuild.EmitExtract(e, v, 0, types.TypInt())
}

// Two call results, the first read before the second is made, have spans that do not
// meet, and share bytes; read after it, they meet, and do not.
func TestRegionsShareByLifetime() testing.TestResult {
	setTarget64()
	f, e := regionFunc()
	var a @ir.Instr = mkQuad(e)
	readField(e, a)
	var b @ir.Instr = mkQuad(e)
	readField(e, b)
	irbuild.EmitReturn(e, elisionNoRets())
	starts, ends := testRegionSpans(f)
	if starts[a.ID] < 0 || starts[b.ID] < 0 { return "both regions have spans" }
	if ends[a.ID] > starts[b.ID] { return "a's span ends before b's starts" }
	var rm @RegMap = NewRegMap(callconv.AAPCS64())
	rm.PlanFrame(f)
	if rm.LookupAlloc(a.ID) < 0 || rm.LookupAlloc(a.ID) != rm.LookupAlloc(b.ID) {
		return "a and b share a region"
	}
	f, e = regionFunc()
	a = mkQuad(e)
	b = mkQuad(e)
	readField(e, a)
	readField(e, b)
	irbuild.EmitReturn(e, elisionNoRets())
	rm = NewRegMap(callconv.AAPCS64())
	rm.PlanFrame(f)
	if rm.LookupAlloc(a.ID) == rm.LookupAlloc(b.ID) { return "regions whose spans meet do not share" }
	return ""
}

// A value passing a region's pointer on (an aggregate member extracted) keeps the region
// in use while it is: read after the next call result is made, a's region does not
// share with that result's.
func TestRegionSpanCoversAliases() testing.TestResult {
	setTarget64()
	var pair @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		pair[i] = make(types.Field)
		pair[i].Type = elisionQuadTyp()
	}
	var outer @types.Type = types.MakeStructType("Outer", pair)
	f, e := regionFunc()
	var a @ir.Instr = irbuild.EmitCall(e, "mkOuter", make_slice(@ir.Instr, 0), outer)
	var inner @ir.Instr = irbuild.EmitExtract(e, a, 1, elisionQuadTyp())
	var b @ir.Instr = mkQuad(e)
	readField(e, b)
	readField(e, inner)
	irbuild.EmitReturn(e, elisionNoRets())
	starts, ends := testRegionSpans(f)
	if starts[a.ID] < 0 || ends[a.ID] <= starts[b.ID] {
		return "a's span covers its member's last read"
	}
	var rm @RegMap = NewRegMap(callconv.AAPCS64())
	rm.PlanFrame(f)
	if rm.LookupAlloc(a.ID) == rm.LookupAlloc(b.ID) {
		return "a's region is still in use when b is made"
	}
	return ""
}

// A value read in a loop is in use through the whole loop: a value made in the loop after
// the read does not share with it, though no read of the first follows it in the block
// (the next iteration's does).
func TestRegionSpanCoversLoop() testing.TestResult {
	setTarget64()
	f, e := regionFunc()
	var hdr @ir.Block = ir.AddBlock(f, "hdr")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var a @ir.Instr = mkQuad(e)
	irbuild.EmitJump(e, hdr)
	irbuild.EmitBranch(hdr, irbuild.EmitConstBool(hdr, true), body, exit)
	readField(body, a)
	var c @ir.Instr = mkQuad(body)
	readField(body, c)
	irbuild.EmitJump(body, hdr)
	irbuild.EmitReturn(exit, elisionNoRets())
	starts, ends := testRegionSpans(f)
	if starts[a.ID] < 0 || starts[c.ID] < 0 { return "both regions have spans" }
	if ends[a.ID] <= starts[c.ID] { return "a's span reaches past c's definition, around the loop" }
	var rm @RegMap = NewRegMap(callconv.AAPCS64())
	rm.PlanFrame(f)
	if rm.LookupAlloc(a.ID) == rm.LookupAlloc(c.ID) { return "a's region is in use when c is made" }
	return ""
}

// A region whose value an instruction may keep a pointer into -- a field pointer of the
// value, or of an alias of it -- has no span, and keeps bytes of its own.
func TestRegionUnknownWhenPointerTaken() testing.TestResult {
	setTarget64()
	f, e := regionFunc()
	var a @ir.Instr = mkQuad(e)
	var fp @ir.Instr = irbuild.EmitGetFieldPtr(e, a, 0, types.TypInt())
	var b @ir.Instr = mkQuad(e)
	readField(e, b)
	irbuild.EmitLoad(e, fp, types.TypInt())
	irbuild.EmitReturn(e, elisionNoRets())
	starts, _ := testRegionSpans(f)
	if starts[a.ID] >= 0 { return "a value whose field pointer is taken has no span" }
	if starts[b.ID] < 0 { return "b's span is known" }
	var rm @RegMap = NewRegMap(callconv.AAPCS64())
	rm.PlanFrame(f)
	if rm.LookupAlloc(a.ID) == rm.LookupAlloc(b.ID) { return "a keeps bytes of its own" }
	f, e = regionFunc()
	var pair @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		pair[i] = make(types.Field)
		pair[i].Type = elisionQuadTyp()
	}
	a = irbuild.EmitCall(e, "mkOuter", make_slice(@ir.Instr, 0), types.MakeStructType("Outer", pair))
	var inner @ir.Instr = irbuild.EmitExtract(e, a, 1, elisionQuadTyp())
	irbuild.EmitLoad(e, irbuild.EmitGetFieldPtr(e, inner, 0, types.TypInt()), types.TypInt())
	irbuild.EmitReturn(e, elisionNoRets())
	starts, _ = testRegionSpans(f)
	if starts[inner.ID] >= 0 || starts[a.ID] >= 0 {
		return "an alias's field pointer makes the value's span unknown"
	}
	return ""
}

// A value defined and never used is in use only at its definition, which writes its
// region: a region made after it shares its bytes.
func TestRegionUnusedValueSpansItsDefinition() testing.TestResult {
	setTarget64()
	f, e := regionFunc()
	var a @ir.Instr = mkQuad(e)
	var b @ir.Instr = mkQuad(e)
	readField(e, b)
	irbuild.EmitReturn(e, elisionNoRets())
	starts, ends := testRegionSpans(f)
	if starts[a.ID] < 0 || ends[a.ID] > starts[b.ID] {
		return "an unused value's span is its definition"
	}
	var rm @RegMap = NewRegMap(callconv.AAPCS64())
	rm.PlanFrame(f)
	if rm.LookupAlloc(a.ID) < 0 || rm.LookupAlloc(a.ID) != rm.LookupAlloc(b.ID) {
		return "b shares a's region"
	}
	return ""
}

// A call's argument is read (or written by the callee) during the call, while the call
// writes its result: the argument's region and the result's do not share.
func TestRegionArgumentNotSharedWithResult() testing.TestResult {
	setTarget64()
	f, e := regionFunc()
	var a @ir.Instr = mkQuad(e)
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = a
	var b @ir.Instr = irbuild.EmitCall(e, "g", args, elisionQuadTyp())
	readField(e, b)
	irbuild.EmitReturn(e, elisionNoRets())
	starts, ends := testRegionSpans(f)
	if starts[a.ID] < 0 || starts[b.ID] < 0 || ends[a.ID] <= starts[b.ID] {
		return "the spans meet at the call"
	}
	var rm @RegMap = NewRegMap(callconv.AAPCS64())
	rm.PlanFrame(f)
	if rm.LookupAlloc(a.ID) == rm.LookupAlloc(b.ID) {
		return "the argument and the result do not share"
	}
	return ""
}

// Regions are placed first fit in order of span start: of three made and read one after
// another, all share the lowest bytes; with the first still in use, the next two share
// the bytes above it.
func TestRegionsPlacedFirstFit() testing.TestResult {
	setTarget64()
	f, e := regionFunc()
	var a @ir.Instr = mkQuad(e)
	readField(e, a)
	var b @ir.Instr = mkQuad(e)
	readField(e, b)
	var c @ir.Instr = mkQuad(e)
	readField(e, c)
	irbuild.EmitReturn(e, elisionNoRets())
	var rm @RegMap = NewRegMap(callconv.AAPCS64())
	rm.PlanFrame(f)
	if rm.LookupAlloc(a.ID) != rm.LookupAlloc(b.ID) || rm.LookupAlloc(b.ID) != rm.LookupAlloc(c.ID) {
		return "three regions in turn share their bytes"
	}
	f, e = regionFunc()
	a = mkQuad(e)
	b = mkQuad(e)
	readField(e, b)
	c = mkQuad(e)
	readField(e, c)
	readField(e, a)
	irbuild.EmitReturn(e, elisionNoRets())
	rm = NewRegMap(callconv.AAPCS64())
	rm.PlanFrame(f)
	var ao int64 = rm.LookupAlloc(a.ID)
	if ao == rm.LookupAlloc(b.ID) || ao == rm.LookupAlloc(c.ID) {
		return "a's region is in use throughout"
	}
	if rm.LookupAlloc(b.ID) != rm.LookupAlloc(c.ID) { return "b and c share the bytes beside a's" }
	return ""
}

// testRegionSpans is regionSpans over f's own aggregate hulls, as PlanFrame computes them.
func testRegionSpans(f @ir.Func) (@[]int, @[]int) {
	var none @[]bool
	lo, hi := aggregateHulls(f, newLiveCFG(f), 8, none)
	return regionSpans(f, lo, hi)
}
