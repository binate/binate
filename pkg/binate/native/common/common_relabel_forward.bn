package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/std/vec"

// forwardPointerRelabels deletes every OP_CAST in f's blocks that only relabels
// a pointer, rewriting each use to read the cast's operand instead.  A relabel
// converts one pointer to another, raw or managed either way, with the same
// pointee: `@T` <-> `*T` (mem2reg leaves one when a raw parameter slot of an
// inlined callee received a managed value), or a same-kind cast that IR types
// reduce to an identity (`readonly` is stripped; a named pointer type is its
// underlying pointer).  Both kinds are one word with the same bits, and no
// native lowering distinguishes them, so lowering the cast would only copy the
// value into a register and spill slot of its own.  Two operands stay behind
// their cast:
//   - one whose pointee differs: an OP_GET_FIELD_PTR takes its struct from its
//     base operand's pointer type (ir.FieldPtrBaseType), so forwarding
//     `cast(*U, p)` would lay out U's fields as those of p's pointee;
//   - one with no SSA id (a global's address pseudo, ID -1): its users would
//     have no register to read.
// A stack slot's address forwards like any other pointer: an OP_BOX boxes its
// operand's value (ir.BoxedType), so a box of it still boxes the address.
// Uses in the VM-only fault pads are rewritten too, so every instruction a
// native analysis walks names the operand, never a deleted cast.  Runs while f
// is still in SSA form, before phi elimination: EliminatePhis orders each
// edge's copies by their sources, and rewriting a copy's source afterwards
// (from a relabel of a phi to that phi) can break the order, so a copy reads
// the phi's value from the next iteration.
func forwardPointerRelabels(f @ir.Func) {
	var n int = f.NextID
	var repl @[]@ir.Instr = make_slice(@ir.Instr, n)
	var found bool = false
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var ins @ir.Instr = blk.Instrs[ii]
			if ins.ID >= 0 && ins.ID < n && isPointerRelabel(ins) {
				repl[ins.ID] = ins.Args[0]
				found = true
			}
		}
	}
	if !found { return }
	forwardRelabelUses(f.Blocks, repl)
	forwardRelabelUses(f.FaultPads, repl)
	// Drop the relabels, keeping InstrsVec in step with each rebuilt block.
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		var kept @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var ins @ir.Instr = blk.Instrs[ii]
			if ins.ID >= 0 && ins.ID < n && repl[ins.ID] != nil { continue }
			kept.Push(ins)
		}
		if kept.Len() == len(blk.Instrs) { continue }
		blk.InstrsVec = kept
		blk.Instrs = kept.Items()
	}
}

// isPointerRelabel reports whether ins is an OP_CAST between pointers (raw or
// managed) whose pointees are identical, reading an operand that has an SSA id.
func isPointerRelabel(ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_CAST || len(ins.Args) != 1 || ins.TypeArg == nil { return false }
	var src @ir.Instr = ins.Args[0]
	if src == nil || src.ID < 0 { return false }
	var from @types.Type = types.StripWrappers(src.Typ)
	var to @types.Type = types.StripWrappers(ins.Typ)
	if !isPointerKind(from) || !isPointerKind(to) { return false }
	return from.Elem != nil && to.Elem != nil && from.Elem.Identical(to.Elem)
}

// isPointerKind reports whether t (already stripped of wrappers) is a raw or a
// managed pointer.
func isPointerKind(t @types.Type) bool {
	return t != nil && (t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR)
}

// forwardRelabelUses rewrites every operand and phi entry of blocks'
// instructions that names a relabel in repl to the relabel's source.  A phi
// entry does not own its value, so one left naming a deleted relabel would read
// freed memory.
func forwardRelabelUses(blocks @[]@ir.Block, repl @[]@ir.Instr) {
	for bi := 0; bi < len(blocks); bi++ {
		var blk @ir.Block = blocks[bi]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var ins @ir.Instr = blk.Instrs[ii]
			for k := 0; k < len(ins.Args); k++ {
				ins.Args[k] = relabelSource(ins.Args[k], repl)
			}
			for k := 0; k < len(ins.Phis); k++ {
				ins.Phis[k].Val = relabelSource(ir.PhiVal(ins.Phis[k]), repl)
			}
		}
	}
}

// relabelSource follows v through the relabels in repl (a relabel's operand can
// itself be one) to the first value that is not a relabel.
func relabelSource(v @ir.Instr, repl @[]@ir.Instr) @ir.Instr {
	for v != nil && v.ID >= 0 && v.ID < len(repl) && repl[v.ID] != nil {
		v = repl[v.ID]
	}
	return v
}
