package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// relabelThingTyp is a two-int struct named name, the pointee the relabel tests
// use.
func relabelThingTyp(name @[]char) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		var g @types.Field = make(types.Field)
		g.Type = types.TypInt()
		fields[i] = g
	}
	return types.MakeStructType(name, fields)
}

// relabelLoad returns a fresh value of type t: a load from a stack slot.
func relabelLoad(b @ir.Block, t @types.Type) @ir.Instr {
	return irbuild.EmitLoad(b, irbuild.EmitAlloc(b, t), t)
}

// countOp returns how many of b's instructions have opcode op.
func countOp(b @ir.Block, op int) int {
	var c int = 0
	for i := 0; i < len(b.Instrs); i++ {
		if b.Instrs[i].Op == op { c++ }
	}
	return c
}

// A managed -> raw relabel feeding a field GEP is deleted, and the GEP reads the
// managed value directly.
func TestForwardPointerRelabelManagedToRaw() testing.TestResult {
	setTarget64()
	var thing @types.Type = relabelThingTyp("Thing")
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var m @ir.Instr = relabelLoad(b, types.MakeManagedPtrType(thing))
	var c @ir.Instr = irbuild.EmitCast(b, m, types.MakePointerType(thing))
	var fp @ir.Instr = irbuild.EmitGetFieldPtr(b, c, 1, types.TypInt())
	irbuild.EmitLoad(b, fp, types.TypInt())
	irbuild.EmitReturn(b, makeNoInstrs())
	forwardPointerRelabels(f)
	if countOp(b, iropcode.OP_CAST) != 0 { return "the managed -> raw relabel must be deleted" }
	if fp.Args[0].ID != m.ID { return "the field GEP must read the managed value" }
	if b.InstrsVec.Len() != len(b.Instrs) { return "InstrsVec must hold the rebuilt block" }
	return ""
}

// A same-kind cast whose types reduce to an identity is a relabel too: a raw
// `*Thing` -> `*Thing`, and a named pointer type over `*Thing` -> `@Thing`.
func TestForwardPointerRelabelIdentityAndNamed() testing.TestResult {
	setTarget64()
	var thing @types.Type = relabelThingTyp("Thing")
	var named @types.Type = types.MakeNamedType("P")
	named.Underlying = types.MakePointerType(thing)
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var r @ir.Instr = relabelLoad(b, types.MakePointerType(thing))
	var c1 @ir.Instr = irbuild.EmitCast(b, r, types.MakePointerType(thing))
	var l1 @ir.Instr = irbuild.EmitLoad(b, c1, thing)
	var p @ir.Instr = relabelLoad(b, named)
	var c2 @ir.Instr = irbuild.EmitCast(b, p, types.MakeManagedPtrType(thing))
	var l2 @ir.Instr = irbuild.EmitLoad(b, c2, thing)
	irbuild.EmitReturn(b, makeNoInstrs())
	forwardPointerRelabels(f)
	if countOp(b, iropcode.OP_CAST) != 0 { return "both relabels must be deleted" }
	if l1.Args[0].ID != r.ID { return "the raw identity relabel must forward" }
	if l2.Args[0].ID != p.ID { return "the named-pointer relabel must forward" }
	return ""
}

// A chain of relabels (raw -> managed -> raw) forwards to its first operand.
func TestForwardPointerRelabelChain() testing.TestResult {
	setTarget64()
	var thing @types.Type = relabelThingTyp("Thing")
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var r @ir.Instr = relabelLoad(b, types.MakePointerType(thing))
	var c1 @ir.Instr = irbuild.EmitCast(b, r, types.MakeManagedPtrType(thing))
	var c2 @ir.Instr = irbuild.EmitCast(b, c1, types.MakePointerType(thing))
	var ld @ir.Instr = irbuild.EmitLoad(b, c2, thing)
	irbuild.EmitReturn(b, makeNoInstrs())
	forwardPointerRelabels(f)
	if countOp(b, iropcode.OP_CAST) != 0 { return "both relabels must be deleted" }
	if ld.Args[0].ID != r.ID { return "the load must read the chain's first operand" }
	return ""
}

// A cast between pointers to different pointees stays: a field GEP on it lays
// out the target's fields, not the operand's pointee's.
func TestForwardPointerRelabelKeepsPointeeChange() testing.TestResult {
	setTarget64()
	var a @types.Type = relabelThingTyp("A")
	var u @types.Type = relabelThingTyp("U")
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var p @ir.Instr = relabelLoad(b, types.MakePointerType(a))
	var c @ir.Instr = irbuild.EmitCast(b, p, types.MakePointerType(u))
	var fp @ir.Instr = irbuild.EmitGetFieldPtr(b, c, 1, types.TypInt())
	irbuild.EmitReturn(b, makeNoInstrs())
	forwardPointerRelabels(f)
	if countOp(b, iropcode.OP_CAST) != 1 { return "a pointee-changing cast must stay" }
	if fp.Args[0].ID != c.ID { return "the field GEP must still read the cast" }
	return ""
}

// A pointer <-> integer conversion is not a relabel and stays.
func TestForwardPointerRelabelKeepsIntConversion() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var p @ir.Instr = relabelLoad(b, types.MakePointerType(types.TypInt()))
	irbuild.EmitCast(b, p, types.TypInt())
	irbuild.EmitReturn(b, makeNoInstrs())
	forwardPointerRelabels(f)
	if countOp(b, iropcode.OP_CAST) != 1 { return "a pointer -> int cast must stay" }
	return ""
}

// A cast with a non-pointer endpoint stays even when the element types match:
// `*Thing` -> `*[]Thing` and back.
func TestForwardPointerRelabelKeepsNonPointerEndpoint() testing.TestResult {
	setTarget64()
	var thing @types.Type = relabelThingTyp("Thing")
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var p @ir.Instr = relabelLoad(b, types.MakePointerType(thing))
	irbuild.EmitCast(b, p, types.MakeSliceType(thing))
	var s @ir.Instr = relabelLoad(b, types.MakeSliceType(thing))
	irbuild.EmitCast(b, s, types.MakePointerType(thing))
	irbuild.EmitReturn(b, makeNoInstrs())
	forwardPointerRelabels(f)
	if countOp(b, iropcode.OP_CAST) != 2 { return "pointer <-> slice casts must stay" }
	return ""
}

// A relabel of a stack slot's address forwards into a box like any other
// pointer: the box reads the slot's address, its boxed value.
func TestForwardPointerRelabelOfSlotIntoBox() testing.TestResult {
	setTarget64()
	var thing @types.Type = relabelThingTyp("Thing")
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var slot @ir.Instr = irbuild.EmitAlloc(b, thing)
	var c @ir.Instr = irbuild.EmitCast(b, slot, types.MakePointerType(thing))
	var bx @ir.Instr = irbuild.EmitBox(b, c, types.MakeManagedPtrType(types.MakePointerType(thing)))
	irbuild.EmitReturn(b, makeNoInstrs())
	forwardPointerRelabels(f)
	if countOp(b, iropcode.OP_CAST) != 0 { return "a relabel of a slot address must forward" }
	if bx.Args[0].ID != slot.ID { return "the box must read the slot's address" }
	return ""
}

// A relabel of an operand with no SSA id (a global's address pseudo) stays, so
// its users keep reading a value that has a register.
func TestForwardPointerRelabelKeepsIdlessOperand() testing.TestResult {
	setTarget64()
	var thing @types.Type = relabelThingTyp("Thing")
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var g @ir.Instr = make(ir.Instr)
	g.ID = -1
	g.Op = iropcode.OP_ALLOC
	g.IsGlobalRef = true
	g.Typ = types.MakePointerType(thing)
	g.TypeArg = thing
	var c @ir.Instr = irbuild.EmitCast(b, g, types.MakeManagedPtrType(thing))
	var ld @ir.Instr = irbuild.EmitLoad(b, c, thing)
	irbuild.EmitReturn(b, makeNoInstrs())
	forwardPointerRelabels(f)
	if countOp(b, iropcode.OP_CAST) != 1 { return "a relabel of an id-less operand must stay" }
	if ld.Args[0].ID != c.ID { return "the load must still read the cast" }
	return ""
}

// A use in a VM-only fault pad is rewritten along with the blocks' uses.
func TestForwardPointerRelabelRewritesFaultPadUses() testing.TestResult {
	setTarget64()
	var thing @types.Type = relabelThingTyp("Thing")
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var m @ir.Instr = relabelLoad(b, types.MakeManagedPtrType(thing))
	var c @ir.Instr = irbuild.EmitCast(b, m, types.MakePointerType(thing))
	irbuild.EmitReturn(b, makeNoInstrs())
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	var ld @ir.Instr = irbuild.EmitLoad(pad, c, thing)
	forwardPointerRelabels(f)
	if countOp(b, iropcode.OP_CAST) != 0 { return "the relabel must be deleted" }
	if ld.Args[0].ID != m.ID { return "the fault pad's load must read the managed value" }
	return ""
}
