package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/std/vec"

// A function returning one aggregate through its caller's buffer (sret), and returning
// the same local at every return, can keep that local in the buffer: `var b Big; ...;
// return b` builds b where the caller wants it, and the return copies nothing.  The
// buffer is private to the call — a temporary of the caller's, a local of the caller's
// whose address never leaves it (CallResultSlots), or the caller's own incoming buffer
// (ReturnedCallResults, or a call stored into the local the caller keeps there:
// placeCallResults); a C caller's buffer may be written at any time too — so
// nothing can see it change before the function returns.  The local qualifies when
//   - every OP_RETURN of the function returns, as its one value, a whole OP_LOAD of
//     it, in the return's block, the load's only use;
//   - nothing between such a load and its return references the local or a value
//     computed from it: what is returned is what the local holds at the return;
//   - it is a stack slot of the result's size (not a package global, not a parameter's
//     slot nor one that may be a parameter's incoming copy) whose address never
//     leaves the function (as for CallResultSlots).

// RetbufLocal returns the value ID of the stack slot f may keep in its caller's result
// buffer (see above), or -1, with, indexed by value ID, the loads of it f returns.  A
// backend keeps the slot there when f returns through a buffer.
func RetbufLocal(f @ir.Func) (int, @[]bool) {
	return newFuncUses(f).retbufLocal(InPlaceParamSlots(f))
}

// retbufLocal is RetbufLocal over u's function, whose InPlaceParamSlots are inPlace.
func (u @funcUses) retbufLocal(inPlace @[]int) (int, @[]bool) {
	var f @ir.Func = u.f
	var loads @[]bool = make_slice(bool, f.NextID)
	var none @[]bool = make_slice(bool, f.NextID)
	if len(f.Results) != 1 || f.Results[0] == nil || !callconv.IsAggregateTyp(f.Results[0]) {
		return -1, none
	}
	var slot @ir.Instr
	var blocks @vec.Vec[int] = vec.New[int]()
	var loadAt @vec.Vec[int] = vec.New[int]()
	var retAt @vec.Vec[int] = vec.New[int]()
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ret @ir.Instr = b.Instrs[ii]
			if ret.Op != iropcode.OP_RETURN { continue }
			if len(ret.Args) != 1 { return -1, none }
			var ld @ir.Instr = ret.Args[0]
			if ld == nil || ld.Op != iropcode.OP_LOAD || len(ld.Args) < 1 || ld.ID < 0 ||
					ld.ID >= len(loads) || u.useCount(ld.ID) != 1 || !isPlainStackSlot(ld.Args[0]) {
				return -1, none
			}
			if slot == nil { slot = ld.Args[0] }
			if ld.Args[0].ID != slot.ID { return -1, none }
			var li int = indexInBlock(b, ii, ld)
			if li < 0 { return -1, none }
			blocks.Push(bi)
			loadAt.Push(li)
			retAt.Push(ii)
			loads[ld.ID] = true
		}
	}
	if slot == nil || slot.ID >= len(loads) || slot.TypeArg == nil ||
			slot.TypeArg.Size() != f.Results[0].Size() || inPlace[slot.ID] >= 0 {
		return -1, none
	}
	var reach @idSet = newIDSet(f.NextID)
	if !u.slotReach(slot, reach, newIDSet(f.NextID)) { return -1, none }
	for i := 0; i < blocks.Len(); i++ {
		if referencesAnyBetween(f.Blocks[blocks.Get(i)], loadAt.Get(i), retAt.Get(i), reach, slot) {
			return -1, none
		}
	}
	return slot.ID, loads
}

// indexInBlock returns the index of v among the instructions of b before index end,
// or -1.
func indexInBlock(b @ir.Block, end int, v @ir.Instr) int {
	for ii := 0; ii < end; ii++ {
		if b.Instrs[ii].ID == v.ID { return ii }
	}
	return -1
}

// IsRetbufLoad reports whether the load with value ID id is a returned load of the
// slot kept in the caller's result buffer (RegMap.RetbufLoads).
func (m @RegMap) IsRetbufLoad(id int) bool {
	for i := 0; i < len(m.RetbufLoads); i++ {
		if m.RetbufLoads[i] == id { return true }
	}
	return false
}
