package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for common_retbuf_local.bn: a local returned at every return may live in the
// caller's result buffer.

// retLocalFunc returns a function returning a Quad whose entry block declares a slot,
// writes its first field, loads it and returns the load — `var b Quad; b.a = 1;
// return b` — with the entry block, the slot and the load.
func retLocalFunc() (@ir.Func, @ir.Block, @ir.Instr, @ir.Instr) {
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), quadResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	var fp @ir.Instr = irbuild.EmitGetFieldPtr(e, s, 0, types.TypInt())
	irbuild.EmitStore(e, fp, irbuild.EmitConstInt(e, 1, types.TypInt()))
	var ld @ir.Instr = irbuild.EmitLoad(e, s, elisionQuadTyp())
	return f, e, s, ld
}

// retOf returns a one-value return list of v.
func retOf(v @ir.Instr) @[]@ir.Instr {
	var rs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rs[0] = v
	return rs
}

// `var b Quad; b.a = 1; return b`: b may live in the caller's buffer, and its load is
// the returned one.
func TestRetbufLocal() testing.TestResult {
	setTarget64()
	f, e, s, ld := retLocalFunc()
	irbuild.EmitReturn(e, retOf(ld))
	slot, loads := RetbufLocal(f)
	if slot != s.ID || !loads[ld.ID] { return "the returned local may live in the caller's buffer" }
	return ""
}

// Two returns of the same local, in two blocks, qualify; two different locals do not.
func TestRetbufLocalTwoReturns() testing.TestResult {
	setTarget64()
	f, e, s, ld := retLocalFunc()
	var other @ir.Block = ir.AddBlock(f, "other")
	irbuild.EmitBranch(e, irbuild.EmitConstBool(e, true), other, other)
	var ld2 @ir.Instr = irbuild.EmitLoad(other, s, elisionQuadTyp())
	irbuild.EmitReturn(other, retOf(ld2))
	_ = ld
	slot, loads := RetbufLocal(f)
	if slot != s.ID || !loads[ld2.ID] { return "every return returns the local, so it qualifies" }
	g, ge, gs, _ := retLocalFunc()
	var gb1 @ir.Block = ir.AddBlock(g, "one")
	var gb2 @ir.Block = ir.AddBlock(g, "two")
	irbuild.EmitBranch(ge, irbuild.EmitConstBool(ge, true), gb1, gb2)
	irbuild.EmitReturn(gb1, retOf(irbuild.EmitLoad(gb1, gs, elisionQuadTyp())))
	var s2 @ir.Instr = irbuild.EmitAlloc(gb2, elisionQuadTyp())
	irbuild.EmitReturn(gb2, retOf(irbuild.EmitLoad(gb2, s2, elisionQuadTyp())))
	gslot, _ := RetbufLocal(g)
	if gslot != -1 { return "two different locals returned: neither qualifies" }
	return ""
}

// The local keeps its own slot when a return returns something else, when the
// returned load is in another block, when the local is written between the load and
// the return, and when its address leaves the function.
func TestRetbufLocalRejected() testing.TestResult {
	setTarget64()
	f, e, _, _ := retLocalFunc()
	irbuild.EmitReturn(e, retOf(irbuild.EmitCall(e, "mk", noInstrs(), elisionQuadTyp())))
	fslot, _ := RetbufLocal(f)
	if fslot != -1 { return "a return of a call result: no local qualifies" }
	g, ge, _, gld := retLocalFunc()
	var gb @ir.Block = ir.AddBlock(g, "out")
	irbuild.EmitJump(ge, gb)
	irbuild.EmitReturn(gb, retOf(gld))
	gslot, _ := RetbufLocal(g)
	if gslot != -1 { return "a load returned from another block: the local keeps its slot" }
	h, he, hs, hld := retLocalFunc()
	irbuild.EmitStore(he, irbuild.EmitGetFieldPtr(he, hs, 0, types.TypInt()),
			irbuild.EmitConstInt(he, 2, types.TypInt()))
	irbuild.EmitReturn(he, retOf(hld))
	hslot, _ := RetbufLocal(h)
	if hslot != -1 { return "a write between the load and the return: the local keeps its slot" }
	k, ke, ks, kld := retLocalFunc()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = irbuild.EmitGetFieldPtr(ke, ks, 0, types.TypInt())
	irbuild.EmitCall(ke, "use", args, types.TypVoid())
	irbuild.EmitReturn(ke, retOf(kld))
	kslot, _ := RetbufLocal(k)
	if kslot != -1 { return "a local whose address leaves the function keeps its slot" }
	return ""
}

// On AAPCS64 a Quad returns through the caller's buffer: PlanFrame gives the local no
// region, makes its spill slot the buffer pointer's, and lets the returned load alias
// it.  A 16-byte Pair returns in registers, so nothing is kept in a buffer.
func TestPlanFrameRetbufLocal() testing.TestResult {
	setTarget64()
	f, e, s, ld := retLocalFunc()
	irbuild.EmitReturn(e, retOf(ld))
	var rm @RegMap = NewRegMap(callconv.AAPCS64())
	rm.PlanFrame(f)
	if rm.RetbufSlotID != s.ID || rm.LookupAlloc(s.ID) >= 0 {
		return "the local has no region of its own"
	}
	if rm.SretSlotOff < 0 || rm.LookupSpill64(s.ID) != rm.SretSlotOff {
		return "the local's value is the caller's buffer pointer"
	}
	if !rm.IsRetbufLoad(ld.ID) || rm.LookupAlloc(ld.ID) >= 0 {
		return "the returned load aliases the local"
	}
	var pr @[]@types.Type = make_slice(@types.Type, 1)
	pr[0] = elisionPairTyp()
	var g @ir.Func = ir.NewFunc("", "t", elisionNoParams(), pr)
	var ge @ir.Block = ir.AddBlock(g, "entry")
	var gs @ir.Instr = irbuild.EmitAlloc(ge, elisionPairTyp())
	irbuild.EmitReturn(ge, retOf(irbuild.EmitLoad(ge, gs, elisionPairTyp())))
	var gm @RegMap = NewRegMap(callconv.AAPCS64())
	gm.PlanFrame(g)
	if gm.RetbufSlotID != -1 || gm.LookupAlloc(gs.ID) < 0 {
		return "a register-returned local keeps its region"
	}
	return ""
}

// Also not kept in the buffer: a returned load used again, a slot of another size than
// the result, a slot that may be a parameter's incoming copy, and any local of a
// function with two results.
func TestRetbufLocalRejectedMore() testing.TestResult {
	setTarget64()
	f, e, _, ld := retLocalFunc()
	irbuild.EmitExtract(e, ld, 0, types.TypInt())
	irbuild.EmitReturn(e, retOf(ld))
	fslot, _ := RetbufLocal(f)
	if fslot != -1 { return "a returned load used again: the local keeps its slot" }
	var pr @[]@types.Type = make_slice(@types.Type, 1)
	pr[0] = elisionPairTyp()
	var g @ir.Func = ir.NewFunc("", "t", elisionNoParams(), pr)
	var ge @ir.Block = ir.AddBlock(g, "entry")
	var gs @ir.Instr = irbuild.EmitAlloc(ge, elisionQuadTyp())
	irbuild.EmitReturn(ge, retOf(irbuild.EmitLoad(ge, gs, elisionPairTyp())))
	gslot, _ := RetbufLocal(g)
	if gslot != -1 { return "a slot of another size than the result is left alone" }
	h, he, s0, _ := paramSlotFunc()
	h.Results = quadResults()
	irbuild.EmitReturn(he, retOf(irbuild.EmitLoad(he, s0, elisionQuadTyp())))
	hslot, _ := RetbufLocal(h)
	if hslot != -1 { return "a slot that may be a parameter's incoming copy is left alone" }
	var two @[]@types.Type = make_slice(@types.Type, 2)
	two[0] = elisionQuadTyp()
	two[1] = types.TypInt()
	var k @ir.Func = ir.NewFunc("", "t", elisionNoParams(), two)
	var ke @ir.Block = ir.AddBlock(k, "entry")
	var ks @ir.Instr = irbuild.EmitAlloc(ke, elisionQuadTyp())
	var both @[]@ir.Instr = make_slice(@ir.Instr, 2)
	both[0] = irbuild.EmitLoad(ke, ks, elisionQuadTyp())
	both[1] = irbuild.EmitConstInt(ke, 1, types.TypInt())
	irbuild.EmitReturn(ke, both)
	kslot, _ := RetbufLocal(k)
	if kslot != -1 { return "a function with two results keeps nothing in a buffer" }
	return ""
}

// A call stored into the local kept in the caller's buffer passes that buffer on: it
// has no region, is recorded as writing the buffer, and its store into the local
// copies nothing — `var b Quad; b = mk(); b.a = 1; return b`.
func TestPlanFrameRetbufLocalFromCall() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), quadResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	var c @ir.Instr = irbuild.EmitCall(e, "mk", noInstrs(), elisionQuadTyp())
	irbuild.EmitStore(e, s, c)
	irbuild.EmitStore(e, irbuild.EmitGetFieldPtr(e, s, 0, types.TypInt()),
			irbuild.EmitConstInt(e, 1, types.TypInt()))
	irbuild.EmitReturn(e, retOf(irbuild.EmitLoad(e, s, elisionQuadTyp())))
	var rm @RegMap = NewRegMap(callconv.AAPCS64())
	rm.PlanFrame(f)
	if rm.RetbufSlotID != s.ID { return "precondition: the local lives in the caller's buffer" }
	if !rm.CallResultToRetbuf(c.ID) || rm.CallResultSlot(c.ID) != s.ID || rm.LookupAlloc(c.ID) >= 0 {
		return "the call writes the caller's buffer directly, and its store copies nothing"
	}
	return ""
}

// A function-value call stored into the kept local cannot pass the buffer on (only a
// direct call returning through one does): it keeps a region of its own and its store
// copies.
func TestPlanFrameRetbufLocalFromFuncValueCall() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), quadResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	var fvTyp @types.Type = types.MakeFuncValueType(make_slice(@types.Param, 0), quadResults())
	var fv @ir.Instr = irbuild.EmitConstNil(e, fvTyp)
	var c @ir.Instr = irbuild.EmitCallFuncValue(e, fv, noInstrs(), elisionQuadTyp())
	irbuild.EmitStore(e, s, c)
	irbuild.EmitReturn(e, retOf(irbuild.EmitLoad(e, s, elisionQuadTyp())))
	var rm @RegMap = NewRegMap(callconv.AAPCS64())
	rm.PlanFrame(f)
	if rm.RetbufSlotID != s.ID { return "precondition: the local lives in the caller's buffer" }
	if rm.CallResultToRetbuf(c.ID) || rm.CallResultSlot(c.ID) != -1 || rm.LookupAlloc(c.ID) < 0 {
		return "a function-value call keeps its own region, and its store copies"
	}
	return ""
}

// A local only ever stored and loaded whole — `var b Quad = mk(); return b` — has a
// returned load AggLoadElision already leaves without a region: it is still recorded
// as returned, so the return does not copy the buffer onto itself.
func TestPlanFrameRetbufLocalElidedLoad() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", elisionNoParams(), quadResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s @ir.Instr = irbuild.EmitAlloc(e, elisionQuadTyp())
	irbuild.EmitStore(e, s, irbuild.EmitCall(e, "mk", noInstrs(), elisionQuadTyp()))
	var ld @ir.Instr = irbuild.EmitLoad(e, s, elisionQuadTyp())
	irbuild.EmitReturn(e, retOf(ld))
	if !aggLoadElidable(f, ld) { return "precondition: the returned load is elided" }
	var rm @RegMap = NewRegMap(callconv.AAPCS64())
	rm.PlanFrame(f)
	if rm.RetbufSlotID != s.ID { return "precondition: the local lives in the caller's buffer" }
	if !rm.IsRetbufLoad(ld.ID) || rm.LookupAlloc(ld.ID) >= 0 {
		return "the elided returned load is recorded as returned: its return copies nothing"
	}
	return ""
}

// A fault pad naming the returned local does not keep it out of the caller's buffer:
// only the VM runs fault pads.
func TestRetbufLocalIgnoresFaultPads() testing.TestResult {
	setTarget64()
	f, e, s, ld := retLocalFunc()
	irbuild.EmitReturn(e, retOf(ld))
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	irbuild.EmitLoad(pad, s, elisionQuadTyp())
	irbuild.EmitReturn(pad, elisionNoRets())
	slot, _ := RetbufLocal(f)
	if slot != s.ID { return "a fault pad does not keep the local out of the caller's buffer" }
	return ""
}
