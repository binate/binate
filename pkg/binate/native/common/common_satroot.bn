package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/stdx/slices"

// EmitSatEntryRoot lays this module's whole-program SatEntry root into the
// native assembler (the native half of ir.BuildSatEntryRoot; the LLVM half is
// codegen.emitSatEntryRoot).  A no-op unless a native-codegen driver requested
// the root (mod.SatRootRequested) — the interp path lowers the main module to
// bytecode and never sets it (M5).  Call AFTER emitPackageDescriptor so this
// module's own `_pkg_satentries` is already defined before the root references
// it.  Each backend calls this with its own objSymPrefix (x64/aarch64/arm32
// share the layout; only the prefix differs).
//
// `prefix` is the object-format linkage prefix (objSymPrefix: "" for ELF, "_"
// for Mach-O), applied here exactly as each backend's globalSymFor/symPrefixed
// does — so the root's symbols and its cross-object `_pkg_satentries` references
// match the LLVM-compiled dependency objects (clang prepends the same '_').
//
// A dependency package's `_pkg_satentries` is defined in a DIFFERENT object;
// SetGlobal registers the undefined external reference so the DataSymref fixup
// resolves at link, and the strong reference forces the linker to retain the
// dependency's weak `_pkg_satentries` (and its `__satentry` nodes) across
// dead-strip.  Unlike EmitInitDispatcher's extern FUNCTIONS, no pass
// auto-declares an undefined data symref (M4).  This module's OWN
// `_pkg_satentries` (IsOwn) is already defined here, so no SetGlobal.
func EmitSatEntryRoot(a @asm.Assembler, prefix *[]readonly char, mod @ir.Module) {
	if !mod.SatRootRequested { return }
	var rootSym @[]char = buf.Concat(prefix, mangle.GlobalName(mod.PkgPath, "_satentry_root"))
	var pairsSym @[]char = buf.Concat(prefix, mangle.GlobalName(mod.PkgPath, "_satentry_root_pairs"))

	var pkgSatSyms @[]@[]char
	var counts @[]int
	for i := 0; i < len(mod.SatRootEntries); i++ {
		var e ir.SatRootEntry = mod.SatRootEntries[i]
		var sym @[]char = buf.Concat(prefix, mangle.GlobalName(e.PkgPath, "_pkg_satentries"))
		pkgSatSyms = slices.Append[@[]char](pkgSatSyms, sym)
		counts = slices.Append[int](counts, e.Count)
		if !e.IsOwn {
			a.SetGlobal(sym)
		}
	}

	var dgs @[]@ir.DataGlobal = ir.BuildSatEntryRoot(rootSym, pairsSym, pkgSatSyms, counts)
	for i := 0; i < len(dgs); i++ {
		EmitDataGlobal(a, dgs[i])
	}
	return
}
