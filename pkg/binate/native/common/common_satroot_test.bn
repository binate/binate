package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/builtins/testing"

// Tests for common_satroot.bn — the native half of the whole-program SatEntry
// root.  Prefix "" (ELF-style, no Mach-O '_') keeps the emitted symbols equal to
// their bare mangled names, so LookupSymbol can find them.

// mkSatRootModule builds a `main` module requesting the root over one
// dependency package (IsOwn=false) plus this module's own (IsOwn=true).
func mkSatRootModule() @ir.Module {
	var m @ir.Module = ir.NewModule("\"main\"")
	// The driver sets PkgPath via GeneratePackage before EmitSatEntryRoot; this
	// test skips that, so set it here — EmitSatEntryRoot keys the root's own
	// symbol names on mod.PkgPath.
	m.PkgPath = "main"
	m.SatRootRequested = true
	var entries @[]ir.SatRootEntry = make_slice(ir.SatRootEntry, 2)
	var dep ir.SatRootEntry
	dep.PkgPath = "pkg/dep"
	dep.Count = 3
	dep.IsOwn = false
	var own ir.SatRootEntry
	own.PkgPath = "main"
	own.Count = 2
	own.IsOwn = true
	entries[0] = dep
	entries[1] = own
	m.SatRootEntries = entries
	return m
}

// A requested root defines the weak `_satentry_root` header + its
// `_satentry_root_pairs` array, and seeds each DEPENDENCY's `_pkg_satentries` as
// a global (undefined) reference so the cross-object DataSymref resolves at link
// (M4) — the own `_pkg_satentries`, defined in this same object, gets no such
// promotion here.
func TestEmitSatEntryRootNative() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	EmitSatEntryRoot(a, "", mkSatRootModule())

	var rootSym int = a.LookupSymbol(mangle.GlobalName("main", "_satentry_root"))
	if rootSym < 0 { return "root header symbol not defined" }
	if a.Symbols[rootSym].Binding != asm.BIND_WEAK { return "root header should be weak-bound" }

	if a.LookupSymbol(mangle.GlobalName("main", "_satentry_root_pairs")) < 0 {
		return "pairs array symbol not defined"
	}

	var depSym int = a.LookupSymbol(mangle.GlobalName("pkg/dep", "_pkg_satentries"))
	if depSym < 0 { return "dependency _pkg_satentries reference not seeded" }
	if a.Symbols[depSym].Binding != asm.BIND_GLOBAL {
		return "dependency _pkg_satentries should be a global (undefined) reference (M4 SetGlobal)"
	}
	return ""
}

// Without a root request (the interp path, which never calls EmitSatEntryRoot),
// EmitSatEntryRoot emits nothing (M5).
func TestEmitSatEntryRootNativeNotRequested() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	// m.SatRootRequested stays false.
	var a @asm.Assembler = asm.New(8)
	EmitSatEntryRoot(a, "", m)
	if a.LookupSymbol(mangle.GlobalName("main", "_satentry_root")) >= 0 {
		return "no root should be emitted when not requested"
	}
	return ""
}
