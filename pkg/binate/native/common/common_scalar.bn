package "pkg/binate/native/common"

import "pkg/binate/types"

// SubWordNarrow reports how an integer value of type t, held in a
// wordBits-wide register, must be re-narrowed after a width-agnostic
// operation computed it at full register width.  It returns the width
// (in bits) to reduce the result to — 0 when no narrowing is needed (t
// is nil, non-integer, or already at least host-word-wide) — and
// whether that reduction is signed (sign-extend) or unsigned
// (zero-extend).
//
// The VM and every native backend consult this one classifier, so a
// sub-word result lands in its type's value range identically across
// all execution modes (LLVM is already correct: its SSA values carry
// true widths).  wordBits is the target's register width — 64 on the
// aa64/x64 backends, the VM's host word for the bytecode VM — so the
// same int32 narrows on a 64-bit target yet is already full-width on a
// 32-bit one.  Width is read directly (matching ir.typeWidth): a 0
// width means host-word-wide, hence no narrow.
func SubWordNarrow(t @types.Type, wordBits int) (int, bool) {
	if t == nil { return 0, false }
	t = UnwrapNamed(t)
	if !t.IsInteger() { return 0, false }
	if t.Width > 0 && t.Width < wordBits { return t.Width, t.Signed }
	return 0, false
}

// IsUnsignedIntType reports whether t is a concrete unsigned integer
// type (uint8/16/32/64 or uint).  An untyped int literal is NOT
// unsigned: it defaults to signed `int`, and its Signed flag is unset,
// so this must require TYP_INT (excluding TYP_UNTYPED_INT) rather than
// IsInteger()+!Signed — otherwise `cast(float64, 5)` would be treated as
// unsigned.  The VM and native backends consult this to pick the
// unsigned int↔float conversion (UITOF/Ucvtf vs SITOF/Scvtf), so a
// high-bit-set unsigned value converts to a large positive float instead
// of a negative one.
func IsUnsignedIntType(t @types.Type) bool {
	t = UnwrapNamed(t)
	return t != nil && t.Kind == types.TYP_INT && !t.Signed
}

// UnwrapNamed peels TYP_NAMED wrappers down to the underlying concrete
// type so the shared classifiers (and the native backends) inspect the
// real scalar's kind / width / signedness.  A named distinct scalar
// (`type F float32`) reaches the backends as a TYP_NAMED carrying its
// name (kept that far for method dispatch in IR-gen); its machine form
// is the underlying's.  Loops to handle named-over-named.
func UnwrapNamed(t @types.Type) @types.Type {
	for t != nil && t.Kind == types.TYP_NAMED && t.Underlying != nil {
		t = t.Underlying
	}
	return t
}

// peelTransparent peels the transparent wrappers — alias, readonly, and
// named — to the representation type, so the machine-layout classifiers see
// the real kind.  Matches the peel types.IsByvalParam / SizeOf do: a
// `readonly Big` (or named-/alias-wrapped aggregate) MUST classify by its
// 24-byte aggregate representation, not be mis-read as a non-aggregate
// scalar — the >16-byte byval/sret convention is keyed on IsAggregateTyp +
// SizeOf (which DOES peel), so a classifier that stops at TYP_READONLY
// disagrees with the size gate and lowers the param by value where the ABI
// passes a pointer → garbage / SIGSEGV.  Loops to a fixpoint so any wrapper
// order (readonly-over-named, alias-over-readonly, …) resolves.
func peelTransparent(t @types.Type) @types.Type {
	for t != nil {
		var p @types.Type = t.ResolveAlias()
		if p == nil { return t }
		if p.Kind == types.TYP_READONLY && p.Elem != nil {
			t = p.Elem
		} else if p.Kind == types.TYP_NAMED && p.Underlying != nil {
			t = p.Underlying
		} else {
			return p
		}
	}
	return t
}
