package "pkg/binate/native/common"

import "pkg/binate/types"

// SubWordNarrow reports how an integer value of type t, held in a
// wordBits-wide register, must be re-narrowed after a width-agnostic
// operation computed it at full register width.  It returns the width
// (in bits) to reduce the result to — 0 when no narrowing is needed (t
// is nil, non-integer, or already at least host-word-wide) — and
// whether that reduction is signed (sign-extend) or unsigned
// (zero-extend).
//
// The VM and every native backend consult this one classifier, so a
// sub-word result lands in its type's value range identically across
// all execution modes (LLVM is already correct: its SSA values carry
// true widths).  wordBits is the target's register width — 64 on the
// aa64/x64 backends, the VM's host word for the bytecode VM — so the
// same int32 narrows on a 64-bit target yet is already full-width on a
// 32-bit one.  Width is read directly off the representation type: a 0
// width means host-word-wide, hence no narrow.
//
// A `readonly`/alias-/named-wrapped narrow int IS that narrow int for machine
// width and signedness, so this peels every transparent wrapper to the
// representation type (types.StripWrappers), as SizeOf and the sibling
// classifiers do.  A `readonly int8` param otherwise reads Width 0 off the
// TYP_READONLY node and is misclassified as non-narrow AND unsigned, so a
// signed value is zero-extended (a C caller's -5 reads 251).  This only
// affects PARAM classification: operation results (the emitSubWordNarrow /
// applySubWordNarrow callers) are never readonly-qualified, so for them the
// peel is a no-op and the concrete-width semantics still match ir.typeWidth.
func SubWordNarrow(t @types.Type, wordBits int) (int, bool) {
	if t == nil { return 0, false }
	t = types.StripWrappers(t)
	if t == nil || !t.IsInteger() { return 0, false }
	if t.Width > 0 && t.Width < wordBits { return t.Width, t.Signed }
	return 0, false
}

// IsUnsignedIntType reports whether t is a concrete unsigned integer
// type (uint8/16/32/64 or uint).  An untyped int literal is NOT
// unsigned: it defaults to signed `int`, and its Signed flag is unset,
// so this must require TYP_INT (excluding TYP_UNTYPED_INT) rather than
// IsInteger()+!Signed — otherwise `cast(float64, 5)` would be treated as
// unsigned.  The VM and native backends consult this to pick the
// unsigned int↔float conversion (UITOF/Ucvtf vs SITOF/Scvtf), so a
// high-bit-set unsigned value converts to a large positive float instead
// of a negative one.
func IsUnsignedIntType(t @types.Type) bool {
	t = types.StripWrappers(t)
	return t != nil && t.Kind == types.TYP_INT && !t.Signed
}
