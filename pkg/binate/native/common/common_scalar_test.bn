package "pkg/binate/native/common"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for SubWordNarrow — the shared sub-word narrowing classifier
// consulted by the VM and every native backend.

func TestSubWordNarrowInt8() testing.TestResult {
	var w int
	var s bool
	w, s = SubWordNarrow(types.TypInt8(), 64)
	if w != 8 { return "int8 on a 64-bit word should narrow to 8" }
	if !s { return "int8 narrow should be signed" }
	return ""
}

func TestSubWordNarrowUint16() testing.TestResult {
	var w int
	var s bool
	w, s = SubWordNarrow(types.TypUint16(), 64)
	if w != 16 { return "uint16 on a 64-bit word should narrow to 16" }
	if s { return "uint16 narrow should be unsigned" }
	return ""
}

func TestSubWordNarrowInt32On64() testing.TestResult {
	var w int
	var s bool
	w, s = SubWordNarrow(types.TypInt32(), 64)
	if w != 32 { return "int32 on a 64-bit word should narrow to 32" }
	if !s { return "int32 narrow should be signed" }
	return ""
}

func TestSubWordNarrowInt32On32() testing.TestResult {
	// int32 equals a 32-bit target word — already full-width, no narrow.
	var w int
	w, _ = SubWordNarrow(types.TypInt32(), 32)
	if w != 0 { return "int32 on a 32-bit word needs no narrow" }
	return ""
}

func TestSubWordNarrowInt64() testing.TestResult {
	// int64 fills the 64-bit word — no narrow.
	var w int
	w, _ = SubWordNarrow(types.TypInt64(), 64)
	if w != 0 { return "int64 on a 64-bit word needs no narrow" }
	return ""
}

func TestSubWordNarrowNonInteger() testing.TestResult {
	var w int
	w, _ = SubWordNarrow(types.TypBool(), 64)
	if w != 0 { return "bool is not a sub-word integer" }
	return ""
}

func TestSubWordNarrowNil() testing.TestResult {
	var w int
	w, _ = SubWordNarrow(nil, 64)
	if w != 0 { return "nil type needs no narrow" }
	return ""
}

func TestIsUnsignedIntTypeUnsigned() testing.TestResult {
	if !IsUnsignedIntType(types.TypUint64()) {
		return "uint64 should be an unsigned int type"
	}
	if !IsUnsignedIntType(types.TypUint8()) {
		return "uint8 should be an unsigned int type"
	}
	return ""
}

func TestIsUnsignedIntTypeSigned() testing.TestResult {
	if IsUnsignedIntType(types.TypInt32()) {
		return "int32 is signed, not unsigned"
	}
	if IsUnsignedIntType(types.TypInt()) {
		return "int is signed, not unsigned"
	}
	return ""
}

func TestIsUnsignedIntTypeUntyped() testing.TestResult {
	// Untyped int defaults to signed `int`; its Signed flag is unset, so
	// this must NOT classify it as unsigned (the gotcha the predicate
	// exists to guard).
	if IsUnsignedIntType(types.TypUntypedInt()) {
		return "untyped int defaults to signed, not unsigned"
	}
	return ""
}

func TestIsUnsignedIntTypeNonInteger() testing.TestResult {
	if IsUnsignedIntType(types.TypBool()) {
		return "bool is not an unsigned int type"
	}
	if IsUnsignedIntType(nil) { return "nil is not an unsigned int type" }
	return ""
}

// A `readonly int8` param must classify as a SIGNED sub-word narrow: the
// TYP_READONLY wrapper is transparent for machine width/signedness (SizeOf
// peels it too).  Before SubWordNarrow peeled transparent wrappers, the
// wrapper node's Width 0 made this read as non-narrow AND unsigned, so a
// signed value was zero-extended (a C caller's -5 read as 251).
func TestSubWordNarrowReadonlyInt8() testing.TestResult {
	var w int
	var s bool
	w, s = SubWordNarrow(types.MakeReadonlyType(types.TypInt8()), 64)
	if w != 8 { return "readonly int8 should narrow to 8" }
	if !s { return "readonly int8 narrow should be signed" }
	return ""
}

func TestSubWordNarrowReadonlyUint16() testing.TestResult {
	var w int
	var s bool
	w, s = SubWordNarrow(types.MakeReadonlyType(types.TypUint16()), 64)
	if w != 16 { return "readonly uint16 should narrow to 16" }
	if s { return "readonly uint16 narrow should be unsigned" }
	return ""
}

// A transparent scalar alias (`type SB = int8`) is normally pre-resolved to
// its underlying before the backend, but the classifier must still peel it.
func TestSubWordNarrowAliasInt8() testing.TestResult {
	var w int
	var s bool
	w, s = SubWordNarrow(types.MakeAliasType("SB", types.TypInt8()), 64)
	if w != 8 { return "alias int8 should narrow to 8" }
	if !s { return "alias int8 narrow should be signed" }
	return ""
}

// Wrapper order is arbitrary: readonly-over-alias must resolve to int16.
func TestSubWordNarrowReadonlyOverAlias() testing.TestResult {
	var w int
	var s bool
	var inner @types.Type = types.MakeAliasType("H", types.TypInt16())
	w, s = SubWordNarrow(types.MakeReadonlyType(inner), 64)
	if w != 16 { return "readonly-over-alias int16 should narrow to 16" }
	if !s { return "readonly-over-alias int16 narrow should be signed" }
	return ""
}

// readonly must be peeled: a `readonly uint8` is still unsigned, a `readonly int8`
// still signed.  A named-only peel read the wrapper's default-false Signed and
// mis-picked the signed int->float conversion for readonly unsigned values.
func TestIsUnsignedIntTypeReadonly() testing.TestResult {
	if !IsUnsignedIntType(types.MakeReadonlyType(types.TypUint8())) {
		return "readonly uint8 is unsigned"
	}
	if IsUnsignedIntType(types.MakeReadonlyType(types.TypInt8())) {
		return "readonly int8 is signed, not unsigned"
	}
	return ""
}
