package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/std/containers/vec"

// Spill slots shared by lifetime.  A value the register allocator does not home is
// stored to its spill slot only while it is live (a dirty value is stored on
// eviction only if it is in CurLive, StoreOnEvict) and reloaded from it only at a
// use, which the liveness sees (every read of a value is one the liveness covers,
// or a backend fold moves the use there).  So the slots of two values whose live
// spans do not meet can be the same bytes.  PlanFrame gives the values whose spans
// it knows (noteLiveSpans) such shared slots (planSharedSpills); any other value
// keeps a slot of its own.  An aggregate value with no bytes of its own (a member of
// another, a load read in place) has a slot holding the address of the bytes it reads,
// stored at its definition and read at its uses, so it shares by the value's own live
// span the same way (noteAggregateSpans).

// noteLiveSpans records in m.liveSpans the span of each value in intervals: its
// first live position, its last live position plus one, and the position of its
// definition (-1 for a parameter), three ints per value id, -1 where absent.
// AllocateRegisters calls it with fresh set, clearing every earlier entry, and
// AllocateFpRegisters then adds its own class's values; positions are the ones
// ComputeLiveness assigns, the same for both classes.
func (m @RegMap) noteLiveSpans(f @ir.Func, intervals @[]@LiveInterval, fresh bool) {
	m.sizeLiveSpans(f, fresh)
	for i := 0; i < len(intervals); i++ {
		var iv @LiveInterval = intervals[i]
		if iv.ID < 0 || iv.ID >= f.NextID || len(iv.Ranges) == 0 { continue }
		m.liveSpans[3 * iv.ID] = iv.Start()
		m.liveSpans[3 * iv.ID + 1] = iv.End()
		m.liveSpans[3 * iv.ID + 2] = iv.DefPos
	}
}

// sizeLiveSpans makes m.liveSpans hold f's value ids, every entry -1 when fresh, else
// keeping the entries it has.
func (m @RegMap) sizeLiveSpans(f @ir.Func, fresh bool) {
	if !fresh && len(m.liveSpans) >= 3 * f.NextID { return }
	var spans @[]int = make_slice(int, 3 * f.NextID)
	for i := 0; i < len(spans); i++ {
		spans[i] = -1
		if !fresh && i < len(m.liveSpans) { spans[i] = m.liveSpans[i] }
	}
	m.liveSpans = spans
}

// noteAggregateSpans records in m.liveSpans the span of each aggregate value of f whose
// slot, where it has one, holds the address of its bytes -- every one but a
// multi-return call's, whose slot holds the values themselves -- as its live hull (lo /
// hi, aggregateHulls), defined at the hull's start.  A value with no hull keeps a slot
// of its own.
func (m @RegMap) noteAggregateSpans(f @ir.Func, lo @[]int, hi @[]int) {
	if len(lo) == 0 { return }
	m.sizeLiveSpans(f, false)
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			var id int = ins.ID
			if id < 0 || id >= len(lo) || lo[id] < 0 || !callconv.IsAggregateTyp(ins.Typ) ||
					callconv.IsMultiReturnCall(ins) {
				continue
			}
			m.liveSpans[3 * id] = lo[id]
			m.liveSpans[3 * id + 1] = hi[id]
			m.liveSpans[3 * id + 2] = lo[id]
		}
	}
}

// sharedSpan returns the span in which the spill slot of the value ins is used, and
// whether PlanFrame may give it a shared slot: whether its span is known, which also
// makes it a scalar the allocator classes or an aggregate value whose slot holds its
// address (noteAggregateSpans).  A value with no
// home uses its slot while it is live; so does a homed indirect call target (the
// call saves it there, while it is live).  A homed call or OP_BOX result's slot is
// used only by the instruction that defines it (needsSpillSlot), so its span is that
// one position; so is the slot of an indirect call with bytes of its own (owns,
// regionPlan), which x64 uses only while the call places its arguments.
func (m @RegMap) sharedSpan(ins @ir.Instr, targets @[]bool, owns @[]bool) (int, int, bool) {
	var id int = ins.ID
	if id < 0 || 3 * id + 2 >= len(m.liveSpans) || m.liveSpans[3 * id] < 0 {
		return -1, -1, false
	}
	var homed bool = m.LookupHome(id) >= 0 && !(id < len(targets) && targets[id])
	if homed || (id < len(owns) && owns[id]) {
		var def int = m.liveSpans[3 * id + 2]
		if def < 0 { return -1, -1, false }
		return def, def + 1, true
	}
	return m.liveSpans[3 * id], m.liveSpans[3 * id + 1], true
}

// planSharedSpills gives every value of f that needs a spill slot (needsSpillSlot,
// targets as indirectCallTargets returns them, owns as regionPlan holds them) and has
// a known span (sharedSpan) a
// shared slot from offset up (packSpillSlots), appending each to spillIDs and
// spillOffsets, and returns which values it placed (by id) and the offset past the
// slots, rounded up to 8; a void indirect call's slot, a stash for its target
// (StashesCallTarget), spans the call's one position.  Each slot size (spillSlotBytes)
// packs on its own: the 8-byte
// slots first, from offset (8-aligned), then the 4-byte ones of a 32-bit target.
// PlanFrame calls it before it lays down the regions and allocas, so the
// spill slots sit nearest SP, where their frequent accesses take the shortest
// offsets, and its walk skips the values placed here.
func (m @RegMap) planSharedSpills(f @ir.Func, targets @[]bool, owns @[]bool, spillIDs @vec.Vec[int],
		spillOffsets @vec.Vec[int64], offset int64) (@[]bool, int64) {
	var placed @[]bool = make_slice(bool, f.NextID)
	var ids @vec.Vec[int] = vec.New[int]()
	var starts @vec.Vec[int] = vec.New[int]()
	var ends @vec.Vec[int] = vec.New[int]()
	var sizes @vec.Vec[int64] = vec.New[int64]()
	var cfg @LiveCFG
	if m.StashesCallTarget { cfg = m.liveCFGOf(f) }
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if ins.ID < 0 || ins.ID >= f.NextID || placed[ins.ID] || ins.Op == iropcode.OP_ALLOC ||
					!m.needsSpillSlot(ins, targets, owns) {
				continue
			}
			var start int = -1
			var end int = -1
			var ok bool = false
			if InstrIsVoid(ins) {
				// A void indirect call's slot holds only its target, while the call places
				// its arguments (StashesCallTarget): its span is the call's one position.
				if cfg == nil || !callconv.IsIndirectCallOp(ins.Op) || bi >= len(cfg.blockFrom) ||
						cfg.blockFrom[bi] < 0 {
					continue
				}
				start = cfg.blockFrom[bi] + ii
				end = start + 1
				ok = true
			} else {
				start, end, ok = m.sharedSpan(ins, targets, owns)
			}
			if !ok { continue }
			placed[ins.ID] = true
			ids.Push(ins.ID)
			starts.Push(start)
			ends.Push(end)
			sizes.Push(m.spillSlotBytes(ins))
		}
	}
	var past int64 = offset
	var packed int = 0
	for pass := 0; pass < 2; pass++ {
		var slotBytes int64 = 8
		if pass == 1 { slotBytes = 4 }
		var ks @vec.Vec[int] = vec.New[int]()
		var cs @vec.Vec[int] = vec.New[int]()
		var ce @vec.Vec[int] = vec.New[int]()
		for k := 0; k < ids.Len(); k++ {
			if sizes.Get(k) != slotBytes { continue }
			ks.Push(k)
			cs.Push(starts.Get(k))
			ce.Push(ends.Get(k))
		}
		offs, next := packSpillSlots(cs.Items(), ce.Items(), past, slotBytes)
		for j := 0; j < len(offs); j++ {
			spillIDs.Push(ids.Get(ks.Get(j)))
			spillOffsets.Push(offs[j])
		}
		packed = packed + len(offs)
		past = next
	}
	if packed != ids.Len() { panic("internal error: a spill slot size other than 4 or 8 bytes") }
	return placed, roundUp8(past)
}

// packSpillSlots gives value k (its span [starts[k], ends[k]), ends[k] > starts[k] >=
// 0) a slot of slotBytes at offs[k], from offset up, and returns offs and the offset past
// the last slot (both saturating, frameAdd).  Values whose spans do not meet may
// share a slot: the values are taken in order of span start, each into a slot whose
// last value's span has ended, or a new one.  Spans are intervals, so this uses as
// many slots as the most spans that meet at one position -- the fewest possible.
// Both orders come from buckets by position, so the cost is linear in the values and
// the positions.
func packSpillSlots(starts @[]int, ends @[]int, offset int64, slotBytes int64) (@[]int64, int64) {
	var n int = len(starts)
	var offs @[]int64 = make_slice(int64, n)
	var last int = 0
	for k := 0; k < n; k++ {
		if ends[k] > last { last = ends[k] }
	}
	// Values by span start, and slots by the end of their last value's span: each a
	// list per position, threaded through next arrays and ended by -1.
	var byStart @[]int = make_slice(int, last + 1)
	var byEnd @[]int = make_slice(int, last + 1)
	for p := 0; p <= last; p++ {
		byStart[p] = -1
		byEnd[p] = -1
	}
	var nextValue @[]int = make_slice(int, n)
	for k := n - 1; k >= 0; k-- {
		nextValue[k] = byStart[starts[k]]
		byStart[starts[k]] = k
	}
	var nextSlot @[]int = make_slice(int, n)
	var free @[]int = make_slice(int, n)
	var nFree int = 0
	var slots int = 0
	for p := 0; p <= last; p++ {
		for s := byEnd[p]; s >= 0; s = nextSlot[s] {
			free[nFree] = s
			nFree++
		}
		for k := byStart[p]; k >= 0; k = nextValue[k] {
			var s int = slots
			if nFree > 0 {
				nFree--
				s = free[nFree]
			} else {
				slots++
			}
			offs[k] = frameAdd(offset, slotBytes * cast(int64, s))
			nextSlot[s] = byEnd[ends[k]]
			byEnd[ends[k]] = s
		}
	}
	return offs, frameAdd(offset, slotBytes * cast(int64, slots))
}
