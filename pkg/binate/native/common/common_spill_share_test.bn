package "pkg/binate/native/common"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/irutil"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for common_spill_share.bn: spill slots shared by live span.

// spanInterval returns the interval of value id: one range [start, end), defined at
// def.
func spanInterval(id int, start int, end int, def int) @LiveInterval {
	var iv @LiveInterval = make(LiveInterval)
	iv.ID = id
	iv.Ranges = make_slice(LiveRange, 1)
	iv.Ranges[0].Start = start
	iv.Ranges[0].End = end
	iv.DefPos = def
	return iv
}

// packCase packs spans (start, end pairs) from offset 16 and returns the offsets,
// as "o0 o1 ... | past".
func packCase(spans *[]int) @[]char {
	var starts @[]int = make_slice(int, len(spans) / 2)
	var ends @[]int = make_slice(int, len(spans) / 2)
	for k := 0; k < len(starts); k++ {
		starts[k] = spans[2 * k]
		ends[k] = spans[2 * k + 1]
	}
	offs, past := packSpillSlots(starts, ends, 16)
	var out @strings.Builder = strings.NewBuilder()
	for k := 0; k < len(offs); k++ {
		stringutils.WriteInt64(out, offs[k])
		out.Write(" ")
	}
	out.Write("| ")
	stringutils.WriteInt64(out, past)
	return buf.CopyStr(out.String())
}

// packSpillSlots shares a slot between spans that do not meet (a span ending where
// another starts included), never between spans that do, and uses as many slots as
// the most spans that meet at one position.
func TestPackSpillSlots() testing.TestResult {
	var none @[]int
	if !irutil.Streq(packCase(none), "| 16") { return buf.Concat("no values: ", packCase(none)) }
	// Disjoint and adjacent: one slot.
	var a @[]int = @[]int{0, 2, 2, 4, 5, 9}
	if !irutil.Streq(packCase(a), "16 16 16 | 24") {
		return buf.Concat("disjoint spans: ", packCase(a))
	}
	// Overlapping: one slot each.
	var b @[]int = @[]int{0, 5, 1, 3, 2, 4}
	if !irutil.Streq(packCase(b), "16 24 32 | 40") {
		return buf.Concat("overlapping spans: ", packCase(b))
	}
	// Two live at once at most: two slots, the third value reusing the one freed first.
	var c @[]int = @[]int{0, 3, 1, 6, 3, 8}
	if !irutil.Streq(packCase(c), "16 24 16 | 32") { return buf.Concat("two at once: ", packCase(c)) }
	return ""
}

// packSpillSlots saturates its offsets as frameAdd does, rather than wrapping past a
// saturated frame.
func TestPackSpillSlotsSaturates() testing.TestResult {
	var starts @[]int = @[]int{0, 0}
	var ends @[]int = @[]int{1, 1}
	offs, past := packSpillSlots(starts, ends, frameSaturated - 4)
	if offs[0] != frameSaturated - 4 { return "the first slot must sit at the offset given" }
	if offs[1] != frameSaturated || past != frameSaturated {
		return "slots past the limit must saturate"
	}
	return ""
}

// PlanFrame gives two values with no home whose spans do not meet one slot, and a
// third whose span meets both a slot of its own.
func TestPlanFrameSharesSpillSlots() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt64())
	var y @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, x, x, types.TypInt64())
	var z @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, y, y, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 3)
	ivs[0] = spanInterval(x.ID, 0, 2, 0)
	ivs[1] = spanInterval(y.ID, 1, 3, 1)
	ivs[2] = spanInterval(z.ID, 2, 3, 2)
	m.noteLiveSpans(f, ivs, true)
	m.PlanFrame(f)
	var ox int64 = m.LookupSpill(x.ID)
	var oy int64 = m.LookupSpill(y.ID)
	var oz int64 = m.LookupSpill(z.ID)
	if ox < 0 || oy < 0 || oz < 0 { return "every value here must have a slot" }
	if ox != oz { return "x and z, whose spans do not meet, must share a slot" }
	if oy == ox { return "y, live with both x and z, must have a slot of its own" }
	if m.FrameSize != 16 { return "two shared slots must make a 16-byte frame" }
	return ""
}

// A homed call result's slot is used only at its call, so it is free from the next
// position on, however long the result stays live in its home: here the frame has two
// slots (b takes r's), where the result's whole live span would need three.
func TestPlanFrameHomedCallResultSlotIsItsCall() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt64())
	var noArgs @[]@ir.Instr
	var r @ir.Instr = irbuild.EmitCall(b, "g", noArgs, types.TypInt64())
	var y @ir.Instr = irbuild.EmitConstInt(b, 4, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 3)
	ivs[0] = spanInterval(x.ID, 0, 10, 0)
	ivs[1] = spanInterval(r.ID, 3, 10, 3)
	ivs[2] = spanInterval(y.ID, 4, 10, 4)
	m.noteLiveSpans(f, ivs, true)
	homeAt(m, r.ID, 19)
	m.PlanFrame(f)
	if m.LookupSpill(r.ID) < 0 { return "the homed call result must keep a slot" }
	if m.LookupSpill(y.ID) != m.LookupSpill(r.ID) {
		return "y, born after the call, must take the homed result's slot"
	}
	if m.FrameSize != 16 { return "the frame must hold two slots" }
	return ""
}

// A homed indirect call's target keeps its slot over its whole live span (the call
// saves it there): a value live inside that span may not share it.
func TestPlanFrameHomedTargetSlotIsItsSpan() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var target @ir.Instr = irbuild.EmitConstInt(b, 0, types.TypInt())
	var v @ir.Instr = irbuild.EmitConstInt(b, 1, types.TypInt())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = v
	irbuild.EmitCallIndirect(b, target, args, types.TypVoid())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 2)
	ivs[0] = spanInterval(target.ID, 0, 3, 0)
	ivs[1] = spanInterval(v.ID, 1, 3, 1)
	m.noteLiveSpans(f, ivs, true)
	homeAt(m, target.ID, 0)
	m.PlanFrame(f)
	if m.LookupSpill(target.ID) < 0 || m.LookupSpill(v.ID) < 0 { return "both values must have slots" }
	if m.LookupSpill(target.ID) == m.LookupSpill(v.ID) {
		return "a value live within the homed target's span must not share its slot"
	}
	return ""
}

// A value UnhomeIDs takes out of its home (arm32's call operands) uses its slot over
// its whole live span.
func TestPlanFrameUnhomedValueUsesItsSpan() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var v @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt64())
	var w @ir.Instr = irbuild.EmitConstInt(b, 4, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 2)
	ivs[0] = spanInterval(v.ID, 0, 5, 0)
	ivs[1] = spanInterval(w.ID, 2, 3, 2)
	m.noteLiveSpans(f, ivs, true)
	homeAt(m, v.ID, 1)
	var drop @[]bool = make_slice(bool, f.NextID)
	drop[v.ID] = true
	m.UnhomeIDs(drop)
	m.PlanFrame(f)
	if m.LookupSpill(v.ID) < 0 { return "an unhomed value must have a slot" }
	if m.LookupSpill(v.ID) == m.LookupSpill(w.ID) {
		return "an unhomed value's slot spans its live span"
	}
	return ""
}

// A value whose span the allocator did not record keeps a slot of its own.
func TestPlanFrameUnrecordedSpanKeepsOwnSlot() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt64())
	var y @ir.Instr = irbuild.EmitConstInt(b, 4, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 1)
	ivs[0] = spanInterval(x.ID, 0, 1, 0)
	m.noteLiveSpans(f, ivs, true)
	m.PlanFrame(f)
	if m.LookupSpill(x.ID) < 0 || m.LookupSpill(y.ID) < 0 { return "both values must have slots" }
	if m.LookupSpill(x.ID) == m.LookupSpill(y.ID) {
		return "a value with no recorded span must not share a slot"
	}
	return ""
}

// The shared spill slots sit below the allocas and regions, nearest SP.
func TestPlanFrameSharedSlotsBeforeAllocas() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var slot @ir.Instr = irbuild.EmitAlloc(b, types.TypInt64())
	var x @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 1)
	ivs[0] = spanInterval(x.ID, 1, 2, 1)
	m.noteLiveSpans(f, ivs, true)
	m.PlanFrame(f)
	if m.LookupSpill(x.ID) < 0 || m.LookupAlloc(slot.ID) < 0 { return "both must have their places" }
	if m.LookupSpill(x.ID) > m.LookupAlloc(slot.ID) {
		return "the shared slot must sit below the alloca"
	}
	return ""
}

// noteLiveSpans with fresh set drops every earlier entry; without it, it adds the
// values given to the ones recorded (the FP pass after the GP pass).
func TestNoteLiveSpansFreshAndAdded() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt64())
	var y @ir.Instr = irbuild.EmitConstInt(b, 4, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	var gp @[]@LiveInterval = make_slice(@LiveInterval, 1)
	gp[0] = spanInterval(x.ID, 0, 2, 0)
	var fp @[]@LiveInterval = make_slice(@LiveInterval, 1)
	fp[0] = spanInterval(y.ID, 1, 2, 1)
	var none @[]@LiveInterval
	var noTargets @[]bool
	m.noteLiveSpans(f, gp, true)
	m.noteLiveSpans(f, fp, false)
	_, _, okx := m.sharedSpan(x, noTargets)
	_, _, oky := m.sharedSpan(y, noTargets)
	if !okx || !oky { return "both passes' spans must be recorded" }
	m.noteLiveSpans(f, none, true)
	_, _, okx2 := m.sharedSpan(x, noTargets)
	if okx2 { return "a fresh record must drop the earlier spans" }
	return ""
}
