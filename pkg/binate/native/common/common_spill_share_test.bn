package "pkg/binate/native/common"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/irutil"
import "pkg/binate/native/callconv"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for common_spill_share.bn: spill slots shared by live span.

// spanInterval returns the interval of value id: one range [start, end), defined at
// def.
func spanInterval(id int, start int, end int, def int) @LiveInterval {
	var iv @LiveInterval = make(LiveInterval)
	iv.ID = id
	iv.Ranges = make_slice(LiveRange, 1)
	iv.Ranges[0].Start = start
	iv.Ranges[0].End = end
	iv.DefPos = def
	return iv
}

// packCase packs spans (start, end pairs) from offset 16 and returns the offsets,
// as "o0 o1 ... | past".
func packCase(spans *[]int) @[]char {
	var starts @[]int = make_slice(int, len(spans) / 2)
	var ends @[]int = make_slice(int, len(spans) / 2)
	for k := 0; k < len(starts); k++ {
		starts[k] = spans[2 * k]
		ends[k] = spans[2 * k + 1]
	}
	offs, past := packSpillSlots(starts, ends, 16, 8)
	var out @strings.Builder = strings.NewBuilder()
	for k := 0; k < len(offs); k++ {
		stringutils.WriteInt64(out, offs[k])
		out.Write(" ")
	}
	out.Write("| ")
	stringutils.WriteInt64(out, past)
	return buf.CopyStr(out.String())
}

// packSpillSlots shares a slot between spans that do not meet (a span ending where
// another starts included), never between spans that do, and uses as many slots as
// the most spans that meet at one position.
func TestPackSpillSlots() testing.TestResult {
	var none @[]int
	if !irutil.Streq(packCase(none), "| 16") { return buf.Concat("no values: ", packCase(none)) }
	// Disjoint and adjacent: one slot.
	var a @[]int = @[]int{0, 2, 2, 4, 5, 9}
	if !irutil.Streq(packCase(a), "16 16 16 | 24") {
		return buf.Concat("disjoint spans: ", packCase(a))
	}
	// Overlapping: one slot each.
	var b @[]int = @[]int{0, 5, 1, 3, 2, 4}
	if !irutil.Streq(packCase(b), "16 24 32 | 40") {
		return buf.Concat("overlapping spans: ", packCase(b))
	}
	// Two live at once at most: two slots, the third value reusing the one freed first.
	var c @[]int = @[]int{0, 3, 1, 6, 3, 8}
	if !irutil.Streq(packCase(c), "16 24 16 | 32") { return buf.Concat("two at once: ", packCase(c)) }
	return ""
}

// packSpillSlots saturates its offsets as frameAdd does, rather than wrapping past a
// saturated frame.
func TestPackSpillSlotsSaturates() testing.TestResult {
	var starts @[]int = @[]int{0, 0}
	var ends @[]int = @[]int{1, 1}
	offs, past := packSpillSlots(starts, ends, frameSaturated - 4, 8)
	if offs[0] != frameSaturated - 4 { return "the first slot must sit at the offset given" }
	if offs[1] != frameSaturated || past != frameSaturated {
		return "slots past the limit must saturate"
	}
	return ""
}

// PlanFrame gives two values with no home whose spans do not meet one slot, and a
// third whose span meets both a slot of its own.
func TestPlanFrameSharesSpillSlots() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt64())
	var y @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, x, x, types.TypInt64())
	var z @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, y, y, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 3)
	ivs[0] = spanInterval(x.ID, 0, 2, 0)
	ivs[1] = spanInterval(y.ID, 1, 3, 1)
	ivs[2] = spanInterval(z.ID, 2, 3, 2)
	m.noteLiveSpans(f, ivs, true)
	m.PlanFrame(f)
	var ox int64 = m.LookupSpill(x.ID)
	var oy int64 = m.LookupSpill(y.ID)
	var oz int64 = m.LookupSpill(z.ID)
	if ox < 0 || oy < 0 || oz < 0 { return "every value here must have a slot" }
	if ox != oz { return "x and z, whose spans do not meet, must share a slot" }
	if oy == ox { return "y, live with both x and z, must have a slot of its own" }
	if m.FrameSize != 16 { return "two shared slots must make a 16-byte frame" }
	return ""
}

// A homed call result's slot is used only at its call, so it is free from the next
// position on, however long the result stays live in its home: here the frame has two
// slots (b takes r's), where the result's whole live span would need three.
func TestPlanFrameHomedCallResultSlotIsItsCall() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt64())
	var noArgs @[]@ir.Instr
	var r @ir.Instr = irbuild.EmitCall(b, "g", noArgs, types.TypInt64())
	var y @ir.Instr = irbuild.EmitConstInt(b, 4, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 3)
	ivs[0] = spanInterval(x.ID, 0, 10, 0)
	ivs[1] = spanInterval(r.ID, 3, 10, 3)
	ivs[2] = spanInterval(y.ID, 4, 10, 4)
	m.noteLiveSpans(f, ivs, true)
	homeAt(m, r.ID, 19)
	m.PlanFrame(f)
	if m.LookupSpill(r.ID) < 0 { return "the homed call result must keep a slot" }
	if m.LookupSpill(y.ID) != m.LookupSpill(r.ID) {
		return "y, born after the call, must take the homed result's slot"
	}
	if m.FrameSize != 16 { return "the frame must hold two slots" }
	return ""
}

// A homed indirect call's target keeps its slot over its whole live span (the call
// saves it there): a value live inside that span may not share it.
func TestPlanFrameHomedTargetSlotIsItsSpan() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var target @ir.Instr = irbuild.EmitConstInt(b, 0, types.TypInt())
	var v @ir.Instr = irbuild.EmitConstInt(b, 1, types.TypInt())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = v
	irbuild.EmitCallIndirect(b, target, args, types.TypVoid())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 2)
	ivs[0] = spanInterval(target.ID, 0, 3, 0)
	ivs[1] = spanInterval(v.ID, 1, 3, 1)
	m.noteLiveSpans(f, ivs, true)
	homeAt(m, target.ID, 0)
	m.PlanFrame(f)
	if m.LookupSpill(target.ID) < 0 || m.LookupSpill(v.ID) < 0 { return "both values must have slots" }
	if m.LookupSpill(target.ID) == m.LookupSpill(v.ID) {
		return "a value live within the homed target's span must not share its slot"
	}
	return ""
}

// A value UnhomeIDs takes out of its home (arm32's call operands) uses its slot over
// its whole live span.
func TestPlanFrameUnhomedValueUsesItsSpan() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var v @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt64())
	var w @ir.Instr = irbuild.EmitConstInt(b, 4, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 2)
	ivs[0] = spanInterval(v.ID, 0, 5, 0)
	ivs[1] = spanInterval(w.ID, 2, 3, 2)
	m.noteLiveSpans(f, ivs, true)
	homeAt(m, v.ID, 1)
	var drop @[]bool = make_slice(bool, f.NextID)
	drop[v.ID] = true
	m.UnhomeIDs(drop)
	m.PlanFrame(f)
	if m.LookupSpill(v.ID) < 0 { return "an unhomed value must have a slot" }
	if m.LookupSpill(v.ID) == m.LookupSpill(w.ID) {
		return "an unhomed value's slot spans its live span"
	}
	return ""
}

// A value whose span the allocator did not record keeps a slot of its own.
func TestPlanFrameUnrecordedSpanKeepsOwnSlot() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt64())
	var y @ir.Instr = irbuild.EmitConstInt(b, 4, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 1)
	ivs[0] = spanInterval(x.ID, 0, 1, 0)
	m.noteLiveSpans(f, ivs, true)
	m.PlanFrame(f)
	if m.LookupSpill(x.ID) < 0 || m.LookupSpill(y.ID) < 0 { return "both values must have slots" }
	if m.LookupSpill(x.ID) == m.LookupSpill(y.ID) {
		return "a value with no recorded span must not share a slot"
	}
	return ""
}

// The shared spill slots sit below the allocas and regions, nearest SP.
func TestPlanFrameSharedSlotsBeforeAllocas() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var slot @ir.Instr = irbuild.EmitAlloc(b, types.TypInt64())
	var x @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 1)
	ivs[0] = spanInterval(x.ID, 1, 2, 1)
	m.noteLiveSpans(f, ivs, true)
	m.PlanFrame(f)
	if m.LookupSpill(x.ID) < 0 || m.LookupAlloc(slot.ID) < 0 { return "both must have their places" }
	if m.LookupSpill(x.ID) > m.LookupAlloc(slot.ID) {
		return "the shared slot must sit below the alloca"
	}
	return ""
}

// noteLiveSpans with fresh set drops every earlier entry; without it, it adds the
// values given to the ones recorded (the FP pass after the GP pass).
func TestNoteLiveSpansFreshAndAdded() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt64())
	var y @ir.Instr = irbuild.EmitConstInt(b, 4, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	var gp @[]@LiveInterval = make_slice(@LiveInterval, 1)
	gp[0] = spanInterval(x.ID, 0, 2, 0)
	var fp @[]@LiveInterval = make_slice(@LiveInterval, 1)
	fp[0] = spanInterval(y.ID, 1, 2, 1)
	var none @[]@LiveInterval
	var noTargets @[]bool
	var noOwners @[]bool
	m.noteLiveSpans(f, gp, true)
	m.noteLiveSpans(f, fp, false)
	_, _, okx := m.sharedSpan(x, noTargets, noOwners)
	_, _, oky := m.sharedSpan(y, noTargets, noOwners)
	if !okx || !oky { return "both passes' spans must be recorded" }
	m.noteLiveSpans(f, none, true)
	_, _, okx2 := m.sharedSpan(x, noTargets, noOwners)
	if okx2 { return "a fresh record must drop the earlier spans" }
	return ""
}

// mkMember emits a call to mk returning a QuadPair and an extract of its second Quad --
// a member, with no bytes of its own -- and returns the member.
func mkMember(e @ir.Block) @ir.Instr {
	var pair @ir.Instr = irbuild.EmitCall(e, "mk", make_slice(@ir.Instr, 0), quadPairTyp())
	return irbuild.EmitExtract(e, pair, 1, elisionQuadTyp())
}

// The pointer slot of an aggregate value with no bytes of its own -- a member of a call
// result -- is shared by the value's own live span: two members, the first read before
// the second is made, share one; read after it, they do not.
func TestPlanFrameSharesAggregatePointerSlots() testing.TestResult {
	setTarget64()
	f, e := regionFunc()
	var x @ir.Instr = mkMember(e)
	readField(e, x)
	var y @ir.Instr = mkMember(e)
	readField(e, y)
	irbuild.EmitReturn(e, elisionNoRets())
	var m @RegMap = nrm()
	m.PlanFrame(f)
	if m.LookupSpill(x.ID) < 0 || m.LookupSpill(x.ID) != m.LookupSpill(y.ID) {
		return "two pointer slots whose spans do not meet are one"
	}
	f, e = regionFunc()
	x = mkMember(e)
	y = mkMember(e)
	readField(e, x)
	readField(e, y)
	irbuild.EmitReturn(e, elisionNoRets())
	m = nrm()
	m.PlanFrame(f)
	if m.LookupSpill(x.ID) < 0 || m.LookupSpill(x.ID) == m.LookupSpill(y.ID) {
		return "pointer slots whose spans meet are two"
	}
	return ""
}

// A multi-return call's slot holds its values, not their address, and keeps bytes of its
// own even where the results' spans do not meet.
func TestPlanFrameMultiReturnSlotKeepsOwnBytes() testing.TestResult {
	setTarget64()
	var pair @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		pair[i] = make(types.Field)
		pair[i].Type = types.TypInt()
	}
	var tuple @types.Type = types.MakeStructType("", pair)
	f, e := regionFunc()
	var a @ir.Instr = irbuild.EmitCall(e, "two", make_slice(@ir.Instr, 0), tuple)
	irbuild.EmitExtract(e, a, 0, types.TypInt())
	var b @ir.Instr = irbuild.EmitCall(e, "two", make_slice(@ir.Instr, 0), tuple)
	irbuild.EmitExtract(e, b, 0, types.TypInt())
	irbuild.EmitReturn(e, elisionNoRets())
	if !callconv.IsMultiReturnCall(a) { return "the calls are multi-return calls" }
	var m @RegMap = nrm()
	m.PlanFrame(f)
	if m.LookupSpill(a.ID) < 0 || m.LookupSpill(a.ID) == m.LookupSpill(b.ID) {
		return "each multi-return call keeps a slot of its own"
	}
	return ""
}

// quadPairTyp returns a struct of two Quads.
func quadPairTyp() @types.Type {
	var pair @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		pair[i] = make(types.Field)
		pair[i].Type = elisionQuadTyp()
	}
	return types.MakeStructType("QuadPair", pair)
}

// A member extracted from an aggregate value has no region: its slot holds an address
// inside the value's, and the backends read that slot at the member's uses.  The call
// results own their bytes, so they have regions and no slots; their members, each used
// before the next is made, share one slot.
func TestPlanFrameSharesAliasPointerSlots() testing.TestResult {
	setTarget64()
	f, e := regionFunc()
	var a @ir.Instr = irbuild.EmitCall(e, "mk", make_slice(@ir.Instr, 0), quadPairTyp())
	var x @ir.Instr = irbuild.EmitExtract(e, a, 1, elisionQuadTyp())
	readField(e, x)
	var b @ir.Instr = irbuild.EmitCall(e, "mk", make_slice(@ir.Instr, 0), quadPairTyp())
	var y @ir.Instr = irbuild.EmitExtract(e, b, 1, elisionQuadTyp())
	readField(e, y)
	irbuild.EmitReturn(e, elisionNoRets())
	var m @RegMap = nrm()
	m.PlanFrame(f)
	if m.LookupAlloc(x.ID) >= 0 || m.LookupAlloc(y.ID) >= 0 {
		return "a member has no region of its own"
	}
	if m.LookupAlloc(a.ID) < 0 || m.LookupAlloc(b.ID) < 0 { return "a call result has a region" }
	if m.LookupSpill(a.ID) >= 0 || m.LookupSpill(b.ID) >= 0 {
		return "a call result with a region has no slot"
	}
	if m.LookupSpill(x.ID) < 0 || m.LookupSpill(x.ID) != m.LookupSpill(y.ID) {
		return "the members' slots are one, as they are never live at once"
	}
	return ""
}

// On a 32-bit target a word-sized value's slot is 4 bytes and a 64-bit one's 8, each
// size packed on its own, the 8-byte slots first: an int64 and two ints live at once
// take 16 bytes (8 + 4 + 4), not three 8-byte slots.
func TestPlanFrameWordSlotsOn32Bit() testing.TestResult {
	setTarget32()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt())
	var y @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, x, x, types.TypInt())
	var w @ir.Instr = irbuild.EmitConstInt(b, 4, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = NewRegMap(callconv.AAPCS32())
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 3)
	ivs[0] = spanInterval(x.ID, 0, 3, 0)
	ivs[1] = spanInterval(y.ID, 1, 3, 1)
	ivs[2] = spanInterval(w.ID, 2, 3, 2)
	m.noteLiveSpans(f, ivs, true)
	m.PlanFrame(f)
	setTarget64()
	var ox int64 = m.LookupSpill(x.ID)
	var oy int64 = m.LookupSpill(y.ID)
	var ow int64 = m.LookupSpill(w.ID)
	if ox < 0 || oy < 0 || ow < 0 { return "every value here must have a slot" }
	if ow % 8 != 0 { return "the int64's slot is 8-aligned" }
	if ox != ow + 8 && oy != ow + 8 { return "the 4-byte slots follow the 8-byte one" }
	if ox - oy != 4 && oy - ox != 4 { return "the two ints take 4-byte slots side by side" }
	if m.FrameSize != 16 { return "an int64 and two ints live at once make a 16-byte frame" }
	return ""
}

// On a 32-bit target an int parameter's slot is 4 bytes and an int64 one's 8, at an
// 8-aligned offset.
func TestPlanFrameParamSlotsOn32Bit() testing.TestResult {
	setTarget32()
	var ps @[]@ir.Param = make_slice(@ir.Param, 3)
	var pt @[]@types.Type = make_slice(@types.Type, 3)
	pt[0] = types.TypInt()
	pt[1] = types.TypInt64()
	pt[2] = types.TypInt()
	for i := 0; i < 3; i++ {
		ps[i] = make(ir.Param)
		ps[i].ID = i
		ps[i].Typ = pt[i]
	}
	var f @ir.Func = ir.NewFunc("", "t", ps, makeNoResults())
	irbuild.EmitReturn(ir.AddBlock(f, "entry"), makeNoInstrs())
	var m @RegMap = NewRegMap(callconv.AAPCS32())
	m.PlanFrame(f)
	setTarget64()
	var o0 int64 = m.LookupSpill(ps[0].ID)
	var o1 int64 = m.LookupSpill(ps[1].ID)
	var o2 int64 = m.LookupSpill(ps[2].ID)
	if o0 != 0 || o1 != 8 || o2 != 16 {
		return "the int's 4-byte slot at 0, the int64's 8 bytes at 8, the next int's at 16"
	}
	// An aggregate parameter's region after a 4-byte slot starts 8-aligned.
	setTarget32()
	var qs @[]@ir.Param = make_slice(@ir.Param, 2)
	qs[0] = make(ir.Param)
	qs[0].ID = 0
	qs[0].Typ = types.TypInt()
	qs[1] = make(ir.Param)
	qs[1].ID = 1
	qs[1].Typ = types.MakeSliceType(types.TypInt())
	var g @ir.Func = ir.NewFunc("", "u", qs, makeNoResults())
	irbuild.EmitReturn(ir.AddBlock(g, "entry"), makeNoInstrs())
	var n @RegMap = NewRegMap(callconv.AAPCS32())
	n.PlanFrame(g)
	setTarget64()
	if n.LookupSpill(qs[0].ID) != 0 || n.LookupAlloc(qs[1].ID) != 8 {
		return "a raw-slice parameter's region after an int's 4-byte slot starts at 8"
	}
	return ""
}

// On a 32-bit target each placement the walk makes stays aligned: values with no
// recorded span get slots of their own in instruction order -- an int's 4 bytes at 0,
// then an alloca at the next 8-aligned offset (8), another int's 4 bytes after it (16)
// and an int64's 8 at the next 8-aligned offset (24).
func TestPlanFrameWalkStaysAlignedOn32Bit() testing.TestResult {
	setTarget32()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt())
	var a @ir.Instr = irbuild.EmitAlloc(b, types.TypInt())
	var y @ir.Instr = irbuild.EmitConstInt(b, 5, types.TypInt())
	var w @ir.Instr = irbuild.EmitConstInt(b, 4, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = NewRegMap(callconv.AAPCS32())
	m.PlanFrame(f)
	setTarget64()
	if m.LookupSpill(x.ID) != 0 || m.LookupAlloc(a.ID) != 8 || m.LookupSpill(y.ID) != 16 ||
			m.LookupSpill(w.ID) != 24 {
		return "an int at 0, the alloca at 8, an int at 16, the int64 at 24"
	}
	return ""
}
