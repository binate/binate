package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/types"

// needsSpillSlot reports whether PlanFrame gives the value ins a spill slot, given
// the flags of the values an indirect call takes as its target (indirectCallTargets)
// and of the values with bytes of their own (owns, regionPlan).
// A value a fold elides (IsFoldedAway: a GEP folded into its load or store, a constant
// riding an immediate, a compare fused into its branch, ...) has no result of its own
// to store -- its consumer takes it through the fold -- so it has none.  A value with
// bytes of its own is their address, which getOperand forms from its data region
// (LookupAlloc), so it has none either -- unless it is an indirect call's result and the
// backend keeps the call's target in its slot while it places the arguments
// (StashesCallTarget: x64).  A value the
// register allocator does not home is spilled lazily and reloaded from its slot, so it
// has one.  A value homed for its whole life is read and written only in its home
// register, so it has none -- unless an emitter uses its slot anyway:
//   - a call's result: on aarch64 and arm32 the result collection asks for the
//     slot before it looks for a home, and x64 keeps an indirect call's target in
//     the call's slot while it places the arguments (StashesCallTarget);
//   - an OP_BOX's result: its slot holds a scalar operand while rt.Box copies it;
//   - an indirect call's target: one homed in an argument register is saved to its
//     slot before the argument registers are written (aarch64, x64).
// Parameters are not asked about: each has a slot (PlanFrame's parameter loop),
// where the prologue lands it before a homed one moves to its home -- but an aggregate
// one with a data region, whose value is the region's address.
func (m @RegMap) needsSpillSlot(ins @ir.Instr, targets @[]bool, owns @[]bool) bool {
	if m.IsFoldedAway(ins.ID) { return false }
	if ins.ID >= 0 && ins.ID < len(owns) && owns[ins.ID] &&
			!(m.StashesCallTarget && callconv.IsIndirectCallOp(ins.Op)) {
		return false
	}
	if m.LookupHome(ins.ID) < 0 { return true }
	if isCallOp(ins.Op) || ins.Op == iropcode.OP_BOX { return true }
	return ins.ID < len(targets) && targets[ins.ID]
}

// indirectCallTargets returns, by value ID, whether an indirect call in f
// (callconv.IsIndirectCallOp) takes the value as its target, Args[0].
func indirectCallTargets(f @ir.Func) @[]bool {
	var targets @[]bool = make_slice(bool, f.NextID)
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if !callconv.IsIndirectCallOp(ins.Op) || len(ins.Args) == 0 || ins.Args[0] == nil { continue }
			var id int = ins.Args[0].ID
			if id >= 0 && id < len(targets) { targets[id] = true }
		}
	}
	return targets
}

// spillSlotBytes returns the bytes of the spill slot of the value ins (one that has a
// slot, needsSpillSlot; a multi-return call's, which holds its tuple, is sized apart):
// as for a value of its type (slotBytesOf), but for an OP_BOX, which stores its scalar
// operand in its slot while rt.Box copies it -- 8 bytes for a 64-bit operand on a
// 32-bit target.
func (m @RegMap) spillSlotBytes(ins @ir.Instr) int64 {
	var t @types.Type = ins.Typ
	if ins.Op == iropcode.OP_BOX && len(ins.Args) > 0 && ins.Args[0] != nil { t = ins.Args[0].Typ }
	return slotBytesOf(t, m.CC.WordBytes)
}

// slotBytesOf returns the bytes of the spill slot of a value of type t, on a target
// whose words are wordBytes: a word, or 8 for a scalar wider than one (a 64-bit integer
// or float64 on a 32-bit target; no scalar is wider than 8 bytes).  An aggregate's slot
// holds its address, a word.
func slotBytesOf(t @types.Type, wordBytes int) int64 {
	if t != nil && !callconv.IsAggregateTyp(t) && t.Size() > cast(int64, wordBytes) { return 8 }
	return cast(int64, wordBytes)
}

// allocaSlotBytes returns the bytes and the alignment of the slot of the OP_ALLOC ins: its
// type's size rounded up to a word, and its type's alignment, each at least a word's.
// Every access of the slot stays within those bytes: a load or store moves at most its
// type's bytes, an aggregate copy at most the type's size, a call writing its
// register-returned result into the slot at most that size rounded up to a word (a
// 3-byte struct returned in r0 is one 4-byte store on arm32), and zeroing an
// aggregate's slot (emitAlloc) whole words over the slot.  One with no type takes 8
// bytes, 8-aligned.
func (m @RegMap) allocaSlotBytes(ins @ir.Instr) (int64, int64) {
	if ins.TypeArg == nil { return 8, 8 }
	var w int64 = cast(int64, m.CC.WordBytes)
	var sz int64 = ins.TypeArg.Size()
	if sz < w { sz = w }
	var align int64 = cast(int64, ins.TypeArg.AlignOf())
	if align < w { align = w }
	return roundUpPow2(sz, w), align
}
