package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"

// needsSpillSlot reports whether PlanFrame gives the value ins a spill slot, given
// the flags of the values an indirect call takes as its target (indirectCallTargets).
// A value the register allocator does not home is spilled lazily and reloaded from
// its slot, so it has one.  A value homed for its whole life is read and written only
// in its home register, so it has none -- unless an emitter uses its slot anyway:
//   - a call's result: on aarch64 and arm32 the result collection asks for the
//     slot before it looks for a home, and x64 keeps an indirect call's target in
//     the call's slot while it places the arguments;
//   - an OP_BOX's result: its slot holds a scalar operand while rt.Box copies it;
//   - an indirect call's target: one homed in an argument register is saved to its
//     slot before the argument registers are written (aarch64, x64).
// Parameters are not asked about: each has a slot (PlanFrame's parameter loop),
// where the prologue lands it before a homed one moves to its home.
func (m @RegMap) needsSpillSlot(ins @ir.Instr, targets @[]bool) bool {
	if m.LookupHome(ins.ID) < 0 { return true }
	if isCallOp(ins.Op) || ins.Op == iropcode.OP_BOX { return true }
	return ins.ID < len(targets) && targets[ins.ID]
}

// indirectCallTargets returns, by value ID, whether an indirect call in f
// (isIndirectCallOp) takes the value as its target, Args[0].
func indirectCallTargets(f @ir.Func) @[]bool {
	var targets @[]bool = make_slice(bool, f.NextID)
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if !isIndirectCallOp(ins.Op) || len(ins.Args) == 0 || ins.Args[0] == nil { continue }
			var id int = ins.Args[0].ID
			if id >= 0 && id < len(targets) { targets[id] = true }
		}
	}
	return targets
}
