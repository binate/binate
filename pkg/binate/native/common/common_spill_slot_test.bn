package "pkg/binate/native/common"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for common_spill_slot.bn: which values PlanFrame gives a spill slot.

// homeAt records value id as homed in register reg for its whole life, as
// AllocateRegisters would.
func homeAt(m @RegMap, id int, reg int) {
	m.HomeIDs = AppendInt(m.HomeIDs, id)
	m.HomeRegs = AppendInt(m.HomeRegs, reg)
}

// Homed values have no slots, a value with no home keeps its slot, and the frame
// shrinks by the slots the homed values no longer take.
func TestSpillSlotNoneForHomedValue() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt64())
	var sum @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, x, x, types.TypInt64())
	var twice @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, sum, x, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var all @RegMap = nrm()
	var whole int64 = all.PlanFrame(f)
	var m @RegMap = nrm()
	homeAt(m, sum.ID, 19)
	homeAt(m, twice.ID, 20)
	var homed int64 = m.PlanFrame(f)
	if m.LookupSpill(sum.ID) >= 0 || m.LookupSpill(twice.ID) >= 0 {
		return "a value homed for its whole life must have no spill slot"
	}
	if m.LookupSpill(x.ID) < 0 { return "a value with no home must keep its spill slot" }
	if all.LookupSpill(sum.ID) < 0 { return "the value must have a slot when it has no home" }
	if whole != 32 || homed != 16 { return "the frame must shrink from 32 bytes to 16" }
	return ""
}

// A homed call result, a homed OP_BOX result and the homed target of an indirect call
// and of a handle call keep their slots (the emitters use them); a homed value an
// indirect call passes as an ordinary argument has none.
func TestSpillSlotKeptWhereEmittersUseIt() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	var res @ir.Instr = irbuild.EmitCall(b, "g", noArgs, types.TypInt64())
	var v @ir.Instr = irbuild.EmitConstInt(b, 7, types.TypInt64())
	var boxed @ir.Instr = irbuild.EmitBox(b, v, types.MakeManagedPtrType(types.TypInt64()))
	var target @ir.Instr = irbuild.EmitConstInt(b, 0, types.TypInt())
	var arg @ir.Instr = irbuild.EmitConstInt(b, 42, types.TypInt())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = arg
	irbuild.EmitCallIndirect(b, target, args, types.TypVoid())
	var handle @ir.Instr = irbuild.EmitConstInt(b, 0, types.MakePointerType(types.TypUint8()))
	irbuild.EmitCallHandle(b, handle, args, types.TypVoid())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	homeAt(m, res.ID, 19)
	homeAt(m, boxed.ID, 20)
	homeAt(m, target.ID, 0)
	homeAt(m, arg.ID, 21)
	homeAt(m, handle.ID, 1)
	m.PlanFrame(f)
	if m.LookupSpill(res.ID) < 0 { return "a homed call result must keep its slot" }
	if m.LookupSpill(boxed.ID) < 0 { return "a homed OP_BOX result must keep its slot" }
	if m.LookupSpill(target.ID) < 0 { return "a homed indirect call target must keep its slot" }
	if m.LookupSpill(handle.ID) < 0 { return "a homed handle call target must keep its slot" }
	if m.LookupSpill(arg.ID) >= 0 {
		return "a homed value passed as an ordinary argument must have no slot"
	}
	return ""
}

// A homed parameter keeps its slot: the prologue lands it there first.
func TestSpillSlotKeptForHomedParam() testing.TestResult {
	setTarget64()
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].Typ = types.TypInt64()
	var f @ir.Func = ir.NewFunc("", "t", params, makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	homeAt(m, f.Params[0].ID, 19)
	m.PlanFrame(f)
	if m.LookupSpill(f.Params[0].ID) < 0 { return "a homed parameter must keep its slot" }
	return ""
}

// A value a fold elides -- a field GEP folded into its load, a constant riding an
// immediate -- has no spill slot, while the load beside it keeps its own.
func TestSpillSlotNoneForFoldedValue() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var slot @ir.Instr = irbuild.EmitAlloc(b, elisionPairTyp())
	var gep @ir.Instr = irbuild.EmitGetFieldPtr(b, slot, 1, types.TypInt64())
	var ld @ir.Instr = irbuild.EmitLoad(b, gep, types.TypInt64())
	var c @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt64())
	irbuild.EmitBinop(b, iropcode.OP_ADD, ld, c, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	m.FusableFieldGep = make_slice(bool, f.NextID)
	m.FusableFieldGep[gep.ID] = true
	m.FoldedImm = make_slice(bool, f.NextID)
	m.FoldedImm[c.ID] = true
	m.PlanFrame(f)
	if m.LookupSpill(gep.ID) >= 0 { return "a folded GEP has no slot" }
	if m.LookupSpill(c.ID) >= 0 { return "a folded constant has no slot" }
	if m.LookupSpill(ld.ID) < 0 { return "the load keeps its slot" }
	return ""
}

// A folded value with a recorded span no longer takes one of the shared slots: here
// the constant c rides an immediate, and the values live at once drop from three to
// two, the frame from 32 bytes to 16.
func TestSpillSlotFoldedValueLeavesSharedSlots() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt64())
	var x @ir.Instr = irbuild.EmitConstInt(b, 4, types.TypInt64())
	var y @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, x, c, types.TypInt64())
	var z @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, y, x, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 4)
	ivs[0] = spanInterval(c.ID, 0, 3, 0)
	ivs[1] = spanInterval(x.ID, 1, 3, 1)
	ivs[2] = spanInterval(y.ID, 2, 3, 2)
	ivs[3] = spanInterval(z.ID, 3, 4, 3)
	var plain @RegMap = nrm()
	plain.noteLiveSpans(f, ivs, true)
	var whole int64 = plain.PlanFrame(f)
	var m @RegMap = nrm()
	m.noteLiveSpans(f, ivs, true)
	m.FoldedImm = make_slice(bool, f.NextID)
	m.FoldedImm[c.ID] = true
	var folded int64 = m.PlanFrame(f)
	if m.LookupSpill(c.ID) >= 0 { return "the folded constant has no slot" }
	if m.LookupSpill(x.ID) < 0 || m.LookupSpill(y.ID) < 0 { return "the other values keep slots" }
	if whole != 32 || folded != 16 { return "the frame shrinks from 32 bytes to 16" }
	return ""
}

// A slot is a word, or 8 bytes for a scalar wider than a word -- a 64-bit integer or a
// float64 on a 32-bit target, or an OP_BOX's 64-bit operand, which it stores there;
// an aggregate's slot holds its address.  On a 64-bit target every slot is 8 bytes.
func TestSpillSlotBytes() testing.TestResult {
	var names @[]*[]readonly char = @[]*[]readonly char{"int", "int64", "float32", "float64", "*int",
			"*[]int", "bool", "int8", "struct{}", "no type"}
	setTarget32()
	var bad @[]char = slotSizeMismatch(NewRegMap(callconv.AAPCS32()), names,
			@[]int64{4, 8, 4, 8, 4, 4, 4, 4, 4, 4})
	setTarget64()
	if len(bad) > 0 { return buf.Concat("32-bit: ", bad) }
	bad = slotSizeMismatch(NewRegMap(callconv.AAPCS64()), names,
			@[]int64{8, 8, 8, 8, 8, 8, 8, 8, 8, 8})
	if len(bad) > 0 { return buf.Concat("64-bit: ", bad) }
	return ""
}

// slotTypes returns, in the current target's layout, the types TestSpillSlotBytes sizes:
// int, int64, float32, float64, *int, *[]int, bool, int8, struct{} and none.
func slotTypes() @[]@types.Type {
	var ts @[]@types.Type = make_slice(@types.Type, 10)
	ts[0] = types.TypInt()
	ts[1] = types.TypInt64()
	ts[2] = types.TypFloat32()
	ts[3] = types.TypFloat64()
	ts[4] = types.MakePointerType(types.TypInt())
	ts[5] = types.MakeSliceType(types.TypInt())
	ts[6] = types.TypBool()
	ts[7] = types.TypInt8()
	ts[8] = types.MakeStructType("", make_slice(@types.Field, 0))
	return ts
}

// slotSizeMismatch returns a description of the first of the slotTypes (named by names)
// whose value's slot m sizes other than want -- for the value itself, or for an OP_BOX
// holding it as its operand -- or "".
func slotSizeMismatch(m @RegMap, names @[]*[]readonly char, want @[]int64) @[]char {
	var ts @[]@types.Type = slotTypes()
	for k := 0; k < len(ts); k++ {
		var v @ir.Instr = make(ir.Instr)
		v.Op = iropcode.OP_ADD
		v.Typ = ts[k]
		if m.spillSlotBytes(v) != want[k] { return buf.Concat("the slot of a value of type ", names[k]) }
		var bx @ir.Instr = make(ir.Instr)
		bx.Op = iropcode.OP_BOX
		bx.Typ = types.MakePointerType(types.TypInt())
		bx.Args = make_slice(@ir.Instr, 1)
		bx.Args[0] = v
		if m.spillSlotBytes(bx) != want[k] {
			return buf.Concat("the slot of an OP_BOX of a value of type ", names[k])
		}
	}
	return ""
}

// A local's slot is its type's size rounded up to a word, at its type's alignment, each
// at least a word's: on a 32-bit target a 4-byte or smaller local takes 4 bytes and an
// int64 8, 8-aligned; on a 64-bit target every local takes at least 8.
func TestAllocaSlotBytes() testing.TestResult {
	var names @[]*[]readonly char = @[]*[]readonly char{"int32", "uint8", "int64", "[3]uint8",
			"[5]uint8", "[3]int32", "no type"}
	setTarget32()
	var bad @[]char = allocaSizeMismatch(NewRegMap(callconv.AAPCS32()), names,
			@[]int64{4, 4, 8, 4, 8, 12, 8}, @[]int64{4, 4, 8, 4, 4, 4, 8})
	setTarget64()
	if len(bad) > 0 { return buf.Concat("32-bit: ", bad) }
	bad = allocaSizeMismatch(NewRegMap(callconv.AAPCS64()), names, @[]int64{8, 8, 8, 8, 8, 16, 8},
			@[]int64{8, 8, 8, 8, 8, 8, 8})
	if len(bad) > 0 { return buf.Concat("64-bit: ", bad) }
	return ""
}

// allocaSizeMismatch returns a description of the first local, of the types named by
// names (int32, uint8, int64, [3]uint8, [5]uint8, [3]int32, none, in the current
// target's layout), whose slot m sizes or aligns other than want / wantAlign, or "".
func allocaSizeMismatch(m @RegMap, names @[]*[]readonly char, want @[]int64,
		wantAlign @[]int64) @[]char {
	var ts @[]@types.Type = make_slice(@types.Type, 7)
	ts[0] = types.TypInt32()
	ts[1] = types.TypUint8()
	ts[2] = types.TypInt64()
	ts[3] = types.MakeArrayType(types.TypUint8(), 3)
	ts[4] = types.MakeArrayType(types.TypUint8(), 5)
	ts[5] = types.MakeArrayType(types.TypInt32(), 3)
	for k := 0; k < len(ts); k++ {
		var a @ir.Instr = make(ir.Instr)
		a.Op = iropcode.OP_ALLOC
		a.TypeArg = ts[k]
		sz, align := m.allocaSlotBytes(a)
		if sz != want[k] { return buf.Concat("the size of a local of type ", names[k]) }
		if align != wantAlign[k] { return buf.Concat("the alignment of a local of type ", names[k]) }
	}
	return ""
}

// On a 32-bit target the sret slot is a word (the parameter after it is at 4), a local
// int32 takes a word (the next one follows 4 bytes on), and a local int64 is 8-aligned.
func TestPlanFrameAllocasAndSretOn32Bit() testing.TestResult {
	setTarget32()
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.MakeArrayType(types.TypInt32(), 8)
	var f @ir.Func = ir.NewFunc("", "t", noParams, results)
	var ps @[]@ir.Param = make_slice(@ir.Param, 1)
	ps[0] = irbuild.NewParam(f, buf.CopyStr("p"), types.TypInt32())
	f.Params = ps
	var b @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitAlloc(b, types.TypInt32())
	var z @ir.Instr = irbuild.EmitAlloc(b, types.TypInt32())
	var y @ir.Instr = irbuild.EmitAlloc(b, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = NewRegMap(callconv.AAPCS32())
	m.PlanFrame(f)
	setTarget64()
	if m.SretSlotOff != 0 { return "the function returns through a buffer, its slot first" }
	if m.LookupSpill(ps[0].ID) != 4 { return "the sret slot is a word: the parameter is at 4" }
	if m.LookupAllocSize(x.ID) != 4 { return "a local int32 takes a word" }
	if m.LookupAlloc(z.ID) != m.LookupAlloc(x.ID) + 4 { return "the next int32 local follows it" }
	if m.LookupAllocSize(y.ID) != 8 || m.LookupAlloc(y.ID) % 8 != 0 {
		return "a local int64 takes 8 bytes, 8-aligned"
	}
	if m.LookupAlloc(y.ID) != m.LookupAlloc(x.ID) + 8 {
		return "the int64 follows the two int32s at the next 8-aligned offset"
	}
	return ""
}

// On a 32-bit target PlanFrame packs scoped locals at their own alignments: an int64
// local in a scope nested in an int32 local's (both live at once) goes 8-aligned, past
// the int32's 4 bytes.
func TestPlanFrameScopedLocalsAlignedOn32Bit() testing.TestResult {
	setTarget32()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var e @ir.Block = ir.AddBlock(f, "entry")
	var s1 int = irbuild.NewScope(f)
	var s2 int = irbuild.NewScope(f)
	var x @ir.Instr = irbuild.EmitAlloc(e, types.TypInt32())
	x.Scope = s1
	irbuild.EmitStore(e, x, irbuild.EmitConstInt(e, 1, types.TypInt32()))
	var y @ir.Instr = irbuild.EmitAlloc(e, types.TypInt64())
	y.Scope = s2
	irbuild.EmitStore(e, y, irbuild.EmitConstInt(e, 2, types.TypInt64()))
	irbuild.EmitScopeEnd(e, s2)
	irbuild.EmitScopeEnd(e, s1)
	irbuild.EmitReturn(e, makeNoInstrs())
	var m @RegMap = NewRegMap(callconv.AAPCS32())
	m.PlanFrame(f)
	setTarget64()
	if m.LookupAllocSize(x.ID) != 4 || m.LookupAllocSize(y.ID) != 8 {
		return "the scoped int32 takes a word and the int64 8 bytes"
	}
	if m.LookupAlloc(y.ID) % 8 != 0 || m.LookupAlloc(y.ID) == m.LookupAlloc(x.ID) {
		return "the nested int64 local is 8-aligned, apart from the int32"
	}
	return ""
}
