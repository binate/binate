package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for common_spill_slot.bn: which values PlanFrame gives a spill slot.

// homeAt records value id as homed in register reg for its whole life, as
// AllocateRegisters would.
func homeAt(m @RegMap, id int, reg int) {
	m.HomeIDs = AppendInt(m.HomeIDs, id)
	m.HomeRegs = AppendInt(m.HomeRegs, reg)
}

// Homed values have no slots, a value with no home keeps its slot, and the frame
// shrinks by the slots the homed values no longer take.
func TestSpillSlotNoneForHomedValue() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt64())
	var sum @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, x, x, types.TypInt64())
	var twice @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, sum, x, types.TypInt64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var all @RegMap = nrm()
	var whole int64 = all.PlanFrame(f)
	var m @RegMap = nrm()
	homeAt(m, sum.ID, 19)
	homeAt(m, twice.ID, 20)
	var homed int64 = m.PlanFrame(f)
	if m.LookupSpill(sum.ID) >= 0 || m.LookupSpill(twice.ID) >= 0 {
		return "a value homed for its whole life must have no spill slot"
	}
	if m.LookupSpill(x.ID) < 0 { return "a value with no home must keep its spill slot" }
	if all.LookupSpill(sum.ID) < 0 { return "the value must have a slot when it has no home" }
	if whole != 32 || homed != 16 { return "the frame must shrink from 32 bytes to 16" }
	return ""
}

// A homed call result, a homed OP_BOX result and the homed target of an indirect call
// and of a handle call keep their slots (the emitters use them); a homed value an
// indirect call passes as an ordinary argument has none.
func TestSpillSlotKeptWhereEmittersUseIt() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	var res @ir.Instr = irbuild.EmitCall(b, "g", noArgs, types.TypInt64())
	var v @ir.Instr = irbuild.EmitConstInt(b, 7, types.TypInt64())
	var boxed @ir.Instr = irbuild.EmitBox(b, v, types.MakeManagedPtrType(types.TypInt64()))
	var target @ir.Instr = irbuild.EmitConstInt(b, 0, types.TypInt())
	var arg @ir.Instr = irbuild.EmitConstInt(b, 42, types.TypInt())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = arg
	irbuild.EmitCallIndirect(b, target, args, types.TypVoid())
	var handle @ir.Instr = irbuild.EmitConstInt(b, 0, types.MakePointerType(types.TypUint8()))
	irbuild.EmitCallHandle(b, handle, args, types.TypVoid())
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	homeAt(m, res.ID, 19)
	homeAt(m, boxed.ID, 20)
	homeAt(m, target.ID, 0)
	homeAt(m, arg.ID, 21)
	homeAt(m, handle.ID, 1)
	m.PlanFrame(f)
	if m.LookupSpill(res.ID) < 0 { return "a homed call result must keep its slot" }
	if m.LookupSpill(boxed.ID) < 0 { return "a homed OP_BOX result must keep its slot" }
	if m.LookupSpill(target.ID) < 0 { return "a homed indirect call target must keep its slot" }
	if m.LookupSpill(handle.ID) < 0 { return "a homed handle call target must keep its slot" }
	if m.LookupSpill(arg.ID) >= 0 {
		return "a homed value passed as an ordinary argument must have no slot"
	}
	return ""
}

// A homed parameter keeps its slot: the prologue lands it there first.
func TestSpillSlotKeptForHomedParam() testing.TestResult {
	setTarget64()
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].Typ = types.TypInt64()
	var f @ir.Func = ir.NewFunc("", "t", params, makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	irbuild.EmitReturn(b, makeNoInstrs())
	var m @RegMap = nrm()
	homeAt(m, f.Params[0].ID, 19)
	m.PlanFrame(f)
	if m.LookupSpill(f.Params[0].ID) < 0 { return "a homed parameter must keep its slot" }
	return ""
}
