package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit coverage for the pure, arch-agnostic helpers. Anything that
// depends on arch-specific emission (getOperand, spillAndReset, the
// register pool, prologue/epilogue) is tested in pkg/binate/native/<arch>/
// via end-to-end EmitObject round-trips.

// nrm returns a freshly-constructed regmap pre-stamped with the
// AAPCS64 CallConv — the convention these tests were written against.
// PlanFrame and the CC-parameterised helpers all read from m.CC, so
// every test path needs CC set.
func nrm() @RegMap { return NewRegMap(AAPCS64()) }

// setTarget64 pins types' live target to a 64-bit configuration.
// All native-backend tests in this package target a 64-bit ABI
// (AAPCS64 / SysV-AMD64) — their assertions about word counts,
// stack bytes, frame layouts, and aggregate sizes are LP64-specific.
// On a 32-bit-host test runner, the lazy default would otherwise
// reflect the host (ILP32) and make those assertions diverge.
func setTarget64() {
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	types.SetTarget(t)
}

// setTarget32 pins types' live target to the ILP32 configuration the
// arm32 backend uses (PointerSize / IntSize = 4, MaxAlign = 8 — AAPCS
// aligns int64 / double to 8 even though int / pointer are 4).  Matches
// setArm32Layout in cmd/bnc/target.bn; AAPCS32 tests set this so SizeOf /
// AlignOf report ILP32 values.  Tests that call it should restore the
// 64-bit default with setTarget64 if later assertions are LP64-specific.
func setTarget32() {
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
}


// NewRegMap must preserve the caller's CallConv on the returned
// RegMap; PlanFrame and the parameterised helpers both read m.CC and
// would silently misbehave if the constructor dropped it.
func TestNewRegMapStampsCC() testing.TestResult {
	var m @RegMap = NewRegMap(SysV_AMD64())
	if m.CC.NumGpArgRegs != 6 {
		return "NewRegMap should preserve the caller's CallConv"
	}
	if m.CC.InternalSretBytes != 16 {
		return "NewRegMap should preserve all CallConv fields"
	}
	return ""
}

// Fresh-from-NewRegMap RegMap should have empty tables (no stale
// alloc/spill entries from a zero-valued struct trying to look real).
func TestNewRegMapStartsEmpty() testing.TestResult {
	var m @RegMap = NewRegMap(AAPCS64())
	if len(m.IDs) != 0 { return "fresh RegMap should have no live regs" }
	if len(m.AllocIDs) != 0 { return "fresh RegMap should have no allocs" }
	if len(m.SpillIDs) != 0 { return "fresh RegMap should have no spills" }
	if m.FrameSize != 0 { return "fresh RegMap should have zero frame" }
	return ""
}


func TestLookupsReturnMinusOneOnMiss() testing.TestResult {
	var m @RegMap = nrm()
	if m.LookupAlloc(7) != -1 { return "LookupAlloc miss should be -1" }
	if m.LookupAllocSize(7) != -1 { return "LookupAllocSize miss should be -1" }
	if m.LookupSpill(7) != -1 { return "LookupSpill miss should be -1" }
	if m.LookupReg(7) != -1 { return "LookupReg miss should be -1" }
	return ""
}
func TestAssignAndLookupReg() testing.TestResult {
	var m @RegMap = nrm()
	m.AssignReg(3, 42)
	if m.LookupReg(3) != 42 { return "expected 42 after assign" }
	if m.LookupReg(99) != -1 { return "expected -1 for unknown id" }
	return ""
}
func TestResetClearsRegsButKeepsSlots() testing.TestResult {
	var m @RegMap = nrm()
	m.AllocIDs = AppendInt(m.AllocIDs, 5)
	m.AllocOffsets = AppendInt(m.AllocOffsets, 32)
	m.AllocSizes = AppendInt(m.AllocSizes, 8)
	m.SpillIDs = AppendInt(m.SpillIDs, 6)
	m.SpillOffsets = AppendInt(m.SpillOffsets, 40)
	m.AssignReg(7, 11)
	m.ResetRegs()
	if m.LookupReg(7) != -1 { return "regs should be cleared" }
	if m.LookupAlloc(5) != 32 { return "alloc slot should survive" }
	if m.LookupSpill(6) != 40 { return "spill slot should survive" }
	return ""
}
func TestInstrIsVoid() testing.TestResult {
	var vf @ir.Instr = make(ir.Instr)
	vf.ID = -1
	if !InstrIsVoid(vf) { return "id=-1 should be void" }

	var noTyp @ir.Instr = make(ir.Instr)
	noTyp.ID = 3
	if !InstrIsVoid(noTyp) { return "nil Typ should be void" }

	var notVoid @ir.Instr = make(ir.Instr)
	notVoid.ID = 4
	notVoid.Typ = types.TypInt()
	if InstrIsVoid(notVoid) { return "int-typed should not be void" }
	return ""
}
func TestIsAggregateTyp() testing.TestResult {
	if IsAggregateTyp(nil) { return "nil should not be aggregate" }
	if IsAggregateTyp(types.TypInt()) { return "int is not aggregate" }
	var arr @types.Type = types.MakeArrayType(types.TypInt(), 4)
	if !IsAggregateTyp(arr) { return "array should be aggregate" }
	if !IsAggregateTyp(types.MakeManagedSliceType(types.TypInt())) {
		return "@[]int should be aggregate"
	}
	if !IsAggregateTyp(types.MakeSliceType(types.TypInt())) {
		return "*[]int should be aggregate"
	}
	// Transparent wrappers (readonly / alias / named) must peel — a
	// `readonly Big` classifies by its aggregate representation, matching
	// types.SizeOf / IsByvalParam.  Pre-fix only TYP_NAMED peeled, so a
	// readonly aggregate arrived as TYP_READONLY, fell outside the set, and
	// lowered by value where the >16-byte byval/sret convention passes a
	// pointer (conformance matrix/readonly/pass-arg/value-struct-large).
	if !IsAggregateTyp(types.MakeReadonlyType(arr)) {
		return "readonly array should be aggregate (peelTransparent)"
	}
	if !IsAggregateTyp(types.MakeAliasType("ArrAlias", arr)) {
		return "alias-of-array should be aggregate"
	}
	if IsAggregateTyp(types.MakeReadonlyType(types.TypInt())) {
		return "readonly int is a scalar, not an aggregate"
	}
	return ""
}
func TestIsFloatScalarTyp() testing.TestResult {
	if IsFloatScalarTyp(nil) { return "nil should not be float" }
	if IsFloatScalarTyp(types.TypInt()) { return "int is not float" }
	if !IsFloatScalarTyp(types.TypFloat32()) {
		return "float32 should be float scalar"
	}
	if !IsFloatScalarTyp(types.TypFloat64()) {
		return "float64 should be float scalar"
	}
	if !IsFloatScalarTyp(types.TypUntypedFloat()) {
		return "untyped float should be float scalar"
	}
	// readonly float scalar peels too — it travels in the FP register file.
	if !IsFloatScalarTyp(types.MakeReadonlyType(types.TypFloat64())) {
		return "readonly float64 should be a float scalar (peelTransparent)"
	}
	return ""
}

// FloatScalarIsI32 selects the all-int shim slot width: only a concrete
// float32 takes the i32 slot; float64 and untyped-float take i64.  A wrong
// answer here is silent-miscompile-class (32- vs 64-bit fmov/movq at the shim
// boundary), so pin every case including the readonly peel.
func TestFloatScalarIsI32() testing.TestResult {
	if FloatScalarIsI32(nil) { return "nil is not an i32 float slot" }
	if !FloatScalarIsI32(types.TypFloat32()) {
		return "float32 takes the i32 slot"
	}
	if FloatScalarIsI32(types.TypFloat64()) {
		return "float64 takes the i64 slot, not i32"
	}
	if FloatScalarIsI32(types.TypUntypedFloat()) {
		return "untyped float takes the i64 slot, not i32"
	}
	// readonly float32 peels to a concrete float32 -> still the i32 slot.
	if !FloatScalarIsI32(types.MakeReadonlyType(types.TypFloat32())) {
		return "readonly float32 takes the i32 slot (peelTransparent)"
	}
	return ""
}
// PlanFrame should reserve two regions for OP_MAKE_SLICE: a sized data
// region (where the runtime writes the 32 bytes) and a pointer-sized
// spill slot (which holds the address of that region).
func TestPlanFrameReservesMakeSliceDataRegion() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var n @ir.Instr = b.EmitConstInt(3, types.TypInt64())
	var ms @ir.Instr = b.EmitMakeSlice(types.TypInt64(), n)
	b.EmitReturn(makeNoInstrs())

	var m @RegMap = nrm()
	m.PlanFrame(f)

	if m.LookupAlloc(ms.ID) < 0 {
		return "MAKE_SLICE should have an alloc region"
	}
	if m.LookupAllocSize(ms.ID) != 32 {
		return "MAKE_SLICE alloc region should be 32 bytes"
	}
	if m.LookupSpill(ms.ID) < 0 {
		return "MAKE_SLICE should have a spill slot too"
	}
	return ""
}
func makeNoParams() @[]@ir.Param {
	var p @[]@ir.Param
	return p
}
func makeNoResults() @[]@types.Type {
	var r @[]@types.Type
	return r
}
func makeNoInstrs() @[]@ir.Instr {
	var i @[]@ir.Instr
	return i
}
func TestFrameSizeZero() testing.TestResult {
	var m @RegMap = nrm()
	if m.FrameSize() != 0 { return "empty regmap should yield frame size 0" }
	return ""
}
func TestFrameSizeReturnsPlannedValue() testing.TestResult {
	var m @RegMap = nrm()
	m.FrameSize = 48
	if m.FrameSize() != 48 { return "FrameSize should return cached FrameSize" }
	return ""
}
// IsMultiReturnCall — the encoding the IR uses for a function with
// multiple return values is an OP_CALL whose Typ is an anonymous
// TYP_STRUCT (Name == ""). Named struct returns must NOT be treated
// as multi-return; they go through pointer-form storage like other
// aggregates.
func TestIsMultiReturnCallAnonymousStruct() testing.TestResult {
	var ty @types.Type = make(types.Type)
	ty.Kind = types.TYP_STRUCT
	// Name left empty — multi-return convention.
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CALL
	ins.Typ = ty
	if !IsMultiReturnCall(ins) {
		return "anonymous TYP_STRUCT call should be multi-return"
	}
	return ""
}
func TestIsMultiReturnCallNamedStructIsNot() testing.TestResult {
	var ty @types.Type = make(types.Type)
	ty.Kind = types.TYP_STRUCT
	ty.Name = "Point"
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CALL
	ins.Typ = ty
	if IsMultiReturnCall(ins) {
		return "named struct call should not be multi-return"
	}
	return ""
}
func TestIsMultiReturnCallNonCallIsNot() testing.TestResult {
	var ty @types.Type = make(types.Type)
	ty.Kind = types.TYP_STRUCT
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_LOAD
	ins.Typ = ty
	if IsMultiReturnCall(ins) {
		return "non-CALL op should not be multi-return"
	}
	return ""
}
// An OP_CALL_IFACE_METHOD with an anonymous TYP_STRUCT result is a
// multi-return: the CR-2 SEAM types a multi-return interface method as the
// same anonymous tuple struct as a direct multi-return call, so the native
// return-collect must treat it identically (per-field on aa64, the coalesced
// RAX/RDX byte image on x64).  Without this arm the iface call falls into
// the aggregate-single-return path, whose register-collect drops every field
// past the first eightbyte on aa64.
func TestIsMultiReturnCallIfaceMethodAnonymousStruct() testing.TestResult {
	var ty @types.Type = make(types.Type)
	ty.Kind = types.TYP_STRUCT
	// Name left empty — multi-return convention.
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CALL_IFACE_METHOD
	ins.Typ = ty
	if !IsMultiReturnCall(ins) {
		return "anonymous TYP_STRUCT iface-method call should be multi-return"
	}
	return ""
}
// A NAMED-struct interface-method return stays a single aggregate
// (pointer-form storage), just like OP_CALL — only the anonymous tuple is
// multi-return.
func TestIsMultiReturnCallIfaceMethodNamedStructIsNot() testing.TestResult {
	var ty @types.Type = make(types.Type)
	ty.Kind = types.TYP_STRUCT
	ty.Name = "Point"
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CALL_IFACE_METHOD
	ins.Typ = ty
	if IsMultiReturnCall(ins) {
		return "named-struct iface-method call should not be multi-return"
	}
	return ""
}
// SpillHoldsAggregatePointer's contract: true for every aggregate SSA
// value EXCEPT multi-return calls. Distinguishes the two storage
// forms OP_EXTRACT has to know about.
func TestSpillHoldsPointerForLoadOfAggregate() testing.TestResult {
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_LOAD
	ins.Typ = MakeManagedSliceTypeForTest()
	if !SpillHoldsAggregatePointer(ins) {
		return "OP_LOAD of slice should be pointer-form"
	}
	return ""
}
func TestSpillHoldsDataDirectlyForMultiReturn() testing.TestResult {
	var ty @types.Type = make(types.Type)
	ty.Kind = types.TYP_STRUCT
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CALL
	ins.Typ = ty
	if SpillHoldsAggregatePointer(ins) {
		return "multi-return call should be direct-form"
	}
	return ""
}
func TestSpillHoldsPointerForNamedStructCall() testing.TestResult {
	var ty @types.Type = make(types.Type)
	ty.Kind = types.TYP_STRUCT
	ty.Name = "Point"
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CALL
	ins.Typ = ty
	if !SpillHoldsAggregatePointer(ins) {
		return "named struct call should be pointer-form"
	}
	return ""
}
// PlanFrame for an aggregate-returning call (slice / named struct)
// reserves a data region (AllocIDs entry) plus an 8-byte pointer
// spill slot — the same shape as OP_MAKE_SLICE.
func TestPlanFrameReservesAggregateCallReturnRegion() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	// Construct a CALL that returns @[]int64 (managed slice = 32 bytes
	// on LP64 — 4 * ptrSize).  int64 (not int) so the element type's
	// width is host-independent.
	var noArgs @[]@ir.Instr
	var ret @ir.Instr = b.EmitCall("callee", noArgs,
		MakeManagedSliceTypeForTest())
	b.EmitReturn(makeNoInstrs())

	var m @RegMap = nrm()
	m.PlanFrame(f)

	if m.LookupAlloc(ret.ID) < 0 {
		return "aggregate call return should have a data region"
	}
	if m.LookupAllocSize(ret.ID) != 32 {
		return "managed-slice return region should be 32 bytes"
	}
	if m.LookupSpill(ret.ID) < 0 {
		return "aggregate call return should have a pointer spill"
	}
	return ""
}

// PlanFrame must give an aggregate OP_LOAD its OWN data region (plus the
// pointer spill), the same shape as OP_MAKE_SLICE / aggregate calls — so
// the load materializes a copy instead of aliasing the source.  Without
// the region the spill points into the source object; when the source is
// a local the function's cleanup RefDecs before the loaded value is
// consumed (e.g. `return container[i]`), the value is read from freed
// memory.  See regressions/return-aggregate-element-of-local.
func TestPlanFrameReservesAggregateLoadDataRegion() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	// Alloc a managed-slice (32B aggregate), then LOAD it.
	var slot @ir.Instr = b.EmitAlloc(MakeManagedSliceTypeForTest())
	var ld @ir.Instr = b.EmitLoad(slot, MakeManagedSliceTypeForTest())
	b.EmitReturn(makeNoInstrs())

	var m @RegMap = nrm()
	m.PlanFrame(f)

	if m.LookupAlloc(ld.ID) < 0 {
		return "aggregate OP_LOAD should have its own data region"
	}
	if m.LookupAllocSize(ld.ID) != 32 {
		return "managed-slice load region should be 32 bytes"
	}
	if m.LookupSpill(ld.ID) < 0 {
		return "aggregate OP_LOAD should also have a pointer spill slot"
	}
	return ""
}

// callDispatchArgTypes returns the un-synthesised arg list when the
// callee returns a small (in-reg) value: nothing to prepend, no
// register shift.  Both ABIs behave the same way here.
func TestCallDispatchArgTypesScalarReturnNoSynthesis() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	var ret @ir.Instr = b.EmitCall("callee", noArgs, types.TypInt())
	var got @[]@types.Type = callDispatchArgTypes(SysV_AMD64(), ret)
	if len(got) != 0 {
		return "scalar-return call should not prepend sret arg"
	}
	return ""
}

// SysV-AMD64: when the callee returns a >16-byte aggregate via
// sret, the dispatch arg list gets a leading TypInt() (the hidden
// RDI sret pointer) — without this PlanFrame's outgoing-args
// reservation would underestimate, and a spill would overlap the
// caller's own sret-stash slot at SP+SretSlotOff (the
// TestBuildMethodFuncNameNative-style crash that surfaced on
// `builder-comp_native_x64_darwin`).
func TestCallDispatchArgTypesPrependsSretOnSysV() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	var ret @ir.Instr = b.EmitCall("callee", noArgs,
		MakeManagedSliceTypeForTest())
	var got @[]@types.Type =
		callDispatchArgTypes(SysV_AMD64(), ret)
	if len(got) != 1 {
		return "sret-returning call should prepend hidden sret pointer arg"
	}
	if got[0].Kind != types.TYP_INT {
		return "synthesised sret slot should be pointer-typed (TypInt)"
	}
	return ""
}

// AAPCS64: sret lives in X8 — a dedicated register OUTSIDE the
// X0..X7 GP arg-reg pool — so no register-shift compensation is
// needed, and the dispatch arg list stays unchanged.  Pins the
// SretInGpArgReg gate: a future tweak that drops the false branch
// would silently start over-reserving outgoing-args space on aa64.
func TestCallDispatchArgTypesNoSretPrependOnAapcs64() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	var ret @ir.Instr = b.EmitCall("callee", noArgs,
		MakeManagedSliceTypeForTest())
	var got @[]@types.Type =
		callDispatchArgTypes(AAPCS64(), ret)
	if len(got) != 0 {
		return "AAPCS64 sret in X8: no synthesised arg-reg slot needed"
	}
	return ""
}

// AAPCS32 passes the sret buffer pointer in R0 (the first GP arg
// register), so it sets SretInGpArgReg — exactly like SysV-AMD64
// with RDI, and unlike AAPCS64's dedicated X8.  This is what makes
// callDispatchArgTypes prepend the synthetic sret slot for a big-
// aggregate-return call under AAPCS32.
func TestAapcs32SretInGpArgReg() testing.TestResult {
	var cc CallConv = AAPCS32()
	if !cc.SretInGpArgReg {
		return "AAPCS32 must set SretInGpArgReg (sret pointer rides R0)"
	}
	return ""
}

// AAPCS32: a call returning a >4-byte aggregate (on ILP32 that is
// EVERY slice / struct) is sret with the buffer pointer in R0, so
// callDispatchArgTypes prepends a leading TypInt() — the hidden R0
// slot — so PlanFrame's outgoing-args sizing counts it.  Without the
// prepend a big-aggregate-return call that spills args past R3 would
// under-count the outgoing area and overlap the caller's own sret
// stash at SP+SretSlotOff.
func TestCallDispatchArgTypesPrependsSretOnAapcs32() testing.TestResult {
	setTarget32()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	// A raw slice return is 8 bytes on ILP32 (> InternalSretBytes 4), so sret.
	var ret @ir.Instr = b.EmitCall("callee", noArgs,
		types.MakeSliceType(types.TypInt()))
	var got @[]@types.Type = callDispatchArgTypes(AAPCS32(), ret)
	setTarget64()
	if len(got) != 1 {
		return "AAPCS32 sret-returning call should prepend hidden R0 sret pointer"
	}
	if got[0].Kind != types.TYP_INT {
		return "synthesised AAPCS32 sret slot should be pointer-typed (TypInt)"
	}
	return ""
}

// AAPCS32 sret register shift: with the synthesised R0 sret-pointer
// slot prepended, CallArgRegStart must place user arg 0 in R1 (the
// R0-shift), and a FOLLOWING int64 must land in the R2:R3 even-aligned
// pair — because after the 1-word prepend NGRN=1 is ODD, so the int64's
// 8-byte-alignment pad (AAPCS §6.5 stage C.3) rounds its start up from
// R1 to R2.  Going through the classifier on the PREPENDED list (rather
// than hand-adding 1 to a raw reg index) is what keeps that pad correct.
func TestAapcs32SretShiftPadsFollowingInt64() testing.TestResult {
	setTarget32()
	var cc CallConv = AAPCS32()
	// [sret-slot (TypInt, 1 word), arg0 (int, 1 word), arg1 (int64, pair)].
	var ts @[]@types.Type = make_slice(@types.Type, 3)
	ts[0] = types.TypInt()
	ts[1] = types.TypInt()
	ts[2] = types.TypInt64()
	var r0 int = cc.CallArgRegStart(ts, 0)
	var r1 int = cc.CallArgRegStart(ts, 1)
	var r2 int = cc.CallArgRegStart(ts, 2)
	setTarget64()
	if r0 != 0 {
		return "AAPCS32 sret slot must occupy R0 (reg index 0)"
	}
	if r1 != 1 {
		return "AAPCS32 user arg 0 must shift to R1 (reg index 1)"
	}
	if r2 != 2 {
		return "AAPCS32 int64 after 1-word prepend must even-align to R2:R3"
	}
	return ""
}

// PlanFrame's outgoing-args reservation must include the sret-
// induced register shift on SysV-AMD64.  Repro: a function calls
// callee(*[]readonly char, *[]readonly char, *[]readonly char) returning
// @[]char.  Visible args = 3 × 2 = 6 reg words; with sret in RDI
// only 5 remain → 1 word spills.  Without the fix, PlanFrame
// computes outgoing=0; SretSlotOff for the OUTER function
// (which itself returns @[]char) lands at 0, and the inner call's
// spill clobbers it.  With the fix, outgoing >= 8 → SretSlotOff
// shifts past it.
func TestPlanFrameAccountsForSretReturnedShiftOnSysV() testing.TestResult {
	setTarget64()
	var rawStr @types.Type = types.MakeSliceType(types.TypChar())
	var params @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = MakeManagedSliceTypeForTest()
	var f @ir.Func = ir.NewFunc("", "outer", params, results)
	var b @ir.Block = ir.AddBlock(f, "entry")
	// Three pointer-pair args plus an sret-returning callee.
	var args @[]@ir.Instr = make_slice(@ir.Instr, 3)
	for i := 0; i < 3; i++ {
		args[i] = b.EmitConstNil(rawStr)
	}
	b.EmitCall("callee", args, MakeManagedSliceTypeForTest())
	b.EmitReturn(makeNoInstrs())

	var m @RegMap = NewRegMap(SysV_AMD64())
	m.PlanFrame(f)

	if m.OutgoingArgsSize < 8 {
		return "SysV outgoing-args must reserve >= 8 bytes for sret-induced spill"
	}
	if m.SretSlotOff < m.OutgoingArgsSize {
		return "SretSlotOff must sit above the outgoing-args area"
	}
	return ""
}

// AAPCS32 counterpart of TestPlanFrameAccountsForSretReturnedShiftOnSysV: an
// sret-returning outer function whose body calls an sret-returning callee must
// reserve outgoing-args space that COUNTS the synthetic R0 sret-pointer slot
// (SretInGpArgReg drives callDispatchArgTypes to prepend it — the commit's
// primary correctness fix).  Two raw-slice args (2 words each = 4 words) plus
// the 1-word sret prepend = 5 words > the 4 GP arg regs, so at least one word
// spills to the stack — OutgoingArgsSize must be >= 4 (WordBytes) and the
// caller's own SretSlotOff stash must sit ABOVE it (no overlap).  Numerically
// distinct from the SysV test (4 GP regs vs 6, WordBytes 4 vs 8), so it
// independently pins the AAPCS32 sizing.  Restores the LP64 default on exit.
func TestPlanFrameAccountsForSretReturnedShiftOnAapcs32() testing.TestResult {
	setTarget32()
	var rawStr @types.Type = types.MakeSliceType(types.TypChar())
	var params @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = MakeManagedSliceTypeForTest()
	var f @ir.Func = ir.NewFunc("", "outer", params, results)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var args @[]@ir.Instr = make_slice(@ir.Instr, 2)
	for i := 0; i < 2; i++ {
		args[i] = b.EmitConstNil(rawStr)
	}
	b.EmitCall("callee", args, MakeManagedSliceTypeForTest())
	b.EmitReturn(makeNoInstrs())

	var m @RegMap = NewRegMap(AAPCS32())
	m.PlanFrame(f)

	var res testing.TestResult = ""
	if m.OutgoingArgsSize < 4 {
		res = "AAPCS32 outgoing-args must reserve >= 4 bytes for sret-induced spill"
	} else if m.SretSlotOff < m.OutgoingArgsSize {
		res = "SretSlotOff must sit above the outgoing-args area"
	}
	setTarget64()
	return res
}

// MakeManagedSliceTypeForTest avoids depending on the test file
// having access to the right helper alias name.  int64 (not int) so
// the element width is host-independent.
func MakeManagedSliceTypeForTest() @types.Type {
	return types.MakeManagedSliceType(types.TypInt64())
}
// Multi-return tuples with aggregate fields (e.g. `(StrTab, int)`
// where StrTab is 5 words) must reserve enough bytes for the entire
// packed tuple, not 8*field-count. Pre-fix, a `(StrTab, int)` return
// got a 16-byte slot — the StrTab's words 2..4 and the int return
// were silently dropped, so 141/157 read garbage from the wrong
// offsets. The slot size must be SizeOf(tuple), 8-rounded.
func TestPlanFrameMultiReturnTupleSlotIncludesAggregateFields() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	// Build a (StrTab, int64) tuple where StrTab = {Data @[]char,
	// Len int64} = 40 bytes. Total 48 bytes / 6 words.  int64 (not
	// int) so widths are host-independent.
	var tabFields @[]@types.Field = make_slice(@types.Field, 2)
	tabFields[0] = make(types.Field)
	tabFields[0].Type = types.MakeManagedSliceType(types.TypChar())
	tabFields[1] = make(types.Field)
	tabFields[1].Type = types.TypInt64()
	var tabTyp @types.Type = types.MakeStructType("StrTab", tabFields)
	var tupleFields @[]@types.Field = make_slice(@types.Field, 2)
	tupleFields[0] = make(types.Field)
	tupleFields[0].Type = tabTyp
	tupleFields[1] = make(types.Field)
	tupleFields[1].Type = types.TypInt64()
	// Anonymous (Name="") — the IR's encoding for multi-return.
	var tupleTyp @types.Type = types.MakeStructType("", tupleFields)
	var noArgs @[]@ir.Instr
	var ret @ir.Instr = b.EmitCall("callee", noArgs, tupleTyp)
	b.EmitReturn(makeNoInstrs())

	var m @RegMap = nrm()
	m.PlanFrame(f)

	// Caller's spill slot must hold all 6 words.
	var spill int = m.LookupSpill(ret.ID)
	if spill < 0 {
		return "multi-return spill should be allocated"
	}
	// We can't directly query slot size from RegMap, but we can verify
	// the next slot (the OP_RETURN's "no result" doesn't allocate one;
	// instead just check FrameSize includes 48 bytes for our tuple).
	// FrameSize = OutgoingArgsSize + tuple-slot. FrameSize is rounded
	// to 16. With no calls (we synthesized the tuple via EmitCall, so
	// outgoing-args includes 0 — call has no args), FrameSize >= 48.
	if m.FrameSize() < 48 {
		return "frame should include 48-byte multi-return slot"
	}
	return ""
}
// Data regions for aggregate-producing ops (OP_RODATA_ARRAY,
// OP_MAKE_SLICE, etc.) must be rounded up to 8 bytes so subsequent
// 64-bit STRs stay aligned and the per-region word-wise zero-fill
// doesn't run past the buffer end. This was the regression that
// produced 'H','h','h' instead of 'a','b','e' for 299_string_to_array
// — the [5]char buffer was 5 bytes, the next 3 bytes belonged to the
// following slot, and the zero-fill loop's first STR XZR clobbered
// them.
func TestPlanFrameRoundsArrayDataRegionUpToEight() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	// Construct an OP_RODATA_ARRAY producing a [5]char.
	var ret @ir.Instr = b.EmitRodataArray("abcde",
		types.MakeArrayType(types.TypChar(), 5))
	b.EmitReturn(makeNoInstrs())

	var m @RegMap = nrm()
	m.PlanFrame(f)

	// The data region size should be 8 (5 rounded up), not 5.
	if m.LookupAllocSize(ret.ID) != 8 {
		return "[5]char data region should round up to 8 bytes"
	}
	return ""
}
func TestPlanFrameAllocatesSretSlotForBigReturn() testing.TestResult {
	setTarget64()
	// Caller's perspective: a function f() with no params/no return,
	// containing a CALL whose return type is a big struct, should
	// have a data region for the return value but NOT a SretSlotOff
	// (that's the *callee*'s slot, not ours).
	//
	// We test the callee path by building a function whose own
	// Results is a big struct.  int64 fields (not int) so the struct
	// size is host-independent.
	var fields @[]@types.Field = make_slice(@types.Field, 10)
	for i := 0; i < 10; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var bigStruct @types.Type = types.MakeStructType("Big", fields)
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = bigStruct
	var f @ir.Func = ir.NewFunc("", "retBig", makeNoParams(), results)
	var b @ir.Block = ir.AddBlock(f, "entry")
	b.EmitReturn(makeNoInstrs())

	var m @RegMap = nrm()
	m.PlanFrame(f)

	if m.SretSlotOff < 0 {
		return "big-return func should allocate SretSlotOff"
	}
	return ""
}
func TestPlanFrameNoSretSlotForSmallReturn() testing.TestResult {
	// A function returning a raw slice (2 words = 16 bytes) is at-or-below
	// the InternalSretBytes=16 threshold — packs into X0..X1, no sret slot.
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.MakeSliceType(types.TypInt())
	var f @ir.Func = ir.NewFunc("", "retSmall", makeNoParams(), results)
	var b @ir.Block = ir.AddBlock(f, "entry")
	b.EmitReturn(makeNoInstrs())

	var m @RegMap = nrm()
	m.PlanFrame(f)

	if m.SretSlotOff != -1 {
		return "small-return func should NOT allocate SretSlotOff"
	}
	return ""
}
// PlanFrame must reserve OutgoingArgsSize at the bottom of the frame
// (offset 0..N), so spills/allocas land at offsets >= N. Without this
// shift, the caller's stack-arg writes would clobber its own spills.
func TestPlanFrameReservesOutgoingArgsArea() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	// Construct a CALL with 9 int args so 1 word overflows to stack.
	// CallStackBytes = 16 (one word, 16-aligned).
	var args @[]@ir.Instr = make_slice(@ir.Instr, 9)
	for i := 0; i < 9; i++ {
		args[i] = b.EmitConstInt(i, types.TypInt())
	}
	b.EmitCall("callee", args, types.TypVoid())
	b.EmitReturn(makeNoInstrs())

	var m @RegMap = nrm()
	m.PlanFrame(f)

	if m.OutgoingArgsSize != 16 {
		return "OutgoingArgsSize should be 16 for 9-int call"
	}
	// First spill (arg 0's CONST_INT) must land at offset >= 16.
	var firstSpill int = m.LookupSpill(args[0].ID)
	if firstSpill < 16 {
		return "spills must sit above the outgoing-args area"
	}
	return ""
}
// OP_IFACE_VALUE produces a 16-byte {data, vtable} aggregate and must
// reserve a data region (alloc) plus a pointer-sized spill slot — the
// same shape as OP_FUNC_VALUE and OP_MAKE_SLICE.  Without the
// allocator's OP_IFACE_VALUE arm, OP_IFACE_VALUE's lowering would
// produce a value with no backing storage and the codegen
// `LookupAlloc < 0` guard would silently skip the emission.
func TestPlanFrameReservesIfaceValueDataRegion() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	// data ptr proxy — any scalar producing instr will do.
	var dp @ir.Instr = b.EmitConstInt(0,
		types.MakePointerType(types.TypUint8()))
	// Build TYP_INTERFACE_VALUE for the iv (16 bytes = 2 ptr-words).
	var ivTyp @types.Type = make(types.Type)
	ivTyp.Kind = types.TYP_INTERFACE_VALUE
	var iv @ir.Instr = b.EmitIfaceValue(dp,
		"__ivt.bn_test__T__test__I", ivTyp)
	b.EmitReturn(makeNoInstrs())

	var m @RegMap = nrm()
	m.PlanFrame(f)

	if m.LookupAlloc(iv.ID) < 0 {
		return "OP_IFACE_VALUE should have a data region"
	}
	if m.LookupAllocSize(iv.ID) != 16 {
		return "iface-value alloc region should be 16 bytes (2 ptr words)"
	}
	if m.LookupSpill(iv.ID) < 0 {
		return "OP_IFACE_VALUE should have a pointer spill slot"
	}
	return ""
}
// OP_IFACE_UPCAST rebuilds an iv with the source's data ptr and a
// vtable adjusted by N slots.  It produces a fresh 16-byte aggregate
// and must reserve its own data region (the source iv's region can't
// be reused — the vtable pointer differs).  Pins the allocator's
// OP_IFACE_UPCAST arm; Slice E.4 part 2b of
// plan-interface-embedding.md.
func TestPlanFrameReservesIfaceUpcastDataRegion() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var dp @ir.Instr = b.EmitConstInt(0,
		types.MakePointerType(types.TypUint8()))
	var srcTyp @types.Type = make(types.Type)
	srcTyp.Kind = types.TYP_INTERFACE_VALUE
	var src @ir.Instr = b.EmitIfaceValue(dp,
		"__ivt.bn_test__T__test__Child", srcTyp)
	var targetTyp @types.Type = make(types.Type)
	targetTyp.Kind = types.TYP_INTERFACE_VALUE
	// nil module: this test exercises only RegMap data-region planning;
	// the upcast types carry no Elem, so EmitIfaceUpcast's slot-offset
	// precompute short-circuits and never consults the interface registry.
	var up @ir.Instr = b.EmitIfaceUpcast(nil, src,
		"__ivt.bn_test__T__test__Parent", targetTyp)
	b.EmitReturn(makeNoInstrs())

	var m @RegMap = nrm()
	m.PlanFrame(f)

	if m.LookupAlloc(up.ID) < 0 {
		return "OP_IFACE_UPCAST should have its own data region"
	}
	if m.LookupAllocSize(up.ID) != 16 {
		return "iface-upcast alloc region should be 16 bytes"
	}
	if m.LookupSpill(up.ID) < 0 {
		return "OP_IFACE_UPCAST should have a pointer spill slot"
	}
	// The upcast result region must NOT alias the source's region;
	// they hold different vtable pointers and the source may still
	// be live.
	if m.LookupAlloc(up.ID) == m.LookupAlloc(src.ID) {
		return "upcast result must allocate a separate region from src"
	}
	return ""
}
// OP_CALL_IFACE_METHOD with an aggregate return (e.g. returning a
// managed-slice) follows the same single-return aggregate-call
// pattern as OP_CALL / OP_CALL_FUNC_VALUE: reserve a data region for
// the value and a pointer-sized spill.  Pins the allocator's
// OP_CALL_IFACE_METHOD arm.
func TestPlanFrameReservesIfaceMethodAggregateReturn() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var dp @ir.Instr = b.EmitConstInt(0,
		types.MakePointerType(types.TypUint8()))
	var ivTyp @types.Type = make(types.Type)
	ivTyp.Kind = types.TYP_INTERFACE_VALUE
	var iv @ir.Instr = b.EmitIfaceValue(dp,
		"__ivt.bn_test__T__test__I", ivTyp)
	var noCallArgs @[]@ir.Instr
	var ret @ir.Instr = b.EmitCallIfaceMethod(iv, noCallArgs, 1,
		MakeManagedSliceTypeForTest())
	b.EmitReturn(makeNoInstrs())

	var m @RegMap = nrm()
	m.PlanFrame(f)

	if m.LookupAlloc(ret.ID) < 0 {
		return "OP_CALL_IFACE_METHOD aggregate return should have a data region"
	}
	if m.LookupAllocSize(ret.ID) != 32 {
		return "managed-slice return region should be 32 bytes"
	}
	if m.LookupSpill(ret.ID) < 0 {
		return "OP_CALL_IFACE_METHOD aggregate return should have a pointer spill"
	}
	return ""
}
// An OP_CALL_IFACE_METHOD whose result is an anonymous tuple struct (a
// multi-return) packs its bytes directly into the spill slot — NO data
// region — exactly like a direct multi-return OP_CALL.  Contrast with
// TestPlanFrameReservesIfaceMethodAggregateReturn (a managed-slice aggregate
// return, which DOES reserve a pointer-to-data region).  Pins that
// IsMultiReturnCall's OP_CALL_IFACE_METHOD arm flips PlanFrame's
// tuple-vs-pointer split for the iface path: the bug it guards against is a
// reserved data region + pointer spill, against which the per-field register
// collect would store the tuple over the wrong layout.
func TestPlanFrameIfaceMethodMultiReturnPacksIntoSpill() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var dp @ir.Instr = b.EmitConstInt(0,
		types.MakePointerType(types.TypUint8()))
	var ivTyp @types.Type = make(types.Type)
	ivTyp.Kind = types.TYP_INTERFACE_VALUE
	var iv @ir.Instr = b.EmitIfaceValue(dp,
		"__ivt.bn_test__T__test__I", ivTyp)
	// (uint16, uint16) — the sub-word tuple shape that exposed the aa64
	// drop-field-1 bug (conformance abi/iface-multi-return/u16/2).
	var tupleFields @[]@types.Field = make_slice(@types.Field, 2)
	tupleFields[0] = make(types.Field)
	tupleFields[0].Type = types.TypUint16()
	tupleFields[1] = make(types.Field)
	tupleFields[1].Type = types.TypUint16()
	// Anonymous (Name="") — the IR's multi-return encoding.
	var tupleTyp @types.Type = types.MakeStructType("", tupleFields)
	var noCallArgs @[]@ir.Instr
	var ret @ir.Instr = b.EmitCallIfaceMethod(iv, noCallArgs, 1, tupleTyp)
	b.EmitReturn(makeNoInstrs())

	var m @RegMap = nrm()
	m.PlanFrame(f)

	if m.LookupAlloc(ret.ID) >= 0 {
		return "iface multi-return must NOT reserve a data region (packs into spill)"
	}
	if m.LookupSpill(ret.ID) < 0 {
		return "iface multi-return must reserve a tuple spill slot"
	}
	return ""
}

// charEq compares two byte-slices.  Local because pkg/binate/native/common
// can't depend on the per-arch _iface.bn copies, and pkg/binate/buf doesn't
// export one.
func charEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// AppendStr: empty + bytes → bytes; bytes + bytes → concat.
func TestAppendStrBasic() testing.TestResult {
	var empty @[]char
	var got @[]char = AppendStr(empty, "foo")
	if !charEq(got, "foo") {
		return "append to empty: expected foo"
	}
	got = AppendStr(got, "bar")
	if !charEq(got, "foobar") {
		return "append onto foo: expected foobar"
	}
	return ""
}

// AppendStr with empty src is a no-op (preserves dst).
func TestAppendStrEmptySrc() testing.TestResult {
	var dst @[]char
	dst = AppendStr(dst, "hello")
	var got @[]char = AppendStr(dst, "")
	if !charEq(got, "hello") {
		return "append empty src should preserve dst"
	}
	return ""
}

// PlanFrame must allocate a SpillID slot for a VOID-returning
// OP_CALL_INDIRECT so x64's emitCallIndirect can stash + reload
// R11 (the fn-ptr scratch) around the arg loop.  Without the
// slot, R11 gets clobbered by the arg loads and CALL r11 fires
// with garbage — surfaced as a SIGBUS mid-test in
// pkg/vm.TestExternRtMakeManagedSliceViaRegistry on
// builder-comp_native_x64_darwin (the `_call_shim_aggregate`
// call is void).  AArch64 dodges the issue (X17 stash is outside
// the regPool), but the fix is at the shared PlanFrame layer.
func TestPlanFrameVoidIndirectCallGetsSpillSlot() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	// Build OP_CALL_INDIRECT with a void result type.  Args[0] is
	// the fn-ptr; supply one trivial arg so the loop doesn't fold
	// into the zero-args path.
	var fnPtr @ir.Instr = b.EmitConstInt(0, types.TypInt())
	var arg0 @ir.Instr = b.EmitConstInt(42, types.TypInt())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = arg0
	var call @ir.Instr =
		b.EmitCallIndirect(fnPtr, args, types.TypVoid())
	b.EmitReturn(makeNoInstrs())

	var m @RegMap = NewRegMap(SysV_AMD64())
	m.PlanFrame(f)

	if m.LookupSpill(call.ID) < 0 {
		return "void OP_CALL_INDIRECT must get a SpillID slot for fn-ptr stash"
	}
	return ""
}

// isIndirectCallOp must cover every IR op whose native lowering
// uses the R11-stash-and-reload pattern.  A regression that drops
// any one would re-expose the void-call clobber bug.
func TestIsIndirectCallOpCoversAllStashUsers() testing.TestResult {
	if !isIndirectCallOp(iropcode.OP_CALL_INDIRECT) {
		return "OP_CALL_INDIRECT must be in isIndirectCallOp"
	}
	if !isIndirectCallOp(iropcode.OP_CALL_FUNC_VALUE) {
		return "OP_CALL_FUNC_VALUE must be in isIndirectCallOp"
	}
	if !isIndirectCallOp(iropcode.OP_CALL_HANDLE) {
		return "OP_CALL_HANDLE must be in isIndirectCallOp"
	}
	if !isIndirectCallOp(iropcode.OP_CALL_IFACE_METHOD) {
		return "OP_CALL_IFACE_METHOD must be in isIndirectCallOp"
	}
	// Negative: regular OP_CALL must NOT trigger this — its callee
	// is a direct symbol, no R11-stash dance.
	if isIndirectCallOp(iropcode.OP_CALL) {
		return "OP_CALL must NOT be in isIndirectCallOp (direct call, no R11 stash)"
	}
	return ""
}

// IsSliceFieldBase returns true for raw/managed slice pointers and for
// instructions whose result type is `*Slice` / `*ManagedSlice`.
func TestIsSliceFieldBaseManaged() testing.TestResult {
	var ins @ir.Instr = make(ir.Instr)
	ins.TypeArg = types.MakeManagedSliceType(types.TypInt())
	if !IsSliceFieldBase(ins) {
		return "TypeArg=@[]int should be a slice-field base"
	}
	return ""
}

func TestIsSliceFieldBaseFalseForStruct() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	var s @types.Type = types.MakeStructType("S", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.TypeArg = s
	if IsSliceFieldBase(ins) {
		return "struct TypeArg should NOT be a slice-field base"
	}
	return ""
}

// A distinct named type over a managed-slice (`type Buf @[]int`) is a
// slice-field base — the named wrapper must be peeled before its Kind
// is read.  Without peeling, a subslice's refptr/backingLen field
// stores get no offset and corrupt the header (the native-aa64/x64
// crash this peeling addresses).
func TestIsSliceFieldBaseNamedManagedSlice() testing.TestResult {
	var nt @types.Type = types.MakeNamedType("Buf")
	nt.Underlying = types.MakeManagedSliceType(types.TypInt())
	var ins @ir.Instr = make(ir.Instr)
	ins.TypeArg = nt
	if !IsSliceFieldBase(ins) {
		return "named-over-@[]int TypeArg should be a slice-field base"
	}
	return ""
}

// The same peeling holds for a named raw slice (`type Row *[]int`).
func TestIsSliceFieldBaseNamedRawSlice() testing.TestResult {
	var nt @types.Type = types.MakeNamedType("Row")
	nt.Underlying = types.MakeSliceType(types.TypInt())
	var ins @ir.Instr = make(ir.Instr)
	ins.TypeArg = nt
	if !IsSliceFieldBase(ins) {
		return "named-over-*[]int TypeArg should be a slice-field base"
	}
	return ""
}
