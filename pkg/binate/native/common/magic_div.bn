package "pkg/binate/native/common"

// Granlund-Montgomery magic-number division constants (Hacker's Delight, Ch.10,
// "Integer division by constants").  Target-neutral integer math shared by the
// native backends: it lets a constant-divisor OP_DIV / OP_REM lower to a
// multiply-high plus a few shifts instead of a hardware divide (or, on arm32
// int64, a libcall).  `width` is the bit width the multiply-high is taken at (32
// or 64); the dividend must be sign/zero-extended to that width and the quotient
// re-narrowed afterward.
//
// All intermediate arithmetic is width-bit unsigned WITH WRAP (== uint64 /
// uint32 two's-complement), matching the published algorithm exactly; the
// `& wmask` after each step is a no-op at width 64 and the 32-bit truncation at
// width 32.

// MagicSigned / MagicUnsigned (the value-shape returned here) are declared in
// common.bni.  MagicSigned lowers signed `n / d` to:
//     q = MULHS(M, n)                       // high `width` bits of the signed product
//     if AddN { q = q + n }                 // at most one of AddN / SubN is set
//     if SubN { q = q - n }
//     q = q >> Shift                        // arithmetic shift right
//     q = q + logicalShr(q, width-1)        // += 1 when q < 0
// MagicUnsigned lowers unsigned `n / d` to:
//     q = MULHU(M, n)                       // high `width` bits of the unsigned product
//     if !Add { q = logicalShr(q, Shift) }
//     else    { t = logicalShr(n - q, 1); q = logicalShr(t + q, Shift - 1) }

// fullWidthMask is the low-`width`-bits mask: all-ones at width >= 64, else
// 2^width - 1.
func fullWidthMask(width int) uint64 {
	if width >= 64 {
		return cast(uint64, 0) - cast(uint64, 1)
	}
	return (cast(uint64, 1) << cast(uint64, width)) - cast(uint64, 1)
}

// signExtendW sign-extends the low `width` bits of m to a full int64, via a
// left-shift to bit 63 followed by an arithmetic (signed) right-shift.
func signExtendW(m uint64, width int) int64 {
	if width >= 64 {
		return cast(int64, m)
	}
	var sh int = 64 - width
	var x int64 = cast(int64, m << cast(uint64, sh))
	return x >> sh
}

// ComputeMagicSigned returns the signed magic constants for divisor `d` at
// `width` bits.  Precondition: d != 0, |d| != 1, and |d| is not a power of two —
// the backend lowers those directly to mov / neg / shift and must not call this.
func ComputeMagicSigned(d int64, width int) MagicSigned {
	var wmask uint64 = fullWidthMask(width)
	var two31 uint64 = cast(uint64, 1) << cast(uint64, width - 1)
	var ud uint64 = cast(uint64, d) & wmask
	var ad uint64 = ud
	if d < 0 {
		ad = (cast(uint64, 0) - ud) & wmask
	}
	var dsign uint64 = cast(uint64, 0)
	if d < 0 {
		dsign = cast(uint64, 1)
	}
	var t uint64 = (two31 + dsign) & wmask
	var anc uint64 = ((t - cast(uint64, 1)) - (t % ad)) & wmask
	var p int = width - 1
	var q1 uint64 = two31 / anc
	var r1 uint64 = (two31 - ((q1 * anc) & wmask)) & wmask
	var q2 uint64 = two31 / ad
	var r2 uint64 = (two31 - ((q2 * ad) & wmask)) & wmask
	for {
		p = p + 1
		q1 = (q1 * cast(uint64, 2)) & wmask
		r1 = (r1 * cast(uint64, 2)) & wmask
		if r1 >= anc {
			q1 = (q1 + cast(uint64, 1)) & wmask
			r1 = (r1 - anc) & wmask
		}
		q2 = (q2 * cast(uint64, 2)) & wmask
		r2 = (r2 * cast(uint64, 2)) & wmask
		if r2 >= ad {
			q2 = (q2 + cast(uint64, 1)) & wmask
			r2 = (r2 - ad) & wmask
		}
		var delta uint64 = (ad - r2) & wmask
		if !(q1 < delta || (q1 == delta && r1 == cast(uint64, 0))) {
			break
		}
	}
	var m uint64 = (q2 + cast(uint64, 1)) & wmask
	if d < 0 {
		m = (cast(uint64, 0) - m) & wmask
	}
	var res MagicSigned
	res.M = signExtendW(m, width)
	res.Shift = p - width
	res.AddN = d > cast(int64, 0) && res.M < cast(int64, 0)
	res.SubN = d < cast(int64, 0) && res.M > cast(int64, 0)
	return res
}

// ComputeMagicUnsigned returns the unsigned magic constants for divisor `d` at
// `width` bits.  Precondition: d >= 2 and d is not a power of two — the backend
// lowers those directly to mov / logical-shift and must not call this.
func ComputeMagicUnsigned(d uint64, width int) MagicUnsigned {
	var wmask uint64 = fullWidthMask(width)
	var two31 uint64 = cast(uint64, 1) << cast(uint64, width - 1)
	var addInd bool = false
	var p int = width - 1
	var negd uint64 = (cast(uint64, 0) - d) & wmask
	var nc uint64 = (wmask - (negd % d)) & wmask
	var q1 uint64 = two31 / nc
	var r1 uint64 = (two31 - ((q1 * nc) & wmask)) & wmask
	var q2 uint64 = (two31 - cast(uint64, 1)) / d
	var r2 uint64 = ((two31 - cast(uint64, 1)) - ((q2 * d) & wmask)) & wmask
	for {
		p = p + 1
		if r1 >= (nc - r1) {
			q1 = ((q1 * cast(uint64, 2)) + cast(uint64, 1)) & wmask
			r1 = ((r1 * cast(uint64, 2)) - nc) & wmask
		} else {
			q1 = (q1 * cast(uint64, 2)) & wmask
			r1 = (r1 * cast(uint64, 2)) & wmask
		}
		if (r2 + cast(uint64, 1)) >= (d - r2) {
			if q2 >= (two31 - cast(uint64, 1)) {
				addInd = true
			}
			q2 = ((q2 * cast(uint64, 2)) + cast(uint64, 1)) & wmask
			r2 = (((r2 * cast(uint64, 2)) + cast(uint64, 1)) - d) & wmask
		} else {
			if q2 >= two31 {
				addInd = true
			}
			q2 = (q2 * cast(uint64, 2)) & wmask
			r2 = ((r2 * cast(uint64, 2)) + cast(uint64, 1)) & wmask
		}
		var delta uint64 = ((d - cast(uint64, 1)) - r2) & wmask
		if !(p < (2 * width) && (q1 < delta || (q1 == delta && r1 == cast(uint64, 0)))) {
			break
		}
	}
	var res MagicUnsigned
	res.M = (q2 + cast(uint64, 1)) & wmask
	res.Shift = p - width
	res.Add = addInd
	return res
}
