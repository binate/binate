package "pkg/binate/native/common"

import "pkg/builtins/testing"

// ---- exact-constant anchors (values independently verified against Hacker's
// Delight worked examples and a brute-forced reference model) ----
//
// M is compared as its low-`width` bit pattern (a uint64), sidestepping the
// signed-int64 sign-extension of a width-32 magic.

func chkS(d int64, width int, wantMlow uint64, wantShift int, wantAdd bool,
		wantSub bool) testing.TestResult {
	var m MagicSigned = ComputeMagicSigned(d, width)
	var wmask uint64 = fullWidthMask(width)
	if (cast(uint64, m.M) & wmask) != (wantMlow & wmask) {
		return "signed magic M mismatch"
	}
	if m.Shift != wantShift {
		return "signed magic shift mismatch"
	}
	if m.AddN != wantAdd || m.SubN != wantSub {
		return "signed magic add/sub flag mismatch"
	}
	return ""
}

func chkU(d uint64, width int, wantM uint64, wantShift int, wantAdd bool) testing.TestResult {
	var m MagicUnsigned = ComputeMagicUnsigned(d, width)
	var wmask uint64 = fullWidthMask(width)
	if (m.M & wmask) != (wantM & wmask) {
		return "unsigned magic M mismatch"
	}
	if m.Shift != wantShift {
		return "unsigned magic shift mismatch"
	}
	if m.Add != wantAdd {
		return "unsigned magic add flag mismatch"
	}
	return ""
}

// Textbook Hacker's Delight 32-bit anchors: magic(7)=0x92492493/2 (add n),
// magicu(7)=0x24924925/add/3, magic(3)=0x55555556/0, magicu(3)=0xaaaaaaab/1.
func TestMagicSigned32Known() testing.TestResult {
	var r testing.TestResult
	r = chkS(cast(int64, 3), 32, cast(uint64, 0x55555556), 0, false, false)
	if len(r) != 0 { return r }
	r = chkS(cast(int64, 7), 32, cast(uint64, 0x92492493), 2, true, false)
	if len(r) != 0 { return r }
	r = chkS(cast(int64, 10), 32, cast(uint64, 0x66666667), 2, false, false)
	if len(r) != 0 { return r }
	r = chkS(cast(int64, -7), 32, cast(uint64, 0x6db6db6d), 2, false, true)
	if len(r) != 0 { return r }
	return ""
}

func TestMagicUnsigned32Known() testing.TestResult {
	var r testing.TestResult
	r = chkU(cast(uint64, 3), 32, cast(uint64, 0xaaaaaaab), 1, false)
	if len(r) != 0 { return r }
	r = chkU(cast(uint64, 7), 32, cast(uint64, 0x24924925), 3, true)
	if len(r) != 0 { return r }
	r = chkU(cast(uint64, 10), 32, cast(uint64, 0xcccccccd), 3, false)
	if len(r) != 0 { return r }
	return ""
}

// 64-bit anchors incl. fasta's % 139968 (signed M=0x3beead01fd6cbe91, shift 15).
func TestMagic64Known() testing.TestResult {
	var r testing.TestResult
	r = chkS(cast(int64, 7), 64, cast(uint64, 0x4924924924924925), 1, false, false)
	if len(r) != 0 { return r }
	r = chkS(cast(int64, 139968), 64, cast(uint64, 0x3beead01fd6cbe91), 15, false, false)
	if len(r) != 0 { return r }
	r = chkU(cast(uint64, 139968), 64, cast(uint64, 0x3beead01fd6cbe91), 15, false)
	if len(r) != 0 { return r }
	r = chkU(cast(uint64, 7), 64, cast(uint64, 0x2492492492492493), 3, true)
	if len(r) != 0 { return r }
	return ""
}

// ---- width-32 formula simulation vs real division ----
// The width-32 path shares the width-64 code; a full simulate-and-compare at
// width 32 fits in int64 (a 32x32 product is 64 bits), so it catches any porting
// error in the shift/correction interaction.

func s32(x int64) int64 { return cast(int64, cast(int32, x)) }

func mulhs32(m int64, n int64) int64 {
	return (cast(int64, cast(int32, m)) * cast(int64, cast(int32, n))) >> 32
}

func mulhu32(m uint64, n uint64) uint64 {
	return ((m & cast(uint64, 0xFFFFFFFF)) * (n & cast(uint64, 0xFFFFFFFF))) >> 32
}

func simDivS32(d int64, n int64) int64 {
	var mg MagicSigned = ComputeMagicSigned(d, 32)
	var q int64 = mulhs32(mg.M, n)
	if mg.AddN { q = s32(q + n) }
	if mg.SubN { q = s32(q - n) }
	q = s32(q >> mg.Shift)
	// add the sign bit: (uint32)q >> 31  ==  1 when q < 0
	var sb uint64 = cast(uint64, cast(uint32, cast(int32, q))) >> 31
	q = s32(q + cast(int64, sb))
	return q
}

func simDivU32(d uint64, n uint64) uint64 {
	var mg MagicUnsigned = ComputeMagicUnsigned(d, 32)
	var q uint64 = mulhu32(mg.M, n)
	if !mg.Add {
		q = (q >> cast(uint64, mg.Shift)) & cast(uint64, 0xFFFFFFFF)
	} else {
		var t uint64 = (((n & cast(uint64, 0xFFFFFFFF)) - q) & cast(uint64, 0xFFFFFFFF)) >> 1
		q = (((t + q) & cast(uint64, 0xFFFFFFFF)) >> cast(uint64, mg.Shift - 1)) &
				cast(uint64, 0xFFFFFFFF)
	}
	return q & cast(uint64, 0xFFFFFFFF)
}

func isPow2_64(x uint64) bool {
	return x != cast(uint64, 0) && (x & (x - cast(uint64, 1))) == cast(uint64, 0)
}

func TestMagicSigned32Sim() testing.TestResult {
	var ds @[]int64 = make_slice(int64, 0)
	ds = appendI64(ds, 3)
	ds = appendI64(ds, 7)
	ds = appendI64(ds, 10)
	ds = appendI64(ds, 100)
	ds = appendI64(ds, 1000)
	ds = appendI64(ds, 139968)
	ds = appendI64(ds, 3877)
	ds = appendI64(ds, 29573)
	ds = appendI64(ds, 12345)
	ds = appendI64(ds, -3)
	ds = appendI64(ds, -7)
	ds = appendI64(ds, -139968)
	ds = appendI64(ds, -100)
	for di := 0; di < len(ds); di++ {
		var d int64 = ds[di]
		var n int64 = cast(int64, -2100000000)
		for k := 0; k < 4200; k++ {
			var nn int64 = s32(n)
			var got int64 = simDivS32(d, nn)
			var want int64 = cast(int64, cast(int32, nn) / cast(int32, d))
			if got != want {
				return "simDivS32 mismatch"
			}
			n = n + 1000003
		}
	}
	return ""
}

func TestMagicUnsigned32Sim() testing.TestResult {
	var ds @[]uint64 = make_slice(uint64, 0)
	ds = appendU64(ds, 3)
	ds = appendU64(ds, 7)
	ds = appendU64(ds, 10)
	ds = appendU64(ds, 100)
	ds = appendU64(ds, 1000)
	ds = appendU64(ds, 139968)
	ds = appendU64(ds, 3877)
	ds = appendU64(ds, 29573)
	ds = appendU64(ds, 4294967295)
	for di := 0; di < len(ds); di++ {
		var d uint64 = ds[di]
		if isPow2_64(d) { continue }
		var n uint64 = cast(uint64, 0)
		for k := 0; k < 4200; k++ {
			var nn uint64 = n & cast(uint64, 0xFFFFFFFF)
			var got uint64 = simDivU32(d, nn)
			var want uint64 = nn / d
			if got != want {
				return "simDivU32 mismatch"
			}
			n = n + cast(uint64, 1000003)
		}
	}
	return ""
}

func appendI64(s @[]int64, v int64) @[]int64 {
	var out @[]int64 = make_slice(int64, len(s) + 1)
	for i := 0; i < len(s); i++ { out[i] = s[i] }
	out[len(s)] = v
	return out
}

func appendU64(s @[]uint64, v uint64) @[]uint64 {
	var out @[]uint64 = make_slice(uint64, len(s) + 1)
	for i := 0; i < len(s); i++ { out[i] = s[i] }
	out[len(s)] = v
	return out
}
