package "pkg/binate/native/common"

import "pkg/stdx/slices"

// Parallel-move (parallel-copy) sequencing for register marshalling.  When a
// call's arguments are marshalled into the ABI argument registers, a value that
// is register-allocated in one of those same registers (a caller-saved / arg-bank
// home) makes the move set a PERMUTATION: `X0<-X1, X1<-X0` cannot be realized by
// naive sequential `mov`s (the first clobbers the second's source).  PlanParallelMove
// turns the requested simultaneous copy into an ordered `mov` list that realizes it,
// breaking cycles through a scratch temp.  Arch-neutral (opaque register numbers), so
// every backend reuses it.

// PlanParallelMove returns the ordered register moves that realize the parallel
// copy { dsts[i] <- srcs[i] for all i } — i.e. after executing the returned moves
// in order, each dsts[i] holds the value srcs[i] held on entry, even when the
// requested moves permute or chain.  The result is a flat list [d0,s0, d1,s1, ...]:
// emit each pair as `mov d, s`.  Identity moves (src == dst) are dropped.  Cycles
// are broken through `temp`, which the caller must guarantee is neither a src nor a
// dst of any requested move (nor otherwise live across the sequence).
//
// Preconditions: len(srcs) == len(dsts); the dsts are DISTINCT (each register is a
// destination at most once — true for ABI argument registers, one value per slot).
// With distinct dsts the move graph is a set of simple chains and cycles (each node
// has at most one outgoing edge "is-read-by" and exactly one incoming "is-written"),
// which this sequentialization handles in O(n^2) (n is tiny — at most the arg-register
// count).
func PlanParallelMove(srcs @[]int, dsts @[]int, temp int) @[]int {
	// Pending moves, as parallel arrays; drop identity moves up front.
	var ps @[]int
	var pd @[]int
	for i := 0; i < len(srcs); i++ {
		if srcs[i] != dsts[i] {
			ps = slices.Append[int](ps, srcs[i])
			pd = slices.Append[int](pd, dsts[i])
		}
	}
	var out @[]int
	// Repeatedly emit any move whose destination is not still needed as some
	// pending move's source (writing it clobbers nothing live); when only cycles
	// remain, break one through temp.
	for len(pd) > 0 {
		var progressed bool = false
		var i int = 0
		for i < len(pd) {
			if !isPendingSrc(ps, pd[i]) {
				// pd[i] is read by nobody still pending: safe to write now.
				out = slices.Append[int](out, pd[i])
				out = slices.Append[int](out, ps[i])
				ps = removeAt(ps, i)
				pd = removeAt(pd, i)
				progressed = true
			} else {
				i = i + 1
			}
		}
		if !progressed {
			// Only cycles left: break one.  Take the first pending move (s0 -> d0).
			// d0 currently holds a value some OTHER pending move reads (that is why
			// it was unsafe).  Stash d0's value in temp, perform s0 -> d0, and
			// redirect every move that read d0 to read temp instead — turning the
			// cycle into a chain the loop above can now drain.
			var s0 int = ps[0]
			var d0 int = pd[0]
			out = slices.Append[int](out, temp)
			out = slices.Append[int](out, d0)
			out = slices.Append[int](out, d0)
			out = slices.Append[int](out, s0)
			ps = removeAt(ps, 0)
			pd = removeAt(pd, 0)
			for k := 0; k < len(ps); k++ {
				if ps[k] == d0 { ps[k] = temp }
			}
		}
	}
	return out
}

// isPendingSrc reports whether reg appears as a source in the pending source list.
func isPendingSrc(ps @[]int, reg int) bool {
	for i := 0; i < len(ps); i++ {
		if ps[i] == reg { return true }
	}
	return false
}

// removeAt returns s with element i removed (order of the rest is not preserved:
// the last element is swapped into the hole, which is fine — pending moves carry no
// order, and ps/pd are kept in lockstep by removing the same index from both).
func removeAt(s @[]int, i int) @[]int {
	s[i] = s[len(s) - 1]
	return s[0:len(s) - 1]
}
