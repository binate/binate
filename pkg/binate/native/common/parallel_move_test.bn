package "pkg/binate/native/common"

import "pkg/builtins/testing"

// simulateParallelMove runs PlanParallelMove and verifies its output realizes the
// requested parallel copy: model each register r as initially holding the sentinel
// value r, apply the returned `mov d, s` sequence in order, then assert every
// requested dsts[i] ends holding srcs[i]'s ORIGINAL value.  temp is given a distinct
// initial sentinel so a plan that leaks temp into a result is caught.  Returns "" on
// success or a failure message.
func simulateParallelMove(srcs @[]int, dsts @[]int, temp int) @[]char {
	var N int = 128
	var val @[]int = make_slice(int, N)
	for r := 0; r < N; r++ { val[r] = r } // reg r holds sentinel r
	val[temp] = 900 + temp // distinct sentinel for temp

	var plan @[]int = PlanParallelMove(srcs, dsts, temp)
	if len(plan) % 2 != 0 { return "plan length must be even (dst,src pairs)" }
	for k := 0; k < len(plan); k = k + 2 {
		var d int = plan[k]
		var s int = plan[k + 1]
		val[d] = val[s]
	}
	for i := 0; i < len(srcs); i++ {
		if val[dsts[i]] != srcs[i] {
			return "parallel move did not realize dsts[i] <- srcs[i]"
		}
	}
	return ""
}

// pmList builds an @[]int from up to four ints (test convenience).
func pm2(a int, b int) @[]int {
	var s @[]int = make_slice(int, 2)
	s[0] = a
	s[1] = b
	return s
}

func pm3(a int, b int, c int) @[]int {
	var s @[]int = make_slice(int, 3)
	s[0] = a
	s[1] = b
	s[2] = c
	return s
}

func pm4(a int, b int, c int, d int) @[]int {
	var s @[]int = make_slice(int, 4)
	s[0] = a
	s[1] = b
	s[2] = c
	s[3] = d
	return s
}

// A move set with no permutation (all sources distinct from all dsts) emits
// straight moves and realizes the copy.
func TestParallelMoveLeaves() testing.TestResult {
	// dst<-src: 0<-10, 1<-11, 2<-12
	return simulateParallelMove(pm3(10, 11, 12), pm3(0, 1, 2), 99)
}

// A chain X2<-X1, X1<-X0 must order so X1 is read before it is overwritten.
func TestParallelMoveChain() testing.TestResult {
	return simulateParallelMove(pm2(1, 0), pm2(2, 1), 99)
}

// A 2-cycle (swap) X0<-X1, X1<-X0 needs the temp to break it.
func TestParallelMoveSwap() testing.TestResult {
	return simulateParallelMove(pm2(1, 0), pm2(0, 1), 99)
}

// A 3-cycle X0<-X1, X1<-X2, X2<-X0.
func TestParallelMove3Cycle() testing.TestResult {
	return simulateParallelMove(pm3(1, 2, 0), pm3(0, 1, 2), 99)
}

// A cycle plus an independent leaf, mixed order.
func TestParallelMoveCyclePlusLeaf() testing.TestResult {
	// 0<-1, 1<-0 (swap) and 5<-12 (leaf)
	return simulateParallelMove(pm3(1, 0, 12), pm3(0, 1, 5), 99)
}

// Identity moves (src == dst) are dropped and must not corrupt other moves.
func TestParallelMoveIdentityDropped() testing.TestResult {
	// 3<-3 (identity), 0<-1, 1<-0 (swap)
	return simulateParallelMove(pm3(3, 1, 0), pm3(3, 0, 1), 99)
}

// A longer permutation exercising several cycle breaks and leaves together.
func TestParallelMoveMixedPermutation() testing.TestResult {
	// dsts distinct: 0,1,2,3; srcs form a 3-cycle (0<-1,1<-2,2<-0) plus leaf 3<-20
	return simulateParallelMove(pm4(1, 2, 0, 20), pm4(0, 1, 2, 3), 99)
}
