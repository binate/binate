package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"

// Register classes for the linear-scan allocator.  The scan engine
// (BuildIntervals / LinearScan / spill-cost weighting / the liveness fixpoint)
// is class-agnostic — it manipulates only opaque physical-register numbers
// supplied by a RegClassDesc — so the SAME pipeline runs once per class,
// differing only in which SSA values are "allocatable" (the predicates here)
// and which register pool the descriptor supplies.  The two allocatable sets
// are disjoint, so a value belongs to at most one class.

// REGCLASS_GP is the general-purpose class (X registers).
const REGCLASS_GP int = 0

// REGCLASS_FP is the floating-point class (V/D registers).
const REGCLASS_FP int = 1

// isAllocatableFpType reports whether a scalar of type t is a floating-point
// value homeable in an FP (V/D) register.  Every float scalar qualifies:
// unlike a wide int on a 32-bit target (a GP register PAIR, excluded by
// isAllocatableType), an f64 occupies a SINGLE D register on every target, so
// there is no word-size exclusion here.
func isAllocatableFpType(t @types.Type) bool {
	return IsFloatScalarTyp(t)
}

// isAllocatableForClass dispatches the allocatable-type test by register class:
// GP scalars (isAllocatableType) for REGCLASS_GP, FP scalars (isAllocatableFpType)
// for REGCLASS_FP.
func isAllocatableForClass(t @types.Type, wordBytes int, regClass int) bool {
	if regClass == REGCLASS_FP {
		return isAllocatableFpType(t)
	}
	return isAllocatableType(t, wordBytes)
}

// isAllocatableDefClass is isAllocatableDef parameterized by register class: an
// OP_ALLOC never participates (its address is materialized on demand), and the
// result type must be allocatable in the given class.
func isAllocatableDefClass(ins @ir.Instr, wordBytes int, regClass int) bool {
	if ins.ID < 0 { return false }
	if ins.Op == iropcode.OP_ALLOC { return false }
	return isAllocatableForClass(ins.Typ, wordBytes, regClass)
}
