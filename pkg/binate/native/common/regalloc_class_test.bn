package "pkg/binate/native/common"

import "pkg/binate/types"
import "pkg/builtins/testing"

// The register-class allocatable predicates (regalloc_class.bn) split floats
// (FP class) from GP scalars; the two sets are disjoint, so a value belongs to
// at most one class.  A float is FP-allocatable and not GP-allocatable; an int
// the reverse; float32 qualifies for FP just like float64 (no word-size
// exclusion for FP).
func TestAllocatableClassPredicates() testing.TestResult {
	setTarget64()
	var ft @types.Type = types.TypFloat64()
	var it @types.Type = types.TypInt()
	if !isAllocatableForClass(ft, 8, REGCLASS_FP) { return "float64 must be FP-allocatable" }
	if isAllocatableForClass(it, 8, REGCLASS_FP) { return "int must not be FP-allocatable" }
	if !isAllocatableForClass(it, 8, REGCLASS_GP) { return "int must be GP-allocatable" }
	if isAllocatableForClass(ft, 8, REGCLASS_GP) { return "float64 must not be GP-allocatable" }
	if !isAllocatableFpType(types.TypFloat32()) { return "float32 must be FP-allocatable" }
	return ""
}
