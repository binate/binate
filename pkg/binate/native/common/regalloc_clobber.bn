package "pkg/binate/native/common"

import "pkg/binate/iropcode"

// The arch-neutral half of the register allocator's clobber model.
//
// A real allocator keeps values in registers across instruction
// boundaries, so it must know which instructions DESTROY registers.  The
// decisive question is not "does this op emit a BL?" but "does it emit a BL
// that can RETURN to the following instruction?" — because only a returning
// call can corrupt a value the following code still needs.  A guard whose
// only call is on a cold, noreturn fail path (bounds check) clobbers
// nothing on the path that continues.
//
// EmitsReturningBl classifies the ops that ALL native backends lower to an
// unconditional-or-conditional-but-RETURNING call, so a value live across
// such an op cannot sit in a caller-saved register.  The per-arch register
// descriptor turns this into a concrete physical clobber set (caller-saved
// registers, plus any arch-specific fixed-register ops like x64 div/shift);
// that lives with each backend, since only it knows its lowering.

// EmitsReturningBl reports whether op's native lowering emits a call
// (BL / CALL) that can return to the next instruction — i.e. an op across
// which caller-saved registers are not preserved — on EVERY native backend.
// It is the ARCH-NEUTRAL CORE of the clobber model, NOT a complete clobber
// set for any single backend (see the per-arch note below).
//
// Included (each verified against the actual lowering in all three
// backends — aarch64 / x64 / arm32):
//   - the call family: OP_CALL, OP_CALL_INDIRECT, OP_C_CALL,
//     OP_CALL_FUNC_VALUE, OP_CALL_HANDLE, OP_CALL_IFACE_METHOD — user
//     callees, unconditional and returning;
//   - OP_SAT_LOOKUP — a call to rt.SatLookup, returns the resolved vtable;
//   - OP_MAKE (rt.Alloc), OP_BOX (rt.Box), OP_MAKE_SLICE
//     (rt.MakeManagedSlice) — unconditional, returning;
//   - OP_RODATA_MSLICE_COPY — an owned `@[]T` string/const literal lowers
//     to an unconditional rt.MakeManagedSlice call (returns) on every
//     backend;
//   - OP_STACK_FRAMES — an unconditional rt.CaptureNativeFrames call
//     (returns an int); every backend already resets its scratch pool
//     right after this call, treating it as a full caller-saved clobber;
//   - OP_DIV_CHECK / OP_SHIFT_CHECK — an UNCONDITIONAL call to rt.DivCheck /
//     rt.ShiftCheck that returns on valid input (it panics only on bad
//     input), so caller-saved registers are clobbered on the normal path;
//   - OP_REFDEC — its inline fast path ends in a CONDITIONAL call to the
//     destructor (rt.ZeroRefDestroy) when the refcount hits zero, and the
//     destructor RETURNS to the following instruction, so a value live
//     across it must survive a possible call.
//
// Excluded — these emit no returning call on the continuing path (verified
// identical on all three backends):
//   - OP_BOUNDS_CHECK — inline compares plus a conditional branch to a
//     cold rt.BoundsFail call, which is NORETURN (it aborts); the normal
//     (in-bounds) path executes no call, so nothing is clobbered there;
//   - OP_NIL_CHECK — a no-op natively (a nil deref is left as a hardware
//     fault), so it emits nothing.
//
// PER-ARCH ADDITIONS (NOT in this set — a backend that keeps values in
// registers must add its own clobber points on top of this arch-neutral
// core; aarch64 needs none, so this set alone is complete there):
//   - x64 additionally clobbers across OP_REFINC — it calls rt.RefInc,
//     whereas aarch64 and arm32 inline the refcount bump with no call;
//   - arm32 additionally clobbers across its AEABI libcalls: int64
//     OP_MUL / OP_DIV / OP_REM / OP_SHL / OP_SHR (__aeabi_l*), and — under
//     soft-float — float OP_ADD / OP_SUB / OP_MUL / OP_DIV, the float
//     comparisons, and float OP_CAST (__aeabi_[fd]*).  aarch64 and x64 use
//     hardware integer/FP instructions for these, so they emit no call.
func EmitsReturningBl(op int) bool {
	if op == iropcode.OP_CALL { return true }
	if op == iropcode.OP_CALL_INDIRECT { return true }
	if op == iropcode.OP_C_CALL { return true }
	if op == iropcode.OP_CALL_FUNC_VALUE { return true }
	if op == iropcode.OP_CALL_HANDLE { return true }
	if op == iropcode.OP_CALL_IFACE_METHOD { return true }
	if op == iropcode.OP_SAT_LOOKUP { return true }
	if op == iropcode.OP_MAKE { return true }
	if op == iropcode.OP_BOX { return true }
	if op == iropcode.OP_MAKE_SLICE { return true }
	if op == iropcode.OP_RODATA_MSLICE_COPY { return true }
	if op == iropcode.OP_STACK_FRAMES { return true }
	if op == iropcode.OP_DIV_CHECK { return true }
	if op == iropcode.OP_SHIFT_CHECK { return true }
	if op == iropcode.OP_REFDEC { return true }
	return false
}
