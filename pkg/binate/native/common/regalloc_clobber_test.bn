package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// EmitsReturningBl must flag every op whose native lowering emits a call
// that returns to the following instruction — a value live across such an
// op cannot stay in a caller-saved register.

func TestEmitsReturningBlCalls() testing.TestResult {
	if !EmitsReturningBl(iropcode.OP_CALL) { return "OP_CALL is a returning call" }
	if !EmitsReturningBl(iropcode.OP_CALL_INDIRECT) { return "OP_CALL_INDIRECT is a returning call" }
	if !EmitsReturningBl(iropcode.OP_C_CALL) { return "OP_C_CALL is a returning call" }
	if !EmitsReturningBl(iropcode.OP_CALL_FUNC_VALUE) {
		return "OP_CALL_FUNC_VALUE is a returning call"
	}
	if !EmitsReturningBl(iropcode.OP_CALL_HANDLE) { return "OP_CALL_HANDLE is a returning call" }
	if !EmitsReturningBl(iropcode.OP_CALL_IFACE_METHOD) {
		return "OP_CALL_IFACE_METHOD is a returning call"
	}
	if !EmitsReturningBl(iropcode.OP_SAT_LOOKUP) { return "OP_SAT_LOOKUP calls rt.SatLookup" }
	return ""
}

func TestEmitsReturningBlRuntimeAllocOps() testing.TestResult {
	if !EmitsReturningBl(iropcode.OP_MAKE) { return "OP_MAKE calls rt.Alloc" }
	if !EmitsReturningBl(iropcode.OP_BOX) { return "OP_BOX calls rt.Box" }
	if !EmitsReturningBl(iropcode.OP_MAKE_SLICE) { return "OP_MAKE_SLICE calls rt.MakeManagedSlice" }
	return ""
}

// The div/shift guards are UNCONDITIONAL calls to rt.DivCheck / rt.ShiftCheck
// that return on valid input — so they clobber caller-saved on the normal path.
func TestEmitsReturningBlDivShiftChecks() testing.TestResult {
	if !EmitsReturningBl(iropcode.OP_DIV_CHECK) {
		return "OP_DIV_CHECK unconditionally calls rt.DivCheck"
	}
	if !EmitsReturningBl(iropcode.OP_SHIFT_CHECK) {
		return "OP_SHIFT_CHECK unconditionally calls rt.ShiftCheck"
	}
	return ""
}

// OP_REFDEC's conditional destructor call RETURNS to the next instruction,
// so a value live across it must survive a possible call.
func TestEmitsReturningBlRefdec() testing.TestResult {
	if !EmitsReturningBl(iropcode.OP_REFDEC) {
		return "OP_REFDEC's dtor slow path is a returning call"
	}
	return ""
}

// An owned string/const literal (OP_RODATA_MSLICE_COPY) and a stack-trace
// capture (OP_STACK_FRAMES) both lower to an unconditional returning rt
// call on every backend.
func TestEmitsReturningBlRodataCopyAndStackFrames() testing.TestResult {
	if !EmitsReturningBl(iropcode.OP_RODATA_MSLICE_COPY) {
		return "OP_RODATA_MSLICE_COPY calls rt.MakeManagedSlice"
	}
	if !EmitsReturningBl(iropcode.OP_STACK_FRAMES) {
		return "OP_STACK_FRAMES calls rt.CaptureNativeFrames"
	}
	return ""
}

// OP_REFINC is NOT in the arch-neutral set: aarch64/arm32 inline the
// refcount bump (no call), and only x64 calls rt.RefInc — so it is a
// per-arch (x64) clobber point, not a universal one.  Same for the
// rodata-slice / rodata-array address materializations, which only load.
func TestEmitsReturningBlExcludesArchDivergentAndRodata() testing.TestResult {
	if EmitsReturningBl(iropcode.OP_REFINC) {
		return "OP_REFINC is inline on aarch64/arm32 — a per-arch (x64) clobber, not arch-neutral"
	}
	if EmitsReturningBl(iropcode.OP_RODATA_MSLICE) {
		return "OP_RODATA_MSLICE materializes a pointer to static data — no call"
	}
	if EmitsReturningBl(iropcode.OP_RODATA_ARRAY) {
		return "OP_RODATA_ARRAY is an inline byte copy — no call"
	}
	return ""
}

// A bounds check's only call is on a cold, NORETURN fail path; the in-bounds
// path executes no call, so it clobbers nothing.  A nil check is a native
// no-op.  Neither is a returning-call clobber point.
func TestEmitsReturningBlExcludesNoreturnGuards() testing.TestResult {
	if EmitsReturningBl(iropcode.OP_BOUNDS_CHECK) {
		return "OP_BOUNDS_CHECK's fail path is noreturn — not a clobber point"
	}
	if EmitsReturningBl(iropcode.OP_NIL_CHECK) {
		return "OP_NIL_CHECK is a native no-op — not a clobber point"
	}
	return ""
}

// Plain arithmetic / moves emit no call.
func TestEmitsReturningBlExcludesPureOps() testing.TestResult {
	if EmitsReturningBl(iropcode.OP_ADD) { return "OP_ADD emits no call" }
	if EmitsReturningBl(iropcode.OP_COPY) { return "OP_COPY emits no call" }
	if EmitsReturningBl(iropcode.OP_LOAD) { return "OP_LOAD emits no call" }
	if EmitsReturningBl(iropcode.OP_ALLOC) { return "OP_ALLOC emits no call" }
	return ""
}

// mkTypedInstr builds a minimal single-op instruction carrying result type typ
// (no operands) for the isClobberInstr type-conditioned classifier tests.
func mkTypedInstr(op int, typ @types.Type) @ir.Instr {
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = op
	ins.Typ = typ
	return ins
}

// mkCastInstr builds an OP_CAST from src to dst (dst is ins.Typ, src is
// ins.Args[0].Typ) — the shape isInt64LibcallOp / isSoftFloatLibcallOp inspect.
func mkCastInstr(dst @types.Type, src @types.Type) @ir.Instr {
	var arg @ir.Instr = make(ir.Instr)
	arg.Typ = src
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CAST
	ins.Typ = dst
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = arg
	return ins
}

// mkCmpInstr builds a float comparison (OP_LT) whose result is bool but whose
// float-ness is keyed on the operand type — the shape isSoftFloatLibcallOp
// inspects for comparisons.
func mkCmpInstr(operandTyp @types.Type) @ir.Instr {
	var arg @ir.Instr = make(ir.Instr)
	arg.Typ = operandTyp
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_LT
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = arg
	return ins
}

// Int64OpsClobber makes the arm32 int64 AEABI libcalls (mul/div/rem/shl/shr on
// a 64-bit result) clobbers; the identical int32 ops (hardware) are not.
func TestIsClobberInstrInt64ArithLibcalls() testing.TestResult {
	var desc RegClassDesc
	desc.Int64OpsClobber = true
	if !isClobberInstr(mkTypedInstr(iropcode.OP_MUL, types.TypInt64()), desc) {
		return "int64 OP_MUL is a __aeabi_lmul call"
	}
	if !isClobberInstr(mkTypedInstr(iropcode.OP_DIV, types.TypInt64()), desc) {
		return "int64 OP_DIV is a libcall"
	}
	if !isClobberInstr(mkTypedInstr(iropcode.OP_REM, types.TypInt64()), desc) {
		return "int64 OP_REM is a libcall"
	}
	if !isClobberInstr(mkTypedInstr(iropcode.OP_SHL, types.TypInt64()), desc) {
		return "int64 OP_SHL is a libcall"
	}
	if !isClobberInstr(mkTypedInstr(iropcode.OP_SHR, types.TypInt64()), desc) {
		return "int64 OP_SHR is a libcall"
	}
	if isClobberInstr(mkTypedInstr(iropcode.OP_MUL, types.TypInt32()), desc) {
		return "int32 OP_MUL is a hardware MUL, not a call"
	}
	if isClobberInstr(mkTypedInstr(iropcode.OP_ADD, types.TypInt64()), desc) {
		return "int64 OP_ADD is an inline pair sequence, not a call"
	}
	return ""
}

// An int64<->float CAST is a libcall in BOTH float ABIs (VFP has no such
// convert), so Int64OpsClobber alone flags it even with SoftFloatOpsClobber off.
func TestIsClobberInstrInt64FloatCast() testing.TestResult {
	var desc RegClassDesc
	desc.Int64OpsClobber = true
	desc.SoftFloatOpsClobber = false
	if !isClobberInstr(mkCastInstr(types.TypFloat64(), types.TypInt64()), desc) {
		return "int64->float CAST is a libcall under hard-float too"
	}
	if !isClobberInstr(mkCastInstr(types.TypInt64(), types.TypFloat64()), desc) {
		return "float->int64 CAST is a libcall under hard-float too"
	}
	// int32<->int64 is an inline pair widen/narrow, not a call.
	if isClobberInstr(mkCastInstr(types.TypInt64(), types.TypInt32()), desc) {
		return "int32->int64 CAST is inline, not a call"
	}
	return ""
}

// SoftFloatOpsClobber makes float arith/compare/cast libcalls; int32 arith is
// untouched.  Under hard-float (flag off) the float arith is a VFP op, no call.
func TestIsClobberInstrSoftFloat() testing.TestResult {
	var soft RegClassDesc
	soft.SoftFloatOpsClobber = true
	if !isClobberInstr(mkTypedInstr(iropcode.OP_ADD, types.TypFloat32()), soft) {
		return "float OP_ADD is __aeabi_fadd under soft-float"
	}
	if !isClobberInstr(mkTypedInstr(iropcode.OP_DIV, types.TypFloat64()), soft) {
		return "float64 OP_DIV is __aeabi_ddiv under soft-float"
	}
	if !isClobberInstr(mkCmpInstr(types.TypFloat32()), soft) {
		return "a float comparison is __aeabi_fcmp* under soft-float"
	}
	if !isClobberInstr(mkCastInstr(types.TypFloat32(), types.TypInt()), soft) {
		return "int32->float CAST is a libcall under soft-float"
	}
	if isClobberInstr(mkTypedInstr(iropcode.OP_ADD, types.TypInt()), soft) {
		return "int32 OP_ADD is a hardware add, not a call"
	}
	var hard RegClassDesc
	hard.SoftFloatOpsClobber = false
	if isClobberInstr(mkTypedInstr(iropcode.OP_ADD, types.TypFloat32()), hard) {
		return "under hard-float, float OP_ADD is a VFP op, no call"
	}
	return ""
}

// The load-bearing inertness property: with both flags false (aarch64/x64), the
// classifier reduces to EmitsReturningBl — the type-conditioned libcall families
// are NOT clobbers there, so those backends' clobber set is unchanged.
func TestIsClobberInstrInertForOtherBackends() testing.TestResult {
	var desc RegClassDesc
	desc.Int64OpsClobber = false
	desc.SoftFloatOpsClobber = false
	if isClobberInstr(mkTypedInstr(iropcode.OP_MUL, types.TypInt64()), desc) {
		return "int64 OP_MUL must not clobber when Int64OpsClobber is false"
	}
	if isClobberInstr(mkTypedInstr(iropcode.OP_ADD, types.TypFloat64()), desc) {
		return "float OP_ADD must not clobber when SoftFloatOpsClobber is false"
	}
	if isClobberInstr(mkCastInstr(types.TypFloat64(), types.TypInt64()), desc) {
		return "int64<->float CAST must not clobber when both flags are false"
	}
	// A genuine returning call is still a clobber regardless of the flags.
	if !isClobberInstr(mkTypedInstr(iropcode.OP_CALL, types.TypInt()), desc) {
		return "OP_CALL is a clobber on every backend"
	}
	return ""
}

// UnhomeID removes exactly the named id from the home map, leaving the rest
// intact; unknown ids are a no-op.
func TestUnhomeID() testing.TestResult {
	var m @RegMap = NewRegMap(AAPCS32())
	m.HomeIDs = AppendInt(m.HomeIDs, 5)
	m.HomeRegs = AppendInt(m.HomeRegs, 1)
	m.HomeIDs = AppendInt(m.HomeIDs, 6)
	m.HomeRegs = AppendInt(m.HomeRegs, 2)
	m.HomeIDs = AppendInt(m.HomeIDs, 7)
	m.HomeRegs = AppendInt(m.HomeRegs, 3)
	m.UnhomeID(6)
	if m.LookupHome(6) >= 0 { return "id 6 must no longer be homed" }
	if m.LookupHome(5) != 1 { return "id 5's home must survive" }
	if m.LookupHome(7) != 3 { return "id 7's home must survive" }
	if len(m.HomeIDs) != 2 { return "exactly one entry removed" }
	m.UnhomeID(99)
	if len(m.HomeIDs) != 2 { return "unhoming an unknown id is a no-op" }
	return ""
}
