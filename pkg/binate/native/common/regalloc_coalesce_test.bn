package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/iropt"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// mkHoled builds a two-range interval [s0, e0) ∪ [s1, e1) for id, born at s0 —
// the shape of a loop-carried phi id (live to its last use, dead, then
// redefined by the latch copy).
func mkHoled(id int, s0 int, e0 int, s1 int, e1 int) @LiveInterval {
	var iv @LiveInterval = mkInterval(id, s0, e0)
	var r LiveRange
	r.Start = s1
	r.End = e1
	iv.Ranges = slices.Append[LiveRange](iv.Ranges, r)
	return iv
}

// mkCopies1 builds a one-entry tie list: the copy dst <- src at pos.
func mkCopies1(pos int, dst int, src int) @[]TiePoint {
	var s @[]TiePoint = make_slice(TiePoint, 1)
	s[0].Pos = pos
	s[0].Def = dst
	s[0].Use = src
	s[0].Copy = true
	return s
}

// mkTie builds a tie (not a copy): the instruction at pos defines def and reads
// use.
func mkTie(pos int, def int, use int) TiePoint {
	var t TiePoint
	t.Pos = pos
	t.Def = def
	t.Use = use
	return t
}

// checkNoRangeConflict asserts the range-aware invariant: no two intervals
// sharing a register are live together except at a tie between them.
func checkNoRangeConflict(ivs @[]@LiveInterval, asg @[]RegAssignment, ties @[]TiePoint) @[]char {
	for i := 0; i < len(ivs); i++ {
		for j := i + 1; j < len(ivs); j++ {
			var ri int = AssignedReg(asg, ivs[i].ID)
			var rj int = AssignedReg(asg, ivs[j].ID)
			if ri < 0 || ri != rj { continue }
			if !intervalsCompatible(ivs[i], ivs[j], ties) {
				return "two conflicting intervals were assigned the same register"
			}
		}
	}
	return ""
}

func TestCompatibleDisjointRanges() testing.TestResult {
	var p @LiveInterval = mkHoled(1, 0, 4, 8, 10)
	var t @LiveInterval = mkInterval(2, 5, 7)
	if !intervalsCompatible(p, t, noTies()) { return "a value in the hole should fit" }
	if !intervalsCompatible(t, p, noTies()) { return "compatibility should be symmetric" }
	return ""
}

func TestCompatibleRejectsOverlap() testing.TestResult {
	var p @LiveInterval = mkHoled(1, 0, 4, 8, 10)
	if intervalsCompatible(p, mkInterval(2, 3, 5), noTies()) {
		return "overlapping the first range must conflict"
	}
	if intervalsCompatible(p, mkInterval(2, 7, 9), noTies()) {
		return "a one-position overlap with no copy must conflict"
	}
	// A copy at the overlap position, but between other values.
	if intervalsCompatible(p, mkInterval(2, 7, 9), mkCopies1(8, 1, 3)) {
		return "a copy between other values must not excuse the overlap"
	}
	// A copy between the two, but the overlap is two positions long.
	if intervalsCompatible(p, mkInterval(2, 7, 10), mkCopies1(8, 1, 2)) {
		return "a copy must not excuse an overlap longer than its own position"
	}
	return ""
}

func TestCompatibleAtCopyPosition() testing.TestResult {
	// p <- m at 8: m used there (ends at 9), p defined there (starts at 8).
	var p @LiveInterval = mkHoled(1, 0, 4, 8, 10)
	var m @LiveInterval = mkInterval(2, 5, 9)
	if !intervalsCompatible(p, m, mkCopies1(8, 1, 2)) {
		return "the copy's source and destination may overlap at the copy"
	}
	if !intervalsCompatible(m, p, mkCopies1(8, 1, 2)) {
		return "copy compatibility should be symmetric"
	}
	return ""
}

// The induction shape `iNext = i + 1` right before `copy i <- iNext`: i's last
// use (4) and its redefinition (5) are adjacent, so its ranges merge into one
// and it covers both positions iNext does.  Both are ties — the add defines
// iNext reading i (dead after 4: 5 redefines it), the copy defines i reading
// iNext (dead after 5) — so the two may share.
func TestCompatibleTieChain() testing.TestResult {
	var i @LiveInterval = mkInterval(1, 0, 10)
	var n @LiveInterval = mkInterval(2, 4, 6)
	var ties @[]TiePoint = make_slice(TiePoint, 2)
	ties[0] = mkTie(4, 2, 1)
	ties[1] = mkTie(5, 1, 2)
	ties[1].Copy = true
	if !intervalsCompatible(i, n, ties) { return "the add and the copy tie i and iNext" }
	// Without the copy's tie, i is not redefined at 5, so it stays live past the
	// add: a real conflict.
	var addOnly @[]TiePoint = make_slice(TiePoint, 1)
	addOnly[0] = mkTie(4, 2, 1)
	if intervalsCompatible(i, n, addOnly) { return "i live past the add must conflict" }
	return ""
}

func TestFirstTieAt() testing.TestResult {
	var t @[]TiePoint = make_slice(TiePoint, 4)
	t[0] = mkTie(2, 1, 2)
	t[1] = mkTie(5, 3, 4)
	t[2] = mkTie(5, 3, 6)
	t[3] = mkTie(9, 7, 8)
	if firstTieAt(t, 2) != 0 || firstTieAt(t, 5) != 1 || firstTieAt(t, 9) != 3 {
		return "each tie position should find its first entry"
	}
	if firstTieAt(t, 0) != 0 || firstTieAt(t, 6) != 3 || firstTieAt(t, 10) != 4 {
		return "a position with no tie should find the insertion point"
	}
	if !definesAt(t, 5, 3) || definesAt(t, 5, 4) || definesAt(t, 6, 3) {
		return "definesAt should match only a tie at that position defining the id"
	}
	return ""
}

// End to end on real IR: a counted loop whose increment is its latch value.
// CollectTiePoints finds the increment and the latch copy `i <- iNext`, and the
// scan puts the induction id and iNext in one register.
func TestCoalesceLoopInduction() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "loop", makeNoParams(), makeNoResults())
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var bound @ir.Instr = irbuild.EmitConstInt(pre, 10, types.TypInt())
	var initV @ir.Instr = irbuild.EmitConstInt(pre, 0, types.TypInt())
	irbuild.EmitJump(pre, header)
	var phi @ir.Instr = irbuild.EmitPhi(header, types.TypInt(), twoPE(pre, initV, pre, initV))
	var cond @ir.Instr = irbuild.EmitBinop(header, iropcode.OP_LT, phi, bound, types.TypBool())
	irbuild.EmitBranch(header, cond, body, exit)
	var one @ir.Instr = irbuild.EmitConstInt(body, 1, types.TypInt())
	var iNext @ir.Instr = irbuild.EmitBinop(body, iropcode.OP_ADD, phi, one, types.TypInt())
	irbuild.EmitJump(body, header)
	phi.Phis = twoPE(pre, initV, body, iNext)
	irbuild.EmitReturn(exit, makeNoInstrs())

	var phiID int = phi.ID
	var nextID int = iNext.ID
	iropt.EliminatePhis(f)
	var lv @LivenessInfo = ComputeLiveness(f, 8)
	var ivs @[]@LiveInterval = BuildIntervals(f, lv)
	var ops @[]int = make_slice(int, 2)
	ops[0] = iropcode.OP_COPY
	ops[1] = iropcode.OP_ADD
	var ties @[]TiePoint = CollectTiePoints(f, lv, ops)
	var sawLatch bool = false
	var sawAdd bool = false
	for k := 0; k < len(ties); k++ {
		if ties[k].Copy && ties[k].Def == phiID && ties[k].Use == nextID { sawLatch = true }
		if !ties[k].Copy && ties[k].Def == nextID && ties[k].Use == phiID { sawAdd = true }
		if k > 0 && ties[k].Pos < ties[k - 1].Pos { return "ties should ascend by position" }
	}
	if !sawLatch { return "the latch copy i <- iNext should be a tie" }
	if !sawAdd { return "the increment iNext = i + 1 should be a tie" }
	if len(CollectTiePoints(f, lv, noClobbers())) != 0 { return "no tie ops, no ties" }
	var asg @[]RegAssignment = LinearScan(ivs, noClobbers(), mkDesc(mkRegs(8, 100), noClobbers()),
			noCounts(), ties)
	if AssignedReg(asg, phiID) < 0 || AssignedReg(asg, phiID) != AssignedReg(asg, nextID) {
		return "the induction id and its increment should share a register"
	}
	return checkNoRangeConflict(ivs, asg, ties)
}

func TestFirstRangeEndingAfter() testing.TestResult {
	var iv @LiveInterval = mkHoled(1, 0, 4, 8, 10)
	if firstRangeEndingAfter(iv, 0) != 0 || firstRangeEndingAfter(iv, 3) != 0 {
		return "a position inside or before the first range starts at it"
	}
	if firstRangeEndingAfter(iv, 4) != 1 || firstRangeEndingAfter(iv, 9) != 1 {
		return "a position past the first range starts at the second"
	}
	if firstRangeEndingAfter(iv, 10) != 2 { return "a position past every range finds none" }
	return ""
}

// SameHome: both ids homed, in one register.
func TestSameHome() testing.TestResult {
	var m @RegMap = NewRegMap(SysV_AMD64())
	m.HomeIDs = AppendInt(AppendInt(AppendInt(m.HomeIDs, 1), 2), 3)
	m.HomeRegs = AppendInt(AppendInt(AppendInt(m.HomeRegs, 7), 7), 8)
	if !m.SameHome(1, 2) { return "ids 1 and 2 share register 7" }
	if m.SameHome(1, 3) { return "ids 1 and 3 have different homes" }
	if m.SameHome(1, 4) || m.SameHome(4, 5) { return "an unhomed id shares no home" }
	return ""
}

// A tie to a value that is folded away (here a constant riding an immediate) is
// dropped; the tie to the real operand stays.
func TestDropFoldedTies() testing.TestResult {
	var m @RegMap = NewRegMap(SysV_AMD64())
	var folded @[]bool = make_slice(bool, 4)
	folded[2] = true
	m.FoldedImm = folded
	var ties @[]TiePoint = make_slice(TiePoint, 2)
	ties[0] = mkTie(5, 3, 2)
	ties[1] = mkTie(5, 3, 1)
	var kept @[]TiePoint = m.dropFoldedTies(ties)
	if len(kept) != 1 || kept[0].Use != 1 { return "only the tie to the real operand should remain" }
	return ""
}
