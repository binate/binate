package "pkg/binate/native/common"

// RegMap fold/fuse flag accessors: each reports whether a value is a fold
// candidate in one of the id-indexed flag sets a backend populates before
// AllocateRegisters (a folded value is left unhomed and skip-emitted, riding
// its consuming instruction).  All return false for an empty set (the fold
// disabled) or an out-of-range id.  Split from regalloc_scan.bn (file length).

// IsFoldedDtorHandle reports whether OP_FUNC_HANDLE value id was folded into an
// inline RefDec slow path (populated by AllocateRegisters when the fold is
// enabled).  Always false when m.FoldedDtor is empty (fold disabled, or id out
// of range).
func (m @RegMap) IsFoldedDtorHandle(id int) bool {
	if id < 0 || id >= len(m.FoldedDtor) { return false }
	return m.FoldedDtor[id]
}

// IsFusableElemGep reports whether OP_GET_ELEM_PTR value id folds into a scaled
// register-offset load/store (set on m.FusableGep by the backend before
// AllocateRegisters).  Always false when m.FusableGep is empty (fold disabled,
// or id out of range).
func (m @RegMap) IsFusableElemGep(id int) bool {
	if id < 0 || id >= len(m.FusableGep) { return false }
	return m.FusableGep[id]
}

// IsFusableFieldGep reports whether OP_GET_FIELD_PTR value id folds into a
// constant-offset load/store (set on m.FusableFieldGep by the backend before
// AllocateRegisters).  Always false when m.FusableFieldGep is empty (fold
// disabled, or id out of range).
func (m @RegMap) IsFusableFieldGep(id int) bool {
	if id < 0 || id >= len(m.FusableFieldGep) { return false }
	return m.FusableFieldGep[id]
}

// UnionFusable returns the id-indexed OR of two GEP fold flag sets, sized to the
// longer.  A short-circuit returns the non-empty operand when the other is empty
// (the common case — a backend with at most one GEP fold enabled), avoiding an
// allocation; only when both are non-empty is a fresh union built.  Backends use
// it to feed the combined element+field fold set to the liveness live-before
// pass, matching AllocateRegisters' own union.
func UnionFusable(a @[]bool, b @[]bool) @[]bool {
	if len(a) == 0 { return b }
	if len(b) == 0 { return a }
	var n int = len(a)
	if len(b) > n { n = len(b) }
	var r @[]bool = make_slice(bool, n)
	for i := 0; i < n; i++ {
		r[i] = (i < len(a) && a[i]) || (i < len(b) && b[i])
	}
	return r
}

// IsFusedCmp reports whether integer-comparison value id fuses into its
// consuming conditional branch (set on m.FusedCmp by the backend before
// AllocateRegisters).  Always false when m.FusedCmp is empty (fusion disabled,
// or id out of range).
func (m @RegMap) IsFusedCmp(id int) bool {
	if id < 0 || id >= len(m.FusedCmp) { return false }
	return m.FusedCmp[id]
}

// IsFoldedImmConst reports whether OP_CONST_INT value id folds into a compare
// immediate (set on m.FoldedImmConst by the backend before AllocateRegisters).
// Always false when m.FoldedImmConst is empty (fold disabled, or id out of range).
func (m @RegMap) IsFoldedImmConst(id int) bool {
	if id < 0 || id >= len(m.FoldedImmConst) { return false }
	return m.FoldedImmConst[id]
}

// IsFoldedAddImmConst reports whether OP_CONST_INT value id folds into an add/sub
// immediate (set on m.FoldedAddImmConst by the backend before AllocateRegisters).
// Always false when m.FoldedAddImmConst is empty (fold disabled, or id out of range).
func (m @RegMap) IsFoldedAddImmConst(id int) bool {
	if id < 0 || id >= len(m.FoldedAddImmConst) { return false }
	return m.FoldedAddImmConst[id]
}

// IsTstFoldedAnd reports whether OP_AND value id folds into a `tst` with its
// consuming equality-with-zero compare (set on m.TstFoldedAnd by the backend
// before AllocateRegisters).  Always false when m.TstFoldedAnd is empty.
func (m @RegMap) IsTstFoldedAnd(id int) bool {
	if id < 0 || id >= len(m.TstFoldedAnd) { return false }
	return m.TstFoldedAnd[id]
}
