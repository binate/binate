package "pkg/binate/native/common"

import "pkg/builtins/testing"

// A fresh RegMap has empty flag sets, so every fold/fuse accessor returns false
// (fold disabled), and an out-of-range id is false regardless.
func TestFoldFlagAccessorsEmptyFalse() testing.TestResult {
	var m @RegMap = NewRegMap(AAPCS64())
	if m.IsFoldedAddImmConst(0) { return "empty FoldedAddImmConst must be false" }
	if m.IsFoldedImmConst(0) { return "empty FoldedImmConst must be false" }
	if m.IsFusedCmp(0) { return "empty FusedCmp must be false" }
	if m.IsTstFoldedAnd(0) { return "empty TstFoldedAnd must be false" }
	return ""
}

// A set flag reads true at its id; unset ids, negative ids, and ids past the end
// read false.
func TestIsFoldedAddImmConstSetAndBounds() testing.TestResult {
	var m @RegMap = NewRegMap(AAPCS64())
	var f @[]bool = make_slice(bool, 4)
	f[2] = true
	m.FoldedAddImmConst = f
	if !m.IsFoldedAddImmConst(2) { return "a set FoldedAddImmConst id must be true" }
	if m.IsFoldedAddImmConst(1) { return "an unset id must be false" }
	if m.IsFoldedAddImmConst(0 - 1) { return "a negative id must be false" }
	if m.IsFoldedAddImmConst(100) { return "an out-of-range id must be false" }
	return ""
}

// UnionFusable short-circuits when one operand is empty (returning the other) and
// ORs element-wise when both are non-empty.
func TestUnionFusable() testing.TestResult {
	var a @[]bool = make_slice(bool, 3)
	a[0] = true
	var b @[]bool = make_slice(bool, 3)
	b[2] = true
	var empty @[]bool = make_slice(bool, 0)
	if len(UnionFusable(empty, a)) != 3 { return "empty ∪ a must return a" }
	if len(UnionFusable(a, empty)) != 3 { return "a ∪ empty must return a" }
	var u @[]bool = UnionFusable(a, b)
	if !u[0] || !u[2] || u[1] { return "a ∪ b must be the element-wise OR" }
	return ""
}
