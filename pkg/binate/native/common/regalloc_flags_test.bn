package "pkg/binate/native/common"

import "pkg/binate/buf"
import "pkg/binate/native/callconv"
import "pkg/builtins/testing"

// A fresh RegMap has empty flag sets, so every fold/fuse accessor returns false
// (fold disabled), and an out-of-range id is false regardless.
func TestFoldFlagAccessorsEmptyFalse() testing.TestResult {
	var m @RegMap = NewRegMap(callconv.AAPCS64())
	if m.IsFoldedImm(0) { return "empty FoldedImm must be false" }
	if m.IsFusedCmp(0) { return "empty FusedCmp must be false" }
	if m.IsTstFoldedAnd(0) { return "empty TstFoldedAnd must be false" }
	if m.IsFusableElemGep(0) { return "empty FusableGep must be false" }
	if m.IsFusableFieldGep(0) { return "empty FusableFieldGep must be false" }
	if m.IsFoldedDtorHandle(0) { return "empty FoldedDtor must be false" }
	if m.IsFoldedAway(0) { return "IsFoldedAway must be false when every set is empty" }
	return ""
}

// A set flag reads true at its id; unset ids, negative ids, and ids past the end
// read false.
func TestIsFoldedImmSetAndBounds() testing.TestResult {
	var m @RegMap = NewRegMap(callconv.AAPCS64())
	m.FoldedImm = rfFlagsWith(4, 2)
	if !m.IsFoldedImm(2) { return "a set FoldedImm id must be true" }
	if m.IsFoldedImm(1) { return "an unset id must be false" }
	if m.IsFoldedImm(0 - 1) { return "a negative id must be false" }
	if m.IsFoldedImm(100) { return "an out-of-range id must be false" }
	return ""
}

// rfFlagsWith returns an n-long flag set with only element [id] true.
func rfFlagsWith(n int, id int) @[]bool {
	var f @[]bool = make_slice(bool, n)
	f[id] = true
	return f
}

// rfFoldedAwayOnlyAt reports "" iff m.IsFoldedAway is true at id 2 and false at
// ids 1, -1, and 100 (unset, negative, out of range); `what` names the flag set.
func rfFoldedAwayOnlyAt(m @RegMap, what *[]readonly char) testing.TestResult {
	if !m.IsFoldedAway(2) { return buf.Concat("IsFoldedAway must be true at a set id: ", what) }
	if m.IsFoldedAway(1) { return buf.Concat("IsFoldedAway must be false at an unset id: ", what) }
	if m.IsFoldedAway(0 - 1) { return buf.Concat("IsFoldedAway must be false at id -1: ", what) }
	if m.IsFoldedAway(100) { return buf.Concat("IsFoldedAway must be false out of range: ", what) }
	return ""
}

// Each constituent fold set, on its own, makes IsFoldedAway true at its flagged
// id and nowhere else.
func TestIsFoldedAwayEachFlag() testing.TestResult {
	var r testing.TestResult
	var m1 @RegMap = NewRegMap(callconv.AAPCS64())
	m1.FoldedImm = rfFlagsWith(4, 2)
	r = rfFoldedAwayOnlyAt(m1, "FoldedImm")
	if len(r) != 0 { return r }
	var m2 @RegMap = NewRegMap(callconv.AAPCS64())
	m2.FusedCmp = rfFlagsWith(4, 2)
	r = rfFoldedAwayOnlyAt(m2, "FusedCmp")
	if len(r) != 0 { return r }
	var m3 @RegMap = NewRegMap(callconv.AAPCS64())
	m3.TstFoldedAnd = rfFlagsWith(4, 2)
	r = rfFoldedAwayOnlyAt(m3, "TstFoldedAnd")
	if len(r) != 0 { return r }
	var m4 @RegMap = NewRegMap(callconv.AAPCS64())
	m4.FusableGep = rfFlagsWith(4, 2)
	r = rfFoldedAwayOnlyAt(m4, "FusableGep")
	if len(r) != 0 { return r }
	var m5 @RegMap = NewRegMap(callconv.AAPCS64())
	m5.FusableFieldGep = rfFlagsWith(4, 2)
	r = rfFoldedAwayOnlyAt(m5, "FusableFieldGep")
	if len(r) != 0 { return r }
	var m6 @RegMap = NewRegMap(callconv.AAPCS64())
	m6.FoldedDtor = rfFlagsWith(4, 2)
	return rfFoldedAwayOnlyAt(m6, "FoldedDtor")
}

// UnionFusable short-circuits when one operand is empty (returning the other) and
// ORs element-wise when both are non-empty.
func TestUnionFusable() testing.TestResult {
	var a @[]bool = make_slice(bool, 3)
	a[0] = true
	var b @[]bool = make_slice(bool, 3)
	b[2] = true
	var empty @[]bool = make_slice(bool, 0)
	if len(UnionFusable(empty, a)) != 3 { return "empty ∪ a must return a" }
	if len(UnionFusable(a, empty)) != 3 { return "a ∪ empty must return a" }
	var u @[]bool = UnionFusable(a, b)
	if !u[0] || !u[2] || u[1] { return "a ∪ b must be the element-wise OR" }
	return ""
}
