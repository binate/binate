package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"

// Fusion-awareness hooks for the register-allocator liveness/interval scans
// (regalloc_liveness.bn / regalloc_interval.bn).  A folded element GEP (see
// common_elem_gep_fuse.bn, flagged on LivenessInfo.Fusable) is elided at emit
// and its consuming load/store rederives the address from the GEP's base+index
// — so, for liveness, the GEP defines nothing and its base+index are used at the
// LOAD/STORE, not at the GEP.  Every operand-use scan routes through
// fusedGepBaseIdx to apply that redirect; every def scan through defIdOf, which
// drops a folded GEP via isFusedGepDef.  All are no-ops when Fusable is empty.

// fusedGepBaseIdx: if operand `arg` at position `ai` of `ins` is the folded
// address of a fusable-element load/store, returns the GEP's base and index
// operands (used in place of the never-materialized GEP result), else
// (nil, nil).
func fusedGepBaseIdx(lv @LivenessInfo, ins @ir.Instr, ai int,
		arg @ir.Instr) (@ir.Instr, @ir.Instr) {
	var noBase @ir.Instr
	var noIdx @ir.Instr
	if ai != 0 {
		return noBase, noIdx
	}
	if ins.Op != iropcode.OP_LOAD && ins.Op != iropcode.OP_STORE {
		return noBase, noIdx
	}
	if arg == nil || arg.Op != iropcode.OP_GET_ELEM_PTR || len(arg.Args) < 2 {
		return noBase, noIdx
	}
	if arg.ID < 0 || arg.ID >= len(lv.Fusable) || !lv.Fusable[arg.ID] {
		return noBase, noIdx
	}
	return arg.Args[0], arg.Args[1]
}

// isFusedGepDef reports whether ins is a folded (fusable) OP_GET_ELEM_PTR — one
// whose result is never materialized, so it defines nothing.
func isFusedGepDef(lv @LivenessInfo, ins @ir.Instr) bool {
	return ins.Op == iropcode.OP_GET_ELEM_PTR && ins.ID >= 0 && ins.ID < len(lv.Fusable) &&
			lv.Fusable[ins.ID]
}

// markUpwardUse records `arg` as an upward-exposed use in computeBlockDefUse (an
// allocatable id used before it is defined in the block).
func markUpwardUse(lv @LivenessInfo, definedSoFar @[]bool, upwardUse @[]bool, arg @ir.Instr) {
	var u int = useIdOf(lv, arg)
	if u >= 0 && !definedSoFar[u] {
		upwardUse[u] = true
	}
}

// markLiveUse marks `arg`'s allocatable id live in a live-before set.
func markLiveUse(lv @LivenessInfo, s @[]bool, arg @ir.Instr) {
	var u int = useIdOf(lv, arg)
	if u >= 0 {
		s[u] = true
	}
}
