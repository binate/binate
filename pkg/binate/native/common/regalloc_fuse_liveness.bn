package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"

// Fusion-awareness hooks for the register-allocator liveness/interval scans
// (regalloc_liveness.bn / regalloc_interval.bn).  A folded GEP — an element GEP
// (common_elem_gep_fuse.bn) or a field GEP (common_field_gep_fuse.bn), unioned
// onto LivenessInfo.Fusable — is elided at emit and its consuming load/store
// rederives the address from the GEP's operands, so, for liveness, the GEP
// defines nothing and its operand(s) are used at the LOAD/STORE, not at the GEP.
// An element GEP contributes base+index; a field GEP contributes base only.
// Every operand-use scan routes through fusedGepBaseIdx to apply that redirect;
// every def scan through defIdOf, which drops a folded GEP via isFusedGepDef.
// All are no-ops when Fusable is empty.

// fusedGepBaseIdx: if operand `arg` at position `ai` of `ins` is the folded
// address of a fusable load/store, returns the operands used in place of the
// never-materialized GEP result — (base, index) for an element GEP, (base, nil)
// for a field GEP (which has no index) — else (nil, nil).  A nil index is a
// safe no-op in every caller (useIdOf(nil) is -1).
func fusedGepBaseIdx(lv @LivenessInfo, ins @ir.Instr, ai int,
		arg @ir.Instr) (@ir.Instr, @ir.Instr) {
	var noBase @ir.Instr
	var noIdx @ir.Instr
	if ai != 0 {
		return noBase, noIdx
	}
	if ins.Op != iropcode.OP_LOAD && ins.Op != iropcode.OP_STORE {
		return noBase, noIdx
	}
	if arg == nil || arg.ID < 0 || arg.ID >= len(lv.Fusable) || !lv.Fusable[arg.ID] {
		return noBase, noIdx
	}
	if arg.Op == iropcode.OP_GET_ELEM_PTR && len(arg.Args) >= 2 {
		return arg.Args[0], arg.Args[1]
	}
	if arg.Op == iropcode.OP_GET_FIELD_PTR && len(arg.Args) >= 1 {
		return arg.Args[0], noIdx
	}
	return noBase, noIdx
}

// isFusedGepDef reports whether ins is a folded (fusable) element or field GEP —
// one whose result is never materialized, so it defines nothing.
func isFusedGepDef(lv @LivenessInfo, ins @ir.Instr) bool {
	if ins.ID < 0 || ins.ID >= len(lv.Fusable) || !lv.Fusable[ins.ID] {
		return false
	}
	return ins.Op == iropcode.OP_GET_ELEM_PTR || ins.Op == iropcode.OP_GET_FIELD_PTR
}

// markUpwardUse records `arg` as an upward-exposed use in computeBlockDefUse (an
// allocatable id used before it is defined in the block).
func markUpwardUse(lv @LivenessInfo, definedSoFar @[]bool, upwardUse @[]bool, arg @ir.Instr) {
	var u int = useIdOf(lv, arg)
	if u >= 0 && !definedSoFar[u] {
		upwardUse[u] = true
	}
}

// markLiveUse marks `arg`'s allocatable id live in a live-before set.
func markLiveUse(lv @LivenessInfo, s @[]bool, arg @ir.Instr) {
	var u int = useIdOf(lv, arg)
	if u >= 0 {
		s[u] = true
	}
}
