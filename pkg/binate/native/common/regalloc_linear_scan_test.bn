package "pkg/binate/native/common"

import "pkg/builtins/testing"

// LinearScan on synthetic intervals (helpers in regalloc_scan_test.bn and
// regalloc_coalesce_test.bn): distinct registers for overlapping values,
// spilling and eviction under pressure, the clobber rule, and register sharing
// across holes and at ties.

// Three mutually-overlapping intervals with three registers: all get a
// distinct register, none spills.
func TestScanDistinctRegistersForOverlap() testing.TestResult {
	var a @LiveInterval = mkInterval(1, 0, 10)
	var b @LiveInterval = mkInterval(2, 2, 8)
	var c @LiveInterval = mkInterval(3, 4, 6)
	var ivs @[]@LiveInterval = ivList3(a, b, c)
	var asg @[]RegAssignment = LinearScan(ivs, noClobbers(), mkDesc(mkRegs(3, 100), noClobbers()),
			noCounts(), noTies())
	if AssignedReg(asg, 1) < 0 || AssignedReg(asg, 2) < 0 || AssignedReg(asg, 3) < 0 {
		return "three overlapping intervals with three registers should all get one"
	}
	return checkNoOverlapSharing(ivs, asg)
}

// More simultaneously-live intervals than registers: the excess spills, but
// the assigned ones stay distinct.
func TestScanSpillsUnderPressure() testing.TestResult {
	var a @LiveInterval = mkInterval(1, 0, 10)
	var b @LiveInterval = mkInterval(2, 2, 8)
	var c @LiveInterval = mkInterval(3, 4, 6)
	var ivs @[]@LiveInterval = ivList3(a, b, c)
	var asg @[]RegAssignment = LinearScan(ivs, noClobbers(), mkDesc(mkRegs(2, 100), noClobbers()),
			noCounts(), noTies())
	var spilled int = 0
	for i := 0; i < len(asg); i++ {
		if asg[i].Reg < 0 { spilled = spilled + 1 }
	}
	if spilled != 1 { return "with two registers and three overlapping intervals, exactly one spills" }
	return checkNoOverlapSharing(ivs, asg)
}

// A non-overlapping successor reuses the freed register (expiry).
func TestScanReusesExpiredRegister() testing.TestResult {
	var a @LiveInterval = mkInterval(1, 0, 4)
	var b @LiveInterval = mkInterval(2, 6, 10)
	var ivs @[]@LiveInterval = ivList2(a, b)
	var asg @[]RegAssignment = LinearScan(ivs, noClobbers(), mkDesc(mkRegs(1, 100), noClobbers()),
			noCounts(), noTies())
	if AssignedReg(asg, 1) != 100 || AssignedReg(asg, 2) != 100 {
		return "a non-overlapping successor should reuse the one register"
	}
	return ""
}

// A value live across a clobber cannot use a caller-saved register; with no
// callee-saved pool it must spill.  A value born after the clobber gets a
// register.
func TestScanClobberSpanSpillsWithoutCalleeSaved() testing.TestResult {
	var across @LiveInterval = mkInterval(1, 0, 10) // spans the clobber at 5
	var after @LiveInterval = mkInterval(2, 6, 9) // born after the clobber
	var ivs @[]@LiveInterval = ivList2(across, after)
	var clob @[]int = make_slice(int, 1)
	clob[0] = 5
	var asg @[]RegAssignment = LinearScan(ivs, clob, mkDesc(mkRegs(3, 100), noClobbers()), noCounts(),
			noTies())
	if AssignedReg(asg, 1) >= 0 {
		return "a value live across a clobber must not hold a caller-saved register"
	}
	if AssignedReg(asg, 2) < 0 {
		return "a value born after the clobber may use a caller-saved register"
	}
	return ""
}

// With a callee-saved pool, a clobber-spanning value takes a callee-saved
// register (which the prologue preserves across the call), not a caller-saved
// one.
func TestScanClobberSpanUsesCalleeSaved() testing.TestResult {
	var across @LiveInterval = mkInterval(1, 0, 10)
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 1)
	ivs[0] = across
	var clob @[]int = make_slice(int, 1)
	clob[0] = 5
	var asg @[]RegAssignment = LinearScan(ivs, clob, mkDesc(mkRegs(2, 100), mkRegs(2, 200)),
			noCounts(), noTies())
	var r int = AssignedReg(asg, 1)
	if r < 200 || r > 201 {
		return "a clobber-spanning value must take a callee-saved register (200/201), not a caller-saved "
				"one"
	}
	return ""
}

// Spill-cost eviction: a HOT interval that arrives with the register pool full
// of COLDER actives evicts the cheapest one (spilling it) and takes its
// register — where the plain scan would have spilled the newcomer.  id1/id2 are
// cold (count 1), id3 is hot (count 5); with two registers, id3 must land in a
// register and a cold interval must be the one spilled.
func TestScanEvictsColderForHotNewcomer() testing.TestResult {
	var a @LiveInterval = mkInterval(1, 0, 10) // cold, gets a reg first
	var b @LiveInterval = mkInterval(2, 1, 10) // cold, gets the other reg
	var c @LiveInterval = mkInterval(3, 2, 10) // hot, arrives with the pool full
	var ivs @[]@LiveInterval = ivList3(a, b, c)
	var asg @[]RegAssignment = LinearScan(ivs, noClobbers(), mkDesc(mkRegs(2, 100), noClobbers()),
			mkCounts3(1, 1, 5), noTies())
	if AssignedReg(asg, 3) < 0 {
		return "the hot newcomer must evict a colder active and take its register"
	}
	var spilled int = 0
	for i := 0; i < len(asg); i++ {
		if asg[i].Reg < 0 { spilled = spilled + 1 }
	}
	if spilled != 1 { return "exactly one (colder) interval must spill" }
	return checkNoOverlapSharing(ivs, asg)
}

// Equal costs never evict: even with a non-empty (uniform) spillCosts, the
// newcomer under pressure spills — the baseline the pressure test pins, now
// asserted explicitly against the eviction path (the hot-newcomer test's
// converse).
func TestScanEqualCostSpillsNewcomer() testing.TestResult {
	var a @LiveInterval = mkInterval(1, 0, 10)
	var b @LiveInterval = mkInterval(2, 1, 10)
	var c @LiveInterval = mkInterval(3, 2, 10) // newcomer under pressure
	var ivs @[]@LiveInterval = ivList3(a, b, c)
	var asg @[]RegAssignment = LinearScan(ivs, noClobbers(), mkDesc(mkRegs(2, 100), noClobbers()),
			mkCounts3(3, 3, 3), noTies())
	if AssignedReg(asg, 3) >= 0 {
		return "with equal costs the newcomer must spill (no eviction), not displace an active"
	}
	if AssignedReg(asg, 1) < 0 || AssignedReg(asg, 2) < 0 {
		return "the two earlier intervals must keep their registers"
	}
	return checkNoOverlapSharing(ivs, asg)
}

// Eviction respects the callee-saved constraint: a hot CLOBBER-SPANNING newcomer
// needs a callee-saved register, so it evicts the cold callee-saved holder — NOT
// the free caller-saved register (which it cannot use across the call).  callee
// pool = 1 reg (held by the cold spanning id1), caller pool = 1 free reg.
func TestScanEvictionRespectsCalleeSavedForSpanning() testing.TestResult {
	var cold @LiveInterval = mkInterval(1, 0, 10) // spanning, cold, takes callee 200
	var hot @LiveInterval = mkInterval(2, 1, 10) // spanning, hot, arrives with callee full
	var ivs @[]@LiveInterval = ivList2(cold, hot)
	var clob @[]int = make_slice(int, 1)
	clob[0] = 5
	var asg @[]RegAssignment = LinearScan(ivs, clob, mkDesc(mkRegs(1, 100), mkRegs(1, 200)),
			mkCounts3(1, 5, 0), noTies())
	if AssignedReg(asg, 2) != 200 {
		return "the hot spanning newcomer must evict the cold callee-saved holder and take 200, "
				"not the free caller-saved 100 (which it cannot use across the call)"
	}
	if AssignedReg(asg, 1) >= 0 {
		return "the evicted cold spanning interval must spill"
	}
	return ""
}

// The latch shape with one register: the phi takes it, and the new value takes
// it too through the copy hint (the phi is dead between its last use and the
// copy), so the latch copy is `mov r, r`.  Without the copy the new value
// overlaps the phi's second range and must spill.
func TestScanCoalescesLatchCopy() testing.TestResult {
	var p @LiveInterval = mkHoled(1, 0, 5, 8, 10)
	var m @LiveInterval = mkInterval(2, 5, 9)
	var ivs @[]@LiveInterval = ivList2(p, m)
	var desc RegClassDesc = mkDesc(mkRegs(1, 100), noClobbers())
	var ties @[]TiePoint = mkCopies1(8, 1, 2)
	var asg @[]RegAssignment = LinearScan(ivs, noClobbers(), desc, noCounts(), ties)
	if AssignedReg(asg, 1) != 100 || AssignedReg(asg, 2) != 100 {
		return "the phi and its latch value should share the one register"
	}
	var bare @[]RegAssignment = LinearScan(ivs, noClobbers(), desc, noCounts(), noTies())
	if AssignedReg(bare, 2) >= 0 { return "without the copy the latch value must spill" }
	return checkNoRangeConflict(ivs, asg, ties)
}

// The hint wins over a free register: with two registers free, the latch value
// still takes the phi's.
func TestScanPrefersCopyPartner() testing.TestResult {
	var p @LiveInterval = mkHoled(1, 0, 5, 8, 10)
	var m @LiveInterval = mkInterval(2, 5, 9)
	var ivs @[]@LiveInterval = ivList2(p, m)
	var asg @[]RegAssignment = LinearScan(ivs, noClobbers(), mkDesc(mkRegs(2, 100), noClobbers()),
			noCounts(), mkCopies1(8, 1, 2))
	if AssignedReg(asg, 1) < 0 || AssignedReg(asg, 1) != AssignedReg(asg, 2) {
		return "the latch value should take the phi's register over a free one"
	}
	return ""
}

// A value that fits in an active interval's hole takes its register when no
// register is free.
func TestScanReusesHole() testing.TestResult {
	var p @LiveInterval = mkHoled(1, 0, 4, 8, 10)
	var t @LiveInterval = mkInterval(2, 5, 7)
	var ivs @[]@LiveInterval = ivList2(p, t)
	var asg @[]RegAssignment = LinearScan(ivs, noClobbers(), mkDesc(mkRegs(1, 100), noClobbers()),
			noCounts(), noTies())
	if AssignedReg(asg, 1) != 100 || AssignedReg(asg, 2) != 100 {
		return "a value in the hole should reuse the holder's register"
	}
	return ""
}

// A shared register returns to the pool only when its LAST holder expires: after
// the hole value t expires, p still holds the register, so u (which overlaps
// p's second range) must not get it.
func TestScanSharedRegisterStaysHeld() testing.TestResult {
	var p @LiveInterval = mkHoled(1, 0, 4, 8, 20)
	var t @LiveInterval = mkInterval(2, 5, 7)
	var u @LiveInterval = mkInterval(3, 7, 9)
	var ivs @[]@LiveInterval = ivList3(p, t, u)
	var asg @[]RegAssignment = LinearScan(ivs, noClobbers(), mkDesc(mkRegs(1, 100), noClobbers()),
			noCounts(), noTies())
	if AssignedReg(asg, 2) != 100 { return "t should share p's register" }
	if AssignedReg(asg, 3) >= 0 { return "u overlaps p and must not get the register" }
	return checkNoRangeConflict(ivs, asg, noTies())
}

// Evicting a shared register spills every holder, so it is priced at their
// summed cost: q and h (cost 1 each) share the one register, and v (cost 5)
// evicts both; at cost 3 each (summing to 6) v spills instead, even though
// either holder alone would be cheaper than v.
func TestScanEvictsSharedRegisterAsGroup() testing.TestResult {
	var q @LiveInterval = mkHoled(1, 0, 4, 8, 20)
	var h @LiveInterval = mkInterval(2, 5, 7)
	var v @LiveInterval = mkInterval(3, 6, 7)
	var ivs @[]@LiveInterval = ivList3(q, h, v)
	var desc RegClassDesc = mkDesc(mkRegs(1, 100), noClobbers())
	var cheap @[]RegAssignment = LinearScan(ivs, noClobbers(), desc, mkCounts3(1, 1, 5), noTies())
	if AssignedReg(cheap, 3) != 100 { return "v should evict the cheaper pair" }
	if AssignedReg(cheap, 1) >= 0 || AssignedReg(cheap, 2) >= 0 {
		return "evicting a shared register must spill every holder"
	}
	var dear @[]RegAssignment = LinearScan(ivs, noClobbers(), desc, mkCounts3(3, 3, 5), noTies())
	if AssignedReg(dear, 1) != 100 || AssignedReg(dear, 2) != 100 {
		return "q and h should share the register"
	}
	if AssignedReg(dear, 3) >= 0 { return "v must spill: the pair costs more than v" }
	return checkNoRangeConflict(ivs, dear, noTies())
}

// A clobber-spanning value may not take a caller-saved partner register: the
// phi sits in a caller-saved register, the latch value lives across a call.
func TestScanPartnerRespectsClobber() testing.TestResult {
	var p @LiveInterval = mkHoled(1, 0, 5, 8, 10)
	var m @LiveInterval = mkInterval(2, 5, 9)
	var ivs @[]@LiveInterval = ivList2(p, m)
	var clob @[]int = make_slice(int, 1)
	clob[0] = 6
	var asg @[]RegAssignment = LinearScan(ivs, clob, mkDesc(mkRegs(1, 100), mkRegs(1, 200)),
			noCounts(), mkCopies1(8, 1, 2))
	if AssignedReg(asg, 1) != 100 { return "the phi (no span) should take the caller-saved reg" }
	if AssignedReg(asg, 2) != 200 {
		return "the spanning latch value must take the callee-saved reg, not the partner's"
	}
	return ""
}
