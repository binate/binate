package "pkg/binate/native/common"

import "pkg/binate/ir"

// LiveCFG is the part of a function's liveness analysis that no register class changes:
// its blocks' successors, which blocks the entry reaches, their reverse postorder and
// the linear positions of their instructions.  Each liveness pass of a function -- the
// GP and FP allocators', PlanFrame's over aggregate values, the lazy-spill cursor's --
// and the alloca sharing take it from the function's RegMap (liveCFGOf), which builds it
// once.  The passes only read it, and nothing between the first and the last of them
// changes f; liveCFGOf panics on a change to its blocks' lengths, as the homes and slots
// already planned would describe another function.
type LiveCFG struct {
	// f is the function the CFG was built for, and lens[b] the number of instructions
	// its block b had then (describes).
	f    @ir.Func
	lens @[]int
	// succs[b] lists block b's successors (buildSuccs).
	succs @[]@[]int
	// reachable, rpo, blockFrom, blockTo and numPos are LivenessInfo's Reachable, RPO,
	// BlockFrom, BlockTo and NumPos.
	reachable @[]bool
	rpo       @[]int
	blockFrom @[]int
	blockTo   @[]int
	numPos    int
}

// liveCFGBuilds counts the LiveCFGs built, so a test can see a function's passes share
// one.
var liveCFGBuilds int

// newLiveCFG builds f's LiveCFG.
func newLiveCFG(f @ir.Func) @LiveCFG {
	liveCFGBuilds++
	var c @LiveCFG = make(LiveCFG)
	var n int = len(f.Blocks)
	c.f = f
	c.lens = make_slice(int, n)
	for bi := 0; bi < n; bi++ { c.lens[bi] = len(f.Blocks[bi].Instrs) }
	if n == 0 { return c }
	c.succs = buildSuccs(f)
	c.reachable, c.rpo = reachableRPO(n, c.succs)
	c.blockFrom = make_slice(int, n)
	c.blockTo = make_slice(int, n)
	for i := 0; i < n; i++ {
		c.blockFrom[i] = -1
		c.blockTo[i] = -1
	}
	var pos int = 0
	for k := 0; k < len(c.rpo); k++ {
		var b int = c.rpo[k]
		c.blockFrom[b] = pos
		pos = pos + c.lens[b]
		c.blockTo[b] = pos
	}
	c.numPos = pos
	return c
}

// describes reports whether c was built for f and f's blocks still have the lengths
// they had then.  (A change that keeps every length, a retargeted branch, goes
// unseen.)
func (c @LiveCFG) describes(f @ir.Func) bool {
	if c.f != f || len(f.Blocks) != len(c.lens) { return false }
	for bi := 0; bi < len(c.lens); bi++ {
		if len(f.Blocks[bi].Instrs) != c.lens[bi] { return false }
	}
	return true
}

// liveCFGOf returns f's LiveCFG: the one m holds when it was built for f, else a new
// one, which m then holds.  It panics when the one m holds for f no longer describes it.
func (m @RegMap) liveCFGOf(f @ir.Func) @LiveCFG {
	var c @LiveCFG = m.liveCFG
	if c != nil && c.f == f {
		if !c.describes(f) {
			panic("internal error: a function changed between its native liveness passes")
		}
		return c
	}
	c = newLiveCFG(f)
	m.liveCFG = c
	return c
}
