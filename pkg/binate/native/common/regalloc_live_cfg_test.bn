package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for regalloc_live_cfg.bn, and for the liveness and hulls computed over a shared
// LiveCFG.  spreadFunc, oneInstr, makeNoParams / makeNoResults, setTarget64, mkDesc /
// mkRegs, regionFunc / mkQuad / readField and elisionNoRets are shared test helpers.

// loopFunc builds a loop: the entry defines a and b, the header adds them and branches
// to the body or the exit, the body adds a to the sum and jumps back, and the exit
// returns the sum -- so a is live around the back edge.
func loopFunc() @ir.Func {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var hdr @ir.Block = ir.AddBlock(f, "hdr")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var a @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	var b @ir.Instr = irbuild.EmitConstInt(entry, 2, types.TypInt())
	irbuild.EmitJump(entry, hdr)
	var sum @ir.Instr = irbuild.EmitBinop(hdr, iropcode.OP_ADD, a, b, types.TypInt())
	irbuild.EmitBranch(hdr, irbuild.EmitConstBool(hdr, true), body, exit)
	irbuild.EmitBinop(body, iropcode.OP_ADD, sum, a, types.TypInt())
	irbuild.EmitJump(body, hdr)
	irbuild.EmitReturn(exit, oneInstr(sum))
	return f
}

// A RegMap hands the same LiveCFG to each ask about one function, and another function
// gets its own.  A LiveCFG no longer describes its function once an instruction is added
// to a block, or one moves from a block to another (the total unchanged).
func TestLiveCFGBuiltOncePerFunction() testing.TestResult {
	setTarget64()
	var rm @RegMap = NewRegMap(callconv.AAPCS64())
	var f @ir.Func = loopFunc()
	var c @LiveCFG = rm.liveCFGOf(f)
	if rm.liveCFGOf(f) != c || !c.describes(f) { return "the same function gets the same LiveCFG" }
	g, _ := spreadFunc()
	if rm.liveCFGOf(g) == c || c.describes(g) { return "another function gets its own LiveCFG" }
	irbuild.EmitConstInt(f.Blocks[1], 3, types.TypInt())
	if c.describes(f) { return "an instruction added to a block" }
	f = loopFunc()
	c = newLiveCFG(f)
	var last @ir.Block = f.Blocks[3]
	last.Instrs = last.Instrs[0:len(last.Instrs) - 1]
	irbuild.EmitConstInt(f.Blocks[1], 3, types.TypInt())
	if c.describes(f) { return "an instruction moved between blocks" }
	return ""
}

// mixedFunc builds a function with values of each class -- integers, floats and Quad call
// results -- live across a block boundary.
func mixedFunc() @ir.Func {
	f, e := regionFunc()
	var next @ir.Block = ir.AddBlock(f, "next")
	var i @ir.Instr = irbuild.EmitConstInt(e, 1, types.TypInt())
	var x @ir.Instr = irbuild.EmitConstFloat(e, "1.5", types.TypFloat64())
	var a @ir.Instr = mkQuad(e)
	irbuild.EmitJump(e, next)
	irbuild.EmitBinop(next, iropcode.OP_ADD, i, i, types.TypInt())
	irbuild.EmitBinop(next, iropcode.OP_ADD, x, x, types.TypFloat64())
	readField(next, a)
	readField(next, mkQuad(next))
	irbuild.EmitReturn(next, elisionNoRets())
	return f
}

// A function's passes -- the GP and FP allocators, PlanFrame (the region spans and the
// alloca sharing) and the lazy-spill cursor -- build one LiveCFG between them.
func TestLiveCFGSharedByPasses() testing.TestResult {
	setTarget64()
	var f @ir.Func = mixedFunc()
	var rm @RegMap = NewRegMap(callconv.AAPCS64())
	var before int = liveCFGBuilds
	rm.AllocateRegisters(f, 8, mkDesc(mkRegs(4, 100), mkRegs(4, 200)), false)
	rm.AllocateFpRegisters(f, 8, mkDesc(mkRegs(2, 300), mkRegs(2, 400)))
	rm.PlanFrame(f)
	var none @[]bool
	rm.NewLiveCursor(f, 8, none)
	if liveCFGBuilds - before != 1 { return "the passes over one function build one LiveCFG" }
	return ""
}

// intervalsMismatch returns a description of the first difference between two
// interval lists, or "".
func intervalsMismatch(a @[]@LiveInterval, b @[]@LiveInterval) @[]char {
	if len(a) != len(b) { return "the interval counts differ" }
	for i := 0; i < len(a); i++ {
		if a[i].ID != b[i].ID || a[i].DefPos != b[i].DefPos || len(a[i].Ranges) != len(b[i].Ranges) {
			return "an interval's id, definition or range count differs"
		}
		for r := 0; r < len(a[i].Ranges); r++ {
			if a[i].Ranges[r].Start != b[i].Ranges[r].Start || a[i].Ranges[r].End != b[i].Ranges[r].End {
				return "an interval's range differs"
			}
		}
	}
	return ""
}

// Liveness over a LiveCFG the other classes' passes used too is the liveness the
// function's own build gives, for each class.
func TestLivenessOnSharedCFG() testing.TestResult {
	setTarget64()
	var none @[]bool
	var f @ir.Func = mixedFunc()
	var cfg @LiveCFG = newLiveCFG(f)
	var classes @[]int = make_slice(int, 3)
	classes[0] = REGCLASS_GP
	classes[1] = REGCLASS_FP
	classes[2] = REGCLASS_AGG
	for k := 0; k < len(classes); k++ {
		var shared @[]@LiveInterval = BuildIntervals(f, computeLivenessOn(f, cfg, 8, none, classes[k]))
		var own @[]@LiveInterval = BuildIntervals(f, computeLivenessImpl(f, 8, none, classes[k]))
		if len(own) == 0 { return "each class has intervals in the function" }
		var bad @[]char = intervalsMismatch(shared, own)
		if len(bad) > 0 { return bad }
	}
	var g @ir.Func = loopFunc()
	cfg = newLiveCFG(g)
	return intervalsMismatch(BuildIntervals(g, computeLivenessOn(g, cfg, 8, none, REGCLASS_GP)),
			BuildIntervals(g, ComputeLiveness(g, 8)))
}

// hullsMismatch returns a description of the first id whose hull (buildHulls) is not its
// interval's start and end (BuildIntervals), or "".
func hullsMismatch(f @ir.Func, lv @LivenessInfo) @[]char {
	los, his := buildHulls(f, lv)
	var ivs @[]@LiveInterval = BuildIntervals(f, lv)
	var seen @[]bool = make_slice(bool, lv.NextID)
	for i := 0; i < len(ivs); i++ {
		var id int = ivs[i].ID
		seen[id] = true
		if los[id] != ivs[i].Start() || his[id] != ivs[i].End() {
			return "a hull is not its interval's span"
		}
	}
	for id := 0; id < lv.NextID; id++ {
		if !seen[id] && (los[id] != -1 || his[id] != -1) { return "an id with no interval has a hull" }
	}
	return ""
}

// buildHulls gives each id its interval's start and end, and -1 to an id with none:
// around a loop, and across blocks with many values live at their boundaries.
func TestBuildHullsMatchIntervals() testing.TestResult {
	setTarget64()
	var f @ir.Func = loopFunc()
	var bad @[]char = hullsMismatch(f, ComputeLiveness(f, 8))
	if len(bad) > 0 { return bad }
	g, _ := spreadFunc()
	return hullsMismatch(g, ComputeLiveness(g, 8))
}
