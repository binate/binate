package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/iropt"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for LiveCursor: at every point of every block it must report what the
// per-instruction definition gives — live-after the last instruction is the
// block's live-out, and live-before an instruction is its live-after minus its
// def plus its allocatable uses (refLiveAt computes exactly that, a full set per
// point) — including while the sets for two adjacent points are held at once.

// refLiveAt returns block bi's live set at each point (refLiveAt(…)[ii] before
// instruction ii; [len(Instrs)] its live-out), one full id-indexed set per point.
func refLiveAt(lv @LivenessInfo, f @ir.Func, bi int) @[]@[]bool {
	var b @ir.Block = f.Blocks[bi]
	var n int = len(b.Instrs)
	var sets @[]@[]bool = make_slice(@[]bool, n + 1)
	sets[n] = make_slice(bool, lv.NextID)
	for id := 0; id < lv.NextID; id++ { sets[n][id] = lv.LiveOut[bi][id] }
	for ii := n - 1; ii >= 0; ii-- {
		var ins @ir.Instr = b.Instrs[ii]
		var s @[]bool = make_slice(bool, lv.NextID)
		for id := 0; id < lv.NextID; id++ { s[id] = sets[ii + 1][id] }
		var d int = defIdOf(lv, ins, lv.WordBytes)
		if d >= 0 { s[d] = false }
		for ai := 0; ai < len(ins.Args); ai++ {
			base, idx := fusedGepBaseIdx(lv, ins, ai, ins.Args[ai])
			if base != nil {
				markLiveUse(lv, s, base)
				markLiveUse(lv, s, idx)
			} else {
				markLiveUse(lv, s, ins.Args[ai])
			}
		}
		sets[ii] = s
	}
	return sets
}

// markLiveUse marks arg's allocatable id live in s (refLiveAt's use step).
func markLiveUse(lv @LivenessInfo, s @[]bool, arg @ir.Instr) {
	var u int = useIdOf(lv, arg)
	if u >= 0 { s[u] = true }
}

// sameLiveSet reports whether two id-indexed sets hold the same ids.
func sameLiveSet(a @[]bool, b @[]bool) bool {
	if len(a) != len(b) { return false }
	for id := 0; id < len(a); id++ {
		if a[id] != b[id] { return false }
	}
	return true
}

// cursorMismatch walks f's blocks with a LiveCursor the way the backends' emit
// loops do — the set before an instruction, then the set after it while still
// holding the first — and returns a description of the first point where it
// disagrees with refLiveAt, or "".
func cursorMismatch(f @ir.Func, fusable @[]bool, wordBytes int) @[]char {
	var lv @LivenessInfo = ComputeLivenessFused(f, wordBytes, fusable)
	var c @LiveCursor = NewLiveCursor(f, wordBytes, fusable)
	for bi := 0; bi < len(f.Blocks); bi++ {
		var want @[]@[]bool = refLiveAt(lv, f, bi)
		var n int = len(f.Blocks[bi].Instrs)
		c.EnterBlock(bi)
		for ii := 0; ii < n; ii++ {
			var before @[]bool = c.LiveAt(ii)
			var after @[]bool = c.LiveAt(ii + 1)
			if !sameLiveSet(before, want[ii]) { return "the set before an instruction" }
			if !sameLiveSet(after, want[ii + 1]) { return "the set after an instruction" }
			if !sameLiveSet(c.LiveAt(ii + 1), want[ii + 1]) {
				return "the set after an instruction, requested again"
			}
		}
		if !sameLiveSet(c.LiveAt(n), want[n]) { return "the block's live-out" }
	}
	return ""
}

// A counted loop after phi elimination: the induction value's copies define one id
// in two blocks, the bound is live around the back-edge, a phi whose back-edge
// input is itself is live through the loop, and each block's entry must drop what
// the previous block left live.
func TestLiveCursorLoop() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "loop", makeNoParams(), makeNoResults())
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var post @ir.Block = ir.AddBlock(f, "post")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var bound @ir.Instr = irbuild.EmitConstInt(pre, 10, types.TypInt())
	var initV @ir.Instr = irbuild.EmitConstInt(pre, 0, types.TypInt())
	irbuild.EmitJump(pre, header)
	var phi @ir.Instr = irbuild.EmitPhi(header, types.TypInt(), twoPE(pre, initV, pre, initV))
	var fixed @ir.Instr = irbuild.EmitPhi(header, types.TypInt(), twoPE(pre, bound, pre, bound))
	var cond @ir.Instr = irbuild.EmitBinop(header, iropcode.OP_LT, phi, bound, types.TypBool())
	irbuild.EmitBranch(header, cond, body, exit)
	irbuild.EmitJump(body, post)
	var one @ir.Instr = irbuild.EmitConstInt(post, 1, types.TypInt())
	var step @ir.Instr = irbuild.EmitBinop(post, iropcode.OP_ADD, phi, one, types.TypInt())
	irbuild.EmitJump(post, header)
	phi.Phis = twoPE(pre, initV, post, step)
	fixed.Phis = twoPE(pre, bound, post, fixed)
	var res @ir.Instr = irbuild.EmitBinop(exit, iropcode.OP_ADD, phi, fixed, types.TypInt())
	irbuild.EmitReturn(exit, oneInstr(res))
	iropt.EliminatePhis(f)
	var noFuse @[]bool
	var bad @[]char = cursorMismatch(f, noFuse, 8)
	if len(bad) > 0 { return bad }
	return ""
}

// Straight-line code across two blocks: a value used twice by one instruction, a
// def nothing uses, values defined and used within a block, and one used in the
// next block; plus an unreachable block reading a value from the entry.
func TestLiveCursorStraightLineAndUnreachable() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var next @ir.Block = ir.AddBlock(f, "next")
	var dead @ir.Block = ir.AddBlock(f, "dead")
	var a @ir.Instr = irbuild.EmitConstInt(entry, 3, types.TypInt())
	_ = irbuild.EmitConstInt(entry, 4, types.TypInt())
	var sq @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_MUL, a, a, types.TypInt())
	irbuild.EmitJump(entry, next)
	var s @ir.Instr = irbuild.EmitBinop(next, iropcode.OP_ADD, sq, a, types.TypInt())
	var t @ir.Instr = irbuild.EmitBinop(next, iropcode.OP_ADD, s, s, types.TypInt())
	irbuild.EmitReturn(next, oneInstr(t))
	var u @ir.Instr = irbuild.EmitBinop(dead, iropcode.OP_SUB, a, sq, types.TypInt())
	irbuild.EmitReturn(dead, oneInstr(u))
	var noFuse @[]bool
	var bad @[]char = cursorMismatch(f, noFuse, 8)
	if len(bad) > 0 { return bad }
	return ""
}

// A folded element GEP: the load that consumes it uses the GEP's base and index
// instead, and the GEP itself defines nothing.
func TestLiveCursorFusedGep() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var base @ir.Instr = regBase(b)
	var idx @ir.Instr = irbuild.EmitConstInt(b, 2, types.TypInt())
	var gep @ir.Instr = irbuild.EmitGetElemPtr(b, base, idx, types.TypInt())
	var ld @ir.Instr = irbuild.EmitLoad(b, gep, types.TypInt())
	var sum @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, ld, idx, types.TypInt())
	irbuild.EmitReturn(b, oneInstr(sum))
	var fusable @[]bool = FusableElemGeps(f, false)
	if gep.ID >= len(fusable) || !fusable[gep.ID] { return "the GEP must fold into its load" }
	var bad @[]char = cursorMismatch(f, fusable, 8)
	if len(bad) > 0 { return bad }
	return ""
}

// A folded field GEP (its load uses the GEP's base, with no index) and a block
// with no instructions (an empty, unreachable block: its live set is its empty
// live-out).
func TestLiveCursorFieldGepAndEmptyBlock() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	_ = ir.AddBlock(f, "empty")
	var st @types.Type = twoFieldStruct(types.TypInt(), types.TypInt())
	var base @ir.Instr = structBase(b, st)
	var gep @ir.Instr = irbuild.EmitGetFieldPtr(b, base, 1, types.TypInt())
	var ld @ir.Instr = irbuild.EmitLoad(b, gep, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_EQ, base, base, types.TypBool())
	irbuild.EmitReturn(b, oneInstr(ld))
	var fusable @[]bool = FusableFieldGeps(f, 8, false)
	if gep.ID >= len(fusable) || !fusable[gep.ID] { return "the field GEP must fold into its load" }
	var bad @[]char = cursorMismatch(f, fusable, 8)
	if len(bad) > 0 { return bad }
	return ""
}

// On a 32-bit target an int64 is a register pair the allocator leaves in memory, so
// it is in no live set; the int values around it still are.
func TestLiveCursor32BitTarget() testing.TestResult {
	setTarget32()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var next @ir.Block = ir.AddBlock(f, "next")
	var a @ir.Instr = irbuild.EmitConstInt(entry, 3, types.TypInt())
	var w @ir.Instr = irbuild.EmitConstInt(entry, 4, types.TypInt64())
	irbuild.EmitJump(entry, next)
	_ = irbuild.EmitBinop(next, iropcode.OP_ADD, w, w, types.TypInt64())
	var s @ir.Instr = irbuild.EmitBinop(next, iropcode.OP_ADD, a, a, types.TypInt())
	irbuild.EmitReturn(next, oneInstr(s))
	var noFuse @[]bool
	var bad @[]char = cursorMismatch(f, noFuse, 4)
	setTarget64()
	if len(bad) > 0 { return bad }
	return ""
}
