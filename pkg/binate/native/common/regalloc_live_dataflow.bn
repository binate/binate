package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/std/vec"

// The liveness dataflow behind LivenessInfo's block live sets: bitsets over the
// function's cross-block values (LivenessInfo.Globals) — the allocatable ids some
// reachable block uses before defining them, the only ids a block boundary can
// see live.  A value used only in the block that defines it never enters them, so
// their size follows the values that cross blocks, not every value in the
// function.

// LIVE_SET_BITS is the number of values per word of a live set.
const LIVE_SET_BITS int = 32

// makeLiveSets returns n empty live sets of words words each.
func makeLiveSets(n int, words int) @[]@[]uint32 {
	var sets @[]@[]uint32 = make_slice(@[]uint32, n)
	for i := 0; i < n; i++ { sets[i] = make_slice(uint32, words) }
	return sets
}

// addLiveBit adds the value with Globals index gi to s.
func addLiveBit(s @[]uint32, gi int) {
	var w int = gi / LIVE_SET_BITS
	s[w] = s[w] | (cast(uint32, 1) << cast(uint32, gi % LIVE_SET_BITS))
}

// clearLiveBit removes the value with Globals index gi from s.
func clearLiveBit(s @[]uint32, gi int) {
	var w int = gi / LIVE_SET_BITS
	s[w] = s[w] & ~(cast(uint32, 1) << cast(uint32, gi % LIVE_SET_BITS))
}

// hasLiveBit reports whether s holds the value with Globals index gi.
func hasLiveBit(s @[]uint32, gi int) bool {
	var w uint32 = s[gi / LIVE_SET_BITS] >> cast(uint32, gi % LIVE_SET_BITS)
	return (w & cast(uint32, 1)) != cast(uint32, 0)
}

// IsLiveIn reports whether id is live on entry to block b.
func (lv @LivenessInfo) IsLiveIn(b int, id int) bool { return lv.liveSetHas(lv.liveIn, b, id) }

// IsLiveOut reports whether id is live on exit from block b.
func (lv @LivenessInfo) IsLiveOut(b int, id int) bool { return lv.liveSetHas(lv.liveOut, b, id) }

// LiveInIDs returns the ids live on entry to block b, in Globals order.
func (lv @LivenessInfo) LiveInIDs(b int) @[]int { return lv.liveSetIDs(lv.liveIn, b) }

// LiveOutIDs returns the ids live on exit from block b, in Globals order.
func (lv @LivenessInfo) LiveOutIDs(b int) @[]int { return lv.liveSetIDs(lv.liveOut, b) }

// liveSetHas reports whether block b's set in sets holds id.
func (lv @LivenessInfo) liveSetHas(sets @[]@[]uint32, b int, id int) bool {
	if id < 0 || id >= len(lv.GlobalIndex) || b < 0 || b >= len(sets) { return false }
	var gi int = lv.GlobalIndex[id]
	return gi >= 0 && hasLiveBit(sets[b], gi)
}

// liveSetIDs returns the ids block b's set in sets holds, in Globals order.
func (lv @LivenessInfo) liveSetIDs(sets @[]@[]uint32, b int) @[]int {
	var ids @vec.Vec[int] = vec.New[int]()
	if b < 0 || b >= len(sets) { return ids.Items() }
	var s @[]uint32 = sets[b]
	for w := 0; w < len(s); w++ {
		if s[w] == cast(uint32, 0) { continue }
		for k := 0; k < LIVE_SET_BITS; k++ {
			if ((s[w] >> cast(uint32, k)) & cast(uint32, 1)) != cast(uint32, 0) {
				ids.Push(lv.Globals[w * LIVE_SET_BITS + k])
			}
		}
	}
	return ids.Items()
}

// livenessFixpoint computes the block live sets by iterating the backward
// dataflow equations to convergence:
//   LiveOut[b] = union over s in succ(b) of LiveIn[s]
//   LiveIn[b]  = upwardUse[b] ∪ (LiveOut[b] − def[b])
// where upwardUse[b] is the ids used in b before any def of them in b, and
// def[b] the ids defined in b.  Only allocatable ids participate, and of those
// only the ones upward-exposed in some block (Globals) can reach a live set, so
// the sets are bitsets over Globals.  LiveIn[b] starts as upwardUse[b] (it only
// grows), and def[b] is subtracted from LiveOut[b] through the block's def list,
// so no per-block bitsets are kept besides LiveIn and LiveOut.  Blocks are visited
// in postorder (successors before predecessors) so most updates propagate in a
// single sweep; iteration repeats until stable.
func livenessFixpoint(lv @LivenessInfo, f @ir.Func, succs @[]@[]int, wordBytes int) {
	var nr int = len(lv.RPO)
	// Each reachable block's upward-exposed uses and defs, as id lists: those of
	// block RPO[k] are ups[upLo[k]:upLo[k + 1]] and defs[defLo[k]:defLo[k + 1]].
	var ups @vec.Vec[int] = vec.New[int]()
	var defs @vec.Vec[int] = vec.New[int]()
	var upLo @[]int = make_slice(int, nr + 1)
	var defLo @[]int = make_slice(int, nr + 1)
	var marks @blockMarks = newBlockMarks(lv.NextID)
	for k := 0; k < nr; k++ {
		upLo[k] = ups.Len()
		defLo[k] = defs.Len()
		computeBlockDefUse(lv, f.Blocks[lv.RPO[k]], marks, ups, defs, wordBytes)
	}
	upLo[nr] = ups.Len()
	defLo[nr] = defs.Len()

	lv.GlobalIndex = make_slice(int, lv.NextID)
	for id := 0; id < lv.NextID; id++ { lv.GlobalIndex[id] = -1 }
	var globals @vec.Vec[int] = vec.New[int]()
	for j := 0; j < ups.Len(); j++ {
		var id int = ups.Get(j)
		if lv.GlobalIndex[id] < 0 {
			lv.GlobalIndex[id] = globals.Len()
			globals.Push(id)
		}
	}
	lv.Globals = globals.Items()
	var words int = (globals.Len() + LIVE_SET_BITS - 1) / LIVE_SET_BITS
	lv.liveIn = makeLiveSets(lv.NumBlocks, words)
	lv.liveOut = makeLiveSets(lv.NumBlocks, words)
	for k := 0; k < nr; k++ {
		var seed @[]uint32 = lv.liveIn[lv.RPO[k]]
		for j := upLo[k]; j < upLo[k + 1]; j++ { addLiveBit(seed, lv.GlobalIndex[ups.Get(j)]) }
	}
	// scratch holds LiveOut[b] − def[b] while LiveIn[b] is updated.
	var scratch @[]uint32 = make_slice(uint32, words)

	var changed bool = true
	for changed {
		changed = false
		// Postorder = RPO reversed: visit successors before predecessors.
		for k := nr - 1; k >= 0; k-- {
			var b int = lv.RPO[k]
			var liveOut @[]uint32 = lv.liveOut[b]
			// LiveOut[b] = union of successors' LiveIn.
			for si := 0; si < len(succs[b]); si++ {
				var s int = succs[b][si]
				if !lv.Reachable[s] { continue }
				var sin @[]uint32 = lv.liveIn[s]
				for w := 0; w < words; w++ {
					var nw uint32 = liveOut[w] | sin[w]
					if nw != liveOut[w] {
						liveOut[w] = nw
						changed = true
					}
				}
			}
			// LiveIn[b] = upwardUse[b] ∪ (LiveOut[b] − def[b]); upwardUse[b] is
			// already in it.
			for w := 0; w < words; w++ { scratch[w] = liveOut[w] }
			for j := defLo[k]; j < defLo[k + 1]; j++ {
				var gi int = lv.GlobalIndex[defs.Get(j)]
				if gi >= 0 { clearLiveBit(scratch, gi) }
			}
			var liveIn @[]uint32 = lv.liveIn[b]
			for w := 0; w < words; w++ {
				var nw uint32 = liveIn[w] | scratch[w]
				if nw != liveIn[w] {
					liveIn[w] = nw
					changed = true
				}
			}
		}
	}
}

// blockMarks is computeBlockDefUse's per-block scratch: defined[id] and up[id]
// equal stamp when, in the block being scanned, id has been defined so far (and
// recorded as a def) or recorded as upward-exposed.  A new stamp per block empties
// both without touching them.
type blockMarks struct {
	defined @[]int
	up      @[]int
	stamp   int
}

// newBlockMarks returns block marks for ids in [0, nid).
func newBlockMarks(nid int) @blockMarks {
	var m @blockMarks = make(blockMarks)
	m.defined = make_slice(int, nid)
	m.up = make_slice(int, nid)
	return m
}

// computeBlockDefUse appends one block's upward-exposed uses to ups and its defs
// to defs (each id once), by a forward scan: an id used before it is (re)defined
// in the block is upward-exposed (its value comes from a predecessor); an id
// defined anywhere in the block is a def.  Only allocatable ids are recorded.
func computeBlockDefUse(lv @LivenessInfo, b @ir.Block, m @blockMarks, ups @vec.Vec[int],
		defs @vec.Vec[int], wordBytes int) {
	m.stamp = m.stamp + 1
	for ii := 0; ii < len(b.Instrs); ii++ {
		var ins @ir.Instr = b.Instrs[ii]
		if ins.Op == iropcode.OP_PHI {
			// This analysis reads value operands only from ins.Args, but a phi
			// carries its inputs in ins.Phis (live on the predecessor edges,
			// not here).  iropt.EliminatePhis must run before native emission, so
			// a phi reaching here is a contract violation, not a shape to
			// silently mishandle (which would drop the phi inputs' liveness).
			panic(
					"internal error: register-allocator liveness saw an OP_PHI; "
							"iropt.EliminatePhis must run before native emission")
		}
		for ai := 0; ai < len(ins.Args); ai++ {
			base, idx := fusedGepBaseIdx(lv, ins, ai, ins.Args[ai])
			if base != nil {
				markUpwardUse(lv, m, ups, base)
				markUpwardUse(lv, m, ups, idx)
			} else {
				markUpwardUse(lv, m, ups, ins.Args[ai])
			}
		}
		var d int = defIdOf(lv, ins, wordBytes)
		if d >= 0 && m.defined[d] != m.stamp {
			m.defined[d] = m.stamp
			defs.Push(d)
		}
	}
}
