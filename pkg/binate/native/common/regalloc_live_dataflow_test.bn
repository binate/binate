package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/iropt"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the liveness dataflow (regalloc_live_dataflow.bn).  The block live sets
// range over the values that cross block boundaries, as bitsets; they must hold
// exactly what the dataflow equations give over every value, which denseLiveness
// computes the plain way — a full id-indexed set per block.

// denseLiveness returns f's live-in and live-out sets per block, iterating the
// equations LiveOut[b] = ∪ LiveIn[succ] and LiveIn[b] = upwardUse[b] ∪
// (LiveOut[b] − def[b]) over id-indexed sets, with lv's uses and defs.
func denseLiveness(lv @LivenessInfo, f @ir.Func) (@[]@[]bool, @[]@[]bool) {
	var n int = lv.NumBlocks
	var nid int = lv.NextID
	var liveIn @[]@[]bool = make_slice(@[]bool, n)
	var liveOut @[]@[]bool = make_slice(@[]bool, n)
	var use @[]@[]bool = make_slice(@[]bool, n)
	var def @[]@[]bool = make_slice(@[]bool, n)
	for b := 0; b < n; b++ {
		liveIn[b] = make_slice(bool, nid)
		liveOut[b] = make_slice(bool, nid)
		use[b] = make_slice(bool, nid)
		def[b] = make_slice(bool, nid)
	}
	for k := 0; k < len(lv.RPO); k++ {
		var b int = lv.RPO[k]
		var defined @[]bool = make_slice(bool, nid)
		var blk @ir.Block = f.Blocks[b]
		for ii := 0; ii < len(blk.Instrs); ii++ {
			var ins @ir.Instr = blk.Instrs[ii]
			for ai := 0; ai < len(ins.Args); ai++ {
				base, idx := fusedGepBaseIdx(lv, ins, ai, ins.Args[ai])
				if base != nil {
					denseUse(lv, defined, use[b], base)
					denseUse(lv, defined, use[b], idx)
				} else {
					denseUse(lv, defined, use[b], ins.Args[ai])
				}
			}
			var d int = defIdOf(lv, ins, lv.WordBytes)
			if d >= 0 {
				defined[d] = true
				def[b][d] = true
			}
		}
	}
	var succs @[]@[]int = buildSuccs(f)
	var changed bool = true
	for changed {
		changed = false
		for k := len(lv.RPO) - 1; k >= 0; k-- {
			var b int = lv.RPO[k]
			for si := 0; si < len(succs[b]); si++ {
				var s int = succs[b][si]
				if !lv.Reachable[s] { continue }
				for id := 0; id < nid; id++ {
					if liveIn[s][id] && !liveOut[b][id] {
						liveOut[b][id] = true
						changed = true
					}
				}
			}
			for id := 0; id < nid; id++ {
				if (use[b][id] || (liveOut[b][id] && !def[b][id])) && !liveIn[b][id] {
					liveIn[b][id] = true
					changed = true
				}
			}
		}
	}
	return liveIn, liveOut
}

// denseUse records arg as an upward-exposed use when it is allocatable and not yet
// defined in the block.
func denseUse(lv @LivenessInfo, defined @[]bool, use @[]bool, arg @ir.Instr) {
	var u int = useIdOf(lv, arg)
	if u >= 0 && !defined[u] { use[u] = true }
}

// liveSetsMismatch returns a description of the first block and id where lv's block
// live sets (through IsLiveIn / IsLiveOut and the id lists) disagree with
// denseLiveness, or "".
func liveSetsMismatch(f @ir.Func, lv @LivenessInfo) @[]char {
	liveIn, liveOut := denseLiveness(lv, f)
	for b := 0; b < lv.NumBlocks; b++ {
		var nIn int = 0
		var nOut int = 0
		for id := 0; id < lv.NextID; id++ {
			if lv.IsLiveIn(b, id) != liveIn[b][id] { return "a block's live-in" }
			if lv.IsLiveOut(b, id) != liveOut[b][id] { return "a block's live-out" }
			if liveIn[b][id] { nIn++ }
			if liveOut[b][id] { nOut++ }
		}
		var inIDs @[]int = lv.LiveInIDs(b)
		var outIDs @[]int = lv.LiveOutIDs(b)
		if len(inIDs) != nIn || len(outIDs) != nOut { return "a block's id lists" }
		for j := 0; j < len(inIDs); j++ {
			if !liveIn[b][inIDs[j]] { return "a block's live-in id list" }
		}
		for j := 0; j < len(outIDs); j++ {
			if !liveOut[b][outIDs[j]] { return "a block's live-out id list" }
		}
	}
	return ""
}

// spreadFunc builds three blocks: the entry defines 70 constants; the second block
// sums the even-numbered ones and the third the multiples of 3 (and the second
// block's sum).  More values cross a boundary than one set word holds, and the
// second block's live-out (the multiples of 3, and its sum) is a scattered subset of
// the bits.
func spreadFunc() (@ir.Func, @[]@ir.Instr) {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var mid @ir.Block = ir.AddBlock(f, "mid")
	var last @ir.Block = ir.AddBlock(f, "last")
	var vals @[]@ir.Instr = make_slice(@ir.Instr, 70)
	for i := 0; i < len(vals); i++ { vals[i] = irbuild.EmitConstInt(entry, i, types.TypInt()) }
	irbuild.EmitJump(entry, mid)
	var evens @ir.Instr = irbuild.EmitConstInt(mid, 0, types.TypInt())
	for i := 0; i < len(vals); i = i + 2 {
		evens = irbuild.EmitBinop(mid, iropcode.OP_ADD, evens, vals[i], types.TypInt())
	}
	irbuild.EmitJump(mid, last)
	var threes @ir.Instr = evens
	for i := 0; i < len(vals); i = i + 3 {
		threes = irbuild.EmitBinop(last, iropcode.OP_ADD, threes, vals[i], types.TypInt())
	}
	irbuild.EmitReturn(last, oneInstr(threes))
	return f, vals
}

// Each constant is live exactly across the boundaries between its definition and
// its use; the ones nothing uses are not among the cross-block values.
func TestLivenessSpreadAcrossWords() testing.TestResult {
	setTarget64()
	f, vals := spreadFunc()
	var lv @LivenessInfo = ComputeLiveness(f, 8)
	for i := 0; i < len(vals); i++ {
		var id int = vals[i].ID
		var even bool = i % 2 == 0
		var three bool = i % 3 == 0
		if lv.IsLiveOut(0, id) != (even || three) { return "a constant's live-out of the entry" }
		if lv.IsLiveIn(1, id) != (even || three) { return "a constant's live-in to the second block" }
		if lv.IsLiveOut(1, id) != three { return "a constant's live-out of the second block" }
		if lv.IsLiveIn(2, id) != three { return "a constant's live-in to the third block" }
		if lv.IsLiveOut(2, id) { return "nothing is live out of the last block" }
		if (lv.GlobalIndex[id] >= 0) != (even || three) {
			return "exactly the used constants cross a block boundary"
		}
	}
	if len(lv.LiveOutIDs(1)) != 25 {
		return "the second block's live-out: 24 multiples of 3 and its sum"
	}
	var bad @[]char = liveSetsMismatch(f, lv)
	if len(bad) > 0 { return bad }
	var noFuse @[]bool
	bad = cursorMismatch(f, noFuse, 8)
	if len(bad) > 0 { return bad }
	return ""
}

// A value defined and used within one block never crosses a block boundary, so it
// is not among the cross-block values the block live sets range over.
func TestLivenessBlockLocalValueIsNotGlobal() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var next @ir.Block = ir.AddBlock(f, "next")
	var a @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	var local @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, a, a, types.TypInt())
	irbuild.EmitJump(entry, next)
	var b @ir.Instr = irbuild.EmitBinop(next, iropcode.OP_ADD, local, local, types.TypInt())
	var c @ir.Instr = irbuild.EmitBinop(next, iropcode.OP_ADD, b, b, types.TypInt())
	irbuild.EmitReturn(next, oneInstr(c))

	var lv @LivenessInfo = ComputeLiveness(f, 8)
	if lv.GlobalIndex[local.ID] < 0 { return "local crosses into next, so it is a cross-block value" }
	if lv.GlobalIndex[a.ID] >= 0 { return "a is used only in the entry: not a cross-block value" }
	if lv.GlobalIndex[b.ID] >= 0 { return "b is used only in next: not a cross-block value" }
	if len(lv.Globals) != 1 { return "local is the only cross-block value" }
	return ""
}

// Parameters are live from the entry: one used in the entry and again in a later
// block, one used only in a later block (live through the blocks between), and one
// never used.
func TestLivenessParametersMatchDenseEquations() testing.TestResult {
	setTarget64()
	var params @[]@ir.Param = make_slice(@ir.Param, 3)
	for i := 0; i < 3; i++ {
		params[i] = make(ir.Param)
		params[i].Typ = types.TypInt()
	}
	var f @ir.Func = ir.NewFunc("", "t", params, makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var mid @ir.Block = ir.AddBlock(f, "mid")
	var last @ir.Block = ir.AddBlock(f, "last")
	var p0 @ir.Instr = irbuild.NewParamRef(f, f.Params[0])
	var p1 @ir.Instr = irbuild.NewParamRef(f, f.Params[1])
	var x @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, p0, p0, types.TypInt())
	irbuild.EmitJump(entry, mid)
	var y @ir.Instr = irbuild.EmitBinop(mid, iropcode.OP_ADD, x, p0, types.TypInt())
	irbuild.EmitJump(mid, last)
	var z @ir.Instr = irbuild.EmitBinop(last, iropcode.OP_ADD, y, p1, types.TypInt())
	irbuild.EmitReturn(last, oneInstr(z))

	var lv @LivenessInfo = ComputeLiveness(f, 8)
	if !lv.IsLiveIn(0, p1.ID) || !lv.IsLiveOut(1, p1.ID) {
		return "a parameter used only in the last block is live from the entry through the middle"
	}
	var bad @[]char = liveSetsMismatch(f, lv)
	if len(bad) > 0 { return bad }
	return ""
}

// A loop after phi elimination (copies defining one id in two blocks, a value live
// around the back-edge), a folded element GEP (its load uses the GEP's base and
// index), and an unreachable block: the bitsets hold what the dense equations give.
func TestLivenessLoopAndFusedGepMatchDenseEquations() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "loop", makeNoParams(), makeNoResults())
	var pre @ir.Block = ir.AddBlock(f, "pre")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var dead @ir.Block = ir.AddBlock(f, "dead")
	var base @ir.Instr = regBase(pre)
	var bound @ir.Instr = irbuild.EmitConstInt(pre, 10, types.TypInt())
	var initV @ir.Instr = irbuild.EmitConstInt(pre, 0, types.TypInt())
	irbuild.EmitJump(pre, header)
	var phi @ir.Instr = irbuild.EmitPhi(header, types.TypInt(), twoPE(pre, initV, pre, initV))
	var cond @ir.Instr = irbuild.EmitBinop(header, iropcode.OP_LT, phi, bound, types.TypBool())
	irbuild.EmitBranch(header, cond, body, exit)
	var gep @ir.Instr = irbuild.EmitGetElemPtr(body, base, phi, types.TypInt())
	var ld @ir.Instr = irbuild.EmitLoad(body, gep, types.TypInt())
	var step @ir.Instr = irbuild.EmitBinop(body, iropcode.OP_ADD, phi, ld, types.TypInt())
	irbuild.EmitJump(body, header)
	phi.Phis = twoPE(pre, initV, body, step)
	irbuild.EmitReturn(exit, oneInstr(phi))
	var u @ir.Instr = irbuild.EmitBinop(dead, iropcode.OP_ADD, bound, bound, types.TypInt())
	irbuild.EmitReturn(dead, oneInstr(u))
	iropt.EliminatePhis(f)

	var fusable @[]bool = FusableElemGeps(f, false)
	if gep.ID >= len(fusable) || !fusable[gep.ID] { return "the GEP must fold into its load" }
	var lv @LivenessInfo = ComputeLivenessFused(f, 8, fusable)
	var bad @[]char = liveSetsMismatch(f, lv)
	if len(bad) > 0 { return bad }
	var noFuse @[]bool
	var plain @LivenessInfo = ComputeLiveness(f, 8)
	bad = liveSetsMismatch(f, plain)
	if len(bad) > 0 { return bad }
	bad = cursorMismatch(f, fusable, 8)
	if len(bad) > 0 { return bad }
	bad = cursorMismatch(f, noFuse, 8)
	if len(bad) > 0 { return bad }
	return ""
}
