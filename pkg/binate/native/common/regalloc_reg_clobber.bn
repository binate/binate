package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/stdx/slices"

// Per-register clobbers: an instruction whose lowering uses a register for itself
// (RegClassDesc.RegClobbers) — a fixed-register operand, or a scratch register —
// on top of the caller-saved set a returning call destroys (ClobberPositions).
// Such a register holds no value live at the instruction: unlike a call, the
// lowering may write the register before it reads its operands or after it
// writes its result, so an operand, the result and a value live across it are
// all excluded.

// regClobber is one instruction that uses registers for itself: its linear
// position and the registers.
type regClobber struct {
	Pos  int
	Regs @[]int
}

// regClobberPositions returns, ascending by position, every instruction of f's
// reachable blocks for which desc.RegClobbers names at least one register, or
// nothing when desc has no RegClobbers.  m is the function's RegMap, handed to
// the hook for its fold flags.  Positions are assigned in RPO order and the blocks
// are walked in that order, so the result is already sorted.
func regClobberPositions(m @RegMap, f @ir.Func, lv @LivenessInfo, desc RegClassDesc) @[]regClobber {
	var out @[]regClobber
	if !present(desc.RegClobbers) { return out }
	for k := 0; k < len(lv.RPO); k++ {
		var b int = lv.RPO[k]
		var blk @ir.Block = f.Blocks[b]
		var from int = lv.BlockFrom[b]
		for j := 0; j < len(blk.Instrs); j++ {
			var regs @[]int = desc.RegClobbers(m, blk.Instrs[j])
			if len(regs) == 0 { continue }
			var rc regClobber
			rc.Pos = from + j
			rc.Regs = regs
			out = slices.Append[regClobber](out, rc)
		}
	}
	return out
}

// regClobberedIn reports whether interval iv is live at an instruction of rcs
// (ascending) that uses register r for itself.  An interval covers the position
// of each instruction that reads it (a use at P extends its range to P+1) and of
// the one that defines it (its range opens at P), so Covers(P) is exactly "an
// operand, the result, or live across".
func regClobberedIn(iv @LiveInterval, r int, rcs @[]regClobber) bool {
	var s int = iv.Start()
	var e int = iv.End()
	for i := firstRegClobberAt(rcs, s); i < len(rcs); i++ {
		var p int = rcs[i].Pos
		if p < s { continue }
		if p >= e { break }
		if iv.Covers(p) && regInSet(r, rcs[i].Regs) { return true }
	}
	return false
}

// firstRegClobberAt returns the index of the first entry of rcs (ascending) at or
// after position pos, or len(rcs): a binary search, so testing an interval costs
// only the entries inside it, not every earlier one.
func firstRegClobberAt(rcs @[]regClobber, pos int) int {
	var lo int = 0
	var hi int = len(rcs)
	for lo < hi {
		var mid int = (lo + hi) / 2
		if rcs[mid].Pos < pos {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	return lo
}
