package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for per-register clobbers (regalloc_reg_clobber.bn) and their effect on
// LinearScan.

// rcAt builds a one-entry per-register clobber list: register reg used for
// itself by the instruction at pos.
func rcAt(pos int, reg int) @[]regClobber {
	var rcs @[]regClobber = make_slice(regClobber, 1)
	rcs[0].Pos = pos
	rcs[0].Regs = mkRegs(1, reg)
	return rcs
}

// A value read at the instruction (an operand), defined by it (the result), or
// live across it is barred from the register; one that dies before it, is born
// after it, or has a hole over it is not; other registers are unaffected.
func TestRegClobberedInCoversOnly() testing.TestResult {
	var rcs @[]regClobber = rcAt(5, 7)
	if !regClobberedIn(mkInterval(1, 0, 10), 7, rcs) { return "a value live across must be barred" }
	if !regClobberedIn(mkInterval(1, 0, 6), 7, rcs) {
		return "an operand (last use at 5) must be barred"
	}
	if !regClobberedIn(mkInterval(1, 5, 9), 7, rcs) { return "the result (born at 5) must be barred" }
	if regClobberedIn(mkInterval(1, 0, 5), 7, rcs) {
		return "a value dead before 5 must not be barred"
	}
	if regClobberedIn(mkInterval(1, 6, 9), 7, rcs) { return "a value born after 5 must not be barred" }
	if regClobberedIn(mkHoled(1, 0, 4, 7, 10), 7, rcs) { return "a hole over 5 must not be barred" }
	if regClobberedIn(mkInterval(1, 0, 10), 8, rcs) { return "another register must not be barred" }
	return ""
}

// The scan skips a free register an instruction the interval is live at uses for
// itself, taking another free one; with none left, the value spills.
func TestLinearScanAvoidsRegClobber() testing.TestResult {
	var desc RegClassDesc = mkDesc(mkRegs(2, 100), noClobbers())
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 1)
	ivs[0] = mkInterval(1, 0, 10)
	var bare @[]RegAssignment = LinearScan(ivs, noClobbers(), noRegClobbers(), desc, noCounts(),
			noTies())
	if AssignedReg(bare, 1) != 101 { return "without register clobbers the scan takes 101 first" }
	var asg @[]RegAssignment = LinearScan(ivs, noClobbers(), rcAt(5, 101), desc, noCounts(), noTies())
	if AssignedReg(asg, 1) != 100 { return "101 is used at 5, so the value must take 100" }
	var one RegClassDesc = mkDesc(mkRegs(1, 101), noClobbers())
	var spilled @[]RegAssignment = LinearScan(ivs, noClobbers(), rcAt(5, 101), one, noCounts(),
			noTies())
	if AssignedReg(spilled, 1) >= 0 { return "with its only register clobbered the value must spill" }
	return ""
}

// A register barred for one value is still handed to another value that is not
// live at the clobbering instruction.
func TestLinearScanRegClobberPerInterval() testing.TestResult {
	var desc RegClassDesc = mkDesc(mkRegs(1, 100), noClobbers())
	var ivs @[]@LiveInterval = ivList2(mkInterval(1, 0, 4), mkInterval(2, 4, 10))
	var asg @[]RegAssignment = LinearScan(ivs, noClobbers(), rcAt(6, 100), desc, noCounts(), noTies())
	if AssignedReg(asg, 1) != 100 { return "a value dead before the clobber keeps the register" }
	if AssignedReg(asg, 2) >= 0 { return "a value live at the clobber must not take the register" }
	return ""
}

// rcAddClobbers is a RegClobbers hook naming register 9 for every OP_ADD.
func rcAddClobbers(m @RegMap, ins @ir.Instr) @[]int {
	if ins.Op == iropcode.OP_ADD { return mkRegs(1, 9) }
	var none @[]int
	return none
}

// regClobberPositions records each instruction the hook names registers for, at
// its linear position; a desc without a hook records nothing.
func TestRegClobberPositionsFromHook() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Instr = irbuild.EmitConstInt(b, 1, types.TypInt()) // position 0
	var s @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, a, a, types.TypInt()) // position 1
	_ = irbuild.EmitBinop(b, iropcode.OP_MUL, s, a, types.TypInt()) // position 2
	irbuild.EmitReturn(b, makeNoInstrs())
	var lv @LivenessInfo = ComputeLiveness(f, 8)
	var desc RegClassDesc = mkDesc(noClobbers(), noClobbers())
	var m @RegMap = make(RegMap)
	if len(regClobberPositions(m, f, lv, desc)) != 0 {
		return "a desc without RegClobbers records nothing"
	}
	desc.RegClobbers = rcAddClobbers
	var rcs @[]regClobber = regClobberPositions(m, f, lv, desc)
	if len(rcs) != 1 || rcs[0].Pos != 1 { return "the add at position 1 is the only entry" }
	if len(rcs[0].Regs) != 1 || rcs[0].Regs[0] != 9 { return "the entry names register 9" }
	return ""
}

// rcTwo builds a two-entry per-register clobber list (ascending positions).
func rcTwo(pos0 int, reg0 int, pos1 int, reg1 int) @[]regClobber {
	var rcs @[]regClobber = make_slice(regClobber, 2)
	rcs[0].Pos = pos0
	rcs[0].Regs = mkRegs(1, reg0)
	rcs[1].Pos = pos1
	rcs[1].Regs = mkRegs(1, reg1)
	return rcs
}

// The binary search starts at the first entry at or after the interval's start,
// so entries before it neither match nor stop the scan.
func TestRegClobberedInSkipsEarlierEntries() testing.TestResult {
	var rcs @[]regClobber = rcTwo(2, 7, 8, 7)
	if !regClobberedIn(mkInterval(1, 5, 10), 7, rcs) {
		return "the entry at 8 must bar the interval [5, 10)"
	}
	if regClobberedIn(mkInterval(1, 3, 7), 7, rcs) { return "no entry lies in [3, 7)" }
	if firstRegClobberAt(rcs, 9) != 2 { return "no entry is at or after 9" }
	if firstRegClobberAt(rcs, 2) != 0 { return "the entry at 2 is the first at or after 2" }
	if firstRegClobberAt(rcs, 3) != 1 { return "the entry at 8 is the first at or after 3" }
	return ""
}

// Eviction never hands the newcomer a register it is barred from: with the only
// register clobbered while the newcomer is live, the holder keeps it and the
// newcomer spills.
func TestLinearScanEvictionRespectsRegClobber() testing.TestResult {
	var desc RegClassDesc = mkDesc(mkRegs(1, 100), noClobbers())
	var ivs @[]@LiveInterval = ivList2(mkInterval(1, 0, 10), mkInterval(2, 2, 8))
	var costs @[]int = mkCounts3(1, 50, 0)
	var bare @[]RegAssignment = LinearScan(ivs, noClobbers(), noRegClobbers(), desc, costs, noTies())
	if AssignedReg(bare, 2) != 100 {
		return "without the clobber the dearer newcomer evicts the holder"
	}
	var asg @[]RegAssignment = LinearScan(ivs, noClobbers(), rcAt(6, 100), desc, costs, noTies())
	if AssignedReg(asg, 2) >= 0 {
		return "the newcomer is live at 6, so eviction must not give it 100"
	}
	return ""
}

// A tie partner's register is not shared when the value is barred from it.
func TestLinearScanPartnerRespectsRegClobber() testing.TestResult {
	var desc RegClassDesc = mkDesc(mkRegs(2, 100), noClobbers())
	var ivs @[]@LiveInterval = ivList2(mkInterval(1, 0, 4), mkInterval(2, 4, 10))
	var ties @[]TiePoint = mkCopies1(4, 2, 1)
	var bare @[]RegAssignment = LinearScan(ivs, noClobbers(), noRegClobbers(), desc, noCounts(), ties)
	var src int = AssignedReg(bare, 1)
	if src < 0 || AssignedReg(bare, 2) != src {
		return "without the clobber the copy shares its source's register"
	}
	var asg @[]RegAssignment = LinearScan(ivs, noClobbers(), rcAt(6, src), desc, noCounts(), ties)
	if AssignedReg(asg, 2) == src {
		return "the copy is live at 6, so it must not share the barred register"
	}
	if AssignedReg(asg, 2) < 0 { return "the other register is free for the copy" }
	return ""
}

// A hole in a register's holder is not used by a value barred from the register.
func TestLinearScanHoleRespectsRegClobber() testing.TestResult {
	var one RegClassDesc = mkDesc(mkRegs(1, 100), noClobbers())
	var holed @[]@LiveInterval = ivList2(mkHoled(1, 0, 3, 8, 10), mkInterval(2, 4, 7))
	var bare @[]RegAssignment = LinearScan(holed, noClobbers(), noRegClobbers(), one, noCounts(),
			noTies())
	if AssignedReg(bare, 2) != 100 { return "without the clobber the value fits the holder's hole" }
	var asg @[]RegAssignment = LinearScan(holed, noClobbers(), rcAt(5, 100), one, noCounts(), noTies())
	if AssignedReg(asg, 2) >= 0 {
		return "the value is live at 5, so it must not take the hole in 100"
	}
	return ""
}

// A value spanning a call needs a callee-saved register; when that one is barred,
// it spills rather than taking the caller-saved one.
func TestLinearScanSpanningRegClobberSpills() testing.TestResult {
	var desc RegClassDesc = mkDesc(mkRegs(1, 100), mkRegs(1, 200))
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 1)
	ivs[0] = mkInterval(1, 0, 10)
	var clob @[]int = make_slice(int, 1)
	clob[0] = 3
	var bare @[]RegAssignment = LinearScan(ivs, clob, noRegClobbers(), desc, noCounts(), noTies())
	if AssignedReg(bare, 1) != 200 { return "a value spanning a call takes the callee-saved register" }
	var asg @[]RegAssignment = LinearScan(ivs, clob, rcAt(6, 200), desc, noCounts(), noTies())
	if AssignedReg(asg, 1) >= 0 { return "with the callee-saved register barred the value must spill" }
	return ""
}
