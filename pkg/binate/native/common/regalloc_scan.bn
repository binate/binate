package "pkg/binate/native/common"

import "pkg/binate/iropt"

import "pkg/binate/ir"
import "pkg/std/vec"
import "pkg/stdx/slices"

// The linear-scan register assignment: it consumes the Stage-0 range-list
// intervals (regalloc_interval.bn) and the clobber points, and decides, per
// allocatable SSA value, a physical register or "spilled".  Arch-neutral —
// it reads only the intervals, the clobber positions, and a per-arch
// register-class descriptor (opaque physical register numbers); the backend
// maps the result onto its emitter.  One register per value, held across all
// of the value's live ranges; the dead holes between ranges are free for other
// values (regalloc_coalesce.bn), and LinearScan itself is in
// regalloc_linear_scan.bn.
//
// The clobber rule is the correctness core.  A returning call destroys every
// caller-saved register, so a value LIVE ACROSS a clobber cannot sit in one:
// it must take a callee-saved register (saved/restored around the call by the
// prologue) or spill.  A value that is merely an argument to the call (dead
// after it) or the call's own result (born after it) does NOT span the
// clobber and may use a caller-saved register freely.

// RegClassDesc (the per-arch register inventory the scan allocates from) is
// declared in common.bni so backends can construct one.

// RegAssignment is one value's allocation decision: a physical register, or
// Reg < 0 for "spilled" (it stays in its PlanFrame stack slot).
type RegAssignment struct {
	ID  int
	Reg int
}

// ClobberPositions returns the sorted linear positions of every clobber op in
// f (reachable blocks only).  Because positions are assigned in RPO order and
// blocks are walked in that order, the result is already ascending.  Kept
// separate from the scan so a bring-up assertion can re-derive clobber points
// independently of the allocation predicate.
func ClobberPositions(f @ir.Func, lv @LivenessInfo, desc RegClassDesc) @[]int {
	var out @[]int
	for k := 0; k < len(lv.RPO); k++ {
		var b int = lv.RPO[k]
		var blk @ir.Block = f.Blocks[b]
		var from int = lv.BlockFrom[b]
		for j := 0; j < len(blk.Instrs); j++ {
			if isClobberInstr(blk.Instrs[j], desc) {
				out = slices.Append[int](out, from + j)
			}
		}
	}
	return out
}

// spansClobber reports whether interval iv is live ACROSS any clobber — born
// before the clobber and still live just after it (Covers(P+1)).  A value that
// dies at the clobber (a call argument, ¬Covers(P+1)) or is born at it (the
// call result) does not span.  clobbers is ascending.
//
// The birth test is the subtle part.  A value BORN at position P (a call
// result) has its range Start at P and its DefPos at P; it lands in a register
// only after the call returns, so it does NOT span its own defining clobber.
// A value merely live-IN at P — a parameter, or any value live-through a block
// boundary — has its range clamped to the block-entry position (which coincides
// with the first instruction's position); if that first instruction is a
// clobber, the value's Start ALSO equals P even though it was born earlier and
// DOES span.  Start() cannot tell these apart, so the birth check keys on
// DefPos (P is a birth only when P == DefPos; a parameter's DefPos is -1, never
// a clobber position).  For every clobber past Start the test is the original
// Covers(P+1) — so holed / loop-carried intervals keep their prior (safely
// conservative) classification; only the clobber sitting exactly at Start is
// reclassified, which is where the live-in-parameter miscompile lived.
//
// The `P == DefPos` birth-skip is safe because DefPos == Start means the value is
// genuinely born at P (Start is the min range start, and a def opens a range at its own
// position, so nothing precedes it — it cannot be live-in).  This leans on every
// clobber-defined value being SINGLE-def: the only multi-def ids are phi results, which
// EliminatePhis lowers to OP_COPY — never a returning call (see EmitsReturningBl) — so a
// loop-carried value's DefPos is a COPY position that never equals a clobber position and it
// always keeps the conservative Covers(P+1) test.  A backend that lowered a phi copy to a
// returning call would break this assumption.
func spansClobber(iv @LiveInterval, clobbers @[]int) bool {
	var s int = iv.Start()
	var e int = iv.End()
	var dp int = iv.DefPos
	for i := 0; i < len(clobbers); i++ {
		var p int = clobbers[i]
		if p < s { continue } // before birth: cannot be covered
		if p >= e { break } // sorted: no later clobber lies within the interval
		if p == s && dp == s { continue } // born exactly here (call result): no span
		if iv.Covers(p + 1) { return true }
	}
	return false
}

// spillCostOf returns id's spill cost from spillCosts (id-indexed), or 0 when id
// is out of range (an empty/short spillCosts makes every cost 0, so eviction
// never fires and the scan reduces to spill-the-newcomer).
func spillCostOf(spillCosts @[]int, id int) int {
	if id < 0 || id >= len(spillCosts) { return 0 }
	return spillCosts[id]
}

// computeSpillCosts returns the id-indexed spill cost the scan evicts by: for
// each allocatable def/use point, its block's loop weight (loopWeight of the
// block's loop-nesting depth) accumulated onto that id.  A use in a hot loop
// therefore counts far more than one in straight-line code — a static proxy for
// dynamic reload frequency, so eviction keeps loop-hot values in registers even
// when a straight-line value has a higher raw def/use COUNT.  Uses the SAME
// defIdOf/useIdOf extraction as the interval builder (so the counted points are
// exactly the allocatable def/use points) and iropt.ComputeLoopDepths for the
// per-block depth.
func computeSpillCosts(f @ir.Func, lv @LivenessInfo) @[]int {
	var depths @[]int = iropt.ComputeLoopDepths(f)
	var costs @[]int = make_slice(int, lv.NextID)
	for k := 0; k < len(lv.RPO); k++ {
		var b int = lv.RPO[k]
		var w int = loopWeight(depths[b])
		var blk @ir.Block = f.Blocks[b]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			var d int = defIdOf(lv, ins, lv.WordBytes)
			if d >= 0 { costs[d] = costs[d] + w }
			for ai := 0; ai < len(ins.Args); ai++ {
				var u int = useIdOf(lv, ins.Args[ai])
				if u >= 0 { costs[u] = costs[u] + w }
			}
		}
	}
	return costs
}

// loopWeight maps a block's loop-nesting depth to a per-reference weight: ~10x
// per level (a rough dynamic-frequency proxy — each enclosing loop multiplies the
// iteration count), capped at depth 4 (10^4) so the summed cost cannot overflow
// on a 32-bit host even in a large function.
func loopWeight(depth int) int {
	var capped int = depth
	if capped > 4 { capped = 4 }
	var w int = 1
	for i := 0; i < capped; i++ { w = w * 10 }
	return w
}

// AssignedReg returns the register assigned to id, or -1 if id is spilled or
// not in the assignment list.
func AssignedReg(assignments @[]RegAssignment, id int) int {
	for i := 0; i < len(assignments); i++ {
		if assignments[i].ID == id { return assignments[i].Reg }
	}
	return -1
}

// copyInts returns a fresh copy of s (so the scan's mutable free pools do not
// alias the descriptor's slices).
func copyInts(s @[]int) @[]int {
	var out @[]int = make_slice(int, len(s))
	for i := 0; i < len(s); i++ { out[i] = s[i] }
	return out
}

// dropLast returns s without its last element (s must be non-empty).
func dropLast(s @[]int) @[]int {
	return s[0:len(s) - 1]
}

// AllocateRegisters runs the full pipeline (liveness -> range-list intervals
// -> clobber points -> linear scan) and records the result on m: the stable
// HomeIDs/HomeRegs map, the callee-saved SavedRegs the prologue must
// preserve, and SavedRegsBytes (PlanFrame lays the save area down at
// SavedRegsOff).  Call BEFORE PlanFrame.  Idempotent-ish only if m's home
// tables are empty; a backend calls it once per function on a fresh RegMap.
func (m @RegMap) AllocateRegisters(f @ir.Func, wordBytes int, desc RegClassDesc,
		foldRefDecDtorHandles bool) {
	if foldRefDecDtorHandles {
		m.FoldedDtor = FoldedDtorHandles(f)
	}
	// m.FusableGep / m.FusableFieldGep (set by the backend before this call) make
	// liveness redirect each folded GEP's operand(s) to its consuming load/store;
	// both empty on backends without a fold, so the redirect is a no-op there.
	// The liveness carries a single fusable set, so union the two GEP kinds (a
	// value is at most one of them); the hooks disambiguate on opcode.
	var lv @LivenessInfo = ComputeLivenessFused(f, wordBytes,
			UnionFusable(m.FusableGep, m.FusableFieldGep))
	var intervals @[]@LiveInterval = BuildIntervals(f, lv)
	var clobbers @[]int = ClobberPositions(f, lv, desc)
	var spillCosts @[]int = computeSpillCosts(f, lv)
	var ties @[]TiePoint = m.dropFoldedTies(CollectTiePoints(f, lv, desc.TieOps))
	var assignments @[]RegAssignment = LinearScan(intervals, clobbers, desc, spillCosts, ties)

	var usedSet @[]int
	var homeIDs @vec.Vec[int] = intVecFrom(m.HomeIDs)
	var homeRegs @vec.Vec[int] = intVecFrom(m.HomeRegs)
	for i := 0; i < len(assignments); i++ {
		var reg int = assignments[i].Reg
		if reg < 0 { continue } // spilled — stays in its PlanFrame slot
		// A folded dtor handle is materialized in the RefDec slow path and never
		// read from a register, so homing it would reserve (and save/restore) a
		// callee-saved register for a value nothing uses.  Leave it unhomed.
		if m.IsFoldedDtorHandle(assignments[i].ID) { continue }
		// A fusable element GEP is folded into its consuming load/store's scaled
		// addressing mode and never emitted, so its result is likewise read by
		// nothing — leave it unhomed (see FusableGep).
		if m.IsFusableElemGep(assignments[i].ID) { continue }
		// A fusable field GEP folds into its consuming load/store's constant
		// offset (see FusableFieldGep) — likewise never read, leave it unhomed.
		if m.IsFusableFieldGep(assignments[i].ID) { continue }
		// A branch-fused comparison lowers to a flag-setting compare with no 0/1
		// boolean result, so nothing reads it as a register — leave it unhomed
		// (see FusedCmp), so it neither reserves nor forces the save of a register.
		if m.IsFusedCmp(assignments[i].ID) { continue }
		// A constant that rides the immediate operand of every user is never
		// materialized into a register — leave it unhomed (see FoldedImm).
		if m.IsFoldedImm(assignments[i].ID) { continue }
		// A tst-folded AND produces no register result (its `tst` sets only flags)
		// — leave it unhomed (see TstFoldedAnd).
		if m.IsTstFoldedAnd(assignments[i].ID) { continue }
		homeIDs.Push(assignments[i].ID)
		homeRegs.Push(reg)
		if regInSet(reg, desc.CalleeSaved) && !regInSet(reg, usedSet) {
			usedSet = AppendInt(usedSet, reg)
		}
	}
	m.HomeIDs = homeIDs.Items()
	m.HomeRegs = homeRegs.Items()
	m.SavedRegs = sortIntsAscending(usedSet)
	var nbytes int = len(m.SavedRegs) * 8
	if nbytes % 16 != 0 { nbytes = nbytes + (16 - nbytes % 16) }
	m.SavedRegsBytes = nbytes
	// m.SavedRegsOff is filled in by PlanFrame.
}

// LookupHome returns the stable home register for id, or -1 if id is spilled
// or not register-allocated.  Backed by a memoized id->index map rebuilt iff
// HomeIDs changed length (AllocateRegisters appends; nothing edits HomeIDs in
// place at a fixed length); UnhomeIDs also force-invalidates the memo, so it
// stays correct under any mutation order.  The per-operand lookup is thus O(1).
func (m @RegMap) LookupHome(id int) int {
	if m.homeIdxLen != len(m.HomeIDs) {
		m.homeIdx = buildIDIndex(m.HomeIDs)
		m.homeIdxLen = len(m.HomeIDs)
	}
	var k int = idxLookup(m.homeIdx, id)
	if k < 0 { return -1 }
	return m.HomeRegs[k]
}

// SameHome reports whether ids a and b are both homed, in the same register —
// which the allocator does only where they are never live together except at a
// tie between them (regalloc_coalesce.bn), so a copy from one to the other is
// already done.
func (m @RegMap) SameHome(a int, b int) bool {
	var ha int = m.LookupHome(a)
	return ha >= 0 && ha == m.LookupHome(b)
}

// UnhomeIDs removes from the home map every id whose flag is set in drop (an
// id-indexed flag set; an id outside it is kept), reverting each to the
// spill-everything path (its PlanFrame slot).  A backend calls this after
// AllocateRegisters to opt specific values out of homing — e.g. arm32, whose
// caller-saved home pool (R0..R3) overlaps the argument/return registers, must
// not home a value used as a call operand (its home would be clobbered by the
// call's argument/target setup).  On such a backend SavedRegs is empty
// (callee-saved pool empty), so no save-area bookkeeping needs updating.
//
// The map is rebuilt once, in one pass over it, however many ids are dropped:
// removing ids one at a time would rebuild it once per id, and a function with
// thousands of call operands and thousands of homes would compile in time
// quadratic in both.
func (m @RegMap) UnhomeIDs(drop @[]bool) {
	var keep int = 0
	for i := 0; i < len(m.HomeIDs); i++ {
		if !idFlagged(drop, m.HomeIDs[i]) { keep = keep + 1 }
	}
	if keep == len(m.HomeIDs) { return }
	var newIDs @[]int = make_slice(int, keep)
	var newRegs @[]int = make_slice(int, keep)
	var k int = 0
	for i := 0; i < len(m.HomeIDs); i++ {
		if idFlagged(drop, m.HomeIDs[i]) { continue }
		newIDs[k] = m.HomeIDs[i]
		newRegs[k] = m.HomeRegs[i]
		k = k + 1
	}
	m.HomeIDs = newIDs
	m.HomeRegs = newRegs
	// Force LookupHome's memoized id-index to rebuild.  Removing entries
	// shrinks HomeIDs, so the length key would catch this on its own today —
	// but only because nothing re-appends to HomeIDs after an UnhomeIDs.  Reset
	// the key explicitly so the memo stays correct regardless of future
	// mutation order (e.g. a shrink then a regrow back to a previously-indexed
	// length), rather than resting on that unstated sequencing precondition.
	m.homeIdxLen = -1
}

// idFlagged reports whether id indexes a set flag in the id-indexed set flags.
func idFlagged(flags @[]bool, id int) bool {
	return id >= 0 && id < len(flags) && flags[id]
}

// regInSet reports whether reg appears in set.
func regInSet(reg int, set @[]int) bool {
	for i := 0; i < len(set); i++ {
		if set[i] == reg { return true }
	}
	return false
}

// sortIntsAscending returns a sorted copy of s (insertion sort; small sets).
func sortIntsAscending(s @[]int) @[]int {
	var out @[]int = copyInts(s)
	for i := 1; i < len(out); i++ {
		var key int = out[i]
		var j int = i - 1
		for j >= 0 && out[j] > key {
			out[j + 1] = out[j]
			j = j - 1
		}
		out[j + 1] = key
	}
	return out
}
