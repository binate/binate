package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/stdx/slices"

// The linear-scan register assignment: it consumes the Stage-0 range-list
// intervals (regalloc_interval.bn) and the clobber points, and decides, per
// allocatable SSA value, a physical register or "spilled".  Arch-neutral —
// it reads only the intervals, the clobber positions, and a per-arch
// register-class descriptor (opaque physical register numbers); the backend
// maps the result onto its emitter.  Whole-interval assignment: one register
// for a value's entire [Start, End) extent (dead holes just waste the
// register for now; interval splitting to reclaim them is a later
// refinement).
//
// The clobber rule is the correctness core.  A returning call destroys every
// caller-saved register, so a value LIVE ACROSS a clobber cannot sit in one:
// it must take a callee-saved register (saved/restored around the call by the
// prologue) or spill.  A value that is merely an argument to the call (dead
// after it) or the call's own result (born after it) does NOT span the
// clobber and may use a caller-saved register freely.

// RegClassDesc (the per-arch register inventory the scan allocates from) is
// declared in common.bni so backends can construct one.

// RegAssignment is one value's allocation decision: a physical register, or
// Reg < 0 for "spilled" (it stays in its PlanFrame stack slot).
type RegAssignment struct {
	ID  int
	Reg int
}

// ClobberPositions returns the sorted linear positions of every clobber op in
// f (reachable blocks only).  Because positions are assigned in RPO order and
// blocks are walked in that order, the result is already ascending.  Kept
// separate from the scan so a bring-up assertion can re-derive clobber points
// independently of the allocation predicate.
func ClobberPositions(f @ir.Func, lv @LivenessInfo, desc RegClassDesc) @[]int {
	var out @[]int
	for k := 0; k < len(lv.RPO); k++ {
		var b int = lv.RPO[k]
		var blk @ir.Block = f.Blocks[b]
		var from int = lv.BlockFrom[b]
		for j := 0; j < len(blk.Instrs); j++ {
			if isClobberInstr(blk.Instrs[j], desc) {
				out = slices.Append[int](out, from + j)
			}
		}
	}
	return out
}

// spansClobber reports whether interval iv is live ACROSS any clobber — i.e.
// born before the clobber (Start < P) and still live just after it
// (Covers(P+1)).  A value that dies at the clobber (a call argument) or is
// born at it (the call result) does not span it.  clobbers is ascending.
func spansClobber(iv @LiveInterval, clobbers @[]int) bool {
	var s int = iv.Start()
	var e int = iv.End()
	for i := 0; i < len(clobbers); i++ {
		var p int = clobbers[i]
		if p <= s { continue }
		if p >= e { break } // sorted: no later clobber lies within the interval
		if iv.Covers(p + 1) { return true }
	}
	return false
}

// LinearScan assigns each interval a register or marks it spilled.  Intervals
// must be sorted by Start (BuildIntervals returns them so).  clobbers is the
// ascending clobber-position list (ClobberPositions).  An interval that spans
// a clobber takes a callee-saved register (or spills if none free); one that
// does not prefers a caller-saved register (leaving callee-saved for spanning
// intervals), falling back to callee-saved.
//
// useCounts is the id-indexed static spill cost (def+use count per id;
// computeUseCounts): a higher count means more reloads if spilled, so it is
// worth keeping in a register.  When the eligible pool is exhausted, rather than
// always spilling the newcomer, the scan EVICTS the cheapest eligible active
// (min useCount) IF that is cheaper than the current interval — spilling it and
// handing the current its register — else spills the current.  Equal costs never
// evict, so a uniform (or empty) useCounts reproduces the plain
// spill-the-newcomer behavior exactly.
func LinearScan(intervals @[]@LiveInterval, clobbers @[]int, desc RegClassDesc,
		useCounts @[]int) @[]RegAssignment {
	var freeCaller @[]int = copyInts(desc.CallerSaved)
	var freeCallee @[]int = copyInts(desc.CalleeSaved)
	// Active intervals holding a register, as parallel arrays: End / Reg /
	// whether the reg came from the callee-saved pool / the interval's spill cost
	// (useCount) / its index in result (so an evicted active can be marked
	// spilled there).
	var actEnd @[]int
	var actReg @[]int
	var actCallee @[]bool
	var actCost @[]int
	var actResIdx @[]int
	// One RegAssignment per interval; size up front and fill by index rather
	// than reallocating (and refcounting) the growing @[]RegAssignment on every
	// interval.
	var result @[]RegAssignment = make_slice(RegAssignment, len(intervals))

	for i := 0; i < len(intervals); i++ {
		var iv @LiveInterval = intervals[i]
		var start int = iv.Start()

		// Expire intervals that end at or before this one's start, returning
		// their registers to the pool they came from.  Compact the survivors in
		// place (the active set is bounded by the register count, but rebuilding
		// fresh parallel slices every interval still churns allocations
		// and their dtors).
		var w int = 0
		for a := 0; a < len(actEnd); a++ {
			if actEnd[a] <= start {
				if actCallee[a] {
					freeCallee = slices.Append[int](freeCallee, actReg[a])
				} else {
					freeCaller = slices.Append[int](freeCaller, actReg[a])
				}
			} else {
				actEnd[w] = actEnd[a]
				actReg[w] = actReg[a]
				actCallee[w] = actCallee[a]
				actCost[w] = actCost[a]
				actResIdx[w] = actResIdx[a]
				w = w + 1
			}
		}
		actEnd = actEnd[0:w]
		actReg = actReg[0:w]
		actCallee = actCallee[0:w]
		actCost = actCost[0:w]
		actResIdx = actResIdx[0:w]

		var spans bool = spansClobber(iv, clobbers)
		var costC int = spillCostOf(useCounts, iv.ID)

		var reg int = -1
		var fromCallee bool = false
		if spans {
			// Must survive the call: callee-saved only.
			if len(freeCallee) > 0 {
				reg = freeCallee[len(freeCallee) - 1]
				freeCallee = dropLast(freeCallee)
				fromCallee = true
			}
		} else if len(freeCaller) > 0 {
			reg = freeCaller[len(freeCaller) - 1]
			freeCaller = dropLast(freeCaller)
		} else if len(freeCallee) > 0 {
			reg = freeCallee[len(freeCallee) - 1]
			freeCallee = dropLast(freeCallee)
			fromCallee = true
		}

		// No free register in the eligible pool: consider EVICTING the cheapest
		// eligible active (spill it, take its register) when that is cheaper than
		// spilling the current interval.  A clobber-spanning current interval needs
		// a callee-saved register, so it may only evict a callee-saved holder; a
		// non-spanning one may evict any active (it can use whatever class the freed
		// register is).  The evicted value goes to memory — correct for any value,
		// including a clobber-spanning one, which still survives the call in its slot.
		var evictSlot int = -1
		if reg < 0 {
			var bestSlot int = -1
			var bestCost int = 0
			for a := 0; a < len(actEnd); a++ {
				if spans && !actCallee[a] { continue }
				if bestSlot < 0 || actCost[a] < bestCost {
					bestSlot = a
					bestCost = actCost[a]
				}
			}
			if bestSlot >= 0 && bestCost < costC {
				result[actResIdx[bestSlot]].Reg = -1 // the evicted active spills
				reg = actReg[bestSlot]
				fromCallee = actCallee[bestSlot]
				evictSlot = bestSlot
			}
		}

		if reg >= 0 {
			if evictSlot >= 0 {
				// Reuse the evicted active's slot — its register is now this
				// interval's, held until this interval's end.
				actEnd[evictSlot] = iv.End()
				actReg[evictSlot] = reg
				actCallee[evictSlot] = fromCallee
				actCost[evictSlot] = costC
				actResIdx[evictSlot] = i
			} else {
				actEnd = slices.Append[int](actEnd, iv.End())
				actReg = slices.Append[int](actReg, reg)
				actCallee = slices.Append[bool](actCallee, fromCallee)
				actCost = slices.Append[int](actCost, costC)
				actResIdx = slices.Append[int](actResIdx, i)
			}
		}
		var ra RegAssignment
		ra.ID = iv.ID
		ra.Reg = reg
		result[i] = ra
	}
	return result
}

// spillCostOf returns the static spill cost of id — its def+use count from
// useCounts (id-indexed) — or 0 when id is out of range (an empty/short
// useCounts makes every cost 0, so eviction never fires and the scan reduces to
// spill-the-newcomer).
func spillCostOf(useCounts @[]int, id int) int {
	if id < 0 || id >= len(useCounts) { return 0 }
	return useCounts[id]
}

// computeUseCounts returns the id-indexed count of instructions that define or
// use each allocatable id (a def and each operand reference count 1) over the
// reachable blocks — the static spill-cost proxy the scan evicts by.  Uses the
// SAME defIdOf/useIdOf extraction as the interval builder, so the counted points
// are exactly the allocatable def/use points.
func computeUseCounts(f @ir.Func, lv @LivenessInfo) @[]int {
	var counts @[]int = make_slice(int, lv.NextID)
	for k := 0; k < len(lv.RPO); k++ {
		var b int = lv.RPO[k]
		var blk @ir.Block = f.Blocks[b]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			var d int = defIdOf(lv, ins, lv.WordBytes)
			if d >= 0 { counts[d] = counts[d] + 1 }
			for ai := 0; ai < len(ins.Args); ai++ {
				var u int = useIdOf(lv, ins.Args[ai])
				if u >= 0 { counts[u] = counts[u] + 1 }
			}
		}
	}
	return counts
}

// AssignedReg returns the register assigned to id, or -1 if id is spilled or
// not in the assignment list.
func AssignedReg(assignments @[]RegAssignment, id int) int {
	for i := 0; i < len(assignments); i++ {
		if assignments[i].ID == id { return assignments[i].Reg }
	}
	return -1
}

// copyInts returns a fresh copy of s (so the scan's mutable free pools do not
// alias the descriptor's slices).
func copyInts(s @[]int) @[]int {
	var out @[]int = make_slice(int, len(s))
	for i := 0; i < len(s); i++ { out[i] = s[i] }
	return out
}

// dropLast returns s without its last element (s must be non-empty).
func dropLast(s @[]int) @[]int {
	return s[0:len(s) - 1]
}

// AllocateRegisters runs the full pipeline (liveness -> range-list intervals
// -> clobber points -> linear scan) and records the result on m: the stable
// HomeIDs/HomeRegs map, the callee-saved SavedRegs the prologue must
// preserve, and SavedRegsBytes (PlanFrame lays the save area down at
// SavedRegsOff).  Call BEFORE PlanFrame.  Idempotent-ish only if m's home
// tables are empty; a backend calls it once per function on a fresh RegMap.
func (m @RegMap) AllocateRegisters(f @ir.Func, wordBytes int, desc RegClassDesc) {
	var lv @LivenessInfo = ComputeLiveness(f, wordBytes)
	var intervals @[]@LiveInterval = BuildIntervals(f, lv)
	var clobbers @[]int = ClobberPositions(f, lv, desc)
	var useCounts @[]int = computeUseCounts(f, lv)
	var assignments @[]RegAssignment = LinearScan(intervals, clobbers, desc, useCounts)

	var usedSet @[]int
	for i := 0; i < len(assignments); i++ {
		var reg int = assignments[i].Reg
		if reg < 0 { continue } // spilled — stays in its PlanFrame slot
		m.HomeIDs = AppendInt(m.HomeIDs, assignments[i].ID)
		m.HomeRegs = AppendInt(m.HomeRegs, reg)
		if regInSet(reg, desc.CalleeSaved) && !regInSet(reg, usedSet) {
			usedSet = AppendInt(usedSet, reg)
		}
	}
	m.SavedRegs = sortIntsAscending(usedSet)
	var nbytes int = len(m.SavedRegs) * 8
	if nbytes % 16 != 0 { nbytes = nbytes + (16 - nbytes % 16) }
	m.SavedRegsBytes = nbytes
	// m.SavedRegsOff is filled in by PlanFrame.
}

// LookupHome returns the stable home register for id, or -1 if id is spilled
// or not register-allocated.  Backed by a memoized id->index map rebuilt iff
// HomeIDs changed length (AllocateRegisters appends; nothing edits HomeIDs in
// place at a fixed length); UnhomeID also force-invalidates the memo, so it
// stays correct under any mutation order.  The per-operand lookup is thus O(1).
func (m @RegMap) LookupHome(id int) int {
	if m.homeIdxLen != len(m.HomeIDs) {
		m.homeIdx = buildIDIndex(m.HomeIDs)
		m.homeIdxLen = len(m.HomeIDs)
	}
	var k int = idxLookup(m.homeIdx, id)
	if k < 0 { return -1 }
	return m.HomeRegs[k]
}

// UnhomeID removes id from the home map (if present), reverting it to the
// spill-everything path (its PlanFrame slot).  A backend calls this after
// AllocateRegisters to opt specific values out of homing — e.g. arm32, whose
// caller-saved home pool (R0..R3) overlaps the argument/return registers, must
// not home a value used as a call operand (its home would be clobbered by the
// call's argument/target setup).  On such a backend SavedRegs is empty
// (callee-saved pool empty), so no save-area bookkeeping needs updating.
func (m @RegMap) UnhomeID(id int) {
	var newIDs @[]int
	var newRegs @[]int
	for i := 0; i < len(m.HomeIDs); i++ {
		if m.HomeIDs[i] == id { continue }
		newIDs = AppendInt(newIDs, m.HomeIDs[i])
		newRegs = AppendInt(newRegs, m.HomeRegs[i])
	}
	m.HomeIDs = newIDs
	m.HomeRegs = newRegs
	// Force LookupHome's memoized id-index to rebuild.  Removing an entry
	// shrinks HomeIDs, so the length key would catch this on its own today —
	// but only because nothing re-appends to HomeIDs after an UnhomeID.  Reset
	// the key explicitly so the memo stays correct regardless of future
	// mutation order (e.g. a shrink then a regrow back to a previously-indexed
	// length), rather than resting on that unstated sequencing precondition.
	m.homeIdxLen = -1
}

// regInSet reports whether reg appears in set.
func regInSet(reg int, set @[]int) bool {
	for i := 0; i < len(set); i++ {
		if set[i] == reg { return true }
	}
	return false
}

// sortIntsAscending returns a sorted copy of s (insertion sort; small sets).
func sortIntsAscending(s @[]int) @[]int {
	var out @[]int = copyInts(s)
	for i := 1; i < len(out); i++ {
		var key int = out[i]
		var j int = i - 1
		for j >= 0 && out[j] > key {
			out[j + 1] = out[j]
			j = j - 1
		}
		out[j + 1] = key
	}
	return out
}
