package "pkg/binate/native/common"

import "pkg/binate/ir"

// AllocateFpRegisters runs the linear-scan pipeline a SECOND time, over the FP
// register class, and records the resulting FP homes on m.  Call it AFTER
// AllocateRegisters (the GP pass) and BEFORE PlanFrame.
//
// The scan engine (ComputeLiveness/BuildIntervals/ClobberPositions/spill-cost/
// LinearScan) is register-class-agnostic — it works on opaque physical-register
// numbers from `desc` — so this reuses it wholesale with the FP allocatable
// universe (ComputeLivenessFp) and an FP descriptor (CalleeSaved D8..D15,
// CallerSaved D0..D7/D18..D31 on aa64).  FP homes go into the SHARED
// HomeIDs/HomeRegs map (a D-register number is >= D0, disjoint from every X
// number, so LookupHome is unambiguous); the callee-saved FP registers used go
// into the SEPARATE SavedFpRegs, since the GP prologue save loop assumes GP
// stores.  A backend that wants no FP class passes an empty descriptor, and the
// scan homes nothing (every FP value keeps its spill slot).
//
// Unlike the GP pass, no assignment is skipped: an FP value is never a folded
// dtor handle, a fusable element GEP, or a fused compare (those are GP-typed
// pointer/int results), so every non-spilled FP assignment becomes a home.
func (m @RegMap) AllocateFpRegisters(f @ir.Func, wordBytes int, desc RegClassDesc) {
	if len(desc.CalleeSaved) == 0 && len(desc.CallerSaved) == 0 {
		return
	}
	// m.FusableGep redirects a folded GP element GEP's operand liveness; those
	// operands are pointer/int (GP), never FP-allocatable, so the redirect is a
	// no-op in the FP universe — passed for consistency.
	var lv @LivenessInfo = ComputeLivenessFp(f, wordBytes, m.FusableGep)
	var intervals @[]@LiveInterval = BuildIntervals(f, lv)
	var clobbers @[]int = ClobberPositions(f, lv, desc)
	var spillCosts @[]int = computeSpillCosts(f, lv)
	var assignments @[]RegAssignment = LinearScan(intervals, clobbers, desc, spillCosts)

	var usedSet @[]int
	for i := 0; i < len(assignments); i++ {
		var reg int = assignments[i].Reg
		if reg < 0 { continue } // spilled — stays in its PlanFrame slot
		m.HomeIDs = AppendInt(m.HomeIDs, assignments[i].ID)
		m.HomeRegs = AppendInt(m.HomeRegs, reg)
		if regInSet(reg, desc.CalleeSaved) && !regInSet(reg, usedSet) {
			usedSet = AppendInt(usedSet, reg)
		}
	}
	m.SavedFpRegs = sortIntsAscending(usedSet)
	var nbytes int = len(m.SavedFpRegs) * 8
	if nbytes % 16 != 0 { nbytes = nbytes + (16 - nbytes % 16) }
	m.SavedFpRegsBytes = nbytes
	// m.SavedFpRegsOff is filled in by PlanFrame.
}
