package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// AllocateFpRegisters (the FP linear-scan pass) homes FLOAT values in the FP
// register pool and leaves GP values to the GP pass.  Mock pools are chosen
// disjoint: FP caller 32..39 / callee 40..47 (the real D0..D15 range), GP
// 200..209 (fake, out of any real register range) — so a home's pool identifies
// its class.
func TestAllocateFpRegistersHomesFloats() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var iv @ir.Instr = irbuild.EmitConstInt(b, 1, types.TypInt())
	var fv @ir.Instr = irbuild.EmitCall(b, "gen", makeNoInstrs(), types.TypFloat64())
	var iv2 @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, iv, iv, types.TypInt())
	var _ @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, fv, fv, types.TypFloat64())
	irbuild.EmitReturn(b, oneInstr(iv2))

	var rm @RegMap = nrm()
	// GP pass homes iv/iv2 in 200..209; FP pass homes fv in 32..47.
	rm.AllocateRegisters(f, 8, mkDesc(noClobbers(), mkRegs(10, 200)), false)
	rm.AllocateFpRegisters(f, 8, mkDesc(mkRegs(8, 32), mkRegs(8, 40)))

	var hfv int = rm.LookupHome(fv.ID)
	if hfv < 32 || hfv > 47 { return "a float value must get an FP home in the FP pool (32..47)" }
	var hiv int = rm.LookupHome(iv.ID)
	if hiv < 200 || hiv > 209 { return "an int value must stay GP-homed (200..209), not FP" }
	return ""
}

// A float value LIVE ACROSS A CALL must land in a callee-saved FP register and be
// recorded in SavedFpRegs (separate from the GP SavedRegs), so the prologue can
// preserve it with the D-register save form.
func TestAllocateFpRegistersCalleeSavedAcrossCall() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var fv @ir.Instr = irbuild.EmitCall(b, "gen", makeNoInstrs(), types.TypFloat64())
	// A second call clobbers caller-saved FP; fv is live across it (used after).
	var _ @ir.Instr = irbuild.EmitCall(b, "other", makeNoInstrs(), types.TypInt())
	var fv2 @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, fv, fv, types.TypFloat64())
	irbuild.EmitReturn(b, makeNoInstrs())
	var _ @ir.Instr = fv2

	var rm @RegMap = nrm()
	rm.AllocateRegisters(f, 8, mkDesc(noClobbers(), mkRegs(10, 200)), false)
	rm.AllocateFpRegisters(f, 8, mkDesc(mkRegs(8, 32), mkRegs(8, 40)))

	var hfv int = rm.LookupHome(fv.ID)
	if hfv < 40 || hfv > 47 {
		return "a float live across a call must be homed in a callee-saved FP reg (40..47)"
	}
	if len(rm.SavedFpRegs) == 0 { return "the used callee-saved FP reg must be in SavedFpRegs" }
	if !regInSet(hfv, rm.SavedFpRegs) { return "fv's FP home must be recorded in SavedFpRegs" }
	if rm.SavedFpRegsBytes % 16 != 0 { return "the FP save area must be 16-byte aligned" }
	return ""
}

// An empty FP descriptor (a backend with no FP class) homes nothing: every float
// keeps its spill slot, and SavedFpRegs stays empty.
func TestAllocateFpRegistersEmptyDescNoHomes() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var fv @ir.Instr = irbuild.EmitCall(b, "gen", makeNoInstrs(), types.TypFloat64())
	var _ @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, fv, fv, types.TypFloat64())
	irbuild.EmitReturn(b, makeNoInstrs())

	var rm @RegMap = nrm()
	var empty @[]int = make_slice(int, 0)
	rm.AllocateFpRegisters(f, 8, mkDesc(empty, empty))
	if rm.LookupHome(fv.ID) >= 0 { return "no FP class -> a float must not be homed" }
	if len(rm.SavedFpRegs) != 0 { return "no FP class -> SavedFpRegs must be empty" }
	return ""
}
