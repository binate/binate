package "pkg/binate/native/common"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// mkInterval builds a single-range interval [start, end) for id.
func mkInterval(id int, start int, end int) @LiveInterval {
	var iv @LiveInterval = make(LiveInterval)
	iv.ID = id
	var r LiveRange
	r.Start = start
	r.End = end
	iv.Ranges = make_slice(LiveRange, 1)
	iv.Ranges[0] = r
	return iv
}

// mkRegs returns [base, base+1, ..., base+n-1] — opaque physical register
// numbers (the scan never interprets them, so any distinct ints work).
func mkRegs(n int, base int) @[]int {
	var s @[]int = make_slice(int, n)
	for i := 0; i < n; i++ { s[i] = base + i }
	return s
}

// mkDesc builds a register-class descriptor from caller/callee pools.
func mkDesc(caller @[]int, callee @[]int) RegClassDesc {
	var d RegClassDesc
	d.CallerSaved = caller
	d.CalleeSaved = callee
	return d
}

// ivList builds a @[]@LiveInterval from the given intervals (already sorted by
// start by construction in each test).
func ivList2(a @LiveInterval, b @LiveInterval) @[]@LiveInterval {
	var s @[]@LiveInterval = make_slice(@LiveInterval, 2)
	s[0] = a
	s[1] = b
	return s
}

func ivList3(a @LiveInterval, b @LiveInterval, c @LiveInterval) @[]@LiveInterval {
	var s @[]@LiveInterval = make_slice(@LiveInterval, 3)
	s[0] = a
	s[1] = b
	s[2] = c
	return s
}

// extentsOverlap reports whether two [Start,End) extents overlap.
func extentsOverlap(a @LiveInterval, b @LiveInterval) bool {
	return a.Start() < b.End() && b.Start() < a.End()
}

// checkNoOverlapSharing asserts the core invariant: no two intervals whose
// extents overlap are assigned the SAME register.  Returns "" if sound.
func checkNoOverlapSharing(ivs @[]@LiveInterval, asg @[]RegAssignment) @[]char {
	for i := 0; i < len(ivs); i++ {
		for j := i + 1; j < len(ivs); j++ {
			if !extentsOverlap(ivs[i], ivs[j]) { continue }
			var ri int = AssignedReg(asg, ivs[i].ID)
			var rj int = AssignedReg(asg, ivs[j].ID)
			if ri >= 0 && rj >= 0 && ri == rj {
				return "two overlapping intervals were assigned the same register"
			}
		}
	}
	return ""
}

// noClobbers is the empty clobber-position list.
func noClobbers() @[]int {
	var e @[]int
	return e
}

// Three mutually-overlapping intervals with three registers: all get a
// distinct register, none spills.
func TestScanDistinctRegistersForOverlap() testing.TestResult {
	var a @LiveInterval = mkInterval(1, 0, 10)
	var b @LiveInterval = mkInterval(2, 2, 8)
	var c @LiveInterval = mkInterval(3, 4, 6)
	var ivs @[]@LiveInterval = ivList3(a, b, c)
	var asg @[]RegAssignment = LinearScan(ivs, noClobbers(), mkDesc(mkRegs(3, 100), noClobbers()))
	if AssignedReg(asg, 1) < 0 || AssignedReg(asg, 2) < 0 || AssignedReg(asg, 3) < 0 {
		return "three overlapping intervals with three registers should all get one"
	}
	return checkNoOverlapSharing(ivs, asg)
}

// More simultaneously-live intervals than registers: the excess spills, but
// the assigned ones stay distinct.
func TestScanSpillsUnderPressure() testing.TestResult {
	var a @LiveInterval = mkInterval(1, 0, 10)
	var b @LiveInterval = mkInterval(2, 2, 8)
	var c @LiveInterval = mkInterval(3, 4, 6)
	var ivs @[]@LiveInterval = ivList3(a, b, c)
	var asg @[]RegAssignment = LinearScan(ivs, noClobbers(), mkDesc(mkRegs(2, 100), noClobbers()))
	var spilled int = 0
	for i := 0; i < len(asg); i++ {
		if asg[i].Reg < 0 { spilled = spilled + 1 }
	}
	if spilled != 1 { return "with two registers and three overlapping intervals, exactly one spills" }
	return checkNoOverlapSharing(ivs, asg)
}

// A non-overlapping successor reuses the freed register (expiry).
func TestScanReusesExpiredRegister() testing.TestResult {
	var a @LiveInterval = mkInterval(1, 0, 4)
	var b @LiveInterval = mkInterval(2, 6, 10)
	var ivs @[]@LiveInterval = ivList2(a, b)
	var asg @[]RegAssignment = LinearScan(ivs, noClobbers(), mkDesc(mkRegs(1, 100), noClobbers()))
	if AssignedReg(asg, 1) != 100 || AssignedReg(asg, 2) != 100 {
		return "a non-overlapping successor should reuse the one register"
	}
	return ""
}

// A value live across a clobber cannot use a caller-saved register; with no
// callee-saved pool it must spill.  A value born after the clobber gets a
// register.
func TestScanClobberSpanSpillsWithoutCalleeSaved() testing.TestResult {
	var across @LiveInterval = mkInterval(1, 0, 10) // spans the clobber at 5
	var after @LiveInterval = mkInterval(2, 6, 9) // born after the clobber
	var ivs @[]@LiveInterval = ivList2(across, after)
	var clob @[]int = make_slice(int, 1)
	clob[0] = 5
	var asg @[]RegAssignment = LinearScan(ivs, clob, mkDesc(mkRegs(3, 100), noClobbers()))
	if AssignedReg(asg, 1) >= 0 {
		return "a value live across a clobber must not hold a caller-saved register"
	}
	if AssignedReg(asg, 2) < 0 {
		return "a value born after the clobber may use a caller-saved register"
	}
	return ""
}

// With a callee-saved pool, a clobber-spanning value takes a callee-saved
// register (which the prologue preserves across the call), not a caller-saved
// one.
func TestScanClobberSpanUsesCalleeSaved() testing.TestResult {
	var across @LiveInterval = mkInterval(1, 0, 10)
	var ivs @[]@LiveInterval = make_slice(@LiveInterval, 1)
	ivs[0] = across
	var clob @[]int = make_slice(int, 1)
	clob[0] = 5
	var asg @[]RegAssignment = LinearScan(ivs, clob, mkDesc(mkRegs(2, 100), mkRegs(2, 200)))
	var r int = AssignedReg(asg, 1)
	if r < 200 || r > 201 {
		return "a clobber-spanning value must take a callee-saved register (200/201), not a caller-saved "
				"one"
	}
	return ""
}

// spansClobber: a call argument (dead at the call) and the call result (born
// at the call) do not span it; a value live before and after does.
func TestScanSpansClobberSemantics() testing.TestResult {
	var clob @[]int = make_slice(int, 1)
	clob[0] = 5
	if spansClobber(mkInterval(1, 0, 5), clob) {
		return "an operand last used at the clobber (arg) does not span it"
	}
	if spansClobber(mkInterval(2, 5, 10), clob) {
		return "a value born at the clobber (call result) does not span it"
	}
	if !spansClobber(mkInterval(3, 0, 10), clob) {
		return "a value live before and after the clobber spans it"
	}
	return ""
}

// ClobberPositions finds a call op's linear position.
func TestClobberPositionsFindsCall() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Instr = b.EmitConstInt(1, types.TypInt()) // position 0
	var _ @ir.Instr = b.EmitCall("callee", oneInstr(a), types.TypInt()) // position 1
	b.EmitReturn(makeNoInstrs())

	var lv @LivenessInfo = ComputeLiveness(f, 8)
	var clob @[]int = ClobberPositions(f, lv, mkDesc(noClobbers(), noClobbers()))
	if len(clob) != 1 { return "the one call op is the only clobber position" }
	if clob[0] != 1 { return "the call sits at linear position 1" }
	return ""
}
