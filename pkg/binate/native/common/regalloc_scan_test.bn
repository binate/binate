package "pkg/binate/native/common"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// mkInterval builds a single-range interval [start, end) for id, born at its
// range start (DefPos = start — the common case for a value defined in-block).
// A live-in value whose range is clamped to a block entry earlier than its
// true birth (a parameter: DefPos -1) is modeled with mkLiveInInterval.
func mkInterval(id int, start int, end int) @LiveInterval {
	var iv @LiveInterval = make(LiveInterval)
	iv.ID = id
	var r LiveRange
	r.Start = start
	r.End = end
	iv.Ranges = make_slice(LiveRange, 1)
	iv.Ranges[0] = r
	iv.DefPos = start
	return iv
}

// mkLiveInInterval builds a single-range interval [start, end) for id that is
// live-IN over [start, ...) but was born BEFORE start (DefPos < start, e.g. -1
// for a parameter live-in to the entry block).  This is the shape a param takes
// when its block opens with a clobber: the range Start coincides with the
// clobber position, yet the value truly spans it.
func mkLiveInInterval(id int, start int, end int, defPos int) @LiveInterval {
	var iv @LiveInterval = mkInterval(id, start, end)
	iv.DefPos = defPos
	return iv
}

// mkRegs returns [base, base+1, ..., base+n-1] — opaque physical register
// numbers (the scan never interprets them, so any distinct ints work).
func mkRegs(n int, base int) @[]int {
	var s @[]int = make_slice(int, n)
	for i := 0; i < n; i++ { s[i] = base + i }
	return s
}

// mkDesc builds a register-class descriptor from caller/callee pools.
func mkDesc(caller @[]int, callee @[]int) RegClassDesc {
	var d RegClassDesc
	d.CallerSaved = caller
	d.CalleeSaved = callee
	return d
}

// ivList builds a @[]@LiveInterval from the given intervals (already sorted by
// start by construction in each test).
func ivList2(a @LiveInterval, b @LiveInterval) @[]@LiveInterval {
	var s @[]@LiveInterval = make_slice(@LiveInterval, 2)
	s[0] = a
	s[1] = b
	return s
}

func ivList3(a @LiveInterval, b @LiveInterval, c @LiveInterval) @[]@LiveInterval {
	var s @[]@LiveInterval = make_slice(@LiveInterval, 3)
	s[0] = a
	s[1] = b
	s[2] = c
	return s
}

// extentsOverlap reports whether two [Start,End) extents overlap.
func extentsOverlap(a @LiveInterval, b @LiveInterval) bool {
	return a.Start() < b.End() && b.Start() < a.End()
}

// checkNoOverlapSharing asserts the core invariant: no two intervals whose
// extents overlap are assigned the SAME register.  Returns "" if sound.
func checkNoOverlapSharing(ivs @[]@LiveInterval, asg @[]RegAssignment) @[]char {
	for i := 0; i < len(ivs); i++ {
		for j := i + 1; j < len(ivs); j++ {
			if !extentsOverlap(ivs[i], ivs[j]) { continue }
			var ri int = AssignedReg(asg, ivs[i].ID)
			var rj int = AssignedReg(asg, ivs[j].ID)
			if ri >= 0 && rj >= 0 && ri == rj {
				return "two overlapping intervals were assigned the same register"
			}
		}
	}
	return ""
}

// noClobbers is the empty clobber-position list.
func noClobbers() @[]int {
	var e @[]int
	return e
}

// noCounts is an empty use-count list: every spill cost reads as 0 (spillCostOf
// out-of-range), so eviction never fires and LinearScan reduces to the plain
// spill-the-newcomer behavior these register-pressure tests pin.
func noCounts() @[]int {
	var e @[]int
	return e
}

// noTies is the empty tie list: no coalescing hints and no tie positions, so
// only range-disjoint intervals may share a register.
func noTies() @[]TiePoint {
	var e @[]TiePoint
	return e
}

// mkCounts3 builds an id-indexed use-count slice for ids 1/2/3 (index 0 unused),
// so the eviction tests can make one interval hotter than another.
func mkCounts3(c1 int, c2 int, c3 int) @[]int {
	var s @[]int = make_slice(int, 4)
	s[1] = c1
	s[2] = c2
	s[3] = c3
	return s
}

// spansClobber: a call argument (dead at the call) and the call result (born
// at the call) do not span it; a value live before and after does.
func TestScanSpansClobberSemantics() testing.TestResult {
	var clob @[]int = make_slice(int, 1)
	clob[0] = 5
	if spansClobber(mkInterval(1, 0, 5), clob) {
		return "an operand last used at the clobber (arg) does not span it"
	}
	if spansClobber(mkInterval(2, 5, 10), clob) {
		return "a value born at the clobber (call result) does not span it"
	}
	if !spansClobber(mkInterval(3, 0, 10), clob) {
		return "a value live before and after the clobber spans it"
	}
	return ""
}

// spansClobber must not confuse a live-IN value whose block OPENS with a
// clobber (range Start == clobber position, but born earlier — DefPos < Start)
// with a call result born AT the clobber.  A parameter used after the first
// instruction (a call) genuinely spans it; classifying it non-spanning would
// hand it a caller-saved register the call destroys.  Regression: DataZero's
// `n` param was homed in X7 across the opening make()/rt.Alloc call and read
// back as garbage (a runaway Assembler.Fill on the corrupted width).
func TestScanSpansClobberLiveInAtBlockStart() testing.TestResult {
	var clob @[]int = make_slice(int, 1)
	clob[0] = 0 // the block's FIRST instruction is a clobber
	// A parameter live-in over [0, 5): its range Start is 0 (block entry ==
	// first-instruction position), but it was born before the function body
	// (DefPos -1).  It IS live across the clobber at 0.
	if !spansClobber(mkLiveInInterval(1, 0, 5, -1), clob) {
		return "a live-in value spanning a first-instruction clobber must span it"
	}
	// A value BORN at position 0 (its own def is the clobber — a call result)
	// does NOT span: DefPos == 0 == the clobber.
	if spansClobber(mkInterval(2, 0, 5), clob) {
		return "a value born at the first-instruction clobber does not span it"
	}
	return ""
}

// AllocateRegisters populates the RegMap's home-map and callee-saved
// save-set: a value live across a call is homed in a (callee-saved) register
// and recorded in SavedRegs, and SavedRegsBytes is 16-aligned.
func TestAllocateRegistersPopulatesHomeMap() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Instr = irbuild.EmitConstInt(b, 1, types.TypInt())
	var keep @ir.Instr = irbuild.EmitConstInt(b, 2, types.TypInt()) // live across the call
	var r @ir.Instr = irbuild.EmitCall(b, "callee", oneInstr(a), types.TypInt())
	var s @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, keep, r, types.TypInt())
	irbuild.EmitReturn(b, oneInstr(s))

	var rm @RegMap = nrm()
	// caller-saved empty, callee-saved = fake regs 200..209.
	rm.AllocateRegisters(f, 8, mkDesc(noClobbers(), mkRegs(10, 200)), false)

	var hk int = rm.LookupHome(keep.ID)
	if hk < 200 || hk > 209 {
		return "a value live across the call must be homed in a callee-saved register"
	}
	if rm.LookupHome(s.ID) < 0 { return "the result should be register-allocated" }
	if len(rm.SavedRegs) == 0 {
		return "the used callee-saved register must be recorded for save/restore"
	}
	if !regInSet(hk, rm.SavedRegs) { return "keep's home register must be in SavedRegs" }
	if rm.SavedRegsBytes % 16 != 0 { return "the save area must be 16-byte aligned" }
	if rm.SavedRegsBytes < 8 * len(rm.SavedRegs) {
		return "the save area must fit every saved register"
	}
	return ""
}

// A value never referenced by AllocateRegisters (an id with no interval) has
// no home register.
func TestLookupHomeMissesUnallocated() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Instr = irbuild.EmitConstInt(b, 1, types.TypInt())
	irbuild.EmitReturn(b, oneInstr(a))
	var rm @RegMap = nrm()
	rm.AllocateRegisters(f, 8, mkDesc(noClobbers(), mkRegs(4, 200)), false)
	if rm.LookupHome(9999) != -1 { return "an unknown id has no home register" }
	return ""
}

// LookupHome memoizes an id->index map keyed on len(HomeIDs); UnhomeIDs shrinks
// the table, so a lookup after it must rebuild and miss the unhomed id.
func TestLookupHomeRebuildsAfterUnhome() testing.TestResult {
	var rm @RegMap = nrm()
	rm.HomeIDs = AppendInt(rm.HomeIDs, 3)
	rm.HomeRegs = AppendInt(rm.HomeRegs, 20)
	rm.HomeIDs = AppendInt(rm.HomeIDs, 5)
	rm.HomeRegs = AppendInt(rm.HomeRegs, 21)
	// First lookup builds the memoized index at length 2.
	if rm.LookupHome(3) != 20 { return "id 3 should be homed in reg 20" }
	if rm.LookupHome(5) != 21 { return "id 5 should be homed in reg 21" }
	// UnhomeIDs removes id 3, shrinking HomeIDs, so the index must rebuild.
	rm.UnhomeIDs(unhomeSet(4, 3))
	if rm.LookupHome(3) != -1 { return "unhomed id 3 should now miss" }
	if rm.LookupHome(5) != 21 { return "surviving id 5 should still be homed" }
	return ""
}

// UnhomeIDs force-invalidates the memo, so re-growing HomeIDs back to a
// previously-indexed length with different content still resolves correctly —
// guarding the length key against a shrink-then-regrow mutation sequence (which
// no production path exercises today, but which the length key alone would miss).
func TestLookupHomeNotStaleAfterUnhomeThenReadd() testing.TestResult {
	var rm @RegMap = nrm()
	rm.HomeIDs = AppendInt(rm.HomeIDs, 3)
	rm.HomeRegs = AppendInt(rm.HomeRegs, 20)
	rm.HomeIDs = AppendInt(rm.HomeIDs, 5)
	rm.HomeRegs = AppendInt(rm.HomeRegs, 21)
	// Build the memo at length 2 (HomeIDs = {3, 5}).
	if rm.LookupHome(5) != 21 { return "id 5 should be homed in reg 21" }
	// Shrink to length 1 (drops id 5), then regrow to length 2 with a NEW id.
	rm.UnhomeIDs(unhomeSet(6, 5))
	rm.HomeIDs = AppendInt(rm.HomeIDs, 7)
	rm.HomeRegs = AppendInt(rm.HomeRegs, 22)
	// HomeIDs is back at length 2 but now {3, 7}; without UnhomeIDs resetting the
	// memo key, the stale index (built for {3, 5}) would miss id 7.
	if rm.LookupHome(7) != 22 { return "id 7 should resolve after readd to same length" }
	if rm.LookupHome(5) != -1 { return "removed id 5 should not resolve" }
	if rm.LookupHome(3) != 20 { return "id 3 should still be homed in reg 20" }
	return ""
}

// ClobberPositions finds a call op's linear position.
func TestClobberPositionsFindsCall() testing.TestResult {
	setTarget64()
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Instr = irbuild.EmitConstInt(b, 1, types.TypInt()) // position 0
	var _ @ir.Instr = irbuild.EmitCall(b, "callee", oneInstr(a), types.TypInt()) // position 1
	irbuild.EmitReturn(b, makeNoInstrs())

	var lv @LivenessInfo = ComputeLiveness(f, 8)
	var clob @[]int = ClobberPositions(f, lv, mkDesc(noClobbers(), noClobbers()))
	if len(clob) != 1 { return "the one call op is the only clobber position" }
	if clob[0] != 1 { return "the call sits at linear position 1" }
	return ""
}
