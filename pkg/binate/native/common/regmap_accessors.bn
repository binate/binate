package "pkg/binate/native/common"

// buildIDIndex returns an id-indexed slot array — idx[id] is the FIRST
// position of id in ids (or -1 if absent) — sized to max(ids)+1.  First
// position (not last) reproduces the linear scan it replaces; negative ids
// (e.g. void instructions) are skipped, and a lookup guards id against
// len(idx) so a duplicate/out-of-range id yields -1.
func buildIDIndex(ids @[]int) @[]int {
	var maxID int = -1
	for i := 0; i < len(ids); i++ {
		if ids[i] > maxID { maxID = ids[i] }
	}
	var idx @[]int = make_slice(int, maxID + 1)
	for i := 0; i < len(idx); i++ { idx[i] = -1 }
	for i := 0; i < len(ids); i++ {
		if ids[i] >= 0 && idx[ids[i]] < 0 { idx[ids[i]] = i }
	}
	return idx
}

// idxLookup returns idx[id], or -1 if id is out of idx's range.
func idxLookup(idx @[]int, id int) int {
	if id < 0 || id >= len(idx) { return -1 }
	return idx[id]
}

// allocSlot returns the parallel-array index of id in the alloc tables (or
// -1), (re)building the memoized id->index map iff AllocIDs changed length.
// Shared by LookupAlloc and LookupAllocSize.
func (m @RegMap) allocSlot(id int) int {
	if m.allocIdxLen != len(m.AllocIDs) {
		m.allocIdx = buildIDIndex(m.AllocIDs)
		m.allocIdxLen = len(m.AllocIDs)
	}
	return idxLookup(m.allocIdx, id)
}

// LookupAlloc returns the SP-relative offset of an OP_ALLOC value (or
// of any op that reserves a dedicated data region via AllocIDs —
// notably OP_MAKE_SLICE and aggregate OP_CONST_NIL), or -1 if id has
// no such region.
func (m @RegMap) LookupAlloc(id int) int {
	var k int = m.allocSlot(id)
	if k < 0 { return -1 }
	return m.AllocOffsets[k]
}

// LookupAllocSize returns the byte size of an alloca/data-region slot,
// or -1.
func (m @RegMap) LookupAllocSize(id int) int {
	var k int = m.allocSlot(id)
	if k < 0 { return -1 }
	return m.AllocSizes[k]
}

// LookupSpill returns the SP-relative offset of a spilled SSA value,
// or -1 if not spilled.
func (m @RegMap) LookupSpill(id int) int {
	if m.spillIdxLen != len(m.SpillIDs) {
		m.spillIdx = buildIDIndex(m.SpillIDs)
		m.spillIdxLen = len(m.SpillIDs)
	}
	var k int = idxLookup(m.spillIdx, id)
	if k < 0 { return -1 }
	return m.SpillOffsets[k]
}

// LookupReg returns the arch-specific register holding SSA id, or -1
// if not found.
func (m @RegMap) LookupReg(id int) int {
	for i := 0; i < len(m.IDs); i++ {
		if m.IDs[i] == id { return m.Regs[i] }
	}
	return -1
}

// AssignReg records that SSA id = reg (the arch-specific register
// number) and returns reg. Callers typically use this after picking a
// register from their arch's pool (e.g. the arm64 regPool).
func (m @RegMap) AssignReg(id int, reg int) int {
	// If id is already cached, REPLACE that entry rather than appending a
	// duplicate.  A duplicate is possible under within-block retention: the IR
	// reuses a mutable variable's value id across a load / modify / store, so a
	// reloaded operand (id->old reg) can be redefined here (id->new reg).
	// LookupReg returns the FIRST match, so a stale duplicate would shadow the
	// new register and a later read (or the store) would use the OLD value.
	for i := 0; i < len(m.IDs); i++ {
		if m.IDs[i] == id {
			m.Regs[i] = reg
			return reg
		}
	}
	m.IDs = AppendInt(m.IDs, id)
	m.Regs = AppendInt(m.Regs, reg)
	return reg
}

// ResetRegs clears the register map but leaves alloc/spill tables
// intact — those describe the stable stack frame, not transient live
// values.  It also drops the current-instruction claim set: a reset is
// an invalidation point (block boundary, or a clobber that discards the
// live-value cache), after which no register is claimed.
func (m @RegMap) ResetRegs() {
	var emptyIDs @[]int
	var emptyRegs @[]int
	var emptyUsed @[]int
	m.IDs = emptyIDs
	m.Regs = emptyRegs
	m.CurUsed = emptyUsed
	m.Next = 0
}

// MarkUsed records that arch-register `reg` is claimed by the current
// instruction (an operand read into it, a scratch, or the result), so
// occupancy-aware allocation won't hand it out again — or evict a
// still-needed operand — before the instruction finishes.
func (m @RegMap) MarkUsed(reg int) {
	m.CurUsed = AppendInt(m.CurUsed, reg)
}

// IsUsed reports whether arch-register `reg` is claimed by the current
// instruction.
func (m @RegMap) IsUsed(reg int) bool {
	for i := 0; i < len(m.CurUsed); i++ {
		if m.CurUsed[i] == reg { return true }
	}
	return false
}

// ClearUsed drops the current-instruction claim set, called before each
// instruction.  The retained IDs/Regs value cache is left intact — that
// is what carries a value in a register into the next instruction.
func (m @RegMap) ClearUsed() {
	var empty @[]int
	m.CurUsed = empty
}

// RegHeldBy returns the SSA id currently cached in arch-register `reg`,
// or -1 if `reg` holds no retained value.
func (m @RegMap) RegHeldBy(reg int) int {
	for i := 0; i < len(m.Regs); i++ {
		if m.Regs[i] == reg { return m.IDs[i] }
	}
	return -1
}

// EvictReg drops any id->reg mapping for arch-register `reg`, so a later
// getOperand for that value reloads it from its spill slot instead of
// reading the now-reused register.  Loss-free: every result is stored to
// its slot on definition, so the value is always recoverable there.
func (m @RegMap) EvictReg(reg int) {
	var newIDs @[]int
	var newRegs @[]int
	for i := 0; i < len(m.Regs); i++ {
		if m.Regs[i] != reg {
			newIDs = AppendInt(newIDs, m.IDs[i])
			newRegs = AppendInt(newRegs, m.Regs[i])
		}
	}
	m.IDs = newIDs
	m.Regs = newRegs
}

// NewRegMap returns a freshly-constructed RegMap pre-stamped with the
// caller's CallConv. Every backend should reach RegMap through this
// constructor so PlanFrame and the CC-parameterised helpers always
// see a non-zero NumGpArgRegs.  SretSlotOff is pre-initialised to
// -1 (PlanFrame sets it to >= 0 only for sret-returning functions);
// without this, unit tests that construct a RegMap without running
// PlanFrame would see the default 0, which is a valid stack offset
// and trips sret-detection branches like
// `if rm.SretSlotOff >= 0`.
func NewRegMap(cc CallConv) @RegMap {
	var m @RegMap = make(RegMap)
	m.CC = cc
	m.SretSlotOff = -1
	return m
}

// AppendInt grows an @[]int by one. O(n) copy; fine for the small
// (per-function) sizes here.
func AppendInt(s @[]int, v int) @[]int {
	var out @[]int = make_slice(int, len(s) + 1)
	for i := 0; i < len(s); i++ {
		out[i] = s[i]
	}
	out[len(s)] = v
	return out
}
