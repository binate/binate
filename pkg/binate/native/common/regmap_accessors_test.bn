package "pkg/binate/native/common"

import "pkg/builtins/testing"

// NewRegMap must preserve the caller's CallConv on the returned
// RegMap; PlanFrame and the parameterised helpers both read m.CC and
// would silently misbehave if the constructor dropped it.
func TestNewRegMapStampsCC() testing.TestResult {
	var m @RegMap = NewRegMap(SysV_AMD64())
	if m.CC.NumGpArgRegs != 6 {
		return "NewRegMap should preserve the caller's CallConv"
	}
	if m.CC.InternalSretBytes != 16 {
		return "NewRegMap should preserve all CallConv fields"
	}
	return ""
}

// Fresh-from-NewRegMap RegMap should have empty tables (no stale
// alloc/spill entries from a zero-valued struct trying to look real).
func TestNewRegMapStartsEmpty() testing.TestResult {
	var m @RegMap = NewRegMap(AAPCS64())
	if len(m.IDs) != 0 { return "fresh RegMap should have no live regs" }
	if len(m.AllocIDs) != 0 { return "fresh RegMap should have no allocs" }
	if len(m.SpillIDs) != 0 { return "fresh RegMap should have no spills" }
	if m.FrameSize != 0 { return "fresh RegMap should have zero frame" }
	return ""
}

func TestLookupsReturnMinusOneOnMiss() testing.TestResult {
	var m @RegMap = nrm()
	if m.LookupAlloc(7) != -1 { return "LookupAlloc miss should be -1" }
	if m.LookupAllocSize(7) != -1 { return "LookupAllocSize miss should be -1" }
	if m.LookupSpill(7) != -1 { return "LookupSpill miss should be -1" }
	if m.LookupReg(7) != -1 { return "LookupReg miss should be -1" }
	return ""
}

func TestAssignAndLookupReg() testing.TestResult {
	var m @RegMap = nrm()
	m.AssignReg(3, 42)
	if m.LookupReg(3) != 42 { return "expected 42 after assign" }
	if m.LookupReg(99) != -1 { return "expected -1 for unknown id" }
	return ""
}

// AssignReg must REPLACE an existing entry for an id rather than append a
// duplicate.  Within-block value retention reloads a value (id->old reg) and
// can then redefine the SAME id (id->new reg): the IR reuses a mutable
// variable's value id across a load/modify/store.  LookupReg returns the
// FIRST match, so a stale duplicate would shadow the new register and a later
// read (or the store) would use the pre-modification value.
func TestAssignRegReplacesDuplicateId() testing.TestResult {
	var m @RegMap = nrm()
	m.AssignReg(3, 42) // reloaded operand: id 3 -> reg 42
	m.AssignReg(3, 17) // redefinition: id 3 -> reg 17
	if m.LookupReg(3) != 17 {
		return "AssignReg must replace, not shadow: expected reg 17 for id 3"
	}
	if len(m.IDs) != 1 {
		return "a re-assigned id must not leave a duplicate entry"
	}
	return ""
}

func TestResetClearsRegsButKeepsSlots() testing.TestResult {
	var m @RegMap = nrm()
	m.AllocIDs = AppendInt(m.AllocIDs, 5)
	m.AllocOffsets = AppendInt(m.AllocOffsets, 32)
	m.AllocSizes = AppendInt(m.AllocSizes, 8)
	m.SpillIDs = AppendInt(m.SpillIDs, 6)
	m.SpillOffsets = AppendInt(m.SpillOffsets, 40)
	m.AssignReg(7, 11)
	m.ResetRegs()
	if m.LookupReg(7) != -1 { return "regs should be cleared" }
	if m.LookupAlloc(5) != 32 { return "alloc slot should survive" }
	if m.LookupSpill(6) != 40 { return "spill slot should survive" }
	return ""
}

// LookupSpill memoizes an id->index map keyed on len(SpillIDs); growing the
// table after a lookup must invalidate it so the new id resolves.
func TestLookupSpillRebuildsIndexAfterGrowth() testing.TestResult {
	var m @RegMap = nrm()
	m.SpillIDs = AppendInt(m.SpillIDs, 6)
	m.SpillOffsets = AppendInt(m.SpillOffsets, 40)
	// First lookup builds the memoized index at length 1.
	if m.LookupSpill(6) != 40 { return "spill 6 should resolve to 40" }
	if m.LookupSpill(9) != -1 { return "spill 9 is absent before it is added" }
	// Appending changes len(SpillIDs), so the next lookup rebuilds the index.
	m.SpillIDs = AppendInt(m.SpillIDs, 9)
	m.SpillOffsets = AppendInt(m.SpillOffsets, 48)
	if m.LookupSpill(9) != 48 { return "spill 9 should resolve to 48 after add" }
	if m.LookupSpill(6) != 40 { return "spill 6 should still resolve after growth" }
	return ""
}

// LookupAlloc and LookupAllocSize share one memoized index over AllocIDs; a
// post-lookup append must invalidate it for both.
func TestLookupAllocRebuildsIndexAfterGrowth() testing.TestResult {
	var m @RegMap = nrm()
	m.AllocIDs = AppendInt(m.AllocIDs, 2)
	m.AllocOffsets = AppendInt(m.AllocOffsets, 16)
	m.AllocSizes = AppendInt(m.AllocSizes, 8)
	if m.LookupAlloc(2) != 16 { return "alloc 2 offset should be 16" }
	if m.LookupAllocSize(2) != 8 { return "alloc 2 size should be 8" }
	if m.LookupAlloc(4) != -1 { return "alloc 4 is absent before it is added" }
	m.AllocIDs = AppendInt(m.AllocIDs, 4)
	m.AllocOffsets = AppendInt(m.AllocOffsets, 24)
	m.AllocSizes = AppendInt(m.AllocSizes, 12)
	if m.LookupAlloc(4) != 24 { return "alloc 4 offset should be 24 after add" }
	if m.LookupAllocSize(4) != 12 { return "alloc 4 size should be 12 after add" }
	if m.LookupAlloc(2) != 16 { return "alloc 2 offset should persist after growth" }
	return ""
}
