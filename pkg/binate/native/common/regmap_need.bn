package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// Lookups an emitter cannot proceed without.  Each miss is a frame-planning or
// emitter bug: it is recorded on the assembler as an error naming the operation
// (`what`, which starts with the backend: "native amd64: OP_MAKE_SLICE") and -1
// is returned, so the function fails to compile instead of the instruction
// silently emitting nothing.

// NeedSpill returns value id's spill slot.  Every parameter and every
// value-producing instruction has one (PlanFrame).
func (m @RegMap) NeedSpill(a @asm.Assembler, id int, what *[]readonly char) int {
	var off int = m.LookupSpill(id)
	if off < 0 { setMissingError(a, what, id, " has no spill slot") }
	return off
}

// NeedAlloc returns value id's data region: an OP_ALLOC's storage, or the region
// of a parameter or a value of an aggregate type of nonzero size (PlanFrame).  A
// value of a zero-size aggregate type has none, so a caller that may see one
// checks the size first.
func (m @RegMap) NeedAlloc(a @asm.Assembler, id int, what *[]readonly char) int {
	var off int = m.LookupAlloc(id)
	if off < 0 { setMissingError(a, what, id, " has no data region") }
	return off
}

// NeedStringID returns the ID of the module's string constant holding data.
// The module's string table holds every string an instruction names
// (ir.FinalizeStrings), so a miss is an error.
func NeedStringID(a @asm.Assembler, strs *[]ir.StringConst, data *[]readonly char,
		what *[]readonly char) int {
	var id int = ir.FindStringID(strs, data)
	if id < 0 {
		var out @strings.Builder = strings.NewBuilder()
		out.Write(what)
		out.Write(": the string constant is not in the module's string table")
		a.SetError(out.String())
	}
	return id
}

// SetUnresolvedOperandError records the error for a register read of operand
// id that has no home, register, data region or spill slot -- or, for an id < 0,
// is no SSA value at all (a global reference, which only the value-operand
// resolvers materialize).  prefix names the backend ("native amd64").
func SetUnresolvedOperandError(a @asm.Assembler, prefix *[]readonly char, id int) {
	var out @strings.Builder = strings.NewBuilder()
	out.Write(prefix)
	if id < 0 {
		out.Write(": an operand that is no SSA value (a global reference) read as a register")
	} else {
		out.Write(": operand v")
		stringutils.WriteInt(out, id)
		out.Write(" has no register, data region or spill slot")
	}
	a.SetError(out.String())
}

// setMissingError records "<what>: value v<id><missing>".
func setMissingError(a @asm.Assembler, what *[]readonly char, id int, missing *[]readonly char) {
	var out @strings.Builder = strings.NewBuilder()
	out.Write(what)
	out.Write(": value v")
	stringutils.WriteInt(out, id)
	out.Write(missing)
	a.SetError(out.String())
}
