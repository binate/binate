package "pkg/binate/native/common"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/builtins/testing"

// needHasSubstr reports whether s contains sub.
func needHasSubstr(s *[]readonly char, sub *[]readonly char) bool {
	for i := 0; i + len(sub) <= len(s); i++ {
		var k int = 0
		for k < len(sub) && s[i + k] == sub[k] {
			k++
		}
		if k == len(sub) { return true }
	}
	return false
}

// NeedSpill / NeedAlloc return the slot when it exists, recording nothing; on a
// miss they return -1 and record an error naming the operation and the value.
func TestNeedSpillAndAllocFailLoudOnMiss() testing.TestResult {
	var m @RegMap = nrm()
	m.SpillIDs = AppendInt(m.SpillIDs, 4)
	m.SpillOffsets = AppendInt(m.SpillOffsets, 24)
	m.AllocIDs = AppendInt(m.AllocIDs, 5)
	m.AllocOffsets = AppendInt(m.AllocOffsets, 32)
	m.AllocSizes = AppendInt(m.AllocSizes, 16)
	var a @asm.Assembler = asm.New(8)
	if m.NeedSpill(a, 4, "native test: OP_X") != 24 { return "NeedSpill must return the slot" }
	if m.NeedAlloc(a, 5, "native test: OP_X") != 32 { return "NeedAlloc must return the region" }
	if a.HasError { return "a hit must not record an error" }
	if m.NeedSpill(a, 7, "native test: OP_Y") != -1 { return "a NeedSpill miss must return -1" }
	if !a.HasError || !needHasSubstr(a.ErrorMsg, "native test: OP_Y: value v7 has no spill slot") {
		return "a NeedSpill miss must record an error naming the operation and value"
	}
	var b @asm.Assembler = asm.New(8)
	if m.NeedAlloc(b, 4, "native test: OP_Z") != -1 { return "a NeedAlloc miss must return -1" }
	if !b.HasError || !needHasSubstr(b.ErrorMsg, "native test: OP_Z: value v4 has no data region") {
		return "a NeedAlloc miss must record an error naming the operation and value"
	}
	return ""
}

// NeedStringID finds a string in the module's table, and records an error for
// one that is missing from it.
func TestNeedStringIDFailsLoudOnMiss() testing.TestResult {
	var strs @[]ir.StringConst = make_slice(ir.StringConst, 1)
	strs[0].ID = 3
	strs[0].Data = buf.CopyStr("hello")
	strs[0].Len = 5
	var a @asm.Assembler = asm.New(8)
	if NeedStringID(a, strs, "hello", "native test: a string") != 3 {
		return "NeedStringID must return the constant's ID"
	}
	if a.HasError { return "a hit must not record an error" }
	if NeedStringID(a, strs, "bye", "native test: a string") != -1 {
		return "a NeedStringID miss must return -1"
	}
	if !a.HasError || !needHasSubstr(a.ErrorMsg, "not in the module's string table") {
		return "a NeedStringID miss must record an error"
	}
	return ""
}

// The unresolved-operand error names the value, or says the operand is no SSA
// value (a global reference) for a negative id.
func TestSetUnresolvedOperandErrorNamesTheOperand() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	SetUnresolvedOperandError(a, "native test", 12)
	if !needHasSubstr(a.ErrorMsg, "native test: operand v12 has no register") {
		return "the error must name the backend and the value"
	}
	var b @asm.Assembler = asm.New(8)
	SetUnresolvedOperandError(b, "native test", -1)
	if !needHasSubstr(b.ErrorMsg, "no SSA value") {
		return "a negative id must be reported as no SSA value"
	}
	return ""
}
