// Package fold — backend-neutral SSA-value fold/fusion analyses for the native
// backends.  The analyses return dense id-indexed flag sets marking values a
// backend can fold away (into a condition-coded branch, a `tst`, or an
// immediate operand), so the register allocator leaves them unhomed and the
// emitter skips their standalone emission.  The package also holds the shared
// helpers those folds are decided with — the immediate-operand position and
// range rules each backend's fit predicate and emitters use, and the tst-fold
// operand lookup — so every backend applies the same rules.
package "pkg/binate/native/fold"

import "pkg/binate/ir"
import "pkg/binate/native/common"

// BranchFusedCmps returns a dense id-indexed flag set: element [id] true iff the
// integer comparison value id can fuse into the conditional branch that consumes
// it (single use, that use the condition of the immediately-following OP_BRANCH,
// operand no wider than `wordBytes`).  A backend with flag-branch fusion assigns
// it to m.FusedCmp before AllocateRegisters, passing its target word size (8 for
// aa64/x64, 4 for arm32 — so an arm32 int64 pair-compare is not fused).
func BranchFusedCmps(f @ir.Func, wordBytes int) @[]bool

// ImmOperandConsts returns a dense id-indexed flag set: element [id] true iff
// the OP_CONST_INT value id has at least one use and every use is an operand
// user.Args[argIdx] with fits(user, argIdx) true (a phi input never fits).  The
// predicate owns the per-target encodability — typically CmpImmOperand /
// AddSubImmOperand / LogicImmOperand / ShiftImmOperand for the position and CmpImmFits /
// AddSubImmFits (or a per-target logic-immediate check) for the target range.
// A backend assigns it to m.FoldedImm before AllocateRegisters: a flagged
// constant is left unhomed and skip-emitted, and each consuming emitter takes it
// as an immediate (re-verifying the fit with the same helpers).
func ImmOperandConsts(f @ir.Func, fits *func(@ir.Instr, int) bool) @[]bool

// CmpImmOperand returns (value, isUnsigned, ok) for operand argIdx of `user`:
// ok iff user is an integer compare (OP_EQ/NE/LT/LE/GT/GE), argIdx is 1 (the
// RHS), user.Args[1] is an OP_CONST_INT, and the compared operand's type
// (StripWrappers of Args[0].Typ) is an integer type no wider than wordBytes;
// isUnsigned reports whether that type is unsigned.
func CmpImmOperand(user @ir.Instr, argIdx int, wordBytes int) (int64, bool, bool)

// AddSubImmOperand returns (value, ok) for operand argIdx of `user`: ok iff
// user.Args[argIdx] is an OP_CONST_INT and user is an OP_ADD whose other operand
// is not an OP_CONST_INT, or an OP_SUB with argIdx 1 (the subtrahend) whose
// minuend is not an OP_CONST_INT; user.Typ must be an integer type no wider than
// wordBytes (a float add/sub has no integer immediate form).
func AddSubImmOperand(user @ir.Instr, argIdx int, wordBytes int) (int64, bool)

// LogicImmOperand returns (value, ok) for operand argIdx of `user`: ok iff user
// is an OP_AND, OP_OR or OP_XOR with two operands, argIdx is 0 or 1 (all three
// are commutative), user.Args[argIdx] is an OP_CONST_INT, the other operand is
// not an OP_CONST_INT (one immediate slot), and user.Typ is an integer type no
// wider than wordBytes.  The value is returned uninterpreted: its encodability
// is a per-target check at the op width.
func LogicImmOperand(user @ir.Instr, argIdx int, wordBytes int) (int64, bool)

// MulImmOperand returns (value, ok) for operand argIdx of `user`: ok iff user is
// an OP_MUL with two operands, argIdx is 0 or 1 (multiplication is commutative),
// user.Args[argIdx] is an OP_CONST_INT, the other operand is not an OP_CONST_INT
// (one immediate slot), and user.Typ is an integer type no wider than wordBytes.
// The value is returned uninterpreted: its encodability is a per-target check.
func MulImmOperand(user @ir.Instr, argIdx int, wordBytes int) (int64, bool)

// ShiftImmOperand returns (count, ok) for operand argIdx of `user`: ok iff user
// is an OP_SHL or OP_SHR, argIdx is 1 (the count), user.Args[1] is an
// OP_CONST_INT in [0, width) where width is the bit width of user.Typ, and
// user.Typ is an integer type no wider than wordBytes.
func ShiftImmOperand(user @ir.Instr, argIdx int, wordBytes int) (int64, bool)

// CmpImmFits reports whether v fits a compare immediate with range (posMax,
// negMin): v in [0, posMax] for either signedness, or v in [negMin, -1] for a
// signed compare only (isUns false).
func CmpImmFits(v int64, isUns bool, posMax int64, negMin int64) bool

// AddSubImmFits reports whether v fits an add/sub immediate with range (posMax,
// negMin): v in [0, posMax], or v in [negMin, -1] (the sign-swapped operation).
func AddSubImmFits(v int64, posMax int64, negMin int64) bool

// TstFoldableAnds returns a dense id-indexed flag set: element [id] true iff the
// OP_AND value id (no wider than wordBytes) is used only by an immediately-
// following `== 0` / `!= 0` compare, so the two fold into one flag-setting `tst`.
// A backend assigns it to m.TstFoldedAnd before AllocateRegisters.
func TstFoldableAnds(f @ir.Func, wordBytes int) @[]bool

// TstZeroCompareAndOperand returns the tst-folded OP_AND operand of an
// equality-with-zero compare (the value whose `tst` set Z), or nil if `cmp` is
// not consuming such a fold.  A backend's compare emitter uses it to skip its own
// compare and branch/cset on Z.
func TstZeroCompareAndOperand(m @common.RegMap, cmp @ir.Instr) @ir.Instr
