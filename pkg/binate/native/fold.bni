// Package fold — backend-neutral SSA-value fold/fusion analyses for the native
// backends.  Each returns a dense id-indexed flag set marking values a backend
// can fold away (into a condition-coded branch, or an immediate operand), so the
// register allocator leaves them unhomed and the emitter skips their standalone
// emission.  Split from native/common (file length; these are a distinct concern
// from the RegMap / CallConv / object-emission core).
package "pkg/binate/native/fold"

import "pkg/binate/ir"
import "pkg/binate/native/common"

// BranchFusedCmps returns a dense id-indexed flag set: element [id] true iff the
// integer comparison value id can fuse into the conditional branch that consumes
// it (single use, that use the condition of the immediately-following OP_BRANCH,
// operand no wider than `wordBytes`).  A backend with flag-branch fusion assigns
// it to m.FusedCmp before AllocateRegisters, passing its target word size (8 for
// aa64/x64, 4 for arm32 — so an arm32 int64 pair-compare is not fused).
func BranchFusedCmps(f @ir.Func, wordBytes int) @[]bool

// ImmFoldableConsts returns a dense id-indexed flag set: element [id] true iff
// the OP_CONST_INT value id is used only as an integer compare's RHS and fits the
// compare immediate (value in [0, posMax], or [negMin, -1] for a signed compare).
// A backend with an immediate compare form assigns it to m.FoldedImmConst before
// AllocateRegisters, passing its target immediate range.
func ImmFoldableConsts(f @ir.Func, posMax int64, negMin int64) @[]bool

// AddImmFoldableConsts returns a dense id-indexed flag set: element [id] true iff
// the OP_CONST_INT value id is used only as an ADD/SUB operand that can ride the
// target's add/sub immediate (ADD either operand with a register sibling; SUB the
// subtrahend only; result no wider than wordBytes; value in [0, posMax] or, sign-
// swapped, [negMin, -1]).  A backend with an immediate add/sub form assigns it to
// m.FoldedAddImmConst before AllocateRegisters, passing its target word size and
// immediate range.
func AddImmFoldableConsts(f @ir.Func, wordBytes int, posMax int64, negMin int64) @[]bool

// TstFoldableAnds returns a dense id-indexed flag set: element [id] true iff the
// OP_AND value id (no wider than wordBytes) is used only by an immediately-
// following `== 0` / `!= 0` compare, so the two fold into one flag-setting `tst`.
// A backend assigns it to m.TstFoldedAnd before AllocateRegisters.
func TstFoldableAnds(f @ir.Func, wordBytes int) @[]bool

// TstZeroCompareAndOperand returns the tst-folded OP_AND operand of an
// equality-with-zero compare (the value whose `tst` set Z), or nil if `cmp` is
// not consuming such a fold.  A backend's compare emitter uses it to skip its own
// compare and branch/cset on Z.
func TstZeroCompareAndOperand(m @common.RegMap, cmp @ir.Instr) @ir.Instr
