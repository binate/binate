package "pkg/binate/native/fold"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for AddImmFoldableConsts (add_imm_fold.bn): which OP_CONST_INTs fold into
// an add/sub immediate.  aa64-style range: wordBytes=8, posMax=4095, negMin=-4095.
// Reuses cifParamRef / makeNoParams / makeNoResults from the fold package's other
// test files (same package).

func aifPosMax() int64 { return cast(int64, 4095) }

func aifNegMin() int64 { return cast(int64, 0) - cast(int64, 4095) }

// A small non-negative constant used only as an ADD's RHS folds.
func TestAddImmFoldRhsInRange() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_ADD, cifParamRef(f), c, types.TypInt())
	if !AddImmFoldableConsts(f, 8, aifPosMax(), aifNegMin())[c.ID] {
		return "a small constant used only as an ADD RHS must fold"
	}
	return ""
}

// ADD is commutative — a constant on the LHS (with a register sibling) folds too.
func TestAddImmFoldLhsCommutes() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 8, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_ADD, c, cifParamRef(f), types.TypInt())
	if !AddImmFoldableConsts(f, 8, aifPosMax(), aifNegMin())[c.ID] {
		return "a constant on the ADD LHS must fold (ADD is commutative)"
	}
	return ""
}

// A constant SUBTRAHEND (SUB Args[1]) folds: `x - #v`.
func TestAddImmFoldSubtrahend() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 3, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_SUB, cifParamRef(f), c, types.TypInt())
	if !AddImmFoldableConsts(f, 8, aifPosMax(), aifNegMin())[c.ID] {
		return "a constant SUB subtrahend must fold"
	}
	return ""
}

// A constant MINUEND (SUB Args[0]) does NOT fold — `#v - x` would need a reverse
// subtract the emitter does not form.
func TestAddImmFoldMinuendNotFoldable() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 3, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_SUB, c, cifParamRef(f), types.TypInt())
	if AddImmFoldableConsts(f, 8, aifPosMax(), aifNegMin())[c.ID] {
		return "a constant SUB minuend must NOT fold"
	}
	return ""
}

// A small negative constant folds (the emitter sign-swaps the operation).
func TestAddImmFoldNegative() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 0 - 5, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_ADD, cifParamRef(f), c, types.TypInt())
	if !AddImmFoldableConsts(f, 8, aifPosMax(), aifNegMin())[c.ID] {
		return "a small negative constant must fold (sign-swapped to sub/add)"
	}
	return ""
}

// A constant out of the immediate range does not fold.
func TestAddImmFoldOutOfRangeNotFoldable() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 5000, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_ADD, cifParamRef(f), c, types.TypInt())
	if AddImmFoldableConsts(f, 8, aifPosMax(), aifNegMin())[c.ID] {
		return "a constant above posMax must NOT fold"
	}
	return ""
}

// A constant used by a non-add/sub op (here OP_MUL) needs a real register — not
// foldable, even though it also appears in a foldable ADD.
func TestAddImmFoldNonAddUseNotFoldable() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 4, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_ADD, cifParamRef(f), c, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_MUL, cifParamRef(f), c, types.TypInt())
	if AddImmFoldableConsts(f, 8, aifPosMax(), aifNegMin())[c.ID] {
		return "a constant with a non-add/sub use must NOT fold"
	}
	return ""
}

// A constant also used as a compare operand does NOT fold here — a compare is not
// an add/sub, so that use disqualifies it (it would ride the FoldedImmConst path
// instead, which requires ALL uses to be compares).
func TestAddImmFoldCompareUseNotFoldable() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 2, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_ADD, cifParamRef(f), c, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_LT, cifParamRef(f), c, types.TypBool())
	if AddImmFoldableConsts(f, 8, aifPosMax(), aifNegMin())[c.ID] {
		return "a constant with a mixed add + compare use must NOT fold here"
	}
	return ""
}

// A const+const ADD marks NEITHER operand foldable — only one can ride the
// immediate, and the other must supply a register.  (iropt normally folds such an
// add away; this guards the fallback.)
func TestAddImmFoldConstPlusConstNotFoldable() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c1 @ir.Instr = irbuild.EmitConstInt(entry, 3, types.TypInt())
	var c2 @ir.Instr = irbuild.EmitConstInt(entry, 4, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_ADD, c1, c2, types.TypInt())
	var flags @[]bool = AddImmFoldableConsts(f, 8, aifPosMax(), aifNegMin())
	if flags[c1.ID] || flags[c2.ID] {
		return "neither operand of a const+const ADD may fold"
	}
	return ""
}

// A wider-than-word add/sub (int64 with wordBytes=4, as on arm32) does not take a
// register immediate — its constant operand does not fold; with a wide-enough word
// (wordBytes=8, as on aa64/x64) the same const folds.
func TestAddImmFoldWidthGuard() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var p @ir.Param = ir.NewParam(f, "x", types.TypInt64())
	var c @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt64())
	_ = irbuild.EmitBinop(entry, iropcode.OP_ADD, ir.NewParamRef(f, p), c, types.TypInt64())
	if AddImmFoldableConsts(f, 4, aifPosMax(), aifNegMin())[c.ID] {
		return "an int64 add with wordBytes=4 must NOT fold (multi-word)"
	}
	if !AddImmFoldableConsts(f, 8, aifPosMax(), aifNegMin())[c.ID] {
		return "an int64 add with wordBytes=8 must fold (single word)"
	}
	return ""
}
