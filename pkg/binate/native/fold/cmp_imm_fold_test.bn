package "pkg/binate/native/fold"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for ImmFoldableConsts (common_cmp_imm_fold.bn): which OP_CONST_INTs fold
// into a compare immediate.  aa64-style range: posMax=4095, negMin=-4095.

func cifPosMax() int64 { return cast(int64, 4095) }

func cifNegMin() int64 { return cast(int64, 0) - cast(int64, 4095) }

// cifParamRef makes a non-const int value (an OP_PARAM) to use as a compare LHS.
func cifParamRef(f @ir.Func) @ir.Instr {
	var p @ir.Param = ir.NewParam(f, "x", types.TypInt())
	return ir.NewParamRef(f, p)
}

// A small non-negative constant used only as a signed compare's RHS folds.
func TestImmFoldRhsInRange() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 42, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_EQ, cifParamRef(f), c, types.TypBool())
	if !ImmFoldableConsts(f, cifPosMax(), cifNegMin())[c.ID] {
		return "a small constant used only as a compare RHS must fold"
	}
	return ""
}

// A constant on the compare's LHS is the register operand, not an immediate —
// not foldable.
func TestImmFoldLhsNotFoldable() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 42, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_EQ, c, cifParamRef(f), types.TypBool())
	if ImmFoldableConsts(f, cifPosMax(), cifNegMin())[c.ID] {
		return "a constant on the compare LHS must NOT fold"
	}
	return ""
}

// A constant out of the immediate range does not fold.
func TestImmFoldOutOfRangeNotFoldable() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 5000, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_LT, cifParamRef(f), c, types.TypBool())
	if ImmFoldableConsts(f, cifPosMax(), cifNegMin())[c.ID] {
		return "a constant above posMax must NOT fold (would need a shifted/2-step imm)"
	}
	return ""
}

// A constant used by a non-compare op (here OP_ADD) needs a real register — not
// foldable, even if also compared.
func TestImmFoldNonCompareUseNotFoldable() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 7, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_LT, cifParamRef(f), c, types.TypBool())
	_ = irbuild.EmitBinop(entry, iropcode.OP_ADD, cifParamRef(f), c, types.TypInt())
	if ImmFoldableConsts(f, cifPosMax(), cifNegMin())[c.ID] {
		return "a constant with a non-compare use must NOT fold"
	}
	return ""
}

// A small negative constant folds in a SIGNED compare (via CMN) but NOT in an
// unsigned compare (where it denotes a huge unsigned value).
func TestImmFoldNegativeSignedOnly() testing.TestResult {
	var fs @ir.Func = ir.NewFunc("", "s", makeNoParams(), makeNoResults())
	var es @ir.Block = ir.AddBlock(fs, "entry")
	var cs @ir.Instr = irbuild.EmitConstInt(es, 0 - 5, types.TypInt())
	_ = irbuild.EmitBinop(es, iropcode.OP_LT, cifParamRef(fs), cs, types.TypBool())
	if !ImmFoldableConsts(fs, cifPosMax(), cifNegMin())[cs.ID] {
		return "a small negative constant must fold in a signed compare (CMN)"
	}

	var fu @ir.Func = ir.NewFunc("", "u", makeNoParams(), makeNoResults())
	var eu @ir.Block = ir.AddBlock(fu, "entry")
	var cu @ir.Instr = irbuild.EmitConstInt(eu, 0 - 5, types.TypUint64())
	var up @ir.Param = ir.NewParam(fu, "x", types.TypUint64())
	_ = irbuild.EmitBinop(eu, iropcode.OP_LT, ir.NewParamRef(fu, up), cu, types.TypBool())
	if ImmFoldableConsts(fu, cifPosMax(), cifNegMin())[cu.ID] {
		return "a negative constant must NOT fold in an unsigned compare"
	}
	return ""
}
