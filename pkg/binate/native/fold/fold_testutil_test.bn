package "pkg/binate/native/fold"

import "pkg/binate/ir"
import "pkg/binate/types"

// Shared test helpers for the fold-analysis tests: empty param / result lists
// for ir.NewFunc (the analyses only walk blocks/instructions, never signatures).

func makeNoParams() @[]@ir.Param {
	var p @[]@ir.Param
	return p
}

func makeNoResults() @[]@types.Type {
	var r @[]@types.Type
	return r
}
