package "pkg/binate/native/fold"

import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for MulImmOperand (imm_positions.bn).

// A constant multiplier is an immediate position on either side: multiplication
// is commutative, so the other operand supplies the register.
func TestMulImmOperandEitherSide() testing.TestResult {
	var v int64
	var ok bool
	v, ok = MulImmOperand(ipBinop(iropcode.OP_MUL, types.TypInt(), types.TypInt(), false, true, 7), 1,
			8)
	if !ok || v != cast(int64, 7) { return "x * 7 must be a multiply-immediate position" }
	v, ok = MulImmOperand(
			ipBinop(iropcode.OP_MUL, types.TypUint32(), types.TypUint32(), true, false, 9), 0, 8)
	if !ok || v != cast(int64, 9) { return "9 * x must be a multiply-immediate position" }
	return ""
}

// The register operand, a const-const multiply, a non-multiply, a float result
// and a result wider than the word are not immediate positions.
func TestMulImmOperandRejects() testing.TestResult {
	var ok bool
	_, ok = MulImmOperand(ipBinop(iropcode.OP_MUL, types.TypInt(), types.TypInt(), false, true, 7), 0,
			8)
	if ok { return "the register operand must not be an immediate position" }
	_, ok = MulImmOperand(ipBinop(iropcode.OP_MUL, types.TypInt(), types.TypInt(), true, true, 7), 1,
			8)
	if ok { return "a const-const multiply must not fold" }
	_, ok = MulImmOperand(ipBinop(iropcode.OP_DIV, types.TypInt(), types.TypInt(), false, true, 7), 1,
			8)
	if ok { return "a divide is not a multiply-immediate position" }
	_, ok = MulImmOperand(
			ipBinop(iropcode.OP_MUL, types.TypFloat64(), types.TypFloat64(), false, true, 2), 1, 8)
	if ok { return "a float multiply has no integer immediate" }
	_, ok = MulImmOperand(ipBinop(iropcode.OP_MUL, types.TypInt64(), types.TypInt64(), false, true, 3),
			1, 4)
	if ok { return "an int64 multiply on a 4-byte word must not fold" }
	return ""
}
