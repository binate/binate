package "pkg/binate/native/fold"

import "pkg/binate/ir"
import "pkg/binate/iropcode"

// ImmOperandConsts returns a dense ID-indexed flag set (sized to f.NextID):
// element [id] is true iff the OP_CONST_INT value id has at least one use and
// EVERY use is an instruction operand user.Args[argIdx] for which
// fits(user, argIdx) is true — so the constant rides the immediate operand of
// each of its users and is never needed in a register.
//
// The predicate owns the per-target encodability: it combines a structural
// position rule (which opcodes and operand indices take an immediate — see
// CmpImmOperand, AddSubImmOperand and LogicImmOperand) with the target's
// immediate range or encoding for that position (CmpImmFits, AddSubImmFits, or
// the target's own logic-immediate check at the op width).  Each use is judged
// on its own, so a constant used twice by one instruction must fit at both
// positions, and a constant whose uses span kinds (a compare RHS and an AND
// operand, say) folds when every one of those uses fits.  A use as a phi input never fits: a phi
// moves its incoming value along a block edge and has no immediate operand.  A
// constant with no uses is not marked (nothing would consume the immediate).
//
// A backend assigns the result to m.FoldedImm BEFORE AllocateRegisters.  The
// allocator then leaves a flagged constant unhomed, the backend's dispatch skips
// the constant's standalone emission, and every consuming emitter takes the
// value as an immediate — re-verifying the fit with the same position and range
// helpers its predicate uses, so the analysis and the emitters cannot disagree
// about which constants are never materialized.  Only f.Blocks is walked: the
// VM-only fault pads (f.FaultPads) are never lowered by a native backend.
func ImmOperandConsts(f @ir.Func, fits *func(@ir.Instr, int) bool) @[]bool {
	var n int = f.NextID
	var isConst @[]bool = make_slice(bool, n)
	var used @[]bool = make_slice(bool, n)
	var disq @[]bool = make_slice(bool, n)

	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.Op == iropcode.OP_CONST_INT && ins.ID >= 0 && ins.ID < n {
				isConst[ins.ID] = true
			}
			for ai := 0; ai < len(ins.Args); ai++ {
				var arg @ir.Instr = ins.Args[ai]
				if !isConstIntInRange(arg, n) {
					continue
				}
				used[arg.ID] = true
				if !fits(ins, ai) {
					disq[arg.ID] = true
				}
			}
			for pi := 0; pi < len(ins.Phis); pi++ {
				var v *ir.Instr = ins.Phis[pi].Val
				if !isConstIntInRange(v, n) {
					continue
				}
				used[v.ID] = true
				disq[v.ID] = true
			}
		}
	}

	var flags @[]bool = make_slice(bool, n)
	for id := 0; id < n; id++ {
		flags[id] = isConst[id] && used[id] && !disq[id]
	}
	return flags
}

// isConstIntInRange reports whether v is an OP_CONST_INT whose id indexes a flag
// set of length n.
func isConstIntInRange(v *ir.Instr, n int) bool {
	return v != nil && v.Op == iropcode.OP_CONST_INT && v.ID >= 0 && v.ID < n
}
