package "pkg/binate/native/fold"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for ImmOperandConsts (imm_operand.bn): the use-walk mechanics, driven by
// small test predicates, plus one aa64-style predicate built from the shared
// position/range helpers.

// ioParamRef makes a non-const value of type t (an OP_PARAM reference).
func ioParamRef(f @ir.Func, name @[]char, t @types.Type) @ir.Instr {
	var p @ir.Param = ir.NewParam(f, name, t)
	return ir.NewParamRef(f, p)
}

// ioFitsAll accepts every operand position.
func ioFitsAll(user @ir.Instr, argIdx int) bool {
	return true
}

// ioFitsAddOnly accepts every operand of an OP_ADD and nothing else.
func ioFitsAddOnly(user @ir.Instr, argIdx int) bool {
	return user.Op == iropcode.OP_ADD
}

// ioFitsArg1Only accepts operand index 1 of any instruction and nothing else.
func ioFitsArg1Only(user @ir.Instr, argIdx int) bool {
	return argIdx == 1
}

// ioAa64Fits is an aa64-style predicate: a compare RHS or an add/sub operand in a
// 64-bit word with a 12-bit immediate (0..4095, or -4095..-1 where allowed).
func ioAa64Fits(user @ir.Instr, argIdx int) bool {
	var posMax int64 = 4095
	var negMin int64 = 0 - 4095
	var v int64
	var isUns bool
	var ok bool
	v, isUns, ok = CmpImmOperand(user, argIdx, 8)
	if ok {
		return CmpImmFits(v, isUns, posMax, negMin)
	}
	v, ok = AddSubImmOperand(user, argIdx, 8)
	if ok {
		return AddSubImmFits(v, posMax, negMin)
	}
	return false
}

// A constant whose every use fits is marked; the length of the set is f.NextID.
func TestImmOperandAllUsesFit() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 7, types.TypInt())
	var x @ir.Instr = ioParamRef(f, "x", types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_ADD, x, c, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_MUL, x, c, types.TypInt())
	var flags @[]bool = ImmOperandConsts(f, ioFitsAll)
	if len(flags) != f.NextID { return "the flag set must be sized to f.NextID" }
	if !flags[c.ID] { return "a constant whose every use fits must be marked" }
	return ""
}

// A constant that fits at one use but not at another is not marked; a constant
// with only the fitting use is (control).
func TestImmOperandOneUseMisfits() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 4, types.TypInt())
	var d @ir.Instr = irbuild.EmitConstInt(entry, 5, types.TypInt())
	var x @ir.Instr = ioParamRef(f, "x", types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_ADD, x, c, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_MUL, x, c, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_ADD, x, d, types.TypInt())
	var flags @[]bool = ImmOperandConsts(f, ioFitsAddOnly)
	if flags[c.ID] { return "a constant with one non-fitting use must NOT be marked" }
	if !flags[d.ID] { return "a constant used only where it fits must be marked" }
	return ""
}

// A constant used as a phi input is not marked, even under an accept-everything
// predicate: a phi has no immediate operand.
func TestImmOperandPhiUseNotMarked() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var join @ir.Block = ir.AddBlock(f, "join")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	var x @ir.Instr = ioParamRef(f, "x", types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_ADD, x, c, types.TypInt())
	irbuild.EmitJump(entry, join)
	var e ir.PhiEntry
	e.Block = entry
	e.Val = c
	var es @[]ir.PhiEntry = make_slice(ir.PhiEntry, 1)
	es[0] = e
	_ = irbuild.EmitPhi(join, types.TypInt(), es)
	if ImmOperandConsts(f, ioFitsAll)[c.ID] {
		return "a constant used as a phi input must NOT be marked"
	}
	return ""
}

// A constant with no uses is not marked: nothing would consume the immediate.
func TestImmOperandNoUsesNotMarked() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 3, types.TypInt())
	if ImmOperandConsts(f, ioFitsAll)[c.ID] {
		return "a constant with no uses must NOT be marked"
	}
	return ""
}

// The same constant used twice by one instruction is checked at each position:
// it is not marked when only one position fits, and is marked when both do.
func TestImmOperandSameConstTwiceInOneInstr() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 2, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_MUL, c, c, types.TypInt())
	if ImmOperandConsts(f, ioFitsArg1Only)[c.ID] {
		return "a constant fitting only one of its two positions must NOT be marked"
	}
	if !ImmOperandConsts(f, ioFitsAll)[c.ID] {
		return "a constant fitting both of its positions must be marked"
	}
	return ""
}

// Non-constant values (a param reference, an ADD result, a float constant) are
// never marked, whatever the predicate says about their uses.
func TestImmOperandNonConstNeverMarked() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = ioParamRef(f, "x", types.TypInt())
	var sum @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, x, x, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_ADD, sum, x, types.TypInt())
	var fc @ir.Instr = irbuild.EmitConstFloat(entry, "1.5", types.TypFloat64())
	var fy @ir.Instr = ioParamRef(f, "y", types.TypFloat64())
	_ = irbuild.EmitBinop(entry, iropcode.OP_ADD, fy, fc, types.TypFloat64())
	var flags @[]bool = ImmOperandConsts(f, ioFitsAll)
	if x.ID >= 0 && x.ID < len(flags) && flags[x.ID] { return "a param ref must NOT be marked" }
	if flags[sum.ID] { return "an ADD result must NOT be marked" }
	if flags[fc.ID] { return "a float constant must NOT be marked" }
	return ""
}

// With a target predicate built from the shared helpers, a constant whose uses
// span kinds (a compare RHS and an ADD operand) is marked when every use fits,
// and not marked when one use (here a compare LHS) does not.
func TestImmOperandMixedKindsFold() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(entry, 9, types.TypInt())
	var d @ir.Instr = irbuild.EmitConstInt(entry, 9, types.TypInt())
	var x @ir.Instr = ioParamRef(f, "x", types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_LT, x, c, types.TypBool())
	_ = irbuild.EmitBinop(entry, iropcode.OP_ADD, x, c, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_SUB, x, d, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_LT, d, x, types.TypBool())
	var flags @[]bool = ImmOperandConsts(f, ioAa64Fits)
	if !flags[c.ID] { return "a compare-RHS + ADD-operand constant must be marked" }
	if flags[d.ID] { return "a constant also used as a compare LHS must NOT be marked" }
	return ""
}
