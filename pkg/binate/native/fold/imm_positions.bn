package "pkg/binate/native/fold"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"

// CmpImmOperand reports whether operand argIdx of `user` is a constant in a
// compare-immediate position, returning (value, isUnsigned, ok).  ok is true iff:
//   - user is an integer compare (OP_EQ/NE/LT/LE/GT/GE) with two operands;
//   - argIdx is 1 — the RHS.  The LHS is the compare's register operand, so a
//     constant there cannot ride the immediate;
//   - user.Args[1] is an OP_CONST_INT;
//   - the compared operand's type (StripWrappers of Args[0].Typ) is an integer
//     type no wider than wordBytes.  A float compare lowers to an FP compare with
//     no integer immediate, and a compare wider than the target word (arm32's
//     int64 register-pair compare) is a multi-word sequence with no single
//     immediate form.
// isUnsigned is the compared type's signedness: a negative constant in an
// unsigned compare denotes a near-2^N value, not a small negative, which
// CmpImmFits needs to tell apart.  A backend's fold predicate and its compare
// emitter both call this (with the target's word size) and then CmpImmFits with
// the target's immediate range, so the two agree on every folded compare.
func CmpImmOperand(user @ir.Instr, argIdx int, wordBytes int) (int64, bool, bool) {
	var zero int64 = 0
	if user == nil || !isIntCompareOp(user.Op) || len(user.Args) != 2 || argIdx != 1 {
		return zero, false, false
	}
	var lhs @ir.Instr = user.Args[0]
	var rhs @ir.Instr = user.Args[1]
	if lhs == nil || rhs == nil || rhs.Op != iropcode.OP_CONST_INT {
		return zero, false, false
	}
	var lt @types.Type = types.StripWrappers(lhs.Typ)
	if lt == nil || !lt.IsInteger() || lt.SizeOf() > wordBytes {
		return zero, false, false
	}
	return rhs.IntVal, !lt.Signed, true
}

// AddSubImmOperand reports whether operand argIdx of `user` is a constant in an
// add/sub-immediate position, returning (value, ok).  ok is true iff
// user.Args[argIdx] is an OP_CONST_INT and either:
//   - user is an OP_ADD whose other operand is not an OP_CONST_INT.  ADD is
//     commutative, so a constant in either operand rides the immediate while the
//     other operand supplies the register.  A const+const ADD marks neither: the
//     instruction has one immediate slot and one operand must be a register, so
//     the register path materializes both;
//   - user is an OP_SUB, argIdx is 1 (the subtrahend: `x - #v`), and the minuend
//     is not an OP_CONST_INT.  A constant minuend (`#v - x`) needs a reverse
//     subtract that the emitters do not form.
// In both cases user.Typ must be non-nil and no wider than wordBytes: a wider
// add/sub (arm32's int64 register-pair ADD/SUB) is a multi-word sequence with no
// single register immediate, and a nil type has no known width.  The value's
// sign does not matter here: add/sub immediates are signedness-agnostic, and a
// small negative rides the sign-swapped operation (x + (-k) is x - k) — see
// AddSubImmFits.  A backend's fold predicate and its add/sub emitter both call
// this and then AddSubImmFits with the target's range, so the two agree.
func AddSubImmOperand(user @ir.Instr, argIdx int, wordBytes int) (int64, bool) {
	var zero int64 = 0
	if user == nil || len(user.Args) != 2 || argIdx < 0 || argIdx > 1 {
		return zero, false
	}
	if user.Op != iropcode.OP_ADD && !(user.Op == iropcode.OP_SUB && argIdx == 1) {
		return zero, false
	}
	var arg @ir.Instr = user.Args[argIdx]
	if arg == nil || arg.Op != iropcode.OP_CONST_INT {
		return zero, false
	}
	var other @ir.Instr = user.Args[1 - argIdx]
	if other != nil && other.Op == iropcode.OP_CONST_INT {
		return zero, false
	}
	var ut @types.Type = types.StripWrappers(user.Typ)
	if ut == nil || !ut.IsInteger() || ut.SizeOf() > wordBytes {
		return zero, false
	}
	return arg.IntVal, true
}

// LogicImmOperand reports whether operand argIdx of `user` is a constant in a
// bitwise-logic-immediate position, returning (value, ok).  ok is true iff:
//   - user is an OP_AND, OP_OR or OP_XOR with two operands and argIdx is 0 or 1.
//     All three are commutative, so a constant in either operand rides the
//     immediate while the other operand supplies the register;
//   - user.Args[argIdx] is an OP_CONST_INT and the other operand is not.  The
//     instruction has a single immediate slot, so a const-const op marks
//     neither: one operand must be a register, so the register path
//     materializes both;
//   - user.Typ (StripWrappers) is an integer type no wider than wordBytes.  A
//     wider op (arm32's int64 register-pair AND/OR/XOR) is a multi-word sequence
//     with no single register immediate, and a nil type has no known width.
// The boolean OP_LAND / OP_LOR are distinct opcodes and never match.  The value
// is the constant's IntVal, uninterpreted: logic immediates are signedness-
// agnostic, and whether a value is encodable is entirely per-target and depends
// on the op width (an aa64 bitmask immediate, an arm32 rotated imm8, an x64
// immediate sign-extended to the op width), so there is no shared range helper.
// A backend's fold predicate and its logic emitter both call this and then the
// same per-target encodability check, so the two agree on every folded op.
func LogicImmOperand(user @ir.Instr, argIdx int, wordBytes int) (int64, bool) {
	var zero int64 = 0
	if user == nil || len(user.Args) != 2 || argIdx < 0 || argIdx > 1 {
		return zero, false
	}
	if user.Op != iropcode.OP_AND && user.Op != iropcode.OP_OR && user.Op != iropcode.OP_XOR {
		return zero, false
	}
	var arg @ir.Instr = user.Args[argIdx]
	if arg == nil || arg.Op != iropcode.OP_CONST_INT {
		return zero, false
	}
	var other @ir.Instr = user.Args[1 - argIdx]
	if other != nil && other.Op == iropcode.OP_CONST_INT {
		return zero, false
	}
	var ut @types.Type = types.StripWrappers(user.Typ)
	if ut == nil || !ut.IsInteger() || ut.SizeOf() > wordBytes {
		return zero, false
	}
	return arg.IntVal, true
}

// ShiftImmOperand reports whether operand argIdx of `user` is a shift count that
// can ride a shift-by-immediate, returning (count, ok).  ok is true iff:
//   - user is an OP_SHL or OP_SHR with two operands and argIdx is 1 — the count.
//     The shifted value is never an immediate position;
//   - user.Args[1] is an OP_CONST_INT whose value is in [0, width), where width
//     is the bit width of user.Typ (the shifted value's type).  For a count in
//     that range the hardware shift-by-immediate computes exactly the spec'd
//     shift; a count at or above the width (defined as 0 or a sign-fill, not
//     the hardware's masking) or a negative one is left to the register path;
//   - user.Typ is an integer type no wider than wordBytes: a wider shift (arm32's
//     int64 register-pair shift) is a multi-instruction sequence.
// A backend's fold predicate and its shift emitter both call this, so the two
// agree on every folded count.
func ShiftImmOperand(user @ir.Instr, argIdx int, wordBytes int) (int64, bool) {
	var zero int64 = 0
	if user == nil || len(user.Args) != 2 || argIdx != 1 {
		return zero, false
	}
	if user.Op != iropcode.OP_SHL && user.Op != iropcode.OP_SHR {
		return zero, false
	}
	var arg @ir.Instr = user.Args[1]
	if arg == nil || arg.Op != iropcode.OP_CONST_INT {
		return zero, false
	}
	var ut @types.Type = types.StripWrappers(user.Typ)
	if ut == nil || !ut.IsInteger() || ut.SizeOf() > wordBytes {
		return zero, false
	}
	var width int64 = cast(int64, ut.SizeOf() * 8)
	if arg.IntVal < zero || arg.IntVal >= width {
		return zero, false
	}
	return arg.IntVal, true
}

// CmpImmFits reports whether constant v fits a compare immediate whose range is
// (posMax, negMin): a value in 0..posMax rides `cmp #v` for either signedness; a
// small negative value in negMin..-1 rides `cmn #-v` only for a SIGNED compare
// (isUns false) — in an unsigned compare a negative constant denotes a near-2^N
// value that the small immediate cannot carry.
func CmpImmFits(v int64, isUns bool, posMax int64, negMin int64) bool {
	var zero int64 = 0
	if v >= zero && v <= posMax {
		return true
	}
	if !isUns && v < zero && v >= negMin {
		return true
	}
	return false
}

// AddSubImmFits reports whether constant v fits an add/sub immediate whose range
// is (posMax, negMin): a value in 0..posMax rides `add`/`sub #v`; a small
// negative value in negMin..-1 rides the sign-swapped `sub`/`add #-v`.  There is
// no signed/unsigned split: two's-complement add and subtract are the same
// operation under either interpretation.
func AddSubImmFits(v int64, posMax int64, negMin int64) bool {
	var zero int64 = 0
	if v >= zero && v <= posMax {
		return true
	}
	if v < zero && v >= negMin {
		return true
	}
	return false
}
