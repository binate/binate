package "pkg/binate/native/fold"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the shared immediate-position and range helpers (imm_positions.bn):
// CmpImmOperand, AddSubImmOperand, LogicImmOperand, CmpImmFits, AddSubImmFits.

// ipBinop builds `lhs OP rhs` of result type rt in a fresh function, where lhs /
// rhs are either a constant (val) or a param of type ot, per lhsConst / rhsConst.
func ipBinop(op int, ot @types.Type, rt @types.Type, lhsConst bool, rhsConst bool,
		val int) @ir.Instr {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var lhs @ir.Instr = ioParamRef(f, "a", ot)
	if lhsConst { lhs = irbuild.EmitConstInt(entry, val, ot) }
	var rhs @ir.Instr = ioParamRef(f, "b", ot)
	if rhsConst { rhs = irbuild.EmitConstInt(entry, val, ot) }
	return irbuild.EmitBinop(entry, op, lhs, rhs, rt)
}

// Every integer compare op accepts a constant RHS, returning its value and the
// compared type's signedness.
func TestCmpImmOperandRhsAllOps() testing.TestResult {
	var ops @[]int = make_slice(int, 6)
	ops[0] = iropcode.OP_EQ
	ops[1] = iropcode.OP_NE
	ops[2] = iropcode.OP_LT
	ops[3] = iropcode.OP_LE
	ops[4] = iropcode.OP_GT
	ops[5] = iropcode.OP_GE
	for i := 0; i < len(ops); i++ {
		var cmp @ir.Instr = ipBinop(ops[i], types.TypInt(), types.TypBool(), false, true, 42)
		var v int64
		var isUns bool
		var ok bool
		v, isUns, ok = CmpImmOperand(cmp, 1, 8)
		if !ok { return "an integer compare's constant RHS must be an immediate position" }
		if v != cast(int64, 42) { return "CmpImmOperand must return the constant's value" }
		if isUns { return "a compare of int must report signed" }
	}
	return ""
}

// The unsigned flag follows the compared operand's type.
func TestCmpImmOperandUnsignedFlag() testing.TestResult {
	var cmp @ir.Instr = ipBinop(iropcode.OP_LT, types.TypUint64(), types.TypBool(), false, true, 5)
	var isUns bool
	var ok bool
	_, isUns, ok = CmpImmOperand(cmp, 1, 8)
	if !ok || !isUns { return "a uint64 compare RHS must fold and report unsigned" }
	var c32 @ir.Instr = ipBinop(iropcode.OP_LT, types.TypUint32(), types.TypBool(), false, true, 5)
	_, isUns, ok = CmpImmOperand(c32, 1, 4)
	if !ok || !isUns { return "a uint32 compare RHS at wordBytes 4 must fold, unsigned" }
	return ""
}

// The LHS is the compare's register operand: argIdx 0 is never an immediate
// position, whether or not Args[0] is a constant.
func TestCmpImmOperandLhsRejected() testing.TestResult {
	var cmpL @ir.Instr = ipBinop(iropcode.OP_EQ, types.TypInt(), types.TypBool(), true, false, 3)
	var ok bool
	_, _, ok = CmpImmOperand(cmpL, 0, 8)
	if ok { return "a constant compare LHS must not be an immediate position" }
	var cmpR @ir.Instr = ipBinop(iropcode.OP_EQ, types.TypInt(), types.TypBool(), false, true, 3)
	_, _, ok = CmpImmOperand(cmpR, 0, 8)
	if ok { return "argIdx 0 must not be an immediate position" }
	return ""
}

// A non-constant RHS, or a non-compare user, is not a compare-immediate position.
func TestCmpImmOperandNonConstOrNonCompare() testing.TestResult {
	var cmp @ir.Instr = ipBinop(iropcode.OP_LT, types.TypInt(), types.TypBool(), false, false, 0)
	var ok bool
	_, _, ok = CmpImmOperand(cmp, 1, 8)
	if ok { return "a non-constant compare RHS must not be an immediate position" }
	var add @ir.Instr = ipBinop(iropcode.OP_ADD, types.TypInt(), types.TypInt(), false, true, 3)
	_, _, ok = CmpImmOperand(add, 1, 8)
	if ok { return "an ADD must not be a compare-immediate position" }
	return ""
}

// A float compare has no integer immediate: neither an OP_CONST_FLOAT RHS nor an
// OP_CONST_INT RHS against a float LHS is a compare-immediate position.
func TestCmpImmOperandFloatRejected() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = ioParamRef(f, "x", types.TypFloat64())
	var fc @ir.Instr = irbuild.EmitConstFloat(entry, "1.0", types.TypFloat64())
	var ic @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	var cmpF @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_LT, x, fc, types.TypBool())
	var cmpI @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_LT, x, ic, types.TypBool())
	var ok bool
	_, _, ok = CmpImmOperand(cmpF, 1, 8)
	if ok { return "a float constant RHS must not be a compare-immediate position" }
	_, _, ok = CmpImmOperand(cmpI, 1, 8)
	if ok { return "a compare with a float LHS must not be a compare-immediate position" }
	return ""
}

// A compared operand wider than the target word (int64 at wordBytes 4, as on
// arm32) has no single immediate form; at wordBytes 8 the same compare folds, and
// an int32 compare folds at wordBytes 4.
func TestCmpImmOperandWidthGuard() testing.TestResult {
	var cmp @ir.Instr = ipBinop(iropcode.OP_LT, types.TypInt64(), types.TypBool(), false, true, 1)
	var ok bool
	_, _, ok = CmpImmOperand(cmp, 1, 4)
	if ok { return "an int64 compare at wordBytes 4 must not be an immediate position" }
	_, _, ok = CmpImmOperand(cmp, 1, 8)
	if !ok { return "an int64 compare at wordBytes 8 must be an immediate position" }
	var cmp32 @ir.Instr = ipBinop(iropcode.OP_LT, types.TypInt32(), types.TypBool(), false, true, 1)
	_, _, ok = CmpImmOperand(cmp32, 1, 4)
	if !ok { return "an int32 compare at wordBytes 4 must be an immediate position" }
	return ""
}

// ADD is commutative: a constant in either operand, beside a register, folds.
func TestAddSubImmOperandAddEitherSide() testing.TestResult {
	var addR @ir.Instr = ipBinop(iropcode.OP_ADD, types.TypInt(), types.TypInt(), false, true, 8)
	var v int64
	var ok bool
	v, ok = AddSubImmOperand(addR, 1, 8)
	if !ok || v != cast(int64, 8) { return "a constant ADD RHS must fold with its value" }
	_, ok = AddSubImmOperand(addR, 0, 8)
	if ok { return "a non-constant ADD operand must not be an immediate position" }
	var addL @ir.Instr = ipBinop(iropcode.OP_ADD, types.TypInt(), types.TypInt(), true, false, 8)
	_, ok = AddSubImmOperand(addL, 0, 8)
	if !ok { return "a constant ADD LHS must fold (ADD is commutative)" }
	return ""
}

// A const+const ADD folds neither operand: one must supply the register.
func TestAddSubImmOperandConstPlusConst() testing.TestResult {
	var add @ir.Instr = ipBinop(iropcode.OP_ADD, types.TypInt(), types.TypInt(), true, true, 3)
	var ok bool
	_, ok = AddSubImmOperand(add, 0, 8)
	if ok { return "a const+const ADD must not fold its LHS" }
	_, ok = AddSubImmOperand(add, 1, 8)
	if ok { return "a const+const ADD must not fold its RHS" }
	return ""
}

// SUB folds only its subtrahend, and only beside a non-constant minuend.
func TestAddSubImmOperandSubPositions() testing.TestResult {
	var subR @ir.Instr = ipBinop(iropcode.OP_SUB, types.TypInt(), types.TypInt(), false, true, 3)
	var ok bool
	_, ok = AddSubImmOperand(subR, 1, 8)
	if !ok { return "a constant SUB subtrahend must fold" }
	var subL @ir.Instr = ipBinop(iropcode.OP_SUB, types.TypInt(), types.TypInt(), true, false, 3)
	_, ok = AddSubImmOperand(subL, 0, 8)
	if ok { return "a constant SUB minuend must not fold" }
	var subCC @ir.Instr = ipBinop(iropcode.OP_SUB, types.TypInt(), types.TypInt(), true, true, 3)
	_, ok = AddSubImmOperand(subCC, 1, 8)
	if ok { return "a subtrahend beside a constant minuend must not fold" }
	_, ok = AddSubImmOperand(subCC, 0, 8)
	if ok { return "a const-const SUB minuend must not fold" }
	return ""
}

// An add/sub wider than the target word (int64 at wordBytes 4) has no single
// register immediate; at wordBytes 8 the same add folds.
func TestAddSubImmOperandWidthGuard() testing.TestResult {
	var add @ir.Instr = ipBinop(iropcode.OP_ADD, types.TypInt64(), types.TypInt64(), false, true, 1)
	var ok bool
	_, ok = AddSubImmOperand(add, 1, 4)
	if ok { return "an int64 ADD at wordBytes 4 must not fold" }
	_, ok = AddSubImmOperand(add, 1, 8)
	if !ok { return "an int64 ADD at wordBytes 8 must fold" }
	var sub @ir.Instr = ipBinop(iropcode.OP_SUB, types.TypInt64(), types.TypInt64(), false, true, 1)
	_, ok = AddSubImmOperand(sub, 1, 4)
	if ok { return "an int64 SUB at wordBytes 4 must not fold" }
	return ""
}

// Other opcodes, a nil result type, and out-of-range argIdx are not add/sub
// immediate positions.
func TestAddSubImmOperandRejects() testing.TestResult {
	var mul @ir.Instr = ipBinop(iropcode.OP_MUL, types.TypInt(), types.TypInt(), false, true, 3)
	var ok bool
	_, ok = AddSubImmOperand(mul, 1, 8)
	if ok { return "a MUL must not be an add/sub immediate position" }
	var cmp @ir.Instr = ipBinop(iropcode.OP_LT, types.TypInt(), types.TypBool(), false, true, 3)
	_, ok = AddSubImmOperand(cmp, 1, 8)
	if ok { return "a compare must not be an add/sub immediate position" }
	var add @ir.Instr = ipBinop(iropcode.OP_ADD, types.TypInt(), nil, false, true, 3)
	_, ok = AddSubImmOperand(add, 1, 8)
	if ok { return "an ADD with a nil result type must not fold" }
	var fadd @ir.Instr = ipBinop(iropcode.OP_ADD, types.TypFloat64(), types.TypFloat64(), false, true,
			3)
	_, ok = AddSubImmOperand(fadd, 1, 8)
	if ok { return "a float ADD has no integer immediate form and must not fold" }
	var add2 @ir.Instr = ipBinop(iropcode.OP_ADD, types.TypInt(), types.TypInt(), false, true, 3)
	_, ok = AddSubImmOperand(add2, 2, 8)
	if ok { return "argIdx 2 must not be an add/sub immediate position" }
	_, ok = AddSubImmOperand(add2, 0 - 1, 8)
	if ok { return "argIdx -1 must not be an add/sub immediate position" }
	return ""
}

// ipLogicOps returns the three bitwise-logic opcodes LogicImmOperand accepts.
func ipLogicOps() @[]int {
	var ops @[]int = make_slice(int, 3)
	ops[0] = iropcode.OP_AND
	ops[1] = iropcode.OP_OR
	ops[2] = iropcode.OP_XOR
	return ops
}

// AND / OR / XOR are commutative: a constant in either operand, beside a
// register, folds with its value; the register operand never does.
func TestLogicImmOperandEitherSide() testing.TestResult {
	var ops @[]int = ipLogicOps()
	for i := 0; i < len(ops); i++ {
		var opR @ir.Instr = ipBinop(ops[i], types.TypInt(), types.TypInt(), false, true, 12)
		var v int64
		var ok bool
		v, ok = LogicImmOperand(opR, 1, 8)
		if !ok || v != cast(int64, 12) { return "a constant logic-op RHS must fold with its value" }
		_, ok = LogicImmOperand(opR, 0, 8)
		if ok { return "a non-constant logic-op LHS must not be an immediate position" }
		var opL @ir.Instr = ipBinop(ops[i], types.TypInt(), types.TypInt(), true, false, 12)
		v, ok = LogicImmOperand(opL, 0, 8)
		if !ok || v != cast(int64, 12) { return "a constant logic-op LHS must fold (commutative)" }
		_, ok = LogicImmOperand(opL, 1, 8)
		if ok { return "a non-constant logic-op RHS must not be an immediate position" }
	}
	return ""
}

// The value is returned uninterpreted: a negative constant (an all-ones mask, a
// sign-extended pattern) comes back as-is, for the per-target check to judge.
func TestLogicImmOperandNegativeValue() testing.TestResult {
	var ops @[]int = ipLogicOps()
	for i := 0; i < len(ops); i++ {
		var op @ir.Instr = ipBinop(ops[i], types.TypInt32(), types.TypInt32(), false, true, 0 - 256)
		var v int64
		var ok bool
		v, ok = LogicImmOperand(op, 1, 4)
		if !ok || v != cast(int64, 0 - 256) { return "a negative logic-op constant must fold as-is" }
	}
	return ""
}

// A const-const logic op folds neither operand: one must supply the register.
func TestLogicImmOperandConstConst() testing.TestResult {
	var ops @[]int = ipLogicOps()
	for i := 0; i < len(ops); i++ {
		var op @ir.Instr = ipBinop(ops[i], types.TypInt(), types.TypInt(), true, true, 3)
		var ok bool
		_, ok = LogicImmOperand(op, 0, 8)
		if ok { return "a const-const logic op must not fold its LHS" }
		_, ok = LogicImmOperand(op, 1, 8)
		if ok { return "a const-const logic op must not fold its RHS" }
	}
	return ""
}

// Non-logic opcodes are not logic-immediate positions — including the boolean
// OP_LAND / OP_LOR, even when typed as an integer.
func TestLogicImmOperandNonLogicRejected() testing.TestResult {
	var ops @[]int = make_slice(int, 5)
	ops[0] = iropcode.OP_ADD
	ops[1] = iropcode.OP_SUB
	ops[2] = iropcode.OP_MUL
	ops[3] = iropcode.OP_LAND
	ops[4] = iropcode.OP_LOR
	for i := 0; i < len(ops); i++ {
		var op @ir.Instr = ipBinop(ops[i], types.TypInt(), types.TypInt(), false, true, 3)
		var ok bool
		_, ok = LogicImmOperand(op, 1, 8)
		if ok { return "a non-logic op must not be a logic-immediate position" }
	}
	var land @ir.Instr = ipBinop(iropcode.OP_LAND, types.TypBool(), types.TypBool(), false, true, 1)
	var ok2 bool
	_, ok2 = LogicImmOperand(land, 1, 8)
	if ok2 { return "a boolean OP_LAND must not be a logic-immediate position" }
	var cmp @ir.Instr = ipBinop(iropcode.OP_EQ, types.TypInt(), types.TypBool(), false, true, 3)
	_, ok2 = LogicImmOperand(cmp, 1, 8)
	if ok2 { return "a compare must not be a logic-immediate position" }
	return ""
}

// A float, bool or nil result type has no integer logic immediate.
func TestLogicImmOperandTypeRejects() testing.TestResult {
	var fand @ir.Instr = ipBinop(iropcode.OP_AND, types.TypFloat64(), types.TypFloat64(), false, true,
			3)
	var ok bool
	_, ok = LogicImmOperand(fand, 1, 8)
	if ok { return "a float-typed AND must not fold" }
	var band @ir.Instr = ipBinop(iropcode.OP_AND, types.TypBool(), types.TypBool(), false, true, 1)
	_, ok = LogicImmOperand(band, 1, 8)
	if ok { return "a bool-typed AND must not fold" }
	var nor @ir.Instr = ipBinop(iropcode.OP_OR, types.TypInt(), nil, false, true, 3)
	_, ok = LogicImmOperand(nor, 1, 8)
	if ok { return "an OR with a nil result type must not fold" }
	return ""
}

// A logic op wider than the target word (int64 at wordBytes 4) has no single
// register immediate; at wordBytes 8 the same op folds, and 32-bit ops fold at
// wordBytes 4.
func TestLogicImmOperandWidthGuard() testing.TestResult {
	var ops @[]int = ipLogicOps()
	for i := 0; i < len(ops); i++ {
		var op @ir.Instr = ipBinop(ops[i], types.TypInt64(), types.TypInt64(), false, true, 1)
		var ok bool
		_, ok = LogicImmOperand(op, 1, 4)
		if ok { return "an int64 logic op at wordBytes 4 must not fold" }
		_, ok = LogicImmOperand(op, 1, 8)
		if !ok { return "an int64 logic op at wordBytes 8 must fold" }
		var op32 @ir.Instr = ipBinop(ops[i], types.TypInt32(), types.TypInt32(), false, true, 1)
		_, ok = LogicImmOperand(op32, 1, 4)
		if !ok { return "an int32 logic op at wordBytes 4 must fold" }
		var opU32 @ir.Instr = ipBinop(ops[i], types.TypUint32(), types.TypUint32(), false, true, 1)
		_, ok = LogicImmOperand(opU32, 1, 4)
		if !ok { return "a uint32 logic op at wordBytes 4 must fold" }
	}
	return ""
}

// argIdx outside 0..1, and a nil user, are not logic-immediate positions.
func TestLogicImmOperandArgIdxRange() testing.TestResult {
	var op @ir.Instr = ipBinop(iropcode.OP_AND, types.TypInt(), types.TypInt(), false, true, 3)
	var ok bool
	_, ok = LogicImmOperand(op, 2, 8)
	if ok { return "argIdx 2 must not be a logic-immediate position" }
	_, ok = LogicImmOperand(op, 0 - 1, 8)
	if ok { return "argIdx -1 must not be a logic-immediate position" }
	_, ok = LogicImmOperand(nil, 1, 8)
	if ok { return "a nil user must not be a logic-immediate position" }
	return ""
}

// CmpImmFits range edges: 0..posMax for either signedness; negMin..-1 for a
// signed compare only.
func TestCmpImmFitsEdges() testing.TestResult {
	var pm int64 = 4095
	var nm int64 = 0 - 4095
	var zero int64 = 0
	var one int64 = 1
	if !CmpImmFits(zero, false, pm, nm) || !CmpImmFits(zero, true, pm, nm) {
		return "0 must fit either signedness"
	}
	if !CmpImmFits(pm, false, pm, nm) || !CmpImmFits(pm, true, pm, nm) {
		return "posMax must fit either signedness"
	}
	if CmpImmFits(pm + one, false, pm, nm) || CmpImmFits(pm + one, true, pm, nm) {
		return "posMax+1 must not fit"
	}
	if !CmpImmFits(zero - one, false, pm, nm) { return "-1 must fit a signed compare" }
	if !CmpImmFits(nm, false, pm, nm) { return "negMin must fit a signed compare" }
	if CmpImmFits(nm - one, false, pm, nm) { return "negMin-1 must not fit" }
	if CmpImmFits(zero - one, true, pm, nm) { return "-1 must not fit an unsigned compare" }
	if CmpImmFits(nm, true, pm, nm) { return "negMin must not fit an unsigned compare" }
	return ""
}

// AddSubImmFits range edges: 0..posMax and negMin..-1, with no signedness split.
func TestAddSubImmFitsEdges() testing.TestResult {
	var pm int64 = 255
	var nm int64 = 0 - 255
	var zero int64 = 0
	var one int64 = 1
	if !AddSubImmFits(zero, pm, nm) { return "0 must fit" }
	if !AddSubImmFits(pm, pm, nm) { return "posMax must fit" }
	if AddSubImmFits(pm + one, pm, nm) { return "posMax+1 must not fit" }
	if !AddSubImmFits(zero - one, pm, nm) { return "-1 must fit (sign-swapped)" }
	if !AddSubImmFits(nm, pm, nm) { return "negMin must fit (sign-swapped)" }
	if AddSubImmFits(nm - one, pm, nm) { return "negMin-1 must not fit" }
	return ""
}
