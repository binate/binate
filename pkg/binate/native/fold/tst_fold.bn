package "pkg/binate/native/fold"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"

// TstFoldableAnds returns a dense ID-indexed flag set (sized to f.NextID):
// element [id] is true iff the OP_AND value id is a bitwise-AND whose sole use is
// an immediately-following equality compare against zero — `(a & b) == 0` or
// `!= 0`.  Such an AND + compare fold into a single flag-setting `tst a, b` (the
// AND's operands), which sets Z = (a & b == 0): the boolean/branch then reads Z
// directly (EQ / NE), with no materialized AND result and no separate compare.
//
// A backend consulting this set (assigned to m.TstFoldedAnd before
// AllocateRegisters) emits the `tst` in place of the AND, skips the compare's own
// flag-setting instruction, and leaves the AND result unhomed.
//
// The conditions make the fold correct:
//   - single use, and that use is the equality compare — a second use would need
//     the AND result in a register, so it can't be elided.
//   - the compare is EQ/NE against a literal 0 — `tst` sets Z for AND-is-zero, so
//     only equality-with-zero maps to it (an ordered `<`/`>` does not).
//   - the compare is the next instruction, skipping any OP_CONST_INT in between
//     (the compare's own literal 0 is materialized as a separate instruction that
//     IR-gen places between the AND and the compare): the `tst` is emitted at the
//     AND and its flags must survive to the compare, and an intervening
//     OP_CONST_INT emits only a flag-safe MOV (or nothing, when it too folds).  A
//     non-constant instruction between them could clobber the flags, so it blocks
//     the fold.
//   - the AND operand is no wider than the target word: a wider AND (arm32's
//     int64 register-pair AND, whose compare-with-zero is a multi-word sequence)
//     is left alone.  On a 64-bit target int64 is one register and folds.
func TstFoldableAnds(f @ir.Func, wordBytes int) @[]bool {
	var n int = f.NextID
	var useCount @[]int = make_slice(int, n)
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			for ai := 0; ai < len(ins.Args); ai++ {
				bumpUse(useCount, ins.Args[ai])
			}
			for pi := 0; pi < len(ins.Phis); pi++ {
				bumpUse(useCount, ins.Phis[pi].Val)
			}
		}
	}

	var fold @[]bool = make_slice(bool, n)
	for bi := 0; bi < len(f.Blocks); bi++ {
		var blk @ir.Block = f.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.Op != iropcode.OP_AND || ins.ID < 0 || ins.ID >= n {
				continue
			}
			if ins.Typ != nil && ins.Typ.SizeOf() > wordBytes {
				continue
			}
			if useCount[ins.ID] != 1 {
				continue
			}
			// The consuming compare is the next instruction after any intervening
			// OP_CONST_INT (which emit only a flag-safe MOV or nothing) — a
			// non-constant instruction between would clobber the flags.
			var k int = j + 1
			for k < len(blk.Instrs) && blk.Instrs[k].Op == iropcode.OP_CONST_INT {
				k = k + 1
			}
			if k < len(blk.Instrs) && andFeedsZeroCompare(blk.Instrs[k], ins.ID) {
				fold[ins.ID] = true
			}
		}
	}
	return fold
}

// andFeedsZeroCompare reports whether `cmp` is an OP_EQ/OP_NE comparing the value
// `andID` against a literal integer 0 (in either operand position).
func andFeedsZeroCompare(cmp @ir.Instr, andID int) bool {
	if cmp.Op != iropcode.OP_EQ && cmp.Op != iropcode.OP_NE {
		return false
	}
	if len(cmp.Args) != 2 || cmp.Args[0] == nil || cmp.Args[1] == nil {
		return false
	}
	var other @ir.Instr = nil
	if cmp.Args[0].ID == andID {
		other = cmp.Args[1]
	} else if cmp.Args[1].ID == andID {
		other = cmp.Args[0]
	} else {
		return false
	}
	return other.Op == iropcode.OP_CONST_INT && other.IntVal == cast(int64, 0)
}

// TstZeroCompareAndOperand returns the tst-folded OP_AND operand of an OP_EQ/OP_NE
// compare against zero — the value whose `tst` already set Z — or nil if `cmp` is
// not consuming such a fold.  A backend's compare emitter uses it to recognize
// that the flags are already set (skip its own compare) and branch/cset on Z.
func TstZeroCompareAndOperand(m @common.RegMap, cmp @ir.Instr) @ir.Instr {
	if cmp.Op != iropcode.OP_EQ && cmp.Op != iropcode.OP_NE {
		return nil
	}
	if len(cmp.Args) != 2 || cmp.Args[0] == nil || cmp.Args[1] == nil {
		return nil
	}
	if m.IsTstFoldedAnd(cmp.Args[0].ID) && cmp.Args[1].Op == iropcode.OP_CONST_INT &&
			cmp.Args[1].IntVal == cast(int64, 0) {
		return cmp.Args[0]
	}
	if m.IsTstFoldedAnd(cmp.Args[1].ID) && cmp.Args[0].Op == iropcode.OP_CONST_INT &&
			cmp.Args[0].IntVal == cast(int64, 0) {
		return cmp.Args[1]
	}
	return nil
}
