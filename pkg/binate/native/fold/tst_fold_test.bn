package "pkg/binate/native/fold"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for TstFoldableAnds (common_tst_fold.bn): which OP_ANDs fold with their
// consuming `== 0` / `!= 0` compare into a single `tst`.

func tfParamRef(f @ir.Func, name @[]char) @ir.Instr {
	var p @ir.Param = ir.NewParam(f, name, types.TypInt())
	return ir.NewParamRef(p)
}

// `(a & b) == 0` with a single-use AND folds (the const-0 sits between the AND
// and the compare in IR order, which the analysis skips).
func TestTstFoldZeroCompare() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var band @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_AND, tfParamRef(f, "a"),
			tfParamRef(f, "b"), types.TypInt())
	var zero @ir.Instr = irbuild.EmitConstInt(entry, 0, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_EQ, band, zero, types.TypBool())
	if !TstFoldableAnds(f, 8)[band.ID] {
		return "a single-use AND feeding == 0 must tst-fold"
	}
	return ""
}

// An AND used a SECOND time still needs its result in a register — not folded.
func TestTstFoldSecondUseNotFolded() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var elseB @ir.Block = ir.AddBlock(f, "else")
	var band @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_AND, tfParamRef(f, "a"),
			tfParamRef(f, "b"), types.TypInt())
	var zero @ir.Instr = irbuild.EmitConstInt(entry, 0, types.TypInt())
	var cmp @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_EQ, band, zero, types.TypBool())
	irbuild.EmitBranch(entry, cmp, thenB, elseB)
	// Second, cross-block use of the AND result.
	_ = irbuild.EmitBinop(thenB, iropcode.OP_ADD, band, tfParamRef(f, "c"), types.TypInt())
	if TstFoldableAnds(f, 8)[band.ID] {
		return "an AND with a second use must not tst-fold"
	}
	return ""
}

// A compare against a NON-zero constant is not equality-with-zero — no tst.
func TestTstFoldNonZeroNotFolded() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var band @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_AND, tfParamRef(f, "a"),
			tfParamRef(f, "b"), types.TypInt())
	var five @ir.Instr = irbuild.EmitConstInt(entry, 5, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_EQ, band, five, types.TypBool())
	if TstFoldableAnds(f, 8)[band.ID] {
		return "an AND compared against a non-zero constant must not tst-fold"
	}
	return ""
}

// An ordered compare (`< 0`) is not equality-with-zero — `tst` sets only Z.
func TestTstFoldOrderedNotFolded() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var band @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_AND, tfParamRef(f, "a"),
			tfParamRef(f, "b"), types.TypInt())
	var zero @ir.Instr = irbuild.EmitConstInt(entry, 0, types.TypInt())
	_ = irbuild.EmitBinop(entry, iropcode.OP_LT, band, zero, types.TypBool())
	if TstFoldableAnds(f, 8)[band.ID] {
		return "an ordered compare (< 0) must not tst-fold"
	}
	return ""
}
