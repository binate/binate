// Package inplace holds the native backends' in-place frame analyses: which values of a
// function may live in memory something else already provides -- an aggregate load
// reading its source in place (AggLoadElision), a call writing its result straight into
// a stack slot (CallResultSlots) or the caller's result buffer (ReturnedCallResults,
// RetbufLocal), a by-value argument read from its slot (LastUseArgLoads), a by-value
// parameter's slot being its incoming copy (InPlaceParamSlots).  native/common's
// PlanFrame plans the frame from them, and the LLVM backend and the VM ask some of them
// too.  Each analysis reads a function's IR and changes nothing.

package "pkg/binate/native/inplace"

import "pkg/binate/ir"

// InPlaceParamSlots returns, indexed by value ID, the index of the by-value
// aggregate parameter whose incoming memory each OP_ALLOC of f — that parameter's
// slot — may be, or -1: the parameter's only use is the entry block's store of it
// into the slot, the slot is its size, and nothing uses the slot before that store.
// A backend uses such a slot in place only where the parameter's bytes arrive in
// memory the callee owns — never a closure capture passed as a pointer into the
// closure record (IsCaptureParam).
func InPlaceParamSlots(f @ir.Func) @[]int

// IsCaptureParam reports whether f.Params[pi] is one of a closure's captures.
func IsCaptureParam(f @ir.Func, pi int) bool

// CallResultSlots returns, indexed by value ID, the value ID of the stack slot each
// call of f may write its aggregate result into in place of a buffer of its own, or
// -1: the result's only use is a whole store into the slot, in the call's block; the
// slot's address never leaves f but to calls that keep none of their pointer arguments
// (ir.Instr.ArgsNotKept); nothing between the call and the store references the slot
// or a value computed from it, its own OP_ALLOC included unless NoZeroInit.
func CallResultSlots(f @ir.Func) @[]int

// ReturnedCallResults reports, indexed by value ID, whether each direct call of f
// produces the one aggregate f returns: the result's only use is the return, in the
// call's block, and it is the size of f's result.  A backend passes its incoming
// result buffer to such a call when both return through one.
func ReturnedCallResults(f @ir.Func) @[]bool

// RetbufLocal returns the value ID of the stack slot f may keep in its caller's result
// buffer, or -1, with, indexed by value ID, the loads of it f returns: every return of
// f returns a whole load of that slot, in the return's block, the load's only use, with
// nothing between referencing the slot; the slot is the result's size, its address
// never leaves f, and it may not be a parameter's incoming copy.
func RetbufLocal(f @ir.Func) (int, @[]bool)

// LastUseArgLoads reports, indexed by value ID, the aggregate loads of f that may read
// their stack slot in place for their one use, a by-value argument of a call in their
// block: the slot's address never leaves f, every touch of the slot is in that block
// before the load, and each execution of the block sets the slot before touching it.
func LastUseArgLoads(f @ir.Func) @[]bool

// AGG_LOAD_COPIED: an aggregate OP_LOAD copied into a private region first
// (AggLoadElision).
const AGG_LOAD_COPIED int = 0

// AGG_LOAD_IN_PLACE: an aggregate OP_LOAD read in place from its source, which no
// consumer's destination overlaps at a size where that matters (every backend copies
// one of up to 16 bytes as if all of its source were read before any of it is written).
const AGG_LOAD_IN_PLACE int = 1

// AGG_LOAD_IN_PLACE_OVERLAPPING: an aggregate OP_LOAD read in place by its one use, a
// whole store whose destination may overlap the source — so the store must copy as
// memmove does, as if all of the source were read before any of it is written.
const AGG_LOAD_IN_PLACE_OVERLAPPING int = 2

// AggLoadElision classifies the aggregate OP_LOAD ld of f (an AGG_LOAD_* value): it may
// read its source in place instead of copying it first when the source provably
// keeps the loaded bytes until ld's last use (a confined stack slot not re-stored
// before then, or nothing that writes or frees memory in between — scalar field
// reads of any size, whole copies of at most 16 bytes, or of any size returned whole
// as f's result, passed whole as a call's by-value argument, boxed or stored whole) and
// every use is a read in ld's block.  A load from
// an unknown source whose one use is a whole store of more than 16 bytes is
// AGG_LOAD_IN_PLACE_OVERLAPPING, and the backend must copy that store as memmove
// does.  The native backends' frame planning, the LLVM backend's memory-backed loads
// and the VM's whole stores ask this.  Each call indexes f's uses, which costs a pass
// over f; a caller asking about several loads of one function uses an AggLoadElider.
func AggLoadElision(f @ir.Func, ld @ir.Instr) int

// AggLoadElider answers AggLoadElision for the loads of one function from one index
// of its uses, built once, so each answer costs the uses it reads instead of a pass
// over the function.  The function must not change while the elider is in use.
type AggLoadElider

// NewAggLoadElider returns an AggLoadElider for f.
func NewAggLoadElider(f @ir.Func) @AggLoadElider

// Elision is AggLoadElision(f, ld) for the elider's function f.
func (e @AggLoadElider) Elision(ld @ir.Instr) int

// FuncUses indexes a function's blocks once -- the block and position of each
// instruction, the operand sites of each value -- so that the analyses above, asked of
// one function together (as PlanFrame does), share one index.  The function must not
// change while it is in use.
type FuncUses

// NewFuncUses indexes f.
func NewFuncUses(f @ir.Func) @FuncUses

// AggLoadElision is the package's AggLoadElision for the load ld of u's function.
func (u @FuncUses) AggLoadElision(ld @ir.Instr) int

// CallResultSlots is the package's CallResultSlots for u's function, whose
// InPlaceParamSlots are inPlace.
func (u @FuncUses) CallResultSlots(inPlace @[]int) @[]int

// RetbufLocal is the package's RetbufLocal for u's function, whose InPlaceParamSlots are
// inPlace.
func (u @FuncUses) RetbufLocal(inPlace @[]int) (int, @[]bool)

// LastUseArgLoads is the package's LastUseArgLoads for u's function.
func (u @FuncUses) LastUseArgLoads() @[]bool

// IsAggregateAlias reports whether ins passes its first operand's aggregate pointer on as
// its own aggregate result rather than copying the bytes: an aggregate-typed OP_EXTRACT
// (an address inside the operand), and an OP_MANAGED_TO_RAW, OP_CAST or OP_BIT_CAST with
// an aggregate result (the same pointer).
func IsAggregateAlias(ins @ir.Instr) bool
