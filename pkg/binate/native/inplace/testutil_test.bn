package "pkg/binate/native/inplace"

import "pkg/binate/ir"
import "pkg/binate/types"

// oneArg returns a one-element argument list.
func oneArg(v @ir.Instr) @[]@ir.Instr {
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = v
	return args
}

// twoFieldStruct builds `struct S { f0 t0; f1 t1 }` — field 1 is the fuse target
// (its offset depends on the live types target, so tests set it first).
func twoFieldStruct(t0 @types.Type, t1 @types.Type) @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 2)
	var a @types.Field = make(types.Field)
	a.Name = "f0"
	a.Type = t0
	var c @types.Field = make(types.Field)
	c.Name = "f1"
	c.Type = t1
	fs[0] = a
	fs[1] = c
	return types.MakeStructType("S", fs)
}

// setTarget64 pins types' live target to a 64-bit configuration.
// All native-backend tests in this package target a 64-bit ABI
// (AAPCS64 / SysV-AMD64) — their assertions about word counts,
// stack bytes, frame layouts, and aggregate sizes are LP64-specific.
// On a 32-bit-host test runner, the lazy default would otherwise
// reflect the host (ILP32) and make those assertions diverge.
func setTarget64() {
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	types.SetTarget(t)
}

func makeNoParams() @[]@ir.Param {
	var p @[]@ir.Param
	return p
}

func makeNoResults() @[]@types.Type {
	var r @[]@types.Type
	return r
}

func makeNoInstrs() @[]@ir.Instr {
	var i @[]@ir.Instr
	return i
}

// twoPE builds a 2-entry phi operand list.
func twoPE(b1 @ir.Block, v1 @ir.Instr, b2 @ir.Block, v2 @ir.Instr) @[]ir.PhiEntry {
	var p1 ir.PhiEntry
	p1.Block = b1
	p1.Val = v1
	var p2 ir.PhiEntry
	p2.Block = b2
	p2.Val = v2
	var es @[]ir.PhiEntry = make_slice(ir.PhiEntry, 2)
	es[0] = p1
	es[1] = p2
	return es
}

// oneInstr wraps v in a 1-element instruction slice (e.g. a single return value).
func oneInstr(v @ir.Instr) @[]@ir.Instr {
	var r @[]@ir.Instr = make_slice(@ir.Instr, 1)
	r[0] = v
	return r
}
