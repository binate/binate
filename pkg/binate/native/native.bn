package "pkg/binate/native"

import "pkg/binate/ir"
import "pkg/binate/native/aarch64"
import "pkg/binate/native/arm32"
import "pkg/binate/native/x64"

// Backend lowers an IR module to a native object file for one target
// architecture.  The per-arch sub-packages do the actual lowering; the
// impls below are thin stateless adapters, so EmitObject dispatches
// through the interface vtable rather than calling the sub-package
// entry points directly.  This is the seam a driver-level backend
// abstraction can grow from (an LLVM-emitting impl would join here).
interface Backend {
	emitObject(mod @ir.Module, format *[]readonly char, path *[]readonly char) bool
}

// aarch64Backend targets pkg/binate/native/aarch64 (Mach-O on macOS).
type aarch64Backend struct {}

// emitObject lowers mod to an AArch64 object at path via pkg/binate/native/aarch64,
// in the requested object format.
func (b *aarch64Backend) emitObject(mod @ir.Module, format *[]readonly char,
		path *[]readonly char) bool {
	return aarch64.EmitObject(mod, format, path)
}

impl *aarch64Backend : Backend

// x64Backend targets pkg/binate/native/x64 (SysV-AMD64).
type x64Backend struct {}

// emitObject lowers mod to an x86-64 object at path via pkg/binate/native/x64,
// in the requested object format.
func (b *x64Backend) emitObject(mod @ir.Module, format *[]readonly char,
		path *[]readonly char) bool {
	return x64.EmitObject(mod, format, path)
}

impl *x64Backend : Backend

// arm32Backend targets pkg/binate/native/arm32 (ELF32, AAPCS32 soft-float).
type arm32Backend struct {}

// emitObject lowers mod to an ARM32 ELF object at path via
// pkg/binate/native/arm32.  format is ignored (arm32 is ELF-only).
func (b *arm32Backend) emitObject(mod @ir.Module, format *[]readonly char,
		path *[]readonly char) bool {
	return arm32.EmitObject(mod, format, path)
}

impl *arm32Backend : Backend

// strEq compares two raw char slices for equality.
func strEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// EmitObject selects the per-arch Backend and dispatches through it,
// emitting in the requested object `format` ("macho" / "elf").  Arch
// and format are independent axes (plan-backend-objformat-decoupling.md):
// the caller derives both from the target triple and passes them
// separately; this function never infers one from the other.
//
// Recognised arch strings:
//   - "aarch64", "arm64"   → pkg/binate/native/aarch64
//   - "x86_64", "x64"      → pkg/binate/native/x64 (SysV-AMD64)
//   - "arm32", "arm"       → pkg/binate/native/arm32 (ELF32, AAPCS32)
func EmitObject(mod @ir.Module, arch *[]readonly char, format *[]readonly char,
		path *[]readonly char) bool {
	if strEq(arch, "aarch64") || strEq(arch, "arm64") {
		var be aarch64Backend
		var b *Backend = &be
		return b.emitObject(mod, format, path)
	}
	if strEq(arch, "x86_64") || strEq(arch, "x64") {
		var be x64Backend
		var b *Backend = &be
		return b.emitObject(mod, format, path)
	}
	if strEq(arch, "arm32") || strEq(arch, "arm") {
		var be arm32Backend
		var b *Backend = &be
		return b.emitObject(mod, format, path)
	}
	return false
}
