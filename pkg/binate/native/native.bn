package "pkg/binate/native"

import "pkg/binate/ir"
import "pkg/binate/native/aarch64"
import "pkg/binate/native/arm32"
import "pkg/binate/native/common"
import "pkg/binate/native/x64"

// Backend lowers an IR module to a native object file for one target
// architecture.  The per-arch sub-packages do the actual lowering; the
// impls below are thin adapters carrying their backend's code-generation
// switches, so EmitObject dispatches through the interface vtable rather
// than calling the sub-package entry points directly.  This is the seam a
// driver-level backend abstraction can grow from (an LLVM-emitting impl
// would join here).
interface Backend {
	emitObject(mod @ir.Module, format *[]readonly char, path *[]readonly char) bool
}

// aarch64Backend targets pkg/binate/native/aarch64 (Mach-O on macOS), with the
// aarch64 code-generation switches in opts.
type aarch64Backend struct {
	opts aarch64.Options
}

// emitObject lowers mod to an AArch64 object at path via pkg/binate/native/aarch64,
// in the requested object format, under b.opts.
func (b *aarch64Backend) emitObject(mod @ir.Module, format *[]readonly char,
		path *[]readonly char) bool {
	return aarch64.EmitObject(mod, format, path, b.opts)
}

impl *aarch64Backend : Backend

// x64Backend targets pkg/binate/native/x64 (SysV-AMD64), with the x64
// code-generation switches in opts.
type x64Backend struct {
	opts x64.Options
}

// emitObject lowers mod to an x86-64 object at path via pkg/binate/native/x64,
// in the requested object format, under b.opts.
func (b *x64Backend) emitObject(mod @ir.Module, format *[]readonly char,
		path *[]readonly char) bool {
	return x64.EmitObject(mod, format, path, b.opts)
}

impl *x64Backend : Backend

// arm32Backend targets pkg/binate/native/arm32 (ELF32, AAPCS32 soft-float), with
// the arm32 code-generation switches in opts.
type arm32Backend struct {
	opts arm32.Options
}

// emitObject lowers mod to an ARM32 ELF object at path via
// pkg/binate/native/arm32, under b.opts.  format is ignored (arm32 is ELF-only).
func (b *arm32Backend) emitObject(mod @ir.Module, format *[]readonly char,
		path *[]readonly char) bool {
	return arm32.EmitObject(mod, format, path, b.opts)
}

impl *arm32Backend : Backend

// strEq compares two raw char slices for equality.
func strEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// EmitObject selects the per-arch Backend and dispatches through it,
// emitting in the requested object `format` ("macho" / "elf").  Arch
// and format are independent axes: the caller derives both from the
// target triple and passes them separately; this function never infers
// one from the other.  A switch named for an architecture reaches only
// that backend (X64RaxHome the x64 one); Place reaches all three.
//
// Recognised arch strings:
//   - "aarch64", "arm64"   → pkg/binate/native/aarch64
//   - "x86_64", "x64"      → pkg/binate/native/x64 (SysV-AMD64)
//   - "arm32", "arm"       → pkg/binate/native/arm32 (ELF32, AAPCS32)
func EmitObject(mod @ir.Module, arch *[]readonly char, format *[]readonly char,
		path *[]readonly char, opts Options) bool {
	if strEq(arch, "aarch64") || strEq(arch, "arm64") {
		var be aarch64Backend
		be.opts.Place = opts.Place
		var b *Backend = &be
		return b.emitObject(mod, format, path)
	}
	if strEq(arch, "x86_64") || strEq(arch, "x64") {
		var be x64Backend
		be.opts.RaxHome = opts.X64RaxHome
		be.opts.Place = opts.Place
		var b *Backend = &be
		return b.emitObject(mod, format, path)
	}
	if strEq(arch, "arm32") || strEq(arch, "arm") {
		var be arm32Backend
		be.opts.Place = opts.Place
		var b *Backend = &be
		return b.emitObject(mod, format, path)
	}
	return false
}

// SetCopyStats turns the aggregate-copy tally on or off (common.SetCopyStats).
func SetCopyStats(on bool) {
	common.SetCopyStats(on)
}

// CopyStatsReport returns the aggregate-copy tally (common.CopyStatsReport).
func CopyStatsReport() @[]char {
	return common.CopyStatsReport()
}
