package "pkg/binate/native"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/os"

// A zero-initialized global takes no bytes in the object: every backend places it in
// a zero-fill section (ELF .bss, SHT_NOBITS; Mach-O __bss, S_ZEROFILL), whose size the
// object records without holding the bytes.

// bigZeroGlobalSize is the size of the global bssModule holds: big enough that an
// object holding its bytes could not pass for one recording only its size.
const bigZeroGlobalSize int64 = 16 << 20

// bssModule returns sumModule(1) plus a [bigZeroGlobalSize]uint8 global.
func bssModule() @ir.Module {
	var m @ir.Module = sumModule(1)
	var g @ir.Global = make(ir.Global)
	g.Name = "big"
	g.Typ = types.MakeArrayType(types.TypUint8(), bigZeroGlobalSize)
	m.AddGlobal(g)
	return m
}

// elfZeroFillSize returns the size of the relocatable ELF object obj's .bss section
// when it is SHT_NOBITS, else -1.
func elfZeroFillSize(obj @[]uint8) int {
	var is64 bool = len(obj) > 4 && obj[4] == 2
	var shoff int = objLE(obj, 0x20, 4)
	var hdr int = 0x2E
	var offsetOff int = 0x10
	var sizeOff int = 0x14
	var word int = 4
	if is64 {
		shoff = objLE(obj, 0x28, 8)
		hdr = 0x3A
		offsetOff = 0x18
		sizeOff = 0x20
		word = 8
	}
	var shentsize int = objLE(obj, hdr, 2)
	var shnum int = objLE(obj, hdr + 2, 2)
	var strtab int = objLE(obj, shoff + objLE(obj, hdr + 4, 2) * shentsize + offsetOff, word)
	for i := 0; i < shnum && strtab >= 0; i++ {
		var sh int = shoff + i * shentsize
		if objNameIs(obj, strtab + objLE(obj, sh, 4), 5, ".bss") {
			if objLE(obj, sh + 4, 4) != 8 { return -1 }
			return objLE(obj, sh + sizeOff, word)
		}
	}
	return -1
}

// machoZeroFillSize returns the size of the 64-bit Mach-O object obj's __bss section
// when it is S_ZEROFILL, else -1.
func machoZeroFillSize(obj @[]uint8) int {
	var ncmds int = objLE(obj, 16, 4)
	var lc int = 32
	for c := 0; c < ncmds; c++ {
		var cmdsize int = objLE(obj, lc + 4, 4)
		if cmdsize <= 0 { return -1 }
		if objLE(obj, lc, 4) == 0x19 {
			var nsects int = objLE(obj, lc + 64, 4)
			for s := 0; s < nsects; s++ {
				var sect int = lc + 72 + s * 80
				if objNameIs(obj, sect, 16, "__bss") {
					if (objLE(obj, sect + 64, 4) & 0xFF) != 1 { return -1 }
					return objLE(obj, sect + 40, 8)
				}
			}
		}
		lc = lc + cmdsize
	}
	return -1
}

// checkZeroGlobalNoBytes emits bssModule for arch/format and checks the object
// records the global in its zero-fill section without holding its bytes.
func checkZeroGlobalNoBytes(dir *[]readonly char, arch *[]readonly char, format *[]readonly char,
		ilp32 bool) testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	if ilp32 {
		t.PointerSize = 4
		t.IntSize = 4
	}
	types.SetTarget(t)
	defer { types.SetTarget(saved) }
	var path @[]char = buf.Concat(buf.Concat(buf.Concat(dir, "/bss_"), arch), ".o")
	if !EmitObject(bssModule(), arch, format, path, Options{}) {
		return fail(buf.Concat("cannot emit the object for ", arch))
	}
	fi, err := os.Stat(path)
	if present(err) { return fail("cannot stat the object") }
	if fi.Size() >= bigZeroGlobalSize {
		return fail(buf.Concat("the object holds the zero global's bytes: ", arch))
	}
	var obj @[]uint8 = readObject(path)
	var size int = elfZeroFillSize(obj)
	if strEq(format, "macho") { size = machoZeroFillSize(obj) }
	if cast(int64, size) < bigZeroGlobalSize {
		return fail(buf.Concat("the zero global is not in a zero-fill section: ", arch))
	}
	return ""
}

// Every backend, in each object format it emits.
func TestEmitObjectZeroGlobalTakesNoBytes() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var r testing.TestResult = checkZeroGlobalNoBytes(dir, "x86_64", "elf", false)
	if len(r) > 0 { return r }
	r = checkZeroGlobalNoBytes(dir, "x86_64", "macho", false)
	if len(r) > 0 { return r }
	r = checkZeroGlobalNoBytes(dir, "aarch64", "macho", false)
	if len(r) > 0 { return r }
	r = checkZeroGlobalNoBytes(dir, "aarch64", "elf", false)
	if len(r) > 0 { return r }
	return checkZeroGlobalNoBytes(dir, "arm32", "elf", true)
}
