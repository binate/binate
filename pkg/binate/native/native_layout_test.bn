package "pkg/binate/native"

import "pkg/binate/native/blockplan"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/os"

// Options.BlockLayout reaches every backend, in each object format it emits.

// checkLayoutRoutes checks, for one arch/format, that BlockLayout reaches the
// backend: Options{} emits what an explicit BLOCK_LAYOUT_SOURCE does, FALLTHROUGH
// emits, and a value that is not a mode fails the emit, which only the backend's
// common.EmitObject checks.
func checkLayoutRoutes(dir *[]readonly char, arch *[]readonly char, format *[]readonly char,
		ilp32 bool) testing.TestResult {
	var saved types.TargetInfo = setPlaceTarget(ilp32)
	defer { types.SetTarget(saved) }
	var base @[]uint8 = emitSumBytes(dir, "/layout_base.o", arch, format, Options{})
	if len(base) == 0 { return fail("cannot emit the default object") }
	var src Options
	src.BlockLayout = blockplan.BLOCK_LAYOUT_SOURCE
	if !sameBytes(base, emitSumBytes(dir, "/layout_src.o", arch, format, src)) {
		return fail("Options{} must emit what BLOCK_LAYOUT_SOURCE does")
	}
	var ft Options
	ft.BlockLayout = blockplan.BLOCK_LAYOUT_FALLTHROUGH
	if len(emitSumBytes(dir, "/layout_ft.o", arch, format, ft)) == 0 {
		return fail("BLOCK_LAYOUT_FALLTHROUGH must emit")
	}
	var bad Options
	bad.BlockLayout = -1
	if len(emitSumBytes(dir, "/layout_bad.o", arch, format, bad)) != 0 {
		return fail("a block layout that is not a mode must fail the emit")
	}
	bad.BlockLayout = blockplan.BLOCK_LAYOUT_FALLTHROUGH + 1
	if len(emitSumBytes(dir, "/layout_bad2.o", arch, format, bad)) != 0 {
		return fail("a block layout past the last mode must fail the emit")
	}
	return ""
}

// BlockLayout reaches all three backends, in each object format they emit.
func TestEmitObjectRoutesBlockLayout() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var r testing.TestResult = checkLayoutRoutes(dir, "x86_64", "elf", false)
	if len(r) > 0 { return r }
	r = checkLayoutRoutes(dir, "x86_64", "macho", false)
	if len(r) > 0 { return r }
	r = checkLayoutRoutes(dir, "aarch64", "macho", false)
	if len(r) > 0 { return r }
	r = checkLayoutRoutes(dir, "aarch64", "elf", false)
	if len(r) > 0 { return r }
	return checkLayoutRoutes(dir, "arm32", "elf", true)
}
