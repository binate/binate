package "pkg/binate/native"

import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/binate/native/place"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/os"

// Options.Place reaches every backend, and the object it writes carries what
// phase mode needs: .text aligned to place.PLACE_SPAN.

// placeSumSeed returns the smallest seed under which phase mode puts filler before
// main.sum, the first function of a module, for both filler units (16 on x86-64, 4
// on aarch64 / arm32), so the seeded object must differ from the unseeded one.
func placeSumSeed() int {
	var sym @[]char = mangle.FuncName("main", "main.sum")
	var p place.PlaceOptions
	p.Mode = place.PLACE_PHASE
	for s := 1; s < 1000; s++ {
		p.Seed = s
		if place.PlaceFillBefore(p, sym, 16, 0) > 0 && place.PlaceFillBefore(p, sym, 4, 0) > 0 {
			return s
		}
	}
	return 0
}

// emitSumBytes emits sumModule(7) for arch/format under opts at dir/name and
// returns the object's bytes (empty on failure).
func emitSumBytes(dir *[]readonly char, name *[]readonly char, arch *[]readonly char,
		format *[]readonly char, opts Options) @[]uint8 {
	var path @[]char = buf.Concat(dir, name)
	if !EmitObject(sumModule(7), arch, format, path, opts) {
		var none @[]uint8
		return none
	}
	return readObject(path)
}

// objLE returns the n-byte little-endian value at off in obj, or -1 when it
// runs past the end.
func objLE(obj @[]uint8, off int, n int) int {
	if off < 0 || off + n > len(obj) { return -1 }
	var v int = 0
	for i := n - 1; i >= 0; i-- {
		v = v * 256 + cast(int, obj[off + i])
	}
	return v
}

// objNameIs reports whether obj holds the NUL-terminated (or, at width, unterminated)
// name at off, within width bytes.
func objNameIs(obj @[]uint8, off int, width int, name *[]readonly char) bool {
	if off < 0 || off + len(name) > len(obj) || len(name) > width { return false }
	for i := 0; i < len(name); i++ {
		if obj[off + i] != cast(uint8, name[i]) { return false }
	}
	return len(name) == width || (off + len(name) < len(obj) && obj[off + len(name)] == 0)
}

// elfTextAlign returns the sh_addralign of the .text section of the relocatable
// ELF object obj (ELFCLASS32 or ELFCLASS64), or -1 if there is none.
func elfTextAlign(obj @[]uint8) int {
	var is64 bool = len(obj) > 4 && obj[4] == 2
	var shoff int = objLE(obj, 0x20, 4)
	var hdr int = 0x2E
	var offsetOff int = 0x10
	var alignOff int = 0x20
	var word int = 4
	if is64 {
		shoff = objLE(obj, 0x28, 8)
		hdr = 0x3A
		offsetOff = 0x18
		alignOff = 0x30
		word = 8
	}
	var shentsize int = objLE(obj, hdr, 2)
	var shnum int = objLE(obj, hdr + 2, 2)
	var shstrndx int = objLE(obj, hdr + 4, 2)
	if shoff <= 0 || shentsize <= 0 || shnum < 0 || shstrndx < 0 { return -1 }
	// The section-name string table's file offset (its sh_offset).
	var strtab int = objLE(obj, shoff + shstrndx * shentsize + offsetOff, word)
	if strtab < 0 { return -1 }
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if objNameIs(obj, strtab + objLE(obj, sh, 4), 6, ".text") {
			return objLE(obj, sh + alignOff, word)
		}
	}
	return -1
}

// machoTextAlign returns the alignment in bytes of the __text section of the
// 64-bit Mach-O object obj, or -1 if there is none.
func machoTextAlign(obj @[]uint8) int {
	var ncmds int = objLE(obj, 16, 4)
	var lc int = 32
	for c := 0; c < ncmds; c++ {
		var cmdsize int = objLE(obj, lc + 4, 4)
		if cmdsize <= 0 { return -1 }
		// LC_SEGMENT_64: a 72-byte command header, then 80-byte section_64 records.
		if objLE(obj, lc, 4) == 0x19 {
			var nsects int = objLE(obj, lc + 64, 4)
			for s := 0; s < nsects; s++ {
				var sect int = lc + 72 + s * 80
				if objNameIs(obj, sect, 16, "__text") {
					// section_64.align is a power of two, stored as its log2.
					var align int = 1
					for k := 0; k < objLE(obj, sect + 52, 4); k++ { align = align * 2 }
					return align
				}
			}
		}
		lc = lc + cmdsize
	}
	return -1
}

// objTextAlign returns the .text alignment the object obj, written in format,
// records for the linker.
func objTextAlign(obj @[]uint8, format *[]readonly char) int {
	if strEq(format, "macho") { return machoTextAlign(obj) }
	return elfTextAlign(obj)
}

// checkPlaceRoutes checks, for one arch/format, that Place reaches the backend: a
// seed-0 Place (in phase mode) emits the default object, a seed that fills before
// main.sum changes it, the same seed twice gives the same object whose .text the
// linker must align to PLACE_SPAN (the default object's is less), and X64RaxHome
// changes nothing off x86-64.
func checkPlaceRoutes(dir *[]readonly char, arch *[]readonly char, format *[]readonly char,
		ilp32 bool) testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	if ilp32 {
		t.PointerSize = 4
		t.IntSize = 4
	}
	types.SetTarget(t)
	defer { types.SetTarget(saved) }
	var base @[]uint8 = emitSumBytes(dir, "/place_base.o", arch, format, Options{})
	if len(base) == 0 { return fail("cannot emit the default object") }
	var baseAlign int = objTextAlign(base, format)
	if baseAlign <= 0 || baseAlign >= place.PLACE_SPAN {
		return fail("the default object's .text alignment must be below PLACE_SPAN")
	}
	var zero Options
	zero.Place.Mode = place.PLACE_PHASE
	if !sameBytes(base, emitSumBytes(dir, "/place_zero.o", arch, format, zero)) {
		return fail("seed 0 must leave the object unchanged")
	}
	var seeded Options
	seeded.Place.Seed = placeSumSeed()
	seeded.Place.Mode = place.PLACE_PHASE
	if seeded.Place.Seed == 0 { return fail("no seed fills before main.sum") }
	var a @[]uint8 = emitSumBytes(dir, "/place_a.o", arch, format, seeded)
	var b @[]uint8 = emitSumBytes(dir, "/place_b.o", arch, format, seeded)
	if len(a) == 0 || len(b) == 0 { return fail("cannot emit the seeded object") }
	if sameBytes(base, a) { return fail("Place must reach the backend") }
	if !sameBytes(a, b) { return fail("the same seed must emit the same object") }
	if objTextAlign(a, format) != place.PLACE_SPAN {
		return fail("a phase-mode object must record .text alignment PLACE_SPAN")
	}
	if !strEq(arch, "x86_64") {
		var rax Options
		rax.X64RaxHome = true
		if !sameBytes(base, emitSumBytes(dir, "/place_rax.o", arch, format, rax)) {
			return fail("X64RaxHome must reach only the x64 backend")
		}
	}
	return ""
}

// Place reaches all three backends, in each object format they emit.
func TestEmitObjectRoutesPlace() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var r testing.TestResult = checkPlaceRoutes(dir, "x86_64", "elf", false)
	if len(r) > 0 { return r }
	r = checkPlaceRoutes(dir, "x86_64", "macho", false)
	if len(r) > 0 { return r }
	r = checkPlaceRoutes(dir, "aarch64", "macho", false)
	if len(r) > 0 { return r }
	r = checkPlaceRoutes(dir, "aarch64", "elf", false)
	if len(r) > 0 { return r }
	return checkPlaceRoutes(dir, "arm32", "elf", true)
}
