package "pkg/binate/native"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/builtins/testing"
import "pkg/std/os"

// fail builds a @[]char failure message.
func fail(msg *[]readonly char) testing.TestResult {
	var r @[]char
	if len(msg) == 0 { return r }
	var out @[]char = make_slice(char, len(msg))
	for i := 0; i < len(msg); i++ { out[i] = msg[i] }
	return out
}

// EmitObject returns false for an unrecognised arch string.
func TestEmitObjectUnknownArch() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var m @ir.Module = ir.NewModule("\"main\"")
	if EmitObject(m, "mips", "elf", buf.Concat(dir, "/native_dispatch.o")) {
		return fail("expected false for unknown arch 'mips'")
	}
	return ""
}

// Both "x86_64" and "x64" route to pkg/binate/native/x64.  Phase 3a's
// EmitObject writes a valid (empty-module) ELF; the dispatch test
// asserts both aliases reach the real backend.  Same shape as the
// aarch64 pair below.
func TestEmitObjectX64Aliases() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var m @ir.Module = ir.NewModule("\"main\"")
	if !EmitObject(m, "x86_64", "elf", buf.Concat(dir, "/native_dispatch_x64.o")) {
		return fail("expected EmitObject to succeed for 'x86_64'")
	}
	if !EmitObject(m, "x64", "elf", buf.Concat(dir, "/native_dispatch_x64alias.o")) {
		return fail("expected EmitObject to succeed for 'x64'")
	}
	return ""
}

// Both "aarch64" and "arm64" are accepted as the same backend; the
// dispatcher delegates to pkg/binate/native/arm64 in both cases. We don't
// actually link/run here — that's covered by arm64's own tests — but
// a successful EmitObject proves the dispatch table is wired.
func TestEmitObjectAArch64Aliases() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var m @ir.Module = ir.NewModule("\"main\"")
	// An empty module emits a zero-function text section; the arm64
	// backend still writes a valid .o.
	if !EmitObject(m, "aarch64", "macho", buf.Concat(dir, "/native_dispatch_aa.o")) {
		return fail("expected EmitObject to succeed for 'aarch64'")
	}
	if !EmitObject(m, "arm64", "macho", buf.Concat(dir, "/native_dispatch_a64.o")) {
		return fail("expected EmitObject to succeed for 'arm64'")
	}
	return ""
}

// testTmpDir creates a fresh private directory for one test's output files, so
// concurrent runs of this package's tests (other sessions, CI shards) never write
// the same path; the caller removes it with `defer os.RemoveAll(dir)`.  Empty if
// it could not be created.
func testTmpDir() @[]char {
	dir, err := os.MkdirTemp("/tmp", "binate_native_test_")
	if present(err) {
		var none @[]char
		return none
	}
	return dir
}
