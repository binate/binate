package "pkg/binate/native"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/os"

// fail builds a @[]char failure message.
func fail(msg *[]readonly char) testing.TestResult {
	var r @[]char
	if len(msg) == 0 { return r }
	var out @[]char = make_slice(char, len(msg))
	for i := 0; i < len(msg); i++ { out[i] = msg[i] }
	return out
}

// EmitObject returns false for an unrecognised arch string.
func TestEmitObjectUnknownArch() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var m @ir.Module = ir.NewModule("\"main\"")
	if EmitObject(m, "mips", "elf", buf.Concat(dir, "/native_dispatch.o"), Options{}) {
		return fail("expected false for unknown arch 'mips'")
	}
	return ""
}

// Both "x86_64" and "x64" route to pkg/binate/native/x64.  Phase 3a's
// EmitObject writes a valid (empty-module) ELF; the dispatch test
// asserts both aliases reach the real backend.  Same shape as the
// aarch64 pair below.
func TestEmitObjectX64Aliases() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var m @ir.Module = ir.NewModule("\"main\"")
	if !EmitObject(m, "x86_64", "elf", buf.Concat(dir, "/native_dispatch_x64.o"), Options{}) {
		return fail("expected EmitObject to succeed for 'x86_64'")
	}
	if !EmitObject(m, "x64", "elf", buf.Concat(dir, "/native_dispatch_x64alias.o"), Options{}) {
		return fail("expected EmitObject to succeed for 'x64'")
	}
	return ""
}

// Both "aarch64" and "arm64" are accepted as the same backend; the
// dispatcher delegates to pkg/binate/native/arm64 in both cases. We don't
// actually link/run here — that's covered by arm64's own tests — but
// a successful EmitObject proves the dispatch table is wired.
func TestEmitObjectAArch64Aliases() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var m @ir.Module = ir.NewModule("\"main\"")
	// An empty module emits a zero-function text section; the arm64
	// backend still writes a valid .o.
	if !EmitObject(m, "aarch64", "macho", buf.Concat(dir, "/native_dispatch_aa.o"), Options{}) {
		return fail("expected EmitObject to succeed for 'aarch64'")
	}
	if !EmitObject(m, "arm64", "macho", buf.Concat(dir, "/native_dispatch_a64.o"), Options{}) {
		return fail("expected EmitObject to succeed for 'arm64'")
	}
	return ""
}

// EmitObject accepts Options on every arch, including a switch meant for
// another arch (X64RaxHome on aarch64 and arm32).
func TestEmitObjectAcceptsNativeOptions() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var m @ir.Module = ir.NewModule("\"main\"")
	var opts Options
	opts.X64RaxHome = true
	if !EmitObject(m, "x86_64", "elf", buf.Concat(dir, "/native_opts_x64.o"), opts) {
		return fail("expected EmitObject to succeed for 'x86_64' with X64RaxHome")
	}
	if !EmitObject(m, "aarch64", "macho", buf.Concat(dir, "/native_opts_aa.o"), opts) {
		return fail("expected EmitObject to accept X64RaxHome for 'aarch64'")
	}
	if !EmitObject(m, "arm32", "elf", buf.Concat(dir, "/native_opts_arm32.o"), opts) {
		return fail("expected EmitObject to accept X64RaxHome for 'arm32'")
	}
	return ""
}

// X64RaxHome reaches the x64 backend: a function with seven integer values live
// at once, none across a call, homes the seventh in RAX under it and in a
// callee-saved register otherwise, so the two objects differ.
func TestEmitObjectRoutesX64RaxHome() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var saved types.TargetInfo = types.GetTarget()
	var lp64 types.TargetInfo
	lp64.PointerSize = 8
	lp64.IntSize = 8
	lp64.MaxAlign = 8
	types.SetTarget(lp64)
	defer types.SetTarget(saved)
	var offPath @[]char = buf.Concat(dir, "/native_rax_off.o")
	var onPath @[]char = buf.Concat(dir, "/native_rax_on.o")
	if !EmitObject(sumModule(7), "x86_64", "elf", offPath, Options{}) {
		return fail("expected EmitObject to succeed for the sum module")
	}
	var on Options
	on.X64RaxHome = true
	if !EmitObject(sumModule(7), "x86_64", "elf", onPath, on) {
		return fail("expected EmitObject to succeed for the sum module with X64RaxHome")
	}
	var offBytes @[]uint8 = readObject(offPath)
	var onBytes @[]uint8 = readObject(onPath)
	if len(offBytes) == 0 || len(onBytes) == 0 { return fail("cannot read the emitted objects") }
	if sameBytes(offBytes, onBytes) { return fail("X64RaxHome should change the x64 object") }
	return ""
}

// sumModule returns a module "main" holding `func main.sum(p0, ..., p<n-1> int)
// int`, which returns the parameters' sum as a chain of integer ADDs, so all n
// parameters are live at the first ADD.
func sumModule(n int) @ir.Module {
	var noP @[]@ir.Param
	var res @[]@types.Type = make_slice(@types.Type, 1)
	res[0] = types.TypInt()
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func = ir.NewFunc("", "main.sum", noP, res)
	var ps @[]@ir.Param = make_slice(@ir.Param, n)
	for i := 0; i < n; i++ {
		ps[i] = irbuild.NewParam(f, "p", types.TypInt())
	}
	f.Params = ps
	var b @ir.Block = ir.AddBlock(f, "entry")
	var sum @ir.Instr = irbuild.NewParamRef(f, ps[0])
	for i := 1; i < n; i++ {
		var p @ir.Instr = irbuild.NewParamRef(f, ps[i])
		sum = irbuild.EmitBinop(b, iropcode.OP_ADD, sum, p, types.TypInt())
	}
	var rs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rs[0] = sum
	irbuild.EmitReturn(b, rs)
	m.AddFunc(f)
	return m
}

// readObject returns the first 64 KiB of the file at path (all of a small
// object), or nothing if it cannot be opened.
func readObject(path *[]readonly char) @[]uint8 {
	f, oerr := os.Open(path)
	if present(oerr) {
		var none @[]uint8
		return none
	}
	var data @[]uint8 = make_slice(uint8, 65536)
	n, _ := f.Read(data)
	_ = f.Close()
	if n < 0 { n = 0 }
	var out @[]uint8 = make_slice(uint8, n)
	for i := 0; i < n; i++ { out[i] = data[i] }
	return out
}

// sameBytes reports whether a and b hold the same bytes.
func sameBytes(a @[]uint8, b @[]uint8) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// testTmpDir creates a fresh private directory for one test's output files, so
// concurrent runs of this package's tests (other sessions, CI shards) never write
// the same path; the caller removes it with `defer os.RemoveAll(dir)`.  Empty if
// it could not be created.
func testTmpDir() @[]char {
	dir, err := os.MkdirTemp("/tmp", "binate_native_test_")
	if present(err) {
		var none @[]char
		return none
	}
	return dir
}
