package "pkg/binate/native/place"

import "pkg/binate/buf"
import "pkg/std/strconv"

// PlaceActive — see place.bni.
func PlaceActive(p PlaceOptions) bool {
	return p.Seed != 0
}

// PlaceHash — see place.bni for the exact definition.
func PlaceHash(seed int, key *[]readonly char) uint32 {
	var h uint32 = 0x811C9DC5
	for i := 0; i < len(key); i++ {
		h = (h ^ cast(uint32, key[i])) * 0x01000193
	}
	h = h ^ (cast(uint32, seed) * 0x9E3779B9)
	h = h ^ (h >> 16)
	h = h * 0x85EBCA6B
	h = h ^ (h >> 13)
	h = h * 0xC2B2AE35
	h = h ^ (h >> 16)
	return h
}

// placeAlignUp rounds a non-negative off up to a multiple of unit.
func placeAlignUp(off int, unit int) int {
	return (off + unit - 1) / unit * unit
}

// PlaceFillBefore — see place.bni.
func PlaceFillBefore(p PlaceOptions, sym *[]readonly char, unit int, off int) int {
	if !PlaceActive(p) { return 0 }
	var k uint32 = cast(uint32, PLACE_SPAN / unit)
	var phi int = unit * cast(int, PlaceHash(p.Seed, sym) % k)
	if p.Mode == PLACE_SHIFT { return phi }
	var pre int = (phi - placeAlignUp(off, unit)) % PLACE_SPAN
	if pre < 0 { pre = pre + PLACE_SPAN }
	return pre
}

// PlaceCheck — see place.bni.
func PlaceCheck(p PlaceOptions, unit int) @[]readonly char {
	if p.Seed < 0 || p.Seed > PLACE_SEED_MAX {
		return buf.Concat("function placement: the seed must be in 0..", strconv.Itoa(PLACE_SEED_MAX))
	}
	if p.Mode != PLACE_SHIFT && p.Mode != PLACE_PHASE {
		return "function placement: unknown mode"
	}
	if unit <= 0 || PLACE_SPAN % unit != 0 {
		return buf.Concat("function placement: the filler unit must divide ", strconv.Itoa(PLACE_SPAN))
	}
	return ""
}
