package "pkg/binate/native/place"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// The placement probe: PlaceFillBefore / PlaceFillAfter for the probed symbol,
// PlaceActive and PlaceCheck with a probe.  perf/placement/test_placehash.py pins
// the same vectors for the Python twin.

// probeOpts returns PlaceOptions{seed, mode} probing sym at phase.
func probeOpts(seed int, mode int, sym *[]readonly char, phase int) PlaceOptions {
	var p PlaceOptions = placeOpts(seed, mode)
	p.ProbeSym = buf.CopyStr(sym)
	p.ProbePhase = phase
	return p
}

// PlaceFillBefore / PlaceFillAfter match the probe vectors shared with the Python
// twin.
func TestPlaceProbePinnedVectors() testing.TestResult {
	var foo *[]readonly char = "bn_F1_4_main1_3_foo"
	var mn *[]readonly char = "bn_F1_4_main1_4_main"
	if PlaceFillBefore(probeOpts(0, PLACE_PHASE, foo, 32), foo, 16, 5) != 16 {
		return "probe foo@32 seed 0 phase/16/5"
	}
	if PlaceFillBefore(probeOpts(12345, PLACE_SHIFT, foo, 0), foo, 16, 100) != 16 {
		return "probe foo@0 seed 12345 shift/16/100"
	}
	if PlaceFillBefore(probeOpts(7, PLACE_PHASE, foo, 60), foo, 4, 3) != 56 {
		return "probe foo@60 seed 7 phase/4/3"
	}
	if PlaceFillBefore(probeOpts(0, PLACE_SHIFT, foo, 48), foo, 16, 48) != 0 {
		return "probe foo@48 seed 0 shift/16/48"
	}
	if PlaceFillBefore(probeOpts(0, PLACE_PHASE, foo, 32), mn, 16, 5) != 0 {
		return "probe foo, main at seed 0"
	}
	if PlaceFillBefore(probeOpts(7, PLACE_PHASE, foo, 32), mn, 4, 0) != 60 {
		return "probe foo, main seed 7 phase/4/0"
	}
	if PlaceFillBefore(probeOpts(7, PLACE_SHIFT, foo, 32), mn, 4, 100) != 60 {
		return "probe foo, main seed 7 shift/4/100"
	}
	if PlaceFillAfter(probeOpts(0, PLACE_PHASE, foo, 32), foo, 16) != 48 { return "after foo/16" }
	if PlaceFillAfter(probeOpts(0, PLACE_PHASE, foo, 48), foo, 0) != 64 { return "after foo/0" }
	if PlaceFillAfter(probeOpts(7, PLACE_PHASE, foo, 32), mn, 60) != 0 { return "after main" }
	if PlaceFillAfter(placeOpts(7, PLACE_PHASE), foo, 16) != 0 { return "after foo, no probe" }
	return ""
}

// A probe makes the options active, even at seed 0.
func TestPlaceActiveWithProbe() testing.TestResult {
	if !PlaceActive(probeOpts(0, PLACE_PHASE, "f", 0)) {
		return "a probe at seed 0 must be active"
	}
	if !PlaceActive(probeOpts(0, PLACE_SHIFT, "f", 16)) {
		return "a probe at seed 0 in shift mode must be active"
	}
	var p PlaceOptions = placeOpts(0, PLACE_PHASE)
	p.ProbePhase = 16
	if PlaceActive(p) { return "a probe phase without a symbol adds no filler" }
	return ""
}

// probeSeed is the seed of probe case i (0..3): the cases are seed 0 in both
// modes, then a nonzero seed in both modes.
func probeSeed(i int) int {
	if i < 2 { return 0 }
	return 12345
}

// probeMode is the mode of probe case i (see probeSeed).
func probeMode(i int) int {
	if i % 2 == 0 { return PLACE_PHASE }
	return PLACE_SHIFT
}

// For every legal probe phase, unit, offset, seed and mode, the probed function's
// fill lands its entry on the phase, the fill before and after it total
// PLACE_SPAN, and so the end of the filler after it is the same for every phase.
func TestPlaceProbeLandsOnPhaseAndRestoresOffsets() testing.TestResult {
	var foo *[]readonly char = "bn_F1_4_main1_3_foo"
	// The aarch64 / arm32 unit, then the x86-64 one.
	for unit := 4; unit <= 16; unit = unit * 4 {
		for c := 0; c < 4; c++ {
			for off := 0; off < 2 * PLACE_SPAN + 3; off = off + 5 {
				var aligned int = (off + unit - 1) / unit * unit
				// The function is 37 bytes, from its entry on; the next offset
				// after it and its filler must not depend on the phase.
				var after int = -1
				for phase := 0; phase < PLACE_SPAN; phase = phase + unit {
					var p PlaceOptions = probeOpts(probeSeed(c), probeMode(c), foo, phase)
					var pre int = PlaceFillBefore(p, foo, unit, off)
					if pre < 0 || pre >= PLACE_SPAN || pre % unit != 0 {
						return "a probe fill is not a unit multiple below PLACE_SPAN"
					}
					if (aligned + pre) % PLACE_SPAN != phase { return "the probe misses its phase" }
					var post int = PlaceFillAfter(p, foo, pre)
					if pre + post != PLACE_SPAN { return "the probe's filler must total PLACE_SPAN" }
					var end int = aligned + pre + 37 + post
					if after >= 0 && end != after { return "the code after the probe moved with its phase" }
					after = end
				}
			}
		}
	}
	return ""
}

// A probe leaves every other function's fill as the seed and mode give it.
func TestPlaceProbeLeavesOtherFunctions() testing.TestResult {
	var s @[]char = make_slice(char, 5)
	for c := 0; c < 4; c++ {
		var p PlaceOptions = probeOpts(probeSeed(c), probeMode(c), "bn_probe", 16)
		var plain PlaceOptions = placeOpts(probeSeed(c), probeMode(c))
		for i := 0; i < 200; i++ {
			synthSym(s, i)
			for off := 0; off < 70; off = off + 7 {
				if PlaceFillBefore(p, s, 4, off) != PlaceFillBefore(plain, s, 4, off) {
					return "a probe changed another function's fill"
				}
				if PlaceFillAfter(p, s, 12) != 0 { return "only the probed function has filler after it" }
			}
		}
	}
	return ""
}

// PlaceCheck accepts a probe phase that is a unit multiple in 0..PLACE_SPAN-1, at
// any seed, and rejects any other phase, and a probe phase without a symbol.
func TestPlaceCheckProbe() testing.TestResult {
	if len(PlaceCheck(probeOpts(0, PLACE_PHASE, "f", 0), 16)) != 0 { return "phase 0 is valid" }
	if len(PlaceCheck(probeOpts(0, PLACE_SHIFT, "f", 48), 16)) != 0 { return "phase 48 is valid" }
	if len(PlaceCheck(probeOpts(9, PLACE_PHASE, "f", 60), 4)) != 0 { return "phase 60/4 is valid" }
	if len(PlaceCheck(probeOpts(0, PLACE_PHASE, "f", 8), 16)) == 0 {
		return "phase 8 is not a multiple of 16"
	}
	if len(PlaceCheck(probeOpts(0, PLACE_PHASE, "f", 6), 4)) == 0 {
		return "phase 6 is not a multiple of 4"
	}
	if len(PlaceCheck(probeOpts(0, PLACE_PHASE, "f", 64), 16)) == 0 { return "phase 64 is too big" }
	if len(PlaceCheck(probeOpts(0, PLACE_PHASE, "f", 128), 4)) == 0 { return "phase 128 is too big" }
	if len(PlaceCheck(probeOpts(0, PLACE_PHASE, "f", -16), 16)) == 0 {
		return "a negative phase is invalid"
	}
	if len(PlaceCheck(probeOpts(0, PLACE_PHASE, "f", 16), 24)) == 0 {
		return "the unit is still checked with a probe"
	}
	var noSym PlaceOptions = placeOpts(0, PLACE_PHASE)
	noSym.ProbePhase = 16
	if len(PlaceCheck(noSym, 16)) == 0 { return "a probe phase without a symbol is invalid" }
	noSym.Seed = 5
	if len(PlaceCheck(noSym, 16)) == 0 {
		return "a probe phase without a symbol is invalid when seeded"
	}
	return ""
}
