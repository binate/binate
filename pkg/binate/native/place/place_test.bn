package "pkg/binate/native/place"

import "pkg/builtins/testing"

// Function-placement arithmetic: PlaceHash, PlaceFillBefore, PlaceActive and
// PlaceCheck.  perf/placement/test_placehash.py pins the same vectors for the
// Python twin (perf/placement/placehash.py); nothing runs those Python tests
// automatically, so run `python3 -m unittest discover perf/placement` when
// changing either implementation or either set of vectors.

// PlaceHash matches the vectors shared with the Python twin, including a negative
// seed (uint32(seed) wraps it).
func TestPlaceHashPinnedVectors() testing.TestResult {
	if PlaceHash(0, "") != 0xAB3E7C0B { return "PlaceHash(0, \"\")" }
	if PlaceHash(1, "") != 0x4A216C31 { return "PlaceHash(1, \"\")" }
	if PlaceHash(0, "a") != 0x1A80B1B3 { return "PlaceHash(0, \"a\")" }
	if PlaceHash(1, "a") != 0x1156BD31 { return "PlaceHash(1, \"a\")" }
	if PlaceHash(7, "hello world") != 0x214B4E12 { return "PlaceHash(7, \"hello world\")" }
	if PlaceHash(12345, "bn_F1_4_main1_3_foo") != 0xE67F5803 {
		return "PlaceHash(12345, \"bn_F1_4_main1_3_foo\")"
	}
	if PlaceHash(2147483647, "bn_F1_4_main1_4_main") != 0xEE674A5E {
		return "PlaceHash(2147483647, \"bn_F1_4_main1_4_main\")"
	}
	if PlaceHash(-1, "x") != 0x5E4EB042 { return "PlaceHash(-1, \"x\")" }
	return ""
}

// placeOpts returns PlaceOptions{seed, mode}.
func placeOpts(seed int, mode int) PlaceOptions {
	var p PlaceOptions
	p.Seed = seed
	p.Mode = mode
	return p
}

// PlaceFillBefore matches the vectors shared with the Python twin.
func TestPlaceFillBeforePinnedVectors() testing.TestResult {
	var foo *[]readonly char = "bn_F1_4_main1_3_foo"
	var mn *[]readonly char = "bn_F1_4_main1_4_main"
	if PlaceFillBefore(placeOpts(12345, PLACE_SHIFT), foo, 16, 0) != 48 { return "shift foo/16/0" }
	if PlaceFillBefore(placeOpts(12345, PLACE_PHASE), foo, 16, 5) != 32 { return "phase foo/16/5" }
	if PlaceFillBefore(placeOpts(12345, PLACE_PHASE), foo, 16, 100) != 0 {
		return "phase foo/16/100"
	}
	if PlaceFillBefore(placeOpts(12345, PLACE_SHIFT), foo, 4, 100) != 12 { return "shift foo/4/100" }
	if PlaceFillBefore(placeOpts(12345, PLACE_PHASE), foo, 4, 100) != 40 { return "phase foo/4/100" }
	if PlaceFillBefore(placeOpts(7, PLACE_PHASE), mn, 4, 0) != 60 { return "phase main/4/0" }
	if PlaceFillBefore(placeOpts(7, PLACE_SHIFT), mn, 4, 100) != 60 { return "shift main/4/100" }
	if PlaceFillBefore(placeOpts(42, PLACE_PHASE), "main.alpha", 16, 3) != 32 {
		return "phase main.alpha/16/3"
	}
	if PlaceFillBefore(placeOpts(2147483647, PLACE_PHASE), mn, 4, 64) != 56 {
		return "phase main/4/64"
	}
	if PlaceFillBefore(placeOpts(0, PLACE_PHASE), "x", 16, 5) != 0 { return "seed 0 fills nothing" }
	return ""
}

// Shift and phase mode give the fills the documented formulas give, computed
// here from the pinned hash of foo under seed 12345, at offsets where the two
// modes disagree: shift mode ignores the offset, phase mode compensates for it.
func TestPlaceFillBeforeHonorsMode() testing.TestResult {
	var foo *[]readonly char = "bn_F1_4_main1_3_foo"
	var h uint32 = 0xE67F5803
	if PlaceHash(12345, foo) != h { return "PlaceHash(12345, foo) changed" }
	var units @[]int = @[]int{4, 16, 4, 16}
	var offs @[]int = @[]int{100, 5, 37, 100}
	for i := 0; i < len(units); i++ {
		var unit int = units[i]
		var off int = offs[i]
		var shift int = unit * cast(int, h % cast(uint32, PLACE_SPAN / unit))
		var aligned int = (off + unit - 1) / unit * unit
		var phase int = ((shift - aligned) % PLACE_SPAN + PLACE_SPAN) % PLACE_SPAN
		if shift == phase { return "each case must tell the two modes apart" }
		if PlaceFillBefore(placeOpts(12345, PLACE_SHIFT), foo, unit, off) != shift {
			return "shift mode must fill unit * (hash mod K), whatever the offset"
		}
		if PlaceFillBefore(placeOpts(12345, PLACE_PHASE), foo, unit, off) != phase {
			return "phase mode must fill from alignUp(off, unit) to the symbol's phase"
		}
	}
	return ""
}

// PlaceActive is false only for seed 0.
func TestPlaceActiveOnlyWithSeed() testing.TestResult {
	var zero PlaceOptions
	if PlaceActive(zero) { return "the zero options must be inactive" }
	if PlaceActive(placeOpts(0, PLACE_SHIFT)) { return "seed 0 must be inactive in shift mode" }
	if !PlaceActive(placeOpts(1, PLACE_PHASE)) { return "seed 1 must be active" }
	if !PlaceActive(placeOpts(PLACE_SEED_MAX, PLACE_SHIFT)) {
		return "the largest seed must be active"
	}
	return ""
}

// synthSym writes a distinct five-character symbol for i (0 <= i < 26^3) into s.
func synthSym(s @[]char, i int) {
	s[0] = 's'
	s[1] = 'a' + cast(char, i % 26)
	s[2] = 'a' + cast(char, i / 26 % 26)
	s[3] = 'a' + cast(char, i / 676 % 26)
	s[4] = '_'
}

// Over 1024 symbols, shift fills are unit multiples below PLACE_SPAN, every one of
// the PLACE_SPAN / unit values occurs about equally often, and another seed
// changes most of them.
func TestPlaceShiftFillDistribution() testing.TestResult {
	var s @[]char = make_slice(char, 5)
	// The aarch64 / arm32 unit, then the x86-64 one.
	for unit := 4; unit <= 16; unit = unit * 4 {
		var k int = PLACE_SPAN / unit
		var counts @[]int = make_slice(int, k)
		var changed int = 0
		for i := 0; i < 1024; i++ {
			synthSym(s, i)
			var fill int = PlaceFillBefore(placeOpts(99, PLACE_SHIFT), s, unit, i * 7)
			if fill < 0 || fill >= PLACE_SPAN || fill % unit != 0 {
				return "a shift fill is not a unit multiple below PLACE_SPAN"
			}
			counts[fill / unit] = counts[fill / unit] + 1
			if PlaceFillBefore(placeOpts(100, PLACE_SHIFT), s, unit, i * 7) != fill {
				changed = changed + 1
			}
		}
		var expect int = 1024 / k
		for j := 0; j < k; j++ {
			if counts[j] < expect / 2 || counts[j] > expect * 3 / 2 {
				return "shift fills are not roughly balanced over the unit multiples"
			}
		}
		// A changed seed keeps a fill with probability 1/k.
		if changed < 1024 * (k - 1) / k * 3 / 4 { return "another seed must change most fills" }
	}
	return ""
}

// In phase mode the fill brings the next unit boundary at or after off to the
// symbol's phase, for offsets that are and are not unit multiples.
func TestPlacePhaseFillReachesPhase() testing.TestResult {
	var s @[]char = make_slice(char, 5)
	// The aarch64 / arm32 unit, then the x86-64 one.
	for unit := 4; unit <= 16; unit = unit * 4 {
		var k uint32 = cast(uint32, PLACE_SPAN / unit)
		for i := 0; i < 256; i++ {
			synthSym(s, i)
			var phi int = unit * cast(int, PlaceHash(31337, s) % k)
			for off := 0; off < 2 * PLACE_SPAN + 3; off = off + 3 {
				var fill int = PlaceFillBefore(placeOpts(31337, PLACE_PHASE), s, unit, off)
				if fill < 0 || fill >= PLACE_SPAN || fill % unit != 0 {
					return "a phase fill is not a unit multiple below PLACE_SPAN"
				}
				// The next unit boundary at or after off.
				var aligned int = (off + unit - 1) / unit * unit
				if (aligned + fill) % PLACE_SPAN != phi {
					return "a phase fill misses the symbol's phase"
				}
			}
		}
	}
	return ""
}

// PlaceCheck accepts the valid seeds, modes and units and names what is wrong
// otherwise.
func TestPlaceCheck() testing.TestResult {
	if len(PlaceCheck(placeOpts(1, PLACE_PHASE), 4)) != 0 { return "phase/4 must be valid" }
	if len(PlaceCheck(placeOpts(PLACE_SEED_MAX, PLACE_SHIFT), 16)) != 0 {
		return "the largest seed must be valid"
	}
	if len(PlaceCheck(placeOpts(1, PLACE_PHASE), 64)) != 0 { return "a unit of 64 must be valid" }
	if len(PlaceCheck(placeOpts(-1, PLACE_PHASE), 4)) == 0 { return "a negative seed is invalid" }
	if sizeof(int) > 4 {
		// Computed at run time: PLACE_SEED_MAX + 1 does not fit an ILP32 int.
		var above int = PLACE_SEED_MAX
		above = above + 1
		if len(PlaceCheck(placeOpts(above, PLACE_PHASE), 4)) == 0 {
			return "a seed above PLACE_SEED_MAX is invalid"
		}
	}
	if len(PlaceCheck(placeOpts(1, 2), 4)) == 0 { return "mode 2 is invalid" }
	if len(PlaceCheck(placeOpts(1, -1), 4)) == 0 { return "mode -1 is invalid" }
	if len(PlaceCheck(placeOpts(1, PLACE_PHASE), 0)) == 0 { return "unit 0 is invalid" }
	if len(PlaceCheck(placeOpts(1, PLACE_PHASE), 24)) == 0 { return "unit 24 does not divide 64" }
	if len(PlaceCheck(placeOpts(1, PLACE_PHASE), 128)) == 0 { return "unit 128 exceeds 64" }
	return ""
}
