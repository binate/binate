// Package strength holds the target-neutral integer math the native backends
// use to strength-reduce arithmetic by a constant: power-of-two detection (a
// multiply, divide or element-index scale by 2^k becomes a shift) and the
// Granlund-Montgomery magic numbers that turn a constant-divisor division into
// a multiply-high plus shifts.  Pure integer code with no dependencies.
package "pkg/binate/native/strength"

// Pow2Log returns k when v == 2^k (k in [0, 63]), else -1.
func Pow2Log(v uint64) int

// AbsU64 returns |c| as a uint64; |MinInt64| is 2^63.
func AbsU64(c int64) uint64

// MagicSigned / MagicUnsigned describe how to lower a constant-divisor signed /
// unsigned division to a multiply-high plus shifts (Granlund-Montgomery, Hacker's
// Delight Ch.10).  See ComputeMagicSigned / ComputeMagicUnsigned for the exact
// evaluation sequence each field feeds.
type MagicSigned struct {
	M     int64
	Shift int
	AddN  bool
	SubN  bool
}

type MagicUnsigned struct {
	M     uint64
	Shift int
	Add   bool
}

// ComputeMagicSigned returns the signed magic constants for divisor `d` at
// `width` bits (32 or 64).  Precondition: d != 0, |d| != 1, and |d| is not a
// power of two — those are lowered directly to mov / neg / shift by the caller.
func ComputeMagicSigned(d int64, width int) MagicSigned

// ComputeMagicUnsigned returns the unsigned magic constants for divisor `d` at
// `width` bits (32 or 64).  Precondition: d >= 2 and d is not a power of two.
func ComputeMagicUnsigned(d uint64, width int) MagicUnsigned
