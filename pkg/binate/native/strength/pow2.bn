package "pkg/binate/native/strength"

// Pow2Log returns k when v == 2^k (k in [0, 63]), else -1.
func Pow2Log(v uint64) int {
	if v == cast(uint64, 0) || (v & (v - cast(uint64, 1))) != cast(uint64, 0) {
		return -1
	}
	var k int = 0
	var x uint64 = v
	for x > cast(uint64, 1) {
		x = x >> cast(uint64, 1)
		k = k + 1
	}
	return k
}

// AbsU64 returns |c| as a uint64.  The negation is done in uint64 so that
// MinInt64 maps to 2^63 rather than overflowing.
func AbsU64(c int64) uint64 {
	if c < cast(int64, 0) {
		return cast(uint64, 0) - cast(uint64, c)
	}
	return cast(uint64, c)
}
