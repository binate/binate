package "pkg/binate/native/strength"

import "pkg/builtins/testing"

// Pow2Log returns the exponent of an exact power of two (including 2^0 and
// 2^63) and -1 for everything else.
func TestPow2Log() testing.TestResult {
	if Pow2Log(cast(uint64, 1)) != 0 { return "Pow2Log(1) should be 0" }
	if Pow2Log(cast(uint64, 2)) != 1 { return "Pow2Log(2) should be 1" }
	if Pow2Log(cast(uint64, 16)) != 4 { return "Pow2Log(16) should be 4" }
	if Pow2Log(cast(uint64, 1) << cast(uint64, 40)) != 40 { return "Pow2Log(2^40) should be 40" }
	if Pow2Log(cast(uint64, 1) << cast(uint64, 63)) != 63 { return "Pow2Log(2^63) should be 63" }
	if Pow2Log(cast(uint64, 0)) != -1 { return "Pow2Log(0) should be -1" }
	if Pow2Log(cast(uint64, 3)) != -1 { return "Pow2Log(3) should be -1" }
	if Pow2Log(cast(uint64, 24)) != -1 { return "Pow2Log(24) should be -1" }
	if Pow2Log(cast(uint64, 0xFFFFFFFFFFFFFFFF)) != -1 { return "Pow2Log(all ones) should be -1" }
	return ""
}

// AbsU64 negates in uint64, so MinInt64 maps to 2^63.
func TestAbsU64() testing.TestResult {
	if AbsU64(cast(int64, 5)) != cast(uint64, 5) { return "AbsU64(5) should be 5" }
	if AbsU64(cast(int64, -5)) != cast(uint64, 5) { return "AbsU64(-5) should be 5" }
	if AbsU64(cast(int64, 0)) != cast(uint64, 0) { return "AbsU64(0) should be 0" }
	var minI64 int64 = cast(int64, -9223372036854775807) - cast(int64, 1)
	var twoTo63 uint64 = cast(uint64, 1) << cast(uint64, 63)
	if AbsU64(minI64) != twoTo63 { return "AbsU64(MinInt64) should be 2^63" }
	return ""
}
