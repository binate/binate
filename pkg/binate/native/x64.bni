// Package x64 is the native SysV-AMD64 backend (sibling of
// pkg/binate/native/aarch64 and pkg/binate/native/arm32).
package "pkg/binate/native/x64"

import "pkg/binate/ir"
import "pkg/binate/native/place"

// Options holds the x64 backend's code-generation switches; the zero value is
// the default codegen.
type Options struct {
	// RaxHome (bnc -fx64-rax-home, off by default) adds RAX to the caller-saved
	// GP home pool, filled last.
	RaxHome bool
	// FarDisp (bnc -fx64-far-disp=N, a test aid; 0 leaves it off) addresses a frame
	// slot past displacement N through a register, as one past a signed 32-bit
	// displacement always is (x64_frame_far.bn).
	FarDisp int
	// Place positions functions with INT3 filler, in 16-byte units, before each
	// function's 16-byte entry alignment and right after a probed function
	// (place.PlaceOptions; bnc -fnative-place-seed / -fnative-place-probe).  The
	// zero value adds none.
	Place place.PlaceOptions
}

// EmitObject lowers mod to an x86-64 object at path in the requested
// object `format` ("elf" / "macho"; defaults to ELF), with the
// code-generation switches in opts.  Every function gets a SysV-AMD64
// prologue / epilogue.  Returns true on success.
func EmitObject(mod @ir.Module, format *[]readonly char, path *[]readonly char, opts Options) bool
