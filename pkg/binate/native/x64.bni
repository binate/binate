// Package amd64 is the native SysV-AMD64 backend (sibling of
// pkg/binate/native/arm64).  Named amd64 rather than x64 to avoid the
// mangled-symbol-prefix collision with pkg/binate/asm/x64 — both would
// otherwise produce `bn_x64__*` symbols.
//
// See explorations/plan-native-x64.md.
package "pkg/binate/native/x64"

import "pkg/binate/ir"

// EmitObject lowers mod to an x86-64 object at path in the requested
// object `format` ("elf" / "macho"; defaults to ELF).  Every function
// gets a SysV-AMD64 prologue / epilogue and a `ret`; other IR ops are
// filled in across the per-op phases.  Returns true on success.
func EmitObject(mod @ir.Module, format *[]const char,
	path *[]const char) bool
