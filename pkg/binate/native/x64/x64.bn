package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/native/common"

// ============================================================
// EmitObject — module entry
// ============================================================

// EmitObject lowers `mod` to an x86-64 object at `path` in `format`
// ("elf" or "macho"; anything else defaults to ELF, this backend's primary
// runtime target).  The emission algorithm is the one shared by every
// native backend (common.EmitObject); this delegates to it through an
// x64Emitter, which supplies the per-arch steps — word size, the
// object-format linkage prefix, function/vtable/descriptor emission, fixup
// resolution, and the ELF/Mach-O writer.  See x64_emitter.bn.
func EmitObject(mod @ir.Module, format *[]readonly char, path *[]readonly char) bool {
	var em x64Emitter
	var e *common.ArchEmitter = &em
	return common.EmitObject(e, mod, format, path)
}

// emitStringTable emits, per collected string literal: a read-only byte blob
// (`Lstr_<id>`, via irdata.BuildStringBlob — exactly the literal's bytes, no NUL,
// reloc-free → rodata) and a static managed-slice header (`stringMSSym`, via
// irdata.BuildStringMSHeader — carries a data pointer, so weak + module-qualified in
// `data`).  The OP_RODATA_MSLICE/SLICE use-sites address the header directly
// instead of building it on the stack per use.  LEA reaches resolve via
// FIX_REL32.  Same convention as arm64's emitStringTable.
func emitStringTable(a @asm.Assembler, pkgName *[]readonly char, strings @[]ir.StringConst) {
	for i := 0; i < len(strings); i++ {
		var sc ir.StringConst = strings[i]
		common.EmitDataGlobal(a, irdata.BuildStringBlob(common.StringLabel(sc.ID), sc.Data))
	}
	for i := 0; i < len(strings); i++ {
		var sc ir.StringConst = strings[i]
		common.EmitDataGlobal(a,
				irdata.BuildStringMSHeader(
						stringMSSym(pkgName, sc.ID), common.StringLabel(sc.ID), sc.Len, irdata.DG_WEAK))
	}
}

// emitGlobals emits package-level variable storage via the shared
// irdata.BuildGlobalVar (a mutable, strong, SizeOf-byte zero blob, AlignOf-aligned)
// lowered through common.EmitDataGlobal — the same builder the LLVM backend
// uses, so the storage size can't drift (the old hand-rolled path rounded up to
// 8 bytes, vs LLVM's exact type size).  EmitDataGlobal opens the writable `data`
// section (ELF .data) lazily, only for a non-extern global, so a module whose
// globals are ALL imported externs leaves no empty data section behind.  Use
// sites reach the symbol via RIP-relative LEA (emitGlobalAddr → R_X86_64_PC32).
func emitGlobals(a @asm.Assembler, pkgName *[]readonly char, globals @[]@ir.Global) {
	for i := 0; i < len(globals); i++ {
		var g @ir.Global = globals[i]
		if g == nil { continue }
		// An imported extern var is DEFINED by its owning package's object;
		// here it is only referenced, so emit no storage (a definition would
		// be a duplicate symbol at link time) — not a DataGlobal.  The
		// reference (emitGlobalAddr) mangles to the owner's symbol and resolves
		// cross-object, exactly as the LLVM `external global` declaration does.
		if g.IsExtern { continue }
		var sz int = 8
		var al int = 8
		if g.Typ != nil {
			sz = g.Typ.SizeOf()
			al = g.Typ.AlignOf()
		}
		common.EmitDataGlobal(a, irdata.BuildGlobalVar(globalSymFor(pkgName, g.Name), sz, al))
	}
}
