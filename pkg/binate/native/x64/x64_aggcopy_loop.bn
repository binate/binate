package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/native/common"

// A large aggregate copy or zero-fill is a loop rather than straight-line code, so its
// code size stays constant whatever the aggregate's size — straight-line, a [5000]uint8
// is over three hundred MOVUPS pairs, at every copy.  Up to aggCopyUnrollMaxBytes it
// stays straight-line: the code is still small there, and pays no loop overhead.  Each
// loop jumps back with its displacement already resolved (x64.JccOffset), so it records
// no fixup: the function emitter takes a fixup for a branch out of the op and drops its
// register cache, which a loop running wholly within the op does not need.
//
// A loop addresses both sides as base + index + displacement, so its bases stay put and
// it needs only one register of its own, the index, besides XMM14 / XMM15 (the FP
// scratch pair, which hold nothing across ops).

// aggCopyUnrollMaxBytes is the largest copy or zero-fill emitted straight-line (eight
// MOVUPS pairs, or sixteen zero-word stores).
const aggCopyUnrollMaxBytes int = 128

// aggCopyLoopChunk is how many bytes one iteration of a copy or zero-fill loop moves.
const aggCopyLoopChunk int = 32

// aggCopyIsLoop reports whether an sz-byte copy or zero-fill is a loop.
func aggCopyIsLoop(sz int) bool {
	return sz > aggCopyUnrollMaxBytes
}

// jumpBackX64 emits Jcc back to the instruction at byte offset top of the current
// section (a loop's first instruction).
func jumpBackX64(a @asm.Assembler, cc int, top int) {
	x64.JccOffset(a, cc, top - a.Sections[a.Current].Len)
}

// emitCopyLoopX64 copies sz bytes (at least aggCopyLoopChunk) from [srcBase + srcOff] to
// [dstBase + dstOff], 32 bytes per iteration through XMM14 / XMM15, indexed by idx
// counting down from sz - 32 until it goes negative.  The sz % 32 bytes left over at the
// bottom are copied by re-copying the first 32 bytes: that overlaps bytes the loop
// already copied, which is harmless as the source and destination are disjoint (or the
// same bytes).  idx
// must differ from both bases and from RSP (which cannot index); the bases are left
// intact.
func emitCopyLoopX64(a @asm.Assembler, dstBase int, dstOff int, srcBase int, srcOff int, sz int,
		idx int) {
	if sz < aggCopyLoopChunk {
		a.SetError("native x64: a copy loop needs at least 32 bytes")
		return
	}
	if idx == x64.RSP || idx == dstBase || idx == srcBase {
		a.SetError("native x64: a copy loop's index must be neither RSP nor a base")
		return
	}
	emitConstInt64(a, idx, cast(int64, sz - aggCopyLoopChunk))
	var top int = a.Sections[a.Current].Len
	emitCopyChunkX64(a, dstBase, dstOff, srcBase, srcOff, idx)
	x64.Sub(a, x64.Reg(idx, x64.SZ64), x64.Imm(aggCopyLoopChunk))
	jumpBackX64(a, x64.CC_NS, top)
	if sz % aggCopyLoopChunk != 0 { emitCopyChunkX64(a, dstBase, dstOff, srcBase, srcOff, -1) }
}

// emitCopyChunkX64 copies the 32 bytes at [srcBase + idx + srcOff] to [dstBase + idx +
// dstOff] through XMM14 / XMM15 (no index when idx is -1).
func emitCopyChunkX64(a @asm.Assembler, dstBase int, dstOff int, srcBase int, srcOff int, idx int) {
	x64.Movups_load(a, FP_SCRATCH_A, x64.MemIdx(srcBase, idx, 1, srcOff, x64.SZ64))
	x64.Movups_load(a, FP_SCRATCH_B, x64.MemIdx(srcBase, idx, 1, srcOff + 16, x64.SZ64))
	x64.Movups_store(a, x64.MemIdx(dstBase, idx, 1, dstOff, x64.SZ64), FP_SCRATCH_A)
	x64.Movups_store(a, x64.MemIdx(dstBase, idx, 1, dstOff + 16, x64.SZ64), FP_SCRATCH_B)
}

// emitFrameZeroX64 zero-fills the sz-byte frame region at [RSP + off] (sz a multiple of
// 8, as PlanFrame rounds every region): a zero word at a time up to
// aggCopyUnrollMaxBytes, else with a loop storing a zeroed XMM14 twice per iteration,
// indexed by a claimed register counting down as in emitCopyLoopX64, the bytes left over
// at the bottom zeroed by re-zeroing the first 32.
func emitFrameZeroX64(a @asm.Assembler, rm @common.RegMap, off int, sz int) {
	if !aggCopyIsLoop(sz) {
		for bo := 0; bo < sz; bo = bo + 8 {
			x64.Mov(a, x64.Mem(x64.RSP, off + bo, x64.SZ64), x64.Imm(0))
		}
		return
	}
	var idx int = scratchReg(rm)
	x64.Xorps(a, FP_SCRATCH_A, FP_SCRATCH_A)
	emitConstInt64(a, idx, cast(int64, sz - aggCopyLoopChunk))
	var top int = a.Sections[a.Current].Len
	emitZeroChunkX64(a, off, idx)
	x64.Sub(a, x64.Reg(idx, x64.SZ64), x64.Imm(aggCopyLoopChunk))
	jumpBackX64(a, x64.CC_NS, top)
	if sz % aggCopyLoopChunk != 0 { emitZeroChunkX64(a, off, -1) }
}

// emitZeroChunkX64 stores the zeroed XMM14 to the 32 bytes at [RSP + idx + off] (no
// index when idx is -1).
func emitZeroChunkX64(a @asm.Assembler, off int, idx int) {
	x64.Movups_store(a, x64.MemIdx(x64.RSP, idx, 1, off, x64.SZ64), FP_SCRATCH_A)
	x64.Movups_store(a, x64.MemIdx(x64.RSP, idx, 1, off + 16, x64.SZ64), FP_SCRATCH_A)
}
