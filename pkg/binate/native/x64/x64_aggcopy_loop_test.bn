package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/builtins/testing"

// Tests for the copy / zero-fill loops (x64_aggcopy_loop.bn): past aggCopyUnrollMaxBytes
// a copy or zero-fill is a loop whose code size does not grow with the aggregate,
// jumping back without a fixup.  The goldens are clang's encodings of the same
// instructions.

// sameTextX64 reports whether two assemblers emitted the same text bytes.
func sameTextX64(a @asm.Assembler, b @asm.Assembler) bool {
	if a.Sections[0].Len != b.Sections[0].Len { return false }
	for i := 0; i < a.Sections[0].Len; i++ {
		if a.Sections[0].Data[i] != b.Sections[0].Data[i] { return false }
	}
	return true
}

// A 5000-byte copy from [RSI] to [RDI] indexed by RDX: RDX counts down from 4968 by 32
// through a MOVUPS pair each way via XMM14 / XMM15, then the first 32 bytes are re-copied
// for the 8 left over at the bottom.
func TestCopyLoopX64Golden() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitAggMemcpyX64(a, x64.RDI, x64.RSI, 5000, x64.RDX)
	if a.Sections[0].NumFixups != 0 { return "a copy loop must jump back without a fixup" }
	return x64FoldGolden(a,
			"48 c7 c2 68 13 00 00 44 0f 10 34 16 44 0f 10 7c 16 10 44 0f 11 34 17 44 0f 11 7c 17 10 "
					"48 83 ea 20 79 e4 44 0f 10 36 44 0f 10 7e 10 44 0f 11 37 44 0f 11 7f 10",
			"5000-byte copy")
}

// A large aggregate load is the loop indexed by the result register R10 into the region
// at RSP+0x100 — a whole number of chunks, so nothing is re-copied — before R10 takes the
// region's address.
func TestAggLoadCopyLoopX64Golden() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitAggLoadCopyX64(a, x64.R10, 0x100, x64.RSI, 0, 4096)
	return x64FoldGolden(a,
			"49 c7 c2 e0 0f 00 00 46 0f 10 34 16 46 0f 10 7c 16 10 46 0f 11 b4 14 00 01 00 00 "
					"46 0f 11 bc 14 10 01 00 00 49 83 ea 20 79 dd 4c 8d 94 24 00 01 00 00",
			"4096-byte aggregate load")
}

// A large frame region is zeroed by storing a zeroed XMM14 twice per iteration, indexed
// by a claimed pool register (R10), then the first 32 bytes again for the 16 left over.
func TestFrameZeroLoopX64Golden() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitFrameZeroX64(a, common.NewRegMap(callconv.SysV_AMD64()), 16, 4400)
	return x64FoldGolden(a,
			"45 0f 57 f6 49 c7 c2 10 11 00 00 46 0f 11 74 14 10 46 0f 11 74 14 20 49 83 ea 20 79 ee "
					"44 0f 11 74 24 10 44 0f 11 74 24 20",
			"4400-byte zero-fill")
}

// At the threshold a copy and a zero-fill stay straight-line — eight MOVUPS pairs,
// sixteen zero-word stores — and one more word makes the copy a loop.
func TestAggCopyUnrolledAtThresholdX64() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitAggMemcpyX64(a, x64.RDI, x64.RSI, 128, x64.RDX)
	var ref @asm.Assembler = emitMkAsm()
	for off := 0; off < 128; off = off + 16 {
		x64.Movups_load(ref, FP_SCRATCH_A, x64.Mem(x64.RSI, off, x64.SZ64))
		x64.Movups_store(ref, x64.Mem(x64.RDI, off, x64.SZ64), FP_SCRATCH_A)
	}
	if !sameTextX64(a, ref) { return "a 128-byte copy stays eight MOVUPS pairs" }
	var b @asm.Assembler = emitMkAsm()
	emitAggMemcpyX64(b, x64.RDI, x64.RSI, 136, x64.RDX)
	var loop @asm.Assembler = emitMkAsm()
	emitCopyLoopX64(loop, x64.RDI, 0, x64.RSI, 0, 136, x64.RDX)
	if !sameTextX64(b, loop) { return "a 136-byte copy is the loop" }
	var c @asm.Assembler = emitMkAsm()
	emitFrameZeroX64(c, common.NewRegMap(callconv.SysV_AMD64()), 16, 128)
	var zref @asm.Assembler = emitMkAsm()
	for bo := 0; bo < 128; bo = bo + 8 {
		x64.Mov(zref, x64.Mem(x64.RSP, 16 + bo, x64.SZ64), x64.Imm(0))
	}
	if !sameTextX64(c, zref) {
		return "a 128-byte zero-fill stays sixteen zero-word stores"
	}
	return ""
}

// A copy loop whose index is RSP or one of its bases has no correct encoding (RSP cannot
// index; an index that is a base moves the base too), so it fails loud.
func TestCopyLoopX64RejectsBadIndex() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitCopyLoopX64(a, x64.RDI, 0, x64.RSI, 0, 256, x64.RSP)
	if !a.HasError { return "a copy loop indexed by RSP must fail loud" }
	var b @asm.Assembler = emitMkAsm()
	emitCopyLoopX64(b, x64.RDI, 0, x64.RSI, 0, 256, x64.RSI)
	if !b.HasError { return "a copy loop indexed by its source base must fail loud" }
	var c @asm.Assembler = emitMkAsm()
	emitCopyLoopX64(c, x64.RSP, 16, x64.RSI, 0, 256, x64.RSP)
	if !c.HasError { return "a copy loop indexed by its destination base must fail loud" }
	return ""
}
