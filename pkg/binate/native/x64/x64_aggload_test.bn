package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A 31-byte aggregate load from [RSI] into the frame region at RSP+0x100 with
// result register R10: the 2- and 1-byte tail pieces (bytes 28-29, 30) go
// through R10 to RSP-relative stores first; then R10 takes the region's address
// and is the destination base for the 16-byte MOVUPS (0-15), 8-byte MOVLPS
// (16-23) and 4-byte MOVSS (24-27) through XMM14 — no register besides R10 and
// RSI.
func TestEmitAggLoadCopyX64Golden() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitAggLoadCopyX64(a, x64.R10, 0x100, x64.RSI, 0, 31)
	var want *[]readonly char = "66 44 8b 56 1c 66 44 89 94 24 1c 01 00 00 44 8a 56 1e "
			"44 88 94 24 1e 01 00 00 4c 8d 94 24 00 01 00 00 44 0f 10 36 45 0f 11 32 "
			"44 0f 12 76 10 45 0f 13 72 10 f3 44 0f 10 76 18 f3 45 0f 11 72 18"
	return x64FoldGolden(a, want, "31-byte aggregate load from a pointer")
}

// From a stack slot the source is addressed off RSP, so the copy uses only the
// result register: a 12-byte load from RSP+0x40 into RSP+0x80 is the address
// LEA, then an 8-byte MOVLPS pair (bytes 0-7) and a 4-byte MOVSS pair (8-11).
func TestEmitAggLoadCopyX64StackSourceGolden() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitAggLoadCopyX64(a, x64.R10, 0x80, x64.RSP, 0x40, 12)
	return x64FoldGolden(a,
			"4c 8d 94 24 80 00 00 00 44 0f 12 74 24 40 45 0f 13 32 f3 44 0f 10 74 24 48 f3 45 0f 11 72 08",
			"12-byte aggregate load from a stack slot")
}

// A stack source is taken into a register only when it saves bytes: three or
// more source accesses at offsets past a 1-byte displacement.
func TestX64AggLoadLeaSource() testing.TestResult {
	if x64AggLoadLeaSource(0x40, 48) { return "a slot within 1-byte displacements stays RSP-relative" }
	if x64AggLoadLeaSource(0x200, 24) { return "two source accesses (16 + 8) stay RSP-relative" }
	if !x64AggLoadLeaSource(0x200, 40) { return "three source accesses (16 + 16 + 8) take a LEA" }
	if !x64AggLoadLeaSource(0x200, 7) { return "three tail pieces (4 + 2 + 1) take a LEA" }
	if x64AggLoadLeaSource(0x200, 6) { return "two tail pieces (4 + 2) stay RSP-relative" }
	return ""
}

// A far stack-slot load whose slot address an earlier instruction left cached
// (in R10) reads the source through that register: the operand claim holds
// R10 and the result takes R11, so a LEA into a third register would panic in a
// function with homes in RCX and RDX.  The only LEA emitted is the result's.
func TestEmitAggLoadCachedSourceUnderBars() testing.TestResult {
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var rec @types.Type = types.MakeArrayType(types.TypUint8(), 48)
	var slot @ir.Instr = irbuild.EmitAlloc(b, rec)
	var ld @ir.Instr = irbuild.EmitLoad(b, slot, rec)
	var none @[]int
	var m @common.RegMap = rcSpilledMap(none)
	rcRegion(m, slot.ID, 48, 0x200)
	rcRegion(m, ld.ID, 48, 0x300)
	if getOperand(opsMkAssembler(), m, slot.ID) != x64.R10 || m.LookupReg(slot.ID) != x64.R10 {
		return "setup: the slot address should be cached in R10"
	}
	m.ClearUsed()
	if !rcEmitBarred(m, ld) { return "the load must emit with R10 and R11" }
	var a @asm.Assembler = opsMkAssembler()
	m.ClearUsed()
	claimCachedOperands(m, ld)
	emitAggLoad(a, "main", m, ld, slot)
	if x64PairCount(a, 0x48, 0x8d) + x64PairCount(a, 0x4c, 0x8d) != 1 {
		return "only the result's address should take a LEA"
	}
	return ""
}
