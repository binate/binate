package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The overlap-safe copy of an aggregate too large to load whole into registers: the
// store of an AGG_LOAD_IN_PLACE_OVERLAPPING load, whose destination may overlap its
// source, copies as memmove does.

// emitAggMemmoveX64 copies sz bytes (at least 32) from [srcPtr] to [dstPtr] as memmove
// does, right however the two overlap: ascending when the destination starts below
// the source or at or past its end, descending when it starts inside it (dst - src,
// unsigned, below sz).  idx (neither base nor RSP) is the loop index; the bases stay
// intact.  The two directions are straight blocks (emitAggMemmoveBlockX64), the second
// reached by a jump whose displacement is measured beforehand, so the copy records no
// fixup.
func emitAggMemmoveX64(a @asm.Assembler, dstPtr int, srcPtr int, sz int, idx int) {
	if sz < aggCopyLoopChunk {
		a.SetError("native x64: an overlap-safe copy loop needs at least 32 bytes")
		return
	}
	if idx == x64.RSP || idx == dstPtr || idx == srcPtr {
		a.SetError("native x64: an overlap-safe copy's index must be neither RSP nor a base")
		return
	}
	x64.Mov(a, x64.Reg(idx, x64.SZ64), x64.Reg(dstPtr, x64.SZ64))
	x64.Sub(a, x64.Reg(idx, x64.SZ64), x64.Reg(srcPtr, x64.SZ64))
	x64.Cmp(a, x64.Reg(idx, x64.SZ64), x64.Imm(sz))
	var up int = aggMemmoveBlockBytesX64(true, dstPtr, srcPtr, sz, idx)
	var down int = aggMemmoveBlockBytesX64(false, dstPtr, srcPtr, sz, idx)
	// JB skips the ascending block and the JMP past the descending one.
	var jmpBytes int = jumpOverBytesX64(-1, down) - down
	jumpOverX64(a, x64.CC_B, up + jmpBytes)
	emitAggMemmoveBlockX64(a, true, dstPtr, srcPtr, sz, idx)
	jumpOverX64(a, -1, down)
	emitAggMemmoveBlockX64(a, false, dstPtr, srcPtr, sz, idx)
}

// jumpOverX64 emits a forward JMP (cc < 0) or Jcc that skips span bytes following it.
func jumpOverX64(a @asm.Assembler, cc int, span int) {
	var off int = jumpOverBytesX64(cc, span)
	if cc < 0 {
		x64.JmpOffset(a, off)
	} else {
		x64.JccOffset(a, cc, off)
	}
}

// jumpOverBytesX64 returns the length of a forward JMP (cc < 0) or Jcc that skips span
// bytes plus span — the offset it is emitted with: its short form when that reaches,
// else its near form.
func jumpOverBytesX64(cc int, span int) int {
	var m @asm.Assembler = asm.New(8)
	m.SetSection("text", -1)
	if cc < 0 {
		x64.JmpOffset(m, 2 + span)
		if m.Sections[0].Len == 2 { return 2 + span }
		return 5 + span
	}
	x64.JccOffset(m, cc, 2 + span)
	if m.Sections[0].Len == 2 { return 2 + span }
	return 6 + span
}

// aggMemmoveBlockBytesX64 returns the size in bytes of emitAggMemmoveBlockX64's block
// for these operands, by emitting it into a scratch assembler.
func aggMemmoveBlockBytesX64(up bool, dstPtr int, srcPtr int, sz int, idx int) int {
	var m @asm.Assembler = asm.New(8)
	m.SetSection("text", -1)
	emitAggMemmoveBlockX64(m, up, dstPtr, srcPtr, sz, idx)
	return m.Sections[0].Len
}

// emitAggMemmoveBlockX64 copies sz bytes (at least 32) from [srcPtr] to [dstPtr] in
// one direction — ascending (up) or descending — 32 bytes per iteration through XMM14 /
// XMM15 (emitCopyChunkX64), indexed by idx.  The sz % 32 bytes the loop leaves — at
// the top going up, at the bottom going down — are read as the 32 bytes ending or
// starting there into XMM6 / XMM7 BEFORE the loop, which in that direction may
// overwrite them in the source, and stored after it.  XMM14 / XMM15 are the FP scratch
// pair and XMM6 / XMM7 never a value's home (x64_regpools.bn), so none of them holds
// anything across the copy.
func emitAggMemmoveBlockX64(a @asm.Assembler, up bool, dstPtr int, srcPtr int, sz int, idx int) {
	var rest int = sz % aggCopyLoopChunk
	var restOff int = 0
	if up { restOff = sz - aggCopyLoopChunk }
	if rest != 0 {
		x64.Movups_load(a, x64.XMM6, x64.Mem(srcPtr, restOff, x64.SZ64))
		x64.Movups_load(a, x64.XMM7, x64.Mem(srcPtr, restOff + 16, x64.SZ64))
	}
	var top int
	if up {
		emitConstInt64(a, idx, 0)
		top = a.Sections[a.Current].Len
		emitCopyChunkX64(a, dstPtr, 0, srcPtr, 0, idx)
		x64.Add(a, x64.Reg(idx, x64.SZ64), x64.Imm(aggCopyLoopChunk))
		x64.Cmp(a, x64.Reg(idx, x64.SZ64), x64.Imm(sz - rest))
		jumpBackX64(a, x64.CC_NE, top)
	} else {
		emitConstInt64(a, idx, cast(int64, sz - aggCopyLoopChunk))
		top = a.Sections[a.Current].Len
		emitCopyChunkX64(a, dstPtr, 0, srcPtr, 0, idx)
		x64.Sub(a, x64.Reg(idx, x64.SZ64), x64.Imm(aggCopyLoopChunk))
		jumpBackX64(a, x64.CC_NS, top)
	}
	if rest != 0 {
		x64.Movups_store(a, x64.Mem(dstPtr, restOff, x64.SZ64), x64.XMM6)
		x64.Movups_store(a, x64.Mem(dstPtr, restOff + 16, x64.SZ64), x64.XMM7)
	}
}
