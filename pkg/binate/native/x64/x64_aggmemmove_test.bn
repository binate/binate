package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for x64_aggmemmove.bn: the copy that picks its direction at run time.

// relAtX64 decodes the rel8 (wide false) or little-endian rel32 at data[at].
func relAtX64(data @[]uint8, at int, wide bool) int {
	if !wide {
		var b int = cast(int, data[at])
		if b >= 128 { return b - 256 }
		return b
	}
	var u uint32 = cast(uint32, data[at]) | (cast(uint32, data[at + 1]) << 8) |
			(cast(uint32, data[at + 2]) << 16) | (cast(uint32, data[at + 3]) << 24)
	return cast(int, bit_cast(int32, u))
}

// Past 64 bytes, a copy whose destination may overlap its source compares dst - src
// with the size and JBs to the descending block, past the ascending one and the JMP
// that skips the descending one — which ends the copy.
func TestEmitAggMemmoveX64Branches() testing.TestResult {
	var sizes @[]int = @[]int{65, 100, 128, 808, 5000}
	for si := 0; si < len(sizes); si++ {
		var sz int = sizes[si]
		var a @asm.Assembler = emitMkAsm()
		var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
		emitAggMemcpySafeX64(a, m, x64.RAX, x64.RCX, sz, x64.RDX, true)
		var p @asm.Assembler = emitMkAsm()
		x64.Mov(p, x64.Reg(x64.RDX, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
		x64.Sub(p, x64.Reg(x64.RDX, x64.SZ64), x64.Reg(x64.RCX, x64.SZ64))
		x64.Cmp(p, x64.Reg(x64.RDX, x64.SZ64), x64.Imm(sz))
		var at int = p.Sections[0].Len
		var data @[]uint8 = a.Sections[0].Data
		var end int = a.Sections[0].Len
		var jbLen int = 2
		var jb int = 0
		if data[at] == cast(uint8, 0x72) {
			jb = relAtX64(data, at + 1, false)
		} else if data[at] == cast(uint8, 0x0F) && data[at + 1] == cast(uint8, 0x82) {
			jbLen = 6
			jb = relAtX64(data, at + 2, true)
		} else {
			return "the direction test is a JB right after the compare"
		}
		var up int = aggMemmoveBlockBytesX64(true, x64.RAX, x64.RCX, sz, x64.RDX)
		var down int = aggMemmoveBlockBytesX64(false, x64.RAX, x64.RCX, sz, x64.RDX)
		if at + jbLen + jb + down != end {
			return "the JB lands on the descending block, which ends the copy"
		}
		var j int = at + jbLen + up
		var target int = -1
		if data[j] == cast(uint8, 0xEB) {
			target = j + 2 + relAtX64(data, j + 1, false)
		} else if data[j] == cast(uint8, 0xE9) {
			target = j + 5 + relAtX64(data, j + 1, true)
		}
		if target != end { return "the ascending block ends in a JMP past the descending one" }
		if j + 2 > at + jbLen + jb { return "the JMP comes before the descending block" }
	}
	return ""
}

// emitStructCopy copies the store of a load flagged InPlaceOverlapping as memmove does:
// two loops, each with its leftover read first (8 MOVUPS loads); the same store
// unflagged is the plain copy — straight-line for 100 bytes (6 loads), a loop with its
// leftover chunk for 808 (4).
func TestEmitStructCopyOverlappingLoadPicksDirection() testing.TestResult {
	setTarget64()
	var lens @[]int = @[]int{25, 202}
	var plain @[]int = @[]int{6, 4}
	for li := 0; li < len(lens); li++ {
		var t @types.Type = types.MakeArrayType(types.TypInt32(), cast(int64, lens[li]))
		for flagged := 0; flagged < 2; flagged++ {
			var a @asm.Assembler = managedMkAsm()
			var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
			m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
			m.AllocOffsets = common.AppendInt64(m.AllocOffsets, 0)
			m.AllocSizes = common.AppendInt64(m.AllocSizes, cast(int64, 4 * lens[li]))
			m.AllocIDs = common.AppendInt(m.AllocIDs, 2)
			m.AllocOffsets = common.AppendInt64(m.AllocOffsets, 816)
			m.AllocSizes = common.AppendInt64(m.AllocSizes, cast(int64, 4 * lens[li]))
			if flagged == 1 {
				m.InPlaceOverlapping = make_slice(bool, 3)
				m.InPlaceOverlapping[2] = true
			}
			var dst @ir.Instr = make(ir.Instr)
			dst.ID = 1
			var src @ir.Instr = make(ir.Instr)
			src.ID = 2
			src.Op = iropcode.OP_LOAD
			src.Typ = t
			var ins @ir.Instr = make(ir.Instr)
			ins.Op = iropcode.OP_STORE
			ins.Args = make_slice(@ir.Instr, 2)
			ins.Args[0] = dst
			ins.Args[1] = src
			emitStructCopy(a, "main", m, ins)
			var want int = plain[li]
			if flagged == 1 { want = 8 }
			if x64PairCount(a, 0x0F, 0x10) != want {
				return "only a flagged store's copy is the two-direction copy"
			}
		}
	}
	return ""
}
