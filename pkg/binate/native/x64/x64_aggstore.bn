package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/native/aggcopy"
import "pkg/binate/native/common"

// Storing an aggregate into memory another party owns — a caller's sret buffer
// or tuple slot, a shim's return buffer, the red-zone image a multi-value
// return is packed through — writes exactly the aggregate's bytes: the bytes
// after it belong to something else, which a word-granular store would
// overwrite whenever the size is not a multiple of 8.

// emitStoreRegWordX64 stores reg, which holds an aggregate's bytes from a word
// boundary on, at [base + off]; rest is how many of the aggregate's bytes
// remain from that boundary.  With rest >= 8 it stores the whole word; below
// that exactly rest bytes, in 4-, 2- and 1-byte pieces (aggcopy.TailPieces),
// each later piece shifted down from a copy of reg in scratch — reg is left
// unchanged, and scratch must differ from reg and base.
func emitStoreRegWordX64(a @asm.Assembler, reg int, base int, off int, rest int, scratch int) {
	if rest >= 8 {
		x64.Mov(a, x64.Mem(base, off, x64.SZ64), x64.Reg(reg, x64.SZ64))
		return
	}
	var ps @[]aggcopy.Piece = aggcopy.TailPieces(0, rest, false)
	for i := 0; i < len(ps); i++ {
		var src int = reg
		if ps[i].Off > 0 {
			x64.Mov(a, x64.Reg(scratch, x64.SZ64), x64.Reg(reg, x64.SZ64))
			x64.Shr(a, x64.Reg(scratch, x64.SZ64), x64.Imm(8 * ps[i].Off))
			src = scratch
		}
		var p aggcopy.Piece
		p.Off = off + ps[i].Off
		p.Width = ps[i].Width
		emitAggPieceX64(a, false, src, base, p)
	}
}

// emitAggCopyToX64 copies sz bytes from [srcPtr] to [dstBase + dstOff] exactly
// (emitAggMemcpyX64), forming the destination address in a scratch register
// when dstOff is not 0 — or, for a copy that is a loop, addressing it as base +
// offset from a claimed index register (both pointers are claimed first).
func emitAggCopyToX64(a @asm.Assembler, rm @common.RegMap, dstBase int, dstOff int, srcPtr int,
		sz int) {
	if aggCopyIsLoop(sz) {
		rm.MarkUsed(dstBase)
		rm.MarkUsed(srcPtr)
		emitCopyLoopX64(a, dstBase, dstOff, srcPtr, 0, sz, scratchReg(rm))
		return
	}
	var dst int = dstBase
	if dstOff != 0 {
		dst = scratchReg(rm)
		x64.Lea(a, x64.Reg(dst, x64.SZ64), x64.Mem(dstBase, dstOff, x64.SZ64))
	}
	emitAggMemcpyX64(a, dst, srcPtr, sz, scratchReg(rm))
}
