package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A whole remaining word is one 64-bit store (REX.W 89).
func TestStoreRegWordX64Whole() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitStoreRegWordX64(a, x64.RAX, x64.RCX, 0, 8, x64.RDX)
	if x64RexWStores(a) != 1 { return "a whole word should be one 8-byte store" }
	return ""
}

// Three remaining bytes are a 16-bit store (66 89) and a byte store (88) of the
// shifted copy — never a word or doubleword store.
func TestStoreRegWordX64ThreeBytes() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitStoreRegWordX64(a, x64.RAX, x64.RCX, 0, 3, x64.RDX)
	if x64PairCount(a, 0x66, 0x89) != 1 || x64ByteCount(a, 0x88) != 1 {
		return "3 bytes should be one 16-bit and one 8-bit store"
	}
	return ""
}

// x64TupleOf returns the multi-value result tuple of the given field types.
func x64TupleOf(fieldTypes @[]@types.Type) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, len(fieldTypes))
	for i := 0; i < len(fieldTypes); i++ {
		fields[i] = make(types.Field)
		fields[i].Type = fieldTypes[i]
	}
	return types.MakeStructType("", fields)
}

// x64MemStores64 counts 64-bit register-to-MEMORY MOVs: a REX.W prefix (0x48..0x4F),
// opcode 0x89, and a ModRM whose mod is not 11 (a register-to-register move).
func x64MemStores64(a @asm.Assembler) int {
	var data @[]uint8 = a.Sections[0].Data
	var n int = 0
	for i := 0; i + 2 < a.Sections[0].Len; i++ {
		if (data[i] & cast(uint8, 0xF8)) == cast(uint8, 0x48) && data[i + 1] == cast(uint8, 0x89) &&
				(data[i + 2] & cast(uint8, 0xC0)) != cast(uint8, 0xC0) {
			n = n + 1
		}
	}
	return n
}

// Collecting a (uint8, [15]char) tuple after a call stores the [15]char's first
// word whole and its last word only up to the field's end — never a second
// 8-byte store, which would reach a byte past the 16-byte tuple.
func TestCollectTupleStoresExactly() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	var tuple @types.Type = x64TupleOf(
			@[]@types.Type{types.TypUint8(), types.MakeArrayType(types.TypChar(), 15)})
	storeMultiReturnTupleFields_x64(a, tuple, x64.R10, 0, x64.R11, 2)
	if x64MemStores64(a) != 1 { return "only the [15]char's first word may be an 8-byte store" }
	return ""
}

// Collecting a 12-byte SSE aggregate {float32, float32, uint8}: the first
// eightbyte is one SSE store, the second (INTEGER) is stored only up to the
// aggregate's end — no 8-byte GP store.
func TestSseCollectStoresExactly() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	var t @types.Type = x64TupleOf(
			@[]@types.Type{types.TypFloat32(), types.TypFloat32(), types.TypUint8()})
	emitSseReturnCollectTo(a, t, x64.R10, 0, x64.R11)
	if x64MemStores64(a) != 0 { return "the 4-byte INTEGER eightbyte must not be stored as 8 bytes" }
	return ""
}
