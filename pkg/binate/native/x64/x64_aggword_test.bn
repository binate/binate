package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// loadAggWordX64 reads no byte past an aggregate, which may be read in place from a
// source ending where mapped memory does, and touches no register but dst: a whole
// word is one 8-byte load; a last word of 4, 2 or 1 bytes one load of its width;
// another in an aggregate of more than 8 bytes the 8 bytes ending at its end shifted
// right; and an aggregate of 3, 5, 6 or 7 bytes its top bytes with each lower piece
// shifted in below them by a 2- or 1-byte load into dst's low bits.

// aggWordX64Same reports whether loadAggWordX64 of word w of a size-byte aggregate at
// RSI into RDI emits the bytes of want.
func aggWordX64Same(w int, size int64, want @asm.Assembler) bool {
	var g @asm.Assembler = mkWantX64()
	loadAggWordX64(g, x64.RDI, x64.RSI, w, size)
	if g.HasError || g.Sections[0].Len != want.Sections[0].Len { return false }
	for i := 0; i < g.Sections[0].Len; i++ {
		if g.Sections[0].Data[i] != want.Sections[0].Data[i] { return false }
	}
	return true
}

func TestLoadAggWordX64ExactWidths() testing.TestResult {
	var w @asm.Assembler = mkWantX64()
	x64.Mov(w, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSI, 8, x64.SZ64))
	if !aggWordX64Same(1, 16, w) { return fail("the second word of 16 bytes is one 8-byte load") }
	w = mkWantX64()
	x64.Mov(w, x64.Reg(x64.RDI, x64.SZ32), x64.Mem(x64.RSI, 8, x64.SZ32))
	if !aggWordX64Same(1, 12, w) { return fail("the second word of 12 bytes is one 4-byte load") }
	w = mkWantX64()
	x64.Movzx(w, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSI, 8, x64.SZ16))
	if !aggWordX64Same(1, 10, w) { return fail("the second word of 10 bytes is one 2-byte load") }
	w = mkWantX64()
	x64.Mov(w, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSI, 7, x64.SZ64))
	x64.Shr(w, x64.Reg(x64.RDI, x64.SZ64), x64.Imm(8))
	if !aggWordX64Same(1, 15, w) {
		return fail("the second word of 15 bytes is bytes 7..14 shifted right past byte 7")
	}
	w = mkWantX64()
	x64.Mov(w, x64.Reg(x64.RDI, x64.SZ32), x64.Mem(x64.RSI, 3, x64.SZ32))
	x64.Shl(w, x64.Reg(x64.RDI, x64.SZ64), x64.Imm(16))
	x64.Mov(w, x64.Reg(x64.RDI, x64.SZ16), x64.Mem(x64.RSI, 1, x64.SZ16))
	x64.Shl(w, x64.Reg(x64.RDI, x64.SZ64), x64.Imm(8))
	x64.Mov(w, x64.Reg(x64.RDI, x64.SZ8), x64.Mem(x64.RSI, 0, x64.SZ8))
	if !aggWordX64Same(0, 7, w) {
		return fail("7 bytes are bytes 3..6, with 1..2 and then 0 shifted in")
	}
	w = mkWantX64()
	x64.Movzx(w, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSI, 1, x64.SZ16))
	x64.Shl(w, x64.Reg(x64.RDI, x64.SZ64), x64.Imm(8))
	x64.Mov(w, x64.Reg(x64.RDI, x64.SZ8), x64.Mem(x64.RSI, 0, x64.SZ8))
	if !aggWordX64Same(0, 3, w) { return fail("3 bytes are bytes 1..2, with 0 shifted in") }
	w = mkWantX64()
	x64.Movzx(w, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSI, 8, x64.SZ8))
	if !aggWordX64Same(1, 9, w) { return fail("the second word of 9 bytes is one 1-byte load") }
	w = mkWantX64()
	x64.Mov(w, x64.Reg(x64.RDI, x64.SZ32), x64.Mem(x64.RSI, 1, x64.SZ32))
	x64.Shl(w, x64.Reg(x64.RDI, x64.SZ64), x64.Imm(8))
	x64.Mov(w, x64.Reg(x64.RDI, x64.SZ8), x64.Mem(x64.RSI, 0, x64.SZ8))
	if !aggWordX64Same(0, 5, w) { return fail("5 bytes are bytes 1..4, with 0 shifted in") }
	w = mkWantX64()
	x64.Mov(w, x64.Reg(x64.RDI, x64.SZ32), x64.Mem(x64.RSI, 2, x64.SZ32))
	x64.Shl(w, x64.Reg(x64.RDI, x64.SZ64), x64.Imm(16))
	x64.Mov(w, x64.Reg(x64.RDI, x64.SZ16), x64.Mem(x64.RSI, 0, x64.SZ16))
	if !aggWordX64Same(0, 6, w) { return fail("6 bytes are bytes 2..5, with 0..1 shifted in") }
	var e @asm.Assembler = mkWantX64()
	loadAggWordX64(e, x64.RSI, x64.RSI, 0, 5)
	if !e.HasError { return fail("a 5-byte aggregate loaded over its own base fails loud") }
	return ""
}
