package "pkg/binate/native/x64"

import "pkg/binate/irbuild"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Function entries and loop headers start on X64_FUNC_ALIGN / X64_LOOP_ALIGN
// boundaries, and the text section's alignment is raised to match so the
// boundaries survive linking.

// symOffset returns the section offset of the defined symbol name, or -1.
func symOffset(a @asm.Assembler, name *[]readonly char) int {
	var i int = a.LookupSymbol(name)
	if i < 0 { return -1 }
	return cast(int, a.Symbols[i].Offset)
}

// emptyFunc builds `func name() {}`.
func emptyFunc(name *[]readonly char) @ir.Func {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", buf.CopyStr(name), noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(b, noArgs)
	return f
}

// The empty first function is 9 bytes; the second must still start at 16.
func TestAlignSecondFunctionEntry() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitFunc(a, "main", emptyFunc("main.First"), nilStrings())
	emitFunc(a, "main", emptyFunc("main.Second"), nilStrings())
	var off int = symOffset(a, symFor("main", "main.Second"))
	if off != 16 { return fail("second function must start at the next 16-byte boundary") }
	if a.Sections[0].Align < X64_FUNC_ALIGN {
		return fail("text section alignment must be raised to 16")
	}
	return ""
}

// entry -> header (branch) -> body -> header (back-edge), header -> exit.
func TestAlignLoopHeader() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.Loop", noP, noR)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	irbuild.EmitJump(entry, header)
	var cond @ir.Instr = irbuild.EmitConstBool(header, false)
	irbuild.EmitBranch(header, cond, body, exit)
	irbuild.EmitJump(body, header)
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(exit, noArgs)
	emitFunc(a, "main", f, nilStrings())

	var sym @[]char = symFor("main", "main.Loop")
	var hOff int = symOffset(a, blockLabel(sym, header.Label))
	if hOff < 0 { return fail("loop header label missing") }
	if hOff % X64_LOOP_ALIGN != 0 { return fail("loop header must start on a 16-byte boundary") }
	var bOff int = symOffset(a, blockLabel(sym, body.Label))
	if bOff < 0 { return fail("loop body label missing") }
	return ""
}

// A #[c_export] function with a narrow int8 param gets a normalization thunk
// at the alias; both the alias and the mangled entry are 16-aligned.
func TestAlignCExportThunkAndEntry() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitFunc(a, "main", emptyFunc("main.Pad"), nilStrings())
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].ID = 1
	params[0].Name = "b"
	params[0].Typ = types.TypInt8()
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.Sgn", params, noR)
	var blk @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(blk, noArgs)
	var names @[]@[]char = make_slice(@[]char, 1)
	names[0] = buf.CopyStr("ffi_sgn")
	f.CExportNames = names
	emitFunc(a, "main", f, nilStrings())

	var aliasOff int = symOffset(a, symPrefixed("ffi_sgn"))
	var mangledOff int = symOffset(a, symFor("main", "main.Sgn"))
	if aliasOff < 0 || mangledOff < 0 { return fail("alias or mangled symbol missing") }
	if aliasOff % X64_FUNC_ALIGN != 0 { return fail("c_export alias must be 16-aligned") }
	if mangledOff % X64_FUNC_ALIGN != 0 {
		return fail("mangled entry after a thunk must be 16-aligned")
	}
	if mangledOff <= aliasOff { return fail("the thunk must precede the mangled entry") }
	return ""
}
