package "pkg/binate/native/x64"

import "pkg/binate/irbuild"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/blockplan"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Emission under a block plan (blockplan.BlockPlan): blocks in the plan's order, loop
// alignment from AlignTop, a plan the backend cannot emit, and blocks that fall
// through under a plan with FallThrough.

// planOrderFunc builds `entry: jump c; b: return; c: jump b`.
func planOrderFunc() @ir.Func {
	var f @ir.Func = ir.NewFunc("", "main.order", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var b @ir.Block = ir.AddBlock(f, "b")
	var c @ir.Block = ir.AddBlock(f, "c")
	irbuild.EmitJump(entry, c)
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(b, noArgs)
	irbuild.EmitJump(c, b)
	return f
}

// planLoopFunc builds `entry: jump header; header: branch body, exit; body: jump
// header; exit: return`, whose one loop header is block 1.
func planLoopFunc() @ir.Func {
	var f @ir.Func = ir.NewFunc("", "main.loop", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	irbuild.EmitJump(entry, header)
	irbuild.EmitBranch(header, irbuild.EmitConstBool(header, false), body, exit)
	irbuild.EmitJump(body, header)
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(exit, noArgs)
	return f
}

// planEmit emits f under plan into a fresh assembler and returns it.
func planEmit(f @ir.Func, plan @blockplan.BlockPlan) @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitFuncPlanned(a, "main", f, nilStrings(), Options{}, plan)
	return a
}

// planWithOrder returns f's SOURCE plan with order as its Order.
func planWithOrder(f @ir.Func, order @[]int) @blockplan.BlockPlan {
	var plan @blockplan.BlockPlan = blockplan.PlanBlocks(f, blockplan.BLOCK_LAYOUT_SOURCE, true)
	plan.Order = order
	return plan
}

// The blocks are emitted in the plan's order, the entry at the function symbol.
func TestEmitFuncPlannedFollowsOrder() testing.TestResult {
	var f @ir.Func = planOrderFunc()
	var sym @[]char = symFor("main", f.Name)
	var a @asm.Assembler = planEmit(f, planWithOrder(f, @[]int{0, 1, 2}))
	if a.HasError { return fail("the IR order must emit") }
	var b int = symOffset(a, blockLabel(sym, f.Blocks[1].Label))
	var c int = symOffset(a, blockLabel(sym, f.Blocks[2].Label))
	if b < 0 || c < 0 || b >= c { return fail("the IR order must emit b before c") }
	var g @ir.Func = planOrderFunc()
	var swapped @asm.Assembler = planEmit(g, planWithOrder(g, @[]int{0, 2, 1}))
	if swapped.HasError { return fail("a permuted order must emit") }
	b = symOffset(swapped, blockLabel(sym, g.Blocks[1].Label))
	c = symOffset(swapped, blockLabel(sym, g.Blocks[2].Label))
	if b < 0 || c < 0 || c >= b { return fail("order 0, 2, 1 must emit c before b") }
	if symOffset(swapped, sym) != 0 { return fail("the entry block must start the function") }
	if swapped.Sections[0].Len != a.Sections[0].Len {
		return fail("the order must not change the code size")
	}
	return ""
}

// planRejected reports whether emitFuncPlanned rejects plan for f with an error,
// before emitting anything.
func planRejected(f @ir.Func, plan @blockplan.BlockPlan) bool {
	var a @asm.Assembler = planEmit(f, plan)
	return a.HasError && a.Sections[0].Len == 0
}

// A plan that does not list every block once, entry first, or (since this backend
// aligns loops) does not mark loop tops, fails before the function is emitted.
func TestEmitFuncPlannedRejectsBadPlan() testing.TestResult {
	var f @ir.Func = planOrderFunc()
	var none @blockplan.BlockPlan
	if !planRejected(f, none) { return fail("no plan must fail") }
	if !planRejected(f, planWithOrder(f, @[]int{0, 1})) { return fail("a short Order must fail") }
	if !planRejected(f, planWithOrder(f, @[]int{1, 0, 2})) {
		return fail("an Order that does not start with the entry must fail")
	}
	if !planRejected(f, blockplan.PlanBlocks(f, blockplan.BLOCK_LAYOUT_SOURCE, false)) {
		return fail("a plan without AlignTop must fail")
	}
	return ""
}

// The blocks AlignTop marks start on X64_LOOP_ALIGN, whether or not they head a
// loop, and no other block is padded.
func TestEmitFuncPlannedAlignsAlignTop() testing.TestResult {
	var f @ir.Func = planLoopFunc()
	var sym @[]char = symFor("main", f.Name)
	var plain @blockplan.BlockPlan = blockplan.PlanBlocks(f, blockplan.BLOCK_LAYOUT_SOURCE, true)
	plain.AlignTop = make_slice(bool, len(f.Blocks))
	var a @asm.Assembler = planEmit(f, plain)
	var header int = symOffset(a, blockLabel(sym, f.Blocks[1].Label))
	if a.HasError || header < 0 { return fail("the loop must emit") }
	if header % X64_LOOP_ALIGN == 0 {
		return fail("the test needs a header that is not aligned by chance")
	}
	var g @ir.Func = planLoopFunc()
	var exitOnly @blockplan.BlockPlan = blockplan.PlanBlocks(g, blockplan.BLOCK_LAYOUT_SOURCE, true)
	exitOnly.AlignTop = make_slice(bool, len(g.Blocks))
	exitOnly.AlignTop[3] = true
	var e @asm.Assembler = planEmit(g, exitOnly)
	if e.HasError { return fail("the loop must emit") }
	if symOffset(e, blockLabel(sym, g.Blocks[1].Label)) != header {
		return fail("a loop header AlignTop does not mark must not be padded")
	}
	if symOffset(e, blockLabel(sym, g.Blocks[3].Label)) % X64_LOOP_ALIGN != 0 {
		return fail("a block AlignTop marks must be aligned")
	}
	return ""
}

// ftParamFunc returns a function named name with one parameter of type typ and no
// results, and a reference to the parameter as an operand.
func ftParamFunc(name *[]readonly char, typ @types.Type) (@ir.Func, @ir.Instr) {
	var f @ir.Func = ir.NewFunc("", buf.CopyStr(name), makeNoParams(), makeNoResults())
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = irbuild.NewParam(f, "p", typ)
	f.Params = params
	return f, irbuild.NewParamRef(f, params[0])
}

// ftIfElseFunc builds `entry: branch flag, then, else; then: jump join; else: jump
// join; join: return`, whose branch tests a bool parameter in a register.
func ftIfElseFunc() @ir.Func {
	var f @ir.Func
	var flag @ir.Instr
	f, flag = ftParamFunc("main.ifElse", types.TypBool())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var elseB @ir.Block = ir.AddBlock(f, "else")
	var join @ir.Block = ir.AddBlock(f, "join")
	irbuild.EmitBranch(entry, flag, thenB, elseB)
	irbuild.EmitJump(thenB, join)
	irbuild.EmitJump(elseB, join)
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(join, noArgs)
	return f
}

// ftLoopFunc builds `entry: jump header; header: branch n > 0, body, exit; body:
// jump header; exit: return`, with n an unsigned parameter, so the header's branch
// is on a fused unsigned compare.
func ftLoopFunc() @ir.Func {
	var f @ir.Func
	var n @ir.Instr
	f, n = ftParamFunc("main.loop", types.TypUint())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	irbuild.EmitJump(entry, header)
	var zero @ir.Instr = irbuild.EmitConstInt(header, 0, types.TypUint())
	var more @ir.Instr = irbuild.EmitBinop(header, iropcode.OP_GT, n, zero, types.TypBool())
	irbuild.EmitBranch(header, more, body, exit)
	irbuild.EmitJump(body, header)
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(exit, noArgs)
	return f
}

// ftChainFunc builds a switch on a signed parameter x as a chain of tests:
// `entry: branch x == 1, one, test2; one: jump done; test2: branch x == 2, two,
// other; two: jump done; other: jump done; done: return`.
func ftChainFunc() @ir.Func {
	var f @ir.Func
	var x @ir.Instr
	f, x = ftParamFunc("main.chain", types.TypInt())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var one @ir.Block = ir.AddBlock(f, "one")
	var test2 @ir.Block = ir.AddBlock(f, "test2")
	var two @ir.Block = ir.AddBlock(f, "two")
	var other @ir.Block = ir.AddBlock(f, "other")
	var done @ir.Block = ir.AddBlock(f, "done")
	var c1 @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	irbuild.EmitBranch(entry, irbuild.EmitBinop(entry, iropcode.OP_EQ, x, c1, types.TypBool()), one,
			test2)
	irbuild.EmitJump(one, done)
	var c2 @ir.Instr = irbuild.EmitConstInt(test2, 2, types.TypInt())
	irbuild.EmitBranch(test2, irbuild.EmitBinop(test2, iropcode.OP_EQ, x, c2, types.TypBool()), two,
			other)
	irbuild.EmitJump(two, done)
	irbuild.EmitJump(other, done)
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(done, noArgs)
	return f
}

// ftOneTargetFunc builds `entry: jump last; mid: return; last: branch flag, mid,
// mid`, whose last block branches to one block on both arms, on a bool parameter.
func ftOneTargetFunc() @ir.Func {
	var f @ir.Func
	var flag @ir.Instr
	f, flag = ftParamFunc("main.oneTarget", types.TypBool())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var mid @ir.Block = ir.AddBlock(f, "mid")
	var last @ir.Block = ir.AddBlock(f, "last")
	irbuild.EmitJump(entry, last)
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(mid, noArgs)
	irbuild.EmitBranch(last, flag, mid, mid)
	return f
}

// ftBlockStart returns where block bi of f starts in a's code: the function
// symbol for the entry block, else the block's label.
func ftBlockStart(a @asm.Assembler, f @ir.Func, bi int) int {
	var sym @[]char = symFor("main", f.Name)
	if bi == 0 { return symOffset(a, sym) }
	return symOffset(a, blockLabel(sym, f.Blocks[bi].Label))
}

// ftRel32 returns the signed 32-bit little-endian value at offset off of data.
func ftRel32(data *[]uint8, off int) int64 {
	var v int64 = 0
	for i := 3; i >= 0; i-- { v = v * 256 + cast(int64, data[off + i]) }
	if v >= 2147483648 { v = v - 4294967296 }
	return v
}

// ftFunc builds test function kind: 0 ftIfElseFunc, 1 ftLoopFunc, 2 ftChainFunc,
// else ftOneTargetFunc.
func ftFunc(kind int) @ir.Func {
	if kind == 0 { return ftIfElseFunc() }
	if kind == 1 { return ftLoopFunc() }
	if kind == 2 { return ftChainFunc() }
	return ftOneTargetFunc()
}

// ftCheckFallThrough emits test function kind (ftFunc) under its FALLTHROUGH plan
// and returns "" when the code is as that plan wants it, else the problem:
//   - it emits with no error, with one branch (fixup) per entry of ops, in order:
//     branch i's opcode is ops[i] (0xE9 a jmp; else the byte after the 0x0F of a
//     Jcc, 0x80 + cc) and its target is block targets[i] of the function;
//   - no block holds a branch to the block laid out right after it;
//   - every branch to a block resolves (x64.ResolveFixups) to that block's start;
//   - it is smaller than the code under the SOURCE plan, which is emitFunc's.
func ftCheckFallThrough(kind int, ops @[]int, targets @[]int) *[]readonly char {
	var f @ir.Func = ftFunc(kind)
	var a @asm.Assembler = planEmit(f,
			blockplan.PlanBlocks(f, blockplan.BLOCK_LAYOUT_FALLTHROUGH, true))
	if a.HasError { return "fallthrough must emit with no error" }
	var sec @asm.Section = a.Sections[0]
	if sec.NumFixups != len(ops) { return "fallthrough must leave out the jumps to the next block" }
	var sym @[]char = symFor("main", f.Name)
	for fi := 0; fi < sec.NumFixups; fi++ {
		var at int = cast(int, sec.Fixups[fi].Offset)
		if at < 2 || cast(int, sec.Data[at - 1]) != ops[fi] { return "a branch has the wrong opcode" }
		if ops[fi] != 0xE9 && sec.Data[at - 2] != cast(uint8, 0x0F) {
			return "a conditional branch must be a 0x0F-prefixed Jcc"
		}
		if !termLabelIs(sec.Fixups[fi].Label, blockLabel(sym, f.Blocks[targets[fi]].Label)) {
			return "a branch has the wrong target"
		}
	}
	var n int = len(f.Blocks)
	var starts @[]int = make_slice(int, n + 1)
	for bi := 0; bi < n; bi++ { starts[bi] = ftBlockStart(a, f, bi) }
	starts[n] = asm.HeldLen(sec)
	for fi := 0; fi < sec.NumFixups; fi++ {
		var at int = cast(int, sec.Fixups[fi].Offset)
		for bi := 0; bi + 1 < n; bi++ {
			var nextLabel @[]char = blockLabel(sym, f.Blocks[bi + 1].Label)
			if at >= starts[bi] && at < starts[bi + 1] && termLabelIs(sec.Fixups[fi].Label, nextLabel) {
				return "a block must not branch to the block laid out next"
			}
		}
	}
	if !x64.ResolveFixups(a) || a.HasError { return "the branches must resolve" }
	for fi := 0; fi < sec.NumFixups; fi++ {
		var target int = symOffset(a, sec.Fixups[fi].Label)
		var at int = cast(int, sec.Fixups[fi].Offset)
		if target < 0 { return "a branch's target must be defined" }
		if cast(int64, at + 4) + ftRel32(sec.Data, at) != cast(int64, target) {
			return "a branch must resolve to its target"
		}
	}
	var g @ir.Func = ftFunc(kind)
	var source @asm.Assembler = planEmit(g,
			blockplan.PlanBlocks(g, blockplan.BLOCK_LAYOUT_SOURCE, true))
	var plain @asm.Assembler = termAsm()
	emitFunc(plain, "main", ftFunc(kind), nilStrings(), Options{})
	if !sameCode(plain, source) { return "the SOURCE plan must emit what emitFunc does" }
	if asm.HeldLen(source.Sections[0]) <= asm.HeldLen(sec) {
		return "fallthrough must emit less code than SOURCE"
	}
	return ""
}

// Under a FALLTHROUGH plan, functions with an if/else, a loop, a chain of tests and
// a last block that branches to one block on both arms emit no jump to the block
// laid out next, and their branches resolve.
func TestEmitFuncPlannedFallThrough() testing.TestResult {
	// if/else: entry's `test; jz else` and then's `jmp join`; else falls into join.
	var why *[]readonly char = ftCheckFallThrough(0, @[]int{0x84, 0xE9}, @[]int{2, 3})
	if len(why) > 0 { return fail(buf.Concat("if/else: ", why)) }
	// Loop: entry falls into the header; the header's `jbe exit` and body's `jmp header`.
	why = ftCheckFallThrough(1, @[]int{0x86, 0xE9}, @[]int{3, 1})
	if len(why) > 0 { return fail(buf.Concat("loop: ", why)) }
	// Chain: `jne test2`, `jmp done`, `jne other`, `jmp done`; other falls into done.
	why = ftCheckFallThrough(2, @[]int{0x85, 0xE9, 0x85, 0xE9}, @[]int{2, 5, 4, 5})
	if len(why) > 0 { return fail(buf.Concat("chain: ", why)) }
	// One target: entry's `jmp last`, and the last block's branch to mid on both
	// arms one `jmp mid`, though no block is laid out after it.
	why = ftCheckFallThrough(3, @[]int{0xE9, 0xE9}, @[]int{2, 1})
	if len(why) > 0 { return fail(buf.Concat("one target: ", why)) }
	return ""
}

// Under a FALLTHROUGH plan the loop header stays aligned, with the entry block,
// which falls through into it, laid out before it.
func TestEmitFuncPlannedFallThroughAlignsHeader() testing.TestResult {
	var f @ir.Func = ftLoopFunc()
	var a @asm.Assembler = planEmit(f,
			blockplan.PlanBlocks(f, blockplan.BLOCK_LAYOUT_FALLTHROUGH, true))
	var header int = ftBlockStart(a, f, 1)
	if a.HasError || header < 0 { return fail("the loop must emit") }
	if header % X64_LOOP_ALIGN != 0 { return fail("the loop header must be aligned") }
	return ""
}
