package "pkg/binate/native/x64"

import "pkg/binate/irbuild"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/native/blockplan"
import "pkg/builtins/testing"

// Emission under a block plan (blockplan.BlockPlan): blocks in the plan's order, loop
// alignment from AlignTop, and a plan the backend cannot emit.

// planOrderFunc builds `entry: jump c; b: return; c: jump b`.
func planOrderFunc() @ir.Func {
	var f @ir.Func = ir.NewFunc("", "main.order", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var b @ir.Block = ir.AddBlock(f, "b")
	var c @ir.Block = ir.AddBlock(f, "c")
	irbuild.EmitJump(entry, c)
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(b, noArgs)
	irbuild.EmitJump(c, b)
	return f
}

// planLoopFunc builds `entry: jump header; header: branch body, exit; body: jump
// header; exit: return`, whose one loop header is block 1.
func planLoopFunc() @ir.Func {
	var f @ir.Func = ir.NewFunc("", "main.loop", makeNoParams(), makeNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	irbuild.EmitJump(entry, header)
	irbuild.EmitBranch(header, irbuild.EmitConstBool(header, false), body, exit)
	irbuild.EmitJump(body, header)
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(exit, noArgs)
	return f
}

// planEmit emits f under plan into a fresh assembler and returns it.
func planEmit(f @ir.Func, plan @blockplan.BlockPlan) @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitFuncPlanned(a, "main", f, nilStrings(), Options{}, plan)
	return a
}

// planWithOrder returns f's SOURCE plan with order as its Order.
func planWithOrder(f @ir.Func, order @[]int) @blockplan.BlockPlan {
	var plan @blockplan.BlockPlan = blockplan.PlanBlocks(f, blockplan.BLOCK_LAYOUT_SOURCE, true)
	plan.Order = order
	return plan
}

// The blocks are emitted in the plan's order, the entry at the function symbol.
func TestEmitFuncPlannedFollowsOrder() testing.TestResult {
	var f @ir.Func = planOrderFunc()
	var sym @[]char = symFor("main", f.Name)
	var a @asm.Assembler = planEmit(f, planWithOrder(f, @[]int{0, 1, 2}))
	if a.HasError { return fail("the IR order must emit") }
	var b int = symOffset(a, blockLabel(sym, f.Blocks[1].Label))
	var c int = symOffset(a, blockLabel(sym, f.Blocks[2].Label))
	if b < 0 || c < 0 || b >= c { return fail("the IR order must emit b before c") }
	var g @ir.Func = planOrderFunc()
	var swapped @asm.Assembler = planEmit(g, planWithOrder(g, @[]int{0, 2, 1}))
	if swapped.HasError { return fail("a permuted order must emit") }
	b = symOffset(swapped, blockLabel(sym, g.Blocks[1].Label))
	c = symOffset(swapped, blockLabel(sym, g.Blocks[2].Label))
	if b < 0 || c < 0 || c >= b { return fail("order 0, 2, 1 must emit c before b") }
	if symOffset(swapped, sym) != 0 { return fail("the entry block must start the function") }
	if swapped.Sections[0].Len != a.Sections[0].Len {
		return fail("the order must not change the code size")
	}
	return ""
}

// planRejected reports whether emitFuncPlanned rejects plan for f with an error,
// before emitting anything.
func planRejected(f @ir.Func, plan @blockplan.BlockPlan) bool {
	var a @asm.Assembler = planEmit(f, plan)
	return a.HasError && a.Sections[0].Len == 0
}

// A plan that does not list every block once, entry first, or (since this backend
// aligns loops) does not mark loop tops, fails before the function is emitted.
func TestEmitFuncPlannedRejectsBadPlan() testing.TestResult {
	var f @ir.Func = planOrderFunc()
	var none @blockplan.BlockPlan
	if !planRejected(f, none) { return fail("no plan must fail") }
	if !planRejected(f, planWithOrder(f, @[]int{0, 1})) { return fail("a short Order must fail") }
	if !planRejected(f, planWithOrder(f, @[]int{1, 0, 2})) {
		return fail("an Order that does not start with the entry must fail")
	}
	if !planRejected(f, blockplan.PlanBlocks(f, blockplan.BLOCK_LAYOUT_SOURCE, false)) {
		return fail("a plan without AlignTop must fail")
	}
	return ""
}

// The blocks AlignTop marks start on X64_LOOP_ALIGN, whether or not they head a
// loop, and no other block is padded.
func TestEmitFuncPlannedAlignsAlignTop() testing.TestResult {
	var f @ir.Func = planLoopFunc()
	var sym @[]char = symFor("main", f.Name)
	var plain @blockplan.BlockPlan = blockplan.PlanBlocks(f, blockplan.BLOCK_LAYOUT_SOURCE, true)
	plain.AlignTop = make_slice(bool, len(f.Blocks))
	var a @asm.Assembler = planEmit(f, plain)
	var header int = symOffset(a, blockLabel(sym, f.Blocks[1].Label))
	if a.HasError || header < 0 { return fail("the loop must emit") }
	if header % X64_LOOP_ALIGN == 0 {
		return fail("the test needs a header that is not aligned by chance")
	}
	var g @ir.Func = planLoopFunc()
	var exitOnly @blockplan.BlockPlan = blockplan.PlanBlocks(g, blockplan.BLOCK_LAYOUT_SOURCE, true)
	exitOnly.AlignTop = make_slice(bool, len(g.Blocks))
	exitOnly.AlignTop[3] = true
	var e @asm.Assembler = planEmit(g, exitOnly)
	if e.HasError { return fail("the loop must emit") }
	if symOffset(e, blockLabel(sym, g.Blocks[1].Label)) != header {
		return fail("a loop header AlignTop does not mark must not be padded")
	}
	if symOffset(e, blockLabel(sym, g.Blocks[3].Label)) % X64_LOOP_ALIGN != 0 {
		return fail("a block AlignTop marks must be aligned")
	}
	return ""
}
