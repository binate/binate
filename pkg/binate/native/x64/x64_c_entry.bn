package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// emitCEntryThunks emits one weak `__centry.<mangled>` adaptation thunk per
// narrow-argument __c_entry target: the target's narrow GP argument-register
// normalization (the same emitCExportRegNormX64 a #[c_export] entry uses), then
// an unconditional JMP to the mangled entry.  A C caller entering the thunk
// sign-/zero-extends the narrow argument registers whose high bits the SysV ABI
// leaves unspecified, then jumps into the real body.  The jump is load-bearing:
// the thunk is a distinct symbol from the entry (a separate ld64 atom), so it can
// never fall through.  Each thunk is WEAK so ld64 / ELF / bnld coalesce the copies
// every native TU emits into one survivor program-wide — that single address is
// what delivers pkg.centry.identity.  emitCExportRegNormX64 derives the SysV sret
// shift (a large-aggregate return takes the hidden RDI pointer, shifting the GP
// argument registers) from the target's own signature via CEntryRegNormWalk, so the
// fresh RegMap here needs only its calling convention — no PlanFrame.
func emitCEntryThunks(a @asm.Assembler, pkgName *[]readonly char, targets @[]@ir.Func) {
	for ti := 0; ti < len(targets); ti++ {
		var tf @ir.Func = targets[ti]
		var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
		var thunk @[]char = cEntryThunkSym(pkgName, tf.Name)
		a.DefineLabel(thunk)
		a.SetWeak(thunk)
		emitCExportRegNormX64(a, rm, tf)
		var entry @[]char = symFor(pkgName, tf.Name)
		a.SetGlobal(entry)
		x64.Jmp(a, entry)
	}
}
