package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// emitCEntryThunks emits one weak `__centry.<mangled>` adaptation thunk per
// __c_entry target that needs C-ABI adaptation.  Two shapes, mirroring the
// #[c_export] entry:
//   - argument-register-only: normalize the target's narrow GP argument registers
//     (the same emitCExportRegNormX64 a #[c_export] entry uses), then an
//     unconditional JMP to the mangled entry — a C caller sign-/zero-extends the
//     narrow registers the SysV ABI leaves unspecified, then jumps into the body.
//   - a >16-byte by-value aggregate PARAMETER (SysV MEMORY class: bytes on the
//     stack) or a divergent multi-value RETURN: the C form differs from the
//     internal one (a plain pointer for the param; register-return for the tuple),
//     and a return adaptation happens AFTER the body returns, so a tail-jmp cannot
//     serve; the thunk becomes the #[c_export] TRAMPOLINE (emitCExportTrampolineX64,
//     selected by cExportNeedsTrampolineX64), which re-marshals the arguments (a
//     by-value aggregate is gathered and handed over as a pointer), calls the
//     mangled entry, repacks the return into the C struct-return form, and RETs.
// The jmp/trampoline is load-bearing: the thunk is a distinct symbol from the
// entry (a separate ld64 atom), so it can never fall through.  Each thunk is WEAK
// so ld64 / ELF / bnld coalesce the copies every native TU emits into one survivor
// program-wide — that single address is what delivers pkg.centry.identity.  Both
// paths derive the SysV sret shift (a large-aggregate / sret'd multi-return takes
// the hidden RDI pointer, shifting the GP argument registers) from the target's own
// signature, so the fresh RegMap here needs only its calling convention — no
// PlanFrame.
func emitCEntryThunks(a @asm.Assembler, pkgName *[]readonly char, targets @[]@ir.Func) {
	for ti := 0; ti < len(targets); ti++ {
		var tf @ir.Func = targets[ti]
		var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
		var thunk @[]char = cEntryThunkSym(pkgName, tf.Name)
		a.DefineLabel(thunk)
		a.SetWeak(thunk)
		var entry @[]char = symFor(pkgName, tf.Name)
		a.SetGlobal(entry)
		if cExportNeedsTrampolineX64(tf, rm.CC) {
			emitCExportTrampolineX64(a, rm, tf, entry)
		} else {
			emitCExportRegNormX64(a, rm, tf)
			x64.Jmp(a, entry)
		}
	}
}
