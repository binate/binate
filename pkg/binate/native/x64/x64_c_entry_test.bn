package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// emitCEntryThunks emits, for a narrow-argument __c_entry target, a WEAK
// `__centry.<mangled>` thunk (argument-register normalization + a jmp to the
// mangled entry).  Pins: the thunk symbol is defined and weak (so copies from
// several TUs coalesce = pkg.centry.identity), the mangled entry is referenced
// (the jump target), and some code is emitted (normalization + jump).
func TestEmitCEntryThunkNarrowTarget() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var ps @[]@ir.Param = make_slice(@ir.Param, 1)
	ps[0] = make(ir.Param)
	ps[0].Typ = types.TypInt8()
	var noResults @[]@types.Type
	var tf @ir.Func = ir.NewFunc("main", "cmp", ps, noResults)
	var targets @[]@ir.Func = make_slice(@ir.Func, 1)
	targets[0] = tf
	emitCEntryThunks(a, "main", targets)
	if a.HasError {
		return fail("emitCEntryThunks should not fail on a narrow-arg target")
	}
	if a.Sections[0].Len == 0 {
		return fail("thunk should emit register normalization + a jump")
	}
	var thunkIdx int = a.LookupSymbol(cEntryThunkSym("main", tf.Name))
	if thunkIdx < 0 {
		return fail("the weak __centry thunk symbol should be defined")
	}
	if a.Symbols[thunkIdx].Binding != asm.BIND_WEAK {
		return fail("the __centry thunk symbol must be weak (one survivor program-wide)")
	}
	if a.LookupSymbol(symFor("main", tf.Name)) < 0 {
		return fail("the thunk should reference the mangled entry (its jump target)")
	}
	return ""
}

// A narrow-arg callback that ALSO returns a large aggregate (sret) still emits a
// valid thunk.  On SysV-AMD64 the sret pointer occupies RDI (the first GP arg
// register), shifting the callback's own args by one — so PlanFrame must set the
// sret classification and the normalization must target the SHIFTED register
// (RSI), not RDI.  Pins that emitCEntryThunks runs PlanFrame on the target so the
// sret shift is seen (the register selection itself is byte-checked via the
// shared emitCExportRegNormX64 c_export test).
func TestEmitCEntryThunkSretReturnNarrowArg() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Name = "f"
		fields[i].Type = types.TypInt64()
	}
	var big @types.Type = types.MakeStructType("Big", fields)
	var ps @[]@ir.Param = make_slice(@ir.Param, 1)
	ps[0] = make(ir.Param)
	ps[0].Typ = types.TypInt8()
	var res @[]@types.Type = make_slice(@types.Type, 1)
	res[0] = big
	var tf @ir.Func = ir.NewFunc("main", "cb", ps, res)
	var targets @[]@ir.Func = make_slice(@ir.Func, 1)
	targets[0] = tf
	emitCEntryThunks(a, "main", targets)
	if a.HasError {
		return fail("sret-return narrow-arg thunk should emit without error")
	}
	if a.Sections[0].Len == 0 {
		return fail("thunk should emit register normalization + a jump")
	}
	if a.LookupSymbol(cEntryThunkSym("main", tf.Name)) < 0 {
		return fail("the weak __centry thunk symbol should be defined")
	}
	return ""
}
