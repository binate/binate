package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Direct function call lowering (Phase 3e)
// ============================================================
//
// SysV-AMD64 calling convention scalar-only subset:
//   - Integer args fill RDI/RSI/RDX/RCX/R8/R9 in order (6 regs).
//   - Args 7+ go on the stack at [rsp + 0..stackBytes), 16-byte
//     aligned at the call boundary (PlanFrame's OutgoingArgsSize
//     covers this).
//   - Single scalar return in RAX.
//
// Aggregate args are passed by emitAggregateArg per the SysV
// INTEGER-eightbyte / MEMORY classification: ≤ 16 bytes that fit in
// the remaining GP arg regs land in those regs; > 16 bytes (or ≤ 16
// bytes that didn't fit) goes wholly on the stack at the outgoing-
// args offset (no reg/stack split — see CallConv.SplitAggregates).
// Float args (XMM0..XMM7) are not yet implemented.  Aggregate returns
// (≤ 16 bytes in RAX/RDX; > 16 via hidden-RDI sret) are handled below.

// emitAggregateArg passes an aggregate-typed argument per the SysV
// classification produced by CallConv: regStart >= 0 with stackOff < 0
// means the aggregate fits wholly in INTEGER GP arg regs (≤ 2
// eightbytes that fit in the remaining budget) — load each eightbyte
// from the aggregate's storage into argReg(regStart + w); regStart < 0
// with stackOff >= 0 means MEMORY class (> 16 bytes, or ≤ 16 bytes
// that didn't fit) — load each word and store it into the outgoing-
// args area at [rsp + stackOff + 8*w].  `arg` is an aggregate SSA
// value, which the amd64 backend represents as a pointer to its
// storage (data-region / alloc form); getOperand materialises that
// pointer.
//
// RAX is the load-shuttle scratch for the MEMORY path: it isn't in
// regPool (regmap kept it out as the return-value / IMUL/IDIV
// implicit), isn't a GP arg register, and the CALL hasn't happened
// yet so RAX is dead.  Mirrors arm64's use of X16 (AAPCS intra-call
// scratch) in arm64_call.bn's split-aggregate stack half.
//
// SysV has no reg/stack split case (CallConv.SplitAggregates = false),
// so the regStart >= 0 && stackOff >= 0 combination is unreachable;
// emitAggregateArg ignores it defensively.
func emitAggregateArg(a @asm.Assembler, rm @common.RegMap, arg @ir.Instr, regStart int,
		stackOff int) {
	var ptr int = getOperand(a, rm, arg.ID)
	if ptr < 0 { return }
	// Indirect-large: pkg/codegen emits the param as a plain `ptr`,
	// and LLVM lowers it to "pointer in next free arg reg".  Native
	// passes the data-region pointer as a single 8-byte arg (in reg
	// or on stack), NOT the struct contents laid out.
	if rm.CC.IndirectLargeAggregates && arg.Typ.SizeOf() > rm.CC.AggregateInRegMax {
		if regStart >= 0 {
			var dst int = argReg(regStart)
			if ptr != dst {
				x64.Mov(a, x64.Reg(dst, x64.SZ64), x64.Reg(ptr, x64.SZ64))
			}
		} else if stackOff >= 0 {
			x64.Mov(a, x64.Mem(x64.RSP, stackOff, x64.SZ64), x64.Reg(ptr, x64.SZ64))
		}
		return
	}
	var nWords int = common.ArgWords(arg.Typ)
	if regStart >= 0 && stackOff < 0 {
		// All eightbytes in GP arg regs (≤ AggregateInRegMax fits).
		for w := 0; w < nWords; w++ {
			x64.Mov(a, x64.Reg(argReg(regStart + w), x64.SZ64), x64.Mem(ptr, 8 * w, x64.SZ64))
		}
		return
	}
	if regStart < 0 && stackOff >= 0 {
		// MEMORY class for ≤ AggregateInRegMax aggregates that
		// didn't fit in the remaining GP arg regs: load each
		// word into RAX, store to [rsp + stackOff + 8*w].
		for w := 0; w < nWords; w++ {
			x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(ptr, 8 * w, x64.SZ64))
			x64.Mov(a, x64.Mem(x64.RSP, stackOff + 8 * w, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
		}
		return
	}
}

// retGpReg maps the i-th GP-class return slot to its register under LLVM's
// x86-64 first-class-struct return lowering: RAX, RDX, RCX (3 GP return regs;
// a 4th GP word routes the whole tuple to sret — see multiReturnTupleNeedsSret).
func retGpReg(i int) int {
	if i == 0 { return x64.RAX }
	if i == 1 { return x64.RDX }
	return x64.RCX
}

// collectMultiReturnTuple stores an in-register multi-return tuple from its
// return registers into the call result's spill slot, FIELD-PER-REGISTER —
// matching LLVM's x86-64 first-class-struct return lowering (no eightbyte
// coalescing): a non-float field's words come from RAX,RDX,RCX (retGp), a
// float-scalar field from XMM0,XMM1 then x87 ST0,ST1 (retFp, via a GP scratch
// for the XMM slots since native values live in GP spill slots, or FSTP
// straight to memory for the x87 slots).  Each field lands at its tuple offset
// so OP_EXTRACT reads its component there.  So `(float32,float32)` collects
// XMM0,XMM1 (not one coalesced XMM0), `(float32,int32)` collects XMM0 + EAX,
// `(i32,i32)` RAX + RDX, `(f64,f64,f64)` XMM0,XMM1 + ST0 — each its own
// register, matching the LLVM-compiled callee at the native↔LLVM boundary
// (claude-todo #112).  Shared by the direct and every indirect (iface /
// func-value / call-indirect) collect; the register-count sret threshold
// routed > 3-GP / > 4-FP tuples to sret already.  Symmetric mirror of
// emitMultiReturnPack + aa64's collectMultiReturnFields.
func collectMultiReturnTuple(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	var spillOff int = rm.LookupSpill(ins.ID)
	if spillOff < 0 { return }
	storeMultiReturnTupleFields_x64(a, ins.Typ, x64.RSP, spillOff, scratchReg(rm), rm.CC.NumFpRetRegs)
}

// storeMultiReturnTupleFields_x64 is the field-per-register-by-class store loop
// shared by collectMultiReturnTuple (the RegMap-driven caller collect) and the
// func-value / closure / spill SHIM store-through-retbuf paths (which have no
// RegMap).  It reproduces LLVM's x86-64 first-class-struct return lowering
// EXACTLY: a non-float field's words come from RAX,RDX,RCX (retGp) written at
// FieldOffset with a SIZED store (so a sub-word field like (u16,u16,u16) does not
// clobber its 8-byte-cell neighbor); a float-scalar field from XMM0,XMM1 then x87
// ST0,ST1 (retFp) — the XMM slots move through `scratch` (a GP reg that must be
// distinct from the return regs and `base`) since native values land in GP-sized
// slots, the x87 slots FSTP straight to memory.  Each field lands at base+baseOff
// +FieldOffset.  numFpRetRegs is the count of XMM return registers before x87
// overflow (SysV: 2).  A MANAGED field rides the non-float GP path — a plain
// pointer-word move, ownership transferring from the return reg into the slot (no
// RefInc/RefDec): the shim forwards the callee's already-owned words, it does not
// own the tuple.
func storeMultiReturnTupleFields_x64(a @asm.Assembler, tupleTyp @types.Type, base int, baseOff int,
		scratch int, numFpRetRegs int) {
	var retGp int = 0
	var retFp int = 0
	for fi := 0; fi < len(tupleTyp.Fields); fi++ {
		var fldTyp @types.Type = tupleTyp.Fields[fi].Type
		var fldOff int = baseOff + tupleTyp.FieldOffset(fi)
		if common.IsFloatScalarTyp(fldTyp) {
			if retFp < numFpRetRegs {
				var fldSz int = fldTyp.SizeOf()
				if common.FloatScalarIsI32(fldTyp) {
					x64.Movd_xmm_to_gp(a, scratch, x64.XMM0 + retFp)
				} else {
					x64.Movq_xmm_to_gp(a, scratch, x64.XMM0 + retFp)
					fldSz = 8
				}
				emitScalarStore(a, scratch, base, fldOff, fldSz)
			} else {
				// x87 overflow: ST0 holds this field.  The overflow floats
				// arrive in field order, and field order is ST0-first (LLVM
				// put the lower-indexed overflow float on top), so FSTP pops
				// ST0 straight to the slot and the next overflow float rises
				// to ST0 for its own FSTP — no FXCH needed.
				if common.FloatScalarIsI32(fldTyp) {
					x64.Fstps(a, x64.Mem(base, fldOff, x64.SZ32))
				} else {
					x64.Fstpl(a, x64.Mem(base, fldOff, x64.SZ64))
				}
			}
			retFp = retFp + 1
		} else if common.IsAggregateTyp(fldTyp) {
			var fldSz int = fldTyp.SizeOf()
			for w := 0; w * 8 < fldSz && retGp < 3; w++ {
				x64.Mov(a, x64.Mem(base, fldOff + 8 * w, x64.SZ64), x64.Reg(retGpReg(retGp), x64.SZ64))
				retGp = retGp + 1
			}
		} else {
			if retGp < 3 {
				var fldSz int = fldTyp.SizeOf()
				if fldSz <= 0 { fldSz = 8 }
				emitScalarStore(a, retGpReg(retGp), base, fldOff, fldSz)
				retGp = retGp + 1
			}
		}
	}
}

// collectSseAggregateReturn stores an in-register SSE aggregate return into the
// caller's data region at dataOff — the mirror of emitSseAggregateReturnPack
// (x64_return.bn): each SSE eightbyte comes back in XMM0/XMM1 (Movss_store for a
// 4-byte lone f32, else Movlps_store), each INTEGER eightbyte in RAX/RDX, written
// to [rsp + dataOff + 8*eb].  The return registers still hold the callee's result
// here — nothing between the CALL and this collect clobbers XMM0/XMM1 or RAX/RDX
// (ResetRegs only frees the GP scratch pool).  Dormant until the x64 SSE gate
// flips (ReturnsSseInRegs false).
func collectSseAggregateReturn(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr, dataOff int) {
	emitSseReturnCollectTo(a, ins.Typ, x64.RSP, dataOff)
}

// emitCall lowers OP_CALL.  ins.StrVal is the dot-qualified callee
// name (already-mangled by symFor); a.SetGlobal declares the
// callee as an extern so the ELF carries an R_X86_64_PC32 reloc
// for cross-translation-unit calls.
func emitCall(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	// Build the argTypes slice once for the CallConv dispatch.
	// SysV-AMD64 sret: an aggregate or multi-return tuple bigger
	// than CallConv.InternalSretBytes is returned via a hidden
	// buffer pointer in RDI, shifting every user arg by one
	// register.  We model
	// the shift by synthesising a pointer-typed leading entry in
	// argTypes — CallArgRegStart then naturally places user arg i
	// at register slot i+1.
	var bigMultiRet bool = ins.ID >= 0 && rm.CC.CallReturnsBigMultiReturn(ins)
	var bigRet bool = ins.ID >= 0 && (rm.CC.CallReturnsBigAggregate(ins) || bigMultiRet)
	var nDispatchArgs int = len(ins.Args)
	if bigRet { nDispatchArgs = nDispatchArgs + 1 }
	var argTypes @[]@types.Type = make_slice(@types.Type, nDispatchArgs)
	if bigRet {
		// First slot is the hidden sret-buffer pointer — a single
		// 8-byte word that consumes one GP arg register.
		argTypes[0] = types.TypInt()
		for i := 0; i < len(ins.Args); i++ {
			argTypes[i + 1] = ins.Args[i].Typ
		}
	} else {
		for i := 0; i < len(ins.Args); i++ {
			argTypes[i] = ins.Args[i].Typ
		}
	}

	// SysV-AMD64 NSRN: float-scalar args go to XMM(NSRN), separate from the GP
	// NGRN counter that CallArgRegStart tracks.  The first NumFpArgRegs land in
	// XMM0..XMM7; a further float overflows to the outgoing-args stack (an
	// 8-byte slot at CallArgStackOff, which now reserves space for it), like any
	// arg past its register budget.  nsrn here counts EVERY float in arg order,
	// the same way the CallArgStackOff walker does, so the overflow decision and
	// the stack offset agree.
	var nsrn int = 0
	for ai := 0; ai < len(ins.Args); ai++ {
		var arg @ir.Instr = ins.Args[ai]
		if common.IsFloatScalarTyp(arg.Typ) {
			var fsrc int = getOperand(a, rm, arg.ID)
			if fsrc >= 0 {
				if nsrn < rm.CC.NumFpArgRegs {
					x64.Movq_gp_to_xmm(a, x64.XMM0 + nsrn, fsrc)
				} else {
					var dispatchIdx int = ai
					if bigRet { dispatchIdx = ai + 1 }
					var stackOff int = rm.CC.CallArgStackOff(argTypes, dispatchIdx)
					if stackOff >= 0 {
						x64.Mov(a, x64.Mem(x64.RSP, stackOff, x64.SZ64), x64.Reg(fsrc, x64.SZ64))
					}
				}
			}
			nsrn = nsrn + 1
			rm.ResetRegs()
			continue
		}
		// User arg i lives at dispatch slot i (no sret) or i+1
		// (sret — the synthesised pointer takes slot 0).
		var dispatchIdx int = ai
		if bigRet { dispatchIdx = ai + 1 }
		var regStart int = rm.CC.CallArgRegStart(argTypes, dispatchIdx)
		var stackOff int = rm.CC.CallArgStackOff(argTypes, dispatchIdx)
		if common.IsAggregateTyp(arg.Typ) {
			// A SysV-SSE aggregate that fits (stackOff < 0) rides XMM/GP by
			// eightbyte class; emitSseAggregateArg returns the XMM count it
			// consumed so nsrn stays in step with CallArgStackOff's walker.  A
			// MEMORY-class SSE aggregate (stackOff >= 0) and every non-SSE
			// aggregate take the plain GP/MEMORY path.
			if rm.CC.PassesSseInRegs(arg.Typ) && stackOff < 0 {
				nsrn = nsrn + emitSseAggregateArg(a, rm, arg, regStart, nsrn)
			} else {
				emitAggregateArg(a, rm, arg, regStart, stackOff)
			}
			rm.ResetRegs()
			continue
		}
		// emitValOperand so a global address passed as an arg
		// (`f(&G)`) is materialized — bare getOperand misses the
		// IsGlobalRef pseudo and drops the arg.
		var src int = emitValOperand(a, pkgName, rm, arg)
		if src < 0 { continue }
		if regStart >= 0 {
			var dst int = argReg(regStart)
			if src != dst {
				x64.Mov(a, x64.Reg(dst, x64.SZ64), x64.Reg(src, x64.SZ64))
			}
		} else {
			x64.Mov(a, x64.Mem(x64.RSP, stackOff, x64.SZ64), x64.Reg(src, x64.SZ64))
		}
		// Per-arg reset: the source register is dead after the MOV
		// into argReg/stack.  Without this, a long arg list saturates
		// the regPool (mirrors arm64's per-arg ResetRegs in
		// arm64_call.bn).
		rm.ResetRegs()
	}

	// sret setup: LEA &returnBuffer into RDI.  Single-aggregate
	// returns land in the alloc data region; multi-return tuples
	// land in the spill slot (sized to the full tuple by
	// PlanFrame).
	if bigRet {
		var sretOff int = -1
		if bigMultiRet {
			sretOff = rm.LookupSpill(ins.ID)
		} else {
			sretOff = rm.LookupAlloc(ins.ID)
		}
		if sretOff >= 0 {
			x64.Lea(a, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSP, sretOff, x64.SZ64))
		}
	}

	// Emit the CALL.  __c_call carries a verbatim C symbol on
	// ins.StrVal (no Binate mangling); every other call op routes
	// through symFor, which handles dot-qualified names (e.g.
	// "rt.Alloc") and bare names alike.  Both paths still
	// need symPrefixed for the object-format linkage convention
	// (Mach-O leading '_' vs ELF bare).  a.SetGlobal declares the
	// callee for cross-section relocs.
	var callee @[]char
	if ins.Op == iropcode.OP_C_CALL {
		callee = symPrefixed(ins.StrVal)
	} else {
		callee = symFor(pkgName, ins.StrVal)
	}
	a.SetGlobal(callee)
	// SysV variadic calls require AL = the number of vector (XMM)
	// registers used to pass arguments.  `nsrn` counted exactly those
	// in the float-arg loop above, so AL = nsrn; a variadic double in
	// XMM0 that left AL = 0 made printf read it as 0.  printf and
	// friends read AL, so an integer-only variadic call still needs
	// AL = 0 (nsrn == 0 there).
	if ins.Op == iropcode.OP_C_CALL && ins.CFixedArgs < len(ins.Args) {
		// AL = number of XMM regs used to pass args.  SysV caps the count at 8
		// even when more float args overflow to the stack (nsrn can exceed 8).
		var al int = nsrn
		if al > 8 { al = 8 }
		x64.Mov(a, x64.Reg(x64.RAX, x64.SZ8), x64.Imm(al))
	}
	x64.Call(a, callee)

	// CALL clobbers all caller-saved regs (RAX/RCX/RDX/RSI/RDI/R8-R11
	// per SysV); the entire regPool is dead.  Reset before allocating
	// the return slot.
	rm.ResetRegs()
	if ins.ID < 0 { return }
	if ins.Typ == nil { return }

	// Multi-return tuple: bigRet (sret) wrote the bytes directly
	// into the spill slot via the hidden RDI buffer pointer — no
	// register-to-slot copying needed.  ≤ 16 bytes: SysV packs
	// RAX (first word) + RDX (second word); store each into the
	// spill slot at the field's offset.
	if common.IsMultiReturnCall(ins) {
		if bigMultiRet { return }
		collectMultiReturnTuple(a, rm, ins)
		return
	}

	// Single aggregate return.  Three cases:
	//   - bigRet (> 16 bytes via sret): callee wrote through RDI;
	//     just LEA the data-region pointer into rd.
	//   - ≤ 8 bytes: packed into RAX; store RAX into the data
	//     region; LEA rd.
	//   - 9..16 bytes: packed into RAX (low 8) + RDX (high 8);
	//     store both into the data region; LEA rd.
	if common.IsAggregateTyp(ins.Typ) {
		var dataOff int = rm.LookupAlloc(ins.ID)
		if dataOff < 0 { return }
		var sz int = ins.Typ.SizeOf()
		if sz <= 0 { return }
		if !bigRet && rm.CC.ReturnsSseInRegs(ins.Typ) {
			// ≤ 16-byte SSE aggregate: the callee packed each eightbyte by
			// class (emitSseAggregateReturnPack) — collect the mirror image:
			// SSE eightbyte from XMM0/XMM1, INTEGER from RAX/RDX, into the data
			// region at 8*eb.  Dormant until the SSE gate flips.
			collectSseAggregateReturn(a, rm, ins, dataOff)
		} else if !bigRet {
			// ≤ 16 bytes — pack RAX (+ RDX) into the data region.
			x64.Mov(a, x64.Mem(x64.RSP, dataOff, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
			if sz > 8 {
				x64.Mov(a, x64.Mem(x64.RSP, dataOff + 8, x64.SZ64), x64.Reg(x64.RDX, x64.SZ64))
			}
		}
		var rd int = nextReg(rm, ins.ID)
		x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.Mem(x64.RSP, dataOff, x64.SZ64))
		return
	}
	if ins.Typ.Kind == types.TYP_VOID { return }
	// Single scalar return: RAX → rd → spill, except for float
	// scalars which arrive in XMM0 per SysV-AMD64.  MOVQ XMM0 →
	// rd (full 64-bit pattern) parks the bits in the same GP-spill-
	// slot form every other float-typed value uses.
	if common.IsFloatScalarTyp(ins.Typ) {
		var frd int = nextReg(rm, ins.ID)
		x64.Movq_xmm_to_gp(a, frd, x64.XMM0)
		return
	}
	// For narrow returns (bool / sub-byte int), SysV-AMD64 leaves
	// the upper bits of RAX *undefined* — LLVM's i1 return from
	// `ret i1 %v` emits AL with whatever was previously in the
	// upper 56 bits.  A naïve 64-bit MOV propagates that garbage
	// and downstream consumers see false bools as non-zero (e.g.
	// `if !HasTyp(&o)` taking the then-branch when HasTyp returned
	// true).  Zero-extend the relevant low N bytes to clean the
	// result.
	var rd int = nextReg(rm, ins.ID)
	var retSz int = ins.Typ.SizeOf()
	if retSz < 0 { retSz = 8 }
	// Peel TYP_NAMED so a named sub-word return sign-extends per its
	// underlying (a bare TYP_NAMED reads Signed false → zero-extend).
	var rSgn @types.Type = types.StripWrappers(ins.Typ)
	var signed bool = rSgn != nil && rSgn.Signed
	if retSz == 1 {
		if signed {
			x64.Movsx(a, x64.Reg(rd, x64.SZ64), x64.Reg(x64.RAX, x64.SZ8))
		} else {
			x64.Movzx(a, x64.Reg(rd, x64.SZ64), x64.Reg(x64.RAX, x64.SZ8))
		}
		return
	}
	if retSz == 2 {
		if signed {
			x64.Movsx(a, x64.Reg(rd, x64.SZ64), x64.Reg(x64.RAX, x64.SZ16))
		} else {
			x64.Movzx(a, x64.Reg(rd, x64.SZ64), x64.Reg(x64.RAX, x64.SZ16))
		}
		return
	}
	if retSz == 4 {
		if signed {
			x64.Movsxd(a, x64.Reg(rd, x64.SZ64), x64.Reg(x64.RAX, x64.SZ32))
		} else {
			// MOV r32, r32 implicitly zero-extends to 64-bit on x86-64.
			x64.Mov(a, x64.Reg(rd, x64.SZ32), x64.Reg(x64.RAX, x64.SZ32))
		}
		return
	}
	if rd != x64.RAX {
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
	}
}

// canonicalizeSubWordSeamX64 re-extends a narrow NON-FLOAT scalar register in
// place per its SizeOf width and signedness — the x64 twin of aarch64's
// canonicalizeSubWordReturn, used at the func-value/iface dispatch seam (shim arg
// marshalling, shim-return collection) to clean a narrow value a foreign producer
// may have left with dirty high bits.  Unlike emitSubWordNarrow (keyed on
// common.SubWordNarrow, which reports bool NON-narrow), this keys on SizeOf via
// normalizeNarrowRegParamX64, so a 1-byte bool — the canonical 64-bit-TEST case —
// is zero-extended too.  Floats are excluded: a float32 is SizeOf 4 and would
// otherwise be Movsxd'd, corrupting its bit image (a float rides the seam as GP
// bits and must pass through unchanged); word-size / pointer / aggregate values
// (SizeOf >= 8) are already skipped by normalizeNarrowRegParamX64.
func canonicalizeSubWordSeamX64(a @asm.Assembler, reg int, t @types.Type) {
	if t == nil { return }
	if common.IsFloatScalarTyp(t) { return }
	normalizeNarrowRegParamX64(a, reg, t)
}
