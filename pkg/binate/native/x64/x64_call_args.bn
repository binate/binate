package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/aggcopy"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"

// placeCallArgsX64 places a call's arguments per SysV-AMD64, for a direct call
// (emitCall) and an indirect one (emitCallIndirect) alike, and returns the
// number of float arguments it counted (the AL a variadic C call needs).  When
// sret is set the call returns through a hidden buffer pointer in RDI, which
// takes argument slot 0 and shifts every argument one slot along -- modeled by a
// pointer-typed leading entry in the dispatch types, so CallArgRegStart places
// argument i at register slot i+1.  The caller loads RDI afterwards.
//
// Argument-register-homed scalars are placed first as one parallel move
// (x64_call_homes.bn) and skipped by the loop, which keeps every filled argument
// register out of its reloads.  Float scalars go to XMM0..XMM7 in order and then
// to the outgoing-args stack (CallArgStackOff reserves their slots); an
// SSE-class aggregate that fits rides XMM/GP registers by eightbyte; any other
// aggregate takes the GP / MEMORY path (emitAggregateArg); other scalars take
// GP registers, then the stack.
func placeCallArgsX64(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		args @[]@ir.Instr, sret bool) int {
	var nDispatchArgs int = len(args)
	if sret { nDispatchArgs = nDispatchArgs + 1 }
	var argTypes @[]@types.Type = make_slice(@types.Type, nDispatchArgs)
	var first int = 0
	if sret {
		// The hidden sret-buffer pointer: one 8-byte word, one GP register.
		argTypes[0] = types.TypInt()
		first = 1
	}
	for i := 0; i < len(args); i++ {
		argTypes[i + first] = args[i].Typ
	}

	var dstReg @[]int = make_slice(int, len(args))
	var dstStack @[]int64 = make_slice(int64, len(args))
	for ai := 0; ai < len(args); ai++ {
		dstReg[ai] = -1
		var rs int = rm.CC.CallArgRegStart(argTypes, ai + first)
		if rs >= 0 { dstReg[ai] = argReg(rs) }
		dstStack[ai] = rm.CC.CallArgStackOff(argTypes, ai + first)
	}
	var filled @[]int = prePlaceArgRegHomedArgsX64(a, rm, args, dstReg, dstStack)
	reserveFilledArgRegsX64(rm, filled)

	// nsrn counts EVERY float in argument order, as the CallArgStackOff walker
	// does, so the register-or-stack decision and the stack offset agree.
	var nsrn int = 0
	for ai := 0; ai < len(args); ai++ {
		var arg @ir.Instr = args[ai]
		var regStart int = rm.CC.CallArgRegStart(argTypes, ai + first)
		var stackOff int64 = rm.CC.CallArgStackOff(argTypes, ai + first)
		if callconv.IsFloatScalarTyp(arg.Typ) {
			var fsrc int = getOperand(a, rm, arg.ID)
			if fsrc >= 0 {
				if nsrn < rm.CC.NumFpArgRegs {
					x64.Movq_gp_to_xmm(a, x64.XMM0 + nsrn, fsrc)
				} else if stackOff >= 0 {
					emitFrameStore(a, fsrc, x64.RSP, stackOff, 8)
				}
			}
			nsrn = nsrn + 1
			rm.ResetRegs()
			reserveFilledArgRegsX64(rm, filled)
			continue
		}
		if argHomedInArgRegX64(rm, arg) { continue }
		if callconv.IsAggregateTyp(arg.Typ) {
			// emitSseAggregateArg returns the XMM registers it consumed, so nsrn
			// stays in step with CallArgStackOff's walker.  A MEMORY-class SSE
			// aggregate (stackOff >= 0) takes the plain GP / MEMORY path.
			if rm.CC.PassesSseInRegs(arg.Typ) && stackOff < 0 {
				nsrn = nsrn + emitSseAggregateArg(a, rm, arg, regStart, nsrn)
			} else {
				emitAggregateArg(a, rm, arg, regStart, stackOff)
			}
			if regStart >= 0 {
				filled = appendArgRegsX64(filled, regStart, cast(int, callconv.ArgWords(arg.Typ)))
			}
			rm.ResetRegs()
			reserveFilledArgRegsX64(rm, filled)
			continue
		}
		// emitValOperand so a global address passed as an argument (`f(&G)`) is
		// materialized; getOperand would miss the IsGlobalRef pseudo.
		var src int = emitValOperand(a, pkgName, rm, arg)
		if src < 0 { continue }
		if regStart >= 0 {
			var dst int = argReg(regStart)
			if src != dst {
				x64.Mov(a, x64.Reg(dst, x64.SZ64), x64.Reg(src, x64.SZ64))
			}
			filled = common.AppendInt(filled, dst)
		} else {
			emitFrameStore(a, src, x64.RSP, stackOff, 8)
		}
		// The source register is dead after the move; without the reset a long
		// argument list saturates the register pool.
		rm.ResetRegs()
		reserveFilledArgRegsX64(rm, filled)
	}
	return nsrn
}

// loadWordBytesX64 loads the aggregate eightbyte at [base + off], of which n
// bytes remain (all 8 when n >= 8), into dst, reading no byte past
// base + off + n: an aggregate whose size is not a multiple of 8 may end where
// unmapped memory starts (a global or heap object at a page end, read in place
// through an elided aggregate load).  A whole eightbyte is one load; a partial
// one is assembled in dst from the 4-, 2- and 1-byte pieces aggcopy.TailPieces
// plans, the later pieces loaded through tmp, shifted into place and or'd in.
// dst, tmp and base must be distinct (it fails loud otherwise).
func loadWordBytesX64(a @asm.Assembler, dst int, base int, off int, n int, tmp int) {
	if n >= 8 {
		x64.Mov(a, x64.Reg(dst, x64.SZ64), x64.Mem(base, off, x64.SZ64))
		return
	}
	if dst == base || tmp == base || dst == tmp {
		a.SetError("native amd64: a partial aggregate word with overlapping registers")
		return
	}
	var pieces @[]aggcopy.Piece = aggcopy.TailPieces(0, n, false)
	for i := 0; i < len(pieces); i++ {
		var r int = tmp
		if i == 0 { r = dst }
		var at int = off + pieces[i].Off
		if pieces[i].Width == 4 {
			x64.Mov(a, x64.Reg(r, x64.SZ32), x64.Mem(base, at, x64.SZ32))
		} else if pieces[i].Width == 2 {
			x64.Movzx(a, x64.Reg(r, x64.SZ64), x64.Mem(base, at, x64.SZ16))
		} else {
			x64.Movzx(a, x64.Reg(r, x64.SZ64), x64.Mem(base, at, x64.SZ8))
		}
		if i > 0 {
			x64.Shl(a, x64.Reg(tmp, x64.SZ64), x64.Imm(8 * pieces[i].Off))
			x64.Or(a, x64.Reg(dst, x64.SZ64), x64.Reg(tmp, x64.SZ64))
		}
	}
}

// loadAggWordX64 loads word w -- bytes [8w, 8w + 8) -- of the size-byte aggregate at
// base into dst, zero above the aggregate's end, reading no byte past it.  The
// aggregate may be read in place from its source (common.AggLoadElision), which can
// end where mapped memory does, so a whole word loaded past its end could fault.  A
// last word of 4, 2 or 1 bytes is one load of its width; another one, in an aggregate
// of more than 8 bytes, is the 8 bytes ending at the aggregate's end shifted right
// past the bytes of the word before.  An aggregate of 3, 5, 6 or 7 bytes is its top 4
// (or 2) bytes, with each lower piece shifted in below them by a 2- or 1-byte load
// into dst's low bits, which leaves the rest of dst alone; base and dst then differ.
// No other register is touched.
func loadAggWordX64(a @asm.Assembler, dst int, base int, w int, size int64) {
	var off int = 8 * w
	var n int64 = size - cast(int64, off)
	if n >= 8 {
		x64.Mov(a, x64.Reg(dst, x64.SZ64), x64.Mem(base, off, x64.SZ64))
		return
	}
	if n <= 0 {
		a.SetError("native amd64: an aggregate word past the aggregate's end")
		return
	}
	if n == 4 {
		x64.Mov(a, x64.Reg(dst, x64.SZ32), x64.Mem(base, off, x64.SZ32))
		return
	}
	if n == 2 || n == 1 {
		var sz int = x64.SZ8
		if n == 2 { sz = x64.SZ16 }
		x64.Movzx(a, x64.Reg(dst, x64.SZ64), x64.Mem(base, off, sz))
		return
	}
	if size > 8 {
		x64.Mov(a, x64.Reg(dst, x64.SZ64), x64.Mem(base, cast(int, size) - 8, x64.SZ64))
		x64.Shr(a, x64.Reg(dst, x64.SZ64), x64.Imm(cast(int, 8 * (8 - n))))
		return
	}
	if dst == base {
		a.SetError("native amd64: a partial aggregate word loaded over its own base")
		return
	}
	var rem int = cast(int, n)
	if rem >= 4 {
		x64.Mov(a, x64.Reg(dst, x64.SZ32), x64.Mem(base, rem - 4, x64.SZ32))
		rem = rem - 4
	} else {
		x64.Movzx(a, x64.Reg(dst, x64.SZ64), x64.Mem(base, rem - 2, x64.SZ16))
		rem = rem - 2
	}
	for rem > 0 {
		var piece int = 1
		var sz int = x64.SZ8
		if rem >= 2 {
			piece = 2
			sz = x64.SZ16
		}
		x64.Shl(a, x64.Reg(dst, x64.SZ64), x64.Imm(8 * piece))
		x64.Mov(a, x64.Reg(dst, sz), x64.Mem(base, rem - piece, sz))
		rem = rem - piece
	}
}
