package "pkg/binate/native/x64"

import "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/build"
import "pkg/builtins/testing"
import "pkg/std/os"

// An indirect call places its arguments as a direct call does: a ninth float
// argument goes on the stack and an SSE-class struct rides XMM registers (the
// second of two struct parameters is forwarded, so XMM0 / XMM1 hold the wrong
// one unless the struct is placed there).
// Checked end to end on a host that runs x86-64 (buildAndRunX64): a C driver
// hands C callees to natively compiled callit_* functions, which call them
// through OP_CALL_INDIRECT; the driver exits 42 when every result is right, else
// 100 plus a bit per wrong one.

// indirectRunDriver is the C side: the callees and the checks.
var indirectRunDriver *[]readonly char = "struct P { double x, y; };\n"
		"double sum9(double a, double b, double c, double d, double e, double f, double g,\n"
		"    double h, double i) { return a + b + c + d + e + f + g + h + i; }\n"
		"long sumP(struct P p) { return (long)(p.x * 10 + p.y); }\n"
		"long callit_f(void *fp);\n"
		"long callit_p(void *fp, struct P decoy, struct P p);\n"
		"int main(void) {\n"
		"  int bad = 0;\n"
		"  struct P decoy = { 9.0, 9.0 };\n"
		"  struct P p = { 1.0, 2.0 };\n"
		"  if (callit_f((void *)sum9) != 45) bad |= 1;\n"
		"  if (callit_p((void *)sumP, decoy, p) != 12) bad |= 2;\n"
		"  return bad == 0 ? 42 : 100 + bad;\n"
		"}\n"

// indirectRunFunc returns an exported function `name`(fp *uint8, extra...)
// returning int, with its entry block; params[0] is fp.
func indirectRunFunc(name *[]readonly char,
		extra @[]@types.Type) (@ir.Func, @ir.Block, @[]@ir.Instr) {
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", buf.CopyStr(name), make_slice(@ir.Param, 0), results)
	var params @[]@ir.Param = make_slice(@ir.Param, 1 + len(extra))
	params[0] = irbuild.NewParam(f, "fp", types.MakePointerType(types.TypUint8()))
	for i := 0; i < len(extra); i++ {
		params[i + 1] = irbuild.NewParam(f, "x", extra[i])
	}
	f.Params = params
	var ce @[]@[]char = make_slice(@[]char, 1)
	ce[0] = buf.CopyStr(name)
	f.CExportNames = ce
	var b @ir.Block = ir.AddBlock(f, "entry")
	var refs @[]@ir.Instr = make_slice(@ir.Instr, len(params))
	for i := 0; i < len(params); i++ {
		refs[i] = irbuild.NewParamRef(f, params[i])
	}
	return f, b, refs
}

// indirectRunModule builds callit_f (nine float64 arguments, float64 result) and
// callit_p (forwarding the second of two {float64, float64} struct parameters).
func indirectRunModule() @ir.Module {
	var m @ir.Module = ir.NewModule("\"main\"")
	var none @[]@types.Type
	var fF @ir.Func
	var bF @ir.Block
	var rF @[]@ir.Instr
	fF, bF, rF = indirectRunFunc("callit_f", none)
	var fargs @[]@ir.Instr = make_slice(@ir.Instr, 9)
	var digits *[]readonly char = "123456789"
	for i := 0; i < 9; i++ {
		var text @[]char = make_slice(char, 3)
		text[0] = digits[i]
		text[1] = '.'
		text[2] = '0'
		fargs[i] = irbuild.EmitConstFloat(bF, text, types.TypFloat64())
	}
	var sum @ir.Instr = irbuild.EmitCallIndirect(bF, rF[0], fargs, types.TypFloat64())
	var one @[]@ir.Instr = make_slice(@ir.Instr, 1)
	one[0] = irbuild.EmitCast(bF, sum, types.TypInt())
	irbuild.EmitReturn(bF, one)
	m.AddFunc(fF)

	var pX @[]@types.Type = make_slice(@types.Type, 2)
	var pf @[]@types.Type = make_slice(@types.Type, 2)
	pf[0] = types.TypFloat64()
	pf[1] = types.TypFloat64()
	var p @types.Type = x64TestStruct("P", pf)
	pX[0] = p
	pX[1] = p
	var fP @ir.Func
	var bP @ir.Block
	var rP @[]@ir.Instr
	fP, bP, rP = indirectRunFunc("callit_p", pX)
	var pargs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	pargs[0] = rP[2]
	var three @[]@ir.Instr = make_slice(@ir.Instr, 1)
	three[0] = irbuild.EmitCallIndirect(bP, rP[0], pargs, types.TypInt())
	irbuild.EmitReturn(bP, three)
	m.AddFunc(fP)
	return m
}

func TestCallIndirectPlacesArgsLikeACall() testing.TestResult {
	// ARCH_X64 turns on SysV's SSE classification of aggregates (SysVSseInRegs).
	var saved types.TargetInfo = types.GetTarget()
	var tgt types.TargetInfo
	tgt.PointerSize = 8
	tgt.IntSize = 8
	tgt.MaxAlign = 8
	tgt.Arch = types.ARCH_X64
	types.SetTarget(tgt)
	defer types.SetTarget(saved)
	var rc int
	var ran bool
	var err testing.TestResult
	rc, ran, err = buildAndRunX64(indirectRunModule(), indirectRunDriver)
	if len(err) > 0 { return err }
	if !ran || rc == 42 { return "" }
	var msg @[]char = buf.CopyStr("indirect calls returned wrong results:")
	if rc == 101 || rc == 103 { msg = buf.Concat(msg, " nine floats") }
	if rc == 102 || rc == 103 { msg = buf.Concat(msg, " SSE struct") }
	if rc < 101 || rc > 103 { msg = buf.Concat(msg, " (the program did not run to its checks)") }
	return fail(msg)
}

// buildAndRunX64 emits m as an x86-64 object, builds it into a program with the
// C source csrc and runs it, returning its exit status (-1 when it did not exit
// normally).  ran is false when this host cannot run an x86-64 program: one runs
// under Rosetta on an Apple Silicon Mac (or natively on an Intel one) as Mach-O,
// and natively on Linux x86-64 as ELF.  A non-empty error reports a build failure.
func buildAndRunX64(m @ir.Module, csrc *[]readonly char) (int, bool, testing.TestResult) {
	var macho bool = canRunX64Macho()
	if !macho && !(build.OS == build.OS_LINUX && build.Arch == build.ARCH_X64) {
		return 0, false, ""
	}
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return 0, true, fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var objPath @[]char = buf.Concat(dir, "/prog.o")
	var format *[]readonly char = "elf"
	if macho { format = "macho" }
	if !EmitObject(m, format, objPath, Options{}) {
		return 0, true, fail("amd64 EmitObject returned false")
	}
	var cPath @[]char = buf.Concat(dir, "/driver.c")
	f, cerr := os.Create(cPath)
	if present(cerr) { return 0, true, fail("cannot create the C driver") }
	_, werr := f.Write(csrc)
	_ = f.Close()
	if present(werr) { return 0, true, fail("cannot write the C driver") }
	var exePath @[]char = buf.Concat(dir, "/prog")
	var largs @[]@[]char = make_slice(@[]char, 5)
	largs[0] = "-w"
	largs[1] = "-o"
	largs[2] = buf.CopyStr(exePath)
	largs[3] = buf.CopyStr(cPath)
	largs[4] = buf.CopyStr(objPath)
	var cc *[]readonly char = "cc"
	if macho {
		var ml @[]@[]char = make_slice(@[]char, 7)
		ml[0] = "-arch"
		ml[1] = "x86_64"
		for i := 0; i < 5; i++ { ml[i + 2] = largs[i] }
		largs = ml
		cc = "clang"
	}
	if execExit(cc, largs) != 0 { return 0, true, fail("building the x86-64 program failed") }
	return execExit(exePath, make_slice(@[]char, 0)), true, ""
}

// A by-value aggregate argument is read exactly: none of its bytes is read past
// its end, which may be the end of mapped memory.  Checked end to end under
// Rosetta or on Linux x86-64: a C driver places a 12-byte {int32, int32, int32}
// (two GP eightbytes, the second partial) and a 12-byte {float32, float32,
// int32} (an SSE eightbyte and a partial INTEGER one) each so it ends at an
// inaccessible page, and natively compiled functions load each through its
// pointer -- a load small enough to read its source in place -- and pass it by
// value to a C callee: in registers, and the {int32 x3} also on the stack (MEMORY
// class) after seven int arguments -- at a nonzero offset, with every GP argument
// register filled; and natively compiled functions return each by value (`return
// *p`, read in place) in RAX / RDX and XMM0.  Each case runs in a
// child process, where a read past the end faults; the driver exits 42 when
// every case returns the right result, else 100 plus a bit per failed case.

// exactArgDriver is the C side: the guard page, the callees and the checks.
var exactArgDriver *[]readonly char = "#include <sys/mman.h>\n"
		"#include <sys/wait.h>\n"
		"#include <unistd.h>\n"
		"struct S12 { int a, b, c; };\n"
		"struct SM { float a, b; int i; };\n"
		"long take12(struct S12 s) { return s.a + s.b * 10 + s.c * 100; }\n"
		"long takeMix(struct SM s) { return (long)((s.a + s.b) * 10) + s.i; }\n"
		"long take12m(long a, long b, long c, long d, long e, long f, long g, struct S12 s) {\n"
		"  return a + b + c + d + e + f + g + s.a + s.b * 10 + s.c * 100;\n"
		"}\n"
		"long callit12(void *fp, struct S12 *p);\n"
		"long callitMix(void *fp, struct SM *p);\n"
		"long callit12m(void *fp, struct S12 *p);\n"
		"struct S12 get12(struct S12 *p);\n"
		"struct SM getMix(struct SM *p);\n"
		"long via12(void *unused, void *p) {\n"
		"  struct S12 r = get12(p);\n"
		"  return r.a + r.b * 10 + r.c * 100;\n"
		"}\n"
		"long viaMix(void *unused, void *p) {\n"
		"  struct SM r = getMix(p);\n"
		"  return (long)((r.a + r.b) * 10) + r.i;\n"
		"}\n"
		"static char *guarded(long sz) {\n"
		"  long pg = getpagesize();\n"
		"  char *m = mmap(0, 2 * pg, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);\n"
		"  if (m == MAP_FAILED || mprotect(m + pg, pg, PROT_NONE) != 0) return 0;\n"
		"  return m + pg - sz;\n"
		"}\n"
		"typedef long (*callit)(void *, void *);\n"
		"static int fails(callit f, void *fp, void *p, long want) {\n"
		"  pid_t pid = fork();\n"
		"  if (pid == 0) _exit(f(fp, p) == want ? 0 : 1);\n"
		"  int st = 0;\n"
		"  if (pid < 0 || waitpid(pid, &st, 0) != pid) return 1;\n"
		"  return !(WIFEXITED(st) && WEXITSTATUS(st) == 0);\n"
		"}\n"
		"int main(void) {\n"
		"  int bad = 0;\n"
		"  struct S12 *s12 = (struct S12 *)guarded(sizeof(struct S12));\n"
		"  struct SM *sm = (struct SM *)guarded(sizeof(struct SM));\n"
		"  if (!s12 || !sm) return 99;\n"
		"  s12->a = 1; s12->b = 2; s12->c = 3;\n"
		"  sm->a = 1.5f; sm->b = 2.5f; sm->i = 5;\n"
		"  if (fails((callit)callit12, (void *)take12, s12, 321)) bad |= 1;\n"
		"  if (fails((callit)callitMix, (void *)takeMix, sm, 45)) bad |= 2;\n"
		"  if (fails((callit)callit12m, (void *)take12m, s12, 349)) bad |= 4;\n"
		"  if (fails(via12, 0, s12, 321)) bad |= 8;\n"
		"  if (fails(viaMix, 0, sm, 45)) bad |= 16;\n"
		"  return bad == 0 ? 42 : 100 + bad;\n"
		"}\n"

// x64TestStruct returns a struct type `name` with the given field types (named:
// an anonymous struct is a multi-return tuple, which SysV classification skips).
func x64TestStruct(name *[]readonly char, fts @[]@types.Type) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, len(fts))
	for i := 0; i < len(fts); i++ {
		fields[i] = make(types.Field)
		var fname @[]char = make_slice(char, 2)
		fname[0] = 'f'
		fname[1] = cast(char, cast(int, '0') + i)
		fields[i].Name = fname
		fields[i].Type = fts[i]
	}
	return types.MakeStructType(buf.CopyStr(name), fields)
}

// exactRetFunc builds the exported `name`(p *t) t, which returns *p.
func exactRetFunc(name *[]readonly char, t @types.Type) @ir.Func {
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = t
	var f @ir.Func = ir.NewFunc("", buf.CopyStr(name), make_slice(@ir.Param, 0), results)
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = irbuild.NewParam(f, "p", types.MakePointerType(t))
	f.Params = params
	var ce @[]@[]char = make_slice(@[]char, 1)
	ce[0] = buf.CopyStr(name)
	f.CExportNames = ce
	var b @ir.Block = ir.AddBlock(f, "entry")
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = irbuild.EmitLoad(b, irbuild.NewParamRef(f, params[0]), t)
	irbuild.EmitReturn(b, rets)
	return f
}

// exactArgFunc builds the exported `name`(fp *uint8, p *t) int, which loads *p
// and passes it to fp, after the ints 1..nLead when nLead > 0.
func exactArgFunc(name *[]readonly char, t @types.Type, nLead int) @ir.Func {
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", buf.CopyStr(name), make_slice(@ir.Param, 0), results)
	var params @[]@ir.Param = make_slice(@ir.Param, 2)
	params[0] = irbuild.NewParam(f, "fp", types.MakePointerType(types.TypUint8()))
	params[1] = irbuild.NewParam(f, "p", types.MakePointerType(t))
	f.Params = params
	var ce @[]@[]char = make_slice(@[]char, 1)
	ce[0] = buf.CopyStr(name)
	f.CExportNames = ce
	var b @ir.Block = ir.AddBlock(f, "entry")
	var fp @ir.Instr = irbuild.NewParamRef(f, params[0])
	var p @ir.Instr = irbuild.NewParamRef(f, params[1])
	var args @[]@ir.Instr = make_slice(@ir.Instr, nLead + 1)
	for i := 0; i < nLead; i++ {
		args[i] = irbuild.EmitConstInt(b, i + 1, types.TypInt())
	}
	args[nLead] = irbuild.EmitLoad(b, p, t)
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = irbuild.EmitCallIndirect(b, fp, args, types.TypInt())
	irbuild.EmitReturn(b, rets)
	return f
}

func TestAggregateArgReadsNoBytePastItsEnd() testing.TestResult {
	// ARCH_X64 turns on SysV's SSE classification of aggregates (SysVSseInRegs).
	var saved types.TargetInfo = types.GetTarget()
	var tgt types.TargetInfo
	tgt.PointerSize = 8
	tgt.IntSize = 8
	tgt.MaxAlign = 8
	tgt.Arch = types.ARCH_X64
	types.SetTarget(tgt)
	defer types.SetTarget(saved)
	var i3 @[]@types.Type = make_slice(@types.Type, 3)
	for i := 0; i < 3; i++ { i3[i] = types.TypInt32() }
	var mix @[]@types.Type = make_slice(@types.Type, 3)
	mix[0] = types.TypFloat32()
	mix[1] = types.TypFloat32()
	mix[2] = types.TypInt32()
	var s12 @types.Type = x64TestStruct("S12", i3)
	var sm @types.Type = x64TestStruct("SM", mix)
	var m @ir.Module = ir.NewModule("\"main\"")
	m.AddFunc(exactArgFunc("callit12", s12, 0))
	m.AddFunc(exactArgFunc("callitMix", sm, 0))
	m.AddFunc(exactArgFunc("callit12m", s12, 7))
	m.AddFunc(exactRetFunc("get12", s12))
	m.AddFunc(exactRetFunc("getMix", sm))
	var rc int
	var ran bool
	var err testing.TestResult
	rc, ran, err = buildAndRunX64(m, exactArgDriver)
	if len(err) > 0 { return err }
	if !ran || rc == 42 { return "" }
	var msg @[]char = buf.CopyStr("by-value aggregates read past their end or arrived wrong:")
	if rc >= 101 && rc <= 131 {
		var bits int = rc - 100
		if bits % 2 == 1 { msg = buf.Concat(msg, " {int32 x3} in registers") }
		if bits / 2 % 2 == 1 { msg = buf.Concat(msg, " {float32, float32, int32}") }
		if bits / 4 % 2 == 1 { msg = buf.Concat(msg, " {int32 x3} on the stack") }
		if bits / 8 % 2 == 1 { msg = buf.Concat(msg, " a returned {int32 x3}") }
		if bits / 16 % 2 == 1 { msg = buf.Concat(msg, " a returned {float32, float32, int32}") }
	} else {
		msg = buf.Concat(msg, " (the program did not run to its checks)")
	}
	return fail(msg)
}
