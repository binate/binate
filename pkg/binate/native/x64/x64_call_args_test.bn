package "pkg/binate/native/x64"

import "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/build"
import "pkg/builtins/testing"
import "pkg/std/os"

// An indirect call places its arguments as a direct call does: a ninth float
// argument goes on the stack and an SSE-class struct rides XMM registers (the
// second of two struct parameters is forwarded, so XMM0 / XMM1 hold the wrong
// one unless the struct is placed there).
// Checked end to end on a host that runs x86-64 (buildAndRunX64): a C driver
// hands C callees to natively compiled callit_* functions, which call them
// through OP_CALL_INDIRECT; the driver exits 42 when every result is right, else
// 100 plus a bit per wrong one.

// indirectRunDriver is the C side: the callees and the checks.
var indirectRunDriver *[]readonly char = "struct P { double x, y; };\n"
		"double sum9(double a, double b, double c, double d, double e, double f, double g,\n"
		"    double h, double i) { return a + b + c + d + e + f + g + h + i; }\n"
		"long sumP(struct P p) { return (long)(p.x * 10 + p.y); }\n"
		"long callit_f(void *fp);\n"
		"long callit_p(void *fp, struct P decoy, struct P p);\n"
		"int main(void) {\n"
		"  int bad = 0;\n"
		"  struct P decoy = { 9.0, 9.0 };\n"
		"  struct P p = { 1.0, 2.0 };\n"
		"  if (callit_f((void *)sum9) != 45) bad |= 1;\n"
		"  if (callit_p((void *)sumP, decoy, p) != 12) bad |= 2;\n"
		"  return bad == 0 ? 42 : 100 + bad;\n"
		"}\n"

// indirectRunFunc returns an exported function `name`(fp *uint8, extra...)
// returning int, with its entry block; params[0] is fp.
func indirectRunFunc(name *[]readonly char,
		extra @[]@types.Type) (@ir.Func, @ir.Block, @[]@ir.Instr) {
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", buf.CopyStr(name), make_slice(@ir.Param, 0), results)
	var params @[]@ir.Param = make_slice(@ir.Param, 1 + len(extra))
	params[0] = irbuild.NewParam(f, "fp", types.MakePointerType(types.TypUint8()))
	for i := 0; i < len(extra); i++ {
		params[i + 1] = irbuild.NewParam(f, "x", extra[i])
	}
	f.Params = params
	var ce @[]@[]char = make_slice(@[]char, 1)
	ce[0] = buf.CopyStr(name)
	f.CExportNames = ce
	var b @ir.Block = ir.AddBlock(f, "entry")
	var refs @[]@ir.Instr = make_slice(@ir.Instr, len(params))
	for i := 0; i < len(params); i++ {
		refs[i] = irbuild.NewParamRef(f, params[i])
	}
	return f, b, refs
}

// indirectRunStruct returns a struct type `name` of n fields of type t (named:
// an anonymous struct is a multi-return tuple, which SysV classification skips).
func indirectRunStruct(name *[]readonly char, t @types.Type, n int) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		fields[i] = make(types.Field)
		var fname @[]char = make_slice(char, 2)
		fname[0] = 'f'
		fname[1] = cast(char, cast(int, '0') + i)
		fields[i].Name = fname
		fields[i].Type = t
	}
	return types.MakeStructType(buf.CopyStr(name), fields)
}

// indirectRunModule builds callit_f (nine float64 arguments, float64 result) and
// callit_p (forwarding the second of two {float64, float64} struct parameters).
func indirectRunModule() @ir.Module {
	var m @ir.Module = ir.NewModule("\"main\"")
	var none @[]@types.Type
	var fF @ir.Func
	var bF @ir.Block
	var rF @[]@ir.Instr
	fF, bF, rF = indirectRunFunc("callit_f", none)
	var fargs @[]@ir.Instr = make_slice(@ir.Instr, 9)
	var digits *[]readonly char = "123456789"
	for i := 0; i < 9; i++ {
		var text @[]char = make_slice(char, 3)
		text[0] = digits[i]
		text[1] = '.'
		text[2] = '0'
		fargs[i] = irbuild.EmitConstFloat(bF, text, types.TypFloat64())
	}
	var sum @ir.Instr = irbuild.EmitCallIndirect(bF, rF[0], fargs, types.TypFloat64())
	var one @[]@ir.Instr = make_slice(@ir.Instr, 1)
	one[0] = irbuild.EmitCast(bF, sum, types.TypInt())
	irbuild.EmitReturn(bF, one)
	m.AddFunc(fF)

	var pX @[]@types.Type = make_slice(@types.Type, 2)
	var p @types.Type = indirectRunStruct("P", types.TypFloat64(), 2)
	pX[0] = p
	pX[1] = p
	var fP @ir.Func
	var bP @ir.Block
	var rP @[]@ir.Instr
	fP, bP, rP = indirectRunFunc("callit_p", pX)
	var pargs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	pargs[0] = rP[2]
	var three @[]@ir.Instr = make_slice(@ir.Instr, 1)
	three[0] = irbuild.EmitCallIndirect(bP, rP[0], pargs, types.TypInt())
	irbuild.EmitReturn(bP, three)
	m.AddFunc(fP)
	return m
}

func TestCallIndirectPlacesArgsLikeACall() testing.TestResult {
	// ARCH_X64 turns on SysV's SSE classification of aggregates (SysVSseInRegs).
	var saved types.TargetInfo = types.GetTarget()
	var tgt types.TargetInfo
	tgt.PointerSize = 8
	tgt.IntSize = 8
	tgt.MaxAlign = 8
	tgt.Arch = types.ARCH_X64
	types.SetTarget(tgt)
	defer types.SetTarget(saved)
	var rc int
	var ran bool
	var err testing.TestResult
	rc, ran, err = buildAndRunX64(indirectRunModule(), indirectRunDriver)
	if len(err) > 0 { return err }
	if !ran || rc == 42 { return "" }
	var msg @[]char = buf.CopyStr("indirect calls returned wrong results:")
	if rc == 101 || rc == 103 { msg = buf.Concat(msg, " nine floats") }
	if rc == 102 || rc == 103 { msg = buf.Concat(msg, " SSE struct") }
	if rc < 101 || rc > 103 { msg = buf.Concat(msg, " (the program did not run to its checks)") }
	return fail(msg)
}

// buildAndRunX64 emits m as an x86-64 object, builds it into a program with the
// C source csrc and runs it, returning its exit status (-1 when it did not exit
// normally).  ran is false when this host cannot run an x86-64 program: one runs
// under Rosetta on an Apple Silicon Mac (or natively on an Intel one) as Mach-O,
// and natively on Linux x86-64 as ELF.  A non-empty error reports a build failure.
func buildAndRunX64(m @ir.Module, csrc *[]readonly char) (int, bool, testing.TestResult) {
	var macho bool = canRunX64Macho()
	if !macho && !(build.OS == build.OS_LINUX && build.Arch == build.ARCH_X64) {
		return 0, false, ""
	}
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return 0, true, fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var objPath @[]char = buf.Concat(dir, "/prog.o")
	var format *[]readonly char = "elf"
	if macho { format = "macho" }
	if !EmitObject(m, format, objPath) { return 0, true, fail("amd64 EmitObject returned false") }
	var cPath @[]char = buf.Concat(dir, "/driver.c")
	f, cerr := os.Create(cPath)
	if present(cerr) { return 0, true, fail("cannot create the C driver") }
	_, werr := f.Write(csrc)
	_ = f.Close()
	if present(werr) { return 0, true, fail("cannot write the C driver") }
	var exePath @[]char = buf.Concat(dir, "/prog")
	var largs @[]@[]char = make_slice(@[]char, 5)
	largs[0] = "-w"
	largs[1] = "-o"
	largs[2] = buf.CopyStr(exePath)
	largs[3] = buf.CopyStr(cPath)
	largs[4] = buf.CopyStr(objPath)
	var cc *[]readonly char = "cc"
	if macho {
		var ml @[]@[]char = make_slice(@[]char, 7)
		ml[0] = "-arch"
		ml[1] = "x86_64"
		for i := 0; i < 5; i++ { ml[i + 2] = largs[i] }
		largs = ml
		cc = "clang"
	}
	if execExit(cc, largs) != 0 { return 0, true, fail("building the x86-64 program failed") }
	return execExit(exePath, make_slice(@[]char, 0)), true, ""
}
