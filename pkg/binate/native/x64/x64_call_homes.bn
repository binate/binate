package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// Call-argument placement for operands homed in an argument register.
//
// RSI and RDI are outside the scratch pool, so the register allocator may home
// values in them, and both are SysV argument registers.  A call argument whose
// operand is homed there cannot be placed by the per-argument loop
// the call lowerings use — `mov argReg, src` one argument at a time — because
// two such operands can cross (x in RSI going to RDI while y in RDI goes to
// RSI), and because an earlier argument's move can overwrite a home a later
// argument still has to read.  So every call site first places those
// arguments together as one parallel move, the loop then skips them, and the
// loop keeps the argument registers already filled out of its operand
// reloads.

// isArgRegHomeX64 reports whether reg is a register that can hold a
// register-allocated value AND is an argument register.
func isArgRegHomeX64(reg int) bool {
	return reg == x64.RSI || reg == x64.RDI
}

// argHomedInArgRegX64 reports whether call argument arg is a GP scalar whose
// operand is homed in an argument register — the arguments
// prePlaceArgRegHomedArgsX64 places and the per-argument loops skip.
func argHomedInArgRegX64(rm @common.RegMap, arg @ir.Instr) bool {
	if arg == nil || arg.IsGlobalRef { return false }
	if common.IsFloatScalarTyp(arg.Typ) || common.IsAggregateTyp(arg.Typ) { return false }
	return isArgRegHomeX64(rm.LookupHome(arg.ID))
}

// prePlaceArgRegHomedArgsX64 places every argument args[i] for which
// argHomedInArgRegX64 holds: into argument register dstReg[i] when that is >= 0,
// else as an 8-byte store to [rsp + dstStack[i]].  Stack stores go first (they
// read a home and write memory, so they cannot disturb another home); the
// register moves then run as one parallel move, with RAX breaking any cycle
// (RAX is neither a home nor an argument register, and no call lowering has
// anything in it before its arguments are placed).  Returns the argument
// registers it filled, for reserveFilledArgRegsX64.
func prePlaceArgRegHomedArgsX64(a @asm.Assembler, rm @common.RegMap, args @[]@ir.Instr,
		dstReg @[]int, dstStack @[]int) @[]int {
	var srcs @[]int
	var dsts @[]int
	for i := 0; i < len(args); i++ {
		if !argHomedInArgRegX64(rm, args[i]) { continue }
		var home int = rm.LookupHome(args[i].ID)
		if dstReg[i] >= 0 {
			srcs = common.AppendInt(srcs, home)
			dsts = common.AppendInt(dsts, dstReg[i])
		} else if dstStack[i] >= 0 {
			x64.Mov(a, x64.Mem(x64.RSP, dstStack[i], x64.SZ64), x64.Reg(home, x64.SZ64))
		}
	}
	if len(dsts) == 0 { return dsts }
	var plan @[]int = common.PlanParallelMove(srcs, dsts, x64.RAX)
	for k := 0; k < len(plan); k = k + 2 {
		x64.Mov(a, x64.Reg(plan[k], x64.SZ64), x64.Reg(plan[k + 1], x64.SZ64))
	}
	return dsts
}

// reserveFilledArgRegsX64 marks the argument registers already holding a
// placed argument as claimed by the current instruction, so the argument
// loop's operand reloads and scratch — which draw from a pool that includes
// RCX, RDX, R8 and R9 — cannot overwrite them.  Called after every
// rm.ResetRegs() in a call's argument loop.
func reserveFilledArgRegsX64(rm @common.RegMap, filled @[]int) {
	for i := 0; i < len(filled); i++ {
		rm.MarkUsed(filled[i])
	}
}

// appendArgRegsX64 appends to filled the nWords argument registers an argument
// starting at argument-register index regStart occupies (nothing when it went
// to the stack, regStart < 0), capped at the SysV GP argument-register count.
func appendArgRegsX64(filled @[]int, regStart int, nWords int) @[]int {
	if regStart < 0 { return filled }
	var out @[]int = filled
	for w := 0; w < nWords && regStart + w < 6; w++ {
		out = common.AppendInt(out, argReg(regStart + w))
	}
	return out
}

// emitParallelReg2X64 places two operand registers into two argument
// registers as a parallel copy — {d0 <- s0, d1 <- s1} — so neither move
// clobbers the other's source when they cross (s0 in d1 and s1 in d0).  For the
// runtime-call setups (bounds / div check fail calls, RefDec's destroy call)
// whose operands may be homed in RSI or RDI, the argument registers they
// marshal into.  RAX breaks a cycle; identity moves are dropped.
func emitParallelReg2X64(a @asm.Assembler, s0 int, d0 int, s1 int, d1 int) {
	var s @[]int = make_slice(int, 2)
	var d @[]int = make_slice(int, 2)
	s[0] = s0
	d[0] = d0
	s[1] = s1
	d[1] = d1
	var plan @[]int = common.PlanParallelMove(s, d, x64.RAX)
	for k := 0; k < len(plan); k = k + 2 {
		x64.Mov(a, x64.Reg(plan[k], x64.SZ64), x64.Reg(plan[k + 1], x64.SZ64))
	}
}
