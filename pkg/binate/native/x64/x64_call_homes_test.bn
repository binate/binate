package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for x64_call_homes.bn: placing call arguments whose operands are homed
// in an argument register.

// homedArgX64 makes a call argument (id id, type t) and, when home >= 0,
// homes it in register home in rm.
func homedArgX64(rm @common.RegMap, id int, t @types.Type, home int) @ir.Instr {
	var v @ir.Instr = make(ir.Instr)
	v.ID = id
	v.Op = iropcode.OP_PARAM
	v.Typ = t
	if home >= 0 {
		rm.HomeIDs = common.AppendInt(rm.HomeIDs, id)
		rm.HomeRegs = common.AppendInt(rm.HomeRegs, home)
	}
	return v
}

// Two arguments whose homes cross — x in RSI bound for RDI, y in RDI bound for
// RSI — are placed as a swap through RAX, never as two plain moves that would
// lose one of them.
func TestPrePlaceArgRegHomedArgsSwapsThroughRax() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 2)
	args[0] = homedArgX64(rm, 1, types.TypInt(), x64.RSI)
	args[1] = homedArgX64(rm, 2, types.TypInt(), x64.RDI)
	var dstReg @[]int = make_slice(int, 2)
	dstReg[0] = x64.RDI
	dstReg[1] = x64.RSI
	var dstStack @[]int = make_slice(int, 2)
	dstStack[0] = -1
	dstStack[1] = -1
	var filled @[]int = prePlaceArgRegHomedArgsX64(a, rm, args, dstReg, dstStack)
	if len(filled) != 2 { return "both arguments should be reported as placed" }
	// mov rax, rdi ; mov rdi, rsi ; mov rsi, rax
	return x64FoldGolden(a, "48 89 f8 48 89 f7 48 89 c6", "crossing RSI/RDI homes")
}

// A homed argument bound for the stack is stored straight from its home, and
// is not reported as a filled register.
func TestPrePlaceArgRegHomedArgsStackStore() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = homedArgX64(rm, 1, types.TypInt(), x64.RDI)
	var dstReg @[]int = make_slice(int, 1)
	dstReg[0] = -1
	var dstStack @[]int = make_slice(int, 1)
	dstStack[0] = 8
	var filled @[]int = prePlaceArgRegHomedArgsX64(a, rm, args, dstReg, dstStack)
	if len(filled) != 0 { return "a stack-bound argument fills no register" }
	// mov qword ptr [rsp+8], rdi
	return x64FoldGolden(a, "48 89 7c 24 08", "stack-bound RDI home")
}

// Only a GP scalar homed in RSI or RDI is pre-placed: a callee-saved home, an
// unhomed value, a float and an aggregate all stay with the per-argument loop.
func TestArgHomedInArgRegX64Classifies() testing.TestResult {
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	if !argHomedInArgRegX64(rm, homedArgX64(rm, 1, types.TypInt(), x64.RSI)) {
		return "an int homed in RSI is placed up front"
	}
	if !argHomedInArgRegX64(rm, homedArgX64(rm, 6, types.TypInt(), x64.R8)) {
		return "an int homed in R8 is placed up front"
	}
	if !argHomedInArgRegX64(rm, homedArgX64(rm, 7, types.TypInt(), x64.R9)) {
		return "an int homed in R9 is placed up front"
	}
	if argHomedInArgRegX64(rm, homedArgX64(rm, 2, types.TypInt(), x64.RBX)) {
		return "a callee-saved home is not an argument register"
	}
	if argHomedInArgRegX64(rm, homedArgX64(rm, 3, types.TypInt(), -1)) {
		return "an unhomed value is not placed up front"
	}
	if argHomedInArgRegX64(rm, homedArgX64(rm, 4, types.TypFloat64(), x64.RDI)) {
		return "a float argument is not placed up front"
	}
	if argHomedInArgRegX64(rm, homedArgX64(rm, 5, types.MakeSliceType(types.TypInt()), x64.RDI)) {
		return "an aggregate argument is not placed up front"
	}
	return ""
}

// Reserving the filled argument registers keeps them out of scratch: with RCX
// reserved, the pool hands out R10, R11, then RDX.
func TestReserveFilledArgRegsKeepsThemOutOfScratch() testing.TestResult {
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var filled @[]int
	filled = common.AppendInt(filled, x64.RCX)
	reserveFilledArgRegsX64(rm, filled)
	if scratchReg(rm) != x64.R10 || scratchReg(rm) != x64.R11 { return "R10 and R11 come first" }
	if scratchReg(rm) != x64.RDX { return "RCX is reserved, so RDX is next" }
	return ""
}

// emitParallelReg2X64 swaps crossing operands through RAX (idx in RSI bound for
// RDI, len in RDI bound for RSI) and drops identity moves.
func TestEmitParallelReg2X64CrossAndIdentity() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitParallelReg2X64(a, x64.RSI, x64.RDI, x64.RDI, x64.RSI)
	// mov rax, rdi ; mov rdi, rsi ; mov rsi, rax
	var r testing.TestResult = x64FoldGolden(a, "48 89 f8 48 89 f7 48 89 c6", "crossing pair")
	if len(r) != 0 { return r }
	var b @asm.Assembler = emitMkAsm()
	emitParallelReg2X64(b, x64.RDI, x64.RDI, x64.R10, x64.RSI)
	// mov rsi, r10 (the RDI -> RDI identity is dropped)
	return x64FoldGolden(b, "4c 89 d6", "identity plus one move")
}

// A direct call f(x, y, z) with x homed in RSI and y homed in RDI — crossing
// their destinations RDI and RSI — and z spilled: the two homed args are placed
// first as a swap through RAX, the loop skips them (no second move), and z is
// reloaded into R10 and moved to RDX before the CALL.
func TestEmitCallPrePlacesCrossingHomedArgs() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 3)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "pkg/std/os.Exit"
	ins.Args = make_slice(@ir.Instr, 3)
	ins.Args[0] = homedArgX64(rm, 1, types.TypInt(), x64.RSI)
	ins.Args[1] = homedArgX64(rm, 2, types.TypInt(), x64.RDI)
	ins.Args[2] = homedArgX64(rm, 3, types.TypInt(), -1)
	emitCall(a, "main", rm, ins)
	var n int = a.Sections[0].Len
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	if n < 5 || data[n - 5] != cast(uint8, 0xE8) { return "the CALL should come last" }
	// mov rax, rdi ; mov rdi, rsi ; mov rsi, rax ; mov r10, [rsp] ; mov rdx, r10
	var want *[]readonly char = "48 89 f8 48 89 f7 48 89 c6 4c 8b 14 24 4c 89 d2"
	var got @[]char = x64FoldTextHex(a)
	if len(got) < len(want) || !x64FoldSameText(got[:len(want)], want) {
		return buf.Concat("args placed wrongly before the CALL: emitted ", got)
	}
	return ""
}

// hexHas reports whether hex text got contains sub.
func hexHas(got *[]readonly char, sub *[]readonly char) bool {
	for i := 0; i + len(sub) <= len(got); i++ {
		if x64FoldSameText(got[i:i + len(sub)], sub) { return true }
	}
	return false
}

// A handle call (OP_CALL_HANDLE's `*uint8` handle, a scalar that can be homed)
// whose handle is homed in RSI, with one user arg placed into RSI: the handle
// is saved to its slot before the args are placed, and the closure data word is
// read through a reload of that slot — never through RSI, which by then holds
// the user arg.
func TestEmitCallFuncValueHandleHomedInRsi() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 5
	ins.Op = iropcode.OP_CALL_HANDLE
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = homedArgX64(rm, 1, types.MakePointerType(types.TypUint8()), x64.RSI)
	ins.Args[1] = homedArgX64(rm, 2, types.TypInt(), -1)
	emitCallFuncValue(a, "main", rm, ins)
	if a.HasError { return "unexpected assembler error" }
	var got @[]char = x64FoldTextHex(a)
	// mov [rsp], rsi — the handle saved before the args are placed
	if !hexHas(got, "48 89 34 24") { return buf.Concat("handle not saved to its slot: ", got) }
	// mov rdi, [rsi+8] — reading the data word through the clobbered RSI
	if hexHas(got, "48 8b 7e 08") { return buf.Concat("data word read through RSI: ", got) }
	return ""
}

// Homes in R8 / R9 are placed like RSI / RDI ones: x in R8 bound for RDI and y
// in RDI bound for R8 cross and are swapped through RAX; z in R9 bound for the
// stack is stored straight from R9.
func TestPrePlaceArgRegHomedArgsR8R9() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 3)
	args[0] = homedArgX64(rm, 1, types.TypInt(), x64.R8)
	args[1] = homedArgX64(rm, 2, types.TypInt(), x64.RDI)
	args[2] = homedArgX64(rm, 3, types.TypInt(), x64.R9)
	var dstReg @[]int = make_slice(int, 3)
	dstReg[0] = x64.RDI
	dstReg[1] = x64.R8
	dstReg[2] = -1
	var dstStack @[]int = make_slice(int, 3)
	dstStack[0] = -1
	dstStack[1] = -1
	dstStack[2] = 8
	var filled @[]int = prePlaceArgRegHomedArgsX64(a, rm, args, dstReg, dstStack)
	if len(filled) != 2 { return "the two register-bound args should be reported as placed" }
	// mov [rsp+8], r9 ; then the RDI <-> R8 swap through RAX
	var got @[]char = x64FoldTextHex(a)
	if !hexHas(got, "4c 89 4c 24 08") { return buf.Concat("R9 not stored to the stack: ", got) }
	var swapA *[]readonly char = "48 89 f8 4c 89 c7 49 89 c0"
	var swapB *[]readonly char = "4c 89 c0 49 89 f8 48 89 c7"
	if !hexHas(got, swapA) && !hexHas(got, swapB) {
		return buf.Concat("RDI and R8 not swapped through RAX: ", got)
	}
	return ""
}
