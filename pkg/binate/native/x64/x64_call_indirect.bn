package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Indirect-call lowering: emitCallIndirect (OP_CALL_INDIRECT, dtor /
// free_fn / cross-mode dispatch, called via CALL r11) and
// emitCallFuncValue (OP_CALL_FUNC_VALUE / OP_CALL_HANDLE — call
// through a 2-word {vtable_ptr, data_ptr} value's vtable.call slot,
// always-shim convention).  Both share the SysV arg-passing machinery
// emitCall in x64_call.bn uses; only the callee-target load and the
// final CALL r11 vs CALL <symbol> differ.
//
// Mirrors aarch64_call_indirect.bn line for line — only the
// instructions and the arg-register file (RDI/RSI/.../R9 vs X0..X7)
// change.

// emitCallIndirect emits an indirect call (CALL r11).  Args[0] is the
// fn_ptr (stashed in R11 before arg dispatch may clobber its source);
// Args[1..] are the call args, dispatched via the same SysV machinery
// emitCall uses.  R11 is caller-saved and not in regPool — safe across
// MOV + arg-loads since CALL is the only thing that clobbers it, and
// we haven't CALL'd yet.  Same return-value handling as emitCall.
func emitCallIndirect(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		allFuncs @[]@ir.Func, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }

	// Stash fn_ptr in R11 before the arg-dispatch loop.  The arg loop
	// writes RDI..R9 (and may use RAX as a load temp for MEMORY
	// aggregates); loading the source register here ensures the value
	// survives even if the source reg gets reused below.
	var fnSrc int = getOperand(a, rm, ins.Args[0].ID)
	if fnSrc < 0 { return }
	x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Reg(fnSrc, x64.SZ64))
	// Spill R11 to a slot so the arg loop's ResetRegs / getOperand
	// reloads can't clobber it.
	var fnPtrSlot int = -1
	if ins.ID >= 0 {
		fnPtrSlot = rm.LookupSpill(ins.ID)
		if fnPtrSlot < 0 {
			fnPtrSlot = rm.LookupAlloc(ins.ID)
		}
	}
	if fnPtrSlot >= 0 {
		x64.Mov(a, x64.Mem(x64.RSP, fnPtrSlot, x64.SZ64), x64.Reg(x64.R11, x64.SZ64))
	}

	// SysV arg dispatch on the call args (Args[1..]).
	var nCallArgs int = len(ins.Args) - 1
	var argTypes @[]@types.Type = make_slice(@types.Type, nCallArgs)
	for i := 0; i < nCallArgs; i++ {
		argTypes[i] = ins.Args[i + 1].Typ
	}
	var nsrn int = 0
	for ai := 0; ai < nCallArgs; ai++ {
		var arg @ir.Instr = ins.Args[ai + 1]
		if common.IsFloatScalarTyp(arg.Typ) {
			var fsrc int = getOperand(a, rm, arg.ID)
			if fsrc >= 0 && nsrn < 8 {
				x64.Movq_gp_to_xmm(a, x64.XMM0 + nsrn, fsrc)
				nsrn = nsrn + 1
			}
			rm.ResetRegs()
			continue
		}
		var regStart int = rm.CC.CallArgRegStart(argTypes, ai)
		var stackOff int = rm.CC.CallArgStackOff(argTypes, ai)
		if common.IsAggregateTyp(arg.Typ) {
			emitAggregateArg(a, rm, arg, regStart, stackOff)
			rm.ResetRegs()
			continue
		}
		var src int = emitValOperand(a, pkgName, rm, arg)
		if src < 0 { continue }
		if regStart >= 0 {
			var dst int = argReg(regStart)
			if src != dst {
				x64.Mov(a, x64.Reg(dst, x64.SZ64), x64.Reg(src, x64.SZ64))
			}
		} else {
			x64.Mov(a, x64.Mem(x64.RSP, stackOff, x64.SZ64), x64.Reg(src, x64.SZ64))
		}
		rm.ResetRegs()
	}

	// SysV sret: indirect calls have no callee-symbol, so
	// CalleeUsesCSret never fires — only the (a)/(c) cases from
	// emitCall (big aggregate / big multi-return) apply.
	var bigMultiRet bool = ins.ID >= 0 && rm.CC.CallReturnsBigMultiReturn(ins)
	var bigRet bool = ins.ID >= 0 && (rm.CC.CallReturnsBigAggregate(ins) || bigMultiRet)
	if bigRet {
		var sretOff int = -1
		if bigMultiRet {
			sretOff = rm.LookupSpill(ins.ID)
		} else {
			sretOff = rm.LookupAlloc(ins.ID)
		}
		if sretOff >= 0 {
			x64.Lea(a, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSP, sretOff, x64.SZ64))
		}
	}

	// Reload R11 from the stash slot, then CALL r11.
	if fnPtrSlot >= 0 {
		x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Mem(x64.RSP, fnPtrSlot, x64.SZ64))
	}
	x64.CallReg(a, x64.R11)

	rm.ResetRegs()
	if ins.ID < 0 { return }

	// Aggregate single-return: pack RAX (+RDX) into the alloc region,
	// then produce its pointer (mirror of emitCall).
	if ins.Typ != nil && common.IsAggregateTyp(ins.Typ) && !common.IsMultiReturnCall(ins) {
		var dataOff int = rm.LookupAlloc(ins.ID)
		if dataOff < 0 { return }
		var sz int = ins.Typ.SizeOf()
		if sz <= 0 { return }
		if !bigRet {
			x64.Mov(a, x64.Mem(x64.RSP, dataOff, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
			if sz > 8 {
				x64.Mov(a, x64.Mem(x64.RSP, dataOff + 8, x64.SZ64), x64.Reg(x64.RDX, x64.SZ64))
			}
		}
		var rd int = nextReg(rm, ins.ID)
		x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.Mem(x64.RSP, dataOff, x64.SZ64))
		return
	}

	if ins.Typ != nil && ins.Typ.Kind == types.TYP_VOID { return }
	// Multi-return tuple collect — shares collectMultiReturnTuple with the other
	// call paths.  Currently UNREACHABLE for OP_CALL_INDIRECT: common.IsMultiReturnCall
	// gates on OP_CALL / OP_CALL_FUNC_VALUE / OP_CALL_IFACE_METHOD, never a bare
	// OP_CALL_INDIRECT (which is used for dtors / free_fn / cross-mode trampolines,
	// never a multi-return today).  Kept
	// on the shared helper so it stays correct if that ever changes.
	if common.IsMultiReturnCall(ins) {
		if bigMultiRet { return }
		collectMultiReturnTuple(a, rm, ins)
		return
	}
	// Scalar single-return: RAX → rd → spill.  Float scalars arrive
	// in XMM0 — bring the bits through MOVQ instead.
	var rd int = nextReg(rm, ins.ID)
	if common.IsFloatScalarTyp(ins.Typ) {
		x64.Movq_xmm_to_gp(a, rd, x64.XMM0)
	} else if rd != x64.RAX {
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
	}
}

// emitCallFuncValue lowers OP_CALL_FUNC_VALUE / OP_CALL_HANDLE: call
// through a 2-word function value's vtable.call.  Always-shim
// convention (Phase 3 of plan-function-values.md).  Two calling
// conventions for the shim, distinguished by return type:
//
//   Scalar / void return: shim signature
//     `<ret>(*uint8 data, <args>)`.  Caller loads data from the
//     function value's data slot (offset 8), passes it in RDI, then
//     puts user args in RSI+.  One synthetic prepended *uint8 slot
//     shifts SysV register-start by one.
//
//   Aggregate return: shim signature
//     `void(*uint8 retbuf, *uint8 data, <args>)` — retbuf-style.
//     Caller allocates retbuf (PlanFrame's alloc region for the
//     instruction), passes retbuf in RDI, data in RSI, user args
//     in RDX+ (TWO synthetic prepended slots).  After the call the
//     retbuf alloc region holds the return value — no RAX/RDX
//     spill required.
//
// Mirrors aarch64_call_indirect.bn:emitCallFuncValue.
func emitCallFuncValue(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		allFuncs @[]@ir.Func, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }

	// Two-step load through R11 to populate it with vtable.call:
	//   MOV R11, [fvAddr + 0]   ; R11 = vtable_ptr
	//   MOV R11, [R11 + 8]      ; R11 = vtable.call (slot 1 = call;
	//                           ;  slot 0 = dtor — we want call)
	var fvAddr int = getOperand(a, rm, ins.Args[0].ID)
	if fvAddr < 0 { return }
	x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Mem(fvAddr, types.FuncValueVtableOffset(), x64.SZ64))
	x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Mem(x64.R11, 8, x64.SZ64))
	// Stash R11 in the call-result spill / alloc slot so the arg
	// loop's getOperand / ResetRegs can't clobber it.
	var fnPtrSlot int = -1
	if ins.ID >= 0 {
		fnPtrSlot = rm.LookupSpill(ins.ID)
		if fnPtrSlot < 0 {
			fnPtrSlot = rm.LookupAlloc(ins.ID)
		}
	}
	if fnPtrSlot >= 0 {
		x64.Mov(a, x64.Mem(x64.RSP, fnPtrSlot, x64.SZ64), x64.Reg(x64.R11, x64.SZ64))
	}

	// Aggregate-return shim shape: prepend two synthetic *uint8 slots
	// (retbuf + data) before user args.  Scalar shape: one (data).
	// `prefixSlots` is also the SysV reg offset for user args.  Under retbuf-
	// for-any-multi-return the shim writes EVERY multi-return through the
	// retbuf (matching the LLVM shim + caller + VM cross-mode dispatch), so a
	// single aggregate AND any multi-return (big OR small) ride the retbuf-in-
	// RDI convention: retbuf in RDI, data in RSI, user args RDX+.  (Pre-fix a
	// small multi-return stayed on the scalar shape and collected field-per-
	// register from the return regs the LLVM/VM shim never wrote — the latent
	// cross-module miscompile 972/973.)
	var aggregateRet bool = ins.ID >= 0 && ins.Typ != nil && common.IsAggregateTyp(ins.Typ) &&
			!common.IsMultiReturnCall(ins)
	var multiRet bool = ins.ID >= 0 && common.IsMultiReturnCall(ins)
	var useRetbuf bool = aggregateRet || multiRet
	var prefixSlots int = 1
	if useRetbuf { prefixSlots = 2 }

	var nCallArgs int = len(ins.Args) - 1

	// Place user args first (so any user arg whose source happens to be RDI/RSI
	// is read before we overwrite those for retbuf/data).
	//
	// The func-value dispatch ABI is ALL-INT WORD-POSITIONAL: dispatch word g
	// (g < prefixSlots is a leading data — or retbuf+data — slot) rides argReg(g)
	// when g < NumGpArgRegs, else the outgoing-args stack at [rsp+(g-NumGpArgRegs)
	// *8], and each arg's EffectiveArgWords words occupy CONSECUTIVE positions.
	// A float rides one GP word here (the shim movq/movd's it into xmm), so there
	// is no separate FP path.  A first-class <=16 B aggregate (raw slice / iface-
	// / func-value) that straddles the reg/stack boundary is therefore SPLIT (its
	// first word in the last GP reg, the rest on the stack) — NOT pushed wholly to
	// memory the way the real SysV ABI (emitAggregateArg / CallArgStackOff) does.
	// The shim (emitFuncvalSpillShim_x64 / emitShimArgMarshal_x64) reads its
	// incoming words on exactly this positional model, so the two MUST agree:
	// placing a straddling slice all-or-nothing here would strand its first word
	// in a GP reg the shim never reads while the shim consumes that stale reg as a
	// live word — a native<->native miscompile (SIGSEGV once the garbage word is
	// dereferenced as a slice pointer).  (On aa64 the walk already splits, so its
	// dispatch matches its shim without this; this is SysV-AMD64-specific.)
	var numGp int = rm.CC.NumGpArgRegs
	var gWord int = prefixSlots
	for ai := 0; ai < nCallArgs; ai++ {
		var arg @ir.Instr = ins.Args[ai + 1]
		var w int = rm.CC.EffectiveArgWords(arg.Typ)
		if common.IsAggregateTyp(arg.Typ) {
			if w == 1 {
				// By-address (a coerced in-register <=16 B struct/array OR an
				// indirect-large >16 B / managed-slice aggregate): one pointer word.
				var ptr int = getOperand(a, rm, arg.ID)
				if ptr >= 0 {
					placeDispatchWordReg_x64(a, gWord, ptr, numGp)
				}
			} else {
				// First-class <=16 B aggregate (raw slice / iface- / func-value):
				// its w value-words, placed split-aware across regs and stack.
				emitFuncValFirstClassAgg_x64(a, rm, arg, gWord, w, numGp)
			}
			rm.ResetRegs()
			gWord = gWord + w
			continue
		}
		var src int = emitValOperand(a, pkgName, rm, arg)
		if src >= 0 {
			placeDispatchWordReg_x64(a, gWord, src, numGp)
		}
		rm.ResetRegs()
		gWord = gWord + w
	}

	// Reload fvAddr — the arg loop's ResetRegs may have stranded it.
	if nCallArgs > 0 {
		fvAddr = getOperand(a, rm, ins.Args[0].ID)
		if fvAddr < 0 { return }
	}
	if useRetbuf {
		// RDI = retbuf (the buffer the shim writes the result through): a single
		// aggregate uses its pre-allocated alloc region; a multi-return (big OR
		// small) uses the spill slot the tuple result lands in.  RSI = data.
		var retbufOff int = -1
		if aggregateRet {
			retbufOff = rm.LookupAlloc(ins.ID)
		} else {
			retbufOff = rm.LookupSpill(ins.ID)
		}
		if retbufOff < 0 { return }
		x64.Lea(a, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSP, retbufOff, x64.SZ64))
		x64.Mov(a, x64.Reg(x64.RSI, x64.SZ64), x64.Mem(fvAddr, types.FuncValueDataOffset(), x64.SZ64))
	} else {
		// Scalar / void shape: the data pointer is dispatch word 0 -> RDI.
		x64.Mov(a, x64.Reg(argReg(0), x64.SZ64), x64.Mem(fvAddr, types.FuncValueDataOffset(), x64.SZ64))
	}

	// Reload R11 and call.  Two paths:
	//   - ins.ID >= 0: vtable.call was stashed in the result slot
	//     before args were loaded; reload from there.
	//   - ins.ID < 0 (void return — no result slot to stash into):
	//     redo the two-step vtable.call load from the freshly
	//     reloaded fvAddr.  Without this, R11 holds whatever
	//     getOperand's scratch-reg use clobbered it with during the
	//     arg-loading loop, and CallReg(R11) jumps to garbage.
	if fnPtrSlot >= 0 {
		x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Mem(x64.RSP, fnPtrSlot, x64.SZ64))
	} else {
		x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Mem(fvAddr, types.FuncValueVtableOffset(), x64.SZ64))
		x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Mem(x64.R11, 8, x64.SZ64))
	}
	x64.CallReg(a, x64.R11)
	rm.ResetRegs()
	if ins.ID < 0 { return }

	// Aggregate single-return: shim wrote through retbuf we passed
	// in RDI.  Just produce the alloc-region pointer.
	if aggregateRet {
		var dataOff int = rm.LookupAlloc(ins.ID)
		if dataOff < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.Mem(x64.RSP, dataOff, x64.SZ64))
		return
	}

	if multiRet {
		// The shim wrote the whole tuple THROUGH retbuf (the spill slot) — big
		// via sret, small via a store-through-retbuf.  Nothing to collect from
		// return registers (the previous field-per-register collect read regs the
		// LLVM/VM shim never wrote); the spill slot already holds the result.
		return
	}
	// Scalar single-return.  All-int shim ABI: the result — float
	// scalars included — comes back in RAX (the shim already movq/movd'd
	// a float xmm0 -> rax), unlike a native call where a float result is
	// in xmm0.  Store RAX; do not special-case floats here.
	if ins.Typ != nil && ins.Typ.Kind == types.TYP_VOID { return }
	var rd int = nextReg(rm, ins.ID)
	if rd != x64.RAX {
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
	}
}

// placeDispatchWordReg_x64 places the value already in srcReg at func-value
// dispatch word g: argReg(g) when g < numGp, else the outgoing-args stack slot
// [rsp + (g-numGp)*8].  A no-op MOV (src already in the destination reg) is
// elided.  Used by emitCallFuncValue for a one-word arg (scalar / float bits /
// by-address aggregate pointer).
func placeDispatchWordReg_x64(a @asm.Assembler, g int, srcReg int, numGp int) {
	if g < numGp {
		var dst int = argReg(g)
		if srcReg != dst {
			x64.Mov(a, x64.Reg(dst, x64.SZ64), x64.Reg(srcReg, x64.SZ64))
		}
		return
	}
	x64.Mov(a, x64.Mem(x64.RSP, (g - numGp) * 8, x64.SZ64), x64.Reg(srcReg, x64.SZ64))
}

// emitFuncValFirstClassAgg_x64 places a first-class <=16 B aggregate (raw slice /
// iface- / func-value) arg's nWords value-words at CONSECUTIVE func-value dispatch
// positions g0, g0+1, ... — each word loaded from the aggregate image [ptr + 8k]
// into argReg(g0+k) (reg positions) or shuttled through RAX to the outgoing-args
// stack (positions >= numGp).  A straddling aggregate is thus SPLIT across the
// last GP reg and the stack, matching the shim's positional incoming model (see
// emitCallFuncValue's ABI note) — unlike the real-ABI emitAggregateArg, which is
// all-or-nothing.  The image pointer is copied to R10 (caller-saved, never a SysV
// arg reg nor the RAX shuttle) first, so a reg-destination write can't clobber it
// before the last word is read.
func emitFuncValFirstClassAgg_x64(a @asm.Assembler, rm @common.RegMap, arg @ir.Instr, g0 int,
		nWords int, numGp int) {
	var ptr int = getOperand(a, rm, arg.ID)
	if ptr < 0 { return }
	if ptr != x64.R10 {
		x64.Mov(a, x64.Reg(x64.R10, x64.SZ64), x64.Reg(ptr, x64.SZ64))
	}
	for k := 0; k < nWords; k++ {
		var g int = g0 + k
		if g < numGp {
			x64.Mov(a, x64.Reg(argReg(g), x64.SZ64), x64.Mem(x64.R10, 8 * k, x64.SZ64))
		} else {
			x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.R10, 8 * k, x64.SZ64))
			x64.Mov(a, x64.Mem(x64.RSP, (g - numGp) * 8, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
		}
	}
}
