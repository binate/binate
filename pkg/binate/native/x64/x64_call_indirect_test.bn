package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// callIndMkAsm: minimal assembler for indirect-call tests.
func callIndMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// emitCallIndirect lowers OP_CALL_INDIRECT by loading the function
// pointer into R11 and emitting CALL r11.  Pin: the byte stream
// contains an indirect-call opcode (0xFF /2) — REX.B prefix +
// 0xFF + ModRM with reg-field = 2.
func TestEmitCallIndirectEmitsCallReg() testing.TestResult {
	var a @asm.Assembler = callIndMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var fnPtr @ir.Instr = make(ir.Instr)
	fnPtr.ID = 1
	fnPtr.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL_INDIRECT
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = fnPtr
	emitCallIndirect(a, "main", rm, nilFuncs(), ins)
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundIndirect bool = false
	for i := 0; i < n - 1; i++ {
		if data[i] == cast(uint8, 0xFF) &&
				(data[i+1] & cast(uint8, 0x38)) == cast(uint8, 0x10) {
			foundIndirect = true
		}
	}
	if !foundIndirect {
		return "OP_CALL_INDIRECT should emit CALL r11 (0xFF /2)"
	}
	return ""
}

// emitCallFuncValue does the same two-step load through R11 as
// OP_CALL_IFACE_METHOD, but uses slot 1 of the vtable (slot 0 is
// the dtor; the call slot is at +8).  Pin: at least one CALL r11
// emerges.
func TestEmitCallFuncValueIndirectCall() testing.TestResult {
	var a @asm.Assembler = callIndMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 24)
	var fv @ir.Instr = make(ir.Instr)
	fv.ID = 1
	fv.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = ir.OP_CALL_FUNC_VALUE
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = fv
	emitCallFuncValue(a, "main", rm, nilFuncs(), ins)
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundIndirect bool = false
	for i := 0; i < n - 1; i++ {
		if data[i] == cast(uint8, 0xFF) &&
				(data[i+1] & cast(uint8, 0x38)) == cast(uint8, 0x10) {
			foundIndirect = true
		}
	}
	if !foundIndirect {
		return "OP_CALL_FUNC_VALUE should emit CALL r11"
	}
	return ""
}

// subWordTripleTuple builds an anonymous (uint16, uint16, uint16) multi-return
// tuple — 6 bytes, ≤ 8, so the whole tuple coalesces into one eightbyte (RAX).
func subWordTripleTuple() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypUint16()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypUint16()
	fields[2] = make(types.Field)
	fields[2].Type = types.TypUint16()
	return types.MakeStructType("", fields)
}

// storesAfterLastIndirectCall counts MOV-to-mem stores (0x89) emitted after the
// last indirect CALL (0xFF /2) — i.e. the return-value collect, which runs once
// the call returns.
func storesAfterLastIndirectCall(a @asm.Assembler) int {
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var callOff int = -1
	for i := 0; i < n - 1; i++ {
		if data[i] == cast(uint8, 0xFF) &&
				(data[i+1] & cast(uint8, 0x38)) == cast(uint8, 0x10) {
			callOff = i
		}
	}
	if callOff < 0 { return -1 }
	var stores int = 0
	for i := callOff + 2; i < n; i++ {
		if data[i] == cast(uint8, 0x89) { stores = stores + 1 }
	}
	return stores
}

// A ≤ 8-byte sub-word multi-return collected through a func-value call must use
// the raw RAX→spill scheme (the callee coalesced the tuple into RAX), NOT the
// old per-field-register split — which capped at 2 fields (dropping field 2)
// and read a coalesced field out of RDX.  Pin: exactly ONE MOV-to-mem store
// after the indirect CALL for a (u16,u16,u16) tuple; the old scheme emitted 2.
func TestEmitCallFuncValueMultiReturnSubWordRawCollect() testing.TestResult {
	var a @asm.Assembler = callIndMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 24)
	var fv @ir.Instr = make(ir.Instr)
	fv.ID = 1
	fv.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = ir.OP_CALL_FUNC_VALUE
	ins.Typ = subWordTripleTuple()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = fv
	emitCallFuncValue(a, "main", rm, nilFuncs(), ins)
	if storesAfterLastIndirectCall(a) != 1 {
		return "funcval ≤8B multi-return should raw-store RAX once "
			"(old per-field scheme emitted 2 and dropped field 2)"
	}
	return ""
}
