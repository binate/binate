package "pkg/binate/native/x64"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// Tests for x64_call_return.bn.  The multi-return and SSE-aggregate collects
// are exercised end to end by the call tests and the conformance suite; this
// pins the return-register order they share.

// GP return slots map to RAX, RDX, RCX in order — LLVM's x86-64 first-class
// struct return lowering, which a native caller must read back identically.
func TestRetGpRegOrder() testing.TestResult {
	if retGpReg(0) != x64.RAX { return "GP return slot 0 is RAX" }
	if retGpReg(1) != x64.RDX { return "GP return slot 1 is RDX" }
	if retGpReg(2) != x64.RCX { return "GP return slot 2 is RCX" }
	return ""
}
