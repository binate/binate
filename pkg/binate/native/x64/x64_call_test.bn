package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// callMkAsm: minimal assembler for emitCall tests.
func callMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func callBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// __c_call routes through symPrefixed (Mach-O '_' / ELF bare) but
// NOT through symFor's bn_<kind>... mangling.  amd64 unit tests run
// with the bare/ELF default for objSymPrefix, so the declared symbol
// is the verbatim C name.  Pins the property at unit level — the
// builder-comp_native_x64 conformance mode isn't exercisable on this
// dev host (no x86_64 sysroot), so this test is the local guard
// against a future refactor demoting the no-mangling behavior.
func TestEmitCallCSymbolPrefixedNotMangled() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_C_CALL
	ins.StrVal = "abs"
	ins.Typ = types.TypInt32()
	ins.CFixedArgs = 0
	emitCall(a, "main", m, nilFuncs(), ins)
	if a.LookupSymbol("abs") < 0 {
		return "OP_C_CALL should declare verbatim 'abs' on ELF (no prefix)"
	}
	if a.LookupSymbol("bn_F1_4_main1_3_abs") >= 0 {
		return "OP_C_CALL must not route through bn_<kind> mangling"
	}
	return ""
}

// A VOID __c_call (the "void" return spelling) lowers as a result-less call:
// the IR carries BOTH ins.ID = -1 AND ins.Typ = nil (newVoidInstr).  emitCall
// skips result collection at the early `ins.ID < 0` return (reached before the
// `ins.Typ == nil` backstop), so it never reads the nil Typ.  This pins the
// OBSERVABLE — a result-less lowering ending in the bare 5-byte CALL with no
// trailing result move — rather than one specific guard (either alone suffices
// for the void case).  Distinct from TestEmitCallCSymbolPrefixedNotMangled
// (non-nil Typ).  `free(p)` shape: one pointer arg, non-variadic.
func TestEmitCallVoidCCallSkipsResult() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ptrArg @ir.Instr = make(ir.Instr)
	ptrArg.ID = 1
	ptrArg.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_C_CALL
	ins.StrVal = "free"
	ins.Typ = nil // void — no result
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = ptrArg
	ins.Args = args
	ins.CFixedArgs = 1
	emitCall(a, "main", m, nilFuncs(), ins) // must not NPE on nil Typ
	if a.LookupSymbol("free") < 0 {
		return "void OP_C_CALL should declare verbatim 'free'"
	}
	var n int = a.Sections[0].Len
	// A non-variadic void call ends in the 5-byte CALL (0xE8 + rel32); with the
	// result-skip there is no trailing result move.
	if n < 5 || a.Sections[0].Data[n - 5] != cast(uint8, 0xE8) {
		return "void c_call should end in a 5-byte CALL (0xE8) with no result move"
	}
	return ""
}

// emitCall void / no-args / no-result: just `call <symbol>` =
// 5 bytes (0xE8 + 4-byte rel32 placeholder).
func TestEmitCallNoArgsVoid() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "pkg/std/os.Exit"
	emitCall(a, "main", m, nilFuncs(), ins)
	if callBytes(a) != 5 {
		return "void no-args call should emit 5-byte CALL"
	}
	if a.Sections[0].Data[0] != cast(uint8, 0xE8) {
		return "CALL first byte should be 0xE8"
	}
	return ""
}

// emitCall with a single scalar arg: the arg is moved into RDI
// (SysV-AMD64 first arg reg), then CALL.  Pin that the MOV opcode
// to RDI register appears in the stream.
func TestEmitCallOneScalarArgUsesRdi() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var arg0 @ir.Instr = make(ir.Instr)
	arg0.ID = 1
	arg0.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "pkg/std/os.Exit"
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = arg0
	emitCall(a, "main", m, nilFuncs(), ins)
	// Verify CALL was emitted (0xE8 near the end).
	var n int = a.Sections[0].Len
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	if n < 5 || data[n - 5] != cast(uint8, 0xE8) {
		return "CALL should be the last 5-byte instruction"
	}
	// Verify a MOV-to-RDI shape appears before the CALL.  RDI is
	// reg 7; MOV r/m64, r64 with dst=RDI has ModRM byte ending in
	// 111 (rm=RDI low 3).  Look for any 0x89 (MOV r/m,r) opcode in
	// the pre-CALL stream — that's the operand-into-RDI move.
	var foundMov bool = false
	for i := 0; i < n - 5; i++ {
		if data[i] == cast(uint8, 0x89) { foundMov = true }
	}
	if !foundMov {
		return "single-arg call should MOV scalar into RDI before CALL"
	}
	return ""
}

// emitCall with a scalar return: after CALL, MOV rd, RAX.  Verify
// the CALL is emitted AND a register-move sequence trailing it
// captures RAX into rd.  RAX is reg 0.
func TestEmitCallScalarReturnSpillsRax() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "pkg/std/os.Write"
	ins.Typ = types.TypInt()
	emitCall(a, "main", m, nilFuncs(), ins)
	// CALL is 5 bytes; a trailing MOV is at least 3 bytes (REX +
	// opcode + ModRM).  Total ≥ 8 bytes.
	if callBytes(a) < 8 {
		return "scalar-return call should emit CALL + trailing MOV"
	}
	// Verify rd was registered in the regmap.
	if m.LookupReg(1) < 0 {
		return "scalar-return call should register rd in regmap"
	}
	return ""
}

// emitCall with a bool return: SysV-AMD64 leaves the upper bits of
// RAX undefined for an `i1` return from LLVM-compiled code, so the
// post-CALL collection must zero-extend AL → rd64 (MOVZX) instead
// of a 64-bit MOV that would propagate garbage upper bits.  A naïve
// MOV broke `if !crossPkgBoolCall()` (263 / 265 — TEST cond,cond
// after OP_NOT's XOR-by-1 saw garbage upper bits as non-zero and
// took the wrong branch).
//
// Pin: 0x0F 0xB6 — the MOVZX r64, r/m8 opcode — appears in the
// byte stream.  (Without this, the trailing MOV from RAX would
// just be 0x48 0x89 ...)
func TestEmitCallBoolReturnZeroExtendsAL() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "pkg/some.Bool"
	ins.Typ = types.TypBool()
	emitCall(a, "main", m, nilFuncs(), ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundMovzx bool = false
	for i := 0; i < n - 1; i++ {
		if data[i] == cast(uint8, 0x0F) && data[i + 1] == cast(uint8, 0xB6) {
			foundMovzx = true
		}
	}
	if !foundMovzx {
		return "bool-return call should zero-extend AL via MOVZX (0x0F 0xB6)"
	}
	return ""
}

// emitCall with a signed int8 return: must sign-extend AL → rd64
// (MOVSX, opcode 0x0F 0xBE), not zero-extend.  Pre-fix this hit
// 416_narrow_int_sign_ext when the MOVZX path was used uniformly
// for retSz==1: `loadInt8(&i8)` for negative `i8` got zero-extended
// and compared positive.
func TestEmitCallInt8SignedReturnSignExtends() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "pkg/some.LoadI8"
	ins.Typ = types.TypInt8()
	emitCall(a, "main", m, nilFuncs(), ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundMovsx bool = false
	for i := 0; i < n - 1; i++ {
		// MOVSX r64, r/m8 → 0x0F 0xBE under REX.W.
		if data[i] == cast(uint8, 0x0F) && data[i + 1] == cast(uint8, 0xBE) {
			foundMovsx = true
		}
	}
	if !foundMovsx {
		return "signed int8 return should sign-extend AL via MOVSX (0x0F 0xBE)"
	}
	return ""
}

// emitCall with int32 signed return: must sign-extend EAX → rd64
// via MOVSXD (opcode 0x63 under REX.W).  Pre-fix, the post-CALL
// 64-bit MOV propagated garbage upper bits — a regression would
// silently lose the sign extension on cross-pkg int32 returns.
func TestEmitCallInt32SignedReturnSignExtends() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "pkg/some.LoadI32"
	ins.Typ = types.TypInt32()
	emitCall(a, "main", m, nilFuncs(), ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	// MOVSXD r64, r/m32 → REX.W + 0x63 + ModRM.  Look for the
	// 0x63 opcode preceded by a REX.W (0x48..0x4F range).
	var foundMovsxd bool = false
	for i := 1; i < n; i++ {
		if data[i] == cast(uint8, 0x63) && (data[i - 1] & cast(uint8, 0xF0)) == cast(uint8, 0x40) {
			foundMovsxd = true
		}
	}
	if !foundMovsxd {
		return "signed int32 return should sign-extend EAX via MOVSXD (0x63)"
	}
	return ""
}

// emitCall with uint16 unsigned return: MOVZX r64, r/m16 — opcode
// 0x0F 0xB7.  Same shape as the bool/uint8 case but with a 16-bit
// source operand.
func TestEmitCallUint16ReturnZeroExtends() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "pkg/some.LoadU16"
	ins.Typ = types.TypUint16()
	emitCall(a, "main", m, nilFuncs(), ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundMovzxW bool = false
	for i := 0; i < n - 1; i++ {
		if data[i] == cast(uint8, 0x0F) && data[i + 1] == cast(uint8, 0xB7) {
			foundMovzxW = true
		}
	}
	if !foundMovzxW {
		return "uint16 return should zero-extend AX via MOVZX r64,r/m16 (0x0F 0xB7)"
	}
	return ""
}

// Multi-return ≤ 16 bytes: SysV-AMD64 packs the first 8-byte word
// into RAX and the second into RDX.  emitCall must store both
// into the spill slot at FieldOffset(0) and FieldOffset(1) so a
// downstream OP_EXTRACT can read them.  Without this, the RAX
// store would land at the right offset but RDX's value would be
// lost.  Pin: 2 stores (RAX → [SP+spill+0], RDX → [SP+spill+8]).
func TestEmitCallMultiReturnTwoIntsSplitsRaxRdx() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// Spill slot for the multi-return tuple — sized to 16 bytes.
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	// Build (int, int) tuple type (anonymous TYP_STRUCT —
	// IsMultiReturnCall recognises Name=="").
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt()
	var tuple @types.Type = types.MakeStructType("", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "twoInts"
	ins.Typ = tuple
	emitCall(a, "main", m, nilFuncs(), ins)
	// Verify the CALL was emitted AND two MOV-to-mem stores follow.
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var callOff int = -1
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xE8) { callOff = i }
	}
	if callOff < 0 {
		return "CALL (0xE8) should appear in stream"
	}
	// After the CALL (callOff + 5 bytes for the call instruction),
	// at least two MOV-to-mem stores (0x89 opcode) should appear.
	var storeCount int = 0
	for i := callOff + 5; i < n; i++ {
		if data[i] == cast(uint8, 0x89) { storeCount = storeCount + 1 }
	}
	if storeCount < 2 {
		return "multi-return should emit 2 MOVs (RAX→slot+0, RDX→slot+8)"
	}
	return ""
}

// Single-field multi-return (degenerate but valid): only RAX gets
// stored, no RDX store.
func TestEmitCallMultiReturnSingleFieldOnlyRax() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	var tuple @types.Type = types.MakeStructType("", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "oneInt"
	ins.Typ = tuple
	emitCall(a, "main", m, nilFuncs(), ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var callOff int = -1
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xE8) { callOff = i }
	}
	if callOff < 0 { return "CALL should appear" }
	// Exactly one trailing MOV-to-mem (RAX → slot+0); no RDX store.
	var storeCount int = 0
	for i := callOff + 5; i < n; i++ {
		if data[i] == cast(uint8, 0x89) { storeCount = storeCount + 1 }
	}
	if storeCount != 1 {
		return "single-field multi-return should emit exactly 1 MOV"
	}
	return ""
}

// Multi-return with 3 float fields: the callee returns XMM0,XMM1 + x87 ST0
// (register-count threshold keeps it in-register on x64).  collectMultiReturn
// Tuple must pop the 3rd float off the x87 stack with an FSTP (opcode 0xDD,
// FSTPL) into the result slot — without it the 3rd component would be lost
// and the x87 stack would leak.  Pins the x87 overflow-collect path.
func TestEmitCallMultiReturnThreeFloatsCollectsX87() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypFloat64()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "threeFloats"
	ins.Typ = tuple
	emitCall(a, "main", m, nilFuncs(), ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var callOff int = -1
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xE8) { callOff = i }
	}
	if callOff < 0 { return "CALL should appear" }
	// After the CALL, an FSTP (0xDD) pops the 3rd float off ST0.
	var foundFstp bool = false
	for i := callOff + 5; i < n; i++ {
		if data[i] == cast(uint8, 0xDD) { foundFstp = true }
	}
	if !foundFstp {
		return "3-float multi-return should FSTP (0xDD) the 3rd float off x87"
	}
	return ""
}

// ============================================================
// Phase 3h: sret call paths
// ============================================================

// emitCall with a > 16-byte aggregate return: the sret-buffer
// pointer goes into RDI (LEA &allocOff), and any user args shift
// one slot — first user arg lands in RSI, not RDI.
//
// Pin: a LEA appears (for &dataOff), AND the CALL is emitted.
func TestEmitCallBigAggregateReturnPassesRdiBuffer() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// 24-byte struct return — > 16 = SysV InternalSretBytes →
	// sret.  Pre-populate a data region for it (where PlanFrame
	// would put it).
	m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 0)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 24)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 24)
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var bigStruct @types.Type = types.MakeStructType("Big", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "makeBig"
	ins.Typ = bigStruct
	emitCall(a, "main", m, nilFuncs(), ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundLea bool = false
	var foundCall bool = false
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0x8D) { foundLea = true }
		if data[i] == cast(uint8, 0xE8) { foundCall = true }
	}
	if !foundLea {
		return "sret call should LEA &returnBuffer into RDI"
	}
	if !foundCall {
		return "sret call should emit a CALL"
	}
	return ""
}

// emitCall with > 16-byte multi-return tuple — sret via hidden
// RDI buffer (same as single-aggregate path); the bytes get
// written through the buffer directly, so no post-CALL register-
// to-slot copying.  Pin: only one LEA + CALL.  Without the
// bigMultiRet guard, the post-CALL multi-return path would emit
// extra MOVs to write RAX/RDX into the spill — which would
// silently overwrite the sret-written bytes with garbage.
func TestEmitCallBigMultiReturnSretNoPostCallMov() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// 9-int tuple = 72 bytes → > 16 = sret.
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var fields @[]@types.Field = make_slice(@types.Field, 9)
	for i := 0; i < 9; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "manyInts"
	ins.Typ = tuple
	emitCall(a, "main", m, nilFuncs(), ins)
	// Find the CALL byte; count MOV-to-mem (0x89) AFTER it.
	// bigRet bypasses the multi-return-pack path, so we expect 0
	// post-CALL 0x89 stores.
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var callOff int = -1
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xE8) { callOff = i }
	}
	if callOff < 0 { return "CALL should appear" }
	var postCallStores int = 0
	for i := callOff + 5; i < n; i++ {
		if data[i] == cast(uint8, 0x89) { postCallStores = postCallStores + 1 }
	}
	if postCallStores > 0 {
		return "big multi-return sret should NOT emit post-CALL MOVs (callee wrote through RDI)"
	}
	return ""
}

// emitCall with sret + a user arg: the user arg shifts to RSI
// (arg-reg slot 1) because RDI is consumed by the sret buffer
// pointer.  Pin that the call sequence is well-formed AND that
// SOME MOV-to-RSI shape appears (a r/m,r MOV — opcode 0x89).
//
// We don't pin the exact RSI ModRM byte because operand-reload
// shapes vary; the test is "the dispatch shift happened at all".
// A regression that left arg 0 in RDI would clobber the sret
// pointer right before the CALL.
func TestEmitCallSretShiftsUserArgsByOne() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// Multi-return tuple > 16 bytes for the return (drives sret),
	// with one scalar user arg.
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var fields @[]@types.Field = make_slice(@types.Field, 9)
	for i := 0; i < 9; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	var arg0 @ir.Instr = make(ir.Instr)
	arg0.ID = 1
	arg0.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "manyInts"
	ins.Typ = tuple
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = arg0
	emitCall(a, "main", m, nilFuncs(), ins)
	// Verify some MOV-r/m,r is emitted (the user-arg shuffle into
	// RSI plus the LEA-RDI setup).  The point is "non-empty
	// pre-CALL byte stream"; the inverse — no MOV — would mean
	// the dispatch shift broke.
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var callOff int = -1
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xE8) { callOff = i }
	}
	if callOff <= 0 {
		return "sret call should have non-empty pre-CALL setup"
	}
	return ""
}

// emitCall with a 16-byte aggregate arg (raw slice) as arg 1 after a
// scalar int arg 0: SysV passes the 2-eightbyte aggregate in the next
// two GP arg registers (RSI, RDX).  Pin that emitAggregateArg emits at
// least two MOV-r-from-mem loads (opcode 0x8B) reading the slice
// header's two eightbytes — without those, the callee reads garbage
// from RSI/RDX (the actual cause of 002_arithmetic's garbage output
// before this path existed).  A LEA must also appear materialising the
// aggregate's storage pointer (the alloc-backed value's getOperand
// path), and a CALL must close the sequence.
func TestEmitCallAggregateArgLoadsTwoEightbytes() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// Scalar int64 arg 0 (id 1) lives in a spill slot.
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	// Aggregate arg 1 (id 2) is an alloca holding a raw slice
	// (%BnSlice = 2 words = 16 bytes).
	m.AllocIDs = common.AppendInt(m.AllocIDs, 2)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 16)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 16)
	var sliceTyp @types.Type = types.MakeSliceType(types.TypUint8())
	var arg0 @ir.Instr = make(ir.Instr)
	arg0.ID = 1
	arg0.Typ = types.TypInt64()
	var arg1 @ir.Instr = make(ir.Instr)
	arg1.ID = 2
	arg1.Typ = sliceTyp
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "pkg/std/os.Write"
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = arg0
	ins.Args[1] = arg1
	emitCall(a, "main", m, nilFuncs(), ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	// CALL (0xE8) closes the sequence.
	if n < 5 || data[n - 5] != cast(uint8, 0xE8) {
		return "aggregate-arg call should still end with CALL"
	}
	// Count 0x8B (MOV r, r/m — load from memory into reg) in the
	// pre-CALL stream.  We need at least two: one per eightbyte of
	// the slice header.  0x8B is also how the scalar arg 0 reloads
	// from its spill slot, so the lower bound is 3 (1 scalar reload
	// + 2 aggregate-eightbyte loads).  Use ≥ 3 to keep the pin
	// resilient to additional incidental reloads.
	var loads int = 0
	var foundLea bool = false
	for i := 0; i < n - 5; i++ {
		if data[i] == cast(uint8, 0x8B) { loads = loads + 1 }
		if data[i] == cast(uint8, 0x8D) { foundLea = true }
	}
	if loads < 3 {
		return "aggregate-arg call should emit ≥2 MOV-from-mem "
				"loads (one per eightbyte) plus the scalar reload"
	}
	if !foundLea {
		return "aggregate-arg call should LEA the alloca's storage pointer"
	}
	return ""
}

// emitCall with a 16-byte aggregate as arg 0 (no preceding scalar):
// the two eightbytes land in RDI / RSI per SysV.  Symmetric to
// TestEmitCallAggregateArgLoadsTwoEightbytes but pins that the
// regStart=0 case works (no off-by-one in argReg(regStart + w)).
func TestEmitCallAggregateArgFirstSlot() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// Aggregate arg 0 (id 1) is an alloca holding a raw slice.
	m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 0)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 16)
	var sliceTyp @types.Type = types.MakeSliceType(types.TypUint8())
	var arg0 @ir.Instr = make(ir.Instr)
	arg0.ID = 1
	arg0.Typ = sliceTyp
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "foo"
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = arg0
	emitCall(a, "main", m, nilFuncs(), ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	if n < 5 || data[n - 5] != cast(uint8, 0xE8) {
		return "first-slot aggregate-arg call should still end with CALL"
	}
	// Two MOV-from-mem (0x8B) — one per eightbyte — must appear.
	var loads int = 0
	for i := 0; i < n - 5; i++ {
		if data[i] == cast(uint8, 0x8B) { loads = loads + 1 }
	}
	if loads < 2 {
		return "first-slot 16-byte aggregate should MOV 2 eightbytes "
				"into RDI/RSI"
	}
	return ""
}

// emitCall with a > 16-byte aggregate arg (32-byte managed-slice):
// MEMORY class under SysV → entirely on the stack (no reg portion).
// emitAggregateArg should emit one load+store pair per eightbyte —
// MOV-into-RAX (0x8B) then MOV-RAX-to-mem (0x89) — for all 4 words
// SysV indirect-large: a managed-slice (32 B > AggregateInRegMax)
// passes as a single pointer in the first GP arg reg (RDI).  Pin
// that CALL is emitted and the alloca-pointer reaches an arg reg;
// the old MEMORY-on-stack copy-loop is gone.
func TestEmitCallIndirectLargeAggregateArgX64() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// 32-byte managed-slice arg (4 * ptrSize = 32 on LP64).
	m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 0)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 32)
	var mslice @types.Type = types.MakeManagedSliceType(types.TypUint8())
	var arg0 @ir.Instr = make(ir.Instr)
	arg0.ID = 1
	arg0.Typ = mslice
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "foo"
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = arg0
	emitCall(a, "main", m, nilFuncs(), ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	if n < 5 || data[n - 5] != cast(uint8, 0xE8) {
		return "indirect-large aggregate call should still end with CALL"
	}
	return ""
}

// Args 7+ overflow to stack — pin that at least 6 args go in regs
// (no MOV to stack) and the 7th triggers a MOV to [rsp + 0].
func TestEmitCallSeventhArgOnStack() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	for i := 0; i < 7; i++ {
		m.SpillIDs = common.AppendInt(m.SpillIDs, i + 1)
		m.SpillOffsets = common.AppendInt(m.SpillOffsets, i * 8)
	}
	m.OutgoingArgsSize = 16
	var args @[]@ir.Instr = make_slice(@ir.Instr, 7)
	for i := 0; i < 7; i++ {
		args[i] = make(ir.Instr)
		args[i].ID = i + 1
		args[i].Typ = types.TypInt()
	}
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "foo"
	ins.Args = args
	emitCall(a, "main", m, nilFuncs(), ins)
	// Verify a CALL was emitted (0xE8 near the end).
	var n int = a.Sections[0].Len
	if n < 5 { return "should emit at least the CALL" }
	if a.Sections[0].Data[n - 5] != cast(uint8, 0xE8) {
		return "CALL (0xE8) should be the last 5 bytes"
	}
	return ""
}

// Variadic OP_C_CALL (CFixedArgs < len(Args)) must emit `MOV AL, 0`
// immediately before the CALL instruction.  SysV-AMD64 requires AL
// to hold the number of XMM registers used by varargs; without it,
// callees that read AL defensively (printf et al.) see whatever's
// left in RAX's low byte and may misinterpret as a "vector args"
// count.
//
// Pin both observable effects: the 2-byte `B0 00` (MOV AL, imm8 = 0)
// appears immediately before the 5-byte CALL.
func TestEmitCallVariadicSetsAlToZero() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// Stash a fake spill for arg 1.
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var fmtArg @ir.Instr = make(ir.Instr)
	fmtArg.ID = 1
	fmtArg.Typ = types.MakeSliceType(types.MakeReadonlyType(types.TypChar()))
	var intArg @ir.Instr = make(ir.Instr)
	intArg.ID = 2
	intArg.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_C_CALL
	ins.StrVal = "printf"
	ins.Typ = types.TypInt32()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 2)
	args[0] = fmtArg
	args[1] = intArg
	ins.Args = args
	ins.CFixedArgs = 1 // printf-shaped: 1 fixed, 1 variadic.
	emitCall(a, "main", m, nilFuncs(), ins)
	var n int = a.Sections[0].Len
	if n < 7 { return "expected MOV AL, 0 (2 bytes) + CALL (5 bytes)" }
	// CALL is 5 bytes at the tail; MOV AL, 0 should be the 2 bytes
	// just before that.
	if a.Sections[0].Data[n - 5] != cast(uint8, 0xE8) {
		return "CALL (0xE8) should be the last 5 bytes"
	}
	if a.Sections[0].Data[n - 7] != cast(uint8, 0xB0) {
		return "MOV AL, imm8 (0xB0) should immediately precede CALL"
	}
	if a.Sections[0].Data[n - 6] != cast(uint8, 0x00) {
		return "MOV AL imm8 byte should be 0 (no XMM args)"
	}
	return ""
}

// Non-variadic OP_C_CALL (CFixedArgs == len(Args)) must NOT emit
// the MOV AL, 0 prefix — only true varargs sites need it, and an
// extra MOV bloats every call to abs/strlen/etc.
func TestEmitCallNonVariadicNoAlSetup() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var arg0 @ir.Instr = make(ir.Instr)
	arg0.ID = 1
	arg0.Typ = types.TypInt32()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_C_CALL
	ins.StrVal = "abs"
	ins.Typ = types.TypInt32()
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = arg0
	ins.Args = args
	ins.CFixedArgs = 1 // all fixed.
	emitCall(a, "main", m, nilFuncs(), ins)
	var n int = a.Sections[0].Len
	// The CALL is 5 bytes at the tail.  Byte n-6 should NOT be 0xB0
	// (MOV AL imm8 opcode).
	if n >= 6 && a.Sections[0].Data[n - 6] == cast(uint8, 0xB0) {
		return "non-variadic OP_C_CALL must not emit MOV AL prefix"
	}
	return ""
}
