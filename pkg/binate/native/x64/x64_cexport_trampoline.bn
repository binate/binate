package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// funcHasByvalParamX64 reports whether f has a >16-byte by-value aggregate
// parameter — the case whose SysV-AMD64 C-ABI form (MEMORY class, on the stack)
// differs from Binate's internal single-pointer form and so needs an adapting
// entry, not the in-place narrow-register prefix.
func funcHasByvalParamX64(f @ir.Func) bool {
	for i := 0; i < len(f.Params); i++ {
		if f.Params[i].Typ.IsByvalParam() {
			return true
		}
	}
	return false
}

// cExportRetTrampolineKindX64 classifies f's #[c_export] multi-value-return
// adaptation (common.CRET_ADAPT_NONE / _SRET / _COERCE); NONE for a single /
// scalar / void return.
func cExportRetTrampolineKindX64(f @ir.Func, cc common.CallConv) int {
	if len(f.Results) <= 1 || f.MultiReturnType == nil {
		return common.CRET_ADAPT_NONE
	}
	return cc.CExportMultiReturnAdaptKind(f.MultiReturnType)
}

// cExportNeedsTrampolineX64 reports whether f's #[c_export] entry needs an adapter
// trampoline: a >16-byte by-value aggregate PARAMETER (funcHasByvalParamX64) or a
// divergent multi-value RETURN (cExportRetTrampolineKindX64).  Either makes the
// in-place narrow-register prefix + jmp insufficient.
func cExportNeedsTrampolineX64(f @ir.Func, cc common.CallConv) bool {
	return funcHasByvalParamX64(f) || cExportRetTrampolineKindX64(f, cc) != common.CRET_ADAPT_NONE
}

// loadCoercedTupleReturn_x64 loads the memory image of an in-register multi-return
// tuple at [base+baseOff] into the SysV return registers in clang's C struct-return
// coerced form: each eightbyte to RAX/RDX (INTEGER class) or XMM0/XMM1 (SSE class),
// per SysVClassify.  The counterpart of storeMultiReturnTupleFields_x64 for the
// #[c_export] in-register coercion path (which stores the field-per-register result
// to the slot, then reloads it packed here).  Mirrors emitSseAggregateReturnPack's
// per-eightbyte loop with base+offset addressing.
func loadCoercedTupleReturn_x64(a @asm.Assembler, t @types.Type, base int, baseOff int) {
	var cl @[]int = types.SysVClassify(t)
	var nsse int = 0
	var ngp int = 0
	for eb := 0; eb < len(cl); eb++ {
		var off int = baseOff + 8 * eb
		if cl[eb] == types.EB_SSE {
			if types.SysVEightbyteForm(t, eb) == types.SEB_FLOAT {
				x64.Movss_load(a, x64.XMM0 + nsse, x64.Mem(base, off, x64.SZ32))
			} else {
				x64.Movlps_load(a, x64.XMM0 + nsse, x64.Mem(base, off, x64.SZ64))
			}
			nsse = nsse + 1
		} else {
			var gp int = x64.RAX
			if ngp == 1 {
				gp = x64.RDX
			}
			x64.Mov(a, x64.Reg(gp, x64.SZ64), x64.Mem(base, off, x64.SZ64))
			ngp = ngp + 1
		}
	}
}

// cXmmArgCountX64 counts the incoming XMM argument registers the SysV C ABI uses
// for paramTypes: one per in-register float scalar, plus one per SSE eightbyte of
// each in-register SSE aggregate.  Drives how many XMM registers phase 1 stashes.
func cXmmArgCountX64(cc common.CallConv, paramTypes @[]@types.Type) int {
	var n int = 0
	for i := 0; i < len(paramTypes); i++ {
		if cc.CallArgStackOff(paramTypes, i) >= 0 { continue }
		var t @types.Type = paramTypes[i]
		if common.IsFloatScalarTyp(t) {
			n = n + 1
		} else if cc.PassesSseInRegs(t) {
			var cl @[]int = types.SysVClassify(t)
			for k := 0; k < len(cl); k++ {
				if cl[k] == types.EB_SSE { n = n + 1 }
			}
		}
	}
	return n
}

// emitTrampolineSseMove moves ONE SSE value (a float scalar or a single SSE
// eightbyte of an aggregate) from its C-ABI position — ALWAYS a memory slot
// (cBase+cOff) — into its internal position, an XMM register (iXmm) or a memory
// slot (iBase+iOff, iMem).  The C side is memory because phase 1 stashes the
// incoming XMM argument registers to scratch: a value the C ABI passed in an XMM
// register is read from that scratch, one passed on the C stack is read there.
// Reading the C side from memory (never a live XMM register) makes phase 2
// order-independent — an internal-XMM write can never clobber an incoming value a
// later param still needs.  narrow4 forces a 4-byte (MOVSS) move for a lone-f32
// eightbyte whose slot is only 4 bytes wide; otherwise an 8-byte move.
func emitTrampolineSseMove(a @asm.Assembler, narrow4 bool, cBase int, cOff int, iMem bool,
		iBase int, iOff int, iXmm int) {
	if !iMem {
		if narrow4 {
			x64.Movss_load(a, iXmm, x64.Mem(cBase, cOff, x64.SZ32))
		} else {
			x64.Movlps_load(a, iXmm, x64.Mem(cBase, cOff, x64.SZ64))
		}
		return
	}
	var sz int = x64.SZ64
	if narrow4 { sz = x64.SZ32 }
	x64.Mov(a, x64.Reg(x64.RAX, sz), x64.Mem(cBase, cOff, sz))
	x64.Mov(a, x64.Mem(iBase, iOff, sz), x64.Reg(x64.RAX, sz))
}

// emitSseAggParamTrampolineX64 marshals one <=16-byte SysV-SSE aggregate param
// from its C-ABI split placement into its internal split placement, eightbyte by
// eightbyte and by class.  ci / ii are the aggregate's C / internal argument
// indices; nsrnC / nsrnI are the running C / internal XMM cursors at this param.
// A SSE eightbyte is read from the C XMM-register scratch (xmmScratchBase, filled
// in phase 1) or the C stack and placed into an internal XMM register or the
// internal stack; each INTEGER eightbyte routes through RAX from its GP scratch
// slot / C stack to its internal GP reg / stack.  A side is memory-class when its
// CallArgStackOff is >= 0.  Returns the (C, internal) SSE-eightbyte counts
// consumed (0 on the side where the aggregate is memory-class), so the caller
// advances nsrnC / nsrnI.
func emitSseAggParamTrampolineX64(a @asm.Assembler, cc common.CallConv, ccC common.CallConv,
		t @types.Type, ci int, ii int, paramTypesC @[]@types.Type, paramTypesInt @[]@types.Type,
		scratchBase int, xmmScratchBase int, stackArgsBase int, nsrnC int, nsrnI int) (int, int) {
	var cl @[]int = types.SysVClassify(t)
	var cRegStart int = ccC.CallArgRegStart(paramTypesC, ci)
	var cStackOff int = ccC.CallArgStackOff(paramTypesC, ci)
	var cMem bool = cStackOff >= 0
	var iRegStart int = cc.CallArgRegStart(paramTypesInt, ii)
	var iStackOff int = cc.CallArgStackOff(paramTypesInt, ii)
	var iMem bool = iStackOff >= 0
	var cInt int = 0
	var cSse int = 0
	var iInt int = 0
	var iSse int = 0
	for eb := 0; eb < len(cl); eb++ {
		if cl[eb] == types.EB_SSE {
			var narrow4 bool = types.SysVEightbyteForm(t, eb) == types.SEB_FLOAT
			var cBase int = x64.RSP
			var cOff int = xmmScratchBase + 8 * (nsrnC + cSse)
			if cMem {
				cBase = x64.RBP
				cOff = stackArgsBase + cStackOff + 8 * eb
			}
			emitTrampolineSseMove(a, narrow4, cBase, cOff, iMem, x64.RSP, iStackOff + 8 * eb,
					x64.XMM0 + nsrnI + iSse)
			cSse = cSse + 1
			iSse = iSse + 1
		} else {
			if cMem {
				x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64),
						x64.Mem(x64.RBP, stackArgsBase + cStackOff + 8 * eb, x64.SZ64))
			} else {
				x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64),
						x64.Mem(x64.RSP, scratchBase + 8 * (cRegStart + cInt), x64.SZ64))
			}
			if iMem {
				x64.Mov(a, x64.Mem(x64.RSP, iStackOff + 8 * eb, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
			} else {
				x64.Mov(a, x64.Reg(argReg(iRegStart + iInt), x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
			}
			cInt = cInt + 1
			iInt = iInt + 1
		}
	}
	var advC int = 0
	if !cMem { advC = cSse }
	var advI int = 0
	if !iMem { advI = iSse }
	return advC, advI
}

// emitCExportTrampolineX64 emits the #[c_export] C entry for a function whose
// parameters and/or multi-value return need C-ABI adaptation.  The narrow-register
// prefix + jmp model cannot serve when the C and internal conventions place things
// differently, so the entry becomes a TRAMPOLINE: it re-marshals each argument from
// its C-ABI position to `sym`'s internal position, calls `sym`, then adapts the
// return, and finally RETs.
//
// Two register cursors — the C-facing one (paramTypesC, with a hidden sret pointer
// in RDI iff the C ABI sret's the result) and the internal one (paramTypesInt, the
// mangled body's) — can disagree in exactly one way for a multi-value return: the C
// ABI sret's a tuple the internal convention register-returns, so the C args are
// shifted one GP register down (RDI holds the C sret buffer).  `shift` is that
// difference; it is 0 whenever the two conventions agree (a by-value-param-only
// trampoline, a single-aggregate sret, an in-register coercion).
//
// A >16-byte aggregate param is handed to `sym` as a POINTER to the incoming C-stack
// bytes.  Scalars / ≤16-byte GP aggregates are copied word-for-word (a narrow scalar
// sign/zero-extended).  Register floats stay in their XMM register (the sret buffer
// consumes no XMM, so the FP cursor is unshifted).  Phase 1 stashes the incoming GP
// argument registers so phase 2 reads only from scratch or the incoming stack.
func emitCExportTrampolineX64(a @asm.Assembler, rm @common.RegMap, f @ir.Func,
		sym *[]readonly char) {
	var cc common.CallConv = rm.CC
	var ccC common.CallConv = cc.ForCBoundary()

	// The internal (sret-vs-register) return shape comes from f directly, not a
	// planned frame's SretSlotOff — the __c_entry thunk reuses this trampoline with
	// a bare RegMap (no PlanFrame).  For a #[c_export] entry the two agree: PlanFrame
	// sets SretSlotOff >= 0 from exactly this predicate.
	var intSret bool = cc.FuncReturnsViaInternalSret(f)
	var isMulti bool = len(f.Results) > 1 && f.MultiReturnType != nil
	var retKind int = common.CRET_ADAPT_NONE
	var cSret bool = intSret
	if isMulti {
		retKind = cc.CExportMultiReturnAdaptKind(f.MultiReturnType)
		cSret = common.CMultiReturnTupleNeedsSret(f.MultiReturnType)
	}

	// Internal dispatch list (paramTypesInt): the sret pointer takes slot 0 iff the
	// body itself returns via sret.  C-facing list (paramTypesC): the sret pointer
	// takes slot 0 iff the C ABI sret's the result.  `shift` maps an internal index
	// to its C index.
	var intPfx int = 0
	if intSret {
		intPfx = 1
	}
	var cPfx int = 0
	if cSret {
		cPfx = 1
	}
	var shift int = cPfx - intPfx
	var paramTypesInt @[]@types.Type = make_slice(@types.Type, len(f.Params) + intPfx)
	if intSret {
		paramTypesInt[0] = types.MakePointerType(types.TypUint8())
	}
	for pi := 0; pi < len(f.Params); pi++ {
		paramTypesInt[intPfx + pi] = f.Params[pi].Typ
	}
	var paramTypesC @[]@types.Type = make_slice(@types.Type, len(f.Params) + cPfx)
	if cSret {
		paramTypesC[0] = types.MakePointerType(types.TypUint8())
	}
	for pi := 0; pi < len(f.Params); pi++ {
		paramTypesC[cPfx + pi] = f.Params[pi].Typ
	}

	// Frame: [rsp+0 .. outBytes) = sym's outgoing stack args; [rsp+outBytes .. +48)
	// = scratch for the (up to six) incoming GP argument registers; then, when the C
	// ABI passes any argument in an XMM register, [rsp+xmmScratchBase .. +64) = a
	// stash of the (up to eight) incoming XMM argument registers; [rsp+retSlotOff
	// .. +16) = the in-register-coercion repack slot.  Each block is 16-aligned so
	// rsp stays 16-aligned at `call sym`.  [rbp + 16 + cOff] reads the caller's
	// incoming stack args (16 = pushed return address + saved rbp).
	var cXmmCount int = cXmmArgCountX64(ccC, paramTypesC)
	var xmmScratchSize int = 0
	if cXmmCount > 0 {
		xmmScratchSize = 64
	}
	var outBytes int = cc.CallStackBytes(paramTypesInt)
	var scratchBase int = outBytes
	var xmmScratchBase int = outBytes + 48
	var retSlotOff int = outBytes + 48 + xmmScratchSize
	var frameSz int = retSlotOff + 16
	var stackArgsBase int = 16

	x64.Push(a, x64.Reg(x64.RBP, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.RBP, x64.SZ64), x64.Reg(x64.RSP, x64.SZ64))
	x64.Sub(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(frameSz))

	// Phase 1: stash the incoming GP argument registers so phase 2 can overwrite
	// them freely.  Scratch sits above rsp, so `call sym` (which uses the stack
	// below rsp) does not disturb it — the C sret buffer at scratch[0] survives for
	// the post-call store.
	for r := 0; r < cc.NumGpArgRegs; r++ {
		x64.Mov(a, x64.Mem(x64.RSP, scratchBase + 8 * r, x64.SZ64), x64.Reg(argReg(r), x64.SZ64))
	}
	// Also stash the incoming XMM argument registers the C ABI used (low 8 bytes —
	// an SSE arg eightbyte is at most 8 bytes), so phase 2 reads every SSE value
	// from this scratch rather than a live XMM register.  That is what lets a value
	// the C ABI passed in an XMM register survive an internal-XMM write for an
	// earlier param — the register-clobber the naive in-place form would cause.
	for x := 0; x < cXmmCount; x++ {
		x64.Movlps_store(a, x64.Mem(x64.RSP, xmmScratchBase + 8 * x, x64.SZ64), x64.XMM0 + x)
	}

	// Phase 2: place each internal dispatch slot at its outgoing position, reading
	// from the corresponding C position (shifted by the sret-register difference).
	// nsrnC / nsrnI are the C-side and internal-side XMM (SSE) arg cursors, tracked
	// separately because a <=16-byte MIXED SSE aggregate can be register-class in C
	// yet MEMORY-class internally (a preceding >16-byte aggregate rides a pointer in
	// an internal GP reg but rides the stack — consuming no GP — in C, so the
	// internal GP file fills first), which advances the C XMM cursor while leaving
	// the internal one behind.
	var nsrnC int = 0
	var nsrnI int = 0
	for i := 0; i < len(paramTypesInt); i++ {
		var t @types.Type = paramTypesInt[i]
		var nReg int = cc.CallArgRegStart(paramTypesInt, i)
		var nOff int = cc.CallArgStackOff(paramTypesInt, i)

		if intSret && !cSret && i == 0 {
			// COERCE_FROM_SRET: the body sret's a tuple the C ABI register-returns.
			// Hand the body a LOCAL buffer (the coercion slot) as its sret pointer;
			// the C caller passed none, so there is no C position to marshal from.
			if nReg >= 0 {
				x64.Lea(a, x64.Reg(argReg(nReg), x64.SZ64), x64.Mem(x64.RSP, retSlotOff, x64.SZ64))
			} else {
				x64.Lea(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RSP, retSlotOff, x64.SZ64))
				x64.Mov(a, x64.Mem(x64.RSP, nOff, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
			}
			continue
		}

		if common.IsFloatScalarTyp(t) {
			// A float scalar rides an XMM arg register (stashed to xmmScratch in
			// phase 1) or the C stack once the FP file is exhausted.  Read it from
			// that C position and place it in its internal XMM register or stack; the
			// C and internal FP cursors (nsrnC/nsrnI) can differ once a mixed SSE
			// aggregate has gone memory-class internally.  Its own slot is 8-byte-
			// rounded, so an 8-byte move is safe (narrow4 false).
			var cOffF int = ccC.CallArgStackOff(paramTypesC, i + shift)
			var cMemF bool = cOffF >= 0
			var iMemF bool = nOff >= 0
			var cBaseF int = x64.RSP
			var cSrcF int = xmmScratchBase + 8 * nsrnC
			if cMemF {
				cBaseF = x64.RBP
				cSrcF = stackArgsBase + cOffF
			}
			emitTrampolineSseMove(a, false, cBaseF, cSrcF, iMemF, x64.RSP, nOff, x64.XMM0 + nsrnI)
			if !cMemF { nsrnC = nsrnC + 1 }
			if !iMemF { nsrnI = nsrnI + 1 }
			continue
		}

		if t.IsByvalParam() {
			// >16-byte aggregate: C passes it by value on the stack; hand `sym` the
			// ADDRESS of those incoming bytes.
			var cOff int = ccC.CallArgStackOff(paramTypesC, i + shift)
			if nReg >= 0 {
				x64.Lea(a, x64.Reg(argReg(nReg), x64.SZ64), x64.Mem(x64.RBP, stackArgsBase + cOff, x64.SZ64))
			} else {
				x64.Lea(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RBP, stackArgsBase + cOff, x64.SZ64))
				x64.Mov(a, x64.Mem(x64.RSP, nOff, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
			}
			continue
		}

		if cc.PassesSseInRegs(t) {
			// A <=16-byte SysV-SSE (float-containing) aggregate: SysV splits it across
			// the register files by eightbyte class — each SSE eightbyte an XMM reg,
			// each INTEGER eightbyte a GP reg — NOT the plain all-GP path below, which
			// would read the SSE eightbytes from GP registers the C caller never wrote
			// (dropping them: the mixed-aggregate straddle miscompile).  Marshal each
			// eightbyte by class; advance both XMM cursors by the SSE eightbytes each
			// side placed in registers.
			var advC int
			var advI int
			advC, advI = emitSseAggParamTrampolineX64(a, cc, ccC, t, i + shift, i, paramTypesC,
					paramTypesInt, scratchBase, xmmScratchBase, stackArgsBase, nsrnC, nsrnI)
			nsrnC = nsrnC + advC
			nsrnI = nsrnI + advI
			continue
		}

		// GP scalar / pointer (incl. a hidden sret pointer) or ≤16-byte GP aggregate:
		// SysV places all its words in consecutive GP registers OR wholly on the
		// stack (never split).  Route each word through RAX so a narrow scalar can be
		// extended in flight.
		var nWords int = common.ArgWords(t)
		var cReg int = ccC.CallArgRegStart(paramTypesC, i + shift)
		var cOff int = ccC.CallArgStackOff(paramTypesC, i + shift)
		var isScalar bool = !common.IsAggregateTyp(t)
		for w := 0; w < nWords; w++ {
			if cReg >= 0 {
				x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RSP, scratchBase + 8 * (cReg + w), x64.SZ64))
			} else {
				x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RBP, stackArgsBase + cOff + 8 * w, x64.SZ64))
			}
			if isScalar {
				// No-op for word-size / pointer; sign/zero-extends a narrow scalar.
				normalizeNarrowRegParamX64(a, x64.RAX, t)
			}
			if nReg >= 0 {
				x64.Mov(a, x64.Reg(argReg(nReg + w), x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
			} else {
				x64.Mov(a, x64.Mem(x64.RSP, nOff + 8 * w, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
			}
		}
	}

	x64.Call(a, sym)

	if retKind == common.CRET_ADAPT_SRET {
		// The C ABI sret's the tuple but the body register-returned it: store the
		// field-per-register result into the caller's buffer (still at scratch[0] =
		// the incoming RDI), then return the buffer pointer in RAX per SysV.  R10/R11
		// are caller-saved scratch, disjoint from the RAX/RDX/RCX return registers.
		x64.Mov(a, x64.Reg(x64.R10, x64.SZ64), x64.Mem(x64.RSP, scratchBase, x64.SZ64))
		storeMultiReturnTupleFields_x64(a, f.MultiReturnType, x64.R10, 0, x64.R11, cc.NumFpRetRegs)
		x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Reg(x64.R10, x64.SZ64))
	} else if retKind == common.CRET_ADAPT_COERCE {
		// Both register-return, but the C ABI packs sub-word fields per eightbyte:
		// store the field-per-register result into the local slot at its field
		// offsets, then reload clang's eightbyte-coerced form into the return
		// registers.
		storeMultiReturnTupleFields_x64(a, f.MultiReturnType, x64.RSP, retSlotOff, x64.R10,
				cc.NumFpRetRegs)
		loadCoercedTupleReturn_x64(a, f.MultiReturnType, x64.RSP, retSlotOff)
	} else if retKind == common.CRET_ADAPT_COERCE_FROM_SRET {
		// The body already wrote the tuple into the local buffer (its sret pointer,
		// set to the coercion slot above): reload clang's eightbyte-coerced form.
		loadCoercedTupleReturn_x64(a, f.MultiReturnType, x64.RSP, retSlotOff)
	}

	x64.Mov(a, x64.Reg(x64.RSP, x64.SZ64), x64.Reg(x64.RBP, x64.SZ64))
	x64.Pop(a, x64.Reg(x64.RBP, x64.SZ64))
	x64.Ret(a)
}
