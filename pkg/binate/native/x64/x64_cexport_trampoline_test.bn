package "pkg/binate/native/x64"

import "pkg/binate/irbuild"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Test for the #[c_export] >16-byte by-value aggregate param adapter trampoline
// (x64_cexport_trampoline.bn).  asm.New / fail / symFor / symPrefixed / nilStrings
// / emitFunc live in the x64 package.

// A #[c_export] function with a >16-byte by-value aggregate param gets an adapter
// TRAMPOLINE, not the in-place narrow-register prefix: the SysV C ABI passes the
// aggregate on the stack (MEMORY) but the mangled entry expects a pointer in a
// register, so the args must be re-marshaled and the mangled entry CALLed.  A
// byte-exact check would be brittle (many instructions), so pin the structural
// shape: the alias precedes the mangled entry, and the trampoline ends in RET
// (0xC3) — the call-based adapter, unlike the jmp-based narrow prefix.  End-to-end
// correctness is covered by e2e/ffi-export.sh under Rosetta/qemu.
func TestEmitFuncCExportBigAggTrampoline() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Name = "f"
		fields[i].Type = types.TypInt64()
	}
	var big @types.Type = types.MakeStructType("Big", fields) // 24B => >16, byval
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].ID = 1
	params[0].Name = "x"
	params[0].Typ = big
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.Take", params, noR)
	var blk @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(blk, noArgs)
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr("ffi_big"))
	f.CExportNames = names
	emitFunc(a, "main", f, nilStrings())

	var mangledIdx int = a.LookupSymbol(symFor("main", "main.Take"))
	var aliasIdx int = a.LookupSymbol(symPrefixed("ffi_big"))
	if mangledIdx < 0 || aliasIdx < 0 {
		return fail("big-agg c_export: alias or mangled symbol missing")
	}
	var aliasOff int = cast(int, a.Symbols[aliasIdx].Offset)
	var mangledOff int = cast(int, a.Symbols[mangledIdx].Offset)
	if aliasOff >= mangledOff {
		return fail("big-agg c_export trampoline must precede the mangled entry")
	}
	var gd @[]uint8 = a.Sections[0].Data
	if gd[mangledOff - 1] != cast(uint8, 0xC3) {
		return fail("big-agg c_export trampoline must end in RET (a call-based adapter)")
	}
	return ""
}

// A #[c_export] function with a >16-byte by-value aggregate param FOLLOWED by
// enough int64s and a MIXED {i64,f64} aggregate reproduces the SysV straddle:
// the mixed aggregate is register-class in C (its i64 in a GP reg, its f64 in
// XMM) but memory-class internally (the >16 aggregate's internal pointer + the
// five int64s fill the internal GP file), so the trampoline must read the f64
// eightbyte from XMM and store it into the internal memory slot.  The buggy form
// read every eightbyte from GP scratch — dropping the XMM half (which phase 1
// never stashed).  Pin the fix structurally: the trampoline emits a MOVLPS store
// (0F 13) of the SSE eightbyte from an XMM register; the all-GP buggy form emits
// no XMM instruction at all.
func TestEmitCExportMixedSseStraddleTrampolineX64() testing.TestResult {
	// ARCH_X64 is what gates the SysV SSE-aggregate split (SysVSseInRegs →
	// cc.SseAggregates); setTarget64 alone leaves Arch unset.
	var tgt types.TargetInfo
	tgt.PointerSize = 8
	tgt.IntSize = 8
	tgt.MaxAlign = 8
	tgt.Arch = types.ARCH_X64
	types.SetTarget(tgt)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var bigFields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		bigFields[i] = make(types.Field)
		bigFields[i].Name = "f"
		bigFields[i].Type = types.TypInt64()
	}
	var big @types.Type = types.MakeStructType("FfiBig", bigFields) // 24B => >16, byval
	var mixFields @[]@types.Field = make_slice(@types.Field, 2)
	mixFields[0] = make(types.Field)
	mixFields[0].Name = "i"
	mixFields[0].Type = types.TypInt64()
	mixFields[1] = make(types.Field)
	mixFields[1].Name = "f"
	mixFields[1].Type = types.TypFloat64()
	var mix @types.Type = types.MakeStructType("FfiMix", mixFields) // 16B mixed {i64,f64}
	// params: big, 5x int64, mix.
	var params @[]@ir.Param = make_slice(@ir.Param, 7)
	params[0] = make(ir.Param)
	params[0].ID = 1
	params[0].Name = "big"
	params[0].Typ = big
	for i := 1; i <= 5; i++ {
		params[i] = make(ir.Param)
		params[i].ID = cast(int, i) + 1
		params[i].Name = "n"
		params[i].Typ = types.TypInt64()
	}
	params[6] = make(ir.Param)
	params[6].ID = 7
	params[6].Name = "mix"
	params[6].Typ = mix
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt64()
	var f @ir.Func = ir.NewFunc("", "main.BigMix", params, results)
	var blk @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(blk, noArgs)
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr("ffi_bigmix"))
	f.CExportNames = names
	emitFunc(a, "main", f, nilStrings())

	var aliasIdx int = a.LookupSymbol(symPrefixed("ffi_bigmix"))
	var mangledIdx int = a.LookupSymbol(symFor("main", "main.BigMix"))
	if aliasIdx < 0 || mangledIdx < 0 {
		return fail("mixed-SSE straddle: alias or mangled symbol missing")
	}
	var aliasOff int = cast(int, a.Symbols[aliasIdx].Offset)
	var mangledOff int = cast(int, a.Symbols[mangledIdx].Offset)
	var gd @[]uint8 = a.Sections[0].Data
	// Scan the trampoline body [aliasOff, mangledOff) for a MOVLPS store (0F 13):
	// the SSE eightbyte moved out of XMM.  The GP-only buggy form never emits it.
	var foundMovlps bool = false
	for off := aliasOff; off + 1 < mangledOff; off++ {
		if gd[off] == cast(uint8, 0x0F) && gd[off + 1] == cast(uint8, 0x13) {
			foundMovlps = true
			break
		}
	}
	if !foundMovlps {
		return fail(
				"mixed-SSE straddle trampoline must move the f64 eightbyte from XMM "
						"(MOVLPS 0F 13); the all-GP form drops it")
	}
	return ""
}
