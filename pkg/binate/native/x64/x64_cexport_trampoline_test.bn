package "pkg/binate/native/x64"

import "pkg/binate/irbuild"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Test for the #[c_export] >16-byte by-value aggregate param adapter trampoline
// (x64_cexport_trampoline.bn).  asm.New / fail / symFor / symPrefixed / nilStrings
// / emitFunc live in the x64 package.

// bigAggTake builds `main.Take(x Big)` (Big = three int64, 24 B — MEMORY class),
// exported as `name`, returning `nRes` int64 values (a three-value tuple is
// returned through sret in C but in registers internally — a divergent return).
func bigAggTake(name *[]readonly char, nRes int) @ir.Func {
	return bigAggTakeN(name, 3, nRes)
}

// int64Fields returns n int64 struct fields.
func int64Fields(n int) @[]@types.Field {
	var fields @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		fields[i] = make(types.Field)
		fields[i].Name = "f"
		fields[i].Type = types.TypInt64()
	}
	return fields
}

// bigAggTakeN is bigAggTake with Big made of nFields int64s.
func bigAggTakeN(name *[]readonly char, nFields int, nRes int) @ir.Func {
	var big @types.Type = types.MakeStructType("Big", int64Fields(nFields))
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].ID = 1
	params[0].Name = "x"
	params[0].Typ = big
	var res @[]@types.Type = make_slice(@types.Type, nRes)
	for i := 0; i < nRes; i++ { res[i] = types.TypInt64() }
	var f @ir.Func = ir.NewFunc("", "main.Take", params, res)
	if nRes > 1 { f.MultiReturnType = types.MakeStructType("", int64Fields(nRes)) }
	var blk @ir.Block = ir.AddBlock(f, "entry")
	var rets @[]@ir.Instr = make_slice(@ir.Instr, nRes)
	for i := 0; i < nRes; i++ { rets[i] = irbuild.EmitConstInt(blk, 0, types.TypInt64()) }
	irbuild.EmitReturn(blk, rets)
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr(name))
	f.CExportNames = names
	return f
}

// A #[c_export] function whose only aggregate is a >16-byte by-value param needs no
// adapter on SysV-AMD64 — the C ABI and the internal convention both pass it MEMORY
// class — so its export alias sits AT the mangled entry: no trampoline, no prefix.
func TestEmitFuncCExportBigAggNoTrampoline() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitFunc(a, "main", bigAggTake("ffi_big", 1), nilStrings())
	var mangledIdx int = a.LookupSymbol(symFor("main", "main.Take"))
	var aliasIdx int = a.LookupSymbol(symPrefixed("ffi_big"))
	if mangledIdx < 0 || aliasIdx < 0 {
		return fail("big-agg c_export: alias or mangled symbol missing")
	}
	if a.Symbols[aliasIdx].Offset != a.Symbols[mangledIdx].Offset {
		return fail("big-agg c_export needs no trampoline: the alias must be the mangled entry")
	}
	return ""
}

// When the same function returns a three-int64 tuple (sret in C, registers
// internally), the export gets the call-based adapter TRAMPOLINE, which passes the
// >16-byte param on as it arrived: its three words are copied from the incoming C
// stack ([RBP+disp], `48 8B 45`) to `sym`'s outgoing stack.  A byte-exact check would
// be brittle, so pin the shape: the alias precedes the mangled entry, the trampoline
// ends in RET (0xC3), and it loads at least three words off the incoming stack.
// End-to-end correctness is covered by e2e/ffi-export.sh under Rosetta/qemu.
func TestEmitFuncCExportBigAggRetAdaptTrampoline() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitFunc(a, "main", bigAggTake("ffi_big3", 3), nilStrings())
	var mangledIdx int = a.LookupSymbol(symFor("main", "main.Take"))
	var aliasIdx int = a.LookupSymbol(symPrefixed("ffi_big3"))
	if mangledIdx < 0 || aliasIdx < 0 {
		return fail("big-agg c_export: alias or mangled symbol missing")
	}
	var aliasOff int = cast(int, a.Symbols[aliasIdx].Offset)
	var mangledOff int = cast(int, a.Symbols[mangledIdx].Offset)
	if aliasOff >= mangledOff {
		return fail("the return-adapting c_export trampoline must precede the mangled entry")
	}
	// The trampoline ends in RET, then NOP padding (no 0xC3 byte) up to the
	// 16-aligned mangled entry.
	var gd @[]uint8 = a.Sections[0].Data
	var end int = mangledOff
	for end > aliasOff && gd[end - 1] != cast(uint8, 0xC3) {
		end = end - 1
	}
	if end == aliasOff || mangledOff - end >= X64_FUNC_ALIGN {
		return fail("the c_export trampoline must end in RET (a call-based adapter)")
	}
	var stackLoads int = 0
	for off := aliasOff; off + 2 < end; off++ {
		if gd[off] == cast(uint8, 0x48) && gd[off + 1] == cast(uint8, 0x8B) &&
				gd[off + 2] == cast(uint8, 0x45) {
			stackLoads++
		}
	}
	if stackLoads < 3 {
		return fail("the trampoline must copy the 24-byte param's words off the incoming C stack")
	}
	return ""
}

// The same trampoline copies a large param (forty int64s) off the incoming C stack with
// a loop, not word by word: a MOVUPS load into XMM14 indexed by RAX off RBP (44 0F 10,
// ModR/M 74 or B4, SIB 05), and fewer word loads off RBP than the param has words.
func TestEmitFuncCExportHugeAggTrampolineLoops() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitFunc(a, "main", bigAggTakeN("ffi_huge3", 40, 3), nilStrings())
	var mangledIdx int = a.LookupSymbol(symFor("main", "main.Take"))
	var aliasIdx int = a.LookupSymbol(symPrefixed("ffi_huge3"))
	if mangledIdx < 0 || aliasIdx < 0 {
		return fail("huge-agg c_export: alias or mangled symbol missing")
	}
	var aliasOff int = cast(int, a.Symbols[aliasIdx].Offset)
	var mangledOff int = cast(int, a.Symbols[mangledIdx].Offset)
	if aliasOff >= mangledOff { return fail("the huge-agg c_export must get the adapter trampoline") }
	var gd @[]uint8 = a.Sections[0].Data
	var loopLoads int = 0
	var wordLoads int = 0
	for off := aliasOff; off + 4 < mangledOff; off++ {
		if gd[off] == cast(uint8, 0x44) && gd[off + 1] == cast(uint8, 0x0F) &&
				gd[off + 2] == cast(uint8, 0x10) &&
				(gd[off + 3] == cast(uint8, 0x74) || gd[off + 3] == cast(uint8, 0xB4)) &&
				gd[off + 4] == cast(uint8, 0x05) {
			loopLoads++
		}
		if gd[off] == cast(uint8, 0x48) && gd[off + 1] == cast(uint8, 0x8B) &&
				(gd[off + 2] == cast(uint8, 0x45) || gd[off + 2] == cast(uint8, 0x85)) {
			wordLoads++
		}
	}
	if loopLoads == 0 || wordLoads >= 40 {
		return fail("the trampoline must copy the 320-byte param with a loop")
	}
	return ""
}

// A #[c_export] function returning a three-int64 tuple (sret in C, registers
// internally — the C side's sret pointer takes RDI, so the C GP cursor runs one
// ahead) with four int64s, a 2-eightbyte GP struct and then a MIXED {i64,f64}
// aggregate reproduces the SysV straddle: the GP struct lands C-memory yet
// internal-register, filling the internal GP file while one C register is left, so
// the mixed aggregate is register-class in C (its i64 in a GP reg, its f64 in XMM)
// but memory-class internally.  The trampoline must read the f64 eightbyte from XMM
// and store it into the internal memory slot; reading every eightbyte from GP
// scratch would drop the XMM half.  Pin it structurally: the trampoline emits a
// MOVLPS store (0F 13) of the SSE eightbyte from an XMM register; the all-GP form
// emits no XMM instruction at all.
func TestEmitCExportMixedSseStraddleTrampolineX64() testing.TestResult {
	// ARCH_X64 is what gates the SysV SSE-aggregate split (SysVSseInRegs →
	// cc.SseAggregates); setTarget64 alone leaves Arch unset.
	var tgt types.TargetInfo
	tgt.PointerSize = 8
	tgt.IntSize = 8
	tgt.MaxAlign = 8
	tgt.Arch = types.ARCH_X64
	types.SetTarget(tgt)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var ggFields @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		ggFields[i] = make(types.Field)
		ggFields[i].Name = "g"
		ggFields[i].Type = types.TypInt64()
	}
	var gg @types.Type = types.MakeStructType("FfiGG", ggFields) // 16B, 2 GP eightbytes
	var mixFields @[]@types.Field = make_slice(@types.Field, 2)
	mixFields[0] = make(types.Field)
	mixFields[0].Name = "i"
	mixFields[0].Type = types.TypInt64()
	mixFields[1] = make(types.Field)
	mixFields[1].Name = "f"
	mixFields[1].Type = types.TypFloat64()
	var mix @types.Type = types.MakeStructType("FfiMix", mixFields) // 16B mixed {i64,f64}
	// params: 4x int64, gg, mix.
	var params @[]@ir.Param = make_slice(@ir.Param, 6)
	for i := 0; i < 4; i++ {
		params[i] = make(ir.Param)
		params[i].ID = cast(int, i) + 1
		params[i].Name = "n"
		params[i].Typ = types.TypInt64()
	}
	params[4] = make(ir.Param)
	params[4].ID = 5
	params[4].Name = "gg"
	params[4].Typ = gg
	params[5] = make(ir.Param)
	params[5].ID = 6
	params[5].Name = "mix"
	params[5].Typ = mix
	var tupFields @[]@types.Field = make_slice(@types.Field, 3)
	var results @[]@types.Type = make_slice(@types.Type, 3)
	for i := 0; i < 3; i++ {
		tupFields[i] = make(types.Field)
		tupFields[i].Type = types.TypInt64()
		results[i] = types.TypInt64()
	}
	var f @ir.Func = ir.NewFunc("", "main.BigMix", params, results)
	f.MultiReturnType = types.MakeStructType("", tupFields)
	var blk @ir.Block = ir.AddBlock(f, "entry")
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 3)
	for i := 0; i < 3; i++ { rets[i] = irbuild.EmitConstInt(blk, 0, types.TypInt64()) }
	irbuild.EmitReturn(blk, rets)
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr("ffi_bigmix"))
	f.CExportNames = names
	emitFunc(a, "main", f, nilStrings())

	var aliasIdx int = a.LookupSymbol(symPrefixed("ffi_bigmix"))
	var mangledIdx int = a.LookupSymbol(symFor("main", "main.BigMix"))
	if aliasIdx < 0 || mangledIdx < 0 {
		return fail("mixed-SSE straddle: alias or mangled symbol missing")
	}
	var aliasOff int = cast(int, a.Symbols[aliasIdx].Offset)
	var mangledOff int = cast(int, a.Symbols[mangledIdx].Offset)
	var gd @[]uint8 = a.Sections[0].Data
	// Scan the trampoline body [aliasOff, mangledOff) for a MOVLPS store (0F 13):
	// the SSE eightbyte moved out of XMM.  The GP-only form never emits it.
	var foundMovlps bool = false
	for off := aliasOff; off + 1 < mangledOff; off++ {
		if gd[off] == cast(uint8, 0x0F) && gd[off + 1] == cast(uint8, 0x13) {
			foundMovlps = true
			break
		}
	}
	if !foundMovlps {
		return fail(
				"mixed-SSE straddle trampoline must move the f64 eightbyte from XMM "
						"(MOVLPS 0F 13); the all-GP form drops it")
	}
	return ""
}
