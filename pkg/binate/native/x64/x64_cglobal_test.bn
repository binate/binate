package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit test for the x64 OP_C_GLOBAL lowering (x64_dispatch.bn, plan §5b).
// __c_global yields the ADDRESS of an external C global as a raw *T.  x64
// native is a PIE link (both ELF-linux and Mach-O-darwin), so the address is
// reached GOT-indirect against the VERBATIM external symbol via
// `mov rd, [rip + sym@GOTPCREL]` — REX.W + 0x8B + ModRM + rel32 (7 bytes).
// Helpers (dispatchMkAsm) live in x64_dispatch_test.bn; fail() in x64_test.bn.
func TestCGlobalEmitsGotLoad() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_C_GLOBAL
	ins.StrVal = "environ"
	// Result is *T (raw pointer); TypeArg is the pointee T.
	ins.TypeArg = types.MakePointerType(types.TypUint8())
	ins.Typ = types.MakePointerType(ins.TypeArg)
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	if a.HasError {
		return fail("__c_global must not error on x64 (GOT addressing)")
	}
	var s @asm.Section = a.Sections[0]
	// mov r64, [rip + disp32] = REX.W + 0x8B + ModRM + 4-byte disp = 7 bytes.
	if s.Len != 7 {
		return fail("__c_global address is a 7-byte RIP-relative GOT load")
	}
	// Load-bearing (the indirection footgun): byte 1 must be MOV (0x8B, a load
	// through the GOT slot), NOT LEA (0x8D) — a LEA would leave the slot's own
	// address in the register instead of the symbol's address.
	if s.Data[1] != cast(uint8, 0x8B) {
		return fail("__c_global must emit MOV (0x8B, a GOT load), not LEA")
	}
	// The verbatim external symbol carries no Binate `bn_` mangling.  (The x64
	// unit-test default is the ELF/bare prefix, so the name stays `environ`.)
	var si int = a.LookupSymbol("environ")
	if si < 0 {
		return fail("__c_global must register the verbatim external symbol environ")
	}
	// It must be an UNDEFINED external (Section == -1) so the linker binds it to
	// libc's real `environ` via a GOT slot — not a bogus local definition.
	if a.Symbols[si].Section != -1 {
		return fail(
				"__c_global must register environ as an UNDEFINED external "
						"(Section == -1), not a local definition")
	}
	// The fixup must be FIX_GOTPCREL — a plain FIX_REL32/REL32_LEA would
	// reference the datum directly, which a PIE link rejects for cross-DSO data.
	if s.NumFixups != 1 {
		return fail("__c_global emits exactly one GOT fixup")
	}
	if s.Fixups[0].Kind != x64.FIX_GOTPCREL {
		return fail("__c_global fixup must be FIX_GOTPCREL")
	}
	return ""
}
