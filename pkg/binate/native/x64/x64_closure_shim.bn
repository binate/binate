package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Native x64 emission for the per-(literal, capture-shape) shim
// that backs a capturing function literal (B.2 of plan-function-
// values-phase-2.md).  Split from x64_funcvalue.bn to keep that
// file under the hygiene soft length cap.
//
// SysV ABI: integer arg registers are RDI, RSI, RDX, RCX, R8, R9
// in that order — that's what argReg(0..5) returns.
//
// Closure shim shape — scalar / void return.  A SINGLE aggregate return
// (struct/array) routes to emitClosureShimAggregate_x64 in
// x64_closure_shim_aggregate.bn (the pack / sret retbuf shapes); the two
// paths below handle the scalar / void shape:
//
//   * Fast path — when every capture and every user-arg lands in a
//     GP arg register at the underlying body's calling convention:
//         shim:
//           <shift user args argReg(1..M) up to argReg(W..W+M-1)>
//           <load capture words argReg(W-1)..argReg(1) from [RDI+ofs]>
//           <load argReg(0) (= RDI) from [RDI + off_0]>
//           JMP underlying_fn
//     W is the total capture register-word count.  The user-arg
//     shift is right-to-left and the capture loads are right-to-
//     left so RDI stays valid as the closure-struct base until
//     the final load.
//
//     The "shift user args" step is 1:1 (one incoming dispatch word ->
//     one outgoing word) for scalars / pointers / indirect-large
//     aggregates, but a by-address aggregate — a coerced in-register
//     struct/array (common.AggCoercedInReg), OR (option B) a raw slice /
//     iface-value (isByAddressAggX64) — DIVERGES: it arrives as ONE
//     by-address dispatch pointer word yet the underlying's real ABI reads
//     common.ArgWords value-words, so the shim copies the pointer to a
//     scratch (R11) and LOADS those words into the consecutive outgoing
//     value registers — see emitClosureShimFast_x64 (and the same
//     by-address expansion in step 2 of the stack-spill path).
//
//   * Stack-spill path — when ANY arg classifies as MEMORY under
//     SysV (aggregate > AggregateInRegMax = 16 bytes, including a
//     managed-slice `@[]T` at 32 bytes).  The body's prologue
//     reads those args from the outgoing-args stack area, so the
//     shim must reserve that area, write the words, then CALL
//     rather than JMP (since the stack frame must be undone
//     before RET):
//         shim:
//           SUB RSP, stkBytes + 8        ; +8 compensates for the
//                                        ; return-address push so
//                                        ; the outgoing CALL sees
//                                        ; a 16-byte-aligned RSP.
//           <spill stack-bound captures: [RDI+ofs] → RAX → [RSP+sof]>
//           <move user-args incoming → outgoing positions>
//           <load reg-bound captures: [RDI+ofs] → argReg(rs)>
//           CALL underlying_fn
//           ADD RSP, stkBytes + 8
//           RET
//     Ordering rationale: step 1 (stack-spill) uses RDI as the
//     read base, so it must finish before step 2 / 3 can touch
//     RDI; step 2 (user-arg moves) uses RSI..R9 as sources, so it
//     must finish before step 3 (which might overwrite those regs
//     with reg-captures); step 3 (reg-captures) goes right-to-
//     left so the final iteration's write into RDI happens last.

// lookupClosureFunc_x64 returns the Func with the given name iff
// it is a capturing-literal closure (IsClosure=true).  Returns nil
// for non-closure refs and for cross-module references.
func lookupClosureFunc_x64(mod @ir.Module, name @[]char) @ir.Func {
	for i := 0; i < len(mod.Funcs); i++ {
		if !charsEq_closureshim_x64(mod.Funcs[i].Name, name) {
			continue
		}
		if !mod.Funcs[i].IsClosure { return nil }
		return mod.Funcs[i]
	}
	return nil
}

// charsEq_closureshim_x64 is a local byte-compare for char slices.
// Distinct name from sibling files' charEq* helpers to avoid
// duplicate-symbol issues within pkg/binate/native/x64.
func charsEq_closureshim_x64(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// emitClosureShim_x64 emits the per-(literal, capture-shape) shim
// for a capturing closure.  Caller has already emitted the label
// and SetWeak; this writes the shim body.  Picks fast-path or
// stack-spill path based on whether any arg classifies as MEMORY
// under SysV-AMD64.
//
// Constraints (apply to both paths):
//   - scalar / void return only (return size ≤ 8 bytes)
//   - all user-args fit in incoming GP arg regs (RSI..R9, i.e.
//     ≤ 5 user-arg words after the data-slot RDI) — multi-word
//     INCOMING user-args via the stack aren't handled yet.
//
// Anything outside these constraints falls back to a plain JMP
// to the underlying.  Behavior is wrong, but the assembler
// doesn't blow up.
func emitClosureShim_x64(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type, f @ir.Func) {
	// A SINGLE aggregate return (struct/array) rides the retbuf-in-RDI
	// caller convention, which the scalar paths below don't implement;
	// route it to the aggregate shim emitter (x64_closure_shim_aggregate.bn).
	// Multi-return tuples stay here (shimReturnIsAggregate_x64 is false
	// for them).
	if shimReturnIsAggregate_x64(fvTyp) {
		if closureHasFloatParts_x64(fvTyp, f) {
			// Float captures/params combined with the retbuf/sret aggregate-
			// return convention — the float-aware aggregate shim (single
			// aggregate: multiRetTuple nil).
			emitClosureShimFloatAggregate_x64(a, fnLabel, fvTyp, f, shimReturnSize_x64(fvTyp), nil)
			return
		}
		emitClosureShimAggregate_x64(a, fnLabel, fvTyp, f, shimReturnSize_x64(fvTyp), nil)
		return
	}
	if len(fvTyp.Results) > 1 {
		// Multi-return closure.  Under retbuf-for-any-multi-return the caller
		// passes a retbuf for EVERY multi-return, so this rides the aggregate
		// shim's retbuf-in-RDI convention (NOT the field-per-register scalar tail
		// path — the caller no longer collects from return regs).  A BIG tuple
		// (isBigMultiReturn_x64) reuses the sret shape (retSz > 16 => retbuf in
		// RDI as the sret slot); a SMALL tuple reuses the pack shape but stores
		// the callee's field-per-register return THROUGH retbuf via the field-
		// per-class helper.
		if closureHasFloatParts_x64(fvTyp, f) {
			// Float captures/params/result: a BIG float multi-return via sret is
			// not handled (fail-loud); a SMALL one rides the float aggregate shim's
			// pack path with the field-per-class store (float fields in XMM0..).
			if isBigMultiReturn_x64(fvTyp) {
				a.SetError(
						"native x64: float-containing closure with a big "
								"multi-return result is not yet handled")
				return
			}
			emitClosureShimFloatAggregate_x64(a, fnLabel, fvTyp, f, multiReturnTupleSize_x64(fvTyp),
					funcValMultiReturnTuple_x64(fvTyp))
			return
		}
		emitClosureShimMultiRet_x64(a, fnLabel, fvTyp, f)
		return
	}
	// A float-scalar capture / param / return needs FP-register marshalling;
	// the GP-only fast / stack-spill paths below would mis-place it.  See
	// x64_closure_shim_float.bn.
	if closureHasFloatParts_x64(fvTyp, f) {
		emitClosureShimFloat_x64(a, fnLabel, fvTyp, f)
		return
	}
	var cc common.CallConv = common.SysV_AMD64()
	var argTypes @[]@types.Type = buildShimArgTypes_x64(fvTyp, f)
	var nUserWords int = userWords_x64(cc, fvTyp)
	if !shimNeedsStackSpill_x64(cc, argTypes) {
		emitClosureShimFast_x64(a, fnLabel, fvTyp, f, nUserWords)
		return
	}
	emitClosureShimStackSpill_x64(a, fnLabel, fvTyp, f, cc, argTypes, nUserWords)
}

// emitClosureShimMultiRet_x64 emits the multi-return closure shim (retbuf-for-any-
// multi-return convention).  A BIG tuple (isBigMultiReturn_x64) rides the sret
// shape — retbuf stays in RDI as the SysV sret slot, the callee writes through it
// (multiRetTuple nil: no store-through-retbuf).  A SMALL tuple rides the pack
// shape — the callee returns it field-per-register (RAX,RDX,RCX / XMM0,XMM1),
// which the shim stores THROUGH retbuf via the field-per-class helper
// (multiRetTuple = the tuple type selects that store).  Reuses
// emitClosureShimAggregate_x64's frame + capture/arg marshalling; float-
// containing multi-return closures route to emitClosureShimFloatAggregate_x64
// upstream (emitClosureShim_x64).
func emitClosureShimMultiRet_x64(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type, f @ir.Func) {
	if isBigMultiReturn_x64(fvTyp) {
		emitClosureShimAggregate_x64(a, fnLabel, fvTyp, f, multiReturnTupleSize_x64(fvTyp), nil)
		return
	}
	// Small tuple: pack shape with the field-per-class store.  retSz is the
	// tuple's SizeOf (the field store, not retSz, drives which registers are
	// read).
	emitClosureShimAggregate_x64(a, fnLabel, fvTyp, f, multiReturnTupleSize_x64(fvTyp),
			funcValMultiReturnTuple_x64(fvTyp))
}

// buildShimArgTypes_x64 returns the type list for the OUTGOING call
// the shim performs: captures first (in ClosureStruct field order),
// then user-args.  Same shape the CallConv classifier expects for a
// normal direct call.
func buildShimArgTypes_x64(fvTyp @types.Type, f @ir.Func) @[]@types.Type {
	var argTypes @[]@types.Type
	for i := 0; i < f.NumCaptureParams; i++ {
		argTypes = slices.Append[@types.Type](argTypes, f.ClosureStruct.Fields[i].Type)
	}
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		argTypes = slices.Append[@types.Type](argTypes, fvTyp.Params[pi].Type)
	}
	return argTypes
}

// shimNeedsStackSpill_x64 reports whether any arg in the outgoing
// call ends up entirely on the stack (CallArgStackOff >= 0).  If
// none do, the simpler fast path (register-only + JMP) suffices.
func shimNeedsStackSpill_x64(cc common.CallConv, argTypes @[]@types.Type) bool {
	for i := 0; i < len(argTypes); i++ {
		if cc.CallArgStackOff(argTypes, i) >= 0 { return true }
	}
	return false
}

// isIndirectLargeCap_x64 reports whether a capture-type is passed
// via the IndirectLargeAggregates convention (a single pointer in
// 1 reg / 1 stack word) at the underlying body's call boundary.
// Mirrors the classifier path in
// pkg/binate/native/common/common_callconv.bn's
// argRegWordsStackWords for the indirect-large branch.
func isIndirectLargeCap_x64(cc common.CallConv, t @types.Type) bool {
	return cc.IndirectLargeAggregates && common.IsAggregateTyp(t) && t.SizeOf() > cc.AggregateInRegMax
}

// effectiveCapWords_x64 returns the number of GP arg-reg slots a
// capture consumes at the underlying body's call boundary — 1 for
// indirect-large aggregates (pointer-pass), ArgWords for the rest.
func effectiveCapWords_x64(cc common.CallConv, t @types.Type) int {
	if isIndirectLargeCap_x64(cc, t) { return 1 }
	return common.ArgWords(t)
}

// userWords_x64 sums the INCOMING GP dispatch-word footprint of a closure's
// user params — the count the shims use to locate incoming-arg positions
// (argReg(1 + inIdx) / the caller stack).  shimInWordsForTypeX64 (not ArgWords /
// EffectiveArgWords): a by-address user arg — an indirect-large aggregate, a
// coerced in-register named struct/array (AggCoercedInReg), OR (option B) a raw
// slice / iface-value — travels as a SINGLE pointer word in the dispatch
// convention (a slice's EffectiveArgWords is 2, but by-address it rides one
// incoming word).  For a by-address agg the OUTGOING (real-ABI) register footprint
// is larger (ArgWords value-words loaded from the pointer); the register/spill
// BUDGET keys on that wider count via outUserWords_x64, NOT on this incoming count.
func userWords_x64(cc common.CallConv, fvTyp @types.Type) int {
	var n int = 0
	for pi := 0; pi < len(fvTyp.Params); pi = pi + 1 {
		n = n + shimInWordsForTypeX64(cc, fvTyp.Params[pi].Type)
	}
	return n
}

// outUserWords_x64 sums the OUTGOING (real-ABI) GP word footprint of a
// closure's user params — the count the fast path's register budget must use.
// A by-address aggregate (a coerced in-register struct/array, OR — option B — a
// raw slice / iface-value) arrives as ONE by-address pointer word
// (shimInWordsForTypeX64 == 1) but the shim expands it into ArgWords value
// registers, so counting it via the incoming word count would undercount the
// outgoing register pressure and wrongly keep a wide call on the register-only
// path.  Every other arg (including an indirect-large aggregate, a pointer in and
// out) matches its EffectiveArgWords.
func outUserWords_x64(cc common.CallConv, fvTyp @types.Type) int {
	var n int = 0
	for pi := 0; pi < len(fvTyp.Params); pi = pi + 1 {
		var pt @types.Type = fvTyp.Params[pi].Type
		if isByAddressAggX64(cc, pt) {
			n = n + common.ArgWords(pt)
		} else {
			n = n + cc.EffectiveArgWords(pt)
		}
	}
	return n
}

// emitClosureShimFast_x64 is the register-only path: every outgoing
// arg lands in a GP arg register (no MEMORY classification).
// Indirect-large captures contribute 1 reg slot (a pointer to the
// closure-struct field, materialised via LEA); scalar / small-
// aggregate captures contribute their ArgWords reg slots.
func emitClosureShimFast_x64(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type, f @ir.Func,
		nUserWords int) {
	var cc common.CallConv = common.SysV_AMD64()
	var captureWords int = 0
	for i := 0; i < f.NumCaptureParams; i++ {
		captureWords = captureWords + effectiveCapWords_x64(cc, f.ClosureStruct.Fields[i].Type)
	}
	// Budget the JMP-fallback guard on the OUTGOING (real-ABI) word count:
	// a coerced in-register struct/array arrives as one dispatch pointer word
	// but expands into ArgWords coerced regs, so the register pressure is
	// outUserWords_x64, not nUserWords (the incoming count).
	var outUserWords int = outUserWords_x64(cc, fvTyp)
	if captureWords + outUserWords > 6 {
		a.SetGlobal(fnLabel)
		x64.Jmp(a, fnLabel)
		return
	}
	// Marshal user args from their INCOMING dispatch positions (argReg(1 +
	// inWord)) to their OUTGOING positions (argReg(captureWords + outWord)).
	// Pre-change the two cursors moved in lockstep (one word in == one word
	// out); a by-address aggregate (a coerced in-register struct/array, OR —
	// option B — a raw slice / iface-value) now DIVERGES them — it arrives as
	// ONE pointer word but the underlying's real ABI reads ArgWords value-words
	// — so the loop tracks the incoming (srcWord) and outgoing (outWord) cursors
	// separately.  Walk params right-to-left, decrementing both cursors, so a
	// forward shift (outgoing reg >= incoming reg, which holds since outgoing
	// never lags incoming AND captureWords >= 1 — a closure always captures at
	// least one variable) writes each high destination before a not-yet-read
	// lower source is touched.
	var srcWord int = nUserWords
	var outWord int = outUserWords
	for ui := len(fvTyp.Params) - 1; ui >= 0; ui = ui - 1 {
		var pt @types.Type = fvTyp.Params[ui].Type
		if isByAddressAggX64(cc, pt) {
			// By-address aggregate (coerced struct/array, OR — option B — a raw
			// slice / iface-value): arrives as ONE by-address pointer word; load
			// its ArgWords value-words into the consecutive outgoing value regs.
			// Copy the pointer to R11 (a scratch, not a SysV arg reg) first so the
			// loads can't clobber it before the last word is read.
			var n int = common.ArgWords(pt)
			srcWord = srcWord - 1
			outWord = outWord - n
			x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Reg(argReg(1 + srcWord), x64.SZ64))
			for k := 0; k < n; k = k + 1 {
				x64.Mov(a, x64.Reg(argReg(captureWords + outWord + k), x64.SZ64),
						x64.Mem(x64.R11, 8 * k, x64.SZ64))
			}
			continue
		}
		// Generic lockstep path: an indirect-large aggregate is 1 pointer word
		// (the dispatch caller placed it as one), NOT its ArgWords expansion; for
		// it and every scalar, incoming and outgoing word counts agree.
		var w int = shimInWordsForTypeX64(cc, pt)
		srcWord = srcWord - w
		outWord = outWord - w
		for k := w - 1; k >= 0; k = k - 1 {
			var srcReg int = argReg(1 + srcWord + k)
			var dstReg int = argReg(captureWords + outWord + k)
			if srcReg != dstReg {
				x64.Mov(a, x64.Reg(dstReg, x64.SZ64), x64.Reg(srcReg, x64.SZ64))
			}
		}
	}
	// Captures right-to-left so RDI (closure-struct base) stays
	// valid until the final emit.  The i=0 case may clobber RDI
	// (regStart 0 → LEA RDI, [RDI+ofs] or MOV RDI, [RDI+ofs0]);
	// placing it last keeps the base alive for earlier captures.
	var w int = captureWords
	for i := f.NumCaptureParams - 1; i >= 0; i = i - 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var baseOfs int = f.ClosureStruct.FieldOffset(i)
		if isIndirectLargeCap_x64(cc, ft) {
			w = w - 1
			// LEA argReg(w), [RDI + baseOfs] — pointer-pass.
			x64.Lea(a, x64.Reg(argReg(w), x64.SZ64), x64.Mem(x64.RDI, baseOfs, x64.SZ64))
			continue
		}
		var wordCount int = common.ArgWords(ft)
		for k := wordCount - 1; k >= 0; k = k - 1 {
			w = w - 1
			x64.Mov(a, x64.Reg(argReg(w), x64.SZ64), x64.Mem(x64.RDI, baseOfs + k * 8, x64.SZ64))
		}
	}
	a.SetGlobal(fnLabel)
	x64.Jmp(a, fnLabel)
}

// emitUserArgWordMove_x64 emits the single-word transfer for a
// user-arg word at slot k of the current user-arg, given the user-
// arg's incoming register base (inRegBase, accumulated by step 2's
// loop), the post-SUB stkBytes adjustment, and the outgoing reg /
// stack slot (one of outRegStart >= 0 OR outStkOff >= 0, never
// both — SPLIT user-args aren't reachable here).
//
// prefixRegs is how many GP regs precede the incoming user args (1 for
// the scalar/void shim where data rides RDI, so args start at RSI; 2 for
// the aggregate shim where retbuf+data ride RDI/RSI and args start at
// RDX).  The incoming source is the global word index
// `inIdx = inRegBase + k - 1` (0-based across all user-arg words):
// reg argReg(prefixRegs + inIdx) while it fits the (6 - prefixRegs)
// incoming arg regs, else the caller stack at
// [RSP + stkBytes + 16 + (inIdx - (6 - prefixRegs)) * 8].
// (RSP+stkBytes+8 is the return address; RSP+stkBytes+16 the first stack
// arg — both shims use rspDelta = stkBytes + 8.)
func emitUserArgWordMove_x64(a @asm.Assembler, inRegBase int, k int, prefixRegs int, stkBytes int,
		outRegStart int, outStkOff int) {
	var inIdx int = inRegBase + k - 1
	var nArgRegs int = 6 - prefixRegs
	var srcIsReg bool = inIdx < nArgRegs
	var srcReg int
	var srcStkOff int = 0
	if srcIsReg {
		srcReg = argReg(prefixRegs + inIdx)
	} else {
		srcStkOff = stkBytes + 16 + (inIdx - nArgRegs) * 8
	}
	if outRegStart >= 0 {
		var dstReg int = argReg(outRegStart + k)
		if srcIsReg {
			if srcReg != dstReg {
				x64.Mov(a, x64.Reg(dstReg, x64.SZ64), x64.Reg(srcReg, x64.SZ64))
			}
		} else {
			x64.Mov(a, x64.Reg(dstReg, x64.SZ64), x64.Mem(x64.RSP, srcStkOff, x64.SZ64))
		}
		return
	}
	if outStkOff >= 0 {
		if srcIsReg {
			x64.Mov(a, x64.Mem(x64.RSP, outStkOff + k * 8, x64.SZ64), x64.Reg(srcReg, x64.SZ64))
		} else {
			x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RSP, srcStkOff, x64.SZ64))
			x64.Mov(a, x64.Mem(x64.RSP, outStkOff + k * 8, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
		}
	}
}
