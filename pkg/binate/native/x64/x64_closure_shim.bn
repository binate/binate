package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Native x64 emission for the per-(literal, capture-shape) shim
// that backs a capturing function literal (B.2 of plan-function-
// values-phase-2.md).  Split from x64_funcvalue.bn to keep that
// file under the hygiene soft length cap.
//
// SysV ABI: integer arg registers are RDI, RSI, RDX, RCX, R8, R9
// in that order — that's what argReg(0..5) returns.
//
// Closure shim shape — scalar / void return.  A SINGLE aggregate return
// (struct/array) routes to emitClosureShimAggregate_x64 in
// x64_closure_shim_aggregate.bn (the pack / sret retbuf shapes); the two
// paths below handle the scalar / void shape:
//
//   * Fast path — when every capture and every user-arg lands in a
//     GP arg register at the underlying body's calling convention:
//         shim:
//           <shift user args argReg(1..M) up to argReg(W..W+M-1)>
//           <load capture words argReg(W-1)..argReg(1) from [RDI+ofs]>
//           <load argReg(0) (= RDI) from [RDI + off_0]>
//           JMP underlying_fn
//     W is the total capture register-word count.  The user-arg
//     shift is right-to-left and the capture loads are right-to-
//     left so RDI stays valid as the closure-struct base until
//     the final load.
//
//     The "shift user args" step is 1:1 (one incoming dispatch word ->
//     one outgoing word) for scalars / pointers / indirect-large
//     aggregates, but a coerced in-register struct/array
//     (common.AggCoercedInReg) DIVERGES: it arrives as ONE by-address
//     dispatch pointer word yet the underlying's coerced ABI reads
//     common.ArgWords value-words, so the shim copies the pointer to a
//     scratch (R11) and LOADS those words into the consecutive outgoing
//     coerced registers — see emitClosureShimFast_x64 (and the same
//     by-address expansion in step 2 of the stack-spill path).
//
//   * Stack-spill path — when ANY arg classifies as MEMORY under
//     SysV (aggregate > AggregateInRegMax = 16 bytes, including a
//     managed-slice `@[]T` at 32 bytes).  The body's prologue
//     reads those args from the outgoing-args stack area, so the
//     shim must reserve that area, write the words, then CALL
//     rather than JMP (since the stack frame must be undone
//     before RET):
//         shim:
//           SUB RSP, stkBytes + 8        ; +8 compensates for the
//                                        ; return-address push so
//                                        ; the outgoing CALL sees
//                                        ; a 16-byte-aligned RSP.
//           <spill stack-bound captures: [RDI+ofs] → RAX → [RSP+sof]>
//           <move user-args incoming → outgoing positions>
//           <load reg-bound captures: [RDI+ofs] → argReg(rs)>
//           CALL underlying_fn
//           ADD RSP, stkBytes + 8
//           RET
//     Ordering rationale: step 1 (stack-spill) uses RDI as the
//     read base, so it must finish before step 2 / 3 can touch
//     RDI; step 2 (user-arg moves) uses RSI..R9 as sources, so it
//     must finish before step 3 (which might overwrite those regs
//     with reg-captures); step 3 (reg-captures) goes right-to-
//     left so the final iteration's write into RDI happens last.

// lookupClosureFunc_x64 returns the Func with the given name iff
// it is a capturing-literal closure (IsClosure=true).  Returns nil
// for non-closure refs and for cross-module references.
func lookupClosureFunc_x64(mod @ir.Module, name @[]char) @ir.Func {
	for i := 0; i < len(mod.Funcs); i++ {
		if !charsEq_closureshim_x64(mod.Funcs[i].Name, name) {
			continue
		}
		if !mod.Funcs[i].IsClosure { return nil }
		return mod.Funcs[i]
	}
	return nil
}

// charsEq_closureshim_x64 is a local byte-compare for char slices.
// Distinct name from sibling files' charEq* helpers to avoid
// duplicate-symbol issues within pkg/binate/native/x64.
func charsEq_closureshim_x64(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// emitClosureShim_x64 emits the per-(literal, capture-shape) shim
// for a capturing closure.  Caller has already emitted the label
// and SetWeak; this writes the shim body.  Picks fast-path or
// stack-spill path based on whether any arg classifies as MEMORY
// under SysV-AMD64.
//
// Constraints (apply to both paths):
//   - scalar / void return only (return size ≤ 8 bytes)
//   - all user-args fit in incoming GP arg regs (RSI..R9, i.e.
//     ≤ 5 user-arg words after the data-slot RDI) — multi-word
//     INCOMING user-args via the stack aren't handled yet.
//
// Anything outside these constraints falls back to a plain JMP
// to the underlying.  Behavior is wrong, but the assembler
// doesn't blow up.
func emitClosureShim_x64(a @asm.Assembler, fnLabel @[]char,
		fvTyp @types.Type, f @ir.Func) {
	// A SINGLE aggregate return (struct/array) rides the retbuf-in-RDI
	// caller convention, which the scalar paths below don't implement;
	// route it to the aggregate shim emitter (x64_closure_shim_aggregate.bn).
	// Multi-return tuples stay here (shimReturnIsAggregate_x64 is false
	// for them).
	if shimReturnIsAggregate_x64(fvTyp) {
		if closureHasFloatParts_x64(fvTyp, f) {
			// Float captures/params combined with the retbuf/sret aggregate-
			// return convention — the float-aware aggregate shim.
			emitClosureShimFloatAggregate_x64(a, fnLabel, fvTyp, f,
				shimReturnSize_x64(fvTyp))
			return
		}
		emitClosureShimAggregate_x64(a, fnLabel, fvTyp, f,
			shimReturnSize_x64(fvTyp))
		return
	}
	if isBigMultiReturn_x64(fvTyp) {
		// A big multi-return tuple (> 16 B) is returned via the SysV
		// sret pointer in RDI, exactly like a single > 16 B aggregate —
		// reuse the aggregate shim's sret path (retSz > 16 => sret shape:
		// retbuf stays in RDI, captures load into RSI.., user args after).
		if closureHasFloatParts_x64(fvTyp, f) {
			a.SetError("native x64: float-containing closure with a big "
				"multi-return result is not yet handled")
			return
		}
		emitClosureShimAggregate_x64(a, fnLabel, fvTyp, f,
			multiReturnTupleSize_x64(fvTyp))
		return
	}
	// A float-scalar capture / param / return needs FP-register marshalling;
	// the GP-only fast / stack-spill paths below would mis-place it.  See
	// x64_closure_shim_float.bn.
	if closureHasFloatParts_x64(fvTyp, f) {
		emitClosureShimFloat_x64(a, fnLabel, fvTyp, f)
		return
	}
	var cc common.CallConv = common.SysV_AMD64()
	var argTypes @[]@types.Type = buildShimArgTypes_x64(fvTyp, f)
	var nUserWords int = userWords_x64(cc, fvTyp)
	if !shimNeedsStackSpill_x64(cc, argTypes) {
		emitClosureShimFast_x64(a, fnLabel, fvTyp, f, nUserWords)
		return
	}
	emitClosureShimStackSpill_x64(a, fnLabel, fvTyp, f, cc, argTypes,
		nUserWords)
}

// buildShimArgTypes_x64 returns the type list for the OUTGOING call
// the shim performs: captures first (in ClosureStruct field order),
// then user-args.  Same shape the CallConv classifier expects for a
// normal direct call.
func buildShimArgTypes_x64(fvTyp @types.Type,
		f @ir.Func) @[]@types.Type {
	var argTypes @[]@types.Type
	for i := 0; i < f.NumCaptureParams; i++ {
		argTypes = slices.Append[@types.Type](argTypes,
			f.ClosureStruct.Fields[i].Type)
	}
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		argTypes = slices.Append[@types.Type](argTypes,
			fvTyp.Params[pi].Type)
	}
	return argTypes
}

// shimNeedsStackSpill_x64 reports whether any arg in the outgoing
// call ends up entirely on the stack (CallArgStackOff >= 0).  If
// none do, the simpler fast path (register-only + JMP) suffices.
func shimNeedsStackSpill_x64(cc common.CallConv,
		argTypes @[]@types.Type) bool {
	for i := 0; i < len(argTypes); i++ {
		if cc.CallArgStackOff(argTypes, i) >= 0 { return true }
	}
	return false
}

// isIndirectLargeCap_x64 reports whether a capture-type is passed
// via the IndirectLargeAggregates convention (a single pointer in
// 1 reg / 1 stack word) at the underlying body's call boundary.
// Mirrors the classifier path in
// pkg/binate/native/common/common_callconv.bn's
// argRegWordsStackWords for the indirect-large branch.
func isIndirectLargeCap_x64(cc common.CallConv,
		t @types.Type) bool {
	return cc.IndirectLargeAggregates &&
		common.IsAggregateTyp(t) &&
		t.SizeOf() > cc.AggregateInRegMax
}

// effectiveCapWords_x64 returns the number of GP arg-reg slots a
// capture consumes at the underlying body's call boundary — 1 for
// indirect-large aggregates (pointer-pass), ArgWords for the rest.
func effectiveCapWords_x64(cc common.CallConv,
		t @types.Type) int {
	if isIndirectLargeCap_x64(cc, t) { return 1 }
	return common.ArgWords(t)
}

// userWords_x64 sums the INCOMING GP dispatch-word footprint of a closure's
// user params — the count the shims use to locate incoming-arg positions
// (argReg(1 + inIdx) / the caller stack).  EffectiveArgWords (not ArgWords):
// a by-address user arg — an indirect-large aggregate OR a coerced in-register
// named struct/array (AggCoercedInReg) — travels as a single pointer word in
// the dispatch convention.  For a coerced agg the OUTGOING (real-ABI) register
// footprint is larger (ArgWords value-words loaded from the pointer); the
// register/spill BUDGET keys on that wider count via outUserWords_x64, NOT on
// this incoming count.
func userWords_x64(cc common.CallConv, fvTyp @types.Type) int {
	var n int = 0
	for pi := 0; pi < len(fvTyp.Params); pi = pi + 1 {
		n = n + cc.EffectiveArgWords(fvTyp.Params[pi].Type)
	}
	return n
}

// outUserWords_x64 sums the OUTGOING (real-ABI) GP word footprint of a
// closure's user params — the count the fast path's register budget must use.
// A coerced in-register struct/array (AggCoercedInReg) arrives as ONE
// by-address pointer word (EffectiveArgWords == 1) but the shim expands it into
// ArgWords coerced registers, so counting it via EffectiveArgWords would
// undercount the outgoing register pressure and wrongly keep a wide call on the
// register-only path.  Every other arg (including an indirect-large aggregate,
// a pointer in and out) matches its EffectiveArgWords.
func outUserWords_x64(cc common.CallConv, fvTyp @types.Type) int {
	var n int = 0
	for pi := 0; pi < len(fvTyp.Params); pi = pi + 1 {
		var pt @types.Type = fvTyp.Params[pi].Type
		if common.AggCoercedInReg(pt) {
			n = n + common.ArgWords(pt)
		} else {
			n = n + cc.EffectiveArgWords(pt)
		}
	}
	return n
}

// emitClosureShimFast_x64 is the register-only path: every outgoing
// arg lands in a GP arg register (no MEMORY classification).
// Indirect-large captures contribute 1 reg slot (a pointer to the
// closure-struct field, materialised via LEA); scalar / small-
// aggregate captures contribute their ArgWords reg slots.
func emitClosureShimFast_x64(a @asm.Assembler, fnLabel @[]char,
		fvTyp @types.Type, f @ir.Func, nUserWords int) {
	var cc common.CallConv = common.SysV_AMD64()
	var captureWords int = 0
	for i := 0; i < f.NumCaptureParams; i++ {
		captureWords = captureWords +
			effectiveCapWords_x64(cc, f.ClosureStruct.Fields[i].Type)
	}
	// Budget the JMP-fallback guard on the OUTGOING (real-ABI) word count:
	// a coerced in-register struct/array arrives as one dispatch pointer word
	// but expands into ArgWords coerced regs, so the register pressure is
	// outUserWords_x64, not nUserWords (the incoming count).
	var outUserWords int = outUserWords_x64(cc, fvTyp)
	if captureWords + outUserWords > 6 {
		a.SetGlobal(fnLabel)
		x64.Jmp(a, fnLabel)
		return
	}
	// Marshal user args from their INCOMING dispatch positions (argReg(1 +
	// inWord)) to their OUTGOING positions (argReg(captureWords + outWord)).
	// Pre-change the two cursors moved in lockstep (one word in == one word
	// out); a coerced in-register struct/array now DIVERGES them — it arrives
	// as ONE pointer word but the underlying's coerced ABI reads ArgWords
	// value-words — so the loop tracks the incoming (srcWord) and outgoing
	// (outWord) cursors separately.  Walk params right-to-left, decrementing
	// both cursors, so a forward shift (outgoing reg >= incoming reg, which
	// holds since outgoing never lags incoming) writes each high destination
	// before a not-yet-read lower source is touched.
	var srcWord int = nUserWords
	var outWord int = outUserWords
	for ui := len(fvTyp.Params) - 1; ui >= 0; ui = ui - 1 {
		var pt @types.Type = fvTyp.Params[ui].Type
		if common.AggCoercedInReg(pt) {
			// Coerced in-register struct/array: arrives as ONE by-address
			// pointer word; load its ArgWords value-words into the consecutive
			// outgoing coerced regs.  Copy the pointer to R11 (a scratch, not a
			// SysV arg reg) first so the loads can't clobber it before the last
			// word is read.
			var n int = common.ArgWords(pt)
			srcWord = srcWord - 1
			outWord = outWord - n
			x64.Mov(a, x64.Reg(x64.R11, x64.SZ64),
				x64.Reg(argReg(1 + srcWord), x64.SZ64))
			for k := 0; k < n; k = k + 1 {
				x64.Mov(a, x64.Reg(argReg(captureWords + outWord + k),
					x64.SZ64), x64.Mem(x64.R11, 8 * k, x64.SZ64))
			}
			continue
		}
		// Effective words: an indirect-large aggregate is 1 pointer word (the
		// dispatch caller placed it as one), NOT its ArgWords expansion; for it
		// and every scalar, incoming and outgoing word counts agree.
		var w int = cc.EffectiveArgWords(pt)
		srcWord = srcWord - w
		outWord = outWord - w
		for k := w - 1; k >= 0; k = k - 1 {
			var srcReg int = argReg(1 + srcWord + k)
			var dstReg int = argReg(captureWords + outWord + k)
			if srcReg != dstReg {
				x64.Mov(a, x64.Reg(dstReg, x64.SZ64),
					x64.Reg(srcReg, x64.SZ64))
			}
		}
	}
	// Captures right-to-left so RDI (closure-struct base) stays
	// valid until the final emit.  The i=0 case may clobber RDI
	// (regStart 0 → LEA RDI, [RDI+ofs] or MOV RDI, [RDI+ofs0]);
	// placing it last keeps the base alive for earlier captures.
	var w int = captureWords
	for i := f.NumCaptureParams - 1; i >= 0; i = i - 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var baseOfs int = f.ClosureStruct.FieldOffset(i)
		if isIndirectLargeCap_x64(cc, ft) {
			w = w - 1
			// LEA argReg(w), [RDI + baseOfs] — pointer-pass.
			x64.Lea(a, x64.Reg(argReg(w), x64.SZ64),
				x64.Mem(x64.RDI, baseOfs, x64.SZ64))
			continue
		}
		var wordCount int = common.ArgWords(ft)
		for k := wordCount - 1; k >= 0; k = k - 1 {
			w = w - 1
			x64.Mov(a, x64.Reg(argReg(w), x64.SZ64),
				x64.Mem(x64.RDI, baseOfs + k * 8, x64.SZ64))
		}
	}
	a.SetGlobal(fnLabel)
	x64.Jmp(a, fnLabel)
}

// emitClosureShimStackSpill_x64 handles the SysV MEMORY case: one or
// more args (captures or user-args) classify as fully on the stack,
// so the shim must reserve outgoing-args stack space and write the
// words explicitly.  Switches the tail-jump to CALL + cleanup + RET
// so the stack rewind happens before returning to the caller.
func emitClosureShimStackSpill_x64(a @asm.Assembler, fnLabel @[]char,
		fvTyp @types.Type, f @ir.Func, cc common.CallConv,
		argTypes @[]@types.Type, nUserWords int) {
	var stkBytes int = cc.CallStackBytes(argTypes)
	// +8 compensates for the return-address push at shim entry —
	// at entry RSP is 8-byte aligned, and the outgoing CALL needs
	// it 16-byte aligned.  stkBytes is already rounded to
	// StackAlign (16) by CallStackBytes.
	var rspDelta int = stkBytes + 8
	x64.Sub(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(rspDelta))

	// Step 1: spill stack-bound captures.  Two cases:
	//   * Indirect-large capture overflowed to stack (regStart < 0,
	//     stackWords=1): LEA RAX, [RDI + fieldOfs]; MOV [RSP+stkOff],
	//     RAX — pointer-pass on the stack.
	//   * Per-word capture entirely on stack (SysV MEMORY for
	//     aggregates ≤ AggregateInRegMax that didn't fit, or scalar
	//     overflow): shuttle each word via RAX from [RDI+ofs] to
	//     [RSP+stkOff].
	// Done first so RDI is still the closure-struct base — step 2
	// (user-arg shift) and step 3's i=0 reg-capture may overwrite it.
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var regStart int = cc.CallArgRegStart(argTypes, i)
		var stkOff int = cc.CallArgStackOff(argTypes, i)
		var fieldOfs int = f.ClosureStruct.FieldOffset(i)
		if regStart >= 0 || stkOff < 0 { continue }
		if isIndirectLargeCap_x64(cc, ft) {
			// Indirect-large, stack-bound: pointer-pass.
			x64.Lea(a, x64.Reg(x64.RAX, x64.SZ64),
				x64.Mem(x64.RDI, fieldOfs, x64.SZ64))
			x64.Mov(a, x64.Mem(x64.RSP, stkOff, x64.SZ64),
				x64.Reg(x64.RAX, x64.SZ64))
			continue
		}
		var nWords int = common.ArgWords(ft)
		for k := 0; k < nWords; k = k + 1 {
			x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64),
				x64.Mem(x64.RDI, fieldOfs + k * 8, x64.SZ64))
			x64.Mov(a, x64.Mem(x64.RSP, stkOff + k * 8, x64.SZ64),
				x64.Reg(x64.RAX, x64.SZ64))
		}
	}

	// Step 2: move user-args from incoming positions to outgoing
	// positions per the CallConv.  Process right-to-left over
	// user-args so a forward shift (low → high reg) reads each
	// register source before its slot becomes a destination.
	//
	// Incoming layout: user-arg word with global word-index inIdx
	// (0..nUserWords-1) is in argReg(1 + inIdx) if inIdx < 5,
	// else on the CALLER's stack.  At shim entry RSP+0 is the
	// return address pushed by CALL, RSP+8 is the first stack
	// arg.  After step 0's `SUB rsp, #(stkBytes + 8)`, the
	// caller-stack first-arg address is at [RSP + stkBytes + 8
	// + 8] = [RSP + stkBytes + 16].  General form: word inIdx
	// (for inIdx >= 5) at [RSP + stkBytes + 16 + (inIdx - 5)*8].
	//
	// Four transfer shapes:
	//   * reg-source → reg-dest:   MOV  dstReg, srcReg
	//   * reg-source → stack-dest: MOV  [RSP, outStkOff], srcReg
	//   * stack-source → reg-dest: MOV  dstReg, [RSP, inStkOff]
	//   * stack-source → stack-dest: MOV RAX, [RSP, inStkOff]; MOV [RSP, outStkOff], RAX
	// RAX is safe here — step 1's shuttle uses have already
	// been consumed before this loop runs.
	var userArgStart int = f.NumCaptureParams
	var inRegBase int = 1 + nUserWords
	for ui := len(fvTyp.Params) - 1; ui >= 0; ui = ui - 1 {
		var ut @types.Type = fvTyp.Params[ui].Type
		var argIdx int = userArgStart + ui
		var outRegStart int = cc.CallArgRegStart(argTypes, argIdx)
		var outStkOff int = cc.CallArgStackOff(argTypes, argIdx)
		if common.AggCoercedInReg(ut) {
			// Coerced in-register struct/array: arrives as ONE by-address
			// pointer word (EffectiveArgWords == 1) but the underlying's coerced
			// ABI reads ArgWords value-words.  Materialize the incoming pointer
			// into R11 (a scratch, not a SysV arg reg, distinct from RAX which
			// the stack shuttle below uses), then fan its words out to the
			// outgoing register or (whole-aggregate-MEMORY) stack slots.  SysV
			// does not SPLIT, so the outgoing slot is reg-only or stack-only.
			inRegBase = inRegBase - 1
			emitLoadIncomingWord_x64(a, inRegBase, 0, 1, stkBytes, x64.R11)
			var n int = common.ArgWords(ut)
			for k := 0; k < n; k = k + 1 {
				if outRegStart >= 0 {
					x64.Mov(a, x64.Reg(argReg(outRegStart + k), x64.SZ64),
						x64.Mem(x64.R11, 8 * k, x64.SZ64))
				} else {
					x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64),
						x64.Mem(x64.R11, 8 * k, x64.SZ64))
					x64.Mov(a, x64.Mem(x64.RSP, outStkOff + k * 8, x64.SZ64),
						x64.Reg(x64.RAX, x64.SZ64))
				}
			}
			continue
		}
		// EffectiveArgWords (not ArgWords): an indirect-large aggregate user
		// arg travels as a single pointer word both in and out, so counting
		// its full ArgWords would over-read incoming regs and overwrite the
		// neighboring arg.  SysV does not SPLIT aggregates, so there is no
		// straddling-word case for user args here.
		var nUw int = cc.EffectiveArgWords(ut)
		inRegBase = inRegBase - nUw
		for k := nUw - 1; k >= 0; k = k - 1 {
			// Incoming prefix 1 (data in RDI; user args from RSI).
			emitUserArgWordMove_x64(a, inRegBase, k, 1, stkBytes,
				outRegStart, outStkOff)
		}
	}

	// Step 3: load register-passed captures.  For indirect-large
	// captures with regStart >= 0: LEA argReg(regStart),
	// [RDI + fieldOfs] — pointer-pass in a single reg.  For per-word
	// captures: MOV each word into argReg(regStart..regStart+nWords-1).
	// Iterate right-to-left so the i=0 case (which may write RDI
	// when regStart=0) runs last.
	for i := f.NumCaptureParams - 1; i >= 0; i = i - 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var regStart int = cc.CallArgRegStart(argTypes, i)
		var fieldOfs int = f.ClosureStruct.FieldOffset(i)
		if regStart < 0 { continue }
		if isIndirectLargeCap_x64(cc, ft) {
			x64.Lea(a, x64.Reg(argReg(regStart), x64.SZ64),
				x64.Mem(x64.RDI, fieldOfs, x64.SZ64))
			continue
		}
		var nWords int = common.ArgWords(ft)
		for k := nWords - 1; k >= 0; k = k - 1 {
			x64.Mov(a, x64.Reg(argReg(regStart + k), x64.SZ64),
				x64.Mem(x64.RDI, fieldOfs + k * 8, x64.SZ64))
		}
	}

	// Step 4: CALL underlying and rewind the stack.
	a.SetGlobal(fnLabel)
	x64.Call(a, fnLabel)
	x64.Add(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(rspDelta))
	x64.Ret(a)
}

// totalCaptureWords_x64 sums the SysV register-word footprint of
// each capture-type — scalars / pointers are 1, managed-slice is
// 4 (under SysV's pure-MEMORY classification), managed function-
// value is 2, etc.  Used by emitClosureShimFast_x64 to budget the
// register slots and compute the user-arg shift target index.
func totalCaptureWords_x64(f @ir.Func) int {
	var w int = 0
	for i := 0; i < f.NumCaptureParams; i++ {
		w = w + common.ArgWords(f.ClosureStruct.Fields[i].Type)
	}
	return w
}

// emitUserArgWordMove_x64 emits the single-word transfer for a
// user-arg word at slot k of the current user-arg, given the user-
// arg's incoming register base (inRegBase, accumulated by step 2's
// loop), the post-SUB stkBytes adjustment, and the outgoing reg /
// stack slot (one of outRegStart >= 0 OR outStkOff >= 0, never
// both — SPLIT user-args aren't reachable here).
//
// prefixRegs is how many GP regs precede the incoming user args (1 for
// the scalar/void shim where data rides RDI, so args start at RSI; 2 for
// the aggregate shim where retbuf+data ride RDI/RSI and args start at
// RDX).  The incoming source is the global word index
// `inIdx = inRegBase + k - 1` (0-based across all user-arg words):
// reg argReg(prefixRegs + inIdx) while it fits the (6 - prefixRegs)
// incoming arg regs, else the caller stack at
// [RSP + stkBytes + 16 + (inIdx - (6 - prefixRegs)) * 8].
// (RSP+stkBytes+8 is the return address; RSP+stkBytes+16 the first stack
// arg — both shims use rspDelta = stkBytes + 8.)
func emitUserArgWordMove_x64(a @asm.Assembler, inRegBase int,
		k int, prefixRegs int, stkBytes int, outRegStart int,
		outStkOff int) {
	var inIdx int = inRegBase + k - 1
	var nArgRegs int = 6 - prefixRegs
	var srcIsReg bool = inIdx < nArgRegs
	var srcReg int
	var srcStkOff int = 0
	if srcIsReg {
		srcReg = argReg(prefixRegs + inIdx)
	} else {
		srcStkOff = stkBytes + 16 + (inIdx - nArgRegs) * 8
	}
	if outRegStart >= 0 {
		var dstReg int = argReg(outRegStart + k)
		if srcIsReg {
			if srcReg != dstReg {
				x64.Mov(a, x64.Reg(dstReg, x64.SZ64),
					x64.Reg(srcReg, x64.SZ64))
			}
		} else {
			x64.Mov(a, x64.Reg(dstReg, x64.SZ64),
				x64.Mem(x64.RSP, srcStkOff, x64.SZ64))
		}
		return
	}
	if outStkOff >= 0 {
		if srcIsReg {
			x64.Mov(a,
				x64.Mem(x64.RSP, outStkOff + k * 8, x64.SZ64),
				x64.Reg(srcReg, x64.SZ64))
		} else {
			x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64),
				x64.Mem(x64.RSP, srcStkOff, x64.SZ64))
			x64.Mov(a,
				x64.Mem(x64.RSP, outStkOff + k * 8, x64.SZ64),
				x64.Reg(x64.RAX, x64.SZ64))
		}
	}
}

// emitLoadIncomingWord_x64 loads the incoming user-arg word at slot k of the
// current user-arg (global index `inIdx = inRegBase + k - 1`) into dstReg.  It
// is the incoming-source half of emitUserArgWordMove_x64 (same prefixRegs /
// stkBytes formula: reg argReg(prefixRegs + inIdx) while it fits the
// (6 - prefixRegs) incoming arg regs, else the caller stack at
// [RSP + stkBytes + 16 + (inIdx - (6 - prefixRegs)) * 8]).  Used to pull a
// coerced in-register aggregate's incoming by-address pointer into a scratch
// before fanning its value-words out to the underlying's coerced ABI slots.
func emitLoadIncomingWord_x64(a @asm.Assembler, inRegBase int,
		k int, prefixRegs int, stkBytes int, dstReg int) {
	var inIdx int = inRegBase + k - 1
	var nArgRegs int = 6 - prefixRegs
	if inIdx < nArgRegs {
		var srcReg int = argReg(prefixRegs + inIdx)
		if srcReg != dstReg {
			x64.Mov(a, x64.Reg(dstReg, x64.SZ64),
				x64.Reg(srcReg, x64.SZ64))
		}
		return
	}
	var srcStkOff int = stkBytes + 16 + (inIdx - nArgRegs) * 8
	x64.Mov(a, x64.Reg(dstReg, x64.SZ64),
		x64.Mem(x64.RSP, srcStkOff, x64.SZ64))
}
