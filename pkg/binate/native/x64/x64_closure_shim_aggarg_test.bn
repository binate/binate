package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A closure or function-value shim loads a by-value aggregate user argument -- passed
// to it by address, the caller's value, which may be read in place from its source --
// no further than its end: the second word of a 12-byte {int32 x3}, read through the
// pointer in R10 or R11, is a 4-byte MOV from [ptr + 8] (bytes 8..11), never an
// 8-byte one (bytes 8..15), in the closures' register-only, aggregate-return,
// stack-spill and float shims and the function values' marshal and spill shims; and
// so is the INTEGER eightbyte of an SSE-classified {float32, float32, int32}.

// s12Type_x64 returns a named 12-byte struct of three int32.
func s12Type_x64() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		var name @[]char = make_slice(char, 1)
		name[0] = cast(char, cast(int, 'a') + i)
		fields[i].Name = name
		fields[i].Type = types.TypInt32()
	}
	return types.MakeStructType("S12", fields)
}

// closureFor_x64 returns a closure with one int capture taking fv's user params and
// lifted to return fv's results.
func closureFor_x64(fv @types.Type) @ir.Func {
	var f @ir.Func = closureFuncSingleIntCapture_x64()
	var params @[]@ir.Param = make_slice(@ir.Param, 1 + len(fv.Params))
	params[0] = f.Params[0]
	for i := 0; i < len(fv.Params); i++ {
		params[1 + i] = irbuild.NewParam(f, "u", fv.Params[i].Type)
	}
	f.Params = params
	return liftedReturning_x64(f, fv)
}

// fvTaking_x64 builds @func(lead..., S12) returning ret: nInts ints, then a float64
// when withFloat, then the S12.
func fvTaking_x64(nInts int, withFloat bool, ret @types.Type) @types.Type {
	return fvTakingLast_x64(nInts, withFloat, s12Type_x64(), ret)
}

// fvTakingLast_x64 builds @func(lead..., last) returning ret: nInts ints, then a
// float64 when withFloat, then last.
func fvTakingLast_x64(nInts int, withFloat bool, last @types.Type, ret @types.Type) @types.Type {
	var n int = nInts + 1
	if withFloat { n = n + 1 }
	var params @[]@types.Param = make_slice(@types.Param, n)
	for i := 0; i < n; i++ {
		params[i] = make(types.Param)
		params[i].Name = "p"
		params[i].Type = types.TypInt()
	}
	if withFloat { params[nInts].Type = types.TypFloat64() }
	params[n - 1].Type = last
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = ret
	return types.MakeFuncValueType(params, results)
}

// funcValueShimFor_x64 emits the function-value shims of a function with fv's params
// and results into a fresh assembler.
func funcValueShimFor_x64(fv @types.Type) @asm.Assembler {
	var mod @ir.Module = ir.NewModule("\"main\"")
	var params @[]@ir.Param
	for i := 0; i < len(fv.Params); i++ {
		var p @ir.Param = make(ir.Param)
		p.Name = "x"
		p.Typ = fv.Params[i].Type
		params = appendIrParam_spilltest_x64(params, p)
	}
	var f @ir.Func = ir.NewFunc("", "f", params, fv.Results)
	f.IsLinkOnce = true
	mod.AddFunc(f)
	var a @asm.Assembler = opsMkAssembler()
	emitFuncValueShims(a, "main", mod)
	return a
}

// checkShim_x64 reports a's error, or whether it loads the 12-byte argument's second
// word past its end, or not at all.
func checkShim_x64(a @asm.Assembler, what *[]readonly char) testing.TestResult {
	if a.HasError { return fail(a.ErrorMsg) }
	if hasMovAt8_x64(a, true) {
		return fail(buf.Concat(what, ": loads bytes 8..15 of a 12-byte argument"))
	}
	if !hasMovAt8_x64(a, false) {
		return fail(buf.Concat(what, ": loads bytes 8..11 of a 12-byte argument"))
	}
	return ""
}

// hasCode_x64 reports whether a's code contains the code in want.
func hasCode_x64(a @asm.Assembler, want @asm.Assembler) bool {
	var n int = want.Sections[0].Len
	for i := 0; i + n <= a.Sections[0].Len; i++ {
		var j int = 0
		for j < n && a.Sections[0].Data[i + j] == want.Sections[0].Data[j] { j = j + 1 }
		if j == n { return true }
	}
	return false
}

// hasMovAt8_x64 reports whether a holds a MOV of 8 bytes (wide) or 4 into a register
// from [R10 + 8] or [R11 + 8]: REX (W when wide, B), 8B, ModRM mod 01 r/m 2 or 3, 08.
func hasMovAt8_x64(a @asm.Assembler, wide bool) bool {
	var d @[]uint8 = a.Sections[0].Data
	for i := 0; i + 4 <= a.Sections[0].Len; i++ {
		var rex uint8 = d[i]
		if (rex & 0xF1) != 0x41 || d[i + 1] != 0x8B || d[i + 3] != 0x08 { continue }
		if ((rex & 0x08) != 0) != wide { continue }
		var rm uint8 = d[i + 2] & 0xC7
		if rm == 0x42 || rm == 0x43 { return true }
	}
	return false
}

func TestClosureShimLoadsAggregateArgNoPastEndX64() testing.TestResult {
	var shapes @[]@types.Type = make_slice(@types.Type, 6)
	shapes[0] = fvTaking_x64(0, false, types.TypInt())
	shapes[1] = fvTaking_x64(0, false, structTypeNInt64_x64(3))
	shapes[2] = fvTaking_x64(5, false, types.TypInt())
	shapes[3] = fvTaking_x64(5, false, structTypeNInt64_x64(3))
	shapes[4] = fvTaking_x64(0, true, types.TypInt())
	shapes[5] = fvTaking_x64(5, true, types.TypInt())
	for i := 0; i < len(shapes); i++ {
		var a @asm.Assembler = opsMkAssembler()
		emitClosureShim_x64(a, "underlying_x64", shapes[i], closureFor_x64(shapes[i]))
		var r testing.TestResult = checkShim_x64(a, "a closure shim")
		if len(r) > 0 { return r }
		if i == 1 || i == 3 { continue }
		r = checkShim_x64(funcValueShimFor_x64(shapes[i]), "a function-value shim")
		if len(r) > 0 { return r }
	}
	// ARCH_X64 turns on SysV's SSE classification of aggregates (SysVSseInRegs).
	var saved types.TargetInfo = types.GetTarget()
	var tgt types.TargetInfo = saved
	tgt.Arch = types.ARCH_X64
	types.SetTarget(tgt)
	defer { types.SetTarget(saved) }
	var mix @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		mix[i] = make(types.Field)
		var name @[]char = make_slice(char, 1)
		name[0] = cast(char, cast(int, 'a') + i)
		mix[i].Name = name
		mix[i].Type = types.TypFloat32()
	}
	mix[2].Type = types.TypInt32()
	var mp @[]@types.Param = make_slice(@types.Param, 1)
	mp[0] = make(types.Param)
	mp[0].Name = "p"
	mp[0].Type = types.MakeStructType("SM", mix)
	var mr @[]@types.Type = make_slice(@types.Type, 1)
	mr[0] = types.TypInt()
	return checkShim_x64(funcValueShimFor_x64(types.MakeFuncValueType(mp, mr)),
			"a function-value shim of an SSE-classified struct")
}

// A by-value user argument of more than 128 bytes on the stack is copied by a loop of
// exactly its size -- whose counter starts at the size less 32 -- never of the size
// rounded up to whole words: a 132-byte {[33]int32} is copied as 132 bytes, not 136,
// by the closures' spill, aggregate-return and float shims and the function values'
// spill shim.
func TestShimCopiesLargeAggregateArgExactlyX64() testing.TestResult {
	var f @[]@types.Field = make_slice(@types.Field, 1)
	f[0] = make(types.Field)
	f[0].Name = "a"
	f[0].Type = types.MakeArrayType(types.TypInt32(), 33)
	var big @types.Type = types.MakeStructType("B132", f)
	var exact @asm.Assembler = opsMkAssembler()
	emitConstInt64(exact, x64.RAX, 100)
	var rounded @asm.Assembler = opsMkAssembler()
	emitConstInt64(rounded, x64.RAX, 104)
	var shims @[]@asm.Assembler = make_slice(@asm.Assembler, 4)
	var plain @types.Type = fvTakingLast_x64(0, false, big, types.TypInt())
	var retAgg @types.Type = fvTakingLast_x64(0, false, big, structTypeNInt64_x64(3))
	var withF @types.Type = fvTakingLast_x64(0, true, big, types.TypInt())
	shims[0] = opsMkAssembler()
	emitClosureShim_x64(shims[0], "underlying_x64", plain, closureFor_x64(plain))
	shims[1] = opsMkAssembler()
	emitClosureShim_x64(shims[1], "underlying_x64", retAgg, closureFor_x64(retAgg))
	shims[2] = opsMkAssembler()
	emitClosureShim_x64(shims[2], "underlying_x64", withF, closureFor_x64(withF))
	shims[3] = funcValueShimFor_x64(plain)
	for i := 0; i < len(shims); i++ {
		if shims[i].HasError { return fail(shims[i].ErrorMsg) }
		if hasCode_x64(shims[i], rounded) || !hasCode_x64(shims[i], exact) {
			return fail("a shim copies a 132-byte argument as exactly 132 bytes")
		}
	}
	return ""
}
