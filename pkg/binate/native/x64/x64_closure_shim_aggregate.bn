package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Native x86-64 (SysV) emission for the aggregate-return path of a
// capturing closure shim.  The sibling of
// pkg/binate/native/aarch64/aarch64_closure_shim_aggregate.bn; split from
// x64_closure_shim.bn (the scalar / void path) to stay under the hygiene
// file-length cap.
//
// A capturing closure whose function-value type returns a SINGLE
// aggregate result rides the same retbuf-in-RDI caller convention the
// non-capturing shim (emitFuncValueShims) and emitCallFuncValue use:
//
//     RDI = retbuf   (address of the caller's result buffer)
//     RSI = data     (the closure-struct pointer)
//     RDX.. = user args
//
// The scalar closure shim cannot serve this: it expects data in RDI and
// user args in RSI.., and never threads retbuf into the lifted body's
// result location.  Two aggregate shapes, mirroring emitFuncValueShims:
//
//   * Pack-return (retSz 1..16): the lifted body returns the aggregate
//     packed in RAX (+RDX); no sret arg, so captures occupy argReg(0..)
//     (RDI..) — capBaseSlot 0.  Frame up, stash retbuf, set up the
//     underlying args, CALL, then copy RAX (+RDX) back through retbuf.
//   * Sret-return (retSz > 16): the lifted body takes a hidden SysV sret
//     pointer in RDI.  retbuf is ALREADY in RDI, so it stays put; captures
//     occupy argReg(1..) (RSI..) — capBaseSlot 1 — and the user-arg shift
//     accounts for the consumed RDI slot.  Tail-jump (RDI preserved).
//
// Multi-return tuples stay on the scalar path (shimReturnIsAggregate_x64
// is false for them).

// emitClosureShimAggregate_x64 emits the aggregate-return closure shim.
// retSz is the single result's SizeOf (> 0; shimReturnIsAggregate_x64
// already gated this path).  When the underlying call's args (the sret
// slot for sret, plus captures + user words) all fit RDI..R9 AND the
// incoming user args fit RDX..R9, the fast register-only body below runs;
// otherwise the work routes to emitClosureShimAggregateStackSpill_x64,
// which reserves an outgoing-args stack area and spills the overflow.
func emitClosureShimAggregate_x64(a @asm.Assembler, fnLabel @[]char,
		fvTyp @types.Type, f @ir.Func, retSz int) {
	var cc common.CallConv = common.SysV_AMD64()
	var captureWords int = 0
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		captureWords = captureWords +
			effectiveCapWords_x64(cc, f.ClosureStruct.Fields[i].Type)
	}
	var nUserWords int = userWords_x64(cc, fvTyp)
	// Outgoing (real-ABI) user-word count: a coerced in-register struct/array
	// arrives as ONE by-address pointer word (EffectiveArgWords == 1, counted by
	// nUserWords) but the shim expands it into ArgWords coerced regs, so the
	// total-register budget must count the OUTGOING words — counting it via
	// EffectiveArgWords would undercount the outgoing register pressure and
	// wrongly keep a wide call on the register-only path.
	var outUserWords int = outgoingUserWords_x64(cc, fvTyp)
	var useSret bool = retSz > 16
	var capBaseSlot int = 0
	if useSret { capBaseSlot = 1 }
	// Two limits: nUserWords (incoming dispatch words) must fit the 4 incoming
	// user slots (RDX..R9); the OUTGOING total (captures + outUserWords) must fit
	// the 6 GP arg regs.  These diverge once a coerced aggregate is present.
	if capBaseSlot + captureWords + outUserWords > 6 || nUserWords > 4 {
		emitClosureShimAggregateStackSpill_x64(a, fnLabel, fvTyp, f,
			retSz, cc)
		return
	}
	if useSret {
		// Sret-return: retbuf stays in RDI (the underlying's sret slot),
		// data RSI -> R11 scratch, captures into argReg(1..captureWords),
		// user args after them, tail-jump (RDI preserved).
		x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Reg(x64.RSI, x64.SZ64))
		loadClosureAggCallArgs_x64(a, cc, fvTyp, f, captureWords,
			nUserWords, capBaseSlot)
		a.SetGlobal(fnLabel)
		x64.Jmp(a, fnLabel)
		return
	}
	// Pack-return (retSz 1..16): frame of 16 bytes (retbuf save +
	// alignment), mirroring the non-capturing pack shim.  Stash retbuf,
	// move data RSI -> R11, set up the underlying args (captures at
	// argReg(0..)), CALL, reload retbuf into R10, copy the packed return
	// RAX (+RDX) through it, unwind.
	x64.Push(a, x64.Reg(x64.RBP, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.RBP, x64.SZ64), x64.Reg(x64.RSP, x64.SZ64))
	x64.Sub(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(16))
	x64.Mov(a, x64.Mem(x64.RSP, 0, x64.SZ64), x64.Reg(x64.RDI, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Reg(x64.RSI, x64.SZ64))
	loadClosureAggCallArgs_x64(a, cc, fvTyp, f, captureWords, nUserWords,
		capBaseSlot)
	a.SetGlobal(fnLabel)
	x64.Call(a, fnLabel)
	x64.Mov(a, x64.Reg(x64.R10, x64.SZ64), x64.Mem(x64.RSP, 0, x64.SZ64))
	x64.Mov(a, x64.Mem(x64.R10, 0, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
	if retSz > 8 {
		x64.Mov(a, x64.Mem(x64.R10, 8, x64.SZ64),
			x64.Reg(x64.RDX, x64.SZ64))
	}
	x64.Add(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(16))
	x64.Pop(a, x64.Reg(x64.RBP, x64.SZ64))
	x64.Ret(a)
}

// loadClosureAggCallArgs_x64 sets up the underlying lifted-body call's
// register args for an aggregate-returning closure shim.  The closure-
// struct pointer is in R11 (a non-arg caller-saved scratch the caller
// already moved data into).  capBaseSlot is the first arg-reg slot the
// captures occupy: 0 for pack (captures start at RDI), 1 for sret (RDI is
// the consumed sret slot, so captures start at RSI).  Two steps, in this
// order:
//
//   1. Marshal the user args from their incoming slots (the funcval aggregate
//      convention places user args after the retbuf+data prefix, so word w of
//      the incoming dispatch sequence is argReg(2+w)) to their outgoing real-ABI
//      slots starting at outBase = capBaseSlot+captureWords.  Most params shift
//      word-for-word; a coerced in-register struct/array DIVERGES — it arrives as
//      ONE by-address pointer word but expands into ArgWords outgoing regs (see
//      marshalAggUserArg_x64).  Because outgoing positions never fall below
//      incoming ones once outBase >= 2 (dest >= source pointwise), those moves go
//      right-to-left so each source is read before its slot is overwritten;
//      otherwise (outBase < 2, i.e. the pack shape with a single capture word)
//      dest <= source, so they go left-to-right.
//   2. Load the captures from [R11] into
//      argReg(capBaseSlot..capBaseSlot+captureWords-1) — after the
//      user-arg moves, so a capture write can't clobber an unread user
//      source.  R11 stays live across every load.  Indirect-large captures
//      pass a pointer (LEA); per-word captures load each word (MOV).
func loadClosureAggCallArgs_x64(a @asm.Assembler, cc common.CallConv,
		fvTyp @types.Type, f @ir.Func, captureWords int, nUserWords int,
		capBaseSlot int) {
	var outBase int = capBaseSlot + captureWords
	if outBase >= 2 {
		for pi := len(fvTyp.Params) - 1; pi >= 0; pi = pi - 1 {
			marshalAggUserArg_x64(a, cc, fvTyp, pi, outBase, true)
		}
	} else {
		for pi := 0; pi < len(fvTyp.Params); pi = pi + 1 {
			marshalAggUserArg_x64(a, cc, fvTyp, pi, outBase, false)
		}
	}
	var wi int = 0
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var baseOfs int = f.ClosureStruct.FieldOffset(i)
		if isIndirectLargeCap_x64(cc, ft) {
			x64.Lea(a, x64.Reg(argReg(capBaseSlot + wi), x64.SZ64),
				x64.Mem(x64.R11, baseOfs, x64.SZ64))
			wi = wi + 1
			continue
		}
		var nWords int = common.ArgWords(ft)
		for k := 0; k < nWords; k = k + 1 {
			x64.Mov(a, x64.Reg(argReg(capBaseSlot + wi), x64.SZ64),
				x64.Mem(x64.R11, baseOfs + k * 8, x64.SZ64))
			wi = wi + 1
		}
	}
}

// outgoingUserWords_x64 sums the OUTGOING (real-ABI) GP-word footprint of a
// closure's user params — the count the register/spill routing budgets on.  A
// coerced in-register struct/array contributes its ArgWords coerced regs (the
// shim expands the one by-address pointer word into them), every other param its
// EffectiveArgWords.  This diverges from userWords_x64 (which counts the INCOMING
// dispatch words, where a coerced aggregate is a single pointer) exactly when a
// coerced aggregate is present.
func outgoingUserWords_x64(cc common.CallConv, fvTyp @types.Type) int {
	var n int = 0
	for pi := 0; pi < len(fvTyp.Params); pi = pi + 1 {
		var pt @types.Type = fvTyp.Params[pi].Type
		if common.AggCoercedInReg(pt) {
			n = n + common.ArgWords(pt)
		} else {
			n = n + cc.EffectiveArgWords(pt)
		}
	}
	return n
}

// marshalAggUserArg_x64 marshals one user param (index pi) of the register-only
// aggregate shim from its incoming dispatch slots to its outgoing real-ABI
// argReg slots.  The incoming dispatch sequence places user word w at argReg(2+w)
// (after the retbuf+data prefix); incoming/outgoing cursors are recovered by
// summing the prior params' EffectiveArgWords (incoming) and outgoing words.
//
// Most params shift word-for-word.  A coerced in-register struct/array DIVERGES:
// it arrives as ONE by-address pointer word (EffectiveArgWords == 1) but the
// underlying's coerced ABI reads its ArgWords value-words in consecutive regs, so
// the shim copies the pointer to R10 (a scratch — not a SysV arg reg, not the
// return reg, and NOT R11, which holds the live closure-struct pointer) and loads
// [R10 + 8k] into argReg(outBase + outWord + k).  Copying to R10 first keeps the
// pointer safe from a write to its own incoming slot.
//
// hiToLo selects the within-param word order so a write can't clobber an unread
// source: high-to-low when outgoing slots sit at/above incoming (outBase >= 2,
// dest >= source), low-to-high otherwise (the caller picks the matching param
// order — descending vs ascending — for the same reason).
func marshalAggUserArg_x64(a @asm.Assembler, cc common.CallConv,
		fvTyp @types.Type, pi int, outBase int, hiToLo bool) {
	var inWord int = 0
	var outWord int = 0
	for q := 0; q < pi; q = q + 1 {
		var qt @types.Type = fvTyp.Params[q].Type
		inWord = inWord + cc.EffectiveArgWords(qt)
		if common.AggCoercedInReg(qt) {
			outWord = outWord + common.ArgWords(qt)
		} else {
			outWord = outWord + cc.EffectiveArgWords(qt)
		}
	}
	var pt @types.Type = fvTyp.Params[pi].Type
	if common.AggCoercedInReg(pt) {
		var n int = common.ArgWords(pt)
		var ptrReg int = argReg(2 + inWord)
		x64.Mov(a, x64.Reg(x64.R10, x64.SZ64),
			x64.Reg(ptrReg, x64.SZ64))
		if hiToLo {
			for k := n - 1; k >= 0; k = k - 1 {
				x64.Mov(a, x64.Reg(argReg(outBase + outWord + k), x64.SZ64),
					x64.Mem(x64.R10, 8 * k, x64.SZ64))
			}
		} else {
			for k := 0; k < n; k = k + 1 {
				x64.Mov(a, x64.Reg(argReg(outBase + outWord + k), x64.SZ64),
					x64.Mem(x64.R10, 8 * k, x64.SZ64))
			}
		}
		return
	}
	var w int = cc.EffectiveArgWords(pt)
	if hiToLo {
		for k := w - 1; k >= 0; k = k - 1 {
			moveAggUserWord_x64(a, 2 + inWord + k, outBase + outWord + k)
		}
	} else {
		for k := 0; k < w; k = k + 1 {
			moveAggUserWord_x64(a, 2 + inWord + k, outBase + outWord + k)
		}
	}
}

// moveAggUserWord_x64 moves a user-arg word from incoming register argReg(srcSlot)
// to outgoing register argReg(dstSlot), skipping the move when they coincide.
func moveAggUserWord_x64(a @asm.Assembler, srcSlot int, dstSlot int) {
	var srcReg int = argReg(srcSlot)
	var dstReg int = argReg(dstSlot)
	if srcReg != dstReg {
		x64.Mov(a, x64.Reg(dstReg, x64.SZ64),
			x64.Reg(srcReg, x64.SZ64))
	}
}

// emitClosureShimAggregateStackSpill_x64 is the overflow sibling of the
// register-only aggregate path: captures + user words don't fit RDI..R9,
// so the shim reserves an outgoing-args stack area and writes the
// overflow words explicitly (the aggregate analogue of
// emitClosureShimStackSpill_x64).  Unlike that scalar shim, the closure
// data rides RSI (RDI is retbuf), so it is moved to R11 — a non-arg
// caller-saved scratch that stays live across the whole marshal — and the
// incoming user args start at RDX (prefix 2).
//
// To place captures/args the classifier must account for the retbuf
// consuming an arg register in the sret shape: marshalArgTypes prepends a
// synthetic pointer (the sret slot) so CallArgRegStart/CallArgStackOff put
// the first capture at RSI and the overflow boundary lands one register
// earlier.  For the pack shape the retbuf is saved to the frame instead,
// so marshalArgTypes is just captures ++ params (capBaseSlot 0).
func emitClosureShimAggregateStackSpill_x64(a @asm.Assembler,
		fnLabel @[]char, fvTyp @types.Type, f @ir.Func, retSz int,
		cc common.CallConv) {
	var useSret bool = retSz > 16
	var capBaseSlot int = 0
	// captures ++ params, with a synthetic sret-slot pointer prepended
	// for the sret shape so the classifier accounts for the retbuf in RDI.
	var marshalArgTypes @[]@types.Type
	if useSret {
		capBaseSlot = 1
		marshalArgTypes = slices.Append[@types.Type](marshalArgTypes,
			types.MakePointerType(types.TypUint8()))
	}
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		marshalArgTypes = slices.Append[@types.Type](marshalArgTypes,
			f.ClosureStruct.Fields[i].Type)
	}
	for pi := 0; pi < len(fvTyp.Params); pi = pi + 1 {
		marshalArgTypes = slices.Append[@types.Type](marshalArgTypes,
			fvTyp.Params[pi].Type)
	}
	var stkBytes int = cc.CallStackBytes(marshalArgTypes)
	// +8 compensates for the return-address push at shim entry (RSP is
	// 8-aligned there; the outgoing CALL needs 16).  For the pack shape
	// that same 8-byte slot doubles as the retbuf save area.
	var rspDelta int = stkBytes + 8
	var userArgBase int = capBaseSlot + f.NumCaptureParams
	var nUserWords int = userWords_x64(cc, fvTyp)
	x64.Sub(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(rspDelta))
	if !useSret {
		x64.Mov(a, x64.Mem(x64.RSP, stkBytes, x64.SZ64),
			x64.Reg(x64.RDI, x64.SZ64))
	}
	x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Reg(x64.RSI, x64.SZ64))

	// Step 1: spill stack-bound captures from [R11].  Indirect-large
	// captures pointer-pass (LEA); per-word captures shuttle via RAX.
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var regStart int = cc.CallArgRegStart(marshalArgTypes,
			capBaseSlot + i)
		var stkOff int = cc.CallArgStackOff(marshalArgTypes,
			capBaseSlot + i)
		var fieldOfs int = f.ClosureStruct.FieldOffset(i)
		if regStart >= 0 || stkOff < 0 { continue }
		if isIndirectLargeCap_x64(cc, ft) {
			x64.Lea(a, x64.Reg(x64.RAX, x64.SZ64),
				x64.Mem(x64.R11, fieldOfs, x64.SZ64))
			x64.Mov(a, x64.Mem(x64.RSP, stkOff, x64.SZ64),
				x64.Reg(x64.RAX, x64.SZ64))
			continue
		}
		var nWords int = common.ArgWords(ft)
		for k := 0; k < nWords; k = k + 1 {
			x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64),
				x64.Mem(x64.R11, fieldOfs + k * 8, x64.SZ64))
			x64.Mov(a, x64.Mem(x64.RSP, stkOff + k * 8, x64.SZ64),
				x64.Reg(x64.RAX, x64.SZ64))
		}
	}

	// Step 2: move user args from their incoming slots (prefix 2: retbuf
	// RDI, data RSI, args RDX..) to the classifier's outgoing slots.  The
	// incoming cursor advances by EffectiveArgWords (the dispatch-word count: a
	// coerced in-register struct/array is ONE by-address pointer word there); the
	// outgoing slots come from the classifier over marshalArgTypes (the REAL
	// types), so a coerced aggregate's ArgWords value-words land in their proper
	// reg/stack slots — see emitSpillAggUserArg_x64, which dereferences the
	// pointer for that case.  When the first outgoing user slot sits at/above the
	// incoming base (capBaseSlot + captureWords >= 2) the params/words move
	// HIGH-first / right-to-left so each source is read before its slot is
	// overwritten; for the pack shape with a single capture word the first
	// outgoing slot is below the incoming base, so they move LOW-first /
	// left-to-right instead — otherwise a move would overwrite the next word's
	// source.
	var captureWords int = 0
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		captureWords = captureWords +
			effectiveCapWords_x64(cc, f.ClosureStruct.Fields[i].Type)
	}
	if capBaseSlot + captureWords >= 2 {
		var inRegBase int = 1 + nUserWords
		for ui := len(fvTyp.Params) - 1; ui >= 0; ui = ui - 1 {
			var nUw int = cc.EffectiveArgWords(fvTyp.Params[ui].Type)
			inRegBase = inRegBase - nUw
			emitSpillAggUserArg_x64(a, cc, fvTyp, marshalArgTypes,
				userArgBase, ui, inRegBase, stkBytes, true)
		}
	} else {
		var inRegBase int = 1
		for ui := 0; ui < len(fvTyp.Params); ui = ui + 1 {
			var nUw int = cc.EffectiveArgWords(fvTyp.Params[ui].Type)
			emitSpillAggUserArg_x64(a, cc, fvTyp, marshalArgTypes,
				userArgBase, ui, inRegBase, stkBytes, false)
			inRegBase = inRegBase + nUw
		}
	}

	// Step 3: load register-passed captures from [R11], after the user
	// shift so a capture write can't clobber an unread user source.
	for i := f.NumCaptureParams - 1; i >= 0; i = i - 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var regStart int = cc.CallArgRegStart(marshalArgTypes,
			capBaseSlot + i)
		var fieldOfs int = f.ClosureStruct.FieldOffset(i)
		if regStart < 0 { continue }
		if isIndirectLargeCap_x64(cc, ft) {
			x64.Lea(a, x64.Reg(argReg(regStart), x64.SZ64),
				x64.Mem(x64.R11, fieldOfs, x64.SZ64))
			continue
		}
		var nWords int = common.ArgWords(ft)
		for k := nWords - 1; k >= 0; k = k - 1 {
			x64.Mov(a, x64.Reg(argReg(regStart + k), x64.SZ64),
				x64.Mem(x64.R11, fieldOfs + k * 8, x64.SZ64))
		}
	}

	// Step 4: CALL, route the result, rewind.  Sret already wrote through
	// the retbuf in RDI (preserved across the marshal); pack copies the
	// packed RAX (+RDX) back through the saved retbuf.
	a.SetGlobal(fnLabel)
	x64.Call(a, fnLabel)
	if !useSret {
		x64.Mov(a, x64.Reg(x64.R10, x64.SZ64),
			x64.Mem(x64.RSP, stkBytes, x64.SZ64))
		x64.Mov(a, x64.Mem(x64.R10, 0, x64.SZ64),
			x64.Reg(x64.RAX, x64.SZ64))
		if retSz > 8 {
			x64.Mov(a, x64.Mem(x64.R10, 8, x64.SZ64),
				x64.Reg(x64.RDX, x64.SZ64))
		}
	}
	x64.Add(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(rspDelta))
	x64.Ret(a)
}

// emitSpillAggUserArg_x64 marshals one user param (index ui) of the stack-spill
// aggregate shim from its incoming dispatch slots to the classifier's outgoing
// reg/stack slots.  inRegBase is the param's incoming dispatch-word cursor (the
// running 1-based count the caller maintains, matching emitUserArgWordMove_x64);
// outgoing positions come from CallArgRegStart/CallArgStackOff over the REAL
// marshalArgTypes.
//
// Most params shift word-for-word via emitUserArgWordMove_x64.  A coerced
// in-register struct/array DIVERGES: it arrives as ONE by-address pointer word
// (EffectiveArgWords == 1, so the caller's incoming cursor advanced by 1) but the
// underlying's coerced ABI reads its ArgWords value-words; so the shim loads the
// incoming pointer into R10 (a scratch — not a SysV arg reg, not the return reg,
// and NOT R11, which holds the live closure-struct pointer) and copies
// [R10 + 8k] into each outgoing slot.  SysV does not split a <=16 B aggregate, so
// the outgoing slots are EITHER all registers (outRegStart >= 0) OR all stack
// (outStkOff >= 0); the stack case shuttles each word through RAX.  hiToLo orders
// the value-word writes high-first / low-first to match the caller's param
// direction (so a write can't clobber an unread source).
func emitSpillAggUserArg_x64(a @asm.Assembler, cc common.CallConv,
		fvTyp @types.Type, marshalArgTypes @[]@types.Type, userArgBase int,
		ui int, inRegBase int, stkBytes int, hiToLo bool) {
	var ut @types.Type = fvTyp.Params[ui].Type
	var outRegStart int = cc.CallArgRegStart(marshalArgTypes, userArgBase + ui)
	var outStkOff int = cc.CallArgStackOff(marshalArgTypes, userArgBase + ui)
	if !common.AggCoercedInReg(ut) {
		var nUw int = cc.EffectiveArgWords(ut)
		if hiToLo {
			for k := nUw - 1; k >= 0; k = k - 1 {
				emitUserArgWordMove_x64(a, inRegBase, k, 2, stkBytes,
					outRegStart, outStkOff)
			}
		} else {
			for k := 0; k < nUw; k = k + 1 {
				emitUserArgWordMove_x64(a, inRegBase, k, 2, stkBytes,
					outRegStart, outStkOff)
			}
		}
		return
	}
	// Load the incoming by-address pointer (one word at incoming index
	// inRegBase - 1; prefix 2 = retbuf + data) into R10.
	var inIdx int = inRegBase - 1
	if inIdx < 4 {
		x64.Mov(a, x64.Reg(x64.R10, x64.SZ64),
			x64.Reg(argReg(2 + inIdx), x64.SZ64))
	} else {
		x64.Mov(a, x64.Reg(x64.R10, x64.SZ64),
			x64.Mem(x64.RSP, stkBytes + 16 + (inIdx - 4) * 8, x64.SZ64))
	}
	var n int = common.ArgWords(ut)
	if hiToLo {
		for k := n - 1; k >= 0; k = k - 1 {
			emitCoercedValueWord_x64(a, k, outRegStart, outStkOff)
		}
	} else {
		for k := 0; k < n; k = k + 1 {
			emitCoercedValueWord_x64(a, k, outRegStart, outStkOff)
		}
	}
}

// emitCoercedValueWord_x64 copies value-word k of a by-address coerced aggregate
// (whose pointer is in R10) to its outgoing slot: into argReg(outRegStart + k)
// when the aggregate is register-passed (outRegStart >= 0), else shuttled through
// RAX to the outgoing stack slot [RSP + outStkOff + 8k].
func emitCoercedValueWord_x64(a @asm.Assembler, k int, outRegStart int,
		outStkOff int) {
	if outRegStart >= 0 {
		x64.Mov(a, x64.Reg(argReg(outRegStart + k), x64.SZ64),
			x64.Mem(x64.R10, 8 * k, x64.SZ64))
		return
	}
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.R10, 8 * k, x64.SZ64))
	x64.Mov(a, x64.Mem(x64.RSP, outStkOff + 8 * k, x64.SZ64),
		x64.Reg(x64.RAX, x64.SZ64))
}
