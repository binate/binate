package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Native x86-64 (SysV) stack-spill path for the aggregate-return / multi-return
// closure shim — the overflow sibling of x64_closure_shim_aggregate.bn's
// register-only path, split out to stay under the hygiene file-length cap.

// emitClosureShimAggregateStackSpill_x64 is the overflow sibling of the
// register-only aggregate path: captures + user words don't fit RDI..R9,
// so the shim reserves an outgoing-args stack area and writes the
// overflow words explicitly (the aggregate analogue of
// emitClosureShimStackSpill_x64).  Unlike that scalar shim, the closure
// data rides RSI (RDI is retbuf), so it is moved to R11 — a non-arg
// caller-saved scratch that stays live across the whole marshal — and the
// incoming user args start at RDX (prefix 2).
//
// To place captures/args the classifier must account for the retbuf
// consuming an arg register in the sret shape: marshalArgTypes prepends a
// synthetic pointer (the sret slot) so CallArgRegStart/CallArgStackOff put
// the first capture at RSI and the overflow boundary lands one register
// earlier.  For the pack shape the retbuf is saved to the frame instead,
// so marshalArgTypes is just captures ++ params (capBaseSlot 0).
func emitClosureShimAggregateStackSpill_x64(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type,
		f @ir.Func, retSz int, cc common.CallConv, multiRetTuple @types.Type) {
	// A small multi-return (multiRetTuple != nil) always packs regardless of
	// size (field-per-register callee return); only a single aggregate srets by
	// size.  See emitClosureShimAggregate_x64.
	var useSret bool = retSz > 16 && multiRetTuple == nil
	var capBaseSlot int = 0
	// captures ++ params, with a synthetic sret-slot pointer prepended
	// for the sret shape so the classifier accounts for the retbuf in RDI.
	var marshalArgTypes @[]@types.Type
	if useSret {
		capBaseSlot = 1
		marshalArgTypes = slices.Append[@types.Type](marshalArgTypes,
				types.MakePointerType(types.TypUint8()))
	}
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		marshalArgTypes = slices.Append[@types.Type](marshalArgTypes, f.ClosureStruct.Fields[i].Type)
	}
	for pi := 0; pi < len(fvTyp.Params); pi = pi + 1 {
		marshalArgTypes = slices.Append[@types.Type](marshalArgTypes, fvTyp.Params[pi].Type)
	}
	var stkBytes int = cc.CallStackBytes(marshalArgTypes)
	// +8 compensates for the return-address push at shim entry (RSP is
	// 8-aligned there; the outgoing CALL needs 16).  For the pack shape
	// that same 8-byte slot doubles as the retbuf save area.
	var rspDelta int = stkBytes + 8
	var userArgBase int = capBaseSlot + f.NumCaptureParams
	var nUserWords int = userWords_x64(cc, fvTyp)
	x64.Sub(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(rspDelta))
	if !useSret {
		x64.Mov(a, x64.Mem(x64.RSP, stkBytes, x64.SZ64), x64.Reg(x64.RDI, x64.SZ64))
	}
	x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Reg(x64.RSI, x64.SZ64))

	// Step 1: spill stack-bound captures from [R11].  Indirect-large
	// captures pointer-pass (LEA); per-word captures shuttle via RAX.
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var regStart int = cc.CallArgRegStart(marshalArgTypes, capBaseSlot + i)
		var stkOff int = cc.CallArgStackOff(marshalArgTypes, capBaseSlot + i)
		var fieldOfs int = f.ClosureStruct.FieldOffset(i)
		if regStart >= 0 || stkOff < 0 { continue }
		if isIndirectLargeCap_x64(cc, ft) {
			x64.Lea(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.R11, fieldOfs, x64.SZ64))
			x64.Mov(a, x64.Mem(x64.RSP, stkOff, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
			continue
		}
		var nWords int = common.ArgWords(ft)
		for k := 0; k < nWords; k = k + 1 {
			x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.R11, fieldOfs + k * 8, x64.SZ64))
			x64.Mov(a, x64.Mem(x64.RSP, stkOff + k * 8, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
		}
	}

	// Step 2: move user args from their incoming slots (prefix 2: retbuf
	// RDI, data RSI, args RDX..) to the classifier's outgoing slots.  The
	// incoming cursor advances by shimInWordsForTypeX64 (the dispatch-word count: a
	// by-address aggregate — a coerced in-register struct/array, OR (option B) a raw
	// slice / iface-value — is ONE by-address pointer word there); the outgoing
	// slots come from the classifier over marshalArgTypes (the REAL types), so a
	// by-address aggregate's ArgWords value-words land in their proper reg/stack
	// slots — see emitSpillAggUserArg_x64, which dereferences the pointer for that
	// case.  When the first outgoing user slot sits at/above the
	// incoming base (capBaseSlot + captureWords >= 2) the params/words move
	// HIGH-first / right-to-left so each source is read before its slot is
	// overwritten; for the pack shape with a single capture word the first
	// outgoing slot is below the incoming base, so they move LOW-first /
	// left-to-right instead — otherwise a move would overwrite the next word's
	// source.
	var captureWords int = 0
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		captureWords = captureWords + effectiveCapWords_x64(cc, f.ClosureStruct.Fields[i].Type)
	}
	if capBaseSlot + captureWords >= 2 {
		var inRegBase int = 1 + nUserWords
		for ui := len(fvTyp.Params) - 1; ui >= 0; ui = ui - 1 {
			var nUw int = shimInWordsForTypeX64(cc, fvTyp.Params[ui].Type)
			inRegBase = inRegBase - nUw
			emitSpillAggUserArg_x64(a, cc, fvTyp, marshalArgTypes, userArgBase, ui, inRegBase, stkBytes,
					true)
		}
	} else {
		var inRegBase int = 1
		for ui := 0; ui < len(fvTyp.Params); ui = ui + 1 {
			var nUw int = shimInWordsForTypeX64(cc, fvTyp.Params[ui].Type)
			emitSpillAggUserArg_x64(a, cc, fvTyp, marshalArgTypes, userArgBase, ui, inRegBase, stkBytes,
					false)
			inRegBase = inRegBase + nUw
		}
	}

	// Step 3: load register-passed captures from [R11], after the user
	// shift so a capture write can't clobber an unread user source.
	for i := f.NumCaptureParams - 1; i >= 0; i = i - 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var regStart int = cc.CallArgRegStart(marshalArgTypes, capBaseSlot + i)
		var fieldOfs int = f.ClosureStruct.FieldOffset(i)
		if regStart < 0 { continue }
		if isIndirectLargeCap_x64(cc, ft) {
			x64.Lea(a, x64.Reg(argReg(regStart), x64.SZ64), x64.Mem(x64.R11, fieldOfs, x64.SZ64))
			continue
		}
		var nWords int = common.ArgWords(ft)
		for k := nWords - 1; k >= 0; k = k - 1 {
			x64.Mov(a, x64.Reg(argReg(regStart + k), x64.SZ64), x64.Mem(x64.R11, fieldOfs + k * 8, x64.SZ64))
		}
	}

	// Step 4: CALL, route the result, rewind.  Sret already wrote through
	// the retbuf in RDI (preserved across the marshal); pack copies the
	// packed RAX (+RDX) back through the saved retbuf.
	a.SetGlobal(fnLabel)
	x64.Call(a, fnLabel)
	if !useSret {
		x64.Mov(a, x64.Reg(x64.R10, x64.SZ64), x64.Mem(x64.RSP, stkBytes, x64.SZ64))
		if multiRetTuple != nil {
			// Small multi-return: field-per-class store through retbuf (R10).
			storeMultiReturnTupleFields_x64(a, multiRetTuple, x64.R10, 0, x64.R11, cc.NumFpRetRegs)
		} else if cc.ReturnsSseInRegs(fvTyp.Results[0]) {
			// SSE aggregate: collect XMM0/XMM1 + RAX/RDX by class through retbuf.
			emitSseReturnCollectTo(a, fvTyp.Results[0], x64.R10, 0)
		} else {
			x64.Mov(a, x64.Mem(x64.R10, 0, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
			if retSz > 8 {
				x64.Mov(a, x64.Mem(x64.R10, 8, x64.SZ64), x64.Reg(x64.RDX, x64.SZ64))
			}
		}
	}
	x64.Add(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(rspDelta))
	x64.Ret(a)
}

// emitSpillAggUserArg_x64 marshals one user param (index ui) of the stack-spill
// aggregate shim from its incoming dispatch slots to the classifier's outgoing
// reg/stack slots.  inRegBase is the param's incoming dispatch-word cursor (the
// running 1-based count the caller maintains, matching emitUserArgWordMove_x64);
// outgoing positions come from CallArgRegStart/CallArgStackOff over the REAL
// marshalArgTypes.
//
// Most params shift word-for-word via emitUserArgWordMove_x64.  A by-address
// aggregate — a coerced in-register struct/array, OR (option B) a raw slice /
// iface-value — DIVERGES: it arrives as ONE by-address pointer word
// (shimInWordsForTypeX64 == 1, so the caller's incoming cursor advanced by 1) but
// the underlying's real ABI reads its ArgWords value-words; so the shim loads the
// incoming pointer into R10 (a scratch — not a SysV arg reg, not the return reg,
// and NOT R11, which holds the live closure-struct pointer) and copies
// [R10 + 8k] into each outgoing slot.  SysV does not split a <=16 B aggregate, so
// the outgoing slots are EITHER all registers (outRegStart >= 0) OR all stack
// (outStkOff >= 0); the stack case shuttles each word through RAX.  hiToLo orders
// the value-word writes high-first / low-first to match the caller's param
// direction (so a write can't clobber an unread source).
func emitSpillAggUserArg_x64(a @asm.Assembler, cc common.CallConv, fvTyp @types.Type,
		marshalArgTypes @[]@types.Type, userArgBase int, ui int, inRegBase int, stkBytes int,
		hiToLo bool) {
	var ut @types.Type = fvTyp.Params[ui].Type
	var outRegStart int = cc.CallArgRegStart(marshalArgTypes, userArgBase + ui)
	var outStkOff int = cc.CallArgStackOff(marshalArgTypes, userArgBase + ui)
	if !isByAddressAggX64(cc, ut) {
		var nUw int = shimInWordsForTypeX64(cc, ut)
		if hiToLo {
			for k := nUw - 1; k >= 0; k = k - 1 {
				emitUserArgWordMove_x64(a, inRegBase, k, 2, stkBytes, outRegStart, outStkOff)
			}
		} else {
			for k := 0; k < nUw; k = k + 1 {
				emitUserArgWordMove_x64(a, inRegBase, k, 2, stkBytes, outRegStart, outStkOff)
			}
		}
		return
	}
	// Load the incoming by-address pointer (one word at incoming index
	// inRegBase - 1; prefix 2 = retbuf + data) into R10.
	var inIdx int = inRegBase - 1
	if inIdx < 4 {
		x64.Mov(a, x64.Reg(x64.R10, x64.SZ64), x64.Reg(argReg(2 + inIdx), x64.SZ64))
	} else {
		x64.Mov(a, x64.Reg(x64.R10, x64.SZ64),
				x64.Mem(x64.RSP, stkBytes + 16 + (inIdx - 4) * 8, x64.SZ64))
	}
	var n int = common.ArgWords(ut)
	if hiToLo {
		for k := n - 1; k >= 0; k = k - 1 {
			emitCoercedValueWord_x64(a, k, outRegStart, outStkOff)
		}
	} else {
		for k := 0; k < n; k = k + 1 {
			emitCoercedValueWord_x64(a, k, outRegStart, outStkOff)
		}
	}
}

// emitCoercedValueWord_x64 copies value-word k of a by-address aggregate
// (whose pointer is in R10) to its outgoing slot: into argReg(outRegStart + k)
// when the aggregate is register-passed (outRegStart >= 0), else shuttled through
// RAX to the outgoing stack slot [RSP + outStkOff + 8k].
func emitCoercedValueWord_x64(a @asm.Assembler, k int, outRegStart int, outStkOff int) {
	if outRegStart >= 0 {
		x64.Mov(a, x64.Reg(argReg(outRegStart + k), x64.SZ64), x64.Mem(x64.R10, 8 * k, x64.SZ64))
		return
	}
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.R10, 8 * k, x64.SZ64))
	x64.Mov(a, x64.Mem(x64.RSP, outStkOff + 8 * k, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
}
