package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for x64_closure_shim_aggregate_spill.bn — the stack-spill overflow path
// of the aggregate-return / multi-return capturing-closure shim.  x86-64
// instructions are variable-length, so these use RELATIVE byte-count assertions
// (the convention in x64_closure_shim_test.bn): a closure whose captures + args
// overflow the GP arg registers takes the stack-spill path, which reserves an
// outgoing-args frame and spills — strictly more instructions than the
// register-only aggregate path.  End-to-end behavior is covered by
// conformance/regressions/capturing-closure-aggregate-return and the
// funcval-multi-return matrix on the builder-comp_native_x64* lanes.  Shared
// helpers (closureFuncManyCaptures_x64, opsMkAssembler, opsBytes, fail) live in
// x64_closure_shim_test.bn / x64_ops_test.bn; the aggregate-return type builder
// funcValueTypeNoArgsRetStruct_x64 lives in x64_closure_shim_aggregate_test.bn.

// A capturing closure returning a >16-byte aggregate whose EIGHT int captures
// overflow the SysV GP arg registers (with the retbuf/sret consuming one) forces
// the aggregate STACK-SPILL path.  It must lower without error and emit strictly
// more than the register-only 1-capture sret shim (the spill reserves a frame and
// shuttles overflow captures through the stack).
func TestEmitClosureShimAggregateStackSpill_x64() testing.TestResult {
	var fSmall @ir.Func = closureFuncManyCaptures_x64(1)
	var fvSret @types.Type = funcValueTypeNoArgsRetStruct_x64(3)
	var aSmall @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(aSmall, "underlying_x64", fvSret, fSmall)
	if aSmall.HasError {
		return fail("register-only sret closure shim must lower without error")
	}
	var bytesSmall int = opsBytes(aSmall)

	var fBig @ir.Func = closureFuncManyCaptures_x64(8)
	var aBig @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(aBig, "underlying_x64", fvSret, fBig)
	if aBig.HasError {
		return fail("aggregate stack-spill closure shim must lower without error")
	}
	var bytesBig int = opsBytes(aBig)

	if bytesBig <= bytesSmall {
		return fail(
				"stack-spill aggregate closure shim (frame + spilled captures) "
						"should be larger than the register-only sret shim")
	}
	return ""
}
