package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for x64_closure_shim_aggregate.bn — the aggregate-return
// (pack / sret) path of the capturing-closure shim.  x86-64 instructions
// are variable-length, so these use RELATIVE byte-count assertions (the
// convention in x64_closure_shim_test.bn): the aggregate shapes emit more
// than the scalar tail-jump, so a regression that drops the aggregate
// dispatch back to the scalar shape would shrink the output and trip these.
// End-to-end behavior is covered by
// conformance/regressions/capturing-closure-aggregate-return on the
// builder-comp_native_x64* lanes.  The closure IR / func-value helpers
// (closureFuncSingleIntCapture_x64, opsMkAssembler, opsBytes, fail) live in
// x64_closure_shim_test.bn / x64_ops_test.bn.

// A capturing closure returning a >16-byte aggregate (sret shape) emits
// MOV R11,RSI (stash data) + the capture loads into RSI.. (capBaseSlot 1,
// since RDI is the consumed sret slot) + a tail JMP.  That is one MOV more
// than the scalar shim (which has no retbuf/data juggling), so the sret
// shim is strictly larger — pinning that the aggregate return took the
// retbuf-aware path, not the scalar tail-jump (which would lose RDI=sret).
func TestEmitClosureShimSretReturn_x64() testing.TestResult {
	var fScalar @ir.Func = closureFuncSingleIntCapture_x64()
	var fvScalar @types.Type = funcValueTypeNoArgsRetInt_x64()
	var aScalar @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(aScalar, "underlying_x64", fvScalar, fScalar)
	var bytesScalar int = opsBytes(aScalar)

	var fvSret @types.Type = funcValueTypeNoArgsRetStruct_x64(3)
	var fSret @ir.Func = liftedReturning_x64(closureFuncSingleIntCapture_x64(), fvSret)
	var aSret @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(aSret, "underlying_x64", fvSret, fSret)
	var bytesSret int = opsBytes(aSret)

	if bytesSret <= bytesScalar {
		return fail("sret closure shim should be larger than the scalar shim")
	}
	return ""
}

// A capturing closure returning a 16-byte aggregate (pack shape) builds a
// frame, stashes retbuf, calls the underlying, and copies the packed RAX
// (+RDX) return back through retbuf — many more instructions than either
// the scalar tail-jump or the sret tail-jump, so the pack shim is the
// largest of the three shapes.
func TestEmitClosureShimPackReturn_x64() testing.TestResult {
	var fvSret @types.Type = funcValueTypeNoArgsRetStruct_x64(3)
	var fSret @ir.Func = liftedReturning_x64(closureFuncSingleIntCapture_x64(), fvSret)
	var aSret @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(aSret, "underlying_x64", fvSret, fSret)
	var bytesSret int = opsBytes(aSret)

	var fvPack @types.Type = funcValueTypeNoArgsRetStruct_x64(2)
	var fPack @ir.Func = liftedReturning_x64(closureFuncSingleIntCapture_x64(), fvPack)
	var aPack @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(aPack, "underlying_x64", fvPack, fPack)
	var bytesPack int = opsBytes(aPack)

	if bytesPack <= bytesSret {
		return fail("pack closure shim (frame + copy-back) should be larger than sret")
	}
	return ""
}

// ============================================================
// Helpers
// ============================================================

// structTypeNInt64_x64 builds an n-field struct of int64 — exactly 8*n
// bytes regardless of the test runner's pointer size, so the aggregate-
// return shim shapes (pack ≤ 16, sret > 16) classify deterministically.
func structTypeNInt64_x64(n int) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		var fi @types.Field = make(types.Field)
		fi.Name = "f"
		fi.Type = types.TypInt64()
		fields[i] = fi
	}
	return types.MakeStructType("PN_x64", fields)
}

// funcValueTypeNoArgsRetStruct_x64 builds @func() PN where PN is an
// n-int64 struct (8*n bytes) — the aggregate-return shapes for the tests.
func funcValueTypeNoArgsRetStruct_x64(n int) @types.Type {
	var params @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = structTypeNInt64_x64(n)
	return types.MakeFuncValueType(params, results)
}

// liftedReturning_x64 gives a lifted closure function fv's results, as IR-gen
// lifts it (a multi-return also carries its tuple type), and returns it.
func liftedReturning_x64(f @ir.Func, fv @types.Type) @ir.Func {
	f.Results = fv.Results
	f.MultiReturnType = funcValMultiReturnTuple_x64(fv)
	return f
}

// fvReturning_x64 builds @func() returning results.
func fvReturning_x64(results @[]@types.Type) @types.Type {
	var params @[]@types.Param
	return types.MakeFuncValueType(params, results)
}

// A closure whose four int32 results (16 bytes) pass x86-64's three return
// registers is compiled to return through a hidden pointer, so its shim is the sret
// shape — the same bytes as a 24-byte struct's — not the 16-byte struct's pack shape.
func TestEmitClosureShimSmallSretMultiReturn_x64() testing.TestResult {
	var i32 @types.Type = types.TypInt32()
	var four @types.Type = fvReturning_x64(@[]@types.Type{i32, i32, i32, i32})
	var a @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(a, "underlying_x64", four,
			liftedReturning_x64(closureFuncSingleIntCapture_x64(), four))
	var s3 @types.Type = funcValueTypeNoArgsRetStruct_x64(3)
	var b @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(b, "underlying_x64", s3,
			liftedReturning_x64(closureFuncSingleIntCapture_x64(), s3))
	if a.HasError || b.HasError { return fail("unexpected assembler error") }
	if !x64FoldSameText(x64FoldTextHex(a), x64FoldTextHex(b)) {
		return fail("a four-int32 multi-return closure's shim must be the sret shape")
	}
	return ""
}
