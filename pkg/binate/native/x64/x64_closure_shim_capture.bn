package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"

// The capture loads of the native x86-64 closure shims.  A capturing closure value
// points at its closure struct, which holds the captures at their natural sizes and
// offsets and ends with the last one; each capture is read out of it the way a Binate
// caller passes the parameter the capture becomes.

// loadCaptureWordX64 loads word k of a capture of type t at [base + ofs] into dst the
// way a Binate caller passes a parameter of type t.  A scalar is loaded at its own
// width, a narrow integer (1, 2 or 4 bytes) sign- or zero-extended from it: the body
// keeps a sub-word value extended in its 64-bit register and, once the parameter is
// promoted, compares it at 64 bits.  An aggregate's word is read no further than the
// aggregate's end (loadAggWordAtX64), as the closure struct may end there.  A capture
// past a 32-bit displacement is addressed through a register loaded with its address:
// dst, or for a word put together from pieces (capturePiecedX64), whose dst and base
// differ, R10 (R11 when R10 is the base), which no closure shim holds anything in
// while it loads its captures.
func loadCaptureWordX64(a @asm.Assembler, dst int, base int, ofs int64, k int, t @types.Type) {
	if !callconv.IsAggregateTyp(t) {
		var signed bool
		_, signed = common.SubWordNarrow(t, 64)
		emitFrameLoad(a, dst, base, ofs, scalarSizeX64(t), signed)
		return
	}
	var size int64 = t.Size()
	if size - cast(int64, 8 * k) >= 8 {
		emitFrameLoad(a, dst, base, ofs + cast(int64, 8 * k), 8, false)
		return
	}
	if frameNear(base, ofs, size) {
		loadAggWordAtX64(a, dst, base, cast(int, ofs), k, size)
		return
	}
	var r int = dst
	if capturePiecedX64(t) {
		r = x64.R10
		if base == x64.R10 { r = x64.R11 }
	}
	frameLea(a, r, base, ofs)
	loadAggWordX64(a, dst, r, k, size)
}

// capturePiecedX64 reports whether a capture of type t has a word put together from
// pieces -- an aggregate of 3, 5, 6 or 7 bytes (loadAggWordAtX64) -- which cannot be
// loaded into its own base register.
func capturePiecedX64(t @types.Type) bool {
	if !callconv.IsAggregateTyp(t) { return false }
	var sz int64 = t.Size()
	return sz == 3 || sz == 5 || sz == 6 || sz == 7
}

// capturesPiecedX64 reports whether any of f's captures is capturePiecedX64.
func capturesPiecedX64(f @ir.Func) bool {
	for i := 0; i < f.NumCaptureParams; i++ {
		if capturePiecedX64(f.ClosureStruct.Fields[i].Type) { return true }
	}
	return false
}
