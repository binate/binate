package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A capture is loaded from the closure struct as a Binate caller passes it: a narrow
// integer at its own width, extended by its signedness; an aggregate's word no further
// than the aggregate's end, through R10 (R11 when R10 is the base) when a capture past
// a 32-bit displacement is put together from pieces; and a capture put together from
// pieces through a copy of the base, never into the base itself.

// captureLoadSameX64 reports whether loadCaptureWordX64 of word k of a capture of type
// t at [base + ofs] into RDI emits the bytes of want.
func captureLoadSameX64(base int, t @types.Type, ofs int64, k int, want @asm.Assembler) bool {
	var g @asm.Assembler = mkWantX64()
	loadCaptureWordX64(g, x64.RDI, base, ofs, k, t)
	if g.HasError || g.Sections[0].Len != want.Sections[0].Len { return false }
	for i := 0; i < asm.HeldLen(g.Sections[0]); i++ {
		if g.Sections[0].Data[i] != want.Sections[0].Data[i] { return false }
	}
	return true
}

// structOfX64 builds a struct type whose fields have the types ts.
func structOfX64(name @[]char, ts @[]@types.Type) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, len(ts))
	for i := 0; i < len(ts); i++ {
		var fi @types.Field = make(types.Field)
		fi.Name = "f"
		fi.Type = ts[i]
		fields[i] = fi
	}
	return types.MakeStructType(name, fields)
}

// oddStructX64 is a struct of three int8s: 3 bytes, put together from pieces.
func oddStructX64() @types.Type {
	var bs @[]@types.Type = make_slice(@types.Type, 3)
	bs[0] = types.TypInt8()
	bs[1] = types.TypInt8()
	bs[2] = types.TypInt8()
	return structOfX64("Odd", bs)
}

// closureFuncOfCapturesX64 builds a closure Func whose captures have the types ts.
func closureFuncOfCapturesX64(ts @[]@types.Type) @ir.Func {
	var f @ir.Func = ir.NewFunc("", "main.__funclit_0", make_slice(@ir.Param, 0),
			make_slice(@types.Type, 0))
	var params @[]@ir.Param = make_slice(@ir.Param, len(ts))
	for i := 0; i < len(ts); i++ {
		params[i] = irbuild.NewParam(f, "c", ts[i])
	}
	f.Params = params
	f.IsClosure = true
	f.NumCaptureParams = len(ts)
	f.ClosureStruct = structOfX64("__closure_c", ts)
	return f
}

func TestLoadCaptureWordNarrowScalarsX64() testing.TestResult {
	setTarget64()
	var w @asm.Assembler = mkWantX64()
	x64.Movsxd(w, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSI, 4, x64.SZ32))
	if !captureLoadSameX64(x64.RSI, types.TypInt32(), 4, 0, w) {
		return fail("an int32 capture is MOVSXD")
	}
	w = mkWantX64()
	x64.Movsx(w, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSI, 1, x64.SZ8))
	if !captureLoadSameX64(x64.RSI, types.TypInt8(), 1, 0, w) {
		return fail("an int8 capture is MOVSX")
	}
	w = mkWantX64()
	x64.Movzx(w, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSI, 2, x64.SZ16))
	if !captureLoadSameX64(x64.RSI, types.TypUint16(), 2, 0, w) {
		return fail("a uint16 capture is MOVZX")
	}
	w = mkWantX64()
	x64.Mov(w, x64.Reg(x64.RDI, x64.SZ32), x64.Mem(x64.RSI, 4, x64.SZ32))
	if !captureLoadSameX64(x64.RSI, types.TypUint32(), 4, 0, w) {
		return fail("a uint32 capture is a 32-bit MOV")
	}
	w = mkWantX64()
	x64.Movzx(w, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSI, 3, x64.SZ8))
	if !captureLoadSameX64(x64.RSI, types.TypBool(), 3, 0, w) {
		return fail("a bool capture is MOVZX of a byte")
	}
	w = mkWantX64()
	x64.Mov(w, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSI, 8, x64.SZ64))
	if !captureLoadSameX64(x64.RSI, types.TypInt(), 8, 0, w) {
		return fail("an int capture is a 64-bit MOV")
	}
	return ""
}

// A 12-byte struct at offset 4 is a word at 4 and a 32-bit load at 12, through byte
// 15 (its end); a 3-byte struct at 5 is a halfword at 6 and the byte at 5 below it.
func TestLoadCaptureWordAggregateBoundedX64() testing.TestResult {
	setTarget64()
	var ts @[]@types.Type = make_slice(@types.Type, 3)
	ts[0] = types.TypInt32()
	ts[1] = types.TypInt32()
	ts[2] = types.TypInt32()
	var trip @types.Type = structOfX64("Trip", ts)
	var w @asm.Assembler = mkWantX64()
	x64.Mov(w, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSI, 4, x64.SZ64))
	if !captureLoadSameX64(x64.RSI, trip, 4, 0, w) {
		return fail("word 0 of a 12-byte capture at 4 is bytes 4..11")
	}
	w = mkWantX64()
	x64.Mov(w, x64.Reg(x64.RDI, x64.SZ32), x64.Mem(x64.RSI, 12, x64.SZ32))
	if !captureLoadSameX64(x64.RSI, trip, 4, 1, w) {
		return fail("word 1 of a 12-byte capture at 4 is bytes 12..15")
	}
	w = mkWantX64()
	x64.Movzx(w, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSI, 6, x64.SZ16))
	x64.Shl(w, x64.Reg(x64.RDI, x64.SZ64), x64.Imm(8))
	x64.Mov(w, x64.Reg(x64.RDI, x64.SZ8), x64.Mem(x64.RSI, 5, x64.SZ8))
	if !captureLoadSameX64(x64.RSI, oddStructX64(), 5, 0, w) {
		return fail("a 3-byte capture at 5 is bytes 5..7")
	}
	return ""
}

// Past the displacement limit a pieced capture is addressed through R10, or R11 when
// R10 is the base (the float shim's closure base).
func TestLoadCaptureWordFarPiecedX64() testing.TestResult {
	setTarget64()
	setFarDispLimit(64)
	defer { setFarDispLimit(0) }
	var w @asm.Assembler = mkWantX64()
	frameAddr(w, x64.R10, x64.RSI, 100)
	loadAggWordX64(w, x64.RDI, x64.R10, 0, 3)
	if !captureLoadSameX64(x64.RSI, oddStructX64(), 100, 0, w) {
		return fail("a far 3-byte capture is read through R10")
	}
	w = mkWantX64()
	frameAddr(w, x64.R11, x64.R10, 100)
	loadAggWordX64(w, x64.RDI, x64.R11, 0, 3)
	if !captureLoadSameX64(x64.R10, oddStructX64(), 100, 0, w) {
		return fail("a far 3-byte capture off R10 is read through R11")
	}
	return ""
}

// Two int32 captures: the shim loads each sign-extended from its own 4 bytes (the
// second first, so RDI stays the base until the last load) and jumps to the body.
func TestEmitClosureShimNarrowCapturesX64() testing.TestResult {
	setTarget64()
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt32()
	ts[1] = types.TypInt32()
	var a @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(a, "underlying_x64", funcValueTypeNoArgsRetInt_x64(),
			closureFuncOfCapturesX64(ts))
	var w @asm.Assembler = opsMkAssembler()
	x64.Movsxd(w, x64.Reg(x64.RSI, x64.SZ64), x64.Mem(x64.RDI, 4, x64.SZ32))
	x64.Movsxd(w, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RDI, 0, x64.SZ32))
	w.SetGlobal("underlying_x64")
	x64.Jmp(w, "underlying_x64")
	if !captureLoadSameShimX64(a, w) {
		return fail("two int32 captures are MOVSXD RSI, [RDI+4]; MOVSXD RDI, [RDI]")
	}
	return ""
}

// A 3-byte capture first in the closure struct is put together in RDI, so the shim
// reads it through a copy of the base in R11.
func TestEmitClosureShimPiecedCaptureX64() testing.TestResult {
	setTarget64()
	var ts @[]@types.Type = make_slice(@types.Type, 1)
	ts[0] = oddStructX64()
	var a @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(a, "underlying_x64", funcValueTypeNoArgsRetInt_x64(),
			closureFuncOfCapturesX64(ts))
	var w @asm.Assembler = opsMkAssembler()
	x64.Mov(w, x64.Reg(x64.R11, x64.SZ64), x64.Reg(x64.RDI, x64.SZ64))
	loadAggWordX64(w, x64.RDI, x64.R11, 0, 3)
	w.SetGlobal("underlying_x64")
	x64.Jmp(w, "underlying_x64")
	if !captureLoadSameShimX64(a, w) { return fail("a 3-byte first capture is read through R11") }
	return ""
}

// captureLoadSameShimX64 reports whether a emitted the bytes of w, without an error.
func captureLoadSameShimX64(a @asm.Assembler, w @asm.Assembler) bool {
	if a.HasError || a.Sections[0].Len != w.Sections[0].Len { return false }
	for i := 0; i < asm.HeldLen(a.Sections[0]); i++ {
		if a.Sections[0].Data[i] != w.Sections[0].Data[i] { return false }
	}
	return true
}
