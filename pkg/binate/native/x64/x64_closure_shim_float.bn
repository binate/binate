package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/stdx/slices"

// Float-aware closure shim for the x64 (SysV-AMD64) native backend
// (claude-todo #121).  A capturing closure with a float-scalar CAPTURE,
// float-scalar PARAM, or float-scalar RETURN cannot ride the GP-only fast /
// stack-spill paths: those move every capture/user-arg word through RDI..R9,
// but the lifted body reads a float leaf from XMM0..XMM7 (the SysV SSE
// sequence) and returns a float scalar in XMM0.  The shim is entered under the
// all-int dispatch ABI (closure-struct ptr in RDI, user args as GP bits in
// RSI..), so it must place each float leaf in its XMM register and hand the
// bits back in RAX on a float return.  Sibling of #120's func-value float shim
// and the aarch64 emitClosureShimFloatAA64.

// closureHasFloatParts_x64 reports whether a capturing closure's underlying
// call or return involves a float scalar — a float capture, a float user-arg
// param, or a float-scalar single result — so it needs the float-aware shim
// rather than the GP-only fast / stack-spill paths.
// closureHasFloatParts_x64 reports whether the closure needs the FP-aware
// (float) shim rather than the GP-only fast/spill shims.  True when any capture,
// user param, or the scalar result is a float scalar — and, once the SSE gate is
// on, when any capture/param is a SysV-SSE AGGREGATE (its SSE eightbytes ride XMM
// registers, so it needs the float shim's per-class marshalling too).  The SSE
// clause is gated on types.SysVSseInRegs() so dormant routing is unchanged (an
// SSE aggregate is GP-coerced then, and the GP-only fast shim handles it
// byte-identically); it flips SSE-aggregate closures to the float shim only when
// the ABI does, avoiding a separate SSE path in the right-to-left fast shim.
func closureHasFloatParts_x64(fvTyp @types.Type, f @ir.Func) bool {
	if f.ClosureStruct != nil {
		for i := 0; i < f.NumCaptureParams; i++ {
			var ct @types.Type = f.ClosureStruct.Fields[i].Type
			if common.IsFloatScalarTyp(ct) { return true }
			if types.SysVSseInRegs() && types.SysVAggHasSse(ct) { return true }
		}
	}
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		if common.IsFloatScalarTyp(pt) { return true }
		if types.SysVSseInRegs() && types.SysVAggHasSse(pt) { return true }
	}
	return shimReturnIsFloatScalar_x64(fvTyp)
}

// emitClosureShimFloat_x64 emits the float-aware closure shim.  It moves the
// closure-struct base to R10, spills the incoming user-arg GP registers to a
// stack scratch area, then loads every underlying-call argument — captures
// (from [R10 + field offset], the lifted body's leading params) then user args
// (from the spill) — into its SysV register by CLASS: a float-scalar leaf via
// movq/movd into xmm[NSRN], every other leaf into the GP arg reg[NGRN].
// Sourcing everything from memory (R10 struct / stack spill) makes the marshal
// order clobber-free (dests are RDI..R9 / XMM0..7, neither R10, RSP, nor the
// RAX scratch).  After the CALL a float-scalar return is movq/movd'd
// xmm0 -> rax for the all-int shim.  GP / FP / incoming overflow is handled: the
// classifier sizes an outgoing-args area at [RSP+0..] where the marshaller places
// overflow words, and the spill draws incoming user args from RSI..R9 plus the
// caller's stack.
func emitClosureShimFloat_x64(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type, f @ir.Func) {
	// This shim serves the SCALAR / void float-closure return only: a multi-
	// return (which under retbuf-for-any-multi-return rides the retbuf-in-RDI
	// convention) is intercepted by emitClosureShim_x64's multi-return branch —
	// a small tuple routes to emitClosureShimFloatAggregate_x64 (retbuf + field-
	// per-class store), a big tuple fails loud there — so it never reaches here.
	// The single-scalar XMM0->RAX fixup below is gated on
	// shimReturnIsFloatScalar_x64.
	var cc common.CallConv = common.SysV_AMD64()
	// Outgoing-args area (GP + FP overflow) sized by the classifier, and the
	// incoming user-arg word count (EffectiveArgWords: an indirect-large user
	// arg is one pointer word).
	var argTypes @[]@types.Type = buildShimArgTypes_x64(fvTyp, f)
	var nUserWords int = userWords_x64(cc, fvTyp)
	var outBytes int = cc.CallStackBytes(argTypes)
	// Frame: push rbp re-aligns rsp to 16 (the entry return-address push left it
	// at 8); the 16-rounded sub keeps it aligned for the CALL.  The outgoing-args
	// overflow area is at [RSP+0..outBytes) (where the callee reads its GP/FP
	// overflow stack args); the incoming user-arg spill sits above it at
	// [RSP+outBytes..].
	var frameBytes int = outBytes + nUserWords * 8
	if frameBytes % 16 != 0 { frameBytes = frameBytes + 8 }
	x64.Push(a, x64.Reg(x64.RBP, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.RBP, x64.SZ64), x64.Reg(x64.RSP, x64.SZ64))
	if frameBytes > 0 {
		x64.Sub(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(frameBytes))
	}
	// R10 = closure-struct base (RDI holds it on entry).  R10 is caller-saved
	// and never an outgoing arg register, so it survives the marshal.
	x64.Mov(a, x64.Reg(x64.R10, x64.SZ64), x64.Reg(x64.RDI, x64.SZ64))
	// Spill the incoming user-arg words to [RSP + outBytes + w*8]: RSI..R9 hold
	// the first 5 (RDI is the closure ptr); any beyond arrive on the caller's
	// stack at [RBP + 16 + (w-5)*8] (RBP+0 saved rbp, +8 return addr, +16 first
	// incoming stack arg).
	for w := 0; w < nUserWords; w = w + 1 {
		if w < 5 {
			x64.Mov(a, x64.Mem(x64.RSP, outBytes + w * 8, x64.SZ64), x64.Reg(argReg(1 + w), x64.SZ64))
		} else {
			x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RBP, 16 + (w - 5) * 8, x64.SZ64))
			x64.Mov(a, x64.Mem(x64.RSP, outBytes + w * 8, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
		}
	}
	// Marshal from memory by class: captures from [R10 + ofs], user args from the
	// spill at [RSP + outBytes + w*8]; GP/FP overflow to the outgoing-args area at
	// [RSP+0..].  capBaseIdx 0 — the scalar/void underlying's args start at RDI.
	loadClosureFloatCallArgs_x64(a, cc, fvTyp, f, argTypes, 0, x64.R10, outBytes)
	a.SetGlobal(fnLabel)
	x64.Call(a, fnLabel)
	// Float-scalar return: the lifted body returns it in xmm0; the all-int
	// shim hands the bits back in rax.
	if shimReturnIsFloatScalar_x64(fvTyp) {
		if common.FloatScalarIsI32(fvTyp.Results[0]) {
			x64.Movd_xmm_to_gp(a, x64.RAX, x64.XMM0)
		} else {
			x64.Movq_xmm_to_gp(a, x64.RAX, x64.XMM0)
		}
	}
	if frameBytes > 0 {
		x64.Add(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(frameBytes))
	}
	x64.Pop(a, x64.Reg(x64.RBP, x64.SZ64))
	x64.Ret(a)
}

// emitFloatLoadToXmm_x64 loads a float-scalar value at [base + ofs] into XMM
// register xmm through the RAX scratch (the closure shim has no direct mem->xmm
// here): a float64 via a 64-bit MOV + MOVQ; a float32 via a 32-bit MOV + MOVD,
// so neither the high bits of the GP word nor any bytes past a 4-byte field
// reach the XMM register.
func emitFloatLoadToXmm_x64(a @asm.Assembler, xmm int, base int, ofs int, ft @types.Type) {
	if common.FloatScalarIsI32(ft) {
		x64.Mov(a, x64.Reg(x64.RAX, x64.SZ32), x64.Mem(base, ofs, x64.SZ32))
		x64.Movd_gp_to_xmm(a, xmm, x64.RAX)
	} else {
		x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(base, ofs, x64.SZ64))
		x64.Movq_gp_to_xmm(a, xmm, x64.RAX)
	}
}

// marshalFloatShimArg_x64 places one underlying-call arg (type t, classified at
// argTypes[argIdx]) from [srcBase + srcOfs] into its SysV register/stack slot,
// returning the XMM cursor nsrn advanced past a float scalar.  isCapture selects
// the indirect-large form: a capture is pointer-passed from the struct (LEA), a
// user arg's pointer is already in the spill (MOV).  A coerced in-register
// struct/array USER arg (AggCoercedInReg) arrives BY-ADDRESS on the func-value
// dispatch convention — one pointer word in the spill — so its real-ABI value-
// words are LOADED through that pointer into the underlying's coerced register/
// stack slots, NOT read inline from the spill (which holds only the pointer).  A
// CAPTURE keeps the inline read: its bytes already sit in the closure struct at
// [structPtr + ofs], the underlying's real coerced layout.  Overflow (a float
// past XMM0..7, or a GP word past the arg regs) goes to the outgoing-args area at
// the classifier's CallArgStackOff in an 8-byte slot (SysV pads narrow stack
// args, so no narrow store; a float32 is loaded 32-bit to zero the slot's high
// half).  SysV never SPLITs an aggregate — a GP arg is wholly in regs
// (regStart >= 0) or wholly on the stack.  RAX is the shuttle scratch (never an
// arg register).
func marshalFloatShimArg_x64(a @asm.Assembler, cc common.CallConv, argTypes @[]@types.Type,
		argIdx int, t @types.Type, srcBase int, srcOfs int, isCapture bool, nsrn int) int {
	if common.IsFloatScalarTyp(t) {
		if nsrn < cc.NumFpArgRegs {
			emitFloatLoadToXmm_x64(a, x64.XMM0 + nsrn, srcBase, srcOfs, t)
		} else {
			if common.FloatScalarIsI32(t) {
				x64.Mov(a, x64.Reg(x64.RAX, x64.SZ32), x64.Mem(srcBase, srcOfs, x64.SZ32))
			} else {
				x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(srcBase, srcOfs, x64.SZ64))
			}
			x64.Mov(a, x64.Mem(x64.RSP, cc.CallArgStackOff(argTypes, argIdx), x64.SZ64),
					x64.Reg(x64.RAX, x64.SZ64))
		}
		return nsrn + 1
	}
	var regStart int = cc.CallArgRegStart(argTypes, argIdx)
	var stackOff int = cc.CallArgStackOff(argTypes, argIdx)
	if isIndirectLargeCap_x64(cc, t) {
		// A single pointer word: LEA from the struct for a capture, or load the
		// dispatch-materialized pointer from the spill for a user arg.
		if regStart >= 0 {
			if isCapture {
				x64.Lea(a, x64.Reg(argReg(regStart), x64.SZ64), x64.Mem(srcBase, srcOfs, x64.SZ64))
			} else {
				x64.Mov(a, x64.Reg(argReg(regStart), x64.SZ64), x64.Mem(srcBase, srcOfs, x64.SZ64))
			}
			return nsrn
		}
		if isCapture {
			x64.Lea(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(srcBase, srcOfs, x64.SZ64))
		} else {
			x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(srcBase, srcOfs, x64.SZ64))
		}
		x64.Mov(a, x64.Mem(x64.RSP, stackOff, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
		return nsrn
	}
	if common.AggCoercedInReg(t) && cc.PassesSseInRegs(t) && stackOff < 0 {
		// In-register SysV-SSE aggregate (capture or user arg): expand into XMM/GP
		// by eightbyte class instead of all-GP.  RAX holds the aggregate's address
		// — LEA'd from the closure struct for a capture (bytes sit inline), or the
		// by-address pointer loaded from the spill for a user arg.  RAX (not R11):
		// the aggregate-return float shim carries the LIVE closure-struct base in
		// R11 across the whole capture loop, so an SSE-aggregate CAPTURE must not
		// clobber it; RAX is the per-arg stack shuttle, free here and never the
		// struct base in either float shim, and emitSseShimArgFromPtr only READS
		// through it (into XMM / argReg, never RAX).  SSE eightbytes ride XMM(nsrn),
		// the INTEGER eightbyte the GP reg the classifier assigned (regStart).  A
		// MEMORY-class SSE aggregate (stackOff >= 0) falls through to the
		// class-agnostic byte-copy paths below, consuming no XMM.
		if isCapture {
			x64.Lea(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(srcBase, srcOfs, x64.SZ64))
		} else {
			x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(srcBase, srcOfs, x64.SZ64))
		}
		_, nsrn = emitSseShimArgFromPtr(a, t, x64.RAX, regStart, 0, nsrn)
		return nsrn
	}
	if !isCapture && common.AggCoercedInReg(t) {
		// Coerced in-register struct/array USER arg: the dispatch caller placed it
		// BY-ADDRESS — the spill holds ONE pointer word at [srcBase + srcOfs].  Load
		// its ArgWords value-words THROUGH that pointer into the underlying's coerced
		// register / stack slots (wholly in regs or wholly on the stack — SysV never
		// splits).  R11 is a caller-saved non-arg scratch holding the pointer (it
		// never aliases a live source here: user args marshal after all captures, so
		// the aggregate shim's data-in-R11 is already dead); RAX stays the stack
		// shuttle.
		var nw int = common.ArgWords(t)
		x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Mem(srcBase, srcOfs, x64.SZ64))
		for k := 0; k < nw; k = k + 1 {
			if regStart >= 0 {
				x64.Mov(a, x64.Reg(argReg(regStart + k), x64.SZ64), x64.Mem(x64.R11, k * 8, x64.SZ64))
			} else {
				x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.R11, k * 8, x64.SZ64))
				x64.Mov(a, x64.Mem(x64.RSP, stackOff + k * 8, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
			}
		}
		return nsrn
	}
	// Plain GP arg: nw words, wholly in regs or wholly on the stack.  A coerced
	// in-register CAPTURE lands here: its bytes already sit at [structPtr + ofs] in
	// the underlying's real coerced layout, so the inline read is correct.
	var nw int = common.ArgWords(t)
	for k := 0; k < nw; k = k + 1 {
		if regStart >= 0 {
			x64.Mov(a, x64.Reg(argReg(regStart + k), x64.SZ64), x64.Mem(srcBase, srcOfs + k * 8, x64.SZ64))
		} else {
			x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(srcBase, srcOfs + k * 8, x64.SZ64))
			x64.Mov(a, x64.Mem(x64.RSP, stackOff + k * 8, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
		}
	}
	return nsrn
}

// loadClosureFloatCallArgs_x64 marshals the underlying lifted-body call's args
// into their SysV slots BY CLASS, classifier-driven so every overflow word lands
// where the lifted body's prologue reads it.  Captures source [structPtr + ofs]
// (an indirect-large capture is LEA'd); user args source the spill at
// [RSP + spillBaseOff + word*8].  argTypes is the classifier list and capBaseIdx
// the index where the captures begin in it: 0 for the scalar/void and pack shapes
// (args from RDI), 1 for the sret shape (argTypes leads with a synthetic sret-slot
// pointer occupying RDI, so the classifier starts captures at RSI).  Every source
// is memory and every dest disjoint from the GP/XMM sources, so the loads are
// clobber-free.  Shared by the float-scalar (emitClosureShimFloat_x64) and
// float-aggregate (emitClosureShimFloatAggregate_x64) shims.
func loadClosureFloatCallArgs_x64(a @asm.Assembler, cc common.CallConv, fvTyp @types.Type,
		f @ir.Func, argTypes @[]@types.Type, capBaseIdx int, structPtr int, spillBaseOff int) {
	var nsrn int = 0
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		nsrn = marshalFloatShimArg_x64(a, cc, argTypes, capBaseIdx + i, ft, structPtr,
				f.ClosureStruct.FieldOffset(i), true, nsrn)
	}
	var inWord int = 0
	for pi := 0; pi < len(fvTyp.Params); pi = pi + 1 {
		var pt @types.Type = fvTyp.Params[pi].Type
		nsrn = marshalFloatShimArg_x64(a, cc, argTypes, capBaseIdx + f.NumCaptureParams + pi, pt, x64.RSP,
				spillBaseOff + inWord * 8, false, nsrn)
		inWord = inWord + cc.EffectiveArgWords(pt)
	}
}

// emitClosureShimFloatAggregate_x64 emits the closure shim for a float-
// containing closure whose function value returns a SINGLE aggregate — the
// intersection of the float marshalling (loadClosureFloatCallArgs_x64) and the
// retbuf/sret aggregate-return convention (retbuf in RDI, data in RSI, user
// args in RDX.. under the all-int dispatch ABI, float bits included).  Two
// shapes, mirroring emitClosureShimAggregate_x64:
//
//   * Pack (retSz 1..16): the lifted body packs the aggregate into its return
//     registers and the shim copies them through the stashed retbuf.  While the
//     SSE gate is dormant the body packs all-GP into RAX (+RDX) regardless of
//     field class, so the copy is a plain RAX (+RDX) store; once the gate flips a
//     ReturnsSseInRegs aggregate is packed by SysV class (SSE eightbytes in
//     XMM0/XMM1) and collected by class via emitSseReturnCollectTo.  The
//     classifier places captures + user args from RDI (capBaseIdx 0).
//   * Sret (retSz > 16): retbuf is the underlying's SysV sret pointer in RDI, so
//     it stays put; a synthetic sret-slot pointer prepended to argTypes makes the
//     classifier place captures + user args from RSI (capBaseIdx 1).  The lifted
//     body writes the result through RDI.
//
// GP / FP / incoming overflow is handled (mirroring emitClosureShimFloat_x64):
// the frame reserves the classifier-sized outgoing-args area at [RSP+0..] where
// the marshaller places overflow words, and the spill draws incoming user args
// from RDX..R9 plus the caller's stack.
func emitClosureShimFloatAggregate_x64(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type,
		f @ir.Func, retSz int, multiRetTuple @types.Type) {
	var cc common.CallConv = common.SysV_AMD64()
	// A single aggregate srets by SIZE (> 16 B) and packs all-GP.  A SMALL multi-
	// return (multiRetTuple != nil) always packs regardless of size, and the
	// callee returns it FIELD-PER-CLASS (float fields in XMM0.., GP in RAX..) —
	// so the pack store is the field-per-class helper, not the all-GP RAX(+RDX)
	// copy.  (e.g. (float64,int): float in XMM0, int in RAX.)
	var useSret bool = retSz > 16 && multiRetTuple == nil
	// argTypes for the classifier: captures ++ params, with a synthetic sret-slot
	// pointer prepended for the sret shape so the classifier accounts for the
	// retbuf consuming RDI (captures then start at RSI, the overflow boundary one
	// register earlier).  capBaseIdx is where the captures begin in argTypes.
	var capBaseIdx int = 0
	var argTypes @[]@types.Type
	if useSret {
		capBaseIdx = 1
		argTypes = slices.Append[@types.Type](argTypes, types.MakePointerType(types.TypUint8()))
	}
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		argTypes = slices.Append[@types.Type](argTypes, f.ClosureStruct.Fields[i].Type)
	}
	for pi := 0; pi < len(fvTyp.Params); pi = pi + 1 {
		argTypes = slices.Append[@types.Type](argTypes, fvTyp.Params[pi].Type)
	}
	var nUserWords int = userWords_x64(cc, fvTyp)
	var outBytes int = cc.CallStackBytes(argTypes)
	// Frame (low -> high): the outgoing-args overflow area [RSP+0..outBytes)
	// (where the callee reads its GP/FP overflow stack args at the CALL), the
	// incoming user-arg spill [RSP+outBytes..], and (pack only) a retbuf save slot
	// above that.  push rbp re-aligns rsp to 16; the 16-rounded sub keeps it
	// aligned for the CALL.  Sret keeps the retbuf in RDI (no save slot).
	var retbufOff int = outBytes + nUserWords * 8
	var frameBytes int = retbufOff
	if !useSret { frameBytes = retbufOff + 8 }
	if frameBytes % 16 != 0 { frameBytes = frameBytes + 8 }
	x64.Push(a, x64.Reg(x64.RBP, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.RBP, x64.SZ64), x64.Reg(x64.RSP, x64.SZ64))
	if frameBytes > 0 {
		x64.Sub(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(frameBytes))
	}
	// Stash retbuf + data before the marshal clobbers RDI/RSI.  Sret keeps the
	// retbuf in RDI (argTypes[0] is the never-marshalled sret slot, so no arg ever
	// writes RDI); pack saves it above the spill.  Data RSI -> R11 (caller-saved,
	// never an arg register, survives the marshal).
	if !useSret {
		x64.Mov(a, x64.Mem(x64.RSP, retbufOff, x64.SZ64), x64.Reg(x64.RDI, x64.SZ64))
	}
	x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Reg(x64.RSI, x64.SZ64))
	// Spill the incoming user-arg words to [RSP + outBytes + w*8]: RDX..R9 hold the
	// first 4 (RDI/RSI are retbuf/data); any beyond arrive on the caller's stack at
	// [RBP + 16 + (w-4)*8].
	for w := 0; w < nUserWords; w = w + 1 {
		if w < 4 {
			x64.Mov(a, x64.Mem(x64.RSP, outBytes + w * 8, x64.SZ64), x64.Reg(argReg(2 + w), x64.SZ64))
		} else {
			x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RBP, 16 + (w - 4) * 8, x64.SZ64))
			x64.Mov(a, x64.Mem(x64.RSP, outBytes + w * 8, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
		}
	}
	loadClosureFloatCallArgs_x64(a, cc, fvTyp, f, argTypes, capBaseIdx, x64.R11, outBytes)
	a.SetGlobal(fnLabel)
	x64.Call(a, fnLabel)
	if !useSret {
		// Pack: reload the saved retbuf into R10 (outside the return registers),
		// then store the return through it.  A single aggregate packs all-GP into
		// RAX(+RDX); a small multi-return returns field-per-class (float fields in
		// XMM0.., GP in RAX..), stored via the field-per-class helper (R11 the
		// float→GP scratch, not a return reg, not R10 the base).
		x64.Mov(a, x64.Reg(x64.R10, x64.SZ64), x64.Mem(x64.RSP, retbufOff, x64.SZ64))
		if multiRetTuple != nil {
			storeMultiReturnTupleFields_x64(a, multiRetTuple, x64.R10, 0, x64.R11, cc.NumFpRetRegs)
		} else if cc.ReturnsSseInRegs(fvTyp.Results[0]) {
			// SSE aggregate: SSE eightbytes in XMM0/XMM1, INTEGER in RAX/RDX —
			// collect by class through retbuf, not RAX/RDX wholesale.
			emitSseReturnCollectTo(a, fvTyp.Results[0], x64.R10, 0)
		} else {
			x64.Mov(a, x64.Mem(x64.R10, 0, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
			if retSz > 8 {
				x64.Mov(a, x64.Mem(x64.R10, 8, x64.SZ64), x64.Reg(x64.RDX, x64.SZ64))
			}
		}
	}
	if frameBytes > 0 {
		x64.Add(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(frameBytes))
	}
	x64.Pop(a, x64.Reg(x64.RBP, x64.SZ64))
	x64.Ret(a)
}
