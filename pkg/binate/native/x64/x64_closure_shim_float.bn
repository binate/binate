package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Float-aware closure shim for the x64 (SysV-AMD64) native backend
// (claude-todo #121).  A capturing closure with a float-scalar CAPTURE,
// float-scalar PARAM, or float-scalar RETURN cannot ride the GP-only fast /
// stack-spill paths: those move every capture/user-arg word through RDI..R9,
// but the lifted body reads a float leaf from XMM0..XMM7 (the SysV SSE
// sequence) and returns a float scalar in XMM0.  The shim is entered under the
// all-int dispatch ABI (closure-struct ptr in RDI, user args as GP bits in
// RSI..), so it must place each float leaf in its XMM register and hand the
// bits back in RAX on a float return.  Sibling of #120's func-value float shim
// and the aarch64 emitClosureShimFloatAA64.

// closureHasFloatParts_x64 reports whether a capturing closure's underlying
// call or return involves a float scalar — a float capture, a float user-arg
// param, or a float-scalar single result — so it needs the float-aware shim
// rather than the GP-only fast / stack-spill paths.
func closureHasFloatParts_x64(fvTyp @types.Type, f @ir.Func) bool {
	if f.ClosureStruct != nil {
		for i := 0; i < f.NumCaptureParams; i++ {
			if common.IsFloatScalarTyp(f.ClosureStruct.Fields[i].Type) {
				return true
			}
		}
	}
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		if common.IsFloatScalarTyp(fvTyp.Params[pi].Type) { return true }
	}
	return shimReturnIsFloatScalar_x64(fvTyp)
}

// emitClosureShimFloat_x64 emits the float-aware closure shim.  It moves the
// closure-struct base to R10, spills the incoming user-arg GP registers to a
// stack scratch area, then loads every underlying-call argument — captures
// (from [R10 + field offset], the lifted body's leading params) then user args
// (from the spill) — into its SysV register by CLASS: a float-scalar leaf via
// movq/movd into xmm[NSRN], every other leaf into the GP arg reg[NGRN].
// Sourcing everything from memory (R10 struct / stack spill) makes the marshal
// order clobber-free (dests are RDI..R9 / XMM0..7, neither R10, RSP, nor the
// RAX scratch).  After the CALL a float-scalar return is movq/movd'd
// xmm0 -> rax for the all-int shim.  Register-only: the underlying call must
// fit RDI..R9 + XMM0..7 and the incoming user args must fit RSI..R9; beyond
// that the shim records a.SetError (the stack-overflow float path isn't
// implemented — rare, untested).
func emitClosureShimFloat_x64(a @asm.Assembler, fnLabel @[]char,
		fvTyp @types.Type, f @ir.Func) {
	// A SMALL multi-return RESULT (in-register, not sret) alongside float
	// captures/params needs no extra work: this shim marshals the float
	// captures/params into XMM and the GP args into the arg registers, CALLs
	// the lifted body, and the body packs the tuple field-per-register (e.g.
	// (float64,int) -> XMM0 + RAX) exactly where the dispatch caller's
	// collectMultiReturnTuple reads it.  The single-scalar XMM0->RAX fixup
	// below is gated on shimReturnIsFloatScalar_x64 (false for len != 1), so it
	// leaves a multi-return untouched.  A BIG (sret) float multi-return is
	// routed to the SetError in emitClosureShim_x64 before reaching here.
	var cc common.CallConv = common.SysV_AMD64()
	// Walk 1: outgoing GP/FP register counts + incoming user-arg GP words.
	var ngrn int = 0
	var nsrn int = 0
	for i := 0; i < f.NumCaptureParams; i++ {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		if common.IsFloatScalarTyp(ft) {
			nsrn = nsrn + 1
		} else if isIndirectLargeCap_x64(cc, ft) {
			ngrn = ngrn + 1
		} else {
			ngrn = ngrn + common.ArgWords(ft)
		}
	}
	var nUserWords int = 0
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		if common.IsFloatScalarTyp(pt) {
			nsrn = nsrn + 1
		} else {
			ngrn = ngrn + common.ArgWords(pt)
		}
		nUserWords = nUserWords + common.ArgWords(pt)
	}
	// Outgoing GP fits RDI..R9 (6); incoming user args fit RSI..R9 (5, since RDI
	// is the closure ptr).  Float captures/params beyond the 8 FP arg registers
	// overflow to the outgoing-args stack (handled below); GP / incoming-arg
	// overflow stays the unimplemented stack-spill path.
	if ngrn > 6 || nUserWords > 5 {
		a.SetError("native x64: float closure shim needs the unimplemented "
			"stack-overflow path (captures/args exceed the register budget)")
		return
	}
	// Frame: an outgoing-args area for the FP-overflow floats (the 9th+ float
	// capture/param — sequential 8-byte slots, since GP args stay in regs so
	// floats are the only stack args) sits at [RSP+0..]; the incoming user-arg
	// spill sits above it.  push rbp / mov rbp,rsp re-aligns rsp to 16; the
	// 16-aligned sub keeps it aligned for the CALL.
	var fpOverflow int = 0
	if nsrn > cc.NumFpArgRegs { fpOverflow = nsrn - cc.NumFpArgRegs }
	var outBytes int = fpOverflow * 8
	var frameBytes int = outBytes + nUserWords * 8
	if frameBytes % 16 != 0 { frameBytes = frameBytes + 8 }
	x64.Push(a, x64.Reg(x64.RBP, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.RBP, x64.SZ64), x64.Reg(x64.RSP, x64.SZ64))
	if frameBytes > 0 {
		x64.Sub(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(frameBytes))
	}
	// R10 = closure-struct base (RDI holds it on entry).  R10 is caller-saved
	// and never an outgoing arg register, so it survives the marshal.
	x64.Mov(a, x64.Reg(x64.R10, x64.SZ64), x64.Reg(x64.RDI, x64.SZ64))
	// Spill incoming user-arg words argReg(1..nUserWords) (RSI..) above the
	// outgoing-args area, at [RSP + outBytes + w*8].
	for w := 0; w < nUserWords; w++ {
		x64.Mov(a, x64.Mem(x64.RSP, outBytes + w * 8, x64.SZ64),
			x64.Reg(argReg(1 + w), x64.SZ64))
	}
	// Marshal the underlying call's args from memory into their SysV registers
	// by class: captures from [R10 + ofs], user args from the spill at
	// [RSP + outBytes + w*8]; an FP-overflow float goes to the outgoing-args
	// area at [RSP + 0..].  gpDestBase 0 — the scalar/void underlying's GP args
	// start at RDI.
	loadClosureFloatCallArgs_x64(a, cc, fvTyp, f, x64.R10, outBytes, 0)
	a.SetGlobal(fnLabel)
	x64.Call(a, fnLabel)
	// Float-scalar return: the lifted body returns it in xmm0; the all-int
	// shim hands the bits back in rax.
	if shimReturnIsFloatScalar_x64(fvTyp) {
		if common.FloatScalarIsI32(fvTyp.Results[0]) {
			x64.Movd_xmm_to_gp(a, x64.RAX, x64.XMM0)
		} else {
			x64.Movq_xmm_to_gp(a, x64.RAX, x64.XMM0)
		}
	}
	if frameBytes > 0 {
		x64.Add(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(frameBytes))
	}
	x64.Pop(a, x64.Reg(x64.RBP, x64.SZ64))
	x64.Ret(a)
}

// emitFloatLoadToXmm_x64 loads a float-scalar value at [base + ofs] into XMM
// register xmm through the RAX scratch (the closure shim has no direct mem->xmm
// here): a float64 via a 64-bit MOV + MOVQ; a float32 via a 32-bit MOV + MOVD,
// so neither the high bits of the GP word nor any bytes past a 4-byte field
// reach the XMM register.
func emitFloatLoadToXmm_x64(a @asm.Assembler, xmm int, base int, ofs int,
		ft @types.Type) {
	if common.FloatScalarIsI32(ft) {
		x64.Mov(a, x64.Reg(x64.RAX, x64.SZ32), x64.Mem(base, ofs, x64.SZ32))
		x64.Movd_gp_to_xmm(a, xmm, x64.RAX)
	} else {
		x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(base, ofs, x64.SZ64))
		x64.Movq_gp_to_xmm(a, xmm, x64.RAX)
	}
}

// emitFloatToOverflowStack_x64 moves an FP-overflow float-scalar value at
// [base + ofs] to the underlying call's outgoing-args stack at [RSP + dstOff]
// (an 8-byte slot, matching the callee prologue's read).  Shuttles through RAX
// (never an arg register here): a float32 via a 32-bit MOV (which zero-extends
// RAX) so the slot's high 4 bytes are clean; a float64 via a 64-bit MOV.
func emitFloatToOverflowStack_x64(a @asm.Assembler, base int, ofs int,
		dstOff int, ft @types.Type) {
	if common.FloatScalarIsI32(ft) {
		x64.Mov(a, x64.Reg(x64.RAX, x64.SZ32), x64.Mem(base, ofs, x64.SZ32))
	} else {
		x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(base, ofs, x64.SZ64))
	}
	x64.Mov(a, x64.Mem(x64.RSP, dstOff, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
}

// loadClosureFloatCallArgs_x64 loads the underlying lifted-body call's args
// into their SysV registers BY CLASS: a float-scalar capture/param into
// xmm[nsrn], every other word into argReg(gpDestBase + ngrn).  Captures source
// [structPtr + fieldOfs]; user args source the spill area
// [RSP + spillBaseOff + word*8] (the caller spilled the incoming positional-GP
// user-arg words there).  Every source is memory and every GP/XMM dest is
// disjoint from the GP sources, so the loads are order-independent and
// clobber-free (RAX, the emitFloatLoadToXmm_x64 scratch, is never an arg
// register).  gpDestBase is the first GP arg slot the underlying uses: 0 for
// the scalar/void and pack shapes (args at RDI..), 1 for the sret shape (RDI is
// the sret pointer, so args start at RSI).  Shared by the float-scalar
// (emitClosureShimFloat_x64) and float-aggregate (emitClosureShimFloatAggregate_x64)
// closure shims.
func loadClosureFloatCallArgs_x64(a @asm.Assembler, cc common.CallConv,
		fvTyp @types.Type, f @ir.Func, structPtr int, spillBaseOff int,
		gpDestBase int) {
	var ngrn int = 0
	var nsrn int = 0
	// FP-overflow floats (the 9th+ float) go to the outgoing-args area at
	// [RSP + fpOverflowOff], sequential 8-byte slots — the scalar shim reserved
	// the space (the aggregate shim gates nsrn > NumFpArgRegs to SetError, so it
	// never reaches this path).
	var fpOverflowOff int = 0
	for i := 0; i < f.NumCaptureParams; i++ {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var ofs int = f.ClosureStruct.FieldOffset(i)
		if common.IsFloatScalarTyp(ft) {
			if nsrn < cc.NumFpArgRegs {
				emitFloatLoadToXmm_x64(a, x64.XMM0 + nsrn, structPtr, ofs, ft)
			} else {
				emitFloatToOverflowStack_x64(a, structPtr, ofs, fpOverflowOff,
					ft)
				fpOverflowOff = fpOverflowOff + 8
			}
			nsrn = nsrn + 1
		} else if isIndirectLargeCap_x64(cc, ft) {
			x64.Lea(a, x64.Reg(argReg(gpDestBase + ngrn), x64.SZ64),
				x64.Mem(structPtr, ofs, x64.SZ64))
			ngrn = ngrn + 1
		} else {
			var nw int = common.ArgWords(ft)
			for k := 0; k < nw; k++ {
				x64.Mov(a, x64.Reg(argReg(gpDestBase + ngrn), x64.SZ64),
					x64.Mem(structPtr, ofs + k * 8, x64.SZ64))
				ngrn = ngrn + 1
			}
		}
	}
	var inWord int = 0
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		if common.IsFloatScalarTyp(pt) {
			if nsrn < cc.NumFpArgRegs {
				emitFloatLoadToXmm_x64(a, x64.XMM0 + nsrn, x64.RSP,
					spillBaseOff + inWord * 8, pt)
			} else {
				emitFloatToOverflowStack_x64(a, x64.RSP,
					spillBaseOff + inWord * 8, fpOverflowOff, pt)
				fpOverflowOff = fpOverflowOff + 8
			}
			nsrn = nsrn + 1
			inWord = inWord + 1
		} else {
			var nw int = common.ArgWords(pt)
			for k := 0; k < nw; k++ {
				x64.Mov(a, x64.Reg(argReg(gpDestBase + ngrn), x64.SZ64),
					x64.Mem(x64.RSP, spillBaseOff + (inWord + k) * 8,
						x64.SZ64))
				ngrn = ngrn + 1
			}
			inWord = inWord + nw
		}
	}
}

// emitClosureShimFloatAggregate_x64 emits the closure shim for a float-
// containing closure whose function value returns a SINGLE aggregate — the
// intersection of the float marshalling (loadClosureFloatCallArgs_x64) and the
// retbuf/sret aggregate-return convention (retbuf in RDI, data in RSI, user
// args in RDX.. under the all-int dispatch ABI, float bits included).  Two
// shapes, mirroring emitClosureShimAggregate_x64:
//
//   * Pack (retSz 1..16): the lifted body packs the aggregate into RAX (+RDX)
//     REGARDLESS of field class — emitAggregateReturnPack is all-GP — so the
//     shim copies RAX (+RDX) straight through the stashed retbuf with no FP
//     result handling.  Captures + user args start at RDI (gpDestBase 0).
//   * Sret (retSz > 16): retbuf is the underlying's SysV sret pointer in RDI,
//     so it stays put and captures + user args start at RSI (gpDestBase 1); the
//     lifted body writes the result through it.
//
// Register-only: GP outgoing must fit RDI..R9, FP must fit XMM0..7, and the
// incoming user words must fit RDX..R9 (≤ 4) — beyond that the shim records a
// compile error (the stack-overflow float path is claude-todo #121's reg-
// overflow case, not yet implemented).
func emitClosureShimFloatAggregate_x64(a @asm.Assembler, fnLabel @[]char,
		fvTyp @types.Type, f @ir.Func, retSz int) {
	var cc common.CallConv = common.SysV_AMD64()
	var useSret bool = retSz > 16
	var gpDestBase int = 0
	if useSret { gpDestBase = 1 }
	// Outgoing GP/FP budget + incoming user-word count (all user words, float
	// bits included, arrive in GP slots and are spilled).
	var ngrn int = 0
	var nsrn int = 0
	for i := 0; i < f.NumCaptureParams; i++ {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		if common.IsFloatScalarTyp(ft) {
			nsrn = nsrn + 1
		} else if isIndirectLargeCap_x64(cc, ft) {
			ngrn = ngrn + 1
		} else {
			ngrn = ngrn + common.ArgWords(ft)
		}
	}
	var nUserWords int = 0
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		if common.IsFloatScalarTyp(pt) {
			nsrn = nsrn + 1
		} else {
			ngrn = ngrn + common.ArgWords(pt)
		}
		nUserWords = nUserWords + common.ArgWords(pt)
	}
	// The nsrn > NumFpArgRegs (FP overflow) arm of this guard is load-bearing:
	// the shared marshaller routes an overflow float to the outgoing-args area at
	// [RSP+0..], but THIS shim's frame puts the retbuf save slot / user-arg spill
	// there (not a reserved overflow area).  Do NOT relax the FP-overflow arm
	// without first restructuring this frame to reserve [RSP+0..] for outgoing
	// args (as emitClosureShimFloat_x64 does), or the overflow store corrupts the
	// retbuf/spill.
	if gpDestBase + ngrn > 6 || nsrn > cc.NumFpArgRegs || nUserWords > 4 {
		a.SetError("native x64: float closure with an aggregate return needs "
			"the unimplemented stack-overflow path (captures/args exceed the "
			"register budget)")
		return
	}
	if useSret {
		// Sret: retbuf stays in RDI (the underlying's sret slot, gpDestBase 1).
		// Frame + spill the incoming user args, marshal captures/args into
		// RSI.., CALL, tear down — the underlying wrote the result through RDI.
		var frameBytes int = nUserWords * 8
		if frameBytes % 16 != 0 { frameBytes = frameBytes + 8 }
		x64.Push(a, x64.Reg(x64.RBP, x64.SZ64))
		x64.Mov(a, x64.Reg(x64.RBP, x64.SZ64), x64.Reg(x64.RSP, x64.SZ64))
		if frameBytes > 0 {
			x64.Sub(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(frameBytes))
		}
		x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Reg(x64.RSI, x64.SZ64))
		for w := 0; w < nUserWords; w++ {
			x64.Mov(a, x64.Mem(x64.RSP, w * 8, x64.SZ64),
				x64.Reg(argReg(2 + w), x64.SZ64))
		}
		loadClosureFloatCallArgs_x64(a, cc, fvTyp, f, x64.R11, 0, gpDestBase)
		a.SetGlobal(fnLabel)
		x64.Call(a, fnLabel)
		if frameBytes > 0 {
			x64.Add(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(frameBytes))
		}
		x64.Pop(a, x64.Reg(x64.RBP, x64.SZ64))
		x64.Ret(a)
		return
	}
	// Pack (retSz 1..16): the frame holds the retbuf save slot ([RSP+0]) and the
	// incoming user-arg spill ([RSP+8 + w*8]).  Stash retbuf, move data RSI ->
	// R11, spill user args, marshal (captures/args at RDI.., gpDestBase 0),
	// CALL, reload retbuf into R10, copy the all-GP packed return through it.
	var frameBytes int = 8 + nUserWords * 8
	if frameBytes % 16 != 0 { frameBytes = frameBytes + 8 }
	x64.Push(a, x64.Reg(x64.RBP, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.RBP, x64.SZ64), x64.Reg(x64.RSP, x64.SZ64))
	x64.Sub(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(frameBytes))
	x64.Mov(a, x64.Mem(x64.RSP, 0, x64.SZ64), x64.Reg(x64.RDI, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Reg(x64.RSI, x64.SZ64))
	for w := 0; w < nUserWords; w++ {
		x64.Mov(a, x64.Mem(x64.RSP, 8 + w * 8, x64.SZ64),
			x64.Reg(argReg(2 + w), x64.SZ64))
	}
	loadClosureFloatCallArgs_x64(a, cc, fvTyp, f, x64.R11, 8, gpDestBase)
	a.SetGlobal(fnLabel)
	x64.Call(a, fnLabel)
	x64.Mov(a, x64.Reg(x64.R10, x64.SZ64), x64.Mem(x64.RSP, 0, x64.SZ64))
	x64.Mov(a, x64.Mem(x64.R10, 0, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
	if retSz > 8 {
		x64.Mov(a, x64.Mem(x64.R10, 8, x64.SZ64), x64.Reg(x64.RDX, x64.SZ64))
	}
	x64.Add(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(frameBytes))
	x64.Pop(a, x64.Reg(x64.RBP, x64.SZ64))
	x64.Ret(a)
}
