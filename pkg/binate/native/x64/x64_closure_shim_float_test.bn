package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for x64_closure_shim_float.bn (claude-todo #121).  End-to-end behavior
// is covered by conformance/569_func_value_closure_float on
// builder-comp_native_x64_darwin; these pin the closureHasFloatParts_x64
// classifier and that a float closure routes through emitClosureShim_x64 to
// the float-aware path and emits a non-empty body without an assembler error.

// floatCaptureClosureFunc_x64: an IsClosure Func capturing one float64.
func floatCaptureClosureFunc_x64() @ir.Func {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var fx @types.Field = make(types.Field)
	fx.Name = "factor"
	fx.Type = types.TypFloat64()
	fields[0] = fx
	var f @ir.Func = make(ir.Func)
	f.Name = "main.__funclit_f"
	f.IsClosure = true
	f.NumCaptureParams = 1
	f.ClosureStruct = types.MakeStructType("__closure_f", fields)
	return f
}

// intCaptureClosureFunc_x64: an IsClosure Func capturing one int64.
func intCaptureClosureFunc_x64() @ir.Func {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var fx @types.Field = make(types.Field)
	fx.Name = "n"
	fx.Type = types.TypInt64()
	fields[0] = fx
	var f @ir.Func = make(ir.Func)
	f.Name = "main.__funclit_i"
	f.IsClosure = true
	f.NumCaptureParams = 1
	f.ClosureStruct = types.MakeStructType("__closure_i", fields)
	return f
}

// fvFloatArgRetFloat_x64: @func(float64) float64 (the 569 user-signature).
func fvFloatArgRetFloat_x64() @types.Type {
	var ps @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Type = types.TypFloat64()
	ps[0] = p
	var rs @[]@types.Type = make_slice(@types.Type, 1)
	rs[0] = types.TypFloat64()
	return types.MakeFuncValueType(ps, rs)
}

// fvIntArgRetInt_x64: @func(int64) int64 — no float parts.
func fvIntArgRetInt_x64() @types.Type {
	var ps @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Type = types.TypInt64()
	ps[0] = p
	var rs @[]@types.Type = make_slice(@types.Type, 1)
	rs[0] = types.TypInt64()
	return types.MakeFuncValueType(ps, rs)
}

// A float CAPTURE makes a closure need the float-aware path even with an
// all-int user signature.
func TestClosureHasFloatPartsCapture_x64() testing.TestResult {
	if !closureHasFloatParts_x64(fvIntArgRetInt_x64(),
			floatCaptureClosureFunc_x64()) {
		return fail("a float64 capture should count as a float part")
	}
	return ""
}

// A float PARAM or float RETURN makes a closure need the float-aware path even
// with all-integer captures.
func TestClosureHasFloatPartsParamAndReturn_x64() testing.TestResult {
	if !closureHasFloatParts_x64(fvFloatArgRetFloat_x64(),
			intCaptureClosureFunc_x64()) {
		return fail("a float64 param/return should count as a float part")
	}
	return ""
}

// An all-int closure has no float parts → stays on the GP-only fast path.
func TestClosureHasFloatPartsNone_x64() testing.TestResult {
	if closureHasFloatParts_x64(fvIntArgRetInt_x64(),
			intCaptureClosureFunc_x64()) {
		return fail("an all-int closure should NOT have float parts")
	}
	return ""
}

// The 569 shape (float capture + float param + float return) routes through
// emitClosureShim_x64 to the float-aware path and emits a non-empty body with
// no assembler error.  (Behavioral check is conformance/569.)
func TestEmitClosureShimFloatRoutes_x64() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(a, "underlying_x64", fvFloatArgRetFloat_x64(),
		floatCaptureClosureFunc_x64())
	if a.HasError {
		return fail("float closure shim should emit without error")
	}
	if opsBytes(a) == 0 {
		return fail("float closure shim should emit a non-empty body")
	}
	return ""
}

// floatStructFuncValue_x64: @func(float64) <struct of nFloatFields f64> — the
// aggregate-return float-closure shapes.  nFloatFields 2 (16 bytes) hits the
// pack path; 3 (24 bytes) hits the sret path.
func floatStructFuncValue_x64(nFloatFields int) @types.Type {
	var ps @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Type = types.TypFloat64()
	ps[0] = p
	var ffields @[]@types.Field = make_slice(@types.Field, nFloatFields)
	for i := 0; i < nFloatFields; i++ {
		var fld @types.Field = make(types.Field)
		fld.Type = types.TypFloat64()
		ffields[i] = fld
	}
	var rs @[]@types.Type = make_slice(@types.Type, 1)
	rs[0] = types.MakeStructType("FloatStruct_x64", ffields)
	return types.MakeFuncValueType(ps, rs)
}

// A float closure that ALSO returns an aggregate routes through
// emitClosureShim_x64 to emitClosureShimFloatAggregate_x64 (NOT the old
// SetError bail) and emits a non-empty body for both the pack (≤ 16 B) and sret
// (> 16 B) shapes.  (Behavioral checks are conformance/706, 883, 884.)
func TestEmitClosureShimFloatAggregateRoutes_x64() testing.TestResult {
	var aPack @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(aPack, "underlying_x64", floatStructFuncValue_x64(2),
		floatCaptureClosureFunc_x64())
	if aPack.HasError {
		return fail("float closure w/ pack aggregate return should emit "
			"without error")
	}
	if opsBytes(aPack) == 0 {
		return fail("float closure w/ pack aggregate return should emit a "
			"non-empty body")
	}
	var aSret @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(aSret, "underlying_x64", floatStructFuncValue_x64(3),
		floatCaptureClosureFunc_x64())
	if aSret.HasError {
		return fail("float closure w/ sret aggregate return should emit "
			"without error")
	}
	if opsBytes(aSret) == 0 {
		return fail("float closure w/ sret aggregate return should emit a "
			"non-empty body")
	}
	return ""
}
