package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/types"

// Native x64 (SysV-AMD64) closure-shim STACK-SPILL path: the over-budget
// closure shim (any outgoing arg classified MEMORY under SysV — an aggregate
// > AggregateInRegMax = 16 bytes, including a managed-slice `@[]T` at 32 bytes),
// split out of x64_closure_shim.bn to keep that file under the file-length cap.
// Mirrors x64_funcvalue_spill.bn for the capturing-closure case.  The fast
// (register-only) path and the shim dispatcher that routes MEMORY-classified args
// here stay in x64_closure_shim.bn.

// emitClosureShimStackSpill_x64 handles the SysV MEMORY case: one or
// more args (captures or user-args) classify as fully on the stack,
// so the shim must reserve outgoing-args stack space and write the
// words explicitly.  Switches the tail-jump to CALL + cleanup + RET
// so the stack rewind happens before returning to the caller.
func emitClosureShimStackSpill_x64(a @asm.Assembler, fnLabel @[]char, fvTyp @types.Type, f @ir.Func,
		cc callconv.CallConv, argTypes @[]@types.Type, nUserWords int) {
	var stkBytes int = cc.CallStackBytes(argTypes)
	// Frame: [RSP+0 .. stkBytes) = the outgoing args; [RSP+stkBytes .. +stageBytes)
	// = the staged incoming user words (step 2).  +8 compensates for the
	// return-address push at shim entry — at entry RSP is 8-byte aligned, and the
	// outgoing CALL needs it 16-byte aligned.  stkBytes is already rounded to
	// StackAlign (16) by CallStackBytes, and stageBytes to 16 here.
	var stageBytes int = nUserWords * 8
	if stageBytes % 16 != 0 { stageBytes = stageBytes + 8 }
	var stageBase int = stkBytes
	var rspDelta int = stkBytes + stageBytes + 8
	x64.Sub(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(rspDelta))

	// Step 1: spill stack-bound captures — wholly on the stack (SysV
	//   MEMORY for a >16-byte aggregate or one that didn't fit, or scalar
	//   overflow): shuttle each word via RAX from [RDI+ofs] to [RSP+stkOff].
	// Done first so RDI is still the closure-struct base — step 2
	// (user-arg shift) and step 3's i=0 reg-capture may overwrite it.
	for i := 0; i < f.NumCaptureParams; i = i + 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var regStart int = cc.CallArgRegStart(argTypes, i)
		var stkOff int = cc.CallArgStackOff(argTypes, i)
		var fieldOfs int = f.ClosureStruct.FieldOffset(i)
		if regStart >= 0 || stkOff < 0 { continue }
		var nWords int = callconv.ArgWords(ft)
		for k := 0; k < nWords; k = k + 1 {
			x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RDI, fieldOfs + k * 8, x64.SZ64))
			x64.Mov(a, x64.Mem(x64.RSP, stkOff + k * 8, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
		}
	}

	// Step 2: stage every incoming user word to [RSP + stageBase + 8*w] — words
	// 0..4 from RSI..R9 (RDI holds the closure base), the rest from the caller's
	// stack, which starts at [RSP + rspDelta + 8] (RSP+0 at entry was the return
	// address) — then move each user arg from that memory to its outgoing position
	// per the CallConv.  Reading only memory once outgoing writes begin makes the
	// order free: a capture or user arg that takes no outgoing register (a >16-byte
	// aggregate, MEMORY class) moves the later args DOWN a register while a
	// by-address aggregate's expansion moves them UP, so no fixed register-to-
	// register move order is clobber-free.  RAX shuttles a stack word; step 1's
	// uses of it are done.
	for w := 0; w < nUserWords; w = w + 1 {
		if w < cc.NumGpArgRegs - 1 {
			x64.Mov(a, x64.Mem(x64.RSP, stageBase + w * 8, x64.SZ64), x64.Reg(argReg(1 + w), x64.SZ64))
		} else {
			x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64),
					x64.Mem(x64.RSP, rspDelta + 8 + (w - (cc.NumGpArgRegs - 1)) * 8, x64.SZ64))
			x64.Mov(a, x64.Mem(x64.RSP, stageBase + w * 8, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
		}
	}
	var userArgStart int = f.NumCaptureParams
	var inWord int = 0
	for ui := 0; ui < len(fvTyp.Params); ui = ui + 1 {
		var ut @types.Type = fvTyp.Params[ui].Type
		var argIdx int = userArgStart + ui
		var outRegStart int = cc.CallArgRegStart(argTypes, argIdx)
		var outStkOff int = cc.CallArgStackOff(argTypes, argIdx)
		if isByAddressAggX64(cc, ut) {
			// By-address aggregate: arrives as ONE pointer word
			// (shimInWordsForTypeX64 == 1) but the underlying's real ABI reads
			// ArgWords value-words.  Load the pointer into R11 (a scratch, not a
			// SysV arg reg), then fan its words out to the outgoing register or
			// (MEMORY) stack slots.  SysV does not SPLIT, so the outgoing slot is
			// reg-only or stack-only.
			x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Mem(x64.RSP, stageBase + inWord * 8, x64.SZ64))
			inWord = inWord + 1
			var n int = callconv.ArgWords(ut)
			for k := 0; k < n; k = k + 1 {
				if outRegStart >= 0 {
					x64.Mov(a, x64.Reg(argReg(outRegStart + k), x64.SZ64), x64.Mem(x64.R11, 8 * k, x64.SZ64))
				} else {
					x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.R11, 8 * k, x64.SZ64))
					x64.Mov(a, x64.Mem(x64.RSP, outStkOff + k * 8, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
				}
			}
			continue
		}
		// A scalar: shimInWordsForTypeX64 words both in and out.  A narrow
		// register-destined one is re-extended (abi/03 §3.3): a foreign dispatch
		// caller may leave its high bits dirty.
		var nUw int = shimInWordsForTypeX64(cc, ut)
		for k := 0; k < nUw; k = k + 1 {
			var src int = stageBase + (inWord + k) * 8
			if outRegStart >= 0 {
				x64.Mov(a, x64.Reg(argReg(outRegStart + k), x64.SZ64), x64.Mem(x64.RSP, src, x64.SZ64))
				canonicalizeSubWordSeamX64(a, argReg(outRegStart + k), ut)
			} else {
				x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RSP, src, x64.SZ64))
				x64.Mov(a, x64.Mem(x64.RSP, outStkOff + k * 8, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
			}
		}
		inWord = inWord + nUw
	}

	// Step 3: load register-passed captures: MOV each word into
	// argReg(regStart..regStart+nWords-1).
	// Iterate right-to-left so the i=0 case (which may write RDI
	// when regStart=0) runs last.
	for i := f.NumCaptureParams - 1; i >= 0; i = i - 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var regStart int = cc.CallArgRegStart(argTypes, i)
		var fieldOfs int = f.ClosureStruct.FieldOffset(i)
		if regStart < 0 { continue }
		var nWords int = callconv.ArgWords(ft)
		for k := nWords - 1; k >= 0; k = k - 1 {
			x64.Mov(a, x64.Reg(argReg(regStart + k), x64.SZ64), x64.Mem(x64.RDI, fieldOfs + k * 8, x64.SZ64))
		}
	}

	// Step 4: CALL underlying and rewind the stack.
	a.SetGlobal(fnLabel)
	x64.Call(a, fnLabel)
	x64.Add(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(rspDelta))
	x64.Ret(a)
}
