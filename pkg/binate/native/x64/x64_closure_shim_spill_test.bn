package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the closure-shim stack-spill path (x64_closure_shim_spill.bn).
// The shim builders and ops helpers live in x64_closure_shim_test.bn /
// x64_ops_test.bn.

// Seven int captures (one beyond the GP arg-reg budget on SysV)
// used to fall back to a plain JMP — strictly smaller than the
// simplest real closure shim.  Now that the shim emits a proper
// stack-spill prologue for the overflow word, the over-budget
// case is no longer a fallback: it's a fully-correct call/cleanup
// sequence with more code than the single-capture register-only
// fast path.  Assert the new shape: strictly LARGER than the 1-
// cap fast path, reflecting the SUB/MOV-spill/CALL/ADD/RET that
// the stack-spill path adds.
func TestEmitClosureShimOverBudgetStackSpill_x64() testing.TestResult {
	var fSimple @ir.Func = closureFuncSingleIntCapture_x64()
	var fvSimple @types.Type = funcValueTypeNoArgsRetInt_x64()
	var aSimple @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(aSimple, "underlying_x64", fvSimple, fSimple)
	var bytesSimple int = opsBytes(aSimple)

	var fBig @ir.Func = closureFuncManyCaptures_x64(7)
	var fvBig @types.Type = funcValueTypeNoArgsRetInt_x64()
	var aBig @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(aBig, "underlying_x64", fvBig, fBig)
	var bytesBig int = opsBytes(aBig)

	if bytesBig <= bytesSimple {
		return fail("7-cap stack-spill shim should be larger than 1-cap fast path")
	}
	return ""
}
