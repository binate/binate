package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for x64_closure_shim.bn (B.2 of plan-function-values
// -phase-2.md).  End-to-end behavior is covered by
// conformance/501_capture_value in
// builder-comp_native_x64-comp_native_x64; these tests pin the
// helper-level behavior.

// lookupClosureFunc_x64 returns the Func when it's a closure and
// nil when it isn't or isn't in the module.
func TestLookupClosureFuncFound_x64() testing.TestResult {
	var fields @[]@types.Field
	var closureStruct @types.Type = types.MakeStructType("__closure_x", fields)
	var f @ir.Func = make(ir.Func)
	f.Name = "main.__funclit_0"
	f.IsClosure = true
	f.NumCaptureParams = 1
	f.ClosureStruct = closureStruct
	var mod @ir.Module = ir.NewModule("test")
	mod.AddFunc(f)
	var got @ir.Func = lookupClosureFunc_x64(mod, "main.__funclit_0")
	if got == nil { return fail("expected to find closure func") }
	if !got.IsClosure { return fail("expected IsClosure=true") }
	return ""
}

func TestLookupClosureFuncNotClosure_x64() testing.TestResult {
	var f @ir.Func = make(ir.Func)
	f.Name = "main.Plain"
	f.IsClosure = false
	var mod @ir.Module = ir.NewModule("test")
	mod.AddFunc(f)
	var got @ir.Func = lookupClosureFunc_x64(mod, "main.Plain")
	if got != nil {
		return fail("expected nil for non-closure func")
	}
	return ""
}

func TestLookupClosureFuncMissing_x64() testing.TestResult {
	var mod @ir.Module = ir.NewModule("test")
	var got @ir.Func = lookupClosureFunc_x64(mod, "nonexistent")
	if got != nil {
		return fail("expected nil for missing func")
	}
	return ""
}

// emitClosureShim_x64 with 1 capture and 0 user args emits:
//   MOV RDI, [RDI + 0]      ; load capture0 (self-load is OK on x86)
//   JMP rel32 underlying    ; tail-jump
// x86 has variable-length encoding so we assert sensible-byte
// ranges rather than exact counts.  Each shim should be small;
// over-budget fallback should be smaller than the simplest real
// closure shim.
func TestEmitClosureShim1Cap0UserArgs_x64() testing.TestResult {
	var f @ir.Func = closureFuncSingleIntCapture_x64()
	var fvTyp @types.Type = funcValueTypeNoArgsRetInt_x64()
	var a @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(a, "underlying_x64", fvTyp, f)
	if opsBytes(a) <= 0 {
		return fail("1-cap/0-user shim should emit something")
	}
	return ""
}

// 2 captures + 1 user arg: emits one user-arg shift MOV (j=0:
// argReg(2) <- argReg(1)), two capture-load MOVs (i=1, then i=0),
// and one tail JMP.  Byte count should be strictly larger than
// the 1-cap/0-user case (more instructions emitted).
func TestEmitClosureShim2Cap1UserArg_x64() testing.TestResult {
	var f1 @ir.Func = closureFuncSingleIntCapture_x64()
	var fvTyp1 @types.Type = funcValueTypeNoArgsRetInt_x64()
	var a1 @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(a1, "underlying_x64", fvTyp1, f1)
	var bytes1 int = opsBytes(a1)

	var f2 @ir.Func = closureFuncTwoIntCaptures1UserArg_x64()
	var fvTyp2 @types.Type = funcValueType1IntArg_x64()
	var a2 @asm.Assembler = opsMkAssembler()
	emitClosureShim_x64(a2, "underlying_x64", fvTyp2, f2)
	var bytes2 int = opsBytes(a2)

	if bytes2 <= bytes1 {
		return fail("2-cap/1-user shim should be larger than 1-cap/0-user")
	}
	return ""
}

// ============================================================
// Helpers
// ============================================================

func closureFuncSingleIntCapture_x64() @ir.Func {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var fx @types.Field = make(types.Field)
	fx.Name = "x"
	fx.Type = types.TypInt()
	fields[0] = fx
	var cs @types.Type = types.MakeStructType("__closure_x64_1", fields)
	var f @ir.Func = ir.NewFunc("", "main.__funclit_0", make_slice(@ir.Param, 0),
			make_slice(@types.Type, 0))
	var p @ir.Param = ir.NewParam(f, "x", types.TypInt())
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = p
	f.Params = params
	f.IsClosure = true
	f.NumCaptureParams = 1
	f.ClosureStruct = cs
	return f
}

func closureFuncTwoIntCaptures1UserArg_x64() @ir.Func {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var fx @types.Field = make(types.Field)
	fx.Name = "x"
	fx.Type = types.TypInt()
	fields[0] = fx
	var fy @types.Field = make(types.Field)
	fy.Name = "y"
	fy.Type = types.TypInt()
	fields[1] = fy
	var cs @types.Type = types.MakeStructType("__closure_x64_2", fields)
	var f @ir.Func = ir.NewFunc("", "main.__funclit_0", make_slice(@ir.Param, 0),
			make_slice(@types.Type, 0))
	var p0 @ir.Param = ir.NewParam(f, "x", types.TypInt())
	var p1 @ir.Param = ir.NewParam(f, "y", types.TypInt())
	var p2 @ir.Param = ir.NewParam(f, "z", types.TypInt())
	var params @[]@ir.Param = make_slice(@ir.Param, 3)
	params[0] = p0
	params[1] = p1
	params[2] = p2
	f.Params = params
	f.IsClosure = true
	f.NumCaptureParams = 2
	f.ClosureStruct = cs
	return f
}

func closureFuncManyCaptures_x64(n int) @ir.Func {
	var fields @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		var fi @types.Field = make(types.Field)
		fi.Name = "c"
		fi.Type = types.TypInt()
		fields[i] = fi
	}
	var cs @types.Type = types.MakeStructType("__closure_x64_many", fields)
	var f @ir.Func = ir.NewFunc("", "main.__funclit_0", make_slice(@ir.Param, 0),
			make_slice(@types.Type, 0))
	var params @[]@ir.Param = make_slice(@ir.Param, n)
	for i := 0; i < n; i++ {
		params[i] = ir.NewParam(f, "c", types.TypInt())
	}
	f.Params = params
	f.IsClosure = true
	f.NumCaptureParams = n
	f.ClosureStruct = cs
	return f
}

func funcValueTypeNoArgsRetInt_x64() @types.Type {
	var params @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	return types.MakeFuncValueType(params, results)
}

func funcValueType1IntArg_x64() @types.Type {
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Name = "y"
	p.Type = types.TypInt()
	params[0] = p
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	return types.MakeFuncValueType(params, results)
}
