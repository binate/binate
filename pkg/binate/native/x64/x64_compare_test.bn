package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the integer compare lowering (x64_compare.bn).

// emitCompare OP_LT signed: CMP + SETL + MOVZX.  Pin SETL (0F 9C).
func TestEmitCompareSignedLessThan() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_LT
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitCompare(a, "main", m, ins) {
		return "emitCompare should match OP_LT"
	}
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var found bool = false
	for i := 0; i < a.Sections[0].Len - 1; i++ {
		if data[i] == cast(uint8, 0x0F) && data[i + 1] == cast(uint8, 0x9C) {
			found = true
		}
	}
	if !found {
		return "OP_LT signed should emit SETL (0F 9C)"
	}
	return ""
}

// OP_LT unsigned uses the B (below) cc, NOT L (less).  A regression
// that uses signed compare for uint values with the high bit set
// silently mis-orders them.  Pin SETB (0F 92).
func TestEmitCompareUnsignedLessThan() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var uintTyp @types.Type = types.TypUint64()
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = uintTyp
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = uintTyp
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_LT
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitCompare(a, "main", m, ins) {
		return "emitCompare should match OP_LT unsigned"
	}
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var foundB bool = false
	for i := 0; i < a.Sections[0].Len - 1; i++ {
		if data[i] == cast(uint8, 0x0F) && data[i + 1] == cast(uint8, 0x92) {
			foundB = true
		}
	}
	if !foundB {
		return "OP_LT unsigned should emit SETB (0F 92), not SETL"
	}
	return ""
}

// A branch-fused comparison (rm.FusedCmp[3] set) emits only the flag-setting
// CMP — no SETcc (0F 9x) and no MOVZX — because the following branch tests
// EFLAGS directly.
func TestEmitCompareFusedNoSetcc() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var fc @[]bool = make_slice(bool, 4)
	fc[3] = true
	m.FusedCmp = fc
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_LT
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitCompare(a, "main", m, ins) {
		return "emitCompare should match OP_LT (fused)"
	}
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	for i := 0; i < a.Sections[0].Len - 1; i++ {
		// SETcc opcodes are 0F 90..9F; a fused compare must emit none.
		if data[i] == cast(uint8, 0x0F) && data[i + 1] >= cast(uint8, 0x90) &&
				data[i + 1] <= cast(uint8, 0x9F) {
			return "fused compare must not emit a SETcc"
		}
	}
	return ""
}

// A compare whose constant RHS is marked folded (FoldedImm) emits a
// CMP-IMMEDIATE (opcode 0x81 imm32 or 0x83 imm8, /7) rather than reloading the
// constant and doing a register CMP (opcode 0x39, `CMP r/m, r`) — the value
// rides the instruction, so nothing materializes the constant.
func TestEmitCompareFoldedConstUsesImmediate() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var fc @[]bool = make_slice(bool, 3)
	fc[2] = true // the constant (id 2) folds into the immediate
	m.FoldedImm = fc
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Op = iropcode.OP_CONST_INT
	rhs.IntVal = cast(int64, 42)
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_LT
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	emitCompare(a, "main", m, ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var foundImm bool = false
	var foundReg bool = false
	for i := 0; i < a.Sections[0].Len; i++ {
		if data[i] == cast(uint8, 0x83) || data[i] == cast(uint8, 0x81) { foundImm = true }
		if data[i] == cast(uint8, 0x39) { foundReg = true }
	}
	if !foundImm { return "a folded-constant compare must emit CMP #imm (0x81/0x83)" }
	if foundReg { return "a folded-constant compare must NOT emit a register CMP (0x39)" }
	return ""
}

// opsFoldedCmp emits `lhs < c` over compared type t, with the constant `c`
// (value v) flagged FoldedImm, and returns the assembler.
func opsFoldedCmp(t @types.Type, v int64) @asm.Assembler {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var fc @[]bool = make_slice(bool, 3)
	fc[2] = true
	m.FoldedImm = fc
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Op = iropcode.OP_PARAM
	lhs.Typ = t
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Op = iropcode.OP_CONST_INT
	rhs.IntVal = v
	rhs.Typ = t
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_LT
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	_ = emitCompare(a, "main", m, ins)
	return a
}

// opsHasCmpOpcode reports whether the text section holds any CMP opcode byte:
// 0x39 / 0x3B (register forms) or 0x81 / 0x83 (immediate forms).
func opsHasCmpOpcode(a @asm.Assembler) bool {
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	for i := 0; i < a.Sections[0].Len; i++ {
		var b uint8 = data[i]
		if b == cast(uint8, 0x39) || b == cast(uint8, 0x3B) || b == cast(uint8, 0x81) ||
				b == cast(uint8, 0x83) {
			return true
		}
	}
	return false
}

// A folded compare RHS that does not fit its position records an error and emits
// no CMP: a negative constant in an UNSIGNED compare (a near-2^64 value), and a
// constant past the imm32 range in a signed one.  An in-range signed RHS
// (control) emits without error.
func TestEmitCompareFoldedConstMisfitErrors() testing.TestResult {
	var a @asm.Assembler = opsFoldedCmp(types.TypUint64(), cast(int64, 0) - cast(int64, 5))
	if !a.HasError { return "a folded negative RHS in an unsigned compare must record an error" }
	if opsHasCmpOpcode(a) { return "a misfit folded compare RHS must emit no CMP" }
	a = opsFoldedCmp(types.TypInt(), x64ImmMax + cast(int64, 1))
	if !a.HasError { return "a folded RHS past the imm32 range must record an error" }
	if opsHasCmpOpcode(a) { return "an out-of-range folded compare RHS must emit no CMP" }
	a = opsFoldedCmp(types.TypInt(), cast(int64, 0) - cast(int64, 5))
	if a.HasError { return "a folded negative RHS in a signed compare must emit without error" }
	return ""
}

// emitCompare rejects non-comparison ops.
func TestEmitCompareRejectsNonCompare() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_ADD
	if emitCompare(a, "main", m, ins) {
		return "emitCompare should return false for OP_ADD"
	}
	if opsBytes(a) != 0 {
		return "emitCompare should emit nothing for unmatched op"
	}
	return ""
}

// condForOp mapping: pin EQ/NE signedness-independence + the
// signed/unsigned divergence for LT (L vs B).
func TestCondForOpEqualSignednessIndependent() testing.TestResult {
	if condForOp(iropcode.OP_EQ, true) != condForOp(iropcode.OP_EQ, false) {
		return "OP_EQ cc should not depend on signedness"
	}
	if condForOp(iropcode.OP_NE, true) != condForOp(iropcode.OP_NE, false) {
		return "OP_NE cc should not depend on signedness"
	}
	return ""
}

func TestCondForOpLessThanSignedVsUnsigned() testing.TestResult {
	if condForOp(iropcode.OP_LT, false) == condForOp(iropcode.OP_LT, true) {
		return "OP_LT signed and unsigned must map to different cc"
	}
	return ""
}

// Full per-op condForOp coverage.  A swapped mapping (e.g. OP_LE
// returning CC_L instead of CC_LE) gives a sometimes-correct,
// sometimes-off-by-one comparison that the conformance suite
// might catch only via fuzzy output — the unit-level pin makes
// it loud.  Two parallel arrays of (op, signed-cc, unsigned-cc)
// keep the table dense.
func TestCondForOpFullTable() testing.TestResult {
	var ops @[]int = make_slice(int, 6)
	ops[0] = iropcode.OP_EQ
	ops[1] = iropcode.OP_NE
	ops[2] = iropcode.OP_LT
	ops[3] = iropcode.OP_LE
	ops[4] = iropcode.OP_GT
	ops[5] = iropcode.OP_GE
	var sCC @[]int = make_slice(int, 6)
	sCC[0] = x64.CC_E
	sCC[1] = x64.CC_NE
	sCC[2] = x64.CC_L
	sCC[3] = x64.CC_LE
	sCC[4] = x64.CC_G
	sCC[5] = x64.CC_GE
	var uCC @[]int = make_slice(int, 6)
	uCC[0] = x64.CC_E // EQ/NE are signedness-independent
	uCC[1] = x64.CC_NE
	uCC[2] = x64.CC_B
	uCC[3] = x64.CC_BE
	uCC[4] = x64.CC_A
	uCC[5] = x64.CC_AE
	for i := 0; i < len(ops); i++ {
		if condForOp(ops[i], false) != sCC[i] {
			return "signed cc mapping wrong for some op"
		}
		if condForOp(ops[i], true) != uCC[i] {
			return "unsigned cc mapping wrong for some op"
		}
	}
	return ""
}
