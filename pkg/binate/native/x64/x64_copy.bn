package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// emitCopy lowers OP_COPY — the pure structural move ir.EliminatePhis inserts when
// it destructs SSA (removes OP_PHI).  Copy the source into the phi's register
// (ins.ID); a plain reg-to-reg MOV with no sub-word narrow.  spillAndReset then
// writes ins.ID's slot, so the several copies that share a phi's id (one per
// predecessor edge) all land in its one slot.
func emitCopy(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var src int = getOperand(a, rm, ins.Args[0].ID)
	if src < 0 { return }
	var rd int = nextReg(rm, ins.ID)
	if rd != src {
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Reg(src, x64.SZ64))
	}
}
