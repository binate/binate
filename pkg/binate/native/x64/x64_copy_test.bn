package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// OP_COPY (emitted by iropt.EliminatePhis) is dispatched to emitCopy, which lowers a
// reg-to-reg move — not the unimplemented-op fail-loud, and it emits bytes.
func TestEmitCopyIsMove() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_COPY
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	emitInstr(a, "main", "bn_main__main", m, nilStrings(), ins)
	if a.HasError {
		return "OP_COPY must dispatch to emitCopy, not hit the unimplemented-op fail-loud"
	}
	if a.Sections[0].Len == 0 {
		return "emitCopy should emit a move (loading the source into the dst register)"
	}
	return ""
}

// A float copy between two XMM homes is one MOVAPD, with no GP round-trip — for a
// float64 and for a float32.
func TestEmitCopyFloatBetweenXmmHomesIsMovapd() testing.TestResult {
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypFloat64()
	ts[1] = types.TypFloat32()
	for i := 0; i < len(ts); i++ {
		var a @asm.Assembler = emitMkAsm()
		var rm @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
		var src @ir.Instr = homedArgX64(rm, 1, ts[i], x64.XMM9)
		var dst @ir.Instr = homedArgX64(rm, 2, ts[i], x64.XMM8)
		dst.Op = iropcode.OP_COPY
		dst.Args = make_slice(@ir.Instr, 1)
		dst.Args[0] = src
		emitCopy(a, rm, dst)
		if a.HasError { return fail("a float copy between XMM homes must not error") }
		var ref @asm.Assembler = emitMkAsm()
		x64.Movapd(ref, x64.XMM8, x64.XMM9)
		if a.Sections[0].Len != ref.Sections[0].Len {
			return fail("a float copy between XMM homes must be one movapd xmm8, xmm9")
		}
		for k := 0; k < a.Sections[0].Len; k++ {
			if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
				return fail("a float copy between XMM homes must be one movapd xmm8, xmm9")
			}
		}
	}
	return ""
}
