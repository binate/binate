package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// OP_COPY (emitted by ir.EliminatePhis) is dispatched to emitCopy, which lowers a
// reg-to-reg move — not the unimplemented-op fail-loud, and it emits bytes.
func TestEmitCopyIsMove() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_COPY
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	emitInstr(a, "main", "bn_main__main", m, nilStrings(), ins)
	if a.HasError {
		return "OP_COPY must dispatch to emitCopy, not hit the unimplemented-op fail-loud"
	}
	if a.Sections[0].Len == 0 {
		return "emitCopy should emit a move (loading the source into the dst register)"
	}
	return ""
}
