package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// emitInstr — instruction selection
// ============================================================

// emitInstr lowers one IR instruction.  Calls / C interop and interface /
// function values go to their sub-dispatchers (emitCallInstr, emitValueInstr);
// the rest are dispatched here.  An op nothing handles fails loudly rather than
// emitting nothing.  pkgName is the short package name used for symbol
// mangling (globals, CALL targets); funcSym is the mangled function symbol —
// used for branch targets (per-function block-label prefix).
func emitInstr(a @asm.Assembler, pkgName *[]readonly char, funcSym @[]char, rm @common.RegMap,
		strings @[]ir.StringConst, ins @ir.Instr) {
	currentEmitOp = ins.Op
	// Op families lowered by their own sub-dispatchers (each claims
	// exactly its own ops and declines everything else).
	if emitCallInstr(a, pkgName, rm, ins) { return }
	if emitValueInstr(a, pkgName, rm, ins) { return }
	if ins.Op == iropcode.OP_CONST_INT {
		// A constant folded into its users' immediates (IsFoldedImm) is never read
		// as a register — each consuming CMP, ADD/SUB or AND/OR/XOR carries it
		// inline — so skip its standalone materialization (the allocator likewise
		// left it unhomed).
		if rm.IsFoldedImm(ins.ID) { return }
		var r int = nextReg(rm, ins.ID)
		emitConstInt64(a, r, ins.IntVal)
		return
	}
	if ins.Op == iropcode.OP_CONST_FLOAT {
		var r int = nextReg(rm, ins.ID)
		emitConstFloat(a, rm, r, ins)
		return
	}
	if ins.Op == iropcode.OP_CONST_BOOL {
		var r int = nextReg(rm, ins.ID)
		var v int = 0
		if ins.BoolVal { v = 1 }
		x64.Mov(a, x64.Reg(r, x64.SZ64), x64.Imm(v))
		return
	}
	if ins.Op == iropcode.OP_CONST_STRING {
		var id int = ir.FindStringID(strings, ins.StrVal)
		if id < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		x64.LeaRipLabel(a, x64.Reg(rd, x64.SZ64), common.StringLabel(id))
		return
	}
	if ins.Op == iropcode.OP_ALLOC {
		emitAlloc(a, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_LOAD {
		emitLoad(a, pkgName, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_STORE {
		emitStore(a, pkgName, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_CONST_NIL {
		emitConstNil(a, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_MAKE {
		emitMake(a, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_MAKE_SLICE {
		emitMakeSlice(a, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_BOX {
		emitBox(a, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_REFINC {
		emitRefInc(a, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_REFDEC {
		emitRefDec(a, pkgName, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_GET_FIELD_PTR {
		emitGetFieldPtr(a, pkgName, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_GET_ELEM_PTR {
		emitGetElemPtr(a, pkgName, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_EXTRACT {
		emitExtract(a, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_RODATA_MSLICE || ins.Op == iropcode.OP_RODATA_SLICE {
		emitRodataMSliceOrSlice(a, rm, pkgName, strings, ins)
		return
	}
	if ins.Op == iropcode.OP_RODATA_MSLICE_COPY {
		emitStringToCharsCopy(a, rm, ins, ins.StrVal)
		return
	}
	if ins.Op == iropcode.OP_RODATA_ARRAY {
		emitStringToArray(a, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_BIT_CAST {
		emitBitCastX64(a, pkgName, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_COPY {
		emitCopy(a, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_MANAGED_TO_RAW {
		// @[]T → *[]T: pass the source pointer through; the first 16
		// bytes of a managed-slice ARE the raw-slice representation.
		// MOV on the pointer-to-data-region (no copy of the bytes,
		// since the raw-slice view aliases the managed-slice's first
		// two eightbytes).
		if len(ins.Args) < 1 { return }
		var src int = getOperand(a, rm, ins.Args[0].ID)
		if src < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		if rd != src {
			x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Reg(src, x64.SZ64))
		}
		return
	}
	if ins.Op == iropcode.OP_BOUNDS_CHECK {
		emitBoundsCheck(a, funcSym, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_DIV_CHECK {
		emitDivCheck(a, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_SHIFT_CHECK {
		emitShiftCheck(a, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_CAST {
		// Numeric conversion: amd64 regmap is uniformly 64-bit-wide
		// (like arm64), so explicit narrowing via SHL+SAR/SHR places
		// the target's low-w bits in the destination with the correct
		// sign behavior.  Float casts (either side TYP_FLOAT) route
		// through emitFloatCast, which lights up an XMM scratch only
		// for the conversion proper.
		if len(ins.Args) < 1 || ins.TypeArg == nil { return }
		// emitValOperand (not getOperand): the IsGlobalRef pseudo (ID -1)
		// has no register, so a global-ref cast source (`cast(int, &G)`)
		// would otherwise be dropped, not materialized.  Cf. OP_BIT_CAST.
		var src int = emitValOperand(a, pkgName, rm, ins.Args[0])
		if src < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		if emitFloatCast(a, rm, rd, src, ins.Args[0].Typ, ins.TypeArg) {
			return
		}
		emitCast(a, rd, src, ins.Args[0].Typ, ins.TypeArg)
		return
	}
	if emitMulAddX64(a, rm, ins) { return }
	if emitBinop(a, rm, ins) { return }
	if emitUnop(a, rm, ins) { return }
	if emitCompare(a, pkgName, rm, ins) { return }
	if ins.Op == iropcode.OP_JUMP {
		if ins.Block1 == nil { return }
		x64.Jmp(a, blockLabel(funcSym, ins.Block1.Label))
		return
	}
	if ins.Op == iropcode.OP_BRANCH {
		// Args[0] = cond, Block1 = then-block, Block2 = else-block.
		if ins.Block1 == nil || ins.Block2 == nil || len(ins.Args) < 1 {
			return
		}
		// Fused integer compare: the CMP already set EFLAGS (see emitCompare's
		// IsFusedCmp early-out), so branch on the flags directly with Jcc — no
		// boolean register, no TEST.
		var cond @ir.Instr = ins.Args[0]
		if cond != nil && rm.IsFusedCmp(cond.ID) && len(cond.Args) >= 1 && cond.Args[0] != nil {
			var ct @types.Type = types.StripWrappers(cond.Args[0].Typ)
			var uns bool = ct != nil && ct.IsInteger() && !ct.Signed
			x64.Jcc(a, condForOp(cond.Op, uns), blockLabel(funcSym, ins.Block1.Label))
			x64.Jmp(a, blockLabel(funcSym, ins.Block2.Label))
			return
		}
		// Non-fused: TEST cond, cond ; JNZ then-label ; JMP else-label.
		var condReg int = getOperand(a, rm, ins.Args[0].ID)
		if condReg < 0 { return }
		var condOp x64.Operand = x64.Reg(condReg, x64.SZ64)
		x64.Test(a, condOp, condOp)
		x64.Jcc(a, x64.CC_NZ, blockLabel(funcSym, ins.Block1.Label))
		x64.Jmp(a, blockLabel(funcSym, ins.Block2.Label))
		return
	}
	if ins.Op == iropcode.OP_RETURN {
		emitReturn(a, pkgName, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_STACK_FRAMES {
		emitStackFrames(a, rm, ins)
		return
	}
	if ins.Op == iropcode.OP_SP_RESTORE {
		// Statement-end marker for the bytecode VM.  Native no-op: the frame is
		// function-scoped (sized at prologue), so there's nothing to reclaim
		// mid-function.  Explicit (not the fail-loud tail) — a legitimately
		// VM-only op.  Mirrors aarch64/arm32.
		return
	}
	if ins.Op == iropcode.OP_NIL_CHECK {
		// Opt-in nil-check op (a VM/REPL recovery aid).  Native code stays
		// C-like (a nil deref is UB/SEGV), so it is an explicit no-op, like
		// OP_SP_RESTORE.  Mirrors aarch64/arm32.
		return
	}
	if ins.Op == iropcode.OP_STACK_CHECK || ins.Op == iropcode.OP_STACK_CHECK_FV ||
			ins.Op == iropcode.OP_STACK_CHECK_IM {
		// VM-only recoverable-stack-overflow pre-checks (direct-call / func-value / iface-method).
		// x64 has no recoverable stack overflow (OS guard pages), so explicit
		// no-ops like OP_NIL_CHECK.
		return
	}
	if ins.Op == iropcode.OP_UNREACHABLE {
		// Terminator the IR appends after a block that can't fall through (e.g.
		// every arm returns, or after a panic).  Control never reaches it in a
		// correct program, so it emits nothing.  (arm32 traps with BKPT; x64
		// has no trap emitter here, so this is an explicit no-op — the prior
		// silent-tail behavior, now explicit so the fail-loud tail catches only
		// genuinely-unimplemented ops.)
		return
	}
	// Any other op is not yet implemented in the amd64 backend.  Fail LOUDLY
	// (a.SetError -> EmitObject returns false -> bnc reports a compile error)
	// rather than silently emitting nothing: a silent no-op here would let a
	// program using an unimplemented op compile to a WRONG binary.  Later
	// coverage fills these in by adding a case above, never by relaxing this.
	var msg @[]char
	msg = common.AppendStr(msg, "native amd64: unimplemented IR op ")
	msg = common.AppendStr(msg, iropcode.OpName(ins.Op))
	a.SetError(msg)
}
