package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/builtins/testing"

// emitCallInstr claims its ops: OP_C_ENTRY lowers to a 7-byte RIP-relative LEA,
// and an OP_FUNC_HANDLE with no symbol is claimed but emits nothing (its guard).
func TestEmitCallInstrClaimsItsOps() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = iropcode.OP_C_ENTRY
	ins.StrVal = "main.cmp"
	if !emitCallInstr(a, "main", m, ins) { return "OP_C_ENTRY should be claimed" }
	if a.HasError || a.Sections[0].Len != 7 { return "OP_C_ENTRY should emit a 7-byte LEA-RIP" }
	var b @asm.Assembler = dispatchMkAsm()
	var h @ir.Instr = make(ir.Instr)
	h.ID = 1
	h.Op = iropcode.OP_FUNC_HANDLE
	if !emitCallInstr(b, "main", m, h) { return "OP_FUNC_HANDLE should be claimed" }
	if b.Sections[0].Len != 0 { return "a symbol-less OP_FUNC_HANDLE should emit nothing" }
	return ""
}

// emitCallInstr declines every op outside its family, emitting nothing, so
// emitInstr lowers it instead.
func TestEmitCallInstrDeclinesOtherOps() testing.TestResult {
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	var ops @[]int = make_slice(int, 4)
	ops[0] = iropcode.OP_JUMP
	ops[1] = iropcode.OP_LOAD
	ops[2] = iropcode.OP_IFACE_VALUE
	ops[3] = iropcode.OP_CONST_INT
	for i := 0; i < len(ops); i++ {
		var a @asm.Assembler = dispatchMkAsm()
		var ins @ir.Instr = make(ir.Instr)
		ins.Op = ops[i]
		if emitCallInstr(a, "main", m, ins) { return "a non-call op must be declined" }
		if a.HasError || a.Sections[0].Len != 0 { return "a declined op must emit nothing" }
	}
	return ""
}
