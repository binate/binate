// Unhandled ops (e.g. OP_FUNC_VALUE — Phase 4 territory) are
// silently dropped; the emitted byte count stays zero so the
// surrounding function frame remains coherent.  Protects against
// accidental partial emissions from a regression that mis-
// dispatches an op.
func TestEmitInstrUnknownOpIsNoEmit() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_FUNC_VALUE  // Phase 4
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	if a.Sections[0].Len != 0 {
		return "unhandled op should emit nothing"
	}
	return ""
}

// OP_BIT_CAST routes through dispatch and emits a 64-bit MOV
// (or no-op if src == rd).  Reinterpret-cast semantics on a
// uniformly 64-bit-wide register file — same shape as arm64.
func TestEmitBitCastRoutesAndEmitsMov() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var arg0 @ir.Instr = make(ir.Instr)
	arg0.ID = 1
	arg0.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_BIT_CAST
	ins.Typ = types.MakePointerType(types.TypInt())
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = arg0
	emitInstr(a, "main", "main.foo", m, nilFuncs(),
		nilStrings(), ins)
	if a.Sections[0].Len == 0 {
		return "OP_BIT_CAST should reload src and emit a MOV-to-rd"
	}
	if m.LookupReg(2) < 0 {
		return "OP_BIT_CAST should register rd in the regmap"
	}
	return ""
}

// OP_MANAGED_TO_RAW: pass the source pointer through (the first 16
// bytes of a managed-slice ARE the raw-slice).  Same MOV shape as
// OP_BIT_CAST — just a different IR op selector.
func TestEmitManagedToRawRoutesAndEmitsMov() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// Aggregate src: spill holds pointer to data region.
	m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 0)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 32)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 32)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 40)
	var arg0 @ir.Instr = make(ir.Instr)
	arg0.ID = 1
	arg0.Typ = types.MakeManagedSliceType(types.TypChar())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_MANAGED_TO_RAW
	ins.Typ = types.MakeSliceType(types.TypChar())
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = arg0
	emitInstr(a, "main", "main.foo", m, nilFuncs(),
		nilStrings(), ins)
	if a.Sections[0].Len == 0 {
		return "OP_MANAGED_TO_RAW should emit at least a MOV"
	}
	if m.LookupReg(2) < 0 {
		return "OP_MANAGED_TO_RAW should register rd in the regmap"
	}
	return ""
}

// OP_BOUNDS_CHECK lowers to a call to pkg/builtins/rt.BoundsCheck.  Pin:
// the byte stream ends with a CALL (0xE8) AND the runtime symbol is
// declared as a global on the assembler (so a relocation is emitted).
func TestEmitBoundsCheckCallsRuntime() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var idx @ir.Instr = make(ir.Instr)
	idx.ID = 1
	idx.Typ = types.TypInt()
	var ln @ir.Instr = make(ir.Instr)
	ln.ID = 2
	ln.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_BOUNDS_CHECK
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = idx
	ins.Args[1] = ln
	emitInstr(a, "main", "main.foo", m, nilFuncs(),
		nilStrings(), ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	if n < 5 || data[n-5] != cast(uint8, 0xE8) {
		return "OP_BOUNDS_CHECK should emit a CALL (0xE8) as its tail"
	}
	if a.LookupSymbol("bn_F3_3_pkg8_builtins2_rt1_11_BoundsCheck") < 0 {
		return "OP_BOUNDS_CHECK should declare bn_F3_3_pkg8_builtins2_rt1_11_BoundsCheck as global"
	}
	return ""
}

// OP_SHIFT_CHECK lowers to a CALL of the runtime negative-shift-count
// guard, marshalling the (64-bit) count into the first SysV arg register.
func TestEmitShiftCheckCallsRuntime() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var cnt @ir.Instr = make(ir.Instr)
	cnt.ID = 1
	cnt.Typ = types.TypInt64()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_SHIFT_CHECK
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = cnt
	emitInstr(a, "main", "main.foo", m, nilFuncs(),
		nilStrings(), ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	if n < 5 || data[n-5] != cast(uint8, 0xE8) {
		return "OP_SHIFT_CHECK should emit a CALL (0xE8) as its tail"
	}
	if a.LookupSymbol("bn_F3_3_pkg8_builtins2_rt1_10_ShiftCheck") < 0 {
		return "OP_SHIFT_CHECK should declare bn_F3_3_pkg8_builtins2_rt1_10_ShiftCheck as global"
	}
	return ""
}

// OP_BIT_CAST when src and rd happen to land in the same register:
// the `if rd != src { MOV }` guard must elide the redundant MOV.
// regPool slot 0 is R10; with no prior allocations, getOperand(src)
// picks R10 AND nextReg(rd) picks R10 too — proving the no-op path.
// (Reload via spill always reuses regPool slot 0 since the regmap
// is empty at the start; rd's slot is consumed AFTER the reload's,
// landing on slot 1 = R11 — wait — that's why the guard normally
// doesn't fire.  Use a setup that forces both into the same slot
// by pre-occupying the regmap with src.)
func TestEmitBitCastSameRegElidesMov() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// Pre-register src in R10 (regmap slot 0) so getOperand(src)
	// returns R10 from regmap without a reload — and the subsequent
	// nextReg(rd) picks slot 0 = R10 too.  (m.Next stays 0 when
	// getOperand finds the value in regmap.)
	m.AssignReg(1, x64.R10)
	// Sanity: ensure m.Next is still 0 so nextReg picks regPool(0)=R10.
	m.Next = 0
	var arg0 @ir.Instr = make(ir.Instr)
	arg0.ID = 1
	arg0.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_BIT_CAST
	ins.Typ = types.MakePointerType(types.TypInt())
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = arg0
	emitInstr(a, "main", "main.foo", m, nilFuncs(),
		nilStrings(), ins)
	// With src == rd == R10, the guard should elide the MOV → zero
	// bytes emitted.  Without the guard, a `mov r10, r10` would
	// land — 3 bytes (REX.W + 89 + ModRM).
	if a.Sections[0].Len != 0 {
		return "OP_BIT_CAST with src == rd should emit zero bytes"
	}
	return ""
}
