package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// dispatchMkAsm: minimal assembler for dispatch tests.
func dispatchMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// emitInstr dispatches OP_CONST_INT to emitConstInt64 — verified by
// the produced instruction being non-empty.
func TestEmitInstrConstInt() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CONST_INT
	ins.IntVal = 42
	ins.Typ = types.TypInt()
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	if a.Sections[0].Len == 0 {
		return "OP_CONST_INT should emit MOV r, imm"
	}
	return ""
}

// A bit_cast to a SUB-WORD integer re-narrows the reinterpret MOV to the
// target's value range with a MOVZX (0F B6 for uint8) — a direct use must not
// leak the source's high bits (native half of the bit_cast sub-word leak,
// conformance spec/15-builtins/040).
func TestEmitInstrBitCastSubWordNarrows() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypInt32()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_BIT_CAST
	ins.TypeArg = types.TypUint8()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	if !hasNarrowByte(a, 0xB6) {
		return "bit_cast to uint8 should re-narrow with movzx (0F B6)"
	}
	return ""
}

// Control: a bit_cast to a host-word type (int64) needs no narrow.
func TestEmitInstrBitCastHostWordNoNarrow() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypInt64()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_BIT_CAST
	ins.TypeArg = types.TypInt64()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	if hasNarrowByte(a, 0xB6) {
		return "bit_cast to int64 should not emit a movzx narrow"
	}
	return ""
}

