package "pkg/binate/native/x64"

import "pkg/binate/irbuild"
import "pkg/binate/native/common"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/native/blockplan"
import "pkg/binate/native/place"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A jump or branch to a block a pass dropped from f.Blocks is caught by the jump-target
// check (irbuild.ForeignJumpError) before any of f is emitted.  The dropped block stays
// allocated as long as f (ir.Func.AddedBlocks), so the branch still names it after
// another block is added to f.Blocks, and never the block added.

// droppedDeadFunc returns main.f, `entry: branch true, exit, dead; exit: return; dead:
// return`, with dead.2 dropped from f.Blocks, as a pass pruning blocks drops one, and a
// block dead.3 added after the drop; entry's branch still names dead.2.  Nothing of the
// caller's holds dead.2.
func droppedDeadFunc() @ir.Func {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.f", noP, noR)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var dead @ir.Block = ir.AddBlock(f, "dead")
	var noArgs @[]@ir.Instr
	irbuild.EmitBranch(entry, irbuild.EmitConstBool(entry, true), exit, dead)
	irbuild.EmitReturn(exit, noArgs)
	irbuild.EmitReturn(dead, noArgs)
	var kept @[]@ir.Block = make_slice(@ir.Block, 2)
	kept[0] = entry
	kept[1] = exit
	f.Blocks = kept
	irbuild.EmitReturn(ir.AddBlock(f, "dead"), noArgs)
	return f
}

// returnFunc returns main.g, `entry: return`.
func returnFunc() @ir.Func {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var g @ir.Func = ir.NewFunc("", "main.g", noP, noR)
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(ir.AddBlock(g, "entry"), noArgs)
	return g
}

// A branch left naming a block dropped from f.Blocks fails EmitObject with the jump-target
// error naming the dropped block, after a block of the same name was added to f.Blocks.
// main.g, which comes first, is emitted, so the capture holds the assembler the error is
// left on.
func TestEmitObjectRejectsBranchToDroppedBlock() testing.TestResult {
	setTarget64()
	var f @ir.Func = droppedDeadFunc()
	if len(f.Blocks) != 3 || !containsFV(f.Blocks[2].Label, "dead.3") {
		return "the block added after the drop is dead.3"
	}
	var m @ir.Module = ir.NewModule("\"main\"")
	m.AddFunc(returnFunc())
	m.AddFunc(f)
	var em x64Emitter
	var c placeCapture
	c.inner = &em
	var e *common.ArchEmitter = &c
	var placement place.PlaceOptions
	if common.EmitObject(e, m, "elf", "unused.o", placement, blockplan.BLOCK_LAYOUT_SOURCE) {
		return "EmitObject must fail on the branch to the dropped block"
	}
	if c.emitAsm == nil { return "main.g must be emitted before main.f stops the object" }
	var want *[]readonly char = "native: a branch in main.f (block entry.0) has its else-block "
			"dead.2 outside the function's blocks (a block dropped from them)"
	var msg @[]char = c.emitAsm.ErrorMsg
	if len(msg) != len(want) || !containsFV(msg, want) {
		return buf.Concat("the error must be the jump target's, naming dead.2; got: ", msg)
	}
	return ""
}
