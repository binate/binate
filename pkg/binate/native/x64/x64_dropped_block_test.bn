package "pkg/binate/native/x64"

import "pkg/binate/irbuild"
import "pkg/binate/native/common"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/native/blockplan"
import "pkg/binate/native/place"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A jump or branch to a block a pass dropped from f.Blocks is not caught by the
// jump-target check (the block is still f's), so what stops it is its label, which no
// block of f.Blocks defines -- while the dropped block is alive: ir.AddBlock frees it the
// next time it adds a block to f.Blocks.

// A branch left naming a block dropped from f.Blocks still names an undefined label
// after a block of the same name is added (ir.AddBlock never gives a label of f.Blocks
// twice), so EmitObject fails on the undefined symbol instead of branching to the new
// block.  The test's local keeps the dropped block alive past that AddBlock, which would
// otherwise free it (it rebuilds the function's block builder, the block's last owner).
func TestEmitObjectRejectsBranchToDroppedBlock() testing.TestResult {
	setTarget64()
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.f", noP, noR)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var dead @ir.Block = ir.AddBlock(f, "dead")
	var noArgs @[]@ir.Instr
	irbuild.EmitBranch(entry, irbuild.EmitConstBool(entry, true), exit, dead)
	irbuild.EmitReturn(exit, noArgs)
	irbuild.EmitReturn(dead, noArgs)
	var kept @[]@ir.Block = make_slice(@ir.Block, 2)
	kept[0] = entry
	kept[1] = exit
	f.Blocks = kept
	var later @ir.Block = ir.AddBlock(f, "dead")
	irbuild.EmitReturn(later, noArgs)
	var m @ir.Module = ir.NewModule("\"main\"")
	m.AddFunc(f)
	var em x64Emitter
	var c placeCapture
	c.inner = &em
	var e *common.ArchEmitter = &c
	var placement place.PlaceOptions
	if common.EmitObject(e, m, "elf", "unused.o", placement, blockplan.BLOCK_LAYOUT_SOURCE) {
		return buf.Concat("EmitObject must fail on the dropped block's label; the later block is ",
				later.Label)
	}
	var msg @[]char = c.emitAsm.ErrorMsg
	if !containsFV(msg, "undefined symbol") || !containsFV(msg, dead.Label) {
		return buf.Concat("the error must be the dropped block's undefined label; got: ", msg)
	}
	return ""
}
