package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Memory ops (Phase 3d) — alloc, load, store, GEP — plus the
// Phase 3e global-ref wiring, Phase 3f OP_EXTRACT, and the
// aggregate-STORE routing into Phase 3g's emitStructCopy.
// (Refcount/box/make/make-slice/const-nil/struct-copy live in
// amd64_managed.bn.)
// ============================================================

// emitExtract: OP_EXTRACT — read ins.Index-th field of an aggregate
// SSA value.  Two storage forms:
//
//   - SpillHoldsAggregatePointer(src) — the spill slot holds a
//     pointer to the data (LOAD / MAKE_SLICE / RODATA / named-
//     struct CALL return).  getOperand reloads the pointer; for
//     scalar fields emitScalarLoad reads through it, for aggregate
//     fields produce a sub-pointer with LEA.
//
//   - Multi-return CALL — the spill slot holds the tuple bytes
//     directly (emitCall stored RAX/RDX into [SP+slot+FieldOffset(i)]).
//     Read the field straight from SP + slot + fldOff.
//
// The field offset is `src.Typ.FieldOffset(Index)` rather than
// `8 * Index` because tuple fields can themselves be aggregates or
// sub-word scalars — a `(Tab, int)` multi-return where Tab is 5
// words puts the int at offset 40, not 8.
func emitExtract(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var src @ir.Instr = ins.Args[0]
	var rd int = nextReg(rm, ins.ID)
	var fieldOff int = 8 * ins.Index
	var exTyp @types.Type = types.StripWrappers(src.Typ)
	if exTyp != nil && exTyp.Kind == types.TYP_STRUCT {
		fieldOff = exTyp.FieldOffset(ins.Index)
	}
	var sz int = 8
	if ins.Typ != nil { sz = ins.Typ.SizeOf() }
	if sz <= 0 { sz = 8 }
	var sgnTyp @types.Type = types.StripWrappers(ins.Typ)
	var signed bool = sgnTyp != nil && sgnTyp.Signed
	if common.SpillHoldsAggregatePointer(src) {
		var ptr int = getOperand(a, rm, src.ID)
		if ptr < 0 { return }
		if common.IsAggregateTyp(ins.Typ) {
			x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.Mem(ptr, fieldOff, x64.SZ64))
		} else {
			emitScalarLoad(a, rd, ptr, fieldOff, sz, signed)
		}
		return
	}
	var srcSlot int = rm.LookupSpill(src.ID)
	if srcSlot < 0 { return }
	if common.IsAggregateTyp(ins.Typ) {
		x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.Mem(x64.RSP, srcSlot + fieldOff, x64.SZ64))
	} else {
		emitScalarLoad(a, rd, x64.RSP, srcSlot + fieldOff, sz, signed)
	}
}

// isGlobalRef reports whether ins is the pseudo-Instr the IR emits
// for a package-level variable reference (carries IsGlobalRef set
// by the IR generator's lookupVar global-fallback path).  These
// reach their address via RIP-relative LEA rather than via spill
// reloads or alloca pointer materialisation.
func isGlobalRef(ins @ir.Instr) bool {
	if ins == nil { return false }
	return ins.IsGlobalRef
}

// emitGlobalAddr emits a RIP-relative LEA that places the runtime
// address of a package-level variable in rd.  The PC-relative
// FIX_REL32 fixup carried in the LEA becomes an R_X86_64_PC32
// relocation in the ELF — the linker resolves it to the .data
// (or .bss) address of the global's symbol.
func emitGlobalAddr(a @asm.Assembler, pkgName *[]readonly char, rd int, ins @ir.Instr) {
	var label @[]char = globalSymFor(pkgName, ins.StrVal)
	a.SetGlobal(label)
	x64.LeaRipLabel(a, x64.Reg(rd, x64.SZ64), label)
}

// emitCGlobalAddr places the ADDRESS of an external C global (__c_global)
// into rd via a GOT-indirect `mov rd, [rip + sym@GOTPCREL]`.  Unlike
// emitGlobalAddr, the symbol is a VERBATIM C name (symPrefixed only — no Binate
// mangling), and it is reached through the GOT because the datum lives in
// another DSO (libc) under this PIE target — a direct RIP-relative reference to
// a cross-DSO datum is rejected by the PIE linker.  MovGotPcRel LOADS the GOT
// slot's contents (the symbol's real address); a LEA would leave the slot's own
// address in rd (an off-by-one-indirection).  The symbol is registered
// global-but-undefined (SetGlobal without DefineLabel) so the linker binds it
// to the real external datum.
func emitCGlobalAddr(a @asm.Assembler, rd int, symbol *[]readonly char) {
	var label @[]char = symPrefixed(symbol)
	a.SetGlobal(label)
	x64.MovGotPcRel(a, x64.Reg(rd, x64.SZ64), label)
}

// emitAlloc: OP_ALLOC — aggregate allocas zero-init their storage
// to match the LLVM `store ... zeroinitializer` shape (matters when
// downstream code reads a field before storing).  Scalar allocas
// are uninitialised; the following STORE fills them.
//
// Zero-init lowering: `mov qword ptr [rsp + off + 8*i], 0` for
// each 8-byte word.  Inline for small slots; matches aa64's
// approach (str xzr, [sp, #off + 8*i]).
func emitAlloc(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if common.IsAggregateTyp(ins.TypeArg) {
		var off int = rm.LookupAlloc(ins.ID)
		var sz int = rm.LookupAllocSize(ins.ID)
		if off >= 0 && sz > 0 {
			for bo := 0; bo < sz; bo = bo + 8 {
				x64.Mov(a, x64.Mem(x64.RSP, off + bo, x64.SZ64), x64.Imm(0))
			}
		}
	}
}

// emitScalarLoad: size-dispatched `mov` / `movzx` / `movsxd` for
// 1/2/4/8-byte loads.  Sub-8-byte loads with `signed=false` use
// MOVZX (which zero-extends in one instruction); with `signed=true`
// use MOVSX (sign-extend).  4-byte signed uses MOVSXD; 4-byte
// unsigned uses MOV r32, which the CPU automatically zero-extends
// to 64 bits.  8-byte uses MOV r64.
func emitScalarLoad(a @asm.Assembler, rd int, base int, off int, sz int, signed bool) {
	if isFpReg(rd) {
		// FP-homed destination: load straight into the XMM register (a float is 4
		// or 8 bytes; sign has no meaning — it copies the bit pattern).  Movss
		// zero-extends the f32 upper bits; Movlps loads the f64 low quadword.
		if sz == 8 {
			x64.Movlps_load(a, rd, x64.Mem(base, off, x64.SZ64))
		} else {
			x64.Movss_load(a, rd, x64.Mem(base, off, x64.SZ32))
		}
		return
	}
	if sz == 1 {
		if signed {
			x64.Movsx(a, x64.Reg(rd, x64.SZ64), x64.Mem(base, off, x64.SZ8))
		} else {
			x64.Movzx(a, x64.Reg(rd, x64.SZ64), x64.Mem(base, off, x64.SZ8))
		}
		return
	}
	if sz == 2 {
		if signed {
			x64.Movsx(a, x64.Reg(rd, x64.SZ64), x64.Mem(base, off, x64.SZ16))
		} else {
			x64.Movzx(a, x64.Reg(rd, x64.SZ64), x64.Mem(base, off, x64.SZ16))
		}
		return
	}
	if sz == 4 {
		if signed {
			x64.Movsxd(a, x64.Reg(rd, x64.SZ64), x64.Mem(base, off, x64.SZ32))
		} else {
			// MOV r32, m32 — CPU zero-extends to 64 bits.
			x64.Mov(a, x64.Reg(rd, x64.SZ32), x64.Mem(base, off, x64.SZ32))
		}
		return
	}
	x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Mem(base, off, x64.SZ64))
}

// emitScalarStore: size-dispatched store.  x64.Mov picks the right
// opcode + size prefix when src is given the matching width.
func emitScalarStore(a @asm.Assembler, rt int, base int, off int, sz int) {
	if isFpReg(rt) {
		// FP-homed source: store straight from the XMM register.
		if sz == 8 {
			x64.Movlps_store(a, x64.Mem(base, off, x64.SZ64), rt)
		} else {
			x64.Movss_store(a, x64.Mem(base, off, x64.SZ32), rt)
		}
		return
	}
	if sz == 1 {
		x64.Mov(a, x64.Mem(base, off, x64.SZ8), x64.Reg(rt, x64.SZ8))
		return
	}
	if sz == 2 {
		x64.Mov(a, x64.Mem(base, off, x64.SZ16), x64.Reg(rt, x64.SZ16))
		return
	}
	if sz == 4 {
		x64.Mov(a, x64.Mem(base, off, x64.SZ32), x64.Reg(rt, x64.SZ32))
		return
	}
	x64.Mov(a, x64.Mem(base, off, x64.SZ64), x64.Reg(rt, x64.SZ64))
}

// emitAggMemcpyX64 copies `sz` bytes from [srcPtr] to [dstPtr].  It moves 16
// bytes at a time with a MOVUPS pair through an XMM scratch (two words per
// instruction, unaligned-safe), then any trailing 8-byte word with a GP MOV
// through tmpGP.  FP_SCRATCH_A is safe as the wide scratch here: float SSA
// values live in GP stack slots (never cached in XMM across instructions) and
// the aggregate-copy path runs against a reset register cache, so no live float
// occupies it.  tmpGP must differ from srcPtr/dstPtr.  This is the one
// aggregate-move primitive for the backend: both the aggregate load (into its
// own region) and the aggregate store (OP_STORE struct-copy) route through it.
func emitAggMemcpyX64(a @asm.Assembler, dstPtr int, srcPtr int, sz int, tmpGP int) {
	var off int = 0
	for off + 16 <= sz {
		x64.Movups_load(a, FP_SCRATCH_A, x64.Mem(srcPtr, off, x64.SZ64))
		x64.Movups_store(a, x64.Mem(dstPtr, off, x64.SZ64), FP_SCRATCH_A)
		off = off + 16
	}
	for off + 8 <= sz {
		x64.Mov(a, x64.Reg(tmpGP, x64.SZ64), x64.Mem(srcPtr, off, x64.SZ64))
		x64.Mov(a, x64.Mem(dstPtr, off, x64.SZ64), x64.Reg(tmpGP, x64.SZ64))
		off = off + 8
	}
	// A final sub-word tail (sz not a multiple of 8) is copied as one full-word
	// access, matching the prior word-at-a-time loop's over-read of the padding.
	if off < sz {
		x64.Mov(a, x64.Reg(tmpGP, x64.SZ64), x64.Mem(srcPtr, off, x64.SZ64))
		x64.Mov(a, x64.Mem(dstPtr, off, x64.SZ64), x64.Reg(tmpGP, x64.SZ64))
	}
}

// emitAggMemcpySafeX64 is an OVERLAP-SAFE aggregate copy: it loads the WHOLE source
// into registers first (up to two 16-byte MOVUPS chunks in the XMM scratches plus a
// remainder word or two in GP), THEN stores — so a copy whose dst aliases (overlaps)
// its src (an elided raw-pointer `*dst = *src`) reads all of the source before
// writing any of the destination.  Used by emitStructCopy, whose source may be an
// aliased (elided) load.  A copy larger than 32 bytes delegates to the interleaved
// emitAggMemcpyX64 — reached only by NON-aliasing copies, since the S-adjacent
// elision that can alias is size-capped (<= 16 bytes) well within it.  Same op count
// as the interleaved form, just reordered.
func emitAggMemcpySafeX64(a @asm.Assembler, rm @common.RegMap, dstPtr int, srcPtr int, sz int,
		tmpGP int) {
	if sz <= 0 || sz > 32 {
		emitAggMemcpyX64(a, dstPtr, srcPtr, sz, tmpGP)
		return
	}
	var nchunks int = sz / 16
	var remStart int = nchunks * 16
	var remWords int = (sz - remStart + 7) / 8
	var g0 int = tmpGP
	var g1 int = tmpGP
	if remWords >= 2 { g1 = scratchReg(rm) }
	if nchunks >= 1 { x64.Movups_load(a, FP_SCRATCH_A, x64.Mem(srcPtr, 0, x64.SZ64)) }
	if nchunks >= 2 { x64.Movups_load(a, FP_SCRATCH_B, x64.Mem(srcPtr, 16, x64.SZ64)) }
	if remWords >= 1 { x64.Mov(a, x64.Reg(g0, x64.SZ64), x64.Mem(srcPtr, remStart, x64.SZ64)) }
	if remWords >= 2 {
		x64.Mov(a, x64.Reg(g1, x64.SZ64), x64.Mem(srcPtr, remStart + 8, x64.SZ64))
	}
	if nchunks >= 1 { x64.Movups_store(a, x64.Mem(dstPtr, 0, x64.SZ64), FP_SCRATCH_A) }
	if nchunks >= 2 { x64.Movups_store(a, x64.Mem(dstPtr, 16, x64.SZ64), FP_SCRATCH_B) }
	if remWords >= 1 { x64.Mov(a, x64.Mem(dstPtr, remStart, x64.SZ64), x64.Reg(g0, x64.SZ64)) }
	if remWords >= 2 {
		x64.Mov(a, x64.Mem(dstPtr, remStart + 8, x64.SZ64), x64.Reg(g1, x64.SZ64))
	}
}

// emitAggLoad materializes an aggregate OP_LOAD: it copies the loaded
// bytes into the load's OWN data region (reserved by PlanFrame) and
// leaves rd pointing at that region.  A bare pointer pass-through aliases
// the source object, which dangles when the source is a local the
// function's cleanup RefDecs before the loaded value is consumed — e.g.
// `return container[i]`, whose element header lives in `container`'s
// backing and is read into the sret buffer only after `container`'s dtor
// has freed that backing.  Materializing at the load point (before any
// cleanup) gives the value its own storage, matching the LLVM backend.
func emitAggLoad(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr,
		arg @ir.Instr) {
	var rd int = nextReg(rm, ins.ID)
	// Source address of the aggregate being loaded.
	var srcPtr int
	var srcAlloc int = rm.LookupAlloc(arg.ID)
	if srcAlloc >= 0 {
		srcPtr = scratchReg(rm)
		x64.Lea(a, x64.Reg(srcPtr, x64.SZ64), x64.Mem(x64.RSP, srcAlloc, x64.SZ64))
	} else if isGlobalRef(arg) {
		srcPtr = scratchReg(rm)
		emitGlobalAddr(a, pkgName, srcPtr, arg)
	} else {
		srcPtr = getOperand(a, rm, arg.ID)
	}
	if srcPtr < 0 { return }
	// Destination: the load's own region.  PlanFrame reserves one for
	// every aggregate load; the myAlloc < 0 fallback keeps behavior no
	// worse than the old aliasing form should that ever not hold.
	var myAlloc int = rm.LookupAlloc(ins.ID)
	if myAlloc < 0 {
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Reg(srcPtr, x64.SZ64))
		return
	}
	x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.Mem(x64.RSP, myAlloc, x64.SZ64))
	emitAggMemcpyX64(a, rd, srcPtr, ins.Typ.SizeOf(), scratchReg(rm))
}

// emitLoad: OP_LOAD — scalar loads dispatch by size + signedness to
// emitScalarLoad; aggregate loads materialize into their own region
// (emitAggLoad).  Package-level globals reach their address via
// RIP-relative LEA to the global's ELF symbol.
func emitLoad(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var arg @ir.Instr = ins.Args[0]
	if common.IsAggregateTyp(ins.Typ) {
		emitAggLoad(a, pkgName, rm, ins, arg)
		return
	}
	if arg.Op == iropcode.OP_GET_FIELD_PTR && rm.IsFusableFieldGep(arg.ID) {
		emitFusedFieldLoad(a, rm, ins, arg)
		return
	}
	var sz int = 8
	if ins.Typ != nil { sz = ins.Typ.SizeOf() }
	if sz <= 0 { sz = 8 }
	var sgnTyp @types.Type = types.StripWrappers(ins.Typ)
	var signed bool = sgnTyp != nil && sgnTyp.Signed
	var off int = rm.LookupAlloc(arg.ID)
	if off >= 0 {
		var rd int = nextReg(rm, ins.ID)
		emitScalarLoad(a, rd, x64.RSP, off, sz, signed)
		return
	}
	if isGlobalRef(arg) {
		var addr int = scratchReg(rm)
		emitGlobalAddr(a, pkgName, addr, arg)
		var rd int = nextReg(rm, ins.ID)
		emitScalarLoad(a, rd, addr, 0, sz, signed)
		return
	}
	var ptr int = getOperand(a, rm, arg.ID)
	if ptr < 0 { return }
	var rd int = nextReg(rm, ins.ID)
	emitScalarLoad(a, rd, ptr, 0, sz, signed)
}

// emitStore: OP_STORE — scalar stores dispatch by size to
// emitScalarStore.  Aggregate stores route to emitStructCopy
// (Phase 3g) for an inline qword-MOV memcpy.  Package-level
// globals reach their address via RIP-relative LEA.
func emitStore(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	if common.IsAggregateTyp(ins.Args[1].Typ) {
		emitStructCopy(a, pkgName, rm, ins)
		return
	}
	if ins.Args[0].Op == iropcode.OP_GET_FIELD_PTR && rm.IsFusableFieldGep(ins.Args[0].ID) {
		emitFusedFieldStore(a, pkgName, rm, ins, ins.Args[0])
		return
	}
	var sz int = 8
	if ins.Args[1].Typ != nil { sz = ins.Args[1].Typ.SizeOf() }
	if sz <= 0 { sz = 8 }
	var off int = rm.LookupAlloc(ins.Args[0].ID)
	// An FP-homed float value stores straight from its XMM home (emitScalarStore
	// picks Movlps/Movss for an XMM source); anything else keeps the GP path.
	// emitValOperand (not bare getOperand) so storing a global address as the
	// VALUE (`s[0] = &H`, `bx.p = &H`, `Box{&G}`) materializes it — bare
	// getOperand misses the IsGlobalRef pseudo and stores garbage.
	var valReg int = -1
	if isFloatTyp(ins.Args[1].Typ) && isFpReg(rm.LookupHome(ins.Args[1].ID)) {
		valReg = rm.LookupHome(ins.Args[1].ID)
	} else {
		valReg = emitValOperand(a, pkgName, rm, ins.Args[1])
	}
	if valReg < 0 { return }
	if off >= 0 {
		emitScalarStore(a, valReg, x64.RSP, off, sz)
		return
	}
	if isGlobalRef(ins.Args[0]) {
		var addr int = scratchReg(rm)
		emitGlobalAddr(a, pkgName, addr, ins.Args[0])
		emitScalarStore(a, valReg, addr, 0, sz)
		return
	}
	var ptr int = getOperand(a, rm, ins.Args[0].ID)
	if ptr < 0 { return }
	emitScalarStore(a, valReg, ptr, 0, sz)
}

// emitGetFieldPtr: OP_GET_FIELD_PTR — compute base + FieldOffset.
// Alloca base: LEA rd, [rsp + allocOff + fieldOff] (one instr).
// Otherwise: LEA rd, [base + fieldOff].
//
// Slice bases (raw or managed) get a flat 8 * Index offset — fields
// are data, len, [refptr, backingLen] in word-sized slots, matching
// types.SliceDataOffset / MSliceDataOffset etc.
func emitGetFieldPtr(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	// A fusable field GEP folds into its sole consuming load/store's constant
	// displacement (emitFusedFieldLoad / emitFusedFieldStore rederive the address
	// from this GEP's base + FieldByteOffset), so emit nothing here.
	if rm.IsFusableFieldGep(ins.ID) { return }
	var fieldOff int
	var baseTyp @types.Type = common.StructTypeOf(ins.Args[0])
	if baseTyp != nil {
		fieldOff = baseTyp.FieldOffset(ins.Index)
	} else if common.IsSliceFieldBase(ins.Args[0]) {
		fieldOff = 8 * ins.Index
	} else {
		return
	}
	var rd int = nextReg(rm, ins.ID)
	var allocOff int = rm.LookupAlloc(ins.Args[0].ID)
	if allocOff >= 0 {
		x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.Mem(x64.RSP, allocOff + fieldOff, x64.SZ64))
		return
	}
	if isGlobalRef(ins.Args[0]) {
		emitGlobalAddr(a, pkgName, rd, ins.Args[0])
		if fieldOff != 0 {
			x64.Add(a, x64.Reg(rd, x64.SZ64), x64.Imm(fieldOff))
		}
		return
	}
	var ptr int = getOperand(a, rm, ins.Args[0].ID)
	if ptr < 0 { return }
	if fieldOff == 0 {
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Reg(ptr, x64.SZ64))
	} else {
		x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.Mem(ptr, fieldOff, x64.SZ64))
	}
}

// isSibScale reports whether sz is a power-of-2 ∈ {1, 2, 4, 8} —
// i.e., a valid SIB scale.  Used by emitGetElemPtr to decide
// between the one-instruction LEA-with-SIB form and the slower
// IMUL + ADD fallback.
func isSibScale(sz int) bool {
	return sz == 1 || sz == 2 || sz == 4 || sz == 8
}

// emitGetElemPtr: OP_GET_ELEM_PTR — compute base + idx * elemSize.
// When elemSize ∈ {1, 2, 4, 8} the SIB addressing mode lets a
// single LEA compute the address: `lea rd, [base + idx*scale]`.
// Otherwise fall back to `imul tmp, idx, elemSize ; lea rd,
// [base + tmp]`.
func emitGetElemPtr(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	var elemSize int = common.ElemSizeOf(ins)
	if elemSize <= 0 { return }
	var idx int = getOperand(a, rm, ins.Args[1].ID)
	if idx < 0 { return }

	if isSibScale(elemSize) {
		var rd int = nextReg(rm, ins.ID)
		var allocOff int = rm.LookupAlloc(ins.Args[0].ID)
		if allocOff >= 0 {
			x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.MemIdx(x64.RSP, idx, elemSize, allocOff, x64.SZ64))
			return
		}
		if isGlobalRef(ins.Args[0]) {
			var base int = scratchReg(rm)
			emitGlobalAddr(a, pkgName, base, ins.Args[0])
			x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.MemIdx(base, idx, elemSize, 0, x64.SZ64))
			return
		}
		var base int = getOperand(a, rm, ins.Args[0].ID)
		if base < 0 { return }
		x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.MemIdx(base, idx, elemSize, 0, x64.SZ64))
		return
	}
	// Non-SIB elemSize: compute idx * elemSize into a scratch, then
	// LEA the result.
	var byteOff int = scratchReg(rm)
	x64.Mov(a, x64.Reg(byteOff, x64.SZ64), x64.Reg(idx, x64.SZ64))
	x64.Imul3(a, x64.Reg(byteOff, x64.SZ64), x64.Reg(byteOff, x64.SZ64), elemSize)
	var rd int = nextReg(rm, ins.ID)
	var allocOff int = rm.LookupAlloc(ins.Args[0].ID)
	if allocOff >= 0 {
		x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.MemIdx(x64.RSP, byteOff, 1, allocOff, x64.SZ64))
		return
	}
	if isGlobalRef(ins.Args[0]) {
		var base int = scratchReg(rm)
		emitGlobalAddr(a, pkgName, base, ins.Args[0])
		x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.MemIdx(base, byteOff, 1, 0, x64.SZ64))
		return
	}
	var base int = getOperand(a, rm, ins.Args[0].ID)
	if base < 0 { return }
	x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.MemIdx(base, byteOff, 1, 0, x64.SZ64))
}
