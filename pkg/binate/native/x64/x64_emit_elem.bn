package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/native/strength"
import "pkg/binate/types"

// Element- and field-pointer lowering (OP_GET_ELEM_PTR / OP_GET_FIELD_PTR).

// emitGetFieldPtr: OP_GET_FIELD_PTR — compute base + the field's offset.
// Alloca base: LEA rd, [rsp + allocOff + fieldOff] (one instr).
// Otherwise: LEA rd, [base + fieldOff].  An offset past a displacement or an
// immediate (frameNear, immNear) goes through frameLea's far path.
//
// Slice bases (raw or managed) get a flat 8 * Index offset — fields
// are data, len, [refptr, backingLen] in word-sized slots, matching
// types.SliceDataOffset / MSliceDataOffset etc.
func emitGetFieldPtr(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	// A fusable field GEP folds into its sole consuming load/store's constant
	// displacement (emitFusedFieldLoad / emitFusedFieldStore rederive the address
	// from this GEP's base + FieldByteOffset), so emit nothing here.
	if rm.IsFusableFieldGep(ins.ID) { return }
	var fieldOff int64
	var baseTyp @types.Type = common.StructTypeOf(ins.Args[0])
	if baseTyp != nil {
		fieldOff = baseTyp.Offset(ins.Index)
	} else if common.IsSliceFieldBase(ins.Args[0]) {
		fieldOff = cast(int64, 8 * ins.Index)
	} else {
		return
	}
	var rd int = nextReg(rm, ins.ID)
	var allocOff int64 = rm.LookupAlloc(ins.Args[0].ID)
	if allocOff >= 0 {
		frameLea(a, rd, x64.RSP, allocOff + fieldOff)
		return
	}
	if isGlobalRef(ins.Args[0]) {
		emitGlobalAddr(a, pkgName, rd, ins.Args[0])
		if immNear(fieldOff) && fieldOff != 0 {
			x64.Add(a, x64.Reg(rd, x64.SZ64), x64.Imm(cast(int, fieldOff)))
		} else if fieldOff != 0 {
			frameLea(a, rd, rd, fieldOff)
		}
		return
	}
	var ptr int = getOperand(a, rm, ins.Args[0].ID)
	if ptr < 0 { return }
	if fieldOff == 0 {
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Reg(ptr, x64.SZ64))
	} else {
		frameLea(a, rd, ptr, fieldOff)
	}
}

// isSibScale reports whether sz is a power-of-2 ∈ {1, 2, 4, 8} —
// i.e., a valid SIB scale.  Used by emitGetElemPtr to decide
// between the one-instruction LEA-with-SIB form and the
// scale-into-a-scratch fallback.
func isSibScale(sz int64) bool {
	return sz == 1 || sz == 2 || sz == 4 || sz == 8
}

// emitGetElemPtr: OP_GET_ELEM_PTR — compute base + idx * elemSize.
// When elemSize ∈ {1, 2, 4, 8} the SIB addressing mode lets a
// single LEA compute the address: `lea rd, [base + idx*scale]`.
// Otherwise scale in the result register first — `shl rd, log2(elemSize)`
// for a larger power of two, `imul rd, rd, elemSize` for any other size
// (after `mov rd, idx`; emitMulConstX64) — then `lea rd, [base + rd]`.
func emitGetElemPtr(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	var elemSize int64 = common.ElemSizeOf(ins)
	if elemSize <= 0 { return }
	var idx int = getOperand(a, rm, ins.Args[1].ID)
	if idx < 0 { return }

	if isSibScale(elemSize) {
		// The LEA reads idx and the base before writing rd, so an unhomed rd
		// takes over idx's reload register (nextRegReusing): two scratch at most.
		var scale int = cast(int, elemSize)
		var rd int = nextRegReusing(rm, ins.ID, idx, ins.Args[1].ID)
		var allocOff int64 = rm.LookupAlloc(ins.Args[0].ID)
		if allocOff >= 0 {
			var r farRef = farBegin(a, x64.RSP, allocOff, 1, regBit(rd) | regBit(idx), 0)
			x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.MemIdx(r.base, idx, scale, r.disp, x64.SZ64))
			farEnd(a, r)
			return
		}
		if isGlobalRef(ins.Args[0]) {
			var base int = scratchReg(rm)
			emitGlobalAddr(a, pkgName, base, ins.Args[0])
			x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.MemIdx(base, idx, scale, 0, x64.SZ64))
			return
		}
		var base int = getOperand(a, rm, ins.Args[0].ID)
		if base < 0 { return }
		x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.MemIdx(base, idx, scale, 0, x64.SZ64))
		return
	}
	// Non-SIB elemSize: compute idx * elemSize in the result register, then add
	// the base with a LEA.  The offset needs no scratch of its own, so with a
	// spilled index and base the GEP takes two scratch registers: an unhomed rd
	// takes over idx's reload register (nextRegReusing).  rd is distinct from the
	// base: the result is born at this instruction while the base is read here, so
	// the allocator never gives them the same home, and a base reload takes a
	// register rd does not hold.
	var rd int = nextRegReusing(rm, ins.ID, idx, ins.Args[1].ID)
	if rd != idx { x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Reg(idx, x64.SZ64)) }
	var shift int = strength.Pow2Log(cast(uint64, elemSize))
	if shift >= 0 {
		x64.Shl(a, x64.Reg(rd, x64.SZ64), x64.Imm(shift))
	} else {
		emitMulConstX64(a, rd, elemSize)
	}
	var allocOff int64 = rm.LookupAlloc(ins.Args[0].ID)
	if allocOff >= 0 {
		var r farRef = farBegin(a, x64.RSP, allocOff, 1, regBit(rd), 0)
		x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.MemIdx(r.base, rd, 1, r.disp, x64.SZ64))
		farEnd(a, r)
		return
	}
	if isGlobalRef(ins.Args[0]) {
		var gbase int = scratchReg(rm)
		emitGlobalAddr(a, pkgName, gbase, ins.Args[0])
		x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.MemIdx(gbase, rd, 1, 0, x64.SZ64))
		return
	}
	var base int = getOperand(a, rm, ins.Args[0].ID)
	if base < 0 { return }
	x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.MemIdx(base, rd, 1, 0, x64.SZ64))
}

// emitMulConstX64 multiplies rd by c: IMUL's sign-extended 32-bit immediate when c
// fits it (immNear), else through a scratch register loaded with c and saved around
// the multiply in the red zone's bottom slot, as a far frame access saves one
// (farBegin).
func emitMulConstX64(a @asm.Assembler, rd int, c int64) {
	if immNear(c) {
		x64.Imul3(a, x64.Reg(rd, x64.SZ64), x64.Reg(rd, x64.SZ64), cast(int, c))
		return
	}
	var s int = farScratch(regBit(rd))
	x64.Mov(a, x64.Mem(x64.RSP, farSaveSlotOff, x64.SZ64), x64.Reg(s, x64.SZ64))
	emitConstInt64(a, s, c)
	x64.Imul2(a, x64.Reg(rd, x64.SZ64), x64.Reg(s, x64.SZ64))
	x64.Mov(a, x64.Reg(s, x64.SZ64), x64.Mem(x64.RSP, farSaveSlotOff, x64.SZ64))
}
