package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Phase 3a byte-shape tests for emitFunc / emitPrologue /
// emitEpilogueAndRet — every empty-body function should produce
// exactly the SysV-AMD64 prologue + epilogue + ret sequence.  These
// pins protect the prologue/epilogue convention through Phase 3b–3h
// (which only add behaviour for non-empty bodies).

// Empty-body function: no frame, no body.  Encoded:
//   55              push %rbp
//   48 89 e5        mov  %rsp, %rbp
//   48 89 ec        mov  %rbp, %rsp
//   5d              pop  %rbp
//   c3              ret
// frameSize is 0 (no params, no locals) so no `sub rsp, imm`
// between prologue and body.  Total: 9 bytes.
func TestEmitFuncEmptyBodyByteShape() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.main", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	b.EmitReturn(noArgs)
	emitFunc(a, "main", f, nilStrings())
	if a.Sections[0].Len != 9 {
		return fail("empty function should emit 9 bytes (prologue 4 + epilogue 5)")
	}
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	if data[0] != cast(uint8, 0x55) { return fail("byte 0 should be push rbp (0x55)") }
	if data[1] != cast(uint8, 0x48) { return fail("byte 1 should be REX.W (0x48)") }
	if data[2] != cast(uint8, 0x89) { return fail("byte 2 should be MOV r/m,r (0x89)") }
	if data[3] != cast(uint8, 0xe5) { return fail("byte 3 should be ModRM mov rbp,rsp (0xe5)") }
	if data[4] != cast(uint8, 0x48) { return fail("byte 4 should be REX.W (0x48)") }
	if data[5] != cast(uint8, 0x89) { return fail("byte 5 should be MOV r/m,r (0x89)") }
	if data[6] != cast(uint8, 0xec) { return fail("byte 6 should be ModRM mov rsp,rbp (0xec)") }
	if data[7] != cast(uint8, 0x5d) { return fail("byte 7 should be pop rbp (0x5d)") }
	if data[8] != cast(uint8, 0xc3) { return fail("byte 8 should be ret (0xc3)") }
	return ""
}

// #[c_export] mints a second, unmangled symbol at the function's entry — the
// SAME section + offset as the mangled symbol — as a strong global.  No
// enclosing EmitObject, so the x64 unit-test default prefix is ELF-bare: the
// alias name stays `add_ints` (symPrefixed).
func TestEmitFuncCExportAlias() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.Add", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	b.EmitReturn(noArgs)
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr("add_ints"))
	f.CExportNames = names
	emitFunc(a, "main", f, nilStrings())

	var mangledIdx int = a.LookupSymbol(symFor("main", "main.Add"))
	if mangledIdx < 0 {
		return fail("mangled function symbol missing")
	}
	var aliasIdx int = a.LookupSymbol(symPrefixed("add_ints"))
	if aliasIdx < 0 {
		return fail("c_export alias symbol `add_ints` missing")
	}
	if a.Symbols[aliasIdx].Offset != a.Symbols[mangledIdx].Offset {
		return fail("c_export alias must sit at the function's entry offset")
	}
	if a.Symbols[aliasIdx].Section != a.Symbols[mangledIdx].Section {
		return fail("c_export alias must be in the function's section")
	}
	if a.Symbols[aliasIdx].Binding != asm.BIND_GLOBAL {
		return fail("c_export alias must be a strong global")
	}
	return ""
}

// A #[c_export] function with a NARROW reg param gets a non-empty C-entry thunk: the alias
// sits BEFORE the mangled symbol, and the thunk is the argument-register normalization plus a
// branch (JMP) to the mangled entry.  A C caller enters at the alias, sign-/zero-extends the
// dirty high bits SysV leaves unspecified, and jumps into the body; a native caller enters at
// the mangled symbol and skips it.  The JMP is load-bearing: ld64 links the alias as its own
// atom, so a bare fall-through would land in inter-atom padding.  Pins the thunk PLACEMENT
// (alias offset < mangled offset) and CONTENT (MOVSX of the single signed int8 arg register
// RDI, then the JMP).
func TestEmitFuncCExportNarrowParamPrefix() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].ID = 1
	params[0].Name = "b"
	params[0].Typ = types.TypInt8()
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.Sgn", params, noR)
	var blk @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	blk.EmitReturn(noArgs)
	var names @[]@[]char
	names = slices.Append[@[]char](names, buf.CopyStr("ffi_sgn"))
	f.CExportNames = names
	emitFunc(a, "main", f, nilStrings())

	var mangledIdx int = a.LookupSymbol(symFor("main", "main.Sgn"))
	var aliasIdx int = a.LookupSymbol(symPrefixed("ffi_sgn"))
	if mangledIdx < 0 || aliasIdx < 0 {
		return fail("c_export narrow-param: alias or mangled symbol missing")
	}
	var aliasOff int = cast(int, a.Symbols[aliasIdx].Offset)
	var mangledOff int = cast(int, a.Symbols[mangledIdx].Offset)
	if aliasOff >= mangledOff {
		return fail("narrow-param c_export alias must precede the mangled entry (non-empty prefix)")
	}
	// The thunk is MOVSX rdi, dil (the sole signed int8 arg register) then a JMP to the
	// mangled entry (emitted as its rel32 placeholder pre-fixup, which matches here).
	var want @asm.Assembler = asm.New(8)
	want.SetSection("text", -1)
	x64.Movsx(want, x64.Reg(x64.RDI, x64.SZ64), x64.Reg(x64.RDI, x64.SZ8))
	x64.Jmp(want, symFor("main", "main.Sgn"))
	if mangledOff - aliasOff != want.Sections[0].Len {
		return fail("c_export thunk length must equal MOVSX + JMP")
	}
	var gd @[]uint8 = a.Sections[0].Data
	var wd @[]uint8 = want.Sections[0].Data
	for i := 0; i < want.Sections[0].Len; i++ {
		if gd[aliasOff + i] != wd[i] {
			return fail("c_export thunk bytes must be the int8 MOVSX + JMP")
		}
	}
	return ""
}

// endsWithReturn pins the IR-shape branches that drive emitFunc's
// safety-net-epilogue skip.  Without correct branching, either
// (a) a real function gets a dead 5-byte trailing epilogue, or
// (b) a function with no OP_RETURN (defensive shape) emits no
// `ret` and crashes when its return path executes.
func TestEndsWithReturnYes() testing.TestResult {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "f", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	b.EmitReturn(noArgs)
	if !endsWithReturn(f) {
		return fail("function ending with OP_RETURN should report true")
	}
	return ""
}

func TestEndsWithReturnNoBlocks() testing.TestResult {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "f", noP, noR)
	// No blocks added — the safety net SHOULD fire on an empty IR.
	if endsWithReturn(f) {
		return fail("empty function (no blocks) should report false")
	}
	return ""
}

func TestEndsWithReturnEmptyBlock() testing.TestResult {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "f", noP, noR)
	ir.AddBlock(f, "entry") // entry with no instructions
	// Block has no instrs — safety net SHOULD fire.
	if endsWithReturn(f) {
		return fail("function with empty entry block should report false")
	}
	return ""
}

func TestEndsWithReturnLastIsNotReturn() testing.TestResult {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "f", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	// Add some non-return instruction (a const) as the last instr.
	b.EmitConstInt(42, types.TypInt())
	if endsWithReturn(f) {
		return fail("function whose last instr is OP_CONST_INT should report false")
	}
	return ""
}

// Last-non-empty-block lookup: if the IR ends with an empty block
// after a returning block, the answer is still "yes" (the empty
// trailing block is unreachable; the returning one terminates the
// function).  Pin that walk-from-the-end-skipping-empty-blocks
// behaviour so a regression doesn't silently re-introduce the dead-
// epilogue tail.
func TestEndsWithReturnSkipsEmptyTrailingBlock() testing.TestResult {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "f", noP, noR)
	var b0 @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	b0.EmitReturn(noArgs)
	ir.AddBlock(f, "trailing") // empty, after the returning block
	if !endsWithReturn(f) {
		return fail("trailing empty block should be skipped")
	}
	return ""
}

// Phase 3h: a function returning an aggregate > 16 bytes has
// SretSlotOff >= 0 after PlanFrame.  emitFunc's prologue must
// stash the incoming RDI (the caller's sret-buffer pointer) into
// that slot so emitReturn can read it back.
//
// Pin: the prologue contains an extra MOV (compared to the
// non-sret case) writing RDI into the frame.
func TestEmitFuncSretPrologueStashesRdi() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	// Function returning a 24-byte aggregate (> 16 → sret).
	// int64 fields (not int) so the struct size is host-independent.
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var bigStruct @types.Type = types.MakeStructType("Big", fields)
	var noP @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = bigStruct
	var f @ir.Func = ir.NewFunc("", "main.getBig", noP, results)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	b.EmitReturn(noArgs)
	emitFunc(a, "main", f, nilStrings())
	// Look for a MOV with destination [RSP + ...] and source RDI
	// (= reg 7).  The encoding is 48 89 7C ... or 48 89 BC ... .
	// Look for the 0x48 0x89 0x7C / 0x48 0x89 0xBC pair.
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var foundStash bool = false
	for i := 0; i < a.Sections[0].Len - 2; i++ {
		if data[i] == cast(uint8, 0x48) && data[i + 1] == cast(uint8, 0x89) &&
				(data[i + 2] == cast(uint8, 0x7C) || data[i + 2] == cast(uint8, 0xBC) ||
						data[i + 2] == cast(uint8, 0x3C)) {
			foundStash = true
		}
	}
	if !foundStash {
		return "sret-returning function should stash RDI into SretSlotOff"
	}
	return ""
}

// Phase 3h: a non-sret function should NOT emit the RDI-stash.
// Pin the negative — without this, a refactor that always emits
// the stash would silently bloat every function and clobber RDI
// (the first user arg) on every call.
func TestEmitFuncNonSretNoPrologueStash() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	// Function returning a scalar (no sret).
	var noP @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "main.getInt", noP, results)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	b.EmitReturn(noArgs)
	emitFunc(a, "main", f, nilStrings())
	// Expected total: prologue (4 bytes) + emitReturn (5 bytes) = 9.
	// If a stray RDI-stash got added that would be at least 4 more
	// bytes; pin a tight upper bound.
	if a.Sections[0].Len > 12 {
		return "non-sret function should not emit an RDI-stash prologue"
	}
	return ""
}

// emitFunc with one scalar int parameter: the prologue must spill
// RDI (SysV arg reg 0) into the param's slot so getOperand can
// reload it via the spill path.  Without this, the param's spill
// slot stays uninitialised — every read of the param yields 0 or
// garbage (the root cause that blocked every multi-arg function
// test, e.g. `func double(n int) int { return n * 2 }`).
//
// Pin: the byte stream contains a MOV writing RDI (reg 7) to a
// [rsp + ...] memory location.  Encoded as 0x48 0x89 with a ModRM
// byte whose reg field = 7 (RDI low 3 bits) and rm field = 4 (SIB,
// which encodes [rsp + ...]) — i.e. 0x7C / 0xBC / 0x3C.
func TestEmitFuncScalarParamSpillsRdi() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].ID = 10
	params[0].Name = "n"
	params[0].Typ = types.TypInt()
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.id", params, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	b.EmitReturn(noArgs)
	emitFunc(a, "main", f, nilStrings())
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundSpill bool = false
	for i := 0; i < n - 2; i++ {
		if data[i] == cast(uint8, 0x48) && data[i + 1] == cast(uint8, 0x89) &&
				(data[i + 2] == cast(uint8, 0x7C) || data[i + 2] == cast(uint8, 0xBC) ||
						data[i + 2] == cast(uint8, 0x3C)) {
			foundSpill = true
		}
	}
	if !foundSpill {
		return fail("scalar param's RDI should be spilled to its stack slot")
	}
	return ""
}

// emitFunc with a 16-byte aggregate parameter (raw slice): the two
// eightbytes arrive in RDI/RSI (SysV INTEGER classification) and
// must be spilled to the param's data region — [rsp + dataOff] and
// [rsp + dataOff + 8].  In addition, the spill slot must hold a
// pointer to the data region (LEA + MOV), matching OP_MAKE_SLICE's
// pointer-in-spill form.  Pin: at least two MOV-r-to-mem stores
// (0x48 0x89 with SIB-rsp ModRM) appear AND at least one LEA
// (0x48 0x8D) appears in the body.
func TestEmitFuncAggregateParamSpillsRegsAndPointer() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].ID = 11
	params[0].Name = "s"
	params[0].Typ = types.MakeSliceType(types.TypUint8())
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.takeSlice", params, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	b.EmitReturn(noArgs)
	emitFunc(a, "main", f, nilStrings())
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var stores int = 0
	var foundLea bool = false
	for i := 0; i < n - 2; i++ {
		if data[i] == cast(uint8, 0x48) && data[i + 1] == cast(uint8, 0x89) &&
				(data[i + 2] & cast(uint8, 0x07)) == cast(uint8, 0x04) {
			stores = stores + 1
		}
		if data[i] == cast(uint8, 0x48) && data[i + 1] == cast(uint8, 0x8D) {
			foundLea = true
		}
	}
	if stores < 2 {
		return fail("16B aggregate param should spill 2 eightbytes from RDI+RSI to data region")
	}
	if !foundLea {
		return fail("aggregate param's spill slot should hold a LEA'd pointer to its data region")
	}
	return ""
}

// emitFunc with 7 scalar int params: the 7th overflows to the
// caller's stack (regs 1–6 hold params 0–5).  spillIncomingParams
// must load it from [rsp + frameSize + 16] via RAX and store to the
// param's spill slot — the stack-arg arm of the scalar branch.  Pin:
// a MOV-from-mem reading from a non-RSP+small offset (the caller's
// outgoing-args area lives above frameSize), staged through RAX.
func TestEmitFuncScalarParamOverflowFromStack() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var params @[]@ir.Param = make_slice(@ir.Param, 7)
	for i := 0; i < 7; i++ {
		params[i] = make(ir.Param)
		params[i].ID = 100 + i
		params[i].Typ = types.TypInt()
	}
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.seven", params, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	b.EmitReturn(noArgs)
	emitFunc(a, "main", f, nilStrings())
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	// RAX is reg 0; MOV r,r/m with dst=RAX has REX (0x48) + opcode
	// 0x8B + ModRM whose reg field = 0.  Look for any 0x48 0x8B
	// ... 0x04 sequence (SIB-rsp with reg=0) — that's a load from
	// memory into RAX.
	var foundRaxLoad bool = false
	for i := 0; i < n - 2; i++ {
		if data[i] == cast(uint8, 0x48) && data[i + 1] == cast(uint8, 0x8B) &&
				(data[i + 2] & cast(uint8, 0x07)) == cast(uint8, 0x04) {
			foundRaxLoad = true
		}
	}
	if !foundRaxLoad {
		return fail("7th scalar param should load from caller's stack via RAX")
	}
	return ""
}

// emitFunc with a 32-byte managed-slice param: SysV MEMORY class →
// Indirect-large entry: a 32-byte managed-slice param arrives as
// a single pointer in RDI.  spillIncomingParams memcpies the
// struct words (4 × 8 B) from *RDI into the local data region via
// R11, then LEAs the data-region pointer into the spill slot.
// Pin: a LEA (REX.W 0x8D) reaches the spill slot — the rest of
// the sequence is the load/store loop the indirect-large arm
// emits, which the LEA bound already exercises.
func TestEmitFuncIndirectLargeParamCopiesFromPointer() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].ID = 200
	params[0].Typ = types.MakeManagedSliceType(types.TypUint8()) // 32 B
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.takeMS", params, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	b.EmitReturn(noArgs)
	emitFunc(a, "main", f, nilStrings())
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundLea bool = false
	for i := 0; i < n - 1; i++ {
		if data[i] == cast(uint8, 0x48) && data[i + 1] == cast(uint8, 0x8D) {
			foundLea = true
		}
	}
	if !foundLea {
		return fail("indirect-large param spill slot should hold a LEA'd data-region pointer")
	}
	return ""
}

// spillIncomingParams must honor the SysV-AMD64 sret one-slot arg
// shift.  When the function returns an aggregate via the hidden RDI
// buffer, RDI is the buffer pointer and the first user param arrives
// in RSI, not RDI.  Pre-fix, spillIncomingParams computed regStart
// from the user-param-only type list and stored RDI (the buffer
// pointer) into the first param's spill slot, corrupting it — bit
// every `var x T = sret_returning_call(arg)` with a struct-with-
// managed-field T (222/223/224/321/363/etc.).
//
// Pin: an sret-returning function with one scalar int param emits
// a MOV writing RSI (reg 6) to a [rsp + ...] slot.  REX.W (0x48) +
// opcode 0x89 + ModRM with reg field = 6 (middle 3 bits = 110) +
// rm field = 4 (SIB-rsp, low 3 bits = 100).  ModRM byte mask 0x3F ==
// 0x34 picks out reg=6 + rm=4 regardless of mod (disp size).
func TestEmitFuncSretShiftsParamRegisters() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	// int64 fields (not int) so struct size is host-independent at
	// 32 bytes (>16 → sret).
	var fields @[]@types.Field = make_slice(@types.Field, 4)
	for i := 0; i < 4; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var bigStruct @types.Type = types.MakeStructType("Big", fields)
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].ID = 100
	params[0].Name = "n"
	params[0].Typ = types.TypInt64()
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = bigStruct
	var f @ir.Func = ir.NewFunc("", "main.makeBig", params, results)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	b.EmitReturn(noArgs)
	emitFunc(a, "main", f, nilStrings())
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundRsiSpill bool = false
	for i := 0; i < n - 2; i++ {
		if data[i] == cast(uint8, 0x48) && data[i + 1] == cast(uint8, 0x89) &&
				(data[i + 2] & cast(uint8, 0x3F)) == cast(uint8, 0x34) {
			foundRsiSpill = true
		}
	}
	if !foundRsiSpill {
		return fail("sret-returning func's scalar int param should spill RSI (not RDI)")
	}
	return ""
}

// spillIncomingParams under sret + an aggregate (raw slice) param:
// the slice's two eightbytes shift from RDI/RSI → RSI/RDX (sret
// buffer takes RDI).  Pin: two MOV-from-arg-reg stores into the
// param's data region, sourced from RSI and RDX (NOT RDI/RSI).  A
// regression that lost the shift for aggregate params would
// resurface 364-style miscompiles even after the scalar fix
// landed.
func TestEmitFuncSretShiftsAggregateParam() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	// Function: void takeSlice(raw slice) RETURNING a 32-byte struct.
	// sret threshold (16) tripped → hidden RDI buffer.  Raw slice
	// param therefore arrives in RSI/RDX (not RDI/RSI).  int64 fields
	// (not int) so struct size is host-independent.
	var fields @[]@types.Field = make_slice(@types.Field, 4)
	for i := 0; i < 4; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt64()
	}
	var bigStruct @types.Type = types.MakeStructType("Big", fields)
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = make(ir.Param)
	params[0].ID = 110
	params[0].Name = "s"
	params[0].Typ = types.MakeSliceType(types.TypUint8())
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = bigStruct
	var f @ir.Func = ir.NewFunc("", "main.takeSlice", params, results)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	b.EmitReturn(noArgs)
	emitFunc(a, "main", f, nilStrings())
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	// REX.W (0x48) + 0x89 + ModRM(reg=6=RSI, rm=4=SIB-rsp) — mask
	// 0x3F == 0x34 picks reg=6 + rm=4 regardless of disp size.
	// REX.W (0x48) + 0x89 + ModRM(reg=2=RDX, rm=4) — mask 0x3F ==
	// 0x14 picks reg=2 + rm=4.
	var foundRsiSpill bool = false
	var foundRdxSpill bool = false
	for i := 0; i < n - 2; i++ {
		if data[i] != cast(uint8, 0x48) { continue }
		if data[i + 1] != cast(uint8, 0x89) { continue }
		var m uint8 = data[i + 2] & cast(uint8, 0x3F)
		if m == cast(uint8, 0x34) { foundRsiSpill = true }
		if m == cast(uint8, 0x14) { foundRdxSpill = true }
	}
	if !foundRsiSpill {
		return fail("sret-returning func's slice param's first eightbyte should spill RSI")
	}
	if !foundRdxSpill {
		return fail("sret-returning func's slice param's second eightbyte should spill RDX")
	}
	return ""
}

// frameSize > 0 → an extra `sub rsp, imm` between the prologue and
// the body.  Add an OP_ALLOC to the function so PlanFrame reserves
// a slot.  Encoded for a single int alloca (frameSize padded to 16):
//   55                       push  %rbp
//   48 89 e5                 mov   %rsp, %rbp
//   48 83 ec 10              sub   $0x10, %rsp        <-- new
//   48 89 ec                 mov   %rbp, %rsp
//   5d                       pop   %rbp
//   c3                       ret
// 13 bytes total.
func TestEmitFuncWithAllocaHasSubRsp() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.main", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	// EmitAlloc reserves a stack slot the size of int; PlanFrame
	// rounds frameSize up to a 16-byte multiple → frameSize = 16.
	b.EmitAlloc(types.TypInt())
	var noArgs @[]@ir.Instr
	b.EmitReturn(noArgs)
	emitFunc(a, "main", f, nilStrings())
	// 4 (prologue) + 4 (sub rsp, 0x10) + 5 (epilogue) = 13 bytes.
	if a.Sections[0].Len != 13 {
		return fail("function with one alloca should emit 13 bytes")
	}
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	// Byte 4–7 should be the sub-rsp-imm8 form: 48 83 ec 10.
	if data[4] != cast(uint8, 0x48) { return fail("byte 4 should be REX.W") }
	if data[5] != cast(uint8, 0x83) { return fail("byte 5 should be SUB r/m,imm8") }
	if data[6] != cast(uint8, 0xec) { return fail("byte 6 should be ModRM sub rsp") }
	if data[7] != cast(uint8, 0x10) { return fail("byte 7 should be imm8 16") }
	return ""
}
