package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for x64_emit_params.bn — incoming-parameter spilling.  The
// spillIncomingParams integration paths (register / stack / sret / aggregate
// params) are exercised through emitFunc in x64_emit_func_test.bn; this file
// covers the narrow-scalar stack-arg loader directly.

// spillX64EmitsSame reports whether spillScalarStackArgX64(cc, t) emits the same
// bytes as the reference load assembled into want (RAX <- [RSP + 16]).
func spillX64EmitsSame(cc common.CallConv, t @types.Type, want @asm.Assembler) bool {
	var g @asm.Assembler = asm.New(8)
	g.SetSection("text", -1)
	spillScalarStackArgX64(g, x64.RAX, x64.RSP, 16, cc, t)
	if g.Sections[0].Len != want.Sections[0].Len {
		return false
	}
	var gd @[]uint8 = g.Sections[0].Data
	var wd @[]uint8 = want.Sections[0].Data
	for i := 0; i < g.Sections[0].Len; i++ {
		if gd[i] != wd[i] {
			return false
		}
	}
	return true
}

// mkWantX64 returns a fresh text-section assembler for building a reference load.
func mkWantX64() @asm.Assembler {
	var w @asm.Assembler = asm.New(8)
	w.SetSection("text", -1)
	return w
}

// TestSpillScalarStackArgX64SizedLoads pins that on SysV x64 (which rounds every stack arg to
// an 8-byte slot — StackArgNaturalSize == 0) a narrow integer / bool stack arg is loaded at
// its natural size and sign-/zero-extended UNCONDITIONALLY — canonicalizing the dirty high
// slot bytes a C caller (a #[c_export] entry or a __c_entry callback target) may leave.  A
// native caller stores the full extended word, so the sized load reproduces the same value.
func TestSpillScalarStackArgX64SizedLoads() testing.TestResult {
	var cc common.CallConv = common.SysV_AMD64()
	var w @asm.Assembler
	// Signed narrows sign-extend.
	w = mkWantX64()
	x64.Movsx(w, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RSP, 16, x64.SZ8))
	if !spillX64EmitsSame(cc, types.TypInt8(), w) {
		return fail("int8 -> MOVSX (8-bit)")
	}
	w = mkWantX64()
	x64.Movsx(w, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RSP, 16, x64.SZ16))
	if !spillX64EmitsSame(cc, types.TypInt16(), w) {
		return fail("int16 -> MOVSX (16-bit)")
	}
	w = mkWantX64()
	x64.Movsxd(w, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RSP, 16, x64.SZ32))
	if !spillX64EmitsSame(cc, types.TypInt32(), w) {
		return fail("int32 -> MOVSXD")
	}
	// bool / unsigned zero-extend.
	w = mkWantX64()
	x64.Movzx(w, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RSP, 16, x64.SZ8))
	if !spillX64EmitsSame(cc, types.TypBool(), w) {
		return fail("bool -> MOVZX (8-bit)")
	}
	w = mkWantX64()
	x64.Mov(w, x64.Reg(x64.RAX, x64.SZ32), x64.Mem(x64.RSP, 16, x64.SZ32))
	if !spillX64EmitsSame(cc, types.TypUint32(), w) {
		return fail("uint32 -> 32-bit MOV (zero-extends)")
	}
	// A full-word (>= 8-byte) arg still loads the whole word — the override only fires for a
	// sub-word scalar (sz < 8).
	w = mkWantX64()
	x64.Mov(w, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RSP, 16, x64.SZ64))
	if !spillX64EmitsSame(cc, types.TypInt64(), w) {
		return fail("int64 -> plain 8-byte MOV")
	}
	return ""
}
