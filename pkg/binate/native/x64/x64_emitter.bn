package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/macho"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"

// x64Emitter is the x86-64 impl of common.ArchEmitter: it routes the shared
// common.EmitObject skeleton's per-arch steps to this package's emission
// helpers.  Stateless — the object-format linkage prefix lives in the
// package-global objSymPrefix, set/cleared via SetPrefix/ClearPrefix.  Each
// method realises the like-named common.ArchEmitter method (contract there).
type x64Emitter struct {
}

// WordBytes — x86-64 is LP64.
func (e *x64Emitter) WordBytes() int { return 8 }

// CallConv returns the SysV-AMD64 calling convention (constant for this backend).
func (e *x64Emitter) CallConv() common.CallConv { return common.SysV_AMD64() }

// SetPrefix installs the linkage prefix: Mach-O C-linkage needs a leading
// '_', ELF none (this backend's Linux default).
func (e *x64Emitter) SetPrefix(format *[]readonly char) {
	if common.ObjFmtEq(format, "macho") {
		objSymPrefix = "_"
	} else {
		objSymPrefix = ""
	}
}

// ClearPrefix restores this backend's bare (ELF) default.
func (e *x64Emitter) ClearPrefix() {
	objSymPrefix = ""
}

// SymPrefixed applies the active object-format linkage prefix.
func (e *x64Emitter) SymPrefixed(name *[]readonly char) @[]char {
	return symPrefixed(name)
}

// ArchName is the tag for a ReportEmitError diagnostic.
func (e *x64Emitter) ArchName() *[]readonly char {
	return "x64"
}

// EmitFunc lowers one function's text.
func (e *x64Emitter) EmitFunc(a @asm.Assembler, pkgName *[]readonly char, f @ir.Func,
		strings @[]ir.StringConst) {
	emitFunc(a, pkgName, f, strings)
}

// EmitCEntryThunks lowers the weak __c_entry adaptation thunks.
func (e *x64Emitter) EmitCEntryThunks(a @asm.Assembler, pkgName *[]readonly char,
		targets @[]@ir.Func) {
	emitCEntryThunks(a, pkgName, targets)
}

// EmitFuncValueShims lowers the module's function-value call shims.
func (e *x64Emitter) EmitFuncValueShims(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	emitFuncValueShims(a, pkgName, mod)
}

// EmitStringTable lowers the collected string-literal table.
func (e *x64Emitter) EmitStringTable(a @asm.Assembler, pkgName *[]readonly char,
		strings @[]ir.StringConst) {
	emitStringTable(a, pkgName, strings)
}

// EmitGlobals lowers package-level variable storage.
func (e *x64Emitter) EmitGlobals(a @asm.Assembler, pkgName *[]readonly char,
		globals @[]@ir.Global) {
	emitGlobals(a, pkgName, globals)
}

// EmitFuncValueVtables lowers the function-value vtables.
func (e *x64Emitter) EmitFuncValueVtables(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	emitFuncValueVtables(a, pkgName, mod)
}

// EmitImplVtables lowers the interface-impl vtables.
func (e *x64Emitter) EmitImplVtables(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	emitImplVtables(a, pkgName, mod)
}

// EmitPackageDescriptor lowers the reflect / package descriptor.
func (e *x64Emitter) EmitPackageDescriptor(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	emitPackageDescriptor(a, pkgName, mod)
}

// ResolveFixups patches same-section fixups.
func (e *x64Emitter) ResolveFixups(a @asm.Assembler) {
	x64.ResolveFixups(a)
}

// WriteObject — the writer follows the object-format axis: Mach-O (macOS,
// via the Rosetta conformance runner) vs ELF (Linux, this backend's default).
func (e *x64Emitter) WriteObject(a @asm.Assembler, format *[]readonly char,
		path *[]readonly char) bool {
	if common.ObjFmtEq(format, "macho") {
		return macho.WriteX86_64(a, path)
	}
	return elf.WriteX86_64(a, path)
}

impl *x64Emitter : common.ArchEmitter
