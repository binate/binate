package "pkg/binate/native/x64"

import "pkg/binate/native/common"
import "pkg/builtins/testing"

// x64Emitter is the x86-64 impl of common.ArchEmitter.  The full emission
// path is exercised end-to-end by the emit-shape tests + native conformance;
// here we pin the arch constants it feeds the shared EmitObject skeleton and
// that it satisfies the interface (dispatch through a *common.ArchEmitter).

func TestX64EmitterWordBytes() testing.TestResult {
	var em x64Emitter
	var p *x64Emitter = &em
	if p.WordBytes() != 8 {
		return fail("x64 word size should be 8 (LP64)")
	}
	return ""
}

func TestX64EmitterArchName() testing.TestResult {
	var em x64Emitter
	var p *x64Emitter = &em
	if !charsEqual(p.ArchName(), "x64") {
		return fail("arch name should be x64")
	}
	return ""
}

func TestX64EmitterSatisfiesArchEmitter() testing.TestResult {
	// Dispatch through the interface vtable (as common.EmitObject does).
	var em x64Emitter
	var e *common.ArchEmitter = &em
	if e.WordBytes() != 8 {
		return fail("interface dispatch: word size should be 8")
	}
	return ""
}

// ElfTextMappingSymbol is "" — x86-64 has no ARM-style mapping symbols.
func TestX64EmitterElfTextMappingSymbol() testing.TestResult {
	var em x64Emitter
	var e *common.ArchEmitter = &em
	if len(e.ElfTextMappingSymbol("elf")) != 0 {
		return fail("x86-64 should have no text mapping symbol")
	}
	return ""
}
