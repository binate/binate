package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// Floating-point lowering for the SysV-AMD64 backend.
//
// Strategy mirrors the aarch64 backend (see aarch64_float.bn): all
// SSA values (including floats) live in 8-byte GP-spill slots; XMM
// regs only "light up" for the duration of one FP instruction, with
// the value MOVQ'd in from a GP scratch and back out.  No separate
// FP regalloc; the integer regmap covers every SSA value.
//
// We use XMM14 / XMM15 as inline FP scratches — caller-saved per
// SysV-AMD64, no save/restore needed.
//
// The decimal-literal → IEEE 754 bit pattern converter lives in
// pkg/binate/native/common (ParseFloatLitToBits): integer-only arithmetic
// shared by every native backend so the same literal text produces
// the same bits regardless of arch.

// FP_SCRATCH_A is the inline FP scratch register holding the LHS /
// first operand / sole operand for unary FP work.
const FP_SCRATCH_A int = x64.XMM14
// FP_SCRATCH_B is the inline FP scratch register holding the RHS /
// second operand.
const FP_SCRATCH_B int = x64.XMM15

// isFloatTyp reports whether t is a TYP_FLOAT or TYP_UNTYPED_FLOAT.
// Mirrors the aarch64 predicate (kept module-private; the common
// helper IsFloatScalarTyp is the canonical one for cross-package
// use, but inside one backend the local form reads more directly).
func isFloatTyp(t @types.Type) bool {
	if t == nil { return false }
	t = common.UnwrapNamed(t)
	return t.Kind == types.TYP_FLOAT || t.Kind == types.TYP_UNTYPED_FLOAT
}

// floatBitWidth returns 32 for float32, 64 for float64 / untyped-float
// (peeling a named distinct float type to its underlying).
func floatBitWidth(t @types.Type) int {
	if t == nil { return 64 }
	t = common.UnwrapNamed(t)
	if t.Kind == types.TYP_UNTYPED_FLOAT { return 64 }
	if t.Kind == types.TYP_FLOAT && t.Width == 32 { return 32 }
	return 64
}

// ============================================================
// FP op emitters
// ============================================================

// emitConstFloat: OP_CONST_FLOAT — convert the literal to IEEE 754
// bits and materialize via MOV reg64, imm64 (the same encoder
// emitConstInt64 uses).  Bits live in the GP scratch / spill slot
// like any other 64-bit value.
func emitConstFloat(a @asm.Assembler, rd int, ins @ir.Instr) {
	var bits uint64 = common.ParseFloatLitToBits(ins.StrVal)
	// A float32-typed constant materializes its narrowed 32-bit value
	// (round-to-nearest-even), not the low half of the float64 pattern;
	// otherwise bit_cast(int32, C) would read the wrong bits.
	if floatBitWidth(ins.Typ) == 32 {
		bits = cast(uint64, common.F64BitsToF32Bits(bits))
	}
	// cast(int64, …) reinterprets the full 64-bit IEEE pattern;
	// cast(int, …) would drop the high 32 bits on a 32-bit host.
	emitConstInt64(a, rd, cast(int64, bits))
}

// emitFloatBinop: OP_ADD/SUB/MUL/DIV when the result is float.
// float64 operands are MOVQ'd (64-bit) into XMM scratches and run through
// the SSE2 double ops; float32 operands are MOVD'd (32-bit) and run through
// the single-precision SS ops so they round at single precision.  Returns
// true if the op was handled (i.e. ins.Typ was a float).
func emitFloatBinop(a @asm.Assembler, rm @common.RegMap,
		ins @ir.Instr) bool {
	if !isFloatTyp(ins.Typ) { return false }
	if len(ins.Args) < 2 { return false }
	var ra int = getOperand(a, rm, ins.Args[0].ID)
	var rb int = getOperand(a, rm, ins.Args[1].ID)
	if ra < 0 || rb < 0 { return false }
	if floatBitWidth(ins.Typ) == 32 {
		// float32: round at single precision.  Move the f32 bit patterns
		// (low 32 bits of the GP slots) into XMM via the 32-bit MOVD and
		// use the single-precision (SS) ops; MOVD back zero-extends the
		// result's high 32 bits.  Computing in double on the raw f32 bits
		// would reinterpret them as a garbage double.
		x64.Movd_gp_to_xmm(a, FP_SCRATCH_A, ra)
		x64.Movd_gp_to_xmm(a, FP_SCRATCH_B, rb)
		if ins.Op == ir.OP_ADD {
			x64.Addss(a, FP_SCRATCH_A, FP_SCRATCH_B)
		} else if ins.Op == ir.OP_SUB {
			x64.Subss(a, FP_SCRATCH_A, FP_SCRATCH_B)
		} else if ins.Op == ir.OP_MUL {
			x64.Mulss(a, FP_SCRATCH_A, FP_SCRATCH_B)
		} else if ins.Op == ir.OP_DIV {
			x64.Divss(a, FP_SCRATCH_A, FP_SCRATCH_B)
		} else {
			return false
		}
		var rd32 int = nextReg(rm, ins.ID)
		x64.Movd_xmm_to_gp(a, rd32, FP_SCRATCH_A)
		return true
	}
	x64.Movq_gp_to_xmm(a, FP_SCRATCH_A, ra)
	x64.Movq_gp_to_xmm(a, FP_SCRATCH_B, rb)
	if ins.Op == ir.OP_ADD {
		x64.Addsd(a, FP_SCRATCH_A, FP_SCRATCH_B)
	} else if ins.Op == ir.OP_SUB {
		x64.Subsd(a, FP_SCRATCH_A, FP_SCRATCH_B)
	} else if ins.Op == ir.OP_MUL {
		x64.Mulsd(a, FP_SCRATCH_A, FP_SCRATCH_B)
	} else if ins.Op == ir.OP_DIV {
		x64.Divsd(a, FP_SCRATCH_A, FP_SCRATCH_B)
	} else {
		return false
	}
	var rd int = nextReg(rm, ins.ID)
	x64.Movq_xmm_to_gp(a, rd, FP_SCRATCH_A)
	return true
}

// emitFloatCompare: OP_EQ/NE/LT/LE/GT/GE when operands are float.
// Emits UCOMISD + SETcc honouring IEEE 754 / Go float-compare
// semantics: `==` and the four relationals are ORDERED (false vs NaN),
// while `!=` is UNORDERED (true vs NaN) so it stays the exact
// complement of `==`.  Returns true when the float path fired so the
// caller skips the integer-CMP fallback.  Mirrors
// pkg/binate/native/aarch64/aarch64_float.bn::emitFloatCompare.
//
// UCOMISD lhs, rhs sets EFLAGS:
//   lhs <  rhs : CF=1, ZF=0, PF=0
//   lhs == rhs : CF=0, ZF=1, PF=0
//   lhs >  rhs : CF=0, ZF=0, PF=0
//   unordered  : CF=1, ZF=1, PF=1
//
// Per-op SETcc strategy:
//   OP_GT → SETA  (CF=0 AND ZF=0).  NaN sets CF=1 → false ✓.
//                  Single SETcc, no scratch needed.
//   OP_GE → SETAE (CF=0).            NaN sets CF=1 → false ✓.
//                  Single SETcc, no scratch needed.
//   OP_EQ → SETE  (ZF=1) AND'd with SETNP (PF=0).  NaN: PF=1 clears
//                  → false ✓.
//   OP_NE → SETNE (ZF=0) OR'd with SETP (PF=1) — unordered NE.  NaN:
//                  PF=1 sets → true ✓ (exact complement of OP_EQ).
//   OP_LT → SETB  (CF=1) AND'd with SETNP.  NaN: PF=1 clears ✓.
//   OP_LE → SETBE (CF=1 OR ZF=1) AND'd with SETNP.  NaN: PF=1 ✓.
func emitFloatCompare(a @asm.Assembler, rm @common.RegMap,
		ins @ir.Instr) bool {
	if ins.Op != ir.OP_EQ && ins.Op != ir.OP_NE &&
			ins.Op != ir.OP_LT && ins.Op != ir.OP_LE &&
			ins.Op != ir.OP_GT && ins.Op != ir.OP_GE {
		return false
	}
	if len(ins.Args) != 2 { return false }
	if ins.Args[0].Typ == nil || !isFloatTyp(ins.Args[0].Typ) {
		return false
	}
	var lhs int = getOperand(a, rm, ins.Args[0].ID)
	var rhs int = getOperand(a, rm, ins.Args[1].ID)
	if lhs < 0 || rhs < 0 { return false }
	if floatBitWidth(ins.Args[0].Typ) == 32 {
		// float32: compare at single precision.  A double UCOMISD on the
		// raw f32 bits reinterprets them as garbage doubles (a negative
		// f32 reads as a large positive double), flipping the order.
		// UCOMISS sets the same EFLAGS, so the condition logic below is
		// shared.
		x64.Movd_gp_to_xmm(a, FP_SCRATCH_A, lhs)
		x64.Movd_gp_to_xmm(a, FP_SCRATCH_B, rhs)
		x64.Ucomiss(a, FP_SCRATCH_A, FP_SCRATCH_B)
	} else {
		x64.Movq_gp_to_xmm(a, FP_SCRATCH_A, lhs)
		x64.Movq_gp_to_xmm(a, FP_SCRATCH_B, rhs)
		x64.Ucomisd(a, FP_SCRATCH_A, FP_SCRATCH_B)
	}
	var rd int = nextReg(rm, ins.ID)
	if ins.Op == ir.OP_GT {
		x64.Setcc(a, x64.CC_A, x64.Reg(rd, x64.SZ8))
	} else if ins.Op == ir.OP_GE {
		x64.Setcc(a, x64.CC_AE, x64.Reg(rd, x64.SZ8))
	} else if ins.Op == ir.OP_NE {
		// Unordered NE (IEEE / Go): true when not-equal (ZF=0) OR
		// unordered (PF=1) — the exact complement of the ordered EQ.
		// NaN sets PF=1 → true ✓.
		x64.Setcc(a, x64.CC_NE, x64.Reg(rd, x64.SZ8))
		var scratchNe int = scratchReg(rm)
		x64.Setcc(a, x64.CC_P, x64.Reg(scratchNe, x64.SZ8))
		x64.Or(a, x64.Reg(rd, x64.SZ8), x64.Reg(scratchNe, x64.SZ8))
	} else {
		// EQ/LT/LE need an additional NaN-gate via SETNP + AND, because
		// their primary SETcc condition (E/B/BE) triggers on the
		// NaN-induced ZF=1 / CF=1 flag pattern.
		x64.Setcc(a, floatPrimaryCC(ins.Op), x64.Reg(rd, x64.SZ8))
		var scratch int = scratchReg(rm)
		x64.Setcc(a, x64.CC_NP, x64.Reg(scratch, x64.SZ8))
		x64.And(a, x64.Reg(rd, x64.SZ8), x64.Reg(scratch, x64.SZ8))
	}
	x64.Movzx(a, x64.Reg(rd, x64.SZ64), x64.Reg(rd, x64.SZ8))
	return true
}

// floatPrimaryCC returns the x86-64 condition code for the pre-NaN-gate
// SETcc when emitting the ordered EQ/LT/LE.  Only valid for those three
// ops; GT/GE go through SETA/SETAE directly (no parity gate), and the
// unordered NE is handled inline in emitFloatCompare (SETNE OR'd with
// SETP), so it never reaches here.
func floatPrimaryCC(op int) int {
	if op == ir.OP_EQ { return x64.CC_E }
	if op == ir.OP_LT { return x64.CC_B }
	return x64.CC_BE  // OP_LE
}

// emitFloatNeg: OP_NEG on a float.  Negation is a single-bit flip
// of the sign bit (bit 63 for float64, bit 31 for float32), which
// is faster + simpler in GP than a round-trip through XMM (x64's
// SSE has no native FNEG — the typical sequence would be xorpd
// with a sign-mask constant, requiring extra constant materialization).
// Returns true if the op was a float NEG.
func emitFloatNeg(a @asm.Assembler, rm @common.RegMap,
		ins @ir.Instr) bool {
	if !isFloatTyp(ins.Typ) { return false }
	if ins.Op != ir.OP_NEG { return false }
	if len(ins.Args) < 1 { return false }
	var src int = getOperand(a, rm, ins.Args[0].ID)
	if src < 0 { return false }
	var rd int = nextReg(rm, ins.ID)
	var rdOp x64.Operand = x64.Reg(rd, x64.SZ64)
	if rd != src {
		x64.Mov(a, rdOp, x64.Reg(src, x64.SZ64))
	}
	if floatBitWidth(ins.Typ) == 32 {
		// XOR low 32 bits with 0x80000000.  x86 32-bit ops zero
		// the upper 32 of the GP, which is fine — float32 only
		// occupies the low dword.  Imm(-2147483648) → imm32
		// bit pattern 0x80000000.
		x64.Xor(a, x64.Reg(rd, x64.SZ32),
			x64.Imm(-2147483647 - 1))
		return true
	}
	// float64: 64-bit XOR with 1<<63.  Materialize the sign mask
	// in a scratch GP because XOR r/m64, imm32 sign-extends and
	// can't represent 0x8000000000000000.
	var tmp int = scratchReg(rm)
	var signMask int64 = cast(int64, 1) << 63
	emitConstInt64(a, tmp, signMask)
	x64.Xor(a, rdOp, x64.Reg(tmp, x64.SZ64))
	return true
}

// uitofpLabel mints a unique local label for the uint64→double add-back
// branch, keyed on the current code offset so two conversions in one
// function don't collide.  The 'L' prefix keeps it out of the exported
// symbol list (same-section Jcc/Jmp fixups resolve before link).
func uitofpLabel(prefix *[]readonly char, off int) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write(prefix)
	stringutils.WriteInt(b, off)
	return buf.CopyStr(b.String())
}

// pickScratchGP returns a GP reg from {RAX, RDX, R11} that is neither
// avoid1 nor avoid2.  In the spill-everything model only the live
// operand/result regs matter, so any other reg is a safe clobber; three
// candidates always leave one free of the two to avoid.
func pickScratchGP(avoid1 int, avoid2 int) int {
	if x64.RAX != avoid1 && x64.RAX != avoid2 { return x64.RAX }
	if x64.RDX != avoid1 && x64.RDX != avoid2 { return x64.RDX }
	return x64.R11
}

// emitUint64ToDouble converts the UNSIGNED 64-bit value in `src` to a
// double in FP_SCRATCH_A.  x86-64 has no unsigned-int64→double
// instruction, so use the sign-bit add-back: for values < 2^63 a signed
// CVTSI2SD is exact; for values >= 2^63 (bit 63 set), convert
// (src>>1)|(src&1) — round-to-odd, which keeps the final doubling exact
// (avoids the double-rounding a plain >>1 would suffer) — then ADDSD it
// to itself.  `scratch` is a GP reg distinct from src that may be
// clobbered; src is also clobbered, but only on the big path (the plain
// path reads it intact).
func emitUint64ToDouble(a @asm.Assembler, src int, scratch int) {
	var off int = cast(int, a.CurrentOffset())
	var plainLbl @[]char = uitofpLabel("Lu2d_p", off)
	var doneLbl @[]char = uitofpLabel("Lu2d_d", off)
	// if (int64)src >= 0 → bit 63 clear → the signed convert is exact.
	x64.Test(a, x64.Reg(src, x64.SZ64), x64.Reg(src, x64.SZ64))
	x64.Jcc(a, x64.CC_NS, plainLbl)
	// Big path: scratch = (src >> 1) | (src & 1); convert; double.
	x64.Mov(a, x64.Reg(scratch, x64.SZ64), x64.Reg(src, x64.SZ64))
	x64.Shr(a, x64.Reg(scratch, x64.SZ64), x64.Imm(1))
	x64.And(a, x64.Reg(src, x64.SZ64), x64.Imm(1))
	x64.Or(a, x64.Reg(scratch, x64.SZ64), x64.Reg(src, x64.SZ64))
	x64.Cvtsi2sd(a, FP_SCRATCH_A, scratch)
	x64.Addsd(a, FP_SCRATCH_A, FP_SCRATCH_A)
	x64.Jmp(a, doneLbl)
	a.DefineLabel(plainLbl)
	x64.Cvtsi2sd(a, FP_SCRATCH_A, src)
	a.DefineLabel(doneLbl)
}

// emitFloatCast: OP_CAST when source or target is a float.  Returns
// true if handled.  Cases (all variants present here, with float32
// rare in conformance — test 283 is the only mover):
//   int → float64    : CVTSI2SD xmm,gp ; MOVQ rd,xmm
//   int → float32    : CVTSI2SD xmm,gp ; CVTSD2SS xmm,xmm ; MOVD rd,xmm
//   float64 → int    : MOVQ xmm,gp ; CVTTSD2SI rd,xmm  (round-toward-zero)
//   float32 → int    : MOVD xmm,gp ; CVTSS2SD xmm,xmm ; CVTTSD2SI rd,xmm
//   float32 → float64: MOVD xmm,gp ; CVTSS2SD xmm,xmm ; MOVQ rd,xmm
//   float64 → float32: MOVQ xmm,gp ; CVTSD2SS xmm,xmm ; MOVD rd,xmm
//   same-width float→float: plain MOV (no bit change needed).
//
// Spill slots are uniformly 8 bytes; float32 occupies the low half,
// float64 the full 8.  The integer-bit-pattern interpretation lets
// us treat MOV / MOVQ / MOVD uniformly without reasoning about the
// upper-bits-zero state in the spill.
func emitFloatCast(a @asm.Assembler, rd int, src int,
		srcTyp @types.Type, dstTyp @types.Type) bool {
	var srcF bool = isFloatTyp(srcTyp)
	var dstF bool = isFloatTyp(dstTyp)
	if !srcF && !dstF { return false }
	var srcW int = 64
	var dstW int = 64
	if srcF { srcW = floatBitWidth(srcTyp) }
	if dstF { dstW = floatBitWidth(dstTyp) }

	if srcF && dstF {
		if srcW == dstW {
			x64.Mov(a, x64.Reg(rd, x64.SZ64),
				x64.Reg(src, x64.SZ64))
			return true
		}
		if srcW == 32 && dstW == 64 {
			x64.Movd_gp_to_xmm(a, FP_SCRATCH_A, src)
			x64.Cvtss2sd(a, FP_SCRATCH_A, FP_SCRATCH_A)
			x64.Movq_xmm_to_gp(a, rd, FP_SCRATCH_A)
			return true
		}
		// f64 → f32.
		x64.Movq_gp_to_xmm(a, FP_SCRATCH_A, src)
		x64.Cvtsd2ss(a, FP_SCRATCH_A, FP_SCRATCH_A)
		x64.Movd_xmm_to_gp(a, rd, FP_SCRATCH_A)
		return true
	}
	if !srcF && dstF {
		// Int → float.  CVTSI2SD is SIGNED, landing in XMM as float64.
		// An unsigned 64-bit source with bit 63 set needs the add-back
		// idiom (x86-64 has no unsigned-int64→double instruction).
		// Sub-word unsigned sources are zero-extended, so they read
		// positive and the signed CVTSI2SD is exact for them.
		if common.IsUnsignedIntType(srcTyp) && srcTyp.Width >= 64 {
			emitUint64ToDouble(a, src, pickScratchGP(src, rd))
		} else {
			x64.Cvtsi2sd(a, FP_SCRATCH_A, src)
		}
		if dstW == 32 {
			x64.Cvtsd2ss(a, FP_SCRATCH_A, FP_SCRATCH_A)
			x64.Movd_xmm_to_gp(a, rd, FP_SCRATCH_A)
		} else {
			x64.Movq_xmm_to_gp(a, rd, FP_SCRATCH_A)
		}
		return true
	}
	// Float → int.  CVTTSD2SI is double-precision-only (widen float32
	// to float64 first) AND signed-only — an unsigned destination uses
	// the subtract-2^63 idiom (emitDoubleToUint64).
	if srcW == 32 {
		x64.Movd_gp_to_xmm(a, FP_SCRATCH_A, src)
		x64.Cvtss2sd(a, FP_SCRATCH_A, FP_SCRATCH_A)
	} else {
		x64.Movq_gp_to_xmm(a, FP_SCRATCH_A, src)
	}
	if common.IsUnsignedIntType(dstTyp) {
		// src is free now (the float lives in FP_SCRATCH_A); any GP reg
		// other than rd is a safe scratch.
		emitDoubleToUint64(a, rd, pickScratchGP(rd, rd))
	} else {
		x64.Cvttsd2si(a, rd, FP_SCRATCH_A)
	}
	return true
}

// emitDoubleToUint64 truncates the double in FP_SCRATCH_A to a uint64 in
// rd.  x86-64's CVTTSD2SI is signed-only — it saturates a value >= 2^63
// to INT64_MIN — so for f >= 2^63 convert f - 2^63 (which lands in
// [0, 2^63) and fits a signed int64) and set bit 63 back; f < 2^63 uses
// the plain signed CVTTSD2SI.  FP_SCRATCH_B holds the 2^63 constant;
// `scratch` is a GP reg != rd that may be clobbered.
func emitDoubleToUint64(a @asm.Assembler, rd int, scratch int) {
	var off int = cast(int, a.CurrentOffset())
	var smallLbl @[]char = uitofpLabel("Ld2u_s", off)
	var doneLbl @[]char = uitofpLabel("Ld2u_d", off)
	// FP_SCRATCH_B = 2^63 as a double (0x43E0000000000000).
	emitConstInt64(a, scratch, cast(int64, 0x43E0000000000000))
	x64.Movq_gp_to_xmm(a, FP_SCRATCH_B, scratch)
	x64.Ucomisd(a, FP_SCRATCH_A, FP_SCRATCH_B)
	x64.Jcc(a, x64.CC_B, smallLbl)             // f < 2^63 → plain
	// Big path: rd = (int64)(f - 2^63) | 2^63.
	x64.Subsd(a, FP_SCRATCH_A, FP_SCRATCH_B)
	x64.Cvttsd2si(a, rd, FP_SCRATCH_A)
	emitConstInt64(a, scratch, cast(int64, 1) << 63)
	x64.Or(a, x64.Reg(rd, x64.SZ64), x64.Reg(scratch, x64.SZ64))
	x64.Jmp(a, doneLbl)
	a.DefineLabel(smallLbl)
	x64.Cvttsd2si(a, rd, FP_SCRATCH_A)
	a.DefineLabel(doneLbl)
}
