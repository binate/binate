package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Floating-point lowering for the SysV-AMD64 backend.
//
// Strategy mirrors the aarch64 backend (see aarch64_float.bn): all
// SSA values (including floats) live in 8-byte GP-spill slots; XMM
// regs only "light up" for the duration of one FP instruction, with
// the value MOVQ'd in from a GP scratch and back out.  No separate
// FP regalloc; the integer regmap covers every SSA value.
//
// We use XMM14 / XMM15 as inline FP scratches — caller-saved per
// SysV-AMD64, no save/restore needed.
//
// The decimal-literal → IEEE 754 bit pattern converter lives in
// pkg/binate/native/common (ParseFloatLitToBits): integer-only arithmetic
// shared by every native backend so the same literal text produces
// the same bits regardless of arch.

// FP_SCRATCH_A is the inline FP scratch register holding the LHS /
// first operand / sole operand for unary FP work.
const FP_SCRATCH_A int = x64.XMM14

// FP_SCRATCH_B is the inline FP scratch register holding the RHS /
// second operand.
const FP_SCRATCH_B int = x64.XMM15

// isFloatTyp reports whether t is a TYP_FLOAT or TYP_UNTYPED_FLOAT.
// Mirrors the aarch64 predicate (kept module-private; the common
// helper IsFloatScalarTyp is the canonical one for cross-package
// use, but inside one backend the local form reads more directly).
func isFloatTyp(t @types.Type) bool {
	if t == nil { return false }
	t = types.StripWrappers(t)
	return t != nil && (t.Kind == types.TYP_FLOAT || t.Kind == types.TYP_UNTYPED_FLOAT)
}

// floatBitWidth returns 32 for float32, 64 for float64 / untyped-float
// (peeling a named distinct float type to its underlying).
func floatBitWidth(t @types.Type) int {
	if t == nil { return 64 }
	t = types.StripWrappers(t)
	if t == nil { return 64 }
	if t.Kind == types.TYP_UNTYPED_FLOAT { return 64 }
	if t.Kind == types.TYP_FLOAT && t.Width == 32 { return 32 }
	return 64
}

// ============================================================
// FP op emitters
// ============================================================

// emitConstFloat: OP_CONST_FLOAT — convert the literal to IEEE 754
// bits and materialize via MOV reg64, imm64 (the same encoder
// emitConstInt64 uses).  Bits live in the GP scratch / spill slot
// like any other 64-bit value.
func emitConstFloat(a @asm.Assembler, rm @common.RegMap, rd int, ins @ir.Instr) {
	var bits uint64 = common.ParseFloatLitToBits(ins.StrVal)
	// A float32-typed constant materializes its narrowed 32-bit value
	// (round-to-nearest-even), not the low half of the float64 pattern;
	// otherwise bit_cast(int32, C) would read the wrong bits.
	var is32 bool = floatBitWidth(ins.Typ) == 32
	if is32 {
		bits = cast(uint64, common.F64BitsToF32Bits(bits))
	}
	// cast(int64, …) reinterprets the full 64-bit IEEE pattern;
	// cast(int, …) would drop the high 32 bits on a 32-bit host.
	if isFpReg(rd) {
		// FP-homed const: build the IEEE bits in a GP scratch, then MOV them into
		// the XMM home (Movd zero-extends the f32 high 32).
		var gp int = scratchReg(rm)
		emitConstInt64(a, gp, cast(int64, bits))
		if is32 {
			x64.Movd_gp_to_xmm(a, rd, gp)
		} else {
			x64.Movq_gp_to_xmm(a, rd, gp)
		}
		return
	}
	emitConstInt64(a, rd, cast(int64, bits))
}

// storeFloatResult moves the float result sitting in FP_SCRATCH_A into rd: an
// XMM home takes a whole-register Movapd (the low 32/64 hold the value; for an f32
// the copied upper 96 bits are unspecified — FP_SCRATCH_A may carry dirty upper
// bits from a prior op — but every f32 consumer reads only the low 32 / re-narrows,
// so they are never observed); otherwise the bits go to the GP result slot via
// Movd (f32, zero-extending the high 32) / Movq (f64).
func storeFloatResult(a @asm.Assembler, rd int, is32 bool) {
	if isFpReg(rd) {
		x64.Movapd(a, rd, FP_SCRATCH_A)
	} else if is32 {
		x64.Movd_xmm_to_gp(a, rd, FP_SCRATCH_A)
	} else {
		x64.Movq_xmm_to_gp(a, rd, FP_SCRATCH_A)
	}
}

// emitFloatBinop: OP_ADD/SUB/MUL/DIV when the result is float.
// float64 operands are MOVQ'd (64-bit) into XMM scratches and run through
// the SSE2 double ops; float32 operands are MOVD'd (32-bit) and run through
// the single-precision SS ops so they round at single precision.  Returns
// true if the op was handled (i.e. ins.Typ was a float).
func emitFloatBinop(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if !isFloatTyp(ins.Typ) { return false }
	if len(ins.Args) < 2 { return false }
	if ins.Op != iropcode.OP_ADD && ins.Op != iropcode.OP_SUB && ins.Op != iropcode.OP_MUL &&
			ins.Op != iropcode.OP_DIV {
		return false
	}
	var is32 bool = floatBitWidth(ins.Typ) == 32
	// Operands arrive as XMM registers: an FP-homed operand IS its home (no MOV),
	// otherwise its bits reload into the fixed FP scratch (XMM14/XMM15) via the
	// upper-zeroing Movd (f32) / Movq (f64) — computing in double on raw f32 bits
	// would reinterpret them as a garbage double.
	var da int = getFloatOperand(a, rm, ins.Args[0].ID, FP_SCRATCH_A, is32)
	var db int = getFloatOperand(a, rm, ins.Args[1].ID, FP_SCRATCH_B, is32)
	if da < 0 || db < 0 { return false }
	// SSE is two-address (dst OP= src), so compute into FP_SCRATCH_A = da OP db,
	// then move to the result.  db is never FP_SCRATCH_A (a reloaded op1 goes to
	// FP_SCRATCH_B; homes are XMM8..13), so the Movapd below can't clobber it.
	if da != FP_SCRATCH_A {
		x64.Movapd(a, FP_SCRATCH_A, da)
	}
	if is32 {
		if ins.Op == iropcode.OP_ADD {
			x64.Addss(a, FP_SCRATCH_A, db)
		} else if ins.Op == iropcode.OP_SUB {
			x64.Subss(a, FP_SCRATCH_A, db)
		} else if ins.Op == iropcode.OP_MUL {
			x64.Mulss(a, FP_SCRATCH_A, db)
		} else {
			x64.Divss(a, FP_SCRATCH_A, db)
		}
	} else {
		if ins.Op == iropcode.OP_ADD {
			x64.Addsd(a, FP_SCRATCH_A, db)
		} else if ins.Op == iropcode.OP_SUB {
			x64.Subsd(a, FP_SCRATCH_A, db)
		} else if ins.Op == iropcode.OP_MUL {
			x64.Mulsd(a, FP_SCRATCH_A, db)
		} else {
			x64.Divsd(a, FP_SCRATCH_A, db)
		}
	}
	// The result computes into its XMM home when homed (Movapd copies the whole
	// register; for an f32 the upper 96 bits are unspecified, but no f32 consumer
	// reads them — all read the low 32 / re-narrow); otherwise MOV back to the GP
	// result slot (Movd zero-extends the f32 high 32).
	var rd int = nextReg(rm, ins.ID)
	if isFpReg(rd) {
		x64.Movapd(a, rd, FP_SCRATCH_A)
	} else if is32 {
		x64.Movd_xmm_to_gp(a, rd, FP_SCRATCH_A)
	} else {
		x64.Movq_xmm_to_gp(a, rd, FP_SCRATCH_A)
	}
	return true
}

// emitFloatCompare: OP_EQ/NE/LT/LE/GT/GE when operands are float.
// Emits UCOMISD + SETcc honouring IEEE 754 / Go float-compare
// semantics: `==` and the four relationals are ORDERED (false vs NaN),
// while `!=` is UNORDERED (true vs NaN) so it stays the exact
// complement of `==`.  Returns true when the float path fired so the
// caller skips the integer-CMP fallback.  Mirrors
// pkg/binate/native/aarch64/aarch64_float.bn::emitFloatCompare.
//
// UCOMISD lhs, rhs sets EFLAGS:
//   lhs <  rhs : CF=1, ZF=0, PF=0
//   lhs == rhs : CF=0, ZF=1, PF=0
//   lhs >  rhs : CF=0, ZF=0, PF=0
//   unordered  : CF=1, ZF=1, PF=1
//
// Per-op SETcc strategy:
//   OP_GT → SETA  (CF=0 AND ZF=0).  NaN sets CF=1 → false ✓.
//                  Single SETcc, no scratch needed.
//   OP_GE → SETAE (CF=0).            NaN sets CF=1 → false ✓.
//                  Single SETcc, no scratch needed.
//   OP_EQ → SETE  (ZF=1) AND'd with SETNP (PF=0).  NaN: PF=1 clears
//                  → false ✓.
//   OP_NE → SETNE (ZF=0) OR'd with SETP (PF=1) — unordered NE.  NaN:
//                  PF=1 sets → true ✓ (exact complement of OP_EQ).
//   OP_LT → SETB  (CF=1) AND'd with SETNP.  NaN: PF=1 clears ✓.
//   OP_LE → SETBE (CF=1 OR ZF=1) AND'd with SETNP.  NaN: PF=1 ✓.
func emitFloatCompare(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_EQ && ins.Op != iropcode.OP_NE && ins.Op != iropcode.OP_LT &&
			ins.Op != iropcode.OP_LE && ins.Op != iropcode.OP_GT && ins.Op != iropcode.OP_GE {
		return false
	}
	if len(ins.Args) != 2 { return false }
	if ins.Args[0].Typ == nil || !isFloatTyp(ins.Args[0].Typ) {
		return false
	}
	var is32 bool = floatBitWidth(ins.Args[0].Typ) == 32
	// Operands as XMM registers (home or reloaded into the FP scratch).  float32:
	// compare at single precision — a double UCOMISD on the raw f32 bits
	// reinterprets them as garbage doubles (a negative f32 reads as a large
	// positive double), flipping the order.  UCOMISS sets the same EFLAGS, so the
	// condition logic below is shared.
	var da int = getFloatOperand(a, rm, ins.Args[0].ID, FP_SCRATCH_A, is32)
	var db int = getFloatOperand(a, rm, ins.Args[1].ID, FP_SCRATCH_B, is32)
	if da < 0 || db < 0 { return false }
	if is32 {
		x64.Ucomiss(a, da, db)
	} else {
		x64.Ucomisd(a, da, db)
	}
	var rd int = nextReg(rm, ins.ID)
	switch ins.Op {
	case iropcode.OP_GT:
		x64.Setcc(a, x64.CC_A, x64.Reg(rd, x64.SZ8))
	case iropcode.OP_GE:
		x64.Setcc(a, x64.CC_AE, x64.Reg(rd, x64.SZ8))
	case iropcode.OP_NE:
		// Unordered NE (IEEE / Go): true when not-equal (ZF=0) OR
		// unordered (PF=1) — the exact complement of the ordered EQ.
		// NaN sets PF=1 → true ✓.
		x64.Setcc(a, x64.CC_NE, x64.Reg(rd, x64.SZ8))
		var scratchNe int = scratchReg(rm)
		x64.Setcc(a, x64.CC_P, x64.Reg(scratchNe, x64.SZ8))
		x64.Or(a, x64.Reg(rd, x64.SZ8), x64.Reg(scratchNe, x64.SZ8))
	default:
		// EQ/LT/LE need an additional NaN-gate via SETNP + AND, because
		// their primary SETcc condition (E/B/BE) triggers on the
		// NaN-induced ZF=1 / CF=1 flag pattern.
		x64.Setcc(a, floatPrimaryCC(ins.Op), x64.Reg(rd, x64.SZ8))
		var scratch int = scratchReg(rm)
		x64.Setcc(a, x64.CC_NP, x64.Reg(scratch, x64.SZ8))
		x64.And(a, x64.Reg(rd, x64.SZ8), x64.Reg(scratch, x64.SZ8))
	}
	x64.Movzx(a, x64.Reg(rd, x64.SZ64), x64.Reg(rd, x64.SZ8))
	return true
}

// floatPrimaryCC returns the x86-64 condition code for the pre-NaN-gate
// SETcc when emitting the ordered EQ/LT/LE.  Only valid for those three
// ops; GT/GE go through SETA/SETAE directly (no parity gate), and the
// unordered NE is handled inline in emitFloatCompare (SETNE OR'd with
// SETP), so it never reaches here.
func floatPrimaryCC(op int) int {
	if op == iropcode.OP_EQ { return x64.CC_E }
	if op == iropcode.OP_LT { return x64.CC_B }
	return x64.CC_BE // OP_LE
}

// emitFloatNeg: OP_NEG on a float.  Negation is a single-bit flip
// of the sign bit (bit 63 for float64, bit 31 for float32), which
// is faster + simpler in GP than a round-trip through XMM (x64's
// SSE has no native FNEG — the typical sequence would be xorpd
// with a sign-mask constant, requiring extra constant materialization).
// Returns true if the op was a float NEG.
func emitFloatNeg(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if !isFloatTyp(ins.Typ) { return false }
	if ins.Op != iropcode.OP_NEG { return false }
	if len(ins.Args) < 1 { return false }
	var src int = getOperand(a, rm, ins.Args[0].ID)
	if src < 0 { return false }
	var is32 bool = floatBitWidth(ins.Typ) == 32
	var rd int = nextReg(rm, ins.ID)
	if isFpReg(rd) {
		// FP-homed result: flip the sign bit in a GP scratch, then move the bits
		// into the XMM home (Movd zero-extends the f32 high 32, keeping it clean).
		var gp int = scratchReg(rm)
		x64.Mov(a, x64.Reg(gp, x64.SZ64), x64.Reg(src, x64.SZ64))
		if is32 {
			x64.Xor(a, x64.Reg(gp, x64.SZ32), x64.Imm(-2147483647 - 1))
			x64.Movd_gp_to_xmm(a, rd, gp)
		} else {
			var mask int = scratchReg(rm)
			emitConstInt64(a, mask, cast(int64, 1) << 63)
			x64.Xor(a, x64.Reg(gp, x64.SZ64), x64.Reg(mask, x64.SZ64))
			x64.Movq_gp_to_xmm(a, rd, gp)
		}
		return true
	}
	var rdOp x64.Operand = x64.Reg(rd, x64.SZ64)
	if rd != src {
		x64.Mov(a, rdOp, x64.Reg(src, x64.SZ64))
	}
	if is32 {
		// XOR low 32 bits with 0x80000000.  x86 32-bit ops zero
		// the upper 32 of the GP, which is fine — float32 only
		// occupies the low dword.  Imm(-2147483648) → imm32
		// bit pattern 0x80000000.
		x64.Xor(a, x64.Reg(rd, x64.SZ32), x64.Imm(-2147483647 - 1))
		return true
	}
	// float64: 64-bit XOR with 1<<63.  Materialize the sign mask
	// in a scratch GP because XOR r/m64, imm32 sign-extends and
	// can't represent 0x8000000000000000.
	var tmp int = scratchReg(rm)
	var signMask int64 = cast(int64, 1) << 63
	emitConstInt64(a, tmp, signMask)
	x64.Xor(a, rdOp, x64.Reg(tmp, x64.SZ64))
	return true
}

// emitFloatCast: OP_CAST when source or target is a float.  Returns true if
// handled.  Result-producing cases (int→float, float→float) land the float
// result in its XMM home when the result is FP-homed (storeFloatResult /
// Movd/Movq_gp_to_xmm), else in the GP result slot; float→int keeps the GP
// path.  The unsigned int64↔double directions use the add-back / subtract-2^63
// idioms in x64_float_convert.bn.  Spill slots are uniformly 8 bytes (float32 in
// the low half), so MOV / MOVQ / MOVD treat the bit pattern uniformly.
func emitFloatCast(a @asm.Assembler, m @common.RegMap, rd int, src int, srcTyp @types.Type,
		dstTyp @types.Type) bool {
	var srcF bool = isFloatTyp(srcTyp)
	var dstF bool = isFloatTyp(dstTyp)
	if !srcF && !dstF { return false }
	var srcW int = 64
	var dstW int = 64
	if srcF { srcW = floatBitWidth(srcTyp) }
	if dstF { dstW = floatBitWidth(dstTyp) }

	if srcF && dstF {
		if srcW == dstW {
			// Same-width float->float is a bit copy: into an XMM home, MOV the
			// GP-materialized source bits (Movd for f32); else a plain GP move.
			if isFpReg(rd) {
				if srcW == 32 {
					x64.Movd_gp_to_xmm(a, rd, src)
				} else {
					x64.Movq_gp_to_xmm(a, rd, src)
				}
			} else {
				x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Reg(src, x64.SZ64))
			}
			return true
		}
		if srcW == 32 && dstW == 64 {
			x64.Movd_gp_to_xmm(a, FP_SCRATCH_A, src)
			x64.Cvtss2sd(a, FP_SCRATCH_A, FP_SCRATCH_A)
			storeFloatResult(a, rd, false)
			return true
		}
		// f64 → f32.
		x64.Movq_gp_to_xmm(a, FP_SCRATCH_A, src)
		x64.Cvtsd2ss(a, FP_SCRATCH_A, FP_SCRATCH_A)
		storeFloatResult(a, rd, true)
		return true
	}
	if !srcF && dstF {
		// Int → float.  CVTSI2SD is SIGNED, landing in XMM as float64.
		// An unsigned 64-bit source with bit 63 set needs the add-back
		// idiom (x86-64 has no unsigned-int64→double instruction).
		// Sub-word unsigned sources are zero-extended, so they read
		// positive and the signed CVTSI2SD is exact for them.
		// Peel transparent wrappers before reading `.Width`: a named /
		// `readonly` uint64 (`type U uint64`, or a promoted `readonly uint64`
		// param at -O1+) carries Width 0 on the wrapper node, so an un-peeled
		// `.Width >= 64` reads false and would take the SIGNED CVTSI2SD path —
		// flipping the sign of a bit-63-set value.
		var sSrc @types.Type = types.StripWrappers(srcTyp)
		if common.IsUnsignedIntType(sSrc) && sSrc != nil && sSrc.Width >= 64 {
			s1, s2 := pickTwoScratchGP(m, src, rd)
			emitUint64ToDouble(a, src, s1, s2)
		} else {
			x64.Cvtsi2sd(a, FP_SCRATCH_A, src)
		}
		if dstW == 32 {
			x64.Cvtsd2ss(a, FP_SCRATCH_A, FP_SCRATCH_A)
			storeFloatResult(a, rd, true)
		} else {
			storeFloatResult(a, rd, false)
		}
		return true
	}
	// Float → int.  CVTTSD2SI is double-precision-only (widen float32
	// to float64 first) AND signed-only — an unsigned destination uses
	// the subtract-2^63 idiom (emitDoubleToUint64).
	if srcW == 32 {
		x64.Movd_gp_to_xmm(a, FP_SCRATCH_A, src)
		x64.Cvtss2sd(a, FP_SCRATCH_A, FP_SCRATCH_A)
	} else {
		x64.Movq_gp_to_xmm(a, FP_SCRATCH_A, src)
	}
	if common.IsUnsignedIntType(dstTyp) {
		// src is free now (the float lives in FP_SCRATCH_A); any GP reg
		// other than rd is a safe scratch.
		emitDoubleToUint64(a, rd, pickScratchGP(m, rd, rd))
	} else {
		x64.Cvttsd2si(a, rd, FP_SCRATCH_A)
	}
	return true
}

// emitBitCastX64: OP_BIT_CAST — reinterpret same-size bits.  Into an FP-homed
// float result the source int bits MOV into the XMM home (Movd for f32,
// zero-extending; Movq for f64), no sub-word narrow.  Otherwise a plain 64-bit
// GP MOV then re-narrow to the TARGET type's width — a sub-word target used
// DIRECTLY (e.g. `bit_cast(uint32, <int32 -1>)` read in a compare) must hold its
// own value range, not the source's leaked sign-extended high bits.
// emitValOperand (not getOperand) so `bit_cast(int, &G)` materializes the global
// address — bare getOperand would miss the IsGlobalRef pseudo.
func emitBitCastX64(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var src int = emitValOperand(a, pkgName, rm, ins.Args[0])
	if src < 0 { return }
	var rd int = nextReg(rm, ins.ID)
	if isFloatTyp(ins.TypeArg) && isFpReg(rd) {
		if floatBitWidth(ins.TypeArg) == 32 {
			x64.Movd_gp_to_xmm(a, rd, src)
		} else {
			x64.Movq_gp_to_xmm(a, rd, src)
		}
		return
	}
	if rd != src {
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Reg(src, x64.SZ64))
	}
	emitSubWordNarrow(a, rd, ins.TypeArg)
}
