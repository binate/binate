package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/binate/native/common"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// Unsigned int64 <-> double conversion helpers (x86-64 lacks native unsigned
// int64<->double instructions) + the local-label and scratch-GP pickers they use.
// Split from x64_float.bn to keep it under the file-length cap.

// uitofpLabel mints a unique local label for the uint64→double add-back
// branch, keyed on the current code offset so two conversions in one
// function don't collide.  The 'L' prefix keeps it out of the exported
// symbol list (same-section Jcc/Jmp fixups resolve before link).
func uitofpLabel(prefix *[]readonly char, off int) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write(prefix)
	stringutils.WriteInt(b, off)
	return buf.CopyStr(b.String())
}

// pickScratchGP returns a GP reg from {RAX, RDX, R11} that is neither avoid1
// nor avoid2, evicting any within-block retained value cached in the chosen
// register so the caller may clobber it without leaving a stale cache entry
// (eviction is loss-free — the value stays in its spill slot and reloads on
// next use).  The candidates are caller-saved and outside the callee-saved
// home pool (RBX/R12..R15), so none can hold a live homed value; the only live
// GP regs a lowering must protect are its own operand/result (passed as
// avoid1/avoid2).  Three candidates always leave one free of the two to avoid.
func pickScratchGP(m @common.RegMap, avoid1 int, avoid2 int) int {
	var r int = x64.R11
	if x64.RAX != avoid1 && x64.RAX != avoid2 {
		r = x64.RAX
	} else if x64.RDX != avoid1 && x64.RDX != avoid2 {
		r = x64.RDX
	}
	if m.RegHeldBy(r) >= 0 { storeDirtyOnEvict(m, r); m.EvictReg(r) }
	return r
}

// pickTwoScratchGP returns two DISTINCT GP regs, each neither avoid1 nor
// avoid2, from a fixed caller-saved, non-home candidate set (RAX/RDX/R8/R9/
// R10/R11 — none is a home register, so none can hold a live homed value).
// Used where a lowering needs two throwaway GP scratches without clobbering
// its operand/result (avoid1/avoid2) or any home.  Six candidates always
// leave at least two free of the two to avoid.  Any within-block retained
// value cached in a chosen register is evicted (loss-free) so the caller may
// clobber it without leaving a stale cache entry.
func pickTwoScratchGP(m @common.RegMap, avoid1 int, avoid2 int) (int, int) {
	var cands @[]int = make_slice(int, 6)
	cands[0] = x64.RAX
	cands[1] = x64.RDX
	cands[2] = x64.R8
	cands[3] = x64.R9
	cands[4] = x64.R10
	cands[5] = x64.R11
	var first int = -1
	var second int = -1
	for i := 0; i < len(cands); i++ {
		var c int = cands[i]
		if c == avoid1 || c == avoid2 { continue }
		if first < 0 {
			first = c
		} else {
			second = c
			break
		}
	}
	if first >= 0 && m.RegHeldBy(first) >= 0 { storeDirtyOnEvict(m, first); m.EvictReg(first) }
	if second >= 0 && m.RegHeldBy(second) >= 0 { storeDirtyOnEvict(m, second); m.EvictReg(second) }
	return first, second
}

// emitUint64ToDouble converts the UNSIGNED 64-bit value in `src` to a
// double in FP_SCRATCH_A.  x86-64 has no unsigned-int64→double
// instruction, so use the sign-bit add-back: for values < 2^63 a signed
// CVTSI2SD is exact; for values >= 2^63 (bit 63 set), convert
// (src>>1)|(src&1) — round-to-odd, which keeps the final doubling exact
// (avoids the double-rounding a plain >>1 would suffer) — then ADDSD it
// to itself.  `scratch` and `scratch2` are GP regs distinct from src (and
// each other) that may be clobbered; src is only READ — it may be a live
// register-allocated (homed) value, so the round-to-odd is built entirely in
// the two scratch registers, never in src itself.
func emitUint64ToDouble(a @asm.Assembler, src int, scratch int, scratch2 int) {
	var off int = cast(int, a.CurrentOffset())
	var plainLbl @[]char = uitofpLabel("Lu2d_p", off)
	var doneLbl @[]char = uitofpLabel("Lu2d_d", off)
	// if (int64)src >= 0 → bit 63 clear → the signed convert is exact.
	x64.Test(a, x64.Reg(src, x64.SZ64), x64.Reg(src, x64.SZ64))
	x64.Jcc(a, x64.CC_NS, plainLbl)
	// Big path: scratch = (src >> 1) | (src & 1); convert; double.  src stays
	// intact — (src & 1) is computed into scratch2, not by mutating src.
	x64.Mov(a, x64.Reg(scratch, x64.SZ64), x64.Reg(src, x64.SZ64))
	x64.Shr(a, x64.Reg(scratch, x64.SZ64), x64.Imm(1))
	x64.Mov(a, x64.Reg(scratch2, x64.SZ64), x64.Reg(src, x64.SZ64))
	x64.And(a, x64.Reg(scratch2, x64.SZ64), x64.Imm(1))
	x64.Or(a, x64.Reg(scratch, x64.SZ64), x64.Reg(scratch2, x64.SZ64))
	x64.Cvtsi2sd(a, FP_SCRATCH_A, scratch)
	x64.Addsd(a, FP_SCRATCH_A, FP_SCRATCH_A)
	x64.Jmp(a, doneLbl)
	a.DefineLabel(plainLbl)
	x64.Cvtsi2sd(a, FP_SCRATCH_A, src)
	a.DefineLabel(doneLbl)
}

// emitDoubleToUint64 truncates the double in FP_SCRATCH_A to a uint64 in
// rd.  x86-64's CVTTSD2SI is signed-only — it saturates a value >= 2^63
// to INT64_MIN — so for f >= 2^63 convert f - 2^63 (which lands in
// [0, 2^63) and fits a signed int64) and set bit 63 back; f < 2^63 uses
// the plain signed CVTTSD2SI.  FP_SCRATCH_B holds the 2^63 constant;
// `scratch` is a GP reg != rd that may be clobbered.

func emitDoubleToUint64(a @asm.Assembler, rd int, scratch int) {
	var off int = cast(int, a.CurrentOffset())
	var smallLbl @[]char = uitofpLabel("Ld2u_s", off)
	var doneLbl @[]char = uitofpLabel("Ld2u_d", off)
	// FP_SCRATCH_B = 2^63 as a double (0x43E0000000000000).
	emitConstInt64(a, scratch, cast(int64, 0x43E0000000000000))
	x64.Movq_gp_to_xmm(a, FP_SCRATCH_B, scratch)
	x64.Ucomisd(a, FP_SCRATCH_A, FP_SCRATCH_B)
	x64.Jcc(a, x64.CC_B, smallLbl) // f < 2^63 → plain
	// Big path: rd = (int64)(f - 2^63) | 2^63.
	x64.Subsd(a, FP_SCRATCH_A, FP_SCRATCH_B)
	x64.Cvttsd2si(a, rd, FP_SCRATCH_A)
	emitConstInt64(a, scratch, cast(int64, 1) << 63)
	x64.Or(a, x64.Reg(rd, x64.SZ64), x64.Reg(scratch, x64.SZ64))
	x64.Jmp(a, doneLbl)
	a.DefineLabel(smallLbl)
	x64.Cvttsd2si(a, rd, FP_SCRATCH_A)
	a.DefineLabel(doneLbl)
}
