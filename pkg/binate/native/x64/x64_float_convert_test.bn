package "pkg/binate/native/x64"

import "pkg/binate/asm/x64"
import "pkg/binate/native/common"
import "pkg/builtins/testing"

// pickScratchGP / pickTwoScratchGP (x64_float_convert.bn) hand out caller-saved
// GP scratch registers that avoid the caller's operand/result registers.
func TestPickScratchGP() testing.TestResult {
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	if pickScratchGP(m, x64.RDX, x64.R11) != x64.RAX { return "should pick RAX when free" }
	if pickScratchGP(m, x64.RAX, x64.RDX) != x64.R11 { return "RAX+RDX avoided -> R11" }
	var r int = pickScratchGP(m, x64.RAX, x64.R11)
	if r == x64.RAX || r == x64.R11 { return "must avoid both given regs" }
	return ""
}

func TestPickTwoScratchGP() testing.TestResult {
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var f int
	var s int
	f, s = pickTwoScratchGP(m, x64.RAX, x64.RDX)
	if f == s { return "the two scratch regs must be distinct" }
	if f == x64.RAX || f == x64.RDX || s == x64.RAX || s == x64.RDX {
		return "must avoid both given regs"
	}
	return ""
}
