package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// floatMkAsm: minimal assembler for emitFloat* tests.
func floatMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func floatBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// ============================================================
// emitFloatBinop
// ============================================================
//
// Pattern: 2× MOV (spill reload) + 2× MOVQ gp→xmm + 1× ADDSD + 1× MOVQ
// xmm→gp.  The reload MOVs are 4 bytes each, MOVQ gp↔xmm 5 bytes,
// ADDSD 4 bytes — total 22 bytes.  Exact byte count guards against
// silent regressions in the FP-pattern length (omitted MOVQ would
// still encode as valid code but produce wrong values).

func TestEmitFloatBinopFloat64Add() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypFloat64()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypFloat64()
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_ADD
	ins.Typ = types.TypFloat64()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitFloatBinop(a, m, ins) {
		return "emitFloatBinop should match float OP_ADD"
	}
	if floatBytes(a) == 0 {
		return "float OP_ADD should emit instructions"
	}
	// Scan for the ADDSD opcode: F2 [REX]? 0F 58.  Use the helper
	// so the REX byte between the legacy prefix and the two-byte
	// opcode is tolerated; XMM14 / XMM15 always trigger REX.R/REX.B.
	if !findSSEOp(a, 0xF2, 0x58) {
		return "emitFloatBinop OP_ADD should emit ADDSD (F2 [REX]? 0F 58)"
	}
	return ""
}

// findSSEOp scans the emitted bytes for an `<sse_prefix> [REX]?
// 0F <op2>` sequence — the canonical SSE2 scalar encoding shape.
// Used by binop / cast tests so the optional REX byte (XMM8-XMM15
// triggers REX.R/REX.B) doesn't have to be hand-tracked per test.
func findSSEOp(a @asm.Assembler, prefix int, op2 int) bool {
	var s @asm.Section = a.Sections[0]
	for i := 0; i < s.Len - 2; i++ {
		if s.Data[i] != cast(uint8, prefix) { continue }
		// Either i+1=0x0F or i+1=REX byte (0x40..0x4F) with i+2=0x0F.
		if s.Data[i + 1] == cast(uint8, 0x0F) {
			if i + 2 < s.Len && s.Data[i + 2] == cast(uint8, op2) {
				return true
			}
			continue
		}
		var rex int = cast(int, s.Data[i + 1])
		if rex >= 0x40 && rex <= 0x4F && i + 3 < s.Len && s.Data[i + 2] == cast(uint8, 0x0F) &&
				s.Data[i + 3] == cast(uint8, op2) {
			return true
		}
	}
	return false
}

func TestEmitFloatBinopRejectsIntType() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_ADD
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	if emitFloatBinop(a, m, ins) {
		return "emitFloatBinop should reject int OP_ADD"
	}
	if floatBytes(a) != 0 {
		return "rejected op should emit nothing"
	}
	return ""
}

// Float SUB / MUL / DIV: ensure the right SSE opcode is selected.
// 0x5C SUBSD, 0x59 MULSD, 0x5E DIVSD.
func TestEmitFloatBinopSubsdSelected() testing.TestResult {
	return checkFloatBinopOpcode(iropcode.OP_SUB, 0x5C, "SUBSD")
}

func TestEmitFloatBinopMulsdSelected() testing.TestResult {
	return checkFloatBinopOpcode(iropcode.OP_MUL, 0x59, "MULSD")
}

func TestEmitFloatBinopDivsdSelected() testing.TestResult {
	return checkFloatBinopOpcode(iropcode.OP_DIV, 0x5E, "DIVSD")
}

// checkFloatBinopOpcode runs emitFloatBinop with the given IR op and
// confirms the corresponding `F2 0F <expectedByte>` SSE pattern shows
// up in the emitted bytes.  Shared helper used by the SUB/MUL/DIV
// opcode-selection regression pins.
func checkFloatBinopOpcode(irOp int, expectedByte int, mnemonic @[]char) testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypFloat64()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypFloat64()
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = irOp
	ins.Typ = types.TypFloat64()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitFloatBinop(a, m, ins) {
		return "emitFloatBinop should match the float op"
	}
	if findSSEOp(a, 0xF2, expectedByte) { return "" }
	return "expected SSE opcode for the float op not found"
}

// ============================================================
// emitFloatNeg
// ============================================================
//
// Float64 NEG materializes a 64-bit sign-bit mask in a scratch GP
// and XORs.  Cheaper than the round-trip through XMM that an FNEG-
// less SSE would otherwise need.  Pin: an XOR opcode (0x31 / 0x33)
// is present.

func TestEmitFloatNegFloat64() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypFloat64()
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_NEG
	ins.Typ = types.TypFloat64()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	if !emitFloatNeg(a, m, ins) {
		return "emitFloatNeg should match float OP_NEG"
	}
	var s @asm.Section = a.Sections[0]
	var foundXor bool = false
	for i := 0; i < s.Len; i++ {
		// 0x31 = XOR r/m, r ; 0x33 = XOR r, r/m.  Either form encodes
		// the sign-bit flip.
		if s.Data[i] == cast(uint8, 0x31) || s.Data[i] == cast(uint8, 0x33) {
			foundXor = true
		}
	}
	if !foundXor {
		return "float64 NEG should XOR the sign bit in"
	}
	return ""
}

func TestEmitFloatNegRejectsInt() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_NEG
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	if emitFloatNeg(a, m, ins) {
		return "emitFloatNeg should reject int OP_NEG"
	}
	return ""
}

// ============================================================
// emitFloatCast
// ============================================================
//
// One test per matrix cell.  emitFloatCast takes the rd/src
// registers already allocated, so byte counts are deterministic.

func TestEmitFloatCastIntToFloat64() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	if !emitFloatCast(a, m, x64.R10, x64.R11, types.TypInt(), types.TypFloat64()) {
		return "int → float64 cast should be handled"
	}
	// Pattern: CVTSI2SD + MOVQ xmm→gp.  CVTSI2SD encodes as
	// F2 REX.W 0F 2A — findSSEOp tolerates the REX byte.
	if !findSSEOp(a, 0xF2, 0x2A) {
		return "int → float64 should emit CVTSI2SD (F2 [REX]? 0F 2A)"
	}
	return ""
}

func TestEmitFloatCastUint64ToFloat64() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	if !emitFloatCast(a, m, x64.R10, x64.R11, types.TypUint64(), types.TypFloat64()) {
		return "uint64 → float64 cast should be handled"
	}
	// Unsigned 64-bit uses the sign-bit add-back: CVTSI2SD (F2 0F 2A) of
	// the round-to-odd halved value, then ADDSD (F2 0F 58) to double it.
	// The signed path emits no ADDSD, so its presence pins the unsigned
	// branch.
	if !findSSEOp(a, 0xF2, 0x2A) {
		return "uint64 → float64 should emit CVTSI2SD (F2 [REX]? 0F 2A)"
	}
	if !findSSEOp(a, 0xF2, 0x58) {
		return "uint64 → float64 should emit ADDSD add-back (F2 [REX]? 0F 58)"
	}
	return ""
}

// A `readonly` (or named) uint64 source must take the SAME unsigned add-back path
// as a plain uint64: StripWrappers reaches the uint64 whose Width 64 gates
// emitUint64ToDouble.  An un-peeled `.Width` read the TYP_READONLY wrapper's Width 0
// and fell through to the SIGNED CVTSI2SD, flipping the sign of a bit-63-set value.
// Live at -O1+ (mem2reg keeps a readonly-uint64 param type on the cast operand), and
// at all opt levels for a `type U uint64`.
func TestEmitFloatCastReadonlyUint64ToFloat64() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var roU64 @types.Type = types.MakeReadonlyType(types.TypUint64())
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	if !emitFloatCast(a, m, x64.R10, x64.R11, roU64, types.TypFloat64()) {
		return "readonly uint64 → float64 cast should be handled"
	}
	if !findSSEOp(a, 0xF2, 0x58) {
		return "readonly uint64 → float64 must emit ADDSD add-back (peel), not signed CVTSI2SD"
	}
	return ""
}

func TestEmitFloatCastFloat64ToInt() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	if !emitFloatCast(a, m, x64.R10, x64.R11, types.TypFloat64(), types.TypInt()) {
		return "float64 → int cast should be handled"
	}
	// CVTTSD2SI encodes as F2 REX.W 0F 2C.
	if !findSSEOp(a, 0xF2, 0x2C) {
		return "float64 → int should emit CVTTSD2SI (F2 [REX]? 0F 2C)"
	}
	return ""
}

func TestEmitFloatCastFloat64ToUint64() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	if !emitFloatCast(a, m, x64.R10, x64.R11, types.TypFloat64(), types.TypUint64()) {
		return "float64 → uint64 cast should be handled"
	}
	// Unsigned uses the subtract-2^63 idiom: UCOMISD (66 0F 2E) vs the
	// 2^63 constant, then SUBSD (F2 0F 5C) on the big path.  The signed
	// path emits neither, so SUBSD's presence pins the unsigned branch.
	if !findSSEOp(a, 0xF2, 0x5C) {
		return "float64 → uint64 should emit SUBSD (F2 [REX]? 0F 5C)"
	}
	if !findSSEOp(a, 0x66, 0x2E) {
		return "float64 → uint64 should emit UCOMISD (66 [REX]? 0F 2E)"
	}
	return ""
}

func TestEmitFloatCastFloat32ToFloat64() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	if !emitFloatCast(a, m, x64.R10, x64.R11, types.TypFloat32(), types.TypFloat64()) {
		return "float32 → float64 cast should be handled"
	}
	// CVTSS2SD encodes as F3 0F 5A.
	if !findSSEOp(a, 0xF3, 0x5A) {
		return "float32 → float64 should emit CVTSS2SD (F3 [REX]? 0F 5A)"
	}
	return ""
}

func TestEmitFloatCastFloat64ToFloat64() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	if !emitFloatCast(a, m, x64.R10, x64.R11, types.TypFloat64(), types.TypFloat64()) {
		return "float64 → float64 should be handled as plain MOV"
	}
	// Same-width float→float: plain MOV — no SSE prefix.
	var s @asm.Section = a.Sections[0]
	if s.Len == 0 {
		return "same-width float→float should still MOV"
	}
	for i := 0; i < s.Len; i++ {
		if s.Data[i] == cast(uint8, 0xF2) || s.Data[i] == cast(uint8, 0xF3) {
			return "same-width float→float should not emit SSE prefix"
		}
	}
	return ""
}

func TestEmitFloatCastRejectsIntToInt() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	if emitFloatCast(a, m, x64.R10, x64.R11, types.TypInt(), types.TypInt()) {
		return "int → int should not route through emitFloatCast"
	}
	if floatBytes(a) != 0 {
		return "rejected cast should emit nothing"
	}
	return ""
}

// ============================================================
// emitConstFloat
// ============================================================

// 0.0 lowers to MOV reg, imm64 with imm=0 — which x64.Mov picks the
// short encoding for.  Pin: at least one byte gets emitted, and the
// emitted instruction is not an SSE op.
func TestEmitConstFloatZero() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_CONST_FLOAT
	ins.Typ = types.TypFloat64()
	ins.StrVal = "0"
	emitConstFloat(a, x64.R10, ins)
	var s @asm.Section = a.Sections[0]
	if s.Len == 0 {
		return "OP_CONST_FLOAT 0 should still emit instructions"
	}
	return ""
}

// ============================================================
// Float ABI: NSRN counter routes float args / returns through XMM0..XMM7
// ============================================================
//
// The conformance fmt float tests and 282 (cast(int, -4.75)) cover
// the integration shape end-to-end; these unit pins are the early-
// warning system for an ABI-side regression that swaps XMM0 for
// RDI or skips the MOVQ entirely.

// emitCall with one float scalar arg must MOVQ that value into XMM0
// (not RDI).  MOVQ gp→xmm encodes as 66 [REX]? 0F 6E /r — findSSEOp
// scans for the prefix + 0F + opcode triple tolerating REX.
func TestEmitCallFloatArgRoutesThroughXmm0() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var arg0 @ir.Instr = make(ir.Instr)
	arg0.ID = 1
	arg0.Typ = types.TypFloat64()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_CALL
	ins.StrVal = "pkg/std/strconv.FormatFloat"
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = arg0
	emitCall(a, "main", m, ins)
	if !findSSEOp(a, 0x66, 0x6E) {
		return "float arg should MOVQ (66 [REX]? 0F 6E) into XMM0"
	}
	return ""
}

// emitCall returning a float scalar must MOVQ XMM0 into the result
// register (skipping the RAX path).  MOVQ xmm→gp encodes as 66
// [REX]? 0F 7E /r.
func TestEmitCallFloatReturnMovqsXmm0() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CALL
	ins.Typ = types.TypFloat64()
	ins.StrVal = "anyFloatReturningCallee"
	ins.Args = make_slice(@ir.Instr, 0)
	emitCall(a, "main", m, ins)
	if !findSSEOp(a, 0x66, 0x7E) {
		return "float return should MOVQ XMM0 (66 [REX]? 0F 7E) to rd"
	}
	return ""
}

// emitFloatCompare on OP_EQ must emit UCOMISD (66 [REX]? 0F 2E) +
// a SETcc pair (the primary SETE plus the NaN-gate SETNP), ANDed
// together so NaN compares produce false.  Pins the dispatch from
// emitCompare → emitFloatCompare and the UCOMISD encoding wire-up.
// Mirrors aa64's TestInvertFloatCondForOp coverage of the structural
// invariants.
func TestEmitFloatCompareEqEmitsUcomisdAndNaNGate() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypFloat64()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypFloat64()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_EQ
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitFloatCompare(a, m, ins) {
		return "emitFloatCompare should match float OP_EQ"
	}
	// UCOMISD opcode: 66 [REX]? 0F 2E /r.
	if !findSSEOp(a, 0x66, 0x2E) {
		return "OP_EQ on float should emit UCOMISD (66 [REX]? 0F 2E)"
	}
	// SETNP 0F 9B /0.  Look for the 0x9B byte (preceded by 0x0F).
	var s @asm.Section = a.Sections[0]
	var sawSetnp bool = false
	for i := 0; i < s.Len - 1; i++ {
		if s.Data[i] == cast(uint8, 0x0F) && s.Data[i + 1] == cast(uint8, 0x9B) {
			sawSetnp = true
			break
		}
	}
	if !sawSetnp {
		return "EQ/LT/LE must emit SETNP (0F 9B) to gate out NaN"
	}
	return ""
}

// emitFloatCompare on OP_NE is UNORDERED (IEEE 754 / Go): SETNE OR'd
// with SETP, so NaN (PF=1) makes `!=` true — the exact complement of
// the ordered ==.  Pin SETP (0F 9A) present and the ordered-gate SETNP
// (0F 9B) ABSENT — the discriminator between the unordered NE and the
// old ordered one.
func TestEmitFloatCompareNeUnordered() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypFloat64()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypFloat64()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_NE
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitFloatCompare(a, m, ins) {
		return "emitFloatCompare should match float OP_NE"
	}
	var s @asm.Section = a.Sections[0]
	var sawSetne bool = false
	var sawSetp bool = false
	var sawSetnp bool = false
	for i := 0; i < s.Len - 1; i++ {
		if s.Data[i] == cast(uint8, 0x0F) {
			if s.Data[i + 1] == cast(uint8, 0x95) { sawSetne = true }
			if s.Data[i + 1] == cast(uint8, 0x9A) { sawSetp = true }
			if s.Data[i + 1] == cast(uint8, 0x9B) { sawSetnp = true }
		}
	}
	if !sawSetne {
		return "OP_NE on float should emit SETNE (0F 95)"
	}
	if !sawSetp {
		return "OP_NE (unordered) must emit SETP (0F 9A)"
	}
	if sawSetnp {
		return "OP_NE must NOT emit the ordered-gate SETNP (0F 9B)"
	}
	return ""
}

// emitFloatCompare on OP_GT skips the NaN gate — SETA (0F 97) alone
// is false for NaN (CF=1, so SETA's CF=0 AND ZF=0 condition fails).
// Pin the absence of SETNP to prevent a regression that re-adds it
// "for safety" (which would still be correct but waste bytes).
func TestEmitFloatCompareGtNoNaNGate() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypFloat64()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypFloat64()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_GT
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitFloatCompare(a, m, ins) {
		return "emitFloatCompare should match float OP_GT"
	}
	// SETA: 0F 97.  Required.
	var s @asm.Section = a.Sections[0]
	var sawSeta bool = false
	var sawSetnp bool = false
	for i := 0; i < s.Len - 1; i++ {
		if s.Data[i] == cast(uint8, 0x0F) {
			if s.Data[i + 1] == cast(uint8, 0x97) { sawSeta = true }
			if s.Data[i + 1] == cast(uint8, 0x9B) { sawSetnp = true }
		}
	}
	if !sawSeta {
		return "OP_GT on float should emit SETA (0F 97)"
	}
	if sawSetnp {
		return "OP_GT on float should NOT emit SETNP — SETA alone is NaN-safe"
	}
	return ""
}

// emitFloatCompare must reject int-typed operands so the integer
// CMP path keeps handling them.  Mirrors emitFloatBinop's int-
// rejection.
func TestEmitFloatCompareRejectsIntOperands() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var lhs @ir.Instr = make(ir.Instr)
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_EQ
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if emitFloatCompare(a, m, ins) {
		return "emitFloatCompare should reject int operands"
	}
	if floatBytes(a) != 0 {
		return "rejected op should emit nothing"
	}
	return ""
}

// OP_RETURN of a float scalar must MOVQ the source GP into XMM0
// (NOT mov it into RAX).  Same encoding shape as the call-arg case.
func TestEmitReturnFloatMovqsXmm0() testing.TestResult {
	var a @asm.Assembler = floatMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypFloat64()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_RETURN
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	emitReturn(a, "main", m, ins)
	if !findSSEOp(a, 0x66, 0x6E) {
		return "float OP_RETURN should MOVQ src into XMM0 (66 [REX]? 0F 6E)"
	}
	return ""
}
