package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"

// isFoldedAddConstX64 reports whether operand `arg` is an OP_CONST_INT the fold
// marked to ride an add/sub immediate (FoldedAddImmConst) — so it was left
// unhomed and skip-emitted, and must be consumed as an immediate, never via
// getOperand (which would return -1).
func isFoldedAddConstX64(rm @common.RegMap, arg @ir.Instr) bool {
	return arg != nil && arg.Op == iropcode.OP_CONST_INT && rm.IsFoldedAddImmConst(arg.ID)
}

// emitAddSubImmFoldX64 lowers an OP_ADD / OP_SUB whose constant operand was
// marked FoldedAddImmConst: the constant rides the ADD/SUB sign-extended
// immediate (`add`/`sub rd, #v`).  emitALU picks the short imm8 or imm32 form and
// sign-extends, so a small negative rides the immediate directly — no operation
// swap is needed (unlike the AArch64/arm32 unsigned add-immediate).  ADD is
// commutative so the constant may be either operand (the other supplies the
// register addend); SUB folds only its subtrahend (Args[1]).  Width and sub-word
// re-narrow mirror emitBinop's register path exactly (32-bit-unsigned uses the
// SZ32 op that self-clears the top half; everything else runs SZ64 and
// re-narrows), so the folded result is bit-identical.  Returns false when neither
// operand is a folded constant, leaving emitBinop's register path to run.
func emitAddSubImmFoldX64(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_ADD && ins.Op != iropcode.OP_SUB { return false }
	if len(ins.Args) != 2 { return false }
	var c0 bool = isFoldedAddConstX64(rm, ins.Args[0])
	var c1 bool = isFoldedAddConstX64(rm, ins.Args[1])
	// SUB folds only its subtrahend; the analysis never marks a minuend, so with
	// c1 false there is nothing here to fold — defer to the register path.
	if ins.Op == iropcode.OP_SUB && !c1 { return false }
	if !c0 && !c1 { return false }

	// The register operand is the non-constant one; the analysis guarantees at most
	// one operand is marked (it requires the sibling to be a non-constant).
	var regArg @ir.Instr = ins.Args[0]
	var cval int64 = 0
	if c1 {
		cval = ins.Args[1].IntVal
	} else {
		regArg = ins.Args[1]
		cval = ins.Args[0].IntVal
	}
	var reg int = getOperand(a, rm, regArg.ID)
	if reg < 0 { return false }

	var nw int
	var nsigned bool
	nw, nsigned = common.SubWordNarrow(ins.Typ, 64)
	var use32 bool = nw == 32 && !nsigned
	var opSz int = x64.SZ64
	if use32 { opSz = x64.SZ32 }

	var rd int = nextReg(rm, ins.ID)
	var rdOp x64.Operand = x64.Reg(rd, opSz)
	x64.Mov(a, rdOp, x64.Reg(reg, opSz))
	if ins.Op == iropcode.OP_ADD {
		x64.Add(a, rdOp, x64.Imm(cast(int, cval)))
	} else {
		x64.Sub(a, rdOp, x64.Imm(cast(int, cval)))
	}
	if !use32 {
		emitSubWordNarrow(a, rd, ins.Typ)
	}
	return true
}
