package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/native/fold"

// x64WordBytes is the x64 word size in bytes: the widest integer an immediate
// operand can stand in for.  The fold predicate and the immediate emitters pass
// it to the shared position helpers (fold.CmpImmOperand, fold.AddSubImmOperand).
const x64WordBytes int = 8

// x64ImmMax is the largest constant an x64 CMP / ADD / SUB immediate carries:
// the immediate is a sign-extended imm32, so 2^31-1.
const x64ImmMax int64 = 2147483647

// x64ImmMin is the smallest constant an x64 CMP / ADD / SUB immediate carries:
// the sign-extended imm32's -2^31.
const x64ImmMin int64 = -2147483648

// x64CmpImm returns (value, true) iff operand argIdx of `user` is a constant in a
// compare-immediate position (fold.CmpImmOperand) that fits the sign-extended
// imm32 (fold.CmpImmFits).  A negative constant fits only a SIGNED compare: in an
// unsigned compare it denotes a near-2^64 value, which the sign-extended imm32
// cannot carry.  Both x64ImmFits and emitCmpAgainst decide the fit here.
func x64CmpImm(user @ir.Instr, argIdx int) (int64, bool) {
	var v int64
	var isUns bool
	var ok bool
	v, isUns, ok = fold.CmpImmOperand(user, argIdx, x64WordBytes)
	if !ok || !fold.CmpImmFits(v, isUns, x64ImmMax, x64ImmMin) { return v, false }
	return v, true
}

// x64AddSubImm returns (value, true) iff operand argIdx of `user` is a constant
// in an add/sub-immediate position (fold.AddSubImmOperand) that fits the
// sign-extended imm32 (fold.AddSubImmFits).  Both x64ImmFits and
// emitAddSubImmFoldX64 decide the fit here.
func x64AddSubImm(user @ir.Instr, argIdx int) (int64, bool) {
	var v int64
	var ok bool
	v, ok = fold.AddSubImmOperand(user, argIdx, x64WordBytes)
	if !ok || !fold.AddSubImmFits(v, x64ImmMax, x64ImmMin) { return v, false }
	return v, true
}

// x64ImmFits is the x64 predicate for fold.ImmOperandConsts: operand argIdx of
// `user` can ride an immediate iff it is a compare RHS (x64CmpImm) or an add/sub
// operand (x64AddSubImm) that fits the sign-extended imm32.  Every other operand
// position needs its value in a register.
func x64ImmFits(user @ir.Instr, argIdx int) bool {
	var ok bool
	_, ok = x64CmpImm(user, argIdx)
	if ok { return true }
	_, ok = x64AddSubImm(user, argIdx)
	return ok
}

// isFoldedImmX64 reports whether operand `arg` is an OP_CONST_INT the fold marked
// FoldedImm — so it was left unhomed and skip-emitted, and must be consumed as an
// immediate, never read through getOperand (which fails loud on it).
func isFoldedImmX64(rm @common.RegMap, arg @ir.Instr) bool {
	return arg != nil && arg.Op == iropcode.OP_CONST_INT && rm.IsFoldedImm(arg.ID)
}

// emitAddSubImmFoldX64 lowers an OP_ADD / OP_SUB with a FoldedImm constant
// operand: the constant rides the ADD/SUB sign-extended immediate
// (`add`/`sub rd, #v`).  emitALU picks the short imm8 or imm32 form and
// sign-extends, so a small negative rides the immediate directly — no operation
// swap is needed (unlike the AArch64/arm32 unsigned add-immediate).  ADD is
// commutative so the constant may be either operand (the other supplies the
// register addend); SUB folds only its subtrahend (Args[1]).  Width and sub-word
// re-narrow mirror emitBinop's register path exactly (32-bit-unsigned uses the
// SZ32 op that self-clears the top half; everything else runs SZ64 and
// re-narrows), so the folded result is bit-identical.
//
// The fit is re-verified with x64AddSubImm, the check x64ImmFits applied: a
// folded constant that does not fit its position (out of imm32 range, a SUB
// minuend, or both operands folded) records an error and emits nothing, since
// the constant was never materialized and there is no correct encoding.
// Returns false when neither operand is a folded constant, leaving emitBinop's
// register path to run; true once the instruction is handled, including when an
// error was recorded, so emitBinop never reads a folded constant as a register.
func emitAddSubImmFoldX64(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_ADD && ins.Op != iropcode.OP_SUB { return false }
	if len(ins.Args) != 2 { return false }
	var c0 bool = isFoldedImmX64(rm, ins.Args[0])
	var c1 bool = isFoldedImmX64(rm, ins.Args[1])
	if !c0 && !c1 { return false }

	// The folded constant is the immediate; the other operand is the register.
	var ci int = 1
	if !c1 { ci = 0 }
	var cval int64
	var ok bool
	cval, ok = x64AddSubImm(ins, ci)
	if !ok {
		a.SetError("native amd64: folded immediate does not fit its add/sub operand")
		return true
	}
	var regArg @ir.Instr = ins.Args[1 - ci]
	var reg int = getOperand(a, rm, regArg.ID)
	if reg < 0 {
		a.SetError("native amd64: add/sub with a folded immediate has no register operand")
		return true
	}

	var nw int
	var nsigned bool
	nw, nsigned = common.SubWordNarrow(ins.Typ, 64)
	var use32 bool = nw == 32 && !nsigned
	var opSz int = x64.SZ64
	if use32 { opSz = x64.SZ32 }

	var rd int = nextReg(rm, ins.ID)
	var rdOp x64.Operand = x64.Reg(rd, opSz)
	x64.Mov(a, rdOp, x64.Reg(reg, opSz))
	if ins.Op == iropcode.OP_ADD {
		x64.Add(a, rdOp, x64.Imm(cast(int, cval)))
	} else {
		x64.Sub(a, rdOp, x64.Imm(cast(int, cval)))
	}
	if !use32 {
		emitSubWordNarrow(a, rd, ins.Typ)
	}
	return true
}
