package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// x64FoldHasByte reports whether the emitted text stream contains byte `b`.  The
// add/sub-immediate fold tests key on opcode bytes: 0x83 is the ALU-with-imm8
// form (folded), 0x01 the ADD reg,reg form and 0x29 the SUB reg,reg form (the
// unfolded register path).
func x64FoldHasByte(a @asm.Assembler, b int) bool {
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, b) { return true }
	}
	return false
}

// x64FoldAddSub builds an ADD/SUB `ins` over a spilled register operand `regID`
// and a FoldedAddImmConst constant `cval` (id `cID`), placing the const at
// argIdx (0 or 1), and emits it.  Returns the assembler for byte inspection.
func x64FoldAddSub(op int, regID int, cID int, cval int64, argIdx int,
		t @types.Type) @asm.Assembler {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, regID)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var fc @[]bool = make_slice(bool, cID + 1)
	fc[cID] = true
	m.FoldedAddImmConst = fc
	var reg @ir.Instr = make(ir.Instr)
	reg.ID = regID
	reg.Typ = t
	var c @ir.Instr = make(ir.Instr)
	c.ID = cID
	c.Op = iropcode.OP_CONST_INT
	c.Typ = t
	c.IntVal = cval
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = op
	ins.Typ = t
	ins.Args = make_slice(@ir.Instr, 2)
	if argIdx == 0 {
		ins.Args[0] = c
		ins.Args[1] = reg
	} else {
		ins.Args[0] = reg
		ins.Args[1] = c
	}
	_ = emitBinop(a, m, ins)
	return a
}

// A folded ADD constant (RHS) rides the ALU imm8 form (0x83) — not the register
// ADD (0x01) — and the constant is never materialized.
func TestX64AddImmFoldRhsEmitsImm() testing.TestResult {
	var a @asm.Assembler = x64FoldAddSub(iropcode.OP_ADD, 1, 2, cast(int64, 5), 1, types.TypInt())
	if !x64FoldHasByte(a, 0x83) { return "a folded ADD const must emit the imm8 ALU form (0x83)" }
	if x64FoldHasByte(a, 0x01) { return "a folded ADD const must NOT emit a register ADD (0x01)" }
	return ""
}

// ADD is commutative: a folded constant on the LHS folds too.
func TestX64AddImmFoldLhsCommutes() testing.TestResult {
	var a @asm.Assembler = x64FoldAddSub(iropcode.OP_ADD, 1, 2, cast(int64, 7), 0, types.TypInt())
	if !x64FoldHasByte(a, 0x83) {
		return "a folded ADD const on the LHS must emit the imm form (0x83)"
	}
	if x64FoldHasByte(a, 0x01) { return "a folded LHS const must NOT emit a register ADD (0x01)" }
	return ""
}

// A folded SUB subtrahend rides the imm form (0x83), not the register SUB (0x29).
func TestX64SubImmFoldSubtrahend() testing.TestResult {
	var a @asm.Assembler = x64FoldAddSub(iropcode.OP_SUB, 1, 2, cast(int64, 5), 1, types.TypInt())
	if !x64FoldHasByte(a, 0x83) { return "a folded SUB subtrahend must emit the imm form (0x83)" }
	if x64FoldHasByte(a, 0x29) { return "a folded SUB subtrahend must NOT emit a register SUB (0x29)" }
	return ""
}

// A small negative ADD constant rides the sign-extended imm8 directly on x64 (no
// operation swap): still the imm form (0x83), never a register ADD (0x01).
func TestX64AddImmFoldNegative() testing.TestResult {
	var a @asm.Assembler = x64FoldAddSub(iropcode.OP_ADD, 1, 2, cast(int64, 0) - cast(int64, 5), 1,
			types.TypInt())
	if !x64FoldHasByte(a, 0x83) { return "x + (-5) must emit the imm8 ALU form (0x83)" }
	if x64FoldHasByte(a, 0x01) { return "x + (-5) must NOT emit a register ADD (0x01)" }
	return ""
}
