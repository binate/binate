package "pkg/binate/native/x64"

import "pkg/binate/irbuild"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/native/fold"
import "pkg/binate/types"
import "pkg/builtins/testing"

// x64FoldHasByte reports whether the emitted text stream contains byte `b`.  The
// add/sub-immediate fold tests key on opcode bytes: 0x83 is the ALU-with-imm8
// form (folded), 0x01 the ADD reg,reg form and 0x29 the SUB reg,reg form (the
// unfolded register path).
func x64FoldHasByte(a @asm.Assembler, b int) bool {
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, b) { return true }
	}
	return false
}

// x64FoldImmBinop builds a binop `ins` (opcode op, type t) over a spilled
// register operand `regID` and a FoldedImm constant `cval` (id `cID`), placing
// the const at argIdx (0 or 1), and emits it through emitBinop.  Returns the
// assembler for byte inspection.
func x64FoldImmBinop(op int, regID int, cID int, cval int64, argIdx int,
		t @types.Type) @asm.Assembler {
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, regID)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	return x64FoldImmBinopIn(m, op, regID, cID, cval, argIdx, t)
}

// x64FoldImmBinopIn is x64FoldImmBinop over a caller-supplied RegMap `m`, which
// decides where (if anywhere) the register operand `regID` lives; it marks the
// constant `cID` FoldedImm in m before emitting.
func x64FoldImmBinopIn(m @common.RegMap, op int, regID int, cID int, cval int64, argIdx int,
		t @types.Type) @asm.Assembler {
	var a @asm.Assembler = opsMkAssembler()
	var fc @[]bool = make_slice(bool, cID + 1)
	fc[cID] = true
	m.FoldedImm = fc
	var reg @ir.Instr = make(ir.Instr)
	reg.ID = regID
	reg.Op = iropcode.OP_PARAM
	reg.Typ = t
	var c @ir.Instr = make(ir.Instr)
	c.ID = cID
	c.Op = iropcode.OP_CONST_INT
	c.Typ = t
	c.IntVal = cval
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = op
	ins.Typ = t
	ins.Args = make_slice(@ir.Instr, 2)
	if argIdx == 0 {
		ins.Args[0] = c
		ins.Args[1] = reg
	} else {
		ins.Args[0] = reg
		ins.Args[1] = c
	}
	_ = emitBinop(a, m, ins)
	return a
}

// A folded ADD constant (RHS) rides the ALU imm8 form (0x83) — not the register
// ADD (0x01) — and the constant is never materialized.
func TestX64AddImmFoldRhsEmitsImm() testing.TestResult {
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_ADD, 1, 2, cast(int64, 5), 1, types.TypInt())
	if a.HasError { return "an in-range folded ADD const must emit without error" }
	if !x64FoldHasByte(a, 0x83) { return "a folded ADD const must emit the imm8 ALU form (0x83)" }
	if x64FoldHasByte(a, 0x01) { return "a folded ADD const must NOT emit a register ADD (0x01)" }
	return ""
}

// ADD is commutative: a folded constant on the LHS folds too.
func TestX64AddImmFoldLhsCommutes() testing.TestResult {
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_ADD, 1, 2, cast(int64, 7), 0, types.TypInt())
	if !x64FoldHasByte(a, 0x83) {
		return "a folded ADD const on the LHS must emit the imm form (0x83)"
	}
	if x64FoldHasByte(a, 0x01) { return "a folded LHS const must NOT emit a register ADD (0x01)" }
	return ""
}

// A folded SUB subtrahend rides the imm form (0x83), not the register SUB (0x29).
func TestX64SubImmFoldSubtrahend() testing.TestResult {
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_SUB, 1, 2, cast(int64, 5), 1, types.TypInt())
	if !x64FoldHasByte(a, 0x83) { return "a folded SUB subtrahend must emit the imm form (0x83)" }
	if x64FoldHasByte(a, 0x29) { return "a folded SUB subtrahend must NOT emit a register SUB (0x29)" }
	return ""
}

// A small negative ADD constant rides the sign-extended imm8 directly on x64 (no
// operation swap): still the imm form (0x83), never a register ADD (0x01).
func TestX64AddImmFoldNegative() testing.TestResult {
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_ADD, 1, 2, cast(int64, 0) - cast(int64, 5), 1,
			types.TypInt())
	if !x64FoldHasByte(a, 0x83) { return "x + (-5) must emit the imm8 ALU form (0x83)" }
	if x64FoldHasByte(a, 0x01) { return "x + (-5) must NOT emit a register ADD (0x01)" }
	return ""
}

// An ADD whose folded constant does not fit the imm32 (x64ImmMax + 1) records an
// error and emits nothing: the constant was never materialized, so there is no
// correct encoding to fall back to.
func TestX64AddImmFoldOutOfRangeErrors() testing.TestResult {
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_ADD, 1, 2, x64ImmMax + cast(int64, 1), 1,
			types.TypInt())
	if !a.HasError { return "a folded ADD const out of imm32 range must record an error" }
	if a.Sections[0].Len != 0 { return "a misfit folded ADD const must emit nothing" }
	return ""
}

// A folded constant in a SUB minuend (not an immediate position) records an
// error and emits nothing, rather than reading the constant as a register.
func TestX64SubImmFoldMinuendErrors() testing.TestResult {
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_SUB, 1, 2, cast(int64, 5), 0, types.TypInt())
	if !a.HasError { return "a folded SUB minuend must record an error" }
	if a.Sections[0].Len != 0 { return "a folded SUB minuend must emit nothing" }
	return ""
}

// An ADD whose folded constant fits but whose register operand lives nowhere
// (not homed, cached, or spilled) records the missing-register error and emits
// nothing: getOperand yields no register, and the emitter must not encode the
// immediate op against one.
func TestX64AddImmFoldNoRegisterErrors() testing.TestResult {
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	var a @asm.Assembler = x64FoldImmBinopIn(m, iropcode.OP_ADD, 1, 2, cast(int64, 5), 1,
			types.TypInt())
	if !a.HasError { return "an ADD with no register operand must record an error" }
	if !x64FoldSameText(a.ErrorMsg,
			"native amd64: add/sub with a folded immediate has no register operand") {
		return buf.Concat("an ADD with no register operand recorded: ", a.ErrorMsg)
	}
	if a.Sections[0].Len != 0 { return "an ADD with no register operand must emit nothing" }
	return ""
}

// x64ImmNewFunc makes an empty function for the fold-predicate tests.
func x64ImmNewFunc() @ir.Func {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	return ir.NewFunc("", "t", noP, noR)
}

// x64ImmParam makes a non-constant value of type t (an OP_PARAM reference).
func x64ImmParam(f @ir.Func, t @types.Type) @ir.Instr {
	return irbuild.NewParamRef(f, irbuild.NewParam(f, "p", t))
}

// x64ImmFolded runs the x64 fold (fold.ImmOperandConsts with x64ImmFits) over f
// and reports whether constant c is flagged.
func x64ImmFolded(f @ir.Func, c @ir.Instr) bool {
	return fold.ImmOperandConsts(f, x64ImmFits)[c.ID]
}

// x64ImmCmpFolded builds `x < c` over type t, with the constant c (value v) on
// the RHS — or `c < x` when constLhs — and reports whether c folds.
func x64ImmCmpFolded(t @types.Type, v int64, constLhs bool) bool {
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt64(b, v, t)
	var x @ir.Instr = x64ImmParam(f, t)
	if constLhs {
		_ = irbuild.EmitBinop(b, iropcode.OP_LT, c, x, types.TypBool())
	} else {
		_ = irbuild.EmitBinop(b, iropcode.OP_LT, x, c, types.TypBool())
	}
	return x64ImmFolded(f, c)
}

// x64ImmBinopFolded builds `x OP c` (or `c OP x` when constLhs) over type t
// with constant `v` and reports whether c folds.
func x64ImmBinopFolded(op int, t @types.Type, v int64, constLhs bool) bool {
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt64(b, v, t)
	var x @ir.Instr = x64ImmParam(f, t)
	if constLhs {
		_ = irbuild.EmitBinop(b, op, c, x, t)
	} else {
		_ = irbuild.EmitBinop(b, op, x, c, t)
	}
	return x64ImmFolded(f, c)
}

// A compare RHS constant in imm32 range folds; the same constant as a compare
// LHS never does (the LHS is the CMP's register operand).
func TestX64ImmFitsCmpRhsNotLhs() testing.TestResult {
	if !x64ImmCmpFolded(types.TypInt(), cast(int64, 42), false) {
		return "an in-range compare RHS constant must fold"
	}
	if x64ImmCmpFolded(types.TypInt(), cast(int64, 42), true) {
		return "a compare LHS constant must NOT fold"
	}
	return ""
}

// The compare RHS range is the sign-extended imm32: x64ImmMax and (signed)
// x64ImmMin fold, one past either end does not.
func TestX64ImmFitsCmpRangeEdges() testing.TestResult {
	var one int64 = 1
	if !x64ImmCmpFolded(types.TypInt(), x64ImmMax, false) { return "x < 2^31-1 must fold" }
	if x64ImmCmpFolded(types.TypInt(), x64ImmMax + one, false) { return "x < 2^31 must NOT fold" }
	if !x64ImmCmpFolded(types.TypInt(), x64ImmMin, false) { return "x < -2^31 (signed) must fold" }
	if x64ImmCmpFolded(types.TypInt(), x64ImmMin - one, false) {
		return "x < -2^31-1 must NOT fold"
	}
	return ""
}

// A negative compare RHS folds only into a signed compare: in an unsigned compare
// it denotes a near-2^64 value the sign-extended imm32 cannot carry.  A small
// non-negative constant folds into either.
func TestX64ImmFitsCmpNegativeSignedOnly() testing.TestResult {
	var neg int64 = 0 - 5
	if !x64ImmCmpFolded(types.TypInt(), neg, false) { return "a signed x < -5 must fold" }
	if x64ImmCmpFolded(types.TypUint64(), neg, false) {
		return "an unsigned compare against a negative constant must NOT fold"
	}
	if !x64ImmCmpFolded(types.TypUint64(), cast(int64, 5), false) {
		return "an unsigned x < 5 must fold"
	}
	return ""
}

// An ADD constant folds on either side (ADD is commutative), including a small
// negative (the imm32 sign-extends) and the imm32 range ends; one past either end
// does not.
func TestX64ImmFitsAddEitherSideAndRange() testing.TestResult {
	var one int64 = 1
	var t @types.Type = types.TypInt()
	if !x64ImmBinopFolded(iropcode.OP_ADD, t, cast(int64, 7), false) { return "x + 7 must fold" }
	if !x64ImmBinopFolded(iropcode.OP_ADD, t, cast(int64, 7), true) { return "7 + x must fold" }
	if !x64ImmBinopFolded(iropcode.OP_ADD, t, cast(int64, 0) - cast(int64, 5), false) {
		return "x + (-5) must fold"
	}
	if !x64ImmBinopFolded(iropcode.OP_ADD, t, x64ImmMax, false) { return "x + (2^31-1) must fold" }
	if !x64ImmBinopFolded(iropcode.OP_ADD, t, x64ImmMin, false) { return "x + (-2^31) must fold" }
	if x64ImmBinopFolded(iropcode.OP_ADD, t, x64ImmMax + one, false) {
		return "x + 2^31 must NOT fold"
	}
	if x64ImmBinopFolded(iropcode.OP_ADD, t, x64ImmMin - one, false) {
		return "x + (-2^31-1) must NOT fold"
	}
	return ""
}

// A SUB folds its subtrahend (`x - #v`) but never its minuend (`#v - x` would
// need a reverse subtract).
func TestX64ImmFitsSubSubtrahendNotMinuend() testing.TestResult {
	var t @types.Type = types.TypInt()
	if !x64ImmBinopFolded(iropcode.OP_SUB, t, cast(int64, 3), false) { return "x - 3 must fold" }
	if x64ImmBinopFolded(iropcode.OP_SUB, t, cast(int64, 3), true) {
		return "a SUB minuend constant must NOT fold"
	}
	return ""
}

// A const+const ADD folds neither operand: one of them must supply the register.
func TestX64ImmFitsConstPlusConstNotFolded() testing.TestResult {
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt())
	var d @ir.Instr = irbuild.EmitConstInt(b, 4, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_ADD, c, d, types.TypInt())
	var flags @[]bool = fold.ImmOperandConsts(f, x64ImmFits)
	if flags[c.ID] || flags[d.ID] { return "a const+const ADD must fold neither constant" }
	return ""
}

// A constant used both as a compare RHS and as an ADD operand, each in range,
// folds: every use rides an immediate.  Adding a MUL use (no immediate form)
// keeps it in a register.
func TestX64ImmFitsMixedCmpAndAddFolds() testing.TestResult {
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(b, 9, types.TypInt())
	var x @ir.Instr = x64ImmParam(f, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_LT, x, c, types.TypBool())
	_ = irbuild.EmitBinop(b, iropcode.OP_ADD, x, c, types.TypInt())
	if !x64ImmFolded(f, c) { return "a compare-RHS + ADD constant must fold" }
	_ = irbuild.EmitBinop(b, iropcode.OP_MUL, x, c, types.TypInt())
	if x64ImmFolded(f, c) { return "a constant with a MUL use must NOT fold" }
	return ""
}

// x64's word is 8 bytes, so an int64 / uint64 compare or add folds (the width
// guard only excludes operands wider than the word).
func TestX64ImmFitsInt64Folds() testing.TestResult {
	if !x64ImmCmpFolded(types.TypInt64(), cast(int64, 5), false) {
		return "an int64 compare RHS must fold on x64"
	}
	if !x64ImmCmpFolded(types.TypUint64(), cast(int64, 5), false) {
		return "a uint64 compare RHS must fold on x64"
	}
	if !x64ImmBinopFolded(iropcode.OP_ADD, types.TypInt64(), cast(int64, 5), false) {
		return "an int64 ADD constant must fold on x64"
	}
	return ""
}

// x64FoldCountImm32 counts the occurrences of little-endian imm32 `v` in the text
// section.
func x64FoldCountImm32(a @asm.Assembler, v int) int {
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = 0
	for i := 0; i + 3 < a.Sections[0].Len; i++ {
		var hit bool = true
		for k := 0; k < 4; k++ {
			if data[i + k] != cast(uint8, (v >> (8 * k)) & 0xFF) { hit = false }
		}
		if hit { n = n + 1 }
	}
	return n
}

// x64FoldHasAluImm32 reports whether the text section holds `81 /ext imm32(v)`
// with a register destination: ext 0 is ADD, ext 4 is AND, ext 7 is CMP.
func x64FoldHasAluImm32(a @asm.Assembler, ext int, v int) bool {
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	for i := 0; i + 5 < a.Sections[0].Len; i++ {
		if data[i] != cast(uint8, 0x81) { continue }
		if (cast(int, data[i + 1]) & 0xF8) != (0xC0 | (ext << 3)) { continue }
		var hit bool = true
		for k := 0; k < 4; k++ {
			if data[i + 2 + k] != cast(uint8, (v >> (8 * k)) & 0xFF) { hit = false }
		}
		if hit { return true }
	}
	return false
}

// End to end through emitFunc: a constant used as both an ADD operand and a
// compare RHS rides `add r, imm32` and `cmp r, imm32` and is never materialized
// (its imm32 appears exactly twice, once per consuming instruction).
func TestX64EmitFuncFoldsMixedImmConst() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = opsMkAssembler()
	var noP @[]@ir.Param
	var res @[]@types.Type = make_slice(@types.Type, 1)
	res[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "main.f", noP, res)
	var p @ir.Param = irbuild.NewParam(f, "x", types.TypInt())
	var ps @[]@ir.Param = make_slice(@ir.Param, 1)
	ps[0] = p
	f.Params = ps
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var elseB @ir.Block = ir.AddBlock(f, "else")
	var x @ir.Instr = irbuild.NewParamRef(f, p)
	var imm int = 0x5A5A5A5A
	var c @ir.Instr = irbuild.EmitConstInt(entry, imm, types.TypInt())
	var s @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, x, c, types.TypInt())
	var lt @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_LT, s, c, types.TypBool())
	irbuild.EmitBranch(entry, lt, thenB, elseB)
	var rs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rs[0] = s
	irbuild.EmitReturn(thenB, rs)
	var rx @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rx[0] = x
	irbuild.EmitReturn(elseB, rx)
	emitFunc(a, "main", f, nilStrings())
	if a.HasError { return "emitFunc must lower the folded constant without error" }
	if !x64FoldHasAluImm32(a, 0, imm) { return "the ADD must ride `add r, imm32` (81 /0)" }
	if !x64FoldHasAluImm32(a, 7, imm) { return "the compare must ride `cmp r, imm32` (81 /7)" }
	if x64FoldCountImm32(a, imm) != 2 {
		return "the folded constant must appear only in its two consuming immediates"
	}
	return ""
}

// x64FoldTextHex renders the emitted text section as lowercase hex bytes
// separated by single spaces (e.g. "48 83 e3 0f"), the form the golden
// encodings below are spelled in.
func x64FoldTextHex(a @asm.Assembler) @[]char {
	var n int = a.Sections[0].Len
	if n == 0 { return make_slice(char, 0) }
	var digits *[]readonly char = "0123456789abcdef"
	var out @[]char = make_slice(char, n * 3 - 1)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	for i := 0; i < n; i++ {
		var b int = cast(int, data[i])
		out[i * 3] = digits[b >> 4]
		out[i * 3 + 1] = digits[b & 15]
		if i + 1 < n { out[i * 3 + 2] = ' ' }
	}
	return out
}

// x64FoldSameText reports whether got and want spell the same characters.
func x64FoldSameText(got *[]readonly char, want *[]readonly char) bool {
	if len(got) != len(want) { return false }
	for i := 0; i < len(got); i++ {
		if got[i] != want[i] { return false }
	}
	return true
}

// x64FoldGolden checks that `a` recorded no error and emitted exactly the bytes
// spelled by `want` (x64FoldTextHex form); on a mismatch it returns `what` with
// the bytes actually emitted.
func x64FoldGolden(a @asm.Assembler, want *[]readonly char,
		what *[]readonly char) testing.TestResult {
	if a.HasError { return buf.Concat(what, ": unexpected assembler error") }
	var got @[]char = x64FoldTextHex(a)
	if x64FoldSameText(got, want) { return "" }
	var head @[]char = buf.Concat(what, ": emitted ")
	return buf.Concat(head, got)
}

// ---- AND / OR / XOR immediate fold: the predicate ----

// An AND / OR / XOR constant folds on either side: all three ops are
// commutative, so the other operand supplies the register.
func TestX64ImmFitsLogicEitherSide() testing.TestResult {
	var t @types.Type = types.TypInt64()
	var v int64 = 0x0F
	if !x64ImmBinopFolded(iropcode.OP_AND, t, v, false) { return "x & 0xf must fold" }
	if !x64ImmBinopFolded(iropcode.OP_AND, t, v, true) { return "0xf & x must fold" }
	if !x64ImmBinopFolded(iropcode.OP_OR, t, v, false) { return "x | 0xf must fold" }
	if !x64ImmBinopFolded(iropcode.OP_OR, t, v, true) { return "0xf | x must fold" }
	if !x64ImmBinopFolded(iropcode.OP_XOR, t, v, false) { return "x ^ 0xf must fold" }
	if !x64ImmBinopFolded(iropcode.OP_XOR, t, v, true) { return "0xf ^ x must fold" }
	return ""
}

// A 64-bit AND / OR / XOR sign-extends its imm32, so its constant folds only in
// x64ImmMin..x64ImmMax: the range ends and -1 (all ones) fold; 2^31, the 32-bit
// mask 0xFFFFFFFF (whose imm32 would sign-extend to all ones) and -2^31-1 do not.
// x64's word is 8 bytes, so the width guard admits int64 / uint64.
func TestX64ImmFitsLogicSz64Range() testing.TestResult {
	var one int64 = 1
	var t @types.Type = types.TypInt64()
	if !x64ImmBinopFolded(iropcode.OP_AND, t, x64ImmMax, false) { return "x & (2^31-1) must fold" }
	if !x64ImmBinopFolded(iropcode.OP_OR, t, x64ImmMin, false) { return "x | (-2^31) must fold" }
	if !x64ImmBinopFolded(iropcode.OP_XOR, t, cast(int64, 0) - one, false) {
		return "x ^ -1 must fold"
	}
	if x64ImmBinopFolded(iropcode.OP_AND, t, x64ImmMax + one, false) {
		return "an int64 x & 2^31 must NOT fold"
	}
	if x64ImmBinopFolded(iropcode.OP_AND, t, x64Low32Mask, false) {
		return "an int64 x & 0xFFFFFFFF must NOT fold"
	}
	if x64ImmBinopFolded(iropcode.OP_XOR, t, x64ImmMin - one, false) {
		return "an int64 x ^ (-2^31-1) must NOT fold"
	}
	if x64ImmBinopFolded(iropcode.OP_OR, types.TypUint64(), x64ImmMax + one, false) {
		return "a uint64 x | 2^31 must NOT fold"
	}
	if !x64ImmBinopFolded(iropcode.OP_OR, types.TypUint64(), x64ImmMax, false) {
		return "a uint64 x | (2^31-1) must fold"
	}
	return ""
}

// A 32-bit unsigned AND / OR / XOR runs at SZ32, which reads only the low 32
// bits of its immediate, so any uint32 constant folds — including values at or
// above 2^31 that a 64-bit op could not carry.
func TestX64ImmFitsLogicSz32AnyUint32() testing.TestResult {
	var t @types.Type = types.TypUint32()
	if !x64ImmBinopFolded(iropcode.OP_AND, t, x64ImmMax + cast(int64, 1), false) {
		return "a uint32 x & 0x80000000 must fold"
	}
	if !x64ImmBinopFolded(iropcode.OP_OR, t, cast(int64, 0xFFFFFFF0), true) {
		return "a uint32 0xFFFFFFF0 | x must fold"
	}
	if !x64ImmBinopFolded(iropcode.OP_XOR, t, x64Low32Mask, false) {
		return "a uint32 x ^ 0xFFFFFFFF must fold"
	}
	return ""
}

// A sub-word AND / OR / XOR runs at SZ64 and is re-narrowed, so its constant
// folds whenever it is in the sign-extended imm32 range.
func TestX64ImmFitsLogicSubWord() testing.TestResult {
	if !x64ImmBinopFolded(iropcode.OP_AND, types.TypInt32(), cast(int64, 0) - cast(int64, 256),
			false) {
		return "an int32 x & -256 must fold"
	}
	if !x64ImmBinopFolded(iropcode.OP_OR, types.TypUint16(), cast(int64, 0xFFF0), false) {
		return "a uint16 x | 0xFFF0 must fold"
	}
	if !x64ImmBinopFolded(iropcode.OP_XOR, types.TypInt8(), cast(int64, 0) - cast(int64, 1), false) {
		return "an int8 x ^ -1 must fold"
	}
	return ""
}

// A const-const AND / OR / XOR folds neither operand: one of them must supply
// the register.
func TestX64ImmFitsLogicConstConstNotFolded() testing.TestResult {
	var ops @[]int = make_slice(int, 3)
	ops[0] = iropcode.OP_AND
	ops[1] = iropcode.OP_OR
	ops[2] = iropcode.OP_XOR
	for i := 0; i < len(ops); i++ {
		var f @ir.Func = x64ImmNewFunc()
		var b @ir.Block = ir.AddBlock(f, "entry")
		var c @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt())
		var d @ir.Instr = irbuild.EmitConstInt(b, 4, types.TypInt())
		_ = irbuild.EmitBinop(b, ops[i], c, d, types.TypInt())
		var flags @[]bool = fold.ImmOperandConsts(f, x64ImmFits)
		if flags[c.ID] || flags[d.ID] { return "a const-const logic op must fold neither constant" }
	}
	return ""
}

// The boolean OP_LAND / OP_LOR are not logic-immediate positions: emitBinop
// lowers them only through its register path.
func TestX64ImmFitsLandLorNotFolded() testing.TestResult {
	var t @types.Type = types.TypInt()
	if x64ImmBinopFolded(iropcode.OP_LAND, t, cast(int64, 1), false) {
		return "an OP_LAND constant must NOT fold"
	}
	if x64ImmBinopFolded(iropcode.OP_LOR, t, cast(int64, 1), false) {
		return "an OP_LOR constant must NOT fold"
	}
	return ""
}

// A constant used by both an AND and an ADD, each in range, folds.  A uint32
// 0x80000000 used by an AND (fits the SZ32 immediate) and an ADD (outside the
// sign-extended imm32) does not: every use must ride an immediate.
func TestX64ImmFitsLogicMixedUses() testing.TestResult {
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt(b, 0x70, types.TypInt())
	var x @ir.Instr = x64ImmParam(f, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_AND, x, c, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_ADD, x, c, types.TypInt())
	if !x64ImmFolded(f, c) { return "an AND + ADD constant in range must fold" }

	var g @ir.Func = x64ImmNewFunc()
	var gb @ir.Block = ir.AddBlock(g, "entry")
	var u @ir.Instr = irbuild.EmitConstInt64(gb, x64ImmMax + cast(int64, 1), types.TypUint32())
	var y @ir.Instr = x64ImmParam(g, types.TypUint32())
	_ = irbuild.EmitBinop(gb, iropcode.OP_AND, y, u, types.TypUint32())
	if !x64ImmFolded(g, u) { return "a uint32 AND with 0x80000000 alone must fold" }
	_ = irbuild.EmitBinop(gb, iropcode.OP_ADD, y, u, types.TypUint32())
	if x64ImmFolded(g, u) { return "a 0x80000000 that an ADD also uses must NOT fold" }
	return ""
}

// ---- AND / OR / XOR immediate fold: the emitter ----
//
// Each golden is the full emitBinop output for a spilled register operand: the
// reload (`mov r10, qword ptr [rsp]`), the copy into the result register
// (`mov r11, r10`, or its 32-bit form), the immediate op, and the sub-word
// re-narrow when the register path would emit one.  The expected bytes are
// clang's (x86_64) encodings of that assembly.  None contains a register-form
// AND / OR / XOR (21 / 09 / 31) or a materialized constant.

// An int64 AND with a small constant rides the imm8 form (`and r11, 0xf`).
func TestX64LogicImmFoldAndImm8Golden() testing.TestResult {
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_AND, 1, 2, cast(int64, 0x0F), 1,
			types.TypInt64())
	return x64FoldGolden(a, "4c 8b 14 24 4d 89 d3 49 83 e3 0f", "x & 0xf")
}

// An int64 XOR with -1 is a complement: `not r11`, no immediate.
func TestX64LogicImmFoldXorAllOnesGolden() testing.TestResult {
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_XOR, 1, 2, cast(int64, 0) - cast(int64, 1), 1,
			types.TypInt64())
	return x64FoldGolden(a, "4c 8b 14 24 4d 89 d3 49 f7 d3", "x ^ -1")
}

// A uint32 XOR with 0xFFFFFFFF is all-ones at SZ32, so it too becomes a
// complement, in the 32-bit form (`not r11d`) with no re-narrow.
func TestX64LogicImmFoldXorAllOnesUint32Golden() testing.TestResult {
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_XOR, 1, 2, cast(int64, 0xFFFFFFFF), 1,
			types.TypUint32())
	return x64FoldGolden(a, "4c 8b 14 24 45 89 d3 41 f7 d3", "x ^ 0xffffffff (uint32)")
}

// x64LogicImmNot builds `x op v` over type t and returns x64LogicImm's
// (notForm, ok) for the constant operand.
func x64LogicImmNot(op int, t @types.Type, v int64) (bool, bool) {
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt64(b, v, t)
	var x @ir.Instr = x64ImmParam(f, t)
	var ins @ir.Instr = irbuild.EmitBinop(b, op, x, c, t)
	var notForm bool
	var ok bool
	_, _, notForm, ok = x64LogicImm(ins, 1)
	return notForm, ok
}

// notForm marks exactly an XOR with all-ones at the op width: -1 at SZ64
// (int64, and int32, which runs at SZ64), 0xFFFFFFFF at SZ32 (uint32).  An AND /
// OR with all-ones and an XOR with a different value keep the immediate form.
func TestX64LogicImmNotFormOnlyXorAllOnes() testing.TestResult {
	var negOne int64 = cast(int64, 0) - cast(int64, 1)
	var notForm bool
	var ok bool
	notForm, ok = x64LogicImmNot(iropcode.OP_XOR, types.TypInt64(), negOne)
	if !ok || !notForm { return "int64 x ^ -1 must take the not form" }
	notForm, ok = x64LogicImmNot(iropcode.OP_XOR, types.TypInt32(), negOne)
	if !ok || !notForm { return "int32 x ^ -1 (SZ64) must take the not form" }
	notForm, ok = x64LogicImmNot(iropcode.OP_XOR, types.TypUint32(), cast(int64, 0xFFFFFFFF))
	if !ok || !notForm { return "uint32 x ^ 0xffffffff (SZ32) must take the not form" }
	notForm, ok = x64LogicImmNot(iropcode.OP_AND, types.TypInt64(), negOne)
	if !ok || notForm { return "x & -1 must keep the immediate form" }
	notForm, ok = x64LogicImmNot(iropcode.OP_OR, types.TypUint32(), cast(int64, 0xFFFFFFFF))
	if !ok || notForm { return "uint32 x | 0xffffffff must keep the immediate form" }
	notForm, ok = x64LogicImmNot(iropcode.OP_XOR, types.TypInt64(), cast(int64, 0x7FFFFFFF))
	if !ok || notForm { return "x ^ 0x7fffffff must keep the immediate form" }
	return ""
}

// An int64 XOR with a wide in-range constant rides the imm32 form.
func TestX64LogicImmFoldXorImm32Golden() testing.TestResult {
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_XOR, 1, 2, cast(int64, 0x12345678), 1,
			types.TypInt64())
	return x64FoldGolden(a, "4c 8b 14 24 4d 89 d3 49 81 f3 78 56 34 12", "x ^ 0x12345678")
}

// A uint32 OR with the constant on the LHS runs at SZ32 (`mov r11d, r10d`;
// `or r11d, 0xfffffff0`, whose 32-bit value -16 takes the imm8 form), with no
// re-narrow: the 32-bit op self-clears the top half.
func TestX64LogicImmFoldOrUint32LhsGolden() testing.TestResult {
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_OR, 1, 2, cast(int64, 0xFFFFFFF0), 0,
			types.TypUint32())
	return x64FoldGolden(a, "4c 8b 14 24 45 89 d3 41 83 cb f0", "0xfffffff0 | x (uint32)")
}

// A uint32 AND with 0x80000000 — beyond a 64-bit op's sign-extended imm32 —
// rides the SZ32 imm32 form (`and r11d, 0x80000000`).
func TestX64LogicImmFoldAndUint32HighBitGolden() testing.TestResult {
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_AND, 1, 2, x64ImmMax + cast(int64, 1), 1,
			types.TypUint32())
	return x64FoldGolden(a, "4c 8b 14 24 45 89 d3 41 81 e3 00 00 00 80", "x & 0x80000000 (uint32)")
}

// Sub-word results run at SZ64 and are re-narrowed exactly as the register path
// does: int8 sign-extends (`movsx r11, r11b`), uint16 zero-extends
// (`movzx r11, r11w`), int32 sign-extends (`movsxd r11, r11d`), uint8
// zero-extends (`movzx r11, r11b`).
func TestX64LogicImmFoldSubWordNarrowGolden() testing.TestResult {
	var r testing.TestResult
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_AND, 1, 2, cast(int64, 0x7F), 1,
			types.TypInt8())
	r = x64FoldGolden(a, "4c 8b 14 24 4d 89 d3 49 83 e3 7f 4d 0f be db", "x & 0x7f (int8)")
	if len(r) != 0 { return r }
	a = x64FoldImmBinop(iropcode.OP_OR, 1, 2, cast(int64, 0x8000), 1, types.TypUint16())
	r = x64FoldGolden(a, "4c 8b 14 24 4d 89 d3 49 81 cb 00 80 00 00 4d 0f b7 db",
			"x | 0x8000 (uint16)")
	if len(r) != 0 { return r }
	a = x64FoldImmBinop(iropcode.OP_AND, 1, 2, cast(int64, 0) - cast(int64, 256), 1, types.TypInt32())
	r = x64FoldGolden(a, "4c 8b 14 24 4d 89 d3 49 81 e3 00 ff ff ff 4d 63 db", "x & -256 (int32)")
	if len(r) != 0 { return r }
	a = x64FoldImmBinop(iropcode.OP_XOR, 1, 2, cast(int64, 0xFF), 1, types.TypUint8())
	return x64FoldGolden(a, "4c 8b 14 24 4d 89 d3 49 81 f3 ff 00 00 00 4d 0f b6 db",
			"x ^ 0xff (uint8)")
}

// A folded constant a 64-bit AND / OR / XOR cannot carry (outside the
// sign-extended imm32) records an error and emits nothing: the constant was
// never materialized, so there is no correct encoding to fall back to.
func TestX64LogicImmFoldMisfitErrors() testing.TestResult {
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_AND, 1, 2, x64Low32Mask, 1, types.TypInt64())
	if !a.HasError { return "a folded int64 AND with 0xFFFFFFFF must record an error" }
	if a.Sections[0].Len != 0 { return "a misfit folded AND constant must emit nothing" }
	a = x64FoldImmBinop(iropcode.OP_OR, 1, 2, x64ImmMax + cast(int64, 1), 0, types.TypInt64())
	if !a.HasError { return "a folded int64 OR with 2^31 must record an error" }
	if a.Sections[0].Len != 0 { return "a misfit folded OR constant must emit nothing" }
	a = x64FoldImmBinop(iropcode.OP_XOR, 1, 2, x64ImmMin - cast(int64, 1), 1, types.TypUint64())
	if !a.HasError { return "a folded uint64 XOR with -2^31-1 must record an error" }
	if a.Sections[0].Len != 0 { return "a misfit folded XOR constant must emit nothing" }
	return ""
}

// A logic op whose operands are both folded constants has no register operand:
// it records an error and emits nothing rather than reading either constant as
// a register.
func TestX64LogicImmFoldBothFoldedErrors() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	var fc @[]bool = make_slice(bool, 4)
	fc[1] = true
	fc[2] = true
	m.FoldedImm = fc
	var c @ir.Instr = make(ir.Instr)
	c.ID = 1
	c.Op = iropcode.OP_CONST_INT
	c.Typ = types.TypInt64()
	c.IntVal = 3
	var d @ir.Instr = make(ir.Instr)
	d.ID = 2
	d.Op = iropcode.OP_CONST_INT
	d.Typ = types.TypInt64()
	d.IntVal = 4
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_XOR
	ins.Typ = types.TypInt64()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = c
	ins.Args[1] = d
	_ = emitBinop(a, m, ins)
	if !a.HasError { return "a logic op with both operands folded must record an error" }
	if a.Sections[0].Len != 0 { return "a logic op with both operands folded must emit nothing" }
	return ""
}

// An AND / OR / XOR whose folded constant fits but whose register operand lives
// nowhere (not homed, cached, or spilled) records the missing-register error and
// emits nothing: getOperand yields no register, and the emitter must not encode
// the immediate op against one.  The constant is tried on either side.
func TestX64LogicImmFoldNoRegisterErrors() testing.TestResult {
	var ops @[]int = make_slice(int, 3)
	ops[0] = iropcode.OP_AND
	ops[1] = iropcode.OP_OR
	ops[2] = iropcode.OP_XOR
	for i := 0; i < len(ops); i++ {
		for argIdx := 0; argIdx < 2; argIdx++ {
			var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
			var a @asm.Assembler = x64FoldImmBinopIn(m, ops[i], 1, 2, cast(int64, 0x0F), argIdx,
					types.TypInt64())
			if !a.HasError { return "a logic op with no register operand must record an error" }
			if !x64FoldSameText(a.ErrorMsg,
					"native amd64: and/or/xor with a folded immediate has no register operand") {
				return buf.Concat("a logic op with no register operand recorded: ", a.ErrorMsg)
			}
			if a.Sections[0].Len != 0 {
				return "a logic op with no register operand must emit nothing"
			}
		}
	}
	return ""
}

// End to end through emitFunc: a constant used as both an AND operand and an ADD
// operand rides `and r, imm32` and `add r, imm32` and is never materialized (its
// imm32 appears exactly twice, once per consuming instruction).
func TestX64EmitFuncFoldsLogicAndAddImmConst() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = opsMkAssembler()
	var noP @[]@ir.Param
	var res @[]@types.Type = make_slice(@types.Type, 1)
	res[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "main.f", noP, res)
	var p @ir.Param = irbuild.NewParam(f, "x", types.TypInt())
	var ps @[]@ir.Param = make_slice(@ir.Param, 1)
	ps[0] = p
	f.Params = ps
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = irbuild.NewParamRef(f, p)
	var imm int = 0x5A5A5A5A
	var c @ir.Instr = irbuild.EmitConstInt(entry, imm, types.TypInt())
	var m @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_AND, x, c, types.TypInt())
	var s @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, m, c, types.TypInt())
	var rs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rs[0] = s
	irbuild.EmitReturn(entry, rs)
	emitFunc(a, "main", f, nilStrings())
	if a.HasError { return "emitFunc must lower the folded constant without error" }
	if !x64FoldHasAluImm32(a, 4, imm) { return "the AND must ride `and r, imm32` (81 /4)" }
	if !x64FoldHasAluImm32(a, 0, imm) { return "the ADD must ride `add r, imm32` (81 /0)" }
	if x64FoldCountImm32(a, imm) != 2 {
		return "the folded constant must appear only in its two consuming immediates"
	}
	return ""
}
