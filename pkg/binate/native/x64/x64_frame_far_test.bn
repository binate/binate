package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Frame accesses past a direct displacement (x64_frame_far.bn).  Most tests lower
// farDispLimit to 64 (as bnc -fx64-far-disp=64 does), so small offsets take the far
// paths, and restore the default before returning.  The golden encodings are clang's
// for the same instructions.

// farTextAsm returns an assembler with its text section current.
func farTextAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func TestFrameNearX64() testing.TestResult {
	setFarDispLimit(0)
	if !frameNear(x64.RSP, 0x7FFFFFF8, 8) { return fail("[rsp + 0x7FFFFFF8], 8 bytes, is near") }
	if frameNear(x64.RSP, 0x7FFFFFF9, 8) { return fail("[rsp + 0x7FFFFFF9], 8 bytes, is far") }
	if !frameNear(x64.RBP, -0x80000000, 8) { return fail("[rbp - 2^31] is near") }
	if frameNear(x64.RBP, -0x80000001, 1) { return fail("[rbp - 2^31 - 1] is far") }
	if !frameNear(x64.RAX, 0x100000000, 8) {
		return fail("a non-frame base is the assembler's to check")
	}
	setFarDispLimit(64)
	defer { setFarDispLimit(0) }
	if !frameNear(x64.RSP, 56, 8) { return fail("[rsp + 56], 8 bytes, is near under a limit of 64") }
	if frameNear(x64.RSP, 58, 8) { return fail("[rsp + 58], 8 bytes, ends past a limit of 64") }
	if frameNear(x64.RSP, -66, 1) { return fail("[rsp - 66] is past a limit of 64") }
	return ""
}

func TestFarScratchOrderX64() testing.TestResult {
	if farScratch(0) != x64.R11 { return fail("R11 is the first far scratch") }
	var avoid int = regBit(x64.R11)
	if farScratch(avoid) != x64.R10 { return fail("R10 is next") }
	avoid = avoid | regBit(x64.R10)
	if farScratch(avoid) != x64.RAX { return fail("then RAX") }
	avoid = avoid | regBit(x64.RAX)
	if farScratch(avoid) != x64.RCX { return fail("then RCX") }
	if regBit(x64.XMM0 + 8) != 0 { return fail("an XMM register has no avoid bit") }
	return ""
}

func TestFrameLeaX64() testing.TestResult {
	setFarDispLimit(0)
	var a @asm.Assembler = farTextAsm()
	frameLea(a, x64.RAX, x64.RSP, 0x10)
	var r testing.TestResult = x64FoldGolden(a, "48 8d 44 24 10", "near: lea rax, [rsp + 0x10]")
	if len(r) > 0 { return r }
	a = farTextAsm()
	frameLea(a, x64.RCX, x64.RSP, 0x80000000)
	r = x64FoldGolden(a, "48 b9 00 00 00 80 00 00 00 00 48 8d 0c 0c",
			"past disp32: movabs rcx, 0x80000000; lea rcx, [rsp + rcx]")
	if len(r) > 0 { return r }
	setFarDispLimit(64)
	defer { setFarDispLimit(0) }
	a = farTextAsm()
	frameLea(a, x64.RAX, x64.RSP, 0x100)
	r = x64FoldGolden(a, "48 c7 c0 00 01 00 00 48 8d 04 04",
			"far: mov rax, 0x100; lea rax, [rsp + rax]")
	if len(r) > 0 { return r }
	// RBP as a base takes a displacement byte even when it is zero.
	a = farTextAsm()
	frameLea(a, x64.RAX, x64.RBP, -0x100)
	return x64FoldGolden(a, "48 c7 c0 00 ff ff ff 48 8d 44 05 00",
			"far below RBP: mov rax, -0x100; lea rax, [rbp + rax + 0]")
}

func TestFrameLoadFarX64() testing.TestResult {
	setFarDispLimit(64)
	defer { setFarDispLimit(0) }
	var a @asm.Assembler = farTextAsm()
	emitFrameLoad(a, x64.R10, x64.RSP, 0x100, 8, false)
	var r testing.TestResult = x64FoldGolden(a, "49 c7 c2 00 01 00 00 4e 8d 14 14 4d 8b 12",
			"a load computes the address into its destination")
	if len(r) > 0 { return r }
	a = farTextAsm()
	emitFrameLoad(a, x64.RAX, x64.RSP, 0x100, 4, true)
	r = x64FoldGolden(a, "48 c7 c0 00 01 00 00 48 8d 04 04 48 63 00", "a signed 4-byte load: movsxd")
	if len(r) > 0 { return r }
	// An XMM destination cannot hold an address: a saved scratch does.
	a = farTextAsm()
	emitFrameLoad(a, x64.XMM0 + 8, x64.RSP, 0x100, 8, false)
	return x64FoldGolden(a,
			"4c 89 5c 24 80 49 c7 c3 00 01 00 00 4e 8d 1c 1c 45 0f 12 03 4c 8b 5c 24 80",
			"an XMM load goes through R11, saved in the red zone")
}

func TestFrameStoreX64() testing.TestResult {
	setFarDispLimit(64)
	defer { setFarDispLimit(0) }
	var a @asm.Assembler = farTextAsm()
	emitFrameStore(a, x64.RAX, x64.RSP, 0x10, 8)
	var r testing.TestResult = x64FoldGolden(a, "48 89 44 24 10", "near: mov [rsp + 0x10], rax")
	if len(r) > 0 { return r }
	// Storing R11, the store borrows R10.
	a = farTextAsm()
	emitFrameStore(a, x64.R11, x64.RSP, 0x100, 8)
	r = x64FoldGolden(a, "4c 89 54 24 80 49 c7 c2 00 01 00 00 4e 8d 14 14 4d 89 1a 4c 8b 54 24 80",
			"far: R10 saved, loaded with the address, restored")
	if len(r) > 0 { return r }
	a = farTextAsm()
	emitFrameStoreImm(a, 0, x64.RSP, 0x100)
	return x64FoldGolden(a,
			"4c 89 5c 24 80 49 c7 c3 00 01 00 00 4e 8d 1c 1c 49 c7 03 00 00 00 00 4c 8b 5c 24 80",
			"far immediate store through a saved R11")
}

// Two far sides of a copy loop take two scratch registers and both red-zone save
// slots; the loop indexes each off its own register, and they are restored in reverse.
func TestFrameCopyLoopFarX64() testing.TestResult {
	setFarDispLimit(64)
	defer { setFarDispLimit(0) }
	var a @asm.Assembler = farTextAsm()
	emitFrameCopyLoopX64(a, x64.RSP, 0x100, x64.RSP, 0x200, 64, x64.RCX)
	if a.HasError { return fail("unexpected assembler error") }
	var got @[]char = x64FoldTextHex(a)
	var head *[]readonly char = "4c 89 5c 24 80 49 c7 c3 00 01 00 00 4e 8d 1c 1c "
			"4c 89 54 24 88 49 c7 c2 00 02 00 00 4e 8d 14 14"
	var tail *[]readonly char = "4c 8b 54 24 88 4c 8b 5c 24 80"
	if len(got) < len(head) + len(tail) || !x64FoldSameText(got[:len(head)], head) {
		return fail("the destination is addressed through R11 (slot 0), the source through R10 (slot 1)")
	}
	if !x64FoldSameText(got[len(got) - len(tail):], tail) {
		return fail("R10 then R11 are restored after the loop")
	}
	return ""
}

func TestFrameZeroFarX64() testing.TestResult {
	setFarDispLimit(64)
	defer { setFarDispLimit(0) }
	var a @asm.Assembler = farTextAsm()
	emitFrameZeroX64(a, common.NewRegMap(callconv.SysV_AMD64()), 0x100, 16)
	// A pool register (R10, the first) takes the region's address; the zero words are
	// stored off it.
	return x64FoldGolden(a,
			"49 c7 c2 00 01 00 00 4e 8d 14 14 49 c7 02 00 00 00 00 49 c7 42 08 00 00 00 00",
			"far zero-fill through a pool register")
}

func TestEmitPrologueFarX64() testing.TestResult {
	setFarDispLimit(0)
	var a @asm.Assembler = farTextAsm()
	emitPrologue(a, 0x7FFFFFF0)
	var r testing.TestResult = x64FoldGolden(a, "55 48 89 e5 48 81 ec f0 ff ff 7f", "sub rsp, imm32")
	if len(r) > 0 { return r }
	a = farTextAsm()
	emitPrologue(a, 0x80000000)
	return x64FoldGolden(a, "55 48 89 e5 49 bb 00 00 00 80 00 00 00 00 4c 29 dc",
			"a frame past imm32 is subtracted through R11")
}

// An incoming stack argument past the limit is read through its destination, off RBP.
func TestSpillStackArgFarX64() testing.TestResult {
	setFarDispLimit(64)
	defer { setFarDispLimit(0) }
	var a @asm.Assembler = farTextAsm()
	spillScalarStackArgX64(a, x64.RAX, x64.RBP, 0x100, callconv.SysV_AMD64(), types.TypInt64())
	return x64FoldGolden(a, "48 c7 c0 00 01 00 00 48 8d 44 05 00 48 8b 00",
			"mov rax, 0x100; lea rax, [rbp + rax + 0]; mov rax, [rax]")
}

// An aggregate load's 2- and 1-byte tail pieces go through rd before rd takes the
// region's address, so a far region is reached through a saved R11 for them alone;
// with no such piece no scratch is saved.
func TestAggLoadCopyFarX64() testing.TestResult {
	setFarDispLimit(64)
	defer { setFarDispLimit(0) }
	var a @asm.Assembler = farTextAsm()
	emitAggLoadCopyX64(a, x64.RCX, 0x100, x64.RDX, 0, 10)
	var r testing.TestResult = x64FoldGolden(a,
			"4c 89 5c 24 80 49 c7 c3 00 01 00 00 4e 8d 1c 1c 66 8b 4a 08 66 41 89 4b 08 4c 8b 5c 24 80 "
					"48 c7 c1 00 01 00 00 48 8d 0c 0c 44 0f 12 32 44 0f 13 31",
			"a 2-byte tail piece through a saved R11")
	if len(r) > 0 { return r }
	a = farTextAsm()
	emitAggLoadCopyX64(a, x64.RCX, 0x100, x64.RDX, 0, 12)
	return x64FoldGolden(a,
			"48 c7 c1 00 01 00 00 48 8d 0c 0c 44 0f 12 32 44 0f 13 31 f3 44 0f 10 72 08 f3 44 0f 11 71 08",
			"a 4-byte tail piece saves no scratch")
}

// A far zero-fill loop holds the region's address in one pool register (R10) and
// indexes it with another (R11).
func TestFrameZeroLoopFarX64() testing.TestResult {
	setFarDispLimit(64)
	defer { setFarDispLimit(0) }
	var a @asm.Assembler = farTextAsm()
	emitFrameZeroX64(a, common.NewRegMap(callconv.SysV_AMD64()), 0x100, 256)
	return x64FoldGolden(a,
			"49 c7 c2 00 01 00 00 4e 8d 14 14 45 0f 57 f6 49 c7 c3 e0 00 00 00 "
					"47 0f 11 34 1a 47 0f 11 74 1a 10 49 83 eb 20 79 ef",
			"a far zero-fill loop")
}

// An SSE aggregate parameter's far region is reached through R11, which is no
// argument register: RDI still holds the INTEGER eightbyte when it is stored.
func TestSpillSseParamFarX64() testing.TestResult {
	setFarDispLimit(64)
	defer { setFarDispLimit(0) }
	var a @asm.Assembler = farTextAsm()
	var t @types.Type = struct2t("ID", types.TypInt64(), types.TypFloat64())
	_ = spillSseAggregateParam(a, sseArgMap(), t, 0, 0, 0x100)
	return x64FoldGolden(a,
			"4c 89 5c 24 80 49 c7 c3 00 01 00 00 4e 8d 1c 1c 49 89 3b 41 0f 13 43 08 4c 8b 5c 24 80",
			"an SSE aggregate parameter stored far")
}

// A far SSE aggregate return collect avoids RAX and RDX (the return registers) and
// R11 (the collect's scratch), so R10 reaches the region.
func TestCollectSseReturnFarX64() testing.TestResult {
	setFarDispLimit(64)
	defer { setFarDispLimit(0) }
	var a @asm.Assembler = farTextAsm()
	var ins @ir.Instr = make(ir.Instr)
	ins.Typ = struct2t("ID", types.TypInt64(), types.TypFloat64())
	collectSseAggregateReturn(a, sseArgMap(), ins, 0x100)
	return x64FoldGolden(a,
			"4c 89 54 24 80 49 c7 c2 00 01 00 00 4e 8d 14 14 49 89 02 41 0f 13 42 08 4c 8b 54 24 80",
			"an SSE aggregate return collected far, through R10")
}

// A far multi-return collect avoids RAX, RDX and RCX (the return registers) and the
// collect's own scratch (R10, the first pool register), so R11 reaches the slot.
func TestCollectTupleFarX64() testing.TestResult {
	setFarDispLimit(64)
	defer { setFarDispLimit(0) }
	var a @asm.Assembler = farTextAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 7)
	m.SpillOffsets = common.AppendInt64(m.SpillOffsets, 0x100)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Typ = x64TupleOf(@[]@types.Type{types.TypInt64(), types.TypInt64(), types.TypInt64()})
	collectMultiReturnTuple(a, m, ins)
	return x64FoldGolden(a,
			"4c 89 5c 24 80 49 c7 c3 00 01 00 00 4e 8d 1c 1c 49 89 03 49 89 53 08 49 89 4b 10 "
					"4c 8b 5c 24 80",
			"a multi-return tuple collected far, through R11")
}

// The multi-return tuple image stays above the far-frame save slots at RSP - 128 and
// RSP - 120: a tuple whose image would reach them is an error, not an overlap.
func TestMultiReturnImageClearOfFarSlotsX64() testing.TestResult {
	var a @asm.Assembler = farTextAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	var fts @[]@types.Type = make_slice(@types.Type, 15)
	for i := 0; i < len(fts); i++ { fts[i] = types.TypInt64() }
	m.MultiReturnType = x64TupleOf(fts)
	var ins @ir.Instr = make(ir.Instr)
	emitMultiReturnPack(a, "main", m, ins)
	if !a.HasError { return fail("a 120-byte tuple image must be an error") }
	return ""
}

// A frame region past 4 GiB is zeroed by the loop, its size in int64 (on a 32-bit host
// too): R10 takes the region's address, R11 the loop index from size - 32 down.
func TestFrameZeroPast4GiBX64() testing.TestResult {
	setFarDispLimit(0)
	var a @asm.Assembler = farTextAsm()
	emitFrameZeroX64(a, common.NewRegMap(callconv.SysV_AMD64()), 0x10, 0x100000000)
	return x64FoldGolden(a,
			"49 c7 c2 10 00 00 00 4e 8d 14 14 45 0f 57 f6 49 bb e0 ff ff ff 00 00 00 00 "
					"47 0f 11 34 1a 47 0f 11 74 1a 10 49 83 eb 20 79 ef",
			"a zero-fill past 4 GiB")
}
