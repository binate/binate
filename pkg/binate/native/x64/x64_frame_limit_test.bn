package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A function whose frame passes the target's address space (common.CheckFrameFits)
// is a compile error naming it, not a wrapped frame: emitFunc reports it and emits
// no body.

// bigLocalsFuncX64 builds `func name()` with one byte-array local of each size.
func bigLocalsFuncX64(name *[]readonly char, sizes @[]int64) @ir.Func {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", buf.CopyStr(name), noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	for i := 0; i < len(sizes); i++ {
		irbuild.EmitAlloc(b, types.MakeArrayType(types.TypUint8(), sizes[i]))
	}
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(b, noArgs)
	return f
}

// errNamesX64 reports whether msg holds name.
func errNamesX64(msg *[]readonly char, name *[]readonly char) bool {
	for i := 0; i + len(name) <= len(msg); i++ {
		var k int = 0
		for k < len(name) && msg[i + k] == name[k] { k = k + 1 }
		if k == len(name) { return true }
	}
	return false
}

func TestEmitFuncFrameTooLargeX64() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var strs @[]ir.StringConst
	emitFunc(a, "main", bigLocalsFuncX64("main.big", @[]int64{0x7000000000000000, 0x7000000000000000}),
			strs, Options{})
	if !a.HasError || !errNamesX64(a.ErrorMsg, "main.big") {
		return fail("a frame past the address space should be an error naming the function")
	}
	return ""
}

// A frame past 2 GiB that fits the address space compiles: the prologue subtracts it
// through R11 (`sub rsp, r11`), and the slots past disp32 are addressed through a
// register (x64_frame_far.bn).
func TestEmitFuncFramePast2GiBX64() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var strs @[]ir.StringConst
	emitFunc(a, "main", bigLocalsFuncX64("main.huge", @[]int64{0x7FFFFFF8, 0x7FFFFFF8, 64}), strs,
			Options{})
	if a.HasError { return buf.Concat("a frame past 2 GiB must compile: ", a.ErrorMsg) }
	if !errNamesX64(x64FoldTextHex(a), "4c 29 dc") {
		return fail("the prologue should subtract the frame through R11")
	}
	return ""
}
