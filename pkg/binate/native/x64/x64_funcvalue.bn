package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/types"

// Function-value module-level reference collection and per-function
// symbol naming for amd64 — port of arm64's collection / naming
// helpers.  Each OP_FUNC_VALUE / OP_FUNC_HANDLE reference in the module
// gets a per-function triplet:
//   _bn_<pkg>__<fn>__shim   ; text: per-shape tail-call wrapper.
//   _bn_<pkg>__<fn>__vt     ; data: 16-byte {dtor=0, call=shim}.
//   ___handle.bn_<pkg>__<fn>; data: 16-byte {vtable=__vt, data=0}.
// The per-shape shim BODY emission lives in x64_funcvalue_shim.bn; the
// prefix is object-format-driven via symPrefixed so Mach-O gets a
// leading '_' and ELF stays bare.

// collectFuncValueRefs walks mod for OP_FUNC_VALUE / OP_FUNC_HANDLE
// references and returns unique (name, fvTyp) pairs.  Cross-module
// references — those whose qualified function name doesn't resolve
// in mod.Funcs — are excluded: the defining module's triplet is
// already in its .o, and the linker resolves the reference cross-TU.
func collectFuncValueRefs(mod @ir.Module) (@[]@[]char, @[]@types.Type) {
	var seen @[]@[]char
	var sigs @[]@types.Type
	// Pre-pass: emit triplets for every IsLinkOnce function defined
	// in this TU (dtors + copy helpers from gen_dtor_emit /
	// gen_copy_emit, marked IsLinkOnce=true).  Without this, only
	// packages that internally reference their own dtor as an
	// OP_FUNC_HANDLE would emit the __vt/__handle/__shim triplet —
	// every consumer would then have to emit its own copy to
	// dispatch through the handle, which silently collides on
	// Mach-O strict-symbol semantics.  Mirrors aarch64.bn's
	// collectFuncValueRefs pre-pass.  The matching consumer-side
	// skip lives in lookupFuncValueType_x64's IsExtern gate below.
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		if !f.IsLinkOnce { continue }
		var params @[]@types.Param
		for j := 0; j < len(f.Params); j++ {
			var p @types.Param = make(types.Param)
			p.Name = f.Params[j].Name
			p.Type = f.Params[j].Typ
			params = appendTypeParam(params, p)
		}
		var fvTyp @types.Type =
			types.MakeFuncValueType(params, f.Results)
		seen = appendCharSlice(seen, f.Name)
		sigs = appendTypePtr(sigs, fvTyp)
	}
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		for j := 0; j < len(f.Blocks); j++ {
			var blk @ir.Block = f.Blocks[j]
			for k := 0; k < len(blk.Instrs); k++ {
				var ins @ir.Instr = blk.Instrs[k]
				if ins.Op != ir.OP_FUNC_VALUE &&
						ins.Op != ir.OP_FUNC_HANDLE {
					continue
				}
				var dup bool = false
				for s := 0; s < len(seen); s++ {
					if charEqFV(seen[s], ins.StrVal) {
						dup = true
						break
					}
				}
				if dup { continue }
				var sigTyp @types.Type = ins.Typ
				if ins.Op == ir.OP_FUNC_HANDLE {
					sigTyp = lookupFuncValueType_x64(mod, ins.StrVal)
					if sigTyp == nil { continue }
				}
				seen = appendCharSlice(seen, ins.StrVal)
				sigs = appendTypePtr(sigs, sigTyp)
			}
		}
	}
	// Force-emit: add every .bni-exported, non-extern function so its
	// triple is emitted even when nothing references it as a function
	// value — B0 of plan-package-introspection-phase-b.md: the per-package
	// Functions table's Value field symrefs @__handle.<exported fn>, which
	// must be a defined symbol.  Mirrors codegen's addExportedFuncsToSeen.
	// Dedups by f.Name (the form OP_FUNC_HANDLE stores); a func with no
	// synthesizable func-value type is skipped.
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		if !f.Exported { continue }
		var dup bool = false
		for s := 0; s < len(seen); s++ {
			if charEqFV(seen[s], f.Name) {
				dup = true
				break
			}
		}
		if dup { continue }
		var sigTyp @types.Type = lookupFuncValueType_x64(mod, f.Name)
		if sigTyp == nil { continue }
		seen = appendCharSlice(seen, f.Name)
		sigs = appendTypePtr(sigs, sigTyp)
	}
	return seen, sigs
}

// lookupFuncValueType_x64 finds a function in the module by qualified
// name and synthesizes a TYP_FUNC_VALUE from its signature.  Mirrors
// arm64's lookupFuncValueTypeAA64: extern entries ARE matched, so an
// OP_FUNC_HANDLE referencing a cross-package managed-type dtor — notably
// one declared in an INTERFACE-ONLY package (reflect.FunctionInfo), whose
// dtor no .bn module emits — gets its WEAK (shim, vt, handle) triple here.
// The weak symbols (N_WEAK_DEF) dedup with any defining-TU copy at link
// time, matching the LLVM consumer-side EmitFuncHandle path; the shim
// tail-jumps to the (extern) target.
func lookupFuncValueType_x64(mod @ir.Module, qname @[]char) @types.Type {
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if !charEqFV(f.Name, qname) { continue }
		var params @[]@types.Param
		for j := 0; j < len(f.Params); j++ {
			var p @types.Param = make(types.Param)
			p.Name = f.Params[j].Name
			p.Type = f.Params[j].Typ
			params = appendTypeParam(params, p)
		}
		return types.MakeFuncValueType(params, f.Results)
	}
	return nil
}

// shimSymFor_x64 returns the object-format-prefixed label for a
// function's per-function shim global: "<pfx>bn_<pkg>__<name>__shim".
func shimSymFor_x64(pkgName *[]readonly char, fnName *[]readonly char) @[]char {
	var mangled @[]char = mangle.FuncName(pkgName, fnName).Bytes()
	return symPrefixed(appendStrFV(mangled, "__shim"))
}

// vtableSymFor_x64 returns the object-format-prefixed label for a
// function's vtable global: "<pfx>bn_<pkg>__<name>__vt".
func vtableSymFor_x64(pkgName *[]readonly char, fnName *[]readonly char) @[]char {
	var mangled @[]char = mangle.FuncName(pkgName, fnName).Bytes()
	return symPrefixed(appendStrFV(mangled, "__vt"))
}

// handleSymFor_x64 returns the object-format-prefixed label for the
// LLVM-shape handle global "<pfx>__handle.bn_<pkg>__<fn>".
// (Two leading underscores in the bare form: "__handle.bn_...".
// Under Mach-O symPrefixed adds another '_' → "___handle...".)
func handleSymFor_x64(pkgName *[]readonly char, fnName *[]readonly char) @[]char {
	var mangled @[]char = mangle.FuncName(pkgName, fnName).Bytes()
	var prefix @[]char = "__handle."
	return symPrefixed(appendStrSlice(prefix, mangled))
}

// emitQuadLabelFV writes an 8-byte placeholder for a pointer-sized
// slot + a fixup the linker rewrites to the symbol's absolute
// address.  Mirrors `.quad <label>` in a hand-written stub.
func emitQuadLabelFV(a @asm.Assembler, label *[]readonly char) {
	a.AddFixup(label, 0, 0, 8)
	a.Fill(8, cast(uint8, 0))
}

// charEqFV is a local byte-compare for char slices.
func charEqFV(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// appendStrFV appends src bytes to a @[]char prefix returning a
// fresh slice.  Local copy to keep this file self-contained.
func appendStrFV(dst @[]char, src *[]readonly char) @[]char {
	var n int = len(dst)
	var ns @[]char = make_slice(char, n + len(src))
	for i := 0; i < n; i++ { ns[i] = dst[i] }
	for i := 0; i < len(src); i++ { ns[n + i] = src[i] }
	return ns
}

// appendStrSlice appends bytes from a @[]char b to a @[]char a.
func appendStrSlice(a @[]char, b @[]char) @[]char {
	var n int = len(a)
	var ns @[]char = make_slice(char, n + len(b))
	for i := 0; i < n; i++ { ns[i] = a[i] }
	for i := 0; i < len(b); i++ { ns[n + i] = b[i] }
	return ns
}

// appendCharSlice appends a @[]char to a @[]@[]char.
func appendCharSlice(dst @[]@[]char, v @[]char) @[]@[]char {
	var n int = len(dst)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = dst[i] }
	ns[n] = v
	return ns
}

// appendTypePtr appends a @types.Type to a @[]@types.Type.
func appendTypePtr(dst @[]@types.Type, v @types.Type) @[]@types.Type {
	var n int = len(dst)
	var ns @[]@types.Type = make_slice(@types.Type, n + 1)
	for i := 0; i < n; i++ { ns[i] = dst[i] }
	ns[n] = v
	return ns
}

// appendTypeParam appends a @types.Param to a @[]@types.Param.
func appendTypeParam(dst @[]@types.Param, v @types.Param) @[]@types.Param {
	var n int = len(dst)
	var ns @[]@types.Param = make_slice(@types.Param, n + 1)
	for i := 0; i < n; i++ { ns[i] = dst[i] }
	ns[n] = v
	return ns
}
