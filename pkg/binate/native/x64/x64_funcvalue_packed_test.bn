package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for x64_funcvalue_packed.bn: the per-function packed-dispatch shim
// (__shimP) the func-value vtable's slot-2 call_packed target points at.  It
// gathers the VM caller's packed int-slot args into __shim's incoming SysV
// dispatch ABI and JMPs/CALLs __shim; register-only tail-JMPs, > budget frames a
// spill.

// packedShimForNInts_x64 emits __shimP for an IsLinkOnce func value with nParams
// int64 params (scalar return) and returns (byteLen, hadError).  Mirrors the
// spill tests' wideShimEmits_x64 module, but drives the packed emitter.
func packedShimForNInts_x64(nParams int) (int, bool) {
	var mod @ir.Module = ir.NewModule("\"main\"")
	var params @[]@ir.Param
	for i := 0; i < nParams; i++ {
		var p @ir.Param = make(ir.Param)
		p.Name = "x"
		p.Typ = types.TypInt64()
		params = appendIrParam_spilltest_x64(params, p)
	}
	var f @ir.Func = ir.NewFunc("", "pk", params, scalarResult_spilltest_x64())
	f.IsLinkOnce = true
	mod.AddFunc(f)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitFuncValuePackedShims_x64(a, "main", mod)
	return a.Sections[0].Len, a.HasError
}

// A func value gets a non-empty __shimP, emitted without error.
func TestPackedShimEmitted_x64() testing.TestResult {
	var n int
	var err bool
	n, err = packedShimForNInts_x64(2)
	if err {
		return "packed shim emission must not SetError"
	}
	if n == 0 {
		return "a func value must emit a non-empty __shimP"
	}
	return ""
}

// The > register-budget (spill) __shimP frames an outgoing-args area + CALLs,
// so it is strictly longer than the register-only tail-JMP __shimP.  7 int64
// user words exceed the SysV scalar-shape budget (5 = RSI..R9), so 5 stay
// register-only and 2 spill; the 2-param case is entirely register-only.  A
// dropped spill frame (or an arity cap) would
// collapse the two lengths.
func TestPackedShimSpillLongerThanRegisterOnly_x64() testing.TestResult {
	var regOnly int
	var spill int
	var e1 bool
	var e2 bool
	regOnly, e1 = packedShimForNInts_x64(2)
	spill, e2 = packedShimForNInts_x64(7)
	if e1 || e2 {
		return "packed shim emission must not SetError"
	}
	if spill <= regOnly {
		return "the >5-arg (spill) __shimP must be longer than the register-only one"
	}
	return ""
}
