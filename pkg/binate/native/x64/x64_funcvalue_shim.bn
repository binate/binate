package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Per-function func-value SHIM body emission for the amd64 backend —
// the text-section half of the func-value triple (the vtable / handle
// data half and the OP_FUNC_VALUE / OP_FUNC_HANDLE reference collection
// live in x64_funcvalue.bn).  Each non-closure reference gets one shim
// whose shape is selected by the function value's return type; a
// capturing-closure reference routes to emitClosureShim_x64
// (x64_closure_shim.bn) instead.
//
// The shim is entered under the uniform all-int dispatch ABI (the VM's
// rt._call_shim_scalar and the compiled emitCallFuncValue both place
// every arg WORD — float bits included — positionally in a GP register,
// after a leading data slot, or retbuf+data for the aggregate shapes).
// The shim re-marshals those words into the real SysV layout the
// underlying function expects, then tail-jumps (when every outgoing arg
// is in a register) or CALLs with a frame (when the underlying needs
// outgoing-args on the stack, or the return must be post-processed).

// shimReturnSize_x64 returns the byte size of a function value's
// single-result return type, or 0 for void / multi-return.
func shimReturnSize_x64(fvTyp @types.Type) int {
	if fvTyp == nil { return 0 }
	if len(fvTyp.Results) != 1 { return 0 }
	if fvTyp.Results[0] == nil { return 0 }
	return fvTyp.Results[0].SizeOf()
}

// shimReturnIsAggregate_x64 reports whether a function value's single result is
// an aggregate (struct/array).  The pack/sret shim shapes are for aggregate
// returns; a scalar result (≤ 8 bytes by nature) tail-jumps.  Size alone can't
// distinguish a ≤ 8-byte aggregate from a scalar, so the aggregate shim floor
// keys on this, not just shimReturnSize_x64.
func shimReturnIsAggregate_x64(fvTyp @types.Type) bool {
	if fvTyp == nil { return false }
	if len(fvTyp.Results) != 1 { return false }
	if fvTyp.Results[0] == nil { return false }
	return common.IsAggregateTyp(fvTyp.Results[0])
}

// shimReturnIsFloatScalar_x64 reports whether a func value's single result is
// a float scalar.  Such a return can't ride the scalar tail-jump: the
// underlying returns it in xmm0, but the all-int shim ABI hands the bits back
// in rax, so the shim must CALL and movq/movd xmm0 -> rax.
func shimReturnIsFloatScalar_x64(fvTyp @types.Type) bool {
	if fvTyp == nil { return false }
	if len(fvTyp.Results) != 1 { return false }
	return common.IsFloatScalarTyp(fvTyp.Results[0])
}

// emitShimArgMarshal_x64 marshals the func-value shim's incoming all-int,
// positional-GP user args into the SysV layout the underlying function
// expects, FOR THE REGISTER-ONLY CASE (every word in a GP/XMM register).  The
// shim is entered under the uniform all-int dispatch ABI (the VM's
// rt._call_shim_scalar and the compiled emitCallFuncValue both place every arg
// word — float bits included — in a GP register): incoming user-arg word w
// sits in argReg(srcPrefix + w), where `srcPrefix` is the count of leading GP
// words to skip (1 = data, for the scalar/void shape; 2 = retbuf + data, for
// the pack/sret shapes).
//
// Each float-scalar param is moved (movq/movd) from its GP slot into the XMM
// register the underlying reads (xmm[nsrn], an independent FP-register
// counter); every other param stays in GP at argReg(gpDestBase + ngrn).
// `gpDestBase` is the first GP arg register the underlying uses: 0 normally,
// but 1 for the sret shape (RDI holds the sret pointer, so explicit args
// start at RSI).  This is the native half of the float shim ABI (Design A);
// the LLVM shim does the same bitcast in IR.
//
// A coerced in-register struct/array (named ≤ 16 B) arrives as ONE by-address
// pointer word (EffectiveArgWords == 1); the shim copies that pointer to R10 (a
// scratch — not a SysV arg reg nor the return reg) and loads its ArgWords value-
// words from [R10 + 8k] into the consecutive outgoing GP regs the underlying's
// coerced ABI reads.  The incoming cursor (srcWord) advances by 1 word but the
// outgoing cursor (ngrn) by ArgWords — the two DIVERGE here (elsewhere they move
// in lockstep).  Slices / managed-slices / iface- / func-values / > 16 B byval
// aggregates are NOT coerced-in-reg and keep the generic register-shift path.
//
// Clobber-safety: for the register-shift path the GP destination index never
// exceeds the GP source index (gpDestBase + ngrn <= srcPrefix + srcWord), so
// left-to-right MOVs read each source before it is overwritten; the coerced path
// reads only through R10 (loads from memory, distinct from any arg reg), so it
// can't clobber a not-yet-consumed source either; the XMM moves target the
// disjoint FP register file and never clobber a GP source.
//
// This path assumes everything fits in registers — callers gate it on the
// register budget and route genuine overflow to emitShimArgSpill_x64.
func emitShimArgMarshal_x64(a @asm.Assembler, cc common.CallConv,
		fvTyp @types.Type, srcPrefix int, gpDestBase int) {
	// Clobber-safe staging, ONLY when a coerced aggregate is present.  Such an
	// arg makes the OUTGOING register cursor (ArgWords words) advance faster than
	// the INCOMING by-address cursor (one pointer word), so an outgoing write can
	// land in a LATER param's not-yet-read incoming arg register (a register-
	// permutation hazard).  Without one, incoming and outgoing advance in
	// lockstep (a constant down-shift), already clobber-safe, so we skip staging.
	// When staging: x86-64 has too few caller-saved scratch regs to stage in
	// registers (cf. aarch64's X9..X15), so stage the incoming dispatch words to
	// a scratch stack frame (balanced Sub/Add, so the caller shape's RSP-relative
	// slots are untouched) and read each from the frame.  R10 is the transient
	// value-load scratch.
	var needStage bool = false
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		if common.AggCoercedInReg(fvTyp.Params[pi].Type) { needStage = true }
	}
	var frame int = 0
	if needStage {
		var nIn int = 0
		for pi := 0; pi < len(fvTyp.Params); pi++ {
			nIn = nIn + cc.EffectiveArgWords(fvTyp.Params[pi].Type)
		}
		frame = nIn * 8
		if frame % 16 != 0 { frame = frame + 8 }
		if frame > 0 {
			x64.Sub(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(frame))
			for w := 0; w < nIn; w++ {
				x64.Mov(a, x64.Mem(x64.RSP, 8 * w, x64.SZ64),
					x64.Reg(argReg(srcPrefix + w), x64.SZ64))
			}
		}
	}
	var ngrn int = 0
	var nsrn int = 0
	var srcWord int = 0
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		var pt @types.Type = fvTyp.Params[pi].Type
		if common.IsFloatScalarTyp(pt) {
			if nsrn < 8 {
				var fsrc int = argReg(srcPrefix + srcWord)
				if needStage {
					x64.Mov(a, x64.Reg(x64.R10, x64.SZ64),
						x64.Mem(x64.RSP, 8 * srcWord, x64.SZ64))
					fsrc = x64.R10
				}
				if common.FloatScalarIsI32(pt) {
					x64.Movd_gp_to_xmm(a, x64.XMM0 + nsrn, fsrc)
				} else {
					x64.Movq_gp_to_xmm(a, x64.XMM0 + nsrn, fsrc)
				}
				nsrn = nsrn + 1
			}
			srcWord = srcWord + 1
			continue
		}
		if common.AggCoercedInReg(pt) {
			// Coerced in-register struct/array: the staged word at
			// [RSP + 8*srcWord] is its by-address pointer (needStage is true
			// here); load its ArgWords value-words into the consecutive GP regs
			// the underlying's coerced ABI reads.  Incoming consumed ONE pointer
			// word; outgoing advanced n coerced regs (the cursors DIVERGE).
			// TODO(4d-arg): an SSE aggregate param must expand into XMM/GP by
			// eightbyte class (emitSseShimArgFromPtr) instead of all-GP, and the
			// shim's outgoing register-budget accounting must count only its
			// INTEGER eightbytes as GP pressure; deferred, dormant-safe (gate off).
			var n int = common.ArgWords(pt)
			x64.Mov(a, x64.Reg(x64.R10, x64.SZ64),
				x64.Mem(x64.RSP, 8 * srcWord, x64.SZ64))
			for k := 0; k < n; k++ {
				x64.Mov(a, x64.Reg(argReg(gpDestBase + ngrn + k), x64.SZ64),
					x64.Mem(x64.R10, 8 * k, x64.SZ64))
			}
			ngrn = ngrn + n
			srcWord = srcWord + 1
			continue
		}
		// Effective words: an indirect-large aggregate is 1 pointer word
		// (the dispatch caller placed it as one), NOT its ArgWords expansion.
		var w int = cc.EffectiveArgWords(pt)
		for k := 0; k < w; k++ {
			var dst int = argReg(gpDestBase + ngrn + k)
			if needStage {
				x64.Mov(a, x64.Reg(dst, x64.SZ64),
					x64.Mem(x64.RSP, 8 * (srcWord + k), x64.SZ64))
			} else {
				var src int = argReg(srcPrefix + srcWord + k)
				if dst != src {
					x64.Mov(a, x64.Reg(dst, x64.SZ64),
						x64.Reg(src, x64.SZ64))
				}
			}
		}
		ngrn = ngrn + w
		srcWord = srcWord + w
	}
	if frame > 0 {
		x64.Add(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(frame))
	}
}

// funcValMultiReturnTuple_x64 builds the anonymous multi-return tuple struct
// for a function value's results (one field per result type, in order — field
// names don't affect layout), or nil when the function value isn't a
// multi-return (len(Results) <= 1).
func funcValMultiReturnTuple_x64(fvTyp @types.Type) @types.Type {
	if fvTyp == nil { return nil }
	if len(fvTyp.Results) <= 1 { return nil }
	var fields @[]@types.Field = make_slice(@types.Field, len(fvTyp.Results))
	for i := 0; i < len(fvTyp.Results); i++ {
		var f @types.Field = make(types.Field)
		f.Type = fvTyp.Results[i]
		fields[i] = f
	}
	return types.MakeStructType("", fields)
}

// multiReturnTupleSize_x64 returns the SizeOf the multi-return tuple struct, or
// 0 when the function value isn't multi-return.  Used to size the sret buffer.
func multiReturnTupleSize_x64(fvTyp @types.Type) int {
	var t @types.Type = funcValMultiReturnTuple_x64(fvTyp)
	if t == nil { return 0 }
	return t.SizeOf()
}

// isBigMultiReturn_x64 reports whether the function value's multi-return tuple
// is returned via an sret pointer rather than in registers.  It must use the
// SAME register-count rule the CALLEE's FuncReturnsBigMultiReturn / the regular
// call sites use (SysV field-per-register: > 3 GP-words or > 2 FP-fields →
// sret), so the funcval call site and shim agree with the callee — a size-only
// (> 16 B) rule disagreed for e.g. (i64,i64,i64) (24 B, but 3 GP regs →
// in-register) at the native↔LLVM boundary (claude-todo #112).  A big tuple is
// returned through an sret pointer in RDI (the retbuf-in-RDI convention single
// aggregates use); a small one packs field-per-register into RAX,RDX,RCX /
// XMM0,XMM1.
func isBigMultiReturn_x64(fvTyp @types.Type) bool {
	var t @types.Type = funcValMultiReturnTuple_x64(fvTyp)
	if t == nil { return false }
	return common.SysV_AMD64().MultiReturnTupleNeedsSret(t)
}

// emitFuncValueShims emits a per-function shim for each OP_FUNC_VALUE
// / OP_FUNC_HANDLE reference.  Three shapes depending on the function
// value's return type:
//
//   Scalar / void return (a NON-aggregate result — ≤ 8 bytes by
//   nature — or void): shim has signature
//     `<ret>(*uint8 data, <args>)` — call passes data in RDI and
//     user args in RSI+.  Shim shifts RSI..R9 → RDI..R8 (data
//     discarded) and tail-jumps to the real fn.
//
//   Pack-return aggregate (an aggregate result, 1..16 bytes — a
//   ≤ 8-byte aggregate packs into RAX alone): shim has signature
//     `void(*uint8 retbuf, *uint8 data, <args>)` — call passes
//     retbuf in RDI, data in RSI, user args in RDX+.  Shim shifts
//     user args, calls underlying, copies packed RAX (+RDX) through
//     the stashed retbuf.
//
//   Sret-return aggregate (> 16 bytes): same incoming shape as
//     pack, but underlying uses SysV sret (hidden RDI = retbuf).
//     Shim moves retbuf RDI → RDI (already there), shifts user
//     args, tail-jumps.  Since RDI is both the input retbuf and
//     the underlying's sret slot, we need to drop the data slot
//     and shift the user args left by ONE (the data slot is
//     dropped; retbuf stays in RDI).
//
// When the user-arg effective words exceed the register budget, each
// shape routes to its stack-spill variant (emitFuncvalSpillShim_x64)
// instead of failing — the underlying then reads its overflow args
// from the outgoing-args stack the shim reserves.
func emitFuncValueShims(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	var seen @[]@[]char
	var sigs @[]@types.Type
	seen, sigs = collectFuncValueRefs(mod)
	if len(seen) == 0 { return }
	a.SetSection("text", -1)
	var cc common.CallConv = common.SysV_AMD64()
	for i := 0; i < len(seen); i++ {
		var fnLabel @[]char = symFor(pkgName, seen[i])
		var shimLabel @[]char = shimSymFor_x64(pkgName, seen[i])
		var fvTyp @types.Type = sigs[i]
		a.DefineLabel(shimLabel)
		a.SetWeak(shimLabel)
		// B.2 of plan-function-values-phase-2.md: if the referenced
		// function is a capturing closure, branch to the closure-
		// aware shim emitter which loads captures from the data
		// pointer (RDI) into the leading arg registers before the
		// tail-jump.  Non-closure path (Phase 1) stays unchanged.
		var closureFunc @ir.Func = lookupClosureFunc_x64(mod, seen[i])
		if closureFunc != nil {
			emitClosureShim_x64(a, fnLabel, fvTyp, closureFunc)
			continue
		}
		var nUserWords int = 0
		for pi := 0; pi < len(fvTyp.Params); pi++ {
			var pt @types.Type = fvTyp.Params[pi].Type
			// Budget the SHIM's register/spill routing on the OUTGOING (real
			// ABI) GP word count: a coerced in-register struct/array arrives as
			// ONE by-address pointer word (EffectiveArgWords == 1) but the shim
			// expands it into ArgWords coerced regs, so counting it via
			// EffectiveArgWords would undercount the outgoing register pressure
			// and wrongly keep a wide call on the register-only path.
			if common.AggCoercedInReg(pt) {
				nUserWords = nUserWords + common.ArgWords(pt)
			} else {
				nUserWords = nUserWords + cc.EffectiveArgWords(pt)
			}
		}
		var retSz int = shimReturnSize_x64(fvTyp)
		var retIsAgg bool = shimReturnIsAggregate_x64(fvTyp)
		var useSret bool = retSz > 16
		// A big multi-return (> 16 B) is also returned via the sret
		// pointer in RDI, so it takes the sret shape below — NOT the
		// scalar tail-jump, which would shift a user arg into RDI and
		// clobber the sret pointer.  (Small multi-return packs RAX:RDX
		// and stays scalar.)
		var bigMultiRet bool = isBigMultiReturn_x64(fvTyp)
		// An aggregate result of 1..16 bytes is returned through the retbuf the
		// caller passed in RDI — INCLUDING a ≤ 8-byte aggregate (packed into one
		// word in RAX).  A scalar result is also ≤ 8 bytes but is NOT an
		// aggregate, so it stays on the tail-jump scalar shape — hence the
		// retIsAgg gate rather than a bare size floor.
		var usePack bool = retIsAgg && retSz >= 1 && retSz <= 16
		// Register budget for the tail-jump / register-only shapes below:
		// they can't read stack-passed incoming user args nor write stack-
		// passed outgoing ones.  The pack and sret shapes consume RDI+RSI
		// for retbuf+data, leaving 4 GP slots (RDX/RCX/R8/R9) for incoming
		// user args; the scalar shape consumes only RDI (data), leaving 5.
		// Beyond that, route to the stack-spill shim, which reserves an
		// outgoing-args frame and reads/writes the overflow words there.
		var userBudget int = 5
		if usePack || useSret || bigMultiRet {
			userBudget = 4
		}
		if nUserWords > userBudget {
			emitFuncvalSpillShim_x64(a, cc, fnLabel, fvTyp, retSz,
				usePack, useSret || bigMultiRet,
				shimReturnIsFloatScalar_x64(fvTyp))
			continue
		}
		if usePack {
			// Pack-return shim: retbuf in RDI, data in RSI, user
			// args RDX..R9.  Save retbuf at [rsp+8], shift user args
			// RDX..→RDI.., CALL underlying, reload retbuf, store
			// RAX (+RDX) through it, return.
			//
			// Frame: pushq %rbp / movq %rsp, %rbp / sub $0x10, %rsp
			// — 16 bytes for retbuf save + 16-byte alignment.
			x64.Push(a, x64.Reg(x64.RBP, x64.SZ64))
			x64.Mov(a, x64.Reg(x64.RBP, x64.SZ64),
				x64.Reg(x64.RSP, x64.SZ64))
			x64.Sub(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(16))
			// Stash retbuf (RDI) at [rsp + 0].
			x64.Mov(a, x64.Mem(x64.RSP, 0, x64.SZ64),
				x64.Reg(x64.RDI, x64.SZ64))
			// Marshal user args (incoming RDX..) into the underlying's
			// SysV layout: float scalars -> xmm regs, the rest shifted
			// down past the stashed retbuf + dropped data (GP base 0).
			emitShimArgMarshal_x64(a, cc, fvTyp, 2, 0)
			a.SetGlobal(fnLabel)
			x64.Call(a, fnLabel)
			// The underlying's packed return is live in its return
			// registers.  Reload retbuf into R10 (caller-saved, not a
			// return reg, not in regPool's first slot since this is a
			// shim with no regmap) and collect through it.
			x64.Mov(a, x64.Reg(x64.R10, x64.SZ64),
				x64.Mem(x64.RSP, 0, x64.SZ64))
			if cc.ReturnsSseInRegs(fvTyp.Results[0]) {
				// SSE aggregate: SSE eightbytes came back in XMM0/XMM1,
				// INTEGER eightbytes in RAX/RDX — collect by class, not
				// RAX/RDX wholesale.
				emitSseReturnCollectTo(a, fvTyp.Results[0], x64.R10, 0)
			} else {
				x64.Mov(a, x64.Mem(x64.R10, 0, x64.SZ64),
					x64.Reg(x64.RAX, x64.SZ64))
				if retSz > 8 {
					x64.Mov(a, x64.Mem(x64.R10, 8, x64.SZ64),
						x64.Reg(x64.RDX, x64.SZ64))
				}
			}
			// Tear down frame and return.
			x64.Add(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(16))
			x64.Pop(a, x64.Reg(x64.RBP, x64.SZ64))
			x64.Ret(a)
		} else if useSret || bigMultiRet {
			// Sret-return shim — a single aggregate > 16 B, OR a big
			// multi-return tuple (> 16 B); both are returned via the SysV
			// sret pointer in RDI.  retbuf stays in RDI (where the
			// underlying expects the sret pointer); drop the data slot
			// (RSI) and marshal user args (incoming RDX..) into the SysV
			// layout — float scalars -> xmm regs, GP args start at RSI
			// (gpDestBase 1, since RDI is the sret pointer).
			emitShimArgMarshal_x64(a, cc, fvTyp, 2, 1)
			a.SetGlobal(fnLabel)
			x64.Jmp(a, fnLabel)
		} else if shimReturnIsFloatScalar_x64(fvTyp) {
			// Scalar shim whose result is a float scalar: the all-int
			// shim ABI returns the bits in rax, but the underlying
			// returns them in xmm0, so this can't tail-jump.  Build a
			// frame (push rbp re-aligns rsp to 16 for the CALL), marshal
			// args (drop data), CALL, movq/movd the result xmm0 -> rax,
			// tear down, RET.
			x64.Push(a, x64.Reg(x64.RBP, x64.SZ64))
			x64.Mov(a, x64.Reg(x64.RBP, x64.SZ64),
				x64.Reg(x64.RSP, x64.SZ64))
			emitShimArgMarshal_x64(a, cc, fvTyp, 1, 0)
			a.SetGlobal(fnLabel)
			x64.Call(a, fnLabel)
			if common.FloatScalarIsI32(fvTyp.Results[0]) {
				x64.Movd_xmm_to_gp(a, x64.RAX, x64.XMM0)
			} else {
				x64.Movq_xmm_to_gp(a, x64.RAX, x64.XMM0)
			}
			x64.Pop(a, x64.Reg(x64.RBP, x64.SZ64))
			x64.Ret(a)
		} else {
			// Scalar / void shim: data was in RDI; drop it and marshal
			// user args (float scalars -> xmm regs, the rest shifted
			// RSI..R9 -> RDI..R8), then tail-jump.
			emitShimArgMarshal_x64(a, cc, fvTyp, 1, 0)
			a.SetGlobal(fnLabel)
			x64.Jmp(a, fnLabel)
		}
	}
}
