package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/types"
import "pkg/binate/types/abi"

// isByAddressAggX64 reports whether an aggregate func-value ARG rides the shim ABI
// BY-ADDRESS (one pointer word the shim loads + re-expands into the underlying's
// real ABI): every aggregate the real ABI does not itself pass as a pointer
// (PassesIndirect) — a coerced in-register named struct/array, a raw slice /
// iface-value, and on SysV (no IndirectLargeAggregates) a >16-byte aggregate,
// whose words the shim lays on the outgoing stack.  Matches the LLVM shim, which
// declares every aggregate `i8*`.  The x64 counterpart of arm32's
// isByAddressAggArm32 / aa64's isByAddressAggAA64 (conformance 1006 covers a
// slice).
func isByAddressAggX64(cc callconv.CallConv, pt @types.Type) bool {
	if callconv.AggCoercedInReg(pt) { return true }
	if !callconv.IsAggregateTyp(pt) { return false }
	return !cc.PassesIndirect(pt)
}

// shimInWordsForTypeX64 is the number of INCOMING dispatch words a func-value arg
// of type pt occupies: 1 for a by-address aggregate (isByAddressAggX64 — the shim
// re-expands its ArgWords value-words from the one pointer), else
// cc.EffectiveArgWords.
func shimInWordsForTypeX64(cc callconv.CallConv, pt @types.Type) int {
	if isByAddressAggX64(cc, pt) { return 1 }
	return cc.EffectiveArgWords(pt)
}

// regArgWordsX64 returns the word count of an argument of type t that a register-
// only shim path places in GP argument registers -- at most six -- as int, failing
// loud on one past them (an argument that large goes on the stack, which the shims'
// routing sends down a stack-spill path).
func regArgWordsX64(t @types.Type) int {
	var n int64 = callconv.ArgWords64(t)
	if n > 6 { panic("native x64: a register-only shim argument of more than six words") }
	return cast(int, n)
}

// Per-function func-value SHIM body emission for the amd64 backend —
// the text-section half of the func-value triple (the vtable / handle
// data half and the OP_FUNC_VALUE / OP_FUNC_HANDLE reference collection
// live in x64_funcvalue.bn).  Each non-closure reference gets one shim
// whose shape is selected by the function value's return type; a
// capturing-closure reference routes to emitClosureShim_x64
// (x64_closure_shim.bn) instead.
//
// The shim is entered under the uniform all-int dispatch ABI (the VM's
// rt._call_shim_scalar and the compiled emitCallFuncValue both place
// every arg WORD — float bits included — positionally in a GP register,
// after a leading data slot, or retbuf+data for the aggregate shapes).
// The shim re-marshals those words into the real SysV layout the
// underlying function expects, then tail-jumps (when every outgoing arg
// is in a register) or CALLs with a frame (when the underlying needs
// outgoing-args on the stack, or the return must be post-processed).

// shimReturnSize_x64 returns the byte size of a function value's
// single-result return type, or 0 for void / multi-return.
func shimReturnSize_x64(fvTyp @types.Type) int64 {
	if fvTyp == nil { return 0 }
	if len(fvTyp.Results) != 1 { return 0 }
	if fvTyp.Results[0] == nil { return 0 }
	return fvTyp.Results[0].Size()
}

// shimReturnIsAggregate_x64 reports whether a function value's single result rides
// the retbuf (pack/sret) shim shape rather than the scalar/void tail-jump.  It
// delegates to abi.IsAggregateReturnTyp — the single-source-of-truth predicate
// the LLVM shim (codegen isAggregateReturn), the call site, and the VM cross-mode
// dispatch all agree on — so the closure dispatch and the retIsAgg gate classify a
// result exactly as the LLVM-emitted shim does.  For every aggregate of size >= 1
// this matches the kind-only callconv.IsAggregateTyp; it differs only for a 0-byte
// aggregate (`struct{}` / `[0]T`), which is void-like (no retbuf) and must NOT take
// the pack shim — it would store a garbage word through a 0-byte retbuf the caller
// never allocated.  (The non-closure retIsAgg use also gates usePack on
// retSz >= 1, so the difference matters only for the CLOSURE dispatch's 0-byte
// routing.)
func shimReturnIsAggregate_x64(fvTyp @types.Type) bool {
	if fvTyp == nil { return false }
	if len(fvTyp.Results) != 1 { return false }
	return abi.IsAggregateReturnTyp(fvTyp.Results[0])
}

// shimReturnIsFloatScalar_x64 reports whether a func value's single result is
// a float scalar.  Such a return can't ride the scalar tail-jump: the
// underlying returns it in xmm0, but the all-int shim ABI hands the bits back
// in rax, so the shim must CALL and movq/movd xmm0 -> rax.
func shimReturnIsFloatScalar_x64(fvTyp @types.Type) bool {
	if fvTyp == nil { return false }
	if len(fvTyp.Results) != 1 { return false }
	return callconv.IsFloatScalarTyp(fvTyp.Results[0])
}

// funcValMultiReturnTuple_x64 builds the anonymous multi-return tuple struct
// for a function value's results (one field per result type, in order — field
// names don't affect layout), or nil when the function value isn't a
// multi-return (len(Results) <= 1).
func funcValMultiReturnTuple_x64(fvTyp @types.Type) @types.Type {
	if fvTyp == nil { return nil }
	if len(fvTyp.Results) <= 1 { return nil }
	var fields @[]@types.Field = make_slice(@types.Field, len(fvTyp.Results))
	for i := 0; i < len(fvTyp.Results); i++ {
		var f @types.Field = make(types.Field)
		f.Type = fvTyp.Results[i]
		fields[i] = f
	}
	return types.MakeStructType("", fields)
}

// multiReturnTupleSize_x64 returns the size of the multi-return tuple struct, or
// 0 when the function value isn't multi-return.  Used to size the sret buffer.
func multiReturnTupleSize_x64(fvTyp @types.Type) int64 {
	var t @types.Type = funcValMultiReturnTuple_x64(fvTyp)
	if t == nil { return 0 }
	return t.Size()
}

// isBigMultiReturn_x64 reports whether the function value's multi-return tuple
// is returned via an sret pointer rather than in registers.  It must use the
// SAME register-count rule the CALLEE's FuncReturnsBigMultiReturn / the regular
// call sites use (SysV field-per-register: > 3 GP-words or > 2 FP-fields →
// sret), so the funcval call site and shim agree with the callee — a size-only
// (> 16 B) rule disagreed for e.g. (i64,i64,i64) (24 B, but 3 GP regs →
// in-register) at the native↔LLVM boundary.  A big tuple is
// returned through an sret pointer in RDI (the retbuf-in-RDI convention single
// aggregates use); a small one packs field-per-register into RAX,RDX,RCX /
// XMM0,XMM1.
func isBigMultiReturn_x64(fvTyp @types.Type) bool {
	var t @types.Type = funcValMultiReturnTuple_x64(fvTyp)
	if t == nil { return false }
	return callconv.SysV_AMD64().MultiReturnTupleNeedsSret(t)
}

// emitFuncValueShims emits a per-function shim for each OP_FUNC_VALUE
// / OP_FUNC_HANDLE reference.  Three shapes depending on the function
// value's return type:
//
//   Scalar / void return (a NON-aggregate result — ≤ 8 bytes by
//   nature — or void): shim has signature
//     `<ret>(*uint8 data, <args>)` — call passes data in RDI and
//     user args in RSI+.  Shim shifts RSI..R9 → RDI..R8 (data
//     discarded) and tail-jumps to the real fn.
//
//   Pack-return aggregate (an aggregate result, 1..16 bytes — a
//   ≤ 8-byte aggregate packs into RAX alone): shim has signature
//     `void(*uint8 retbuf, *uint8 data, <args>)` — call passes
//     retbuf in RDI, data in RSI, user args in RDX+.  Shim shifts
//     user args, calls underlying, copies packed RAX (+RDX) through
//     the stashed retbuf.
//
//   Sret-return aggregate (> 16 bytes): same incoming shape as
//     pack, but underlying uses SysV sret (hidden RDI = retbuf).
//     Shim moves retbuf RDI → RDI (already there), shifts user
//     args, tail-jumps.  Since RDI is both the input retbuf and
//     the underlying's sret slot, we need to drop the data slot
//     and shift the user args left by ONE (the data slot is
//     dropped; retbuf stays in RDI).
//
// When the user-arg effective words exceed the register budget, or a user
// arg is passed on the stack (a >16-byte aggregate, MEMORY class), each
// shape routes to its stack-spill variant (emitFuncvalSpillShim_x64) —
// the underlying then reads its stack args from the outgoing-args area
// the shim reserves.
func emitFuncValueShims(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	var seen @[]@[]char
	var sigs @[]@types.Type
	seen, sigs = collectFuncValueRefs(mod)
	if len(seen) == 0 { return }
	a.SetSection("text", -1)
	var cc callconv.CallConv = callconv.SysV_AMD64()
	for i := 0; i < len(seen); i++ {
		var fnLabel @[]char = symFor(pkgName, seen[i])
		var shimLabel @[]char = shimSymFor_x64(pkgName, seen[i])
		var fvTyp @types.Type = sigs[i]
		x64.AlignNops(a, X64_FUNC_ALIGN)
		a.DefineLabel(shimLabel)
		a.SetWeak(shimLabel)
		// If the referenced function is a capturing closure, branch to
		// the closure-aware shim emitter which loads captures from the
		// data pointer (RDI) into the leading arg registers before the
		// tail-jump.  The non-closure path stays unchanged.
		var closureFunc @ir.Func = lookupClosureFunc_x64(mod, seen[i])
		if closureFunc != nil {
			emitClosureShim_x64(a, fnLabel, fvTyp, closureFunc)
			continue
		}
		var nUserWords int64 = 0
		// nInWords is the INCOMING dispatch-word count, budgeted separately: a
		// zero-size by-address aggregate takes one incoming word (its address) but
		// no outgoing one, so the outgoing count alone can fit the registers while
		// the incoming words run onto the caller's stack, which the register-only
		// shapes cannot read.
		var nInWords int = funcvalPackedWords_x64(cc, fvTyp)
		for pi := 0; pi < len(fvTyp.Params); pi++ {
			var pt @types.Type = fvTyp.Params[pi].Type
			// Budget the SHIM's register/spill routing on the OUTGOING (real
			// ABI) GP word count: a by-address aggregate (a coerced in-register
			// struct/array, OR a raw slice / iface-value)
			// arrives as ONE by-address pointer word (shimInWordsForTypeX64 == 1)
			// but the shim expands it into ArgWords value regs, so counting it via
			// the incoming word count would undercount the outgoing register
			// pressure and wrongly keep a wide call on the register-only path.
			if isByAddressAggX64(cc, pt) {
				nUserWords = nUserWords + callconv.ArgWords64(pt)
			} else {
				nUserWords = nUserWords + cast(int64, cc.EffectiveArgWords(pt))
			}
		}
		var retSz int64 = shimReturnSize_x64(fvTyp)
		var retIsAgg bool = shimReturnIsAggregate_x64(fvTyp)
		var useSret bool = retSz > 16
		// A big multi-return (more fields than the return registers hold, whatever
		// its size: > 3 GP words or > 4 FP fields) is returned via the sret
		// pointer in RDI, so it takes the sret shape below — NOT the scalar
		// tail-jump, which would shift a user arg into RDI and clobber the sret
		// pointer.  A SMALL multi-return (≤ NumGpRetRegs words) is returned by the
		// callee FIELD-PER-REGISTER (RAX,RDX,RCX / XMM0,XMM1), but the retbuf-for-
		// any-multi-return caller convention (matching the LLVM shim + caller + VM
		// cross-mode dispatch) passes a retbuf in RDI: the shim must CALL, then
		// store the callee's field-per-register return THROUGH retbuf — the
		// smallMultiRet pack path below.
		var bigMultiRet bool = isBigMultiReturn_x64(fvTyp)
		var isMultiRet bool = len(fvTyp.Results) > 1
		var smallMultiRet bool = isMultiRet && !bigMultiRet
		// An aggregate result of 1..16 bytes is returned through the retbuf the
		// caller passed in RDI — INCLUDING a ≤ 8-byte aggregate (packed into one
		// word in RAX).  A scalar result is also ≤ 8 bytes but is NOT an
		// aggregate, so it stays on the tail-jump scalar shape — hence the
		// retIsAgg gate rather than a bare size floor.
		var usePack bool = retIsAgg && retSz >= 1 && retSz <= 16
		// Register budget for the tail-jump / register-only shapes below:
		// they can't read stack-passed incoming user args nor write stack-
		// passed outgoing ones.  The pack, small-multiret and sret shapes consume
		// RDI+RSI for retbuf+data, leaving 4 GP slots (RDX/RCX/R8/R9) for incoming
		// user args; the scalar shape consumes only RDI (data), leaving 5.
		// Beyond that, route to the stack-spill shim, which reserves an
		// outgoing-args frame and reads/writes the overflow words there.
		var userBudget int = 5
		if usePack || useSret || bigMultiRet || smallMultiRet {
			userBudget = 4
		}
		// A user arg the real ABI passes on the stack (a >16-byte aggregate is MEMORY
		// class) needs the spill shim's outgoing-args area too, however few words
		// precede it: the register-only shapes below cannot place it.  The sret
		// shapes give the callee's RDI to the sret pointer.
		var ccOut callconv.CallConv = cc
		if useSret || bigMultiRet { ccOut.NumGpArgRegs = cc.NumGpArgRegs - 1 }
		var needStack bool = ccOut.CallStackBytes64(shimUserTypes_x64(fvTyp)) > 0
		if nUserWords > cast(int64, userBudget) || nInWords > userBudget || needStack {
			emitFuncvalSpillShim_x64(a, cc, fnLabel, fvTyp, retSz, usePack, useSret || bigMultiRet,
					shimReturnIsFloatScalar_x64(fvTyp), smallMultiRet)
			continue
		}
		if usePack {
			// Pack-return shim: retbuf in RDI, data in RSI, user
			// args RDX..R9.  Save retbuf at [rsp+8], shift user args
			// RDX..→RDI.., CALL underlying, reload retbuf, store
			// RAX (+RDX) through it, return.
			//
			// Frame: pushq %rbp / movq %rsp, %rbp / sub $0x10, %rsp
			// — 16 bytes for retbuf save + 16-byte alignment.
			x64.Push(a, x64.Reg(x64.RBP, x64.SZ64))
			x64.Mov(a, x64.Reg(x64.RBP, x64.SZ64), x64.Reg(x64.RSP, x64.SZ64))
			x64.Sub(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(16))
			// Stash retbuf (RDI) at [rsp + 0].
			x64.Mov(a, x64.Mem(x64.RSP, 0, x64.SZ64), x64.Reg(x64.RDI, x64.SZ64))
			// Marshal user args (incoming RDX..) into the underlying's
			// SysV layout: float scalars -> xmm regs, the rest shifted
			// down past the stashed retbuf + dropped data (GP base 0).
			emitShimArgMarshal_x64(a, cc, fvTyp, 2, 0)
			a.SetGlobal(fnLabel)
			x64.Call(a, fnLabel)
			// The underlying's packed return is live in its return
			// registers.  Reload retbuf into R10 (caller-saved, not a
			// return reg, not in regPool's first slot since this is a
			// shim with no regmap) and collect through it.
			x64.Mov(a, x64.Reg(x64.R10, x64.SZ64), x64.Mem(x64.RSP, 0, x64.SZ64))
			if cc.ReturnsSseInRegs(fvTyp.Results[0]) {
				// SSE aggregate: SSE eightbytes came back in XMM0/XMM1,
				// INTEGER eightbytes in RAX/RDX — collect by class, not
				// RAX/RDX wholesale.
				emitSseReturnCollectTo(a, fvTyp.Results[0], x64.R10, 0, x64.R11)
			} else {
				emitStoreRegWordX64(a, x64.RAX, x64.R10, 0, cast(int, retSz), x64.R11)
				if retSz > 8 {
					emitStoreRegWordX64(a, x64.RDX, x64.R10, 8, cast(int, retSz) - 8, x64.R11)
				}
			}
			// Tear down frame and return.
			x64.Add(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(16))
			x64.Pop(a, x64.Reg(x64.RBP, x64.SZ64))
			x64.Ret(a)
		} else if smallMultiRet {
			// Small-multi-return pack shim: retbuf in RDI, data in RSI, user
			// args RDX..R9.  Same frame + arg-shift as usePack, but the callee
			// returns the tuple FIELD-PER-REGISTER (RAX,RDX,RCX / XMM0,XMM1),
			// so the store through retbuf is the field-per-class helper, NOT the
			// whole-word RAX(+RDX) dump.  (Reusing usePack's RAX:RDX store would
			// read GP regs the callee never wrote for a float field, drop the x87
			// overflow floats, and ignore sub-word field sizing — wrong bytes.)
			x64.Push(a, x64.Reg(x64.RBP, x64.SZ64))
			x64.Mov(a, x64.Reg(x64.RBP, x64.SZ64), x64.Reg(x64.RSP, x64.SZ64))
			x64.Sub(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(16))
			x64.Mov(a, x64.Mem(x64.RSP, 0, x64.SZ64), x64.Reg(x64.RDI, x64.SZ64))
			emitShimArgMarshal_x64(a, cc, fvTyp, 2, 0)
			a.SetGlobal(fnLabel)
			x64.Call(a, fnLabel)
			// Reload retbuf into R10 (caller-saved, not a return reg), then
			// store the field-per-register tuple through it.  R11 is the field
			// float→GP scratch — not a return reg, not R10 (the retbuf base).
			x64.Mov(a, x64.Reg(x64.R10, x64.SZ64), x64.Mem(x64.RSP, 0, x64.SZ64))
			storeMultiReturnTupleFields_x64(a, funcValMultiReturnTuple_x64(fvTyp), x64.R10, 0, x64.R11,
					cc.NumFpRetRegs)
			x64.Add(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(16))
			x64.Pop(a, x64.Reg(x64.RBP, x64.SZ64))
			x64.Ret(a)
		} else if useSret || bigMultiRet {
			// Sret-return shim — a single aggregate > 16 B, OR a big
			// multi-return tuple (by register count); both are returned via the SysV
			// sret pointer in RDI.  retbuf stays in RDI (where the
			// underlying expects the sret pointer); drop the data slot
			// (RSI) and marshal user args (incoming RDX..) into the SysV
			// layout — float scalars -> xmm regs, GP args start at RSI
			// (gpDestBase 1, since RDI is the sret pointer).
			emitShimArgMarshal_x64(a, cc, fvTyp, 2, 1)
			a.SetGlobal(fnLabel)
			x64.Jmp(a, fnLabel)
		} else if shimReturnIsFloatScalar_x64(fvTyp) {
			// Scalar shim whose result is a float scalar: the all-int
			// shim ABI returns the bits in rax, but the underlying
			// returns them in xmm0, so this can't tail-jump.  Build a
			// frame (push rbp re-aligns rsp to 16 for the CALL), marshal
			// args (drop data), CALL, movq/movd the result xmm0 -> rax,
			// tear down, RET.
			x64.Push(a, x64.Reg(x64.RBP, x64.SZ64))
			x64.Mov(a, x64.Reg(x64.RBP, x64.SZ64), x64.Reg(x64.RSP, x64.SZ64))
			emitShimArgMarshal_x64(a, cc, fvTyp, 1, 0)
			a.SetGlobal(fnLabel)
			x64.Call(a, fnLabel)
			if callconv.FloatScalarIsI32(fvTyp.Results[0]) {
				x64.Movd_xmm_to_gp(a, x64.RAX, x64.XMM0)
			} else {
				x64.Movq_xmm_to_gp(a, x64.RAX, x64.XMM0)
			}
			x64.Pop(a, x64.Reg(x64.RBP, x64.SZ64))
			x64.Ret(a)
		} else {
			// Scalar / void shim: data was in RDI; drop it and marshal
			// user args (float scalars -> xmm regs, the rest shifted
			// RSI..R9 -> RDI..R8), then tail-jump.
			emitShimArgMarshal_x64(a, cc, fvTyp, 1, 0)
			a.SetGlobal(fnLabel)
			x64.Jmp(a, fnLabel)
		}
	}
}
