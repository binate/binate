package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for x64_funcvalue_shim.bn: the per-shape shim-body emission and
// the return-shape classification helpers.

// emitFuncValueShims on a module with no OP_FUNC_VALUE / OP_FUNC_HANDLE
// refs should be a no-op.  Pins the shim emitter so a regression that
// always-emits something gets caught.
func TestEmitFuncValueShimsEmptyNoOp() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var mod @ir.Module = ir.NewModule("\"main\"")
	emitFuncValueShims(a, "main", mod)
	if a.Sections[0].Len != 0 {
		return "empty module should produce no shims"
	}
	return ""
}

// isBigMultiReturn_x64 classifies a func value's multi-return tuple by the
// SysV register-count rule (the shared MultiReturnTupleNeedsSret the callee
// uses, NOT a size-only > 16 B rule): field-per-register into RAX,RDX,RCX +
// XMM0,XMM1, sret only when a class overflows.  So (int64,int64,int64) = 24 B
// is IN-REGISTER (3 GP regs, NOT big) — a size rule would wrongly sret it and
// disagree with the callee at the native↔LLVM boundary (claude-todo #112); a
// 4th GP field tips it to sret.  multiReturnTupleSize_x64 still reports the
// byte size (used to size the sret buffer).
func TestIsBigMultiReturn_x64() testing.TestResult {
	var two @types.Type = funcValTupleInt64N_x64(2)
	if multiReturnTupleSize_x64(two) != 16 {
		return "(int64,int64) tuple should be 16 bytes"
	}
	if isBigMultiReturn_x64(two) {
		return "(int64,int64) = 2 GP regs must NOT be big (packs RAX:RDX)"
	}
	var three @types.Type = funcValTupleInt64N_x64(3)
	if multiReturnTupleSize_x64(three) != 24 {
		return "(int64,int64,int64) tuple should be 24 bytes"
	}
	if isBigMultiReturn_x64(three) {
		return "(int64,int64,int64) = 3 GP regs must NOT be big "
				"(in-register RAX,RDX,RCX, matching LLVM)"
	}
	var four @types.Type = funcValTupleInt64N_x64(4)
	if !isBigMultiReturn_x64(four) {
		return "(int64 x4) = 4 GP regs must be big (sret, > 3 GP return regs)"
	}
	var single @types.Type = funcValSingleInt64_x64()
	if multiReturnTupleSize_x64(single) != 0 {
		return "single-result funcval is not multi-return (size 0)"
	}
	if isBigMultiReturn_x64(single) {
		return "single-result funcval is not a big multi-return"
	}
	return ""
}

// funcValTupleInt64N_x64 builds @func() (int64 × n) — an n-int64 multi-
// return tuple (8*n bytes, deterministic regardless of pointer size).
func funcValTupleInt64N_x64(n int) @types.Type {
	var params @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, n)
	for i := 0; i < n; i++ {
		results[i] = types.TypInt64()
	}
	return types.MakeFuncValueType(params, results)
}

// funcValSingleInt64_x64 builds @func() int64 — a single (non-multi) result.
func funcValSingleInt64_x64() @types.Type {
	var params @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt64()
	return types.MakeFuncValueType(params, results)
}
