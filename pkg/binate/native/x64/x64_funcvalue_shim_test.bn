package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for x64_funcvalue_shim.bn: the per-shape shim-body emission and
// the return-shape classification helpers.

// emitFuncValueShims on a module with no OP_FUNC_VALUE / OP_FUNC_HANDLE
// refs should be a no-op.  Pins the shim emitter so a regression that
// always-emits something gets caught.
func TestEmitFuncValueShimsEmptyNoOp() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var mod @ir.Module = ir.NewModule("\"main\"")
	emitFuncValueShims(a, "main", mod)
	if a.Sections[0].Len != 0 {
		return "empty module should produce no shims"
	}
	return ""
}

// isBigMultiReturn_x64 classifies a func value's multi-return tuple by the
// SysV register-count rule (the shared MultiReturnTupleNeedsSret the callee
// uses, NOT a size-only > 16 B rule): field-per-register into RAX,RDX,RCX +
// XMM0,XMM1, sret only when a class overflows.  So (int64,int64,int64) = 24 B
// is IN-REGISTER (3 GP regs, NOT big) — a size rule would wrongly sret it and
// disagree with the callee at the native↔LLVM boundary (claude-todo #112); a
// 4th GP field tips it to sret.  multiReturnTupleSize_x64 still reports the
// byte size (used to size the sret buffer).
func TestIsBigMultiReturn_x64() testing.TestResult {
	var two @types.Type = funcValTupleInt64N_x64(2)
	if multiReturnTupleSize_x64(two) != 16 {
		return "(int64,int64) tuple should be 16 bytes"
	}
	if isBigMultiReturn_x64(two) {
		return "(int64,int64) = 2 GP regs must NOT be big (packs RAX:RDX)"
	}
	var three @types.Type = funcValTupleInt64N_x64(3)
	if multiReturnTupleSize_x64(three) != 24 {
		return "(int64,int64,int64) tuple should be 24 bytes"
	}
	if isBigMultiReturn_x64(three) {
		return "(int64,int64,int64) = 3 GP regs must NOT be big "
				"(in-register RAX,RDX,RCX, matching LLVM)"
	}
	var four @types.Type = funcValTupleInt64N_x64(4)
	if !isBigMultiReturn_x64(four) {
		return "(int64 x4) = 4 GP regs must be big (sret, > 3 GP return regs)"
	}
	var single @types.Type = funcValSingleInt64_x64()
	if multiReturnTupleSize_x64(single) != 0 {
		return "single-result funcval is not multi-return (size 0)"
	}
	if isBigMultiReturn_x64(single) {
		return "single-result funcval is not a big multi-return"
	}
	return ""
}

// funcValTupleInt64N_x64 builds @func() (int64 × n) — an n-int64 multi-
// return tuple (8*n bytes, deterministic regardless of pointer size).
func funcValTupleInt64N_x64(n int) @types.Type {
	var params @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, n)
	for i := 0; i < n; i++ {
		results[i] = types.TypInt64()
	}
	return types.MakeFuncValueType(params, results)
}

// funcValSingleInt64_x64 builds @func() int64 — a single (non-multi) result.
func funcValSingleInt64_x64() @types.Type {
	var params @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt64()
	return types.MakeFuncValueType(params, results)
}

// shimLenForParam1_x64 emits the register-only func-value shim for a single-
// parameter function value `func(pty) int` and returns the shim's byte length.
func shimLenForParam1_x64(pty @types.Type) int {
	var mod @ir.Module = ir.NewModule("\"main\"")
	var p @ir.Param = make(ir.Param)
	p.Name = "x"
	p.Typ = pty
	var params @[]@ir.Param
	params = appendIrParam_spilltest_x64(params, p)
	var f @ir.Func = ir.NewFunc("", "f", params, scalarResult_spilltest_x64())
	f.IsLinkOnce = true
	mod.AddFunc(f)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitFuncValueShims(a, "main", mod)
	return a.Sections[0].Len
}

// A narrow (sub-word) GP register param must be re-extended in the func-value
// shim before the underlying native callee reads its full register — a foreign
// (LLVM) dispatch caller may leave the high bits dirty (abi/03 §3.3).  The
// re-extend is one extra instruction, so a narrow-param shim is strictly longer
// than the otherwise-identical word-size-param shim; if the fix regresses (the
// shim forwards the slot with a bare full-width move), the lengths match.  bool
// is included because it is the canonical 64-bit-TEST case yet SubWordNarrow
// reports it non-narrow — canonicalizeSubWordSeamX64 keys off SizeOf so it is
// extended too.
func TestFuncValueShimReextendsNarrowRegParamX64() testing.TestResult {
	var wide int = shimLenForParam1_x64(types.TypInt64())
	if shimLenForParam1_x64(types.TypInt8()) <= wide {
		return "int8 shim must re-extend the narrow reg param (longer than the int64 shim)"
	}
	if shimLenForParam1_x64(types.TypInt16()) <= wide {
		return "int16 shim must re-extend the narrow reg param (longer than the int64 shim)"
	}
	if shimLenForParam1_x64(types.TypInt32()) <= wide {
		return "int32 shim must re-extend the narrow reg param (longer than the int64 shim)"
	}
	if shimLenForParam1_x64(types.TypBool()) <= wide {
		return "bool shim must re-extend the narrow reg param (longer than the int64 shim)"
	}
	return ""
}

// shimDataForParam1_x64 emits the single-param func-value shim and returns its
// exact bytes.
func shimDataForParam1_x64(pty @types.Type) @[]uint8 {
	var mod @ir.Module = ir.NewModule("\"main\"")
	var p @ir.Param = make(ir.Param)
	p.Name = "x"
	p.Typ = pty
	var params @[]@ir.Param
	params = appendIrParam_spilltest_x64(params, p)
	var f @ir.Func = ir.NewFunc("", "f", params, scalarResult_spilltest_x64())
	f.IsLinkOnce = true
	mod.AddFunc(f)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitFuncValueShims(a, "main", mod)
	var out @[]uint8 = make_slice(uint8, a.Sections[0].Len)
	for i := 0; i < a.Sections[0].Len; i++ { out[i] = a.Sections[0].Data[i] }
	return out
}

// bytesEqual_x64 reports whether two byte slices are identical.
func bytesEqual_x64(x @[]uint8, y @[]uint8) bool {
	if len(x) != len(y) { return false }
	for i := 0; i < len(x); i++ {
		if x[i] != y[i] { return false }
	}
	return true
}

// The re-extend must honor the param's SIGNEDNESS (Movsx for int8 vs Movzx for
// uint8), not use a fixed extend.  The two shims are otherwise identical, so their
// bytes differ iff the extend's signedness differs; a regression to a fixed extend
// makes them equal.
func TestFuncValueShimNarrowExtendHonorsSignX64() testing.TestResult {
	var signed @[]uint8 = shimDataForParam1_x64(types.TypInt8())
	var unsigned @[]uint8 = shimDataForParam1_x64(types.TypUint8())
	if bytesEqual_x64(signed, unsigned) {
		return "int8 and uint8 shims must differ (Movsx vs Movzx) — extend must honor signedness"
	}
	return ""
}
