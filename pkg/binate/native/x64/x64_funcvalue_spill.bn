package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Genuine-overflow stack-spill path for the non-closure func-value shims
// (amd64 / SysV).  Reached from emitFuncValueShims when a func value's
// EFFECTIVE user-arg words exceed the register budget the tail-jump /
// register-only shapes can serve.  Mirrors emitClosureShimStackSpill_x64
// (the capturing-closure analogue), specialized to the no-captures case
// plus the func-value return shapes (scalar/void, sret, pack, float-ret).
//
// The shim is entered under the uniform all-int dispatch ABI: dispatch
// word g (g=0 is the leading data slot, or retbuf+data for the aggregate
// shapes) is in argReg(g) if g < 6, else on the dispatch CALLER's stack —
// at shim entry [rsp + 8 + (g-6)*8] (rsp+0 is the return address the
// dispatch caller's CALL pushed).  The shim re-marshals the user words
// into the underlying's real SysV layout (reg words shifted down by the
// dropped prefix; overflow words written to a reserved outgoing-args
// area), then CALLs (NOT tail-jumps — the frame must be torn down before
// RET) and tears the frame down.
//
// Clobber-safety of the reg shifts: every word shifts DOWN by a constant
// (srcPrefix - gpDestBase), so an outgoing reg R is read as an incoming
// source only at a strictly lower word index, already consumed when the
// marshal runs left-to-right.  RAX is the spill scratch (never an arg /
// sret / return-input reg during marshalling).
//
// A coerced-in-register struct/array (common.AggCoercedInReg) is the one
// arg whose words do NOT come from the incoming dispatch regs: it arrives
// as a SINGLE by-address pointer word (EffectiveArgWords == 1), and its
// common.ArgWords value-words are loaded from [pointer] into the outgoing
// coerced regs the underlying reads.  The pointer is copied to R10 (a
// caller-saved scratch, not a SysV arg / sret / return reg, and distinct
// from the RAX spill shuttle) before the value-word loads, so they can't
// clobber the base.  This is why the incoming and outgoing word counts
// DIVERGE for such an arg: the incoming cursor advances by 1 (one pointer
// word) while the outgoing placement consumes ArgWords coerced words.

// emitFuncvalSpillShim_x64 emits the over-budget func-value shim.  retSz
// is the single-result SizeOf (0 for void / multi-return scalar).  The
// shape flags are mutually consistent with emitFuncValueShims: at most one of
// usePack / useSret / smallMultiRet is set; isFloatRet only with none.  A
// smallMultiRet takes the same retbuf-save frame as usePack (retbuf stashed,
// user args marshalled at gpDestBase 0), but the post-CALL store through retbuf
// is the field-per-class helper (the callee returns the tuple field-per-register,
// not packed RAX(+RDX)).
func emitFuncvalSpillShim_x64(a @asm.Assembler, cc common.CallConv,
		fnLabel @[]char, fvTyp @types.Type, retSz int,
		usePack bool, useSret bool, isFloatRet bool, smallMultiRet bool) {
	var userTypes @[]@types.Type = shimUserTypes_x64(fvTyp)
	// A small multiret uses the same retbuf-save frame shape as pack (retbuf on
	// the frame, callee returns field-per-register, store through retbuf post-
	// CALL).  saveRetbuf covers both.
	var saveRetbuf bool = usePack || smallMultiRet
	// Incoming prefix words to skip: 1 (data) for scalar/void/float, 2
	// (retbuf + data) for the aggregate / small-multiret shapes.
	var srcPrefix int = 1
	if usePack || useSret || smallMultiRet { srcPrefix = 2 }
	// Outgoing GP base: 0 normally; 1 for sret, where RDI holds the sret
	// pointer and user args start at RSI.  The classifier runs with a
	// correspondingly reduced GP-reg file so overflow lands on the stack.  A
	// small multiret keeps gpDestBase 0 — retbuf is saved to the frame, not
	// passed to the callee (which returns field-per-register).
	var gpDestBase int = 0
	if useSret { gpDestBase = 1 }
	var ccOut common.CallConv = cc
	if gpDestBase > 0 {
		ccOut.NumGpArgRegs = cc.NumGpArgRegs - gpDestBase
	}
	var outBytes int = ccOut.CallStackBytes(userTypes)
	// Stage the incoming GP dispatch regs to the frame ONLY when a coerced
	// aggregate is present.  Such an arg makes the OUTGOING cursor (ArgWords
	// value-words) outrun the INCOMING by-address cursor (1 pointer), so an
	// outgoing reg write can land in a LATER param's not-yet-read incoming reg
	// (a register-permutation hazard); saving every incoming GP arg reg first,
	// then marshalling from the frame, removes it.  Without a coerced aggregate
	// incoming and outgoing advance in lockstep (a constant down-shift, since
	// the OUTGOING reg index never exceeds the incoming), already clobber-safe,
	// so the marshal reads live regs directly and the staging area is dropped.
	// Mirrors the register-only emitShimArgMarshal_x64's needStage.
	var needStage bool = shimHasCoercedAgg_x64(userTypes)
	// Frame layout (low→high): [0, outBytes) outgoing-args; [retbufOff, +8) the
	// pack-shape retbuf save; [stageOff, +NumGpArgRegs*8) the clobber-safe
	// staging area (present only when needStage).  frameDelta keeps rsp ≡ 0
	// mod 16 at the CALL: entry rsp ≡ 8, outBytes ≡ 0 mod 16, the +8 (retbuf
	// slot / alignment pad) makes it ≡ 8, and NumGpArgRegs*8 (= 48) ≡ 0.
	var retbufOff int = outBytes
	var stageOff int = outBytes + 8
	var frameDelta int = outBytes + 8
	if needStage { frameDelta = frameDelta + cc.NumGpArgRegs * 8 }

	x64.Sub(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(frameDelta))
	if needStage {
		// Stage every incoming GP dispatch reg before any outgoing write (the
		// marshal helpers then read register-source words from
		// [rsp + stageOff + 8*g]).
		for g := 0; g < cc.NumGpArgRegs; g++ {
			x64.Mov(a, x64.Mem(x64.RSP, stageOff + 8 * g, x64.SZ64),
				x64.Reg(argReg(g), x64.SZ64))
		}
	}
	if saveRetbuf {
		// Stash retbuf (RDI) above the outgoing-args area; the marshal
		// (gpDestBase 0) will overwrite RDI.
		x64.Mov(a, x64.Mem(x64.RSP, retbufOff, x64.SZ64),
			x64.Reg(x64.RDI, x64.SZ64))
	}
	emitSpillMarshal_x64(a, cc, ccOut, userTypes, srcPrefix, gpDestBase,
		frameDelta, stageOff, needStage)
	a.SetGlobal(fnLabel)
	x64.Call(a, fnLabel)
	if usePack {
		// The underlying's packed return is live in its return registers;
		// copy through the stashed retbuf (reloaded into R10, outside the
		// return regs).
		x64.Mov(a, x64.Reg(x64.R10, x64.SZ64),
			x64.Mem(x64.RSP, retbufOff, x64.SZ64))
		if cc.ReturnsSseInRegs(fvTyp.Results[0]) {
			// SSE aggregate: SSE eightbytes in XMM0/XMM1, INTEGER eightbytes
			// in RAX/RDX — collect by class, not RAX/RDX wholesale.
			emitSseReturnCollectTo(a, fvTyp.Results[0], x64.R10, 0)
		} else {
			x64.Mov(a, x64.Mem(x64.R10, 0, x64.SZ64),
				x64.Reg(x64.RAX, x64.SZ64))
			if retSz > 8 {
				x64.Mov(a, x64.Mem(x64.R10, 8, x64.SZ64),
					x64.Reg(x64.RDX, x64.SZ64))
			}
		}
	} else if smallMultiRet {
		// The callee returned the tuple FIELD-PER-REGISTER (RAX,RDX,RCX /
		// XMM0,XMM1); store it through the stashed retbuf (reloaded into R10,
		// outside the return regs).  R11 is the field float→GP scratch (not a
		// return reg, not R10 the base).
		x64.Mov(a, x64.Reg(x64.R10, x64.SZ64),
			x64.Mem(x64.RSP, retbufOff, x64.SZ64))
		storeMultiReturnTupleFields_x64(a, funcValMultiReturnTuple_x64(fvTyp),
			x64.R10, 0, x64.R11, cc.NumFpRetRegs)
	} else if isFloatRet {
		// The underlying returns the float in xmm0; the all-int dispatch
		// ABI expects the bits in rax.
		if common.FloatScalarIsI32(fvTyp.Results[0]) {
			x64.Movd_xmm_to_gp(a, x64.RAX, x64.XMM0)
		} else {
			x64.Movq_xmm_to_gp(a, x64.RAX, x64.XMM0)
		}
	}
	// sret: the underlying wrote the result through RDI=retbuf already.
	// scalar/void: the result is in RAX, preserved across the rewind.
	x64.Add(a, x64.Reg(x64.RSP, x64.SZ64), x64.Imm(frameDelta))
	x64.Ret(a)
}

// shimUserTypes_x64 extracts the func-value's parameter types into a
// @[]@types.Type the CallConv classifier consumes.
func shimUserTypes_x64(fvTyp @types.Type) @[]@types.Type {
	var ts @[]@types.Type
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		ts = appendTypePtr(ts, fvTyp.Params[pi].Type)
	}
	return ts
}

// emitSpillMarshal_x64 moves the user args from their incoming all-int
// dispatch positions into the underlying's SysV layout.  Incoming uses
// the FULL GP-reg file (cc); outgoing placement uses ccOut (reduced for
// sret) plus gpDestBase.  Float scalars peel to xmm[nsrn]; every other
// arg's effective words go to the classifier's reg / stack slots.
func emitSpillMarshal_x64(a @asm.Assembler, cc common.CallConv,
		ccOut common.CallConv, userTypes @[]@types.Type, srcPrefix int,
		gpDestBase int, frameDelta int, stageOff int, staged bool) {
	var nsrn int = 0
	var inWord int = 0
	for i := 0; i < len(userTypes); i++ {
		var pt @types.Type = userTypes[i]
		if common.IsFloatScalarTyp(pt) {
			if nsrn < cc.NumFpArgRegs {
				emitSpillSrcToXmm_x64(a, cc, srcPrefix + inWord,
					frameDelta, stageOff, x64.XMM0 + nsrn,
					common.FloatScalarIsI32(pt), staged)
			} else {
				// FP arg registers exhausted: the float overflows to the
				// underlying's outgoing-args stack (outBytes already reserved
				// the slot, since CallStackBytes now counts overflow floats).
				emitSpillSrcToMem_x64(a, cc, srcPrefix + inWord, frameDelta,
					stageOff, ccOut.CallArgStackOff(userTypes, i), staged)
			}
			nsrn = nsrn + 1
			inWord = inWord + 1
			continue
		}
		if common.AggCoercedInReg(pt) {
			emitSpillCoercedAgg_x64(a, cc, ccOut, userTypes, i, pt,
				srcPrefix + inWord, gpDestBase, frameDelta, stageOff, staged)
			// Incoming consumed ONE by-address pointer word; outgoing
			// placement advanced common.ArgWords coerced words inside the
			// helper.  These now DIVERGE, so the incoming cursor advances by
			// 1 even though the underlying read ArgWords value-words.
			inWord = inWord + 1
			continue
		}
		var w int = cc.EffectiveArgWords(pt)
		var rs int = ccOut.CallArgRegStart(userTypes, i)
		var so int = ccOut.CallArgStackOff(userTypes, i)
		var regWords int = 0
		if rs >= 0 {
			if so >= 0 {
				regWords = ccOut.NumGpArgRegs - rs
			} else {
				regWords = w
			}
		}
		for k := 0; k < regWords; k++ {
			emitSpillSrcToReg_x64(a, cc, srcPrefix + inWord + k,
				frameDelta, stageOff, argReg(gpDestBase + rs + k), staged)
		}
		for k := regWords; k < w; k++ {
			emitSpillSrcToMem_x64(a, cc, srcPrefix + inWord + k,
				frameDelta, stageOff, so + (k - regWords) * 8, staged)
		}
		inWord = inWord + w
	}
}

// shimHasCoercedAgg_x64 reports whether any user param is a coerced in-register
// struct/array — the only arg shape whose incoming (by-address, 1 word) and
// outgoing (ArgWords value-words) cursors diverge, which is what forces the
// spill marshal to stage the incoming GP regs (see emitFuncvalSpillShim_x64).
func shimHasCoercedAgg_x64(userTypes @[]@types.Type) bool {
	for i := 0; i < len(userTypes); i++ {
		if common.AggCoercedInReg(userTypes[i]) { return true }
	}
	return false
}

// emitSpillCoercedAgg_x64 marshals one coerced-in-register struct/array
// arg (common.AggCoercedInReg) from its incoming BY-ADDRESS representation
// into the underlying's real SysV layout.  Under the func-value dispatch
// convention such an arg arrives as a SINGLE pointer word (its
// EffectiveArgWords is 1) at incoming dispatch word `srcG`; the underlying
// reads common.ArgWords value-words coerced into consecutive GP regs (and,
// when the reg file is exhausted, the SysV MEMORY tail).  The helper loads
// the pointer into R10 — a caller-saved scratch that is neither a SysV arg
// reg (RDI/RSI/RDX/RCX/R8/R9) nor the sret/return reg nor the RAX spill
// shuttle, so the value-word loads can't clobber the base before the last
// word is read — then loads [R10 + 8*k] into the destinations ccOut's real-
// ABI classifier reports for arg i (regWords into argReg(gpDestBase+rs+k),
// the remainder to the outgoing-args stack via RAX).
// (staged is always true when this runs — a coerced aggregate is exactly what
// makes shimHasCoercedAgg_x64 / needStage true — but it is threaded through so
// emitSpillSrcToReg_x64 reads the pointer word from its staging slot.)
func emitSpillCoercedAgg_x64(a @asm.Assembler, cc common.CallConv,
		ccOut common.CallConv, userTypes @[]@types.Type, i int,
		pt @types.Type, srcG int, gpDestBase int, frameDelta int,
		stageOff int, staged bool) {
	var n int = common.ArgWords(pt)
	emitSpillSrcToReg_x64(a, cc, srcG, frameDelta, stageOff, x64.R10, staged)
	var rs int = ccOut.CallArgRegStart(userTypes, i)
	var so int = ccOut.CallArgStackOff(userTypes, i)
	var regWords int = 0
	if rs >= 0 {
		if so >= 0 {
			regWords = ccOut.NumGpArgRegs - rs
		} else {
			regWords = n
		}
	}
	for k := 0; k < regWords; k++ {
		x64.Mov(a, x64.Reg(argReg(gpDestBase + rs + k), x64.SZ64),
			x64.Mem(x64.R10, 8 * k, x64.SZ64))
	}
	for k := regWords; k < n; k++ {
		x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64),
			x64.Mem(x64.R10, 8 * k, x64.SZ64))
		x64.Mov(a, x64.Mem(x64.RSP, so + (k - regWords) * 8, x64.SZ64),
			x64.Reg(x64.RAX, x64.SZ64))
	}
}

// emitSpillSrcToReg_x64 moves incoming dispatch word g into dstReg.  A
// register-passed word (g < cc.NumGpArgRegs) is read from its staging slot
// [rsp + stageOff + 8*g] when `staged`, else straight from the live argReg(g)
// (safe without staging: the outgoing reg index never exceeds the incoming, so
// the source is untouched at read time).  An overflow word is read from the
// dispatch caller's stack at [rsp + frameDelta + 8 + (g-NumGpArgRegs)*8].
func emitSpillSrcToReg_x64(a @asm.Assembler, cc common.CallConv, g int,
		frameDelta int, stageOff int, dstReg int, staged bool) {
	if g < cc.NumGpArgRegs {
		if staged {
			x64.Mov(a, x64.Reg(dstReg, x64.SZ64),
				x64.Mem(x64.RSP, stageOff + 8 * g, x64.SZ64))
		} else if dstReg != argReg(g) {
			x64.Mov(a, x64.Reg(dstReg, x64.SZ64), x64.Reg(argReg(g), x64.SZ64))
		}
		return
	}
	var off int = frameDelta + 8 + (g - cc.NumGpArgRegs) * 8
	x64.Mov(a, x64.Reg(dstReg, x64.SZ64), x64.Mem(x64.RSP, off, x64.SZ64))
}

// emitSpillSrcToMem_x64 moves incoming dispatch word g to the outgoing-
// args stack at [rsp + dstOff].  A staged register word is read from its
// staging slot (see emitSpillSrcToReg_x64) via RAX; an un-staged live register
// word stores directly (no shuttle needed); an overflow word shuttles through
// RAX from the dispatch caller's stack.  The un-staged register-source case is
// defensive and currently unreachable: a register source only reaches the
// outgoing STACK via a coerced-aggregate straddle, which forces needStage/staged
// true, so without staging the down-shift keeps every register source in a
// register.  Keep it — dropping it would make a future reg→stack word read the
// unpopulated staging slot.
func emitSpillSrcToMem_x64(a @asm.Assembler, cc common.CallConv, g int,
		frameDelta int, stageOff int, dstOff int, staged bool) {
	if g < cc.NumGpArgRegs && !staged {
		x64.Mov(a, x64.Mem(x64.RSP, dstOff, x64.SZ64),
			x64.Reg(argReg(g), x64.SZ64))
		return
	}
	var off int = frameDelta + 8 + (g - cc.NumGpArgRegs) * 8
	if g < cc.NumGpArgRegs {
		off = stageOff + 8 * g
	}
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RSP, off, x64.SZ64))
	x64.Mov(a, x64.Mem(x64.RSP, dstOff, x64.SZ64),
		x64.Reg(x64.RAX, x64.SZ64))
}

// emitSpillSrcToXmm_x64 moves incoming dispatch word g (float bits in a
// GP slot under the all-int dispatch ABI) into xmm.  A staged / overflow word
// is loaded into RAX first (movq/movd take a GP source); an un-staged live
// register word moves straight from argReg(g).
func emitSpillSrcToXmm_x64(a @asm.Assembler, cc common.CallConv, g int,
		frameDelta int, stageOff int, xmm int, isI32 bool, staged bool) {
	var srcReg int = x64.RAX
	if g < cc.NumGpArgRegs && !staged {
		srcReg = argReg(g)
	} else {
		var off int = frameDelta + 8 + (g - cc.NumGpArgRegs) * 8
		if g < cc.NumGpArgRegs {
			off = stageOff + 8 * g
		}
		x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RSP, off, x64.SZ64))
	}
	if isI32 {
		x64.Movd_gp_to_xmm(a, xmm, srcReg)
	} else {
		x64.Movq_gp_to_xmm(a, xmm, srcReg)
	}
}
