package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for x64_funcvalue_spill.bn: a func value whose EFFECTIVE user-arg
// words exceed the register-only budget must route to the stack-spill
// shim and emit WITHOUT recording an assembler error.  Before Stage B
// these over-budget shapes called a.SetError ("unimplemented stack-spill
// path"); the regression these pin is that emission now succeeds (the
// emitted bytes' correctness is covered end-to-end by conformance 697 /
// 698 across the native lanes).

// Scalar return, 7 int64 user words > the x64 scalar budget (5): spills.
func TestFuncvalSpillWideScalarNoError() testing.TestResult {
	return wideShimEmits_x64(7, scalarResult_spilltest_x64())
}

// Sret return (24-byte struct > 16) with 7 int64 user words > the x64
// sret budget (4): spills, with retbuf held in RDI across the frame.
func TestFuncvalSpillWideSretNoError() testing.TestResult {
	return wideShimEmits_x64(7, structResult_spilltest_x64(3))
}

// Pack return (16-byte struct) with 7 int64 user words > the x64 pack
// budget (4): spills, with the packed return copied through the stashed
// retbuf.
func TestFuncvalSpillWidePackNoError() testing.TestResult {
	return wideShimEmits_x64(7, structResult_spilltest_x64(2))
}

// A by-address aggregate arg (a coerced-in-register struct, OR — option B — a
// raw slice) makes the spill STAGE the incoming GP regs (the needStage path); an
// all-scalar list does not (the marshal reads live regs).  shimHasByAddressAgg_x64
// is the gate emitFuncvalSpillShim_x64 keys that decision on.
func TestSpillNeedStagePredicate_x64() testing.TestResult {
	var cc common.CallConv = common.SysV_AMD64()
	var allInt @[]@types.Type = make_slice(@types.Type, 3)
	allInt[0] = types.TypInt64()
	allInt[1] = types.TypInt64()
	allInt[2] = types.TypInt64()
	if shimHasByAddressAgg_x64(cc, allInt) {
		return "all-int arg list must not need staging"
	}
	var withAgg @[]@types.Type = make_slice(@types.Type, 2)
	withAgg[0] = types.TypInt64()
	withAgg[1] = coercedStructTy_spilltest_x64()
	if !shimHasByAddressAgg_x64(cc, withAgg) {
		return "coerced-struct arg list must need staging"
	}
	var withSlice @[]@types.Type = make_slice(@types.Type, 2)
	withSlice[0] = types.TypInt64()
	withSlice[1] = types.MakeSliceType(types.TypInt64())
	if !shimHasByAddressAgg_x64(cc, withSlice) {
		return "raw-slice arg list must need staging (option B by-address)"
	}
	return ""
}

// A coerced-struct arg plus 7 ints (> the x64 scalar budget): the shim spills
// AND stages (needStage=true).  Emit must still succeed without error — the
// staged path's end-to-end correctness is covered by conformance 718 splitArg.
func TestFuncvalSpillCoercedAggStagesNoError_x64() testing.TestResult {
	var mod @ir.Module = ir.NewModule("\"main\"")
	var params @[]@ir.Param
	for i := 0; i < 7; i++ {
		var p @ir.Param = make(ir.Param)
		p.Name = "x"
		p.Typ = types.TypInt64()
		params = appendIrParam_spilltest_x64(params, p)
	}
	var ps @ir.Param = make(ir.Param)
	ps.Name = "s"
	ps.Typ = coercedStructTy_spilltest_x64()
	params = appendIrParam_spilltest_x64(params, ps)
	var f @ir.Func = ir.NewFunc("", "wideAgg", params, scalarResult_spilltest_x64())
	f.IsLinkOnce = true
	mod.AddFunc(f)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitFuncValueShims(a, "main", mod)
	if a.HasError {
		return "coerced-agg over-budget func value must not SetError (staged spill)"
	}
	if a.Sections[0].Len == 0 {
		return "coerced-agg over-budget func value must emit a shim"
	}
	return ""
}

// coercedStructTy_spilltest_x64 builds a 16-byte named 2-int struct — a
// coerced-in-register aggregate (AggCoercedInReg true).
func coercedStructTy_spilltest_x64() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var fa @types.Field = make(types.Field)
	fa.Type = types.TypInt64()
	fields[0] = fa
	var fb @types.Field = make(types.Field)
	fb.Type = types.TypInt64()
	fields[1] = fb
	return types.MakeStructType("S16_spilltest_x64", fields)
}

// wideShimEmits_x64 builds a single IsLinkOnce func with nParams int64
// params and the given result, runs the shim emitter, and asserts the
// over-budget func value emitted a non-empty shim without error.
func wideShimEmits_x64(nParams int, result @[]@types.Type) testing.TestResult {
	var mod @ir.Module = ir.NewModule("\"main\"")
	var params @[]@ir.Param
	for i := 0; i < nParams; i++ {
		var p @ir.Param = make(ir.Param)
		p.Name = "x"
		p.Typ = types.TypInt64()
		params = appendIrParam_spilltest_x64(params, p)
	}
	var f @ir.Func = ir.NewFunc("", "wide", params, result)
	f.IsLinkOnce = true
	mod.AddFunc(f)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitFuncValueShims(a, "main", mod)
	if a.HasError {
		return "over-budget func value must not SetError (spill path)"
	}
	if a.Sections[0].Len == 0 {
		return "over-budget func value must emit a shim"
	}
	return ""
}

// scalarResult_spilltest_x64 builds the result list for an int64-returning
// func value (a single scalar result).
func scalarResult_spilltest_x64() @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, 1)
	r[0] = types.TypInt64()
	return r
}

// structResult_spilltest_x64 builds the result list for a func value
// returning an n-int64 struct (8*n bytes: n=2 → 16 B pack shape, n=3 →
// 24 B sret shape).
func structResult_spilltest_x64(n int) @[]@types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		var fld @types.Field = make(types.Field)
		fld.Type = types.TypInt64()
		fields[i] = fld
	}
	var r @[]@types.Type = make_slice(@types.Type, 1)
	r[0] = types.MakeStructType("", fields)
	return r
}

// appendIrParam_spilltest_x64 appends a @ir.Param to a @[]@ir.Param.
func appendIrParam_spilltest_x64(dst @[]@ir.Param, v @ir.Param) @[]@ir.Param {
	var n int = len(dst)
	var ns @[]@ir.Param = make_slice(@ir.Param, n + 1)
	for i := 0; i < n; i++ { ns[i] = dst[i] }
	ns[n] = v
	return ns
}

// Gate-forced-on tests for emitSpillByAddressAgg_x64's SSE branch — dormant on x64
// via cc.SseAggregates, forced true here to exercise the register placement the
// Step-6 flip depends on.  Reuses sseMkAsm / hasPair / struct2t / asmTextEq from
// x64_sse_test.bn (same package).  The frameDelta/stageOff args (64/0) only shape
// the R10-pointer load offset; the assertions pin the by-class expansion.

// sseSpillCc returns a SysV-AMD64 CallConv with the SSE gate forced on.
func sseSpillCc() common.CallConv {
	var cc common.CallConv = common.SysV_AMD64()
	cc.SseAggregates = true
	return cc
}

// A mixed {f64,i64} SSE aggregate in the spill shim expands into XMM (MOVLPS,
// 0F 12) for the double eightbyte and a GP arg reg (MOV r,r/m 64-bit = 49 8B,
// argReg(gpDestBase+rs) = RDI) for the i64 eightbyte, returning nsrn+1.
func TestSpillCoercedAggSseMixed() testing.TestResult {
	var a @asm.Assembler = sseMkAsm()
	var cc common.CallConv = sseSpillCc()
	var di @types.Type = struct2t("DI", types.TypFloat64(), types.TypInt64())
	var ut @[]@types.Type = make_slice(@types.Type, 1)
	ut[0] = di
	var ns int = emitSpillByAddressAgg_x64(a, cc, cc, ut, 0, di, 0, 0, 64, 0, true, 0)
	if ns != 1 { return "{f64,i64} spill arg must advance nsrn by 1" }
	if !hasPair(a, 0x0F, 0x12) { return "{f64,i64} spill: double must MOVLPS into XMM" }
	if !hasPair(a, 0x49, 0x8B) { return "{f64,i64} spill: i64 must MOV into a GP reg (49 8B)" }
	return ""
}

// The threaded nsrn is honoured: emitSpillByAddressAgg_x64 returns the incoming
// nsrn plus the SSE-eightbyte count (1 for mixed DI, 2 for pure D2), so
// emitSpillMarshal_x64's XMM cursor advances in step with ccOut for later args.
func TestSpillCoercedAggSseNsrnThreaded() testing.TestResult {
	var cc common.CallConv = sseSpillCc()
	var di @types.Type = struct2t("DI", types.TypFloat64(), types.TypInt64())
	var utDI @[]@types.Type = make_slice(@types.Type, 1)
	utDI[0] = di
	var a0 @asm.Assembler = sseMkAsm()
	if emitSpillByAddressAgg_x64(a0, cc, cc, utDI, 0, di, 0, 0, 64, 0, true, 5) != 6 {
		return "mixed DI must return nsrn+1 (5 -> 6)"
	}
	var d2 @types.Type = struct2t("D2", types.TypFloat64(), types.TypFloat64())
	var utD2 @[]@types.Type = make_slice(@types.Type, 1)
	utD2[0] = d2
	var a1 @asm.Assembler = sseMkAsm()
	if emitSpillByAddressAgg_x64(a1, cc, cc, utD2, 0, d2, 0, 0, 64, 0, true, 5) != 7 {
		return "pure D2 must return nsrn+2 (5 -> 7)"
	}
	return ""
}

// gpDestBase reaches the INTEGER eightbyte's GP destination: emitting a mixed DI
// with gpDestBase 0 (INTEGER -> RDI) vs the sret shape gpDestBase 1 + ccOut's
// reduced GP file (INTEGER -> RSI) must produce different bytes.
func TestSpillCoercedAggSseSretGpBase() testing.TestResult {
	var cc common.CallConv = sseSpillCc()
	var di @types.Type = struct2t("DI", types.TypFloat64(), types.TypInt64())
	var ut @[]@types.Type = make_slice(@types.Type, 1)
	ut[0] = di
	var a0 @asm.Assembler = sseMkAsm()
	emitSpillByAddressAgg_x64(a0, cc, cc, ut, 0, di, 0, 0, 64, 0, true, 0)
	var ccSret common.CallConv = cc
	ccSret.NumGpArgRegs = cc.NumGpArgRegs - 1
	var a1 @asm.Assembler = sseMkAsm()
	emitSpillByAddressAgg_x64(a1, cc, ccSret, ut, 0, di, 0, 1, 64, 0, true, 0)
	if asmTextEq(a0, a1) {
		return "gpDestBase 0 vs 1 (sret) must change the INTEGER eightbyte's GP dest"
	}
	return ""
}
