package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// emitFuncValueShims / emitFuncValueVtables on a module with no
// OP_FUNC_VALUE / OP_FUNC_HANDLE refs should be no-ops.  Pin both
// the shim emitter and the vtable emitter individually so a
// regression that always-emits something gets caught.
func TestEmitFuncValueShimsEmptyNoOp() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var mod @ir.Module = ir.NewModule("\"main\"")
	emitFuncValueShims(a, "main", mod)
	if a.Sections[0].Len != 0 {
		return "empty module should produce no shims"
	}
	return ""
}

func TestEmitFuncValueVtablesEmptyNoOp() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var mod @ir.Module = ir.NewModule("\"main\"")
	emitFuncValueVtables(a, "main", mod)
	if a.Sections[0].Len != 0 {
		return "empty module should produce no vtables"
	}
	return ""
}

// shimSymFor_x64 / vtableSymFor_x64 / handleSymFor_x64 build
// composable, well-formed symbol names.  Pin the suffix conventions
// — a regression that swaps __shim and __vt would silently break
// the dispatch wiring.
func TestFuncValueSymbolSuffixes() testing.TestResult {
	var shim @[]char = shimSymFor_x64("main", "add")
	if !endsWithFV(shim, "__shim") {
		return "shimSymFor_x64 must end with __shim"
	}
	var vt @[]char = vtableSymFor_x64("main", "add")
	if !endsWithFV(vt, "__vt") {
		return "vtableSymFor_x64 must end with __vt"
	}
	var h @[]char = handleSymFor_x64("main", "add")
	if !containsFV(h, "__handle.") {
		return "handleSymFor_x64 must contain __handle."
	}
	return ""
}

// collectFuncValueRefs must include every locally-defined
// IsLinkOnce function (dtors + copy helpers from gen_dtor_emit /
// gen_copy_emit) in seen[] regardless of OP_FUNC_HANDLE refs —
// the defining TU emits the __vt/__handle/__shim triplet for
// them, and consumer TUs skip via lookupFuncValueType_x64's
// IsExtern gate.  Mirrors aa64's fix from binate 94b75294;
// without the pre-pass, the Mach-O linker errors on duplicate
// `_<dtor>__vt` symbols when several pkg/<X>.o link together.
func TestCollectFuncValueRefsIncludesLocalIsLinkOnce() testing.TestResult {
	var mod @ir.Module = ir.NewModule("\"main\"")
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("__dtor_T", noP, noR)
	f.IsLinkOnce = true
	mod.AddFunc(f)
	var seen @[]@[]char
	var ignored @[]@types.Type
	seen, ignored = collectFuncValueRefs(mod)
	if len(seen) != 1 {
		return "expected pre-pass to add local IsLinkOnce func to seen[]"
	}
	return ""
}

// lookupFuncValueType_x64 must return nil for IsExtern entries
// (cross-pkg dtor/copy imports via gen_import.bn:NewExternFunc).
// Returning non-nil here would cause emitFuncValueShims to re-emit
// the triplet locally — duplicating the defining TU's emission
// and breaking Mach-O strict-symbol link.
func TestLookupFuncValueTypeSkipsExtern() testing.TestResult {
	var mod @ir.Module = ir.NewModule("\"main\"")
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var ef @ir.Func = ir.NewExternFunc("ext_dtor", noP, noR)
	mod.AddFunc(ef)
	var sigTyp @types.Type = lookupFuncValueType_x64(mod, ef.Name)
	if sigTyp != nil {
		return "lookup must return nil for extern entries (defining TU emits triplet)"
	}
	return ""
}

// endsWithFV reports whether `s` ends with suffix `suf`.
func endsWithFV(s @[]char, suf *[]readonly char) bool {
	if len(s) < len(suf) { return false }
	var off int = len(s) - len(suf)
	for i := 0; i < len(suf); i++ {
		if s[off + i] != suf[i] { return false }
	}
	return true
}

// containsFV reports whether `s` contains `needle`.
func containsFV(s @[]char, needle *[]readonly char) bool {
	if len(needle) == 0 { return true }
	for i := 0; i + len(needle) <= len(s); i++ {
		var match bool = true
		for j := 0; j < len(needle); j++ {
			if s[i + j] != needle[j] {
				match = false
				break
			}
		}
		if match { return true }
	}
	return false
}
