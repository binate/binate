package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Function-value backing-global emission for the x64 native backend: the
// per-function vtable + LLVM-shape handle each OP_FUNC_VALUE / OP_FUNC_HANDLE
// reference needs.  The byte layout is built once by irdata.BuildFuncValue (shared
// with the LLVM + aarch64 backends, lowered through common.EmitDataGlobal — so
// the three cannot drift); this gather only resolves the x64 symbol names + the
// closure-struct dtor handle, and marks the referenced shim / dtor-handle
// symbols global so their relocations resolve.  The shim-naming helpers
// (shimSymFor_x64 etc.) live in x64_funcvalue.bn (which keeps the shim CODE
// emission), shared across the package.
//
//   <mangled-fn>__vt           ; weak vtable: { dtor (null|closure-dtor handle),
//                              ;               call (shim) }
//   ___handle.<mangled-fn>     ; weak LLVM-shape handle: { vtable, data=null }
func emitFuncValueVtables(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	var seen @[]@[]char
	var ignored @[]@types.Type
	seen, ignored = collectFuncValueRefs(mod)
	if len(ignored) > 0 || len(seen) == 0 {
		// `ignored` silences the unused-var warning; sigs aren't needed here.
	}
	if len(seen) == 0 { return }
	for i := 0; i < len(seen); i++ {
		var vtLabel @[]char = vtableSymFor_x64(pkgName, seen[i])
		var shimLabel @[]char = shimSymFor_x64(pkgName, seen[i])
		var handleLabel @[]char = handleSymFor_x64(pkgName, seen[i])
		// Mark the call-slot target (the shim) global so its relocation
		// resolves; funcValueDtorHandleSym_x64 does the same for the dtor
		// handle and returns it (empty -> a null dtor slot).
		a.SetGlobal(shimLabel)
		var dtorSym @[]char = funcValueDtorHandleSym_x64(a, pkgName, mod, seen[i])
		var dgs @[]@irdata.DataGlobal = irdata.BuildFuncValue(vtLabel, dtorSym, shimLabel, handleLabel)
		for j := 0; j < len(dgs); j++ {
			common.EmitDataGlobal(a, dgs[j])
		}
	}
}

// funcValueDtorHandleSym_x64 returns the closure-struct dtor's HANDLE symbol
// for a capturing @func whose struct needs destruction (and marks it global so
// its relocation resolves), else an empty slice -> the vtable's dtor slot is a
// null pointer.  Slot 0 carries the dtor's HANDLE (not a raw fn pointer)
// because OP_FUNC_VALUE_DTOR dispatches it via `handle.vtable.call(handle.data,
// ptr)`.  The referenced `___handle.<dtor>` triple is emitted by
// collectFuncValueRefs's IsLinkOnce pre-pass; handleSymFor_x64(pkgName,
// f.ClosureStructDtorName) names exactly that triple (mangle.FuncName folds the
// same-package qualifier so the unqualified dtor name and the pre-pass's
// qualified f.Name resolve to one symbol).  Mirrors the aarch64 sibling.
func funcValueDtorHandleSym_x64(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module,
		qname *[]readonly char) @[]char {
	var f @ir.Func = lookupClosureFunc_x64(mod, qname)
	if f == nil || !f.IsManagedFuncValue || f.ClosureStruct == nil ||
			!f.ClosureStruct.NeedsDestruction() || len(f.ClosureStructDtorName) == 0 {
		var none @[]char
		return none
	}
	var h @[]char = handleSymFor_x64(pkgName, f.ClosureStructDtorName)
	a.SetGlobal(h)
	return h
}
