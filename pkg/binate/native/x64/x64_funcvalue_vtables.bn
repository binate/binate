package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"

// Function-value backing-global emission for the x64 native backend: the
// per-function vtable + LLVM-shape handle each OP_FUNC_VALUE / OP_FUNC_HANDLE
// reference needs.  Split from x64_funcvalue.bn (which keeps the shim
// emission) to stay under the hygiene file-length cap; the shim-naming
// helpers (shimSymFor_x64 etc.) and emitQuadLabelFV live there and are shared
// across the package.

// emitFuncValueVtables walks the module for OP_FUNC_VALUE /
// OP_FUNC_HANDLE references and emits the per-function backing
// globals each one needs:
//
//   _bn_<pkg>__<fn>__vt           ; vtable, weak.
//                                ;   .quad 0                ; dtor
//                                ;   .quad <shim label>     ; call
//   ___handle.bn_<pkg>__<fn>     ; LLVM-shape handle, weak.
//                                ;   .quad <vt label>       ; vtable
//                                ;   .quad 0                ; data
func emitFuncValueVtables(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	var seen @[]@[]char
	var ignored @[]@types.Type
	seen, ignored = collectFuncValueRefs(mod)
	if len(ignored) > 0 || len(seen) == 0 {
		// `ignored` silences the unused-var warning; sigs aren't
		// needed for vtable emit.
	}
	if len(seen) == 0 { return }
	a.SetSection("data", -1)
	for i := 0; i < len(seen); i++ {
		var vtLabel @[]char = vtableSymFor_x64(pkgName, seen[i])
		var shimLabel @[]char = shimSymFor_x64(pkgName, seen[i])
		a.DefineLabel(vtLabel)
		a.SetWeak(vtLabel)
		a.SetGlobal(shimLabel)
		// dtor slot.  Null for the *func form and non-capturing
		// literals; for a capturing @func whose closure struct needs
		// destruction, a pointer to the closure-struct dtor's HANDLE so
		// the @func variable's scope-end RefDec releases each managed
		// capture before freeing the struct.  See the aarch64 sibling
		// (emitFuncValueVtableDtorSlot) for the full rationale and the
		// symbol-convergence argument.
		emitFuncValueVtableDtorSlot_x64(a, pkgName, mod, seen[i])
		// call slot: pointer to shim.
		emitQuadLabelFV(a, shimLabel)

		// Phase 4 handle global — points at vtable; data slot is
		// null (non-capturing).  Weak (N_WEAK_DEF on Mach-O,
		// STB_WEAK on ELF) so an LLVM-emitted dep that exports the
		// same symbol gets deduped by the linker.
		var handleLabel @[]char = handleSymFor_x64(pkgName, seen[i])
		a.DefineLabel(handleLabel)
		a.SetWeak(handleLabel)
		emitQuadLabelFV(a, vtLabel)
		a.Fill(8, cast(uint8, 0))
	}
}

// emitFuncValueVtableDtorSlot_x64 writes the 8-byte dtor slot (slot 0)
// of the function value vtable for `qname`: a pointer to the closure-
// struct dtor's HANDLE for a capturing @func whose struct needs
// destruction, else 8 zero bytes.  Slot 0 carries the dtor's HANDLE
// (not a raw fn pointer) because OP_FUNC_VALUE_DTOR dispatches it via
// `handle.vtable.call(handle.data, ptr)`.  The referenced
// `___handle.<dtor>` triple is emitted by collectFuncValueRefs's
// IsLinkOnce pre-pass; handleSymFor_x64(pkgName, f.ClosureStructDtorName)
// names exactly that triple (mangle.FuncName folds the same-package
// qualifier so the unqualified dtor name and the pre-pass's qualified
// f.Name resolve to one symbol).  Mirrors the aarch64 sibling.
func emitFuncValueVtableDtorSlot_x64(a @asm.Assembler,
		pkgName *[]readonly char, mod @ir.Module, qname @[]char) {
	var f @ir.Func = lookupClosureFunc_x64(mod, qname)
	if f == nil || !f.IsManagedFuncValue || f.ClosureStruct == nil ||
			!f.ClosureStruct.NeedsDestruction() ||
			len(f.ClosureStructDtorName) == 0 {
		a.Fill(8, cast(uint8, 0))
		return
	}
	var h @[]char = handleSymFor_x64(pkgName, f.ClosureStructDtorName)
	a.SetGlobal(h)
	emitQuadLabelFV(a, h)
}
