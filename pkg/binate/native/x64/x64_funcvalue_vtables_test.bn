package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/builtins/testing"

// emitFuncValueVtables on a module with no OP_FUNC_VALUE /
// OP_FUNC_HANDLE refs should be a no-op — pin it so a regression that
// always-emits a vtable gets caught.
func TestEmitFuncValueVtablesEmptyNoOp() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var mod @ir.Module = ir.NewModule("\"main\"")
	emitFuncValueVtables(a, "main", mod)
	if a.Sections[0].Len != 0 {
		return "empty module should produce no vtables"
	}
	return ""
}
