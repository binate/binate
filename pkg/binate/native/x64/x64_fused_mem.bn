package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// Fused-address load/store: when an OP_GET_FIELD_PTR's sole use is a load/store
// address and its base is a register OR an alloca, the GEP is elided
// (FusableFieldGeps) and its consuming access rederives the address in the
// memory operand's constant displacement (`[base + FieldByteOffset]`, or
// `[rsp + allocaOffset + FieldByteOffset]` for an alloca base) instead of a
// separate LEA.

// emitFusedFieldLoad emits `mov rd, [base + FieldByteOffset]` for a GP scalar
// field whose address GEP was folded — reading the base from the GEP's own
// operand.  An alloca base folds allocaOffset+fieldOffset into an RSP-relative
// access (no standalone LEA).  emitScalarLoad size-dispatches (MOVZX/MOVSX/MOV)
// and builds the x64.Mem displacement; x64's 32-bit displacement holds any
// combined offset.
func emitFusedFieldLoad(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr, gep @ir.Instr) {
	var off int
	var ok bool
	off, ok = common.FieldByteOffset(gep, 8)
	if !ok { return }
	var sz int = 8
	if ins.Typ != nil { sz = ins.Typ.SizeOf() }
	if sz <= 0 { sz = 8 }
	var sgnTyp @types.Type = types.StripWrappers(ins.Typ)
	var signed bool = sgnTyp != nil && sgnTyp.Signed
	var allocOff int = rm.LookupAlloc(gep.Args[0].ID)
	if allocOff >= 0 {
		var rd int = nextReg(rm, ins.ID)
		emitScalarLoad(a, rd, x64.RSP, allocOff + off, sz, signed)
		return
	}
	var base int = getOperand(a, rm, gep.Args[0].ID)
	if base < 0 { return }
	var rd int = nextReg(rm, ins.ID)
	emitScalarLoad(a, rd, base, off, sz, signed)
}

// emitFusedFieldStore is the store analogue: `mov [base + FieldByteOffset], val`
// (`mov [rsp + allocaOffset + FieldByteOffset], val` for an alloca base).  The
// value is resolved first (matching the plain store path), then the base.
func emitFusedFieldStore(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		ins @ir.Instr, gep @ir.Instr) {
	var off int
	var ok bool
	off, ok = common.FieldByteOffset(gep, 8)
	if !ok { return }
	var valReg int = emitValOperand(a, pkgName, rm, ins.Args[1])
	if valReg < 0 { return }
	var sz int = 8
	if ins.Args[1].Typ != nil { sz = ins.Args[1].Typ.SizeOf() }
	if sz <= 0 { sz = 8 }
	var allocOff int = rm.LookupAlloc(gep.Args[0].ID)
	if allocOff >= 0 {
		emitScalarStore(a, valReg, x64.RSP, allocOff + off, sz)
		return
	}
	var base int = getOperand(a, rm, gep.Args[0].ID)
	if base < 0 { return }
	emitScalarStore(a, valReg, base, off, sz)
}
