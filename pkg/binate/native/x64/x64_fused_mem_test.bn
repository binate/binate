package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Emit-level tests for the fused field load/store (x64_fused_mem.bn): the folded
// GEP is elided and the load/store rederives the address as [base + offset] —
// one instruction, byte-identical to a direct emitScalarLoad/Store at that
// offset (not the un-fused LEA + MOV).

func ffMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func ffBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// ffTarget64 pins the LP64 target so FieldOffset({int,int}, 1) == 8.
func ffTarget64() {
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	types.SetTarget(t)
}

// ffTwoIntStruct builds `struct { f0 int; f1 int }` — field 1 is at byte offset
// 8 on LP64, the offset the fused field load/store must encode.
func ffTwoIntStruct() @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 2)
	var a @types.Field = make(types.Field)
	a.Name = "f0"
	a.Type = types.TypInt()
	var b @types.Field = make(types.Field)
	b.Name = "f1"
	b.Type = types.TypInt()
	fs[0] = a
	fs[1] = b
	return types.MakeStructType("S", fs)
}

// ffFieldGep builds an OP_GET_FIELD_PTR for field 1 of {int,int} off a register
// base value (id 100).
func ffFieldGep() @ir.Instr {
	var base @ir.Instr = make(ir.Instr)
	base.ID = 100
	base.Typ = types.MakePointerType(ffTwoIntStruct())
	var gep @ir.Instr = make(ir.Instr)
	gep.ID = 101
	gep.Op = iropcode.OP_GET_FIELD_PTR
	gep.Index = 1
	gep.Typ = types.MakePointerType(types.TypInt())
	gep.Args = ir.MakeArgs1(base)
	return gep
}

// A fused field GEP load is one MOV at [base + 8], byte-identical to a direct
// emitScalarLoad at that offset (not the un-fused LEA + MOV).
func TestEmitFusedFieldLoadFoldsOffset() testing.TestResult {
	ffTarget64()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// base (id 100) homed to RBX; load result (id 102) homed to R12.
	m.HomeIDs = common.AppendInt(m.HomeIDs, 100)
	m.HomeRegs = common.AppendInt(m.HomeRegs, x64.RBX)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 102)
	m.HomeRegs = common.AppendInt(m.HomeRegs, x64.R12)

	var gep @ir.Instr = ffFieldGep()
	var ld @ir.Instr = make(ir.Instr)
	ld.ID = 102
	ld.Op = iropcode.OP_LOAD
	ld.Typ = types.TypInt()
	ld.Args = ir.MakeArgs1(gep)

	emitFusedFieldLoad(a, m, ld, gep)
	var n int = ffBytes(a)
	if n == 0 { return "fused field load emitted nothing" }

	var ref @asm.Assembler = ffMkAsm()
	emitScalarLoad(ref, x64.R12, x64.RBX, 8, 8, false)
	if ffBytes(ref) != n { return "fused field load byte count must match MOV R12,[RBX+8]" }
	var k int = 0
	for k = 0; k < n; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "fused field load must equal MOV R12,[RBX+8]"
		}
	}
	return ""
}

// The store analogue: one MOV at [base + 8].
func TestEmitFusedFieldStoreFoldsOffset() testing.TestResult {
	ffTarget64()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// base (id 100) homed to RBX; stored value (id 103) homed to R13.
	m.HomeIDs = common.AppendInt(m.HomeIDs, 100)
	m.HomeRegs = common.AppendInt(m.HomeRegs, x64.RBX)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 103)
	m.HomeRegs = common.AppendInt(m.HomeRegs, x64.R13)

	var gep @ir.Instr = ffFieldGep()
	var val @ir.Instr = make(ir.Instr)
	val.ID = 103
	val.Typ = types.TypInt()
	var storeIns @ir.Instr = make(ir.Instr)
	storeIns.ID = 104
	storeIns.Op = iropcode.OP_STORE
	storeIns.Args = ir.MakeArgs2(gep, val)

	emitFusedFieldStore(a, "main", m, storeIns, gep)
	var n int = ffBytes(a)
	if n == 0 { return "fused field store emitted nothing" }

	var ref @asm.Assembler = ffMkAsm()
	emitScalarStore(ref, x64.R13, x64.RBX, 8, 8)
	if ffBytes(ref) != n { return "fused field store byte count must match MOV [RBX+8],R13" }
	var k int = 0
	for k = 0; k < n; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "fused field store must equal MOV [RBX+8],R13"
		}
	}
	return ""
}
