package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Emit-level tests for the fused field load/store (x64_fused_mem.bn): the folded
// GEP is elided and the load/store rederives the address as [base + offset] —
// one instruction, byte-identical to a direct emitScalarLoad/Store at that
// offset (not the un-fused LEA + MOV).

func ffMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func ffBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// ffTarget64 pins the LP64 target so FieldOffset({int,int}, 1) == 8.
func ffTarget64() {
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	types.SetTarget(t)
}

// ffTwoIntStruct builds `struct { f0 int; f1 int }` — field 1 is at byte offset
// 8 on LP64, the offset the fused field load/store must encode.
func ffTwoIntStruct() @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 2)
	var a @types.Field = make(types.Field)
	a.Name = "f0"
	a.Type = types.TypInt()
	var b @types.Field = make(types.Field)
	b.Name = "f1"
	b.Type = types.TypInt()
	fs[0] = a
	fs[1] = b
	return types.MakeStructType("S", fs)
}

// ffFieldGep builds an OP_GET_FIELD_PTR for field 1 of {int,int} off a register
// base value (id 100).
func ffFieldGep() @ir.Instr {
	var base @ir.Instr = make(ir.Instr)
	base.ID = 100
	base.Typ = types.MakePointerType(ffTwoIntStruct())
	var gep @ir.Instr = make(ir.Instr)
	gep.ID = 101
	gep.Op = iropcode.OP_GET_FIELD_PTR
	gep.Index = 1
	gep.Typ = types.MakePointerType(types.TypInt())
	gep.Args = irbuild.MakeArgs1(base)
	return gep
}

// ffAllocaFieldGep builds an OP_GET_FIELD_PTR for field 1 of {int,int} off an
// OP_ALLOC base value (id 100) — the alloca-base fold target.
func ffAllocaFieldGep() @ir.Instr {
	var base @ir.Instr = make(ir.Instr)
	base.ID = 100
	base.Op = iropcode.OP_ALLOC
	base.Typ = types.MakePointerType(ffTwoIntStruct())
	var gep @ir.Instr = make(ir.Instr)
	gep.ID = 101
	gep.Op = iropcode.OP_GET_FIELD_PTR
	gep.Index = 1
	gep.Typ = types.MakePointerType(types.TypInt())
	gep.Args = irbuild.MakeArgs1(base)
	return gep
}

// A fused field GEP load is one MOV at [base + 8], byte-identical to a direct
// emitScalarLoad at that offset (not the un-fused LEA + MOV).
func TestEmitFusedFieldLoadFoldsOffset() testing.TestResult {
	ffTarget64()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	// base (id 100) homed to RBX; load result (id 102) homed to R12.
	m.HomeIDs = common.AppendInt(m.HomeIDs, 100)
	m.HomeRegs = common.AppendInt(m.HomeRegs, x64.RBX)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 102)
	m.HomeRegs = common.AppendInt(m.HomeRegs, x64.R12)

	var gep @ir.Instr = ffFieldGep()
	var ld @ir.Instr = make(ir.Instr)
	ld.ID = 102
	ld.Op = iropcode.OP_LOAD
	ld.Typ = types.TypInt()
	ld.Args = irbuild.MakeArgs1(gep)

	emitFusedFieldLoad(a, m, ld, gep)
	var n int = ffBytes(a)
	if n == 0 { return "fused field load emitted nothing" }

	var ref @asm.Assembler = ffMkAsm()
	emitScalarLoad(ref, x64.R12, x64.RBX, 8, 8, false)
	if ffBytes(ref) != n { return "fused field load byte count must match MOV R12,[RBX+8]" }
	var k int = 0
	for k = 0; k < n; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "fused field load must equal MOV R12,[RBX+8]"
		}
	}
	return ""
}

// The store analogue: one MOV at [base + 8].
func TestEmitFusedFieldStoreFoldsOffset() testing.TestResult {
	ffTarget64()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	// base (id 100) homed to RBX; stored value (id 103) homed to R13.
	m.HomeIDs = common.AppendInt(m.HomeIDs, 100)
	m.HomeRegs = common.AppendInt(m.HomeRegs, x64.RBX)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 103)
	m.HomeRegs = common.AppendInt(m.HomeRegs, x64.R13)

	var gep @ir.Instr = ffFieldGep()
	var val @ir.Instr = make(ir.Instr)
	val.ID = 103
	val.Typ = types.TypInt()
	var storeIns @ir.Instr = make(ir.Instr)
	storeIns.ID = 104
	storeIns.Op = iropcode.OP_STORE
	storeIns.Args = irbuild.MakeArgs2(gep, val)

	emitFusedFieldStore(a, "main", m, storeIns, gep)
	var n int = ffBytes(a)
	if n == 0 { return "fused field store emitted nothing" }

	var ref @asm.Assembler = ffMkAsm()
	emitScalarStore(ref, x64.R13, x64.RBX, 8, 8)
	if ffBytes(ref) != n { return "fused field store byte count must match MOV [RBX+8],R13" }
	var k int = 0
	for k = 0; k < n; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "fused field store must equal MOV [RBX+8],R13"
		}
	}
	return ""
}

// An alloca-base fused field load is one MOV at [rsp + allocOff + 8] — the
// alloca offset (32) and field offset (8) folded into the displacement, no LEA.
func TestEmitFusedFieldLoadAllocaBaseFoldsOffset() testing.TestResult {
	ffTarget64()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	// alloca base (id 100) at frame offset 32; load result (id 102) homed to R12.
	m.AllocIDs = common.AppendInt(m.AllocIDs, 100)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 32)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 16)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 102)
	m.HomeRegs = common.AppendInt(m.HomeRegs, x64.R12)

	var gep @ir.Instr = ffAllocaFieldGep()
	var ld @ir.Instr = make(ir.Instr)
	ld.ID = 102
	ld.Op = iropcode.OP_LOAD
	ld.Typ = types.TypInt()
	ld.Args = irbuild.MakeArgs1(gep)

	emitFusedFieldLoad(a, m, ld, gep)
	var n int = ffBytes(a)
	if n == 0 { return "alloca-base fused field load emitted nothing" }

	var ref @asm.Assembler = ffMkAsm()
	emitScalarLoad(ref, x64.R12, x64.RSP, 40, 8, false)
	if ffBytes(ref) != n { return "alloca-base fused load byte count must match MOV R12,[RSP+40]" }
	var k int = 0
	for k = 0; k < n; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "alloca-base fused load must equal MOV R12,[RSP+40] (no LEA)"
		}
	}
	return ""
}

// The alloca-base store analogue: one MOV at [rsp + allocOff + 8].
func TestEmitFusedFieldStoreAllocaBaseFoldsOffset() testing.TestResult {
	ffTarget64()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	// alloca base (id 100) at frame offset 32; stored value (id 103) homed to R13.
	m.AllocIDs = common.AppendInt(m.AllocIDs, 100)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 32)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 16)
	m.HomeIDs = common.AppendInt(m.HomeIDs, 103)
	m.HomeRegs = common.AppendInt(m.HomeRegs, x64.R13)

	var gep @ir.Instr = ffAllocaFieldGep()
	var val @ir.Instr = make(ir.Instr)
	val.ID = 103
	val.Typ = types.TypInt()
	var storeIns @ir.Instr = make(ir.Instr)
	storeIns.ID = 104
	storeIns.Op = iropcode.OP_STORE
	storeIns.Args = irbuild.MakeArgs2(gep, val)

	emitFusedFieldStore(a, "main", m, storeIns, gep)
	var n int = ffBytes(a)
	if n == 0 { return "alloca-base fused field store emitted nothing" }

	var ref @asm.Assembler = ffMkAsm()
	emitScalarStore(ref, x64.R13, x64.RSP, 40, 8)
	if ffBytes(ref) != n { return "alloca-base fused store byte count must match MOV [RSP+40],R13" }
	var k int = 0
	for k = 0; k < n; k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] {
			return "alloca-base fused store must equal MOV [RSP+40],R13 (no LEA)"
		}
	}
	return ""
}

// ffFloatStruct builds `struct { i int; d float64; s float32 }` — on LP64 field
// d is at byte offset 8 and s at 16: the float fields the fused float field
// load/store tests address.
func ffFloatStruct() @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 3)
	var fi @types.Field = make(types.Field)
	fi.Name = "i"
	fi.Type = types.TypInt()
	var fd @types.Field = make(types.Field)
	fd.Name = "d"
	fd.Type = types.TypFloat64()
	var fsg @types.Field = make(types.Field)
	fsg.Name = "s"
	fsg.Type = types.TypFloat32()
	fs[0] = fi
	fs[1] = fd
	fs[2] = fsg
	return types.MakeStructType("F", fs)
}

// ffFloatFieldGep builds an OP_GET_FIELD_PTR (id 101) for field `index` of
// ffFloatStruct, typed pointer-to-`elem`, off base id 100 — an OP_ALLOC when
// alloca is set, else a register value.
func ffFloatFieldGep(index int, elem @types.Type, alloca bool) @ir.Instr {
	var base @ir.Instr = make(ir.Instr)
	base.ID = 100
	if alloca { base.Op = iropcode.OP_ALLOC }
	base.Typ = types.MakePointerType(ffFloatStruct())
	var gep @ir.Instr = make(ir.Instr)
	gep.ID = 101
	gep.Op = iropcode.OP_GET_FIELD_PTR
	gep.Index = index
	gep.Typ = types.MakePointerType(elem)
	gep.Args = irbuild.MakeArgs1(base)
	return gep
}

// ffFloatLoad builds the OP_LOAD (id 102, type t) through gep.
func ffFloatLoad(gep @ir.Instr, t @types.Type) @ir.Instr {
	var ld @ir.Instr = make(ir.Instr)
	ld.ID = 102
	ld.Op = iropcode.OP_LOAD
	ld.Typ = t
	ld.Args = irbuild.MakeArgs1(gep)
	return ld
}

// ffFloatStore builds the OP_STORE (id 104) of value id 103 (type t) through gep.
func ffFloatStore(gep @ir.Instr, t @types.Type) @ir.Instr {
	var val @ir.Instr = make(ir.Instr)
	val.ID = 103
	val.Typ = t
	var st @ir.Instr = make(ir.Instr)
	st.ID = 104
	st.Op = iropcode.OP_STORE
	st.Args = irbuild.MakeArgs2(gep, val)
	return st
}

// ffHome records SSA id's home register in m.
func ffHome(m @common.RegMap, id int, reg int) {
	m.HomeIDs = common.AppendInt(m.HomeIDs, id)
	m.HomeRegs = common.AppendInt(m.HomeRegs, reg)
}

// ffAlloca records id 100 as a 24-byte alloca at frame offset 32.
func ffAlloca(m @common.RegMap) {
	m.AllocIDs = common.AppendInt(m.AllocIDs, 100)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 32)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 24)
}

// ffSameBytes returns msg unless a emitted exactly ref's bytes.
func ffSameBytes(a @asm.Assembler, ref @asm.Assembler, msg testing.TestResult) testing.TestResult {
	if ffBytes(a) != ffBytes(ref) { return msg }
	var k int = 0
	for k = 0; k < ffBytes(a); k++ {
		if a.Sections[0].Data[k] != ref.Sections[0].Data[k] { return msg }
	}
	return ""
}

// A fused field load of an FP-homed float64 is one MOVLPS from [base + 8] straight
// into the XMM home.
func TestEmitFusedFieldLoadFloatHomeFoldsOffset() testing.TestResult {
	ffTarget64()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	ffHome(m, 100, x64.RBX)
	ffHome(m, 102, x64.XMM8)
	var gep @ir.Instr = ffFloatFieldGep(1, types.TypFloat64(), false)
	emitFusedFieldLoad(a, m, ffFloatLoad(gep, types.TypFloat64()), gep)
	var ref @asm.Assembler = ffMkAsm()
	x64.Movlps_load(ref, x64.XMM8, x64.Mem(x64.RBX, 8, x64.SZ64))
	return ffSameBytes(a, ref, "fused float64 field load must be exactly MOVLPS XMM8,[RBX+8]")
}

// A fused field store of an FP-homed float64 is one MOVLPS to [base + 8] straight
// from the XMM home — NOT a MOVQ to a GP scratch followed by a GP MOV.
func TestEmitFusedFieldStoreFloatHomeFoldsOffset() testing.TestResult {
	ffTarget64()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	ffHome(m, 100, x64.RBX)
	ffHome(m, 103, x64.XMM9)
	var gep @ir.Instr = ffFloatFieldGep(1, types.TypFloat64(), false)
	emitFusedFieldStore(a, "main", m, ffFloatStore(gep, types.TypFloat64()), gep)
	var ref @asm.Assembler = ffMkAsm()
	x64.Movlps_store(ref, x64.Mem(x64.RBX, 8, x64.SZ64), x64.XMM9)
	return ffSameBytes(a, ref,
			"fused float64 field store must be exactly MOVLPS [RBX+8],XMM9 (no GP bridge)")
}

// A float32 field (offset 16) loads with MOVSS: `movss xmm8, [rbx + 16]`.
func TestEmitFusedFieldLoadFloat32HomeIsMovss() testing.TestResult {
	ffTarget64()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	ffHome(m, 100, x64.RBX)
	ffHome(m, 102, x64.XMM8)
	var gep @ir.Instr = ffFloatFieldGep(2, types.TypFloat32(), false)
	emitFusedFieldLoad(a, m, ffFloatLoad(gep, types.TypFloat32()), gep)
	var ref @asm.Assembler = ffMkAsm()
	x64.Movss_load(ref, x64.XMM8, x64.Mem(x64.RBX, 16, x64.SZ32))
	return ffSameBytes(a, ref, "fused float32 field load must be exactly MOVSS XMM8,[RBX+16]")
}

// The float32 store analogue: `movss [rbx + 16], xmm9`.
func TestEmitFusedFieldStoreFloat32HomeIsMovss() testing.TestResult {
	ffTarget64()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	ffHome(m, 100, x64.RBX)
	ffHome(m, 103, x64.XMM9)
	var gep @ir.Instr = ffFloatFieldGep(2, types.TypFloat32(), false)
	emitFusedFieldStore(a, "main", m, ffFloatStore(gep, types.TypFloat32()), gep)
	var ref @asm.Assembler = ffMkAsm()
	x64.Movss_store(ref, x64.Mem(x64.RBX, 16, x64.SZ32), x64.XMM9)
	return ffSameBytes(a, ref, "fused float32 field store must be exactly MOVSS [RBX+16],XMM9")
}

// An alloca-base float field folds allocaOffset (32) + fieldOffset (8) into one
// RSP-relative `movlps xmm8, [rsp + 40]` — no LEA, no GP bridge.
func TestEmitFusedFieldLoadFloatAllocaBase() testing.TestResult {
	ffTarget64()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	ffAlloca(m)
	ffHome(m, 102, x64.XMM8)
	var gep @ir.Instr = ffFloatFieldGep(1, types.TypFloat64(), true)
	emitFusedFieldLoad(a, m, ffFloatLoad(gep, types.TypFloat64()), gep)
	var ref @asm.Assembler = ffMkAsm()
	x64.Movlps_load(ref, x64.XMM8, x64.Mem(x64.RSP, 40, x64.SZ64))
	return ffSameBytes(a, ref, "alloca-base fused float64 load must be exactly MOVLPS XMM8,[RSP+40]")
}

// The alloca-base store analogue: `movlps [rsp + 40], xmm9`.
func TestEmitFusedFieldStoreFloatAllocaBase() testing.TestResult {
	ffTarget64()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	ffAlloca(m)
	ffHome(m, 103, x64.XMM9)
	var gep @ir.Instr = ffFloatFieldGep(1, types.TypFloat64(), true)
	emitFusedFieldStore(a, "main", m, ffFloatStore(gep, types.TypFloat64()), gep)
	var ref @asm.Assembler = ffMkAsm()
	x64.Movlps_store(ref, x64.Mem(x64.RSP, 40, x64.SZ64), x64.XMM9)
	return ffSameBytes(a, ref, "alloca-base fused float64 store must be exactly MOVLPS [RSP+40],XMM9")
}

// A float load whose result is NOT FP-homed (a spilled float) takes the GP path:
// one `mov r10, [rbx + 8]` into a pool register, recorded as the result's
// register (the dispatcher's handleResult then stores it to the slot).
func TestEmitFusedFieldLoadFloatUnhomedUsesGp() testing.TestResult {
	ffTarget64()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	ffHome(m, 100, x64.RBX)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 102)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 48)
	var gep @ir.Instr = ffFloatFieldGep(1, types.TypFloat64(), false)
	emitFusedFieldLoad(a, m, ffFloatLoad(gep, types.TypFloat64()), gep)
	if m.LookupReg(102) != x64.R10 {
		return "unhomed float load result must land in pool register R10"
	}
	var ref @asm.Assembler = ffMkAsm()
	x64.Mov(ref, x64.Reg(x64.R10, x64.SZ64), x64.Mem(x64.RBX, 8, x64.SZ64))
	return ffSameBytes(a, ref, "unhomed fused float64 load must be exactly MOV R10,[RBX+8]")
}

// A float store whose value is NOT FP-homed reloads the value's bits from its
// slot into a GP scratch and stores them with a size-matched GP MOV: for a
// float32, `mov r10, [rsp + 48]; mov dword [rbx + 16], r10d`.
func TestEmitFusedFieldStoreFloatUnhomedUsesGp() testing.TestResult {
	ffTarget64()
	var a @asm.Assembler = ffMkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	ffHome(m, 100, x64.RBX)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 103)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 48)
	var gep @ir.Instr = ffFloatFieldGep(2, types.TypFloat32(), false)
	emitFusedFieldStore(a, "main", m, ffFloatStore(gep, types.TypFloat32()), gep)
	var ref @asm.Assembler = ffMkAsm()
	x64.Mov(ref, x64.Reg(x64.R10, x64.SZ64), x64.Mem(x64.RSP, 48, x64.SZ64))
	x64.Mov(ref, x64.Mem(x64.RBX, 16, x64.SZ32), x64.Reg(x64.R10, x64.SZ32))
	return ffSameBytes(a, ref,
			"unhomed fused float32 store must be MOV R10,[RSP+48]; MOV [RBX+16],R10D")
}

// fieldFoldSet — the fold set emitFunc hands the allocator and the emitters —
// folds float fields: a float64 and a float32 load, each through its own
// single-use field GEP.  (A backend that stops opting floats in would still
// compile everything correctly, just with a standalone address per float field
// access, so only this pins the opt-in.)
func TestFieldFoldSetFoldsFloatFields() testing.TestResult {
	ffTarget64()
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "t", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var base @ir.Instr = irbuild.EmitConstNil(b, types.MakePointerType(ffFloatStruct()))
	var gd @ir.Instr = irbuild.EmitGetFieldPtr(b, base, 1, types.TypFloat64())
	_ = irbuild.EmitLoad(b, gd, types.TypFloat64())
	var gs @ir.Instr = irbuild.EmitGetFieldPtr(b, base, 2, types.TypFloat32())
	_ = irbuild.EmitLoad(b, gs, types.TypFloat32())
	var fs @[]bool = fieldFoldSet(f)
	if gd.ID >= len(fs) || !fs[gd.ID] { return "a float64 field access must fold" }
	if gs.ID >= len(fs) || !fs[gs.ID] { return "a float32 field access must fold" }
	return ""
}
