package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Unit tests for the value-operand global-ref materialization
// (emitValOperand in x64_regmap.bn): taking a top-level global's address
// as an rvalue (`&G`) in a value-operand position — return value,
// comparison operand, call argument, bit_cast source — must emit a
// RIP-relative LEA that puts the runtime address in a register, not
// resolve the IsGlobalRef pseudo (ID -1) through getOperand (which misses
// and drops the operand, leaving RAX unset → empty getG → SIGBUS).
// Conformance 551 / 573 cover the routed sites end-to-end on x64-darwin;
// these pin the emit shape directly.  opsMkAssembler / nilFuncs come from
// x64_ops_test.bn (same package).

// hasRipLea reports whether the emitted bytes contain a RIP-relative LEA
// (the emitGlobalAddr shape): REX.W (0x48..0x4F with W set) + 0x8D +
// ModR/M with mod=00, rm=101 — i.e. (modrm & 0xC7) == 0x05.  x64 is
// variable-length, so the tests assert the LEA is present rather than an
// exact byte count.
func hasRipLea(data *[]uint8, n int) bool {
	for i := 0; i < n - 2; i++ {
		var rex int = cast(int, data[i])
		if rex < 0x48 || rex > 0x4F { continue }
		if (rex & 0x08) == 0 { continue }  // REX.W must be set
		if data[i+1] != cast(uint8, 0x8D) { continue }  // LEA opcode
		if (cast(int, data[i+2]) & 0xC7) == 0x05 { return true }
	}
	return false
}

// countRipLea counts RIP-relative LEAs (vs hasRipLea's presence check);
// nthRipLeaDestReg recovers the k-th LEA's destination register
// (REX.R<<3 | modrm.reg).  Together they let a test assert that two
// distinct globals materialize into DISTINCT registers — the property the
// shared-globalReg clobber bug violated (it reused one register for both).
func countRipLea(data *[]uint8, n int) int {
	var count int = 0
	for i := 0; i < n - 2; i++ {
		var rex int = cast(int, data[i])
		if rex < 0x48 || rex > 0x4F { continue }
		if (rex & 0x08) == 0 { continue }
		if data[i+1] != cast(uint8, 0x8D) { continue }
		if (cast(int, data[i+2]) & 0xC7) == 0x05 { count = count + 1 }
	}
	return count
}

func nthRipLeaDestReg(data *[]uint8, n int, k int) int {
	var seen int = 0
	for i := 0; i < n - 2; i++ {
		var rex int = cast(int, data[i])
		if rex < 0x48 || rex > 0x4F { continue }
		if (rex & 0x08) == 0 { continue }
		if data[i+1] != cast(uint8, 0x8D) { continue }
		var modrm int = cast(int, data[i+2])
		if (modrm & 0xC7) != 0x05 { continue }
		if seen == k { return ((rex & 0x04) << 1) | ((modrm >> 3) & 0x07) }
		seen = seen + 1
	}
	return -1
}

// makeGlobalRef builds the IsGlobalRef pseudo the IR emits for `&name`:
// ID -1, no spill/alloc slot, IsGlobalRef set.
func makeGlobalRef(name @[]char) @ir.Instr {
	var g @ir.Instr = make(ir.Instr)
	g.ID = -1
	g.IsGlobalRef = true
	g.StrVal = name
	g.Typ = types.MakePointerType(types.TypInt())
	return g
}

// `return &G` must materialize the global address (RIP-relative LEA)
// into RAX.  Pre-fix the scalar return resolved &G through
// getOperand(ID -1) -> -1, so `if src >= 0` was false and RAX was left
// unset — the empty getG body that crashes the caller (conformance 551).
func TestEmitReturnGlobalRefMaterializesAddr() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 5
	ins.Op = ir.OP_RETURN
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = makeGlobalRef("G")
	emitReturn(a, "main", rm, ins)
	if !hasRipLea(a.Sections[0].Data, a.Sections[0].Len) {
		return "return &G should materialize the global address via a "
			"RIP-relative LEA; its absence means the IsGlobalRef value was "
			"dropped (empty getG body -> SIGBUS)"
	}
	return ""
}

// emitValOperand materializes an IsGlobalRef via RIP-LEA but defers an
// ordinary (spilled) value to getOperand, which reloads it with a MOV and
// emits no global LEA.  Pin both arms.
func TestEmitValOperandX64GlobalVsOrdinary() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	if emitValOperand(a, "main", rm, makeGlobalRef("G")) < 0 {
		return "emitValOperand should materialize a global-ref address"
	}
	if !hasRipLea(a.Sections[0].Data, a.Sections[0].Len) {
		return "global-ref value should materialize with a RIP-relative LEA"
	}

	var b @asm.Assembler = opsMkAssembler()
	var rm2 @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	rm2.SpillIDs = common.AppendInt(rm2.SpillIDs, 5)
	rm2.SpillOffsets = common.AppendInt(rm2.SpillOffsets, 0)
	var ord @ir.Instr = make(ir.Instr)
	ord.ID = 5
	if emitValOperand(b, "main", rm2, ord) < 0 {
		return "emitValOperand should reload a spilled ordinary value"
	}
	if hasRipLea(b.Sections[0].Data, b.Sections[0].Len) {
		return "ordinary spilled value should reload via MOV, not a global LEA"
	}
	return ""
}

// `&G == &H` (two distinct globals as comparison operands in one
// instruction) must emit the comparison with both addresses materialized.
// Pre-fix both operands resolved through getOperand(ID -1) -> -1, so
// `if lhs < 0 || rhs < 0 { return false }` bailed and emitted nothing
// (conformance 573).
func TestEmitCompareGlobalRefOperandsMaterialize() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_EQ
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = makeGlobalRef("G")
	ins.Args[1] = makeGlobalRef("H")
	if !emitCompare(a, "main", rm, ins) {
		return "&G == &H should emit a comparison, not bail with the "
			"operands dropped"
	}
	if countRipLea(a.Sections[0].Data, a.Sections[0].Len) != 2 {
		return "&G == &H must materialize BOTH global addresses — expected "
			"two RIP-LEAs, one per operand"
	}
	if nthRipLeaDestReg(a.Sections[0].Data, a.Sections[0].Len, 0) ==
			nthRipLeaDestReg(a.Sections[0].Data, a.Sections[0].Len, 1) {
		return "&G and &H must land in DISTINCT registers — else the second "
			"LEA clobbers the first (the shared-globalReg bug)"
	}
	return ""
}

// OP_CAST whose source is a global's address (`cast(int, &G)`) is the
// value-preserving sibling of bit_cast: the dispatcher must route the
// source through emitValOperand so it is materialized (RIP-relative LEA)
// before the conversion.  Pre-fix the OP_CAST arm used a bare
// getOperand(ID -1) -> -1, so `if src < 0 { return }` emitted NOTHING
// (`cast(int, &G)` round-trip read the unchanged global; conformance 669
// on x64-darwin).
func TestEmitCastGlobalRefSourceMaterializesX64() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 4
	ins.Op = ir.OP_CAST
	ins.TypeArg = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = makeGlobalRef("G")
	emitInstr(a, "main", "bn_main__main", rm, nilFuncs(), nilStrings(), ins)
	if !hasRipLea(a.Sections[0].Data, a.Sections[0].Len) {
		return "cast of a global-ref source should materialize the address "
			"via a RIP-relative LEA; its absence means the source was dropped"
	}
	return ""
}
