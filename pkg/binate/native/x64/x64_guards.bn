package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Runtime guard lowerings (bounds / divide / shift checks)
// ============================================================
//
// Dispatched from emitInstr (x64_dispatch.bn).  Bounds is lowered INLINE
// (compare + branch, cold fail-only call); divide/shift still lower to a
// direct rt.* call (their guards are cheaper than the marshaling saved, and
// they aren't per-array-access hot spots).

// emitBoundsCheck lowers OP_BOUNDS_CHECK inline instead of calling
// rt.BoundsCheck: the in-bounds path is a compare + not-taken branch (no
// cross-TU call round-trip), and only the cold fail path calls the noreturn
// rt.BoundsFail(idx, len) — the same abort sink rt.BoundsCheck uses, so the
// diagnostic is byte-identical.  Two-compare SIGNED form `idx < 0 || idx >=
// len`, matching rt.BoundsCheck exactly (rt_managed.bn).  A single unsigned
// compare would shave one branch but is sound only when len >= 0, which for
// slice `hi+1` checks holds only via the gen_slice lo/hi ordering — a
// possible follow-up, not the default.  See emit_bounds.bn for the LLVM twin
// and plan-inline-bounds-check.md.
func emitBoundsCheck(a @asm.Assembler, funcSym @[]char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	var idx int = getOperand(a, rm, ins.Args[0].ID)
	var ln int = getOperand(a, rm, ins.Args[1].ID)
	if idx < 0 || ln < 0 { return }
	var seq int = rm.BoundsSeq
	rm.BoundsSeq = rm.BoundsSeq + 1
	var failLbl @[]char = common.BoundsLabel(funcSym, seq, true)
	var okLbl @[]char = common.BoundsLabel(funcSym, seq, false)
	// idx < 0  → fail
	x64.Cmp(a, x64.Reg(idx, x64.SZ64), x64.Imm(0))
	x64.Jcc(a, x64.CC_L, failLbl)
	// idx < len (signed; idx >= 0 here) → in bounds, skip the fail
	x64.Cmp(a, x64.Reg(idx, x64.SZ64), x64.Reg(ln, x64.SZ64))
	x64.Jcc(a, x64.CC_L, okLbl)
	// fail (cold): reached iff idx >= len (fall-through) or idx < 0
	// (branch).  Marshal SysV args (RSI ← len FIRST — RSI isn't in
	// regPool, so it can't hold idx — then RDI ← idx) and call the
	// noreturn abort; nothing after it runs, so okLbl follows directly.
	// rm.ResetRegs is unneeded: spillAndReset runs after every
	// instruction and OP_BOUNDS_CHECK is void.
	a.DefineLabel(failLbl)
	if ln != x64.RSI {
		x64.Mov(a, x64.Reg(x64.RSI, x64.SZ64), x64.Reg(ln, x64.SZ64))
	}
	if idx != x64.RDI {
		x64.Mov(a, x64.Reg(x64.RDI, x64.SZ64), x64.Reg(idx, x64.SZ64))
	}
	var callee @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "BoundsFail"))
	a.SetGlobal(callee)
	x64.Call(a, callee)
	a.DefineLabel(okLbl)
}

// emitDivCheck lowers OP_DIV_CHECK to rt.DivCheck(dividend, divisor,
// signedMin, isSigned).  SysV args: RDI/RSI/RDX/RCX. Operands are already
// 64-bit (IR-gen extends them). Marshal the operands into RDI/RSI FIRST —
// divisor to RSI (not a pool register, so it can't hold dividend), then
// dividend to RDI — before writing the two constant args into RDX and RCX,
// which ARE pool registers and could still hold an operand until it has been
// copied out.
func emitDivCheck(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	var dividend int = getOperand(a, rm, ins.Args[0].ID)
	var divisor int = getOperand(a, rm, ins.Args[1].ID)
	if dividend < 0 || divisor < 0 { return }
	if divisor != x64.RSI {
		x64.Mov(a, x64.Reg(x64.RSI, x64.SZ64), x64.Reg(divisor, x64.SZ64))
	}
	if dividend != x64.RDI {
		x64.Mov(a, x64.Reg(x64.RDI, x64.SZ64), x64.Reg(dividend, x64.SZ64))
	}
	emitConstInt64(a, x64.RDX, types.SignedMinForWidth(cast(int, ins.IntVal)))
	var dcSigned int = 0
	if ins.BoolVal { dcSigned = 1 }
	emitConstInt64(a, x64.RCX, cast(int64, dcSigned))
	var dcCallee @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "DivCheck"))
	a.SetGlobal(dcCallee)
	x64.Call(a, dcCallee)
	rm.ResetRegs()
}

// emitShiftCheck lowers OP_SHIFT_CHECK to rt.ShiftCheck(count): panic if the
// count is negative.  SysV first arg in RDI; count is already 64-bit (IR-gen
// extends it).
func emitShiftCheck(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var scCount int = getOperand(a, rm, ins.Args[0].ID)
	if scCount < 0 { return }
	if scCount != x64.RDI {
		x64.Mov(a, x64.Reg(x64.RDI, x64.SZ64), x64.Reg(scCount, x64.SZ64))
	}
	var scCallee @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "ShiftCheck"))
	a.SetGlobal(scCallee)
	x64.Call(a, scCallee)
	rm.ResetRegs()
}
