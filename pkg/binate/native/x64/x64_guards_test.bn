package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the runtime guard lowerings (x64_guards.bn).  Helpers
// (dispatchMkAsm, nilStrings) live in x64_dispatch_test.bn.

// OP_BOUNDS_CHECK lowers INLINE: the in-bounds path is a compare + branch,
// and only the cold fail path calls the noreturn rt.BoundsFail (NOT
// rt.BoundsCheck).  Pin: BoundsFail is declared global (so a relocation is
// emitted for the cold call) and BoundsCheck is NOT (no longer called).
// A second check in the same function must get a DISTINCT label — the void
// op's Instr.ID is -1 for both, so labels come from RegMap.BoundsSeq; a
// duplicate label would set a.HasError.
func TestEmitBoundsCheckInline() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var idx @ir.Instr = make(ir.Instr)
	idx.ID = 1
	idx.Typ = types.TypInt()
	var ln @ir.Instr = make(ir.Instr)
	ln.ID = 2
	ln.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_BOUNDS_CHECK
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = idx
	ins.Args[1] = ln
	emitInstr(a, "main", "main.foo", m, nilStrings(), ins)
	if a.LookupSymbol("bn_F3_3_pkg8_builtins2_rt1_10_BoundsFail") < 0 {
		return "OP_BOUNDS_CHECK fail path should call rt.BoundsFail (declared global)"
	}
	if a.LookupSymbol("bn_F3_3_pkg8_builtins2_rt1_11_BoundsCheck") >= 0 {
		return "OP_BOUNDS_CHECK should NOT call rt.BoundsCheck (now inlined)"
	}
	// Second check, same function, same (void, ID=-1) op: labels must not
	// collide.  With ins.ID keying they would both be Lbc_-1 → duplicate.
	emitInstr(a, "main", "main.foo", m, nilStrings(), ins)
	if a.HasError {
		return "two bounds checks must get distinct labels (RegMap.BoundsSeq); duplicate-label error"
	}
	return ""
}

// OP_SHIFT_CHECK lowers to a CALL of the runtime negative-shift-count
// guard, marshalling the (64-bit) count into the first SysV arg register.
func TestEmitShiftCheckCallsRuntime() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var cnt @ir.Instr = make(ir.Instr)
	cnt.ID = 1
	cnt.Typ = types.TypInt64()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_SHIFT_CHECK
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = cnt
	emitInstr(a, "main", "main.foo", m, nilStrings(), ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	if n < 5 || data[n - 5] != cast(uint8, 0xE8) {
		return "OP_SHIFT_CHECK should emit a CALL (0xE8) as its tail"
	}
	if a.LookupSymbol("bn_F3_3_pkg8_builtins2_rt1_10_ShiftCheck") < 0 {
		return "OP_SHIFT_CHECK should declare bn_F3_3_pkg8_builtins2_rt1_10_ShiftCheck as global"
	}
	return ""
}
