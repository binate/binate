package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/stdx/slices"

// ============================================================
// Interface dispatch — emitCallIfaceMethod, emitImplVtables
//
// Mirrors aarch64_iface.bn (and the LLVM lowering in pkg/binate/codegen/
// emit_iface_call.bn): each `impl T : I` declaration produces one
// `__ivt.<mangled (recv, iface)>` global containing [dtor, *TypeInfo,
// m1, m2, ...] pointers, where every method slot holds the method's
// function-value HANDLE (@__handle.<m>, like slot 0's dtor); an
// `OP_IFACE_VALUE` site packs {data, vtable_global_addr} into a 16-byte
// aggregate; `OP_CALL_IFACE_METHOD` loads vtable[Index] (the ABSOLUTE
// vtable slot, past the two-word any-block — dtor + *TypeInfo) as a
// handle and dispatches THROUGH its marshaling shim, with the iv's data
// ptr (iv[0]) as the receiver; `OP_IFACE_DTOR` loads vtable[0] for the
// @Iface scope-exit cleanup path.
// ============================================================

// emitCallIfaceMethod lowers OP_CALL_IFACE_METHOD.  Args[0] is the iv value (a
// 16-byte {data, vtable} aggregate held at the alloc region pointed to by
// getOperand); Args[1..] are user args; Index is the ABSOLUTE vtable slot (slots
// 0-1 = any-block: dtor, *TypeInfo; first method = slot 2; an extended interface's
// inherited methods land at nested absolute offsets) — dispatched raw as `8 *
// Index`, no +2 (findInterfaceMethodFromBase already added it).
//
// Every @__ivt method slot holds the method's function-value HANDLE
// (@__handle.<m>, emitOneImplVtable useHandles=true) — the same convention slot 0
// (the dtor) already uses — so dispatch goes THROUGH the handle's marshaling shim
// exactly like OP_CALL_FUNC_VALUE.  That is what lets a native-emitted iface
// dispatch reach an impl whose @__ivt was emitted by ANOTHER backend (the hybrid
// native-main / LLVM-dep build): both sides agree on the handle+shim contract.
// Mirrors emitCallFuncValue (x64_call_indirect.bn), but (a) the handle is LOADED
// from the vtable slot at iv.vtable + 8*Index instead of being the func-value's
// own address, and (b) the RECEIVER (iv[0]) is prepended as the shim's first arg
// after the handle's data, so prefixSlots is one larger.  See the LLVM reference
// emit_iface_call.bn:emitCallIfaceMethod.
func emitCallIfaceMethod(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		ins @ir.Instr) {
	if len(ins.Args) < 1 { return }

	// Load the method HANDLE from the vtable slot, then extract its marshaling shim
	// into R11 (the CALL target):
	//   R11 = iv.vtable            (MOV R11, [ivAddr + IfaceValueVtableOffset()])
	//   R11 = vt[Index]            (MOV R11, [R11 + 8*Index])   ; the @__handle ptr
	//   R11 = handle.vtable        (MOV R11, [R11 + FuncValueVtableOffset()])
	//   R11 = handle.vtable.call   (MOV R11, [R11 + 8])          ; the shim
	// R11 is caller-saved and not handed out by the scratch pool during the arg
	// loop (per-arg ResetRegs keeps Next low), so it survives up to the stash.
	var ivAddr int = getOperand(a, rm, ins.Args[0].ID)
	if ivAddr < 0 { return }
	x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Mem(ivAddr, types.IfaceValueVtableOffset(), x64.SZ64))
	x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Mem(x64.R11, 8 * ins.Index, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Mem(x64.R11, types.FuncValueVtableOffset(), x64.SZ64))
	x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Mem(x64.R11, 8, x64.SZ64))
	// Stash the shim (R11) in the call-result slot so the arg loop's getOperand /
	// ResetRegs can't clobber it; reloaded just before CALL.  A void call (ins.ID <
	// 0) has no result slot — the shim is recomputed from the handle ptr below.
	var fnPtrSlot int = -1
	if ins.ID >= 0 {
		fnPtrSlot = rm.LookupSpill(ins.ID)
		if fnPtrSlot < 0 {
			fnPtrSlot = rm.LookupAlloc(ins.ID)
		}
	}
	if fnPtrSlot >= 0 {
		x64.Mov(a, x64.Mem(x64.RSP, fnPtrSlot, x64.SZ64), x64.Reg(x64.R11, x64.SZ64))
	}

	// Shim shape (mirrors emitCallFuncValue) with one EXTRA prefix slot for the
	// receiver: an iface method's func-value type is `(receiver, args)`, so its
	// shim is `<ret>(data, receiver, args)` (scalar/void) or
	// `void(retbuf, data, receiver, args)` (aggregate/multi return).  So the prefix
	// is [data, receiver] (prefixSlots 2) or [retbuf, data, receiver] (prefixSlots
	// 3), and user args start one dispatch word later than the func-value path.
	// The retbuf-vs-scalar decision uses the same single-source-of-truth predicates
	// the shim (emitted over the method's func-value type) uses, so caller and shim
	// agree.
	var aggregateRet bool = ins.ID >= 0 && types.IsAggregateReturnTyp(ins.Typ) &&
			!common.IsMultiReturnCall(ins)
	var multiRet bool = ins.ID >= 0 && common.IsMultiReturnCall(ins)
	var useRetbuf bool = aggregateRet || multiRet
	var prefixSlots int = 2
	if useRetbuf { prefixSlots = 3 }

	// Marshal user args into their all-int word-positional dispatch slots (shared
	// with emitCallFuncValue so the two layouts can't drift), starting at dispatch
	// word prefixSlots.  Done before the prefix loads so a user arg whose source reg
	// is a prefix register (RDI / RSI / RDX) is read first.
	var nCallArgs int = len(ins.Args) - 1
	emitShimUserArgsX64(a, pkgName, rm, ins, prefixSlots, nCallArgs, rm.CC.NumGpArgRegs)

	// Reload ivAddr — the arg loop's per-arg ResetRegs may have stranded it.
	if nCallArgs > 0 {
		ivAddr = getOperand(a, rm, ins.Args[0].ID)
		if ivAddr < 0 { return }
	}
	// Recompute the handle pointer into RAX (caller-saved, not in the scratch pool,
	// clobbered by the CALL anyway) so handle.data can be read for the data slot.
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(ivAddr, types.IfaceValueVtableOffset(), x64.SZ64))
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RAX, 8 * ins.Index, x64.SZ64))

	// Load the shim's prefix registers (all < NumGpArgRegs, so argReg(g) directly):
	// retbuf (aggregate/multi) into argReg(0)=RDI, then data = handle.data (from the
	// handle ptr in RAX) into dispatch word prefixSlots-2, then receiver = iv[0]
	// into word prefixSlots-1.  data/receiver come last so a user arg sourced from
	// RDI/RSI/RDX was already read by the arg loop above.
	if useRetbuf {
		// argReg(0)=RDI = retbuf (the buffer the shim writes the result through): a
		// single aggregate uses its alloc region; a multi-return (big OR small) uses
		// the spill slot the tuple lands in.  The shim does its own sret plumbing for
		// a big tuple — the caller does NOT set a hidden sret reg.
		var retbufOff int = -1
		if aggregateRet {
			retbufOff = rm.LookupAlloc(ins.ID)
		} else {
			retbufOff = rm.LookupSpill(ins.ID)
		}
		if retbufOff < 0 { return }
		x64.Lea(a, x64.Reg(argReg(0), x64.SZ64), x64.Mem(x64.RSP, retbufOff, x64.SZ64))
	}
	x64.Mov(a, x64.Reg(argReg(prefixSlots - 2), x64.SZ64),
			x64.Mem(x64.RAX, types.FuncValueDataOffset(), x64.SZ64))
	x64.Mov(a, x64.Reg(argReg(prefixSlots - 1), x64.SZ64),
			x64.Mem(ivAddr, types.IfaceValueDataOffset(), x64.SZ64))

	// Reload / recompute the shim into R11 and CALL.  ins.ID >= 0: reload from the
	// stash slot.  ins.ID < 0 (void — no result slot to stash into): recompute the
	// shim from RAX (still the handle ptr) since R11 was clobbered by the arg loop.
	if fnPtrSlot >= 0 {
		x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Mem(x64.RSP, fnPtrSlot, x64.SZ64))
	} else {
		x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Mem(x64.RAX, types.FuncValueVtableOffset(), x64.SZ64))
		x64.Mov(a, x64.Reg(x64.R11, x64.SZ64), x64.Mem(x64.R11, 8, x64.SZ64))
	}
	x64.CallReg(a, x64.R11)
	rm.ResetRegs()
	collectShimReturnX64(a, rm, ins, aggregateRet, multiRet)
}

// emitImplVtables emits one `__ivt.<...>` constant for each
// (impl, iface) pair the module defines.  Layout matches the LLVM
// backend's emit_impls.bn and the arm64 backend's emitImplVtables:
//   slot 0:        dtor pointer (or 0 if the type has no dtor)
//   slot 1:        *TypeInfo (RTTI; 0 placeholder until populated)
//   slots 2..N+1:  method pointers in interface-declaration order
// where N is the number of methods on the interface (own-only —
// no parent recursion for non-extending interfaces).  Vtables live
// in the relocatable-read-only section (rodata_relro → Mach-O
// __DATA_CONST,__const / ELF .data.rel.ro) with global visibility so
// cross-TU OP_IFACE_VALUE sites can reach them through a single shared
// symbol; they are read-only but bear pointer relocations, so the
// loader re-protects the section read-only after applying the fixups.
func emitImplVtables(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	if len(mod.Impls) == 0 { return }
	for i := 0; i < len(mod.Impls); i++ {
		var info @ir.ImplInfo = mod.Impls[i]
		if info == nil { continue }
		emitOneImplVtable(a, pkgName, mod, info)
		// Parallel shim vtable (method slots hold @__handle handles) so the
		// bytecode VM can dispatch this package's iface methods through their
		// marshaling shims when the package is injected native-only.  Gated to
		// non-generic impls — the same set the descriptor's Vtables table lists
		// (generic instantiations re-lower at the bytecode importer).
		if !common.RecvTypeIsGenericInst(info.RecvTypeName) {
			emitOneImplShimVtable(a, pkgName, mod, info)
		}
	}
	emitTypeInfosNative_x64(a, pkgName, mod)
	emitIfaceIdsNative_x64(a, mod)
	emitSatEntriesNative_x64(a, mod)
}

// dtorSlotSym_x64 returns the destructor-handle slot symbol for receiver dtor
// `dtorName` — the object-format-prefixed `@__handle.<dtor>` — or empty (a null
// slot) when the type needs no destruction (empty name) or the dtor is not
// present in this module.  Used for BOTH the vtable any-block slot 0 and the
// TypeInfo record's word 0, so the two agree by construction.
func dtorSlotSym_x64(pkgName *[]readonly char, mod @ir.Module, dtorName *[]readonly char) @[]char {
	var none @[]char
	if len(dtorName) == 0 { return none }
	if lookupModuleFuncIface(mod, dtorName) == nil { return none }
	return handleSymFor_x64(pkgName, dtorName)
}

// emitOneImplVtable writes a single __ivt.<...> array of pointers
// with the concat-recursive layout.  useHandles=true: every method slot holds the
// method's function-value HANDLE (@__handle.<m>), the same convention slot 0 (the dtor) uses, so
// interface dispatch (emitCallIfaceMethod, and the LLVM backend's) goes through
// the handle's marshaling shim uniformly — letting a native-emitted dispatch
// reach an impl whose @__ivt was emitted by another backend (the hybrid native-
// main / LLVM-dep build).  This makes @__ivt and the parallel @__ivtshim identical
// content.  Matches emit_impls.bn:emitImplVtable and aarch64's emitOneImplVtable.
func emitOneImplVtable(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module,
		info @ir.ImplInfo) {
	var slots @[]@[]char = collectImplVtableSlots_x64(pkgName, mod, info, info.IfacePkg,
			info.IfaceName, true)
	markImplSlotsGlobal_x64(a, slots)
	common.EmitDataGlobal(a, irdata.BuildImplVtable(implVtableName_x64(info), slots))
}

// emitOneImplShimVtable writes the parallel `__ivtshim.<...>` array for an
// (R, I) impl: the same byte-identical slot layout as emitOneImplVtable, but
// each METHOD slot holds the method's function-value HANDLE
// (`@__handle.<mangled>`, the same form the dtor slot already uses) instead of
// the raw method fn.  The bytecode VM resolves this from the raw `@__ivt`
// address (descriptor's VtableInfo.ShimAddr) and dispatches an injected native-
// only package's iface methods through the handle's marshaling shim.  Mirrors
// pkg/binate/codegen/emit_impls.bn:emitImplShimVtable.
func emitOneImplShimVtable(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module,
		info @ir.ImplInfo) {
	var slots @[]@[]char = collectImplVtableSlots_x64(pkgName, mod, info, info.IfacePkg,
			info.IfaceName, true)
	markImplSlotsGlobal_x64(a, slots)
	common.EmitDataGlobal(a, irdata.BuildImplVtable(implShimVtableName_x64(info), slots))
}

// collectImplVtableSlots_x64 returns the ordered slot symbols for one (R, X)
// sub-block of the recursive layout: dtor, then each parent's nested layout
// (inline), then X's own methods on R.  Mirrors collectImplVtableSlotsNative in
// aarch64_iface.bn (and the LLVM collectImplVtableSlots).  An empty slot symbol
// is a null pointer; irdata.BuildImplVtable lays the bytes.
//
// useHandles=false gives the raw `@__ivt` layout (method slots hold the raw
// method fn symbol); useHandles=true gives the parallel `@__ivtshim` layout
// (method slots hold the method's `@__handle`), threaded through the parent
// recursion so every nested sub-block uses the same form.
func collectImplVtableSlots_x64(pkgName *[]readonly char, mod @ir.Module, info @ir.ImplInfo,
		ifacePkg *[]readonly char, ifaceName *[]readonly char, useHandles bool) @[]@[]char {
	var slots @[]@[]char
	// Slot 0: dtor HANDLE pointer (not raw fn) — _call_dtor lowers as
	// OP_CALL_HANDLE and expects a BnFuncValue handle (binate dc46ac7f +
	// conformance/520_iface_dtor_callee_sole_ref).  Empty = null (no dtor).
	slots = slices.Append[@[]char](slots, dtorSlotSym_x64(pkgName, mod, info.DtorFuncName))
	// Slot 1: the concrete type's *TypeInfo (two-word any-block, RTTI —
	// spec §7.13.8/§7.13.14) — the `__typeinfo.<T>` record emitted weak by
	// emitTypeInfosNative_x64.  Keyed on the receiver type so every nested
	// sub-vtable carries the SAME leaf-type record.  Its payload is a
	// zero/null placeholder for now; its address is the type's identity.
	var typeInfoSlot @[]char = symPrefixed(
			mangle.TypeInfoName(info.RecvPkg, info.RecvTypeName))
	slots = slices.Append[@[]char](slots, typeInfoSlot)
	var parentPkgs @[]@[]char = ir.IfaceParentPkgs(mod, ifacePkg, ifaceName)
	var parentNames @[]@[]char = ir.IfaceParentNames(mod, ifacePkg, ifaceName)
	for i := 0; i < len(parentPkgs); i++ {
		var ps @[]@[]char = collectImplVtableSlots_x64(pkgName, mod, info, parentPkgs[i], parentNames[i],
				useHandles)
		for j := 0; j < len(ps); j++ {
			slots = slices.Append[@[]char](slots, ps[j])
		}
	}
	var ownMethods @[]@[]char = ir.IfaceOwnMethodNames(mod, ifacePkg, ifaceName)
	for mi := 0; mi < len(ownMethods); mi++ {
		var qualified @[]char = buildMethodFuncName_x64(info.RecvPkg, info.RecvTypeName, ownMethods[mi])
		var slotName @[]char = ir.LookupVtableSlotName(mod, qualified)
		var mLabel @[]char = symFor(pkgName, slotName)
		if useHandles {
			mLabel = handleSymFor_x64(pkgName, slotName)
		}
		slots = slices.Append[@[]char](slots, mLabel)
	}
	return slots
}

// markImplSlotsGlobal_x64 marks each non-empty slot target (a dtor handle / a
// method fn or handle) global so its relocation resolves; a null slot needs no
// symbol.
func markImplSlotsGlobal_x64(a @asm.Assembler, slots @[]@[]char) {
	for i := 0; i < len(slots); i++ {
		if len(slots[i]) > 0 {
			a.SetGlobal(slots[i])
		}
	}
}

// implVtableName_x64 builds the object-format-prefixed symbol for an
// (R, I) impl vtable.  Delegates the bare name to mangle.ImplVtableName
// (the single source of truth shared with IR-gen / codegen / VM), then
// adds the format-specific prefix (Mach-O leading '_', ELF bare).
func implVtableName_x64(info @ir.ImplInfo) @[]char {
	return symPrefixed(
			mangle.ImplVtableName(info.RecvPkg, info.RecvTypeName, info.IfacePkg, info.IfaceName))
}

// implShimVtableName_x64 builds the object-format-prefixed symbol for an
// (R, I) impl's parallel shim vtable via mangle.ImplVtableShimName, so the
// descriptor's ShimAddr fixup names exactly the symbol this backend defines
// and the cross-mode VM lookup matches.
func implShimVtableName_x64(info @ir.ImplInfo) @[]char {
	return symPrefixed(
			mangle.ImplVtableShimName(info.RecvPkg, info.RecvTypeName, info.IfacePkg, info.IfaceName))
}

// buildMethodFuncName_x64 mirrors aarch64's buildMethodFuncNameNative
// — `<recvPkg>.<recvName>.<methodName>` (pre-mangle form that symFor
// will mangle to bn_<...>).
func buildMethodFuncName_x64(recvPkg *[]readonly char, recvName *[]readonly char,
		methodName *[]readonly char) @[]char {
	var b @[]char
	b = common.AppendStr(b, recvPkg)
	b = common.AppendStr(b, ".")
	b = common.AppendStr(b, recvName)
	b = common.AppendStr(b, ".")
	b = common.AppendStr(b, methodName)
	return b
}

// lookupModuleFuncIface returns the ir.Func with the given canonical
// name, or nil if absent.  Used by the vtable dtor slot to fall back
// to a null pointer when the dtor function wasn't emitted in this
// translation unit.
func lookupModuleFuncIface(mod @ir.Module, name *[]readonly char) @ir.Func {
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f == nil { continue }
		if charEqIface_x64(f.Name, name) { return f }
	}
	return nil
}

// charEqIface_x64 is a local byte-compare for char slices.
func charEqIface_x64(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// emitVtableSlotLoad handles the three "load one slot of a 2-word value's
// vtable" ops — OP_IFACE_DTOR (iface dtor, slot 0), OP_IFACE_TYPEINFO (iface
// dynamic *TypeInfo, slot 1) and OP_FUNC_VALUE_DTOR (func-value dtor, slot 0) —
// which share a shape: read the vtable pointer out of the value, then load one
// slot of it into the result register.  Returns true when ins.Op is one of
// them (and it emitted), false otherwise so emitInstr falls through.  The iface
// value is {data, vtable} (vtable at IfaceValueVtableOffset); the func-value is
// {vtable, data} (vtable at FuncValueVtableOffset).
func emitVtableSlotLoad(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op == iropcode.OP_IFACE_DTOR {
		// Load slot 0 (the dtor) of an interface value's vtable — an opaque
		// function-pointer-shaped i8* the OP_REFDEC dtor operand path consumes.
		if len(ins.Args) < 1 { return true }
		var ivPtr int = getOperand(a, rm, ins.Args[0].ID)
		if ivPtr < 0 { return true }
		var rd int = nextReg(rm, ins.ID)
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Mem(ivPtr, types.IfaceValueVtableOffset(), x64.SZ64))
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Mem(rd, 0, x64.SZ64))
		return true
	}
	if ins.Op == iropcode.OP_IFACE_TYPEINFO {
		// Read slot 1 (the *TypeInfo) of an interface value's vtable — the
		// dynamic type identity a type assertion compares (spec §7.13.8).  Mirror
		// of OP_IFACE_DTOR reading slot 1 (offset one word) rather than slot 0.
		if len(ins.Args) < 1 { return true }
		var ivPtr int = getOperand(a, rm, ins.Args[0].ID)
		if ivPtr < 0 { return true }
		var rd int = nextReg(rm, ins.ID)
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Mem(ivPtr, types.IfaceValueVtableOffset(), x64.SZ64))
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Mem(rd, types.GetTarget().PointerSize, x64.SZ64))
		return true
	}
	if ins.Op == iropcode.OP_FUNC_VALUE_DTOR {
		// Load slot 0 (the dtor) of a function value's vtable.  Mirror of
		// OP_IFACE_DTOR with the vtable-first BnFuncValue layout.  Without this
		// the SSA result slot is allocated but never written, so a later
		// OP_REFDEC reads garbage (the 521_managed_func_value_propagation crash).
		if len(ins.Args) < 1 { return true }
		var fvPtr int = getOperand(a, rm, ins.Args[0].ID)
		if fvPtr < 0 { return true }
		var rd int = nextReg(rm, ins.ID)
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Mem(fvPtr, types.FuncValueVtableOffset(), x64.SZ64))
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Mem(rd, 0, x64.SZ64))
		return true
	}
	return false
}
