package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Interface dispatch — emitCallIfaceMethod, emitImplVtables
//
// Mirrors aarch64_iface.bn (and the LLVM lowering in pkg/binate/codegen/
// emit_impls.bn): each `impl T : I` declaration produces one
// `__ivt.bn_<recv>__<iface>` global containing [dtor, m1, m2, ...]
// function pointers; an `OP_IFACE_VALUE` site packs {data,
// vtable_global_addr} into a 16-byte aggregate; `OP_CALL_IFACE_METHOD`
// loads vtable[Index] and calls it indirectly with `data` as the
// first arg; `OP_IFACE_DTOR` loads vtable[0] for the @Iface
// scope-exit cleanup path.  See plan-interface-syntax-revision.md
// slices 2.3a / 2.5.
// ============================================================

// emitCallIfaceMethod lowers OP_CALL_IFACE_METHOD.  Args[0] is the
// iv value (a 16-byte {data, vtable} aggregate held at the alloc
// region pointed to by getOperand); Args[1..] are user args;
// Index is the absolute vtable slot (already accounting for the
// dtor at slot 0 + any parent sub-vtable inlining).  Shape mirrors
// emitCall but with the callee loaded from iv.vtable[Index] and
// the data pointer passed as arg 0.
func emitCallIfaceMethod(a @asm.Assembler, pkgName *[]readonly char,
		rm @common.RegMap, allFuncs @[]@ir.Func, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }

	// Two-step load through R11 (caller-saved scratch, not in regPool
	// for the SysV arg-pass path, not RAX):
	//   R11 = iv.vtable     (mov r11, [ivAddr + 8])
	//   R11 = vt[Index]     (mov r11, [r11 + 8 * Index])
	// `ins.Index` is the ABSOLUTE vtable slot — see
	// pkg/binate/ir/gen_iface.bn:findInterfaceMethodFromBase.  Matches LLVM
	// emission in pkg/binate/codegen/emit_impls.bn:emitCallIfaceMethod.
	var ivAddr int = getOperand(a, rm, ins.Args[0].ID)
	if ivAddr < 0 { return }
	x64.Mov(a, x64.Reg(x64.R11, x64.SZ64),
		x64.Mem(ivAddr, 8, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.R11, x64.SZ64),
		x64.Mem(x64.R11, 8 * ins.Index, x64.SZ64))
	// Spill R11 immediately to a stack slot so the arg-load loop
	// below — which freely calls getOperand / ResetRegs and clobbers
	// every regPool slot — can't lose the function pointer.  Reload
	// just before CALL.
	var fnPtrSlot int = rm.LookupSpill(ins.ID)
	if fnPtrSlot < 0 {
		// Use the data region's first 8 bytes as a scratch slot when
		// the call has no result spill (void return).  PlanFrame
		// always reserves an alloc region for an iface call (the
		// receiver is an aggregate).  If neither is available, fall
		// back to a fixed offset — but this shouldn't happen.
		fnPtrSlot = rm.LookupAlloc(ins.ID)
	}
	if fnPtrSlot >= 0 {
		x64.Mov(a, x64.Mem(x64.RSP, fnPtrSlot, x64.SZ64),
			x64.Reg(x64.R11, x64.SZ64))
	}

	// Detect sret BEFORE building argTypes — sret prepends a hidden
	// pointer slot ahead of the data and user args, shifting them
	// all by one (RDI = sret buf, RSI = data, RDX+ = user args).
	// Matches the LLVM lowering's signature
	// `void(ptr sret(<ret>), i8* data, args...)` in
	// pkg/codegen/emit_impls.bn.
	var bigMultiRet bool = ins.ID >= 0 &&
		rm.CC.CallReturnsBigMultiReturn(ins)
	var bigRet bool = ins.ID >= 0 &&
		(rm.CC.CallReturnsBigAggregate(ins) || bigMultiRet)
	var prefixSlots int = 1
	if bigRet { prefixSlots = 2 }

	// Synthetic argTypes list with prefix slots (sret + data, or
	// just data) followed by the user args.  Each prefix is a
	// pointer, so SysV CallArgRegStart returns sequential reg
	// indices for arg 0, 1, ....
	var nCallArgs int = len(ins.Args) - 1
	var argTypes @[]@types.Type =
		make_slice(@types.Type, nCallArgs + prefixSlots)
	for p := 0; p < prefixSlots; p++ {
		argTypes[p] = types.MakePointerType(types.TypUint8())
	}
	for i := 0; i < nCallArgs; i++ {
		argTypes[i + prefixSlots] = ins.Args[i + 1].Typ
	}

	// User args land after the prefix slots.  Per-arg ResetRegs
	// keeps the scratch pool from saturating on long arg lists
	// (mirrors emitCall in x64_call.bn).
	var nsrn int = 0
	for ai := 0; ai < nCallArgs; ai++ {
		var arg @ir.Instr = ins.Args[ai + 1]
		if common.IsFloatScalarTyp(arg.Typ) {
			var fsrc int = getOperand(a, rm, arg.ID)
			if fsrc >= 0 && nsrn < 8 {
				x64.Movq_gp_to_xmm(a, x64.XMM0 + nsrn, fsrc)
				nsrn = nsrn + 1
			}
			rm.ResetRegs()
			continue
		}
		var regStart int = rm.CC.CallArgRegStart(argTypes,
			ai + prefixSlots)
		var stackOff int = rm.CC.CallArgStackOff(argTypes,
			ai + prefixSlots)
		if common.IsAggregateTyp(arg.Typ) {
			emitAggregateArg(a, rm, arg, regStart, stackOff)
			rm.ResetRegs()
			continue
		}
		// emitValOperand so a global address passed to an iface
		// method (`i.m(&G)`) is materialized — bare getOperand misses
		// the IsGlobalRef pseudo and drops the arg.
		var src int = emitValOperand(a, pkgName, rm, arg)
		if src < 0 { continue }
		if regStart >= 0 {
			var dst int = argReg(regStart)
			if src != dst {
				x64.Mov(a, x64.Reg(dst, x64.SZ64),
					x64.Reg(src, x64.SZ64))
			}
		} else {
			x64.Mov(a, x64.Mem(x64.RSP, stackOff, x64.SZ64),
				x64.Reg(src, x64.SZ64))
		}
		rm.ResetRegs()
	}

	// Load data (iv[0]) into the SysV register for the data slot.
	// Without sret, data goes in RDI (slot 0).  With sret, data
	// goes in RSI (slot 1; sret takes RDI).
	// Reload ivAddr — the arg loop's ResetRegs may have stranded it.
	ivAddr = getOperand(a, rm, ins.Args[0].ID)
	if ivAddr >= 0 {
		var dataReg int = argReg(prefixSlots - 1)
		x64.Mov(a, x64.Reg(dataReg, x64.SZ64),
			x64.Mem(ivAddr, 0, x64.SZ64))
	}

	// SysV sret: the hidden buffer pointer goes in RDI (slot 0).
	// Data already in RSI per the dataReg computation above.
	if bigRet {
		var sretOff int = -1
		if bigMultiRet {
			sretOff = rm.LookupSpill(ins.ID)
		} else {
			sretOff = rm.LookupAlloc(ins.ID)
		}
		if sretOff >= 0 {
			x64.Lea(a, x64.Reg(x64.RDI, x64.SZ64),
				x64.Mem(x64.RSP, sretOff, x64.SZ64))
		}
	}

	// Reload the function pointer from the slot we stashed it in.
	if fnPtrSlot >= 0 {
		x64.Mov(a, x64.Reg(x64.R11, x64.SZ64),
			x64.Mem(x64.RSP, fnPtrSlot, x64.SZ64))
	}
	x64.CallReg(a, x64.R11)
	rm.ResetRegs()
	if ins.ID < 0 { return }

	// Aggregate single-return: pack RAX (+ RDX) into the alloc
	// region and produce its pointer.  Mirrors the post-CALL path
	// in x64_call.bn::emitCall.
	if ins.Typ != nil && common.IsAggregateTyp(ins.Typ) &&
			!common.IsMultiReturnCall(ins) {
		var dataOff int = rm.LookupAlloc(ins.ID)
		if dataOff < 0 { return }
		var sz int = ins.Typ.SizeOf()
		if sz <= 0 { return }
		if !bigRet {
			x64.Mov(a, x64.Mem(x64.RSP, dataOff, x64.SZ64),
				x64.Reg(x64.RAX, x64.SZ64))
			if sz > 8 {
				x64.Mov(a, x64.Mem(x64.RSP, dataOff + 8, x64.SZ64),
					x64.Reg(x64.RDX, x64.SZ64))
			}
		}
		var rd int = nextReg(rm, ins.ID)
		x64.Lea(a, x64.Reg(rd, x64.SZ64),
			x64.Mem(x64.RSP, dataOff, x64.SZ64))
		return
	}
	if ins.Typ != nil && ins.Typ.Kind == types.TYP_VOID { return }

	// Multi-return tuple collect — shares collectMultiReturnTuple with the
	// direct and func-value paths so the byte-image scheme can't drift.
	// Reached for OP_CALL_IFACE_METHOD now that common.IsMultiReturnCall
	// recognizes it (the CR-2 SEAM types a multi-return iface method as the
	// same anonymous tuple struct). The x64 callee coalesces sub-word fields
	// into the RAX/RDX SysV byte image, which this helper stores raw — so the
	// aggregate path above (also correct for the coalesced image) and this one
	// agree; the gain over routing iface through the aggregate path is that
	// EXTRACT reads the tuple straight from the spill slot rather than
	// indirecting through a pointer.
	if common.IsMultiReturnCall(ins) {
		if bigMultiRet { return }
		collectMultiReturnTuple(a, rm, ins)
		return
	}
	// Single scalar return: RAX → rd → spill.  Float scalars arrive
	// in XMM0 — bring the bits through MOVQ instead.
	var rd int = nextReg(rm, ins.ID)
	if common.IsFloatScalarTyp(ins.Typ) {
		x64.Movq_xmm_to_gp(a, rd, x64.XMM0)
	} else if rd != x64.RAX {
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
	}
}

// emitImplVtables emits one `__ivt.<...>` constant for each
// (impl, iface) pair the module defines.  Layout matches the LLVM
// backend's emit_impls.bn and the arm64 backend's emitImplVtables:
//   slot 0:        dtor pointer (or 0 if the type has no dtor)
//   slots 1..N+1:  method pointers in interface-declaration order
// where N is the number of methods on the interface (own-only —
// no parent recursion for non-extending interfaces).  Vtables live
// in the data section with global visibility so cross-TU
// OP_IFACE_VALUE sites can reach them through a single shared
// symbol.
func emitImplVtables(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	if len(mod.Impls) == 0 { return }
	a.SetSection("data", -1)
	for i := 0; i < len(mod.Impls); i++ {
		var info @ir.ImplInfo = mod.Impls[i]
		if info == nil { continue }
		emitOneImplVtable(a, pkgName, mod, info)
		// Parallel shim vtable (method slots hold @__handle handles) so the
		// bytecode VM can dispatch this package's iface methods through their
		// marshaling shims when the package is injected native-only.  Gated to
		// non-generic impls — the same set the descriptor's Vtables table lists
		// (generic instantiations re-lower at the bytecode importer).
		if !common.RecvTypeIsGenericInst(info.RecvTypeName) {
			emitOneImplShimVtable(a, pkgName, mod, info)
		}
	}
}

// emitOneImplVtable writes a single __ivt.<...> array of pointers
// with the concat-recursive layout from plan-interface-embedding.md
// Slice E.3.
func emitOneImplVtable(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module, info @ir.ImplInfo) {
	var vtName @[]char = implVtableName_x64(info)
	a.DefineLabel(vtName)
	a.SetGlobal(vtName)
	emitImplVtableLayout_x64(a, pkgName, mod, info,
		info.IfacePkg, info.IfaceName, false)
}

// emitOneImplShimVtable writes the parallel `__ivtshim.<...>` array for an
// (R, I) impl: the same byte-identical slot layout as emitOneImplVtable, but
// each METHOD slot holds the method's function-value HANDLE
// (`@__handle.<mangled>`, the same form the dtor slot already uses) instead of
// the raw method fn.  The bytecode VM resolves this from the raw `@__ivt`
// address (descriptor's VtableInfo.ShimAddr) and dispatches an injected native-
// only package's iface methods through the handle's marshaling shim.  Mirrors
// pkg/binate/codegen/emit_impls.bn:emitImplShimVtable.
func emitOneImplShimVtable(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module, info @ir.ImplInfo) {
	var shimName @[]char = implShimVtableName_x64(info)
	a.DefineLabel(shimName)
	a.SetGlobal(shimName)
	emitImplVtableLayout_x64(a, pkgName, mod, info,
		info.IfacePkg, info.IfaceName, true)
}

// emitImplVtableLayout_x64 writes one (R, X) sub-block of the
// recursive layout: dtor, then each parent's nested layout, then
// X's own methods on R.  Mirrors emitImplVtableLayoutNative in
// aarch64_iface.bn.
//
// When useHandles is false this emits the raw `@__ivt` layout (method
// slots hold the raw method fn).  When true it emits the parallel
// `@__ivtshim` layout (method slots hold the method's `@__handle`),
// threaded through the parent recursion so every nested sub-block uses
// the same form.
func emitImplVtableLayout_x64(a @asm.Assembler,
		pkgName *[]readonly char, mod @ir.Module, info @ir.ImplInfo,
		ifacePkg *[]readonly char, ifaceName *[]readonly char,
		useHandles bool) {
	// Slot 0: dtor HANDLE pointer (not raw fn pointer).  Same
	// design point as the aarch64 mirror — _call_dtor lowers as
	// OP_CALL_HANDLE and expects a BnFuncValue handle.  See
	// binate dc46ac7f + conformance/520_iface_dtor_callee_sole_ref.
	if len(info.DtorFuncName) > 0 &&
			lookupModuleFuncIface(mod, info.DtorFuncName) != nil {
		var handleLabel @[]char =
			handleSymFor_x64(pkgName, info.DtorFuncName)
		a.SetGlobal(handleLabel)
		emitQuadLabelIface(a, handleLabel)
	} else {
		emitQuadZeroIface(a)
	}
	var parentPkgs @[]@[]char = ir.IfaceParentPkgs(
		ifacePkg, ifaceName)
	var parentNames @[]@[]char = ir.IfaceParentNames(
		ifacePkg, ifaceName)
	for i := 0; i < len(parentPkgs); i++ {
		emitImplVtableLayout_x64(a, pkgName, mod, info,
			parentPkgs[i], parentNames[i], useHandles)
	}
	var ownMethods @[]@[]char = ir.IfaceOwnMethodNames(
		ifacePkg, ifaceName)
	for mi := 0; mi < len(ownMethods); mi++ {
		var qualified @[]char = buildMethodFuncName_x64(
			info.RecvPkg, info.RecvTypeName, ownMethods[mi])
		var slotName @[]char =
			ir.LookupVtableSlotName(mod, qualified)
		// Raw vtable: the method fn symbol, called directly by native-to-
		// native dispatch.  Shim vtable: the method's HANDLE
		// (`@__handle.<mangled>`), the same form the dtor slot uses; the
		// bytecode VM dispatches through it (handle.vtable.call is the
		// marshaling shim) so it never replicates the native arg ABI.
		var mLabel @[]char = symFor(pkgName, slotName)
		if useHandles {
			mLabel = handleSymFor_x64(pkgName, slotName)
		}
		a.SetGlobal(mLabel)
		emitQuadLabelIface(a, mLabel)
	}
}

// implVtableName_x64 builds the object-format-prefixed symbol for an
// (R, I) impl vtable.  Format-driven prefix matches the rest of the
// x64 backend's symbol-naming conventions (Mach-O leading '_', ELF
// bare).
func implVtableName_x64(info @ir.ImplInfo) @[]char {
	var b @[]char
	b = common.AppendStr(b, "__ivt.bn_")
	b = common.AppendPkgIdent(b, info.RecvPkg)
	b = common.AppendStr(b, "__")
	b = common.AppendStr(b, info.RecvTypeName)
	b = common.AppendStr(b, "__")
	b = common.AppendPkgIdent(b, info.IfacePkg)
	b = common.AppendStr(b, "__")
	b = common.AppendStr(b, info.IfaceName)
	return symPrefixed(b)
}

// implShimVtableName_x64 builds the object-format-prefixed symbol for an
// (R, I) impl's parallel shim vtable: the `@__ivt` name with the `__ivt`
// prefix replaced by `__ivtshim`
// (`__ivtshim.bn_<recv_pkg>__<recv_name>__<iface_pkg>__<iface_name>`).  Matches
// pkg/binate/codegen/emit_impls.bn:implShimVtableName under the same object-
// format prefix (Mach-O leading '_', ELF bare), so the descriptor's ShimAddr
// fixup names exactly the symbol this backend defines.
func implShimVtableName_x64(info @ir.ImplInfo) @[]char {
	var b @[]char
	b = common.AppendStr(b, "__ivtshim.bn_")
	b = common.AppendPkgIdent(b, info.RecvPkg)
	b = common.AppendStr(b, "__")
	b = common.AppendStr(b, info.RecvTypeName)
	b = common.AppendStr(b, "__")
	b = common.AppendPkgIdent(b, info.IfacePkg)
	b = common.AppendStr(b, "__")
	b = common.AppendStr(b, info.IfaceName)
	return symPrefixed(b)
}

// buildMethodFuncName_x64 mirrors aarch64's buildMethodFuncNameNative
// — `<recvPkg>.<recvName>.<methodName>` (pre-mangle form that symFor
// will mangle to bn_<...>).
func buildMethodFuncName_x64(recvPkg *[]readonly char,
		recvName *[]readonly char, methodName *[]readonly char) @[]char {
	var b @[]char
	b = common.AppendStr(b, recvPkg)
	b = common.AppendStr(b, ".")
	b = common.AppendStr(b, recvName)
	b = common.AppendStr(b, ".")
	b = common.AppendStr(b, methodName)
	return b
}

// emitQuadLabelIface writes an 8-byte placeholder for a vtable slot
// plus a fixup the linker rewrites to the symbol's final absolute
// address.  Mirrors `.quad <label>` in a hand-written stub.
func emitQuadLabelIface(a @asm.Assembler, label *[]readonly char) {
	a.AddFixup(label, 0, 0, 8)
	a.Fill(8, cast(uint8, 0))
}

// emitQuadZeroIface writes 8 zero bytes — slot 0 when the receiver
// type has no dtor (null function pointer).
func emitQuadZeroIface(a @asm.Assembler) {
	a.Fill(8, cast(uint8, 0))
}

// lookupModuleFuncIface returns the ir.Func with the given canonical
// name, or nil if absent.  Used by the vtable dtor slot to fall back
// to a null pointer when the dtor function wasn't emitted in this
// translation unit.
func lookupModuleFuncIface(mod @ir.Module, name *[]readonly char) @ir.Func {
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f == nil { continue }
		if charEqIface_x64(f.Name, name) { return f }
	}
	return nil
}

// charEqIface_x64 is a local byte-compare for char slices.
func charEqIface_x64(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
