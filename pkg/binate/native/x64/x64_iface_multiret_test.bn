package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Multi-return collect for the iface op (x64_iface.bn's collectMultiReturnTuple).
// Split out of x64_iface_test.bn (already at the file-length soft cap).  Shares
// ifaceMkAsm / ifaceBytes / nilFuncs from x64_iface_test.bn (same package).

// anonIntTuple_x64test builds an anonymous (unnamed) n-field (int64 x n) tuple —
// the shape common.IsMultiReturnCall recognizes as a multi-return result.
func anonIntTuple_x64test(n int) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		var f @types.Field = make(types.Field)
		f.Type = types.TypInt64()
		fields[i] = f
	}
	return types.MakeStructType("", fields)
}

// ifaceCallReturnBytes_x64 emits a no-user-arg OP_CALL_IFACE_METHOD whose result
// type is retTyp (spilled to slot 24; the iface value lives in an alloc region
// with its pointer in spill slot 16) and returns the emitted byte count.
func ifaceCallReturnBytes_x64(retTyp @types.Type) int {
	var a @asm.Assembler = ifaceMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 24)

	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 1
	iv.Typ = types.MakePointerType(types.TypUint8())

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_CALL_IFACE_METHOD
	ins.Index = 2
	ins.Typ = retTyp
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = iv

	emitCallIfaceMethod(a, "main", rm, nilFuncs(), ins)
	return ifaceBytes(a)
}

// A multi-return iface method call whose result is an anonymous int64 tuple takes
// the multi-return COLLECT path (collectMultiReturnTuple) — storing EACH field of
// the tuple into the spill slot — not the single scalar reg-collect.  x86-64
// instructions are variable-length, so this pins the PER-FIELD store via a
// field-count differential: a 3-field tuple emits strictly more (one extra field
// store, from RCX) than a 2-field tuple.  A scalar reg-collect (or a fixed-size
// collect) would not grow with the field count.  Pins that OP_CALL_IFACE_METHOD
// reaches collectMultiReturnTuple (x64_iface.bn) — the path CR-2 added once
// common.IsMultiReturnCall began recognizing the iface op; today only the
// func-value path otherwise exercises the collect.
func TestEmitCallIfaceMethodMultiReturnCollectsTuple_x64() testing.TestResult {
	var multi2 int = ifaceCallReturnBytes_x64(anonIntTuple_x64test(2))
	var multi3 int = ifaceCallReturnBytes_x64(anonIntTuple_x64test(3))
	if multi3 <= multi2 {
		return fail(
				"iface multi-return must collect per-field (collectMultiReturnTuple): a "
						"3-field tuple must emit strictly more than a 2-field (one extra store)")
	}
	return ""
}
