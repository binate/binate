package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Multi-return collect for the iface op (x64_iface.bn's collectMultiReturnTuple).
// Split out of x64_iface_test.bn (already at the file-length soft cap).  Shares
// ifaceMkAsm / ifaceBytes from x64_iface_test.bn (same package).

// anonIntTuple_x64test builds an anonymous (unnamed) n-field (int64 x n) tuple —
// the shape common.IsMultiReturnCall recognizes as a multi-return result.
func anonIntTuple_x64test(n int) @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		var f @types.Field = make(types.Field)
		f.Type = types.TypInt64()
		fields[i] = f
	}
	return types.MakeStructType("", fields)
}

// ifaceCallReturnBytes_x64 emits a no-user-arg OP_CALL_IFACE_METHOD whose result
// type is retTyp (spilled to slot 24; the iface value lives in an alloc region
// with its pointer in spill slot 16) and returns the emitted byte count.
func ifaceCallReturnBytes_x64(retTyp @types.Type) int {
	var a @asm.Assembler = ifaceMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 24)

	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 1
	iv.Typ = types.MakePointerType(types.TypUint8())

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_CALL_IFACE_METHOD
	ins.Index = 2
	ins.Typ = retTyp
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = iv

	emitCallIfaceMethod(a, "main", rm, ins)
	return ifaceBytes(a)
}

// A multi-return iface method call writes its whole tuple THROUGH the retbuf (the
// shim's convention, matching the LLVM shim + VM cross-mode dispatch), so the
// CALLER collects NOTHING per-field after the CALL — unlike the old convention,
// which stored each return field from its register.  Pin this by comparing a
// 2-field vs a 3-field anonymous int64 tuple: under the retbuf convention the
// caller's byte count is independent of the field count (both just materialize the
// retbuf pointer in RDI and CALL), so they are EQUAL; a per-field collect would
// make the 3-field call emit one extra field store.  (collectShimReturnX64's
// multiRet branch is a bare return — the spill slot IS the retbuf the shim wrote.)
func TestEmitCallIfaceMethodMultiReturnUsesRetbuf_x64() testing.TestResult {
	var pairBytes int = ifaceCallReturnBytes_x64(anonIntTuple_x64test(2))
	var tripleBytes int = ifaceCallReturnBytes_x64(anonIntTuple_x64test(3))
	if pairBytes != tripleBytes {
		return fail(
				"multi-return iface call must write the tuple through the retbuf "
						"(no per-field collect) — caller bytes must not grow with field count")
	}
	return ""
}
