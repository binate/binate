package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Gate-forced-on tests for emitCallIfaceMethod's SSE routing (x64_iface.bn).
// The SSE call-site marshal is dormant on x64 via cc.SseAggregates; forced true
// here (sseSpillCc, from x64_funcvalue_spill_test.bn) to exercise the arg
// marshal and return collect the Step-6 flip depends on.  Reuses ifaceMkAsm /
// nilFuncs from x64_iface_test.bn and hasPair / struct2t from x64_sse_test.bn
// (same package).  Each test pins ROUTING — an SSE-aggregate arg rides XMM via
// MOVLPS load (0F 12), an SSE-aggregate return is collected from XMM via MOVLPS
// store (0F 13) — and the paired gate-off test pins that neither appears while
// dormant (the plain GP path), so the change is invisible until the flip.

// ifaceArgD2Ins registers the iv (id 1), the D2 arg (id 3), and the call's
// result-scratch (id 2) slots on rm, and returns an OP_CALL_IFACE_METHOD ins
// passing a 2xf64 SSE aggregate as its sole user arg (void return).
func ifaceArgD2Ins(rm @common.RegMap) @ir.Instr {
	// iv (id 1): 16-byte {data,vtable} alloc + spill-for-pointer.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	// D2 arg (id 3): storage pointer materialised from a spill slot.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 3)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 24)
	// call (id 2): fn-ptr scratch slot.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 32)
	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 1
	iv.Typ = types.MakePointerType(types.TypUint8())
	var argD2 @ir.Instr = make(ir.Instr)
	argD2.ID = 3
	argD2.Typ = struct2t("D2", types.TypFloat64(), types.TypFloat64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_CALL_IFACE_METHOD
	ins.Index = 2 // first user method (slots 0-1 are dtor + *TypeInfo)
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = iv
	ins.Args[1] = argD2
	return ins
}

// ifaceRetD2Ins registers the iv (id 1) and the D2-result (id 2) slots on rm,
// and returns an OP_CALL_IFACE_METHOD ins with a 2xf64 SSE aggregate return and
// no user args (isolating the return-collect path).
func ifaceRetD2Ins(rm @common.RegMap) @ir.Instr {
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	// result D2 (id 2): 16-byte alloc region (the return buffer) + fn-ptr slot.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 2)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 24)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 40)
	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 1
	iv.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_CALL_IFACE_METHOD
	ins.Index = 2
	ins.Typ = struct2t("D2", types.TypFloat64(), types.TypFloat64())
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = iv
	return ins
}

// Gate on: a 2xf64 SSE-aggregate arg through an iface dispatch rides the XMM
// path — MOVLPS load (0F 12) — instead of the plain GP MOV.
func TestIfaceCallSseArgUsesMovlps() testing.TestResult {
	var a @asm.Assembler = ifaceMkAsm()
	var rm @common.RegMap = common.NewRegMap(sseSpillCc())
	var ins @ir.Instr = ifaceArgD2Ins(rm)
	emitCallIfaceMethod(a, "main", rm, nilFuncs(), ins)
	if !hasPair(a, 0x0F, 0x12) {
		return "iface SSE-agg arg must ride XMM via MOVLPS load (0F 12)"
	}
	return ""
}

// Gate off (dormant): the same arg takes the plain GP path — no MOVLPS.  Pins
// that the SSE routing is gated, so x64 output is byte-unchanged until the flip.
func TestIfaceCallSseArgGatedOff() testing.TestResult {
	var a @asm.Assembler = ifaceMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = ifaceArgD2Ins(rm)
	emitCallIfaceMethod(a, "main", rm, nilFuncs(), ins)
	if hasPair(a, 0x0F, 0x12) {
		return "gate-off iface arg must NOT use MOVLPS (dormant GP path)"
	}
	return ""
}

// Gate on: a 2xf64 SSE-aggregate return is collected from XMM0/XMM1 into the
// alloc region — MOVLPS store (0F 13) — instead of the RAX/RDX pack.
func TestIfaceCallSseReturnUsesMovlps() testing.TestResult {
	var a @asm.Assembler = ifaceMkAsm()
	var rm @common.RegMap = common.NewRegMap(sseSpillCc())
	var ins @ir.Instr = ifaceRetD2Ins(rm)
	emitCallIfaceMethod(a, "main", rm, nilFuncs(), ins)
	if !hasPair(a, 0x0F, 0x13) {
		return "iface SSE-agg return must be collected from XMM via MOVLPS store (0F 13)"
	}
	return ""
}

// Gate off (dormant): the same return uses the RAX/RDX pack — no MOVLPS store.
func TestIfaceCallSseReturnGatedOff() testing.TestResult {
	var a @asm.Assembler = ifaceMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = ifaceRetD2Ins(rm)
	emitCallIfaceMethod(a, "main", rm, nilFuncs(), ins)
	if hasPair(a, 0x0F, 0x13) {
		return "gate-off iface return must NOT use MOVLPS store (dormant RAX/RDX pack)"
	}
	return ""
}
