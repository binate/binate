package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// SSE-aggregate routing tests for handle-based emitCallIfaceMethod (x64_iface.bn).
// Under the handle/shim ABI an iface method dispatches THROUGH the method's
// marshaling shim exactly like emitCallFuncValue, so the CALL SITE never SSE-routes:
// an aggregate ARG rides BY-ADDRESS as one pointer word (the shim re-expands it) and
// an aggregate RETURN rides the retbuf (the shim writes it through the buffer).  The
// eightbyte-by-XMM marshaling the OLD raw-dispatch mirrored from emitCall is gone.
// These pin that even with the SSE gate FORCED ON (sseSpillCc, from
// x64_funcvalue_spill_test.bn) neither a MOVLPS load (0F 12) nor a MOVLPS store
// (0F 13) appears — the flip to the func-value ABI is complete.  Reuses ifaceMkAsm /
// ifaceBytes from x64_iface_test.bn and hasPair / struct2t from
// x64_sse_test.bn (same package).

// ifaceArgD2Ins registers the iv (id 1), the D2 arg (id 3), and the call's
// result-scratch (id 2) slots on rm, and returns an OP_CALL_IFACE_METHOD ins
// passing a 2xf64 aggregate as its sole user arg (void return).
func ifaceArgD2Ins(rm @common.RegMap) @ir.Instr {
	// iv (id 1): 16-byte {data,vtable} alloc + spill-for-pointer.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	// D2 arg (id 3): storage pointer materialised from a spill slot.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 3)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 24)
	// call (id 2): fn-ptr scratch slot.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 32)
	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 1
	iv.Typ = types.MakePointerType(types.TypUint8())
	var argD2 @ir.Instr = make(ir.Instr)
	argD2.ID = 3
	argD2.Typ = struct2t("D2", types.TypFloat64(), types.TypFloat64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_CALL_IFACE_METHOD
	ins.Index = 2 // first user method (slots 0-1 are dtor + *TypeInfo)
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = iv
	ins.Args[1] = argD2
	return ins
}

// ifaceRetD2Ins registers the iv (id 1) and the D2-result (id 2) slots on rm,
// and returns an OP_CALL_IFACE_METHOD ins with a 2xf64 aggregate return and no
// user args (isolating the return path).
func ifaceRetD2Ins(rm @common.RegMap) @ir.Instr {
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	// result D2 (id 2): 16-byte alloc region (the retbuf) + fn-ptr spill.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 2)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 24)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 40)
	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 1
	iv.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_CALL_IFACE_METHOD
	ins.Index = 2
	ins.Typ = struct2t("D2", types.TypFloat64(), types.TypFloat64())
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = iv
	return ins
}

// Gate forced on: a 2xf64 aggregate ARG through the handle dispatch rides
// BY-ADDRESS (one pointer word the shim re-expands) — a plain GP MOV of the arg's
// storage pointer, NOT the eightbyte MOVLPS load (0F 12) the old raw dispatch used.
// Pins that the SSE call-site marshal is gone even with sseSpillCc forcing the SSE
// gate on.  ifaceBytes > 0 guards against a vacuous pass on empty emission.
func TestIfaceCallSseArgRidesByAddress() testing.TestResult {
	var a @asm.Assembler = ifaceMkAsm()
	var rm @common.RegMap = common.NewRegMap(sseSpillCc())
	var ins @ir.Instr = ifaceArgD2Ins(rm)
	emitCallIfaceMethod(a, "main", rm, ins)
	if ifaceBytes(a) == 0 {
		return "handle iface dispatch should emit a call sequence"
	}
	if hasPair(a, 0x0F, 0x12) {
		return "handle iface aggregate arg must ride by-address, not MOVLPS (0F 12) into XMM"
	}
	return ""
}

// Gate forced on: a 2xf64 aggregate RETURN through the handle dispatch rides the
// RETBUF (the shim writes the result through the buffer the caller passes in RDI),
// so the caller collects nothing from XMM — no MOVLPS store (0F 13).  Pins that the
// SSE return-collect the old raw dispatch used is gone even with the SSE gate on.
func TestIfaceCallSseReturnUsesRetbuf() testing.TestResult {
	var a @asm.Assembler = ifaceMkAsm()
	var rm @common.RegMap = common.NewRegMap(sseSpillCc())
	var ins @ir.Instr = ifaceRetD2Ins(rm)
	emitCallIfaceMethod(a, "main", rm, ins)
	if ifaceBytes(a) == 0 {
		return "handle iface dispatch should emit a call sequence"
	}
	if hasPair(a, 0x0F, 0x13) {
		return "handle iface aggregate return must ride the retbuf, not MOVLPS (0F 13) from XMM"
	}
	return ""
}
