package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// ifaceMkAsm: minimal assembler for direct-emit iface tests.
func ifaceMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func ifaceBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// implVtableName_x64 routes through symPrefixed, so the leading
// prefix follows the object-format default (ELF bare in unit
// tests; `_`-prefixed under Mach-O via objSymPrefix).  Pin: a
// reasonable info builds a well-formed symbol starting with
// `__ivt.bn_`.
func TestImplVtableNameWellFormed() testing.TestResult {
	var info @ir.ImplInfo = make(ir.ImplInfo)
	info.RecvPkg = "main"
	info.RecvTypeName = "T"
	info.IfacePkg = "main"
	info.IfaceName = "I"
	var name @[]char = implVtableName_x64(info)
	// Bare/ELF default — no leading '_'.
	if len(name) < 8 { return "vtable name too short" }
	// First 9 bytes should be "__ivt.bn_".
	var prefix *[]readonly char = "__ivt.bn_"
	for i := 0; i < len(prefix); i++ {
		if name[i] != prefix[i] {
			return "vtable name should start with __ivt.bn_"
		}
	}
	return ""
}

// emitCallIfaceMethod emits the two-step vtable load (mov r11,
// [iv+8]; mov r11, [r11+8*Index]), the data-into-RDI move, and
// a CALL r11.  Pin: at least one CALL r/m (FF /2) — opcode 0xFF
// with ModRM reg-field = 2 — appears in the byte stream.
func TestEmitCallIfaceMethodEmitsIndirectCall() testing.TestResult {
	var a @asm.Assembler = ifaceMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// iv arg lives in an alloc data region; the spill slot holds
	// its pointer.  Pre-register both via the regmap.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	// Result spill slot for the call's (void) return.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 24)
	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 1
	iv.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_CALL_IFACE_METHOD
	ins.Index = 2 // first user method (slots 0-1 are the any-block: dtor, *TypeInfo)
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = iv
	emitCallIfaceMethod(a, "main", rm, nilFuncs(), ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundIndirect bool = false
	for i := 0; i < n - 1; i++ {
		// CALL r/m64: REX.B (or none) + 0xFF + ModRM with reg field
		// = 2 (mask 0x38 == 0x10 for reg=2 in middle 3 bits).
		if data[i] == cast(uint8, 0xFF) && (data[i + 1] & cast(uint8, 0x38)) == cast(uint8, 0x10) {
			foundIndirect = true
		}
	}
	if !foundIndirect {
		return "OP_CALL_IFACE_METHOD should emit indirect CALL r11"
	}
	return ""
}

// emitCallIfaceMethod with a big-aggregate (>16 B) sret return
// must place iv.data in RSI, not RDI — the LLVM thunk signature
// is `void(ptr sret(<ret>), i8* data, ...)`, so RDI is the hidden
// sret buffer pointer and data shifts one slot.  Pre-fix, the
// native emit loaded data into RDI then overwrote it with the
// sret LEA — the thunk saw garbage in RSI and dereferenced it
// (conformance test 411 returned 0 instead of 42).
//
// Pin: when CallReturnsBigAggregate(ins) is true, the emitted
// stream contains
//   (a) a `mov reg, [...]` whose reg field is 6 (RSI in middle
//       3 bits of the ModR/M byte) — the data load; AND
//   (b) a `lea rdi, [rsp + ...]` (REX.W 0x48 + 0x8D + ModR/M with
//       reg = 7 (RDI)) — the sret buffer setup.
// Pre-fix had the LEA but the data MOV targeted RDI (reg = 7),
// so an RSI-targeted MOV simply wasn't present.
func TestEmitCallIfaceMethodSretShiftsDataToRsi() testing.TestResult {
	var a @asm.Assembler = ifaceMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// iv arg: 16-byte {data, vtable}, alloc + spill slots.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	// Call result: 32-byte managed-slice → sret-returning.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 2)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 24)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 32)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 56)
	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 1
	iv.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_CALL_IFACE_METHOD
	ins.Index = 2
	ins.Typ = types.MakeManagedSliceType(types.TypUint8())
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = iv
	emitCallIfaceMethod(a, "main", rm, nilFuncs(), ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	// (a) MOV r64, r/m64 with dst = RSI: REX (W = 1; B optional
	// for high source reg) + 0x8B + ModR/M with reg field = 6
	// (mask 0x38 → 0x30).
	var foundMovRsi bool = false
	for i := 0; i < n - 2; i++ {
		var rex int = cast(int, data[i])
		if rex < 0x48 || rex > 0x4F { continue }
		if (rex & 0x08) == 0 { continue } // REX.W must be set
		if data[i + 1] != cast(uint8, 0x8B) { continue }
		if (cast(int, data[i + 2]) & 0x38) == 0x30 {
			foundMovRsi = true
		}
	}
	if !foundMovRsi {
		return "sret iface dispatch should MOV iv.data into RSI"
	}
	// (b) LEA RDI, [...]: REX.W (0x48) + 0x8D + ModR/M with reg
	// field = 7 (mask 0x38 → 0x38) — the sret-buffer setup.
	var foundLeaRdi bool = false
	for i := 0; i < n - 2; i++ {
		if data[i] != cast(uint8, 0x48) { continue }
		if data[i + 1] != cast(uint8, 0x8D) { continue }
		if (cast(int, data[i + 2]) & 0x38) == 0x38 {
			foundLeaRdi = true
		}
	}
	if !foundLeaRdi {
		return "sret iface dispatch should LEA sret buffer into RDI"
	}
	return ""
}

// emitImplVtables emits one 8-byte fixup slot per vtable entry.
// For a single impl with one method (no parent, no dtor), the
// layout is: 8 bytes dtor (zero) + 8 bytes *TypeInfo (zero) +
// 8 bytes method (fixup) = 24 bytes in the data section.  Empty
// Impls list emits nothing.
func TestEmitImplVtablesEmptyNoOp() testing.TestResult {
	var a @asm.Assembler = ifaceMkAsm()
	var mod @ir.Module = ir.NewModule("\"main\"")
	emitImplVtables(a, "main", mod)
	if ifaceBytes(a) != 0 {
		return "empty Impls list should emit zero data bytes"
	}
	return ""
}

// OP_IFACE_VALUE through emitInstr: builds the 16-byte {data,
// vtable} aggregate, with the vtable address materialised via a
// RIP-relative LEA (the __ivt.<...> symbol).  Pin: at least one
// RIP-relative LEA (opcode 0x8D with ModRM.mod=00 + rm=5) appears
// — that's the vtable-label fixup — plus two MOV-to-mem stores
// (one for data, one for the vtable pointer).
func TestEmitIfaceValueBuildsAggregate() testing.TestResult {
	var a @asm.Assembler = ifaceMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// Pre-register the data-pointer arg (id 1) with a spill slot.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	// Pre-register the IFACE_VALUE result (id 2) with a 16-byte
	// data region.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 2)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 32)
	var dataArg @ir.Instr = make(ir.Instr)
	dataArg.ID = 1
	dataArg.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_IFACE_VALUE
	ins.Typ = types.MakePointerType(types.TypUint8()) // placeholder
	ins.StrVal = "__ivt.bn_V1_4_main1_T1_4_main1_I"
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = dataArg
	emitInstr(a, "main", "main.foo", rm, nilFuncs(), nilStrings(), ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundRipLea bool = false
	var stores int = 0
	for i := 0; i < n - 1; i++ {
		if data[i] == cast(uint8, 0x8D) && (data[i + 1] & cast(uint8, 0xC7)) == cast(uint8, 0x05) {
			foundRipLea = true
		}
		// MOV r/m, r with SIB-rsp encoding (mod field bits 6-7 != 11,
		// rm field bits 0-2 = 100 → mask & 0x07 == 0x04).
		if i > 0 && data[i - 1] == cast(uint8, 0x89) &&
				(data[i] & cast(uint8, 0x07)) == cast(uint8, 0x04) {
			stores = stores + 1
		}
	}
	if !foundRipLea {
		return "OP_IFACE_VALUE should LEA the vtable label (RIP-relative)"
	}
	if stores < 2 {
		return "OP_IFACE_VALUE should emit 2 MOV-to-mem stores (data + vtable)"
	}
	if a.LookupSymbol("__ivt.bn_V1_4_main1_T1_4_main1_I") < 0 {
		return "OP_IFACE_VALUE should declare the vtable label as global"
	}
	return ""
}

// OP_IFACE_DTOR: load iv.vtable then *(vtable+0).  Pin: 2
// MOV-from-mem loads (0x8B opcode) — the two-step indirect read.
func TestEmitIfaceDtorTwoStepLoad() testing.TestResult {
	var a @asm.Assembler = ifaceMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 1)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 1)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 2)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 24)
	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 1
	iv.Typ = types.MakePointerType(types.TypUint8())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_IFACE_DTOR
	ins.Typ = types.MakePointerType(types.TypUint8())
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = iv
	emitInstr(a, "main", "main.foo", rm, nilFuncs(), nilStrings(), ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	// Count MOV-r-from-mem (0x8B).  Should be at least 2 — one for
	// iv.vtable (load at +8) and one for *(vtable+0).  May also see
	// an alloc-pointer materialisation (LEA) before, which doesn't
	// contribute to the count.
	var loads int = 0
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0x8B) { loads = loads + 1 }
	}
	if loads < 2 {
		return "OP_IFACE_DTOR should emit ≥ 2 MOV-from-mem loads (vtable + dtor)"
	}
	return ""
}
