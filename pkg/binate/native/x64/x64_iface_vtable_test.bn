package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Interface-vtable byte-shape tests for the x64 backend — the x64
// counterpart to native/aarch64/aarch64_iface_vtable_test.bn.  They pin
// the emitted `__ivt`/`__ivtshim` byte sizes so the two-word any-block
// (dtor + *TypeInfo) is verified on x64 by a unit test, not only through
// conformance (which cannot run the x64 native backend on a non-x64 host).

// genFromSrcX64 parses `src` and lowers it to an ir.Module (no checker;
// the layout helpers only need the impl/interface registry that IR-gen
// builds).  Mirrors aarch64_iface_vtable_test.bn's genFromSrc.
func genFromSrcX64(src *[]readonly char) @ir.Module {
	var b @[]uint8 = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		b[i] = cast(uint8, src[i])
	}
	var p @parser.Parser = parser.New(b, "test")
	var file @ast.File = p.ParseFile()
	return ir.GenModule(nil, file)
}

// relroBytesX64 returns the byte count of the "rodata_relro" section —
// where impl vtables land (read-only but bearing dtor/method-handle
// relocations, so relocatable-read-only, not the plain "text" section
// ifaceBytes measures).  Returns 0 if no relro section was emitted.
func relroBytesX64(a @asm.Assembler) int {
	for i := 0; i < a.NumSections; i++ {
		if charsEqual(a.Sections[i].Name, "rodata_relro") {
			return a.Sections[i].Len
		}
	}
	return 0
}

// emitImplVtablesOnly emits just the per-(R, I) `__ivt` / `__ivtshim` vtables
// for each impl in `mod` (mirroring emitImplVtables' loop) — WITHOUT the
// TypeInfo / IfaceId / satisfaction-entry globals emitImplVtables also emits.
// The shape tests use it to measure vtable bytes in isolation, so they stay
// immune to growth in those RTTI satellites (which land in the same relro).
func emitImplVtablesOnly(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	for i := 0; i < len(mod.Impls); i++ {
		var info @ir.ImplInfo = mod.Impls[i]
		if info == nil { continue }
		emitOneImplVtable(a, pkgName, mod, info)
		if !common.RecvTypeIsGenericInst(info.RecvTypeName) {
			emitOneImplShimVtable(a, pkgName, mod, info)
		}
	}
}

// A non-extending interface `I { foo() }; impl *T : I` (T with no
// managed fields) lays out as [dtor, *TypeInfo, foo] — the two-word
// any-block then one method = 3 slots x 8 = 24 bytes per vtable, and the
// non-generic impl also emits a byte-identical `__ivtshim`, so the relro
// section holds 24 x 2 = 48 bytes.
func TestX64ImplVtablesNonExtendingShape() testing.TestResult {
	var src *[]readonly char =
		"package \"main\"\n"
		"interface I { foo() }\n"
		"type T struct { x int }\n"
		"func (t *T) foo() { }\n"
		"impl *T : I\n"
		"func main() { }\n"
	var mod @ir.Module = genFromSrcX64(src)
	var a @asm.Assembler = asm.New(8)
	emitImplVtablesOnly(a, "main", mod)
	if relroBytesX64(a) != 48 {
		return "non-extending (T,I) raw+shim vtables should be 48 bytes (2 x 3 slots x 8)"
	}
	return ""
}

// An extended interface `RC : Closer { Read() int }` with `Closer {
// Close() }` and `impl *T : RC` also registers (T, Closer) transitively.
// (T,RC) uses the concat layout — RC's two-word any-block + Closer's full
// 3-slot sub-vtable inlined + RC's own Read = 6 slots x 8 = 48 bytes;
// (T,Closer) = 3 slots x 8 = 24 bytes; 72 bytes raw + 72 bytes of
// byte-identical shims = 144 bytes total.
func TestX64ImplVtablesExtendedConcatShape() testing.TestResult {
	var src *[]readonly char =
		"package \"main\"\n"
		"interface Closer { Close() }\n"
		"interface RC : Closer { Read() int }\n"
		"type T struct { x int }\n"
		"func (t *T) Close() { }\n"
		"func (t *T) Read() int { return 0 }\n"
		"impl *T : RC\n"
		"func main() { }\n"
	var mod @ir.Module = genFromSrcX64(src)
	var a @asm.Assembler = asm.New(8)
	emitImplVtablesOnly(a, "main", mod)
	if relroBytesX64(a) != 144 {
		return "(T,RC)+(T,Closer) raw+shim vtables should total 144 bytes"
	}
	return ""
}
