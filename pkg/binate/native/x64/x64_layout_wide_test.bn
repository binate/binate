package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Field offsets, element sizes and copy lengths past 2^31 (an aggregate may pass 2
// GiB): a displacement or immediate past the signed 32 bits an instruction holds is
// materialized in a register, off any base.  The sizes are int64, so a 32-bit host
// compiles them too.  The golden encodings are clang's for the same instructions.

// wideBig returns struct { pad [0x80000000]uint8; x int64 }, whose x is at 2^31.
func wideBig() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.MakeArrayType(types.TypUint8(), 0x80000000)
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt64()
	return types.MakeStructType("Big", fields)
}

// wideHas reports whether a's text holds the bytes spelled by want (x64FoldTextHex
// form).
func wideHas(a @asm.Assembler, want *[]readonly char) bool {
	var got @[]char = x64FoldTextHex(a)
	for i := 0; i + len(want) <= len(got); i = i + 3 {
		if x64FoldSameText(got[i:i + len(want)], want) { return true }
	}
	return false
}

// An access past 2^31 off a pointer base: a LEA or a load computes the address into
// its destination; one whose destination is the base, and a store, go through a
// scratch saved in the red zone.
func TestFarAnyBaseX64() testing.TestResult {
	setFarDispLimit(0)
	var a @asm.Assembler = farTextAsm()
	frameLea(a, x64.RCX, x64.RAX, 0x80000010)
	var r testing.TestResult = x64FoldGolden(a, "48 b9 10 00 00 80 00 00 00 00 48 8d 0c 08",
			"lea rcx, [rax + 0x80000010]: movabs rcx; lea rcx, [rax + rcx]")
	if len(r) > 0 { return r }
	a = farTextAsm()
	frameLea(a, x64.RAX, x64.RAX, 0x80000000)
	r = x64FoldGolden(a,
			"4c 89 5c 24 80 49 bb 00 00 00 80 00 00 00 00 4e 8d 1c 18 4c 89 d8 4c 8b 5c 24 80",
			"lea rax, [rax + 0x80000000]: through a saved R11")
	if len(r) > 0 { return r }
	a = farTextAsm()
	emitFrameLoad(a, x64.RCX, x64.RAX, 0x80000010, 8, false)
	r = x64FoldGolden(a, "48 b9 10 00 00 80 00 00 00 00 48 8d 0c 08 48 8b 09",
			"mov rcx, [rax + 0x80000010]: through rcx")
	if len(r) > 0 { return r }
	a = farTextAsm()
	emitFrameLoad(a, x64.RAX, x64.RAX, 0x80000010, 4, true)
	r = x64FoldGolden(a,
			"4c 89 5c 24 80 49 bb 10 00 00 80 00 00 00 00 4e 8d 1c 18 49 63 03 4c 8b 5c 24 80",
			"movsxd rax, [rax + 0x80000010]: through a saved R11")
	if len(r) > 0 { return r }
	a = farTextAsm()
	emitFrameStore(a, x64.RCX, x64.RAX, 0x80000010, 1)
	return x64FoldGolden(a,
			"4c 89 5c 24 80 49 bb 10 00 00 80 00 00 00 00 4e 8d 1c 18 41 88 0b 4c 8b 5c 24 80",
			"mov [rax + 0x80000010], cl: through a saved R11")
}

// An element size past IMUL's immediate is multiplied through a saved scratch.
func TestMulConstFarX64() testing.TestResult {
	setFarDispLimit(0)
	var a @asm.Assembler = farTextAsm()
	emitMulConstX64(a, x64.RAX, 24)
	var r testing.TestResult = x64FoldGolden(a, "48 6b c0 18", "imul rax, rax, 24")
	if len(r) > 0 { return r }
	a = farTextAsm()
	emitMulConstX64(a, x64.RAX, 0x80000020)
	return x64FoldGolden(a, "4c 89 5c 24 80 49 bb 20 00 00 80 00 00 00 00 49 0f af c3 4c 8b 5c 24 80",
			"imul rax by 0x80000020 through a saved R11")
}

// An overlap-safe copy past 2^31 compares with its size, and ends its ascending loop,
// through the red zone's bottom slot; the ascending block's top bytes, past a
// displacement, are addressed through the index.
func TestMemmovePast2GiBX64() testing.TestResult {
	setFarDispLimit(0)
	var a @asm.Assembler = farTextAsm()
	emitAggMemmoveBlockX64(a, true, x64.RAX, x64.RCX, 0x80000013, x64.RDX)
	var r testing.TestResult = x64FoldGolden(a,
			"48 c7 c2 f3 ff ff 7f 0f 10 34 11 0f 10 7c 11 10 48 ba 00 00 00 80 00 00 00 00 "
					"48 89 54 24 80 48 c7 c2 00 00 00 00 44 0f 10 34 11 44 0f 10 7c 11 10 "
					"44 0f 11 34 10 44 0f 11 7c 10 10 48 83 c2 20 48 3b 54 24 80 75 df "
					"0f 11 74 10 f3 0f 11 7c 10 03",
			"the ascending block of a 0x80000013-byte copy")
	if len(r) > 0 { return r }
	a = farTextAsm()
	emitAggMemmoveX64(a, x64.RAX, x64.RCX, 0x80000013, x64.RDX)
	if a.HasError { return fail("unexpected assembler error") }
	if !wideHas(a, "48 ba 13 00 00 80 00 00 00 00 48 89 54 24 80 48 89 c2 48 29 ca 48 3b 54 24 80") {
		return fail("dst - src should be compared with the size through [rsp - 128]")
	}
	return ""
}

// An aggregate copied to a destination past 2^31 off its base takes the address
// through frameLea, or for a loop through a saved scratch (emitFrameCopyLoopX64).
func TestAggCopyToFarX64() testing.TestResult {
	setFarDispLimit(0)
	var a @asm.Assembler = farTextAsm()
	emitAggCopyToX64(a, common.NewRegMap(callconv.SysV_AMD64()), x64.RAX, 0x80000010, x64.RCX, 16)
	var r testing.TestResult = x64FoldGolden(a,
			"49 ba 10 00 00 80 00 00 00 00 4e 8d 14 10 44 0f 10 31 45 0f 11 32",
			"a 16-byte copy to [rax + 0x80000010]: R10 takes the address")
	if len(r) > 0 { return r }
	a = farTextAsm()
	emitAggCopyToX64(a, common.NewRegMap(callconv.SysV_AMD64()), x64.RAX, 0x80000010, x64.RCX,
			0x100000008)
	return x64FoldGolden(a,
			"4c 89 5c 24 80 49 bb 10 00 00 80 00 00 00 00 4e 8d 1c 18 49 ba e8 ff ff ff 00 00 00 00 "
					"46 0f 10 34 11 46 0f 10 7c 11 10 47 0f 11 34 13 47 0f 11 7c 13 10 49 83 ea 20 79 e4 "
					"44 0f 10 31 44 0f 10 79 10 45 0f 11 33 45 0f 11 7b 10 4c 8b 5c 24 80",
			"a loop copy of 4 GiB + 8 to [rax + 0x80000010]: R11 saved, the address in it")
}

// A field past 2^31 through a pointer base, and through a global's address.
func TestFieldPtrPast2GiBX64() testing.TestResult {
	setFarDispLimit(0)
	var a @asm.Assembler = emitMkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt64(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt64(m.SpillOffsets, 8)
	var base @ir.Instr = make(ir.Instr)
	base.ID = 1
	base.Typ = types.MakePointerType(wideBig())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_GET_FIELD_PTR
	ins.Index = 1
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = base
	emitGetFieldPtr(a, "main", m, ins)
	var r testing.TestResult = x64FoldGolden(a,
			"4c 8b 1c 24 49 ba 00 00 00 80 00 00 00 00 4f 8d 14 13",
			"a field at 2^31 through a pointer: mov r11, [rsp]; movabs r10; lea r10, [r11 + r10]")
	if len(r) > 0 { return r }
	var b @asm.Assembler = emitMkAsm()
	var g @ir.Instr = make(ir.Instr)
	g.ID = -1
	g.IsGlobalRef = true
	g.StrVal = "big"
	g.Typ = types.MakePointerType(wideBig())
	ins.Args[0] = g
	emitGetFieldPtr(b, "main", common.NewRegMap(callconv.SysV_AMD64()), ins)
	return x64FoldGolden(b,
			"4c 8d 15 00 00 00 00 4c 89 5c 24 80 49 bb 00 00 00 80 00 00 00 00 4f 8d 1c 1a 4d 89 da "
					"4c 8b 5c 24 80",
			"a field at 2^31 of a global: lea r10, [rip + big], then through a saved R11")
}

// An element larger than 2 GiB scales the index through emitMulConstX64.
func TestElemPtrPast2GiBX64() testing.TestResult {
	setFarDispLimit(0)
	var a @asm.Assembler = emitMkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt64(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt64(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt64(m.SpillOffsets, 16)
	var base @ir.Instr = make(ir.Instr)
	base.ID = 1
	var idx @ir.Instr = make(ir.Instr)
	idx.ID = 2
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_GET_ELEM_PTR
	ins.Typ = types.MakePointerType(wideBig())
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = base
	ins.Args[1] = idx
	emitGetElemPtr(a, "main", m, ins)
	return x64FoldGolden(a,
			"4c 8b 54 24 08 4c 89 5c 24 80 49 bb 08 00 00 80 00 00 00 00 4d 0f af d3 4c 8b 5c 24 80 "
					"4c 8b 1c 24 4f 8d 14 13",
			"an element of 2^31 + 8 bytes: the index times a saved R11, then lea r10, [r11 + r10]")
}

// OP_MAKE of a type past 2^31 passes its size to rt.Alloc as a 64-bit immediate.
func TestMakePast2GiBX64() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_MAKE
	ins.TypeArg = wideBig()
	emitMake(a, m, ins)
	if a.HasError { return fail("unexpected assembler error") }
	if !wideHas(a, "48 bf 08 00 00 80 00 00 00 00") {
		return fail("rt.Alloc's size should be movabs rdi, 0x80000008")
	}
	return ""
}

// The descending block's bytes left over are the bottom 32, at displacement 0, so a
// small far limit (bnc -fx64-far-disp) leaves the block unchanged.
func TestMemmoveDescendingSmallLimitX64() testing.TestResult {
	setFarDispLimit(0)
	var a @asm.Assembler = farTextAsm()
	emitAggMemmoveBlockX64(a, false, x64.RAX, x64.RCX, 70, x64.RDX)
	setFarDispLimit(16)
	defer { setFarDispLimit(0) }
	var b @asm.Assembler = farTextAsm()
	emitAggMemmoveBlockX64(b, false, x64.RAX, x64.RCX, 70, x64.RDX)
	if a.HasError || b.HasError { return fail("unexpected assembler error") }
	if !x64FoldSameText(x64FoldTextHex(a), x64FoldTextHex(b)) {
		return fail("a far limit of 16 must not change the descending block")
	}
	return ""
}

// A zero-fill through a pointer whose sub-word tail is past 2^31 reaches the tail
// through a saved R11.
func TestZeroAtFarTailX64() testing.TestResult {
	setFarDispLimit(0)
	var a @asm.Assembler = farTextAsm()
	emitZeroAtX64(a, common.NewRegMap(callconv.SysV_AMD64()), x64.RAX, 0, 0x80000013)
	return x64FoldGolden(a,
			"45 0f 57 f6 49 c7 c2 f0 ff ff 7f 46 0f 11 34 10 46 0f 11 74 10 10 49 83 ea 20 79 ef "
					"44 0f 11 30 44 0f 11 70 10 4c 89 5c 24 80 49 bb 10 00 00 80 00 00 00 00 4e 8d 1c 18 "
					"66 41 c7 03 00 00 41 c6 43 02 00 4c 8b 5c 24 80",
			"a zero-fill of 2^31 + 19 bytes through rax: the loop, then the tail through R11")
}

// wideRegMap returns a RegMap with IDs 1..n spilled at [rsp + 8 * (id - 1)].
func wideRegMap(n int) @common.RegMap {
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	for id := 1; id <= n; id++ {
		m.SpillIDs = common.AppendInt(m.SpillIDs, id)
		m.SpillOffsets = common.AppendInt64(m.SpillOffsets, cast(int64, 8 * (id - 1)))
	}
	return m
}

// widePtrTo returns an instruction with the given ID holding a *Big.
func widePtrTo(id int) @ir.Instr {
	var p @ir.Instr = make(ir.Instr)
	p.ID = id
	p.Typ = types.MakePointerType(wideBig())
	return p
}

// A fused field load and store at 2^31 through a pointer, and an OP_EXTRACT of the field
// from an aggregate held by pointer, go through the far paths.
func TestFieldAccessPast2GiBX64() testing.TestResult {
	setFarDispLimit(0)
	var gep @ir.Instr = make(ir.Instr)
	gep.ID = 2
	gep.Op = iropcode.OP_GET_FIELD_PTR
	gep.Index = 1
	gep.Args = make_slice(@ir.Instr, 1)
	gep.Args[0] = widePtrTo(1)
	var ld @ir.Instr = make(ir.Instr)
	ld.ID = 3
	ld.Op = iropcode.OP_LOAD
	ld.Typ = types.TypInt64()
	ld.Args = make_slice(@ir.Instr, 1)
	ld.Args[0] = gep
	var a @asm.Assembler = emitMkAsm()
	emitFusedFieldLoad(a, wideRegMap(3), ld, gep)
	var r testing.TestResult = x64FoldGolden(a,
			"4c 8b 14 24 49 bb 00 00 00 80 00 00 00 00 4f 8d 1c 1a 4d 8b 1b",
			"a fused field load at 2^31: mov r10, [rsp]; movabs r11; lea r11, [r10 + r11]; mov r11, [r11]")
	if len(r) > 0 { return r }
	var val @ir.Instr = make(ir.Instr)
	val.ID = 3
	val.Typ = types.TypInt64()
	var st @ir.Instr = make(ir.Instr)
	st.Op = iropcode.OP_STORE
	st.Args = make_slice(@ir.Instr, 2)
	st.Args[0] = gep
	st.Args[1] = val
	a = emitMkAsm()
	emitFusedFieldStore(a, "main", wideRegMap(3), st, gep)
	r = x64FoldGolden(a,
			"4c 8b 54 24 10 4c 8b 1c 24 48 89 44 24 80 48 b8 00 00 00 80 00 00 00 00 49 8d 04 03 "
					"4c 89 10 48 8b 44 24 80",
			"a fused field store at 2^31: through a saved RAX")
	if len(r) > 0 { return r }
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Op = iropcode.OP_LOAD
	src.Typ = wideBig()
	var ex @ir.Instr = make(ir.Instr)
	ex.ID = 2
	ex.Op = iropcode.OP_EXTRACT
	ex.Index = 1
	ex.Typ = types.TypInt64()
	ex.Args = make_slice(@ir.Instr, 1)
	ex.Args[0] = src
	a = emitMkAsm()
	emitExtract(a, wideRegMap(2), ex)
	return x64FoldGolden(a, "4c 8b 1c 24 49 ba 00 00 00 80 00 00 00 00 4f 8d 14 13 4d 8b 12",
			"an OP_EXTRACT of the field at 2^31: mov r11, [rsp]; through r10")
}

// OP_MAKE_SLICE of an element past 2^31 passes its size as a 64-bit immediate.
func TestMakeSlicePast2GiBX64() testing.TestResult {
	var m @common.RegMap = wideRegMap(1)
	m.AllocIDs = common.AppendInt(m.AllocIDs, 2)
	m.AllocOffsets = common.AppendInt64(m.AllocOffsets, 16)
	m.AllocSizes = common.AppendInt64(m.AllocSizes, 32)
	var n @ir.Instr = make(ir.Instr)
	n.ID = 1
	n.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_MAKE_SLICE
	ins.TypeArg = wideBig()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = n
	var a @asm.Assembler = emitMkAsm()
	emitMakeSlice(a, m, ins)
	if a.HasError { return fail("unexpected assembler error") }
	if !wideHas(a, "48 be 08 00 00 80 00 00 00 00") {
		return fail("rt.MakeManagedSlice's element size should be movabs rsi, 0x80000008")
	}
	return ""
}
