package "pkg/binate/native/x64"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Local end-to-end check for the x86_64 → Mach-O path: emit a Mach-O
// object with the amd64 backend, link it with the host toolchain
// (`clang -arch x86_64`), and run the result — under
// Rosetta on Apple Silicon, natively on Intel.  This is the slice
// that turns the amd64 backend from unit-test-only into something
// verifiable end-to-end on a dev machine.  Skipped (returns "")
// off-macOS or when Rosetta / the x86_64 toolchain isn't available.

// canRunX64Macho reports whether this host can link and run an
// x86-64 Mach-O: macOS (otool present) with Rosetta or native
// x86-64 (`arch -x86_64 true` succeeds).
func canRunX64Macho() bool {
	var ver @[]@[]char = make_slice(@[]char, 1)
	ver[0] = "--version"
	if execExit("otool", ver) != 0 { return false }
	var ra @[]@[]char = make_slice(@[]char, 2)
	ra[0] = "-x86_64"
	ra[1] = "true"
	return execExit("arch", ra) == 0
}

// Build a self-contained `__entry { __c_call("exit", 42) }` (exported as
// `main`) as an x86-64 Mach-O object, link it with `clang -arch x86_64`, run
// it, and assert the process exits 42.  Exercises the full amd64 Mach-O
// pipeline: '_'-prefixed symbols (Phase 3a), the x86-64 → Mach-O relocation
// mapping, and SysV-AMD64 prologue/call/ret.
func TestX64MachoExitsWithCode() testing.TestResult {
	if !canRunX64Macho() { return "" }

	var noP @[]@ir.Param
	var noR @[]@types.Type
	var noArgs @[]@ir.Instr
	var m @ir.Module = ir.NewModule("\"main\"")
	// Export the entry as `main` — emitted as the unmangled `_main` global
	// (symPrefixed), so the host crt0 calls it directly and the object links
	// with no C runtime or startup shim.
	var f @ir.Func = ir.NewFunc("", "__entry", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var c42 @ir.Instr = b.EmitConstInt(42, types.TypInt())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = c42
	b.EmitCCall("exit", args, nil, 1)
	b.EmitReturn(noArgs)
	var ce @[]@[]char = make_slice(@[]char, 1)
	ce[0] = buf.CopyStr("main")
	f.CExportNames = ce
	m.AddFunc(f)

	var objPath *[]readonly char = "/tmp/binate_x64_macho_exit42.o"
	if !EmitObject(m, "macho", objPath) {
		return fail("amd64 EmitObject(macho) returned false")
	}

	var exePath *[]readonly char = "/tmp/binate_x64_macho_exit42"
	var largs @[]@[]char = make_slice(@[]char, 6)
	largs[0] = "-arch"
	largs[1] = "x86_64"
	largs[2] = "-w"
	largs[3] = "-o"
	largs[4] = buf.CopyStr(exePath)
	largs[5] = buf.CopyStr(objPath)
	if execExit("clang", largs) != 0 {
		return fail("clang -arch x86_64 link failed")
	}

	// Direct exec — Rosetta runs the x86-64 Mach-O transparently.
	var runArgs @[]@[]char = make_slice(@[]char, 0)
	if execExit(exePath, runArgs) != 42 {
		return fail("expected the x86-64 binary to exit 42")
	}
	return ""
}
