package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/stringutils"
import "pkg/binate/types"
import "pkg/std/strings"

// ============================================================
// Managed memory + struct copy (Phase 3g)
// ============================================================
//
// Refcount, box, make, make-slice, aggregate const-nil, struct
// copy.  Split out of amd64_emit.bn along the natural Phase
// 3g-vs-3d boundary to keep amd64_emit.bn under the file-length
// soft cap.
//
// All runtime calls reach the C-compiled pkg/builtins/rt symbols via
// mangle.FuncName("pkg/builtins/rt", <fn>) — the bare mangled name, NOT
// symFor (which adds symbol-table package-qualification).  Routing through
// the mangler keeps these in lockstep with the scheme: Alloc / Box /
// RefInc / RefDec / MakeManagedSlice / ZeroRefDestroy.

// emitConstNil: OP_CONST_NIL — aggregate nil zero-inits its data
// region and produces a pointer.  Scalar nil is `mov rd, 0`.
// Mirrors aarch64's emitConstNil.
func emitConstNil(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if common.IsAggregateTyp(ins.Typ) {
		var dataOff int = rm.LookupAlloc(ins.ID)
		var sz int = rm.LookupAllocSize(ins.ID)
		if dataOff >= 0 && sz > 0 {
			for bo := 0; bo < sz; bo = bo + 8 {
				x64.Mov(a, x64.Mem(x64.RSP, dataOff + bo, x64.SZ64), x64.Imm(0))
			}
			var rd int = nextReg(rm, ins.ID)
			x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.Mem(x64.RSP, dataOff, x64.SZ64))
			return
		}
	}
	var rd int = nextReg(rm, ins.ID)
	x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Imm(0))
}

// refIncSeqX64 is a module-scoped counter for the unique inline RefInc skip
// labels (parallel to aarch64's refincSeq).
var refIncSeqX64 int

// refDecSeqX64 is a module-scoped counter for the unique inline RefDec skip
// labels (parallel to aarch64's refdecSeq).
var refDecSeqX64 int

// refcountSkipLabelX64 formats a per-emission unique local skip label with the
// given prefix (a leading `L` keeps it out of the symbol table on Mach-O/ELF).
func refcountSkipLabelX64(prefix *[]readonly char, seq int) @[]char {
	var out @strings.Builder = strings.NewBuilder()
	out.Write(prefix)
	stringutils.WriteInt(out, seq)
	return buf.CopyStr(out.String())
}

// refcountMemSizeX64 maps the managed header size to the x64 operand size of its
// refcount WORD (the first of the 2-word header): SZ64 on LP64, SZ32 on an
// ILP32-with-32-bit-pointer ABI.  Derived from ManagedHeaderSize() (= 2 *
// ptrSize) so the fast path is not LP64-hardcoded.
func refcountMemSizeX64(hdrBytes int) int {
	if hdrBytes / 2 == 8 { return x64.SZ64 }
	return x64.SZ32
}

// emitFuncHandleAddr materializes the address of a function's static handle
// (`__handle.<mangled>`) into rd via a RIP-relative LEA.  Shared by the
// OP_FUNC_HANDLE dispatch and the inline RefDec slow path, which sinks a folded
// dtor handle here so the LEA runs only on the branch that frees.
func emitFuncHandleAddr(a @asm.Assembler, pkgName *[]readonly char, rd int,
		funcName *[]readonly char) {
	var label @[]char = handleSymFor_x64(pkgName, funcName)
	a.SetGlobal(label)
	x64.LeaRipLabel(a, x64.Reg(rd, x64.SZ64), label)
}

// emitRefInc: OP_REFINC — inline fast path mirroring aarch64_refcount.bn's
// emitRefIncInline: nil-check, immortal-check, in-place header increment, no
// runtime call.  The refcount word is the first of the 2-word managed header at
// [ptr - hdrBytes]; its immortal-static sentinel (rt.STATIC_REFCOUNT) is its
// high (sign) bit, so a negative value skips the mutation.  Header size / word
// width come from ManagedHeaderSize() so the fast path is ILP32-correct, not
// LP64-hardcoded.  x64 addresses the header word directly ([ptr - hdrBytes]) and
// mutates it in place, so no scratch register is needed.
//
//   test ptr, ptr
//   jz   .Lx64ri_<seq>
//   cmp  <word> [ptr - hdrBytes], 0
//   js   .Lx64ri_<seq>              ; negative → immortal, skip
//   add  <word> [ptr - hdrBytes], 1
// .Lx64ri_<seq>:
func emitRefInc(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var ptr int = getOperand(a, rm, ins.Args[0].ID)
	if ptr < 0 { return }
	var hdrBytes int = types.ManagedHeaderSize()
	var negHdr int = 0 - hdrBytes
	var memSz int = refcountMemSizeX64(hdrBytes)
	var skip @[]char = refcountSkipLabelX64("Lx64ri_", refIncSeqX64)
	refIncSeqX64 = refIncSeqX64 + 1
	x64.Test(a, x64.Reg(ptr, x64.SZ64), x64.Reg(ptr, x64.SZ64))
	x64.Jcc(a, x64.CC_Z, skip)
	x64.Cmp(a, x64.Mem(ptr, negHdr, memSz), x64.Imm(0))
	x64.Jcc(a, x64.CC_S, skip)
	x64.Add(a, x64.Mem(ptr, negHdr, memSz), x64.Imm(1))
	a.DefineLabel(skip)
}

// emitRefDec: OP_REFDEC — inline fast path mirroring aarch64_refcount.bn's
// emitRefDecInline: nil-check, immortal-check, in-place decrement, and a
// slow-path `rt.ZeroRefDestroy(ptr, dtor)` call only when the count hits zero.
// The decrement is a single memory read-modify-write (`sub <word>[ptr-hdr], 1`)
// that sets ZF from the stored result, so `jnz` reads it directly — no separate
// load/store or compare.  SysV-AMD64: RDI = ptr, RSI = dtor (or 0).
//
//   test ptr, ptr
//   jz   .Lx64rd_<seq>
//   cmp  <word> [ptr - hdrBytes], 0
//   js   .Lx64rd_<seq>              ; negative → immortal, skip
//   sub  <word> [ptr - hdrBytes], 1
//   jnz  .Lx64rd_<seq>              ; refcount > 0 → skip
//   mov  rdi, ptr
//   <dtor → rsi>                    ; static handle materialized HERE (past the
//   call rt.ZeroRefDestroy          ;  zero-test), or reloaded, or 0
// .Lx64rd_<seq>:
func emitRefDec(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var ptr int = getOperand(a, rm, ins.Args[0].ID)
	if ptr < 0 { return }
	var hdrBytes int = types.ManagedHeaderSize()
	var negHdr int = 0 - hdrBytes
	var memSz int = refcountMemSizeX64(hdrBytes)
	var skip @[]char = refcountSkipLabelX64("Lx64rd_", refDecSeqX64)
	refDecSeqX64 = refDecSeqX64 + 1
	x64.Test(a, x64.Reg(ptr, x64.SZ64), x64.Reg(ptr, x64.SZ64))
	x64.Jcc(a, x64.CC_Z, skip)
	x64.Cmp(a, x64.Mem(ptr, negHdr, memSz), x64.Imm(0))
	x64.Jcc(a, x64.CC_S, skip)
	x64.Sub(a, x64.Mem(ptr, negHdr, memSz), x64.Imm(1))
	x64.Jcc(a, x64.CC_NZ, skip)
	// Slow path: refcount hit zero. Set up RDI=ptr, RSI=dtor, call
	// rt.ZeroRefDestroy.  For the runtime-loaded dtor (OP_FUNC_VALUE_DTOR)
	// resolve its register FIRST — before RDI is overwritten — since neither ptr
	// nor dtor is ever homed in RSI (RSI is not allocatable), so only the
	// RDI-first ordering can collide.
	var isFuncHandle bool = len(ins.Args) > 1 && ins.Args[1].Op == iropcode.OP_FUNC_HANDLE
	var dtor int = -1
	if len(ins.Args) > 1 && !isFuncHandle {
		dtor = getOperand(a, rm, ins.Args[1].ID)
		if dtor < 0 { return }
	}
	if ptr != x64.RDI {
		x64.Mov(a, x64.Reg(x64.RDI, x64.SZ64), x64.Reg(ptr, x64.SZ64))
	}
	if isFuncHandle {
		// Static dtor handle: materialize `&__handle.<dtor>` into RSI HERE, past
		// the zero-test, rather than before it.
		emitFuncHandleAddr(a, pkgName, x64.RSI, ins.Args[1].StrVal)
	} else if dtor >= 0 {
		if dtor != x64.RSI {
			x64.Mov(a, x64.Reg(x64.RSI, x64.SZ64), x64.Reg(dtor, x64.SZ64))
		}
	} else {
		x64.Mov(a, x64.Reg(x64.RSI, x64.SZ64), x64.Imm(0))
	}
	var sym @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "ZeroRefDestroy"))
	a.SetGlobal(sym)
	x64.Call(a, sym)
	a.DefineLabel(skip)
}

// emitMake: OP_MAKE — call `rt.Alloc`(SizeOf(T)) for a fresh
// zero-initialised @T with refcount=1.  Result (RAX) → rd.
func emitMake(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if ins.TypeArg == nil { return }
	x64.Mov(a, x64.Reg(x64.RDI, x64.SZ64), x64.Imm(ins.TypeArg.SizeOf()))
	var sym @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "Alloc"))
	a.SetGlobal(sym)
	x64.Call(a, sym)
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	if rd != x64.RAX {
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
	}
}

// emitBox: OP_BOX — call `rt.Box`(srcPtr, size) to heap-copy
// val.  Two source shapes:
//   - OP_ALLOC: srcPtr = LEA [rsp + allocOff]; size = TypeArg.SizeOf()
//   - Aggregate Load / Extract / etc.: srcPtr = the operand's
//     spill pointer; size = val.Typ.SizeOf()
func emitBox(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var val @ir.Instr = ins.Args[0]
	var sz int = 0
	if val.Op == iropcode.OP_ALLOC && val.TypeArg != nil {
		var allocOff int = rm.LookupAlloc(val.ID)
		if allocOff < 0 { return }
		x64.Lea(a, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSP, allocOff, x64.SZ64))
		sz = val.TypeArg.SizeOf()
	} else if common.IsAggregateTyp(val.Typ) {
		var src int = getOperand(a, rm, val.ID)
		if src < 0 { return }
		if src != x64.RDI {
			x64.Mov(a, x64.Reg(x64.RDI, x64.SZ64), x64.Reg(src, x64.SZ64))
		}
		sz = val.Typ.SizeOf()
	} else if val.Typ != nil {
		// Scalar source: spill the value into its frame slot, then box from
		// that slot's address (rt.Box copies SizeOf(T) bytes).  Mirrors the
		// aa64 scalar arm / the LLVM scalar path; the per-value spill slot
		// (PlanFrame) is reused for the function's lifetime.
		var src int = getOperand(a, rm, val.ID)
		if src < 0 { return }
		var off int = rm.LookupSpill(val.ID)
		if off < 0 { return }
		x64.Mov(a, x64.Mem(x64.RSP, off, x64.SZ64), x64.Reg(src, x64.SZ64))
		x64.Lea(a, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSP, off, x64.SZ64))
		sz = val.Typ.SizeOf()
	} else {
		// No type info — cannot size the copy; leave unhandled.
		return
	}
	x64.Mov(a, x64.Reg(x64.RSI, x64.SZ64), x64.Imm(sz))
	var sym @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "Box"))
	a.SetGlobal(sym)
	x64.Call(a, sym)
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	if rd != x64.RAX {
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
	}
}

// emitMakeSlice: OP_MAKE_SLICE — call `rt.MakeManagedSlice`.
// The runtime returns a 32-byte managed-slice header, which on
// SysV-AMD64 (InternalSretBytes=16) is sret-returned via a hidden
// RDI buffer pointer.  All other args shift by one:
//   RDI = &data_region (the 32-byte buffer we hand it)
//   RSI = elemSize
//   RDX = len
// After CALL, data_region holds the header; rd = data_region addr.
//
// Matches aarch64's lowering: both AAPCS64 and SysV use a 16-byte
// internal-sret threshold, so the 32-byte managed-slice header is
// returned via the hidden buffer pointer on both targets.
func emitMakeSlice(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 || ins.TypeArg == nil { return }
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	var lenReg int = getOperand(a, rm, ins.Args[0].ID)
	if lenReg < 0 { return }
	// Move len to RDX first (since the sret-buffer LEA goes to RDI
	// and elemSize to RSI), so the RDI/RSI setup doesn't clobber
	// the len before we capture it.
	if lenReg != x64.RDX {
		x64.Mov(a, x64.Reg(x64.RDX, x64.SZ64), x64.Reg(lenReg, x64.SZ64))
	}
	x64.Lea(a, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSP, dataOff, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.RSI, x64.SZ64), x64.Imm(ins.TypeArg.SizeOf()))
	var sym @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "MakeManagedSlice"))
	a.SetGlobal(sym)
	x64.Call(a, sym)
	rm.ResetRegs()
	var rd int = nextReg(rm, ins.ID)
	x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.Mem(x64.RSP, dataOff, x64.SZ64))
}

// emitStructCopy: OP_STORE where the source is an aggregate.
// Memcpy via emitAggMemcpyX64 (16-byte MOVUPS chunks + an 8-byte-word tail).
// Either endpoint may be a package-level global, reached via
// emitGlobalAddr (RIP-relative LEA).
func emitStructCopy(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	if ins.Args[1].Typ == nil { return }
	var sz int = ins.Args[1].Typ.SizeOf()
	if sz <= 0 { return }

	var srcPtr int
	if isGlobalRef(ins.Args[1]) {
		srcPtr = scratchReg(rm)
		emitGlobalAddr(a, pkgName, srcPtr, ins.Args[1])
	} else if common.IsMultiReturnCall(ins.Args[1]) {
		// Multi-return spill holds the N*8 bytes themselves; the
		// address of those bytes is the source for the copy.
		var srcOff int = rm.LookupSpill(ins.Args[1].ID)
		if srcOff < 0 { return }
		srcPtr = scratchReg(rm)
		x64.Lea(a, x64.Reg(srcPtr, x64.SZ64), x64.Mem(x64.RSP, srcOff, x64.SZ64))
	} else {
		srcPtr = getOperand(a, rm, ins.Args[1].ID)
	}
	if srcPtr < 0 { return }

	var dstPtr int
	var allocOff int = rm.LookupAlloc(ins.Args[0].ID)
	if allocOff >= 0 {
		dstPtr = scratchReg(rm)
		x64.Lea(a, x64.Reg(dstPtr, x64.SZ64), x64.Mem(x64.RSP, allocOff, x64.SZ64))
	} else if isGlobalRef(ins.Args[0]) {
		dstPtr = scratchReg(rm)
		emitGlobalAddr(a, pkgName, dstPtr, ins.Args[0])
	} else {
		dstPtr = getOperand(a, rm, ins.Args[0].ID)
	}
	if dstPtr < 0 { return }

	emitAggMemcpySafeX64(a, rm, dstPtr, srcPtr, sz, scratchReg(rm))
}
