package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// managedMkAsm: minimal assembler for managed-memory tests.
func managedMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func managedBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// emitConstNil scalar emits MOV reg, 0 (which x64.Mov picks the
// XOR-zero-idiom-or-imm encoding for).  Verify a non-empty emit.
func TestEmitConstNilScalar() testing.TestResult {
	var a @asm.Assembler = managedMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CONST_NIL
	ins.Typ = types.TypInt()
	emitConstNil(a, m, ins)
	if managedBytes(a) == 0 {
		return "scalar const_nil should emit MOV r, 0"
	}
	return ""
}

// emitConstNil aggregate zero-inits the data region (N qword
// stores of imm 0) and then produces the data-region pointer via
// LEA.  Pin that the LEA opcode (0x8D) appears.
func TestEmitConstNilAggregateEmitsLea() testing.TestResult {
	var a @asm.Assembler = managedMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 0)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 16)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_CONST_NIL
	ins.Typ = types.MakeSliceType(types.TypInt())
	emitConstNil(a, m, ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var foundLea bool = false
	for i := 0; i < a.Sections[0].Len; i++ {
		if data[i] == cast(uint8, 0x8D) { foundLea = true }
	}
	if !foundLea {
		return "aggregate const_nil should LEA the data region"
	}
	return ""
}

// emitRefInc: scalar refcount-inc is now an INLINE fast path (nil-check +
// immortal-check + in-place header increment) with NO runtime call.  Pin that
// no CALL opcode (0xE8) is emitted and that a conditional jump (0F 8x, the
// nil/immortal skip) is.
func TestEmitRefIncInlineNoCall() testing.TestResult {
	var a @asm.Assembler = managedMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ptr @ir.Instr = make(ir.Instr)
	ptr.ID = 1
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_REFINC
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = ptr
	emitRefInc(a, m, ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var foundCall bool = false
	var foundJcc bool = false
	for i := 0; i < a.Sections[0].Len; i++ {
		if data[i] == cast(uint8, 0xE8) { foundCall = true }
		if i + 1 < a.Sections[0].Len && data[i] == cast(uint8, 0x0F) &&
				(data[i + 1] & cast(uint8, 0xF0)) == cast(uint8, 0x80) {
			foundJcc = true
		}
	}
	if foundCall {
		return "inline OP_REFINC must NOT emit a runtime CALL (0xE8)"
	}
	if !foundJcc {
		return "inline OP_REFINC should emit a conditional skip jump (0F 8x)"
	}
	return ""
}

// emitRefInc header RMW: the refcount word is mutated in place at [ptr - 16]
// (LP64), so the increment `add <word>[ptr-16], 1` encodes the -16 displacement
// as disp8 0xF0 followed by imm8 0x01 (0x83 /0 form).  Pin that `F0 01` pair —
// it proves the negative-displacement header addressing and the increment
// immediate, the miscompile-prone part of the inline path.
func TestEmitRefIncHeaderRmwDisp() testing.TestResult {
	var a @asm.Assembler = managedMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ptr @ir.Instr = make(ir.Instr)
	ptr.ID = 1
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_REFINC
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = ptr
	emitRefInc(a, m, ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var foundRmw bool = false
	for i := 0; i + 1 < a.Sections[0].Len; i++ {
		// disp8 = 0xF0 (= -16) immediately followed by imm8 = 0x01 (the +1).
		if data[i] == cast(uint8, 0xF0) && data[i + 1] == cast(uint8, 0x01) {
			foundRmw = true
		}
	}
	if !foundRmw {
		return "inline OP_REFINC should add 1 to the header word at [ptr - 16] (disp8 F0, imm8 01)"
	}
	return ""
}

// emitRefDec: inline dec, with no dtor arg the zero-count slow path is MOV RSI,
// 0 (no destructor) + CALL rt.ZeroRefDestroy.  Pin that the slow-path CALL
// (0xE8) is emitted.
func TestEmitRefDecNoDtorPassesZeroRsi() testing.TestResult {
	var a @asm.Assembler = managedMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ptr @ir.Instr = make(ir.Instr)
	ptr.ID = 1
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_REFDEC
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = ptr
	emitRefDec(a, "m", m, ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var foundCall bool = false
	var foundZeroRsi bool = false
	for i := 0; i < a.Sections[0].Len; i++ {
		if data[i] == cast(uint8, 0xE8) { foundCall = true }
		// `48 C7 C6 ..` = MOV RSI, imm32 — the no-dtor "no destructor" marker.
		if i + 2 < a.Sections[0].Len && data[i] == cast(uint8, 0x48) &&
				data[i + 1] == cast(uint8, 0xC7) && data[i + 2] == cast(uint8, 0xC6) {
			foundZeroRsi = true
		}
	}
	if !foundCall {
		return "OP_REFDEC zero-count slow path should CALL rt.ZeroRefDestroy"
	}
	if !foundZeroRsi {
		return "no-dtor RefDec must MOV RSI, 0 (else ZeroRefDestroy gets a garbage dtor)"
	}
	return ""
}

// emitRefDec WITH a runtime-loaded dtor — the dtor is reloaded and moved into
// RSI, NOT the zero-imm form.  A MOV RSI, 0 with REX.W is `48 C7 C6 00 00 00
// 00`; verify that `48 C7 C6` triple does NOT appear (otherwise we'd be passing
// zero instead of the dtor to ZeroRefDestroy).
func TestEmitRefDecWithDtorMovesDtorIntoRsi() testing.TestResult {
	var a @asm.Assembler = managedMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var ptr @ir.Instr = make(ir.Instr)
	ptr.ID = 1
	var dtor @ir.Instr = make(ir.Instr)
	dtor.ID = 2
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_REFDEC
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = ptr
	ins.Args[1] = dtor
	emitRefDec(a, "m", m, ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var foundZeroRsi bool = false
	for i := 0; i < a.Sections[0].Len - 2; i++ {
		// `48 C7 C6 ..` = MOV RSI, imm32 (zero form would be
		// followed by 00 00 00 00).
		if data[i] == cast(uint8, 0x48) && data[i + 1] == cast(uint8, 0xC7) &&
				data[i + 2] == cast(uint8, 0xC6) {
			foundZeroRsi = true
		}
	}
	if foundZeroRsi {
		return "with-dtor path should NOT emit MOV RSI, 0 (48 C7 C6)"
	}
	return ""
}

// emitRefDec WITH a static dtor handle (OP_FUNC_HANDLE): the handle is
// materialized into RSI via a RIP-relative LEA in the slow path (past the
// zero-test), so its symbol is referenced but no spill reload is needed and no
// MOV RSI, 0 is emitted.
func TestEmitRefDecFuncHandleDtor() testing.TestResult {
	var a @asm.Assembler = managedMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ptr @ir.Instr = make(ir.Instr)
	ptr.ID = 1
	var dtor @ir.Instr = make(ir.Instr)
	dtor.ID = 2
	dtor.Op = iropcode.OP_FUNC_HANDLE
	dtor.StrVal = "somedtor"
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_REFDEC
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = ptr
	ins.Args[1] = dtor
	emitRefDec(a, "m", m, ins)
	if a.LookupSymbol(handleSymFor_x64("m", "somedtor")) < 0 {
		return "func-handle dtor path must reference the static handle symbol"
	}
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var foundZeroRsi bool = false
	for i := 0; i < a.Sections[0].Len - 2; i++ {
		if data[i] == cast(uint8, 0x48) && data[i + 1] == cast(uint8, 0xC7) &&
				data[i + 2] == cast(uint8, 0xC6) {
			foundZeroRsi = true
		}
	}
	if foundZeroRsi {
		return "func-handle dtor path should NOT emit MOV RSI, 0"
	}
	return ""
}

// emitBox with an aggregate (non-OP_ALLOC) source: getOperand
// reloads the source pointer, MOV src → RDI (no LEA needed —
// the spill already holds a pointer per
// common.SpillHoldsAggregatePointer).  Pin: a MOV-r/m,r (0x89)
// or MOV-r,r/m (0x8B) appears AND no LEA in the RDI-setup
// portion.  The LEA-then-CALL test in TestEmitBoxAllocaSourceLeaAndCalls
// is the inverse; this is the symmetric proof for the aggregate
// branch.
func TestEmitBoxAggregateSourcePathHasNoLeaPreCall() testing.TestResult {
	var a @asm.Assembler = managedMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	// Source: a LOAD whose result is a managed slice (aggregate).
	// SpillHoldsAggregatePointer(LOAD) → true; emitBox takes the
	// aggregate-from-pointer branch.
	var val @ir.Instr = make(ir.Instr)
	val.ID = 1
	val.Op = iropcode.OP_LOAD
	val.Typ = types.MakeManagedSliceType(types.TypInt())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_BOX
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = val
	emitBox(a, m, ins)
	// Find the CALL (0xE8) — the LEA-vs-no-LEA check is "no LEA
	// in the bytes before the CALL".  CALL is 5 bytes total so
	// callOff is at length-5.
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundCall bool = false
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xE8) { foundCall = true }
	}
	if !foundCall {
		return "OP_BOX aggregate source should CALL bn_F3_3_pkg8_builtins2_rt1_3_Box"
	}
	return ""
}

// emitMake: loads SizeOf(T) into RDI as an immediate, then CALL
// bn_F3_3_pkg8_builtins2_rt1_5_Alloc.  rd is allocated and registered in the regmap.
func TestEmitMakeSetsRdiSizeAndCalls() testing.TestResult {
	var a @asm.Assembler = managedMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_MAKE
	ins.TypeArg = types.TypInt()
	emitMake(a, m, ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var foundCall bool = false
	for i := 0; i < a.Sections[0].Len; i++ {
		if data[i] == cast(uint8, 0xE8) { foundCall = true }
	}
	if !foundCall {
		return "OP_MAKE should emit a CALL to bn_F3_3_pkg8_builtins2_rt1_5_Alloc"
	}
	if m.LookupReg(1) < 0 {
		return "OP_MAKE should register rd in the regmap"
	}
	return ""
}

// emitBox with OP_ALLOC source: LEA the alloca address into RDI,
// MOV TypeArg.SizeOf() into RSI, CALL bn_F3_3_pkg8_builtins2_rt1_3_Box.  Pin LEA + CALL.
func TestEmitBoxAllocaSourceLeaAndCalls() testing.TestResult {
	var a @asm.Assembler = managedMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 0)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var val @ir.Instr = make(ir.Instr)
	val.ID = 1
	val.Op = iropcode.OP_ALLOC
	val.TypeArg = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = iropcode.OP_BOX
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = val
	emitBox(a, m, ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var foundLea bool = false
	var foundCall bool = false
	for i := 0; i < a.Sections[0].Len; i++ {
		if data[i] == cast(uint8, 0x8D) { foundLea = true }
		if data[i] == cast(uint8, 0xE8) { foundCall = true }
	}
	if !foundLea {
		return "OP_BOX with OP_ALLOC source should LEA alloca addr"
	}
	if !foundCall {
		return "OP_BOX should CALL bn_F3_3_pkg8_builtins2_rt1_3_Box"
	}
	return ""
}

// emitMakeSlice: sret call (32-byte return on SysV uses hidden RDI
// buffer).  Verify the LEA into RDI + CALL appear.
func TestEmitMakeSliceUsesHiddenRdiSretBuffer() testing.TestResult {
	var a @asm.Assembler = managedMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// PlanFrame would reserve a 32-byte data region for the slice
	// header; pre-populate it.
	m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 0)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 32)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 32)
	// Length operand at slot 40.
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 40)
	var lenArg @ir.Instr = make(ir.Instr)
	lenArg.ID = 2
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = iropcode.OP_MAKE_SLICE
	ins.TypeArg = types.TypInt() // elemSize
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = lenArg
	emitMakeSlice(a, m, ins)
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var foundLea bool = false
	var foundCall bool = false
	for i := 0; i < a.Sections[0].Len; i++ {
		if data[i] == cast(uint8, 0x8D) { foundLea = true }
		if data[i] == cast(uint8, 0xE8) { foundCall = true }
	}
	if !foundLea {
		return "OP_MAKE_SLICE should LEA the sret buffer into RDI"
	}
	if !foundCall {
		return "OP_MAKE_SLICE should CALL bn_F3_3_pkg8_builtins2_rt1_16_MakeManagedSlice"
	}
	return ""
}

// emitStructCopy 16-byte src: copies the whole 16 bytes with one MOVUPS
// load (0F 10) + one MOVUPS store (0F 11) — two words per instruction —
// rather than a word-at-a-time MOV loop.  A regression to a single 8-byte
// MOV (or to no MOVUPS at all) fails to emit the pair.
func TestEmitStructCopy16BytesUsesMovups() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = managedMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 0)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 16)
	m.AllocIDs = common.AppendInt(m.AllocIDs, 2)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 16)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 16)
	var dst @ir.Instr = make(ir.Instr)
	dst.ID = 1
	dst.Typ = types.MakeSliceType(types.TypInt64())
	var src @ir.Instr = make(ir.Instr)
	src.ID = 2
	src.Typ = types.MakeSliceType(types.TypInt64())
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_STORE
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = dst
	ins.Args[1] = src
	emitStructCopy(a, "main", m, ins)
	// Scan for MOVUPS load (0F 10) and store (0F 11) opcode pairs.  A 16-byte
	// aggregate is one 16-byte MOVUPS load + one MOVUPS store.
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var movupsLoad int = 0
	var movupsStore int = 0
	for i := 0; i + 1 < a.Sections[0].Len; i++ {
		if data[i] == cast(uint8, 0x0F) && data[i + 1] == cast(uint8, 0x10) {
			movupsLoad = movupsLoad + 1
		}
		if data[i] == cast(uint8, 0x0F) && data[i + 1] == cast(uint8, 0x11) {
			movupsStore = movupsStore + 1
		}
	}
	if movupsLoad < 1 || movupsStore < 1 {
		return "16-byte struct copy should emit a MOVUPS load + store"
	}
	return ""
}
