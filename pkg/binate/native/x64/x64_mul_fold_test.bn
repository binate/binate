package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the x64 multiply-immediate fold (x64MulImm and emitMulImmFoldX64 in
// x64_fold.bn).  Each golden is the full emitBinop output for a spilled register
// operand: the reload (`mov r10, qword ptr [rsp]`), then `imul r11, r10, imm`
// (or the strength-reduced copy + shift), and the sub-word re-narrow when the
// register path would emit one.  The expected bytes are clang's (x86_64)
// encodings of that assembly; none materializes the constant.

// A multiplier folds on either side; an int64 one only within the sign-extended
// imm32, while a uint32 one (a 32-bit multiply) folds whatever its value.
func TestX64ImmFitsMulRange() testing.TestResult {
	var big int64 = cast(int64, 0x80000000)
	if !x64ImmBinopFolded(iropcode.OP_MUL, types.TypInt64(), cast(int64, 1000), false) {
		return "int64 x * 1000 must fold"
	}
	if !x64ImmBinopFolded(iropcode.OP_MUL, types.TypInt64(), cast(int64, 1000), true) {
		return "int64 1000 * x must fold"
	}
	if !x64ImmBinopFolded(iropcode.OP_MUL, types.TypInt64(), x64ImmMax, false) {
		return "int64 x * (2^31-1) must fold"
	}
	if x64ImmBinopFolded(iropcode.OP_MUL, types.TypInt64(), big + cast(int64, 1), false) {
		return "int64 x * (2^31+1) must not fold"
	}
	if !x64ImmBinopFolded(iropcode.OP_MUL, types.TypUint32(), cast(int64, 0x9E3779B9), false) {
		return "uint32 x * 0x9e3779b9 must fold"
	}
	return ""
}

// A power-of-two multiplier folds at any magnitude: it becomes a shift, which
// needs no immediate.
func TestX64ImmFitsMulPow2AnySize() testing.TestResult {
	var pow40 int64 = cast(int64, 1) << 40
	if !x64ImmBinopFolded(iropcode.OP_MUL, types.TypInt64(), pow40, false) {
		return "int64 x * 2^40 must fold (a shift)"
	}
	var shift bool
	var ok bool
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt64(b, pow40, types.TypInt64())
	var ins @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_MUL, x64ImmParam(f, types.TypInt64()), c,
			types.TypInt64())
	_, _, shift, ok = x64MulImm(ins, 1)
	if !ok || !shift { return "x * 2^40 must take the shift form" }
	return ""
}

// The uint32 immediate is the multiplier's low 32 bits as a signed imm32.
func TestX64MulImmUint32Signed() testing.TestResult {
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt64(b, cast(int64, 0x9E3779B9), types.TypUint32())
	var ins @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_MUL, x64ImmParam(f, types.TypUint32()), c,
			types.TypUint32())
	var imm int64
	var ok bool
	imm, _, _, ok = x64MulImm(ins, 1)
	if !ok || imm != cast(int64, -1640531527) {
		return "uint32 0x9e3779b9 must encode as imm32 -1640531527"
	}
	return ""
}

// A multiplier shared with a DIV operand (no immediate position) stays
// materialized.
func TestX64ImmFitsMulSharedWithDiv() testing.TestResult {
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt64(b, cast(int64, 7), types.TypInt())
	var x @ir.Instr = x64ImmParam(f, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_MUL, x, c, types.TypInt())
	if !x64ImmFolded(f, c) { return "a multiplier used only by a MUL must fold" }
	_ = irbuild.EmitBinop(b, iropcode.OP_DIV, x, c, types.TypInt())
	if x64ImmFolded(f, c) { return "a multiplier also used by a DIV must not fold" }
	return ""
}

// The three-operand IMUL reads the register directly: imm8 and imm32 forms, a
// constant on the left, a uint32 multiply (32-bit form, no re-narrow) and an
// int8 one (64-bit form, re-narrowed).
func TestX64MulImmFoldGoldens() testing.TestResult {
	var r testing.TestResult
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_MUL, 1, 2, cast(int64, 5), 1, types.TypInt64())
	r = x64FoldGolden(a, "4c 8b 14 24 4d 6b da 05", "x * 5")
	if len(r) != 0 { return r }
	a = x64FoldImmBinop(iropcode.OP_MUL, 1, 2, cast(int64, 1000), 0, types.TypInt64())
	r = x64FoldGolden(a, "4c 8b 14 24 4d 69 da e8 03 00 00", "1000 * x")
	if len(r) != 0 { return r }
	a = x64FoldImmBinop(iropcode.OP_MUL, 1, 2, cast(int64, 0x1000193), 1, types.TypUint32())
	r = x64FoldGolden(a, "4c 8b 14 24 45 69 da 93 01 00 01", "x * 0x1000193 (uint32)")
	if len(r) != 0 { return r }
	a = x64FoldImmBinop(iropcode.OP_MUL, 1, 2, cast(int64, 0x9E3779B9), 1, types.TypUint32())
	r = x64FoldGolden(a, "4c 8b 14 24 45 69 da b9 79 37 9e", "x * 0x9e3779b9 (uint32)")
	if len(r) != 0 { return r }
	a = x64FoldImmBinop(iropcode.OP_MUL, 1, 2, cast(int64, -7), 1, types.TypInt8())
	return x64FoldGolden(a, "4c 8b 14 24 4d 6b da f9 4d 0f be db", "x * -7 (int8)")
}

// A power-of-two multiplier is a copy and a shift, not an IMUL.
func TestX64MulImmFoldPow2Golden() testing.TestResult {
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_MUL, 1, 2, cast(int64, 8), 1, types.TypInt64())
	return x64FoldGolden(a, "4c 8b 14 24 4d 89 d3 49 c1 e3 03", "x * 8")
}

// A folded multiplier that does not fit (an int64 beyond imm32) records an
// error instead of emitting a wrong multiply.
func TestX64MulImmFoldMisfitErrors() testing.TestResult {
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_MUL, 1, 2, cast(int64, 0x100000001), 1,
			types.TypInt64())
	if !a.HasError { return "a misfit folded multiplier must record an error" }
	return ""
}
