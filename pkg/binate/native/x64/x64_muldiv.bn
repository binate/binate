package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/native/strength"
import "pkg/binate/types"

// Constant multiply/divide/modulo strength reduction for the x64 backend.  When
// the second operand of an OP_MUL / OP_DIV / OP_REM is a compile-time constant,
// emit a Granlund-Montgomery magic-number multiply (one-operand IMUL/MUL →
// RDX:RAX, RDX = the multiply-high) plus shifts, a power-of-two shift, or a bare
// move/neg — instead of a hardware IDIV/DIV.  Mirrors native/aarch64; the
// magic-constant math is the shared strength.ComputeMagic* helper.
//
// x64 works at 64 bits: operands are kept sign/zero-extended to the host word,
// so a 64-bit magic divide of the extended value equals the true (possibly
// sub-word) divide, and the caller re-narrows the result.
//
// Register discipline: the one-operand IMUL/MUL clobber RDX:RAX.  scratchReg
// never returns RAX (not in the pool).  The magic-number path claims one pool
// scratch `w` — the 1st or 2nd allocated (after at most one `lhs` reload), so
// R10/R11, never RDX — which holds the multiplier for the MUL and is then
// reused as the correction temp; the multiply-high stays in RDX, which the path
// claims (MarkUsed) so no later allocation lands on it.  Together with `lhs`
// and the result, that is at most four pool registers (lhs, w, RDX, rd) — the
// most any lowering may claim.  `lhs` is a home reg or an R10 reload, never
// RAX/RDX, so it is readable after the multiply for the AddN/SubN correction
// and the REM `n - q*c`.

const xWordW int = 64

// constDivisorX64 returns (value, true) when ins's second operand is a
// compile-time integer constant.
func constDivisorX64(ins @ir.Instr) (int64, bool) {
	if len(ins.Args) != 2 {
		return cast(int64, 0), false
	}
	var b @ir.Instr = ins.Args[1]
	if b == nil || b.Op != iropcode.OP_CONST_INT {
		return cast(int64, 0), false
	}
	return b.IntVal, true
}

// r64 is shorthand for a 64-bit register operand.
func r64(reg int) x64.Operand {
	return x64.Reg(reg, x64.SZ64)
}

// constMulReducibleX64 reports whether emitConstMulX64 strength-reduces a
// multiply by c (0, ±1, ±2^k), so the multiply needs no IMUL.
func constMulReducibleX64(c int64) bool {
	if c == cast(int64, 0) || c == cast(int64, 1) || c == cast(int64, -1) { return true }
	return strength.Pow2Log(strength.AbsU64(c)) >= 1
}

// emitConstMulX64 strength-reduces `rd * c` in place (rd already holds the
// multiplicand): 0 -> zero, 1 -> unchanged, -1 -> neg, ±2^k -> shift (+ neg).
// Returns true when handled; false to fall through to the register IMUL.
func emitConstMulX64(a @asm.Assembler, rd int, c int64) bool {
	if c == cast(int64, 0) {
		x64.Mov(a, r64(rd), x64.Imm(0))
		return true
	}
	if c == cast(int64, 1) {
		return true
	}
	if c == cast(int64, -1) {
		x64.Neg(a, r64(rd))
		return true
	}
	var k int = strength.Pow2Log(strength.AbsU64(c))
	if k >= 1 {
		x64.Shl(a, r64(rd), x64.Imm(k))
		if c < cast(int64, 0) {
			x64.Neg(a, r64(rd))
		}
		return true
	}
	return false
}

// emitConstDivRemX64 lowers OP_DIV / OP_REM by the nonzero constant `c`.
// Handles operand fetch, result allocation, and sub-word narrowing.
func emitConstDivRemX64(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr, c int64) bool {
	var lhs int = getOperand(a, rm, ins.Args[0].ID)
	if lhs < 0 {
		return false
	}
	var uTyp @types.Type = types.StripWrappers(ins.Typ)
	var isUnsigned bool = uTyp != nil && uTyp.IsInteger() && !uTyp.Signed
	var isRem bool = ins.Op == iropcode.OP_REM

	// n / (±1) and n % (±1).
	if c == cast(int64, 1) || (!isUnsigned && c == cast(int64, -1)) {
		var rd int = nextReg(rm, ins.ID)
		if isRem {
			x64.Mov(a, r64(rd), x64.Imm(0))
		} else if c == cast(int64, 1) {
			x64.Mov(a, r64(rd), r64(lhs))
		} else {
			x64.Mov(a, r64(rd), r64(lhs))
			x64.Neg(a, r64(rd))
		}
		emitSubWordNarrow(a, rd, ins.Typ)
		return true
	}

	// Unsigned n % 2^k is a low-bit mask (cheaper than quotient + n-q*d).
	if isRem && isUnsigned {
		var k int = strength.Pow2Log(cast(uint64, c))
		if k >= 1 {
			var rd int = nextReg(rm, ins.ID)
			x64.Mov(a, r64(rd), r64(lhs))
			x64.Shl(a, r64(rd), x64.Imm(xWordW - k))
			x64.Shr(a, r64(rd), x64.Imm(xWordW - k))
			emitSubWordNarrow(a, rd, ins.Typ)
			return true
		}
	}

	// Compute the quotient into a scratch, then finalize.  spare is a register
	// already claimed by the quotient computation and free to reuse, or -1.
	var qres int
	var spare int
	qres, spare = computeConstQuotientX64(a, rm, lhs, c, isUnsigned)
	if !isRem {
		var rd int = nextReg(rm, ins.ID)
		if rd != qres {
			x64.Mov(a, r64(rd), r64(qres))
		}
		emitSubWordNarrow(a, rd, ins.Typ)
		return true
	}
	// r = lhs - qres*c
	var dreg int = spare
	if dreg < 0 { dreg = scratchReg(rm) }
	emitConstInt64(a, dreg, c)
	x64.Imul2(a, r64(qres), r64(dreg)) // qres = q*c (low 64)
	var rd int = nextReg(rm, ins.ID)
	x64.Mov(a, r64(rd), r64(lhs))
	x64.Sub(a, r64(rd), r64(qres))
	emitSubWordNarrow(a, rd, ins.Typ)
	return true
}

// computeConstQuotientX64 emits `lhs / c` (c not 0, not ±1) into a fresh scratch
// register and returns it.  Power-of-two divisors use shifts; others use the
// magic-number multiply through RDX:RAX.
func computeConstQuotientX64(a @asm.Assembler, rm @common.RegMap, lhs int, c int64,
		isUnsigned bool) (int, int) {
	var ad uint64 = strength.AbsU64(c)
	var k int = strength.Pow2Log(ad)
	if k >= 1 {
		return computeConstPow2QuotientX64(a, rm, lhs, c, k, isUnsigned), -1
	}
	return computeConstMagicQuotientX64(a, rm, lhs, c, isUnsigned)
}

// computeConstPow2QuotientX64 handles ±2^k.
func computeConstPow2QuotientX64(a @asm.Assembler, rm @common.RegMap, lhs int, c int64, k int,
		isUnsigned bool) int {
	var qres int = scratchReg(rm)
	if isUnsigned {
		x64.Mov(a, r64(qres), r64(lhs))
		x64.Shr(a, r64(qres), x64.Imm(k))
		return qres
	}
	// Signed: bias by (2^k - 1) when the dividend is negative, then arithmetic
	// shift; negate for a negative divisor.
	x64.Mov(a, r64(qres), r64(lhs))
	if k == 1 {
		x64.Shr(a, r64(qres), x64.Imm(xWordW - 1)) // sign bit
	} else {
		x64.Sar(a, r64(qres), x64.Imm(k - 1))
		x64.Shr(a, r64(qres), x64.Imm(xWordW - k))
	}
	x64.Add(a, r64(qres), r64(lhs))
	x64.Sar(a, r64(qres), x64.Imm(k))
	if c < cast(int64, 0) {
		x64.Neg(a, r64(qres))
	}
	return qres
}

// computeConstMagicQuotientX64 emits the magic-number multiply for a non-power-
// of-two |c| >= 2.  It returns (q, spare): q holds the quotient, and spare is
// the other register it claimed — RDX or its pool scratch w — now dead and free
// for the caller's REM multiplier.
func computeConstMagicQuotientX64(a @asm.Assembler, rm @common.RegMap, lhs int, c int64,
		isUnsigned bool) (int, int) {
	var w int = scratchReg(rm)
	rm.MarkUsed(x64.RDX)
	x64.Mov(a, r64(x64.RAX), r64(lhs))
	if isUnsigned {
		var mg strength.MagicUnsigned = strength.ComputeMagicUnsigned(cast(uint64, c), xWordW)
		emitConstInt64(a, w, cast(int64, mg.M))
		x64.Mul1(a, r64(w)) // RDX = high(unsigned RAX * M)
		if !mg.Add {
			if mg.Shift > 0 {
				x64.Shr(a, r64(x64.RDX), x64.Imm(mg.Shift))
			}
			return x64.RDX, w
		}
		// t = (n - q) >> 1 ; q = (t + q) >> (shift-1), with t in w (M is dead).
		x64.Mov(a, r64(w), r64(lhs))
		x64.Sub(a, r64(w), r64(x64.RDX))
		x64.Shr(a, r64(w), x64.Imm(1))
		x64.Add(a, r64(w), r64(x64.RDX))
		if mg.Shift - 1 > 0 {
			x64.Shr(a, r64(w), x64.Imm(mg.Shift - 1))
		}
		return w, x64.RDX
	}
	var mg strength.MagicSigned = strength.ComputeMagicSigned(c, xWordW)
	emitConstInt64(a, w, mg.M)
	x64.Imul1(a, r64(w)) // RDX = high(signed RAX * M)
	if mg.AddN {
		x64.Add(a, r64(x64.RDX), r64(lhs))
	}
	if mg.SubN {
		x64.Sub(a, r64(x64.RDX), r64(lhs))
	}
	if mg.Shift > 0 {
		x64.Sar(a, r64(x64.RDX), x64.Imm(mg.Shift))
	}
	// Round toward zero: add the sign bit (logical-shift-right by W-1 → 0/1),
	// computed in w (M is dead).
	x64.Mov(a, r64(w), r64(x64.RDX))
	x64.Shr(a, r64(w), x64.Imm(xWordW - 1))
	x64.Add(a, r64(x64.RDX), r64(w))
	return x64.RDX, w
}

// emitMulAddX64 lowers the fused OP_MADD (Args[0]*Args[1] + Args[2]) / OP_MSUB
// (Args[2] - Args[0]*Args[1]).  x64 has no integer multiply-add, so the product
// is formed in a register and then combined with the addend c.
//
// When rd aliases neither c nor one of the multiplicands, the product is formed
// directly in rd (starting from the multiplicand rd does alias, if any), so no
// extra register is needed: operand reloads plus rd claim at most four pool
// registers.  Otherwise rd shares a home with c or with both multiplicands, and
// the product goes to a scratch t claimed after the operands and rd (so t is
// distinct from all of them); rd is then a home, not a pool register, so this
// path too claims at most four.  An MSUB formed in rd is c - a*b = -(a*b) + c.
// Returns false if ins is not a fused multiply-add.
func emitMulAddX64(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != iropcode.OP_MADD && ins.Op != iropcode.OP_MSUB {
		return false
	}
	if len(ins.Args) != 3 {
		return false
	}
	var aReg int = getOperand(a, rm, ins.Args[0].ID)
	var bReg int = getOperand(a, rm, ins.Args[1].ID)
	var cReg int = getOperand(a, rm, ins.Args[2].ID)
	if aReg < 0 || bReg < 0 || cReg < 0 { return false }
	var rd int = nextReg(rm, ins.ID)
	var rdOp x64.Operand = x64.Reg(rd, x64.SZ64)
	// first * second is formed in rd starting from `first`; rd must not be
	// `second` (overwritten before it is read) or c (read after).
	var first int = -1
	var second int = -1
	if rd != cReg && rd != bReg {
		first = aReg
		second = bReg
	} else if rd != cReg && rd != aReg {
		first = bReg
		second = aReg
	}
	if first >= 0 {
		if rd != first { x64.Mov(a, rdOp, x64.Reg(first, x64.SZ64)) }
		x64.Imul2(a, rdOp, x64.Reg(second, x64.SZ64))
		if ins.Op == iropcode.OP_MSUB { x64.Neg(a, rdOp) }
		x64.Add(a, rdOp, x64.Reg(cReg, x64.SZ64))
		emitSubWordNarrow(a, rd, ins.Typ)
		return true
	}
	var t int = scratchReg(rm)
	var tOp x64.Operand = x64.Reg(t, x64.SZ64)
	x64.Mov(a, tOp, x64.Reg(aReg, x64.SZ64))
	x64.Imul2(a, tOp, x64.Reg(bReg, x64.SZ64))
	x64.Mov(a, rdOp, x64.Reg(cReg, x64.SZ64))
	if ins.Op == iropcode.OP_MADD {
		x64.Add(a, rdOp, tOp)
	} else {
		x64.Sub(a, rdOp, tOp)
	}
	emitSubWordNarrow(a, rd, ins.Typ)
	return true
}
