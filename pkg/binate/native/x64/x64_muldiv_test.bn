package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// hasRexF7 scans for a REX.W (0x48/0x49) + 0xF7 + ModRM one-operand group-3
// instruction whose reg field (extension) is `ext` (register form, mod=11).
// ext 4 = MUL, 5 = IMUL, 6 = DIV, 7 = IDIV.  The REX.W prefix requirement makes
// a coincidental 0xF7 immediate byte a non-match.
func hasRexF7(a @asm.Assembler, ext int) bool {
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var modLo uint8 = cast(uint8, 0xC0 + (ext * 8))
	var modHi uint8 = cast(uint8, 0xC0 + (ext * 8) + 7)
	for i := 0; i + 2 < n; i = i + 1 {
		var rex uint8 = data[i]
		if (rex == cast(uint8, 0x48) || rex == cast(uint8, 0x49)) && data[i + 1] == cast(uint8, 0xF7) {
			var m uint8 = data[i + 2]
			if m >= modLo && m <= modHi {
				return true
			}
		}
	}
	return false
}

// emitConstBinopX64 builds `lhs <op> C` with a constant second operand (lhs
// spilled id 1, const id 2, result id 3) and emits it.
func emitConstBinopX64(op int, t @types.Type, c int64) @asm.Assembler {
	setTarget64()
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = t
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Op = iropcode.OP_CONST_INT
	rhs.IntVal = c
	rhs.Typ = t
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = op
	ins.Typ = t
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	emitBinop(a, m, ins)
	return a
}

// Signed constant division uses the one-operand IMUL magic multiply, not IDIV.
func TestConstSignedDivX64Magic() testing.TestResult {
	var a @asm.Assembler = emitConstBinopX64(iropcode.OP_DIV, types.TypInt(), cast(int64, 7))
	if !hasRexF7(a, 5) {
		return "signed const DIV should emit one-operand IMUL"
	}
	if hasRexF7(a, 7) {
		return "signed const DIV must NOT emit IDIV"
	}
	return ""
}

// Unsigned constant division uses the one-operand MUL, not DIV.
func TestConstUnsignedDivX64Magic() testing.TestResult {
	var a @asm.Assembler = emitConstBinopX64(iropcode.OP_DIV, types.TypUint64(), cast(int64, 7))
	if !hasRexF7(a, 4) {
		return "unsigned const DIV should emit one-operand MUL"
	}
	if hasRexF7(a, 6) {
		return "unsigned const DIV must NOT emit DIV"
	}
	return ""
}

// Signed constant modulo uses the magic quotient (IMUL) then n-q*d — no IDIV.
func TestConstRemX64Magic() testing.TestResult {
	var a @asm.Assembler = emitConstBinopX64(iropcode.OP_REM, types.TypInt(), cast(int64, 7))
	if !hasRexF7(a, 5) {
		return "signed const REM should emit one-operand IMUL for the quotient"
	}
	if hasRexF7(a, 7) {
		return "signed const REM must NOT emit IDIV"
	}
	return ""
}

// A VARIABLE divisor still lowers to IDIV — the const path must not swallow it.
func TestVariableDivX64StillIdiv() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_DIV
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	emitBinop(a, m, ins)
	if !hasRexF7(a, 7) {
		return "variable-divisor DIV must still emit IDIV"
	}
	return ""
}

// poolClaimedX64 counts the scratch-pool registers the current instruction has
// claimed in m.
func poolClaimedX64(m @common.RegMap) int {
	var n int = 0
	for k := 0; k < x64PoolSize; k++ {
		if m.IsUsed(regPool(k)) { n = n + 1 }
	}
	return n
}

// A constant-divisor remainder (magic path, signed and unsigned) claims at most
// four scratch-pool registers: the lhs reload, the shared multiplier / temp,
// RDX (the multiply-high) and the result.
func TestConstRemMagicClaimsAtMostFourPoolRegs() testing.TestResult {
	for u := 0; u < 2; u++ {
		setTarget64()
		var t @types.Type = types.TypInt()
		if u == 1 { t = types.TypUint() }
		var a @asm.Assembler = opsMkAssembler()
		var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
		for id := 1; id <= 3; id++ {
			m.SpillIDs = common.AppendInt(m.SpillIDs, id)
			m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8 * (id - 1))
		}
		var lhs @ir.Instr = make(ir.Instr)
		lhs.ID = 1
		lhs.Typ = t
		var rhs @ir.Instr = make(ir.Instr)
		rhs.ID = 2
		rhs.Op = iropcode.OP_CONST_INT
		rhs.IntVal = 7
		rhs.Typ = t
		var ins @ir.Instr = make(ir.Instr)
		ins.ID = 3
		ins.Op = iropcode.OP_REM
		ins.Typ = t
		ins.Args = make_slice(@ir.Instr, 2)
		ins.Args[0] = lhs
		ins.Args[1] = rhs
		if !emitBinop(a, m, ins) { return "the remainder should be lowered" }
		if !hasRexF7(a, 4) && !hasRexF7(a, 5) { return "the magic multiply should be used" }
		if poolClaimedX64(m) > 4 { return "a constant remainder claims more than four pool registers" }
	}
	return ""
}

// maddInsX64 builds `a*b + c` (op OP_MADD) or `c - a*b` (OP_MSUB) over int
// values 1, 2, 3 homed in RBX, R12, R13, with the result (id 4) homed in home.
func maddInsX64(m @common.RegMap, op int, home int) @ir.Instr {
	var regs @[]int = make_slice(int, 4)
	regs[0] = x64.RBX
	regs[1] = x64.R12
	regs[2] = x64.R13
	regs[3] = home
	for i := 0; i < 4; i++ {
		m.HomeIDs = common.AppendInt(m.HomeIDs, i + 1)
		m.HomeRegs = common.AppendInt(m.HomeRegs, regs[i])
	}
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 4
	ins.Op = op
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 3)
	for i := 0; i < 3; i++ {
		var v @ir.Instr = make(ir.Instr)
		v.ID = i + 1
		v.Op = iropcode.OP_PARAM
		v.Typ = types.TypInt()
		ins.Args[i] = v
	}
	return ins
}

// With the result in a register distinct from every operand, the product is
// formed in the result register itself — no scratch:
// madd: mov r14, rbx ; imul r14, r12 ; add r14, r13
// msub: mov r14, rbx ; imul r14, r12 ; neg r14 ; add r14, r13
func TestEmitMulAddX64FormsProductInResult() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	if !emitMulAddX64(a, m, maddInsX64(m, iropcode.OP_MADD, x64.R14)) { return "madd not lowered" }
	var r testing.TestResult = x64FoldGolden(a, "49 89 de 4d 0f af f4 4d 01 ee", "madd")
	if len(r) != 0 { return r }
	var b @asm.Assembler = opsMkAssembler()
	var n @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	if !emitMulAddX64(b, n, maddInsX64(n, iropcode.OP_MSUB, x64.R14)) { return "msub not lowered" }
	return x64FoldGolden(b, "49 89 de 4d 0f af f4 49 f7 de 4d 01 ee", "msub")
}

// With the result sharing c's home, the product goes to a scratch first so c is
// read before it is overwritten:
// msub: mov r10, rbx ; imul r10, r12 ; mov r13, r13 ; sub r13, r10
func TestEmitMulAddX64ResultAliasesAddend() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	if !emitMulAddX64(a, m, maddInsX64(m, iropcode.OP_MSUB, x64.R13)) { return "msub not lowered" }
	return x64FoldGolden(a, "49 89 da 4d 0f af d4 4d 89 ed 4d 29 d5", "msub into c's home")
}

// With the result sharing b's home, the product is formed from b in place
// (b is `first`, so it is not overwritten before it is read):
// madd: imul r12, rbx ; add r12, r13
func TestEmitMulAddX64ResultAliasesMultiplicand() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	if !emitMulAddX64(a, m, maddInsX64(m, iropcode.OP_MADD, x64.R12)) { return "madd not lowered" }
	return x64FoldGolden(a, "4c 0f af e3 4d 01 ec", "madd into b's home")
}
