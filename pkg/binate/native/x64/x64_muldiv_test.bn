package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// hasRexF7 scans for a REX.W (0x48/0x49) + 0xF7 + ModRM one-operand group-3
// instruction whose reg field (extension) is `ext` (register form, mod=11).
// ext 4 = MUL, 5 = IMUL, 6 = DIV, 7 = IDIV.  The REX.W prefix requirement makes
// a coincidental 0xF7 immediate byte a non-match.
func hasRexF7(a @asm.Assembler, ext int) bool {
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var modLo uint8 = cast(uint8, 0xC0 + (ext * 8))
	var modHi uint8 = cast(uint8, 0xC0 + (ext * 8) + 7)
	for i := 0; i + 2 < n; i = i + 1 {
		var rex uint8 = data[i]
		if (rex == cast(uint8, 0x48) || rex == cast(uint8, 0x49)) && data[i + 1] == cast(uint8, 0xF7) {
			var m uint8 = data[i + 2]
			if m >= modLo && m <= modHi {
				return true
			}
		}
	}
	return false
}

// emitConstBinopX64 builds `lhs <op> C` with a constant second operand (lhs
// spilled id 1, const id 2, result id 3) and emits it.
func emitConstBinopX64(op int, t @types.Type, c int64) @asm.Assembler {
	setTarget64()
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = t
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Op = iropcode.OP_CONST_INT
	rhs.IntVal = c
	rhs.Typ = t
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = op
	ins.Typ = t
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	emitBinop(a, m, ins)
	return a
}

// Signed constant division uses the one-operand IMUL magic multiply, not IDIV.
func TestConstSignedDivX64Magic() testing.TestResult {
	var a @asm.Assembler = emitConstBinopX64(iropcode.OP_DIV, types.TypInt(), cast(int64, 7))
	if !hasRexF7(a, 5) {
		return "signed const DIV should emit one-operand IMUL"
	}
	if hasRexF7(a, 7) {
		return "signed const DIV must NOT emit IDIV"
	}
	return ""
}

// Unsigned constant division uses the one-operand MUL, not DIV.
func TestConstUnsignedDivX64Magic() testing.TestResult {
	var a @asm.Assembler = emitConstBinopX64(iropcode.OP_DIV, types.TypUint64(), cast(int64, 7))
	if !hasRexF7(a, 4) {
		return "unsigned const DIV should emit one-operand MUL"
	}
	if hasRexF7(a, 6) {
		return "unsigned const DIV must NOT emit DIV"
	}
	return ""
}

// Signed constant modulo uses the magic quotient (IMUL) then n-q*d — no IDIV.
func TestConstRemX64Magic() testing.TestResult {
	var a @asm.Assembler = emitConstBinopX64(iropcode.OP_REM, types.TypInt(), cast(int64, 7))
	if !hasRexF7(a, 5) {
		return "signed const REM should emit one-operand IMUL for the quotient"
	}
	if hasRexF7(a, 7) {
		return "signed const REM must NOT emit IDIV"
	}
	return ""
}

// A VARIABLE divisor still lowers to IDIV — the const path must not swallow it.
func TestVariableDivX64StillIdiv() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_DIV
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	emitBinop(a, m, ins)
	if !hasRexF7(a, 7) {
		return "variable-divisor DIV must still emit IDIV"
	}
	return ""
}
