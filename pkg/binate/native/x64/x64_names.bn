package "pkg/binate/native/x64"

import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// ============================================================
// Name helpers
// ============================================================
//
// ELF symbols on x86-64 Linux are unprefixed (unlike Mach-O which
// prepends '_' for C linkage).  bn_<kind>... goes straight to
// the linker.

// objSymPrefix is the object-format linkage prefix applied to every
// emitted symbol name.  Empty for ELF, "_" for Mach-O (C-linkage).
// Set by EmitObject from the target's object format before any name
// is emitted (Phase 3 of plan-backend-objformat-decoupling.md);
// defaults to empty so direct symFor/globalSymFor unit tests (which
// don't run EmitObject) see ELF-shaped bare names.
var objSymPrefix *[]readonly char

// symPrefixed applies the active object-format linkage prefix
// (objSymPrefix) to an already-mangled symbol name.  This is the
// single place the prefix is applied — mirroring arm64's
// underscorePrefix — so the format-vs-prefix coupling lives in one
// spot.
func symPrefixed(name *[]readonly char) @[]char {
	var out @strings.Builder = strings.NewBuilder()
	if len(objSymPrefix) > 0 {
		out.Write(objSymPrefix)
	}
	out.Write(name)
	return buf.CopyStr(out.String())
}

// symFor mangles a Binate (pkgName, funcName) pair to its ELF symbol
// name.  Dot-qualified names ("pkg.Func") are treated as pre-
// qualified by mangle.FuncName; pkgName is ignored in that case.
func symFor(pkgName *[]readonly char, funcName *[]readonly char) @[]char {
	var mangled @[]char = mangle.FuncName(pkgName, funcName)
	return symPrefixed(mangled)
}

// stripQuotes strips surrounding '"' from a string (if present).
// Module names from the IR carry the source-text quoting (e.g.
// "\"pkg/foo\""); the mangler wants the bare path.
func stripQuotes(s *[]readonly char) *[]readonly char {
	if len(s) >= 2 && s[0] == '"' && s[len(s) - 1] == '"' {
		return s[1:len(s) - 1]
	}
	return s
}

// globalSymFor mangles a package-level variable to its ELF symbol.
// Different from symFor because globals go through mangle.GlobalName
// (no special case for main.main).  Like symFor, ELF symbols are
// not underscore-prefixed.
func globalSymFor(pkgName *[]readonly char, name *[]readonly char) @[]char {
	var mangled @[]char = mangle.GlobalName(pkgName, name)
	return symPrefixed(mangled)
}

// argReg returns the SysV-AMD64 integer arg register for the i-th
// argument slot.  SysV-AMD64 passes the first 6 GP args in RDI,
// RSI, RDX, RCX, R8, R9; args 7+ go on the stack.
func argReg(i int) int {
	if i == 0 { return x64.RDI }
	if i == 1 { return x64.RSI }
	if i == 2 { return x64.RDX }
	if i == 3 { return x64.RCX }
	if i == 4 { return x64.R8 }
	return x64.R9
}

// stringLabel is the local asm label for string constant <id>.
// Same naming scheme as arm64's stringLabel — the 'L' prefix
// keeps the label out of the exported symbol list.
func stringLabel(id int) @[]char {
	var out @strings.Builder = strings.NewBuilder()
	out.Write("Lstr_")
	stringutils.WriteInt(out, id)
	return buf.CopyStr(out.String())
}

// stringMSSym is the module-qualified WEAK symbol for string constant <id>'s
// static managed-slice header.  Unlike the byte blob (a same-section-local
// `Lstr_<id>` label), the `.ms` carries a relocation so it lives in `data`; a
// `data` symbol reached from text via RIP-relative LEA must be a symbol-table
// entry, so it goes through the global mangler (module-qualified → two modules'
// string 0 don't collide).
func stringMSSym(pkgName *[]readonly char, id int) @[]char {
	var nm @strings.Builder = strings.NewBuilder()
	nm.Write("__strms_")
	stringutils.WriteInt(nm, id)
	return symPrefixed(mangle.GlobalName(pkgName, nm.String()))
}

// blockLabel mints a function-scoped label name for a basic block.
// The 'L' prefix keeps it out of the exported symbol list — same-
// section JMP/Jcc fixups are resolved before link, so the label
// never reaches the linker as a real symbol.
func blockLabel(funcSym @[]char, blkLabel @[]char) @[]char {
	var out @strings.Builder = strings.NewBuilder()
	out.Write("L")
	out.Write(funcSym)
	out.Write("__")
	out.Write(blkLabel)
	return buf.CopyStr(out.String())
}
