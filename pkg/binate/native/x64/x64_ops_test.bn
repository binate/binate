package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// opsMkAssembler: minimal assembler for direct-emit tests.
func opsMkAssembler() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func opsBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// setTarget64 pins types' live target to a 64-bit configuration.
// pkg/binate/native/x64 targets the SysV-AMD64 ABI exclusively; its tests'
// size / alignment / aggregate-classification assertions are LP64-
// specific.  On a 32-bit-host test runner the lazy default would
// otherwise reflect the host and skew the assertions.
func setTarget64() {
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	types.SetTarget(t)
}

// nilFuncs / nilStrings are shared test helpers — emitInstr +
// emitFunc want both even when the test doesn't exercise calls or
// string constants.  Both are package-level so all test files can
// reach them without re-defining.
func nilFuncs() @[]@ir.Func {
	var empty @[]@ir.Func
	return empty
}
func nilStrings() @[]ir.StringConst {
	var empty @[]ir.StringConst
	return empty
}

// emitConstInt64 small value → 5-byte `mov r10d, imm32` (no REX.W
// for values that fit signed 32-bit).  x64.Mov picks the shortest
// encoding automatically.
func TestEmitConstInt64SmallValue() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitConstInt64(a, x64.R10, 42)
	if opsBytes(a) == 0 {
		return "emitConstInt64 should emit at least one instruction"
	}
	return ""
}

// emitConstInt64 large value (> i32 max) → 10-byte movabs imm64
// (`49 BA imm64` for r10).  Pins the encoding so a future change
// that drops the imm64 encoding silently truncates wide constants.
func TestEmitConstInt64ImmediateWidth() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitConstInt64(a, x64.R10, 5000000000)
	// movabs r10, imm64 = REX.B (0x49) + 0xBA + 8 imm bytes = 10.
	if opsBytes(a) != 10 {
		return "movabs r64, imm64 should be 10 bytes"
	}
	var data *[]uint8 = a.Sections[0].Data
	if data[0] != cast(uint8, 0x49) {
		return "byte 0 should be REX.B prefix (0x49)"
	}
	if data[1] != cast(uint8, 0xBA) {
		return "byte 1 should be MOV r10, imm64 opcode (0xBA = 0xB8+2)"
	}
	return ""
}

// emitBinop OP_ADD path: spill-everything means it emits 2× MOV
// (reload lhs and rhs from spill slots), 1× MOV rd,lhs, 1× ADD
// rd,rhs.  The exact byte count is encoding-dependent; just pin
// "non-empty" and verify the lowering doesn't crash.  More
// detailed byte tests live in the conformance suite.
func TestEmitBinopAddNonEmpty() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_ADD
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitBinop(a, m, ins) {
		return "emitBinop should match OP_ADD"
	}
	if opsBytes(a) == 0 {
		return "OP_ADD should emit instructions"
	}
	return ""
}

// emitBinop rejects ops it doesn't handle (returns false so the
// dispatcher can try the next handler).  OP_LOAD is a memory op,
// not a binop, so emitBinop must return false for it without
// emitting any bytes.
func TestEmitBinopRejectsNonBinop() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_LOAD
	if emitBinop(a, m, ins) {
		return "emitBinop should return false for OP_LOAD"
	}
	if opsBytes(a) != 0 {
		return "emitBinop should emit nothing for unmatched op"
	}
	return ""
}

// OP_LOR / OP_LAND: used by switch case-OR generation (`case 1, 2,
// 3:` chains) where short-circuit doesn't apply.  emitBinop must
// dispatch them or the chain silently no-ops.  Mirrors aa64's
// TestEmitBinopHandlesLor.
func TestEmitBinopHandlesLor() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypBool()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypBool()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_LOR
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitBinop(a, m, ins) {
		return "emitBinop should match OP_LOR"
	}
	return ""
}

// Shifts route through CL; the rhs reg is MOV'd into RCX before
// the shift is emitted.  Pin that — without it, the shift would
// read whatever CL happened to hold and silently corrupt output.
func TestEmitBinopShiftMovesIntoCL() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_SHL
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitBinop(a, m, ins) {
		return "emitBinop should match OP_SHL"
	}
	if opsBytes(a) == 0 {
		return "OP_SHL should emit instructions (incl. mov rcx, rhs)"
	}
	return ""
}

// Regression guard: OP_SHL where rd would otherwise collide with RCX.
// regPool slots [0]=R10, [1]=R11, [2]=RCX, so after lhs+rhs consume
// slots 0–1, a naïve `nextReg(rd)` would assign RCX as rd.  The
// subsequent MOV-rd-from-lhs followed by MOV-RCX-from-rhs would
// clobber rd's value with rhs (the shift amount), then `SHL rd, CL`
// would do `shamt << shamt` — for `1 << 4` this returns `4 << 4 = 64`
// instead of `16`.  emitBinop reserves RCX as the shamt holder BEFORE
// allocating rd so rd skips past RCX.  Pin: after emit, rd's register
// in the regmap must NOT be RCX (slot 3 = RDX is the expected pick).
func TestEmitBinopShlAvoidsRcxForRd() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_SHL
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitBinop(a, m, ins) {
		return "emitBinop should match OP_SHL"
	}
	var rd int = m.LookupReg(3)
	if rd == x64.RCX {
		return "OP_SHL must not pick RCX as rd — the MOV-RCX-rhs would clobber rd's value"
	}
	if rd < 0 {
		return "OP_SHL should register rd in the regmap"
	}
	return ""
}

// Same RCX-avoidance regression guard for OP_SHR — the fix in
// emitBinop is shared between SHL and SHR, so a refactor that
// split them must keep both branches reserving RCX before rd
// allocation.  Without it, signed `x >> n` on amd64 would silently
// compute `n >> n` whenever rd lands on RCX.
func TestEmitBinopShrAvoidsRcxForRd() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_SHR
	ins.Typ = types.TypInt()  // signed → SAR
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitBinop(a, m, ins) {
		return "emitBinop should match OP_SHR"
	}
	if m.LookupReg(3) == x64.RCX {
		return "OP_SHR must not pick RCX as rd"
	}
	return ""
}

// OP_DIV signed: CQO sign-extends RAX into RDX:RAX, then IDIV.
// Verify the emit fires and ends with an IDIV opcode byte.  IDIV
// encoding: REX.W (0x48 / 0x49) + 0xF7 + ModRM with reg=/7 (mod=11,
// reg=111, rm=divSrc); for divSrc=RCX (regPool slot 2), the ModRM
// is 0xFF (11_111_001).
func TestEmitBinopDivSignedEmitsCqoIdiv() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_DIV
	ins.Typ = types.TypInt()  // signed int → IDIV
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitBinop(a, m, ins) {
		return "emitBinop should match OP_DIV"
	}
	if opsBytes(a) == 0 {
		return "OP_DIV should emit instructions"
	}
	// Look for CQO byte (0x99) somewhere in the emitted output —
	// the signed-divide setup.  CQO is a single byte but the
	// instruction stream prepends a REX.W in 64-bit mode, so
	// search for 0x48 0x99.
	var data *[]uint8 = a.Sections[0].Data
	var found bool = false
	for i := 0; i < a.Sections[0].Len - 1; i++ {
		if data[i] == cast(uint8, 0x48) &&
				data[i+1] == cast(uint8, 0x99) {
			found = true
		}
	}
	if !found {
		return "OP_DIV signed should emit CQO (REX.W 99)"
	}
	return ""
}

// OP_DIV unsigned: XOR RDX,RDX then DIV.  Verify the XOR rdx,rdx
// (encoded as 0x48 0x31 0xD2) appears in the emit stream.
func TestEmitBinopDivUnsignedEmitsXorRdxDiv() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var uintTyp @types.Type = types.TypUint64()
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = uintTyp
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = uintTyp
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_DIV
	ins.Typ = uintTyp  // unsigned → DIV
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitBinop(a, m, ins) {
		return "emitBinop should match OP_DIV unsigned"
	}
	// Look for xor rdx,rdx (48 31 D2).
	var data *[]uint8 = a.Sections[0].Data
	var found bool = false
	for i := 0; i < a.Sections[0].Len - 2; i++ {
		if data[i] == cast(uint8, 0x48) &&
				data[i+1] == cast(uint8, 0x31) &&
				data[i+2] == cast(uint8, 0xD2) {
			found = true
		}
	}
	if !found {
		return "OP_DIV unsigned should emit XOR RDX, RDX (48 31 D2)"
	}
	return ""
}

// OP_REM signed: same dance as OP_DIV (CQO + IDIV) but copies RDX
// into rd instead of RAX.  Pin that REM goes through the same
// IDIV-emitting path.
func TestEmitBinopRemSignedAlsoEmitsCqo() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_REM
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitBinop(a, m, ins) {
		return "emitBinop should match OP_REM"
	}
	var data *[]uint8 = a.Sections[0].Data
	var found bool = false
	for i := 0; i < a.Sections[0].Len - 1; i++ {
		if data[i] == cast(uint8, 0x48) &&
				data[i+1] == cast(uint8, 0x99) {
			found = true
		}
	}
	if !found {
		return "OP_REM signed should emit CQO (REX.W 99)"
	}
	return ""
}

// OP_REM unsigned: XOR RDX,RDX + DIV (NOT CQO+IDIV).  A regression
// that routes unsigned-REM through the signed path would corrupt
// remainders for uint values with the high bit set.
func TestEmitBinopRemUnsignedEmitsXorRdxDiv() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var uintTyp @types.Type = types.TypUint64()
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = uintTyp
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = uintTyp
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_REM
	ins.Typ = uintTyp  // unsigned → DIV not IDIV, no CQO
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitBinop(a, m, ins) {
		return "emitBinop should match OP_REM unsigned"
	}
	var data *[]uint8 = a.Sections[0].Data
	// Verify xor rdx, rdx (48 31 D2) IS present — unsigned setup.
	var foundXor bool = false
	for i := 0; i < a.Sections[0].Len - 2; i++ {
		if data[i] == cast(uint8, 0x48) &&
				data[i+1] == cast(uint8, 0x31) &&
				data[i+2] == cast(uint8, 0xD2) {
			foundXor = true
		}
	}
	if !foundXor {
		return "OP_REM unsigned should emit XOR RDX, RDX (not CQO)"
	}
	// Verify CQO (48 99) is NOT present.
	var foundCqo bool = false
	for i := 0; i < a.Sections[0].Len - 1; i++ {
		if data[i] == cast(uint8, 0x48) &&
				data[i+1] == cast(uint8, 0x99) {
			foundCqo = true
		}
	}
	if foundCqo {
		return "OP_REM unsigned must NOT emit CQO (that's the signed setup)"
	}
	return ""
}

// emitCompare OP_LT signed: CMP + SETL + MOVZX.  Pin SETL (0F 9C).
func TestEmitCompareSignedLessThan() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_LT
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitCompare(a, m, ins) {
		return "emitCompare should match OP_LT"
	}
	var data *[]uint8 = a.Sections[0].Data
	var found bool = false
	for i := 0; i < a.Sections[0].Len - 1; i++ {
		if data[i] == cast(uint8, 0x0F) &&
				data[i+1] == cast(uint8, 0x9C) {
			found = true
		}
	}
	if !found {
		return "OP_LT signed should emit SETL (0F 9C)"
	}
	return ""
}

// OP_LT unsigned uses the B (below) cc, NOT L (less).  A regression
// that uses signed compare for uint values with the high bit set
// silently mis-orders them.  Pin SETB (0F 92).
func TestEmitCompareUnsignedLessThan() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var uintTyp @types.Type = types.TypUint64()
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = uintTyp
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = uintTyp
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_LT
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitCompare(a, m, ins) {
		return "emitCompare should match OP_LT unsigned"
	}
	var data *[]uint8 = a.Sections[0].Data
	var foundB bool = false
	for i := 0; i < a.Sections[0].Len - 1; i++ {
		if data[i] == cast(uint8, 0x0F) &&
				data[i+1] == cast(uint8, 0x92) {
			foundB = true
		}
	}
	if !foundB {
		return "OP_LT unsigned should emit SETB (0F 92), not SETL"
	}
	return ""
}

// emitCompare rejects non-comparison ops.
func TestEmitCompareRejectsNonCompare() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_ADD
	if emitCompare(a, m, ins) {
		return "emitCompare should return false for OP_ADD"
	}
	if opsBytes(a) != 0 {
		return "emitCompare should emit nothing for unmatched op"
	}
	return ""
}

// condForOp mapping: pin EQ/NE signedness-independence + the
// signed/unsigned divergence for LT (L vs B).
func TestCondForOpEqualSignednessIndependent() testing.TestResult {
	if condForOp(ir.OP_EQ, true) != condForOp(ir.OP_EQ, false) {
		return "OP_EQ cc should not depend on signedness"
	}
	if condForOp(ir.OP_NE, true) != condForOp(ir.OP_NE, false) {
		return "OP_NE cc should not depend on signedness"
	}
	return ""
}

func TestCondForOpLessThanSignedVsUnsigned() testing.TestResult {
	if condForOp(ir.OP_LT, false) == condForOp(ir.OP_LT, true) {
		return "OP_LT signed and unsigned must map to different cc"
	}
	return ""
}

// Full per-op condForOp coverage.  A swapped mapping (e.g. OP_LE
// returning CC_L instead of CC_LE) gives a sometimes-correct,
// sometimes-off-by-one comparison that the conformance suite
// might catch only via fuzzy output — the unit-level pin makes
// it loud.  Two parallel arrays of (op, signed-cc, unsigned-cc)
// keep the table dense.
func TestCondForOpFullTable() testing.TestResult {
	var ops @[]int = make_slice(int, 6)
	ops[0] = ir.OP_EQ
	ops[1] = ir.OP_NE
	ops[2] = ir.OP_LT
	ops[3] = ir.OP_LE
	ops[4] = ir.OP_GT
	ops[5] = ir.OP_GE
	var sCC @[]int = make_slice(int, 6)
	sCC[0] = x64.CC_E
	sCC[1] = x64.CC_NE
	sCC[2] = x64.CC_L
	sCC[3] = x64.CC_LE
	sCC[4] = x64.CC_G
	sCC[5] = x64.CC_GE
	var uCC @[]int = make_slice(int, 6)
	uCC[0] = x64.CC_E   // EQ/NE are signedness-independent
	uCC[1] = x64.CC_NE
	uCC[2] = x64.CC_B
	uCC[3] = x64.CC_BE
	uCC[4] = x64.CC_A
	uCC[5] = x64.CC_AE
	for i := 0; i < len(ops); i++ {
		if condForOp(ops[i], false) != sCC[i] {
			return "signed cc mapping wrong for some op"
		}
		if condForOp(ops[i], true) != uCC[i] {
			return "unsigned cc mapping wrong for some op"
		}
	}
	return ""
}

// emitUnop OP_NEG: 1× reload + 1× MOV rd,src + 1× NEG rd.
func TestEmitUnopNegNonEmpty() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = ir.OP_NEG
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	if !emitUnop(a, m, ins) {
		return "emitUnop should match OP_NEG"
	}
	if opsBytes(a) == 0 {
		return "OP_NEG should emit instructions"
	}
	return ""
}

// OP_NOT is logical-not on a bool; lowered to `xor rd, 1` to flip
// bit 0.  Pin that — a regression to `not rd` would invert ALL bits
// and break later truthiness checks.
func TestEmitUnopNotIsXorImm1() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypBool()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = ir.OP_NOT
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	if !emitUnop(a, m, ins) {
		return "emitUnop should match OP_NOT"
	}
	return ""
}

// emitUnop rejects non-unops — must return false for OP_ADD so the
// dispatcher can route it to emitBinop.
func TestEmitUnopRejectsBinop() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_ADD
	if emitUnop(a, m, ins) {
		return "emitUnop should return false for OP_ADD"
	}
	if opsBytes(a) != 0 {
		return "emitUnop should emit nothing for unmatched op"
	}
	return ""
}

// emitUnopTyped builds a one-arg unary `ins` (op `op`, result type `t`) over a
// spilled operand and emits it; the helper behind the sub-word-narrow tests.
func emitUnopTyped(op int, t @types.Type) @asm.Assembler {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = t
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = op
	ins.Typ = t
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	emitUnop(a, m, ins)
	return a
}

// hasNarrowByte scans for a two-byte `0F <second>` opcode — the 0F-escape
// MOVZX/MOVSX forms emitSubWordNarrow emits (B6/B7 = MOVZX, BE/BF = MOVSX).
func hasNarrowByte(a @asm.Assembler, second int) bool {
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	for i := 0; i+1 < n; i++ {
		if data[i] == cast(uint8, 0x0F) && data[i+1] == cast(uint8, second) {
			return true
		}
	}
	return false
}

// A sub-word NEG/BITNOT runs at 64-bit width, so a uint8 result keeps dirty
// upper bits that corrupt a later shift / unsigned compare.  Pin that the result
// is re-narrowed with a MOVZX r64,r/m8 (0F B6).  scalar-diff bitwise/not
// unsigned cells expose it end-to-end, but x64-native isn't in the default
// conformance modes, so this is the mode-independent guard.
func TestEmitUnopNegSubWordNarrows() testing.TestResult {
	var a @asm.Assembler = emitUnopTyped(ir.OP_NEG, types.TypUint8())
	if !hasNarrowByte(a, 0xB6) {
		return "uint8 OP_NEG should re-narrow with movzx (0F B6)"
	}
	return ""
}

func TestEmitUnopBitnotSubWordNarrows() testing.TestResult {
	var a @asm.Assembler = emitUnopTyped(ir.OP_BITNOT, types.TypUint8())
	if !hasNarrowByte(a, 0xB6) {
		return "uint8 OP_BITNOT should re-narrow with movzx (0F B6)"
	}
	return ""
}

// A full-width (int64) NEG needs no narrow — assert emitUnop emits no
// MOVZX/MOVSX so the narrow stays gated on sub-word results.
func TestEmitUnopHostWordNoNarrow() testing.TestResult {
	var a @asm.Assembler = emitUnopTyped(ir.OP_NEG, types.TypInt64())
	if hasNarrowByte(a, 0xB6) || hasNarrowByte(a, 0xB7) ||
		hasNarrowByte(a, 0xBE) || hasNarrowByte(a, 0xBF) {
		return "int64 NEG should not emit a movzx/movsx narrow"
	}
	return ""
}


// emitCast no-op: target type `int` (Width = 0 — the predeclared
// target-int) or any width ≥ 64 emits a single MOV reg64, reg64 —
// no shift instructions.  This is the path used by gen_print.bn's
// "cast to target int width" call when the source is already at the
// target's int width.  A regression that incorrectly classified
// Width = 0 as "narrowing" would emit a stray SHL+SAR, corrupting
// the high bits.  Tests the ≥ 64-bit branch explicitly via TypInt64()
// so the assertion is host-independent (TypInt's Width is locked at
// host-int width — on a 32-bit host this would otherwise emit
// SHL+SAR for the 32-bit narrowing).
func TestEmitCastNoOpWhenWidthZero() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = opsMkAssembler()
	emitCast(a, x64.R10, x64.R11, types.TypInt64(), types.TypInt64())
	// Look for a SHL/SAR/SHR opcode (0xD3 = shift-by-CL, 0xC1 =
	// shift-by-imm).  Neither must appear in the no-op path.
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	if n == 0 { return "no-op cast should emit at least a MOV" }
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xC1) {
			return "no-op cast should NOT emit a shift-by-imm (0xC1)"
		}
	}
	return ""
}

// emitCast int32 (signed, Width = 32): narrowing emits MOV + SHL +
// SAR with shamt = 32 (64 - 32).  The SAR (arithmetic right shift)
// is what distinguishes signed from unsigned narrowing.  Pin: at
// least one 0xC1 (shift-by-imm) appears, and the byte 32 (0x20)
// follows somewhere — that's the shift amount imm8.
func TestEmitCastInt32SignedNarrowing() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitCast(a, x64.R10, x64.R11, types.TypInt64(), types.TypInt32())
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundShift bool = false
	var foundShamt bool = false
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xC1) { foundShift = true }
		if data[i] == cast(uint8, 0x20) { foundShamt = true }
	}
	if !foundShift {
		return "int32 narrowing should emit shift-by-imm (0xC1)"
	}
	if !foundShamt {
		return "int32 narrowing should use shamt = 32 (imm 0x20)"
	}
	return ""
}

// emitCast uint32 (unsigned, Width = 32): narrowing emits MOV + SHL
// + SHR (logical right shift, not arithmetic).  Tests check the
// shape — at least 3 instructions (MOV + 2 shifts), with at least
// one shift-by-imm opcode.  The signedness picks SAR vs SHR; the
// op-shape test here doesn't distinguish at byte level (both encode
// as 0xC1 with different /r ext), so this is paired with the signed
// test above to give end-to-end coverage of both branches.
func TestEmitCastUint32UnsignedNarrowing() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitCast(a, x64.R10, x64.R11, types.TypInt64(), types.TypUint32())
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var shifts int = 0
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xC1) { shifts = shifts + 1 }
	}
	if shifts < 2 {
		return "uint32 narrowing should emit 2 shift instructions "
			"(SHL then SHR)"
	}
	return ""
}

// emitCast skips when target is float — the float-arg/return-passing
// gap means emitting wrong-bits int code for a float cast would swap
// one symptom for another.  Pin: calling emitCast with target type
// TypFloat64 emits zero bytes (early return).  Mirrors the matching
// dispatch-level skip when ins.Args[0].Typ is float.
func TestEmitCastFloatTargetSkipped() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitCast(a, x64.R10, x64.R11, types.TypInt64(), types.TypFloat64())
	// TypFloat64 has Width=64, so emitCast would otherwise take the
	// no-op MOV path (single MOV).  Float types must be filtered at
	// the dispatch level — verify emitCast itself doesn't crash and
	// produces the same MOV-only shape (no SHL/SAR/SHR).
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xC1) {
			return "emitCast on float target should not emit shifts"
		}
	}
	return ""
}

// emitCast widening (sub-word SOURCE → host-word target): the value is
// re-established from the SOURCE width, not passed through as-is.  A
// signed int32 source widened to int64 must sign-extend (MOV + SHL +
// SAR, shamt = 64 - 32 = 32), so a non-canonical source — e.g. a
// bit_cast result, which is a bare reinterpret MOV — reads correctly.
func TestEmitCastWidenInt32Source() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitCast(a, x64.R10, x64.R11, types.TypInt32(), types.TypInt64())
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundShift bool = false
	var foundShamt bool = false
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xC1) { foundShift = true }
		if data[i] == cast(uint8, 0x20) { foundShamt = true }
	}
	if !foundShift {
		return "int32-source widening should sign-extend (shift-by-imm 0xC1)"
	}
	if !foundShamt {
		return "int32-source widening should use shamt = 32 (imm 0x20)"
	}
	return ""
}
