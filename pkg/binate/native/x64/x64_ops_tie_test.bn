package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// The register-form binop when the allocator tied the result to a dying operand
// (RegClassDesc.TieOps): rd may be lhs's or rhs's home, and every operand must
// be read before rd is written.

// tieBinopX64 builds `v1 <op> v2` (result v3) over int values homed in lhsHome
// and rhsHome, with the result homed in rdHome.
func tieBinopX64(m @common.RegMap, op int, lhsHome int, rhsHome int, rdHome int) @ir.Instr {
	var regs @[]int = make_slice(int, 3)
	regs[0] = lhsHome
	regs[1] = rhsHome
	regs[2] = rdHome
	for i := 0; i < 3; i++ {
		m.HomeIDs = common.AppendInt(m.HomeIDs, i + 1)
		m.HomeRegs = common.AppendInt(m.HomeRegs, regs[i])
	}
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = op
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	for i := 0; i < 2; i++ {
		var v @ir.Instr = make(ir.Instr)
		v.ID = i + 1
		v.Op = iropcode.OP_PARAM
		v.Typ = types.TypInt()
		ins.Args[i] = v
	}
	return ins
}

// emitTieBinopX64 lowers tieBinopX64's instruction into a fresh assembler.
func emitTieBinopX64(op int, lhsHome int, rhsHome int, rdHome int) @asm.Assembler {
	setTarget64()
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	if !emitBinop(a, m, tieBinopX64(m, op, lhsHome, rhsHome, rdHome)) {
		a.SetError("binop not lowered")
	}
	return a
}

// A commutative op into rhs's home runs with the operands swapped:
// add r12, rbx — not `mov r12, rbx`, which would overwrite rhs first.
func TestBinopX64ResultInRhsHomeCommutes() testing.TestResult {
	var a @asm.Assembler = emitTieBinopX64(iropcode.OP_ADD, x64.RBX, x64.R12, x64.R12)
	return x64FoldGolden(a, "49 01 dc", "add into rhs's home")
}

// SUB into rhs's home forms -rhs + lhs: neg r12 ; add r12, rbx.
func TestBinopX64SubResultInRhsHomeNegates() testing.TestResult {
	var a @asm.Assembler = emitTieBinopX64(iropcode.OP_SUB, x64.RBX, x64.R12, x64.R12)
	return x64FoldGolden(a, "49 f7 dc 49 01 dc", "sub into rhs's home")
}

// Into lhs's home the op runs in place, with no self-move: add rbx, r12.
func TestBinopX64ResultInLhsHomeNoMove() testing.TestResult {
	var a @asm.Assembler = emitTieBinopX64(iropcode.OP_ADD, x64.RBX, x64.R12, x64.RBX)
	return x64FoldGolden(a, "4c 01 e3", "add into lhs's home")
}

// A register shift count moves to CL before rd is written, so a shift into the
// count's home keeps the plain form: mov rcx, r12 ; mov r12, rbx ; shl r12, cl.
func TestBinopX64ShiftResultInCountHome() testing.TestResult {
	var a @asm.Assembler = emitTieBinopX64(iropcode.OP_SHL, x64.RBX, x64.R12, x64.R12)
	return x64FoldGolden(a, "4c 89 e1 49 89 dc 49 d3 e4", "shl into the count's home")
}

// A copy between two values the allocator gave one home emits nothing.
func TestCopySameHomeEmitsNothing() testing.TestResult {
	setTarget64()
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	var ins @ir.Instr = tieBinopX64(m, iropcode.OP_COPY, x64.RBX, x64.R12, x64.RBX)
	// v3 <- v1, both homed in RBX.
	ins.Args = ins.Args[0:1]
	emitCopy(a, m, ins)
	if opsBytes(a) != 0 { return "a copy within one home should emit nothing" }
	return ""
}

// An immediate-fold ADD into its operand's home runs in place, with no
// self-move: add rbx, 1.
func TestAddImmFoldInOperandHome() testing.TestResult {
	setTarget64()
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	m.HomeIDs = common.AppendInt(common.AppendInt(m.HomeIDs, 1), 9)
	m.HomeRegs = common.AppendInt(common.AppendInt(m.HomeRegs, x64.RBX), x64.RBX)
	var a @asm.Assembler = x64FoldImmBinopIn(m, iropcode.OP_ADD, 1, 2, cast(int64, 1), 1,
			types.TypInt())
	return x64FoldGolden(a, "48 83 c3 01", "add-immediate into the operand's home")
}
