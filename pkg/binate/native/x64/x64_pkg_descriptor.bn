package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/stdx/slices"

// emitPackageDescriptor emits this module's reflect.Package descriptor — its
// FunctionInfo / GlobalInfo / VtableInfo tables, the descriptor node + name,
// and the generated `_Package() @reflect.Package` accessor.  See the aarch64
// sibling + pkg/binate/codegen/emit_pkg_descriptor.bn for the contract: the
// whole byte layout is built once by ir.BuildPackageDescriptors (both backends
// lower it through EmitDataGlobal, so they cannot drift), and the same
// `_Package` symbol + layout across backends lets cross-mode references resolve
// to one definition.
func emitPackageDescriptor(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	var pkgInfoSym @[]char = globalSymFor(pkgName, "_pkg_info")
	var pkgNameSym @[]char = globalSymFor(pkgName, "_pkgname")
	var funcSym @[]char = symFor(pkgName, "_Package")
	var funcsArraySym @[]char = globalSymFor(pkgName, "_pkg_funcs")
	var globalsArraySym @[]char = globalSymFor(pkgName, "_pkg_globals")
	var vtablesArraySym @[]char = globalSymFor(pkgName, "_pkg_vtables")

	var funcs @[]@ir.PkgFuncEntry = collectFuncs_x64(pkgName, mod)
	var globals @[]@ir.PkgGlobalEntry = collectGlobals_x64(pkgName, mod)
	var vtables @[]@ir.PkgVtableEntry = collectVtables_x64(pkgName, mod)

	var dgs @[]@ir.DataGlobal = ir.BuildPackageDescriptors(
		common.STATIC_MANAGED_REFCOUNT, pkgInfoSym, pkgNameSym,
		buf.CopyStr(pkgName), funcsArraySym, funcs, globalsArraySym, globals,
		vtablesArraySym, vtables)
	for i := 0; i < len(dgs); i++ {
		common.EmitDataGlobal(a, dgs[i])
	}

	// The accessor returns the payload pointer (node + the 2 managed-header
	// words = 16 bytes on the 64-bit native target) in RAX.  A leaf with no
	// frame — address-of-node, += header, return.
	a.SetSection("text", -1)
	a.DefineLabel(funcSym)
	a.SetGlobal(funcSym)
	x64.LeaRipLabel(a, x64.Reg(x64.RAX, x64.SZ64), pkgInfoSym) // RAX = &node
	x64.Add(a, x64.Reg(x64.RAX, x64.SZ64), x64.Imm(16))        // RAX += header
	x64.Ret(a)
}

// collectFuncs_x64 gathers the FunctionInfo rows: one per .bni-exported,
// non-extern func (the set collectFuncValueRefs force-emits a __handle for) plus
// own-package struct dtors, then — when reflect was loaded — the synthesized
// `_Package` accessor itself (LAST).  Symbols are x64-prefixed via symPrefixed;
// the Name field is the func's FQ name verbatim (the VM lookup key).
func collectFuncs_x64(pkgName *[]readonly char,
		mod @ir.Module) @[]@ir.PkgFuncEntry {
	var funcs @[]@ir.PkgFuncEntry
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		// + own-package struct dtors (IsStructDtor), injectable when native-only.
		if !f.Exported && !f.IsStructDtor { continue }
		var fv @types.Type = lookupFuncValueType_x64(mod, f.Name)
		if fv == nil { continue }
		funcs = slices.Append[@ir.PkgFuncEntry](funcs,
			funcEntry_x64(pkgName, f.Name, fv))
	}
	if mod.PackageAccessorSig != nil {
		var nameP @[]char = mangle.QualifyName(pkgName, "_Package")
		funcs = slices.Append[@ir.PkgFuncEntry](funcs,
			funcEntry_x64(pkgName, nameP, mod.PackageAccessorSig))
	}
	return funcs
}

// funcEntry_x64 builds one FunctionInfo row: the __fninfo/__fnname/__fnsig
// symbols off the mangled func name, the @__handle.<mangled> Value target, and
// the VM-dispatch RetbufSize + ParamSlots.
func funcEntry_x64(pkgName *[]readonly char, name *[]readonly char,
		fv @types.Type) @ir.PkgFuncEntry {
	var mangled @[]char = mangle.FuncName(pkgName, name)
	return ir.NewPkgFuncEntry(symPrefixed(appendStrFV(mangled, "__fninfo")),
		symPrefixed(appendStrFV(mangled, "__fnname")), buf.CopyStr(name),
		symPrefixed(appendStrFV(mangled, "__fnsig")),
		buf.CopyStr(fv.SigString()), handleSymFor_x64(pkgName, name),
		common.FuncRetbufSize(fv), len(fv.Params))
}

// collectGlobals_x64 gathers the GlobalInfo rows: one per .bni-exported,
// non-extern global.  Name is the FULLY-QUALIFIED form (lookupGlobalAddr's key);
// Addr is the global's storage cell symbol.
func collectGlobals_x64(pkgName *[]readonly char,
		mod @ir.Module) @[]@ir.PkgGlobalEntry {
	var globals @[]@ir.PkgGlobalEntry
	for i := 0; i < len(mod.Globals); i++ {
		var g @ir.Global = mod.Globals[i]
		if g.IsExtern { continue }
		if !g.Exported { continue }
		var mangledG @[]char = mangle.GlobalName(pkgName, g.Name)
		globals = slices.Append[@ir.PkgGlobalEntry](globals,
			ir.NewPkgGlobalEntry(symPrefixed(appendStrFV(mangledG, "__glinfo")),
				symPrefixed(appendStrFV(mangledG, "__glname")),
				mangle.QualifyName(pkgName, g.Name),
				globalSymFor(pkgName, g.Name)))
	}
	return globals
}

// collectVtables_x64 gathers the VtableInfo rows: one per NON-generic impl this
// package defines.  Name is the BARE canonical vtable name (the VM's
// findIfaceVtable / BC_IFACE_VALUE key); Addr/ShimAddr target the
// format-prefixed @__ivt / @__ivtshim globals (implVtableName_x64).
func collectVtables_x64(pkgName *[]readonly char,
		mod @ir.Module) @[]@ir.PkgVtableEntry {
	var vtables @[]@ir.PkgVtableEntry
	for i := 0; i < len(mod.Impls); i++ {
		var info @ir.ImplInfo = mod.Impls[i]
		if info == nil { continue }
		if common.RecvTypeIsGenericInst(info.RecvTypeName) { continue }
		var bareName @[]char = common.ImplVtableBareName(info.RecvPkg,
			info.RecvTypeName, info.IfacePkg, info.IfaceName)
		vtables = slices.Append[@ir.PkgVtableEntry](vtables,
			ir.NewPkgVtableEntry(symPrefixed(appendStrFV(bareName, "__vtinfo")),
				symPrefixed(appendStrFV(bareName, "__vtname")), bareName,
				implVtableName_x64(info), implShimVtableName_x64(info)))
	}
	return vtables
}
