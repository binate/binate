package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/native/common"

// emitPackageDescriptor emits this module's reflect.Package descriptor node
// (shared layout via common.EmitPackageDescriptorData) plus the generated
// `_Package() @reflect.Package` accessor.  See the aarch64 sibling +
// pkg/binate/codegen/emit_pkg_descriptor.bn for the contract: same `_Package`
// symbol + static-managed layout across backends so cross-mode references
// (the bytecode VM's RegisterStandardExterns) resolve to one definition.
func emitPackageDescriptor(a @asm.Assembler, pkgName *[]readonly char) {
	var pkgInfoSym @[]char = globalSymFor(pkgName, "_pkg_info")
	var pkgNameSym @[]char = globalSymFor(pkgName, "_pkgname")
	var funcSym @[]char = symFor(pkgName, "_Package")

	common.EmitPackageDescriptorData(a, pkgInfoSym, pkgNameSym, pkgName)

	// The accessor returns the payload pointer (node + the 2 managed-header
	// words = 16 bytes on the 64-bit native target) in RAX.  A leaf with no
	// frame — address-of-node, += header, return.
	a.SetSection("text", -1)
	a.DefineLabel(funcSym)
	a.SetGlobal(funcSym)
	x64.LeaRipLabel(a, x64.Reg(x64.RAX, x64.SZ64), pkgInfoSym) // RAX = &node
	x64.Add(a, x64.Reg(x64.RAX, x64.SZ64), x64.Imm(16))        // RAX += header
	x64.Ret(a)
}
