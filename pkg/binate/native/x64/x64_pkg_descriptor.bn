package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/stdx/slices"

// emitPackageDescriptor emits this module's reflect.Package descriptor — its
// FunctionInfo / GlobalInfo / VtableInfo tables, the descriptor node + name,
// and the generated `__Package() @reflect.Package` accessor.  See the aarch64
// sibling + pkg/binate/codegen/emit_pkg_descriptor.bn for the contract: the
// whole byte layout is built once by irdata.BuildPackageDescriptors (both backends
// lower it through EmitDataGlobal, so they cannot drift), and the same
// `__Package` symbol + layout across backends lets cross-mode references resolve
// to one definition.
func emitPackageDescriptor(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	var pkgInfoSym @[]char = globalSymFor(pkgName, "_pkg_info")
	var pkgNameSym @[]char = globalSymFor(pkgName, "_pkgname")
	var funcSym @[]char = symFor(pkgName, "__Package")
	var funcsArraySym @[]char = globalSymFor(pkgName, "_pkg_funcs")
	var globalsArraySym @[]char = globalSymFor(pkgName, "_pkg_globals")
	var vtablesArraySym @[]char = globalSymFor(pkgName, "_pkg_vtables")
	var satentriesArraySym @[]char = globalSymFor(pkgName, "_pkg_satentries")

	var funcs @[]@irdata.PkgFuncEntry = collectFuncs_x64(pkgName, mod)
	var globals @[]@irdata.PkgGlobalEntry = collectGlobals_x64(pkgName, mod)
	var vtables @[]@irdata.PkgVtableEntry = collectVtables_x64(pkgName, mod)
	var satEntrySyms @[]@[]char = collectSatEntries_x64(mod)

	var dgs @[]@irdata.DataGlobal = irdata.BuildPackageDescriptors(
			common.STATIC_MANAGED_REFCOUNT, pkgInfoSym, pkgNameSym, buf.CopyStr(pkgName), funcsArraySym,
			funcs, globalsArraySym, globals, vtablesArraySym, vtables, satentriesArraySym, satEntrySyms)
	for i := 0; i < len(dgs); i++ {
		common.EmitDataGlobal(a, dgs[i])
	}

	// The accessor returns the payload pointer (node + the managed header, 2
	// pointer-sized words = 16 on the LP64 native targets) in RAX.  Uses
	// ManagedHeaderSize (the canonical 2*ptrSize helper) — the header is
	// POINTER-sized, not int-sized (identical on every shipping ABI, where
	// int == pointer), so this agrees with the data side's node-payload offset.
	// A leaf with no frame — address-of-node, += header, return.
	var hdr int = types.ManagedHeaderSize()
	a.SetSection("text", -1)
	a.DefineLabel(funcSym)
	a.SetGlobal(funcSym)
	x64.LeaRipLabel(a, x64.Reg(x64.RAX, x64.SZ64), pkgInfoSym) // RAX = &node
	x64.Add(a, x64.Reg(x64.RAX, x64.SZ64), x64.Imm(hdr)) // RAX += header
	x64.Ret(a)
}

// collectFuncs_x64 gathers the FunctionInfo rows: one per .bni-exported,
// non-extern func (the set collectFuncValueRefs force-emits a __handle for) plus
// own-package struct dtors, then — when reflect was loaded — the synthesized
// `__Package` accessor itself (LAST).  Symbols are x64-prefixed via symPrefixed;
// the Name field is the func's FQ name verbatim (the VM lookup key).
func collectFuncs_x64(pkgName *[]readonly char, mod @ir.Module) @[]@irdata.PkgFuncEntry {
	var funcs @[]@irdata.PkgFuncEntry
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		// + own-package struct dtors (IsStructDtor) + lang's primitive methods
		// (IsPrimitiveMethod, reached by direct call), injectable when native-only.
		if !f.Exported && !f.IsStructDtor && !f.IsPrimitiveMethod { continue }
		var fv @types.Type = lookupFuncValueType_x64(mod, f.Name)
		if fv == nil { continue }
		funcs = slices.Append[@irdata.PkgFuncEntry](funcs, funcEntry_x64(pkgName, f.Name, fv))
	}
	if mod.PackageAccessorSig != nil {
		var nameP @[]char = mangle.QualifyName(pkgName, "__Package")
		funcs = slices.Append[@irdata.PkgFuncEntry](funcs,
				funcEntry_x64(pkgName, nameP, mod.PackageAccessorSig))
	}
	return funcs
}

// funcEntry_x64 builds one FunctionInfo row: the __fninfo/__fnname/__fnsig
// symbols off the mangled func name, the @__handle.<mangled> Value target, and
// the VM-dispatch RetbufSize + ParamSlots.
func funcEntry_x64(pkgName *[]readonly char, name *[]readonly char,
		fv @types.Type) @irdata.PkgFuncEntry {
	var mangled @[]char = mangle.FuncName(pkgName, name)
	return irdata.NewPkgFuncEntry(symPrefixed(appendStrFV(mangled, "__fninfo")),
			symPrefixed(appendStrFV(mangled, "__fnname")), buf.CopyStr(name),
			symPrefixed(appendStrFV(mangled, "__fnsig")), buf.CopyStr(fv.SigString()),
			handleSymFor_x64(pkgName, name), common.FuncRetbufSize(fv), len(fv.Params))
}

// collectGlobals_x64 gathers the GlobalInfo rows: one per .bni-exported,
// non-extern global.  Name is the FULLY-QUALIFIED form (lookupGlobalAddr's key);
// Addr is the global's storage cell symbol.
func collectGlobals_x64(pkgName *[]readonly char, mod @ir.Module) @[]@irdata.PkgGlobalEntry {
	var globals @[]@irdata.PkgGlobalEntry
	for i := 0; i < len(mod.Globals); i++ {
		var g @ir.Global = mod.Globals[i]
		if g.IsExtern { continue }
		if !g.Exported { continue }
		var mangledG @[]char = mangle.GlobalName(pkgName, g.Name)
		globals = slices.Append[@irdata.PkgGlobalEntry](globals,
				irdata.NewPkgGlobalEntry(symPrefixed(appendStrFV(mangledG, "__glinfo")),
						symPrefixed(appendStrFV(mangledG, "__glname")), mangle.QualifyName(pkgName, g.Name),
						globalSymFor(pkgName, g.Name)))
	}
	return globals
}

// collectVtables_x64 gathers the VtableInfo rows: one per NON-generic impl this
// package defines.  Name is the BARE canonical vtable name (the VM's
// findIfaceVtable / BC_IFACE_VALUE key); Addr/ShimAddr target the
// format-prefixed @__ivt / @__ivtshim globals (implVtableName_x64).
func collectVtables_x64(pkgName *[]readonly char, mod @ir.Module) @[]@irdata.PkgVtableEntry {
	var vtables @[]@irdata.PkgVtableEntry
	for i := 0; i < len(mod.Impls); i++ {
		var info @ir.ImplInfo = mod.Impls[i]
		if info == nil { continue }
		if common.RecvTypeIsGenericInst(info.RecvTypeName) { continue }
		var bareName @[]char = common.ImplVtableBareName(info.RecvPkg, info.RecvTypeName, info.IfacePkg,
				info.IfaceName)
		vtables = slices.Append[@irdata.PkgVtableEntry](vtables,
				irdata.NewPkgVtableEntry(symPrefixed(appendStrFV(bareName, "__vtinfo")),
						symPrefixed(appendStrFV(bareName, "__vtname")), bareName, implVtableName_x64(info),
						implShimVtableName_x64(info), ir.IfaceFullVtableSize(mod, info.IfacePkg, info.IfaceName)))
	}
	return vtables
}

// collectSatEntries_x64 gathers the SatEntries table's node symbols: the
// object-format-prefixed `__satentry.<T,J>` symbol per distinct (T, J) in mod
// (ir.CollectSatEntries), matching the prefixed nodes emitSatEntriesNative_x64
// emits.  The descriptor's backing array points at each (past its header).
func collectSatEntries_x64(mod @ir.Module) @[]@[]char {
	var descs @[]@irdata.SatEntryDesc = ir.CollectSatEntries(mod)
	var syms @[]@[]char
	for i := 0; i < len(descs); i++ {
		syms = slices.Append[@[]char](syms, symPrefixed(descs[i].Sym))
	}
	return syms
}
