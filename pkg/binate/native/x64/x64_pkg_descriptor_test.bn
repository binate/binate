package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/builtins/testing"

// emitPackageDescriptor must define the exported `_Package` accessor (the
// symbol cross-mode code references) and the descriptor node, and emit the
// accessor body (lea + add + ret) into the text section.  End-to-end behavior
// is covered by conformance/532 on the native x64-darwin mode; this pins that
// the symbols + accessor are emitted.
func TestEmitPackageDescriptorX64() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	emitPackageDescriptor(a, "pkg/x", ir.NewModule("\"pkg/x\""))

	if a.LookupSymbol(symFor("pkg/x", "_Package")) < 0 {
		return "_Package accessor symbol not defined"
	}
	if a.LookupSymbol(globalSymFor("pkg/x", "_pkg_info")) < 0 {
		return "_pkg_info descriptor node not defined"
	}
	// The accessor (lea &node; add #16; ret) lands in the "text" section
	// (index 0); byte count is encoding-dependent, so require it ran AND
	// carries the RIP-relative relocation to _pkg_info (the lea's address-of-
	// node) — without that fixup the accessor would return a bogus pointer.
	if a.Sections[0].Len <= 0 {
		return "accessor body not emitted into text"
	}
	if a.Sections[0].NumFixups < 1 {
		return "accessor missing the RIP-relative reloc to the descriptor node"
	}
	return ""
}
