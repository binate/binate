package "pkg/binate/native/x64"

import "pkg/binate/irbuild"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/native/place"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Function-placement filler on x86-64: INT3 in 16-byte units, ahead of each
// function's own 16-byte entry alignment.

// placeCapture is an ArchEmitter that forwards to inner and, instead of writing
// an object, keeps the assembler EmitObject finished in `out`, so a test sees the
// text EmitObject produced.
type placeCapture struct {
	inner *common.ArchEmitter
	out   @asm.Assembler
}

func (e *placeCapture) WordBytes() int { return e.inner.WordBytes() }

func (e *placeCapture) CallConv() callconv.CallConv { return e.inner.CallConv() }

func (e *placeCapture) SetPrefix(format *[]readonly char) { e.inner.SetPrefix(format) }

func (e *placeCapture) ClearPrefix() { e.inner.ClearPrefix() }

func (e *placeCapture) SymPrefixed(name *[]readonly char) @[]char {
	return e.inner.SymPrefixed(name)
}

func (e *placeCapture) ArchName() *[]readonly char { return e.inner.ArchName() }

func (e *placeCapture) ElfTextMappingSymbol(format *[]readonly char) *[]readonly char {
	return e.inner.ElfTextMappingSymbol(format)
}

func (e *placeCapture) PlaceUnit() int { return e.inner.PlaceUnit() }

func (e *placeCapture) EmitPlaceFill(a @asm.Assembler, nbytes int) {
	e.inner.EmitPlaceFill(a, nbytes)
}

func (e *placeCapture) EmitFunc(a @asm.Assembler, pkgName *[]readonly char, f @ir.Func,
		strings @[]ir.StringConst) {
	e.inner.EmitFunc(a, pkgName, f, strings)
}

func (e *placeCapture) EmitCEntryThunks(a @asm.Assembler, pkgName *[]readonly char,
		targets @[]@ir.Func) {
	e.inner.EmitCEntryThunks(a, pkgName, targets)
}

func (e *placeCapture) EmitFuncValueShims(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	e.inner.EmitFuncValueShims(a, pkgName, mod)
}

func (e *placeCapture) EmitStringTable(a @asm.Assembler, pkgName *[]readonly char,
		strings @[]ir.StringConst) {
	e.inner.EmitStringTable(a, pkgName, strings)
}

func (e *placeCapture) EmitGlobals(a @asm.Assembler, pkgName *[]readonly char,
		globals @[]@ir.Global) {
	e.inner.EmitGlobals(a, pkgName, globals)
}

func (e *placeCapture) EmitFuncValueVtables(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	e.inner.EmitFuncValueVtables(a, pkgName, mod)
}

func (e *placeCapture) EmitImplVtables(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	e.inner.EmitImplVtables(a, pkgName, mod)
}

func (e *placeCapture) EmitPackageDescriptor(a @asm.Assembler, pkgName *[]readonly char,
		mod @ir.Module) {
	e.inner.EmitPackageDescriptor(a, pkgName, mod)
}

func (e *placeCapture) ResolveFixups(a @asm.Assembler) { e.inner.ResolveFixups(a) }

func (e *placeCapture) WriteObject(a @asm.Assembler, format *[]readonly char,
		path *[]readonly char) bool {
	e.out = a
	return true
}

impl *placeCapture : common.ArchEmitter

// placeFuncs are the functions of the module placeEmit emits, in order.
func placeFuncs() @[]@[]char {
	return @[]@[]char{"main.First", "main.Sgn", "main.Loop", "main.Last"}
}

// placeFunc builds placeFuncs()[i]: two empty functions, a #[c_export("ffi_sgn")]
// function with an int8 parameter (a C-entry normalization precedes its mangled
// entry), and a loop (an aligned loop header inside the body).
func placeFunc(i int) @ir.Func {
	var name @[]char = placeFuncs()[i]
	if i == 1 {
		var params @[]@ir.Param = make_slice(@ir.Param, 1)
		params[0] = make(ir.Param)
		params[0].ID = 1
		params[0].Name = "b"
		params[0].Typ = types.TypInt8()
		var noR @[]@types.Type
		var f @ir.Func = ir.NewFunc("", name, params, noR)
		var noArgs @[]@ir.Instr
		irbuild.EmitReturn(ir.AddBlock(f, "entry"), noArgs)
		var names @[]@[]char = make_slice(@[]char, 1)
		names[0] = buf.CopyStr("ffi_sgn")
		f.CExportNames = names
		return f
	}
	if i == 2 {
		var noP @[]@ir.Param
		var noR @[]@types.Type
		var f @ir.Func = ir.NewFunc("", name, noP, noR)
		var entry @ir.Block = ir.AddBlock(f, "entry")
		var header @ir.Block = ir.AddBlock(f, "header")
		var body @ir.Block = ir.AddBlock(f, "body")
		var exit @ir.Block = ir.AddBlock(f, "exit")
		irbuild.EmitJump(entry, header)
		irbuild.EmitBranch(header, irbuild.EmitConstBool(header, false), body, exit)
		irbuild.EmitJump(body, header)
		var noArgs @[]@ir.Instr
		irbuild.EmitReturn(exit, noArgs)
		return f
	}
	return emptyFunc(name)
}

// placeEmit runs EmitObject over placeFuncs in format under placement and returns
// the text it produced (nil on failure).
func placeEmit(format *[]readonly char, placement place.PlaceOptions) @asm.Assembler {
	var m @ir.Module = ir.NewModule("\"main\"")
	for i := 0; i < len(placeFuncs()); i++ {
		m.AddFunc(placeFunc(i))
	}
	var em x64Emitter
	var c placeCapture
	c.inner = &em
	var e *common.ArchEmitter = &c
	if !common.EmitObject(e, m, format, "unused.o", placement) {
		var none @asm.Assembler
		return none
	}
	return c.out
}

// placeAlone returns function i emitted on its own at offset 0 (fixups resolved):
// the bytes it must keep wherever placement puts it.
func placeAlone(i int) @asm.Assembler {
	var a @asm.Assembler = opsMkAssembler()
	emitFunc(a, "main", placeFunc(i), nilStrings(), Options{})
	x64.ResolveFixups(a)
	return a
}

// placePrefix is format's symbol-linkage prefix: "_" on Mach-O, none on ELF.
func placePrefix(format *[]readonly char) *[]readonly char {
	if common.ObjFmtEq(format, "elf") { return "" }
	return "_"
}

// placeEntry returns the first entry point of function i in a (emitted in format):
// its C-export alias if it has one, else its mangled symbol.
func placeEntry(a @asm.Assembler, format *[]readonly char, i int) int {
	if i == 1 { return symOffset(a, buf.Concat(placePrefix(format), "ffi_sgn")) }
	return symOffset(a, buf.Concat(placePrefix(format), mangle.FuncName("main", placeFuncs()[i])))
}

// checkPlacedText checks the text of placeEmit(format, placement): each function's
// bytes equal its bytes alone, every entry point is 16-aligned, and between one
// function's end and the next entry lie exactly the INT3 fill PlaceFillAfter asks for
// after the one function and PlaceFillBefore before the other, then only alignment
// NOPs (never INT3).  Some function must get a nonzero fill.
func checkPlacedText(format *[]readonly char, placement place.PlaceOptions) testing.TestResult {
	var a @asm.Assembler = placeEmit(format, placement)
	if a == nil || a.HasError { return fail("EmitObject must succeed") }
	var text @asm.Section = a.Sections[0]
	var end int = 0
	// The fill after the previous function (a probed one has some).
	var post int = 0
	var total int = 0
	for i := 0; i < len(placeFuncs()); i++ {
		var sym @[]char = mangle.FuncName("main", placeFuncs()[i])
		var fill int = place.PlaceFillBefore(placement, sym, X64_PLACE_UNIT, end + post)
		var start int = placeEntry(a, format, i)
		if start % X64_FUNC_ALIGN != 0 { return fail("a function entry must stay 16-aligned") }
		var j int = end
		for j < start && text.Data[j] == cast(uint8, 0xCC) { j = j + 1 }
		if j - end != post + fill { return fail("the INT3 run before a function must be its fill") }
		for k := j; k < start; k++ {
			if text.Data[k] == cast(uint8, 0xCC) { return fail("only NOPs may follow the fill") }
		}
		if start - j >= X64_FUNC_ALIGN { return fail("at most one alignment pad may follow the fill") }
		var alone @asm.Assembler = placeAlone(i)
		var n int = alone.Sections[0].Len
		for k := 0; k < n; k++ {
			if text.Data[start + k] != alone.Sections[0].Data[k] {
				return fail("placement must not change a function's bytes")
			}
		}
		end = start + n
		post = place.PlaceFillAfter(placement, sym, fill)
		total = total + fill + post
	}
	for k := end; k < end + post; k++ {
		if text.Data[k] != cast(uint8, 0xCC) { return fail("the fill after a function must be INT3") }
	}
	if total == 0 { return fail("the seed should fill before some function") }
	var sgn int = symOffset(a, buf.Concat(placePrefix(format), mangle.FuncName("main", "main.Sgn")))
	if sgn < 0 || sgn % X64_FUNC_ALIGN != 0 { return fail("the mangled entry must stay 16-aligned") }
	return ""
}

// EmitPlaceFill emits n bytes of INT3 and rejects a fill that is not a non-negative
// multiple of 16.
func TestX64EmitPlaceFill() testing.TestResult {
	var em x64Emitter
	var e *common.ArchEmitter = &em
	if e.PlaceUnit() != 16 { return fail("the x64 filler unit is 16 bytes") }
	var a @asm.Assembler = opsMkAssembler()
	e.EmitPlaceFill(a, 48)
	if a.HasError || a.Sections[0].Len != 48 { return fail("a 48-byte fill emits 48 bytes") }
	for i := 0; i < 48; i++ {
		if a.Sections[0].Data[i] != cast(uint8, 0xCC) { return fail("the fill must be INT3") }
	}
	var odd @asm.Assembler = opsMkAssembler()
	e.EmitPlaceFill(odd, 8)
	if !odd.HasError { return fail("a fill that is not a multiple of 16 must be an error") }
	var neg @asm.Assembler = opsMkAssembler()
	e.EmitPlaceFill(neg, -16)
	if !neg.HasError { return fail("a negative fill must be an error") }
	return ""
}

// Seed 0 emits exactly the text emitted without placement.
func TestX64PlaceSeedZeroUnchanged() testing.TestResult {
	setTarget64()
	var off place.PlaceOptions
	var zero place.PlaceOptions
	zero.Mode = place.PLACE_PHASE
	var a @asm.Assembler = placeEmit("elf", off)
	var b @asm.Assembler = placeEmit("elf", zero)
	if a == nil || b == nil { return fail("EmitObject must succeed") }
	if !sameTextX64(a, b) { return fail("seed 0 must leave the text unchanged") }
	if a.Sections[0].Align != b.Sections[0].Align { return fail("seed 0 must keep .text's alignment") }
	return ""
}

// In shift mode each function gets its fill and keeps its bytes and alignment.
func TestX64PlaceShiftKeepsFunctions() testing.TestResult {
	setTarget64()
	var placement place.PlaceOptions
	placement.Seed = 12345
	placement.Mode = place.PLACE_SHIFT
	return checkPlacedText("elf", placement)
}

// In phase mode .text is 64-aligned and each first entry lands on its phase.
func TestX64PlacePhaseLandsOnPhase() testing.TestResult {
	setTarget64()
	var placement place.PlaceOptions
	placement.Seed = 7
	placement.Mode = place.PLACE_PHASE
	var r testing.TestResult = checkPlacedText("elf", placement)
	if len(r) > 0 { return r }
	var a @asm.Assembler = placeEmit("elf", placement)
	if a.Sections[0].Align != place.PLACE_SPAN { return fail("phase mode aligns .text to 64") }
	var k uint32 = cast(uint32, place.PLACE_SPAN / X64_PLACE_UNIT)
	for i := 0; i < len(placeFuncs()); i++ {
		var h uint32 = place.PlaceHash(placement.Seed, mangle.FuncName("main", placeFuncs()[i]))
		var phi int = X64_PLACE_UNIT * cast(int, h % k)
		if placeEntry(a, "elf", i) % place.PLACE_SPAN != phi { return fail("an entry is off its phase") }
	}
	return ""
}

// Phase mode is exact only while the entry alignment equals the filler unit
// (X64_PLACE_UNIT), and the unit must divide PLACE_SPAN.  Function bodies stay
// byte-identical under placement (which the tests above rely on) only while the
// loop alignment divides the entry alignment.
func TestX64PlaceUnitCoversFuncAlign() testing.TestResult {
	if X64_PLACE_UNIT != X64_FUNC_ALIGN {
		return fail("X64_FUNC_ALIGN must equal X64_PLACE_UNIT")
	}
	if X64_FUNC_ALIGN % X64_LOOP_ALIGN != 0 {
		return fail("X64_LOOP_ALIGN must divide X64_FUNC_ALIGN")
	}
	if place.PLACE_SPAN % X64_PLACE_UNIT != 0 { return fail("X64_PLACE_UNIT must divide PLACE_SPAN") }
	return ""
}
