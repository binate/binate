package "pkg/binate/native/x64"

import "pkg/binate/irbuild"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Options.RaxHome adds RAX to the caller-saved GP home pool.  RAX leads the
// pool, so the scan (last free first) fills it last: a value takes RAX only when
// no other caller-saved home is free for it — every one in use, or barred by an
// instruction the value is live at that declares it but not RAX (an aggregate
// store or a float compare declares RCX and RDX only).

// raxHomeSumFunc builds `func main.sum(p0, ..., p<n-1> int) int`, returning
// p0 + p1 + ... + p<n-1> as a chain of integer ADDs.  Every parameter is live
// at the first ADD, so n values are live at once.  An integer ADD declares no
// register (x64RegClobbers), so only the final sum, an operand of the return,
// is barred from RAX, RCX and RDX.
func raxHomeSumFunc(n int) @ir.Func {
	var noP @[]@ir.Param
	var res @[]@types.Type = make_slice(@types.Type, 1)
	res[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "main.sum", noP, res)
	var ps @[]@ir.Param = make_slice(@ir.Param, n)
	for i := 0; i < n; i++ {
		ps[i] = irbuild.NewParam(f, "p", types.TypInt())
	}
	f.Params = ps
	var b @ir.Block = ir.AddBlock(f, "entry")
	var sum @ir.Instr = irbuild.NewParamRef(f, ps[0])
	for i := 1; i < n; i++ {
		var p @ir.Instr = irbuild.NewParamRef(f, ps[i])
		sum = irbuild.EmitBinop(b, iropcode.OP_ADD, sum, p, types.TypInt())
	}
	var rs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rs[0] = sum
	irbuild.EmitReturn(b, rs)
	return f
}

// raxHomeAllocate runs the GP allocation emitFunc runs (fold marking, then
// AllocateRegisters over x64GpClassDesc(opts)) on f and returns the RegMap.
func raxHomeAllocate(f @ir.Func, opts Options) @common.RegMap {
	var rm @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	markFoldCandidates(f, rm)
	rm.AllocateRegisters(f, 8, x64GpClassDesc(opts), true)
	return rm
}

// Seven values live at once, none across a call or at an instruction that
// declares RAX: under RaxHome the seventh takes RAX and no callee-saved register
// is used; by default it takes a callee-saved register, which the prologue then
// saves, and nothing is homed in RAX.
func TestX64RaxHomeAllocatesRax() testing.TestResult {
	setTarget64()
	var on Options
	on.RaxHome = true
	var rmOn @common.RegMap = raxHomeAllocate(raxHomeSumFunc(7), on)
	if !x64HomesIn(rmOn, x64.RAX) {
		return fail("under RaxHome a seventh live value should be homed in RAX")
	}
	if len(rmOn.SavedRegs) != 0 {
		return fail("under RaxHome seven live values should need no callee-saved register")
	}
	var rmOff @common.RegMap = raxHomeAllocate(raxHomeSumFunc(7), Options{})
	if x64HomesIn(rmOff, x64.RAX) {
		return fail("by default nothing should be homed in RAX")
	}
	if len(rmOff.SavedRegs) != 1 || !intIn(x64AllocatablePool(), rmOff.SavedRegs[0]) {
		return fail("by default the seventh live value should take one callee-saved register")
	}
	return ""
}

// raxHomeEmit emits f into a fresh text section under opts.
func raxHomeEmit(f @ir.Func, opts Options) @asm.Assembler {
	var a @asm.Assembler = opsMkAssembler()
	emitFunc(a, "main", f, nilStrings(), opts)
	return a
}

// With no more live values than the default caller-saved homes, and none live
// at an instruction that bars RCX or RDX without RAX, RaxHome never reaches RAX:
// the function emits byte-for-byte as it does by default.  Checked for the empty
// function and for six values live at once, the most the default pool holds.
func TestX64RaxHomeLowPressureUnchanged() testing.TestResult {
	setTarget64()
	var on Options
	on.RaxHome = true
	var emptyOff @asm.Assembler = raxHomeEmit(emptyFunc("main.e"), Options{})
	if !sameTextX64(emptyOff, raxHomeEmit(emptyFunc("main.e"), on)) {
		return fail("RaxHome must not change an empty function")
	}
	var off @asm.Assembler = raxHomeEmit(raxHomeSumFunc(6), Options{})
	if off.HasError { return fail("the six-value sum should emit without error") }
	if !sameTextX64(off, raxHomeEmit(raxHomeSumFunc(6), on)) {
		return fail("RaxHome must not change a function with six values live at once")
	}
	return ""
}
