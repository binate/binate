package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the RCX/RDX declarations and scratch bars (x64_regclobbers.bn).

// rcDecl reports whether decl is exactly the registers want (in order).
func rcDecl(decl @[]int, want @[]int) bool {
	if len(decl) != len(want) { return false }
	for i := 0; i < len(want); i++ {
		if decl[i] != want[i] { return false }
	}
	return true
}

// rcRegs returns {RDX}, or {RCX, RDX} when both.
func rcRegs(both bool) @[]int {
	if !both {
		var r @[]int = make_slice(int, 1)
		r[0] = x64.RDX
		return r
	}
	var r2 @[]int = make_slice(int, 2)
	r2[0] = x64.RCX
	r2[1] = x64.RDX
	return r2
}

// Branches, jumps, bounds checks, constants and an integer op the retention
// cache flows through declare nothing; the same op on floats declares RDX; a
// divide declares RCX and RDX.
func TestX64RegClobbersByOp() testing.TestResult {
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = x64ImmParam(f, types.TypInt())
	var y @ir.Instr = x64ImmParam(f, types.TypInt())
	var k @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt())
	if len(x64RegClobbers(m, k)) != 0 { return "an int constant declares nothing" }
	var add @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, x, y, types.TypInt())
	if len(x64RegClobbers(m, add)) != 0 { return "an int add declares nothing" }
	var fx @ir.Instr = x64ImmParam(f, types.TypFloat64())
	var fadd @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, fx, fx, types.TypFloat64())
	if !rcDecl(x64RegClobbers(m, fadd), rcRegs(false)) { return "a float add declares RDX" }
	var div @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_DIV, x, y, types.TypInt())
	if !rcDecl(x64RegClobbers(m, div), rcRegs(true)) { return "a divide declares RCX and RDX" }
	var bc @ir.Instr = make(ir.Instr)
	bc.Op = iropcode.OP_BOUNDS_CHECK
	bc.ID = -1
	if len(x64RegClobbers(m, bc)) != 0 { return "a bounds check declares nothing" }
	var j @ir.Instr = make(ir.Instr)
	j.Op = iropcode.OP_JUMP
	j.ID = -1
	if len(x64RegClobbers(m, j)) != 0 { return "a jump declares nothing" }
	return ""
}

// The VM-only ops x64 emits as no-ops declare nothing, and each one does emit
// zero bytes.
func TestX64RegClobbersNativeNoOps() testing.TestResult {
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	var ops [5]int = [5]int{iropcode.OP_SP_RESTORE, iropcode.OP_NIL_CHECK, iropcode.OP_STACK_CHECK,
			iropcode.OP_STACK_CHECK_FV, iropcode.OP_STACK_CHECK_IM}
	var noStrings @[]ir.StringConst
	for k := 0; k < 5; k++ {
		var ins @ir.Instr = make(ir.Instr)
		ins.Op = ops[k]
		ins.ID = -1
		if len(x64RegClobbers(m, ins)) != 0 { return "a native no-op declares nothing" }
		var a @asm.Assembler = opsMkAssembler()
		emitInstr(a, "main", "f", m, noStrings, ins)
		if a.Sections[0].Len != 0 || a.HasError { return "x64EmitsNothing names an op that emits code" }
	}
	return ""
}

// A shift by a folded constant count declares nothing; by a register count (in
// CL), RCX and RDX.  A constant folded into its users declares nothing either.
func TestX64RegClobbersShiftAndFolded() testing.TestResult {
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = x64ImmParam(f, types.TypInt())
	var y @ir.Instr = x64ImmParam(f, types.TypInt())
	var c @ir.Instr = irbuild.EmitConstInt(b, 3, types.TypInt())
	var shImm @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_SHL, x, c, types.TypInt())
	var shReg @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_SHL, x, y, types.TypInt())
	if !rcDecl(x64RegClobbers(m, shImm), rcRegs(true)) {
		return "a shift by an unfolded constant reads its count in CL"
	}
	var fl @[]bool = make_slice(bool, f.NextID)
	fl[c.ID] = true
	m.FoldedImm = fl
	if len(x64RegClobbers(m, shImm)) != 0 { return "a shift by a folded count declares nothing" }
	if !rcDecl(x64RegClobbers(m, shReg), rcRegs(true)) {
		return "a register-count shift declares RCX and RDX"
	}
	if len(x64RegClobbers(m, c)) != 0 { return "a folded constant declares nothing" }
	return ""
}

// While RCX is barred, allocReg hands out R10, R11 and then RDX, skipping RCX.
func TestX64AllocRegSkipsBarredRcx() testing.TestResult {
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	scratchBarRCX = true
	var r0 int = allocReg(m)
	var r1 int = allocReg(m)
	var r2 int = allocReg(m)
	clearScratchBars()
	if r0 != x64.R10 || r1 != x64.R11 || r2 != x64.RDX {
		return "with RCX barred the pool order is R10, R11, RDX"
	}
	m.ClearUsed()
	var u0 int = allocReg(m)
	var u1 int = allocReg(m)
	var u2 int = allocReg(m)
	if u2 != x64.RCX || u0 != x64.R10 || u1 != x64.R11 {
		return "without bars RCX is the third scratch"
	}
	return ""
}

// setScratchBars bars RCX for a float add in a function with an RCX home and
// drops a value retained there; RDX, which the float add declares, stays
// available.  Without a home in either register nothing is barred.
func TestX64SetScratchBarsDropsRetained() testing.TestResult {
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = x64ImmParam(f, types.TypFloat64())
	var add @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, x, x, types.TypFloat64())
	setScratchBars(m, add, false, false)
	if scratchBarRCX || scratchBarRDX { return "no homes in RCX/RDX: nothing is barred" }
	_ = m.AssignReg(x.ID, x64.RCX)
	setScratchBars(m, add, true, true)
	var rcx bool = scratchBarRCX
	var rdx bool = scratchBarRDX
	clearScratchBars()
	if !rcx { return "a float add does not declare RCX, so an RCX home bars it" }
	if rdx { return "a float add declares RDX, so it stays available" }
	if m.RegHeldBy(x64.RCX) >= 0 { return "the value retained in RCX must be dropped" }
	return ""
}

// The retention-safe shapes that can take a fourth scratch declare RCX and RDX:
// an aggregate store and a float compare.  Their plain counterparts (a scalar
// store, an int compare) declare nothing.
func TestX64RegClobbersFourScratchShapes() testing.TestResult {
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var fx @ir.Instr = x64ImmParam(f, types.TypFloat64())
	var fy @ir.Instr = x64ImmParam(f, types.TypFloat64())
	var fcmp @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_LT, fx, fy, types.TypBool())
	if !rcDecl(x64RegClobbers(m, fcmp), rcRegs(true)) { return "a float compare declares RCX and RDX" }
	var x @ir.Instr = x64ImmParam(f, types.TypInt())
	var icmp @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_LT, x, x, types.TypBool())
	if len(x64RegClobbers(m, icmp)) != 0 { return "an int compare declares nothing" }
	var arr12 @types.Type = types.MakeArrayType(types.TypUint8(), 12)
	var p @ir.Instr = irbuild.EmitAlloc(b, arr12)
	var q @ir.Instr = irbuild.EmitAlloc(b, arr12)
	irbuild.EmitStore(b, p, irbuild.EmitLoad(b, q, arr12))
	var st @ir.Instr = b.Instrs[len(b.Instrs) - 1]
	if !rcDecl(x64RegClobbers(m, st), rcRegs(true)) {
		return "an aggregate store declares RCX and RDX"
	}
	var ip @ir.Instr = irbuild.EmitAlloc(b, types.TypInt())
	irbuild.EmitStore(b, ip, x)
	var sst @ir.Instr = b.Instrs[len(b.Instrs) - 1]
	if len(x64RegClobbers(m, sst)) != 0 { return "a scalar store declares nothing" }
	return ""
}

// An element GEP declares nothing, whatever its element size: a non-SIB size
// (24) scales the index in the result register, which takes over the index's
// reload register, so two scratch registers suffice.
func TestX64RegClobbersElemGepScale() testing.TestResult {
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var i @ir.Instr = x64ImmParam(f, types.TypInt())
	var big @types.Type = types.MakeArrayType(types.TypInt64(), 3)
	var arrBig @ir.Instr = irbuild.EmitAlloc(b, types.MakeArrayType(big, 4))
	var gBig @ir.Instr = irbuild.EmitGetElemPtr(b, arrBig, i, big)
	if len(x64RegClobbers(m, gBig)) != 0 { return "a 24-byte element GEP declares nothing" }
	var arrW @ir.Instr = irbuild.EmitAlloc(b, types.MakeArrayType(types.TypInt64(), 4))
	var gW @ir.Instr = irbuild.EmitGetElemPtr(b, arrW, i, types.TypInt64())
	if len(x64RegClobbers(m, gW)) != 0 { return "an 8-byte element GEP declares nothing" }
	return ""
}

// rcSpilledMap returns a RegMap in which ids[0..] each have a spill slot (so
// every operand and result needs a scratch register), as in a function with
// homes in RCX and RDX elsewhere.
func rcSpilledMap(ids @[]int) @common.RegMap {
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	for k := 0; k < len(ids); k++ {
		m.SpillIDs = common.AppendInt(m.SpillIDs, ids[k])
		m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8 * k)
	}
	return m
}

// rcEmitBarred emits ins against m as the instruction loop does, with the
// scratch bars of a function that has homes in both RCX and RDX and the
// operands' cached registers claimed, and reports whether it emitted without
// error.  A shape that takes a register its declaration does not name panics in
// allocReg.
func rcEmitBarred(m @common.RegMap, ins @ir.Instr) bool {
	var a @asm.Assembler = opsMkAssembler()
	var noStrings @[]ir.StringConst
	setScratchBars(m, ins, true, true)
	claimCachedOperands(m, ins)
	emitInstr(a, "main", "f", m, noStrings, ins)
	clearScratchBars()
	return !a.HasError
}

// With every operand and the result spilled, a float compare takes four
// scratch registers and declares RCX and RDX, so it emits in a function with
// homes in RCX and RDX, where an undeclared register is barred.
func TestX64FourScratchShapesEmitUnderBars() testing.TestResult {
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var fx @ir.Instr = x64ImmParam(f, types.TypFloat64())
	var fy @ir.Instr = x64ImmParam(f, types.TypFloat64())
	var fcmp @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_EQ, fx, fy, types.TypBool())
	var ids @[]int = make_slice(int, 3)
	ids[0] = fx.ID
	ids[1] = fy.ID
	ids[2] = fcmp.ID
	if !rcEmitBarred(rcSpilledMap(ids), fcmp) {
		return "a spilled float compare must emit under the bars"
	}
	return ""
}

// rcGepGolden emits a non-SIB element GEP over elements of type et with the
// index (slot 0), the base pointer (slot 8) and the result all spilled, and
// compares the bytes with want.
func rcGepGolden(et @types.Type, want *[]readonly char, what *[]readonly char) testing.TestResult {
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var i @ir.Instr = x64ImmParam(f, types.TypInt())
	var base @ir.Instr = x64ImmParam(f, types.MakePointerType(et))
	var gep @ir.Instr = irbuild.EmitGetElemPtr(b, base, i, et)
	var ids @[]int = make_slice(int, 3)
	ids[0] = i.ID
	ids[1] = base.ID
	ids[2] = gep.ID
	var a @asm.Assembler = opsMkAssembler()
	emitGetElemPtr(a, "main", rcSpilledMap(ids), gep)
	return x64FoldGolden(a, want, what)
}

// A non-SIB element GEP scales the index in the result register (IMUL for 24,
// SHL for 32) and adds the base.  The result takes over the index's reload
// register (R10), so index/result and base need two scratch registers: R10, R11.
func TestX64NonSibGepGoldens() testing.TestResult {
	var big @types.Type = types.MakeArrayType(types.TypInt64(), 3)
	var r testing.TestResult = rcGepGolden(big, "4c 8b 14 24 4d 6b d2 18 4c 8b 5c 24 08 4f 8d 14 13",
			"24-byte elements")
	if len(r) != 0 { return r }
	var p2 @types.Type = types.MakeArrayType(types.TypInt64(), 4)
	return rcGepGolden(p2, "4c 8b 14 24 49 c1 e2 05 4c 8b 5c 24 08 4f 8d 14 13", "32-byte elements")
}

// rcRegion gives value id a stack region of sz bytes at frame offset off (as
// PlanFrame does for an aggregate load), in m.
func rcRegion(m @common.RegMap, id int, sz int, off int) {
	m.AllocIDs = common.AppendInt(m.AllocIDs, id)
	m.AllocSizes = common.AppendInt(m.AllocSizes, sz)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, off)
}

// Integer ops the retention cache flows through declare nothing, so with every
// operand and the result spilled they must emit with only R10 and R11: an add
// and an unfused compare (the result takes over lhs's reload register), a SIB
// element GEP (the result takes over the index's), an aggregate load from a
// spilled pointer and from a stack slot (the result is the copy's destination
// base), and a non-SIB element GEP (the index is scaled in the result).
func TestX64TwoScratchShapesEmitUnderBars() testing.TestResult {
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var x @ir.Instr = x64ImmParam(f, types.TypInt())
	var y @ir.Instr = x64ImmParam(f, types.TypInt())
	var add @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, x, y, types.TypInt())
	var cmp @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_LT, x, y, types.TypBool())
	var base @ir.Instr = x64ImmParam(f, types.MakePointerType(types.TypInt64()))
	var gep @ir.Instr = irbuild.EmitGetElemPtr(b, base, x, types.TypInt64())
	var rec @types.Type = types.MakeArrayType(types.TypUint8(), 12)
	var rp @ir.Instr = x64ImmParam(f, types.MakePointerType(rec))
	var ld @ir.Instr = irbuild.EmitLoad(b, rp, rec)
	var slot @ir.Instr = irbuild.EmitAlloc(b, rec)
	var ld2 @ir.Instr = irbuild.EmitLoad(b, slot, rec)
	var ids @[]int = make_slice(int, 8)
	ids[0] = x.ID
	ids[1] = y.ID
	ids[2] = add.ID
	ids[3] = cmp.ID
	ids[4] = base.ID
	ids[5] = gep.ID
	ids[6] = rp.ID
	ids[7] = ld.ID
	var m @common.RegMap = rcSpilledMap(ids)
	rcRegion(m, ld.ID, 16, 128)
	rcRegion(m, slot.ID, 16, 160)
	rcRegion(m, ld2.ID, 16, 192)
	if !rcEmitBarred(m, add) { return "a spilled int add must emit with R10 and R11" }
	m.ClearUsed()
	if !rcEmitBarred(m, cmp) { return "a spilled int compare must emit with R10 and R11" }
	m.ClearUsed()
	if !rcEmitBarred(m, gep) { return "a spilled SIB element GEP must emit with R10 and R11" }
	m.ClearUsed()
	if !rcEmitBarred(m, ld) {
		return "an aggregate load through a spilled pointer must emit with R10 and R11"
	}
	m.ClearUsed()
	if !rcEmitBarred(m, ld2) {
		return "an aggregate load from a stack slot must emit with R10 and R11"
	}
	var big3 @types.Type = types.MakeArrayType(types.TypInt64(), 3)
	var nbase @ir.Instr = x64ImmParam(f, types.MakePointerType(big3))
	var i @ir.Instr = x64ImmParam(f, types.TypInt())
	var ngep @ir.Instr = irbuild.EmitGetElemPtr(b, nbase, i, big3)
	var gids @[]int = make_slice(int, 3)
	gids[0] = nbase.ID
	gids[1] = i.ID
	gids[2] = ngep.ID
	if !rcEmitBarred(rcSpilledMap(gids), ngep) {
		return "a spilled non-SIB element GEP must emit with R10 and R11"
	}
	return ""
}
