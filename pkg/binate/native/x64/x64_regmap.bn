package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/std/fmt"

// ============================================================
// SysV-AMD64 register allocation over common.RegMap
// ============================================================
//
// Frame layout, lookups, and type predicates live in pkg/binate/native/common.
// This file owns the pieces that touch SysV-AMD64 registers or emit
// instructions: the scratch-register pool, the MOV-on-use reload in
// getOperand, and the result spill — deferred by lazy spill (see handleResult /
// spillDirtyLive / storeDirtyOnEvict).
//
// Scratch pool design:
//   - RDI/RSI/RDX/RCX/R8/R9 are the SysV-AMD64 arg registers.  We
//     keep them out of the general scratch pool for now to leave room
//     for the call-emit path (Phase 3e) to use them directly without
//     fighting the regmap.
//   - RAX is the return-value register and is the implicit operand
//     for IMUL/IDIV — also kept out of the pool.
//   - R10 / R11 are SysV-AMD64 caller-saved scratch registers with no
//     special role.  Plus RBX-RCX-RDX up here through this slot list
//     give a 7-slot pool, matching aa64's primary X9..X15 count.
//   - R12..R15 are callee-saved; Phase 3b doesn't need them because
//     the spill-everything policy means values don't live across
//     instructions.
func regPool(i int) int {
	if i == 0 { return x64.R10 }
	if i == 1 { return x64.R11 }
	if i == 2 { return x64.RCX }
	if i == 3 { return x64.RDX }
	if i == 4 { return x64.R8 }
	if i == 5 { return x64.R9 }
	if i == 6 { return x64.RDI }
	fmt.Print("native amd64: regPool exhausted while emitting op=", currentEmitOp, "\n")
	panic(
			"native amd64: regPool exhausted; any op needing 8+ live "
					"scratches needs a per-arg ResetRegs or a spill strategy "
					"— see arm64_call.bn for the per-arg pattern")
	return 0 // unreachable
}

// currentEmitOp is set by emitInstr at the start of each lowering to
// the integer ir.OP_* constant of the instruction being emitted.  Used
// only by the regPool-exhaustion panic to identify which op pattern
// hit the saturation point.
var currentEmitOp int

// allocReg hands out a pool register (R10..RDI) for the currently-emitting
// instruction, occupancy-aware for within-block value retention: it prefers a
// genuinely FREE register (one holding no retained value), and only under
// register pressure evicts a retained value — whose spill slot still holds it,
// so eviction is loss-free.  Registers this instruction already claimed
// (CurUsed) are never handed out again.  The returned register is marked used.
//
// Retention is only ever carried across retention-safe ops (see retentionSafe
// below); the emit loop resets the cache before every other op,
// so an op that hardcodes an ISA-forced pool register (RCX/RDX for shift/div,
// R8/R9/R11 for float, RDI for the memcpy-shaped paths) always runs against the
// empty pool its hand-written register dance assumes.
func allocReg(m @common.RegMap) int {
	for i := 0; i <= 6; i = i + 1 {
		var r int = regPool(i)
		if !m.IsUsed(r) && m.RegHeldBy(r) < 0 {
			m.MarkUsed(r)
			return r
		}
	}
	for i := 0; i <= 6; i = i + 1 {
		var r int = regPool(i)
		if !m.IsUsed(r) {
			storeDirtyOnEvict(m, r)
			m.EvictReg(r)
			m.MarkUsed(r)
			return r
		}
	}
	// Every pool register is claimed by the current instruction: the
	// pre-existing exhaustion case, reported by regPool's own panic.
	return regPool(7)
}

// storeDirtyOnEvict spills the value in arch-register `reg` to its slot when it
// is a DIRTY (lazy-spilled, not-yet-stored) cached value, then marks it clean,
// so a later reload reads the correct value.  Called before every eviction of
// a pool register whose current occupant is about to be clobbered.  The
// IsDirty early-out makes it a no-op for a non-dirty (already-stored) value; a
// dirty value always has a spill slot (only isAllocatableDef results are marked
// dirty, and PlanFrame slots every such result) and runs on the lazy-spill path
// with CurAsm set, so the fail-loud below only trips on a real invariant break.
func storeDirtyOnEvict(m @common.RegMap, reg int) {
	var id int = m.RegHeldBy(reg)
	if id < 0 { return }
	if !m.IsDirty(id) { return }
	// A dirty value is always an allocatable result (PlanFrame slotted it) on a
	// backend that stamped the CurAsm back-channel.  A missing slot or nil CurAsm
	// would silently drop a live value on reuse of its register — fail loud.
	var off int = m.LookupSpill(id)
	if off < 0 || m.CurAsm == nil {
		panic("storeDirtyOnEvict: dirty value must have a spill slot and CurAsm set")
	}
	x64.Mov(m.CurAsm, x64.Mem(x64.RSP, off, x64.SZ64), x64.Reg(reg, x64.SZ64))
	m.ClearDirty(id)
}

// spillDirtyLive writes every DIRTY cached value that is LIVE at this program
// point (in liveSet, an id-indexed bool set) to its spill slot and marks it
// clean, just before the cache is dropped by a reset.  Dirty values NOT in
// liveSet are dead here and are left for the reset to drop unstored — eliding
// their store is the point of the optimization.  liveSet is the live-BEFORE
// set for a pre-op barrier (its operands must reach their slots) and the
// live-AFTER set for a post-op / block-end drop.
func spillDirtyLive(a @asm.Assembler, m @common.RegMap, liveSet @[]bool) {
	// Snapshot: ClearDirty rebuilds DirtyIDs, so iterate the old slice.
	var ids @[]int = m.DirtyIDs
	for k := 0; k < len(ids); k++ {
		var id int = ids[k]
		if id >= len(liveSet) { continue }
		if !liveSet[id] { continue }
		var reg int = m.LookupReg(id)
		var off int = m.LookupSpill(id)
		if reg >= 0 && off >= 0 {
			x64.Mov(a, x64.Mem(x64.RSP, off, x64.SZ64), x64.Reg(reg, x64.SZ64))
		}
		m.ClearDirty(id)
	}
}

// handleResult records a just-emitted instruction's result.  A register-
// allocatable scalar is marked DIRTY: its store is deferred (lazy spill) to
// eviction / a drop-while-live, and elided entirely when the value is used only
// from its register.  A non-allocatable result (aggregate / float / wide-int)
// is outside the liveness universe that drives lazy spill, so it keeps the
// eager store to its slot on definition.  A homed result (no cache entry) and a
// void instruction are no-ops.
func handleResult(a @asm.Assembler, m @common.RegMap, ins @ir.Instr) {
	if ins.ID < 0 { return }
	var reg int = m.LookupReg(ins.ID)
	if reg < 0 { return }
	if common.IsAllocatableDef(ins, 8) {
		m.MarkDirty(ins.ID)
		return
	}
	var off int = m.LookupSpill(ins.ID)
	if off >= 0 {
		x64.Mov(a, x64.Mem(x64.RSP, off, x64.SZ64), x64.Reg(reg, x64.SZ64))
	}
}

// scratchReg hands out an ephemeral register (not registered in the
// id→reg map).  Used when we need a working register that won't
// outlive the current instruction.
func scratchReg(m @common.RegMap) int {
	return allocReg(m)
}

// nextReg allocates a register to hold SSA id's result.  A
// register-allocated value computes directly into its stable HOME register
// (callee-saved, RBX/R12..R15) — bypassing the transient scratch pool, so it
// is not spilled and survives ResetRegs / block boundaries.  A spilled value
// takes a scratch-pool register and is recorded in the transient map; its store
// to the slot is deferred (lazy spill) until it is evicted or dropped while
// live — see handleResult.
func nextReg(m @common.RegMap, id int) int {
	var home int = m.LookupHome(id)
	if home >= 0 { return home }
	var r int = allocReg(m)
	return m.AssignReg(id, r)
}

// getOperand returns the register holding SSA id.  If the value isn't
// in the current regmap, it's reloaded from the spill slot into a
// fresh scratch register.  For OP_ALLOC values — whose SSA identity
// is "pointer to the alloca's storage" — we materialise that pointer
// on demand as `lea rd, [rsp + alloc_off]`.  Returns -1 if none of
// the mappings apply.
func getOperand(a @asm.Assembler, m @common.RegMap, id int) int {
	// A register-allocated value lives in its home register for its whole
	// lifetime — return it directly, with no reload.
	var home int = m.LookupHome(id)
	if home >= 0 { return home }
	var r int = m.LookupReg(id)
	if r >= 0 {
		// A retained value cached in a pool register (within-block retention).
		// Mark it used so this instruction's later scratch/result allocation
		// won't reuse it.
		m.MarkUsed(r)
		return r
	}
	var allocOff int = m.LookupAlloc(id)
	if allocOff >= 0 {
		var rd int = nextReg(m, id)
		x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.Mem(x64.RSP, allocOff, x64.SZ64))
		return rd
	}
	var off int = m.LookupSpill(id)
	if off >= 0 {
		var rd int = nextReg(m, id)
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Mem(x64.RSP, off, x64.SZ64))
		return rd
	}
	return -1
}

// emitValOperand resolves an instruction to a register holding its
// VALUE — like getOperand, but global-ref aware.  A global reference
// (`&G`) is an IsGlobalRef pseudo-Instr with ID -1 and no SSA register,
// so getOperand misses every lookup and returns -1; the value-operand
// site then drops the operand (call arg / return / compare / bit_cast)
// or stores garbage.  Materialize the address into a fresh scratch
// register via emitGlobalAddr (RIP-relative LEA) instead; otherwise
// defer to getOperand.  Two distinct globals in one instruction
// (`&G == &H`) each get their own scratch, so neither clobbers the
// other.  Mirrors aarch64's emitValOperand and emitValRef in
// pkg/binate/codegen.
func emitValOperand(a @asm.Assembler, pkgName *[]readonly char, m @common.RegMap,
		ins @ir.Instr) int {
	if isGlobalRef(ins) {
		var rd int = scratchReg(m)
		emitGlobalAddr(a, pkgName, rd, ins)
		return rd
	}
	return getOperand(a, m, ins.ID)
}

// retentionSafe reports whether OP `op`'s emitter may have the retained value
// cache flow THROUGH it: its emitter allocates working registers only via the
// occupancy-aware getOperand / nextReg / scratchReg (or fixed XMM scratch, for
// the float ops), never hardcodes an ISA-forced pool register, and makes no
// round-robin pool-slot assumption — so it never silently overwrites a pool
// register holding an unrelated retained value.  Every other op is a barrier:
// the emit loop resets the cache before it, so a shift (RCX), div/rem
// (RAX/RDX), or a memcpy-shaped managed/rodata/iface/stackframe/call path runs
// against the empty pool its hand-written register dance assumes.  The listed
// ops are the clean integer binops (emitBinop's non-shift/div path), compares,
// casts, unops, copies, and the pointer/load/store/alloc/extract ops; the
// float binop/compare/neg forms use fixed XMM scratch plus those allocators.
//
// OP_CAST's unsigned-int64 <-> float lowering (emitUint64ToDouble /
// emitDoubleToUint64) is a special case: it takes GP scratch from
// pickScratchGP / pickTwoScratchGP rather than the standard allocators.  Those
// pickers evict any retained value in a register they hand out (like allocReg),
// so a clobbered value reloads from its spill slot — OP_CAST stays
// occupancy-safe.
func retentionSafe(op int) bool {
	if op == iropcode.OP_ADD { return true }
	if op == iropcode.OP_SUB { return true }
	if op == iropcode.OP_MUL { return true }
	if op == iropcode.OP_AND { return true }
	if op == iropcode.OP_OR { return true }
	if op == iropcode.OP_XOR { return true }
	if op == iropcode.OP_LAND { return true }
	if op == iropcode.OP_LOR { return true }
	if op == iropcode.OP_EQ { return true }
	if op == iropcode.OP_NE { return true }
	if op == iropcode.OP_LT { return true }
	if op == iropcode.OP_LE { return true }
	if op == iropcode.OP_GT { return true }
	if op == iropcode.OP_GE { return true }
	if op == iropcode.OP_CAST { return true }
	if op == iropcode.OP_NEG { return true }
	if op == iropcode.OP_NOT { return true }
	if op == iropcode.OP_BITNOT { return true }
	if op == iropcode.OP_ALLOC { return true }
	if op == iropcode.OP_GET_FIELD_PTR { return true }
	if op == iropcode.OP_GET_ELEM_PTR { return true }
	if op == iropcode.OP_EXTRACT { return true }
	if op == iropcode.OP_LOAD { return true }
	if op == iropcode.OP_COPY { return true }
	if op == iropcode.OP_STORE { return true }
	return false
}
