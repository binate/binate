package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/std/strconv"

// ============================================================
// SysV-AMD64 register allocation over common.RegMap
// ============================================================
//
// Frame layout, lookups, and type predicates live in pkg/binate/native/common.
// This file owns the pieces that touch SysV-AMD64 registers or emit
// instructions: the scratch-register pool, the MOV-on-use reload in
// getOperand, and the MOV-on-result spill in spillAndReset.
//
// Scratch pool design:
//   - RDI/RSI/RDX/RCX/R8/R9 are the SysV-AMD64 arg registers.  We
//     keep them out of the general scratch pool for now to leave room
//     for the call-emit path (Phase 3e) to use them directly without
//     fighting the regmap.
//   - RAX is the return-value register and is the implicit operand
//     for IMUL/IDIV — also kept out of the pool.
//   - R10 / R11 are SysV-AMD64 caller-saved scratch registers with no
//     special role.  Plus RBX-RCX-RDX up here through this slot list
//     give a 7-slot pool, matching aa64's primary X9..X15 count.
//   - R12..R15 are callee-saved; Phase 3b doesn't need them because
//     the spill-everything policy means values don't live across
//     instructions.
func regPool(i int) int {
	if i == 0 { return x64.R10 }
	if i == 1 { return x64.R11 }
	if i == 2 { return x64.RCX }
	if i == 3 { return x64.RDX }
	if i == 4 { return x64.R8  }
	if i == 5 { return x64.R9  }
	if i == 6 { return x64.RDI }
	print("native amd64: regPool exhausted while emitting op=")
	println(strconv.Itoa(currentEmitOp))
	panic("native amd64: regPool exhausted; any op needing 8+ live "
		"scratches needs a per-arg ResetRegs or a spill strategy "
		"— see arm64_call.bn for the per-arg pattern")
	return 0  // unreachable
}

// currentEmitOp is set by emitInstr at the start of each lowering to
// the integer ir.OP_* constant of the instruction being emitted.  Used
// only by the regPool-exhaustion panic to identify which op pattern
// hit the saturation point.
var currentEmitOp int

// scratchReg hands out an ephemeral register (not registered in the
// id→reg map).  Used when we need a working register that won't
// outlive the current instruction.
func scratchReg(m @common.RegMap) int {
	var r int = regPool(m.Next)
	m.Next = m.Next + 1
	return r
}

// nextReg allocates the next free register for SSA id and records the
// mapping in the common regmap.
func nextReg(m @common.RegMap, id int) int {
	var r int = regPool(m.Next)
	m.Next = m.Next + 1
	return m.AssignReg(id, r)
}

// getOperand returns the register holding SSA id.  If the value isn't
// in the current regmap, it's reloaded from the spill slot into a
// fresh scratch register.  For OP_ALLOC values — whose SSA identity
// is "pointer to the alloca's storage" — we materialise that pointer
// on demand as `lea rd, [rsp + alloc_off]`.  Returns -1 if none of
// the mappings apply.
func getOperand(a @asm.Assembler, m @common.RegMap, id int) int {
	var r int = m.LookupReg(id)
	if r >= 0 { return r }
	var allocOff int = m.LookupAlloc(id)
	if allocOff >= 0 {
		var rd int = nextReg(m, id)
		x64.Lea(a, x64.Reg(rd, x64.SZ64),
			x64.Mem(x64.RSP, allocOff, x64.SZ64))
		return rd
	}
	var off int = m.LookupSpill(id)
	if off >= 0 {
		var rd int = nextReg(m, id)
		x64.Mov(a, x64.Reg(rd, x64.SZ64),
			x64.Mem(x64.RSP, off, x64.SZ64))
		return rd
	}
	return -1
}

// emitValOperand resolves an instruction to a register holding its
// VALUE — like getOperand, but global-ref aware.  A global reference
// (`&G`) is an IsGlobalRef pseudo-Instr with ID -1 and no SSA register,
// so getOperand misses every lookup and returns -1; the value-operand
// site then drops the operand (call arg / return / compare / bit_cast)
// or stores garbage.  Materialize the address into a fresh scratch
// register via emitGlobalAddr (RIP-relative LEA) instead; otherwise
// defer to getOperand.  Two distinct globals in one instruction
// (`&G == &H`) each get their own scratch, so neither clobbers the
// other.  Mirrors aarch64's emitValOperand and emitValRef in
// pkg/binate/codegen.
func emitValOperand(a @asm.Assembler, pkgName *[]readonly char,
	m @common.RegMap, ins @ir.Instr) int {
	if isGlobalRef(ins) {
		var rd int = scratchReg(m)
		emitGlobalAddr(a, pkgName, rd, ins)
		return rd
	}
	return getOperand(a, m, ins.ID)
}

// spillAndReset stores the result of a just-emitted instruction to
// its stack slot (if any) and clears the register map.  Called after
// every instruction — the "spill everything" policy means each op
// loads operands, computes, then hands off to memory.
func spillAndReset(a @asm.Assembler, m @common.RegMap, ins @ir.Instr) {
	if ins.ID >= 0 {
		var reg int = m.LookupReg(ins.ID)
		if reg >= 0 {
			var off int = m.LookupSpill(ins.ID)
			if off >= 0 {
				x64.Mov(a, x64.Mem(x64.RSP, off, x64.SZ64),
					x64.Reg(reg, x64.SZ64))
			}
		}
	}
	m.ResetRegs()
}
