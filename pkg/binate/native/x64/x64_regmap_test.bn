package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// regMapMkAsm: minimal assembler shared across the regmap tests.
func regMapMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// regPool returns the SysV-AMD64 caller-saved scratches in a fixed
// order (R10, R11, RCX, RDX, R8, R9, RDI).  The exact order isn't
// the contract — but pinning it makes the test surface stable so a
// reorder is a deliberate choice.
func TestRegPoolOrder() testing.TestResult {
	if regPool(0) != x64.R10 { return "slot 0 should be R10" }
	if regPool(1) != x64.R11 { return "slot 1 should be R11" }
	if regPool(2) != x64.RCX { return "slot 2 should be RCX" }
	if regPool(3) != x64.RDX { return "slot 3 should be RDX" }
	if regPool(4) != x64.R8 { return "slot 4 should be R8" }
	if regPool(5) != x64.R9 { return "slot 5 should be R9" }
	if regPool(6) != x64.RDI { return "slot 6 should be RDI" }
	return ""
}

// scratchReg hands out distinct FREE pool registers and marks each used, so a
// later allocation in the same instruction won't reuse one; it registers no
// id→reg mapping.
func TestScratchRegHandsOutDistinctAndMarksUsed() testing.TestResult {
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var r0 int = scratchReg(m)
	var r1 int = scratchReg(m)
	if r0 != x64.R10 || r1 != x64.R11 {
		return "scratchReg should hand out free pool registers R10 then R11"
	}
	if !m.IsUsed(r0) || !m.IsUsed(r1) {
		return "scratchReg should mark each returned register used"
	}
	// Scratch regs are NOT in the id→reg map (no id was passed).
	if m.LookupReg(0) >= 0 {
		return "scratchReg should not register an id mapping"
	}
	return ""
}

// nextReg registers the id→reg mapping for a spilled result.
func TestNextRegRegisters() testing.TestResult {
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var r int = nextReg(m, 7)
	if r != x64.R10 {
		return "first nextReg should return R10"
	}
	if m.LookupReg(7) != x64.R10 {
		return "nextReg should register the id→reg mapping"
	}
	return ""
}

// getOperand for an id already in the live regmap returns the
// registered register without emitting any reload.
func TestGetOperandHitsRegMap() testing.TestResult {
	var a @asm.Assembler = regMapMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.AssignReg(5, x64.RDX)
	var r int = getOperand(a, m, 5)
	if r != x64.RDX {
		return "getOperand should return live-regmap entry"
	}
	if a.Sections[0].Len != 0 {
		return "getOperand on regmap hit must not emit"
	}
	return ""
}

// getOperand for an alloca id materialises `lea rd, [rsp + off]`.
// The exact byte count varies by encoding (REX.W + opcode +
// ModRM + disp); just pin "non-empty".
func TestGetOperandMaterialisesAlloca() testing.TestResult {
	var a @asm.Assembler = regMapMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.AllocIDs = common.AppendInt(m.AllocIDs, 9)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 32)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 8)
	var r int = getOperand(a, m, 9)
	if r < 0 {
		return "getOperand should materialise alloca pointer"
	}
	if a.Sections[0].Len == 0 {
		return "alloca getOperand should emit LEA"
	}
	return ""
}

// getOperand for a spilled (but not live in regmap) id reloads
// from `[rsp + off]` into a fresh scratch register.
func TestGetOperandReloadsSpill() testing.TestResult {
	var a @asm.Assembler = regMapMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 11)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 24)
	var r int = getOperand(a, m, 11)
	if r < 0 {
		return "getOperand should reload from spill slot"
	}
	if a.Sections[0].Len == 0 {
		return "spill reload should emit MOV"
	}
	// After reload, the id is registered in the live regmap.
	if m.LookupReg(11) != r {
		return "spill reload should register id→reg mapping"
	}
	return ""
}

// getOperand returns -1 when nothing matches.
func TestGetOperandMissReturnsMinusOne() testing.TestResult {
	var a @asm.Assembler = regMapMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var r int = getOperand(a, m, 999)
	if r != -1 {
		return "getOperand should return -1 on miss"
	}
	if a.Sections[0].Len != 0 {
		return "getOperand miss should emit nothing"
	}
	return ""
}

// spillAndReset always stores a result back to its spill slot; on a
// straight-line (non-branch, non-returning-BL) instruction it RETAINS the
// value cache so a later use reads the register instead of reloading.
func TestSpillAndResetStoresAndRetains() testing.TestResult {
	var a @asm.Assembler = regMapMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	m.AssignReg(3, x64.R10)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_ADD // straight-line op: cache is retained
	ins.Typ = types.TypInt()
	spillAndReset(a, m, ins, false)
	if a.Sections[0].Len == 0 {
		return "spillAndReset should emit a MOV to the spill slot"
	}
	if m.LookupReg(3) != x64.R10 {
		return "spillAndReset should retain the value cache after a straight-line op"
	}
	return ""
}

// spillAndReset drops the whole cache after an instruction that emitted a
// branch (branchEmitted) — a caller-saved pool register may have been
// clobbered on the skipped inline path.
func TestSpillAndResetClearsOnBranch() testing.TestResult {
	var a @asm.Assembler = regMapMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.AssignReg(3, x64.R10)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	spillAndReset(a, m, ins, true)
	if m.LookupReg(3) >= 0 {
		return "spillAndReset should clear the cache when branchEmitted"
	}
	return ""
}

// Void instructions (no result, no spill slot) emit nothing from
// spillAndReset's store side; a straight-line void op retains the cache.
func TestSpillAndResetVoidIsNoEmit() testing.TestResult {
	var a @asm.Assembler = regMapMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.AssignReg(0, x64.R10) // a cache entry that must survive a straight-line op
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1 // void marker
	ins.Op = iropcode.OP_STORE // straight-line op: cache retained
	spillAndReset(a, m, ins, false)
	if a.Sections[0].Len != 0 {
		return "void instr spillAndReset should not emit"
	}
	if m.LookupReg(0) != x64.R10 {
		return "void instr spillAndReset should retain the cache on a straight-line op"
	}
	return ""
}
