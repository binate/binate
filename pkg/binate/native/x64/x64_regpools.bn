package "pkg/binate/native/x64"

import "pkg/binate/asm/x64"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"

// Register pools handed to the linear-scan allocator: the GP pass's descriptor
// (x64GpClassDesc) with its caller-saved homes, and the FP pass's pools
// (AllocateFpRegisters).  The callee-saved GP pool lives in x64_emit_func.bn.

// x64CallerSavedHomePool returns the caller-saved GP registers a value not live
// across any call may be homed in: RCX, RDX, RSI, RDI, R8 and R9, plus RAX when
// raxHome is set (Options.RaxHome).  RSI, RDI, R8 and R9 are outside the scratch
// pool (R10, R11, RCX, RDX) and no non-call op writes them; all four are argument
// registers, placed at calls by x64_call_homes.bn.  RCX and RDX are also scratch
// registers, and RAX has fixed uses (return value, DIV/IDIV and one-operand
// multiplies, make/box results, float-convert scratch, call shuttles and the
// parallel-move cycle temp): an instruction whose lowering uses any of the three
// declares so (x64RegClobbers, in either mode), which keeps every value live at
// it out of them — calls and returns among them, so an operand homed there never
// needs placing.  The scan takes the last free register first, so RAX (when
// present), RCX and RDX lead the pool and are filled last, and a function with
// few values keeps them as plain scratch.
func x64CallerSavedHomePool(raxHome bool) @[]int {
	var n int = 6
	if raxHome {
		n = 7
	}
	var p @[]int = make_slice(int, n)
	var i int = 0
	if raxHome {
		p[0] = x64.RAX
		i = 1
	}
	p[i] = x64.RCX
	p[i + 1] = x64.RDX
	p[i + 2] = x64.RSI
	p[i + 3] = x64.RDI
	p[i + 4] = x64.R8
	p[i + 5] = x64.R9
	return p
}

// x64GpClassDesc returns the GP register class the allocator homes scalar SSA
// values in under opts: the callee-saved RBX/R12..R15, the caller-saved homes of
// x64CallerSavedHomePool (RAX among them only under opts.RaxHome), the tie
// opcodes and the per-instruction register declarations (x64RegClobbers).
func x64GpClassDesc(opts Options) common.RegClassDesc {
	var d common.RegClassDesc
	d.CalleeSaved = x64AllocatablePool()
	d.CallerSaved = x64CallerSavedHomePool(opts.RaxHome)
	d.TieOps = x64TieOps()
	d.RegClobbers = x64RegClobbers
	return d
}

// x64FpAllocatablePool returns the callee-saved XMM pool: EMPTY.  SysV-AMD64 has
// no callee-saved XMM registers (XMM0..XMM15 are all caller-saved / volatile),
// so a call-spanning float value cannot take a home — it spills to its slot, as
// today — and no FP save area is needed in the prologue/epilogue.
func x64FpAllocatablePool() @[]int {
	return make_slice(int, 0)
}

// x64FpCallerSavedPool returns the caller-saved XMM pool for NON-call-spanning
// float homes: XMM8..XMM13.  The arg/return registers XMM0..XMM7 are deliberately
// excluded (kept as pure arg/scratch, so a home never collides with an arriving
// or outgoing float arg register — call-arg/return marshalling round-trips
// through the getOperand GP bridge, no parallel move), and XMM14/XMM15 stay as
// the inline FP scratch (x64_float.bn's FP_SCRATCH_A/B).
func x64FpCallerSavedPool() @[]int {
	var p @[]int = make_slice(int, 6)
	for i := 0; i < 6; i++ {
		p[i] = x64.XMM8 + i
	}
	return p
}

// x64TieOps returns the opcodes whose GP lowering reads every operand before it
// writes the result, so the allocator may give the result the register of an
// operand that dies there (RegClassDesc.TieOps): OP_COPY (a single move), and
// integer ADD/SUB/AND/OR/XOR/SHL/SHR.  Their immediate-fold forms read their one
// register operand first; the register form swaps the operands (or, for SUB,
// negates rd and adds lhs) when rd is rhs's home, and a register shift count
// moves to CL before rd is written (emitBinop).
func x64TieOps() @[]int {
	var ops @[]int = make_slice(int, 8)
	ops[0] = iropcode.OP_COPY
	ops[1] = iropcode.OP_ADD
	ops[2] = iropcode.OP_SUB
	ops[3] = iropcode.OP_AND
	ops[4] = iropcode.OP_OR
	ops[5] = iropcode.OP_XOR
	ops[6] = iropcode.OP_SHL
	ops[7] = iropcode.OP_SHR
	return ops
}

// x64FpTieOps returns the FP pass's tie opcodes: OP_COPY only, whose float form
// reads the source through the GP bridge before it writes the XMM home.
func x64FpTieOps() @[]int {
	var ops @[]int = make_slice(int, 1)
	ops[0] = iropcode.OP_COPY
	return ops
}
