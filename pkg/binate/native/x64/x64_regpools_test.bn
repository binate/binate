package "pkg/binate/native/x64"

import "pkg/binate/asm/x64"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// The FP register pools handed to AllocateFpRegisters: callee-saved EMPTY (SysV
// has no callee-saved XMM) and caller-saved XMM8..XMM13 (the arg/return regs
// XMM0..XMM7 and the FP scratches XMM14/XMM15 are excluded).
func TestFpRegisterPools() testing.TestResult {
	var callee @[]int = x64FpAllocatablePool()
	if len(callee) != 0 {
		return "x64 FP callee pool must be empty (SysV has no callee-saved XMM)"
	}
	var caller @[]int = x64FpCallerSavedPool()
	if len(caller) != 6 { return "x64 FP caller pool must be XMM8..XMM13 (6 regs)" }
	if caller[0] != x64.XMM8 || caller[5] != x64.XMM13 {
		return "x64 FP caller pool must span XMM8..XMM13"
	}
	// XMM0..XMM7 (args) and XMM14/XMM15 (scratch) must be excluded.
	for i := 0; i < len(caller); i++ {
		if caller[i] < x64.XMM8 || caller[i] > x64.XMM13 {
			return "x64 FP caller pool must exclude XMM0..7 (args) and XMM14/15 (scratch)"
		}
	}
	return ""
}

// The caller-saved GP homes are exactly RCX, RDX, RSI, RDI, R8 and R9, RCX and
// RDX first so the scan (last free first) fills them last.  Of these only RCX and
// RDX are scratch-pool registers (guarded by x64RegClobbers); R10 and R11, the
// scratch every instruction may use, are never homes.
func TestX64CallerSavedHomePool() testing.TestResult {
	var p @[]int = x64CallerSavedHomePool()
	if len(p) != 6 || p[0] != x64.RCX || p[1] != x64.RDX || p[2] != x64.RSI || p[3] != x64.RDI ||
			p[4] != x64.R8 || p[5] != x64.R9 {
		return "caller-saved homes should be RCX, RDX, RSI, RDI, R8, R9"
	}
	for i := 0; i < len(p); i++ {
		if p[i] == x64.R10 || p[i] == x64.R11 { return "R10 and R11 must never be homes" }
	}
	return ""
}

// The tie opcodes are exactly the audited ones: OP_COPY and integer
// ADD/SUB/AND/OR/XOR/SHL/SHR.  MUL, DIV and REM stay out.
func TestTieOps() testing.TestResult {
	var ops @[]int = x64TieOps()
	if len(ops) != 8 { return "the tie opcodes should be COPY and seven integer ops" }
	var want @[]int = make_slice(int, 8)
	want[0] = iropcode.OP_COPY
	want[1] = iropcode.OP_ADD
	want[2] = iropcode.OP_SUB
	want[3] = iropcode.OP_AND
	want[4] = iropcode.OP_OR
	want[5] = iropcode.OP_XOR
	want[6] = iropcode.OP_SHL
	want[7] = iropcode.OP_SHR
	for i := 0; i < 8; i++ {
		if ops[i] != want[i] { return "unexpected tie opcode" }
		if ops[i] == iropcode.OP_MUL || ops[i] == iropcode.OP_DIV || ops[i] == iropcode.OP_REM {
			return "MUL/DIV/REM must not tie"
		}
	}
	return ""
}

// The FP pass ties only copies.
func TestFpTieOps() testing.TestResult {
	var ops @[]int = x64FpTieOps()
	if len(ops) != 1 || ops[0] != iropcode.OP_COPY { return "the FP pass should tie only OP_COPY" }
	return ""
}
