package "pkg/binate/native/x64"

import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/builtins/testing"

// Tests for nextRegReusing and claimCachedOperands (x64_regmap.bn).

// rrMap returns a RegMap whose ids 1 and 2 have spill slots (0 and 8), with an
// assembler stamped as CurAsm for eviction stores.
func rrMap() @common.RegMap {
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.CurAsm = opsMkAssembler()
	return m
}

// rrLive returns an id-indexed set (ids 0..3) with only id set when id >= 0.
func rrLive(id int) @[]bool {
	var s @[]bool = make_slice(bool, 4)
	if id >= 0 { s[id] = true }
	return s
}

// A clean operand cached in a pool register is taken over: the result gets R10
// and the operand's cache entry is gone, with no store.
func TestNextRegReusingTakesOverReload() testing.TestResult {
	var m @common.RegMap = rrMap()
	_ = m.AssignReg(1, x64.R10)
	m.MarkUsed(x64.R10)
	var rd int = nextRegReusing(m, 2, x64.R10, 1)
	if rd != x64.R10 { return "the result must take over the operand's register" }
	if m.RegHeldBy(x64.R10) != 2 { return "R10 must now hold the result" }
	if m.CurAsm.Sections[0].Len != 0 { return "a clean operand needs no store" }
	return ""
}

// A homed operand's register is never taken over: the result gets a fresh
// scratch register instead.
func TestNextRegReusingKeepsHome() testing.TestResult {
	var m @common.RegMap = rrMap()
	m.HomeIDs = common.AppendInt(m.HomeIDs, 1)
	m.HomeRegs = common.AppendInt(m.HomeRegs, x64.RCX)
	var rd int = nextRegReusing(m, 2, x64.RCX, 1)
	if rd == x64.RCX { return "a home must never be taken over" }
	return ""
}

// A dirty operand whose last use is this instruction is dropped unstored; one
// still live afterwards is stored to its slot before its register is taken.
func TestNextRegReusingDirtyOperand() testing.TestResult {
	var m @common.RegMap = rrMap()
	m.CurLive = rrLive(1)
	_ = m.AssignReg(1, x64.R10)
	m.MarkUsed(x64.R10)
	m.MarkDirty(1)
	curLiveAfter = rrLive(-1)
	_ = nextRegReusing(m, 2, x64.R10, 1)
	var deadLen int = m.CurAsm.Sections[0].Len
	var deadDirty bool = m.IsDirty(1)
	var m2 @common.RegMap = rrMap()
	m2.CurLive = rrLive(1)
	_ = m2.AssignReg(1, x64.R10)
	m2.MarkUsed(x64.R10)
	m2.MarkDirty(1)
	curLiveAfter = rrLive(1)
	_ = nextRegReusing(m2, 2, x64.R10, 1)
	var noLive @[]bool
	curLiveAfter = noLive
	if deadLen != 0 || deadDirty {
		return "a dirty operand dead after the instruction must be dropped unstored"
	}
	if m2.CurAsm.Sections[0].Len == 0 {
		return "a dirty operand live after the instruction must be stored"
	}
	return ""
}

// claimCachedOperands marks used the pool register holding an operand, so a
// later scratch allocation cannot evict it.
func TestClaimCachedOperands() testing.TestResult {
	var m @common.RegMap = rrMap()
	_ = m.AssignReg(1, x64.R11)
	var op @ir.Instr = make(ir.Instr)
	op.ID = 1
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = iropcode.OP_STORE
	ins.ID = -1
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = op
	claimCachedOperands(m, ins)
	if !m.IsUsed(x64.R11) { return "the operand's register must be claimed" }
	// R10 goes first either way; the next allocation must skip R11.
	_ = allocReg(m)
	var r int = allocReg(m)
	if r == x64.R11 { return "a claimed operand register must not be handed out" }
	return ""
}
