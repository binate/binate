package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// OP_RETURN lowering
// ============================================================
//
// SysV-AMD64 return conventions, picked here in priority order:
//   - void return (no args): just the epilogue.
//   - sret (rm.SretSlotOff >= 0): callee writes the result through
//     the hidden RDI buffer (stashed by emitFunc at SretSlotOff),
//     then returns the buffer pointer in RAX per SysV.  Covers both
//     single aggregate > 16 bytes and multi-return tuple > 16 bytes.
//   - multi-return tuple ≤ 16 bytes: pack RAX (first word) + RDX
//     (second word).
//   - single aggregate ≤ 16 bytes: pack RAX (+ RDX) from the data
//     region pointer.
//   - single scalar float: bits return in XMM0 (MOVQ XMM0, gp).
//   - single scalar non-float: value returns in RAX (MOV RAX, gp).
//
// Split out of x64_dispatch.bn so emitInstr's already-long dispatch
// table doesn't grow further with return-shape handlers.  Helpers
// (emitSretReturn / emitMultiReturnPack / emitAggregateReturnPack)
// only have one caller (emitReturn), so they sit beside it here.

// emitReturn dispatches OP_RETURN to the correct shape-handler then
// emits the epilogue + RET.  Every path below ends in an
// emitEpilogueAndRet call (handled outside any helper because the
// epilogue is shared across all shapes).
func emitReturn(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	// Sret-returning function: callee writes the result through
	// the hidden RDI buffer (stashed by emitFunc at SretSlotOff),
	// then returns the buffer pointer in RAX per SysV.
	if rm.SretSlotOff >= 0 {
		emitSretReturn(a, pkgName, rm, ins)
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	// Multi-return tuple ≤ 16 bytes: pack RAX/RDX.
	if rm.MultiReturnType != nil && len(ins.Args) > 1 {
		emitMultiReturnPack(a, pkgName, rm, ins)
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	// Single SSE aggregate ≤ 16 bytes: pack each eightbyte by SysV class —
	// SSE -> XMM0/XMM1, INTEGER -> RAX/RDX (matches the LLVM-side coercion).
	// Dormant until the x64 SSE gate flips (ReturnsSseInRegs false); before it,
	// the GP pack below handles the aggregate.
	if len(ins.Args) == 1 && rm.CC.ReturnsSseInRegs(ins.Args[0].Typ) {
		emitSseAggregateReturnPack(a, rm, ins)
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	// Single aggregate ≤ 16 bytes: pack RAX (+ RDX).
	if len(ins.Args) == 1 && common.IsAggregateTyp(ins.Args[0].Typ) {
		emitAggregateReturnPack(a, rm, ins)
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	// Scalar / void.  Float scalars return in XMM0 per SysV-AMD64;
	// every other scalar returns in RAX.  emitValOperand so a returned
	// global address (`return &G`) is materialized — bare getOperand
	// misses the IsGlobalRef pseudo (ID -1) and leaves RAX unset.
	if len(ins.Args) == 1 && !common.IsAggregateTyp(ins.Args[0].Typ) {
		var src int = emitValOperand(a, pkgName, rm, ins.Args[0])
		if src >= 0 {
			if common.IsFloatScalarTyp(ins.Args[0].Typ) {
				x64.Movq_gp_to_xmm(a, x64.XMM0, src)
			} else if src != x64.RAX {
				x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Reg(src, x64.SZ64))
			}
		}
	}
	emitEpilogueAndRet(a, rm.FrameSize())
}

// emitSretReturn copies the local result into the caller's sret
// buffer and loads RAX with the buffer pointer.  Single aggregate:
// memcpy the data region into the buffer.  Multi-return tuple:
// per-field write at FieldOffset.
func emitSretReturn(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap, ins @ir.Instr) {
	// Load the saved sret-buffer pointer into a scratch reg.
	var dstPtr int = scratchReg(rm)
	x64.Mov(a, x64.Reg(dstPtr, x64.SZ64), x64.Mem(x64.RSP, rm.SretSlotOff, x64.SZ64))

	if len(ins.Args) == 1 && common.IsAggregateTyp(ins.Args[0].Typ) {
		// Single aggregate: memcpy via qword-MOV loop from the
		// argument's pointer to the destination buffer.
		var srcPtr int = getOperand(a, rm, ins.Args[0].ID)
		if srcPtr >= 0 {
			var sz int = ins.Args[0].Typ.SizeOf()
			var tmp int = scratchReg(rm)
			for off := 0; off < sz; off = off + 8 {
				x64.Mov(a, x64.Reg(tmp, x64.SZ64), x64.Mem(srcPtr, off, x64.SZ64))
				x64.Mov(a, x64.Mem(dstPtr, off, x64.SZ64), x64.Reg(tmp, x64.SZ64))
			}
		}
	} else if rm.MultiReturnType != nil {
		// Multi-return: write each scalar field through the buffer.
		// Reload dstPtr each iteration in case the per-arg
		// ResetRegs strands it; matches arm64's pattern.
		for ai := 0; ai < len(ins.Args); ai++ {
			var arg @ir.Instr = ins.Args[ai]
			var fldOff int = rm.MultiReturnType.FieldOffset(ai)
			if common.IsAggregateTyp(arg.Typ) {
				// Aggregate field: memcpy.
				var ptr int = getOperand(a, rm, arg.ID)
				if ptr >= 0 {
					var sz int = arg.Typ.SizeOf()
					var tmp int = scratchReg(rm)
					for off := 0; off < sz; off = off + 8 {
						x64.Mov(a, x64.Reg(tmp, x64.SZ64), x64.Mem(ptr, off, x64.SZ64))
						x64.Mov(a, x64.Mem(dstPtr, fldOff + off, x64.SZ64), x64.Reg(tmp, x64.SZ64))
					}
				}
			} else {
				var src int = emitValOperand(a, pkgName, rm, arg)
				if src >= 0 {
					var sz int = 8
					if arg.Typ != nil { sz = arg.Typ.SizeOf() }
					if sz <= 0 { sz = 8 }
					emitScalarStore(a, src, dstPtr, fldOff, sz)
				}
			}
			rm.ResetRegs()
			// Reload dstPtr if we still have more args.
			if ai + 1 < len(ins.Args) {
				dstPtr = scratchReg(rm)
				x64.Mov(a, x64.Reg(dstPtr, x64.SZ64), x64.Mem(x64.RSP, rm.SretSlotOff, x64.SZ64))
			}
		}
	}

	// SysV requires sret-returning funcs to return the buffer
	// pointer in RAX.  Reload it.
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(x64.RSP, rm.SretSlotOff, x64.SZ64))
}

// emitMultiReturnPack packs an in-register multi-return tuple (the
// register-count sret threshold routed the > 3-GP / > 4-FP cases to sret).
// It matches LLVM's x86-64 first-class-struct return lowering, which is
// FIELD-PER-REGISTER with NO eightbyte coalescing: a non-float field's words
// fill RAX,RDX,RCX; the 1st/2nd float-scalar field fills XMM0,XMM1 and the
// 3rd/4th overflows to x87 ST0,ST1, each class counter independent.
// (u16,u16,u16) → AX,DX,CX; (float32,float32) → XMM0,XMM1; (float32,int32) →
// XMM0,EAX; (f64,f64,f64) → XMM0,XMM1,ST0 — NOT coalesced into one register.
// Materialize the tuple's byte
// image in the SysV red zone (leaf scratch the epilogue never touches), laying
// each field at its MultiReturnType offset, then load each field into its
// class register from that offset.  The image avoids the clobber a direct
// field→register write would hit (emitValOperand for a later field may reuse
// RAX/RDX/RCX as scratch).  Symmetric mirror of collectMultiReturnTuple; the
// per-eightbyte-coalescing predecessor disagreed with LLVM for every sub-8-byte
// field crossing the native↔LLVM boundary (claude-todo #112).
func emitMultiReturnPack(a @asm.Assembler, pkgName *[]readonly char, rm @common.RegMap,
		ins @ir.Instr) {
	if rm.MultiReturnType == nil { return }
	// Lay the image in the SysV red zone ([RSP-128, RSP) leaf scratch the
	// epilogue never touches), low end far enough below RSP to hold the whole
	// tuple: the register-count sret threshold caps an in-register multi-return
	// at 3 GP + 4 FP regs (XMM0,XMM1 + x87 ST0,ST1 — up to 56 bytes), so a
	// 16-byte base no longer suffices.
	var imgSz int = rm.MultiReturnType.SizeOf()
	var imgBytes int = (imgSz + 15) / 16 * 16
	if imgBytes < 16 { imgBytes = 16 }
	var base int = 0 - imgBytes
	// Build the full tuple byte image in the red zone — EVERY field
	// (integer, aggregate, and float) at its MultiReturnType offset.  Writing
	// through the image first (rather than straight to return registers)
	// decouples value materialization from register placement, so a later
	// field's emitValOperand reusing RAX/RDX/RCX as scratch can't clobber an
	// already-placed field.  The image is loaded into class registers
	// field-per-register below.
	for fi := 0; fi < len(ins.Args); fi++ {
		var src int = emitValOperand(a, pkgName, rm, ins.Args[fi])
		if src < 0 {
			rm.ResetRegs()
			continue
		}
		var fldOff int = rm.MultiReturnType.FieldOffset(fi)
		if common.IsAggregateTyp(ins.Args[fi].Typ) {
			// Aggregate component: src is a pointer to its bytes — copy
			// them into the image (8-byte chunks) so RAX/RDX carry the
			// bytes, not the pointer (the managed-struct multi-assign
			// miscompile).
			var fldSz int = ins.Args[fi].Typ.SizeOf()
			var tmp int = scratchReg(rm)
			for w := 0; w * 8 < fldSz; w++ {
				x64.Mov(a, x64.Reg(tmp, x64.SZ64), x64.Mem(src, 8 * w, x64.SZ64))
				x64.Mov(a, x64.Mem(x64.RSP, base + fldOff + 8 * w, x64.SZ64), x64.Reg(tmp, x64.SZ64))
			}
		} else {
			var fldSz int = 8
			if ins.Args[fi].Typ != nil {
				fldSz = ins.Args[fi].Typ.SizeOf()
			}
			if fldSz <= 0 { fldSz = 8 }
			emitScalarStore(a, src, x64.RSP, base + fldOff, fldSz)
		}
		rm.ResetRegs()
	}
	// Load the image into return registers FIELD-PER-REGISTER, matching LLVM's
	// x86-64 first-class-struct return lowering (no eightbyte coalescing): a
	// non-float field's words → RAX,RDX,RCX (retGp); a float-scalar field →
	// XMM0,XMM1 then x87 ST0,ST1 (retFp, via a GP scratch / FLD since the image
	// lives in memory); each read from its field offset.  The register-count
	// sret threshold (CallConv.MultiReturnTupleNeedsSret) caps this at 3 GP +
	// 2 XMM + 2 x87 regs, so the guards never silently drop a live field.
	// Symmetric mirror of collectMultiReturnTuple.
	//
	// The 3rd/4th float overflow to x87 ST0/ST1.  FLD is a push (it lands on
	// ST0, demoting the rest), so to leave field N on ST0 and field N+1 on ST1
	// the FLDs must run in REVERSE field order — clang dumps `fldl <field N+1>
	// ; fldl <field N>`.  Record each overflow float's image offset + width
	// during the forward walk, then emit the FLDs below.
	var x87Off0 int = 0
	var x87IsI32_0 bool = false
	var x87Off1 int = 0
	var x87IsI32_1 bool = false
	var nX87 int = 0
	var retGp int = 0
	var retFp int = 0
	for fi := 0; fi < len(ins.Args); fi++ {
		var fldTyp @types.Type = ins.Args[fi].Typ
		var fldOff int = rm.MultiReturnType.FieldOffset(fi)
		if common.IsFloatScalarTyp(fldTyp) {
			if retFp < rm.CC.NumFpRetRegs {
				var tmp int = scratchReg(rm)
				if common.FloatScalarIsI32(fldTyp) {
					x64.Mov(a, x64.Reg(tmp, x64.SZ32), x64.Mem(x64.RSP, base + fldOff, x64.SZ32))
					x64.Movd_gp_to_xmm(a, x64.XMM0 + retFp, tmp)
				} else {
					x64.Mov(a, x64.Reg(tmp, x64.SZ64), x64.Mem(x64.RSP, base + fldOff, x64.SZ64))
					x64.Movq_gp_to_xmm(a, x64.XMM0 + retFp, tmp)
				}
			} else {
				// x87 overflow slot k (0 → ST0, 1 → ST1).
				var k int = retFp - rm.CC.NumFpRetRegs
				if k == 0 {
					x87Off0 = base + fldOff
					x87IsI32_0 = common.FloatScalarIsI32(fldTyp)
				} else {
					x87Off1 = base + fldOff
					x87IsI32_1 = common.FloatScalarIsI32(fldTyp)
				}
				if k + 1 > nX87 { nX87 = k + 1 }
			}
			retFp = retFp + 1
		} else if common.IsAggregateTyp(fldTyp) {
			var fldSz int = fldTyp.SizeOf()
			for w := 0; w * 8 < fldSz && retGp < 3; w++ {
				x64.Mov(a, x64.Reg(retGpReg(retGp), x64.SZ64),
						x64.Mem(x64.RSP, base + fldOff + 8 * w, x64.SZ64))
				retGp = retGp + 1
			}
		} else {
			if retGp < 3 {
				var fldSz int = fldTyp.SizeOf()
				if fldSz <= 0 { fldSz = 8 }
				emitScalarLoad(a, retGpReg(retGp), x64.RSP, base + fldOff, fldSz, false)
				retGp = retGp + 1
			}
		}
	}
	// Push the overflow floats onto the x87 stack in reverse field order
	// (field N+1 first, so field N ends on ST0).  See the note above.
	if nX87 >= 2 { emitX87Push(a, x87Off1, x87IsI32_1) }
	if nX87 >= 1 { emitX87Push(a, x87Off0, x87IsI32_0) }
}

// emitX87Push pushes one float from the red-zone tuple image (at RSP+off)
// onto the x87 stack (ST0), FLDS for a 32-bit float, FLDL for a 64-bit one.
func emitX87Push(a @asm.Assembler, off int, isI32 bool) {
	if isI32 {
		x64.Flds(a, x64.Mem(x64.RSP, off, x64.SZ32))
	} else {
		x64.Fldl(a, x64.Mem(x64.RSP, off, x64.SZ64))
	}
}

// emitSseAggregateReturnPack handles a single SSE aggregate return (<=16 bytes,
// ReturnsSseInRegs): walk its eightbytes from the result's data image and place
// each per SysV class — an SSE eightbyte into the next FP return reg (XMM0 then
// XMM1) via MOVLPS (8-byte: 2xf32 / f64) or MOVSS (4-byte lone f32), an INTEGER
// eightbyte into the next GP return reg (RAX then RDX).  The two return files
// advance independently, so `{double,i64}` -> XMM0+RAX and `{i64,double}` ->
// RAX+XMM0, matching the LLVM-side `{ .. }` aggregate return.  Dormant until the
// x64 SSE gate flips.
func emitSseAggregateReturnPack(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	var src int = getOperand(a, rm, ins.Args[0].ID)
	if src < 0 { return }
	var t @types.Type = ins.Args[0].Typ
	var cl @[]int = types.SysVClassify(t)
	var nsse int = 0
	var ngp int = 0
	for eb := 0; eb < len(cl); eb++ {
		var off int = 8 * eb
		if cl[eb] == types.EB_SSE {
			if types.SysVEightbyteForm(t, eb) == types.SEB_FLOAT {
				x64.Movss_load(a, x64.XMM0 + nsse, x64.Mem(src, off, x64.SZ32))
			} else {
				x64.Movlps_load(a, x64.XMM0 + nsse, x64.Mem(src, off, x64.SZ64))
			}
			nsse = nsse + 1
		} else {
			var gp int = x64.RAX
			if ngp == 1 { gp = x64.RDX }
			x64.Mov(a, x64.Reg(gp, x64.SZ64), x64.Mem(src, off, x64.SZ64))
			ngp = ngp + 1
		}
	}
	return
}

// emitAggregateReturnPack handles single-aggregate returns ≤ 16
// bytes: pack RAX (first 8 bytes) + RDX (second 8 bytes).
// Aggregates larger than 16 bytes go through emitSretReturn (the
// SretSlotOff branch in emitReturn).
func emitAggregateReturnPack(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	var src int = getOperand(a, rm, ins.Args[0].ID)
	if src < 0 { return }
	var sz int = ins.Args[0].Typ.SizeOf()
	if sz > 0 {
		x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(src, 0, x64.SZ64))
	}
	if sz > 8 {
		x64.Mov(a, x64.Reg(x64.RDX, x64.SZ64), x64.Mem(src, 8, x64.SZ64))
	}
}
