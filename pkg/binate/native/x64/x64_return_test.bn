package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// returnMkAsm: minimal assembler for OP_RETURN tests.
func returnMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// SretSlotOff >= 0 routes through emitSretReturn — a memcpy of the
// aggregate's data region into the caller's hidden RDI buffer
// (reloaded from SP+SretSlotOff), then RAX = buffer pointer per
// SysV.  Pin that the emitted bytes end with `ret` (0xC3) — the
// epilogue + ret follows the sret-write sequence.
func TestEmitReturnSretAggregateLoadsBufferAndRet() testing.TestResult {
	var a @asm.Assembler = returnMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SretSlotOff = 0  // simulate PlanFrame's sret-active state
	m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 8)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 24)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 32)
	// Return arg: 24-byte aggregate.
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var bigStruct @types.Type = types.MakeStructType("Big", fields)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = bigStruct
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_RETURN
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	var n int = a.Sections[0].Len
	if n == 0 {
		return "sret return should emit instructions"
	}
	// Trailing byte is `ret` (0xC3).
	if a.Sections[0].Data[n - 1] != cast(uint8, 0xC3) {
		return "sret return should end with `ret` (0xC3)"
	}
	return ""
}

// Single aggregate return ≤ 16 bytes packs RAX (+RDX) from the
// source pointer's data.  Pin a MOV-r,r/m (0x8B) appears — the
// read-into-RAX of the first 8 bytes.
func TestEmitReturnAggregateLE16PacksRaxRdx() testing.TestResult {
	var a @asm.Assembler = returnMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// 16-byte raw slice = exactly 2 words; not sret (≤ 16).
	var sliceTyp @types.Type = types.MakeSliceType(types.TypInt())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = sliceTyp
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_RETURN
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	var data *[]uint8 = a.Sections[0].Data
	var foundMov bool = false
	for i := 0; i < a.Sections[0].Len; i++ {
		if data[i] == cast(uint8, 0x8B) { foundMov = true }
	}
	if !foundMov {
		return "≤ 16-byte aggregate return should emit MOV r,r/m to pack RAX"
	}
	return ""
}

// Multi-return ≤ 16 bytes: the tuple's byte image is materialized in
// the SysV red zone (one store per field, at the field's offset) and
// then loaded into RAX (+ RDX when > 8 bytes), so sub-word fields are
// coalesced into the eightbyte holding their offset.  Pin both a store
// (0x89, MOV r/m,r — building the image) and a load (0x8B, MOV r,r/m —
// RAX/RDX from the image); the previous per-field reg-reg pack capped
// at two fields and emitted no image load.
func TestEmitReturnMultiReturnLE16PacksRaxRdx() testing.TestResult {
	var a @asm.Assembler = returnMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// (int, int) tuple = 16 bytes = ≤ 16 — packs RAX/RDX.
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	m.MultiReturnType = tuple
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var arg0 @ir.Instr = make(ir.Instr)
	arg0.ID = 1
	arg0.Typ = types.TypInt()
	var arg1 @ir.Instr = make(ir.Instr)
	arg1.ID = 2
	arg1.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_RETURN
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = arg0
	ins.Args[1] = arg1
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	var data *[]uint8 = a.Sections[0].Data
	var foundStore bool = false
	var foundLoad bool = false
	for i := 0; i < a.Sections[0].Len; i++ {
		// 0x89 = MOV r/m,r — a field store into the red-zone image.
		if data[i] == cast(uint8, 0x89) { foundStore = true }
		// 0x8b = MOV r,r/m — RAX/RDX loaded back from the image.
		if data[i] == cast(uint8, 0x8b) { foundLoad = true }
	}
	if !foundStore {
		return "≤16 multi-return should store each field into the image"
	}
	if !foundLoad {
		return "≤16 multi-return should load RAX/RDX from the image"
	}
	return ""
}

// Multi-return with 3 float fields: the register-count threshold now keeps
// it in-register on x64 (2 XMM + 1 x87), so emitReturn routes to
// emitMultiReturnPack, which must push the 3rd float onto the x87 stack with
// an FLDL (opcode 0xDD) — LLVM returns that field in ST0.  Pins the x87
// overflow-pack path (no FLDL → the 3rd float would be silently dropped).
func TestEmitReturnMultiReturnThreeFloatsUsesX87() testing.TestResult {
	var a @asm.Assembler = returnMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypFloat64()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	m.MultiReturnType = tuple
	var args @[]@ir.Instr = make_slice(@ir.Instr, 3)
	for i := 0; i < 3; i++ {
		m.SpillIDs = common.AppendInt(m.SpillIDs, i + 1)
		m.SpillOffsets = common.AppendInt(m.SpillOffsets, i * 8)
		args[i] = make(ir.Instr)
		args[i].ID = i + 1
		args[i].Typ = types.TypFloat64()
	}
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_RETURN
	ins.Args = args
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	var data *[]uint8 = a.Sections[0].Data
	var foundFldl bool = false
	for i := 0; i < a.Sections[0].Len; i++ {
		if data[i] == cast(uint8, 0xDD) { foundFldl = true }
	}
	if !foundFldl {
		return "3-float multi-return should FLDL (0xDD) the 3rd float onto x87"
	}
	return ""
}
