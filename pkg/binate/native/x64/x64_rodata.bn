package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Rodata-slice / -array ops — emit_string_to_chars + composites
// ============================================================
//
// OP_RODATA_SLICE / OP_RODATA_MSLICE return a pointer to the string's static
// managed-slice header (`stringMSSym`, emitted once by emitStringTable) — no
// allocation, no copy, no per-use header construction.  See
// emitRodataMSliceOrSlice below.
//
// OP_RODATA_MSLICE_COPY allocates a fresh managed-slice (runtime
// MakeManagedSlice) and memcpys the string bytes in — used when the
// destination is mutable.  OP_RODATA_ARRAY initialises a fixed-size
// stack buffer ([N]uint8) from a string literal.
//
// Mirrors arm64's emit_*Rodata / emitStringToCharsCopy /
// emitStringToArray.  Stays under amd64_emit.bn's soft cap since
// it doesn't introduce any new emit primitives — just RIP-relative
// LEA + the existing runtime-call shape from amd64_managed.bn.

// emitRodataMSliceOrSlice (OP_RODATA_MSLICE / OP_RODATA_SLICE): the result is a
// pointer to the string's static managed-slice header `stringMSSym` — the
// 4-word { data, len, null refptr, backing_len=len } header emitted once by
// emitStringTable (via ir.BuildStringMSHeader).  A managed-slice consumer reads
// all 4 words; a raw-slice consumer reads the {data, len} prefix.  No per-use
// stack construction — the header is immortal static data, so sharing one
// across uses is safe (matches the LLVM backend, which loads the same static
// `@.str.<id>.ms`).  The `.ms` is a weak data symbol, so reaching it from text
// goes through SetGlobal + RIP-relative LEA (the emitGlobalAddr / iface-vtable
// pattern).
func emitRodataMSliceOrSlice(a @asm.Assembler, rm @common.RegMap, pkgName *[]readonly char,
		strings @[]ir.StringConst, ins @ir.Instr) {
	var sid int = ir.FindStringID(strings, ins.StrVal)
	if sid < 0 { return }
	var ms @[]char = stringMSSym(pkgName, sid)
	a.SetGlobal(ms)
	var rd int = nextReg(rm, ins.ID)
	x64.LeaRipLabel(a, x64.Reg(rd, x64.SZ64), ms)
}

// emitStringToCharsCopy: OP_RODATA_MSLICE_COPY — `var s @[]char =
// "..."` allocates a fresh managed-slice header + backing buffer
// (runtime MakeManagedSlice), then writes the literal bytes inline
// into the buffer.  Result is a pointer to the data region holding
// the 4-word header.  SysV-AMD64 MakeManagedSlice returns the
// 32-byte header via the hidden sret-buffer pointer
// (InternalSretBytes=16), so we pass &dataOff as RDI and the
// runtime writes directly into our region.
//
// Inline byte stores instead of a libc.Memcpy call keeps the
// generated machine code free of any libc memory primitive — see
// explorations/plan-codegen-c-free-copies.md step 6.
func emitStringToCharsCopy(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr, bytes @[]char) {
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	var strLen int = len(bytes)

	// MakeManagedSlice(elemSize = 1, len = strLen) — sret buffer = our
	// data region.  RDI = &dataOff, RSI = 1, RDX = strLen.
	x64.Lea(a, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSP, dataOff, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.RSI, x64.SZ64), x64.Imm(1))
	x64.Mov(a, x64.Reg(x64.RDX, x64.SZ64), x64.Imm(strLen))
	var mkSym @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "MakeManagedSlice"))
	a.SetGlobal(mkSym)
	x64.Call(a, mkSym)
	rm.ResetRegs()

	// dst pointer is the first eightbyte of the header the runtime
	// just wrote — reload it from [rsp + dataOff], then write the
	// literal bytes one-at-a-time at offsets [dst, dst+1, ...].
	x64.Mov(a, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSP, dataOff, x64.SZ64))
	emitInlineByteStoresX64(a, x64.RDI, bytes, strLen)
	rm.ResetRegs()

	var rd int = nextReg(rm, ins.ID)
	x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.Mem(x64.RSP, dataOff, x64.SZ64))
}

// emitStringToArray: OP_RODATA_ARRAY — `var s [N]char = "..."`
// allocates a fresh N-byte buffer in the data region, zeroes it,
// then memcpys the first strLen bytes from rodata into the head.
// strLen is enforced ≤ N at IR-gen time.  Result is a pointer to
// the buffer; downstream OP_STORE-struct-copy memcpys it into the
// destination alloca.
func emitStringToArray(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	var bytes @[]char = ins.StrVal
	var dataOff int = rm.LookupAlloc(ins.ID)
	if dataOff < 0 { return }
	var arrLen int = 0
	var arrTyp @types.Type = common.UnwrapNamed(ins.Typ)
	if arrTyp != nil && arrTyp.Kind == types.TYP_ARRAY {
		arrLen = arrTyp.ArrayLen
	}
	if arrLen <= 0 { return }
	var strLen int = len(bytes)
	if strLen > arrLen { strLen = arrLen }

	// Zero-fill the reserved buffer (rounded up to 8 bytes by
	// PlanFrame) in 64-bit chunks — covers the tail past strLen and
	// keeps any padding bytes deterministic.
	var bufSz int = rm.LookupAllocSize(ins.ID)
	for i := 0; i < bufSz; i = i + 8 {
		x64.Mov(a, x64.Mem(x64.RSP, dataOff + i, x64.SZ64), x64.Imm(0))
	}
	if strLen > 0 {
		x64.Lea(a, x64.Reg(x64.RDI, x64.SZ64), x64.Mem(x64.RSP, dataOff, x64.SZ64))
		emitInlineByteStoresX64(a, x64.RDI, bytes, strLen)
	}
	var rd int = nextReg(rm, ins.ID)
	x64.Lea(a, x64.Reg(rd, x64.SZ64), x64.Mem(x64.RSP, dataOff, x64.SZ64))
}

// emitInlineByteStoresX64 emits a per-byte store sequence:
//
//   mov BYTE PTR [<base>+0], <byte0>
//   mov BYTE PTR [<base>+1], <byte1>
//   ...
//
// Used by emitStringToCharsCopy / emitStringToArray to write a
// string literal's bytes into the dst buffer inline, instead of
// calling the mangled libc.Memcpy symbol.  SysV-AMD64 lets us emit an
// immediate→memory MOV with a 1-byte (SZ8) memory operand and the
// byte literal as Imm.
func emitInlineByteStoresX64(a @asm.Assembler, base int, data @[]char, count int) {
	for i := 0; i < count; i++ {
		var b int = 0
		if i < len(data) { b = cast(int, data[i]) }
		x64.Mov(a, x64.Mem(base, i, x64.SZ8), x64.Imm(b))
	}
}
