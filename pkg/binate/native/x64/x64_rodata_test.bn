package "pkg/binate/native/x64"

import "pkg/asm"
import "pkg/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// rodataMkAsm: minimal assembler for direct-emit rodata tests.
func rodataMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func rodataBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// emitRodataMSliceOrSlice for OP_RODATA_MSLICE: writes a 32-byte
// managed-slice header at [rsp + dataOff].  Pin: at least one
// RIP-relative LEA (0x48 0x8D 0x05) for the string-label address,
// plus the zero-stores for the refptr / backingLen tail.
func TestEmitRodataMSliceWritesHeader() testing.TestResult {
	var a @asm.Assembler = rodataMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var strings @[]ir.StringConst = make_slice(ir.StringConst, 1)
	var sc ir.StringConst
	sc.ID = 0
	sc.Data = "hi"
	strings[0] = sc
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 9)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 32)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 9)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 32)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = ir.OP_RODATA_MSLICE
	ins.Typ = types.MakeManagedSliceType(types.TypChar())
	ins.StrVal = "hi"
	emitRodataMSliceOrSlice(a, rm, strings, ins)
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundRipLea bool = false
	for i := 0; i < n - 1; i++ {
		// LEA opcode 0x8D followed by a ModRM byte with mod=00 +
		// rm=5 (low 3 bits = 5) → RIP-relative addressing.  The
		// REX prefix varies with destination reg (0x48 / 0x4C),
		// so anchor on the opcode + ModRM pair rather than the REX.
		if data[i] == cast(uint8, 0x8D) &&
				(data[i+1] & cast(uint8, 0xC7)) == cast(uint8, 0x05) {
			foundRipLea = true
		}
	}
	if !foundRipLea {
		return "OP_RODATA_MSLICE should emit a RIP-relative LEA for the string label"
	}
	if n < 32 {
		return "managed-slice header materialisation should be ≥ 8 instructions"
	}
	return ""
}

// emitRodataMSliceOrSlice for OP_RODATA_SLICE (raw slice): only the
// 16-byte {data, len} prefix is written — no refptr/backingLen tail.
// Pin: fewer bytes than the managed case (no extra zero-stores).
func TestEmitRodataRawSliceWritesPrefixOnly() testing.TestResult {
	var a @asm.Assembler = rodataMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var strings @[]ir.StringConst = make_slice(ir.StringConst, 1)
	var sc ir.StringConst
	sc.ID = 0
	sc.Data = "hi"
	strings[0] = sc
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 9)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 9)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = ir.OP_RODATA_SLICE
	ins.Typ = types.MakeSliceType(types.TypChar())
	ins.StrVal = "hi"
	emitRodataMSliceOrSlice(a, rm, strings, ins)
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundRipLea bool = false
	for i := 0; i < n - 1; i++ {
		if data[i] == cast(uint8, 0x8D) &&
				(data[i+1] & cast(uint8, 0xC7)) == cast(uint8, 0x05) {
			foundRipLea = true
		}
	}
	if !foundRipLea {
		return "OP_RODATA_SLICE should emit a RIP-relative LEA for the string label"
	}
	return ""
}

// emitStringToCharsCopy: OP_RODATA_MSLICE_COPY — calls MakeManagedSlice
// then Memcpy.  Pin: at least two 5-byte CALL opcodes (0xE8) and at
// least one RIP-relative LEA (for the string-label src).
func TestEmitStringToCharsCopyEmitsTwoCalls() testing.TestResult {
	var a @asm.Assembler = rodataMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var strings @[]ir.StringConst = make_slice(ir.StringConst, 1)
	var sc ir.StringConst
	sc.ID = 0
	sc.Data = "hi"
	strings[0] = sc
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 9)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 32)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 9)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 32)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = ir.OP_RODATA_MSLICE_COPY
	ins.Typ = types.MakeManagedSliceType(types.TypChar())
	ins.StrVal = "hi"
	emitStringToCharsCopy(a, rm, strings, ins, ins.StrVal)
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var calls int = 0
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xE8) { calls = calls + 1 }
	}
	if calls < 2 {
		return "OP_RODATA_MSLICE_COPY should emit two CALLs (MakeManagedSlice + Memcpy)"
	}
	return ""
}

// emitStringToArray: OP_RODATA_ARRAY — zero-fills the buffer then
// memcpys from rodata.  Pin: exactly one CALL (memcpy) and the
// pre-call MOV-imm-0 zero-fills appear.
func TestEmitStringToArrayZeroFillsAndCopies() testing.TestResult {
	var a @asm.Assembler = rodataMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var strings @[]ir.StringConst = make_slice(ir.StringConst, 1)
	var sc ir.StringConst
	sc.ID = 0
	sc.Data = "abcde"
	strings[0] = sc
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 9)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 9)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = ir.OP_RODATA_ARRAY
	ins.Typ = types.MakeArrayType(types.TypChar(), 5)
	ins.StrVal = "abcde"
	emitStringToArray(a, rm, strings, ins)
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var calls int = 0
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xE8) { calls = calls + 1 }
	}
	if calls != 1 {
		return "OP_RODATA_ARRAY [5]char should emit exactly one CALL (memcpy)"
	}
	return ""
}
