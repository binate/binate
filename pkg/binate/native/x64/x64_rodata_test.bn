package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// rodataMkAsm: minimal assembler for direct-emit rodata tests.
func rodataMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func rodataBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// rodataHasRipLea reports whether the section holds a RIP-relative LEA: opcode
// 0x8D + a ModRM byte with mod=00 / rm=5 (the REX prefix varies with the dest
// reg, so anchor on the opcode + ModRM pair).
func rodataHasRipLea(a @asm.Assembler) bool {
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	for i := 0; i < n - 1; i++ {
		if data[i] == cast(uint8, 0x8D) &&
				(data[i+1] & cast(uint8, 0xC7)) == cast(uint8, 0x05) {
			return true
		}
	}
	return false
}

// rodataHasFixupTo reports whether the section has a fixup targeting `sym`.
func rodataHasFixupTo(a @asm.Assembler, sym *[]readonly char) bool {
	for i := 0; i < a.Sections[0].NumFixups; i++ {
		if charsEqual(a.Sections[0].Fixups[i].Label, sym) { return true }
	}
	return false
}

// emitRodataMSliceOrSlice (OP_RODATA_MSLICE) returns a pointer to the string's
// STATIC managed-slice header (emitted once by emitStringTable) via a SINGLE
// RIP-relative LEA targeting that weak symbol — no per-use stack construction.
func TestEmitRodataMSliceAddressesStaticHeader() testing.TestResult {
	var a @asm.Assembler = rodataMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var strings @[]ir.StringConst = make_slice(ir.StringConst, 1)
	var sc ir.StringConst
	sc.ID = 0
	sc.Data = "hi"
	strings[0] = sc
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 9)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = iropcode.OP_RODATA_MSLICE
	ins.Typ = types.MakeManagedSliceType(types.TypChar())
	ins.StrVal = "hi"
	emitRodataMSliceOrSlice(a, rm, "main", strings, ins)
	if !rodataHasRipLea(a) {
		return "OP_RODATA_MSLICE should RIP-LEA the static .ms address"
	}
	// The LEA targets the static managed-slice header symbol, NOT the byte blob.
	if !rodataHasFixupTo(a, stringMSSym("main", 0)) {
		return "the LEA should target the static managed-slice header symbol"
	}
	// No per-use header construction (the old ≥32-byte stack build is gone).
	if a.Sections[0].Len >= 32 {
		return "expected just an address LEA, not a per-use header construction"
	}
	return ""
}

// emitRodataMSliceOrSlice for OP_RODATA_SLICE (raw slice): the SAME static .ms
// address — a raw-slice consumer just reads the {data, len} prefix.
func TestEmitRodataRawSliceAddressesStaticHeader() testing.TestResult {
	var a @asm.Assembler = rodataMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var strings @[]ir.StringConst = make_slice(ir.StringConst, 1)
	var sc ir.StringConst
	sc.ID = 0
	sc.Data = "hi"
	strings[0] = sc
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 9)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = iropcode.OP_RODATA_SLICE
	ins.Typ = types.MakeSliceType(types.TypChar())
	ins.StrVal = "hi"
	emitRodataMSliceOrSlice(a, rm, "main", strings, ins)
	if !rodataHasRipLea(a) {
		return "OP_RODATA_SLICE should RIP-LEA the static .ms address"
	}
	if !rodataHasFixupTo(a, stringMSSym("main", 0)) {
		return "the raw-slice LEA should also target the static .ms header symbol"
	}
	return ""
}

// emitStringToCharsCopy: OP_RODATA_MSLICE_COPY — calls MakeManagedSlice
// then writes literal bytes inline (step 6 of
// plan-codegen-c-free-copies — no Memcpy call).  Pin: exactly ONE
// CALL opcode (MakeManagedSlice), no second call (no Memcpy).
func TestEmitStringToCharsCopyEmitsSingleCall() testing.TestResult {
	var a @asm.Assembler = rodataMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 9)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 32)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 9)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 32)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = iropcode.OP_RODATA_MSLICE_COPY
	ins.Typ = types.MakeManagedSliceType(types.TypChar())
	ins.StrVal = "hi"
	emitStringToCharsCopy(a, rm, ins, ins.StrVal)
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var calls int = 0
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xE8) { calls = calls + 1 }
	}
	if calls != 1 {
		return "OP_RODATA_MSLICE_COPY should emit exactly one CALL (MakeManagedSlice only)"
	}
	return ""
}

// emitStringToArray: OP_RODATA_ARRAY — zero-fills the buffer then
// writes literal bytes inline (step 6 — no Memcpy call).  Pin:
// ZERO CALLs in the emitted code.
func TestEmitStringToArrayHasNoCall() testing.TestResult {
	var a @asm.Assembler = rodataMkAsm()
	var rm @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 9)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 9)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = iropcode.OP_RODATA_ARRAY
	ins.Typ = types.MakeArrayType(types.TypChar(), 5)
	ins.StrVal = "abcde"
	emitStringToArray(a, rm, ins)
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var calls int = 0
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xE8) { calls = calls + 1 }
	}
	if calls != 0 {
		return "OP_RODATA_ARRAY should emit zero CALLs (inline byte stores, no memcpy)"
	}
	return ""
}
