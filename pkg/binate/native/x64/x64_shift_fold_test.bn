package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the x64 shift-count immediate fold (x64ImmFits and
// emitShiftImmFoldX64 in x64_fold.bn).  Each golden is the full emitBinop
// output for a spilled shifted value: the reload (`mov r10, qword ptr [rsp]`),
// the copy into the result register (`mov r11, r10`, or its 32-bit form), the
// shift-by-imm8, and the sub-word re-narrow when the register path would emit
// one.  The expected bytes are llvm-mc's (x86_64) encodings of that assembly;
// none moves a count into CL.

// x64ShiftFolded builds `x OP v` (the constant as the shifted value when
// constLhs) over type t and reports whether the constant folds.
func x64ShiftFolded(op int, t @types.Type, v int64, constLhs bool) bool {
	return x64ImmBinopFolded(op, t, v, constLhs)
}

// A constant count in [0, width) folds; a count at or above the width, a
// negative count and a constant shifted value do not.
func TestX64ImmFitsShiftCount() testing.TestResult {
	if !x64ShiftFolded(iropcode.OP_SHL, types.TypInt64(), cast(int64, 63), false) {
		return "int64 << 63 must fold"
	}
	if !x64ShiftFolded(iropcode.OP_SHR, types.TypUint8(), cast(int64, 0), false) {
		return "uint8 >> 0 must fold"
	}
	if x64ShiftFolded(iropcode.OP_SHL, types.TypInt64(), cast(int64, 64), false) {
		return "int64 << 64 must not fold"
	}
	if x64ShiftFolded(iropcode.OP_SHR, types.TypInt16(), cast(int64, 16), false) {
		return "int16 >> 16 must not fold"
	}
	if x64ShiftFolded(iropcode.OP_SHR, types.TypInt(), cast(int64, -1), false) {
		return "a negative count must not fold"
	}
	if x64ShiftFolded(iropcode.OP_SHL, types.TypInt(), cast(int64, 3), true) {
		return "a constant shifted value must not fold"
	}
	return ""
}

// A count shared with a MUL operand (no immediate position) stays materialized.
func TestX64ImmFitsShiftCountSharedWithMul() testing.TestResult {
	var f @ir.Func = x64ImmNewFunc()
	var b @ir.Block = ir.AddBlock(f, "entry")
	var c @ir.Instr = irbuild.EmitConstInt64(b, cast(int64, 3), types.TypInt())
	var x @ir.Instr = x64ImmParam(f, types.TypInt())
	_ = irbuild.EmitBinop(b, iropcode.OP_SHL, x, c, types.TypInt())
	if !x64ImmFolded(f, c) { return "a count used only by a shift must fold" }
	_ = irbuild.EmitBinop(b, iropcode.OP_MUL, x, c, types.TypInt())
	if x64ImmFolded(f, c) { return "a count also used by a MUL must not fold" }
	return ""
}

// `<<` is SHL, a signed `>>` is SAR and an unsigned `>>` is SHR, each by imm8.
func TestX64ShiftImmFoldGoldens() testing.TestResult {
	var r testing.TestResult
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_SHL, 1, 2, cast(int64, 3), 1, types.TypInt64())
	r = x64FoldGolden(a, "4c 8b 14 24 4d 89 d3 49 c1 e3 03", "x << 3")
	if len(r) != 0 { return r }
	a = x64FoldImmBinop(iropcode.OP_SHR, 1, 2, cast(int64, 3), 1, types.TypInt64())
	r = x64FoldGolden(a, "4c 8b 14 24 4d 89 d3 49 c1 fb 03", "x >> 3 (int64)")
	if len(r) != 0 { return r }
	a = x64FoldImmBinop(iropcode.OP_SHR, 1, 2, cast(int64, 63), 1, types.TypUint64())
	return x64FoldGolden(a, "4c 8b 14 24 4d 89 d3 49 c1 eb 3f", "x >> 63 (uint64)")
}

// A uint32 shift runs in the 32-bit form, which self-clears the top half, so no
// re-narrow follows; an int8 shift runs at 64 bits and is re-narrowed.
func TestX64ShiftImmFoldWidths() testing.TestResult {
	var r testing.TestResult
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_SHL, 1, 2, cast(int64, 31), 1,
			types.TypUint32())
	r = x64FoldGolden(a, "4c 8b 14 24 45 89 d3 41 c1 e3 1f", "x << 31 (uint32)")
	if len(r) != 0 { return r }
	a = x64FoldImmBinop(iropcode.OP_SHR, 1, 2, cast(int64, 2), 1, types.TypInt8())
	return x64FoldGolden(a, "4c 8b 14 24 4d 89 d3 49 c1 fb 02 4d 0f be db", "x >> 2 (int8)")
}

// A count marked FoldedImm that does not fit (64 on an int64 shift) fails loud
// rather than encoding a masked shift or reading the unmaterialized constant.
func TestX64ShiftImmFoldMisfitFailsLoud() testing.TestResult {
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_SHL, 1, 2, cast(int64, 64), 1, types.TypInt64())
	if !a.HasError { return "a folded int64 shift count of 64 must record an error" }
	return ""
}

// namedUint32_x64test is `type U uint32`: a named type over uint32.
func namedUint32_x64test() @types.Type {
	var nt @types.Type = types.MakeNamedType("U")
	nt.Underlying = types.TypUint32()
	return nt
}

// A shift on a named unsigned type is judged by its underlying type: the count
// range is uint32's, the op runs in the 32-bit form, and `>>` is SHR, not SAR.
// A zero count still rides the imm8.
func TestX64ShiftImmFoldNamedTypeAndZeroCount() testing.TestResult {
	var r testing.TestResult
	if !x64ShiftFolded(iropcode.OP_SHR, namedUint32_x64test(), cast(int64, 31), false) {
		return "U >> 31 must fold (U is uint32)"
	}
	if x64ShiftFolded(iropcode.OP_SHR, namedUint32_x64test(), cast(int64, 32), false) {
		return "U >> 32 must not fold (U is uint32)"
	}
	var a @asm.Assembler = x64FoldImmBinop(iropcode.OP_SHR, 1, 2, cast(int64, 31), 1,
			namedUint32_x64test())
	r = x64FoldGolden(a, "4c 8b 14 24 45 89 d3 41 c1 eb 1f", "x >> 31 (U uint32)")
	if len(r) != 0 { return r }
	a = x64FoldImmBinop(iropcode.OP_SHL, 1, 2, cast(int64, 0), 1, types.TypInt64())
	return x64FoldGolden(a, "4c 8b 14 24 4d 89 d3 49 c1 e3 00", "x << 0")
}
