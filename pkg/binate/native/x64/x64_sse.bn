package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// SysV-AMD64 SSE eightbyte AGGREGATE marshalling helpers, shared across the x64
// backend.  A <=16-byte float aggregate rides registers by SysV class: each SSE
// eightbyte in an XMM reg, each INTEGER eightbyte in a GP reg.  Every helper walks
// types.SysVClassify and chooses the move width by SysVEightbyteForm (SEB_FLOAT ->
// MOVSS 4 B, else MOVLPS 8 B).  The two arg helpers (emitSseAggregateArg caller
// pack, spillSseAggregateParam callee spill) RETURN the number of SSE eightbytes
// placed in XMM registers, so the caller / callee loops advance their NSRN by that
// amount — matching common.advanceNsrn (they are only called for the in-register
// case; MEMORY aggregates take the plain stack path).  emitSseReturnCollectTo is
// the shared SSE-return collect used by the direct-call site and the dispatch
// shims.  All dormant until the x64 SSE gate flips (PassesSseInRegs /
// ReturnsSseInRegs false), so no live behavior change.

// emitSseAggregateArg loads a SysV-SSE aggregate arg from its storage image into
// the outgoing arg registers: each SSE eightbyte -> XMM(fpStart + nsse), each
// INTEGER eightbyte -> GP argReg(regStart + ngp).  Returns the SSE eightbytes
// placed (the caller advances NSRN by this).  regStart is CallArgRegStart's GP
// index (unused when the aggregate is pure-SSE with no INTEGER eightbyte).
func emitSseAggregateArg(a @asm.Assembler, rm @common.RegMap, arg @ir.Instr,
		regStart int, fpStart int) int {
	var ptr int = getOperand(a, rm, arg.ID)
	if ptr < 0 { return 0 }
	var t @types.Type = arg.Typ
	var cl @[]int = types.SysVClassify(t)
	var nsse int = 0
	var ngp int = 0
	for eb := 0; eb < len(cl); eb++ {
		var off int = 8 * eb
		if cl[eb] == types.EB_SSE {
			if types.SysVEightbyteForm(t, eb) == types.SEB_FLOAT {
				x64.Movss_load(a, x64.XMM0 + fpStart + nsse,
					x64.Mem(ptr, off, x64.SZ32))
			} else {
				x64.Movlps_load(a, x64.XMM0 + fpStart + nsse,
					x64.Mem(ptr, off, x64.SZ64))
			}
			nsse = nsse + 1
		} else {
			x64.Mov(a, x64.Reg(argReg(regStart + ngp), x64.SZ64),
				x64.Mem(ptr, off, x64.SZ64))
			ngp = ngp + 1
		}
	}
	return nsse
}

// spillSseAggregateParam stores an incoming SysV-SSE aggregate parameter from its
// arg registers into the param's data region at dataOff: each SSE eightbyte from
// XMM(fpStart + nsse) via Movss_store/Movlps_store, each INTEGER eightbyte from GP
// argReg(regStart + ngp) via Mov, to [rsp + dataOff + 8*eb].  The callee mirror of
// emitSseAggregateArg; returns the SSE eightbytes consumed (the callee advances
// NSRN by this).  Called only for an in-register SSE aggregate param — a MEMORY
// one arrives on the incoming stack and is copied by the plain aggregate path.
func spillSseAggregateParam(a @asm.Assembler, rm @common.RegMap, t @types.Type,
		regStart int, fpStart int, dataOff int) int {
	var cl @[]int = types.SysVClassify(t)
	var nsse int = 0
	var ngp int = 0
	for eb := 0; eb < len(cl); eb++ {
		var off int = dataOff + 8 * eb
		if cl[eb] == types.EB_SSE {
			if types.SysVEightbyteForm(t, eb) == types.SEB_FLOAT {
				x64.Movss_store(a, x64.Mem(x64.RSP, off, x64.SZ32),
					x64.XMM0 + fpStart + nsse)
			} else {
				x64.Movlps_store(a, x64.Mem(x64.RSP, off, x64.SZ64),
					x64.XMM0 + fpStart + nsse)
			}
			nsse = nsse + 1
		} else {
			x64.Mov(a, x64.Mem(x64.RSP, off, x64.SZ64),
				x64.Reg(argReg(regStart + ngp), x64.SZ64))
			ngp = ngp + 1
		}
	}
	return nsse
}

// emitSseReturnCollectTo stores an in-register SSE aggregate return (SSE
// eightbytes in XMM0/XMM1, INTEGER eightbytes in RAX/RDX — as the callee packed
// them) into memory at [baseReg + baseOff + 8*eb], by class.  Shared by the
// direct-call collect (collectSseAggregateReturn, baseReg = RSP + dataOff) and
// the dispatch shims, which reload the caller's retbuf pointer into a scratch and
// collect through it (baseReg = that scratch).  The return regs still hold the
// callee's result at the call site; baseReg must not be RAX/RDX/XMM0/XMM1.
func emitSseReturnCollectTo(a @asm.Assembler, t @types.Type, baseReg int,
		baseOff int) {
	var cl @[]int = types.SysVClassify(t)
	var nsse int = 0
	var ngp int = 0
	for eb := 0; eb < len(cl); eb++ {
		var off int = baseOff + 8 * eb
		if cl[eb] == types.EB_SSE {
			if types.SysVEightbyteForm(t, eb) == types.SEB_FLOAT {
				x64.Movss_store(a, x64.Mem(baseReg, off, x64.SZ32),
					x64.XMM0 + nsse)
			} else {
				x64.Movlps_store(a, x64.Mem(baseReg, off, x64.SZ64),
					x64.XMM0 + nsse)
			}
			nsse = nsse + 1
		} else {
			var gp int = x64.RAX
			if ngp == 1 { gp = x64.RDX }
			x64.Mov(a, x64.Mem(baseReg, off, x64.SZ64), x64.Reg(gp, x64.SZ64))
			ngp = ngp + 1
		}
	}
	return
}
