package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the SysV-AMD64 SSE eightbyte aggregate arg marshalling
// (emitSseAggregateArg / spillSseAggregateParam, x64_sse.bn).  The emitters are
// not gated internally (the SseAggregates gate is applied at the call site), so
// they can be driven directly.  The strongest check is the returned XMM count
// (how many SSE eightbytes were placed) plus the FP move OPCODE, which pins the
// form -> width mapping: a lone f32 eightbyte uses MOVSS (F3 0F 10/11), a packed
// 2xf32 or an f64 eightbyte uses MOVLPS (0F 12/13); an INTEGER eightbyte a MOV.

// sseMkAsm returns a text-section assembler for the emit tests.
func sseMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// sseArg builds an SSA value (ID 1) of aggregate type t whose storage pointer
// getOperand materialises from a spill slot at offset 0.
func sseArg(t @types.Type) @ir.Instr {
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = t
	return src
}

// sseArgMap returns a RegMap with a spill slot for SSA value 1 (so getOperand
// can load its storage pointer).
func sseArgMap() @common.RegMap {
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	return m
}

// hasPair reports whether the assembler's text bytes contain b0 immediately
// followed by b1 — used to spot a two-byte opcode (0F xx) or a mandatory-prefix
// opcode's escape byte in the emitted stream.
func hasPair(a @asm.Assembler, b0 int, b1 int) bool {
	// bnlint:allow managed-to-raw-assign - live @Assembler field; outlives the read
	var data *[]uint8 = a.Sections[0].Data
	for i := 0; i + 1 < a.Sections[0].Len; i++ {
		if data[i] == cast(uint8, b0) && data[i + 1] == cast(uint8, b1) {
			return true
		}
	}
	return false
}

// struct2t builds a named 2-field struct of field types t0, t1.
func struct2t(name @[]char, t0 @types.Type, t1 @types.Type) @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 2)
	fs[0] = make(types.Field)
	fs[0].Type = t0
	fs[1] = make(types.Field)
	fs[1].Type = t1
	return types.MakeStructType(name, fs)
}

// emitSseAggregateArg places {f64,f64}'s two SSE eightbytes into XMM via MOVLPS
// and returns 2.
func TestEmitSseArgTwoDoubles() testing.TestResult {
	var a @asm.Assembler = sseMkAsm()
	var m @common.RegMap = sseArgMap()
	var t @types.Type = struct2t("D2", types.TypFloat64(), types.TypFloat64())
	var n int = emitSseAggregateArg(a, m, sseArg(t), 0, 0)
	if n != 2 { return "{f64,f64} arg must place 2 SSE eightbytes in XMM" }
	if !hasPair(a, 0x0F, 0x12) { return "{f64,f64} arg must emit MOVLPS load (0F 12)" }
	return ""
}

// A mixed {f64,i64}: one SSE eightbyte (MOVLPS into XMM) + one INTEGER eightbyte
// (MOV into a GP arg reg); returns 1 (one XMM consumed).
func TestEmitSseArgDoubleInt() testing.TestResult {
	var a @asm.Assembler = sseMkAsm()
	var m @common.RegMap = sseArgMap()
	var t @types.Type = struct2t("DI", types.TypFloat64(), types.TypInt64())
	var n int = emitSseAggregateArg(a, m, sseArg(t), 0, 0)
	if n != 1 { return "{f64,i64} arg has exactly one SSE eightbyte" }
	if !hasPair(a, 0x0F, 0x12) { return "{f64,i64} arg must MOVLPS the double eightbyte" }
	return ""
}

// A packed 2xf32 eightbyte uses MOVLPS (8-byte), not MOVSS.
func TestEmitSseArgTwoFloatsUsesMovlps() testing.TestResult {
	var a @asm.Assembler = sseMkAsm()
	var m @common.RegMap = sseArgMap()
	var t @types.Type = struct2t("F2", types.TypFloat32(), types.TypFloat32())
	var n int = emitSseAggregateArg(a, m, sseArg(t), 0, 0)
	if n != 1 { return "{f32,f32} packs into one SSE eightbyte" }
	if !hasPair(a, 0x0F, 0x12) { return "{f32,f32} eightbyte must use MOVLPS (0F 12)" }
	return ""
}

// A lone f32 eightbyte uses MOVSS (F3 0F 10), the 4-byte move.
func TestEmitSseArgLoneFloatUsesMovss() testing.TestResult {
	var a @asm.Assembler = sseMkAsm()
	var m @common.RegMap = sseArgMap()
	var fs @[]@types.Field = make_slice(@types.Field, 1)
	fs[0] = make(types.Field)
	fs[0].Type = types.TypFloat32()
	var t @types.Type = types.MakeStructType("F1", fs)
	var n int = emitSseAggregateArg(a, m, sseArg(t), 0, 0)
	if n != 1 { return "{f32} has one SSE eightbyte" }
	if !hasPair(a, 0x0F, 0x10) { return "lone f32 eightbyte must use MOVSS load (0F 10)" }
	return ""
}

// spillSseAggregateParam stores {f64,f64}'s eightbytes from XMM to the data
// region via MOVLPS store (0F 13) and returns 2.
func TestSpillSseParamTwoDoubles() testing.TestResult {
	var a @asm.Assembler = sseMkAsm()
	var m @common.RegMap = sseArgMap()
	var t @types.Type = struct2t("D2", types.TypFloat64(), types.TypFloat64())
	var n int = spillSseAggregateParam(a, m, t, 0, 0, 0)
	if n != 2 { return "{f64,f64} param spill consumes 2 XMM regs" }
	if !hasPair(a, 0x0F, 0x13) { return "{f64,f64} param spill must emit MOVLPS store (0F 13)" }
	return ""
}

// A mixed {i64,f64} param: INTEGER eightbyte first (MOV store) then SSE (MOVLPS
// store); returns 1.
func TestSpillSseParamIntDouble() testing.TestResult {
	var a @asm.Assembler = sseMkAsm()
	var m @common.RegMap = sseArgMap()
	var t @types.Type = struct2t("ID", types.TypInt64(), types.TypFloat64())
	var n int = spillSseAggregateParam(a, m, t, 0, 0, 0)
	if n != 1 { return "{i64,f64} param spill consumes one XMM reg" }
	if !hasPair(a, 0x0F, 0x13) { return "{i64,f64} param spill must MOVLPS-store the double" }
	return ""
}

// emitSseReturnCollectTo stores the underlying's SSE return (XMM0/XMM1 + RAX/RDX)
// through an arbitrary base register (a shim's reloaded retbuf, here R10): a
// {f64,f64} return emits two MOVLPS stores (0F 13).  The base register really is
// threaded (not hard-coded RSP): storing through R10 (an r8..r15 reg) requires a
// REX.B prefix (0x41) that an RSP-based store would not carry, so a 0x41-before-0F
// pins that the collect honoured the R10 argument.
func TestSseReturnCollectToBaseReg() testing.TestResult {
	var a @asm.Assembler = sseMkAsm()
	var t @types.Type = struct2t("D2", types.TypFloat64(), types.TypFloat64())
	emitSseReturnCollectTo(a, t, x64.R10, 0)
	if !hasPair(a, 0x0F, 0x13) { return "{f64,f64} return collect must emit MOVLPS store (0F 13)" }
	if !hasPair(a, 0x41, 0x0F) { return "collect must address the R10 base (REX.B 0x41), not RSP" }
	return ""
}

// A lone f32 return eightbyte (SEB_FLOAT) collects via MOVSS store (F3 0F 11), the
// 4-byte move — distinct from the 8-byte MOVLPS used for f64 / packed 2xf32.
func TestSseReturnCollectLoneFloat() testing.TestResult {
	var a @asm.Assembler = sseMkAsm()
	var fs @[]@types.Field = make_slice(@types.Field, 1)
	fs[0] = make(types.Field)
	fs[0].Type = types.TypFloat32()
	var t @types.Type = types.MakeStructType("F1", fs)
	emitSseReturnCollectTo(a, t, x64.R10, 0)
	if !hasPair(a, 0x0F, 0x11) { return "lone f32 return collect must emit MOVSS store (0F 11)" }
	return ""
}

// A mixed {i64,f64} return: the INTEGER eightbyte comes back in RAX (stored via
// MOV r/m,r = 0x89), the SSE eightbyte in XMM0 (MOVLPS store 0F 13) — both through
// the R10 base.  Pins that the INTEGER path uses RAX/RDX, not an XMM store.
func TestSseReturnCollectMixed() testing.TestResult {
	var a @asm.Assembler = sseMkAsm()
	var t @types.Type = struct2t("ID", types.TypInt64(), types.TypFloat64())
	emitSseReturnCollectTo(a, t, x64.R10, 0)
	if !hasPair(a, 0x0F, 0x13) { return "{i64,f64}: SSE eightbyte must MOVLPS-store" }
	if !hasPair(a, 0x49, 0x89) { return "{i64,f64}: i64 eightbyte must MOV-store RAX (REX.WB 49 89)" }
	return ""
}
