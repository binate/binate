package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Stack arguments past 2 GiB: the offsets into the outgoing-args area, and the frames
// that hold it, are int64 (callconv's ...64 forms); an access past a displacement goes
// through the far helpers, and RSP moves past an immediate through a scratch register.
// The golden encodings are clang's for the same instructions.

// RSP moves by an immediate when it fits one, else through the scratch register.
func TestRspAdjustX64() testing.TestResult {
	setFarDispLimit(0)
	var a @asm.Assembler = farTextAsm()
	emitRspAdjustX64(a, true, 0x100, x64.R11)
	emitRspAdjustX64(a, false, 0x100, x64.R11)
	var r testing.TestResult = x64FoldGolden(a, "48 81 ec 00 01 00 00 48 81 c4 00 01 00 00",
			"sub / add rsp, 0x100")
	if len(r) > 0 { return r }
	a = farTextAsm()
	emitRspAdjustX64(a, true, 0xC0000010, x64.R11)
	emitRspAdjustX64(a, false, 0xC0000010, x64.R11)
	return x64FoldGolden(a,
			"49 bb 10 00 00 c0 00 00 00 00 4c 29 dc 49 bb 10 00 00 c0 00 00 00 00 4c 01 dc",
			"sub / add rsp, 0xC0000010 through R11")
}

// A 24-byte MEMORY-class argument stored past 2^31 in the outgoing area goes through
// a saved R11 holding the slot's address; a 1 GiB one is a copy loop to it.
func TestAggregateArgPast2GiBX64() testing.TestResult {
	setFarDispLimit(0)
	var m @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt64(m.SpillOffsets, 0)
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 1
	arg.Typ = types.MakeArrayType(types.TypUint8(), 24)
	var a @asm.Assembler = emitMkAsm()
	emitAggregateArg(a, m, arg, -1, 0x80000000)
	var r testing.TestResult = x64FoldGolden(a,
			"4c 8b 14 24 4c 89 5c 24 80 49 bb 00 00 00 80 00 00 00 00 4e 8d 1c 1c 49 8b 02 49 89 03 "
					"49 8b 42 08 49 89 43 08 49 8b 42 10 49 89 43 10 4c 8b 5c 24 80",
			"a 24-byte argument at 2^31: mov r10, [rsp]; the slot's address in a saved R11")
	if len(r) > 0 { return r }
	arg.Typ = types.MakeArrayType(types.TypUint8(), 0x40000000)
	m = common.NewRegMap(callconv.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt64(m.SpillOffsets, 0)
	a = emitMkAsm()
	emitAggregateArg(a, m, arg, -1, 0x80000000)
	return x64FoldGolden(a,
			"4c 8b 14 24 4c 89 5c 24 80 49 bb 00 00 00 80 00 00 00 00 4e 8d 1c 1c 48 c7 c0 e0 ff ff 3f "
					"45 0f 10 34 02 45 0f 10 7c 02 10 45 0f 11 34 03 45 0f 11 7c 03 10 48 83 e8 20 79 e4 "
					"4c 8b 5c 24 80",
			"a 1 GiB argument at 2^31: a copy loop indexed by RAX to the slot in a saved R11")
}

// The C-export trampoline moves an SSE eightbyte between a C stack slot and an
// internal one, either past 2^31.
func TestTrampolineSseMovePast2GiBX64() testing.TestResult {
	setFarDispLimit(0)
	var a @asm.Assembler = farTextAsm()
	emitTrampolineSseMove(a, false, x64.RBP, 0x80000010, true, x64.RSP, 0x80000000, x64.XMM0)
	return x64FoldGolden(a,
			"48 b8 10 00 00 80 00 00 00 00 48 8d 44 05 00 48 8b 00 4c 89 5c 24 80 49 bb 00 00 00 80 "
					"00 00 00 00 4e 8d 1c 1c 49 89 03 4c 8b 5c 24 80",
			"an eightbyte from [rbp + 0x80000010] to [rsp + 0x80000000]: through rax, then a saved R11")
}
