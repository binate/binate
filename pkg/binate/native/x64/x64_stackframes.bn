package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/native/common"

// emitStackFrames lowers OP_STACK_FRAMES (pkg/std/debug's from-code stacktrace
// capture) — the native-backend counterpart of codegen.emitStackFrames.  Where
// the LLVM backend seeds the walk with llvm.frameaddress(0), the native backend
// already keeps the frame pointer in RBP (see emitPrologue: `push rbp; mov rbp,
// rsp`), so RBP IS the current frame — no intrinsic needed.  It calls
// rt.CaptureNativeFrames(fp, skip, data, len), whose int result (frames at/above
// skip) becomes this instruction's value.
//
// Args[0] = skip (scalar), Args[1] = buf *[]Frame (a raw slice — an aggregate, so
// getOperand hands back a POINTER to its {data,len} image).  SysV-AMD64 args:
// RDI=fp, RSI=skip, RDX=data, RCX=len; result in RAX.
//
// Marshal order is chosen so no source is clobbered before it is read, regardless
// of which pool registers skip/buf occupy: copy skip to RSI first (RSI is not a
// pool register, so it cannot alias buf); load both slice words THROUGH RAX/RCX
// while the buf pointer is still live (RAX is not a pool register); set RDI=RBP
// last (every operand is already marshaled by then).
func emitStackFrames(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 2 { return }
	var skipReg int = getOperand(a, rm, ins.Args[0].ID)
	var bufPtr int = getOperand(a, rm, ins.Args[1].ID)
	if skipReg < 0 || bufPtr < 0 { return }
	// skip -> RSI (copy: skipReg stays valid; RSI is not a pool reg so it can't
	// be buf/skip's home).
	if skipReg != x64.RSI {
		x64.Mov(a, x64.Reg(x64.RSI, x64.SZ64), x64.Reg(skipReg, x64.SZ64))
	}
	// data -> RAX shuttle, len -> RCX, data -> RDX.  Both loads read [bufPtr]
	// before RDX/RCX (either of which may BE bufPtr) is overwritten.
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Mem(bufPtr, 0, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.RCX, x64.SZ64), x64.Mem(bufPtr, 8, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.RDX, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
	// fp -> RDI (last: all other operands are marshaled, so clobbering a pool reg
	// that once held skip/buf is now harmless).
	x64.Mov(a, x64.Reg(x64.RDI, x64.SZ64), x64.Reg(x64.RBP, x64.SZ64))
	var callee @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "CaptureNativeFrames"))
	a.SetGlobal(callee)
	x64.Call(a, callee)
	// CALL clobbers the caller-saved pool; free it before allocating the result.
	rm.ResetRegs()
	if ins.ID < 0 { return }
	var rd int = nextReg(rm, ins.ID)
	if rd != x64.RAX {
		x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Reg(x64.RAX, x64.SZ64))
	}
}
