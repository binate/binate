package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/mangle"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// OP_STACK_FRAMES (pkg/std/debug capture) lowers to a call to
// rt.CaptureNativeFrames — NOT silently dropped.  The buf *[]Frame is an
// aggregate (registered here as an alloc so getOperand yields a pointer to its
// {data,len} image, as in a real compile); skip is a scalar.  Asserts the call
// target is declared (proving the whole lowering ran through the CALL) and that
// something was emitted, guarding against a regression back to the silent-drop
// tail.  The RBP=fp seed and register marshaling are covered by code review + the
// eventual native-main end-to-end (deps are LLVM-compiled today, so
// OP_STACK_FRAMES reaches the native backend only when debug is the main module).
func TestEmitStackFrames() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// skip (id 1): a scalar spill operand.
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	// buf (id 2): an aggregate data region — getOperand LEAs its address.
	m.AllocIDs = common.AppendInt(m.AllocIDs, 2)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 16)
	var skip @ir.Instr = make(ir.Instr)
	skip.ID = 1
	skip.Typ = types.TypInt()
	var buf @ir.Instr = make(ir.Instr)
	buf.ID = 2
	buf.Typ = types.MakeSliceType(types.TypInt()) // a raw-slice aggregate
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = iropcode.OP_STACK_FRAMES
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = skip
	ins.Args[1] = buf
	emitInstr(a, "main", "bn_main__main", m, nilStrings(), ins)
	if a.Sections[0].Len == 0 {
		return "OP_STACK_FRAMES must not be silently dropped on x64"
	}
	var callee @[]char = symPrefixed(mangle.FuncName("pkg/builtins/rt", "CaptureNativeFrames"))
	if a.LookupSymbol(callee) < 0 {
		return "OP_STACK_FRAMES should call rt.CaptureNativeFrames"
	}
	return ""
}
