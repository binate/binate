package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"

// ============================================================
// Terminators: jumps and conditional branches
// ============================================================

// emitTerm lowers ins, the terminator of a block, and reports whether the block
// ended in a transfer of control (a jmp, ret or trap, after which control never
// reaches the following code).  next is the block laid out right after this one
// when the plan lets a block fall through into it (blockplan.PlanNext), else nil.
// A jump or a branch leaves out its jmp to next (emitJumpOrBranch), so the block
// falls through into next; every other terminator is lowered by emitInstr and
// ends in a transfer.
func emitTerm(a @asm.Assembler, pkgName *[]readonly char, funcSym @[]char, rm @common.RegMap,
		strings @[]ir.StringConst, ins @ir.Instr, next @ir.Block) bool {
	if ins.Op == iropcode.OP_JUMP || ins.Op == iropcode.OP_BRANCH {
		currentEmitOp = ins.Op
		return emitJumpOrBranch(a, funcSym, rm, ins, next)
	}
	emitInstr(a, pkgName, funcSym, rm, strings, ins)
	return true
}

// emitJumpOrBranch lowers ins, an OP_JUMP or OP_BRANCH whose targets are blocks of
// the function funcSym (blockLabel), and reports whether it ended in a transfer:
// false when it leaves control to fall through into next.  next is the block laid
// out right after ins's block that control may fall into, or nil when there is
// none (emitInstr passes nil); with nil, every target is reached by a jump.
//   - A jump is a jmp to its target, left out when the target is next.
//   - A branch whose two arms are one block is, when next is set, a jump to that
//     block.  (With next nil it is lowered as any other branch.)
//   - A branch is a Jcc on its condition to the then-block followed by a jmp to
//     the else-block.  When the else-block is next the jmp is left out; when the
//     then-block is next, a Jcc on the inverted condition (x64.InvertCC) goes to
//     the else-block instead.
// The condition of a branch-fused integer compare (rm.IsFusedCmp) is the flags its
// CMP set right before the branch (emitCompare); InvertCC inverts each of the
// integer conditions condForOp gives exactly.  Any other condition is a 0/1 value
// in a register, which the branch tests (TEST; the Jcc is JNZ, inverted JZ).
func emitJumpOrBranch(a @asm.Assembler, funcSym @[]char, rm @common.RegMap, ins @ir.Instr,
		next @ir.Block) bool {
	if ins.Op == iropcode.OP_JUMP {
		if ins.Block1 == nil {
			a.SetError("native amd64: a jump without a target")
			return true
		}
		return emitJumpTo(a, funcSym, ins.Block1, next)
	}
	// Args[0] = cond, Block1 = then-block, Block2 = else-block.
	if ins.Block1 == nil || ins.Block2 == nil || len(ins.Args) < 1 {
		a.SetError("native amd64: a branch without both targets and a condition")
		return true
	}
	if next != nil && ins.Block1 == ins.Block2 { return emitJumpTo(a, funcSym, ins.Block1, next) }
	var cc int = x64.CC_NZ
	var cond @ir.Instr = ins.Args[0]
	if cond != nil && rm.IsFusedCmp(cond.ID) && len(cond.Args) >= 1 && cond.Args[0] != nil {
		var ct @types.Type = types.StripWrappers(cond.Args[0].Typ)
		var uns bool = ct != nil && ct.IsInteger() && !ct.Signed
		cc = condForOp(cond.Op, uns)
	} else {
		var condReg int = getOperand(a, rm, ins.Args[0].ID)
		if condReg < 0 {
			a.SetError("native amd64: a branch condition with no register")
			return true
		}
		var condOp x64.Operand = x64.Reg(condReg, x64.SZ64)
		x64.Test(a, condOp, condOp)
	}
	if next != nil && ins.Block1 == next {
		x64.Jcc(a, x64.InvertCC(a, cc), blockLabel(funcSym, ins.Block2.Label))
		return false
	}
	x64.Jcc(a, cc, blockLabel(funcSym, ins.Block1.Label))
	return emitJumpTo(a, funcSym, ins.Block2, next)
}

// emitJumpTo emits a jmp to target, a block of the function funcSym, unless target
// is next, the block control falls into (emitJumpOrBranch; nil for none).  Reports
// whether it emitted the jmp.
func emitJumpTo(a @asm.Assembler, funcSym @[]char, target *ir.Block, next @ir.Block) bool {
	if target == next { return false }
	x64.Jmp(a, blockLabel(funcSym, target.Label))
	return true
}
