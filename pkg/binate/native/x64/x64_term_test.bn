package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/callconv"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/testing"

// emitTerm, the lowering of a block's terminator, checked against reference code
// built with the encoders: the bytes and the fixups (so the targets) must match.

// termSym is the function symbol the test terminators' block labels hang off.
func termSym() @[]char {
	return symFor("main", "main.main")
}

// termRegMap returns the register map a test terminator is lowered with: value 1,
// a branch's condition, homed in RBX, and fused into the branch (rm.IsFusedCmp)
// when fused is set.
func termRegMap(fused bool) @common.RegMap {
	var rm @common.RegMap = common.NewRegMap(callconv.SysV_AMD64())
	rm.HomeIDs = common.AppendInt(rm.HomeIDs, 1)
	rm.HomeRegs = common.AppendInt(rm.HomeRegs, x64.RBX)
	var fc @[]bool = make_slice(bool, 2)
	fc[1] = fused
	rm.FusedCmp = fc
	return rm
}

// termAsm returns an empty assembler with a text section.
func termAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// termBlocks returns a function owning the blocks a test terminator targets and
// falls into: f.Blocks[0] (`then`), f.Blocks[1] (`else`) and f.Blocks[2] (`other`,
// a block no terminator here targets).
func termBlocks() @ir.Func {
	var f @ir.Func = ir.NewFunc("", "main.main", makeNoParams(), makeNoResults())
	_ = ir.AddBlock(f, "then")
	_ = ir.AddBlock(f, "else")
	_ = ir.AddBlock(f, "other")
	return f
}

// termJump returns a jump to target.
func termJump(target @ir.Block) @ir.Instr {
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_JUMP
	ins.Block1 = target
	return ins
}

// termBool returns value 1 as a bool, a branch condition held in a register.
func termBool() @ir.Instr {
	var cond @ir.Instr = make(ir.Instr)
	cond.ID = 1
	cond.Typ = types.TypBool()
	return cond
}

// termCmp returns value 1 as the compare op of two values of type operand, a
// branch condition termRegMap(true) fuses into the branch.
func termCmp(op int, operand @types.Type) @ir.Instr {
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 2
	lhs.Typ = operand
	var cond @ir.Instr = termBool()
	cond.Op = op
	cond.Args = make_slice(@ir.Instr, 2)
	cond.Args[0] = lhs
	cond.Args[1] = lhs
	return cond
}

// termBranch returns a branch on cond to thenB, else to elseB.
func termBranch(cond @ir.Instr, thenB @ir.Block, elseB @ir.Block) @ir.Instr {
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = iropcode.OP_BRANCH
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = cond
	ins.Block1 = thenB
	ins.Block2 = elseB
	return ins
}

// termLabelIs reports whether label names x and y are the same.
func termLabelIs(x *[]readonly char, y *[]readonly char) bool {
	if len(x) != len(y) { return false }
	for i := 0; i < len(x); i++ {
		if x[i] != y[i] { return false }
	}
	return true
}

// sameCode reports whether got holds exactly want's code, with no error in
// either: the same bytes and the same fixups (offset, kind and label), so the
// same branches to the same targets.
func sameCode(want @asm.Assembler, got @asm.Assembler) bool {
	if want.HasError || got.HasError { return false }
	var ws @asm.Section = want.Sections[0]
	var gs @asm.Section = got.Sections[0]
	if ws.Len != gs.Len || ws.NumFixups != gs.NumFixups { return false }
	for i := 0; i < asm.HeldLen(ws); i++ {
		if ws.Data[i] != gs.Data[i] { return false }
	}
	for fi := 0; fi < ws.NumFixups; fi++ {
		if ws.Fixups[fi].Offset != gs.Fixups[fi].Offset || ws.Fixups[fi].Kind != gs.Fixups[fi].Kind {
			return false
		}
		if !termLabelIs(ws.Fixups[fi].Label, gs.Fixups[fi].Label) { return false }
	}
	return true
}

// termLowers reports whether emitTerm lowers ins, with next as the block laid
// out after ins's block and the condition fused as termRegMap(fused) says, to
// exactly want's code, and returns ended as whether the block ended in a
// transfer.
func termLowers(ins @ir.Instr, next @ir.Block, fused bool, want @asm.Assembler, ended bool) bool {
	var got @asm.Assembler = termAsm()
	var transfer bool = emitTerm(got, "main", termSym(), termRegMap(fused), nilStrings(), ins, next)
	return transfer == ended && sameCode(want, got)
}

// termLabel returns the label of block b of the test function.
func termLabel(b @ir.Block) @[]char {
	return blockLabel(termSym(), b.Label)
}

// termJcc returns reference code: TEST RBX, RBX when test is set, then Jcc cc to
// target, then a jmp to jmpTo unless jmpTo is nil.
func termJcc(test bool, cc int, target @ir.Block, jmpTo @ir.Block) @asm.Assembler {
	var a @asm.Assembler = termAsm()
	if test { x64.Test(a, x64.Reg(x64.RBX, x64.SZ64), x64.Reg(x64.RBX, x64.SZ64)) }
	x64.Jcc(a, cc, termLabel(target))
	if jmpTo != nil { x64.Jmp(a, termLabel(jmpTo)) }
	return a
}

// termJmp returns reference code: a jmp to target, or nothing when target is nil.
func termJmp(target @ir.Block) @asm.Assembler {
	var a @asm.Assembler = termAsm()
	if target != nil { x64.Jmp(a, termLabel(target)) }
	return a
}

// A jump is a jmp to its target, and is left out, the block falling through,
// when the target is the block laid out next.
func TestEmitTermJump() testing.TestResult {
	var f @ir.Func = termBlocks()
	var none @ir.Block
	var jump @ir.Instr = termJump(f.Blocks[0])
	if !termLowers(jump, none, false, termJmp(f.Blocks[0]), true) {
		return fail("a jump with no block laid out next must be a jmp")
	}
	if !termLowers(jump, f.Blocks[2], false, termJmp(f.Blocks[0]), true) {
		return fail("a jump to a block not laid out next must be a jmp")
	}
	if !termLowers(jump, f.Blocks[0], false, termJmp(none), false) {
		return fail("a jump to the block laid out next must emit nothing and fall through")
	}
	return ""
}

// A branch on a condition in a register tests it: JNZ to the then-block and a jmp
// to the else-block; JNZ alone, falling through, when the else-block is next; JZ to
// the else-block, falling through, when the then-block is next.
func TestEmitTermBranchOnRegister() testing.TestResult {
	var f @ir.Func = termBlocks()
	var none @ir.Block
	var thenB @ir.Block = f.Blocks[0]
	var elseB @ir.Block = f.Blocks[1]
	var br @ir.Instr = termBranch(termBool(), thenB, elseB)
	if !termLowers(br, none, false, termJcc(true, x64.CC_NZ, thenB, elseB), true) {
		return fail("with no block laid out next: test; jnz then; jmp else")
	}
	if !termLowers(br, f.Blocks[2], false, termJcc(true, x64.CC_NZ, thenB, elseB), true) {
		return fail("with neither arm next: test; jnz then; jmp else")
	}
	if !termLowers(br, elseB, false, termJcc(true, x64.CC_NZ, thenB, none), false) {
		return fail("with the else-block next: test; jnz then, falling through")
	}
	if !termLowers(br, thenB, false, termJcc(true, x64.CC_Z, elseB, none), false) {
		return fail("with the then-block next: test; jz else, falling through")
	}
	return ""
}

// termFusedRow checks one fused compare: op on operands of type operand branches
// on cc to the then-block, and on inv, the condition that holds exactly when cc
// does not, to the else-block when the then-block is next.  Returns "" or the
// failing case.
func termFusedRow(op int, operand @types.Type, cc int, inv int) *[]readonly char {
	var f @ir.Func = termBlocks()
	var none @ir.Block
	var thenB @ir.Block = f.Blocks[0]
	var elseB @ir.Block = f.Blocks[1]
	var br @ir.Instr = termBranch(termCmp(op, operand), thenB, elseB)
	if !termLowers(br, none, true, termJcc(false, cc, thenB, elseB), true) {
		return "with no block laid out next: jcc then; jmp else"
	}
	if !termLowers(br, f.Blocks[2], true, termJcc(false, cc, thenB, elseB), true) {
		return "with neither arm next: jcc then; jmp else"
	}
	if !termLowers(br, elseB, true, termJcc(false, cc, thenB, none), false) {
		return "with the else-block next: jcc then, falling through"
	}
	if !termLowers(br, thenB, true, termJcc(false, inv, elseB, none), false) {
		return "with the then-block next: the inverted jcc to else, falling through"
	}
	return ""
}

// A branch on a fused integer compare jumps on the compare's flags, signed or
// unsigned, and with the then-block next on the inverted condition, for each of
// the six compares.
func TestEmitTermBranchOnFusedCompare() testing.TestResult {
	var ops @[]int = @[]int{iropcode.OP_EQ, iropcode.OP_NE, iropcode.OP_LT, iropcode.OP_LE,
			iropcode.OP_GT, iropcode.OP_GE}
	var signedCC @[]int = @[]int{x64.CC_E, x64.CC_NE, x64.CC_L, x64.CC_LE, x64.CC_G, x64.CC_GE}
	var signedInv @[]int = @[]int{x64.CC_NE, x64.CC_E, x64.CC_GE, x64.CC_G, x64.CC_LE, x64.CC_L}
	var unsignedCC @[]int = @[]int{x64.CC_E, x64.CC_NE, x64.CC_B, x64.CC_BE, x64.CC_A, x64.CC_AE}
	var unsignedInv @[]int = @[]int{x64.CC_NE, x64.CC_E, x64.CC_AE, x64.CC_A, x64.CC_BE, x64.CC_B}
	for i := 0; i < len(ops); i++ {
		var why *[]readonly char = termFusedRow(ops[i], types.TypInt(), signedCC[i], signedInv[i])
		if len(why) > 0 {
			return fail(buf.Concat(buf.Concat(iropcode.OpName(ops[i]), " signed, "), why))
		}
		why = termFusedRow(ops[i], types.TypUint(), unsignedCC[i], unsignedInv[i])
		if len(why) > 0 {
			return fail(buf.Concat(buf.Concat(iropcode.OpName(ops[i]), " unsigned, "), why))
		}
	}
	return ""
}

// A branch whose two arms are one block is, with a block laid out next, a jump
// to that block: nothing, falling through, when it is the block laid out next.
// With none laid out next it is lowered as any other branch.
func TestEmitTermBranchOneTarget() testing.TestResult {
	var f @ir.Func = termBlocks()
	var none @ir.Block
	var target @ir.Block = f.Blocks[0]
	var reg @ir.Instr = termBranch(termBool(), target, target)
	var fused @ir.Instr = termBranch(termCmp(iropcode.OP_LT, types.TypInt()), target, target)
	if !termLowers(reg, target, false, termJmp(none), false) ||
			!termLowers(fused, target, true, termJmp(none), false) {
		return fail("a branch to the block laid out next on both arms must emit nothing")
	}
	if !termLowers(reg, f.Blocks[2], false, termJmp(target), true) ||
			!termLowers(fused, f.Blocks[2], true, termJmp(target), true) {
		return fail("a branch to one block not laid out next must be a jmp to it")
	}
	if !termLowers(reg, none, false, termJcc(true, x64.CC_NZ, target, target), true) ||
			!termLowers(fused, none, true, termJcc(false, x64.CC_L, target, target), true) {
		return fail("with no block laid out next, a one-target branch keeps both jumps")
	}
	return ""
}

// termLowersAsInstr reports whether emitTerm, with next as the block laid out
// after ins's block, emits exactly what emitInstr does for ins, and reports a
// transfer.
func termLowersAsInstr(ins @ir.Instr, next @ir.Block, fused bool) bool {
	var want @asm.Assembler = termAsm()
	emitInstr(want, "main", termSym(), termRegMap(fused), nilStrings(), ins)
	return asm.HeldLen(want.Sections[0]) > 0 && termLowers(ins, next, fused, want, true)
}

// With no block laid out next, every terminator is lowered as emitInstr lowers it
// and ends in a transfer; a return or an unreachable is, whatever is laid out next.
func TestEmitTermWithoutNextLowersAsEmitInstr() testing.TestResult {
	var f @ir.Func = termBlocks()
	var none @ir.Block
	var thenB @ir.Block = f.Blocks[0]
	var elseB @ir.Block = f.Blocks[1]
	if !termLowersAsInstr(termJump(thenB), none, false) { return fail("a jump") }
	if !termLowersAsInstr(termBranch(termBool(), thenB, elseB), none, false) {
		return fail("a branch on a register")
	}
	if !termLowersAsInstr(termBranch(termCmp(iropcode.OP_GE, types.TypUint()), thenB, elseB), none,
			true) {
		return fail("a branch on a fused compare")
	}
	if !termLowersAsInstr(termBranch(termBool(), thenB, thenB), none, false) {
		return fail("a branch with one target")
	}
	var ret @ir.Instr = make(ir.Instr)
	ret.ID = -1
	ret.Op = iropcode.OP_RETURN
	var trap @ir.Instr = make(ir.Instr)
	trap.ID = -1
	trap.Op = iropcode.OP_UNREACHABLE
	if !termLowersAsInstr(ret, none, false) || !termLowersAsInstr(ret, thenB, false) {
		return fail("a return")
	}
	if !termLowersAsInstr(trap, none, false) || !termLowersAsInstr(trap, thenB, false) {
		return fail("an unreachable")
	}
	return ""
}
