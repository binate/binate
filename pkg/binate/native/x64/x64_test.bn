package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/bootstrap"
import "pkg/builtins/testing"

// Tests for amd64.bn — EmitObject end-to-end.  Per-function
// emit/prologue/epilogue tests live in amd64_emit_func_test.bn.

// fail builds a @[]char failure message from a raw char-slice.
func fail(msg *[]readonly char) testing.TestResult {
	var r @[]char
	if len(msg) == 0 { return r }
	var out @[]char = make_slice(char, len(msg))
	for i := 0; i < len(msg); i++ { out[i] = msg[i] }
	return out
}

// Phase 3a: EmitObject succeeds for an empty module — produces a
// valid ELF object containing nothing but the section headers.
// (Modules with functions are exercised by TestEmitObjectEmptyMain
// below.)
func TestEmitObjectEmptyModuleSucceeds() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	if !EmitObject(m, "elf", "/tmp/binate_x64_phase3a_empty.o") {
		return fail("Phase 3a EmitObject should succeed for empty module")
	}
	return ""
}

// firstByte returns byte 0 of the file at path (0xFF sentinel on a
// read failure, which matches no object-file magic).
func firstByte(path *[]readonly char) uint8 {
	var fd int = bootstrap.Open(path, bootstrap.O_RDONLY)
	if fd < 0 { return cast(uint8, 0xFF) }
	var buf @[]uint8 = make_slice(uint8, 4)
	var n int = bootstrap.Read(fd, buf)
	bootstrap.Close(fd)
	if n < 1 { return cast(uint8, 0xFF) }
	return buf[0]
}

// Phase 2 of plan-backend-objformat-decoupling.md: the `format` arg
// selects the object-file writer.  Emitting the same module as "elf"
// vs "macho" must produce files with the corresponding magic byte —
// ELF starts 0x7F 'E' 'L' 'F'; 64-bit Mach-O starts with MH_MAGIC_64
// (0xFEEDFACF), little-endian byte 0 = 0xCF.  (The Mach-O object's
// symbols still lack the leading-'_' prefix until Phase 3, but the
// header — and thus this magic-byte check — is independent of that.)
func TestEmitObjectFormatSelectsWriter() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var elfPath *[]readonly char = "/tmp/binate_x64_fmt_elf.o"
	if !EmitObject(m, "elf", elfPath) {
		return fail("format=elf EmitObject should succeed")
	}
	if firstByte(elfPath) != cast(uint8, 0x7F) {
		return fail("format=elf should emit an ELF object (magic 0x7F)")
	}
	var machoPath *[]readonly char = "/tmp/binate_x64_fmt_macho.o"
	if !EmitObject(m, "macho", machoPath) {
		return fail("format=macho EmitObject should succeed")
	}
	if firstByte(machoPath) != cast(uint8, 0xCF) {
		return fail("format=macho should emit a Mach-O object (magic 0xCF)")
	}
	return ""
}

// emitStringTable emits each interned string as a read-only byte blob —
// EXACTLY its bytes, no NUL terminator — with a `Lstr_<id>` label, in the
// rodata section.  Without the label, OP_CONST_STRING's RIP-relative LEA fixup
// would fail at resolve time.
func TestEmitStringTableDefinesLabels() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	var strings @[]ir.StringConst = make_slice(ir.StringConst, 1)
	strings[0].ID = 5
	strings[0].Data = "hi"
	strings[0].Len = 2
	emitStringTable(a, strings)
	// The blob is reloc-free, so it lands in rodata — exactly "hi" = 2 bytes,
	// with NO trailing NUL (Binate strings are length-prefixed).
	var ri int = -1
	for i := 0; i < a.NumSections; i++ {
		if charsEqual(a.Sections[i].Name, "rodata") { ri = i }
	}
	if ri < 0 { return fail("string blob should land in a rodata section") }
	if a.Sections[ri].Len != 2 {
		return fail("string blob should be exactly 2 bytes (no NUL)")
	}
	// LookupSymbol returns -1 if the label isn't defined.
	if a.LookupSymbol("Lstr_5") < 0 {
		return fail("Lstr_5 label should be defined in symbol table")
	}
	return ""
}

func TestEmitStringTableEmptyNoOp() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var empty @[]ir.StringConst
	emitStringTable(a, empty)
	if a.Sections[0].Len != 0 {
		return fail("empty string table should emit nothing")
	}
	return ""
}

// emitGlobals defines each global's mangled symbol and zero-fills
// its byte payload in the data section.  Use-site RIP-relative
// LEAs (emitGlobalAddr) reach this symbol via R_X86_64_PC32
// cross-section relocs.
func TestEmitGlobalsZerofills() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var g @ir.Global = make(ir.Global)
	g.Name = "myvar"
	g.Typ = types.TypInt()
	var globals @[]@ir.Global = make_slice(@ir.Global, 1)
	globals[0] = g
	emitGlobals(a, "main", globals)
	// Symbol should be defined.
	if a.LookupSymbol("bn_G1_4_main1_5_myvar") < 0 {
		return fail("bn_G1_4_main1_5_myvar should be defined as a global")
	}
	return ""
}

func TestEmitGlobalsEmptyNoOp() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var empty @[]@ir.Global
	emitGlobals(a, "main", empty)
	// No data section should be created, no symbols added.
	if a.LookupSymbol("bn_G1_4_main1_5_myvar") >= 0 {
		return fail("empty globals should add no symbols")
	}
	return ""
}

// An imported extern var (IsExtern — a `.bni`-declared `var X T` from
// another package) must NOT be defined here: its owning package's object
// file provides the definition, so a definition here would be a duplicate
// symbol at link time.  The package's own global is still defined.
func TestEmitGlobalsSkipsExtern() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var own @ir.Global = make(ir.Global)
	own.Name = "ownvar"
	own.Typ = types.TypInt()
	var ext @ir.Global = make(ir.Global)
	ext.Name = "pkg/other.theirvar"
	ext.Typ = types.TypInt()
	ext.IsExtern = true
	var globals @[]@ir.Global = make_slice(@ir.Global, 2)
	globals[0] = own
	globals[1] = ext
	emitGlobals(a, "main", globals)
	if a.LookupSymbol("bn_G1_4_main1_6_ownvar") < 0 {
		return fail("a package's own global must be defined")
	}
	if a.LookupSymbol("bn_G2_3_pkg5_other1_8_theirvar") >= 0 {
		return fail("an IsExtern global must NOT be defined (dup at link)")
	}
	return ""
}

// A module whose globals are ALL imported extern vars must not open the
// data section: emitGlobals defers SetSection until a real (non-extern)
// global is emitted, so no empty data section is left behind (an empty
// section becomes a malformed object at write time).  NumSections staying
// put proves nothing new was opened.
func TestEmitGlobalsAllExternNoDataSection() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var sectionsBefore int = a.NumSections
	var ext @ir.Global = make(ir.Global)
	ext.Name = "pkg/other.theirvar"
	ext.Typ = types.TypInt()
	ext.IsExtern = true
	var globals @[]@ir.Global = make_slice(@ir.Global, 1)
	globals[0] = ext
	emitGlobals(a, "main", globals)
	if a.NumSections != sectionsBefore {
		return fail("all-extern globals must not open an empty data section")
	}
	return ""
}

// Phase 3a: a module with a single non-extern function should
// produce a valid ELF with the function's prologue/epilogue.  This
// is the smoke test for the end-to-end pipeline — function gets a
// symbol, frame setup, ret.  Doesn't link or execute the object
// here; that's covered by the conformance runner.
func TestEmitObjectEmptyMain() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	// Add a single function `main.main()` with no params, no
	// results, an empty entry block — i.e. `func main() {}`.
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main.main", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	b.EmitReturn(noArgs)
	m.AddFunc(f)
	if !EmitObject(m, "elf", "/tmp/binate_x64_phase3a_main.o") {
		return fail("Phase 3a EmitObject should succeed for empty-body func")
	}
	return ""
}

// fileContainsStr reads up to 64 KB of the file at path and reports
// whether `needle` appears in those bytes.  Tiny single-function
// objects fit well under the cap.
func fileContainsStr(path *[]readonly char, needle *[]readonly char) bool {
	var fd int = bootstrap.Open(path, bootstrap.O_RDONLY)
	if fd < 0 { return false }
	var data @[]uint8 = make_slice(uint8, 65536)
	var n int = bootstrap.Read(fd, data)
	bootstrap.Close(fd)
	var nl int = len(needle)
	if nl == 0 { return true }
	for i := 0; i + nl <= n; i++ {
		var match bool = true
		for j := 0; j < nl; j++ {
			if data[i + j] != cast(uint8, needle[j]) {
				match = false
				break
			}
		}
		if match { return true }
	}
	return false
}

// buildMainFoo returns a module "main" with a single empty function
// `main.foo` — emits the symbol bn_F1_4_main1_3_foo (or
// _bn_F1_4_main1_3_foo under Mach-O linkage).
func buildMainFoo() @ir.Module {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var noArgs @[]@ir.Instr
	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func = ir.NewFunc("", "main.foo", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	b.EmitReturn(noArgs)
	m.AddFunc(f)
	return m
}

// Phase 3 of plan-backend-objformat-decoupling.md: the symbol-prefix
// half is now format-driven too.  format=macho prepends the '_'
// C-linkage prefix to every symbol; format=elf leaves them bare.
func TestMachoSymbolsArePrefixed() testing.TestResult {
	var mp *[]readonly char = "/tmp/binate_x64_symprefix_macho.o"
	if !EmitObject(buildMainFoo(), "macho", mp) {
		return fail("macho EmitObject should succeed")
	}
	if !fileContainsStr(mp, "_bn_F1_4_main1_3_foo") {
		return fail("macho symbols should carry the '_' prefix (_bn_F1_4_main1_3_foo)")
	}

	var ep *[]readonly char = "/tmp/binate_x64_symprefix_elf.o"
	if !EmitObject(buildMainFoo(), "elf", ep) {
		return fail("elf EmitObject should succeed")
	}
	if fileContainsStr(ep, "_bn_F1_4_main1_3_foo") {
		return fail("elf symbols must not carry a leading '_'")
	}
	if !fileContainsStr(ep, "bn_F1_4_main1_3_foo") {
		return fail("elf object should contain the bare symbol bn_F1_4_main1_3_foo")
	}
	return ""
}
