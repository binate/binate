package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/native/common"

// Per-type RTTI (`__typeinfo.<T>`) record emission for the x64 backend.  The
// record's layout is laid by the shared irdata.BuildTypeInfo; this gathers the
// object-format-prefixed symbols (its own symbol, and the word-0 destructor
// handle via the same dtorSlotSym_x64 the vtable any-block slot 0 uses) and
// lowers each record through common.EmitDataGlobal.  The vtable any-block slot
// 1 references these records (spec §7.13.8 / §7.13.14).

// emitTypeInfosNative_x64 emits one weak `__typeinfo.<T>` RTTI record per
// distinct boxable receiver type (ir.CollectTypeInfoDescs), object-format
// prefixed.  The record's address is the type's identity; word 0 carries the
// destructor handle (byte-identical to the vtable any-block slot 0).  Weak
// linkage coalesces the same type emitted from several TUs.
func emitTypeInfosNative_x64(a @asm.Assembler, pkgName *[]readonly char, mod @ir.Module) {
	var descs @[]@irdata.TypeInfoDesc = ir.CollectTypeInfoDescs(mod)
	for i := 0; i < len(descs); i++ {
		var pd @irdata.TypeInfoDesc = make(irdata.TypeInfoDesc)
		pd.Sym = symPrefixed(descs[i].Sym)
		pd.Size = descs[i].Size
		pd.Align = descs[i].Align
		// Word 0's dtor handle uses the same helper as the vtable any-block
		// slot 0 (dtorSlotSym_x64), so the record's dtor word is byte-identical
		// to that slot.
		pd.DtorSym = dtorSlotSym_x64(pkgName, mod, descs[i].DtorFuncName)
		// Name is the blob CONTENT (a string, unprefixed); NameSym is the blob
		// SYMBOL (object-format prefixed, like Sym).
		pd.Name = descs[i].Name
		pd.NameSym = symPrefixed(descs[i].NameSym)
		var dgs @[]@irdata.DataGlobal = irdata.BuildTypeInfo(pd)
		for j := 0; j < len(dgs); j++ {
			common.EmitDataGlobal(a, dgs[j])
		}
	}
}

// emitIfaceIdsNative_x64 emits one weak `__ifaceid.<J>` 1-byte marker per
// canonical interface (ir.CollectIfaceIdSyms), object-format prefixed.  Only the
// marker's address is meaningful (spec §11.12 `iface.rtti`); weak linkage
// coalesces the same interface emitted from several TUs.
func emitIfaceIdsNative_x64(a @asm.Assembler, mod @ir.Module) {
	var syms @[]@[]char = ir.CollectIfaceIdSyms(mod)
	for i := 0; i < len(syms); i++ {
		common.EmitDataGlobal(a, irdata.BuildIfaceId(symPrefixed(syms[i])))
	}
}

// emitSatEntriesNative_x64 emits one weak `__satentry.<T,J>` record (plus its two
// symbol-name blobs) per (T, J) in mod.Impls (ir.CollectSatEntries), object-format
// prefixed — the distributed interface-satisfaction registry (spec §11.12
// `iface.rtti`).  Each records `{&TypeInfo(T), &IfaceId(J), &__ivt.<T>__<J>}` then
// the cross-mode TypeSym/IfaceSym names.  Every SYMBOL (its own, the three
// referents, and the two blob symbols) goes through symPrefixed, matching def+ref;
// the blob CONTENT strings (TypeSymStr/IfaceSymStr) stay neutral.
func emitSatEntriesNative_x64(a @asm.Assembler, mod @ir.Module) {
	var descs @[]@irdata.SatEntryDesc = ir.CollectSatEntries(mod)
	for i := 0; i < len(descs); i++ {
		var pd @irdata.SatEntryDesc = make(irdata.SatEntryDesc)
		pd.Sym = symPrefixed(descs[i].Sym)
		pd.TypeInfoSym = symPrefixed(descs[i].TypeInfoSym)
		pd.IfaceIdSym = symPrefixed(descs[i].IfaceIdSym)
		pd.SubvtabSym = symPrefixed(descs[i].SubvtabSym)
		pd.TypeSymStr = descs[i].TypeSymStr
		pd.TypeSymBlobSym = symPrefixed(descs[i].TypeSymBlobSym)
		pd.IfaceSymStr = descs[i].IfaceSymStr
		pd.IfaceSymBlobSym = symPrefixed(descs[i].IfaceSymBlobSym)
		var dgs @[]@irdata.DataGlobal = irdata.BuildSatEntry(common.STATIC_MANAGED_REFCOUNT, pd)
		for j := 0; j < len(dgs); j++ {
			common.EmitDataGlobal(a, dgs[j])
		}
	}
}
