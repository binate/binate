package "pkg/binate/native/x64"

import "pkg/binate/asm"
import "pkg/binate/ir"
import "pkg/builtins/testing"

// Tests for per-type RTTI record emission (x64_typeinfo.bn:
// emitTypeInfosNative_x64) — the x64 counterpart to
// aarch64_typeinfo_test.bn.  genFromSrcX64 / relroBytesX64 are shared helpers
// from x64_iface_vtable_test.bn (same package).  The record's exact byte layout
// is covered on the LLVM side (emit_impls_test.bn); here we pin the
// native-specific behavior via section placement: the 40-byte record carries a
// name pointer (and, for a type that needs destruction, a dtor handle) plus a
// struct's field-table pointer, so it bears relocations and lands in
// "rodata_relro" — as does the field-table blob (its field name pointers are
// relocations) — while the reloc-free name / field-name blobs land in plain
// "rodata".

// rodataBytesX64 returns the byte count of the plain read-only "rodata" section
// (reloc-free blobs — e.g. the TypeInfo name blob); 0 if none was emitted.
// Sibling of relroBytesX64.
func rodataBytesX64(a @asm.Assembler) int {
	for i := 0; i < a.NumSections; i++ {
		if charsEqual(a.Sections[i].Name, "rodata") {
			return a.Sections[i].Len
		}
	}
	return 0
}

// A boxable type's 40-byte record bears a name-pointer relocation, so it lands
// in "rodata_relro"; the reloc-free name blob lands in plain "rodata".
func TestX64TypeInfoRecordInRelroWithNameBlob() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() }\n"
			"type T struct { x int }\n"
			"func (t *T) foo() { }\n"
			"impl *T : I\n"
			"func main() { }\n"
	var mod @ir.Module = genFromSrcX64(src)
	var a @asm.Assembler = asm.New(8)
	emitTypeInfosNative_x64(a, "main", mod)
	if relroBytesX64(a) != 112 {
		return "the TypeInfo record (64 bytes) plus its field-table blob (48 bytes, "
				"for the one-field struct) — both bearing relocations — should land in "
				"rodata_relro"
	}
	// The name blob is reloc-free → rodata (non-empty: the type has a name).
	if rodataBytesX64(a) == 0 {
		return "the TypeInfo name blob should land in rodata (a non-empty name)"
	}
	return ""
}

// A type that needs destruction (a managed `@Inner` field) additionally carries
// a word-0 dtor-handle relocation, but the record is still one 40-byte relro
// global with its name blob in rodata.
func TestX64TypeInfoDtorRecordInRelro() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() int }\n"
			"type Inner struct { V int }\n"
			"type T struct { Inner @Inner }\n"
			"func (t *T) foo() int { return t.Inner.V }\n"
			"impl *T : I\n"
			"func main() { }\n"
	var mod @ir.Module = genFromSrcX64(src)
	var a @asm.Assembler = asm.New(8)
	emitTypeInfosNative_x64(a, "main", mod)
	if relroBytesX64(a) != 112 {
		return "a managed-field type's TypeInfo record (64 bytes; name + dtor + "
				"fields relocations) plus its field-table blob (48 bytes) should be 112 "
				"bytes in rodata_relro"
	}
	if rodataBytesX64(a) == 0 {
		return "the TypeInfo name blob should land in rodata"
	}
	return ""
}

// emitIfaceIdsNative_x64 emits a weak 1-byte `__ifaceid.<J>` marker per canonical
// interface into plain rodata (reloc-free — only the address matters); nothing
// lands in relro.
func TestX64IfaceIdNativeMarker() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() }\n"
			"type T struct { x int }\n"
			"func (t *T) foo() { }\n"
			"impl *T : I\n"
			"func main() { }\n"
	var mod @ir.Module = genFromSrcX64(src)
	var a @asm.Assembler = asm.New(8)
	emitIfaceIdsNative_x64(a, mod)
	// Compute the expected symbol through the same object-format prefix the
	// emitter applies, so the check is format-agnostic (Mach-O `_` / ELF none).
	if findSymbolByNameX64(a, symPrefixed("__ifaceid.bn_S1_4_main1_1_I")) < 0 {
		return "expected the __ifaceid marker symbol for interface I"
	}
	if rodataBytesX64(a) == 0 {
		return "IfaceId markers should land in rodata"
	}
	if relroBytesX64(a) != 0 {
		return "IfaceId markers are reloc-free (nothing in rodata_relro)"
	}
	return ""
}

// emitSatEntriesNative_x64 emits one weak `__satentry.<T,J>` record per (T, J) in
// m.Impls: a 72-byte node (2-word header + 3 payload symrefs + 2 {data,len}
// symbol-name slices → all relro, since the slices' data words are symrefs) plus
// two reloc-free symbol-name blobs in plain rodata.  For a non-extending
// `impl *T : I` there is one entry.
func TestX64SatEntryNative() testing.TestResult {
	var src *[]readonly char = "package \"main\"\n"
			"interface I { foo() }\n"
			"type T struct { x int }\n"
			"func (t *T) foo() { }\n"
			"impl *T : I\n"
			"func main() { }\n"
	var mod @ir.Module = genFromSrcX64(src)
	var a @asm.Assembler = asm.New(8)
	emitSatEntriesNative_x64(a, mod)
	if findSymbolByNameX64(a, symPrefixed("__satentry.bn_V1_4_main1_T1_4_main1_I")) < 0 {
		return "expected the __satentry symbol for (T,I)"
	}
	if relroBytesX64(a) != 72 {
		return "one (T,I) satisfaction-entry node (header + 3 payload symrefs + "
				"2 sym-name slices) should be 72 bytes in rodata_relro"
	}
	if rodataBytesX64(a) == 0 {
		return "the two symbol-name blobs (TypeSym/IfaceSym) should land in plain rodata"
	}
	return ""
}

// findSymbolByNameX64 returns the symbol-table index of `name`, or -1 if absent
// (x64 counterpart to aarch64's findSymbolByNameIface).
func findSymbolByNameX64(a @asm.Assembler, name *[]readonly char) int {
	for i := 0; i < a.NumSymbols; i++ {
		if charsEqual(a.Symbols[i].Name, name) { return i }
	}
	return -1
}
