// Package optflags registers the per-pass optimization switches (-f<pass> /
// -fno-<pass>, one pair per iropt pass) on a command-line FlagSet and applies
// the parsed switches to an iropt.OptConfig.  Shared by bnc and bni so both
// spell the switches identically.
package "pkg/binate/optflags"

import "pkg/binate/iropt"
import "pkg/std/flags"

// PassFlags holds the parsed state of every pass's -f / -fno switch, indexed by
// iropt PASS_* value.  Obtain one from Register; read it with Apply after Parse.
type PassFlags struct {
	on  @[]bool
	off @[]bool
}

// Register adds -f<name> and -fno-<name> for every iropt pass to fs and
// returns the PassFlags they are bound to.
func Register(fs @flags.FlagSet) @PassFlags

// Apply returns c with each pass given -f<name> switched on and each given
// -fno-<name> switched off, plus an error message ("" on success): naming the
// same pass in both is an error.
func Apply(pf @PassFlags, c iropt.OptConfig) (iropt.OptConfig, @[]readonly char)

// PassList renders one line per iropt pass (its name), in pipeline order — the
// text of a tool's --list-opt-passes.
func PassList() @[]char
