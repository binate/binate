package "pkg/binate/optflags"

import "pkg/binate/buf"
import "pkg/binate/iropt"
import "pkg/std/flags"

// Register adds -f<name> / -fno-<name> for every iropt pass to fs.  The bound
// bools are elements of pf's slices, which pf keeps alive past Parse.
func Register(fs @flags.FlagSet) @PassFlags {
	var pf @PassFlags = make(PassFlags)
	pf.on = make_slice(bool, iropt.NUM_OPT_PASSES)
	pf.off = make_slice(bool, iropt.NUM_OPT_PASSES)
	for p := 0; p < iropt.NUM_OPT_PASSES; p++ {
		var name *[]readonly char = iropt.OptPassName(p)
		fs.BoolVar(&pf.on[p], buf.Concat("f", name), "",
				buf.Concat("run the IR optimization pass ", name))
		fs.BoolVar(&pf.off[p], buf.Concat("fno-", name), "",
				buf.Concat("skip the IR optimization pass ", name))
	}
	return pf
}

// Apply switches c's passes per the parsed -f / -fno flags.
func Apply(pf @PassFlags, c iropt.OptConfig) (iropt.OptConfig, @[]readonly char) {
	for p := 0; p < iropt.NUM_OPT_PASSES; p++ {
		if pf.on[p] && pf.off[p] {
			var both @[]char = buf.Concat("both -f", iropt.OptPassName(p))
			both = buf.Concat(both, " and -fno-")
			both = buf.Concat(both, iropt.OptPassName(p))
			return c, buf.Concat(both, " given")
		}
		if pf.on[p] {
			c = iropt.WithOptPass(c, p, true)
		} else if pf.off[p] {
			c = iropt.WithOptPass(c, p, false)
		}
	}
	return c, ""
}

// PassList renders the pass names, one per line, in pipeline order.
func PassList() @[]char {
	var out @[]char
	for p := 0; p < iropt.NUM_OPT_PASSES; p++ {
		out = buf.Concat(out, iropt.OptPassName(p))
		out = buf.Concat(out, "\n")
	}
	return out
}
