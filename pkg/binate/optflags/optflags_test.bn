package "pkg/binate/optflags"

import "pkg/binate/buf"
import "pkg/binate/iropt"
import "pkg/builtins/testing"
import "pkg/std/flags"

// parse registers the pass flags on a fresh FlagSet, parses args, and applies
// them to the -O<level> config.
func parse(args @[]@[]char, level int) (iropt.OptConfig, @[]readonly char) {
	var fs @flags.FlagSet = flags.New("t")
	var pf @PassFlags = Register(fs)
	var perr @[]readonly char
	_, perr = fs.Parse(args)
	if len(perr) > 0 {
		return iropt.LevelOptConfig(level), perr
	}
	return Apply(pf, iropt.LevelOptConfig(level))
}

func TestApplyNoFlagsKeepsLevel() testing.TestResult {
	var c iropt.OptConfig
	var err @[]readonly char
	c, err = parse(@[]@[]char{}, 2)
	if len(err) > 0 { return "unexpected error" }
	if c.Passes != iropt.LevelOptConfig(2).Passes { return "no flags must keep -O2's passes" }
	return ""
}

func TestApplyEveryPassBothWays() testing.TestResult {
	for p := 0; p < iropt.NUM_OPT_PASSES; p++ {
		var name *[]readonly char = iropt.OptPassName(p)
		var on @[]char = buf.Concat("-f", name)
		var off @[]char = buf.Concat("-fno-", name)
		var c iropt.OptConfig
		var err @[]readonly char
		c, err = parse(@[]@[]char{on}, 0)
		if len(err) > 0 || c.Passes != iropt.WithOptPass(iropt.LevelOptConfig(0), p, true).Passes {
			return "-f<pass> at -O0 must enable exactly that pass"
		}
		c, err = parse(@[]@[]char{off}, 1)
		if len(err) > 0 || c.Passes != iropt.WithOptPass(iropt.LevelOptConfig(1), p, false).Passes {
			return "-fno-<pass> at -O1 must disable exactly that pass"
		}
		c, err = parse(@[]@[]char{on, off}, 1)
		if len(err) == 0 { return "-f<pass> with -fno-<pass> must be an error" }
	}
	return ""
}

func TestPassListNamesEveryPass() testing.TestResult {
	var list @[]char = PassList()
	var lines int = 0
	for i := 0; i < len(list); i++ {
		if list[i] == '\n' { lines = lines + 1 }
	}
	if lines != iropt.NUM_OPT_PASSES { return "PassList must have one line per pass" }
	return ""
}
