// Package parser parses Binate source code into an abstract syntax tree.
// Supports both .bn implementation files and .bni interface files.
package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/lexer"
import "pkg/binate/token"

// Parser parses Binate source code into an AST.
type Parser struct {
	lex  @lexer.Lexer
	tok  token.Token
	prev token.Token
	// peek holds a one-token lookahead. peekTok() pulls a token from
	// the lexer and stashes it here; the next next(p) call drains it
	// before pulling a fresh one. Used by parsePrimaryExpr to merge
	// adjacent string literals across an ASI-inserted semicolon
	// without committing to consuming the SEMI before knowing what
	// follows.
	peek    token.Token
	hasPeek bool
	// peek2 holds a second-token lookahead, valid only when hasPeek is
	// also set. peekTok2() stashes it here; next(p) shifts peek2 into
	// peek when draining. Used by D11 type-decl disambiguation (`type
	// Row [3]int` array vs. `type List[T any]` generic) to inspect the
	// two tokens after `[` without consuming any.
	peek2    token.Token
	hasPeek2 bool
	errs @[]ParseError

	noCompositeLit bool
	interfaceFile  bool
}

// ParseError records a single syntax error with its source position.
type ParseError struct {
	Pos token.Pos
	Msg @[]char
}

// New creates a parser for source code.
func New(src *[]uint8, file *[]readonly char) @Parser

// NewInterface creates a parser for a .bni interface file.
func NewInterface(src *[]uint8, file *[]readonly char) @Parser

// NewCollecting is New with comment retention: comments are surfaced on
// File.Comments by ParseFile, for tooling that formats whole files.  The
// sub-file REPL entry points (ParseExpr / ParseStmtList / ParseTopLevelDecl)
// do not expose comments -- comment collection is a ParseFile-level facility.
func NewCollecting(src *[]uint8, file *[]readonly char) @Parser

// NewInterfaceCollecting is NewInterface with comment retention (a formatter
// formats .bni interface files too).
func NewInterfaceCollecting(src *[]uint8, file *[]readonly char) @Parser

// ParseFile parses a complete source file.
func (p @Parser) ParseFile() @ast.File

// ParseExpr parses a single expression from the parser's current
// position.  REPL entry point for bare-expression input.
func (p @Parser) ParseExpr() @ast.Expr

// ParseTopLevelDecl parses a single top-level declaration (func,
// type, var, or const).  REPL entry point for Tier 2 (decl input
// at the prompt).  Returns nil if the current token isn't one of
// the four decl-leading keywords; the parser appends an error.
func (p @Parser) ParseTopLevelDecl() @ast.Decl

// IsAtTopLevelDecl returns true if the parser's current token is
// `func`, `type`, `var`, or `const`.  REPL dispatch helper: lets
// the prompt choose between ParseTopLevelDecl and ParseStmtList.
func (p @Parser) IsAtTopLevelDecl() bool

// IsAtImport returns true if the parser's current token is
// `import`.  Tier 5 REPL dispatch helper: routes the prompt to
// ParseImportDecl when set.
func (p @Parser) IsAtImport() bool

// ParseImportDecl parses a single or grouped import declaration
// from the prompt: `import "pkg/foo"` or `import ( ... )`.
// REPL entry point for Tier 5 (mid-session imports).
func (p @Parser) ParseImportDecl() @[]@ast.ImportSpec

// ParseStmtList parses statements until EOF.  REPL entry point for
// bare-statement-list input.
func (p @Parser) ParseStmtList() @[]@ast.Stmt

// Errors returns the list of parse errors.
func (p @Parser) Errors() @[]ParseError
