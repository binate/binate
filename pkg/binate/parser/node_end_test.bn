package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/builtins/testing"

// Tests for AST-node End positions (source spans).  spanOK plus the walk*
// helpers assert the invariant that every parser-produced Stmt/Decl/TypeExpr
// carries a stamped, non-backwards End -- guarding against the zero-End
// ({Line:0}) that unstamped nested nodes would otherwise ship.  Expr has no
// End yet (deferred), so it is walked only to reach nested TypeExprs.

// spanOK reports whether [pos, end) is a valid forward span with a stamped
// (1-based) end line: End is not the zero value and not before Pos.
func spanOK(pos token.Pos, end token.Pos) bool {
	if end.Line < 1 {
		return false
	}
	if end.Line > pos.Line {
		return true
	}
	return end.Line == pos.Line && end.Col >= pos.Col
}

// walkType asserts spanOK on te and recurses into every nested TypeExpr.
func walkType(te @ast.TypeExpr) testing.TestResult {
	if te == nil {
		return ""
	}
	if !spanOK(te.Pos, te.End) {
		return fail("bad TypeExpr End", ast.TypeExprKindName(te.Kind))
	}
	var r testing.TestResult
	r = walkType(te.Base)
	if len(r) > 0 { return r }
	r = walkExpr(te.Len)
	if len(r) > 0 { return r }
	for i := 0; i < len(te.Fields); i++ {
		r = walkType(te.Fields[i].Type)
		if len(r) > 0 { return r }
	}
	for i := 0; i < len(te.ParamTypes); i++ {
		r = walkType(te.ParamTypes[i])
		if len(r) > 0 { return r }
	}
	for i := 0; i < len(te.ResultTypes); i++ {
		r = walkType(te.ResultTypes[i])
		if len(r) > 0 { return r }
	}
	for i := 0; i < len(te.TypeArgs); i++ {
		r = walkType(te.TypeArgs[i])
		if len(r) > 0 { return r }
	}
	return ""
}

// walkExpr recurses an expression to reach nested TypeExprs.  Expr itself has
// no End (deferred), and a func-literal's synthetic DeclRef / body is walked
// with Expr.End too, so e.DeclRef is not descended here.
func walkExpr(e @ast.Expr) testing.TestResult {
	if e == nil {
		return ""
	}
	var r testing.TestResult
	r = walkExpr(e.X)
	if len(r) > 0 { return r }
	r = walkExpr(e.Y)
	if len(r) > 0 { return r }
	r = walkExpr(e.Z)
	if len(r) > 0 { return r }
	for i := 0; i < len(e.Args); i++ {
		r = walkExpr(e.Args[i])
		if len(r) > 0 { return r }
	}
	r = walkType(e.TypeRef)
	if len(r) > 0 { return r }
	for i := 0; i < len(e.Elems); i++ {
		r = walkExpr(e.Elems[i].Key)
		if len(r) > 0 { return r }
		r = walkExpr(e.Elems[i].Value)
		if len(r) > 0 { return r }
	}
	return ""
}

// walkDecl asserts spanOK on d and recurses into its types, value, body, and
// grouped/interface members.
func walkDecl(d @ast.Decl) testing.TestResult {
	if d == nil {
		return ""
	}
	if !spanOK(d.Pos, d.End) {
		return fail("bad Decl End", ast.DeclKindName(d.Kind))
	}
	var r testing.TestResult
	r = walkType(d.TypeRef)
	if len(r) > 0 { return r }
	r = walkExpr(d.Value)
	if len(r) > 0 { return r }
	if d.Recv != nil {
		r = walkType(d.Recv.Type)
		if len(r) > 0 { return r }
	}
	for i := 0; i < len(d.TypeParams); i++ {
		r = walkType(d.TypeParams[i].Constraint)
		if len(r) > 0 { return r }
	}
	for i := 0; i < len(d.Params); i++ {
		r = walkType(d.Params[i].Type)
		if len(r) > 0 { return r }
	}
	for i := 0; i < len(d.Results); i++ {
		r = walkType(d.Results[i])
		if len(r) > 0 { return r }
	}
	r = walkStmt(d.Body)
	if len(r) > 0 { return r }
	for i := 0; i < len(d.Decls); i++ {
		r = walkDecl(d.Decls[i])
		if len(r) > 0 { return r }
	}
	for i := 0; i < len(d.Interfaces); i++ {
		r = walkType(d.Interfaces[i])
		if len(r) > 0 { return r }
	}
	return ""
}

// walkStmt asserts spanOK on s and recurses into sub-statements, expressions,
// and any declaration it carries.
func walkStmt(s @ast.Stmt) testing.TestResult {
	if s == nil {
		return ""
	}
	if !spanOK(s.Pos, s.End) {
		return fail("bad Stmt End", ast.StmtKindName(s.Kind))
	}
	var r testing.TestResult
	for i := 0; i < len(s.Stmts); i++ {
		r = walkStmt(s.Stmts[i])
		if len(r) > 0 { return r }
	}
	for i := 0; i < len(s.Exprs); i++ {
		r = walkExpr(s.Exprs[i])
		if len(r) > 0 { return r }
	}
	for i := 0; i < len(s.Exprs2); i++ {
		r = walkExpr(s.Exprs2[i])
		if len(r) > 0 { return r }
	}
	r = walkExpr(s.X)
	if len(r) > 0 { return r }
	r = walkStmt(s.Body)
	if len(r) > 0 { return r }
	r = walkStmt(s.Else)
	if len(r) > 0 { return r }
	r = walkStmt(s.Init)
	if len(r) > 0 { return r }
	r = walkStmt(s.Post)
	if len(r) > 0 { return r }
	r = walkExpr(s.ForKey)
	if len(r) > 0 { return r }
	r = walkExpr(s.ForVal)
	if len(r) > 0 { return r }
	for i := 0; i < len(s.Cases); i++ {
		for j := 0; j < len(s.Cases[i].Exprs); j++ {
			r = walkExpr(s.Cases[i].Exprs[j])
			if len(r) > 0 { return r }
		}
		for j := 0; j < len(s.Cases[i].Body); j++ {
			r = walkStmt(s.Cases[i].Body[j])
			if len(r) > 0 { return r }
		}
	}
	r = walkDecl(s.DeclRef)
	if len(r) > 0 { return r }
	return ""
}

// TestNodeEndSpansValid parses a file exercising grouped decls, an interface
// with methods, a struct with an embed and named fields, a generic-
// instantiation type, composite literals, and control flow, then walks the
// whole tree asserting every Stmt/Decl/TypeExpr has a valid span.  This is the
// invariant guard against any unstamped (zero-End) or backwards-span node.
func TestNodeEndSpansValid() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"type Pair struct {\n"
		"\tBase\n"
		"\tkey int\n"
		"\tvals @[]char\n"
		"}\n"
		"type (\n"
		"\tA int\n"
		"\tB @[]int\n"
		")\n"
		"const (\n"
		"\tX = 1\n"
		"\tY = 2\n"
		")\n"
		"var (\n"
		"\ta int\n"
		"\tb *int = nil\n"
		")\n"
		"interface Shape {\n"
		"\tArea() int\n"
		"\tName() @[]char\n"
		"}\n"
		"func g(m Map[int, char]) int {\n"
		"\treturn 0\n"
		"}\n"
		"func h(cb *func(int) int, arr [3]int, q pkg.T) int {\n"
		"\treturn 0\n"
		"}\n"
		"func f(x int) int {\n"
		"\tvar local int = 5\n"
		"\tif x > 0 {\n"
		"\t\treturn 1\n"
		"\t} else if x < 0 {\n"
		"\t\treturn 2\n"
		"\t}\n"
		"\tswitch x {\n"
		"\tcase 1:\n"
		"\t\tlocal = 1\n"
		"\tdefault:\n"
		"\t\tlocal = 0\n"
		"\t}\n"
		"\tvar v @[]int = @[]int{1, 2, 3}\n"
		"\tfor i := 0; i < x; i++ {\n"
		"\t\tlocal = local + i\n"
		"\t}\n"
		"\treturn local\n"
		"}\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 {
		return fail("TestNodeEndSpansValid parse", p.Errors()[0].Msg)
	}
	for i := 0; i < len(f.Decls); i++ {
		var r testing.TestResult = walkDecl(f.Decls[i])
		if len(r) > 0 {
			return r
		}
	}
	return ""
}

// Grouped-decl members carry their own valid span, not just the group node.
func TestGroupMemberEnd() testing.TestResult {
	var p @Parser = mkParser("var ( a int; bb int )")
	var d @ast.Decl = parseTopLevelDecl(p)
	if d.Kind != ast.DECL_GROUP {
		return fail("TestGroupMemberEnd", "expected DECL_GROUP")
	}
	if len(d.Decls) != 2 {
		return fail("TestGroupMemberEnd", "expected 2 members")
	}
	for i := 0; i < len(d.Decls); i++ {
		if !spanOK(d.Decls[i].Pos, d.Decls[i].End) {
			return fail("TestGroupMemberEnd", "member has zero/backwards End")
		}
	}
	return ""
}

// A generic instantiation's Base (the head, built off the parseType path) has
// a valid span, not the zero Pos.  `Vec[int]`: head `Vec` ends at 1:4.
func TestInstantiationBaseEnd() testing.TestResult {
	var p @Parser = mkParser("Vec[int]")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_INSTANTIATE {
		return fail("TestInstantiationBaseEnd", "expected TEXPR_INSTANTIATE")
	}
	if te.Base == nil || !spanOK(te.Base.Pos, te.Base.End) {
		return fail("TestInstantiationBaseEnd", "Base head has zero/backwards End")
	}
	if te.Base.End.Line != 1 || te.Base.End.Col != 4 {
		return fail("TestInstantiationBaseEnd", "wrong Base End (want 1:4)")
	}
	return ""
}

// A nested type's own element has a valid End.  `@[]char`: element `char`
// (cols 4..7) ends at 1:8.
func TestNestedTypeElemEnd() testing.TestResult {
	var p @Parser = mkParser("@[]char")
	var te @ast.TypeExpr = parseType(p)
	if te.Base == nil || te.Base.End.Line != 1 || te.Base.End.Col != 8 {
		return fail("TestNestedTypeElemEnd", "wrong element End (want 1:8)")
	}
	return ""
}

// A function-local var's inner DeclRef gets its own span (it is parsed off the
// parseTopLevelDecl path).
func TestLocalDeclRefEnd() testing.TestResult {
	var p @Parser = mkParser("var x int = 5")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_DECL {
		return fail("TestLocalDeclRefEnd", "expected STMT_DECL")
	}
	if s.DeclRef == nil || !spanOK(s.DeclRef.Pos, s.DeclRef.End) {
		return fail("TestLocalDeclRefEnd", "DeclRef has zero/backwards End")
	}
	return ""
}

// An empty statement consumes no token, so its End equals its Pos (zero-width),
// never a backwards span inherited from the previous token.
func TestEmptyStmtEnd() testing.TestResult {
	var p @Parser = mkParser(";")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_EMPTY {
		return fail("TestEmptyStmtEnd", "expected STMT_EMPTY")
	}
	if s.End.Line != s.Pos.Line || s.End.Col != s.Pos.Col {
		return fail("TestEmptyStmtEnd", "empty End should equal Pos")
	}
	return ""
}

// A .bni signature-only declaration (no body) has a valid End past its
// signature, not at any brace.
func TestBniSigDeclEnd() testing.TestResult {
	var p @Parser = mkBniParser("package \"t\"\nfunc F(x int) int")
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestBniSigDeclEnd", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Body != nil {
		return fail("TestBniSigDeclEnd", "expected no body")
	}
	if !spanOK(d.Pos, d.End) {
		return fail("TestBniSigDeclEnd", "sig decl has zero/backwards End")
	}
	return ""
}
