package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"
import "pkg/stdx/slices"

// parseAnnotationBlock parses an optional leading annotation block
//
//	#[ Entry { "," Entry } ]
//
// where each Entry is `Name [ "(" Expr { "," Expr } ")" ]` and Name is a
// dotted identifier (`build`, `tool.lint`).  It returns the parsed entries,
// or an empty slice when the current token is not `#` (the common,
// un-annotated case).  The closing `]` triggers automatic semicolon
// insertion when a newline follows it, so a trailing SEMICOLON is swallowed
// here, leaving the caller's keyword/clause parse undisturbed.  There is at
// most one block per element — annotations do not stack — so a single block
// is consumed.
func parseAnnotationBlock(p @Parser) @[]@ast.Annotation {
	var annots @[]@ast.Annotation
	if p.tok.Typ != token.HASH {
		return annots
	}
	p.next()
	p.expect(token.LBRACKET)
	for p.tok.Typ != token.RBRACKET && p.tok.Typ != token.EOF {
		annots = slices.Append[@ast.Annotation](annots, parseAnnotationEntry(p))
		if !p.got(token.COMMA) {
			break
		}
	}
	p.expect(token.RBRACKET)
	p.got(token.SEMICOLON)
	return annots
}

// parseAnnotationEntry parses a single `Name [ "(" Expr { "," Expr } ")" ]`.
func parseAnnotationEntry(p @Parser) @ast.Annotation {
	var a @ast.Annotation = make(ast.Annotation)
	a.Pos = p.tok.Pos
	a.Name = parseAnnotationName(p)
	if p.tok.Typ == token.LPAREN {
		p.next()
		for p.tok.Typ != token.RPAREN && p.tok.Typ != token.EOF {
			a.Args = slices.Append[@ast.Expr](a.Args, parseExpr(p))
			if !p.got(token.COMMA) {
				break
			}
		}
		p.expect(token.RPAREN)
	}
	return a
}

// parseAnnotationName parses a dotted identifier `ident { "." ident }` and
// returns it as one string with the segments joined by `.` (e.g.
// `tool.lint`).
func parseAnnotationName(p @Parser) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	if p.tok.Typ == token.IDENT {
		cb.Write(p.tok.Lit)
		p.next()
	} else {
		p.errMsg("expected annotation name")
	}
	for p.tok.Typ == token.DOT {
		p.next()
		cb.Write(".")
		if p.tok.Typ == token.IDENT {
			cb.Write(p.tok.Lit)
			p.next()
		} else {
			p.errMsg("expected identifier after '.' in annotation name")
		}
	}
	return buf.CopyStr(cb.String())
}
