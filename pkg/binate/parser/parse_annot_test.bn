package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/builtins/testing"

// A `#[build(...)]` annotation on its own line before a function is parsed
// and attached to that Decl; the closing `]` plus newline yields an
// automatic semicolon that parseAnnotationBlock must swallow so the `func`
// still parses.  The argument is kept as an ordinary expression.
func TestParseAnnotatedFuncOwnLine() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n#[build(arch == \"arm32\")]\nfunc f() {}"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 {
		return fail("TestParseAnnotatedFuncOwnLine", "unexpected parse errors")
	}
	if len(f.Decls) != 1 {
		return fail("TestParseAnnotatedFuncOwnLine", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if len(d.Annotations) != 1 {
		return fail("TestParseAnnotatedFuncOwnLine", "expected 1 annotation")
	}
	if !charEq(d.Annotations[0].Name, "build") {
		return fail("TestParseAnnotatedFuncOwnLine", "expected name build")
	}
	if len(d.Annotations[0].Args) != 1 {
		return fail("TestParseAnnotatedFuncOwnLine", "expected 1 arg")
	}
	var arg @ast.Expr = d.Annotations[0].Args[0]
	if arg.Kind != ast.EXPR_BINARY {
		return fail("TestParseAnnotatedFuncOwnLine", "expected binary arg")
	}
	if arg.Op != cast(int, token.EQ) {
		return fail("TestParseAnnotatedFuncOwnLine", "expected == operator")
	}
	return ""
}

// The same annotation written on the same line as the declaration (no
// automatic semicolon after `]`) parses identically.
func TestParseAnnotatedFuncSameLine() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n#[build(os == \"linux\")] func f() {}"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 {
		return fail("TestParseAnnotatedFuncSameLine", "unexpected parse errors")
	}
	if len(f.Decls) != 1 || len(f.Decls[0].Annotations) != 1 {
		return fail("TestParseAnnotatedFuncSameLine", "expected 1 decl + 1 annot")
	}
	return ""
}

// Multiple comma-separated entries in one block parse into one annotation
// list, and a dotted (namespaced) name is stored joined by `.`.
func TestParseAnnotationMultipleAndDotted() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n#[build(arch == \"arm32\"), tool.lint(off)]\nfunc f() {}"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 {
		return fail("TestParseAnnotationMultipleAndDotted", "unexpected errors")
	}
	if len(f.Decls) != 1 {
		return fail("TestParseAnnotationMultipleAndDotted", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if len(d.Annotations) != 2 {
		return fail("TestParseAnnotationMultipleAndDotted", "expected 2 annots")
	}
	if !charEq(d.Annotations[1].Name, "tool.lint") {
		return fail("TestParseAnnotationMultipleAndDotted", "expected tool.lint")
	}
	return ""
}

// An entry with no `(...)` parses with an empty argument list.
func TestParseAnnotationNoArgs() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n#[tool.skip]\nfunc f() {}"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 {
		return fail("TestParseAnnotationNoArgs", "unexpected errors")
	}
	if len(f.Decls) != 1 || len(f.Decls[0].Annotations) != 1 {
		return fail("TestParseAnnotationNoArgs", "expected 1 decl + 1 annot")
	}
	if len(f.Decls[0].Annotations[0].Args) != 0 {
		return fail("TestParseAnnotationNoArgs", "expected 0 args")
	}
	return ""
}

// Annotations attach to non-func declarations too (here a const).
func TestParseAnnotatedConst() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n#[build(ptrsize == 8)]\nconst X int = 1"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 {
		return fail("TestParseAnnotatedConst", "unexpected errors")
	}
	if len(f.Decls) != 1 || len(f.Decls[0].Annotations) != 1 {
		return fail("TestParseAnnotatedConst", "expected 1 decl + 1 annot")
	}
	if f.Decls[0].Kind != ast.DECL_CONST {
		return fail("TestParseAnnotatedConst", "expected DECL_CONST")
	}
	return ""
}

// An un-annotated declaration has an empty annotation list (no regression
// to the common case).
func TestParseUnannotatedDeclHasNoAnnotations() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nfunc f() {}"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseUnannotatedDeclHasNoAnnotations", "expected 1 decl")
	}
	if len(f.Decls[0].Annotations) != 0 {
		return fail("TestParseUnannotatedDeclHasNoAnnotations", "expected 0 annots")
	}
	return ""
}
