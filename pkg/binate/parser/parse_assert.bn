package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// Parsing for type assertions `x.(K T)` and type-switch statements
// `switch [v :=] x.(type) { case K T: }` (§11.12, §14.10, grammar D13).  The
// `.(` disambiguation (selector vs. assertion vs. type-switch head) is decided
// in the postfix loop (continuePostfix) and the switch head (parseSwitchStmt);
// this file holds the pieces they delegate to: the assertion-expression builder,
// the AssertTarget parser, and the type-switch tail/clause parsers.

// parseTypeAssertExpr parses the `.( AssertTarget )` tail of a type-assertion
// expression, given the already-parsed operand `x`.  continuePostfix calls this
// only after confirming a `.(` that is not a `.(type)` switch head, so the target
// is a real AssertTarget.  Returns the EXPR_TYPE_ASSERT node (operand in X,
// recovery target in TypeRef).
func parseTypeAssertExpr(p @Parser, x @ast.Expr) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.next() // consume `.`
	p.next() // consume `(`
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_TYPE_ASSERT
	e.Pos = pos
	e.X = x
	e.TypeRef = parseAssertTarget(p)
	p.expect(token.RPAREN)
	return e
}

// parseAssertTarget parses a type-assertion / type-switch target
// `[ "*" | "@" ] [ "readonly" ] TypeName` (§11.12, §14.10, D13) into the
// TypeExpr of the value it recovers: `*T` is TEXPR_POINTER(named), `@T` is
// TEXPR_MANAGED(named), and a value `T` is the bare named type; an element
// `readonly` becomes a TEXPR_CONST wrapper.  The leading `*`/`@` is ALWAYS the
// recovery kind here, never a pointer/slice constructor — so this deliberately
// does NOT call parseType: only a nameable TypeName (a concrete type, an
// interface, `any`, optionally `pkg.T` or `Name[...]`) is accepted, and
// `*[]T` / `**T` / `func` / struct-or-array targets / `Self` are rejected at
// parse time (parseAssertTargetName), leaving the checker to only resolve a name.
func parseAssertTarget(p @Parser) @ast.TypeExpr {
	var pos token.Pos = p.tok.Pos
	var kind int = -1 // -1 = value recovery; TEXPR_POINTER = `*`; TEXPR_MANAGED = `@`
	if p.tok.Typ == token.STAR {
		kind = ast.TEXPR_POINTER
		p.next()
	} else if p.tok.Typ == token.AT {
		kind = ast.TEXPR_MANAGED
		p.next()
	}
	var inner @ast.TypeExpr = parseAssertTargetName(p)
	if kind < 0 {
		return inner
	}
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = kind
	te.Pos = pos
	te.Base = inner
	te.End = inner.End
	return te
}

// parseAssertTargetName parses the `[ "readonly" ] TypeName` tail of an
// AssertTarget.  It admits only a named type (via parseNamedType — which covers
// `pkg.T` and `Name[...]`); any other target token is a compile error, since a
// non-nameable target cannot be asserted (§11.12).  `Self` (token.SELF) and a
// second `*`/`@` are naturally excluded by the "must be an identifier" gate.
func parseAssertTargetName(p @Parser) @ast.TypeExpr {
	var roPos token.Pos
	var hasReadonly bool = false
	if p.tok.Typ == token.READONLY {
		roPos = p.tok.Pos
		hasReadonly = true
		p.next()
	}
	var named @ast.TypeExpr
	if p.tok.Typ == token.IDENT {
		named = parseNamedType(p)
	} else {
		p.errMsg(
				"type-assertion target must be a named type "
						"(a concrete type, an interface, or `any`); a slice, function, "
						"struct, array, or `Self` cannot be asserted")
		// Recover with a placeholder named type so the rest of the file parses.
		named = make(ast.TypeExpr)
		named.Kind = ast.TEXPR_NAMED
		named.Pos = p.tok.Pos
		named.End = p.tok.Pos
	}
	if !hasReadonly {
		return named
	}
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_CONST
	te.Pos = roPos
	te.Base = named
	te.End = named.End
	return te
}

// parseAssertTargetList parses a type-switch case's
// `AssertTarget { "," AssertTarget }` (§14.10) — one or more comma-separated
// recovery targets (`case *A, @B:`).
func parseAssertTargetList(p @Parser) @[]@ast.TypeExpr {
	var list @[]@ast.TypeExpr
	list = slices.Append[@ast.TypeExpr](list, parseAssertTarget(p))
	for p.got(token.COMMA) {
		if p.tok.Typ == token.COLON {
			break // tolerate a trailing comma before the clause colon
		}
		list = slices.Append[@ast.TypeExpr](list, parseAssertTarget(p))
	}
	return list
}

// parseTypeSwitchTail parses the `.(type) { TypeCaseClause* }` tail of a type
// switch (§14.10), given the already-parsed scrutinee and the binder name (an
// empty slice for the binderless form).  The leading `.(type)` is consumed here
// (the expression parser left it unconsumed — D13).
func parseTypeSwitchTail(p @Parser, pos token.Pos, binder @[]char, scrut @ast.Expr) @ast.Stmt {
	p.expect(token.DOT)
	p.expect(token.LPAREN)
	p.expect(token.TYPE)
	p.expect(token.RPAREN)
	p.expect(token.LBRACE)
	var cases @[]@ast.CaseClause
	for p.tok.Typ != token.RBRACE && p.tok.Typ != token.EOF {
		cases = slices.Append[@ast.CaseClause](cases, parseTypeCaseClause(p))
	}
	p.expect(token.RBRACE)

	var s @ast.Stmt = make(ast.Stmt)
	s.Kind = ast.STMT_TYPE_SWITCH
	s.Pos = pos
	s.X = scrut
	s.Binder = binder
	s.Cases = cases
	return s
}

// parseTypeCaseClause parses a single clause of a type switch: `case
// AssertTargetList:` (targets stored in CaseClause.Types) or `default:`
// (§14.10).  The clause body is shared with expression switches (parseCaseBody).
func parseTypeCaseClause(p @Parser) @ast.CaseClause {
	var cc @ast.CaseClause = make(ast.CaseClause)
	cc.Pos = p.tok.Pos
	if p.tok.Typ == token.CASE {
		p.next()
		cc.Types = parseAssertTargetList(p)
	} else {
		p.expect(token.DEFAULT)
	}
	parseCaseBody(p, cc)
	return cc
}
