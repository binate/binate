package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for type-assertion expressions `x.(K T)` and type-switch statements
// `switch [v :=] x.(type) { case K T: }` (§11.12, §14.10, grammar D13).  The
// recovery target parses into the TypeExpr of the recovered value: `*T` is
// TEXPR_POINTER(named), `@T` TEXPR_MANAGED(named), value `T` the bare named type,
// and `readonly` a TEXPR_CONST wrapper (parseAssertTarget).

// A raw-recovery assertion `x.(*T)` is EXPR_TYPE_ASSERT with the operand in X and
// a TEXPR_POINTER(named) target in TypeRef.
func TestParseTypeAssertRaw() testing.TestResult {
	var p @Parser = mkParser("x.(*T)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_TYPE_ASSERT {
		return fail("TestParseTypeAssertRaw", "expected EXPR_TYPE_ASSERT")
	}
	if e.X.Kind != ast.EXPR_IDENT || !charEq(e.X.Name, "x") {
		return fail("TestParseTypeAssertRaw", "expected operand ident x")
	}
	if e.TypeRef.Kind != ast.TEXPR_POINTER {
		return fail("TestParseTypeAssertRaw", "expected TEXPR_POINTER target (`*` recovery)")
	}
	if e.TypeRef.Base.Kind != ast.TEXPR_NAMED || !charEq(e.TypeRef.Base.Name, "T") {
		return fail("TestParseTypeAssertRaw", "expected named target T")
	}
	return ""
}

// A managed-recovery assertion `x.(@T)` is TEXPR_MANAGED(named).
func TestParseTypeAssertManaged() testing.TestResult {
	var p @Parser = mkParser("x.(@T)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_TYPE_ASSERT {
		return fail("TestParseTypeAssertManaged", "expected EXPR_TYPE_ASSERT")
	}
	if e.TypeRef.Kind != ast.TEXPR_MANAGED {
		return fail("TestParseTypeAssertManaged", "expected TEXPR_MANAGED target (`@` recovery)")
	}
	if e.TypeRef.Base.Kind != ast.TEXPR_NAMED || !charEq(e.TypeRef.Base.Name, "T") {
		return fail("TestParseTypeAssertManaged", "expected named target T")
	}
	return ""
}

// A value-recovery assertion `x.(T)` carries the bare named type as TypeRef (no
// recovery-kind wrapper).
func TestParseTypeAssertValue() testing.TestResult {
	var p @Parser = mkParser("x.(T)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_TYPE_ASSERT {
		return fail("TestParseTypeAssertValue", "expected EXPR_TYPE_ASSERT")
	}
	if e.TypeRef.Kind != ast.TEXPR_NAMED || !charEq(e.TypeRef.Name, "T") {
		return fail("TestParseTypeAssertValue", "expected bare named target T")
	}
	return ""
}

// `x.(readonly T)` wraps the named target in TEXPR_CONST.
func TestParseTypeAssertReadonly() testing.TestResult {
	var p @Parser = mkParser("x.(readonly T)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_TYPE_ASSERT {
		return fail("TestParseTypeAssertReadonly", "expected EXPR_TYPE_ASSERT")
	}
	if e.TypeRef.Kind != ast.TEXPR_CONST {
		return fail("TestParseTypeAssertReadonly", "expected TEXPR_CONST (readonly) target")
	}
	if e.TypeRef.Base.Kind != ast.TEXPR_NAMED || !charEq(e.TypeRef.Base.Name, "T") {
		return fail("TestParseTypeAssertReadonly", "expected named base T under readonly")
	}
	return ""
}

// `x.(*readonly T)` nests the recovery kind outside the readonly: TEXPR_POINTER
// over TEXPR_CONST over named.
func TestParseTypeAssertRawReadonly() testing.TestResult {
	var p @Parser = mkParser("x.(*readonly T)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_TYPE_ASSERT {
		return fail("TestParseTypeAssertRawReadonly", "expected EXPR_TYPE_ASSERT")
	}
	if e.TypeRef.Kind != ast.TEXPR_POINTER {
		return fail("TestParseTypeAssertRawReadonly", "expected outer TEXPR_POINTER")
	}
	if e.TypeRef.Base.Kind != ast.TEXPR_CONST {
		return fail("TestParseTypeAssertRawReadonly", "expected TEXPR_CONST under the pointer")
	}
	if e.TypeRef.Base.Base.Kind != ast.TEXPR_NAMED || !charEq(e.TypeRef.Base.Base.Name, "T") {
		return fail("TestParseTypeAssertRawReadonly", "expected named T under readonly")
	}
	return ""
}

// A package-qualified target `x.(pkg.T)` is consumed wholly by TypeName (its
// inner `.` is not a selector) — Pkg/Name on the named node.
func TestParseTypeAssertQualified() testing.TestResult {
	var p @Parser = mkParser("x.(pkg.T)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_TYPE_ASSERT {
		return fail("TestParseTypeAssertQualified", "expected EXPR_TYPE_ASSERT")
	}
	if e.TypeRef.Kind != ast.TEXPR_NAMED || !charEq(e.TypeRef.Pkg, "pkg") ||
			!charEq(e.TypeRef.Name, "T") {
		return fail("TestParseTypeAssertQualified", "expected qualified named pkg.T")
	}
	return ""
}

// A generic-instantiated target `x.(Vec[int])` parses the instantiation suffix.
func TestParseTypeAssertInstantiated() testing.TestResult {
	var p @Parser = mkParser("x.(Vec[int])")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_TYPE_ASSERT {
		return fail("TestParseTypeAssertInstantiated", "expected EXPR_TYPE_ASSERT")
	}
	if e.TypeRef.Kind != ast.TEXPR_INSTANTIATE {
		return fail("TestParseTypeAssertInstantiated", "expected TEXPR_INSTANTIATE target")
	}
	if e.TypeRef.Base.Kind != ast.TEXPR_NAMED || !charEq(e.TypeRef.Base.Name, "Vec") {
		return fail("TestParseTypeAssertInstantiated", "expected instantiation head Vec")
	}
	return ""
}

// A plain `.` identifier is still a selector — the restructured DOT arm must not
// regress `x.y`.
func TestParseSelectorStillWorks() testing.TestResult {
	var p @Parser = mkParser("x.y")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_SELECTOR {
		return fail("TestParseSelectorStillWorks", "expected EXPR_SELECTOR for x.y")
	}
	if !charEq(e.Name, "y") {
		return fail("TestParseSelectorStillWorks", "expected selector name y")
	}
	return ""
}

// Comma-ok `v, ok := x.(*T)` reuses the SHORT_VAR statement: two LHS idents and
// an EXPR_TYPE_ASSERT RHS.
func TestParseTypeAssertCommaOk() testing.TestResult {
	var p @Parser = mkParser("v, ok := x.(*T)")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_SHORT_VAR {
		return fail("TestParseTypeAssertCommaOk", "expected STMT_SHORT_VAR")
	}
	if len(s.Exprs) != 2 {
		return fail("TestParseTypeAssertCommaOk", "expected two LHS names")
	}
	if len(s.Exprs2) != 1 || s.Exprs2[0].Kind != ast.EXPR_TYPE_ASSERT {
		return fail("TestParseTypeAssertCommaOk", "expected an EXPR_TYPE_ASSERT RHS")
	}
	return ""
}

// A binderless type switch `switch x.(type) { ... }` is STMT_TYPE_SWITCH with an
// empty Binder; each case carries its targets in CaseClause.Types.
func TestParseTypeSwitchBinderless() testing.TestResult {
	var p @Parser = mkParser("switch x.(type) { case *A: case @B, @C: default: }")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_TYPE_SWITCH {
		return fail("TestParseTypeSwitchBinderless", "expected STMT_TYPE_SWITCH")
	}
	if len(s.Binder) != 0 {
		return fail("TestParseTypeSwitchBinderless", "expected empty binder")
	}
	if s.X.Kind != ast.EXPR_IDENT || !charEq(s.X.Name, "x") {
		return fail("TestParseTypeSwitchBinderless", "expected scrutinee ident x")
	}
	if len(s.Cases) != 3 {
		return fail("TestParseTypeSwitchBinderless", "expected 3 clauses")
	}
	if len(s.Cases[0].Types) != 1 || s.Cases[0].Types[0].Kind != ast.TEXPR_POINTER {
		return fail("TestParseTypeSwitchBinderless", "case 0 should be a single `*A` target")
	}
	if len(s.Cases[1].Types) != 2 {
		return fail("TestParseTypeSwitchBinderless", "case 1 should have two targets")
	}
	if len(s.Cases[2].Types) != 0 {
		return fail("TestParseTypeSwitchBinderless", "default clause carries no targets")
	}
	return ""
}

// The binder form `switch v := x.(type) { ... }` records the bound name.
func TestParseTypeSwitchBinder() testing.TestResult {
	var p @Parser = mkParser("switch v := x.(type) { case T: }")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_TYPE_SWITCH {
		return fail("TestParseTypeSwitchBinder", "expected STMT_TYPE_SWITCH")
	}
	if !charEq(s.Binder, "v") {
		return fail("TestParseTypeSwitchBinder", "expected binder v")
	}
	if s.X.Kind != ast.EXPR_IDENT || !charEq(s.X.Name, "x") {
		return fail("TestParseTypeSwitchBinder", "expected scrutinee ident x")
	}
	if len(s.Cases) != 1 || len(s.Cases[0].Types) != 1 {
		return fail("TestParseTypeSwitchBinder", "expected one single-target case")
	}
	return ""
}

// A qualified scrutinee `switch a.b.(type)` keeps the selector as the scrutinee
// and still recognizes the trailing `.(type)` head.
func TestParseTypeSwitchSelectorScrutinee() testing.TestResult {
	var p @Parser = mkParser("switch a.b.(type) { default: }")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_TYPE_SWITCH {
		return fail("TestParseTypeSwitchSelectorScrutinee", "expected STMT_TYPE_SWITCH")
	}
	if s.X.Kind != ast.EXPR_SELECTOR {
		return fail("TestParseTypeSwitchSelectorScrutinee", "expected selector scrutinee a.b")
	}
	return ""
}

// An ordinary expression switch still parses as STMT_SWITCH (no regression).
func TestParseExprSwitchStillWorks() testing.TestResult {
	var p @Parser = mkParser("switch x { case 1: default: }")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_SWITCH {
		return fail("TestParseExprSwitchStillWorks", "expected STMT_SWITCH")
	}
	if len(s.Cases) != 2 || len(s.Cases[0].Exprs) != 1 {
		return fail("TestParseExprSwitchStillWorks", "expected an expression-switch clause")
	}
	return ""
}

// A non-nameable target `x.(*[]T)` is rejected at parse time (parseAssertTarget
// enforces "named only").
func TestParseAssertNonNameableRejected() testing.TestResult {
	var p @Parser = mkParser("x.(*[]T)")
	parseExpr(p)
	if len(p.Errors()) == 0 {
		return fail("TestParseAssertNonNameableRejected", "expected a parse error for *[]T target")
	}
	return ""
}

// A doubled recovery kind `x.(**T)` is rejected (the second `*` is not a name).
func TestParseAssertDoubleKindRejected() testing.TestResult {
	var p @Parser = mkParser("x.(**T)")
	parseExpr(p)
	if len(p.Errors()) == 0 {
		return fail("TestParseAssertDoubleKindRejected", "expected a parse error for **T target")
	}
	return ""
}

// A bare `x.(type)` outside a switch head is rejected: continuePostfix leaves the
// `.(type)` unconsumed, and the leftover tokens surface as a parse error.
func TestParseBareTypeSwitchHeadRejected() testing.TestResult {
	var p @Parser = mkParser("package \"test\"\nfunc f() { x.(type) }\n")
	p.ParseFile()
	if len(p.Errors()) == 0 {
		return fail("TestParseBareTypeSwitchHeadRejected", "expected a parse error for bare x.(type)")
	}
	return ""
}
