// parseCCall parses a `__c_call("sym", RetType, args...)` builtin call.
// The symbol is a string literal (stored quote-stripped in e.Name); the
// return type goes in e.TypeRef; the argument values go in e.Args.  A
// `...` marker separates fixed from variadic args: everything before it
// is fixed, so e.CFixedArgs records the fixed-arg count (== len(Args)
// when there is no marker).  See explorations/plan-c-call.md.
func parseCCall(p @Parser) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.next() // consume __c_call
	p.expect(token.LPAREN)
	// Symbol: a string literal, emitted verbatim (no mangling).
	var sym @[]char
	if p.tok.Typ != token.STRING {
		p.addError(p.tok.Pos,
			"__c_call: first argument must be a string literal symbol name")
	} else {
		sym = stripStringQuotes(p.tok.Lit)
		p.next()
	}
	p.expect(token.COMMA)
	// Return type: a Binate type, or the string "void" for a void C call
	// (no result).  A void call carries a nil TypeRef — the IR convention
	// is that a nil result type produces no SSA result.  The string form
	// leaves room to name other Binate-less C types later; only "void" is
	// accepted today.
	var ret @ast.TypeExpr  // nil => void
	if p.tok.Typ == token.STRING {
		if !cCallRetSpecIsVoid(stripStringQuotes(p.tok.Lit)) {
			p.addError(p.tok.Pos,
				"__c_call: the only string return type is \"void\"")
		}
		p.next()
		// ret stays nil => void
	} else {
		ret = parseType(p)
	}
	// Argument values, with an optional `...` variadic boundary marker.
	var args @[]@ast.Expr
	var fixedArgs int = 0
	var sawMarker bool = false
	for p.tok.Typ == token.COMMA {
		p.next() // consume comma
		if p.tok.Typ == token.ELLIPSIS {
			p.next()
			sawMarker = true
			fixedArgs = len(args)
			continue
		}
		var arg @ast.Expr = parseExpr(p)
		args = slices.Append[@ast.Expr](args, arg)
	}
	p.expect(token.RPAREN)
	if !sawMarker {
		fixedArgs = len(args)
	}
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_BUILTIN
	e.Pos = pos
	e.Op = cast(int, token.C_CALL)
	e.Name = sym
	e.TypeRef = ret
	e.Args = args
	e.CFixedArgs = fixedArgs
	return e
}

// cCallRetSpecIsVoid reports whether a __c_call string return spec is
// exactly "void" — the only Binate-less C return type spelled as a
// string today (a void C call carries a nil TypeRef downstream).
func cCallRetSpecIsVoid(s @[]char) bool {
	return len(s) == 4 && s[0] == 'v' && s[1] == 'o' &&
		s[2] == 'i' && s[3] == 'd'
}

// stripStringQuotes drops the surrounding double quotes from a STRING
// token's literal text (which the lexer stores verbatim, quotes
// included).  Used for the `__c_call` symbol name, which is restricted
// to identifier-like symbols (no escapes to decode).
func stripStringQuotes(lit @[]char) @[]char {
	if len(lit) >= 2 && lit[0] == '"' && lit[len(lit)-1] == '"' {
		return lit[1 : len(lit)-1]
	}
	return lit
}

// parseBitCastCall parses a bit_cast(T, expr) builtin call.
func parseBitCastCall(p @Parser) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.next() // consume bit_cast
	p.expect(token.LPAREN)
	var typ @ast.TypeExpr = parseType(p)
	p.expect(token.COMMA)
	var arg @ast.Expr = parseExpr(p)
	p.expect(token.RPAREN)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_BUILTIN
	e.Pos = pos
	e.Op = cast(int, token.BIT_CAST)
	e.TypeRef = typ
	var args @[]@ast.Expr
	args = slices.Append[@ast.Expr](args, arg)
	e.Args = args
	return e
}

