// parsePresentCall parses a present(iv) builtin call — true iff the
// interface value iv holds a concrete impl.
func parsePresentCall(p @Parser) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.next() // consume present
	p.expect(token.LPAREN)
	var arg @ast.Expr = parseExpr(p)
	p.expect(token.RPAREN)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_BUILTIN
	e.Pos = pos
	e.Op = cast(int, token.PRESENT)
	var args @[]@ast.Expr
	args = slices.Append[@ast.Expr](args, arg)
	e.Args = args
	return e
}

// parseSameCall parses a same(a, b) builtin call — true iff a and b are
// the same reference (pointer / interface-value / slice-view identity).
func parseSameCall(p @Parser) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.next() // consume same
	p.expect(token.LPAREN)
	var a @ast.Expr = parseExpr(p)
	p.expect(token.COMMA)
	var b @ast.Expr = parseExpr(p)
	p.expect(token.RPAREN)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_BUILTIN
	e.Pos = pos
	e.Op = cast(int, token.SAME)
	var args @[]@ast.Expr
	args = slices.Append[@ast.Expr](args, a)
	args = slices.Append[@ast.Expr](args, b)
	e.Args = args
	return e
}

// parseUnsafeIndexCall parses an unsafe_index(coll, idx) builtin call.
// Evaluates both arguments and loads the indexed element without
// bounds checking.
func parseUnsafeIndexCall(p @Parser) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.next() // consume unsafe_index
	p.expect(token.LPAREN)
	var coll @ast.Expr = parseExpr(p)
	p.expect(token.COMMA)
	var idx @ast.Expr = parseExpr(p)
	p.expect(token.RPAREN)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_BUILTIN
	e.Pos = pos
	e.Op = cast(int, token.UNSAFE_INDEX)
	var args @[]@ast.Expr
	args = slices.Append[@ast.Expr](args, coll)
	args = slices.Append[@ast.Expr](args, idx)
	e.Args = args
	return e
}

// parseUnsafeBinaryCall parses a two-argument guard-free builtin —
// unsafe_div / unsafe_rem (skip the divide-fault guard) and unsafe_shl /
// unsafe_shr (skip the overshift guard + negative-count check).  The current
// token is carried onto e.Op so the checker and IR-gen pick the right
// operation.
func parseUnsafeBinaryCall(p @Parser) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	var op token.Type = p.tok.Typ
	p.next() // consume the builtin keyword
	p.expect(token.LPAREN)
	var a @ast.Expr = parseExpr(p)
	p.expect(token.COMMA)
	var b @ast.Expr = parseExpr(p)
	p.expect(token.RPAREN)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_BUILTIN
	e.Pos = pos
	e.Op = cast(int, op)
	var args @[]@ast.Expr
	args = slices.Append[@ast.Expr](args, a)
	args = slices.Append[@ast.Expr](args, b)
	e.Args = args
	return e
}

// parseSizeofCall parses a sizeof(T) builtin call. Returns a compile-
// time constant of type uint.
func parseSizeofCall(p @Parser) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.next() // consume sizeof
	p.expect(token.LPAREN)
	var typ @ast.TypeExpr = parseType(p)
	p.expect(token.RPAREN)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_BUILTIN
	e.Pos = pos
	e.Op = cast(int, token.SIZEOF)
	e.TypeRef = typ
	return e
}

// parseRawFuncAddrCall parses a _raw_func_addr(funcRef) builtin
// call. The argument is a function-name expression — an Ident or
// Selector — that the type-checker resolves to a named function.
// Result type is *uint8. Compiler-internal; underscore-prefixed.
func parseRawFuncAddrCall(p @Parser) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.next() // consume _raw_func_addr
	p.expect(token.LPAREN)
	var arg @ast.Expr = parseExpr(p)
	p.expect(token.RPAREN)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_BUILTIN
	e.Pos = pos
	e.Op = cast(int, token.RAW_FUNC_ADDR)
	var args @[]@ast.Expr
	args = slices.Append[@ast.Expr](args, arg)
	e.Args = args
	return e
}

// parseAlignofCall parses an alignof(T) builtin call. Returns a
// compile-time constant of type uint.
func parseAlignofCall(p @Parser) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.next() // consume alignof
	p.expect(token.LPAREN)
	var typ @ast.TypeExpr = parseType(p)
	p.expect(token.RPAREN)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_BUILTIN
	e.Pos = pos
	e.Op = cast(int, token.ALIGNOF)
	e.TypeRef = typ
	return e
}
