func TestParseCastCall() testing.TestResult {
	var p @Parser = mkParser("cast(int, x)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_BUILTIN {
		return fail("TestParseCastCall", "expected EXPR_BUILTIN")
	}
	if e.Op != cast(int, token.CAST) {
		return fail("TestParseCastCall", "expected CAST op")
	}
	if e.TypeRef == nil {
		return fail("TestParseCastCall", "expected TypeRef")
	}
	return ""
}

// __c_call("sym", RetType, args...) — non-variadic: symbol in Name,
// return type in TypeRef, value args in Args, CFixedArgs == len(Args).
func TestParseCCall() testing.TestResult {
	var p @Parser = mkParser("__c_call(\"abs\", int32, x)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_BUILTIN {
		return fail("TestParseCCall", "expected EXPR_BUILTIN")
	}
	if e.Op != cast(int, token.C_CALL) {
		return fail("TestParseCCall", "expected C_CALL op")
	}
	if e.TypeRef == nil {
		return fail("TestParseCCall", "expected return TypeRef")
	}
	if len(e.Name) != 3 {
		return fail("TestParseCCall", "expected symbol name (quotes stripped)")
	}
	if len(e.Args) != 1 {
		return fail("TestParseCCall", "expected 1 value arg")
	}
	if e.CFixedArgs != 1 {
		return fail("TestParseCCall", "expected CFixedArgs == 1")
	}
	return ""
}

// The `...` marker splits fixed from variadic args: the marker is not
// itself stored in Args, but CFixedArgs records the boundary.
func TestParseCCallVariadicMarker() testing.TestResult {
	var p @Parser = mkParser("__c_call(\"open\", int32, path, flags, ..., mode)")
	var e @ast.Expr = parseExpr(p)
	if e.Op != cast(int, token.C_CALL) {
		return fail("TestParseCCallVariadicMarker", "expected C_CALL op")
	}
	if len(e.Args) != 3 {
		return fail("TestParseCCallVariadicMarker", "expected 3 args (marker not stored)")
	}
	if e.CFixedArgs != 2 {
		return fail("TestParseCCallVariadicMarker", "expected CFixedArgs == 2")
	}
	return ""
}

// A non-string-literal symbol (e.g. an identifier) must produce a
// parse error — the symbol has to be a literal so it can be emitted
// verbatim into the LLVM declare/call site.
func TestParseCCallNonStringSymbolRejected() testing.TestResult {
	var p @Parser = mkParser("__c_call(sym, int32, x)")
	parseExpr(p)
	var errs @[]ParseError = p.Errors()
	if len(errs) == 0 {
		return fail("TestParseCCallNonStringSymbolRejected",
				"expected a parse error for non-string-literal symbol")
	}
	return ""
}

// __c_call("sym", "void", args...) — the "void" return spelling parses to
// a nil TypeRef (a void C call, no SSA result); Args / CFixedArgs are
// unaffected.
func TestParseCCallVoidReturn() testing.TestResult {
	var p @Parser = mkParser("__c_call(\"free\", \"void\", x)")
	var e @ast.Expr = parseExpr(p)
	if e.Op != cast(int, token.C_CALL) {
		return fail("TestParseCCallVoidReturn", "expected C_CALL op")
	}
	if e.TypeRef != nil {
		return fail("TestParseCCallVoidReturn", "expected nil TypeRef for the \"void\" return spelling")
	}
	if len(e.Args) != 1 {
		return fail("TestParseCCallVoidReturn", "expected 1 value arg")
	}
	if e.CFixedArgs != 1 {
		return fail("TestParseCCallVoidReturn", "expected CFixedArgs == 1")
	}
	if len(p.Errors()) != 0 {
		return fail("TestParseCCallVoidReturn", "unexpected parse error")
	}
	return ""
}

// Only "void" is accepted as a string return spec; any other string (a
// misspelling or an unsupported C type name) is a parse error.
func TestParseCCallNonVoidStringRejected() testing.TestResult {
	var p @Parser = mkParser("__c_call(\"x\", \"int\", a)")
	parseExpr(p)
	if len(p.Errors()) == 0 {
		return fail("TestParseCCallNonVoidStringRejected",
				"expected a parse error for a non-\"void\" string return type")
	}
	return ""
}

// __c_global("sym", T) — symbol in Name (quotes stripped), pointee type in
// TypeRef, no value args (it takes exactly a string and a type).
func TestParseCGlobal() testing.TestResult {
	var p @Parser = mkParser("__c_global(\"environ\", **char)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_BUILTIN {
		return fail("TestParseCGlobal", "expected EXPR_BUILTIN")
	}
	if e.Op != cast(int, token.C_GLOBAL) {
		return fail("TestParseCGlobal", "expected C_GLOBAL op")
	}
	if len(e.Name) != 7 {
		return fail("TestParseCGlobal", "expected symbol name (quotes stripped)")
	}
	if e.TypeRef == nil {
		return fail("TestParseCGlobal", "expected TypeRef")
	}
	if len(e.Args) != 0 {
		return fail("TestParseCGlobal", "expected no value args")
	}
	if len(p.Errors()) != 0 {
		return fail("TestParseCGlobal", "unexpected parse error")
	}
	return ""
}

// A non-string-literal symbol (e.g. an identifier) must produce a parse
// error — the symbol has to be a literal so it can be emitted verbatim.
func TestParseCGlobalNonStringSymbolRejected() testing.TestResult {
	var p @Parser = mkParser("__c_global(sym, int)")
	parseExpr(p)
	if len(p.Errors()) == 0 {
		return fail("TestParseCGlobalNonStringSymbolRejected",
				"expected a parse error for non-string-literal symbol")
	}
	return ""
}

// The type argument is mandatory — there is no "void" spelling and no
// bare-symbol form, so `__c_global("x")` is a parse error.
func TestParseCGlobalRequiresType() testing.TestResult {
	var p @Parser = mkParser("__c_global(\"x\")")
	parseExpr(p)
	if len(p.Errors()) == 0 {
		return fail("TestParseCGlobalRequiresType",
				"expected a parse error when the type argument is missing")
	}
	return ""
}

func TestParseRawFuncAddrCall() testing.TestResult {
	var p @Parser = mkParser("_raw_func_addr(rt.RawFree)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_BUILTIN {
		return fail("TestParseRawFuncAddrCall", "expected EXPR_BUILTIN")
	}
	if e.Op != cast(int, token.RAW_FUNC_ADDR) {
		return fail("TestParseRawFuncAddrCall", "expected RAW_FUNC_ADDR op")
	}
	if len(e.Args) != 1 {
		return fail("TestParseRawFuncAddrCall", "expected 1 arg")
	}
	if e.Args[0].Kind != ast.EXPR_SELECTOR {
		return fail("TestParseRawFuncAddrCall", "expected Selector arg")
	}
	return ""
}

// TestParseFuncHandleCall covers the canonical `_func_handle` spelling.
// Both spellings parse to the same EXPR_BUILTIN with token.RAW_FUNC_ADDR
// op — the rename is lexer-only for the transitional period.
func TestParseFuncHandleCall() testing.TestResult {
	var p @Parser = mkParser("_func_handle(rt.RawFree)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_BUILTIN {
		return fail("TestParseFuncHandleCall", "expected EXPR_BUILTIN")
	}
	if e.Op != cast(int, token.RAW_FUNC_ADDR) {
		return fail("TestParseFuncHandleCall", "expected RAW_FUNC_ADDR op")
	}
	if len(e.Args) != 1 {
		return fail("TestParseFuncHandleCall", "expected 1 arg")
	}
	if e.Args[0].Kind != ast.EXPR_SELECTOR {
		return fail("TestParseFuncHandleCall", "expected Selector arg")
	}
	return ""
}

