package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/builtins/testing"

// Tests for the builtin-call parsers in parse_builtin.bn. Each
// pins the EXPR_BUILTIN tag, the token.* op code, and the arg
// shape (TypeRef vs Args, count) — getting any of those wrong
// silently produces malformed AST that the type-checker reports
// as a vague "invalid expression" later.

func TestParseLenCall() testing.TestResult {
	var p @Parser = mkParser("len(x)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_BUILTIN {
		return fail("TestParseLenCall", "expected EXPR_BUILTIN")
	}
	if e.Op != cast(int, token.LEN) {
		return fail("TestParseLenCall", "expected LEN op")
	}
	if len(e.Args) != 1 {
		return fail("TestParseLenCall", "expected 1 arg")
	}
	return ""
}

func TestParsePresentCall() testing.TestResult {
	var p @Parser = mkParser("present(x)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_BUILTIN {
		return fail("TestParsePresentCall", "expected EXPR_BUILTIN")
	}
	if e.Op != cast(int, token.PRESENT) {
		return fail("TestParsePresentCall", "expected PRESENT op")
	}
	if len(e.Args) != 1 {
		return fail("TestParsePresentCall", "expected 1 arg")
	}
	return ""
}

func TestParseCastCall() testing.TestResult {
	var p @Parser = mkParser("cast(int, x)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_BUILTIN {
		return fail("TestParseCastCall", "expected EXPR_BUILTIN")
	}
	if e.Op != cast(int, token.CAST) {
		return fail("TestParseCastCall", "expected CAST op")
	}
	if e.TypeRef == nil {
		return fail("TestParseCastCall", "expected TypeRef")
	}
	return ""
}

// __c_call("sym", RetType, args...) — non-variadic: symbol in Name,
// return type in TypeRef, value args in Args, CFixedArgs == len(Args).
func TestParseCCall() testing.TestResult {
	var p @Parser = mkParser("__c_call(\"abs\", int32, x)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_BUILTIN {
		return fail("TestParseCCall", "expected EXPR_BUILTIN")
	}
	if e.Op != cast(int, token.C_CALL) {
		return fail("TestParseCCall", "expected C_CALL op")
	}
	if e.TypeRef == nil {
		return fail("TestParseCCall", "expected return TypeRef")
	}
	if len(e.Name) != 3 {
		return fail("TestParseCCall", "expected symbol name (quotes stripped)")
	}
	if len(e.Args) != 1 {
		return fail("TestParseCCall", "expected 1 value arg")
	}
	if e.CFixedArgs != 1 {
		return fail("TestParseCCall", "expected CFixedArgs == 1")
	}
	return ""
}

// The `...` marker splits fixed from variadic args: the marker is not
// itself stored in Args, but CFixedArgs records the boundary.
func TestParseCCallVariadicMarker() testing.TestResult {
	var p @Parser = mkParser("__c_call(\"open\", int32, path, flags, ..., mode)")
	var e @ast.Expr = parseExpr(p)
	if e.Op != cast(int, token.C_CALL) {
		return fail("TestParseCCallVariadicMarker", "expected C_CALL op")
	}
	if len(e.Args) != 3 {
		return fail("TestParseCCallVariadicMarker", "expected 3 args (marker not stored)")
	}
	if e.CFixedArgs != 2 {
		return fail("TestParseCCallVariadicMarker", "expected CFixedArgs == 2")
	}
	return ""
}

// A non-string-literal symbol (e.g. an identifier) must produce a
// parse error — the symbol has to be a literal so it can be emitted
// verbatim into the LLVM declare/call site.
func TestParseCCallNonStringSymbolRejected() testing.TestResult {
	var p @Parser = mkParser("__c_call(sym, int32, x)")
	parseExpr(p)
	var errs @[]ParseError = p.Errors()
	if len(errs) == 0 {
		return fail("TestParseCCallNonStringSymbolRejected",
			"expected a parse error for non-string-literal symbol")
	}
	return ""
}

func TestParseRawFuncAddrCall() testing.TestResult {
	var p @Parser = mkParser("_raw_func_addr(rt.RawFree)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_BUILTIN {
		return fail("TestParseRawFuncAddrCall", "expected EXPR_BUILTIN")
	}
	if e.Op != cast(int, token.RAW_FUNC_ADDR) {
		return fail("TestParseRawFuncAddrCall", "expected RAW_FUNC_ADDR op")
	}
	if len(e.Args) != 1 {
		return fail("TestParseRawFuncAddrCall", "expected 1 arg")
	}
	if e.Args[0].Kind != ast.EXPR_SELECTOR {
		return fail("TestParseRawFuncAddrCall", "expected Selector arg")
	}
	return ""
}

// TestParseFuncHandleCall covers the canonical spelling post-Phase-4
// of plan-uniform-native-fnptrs.md.  Both spellings parse to the
// same EXPR_BUILTIN with token.RAW_FUNC_ADDR op — the rename is
// lexer-only for the transitional period.
func TestParseFuncHandleCall() testing.TestResult {
	var p @Parser = mkParser("_func_handle(rt.RawFree)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_BUILTIN {
		return fail("TestParseFuncHandleCall", "expected EXPR_BUILTIN")
	}
	if e.Op != cast(int, token.RAW_FUNC_ADDR) {
		return fail("TestParseFuncHandleCall", "expected RAW_FUNC_ADDR op")
	}
	if len(e.Args) != 1 {
		return fail("TestParseFuncHandleCall", "expected 1 arg")
	}
	if e.Args[0].Kind != ast.EXPR_SELECTOR {
		return fail("TestParseFuncHandleCall", "expected Selector arg")
	}
	return ""
}

