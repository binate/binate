// same, unsafe_index and unsafe_shl take exactly two operands: one or three is a
// parse error.
func TestParseBinaryBuiltinArityRejected() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 6)
	srcs[0] = "same(p)"
	srcs[1] = "same(p, q, r)"
	srcs[2] = "unsafe_index(s)"
	srcs[3] = "unsafe_index(s, 0, 1)"
	srcs[4] = "unsafe_shl(x)"
	srcs[5] = "unsafe_shl(x, 1, 2)"
	for i := 0; i < len(srcs); i++ {
		var p @Parser = mkParser(srcs[i])
		_ = parseExpr(p)
		if len(p.Errors()) == 0 {
			return fail("TestParseBinaryBuiltinArityRejected", srcs[i])
		}
	}
	return ""
}

