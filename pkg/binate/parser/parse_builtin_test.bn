// A comment-collecting parse records each builtin call's keyword and `(`, and a
// `__c_call`'s symbol, "void" and `...`, in source order -- a call nested in
// another's arguments after it; a non-collecting parse records none.
func TestParseBuiltinOpeners() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"func f() {\n"
			"\t_ = len\n"
			"\t(same(a, b))\n"
			"\t_ = __c_call(\n"
			"\t\t\"g\", \"void\", x, ...)\n"
			"}\n"
	var p @Parser = mkCollectingParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 { return fail("TestParseBuiltinOpeners", p.Errors()[0].Msg) }
	var rs @[]@ast.BuiltinOpener = f.BuiltinOpeners
	if len(rs) != 3 { return fail("TestParseBuiltinOpeners", "expected 3 records") }
	if !atLine(rs[0].Pos, 3, 6) || !atLine(rs[0].LParen, 4, 2) || rs[0].Sym.Line != 0 {
		return fail("TestParseBuiltinOpeners", "len: keyword 3:6, `(` 4:2, no symbol")
	}
	if !atLine(rs[1].Pos, 4, 3) || !atLine(rs[1].LParen, 4, 7) {
		return fail("TestParseBuiltinOpeners", "same: keyword 4:3, `(` 4:7")
	}
	var c @ast.BuiltinOpener = rs[2]
	if !atLine(c.Pos, 5, 6) || !atLine(c.LParen, 5, 14) || !atLine(c.Sym, 6, 3) ||
			!atLine(c.Void, 6, 8) {
		return fail("TestParseBuiltinOpeners",
				"__c_call: keyword 5:6, `(` 5:14, symbol 6:3, \"void\" 6:8")
	}
	if !atLine(c.Dots, 6, 19) { return fail("TestParseBuiltinOpeners", "__c_call: `...` 6:19") }
	var q @Parser = mkParser(src)
	if len(q.ParseFile().BuiltinOpeners) != 0 {
		return fail("TestParseBuiltinOpeners", "a non-collecting parse should record none")
	}
	return ""
}

// A builtin call's operands are inside its parentheses, so a composite literal
// is allowed there even in an `if` / `for` / `switch` header
// (expr.disambiguation.d4-paren) -- for every builtin, in a type's array length
// for those that take only a type -- and the header's suppression is back after
// the call's `)`.
func TestParseBuiltinCompositeInHeader() testing.TestResult {
	var r testing.TestResult = checkBuiltinInHeaders("make([S{1}.n]int)", token.MAKE)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("make_slice(int, S{1}.n)", token.MAKE_SLICE)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("box(S{1})", token.BOX)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("cast(int, S{1})", token.CAST)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("bit_cast(int, S{1})", token.BIT_CAST)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("unsafe_cast(int, S{1})", token.UNSAFE_CAST)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("len(S{1})", token.LEN)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("present(S{1}.i)", token.PRESENT)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("same(S{1}.p, q)", token.SAME)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("unsafe_index(S{1}.a, 0)", token.UNSAFE_INDEX)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("unsafe_div(S{1}.n, 2)", token.UNSAFE_DIV)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("unsafe_rem(S{1}.n, 2)", token.UNSAFE_REM)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("unsafe_shl(S{1}.n, 2)", token.UNSAFE_SHL)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("unsafe_shr(S{1}.n, 2)", token.UNSAFE_SHR)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("sizeof([S{1}.n]int)", token.SIZEOF)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("alignof([S{1}.n]int)", token.ALIGNOF)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("_func_handle(S{1}.f)", token.FUNC_HANDLE)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("__c_call(\"g\", int, S{1})", token.C_CALL)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("__c_global(\"g\", [S{1}.n]int)", token.C_GLOBAL)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeaders("__c_entry(S{1}.f)", token.C_ENTRY)
	if len(r) > 0 { return r }
	return ""
}

// checkBuiltinInHeaders parses call, a builtin call whose operands hold a
// composite literal, in an `if`, a `for` and a `switch` header.
func checkBuiltinInHeaders(call *[]readonly char, op token.Type) testing.TestResult {
	var r testing.TestResult = checkBuiltinInHeader("if", ast.STMT_IF, call, op)
	if len(r) > 0 { return r }
	r = checkBuiltinInHeader("for", ast.STMT_FOR, call, op)
	if len(r) > 0 { return r }
	return checkBuiltinInHeader("switch", ast.STMT_SWITCH, call, op)
}

// checkBuiltinInHeader parses a function whose body is one kw statement with
// the header `call + n` and one statement in its body (in a `case 1:` clause,
// for a switch), and checks that the header is the builtin call (op) plus n:
// were the suppression not back after the call, `n {` would read as a
// composite literal.
func checkBuiltinInHeader(kw *[]readonly char, kind int, call *[]readonly char,
		op token.Type) testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"t\"\nfunc f() {\n\t")
	b.Write(kw)
	b.WriteByte(' ')
	b.Write(call)
	b.Write(" + n {\n")
	if kind == ast.STMT_SWITCH { b.Write("\tcase 1:\n") }
	b.Write("\t\tg()\n\t}\n}\n")
	var src @[]readonly char = b.String()
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 { return fail(src, p.Errors()[0].Msg) }
	var s @ast.Stmt = f.Decls[0].Body.Stmts[0]
	var x @ast.Expr = s.X
	if s.Kind != kind || x == nil || x.Kind != ast.EXPR_BINARY || x.X.Kind != ast.EXPR_BUILTIN ||
			x.X.Op != cast(int, op) || x.Y.Kind != ast.EXPR_IDENT {
		return fail(src, "expected the header `<builtin call> + n`")
	}
	var stmts int = 0
	if kind == ast.STMT_SWITCH {
		if len(s.Cases) == 1 { stmts = len(s.Cases[0].Body) }
	} else {
		stmts = len(s.Body.Stmts)
	}
	if stmts != 1 { return fail(src, "expected one statement in the body") }
	return ""
}

// A builtin keyword missing its `(` opens no parentheses, so what follows it is
// read as in the header: `if len x {` reports the missing `(` and keeps its block.
func TestParseBuiltinWithoutParenInHeader() testing.TestResult {
	var p @Parser = mkParser("package \"t\"\nfunc f() {\n\tif len x {\n\t\tg()\n\t}\n}\n")
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) == 0 {
		return fail("TestParseBuiltinWithoutParenInHeader", "expected the missing `(` reported")
	}
	var s @ast.Stmt = f.Decls[0].Body.Stmts[0]
	if s.Kind != ast.STMT_IF || s.Body == nil || len(s.Body.Stmts) != 1 ||
			s.Body.Stmts[0].Kind != ast.STMT_EXPR || s.Body.Stmts[0].X.Kind != ast.EXPR_CALL {
		return fail("TestParseBuiltinWithoutParenInHeader", "expected the `if` to keep its block, `g()`")
	}
	return ""
}
