package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for ast.CloneDecl on parsed code: a clone of every declaration of a
// program that uses every kind of node shares no node with the original and has
// the same shape.  The walk visits the fields that hold nodes; ast_clone_test.bn
// pins each node type's fields and covers the cleared annotations.

// cloneCorpus uses every kind of declaration, statement, expression, type
// expression and helper node.
var cloneCorpus *[]readonly char = "#[build(!is(os, \"baremetal\"))]\n"
		"package \"test\"\n"
		"import \"pkg/builtins/testing\"\n"
		"const (\n\tA = 1 << iota\n\tB\n)\n"
		"var (\n\tg1 int = 3\n\tg2 [A + B]uint8\n)\n"
		"type Pair[K any, V any] struct {\n\tk K\n\tv V\n}\n"
		"type Fn *func(int, ...int) int\n"
		"type Al = @[]readonly char\n"
		"interface Shower[T any] {\n\tShow(x T) int\n}\n"
		"func (p *Pair[K, V]) Show(x K) int {\n\treturn 1\n}\n"
		"impl *Pair[K, V] : Shower[K]\n"
		"#[build(!is(os, \"baremetal\"))]\n"
		"func sum(xs ...int) int {\n\treturn len(xs)\n}\n"
		"func Gen[T any](xs *[]T, n int) T {\n"
		"\tvar arr [3]int = [3]int{0: 1, 2: 3}\n"
		"\tvar p Pair[int, T]\n"
		"\tvar s *[]readonly char = \"a\" \"b\"\n"
		"\tvar f @func(int) int = func(y int) int { return y + n }\n"
		"\tfor i := 0; i < n; i++ {\n\t\tif i > 1 {\n\t\t\tbreak\n"
		"\t\t} else {\n\t\t\tcontinue\n\t\t}\n\t}\n"
		"\tfor k, v in xs {\n\t\t_ = k\n\t\t_ = v\n\t}\n"
		"\tswitch n {\n\tcase 1, 2:\n\t\tn++\n\tdefault:\n\t\tn = cast(int, sizeof(T))\n\t}\n"
		"\tvar a @any = box(n)\n"
		"\tswitch w := a.(type) {\n\tcase @int:\n\t\t_ = w\n\t}\n"
		"\tconst (\n\t\tL = 2\n\t)\n"
		"\tdefer testing.Println(n, L, sum(arr[1:3]...))\n"
		"\t_, _, _ = p, s, (f(1))\n"
		"\treturn xs[0]\n"
		"}\n"

func TestCloneSharesNoNode() testing.TestResult {
	var p @Parser = mkParser(cloneCorpus)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 {
		return fail("the clone corpus must parse", p.Errors()[0].Msg)
	}
	for i := 0; i < len(f.Decls); i++ {
		var c @ast.Decl = ast.CloneDecl(f.Decls[i])
		var r testing.TestResult = pairDecl(f.Decls[i], c)
		if len(r) != 0 {
			return fail(r, f.Decls[i].Name)
		}
	}
	return ""
}

// pairDecl checks that clone c of declaration d shares no node with it and has
// its shape; "" when it does.
func pairDecl(d @ast.Decl, c @ast.Decl) testing.TestResult {
	if d == nil || c == nil {
		if d != nil || c != nil {
			return "a declaration is nil in only one of original and clone"
		}
		return ""
	}
	if same(d, c) || d.Kind != c.Kind {
		return "a declaration is shared or changed kind"
	}
	if d.Recv != nil || c.Recv != nil {
		if d.Recv == nil || c.Recv == nil || same(d.Recv, c.Recv) {
			return "a receiver is shared or missing"
		}
		var r testing.TestResult = pairType(d.Recv.Type, c.Recv.Type)
		if len(r) != 0 { return r }
	}
	if len(d.TypeParams) != len(c.TypeParams) { return "type parameters differ" }
	for i := 0; i < len(d.TypeParams); i++ {
		if same(d.TypeParams[i], c.TypeParams[i]) { return "a type parameter is shared" }
		var r testing.TestResult = pairType(d.TypeParams[i].Constraint, c.TypeParams[i].Constraint)
		if len(r) != 0 { return r }
	}
	if len(d.Params) != len(c.Params) { return "parameters differ" }
	for i := 0; i < len(d.Params); i++ {
		if same(d.Params[i], c.Params[i]) { return "a parameter is shared" }
		var r testing.TestResult = pairType(d.Params[i].Type, c.Params[i].Type)
		if len(r) != 0 { return r }
	}
	var r testing.TestResult = pairTypes(d.Results, c.Results)
	if len(r) != 0 { return r }
	r = pairStmt(d.Body, c.Body)
	if len(r) != 0 { return r }
	r = pairType(d.TypeRef, c.TypeRef)
	if len(r) != 0 { return r }
	r = pairExpr(d.Value, c.Value)
	if len(r) != 0 { return r }
	if len(d.Decls) != len(c.Decls) { return "grouped declarations differ" }
	for i := 0; i < len(d.Decls); i++ {
		r = pairDecl(d.Decls[i], c.Decls[i])
		if len(r) != 0 { return r }
	}
	r = pairTypes(d.Interfaces, c.Interfaces)
	if len(r) != 0 { return r }
	if len(d.Annotations) != len(c.Annotations) { return "annotations differ" }
	for i := 0; i < len(d.Annotations); i++ {
		if same(d.Annotations[i], c.Annotations[i]) { return "an annotation is shared" }
		r = pairExprs(d.Annotations[i].Args, c.Annotations[i].Args)
		if len(r) != 0 { return r }
	}
	return ""
}

// pairStmt is pairDecl for a statement.
func pairStmt(s @ast.Stmt, c @ast.Stmt) testing.TestResult {
	if s == nil || c == nil {
		if s != nil || c != nil {
			return "a statement is nil in only one of original and clone"
		}
		return ""
	}
	if same(s, c) || s.Kind != c.Kind {
		return "a statement is shared or changed kind"
	}
	if len(s.Stmts) != len(c.Stmts) { return "statement lists differ" }
	for i := 0; i < len(s.Stmts); i++ {
		var r testing.TestResult = pairStmt(s.Stmts[i], c.Stmts[i])
		if len(r) != 0 { return r }
	}
	var r testing.TestResult = pairExprs(s.Exprs, c.Exprs)
	if len(r) != 0 { return r }
	r = pairExprs(s.Exprs2, c.Exprs2)
	if len(r) != 0 { return r }
	r = pairExpr(s.X, c.X)
	if len(r) != 0 { return r }
	r = pairStmt(s.Body, c.Body)
	if len(r) != 0 { return r }
	r = pairStmt(s.Else, c.Else)
	if len(r) != 0 { return r }
	r = pairStmt(s.Init, c.Init)
	if len(r) != 0 { return r }
	r = pairStmt(s.Post, c.Post)
	if len(r) != 0 { return r }
	r = pairExpr(s.ForKey, c.ForKey)
	if len(r) != 0 { return r }
	r = pairExpr(s.ForVal, c.ForVal)
	if len(r) != 0 { return r }
	if len(s.Cases) != len(c.Cases) { return "switch clauses differ" }
	for i := 0; i < len(s.Cases); i++ {
		if same(s.Cases[i], c.Cases[i]) { return "a switch clause is shared" }
		r = pairExprs(s.Cases[i].Exprs, c.Cases[i].Exprs)
		if len(r) != 0 { return r }
		r = pairTypes(s.Cases[i].Types, c.Cases[i].Types)
		if len(r) != 0 { return r }
		if len(s.Cases[i].Body) != len(c.Cases[i].Body) { return "clause bodies differ" }
		for j := 0; j < len(s.Cases[i].Body); j++ {
			r = pairStmt(s.Cases[i].Body[j], c.Cases[i].Body[j])
			if len(r) != 0 { return r }
		}
	}
	return pairDecl(s.DeclRef, c.DeclRef)
}

// pairExpr is pairDecl for an expression.
func pairExpr(e @ast.Expr, c @ast.Expr) testing.TestResult {
	if e == nil || c == nil {
		if e != nil || c != nil {
			return "an expression is nil in only one of original and clone"
		}
		return ""
	}
	if same(e, c) || e.Kind != c.Kind {
		return "an expression is shared or changed kind"
	}
	var r testing.TestResult = pairExpr(e.X, c.X)
	if len(r) != 0 { return r }
	r = pairExpr(e.Y, c.Y)
	if len(r) != 0 { return r }
	r = pairExpr(e.Z, c.Z)
	if len(r) != 0 { return r }
	r = pairExprs(e.Args, c.Args)
	if len(r) != 0 { return r }
	r = pairType(e.TypeRef, c.TypeRef)
	if len(r) != 0 { return r }
	if len(e.Elems) != len(c.Elems) { return "literal elements differ" }
	for i := 0; i < len(e.Elems); i++ {
		if same(e.Elems[i], c.Elems[i]) { return "a literal element is shared" }
		r = pairExpr(e.Elems[i].Key, c.Elems[i].Key)
		if len(r) != 0 { return r }
		r = pairExpr(e.Elems[i].Value, c.Elems[i].Value)
		if len(r) != 0 { return r }
	}
	if len(e.StrParts) != len(c.StrParts) { return "string parts differ" }
	for i := 0; i < len(e.StrParts); i++ {
		if same(e.StrParts[i], c.StrParts[i]) { return "a string part is shared" }
	}
	return pairDecl(e.DeclRef, c.DeclRef)
}

// pairType is pairDecl for a type expression.
func pairType(t @ast.TypeExpr, c @ast.TypeExpr) testing.TestResult {
	if t == nil || c == nil {
		if t != nil || c != nil {
			return "a type expression is nil in only one of original and clone"
		}
		return ""
	}
	if same(t, c) || t.Kind != c.Kind {
		return "a type expression is shared or changed kind"
	}
	var r testing.TestResult = pairType(t.Base, c.Base)
	if len(r) != 0 { return r }
	r = pairExpr(t.Len, c.Len)
	if len(r) != 0 { return r }
	if len(t.Fields) != len(c.Fields) { return "struct fields differ" }
	for i := 0; i < len(t.Fields); i++ {
		if same(t.Fields[i], c.Fields[i]) { return "a struct field is shared" }
		r = pairType(t.Fields[i].Type, c.Fields[i].Type)
		if len(r) != 0 { return r }
	}
	r = pairTypes(t.ParamTypes, c.ParamTypes)
	if len(r) != 0 { return r }
	r = pairTypes(t.ResultTypes, c.ResultTypes)
	if len(r) != 0 { return r }
	return pairTypes(t.TypeArgs, c.TypeArgs)
}

// pairExprs applies pairExpr to two expression lists.
func pairExprs(es *[]@ast.Expr, cs *[]@ast.Expr) testing.TestResult {
	if len(es) != len(cs) { return "expression lists differ" }
	for i := 0; i < len(es); i++ {
		var r testing.TestResult = pairExpr(es[i], cs[i])
		if len(r) != 0 { return r }
	}
	return ""
}

// pairTypes applies pairType to two type-expression lists.
func pairTypes(ts *[]@ast.TypeExpr, cs *[]@ast.TypeExpr) testing.TestResult {
	if len(ts) != len(cs) { return "type-expression lists differ" }
	for i := 0; i < len(ts); i++ {
		var r testing.TestResult = pairType(ts[i], cs[i])
		if len(r) != 0 { return r }
	}
	return ""
}
