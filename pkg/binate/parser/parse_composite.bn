package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// Reinterpretation of already-parsed expressions as the TypeExpr heading a
// generic composite literal `Foo[T1, T2]{ ... }` (§13.10).  When the postfix
// loop (continuePostfix) sees `Name[...]` followed by `{`, the bracketed head was
// parsed as an EXPR_INSTANTIATE_OR_INDEX expression; these helpers convert it
// back into the TEXPR_INSTANTIATE type the composite-literal body parser expects.

// instantiateExprToTypeExpr reinterprets an EXPR_INSTANTIATE_OR_INDEX
// (`Foo[T1, T2]`) as the TEXPR_INSTANTIATE type heading a generic
// composite literal `Foo[T1, T2]{ ... }` (§13.10).  Returns nil unless
// the head is a (possibly package-qualified) type name AND every
// bracket argument converts to a type — so a value index like `arr[i]`
// with a non-type-shaped argument is left alone.
func instantiateExprToTypeExpr(e @ast.Expr) @ast.TypeExpr {
	var base @ast.TypeExpr = exprToCompositeTypeExpr(e.X)
	if base == nil { return nil }
	if base.Kind != ast.TEXPR_NAMED { return nil }
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_INSTANTIATE
	te.Pos = e.Pos
	// Composite-literal type heads are synthesized from already-parsed Exprs,
	// which carry no End yet (Expr.End is deferred), so use a zero-width End
	// (= Pos) rather than an invalid zero span.  Precise end awaits Expr.End.
	te.End = e.Pos
	te.Base = base
	for i := 0; i < len(e.Args); i++ {
		var arg @ast.TypeExpr = exprToCompositeTypeExpr(e.Args[i])
		if arg == nil { return nil }
		te.TypeArgs = slices.Append[@ast.TypeExpr](te.TypeArgs, arg)
	}
	return te
}

// exprToCompositeTypeExpr converts an expression parsed in a bracket
// (the head or a type argument of a would-be composite literal) into a
// TypeExpr, or nil if it has no type spelling.  Mirrors the IR-gen
// exprToTypeExpr set plus the package-qualified (`pkg.T`) and nested-
// generic (`Vec[int]`) forms a composite head can carry.
func exprToCompositeTypeExpr(e @ast.Expr) @ast.TypeExpr {
	if e == nil { return nil }
	// `@T` / `@[]T` / `*[]T` etc. — the parser already wrapped the
	// TypeExpr in EXPR_TYPE (parseBracketTypeArg).
	if e.Kind == ast.EXPR_TYPE { return e.TypeRef }
	if e.Kind == ast.EXPR_IDENT {
		var te @ast.TypeExpr = make(ast.TypeExpr)
		te.Kind = ast.TEXPR_NAMED
		te.Pos = e.Pos
		te.End = e.Pos // zero-width; precise end awaits Expr.End
		te.Name = e.Name
		return te
	}
	// `pkg.T` — a package-qualified named type, starting at its package's name (the
	// selector's Pos is its member's).
	if e.Kind == ast.EXPR_SELECTOR && e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		var te @ast.TypeExpr = make(ast.TypeExpr)
		te.Kind = ast.TEXPR_NAMED
		te.Pos = e.X.Pos
		te.End = e.X.Pos // zero-width; precise end awaits Expr.End
		te.Pkg = e.X.Name
		te.Name = e.Name
		return te
	}
	// `*T` — raw pointer to a type.
	if e.Kind == ast.EXPR_UNARY && e.Op == cast(int, token.STAR) {
		var inner @ast.TypeExpr = exprToCompositeTypeExpr(e.X)
		if inner == nil { return nil }
		var te @ast.TypeExpr = make(ast.TypeExpr)
		te.Kind = ast.TEXPR_POINTER
		te.Pos = e.Pos
		te.End = e.Pos // zero-width; precise end awaits Expr.End
		te.Base = inner
		return te
	}
	// `Vec[int]` — a nested generic instantiation.
	if e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		return instantiateExprToTypeExpr(e)
	}
	return nil
}

// parseCompositeLitBody parses the brace-enclosed body of a composite literal.
func parseCompositeLitBody(p @Parser, typ @ast.TypeExpr) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.expect(token.LBRACE)

	var elems @[]@ast.Element
	if p.tok.Typ != token.RBRACE {
		elems = parseElementList(p)
	}

	p.expect(token.RBRACE)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_COMPOSITE
	e.Pos = pos
	e.TypeRef = typ
	e.Elems = elems
	return e
}

// parseElementList parses a comma-separated list of composite literal elements.
func parseElementList(p @Parser) @[]@ast.Element {
	var elems @[]@ast.Element
	elems = slices.Append[@ast.Element](elems, parseElement(p))
	for p.got(token.COMMA) {
		if p.tok.Typ == token.RBRACE {
			break // trailing comma
		}
		elems = slices.Append[@ast.Element](elems, parseElement(p))
	}
	return elems
}

// parseElement parses a single composite literal element, with optional key: value.
// The element is inside the literal's braces, so a composite literal is allowed in
// it even in an `if` / `for` / `switch` header (D4).  A keyed element's `:` gets a
// record of its own (startHeader), as the Element keeps no position.
func parseElement(p @Parser) @ast.Element {
	var x @ast.Expr = parseExprAllowComposite(p)
	if p.tok.Typ == token.COLON {
		var rec @ast.Header = startHeader(p, p.tok.Pos)
		if rec != nil { rec.Colon = p.tok.Pos }
		p.next()
		var val @ast.Expr = parseExprAllowComposite(p)
		var el @ast.Element = make(ast.Element)
		el.Key = x
		el.Value = val
		return el
	}
	var el @ast.Element = make(ast.Element)
	el.Value = x
	return el
}
