package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/builtins/testing"

// Tests for parse_composite.bn — a composite literal's elements, and the helpers
// that reinterpret a parsed expression as the TypeExpr heading a generic composite
// literal (§13.10).
// exprToCompositeTypeExpr is unit-tested directly (it takes an already-parsed
// Expr); instantiateExprToTypeExpr is covered end-to-end via a composite-literal
// parse.

// mkNamedExpr builds an EXPR_IDENT with the given name (copied into owned
// storage, since the @[]char Name field cannot borrow the readonly argument).
func mkNamedExpr(name *[]readonly char) @ast.Expr {
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_IDENT
	var owned @[]char = make_slice(char, len(name))
	for i := 0; i < len(name); i++ {
		owned[i] = name[i]
	}
	e.Name = owned
	return e
}

// A nil expression converts to nil (no type spelling).
func TestExprToTypeNil() testing.TestResult {
	if exprToCompositeTypeExpr(nil) != nil {
		return fail("TestExprToTypeNil", "nil expr should convert to nil")
	}
	return ""
}

// A bare identifier converts to a TEXPR_NAMED of the same name.
func TestExprToTypeIdent() testing.TestResult {
	var te @ast.TypeExpr = exprToCompositeTypeExpr(mkNamedExpr("Foo"))
	if te == nil || te.Kind != ast.TEXPR_NAMED || !charEq(te.Name, "Foo") {
		return fail("TestExprToTypeIdent", "expected TEXPR_NAMED Foo")
	}
	return ""
}

// A `pkg.T` selector converts to a package-qualified TEXPR_NAMED.
func TestExprToTypeSelector() testing.TestResult {
	var sel @ast.Expr = make(ast.Expr)
	sel.Kind = ast.EXPR_SELECTOR
	sel.X = mkNamedExpr("pkg")
	sel.Name = "T"
	var te @ast.TypeExpr = exprToCompositeTypeExpr(sel)
	if te == nil || te.Kind != ast.TEXPR_NAMED || !charEq(te.Pkg, "pkg") || !charEq(te.Name, "T") {
		return fail("TestExprToTypeSelector", "expected qualified TEXPR_NAMED pkg.T")
	}
	return ""
}

// A `*T` unary converts to TEXPR_POINTER over the inner named type.
func TestExprToTypePointer() testing.TestResult {
	var star @ast.Expr = make(ast.Expr)
	star.Kind = ast.EXPR_UNARY
	star.Op = cast(int, token.STAR)
	star.X = mkNamedExpr("T")
	var te @ast.TypeExpr = exprToCompositeTypeExpr(star)
	if te == nil || te.Kind != ast.TEXPR_POINTER {
		return fail("TestExprToTypePointer", "expected TEXPR_POINTER")
	}
	if te.Base == nil || te.Base.Kind != ast.TEXPR_NAMED || !charEq(te.Base.Name, "T") {
		return fail("TestExprToTypePointer", "expected named base T under the pointer")
	}
	return ""
}

// An expression with no type spelling (e.g. an integer literal) converts to nil,
// so a value index like `arr[3]` is not mistaken for a type argument.
func TestExprToTypeNonType() testing.TestResult {
	var lit @ast.Expr = make(ast.Expr)
	lit.Kind = ast.EXPR_INT_LIT
	if exprToCompositeTypeExpr(lit) != nil {
		return fail("TestExprToTypeNonType", "a non-type expr should convert to nil")
	}
	return ""
}

// End-to-end: `Vec[Pair[int]]{}` heads a composite literal whose TypeRef is a
// TEXPR_INSTANTIATE with a NESTED TEXPR_INSTANTIATE argument — exercising
// instantiateExprToTypeExpr's recursion through exprToCompositeTypeExpr.
func TestInstantiateNestedCompositeParse() testing.TestResult {
	var p @Parser = mkParser("Vec[Pair[int]]{}")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_COMPOSITE {
		return fail("TestInstantiateNestedCompositeParse", "expected EXPR_COMPOSITE")
	}
	if e.TypeRef == nil || e.TypeRef.Kind != ast.TEXPR_INSTANTIATE ||
			!charEq(e.TypeRef.Base.Name, "Vec") {
		return fail("TestInstantiateNestedCompositeParse", "expected a Vec[...] instantiation head")
	}
	if len(e.TypeRef.TypeArgs) != 1 || e.TypeRef.TypeArgs[0].Kind != ast.TEXPR_INSTANTIATE {
		return fail("TestInstantiateNestedCompositeParse", "expected a nested Pair[int] type arg")
	}
	return ""
}

// A comment-collecting parse records each keyed composite element's `:` (its Element
// keeps no position) among the headers, in source order: after the records inside
// its key, before those inside its value.
func TestParseElementColonHeaders() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"var v = T{k: 1, 2, S{n: 3}: 5}\n"
			"var u = T{x: func() { if c { g() } }}\n"
			"func f() {\n"
			"\tw := [2]int{0: 4}\n"
			"}\n"
	var p @Parser = mkCollectingParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 { return fail("TestParseElementColonHeaders", p.Errors()[0].Msg) }
	var hs @[]@ast.Header = f.Headers
	if len(hs) != 8 { return fail("TestParseElementColonHeaders", "expected 8 records") }
	if !atLine(hs[0].Pos, 2, 1) || !colonAt(hs[1], 2, 12) || !colonAt(hs[2], 2, 23) ||
			!colonAt(hs[3], 2, 27) {
		return fail("TestParseElementColonHeaders",
				"v: `var` 2:1, then the `:`s of k 2:12, n 2:23 and S{n: 3} 2:27")
	}
	if !atLine(hs[4].Pos, 3, 1) || !colonAt(hs[5], 3, 12) || !atLine(hs[6].Pos, 3, 23) ||
			hs[6].Colon.Line != 0 {
		return fail("TestParseElementColonHeaders", "u: `var` 3:1, x's `:` 3:12, then the `if` 3:23")
	}
	if !colonAt(hs[7], 5, 15) { return fail("TestParseElementColonHeaders", "the `:` after 0, 5:15") }
	return ""
}

// colonAt reports whether h is the record of a keyed composite element's `:` at
// line:col.
func colonAt(h @ast.Header, line int, col int) bool {
	return atLine(h.Pos, line, col) && atLine(h.Colon, line, col)
}
