}

func TestParseGroupedConst() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst ( A int = 1; B int = 2; C int = 3 )"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseGroupedConst", "expected 1 decl (group)")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_GROUP {
		return fail("TestParseGroupedConst", "expected DECL_GROUP")
	}
	if len(d.Decls) != 3 {
		return fail("TestParseGroupedConst", "expected 3 consts in group")
	}
	return ""
}

// ============================================================
// Interface declarations (plan-interface-syntax-revision.md
// shape) and extension form (plan-interface-embedding.md Slice E.1).
// ============================================================

func TestParseInterfaceEmpty() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ninterface I {\n}\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseInterfaceEmpty", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_INTERFACE {
		return fail("TestParseInterfaceEmpty", "expected DECL_INTERFACE")
	}
	if d.IsAlias {
		return fail("TestParseInterfaceEmpty", "expected IsAlias false")
	}
	if len(d.Interfaces) != 0 {
		return fail("TestParseInterfaceEmpty", "expected no parents")
	}
	if len(d.Decls) != 0 {
		return fail("TestParseInterfaceEmpty", "expected no methods")
	}
	return ""
}

func TestParseInterfaceAlias() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ninterface MyI = I\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseInterfaceAlias", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_INTERFACE {
		return fail("TestParseInterfaceAlias", "expected DECL_INTERFACE")
	}
	if !d.IsAlias {
		return fail("TestParseInterfaceAlias", "expected IsAlias true")
	}
	if d.TypeRef == nil || d.TypeRef.Kind != ast.TEXPR_NAMED ||
			!charEq(d.TypeRef.Name, "I") {
		return fail("TestParseInterfaceAlias",
			"expected TypeRef -> NAMED 'I'")
	}
	return ""
}

func TestParseInterfaceExtendSingleParent() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\ninterface RC : Closer {\n\tRead() int\n}\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseInterfaceExtendSingleParent",
			"expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_INTERFACE {
		return fail("TestParseInterfaceExtendSingleParent",
			"expected DECL_INTERFACE")
	}
	if d.IsAlias {
		return fail("TestParseInterfaceExtendSingleParent",
			"expected IsAlias false")
	}
	if len(d.Interfaces) != 1 {
		return fail("TestParseInterfaceExtendSingleParent",
			"expected 1 parent")
	}
	if d.Interfaces[0].Kind != ast.TEXPR_NAMED ||
			!charEq(d.Interfaces[0].Name, "Closer") {
		return fail("TestParseInterfaceExtendSingleParent",
			"expected parent NAMED 'Closer'")
	}
	if len(d.Decls) != 1 {
		return fail("TestParseInterfaceExtendSingleParent",
			"expected 1 own method")
	}
	return ""
}

func TestParseInterfaceExtendMultiParent() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\ninterface RWC : Reader, Writer, Closer {\n}\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseInterfaceExtendMultiParent",
			"expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if len(d.Interfaces) != 3 {
		return fail("TestParseInterfaceExtendMultiParent",
			"expected 3 parents")
	}
	if !charEq(d.Interfaces[0].Name, "Reader") ||
			!charEq(d.Interfaces[1].Name, "Writer") ||
			!charEq(d.Interfaces[2].Name, "Closer") {
		return fail("TestParseInterfaceExtendMultiParent",
			"expected parents in source order")
	}
	if len(d.Decls) != 0 {
		return fail("TestParseInterfaceExtendMultiParent",
			"expected no own methods")
	}
	return ""
}

func TestParseInterfaceExtendQualifiedParent() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\ninterface MyRC : io.ReadCloser {\n}\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseInterfaceExtendQualifiedParent",
			"expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if len(d.Interfaces) != 1 {
		return fail("TestParseInterfaceExtendQualifiedParent",
			"expected 1 parent")
	}
	if !charEq(d.Interfaces[0].Pkg, "io") ||
			!charEq(d.Interfaces[0].Name, "ReadCloser") {
		return fail("TestParseInterfaceExtendQualifiedParent",
			"expected qualified parent 'io.ReadCloser'")
	}
	return ""
}

func TestParseInterfaceExtendEmptyBody() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\ninterface RC : R, C {\n}\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseInterfaceExtendEmptyBody",
			"expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if len(d.Interfaces) != 2 {
		return fail("TestParseInterfaceExtendEmptyBody",
			"expected 2 parents")
	}
	if len(d.Decls) != 0 {
		return fail("TestParseInterfaceExtendEmptyBody",
			"expected no own methods")
	}
	return ""
}
