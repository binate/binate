package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/builtins/testing"

// ============================================================
// Declaration Tests
// ============================================================
func TestParseVarDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x int = 5"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseVarDecl", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_VAR {
		return fail("TestParseVarDecl", "expected DECL_VAR")
	}
	if !charEq(d.Name, "x") {
		return fail("TestParseVarDecl", "expected name 'x'")
	}
	return ""
}

func TestParseTypeDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype Foo struct { x int; y int }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseTypeDecl", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_TYPE {
		return fail("TestParseTypeDecl", "expected DECL_TYPE")
	}
	if !charEq(d.Name, "Foo") {
		return fail("TestParseTypeDecl", "expected name 'Foo'")
	}
	if d.IsForward {
		return fail("TestParseTypeDecl",
			"struct-form type decl must not be IsForward")
	}
	return ""
}

// Forward declaration: `type S` with no body, no `=`, no underlying
// type expression.  The parser sets Decl.IsForward=true and leaves
// TypeRef nil.  Used in .bni files to declare an opaque type whose
// layout lives in the impl file's `type S struct { ... }`.
// Per plan-type-decls.md Phase 1.
func TestParseTypeForwardDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype Opaque"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseTypeForwardDecl", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_TYPE {
		return fail("TestParseTypeForwardDecl", "expected DECL_TYPE")
	}
	if !charEq(d.Name, "Opaque") {
		return fail("TestParseTypeForwardDecl", "expected name 'Opaque'")
	}
	if !d.IsForward {
		return fail("TestParseTypeForwardDecl",
			"expected IsForward=true for bare `type Name`")
	}
	if d.TypeRef != nil {
		return fail("TestParseTypeForwardDecl",
			"forward decl must have nil TypeRef")
	}
	if d.IsAlias {
		return fail("TestParseTypeForwardDecl",
			"forward decl must not be IsAlias")
	}
	return ""
}

// Grouped forward declarations: `type ( A; B; C )`.  Each spec ends
// at a SEMICOLON; the parser must treat that as the forward-decl
// terminator inside the group rather than reading the next IDENT as
// a distinct-type underlying.
func TestParseTypeForwardDeclInGroup() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\ntype ( A; B; C )"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseTypeForwardDeclInGroup",
			"expected 1 group decl")
	}
	var g @ast.Decl = f.Decls[0]
	if g.Kind != ast.DECL_GROUP {
		return fail("TestParseTypeForwardDeclInGroup",
			"expected DECL_GROUP")
	}
	if len(g.Decls) != 3 {
		return fail("TestParseTypeForwardDeclInGroup",
			"expected 3 grouped decls")
	}
	for i := 0; i < 3; i++ {
		if !g.Decls[i].IsForward {
			return fail("TestParseTypeForwardDeclInGroup",
				"each grouped spec must be IsForward")
		}
	}
	return ""
}

// Distinct-type form (`type X T`) must NOT be treated as a forward
// decl just because the next token after the name is an IDENT —
// the existing distinct-type path stays intact.
func TestParseTypeDistinctNotForward() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype MyInt int"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseTypeDistinctNotForward", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.IsForward {
		return fail("TestParseTypeDistinctNotForward",
			"distinct-type form must not be IsForward")
	}
	if d.TypeRef == nil {
		return fail("TestParseTypeDistinctNotForward",
			"distinct-type form must have a TypeRef")
	}
	return ""
}

// Generic struct decl: `type List[T any] struct { ... }`.
// Parser populates Decl.TypeParams on DECL_TYPE.  Per
// plan-generics.md Slice 5.
func TestParseGenericStructDecl() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\ntype List[T any] struct { head T; next int }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseGenericStructDecl", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_TYPE {
		return fail("TestParseGenericStructDecl", "expected DECL_TYPE")
	}
	if len(d.TypeParams) != 1 {
		return fail("TestParseGenericStructDecl",
			"expected 1 type parameter")
	}
	if !charEq(d.TypeParams[0].Name, "T") {
		return fail("TestParseGenericStructDecl",
			"expected type param 'T'")
	}
	if d.TypeRef == nil || d.TypeRef.Kind != ast.TEXPR_STRUCT {
		return fail("TestParseGenericStructDecl",
			"expected struct body")
	}
	return ""
}

// Named fixed-array type: `type Row [3]int`.  Grammar D11 must route
// the `[` after the name to the array-type (distinct-type) path, not
// the generic type-param path — so `d` is a distinct type whose
// TypeRef is a TEXPR_ARRAY, with no TypeParams.
func TestParseNamedArrayType() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\ntype Row [3]int"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 {
		return fail("TestParseNamedArrayType", "expected no parse errors")
	}
	if len(f.Decls) != 1 {
		return fail("TestParseNamedArrayType", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_TYPE {
		return fail("TestParseNamedArrayType", "expected DECL_TYPE")
	}
	if !charEq(d.Name, "Row") {
		return fail("TestParseNamedArrayType", "expected name 'Row'")
	}
	if len(d.TypeParams) != 0 {
		return fail("TestParseNamedArrayType",
			"named array must not have type params")
	}
	if d.IsAlias || d.IsForward {
		return fail("TestParseNamedArrayType",
			"named array is a distinct type, not alias/forward")
	}
	if d.TypeRef == nil || d.TypeRef.Kind != ast.TEXPR_ARRAY {
		return fail("TestParseNamedArrayType",
			"expected TEXPR_ARRAY TypeRef")
	}
	if d.TypeRef.Len == nil {
		return fail("TestParseNamedArrayType",
			"array type must carry a length expression")
	}
	return ""
}

// Named array type with a single-identifier size: `type Row [SIZE]int`.
// D11 sees t1=IDENT, t2=`]` (RBRACKET) → array, not type params.
func TestParseNamedArrayTypeIdentSize() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\ntype Row [SIZE]int"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 {
		return fail("TestParseNamedArrayTypeIdentSize",
			"expected no parse errors")
	}
	var d @ast.Decl = f.Decls[0]
	if len(d.TypeParams) != 0 {
		return fail("TestParseNamedArrayTypeIdentSize",
			"single-ident size must not parse as type params")
	}
	if d.TypeRef == nil || d.TypeRef.Kind != ast.TEXPR_ARRAY {
		return fail("TestParseNamedArrayTypeIdentSize",
			"expected TEXPR_ARRAY TypeRef")
	}
	return ""
}

// Generic distinct type (non-struct body): `type Alias[T any] *T`.
// D11 sees t1=IDENT (`T`), t2=IDENT (`any`) → type params; the body
// after the list parses as the distinct underlying type.
func TestParseGenericDistinctType() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\ntype Alias[T any] *T"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 {
		return fail("TestParseGenericDistinctType",
			"expected no parse errors")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_TYPE {
		return fail("TestParseGenericDistinctType", "expected DECL_TYPE")
	}
	if len(d.TypeParams) != 1 || !charEq(d.TypeParams[0].Name, "T") {
		return fail("TestParseGenericDistinctType",
			"expected 1 type param 'T'")
	}
	if d.TypeRef == nil || d.TypeRef.Kind != ast.TEXPR_POINTER {
		return fail("TestParseGenericDistinctType",
			"expected pointer-type distinct body")
	}
	return ""
}

// Generic type instantiation in type position: `var v List[int]`.
// Parser produces TEXPR_INSTANTIATE for the type expression.
func TestParseGenericTypeInstantiation() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nvar v List[int]"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseGenericTypeInstantiation", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.TypeRef == nil ||
			d.TypeRef.Kind != ast.TEXPR_INSTANTIATE {
		return fail("TestParseGenericTypeInstantiation",
			"expected TEXPR_INSTANTIATE")
	}
	if d.TypeRef.Base == nil ||
			d.TypeRef.Base.Kind != ast.TEXPR_NAMED ||
			!charEq(d.TypeRef.Base.Name, "List") {
		return fail("TestParseGenericTypeInstantiation",
			"expected head 'List'")
	}
	if len(d.TypeRef.TypeArgs) != 1 {
		return fail("TestParseGenericTypeInstantiation",
			"expected 1 type arg")
	}
	if d.TypeRef.TypeArgs[0].Kind != ast.TEXPR_NAMED ||
			!charEq(d.TypeRef.TypeArgs[0].Name, "int") {
		return fail("TestParseGenericTypeInstantiation",
			"expected type arg 'int'")
	}
	return ""
}

// Multi-arg instantiation: `var m Map[int, bool]`.
func TestParseGenericTypeInstantiationMultiArg() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nvar m Map[int, bool]"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	var d @ast.Decl = f.Decls[0]
	if d.TypeRef == nil ||
			d.TypeRef.Kind != ast.TEXPR_INSTANTIATE {
		return fail("TestParseGenericTypeInstantiationMultiArg",
			"expected TEXPR_INSTANTIATE")
	}
	if len(d.TypeRef.TypeArgs) != 2 {
		return fail("TestParseGenericTypeInstantiationMultiArg",
			"expected 2 type args")
	}
	return ""
}

// Package-qualified instantiation: `pkg.List[int]`.  Head should
// be a TEXPR_NAMED with both Pkg and Name set.
func TestParseGenericTypeInstantiationQualified() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nvar v mypkg.List[int]"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	var d @ast.Decl = f.Decls[0]
	if d.TypeRef == nil ||
			d.TypeRef.Kind != ast.TEXPR_INSTANTIATE {
		return fail("TestParseGenericTypeInstantiationQualified",
			"expected TEXPR_INSTANTIATE")
	}
	if d.TypeRef.Base == nil ||
			!charEq(d.TypeRef.Base.Pkg, "mypkg") ||
			!charEq(d.TypeRef.Base.Name, "List") {
		return fail("TestParseGenericTypeInstantiationQualified",
			"expected head 'mypkg.List'")
	}
	return ""
}

// Impl-interface ref with a generic-interface instantiation:
// `impl Foo : Container[int]`.  Parser produces a
// TEXPR_INSTANTIATE for the iface ref so downstream layers can
// pick up the type args.  Per plan-generics.md Slice 6c.
func TestParseImplOnGenericIfaceInstantiation() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"type Foo struct { x int }\n"
		"interface Container[T any] { get() T }\n"
		"impl Foo : Container[int]\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 3 {
		return fail("TestParseImplOnGenericIfaceInstantiation",
			"expected 3 decls")
	}
	var implDecl @ast.Decl = f.Decls[2]
	if implDecl.Kind != ast.DECL_IMPL {
		return fail("TestParseImplOnGenericIfaceInstantiation",
			"expected DECL_IMPL")
	}
	if len(implDecl.Interfaces) != 1 {
		return fail("TestParseImplOnGenericIfaceInstantiation",
			"expected 1 iface ref")
	}
	var ref @ast.TypeExpr = implDecl.Interfaces[0]
	if ref.Kind != ast.TEXPR_INSTANTIATE {
		return fail("TestParseImplOnGenericIfaceInstantiation",
			"expected TEXPR_INSTANTIATE iface ref")
	}
	if ref.Base == nil ||
			ref.Base.Kind != ast.TEXPR_NAMED ||
			!charEq(ref.Base.Name, "Container") {
		return fail("TestParseImplOnGenericIfaceInstantiation",
			"expected head 'Container'")
	}
	if len(ref.TypeArgs) != 1 {
		return fail("TestParseImplOnGenericIfaceInstantiation",
			"expected 1 type arg")
	}
	return ""
}

// Generic interface decl: `interface Container[T any] { ... }`.
// Parser populates Decl.TypeParams on DECL_INTERFACE.  Per
// plan-generics.md Slice 6.
func TestParseGenericInterfaceDecl() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"interface Container[T any] { get(i int) T }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseGenericInterfaceDecl", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_INTERFACE {
		return fail("TestParseGenericInterfaceDecl",
			"expected DECL_INTERFACE")
	}
	if len(d.TypeParams) != 1 {
		return fail("TestParseGenericInterfaceDecl",
			"expected 1 type parameter")
	}
	if !charEq(d.TypeParams[0].Name, "T") {
		return fail("TestParseGenericInterfaceDecl",
			"expected type param 'T'")
	}
	if len(d.Decls) != 1 {
		return fail("TestParseGenericInterfaceDecl",
			"expected 1 method in body")
	}
	return ""
}

func TestParseTypeAlias() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype MyInt = int"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseTypeAlias", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_TYPE {
		return fail("TestParseTypeAlias", "expected DECL_TYPE")
	}
	if !d.IsAlias {
		return fail("TestParseTypeAlias", "expected IsAlias true")
	}
	return ""
}

