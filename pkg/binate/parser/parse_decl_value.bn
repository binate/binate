package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// Parsing of `var` and `const` declarations, single and grouped.

// parseVarDecl parses a var declaration, single or grouped.
func parseVarDecl(p @Parser) @ast.Decl {
	var pos token.Pos = p.tok.Pos
	p.expect(token.VAR)

	if p.tok.Typ == token.LPAREN {
		// Grouped var declarations
		p.next()
		var decls @[]@ast.Decl
		for p.tok.Typ != token.RPAREN && p.tok.Typ != token.EOF {
			decls = slices.Append[@ast.Decl](decls, parseVarSpec(p, pos, true))
			if !p.got(token.SEMICOLON) {
				break
			}
		}
		p.expect(token.RPAREN)
		if len(decls) == 1 {
			return decls[0]
		}
		var d @ast.Decl = make(ast.Decl)
		d.Kind = ast.DECL_GROUP
		d.Pos = pos
		d.Decls = decls
		return d
	}

	return parseVarSpec(p, pos, false)
}

// parseVarSpec parses a single var spec: name with optional type and/or
// initializer.  A member of a grouped `var ( … )` is positioned at its own
// name, so a diagnostic about one member points at it; a single var at `var`.
func parseVarSpec(p @Parser, varPos token.Pos, grouped bool) @ast.Decl {
	var nameTok token.Token = p.expect(token.IDENT)
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_VAR
	d.Pos = varPos
	if grouped {
		d.Pos = nameTok.Pos
	}
	d.Name = nameTok.Lit

	if p.tok.Typ == token.ASSIGN {
		// var x = expr (type inferred)
		p.next()
		d.Value = parseExpr(p)
	} else {
		// var x T or var x T = expr
		d.TypeRef = parseType(p)
		if p.got(token.ASSIGN) {
			d.Value = parseExpr(p)
		}
	}
	d.End = endFrom(d.Pos, p.prev.End)
	return d
}

// parseConstDecl parses a const declaration, single or grouped.
func parseConstDecl(p @Parser) @ast.Decl {
	var pos token.Pos = p.tok.Pos
	p.expect(token.CONST)

	if p.tok.Typ == token.LPAREN {
		// Grouped const
		p.next()
		var decls @[]@ast.Decl
		for p.tok.Typ != token.RPAREN && p.tok.Typ != token.EOF {
			decls = slices.Append[@ast.Decl](decls, parseConstSpec(p, pos, true))
			if !p.got(token.SEMICOLON) {
				break
			}
		}
		p.expect(token.RPAREN)
		// A parenthesized const block is a GROUP regardless of member count —
		// the grouped form is what binds `iota` (§9.1 decl.const.iota), so a
		// single-member `const ( X int = iota )` must keep its DECL_GROUP
		// identity (iota=0) rather than collapse to a bare DECL_CONST (which
		// is the non-grouped `const X int = iota` form, where iota is undefined).
		var d @ast.Decl = make(ast.Decl)
		d.Kind = ast.DECL_GROUP
		d.Pos = pos
		d.Decls = decls
		return d
	}

	return parseConstSpec(p, pos, false)
}

// parseConstSpec parses a single const spec with optional type and value.  A
// member of a grouped `const ( … )` is positioned at its own name, so a
// diagnostic about one member points at it; a single const at `const`.
func parseConstSpec(p @Parser, constPos token.Pos, grouped bool) @ast.Decl {
	var nameTok token.Token = p.expect(token.IDENT)
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_CONST
	d.Pos = constPos
	if grouped {
		d.Pos = nameTok.Pos
	}
	d.Name = nameTok.Lit

	if p.tok.Typ == token.ASSIGN {
		// const x = expr
		p.next()
		d.Value = parseExpr(p)
	} else if p.tok.Typ != token.SEMICOLON && p.tok.Typ != token.RPAREN {
		// const x T = expr.  Once a type is present §9's ConstSpec makes
		// the `=` value MANDATORY (the only value-less form is a bare
		// identifier — no type — repeating the previous value inside a
		// grouped `const ( … )`, which lands in the no-Value fall-through
		// below because its current token is SEMICOLON / RPAREN).
		d.TypeRef = parseType(p)
		if p.got(token.ASSIGN) {
			d.Value = parseExpr(p)
		} else {
			p.errMsg("const declaration with a type requires a value")
		}
	}
	d.End = endFrom(d.Pos, p.prev.End)
	return d
}
