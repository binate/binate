package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for parse_decl_value.bn: `var` and `const` declarations.

func TestParseVarDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x int = 5"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseVarDecl", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_VAR {
		return fail("TestParseVarDecl", "expected DECL_VAR")
	}
	if !charEq(d.Name, "x") {
		return fail("TestParseVarDecl", "expected name 'x'")
	}
	return ""
}

func TestParseConstDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst X int = 42"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseConstDecl", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_CONST {
		return fail("TestParseConstDecl", "expected DECL_CONST")
	}
	return ""
}

func TestParseGroupedConst() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst ( A int = 1; B int = 2; C int = 3 )"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseGroupedConst", "expected 1 decl (group)")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_GROUP {
		return fail("TestParseGroupedConst", "expected DECL_GROUP")
	}
	if len(d.Decls) != 3 {
		return fail("TestParseGroupedConst", "expected 3 consts in group")
	}
	return ""
}

// A SINGLE-member parenthesized const block must keep its DECL_GROUP identity
// (not collapse to a bare DECL_CONST) -- the grouped form is what binds `iota`
// (decl.const.iota), so `const ( X int = iota )` must parse as a group of one,
// distinct from the non-grouped `const X int = iota` (which is undefined: iota).
func TestParseSingleMemberConstGroup() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst ( X int = 0 )"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 {
		return fail("TestParseSingleMemberConstGroup",
				"a single-member const group must parse without error")
	}
	if len(f.Decls) != 1 {
		return fail("TestParseSingleMemberConstGroup", "expected 1 decl (group)")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_GROUP {
		return fail("TestParseSingleMemberConstGroup",
				"a parenthesized single-member const must be DECL_GROUP, not DECL_CONST")
	}
	if len(d.Decls) != 1 {
		return fail("TestParseSingleMemberConstGroup", "expected 1 const in group")
	}
	return ""
}

// A const with a declared type but no value is a syntax error (§9:
// `=` is mandatory once a Type is present). Accepting `const X int`
// would record a value-less DECL_CONST that breaks at use.
func TestParseConstTypedNoValueRejected() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst X int"
	var p @Parser = mkParser(src)
	p.ParseFile()
	if len(p.Errors()) == 0 {
		return fail("TestParseConstTypedNoValueRejected",
				"const with a type and no value must be a parse error")
	}
	return ""
}

// The §9 value-less EXCEPTION: a bare identifier (no type, no `=`)
// inside a group repeats the previous value. This must keep parsing
// cleanly — it's what the typed-no-value rejection above must NOT
// catch (the distinction is the presence of a type).
func TestParseGroupedConstBareRepeat() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst ( A = 1; B )"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 {
		return fail("TestParseGroupedConstBareRepeat",
				"a bare-identifier const repeat must parse without error")
	}
	var g @ast.Decl = f.Decls[0]
	if g.Kind != ast.DECL_GROUP || len(g.Decls) != 2 {
		return fail("TestParseGroupedConstBareRepeat", "expected a 2-member const group")
	}
	var b @ast.Decl = g.Decls[1]
	if b.TypeRef != nil || b.Value != nil {
		return fail("TestParseGroupedConstBareRepeat", "bare repeat B must have no type and no value")
	}
	return ""
}

// A member of a grouped `var ( … )` or `const ( … )` is positioned at its own
// name; a single declaration at its keyword.
func TestParseGroupedMemberPositions() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar (\n\ta int\n\tb int\n)\n"
			"const (\n\tC = 1\n\tD\n)\nvar e int\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 3 {
		return fail("TestParseGroupedMemberPositions", "expected 3 decls")
	}
	var vg @ast.Decl = f.Decls[0]
	var cg @ast.Decl = f.Decls[1]
	if vg.Decls[0].Pos.Line != 3 || vg.Decls[1].Pos.Line != 4 || vg.Decls[1].Pos.Col != 2 {
		return fail("TestParseGroupedMemberPositions", "var group members must be at their names")
	}
	if cg.Decls[0].Pos.Line != 7 || cg.Decls[1].Pos.Line != 8 {
		return fail("TestParseGroupedMemberPositions", "const group members must be at their names")
	}
	if f.Decls[2].Pos.Line != 10 || f.Decls[2].Pos.Col != 1 {
		return fail("TestParseGroupedMemberPositions", "a single var must be at `var`")
	}
	return ""
}

// A parenthesized `var` or `type` block of one member is a group too, as a const
// one is, so the formatter keeps its form and the comments around its parentheses.
func TestParseSingleMemberVarAndTypeGroups() testing.TestResult {
	var srcs [2]*[]readonly char
	srcs[0] = "package \"test\"\nvar ( x int )"
	srcs[1] = "package \"test\"\ntype ( T int )"
	var kinds [2]int
	kinds[0] = ast.DECL_VAR
	kinds[1] = ast.DECL_TYPE
	for i := 0; i < 2; i++ {
		var p @Parser = mkParser(srcs[i])
		var f @ast.File = p.ParseFile()
		if len(p.Errors()) != 0 || len(f.Decls) != 1 {
			return fail("TestParseSingleMemberVarAndTypeGroups", "expected 1 decl and no error")
		}
		var d @ast.Decl = f.Decls[0]
		if d.Kind != ast.DECL_GROUP || len(d.Decls) != 1 || d.Decls[0].Kind != kinds[i] {
			return fail("TestParseSingleMemberVarAndTypeGroups",
					"a parenthesized single-member var or type must be a DECL_GROUP of one")
		}
	}
	return ""
}

// A one-member group spans its parentheses, at top level and as a local statement: the
// group (and the statement) at the keyword, its End on the `)` line, and its member at
// its name, ending on its own line.
func TestParseSingleMemberGroupPositions() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"var (\n"
			"\tx int\n"
			")\n"
			"func f() {\n"
			"\tvar (\n"
			"\t\ty = 1\n"
			"\t)\n"
			"}\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 || len(f.Decls) != 2 {
		return fail("TestParseSingleMemberGroupPositions", "expected 2 decls and no error")
	}
	var g @ast.Decl = f.Decls[0]
	if g.Kind != ast.DECL_GROUP || len(g.Decls) != 1 {
		return fail("TestParseSingleMemberGroupPositions", "top level: expected a DECL_GROUP of one")
	}
	if g.Pos.Line != 2 || g.Pos.Col != 1 || g.End.Line != 4 {
		return fail("TestParseSingleMemberGroupPositions", "top level: the group must span `var` to `)`")
	}
	if g.Decls[0].Pos.Line != 3 || g.Decls[0].Pos.Col != 2 || g.Decls[0].End.Line != 3 {
		return fail("TestParseSingleMemberGroupPositions",
				"top level: the member must be at its name, on its line")
	}
	var body @ast.Stmt = f.Decls[1].Body
	if body == nil || len(body.Stmts) != 1 {
		return fail("TestParseSingleMemberGroupPositions", "local: expected one statement")
	}
	var s @ast.Stmt = body.Stmts[0]
	if s.Kind != ast.STMT_DECL || s.DeclRef == nil || s.DeclRef.Kind != ast.DECL_GROUP ||
			len(s.DeclRef.Decls) != 1 {
		return fail("TestParseSingleMemberGroupPositions",
				"local: expected a STMT_DECL of a DECL_GROUP of one")
	}
	if s.Pos.Line != 6 || s.Pos.Col != 2 || s.DeclRef.Pos.Line != 6 || s.DeclRef.End.Line != 8 {
		return fail("TestParseSingleMemberGroupPositions", "local: the group must span `var` to `)`")
	}
	var m @ast.Decl = s.DeclRef.Decls[0]
	if m.Pos.Line != 7 || m.Pos.Col != 3 || m.End.Line != 7 {
		return fail("TestParseSingleMemberGroupPositions",
				"local: the member must be at its name, on its line")
	}
	return ""
}
