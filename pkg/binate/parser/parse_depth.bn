package "pkg/binate/parser"

import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strconv"

// The nesting depth of a source file's expressions, statements and blocks (spec
// pkg.source.nesting), which may not pass an implementation limit.  Each such construct
// is one level deeper than the one it is directly part of; a chain of left-grouping
// links -- binary operators, or the selectors, calls and indexes after an operand --
// holds its first operand as many levels deep as it has links (nestChain).
// Past the limit the file is reported once -- where the construct passing it starts, or
// where a chain does -- and not parsed further: the parser recurses a level at a time,
// as the passes after it walk the syntax tree a level at a time, so the limit bounds
// them all.  Type expressions do not count -- type.named.depth bounds a type's nesting
// -- but for a parenthesized type, the one form that adds no type depth: its type is a
// level below its parentheses.  An expression within a type counts from where the type
// is.

// maxNesting is how deeply a source file's expressions, statements and blocks may nest
// (pkg.source.nesting).
const maxNesting int = 512

// enterLevel enters a construct one level deeper than the one being parsed; past the
// limit, the nesting is reported there (tooDeep).
func enterLevel(p @Parser) {
	p.depth = p.depth + 1
	if p.depth > p.reached { p.reached = p.depth }
	if p.depth > maxNesting { tooDeep(p, p.tok.Pos) }
}

// leaveLevel leaves the construct enterLevel entered.
func leaveLevel(p @Parser) {
	p.depth = p.depth - 1
}

// tooDeep reports, at pos, a nesting past the limit, unless one is reported already,
// and has the parser read no more of the file: from here on every token is the file's
// end (next, peekTok, peekTok2), so the parse unwinds with nothing more to report
// (addError).
func tooDeep(p @Parser, pos token.Pos) {
	if p.tooDeep { return }
	p.addError(pos,
			buf.Concat("expressions, statements and blocks nest too deeply: more than ",
					buf.Concat(strconv.Itoa(maxNesting), " levels")))
	p.tooDeep = true
	p.tok.Typ = token.EOF
}

// A nestChain follows a chain of left-grouping links being parsed -- the binary
// operators folded onto an operand (`a * b + c`), or the selectors, calls and indexes
// after one (`a.b(c)[d]`) -- whose first operand ends up as many levels below the chain's root as
// the chain has links, its k-th link's parts k fewer.  The links are not known until
// the chain ends, so its first operand and each link's parts are parsed at the root's
// level, each measured from there (p.reached), and the chain's own depth is taken when
// it ends (endChain): the root's level, the links, and the most any operand reaches
// past its place less the links it is above (extra).
type nestChain struct {
	pos   token.Pos // where the chain starts
	saved int // p.reached before the chain
	links int
	extra int
}

// beginChain starts following a chain at the level being parsed, after its first
// operand, parsed already with nothing below it (a name).
func beginChain(p @Parser) nestChain {
	var c nestChain
	c.pos = p.tok.Pos
	c.saved = p.reached
	p.reached = p.depth
	return c
}

// chainAfter starts following a chain once a link follows its first operand, at pos,
// just parsed at the level being parsed and measured from there (p.reached), the reach
// before it saved.  An operand no link follows is not a chain: its parse keeps only the
// reach, max(saved, p.reached), with no chain followed.
func chainAfter(p @Parser, saved int, pos token.Pos) nestChain {
	var c nestChain
	c.pos = pos
	c.saved = saved
	c.extra = p.reached - p.depth
	p.reached = p.depth
	return c
}

// chainLink records a link of the chain c whose parts were just parsed: an operand that
// is the link's own child (child: a binary operator's right operand), or parts entered
// a level down as they were parsed (a call's arguments).  The chain's depth only grows
// with its links, so one past the limit is reported at once (tooDeep), and the chain
// ends at the next link, with no more of it built.
func chainLink(p @Parser, c *nestChain, child bool) {
	c.links = c.links + 1
	var r int = p.reached - p.depth
	if child { r = r + 1 }
	if r - c.links > c.extra { c.extra = r - c.links }
	p.reached = p.depth
	if p.depth + c.links + c.extra > maxNesting { tooDeep(p, c.pos) }
}

// endChain ends the chain c: the deepest level it reaches is kept (p.reached), and
// reported past the limit, at the chain's start (tooDeep).
func endChain(p @Parser, c *nestChain) {
	var deepest int = p.depth + c.links + c.extra
	if deepest > c.saved {
		p.reached = deepest
	} else {
		p.reached = c.saved
	}
	if deepest > maxNesting { tooDeep(p, c.pos) }
}
