package "pkg/binate/parser"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for parse_depth.bn: how deeply a source file's expressions, statements and
// blocks may nest (maxNesting levels), counted as pkg.source.nesting counts them.

// nestMsg begins the error a nesting past the limit reports.
var nestMsg readonly *[]readonly char = "expressions, statements and blocks nest too deeply"

// repeat writes s n times to b.
func repeat(b @strings.Builder, s *[]readonly char, n int) {
	for i := 0; i < n; i++ { b.Write(s) }
}

// nestingErrs parses the file b holds and returns how many errors it reports and
// whether the first is the nesting's.
func nestingErrs(b @strings.Builder) (int, bool) {
	var p @Parser = mkParser(buf.CopyStr(b.String()))
	_ = p.ParseFile()
	var errs @[]ParseError = p.Errors()
	if len(errs) == 0 { return 0, false }
	var m @[]char = errs[0].Msg
	return len(errs), len(m) >= len(nestMsg) && charEq(m[:len(nestMsg)], nestMsg)
}

// nestedAt checks that fill's file, given n, parses with no error at n = ok, and with
// only the nesting's at n = ok + 1 -- one level past the limit.
func nestedAt(what *[]readonly char, ok int, fill *func(@strings.Builder, int)) testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	fill(b, ok)
	n, _ := nestingErrs(b)
	if n != 0 { return fail(what, "an error at the limit") }
	b = strings.NewBuilder()
	fill(b, ok + 1)
	var nest bool
	n, nest = nestingErrs(b)
	if n != 1 || !nest { return fail(what, "no single nesting error past the limit") }
	return ""
}

// parensSrc writes a variable whose initializer is 1 in n parentheses: n + 1 levels.
func parensSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x int = ")
	repeat(b, "(", n)
	b.Write("1")
	repeat(b, ")", n)
	b.Write("\n")
}

// sumSrc writes a variable whose initializer adds n ones to 1: the first 1 is n levels
// below the initializer's sum, n + 1 levels in all.
func sumSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x int = 1")
	repeat(b, " + 1", n)
	b.Write("\n")
}

// unarySrc writes a variable whose initializer negates 1 n times: n + 1 levels.
func unarySrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x int = ")
	repeat(b, "- ", n)
	b.Write("1\n")
}

// selectorSrc writes a variable whose initializer selects n fields in turn: n + 1
// levels.
func selectorSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x int = a")
	repeat(b, ".b", n)
	b.Write("\n")
}

// callSrc writes a variable whose initializer calls n times in turn: n + 1 levels.
func callSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x int = f")
	repeat(b, "()", n)
	b.Write("\n")
}

// blocksSrc writes a function whose body holds n blocks, each in the last: the body,
// then a statement and its block for each, 2n + 1 levels.
func blocksSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nfunc f() {")
	repeat(b, " {", n)
	repeat(b, " }", n)
	b.Write(" }\n")
}

// elseIfSrc writes a function whose body is an `if` with n `else if`s: the body, the
// `if`, an `if` for each `else if`, the last's condition and its comparison's operand,
// n + 4 levels.
func elseIfSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nfunc f(y int) {\n\tif y == 0 {\n\t}")
	repeat(b, " else if y == 1 {\n\t}", n)
	b.Write("\n}\n")
}

// deepOperandSumSrc writes a variable whose initializer adds n ones to 1 in 300
// parentheses: the first operand is n levels below the sum, its 1 300 levels below it,
// n + 301 levels in all.
func deepOperandSumSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x int = ")
	repeat(b, "(", 300)
	b.Write("1")
	repeat(b, ")", 300)
	repeat(b, " + 1", n)
	b.Write("\n")
}

// deepOperandSelectorSrc is deepOperandSumSrc with n selectors on a name in 300
// parentheses.
func deepOperandSelectorSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x int = ")
	repeat(b, "(", 300)
	b.Write("a")
	repeat(b, ")", 300)
	repeat(b, ".b", n)
	b.Write("\n")
}

// forSumSrc writes a function whose body is a `for` comparing i plus n ones to 0 (read
// by the for-clause's own expression parse): the body, the `for`, its condition, then
// the comparison and n sums over i, n + 4 levels.
func forSumSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nfunc f(i int) {\n\tfor i")
	repeat(b, " + 1", n)
	b.Write(" < 0 {\n\t}\n}\n")
}

// Each kind of nesting is accepted up to the limit and reported one level past it.
func TestNestingToTheLimit() testing.TestResult {
	var r testing.TestResult = nestedAt("parentheses", maxNesting - 1, parensSrc)
	if len(r) == 0 { r = nestedAt("a sum", maxNesting - 1, sumSrc) }
	if len(r) == 0 { r = nestedAt("negations", maxNesting - 1, unarySrc) }
	if len(r) == 0 { r = nestedAt("selectors", maxNesting - 1, selectorSrc) }
	if len(r) == 0 { r = nestedAt("calls", maxNesting - 1, callSrc) }
	if len(r) == 0 { r = nestedAt("else ifs", maxNesting - 4, elseIfSrc) }
	if len(r) == 0 { r = nestedAt("a for clause's sum", maxNesting - 4, forSumSrc) }
	return r
}

// A chain's first operand is as many levels below it as the chain has links, its own
// nesting below that.
func TestNestingChainOperand() testing.TestResult {
	var r testing.TestResult = nestedAt("a sum's operand", maxNesting - 301, deepOperandSumSrc)
	if len(r) == 0 { r = nestedAt("a selector's operand", maxNesting - 301, deepOperandSelectorSrc) }
	return r
}

// Blocks nest two levels each, as statements holding blocks: 255 of them reach 511
// levels, 256 513.
func TestNestingBlocks() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	blocksSrc(b, maxNesting / 2 - 1)
	n, _ := nestingErrs(b)
	if n != 0 { return fail("blocks", "an error at the limit") }
	b = strings.NewBuilder()
	blocksSrc(b, maxNesting / 2)
	var nest bool
	n, nest = nestingErrs(b)
	if n != 1 || !nest { return fail("blocks", "no single nesting error past the limit") }
	return ""
}

// Type expressions do not count (type.named.depth bounds them), and an expression
// within a type counts from where the type is.
func TestNestingTypesDoNotCount() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\nvar x ")
	repeat(b, "[1]", 2000)
	b.Write("[")
	repeat(b, "(", maxNesting - 1)
	b.Write("1")
	repeat(b, ")", maxNesting - 1)
	b.Write("]int\n")
	n, _ := nestingErrs(b)
	if n != 0 { return fail("types", "an error") }
	return ""
}

// Past the limit the file is reported once and not parsed further, wherever the
// nesting is: in a function literal's body, a composite literal's elements, a call's
// arguments, a `for` clause, a `switch`'s case.
func TestNestingPastTheLimitStops() testing.TestResult {
	var heads @[]@[]char = make_slice(@[]char, 5)
	var opens @[]@[]char = make_slice(@[]char, 5)
	var closes @[]@[]char = make_slice(@[]char, 5)
	heads[0] = buf.CopyStr("package \"main\"\nvar f = ")
	opens[0] = buf.CopyStr("func() { _ = ")
	closes[0] = buf.CopyStr(" }")
	heads[1] = buf.CopyStr("package \"main\"\nvar x = S{")
	opens[1] = buf.CopyStr("S{")
	closes[1] = buf.CopyStr("}")
	heads[2] = buf.CopyStr("package \"main\"\nfunc f() { g(")
	opens[2] = buf.CopyStr("g(")
	closes[2] = buf.CopyStr(")")
	heads[3] = buf.CopyStr("package \"main\"\nfunc f(i int) { for i < ")
	opens[3] = buf.CopyStr("(")
	closes[3] = buf.CopyStr(")")
	heads[4] = buf.CopyStr("package \"main\"\nfunc f(i int) { switch i { case 1: ")
	opens[4] = buf.CopyStr("{ ")
	closes[4] = buf.CopyStr(" }")
	for k := 0; k < len(heads); k++ {
		var b @strings.Builder = strings.NewBuilder()
		b.Write(heads[k])
		repeat(b, opens[k], 2 * maxNesting)
		repeat(b, closes[k], 2 * maxNesting)
		b.Write(" }\nfunc g() {}\n")
		n, nest := nestingErrs(b)
		if n != 1 || !nest { return fail(heads[k], "no single nesting error") }
	}
	return ""
}

// switchesSrc writes a function whose body is n switches, each in the last's case: the
// body, then each switch and its case's body, the last's assignment and its operands,
// 2n + 3 levels.
func switchesSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nfunc f(y int) {")
	repeat(b, " switch y { case 1:", n)
	b.Write(" y = 2")
	repeat(b, " }", n)
	b.Write(" }\n")
}

// forInitSrc writes a function whose body is a `for` whose init statement assigns 0 in n
// parentheses: the body, the `for`, the init statement, its expression, n + 4 levels.
func forInitSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nfunc f() {\n\tfor x := ")
	repeat(b, "(", n)
	b.Write("0")
	repeat(b, ")", n)
	b.Write("; x < 1; x++ {\n\t}\n}\n")
}

// forPostSrc writes a function whose body is a `for` whose post statement assigns 1 in n
// parentheses: n + 4 levels, as forInitSrc.
func forPostSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nfunc f() {\n\tfor x := 0; x < 1; x = ")
	repeat(b, "(", n)
	b.Write("1")
	repeat(b, ")", n)
	b.Write(" {\n\t}\n}\n")
}

// parenTypeSrc writes a variable whose type is int in n parentheses: n levels, each
// type a level below its parentheses.
func parenTypeSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x ")
	repeat(b, "(", n)
	b.Write("int")
	repeat(b, ")", n)
	b.Write("\n")
}

// indexSrc writes a function returning s indexed by i in n parentheses: the body, the
// statement, its expression, the index, n + 4 levels.  The element may be a type
// argument as much as an index, and counts as an expression either way.
func indexSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nfunc f(s *[]int, i int) int {\n\treturn s[")
	repeat(b, "(", n)
	b.Write("i")
	repeat(b, ")", n)
	b.Write("]\n}\n")
}

// A case's body is a block, a `for`'s init and post statements are a level below it, a
// parenthesized type's type is a level below it, and a bracket element counts as an
// expression -- each accepted up to the limit and reported one level past it.
func TestNestingStatementsTypesAndBrackets() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	switchesSrc(b, maxNesting / 2 - 2)
	n, _ := nestingErrs(b)
	if n != 0 { return fail("switches", "an error at the limit") }
	b = strings.NewBuilder()
	switchesSrc(b, maxNesting / 2 - 1)
	var nest bool
	n, nest = nestingErrs(b)
	if n != 1 || !nest { return fail("switches", "no single nesting error past the limit") }
	var r testing.TestResult = nestedAt("a for's init", maxNesting - 4, forInitSrc)
	if len(r) == 0 { r = nestedAt("a for's post", maxNesting - 4, forPostSrc) }
	if len(r) == 0 { r = nestedAt("a parenthesized type", maxNesting, parenTypeSrc) }
	if len(r) == 0 { r = nestedAt("an index", maxNesting - 4, indexSrc) }
	return r
}

// A chain is reported as soon as it passes the limit, and nothing after it is read: an
// error in the sum past the limit is not reported.
func TestNestingChainStopsAtTheLimit() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\nvar x int = 1")
	repeat(b, " + 1", 600)
	b.Write(" + ) + 1\n")
	n, nest := nestingErrs(b)
	if n != 1 || !nest { return fail("a sum", "no single nesting error") }
	return ""
}

// startErr parses the file b holds and returns its one error's column on line 2, or -1.
func startErr(b @strings.Builder) int {
	var p @Parser = mkParser(buf.CopyStr(b.String()))
	_ = p.ParseFile()
	var errs @[]ParseError = p.Errors()
	if len(errs) != 1 || errs[0].Pos.Line != 2 { return -1 }
	return errs[0].Pos.Col
}

// A chain past the limit is reported where it starts, at its first operand's first
// token -- here the first of the parentheses around it, at column 13 -- whatever the
// precedences it mixes.
func TestNestingReportedAtChainStart() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\nvar x int = (((1))) * 1")
	repeat(b, " + 1", maxNesting)
	b.Write("\n")
	if startErr(b) != 13 { return fail("a sum", "not reported where it starts") }
	b = strings.NewBuilder()
	b.Write("package \"main\"\nvar x int = (((a)))")
	repeat(b, ".b", maxNesting)
	b.Write("\n")
	if startErr(b) != 13 { return fail("selectors", "not reported where they start") }
	return ""
}
