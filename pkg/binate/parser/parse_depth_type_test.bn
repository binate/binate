package "pkg/binate/parser"

import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for parse_depth.bn's bound on how deeply a source file's type expressions nest
// (MaxTypeNesting levels), counted as type.named.depth counts a type's.

// typeMsg begins the error a type nesting past the bound reports.
var typeMsg readonly *[]readonly char = "type nests too deeply"

// typeNestedAt checks that fill's file, given n, parses with no error at n =
// MaxTypeNesting levels, and with only the type nesting's one level past it.
func typeNestedAt(what *[]readonly char, fill *func(@strings.Builder, int)) testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	fill(b, MaxTypeNesting)
	n, _ := errsStarting(b, typeMsg)
	if n != 0 { return fail(what, "an error at the bound") }
	b = strings.NewBuilder()
	fill(b, MaxTypeNesting + 1)
	var deep bool
	n, deep = errsStarting(b, typeMsg)
	if n != 1 || !deep { return fail(what, "no single type nesting error past the bound") }
	return ""
}

// arraysSrc writes a variable whose type is int in n - 1 arrays: n levels.
func arraysSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x ")
	repeat(b, "[1]", n - 1)
	b.Write("int\n")
}

// prefixesSrc writes a variable whose type is int after n - 1 prefixes of every kind in
// turn: n levels.
func prefixesSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x ")
	for i := 0; i < n - 1; i++ {
		switch i % 6 {
		case 0:
			b.Write("*")
		case 1:
			b.Write("readonly ")
		case 2:
			b.Write("@")
		case 3:
			b.Write("*[]")
		case 4:
			b.Write("[2]")
		default:
			b.Write("@[]")
		}
	}
	b.Write("int\n")
}

// structsSrc writes a variable whose type is n - 1 structs, each the field of the one
// before, the last's field an int: n levels.
func structsSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x ")
	repeat(b, "struct { f ", n - 1)
	b.Write("int")
	repeat(b, " }", n - 1)
	b.Write("\n")
}

// declaredStructsSrc writes the declaration of a struct type nesting as structsSrc's
// variable's type does: n levels.
func declaredStructsSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\ntype T ")
	repeat(b, "struct { f ", n - 1)
	b.Write("int")
	repeat(b, " }", n - 1)
	b.Write("\n")
}

// paramsSrc writes a variable whose type is n - 1 function values, each the parameter
// of the one before, the last's an int: n levels.
func paramsSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x ")
	repeat(b, "*func(", n - 1)
	b.Write("int")
	repeat(b, ")", n - 1)
	b.Write("\n")
}

// resultsSrc writes a variable whose type is n - 1 function values, each the result of
// the one before, the last's an int: n levels.
func resultsSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x ")
	repeat(b, "@func() ", n - 1)
	b.Write("int\n")
}

// typeArgsSrc writes a variable whose type is n - 1 instantiations, each the type
// argument of the one before, the last's an int: n levels.
func typeArgsSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x ")
	repeat(b, "Box[", n - 1)
	b.Write("int")
	repeat(b, "]", n - 1)
	b.Write("\n")
}

// implSrc writes an impl of an interface whose type argument is int after n - 2
// pointers: n levels.
func implSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nimpl S : I[")
	repeat(b, "*", n - 2)
	b.Write("int]\n")
}

// lengthSrc writes a variable whose type is an array whose length is the size of int in
// n - 2 arrays: n levels, the length's type a level below the array.
func lengthSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x [sizeof(")
	repeat(b, "[1]", n - 2)
	b.Write("int)]int\n")
}

// parenthesizedSrc writes a variable whose type is int in n - 1 arrays, the whole in
// parentheses that add no level: n levels.
func parenthesizedSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x ")
	repeat(b, "(", 100)
	repeat(b, "[1]", n - 1)
	b.Write("int")
	repeat(b, ")", 100)
	b.Write("\n")
}

// A type nests up to the bound through each of its kinds of parts -- the element after
// a prefix, a struct's field, a function value's parameters and results, a type
// argument, a type in an array's length -- in a declared type and an impl as in a
// variable's, and parentheses add no level.
func TestTypeNestingToTheBound() testing.TestResult {
	var r testing.TestResult = typeNestedAt("arrays", arraysSrc)
	if len(r) == 0 { r = typeNestedAt("prefixes", prefixesSrc) }
	if len(r) == 0 { r = typeNestedAt("struct fields", structsSrc) }
	if len(r) == 0 { r = typeNestedAt("a declared struct", declaredStructsSrc) }
	if len(r) == 0 { r = typeNestedAt("parameters", paramsSrc) }
	if len(r) == 0 { r = typeNestedAt("results", resultsSrc) }
	if len(r) == 0 { r = typeNestedAt("type arguments", typeArgsSrc) }
	if len(r) == 0 { r = typeNestedAt("an impl's interface", implSrc) }
	if len(r) == 0 { r = typeNestedAt("an array's length", lengthSrc) }
	if len(r) == 0 { r = typeNestedAt("parentheses", parenthesizedSrc) }
	return r
}

// rawSliceLitSrc writes a variable whose initializer is a raw-slice literal whose
// element is int after n - 2 pointers: n levels.
func rawSliceLitSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x = *[]")
	repeat(b, "*", n - 2)
	b.Write("int{}\n")
}

// managedSliceLitSrc writes a variable whose initializer is a managed-slice literal
// whose element is int after n - 2 pointers: n levels.
func managedSliceLitSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x = @[]")
	repeat(b, "*", n - 2)
	b.Write("int{}\n")
}

// arrayLitSrc writes a variable whose initializer is an array literal whose length is
// the size of int in n - 2 arrays: n levels, as lengthSrc's type.
func arrayLitSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nvar x = [sizeof(")
	repeat(b, "[1]", n - 2)
	b.Write("int)]int{}\n")
}

// assertSrc writes a function asserting that x holds a pointer to an instantiation
// whose type argument is int after n - 3 pointers: n levels.
func assertSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nfunc f(x any) { _ = x.(*Box[")
	repeat(b, "*", n - 3)
	b.Write("int]) }\n")
}

// readonlyAssertSrc writes a function asserting that x holds a managed pointer to a
// readonly instantiation whose type argument is int after n - 4 pointers: n levels.
func readonlyAssertSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nfunc f(x any) { _ = x.(@readonly Box[")
	repeat(b, "*", n - 4)
	b.Write("int]) }\n")
}

// sliceAssertSrc writes a function asserting that x holds a raw slice whose element is
// int after n - 2 pointers: n levels.
func sliceAssertSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nfunc f(x any) { _ = x.(*[]")
	repeat(b, "*", n - 2)
	b.Write("int) }\n")
}

// bracketArgSrc writes a function calling a generic function whose type argument is a
// pointer to int after n - 2 managed-slice prefixes, in parentheses that add no level --
// a type no expression can be: n levels.
func bracketArgSrc(b @strings.Builder, n int) {
	b.Write("package \"main\"\nfunc g[T any]() {}\nfunc f() { g[*(")
	repeat(b, "@[]", n - 2)
	b.Write("int)]() }\n")
}

// The types written as parts of expressions -- a composite literal's, an assertion's
// target, a type argument read as an expression first -- nest up to the bound as well.
func TestTypeNestingInExpressions() testing.TestResult {
	var r testing.TestResult = typeNestedAt("a raw-slice literal", rawSliceLitSrc)
	if len(r) == 0 { r = typeNestedAt("a managed-slice literal", managedSliceLitSrc) }
	if len(r) == 0 { r = typeNestedAt("an array literal", arrayLitSrc) }
	if len(r) == 0 { r = typeNestedAt("an assertion", assertSrc) }
	if len(r) == 0 { r = typeNestedAt("a readonly assertion", readonlyAssertSrc) }
	if len(r) == 0 { r = typeNestedAt("a slice assertion", sliceAssertSrc) }
	if len(r) == 0 { r = typeNestedAt("a bracketed type argument", bracketArgSrc) }
	return r
}

// lengthErrCol parses a variable whose type is int in MaxTypeNesting - 1 arrays, then an
// array whose length is len(expr), and returns the column of its one error (startErr):
// the types in the length are a level past the bound.  The expression starts at column
// lengthCol.
func lengthErrCol(expr *[]readonly char) int {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("package \"main\"\nvar x ")
	repeat(b, "[1]", MaxTypeNesting - 1)
	b.Write("[len(")
	b.Write(expr)
	b.Write(")]int\n")
	return startErr(b)
}

// lengthCol is the column where lengthErrCol's expression starts.
const lengthCol int = 7 + 3 * (MaxTypeNesting - 1) + 5

// A type a level past the bound is reported where it starts: a raw-slice literal's type
// at its `*`, an assertion's target at its `*` or `readonly`, a slice target at its `*`.
func TestTypeNestingReportedAtTheType() testing.TestResult {
	if lengthErrCol("*[]int{}") != lengthCol { return fail("a raw-slice literal", "not at its *") }
	if lengthErrCol("y.(*T)") != lengthCol + 3 { return fail("an assertion", "not at its *") }
	if lengthErrCol("y.(readonly T)") != lengthCol + 3 {
		return fail("a readonly assertion", "not at its readonly")
	}
	if lengthErrCol("y.(*[]int)") != lengthCol + 3 { return fail("a slice assertion", "not at its *") }
	return ""
}

// A type past the bound is reported where the type a level too deep starts -- here
// the int after MaxTypeNesting arrays -- and nothing after it is read, an error in a
// generic call's bracketed type included.
func TestTypeNestingPastTheBound() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	arraysSrc(b, MaxTypeNesting + 1)
	if startErr(b) != 7 + 3 * MaxTypeNesting { return fail("arrays", "not reported where int starts") }
	b = strings.NewBuilder()
	b.Write("package \"main\"\nvar x ")
	repeat(b, "[1]", 2 * MaxTypeNesting)
	b.Write("int ]]] )\n")
	n, deep := errsStarting(b, typeMsg)
	if n != 1 || !deep { return fail("arrays", "no single type nesting error") }
	b = strings.NewBuilder()
	b.Write("package \"main\"\nfunc f() { g[*[]")
	repeat(b, "*", 2 * MaxTypeNesting)
	b.Write("int, ]]](1) }\n")
	n, deep = errsStarting(b, typeMsg)
	if n != 1 || !deep { return fail("a bracketed type", "no single type nesting error") }
	return ""
}
