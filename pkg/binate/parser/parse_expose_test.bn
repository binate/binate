package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// TestParseExposeBni: `expose "P"` in a .bni parses to a DECL_EXPOSE whose
// Name holds the RAW quoted path literal (quotes included), with no errors.
func TestParseExposeBni() testing.TestResult {
	var p @Parser = mkBniParser(
			"package \"a\"\n"
					"expose \"pkg/std/foo\"\n")
	var f @ast.File = p.ParseFile()
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParseExposeBni", errs[0].Msg)
	}
	if len(f.Decls) != 1 {
		return fail("TestParseExposeBni", "expected exactly 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_EXPOSE {
		return fail("TestParseExposeBni", "expected DECL_EXPOSE")
	}
	if !charEq(d.Name, "\"pkg/std/foo\"") {
		return fail("TestParseExposeBni", "Name should be the raw quoted path")
	}
	return ""
}

// TestParseExposeRejectedInBn: `expose` outside a .bni is a parse error
// (the .bni-only restriction lives in parseExposeDecl, so it parses then errors).
func TestParseExposeRejectedInBn() testing.TestResult {
	var p @Parser = mkParser(
			"package \"a\"\n"
					"expose \"pkg/std/foo\"\n")
	p.ParseFile()
	var errs @[]ParseError = p.Errors()
	if len(errs) == 0 {
		return fail("TestParseExposeRejectedInBn", "expected an error for expose in a .bn")
	}
	return ""
}

// TestParseExposeNoString: `expose` with no following path string errors.
func TestParseExposeNoString() testing.TestResult {
	var p @Parser = mkBniParser(
			"package \"a\"\n"
					"expose\n")
	p.ParseFile()
	var errs @[]ParseError = p.Errors()
	if len(errs) == 0 {
		return fail("TestParseExposeNoString", "expected an error for expose with no path")
	}
	return ""
}
