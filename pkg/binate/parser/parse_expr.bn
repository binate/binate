package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// ============================================================
// Expression Parsing
// ============================================================

// parseExpr parses an expression (entry point for all expression parsing).
func parseExpr(p @Parser) @ast.Expr {
	return parseOrExpr(p)
}

// parseExprNoCompositeLit parses an expression with composite literal parsing suppressed.
func parseExprNoCompositeLit(p @Parser) @ast.Expr {
	var old bool = p.noCompositeLit
	p.noCompositeLit = true
	var x @ast.Expr = parseExpr(p)
	p.noCompositeLit = old
	return x
}

// parseExprAllowComposite parses an expression that may begin a
// composite literal even inside a no-composite context (an `if` / `for`
// / `switch` condition).  A `(`, `[`, or call-argument sub-expression
// is no longer at the ambiguous top level — `{` there cannot be a block
// — so composite literals are allowed again (Go's `exprLev > 0`).  This
// is what makes the documented paren-escape `if (Point{1, 2}) == p {}`
// work.  Saves / clears / restores noCompositeLit (D4, §13.13).
func parseExprAllowComposite(p @Parser) @ast.Expr {
	var old bool = p.noCompositeLit
	p.noCompositeLit = false
	var x @ast.Expr = parseExpr(p)
	p.noCompositeLit = old
	return x
}

// parseOrExpr parses a logical-OR expression (||).
func parseOrExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseAndExpr(p)
	for p.tok.Typ == token.LOR {
		var pos token.Pos = p.tok.Pos
		p.next()
		var y @ast.Expr = parseAndExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = cast(int, token.LOR)
		e.X = x
		e.Y = y
		x = e
	}
	return x
}

// parseAndExpr parses a logical-AND expression (&&).
func parseAndExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseCompareExpr(p)
	for p.tok.Typ == token.LAND {
		var pos token.Pos = p.tok.Pos
		p.next()
		var y @ast.Expr = parseCompareExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = cast(int, token.LAND)
		e.X = x
		e.Y = y
		x = e
	}
	return x
}

// parseCompareExpr parses a comparison expression (==, !=, <, >, <=, >=).
func parseCompareExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseBitOrExpr(p)
	if p.tok.Typ == token.EQ || p.tok.Typ == token.NEQ ||
		p.tok.Typ == token.LT || p.tok.Typ == token.GT ||
		p.tok.Typ == token.LEQ || p.tok.Typ == token.GEQ {
		var pos token.Pos = p.tok.Pos
		var op int = cast(int, p.tok.Typ)
		p.next()
		var y @ast.Expr = parseBitOrExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = op
		e.X = x
		e.Y = y
		return e
	}
	return x
}

// parseBitOrExpr parses a bitwise-OR expression (|).
func parseBitOrExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseBitXorExpr(p)
	for p.tok.Typ == token.PIPE {
		var pos token.Pos = p.tok.Pos
		p.next()
		var y @ast.Expr = parseBitXorExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = cast(int, token.PIPE)
		e.X = x
		e.Y = y
		x = e
	}
	return x
}

// parseBitXorExpr parses a bitwise-XOR expression (^).
func parseBitXorExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseBitAndExpr(p)
	for p.tok.Typ == token.CARET {
		var pos token.Pos = p.tok.Pos
		p.next()
		var y @ast.Expr = parseBitAndExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = cast(int, token.CARET)
		e.X = x
		e.Y = y
		x = e
	}
	return x
}

// parseBitAndExpr parses a bitwise-AND expression (&).
func parseBitAndExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseShiftExpr(p)
	for p.tok.Typ == token.AMP {
		var pos token.Pos = p.tok.Pos
		p.next()
		var y @ast.Expr = parseShiftExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = cast(int, token.AMP)
		e.X = x
		e.Y = y
		x = e
	}
	return x
}

// parseShiftExpr parses a bit-shift expression (<< or >>).
func parseShiftExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseAddExpr(p)
	for p.tok.Typ == token.SHL || p.tok.Typ == token.SHR {
		var pos token.Pos = p.tok.Pos
		var op int = cast(int, p.tok.Typ)
		p.next()
		var y @ast.Expr = parseAddExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = op
		e.X = x
		e.Y = y
		x = e
	}
	return x
}

// parseAddExpr parses an additive expression (+ or -).
func parseAddExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseMulExpr(p)
	for p.tok.Typ == token.PLUS || p.tok.Typ == token.MINUS {
		var pos token.Pos = p.tok.Pos
		var op int = cast(int, p.tok.Typ)
		p.next()
		var y @ast.Expr = parseMulExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = op
		e.X = x
		e.Y = y
		x = e
	}
	return x
}

// parseMulExpr parses a multiplicative expression (*, /, or %).
func parseMulExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseUnaryExpr(p)
	for p.tok.Typ == token.STAR || p.tok.Typ == token.SLASH || p.tok.Typ == token.PERCENT {
		var pos token.Pos = p.tok.Pos
		var op int = cast(int, p.tok.Typ)
		p.next()
		var y @ast.Expr = parseUnaryExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = op
		e.X = x
		e.Y = y
		x = e
	}
	return x
}

// parseUnaryExpr parses a unary expression (!, ~, +, -, *, &) or falls through to postfix.
func parseUnaryExpr(p @Parser) @ast.Expr {
	if p.tok.Typ == token.NOT || p.tok.Typ == token.TILDE ||
		p.tok.Typ == token.PLUS || p.tok.Typ == token.MINUS ||
		p.tok.Typ == token.STAR || p.tok.Typ == token.AMP {
		var pos token.Pos = p.tok.Pos
		var op int = cast(int, p.tok.Typ)
		p.next()
		// `*[]T{...}` — raw-slice composite literal. After
		// consuming `*`, an immediate `[` can only be the start
		// of `[]T` (a raw-slice type prefix) — a deref of an
		// array literal `*[N]T{...}` would be ill-typed (array
		// values aren't first-class in expression context).
		// parseRawSliceLit consumes the `[` `]` and parses the
		// rest of the literal.
		if op == cast(int, token.STAR) && p.tok.Typ == token.LBRACKET {
			return parseRawSliceLit(p, pos)
		}
		var x @ast.Expr = parseUnaryExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_UNARY
		e.Pos = pos
		e.Op = op
		e.X = x
		return e
	}
	return parsePostfixExpr(p)
}

// parsePostfixExpr parses a primary expression followed by postfix operators.
func parsePostfixExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parsePrimaryExpr(p)
	return continuePostfix(p, x)
}

// continuePostfix continues parsing postfix operators (., *[], ()) on an existing expression.
func continuePostfix(p @Parser, x @ast.Expr) @ast.Expr {
	for {
		if p.tok.Typ == token.DOT {
			var pos token.Pos = p.tok.Pos
			p.next()
			var nameTok token.Token = p.tok
			p.next()
			var e @ast.Expr = make(ast.Expr)
			e.Kind = ast.EXPR_SELECTOR
			e.Pos = pos
			e.X = x
			e.Name = nameTok.Lit
			x = e
		} else if p.tok.Typ == token.LBRACKET {
			x = parseIndexOrSlice(p, x)
			// `Foo[T1, T2]{ ... }` — generic-instantiated composite
			// literal (§13.10).  parseIndexOrSlice produced an
			// EXPR_INSTANTIATE_OR_INDEX for the `Foo[...]` head; a
			// following `{` (outside a no-composite context like an
			// `if`/`for` condition) means it's a composite-literal type,
			// not value indexing.  Reinterpret the bracketed head as a
			// TEXPR_INSTANTIATE type and parse the body.  A non-type
			// head (e.g. `arr[i]` whose args aren't type-shaped) yields
			// nil and falls through unchanged.
			if p.tok.Typ == token.LBRACE && !p.noCompositeLit &&
					x.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
				var head @ast.TypeExpr = instantiateExprToTypeExpr(x)
				if head != nil {
					x = parseCompositeLitBody(p, head)
				}
			}
		} else if p.tok.Typ == token.LPAREN {
			x = parseCallExpr(p, x)
		} else {
			return x
		}
	}
	return x
}

// instantiateExprToTypeExpr reinterprets an EXPR_INSTANTIATE_OR_INDEX
// (`Foo[T1, T2]`) as the TEXPR_INSTANTIATE type heading a generic
// composite literal `Foo[T1, T2]{ ... }` (§13.10).  Returns nil unless
// the head is a (possibly package-qualified) type name AND every
// bracket argument converts to a type — so a value index like `arr[i]`
// with a non-type-shaped argument is left alone.
func instantiateExprToTypeExpr(e @ast.Expr) @ast.TypeExpr {
	var base @ast.TypeExpr = exprToCompositeTypeExpr(e.X)
	if base == nil { return nil }
	if base.Kind != ast.TEXPR_NAMED { return nil }
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_INSTANTIATE
	te.Pos = e.Pos
	// Composite-literal type heads are synthesized from already-parsed Exprs,
	// which carry no End yet (Expr.End is deferred), so use a zero-width End
	// (= Pos) rather than an invalid zero span.  Precise end awaits Expr.End.
	te.End = e.Pos
	te.Base = base
	for i := 0; i < len(e.Args); i++ {
		var arg @ast.TypeExpr = exprToCompositeTypeExpr(e.Args[i])
		if arg == nil { return nil }
		te.TypeArgs = slices.Append[@ast.TypeExpr](te.TypeArgs, arg)
	}
	return te
}

// exprToCompositeTypeExpr converts an expression parsed in a bracket
// (the head or a type argument of a would-be composite literal) into a
// TypeExpr, or nil if it has no type spelling.  Mirrors the IR-gen
// exprToTypeExpr set plus the package-qualified (`pkg.T`) and nested-
// generic (`Vec[int]`) forms a composite head can carry.
func exprToCompositeTypeExpr(e @ast.Expr) @ast.TypeExpr {
	if e == nil { return nil }
	// `@T` / `@[]T` / `*[]T` etc. — the parser already wrapped the
	// TypeExpr in EXPR_TYPE (parseBracketTypeArg).
	if e.Kind == ast.EXPR_TYPE { return e.TypeRef }
	if e.Kind == ast.EXPR_IDENT {
		var te @ast.TypeExpr = make(ast.TypeExpr)
		te.Kind = ast.TEXPR_NAMED
		te.Pos = e.Pos
		te.End = e.Pos  // zero-width; precise end awaits Expr.End
		te.Name = e.Name
		return te
	}
	// `pkg.T` — a package-qualified named type.
	if e.Kind == ast.EXPR_SELECTOR && e.X != nil &&
			e.X.Kind == ast.EXPR_IDENT {
		var te @ast.TypeExpr = make(ast.TypeExpr)
		te.Kind = ast.TEXPR_NAMED
		te.Pos = e.Pos
		te.End = e.Pos  // zero-width; precise end awaits Expr.End
		te.Pkg = e.X.Name
		te.Name = e.Name
		return te
	}
	// `*T` — raw pointer to a type.
	if e.Kind == ast.EXPR_UNARY && e.Op == cast(int, token.STAR) {
		var inner @ast.TypeExpr = exprToCompositeTypeExpr(e.X)
		if inner == nil { return nil }
		var te @ast.TypeExpr = make(ast.TypeExpr)
		te.Kind = ast.TEXPR_POINTER
		te.Pos = e.Pos
		te.End = e.Pos  // zero-width; precise end awaits Expr.End
		te.Base = inner
		return te
	}
	// `Vec[int]` — a nested generic instantiation.
	if e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		return instantiateExprToTypeExpr(e)
	}
	return nil
}

// parseIndexOrSlice parses one of:
//   x[lo:hi]           — slice, unambiguous
//   x[i]               — single bracketed expr; ambiguous between
//                        value indexing and single-type-arg generic
//                        instantiation, produces EXPR_INSTANTIATE_OR_INDEX
//   x[T1, T2, ...]     — multi bracketed exprs; only legal as generic
//                        instantiation (value indexing takes one
//                        expr), produces EXPR_INSTANTIATE_OR_INDEX
// Per `plan-generics.md` Slice 1: the type checker disambiguates the
// single-element form by inspecting whether the head resolves to a
// generic decl or a value of slice / array type.
func parseIndexOrSlice(p @Parser, x @ast.Expr) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.next() // consume [

	// [:hi]
	if p.tok.Typ == token.COLON {
		p.next()
		var hi @ast.Expr = nil
		if p.tok.Typ != token.RBRACKET {
			hi = parseExprAllowComposite(p)
		}
		p.expect(token.RBRACKET)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_SLICE
		e.Pos = pos
		e.X = x
		e.Y = hi  // hi
		// Z (lo) left nil
		return e
	}

	// A bracket element beginning with a type-only prefix — `@…`
	// (managed pointer / managed slice) or `*[` (raw slice) — has no
	// expression spelling, so it can only be a generic-instantiation
	// type argument, never a value index or slice bound.  Parse it as
	// a type and wrap in EXPR_TYPE.  `*T` (raw pointer to a named
	// type) and `*p` (deref) keep flowing through parseExpr — the
	// type checker reinterprets the former as a type arg.  Detecting
	// the type-form here is what lets `f[@T](...)` / `f[*[]T](...)`
	// parse at all (the rest of the bracket forms are unchanged).
	if startsBracketTypeArg(p) {
		var args @[]@ast.Expr
		args = slices.Append[@ast.Expr](args, parseBracketTypeArg(p))
		for p.tok.Typ == token.COMMA {
			p.next()
			if p.tok.Typ == token.RBRACKET { break }
			args = slices.Append[@ast.Expr](args, parseBracketElem(p))
		}
		p.expect(token.RBRACKET)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_INSTANTIATE_OR_INDEX
		e.Pos = pos
		e.X = x
		e.Args = args
		return e
	}

	var first @ast.Expr = parseExprAllowComposite(p)

	if p.tok.Typ == token.COLON {
		// x[lo:hi]
		p.next()
		var hi @ast.Expr = nil
		if p.tok.Typ != token.RBRACKET {
			hi = parseExprAllowComposite(p)
		}
		p.expect(token.RBRACKET)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_SLICE
		e.Pos = pos
		e.X = x
		e.Y = hi   // hi
		e.Z = first  // lo
		return e
	}

	// x[i] or x[T1, T2, ...]
	var args @[]@ast.Expr
	args = slices.Append[@ast.Expr](args, first)
	for p.tok.Typ == token.COMMA {
		p.next()
		if p.tok.Typ == token.RBRACKET { break }
		args = slices.Append[@ast.Expr](args, parseBracketElem(p))
	}
	p.expect(token.RBRACKET)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_INSTANTIATE_OR_INDEX
	e.Pos = pos
	e.X = x
	e.Args = args
	return e
}

// startsBracketTypeArg reports whether the current token begins a
// type-only generic-instantiation argument that has no expression
// spelling: `@…` (any managed form) or `*[` (raw slice).  `*T` /
// `*p` are deliberately excluded — they parse fine as expressions
// (unary deref) and the type checker reinterprets `*T` as a type
// arg.  Per the CRITICAL "Generic call type args reject @T / @[]T /
// *[]T" fix.
func startsBracketTypeArg(p @Parser) bool {
	if p.tok.Typ == token.AT { return true }
	if p.tok.Typ == token.STAR &&
			p.peekTok().Typ == token.LBRACKET {
		return true
	}
	return false
}

// parseBracketElem parses one bracket element, choosing the type-arg
// path for type-only forms (startsBracketTypeArg) and the expression
// path otherwise.  Used for the comma-separated tail of a bracketed
// list so mixed `f[int, @T]` works.
func parseBracketElem(p @Parser) @ast.Expr {
	if startsBracketTypeArg(p) {
		return parseBracketTypeArg(p)
	}
	return parseExpr(p)
}

// parseBracketTypeArg parses a type expression in bracket (generic
// type-argument) position and wraps it in an EXPR_TYPE node so it
// can ride in the EXPR_INSTANTIATE_OR_INDEX Args list alongside
// expression-shaped args.  The type checker (typeArgFromExpr) and
// IR-gen (exprToTypeExpr) read the wrapped TypeRef directly.
func parseBracketTypeArg(p @Parser) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	var te @ast.TypeExpr = parseType(p)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_TYPE
	e.Pos = pos
	e.TypeRef = te
	return e
}

// parseCallExpr parses a function call expression with arguments.
func parseCallExpr(p @Parser, fn @ast.Expr) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.next() // consume (
	var args @[]@ast.Expr
	if p.tok.Typ != token.RPAREN {
		// Call arguments are no longer at a condition's top level, so a
		// composite literal is unambiguous here (`if f(Point{1,2}) {}`).
		var old bool = p.noCompositeLit
		p.noCompositeLit = false
		args = parseExprList(p)
		p.noCompositeLit = old
	}
	p.expect(token.RPAREN)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_CALL
	e.Pos = pos
	e.X = fn
	e.Args = args
	return e
}
