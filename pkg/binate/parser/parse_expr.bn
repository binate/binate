package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/token"

// ============================================================
// Expression Parsing
// ============================================================

// parseExpr parses an expression (entry point for all expression parsing), one level
// deeper than what it is part of (pkg.source.nesting): a unary expression, then the
// binary operators after it (continueBinaryExpr).  Each operand of an operator is a
// call or two below it, not one per precedence, so a nesting as deep as the limit
// takes the stack of a few calls a level.
func parseExpr(p @Parser) @ast.Expr {
	enterLevel(p)
	var saved int = p.reached
	p.reached = p.depth
	var start token.Pos = p.tok.Pos
	var x @ast.Expr = parseUnaryExpr(p)
	if binaryPrec(p.tok.Typ) > 0 { x = continueBinaryExpr(p, x, 1, p.reached - p.depth, start) }
	if saved > p.reached { p.reached = saved }
	leaveLevel(p)
	return x
}

// parseExprNoCompositeLit parses an expression with composite literal parsing suppressed.
func parseExprNoCompositeLit(p @Parser) @ast.Expr {
	var old bool = p.noCompositeLit
	p.noCompositeLit = true
	var x @ast.Expr = parseExpr(p)
	p.noCompositeLit = old
	return x
}

// parseExprAllowComposite parses an expression that may begin a
// composite literal even inside a no-composite context (an `if` / `for`
// / `switch` condition).  An expression inside any bracket -- parentheses,
// an index's or an array length's brackets, a composite literal's braces --
// is no longer at the ambiguous top level (`{` there cannot be the block),
// so composite literals are allowed again.  This is what makes the
// paren-escape `if (Point{1, 2}) == p {}` work.  Saves / clears / restores
// noCompositeLit (D4, expr.disambiguation.d4-paren).
func parseExprAllowComposite(p @Parser) @ast.Expr {
	var old bool = p.noCompositeLit
	p.noCompositeLit = false
	var x @ast.Expr = parseExpr(p)
	p.noCompositeLit = old
	return x
}

// continueBinaryExpr parses the binary operators of precedence minPrec and above after
// x, by precedence climbing: an operator groups to the left (expr.associativity), one
// of a higher precedence binds tighter, and comparisons do not chain.  x, starting at
// start, reaches reach levels below its place: the chain of the operators it folds
// holds x as many levels deeper (nestChain), reported past the limit where x starts.
func continueBinaryExpr(p @Parser, x @ast.Expr, minPrec int, reach int, start token.Pos) @ast.Expr {
	// Comparisons don't chain: `a < b < c` is a syntax error.  A chain is a
	// SECOND comparison folded by this invocation — not a left operand that merely
	// IS a comparison, which a parenthesized one can be (the AST keeps no paren
	// node, so `a && (b < c) == d` arrives here with x = `b < c`).  Report once,
	// then keep parsing so the rest of the statement still resyncs (no cascade).
	var compares int = 0
	var c nestChain = beginChain(p)
	c.pos = start
	c.extra = reach
	for {
		var prec int = binaryPrec(p.tok.Typ)
		if prec < minPrec {
			endChain(p, &c)
			return x
		}
		if isCompareOp(p.tok.Typ) {
			if compares == 1 {
				p.errMsg("comparison operators do not chain")
			}
			compares = compares + 1
		}
		var op int = cast(int, p.tok.Typ)
		var pos token.Pos = p.tok.Pos
		p.next()
		var ystart token.Pos = p.tok.Pos
		var y @ast.Expr = parseUnaryExpr(p)
		for {
			var nextPrec int = binaryPrec(p.tok.Typ)
			if nextPrec <= prec {
				break
			}
			y = continueBinaryExpr(p, y, nextPrec, p.reached - p.depth, ystart)
		}
		chainLink(p, &c, true)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = op
		e.X = x
		e.Y = y
		x = e
	}
	return x
}

// isCompareOp reports whether op is one of the six comparison
// operators. They are NON-associative (expr.compare): a comparison
// whose operand is itself a comparison (`a < b < c`) is a syntax
// error, which continueBinaryExpr reports.
func isCompareOp(op token.Type) bool {
	return op == token.EQ || op == token.NEQ || op == token.LT || op == token.GT || op == token.LEQ ||
			op == token.GEQ
}

// binaryPrec returns the precedence level for a binary operator token, or 0 if not a binary op.
func binaryPrec(op token.Type) int {
	if op == token.LOR { return 1 }
	if op == token.LAND { return 2 }
	if op == token.EQ || op == token.NEQ || op == token.LT || op == token.GT || op == token.LEQ ||
			op == token.GEQ {
		return 3
	}
	if op == token.PIPE { return 4 }
	if op == token.CARET { return 5 }
	if op == token.AMP { return 6 }
	if op == token.SHL || op == token.SHR { return 7 }
	if op == token.PLUS || op == token.MINUS { return 8 }
	if op == token.STAR || op == token.SLASH || op == token.PERCENT { return 9 }
	return 0
}

// parseUnaryExpr parses a unary expression (!, ~, +, -, *, &) or falls through to postfix.
func parseUnaryExpr(p @Parser) @ast.Expr {
	if p.tok.Typ == token.NOT || p.tok.Typ == token.TILDE || p.tok.Typ == token.PLUS ||
			p.tok.Typ == token.MINUS || p.tok.Typ == token.STAR || p.tok.Typ == token.AMP {
		var pos token.Pos = p.tok.Pos
		var op int = cast(int, p.tok.Typ)
		p.next()
		// `*[]T{...}` — raw-slice composite literal. After
		// consuming `*`, an immediate `[` can only be the start
		// of `[]T` (a raw-slice type prefix) — a deref of an
		// array literal `*[N]T{...}` would be ill-typed (array
		// values aren't first-class in expression context).
		// parseRawSliceLit consumes the `[` `]` and parses the
		// rest of the literal.
		if op == cast(int, token.STAR) && p.tok.Typ == token.LBRACKET {
			return parseRawSliceLit(p, pos)
		}
		enterLevel(p)
		var x @ast.Expr = parseUnaryExpr(p)
		leaveLevel(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_UNARY
		e.Pos = pos
		e.Op = op
		e.X = x
		return e
	}
	return parsePostfixExpr(p)
}
