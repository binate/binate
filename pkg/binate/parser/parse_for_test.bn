package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for parse_for.bn (parseForStmt + helpers). The mkParser /
// fail helpers come from parser_test.bn (same package).

func TestParseForCStyle() testing.TestResult {
	var p @Parser = mkParser("for i := 0; i < 10; i++ { x() }")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_FOR {
		return fail("TestParseForCStyle", "expected STMT_FOR")
	}
	if s.Init == nil {
		return fail("TestParseForCStyle", "expected init")
	}
	if s.X == nil {
		return fail("TestParseForCStyle", "expected cond")
	}
	if s.Post == nil {
		return fail("TestParseForCStyle", "expected post")
	}
	return ""
}

func TestParseForIn() testing.TestResult {
	var p @Parser = mkParser("for x in items { f(x) }")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_FOR {
		return fail("TestParseForIn", "expected STMT_FOR")
	}
	if s.ForVal == nil {
		return fail("TestParseForIn", "expected ForVal")
	}
	if s.X == nil {
		return fail("TestParseForIn", "expected iter expr")
	}
	return ""
}

func TestParseForKeyVal() testing.TestResult {
	var p @Parser = mkParser("for i, v in items { f(i, v) }")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_FOR {
		return fail("TestParseForKeyVal", "expected STMT_FOR")
	}
	if s.ForKey == nil {
		return fail("TestParseForKeyVal", "expected ForKey")
	}
	if s.ForVal == nil {
		return fail("TestParseForKeyVal", "expected ForVal")
	}
	return ""
}

func TestParseInfiniteFor() testing.TestResult {
	var p @Parser = mkParser("for { break }")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_FOR {
		return fail("TestParseInfiniteFor", "expected STMT_FOR")
	}
	if s.X != nil {
		return fail("TestParseInfiniteFor", "expected nil cond")
	}
	if s.Init != nil {
		return fail("TestParseInfiniteFor", "expected nil init")
	}
	return ""
}

// Comparisons don't chain: `for a < b < c {}` is a syntax error.  The
// for-clause's identifier-leading expression reaches continueBinaryExpr
// after its first name, and must reject the chain as any expression does,
// not left-associate it into `(a < b) < c`.
func TestParseForCompareChainingRejected() testing.TestResult {
	var p @Parser = mkParser("for a < b < c { }")
	parseStmt(p)
	if len(p.Errors()) == 0 {
		return fail("TestParseForCompareChainingRejected",
				"chained comparison in a for-clause must be a parse error")
	}
	return ""
}

// Guard: a single comparison in the for-clause still parses cleanly.
func TestParseForSingleCompareAccepted() testing.TestResult {
	var p @Parser = mkParser("for a < b { }")
	var s @ast.Stmt = parseStmt(p)
	if len(p.Errors()) != 0 {
		return fail("TestParseForSingleCompareAccepted",
				"a single comparison for-condition must parse cleanly")
	}
	if s.Kind != ast.STMT_FOR {
		return fail("TestParseForSingleCompareAccepted", "expected STMT_FOR")
	}
	return ""
}

// exactlyChainError reports whether p recorded exactly one error and it is the
// comparison-chain diagnostic — a chain is reported once, with no cascade of
// follow-on errors from the rest of the statement.
func exactlyChainError(p @Parser) bool {
	var errs @[]ParseError = p.Errors()
	return len(errs) == 1 && charEq(errs[0].Msg, "comparison operators do not chain")
}

// A longer chain in the for-clause is still ONE diagnostic, not one per extra
// operator.
func TestParseForCompareChainReportedOnce() testing.TestResult {
	var p @Parser = mkParser("for a < b < c < d { }")
	parseStmt(p)
	if !exactlyChainError(p) {
		return fail("TestParseForCompareChainReportedOnce",
				"a 3-operator chain must yield exactly one chain diagnostic")
	}
	return ""
}

// A parenthesized comparison compared again is NOT a chain: `(b < c) == d` is a
// valid bool comparison.  The AST keeps no paren node, so the operand arriving at
// continueBinaryExpr is itself a comparison — that alone must not be flagged.
func TestParseForParenCompareOperandAccepted() testing.TestResult {
	var p @Parser = mkParser("for a && (b < c) == d { }")
	parseStmt(p)
	if len(p.Errors()) != 0 {
		return fail("TestParseForParenCompareOperandAccepted",
				"a parenthesized comparison compared again must parse cleanly")
	}
	return ""
}

// initList parses src, a C-style loop whose init statement assigns n values to n
// targets, and checks that it parses with no error to an assignment whose first target
// is the name x and whose second is an expression of the kind want, the name second or
// an operation on it.
func initList(src *[]readonly char, n int, want int, second *[]readonly char) testing.TestResult {
	var p @Parser = mkParser(src)
	var s @ast.Stmt = parseStmt(p)
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 { return fail(src, errs[0].Msg) }
	if s.Kind != ast.STMT_FOR || s.Init == nil || s.Init.Kind != ast.STMT_ASSIGN {
		return fail(src, "not a loop whose init is an assignment")
	}
	var lhs @[]@ast.Expr = s.Init.Exprs
	if len(lhs) != n || len(s.Init.Exprs2) != n { return fail(src, "the wrong number of targets") }
	if lhs[0].Kind != ast.EXPR_IDENT || !charEq(lhs[0].Name, "x") {
		return fail(src, "the first target is not x")
	}
	if lhs[1].Kind != want { return fail(src, "the second target is of the wrong kind") }
	var name @ast.Expr = lhs[1]
	if name.Kind != ast.EXPR_IDENT { name = name.X }
	if name == nil || name.Kind != ast.EXPR_IDENT || !charEq(name.Name, second) {
		return fail(src, "the second target is not on its name")
	}
	return ""
}

// After a first name and a `,` that are not `for k, v in`, the init statement's list goes
// on as any list does: its second expression is not lost to the first (`x(y)`, `x * p`),
// nor cut short after a name (`y.f`, `y[0]`).
func TestParseForInitListAfterAName() testing.TestResult {
	var r testing.TestResult = initList("for x, (y) = 1, 2; x < 0; { }", 2, ast.EXPR_IDENT, "y")
	if len(r) == 0 { r = initList("for x, *p = 1, 2; ; { }", 2, ast.EXPR_UNARY, "p") }
	if len(r) == 0 { r = initList("for x, y.f = 1, 2; ; { }", 2, ast.EXPR_SELECTOR, "y") }
	if len(r) == 0 {
		r = initList("for x, y[0] = 1, 2; ; { }", 2, ast.EXPR_INSTANTIATE_OR_INDEX, "y")
	}
	if len(r) == 0 { r = initList("for x, y.f, z = 1, 2, 3; ; { }", 3, ast.EXPR_SELECTOR, "y") }
	if len(r) == 0 { r = initList("for x, y = 1, 2; ; { }", 2, ast.EXPR_IDENT, "y") }
	if len(r) > 0 { return r }
	var p @Parser = mkParser("for x, y := 1, 2; x < y; { }")
	var s @ast.Stmt = parseStmt(p)
	if len(p.Errors()) != 0 || s.Init == nil || s.Init.Kind != ast.STMT_SHORT_VAR ||
			len(s.Init.Exprs) != 2 {
		return fail("for x, y := 1, 2", "not a loop declaring two names")
	}
	return ""
}

// A `,` after the first name with no expression after it is an error, not dropped:
// `for x, = 1; ; {` is not `for x = 1; ; {`, nor `for x, {` `for x {`.
func TestParseForDanglingCommaRejected() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 4)
	srcs[0] = "for x, = 1; ; { }"
	srcs[1] = "for x, ; x < 0; { }"
	srcs[2] = "for x, := 0; ; { }"
	srcs[3] = "for x, { }"
	for i := 0; i < len(srcs); i++ {
		var p @Parser = mkParser(srcs[i])
		parseStmt(p)
		if len(p.Errors()) == 0 { return fail(srcs[i], "a dangling comma must be a parse error") }
	}
	return ""
}
