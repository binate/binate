package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// Function-related parsing: top-level function and method declarations,
// function literals (in expression position), and generic type-
// parameter lists.  Other declaration kinds (var, const, type,
// interface, impl) live in parse_decl.bn.

// parseFuncDecl parses a function or method declaration. After `func`,
// an LPAREN means a method receiver (`func (r RT) Name(...)`); an IDENT
// means a free function.
func parseFuncDecl(p @Parser) @ast.Decl {
	var pos token.Pos = p.tok.Pos
	p.expect(token.FUNC)

	// Optional receiver
	var recv @ast.ParamDecl = nil
	if p.tok.Typ == token.LPAREN {
		p.next()
		recv = parseParamDecl(p)
		// A receiver bypasses parseParamList, so its variadic-ness (which
		// parseParamDecl would accept syntactically) must be rejected here: a
		// receiver may never be variadic (func.variadic.decl).
		if recv != nil && recv.Variadic {
			p.addError(recv.Pos, "receiver may not be variadic")
		}
		p.expect(token.RPAREN)
	}

	var nameTok token.Token = p.expect(token.IDENT)

	// Optional type-parameter list — `func f[T any, U any](...)`.
	// Only generic free functions are accepted; generic methods are out
	// of scope (and would land on a receiver before the name).  The list
	// is empty / nil for non-generic functions.
	var typeParams @[]@ast.TypeParam
	if p.tok.Typ == token.LBRACKET {
		typeParams = parseTypeParamList(p)
	}

	// Parameters
	p.expect(token.LPAREN)
	var params @[]@ast.ParamDecl
	if p.tok.Typ != token.RPAREN {
		params = parseParamList(p)
	}
	p.expect(token.RPAREN)

	// Result types
	var results @[]@ast.TypeExpr
	if p.tok.Typ == token.LPAREN {
		// Multiple returns: (T1, T2)
		p.next()
		results = parseTypeList(p)
		p.expect(token.RPAREN)
	} else if p.tok.Typ != token.LBRACE && p.tok.Typ != token.SEMICOLON && p.tok.Typ != token.EOF {
		// Single return type
		results = slices.Append[@ast.TypeExpr](results, parseType(p))
	}

	// In .bni mode, non-generic func decls are signature-only
	// (the body lives in the matching .bn).  Generic decls carry
	// their body so a cross-package consumer can monomorphize at
	// the call site: source-text bodies in .bni for generics only.
	// "Generic"
	// here includes a method whose RECEIVER is a generic-type
	// instantiation (`func (b @Box[T]) Get() T`): its type params
	// come from the receiver, so typeParams is empty, but it is
	// monomorphized per instantiation just like a generic function.
	var body @ast.Stmt = nil
	if !p.interfaceFile || len(typeParams) > 0 || recvIsGenericInstantiation(recv) {
		body = parseBlock(p)
	}

	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Pos = pos
	d.Name = nameTok.Lit
	d.Recv = recv
	d.TypeParams = typeParams
	d.Params = params
	d.Results = results
	d.Body = body
	return d
}

// recvIsGenericInstantiation reports whether a method receiver names a generic-
// type instantiation (`*Cursor[T]` / `@Box[T]`), peeling pointer/managed/const/
// paren wrappers to a TEXPR_INSTANTIATE base.  Such a method's type parameters
// come from the receiver, not a decl-level list, so it carries no typeParams; in
// a .bni it still needs its body parsed (a cross-package consumer monomorphizes
// it), like a generic function.
func recvIsGenericInstantiation(recv @ast.ParamDecl) bool {
	if recv == nil {
		return false
	}
	var base @ast.TypeExpr = recv.Type
	for base != nil {
		if base.Kind == ast.TEXPR_POINTER || base.Kind == ast.TEXPR_MANAGED ||
				base.Kind == ast.TEXPR_CONST || base.Kind == ast.TEXPR_PAREN {
			base = base.Base
		} else {
			break
		}
	}
	return base != nil && base.Kind == ast.TEXPR_INSTANTIATE
}

// parseFuncLit parses a function literal in expression position:
//   func(<params>) <results> { <body> }
// No receiver, no name. Phase 1 restriction (capture analysis at the
// type-check stage rejects references to enclosing-scope locals);
// the parser accepts the syntactic form unconditionally.
//
// Carries the signature and body via a synthetic Decl on Expr.DeclRef
// — same shape as parseFuncDecl produces, minus Recv and Name.
func parseFuncLit(p @Parser) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.expect(token.FUNC)

	// Parameters
	p.expect(token.LPAREN)
	var params @[]@ast.ParamDecl
	if p.tok.Typ != token.RPAREN {
		params = parseParamList(p)
	}
	p.expect(token.RPAREN)

	// Result types
	var results @[]@ast.TypeExpr
	if p.tok.Typ == token.LPAREN {
		// Multiple returns: (T1, T2)
		p.next()
		results = parseTypeList(p)
		p.expect(token.RPAREN)
	} else if p.tok.Typ != token.LBRACE && p.tok.Typ != token.SEMICOLON && p.tok.Typ != token.EOF {
		// Single return type
		results = slices.Append[@ast.TypeExpr](results, parseType(p))
	}

	var body @ast.Stmt = parseBlock(p)

	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Pos = pos
	// Name and Recv left empty — filled in by IR-gen (synthetic name).
	d.Params = params
	d.Results = results
	d.Body = body

	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_FUNC_LIT
	e.Pos = pos
	e.DeclRef = d
	return e
}

// parseTypeParamList parses a generic decl's type-parameter list:
//   `[T any]`
//   `[T any, U any]`
// The opening `[` has not been consumed.  The parser accepts any
// TypeExpr in the constraint slot; the type checker restricts to `any`
// (and interface names) and rejects other forms.  Returns the parsed
// list (always
// non-empty — empty `[]` would mean "instantiate with no args,"
// not "generic with no type params").
func parseTypeParamList(p @Parser) @[]@ast.TypeParam {
	p.expect(token.LBRACKET)
	var list @[]@ast.TypeParam
	list = slices.Append[@ast.TypeParam](list, parseTypeParam(p))
	for p.got(token.COMMA) {
		if p.tok.Typ == token.RBRACKET {
			break // trailing comma
		}
		list = slices.Append[@ast.TypeParam](list, parseTypeParam(p))
	}
	p.expect(token.RBRACKET)
	return list
}

// parseTypeParam parses a single `<name> <constraint>` entry of a
// type-parameter list.  The constraint is mandatory (no shorthand
// for `any`; the explicit form keeps parsing simple and the source
// self-documenting).
func parseTypeParam(p @Parser) @ast.TypeParam {
	var nameTok token.Token = p.expect(token.IDENT)
	var constraint @ast.TypeExpr = parseType(p)
	var tp @ast.TypeParam = make(ast.TypeParam)
	tp.Pos = nameTok.Pos
	tp.Name = nameTok.Lit
	tp.Constraint = constraint
	return tp
}
