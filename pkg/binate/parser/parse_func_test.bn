package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Parser tests for function-related declarations (`func` decls,
// methods, generic type-parameter lists).  Matches parse_func.bn.
// Generic-instantiation expression-side parsing is exercised in
// parse_expr_test.bn alongside other expression-form tests.

func TestParseFuncDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc add(a int, b int) int { return a + b }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseFuncDecl", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_FUNC {
		return fail("TestParseFuncDecl", "expected DECL_FUNC")
	}
	if !charEq(d.Name, "add") {
		return fail("TestParseFuncDecl", "expected name 'add'")
	}
	if len(d.Params) != 2 {
		return fail("TestParseFuncDecl", "expected 2 params")
	}
	if len(d.Results) != 1 {
		return fail("TestParseFuncDecl", "expected 1 result")
	}
	if len(d.TypeParams) != 0 {
		return fail("TestParseFuncDecl", "expected no type parameters on non-generic decl")
	}
	return ""
}

// Generic function decl: `func id[T any](x T) T { return x }`
// Parser populates Decl.TypeParams; type-checker doesn't run here.
func TestParseGenericFuncDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc id[T any](x T) T { return x }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseGenericFuncDecl", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_FUNC {
		return fail("TestParseGenericFuncDecl", "expected DECL_FUNC")
	}
	if len(d.TypeParams) != 1 {
		return fail("TestParseGenericFuncDecl", "expected 1 type parameter")
	}
	var tp @ast.TypeParam = d.TypeParams[0]
	if !charEq(tp.Name, "T") {
		return fail("TestParseGenericFuncDecl", "expected type param 'T'")
	}
	if tp.Constraint == nil || tp.Constraint.Kind != ast.TEXPR_NAMED ||
			!charEq(tp.Constraint.Name, "any") {
		return fail("TestParseGenericFuncDecl", "expected constraint 'any'")
	}
	if len(d.Params) != 1 {
		return fail("TestParseGenericFuncDecl", "expected 1 value param")
	}
	if d.Params[0].Type == nil || d.Params[0].Type.Kind != ast.TEXPR_NAMED ||
			!charEq(d.Params[0].Type.Name, "T") {
		return fail("TestParseGenericFuncDecl", "expected param type ref 'T'")
	}
	if len(d.Results) != 1 || d.Results[0].Kind != ast.TEXPR_NAMED || !charEq(d.Results[0].Name, "T") {
		return fail("TestParseGenericFuncDecl", "expected result type ref 'T'")
	}
	return ""
}

// Two-parameter generic decl + the trailing-comma form.
func TestParseGenericFuncDeclTwoParams() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc pair[T any, U any,](x T, y U) {}"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseGenericFuncDeclTwoParams", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if len(d.TypeParams) != 2 {
		return fail("TestParseGenericFuncDeclTwoParams", "expected 2 type parameters")
	}
	if !charEq(d.TypeParams[0].Name, "T") || !charEq(d.TypeParams[1].Name, "U") {
		return fail("TestParseGenericFuncDeclTwoParams", "wrong type-param names")
	}
	return ""
}

// Rejection: missing constraint after the name.  parseType errors
// on the following `]` and pushes a parse error.
func TestParseGenericFuncDeclMissingConstraint() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc bad[T](x T) {}"
	var p @Parser = mkParser(src)
	p.ParseFile()
	if len(p.errs) == 0 {
		return fail("TestParseGenericFuncDeclMissingConstraint", "expected at least one parse error")
	}
	return ""
}

// Rejection: missing closing `]` in the type-param list.
func TestParseGenericFuncDeclMissingRBracket() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc bad[T any(x T) {}"
	var p @Parser = mkParser(src)
	p.ParseFile()
	if len(p.errs) == 0 {
		return fail("TestParseGenericFuncDeclMissingRBracket", "expected at least one parse error")
	}
	return ""
}

func TestParseMethodDeclPointerRecv() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc (p *Point) Translate(dx int, dy int) { return }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseMethodDeclPointerRecv", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_FUNC {
		return fail("TestParseMethodDeclPointerRecv", "expected DECL_FUNC")
	}
	if d.Recv == nil {
		return fail("TestParseMethodDeclPointerRecv", "expected non-nil Recv")
	}
	if !charEq(d.Recv.Name, "p") {
		return fail("TestParseMethodDeclPointerRecv", "expected recv name 'p'")
	}
	if d.Recv.Type == nil || d.Recv.Type.Kind != ast.TEXPR_POINTER {
		return fail("TestParseMethodDeclPointerRecv", "expected pointer recv type")
	}
	if d.Recv.Type.Base == nil || d.Recv.Type.Base.Kind != ast.TEXPR_NAMED ||
			!charEq(d.Recv.Type.Base.Name, "Point") {
		return fail("TestParseMethodDeclPointerRecv", "expected base type Point")
	}
	if !charEq(d.Name, "Translate") {
		return fail("TestParseMethodDeclPointerRecv", "expected name 'Translate'")
	}
	if len(d.Params) != 2 {
		return fail("TestParseMethodDeclPointerRecv", "expected 2 params")
	}
	return ""
}

func TestParseMethodDeclValueRecv() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc (p Point) X() int { return 0 }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseMethodDeclValueRecv", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Recv == nil || d.Recv.Type == nil || d.Recv.Type.Kind != ast.TEXPR_NAMED ||
			!charEq(d.Recv.Type.Name, "Point") {
		return fail("TestParseMethodDeclValueRecv", "expected value recv of Point")
	}
	return ""
}

func TestParseMethodDeclManagedRecv() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc (n @Node) Next() @Node { return nil }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseMethodDeclManagedRecv", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Recv == nil || d.Recv.Type == nil || d.Recv.Type.Kind != ast.TEXPR_MANAGED {
		return fail("TestParseMethodDeclManagedRecv", "expected @T recv")
	}
	if d.Recv.Type.Base == nil || !charEq(d.Recv.Type.Base.Name, "Node") {
		return fail("TestParseMethodDeclManagedRecv", "expected @Node recv")
	}
	return ""
}

func TestParseFreeFuncHasNilRecv() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc add(a int, b int) int { return a + b }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	var d @ast.Decl = f.Decls[0]
	if d.Recv != nil {
		return fail("TestParseFreeFuncHasNilRecv", "expected nil Recv on free function")
	}
	return ""
}

// A non-generic func decl in
// `.bni` mode is signature-only — no body parsed.  The Body
// field stays nil and the source must not have an opening brace
// where the body would be.
func TestParseBniNonGenericNoBody() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc add(a int, b int) int"
	var p @Parser = mkBniParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseBniNonGenericNoBody", "expected 1 decl")
	}
	if f.Decls[0].Body != nil {
		return fail("TestParseBniNonGenericNoBody", "non-generic decl should have nil Body in .bni mode")
	}
	return ""
}

// A generic func decl in `.bni`
// mode carries its body so a cross-package consumer can
// monomorphize.  Body is parsed and the resulting Body field is
// non-nil.
func TestParseBniGenericKeepsBody() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc id[T any](x T) T { return x }"
	var p @Parser = mkBniParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseBniGenericKeepsBody", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if len(d.TypeParams) != 1 {
		return fail("TestParseBniGenericKeepsBody", "expected 1 type parameter")
	}
	if d.Body == nil {
		return fail("TestParseBniGenericKeepsBody", "generic decl should carry Body in .bni mode")
	}
	return ""
}

// A method whose receiver is a generic-type instantiation
// (`func (b @Box[T]) Get() T`) carries no decl-level TypeParams
// but IS monomorphized per instantiation, so a cross-package
// consumer needs its body — .bni mode must parse it.
func TestParseBniGenericRecvMethodKeepsBody() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc (b @Box[T]) Get() T { return b.val }"
	var p @Parser = mkBniParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseBniGenericRecvMethodKeepsBody", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Recv == nil {
		return fail("TestParseBniGenericRecvMethodKeepsBody", "expected a receiver")
	}
	if len(d.TypeParams) != 0 {
		return fail("TestParseBniGenericRecvMethodKeepsBody",
				"generic-receiver method carries no decl-level type params")
	}
	if d.Body == nil {
		return fail("TestParseBniGenericRecvMethodKeepsBody",
				"generic-receiver method should carry Body in .bni mode")
	}
	return ""
}

// A method on a NON-generic type stays signature-only in .bni mode.
func TestParseBniNonGenericMethodNoBody() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc (b @Box) Get() int"
	var p @Parser = mkBniParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseBniNonGenericMethodNoBody", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Body != nil {
		return fail("TestParseBniNonGenericMethodNoBody",
				"non-generic method should have nil Body in .bni mode")
	}
	return ""
}

// A comment-collecting parse records each signature's delimiters, in source order:
// a method's receiver parentheses, name and result list, a generic function's
// type-parameter brackets, a function literal's parameters (no name) and an
// interface method's (keyed by its name); the function literal tried as an
// expression in a type argument, and then read as a type, leaves no record.  A
// non-collecting parse records none.
func TestParseSignatures() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"func (r @T) f(a int) (int, bool) {\n"
			"\treturn 1, true\n"
			"}\n"
			"func g[T any](x T) T {\n"
			"\th := func(y int) int { return y }\n"
			"\t_ = k[*func(int) int](h)\n"
			"\treturn x\n"
			"}\n"
			"interface I {\n"
			"\tM(a int) int\n"
			"}\n"
	var p @Parser = mkCollectingParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 { return fail("TestParseSignatures", p.Errors()[0].Msg) }
	var rs @[]@ast.Signature = f.Signatures
	if len(rs) != 4 { return fail("TestParseSignatures", "expected 4 records") }
	var m @ast.Signature = rs[0]
	if !atLine(m.Pos, 2, 1) || !atLine(m.RecvOpen, 2, 6) || !atLine(m.RecvClose, 2, 11) ||
			!atLine(m.Name, 2, 13) || m.TypeOpen.Line != 0 {
		return fail("TestParseSignatures", "f: `func` 2:1, receiver 2:6-2:11, name 2:13, no `[`")
	}
	if !atLine(m.Open, 2, 14) || !atLine(m.Close, 2, 20) || !atLine(m.ResultOpen, 2, 22) ||
			!atLine(m.ResultClose, 2, 32) {
		return fail("TestParseSignatures", "f: parameters 2:14-2:20, results 2:22-2:32")
	}
	var g @ast.Signature = rs[1]
	if !atLine(g.Pos, 5, 1) || !atLine(g.Name, 5, 6) || !atLine(g.TypeOpen, 5, 7) ||
			!atLine(g.TypeClose, 5, 13) || !atLine(g.Open, 5, 14) || !atLine(g.Close, 5, 18) ||
			g.RecvOpen.Line != 0 || g.ResultOpen.Line != 0 {
		return fail("TestParseSignatures",
				"g: name 5:6, `[` 5:7, `]` 5:13, parameters 5:14-5:18, no receiver or `(` result")
	}
	var lit @ast.Signature = rs[2]
	if !atLine(lit.Pos, 6, 7) || lit.Name.Line != 0 || !atLine(lit.Open, 6, 11) ||
			!atLine(lit.Close, 6, 17) {
		return fail("TestParseSignatures", "literal: `func` 6:7, no name, parameters 6:11-6:17")
	}
	var im @ast.Signature = rs[3]
	if !atLine(im.Pos, 11, 2) || !atLine(im.Name, 11, 2) || !atLine(im.Open, 11, 3) ||
			!atLine(im.Close, 11, 9) {
		return fail("TestParseSignatures", "M: name 11:2, parameters 11:3-11:9")
	}
	var q @Parser = mkParser(src)
	if len(q.ParseFile().Signatures) != 0 {
		return fail("TestParseSignatures", "a non-collecting parse should record none")
	}
	return ""
}
