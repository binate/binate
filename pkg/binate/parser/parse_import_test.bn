package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/builtins/testing"

// Tests for the positions ParseFile records on import specs (DeclPos,
// ImportPos, RParen, PathPos) and on the file (PkgPos), which the formatter
// reads to reproduce the layout.

// atLine reports whether pos is at line and col.
func atLine(pos token.Pos, line int, col int) bool {
	return pos.Line == line && pos.Col == col
}

// An ungrouped import's DeclPos is its `import` keyword, or its annotation
// block's `#`; its RParen is the zero Pos.
func TestParseImportDeclPositions() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"import \"pkg/a\"\n"
			"#[\n"
			"build(is(os, \"linux\"))]\n"
			"import \"pkg/b\"\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 { return fail("TestParseImportDeclPositions", p.Errors()[0].Msg) }
	if len(f.Imports) != 2 { return fail("TestParseImportDeclPositions", "expected 2 imports") }
	var a @ast.ImportSpec = f.Imports[0]
	if !atLine(a.DeclPos, 2, 1) || !atLine(a.ImportPos, 2, 1) || a.RParen.Line != 0 {
		return fail("TestParseImportDeclPositions", "pkg/a: DeclPos and ImportPos at 2:1, no RParen")
	}
	var b @ast.ImportSpec = f.Imports[1]
	if !atLine(b.DeclPos, 3, 1) || !atLine(b.ImportPos, 5, 1) || b.RParen.Line != 0 {
		return fail("TestParseImportDeclPositions", "pkg/b: DeclPos at the # (3:1), ImportPos at 5:1")
	}
	return ""
}

// A grouped import's specs share the group's DeclPos, ImportPos and RParen.
func TestParseImportGroupPositions() testing.TestResult {
	var src *[]readonly char = "package \"t\"\n"
			"#[build(is(os, \"linux\"))]\n"
			"import (\n"
			"\t\"pkg/a\"\n"
			"\t\"pkg/b\"\n"
			")\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 { return fail("TestParseImportGroupPositions", p.Errors()[0].Msg) }
	if len(f.Imports) != 2 { return fail("TestParseImportGroupPositions", "expected 2 imports") }
	for i := 0; i < 2; i++ {
		var s @ast.ImportSpec = f.Imports[i]
		if !atLine(s.DeclPos, 2, 1) || !atLine(s.ImportPos, 3, 1) || !atLine(s.RParen, 6, 1) {
			return fail("TestParseImportGroupPositions", "each spec: DeclPos 2:1, ImportPos 3:1, RParen 6:1")
		}
	}
	return ""
}

// An unannotated group's specs have DeclPos at its `import`, as ImportPos is.
func TestParseImportUnannotatedGroupPositions() testing.TestResult {
	var src *[]readonly char = "package \"t\"\nimport (\n\t\"pkg/a\"\n)\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 {
		return fail("TestParseImportUnannotatedGroupPositions", p.Errors()[0].Msg)
	}
	if len(f.Imports) != 1 {
		return fail("TestParseImportUnannotatedGroupPositions", "expected 1 import")
	}
	var s @ast.ImportSpec = f.Imports[0]
	if !atLine(s.DeclPos, 2, 1) || !atLine(s.ImportPos, 2, 1) || !atLine(s.RParen, 4, 1) {
		return fail("TestParseImportUnannotatedGroupPositions", "DeclPos and ImportPos 2:1, RParen 4:1")
	}
	return ""
}

// An import's PathPos is its path string's, after any alias (where Pos is); the
// file's PkgPos is its `package` keyword's, after an annotation block (where Pos
// is).
func TestParsePathAndPackagePositions() testing.TestResult {
	var src *[]readonly char = "#[build(is(os, \"linux\"))]\n"
			"package \"t\"\n"
			"import \"pkg/a\"\n"
			"import b \"pkg/b\"\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.Errors()) != 0 { return fail("TestParsePathAndPackagePositions", p.Errors()[0].Msg) }
	if !atLine(f.Pos, 1, 1) || !atLine(f.PkgPos, 2, 1) {
		return fail("TestParsePathAndPackagePositions", "file: Pos at the # (1:1), PkgPos at 2:1")
	}
	if len(f.Imports) != 2 { return fail("TestParsePathAndPackagePositions", "expected 2 imports") }
	if !atLine(f.Imports[0].PathPos, 3, 8) {
		return fail("TestParsePathAndPackagePositions", "pkg/a: PathPos at 3:8")
	}
	var b @ast.ImportSpec = f.Imports[1]
	if !atLine(b.Pos, 4, 8) || !atLine(b.PathPos, 4, 10) {
		return fail("TestParsePathAndPackagePositions", "pkg/b: Pos at the alias (4:8), PathPos 4:10")
	}
	return ""
}
