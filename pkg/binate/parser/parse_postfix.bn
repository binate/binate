package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// parsePostfixExpr parses a primary expression followed by postfix operators.
func parsePostfixExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parsePrimaryExpr(p)
	return continuePostfix(p, x)
}

// continuePostfix continues parsing postfix operators (., *[], ()) on an existing expression.
func continuePostfix(p @Parser, x @ast.Expr) @ast.Expr {
	for {
		if p.tok.Typ == token.DOT {
			// A `.` followed by `(` opens a type assertion or a type-switch head
			// (D13); otherwise `.` identifier is an ordinary selector.
			if p.peekTok().Typ == token.LPAREN {
				if p.peekTok2().Typ == token.TYPE {
					// `.(type)` heads a TYPE-SWITCH statement, never an expression;
					// it terminates the postfix loop so parseSwitchStmt consumes it
					// (D13); `x.(type)` elsewhere then surfaces as a parse error.
					return x
				}
				x = parseTypeAssertExpr(p, x) // `.( AssertTarget )` (parse_assert.bn)
			} else {
				var pos token.Pos = p.tok.Pos
				p.next()
				var nameTok token.Token = p.tok
				p.next()
				var e @ast.Expr = make(ast.Expr)
				e.Kind = ast.EXPR_SELECTOR
				e.Pos = pos
				e.X = x
				e.Name = nameTok.Lit
				x = e
			}
		} else if p.tok.Typ == token.LBRACKET {
			x = parseIndexOrSlice(p, x)
			// `Foo[T1, T2]{ ... }` — generic-instantiated composite
			// literal (§13.10).  parseIndexOrSlice produced an
			// EXPR_INSTANTIATE_OR_INDEX for the `Foo[...]` head; a
			// following `{` (outside a no-composite context like an
			// `if`/`for` condition) means it's a composite-literal type,
			// not value indexing.  Reinterpret the bracketed head as a
			// TEXPR_INSTANTIATE type and parse the body.  A non-type
			// head (e.g. `arr[i]` whose args aren't type-shaped) yields
			// nil and falls through unchanged.
			if p.tok.Typ == token.LBRACE && !p.noCompositeLit && x.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
				var head @ast.TypeExpr = instantiateExprToTypeExpr(x)
				if head != nil {
					x = parseCompositeLitBody(p, head)
				}
			}
		} else if p.tok.Typ == token.LPAREN {
			x = parseCallExpr(p, x)
		} else {
			return x
		}
	}
	return x
}

// parseIndexOrSlice parses one of:
//   x[lo:hi]           — slice, unambiguous
//   x[i]               — single bracketed expr; ambiguous between
//                        value indexing and single-type-arg generic
//                        instantiation, produces EXPR_INSTANTIATE_OR_INDEX
//   x[T1, T2, ...]     — multi bracketed exprs; only legal as generic
//                        instantiation (value indexing takes one
//                        expr), produces EXPR_INSTANTIATE_OR_INDEX
// The type checker disambiguates the
// single-element form by inspecting whether the head resolves to a
// generic decl or a value of slice / array type.
func parseIndexOrSlice(p @Parser, x @ast.Expr) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.next() // consume [

	// [:hi]
	if p.tok.Typ == token.COLON {
		p.next()
		var hi @ast.Expr = nil
		if p.tok.Typ != token.RBRACKET {
			hi = parseExprAllowComposite(p)
		}
		p.expect(token.RBRACKET)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_SLICE
		e.Pos = pos
		e.X = x
		e.Y = hi // hi
		// Z (lo) left nil
		return e
	}

	// A bracket element beginning with a type-only prefix
	// (startsBracketTypeArg) has no expression spelling, so it can only be
	// a generic-instantiation type argument, never a value index or slice
	// bound: parse it as a type and wrap it in EXPR_TYPE.  Any other
	// element goes through parseBracketExprOrType, which keeps an
	// expression (`*T` / `*p`, reinterpreted as a type argument by the
	// checker where one is expected) and re-reads a type that is not one.
	if startsBracketTypeArg(p) {
		var args @[]@ast.Expr
		args = slices.Append[@ast.Expr](args, parseBracketTypeArg(p))
		for p.tok.Typ == token.COMMA {
			p.next()
			if p.tok.Typ == token.RBRACKET { break }
			args = slices.Append[@ast.Expr](args, parseBracketElem(p))
		}
		p.expect(token.RBRACKET)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_INSTANTIATE_OR_INDEX
		e.Pos = pos
		e.X = x
		e.Args = args
		return e
	}

	var first @ast.Expr = parseBracketExprOrType(p, true)

	if p.tok.Typ == token.COLON {
		// x[lo:hi]
		p.next()
		var hi @ast.Expr = nil
		if p.tok.Typ != token.RBRACKET {
			hi = parseExprAllowComposite(p)
		}
		p.expect(token.RBRACKET)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_SLICE
		e.Pos = pos
		e.X = x
		e.Y = hi // hi
		e.Z = first // lo
		return e
	}

	// x[i] or x[T1, T2, ...]
	var args @[]@ast.Expr
	args = slices.Append[@ast.Expr](args, first)
	for p.tok.Typ == token.COMMA {
		p.next()
		if p.tok.Typ == token.RBRACKET { break }
		args = slices.Append[@ast.Expr](args, parseBracketElem(p))
	}
	p.expect(token.RBRACKET)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_INSTANTIATE_OR_INDEX
	e.Pos = pos
	e.X = x
	e.Args = args
	return e
}

// startsBracketTypeArg reports whether the current token begins a
// generic-instantiation type argument that must be routed to the type
// parser: `@…` (any managed form), `*[` (raw slice), `[` (an array
// type `[N]T`), `readonly …` or `struct …` (no expression begins with
// either).  `*T` / `*p` are deliberately excluded — they parse fine as
// expressions (unary deref) and the type checker reinterprets `*T` as a
// type arg; the other `*…` forms are settled by parseBracketExprOrType.
//
// A leading `[` is committed to the type path so `f[[N]T]` (e.g.
// `New[[2]@Counter]()`) resolves the array as a type arg — array types
// parse only via parseType, not as expressions.  The one form this
// forgoes is a bracket element that is an array *literal* `[N]T{…}`
// (i.e. indexing by an array value), which has no valid meaning anyway.
func startsBracketTypeArg(p @Parser) bool {
	if p.tok.Typ == token.AT { return true }
	if p.tok.Typ == token.LBRACKET { return true }
	if p.tok.Typ == token.READONLY || p.tok.Typ == token.STRUCT { return true }
	if p.tok.Typ == token.STAR && p.peekTok().Typ == token.LBRACKET {
		return true
	}
	return false
}

// parseBracketElem parses one bracket element, choosing the type-arg
// path for type-only forms (startsBracketTypeArg) and the expression
// path otherwise.  Used for the comma-separated tail of a bracketed
// list so mixed `f[int, @T]` works.
func parseBracketElem(p @Parser) @ast.Expr {
	if startsBracketTypeArg(p) {
		return parseBracketTypeArg(p)
	}
	return parseBracketExprOrType(p, false)
}

// parseBracketExprOrType parses a bracket element that has no type-only prefix:
// as an expression when it is one (an index, a slice bound, or a type argument
// the checker reinterprets — `T`, `*T`, `pkg.T`), and otherwise as a type.  A
// type argument such as `*(@[]int)`, `*@[]int` or `*func(int) int` starts like an
// expression (a dereference) but is not one, so it fails to parse as an
// expression and the element is re-read as a type.  A type that is not an
// expression can only be a type argument; an element that is both stays an
// expression, and the checker decides between instantiation and index
// (binate.ebnf D5).  If it is not a type either, the expression attempt's errors
// are the ones reported.  Only an element whose first token can begin both an
// expression and such a type is parsed twice, and the expression attempt stops
// where the type ends (a literal missing its `{` ends there — parseLitBody,
// parseFuncLit), so the re-read costs no more than the element; allowComposite
// selects the composite-literal-admitting expression parser (the first
// element's).
func parseBracketExprOrType(p @Parser, allowComposite bool) @ast.Expr {
	if !startsExprOrTypeOnly(p) {
		if allowComposite { return parseExprAllowComposite(p) }
		return parseExpr(p)
	}
	var start parseState = saveParseState(p)
	var e @ast.Expr
	if allowComposite {
		e = parseExprAllowComposite(p)
	} else {
		e = parseExpr(p)
	}
	if len(p.errs) == len(start.errs) && endsBracketElem(p, true) {
		return e
	}
	var afterExpr parseState = saveParseState(p)
	restoreParseState(p, start)
	var te @ast.Expr = parseBracketTypeArg(p)
	if len(p.errs) == len(start.errs) && endsBracketElem(p, false) {
		return te
	}
	restoreParseState(p, afterExpr)
	return e
}

// startsExprOrTypeOnly reports whether the current token can begin both an
// expression and a type that is not an expression: `*` (a dereference, or a
// pointer to a type-only form) or `(` (a parenthesized expression or type).
func startsExprOrTypeOnly(p @Parser) bool {
	var t token.Type = p.tok.Typ
	return t == token.STAR || t == token.LPAREN
}

// endsBracketElem reports whether the current token can follow a complete
// bracket element: `]`, `,`, or — for an expression, which may be a slice's low
// bound — `:`.
func endsBracketElem(p @Parser, allowColon bool) bool {
	var t token.Type = p.tok.Typ
	return t == token.RBRACKET || t == token.COMMA || (allowColon && t == token.COLON)
}

// parseBracketTypeArg parses a type expression in bracket (generic
// type-argument) position and wraps it in an EXPR_TYPE node so it
// can ride in the EXPR_INSTANTIATE_OR_INDEX Args list alongside
// expression-shaped args.  The type checker (typeArgFromExpr) and
// IR-gen (exprToTypeExpr) read the wrapped TypeRef directly.
func parseBracketTypeArg(p @Parser) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	var te @ast.TypeExpr = parseType(p)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_TYPE
	e.Pos = pos
	e.TypeRef = te
	return e
}

// parseCallExpr parses a function call expression with arguments.
func parseCallExpr(p @Parser, fn @ast.Expr) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.next() // consume (
	var args @[]@ast.Expr
	if p.tok.Typ != token.RPAREN {
		// Call arguments are no longer at a condition's top level, so a
		// composite literal is unambiguous here (`if f(Point{1,2}) {}`).
		var old bool = p.noCompositeLit
		p.noCompositeLit = false
		args = parseExprList(p)
		p.noCompositeLit = old
	}
	// A trailing `expr...` on the FINAL argument is a slice spread
	// (func.variadic.spread).  parseExprList leaves the parser positioned ON the
	// `...` (the general expression path never consumes it), so detect it here —
	// NOT in the shared parseExprList, which would wrongly accept `return a...`.
	var spread bool = false
	if p.tok.Typ == token.ELLIPSIS {
		p.next() // consume ...
		spread = true
		if p.tok.Typ != token.RPAREN {
			p.addError(p.tok.Pos, "spread argument must be last")
			// The parser does not advance on an `expect` mismatch, so skip the
			// stray tokens to RPAREN/EOF to avoid a cascading "expected )".
			for p.tok.Typ != token.RPAREN && p.tok.Typ != token.EOF {
				p.next()
			}
		}
	}
	p.expect(token.RPAREN)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_CALL
	e.Pos = pos
	e.X = fn
	e.Args = args
	e.Spread = spread
	return e
}
