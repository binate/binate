package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for postfix-expression parsing (parse_postfix.bn): calls, indexing and
// slicing, bracketed type arguments, and selectors.

func TestParseCallExpr() testing.TestResult {
	var p @Parser = mkParser("foo(1, 2)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_CALL {
		return fail("TestParseCallExpr", "expected EXPR_CALL")
	}
	if e.X.Kind != ast.EXPR_IDENT {
		return fail("TestParseCallExpr", "expected IDENT callee")
	}
	if len(e.Args) != 2 {
		return fail("TestParseCallExpr", "expected 2 args")
	}
	return ""
}

func TestParseIndexExpr() testing.TestResult {
	var p @Parser = mkParser("arr[0]")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX {
		return fail("TestParseIndexExpr", "expected EXPR_INSTANTIATE_OR_INDEX")
	}
	if e.X.Kind != ast.EXPR_IDENT {
		return fail("TestParseIndexExpr", "expected IDENT base")
	}
	if len(e.Args) != 1 {
		return fail("TestParseIndexExpr", "expected 1 arg")
	}
	if e.Args[0].Kind != ast.EXPR_INT_LIT {
		return fail("TestParseIndexExpr", "expected INT_LIT index")
	}
	return ""
}

// Multi-arg bracketed form `name[T1, T2]` — syntactic shape of
// generic instantiation. Parser accepts it; type-checker rejects
// in Slice 1 (since generics aren't supported yet).
func TestParseGenericInstantiate() testing.TestResult {
	var p @Parser = mkParser("sort[int, *Point]")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX {
		return fail("TestParseGenericInstantiate", "expected EXPR_INSTANTIATE_OR_INDEX")
	}
	if e.X.Kind != ast.EXPR_IDENT {
		return fail("TestParseGenericInstantiate", "expected IDENT head")
	}
	if !charEq(e.X.Name, "sort") {
		return fail("TestParseGenericInstantiate", "expected head 'sort'")
	}
	if len(e.Args) != 2 {
		return fail("TestParseGenericInstantiate", "expected 2 type args")
	}
	if e.Args[0].Kind != ast.EXPR_IDENT {
		return fail("TestParseGenericInstantiate", "expected first arg IDENT")
	}
	if !charEq(e.Args[0].Name, "int") {
		return fail("TestParseGenericInstantiate", "expected first arg 'int'")
	}
	return ""
}

// `f[@T]` — managed-pointer type argument.  Has no expression
// spelling, so the parser must route it through parseType and wrap
// it in EXPR_TYPE.  Regression for the CRITICAL "generic call type
// args reject @T / @[]T / *[]T" parser bug.
func TestParseManagedPtrTypeArg() testing.TestResult {
	var p @Parser = mkParser("Append[@Decl]")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX {
		return fail("TestParseManagedPtrTypeArg", "expected EXPR_INSTANTIATE_OR_INDEX")
	}
	if len(e.Args) != 1 {
		return fail("TestParseManagedPtrTypeArg", "expected 1 type arg")
	}
	if e.Args[0].Kind != ast.EXPR_TYPE {
		return fail("TestParseManagedPtrTypeArg", "expected EXPR_TYPE arg")
	}
	if e.Args[0].TypeRef == nil || e.Args[0].TypeRef.Kind != ast.TEXPR_MANAGED {
		return fail("TestParseManagedPtrTypeArg", "expected TEXPR_MANAGED TypeRef")
	}
	return ""
}

// `f[@[]T]` (managed slice) and `f[*[]T]` (raw slice) type args:
// both type-only forms, both wrapped in EXPR_TYPE.
func TestParseSliceTypeArgs() testing.TestResult {
	var p @Parser = mkParser("Append[@[]char]")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX || len(e.Args) != 1 || e.Args[0].Kind != ast.EXPR_TYPE {
		return fail("TestParseSliceTypeArgs", "@[]char: expected single EXPR_TYPE arg")
	}
	if e.Args[0].TypeRef == nil || e.Args[0].TypeRef.Kind != ast.TEXPR_MANAGED_SLICE {
		return fail("TestParseSliceTypeArgs", "expected TEXPR_MANAGED_SLICE")
	}
	var p2 @Parser = mkParser("Append[*[]uint8]")
	var e2 @ast.Expr = parseExpr(p2)
	if e2.Kind != ast.EXPR_INSTANTIATE_OR_INDEX || len(e2.Args) != 1 ||
			e2.Args[0].Kind != ast.EXPR_TYPE {
		return fail("TestParseSliceTypeArgs", "*[]uint8: expected single EXPR_TYPE arg")
	}
	if e2.Args[0].TypeRef == nil || e2.Args[0].TypeRef.Kind != ast.TEXPR_SLICE {
		return fail("TestParseSliceTypeArgs", "expected TEXPR_SLICE")
	}
	return ""
}

// Mixed `f[int, @T]`: a bare-name expression arg followed by a
// type-only EXPR_TYPE arg.  Each bracket element is classified
// independently.
func TestParseMixedTypeArgs() testing.TestResult {
	var p @Parser = mkParser("Pair[int, @Decl]")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX || len(e.Args) != 2 {
		return fail("TestParseMixedTypeArgs", "expected 2 args")
	}
	if e.Args[0].Kind != ast.EXPR_IDENT {
		return fail("TestParseMixedTypeArgs", "expected first arg EXPR_IDENT")
	}
	if e.Args[1].Kind != ast.EXPR_TYPE {
		return fail("TestParseMixedTypeArgs", "expected second arg EXPR_TYPE")
	}
	return ""
}

// `f[[N]T]` — an ARRAY type argument.  A leading `[` has no bare
// expression spelling (only an array LITERAL `[N]T{…}` does), so the
// parser routes it through parseType and wraps it in EXPR_TYPE — as for
// the other type-only forms.  Regression for the "generic call type args
// reject an array type (`expected {, got ]`)" parser bug.
func TestParseArrayTypeArg() testing.TestResult {
	var p @Parser = mkParser("Holder[[2]int]")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX || len(e.Args) != 1 {
		return fail("TestParseArrayTypeArg", "expected single-arg EXPR_INSTANTIATE_OR_INDEX")
	}
	if e.Args[0].Kind != ast.EXPR_TYPE {
		return fail("TestParseArrayTypeArg", "expected EXPR_TYPE arg")
	}
	if e.Args[0].TypeRef == nil || e.Args[0].TypeRef.Kind != ast.TEXPR_ARRAY {
		return fail("TestParseArrayTypeArg", "expected TEXPR_ARRAY TypeRef")
	}
	// An array type as a NON-first arg goes through the comma-tail
	// parseBracketElem, which re-classifies each element independently.
	var p2 @Parser = mkParser("Pair[int, [2]char]")
	var e2 @ast.Expr = parseExpr(p2)
	if e2.Kind != ast.EXPR_INSTANTIATE_OR_INDEX || len(e2.Args) != 2 {
		return fail("TestParseArrayTypeArg", "mixed: expected 2 args")
	}
	if e2.Args[1].Kind != ast.EXPR_TYPE || e2.Args[1].TypeRef == nil ||
			e2.Args[1].TypeRef.Kind != ast.TEXPR_ARRAY {
		return fail("TestParseArrayTypeArg", "mixed: expected second arg EXPR_TYPE/TEXPR_ARRAY")
	}
	return ""
}

// `arr[*p]` must stay a value index (deref expression), NOT be
// mistaken for a `*[]T`-style type arg: `*` followed by an
// identifier is the deref-expression path, only `*[` routes to the
// type parser.
func TestParseDerefIndexNotTypeArg() testing.TestResult {
	var p @Parser = mkParser("arr[*p]")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX || len(e.Args) != 1 {
		return fail("TestParseDerefIndexNotTypeArg", "expected 1 arg")
	}
	if e.Args[0].Kind != ast.EXPR_UNARY {
		return fail("TestParseDerefIndexNotTypeArg",
				"expected EXPR_UNARY (deref), got a non-expression arg")
	}
	return ""
}

func TestParseSliceExpr() testing.TestResult {
	var p @Parser = mkParser("arr[1:3]")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_SLICE {
		return fail("TestParseSliceExpr", "expected EXPR_SLICE")
	}
	return ""
}

func TestParseSelectorExpr() testing.TestResult {
	var p @Parser = mkParser("x.y")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_SELECTOR {
		return fail("TestParseSelectorExpr", "expected EXPR_SELECTOR")
	}
	if !charEq(e.Name, "y") {
		return fail("TestParseSelectorExpr", "expected field 'y'")
	}
	return ""
}

// A type argument that begins like an expression but is not one — a pointer to a
// parenthesized or managed type — is re-read as a type (EXPR_TYPE), with no
// errors left over from the expression attempt.
func TestParseTypeArgPointerToTypeOnly() testing.TestResult {
	var p @Parser = mkParser("f[*(@[]int), *@[]int](x)")
	var e @ast.Expr = parseExpr(p)
	if len(p.errs) != 0 {
		return fail("TestParseTypeArgPointerToTypeOnly", "unexpected parse errors")
	}
	if e.Kind != ast.EXPR_CALL || e.X == nil || e.X.Kind != ast.EXPR_INSTANTIATE_OR_INDEX ||
			len(e.X.Args) != 2 {
		return fail("TestParseTypeArgPointerToTypeOnly", "expected a call of a 2-arg instantiation")
	}
	for i := 0; i < 2; i++ {
		var a @ast.Expr = e.X.Args[i]
		if a.Kind != ast.EXPR_TYPE || a.TypeRef == nil || a.TypeRef.Kind != ast.TEXPR_POINTER {
			return fail("TestParseTypeArgPointerToTypeOnly", "expected EXPR_TYPE pointer args")
		}
	}
	return ""
}

// `readonly` begins no expression, so a `readonly` type argument goes straight to
// the type parser, first or later in the list.
func TestParseTypeArgReadonly() testing.TestResult {
	var p @Parser = mkParser("f[readonly int, readonly @[]char]")
	var e @ast.Expr = parseExpr(p)
	if len(p.errs) != 0 || e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX || len(e.Args) != 2 {
		return fail("TestParseTypeArgReadonly", "expected a clean 2-arg instantiation")
	}
	if e.Args[0].Kind != ast.EXPR_TYPE || e.Args[1].Kind != ast.EXPR_TYPE ||
			e.Args[0].TypeRef.Kind != ast.TEXPR_CONST {
		return fail("TestParseTypeArgReadonly", "expected EXPR_TYPE readonly args")
	}
	return ""
}

// An element that parses as an expression stays one: `*(p)` is a dereference
// index, and a slice bound.
func TestParseDerefParenIndexStaysExpr() testing.TestResult {
	var p @Parser = mkParser("a[*(p)]")
	var e @ast.Expr = parseExpr(p)
	if len(p.errs) != 0 || e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX || len(e.Args) != 1 ||
			e.Args[0].Kind != ast.EXPR_UNARY {
		return fail("TestParseDerefParenIndexStaysExpr", "expected a deref index")
	}
	var p2 @Parser = mkParser("a[*(p):]")
	var e2 @ast.Expr = parseExpr(p2)
	if len(p2.errs) != 0 || e2.Kind != ast.EXPR_SLICE || e2.Z == nil || e2.Z.Kind != ast.EXPR_UNARY {
		return fail("TestParseDerefParenIndexStaysExpr", "expected a slice with a deref low bound")
	}
	return ""
}

// An element that is neither an expression nor a type reports the expression
// attempt's errors, not the type attempt's.
func TestParseBracketElemErrorsFromExpr() testing.TestResult {
	var p @Parser = mkParser("a[*(1 + )]")
	_ = parseExpr(p)
	if len(p.errs) == 0 {
		return fail("TestParseBracketElemErrorsFromExpr", "expected a parse error")
	}
	if !charEq(p.errs[0].Msg, "expected expression") {
		return fail("TestParseBracketElemErrorsFromExpr", "expected the expression parser's error first")
	}
	return ""
}

// A comment inside a type argument that is read twice (as an expression, then as
// a type) is collected once.
func TestParseTypeArgCommentCollectedOnce() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func g() {\n"
			"\t_ = f[*( /* c */ @[]int)](nil)\n"
			"}\n"
	var p @Parser = mkCollectingParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.errs) != 0 {
		return fail("TestParseTypeArgCommentCollectedOnce", "unexpected parse errors")
	}
	if len(f.Comments) != 1 {
		return fail("TestParseTypeArgCommentCollectedOnce", "expected the comment collected once")
	}
	return ""
}

// `struct` begins no expression, so an anonymous struct type argument goes
// straight to the type parser.
func TestParseTypeArgStruct() testing.TestResult {
	var p @Parser = mkParser("f[struct { a int }]")
	var e @ast.Expr = parseExpr(p)
	if len(p.errs) != 0 || e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX || len(e.Args) != 1 ||
			e.Args[0].Kind != ast.EXPR_TYPE || e.Args[0].TypeRef.Kind != ast.TEXPR_STRUCT {
		return fail("TestParseTypeArgStruct", "expected an EXPR_TYPE struct arg")
	}
	return ""
}

// Many function-value type arguments in one block parse cleanly and in linear
// time: the expression attempt at each ends where its type ends (a function
// literal missing its `{` stops there) instead of reading the rest of the block,
// which re-parsed every later such element inside the discarded attempt and
// doubled the time with each one.
func TestParseManyFuncTypeArgs() testing.TestResult {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("package \"test\"\nfunc g() {\n")
	for i := 0; i < 40; i++ {
		sb.Write("\t_ = id[*func(int) int](double)\n")
	}
	sb.Write("}\n")
	var p @Parser = mkParser(sb.String())
	var f @ast.File = p.ParseFile()
	if len(p.errs) != 0 {
		return fail("TestParseManyFuncTypeArgs", "unexpected parse errors")
	}
	if len(f.Decls) != 1 || f.Decls[0].Body == nil || len(f.Decls[0].Body.Stmts) != 40 {
		return fail("TestParseManyFuncTypeArgs", "expected g with 40 statements")
	}
	return ""
}

// A function literal missing its `{` is reported there and ends; the statements
// after it still parse.
func TestParseFuncLitMissingBrace() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func g() {\n"
			"\tx := func() int\n"
			"\ty := 1\n"
			"}\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(p.errs) != 1 {
		return fail("TestParseFuncLitMissingBrace", "expected exactly one parse error")
	}
	var want *[]readonly char = "expected {"
	var msg @[]char = p.errs[0].Msg
	if len(msg) < len(want) || !charEq(msg[:len(want)], want) {
		return fail("TestParseFuncLitMissingBrace", "expected an `expected {` error")
	}
	if len(f.Decls) != 1 || f.Decls[0].Body == nil || len(f.Decls[0].Body.Stmts) != 2 {
		return fail("TestParseFuncLitMissingBrace", "expected g's two statements to survive")
	}
	return ""
}
