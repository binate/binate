package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"
import "pkg/stdx/slices"

// ============================================================
// Primary Expressions and Composite Literals
// ============================================================

// parsePrimaryExpr parses a primary expression: builtins, identifiers, literals, arrays, or parens.
func parsePrimaryExpr(p @Parser) @ast.Expr {
	// A builtin call's operands are inside its parentheses, so a composite
	// literal is allowed there even in an `if` / `for` / `switch` header, as in
	// an ordinary call's arguments (expr.disambiguation.d4-paren).  A keyword
	// missing its `(` opens no parentheses: `if len x {` keeps its block.
	if token.IsBuiltin(p.tok.Typ) {
		var old bool = p.noCompositeLit
		if p.peekTok().Typ == token.LPAREN { p.noCompositeLit = false }
		var e @ast.Expr = parseBuiltinCall(p)
		p.noCompositeLit = old
		return e
	}

	// Function literal: func(...) <results> { ... } in expression position.
	if p.tok.Typ == token.FUNC {
		return parseFuncLit(p)
	}

	// Identifier — check for composite literal
	if p.tok.Typ == token.IDENT {
		return parseIdentOrCompositeLit(p)
	}

	// Literals
	if p.tok.Typ == token.INT {
		var tok token.Token = p.tok
		p.next()
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_INT_LIT
		e.Pos = tok.Pos
		e.Name = tok.Lit
		return e
	}
	if p.tok.Typ == token.FLOAT {
		var tok token.Token = p.tok
		p.next()
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_FLOAT_LIT
		e.Pos = tok.Pos
		e.Name = tok.Lit
		return e
	}
	if p.tok.Typ == token.STRING {
		var tok token.Token = p.tok
		p.next()
		var lit @[]char = tok.Lit
		// Each source literal in the (possibly adjacent) run is recorded in parts
		// so a source-preserving tool can re-emit the author's split; Name still
		// carries the merged literal the compiler consumes.
		var parts @[]@ast.StrPart
		parts = slices.Append[@ast.StrPart](parts, newStrPart(tok))
		// C-style adjacent string-literal concatenation in expression
		// context. Two shapes accepted:
		//   "foo" "bar"           — same line, lexer emits STRING STRING
		//   "foo"\n"bar"          — different lines, ASI inserts a SEMI
		// For the latter, peek past the SEMI to check if a STRING
		// follows; if so, consume the SEMI (it's spurious in expression
		// context) and merge. Otherwise leave the SEMI alone — it ends
		// the enclosing statement.
		// Done here (not in the lexer) because grouped imports also use
		// STRING SEMI("\n") STRING and there ASI is the path separator
		// — a lexer-level merge would silently glue separate paths.
		for {
			if p.tok.Typ == token.STRING {
				lit = mergeAdjacentStringLits(lit, p.tok.Lit)
				parts = slices.Append[@ast.StrPart](parts, newStrPart(p.tok))
				p.next()
				continue
			}
			if p.tok.Typ == token.SEMICOLON && len(p.tok.Lit) > 0 && p.tok.Lit[0] == '\n' {
				var pk token.Token = p.peekTok()
				if pk.Typ != token.STRING {
					break
				}
				p.next() // consume the ASI SEMI
				// pk has been stashed; next consumes it.
				lit = mergeAdjacentStringLits(lit, p.tok.Lit)
				parts = slices.Append[@ast.StrPart](parts, newStrPart(p.tok))
				p.next()
				continue
			}
			break
		}
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_STRING_LIT
		e.Pos = tok.Pos
		e.Name = lit
		if len(parts) > 1 {
			e.StrParts = parts
		}
		return e
	}
	if p.tok.Typ == token.CHAR {
		var tok token.Token = p.tok
		p.next()
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_CHAR_LIT
		e.Pos = tok.Pos
		e.Name = tok.Lit
		return e
	}
	if p.tok.Typ == token.TRUE {
		var pos token.Pos = p.tok.Pos
		p.next()
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BOOL_LIT
		e.Pos = pos
		e.Name = "true"
		e.BoolVal = true
		return e
	}
	if p.tok.Typ == token.FALSE {
		var pos token.Pos = p.tok.Pos
		p.next()
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BOOL_LIT
		e.Pos = pos
		e.Name = "false"
		e.BoolVal = false
		return e
	}
	if p.tok.Typ == token.NIL {
		var pos token.Pos = p.tok.Pos
		p.next()
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_NIL_LIT
		e.Pos = pos
		return e
	}

	// Array literal: [N]T{ ... }
	if p.tok.Typ == token.LBRACKET {
		return parseArrayLit(p)
	}

	// Managed-slice composite literal: @[]T{ ... }
	if p.tok.Typ == token.AT {
		return parseManagedSliceLit(p)
	}

	// Parenthesized expression.  Inside the parens composite literals
	// are allowed again even in a condition (the D4 paren-escape), so
	// clear noCompositeLit for the sub-expression.  The grouping folds away
	// (parens do not change meaning), but the flag is recorded so a
	// source-preserving tool can keep a disambiguating pair the author wrote;
	// nested layers set the same flag (`((x))` collapses to one).
	if p.tok.Typ == token.LPAREN {
		p.next()
		var x @ast.Expr = parseExprAllowComposite(p)
		p.expect(token.RPAREN)
		if x != nil { x.Parenthesized = true }
		return x
	}

	p.errMsg("expected expression")
	var pos token.Pos = p.tok.Pos
	p.next()
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_IDENT
	e.Pos = pos
	e.Name = "<error>"
	return e
}

// parseBuiltinCall parses a call of the builtin whose keyword is the current
// token (token.IsBuiltin), with that keyword's parser in parse_builtin.bn.
func parseBuiltinCall(p @Parser) @ast.Expr {
	switch p.tok.Typ {
	case token.MAKE:
		return parseMakeCall(p)
	case token.MAKE_SLICE:
		return parseMakeSliceCall(p)
	case token.BOX:
		return parseBoxCall(p)
	case token.CAST:
		return parseCastCall(p)
	case token.BIT_CAST:
		return parseBitCastCall(p)
	case token.UNSAFE_CAST:
		return parseUnsafeCastCall(p)
	case token.LEN:
		return parseLenCall(p)
	case token.PRESENT:
		return parsePresentCall(p)
	case token.SAME:
		return parseSameCall(p)
	case token.UNSAFE_INDEX:
		return parseUnsafeIndexCall(p)
	case token.UNSAFE_DIV, token.UNSAFE_REM, token.UNSAFE_SHL, token.UNSAFE_SHR:
		return parseUnsafeBinaryCall(p)
	case token.SIZEOF:
		return parseSizeofCall(p)
	case token.ALIGNOF:
		return parseAlignofCall(p)
	case token.FUNC_HANDLE:
		return parseFuncHandleCall(p)
	case token.C_CALL:
		return parseCCall(p)
	case token.C_GLOBAL:
		return parseCGlobal(p)
	case token.C_ENTRY:
		return parseCEntry(p)
	}
	panic("parser: parseBuiltinCall on a token that is not a builtin keyword")
}

// parseIdentOrCompositeLit parses an identifier, qualified name, or composite literal.
func parseIdentOrCompositeLit(p @Parser) @ast.Expr {
	var tok token.Token = p.tok
	p.next()

	// Qualified name: pkg.Type or pkg.member.  A `.` followed by `(` is NOT a
	// selector — it opens a type assertion or type-switch head (`x.(K T)` /
	// `x.(type)`, D13); leave it for the postfix layer (continuePostfix) to
	// resolve, returning the bare identifier here.
	if p.tok.Typ == token.DOT && p.peekTok().Typ != token.LPAREN {
		p.next()
		// The member's name is an identifier (`x.+` is a syntax error).
		var name token.Token = p.expect(token.IDENT)
		if p.tok.Typ == token.LBRACE && !p.noCompositeLit {
			// pkg.Type{ ... } — composite literal
			var te @ast.TypeExpr = make(ast.TypeExpr)
			te.Kind = ast.TEXPR_NAMED
			te.Pos = tok.Pos
			te.End = name.End
			te.Pkg = tok.Lit
			te.Name = name.Lit
			return parseCompositeLitBody(p, te)
		}
		// pkg.member — selector expression, whose Pos is its member's name
		var ident @ast.Expr = make(ast.Expr)
		ident.Kind = ast.EXPR_IDENT
		ident.Pos = tok.Pos
		ident.Name = tok.Lit
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_SELECTOR
		e.Pos = name.Pos
		e.X = ident
		e.Name = name.Lit
		// Its operand, the first name, is a level below it (pkg.source.nesting), as a
		// postfix selector's operand is (postfixChain).
		if p.depth + 1 > p.reached { p.reached = p.depth + 1 }
		return e
	}

	// Type{ ... } — composite literal
	if p.tok.Typ == token.LBRACE && !p.noCompositeLit {
		var te @ast.TypeExpr = make(ast.TypeExpr)
		te.Kind = ast.TEXPR_NAMED
		te.Pos = tok.Pos
		te.End = tok.End
		te.Name = tok.Lit
		return parseCompositeLitBody(p, te)
	}

	// Simple identifier
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_IDENT
	e.Pos = tok.Pos
	e.Name = tok.Lit
	return e
}

// parseRawSliceLit parses a raw-slice composite literal `*[]T{...}`
// after the leading `*` has already been consumed. `starPos` is the
// source position of the `*`. Per the plan, the type checker
// rejects the literal unless T is const (a mutable raw borrow has
// no sound backing).
func parseRawSliceLit(p @Parser, starPos token.Pos) @ast.Expr {
	p.expect(token.LBRACKET)
	p.expect(token.RBRACKET)
	var elem @ast.TypeExpr = parseType(p)

	var lbracePos token.Pos = p.tok.Pos
	var elems @[]@ast.Element = parseLitBody(p)

	var sliceTe @ast.TypeExpr = make(ast.TypeExpr)
	sliceTe.Kind = ast.TEXPR_SLICE
	sliceTe.Pos = starPos
	sliceTe.End = elem.End
	sliceTe.Base = elem

	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_COMPOSITE
	e.Pos = lbracePos
	e.TypeRef = sliceTe
	e.Elems = elems
	return e
}

// parseManagedSliceLit parses a managed-slice composite literal:
// `@[]T{ ... }`. Returns an EXPR_COMPOSITE node whose TypeRef is a
// TEXPR_MANAGED_SLICE wrapping the element type.
//
// Plain `@T{...}` (managed-pointer-to-struct literal) is not yet
// supported — the only `@`-prefixed expression starter is `@[]`.
func parseManagedSliceLit(p @Parser) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.expect(token.AT)
	p.expect(token.LBRACKET)
	p.expect(token.RBRACKET)
	var elem @ast.TypeExpr = parseType(p)

	var lbracePos token.Pos = p.tok.Pos
	var elems @[]@ast.Element = parseLitBody(p)

	var sliceTe @ast.TypeExpr = make(ast.TypeExpr)
	sliceTe.Kind = ast.TEXPR_MANAGED_SLICE
	sliceTe.Pos = pos
	sliceTe.End = elem.End
	sliceTe.Base = elem

	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_COMPOSITE
	e.Pos = lbracePos
	e.TypeRef = sliceTe
	e.Elems = elems
	return e
}

// parseLitBody parses a slice or array literal's `{ elements }`.  A missing `{`
// is recorded and ends the literal with no elements, rather than reading on as
// an element list: the bracketed type argument `f[*([3]int)](x)` is first tried
// as an expression, and that attempt must fail where the type ends.
func parseLitBody(p @Parser) @[]@ast.Element {
	var elems @[]@ast.Element
	if p.tok.Typ != token.LBRACE {
		p.errExpected(token.LBRACE)
		return elems
	}
	p.next()
	if p.tok.Typ != token.RBRACE {
		elems = parseElementList(p)
	}
	p.expect(token.RBRACE)
	return elems
}

// parseArrayLit parses an array literal ([N]T{ ... } or [...]T{ ... }).
func parseArrayLit(p @Parser) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.expect(token.LBRACKET)

	var length @ast.Expr
	var inferred bool = false
	if p.tok.Typ == token.ELLIPSIS {
		// [...]T{ ... } — inferred-length array: the length is the element
		// count, folded by the checker (checkCompositeLit).  Len stays nil;
		// LenInferred marks it.
		inferred = true
		p.next()
	} else {
		length = parseExprAllowComposite(p)
	}

	p.expect(token.RBRACKET)
	var elem @ast.TypeExpr = parseType(p)

	// Must be followed by {
	var lbracePos token.Pos = p.tok.Pos
	var elems @[]@ast.Element = parseLitBody(p)

	var arrType @ast.TypeExpr = make(ast.TypeExpr)
	arrType.Kind = ast.TEXPR_ARRAY
	arrType.Pos = pos
	arrType.End = elem.End
	arrType.Base = elem
	arrType.Len = length
	arrType.LenInferred = inferred

	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_COMPOSITE
	e.Pos = lbracePos
	e.TypeRef = arrType
	e.Elems = elems
	return e
}

// mergeAdjacentStringLits returns the C-style concatenation of two raw
// string literals (each in `"..."` form). Drops the trailing `"` of `a`
// and the leading `"` of `b` so the result is one quoted literal with
// the contents glued together. Escape sequences inside each input pass
// through verbatim — unescapeStr resolves them later.
func mergeAdjacentStringLits(a *[]readonly char, b *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	if len(a) >= 1 {
		cb.Write(a[0:len(a) - 1])
	}
	if len(b) >= 1 {
		cb.Write(b[1:len(b)])
	}
	return buf.CopyStr(cb.String())
}

// newStrPart records one source string literal of an adjacent-literal run: its
// raw text (quotes included) and position.
func newStrPart(tok token.Token) @ast.StrPart {
	var p @ast.StrPart = make(ast.StrPart)
	p.Lit = tok.Lit
	p.Pos = tok.Pos
	return p
}
