func TestParseFloatLeadingDot() testing.TestResult {
	var p @Parser = mkParser(".5")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_FLOAT_LIT {
		return fail("TestParseFloatLeadingDot", "expected EXPR_FLOAT_LIT")
	}
	if !charEq(e.Name, ".5") {
		return fail("TestParseFloatLeadingDot", "expected '.5'")
	}
	return ""
}

func TestParseStringLit() testing.TestResult {
	var p @Parser = mkParser("\"hello\"")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_STRING_LIT {
		return fail("TestParseStringLit", "expected EXPR_STRING_LIT")
	}
	// A plain single literal records no parts (StrParts is nil).
	if len(e.StrParts) != 0 {
		return fail("TestParseStringLit", "single literal should have no StrParts")
	}
	return ""
}

// Adjacent string literals merge into one Name but record their source parts so a
// source-preserving tool can re-emit the author's split.
func TestParseAdjacentStringLits() testing.TestResult {
	var p @Parser = mkParser("\"foo\" \"bar\"")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_STRING_LIT {
		return fail("TestParseAdjacentStringLits", "expected EXPR_STRING_LIT")
	}
	if !charEq(e.Name, "\"foobar\"") {
		return fail("TestParseAdjacentStringLits", "Name should be the merged literal")
	}
	if len(e.StrParts) != 2 {
		return fail("TestParseAdjacentStringLits", "expected 2 recorded parts")
	}
	if !charEq(e.StrParts[0].Lit, "\"foo\"") || !charEq(e.StrParts[1].Lit, "\"bar\"") {
		return fail("TestParseAdjacentStringLits", "parts should be the raw literals")
	}
	return ""
}

func TestParseBoolLit() testing.TestResult {
	var p @Parser = mkParser("true")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_BOOL_LIT {
		return fail("TestParseBoolLit", "expected EXPR_BOOL_LIT")
	}
	if !e.BoolVal {
		return fail("TestParseBoolLit", "expected true")
	}
	return ""
}

func TestParseNilLit() testing.TestResult {
	var p @Parser = mkParser("nil")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_NIL_LIT {
		return fail("TestParseNilLit", "expected EXPR_NIL_LIT")
	}
	return ""
}

func TestParseIdent() testing.TestResult {
	var p @Parser = mkParser("foo")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_IDENT {
		return fail("TestParseIdent", "expected EXPR_IDENT")
	}
	if !charEq(e.Name, "foo") {
		return fail("TestParseIdent", "expected 'foo'")
	}
	return ""
}
