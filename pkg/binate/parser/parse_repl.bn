package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// The REPL's entry points: a REPL code unit is parsed entry by entry — an
// import, a top-level declaration, or a run of statements — with the dispatch
// helpers choosing which, and EndReplEntry separating one entry from the next.

// ParseExpr parses a single expression from the parser's current
// position.  Caller is responsible for setting up the parser via New
// and for inspecting Errors afterward.  Used by the REPL to evaluate
// bare expressions in immediate mode.
func (p @Parser) ParseExpr() @ast.Expr {
	return parseExpr(p)
}

// ParseTopLevelDecl parses a single top-level declaration (`func`,
// `type`, `var`, `const`, `interface` or `impl`).  REPL entry point: a
// decl entered at the prompt becomes a persistent addition to the
// loaded module's scope.  Errors out (returns nil) if the current
// token doesn't start one.
func (p @Parser) ParseTopLevelDecl() @ast.Decl {
	return parseTopLevelDecl(p)
}

// IsAtTopLevelDecl returns true if the parser's current token
// starts a top-level declaration (func / type / var / const /
// interface / impl).  REPL dispatch helper: lets the prompt route an
// entry to ParseTopLevelDecl vs. ParseStmtList without exposing the
// parser's token-type internals.  Call at the start of an entry:
// immediately after `New` (which preloads the first token), or after
// an EndReplEntry that reported more input.
func (p @Parser) IsAtTopLevelDecl() bool {
	if p.tok.Typ == token.FUNC { return true }
	if p.tok.Typ == token.TYPE { return true }
	if p.tok.Typ == token.VAR { return true }
	if p.tok.Typ == token.CONST { return true }
	if p.tok.Typ == token.INTERFACE { return true }
	if p.tok.Typ == token.IMPL { return true }
	return false
}

// IsAtImport returns true if the parser's current token is
// `import`.  REPL dispatch helper: an entry that starts with
// `import` is routed to ParseImportDecl rather than the
// top-level-decl or stmt-list paths.  Same call-at-the-start-of-an-
// entry contract as IsAtTopLevelDecl.
func (p @Parser) IsAtImport() bool {
	return p.tok.Typ == token.IMPORT
}

// ParseImportDecl parses a single or grouped import declaration
// from the prompt: `import "pkg/foo"` or `import ( "pkg/foo";
// "pkg/bar" )`.  Returns the parsed specs; caller (REPL driver)
// loads each via the Loader and registers it in the session
// scope.
func (p @Parser) ParseImportDecl() @[]@ast.ImportSpec {
	return parseImportDecl(p)
}

// ParseStmtList parses statements until EOF.  Mirrors the inner loop
// of parseBlock but without the surrounding braces.  Used by the REPL
// to evaluate a bare statement list in immediate mode (e.g. multiple
// statements separated by newlines/semicolons typed at the prompt).
func (p @Parser) ParseStmtList() @[]@ast.Stmt {
	var stmts @[]@ast.Stmt
	for p.tok.Typ != token.EOF {
		stmts = slices.Append[@ast.Stmt](stmts, parseStmt(p))
		if !p.got(token.SEMICOLON) {
			if p.tok.Typ != token.EOF {
				p.errMsg("expected ; or end of input")
				p.next()
			}
		}
	}
	return stmts
}

// EndReplEntry ends an entry ParseImportDecl or ParseTopLevelDecl parsed: it
// consumes the semicolons that separate the entry from the rest of the unit
// (written, or inserted at the end of a line; several in a row separate empty
// entries) and reports whether input follows them.  Anything else after the
// entry is a parse error, as between ParseStmtList's statements.
func (p @Parser) EndReplEntry() bool {
	if p.tok.Typ != token.SEMICOLON && p.tok.Typ != token.EOF {
		p.errMsg("expected ; or end of input")
		return false
	}
	for p.got(token.SEMICOLON) {}
	return p.tok.Typ != token.EOF
}
