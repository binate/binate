package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for the REPL entry points (parse_repl.bn).  mkParser / fail live in
// parser_test.bn.

// Two declarations on separate lines are two entries: EndReplEntry consumes the
// semicolon inserted at the first line's end and reports that input follows,
// then reports the end of the unit after the second.
func TestEndReplEntrySeparatesDecls() testing.TestResult {
	var p @Parser = mkParser("var a int\nvar b int\n")
	if p.ParseTopLevelDecl() == nil || !p.EndReplEntry() {
		return fail("TestEndReplEntrySeparatesDecls", "input should follow the first declaration")
	}
	if !p.IsAtTopLevelDecl() || p.ParseTopLevelDecl() == nil || p.EndReplEntry() {
		return fail("TestEndReplEntrySeparatesDecls", "the second declaration should end the unit")
	}
	if len(p.Errors()) != 0 { return fail("TestEndReplEntrySeparatesDecls", p.Errors()[0].Msg) }
	return ""
}

// An entry at the end of the unit with no line end ends it (the lexer inserts a
// semicolon at the end of the input after the `}`).
func TestEndReplEntryAtEnd() testing.TestResult {
	var p @Parser = mkParser("func f() {}")
	if p.ParseTopLevelDecl() == nil || p.EndReplEntry() {
		return fail("TestEndReplEntryAtEnd", "a declaration at the end should end the unit")
	}
	if len(p.Errors()) != 0 { return fail("TestEndReplEntryAtEnd", p.Errors()[0].Msg) }
	return ""
}

// Anything but a semicolon or the end after an entry is a parse error.
func TestEndReplEntryRejectsTrailingInput() testing.TestResult {
	var p @Parser = mkParser("func f() {} g()\n")
	p.ParseTopLevelDecl()
	if p.EndReplEntry() || len(p.Errors()) != 1 {
		return fail("TestEndReplEntryRejectsTrailingInput", "trailing input should be one parse error")
	}
	return ""
}

// An import followed by statements on the same line: the import is one entry,
// and the statements after the written semicolon are the next.
func TestEndReplEntryImportThenStmts() testing.TestResult {
	var p @Parser = mkParser("import \"pkg/a\"; x := 1; y := x\n")
	if !p.IsAtImport() || len(p.ParseImportDecl()) != 1 || !p.EndReplEntry() {
		return fail("TestEndReplEntryImportThenStmts", "input should follow the import")
	}
	if p.IsAtImport() || p.IsAtTopLevelDecl() {
		return fail("TestEndReplEntryImportThenStmts", "the rest should be a statement run")
	}
	var ss @[]@ast.Stmt = p.ParseStmtList()
	if len(ss) != 2 || len(p.Errors()) != 0 {
		return fail("TestEndReplEntryImportThenStmts", "the statement run should hold two statements")
	}
	return ""
}

// Several semicolons in a row are empty entries: the next entry is the
// declaration after them, and a semicolon at the end of the unit leaves no input
// to follow.
func TestEndReplEntrySkipsEmptyEntries() testing.TestResult {
	var p @Parser = mkParser("var a int;;\nvar b int;\n")
	if p.ParseTopLevelDecl() == nil || !p.EndReplEntry() || !p.IsAtTopLevelDecl() {
		return fail("TestEndReplEntrySkipsEmptyEntries",
				"the second declaration should be the next entry")
	}
	if p.ParseTopLevelDecl() == nil || p.EndReplEntry() {
		return fail("TestEndReplEntrySkipsEmptyEntries", "trailing semicolons should end the unit")
	}
	if len(p.Errors()) != 0 { return fail("TestEndReplEntrySkipsEmptyEntries", p.Errors()[0].Msg) }
	return ""
}
