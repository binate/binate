package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/lexer"
import "pkg/binate/token"

// parseState is everything parsing advances or records — the lexer position, the
// current, previous and lookahead tokens, the error list, the builtin-call,
// signature and header records and the composite-literal mode — so a parse that
// turns out to be the wrong reading can be undone (saveParseState /
// restoreParseState) and the same tokens read another way.  A restore keeps the
// first nOpeners builtin-call records, the first nSigs signature records and the
// first nHeads header records, the last of which are lastOpener, lastSig and
// lastHead (nil when there are none), and adds openers, sigs and heads after them:
// the records a snapshot carries when a restore may go forward to it
// (saveParseStateSince).
type parseState struct {
	lex            lexer.Lexer
	tok            token.Token
	prev           token.Token
	peek           token.Token
	hasPeek        bool
	peek2          token.Token
	hasPeek2       bool
	errs           @[]ParseError
	nOpeners       int
	nSigs          int
	nHeads         int
	lastOpener     @ast.BuiltinOpener
	lastSig        @ast.Signature
	lastHead       @ast.Header
	openers        @[]@ast.BuiltinOpener
	sigs           @[]@ast.Signature
	heads          @[]@ast.Header
	noCompositeLit bool
}

// saveParseState snapshots p for a later restoreParseState.
func saveParseState(p @Parser) parseState {
	var s parseState
	s.lex = p.lex.Save()
	s.tok = p.tok
	s.prev = p.prev
	s.peek = p.peek
	s.hasPeek = p.hasPeek
	s.peek2 = p.peek2
	s.hasPeek2 = p.hasPeek2
	s.errs = p.errs
	if p.openers != nil {
		s.nOpeners = p.openers.Len()
		if s.nOpeners > 0 { s.lastOpener = p.openers.Get(s.nOpeners - 1) }
	}
	if p.sigs != nil {
		s.nSigs = p.sigs.Len()
		if s.nSigs > 0 { s.lastSig = p.sigs.Get(s.nSigs - 1) }
	}
	if p.heads != nil {
		s.nHeads = p.heads.Len()
		if s.nHeads > 0 { s.lastHead = p.heads.Get(s.nHeads - 1) }
	}
	s.noCompositeLit = p.noCompositeLit
	return s
}

// saveParseStateSince snapshots p as saveParseState does, for a restore that may
// come to it after a restore to base, an earlier snapshot of p: it keeps the
// records base keeps and carries the ones made since, so that restoring it drops
// whatever was recorded after base's records and puts the carried ones back.  It
// panics if p no longer has the records base keeps.
func saveParseStateSince(p @Parser, base parseState) parseState {
	var s parseState = saveParseState(p)
	if p.openers != nil {
		if !keepsOpeners(p, base) {
			panic("parser: a snapshot since a state whose builtin-call records are gone")
		}
		s.nOpeners = base.nOpeners
		s.lastOpener = base.lastOpener
		s.openers = make_slice(@ast.BuiltinOpener, p.openers.Len() - s.nOpeners)
		for i := 0; i < len(s.openers); i++ {
			s.openers[i] = p.openers.Get(s.nOpeners + i)
		}
	}
	if p.sigs != nil {
		if !keepsSigs(p, base) {
			panic("parser: a snapshot since a state whose signature records are gone")
		}
		s.nSigs = base.nSigs
		s.lastSig = base.lastSig
		s.sigs = make_slice(@ast.Signature, p.sigs.Len() - s.nSigs)
		for i := 0; i < len(s.sigs); i++ {
			s.sigs[i] = p.sigs.Get(s.nSigs + i)
		}
	}
	if p.heads != nil {
		if !keepsHeads(p, base) {
			panic("parser: a snapshot since a state whose header records are gone")
		}
		s.nHeads = base.nHeads
		s.lastHead = base.lastHead
		s.heads = make_slice(@ast.Header, p.heads.Len() - s.nHeads)
		for i := 0; i < len(s.heads); i++ {
			s.heads[i] = p.heads.Get(s.nHeads + i)
		}
	}
	return s
}

// restoreParseState returns p to the state a snapshot from saveParseState or
// saveParseStateSince recorded: its lexer position, tokens, errors and mode, and
// the records the snapshot keeps followed by those it carries, every other record
// dropped.  It panics if p no longer has the records the snapshot keeps -- a
// restore to an earlier state dropped them, or put others in their place -- as the
// records it left would then be wrong.
func restoreParseState(p @Parser, s parseState) {
	p.lex.Restore(s.lex)
	p.tok = s.tok
	p.prev = s.prev
	p.peek = s.peek
	p.hasPeek = s.hasPeek
	p.peek2 = s.peek2
	p.hasPeek2 = s.hasPeek2
	p.errs = s.errs
	if p.openers != nil {
		if !keepsOpeners(p, s) {
			panic("parser: a restore to a snapshot whose builtin-call records are gone")
		}
		for p.openers.Len() > s.nOpeners {
			_, _ = p.openers.Pop()
		}
		for i := 0; i < len(s.openers); i++ {
			p.openers.Push(s.openers[i])
		}
	}
	if p.sigs != nil {
		if !keepsSigs(p, s) {
			panic("parser: a restore to a snapshot whose signature records are gone")
		}
		for p.sigs.Len() > s.nSigs {
			_, _ = p.sigs.Pop()
		}
		for i := 0; i < len(s.sigs); i++ {
			p.sigs.Push(s.sigs[i])
		}
	}
	if p.heads != nil {
		if !keepsHeads(p, s) {
			panic("parser: a restore to a snapshot whose header records are gone")
		}
		for p.heads.Len() > s.nHeads {
			_, _ = p.heads.Pop()
		}
		for i := 0; i < len(s.heads); i++ {
			p.heads.Push(s.heads[i])
		}
	}
	p.noCompositeLit = s.noCompositeLit
}

// keepsOpeners reports whether p still has the builtin-call records s keeps: as
// many, the last of them the one s saw there.
func keepsOpeners(p @Parser, s parseState) bool {
	var n int = s.nOpeners
	return p.openers.Len() >= n && (n == 0 || same(p.openers.Get(n - 1), s.lastOpener))
}

// keepsSigs reports whether p still has the signature records s keeps: as many,
// the last of them the one s saw there.
func keepsSigs(p @Parser, s parseState) bool {
	var n int = s.nSigs
	return p.sigs.Len() >= n && (n == 0 || same(p.sigs.Get(n - 1), s.lastSig))
}

// keepsHeads reports whether p still has the header records s keeps: as many, the
// last of them the one s saw there.
func keepsHeads(p @Parser, s parseState) bool {
	var n int = s.nHeads
	return p.heads.Len() >= n && (n == 0 || same(p.heads.Get(n - 1), s.lastHead))
}
