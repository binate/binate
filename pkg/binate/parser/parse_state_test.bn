package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/builtins/testing"

// Tests for the parse-state snapshots (parse_state.bn).

// A restore to a snapshot drops the records made since it; one saveParseStateSince
// took, restored after a restore to its base and more records, drops those and puts
// back its own, after the base's.
func TestRestoreParseStateRecords() testing.TestResult {
	var p @Parser = mkCollectingParser("package \"t\"\n")
	var first @ast.BuiltinOpener = make(ast.BuiltinOpener)
	p.openers.Push(first)
	var start parseState = saveParseState(p)
	var op @ast.BuiltinOpener = make(ast.BuiltinOpener)
	var sig @ast.Signature = make(ast.Signature)
	p.openers.Push(op)
	p.sigs.Push(sig)
	var after parseState = saveParseStateSince(p, start)
	restoreParseState(p, start)
	if p.openers.Len() != 1 || p.sigs.Len() != 0 {
		return fail("TestRestoreParseStateRecords", "a restore to start keeps only its records")
	}
	p.openers.Push(make(ast.BuiltinOpener))
	p.sigs.Push(make(ast.Signature))
	p.sigs.Push(make(ast.Signature))
	restoreParseState(p, after)
	if p.openers.Len() != 2 || !same(p.openers.Get(0), first) || !same(p.openers.Get(1), op) {
		return fail("TestRestoreParseStateRecords", "a restore to after puts its call record back")
	}
	if p.sigs.Len() != 1 || !same(p.sigs.Get(0), sig) {
		return fail("TestRestoreParseStateRecords", "a restore to after puts its signature back")
	}
	restoreParseState(p, start)
	if p.openers.Len() != 1 || !same(p.openers.Get(0), first) || p.sigs.Len() != 0 {
		return fail("TestRestoreParseStateRecords", "a second restore to start drops them again")
	}
	return ""
}

// A restore puts back the errors a snapshot holds, unchanged by errors added since:
// one saveParseStateSince took, restored after a restore to its base and more errors,
// has its own errors again, and a restore to the base after that has the base's.
func TestRestoreParseStateErrors() testing.TestResult {
	var p @Parser = mkParser("package \"t\"\n")
	var pos token.Pos
	p.addError(pos, buf.CopyStr("a"))
	var start parseState = saveParseState(p)
	p.addError(pos, buf.CopyStr("b"))
	var after parseState = saveParseStateSince(p, start)
	restoreParseState(p, start)
	p.addError(pos, buf.CopyStr("c"))
	p.addError(pos, buf.CopyStr("d"))
	var errs @[]ParseError = p.Errors()
	if len(errs) != 3 || !charEq(errs[1].Msg, "c") || !charEq(errs[2].Msg, "d") {
		return fail("TestRestoreParseStateErrors", "a, c, d after a restore to start")
	}
	restoreParseState(p, after)
	errs = p.Errors()
	if len(errs) != 2 || !charEq(errs[0].Msg, "a") || !charEq(errs[1].Msg, "b") {
		return fail("TestRestoreParseStateErrors", "a, b after a restore to after")
	}
	p.addError(pos, buf.CopyStr("e"))
	restoreParseState(p, start)
	errs = p.Errors()
	if len(errs) != 1 || !charEq(errs[0].Msg, "a") {
		return fail("TestRestoreParseStateErrors", "a alone after a restore to start")
	}
	return ""
}

// A list Errors returned stays as it was when more errors are added after it.
func TestErrorsKeepsEarlierLists() testing.TestResult {
	var p @Parser = mkParser("package \"t\"\n")
	var pos token.Pos
	if len(p.Errors()) != 0 { return fail("TestErrorsKeepsEarlierLists", "no errors at first") }
	p.addError(pos, buf.CopyStr("a"))
	var first @[]ParseError = p.Errors()
	p.addError(pos, buf.CopyStr("b"))
	var both @[]ParseError = p.Errors()
	if len(first) != 1 || !charEq(first[0].Msg, "a") || len(both) != 2 || !charEq(both[1].Msg, "b") {
		return fail("TestErrorsKeepsEarlierLists", "a, then a, b")
	}
	return ""
}
