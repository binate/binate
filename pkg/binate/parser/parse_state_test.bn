package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for the parse-state snapshots (parse_state.bn).

// A restore to a snapshot drops the records made since it; one saveParseStateSince
// took, restored after a restore to its base and more records, drops those and puts
// back its own, after the base's.
func TestRestoreParseStateRecords() testing.TestResult {
	var p @Parser = mkCollectingParser("package \"t\"\n")
	var first @ast.BuiltinOpener = make(ast.BuiltinOpener)
	p.openers.Push(first)
	var start parseState = saveParseState(p)
	var op @ast.BuiltinOpener = make(ast.BuiltinOpener)
	var sig @ast.Signature = make(ast.Signature)
	p.openers.Push(op)
	p.sigs.Push(sig)
	var after parseState = saveParseStateSince(p, start)
	restoreParseState(p, start)
	if p.openers.Len() != 1 || p.sigs.Len() != 0 {
		return fail("TestRestoreParseStateRecords", "a restore to start keeps only its records")
	}
	p.openers.Push(make(ast.BuiltinOpener))
	p.sigs.Push(make(ast.Signature))
	p.sigs.Push(make(ast.Signature))
	restoreParseState(p, after)
	if p.openers.Len() != 2 || !same(p.openers.Get(0), first) || !same(p.openers.Get(1), op) {
		return fail("TestRestoreParseStateRecords", "a restore to after puts its call record back")
	}
	if p.sigs.Len() != 1 || !same(p.sigs.Get(0), sig) {
		return fail("TestRestoreParseStateRecords", "a restore to after puts its signature back")
	}
	restoreParseState(p, start)
	if p.openers.Len() != 1 || !same(p.openers.Get(0), first) || p.sigs.Len() != 0 {
		return fail("TestRestoreParseStateRecords", "a second restore to start drops them again")
	}
	return ""
}
