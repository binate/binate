package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// ============================================================
// Statement Parsing
// ============================================================

// parseStmt parses a statement and stamps its End (the position past the last
// token it consumed) so a statement knows its source span.  endFrom keeps the
// span non-backwards for statements that consume no token (the empty statement,
// error recovery), which would otherwise inherit an earlier token's End.
func parseStmt(p @Parser) @ast.Stmt {
	var s @ast.Stmt = parseStmtInner(p)
	if s != nil {
		s.End = endFrom(s.Pos, p.prev.End)
	}
	return s
}

// parseStmtInner dispatches to the specific statement parser (block, if, for,
// switch, return, break, continue, decl, or simple).
func parseStmtInner(p @Parser) @ast.Stmt {
	if p.tok.Typ == token.LBRACE {
		return parseBlock(p)
	}
	if p.tok.Typ == token.IF {
		return parseIfStmt(p)
	}
	if p.tok.Typ == token.FOR {
		return parseForStmt(p)
	}
	if p.tok.Typ == token.SWITCH {
		return parseSwitchStmt(p)
	}
	if p.tok.Typ == token.RETURN {
		return parseReturnStmt(p)
	}
	if p.tok.Typ == token.BREAK {
		var pos token.Pos = p.tok.Pos
		p.next()
		var s @ast.Stmt = make(ast.Stmt)
		s.Kind = ast.STMT_BREAK
		s.Pos = pos
		return s
	}
	if p.tok.Typ == token.CONTINUE {
		var pos token.Pos = p.tok.Pos
		p.next()
		var s @ast.Stmt = make(ast.Stmt)
		s.Kind = ast.STMT_CONTINUE
		s.Pos = pos
		return s
	}
	if p.tok.Typ == token.TYPE {
		// Function-local `type` declarations are rejected — `type`
		// is a top-level-only declaration.
		var tpos token.Pos = p.tok.Pos
		p.errMsg("type declarations must be at package level, "
				"not inside a function body")
		// Recover by parsing it anyway and dropping the result, so
		// downstream parsing isn't derailed by leftover tokens.
		parseTypeDecl(p)
		var s @ast.Stmt = make(ast.Stmt)
		s.Kind = ast.STMT_DECL
		// Pos is the `type` keyword (captured before the recovery parse) so
		// the wrapper's End (the decl's last token) does not precede Pos.
		s.Pos = tpos
		return s
	}
	if p.tok.Typ == token.VAR || p.tok.Typ == token.CONST {
		var d @ast.Decl
		if p.tok.Typ == token.VAR {
			d = parseVarDecl(p)
		} else {
			d = parseConstDecl(p)
		}
		// parseVarSpec/parseConstSpec stamp a single spec's End, but a
		// grouped local decl returns a DECL_GROUP that only parseTopLevelDecl
		// would otherwise stamp; do it here so the local DeclRef has a span.
		d.End = endFrom(d.Pos, p.prev.End)
		var s @ast.Stmt = make(ast.Stmt)
		s.Kind = ast.STMT_DECL
		s.Pos = d.Pos
		s.DeclRef = d
		return s
	}
	return parseSimpleStmt(p)
}

// parseBlock parses a brace-delimited block of statements.
func parseBlock(p @Parser) @ast.Stmt {
	var pos token.Pos = p.tok.Pos
	p.expect(token.LBRACE)
	var stmts @[]@ast.Stmt
	for p.tok.Typ != token.RBRACE && p.tok.Typ != token.EOF {
		stmts = slices.Append[@ast.Stmt](stmts, parseStmt(p))
		if !p.got(token.SEMICOLON) {
			if p.tok.Typ != token.RBRACE && p.tok.Typ != token.EOF {
				p.errMsg("expected ; or }")
				p.next()
			}
		}
	}
	p.expect(token.RBRACE)
	var s @ast.Stmt = make(ast.Stmt)
	s.Kind = ast.STMT_BLOCK
	s.Pos = pos
	// End is the `}` (p.prev after the expect above) -- the closing-brace
	// line the AST otherwise loses, needed to place dangling comments.
	s.End = endFrom(pos, p.prev.End)
	s.Stmts = stmts
	return s
}

// parseSimpleStmt handles: expression, assignment, short var decl, inc/dec.
func parseSimpleStmt(p @Parser) @ast.Stmt {
	if p.tok.Typ == token.SEMICOLON || p.tok.Typ == token.RBRACE {
		var s @ast.Stmt = make(ast.Stmt)
		s.Kind = ast.STMT_EMPTY
		s.Pos = p.tok.Pos
		s.End = p.tok.Pos
		return s
	}

	var exprs @[]@ast.Expr = parseExprList(p)
	return finishSimpleStmt(p, exprs)
}

// finishSimpleStmt completes a simple statement and stamps its End.  Callers
// include the for-clause parser, which builds init/post statements off the
// parseStmt dispatcher, so End is stamped here rather than only in the parseStmt
// wrapper.
func finishSimpleStmt(p @Parser, exprs @[]@ast.Expr) @ast.Stmt {
	var s @ast.Stmt = finishSimpleStmtInner(p, exprs)
	s.End = endFrom(s.Pos, p.prev.End)
	return s
}

// finishSimpleStmtInner builds a simple statement (assignment, short var decl,
// compound assign, inc/dec, or expression statement) from parsed LHS
// expressions.
func finishSimpleStmtInner(p @Parser, exprs @[]@ast.Expr) @ast.Stmt {
	if p.tok.Typ == token.DEFINE {
		// Short var decl: x, y := expr, expr
		var pos token.Pos = p.tok.Pos
		p.next()
		var rhs @[]@ast.Expr = parseExprList(p)
		var s @ast.Stmt = make(ast.Stmt)
		s.Kind = ast.STMT_SHORT_VAR
		s.Pos = pos
		s.Exprs = exprs // names (as ident exprs)
		s.Exprs2 = rhs
		return s
	}

	if p.tok.Typ == token.ASSIGN {
		var pos token.Pos = p.tok.Pos
		p.next()
		var rhs @[]@ast.Expr = parseExprList(p)
		var s @ast.Stmt = make(ast.Stmt)
		s.Kind = ast.STMT_ASSIGN
		s.Pos = pos
		s.Exprs = exprs
		s.Op = cast(int, token.ASSIGN)
		s.Exprs2 = rhs
		return s
	}

	var isCompound bool = p.tok.Typ == token.ADD_ASSIGN || p.tok.Typ == token.SUB_ASSIGN ||
			p.tok.Typ == token.MUL_ASSIGN || p.tok.Typ == token.QUO_ASSIGN ||
			p.tok.Typ == token.REM_ASSIGN || p.tok.Typ == token.AND_ASSIGN || p.tok.Typ == token.OR_ASSIGN ||
			p.tok.Typ == token.XOR_ASSIGN || p.tok.Typ == token.SHL_ASSIGN || p.tok.Typ == token.SHR_ASSIGN
	if isCompound {
		var op int = cast(int, p.tok.Typ)
		var pos token.Pos = p.tok.Pos
		p.next()
		var rhs @ast.Expr = parseExpr(p)
		var rhsList @[]@ast.Expr
		rhsList = slices.Append[@ast.Expr](rhsList, rhs)
		var s @ast.Stmt = make(ast.Stmt)
		s.Kind = ast.STMT_ASSIGN
		s.Pos = pos
		s.Exprs = exprs
		s.Op = op
		s.Exprs2 = rhsList
		return s
	}

	if p.tok.Typ == token.INC {
		var pos token.Pos = p.tok.Pos
		p.next()
		var s @ast.Stmt = make(ast.Stmt)
		s.Kind = ast.STMT_INC_DEC
		s.Pos = pos
		s.X = exprs[0]
		s.Op = cast(int, token.INC)
		return s
	}

	if p.tok.Typ == token.DEC {
		var pos token.Pos = p.tok.Pos
		p.next()
		var s @ast.Stmt = make(ast.Stmt)
		s.Kind = ast.STMT_INC_DEC
		s.Pos = pos
		s.X = exprs[0]
		s.Op = cast(int, token.DEC)
		return s
	}

	// Expression statement
	if len(exprs) == 1 {
		var s @ast.Stmt = make(ast.Stmt)
		s.Kind = ast.STMT_EXPR
		s.Pos = exprs[0].Pos
		s.X = exprs[0]
		return s
	}
	p.errMsg("expected assignment or declaration")
	var s @ast.Stmt = make(ast.Stmt)
	s.Kind = ast.STMT_EXPR
	s.Pos = exprs[0].Pos
	s.X = exprs[0]
	return s
}

// parseReturnStmt parses a return statement with optional result expressions.
func parseReturnStmt(p @Parser) @ast.Stmt {
	var pos token.Pos = p.tok.Pos
	p.next() // consume return

	var results @[]@ast.Expr
	if p.tok.Typ != token.SEMICOLON && p.tok.Typ != token.RBRACE && p.tok.Typ != token.EOF {
		results = parseExprList(p)
	}
	var s @ast.Stmt = make(ast.Stmt)
	s.Kind = ast.STMT_RETURN
	s.Pos = pos
	s.Exprs = results
	return s
}

// parseIfStmt parses an if statement with optional else/else-if clause.
func parseIfStmt(p @Parser) @ast.Stmt {
	var pos token.Pos = p.tok.Pos
	p.expect(token.IF)
	var cond @ast.Expr = parseExprNoCompositeLit(p)
	var body @ast.Stmt = parseBlock(p)

	var elseStmt @ast.Stmt = nil
	if p.got(token.ELSE) {
		if p.tok.Typ == token.IF {
			elseStmt = parseIfStmt(p)
		} else {
			elseStmt = parseBlock(p)
		}
	}

	var s @ast.Stmt = make(ast.Stmt)
	s.Kind = ast.STMT_IF
	s.Pos = pos
	// Stamp End here (not only via the parseStmt wrapper): an `else if` recurses
	// into parseIfStmt directly, off the dispatcher.
	s.End = endFrom(pos, p.prev.End)
	s.X = cond
	s.Body = body
	s.Else = elseStmt
	return s
}

// parseSwitchStmt parses a switch statement with optional tag expression and case clauses.
func parseSwitchStmt(p @Parser) @ast.Stmt {
	var pos token.Pos = p.tok.Pos
	p.expect(token.SWITCH)

	// `switch ident := scrutinee.(type) { ... }` — the binder form of a type
	// switch is committed up front by the `ident :=` head (D13); the `.(type)`
	// tail is then mandatory.
	if p.tok.Typ == token.IDENT && p.peekTok().Typ == token.DEFINE {
		var binder @[]char = p.tok.Lit
		p.next() // ident
		p.next() // :=
		var scrut @ast.Expr = parseExprNoCompositeLit(p)
		return parseTypeSwitchTail(p, pos, binder, scrut)
	}

	var tag @ast.Expr = nil
	if p.tok.Typ != token.LBRACE {
		tag = parseExprNoCompositeLit(p)
	}

	// A binderless type switch is marked by a trailing `.(type)` on the tag,
	// which continuePostfix left unconsumed precisely so it could be seen here
	// (D13).  An empty binder (len 0) marks "no bound variable".
	if tag != nil && p.tok.Typ == token.DOT && p.peekTok().Typ == token.LPAREN &&
			p.peekTok2().Typ == token.TYPE {
		var noBinder @[]char
		return parseTypeSwitchTail(p, pos, noBinder, tag)
	}

	p.expect(token.LBRACE)
	var cases @[]@ast.CaseClause
	for p.tok.Typ != token.RBRACE && p.tok.Typ != token.EOF {
		cases = slices.Append[@ast.CaseClause](cases, parseCaseClause(p))
	}
	p.expect(token.RBRACE)

	var s @ast.Stmt = make(ast.Stmt)
	s.Kind = ast.STMT_SWITCH
	s.Pos = pos
	s.X = tag
	s.Cases = cases
	return s
}

// parseCaseClause parses a single case or default clause within an expression
// switch (targets are expressions, stored in CaseClause.Exprs).
func parseCaseClause(p @Parser) @ast.CaseClause {
	var cc @ast.CaseClause = make(ast.CaseClause)
	cc.Pos = p.tok.Pos
	if p.tok.Typ == token.CASE {
		p.next()
		cc.Exprs = parseExprList(p)
	} else {
		p.expect(token.DEFAULT)
	}
	parseCaseBody(p, cc)
	return cc
}

// parseCaseBody consumes the `:` and the statement list of a switch clause —
// shared by expression-switch and type-switch clauses — appending each parsed
// statement to cc.Body until the next clause, the closing brace, or EOF.
func parseCaseBody(p @Parser, cc @ast.CaseClause) {
	p.expect(token.COLON)
	for p.tok.Typ != token.CASE && p.tok.Typ != token.DEFAULT && p.tok.Typ != token.RBRACE &&
			p.tok.Typ != token.EOF {
		cc.Body = slices.Append[@ast.Stmt](cc.Body, parseStmt(p))
		if !p.got(token.SEMICOLON) {
			break
		}
	}
}

// ============================================================
// Helpers
// ============================================================

// parseExprList parses a comma-separated list of expressions.
func parseExprList(p @Parser) @[]@ast.Expr {
	var list @[]@ast.Expr
	list = slices.Append[@ast.Expr](list, parseExpr(p))
	for p.got(token.COMMA) {
		if p.tok.Typ == token.RPAREN {
			break // trailing comma
		}
		list = slices.Append[@ast.Expr](list, parseExpr(p))
	}
	return list
}
