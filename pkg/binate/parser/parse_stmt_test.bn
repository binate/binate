package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/builtins/testing"

// ============================================================
// Statement Tests
// ============================================================
func TestParseReturnStmt() testing.TestResult {
	var p @Parser = mkParser("return 42")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_RETURN {
		return fail("TestParseReturnStmt", "expected STMT_RETURN")
	}
	if len(s.Exprs) != 1 {
		return fail("TestParseReturnStmt", "expected 1 result")
	}
	return ""
}

func TestParseBreakStmt() testing.TestResult {
	var p @Parser = mkParser("break")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_BREAK {
		return fail("TestParseBreakStmt", "expected STMT_BREAK")
	}
	return ""
}

func TestParseContinueStmt() testing.TestResult {
	var p @Parser = mkParser("continue")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_CONTINUE {
		return fail("TestParseContinueStmt", "expected STMT_CONTINUE")
	}
	return ""
}

// `defer` followed by a block keeps the block in Body.
func TestParseDeferStmt() testing.TestResult {
	var p @Parser = mkParser("defer { g(); h() }")
	var s @ast.Stmt = parseStmt(p)
	if len(p.Errors()) != 0 {
		return fail("TestParseDeferStmt", p.Errors()[0].Msg)
	}
	if s.Kind != ast.STMT_DEFER || s.Body == nil || s.X != nil {
		return fail("TestParseDeferStmt", "expected a STMT_DEFER with a Body")
	}
	if s.Body.Kind != ast.STMT_BLOCK || len(s.Body.Stmts) != 2 {
		return fail("TestParseDeferStmt", "expected a two-statement deferred block")
	}
	return ""
}

// A statement's End is one past its last token.  "return 42": End at 1:10.
func TestReturnStmtEnd() testing.TestResult {
	var p @Parser = mkParser("return 42")
	var s @ast.Stmt = parseStmt(p)
	if s.End.Line != 1 || s.End.Col != 10 {
		return fail("TestReturnStmtEnd", "expected End 1:10")
	}
	return ""
}

// A block's End is its closing brace -- the line the AST otherwise loses.
// "{\n\tx()\n}": the } is on line 3 col 1, so End (one past) is 3:2.
func TestBlockEnd() testing.TestResult {
	var p @Parser = mkParser("{\n\tx()\n}")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_BLOCK {
		return fail("TestBlockEnd", "expected STMT_BLOCK")
	}
	if s.End.Line != 3 || s.End.Col != 2 {
		return fail("TestBlockEnd", "expected End 3:2 (past the })")
	}
	return ""
}

func TestParseIfStmt() testing.TestResult {
	var p @Parser = mkParser("if x > 0 { return 1 }")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_IF {
		return fail("TestParseIfStmt", "expected STMT_IF")
	}
	if s.X == nil {
		return fail("TestParseIfStmt", "expected condition")
	}
	if s.Body == nil {
		return fail("TestParseIfStmt", "expected body")
	}
	return ""
}

func TestParseIfElseStmt() testing.TestResult {
	var p @Parser = mkParser("if x { y() } else { z() }")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_IF {
		return fail("TestParseIfElseStmt", "expected STMT_IF")
	}
	if s.Else == nil {
		return fail("TestParseIfElseStmt", "expected else branch")
	}
	return ""
}

func TestParseSwitchStmt() testing.TestResult {
	var p @Parser = mkParser("switch x { case 1: y() case 2, 3: z() default: w() }")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_SWITCH {
		return fail("TestParseSwitchStmt", "expected STMT_SWITCH")
	}
	if len(s.Cases) != 3 {
		return fail("TestParseSwitchStmt", "expected 3 cases")
	}
	// Check multi-value case
	if len(s.Cases[1].Exprs) != 2 {
		return fail("TestParseSwitchStmt", "expected 2 exprs in case 2")
	}
	return ""
}

// A switch clause records its label's `:` -- on the label's last line when the label spans
// lines -- in an expression switch, a type switch and a `default` clause.
func TestParseCaseClauseColon() testing.TestResult {
	var p @Parser = mkParser("switch x {\ncase 1,\n\t2: y()\ndefault: w()\n}")
	var s @ast.Stmt = parseStmt(p)
	if len(s.Cases) != 2 {
		return fail("TestParseCaseClauseColon", "expected 2 cases")
	}
	if s.Cases[0].Colon.Line != 3 || s.Cases[0].Colon.Col != 3 {
		return fail("TestParseCaseClauseColon", "case 0's colon is not at 3:3")
	}
	if s.Cases[1].Colon.Line != 4 || s.Cases[1].Colon.Col != 8 {
		return fail("TestParseCaseClauseColon", "the default clause's colon is not at 4:8")
	}
	var q @Parser = mkParser("switch x.(type) {\ncase *A,\n\t@B: y()\n}")
	var t @ast.Stmt = parseStmt(q)
	if len(t.Cases) != 1 || t.Cases[0].Colon.Line != 3 || t.Cases[0].Colon.Col != 4 {
		return fail("TestParseCaseClauseColon", "the type-switch clause's colon is not at 3:4")
	}
	return ""
}

func TestParseAssignStmt() testing.TestResult {
	var p @Parser = mkParser("x = 5")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_ASSIGN {
		return fail("TestParseAssignStmt", "expected STMT_ASSIGN")
	}
	if s.Op != cast(int, token.ASSIGN) {
		return fail("TestParseAssignStmt", "expected ASSIGN op")
	}
	return ""
}

func TestParseShortVarDecl() testing.TestResult {
	var p @Parser = mkParser("x := 5")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_SHORT_VAR {
		return fail("TestParseShortVarDecl", "expected STMT_SHORT_VAR")
	}
	return ""
}

func TestParseIncDec() testing.TestResult {
	var p @Parser = mkParser("i++")
	var s @ast.Stmt = parseStmt(p)
	if s.Kind != ast.STMT_INC_DEC {
		return fail("TestParseIncDec", "expected STMT_INC_DEC")
	}
	if s.Op != cast(int, token.INC) {
		return fail("TestParseIncDec", "expected INC")
	}
	return ""
}

// ============================================================
// Defer statement tests (§14.13)
// ============================================================

// A defer without a block — Go's `defer f()` — is one error, at the operand,
// whose hint names the block form; the statement keeps an empty block as its
// Body and nothing in X.
func TestParseDeferWithoutBlock() testing.TestResult {
	var p @Parser = mkParser("defer p.Close(a, b)")
	var s @ast.Stmt = parseStmt(p)
	if len(p.Errors()) != 1 {
		return fail("TestParseDeferWithoutBlock", "expected exactly one error")
	}
	var e ParseError = p.Errors()[0]
	if !charEq(e.Msg, "defer requires a block: `defer { f() }`") {
		return fail("TestParseDeferWithoutBlock", e.Msg)
	}
	if e.Pos.Line != 1 || e.Pos.Col != 7 {
		return fail("TestParseDeferWithoutBlock", "expected the error at the operand, 1:7")
	}
	if s.Kind != ast.STMT_DEFER || s.X != nil || s.Body == nil {
		return fail("TestParseDeferWithoutBlock", "expected a STMT_DEFER with a Body and no X")
	}
	if s.Body.Kind != ast.STMT_BLOCK || len(s.Body.Stmts) != 0 {
		return fail("TestParseDeferWithoutBlock", "expected an empty block as the Body")
	}
	return ""
}

// After a defer without a block, parsing resumes after its operand: the next
// statement parses, and no further error is reported.  A `defer` with nothing
// after it before `;` or `}` is the same one error.
func TestParseDeferWithoutBlockResumes() testing.TestResult {
	var srcs [3]*[]readonly char = [3]*[]readonly char{"{ defer f(x); g() }", "{ defer; g() }",
			"{ g(); defer }"}
	for i := 0; i < len(srcs); i++ {
		var p @Parser = mkParser(srcs[i])
		var s @ast.Stmt = parseStmt(p)
		if len(p.Errors()) != 1 {
			return fail("TestParseDeferWithoutBlockResumes", srcs[i])
		}
		if s.Kind != ast.STMT_BLOCK || len(s.Stmts) != 2 {
			return fail("TestParseDeferWithoutBlockResumes", srcs[i])
		}
		var d int = 0
		if i == 2 { d = 1 }
		if s.Stmts[d].Kind != ast.STMT_DEFER || s.Stmts[1 - d].Kind != ast.STMT_EXPR {
			return fail("TestParseDeferWithoutBlockResumes", srcs[i])
		}
	}
	return ""
}

// `defer` is not an ASI-trigger keyword: a newline right after `defer` continues
// the statement onto the next line.
func TestParseDeferNewlineContinues() testing.TestResult {
	var p @Parser = mkParser("defer\n{ g() }")
	var s @ast.Stmt = parseStmt(p)
	if len(p.Errors()) != 0 {
		return fail("TestParseDeferNewlineContinues", p.Errors()[0].Msg)
	}
	if s.Kind != ast.STMT_DEFER || s.Body == nil || len(s.Body.Stmts) != 1 {
		return fail("TestParseDeferNewlineContinues", "expected a STMT_DEFER with a one-statement Body")
	}
	return ""
}
