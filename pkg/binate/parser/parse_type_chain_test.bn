package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for parse_type_chain.bn (parseType's loop over a chain of type prefixes, and
// parseTypePrefix).  mkParser / fail / charEq live in parser_test.bn.

// chainDepth is how many prefixes TestParseTypeDeepPrefixChain chains: far past what a
// parser with a frame per prefix could hold on its stack.
const chainDepth int = 20000

// releaseTypeChain drops a chain of type expressions a link at a time, so its release
// does not nest one destruction per level.
func releaseTypeChain(te @ast.TypeExpr) {
	var cur @ast.TypeExpr = te
	for cur != nil {
		var next @ast.TypeExpr = cur.Base
		cur.Base = nil
		cur = next
	}
}

// `[1]` chainDepth times over int parses as chainDepth arrays over int, every one of
// them ending where int does.
func TestParseTypeDeepPrefixChain() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	for i := 0; i < chainDepth; i++ {
		b.Write("[1]")
	}
	b.Write("int")
	var p @Parser = mkParser(b.String())
	var te @ast.TypeExpr = parseType(p)
	if len(p.Errors()) != 0 {
		releaseTypeChain(te)
		return fail("TestParseTypeDeepPrefixChain", "unexpected parse error")
	}
	var endCol int = 3 * chainDepth + 4
	var cur @ast.TypeExpr = te
	var arrays int = 0
	var bad bool = false
	for cur != nil && cur.Kind == ast.TEXPR_ARRAY {
		if cur.Len == nil || cur.End.Line != 1 || cur.End.Col != endCol { bad = true }
		arrays = arrays + 1
		cur = cur.Base
	}
	var leafOK bool = cur != nil && cur.Kind == ast.TEXPR_NAMED && charEq(cur.Name, "int") &&
			cur.End.Col == endCol
	cur = nil
	releaseTypeChain(te)
	if arrays != chainDepth { return fail("TestParseTypeDeepPrefixChain", "wrong number of arrays") }
	if bad {
		return fail("TestParseTypeDeepPrefixChain", "an array without its length, or ending elsewhere")
	}
	if !leafOK { return fail("TestParseTypeDeepPrefixChain", "the chain does not end at int") }
	return ""
}

// expectPrefix checks that te has the given kind, starts at column col of line 1 and
// ends at column end, and returns what it prefixes.
func expectPrefix(te @ast.TypeExpr, kind int, col int, end int) (@ast.TypeExpr, bool) {
	if te == nil || te.Kind != kind || te.Pos.Line != 1 || te.Pos.Col != col || te.End.Col != end {
		var none @ast.TypeExpr
		return none, false
	}
	return te.Base, true
}

// Every kind of prefix in one chain keeps its own position and ends where the type it
// all prefixes does: "*@[][3]readonly Foo" is a pointer (column 1) to a managed slice
// (2, at its `@`) of arrays (5) of readonly (8) Foo (17), all ending at 1:20.
func TestParseTypePrefixChainEnds() testing.TestResult {
	var p @Parser = mkParser("*@[][3]readonly Foo")
	var te @ast.TypeExpr = parseType(p)
	if len(p.Errors()) != 0 { return fail("TestParseTypePrefixChainEnds", "unexpected parse error") }
	var kinds @[]int = @[]int{ast.TEXPR_POINTER, ast.TEXPR_MANAGED_SLICE, ast.TEXPR_ARRAY,
			ast.TEXPR_CONST}
	var cols @[]int = @[]int{1, 2, 5, 8}
	var cur @ast.TypeExpr = te
	for i := 0; i < 4; i++ {
		var ok bool
		cur, ok = expectPrefix(cur, kinds[i], cols[i], 20)
		if !ok {
			return fail("TestParseTypePrefixChainEnds", "a prefix has the wrong kind, position or end")
		}
	}
	if cur == nil || cur.Kind != ast.TEXPR_NAMED || !charEq(cur.Name, "Foo") || cur.Pos.Col != 17 ||
			cur.End.Col != 20 {
		return fail("TestParseTypePrefixChainEnds", "the chain does not end at Foo")
	}
	return ""
}

// A `*[N]` / `@[N]` prefix is an error recovered as a pointer to an array, `[]T` one
// recovered as a slice; `[...]T` is an array of inferred length.  Each is followed by
// the rest of the chain.
func TestParseTypePrefixRecovery() testing.TestResult {
	var srcs @[]@[]char = @[]@[]char{"*[2]*int", "@[2]*int", "[]*int", "[...]*int"}
	var firsts @[]int = @[]int{ast.TEXPR_POINTER, ast.TEXPR_MANAGED, ast.TEXPR_SLICE, ast.TEXPR_ARRAY}
	var errs @[]bool = @[]bool{true, true, true, false}
	for i := 0; i < len(srcs); i++ {
		var p @Parser = mkParser(srcs[i])
		var te @ast.TypeExpr = parseType(p)
		var wantErrs int = 0
		if errs[i] { wantErrs = 1 }
		if len(p.Errors()) != wantErrs {
			return fail("TestParseTypePrefixRecovery", srcs[i])
		}
		if te == nil || te.Kind != firsts[i] || te.Pos.Col != 1 || te.End.Col != len(srcs[i]) + 1 {
			return fail("TestParseTypePrefixRecovery", srcs[i])
		}
		var rest @ast.TypeExpr = te.Base
		if i < 2 {
			if rest == nil || rest.Kind != ast.TEXPR_ARRAY || rest.Len == nil || rest.Pos.Col != 2 ||
					rest.End.Col != len(srcs[i]) + 1 {
				return fail("TestParseTypePrefixRecovery", srcs[i])
			}
			rest = rest.Base
		}
		if i == 3 && !te.LenInferred { return fail("TestParseTypePrefixRecovery", srcs[i]) }
		if rest == nil || rest.Kind != ast.TEXPR_POINTER || rest.Base == nil ||
				rest.Base.Kind != ast.TEXPR_NAMED {
			return fail("TestParseTypePrefixRecovery", srcs[i])
		}
	}
	return ""
}

// `*func(...)` and `@func(...)` are whole types where a prefix may be: after `[2]`,
// and alone.
func TestParseTypePrefixFuncValue() testing.TestResult {
	var p @Parser = mkParser("[2]*func() int")
	var te @ast.TypeExpr = parseType(p)
	if len(p.Errors()) != 0 || te == nil || te.Kind != ast.TEXPR_ARRAY || te.Base == nil ||
			te.Base.Kind != ast.TEXPR_FUNC_VALUE || te.End.Col != 15 || te.Base.End.Col != 15 {
		return fail("TestParseTypePrefixFuncValue", "[2]*func() int")
	}
	var q @Parser = mkParser("@func()")
	var mf @ast.TypeExpr = parseType(q)
	if len(q.Errors()) != 0 || mf == nil || mf.Kind != ast.TEXPR_MANAGED_FUNC_VALUE ||
			mf.End.Col != 8 {
		return fail("TestParseTypePrefixFuncValue", "@func()")
	}
	return ""
}

// A type missing after a prefix is an error node at the token found instead, ending where
// it starts (it consumed nothing); the prefix ends after its own token.  "* )": the
// pointer at 1:1 ends at 1:2, the error at 1:3 ends at 1:3.
func TestParseTypeMissingAfterPrefix() testing.TestResult {
	var p @Parser = mkParser("* )")
	var te @ast.TypeExpr = parseType(p)
	if len(p.Errors()) != 1 || te == nil || te.Kind != ast.TEXPR_POINTER || te.End.Col != 2 {
		return fail("TestParseTypeMissingAfterPrefix", "the pointer")
	}
	var missing @ast.TypeExpr = te.Base
	if missing == nil || missing.Kind != ast.TEXPR_NAMED || missing.Pos.Col != 3 ||
			missing.End.Col != 3 {
		return fail("TestParseTypeMissingAfterPrefix", "the missing type")
	}
	return ""
}
