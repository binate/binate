package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/builtins/testing"

// Tests for parse_type.bn (parseType + parseFuncTypeBody +
// parseNamedType + parseStructType + parseStructField). The
// helpers mkParser / fail / charEq live in parser_test.bn (same
// package).

// ============================================================
// Type Tests
// ============================================================

func TestParseNamedType() testing.TestResult {
	var p @Parser = mkParser("int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_NAMED {
		return fail("TestParseNamedType", "expected TEXPR_NAMED")
	}
	if !charEq(te.Name, "int") {
		return fail("TestParseNamedType", "expected 'int'")
	}
	return ""
}

// A type expression's End is one past its last token; parseType is the
// recursive entry, so nested types are stamped too.  "@[]char": End at 1:8.
func TestTypeEnd() testing.TestResult {
	var p @Parser = mkParser("@[]char")
	var te @ast.TypeExpr = parseType(p)
	if te.End.Line != 1 || te.End.Col != 8 {
		return fail("TestTypeEnd", "expected End 1:8")
	}
	return ""
}

func TestParseQualifiedType() testing.TestResult {
	var p @Parser = mkParser("token.Type")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_NAMED {
		return fail("TestParseQualifiedType", "expected TEXPR_NAMED")
	}
	if !charEq(te.Pkg, "token") {
		return fail("TestParseQualifiedType", "expected pkg 'token'")
	}
	if !charEq(te.Name, "Type") {
		return fail("TestParseQualifiedType", "expected name 'Type'")
	}
	return ""
}

func TestParsePointerType() testing.TestResult {
	var p @Parser = mkParser("*int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_POINTER {
		return fail("TestParsePointerType", "expected TEXPR_POINTER")
	}
	if te.Base.Kind != ast.TEXPR_NAMED {
		return fail("TestParsePointerType", "expected NAMED base")
	}
	return ""
}

func TestParseSliceType() testing.TestResult {
	var p @Parser = mkParser("*[]int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_SLICE {
		return fail("TestParseSliceType", "expected TEXPR_SLICE")
	}
	return ""
}

func TestParseManagedPtrType() testing.TestResult {
	var p @Parser = mkParser("@Foo")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_MANAGED {
		return fail("TestParseManagedPtrType", "expected TEXPR_MANAGED")
	}
	return ""
}

func TestParseManagedSliceType() testing.TestResult {
	var p @Parser = mkParser("@[]int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_MANAGED_SLICE {
		return fail("TestParseManagedSliceType", "expected TEXPR_MANAGED_SLICE")
	}
	return ""
}

func TestParseFuncValueType() testing.TestResult {
	// *func(int, int) int — raw function value
	var p @Parser = mkParser("*func(int, int) int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_FUNC_VALUE {
		return fail("TestParseFuncValueType", "expected TEXPR_FUNC_VALUE")
	}
	if len(te.ParamTypes) != 2 {
		return fail("TestParseFuncValueType", "expected 2 params")
	}
	if len(te.ResultTypes) != 1 {
		return fail("TestParseFuncValueType", "expected 1 result")
	}
	return ""
}

func TestParseManagedFuncValueType() testing.TestResult {
	// @func() — managed function value with no args, void return
	var p @Parser = mkParser("@func()")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_MANAGED_FUNC_VALUE {
		return fail("TestParseManagedFuncValueType", "expected TEXPR_MANAGED_FUNC_VALUE")
	}
	if len(te.ParamTypes) != 0 {
		return fail("TestParseManagedFuncValueType", "expected 0 params")
	}
	if len(te.ResultTypes) != 0 {
		return fail("TestParseManagedFuncValueType", "expected 0 results (void)")
	}
	return ""
}

func TestParseFuncValueTypeMultiReturn() testing.TestResult {
	// @func(int) (int, *int) — managed func value with multi-return
	var p @Parser = mkParser("@func(int) (int, *int)")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_MANAGED_FUNC_VALUE {
		return fail("TestParseFuncValueTypeMultiReturn", "expected TEXPR_MANAGED_FUNC_VALUE")
	}
	if len(te.ResultTypes) != 2 {
		return fail("TestParseFuncValueTypeMultiReturn", "expected 2 results")
	}
	return ""
}

func TestParseFuncValueTypeParamShape() testing.TestResult {
	// Verify the actual ParamTypes / ResultTypes contents (kinds and
	// names), not just lengths.
	var p @Parser = mkParser("*func(int, *char) *int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_FUNC_VALUE {
		return fail("TestParseFuncValueTypeParamShape", "expected TEXPR_FUNC_VALUE")
	}
	if len(te.ParamTypes) != 2 {
		return fail("TestParseFuncValueTypeParamShape", "expected 2 params")
	}
	if te.ParamTypes[0].Kind != ast.TEXPR_NAMED ||
		!charEq(te.ParamTypes[0].Name, "int") {
		return fail("TestParseFuncValueTypeParamShape", "expected int param 0")
	}
	if te.ParamTypes[1].Kind != ast.TEXPR_POINTER {
		return fail("TestParseFuncValueTypeParamShape", "expected pointer param 1")
	}
	if len(te.ResultTypes) != 1 {
		return fail("TestParseFuncValueTypeParamShape", "expected 1 result")
	}
	if te.ResultTypes[0].Kind != ast.TEXPR_POINTER {
		return fail("TestParseFuncValueTypeParamShape", "expected pointer result")
	}
	return ""
}

// Bare `func(...)` is not a usable type — must be spelled `*func(...)`
// or `@func(...)`. The parser still recovers (parsing the body as if
// it were a raw function value) so a buggy source file produces one
// error per misuse rather than cascading downstream.
func TestParseBareFuncTypeRejected() testing.TestResult {
	var p @Parser = mkParser("func(int) int")
	var te @ast.TypeExpr = parseType(p)
	if te == nil {
		return fail("TestParseBareFuncTypeRejected", "parseType returned nil")
	}
	var errs @[]ParseError = p.Errors()
	if len(errs) == 0 {
		return fail("TestParseBareFuncTypeRejected", "expected parse error, got none")
	}
	return ""
}

// Function-value types nest naturally — *func(*func(int) int) int is
// a function taking a (raw) function pointer and returning int.
func TestParseFuncValueTypeNested() testing.TestResult {
	var p @Parser = mkParser("*func(*func(int) int) int")
	var te @ast.TypeExpr = parseType(p)
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParseFuncValueTypeNested", errs[0].Msg)
	}
	if te.Kind != ast.TEXPR_FUNC_VALUE {
		return fail("TestParseFuncValueTypeNested", "expected outer TEXPR_FUNC_VALUE")
	}
	if len(te.ParamTypes) != 1 {
		return fail("TestParseFuncValueTypeNested", "expected 1 param")
	}
	if te.ParamTypes[0].Kind != ast.TEXPR_FUNC_VALUE {
		return fail("TestParseFuncValueTypeNested", "expected nested TEXPR_FUNC_VALUE param")
	}
	return ""
}

func TestParseArrayType() testing.TestResult {
	var p @Parser = mkParser("[10]int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_ARRAY {
		return fail("TestParseArrayType", "expected TEXPR_ARRAY")
	}
	return ""
}

// `readonly *int` — readonly pointer to int. Outer is TEXPR_CONST;
// its Base is TEXPR_POINTER.  (The `readonly int` and `*readonly int`
// shapes are covered by TestParseReadonlyType / TestParsePointerToReadonly.)
func TestParseReadonlyPointer() testing.TestResult {
	var p @Parser = mkParser("readonly *int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_CONST {
		return fail("TestParseReadonlyPointer", "expected outer TEXPR_CONST")
	}
	if te.Base == nil || te.Base.Kind != ast.TEXPR_POINTER {
		return fail("TestParseReadonlyPointer", "expected POINTER under CONST")
	}
	return ""
}

// `const` is no longer a type-expression modifier — only `readonly`
// is accepted (plan-const-readonly step 5).  A `const` token in a
// type position is a parse error.
func TestParseConstModifierRejected() testing.TestResult {
	var p @Parser = mkParser("const int")
	var _ @ast.TypeExpr = parseType(p)
	if len(p.Errors()) == 0 {
		return fail("TestParseConstModifierRejected",
			"expected a parse error for const in a type position")
	}
	return ""
}

// `readonly int` — the readonly type modifier on a named type,
// parsed as a TEXPR_CONST node wrapping a NAMED int.
func TestParseReadonlyType() testing.TestResult {
	var p @Parser = mkParser("readonly int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_CONST {
		return fail("TestParseReadonlyType", "expected TEXPR_CONST")
	}
	if te.Base == nil || te.Base.Kind != ast.TEXPR_NAMED {
		return fail("TestParseReadonlyType", "expected NAMED base")
	}
	return ""
}

// `*readonly int` — pointer to readonly int. Outer is TEXPR_POINTER;
// its Base is the readonly modifier (TEXPR_CONST) wrapping NAMED int.
func TestParsePointerToReadonly() testing.TestResult {
	var p @Parser = mkParser("*readonly int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_POINTER {
		return fail("TestParsePointerToReadonly", "expected TEXPR_POINTER")
	}
	if te.Base == nil || te.Base.Kind != ast.TEXPR_CONST {
		return fail("TestParsePointerToReadonly", "expected CONST under POINTER")
	}
	return ""
}

// `readonly T` as a function-value return type (covers
// isFuncResultStart accepting READONLY, the same branch
// TestParseSelfAsFuncResult covers for SELF).
func TestParseReadonlyFuncResult() testing.TestResult {
	var p @Parser = mkParser("*func() readonly int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_FUNC_VALUE {
		return fail("TestParseReadonlyFuncResult", "expected TEXPR_FUNC_VALUE")
	}
	if len(te.ResultTypes) != 1 {
		return fail("TestParseReadonlyFuncResult", "expected one result type")
	}
	if te.ResultTypes[0].Kind != ast.TEXPR_CONST {
		return fail("TestParseReadonlyFuncResult", "expected CONST as result type")
	}
	return ""
}

// `*[]readonly int` — raw slice of readonly int.
func TestParseRawSliceOfReadonly() testing.TestResult {
	var p @Parser = mkParser("*[]readonly int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_SLICE {
		return fail("TestParseRawSliceOfReadonly", "expected TEXPR_SLICE")
	}
	if te.Base == nil || te.Base.Kind != ast.TEXPR_CONST {
		return fail("TestParseRawSliceOfReadonly", "expected CONST element")
	}
	return ""
}

// `@[]readonly char` — managed slice of readonly char (spec'd default
// for string literals).
func TestParseManagedSliceOfReadonly() testing.TestResult {
	var p @Parser = mkParser("@[]readonly char")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_MANAGED_SLICE {
		return fail("TestParseManagedSliceOfReadonly", "expected TEXPR_MANAGED_SLICE")
	}
	if te.Base == nil || te.Base.Kind != ast.TEXPR_CONST {
		return fail("TestParseManagedSliceOfReadonly", "expected CONST element")
	}
	return ""
}

// `readonly readonly int` — two readonly modifiers stack (the
// implementation is allowed to collapse, but AST-wise both appear).
func TestParseReadonlyReadonly() testing.TestResult {
	var p @Parser = mkParser("readonly readonly int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_CONST {
		return fail("TestParseReadonlyReadonly", "expected outer CONST")
	}
	if te.Base == nil || te.Base.Kind != ast.TEXPR_CONST {
		return fail("TestParseReadonlyReadonly", "expected inner CONST")
	}
	if te.Base.Base == nil || te.Base.Base.Kind != ast.TEXPR_NAMED {
		return fail("TestParseReadonlyReadonly", "expected NAMED at the bottom")
	}
	return ""
}

// *[]T raw-slice sugar (Stage 1 of plan-raw-slice-syntax.md).
// Same AST as *[]T (TEXPR_SLICE), just a second surface syntax.
func TestParseRawSliceStarSugar() testing.TestResult {
	var p @Parser = mkParser("*[]int")
	var te @ast.TypeExpr = parseType(p)
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParseRawSliceStarSugar", errs[0].Msg)
	}
	if te.Kind != ast.TEXPR_SLICE {
		return fail("TestParseRawSliceStarSugar", "expected TEXPR_SLICE")
	}
	if te.Base.Kind != ast.TEXPR_NAMED {
		return fail("TestParseRawSliceStarSugar", "expected NAMED elem")
	}
	if !charEq(te.Base.Name, "int") {
		return fail("TestParseRawSliceStarSugar", "expected int elem")
	}
	return ""
}

// *[]*[]char — nested raw-slice sugar.
func TestParseRawSliceStarSugarNested() testing.TestResult {
	var p @Parser = mkParser("*[]*[]char")
	var te @ast.TypeExpr = parseType(p)
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParseRawSliceStarSugarNested", errs[0].Msg)
	}
	if te.Kind != ast.TEXPR_SLICE {
		return fail("TestParseRawSliceStarSugarNested", "expected outer TEXPR_SLICE")
	}
	if te.Base.Kind != ast.TEXPR_SLICE {
		return fail("TestParseRawSliceStarSugarNested", "expected inner TEXPR_SLICE")
	}
	if !charEq(te.Base.Base.Name, "char") {
		return fail("TestParseRawSliceStarSugarNested", "expected char elem")
	}
	return ""
}

// *[10]int — bare *[<expr> is no longer valid; must use *([10]int).
func TestParseBareStarBracketArrayRejected() testing.TestResult {
	var p @Parser = mkParser("*[10]int")
	var te @ast.TypeExpr = parseType(p)
	if te == nil {
		return fail("TestParseBareStarBracketArrayRejected", "parseType returned nil")
	}
	var errs @[]ParseError = p.Errors()
	if len(errs) == 0 {
		return fail("TestParseBareStarBracketArrayRejected", "expected parse error, got none")
	}
	return ""
}

// *([10]int) — pointer-to-array via parens.
func TestParsePointerToArrayViaParens() testing.TestResult {
	var p @Parser = mkParser("*([10]int)")
	var te @ast.TypeExpr = parseType(p)
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParsePointerToArrayViaParens", errs[0].Msg)
	}
	if te.Kind != ast.TEXPR_POINTER {
		return fail("TestParsePointerToArrayViaParens", "expected TEXPR_POINTER")
	}
	if te.Base.Kind != ast.TEXPR_PAREN {
		return fail("TestParsePointerToArrayViaParens", "expected TEXPR_PAREN base")
	}
	if te.Base.Base.Kind != ast.TEXPR_ARRAY {
		return fail("TestParsePointerToArrayViaParens", "expected TEXPR_ARRAY inside paren")
	}
	return ""
}

// *(*[]int) — pointer-to-raw-slice via parens.
func TestParsePointerToSliceViaParens() testing.TestResult {
	var p @Parser = mkParser("*(*[]int)")
	var te @ast.TypeExpr = parseType(p)
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParsePointerToSliceViaParens", errs[0].Msg)
	}
	if te.Kind != ast.TEXPR_POINTER {
		return fail("TestParsePointerToSliceViaParens", "expected TEXPR_POINTER")
	}
	if te.Base.Kind != ast.TEXPR_PAREN {
		return fail("TestParsePointerToSliceViaParens", "expected TEXPR_PAREN base")
	}
	if te.Base.Base.Kind != ast.TEXPR_SLICE {
		return fail("TestParsePointerToSliceViaParens", "expected TEXPR_SLICE inside paren")
	}
	return ""
}

// ============================================================
// `Self` type expression — parser only (context restrictions are
// enforced downstream by the type checker per plan-self-type.md
// Slice S.2).
// ============================================================

// Bare `Self` parses as TEXPR_SELF.
func TestParseSelfBare() testing.TestResult {
	var p @Parser = mkParser("Self")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_SELF {
		return fail("TestParseSelfBare", "expected TEXPR_SELF")
	}
	return ""
}

// `*Self` parses as TEXPR_POINTER wrapping TEXPR_SELF.
func TestParseSelfPointer() testing.TestResult {
	var p @Parser = mkParser("*Self")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_POINTER {
		return fail("TestParseSelfPointer", "expected TEXPR_POINTER")
	}
	if te.Base.Kind != ast.TEXPR_SELF {
		return fail("TestParseSelfPointer", "expected TEXPR_SELF base")
	}
	return ""
}

// `@Self` parses as TEXPR_MANAGED wrapping TEXPR_SELF.
func TestParseSelfManaged() testing.TestResult {
	var p @Parser = mkParser("@Self")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_MANAGED {
		return fail("TestParseSelfManaged", "expected TEXPR_MANAGED")
	}
	if te.Base.Kind != ast.TEXPR_SELF {
		return fail("TestParseSelfManaged", "expected TEXPR_SELF base")
	}
	return ""
}

// `@[]Self` parses as TEXPR_MANAGED_SLICE with TEXPR_SELF element.
func TestParseSelfManagedSlice() testing.TestResult {
	var p @Parser = mkParser("@[]Self")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_MANAGED_SLICE {
		return fail("TestParseSelfManagedSlice", "expected TEXPR_MANAGED_SLICE")
	}
	if te.Base.Kind != ast.TEXPR_SELF {
		return fail("TestParseSelfManagedSlice", "expected TEXPR_SELF element")
	}
	return ""
}

// `*[]Self` parses as TEXPR_SLICE with TEXPR_SELF element.
func TestParseSelfRawSlice() testing.TestResult {
	var p @Parser = mkParser("*[]Self")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_SLICE {
		return fail("TestParseSelfRawSlice", "expected TEXPR_SLICE")
	}
	if te.Base.Kind != ast.TEXPR_SELF {
		return fail("TestParseSelfRawSlice", "expected TEXPR_SELF element")
	}
	return ""
}

// `Self` as a function-value return type (covers
// isFuncResultStart accepting SELF).
func TestParseSelfAsFuncResult() testing.TestResult {
	var p @Parser = mkParser("*func() Self")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_FUNC_VALUE {
		return fail("TestParseSelfAsFuncResult", "expected TEXPR_FUNC_VALUE")
	}
	if len(te.ResultTypes) != 1 {
		return fail("TestParseSelfAsFuncResult", "expected one result type")
	}
	if te.ResultTypes[0].Kind != ast.TEXPR_SELF {
		return fail("TestParseSelfAsFuncResult", "expected Self as result type")
	}
	return ""
}

// Bare "@[N]T" is a syntax error: "@[" is managed-slice sugar ("@[]T"),
// so a managed pointer to an array needs parens "@([N]T)" — mirroring
// the "*[N]T" rejection. The parser used to accept "@[3]int" silently
// as "@([3]int)", asymmetric with "*[3]int" (which was rejected).
func TestParseBareManagedArrayRejected() testing.TestResult {
	var p @Parser = mkParser("@[3]int")
	parseType(p)
	if len(p.Errors()) == 0 {
		return fail("TestParseBareManagedArrayRejected",
			"bare @[N]T must be a parse error (use @([N]T))")
	}
	return ""
}

// Guard: the parenthesized form "@([N]T)" parses cleanly as a managed
// pointer to an array.
func TestParseParenManagedArrayAccepted() testing.TestResult {
	var p @Parser = mkParser("@([3]int)")
	var te @ast.TypeExpr = parseType(p)
	if len(p.Errors()) != 0 {
		return fail("TestParseParenManagedArrayAccepted",
			"@([N]T) must parse without error")
	}
	if te.Kind != ast.TEXPR_MANAGED {
		return fail("TestParseParenManagedArrayAccepted",
			"expected TEXPR_MANAGED")
	}
	return ""
}
