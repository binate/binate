package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Parser tests for variadic parameters (`name ...T`), variadic function-value
// types (`*func(...T)` / `@func(...T)`), and the call spread (`expr...`) —
// Phase 2 of plan-variadics-detailed.md.  Helpers `mkParser` / `parseExpr` /
// `parseType` / `fail` / `charEq` live in sibling parser test files.

// variadicOneErr reports whether the parser recorded EXACTLY ONE error and it
// equals `want` — the plan's "exactly one diagnostic (verify recovery)" contract.
func variadicOneErr(p @Parser, want *[]readonly char) bool {
	if len(p.errs) != 1 { return false }
	return charEq(p.errs[0].Msg, want)
}

// `func f(xs ...int) {}` — the sole param is variadic; Type is the ELEMENT type.
func TestParseVariadicParam() testing.TestResult {
	var p @Parser = mkParser("package \"test\"\nfunc f(xs ...int) {}")
	var file @ast.File = p.ParseFile()
	if len(p.errs) != 0 {
		return fail("TestParseVariadicParam", p.errs[0].Msg)
	}
	var d @ast.Decl = file.Decls[0]
	if len(d.Params) != 1 {
		return fail("TestParseVariadicParam", "expected 1 param")
	}
	if !d.Params[0].Variadic {
		return fail("TestParseVariadicParam", "param should be Variadic")
	}
	if d.Params[0].Type == nil || d.Params[0].Type.Kind != ast.TEXPR_NAMED ||
			!charEq(d.Params[0].Type.Name, "int") {
		return fail("TestParseVariadicParam", "element type should be int")
	}
	return ""
}

// `func f(a int, xs ...int) {}` — only the LAST param is variadic.
func TestParseVariadicParamWithFixed() testing.TestResult {
	var p @Parser = mkParser("package \"test\"\nfunc f(a int, xs ...int) {}")
	var file @ast.File = p.ParseFile()
	if len(p.errs) != 0 {
		return fail("TestParseVariadicParamWithFixed", p.errs[0].Msg)
	}
	var d @ast.Decl = file.Decls[0]
	if len(d.Params) != 2 {
		return fail("TestParseVariadicParamWithFixed", "expected 2 params")
	}
	if d.Params[0].Variadic {
		return fail("TestParseVariadicParamWithFixed", "fixed param 0 not variadic")
	}
	if !d.Params[1].Variadic {
		return fail("TestParseVariadicParamWithFixed", "param 1 should be variadic")
	}
	return ""
}

// `func f(xs ...int,) {}` — a trailing comma after a variadic last param is legal.
func TestParseVariadicTrailingComma() testing.TestResult {
	var p @Parser = mkParser("package \"test\"\nfunc f(xs ...int,) {}")
	p.ParseFile()
	if len(p.errs) != 0 {
		return fail("TestParseVariadicTrailingComma", p.errs[0].Msg)
	}
	return ""
}

// `*func(...int)` — sole-param variadic function-value type (first param is
// parsed outside the comma loop, the easy-to-miss case).
func TestParseVariadicFuncValueTypeRaw() testing.TestResult {
	var p @Parser = mkParser("*func(...int)")
	var te @ast.TypeExpr = parseType(p)
	if len(p.errs) != 0 {
		return fail("TestParseVariadicFuncValueTypeRaw", p.errs[0].Msg)
	}
	if te.Kind != ast.TEXPR_FUNC_VALUE {
		return fail("TestParseVariadicFuncValueTypeRaw", "expected TEXPR_FUNC_VALUE")
	}
	if !te.VariadicParams {
		return fail("TestParseVariadicFuncValueTypeRaw", "expected VariadicParams")
	}
	if len(te.ParamTypes) != 1 {
		return fail("TestParseVariadicFuncValueTypeRaw", "expected 1 param type")
	}
	return ""
}

// `@func(int, ...int)` — managed variadic function-value type with a fixed
// leading param.
func TestParseVariadicFuncValueTypeManaged() testing.TestResult {
	var p @Parser = mkParser("@func(int, ...int)")
	var te @ast.TypeExpr = parseType(p)
	if len(p.errs) != 0 {
		return fail("TestParseVariadicFuncValueTypeManaged", p.errs[0].Msg)
	}
	if te.Kind != ast.TEXPR_MANAGED_FUNC_VALUE {
		return fail("TestParseVariadicFuncValueTypeManaged", "expected TEXPR_MANAGED_FUNC_VALUE")
	}
	if !te.VariadicParams {
		return fail("TestParseVariadicFuncValueTypeManaged", "expected VariadicParams")
	}
	if len(te.ParamTypes) != 2 {
		return fail("TestParseVariadicFuncValueTypeManaged", "expected 2 param types")
	}
	return ""
}

// `g(a, s...)` — the final argument is a spread.
func TestParseSpreadCall() testing.TestResult {
	var p @Parser = mkParser("g(a, s...)")
	var e @ast.Expr = parseExpr(p)
	if len(p.errs) != 0 {
		return fail("TestParseSpreadCall", p.errs[0].Msg)
	}
	if e.Kind != ast.EXPR_CALL {
		return fail("TestParseSpreadCall", "expected EXPR_CALL")
	}
	if !e.Spread {
		return fail("TestParseSpreadCall", "expected Spread")
	}
	if len(e.Args) != 2 {
		return fail("TestParseSpreadCall", "expected 2 args")
	}
	return ""
}

// A plain call is not a spread.
func TestParseCallNoSpread() testing.TestResult {
	var p @Parser = mkParser("g(a, b)")
	var e @ast.Expr = parseExpr(p)
	if e.Spread {
		return fail("TestParseCallNoSpread", "plain call should not be Spread")
	}
	return ""
}

// Negative: `...` on a non-final parameter.
func TestParseVariadicNotLast() testing.TestResult {
	var p @Parser = mkParser("package \"test\"\nfunc f(xs ...int, y int) {}")
	p.ParseFile()
	if !variadicOneErr(p, "variadic parameter must be last") {
		return fail("TestParseVariadicNotLast", "expected 'variadic parameter must be last'")
	}
	return ""
}

// Negative: more than one variadic parameter.
func TestParseTwoVariadic() testing.TestResult {
	var p @Parser = mkParser("package \"test\"\nfunc f(xs ...int, ys ...int) {}")
	p.ParseFile()
	if !variadicOneErr(p, "at most one variadic parameter is allowed") {
		return fail("TestParseTwoVariadic", "expected 'at most one variadic parameter is allowed'")
	}
	return ""
}

// Negative: a variadic receiver.
func TestParseVariadicReceiver() testing.TestResult {
	var p @Parser = mkParser("package \"test\"\nfunc (r ...int) M() {}")
	p.ParseFile()
	if !variadicOneErr(p, "receiver may not be variadic") {
		return fail("TestParseVariadicReceiver", "expected 'receiver may not be variadic'")
	}
	return ""
}

// Negative: a spread that is not the final argument — and exactly one diagnostic
// (recovery skips the stray tokens so no cascading "expected )").
func TestParseSpreadNotLast() testing.TestResult {
	var p @Parser = mkParser("g(a..., b)")
	parseExpr(p)
	if len(p.errs) != 1 {
		return fail("TestParseSpreadNotLast", "expected exactly one parse error")
	}
	if !charEq(p.errs[0].Msg, "spread argument must be last") {
		return fail("TestParseSpreadNotLast", p.errs[0].Msg)
	}
	return ""
}

// Negative: a variadic param that is not last in a function-value type.
func TestParseFuncValueVariadicNotLast() testing.TestResult {
	var p @Parser = mkParser("*func(...int, int)")
	parseType(p)
	if !variadicOneErr(p, "variadic parameter must be last") {
		return fail("TestParseFuncValueVariadicNotLast", "expected 'variadic parameter must be last'")
	}
	return ""
}
