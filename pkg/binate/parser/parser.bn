package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/lexer"
import "pkg/binate/token"
import "pkg/std/strings"
import "pkg/stdx/slices"

// New creates a parser for source code (a .bn implementation file).
func New(src *[]uint8, file *[]readonly char) @Parser {
	return newParser(lexer.New(src, file), false)
}

// NewInterface creates a parser for a .bni interface file.
func NewInterface(src *[]uint8, file *[]readonly char) @Parser {
	return newParser(lexer.New(src, file), true)
}

// NewCollecting is New with comment retention: the resulting File carries its
// comments (File.Comments), for tooling that needs them (a formatter).
func NewCollecting(src *[]uint8, file *[]readonly char) @Parser {
	return newParser(lexer.NewCollecting(src, file), false)
}

// NewInterfaceCollecting is NewInterface with comment retention.
func NewInterfaceCollecting(src *[]uint8, file *[]readonly char) @Parser {
	return newParser(lexer.NewCollecting(src, file), true)
}

// newParser is the shared constructor: it wraps an already-created lexer
// (comment-collecting or not) and primes the first token.
func newParser(lx @lexer.Lexer, iface bool) @Parser {
	var p @Parser = make(Parser)
	p.lex = lx
	p.noCompositeLit = false
	p.interfaceFile = iface
	p.next()
	return p
}

// Errors returns the list of parse errors.
func (p @Parser) Errors() @[]ParseError {
	return p.errs
}

// next advances to the next token. If peekTok()/peekTok2() have
// stashed lookahead tokens, drain them in order first: peek becomes
// the current token, and any second-token lookahead shifts down into
// peek.
func (p @Parser) next() {
	p.prev = p.tok
	if p.hasPeek {
		p.tok = p.peek
		if p.hasPeek2 {
			p.peek = p.peek2
			p.hasPeek2 = false
		} else {
			p.hasPeek = false
		}
	} else {
		p.tok = p.lex.Next()
	}
}

// peekTok returns the token after the current one without consuming
// the current. Subsequent calls return the same stashed token until
// a p.next() drains it.
func (p @Parser) peekTok() token.Token {
	if !p.hasPeek {
		p.peek = p.lex.Next()
		p.hasPeek = true
	}
	return p.peek
}

// peekTok2 returns the second token after the current one (i.e. the
// token following peekTok()) without consuming anything. It pulls and
// stashes both lookahead tokens as needed so peekTok() and the next
// p.next() stay consistent. Used by D11 type-decl disambiguation.
func (p @Parser) peekTok2() token.Token {
	if !p.hasPeek {
		p.peek = p.lex.Next()
		p.hasPeek = true
	}
	if !p.hasPeek2 {
		p.peek2 = p.lex.Next()
		p.hasPeek2 = true
	}
	return p.peek2
}

// expect consumes the current token if it matches typ, otherwise records an error.
func (p @Parser) expect(typ token.Type) token.Token {
	var tok token.Token = p.tok
	if p.tok.Typ != typ {
		p.errExpected(typ)
	} else {
		p.next()
	}
	return tok
}

// endFrom returns the End position for a node that starts at `pos` and whose
// last consumed token ended at `prevEnd`: prevEnd when it is at or after pos,
// otherwise pos itself (a zero-width span).  The fallback guards nodes that
// consumed no token of their own -- error-recovery nodes and the empty
// statement -- from inheriting a backwards End from an earlier token.
func endFrom(pos token.Pos, prevEnd token.Pos) token.Pos {
	if prevEnd.Line > pos.Line {
		return prevEnd
	}
	if prevEnd.Line == pos.Line && prevEnd.Col >= pos.Col {
		return prevEnd
	}
	return pos
}

// got returns true and advances if the current token matches typ.
func (p @Parser) got(typ token.Type) bool {
	if p.tok.Typ == typ {
		p.next()
		return true
	}
	return false
}

// errExpected records "expected X, got Y" error.
func (p @Parser) errExpected(typ token.Type) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("expected ")
	cb.Write(token.TypeName(typ))
	cb.Write(", got ")
	cb.Write(token.TypeName(p.tok.Typ))
	p.addError(p.tok.Pos, buf.CopyStr(cb.String()))
}

// errMsg records a parse error with a custom message.
func (p @Parser) errMsg(msg @[]char) {
	p.addError(p.tok.Pos, msg)
}

// addError appends a parse error.
func (p @Parser) addError(pos token.Pos, msg @[]char) {
	var e ParseError
	e.Pos = pos
	e.Msg = msg
	p.errs = slices.Append[ParseError](p.errs, e)
}

// ============================================================
// Source File Parsing
// ============================================================

// ParseFile parses a complete source file: package clause, imports, and top-level declarations.
func (p @Parser) ParseFile() @ast.File {
	var f @ast.File = make(ast.File)
	f.Pos = p.tok.Pos

	// Package clause, with an optional leading annotation block
	// (e.g. `#[build(is(os, "linux"))] package "x"`).
	f.Annotations = parseAnnotationBlock(p)
	p.expect(token.PACKAGE)
	if p.tok.Typ == token.STRING {
		f.PkgName = p.tok.Lit
		p.next()
	} else {
		p.errMsg("expected package name string")
	}
	p.expect(token.SEMICOLON)

	// Import declarations, each with an optional leading annotation block
	// (e.g. `#[build(is(os, "linux"))] import "pkg/x"`).  A leading block
	// that precedes a non-import belongs to the first top-level declaration;
	// carry it over to the declaration loop.
	var pendingAnnots @[]@ast.Annotation
	var havePending bool = false
	for {
		var annots @[]@ast.Annotation = parseAnnotationBlock(p)
		if p.tok.Typ != token.IMPORT {
			pendingAnnots = annots
			havePending = true
			break
		}
		var specs @[]@ast.ImportSpec = parseImportDecl(p)
		for i := 0; i < len(specs); i++ {
			specs[i].Annotations = annots
			f.Imports = slices.Append[@ast.ImportSpec](f.Imports, specs[i])
		}
		p.expect(token.SEMICOLON)
	}

	// Top-level declarations
	for p.tok.Typ != token.EOF {
		var annots @[]@ast.Annotation
		if havePending {
			annots = pendingAnnots
			havePending = false
		} else {
			annots = parseAnnotationBlock(p)
		}
		var d @ast.Decl = parseTopLevelDecl(p)
		if d != nil {
			d.Annotations = annots
			f.Decls = slices.Append[@ast.Decl](f.Decls, d)
		}
		if p.tok.Typ != token.EOF {
			p.expect(token.SEMICOLON)
		}
	}

	// Parsing has consumed every token, so the lexer has now seen all
	// comments.  Empty on the non-collecting (compiler) path.
	f.Comments = p.lex.Comments()
	return f
}

// ============================================================
// REPL entry points
// ============================================================

// ParseExpr parses a single expression from the parser's current
// position.  Caller is responsible for setting up the parser via New
// and for inspecting Errors afterward.  Used by the REPL to evaluate
// bare expressions in immediate mode.
func (p @Parser) ParseExpr() @ast.Expr {
	return parseExpr(p)
}

// ParseTopLevelDecl parses a single top-level declaration (`func`,
// `type`, `var`, or `const`).  REPL entry point for Tier 2: a decl
// typed at the prompt becomes a persistent addition to the loaded
// module's scope.  Errors out (returns nil) if the current token
// isn't one of the four decl-leading keywords.
func (p @Parser) ParseTopLevelDecl() @ast.Decl {
	return parseTopLevelDecl(p)
}

// IsAtTopLevelDecl returns true if the parser's current token
// starts a top-level declaration (func / type / var / const).
// REPL dispatch helper: lets the prompt route input to
// ParseTopLevelDecl vs. ParseStmtList without exposing the
// parser's token-type internals.  Call immediately after `New`
// (which preloads the first token) and before any parse call
// that consumes it.
func (p @Parser) IsAtTopLevelDecl() bool {
	if p.tok.Typ == token.FUNC { return true }
	if p.tok.Typ == token.TYPE { return true }
	if p.tok.Typ == token.VAR { return true }
	if p.tok.Typ == token.CONST { return true }
	if p.tok.Typ == token.INTERFACE { return true }
	if p.tok.Typ == token.IMPL { return true }
	return false
}

// IsAtImport returns true if the parser's current token is
// `import`.  Tier 5 REPL dispatch helper: a prompt entry that
// starts with `import` is routed to ParseImportDecl rather than
// the top-level-decl or stmt-list paths.  Same call-immediately-
// after-`New` contract as IsAtTopLevelDecl.
func (p @Parser) IsAtImport() bool {
	return p.tok.Typ == token.IMPORT
}

// ParseImportDecl parses a single or grouped import declaration
// from the prompt: `import "pkg/foo"` or `import ( "pkg/foo";
// "pkg/bar" )`.  Returns the parsed specs; caller (REPL driver)
// loads each via the Loader and registers it in the session
// scope.  Per Tier 5 of plan-repl.md.
func (p @Parser) ParseImportDecl() @[]@ast.ImportSpec {
	return parseImportDecl(p)
}

// ParseStmtList parses statements until EOF.  Mirrors the inner loop
// of parseBlock but without the surrounding braces.  Used by the REPL
// to evaluate a bare statement list in immediate mode (e.g. multiple
// statements separated by newlines/semicolons typed at the prompt).
func (p @Parser) ParseStmtList() @[]@ast.Stmt {
	var stmts @[]@ast.Stmt
	for p.tok.Typ != token.EOF {
		stmts = slices.Append[@ast.Stmt](stmts, parseStmt(p))
		if !p.got(token.SEMICOLON) {
			if p.tok.Typ != token.EOF {
				p.errMsg("expected ; or end of input")
				p.next()
			}
		}
	}
	return stmts
}


// parseImportDecl parses a single or grouped import declaration.
func parseImportDecl(p @Parser) @[]@ast.ImportSpec {
	p.expect(token.IMPORT)

	if p.tok.Typ == token.LPAREN {
		// Grouped import
		p.next()
		var specs @[]@ast.ImportSpec
		for p.tok.Typ != token.RPAREN && p.tok.Typ != token.EOF {
			specs = slices.Append[@ast.ImportSpec](specs, parseImportSpec(p))
			if !p.got(token.SEMICOLON) {
				break
			}
		}
		p.expect(token.RPAREN)
		return specs
	}

	var specs @[]@ast.ImportSpec
	specs = slices.Append[@ast.ImportSpec](specs, parseImportSpec(p))
	return specs
}

// parseImportSpec parses a single import spec with optional alias and path.
func parseImportSpec(p @Parser) @ast.ImportSpec {
	var spec @ast.ImportSpec = make(ast.ImportSpec)
	spec.Pos = p.tok.Pos

	if p.tok.Typ == token.IDENT {
		spec.Alias = p.tok.Lit
		p.next()
	}
	if p.tok.Typ == token.STRING {
		spec.Path = p.tok.Lit
		p.next()
	} else {
		p.errMsg("expected import path string")
	}
	return spec
}

// parseTopLevelDecl parses a top-level declaration and stamps its End (the
// position past the last token consumed).  Returns nil on error.
func parseTopLevelDecl(p @Parser) @ast.Decl {
	var d @ast.Decl = parseTopLevelDeclInner(p)
	if d != nil {
		d.End = endFrom(d.Pos, p.prev.End)
	}
	return d
}

// parseTopLevelDeclInner dispatches to the specific declaration parser (func,
// type, var, const, interface, or impl).
func parseTopLevelDeclInner(p @Parser) @ast.Decl {
	if p.tok.Typ == token.FUNC {
		return parseFuncDecl(p)
	}
	if p.tok.Typ == token.TYPE {
		return parseTypeDecl(p)
	}
	if p.tok.Typ == token.VAR {
		return parseVarDecl(p)
	}
	if p.tok.Typ == token.CONST {
		return parseConstDecl(p)
	}
	if p.tok.Typ == token.INTERFACE {
		return parseInterfaceDecl(p)
	}
	if p.tok.Typ == token.IMPL {
		return parseImplDecl(p)
	}
	p.errMsg("expected declaration")
	p.next()
	return nil
}
