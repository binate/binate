package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Module-level source buffer — keeps the source alive while the parser borrows it.
var parserSrcBuf @[]uint8

// Helper to create a parser from a string.
// Stores the source in parserSrcBuf so the parser's borrow stays valid.
func mkParser(src *[]readonly char) @Parser {
	parserSrcBuf = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		parserSrcBuf[i] = cast(uint8, src[i])
	}
	return New(parserSrcBuf, "test.bn")
}

// mkBniParser is mkParser's .bni-mode counterpart.  Non-generic
// decls parse signature-only; generic decls (TypeParams non-empty)
// carry bodies.
func mkBniParser(src *[]readonly char) @Parser {
	parserSrcBuf = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		parserSrcBuf[i] = cast(uint8, src[i])
	}
	return NewInterface(parserSrcBuf, "test.bni")
}

// mkCollectingParser is mkParser with comment retention (File.Comments).
func mkCollectingParser(src *[]readonly char) @Parser {
	parserSrcBuf = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		parserSrcBuf[i] = cast(uint8, src[i])
	}
	return NewCollecting(parserSrcBuf, "test.bn")
}

// mkCollectingBniParser is mkBniParser with comment retention.
func mkCollectingBniParser(src *[]readonly char) @Parser {
	parserSrcBuf = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		parserSrcBuf[i] = cast(uint8, src[i])
	}
	return NewInterfaceCollecting(parserSrcBuf, "test.bni")
}

// Helper to build a failure message with context
func fail(msg *[]readonly char, detail *[]readonly char) testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(msg)
	cb.Write(": ")
	cb.Write(detail)
	return buf.CopyStr(cb.String())
}

// charEq compares two *[]readonly char for equality.
func charEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// ============================================================
// File Parsing Tests
// ============================================================

func TestParseImports() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nimport \"pkg/binate/token\"\n"
			"import \"pkg/binate/ast\"\n"
			"func main() {}"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Imports) != 2 {
		return fail("TestParseImports", "expected 2 imports")
	}
	if !charEq(f.PkgName, "\"test\"") {
		return fail("TestParseImports", "expected pkg name '\"test\"'")
	}
	return ""
}

// NewCollecting makes ParseFile populate File.Comments (own-line + trailing);
// the default parser leaves it empty.
func TestParseFileComments() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"// doc for f\n"
			"func f() int { return 1 } // trailing\n"
	var p @Parser = mkCollectingParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Comments) != 2 {
		return fail("TestParseFileComments", "expected 2 comments")
	}
	if !charEq(f.Comments[0].Text, "// doc for f") || !f.Comments[0].OwnLine {
		return fail("TestParseFileComments", "comment 0 (own-line doc) wrong")
	}
	if !charEq(f.Comments[1].Text, "// trailing") || f.Comments[1].OwnLine {
		return fail("TestParseFileComments", "comment 1 (trailing) wrong")
	}
	var p2 @Parser = mkParser(src)
	var f2 @ast.File = p2.ParseFile()
	if len(f2.Comments) != 0 {
		return fail("TestParseFileComments", "New should leave Comments empty")
	}
	return ""
}

// NewInterfaceCollecting populates File.Comments for a .bni interface file.
func TestParseFileCommentsBni() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"// doc for F\n"
			"func F(x int) int\n"
	var p @Parser = mkCollectingBniParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Comments) != 1 {
		return fail("TestParseFileCommentsBni", "expected 1 comment")
	}
	if !charEq(f.Comments[0].Text, "// doc for F") || !f.Comments[0].OwnLine {
		return fail("TestParseFileCommentsBni", "doc comment wrong")
	}
	return ""
}

func TestParseNoErrors() testing.TestResult {
	var p @Parser = mkParser(
			"package \"test\"\n"
					"import \"pkg/binate/token\"\n"
					"func foo(x int) int { return x + 1 }\n"
					"var y int = 10")
	var f @ast.File = p.ParseFile()
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParseNoErrors", errs[0].Msg)
	}
	if len(f.Decls) != 2 {
		return fail("TestParseNoErrors", "expected 2 decls")
	}
	return ""
}

func TestParseCompositeLit() testing.TestResult {
	var p @Parser = mkParser("Foo{x: 1, y: 2}")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_COMPOSITE {
		return fail("TestParseCompositeLit", "expected EXPR_COMPOSITE")
	}
	if len(e.Elems) != 2 {
		return fail("TestParseCompositeLit", "expected 2 elements")
	}
	if e.Elems[0].Key == nil {
		return fail("TestParseCompositeLit", "expected key in element")
	}
	return ""
}

// Generic-instantiated composite-literal head `Foo[T]{...}` (§13.10):
// the head must parse as a composite literal whose TypeRef is a
// TEXPR_INSTANTIATE, not an EXPR_INSTANTIATE_OR_INDEX with an orphaned
// `{`.
func TestParseGenericCompositeLit() testing.TestResult {
	var p @Parser = mkParser("Pair[int]{a: 1, b: 2}")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_COMPOSITE {
		return fail("TestParseGenericCompositeLit", "expected EXPR_COMPOSITE")
	}
	if e.TypeRef == nil || e.TypeRef.Kind != ast.TEXPR_INSTANTIATE {
		return fail("TestParseGenericCompositeLit", "expected a TEXPR_INSTANTIATE head")
	}
	if e.TypeRef.Base == nil || e.TypeRef.Base.Kind != ast.TEXPR_NAMED ||
			!charEq(e.TypeRef.Base.Name, "Pair") {
		return fail("TestParseGenericCompositeLit", "expected Pair head")
	}
	if len(e.TypeRef.TypeArgs) != 1 {
		return fail("TestParseGenericCompositeLit", "expected one type arg")
	}
	if len(e.Elems) != 2 {
		return fail("TestParseGenericCompositeLit", "expected 2 elements")
	}
	return ""
}

// Guard: a plain index `arr[i]` is NOT mis-parsed as a composite head
// (no following `{`), and an index followed by a block in a
// no-composite context stays an index.
func TestParseIndexNotGenericComposite() testing.TestResult {
	var p @Parser = mkParser("arr[i]")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX {
		return fail("TestParseIndexNotGenericComposite",
				"plain index must stay EXPR_INSTANTIATE_OR_INDEX")
	}
	return ""
}

func TestParseMultiReturn() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func divmod(a int, b int) (int, int) { return a / b, a % b }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParseMultiReturn", errs[0].Msg)
	}
	var d @ast.Decl = f.Decls[0]
	if len(d.Results) != 2 {
		return fail("TestParseMultiReturn", "expected 2 results")
	}
	return ""
}

// ============================================================
// REPL entry-point tests
// ============================================================

// TestParseExprBasic verifies ParseExpr returns the parsed expression
// for a simple binary expression.
func TestParseExprBasic() testing.TestResult {
	var p @Parser = mkParser("1 + 2")
	var e @ast.Expr = p.ParseExpr()
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParseExprBasic", errs[0].Msg)
	}
	if e.Kind != ast.EXPR_BINARY {
		return fail("TestParseExprBasic", "expected EXPR_BINARY")
	}
	return ""
}

// TestParseStmtListSingle parses a single statement until EOF.
func TestParseStmtListSingle() testing.TestResult {
	var p @Parser = mkParser("var x int = 5")
	var ss @[]@ast.Stmt = p.ParseStmtList()
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParseStmtListSingle", errs[0].Msg)
	}
	if len(ss) != 1 {
		return fail("TestParseStmtListSingle", "expected 1 stmt")
	}
	if ss[0].Kind != ast.STMT_DECL {
		return fail("TestParseStmtListSingle", "expected STMT_DECL")
	}
	return ""
}

// TestParseStmtListMultiple parses several statements separated by
// semicolons.  Exercises the inner loop's semi-or-EOF dispatch.
func TestParseStmtListMultiple() testing.TestResult {
	var p @Parser = mkParser("var x int = 5; x = x + 1; x = x * 2")
	var ss @[]@ast.Stmt = p.ParseStmtList()
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParseStmtListMultiple", errs[0].Msg)
	}
	if len(ss) != 3 {
		return fail("TestParseStmtListMultiple", "expected 3 stmts")
	}
	return ""
}

// TestParseTopLevelDeclFunc parses a `func` decl at top level (the
// shape that arrives at the REPL prompt for Tier 2).
func TestParseTopLevelDeclFunc() testing.TestResult {
	var p @Parser = mkParser("func double(x int) int { return x * 2 }")
	var d @ast.Decl = p.ParseTopLevelDecl()
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParseTopLevelDeclFunc", errs[0].Msg)
	}
	if d == nil { return fail("TestParseTopLevelDeclFunc", "nil decl") }
	if d.Kind != ast.DECL_FUNC {
		return fail("TestParseTopLevelDeclFunc", "expected DECL_FUNC")
	}
	if !charEq(d.Name, "double") {
		return fail("TestParseTopLevelDeclFunc", "wrong name")
	}
	return ""
}

// TestIsAtTopLevelDecl exercises the REPL dispatch helper for
// each of the four decl-leading keywords plus a couple of
// non-decl shapes.
func TestIsAtTopLevelDecl() testing.TestResult {
	if !mkParser("func foo() {}").IsAtTopLevelDecl() {
		return fail("TestIsAtTopLevelDecl", "expected true for `func`")
	}
	if !mkParser("type T struct { X int }").IsAtTopLevelDecl() {
		return fail("TestIsAtTopLevelDecl", "expected true for `type`")
	}
	if !mkParser("var x int = 5").IsAtTopLevelDecl() {
		return fail("TestIsAtTopLevelDecl", "expected true for `var`")
	}
	if !mkParser("const C int = 5").IsAtTopLevelDecl() {
		return fail("TestIsAtTopLevelDecl", "expected true for `const`")
	}
	if mkParser("println(7)").IsAtTopLevelDecl() {
		return fail("TestIsAtTopLevelDecl", "expected false for ident")
	}
	if mkParser("1 + 2").IsAtTopLevelDecl() {
		return fail("TestIsAtTopLevelDecl", "expected false for int literal")
	}
	if mkParser("").IsAtTopLevelDecl() {
		return fail("TestIsAtTopLevelDecl", "expected false for empty input")
	}
	return ""
}

// D4 (§13.13): inside a no-composite context (an if/for/switch
// condition), a PARENTHESIZED composite literal must still parse as a
// composite — the documented paren-escape `if (Point{1,2}) == p {}`.
func TestParseParenCompositeEscapesNoCompositeCtx() testing.TestResult {
	var p @Parser = mkParser("(Point{x: 1})")
	var e @ast.Expr = parseExprNoCompositeLit(p)
	if e.Kind != ast.EXPR_COMPOSITE {
		return fail("TestParseParenCompositeEscapesNoCompositeCtx",
				"a parenthesized composite must parse even in a no-composite context")
	}
	return ""
}

// Guard: without parens the composite stays SUPPRESSED in a
// no-composite context (the `{` is a following block), so the bare
// `Point` parses as an identifier — not a composite.
func TestParseBareCompositeStaysSuppressed() testing.TestResult {
	var p @Parser = mkParser("Point{x: 1}")
	var e @ast.Expr = parseExprNoCompositeLit(p)
	if e.Kind == ast.EXPR_COMPOSITE {
		return fail("TestParseBareCompositeStaysSuppressed",
				"a bare composite must stay suppressed in a no-composite context")
	}
	return ""
}
