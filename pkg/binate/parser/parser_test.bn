package "pkg/binate/parser"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/builtins/testing"

// Module-level source buffer — keeps the source alive while the parser borrows it.
var parserSrcBuf @[]uint8

// Helper to create a parser from a string.
// Stores the source in parserSrcBuf so the parser's borrow stays valid.
func mkParser(src *[]readonly char) @Parser {
	parserSrcBuf = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		parserSrcBuf[i] = cast(uint8, src[i])
	}
	return New(parserSrcBuf, "test.bn")
}

// mkBniParser is mkParser's .bni-mode counterpart.  Non-generic
// decls parse signature-only; generic decls (TypeParams non-empty)
// carry bodies — plan-generics.md Slice 7 / Q7.
func mkBniParser(src *[]readonly char) @Parser {
	parserSrcBuf = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		parserSrcBuf[i] = cast(uint8, src[i])
	}
	return NewInterface(parserSrcBuf, "test.bni")
}

// Helper to build a failure message with context
func fail(msg *[]readonly char, detail *[]readonly char) testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(msg)
	cb = cb.WriteStr(": ")
	cb = cb.WriteStr(detail)
	var result @[]char = cb.Bytes()
	return result
}

// charEq compares two *[]readonly char for equality.
func charEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// ============================================================
// File Parsing Tests
// ============================================================

func TestParseImports() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nimport \"pkg/binate/token\"\nimport \"pkg/binate/ast\"\nfunc main() {}"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Imports) != 2 {
		return fail("TestParseImports", "expected 2 imports")
	}
	if !charEq(f.PkgName, "\"test\"") {
		return fail("TestParseImports", "expected pkg name '\"test\"'")
	}
	return ""
}

func TestParseNoErrors() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("package \"test\"\n")
	b = b.WriteStr("import \"pkg/binate/token\"\n")
	b = b.WriteStr("func foo(x int) int { return x + 1 }\n")
	b = b.WriteStr("var y int = 10")
	var src @[]char = b.Bytes()
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParseNoErrors", errs[0].Msg)
	}
	if len(f.Decls) != 2 {
		return fail("TestParseNoErrors", "expected 2 decls")
	}
	return ""
}

func TestParseCompositeLit() testing.TestResult {
	var p @Parser = mkParser("Foo{x: 1, y: 2}")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_COMPOSITE {
		return fail("TestParseCompositeLit", "expected EXPR_COMPOSITE")
	}
	if len(e.Elems) != 2 {
		return fail("TestParseCompositeLit", "expected 2 elements")
	}
	if e.Elems[0].Key == nil {
		return fail("TestParseCompositeLit", "expected key in element")
	}
	return ""
}

func TestParseMultiReturn() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nfunc divmod(a int, b int) (int, int) { return a / b, a % b }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParseMultiReturn", errs[0].Msg)
	}
	var d @ast.Decl = f.Decls[0]
	if len(d.Results) != 2 {
		return fail("TestParseMultiReturn", "expected 2 results")
	}
	return ""
}

// ============================================================
// REPL entry-point tests
// ============================================================

// TestParseExprBasic verifies ParseExpr returns the parsed expression
// for a simple binary expression.
func TestParseExprBasic() testing.TestResult {
	var p @Parser = mkParser("1 + 2")
	var e @ast.Expr = p.ParseExpr()
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParseExprBasic", errs[0].Msg)
	}
	if e.Kind != ast.EXPR_BINARY {
		return fail("TestParseExprBasic", "expected EXPR_BINARY")
	}
	return ""
}

// TestParseStmtListSingle parses a single statement until EOF.
func TestParseStmtListSingle() testing.TestResult {
	var p @Parser = mkParser("var x int = 5")
	var ss @[]@ast.Stmt = p.ParseStmtList()
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParseStmtListSingle", errs[0].Msg)
	}
	if len(ss) != 1 {
		return fail("TestParseStmtListSingle", "expected 1 stmt")
	}
	if ss[0].Kind != ast.STMT_DECL {
		return fail("TestParseStmtListSingle", "expected STMT_DECL")
	}
	return ""
}

// TestParseStmtListMultiple parses several statements separated by
// semicolons.  Exercises the inner loop's semi-or-EOF dispatch.
func TestParseStmtListMultiple() testing.TestResult {
	var p @Parser = mkParser("var x int = 5; x = x + 1; x = x * 2")
	var ss @[]@ast.Stmt = p.ParseStmtList()
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParseStmtListMultiple", errs[0].Msg)
	}
	if len(ss) != 3 {
		return fail("TestParseStmtListMultiple", "expected 3 stmts")
	}
	return ""
}

// TestParseTopLevelDeclFunc parses a `func` decl at top level (the
// shape that arrives at the REPL prompt for Tier 2).
func TestParseTopLevelDeclFunc() testing.TestResult {
	var p @Parser = mkParser("func double(x int) int { return x * 2 }")
	var d @ast.Decl = p.ParseTopLevelDecl()
	var errs @[]ParseError = p.Errors()
	if len(errs) != 0 {
		return fail("TestParseTopLevelDeclFunc", errs[0].Msg)
	}
	if d == nil { return fail("TestParseTopLevelDeclFunc", "nil decl") }
	if d.Kind != ast.DECL_FUNC {
		return fail("TestParseTopLevelDeclFunc", "expected DECL_FUNC")
	}
	if !charEq(d.Name, "double") {
		return fail("TestParseTopLevelDeclFunc", "wrong name")
	}
	return ""
}

// TestIsAtTopLevelDecl exercises the REPL dispatch helper for
// each of the four decl-leading keywords plus a couple of
// non-decl shapes.
func TestIsAtTopLevelDecl() testing.TestResult {
	if !mkParser("func foo() {}").IsAtTopLevelDecl() {
		return fail("TestIsAtTopLevelDecl", "expected true for `func`")
	}
	if !mkParser("type T struct { X int }").IsAtTopLevelDecl() {
		return fail("TestIsAtTopLevelDecl", "expected true for `type`")
	}
	if !mkParser("var x int = 5").IsAtTopLevelDecl() {
		return fail("TestIsAtTopLevelDecl", "expected true for `var`")
	}
	if !mkParser("const C int = 5").IsAtTopLevelDecl() {
		return fail("TestIsAtTopLevelDecl", "expected true for `const`")
	}
	if mkParser("println(7)").IsAtTopLevelDecl() {
		return fail("TestIsAtTopLevelDecl", "expected false for ident")
	}
	if mkParser("1 + 2").IsAtTopLevelDecl() {
		return fail("TestIsAtTopLevelDecl", "expected false for int literal")
	}
	if mkParser("").IsAtTopLevelDecl() {
		return fail("TestIsAtTopLevelDecl", "expected false for empty input")
	}
	return ""
}
