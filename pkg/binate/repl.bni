// Package repl is the embeddable Binate REPL engine: it owns the
// cross-turn session state and drives evaluation one host-pushed line
// at a time, leaving all I/O (input source, output sink) and all native
// VM bindings to the host.  A CLI host (cmd/bni), a wasm worker, or a
// test harness each supplies its own ReplIO sink + registerExterns
// callback and drives Init / Step.  Per plan-repl-embeddable.md.
package "pkg/binate/repl"

import "pkg/binate/ast"
import "pkg/binate/vm"

// ReplIO is the host-supplied sink for the REPL's OWN framing output
// (banner, prompts, "package X loaded", parked/resolved announcements,
// and diagnostics).  Routing the engine's print/println through a
// pluggable sink — rather than straight to stdout — is what lets a
// non-CLI host (a wasm worker, a test buffer) redirect it.  Two
// channels: normal output and diagnostics; the CLI wires both to stdout
// (preserving today's behavior), a richer host can split them.  Output
// produced by EVALUATED user code (a typed `println(...)`) is a separate
// concern, out of scope here — it is handled later by injecting package
// implementations, not by this sink.
type ReplIO struct {
	WriteOut @func(*[]readonly char) int // prompts / banner / info
	WriteErr @func(*[]readonly char) int // parse / check / load diagnostics
}

// Kernel is the host-facing handle to a running REPL engine.  It
// is an INTERFACE so an embedder can hold any REPL behind it — the
// production VM-backed engine (kernel, built by NewKernel) or
// a test fake/mock — without depending on the engine's internals.  The
// host drives a session by calling Init once, then Step per host-read
// line, and (optionally) SetPoll to arm cooperative interrupts.
interface Kernel {
	Init() StepResult
	Step(line *[]readonly uint8, eof bool) StepResult
	SetPoll(poll @func() PollResult)
}

// Init runs any pre-prompt initialization, emits its output
// through the sink, and returns the StepResult for the first
// prompt.

// Step feeds ONE host-read line into the session and runs until the
// next prompt is due, returning what the host should render next.
// Multi-line input accumulates until open-bracket depth balances to
// 0; until then Step returns STEP_NEED_MORE.  eof at a turn boundary
// → STEP_EOF_CLEAN; eof mid-accumulation discards the buffered input
// → STEP_EOF_UNBALANCED.

// SetPoll installs the host's cooperative-interrupt delegate.  The
// delegate takes no arguments and returns a PollResult, so it — and
// thus the Kernel interface — carries no dependency on
// pkg/binate/vm.  Reserved for the suspend / break stages; until a
// host sets one, the seam is inert and Step never returns
// STEP_SUSPENDED / STEP_BROKE.

// ReplError is one setup-time error surfaced by NewKernel (a load
// error or a type-check error).  Returning these as VALUES rather than
// printing + exiting the process is what lets a non-CLI host (a wasm
// worker, a test harness) decide how to react.  Just a message for now;
// position / severity can join it without changing the contract.
type ReplError struct {
	Msg @[]char
}

// StepResult is the outcome of Init / Step plus the data the host needs
// to render the NEXT prompt.  The engine never bakes prompt strings:
// Depth (0 ⇒ primary, >0 ⇒ continuation) and Counter (the In[n] index
// for the next input) let the host render however it likes.  Output is
// already flushed through the sink; StepResult carries only control +
// prompt metadata, never the output payload.
type StepResult struct {
	Status  StepStatus
	Counter int
	Depth   int
}

// StepStatus enumerates the control outcomes of Init / Step, carried in
// StepResult.Status.  It is a named type (rather than bare `int`
// constants) so the type checker rejects mixing a status with an
// arbitrary integer.  A later stage adds STEP_SUSPENDED / STEP_BROKE when
// the interrupt seam lands; appending cases is non-breaking.
type StepStatus int

const (
	// STEP_NEED_MORE: input incomplete; the host shows a continuation prompt.
	STEP_NEED_MORE StepStatus = iota
	// STEP_EVALUATED: the turn completed; the host shows the primary prompt.
	STEP_EVALUATED
	// STEP_EOF_CLEAN: input ended at a turn boundary.
	STEP_EOF_CLEAN
	// STEP_EOF_UNBALANCED: input ended mid-accumulation; the buffer was discarded.
	STEP_EOF_UNBALANCED
	// STEP_SUSPENDED: the turn's evaluation was suspended by a host
	// interrupt poll and can be resumed.  Reserved for the suspend stage;
	// v1's poll seam is inert, so Step never returns this yet.
	STEP_SUSPENDED
	// STEP_BROKE: the turn's evaluation was aborted by a host interrupt and
	// unwound to the prompt.  Reserved for the break stage; not produced
	// in v1.
	STEP_BROKE
)

// PollResult is what a host's cooperative-interrupt delegate returns at
// each poll point: keep running, unwind to the prompt, or suspend.  A
// named type (not bare `int`) and VM-free, so the SetPoll contract — and
// thus the Kernel interface — carries no dependency on pkg/binate/vm.
type PollResult int

const (
	// POLL_CONTINUE: keep evaluating.
	POLL_CONTINUE PollResult = iota
	// POLL_BREAK: abort the turn and unwind to the prompt.
	POLL_BREAK
	// POLL_SUSPEND: suspend the turn so it can be resumed.
	POLL_SUSPEND
)

// NewKernel builds a session from already-parsed source files: it
// merges them, loads imports, type-checks (persistently, so the main
// file's scope stays installed for prompt entries), builds the VM, and
// lowers every package plus main.  It ends BEFORE invoking main and
// returns any load / type-check errors as VALUES — the caller (CLI or
// embedding host) decides whether to abort.
//
// Inputs are neutral (no CLIArgs): the host parses the files and
// resolves the root + search paths.  registerExterns is host-injected
// — it installs the VM's externs (the native rt / libc / bootstrap
// bindings, which are host-side and live with the host, not here).
func NewKernel(files @[]@ast.File, root @[]char, bniPaths @[]@[]char, implPaths @[]@[]char,
		io ReplIO, registerExterns @func(@vm.VM)) (@Kernel, @[]ReplError)
