// Package repl is the embeddable Binate REPL engine: it owns the
// cross-turn session state and drives evaluation one host-pushed line
// at a time, leaving all I/O (input source, output sink) and all native
// VM bindings to the host.  A CLI host (cmd/bni), a wasm worker, or a
// test harness each supplies its own ReplIO sink + registerExterns
// callback and drives Init / Step.  Per plan-repl-embeddable.md.
package "pkg/binate/repl"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/loader"
import "pkg/binate/types"
import "pkg/binate/vm"

// ReplIO is the host-supplied sink for the REPL's OWN framing output
// (banner, prompts, "package X loaded", parked/resolved announcements,
// and diagnostics).  Routing the engine's print/println through a
// pluggable sink — rather than straight to stdout — is what lets a
// non-CLI host (a wasm worker, a test buffer) redirect it.  Two
// channels: normal output and diagnostics; the CLI wires both to stdout
// (preserving today's behavior), a richer host can split them.  Output
// produced by EVALUATED user code (a typed `println(...)`) is a separate
// concern, out of scope here — it is handled later by injecting package
// implementations, not by this sink.
type ReplIO struct {
	WriteOut @func(*[]readonly char) int  // prompts / banner / info
	WriteErr @func(*[]readonly char) int  // parse / check / load diagnostics
}

// ReplSession owns all state that persists across REPL turns: the
// constructed-once VM / main module / checker, the per-turn counters
// and the multi-line accumulation buffer, the session loader + search
// paths + processed-package set that mid-session `import` entries
// re-enter the load pipeline with, and the host I/O sink.
//
// Threading this through the engine (rather than holding it in
// package-level globals) is what makes the REPL re-entrant — the host
// can drive one turn at a time against a session value.
//
// v1 keeps ONE live session per process, so the pkg/binate/ir
// process-globals (currentChecker, the import alias map) are still
// shared — see the "remove process-global session state" TODO.  New
// per-session state belongs in this struct, not in new REPL globals.
type ReplSession struct {
	// Constructed once, shared for the session lifetime:
	Vm      @vm.VM
	MainMod @ir.Module
	Chk     @types.Checker
	// Per-turn-persistent.  Accumulated holds the in-progress
	// multi-line input; Counter feeds the __repl_<n> synthetic names:
	Counter     int
	Accumulated @[]uint8
	// Session import state, re-entered by mid-session `import` turns.
	// Ldr holds the transitive package graph + load order; Root +
	// BniPaths are the search config newly-loaded packages reuse;
	// ProcessedPkgs lists package paths already type-checked + IR-gen'd
	// + lowered, so they aren't reprocessed:
	Ldr           @loader.Loader
	Root          @[]char
	BniPaths      @[]@[]char
	ProcessedPkgs @[]@[]char
	// InitCounter feeds unique names into per-prompt var-initializer
	// synthetics so successive `var x = …; var y = …` entries don't
	// collide on one __repl_var_init symbol.
	InitCounter int
	// Io is the host-supplied sink for the engine's framing output.
	Io ReplIO
}

// ReplError is one setup-time error surfaced by NewReplSession (a load
// error or a type-check error).  Returning these as VALUES rather than
// printing + exiting the process is what lets a non-CLI host (a wasm
// worker, a test harness) decide how to react.  Just a message for now;
// position / severity can join it without changing the contract.
type ReplError struct {
	Msg @[]char
}

// StepResult is the outcome of Init / Step plus the data the host needs
// to render the NEXT prompt.  The engine never bakes prompt strings:
// Depth (0 ⇒ primary, >0 ⇒ continuation) and Counter (the In[n] index
// for the next input) let the host render however it likes.  Output is
// already flushed through the sink; StepResult carries only control +
// prompt metadata, never the output payload.
type StepResult struct {
	Status  int
	Counter int
	Depth   int
}

// StepStatus values, carried in StepResult.Status.  (A later stage adds
// STEP_SUSPENDED / STEP_BROKE when the interrupt seam lands; appending
// cases is non-breaking.)
//
// These are individual `const` decls rather than a `const ( ... )`
// group because the tree is linted by the BUILDER's bundled bnlint,
// whose checker predates the bare-iota-member forward-reference fix —
// the group form would fail that lint until a BUILDER carrying the fix
// ships.

// STEP_NEED_MORE: input incomplete; the host shows a continuation prompt.
const STEP_NEED_MORE int = 0
// STEP_EVALUATED: the turn completed; the host shows the primary prompt.
const STEP_EVALUATED int = 1
// STEP_EOF_CLEAN: input ended at a turn boundary.
const STEP_EOF_CLEAN int = 2
// STEP_EOF_UNBALANCED: input ended mid-accumulation; the buffer was discarded.
const STEP_EOF_UNBALANCED int = 3
// STEP_SUSPENDED: the turn's evaluation was suspended by a host interrupt
// poll and can be resumed.  Reserved for the suspend stage; v1's poll
// seam is inert, so Step never returns this yet.
const STEP_SUSPENDED int = 4
// STEP_BROKE: the turn's evaluation was aborted by a host interrupt and
// unwound to the prompt.  Reserved for the break stage; not produced in
// v1.
const STEP_BROKE int = 5

// NewReplSession builds a session from already-parsed source files: it
// merges them, loads imports, type-checks (persistently, so the main
// file's scope stays installed for prompt entries), builds the VM, and
// lowers every package plus main.  It ends BEFORE invoking main and
// returns any load / type-check errors as VALUES — the caller (CLI or
// embedding host) decides whether to abort.
//
// Inputs are neutral (no CLIArgs): the host parses the files and
// resolves the root + search paths.  registerExterns is host-injected
// — it installs the VM's externs (the native rt / libc / bootstrap
// bindings, which are host-side and live with the host, not here).
func NewReplSession(files @[]@ast.File, root @[]char, bniPaths @[]@[]char,
		implPaths @[]@[]char, io ReplIO,
		registerExterns @func(@vm.VM)) (@ReplSession, @[]ReplError)

// Init runs any pre-prompt initialization, emits its output through the
// sink, and returns the StepResult for the first prompt.
func (s @ReplSession) Init() StepResult

// Step feeds ONE host-read line into the session and runs until the next
// prompt is due, returning what the host should render next.  Multi-line
// input accumulates until open-bracket depth balances to 0; until then
// Step returns STEP_NEED_MORE.  eof at a turn boundary → STEP_EOF_CLEAN;
// eof mid-accumulation discards the buffered input → STEP_EOF_UNBALANCED.
func (s @ReplSession) Step(line *[]readonly uint8, eof bool) StepResult

// SetPoll installs the host's cooperative-interrupt delegate on the
// session's VM (see vm.SetPoll).  Reserved for the suspend / break
// stages; until a host sets one, the seam is inert and Step never
// returns STEP_SUSPENDED / STEP_BROKE.
func (s @ReplSession) SetPoll(poll @func(@vm.VM) int)
