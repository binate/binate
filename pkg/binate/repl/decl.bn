package "pkg/binate/repl"

import "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irgen"
import "pkg/binate/types"
import "pkg/binate/vm"

// REPL top-level-decl handling.  `evalReplOneDecl` evaluates one
// declaration typed at the prompt; the entry point `evalReplDecl`
// (decl_group.bn), dispatched from `evalReplLine` when the parser
// reports a top-level declaration, hands it each declaration of the
// entry.  Sibling `retryPending` is called at
// the end of every successful prompt entry to re-attempt parked
// decls whose missing names might have just resolved.
//
// Helpers grouped here:
//   - announceParked / parkedDeclLabel — parked-declaration message
//     formatting (free funcs / vars / consts).
//   - printRedefName — redefinition warning name printer.
//   - isBlankReplName — the blank-name test.
// A variable's initialization (genVarInit / runVarInit) is in decl_var.bn, and
// the load check every declaration's code passes before it is kept
// (loadFails) in load_check.bn.

// evalReplOneDecl handles a single top-level decl typed at the
// prompt: DECL_FUNC, DECL_TYPE, DECL_CONST (single or grouped), and
// DECL_VAR.  On success, the new symbol is persistent in c.Scope.
// Per-kind VM-side work:
//   - func: lower + install on vm.Funcs.  Three cases:
//       * first definition → append.
//       * redefinition with the same signature → REPLACE in place
//         (LowerOneFunc); old callers see the new body.
//       * redefinition with a different signature → SHADOW
//         (LowerOneFuncShadow); funcIndex points at the new
//         entry, old callers' eager-filled CallCache slots keep
//         them routed to the OLD VMFunc (with the old signature).
//   - const: nothing (lookupConst reads moduleConsts directly).
//   - var: materialize the new global on the VM (allocate
//     storage, append name+addr to globalNames/globalAddrs).
// It reports whether d itself was evaluated: false when d fails to check
// or to IR-gen, or its initializer faults or is interrupted.  A declaration
// parked on a name not yet declared, and errors of the parked declarations
// d lets resolve, do not count.
func (s @kernel) evalReplOneDecl(d @ast.Decl) bool {
	var vmInst @vm.VM = s.Vm
	var m @ir.Module = s.MainMod
	var c @check.Checker = s.Chk

	// Capture the pre-check func type so we can decide replace vs
	// shadow after the checker overwrites it.
	//
	//   - Free func: look up the symbol by name in c.Scope.
	//   - Method:    walk d.Recv to its base named type and look up
	//                the method by name on that type's method set.
	//
	// We have to read this BEFORE CheckDeclInScope because the
	// checker (under c.AllowRedef) overwrites the method-set entry
	// in place via SetOrAppendMethod / overwrites the func symbol
	// in c.Scope via defineFunc.
	var oldFuncType @types.Type = nil
	var prevVar @types.Type = s.prevReplVarType(d)
	if d.Kind == ast.DECL_FUNC && d.Recv == nil {
		var existing @check.Symbol = c.Scope().Lookup(d.Name)
		if existing != nil && existing.Kind() == types.SYM_FUNC {
			oldFuncType = existing.Type()
		}
	} else if d.Kind == ast.DECL_FUNC && d.Recv != nil {
		var existing @types.Method = c.LookupMethodForDecl(d)
		if existing != nil { oldFuncType = existing.FuncType }
	}

	var rollback @check.DeclRollback = c.SnapshotDecl(d)
	var prevErrs int = len(c.CheckerErrors())
	c.CheckDeclInScope(d)
	var allErrs @[]types.CheckError = c.CheckerErrors()
	if len(allErrs) > prevErrs {
		for i := prevErrs; i < len(allErrs); i++ {
			s.errln(check.FormatCheckError(allErrs[i]))
		}
		// The declaration is not emitted, so undo what checking it bound.
		c.RollbackDecl(rollback)
		return false
	}
	// Forward references: a declaration that used names not yet declared
	// is parked (it binds nothing) and not emitted.  Announce each one, then
	// retry the parked declarations — this one may complete a group that
	// waits on it (`func f` using g, then `func g` using f).
	//
	// DECL_GROUP is special: group parking is split per-member, so a
	// group can have some members parked and others resolved.
	// Announce each parked member, then fall through to IR-gen
	// — genConstGroup uses the checker's IsPendingDecl to skip
	// the parked members (still incrementing iota for them so
	// resolved members get correct positional values).
	if c.IsDeclPending() {
		for i := c.PendingMark(); i < len(c.Pending()); i++ {
			s.announceParked(c.Pending()[i])
		}
		if d.Kind != ast.DECL_GROUP {
			s.retryPending()
			return true
		}
	}
	var preFuncCount int = len(m.Funcs)
	// A variable redeclared with its own type keeps its global: nothing to
	// register; a global the declaration's names rebind otherwise is shadowed
	// (decl_var.bn).
	var replaced bool = d.Kind == ast.DECL_VAR && s.replVarReplaced(d, prevVar)
	var shadows @[]replShadow
	var msg @[]char
	var entry @irgen.ReplEntry = irgen.BeginReplEntry(s.MainGc)
	if !replaced {
		shadows = s.shadowRebound(d)
		msg = irgen.GenDecl(d, s.MainGc)
	}
	if len(msg) > 0 {
		// A declaration IR-gen does not lower is not emitted, so undo what
		// checking it bound, as for one that fails to check, and what
		// generating it did, as for one that does not load.
		s.errln(msg)
		irgen.UndoReplEntry(s.MainGc, entry)
		s.unshadow(shadows)
		c.RollbackDecl(rollback)
		return false
	}
	// Generate now what the declaration lowers once it is kept — the instances
	// a redefined generic emits again, a variable's initialization — so the load
	// check sees all of it.  A declaration that does not load is not kept.
	var redone @[]@ir.Func = s.reemitRedefined(d, shadows)
	var declGlobal int = len(m.Globals) - 1
	var init replInit
	if d.Kind == ast.DECL_VAR {
		init = s.genVarInit(d, replaced)
	}
	if s.loadFails(preFuncCount, entry, init.Fn, buf.Concat("the initializer of ", d.Name)) {
		s.unshadow(shadows)
		c.RollbackDecl(rollback)
		return false
	}
	s.commitShadows(shadows)
	if d.Kind == ast.DECL_TYPE {
		// A managed-field struct decl emits dtor / copy / field-
		// type helpers via ensureReplStructHelpers.  Lower every
		// new entry so the VM has callable bytecode for them
		// before any subsequent code uses the new type.  Aliases,
		// named non-structs, and structs without managed fields
		// add zero funcs — this loop is a no-op for them.
		for i := preFuncCount; i < len(m.Funcs); i++ {
			vmInst.LowerOneFunc(m, m.Funcs[i])
		}
		// A freshly-resolved type may have unblocked decls parked on its
		// name.
		s.retryPending()
		return true
	}
	if d.Kind == ast.DECL_INTERFACE || d.Kind == ast.DECL_IMPL {
		// Registered in the session module; an impl's destructor helper (if
		// any) is lowered now, and its vtable built now: a vtable's slots are
		// resolved by name when it is built, so building it later would bind
		// a method shadowed in between — a different signature — to it.
		var none @ir.Func
		s.lowerGenerated(preFuncCount, none)
		s.lowerPendingImpls()
		s.retryPending()
		return true
	}
	if d.Kind == ast.DECL_FUNC && d.Recv == nil && isBlankReplName(d.Name) {
		// A blank `func _` binds no name (the checker still checked it) and
		// GenDecl lowers nothing for it.
		return true
	}
	if d.Kind == ast.DECL_FUNC {
		s.lowerReplFunc(d, preFuncCount, oldFuncType, redone)
	}
	var ok bool = true
	if d.Kind == ast.DECL_VAR {
		if !replaced && !isBlankReplName(d.Name) {
			// GenDecl appended exactly one entry to m.Globals (a blank var has
			// no global; its initializer still runs, for its side effects).
			vmInst.MaterializeOneGlobal(m.Globals[declGlobal])
		}
		// Run the initialization right away, so the new global has its
		// declared value before the next prompt entry observes it.
		ok = s.runVarInit(init, d)
	}
	// Forward references: this decl may have bound names that previously-
	// parked decls were waiting on.  Re-attempt each pending
	// entry; for each one that now resolves cleanly, IR-gen +
	// lower it.  Cheap at REPL volumes (parked count is ~0
	// for typical sessions) and safe (a still-unresolved decl
	// stays parked).
	s.retryPending()
	return ok
}

// lowerReplFunc lowers function or method d, which GenDecl just generated
// into the session module from index from: its body is the last function
// appended (after the instantiations and literals generating it appended),
// and those are lowered with it, with the destructor and copy helpers they
// queued (lowerReplFuncIn).  oldFuncType is the signature of the definition d
// replaces (nil for a first definition).
func (s @kernel) lowerReplFunc(d @ast.Decl, from int, oldFuncType @types.Type, redone @[]@ir.Func) {
	var m @ir.Module = s.MainMod
	var body @ir.Func
	if !irgen.IsGenericDecl(d) {
		body = m.Funcs[len(m.Funcs) - 1]
	}
	irgen.EnsureReplBodyHelpers(m)
	s.lowerReplFuncIn(d, from, len(m.Funcs), body, oldFuncType, redone)
}

// lowerReplFuncIn lowers function or method d, for which IR-gen generated the
// session module's functions from index from to to, body among them (nil for a
// generic: lowerReplGeneric).  oldFuncType is the signature of the definition d
// replaces (nil for a first definition).  The same signature replaces that
// definition in place, so its callers run the new body; the body is lowered
// last, so its eager CallCache fill resolves what generating it appended.  A
// different signature shadows it — the old VMFunc keeps its index, so callers
// whose CallCache already resolved it keep calling the old shape — and the body
// is lowered FIRST: what generating it appended (a function literal calling d,
// say) must bind to the new definition, and the body's calls to those
// functions, unresolved until they are lowered, are filled in as each (a fresh
// name) is.  A value-receiver method's interface-dispatch thunk
// (irgen.GenReplRecvThunk) is lowered after it the same way — replaced, or
// shadowed so a vtable built before keeps the old thunk, which calls the old
// method.
func (s @kernel) lowerReplFuncIn(d @ast.Decl, from int, to int, body @ir.Func,
		oldFuncType @types.Type, redone @[]@ir.Func) {
	if irgen.IsGenericDecl(d) {
		s.lowerReplGeneric(d, from, to, oldFuncType, redone)
		return
	}
	var vmInst @vm.VM = s.Vm
	var m @ir.Module = s.MainMod
	var thunk @ir.Func = irgen.GenReplRecvThunk(m, body)
	if oldFuncType == nil || s.sameSignature(d, oldFuncType) {
		s.lowerRange(from, to, body)
		vmInst.LowerOneFunc(m, body)
		if thunk != nil {
			m.AddFunc(thunk)
			vmInst.LowerOneFunc(m, thunk)
		}
		return
	}
	s.out("warning: ")
	s.printRedefName(d)
	s.outln(" shadowed (incompatible signature); existing callers retain old definition")
	vmInst.LowerOneFuncShadow(m, body)
	s.lowerRange(from, to, body)
	if thunk != nil {
		m.AddFunc(thunk)
		vmInst.LowerOneFuncShadow(m, thunk)
	}
}

// lowerReplGeneric lowers what generic function or generic-receiver method d,
// which GenDecl stashed, needs now (lowerReplFuncIn's from, to and
// oldFuncType): GenDecl generated no function, since its instances are emitted
// where they are used, but a redefinition emits again the instances already
// emitted of the declaration it redefines (redone; irgen.ReemitGeneric).  They
// replace the old instances when the signature is the same, and shadow them
// when it differs, as lowerReplFuncIn does for one function.
func (s @kernel) lowerReplGeneric(d @ast.Decl, from int, to int, oldFuncType @types.Type,
		redone @[]@ir.Func) {
	var m @ir.Module = s.MainMod
	if oldFuncType == nil || s.sameSignature(d, oldFuncType) {
		var none @ir.Func
		s.lowerRange(from, to, none)
		return
	}
	s.out("warning: ")
	s.printRedefName(d)
	s.outln(" shadowed (incompatible signature); existing callers retain old definition")
	// The new instances are lowered first, so what generating them added
	// binds to them (see lowerReplFuncIn), and as one group, so one calling
	// another calls the new one.
	s.Vm.LowerFuncsShadow(m, redone)
	for i := from; i < to; i++ {
		var isRedone bool = false
		for j := 0; j < len(redone); j++ {
			if same(m.Funcs[i], redone[j]) { isRedone = true }
		}
		if !isRedone { s.Vm.LowerOneFunc(m, m.Funcs[i]) }
	}
}

// reemitRedefined emits again, for generic function or generic-receiver method
// d, the instances already emitted of the definition it redefines
// (irgen.ReemitGeneric), for lowerReplGeneric — before d is kept, so the load
// check sees them.  A generic function d shadows (shadows: a definition of
// another signature) has none emitted again: IR-gen has forgotten them
// (shadowGenericInstances), and they are emitted from d anew where they are
// used.
func (s @kernel) reemitRedefined(d @ast.Decl, shadows *[]replShadow) @[]@ir.Func {
	var none @[]@ir.Func
	if d.Kind != ast.DECL_FUNC || !irgen.IsGenericDecl(d) || shadowsGeneric(shadows) {
		return none
	}
	return irgen.ReemitGeneric(s.MainGc, d)
}

// sameSignature reports whether function or method d, just checked, has the
// signature oldFuncType (check.SameFuncSignature: a generic function's type
// parameters are compared by position).  A method's type is looked up in its
// receiver type's method set, a free function's in the scope.
func (s @kernel) sameSignature(d @ast.Decl, oldFuncType @types.Type) bool {
	var c @check.Checker = s.Chk
	var newType @types.Type = nil
	if d.Recv != nil {
		var newM @types.Method = c.LookupMethodForDecl(d)
		if newM != nil { newType = newM.FuncType }
	} else {
		var newSym @check.Symbol = c.Scope().Lookup(d.Name)
		if newSym != nil { newType = newSym.Type() }
	}
	return newType != nil && c.SameFuncSignature(oldFuncType, newType)
}

// printRedefName prints the user-facing name for a redefinition
// warning: bare `Name` for a free func, `RecvType.Name` for a
// method.  Helper for the shadow-warning emitter.  Shares
// methodReceiverName's peel logic for the receiver-type-name
// extraction.
func (s @kernel) printRedefName(d @ast.Decl) {
	var recvName @[]char = methodReceiverName(d)
	if len(recvName) > 0 {
		s.out(recvName)
		s.out(".")
	}
	s.out(d.Name)
}

// announceParked prints a one-line "X Y parked (pending: a, b)"
// message for one freshly-parked PendingDecl.  X is the user-
// facing noun (function / variable / constant); Y is the
// decl's name.  Pulled per-decl from `pd.MissingNames`, which
// the type checker populated when this specific decl parked.
// (A DECL_GROUP at the prompt produces zero or more individual
// member PendingDecls — the caller iterates them and calls
// announceParked once each.  Groups are syntactic sugar.)
func (s @kernel) announceParked(pd @types.PendingDecl) {
	s.out(parkedDeclLabel(pd.Decl))
	s.out(" parked (pending: ")
	for i := 0; i < len(pd.MissingNames); i++ {
		if i > 0 { s.out(", ") }
		s.out(pd.MissingNames[i])
	}
	s.outln(")")
}

// parkedDeclLabel returns the "X Y" prefix used in parked /
// resolved messages.  "function f" for free funcs, "method
// T.M" for methods, "variable x" for vars, "constant N" for
// consts, "type T" for type decls.  The method form walks
// d.Recv.Type through pointer / managed / const / paren
// wrappers to find the base named type (mirrors what
// printRedefName does for the shadowing-redefinition warning).
func parkedDeclLabel(d @ast.Decl) @[]char {
	if d.Kind == ast.DECL_VAR {
		return buf.Concat("variable ", d.Name)
	}
	if d.Kind == ast.DECL_CONST {
		return buf.Concat("constant ", d.Name)
	}
	if d.Kind == ast.DECL_TYPE {
		return buf.Concat("type ", d.Name)
	}
	if d.Kind == ast.DECL_INTERFACE {
		return buf.Concat("interface ", d.Name)
	}
	if d.Kind == ast.DECL_IMPL {
		return check.ImplLabel(d)
	}
	if d.Recv != nil {
		var recvName @[]char = methodReceiverName(d)
		if len(recvName) > 0 {
			var qualified @[]char = buf.Concat(recvName, ".")
			qualified = buf.Concat(qualified, d.Name)
			return buf.Concat("method ", qualified)
		}
	}
	return buf.Concat("function ", d.Name)
}

// methodReceiverName returns the base named-type name of a
// method's receiver, peeling pointer / managed / const / paren
// wrappers along the way.  Returns empty if d isn't a method
// or its receiver doesn't end in a named type.  Shared with
// printRedefName (shadowing-redefinition warning) — same peel logic.
func methodReceiverName(d @ast.Decl) @[]char {
	if d.Recv == nil { return "" }
	var rb @ast.TypeExpr = d.Recv.Type
	for rb != nil {
		if rb.Kind == ast.TEXPR_POINTER || rb.Kind == ast.TEXPR_MANAGED || rb.Kind == ast.TEXPR_CONST ||
				rb.Kind == ast.TEXPR_PAREN {
			rb = rb.Base
		} else {
			break
		}
	}
	// A generic type's method: `func (b *Box[T]) M()`.
	if rb != nil && rb.Kind == ast.TEXPR_INSTANTIATE {
		rb = rb.Base
	}
	if rb != nil && rb.Kind == ast.TEXPR_NAMED {
		return rb.Name
	}
	return ""
}

// isBlankReplName returns true for the blank identifier `_`.
// REPL-local mirror of pkg/binate/ir's isBlankName — the blank-init
// case is rare but we skip it to avoid generating a synthetic
// that does nothing.
func isBlankReplName(name *[]readonly char) bool {
	return len(name) == 1 && name[0] == cast(char, 95)
}
