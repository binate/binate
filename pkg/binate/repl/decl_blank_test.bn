package "pkg/binate/repl"

import "pkg/builtins/testing"

// Blank declarations at the prompt bind nothing, like ones in a file: a blank
// `func _` lowers nothing, `_` is never a value, and a blank var's initializer
// still runs.

// Several blank functions are accepted and lower nothing.
func TestReplBlankFuncRepeated() testing.TestResult {
	var s @kernel = setupReplState()
	var before int = len(s.MainMod.Funcs)
	if !execOK(s, "func _() int { return 1 }") || !execOK(s, "func _(x int) int { return x }") {
		return fail("a blank func should be accepted")
	}
	if len(s.MainMod.Funcs) != before {
		return fail("a blank func should lower nothing")
	}
	return ""
}

// A blank function whose body refers to a name not yet declared parks, and
// resolving it lowers nothing.
func TestReplBlankFuncParksThenResolves() testing.TestResult {
	var s @kernel = setupReplState()
	s.Execute(toBytesRT("func _() int { return later() }"))
	if len(s.Chk.Pending()) != 1 {
		return fail("a blank func calling an undeclared function should park")
	}
	if !execOK(s, "func later() int { return 2 }") {
		return fail("declaring the missing function should succeed")
	}
	if len(s.Chk.Pending()) != 0 {
		return fail("the parked blank func should resolve")
	}
	return ""
}

// `_` is not a value at the prompt, even after a blank function.
func TestReplBlankNotAValue() testing.TestResult {
	var s @kernel = setupReplState()
	s.Execute(toBytesRT("func _() int { return 1 }"))
	var r Result = s.Execute(toBytesRT("_()"))
	if r.Status != EXEC_ERROR || !errHas(r, "cannot use _ as a value") {
		return fail("`_()` should report cannot use _ as a value")
	}
	return ""
}

// A blank var's initializer runs (for its side effects) and binds nothing.
func TestReplBlankVarInitRuns() testing.TestResult {
	var s @kernel = setupReplState()
	if !execOK(s, "var n int = 0") || !execOK(s, "func bump() int { n = n + 1; return n }") ||
			!execOK(s, "var _ int = bump()") || !execOK(s, "var _ = bump()") {
		return fail("the declarations should be accepted")
	}
	// Assert on n's value with a statement that panics when it is wrong (the
	// panic aborts the test run, which fails it).
	if !execOK(s, "if n != 2 { panic(\"blank initializers did not run\") }") {
		return fail("both blank initializers should have run (n == 2)")
	}
	return ""
}
