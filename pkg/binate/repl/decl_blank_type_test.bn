package "pkg/binate/repl"

import "pkg/builtins/testing"

// A blank type declaration `type _ …` at the prompt binds no name, like one in a
// file: any number may be entered, its type is still checked, and `_` never
// becomes a type.

// errHas reports whether any of r's diagnostics mentions needle.
func errHas(r Result, needle *[]readonly char) bool {
	for i := 0; i < len(r.Err); i++ {
		if containsSub(r.Err[i].Value, needle) {
			return true
		}
	}
	return false
}

// execOK reports whether executing src at the prompt succeeded cleanly.
func execOK(s @kernel, src *[]readonly char) bool {
	var r Result = s.Execute(toBytesRT(src))
	return r.Status == EXEC_OK && len(r.Err) == 0
}

// Repeated blank types — including several structs with managed fields, and a
// group — are all accepted.
func TestReplBlankTypeRepeated() testing.TestResult {
	var s @kernel = setupReplState()
	if !execOK(s, "type _ int") || !execOK(s, "type _ struct { a int; b @[]char }") ||
			!execOK(s, "type _ struct { c @[]char }") || !execOK(s, "type (\n\t_ bool\n\t_ = int\n)") {
		return fail("a blank type declaration should be accepted")
	}
	return ""
}

// `_` is not a type after a blank type declaration — and a use of it is an
// immediate error, never parked waiting for `_` to be defined.
func TestReplBlankTypeNotAName() testing.TestResult {
	var s @kernel = setupReplState()
	s.Execute(toBytesRT("type _ struct { a int }"))
	var r Result = s.Execute(toBytesRT("var y _"))
	if r.Status != EXEC_ERROR || !errHas(r, "undefined: _") {
		return fail("`var y _` should report undefined: _")
	}
	r = s.Execute(toBytesRT("type T struct { s _ }"))
	if r.Status != EXEC_ERROR || !errHas(r, "undefined: _") {
		return fail("a type using `_` should report undefined: _, not park")
	}
	if s.Chk.IsPendingDecl("T") {
		return fail("a type using `_` must not be parked")
	}
	return ""
}

// A blank type referring to a type not yet declared parks, and resolves once
// that type is declared.
func TestReplBlankTypeParksThenResolves() testing.TestResult {
	var s @kernel = setupReplState()
	s.Execute(toBytesRT("type _ struct { a Later }"))
	if len(s.Chk.Pending()) != 1 {
		return fail("a blank type referring to an undeclared type should park")
	}
	var r Result = s.Execute(toBytesRT("type Later struct { x int }"))
	if r.Status != EXEC_OK || len(r.Err) != 0 {
		return fail("declaring the missing type should succeed")
	}
	if len(s.Chk.Pending()) != 0 {
		return fail("the parked blank type should resolve")
	}
	return ""
}

// A blank struct is checked like a named one: an opaque type held by value is
// rejected.
func TestReplBlankTypeOpaqueByValueRejected() testing.TestResult {
	var s @kernel = setupReplState()
	s.Execute(toBytesRT("type Opq"))
	var r Result = s.Execute(toBytesRT("type _ struct { o Opq }"))
	if r.Status != EXEC_ERROR || !errHas(r, "opaque") {
		return fail("a blank struct holding an opaque type by value should be rejected")
	}
	return ""
}
