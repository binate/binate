package "pkg/binate/repl"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for generic types and methods declared at the prompt: an instance is
// laid out from its type's declaration, and a method of a generic type is
// emitted per instance where an instance's methods are used — a redefinition
// emits the instances already emitted again.  execOK lives in
// decl_blank_type_test.bn, replTurn / noticesIn in decl_retry_test.bn,
// containsSub in decl_test.bn.

// callInt calls the session function name (no arguments) and returns its result.
func callInt(s @kernel, name *[]readonly char) int {
	var noArgs @[]int
	return s.Vm.CallFunc(buf.Concat("main.", name), noArgs)
}

// A generic type naming a type declared after it is laid out with that type
// once it is declared.
func TestReplGenericTypeNamesLaterType() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "type G[T any] struct { v T; w Missing }\n")
	replTurn(s, "type Missing struct { a int; b int }\n")
	if !execOK(s, "func sz() int { return cast(int, sizeof(G[int])) }") {
		return fail("sz must check")
	}
	if !execOK(s, "func fb() int { var g G[int]; g.w.b = 7; return g.w.b }") {
		return fail("fb must check")
	}
	if callInt(s, "sz") != cast(int, 3 * sizeof(int)) {
		return fail("G[int] must hold an int and a Missing")
	}
	if callInt(s, "fb") != 7 { return fail("g.w.b must store") }
	return ""
}

// A method of a generic type declared at the prompt is callable on its
// instances, each instance with its own body.
func TestReplGenericMethodCalled() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "type Cur[T any] struct { v T }\n")
	replTurn(s, "func (c *Cur[T]) Get() T { return c.v }\n")
	if len(s.curErrs) != 0 { return fail("Get must check") }
	if !execOK(s, "func gi() int { var c Cur[int]; c.v = 9; return c.Get() }") ||
			!execOK(s, "func gb() bool { var c Cur[bool]; c.v = true; return c.Get() }") ||
			!execOK(s, "func gbi() int { if gb() { return 1 }; return 0 }") {
		return fail("the uses must check")
	}
	if callInt(s, "gi") != 9 || callInt(s, "gbi") != 1 { return fail("each instance must run Get") }
	return ""
}

// A same-signature redefinition replaces the instances already emitted, so
// their callers run the new body.
func TestReplGenericMethodRedefinedReplaces() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "type Cur[T any] struct { v T }\n")
	replTurn(s, "func (c *Cur[T]) Get() T { return c.v }\n")
	replTurn(s, "var cc Cur[int]\n")
	if !execOK(s, "func probe() int { cc.v = 4; return cc.Get() }") { return fail("probe must check") }
	if callInt(s, "probe") != 4 { return fail("probe must run the first Get") }
	replTurn(s, "func (c *Cur[T]) Get() T { var z T; return z }\n")
	if len(s.curErrs) != 0 { return fail("the redefinition must check") }
	if containsSub(noticesIn(s), "shadowed") { return fail("a replacement is not a shadow") }
	if callInt(s, "probe") != 0 { return fail("probe must run the redefined Get") }
	return ""
}

// An incompatible redefinition shadows the instances already emitted: their
// callers keep the old body, and new callers use the new signature.
func TestReplGenericMethodRedefinedShadows() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "type Cur[T any] struct { v T }\n")
	replTurn(s, "func (c *Cur[T]) Get() T { return c.v }\n")
	replTurn(s, "var cc Cur[int]\n")
	if !execOK(s, "func probe() int { cc.v = 4; return cc.Get() }") { return fail("probe must check") }
	if callInt(s, "probe") != 4 { return fail("probe must run the first Get") }
	replTurn(s, "func (c *Cur[T]) Get(k int) int { return k + 10 }\n")
	if !containsSub(noticesIn(s), "warning: Cur.Get shadowed (incompatible signature)") {
		return fail(buf.Concat("the shadow must be reported; notices:\n", noticesIn(s)))
	}
	if !execOK(s, "func probe2() int { return cc.Get(10) }") { return fail("probe2 must check") }
	if callInt(s, "probe") != 4 { return fail("probe must keep the old Get") }
	if callInt(s, "probe2") != 20 { return fail("probe2 must run the new Get") }
	if execOK(s, "func probe3() int { return cc.Get() }") {
		return fail("the old shape must be rejected")
	}
	return ""
}

// A variable whose type is inferred as an instance of a generic type declared
// at the prompt has that type.
func TestReplInferredGenericInstanceVar() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "type Box[T any] struct { v T }\n")
	replTurn(s, "func mk() Box[int] { var x Box[int]; x.v = 7; return x }\n")
	if !execOK(s, "var bx = mk()") { return fail("bx must be emitted") }
	if !execOK(s, "func rd() int { return bx.v }") { return fail("rd must check") }
	if callInt(s, "rd") != 7 { return fail("bx must hold mk's Box[int]") }
	return ""
}

// An incompatible redefinition calling the method on another instance emitted
// before it calls that instance's new definition, whichever is emitted first.
func TestReplGenericMethodShadowCallsNewInstances() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "type Cur[T any] struct { v T }\n")
	replTurn(s, "func (c *Cur[T]) Get() T { return c.v }\n")
	if !execOK(s,
			"func f1() int { var a Cur[int]; var b Cur[uint16]; b.v = 4; "
					"return a.Get() + cast(int, b.Get()) }") {
		return fail("f1 must check")
	}
	if callInt(s, "f1") != 4 { return fail("f1 must run the first Get") }
	replTurn(s,
			"func (c *Cur[T]) Get(k int) int { "
					"if k > 0 { var o Cur[uint16]; return o.Get(k - 1) + 100 }; return 7 }\n")
	if !execOK(s, "func f2() int { var a Cur[int]; return a.Get(1) }") { return fail("f2 must check") }
	if callInt(s, "f2") != 107 { return fail("Cur[int].Get must call the new Cur[uint16].Get") }
	return ""
}

// An incompatible redefinition whose body uses an instance not emitted before
// it emits that instance's method as a new function, which the redefined
// instances' calls reach.
func TestReplGenericMethodShadowEmitsNewInstance() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "type Cur[T any] struct { v T }\n")
	replTurn(s, "func (c *Cur[T]) Get() T { return c.v }\n")
	if !execOK(s, "func f1() int { var a Cur[int]; a.v = 3; return a.Get() }") {
		return fail("f1 must check")
	}
	if callInt(s, "f1") != 3 { return fail("f1 must run the first Get") }
	replTurn(s,
			"func (c *Cur[T]) Get(k int) T { "
					"var o Cur[uint32]; if k > 0 { _ = o.Get(k - 1) }; return c.v }\n")
	if !execOK(s, "func f2() int { var a Cur[int]; a.v = 5; return a.Get(2) }") {
		return fail("f2 must check")
	}
	if callInt(s, "f2") != 5 { return fail("the new Get must run, through the new Cur[uint32].Get") }
	return ""
}

// A method of a generic type that parks is emitted per instance once it
// resolves, and a redefinition that parks and resolves replaces the instances
// emitted before it.
func TestReplParkedGenericMethodResolves() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "type Cur[T any] struct { v T }\n")
	replTurn(s, "func (c *Cur[T]) Get() T { zz(); return c.v }\n")
	if !s.Chk.IsPendingDecl("Cur.Get") { return fail("Get must park on zz") }
	replTurn(s, "func zz() {}\n")
	if !execOK(s, "func f1() int { var a Cur[int]; a.v = 6; return a.Get() }") {
		return fail("f1 must check once Get resolves")
	}
	if callInt(s, "f1") != 6 { return fail("the resolved Get must run") }
	replTurn(s, "func (c *Cur[T]) Get() T { yy(); var z T; return z }\n")
	replTurn(s, "func yy() {}\n")
	if callInt(s, "f1") != 0 { return fail("f1 must run the redefined Get once it resolves") }
	return ""
}

// A generic type of a non-struct underlying type declared at the prompt is
// instantiated where it is used (gen.instantiate.type), with its methods; a
// managed one holding managed elements is released.
func TestReplGenericNonStructType() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "type Pair[T any] [2]T\n")
	replTurn(s, "func (p Pair[T]) Second() T { return p[1] }\n")
	replTurn(s, "type L[T any] @[]T\n")
	if len(s.curErrs) != 0 { return fail("the declarations must check") }
	if !execOK(s, "func ps() int { var p Pair[int]; p[1] = 4; return p.Second() }") ||
			!execOK(s,
					"func ln() int { var l L[@[]char] = make_slice(@[]char, 3); "
							"l[0] = make_slice(char, 2); return len(l) + len(l[0]) }") {
		return fail("the uses must check")
	}
	if callInt(s, "ps") != 4 { return fail("Pair[int].Second must return p[1]") }
	if callInt(s, "ln") != 5 { return fail("L[@[]char] must hold its elements") }
	return ""
}

// A generic function declared at the prompt is instantiated where it is used,
// also over a generic type declared at the prompt.
func TestReplGenericFuncCalled() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "func id[T any](x T) T { return x }\n")
	replTurn(s, "type Cur[T any] struct { v T }\n")
	replTurn(s, "func gen[T any](x T) T { var c Cur[T]; c.v = x; return c.v }\n")
	if len(s.curErrs) != 0 { return fail("gen must check") }
	if !execOK(s, "func f1() int { return id[int](3) + cast(int, gen[uint8](9)) }") {
		return fail("f1 must check")
	}
	if callInt(s, "f1") != 12 { return fail("id[int] and gen[uint8] must run") }
	return ""
}

// A same-signature redefinition — its type parameters renamed or not —
// replaces the instances emitted before it: their callers run the new body.
func TestReplGenericFuncRedefinedReplaces() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "func id[T any](x T) T { return x }\n")
	if !execOK(s, "func f1() int { return id[int](5) }") { return fail("f1 must check") }
	if callInt(s, "f1") != 5 { return fail("f1 must run the first id") }
	replTurn(s, "func id[U any](y U) U { var z U; return z }\n")
	if len(s.curErrs) != 0 { return fail("the redefinition must check") }
	if containsSub(noticesIn(s), "shadowed") { return fail("a replacement is not a shadow") }
	if callInt(s, "f1") != 0 { return fail("f1 must run the redefined id") }
	return ""
}

// An incompatible redefinition shadows the instances emitted before it: their
// callers keep the old body, and new callers use the new signature.
func TestReplGenericFuncRedefinedShadows() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "func id[T any](x T) T { return x }\n")
	if !execOK(s, "func f1() int { return id[int](5) }") { return fail("f1 must check") }
	if callInt(s, "f1") != 5 { return fail("f1 must run the first id") }
	replTurn(s, "func id[T any](x T, k int) int { return k }\n")
	if !containsSub(noticesIn(s), "warning: id shadowed (incompatible signature)") {
		return fail(buf.Concat("the shadow must be reported; notices:\n", noticesIn(s)))
	}
	if !execOK(s, "func f2() int { return id[int](4, 8) }") { return fail("f2 must check") }
	if callInt(s, "f1") != 5 { return fail("f1 must keep the old id") }
	if callInt(s, "f2") != 8 { return fail("f2 must run the new id") }
	return ""
}

// A generic function's name rebound by a non-generic function, or a variable,
// shadows its instances: a generic function declared under the name later
// emits its own, whatever its signature.
func TestReplGenericFuncRebindingShadowsInstances() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "func f[T any](x T) T { return x }\n")
	if !execOK(s, "func f1() int { return f[int](5) }") { return fail("f1 must check") }
	if callInt(s, "f1") != 5 { return fail("f1 must run the first f") }
	replTurn(s, "func f(x int) int { return x + 100 }\n")
	replTurn(s, "func f[T any](x T, k int) int { return k }\n")
	if !execOK(s, "func f2() int { return f[int](4, 8) }") { return fail("f2 must check") }
	if callInt(s, "f2") != 8 { return fail("f2 must run the last f, not the first f's instance") }
	replTurn(s, "var f int = 7\n")
	replTurn(s, "func f[T any](x T, k int) int { return k * 2 }\n")
	if !execOK(s, "func f3() int { return f[int](4, 8) }") { return fail("f3 must check") }
	if callInt(s, "f3") != 16 || callInt(s, "f2") != 8 || callInt(s, "f1") != 5 {
		return fail("each caller must keep the instance it was emitted with")
	}
	return ""
}

// A generic function's name rebound to a variable is the variable: indexing and
// calling it calls the value.
func TestReplGenericFuncReboundToVariable() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "func f[T any](x T) T { return x }\n")
	if !execOK(s, "func f1() int { return f[int](3) }") { return fail("f1 must check") }
	replTurn(s, "func dbl(x int) int { return x * 2 }\n")
	replTurn(s, "var f @[]*func(int) int = make_slice(*func(int) int, 1)\n")
	if !execOK(s, "f[0] = dbl") { return fail("f[0] must be assigned") }
	if !execOK(s, "func f2() int { return f[0](5) }") { return fail("f2 must check") }
	if callInt(s, "f2") != 10 || callInt(s, "f1") != 3 {
		return fail("f2 must call the value, f1 the instance")
	}
	return ""
}

// A constant-group member that parks binds nothing, so a later same-signature
// redefinition of the generic function of its name still replaces its instances.
func TestReplGenericFuncNotShadowedByParkedGroupMember() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "func f[T any](x T) T { return x }\n")
	if !execOK(s, "func f1() int { return f[int](5) }") { return fail("f1 must check") }
	replTurn(s, "const ( f = k; z = 1 )\n")
	replTurn(s, "func f[T any](x T) T { var q T; return q }\n")
	if callInt(s, "f1") != 0 { return fail("f1 must run the redefined f") }
	return ""
}

// Shadowing a generic function leaves the instances of one whose name extends
// its own with the instantiation marker's leading characters.
func TestReplGenericFuncShadowKeepsLookalike() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "func f__bn_inst[T any](x T) T { return x }\n")
	if !execOK(s, "func f1() int { return f__bn_inst[int](5) }") { return fail("f1 must check") }
	replTurn(s, "func f[T any](x T) T { return x }\n")
	if !execOK(s, "func f2() int { return f[int](1) }") { return fail("f2 must check") }
	replTurn(s, "var f int = 2\n")
	replTurn(s, "func f__bn_inst[T any](x T) T { var z T; return z }\n")
	if callInt(s, "f1") != 0 { return fail("f1 must run the redefined f__bn_inst") }
	return ""
}
