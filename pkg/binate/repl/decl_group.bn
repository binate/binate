package "pkg/binate/repl"

import "pkg/binate/ast"

// promptDeclUnits returns the declarations a prompt entry d is evaluated as:
// the members of a `type ( ... )` or `var ( ... )` group — pure syntax, so each
// is declared as if typed on its own (the prompt's per-declaration type and
// global machinery handles one declaration at a time) — and otherwise d itself
// (a const group stays whole: iota numbers its members).
func promptDeclUnits(d @ast.Decl) @[]@ast.Decl {
	if d.Kind == ast.DECL_GROUP && len(d.Decls) > 0 {
		var splittable bool = true
		for i := 0; i < len(d.Decls); i++ {
			var k int = d.Decls[i].Kind
			if k != ast.DECL_TYPE && k != ast.DECL_VAR { splittable = false }
		}
		if splittable {
			var units @[]@ast.Decl = make_slice(@ast.Decl, len(d.Decls))
			for i := 0; i < len(d.Decls); i++ {
				units[i] = d.Decls[i]
			}
			return units
		}
	}
	var one @[]@ast.Decl = make_slice(@ast.Decl, 1)
	one[0] = d
	return one
}

// evalReplDecl evaluates a top-level declaration entered at the prompt — a
// type or var group member by member (promptDeclUnits), each as if entered on
// its own, so a member that fails (evalReplOneDecl) ends the group, as an
// entry that fails ends its unit — and reports whether every member was
// evaluated.
func (s @kernel) evalReplDecl(d @ast.Decl) bool {
	if d == nil { return true }
	var units @[]@ast.Decl = promptDeclUnits(d)
	for i := 0; i < len(units); i++ {
		if !s.evalReplOneDecl(units[i]) { return false }
	}
	return true
}
