package "pkg/binate/repl"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for decl_group.bn.

// declOf returns a bare declaration of the given kind.
func declOf(kind int) @ast.Decl {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = kind
	return d
}

// groupOf returns a group holding a and b.
func groupOf(a @ast.Decl, b @ast.Decl) @ast.Decl {
	var g @ast.Decl = declOf(ast.DECL_GROUP)
	var members @[]@ast.Decl = make_slice(@ast.Decl, 2)
	members[0] = a
	members[1] = b
	g.Decls = members
	return g
}

// A type or var group is evaluated member by member.
func TestPromptDeclUnitsSplitsTypeAndVarGroups() testing.TestResult {
	var t1 @ast.Decl = declOf(ast.DECL_TYPE)
	var t2 @ast.Decl = declOf(ast.DECL_TYPE)
	var units @[]@ast.Decl = promptDeclUnits(groupOf(t1, t2))
	if len(units) != 2 || !same(units[0], t1) || !same(units[1], t2) {
		return fail("expected the type group's two members, in order")
	}
	var v1 @ast.Decl = declOf(ast.DECL_VAR)
	units = promptDeclUnits(groupOf(v1, declOf(ast.DECL_VAR)))
	if len(units) != 2 || !same(units[0], v1) { return fail("expected the var group's members") }
	return ""
}

// A const group stays whole (iota numbers its members); a single decl is
// itself.
func TestPromptDeclUnitsKeepsConstGroupAndSingle() testing.TestResult {
	var cg @ast.Decl = groupOf(declOf(ast.DECL_CONST), declOf(ast.DECL_CONST))
	var units @[]@ast.Decl = promptDeclUnits(cg)
	if len(units) != 1 || !same(units[0], cg) { return fail("the const group should stay whole") }
	var f @ast.Decl = declOf(ast.DECL_FUNC)
	units = promptDeclUnits(f)
	if len(units) != 1 || !same(units[0], f) { return fail("a single decl should be itself") }
	return ""
}
