package "pkg/binate/repl"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/builtins/testing"

// Tests for interface and `impl` declarations at the prompt (decl.bn, irgen
// gen_repl_iface.bn).  setupReplState / fail live in testsupport_test.bn;
// replTurn / noticesIn in decl_retry_test.bn; replPromptRejected in
// failed_prompt_test.bn; moduleHasFunc / containsSub in decl_test.bn.

// An interface and an impl declared at the prompt: a value boxed into the
// interface dispatches its method, in a statement and in a function.
func TestReplInterfaceImplDispatch() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "interface Sizer { Size() int }\n")
	replTurn(s, "type Box struct { n int }\n")
	replTurn(s, "func (b *Box) Size() int { return b.n }\n")
	replTurn(s, "impl *Box : Sizer\n")
	if len(s.curErrs) != 0 {
		return fail(s.curErrs[0].Value)
	}
	replTurn(s, "var b Box\n")
	replTurn(s, "var s *Sizer = &b\n")
	replTurn(s, "var n int = s.Size()\n")
	replTurn(s, "func total(x *Sizer) int { return x.Size() + 1 }\n")
	replTurn(s, "var m int = total(&b)\n")
	if len(s.curErrs) != 0 {
		return fail(s.curErrs[0].Value)
	}
	return ""
}

// An impl whose type lacks a method of the interface parks on it, and
// resolves when the method is declared; a method of the wrong signature is an
// error.
func TestReplImplParksOnMethod() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "interface Sizer { Size() int }\n")
	replTurn(s, "type Box struct { n int }\n")
	replTurn(s, "impl *Box : Sizer\n")
	if !containsSub(noticesIn(s), "impl *Box : Sizer parked (pending: Box.Size)") {
		return fail(buf.Concat("the impl must park on Box.Size; notices:\n", noticesIn(s)))
	}
	replTurn(s, "func (b *Box) Size() int { return b.n }\n")
	if !containsSub(noticesIn(s), "impl *Box : Sizer resolved") {
		return fail(buf.Concat("the impl must resolve; notices:\n", noticesIn(s)))
	}
	replTurn(s, "type Other struct { n int }\n")
	replTurn(s, "func (o *Other) Size() bool { return true }\n")
	if !replPromptRejected(s, "impl *Other : Sizer\n") {
		return fail("an impl whose method has the wrong signature must be rejected")
	}
	return ""
}

// A type or interface is not redefined at the prompt, whichever kind it
// was.
func TestReplInterfaceRedefinitionRejected() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "interface Sizer { Size() int }\n")
	replTurn(s, "type Box struct { n int }\n")
	if !replPromptRejected(s, "interface Sizer { Other() int }\n") {
		return fail("an interface redefinition must be rejected")
	}
	if !replPromptRejected(s, "type Sizer int\n") {
		return fail("a type over an interface must be rejected")
	}
	if !replPromptRejected(s, "interface Box { M() }\n") {
		return fail("an interface over a type must be rejected")
	}
	return ""
}

// The destructor a box of an impl's receiver runs from its vtable's slot 0 —
// for a named managed slice, a structural helper — is emitted when the impl
// is declared, so a vtable built before the first box has it.
func TestReplImplBoxDtorEmitted() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "interface Sizer { Size() int }\n")
	replTurn(s, "type MS @[]int\n")
	replTurn(s, "func (m MS) Size() int { return len(m) }\n")
	replTurn(s, "impl MS : Sizer\n")
	var m @ir.Module = s.MainMod
	for i := 0; i < len(m.Impls); i++ {
		if seq(m.Impls[i].RecvTypeName, "MS") && seq(m.Impls[i].IfaceName, "Sizer") {
			if len(m.Impls[i].DtorFuncName) == 0 {
				return fail("the MS row must name a slot-0 destructor")
			}
			if !moduleHasFunc(m, m.Impls[i].DtorFuncName) {
				return fail("the slot-0 destructor must be emitted with the impl")
			}
			return ""
		}
	}
	return fail("no (MS, Sizer) impl row")
}

// A box of a read-only object recovers only as read-only (spec
// iface.assert.readonly) for a type and impls declared at the prompt: the impl
// rows' readonly variants get VM vtables and satisfaction entries with the rows.
// A wrong result panics, which aborts the test run.
func TestReplReadonlyBoxRecovery() testing.TestResult {
	var s @kernel = setupReplState()
	if !execOK(s, "interface Getter { Get() int }") || !execOK(s, "interface Setter { Set(v int) }") ||
			!execOK(s, "type S struct { n int }") ||
			!execOK(s, "func (s *readonly S) Get() int { return s.n }") ||
			!execOK(s, "func (s *S) Set(v int) { s.n = v }") || !execOK(s, "impl *readonly S : Getter") ||
			!execOK(s, "impl *S : Setter") {
		return fail("the declarations should be accepted")
	}
	if !execOK(s, "var rs readonly S") || !execOK(s, "var x *any = &rs") || !execOK(s, "var ok bool") {
		return fail("the readonly box should be accepted")
	}
	if !execOK(s, "_, ok = x.(*S)") ||
			!execOK(s, "if ok { panic(\"a readonly box recovered as *S\") }") {
		return fail("the mutable recovery should run")
	}
	if !execOK(s, "_, ok = x.(*readonly S)") ||
			!execOK(s, "if !ok { panic(\"a readonly box missed *readonly S\") }") {
		return fail("the readonly recovery should run")
	}
	if !execOK(s, "_, ok = x.(*Getter)") ||
			!execOK(s, "if !ok { panic(\"a readonly box missed *Getter\") }") {
		return fail("the read-only interface recovery should run")
	}
	if !execOK(s, "_, ok = x.(*Setter)") ||
			!execOK(s, "if ok { panic(\"a readonly box recovered as *Setter\") }") {
		return fail("the mutating interface recovery should run")
	}
	return ""
}

// `Self` as a type argument in an interface's method satisfies a constraint the
// interface extends (spec iface.self.constraint), and not one it does not.
func TestReplSelfTypeArgConstraint() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "interface Ord { Cmp(o Self) int }\n")
	replTurn(s, "type Box[T Ord] struct { v T }\n")
	replTurn(s, "interface I : Ord { Put(b *Box[Self]) int }\n")
	if len(s.curErrs) != 0 {
		return fail(s.curErrs[0].Value)
	}
	if !replPromptRejected(s, "interface J { Put(b *Box[Self]) int }\n") {
		return fail("Box[Self] in an interface that does not extend Ord must be rejected")
	}
	return ""
}

// In a generic interface, `Self` is judged with the interface's type parameters
// abstract: G0 extends Eq[U], not Eq[int].
func TestReplSelfTypeArgGenericInterface() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "interface Eq[T any] { Equal(o T) bool }\n")
	replTurn(s, "type B[T Eq[int]] struct { v T }\n")
	if !replPromptRejected(s, "interface G0[U any] : Eq[U] { Put(b *B[Self]) int }\n") {
		return fail("Self in G0, which does not extend Eq[int], must be rejected")
	}
	replTurn(s, "interface G1[U any] : Eq[int] { Put(b *B[Self]) U }\n")
	if len(s.curErrs) != 0 {
		return fail(s.curErrs[0].Value)
	}
	return ""
}

// A generic interface parked on a parent not yet declared is checked when it
// resolves as it would have been at once: `*B[*U]` for `type B[T Eq[int]]` is
// rejected once K is declared, and the declaration stays parked through later
// retries, which check it again.
func TestReplParkedGenericInterfaceChecked() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "interface Eq[T any] { Equal(o T) bool }\n")
	replTurn(s, "type B[T Eq[int]] struct { v T }\n")
	replTurn(s, "interface H[U any] : K { Put(b *B[*U]) int }\n")
	if !containsSub(noticesIn(s), "interface H parked (pending: K)") {
		return fail(buf.Concat("H must park on K; notices:\n", noticesIn(s)))
	}
	replTurn(s, "interface K {}\n")
	if len(s.curErrs) == 0 ||
			!containsSub(s.curErrs[0].Value, "type argument *U does not satisfy constraint Eq[int]") {
		return fail(
				buf.Concat("the retried H must report *U's constraint miss; notices:\n", noticesIn(s)))
	}
	// A failed retry that reports what it reported before prints nothing: what
	// shows that it was checked again is that H does not resolve.
	replTurn(s, "type Other struct { n int }\n")
	if containsSub(noticesIn(s), "interface H resolved") {
		return fail(buf.Concat("H must stay unresolved on a later retry; notices:\n", noticesIn(s)))
	}
	return ""
}

// The same for `Self` as a type argument: a parked generic interface that
// reaches the constraint through K resolves once K is declared extending it,
// and one whose K does not is rejected.
func TestReplParkedGenericInterfaceSelf() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "interface Eq[T any] { Equal(o T) bool }\n")
	replTurn(s, "type B[T Eq[int]] struct { v T }\n")
	replTurn(s, "interface G[U any] : K { Put(b *B[Self]) int }\n")
	replTurn(s, "interface K : Eq[int] {}\n")
	if len(s.curErrs) != 0 { return fail(s.curErrs[0].Value) }
	if !containsSub(noticesIn(s), "interface G resolved") {
		return fail(buf.Concat("G must resolve; notices:\n", noticesIn(s)))
	}
	replTurn(s, "interface G2[U any] : K2 { Put(b *B[Self]) int }\n")
	replTurn(s, "interface K2 {}\n")
	if len(s.curErrs) == 0 ||
			!containsSub(s.curErrs[0].Value, "(interface G2[U] does not extend Eq[int])") {
		return fail(
				buf.Concat("the retried G2 must report Self's constraint miss; notices:\n", noticesIn(s)))
	}
	return ""
}
