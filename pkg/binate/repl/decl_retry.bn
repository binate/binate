package "pkg/binate/repl"

import "pkg/binate/ast"
import "pkg/binate/check"
import "pkg/binate/ir"
import "pkg/binate/irgen"
import "pkg/binate/types"
import "pkg/binate/vm"

// Retrying parked declarations after each declaring prompt entry: a group of
// parked declarations whose missing names are now declared is emitted; one
// that then fails to check stays parked and its errors are shown.

// retryPending checks the parked declarations again (RetryPendingDecls) and
// handles each group it checked, dependencies first: a resolved group is
// announced and emitted, a failed one reported when its errors are new.
func (s @kernel) retryPending() {
	var retried @[]@types.RetriedDecl = s.Chk.RetryPendingDecls()
	var i int = 0
	for i < len(retried) {
		var j int = i
		for j < len(retried) && retried[j].Group == retried[i].Group {
			j = j + 1
		}
		if retried[i].Resolved {
			s.emitResolvedGroup(retried[i:j])
		} else {
			s.reportFailedGroup(retried[i:j])
		}
		i = j
	}
}

// reportFailedGroup shows the errors of a group of parked declarations that
// failed to check once their missing names were declared, and that they stay
// parked.  A group failing again with the same errors is not reported again.
func (s @kernel) reportFailedGroup(group *[]@types.RetriedDecl) {
	if len(group[0].Errs) == 0 { return }
	for i := 0; i < len(group[0].Errs); i++ {
		s.errln(check.FormatCheckError(group[0].Errs[i]))
	}
	for i := 0; i < len(group); i++ {
		s.out(parkedDeclLabel(group[i].Decl))
		s.outln(" still parked (it does not check)")
	}
}

// emitResolvedGroup announces and emits a group of parked declarations that
// resolved together.  Resolved declarations are first definitions to IR-gen
// (nothing was emitted while they were parked), emitted by kind so each
// kind's dependencies come first: the types and interfaces (GenTypeDecls
// registers the structs and interfaces before building any struct), the
// impls' rows (a function boxing into one of their interfaces needs its row),
// the constants, the functions and methods — those that redefine a function
// first, so a member that calls one binds to the new definition — then the
// impls' vtables, and the variables, all materialized before any
// initializer runs, initializers in dependency order (the checker's order).
func (s @kernel) emitResolvedGroup(group *[]@types.RetriedDecl) {
	var vmInst @vm.VM = s.Vm
	var m @ir.Module = s.MainMod
	for i := 0; i < len(group); i++ {
		s.out(parkedDeclLabel(group[i].Decl))
		s.outln(" resolved")
	}
	var typeDecls @[]@ast.Decl = make_slice(@ast.Decl, len(group))
	var nTypes int = 0
	for i := 0; i < len(group); i++ {
		if group[i].Decl.Kind == ast.DECL_TYPE || group[i].Decl.Kind == ast.DECL_INTERFACE {
			typeDecls[nTypes] = group[i].Decl
			nTypes = nTypes + 1
		}
	}
	if nTypes > 0 {
		var preFuncCount int = len(m.Funcs)
		var msg @[]char = irgen.GenTypeDecls(typeDecls[:nTypes], s.MainGc)
		if len(msg) > 0 {
			s.errln(msg)
			return
		}
		// A managed-field struct adds destructor / copy helpers.
		for k := preFuncCount; k < len(m.Funcs); k++ {
			vmInst.LowerOneFunc(m, m.Funcs[k])
		}
	}
	// The impls' rows are registered before the functions are generated: a
	// function of the group boxing into one of their interfaces finds its row.
	for i := 0; i < len(group); i++ {
		if group[i].Decl.Kind == ast.DECL_IMPL {
			s.genResolvedDecl(group[i].Decl)
		}
	}
	for i := 0; i < len(group); i++ {
		var rd @types.RetriedDecl = group[i]
		if rd.Decl.Kind != ast.DECL_CONST { continue }
		if rd.IotaIdx >= 0 {
			// A const-group member: GenConstMember takes its iota position
			// (GenDecl would fold a bare DECL_CONST at iota 0).
			s.warnShadows(s.shadowRebound(rd.Decl))
			irgen.GenConstMember(rd.Decl, s.MainGc, rd.IotaIdx)
		} else {
			s.genRebinding(rd.Decl)
		}
	}
	for pass := 0; pass < 2; pass++ {
		for i := 0; i < len(group); i++ {
			var rd @types.RetriedDecl = group[i]
			if rd.Decl.Kind != ast.DECL_FUNC || (rd.PrevFunc != nil) != (pass == 0) { continue }
			s.emitResolvedFunc(rd)
		}
	}
	// The impls' vtables are built after the methods (and dispatch thunks)
	// they name are lowered (see evalReplOneDecl), and after the destructor
	// helpers the impls queued (drained here, if no function drained them).
	var none @ir.Func
	s.lowerGenerated(len(m.Funcs), none)
	s.lowerPendingImpls()
	var preGlobalCount int = len(m.Globals)
	var replaced @[]bool = make_slice(bool, len(group))
	for i := 0; i < len(group); i++ {
		if group[i].Decl.Kind == ast.DECL_VAR {
			// A variable redeclared with its own type keeps its global (decl_var.bn).
			replaced[i] = s.replVarReplaced(group[i].Decl, group[i].PrevVar)
			if !replaced[i] {
				s.genRebinding(group[i].Decl)
			}
		}
	}
	for g := preGlobalCount; g < len(m.Globals); g++ {
		vmInst.MaterializeOneGlobal(m.Globals[g])
	}
	for i := 0; i < len(group); i++ {
		// A blank var (`var _ T = expr`) has no global but still runs its
		// initializer for its side effects.
		if group[i].Decl.Kind == ast.DECL_VAR {
			s.initReplVar(group[i].Decl, replaced[i])
		}
	}
}

// emitResolvedFunc IR-gens and lowers a resolved function or method,
// replacing or shadowing the definition it redefines (rd.PrevFunc) as a
// redefinition typed at the prompt does.  A blank `func _` lowers nothing.
func (s @kernel) emitResolvedFunc(rd @types.RetriedDecl) {
	var m @ir.Module = s.MainMod
	var preFuncCount int = len(m.Funcs)
	if !s.genRebinding(rd.Decl) { return }
	if rd.Decl.Recv == nil && isBlankReplName(rd.Decl.Name) { return }
	s.lowerReplFunc(rd.Decl, preFuncCount, rd.PrevFunc)
}

// genRebinding IR-gens resolved declaration d as genResolvedDecl does, first
// shadowing a global variable its names rebind (decl_var.bn) — reported once d
// is emitted, given its name back if d is not.
func (s @kernel) genRebinding(d @ast.Decl) bool {
	var shadows @[]replShadow = s.shadowRebound(d)
	if !s.genResolvedDecl(d) {
		s.unshadow(shadows)
		return false
	}
	s.warnShadows(shadows)
	return true
}

// genResolvedDecl IR-gens resolved declaration d, reporting a declaration
// IR-gen does not support; reports whether it succeeded.
func (s @kernel) genResolvedDecl(d @ast.Decl) bool {
	var msg @[]char = irgen.GenDecl(d, s.MainGc)
	if len(msg) > 0 {
		s.errln(msg)
		return false
	}
	return true
}
