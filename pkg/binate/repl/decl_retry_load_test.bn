package "pkg/binate/repl"

import "pkg/builtins/testing"

// Tests for a parked declaration that resolves at a later prompt but does not
// load (decl_retry.bn's emitResolvedGroup, load_check.bn): it stays parked, and
// nothing generating it did is kept.  sessionWithoutStorage, withoutStorage and
// noStorageMsg are load_check_test.bn's, errHas and execOK
// decl_blank_type_test.bn's, callInt decl_generic_test.bn's, containsSub
// decl_test.bn's, setupReplStateSrc testsupport_test.bn's.

// noticeHas reports whether a notice of r has needle.
func noticeHas(r Result, needle *[]readonly char) bool {
	for i := 0; i < len(r.Notices); i++ {
		if containsSub(r.Notices[i].Msg, needle) { return true }
	}
	return false
}

// A parked function that resolves at a later prompt but needs G does not load:
// it stays parked and unbound, and so does what calls it, while the declaration
// that resolved it is kept.  A later declaration does not report it again, and
// a redefinition of it that loads resolves it, and what calls it.
func TestLoadFailsParkedGroup() testing.TestResult {
	var s @kernel = sessionWithoutStorage()
	if !execOK(s, "func f() int { return g() + G }") || !execOK(s, "func h() int { return f() }") {
		return fail("f and h should park")
	}
	var r Result = s.Execute(toBytesRT("func g() int { return 1 }"))
	if !errHas(r, noStorageMsg) || !noticeHas(r, "function f still parked (it does not load)") {
		return fail("f should resolve, fail to load, and stay parked")
	}
	if callInt(s, "g") != 1 {
		return fail("g should be kept")
	}
	r = s.Execute(toBytesRT("_ = f"))
	if !errHas(r, "function f is unresolved (it does not load)") {
		return fail("f should be unresolved, as it does not load")
	}
	r = s.Execute(toBytesRT("var k int = 1"))
	if len(r.Err) != 0 || noticeHas(r, "still parked") {
		return fail("f's load error should not be reported again")
	}
	if !execOK(s, "func f() int { return g() + 2 }") || callInt(s, "h") != 3 {
		return fail("a redefinition of f that loads should resolve h")
	}
	return ""
}

// A parked variable whose initializer needs G does not load either: its name is
// not bound, its error names its initializer as such — and so reads the same at
// each retry, and is not reported again — and the retries add nothing to the
// session module.
func TestLoadFailsParkedVariable() testing.TestResult {
	var s @kernel = sessionWithoutStorage()
	if !execOK(s, "var v int = w() + G") {
		return fail("v should park")
	}
	var r Result = s.Execute(toBytesRT("func w() int { return 1 }"))
	if !errHas(r, "(used by the initializer of v") ||
			!noticeHas(r, "variable v still parked (it does not load)") {
		return fail("v should resolve, fail to load, and stay parked")
	}
	r = s.Execute(toBytesRT("_ = v"))
	if !errHas(r, "variable v is unresolved (it does not load)") {
		return fail("v should be unresolved")
	}
	var funcs int = len(s.MainMod.Funcs)
	r = s.Execute(toBytesRT("const kc int = 1"))
	if len(r.Err) != 0 || noticeHas(r, "still parked") {
		return fail("v's load error should not be reported again")
	}
	if len(s.MainMod.Funcs) != funcs {
		return fail("v's retry should leave nothing in the session module")
	}
	return ""
}

// A parked variable whose initializer boxes a generic instance into an
// interface, resolving at a later prompt, has the instance's methods in the
// interface's vtable: they are lowered before the vtable is built.
func TestRetryInitializerBoxesInstance() testing.TestResult {
	var s @kernel = setupReplStateSrc(
			"package \"main\"\ninterface Getter { Get() int }\ntype Gen[T any] struct { v T }\n"
					"func (g *Gen[T]) Get() int { return 7 }\nimpl *Gen[T] : Getter\n"
					"func wrapk[T any](x *Gen[T], k int) *Getter { return x }\nfunc main() { }\n")
	if !execOK(s, "var gq Gen[bool]") || !execOK(s, "var p *Getter = wrapk[bool](&gq, k)") ||
			!execOK(s, "var k int = 1") {
		return fail("p should park on k, and resolve with it")
	}
	if !execOK(s, "func getP() int { return p.Get() }") || callInt(s, "getP") != 7 {
		return fail("p.Get() should dispatch to Gen[bool].Get")
	}
	return ""
}

// A resolved group in which a generic function is redefined with another
// signature, and another member uses the new one, has that member call the new
// definition's instance; the old instance's callers keep it.
func TestRetryGroupRedefinesGenericItUses() testing.TestResult {
	var s @kernel = setupReplStateSrc("package \"main\"\nfunc main() { }\n")
	if !execOK(s, "var v int = g[int](7) + 0") {
		return fail("v should park on g")
	}
	_ = s.Execute(toBytesRT("func g[T any](x T, y T) int { return 1 }"))
	if !execOK(s, "var a int = g[int](1, 2)") || !execOK(s, "func getA() int { return a }") {
		return fail("a should call the two-parameter g[int]")
	}
	if !execOK(s, "func g[T any](x T) int { return v + 40 }") {
		return fail("g's redefinition should resolve v with it")
	}
	if !execOK(s, "func getV() int { return v }") || callInt(s, "getV") != 40 ||
			callInt(s, "getA") != 1 {
		return fail("v should be the new g[int]'s result, and a the old one's")
	}
	return ""
}

// A group that does not load, in which a generic function is declared and an
// instance of it read from the group's own variable, is undone without lowering
// the instance, and without IR-gen keeping the name it gave the instance's
// checked copy; a later, different definition of the generic emits its own
// instance.
func TestLoadFailsGroupDeclaringGeneric() testing.TestResult {
	var s @kernel = sessionWithoutStorage()
	if !execOK(s, "func f4[T any](x T) int { return u4 }") {
		return fail("f4 should park on u4")
	}
	var copies int = s.MainGc.InstanceCopyNames.Len()
	var r Result = s.Execute(toBytesRT("var u4 int = f4[int](1) + G"))
	if !errHas(r, noStorageMsg) || !noticeHas(r, "variable u4 still parked (it does not load)") {
		return fail("f4 and u4 should resolve together and fail to load")
	}
	if s.MainGc.InstanceCopyNames.Len() != copies {
		return fail("IR-gen should not keep the names of the group's instance copies")
	}
	if !execOK(s, "func f4[T any](x T) int { return 7 }") ||
			!execOK(s, "func useF4() int { return f4[int](1) }") || callInt(s, "useF4") != 7 {
		return fail("a new f4 should run its own instance")
	}
	return ""
}

// A group that does not load, in which a type is declared, is undone with the
// type's registration and helpers: none of it is left in the session module,
// and a later, different type of the name gets its own layout and helpers.
func TestLoadFailsGroupDeclaringType() testing.TestResult {
	var s @kernel = sessionWithoutStorage()
	var structs int = len(s.MainMod.Structs)
	if !execOK(s, "type T6 struct { a [N6]int; p @[]char }") ||
			!execOK(s, "const N6 int = len(arr6)") || !execOK(s, "var arr6 [2]int = init6()") {
		return fail("T6, N6 and arr6 should park")
	}
	var r Result = s.Execute(
			toBytesRT(
					"func init6() [2]int { var t T6; var a [2]int; a[0] = len(t.a) + G; return a }"))
	if !errHas(r, noStorageMsg) || !noticeHas(r, "type T6 still parked (it does not load)") {
		return fail("T6, N6, arr6 and init6 should resolve together and fail to load")
	}
	if len(s.MainMod.Structs) != structs {
		return fail("T6's registration should be undone")
	}
	for i := 0; i < len(s.MainMod.Funcs); i++ {
		if containsSub(s.MainMod.Funcs[i].Name, "__dtor_2T6") {
			return fail("T6's destructor should be dropped")
		}
	}
	// The new T6 is kept; the rest of the group, retried with it, does not check.
	_ = s.Execute(toBytesRT("type T6 struct { s @[]char }"))
	if !execOK(s, "func mk6() int { var t T6; t.s = make_slice(char, 3); return len(t.s) }") ||
			callInt(s, "mk6") != 3 {
		return fail("a new T6 should have its own layout and destructor")
	}
	return ""
}

// A parked function whose function literal needs G is reported once: the
// literal is named the same at each retry.
func TestLoadFailsParkedLiteralReportedOnce() testing.TestResult {
	var s @kernel = sessionWithoutStorage()
	if !execOK(s,
			"func pf() int { var fn @func() int = func() int { return G }; return fn() + pg() }") {
		return fail("pf should park on pg")
	}
	var r Result = s.Execute(toBytesRT("func pg() int { return 1 }"))
	if !errHas(r, noStorageMsg) || !noticeHas(r, "function pf still parked (it does not load)") {
		return fail("pf should resolve and fail to load")
	}
	r = s.Execute(toBytesRT("const kc int = 1"))
	if len(r.Err) != 0 || noticeHas(r, "still parked") {
		return fail("pf's load error should not be reported again")
	}
	return ""
}
