package "pkg/binate/repl"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/builtins/testing"

// Tests for decl_retry.bn and the forward-reference behaviour of the REPL:
// what a parked declaration waits on, when it is emitted, and what a retry
// that fails to check does.  setupReplState / toBytesRT / fail live in
// testsupport_test.bn; replPromptNotRun / replPromptRejected in
// failed_prompt_test.bn; moduleHasFunc / containsSub in decl_test.bn.

// replTurn runs line as a fresh prompt; its notices and diagnostics are
// then in s.curNotices / s.curErrs.
func replTurn(s @kernel, line *[]readonly char) {
	s.resetTurnOutput()
	s.evalReplLine(toBytesRT(line))
}

// noticesIn returns the turn's notices, one per line.
func noticesIn(s @kernel) @[]char {
	var out @[]char = ""
	for i := 0; i < len(s.curNotices); i++ {
		out = buf.Concat(buf.Concat(out, s.curNotices[i].Msg), "\n")
	}
	return out
}

// A parked declaration whose retry checks is emitted.
func TestReplRetryResolvesAndRuns() testing.TestResult {
	var s @kernel = setupReplState()
	if !replPromptNotRun(s, "var x int = y + 1\n") {
		return fail("x must park on y")
	}
	s.resetTurnOutput()
	var before int = len(s.MainMod.Funcs)
	s.evalReplLine(toBytesRT("var y int = 41\n"))
	if len(s.curErrs) != 0 {
		return fail("x's retry must check")
	}
	if len(s.MainMod.Funcs) != before + 2 {
		return fail("both y's and x's initializers must be emitted")
	}
	return ""
}

// A parked declaration whose retry fails to check — its missing name is
// declared with a type that does not fit — reports its error, is not
// emitted, and stays parked: a later declaration that fits resolves it (and
// what waits on it).
func TestReplFailedRetryStaysParked() testing.TestResult {
	var s @kernel = setupReplState()
	if !replPromptNotRun(s, "var x int = y\n") {
		return fail("x must park on y")
	}
	var before int = len(s.MainMod.Funcs)
	replTurn(s, "var y bool = true\n")
	if len(s.curErrs) == 0 {
		return fail("the failed retry of x must report its error")
	}
	if !containsSub(noticesIn(s), "variable x still parked (it does not check)") {
		return fail(buf.Concat("expected x still parked; notices:\n", noticesIn(s)))
	}
	if len(s.MainMod.Funcs) != before + 1 {
		return fail("only y's initializer may be emitted; the failed x must not be")
	}
	if !replPromptNotRun(s, "var q int = x\n") {
		return fail("q must wait for x, not run")
	}
	replTurn(s, "var y int = 2\n")
	var n @[]char = noticesIn(s)
	if !containsSub(n, "variable x resolved\nvariable q resolved") {
		return fail(buf.Concat("expected x then q resolved; notices:\n", n))
	}
	return ""
}

// A failed parked declaration is checked again after later declarations, but
// its errors are shown again only when they change.
func TestReplFailedRetryNotReportedAgain() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "func f() int { return zz + true }\n")
	replTurn(s, "var zz int = 1\n")
	if len(s.curErrs) == 0 || moduleHasFunc(s.MainMod, "main.f") {
		return fail("f must fail its retry, unemitted")
	}
	replTurn(s, "type Unrelated int\n")
	if len(s.curErrs) != 0 {
		return fail("the same failure must not be reported again")
	}
	if moduleHasFunc(s.MainMod, "main.f") {
		return fail("the failed f must not be emitted")
	}
	return ""
}

// A declaration using a parked one parks on it; they resolve dependencies
// first.
func TestReplDependentParksOnParked() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "func f() int { return y }\n")
	replTurn(s, "func g() int { return f() }\n")
	if !containsSub(noticesIn(s), "function g parked (pending: f)") {
		return fail(buf.Concat("g must park on f; notices:\n", noticesIn(s)))
	}
	replTurn(s, "var y int = 3\n")
	var n @[]char = noticesIn(s)
	if !containsSub(n, "function f resolved\nfunction g resolved") {
		return fail(buf.Concat("expected f then g resolved; notices:\n", n))
	}
	return ""
}

// Mutually recursive functions resolve together, at the prompt that
// completes them.
func TestReplMutualRecursionResolves() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "func f(n int) int { if n == 0 { return 0 }; return g(n - 1) }\n")
	replTurn(s, "func g(n int) int { if n == 0 { return 1 }; return f(n - 1) }\n")
	if !containsSub(noticesIn(s), "function f resolved\nfunction g resolved") {
		return fail(buf.Concat("f and g must resolve; notices:\n", noticesIn(s)))
	}
	if !moduleHasFunc(s.MainMod, "main.f") || !moduleHasFunc(s.MainMod, "main.g") {
		return fail("f and g must be emitted")
	}
	return ""
}

// A parked redefinition with a different signature shadows the old
// definition when it resolves (its old callers keep the old one), as a
// redefinition typed at the prompt does.
func TestReplParkedRedefinitionShadowsOnResolve() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "func f(x int) int { return x + 1 }\n")
	replTurn(s, "func g() int { return f(41) }\n")
	replTurn(s, "func f(x int, y int) int { return x + y + z }\n")
	replTurn(s, "var z int = 100\n")
	if !containsSub(noticesIn(s), "f shadowed (incompatible signature)") {
		return fail(buf.Concat("f must shadow; notices:\n", noticesIn(s)))
	}
	return ""
}

// A parked method cannot be called at the prompt.
func TestReplParkedMethodCallRejected() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "type T struct { a int }\n")
	replTurn(s, "func (t *T) M() int { return t.a + q }\n")
	replTurn(s, "var x T\n")
	if !replPromptRejected(s, "x.M()\n") {
		return fail("calling the parked T.M must be rejected")
	}
	return ""
}

// A pointer to a parked type waits for the type, and both resolve, type
// first, when it is completed.
func TestReplPointerToParkedTypeWaits() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "type T struct { a int; c U }\n")
	replTurn(s, "var p *T\n")
	if !containsSub(noticesIn(s), "variable p parked (pending: T)") {
		return fail(buf.Concat("p must park on T; notices:\n", noticesIn(s)))
	}
	replTurn(s, "type U int\n")
	if !containsSub(noticesIn(s), "type T resolved\nvariable p resolved") {
		return fail(buf.Concat("expected T then p resolved; notices:\n", noticesIn(s)))
	}
	return ""
}

// A parked declaration that calls `panic` is checked again when it is retried, on
// the same node: if a `func panic` was declared at the prompt in between, the
// retried call is a call of that function, not the predeclared panic's abort.
func TestReplRetryPanicShadowedMeanwhile() testing.TestResult {
	var s @kernel = setupReplState()
	if !replPromptNotRun(s, "func g() {\n\tpanic(\"x\")\n\thelper()\n}\n") {
		return fail("g must park on helper")
	}
	replTurn(s, "func panic(s *[]readonly char) {\n}\n")
	if len(s.curErrs) != 0 { return fail("func panic should be accepted") }
	replTurn(s, "func helper() {\n}\n")
	if len(s.curErrs) != 0 { return fail("g's retry must check") }
	var found bool = false
	for i := 0; i < len(s.MainMod.Funcs); i++ {
		var f @ir.Func = s.MainMod.Funcs[i]
		if !seq(f.Name, "main.g") { continue }
		found = true
		for bi := 0; bi < len(f.Blocks); bi++ {
			for ii := 0; ii < len(f.Blocks[bi].Instrs); ii++ {
				var ins @ir.Instr = f.Blocks[bi].Instrs[ii]
				if ins.Op == iropcode.OP_CALL && seq(ins.StrVal, "pkg/builtins/rt.Panic") {
					return fail("the retried call should reach the prompt's func panic, not rt.Panic")
				}
			}
		}
	}
	if !found { return fail("g should be emitted") }
	return ""
}

// A parked declaration's retry checks its syntax afresh: the first attempt read
// `v.Inc()` with v a T value (an implicit `&v` for the `*T` method), and by the
// retry v is a `*T`, whose call takes v itself — an `&v` left from the first
// attempt would pass a `**T`.
func TestReplRetryReadsTheSyntaxAfresh() testing.TestResult {
	var s @kernel = setupReplState()
	if !execOK(s, "type T struct { n int }") ||
			!execOK(s, "func (t *T) Inc() int { t.n = t.n + 1; return t.n }") ||
			!execOK(s, "func add(a int, b int) int { return a + b }") || !execOK(s, "var v T") {
		return fail("the setup must be accepted")
	}
	if !replPromptNotRun(s, "var y int = add(v.Inc(), u)\n") {
		return fail("y must park on u")
	}
	if !execOK(s, "var w T = T{n: 40}") || !execOK(s, "var v *T = &w") || !execOK(s, "var u int = 1") {
		return fail("v's shadowing and u must be accepted, and y resolve")
	}
	if !execOK(s, "if y != 42 || w.n != 41 { panic(\"wrong\") }") {
		return fail("y must be 42 and w.n 41: the retried call takes v")
	}
	return ""
}

// A parked declaration's retry decides afresh which calls are a constraint's:
// G's first attempt read `id[T](t).M()` with id returning its T (a call of the
// constraint's method M), and by the retry id returns an S, whose field M takes
// precedence over its method M (expr.member) — the call reads the field.
func TestReplRetryDecidesConstraintCallsAfresh() testing.TestResult {
	var s @kernel = setupReplState()
	var setup @[]*[]readonly char = make_slice(*[]readonly char, 8)
	setup[0] = "interface I { M() int }"
	setup[1] = "type A struct { n int }"
	setup[2] = "func (a A) M() int { return a.n }"
	setup[3] = "impl A : I"
	setup[4] = "type S struct { M *func() int }"
	setup[5] = "func (s S) M() int { return 7 }"
	setup[6] = "func f9() int { return 9 }"
	setup[7] = "func id[U any](x U) U { return x }"
	for i := 0; i < len(setup); i++ {
		if !execOK(s, setup[i]) { return fail(buf.Concat("the setup must be accepted: ", setup[i])) }
	}
	if !replPromptNotRun(s, "func G[T I](t T) int { return id[T](t).M() + u }\n") {
		return fail("G must park on u")
	}
	if !execOK(s, "func id[U any](x U) S { var s S; s.M = f9; return s }") ||
			!execOK(s, "var u int = 0") {
		return fail("id's redefinition and u must be accepted, and G resolve")
	}
	if !execOK(s, "if G[A](A{n: 3}) != 9 { panic(\"wrong\") }") {
		return fail("G must call S's field M (9), not its method (7)")
	}
	return ""
}
