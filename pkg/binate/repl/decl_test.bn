package "pkg/binate/repl"

import "pkg/binate/ir"
import "pkg/builtins/testing"

// Tests for evalReplDecl (and the surrounding decl-driver machinery in
// decl.bn).  setupReplState / toBytesRT / seq / fail live in
// testsupport_test.bn.

// Tier 2: a `func` decl typed at the prompt registers a persistent
// symbol — the new function is added to the module under its real
// name, not a synthetic __repl_<n>.
func TestEvalReplDeclAddsNamedFunc() testing.TestResult {
	var s @ReplSession = setupReplState()
	var before int = len(s.MainMod.Funcs)
	s.evalReplLine(toBytesRT("func twice(n int) int { return n + n }\n"))
	if len(s.MainMod.Funcs) != before + 1 {
		return fail("decl should add one func")
	}
	var added @ir.Func = s.MainMod.Funcs[before]
	// Like synthetic funcs, decl funcs get the module's pkg short
	// qualifier prefixed by IR-gen.
	if !seq(added.Name, "main.twice") {
		return fail("decl func should be named main.twice (qualified)")
	}
	return ""
}

// Parse error in a decl path: same contract — leave module alone.
func TestEvalReplDeclParseErrorPreservesState() testing.TestResult {
	var s @ReplSession = setupReplState()
	var before int = len(s.MainMod.Funcs)
	// Truncated func declaration.
	s.evalReplLine(toBytesRT("func broken(\n"))
	if len(s.MainMod.Funcs) != before {
		return fail("parse error in decl must not add a func")
	}
	return ""
}

// Each `var x T = expr` turn emits a one-shot init synthetic named
// __repl_var_init_<n>.  The counter lives on @ReplSession (Stage 1
// lifted it off a package global), so two var-init turns against the
// SAME session must produce distinct names — a regression here would
// collide the second init onto the first symbol.  e2e/repl.sh runs
// each case in a fresh session, so it never exercises this cross-turn
// advance; pin it here.
func TestReplVarInitCounterAdvancesPerSession() testing.TestResult {
	var s @ReplSession = setupReplState()
	s.evalReplLine(toBytesRT("var a int = 1\n"))
	s.evalReplLine(toBytesRT("var b int = 2\n"))
	if !moduleHasFunc(s.MainMod, "main.__repl_var_init_0") {
		return fail("first var-init synthetic should be __repl_var_init_0")
	}
	if !moduleHasFunc(s.MainMod, "main.__repl_var_init_1") {
		return fail("second var-init synthetic should be __repl_var_init_1")
	}
	return ""
}

// moduleHasFunc reports whether the module holds a func with the given
// (pkg-qualified) name.
func moduleHasFunc(m @ir.Module, name *[]readonly char) bool {
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, name) { return true }
	}
	return false
}
