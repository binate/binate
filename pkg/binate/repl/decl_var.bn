package "pkg/binate/repl"

import "pkg/binate/check"

import "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/binate/vm"
import "pkg/std/strconv"
import "pkg/stdx/slices"

// A binding whose name a prompt declaration binds again.  A variable of the same
// type replaces a variable: it keeps its storage — code already lowered reaches
// it by address, and sees the new value — and its new initializer is assigned
// into it, or it is reset to its zero value; a function of the same signature
// replaces a function (lowerReplacing).  Anything else shadows the binding: the
// checker keeps it under a hidden name (check.ShadowedBinding), and what it is
// registered as is renamed to that name (a variable's global, a constant, a
// function and a generic function's instances; in IR-gen and the VM) and keeps
// serving the code already lowered, while the declaration takes the name for code
// written from now on.  So does a method of a session type a method declaration
// supersedes -- one of another signature (check.ShadowedMethod) -- under its
// hidden name, as its type's member.

// replShadow is a binding renamed out of the way of a declaration (Kind, its
// symbol kind; Renamed, a function's or a method's renamed functions), or (Funcs)
// the functions a method declaration of a generic type shadows (shadowFuncs): the
// method's instances, Instances their names, and their method-value wrappers,
// Wrappers theirs.
type replShadow struct {
	Name      @[]char
	Hidden    @[]char
	Why       @[]char
	Kind      int
	Renamed   @[]irgen.RenamedFunc
	Funcs     bool
	Instances @[]@[]char
	Wrappers  @[]@[]char
}

// prevReplVarType returns the type of the variable the name d declares holds
// before d is checked, or nil when it holds none.
func (s @kernel) prevReplVarType(d @ast.Decl) @types.Type {
	if d.Kind != ast.DECL_VAR || isBlankReplName(d.Name) { return nil }
	var sym @check.Symbol = s.Chk.Scope().Lookup(d.Name)
	if sym == nil || sym.Kind() != types.SYM_VAR { return nil }
	return sym.Type()
}

// replVarReplaced reports whether the variable declaration d, just checked,
// replaces the variable of type prev its name held (nil when none): it does
// when the types are identical.
func (s @kernel) replVarReplaced(d @ast.Decl, prev @types.Type) bool {
	if prev == nil || isBlankReplName(d.Name) { return false }
	var sym @check.Symbol = s.Chk.Scope().Lookup(d.Name)
	return sym != nil && prev.Identical(sym.Type())
}

// shadowRebound renames out of the way every binding a name d binds shadowed —
// d, just checked, is not a replacing variable — and returns them, with the
// method a method d supersedes or the functions it shadows (shadowFuncs; prevFunc
// is the signature of the method d redefines, nil for none), for commitShadows
// once d is emitted or unshadow if it is not.  A group member that parks binds
// nothing (genConstGroup skips it), so it shadows nothing.
func (s @kernel) shadowRebound(d @ast.Decl, prevFunc @types.Type) @[]replShadow {
	var shadows @[]replShadow
	if d.Kind == ast.DECL_GROUP {
		for i := 0; i < len(d.Decls); i++ {
			if !s.Chk.IsPendingDecl(d.Decls[i].Name) {
				shadows = s.shadowName(shadows, d.Decls[i])
				shadows = s.shadowFuncs(shadows, d.Decls[i], nil)
			}
		}
		return shadows
	}
	shadows = s.shadowFuncs(shadows, d, prevFunc)
	return s.shadowName(shadows, d)
}

// shadowFuncs appends to shadows what a method d shadows, when d redefines a
// method with a signature other than prevFunc: the method it supersedes, of a
// type that is not generic (shadowMethod), or for a generic-receiver method, its
// instances and their method-value wrappers.  IR-gen forgets those now
// (irgen.ShadowReplGenericMethod, irgen.ShadowReplMethodValues), so a use in d's
// entry — another declaration of d's resolved group, say — emits them anew from
// d, and if the entry is not kept IR-gen gets them back with the rest of its
// state (irgen.UndoReplEntry); once d is emitted (commitShadows) the VM unbinds
// them, so the callers that reached them keep them.  Without this a later
// declaration would find an old instance emitted and call it with its old
// signature, or run its body, and a later method value would reuse the old
// wrapper, which calls the old method.
func (s @kernel) shadowFuncs(shadows @[]replShadow, d @ast.Decl,
		prevFunc @types.Type) @[]replShadow {
	if d.Kind != ast.DECL_FUNC || d.Recv == nil || !s.shadowsOld(d, prevFunc) { return shadows }
	if !irgen.IsGenericDecl(d) { return s.shadowMethod(shadows, d) }
	var msh replShadow
	msh.Name = buf.CopyStr(d.Name)
	msh.Funcs = true
	msh.Instances = irgen.ShadowReplGenericMethod(s.MainGc, d)
	msh.Wrappers = irgen.ShadowReplMethodValues(s.MainGc, d)
	return slices.Append[replShadow](shadows, msh)
}

// shadowMethod appends to shadows the method the method declaration d supersedes
// (check.ShadowedMethod), if any, renamed to its hidden name in IR-gen
// (irgen.ShadowReplMethod), for commitShadows to rename in the VM: the code
// lowered before d keeps calling it, and so does an instance of a generic
// declared before d that is checked later, which selects it by that name.
func (s @kernel) shadowMethod(shadows @[]replShadow, d @ast.Decl) @[]replShadow {
	var hidden @[]char
	var ok bool
	hidden, ok = s.Chk.ShadowedMethod(d)
	if !ok { return shadows }
	var sh replShadow
	sh.Name = buf.CopyStr(d.Name)
	sh.Hidden = hidden
	sh.Kind = types.SYM_FUNC
	sh.Renamed = irgen.ShadowReplMethod(s.MainGc, d, hidden)
	return slices.Append[replShadow](shadows, sh)
}

// shadowName appends to shadows the binding d's name held, when d binds the name
// (a variable, a constant, a free function) and shadowed it
// (check.ShadowedBinding), renamed to its hidden name: a variable's global (in
// IR-gen and the VM), a constant, or a function -- its signature and IR
// function, a generic function's instances -- in IR-gen, for commitShadows to
// rename in the VM; an import needs no renaming (renameShadowed).
func (s @kernel) shadowName(shadows @[]replShadow, d @ast.Decl) @[]replShadow {
	var why @[]char
	if d.Kind == ast.DECL_VAR {
		why = "incompatible type"
	} else if d.Kind == ast.DECL_CONST {
		why = "redeclared as a constant"
	} else if d.Kind == ast.DECL_FUNC && d.Recv == nil {
		why = "redeclared as a function"
	} else {
		return shadows
	}
	if isBlankReplName(d.Name) { return shadows }
	var sh replShadow
	var ok bool
	sh, ok = s.renameShadowed(d.Name, why)
	if !ok { return shadows }
	return slices.Append[replShadow](shadows, sh)
}

// renameShadowed renames the binding of name that the session's binding of it
// shadowed in the input checked last (check.ShadowedBinding) to its hidden name
// -- a variable's global (in IR-gen and the VM), a constant, or a function, its
// signature and IR function and a generic function's instances (in IR-gen; the
// VM's at commitShadows); an import, whose references IR-gen names by its
// package's path, keeps everything -- and returns it, its warning saying why,
// and true; false when the binding shadowed none.
func (s @kernel) renameShadowed(name *[]readonly char, why @[]char) (replShadow, bool) {
	var sh replShadow
	var old check.ReplShadow
	var ok bool
	old, ok = s.Chk.ShadowedBinding(name)
	if !ok { return sh, false }
	sh.Name = buf.CopyStr(name)
	sh.Hidden = old.Hidden
	sh.Why = why
	sh.Kind = old.Kind
	if old.Kind == types.SYM_VAR {
		if !irgen.ShadowReplGlobal(s.MainGc, name, old.Hidden) { return sh, false }
		s.Vm.RenameGlobal(name, old.Hidden)
	} else if old.Kind == types.SYM_CONST {
		_ = irgen.ShadowReplConst(s.MainGc, name, old.Hidden)
	} else if old.Kind != types.SYM_PKG {
		sh.Renamed = irgen.ShadowReplFunc(s.MainGc, name, old.Hidden)
	}
	return sh, true
}

// commitShadows completes what shadowRebound recorded, once the declaration
// that rebound the names is emitted: it renames in the VM the functions renamed
// (shadowName, shadowMethod), reports each variable, constant and import
// shadowed, and unbinds in the VM the functions of a generic type's method
// shadowed (shadowFuncs).
func (s @kernel) commitShadows(shadows @[]replShadow) {
	for i := 0; i < len(shadows); i++ {
		if shadows[i].Funcs {
			for j := 0; j < len(shadows[i].Instances); j++ {
				s.Vm.UnbindFunc(shadows[i].Instances[j])
			}
			for j := 0; j < len(shadows[i].Wrappers); j++ {
				s.Vm.UnbindFunc(shadows[i].Wrappers[j])
			}
			continue
		}
		for j := 0; j < len(shadows[i].Renamed); j++ {
			_ = s.Vm.RenameFunc(shadows[i].Renamed[j].Old, shadows[i].Renamed[j].New)
		}
		if shadows[i].Kind == types.SYM_VAR {
			s.out("warning: variable ")
			s.out(shadows[i].Name)
			s.out(" shadowed (")
			s.out(shadows[i].Why)
			s.outln("); existing references retain the old variable")
		} else if shadows[i].Kind == types.SYM_CONST {
			s.out("warning: constant ")
			s.out(shadows[i].Name)
			s.outln(" shadowed; existing references retain the old constant")
		} else if shadows[i].Kind == types.SYM_PKG {
			s.out("warning: import ")
			s.out(shadows[i].Name)
			s.outln(" shadowed; existing references retain the old package")
		}
	}
}

// unshadow gives each binding shadowRebound renamed its name back: the
// declaration that rebound it was not emitted, and the VM has renamed no function
// yet.  (A method's functions shadowed IR-gen gets back when it undoes the
// declaration's entry, and the VM still has them: nothing to give back here.)
func (s @kernel) unshadow(shadows @[]replShadow) {
	for i := 0; i < len(shadows); i++ {
		if shadows[i].Funcs { continue }
		if shadows[i].Kind == types.SYM_VAR {
			irgen.ShadowReplGlobal(s.MainGc, shadows[i].Hidden, shadows[i].Name)
			s.Vm.RenameGlobal(shadows[i].Hidden, shadows[i].Name)
		} else if shadows[i].Kind == types.SYM_CONST {
			_ = irgen.ShadowReplConst(s.MainGc, shadows[i].Hidden, shadows[i].Name)
		} else {
			irgen.UnshadowReplFunc(s.MainGc, shadows[i].Renamed)
		}
	}
}

// replInit is a variable declaration's initialization, generated before the
// declaration is kept (genVarInit) and run once it is (runVarInit): the
// synthetic function doing it — nil when there is nothing to do — the session
// module's function and global counts before it was generated, and its function
// count after (generating it appended the functions from PreFuncs to PostFuncs,
// Fn last).
type replInit struct {
	Fn         @ir.Func
	PreFuncs   int
	PostFuncs  int
	PreGlobals int
}

// genVarInit generates the initialization of the variable d declares: its
// initializer assigned to it (evaluated for its side effects, for a blank
// variable), or, for a replaced variable (one redeclared with its own type,
// which keeps its global) declared without one, its reset to its zero value.
// The synthetic is named from s.InitCounter, bumped once per call so
// successive ones don't collide.
func (s @kernel) genVarInit(d @ast.Decl, replaced bool) replInit {
	var vi replInit
	var stmts @[]@ast.Stmt
	if d.Value != nil {
		stmts = make_slice(@ast.Stmt, 1)
		if isBlankReplName(d.Name) {
			stmts[0] = irgen.MakeInitExprStmt(d)
		} else {
			stmts[0] = irgen.MakeInitAssignStmt(d)
		}
	} else if replaced {
		stmts = irgen.MakeZeroAssignStmts(d)
	} else {
		return vi
	}
	var m @ir.Module = s.MainMod
	var name @[]char = buf.Concat("__repl_var_init_", strconv.Itoa(s.InitCounter))
	s.InitCounter = s.InitCounter + 1
	vi.PreFuncs = len(m.Funcs)
	vi.PreGlobals = len(m.Globals)
	vi.Fn = irgen.GenGlobalInitFunc(s.MainGc, name, stmts)
	m.AddFunc(vi.Fn)
	vi.PostFuncs = len(m.Funcs)
	return vi
}

// runVarInit lowers and runs the initialization genVarInit generated for d,
// and reports whether it completed (callTurnCode; a fault names the variable).
// A raw-slice literal in the initializer gets a hidden module global as its
// backing; the VM resolves a global only once it is materialized, so every
// global the generation added is registered before it runs.
func (s @kernel) runVarInit(vi replInit, d @ast.Decl) bool {
	if vi.Fn == nil { return true }
	var m @ir.Module = s.MainMod
	for i := vi.PreGlobals; i < len(m.Globals); i++ {
		s.Vm.MaterializeOneGlobal(m.Globals[i])
	}
	s.lowerGenerated(vi.PreFuncs, vi.Fn)
	return s.callVarInit(vi, d)
}

// callVarInit lowers the function initializing d — what generating it appended
// is lowered, and the globals it added materialized, already — and runs it, as
// runVarInit does.
func (s @kernel) callVarInit(vi replInit, d @ast.Decl) bool {
	var vmf @vm.VMFunc = s.Vm.LowerOneFunc(s.MainMod, vi.Fn)
	if vmf == nil { return true }
	s.lowerPendingImpls()
	var faultPrefix @[]char = buf.Concat(buf.Concat("initialization of variable ", d.Name),
			" faulted: ")
	return s.callTurnCode(vmf, faultPrefix)
}
