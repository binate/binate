package "pkg/binate/repl"

import "pkg/binate/check"

import "pkg/binate/irgen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/std/strconv"
import "pkg/stdx/slices"

// A global variable whose name a prompt declaration binds again.  A variable of
// the same type replaces it: it keeps its storage — code already lowered reaches
// it by address, and sees the new value — and its new initializer is assigned
// into it, or it is reset to its zero value.  Anything else shadows it — a
// variable of another type, a constant, a function: the old variable is renamed
// out of the way (in IR-gen and the VM) and keeps serving the code already
// lowered, while the declaration takes the name for code written from now on.

// replShadow is a global variable renamed out of the way of a declaration, or
// (Generic) a generic function whose instances the declaration shadows once it
// is emitted (shadowGenericInstances).
type replShadow struct {
	Name    @[]char
	Hidden  @[]char
	Why     @[]char
	Generic bool
}

// prevReplVarType returns the type of the variable the name d declares holds
// before d is checked, or nil when it holds none.
func (s @kernel) prevReplVarType(d @ast.Decl) @types.Type {
	if d.Kind != ast.DECL_VAR || isBlankReplName(d.Name) { return nil }
	var sym @check.Symbol = s.Chk.Scope().Lookup(d.Name)
	if sym == nil || sym.Kind() != types.SYM_VAR { return nil }
	return sym.Type()
}

// replVarReplaced reports whether the variable declaration d, just checked,
// replaces the variable of type prev its name held (nil when none): it does
// when the types are identical.
func (s @kernel) replVarReplaced(d @ast.Decl, prev @types.Type) bool {
	if prev == nil || isBlankReplName(d.Name) { return false }
	var sym @check.Symbol = s.Chk.Scope().Lookup(d.Name)
	return sym != nil && prev.Identical(sym.Type())
}

// shadowRebound renames out of the way every global variable a name d binds
// holds — d, just checked, is not a replacing variable — and returns them, with
// the generic functions whose instances d shadows (shadowGenericInstances), for
// commitShadows once d is emitted or unshadow if it is not.  A group member that
// parks binds nothing (genConstGroup skips it), so it shadows nothing.
func (s @kernel) shadowRebound(d @ast.Decl) @[]replShadow {
	var shadows @[]replShadow
	if d.Kind == ast.DECL_GROUP {
		for i := 0; i < len(d.Decls); i++ {
			if !s.Chk.IsPendingDecl(d.Decls[i].Name) {
				shadows = s.shadowName(shadows, d.Decls[i])
				shadows = s.shadowGenericInstances(shadows, d.Decls[i])
			}
		}
		return shadows
	}
	shadows = s.shadowGenericInstances(shadows, d)
	return s.shadowName(shadows, d)
}

// shadowGenericInstances appends to shadows the generic function d's name
// holds, whose instances d shadows — unless d replaces it (a generic function
// of the same signature, whose instances are emitted again from it).  Once d
// is emitted (commitShadows) IR-gen forgets them, so a use of the name emits
// its instances anew, and the VM unbinds them, so the callers that reached them
// keep them.  Without this a later generic function of the name would find an
// old instance emitted and run its body.
func (s @kernel) shadowGenericInstances(shadows @[]replShadow, d @ast.Decl) @[]replShadow {
	if d.Kind == ast.DECL_FUNC && d.Recv != nil { return shadows }
	if isBlankReplName(d.Name) { return shadows }
	var old @ast.Decl = irgen.ReplGenericFunc(s.MainGc, d.Name)
	if old == nil || same(old, d) { return shadows }
	var c @check.Checker = s.Chk
	if d.Kind == ast.DECL_FUNC && len(d.TypeParams) > 0 &&
			c.SameFuncSignature(c.ExprType(old.ResolvedTypeID), c.ExprType(d.ResolvedTypeID)) {
		return shadows
	}
	var sh replShadow
	sh.Name = buf.CopyStr(d.Name)
	sh.Generic = true
	return slices.Append[replShadow](shadows, sh)
}

// shadowName appends to shadows the global variable d's name holds, renamed out
// of the way, when d binds the name (a variable, a constant, a free function).
func (s @kernel) shadowName(shadows @[]replShadow, d @ast.Decl) @[]replShadow {
	var why @[]char
	if d.Kind == ast.DECL_VAR {
		why = "incompatible type"
	} else if d.Kind == ast.DECL_CONST {
		why = "redeclared as a constant"
	} else if d.Kind == ast.DECL_FUNC && d.Recv == nil {
		why = "redeclared as a function"
	} else {
		return shadows
	}
	if isBlankReplName(d.Name) { return shadows }
	var hidden @[]char = buf.Concat(buf.Concat("__repl_shadowed_", strconv.Itoa(s.InitCounter)), "_")
	hidden = buf.Concat(hidden, d.Name)
	if !irgen.ShadowReplGlobal(s.MainGc, d.Name, hidden) { return shadows }
	s.InitCounter = s.InitCounter + 1
	s.Vm.RenameGlobal(d.Name, hidden)
	var sh replShadow
	sh.Name = buf.CopyStr(d.Name)
	sh.Hidden = hidden
	sh.Why = why
	return slices.Append[replShadow](shadows, sh)
}

// commitShadows completes what shadowRebound recorded, once the declaration
// that rebound the names is emitted: it reports each variable shadowed, and
// shadows the instances of each generic function (shadowGenericInstances).
func (s @kernel) commitShadows(shadows @[]replShadow) {
	for i := 0; i < len(shadows); i++ {
		if shadows[i].Generic {
			var names @[]@[]char = irgen.ShadowReplGenericFunc(s.MainGc, shadows[i].Name)
			for j := 0; j < len(names); j++ {
				s.Vm.UnbindFunc(names[j])
			}
			continue
		}
		s.out("warning: variable ")
		s.out(shadows[i].Name)
		s.out(" shadowed (")
		s.out(shadows[i].Why)
		s.outln("); existing references retain the old variable")
	}
}

// unshadow gives each variable shadowRebound shadowed its name back: the
// declaration that rebound it was not emitted.  (A generic function's instances
// are shadowed only once it is: nothing to give back.)
func (s @kernel) unshadow(shadows @[]replShadow) {
	for i := 0; i < len(shadows); i++ {
		if shadows[i].Generic { continue }
		irgen.ShadowReplGlobal(s.MainGc, shadows[i].Hidden, shadows[i].Name)
		s.Vm.RenameGlobal(shadows[i].Hidden, shadows[i].Name)
	}
}

// initReplVar runs the variable declaration d's initializer, or — for a
// replaced variable declared without one — resets it to its zero value.
func (s @kernel) initReplVar(d @ast.Decl, replaced bool) {
	if d.Value != nil {
		s.runReplVarInit(d)
	} else if replaced {
		s.runReplSynthetic(irgen.MakeZeroAssignStmts(d))
	}
}
