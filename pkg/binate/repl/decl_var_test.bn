package "pkg/binate/repl"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for decl_var.bn: a variable redeclared at the prompt.  replTurn /
// noticesIn live in decl_retry_test.bn, containsSub in decl_test.bn.

// countGlobals returns how many of the session module's globals are named name.
func countGlobals(s @kernel, name *[]readonly char) int {
	var n int = 0
	for i := 0; i < len(s.MainMod.Globals); i++ {
		if containsSub(s.MainMod.Globals[i].Name, name) && len(s.MainMod.Globals[i].Name) == len(name) {
			n = n + 1
		}
	}
	return n
}

// The same type replaces the variable: it keeps its one global.
func TestReplVarRedeclaredSameTypeReplaced() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "var q int = 1\n")
	var before int = len(s.MainMod.Globals)
	replTurn(s, "var q int = 2\n")
	if len(s.curErrs) != 0 { return fail("the redeclaration must check") }
	if len(s.MainMod.Globals) != before { return fail("a replaced variable gets no new global") }
	if containsSub(noticesIn(s), "shadowed") { return fail("a replacement is not a shadow") }
	return ""
}

// Another type shadows the variable: the old global is renamed out of the way,
// with a warning, and a new one takes the name.
func TestReplVarRedeclaredOtherTypeShadowed() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "var x int = 1\n")
	replTurn(s, "var x bool = true\n")
	if !containsSub(noticesIn(s), "warning: variable x shadowed (incompatible type)") {
		return fail(buf.Concat("the shadow must be reported; notices:\n", noticesIn(s)))
	}
	if countGlobals(s, "x") != 1 { return fail("exactly one global must be named x") }
	var hidden bool = false
	for i := 0; i < len(s.MainMod.Globals); i++ {
		if containsSub(s.MainMod.Globals[i].Name, "__repl_shadowed_") { hidden = true }
	}
	if !hidden { return fail("the old x must be renamed") }
	return ""
}

// A constant or a function taking a variable's name shadows it too, so a
// variable declared under the name later is a new one.
func TestReplVarShadowedByConstAndFunc() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "var q int = 1\n")
	replTurn(s, "const q = 2\n")
	if !containsSub(noticesIn(s), "warning: variable q shadowed (redeclared as a constant)") {
		return fail(buf.Concat("the constant must shadow q; notices:\n", noticesIn(s)))
	}
	if countGlobals(s, "q") != 0 { return fail("no global may be named q") }
	replTurn(s, "var q @[]char = \"ab\"\n")
	if countGlobals(s, "q") != 1 { return fail("the new q must be one global") }
	replTurn(s, "var u int = 1\n")
	replTurn(s, "func u() int { return 2 }\n")
	if !containsSub(noticesIn(s), "warning: variable u shadowed (redeclared as a function)") {
		return fail(buf.Concat("the function must shadow u; notices:\n", noticesIn(s)))
	}
	return ""
}
