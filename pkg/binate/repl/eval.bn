package "pkg/binate/repl"

import "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irgen"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/binate/vm"
import "pkg/std/strconv"

// evalReplLine evaluates a REPL code unit (unit.bn): it parses the whole unit,
// and on a parse error reports it and runs nothing; otherwise it evaluates the
// entries in order — an import (evalReplImport, mid_session_import.bn), a
// top-level declaration (evalReplDecl, decl_group.bn; it registers a persistent
// symbol), a run of statements (evalReplStmtList, below; a synthetic function
// is generated, lowered and called).  An entry that fails — reports an error,
// faults, or is interrupted — ends the unit, since the entries after it may
// depend on it; errors it reports for other declarations (parked ones it lets
// resolve) do not.  The turn's VM status starts clean (resetTurnOutput).
func (s @kernel) evalReplLine(src @[]uint8) {
	var p @parser.Parser = parser.New(src, "<repl>")
	var entries @[]replEntry = parseReplUnit(p)
	var perrs @[]parser.ParseError = p.Errors()
	if len(perrs) > 0 {
		for i := 0; i < len(perrs); i++ {
			s.errln(parser.FormatParseError(perrs[i]))
		}
		return
	}
	for i := 0; i < len(entries); i++ {
		var ok bool = true
		if entries[i].Kind == entryImport {
			ok = s.evalReplImport(entries[i].Specs)
		} else if entries[i].Kind == entryDecl {
			ok = s.evalReplDecl(entries[i].Decl)
		} else {
			s.evalReplStmtList(entries[i].Stmts)
		}
		if !ok || s.Vm.Status != vm.VM_STATUS_CONTINUE { return }
	}
}

// callTurnCode calls vmf, one of the turn's calls into the VM, and reports
// whether it completed.  A fault is reported as the call returns, as one of the
// turn's diagnostics, and the VM's status cleared: the VM clears its status and
// fault message at its next call, and one entry can make several (a var group's
// initializers, those of the parked declarations it lets resolve), so a fault
// left for finishTurn to report would be lost, the turn reported clean.  The
// diagnostic is led by faultPrefix ("" for none): a variable's initializer names
// the variable, so a fault that ends the unit can be told from one in a parked
// declaration the entry lets resolve.  A suspension or a break stays in the
// status, for finishTurn, and the turn runs no more code: a later call would
// clear it from the status, and run code after the host asked to stop.
func (s @kernel) callTurnCode(vmf @vm.VMFunc, faultPrefix *[]readonly char) bool {
	if s.Vm.Status != vm.VM_STATUS_CONTINUE { return false }
	var noArgs @[]int
	s.Vm.CallByVMFunc(vmf, noArgs)
	if s.Vm.Status == vm.VM_STATUS_FAULTED {
		s.curErrs = appendDiag(s.curErrs, buf.Concat(faultPrefix, s.Vm.FaultMsg))
		s.Vm.Status = vm.VM_STATUS_CONTINUE
		return false
	}
	return s.Vm.Status == vm.VM_STATUS_CONTINUE
}

// lowerGenerated lowers the functions IR-gen appended to the session module
// since index from while generating a prompt entry whose own function is
// body (lowered by the caller, after these, so its eager CallCache fill
// resolves their names): instantiations of the generic functions and methods
// it uses, function literals, and — drained here (EnsureReplBodyHelpers) —
// the destructor / copy helpers its shapes need.
func (s @kernel) lowerGenerated(from int, body @ir.Func) {
	irgen.EnsureReplBodyHelpers(s.MainMod)
	for i := from; i < len(s.MainMod.Funcs); i++ {
		if !same(s.MainMod.Funcs[i], body) {
			s.Vm.LowerOneFunc(s.MainMod, s.MainMod.Funcs[i])
		}
	}
}

// lowerPendingImpls builds the VM vtables of the impl rows the session module
// gained since the last call.  IR-gen mints a row where a prompt boxes a value
// into an interface — an implicit `T : any` for a value boxed into `*any`, a
// generic receiver's instantiation — in a statement, a function body or a
// variable initializer, and the per-function LowerOneFunc path does not run
// the module vtable pass; a box resolves its vtable by name when it runs, so
// every row is lowered before any prompt code runs (else "interface vtable
// not found").  A vtable's slots are resolved when it is built, after the
// functions they name are lowered; a row is lowered once (the VM keeps the
// first vtable of a name).
func (s @kernel) lowerPendingImpls() {
	if len(s.MainMod.Impls) > s.ImplsLowered {
		s.Vm.LowerNewImpls(s.MainMod, s.ImplsLowered)
		s.ImplsLowered = len(s.MainMod.Impls)
	}
}

// evalReplStmtList evaluates a unit's run of statements (at most one, at its
// end): check → IR-gen as the synthetic __repl_<n>() → lower → call.
func (s @kernel) evalReplStmtList(ss @[]@ast.Stmt) {
	if len(ss) == 0 { return }
	var prevErrs int = len(s.Chk.CheckerErrors())
	s.Chk.CheckStmtListInScope(ss)
	var allErrs @[]types.CheckError = s.Chk.CheckerErrors()
	if len(allErrs) > prevErrs {
		for i := prevErrs; i < len(allErrs); i++ {
			s.errln(check.FormatCheckError(allErrs[i]))
		}
		return
	}
	var name @[]char = buf.Concat("__repl_", strconv.Itoa(s.Counter))
	var preFuncs int = len(s.MainMod.Funcs)
	var f @ir.Func = irgen.GenSyntheticFunc(s.MainGc, name, ss)
	s.MainMod.AddFunc(f)
	s.lowerGenerated(preFuncs, f)
	var vmf @vm.VMFunc = s.Vm.LowerOneFunc(s.MainMod, f)
	if vmf == nil { return }
	s.lowerPendingImpls()
	s.callTurnCode(vmf, "")
}
