package "pkg/binate/repl"

import "pkg/binate/ir"
import "pkg/builtins/testing"

// Tests for eval.bn: the statement-list path, and callTurnCode's reporting
// of a fault as the call that raised it returns.  setupReplState / toBytesRT /
// seq / fail live in testsupport_test.bn; containsSub in decl_test.bn.

// A valid stmt-list turn must add a synthetic __repl_<n> function
// to the module — the marker the loop uses to confirm the entry
// landed. Tier 1 contract. (`_ = "hi"` is a stmt; `var x int = 1`
// would be routed through the top-level-decl path.)
func TestEvalReplStmtListAddsSyntheticFunc() testing.TestResult {
	var s @kernel = setupReplState()
	var before int = len(s.MainMod.Funcs)
	s.Counter = 7
	s.evalReplLine(toBytesRT("_ = \"hi\"\n"))
	if len(s.MainMod.Funcs) != before + 1 {
		return fail("expected one new func added to module")
	}
	var added @ir.Func = s.MainMod.Funcs[before]
	// __repl_<n> is the synthetic name evalReplStmtList uses.
	// IR-gen qualifies func names with the module's pkg short name,
	// so the loaded "main" package prefixes the synthetic.
	var expected @[]char = "main.__repl_7"
	if !seq(added.Name, expected) {
		return fail("synthetic func should be named main.__repl_7")
	}
	return ""
}

// A parse error must NOT add a function. The REPL is supposed to
// leave loaded state untouched on bad input; a stray func sneaking
// in would be a regression that violates that contract.
func TestEvalReplStmtListParseErrorPreservesState() testing.TestResult {
	var s @kernel = setupReplState()
	var before int = len(s.MainMod.Funcs)
	// Unbalanced brace — parser rejects.
	s.evalReplLine(toBytesRT("if x {\n"))
	if len(s.MainMod.Funcs) != before {
		return fail("parse error must not add a func")
	}
	return ""
}

// A type error must NOT add a function, same contract as the
// parse-error case. `_ = undefinedSym` is a stmt (not a
// top-level decl), so the dispatch goes to evalReplStmtList; the
// reference fails to resolve in the checker.
func TestEvalReplStmtListTypeErrorPreservesState() testing.TestResult {
	var s @kernel = setupReplState()
	var before int = len(s.MainMod.Funcs)
	s.evalReplLine(toBytesRT("_ = undefinedSym\n"))
	if len(s.MainMod.Funcs) != before {
		return fail("type error must not add a func")
	}
	return ""
}

// Boxing into `*any` in a variable initializer at the prompt runs: the impl
// row IR-gen mints for the box gets its VM vtable before the initializer
// runs (lowerPendingImpls), not "interface vtable not found".
func TestReplBoxInVarInitLowersVtable() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "var xs *[]int\n")
	replTurn(s, "var a *any = xs\n")
	if len(s.curErrs) != 0 {
		return fail(s.curErrs[0].Value)
	}
	return ""
}

// Boxing into `*any` in a function declared at one prompt and run by a later
// one runs: the row minted when the function was generated is lowered before
// the later prompt runs it.
func TestReplBoxInFuncBodyLowersVtable() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "var xs *[]int\n")
	replTurn(s, "func g() { var a *any = xs; _ = a }\n")
	replTurn(s, "g()\n")
	if len(s.curErrs) != 0 {
		return fail(s.curErrs[0].Value)
	}
	return ""
}

// A var declared in a block at the prompt is a local of the prompt's function:
// its initializer — typed or inferred, alone or in a group — is a borrowing
// position, as a `:=` one is, so a value composite element may be borrowed into
// `*any`.
func TestReplBlockVarInitIsBorrowing() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "type Opts struct { Any *any }\n")
	replTurn(s, "if true { var o = Opts{Any: 44}; var p Opts = Opts{Any: 45}; _ = o; _ = p }\n")
	if len(s.curErrs) != 0 {
		return fail(s.curErrs[0].Value)
	}
	replTurn(s, "if true { var ( o = Opts{Any: 46}; p Opts = Opts{Any: 47} ); _ = o; _ = p }\n")
	if len(s.curErrs) != 0 {
		return fail(s.curErrs[0].Value)
	}
	return ""
}

// A fault in a var group's member is reported, and ends the group: the members
// after it are not declared.  (Each initializer is its own call into the VM,
// which clears the previous call's fault.)
func TestFaultInVarGroupReported() testing.TestResult {
	s := setupReplState()
	s.Execute(toBytesRT("var arr [2]int"))
	s.Execute(toBytesRT("var k int = 5"))
	var r Result = s.Execute(toBytesRT("var ( b int = arr[k]; c int = 1 )"))
	if r.Status != EXEC_ERROR || len(r.Err) != 1 ||
			!containsSub(r.Err[0].Value,
					"initialization of variable b faulted: runtime error: index out of bounds: 5") {
		return fail("the faulting member's initializer should be the turn's one error")
	}
	r = s.Execute(toBytesRT("_ = c"))
	if len(r.Err) != 1 || !containsSub(r.Err[0].Value, "undefined: c") {
		return fail("the member after a faulting one should not be declared")
	}
	return ""
}

// A declaration whose initializer faults reports the fault though the parked
// declaration it lets resolve then runs its own initializer cleanly.
func TestFaultBeforeResolvedParkedReported() testing.TestResult {
	s := setupReplState()
	s.Execute(toBytesRT("var arr [2]int"))
	s.Execute(toBytesRT("var k int = 5"))
	s.Execute(toBytesRT("var z int = w + 1"))
	var r Result = s.Execute(toBytesRT("var w int = arr[k]"))
	if r.Status != EXEC_ERROR || len(r.Err) != 1 ||
			!containsSub(r.Err[0].Value,
					"initialization of variable w faulted: runtime error: index out of bounds: 5") {
		return fail("w's faulting initializer should be reported")
	}
	return ""
}

// An interruption ends the turn's code: after a declaration's initializer is
// broken, the parked declaration it lets resolve is not initialized (which
// would clear the break from the status), and the turn reports the break.
func TestInterruptEndsTurnCode() testing.TestResult {
	s := setupReplState()
	s.Execute(toBytesRT("func spin() int { n := 0; for i := 0; i < 10; i++ { n = n + i }; return n }"))
	s.Execute(toBytesRT("var z int = w + 1"))
	var ctr @pollCounter = make(pollCounter)
	var poll @func() PollResult = func() PollResult {
		ctr.Hits = ctr.Hits + 1
		if ctr.Hits == 3 { return POLL_BREAK }
		return POLL_CONTINUE
	}
	s.SetPoll(poll)
	var r Result = s.Execute(toBytesRT("var w int = spin()"))
	if ctr.Hits < 3 || r.Status != EXEC_BROKE {
		return fail("a break in w's initializer should be the turn's outcome")
	}
	return ""
}
