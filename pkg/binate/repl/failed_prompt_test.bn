package "pkg/binate/repl"

import "pkg/builtins/testing"

// A prompt that fails to check is reported and not run, even when its errors
// repeat an earlier prompt's; and a declaration that fails leaves nothing
// bound.  setupReplState / toBytesRT / fail live in testsupport_test.bn.

// replPromptRejected runs line as a fresh prompt and reports whether it was
// rejected: an error reported and no synthetic function added.
func replPromptRejected(s @kernel, line *[]readonly char) bool {
	s.resetTurnOutput()
	var before int = len(s.MainMod.Funcs)
	s.evalReplLine(toBytesRT(line))
	return len(s.curErrs) > 0 && len(s.MainMod.Funcs) == before
}

// replPromptNotRun runs line as a fresh prompt and reports whether it was not
// run: no synthetic function added (it was rejected, or parked on a name not
// yet declared).
func replPromptNotRun(s @kernel, line *[]readonly char) bool {
	s.resetTurnOutput()
	var before int = len(s.MainMod.Funcs)
	s.evalReplLine(toBytesRT(line))
	return len(s.MainMod.Funcs) == before
}

// The same mistake entered twice is rejected twice — its errors, all at
// `<repl>:1:<col>`, are not dropped as duplicates of the first prompt's.
func TestReplRepeatedMistakeRejectedAgain() testing.TestResult {
	var s @kernel = setupReplState()
	if !replPromptRejected(s, "u[0] = 5\n") {
		return fail("the first u[0] = 5 must be rejected")
	}
	if !replPromptRejected(s, "u[0] = 5\n") {
		return fail("the repeated u[0] = 5 must be rejected, not run")
	}
	if !replPromptRejected(s, "u = 5\n") {
		return fail("u = 5 after u[0] = 5 must be rejected, not run")
	}
	return ""
}

// A variable declaration that fails to check (a type error — a missing name
// instead parks it until the name is declared) is undone: its name is unbound
// afterwards, so a later use waits for it rather than running, and a failed
// redefinition leaves the earlier binding in place.
func TestReplFailedVarDeclLeavesNothingBound() testing.TestResult {
	var s @kernel = setupReplState()
	if !replPromptRejected(s, "var z = 1 + true\n") {
		return fail("var z = 1 + true must be rejected")
	}
	if !replPromptNotRun(s, "var w int = z\n") {
		return fail("z must be unbound after its declaration failed, so w is not run")
	}
	if replPromptRejected(s, "var k int = 1\n") {
		return fail("var k int = 1 must succeed")
	}
	if !replPromptRejected(s, "var k int = 1 + true\n") {
		return fail("var k int = 1 + true must be rejected")
	}
	if replPromptRejected(s, "var j int = k + 1\n") {
		return fail("k must keep its earlier int binding after a failed redefinition")
	}
	return ""
}

// A method declaration that fails to check (a type error) is undone: the
// method is not registered, so a later call of it waits rather than running.
func TestReplFailedMethodDeclNotRegistered() testing.TestResult {
	var s @kernel = setupReplState()
	if replPromptRejected(s, "type T struct {\n\tn int\n}\n") {
		return fail("type T must succeed")
	}
	if !replPromptRejected(s, "func (t *T) M() int { return true }\n") {
		return fail("a method returning a bool as an int must be rejected")
	}
	if replPromptRejected(s, "var t T\n") {
		return fail("var t T must succeed")
	}
	if !replPromptNotRun(s, "var q int = t.M()\n") {
		return fail("t.M() must not run: the failed method is not registered")
	}
	return ""
}

// The same declaration error entered twice is rejected twice.
func TestReplRepeatedDeclErrorRejectedAgain() testing.TestResult {
	var s @kernel = setupReplState()
	if !replPromptRejected(s, "var z = 1 + true\n") {
		return fail("the first var z = 1 + true must be rejected")
	}
	if !replPromptRejected(s, "var z = 1 + true\n") {
		return fail("the repeated var z = 1 + true must be rejected, not run")
	}
	return ""
}

// A declaration that fails (its signature names an undeclared type) and parks
// (its body waits on another name) in one check is dropped whole: declaring
// the missing type later does not revive and emit it.
func TestReplFailedParkedDeclNotRevived() testing.TestResult {
	var s @kernel = setupReplState()
	if !replPromptRejected(s, "func f(a Undef) int { return zz }\n") {
		return fail("f with an undeclared parameter type must be rejected")
	}
	if replPromptRejected(s, "type Undef int\n") {
		return fail("type Undef int must succeed")
	}
	if moduleHasFunc(s.MainMod, "main.f") {
		return fail("the failed f must not be revived when Undef is declared")
	}
	if !replPromptNotRun(s, "var q int = f(1)\n") {
		return fail("a call of the failed f must not run")
	}
	return ""
}

// A failed method redefinition keeps the earlier method: calling it runs.
func TestReplFailedMethodRedefinitionKeepsOld() testing.TestResult {
	var s @kernel = setupReplState()
	if replPromptRejected(s, "type T struct {\n\tn int\n}\n") {
		return fail("type T must succeed")
	}
	if replPromptRejected(s, "func (t *T) M() int { return 1 }\n") {
		return fail("the first M must succeed")
	}
	if !replPromptRejected(s, "func (t *T) M() int { return true }\n") {
		return fail("the bad redefinition of M must be rejected")
	}
	if replPromptRejected(s, "var t T\n") {
		return fail("var t T must succeed")
	}
	if replPromptNotRun(s, "var q int = t.M()\n") {
		return fail("t.M() must run: the earlier M is kept")
	}
	return ""
}

// A const group that fails is undone as a whole: its members are unbound.
func TestReplFailedConstGroupUndone() testing.TestResult {
	var s @kernel = setupReplState()
	if !replPromptRejected(s, "const (\n\tA = 1\n\tB = 1 + true\n)\n") {
		return fail("a const group with a bad member must be rejected")
	}
	if !replPromptNotRun(s, "var q int = A\n") {
		return fail("A must be unbound after its group failed")
	}
	return ""
}
