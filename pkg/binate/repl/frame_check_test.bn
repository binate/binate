package "pkg/binate/repl"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for the frame check at the prompt (entryLoadErrors, vm.FrameCheck): a function whose
// frame passes the target's limit — a 32-bit target's 4 GiB, or on a 64-bit target a sum
// that saturates — does not load, is not kept, and the session goes on.  The session runs
// on the host's own target, so the frame is chosen by its width.  setupReplStateSrc is
// testsupport_test.bn's, errHas and execOK decl_blank_type_test.bn's.

// bigFrameDecl returns a function declaration whose frame passes this host's target's limit.
func bigFrameDecl() *[]readonly char {
	if sizeof(int) == 4 {
		return "func big() int { var x [0x7FFFFFF8]uint8; var y [0x7FFFFFF8]uint8; var z [64]uint8; "
				"x[5] = 1; y[6] = 2; z[7] = 3; return cast(int, x[5]) + cast(int, y[6]) + cast(int, z[7]) }"
	}
	return "func big() int { var x [0x7FFFFFFFFFFFFFF0]uint8; var y [0x7FFFFFFFFFFFFFF0]uint8; "
			"var z [64]uint8; x[5] = 1; y[6] = 2; z[7] = 3; "
			"return cast(int, x[5]) + cast(int, y[6]) + cast(int, z[7]) }"
}

func TestReplFrameTooLargeIsNotKept() testing.TestResult {
	var s @kernel = setupReplStateSrc("package \"main\"\nfunc main() { }\n")
	var r Result = s.Execute(toBytesRT(bigFrameDecl()))
	if r.Status != EXEC_ERROR || !errHas(r, "the frame of main.big is larger than the target allows") {
		return fail("big's frame should fail it to load")
	}
	r = s.Execute(toBytesRT("_ = big"))
	if !errHas(r, "undefined: big") {
		var e @[]char = "big should not be kept:"
		for i := 0; i < len(r.Err); i++ { e = buf.Concat(buf.Concat(e, " | "), r.Err[i].Value) }
		return fail(e)
	}
	if !execOK(s, "var k int = 1") { return fail("the session should go on") }
	return ""
}
