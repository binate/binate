package "pkg/binate/repl"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Regression test for increment 5c-2c (adversarial-review follow-up a):
// the function-literal / anon-struct counters live on @GenCtx, so a
// mid-session `import` — which runs a full GeneratePackage on a SEPARATE
// per-package gc — must NOT reset the session's counter and make a later
// prompt's function literal re-issue `__funclit_0`, colliding with an earlier
// prompt's lifted func in the persistent s.MainMod.  Before 5c-2c the counter
// was a package-global that the foreign GeneratePackage reset to 0.
//
// setupReplState leaves the loader/import fields zero (unit tests can't do a
// filesystem import — that path is covered by e2e/repl.sh), so this drives the
// bug's MECHANISM directly: a GeneratePackage on a fresh foreign module/gc
// between two funclit-bearing prompts.  seq / fail / setupReplState /
// toBytesRT live in testsupport_test.bn; moduleHasFunc in decl_test.bn.
func TestReplFuncLitCounterSurvivesForeignGen() testing.TestResult {
	var s @replSession = setupReplState()

	// Prompt 1: a named func whose body contains a function literal — the
	// literal lifts to main.__funclit_0.
	s.evalReplLine(toBytesRT(
			"func g0() int { var x = func() int { return 1 }; return x() }\n"))
	if !moduleHasFunc(s.MainMod, "main.__funclit_0") {
		return fail("prompt 1's inner funclit should lift to main.__funclit_0")
	}

	// Simulate what a mid-session `import` does: a full GeneratePackage on a
	// SEPARATE module/gc (which calls resetFuncLitState on THAT gc).  With the
	// pre-5c-2c global counter this zeroed the shared funclit counter.
	var isrc *[]readonly char = "package \"other\"\nfunc helper() int { return 7 }\n"
	var ip @parser.Parser = parser.New(toBytesRT(isrc), "<other>")
	var ifile @ast.File = ip.ParseFile()
	var oc @types.Checker = types.NewChecker()
	oc.Check(ifile)
	var omod @ir.Module = ir.InitModule(ifile.PkgName)
	var ogc @ir.GenCtx = ir.NewGenCtx(omod)
	var noFiles @[]@ast.File = make_slice(@ast.File, 0)
	ir.GeneratePackage(oc, ifile, ogc, noFiles)

	// Prompt 2: another funclit must lift to main.__funclit_1 — NOT re-issue
	// __funclit_0 and collide.
	s.evalReplLine(toBytesRT(
			"func g1() int { var y = func() int { return 2 }; return y() }\n"))
	if !moduleHasFunc(s.MainMod, "main.__funclit_1") {
		return fail(
				"prompt 2 funclit should be main.__funclit_1 (counter survived foreign gen)")
	}
	// And the first lifted func must still be present (not overwritten by a
	// colliding __funclit_0).
	if !moduleHasFunc(s.MainMod, "main.__funclit_0") {
		return fail("main.__funclit_0 must persist — no __funclit_0 collision")
	}
	return ""
}

// nameHasMethodval reports whether a func name contains the method-value
// wrapper marker `__methodval_` (synthMethodValueWrapper's stable per-(method,
// recv-shape) name).
func nameHasMethodval(s *[]readonly char) bool {
	var sub *[]readonly char = "__methodval_"
	for i := 0; i + len(sub) <= len(s); i++ {
		var ok bool = true
		for j := 0; j < len(sub); j++ {
			if s[i + j] != sub[j] { ok = false }
		}
		if ok { return true }
	}
	return false
}

func mvWrapperCount(m @ir.Module) int {
	var n int = 0
	for i := 0; i < len(m.Funcs); i++ {
		if nameHasMethodval(m.Funcs[i].Name) { n = n + 1 }
	}
	return n
}

// Companion to the funclit-counter test, for the 5d-3a methodValueWrappers
// move (adversarial-review follow-up: the wrapper DEDUP CACHE moved off the
// package-global onto @Module).  A `T.M` method value synthesizes a wrapper
// func and records its name in the cache so a second use of the same method
// value reuses it.  Pre-5d-3a a mid-session import's foreign GeneratePackage
// (-> resetFuncLitState) zeroed the SHARED cache, so a later prompt's identical
// method value no longer found the wrapper and re-synthesized a duplicate into
// the persistent s.MainMod.  Per-@Module, the foreign reset can't touch the
// session module's cache.
func TestReplMethodValueCacheSurvivesForeignGen() testing.TestResult {
	var s @replSession = setupReplState()
	// A type + value-receiver method to take a method value of.
	s.evalReplLine(toBytesRT("type Pt struct { v int }\n"))
	s.evalReplLine(toBytesRT("func (p Pt) m() int { return p.v }\n"))

	// Prompt 1: take the method value Pt.m -> synthesizes a __methodval_ wrapper
	// into s.MainMod and records it in the per-@Module cache.
	s.evalReplLine(toBytesRT(
			"func u0() int { var p Pt; var f = p.m; return f() }\n"))
	var c1 int = mvWrapperCount(s.MainMod)
	if c1 < 1 {
		return fail("prompt 1 should synthesize a method-value wrapper")
	}

	// Foreign GeneratePackage on a fresh module/gc — the mid-session-import
	// trigger that calls resetFuncLitState on THAT gc (pre-5d-3a: zeroed the
	// shared methodValueWrappers cache).
	var isrc *[]readonly char = "package \"other\"\nfunc helper() int { return 7 }\n"
	var ip @parser.Parser = parser.New(toBytesRT(isrc), "<other2>")
	var ifile @ast.File = ip.ParseFile()
	var oc @types.Checker = types.NewChecker()
	oc.Check(ifile)
	var omod @ir.Module = ir.InitModule(ifile.PkgName)
	var ogc @ir.GenCtx = ir.NewGenCtx(omod)
	var noFiles @[]@ast.File = make_slice(@ast.File, 0)
	ir.GeneratePackage(oc, ifile, ogc, noFiles)

	// Prompt 2: take the SAME method value Pt.m again.  With the per-@Module
	// cache intact it is deduped (no new wrapper); pre-5d-3a the foreign reset
	// forgot it and a duplicate wrapper was synthesized into s.MainMod.
	s.evalReplLine(toBytesRT(
			"func u1() int { var p Pt; var f = p.m; return f() }\n"))
	if mvWrapperCount(s.MainMod) != c1 {
		return fail(
				"same method value should reuse the cached wrapper, not synthesize a duplicate")
	}
	return ""
}
