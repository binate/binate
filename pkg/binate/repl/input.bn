package "pkg/binate/repl"

// REPL input helpers used by Step's accumulation logic.  Both are
// standalone (no dependence on the type checker / IR / VM): a one-byte
// append helper (appendByteRepl) and the multi-line continuation
// heuristic (computeOpenDepth) that decides whether the accumulated
// input is complete.  Reading a line from an actual input source is the
// host's job — the host pushes each line into Step — so it lives with
// the host, not here.

// appendByteRepl is a minimal append helper for @[]uint8.  REPL-
// local; pkg/binate/buf has richer string helpers but this avoids pulling
// in extra surface for one byte at a time.
func appendByteRepl(s @[]uint8, b uint8) @[]uint8 {
	var n int = len(s)
	var ns @[]uint8 = make_slice(uint8, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = b
	return ns
}

// computeOpenDepth scans `src` and returns the running open-bracket
// depth — the count of unclosed `{` plus unclosed `(`, ignoring
// any inside string literals (`"..."`), char literals (`'...'`),
// line comments (`// ...`), or block comments (`/* ... */`).
//
// Used by the REPL loop to decide whether the accumulated input is
// complete (depth 0) or whether to keep reading on a continuation
// prompt.  A negative depth — more closes than opens — is clamped
// to 0 so the parser can see and report the imbalance.
//
// Heuristic, not a real parser: a counter shared between `{` and
// `(` will balance even on syntactically wrong interleavings like
// `{(}`).  The parser catches those; this function only decides
// "is more input expected?".
func computeOpenDepth(src *[]readonly uint8) int {
	var depth int = 0
	var i int = 0
	var n int = len(src)
	for i < n {
		var c uint8 = src[i]
		// `// ...` line comment — skip to next newline.
		if c == 47 && i + 1 < n && src[i + 1] == 47 {
			i = i + 2
			for i < n && src[i] != 10 { i = i + 1 }
			continue
		}
		// `/* ... */` block comment — skip to closing `*/`.
		if c == 47 && i + 1 < n && src[i + 1] == 42 {
			i = i + 2
			for i + 1 < n {
				if src[i] == 42 && src[i + 1] == 47 {
					i = i + 2
					break
				}
				i = i + 1
			}
			continue
		}
		// `"..."` string — skip to closing quote, honouring `\`-escapes.
		if c == 34 {
			i = i + 1
			for i < n && src[i] != 34 {
				if src[i] == 92 && i + 1 < n {
					i = i + 2
				} else {
					i = i + 1
				}
			}
			if i < n { i = i + 1 }
			continue
		}
		// `'...'` char literal — same shape as string but at most
		// one logical char (plus optional `\`-escape).
		if c == 39 {
			i = i + 1
			for i < n && src[i] != 39 {
				if src[i] == 92 && i + 1 < n {
					i = i + 2
				} else {
					i = i + 1
				}
			}
			if i < n { i = i + 1 }
			continue
		}
		if c == 123 { depth = depth + 1 } // '{'
		if c == 40 { depth = depth + 1 } // '('
		if c == 125 || c == 41 {
			// '}' or ')'
			depth = depth - 1
			if depth < 0 { depth = 0 }
		}
		i = i + 1
	}
	return depth
}
