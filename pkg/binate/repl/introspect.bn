package "pkg/binate/repl"

// Complete / Inspect are the identifier-completion and symbol-introspection
// entry points of the Kernel surface.  They are STUBS (returning "no
// matches" / "not found"): the real implementations need scope-enumeration
// and symbol doc/signature APIs in the checker (pkg/binate/check) that do
// not exist yet.  Declaring them now keeps the Kernel interface whole,
// so a host can target the full query surface.

// Complete returns identifier-completion matches at cursorPos.  Stub: no
// matches, with an empty replacement span at the cursor.  The real version
// would draw on the persistent checker's live scope + the loader's symbol graph.
func (s @kernel) Complete(code *[]readonly uint8, cursorPos int) Completion {
	var c Completion
	c.CursorStart = cursorPos
	c.CursorEnd = cursorPos
	return c
}

// Inspect returns introspection at cursorPos.  Stub: not found.  The real
// version would resolve the identifier via the persistent checker and render
// its kind / type into Inspection.Display.
func (s @kernel) Inspect(code *[]readonly uint8, cursorPos int) Inspection {
	var i Inspection
	i.Found = false
	return i
}
