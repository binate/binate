package "pkg/binate/repl"

// Complete / Inspect are the identifier-completion and symbol-introspection
// entry points of the Kernel surface.  They are STUBS in this increment
// (returning "no matches" / "not found"): the real implementations need
// scope-enumeration and symbol doc/signature APIs in pkg/binate/types that
// do not exist yet, and land as Inc 2 (Complete) and Inc 3 (Inspect) of
// plan-repl-kernel.md.  Declaring them now keeps the Kernel interface whole,
// so a host can target the full query surface.

// Complete returns identifier-completion matches at cursorPos.  Stub: no
// matches, with an empty replacement span at the cursor.  Inc 2 drives it
// off the persistent checker's live scope + the loader's symbol graph.
func (s @kernel) Complete(code *[]readonly uint8, cursorPos int) Completion {
	var c Completion
	c.CursorStart = cursorPos
	c.CursorEnd = cursorPos
	return c
}

// Inspect returns introspection at cursorPos.  Stub: not found.  Inc 3
// resolves the identifier via the persistent checker and renders its
// kind / type into Inspection.Display.
func (s @kernel) Inspect(code *[]readonly uint8, cursorPos int) Inspection {
	var i Inspection
	i.Found = false
	return i
}
