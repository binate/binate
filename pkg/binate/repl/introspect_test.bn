package "pkg/binate/repl"

import "pkg/builtins/testing"

// Complete / Inspect are stubs in this increment (Inc 2/3 implement them);
// these pin the stub contract so a later real implementation visibly changes
// them.  setupReplState / toBytesRT / fail live in testsupport_test.bn.

// Complete stub: no matches, replacement span collapsed at the cursor.
func TestCompleteStubReturnsNoMatches() testing.TestResult {
	var s @kernel = setupReplState()
	var c Completion = s.Complete(toBytesRT("prin"), 4)
	if len(c.Matches) != 0 {
		return fail("Complete stub should return no matches")
	}
	if c.CursorStart != 4 || c.CursorEnd != 4 {
		return fail("Complete stub should collapse the replacement span at the cursor")
	}
	return ""
}

// Inspect stub: not found (empty Display).
func TestInspectStubNotFound() testing.TestResult {
	var s @kernel = setupReplState()
	var i Inspection = s.Inspect(toBytesRT("println"), 3)
	if i.Found {
		return fail("Inspect stub should report not-found")
	}
	if len(i.Display) != 0 {
		return fail("Inspect stub should carry no display representations")
	}
	return ""
}
