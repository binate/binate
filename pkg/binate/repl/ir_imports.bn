package "pkg/binate/repl"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irgen"
import "pkg/binate/loader"

// registerPkgImports registers import information for IR gen.  skip lists
// loaded packages that failed type-checking or initialization
// (kernel.FailedPkgs).
func registerPkgImports(ldr @loader.Loader, pkg @loader.Package, skip *[]@[]char,
		gc @irgen.GenCtx) {
	registerAllStructTypes(ldr, skip, gc)
	var aliases @[]@[]char
	var paths @[]@[]char
	var files @[]@ast.File
	if len(pkg.Imports) > 0 {
		for j := 0; j < len(pkg.Imports); j++ {
			var depFile @ast.File = collectPkgFile(
					ldr, pkg.Imports[j])
			if depFile != nil {
				aliases = appendCharSlice(aliases, shortName(pkg.Imports[j]))
				paths = appendCharSlice(paths, pkg.Imports[j])
				files = appendFilePtr(files, depFile)
			}
		}
	}
	if !streq(pkg.Path, "pkg/builtins/rt") {
		appendRtImport(ldr, &aliases, &paths, &files)
	}
	if !streq(pkg.Path, "pkg/builtins/lang") {
		appendLangImport(ldr, &aliases, &paths, &files)
	}
	appendExposeClosure(ldr, pkg.Imports, &aliases, &paths, &files)
	irgen.RegisterImports(aliases, paths, files, gc)
	// The package's own functions are its own, not externs to register.
	var own @[]@[]char
	own = appendCharSlice(own, pkg.Path)
	registerGenericBodyDeps(ldr, ldr.Order, appendPaths(paths, own), skip, gc, true)
}

// registerMainImports registers imports for the main package.
func registerMainImports(ldr @loader.Loader, file @ast.File, skip *[]@[]char, gc @irgen.GenCtx) {
	registerAllStructTypes(ldr, skip, gc)
	var aliases @[]@[]char
	var paths @[]@[]char
	var files @[]@ast.File
	var directImports @[]@[]char
	if len(file.Imports) > 0 {
		for i := 0; i < len(file.Imports); i++ {
			var imp @[]char = unquote(file.Imports[i].Path)
			directImports = appendCharSlice(directImports, imp)
			var depFile @ast.File = collectPkgFile(
					ldr, imp)
			if depFile != nil {
				// The file's own alias for the import (explicit, else the path's
				// last segment), as the checker binds it.
				var alias @[]char = file.Imports[i].Alias
				if len(alias) == 0 { alias = shortName(imp) }
				aliases = appendCharSlice(aliases, alias)
				paths = appendCharSlice(paths, imp)
				files = appendFilePtr(files, depFile)
			}
		}
	}
	appendRtImport(ldr, &aliases, &paths, &files)
	appendLangImport(ldr, &aliases, &paths, &files)
	appendExposeClosure(ldr, directImports, &aliases, &paths, &files)
	irgen.RegisterImports(aliases, paths, files, gc)
	registerGenericBodyDeps(ldr, ldr.Order, paths, skip, gc, true)
}

// registerGenericBodyDeps registers on gc, for the imports of each package in
// scan that has a generic declaration — packages a body monomorphized in gc's
// module may call without gc's package importing them — their function
// signatures, constants and variables (irgen.RegisterGenericBodyDeps; without
// a callee's signature a struct-returning call is lowered as a scalar), and
// their impls, so the body can upcast to one of their interfaces; a package
// that exposes another brings in its home.  A package in registered (gc's own
// imports, registered already) or skip (kernel.FailedPkgs) is left out.
// externs adds the callees' extern Funcs, which a live session module, whose
// func table mirrors the VM's, must not get (a mid-session import).
func registerGenericBodyDeps(ldr @loader.Loader, scan *[]@[]char, registered *[]@[]char,
		skip *[]@[]char, gc @irgen.GenCtx, externs bool) {
	var paths @[]@[]char
	var files @[]@ast.File
	for i := 0; i < len(scan); i++ {
		var pf @ast.File = collectPkgFile(ldr, scan[i])
		if pf == nil || !fileHasGenericDecl(pf) { continue }
		var dp @loader.Package = ldr.GetPackage(scan[i])
		if dp == nil { continue }
		for j := 0; j < len(dp.Imports); j++ {
			var q @[]char = dp.Imports[j]
			if containsPath(paths, q) || containsPath(registered, q) || containsPath(skip, q) { continue }
			var qf @ast.File = collectPkgFile(ldr, q)
			if qf == nil { continue }
			paths = appendCharSlice(paths, q)
			files = appendFilePtr(files, qf)
		}
	}
	var exclude @[]@[]char = appendPaths(paths, registered)
	var closure @[]@[]char = ldr.ExposeClosure(paths, exclude)
	for i := 0; i < len(closure); i++ {
		var cf @ast.File = collectPkgFile(ldr, closure[i])
		if cf == nil || containsPath(skip, closure[i]) { continue }
		paths = appendCharSlice(paths, closure[i])
		files = appendFilePtr(files, cf)
	}
	if len(paths) == 0 { return }
	if externs {
		irgen.RegisterGenericBodyDeps(paths, paths, files, gc)
	} else {
		irgen.RegisterGenericBodyDepSigs(paths, paths, files, gc)
	}
	irgen.RegisterImportedImpls(paths, paths, files, gc)
}

// fileHasGenericDecl reports whether a top-level declaration of f is generic.
func fileHasGenericDecl(f @ast.File) bool {
	for i := 0; i < len(f.Decls); i++ {
		if len(f.Decls[i].TypeParams) > 0 { return true }
	}
	return false
}

// appendPaths returns a followed by b.
func appendPaths(a *[]@[]char, b *[]@[]char) @[]@[]char {
	var out @[]@[]char
	for i := 0; i < len(a); i++ { out = appendCharSlice(out, a[i]) }
	for i := 0; i < len(b); i++ { out = appendCharSlice(out, b[i]) }
	return out
}

// appendExposeClosure registers the transitive expose-closure of the module's
// direct imports: for a direct import that is a forwarder (exposes P), P's
// funcs/consts/vars are declared under P's home path so a resolved-home
// reference `pkg/P.X` through the forwarder resolves.  Uses THIS embedding's
// direct-import registration convention — short-name alias, full-path key (the
// cmd/bnc and interp embeddings use the full path for both).  The already-built
// `paths` is the exclude set.
func appendExposeClosure(ldr @loader.Loader, roots @[]@[]char, aliases *@[]@[]char,
		paths *@[]@[]char, files *@[]@ast.File) {
	var closure @[]@[]char = ldr.ExposeClosure(roots, *paths)
	for i := 0; i < len(closure); i++ {
		var f @ast.File = collectPkgFile(ldr, closure[i])
		if f != nil {
			*aliases = appendCharSlice(*aliases, shortName(closure[i]))
			*paths = appendCharSlice(*paths, closure[i])
			*files = appendFilePtr(*files, f)
		}
	}
}

// appendRtImport adds pkg/builtins/rt as an implicit import if not already
// present.
func appendRtImport(ldr @loader.Loader, aliases *@[]@[]char, paths *@[]@[]char,
		files *@[]@ast.File) {
	for i := 0; i < len(*aliases); i++ {
		if streq((*aliases)[i], "rt") { return }
	}
	var rtPkg @loader.Package = ldr.GetPackage(
			"pkg/builtins/rt")
	if rtPkg == nil { return }
	var rtFile @ast.File
	if rtPkg.BNI != nil {
		rtFile = rtPkg.BNI
	} else if rtPkg.Merged != nil {
		rtFile = rtPkg.Merged
	}
	if rtFile == nil { return }
	*aliases = appendCharSlice(*aliases, "rt")
	*paths = appendCharSlice(*paths, "pkg/builtins/rt")
	*files = appendFilePtr(*files, rtFile)
}

// appendLangImport adds pkg/builtins/lang as an implicit import if not
// already present, so a method on a universe primitive (myInt.String())
// resolves in the IR after the force-load.  Mirrors appendRtImport
// (and cmd/bni/irgen.bn:appendLangImport).
func appendLangImport(ldr @loader.Loader, aliases *@[]@[]char, paths *@[]@[]char,
		files *@[]@ast.File) {
	for i := 0; i < len(*aliases); i++ {
		if streq((*aliases)[i], "lang") { return }
	}
	var langPkg @loader.Package = ldr.GetPackage(
			"pkg/builtins/lang")
	if langPkg == nil { return }
	var langFile @ast.File
	if langPkg.Merged != nil {
		langFile = langPkg.Merged
	} else if langPkg.BNI != nil {
		langFile = langPkg.BNI
	}
	if langFile == nil { return }
	*aliases = appendCharSlice(*aliases, "lang")
	*paths = appendCharSlice(*paths, "pkg/builtins/lang")
	*files = appendFilePtr(*files, langFile)
}

// registerAllStructTypes registers the struct types, interfaces and generic
// decls of every loaded package but those in skip (registerLoadedPkgTypes).
func registerAllStructTypes(ldr @loader.Loader, skip *[]@[]char, gc @irgen.GenCtx) {
	registerLoadedPkgTypes(ldr, pathsWithout(ldr.Order, skip), gc)
}

// pathsWithout returns paths less those in skip, in order.
func pathsWithout(paths *[]@[]char, skip *[]@[]char) @[]@[]char {
	var out @[]@[]char
	for i := 0; i < len(paths); i++ {
		var skipped bool = false
		for j := 0; j < len(skip); j++ {
			if streq(paths[i], skip[j]) { skipped = true }
		}
		if !skipped { out = appendCharSlice(out, paths[i]) }
	}
	return out
}

// registerLoadedPkgTypes registers the struct types, interfaces and generic
// decls of the loaded packages pkgPaths (in dependency order) so IR-gen
// resolves cross-package types: struct names across all the packages first
// (qualified), then their fields — so a field like `Pos token.Pos` in ast.bni
// resolves to the Pos struct, not a TypInt fallback — then the interfaces, and
// the generic decls a cross-package generic body or a generic parent / impl
// interface instantiates (reached transitively, not only through a direct
// import).  Mirrors bnc's and the interpreter's registration.  Every registry
// dedups, so a package registered before is a no-op.
func registerLoadedPkgTypes(ldr @loader.Loader, pkgPaths *[]@[]char, gc @irgen.GenCtx) {
	if len(pkgPaths) == 0 { return }
	var aliases @[]@[]char
	var paths @[]@[]char
	var files @[]@ast.File
	for i := 0; i < len(pkgPaths); i++ {
		var srcPkg @loader.Package = ldr.GetPackage(pkgPaths[i])
		if srcPkg != nil { irgen.RegisterSourceFiles(gc, srcPkg.BNI, srcPkg.Files) }
		var depFile @ast.File = collectPkgFile(ldr, pkgPaths[i])
		if depFile != nil {
			aliases = appendCharSlice(aliases, shortName(pkgPaths[i]))
			paths = appendCharSlice(paths, pkgPaths[i])
			files = appendFilePtr(files, depFile)
		}
	}
	// paths[k] carries each package's import path; the registries
	// use it directly for qualification so two same-last-segment
	// packages get distinct entries instead of colliding under the
	// alias map.  The alias map itself is populated only by the
	// importing module's RegisterImports.
	irgen.RegisterStructTypes(aliases, paths, files, gc)
	irgen.RegisterAllInterfaces(aliases, paths, files, gc)
	irgen.RegisterGenericDecls(aliases, paths, files, gc)
}

// collectPkgFile returns the .bni file (or merged .bn) for a loaded
// package — whichever the loader populated from the -I/-L search paths —
// or nil if the package carries no file.
func collectPkgFile(ldr @loader.Loader, pkgPath *[]readonly char) @ast.File {
	var pkg @loader.Package = ldr.GetPackage(
			pkgPath)
	if pkg == nil { return nil }
	// Prefer merged (.bni + .bn) so IR-gen can distinguish bodied
	// (locally-defined) from unbodied (extern) decls — needed for
	// the sret ABI hint on aggregate-returning externs.
	if pkg.Merged != nil { return pkg.Merged }
	if pkg.BNI != nil { return pkg.BNI }
	return nil
}

// shortName extracts the last component of a package path.
func shortName(path *[]readonly char) @[]char {
	var last int = 0
	for i := 0; i < len(path); i++ {
		if path[i] == '/' { last = i + 1 }
	}
	return buf.CopyStr(path[last:])
}

// unquote removes surrounding quotes from a string.
func unquote(s *[]readonly char) @[]char {
	if len(s) >= 2 && s[0] == '"' && s[len(s) - 1] == '"' {
		return buf.CopyStr(s[1:len(s) - 1])
	}
	return buf.CopyStr(s)
}
