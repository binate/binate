package "pkg/binate/repl"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irgen"

// Loading a prompt entry.  Before an entry's code is lowered or run, its
// functions are load-checked (vm.LoadCheck): one that refers to a package
// variable nothing in the program defines — the VM's counterpart of a compiled
// program's undefined-symbol link error — fails the entry, which is then not
// kept, as one that fails to check is not.

// loadFails reports whether the functions IR-gen generated into the session
// module from index from, for the entry whose generation entry records, fail to
// load (entryLoadErrors), reporting each load error — naming own, the synthetic
// function doing the entry's work (nil for none), as label (relabelLoadErrs).
func (s @kernel) loadFails(from int, entry @irgen.ReplEntry, own @ir.Func,
		label *[]readonly char) bool {
	var errs @[]@[]char = s.entryLoadErrors(from, entry)
	if own != nil {
		errs = relabelLoadErrs(errs, own, label)
	}
	for i := 0; i < len(errs); i++ {
		s.errln(errs[i])
	}
	return len(errs) > 0
}

// entryLoadErrors returns the load errors of the functions IR-gen generated into the
// session module from index from, for the entry whose generation entry records.
// When there are none, the entry is kept (irgen.EndReplEntry).  Otherwise none
// of it is lowered, and IR-gen's state is put back as it was before it
// (irgen.UndoReplEntry): what it generated, and generated for reuse — a generic
// instance, a destructor or copy helper — is generated again by a later entry
// that uses it, from what is declared then.  The destructor and copy helpers
// the generation queued are drained where the entry is lowered
// (lowerGenerated), not here: they refer to no package variable, and a
// declaration's body must stay the last function appended (lowerReplFunc).
func (s @kernel) entryLoadErrors(from int, entry @irgen.ReplEntry) @[]@[]char {
	var m @ir.Module = s.MainMod
	var errs @[]@[]char = s.Vm.LoadCheck(m, m.Funcs[from:])
	if len(errs) == 0 {
		irgen.EndReplEntry(s.MainGc, entry)
		return errs
	}
	irgen.UndoReplEntry(s.MainGc, entry)
	return errs
}

// relabelLoadErrs returns errs with each use by fn — a synthetic function a
// prompt entry was generated as, named by the session — given as label instead,
// in the entry's own terms ("the initializer of v"), so a message is the same
// each time the entry is generated.
func relabelLoadErrs(errs @[]@[]char, fn @ir.Func, label *[]readonly char) @[]@[]char {
	var from @[]char = buf.Concat("(used by ", fn.Name)
	var to @[]char = buf.Concat("(used by ", label)
	var out @[]@[]char = make_slice(@[]char, len(errs))
	for i := 0; i < len(errs); i++ {
		// The name ends the use: a longer name it begins (__repl_var_init_12 for
		// __repl_var_init_1) is another function's.
		out[i] = replaceAll(replaceAll(errs[i], buf.Concat(from, ","), buf.Concat(to, ",")),
				buf.Concat(from, ")"), buf.Concat(to, ")"))
	}
	return out
}

// replaceAll returns s with each occurrence of old replaced by repl.
func replaceAll(s *[]readonly char, old *[]readonly char, repl *[]readonly char) @[]char {
	var out @[]char = ""
	var start int = 0
	var i int = 0
	for i + len(old) <= len(s) {
		if streq(s[i:i + len(old)], old) {
			out = buf.Concat(buf.Concat(out, s[start:i]), repl)
			i = i + len(old)
			start = i
		} else {
			i = i + 1
		}
	}
	return buf.Concat(out, s[start:])
}
