package "pkg/binate/repl"

import "pkg/binate/ir"
import "pkg/binate/irgen"
import "pkg/stdx/slices"

// Loading a prompt entry.  Before an entry's code is lowered or run, its
// functions are load-checked (vm.LoadCheck): one that refers to a package
// variable nothing in the program defines — the VM's counterpart of a compiled
// program's undefined-symbol link error — fails the entry, which is then not
// kept, as one that fails to check is not.

// loadFails reports whether the functions IR-gen generated into the session
// module from index from, for the entry whose generation entry records, fail to
// load, reporting each load error.  When they load, the entry is kept
// (irgen.EndReplEntry).  When they do not, the entry is undone
// (irgen.UndoReplEntry), but what IR-gen generated for reuse — a generic
// instance, a method-value wrapper, a destructor or copy helper (IsLinkOnce) —
// it does not generate again: each of those that loads is lowered, and IR-gen
// forgets the others, so a later entry using one generates it, and fails,
// again.  The entry's own functions (its body, its function literals) are not
// lowered.  The impl rows the entry added are dropped with it, so a function
// boxing into one of their interfaces does not load either: it is forgotten
// and generated again, row and all, by a later use.  redone lists the
// instances emitted again from a generic the entry redefines
// (irgen.ReemitGeneric): IR-gen records them as emitted, as before the entry,
// and the VM still runs the ones the definition it gets back emitted, so they
// are neither lowered nor forgotten.
func (s @kernel) loadFails(from int, redone *[]@ir.Func, entry @irgen.ReplEntry) bool {
	// The destructor and copy helpers the generation queued are drained where
	// the entry is lowered (lowerGenerated), not here: they refer to no package
	// variable, and a declaration's body must stay the last function appended
	// (lowerReplFunc).  An entry that does not load leaves them queued for the
	// next one.
	var m @ir.Module = s.MainMod
	var fs @[]@ir.Func = m.Funcs[from:]
	var none @[]@[]char
	var ok @[]bool
	var errs @[]@[]char
	ok, errs = s.Vm.LoadCheck(m, fs, none)
	if len(errs) == 0 {
		irgen.EndReplEntry(s.MainGc, entry)
		return false
	}
	for i := 0; i < len(errs); i++ {
		s.errln(errs[i])
	}
	var dropped @[]@[]char = irgen.ReplEntryVtables(s.MainGc, entry)
	if len(dropped) > 0 {
		ok, _ = s.Vm.LoadCheck(m, fs, dropped)
	}
	var forget @[]@ir.Func
	for i := 0; i < len(fs); i++ {
		if !fs[i].IsLinkOnce || funcIn(redone, fs[i]) { continue }
		if ok[i] {
			s.Vm.LowerOneFunc(m, fs[i])
		} else {
			forget = slices.Append[@ir.Func](forget, fs[i])
		}
	}
	irgen.UndoReplEntry(s.MainGc, entry, forget)
	return true
}

// funcIn reports whether f is one of fs.
func funcIn(fs *[]@ir.Func, f @ir.Func) bool {
	for i := 0; i < len(fs); i++ {
		if same(fs[i], f) { return true }
	}
	return false
}
