package "pkg/binate/repl"

import "pkg/builtins/testing"

// Tests for loadFails (load_check.bn): a prompt entry whose code needs a package
// variable nothing in the program defines does not load, is not kept, and the
// session goes on.  setupReplStateSrc and seq are testsupport_test.bn's, errHas
// and execOK decl_blank_type_test.bn's, callInt decl_generic_test.bn's.

// noStorageMsg is the load error for G.
var noStorageMsg *[]readonly char = "nothing in the program defines the package variable main.G"

// sessionWithoutStorage returns a session whose main file declares G, with G's
// storage taken away (withoutStorage).
func sessionWithoutStorage() @kernel {
	return withoutStorage(setupReplStateSrc("package \"main\"\nvar G int\nfunc main() { }\n"))
}

// withoutStorage takes the storage of session s's G away — the session module's
// G marked extern, its VM global renamed — so G is a package variable nothing in
// the program defines.
func withoutStorage(s @kernel) @kernel {
	for i := 0; i < len(s.MainMod.Globals); i++ {
		if seq(s.MainMod.Globals[i].Name, "G") { s.MainMod.Globals[i].IsExtern = true }
	}
	s.Vm.RenameGlobal("G", "__no_storage_G")
	return s
}

// failsToLoad reports whether executing src fails with G's load error.
func failsToLoad(s @kernel, src *[]readonly char) bool {
	var r Result = s.Execute(toBytesRT(src))
	return r.Status == EXEC_ERROR && errHas(r, noStorageMsg)
}

// A statement needing G is not run; the next entry runs.
func TestLoadFailsStatement() testing.TestResult {
	var s @kernel = sessionWithoutStorage()
	if !failsToLoad(s, "_ = G") {
		return fail("`_ = G` should fail to load")
	}
	if !execOK(s, "var k int = 1") {
		return fail("the session should go on")
	}
	return ""
}

// A function or variable declaration needing G is not kept.
func TestLoadFailsDeclarationNotKept() testing.TestResult {
	var s @kernel = sessionWithoutStorage()
	if !failsToLoad(s, "func f() int { return G }") || !failsToLoad(s, "var v int = G") {
		return fail("the declarations should fail to load")
	}
	var r Result = s.Execute(toBytesRT("_ = f"))
	if !errHas(r, "undefined: f") {
		return fail("f should not be kept")
	}
	r = s.Execute(toBytesRT("_ = v"))
	if !errHas(r, "undefined: v") {
		return fail("v should not be kept")
	}
	return ""
}

// A generic function needing G is accepted — nothing of it is lowered — and each
// use of an instance fails, the instance generated again each time.
func TestLoadFailsGenericInstance() testing.TestResult {
	var s @kernel = sessionWithoutStorage()
	if !execOK(s, "func Q[T any]() int { return G }") {
		return fail("a generic function is not lowered, so it loads")
	}
	if !failsToLoad(s, "_ = Q[int]()") || !failsToLoad(s, "_ = Q[int]()") {
		return fail("each use of Q[int] should fail to load")
	}
	return ""
}

// A redefinition that does not load leaves the old definition, signature and
// all: IR-gen gets back the signature the redefinition replaced.
func TestLoadFailsRedefinitionKeepsOld() testing.TestResult {
	var s @kernel = sessionWithoutStorage()
	if !execOK(s, "func h() int { return 1 }") {
		return fail("h should be declared")
	}
	if !failsToLoad(s, "func h(a int) int { return G + a }") {
		return fail("the redefinition should fail to load")
	}
	if !execOK(s, "var r int = h()") {
		return fail("the old h, with its signature, should still be called")
	}
	return ""
}

// An instance generated, and loading, in an entry that does not load is kept:
// a later use, which does not generate it again, runs it.
func TestLoadFailsKeepsInstanceThatLoads() testing.TestResult {
	var s @kernel = sessionWithoutStorage()
	if !execOK(s, "func Q[T any]() int { return 3 }") || !failsToLoad(s, "_ = Q[int]() + G") {
		return fail("Q is declared, and its use with G fails to load")
	}
	if !execOK(s, "func useQ() int { return Q[int]() }") || callInt(s, "useQ") != 3 {
		return fail("Q[int] should still run")
	}
	return ""
}

// A same-signature generic redefinition that does not load leaves IR-gen
// recording the instances the VM runs: a later same-signature redefinition
// replaces them for their callers, and one of another signature shadows them.
func TestLoadFailsGenericRedefinitionInStep() testing.TestResult {
	var s @kernel = sessionWithoutStorage()
	if !execOK(s, "func K[T any]() int { return 2 }") ||
			!execOK(s, "func useK() int { return K[int]() }") || callInt(s, "useK") != 2 {
		return fail("useK should call K[int]")
	}
	if !failsToLoad(s, "func K[T any]() int { return G }") || callInt(s, "useK") != 2 {
		return fail("the redefinition should fail to load, leaving the old K[int]")
	}
	if !execOK(s, "func K[T any]() int { return 3 }") || callInt(s, "useK") != 3 {
		return fail("a same-signature redefinition should replace K[int] for useK")
	}
	s = sessionWithoutStorage()
	if !execOK(s, "func K[T any]() int { return 2 }") ||
			!execOK(s, "func useK() int { return K[int]() }") || callInt(s, "useK") != 2 ||
			!failsToLoad(s, "func K[T any]() int { return G }") {
		return fail("useK should call K[int], and the redefinition fail to load")
	}
	if !execOK(s, "func K[T any](a int) int { return a * 10 }") ||
			!execOK(s, "func useK2() int { return K[int](5) }") {
		return fail("a redefinition of another signature should be accepted")
	}
	if callInt(s, "useK") != 2 || callInt(s, "useK2") != 50 {
		return fail("useK should keep the old K[int], and useK2 call the new one")
	}
	return ""
}

// The same holds for a method of a generic type.
func TestLoadFailsGenericMethodRedefinitionInStep() testing.TestResult {
	var s @kernel = sessionWithoutStorage()
	if !execOK(s, "type Bx[T any] struct { v T }") ||
			!execOK(s, "func (b *Bx[T]) Get() int { return 1 }") ||
			!execOK(s, "func useG() int { var b Bx[int]; return b.Get() }") || callInt(s, "useG") != 1 {
		return fail("useG should call Bx[int].Get")
	}
	if !failsToLoad(s, "func (b *Bx[T]) Get() int { return G }") || callInt(s, "useG") != 1 {
		return fail("the redefinition should fail to load, leaving the old Get")
	}
	if !execOK(s, "func (b *Bx[T]) Get() int { return 4 }") || callInt(s, "useG") != 4 {
		return fail("a same-signature redefinition should replace Get for useG")
	}
	return ""
}

// The impl rows an entry that does not load added are dropped with it, and so
// is what boxes into their interface: a later boxing generates them again, and
// fails to load again, rather than reaching an interface method slot left empty.
func TestLoadFailsImplRowsDropped() testing.TestResult {
	var s @kernel = withoutStorage(
			setupReplStateSrc(
					"package \"main\"\nvar G int\n"
							"interface Getter { Get() int }\ntype Gen[T any] struct { v T }\n"
							"func (g *Gen[T]) Get() int { return G }\nimpl *Gen[T] : Getter\n"
							"func wrapG[T any](x *Gen[T]) *Getter { return x }\nfunc main() { }\n"))
	if !execOK(s, "var g Gen[int]") || !failsToLoad(s, "var p *Getter = wrapG[int](&g)") {
		return fail("g is declared, and boxing it fails to load")
	}
	if !execOK(s, "var five int = 5") {
		return fail("the session should go on")
	}
	if !failsToLoad(s, "var q *Getter = wrapG[int](&g)") {
		return fail("boxing g again should fail to load again")
	}
	return ""
}

// A failed entry that boxed an instance of a generic type into an interface
// leaves no record of the impl rows it minted for the instance: a later box mints
// them again, so the instance still satisfies its interfaces dynamically.
func TestLoadFailsImplRowsMintedAgain() testing.TestResult {
	var s @kernel = withoutStorage(
			setupReplStateSrc(
					"package \"main\"\nvar G int\n"
							"interface Getter { Get() int }\ntype Gen[T any] struct { v T }\n"
							"func (g *Gen[T]) Get() int { return 1 }\nimpl *Gen[T] : Getter\n"
							"func isGetter(a *any) bool { _, ok := a.(*Getter); return ok }\nfunc main() { }\n"))
	if !execOK(s, "var g Gen[int]") ||
			!failsToLoad(s, "func bad() bool { var a *any = &g; _ = G; return isGetter(a) }") {
		return fail("g is declared, and bad fails to load")
	}
	// Called from a prompt entry, which lowers the impl rows the boxing needs
	// before it runs.
	if !execOK(s, "func check() int { var a *any = &g; if isGetter(a) { return 1 }; return 0 }") ||
			!execOK(s, "var r int = check()") || !execOK(s, "func getR() int { return r }") ||
			callInt(s, "getR") != 1 {
		return fail("a boxed Gen[int] should still assert to *Getter")
	}
	return ""
}

// A generic method's redefinition of another signature, after one that failed
// to load, shadows the old instance for its callers, as without the failure.
func TestLoadFailsGenericMethodShadowAfterFailure() testing.TestResult {
	var s @kernel = sessionWithoutStorage()
	if !execOK(s, "type Bx[T any] struct { v T }") ||
			!execOK(s, "func (b *Bx[T]) Get() int { return 1 }") ||
			!execOK(s, "func useG() int { var b Bx[int]; return b.Get() }") ||
			!failsToLoad(s, "func (b *Bx[T]) Get() int { return G }") {
		return fail("useG should be declared, and the redefinition fail to load")
	}
	if !execOK(s, "func (b *Bx[T]) Get(a int) int { return a }") ||
			!execOK(s, "func useG2() int { var b Bx[int]; return b.Get(6) }") {
		return fail("a redefinition of another signature should be accepted")
	}
	if callInt(s, "useG") != 1 || callInt(s, "useG2") != 6 {
		return fail("useG should keep the old Get, and useG2 call the new one")
	}
	return ""
}
