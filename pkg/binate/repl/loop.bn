package "pkg/binate/repl"

// RunReadLoop is an optional convenience driver for hosts that want a blocking
// read-accumulate loop (a CLI, a simple test harness) rather than driving
// Execute directly — see repl.bni for the contract.  The accumulation +
// completeness logic that used to live in the engine (Step) lives here now, in
// the driver layer, so a whole-cell or event-driven host can skip it entirely
// and call Execute on a complete unit.
func RunReadLoop(k @Kernel, read @func() (@[]uint8, bool), renderPrompt @func(Completeness),
		renderResult @func(Result)) {
	var acc @[]uint8
	for {
		// Prompt from the current accumulation's completeness: empty ⇒ primary,
		// mid-unit ⇒ continuation (the depth rides in Completeness.Indent).
		renderPrompt(k.IsComplete(acc))
		var line @[]uint8
		var eof bool
		line, eof = read()
		if eof {
			// eof at a turn boundary is a clean exit; eof mid-accumulation
			// discards the buffered unit (the user bailed).  Either way, stop.
			return
		}
		acc = appendReplLine(acc, line)
		var comp Completeness = k.IsComplete(acc)
		// An empty line at a primary prompt (nothing but the newline
		// accumulated) just reprompts — evaluate nothing, don't advance a turn.
		if len(line) == 0 && comp.Status == COMP_COMPLETE {
			var reset @[]uint8
			acc = reset
			continue
		}
		// Still inside an open `{` or `(` — keep reading on a continuation.
		if comp.Status == COMP_INCOMPLETE {
			continue
		}
		// Complete — evaluate and reset the accumulator.
		renderResult(k.Execute(acc))
		var reset @[]uint8
		acc = reset
	}
}

// appendReplLine appends `line` followed by a newline to acc, so the parser
// sees the same line breaks the user typed.
func appendReplLine(acc @[]uint8, line *[]readonly uint8) @[]uint8 {
	var out @[]uint8 = acc
	for i := 0; i < len(line); i++ {
		out = appendByteRepl(out, line[i])
	}
	out = appendByteRepl(out, 10)
	return out
}
