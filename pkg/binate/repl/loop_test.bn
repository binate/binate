package "pkg/binate/repl"

import "pkg/builtins/testing"

// Tests for the RunReadLoop driver helper (loop.bn): it accumulates host-read
// lines until IsComplete reports a complete unit, then evaluates it via Execute
// — the accumulation + completeness logic that used to live in the engine's
// Step.  setupReplState / toBytesRT / fail live in testsupport_test.bn.

// loopProbe drives the test: a queue of input lines a capturing reader closure
// dispenses, and a counter a capturing renderResult closure bumps per turn.
type loopProbe struct {
	Lines   @[]@[]uint8
	Idx     int
	Results int
}

// A two-line multi-line unit (an open brace then its close) followed by EOF
// must evaluate exactly one turn — proving accumulation + completeness live in
// the driver helper, not the engine.
func TestRunReadLoopAccumulatesMultiLine() testing.TestResult {
	var s @kernel = setupReplState()
	var probe @loopProbe = make(loopProbe)
	probe.Idx = 0
	probe.Results = 0
	var lines @[]@[]uint8 = make_slice(@[]uint8, 2)
	lines[0] = toBytesRT("for i := 0; i < 1; i++ {")
	lines[1] = toBytesRT("}")
	probe.Lines = lines
	var reader @func() (@[]uint8, bool) = func() (@[]uint8, bool) {
		if probe.Idx >= len(probe.Lines) {
			var none @[]uint8
			return none, true
		}
		var ln @[]uint8 = probe.Lines[probe.Idx]
		probe.Idx = probe.Idx + 1
		return ln, false
	}
	var renderPrompt @func(Completeness) = func(c Completeness) {}
	var renderResult @func(Result) = func(r Result) {
		probe.Results = probe.Results + 1
	}
	var k @Kernel = s
	RunReadLoop(k, reader, renderPrompt, renderResult)
	if probe.Results != 1 {
		return fail("a two-line unit should evaluate exactly one turn")
	}
	return ""
}
