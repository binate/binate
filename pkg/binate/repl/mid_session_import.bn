package "pkg/binate/repl"

import "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irgen"
import "pkg/binate/iropt"
import "pkg/binate/loader"
import "pkg/binate/parser"
import "pkg/binate/types"

// REPL Tier 5: mid-session imports.  `import "pkg/foo"` typed
// at the prompt loads pkg/foo (and any transitive deps not
// yet in the session), type-checks them, generates IR, lowers
// to the VM, then defines the package symbol in the session
// scope so subsequent prompt entries can use `foo.X`.
//
// The session's loader / search paths / processed-package set live on
// @kernel (see repl_session.bn); evalReplImport re-enters the
// initial-load pipeline against them for each `import` prompt entry.

// evalReplImport handles a single or grouped `import` typed at
// the prompt.  Parses the specs, loads each via the session
// Loader (which transitively pulls deps), type-checks + IR-gens
// + lowers any newly-loaded package, then defines the user-typed
// package symbol(s) in the session scope.
//
// Errors at any step (load, parse, type-check) are printed and
// processing continues for the remaining specs — loaded state
// is preserved on partial failure.  Caller (`evalReplLine`)
// passes the parser positioned at the `import` keyword.
func (s @kernel) evalReplImport(p @parser.Parser) {
	var specs @[]@ast.ImportSpec = p.ParseImportDecl()
	var perrs @[]parser.ParseError = p.Errors()
	if len(perrs) > 0 {
		for i := 0; i < len(perrs); i++ {
			s.errln(parser.FormatParseError(perrs[i]))
		}
		return
	}
	if len(specs) == 0 { return }

	// Hand specs to the session loader.  LoadImports loads
	// transitively + recomputes order across the full graph.
	var preLoadErrs int = len(s.Ldr.Errors)
	s.Ldr.LoadImports(specs)
	if len(s.Ldr.Errors) > preLoadErrs {
		for i := preLoadErrs; i < len(s.Ldr.Errors); i++ {
			s.errln(s.Ldr.Errors[i])
		}
		return
	}

	// Process any newly-loaded package: type-check, then IR-gen + lower.
	// Walk the post-LoadImports order; skip entries already in
	// s.ProcessedPkgs (the initial load + previous imports).  Every new package
	// is checked before any is lowered, as at the initial load (session.bn): a
	// package's IR-gen registers the types and interfaces of every loaded
	// package, which resolves an `expose`d member through the checker — so
	// each must have been checked first.  Each lowering builds its own
	// per-package @Module (carrying its own alias map), so s.MainMod's alias
	// map is untouched by the loop — it's only extended after the loop (below)
	// with the freshly-imported top-level aliases.
	var preCheckErrs int = len(s.Chk.CheckerErrors())
	var newPaths @[]@[]char
	var cleanPaths @[]@[]char
	for i := 0; i < len(s.Ldr.Order); i++ {
		var path @[]char = s.Ldr.Order[i]
		if containsPath(s.ProcessedPkgs.Items(), path) { continue }
		newPaths = appendCharSlice(newPaths, path)
		s.ProcessedPkgs.Push(path)
		var pkg @loader.Package = s.Ldr.GetPackage(path)
		if pkg == nil { continue }
		var pkgErrsBefore int = len(s.Chk.CheckerErrors())
		if pkg.BNI != nil {
			s.Chk.LoadPackageInterface(path, pkg.BNI)
		}
		if pkg.Merged != nil {
			s.Chk.CheckPackage(path, pkg.Merged, pkg.Files, pkg.BNI)
		}
		// IR-gen a package ONLY if it — and every package it imports (checked
		// earlier: dependencies precede it in the order) — type-checked cleanly.
		// A package that errored — e.g. an interpreted __c_call
		// (Checker.Interpreted) — must NOT be lowered: IR-gen emits OP_C_CALL
		// unconditionally and LowerModule would hit lower_instr's default arm and
		// abort the whole session; nor may its declarations reach any IR-gen
		// registration (s.FailedPkgs).  The recorded errors are surfaced after the
		// loop; the import "partially succeeds" (clean packages stay registered).
		// (The initial-load path in session.bn returns early on errors before any
		// lowering; this per-package gate is the loop analog.)
		if len(s.Chk.CheckerErrors()) > pkgErrsBefore || importsFailedPkg(s, pkg) {
			s.FailedPkgs.Push(path)
			continue
		}
		if pkg.Merged != nil {
			cleanPaths = appendCharSlice(cleanPaths, path)
		}
	}
	for i := 0; i < len(cleanPaths); i++ {
		var path @[]char = cleanPaths[i]
		var pkg @loader.Package = s.Ldr.GetPackage(path)
		var pkgMod @ir.Module = irgen.InitModule(quotePath(path))
		pkgMod.Checker = s.Chk
		var pkgGc @irgen.GenCtx = irgen.NewGenCtx(pkgMod)
		// Nil-checking is always on for the REPL — a package imported
		// mid-session lowers with the same guard as the initial load
		// (session.bn's NewKernel).
		pkgGc.EmitNilChecks = true
		pkgGc.SroaCleanupShape = iropt.OptPassEnabled(s.Vm.Opt, iropt.PASS_SROA)
		registerPkgImports(s.Ldr, pkg, s.FailedPkgs.Items(), pkgGc)
		if pkg.BNI != nil {
			irgen.RegisterSelfTypes(s.Chk, pkg.BNI, pkgGc)
		}
		irgen.GeneratePackage(s.Chk, pkg.Merged, pkgGc, pkg.Files)
		s.Vm.LowerModule(pkgMod)
	}
	// The per-package LowerModule calls above left the VM's module-lowering
	// context pointing at the LAST lowered import; restore it to the session
	// module so a following prompt `var` decl qualifies its global under the
	// session package (else MaterializeOneGlobal registers "<lastImport>.g" while
	// the init synthetic stores to "<session>.g" — a null-address SIGSEGV).
	s.Vm.SetModuleContext(s.MainMod)
	// Surface check errors from any of the newly-processed
	// packages.  Loaded state stays.
	var allErrs @[]types.CheckError = s.Chk.CheckerErrors()
	if len(allErrs) > preCheckErrs {
		for i := preCheckErrs; i < len(allErrs); i++ {
			s.errln(check.FormatCheckError(allErrs[i]))
		}
		// Don't return — partial success leaves the working
		// packages registered.
	}

	// Register the freshly-imported top-level packages on the session's main gen
	// ctx: the alias map (so `foo.X` resolves to the full path) AND the callees'
	// SIGNATURES (param/result types and, critically, variadic-ness — an
	// interface-only injected package like pkg/builtins/testing is never lowered,
	// so without its signature a `testing.Println(x)` (`...*any`) is IR-gen'd
	// unaware it is variadic).  RegisterImportFuncSigs registers the signatures but
	// does NOT add the imported extern Func entries to the live session module:
	// doing so would desync its func index space from the VM's func table, so a
	// following per-decl LowerOneFunc (e.g. a `var` initializer's synthetic) would
	// call a stale index and execute an unlowered extern as bytecode (SIGSEGV).
	// The callee resolves through the VM's native extern table instead.
	// Each alias is rebound first (below): RegisterImportFuncSigs's own recording
	// (Pass 0) is first-wins and would keep an earlier import's binding.
	// First the types of EVERY package this import loaded — directly or
	// indirectly (a dependency, an `expose` target) — on the session's gen ctx:
	// its startup registration (registerMainImports) predates them, and a
	// top-level import's interface may name an indirect package's generic
	// interface as a parent or impl target.
	registerLoadedPkgTypes(s.Ldr, pathsWithout(newPaths, s.FailedPkgs.Items()), s.MainGc)
	var impAliases @[]@[]char
	var impPaths @[]@[]char
	var impFiles @[]@ast.File
	for i := 0; i < len(specs); i++ {
		var path @[]char = buf.CopyStr(stripImportQuotes(specs[i].Path))
		if containsPath(s.FailedPkgs.Items(), path) { continue }
		var f @ast.File = collectPkgFile(s.Ldr, path)
		if f == nil { continue }
		var alias @[]char = specs[i].Alias
		if len(alias) == 0 {
			alias = buf.CopyStr(lastSegmentOfPath(path))
		}
		impAliases = appendCharSlice(impAliases, alias)
		impPaths = appendCharSlice(impPaths, path)
		impFiles = appendFilePtr(impFiles, f)
	}
	if len(impFiles) > 0 {
		// A prompt import shadows an earlier import under the same name (the
		// checker rebinds it too), so rebind each alias before registration —
		// the registration's own recording is first-wins and would keep the old
		// binding, resolving `alias.X` to the wrong package.
		for i := 0; i < len(impAliases); i++ {
			irgen.RebindImportPath(s.MainGc.Mod, impAliases[i], impPaths[i])
		}
		irgen.RegisterImportFuncSigs(impAliases, impPaths, impFiles, s.MainGc)
	}
	// A generic body of a newly loaded package, monomorphized at the prompt, may
	// call a package the session never imports: register those packages'
	// signatures, constants and variables — no extern Funcs, as above.
	registerGenericBodyDeps(s.Ldr, newPaths, impPaths, s.FailedPkgs.Items(), s.MainGc, false)

	// Define each top-level (user-typed) import in the session
	// scope so `foo.X` resolves.  Each spec's alias is the
	// user-written name if present, otherwise the path's last
	// segment.
	for i := 0; i < len(specs); i++ {
		var imp @ast.ImportSpec = specs[i]
		var path @[]char = buf.CopyStr(stripImportQuotes(imp.Path))
		var alias @[]char = imp.Alias
		if len(alias) == 0 {
			alias = buf.CopyStr(lastSegmentOfPath(path))
		}
		// A package that failed type-checking — or imports one that did — is
		// never lowered or registered for IR-gen (s.FailedPkgs), so binding it
		// here would resolve `alias.X` to code that does not exist (and, for an
		// alias shadowing an earlier import, the checker to the new package
		// while IR-gen keeps the old one).  Report it and leave any earlier
		// binding of the alias in place.
		if containsPath(s.FailedPkgs.Items(), path) {
			s.err("error: package not imported (it, or a package it imports, failed type-checking): ")
			s.errln(path)
			continue
		}
		if !s.Chk.RegisterReplImport(alias, path) {
			s.err("error: package not loaded: ")
			s.errln(path)
			continue
		}
		s.out("package ")
		s.out(path)
		s.outln(" loaded")
	}
}

// importsFailedPkg reports whether pkg imports a package in s.FailedPkgs.
func importsFailedPkg(s @kernel, pkg @loader.Package) bool {
	for i := 0; i < len(pkg.Imports); i++ {
		if containsPath(s.FailedPkgs.Items(), pkg.Imports[i]) { return true }
	}
	return false
}

// containsPath reports whether `paths` already contains `p`
// byte-for-byte.  Used by evalReplImport to skip packages
// already processed.
func containsPath(paths *[]@[]char, p *[]readonly char) bool {
	for i := 0; i < len(paths); i++ {
		if streq(paths[i], p) { return true }
	}
	return false
}

// stripImportQuotes returns the path inside an
// ast.ImportSpec.Path string literal: `"pkg/foo"` →
// `pkg/foo`.  Sibling of pkg/binate/types/checker_util.bn's private
// `stripQuotes` — duplicated here to avoid widening the
// types-package surface for one helper.
func stripImportQuotes(s *[]readonly char) *[]readonly char {
	if len(s) >= 2 && s[0] == '"' && s[len(s) - 1] == '"' {
		return s[1:len(s) - 1]
	}
	return s
}

// lastSegmentOfPath returns the trailing path component of a
// slash-delimited path: `pkg/foo` → `foo`, `foo` → `foo`.
// Mirrors `lastPathSegment` in pkg/binate/types.
func lastSegmentOfPath(path *[]readonly char) *[]readonly char {
	var start int = 0
	for i := 0; i < len(path); i++ {
		if path[i] == '/' { start = i + 1 }
	}
	return path[start:]
}
