package "pkg/binate/repl"

import "pkg/builtins/testing"

// Unit tests for the package-private helpers in mid_session_import.bn.
// The main `evalReplImport` entry point pulls in the session's Loader /
// Checker / VM and is exercised end-to-end by e2e/repl.sh (case
// tier5-mid-session-import-call).  seq / fail / appendToCharSlices live
// in testsupport_test.bn.

func TestStripImportQuotesBasic() testing.TestResult {
	var s @[]char = "\"pkg/foo\""
	var got @[]char = stripImportQuotes(s)
	if !seq(got, "pkg/foo") {
		return fail("expected pkg/foo")
	}
	return ""
}

func TestStripImportQuotesNoQuotes() testing.TestResult {
	var s @[]char = "pkg/foo"
	var got @[]char = stripImportQuotes(s)
	if !seq(got, "pkg/foo") {
		return fail("non-quoted input should pass through unchanged")
	}
	return ""
}

func TestLastSegmentOfPathSlashes() testing.TestResult {
	var got @[]char = lastSegmentOfPath("pkg/repl/demo")
	if !seq(got, "demo") {
		return fail("expected demo")
	}
	return ""
}

func TestLastSegmentOfPathNoSlash() testing.TestResult {
	var got @[]char = lastSegmentOfPath("demo")
	if !seq(got, "demo") {
		return fail("no-slash input should be its own last segment")
	}
	return ""
}

func TestContainsPathHit() testing.TestResult {
	var paths @[]@[]char
	paths = appendToCharSlices(paths, "pkg/a")
	paths = appendToCharSlices(paths, "pkg/b")
	if !containsPath(paths, "pkg/a") {
		return fail("expected containsPath to find pkg/a")
	}
	return ""
}

func TestContainsPathMiss() testing.TestResult {
	var paths @[]@[]char
	paths = appendToCharSlices(paths, "pkg/a")
	if containsPath(paths, "pkg/missing") {
		return fail("containsPath should miss pkg/missing")
	}
	return ""
}
