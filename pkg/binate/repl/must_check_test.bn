package "pkg/binate/repl"

import "pkg/binate/ast"
import "pkg/binate/check"
import "pkg/builtins/testing"

// Checking a test's program: IR-gen is defined only on a program that checks, so
// one that does not stops the test run.

// stopOnCheckErrors stops the test run, naming c's first check error, when c
// reported one.
func stopOnCheckErrors(c @check.Checker) {
	var errs @[]check.CheckError = c.CheckerErrors()
	if len(errs) > 0 {
		testing.Println("a test's program does not type-check:", check.FormatCheckError(errs[0]))
		panic("a test's program does not type-check")
	}
}

// mustCheck type-checks file and returns its checker (stopOnCheckErrors).
func mustCheck(file @ast.File) @check.Checker {
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	stopOnCheckErrors(c)
	return c
}
