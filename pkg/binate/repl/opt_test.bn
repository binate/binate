package "pkg/binate/repl"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/iropt"
import "pkg/builtins/testing"

// Tests for the REPL's optimization passes: replOptConfig (session.bn) and the
// per-function passes run on prompt-entered functions (vm.LowerOneFunc).

func TestReplOptConfigDropsInline() testing.TestResult {
	var all iropt.OptConfig = iropt.LevelOptConfig(2)
	var c iropt.OptConfig = replOptConfig(all)
	if iropt.OptPassEnabled(c, iropt.PASS_INLINE) { return fail("the REPL must not inline") }
	if c.Passes != iropt.WithOptPass(all, iropt.PASS_INLINE, false).Passes {
		return fail("the REPL must keep every other pass")
	}
	return ""
}

// countOpInFunc counts f's instructions with opcode op (normal blocks only).
func countOpInFunc(f @ir.Func, op int) int {
	var n int = 0
	for bi := 0; bi < len(f.Blocks); bi++ {
		for ii := 0; ii < len(f.Blocks[bi].Instrs); ii++ {
			if f.Blocks[bi].Instrs[ii].Op == op { n = n + 1 }
		}
	}
	return n
}

// A function declared at the prompt is optimized before it is lowered: its
// scalar locals are promoted (no OP_ALLOC left), and it still runs correctly.
func TestReplDeclFuncIsOptimized() testing.TestResult {
	var s @kernel = setupReplState()
	var before int = len(s.MainMod.Funcs)
	s.evalReplLine(
			toBytesRT(
					"func sumTo(n int) int { var t int = 0; for i := 0; i < n; i++ { t = t + i }; return t }\n"))
	if len(s.MainMod.Funcs) <= before { return fail("decl should add a func") }
	var f @ir.Func = s.MainMod.Funcs[before]
	if !f.Optimized { return fail("a prompt-declared function must be optimized") }
	if countOpInFunc(f, iropcode.OP_ALLOC) != 0 { return fail("mem2reg should promote t and i") }
	var args @[]int = make_slice(int, 1)
	args[0] = 5
	if s.Vm.CallFunc("main.sumTo", args) != 10 { return fail("sumTo(5) should be 10") }
	return ""
}
