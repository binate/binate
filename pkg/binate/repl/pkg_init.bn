package "pkg/binate/repl"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/vm"

// Package initialization at the REPL (prog.init.vars): a package lowered into
// the session — at startup, the main file's included, or by a prompt `import` —
// has its top-level `var` initializers run once lowered, dependencies first, as a
// program's are before `main`.

// pkgInitName returns the name of the package-initialization function the module
// mod of the package quotedPkg defines (its top-level `var` initializers), or ""
// when it defines none.
func pkgInitName(mod @ir.Module, quotedPkg *[]readonly char) @[]char {
	var none @[]char
	if !mod.HasPackageInit() { return none }
	return ir.PackageInitName(mangle.PkgPathFromQuoted(quotedPkg))
}

// runPackageInits runs the package-initialization functions names in order until
// one faults, and reports whether all completed; on a fault the VM's status and
// FaultMsg describe it.
func runPackageInits(v @vm.VM, names *[]@[]char) bool {
	for i := 0; i < len(names); i++ {
		if !runPackageInit(v, names[i]) { return false }
	}
	return true
}

// runPackageInit runs the package-initialization function name ("" for a package
// with none) and reports whether it completed; on a fault the VM's status and
// FaultMsg describe it.  The function is one a lowered module defines
// (pkgInitName), so a name the VM does not know is a compiler bug.
func runPackageInit(v @vm.VM, name *[]readonly char) bool {
	if len(name) == 0 { return true }
	if v.LookupFunc(name) < 0 {
		panic(buf.Concat(buf.Concat("internal error: package initializer ", name), " was not lowered"))
	}
	var noArgs @[]int
	v.CallFunc(name, noArgs)
	return v.Status != vm.VM_STATUS_FAULTED
}
