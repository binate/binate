package "pkg/binate/repl"

import "pkg/binate/ir"
import "pkg/binate/irgen"
import "pkg/binate/irutil"
import "pkg/builtins/testing"

// Tests for pkg_init.bn.  Running the initializers is covered end to end by
// e2e/repl-pkg-var-init.sh.

// A module names its package-initialization function only when it defines one.
func TestPkgInitName() testing.TestResult {
	var m @ir.Module = irgen.InitModule("\"pkg/x\"")
	if len(pkgInitName(m, "\"pkg/x\"")) != 0 { return fail("a module with no initializer names none") }
	var f @ir.Func = make(ir.Func)
	f.Name = irutil.QualifyForPkgPath(m.PkgPath, "__init")
	m.AddFunc(f)
	if !containsSub(pkgInitName(m, "\"pkg/x\""), "pkg/x.__init") {
		return fail("expected pkg/x's initializer to be named")
	}
	return ""
}
