package "pkg/binate/repl"

import "pkg/builtins/testing"

// A function value built from a definition that a same-signature redefinition
// later REPLACES keeps working: it calls the new body (replacement, not
// shadowing, means old callers see the new definition), and the records it
// points at stay alive though a raw *func holds no reference to them.  The
// prompts between the redefinition and the call allocate small blocks, so a
// record freed with the old definition would be reused and the call would read
// garbage.  execOK lives in decl_blank_type_test.bn.
func TestReplRedefinitionKeepsRawFuncValue() testing.TestResult {
	var s @kernel = setupReplState()
	if !execOK(s, "func add1(x int) int { return x + 1 }") {
		return fail("the first add1 must succeed")
	}
	if !execOK(s, "var g *func(int) int = add1") {
		return fail("var g must succeed")
	}
	if !execOK(s, "func add1(x int) int { return x + 2 }") {
		return fail("the same-signature redefinition of add1 must succeed")
	}
	if !execOK(s, "type Q struct {\n\ta int\n\tb int\n\tc int\n\td int\n}") {
		return fail("type Q must succeed")
	}
	if !execOK(s, "var junk @[]@Q = make_slice(@Q, 64)") {
		return fail("var junk must succeed")
	}
	if !execOK(s,
			"func fill() int {\n\tfor i := 0; i < 64; i++ {\n\t\tvar q @Q = make(Q)\n"
					"\t\tq.a = 1000000\n\t\tq.b = 1000001\n\t\tq.c = 1000002\n\t\tq.d = 1000003\n"
					"\t\tjunk[i] = q\n\t}\n\treturn 0\n}") {
		return fail("func fill must succeed")
	}
	var noArgs @[]int
	s.Vm.CallFunc("main.fill", noArgs)
	if !execOK(s, "func probe() int { return g(1) }") {
		return fail("func probe must succeed")
	}
	var got int = s.Vm.CallFunc("main.probe", noArgs)
	if got != 3 {
		return fail("a raw *func built before a same-signature redefinition must call the new body")
	}
	return ""
}

// A method value taken after its method is redefined with another signature
// calls the new method, while one taken before keeps calling the old one.
// callInt lives in decl_generic_test.bn, replTurn in decl_retry_test.bn.
func TestReplMethodValueAfterShadowCallsNewMethod() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "type Mv struct { n int }\n")
	replTurn(s, "func (v *Mv) Size() int { return 1000 }\n")
	replTurn(s, "var mv Mv\n")
	if !execOK(s, "func mvold() int { var m *func() int = mv.Size; return m() }") {
		return fail("mvold must check")
	}
	if callInt(s, "mvold") != 1000 { return fail("mvold must call the first Size") }
	replTurn(s, "func (v *Mv) Size(k int) int { return k }\n")
	if !execOK(s, "func mvk() int { var m *func(int) int = mv.Size; return m(42) }") {
		return fail("mvk must check")
	}
	if callInt(s, "mvk") != 42 {
		return fail("a method value taken after the shadow must call the new Size")
	}
	if callInt(s, "mvold") != 1000 {
		return fail("a method value taken before must keep the old Size")
	}
	return ""
}

// So does one of a generic type's method.
func TestReplGenericMethodValueAfterShadowCallsNewMethod() testing.TestResult {
	var s @kernel = setupReplState()
	replTurn(s, "type Cell[T any] struct { v T }\n")
	replTurn(s, "func (c *Cell[T]) Get() int { return 1000 }\n")
	replTurn(s, "var cc Cell[int]\n")
	if !execOK(s, "func mvold() int { var m *func() int = cc.Get; return m() }") {
		return fail("mvold must check")
	}
	if callInt(s, "mvold") != 1000 { return fail("mvold must call the first Get") }
	replTurn(s, "func (c *Cell[T]) Get(k int) int { return k }\n")
	if !execOK(s, "func mvk() int { var m *func(int) int = cc.Get; return m(42) }") {
		return fail("mvk must check")
	}
	if callInt(s, "mvk") != 42 {
		return fail("a method value taken after the shadow must call the new Get")
	}
	if callInt(s, "mvold") != 1000 { return fail("a method value taken before must keep the old Get") }
	return ""
}
