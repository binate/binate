package "pkg/binate/repl"

import "pkg/binate/ast"
import "pkg/binate/buildcfg"
import "pkg/binate/debug"
import "pkg/binate/ir"
import "pkg/binate/loader"
import "pkg/binate/types"
import "pkg/binate/vm"
import "pkg/stdx/slices"

// ReplIO / ReplError / StepResult and the ReplSession interface are
// declared in the package interface (repl.bni).  replSession is the
// production, VM-backed implementation of ReplSession; this file (and
// its siblings) hold the engine behavior.

// replSession owns all state that persists across REPL turns: the
// constructed-once VM / main module / checker, the per-turn counters
// and the multi-line accumulation buffer, the session loader + search
// paths + processed-package set that mid-session `import` entries
// re-enter the load pipeline with, and the host I/O sink.
//
// Threading this through the engine (rather than holding it in
// package-level globals) is what makes the REPL re-entrant — the host
// can drive one turn at a time against a session value.
//
// v1 keeps ONE live session per process, so the remaining pkg/binate/ir
// process-globals (the import alias map and the other module-gen
// registries) are still shared — see the "remove process-global session
// state" TODO.  (The type-Checker is no longer global — it rides on
// m.Checker.)  New per-session state belongs in this struct, not in new
// REPL globals.
type replSession struct {
	// Constructed once, shared for the session lifetime:
	Vm      @vm.VM
	MainMod @ir.Module
	// MainGc is the persistent per-compilation IR-gen context bound to
	// MainMod, threaded into every prompt's GenDecl / GenConstMember /
	// GenSyntheticFunc so they share the session's gen context (and, with
	// plan-embeddable-vm.md inc 5c-2, its mid-session import alias map).
	MainGc @ir.GenCtx
	Chk    @types.Checker
	// Per-turn-persistent.  Accumulated holds the in-progress
	// multi-line input; Counter feeds the __repl_<n> synthetic names:
	Counter     int
	Accumulated @[]uint8
	// Session import state, re-entered by mid-session `import` turns.
	// Ldr holds the transitive package graph + load order; ProcessedPkgs
	// lists package paths already type-checked + IR-gen'd + lowered, so
	// they aren't reprocessed:
	Ldr           @loader.Loader
	ProcessedPkgs @[]@[]char
	// InitCounter feeds unique names into per-prompt var-initializer
	// synthetics so successive `var x = …; var y = …` entries don't
	// collide on one __repl_var_init symbol.
	InitCounter int
	// Io is the host-supplied sink for the engine's framing output.
	Io ReplIO
}

impl @replSession : ReplSession

// SetPoll installs the host's cooperative-interrupt delegate on the
// session's VM.  The host delegate is VM-free (@func() PollResult); a
// small wrapper adapts it to the VM-level @func(@VM) int the poll seam
// invokes, mapping PollResult onto the vm.POLL_* request codes.  Inert
// until the suspend / break stages — see repl.bni.
func (s @replSession) SetPoll(poll @func() PollResult) {
	// The typed var gives the closure literal its type hint (a bare
	// func-literal call argument isn't a hint site).  The wrapper
	// captures the host poll; that captured @func is RefInc-balanced by
	// the closure dtor, so installing it is leak/UAF-clean.
	var wrapped @func(@vm.VM) int = func(v @vm.VM) int {
		var r PollResult = poll()
		if r == POLL_SUSPEND { return vm.POLL_SUSPEND }
		if r == POLL_BREAK { return vm.POLL_BREAK }
		return vm.POLL_CONTINUE
	}
	s.Vm.SetPoll(wrapped)
}

// out writes normal framing output (prompts / banner / info), no
// trailing newline, through the sink's WriteOut channel.
func (s @replSession) out(str *[]readonly char) {
	s.Io.WriteOut(str)
}

// outln writes normal framing output followed by a newline — the
// WriteOut analogue of println.
func (s @replSession) outln(str *[]readonly char) {
	s.Io.WriteOut(str)
	s.Io.WriteOut("\n")
}

// err writes a diagnostic (no trailing newline) through the sink's
// WriteErr channel.
func (s @replSession) err(str *[]readonly char) {
	s.Io.WriteErr(str)
}

// errln writes a diagnostic followed by a newline — the WriteErr
// analogue of println.
func (s @replSession) errln(str *[]readonly char) {
	s.Io.WriteErr(str)
	s.Io.WriteErr("\n")
}

// NewReplSession runs the load → typecheck → lower pipeline (ending
// BEFORE main runs) and assembles the session; see repl.bni for the
// contract.  registerExterns is called to install the VM's externs
// before any user code runs, so prompt entries that call e.g. println /
// bootstrap.Write resolve via the registry rather than crashing with
// "extern not found"; the host owns those native bindings (the engine
// stays free of them).
func NewReplSession(files @[]@ast.File, root @[]char, bniPaths @[]@[]char, implPaths @[]@[]char,
		io ReplIO, registerExterns @func(@vm.VM)) (@ReplSession, @[]ReplError) {
	var merged @ast.File = loader.MergeFiles(files)
	debug.Log("parsed and merged source files")

	var ldr @loader.Loader = loader.NewLoader()
	ldr.AddBniPath(root)
	ldr.AddImplPath(root)
	addLoaderPaths(ldr, bniPaths, implPaths)
	// The REPL runs on the host, so gate #[build(...)] by the host config baked
	// into this binary — no build.bni read.
	ldr.BuildConfig = buildcfg.ConfigForTarget("")
	// The REPL's only compiled-instance substrate is rt + bootstrap (installed
	// as native externs by registerExterns below); load those interface-only.
	// Every OTHER package is interpreted (the REPL injects no stdlib), so
	// importing a __c_call package (e.g. pkg/std/os) lowers it and its native-
	// only __c_call is rejected at type-check (c.Interpreted below).
	ldr.InterfaceOnly = @[]@[]char{"pkg/builtins/rt", "pkg/bootstrap"}
	ldr.LoadImports(merged.Imports)
	ensureBootstrapLoaded(ldr)
	ensureLangLoaded(ldr)
	ensureReflectLoaded(ldr)
	if len(ldr.Errors) > 0 {
		var noSession @ReplSession
		return noSession, loaderReplErrors(ldr)
	}
	debug.Log("imports loaded successfully")

	// Type-check, leaving main file's scope installed on c.Scope.  This checker
	// persists across prompts (s.Chk), so Interpreted carries to every later
	// define / import: __c_call in interpreted REPL input is a type error.
	var c @types.Checker = types.NewChecker()
	c.Interpreted = true
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil { continue }
		if pkg.BNI != nil {
			c.LoadPackageInterface(ldr.Order[i], pkg.BNI)
		}
		if pkg.Merged != nil {
			c.CheckPackage(ldr.Order[i], pkg.Merged, pkg.Files, pkg.BNI)
		}
	}
	c.CheckMainPersistent(merged)
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) > 0 {
		var noSession @ReplSession
		return noSession, checkerReplErrors(errs)
	}
	debug.Log("type checking passed")

	// Build VM and install the host's externs before any user code
	// runs, so prompt entries that call e.g. println / bootstrap.Write
	// resolve via the registry rather than crashing with "extern not
	// found".  registerExterns is the host's (the CLI installs the
	// standard rt/libc/bootstrap bindings + the pure-C extern table).
	var vmInst @vm.VM = vm.NewVM(8 * 1024 * 1024)
	registerExterns(vmInst)
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil { continue }
		if pkg.Merged == nil { continue }
		var mod @ir.Module = ir.InitModule(quotePath(ldr.Order[i]))
		mod.Checker = c
		var gc @ir.GenCtx = ir.NewGenCtx(mod)
		registerPkgImports(ldr, pkg, gc)
		if pkg.BNI != nil {
			ir.RegisterSelfTypes(c, pkg.BNI, gc)
		}
		ir.GeneratePackage(c, pkg.Merged, gc, pkg.Files)
		vmInst.LowerModule(mod)
	}

	// Lower main package.  Keep mainMod around — synthetic REPL
	// functions are appended to it and routed through LowerOneFunc
	// against this same module (so their context is main's).
	var mainMod @ir.Module = ir.InitModule(merged.PkgName)
	mainMod.Checker = c
	var mainGc @ir.GenCtx = ir.NewGenCtx(mainMod)
	registerMainImports(ldr, merged, mainGc)
	ir.GeneratePackage(c, merged, mainGc, make_slice(@ast.File, 0))
	vmInst.LowerModule(mainMod)

	var s @replSession = assembleSession(vmInst, mainMod, mainGc, c, ldr, ldr.Order)
	s.Io = io
	var noErrs @[]ReplError
	var sess @ReplSession = s
	return sess, noErrs
}

// assembleSession wires the already-constructed parts onto a session
// value and seeds the processed-package set from the initial load
// order, so those packages aren't reprocessed when a later `import`
// turn pulls in one of their deps.  Split out of NewReplSession so it
// can be unit-tested without the full load/typecheck/lower pipeline.
func assembleSession(vmInst @vm.VM, mainMod @ir.Module, mainGc @ir.GenCtx, c @types.Checker,
		ldr @loader.Loader, initialOrder @[]@[]char) @replSession {
	var s @replSession = make(replSession)
	s.Vm = vmInst
	s.MainMod = mainMod
	s.MainGc = mainGc
	s.Chk = c
	s.Ldr = ldr
	var processed @[]@[]char
	for i := 0; i < len(initialOrder); i++ {
		processed = slices.Append[@[]char](processed, initialOrder[i])
	}
	s.ProcessedPkgs = processed
	return s
}

// loaderReplErrors wraps the loader's accumulated error strings as
// ReplErrors.
func loaderReplErrors(ldr @loader.Loader) @[]ReplError {
	var out @[]ReplError
	for i := 0; i < len(ldr.Errors); i++ {
		out = appendReplError(out, ldr.Errors[i])
	}
	return out
}

// checkerReplErrors formats each CheckError into a ReplError message.
func checkerReplErrors(errs @[]types.CheckError) @[]ReplError {
	var out @[]ReplError
	for i := 0; i < len(errs); i++ {
		out = appendReplError(out, types.FormatCheckError(errs[i]))
	}
	return out
}

// appendReplError returns dst with one ReplError carrying msg appended.
func appendReplError(dst @[]ReplError, msg @[]char) @[]ReplError {
	var n int = len(dst)
	var ns @[]ReplError = make_slice(ReplError, n + 1)
	for i := 0; i < n; i++ { ns[i] = dst[i] }
	var e ReplError
	e.Msg = msg
	ns[n] = e
	return ns
}
