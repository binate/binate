package "pkg/binate/repl"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/buildcfg"
import "pkg/binate/debug"
import "pkg/binate/ir"
import "pkg/binate/loader"
import "pkg/binate/types"
import "pkg/binate/vm"
import "pkg/stdx/containers/vec"

// The Kernel interface, Result / Notice / Diagnostic / Error and the rest of
// the surface are declared in the package interface (repl.bni).  kernel is the
// production, VM-backed implementation of Kernel; this file (and its siblings)
// hold the engine behavior.

// kernel owns all state that persists across REPL turns: the constructed-once
// VM / main module / checker, the per-turn counter, the per-turn output
// accumulators drained into each Execute's Result, and the session loader +
// search paths + processed-package set that mid-session `import` entries
// re-enter the load pipeline with.
//
// Threading this through the engine (rather than holding it in package-level
// globals) is what makes the REPL re-entrant — the driver can drive one turn
// at a time against a session value.
//
// v1 keeps ONE live session per process, so the remaining pkg/binate/ir
// process-globals (the import alias map and the other module-gen registries)
// are still shared — see the "remove process-global session state" TODO.  (The
// type-Checker is no longer global — it rides on m.Checker.)  New per-session
// state belongs in this struct, not in new REPL globals.
type kernel struct {
	// Constructed once, shared for the session lifetime:
	Vm      @vm.VM
	MainMod @ir.Module
	// MainGc is the persistent per-compilation IR-gen context bound to
	// MainMod, threaded into every prompt's GenDecl / GenConstMember /
	// GenSyntheticFunc so they share the session's gen context (and, with
	// plan-embeddable-vm.md inc 5c-2, its mid-session import alias map).
	MainGc @ir.GenCtx
	Chk    @types.Checker
	// Counter feeds the __repl_<n> synthetic names and is this turn's index.
	Counter int
	// Per-turn output accumulators, reset at the start of each Execute and
	// drained into its Result.  out / outln append informational Notices;
	// err / errln append Diagnostics.  pendOut / pendErr hold a partially
	// built line (a sequence of out(...) / err(...) fragments) until its
	// newline flush (outln / errln) appends it as one entry.
	curNotices @[]Notice
	curErrs    @[]Diagnostic
	pendOut    @[]char
	pendErr    @[]char
	// Session import state, re-entered by mid-session `import` turns.  Ldr
	// holds the transitive package graph + load order; ProcessedPkgs lists
	// package paths already type-checked + IR-gen'd + lowered, so they aren't
	// reprocessed:
	Ldr           @loader.Loader
	ProcessedPkgs @vec.Vec[@[]char]
	// InitCounter feeds unique names into per-prompt var-initializer
	// synthetics so successive `var x = …; var y = …` entries don't collide on
	// one __repl_var_init symbol.
	InitCounter int
}

impl @kernel : Kernel

// SetPoll installs the host's cooperative-interrupt delegate on the session's
// VM.  The host delegate is VM-free (@func() PollResult); a small wrapper
// adapts it to the VM-level @func(@VM) int the poll seam invokes, mapping
// PollResult onto the vm.POLL_* request codes.  Inert until the suspend /
// break stages — see repl.bni.
func (s @kernel) SetPoll(poll @func() PollResult) {
	// The typed var gives the closure literal its type hint (a bare
	// func-literal call argument isn't a hint site).  The wrapper captures the
	// host poll; that captured @func is RefInc-balanced by the closure dtor,
	// so installing it is leak/UAF-clean.
	var wrapped @func(@vm.VM) int = func(v @vm.VM) int {
		var r PollResult = poll()
		if r == POLL_SUSPEND { return vm.POLL_SUSPEND }
		if r == POLL_BREAK { return vm.POLL_BREAK }
		return vm.POLL_CONTINUE
	}
	s.Vm.SetPoll(wrapped)
}

// resetTurnOutput clears the per-turn accumulators so each Execute's Result
// carries only that turn's notices / diagnostics.
func (s @kernel) resetTurnOutput() {
	var noNotices @[]Notice
	var noErrs @[]Diagnostic
	var noOut @[]char
	var noErr @[]char
	s.curNotices = noNotices
	s.curErrs = noErrs
	s.pendOut = noOut
	s.pendErr = noErr
}

// out appends an informational-notice fragment (no newline) to the pending
// notice line; outln flushes it as one Notice.
func (s @kernel) out(str *[]readonly char) {
	s.pendOut = buf.Concat(s.pendOut, str)
}

// outln appends a fragment and flushes the pending notice line as one Notice
// on the turn's Notices — the accumulator analogue of println.
func (s @kernel) outln(str *[]readonly char) {
	s.pendOut = buf.Concat(s.pendOut, str)
	s.curNotices = appendNotice(s.curNotices, s.pendOut)
	var empty @[]char
	s.pendOut = empty
}

// err appends a diagnostic fragment (no newline) to the pending diagnostic
// line; errln flushes it as one Diagnostic.
func (s @kernel) err(str *[]readonly char) {
	s.pendErr = buf.Concat(s.pendErr, str)
}

// errln appends a fragment and flushes the pending diagnostic line as one
// Diagnostic on the turn's Err — the accumulator analogue of println.
func (s @kernel) errln(str *[]readonly char) {
	s.pendErr = buf.Concat(s.pendErr, str)
	s.curErrs = appendDiag(s.curErrs, s.pendErr)
	var empty @[]char
	s.pendErr = empty
}

// NewKernel runs the load → typecheck → lower pipeline (ending BEFORE main
// runs) and assembles the session; see repl.bni for the contract.
// registerExterns is called to install the VM's externs before any user code
// runs, so prompt entries that call e.g. println / bootstrap.Write resolve via
// the registry rather than crashing with "extern not found"; the driver owns
// those native bindings (the engine stays free of them).
func NewKernel(files @[]@ast.File, root @[]char, bniPaths @[]@[]char, implPaths @[]@[]char,
		registerExterns @func(@vm.VM)) (@Kernel, @[]Error) {
	var merged @ast.File = loader.MergeFiles(files)
	debug.Log("parsed and merged source files")

	var ldr @loader.Loader = loader.NewLoader()
	ldr.AddBniPath(root)
	ldr.AddImplPath(root)
	addLoaderPaths(ldr, bniPaths, implPaths)
	// The REPL runs on the host, so gate #[build(...)] by the host config baked
	// into this binary — no build.bni read.
	ldr.BuildConfig = buildcfg.ConfigForTarget("")
	// The REPL's only compiled-instance substrate is rt + bootstrap (installed
	// as native externs by registerExterns below); load those interface-only.
	// Every OTHER package is interpreted (the REPL injects no stdlib), so
	// importing a __c_call package (e.g. pkg/std/os) lowers it and its native-
	// only __c_call is rejected at type-check (c.Interpreted below).
	ldr.InterfaceOnly = @[]@[]char{"pkg/builtins/rt", "pkg/bootstrap"}
	ldr.LoadImports(merged.Imports)
	ensureBootstrapLoaded(ldr)
	ensureLangLoaded(ldr)
	ensureReflectLoaded(ldr)
	if len(ldr.Errors) > 0 {
		var noSession @Kernel
		return noSession, loaderErrors(ldr)
	}
	debug.Log("imports loaded successfully")

	// Type-check, leaving main file's scope installed on c.Scope.  This checker
	// persists across prompts (s.Chk), so Interpreted carries to every later
	// define / import: __c_call in interpreted REPL input is a type error.
	var c @types.Checker = types.NewChecker()
	c.Interpreted = true
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil { continue }
		if pkg.BNI != nil {
			c.LoadPackageInterface(ldr.Order[i], pkg.BNI)
		}
		if pkg.Merged != nil {
			c.CheckPackage(ldr.Order[i], pkg.Merged, pkg.Files, pkg.BNI)
		}
	}
	c.CheckMainPersistent(merged)
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) > 0 {
		var noSession @Kernel
		return noSession, checkerErrors(errs)
	}
	debug.Log("type checking passed")

	// Build VM and install the host's externs before any user code runs, so
	// prompt entries that call e.g. println / bootstrap.Write resolve via the
	// registry rather than crashing with "extern not found".  registerExterns
	// is the driver's (the CLI installs the standard rt/libc/bootstrap bindings
	// + the pure-C extern table).
	var vmInst @vm.VM = vm.NewVM(8 * 1024 * 1024)
	registerExterns(vmInst)
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil { continue }
		if pkg.Merged == nil { continue }
		var mod @ir.Module = ir.InitModule(quotePath(ldr.Order[i]))
		mod.Checker = c
		var gc @ir.GenCtx = ir.NewGenCtx(mod)
		registerPkgImports(ldr, pkg, gc)
		if pkg.BNI != nil {
			ir.RegisterSelfTypes(c, pkg.BNI, gc)
		}
		ir.GeneratePackage(c, pkg.Merged, gc, pkg.Files)
		vmInst.LowerModule(mod)
	}

	// Lower main package.  Keep mainMod around — synthetic REPL functions are
	// appended to it and routed through LowerOneFunc against this same module
	// (so their context is main's).
	var mainMod @ir.Module = ir.InitModule(merged.PkgName)
	mainMod.Checker = c
	var mainGc @ir.GenCtx = ir.NewGenCtx(mainMod)
	registerMainImports(ldr, merged, mainGc)
	ir.GeneratePackage(c, merged, mainGc, make_slice(@ast.File, 0))
	vmInst.LowerModule(mainMod)

	var s @kernel = assembleSession(vmInst, mainMod, mainGc, c, ldr, ldr.Order)
	var noErrs @[]Error
	var sess @Kernel = s
	return sess, noErrs
}

// assembleSession wires the already-constructed parts onto a session value and
// seeds the processed-package set from the initial load order, so those
// packages aren't reprocessed when a later `import` turn pulls in one of their
// deps.  Split out of NewKernel so it can be unit-tested without the full
// load/typecheck/lower pipeline.
func assembleSession(vmInst @vm.VM, mainMod @ir.Module, mainGc @ir.GenCtx, c @types.Checker,
		ldr @loader.Loader, initialOrder @[]@[]char) @kernel {
	var s @kernel = make(kernel)
	s.Vm = vmInst
	s.MainMod = mainMod
	s.MainGc = mainGc
	s.Chk = c
	s.Ldr = ldr
	s.ProcessedPkgs = vec.New[@[]char]()
	for i := 0; i < len(initialOrder); i++ {
		s.ProcessedPkgs.Push(initialOrder[i])
	}
	return s
}

// loaderErrors wraps the loader's accumulated error strings as Errors.
func loaderErrors(ldr @loader.Loader) @[]Error {
	var out @[]Error
	for i := 0; i < len(ldr.Errors); i++ {
		out = appendError(out, ldr.Errors[i])
	}
	return out
}

// checkerErrors formats each CheckError into an Error message.
func checkerErrors(errs @[]types.CheckError) @[]Error {
	var out @[]Error
	for i := 0; i < len(errs); i++ {
		out = appendError(out, types.FormatCheckError(errs[i]))
	}
	return out
}

// appendError returns dst with one setup-time Error carrying msg appended.
func appendError(dst @[]Error, msg @[]char) @[]Error {
	var n int = len(dst)
	var ns @[]Error = make_slice(Error, n + 1)
	for i := 0; i < n; i++ { ns[i] = dst[i] }
	var e Error
	e.Msg = msg
	ns[n] = e
	return ns
}

// appendNotice returns dst with one Notice carrying msg appended.
func appendNotice(dst @[]Notice, msg @[]char) @[]Notice {
	var n int = len(dst)
	var ns @[]Notice = make_slice(Notice, n + 1)
	for i := 0; i < n; i++ { ns[i] = dst[i] }
	var e Notice
	e.Msg = msg
	ns[n] = e
	return ns
}

// appendDiag returns dst with one Diagnostic carrying msg (as its Value)
// appended.  Name / Traceback stay empty — classification is a follow-up.
func appendDiag(dst @[]Diagnostic, msg @[]char) @[]Diagnostic {
	var n int = len(dst)
	var ns @[]Diagnostic = make_slice(Diagnostic, n + 1)
	for i := 0; i < n; i++ { ns[i] = dst[i] }
	var e Diagnostic
	e.Value = msg
	ns[n] = e
	return ns
}
