package "pkg/binate/repl"

import "pkg/binate/ast"
import "pkg/binate/buildcfg"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/binate/vm"
import "pkg/builtins/build"
import "pkg/builtins/testing"

// NewKernel lays types out for the host it runs on -- its sizes, arch and float ABI
// (hard on an arm32 linux host) -- before it loads anything, so a session whose load
// fails has set it too.
func TestNewKernelSetsHostTarget() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	defer { types.SetTarget(saved) }
	cfg, ok := buildcfg.ConfigForTargetKey("arm32-baremetal")
	if !ok { return fail("arm32-baremetal must be a key") }
	types.SetTarget(buildcfg.TargetFor(cfg))
	var src *[]readonly char = "package \"main\"\nimport \"pkg/binate/repl/no_such_package\"\n"
	var p @parser.Parser = parser.New(toBytesRT(src), "<test>")
	var f @ast.File = mustParse(p)
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = f
	var noPaths @[]@[]char
	var noInjected @[]@[]char
	_, errs := NewKernel(files, ".", noPaths, noPaths, func(v @vm.VM) {}, noInjected)
	if len(errs) == 0 { return fail("the import of a missing package must fail the load") }
	var t types.TargetInfo = types.GetTarget()
	if t.PointerSize != cast(int, sizeof(*uint8)) || t.IntSize != cast(int, sizeof(int)) {
		return fail("NewKernel must lay types out with the host's sizes")
	}
	var arch int = types.ARCH_AA64
	if build.Arch == build.ARCH_X64 { arch = types.ARCH_X64 }
	if build.Arch == build.ARCH_ARM32 { arch = types.ARCH_ARM32 }
	if t.Arch != arch { return fail("NewKernel must set the host's arch") }
	var floatABI int = types.FLOAT_ABI_DEFAULT
	if build.Arch == build.ARCH_ARM32 && build.OS == build.OS_LINUX { floatABI = types.FLOAT_ABI_HARD }
	if t.FloatABI != floatABI { return fail("NewKernel must set the host's float ABI") }
	return ""
}
