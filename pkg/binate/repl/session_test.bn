package "pkg/binate/repl"

import "pkg/builtins/testing"

// Tests for assembleSession (session.bn).  It wires the already-built parts
// onto the session and seeds the processed-package set from the initial load
// order so a later mid-session `import` doesn't reprocess packages the initial
// load already handled.  The VM / module / checker / loader are only STORED
// here (no dereference), so the tests pass nil for them — the field-wiring +
// processed-set seeding is what this helper owns.  NewKernel's full setup
// pipeline is exercised end-to-end by e2e/repl.sh.
//
// seq / fail / appendToCharSlices / setupReplState / toBytesRT live in
// testsupport_test.bn.

func TestAssembleSessionSeedsProcessedPkgs() testing.TestResult {
	var order @[]@[]char
	order = appendToCharSlices(order, "main")
	order = appendToCharSlices(order, "pkg/a")
	var s @kernel = assembleSession(
			nil, nil, nil, nil, nil, order)
	if s.ProcessedPkgs.Len() != 2 {
		return fail("expected ProcessedPkgs seeded with 2 entries")
	}
	if !seq(s.ProcessedPkgs.Get(0), "main") || !seq(s.ProcessedPkgs.Get(1), "pkg/a") {
		return fail("ProcessedPkgs should mirror the initial order")
	}
	if s.Counter != 0 || s.InitCounter != 0 {
		return fail("per-turn counters should start at zero")
	}
	return ""
}

// An empty initial order yields an empty (not nil-dereffing) processed set —
// the seeding loop must handle the zero-package case.
func TestAssembleSessionEmptyOrder() testing.TestResult {
	var order @[]@[]char
	var s @kernel = assembleSession(
			nil, nil, nil, nil, nil, order)
	if s.ProcessedPkgs.Len() != 0 {
		return fail("empty order should seed an empty processed set")
	}
	return ""
}

// appendError is the mechanism NewKernel uses to return setup errors as VALUES
// (instead of printing + aborting).  Pin that it accumulates messages in order
// — loaderErrors / checkerErrors build on it, and the driver reports each .Msg.
// NewKernel's full setup pipeline (incl. the success path) is covered
// end-to-end by e2e/repl.sh.
func TestAppendErrorAccumulatesInOrder() testing.TestResult {
	var out @[]Error
	out = appendError(out, "first")
	out = appendError(out, "second")
	if len(out) != 2 {
		return fail("expected two accumulated errors")
	}
	if !seq(out[0].Msg, "first") || !seq(out[1].Msg, "second") {
		return fail("error messages should be preserved in order")
	}
	return ""
}

// SetPoll forwards the host's interrupt delegate onto the session's VM, arming
// the seam's gate.  (Inert in v1 — wiring is all this stage does.)
func TestSetPollArmsSessionVM() testing.TestResult {
	var s @kernel = setupReplState()
	if s.Vm.PollEnabled {
		return fail("a fresh session's VM poll gate should start closed")
	}
	var poll @func() PollResult = func() PollResult {
		return POLL_CONTINUE
	}
	s.SetPoll(poll)
	if !s.Vm.PollEnabled {
		return fail("SetPoll should arm the session VM's poll gate")
	}
	return ""
}
