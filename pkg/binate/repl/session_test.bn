package "pkg/binate/repl"

import "pkg/builtins/testing"

// Tests for assembleSession (session.bn).  It wires the already-built
// parts onto the session and seeds the processed-package set from the
// initial load order so a later mid-session `import` doesn't reprocess
// packages the initial load already handled.  The VM / module / checker
// / loader are only STORED here (no dereference), so the tests pass nil
// for them — the field-wiring + processed-set seeding is what this
// helper owns.  NewReplSession's full setup pipeline is exercised
// end-to-end by e2e/repl.sh.
//
// seq / fail / appendToCharSlices / setupReplState / toBytesRT live in
// testsupport_test.bn.

func TestAssembleSessionSeedsProcessedPkgs() testing.TestResult {
	var order @[]@[]char
	order = appendToCharSlices(order, "main")
	order = appendToCharSlices(order, "pkg/a")
	var s @replSession = assembleSession(
		nil, nil, nil, nil, nil, order)
	if len(s.ProcessedPkgs) != 2 {
		return fail("expected ProcessedPkgs seeded with 2 entries")
	}
	if !seq(s.ProcessedPkgs[0], "main") ||
			!seq(s.ProcessedPkgs[1], "pkg/a") {
		return fail("ProcessedPkgs should mirror the initial order")
	}
	if s.Counter != 0 || s.InitCounter != 0 {
		return fail("per-turn counters should start at zero")
	}
	return ""
}

// An empty initial order yields an empty (not nil-dereffing) processed
// set — the seeding loop must handle the zero-package case.
func TestAssembleSessionEmptyOrder() testing.TestResult {
	var order @[]@[]char
	var s @replSession = assembleSession(
		nil, nil, nil, nil, nil, order)
	if len(s.ProcessedPkgs) != 0 {
		return fail("empty order should seed an empty processed set")
	}
	return ""
}

// appendReplError is the mechanism NewReplSession uses to return setup
// errors as VALUES (instead of printing + aborting).  Pin that it
// accumulates messages in order — loaderReplErrors / checkerReplErrors
// build on it, and the host prints each .Msg.  NewReplSession's full
// setup pipeline (incl. the success path) is covered end-to-end by
// e2e/repl.sh.
func TestAppendReplErrorAccumulatesInOrder() testing.TestResult {
	var out @[]ReplError
	out = appendReplError(out, "first")
	out = appendReplError(out, "second")
	if len(out) != 2 {
		return fail("expected two accumulated errors")
	}
	if !seq(out[0].Msg, "first") || !seq(out[1].Msg, "second") {
		return fail("error messages should be preserved in order")
	}
	return ""
}

// sinkProbe counts diagnostics a host-supplied ReplIO receives.
type sinkProbe struct {
	ErrN int
}

// A host-supplied ReplIO must actually capture the engine's framing
// output — the whole point of the pluggable sink.  Drive a diagnostic
// (a type error) through a session whose sink is a capturing closure
// over a managed probe, and confirm the diagnostic landed on the host's
// WriteErr channel rather than going straight to stdout.  (The probe is
// @-managed, so the capture is CAP_MANAGED — no raw-pointer warning.)
func TestReplFramingRoutesThroughSink() testing.TestResult {
	var probe @sinkProbe = make(sinkProbe)
	var wOut @func(*[]readonly char) int = func(str *[]readonly char) int {
		return len(str)
	}
	var wErr @func(*[]readonly char) int = func(str *[]readonly char) int {
		probe.ErrN = probe.ErrN + 1
		return len(str)
	}
	var io ReplIO
	io.WriteOut = wOut
	io.WriteErr = wErr
	var s @replSession = setupReplState()
	s.Io = io
	s.evalReplLine(toBytesRT("println(undefinedSym)\n"))
	if probe.ErrN == 0 {
		return fail("a diagnostic must route through the host WriteErr sink")
	}
	return ""
}

// SetPoll forwards the host's interrupt delegate onto the session's VM,
// arming the seam's gate.  (Inert in v1 — wiring is all this stage does.)
func TestSetPollArmsSessionVM() testing.TestResult {
	var s @replSession = setupReplState()
	if s.Vm.PollEnabled {
		return fail("a fresh session's VM poll gate should start closed")
	}
	var poll @func() PollResult = func() PollResult {
		return POLL_CONTINUE
	}
	s.SetPoll(poll)
	if !s.Vm.PollEnabled {
		return fail("SetPoll should arm the session VM's poll gate")
	}
	return ""
}
