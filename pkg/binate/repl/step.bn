package "pkg/binate/repl"

import "pkg/binate/vm"

// Step / Init drive the REPL one host-pushed line at a time — the
// "coroutine-ish" inversion of a read-loop.  The host owns the read: it
// calls Init() once (pre-prompt), then Step(line, eof) per input line,
// rendering the next prompt from the returned StepResult.  StepResult
// and the STEP_* status values are declared in the package interface
// (repl.bni); this file holds the engine behavior.

// stepResult builds a StepResult value.
func stepResult(status StepStatus, counter int, depth int) StepResult {
	var r StepResult
	r.Status = status
	r.Counter = counter
	r.Depth = depth
	return r
}

// Init runs any pre-prompt initialization, emits its output through the
// sink, and returns the StepResult for the first prompt.  Today the only
// pre-prompt output is the banner (setup ends before main runs); module
// init / result-echo would emit here too when they land.
func (s @kernel) Init() StepResult {
	s.outln("Binate REPL (Tier 1 PoC). Ctrl-D to exit.")
	return stepResult(STEP_EVALUATED, s.Counter, 0)
}

// Step feeds ONE host-read line into the session and runs until the next
// prompt is due, returning what the host should render next.  Multi-line
// input accumulates until open-bracket depth balances to 0 (every `{`
// and `(` closed; brackets inside strings / char literals / comments are
// skipped) — until then Step returns STEP_NEED_MORE so the host shows a
// continuation prompt.  eof at a turn boundary → STEP_EOF_CLEAN; eof
// mid-accumulation discards the buffered input (the user bailed) →
// STEP_EOF_UNBALANCED.  A complete turn is evaluated via evalReplLine,
// the accumulator is reset, and Counter advances.
func (s @kernel) Step(line *[]readonly uint8, eof bool) StepResult {
	if eof {
		if len(s.Accumulated) > 0 {
			var empty @[]uint8
			s.Accumulated = empty
			return stepResult(STEP_EOF_UNBALANCED, s.Counter, 0)
		}
		return stepResult(STEP_EOF_CLEAN, s.Counter, 0)
	}
	// Append the line followed by a newline so the parser sees the
	// same line breaks the user typed.
	for i := 0; i < len(line); i++ {
		s.Accumulated = appendByteRepl(s.Accumulated, line[i])
	}
	s.Accumulated = appendByteRepl(s.Accumulated, 10)
	// Empty input at top level: nothing to do — reprompt at primary.
	if len(line) == 0 && computeOpenDepth(s.Accumulated) == 0 {
		var empty @[]uint8
		s.Accumulated = empty
		return stepResult(STEP_EVALUATED, s.Counter, 0)
	}
	// Still inside an open `{` or `(` — keep reading.
	var depth int = computeOpenDepth(s.Accumulated)
	if depth > 0 {
		return stepResult(STEP_NEED_MORE, s.Counter, depth)
	}
	// Complete — evaluate and reset the accumulator.
	s.evalReplLine(s.Accumulated)
	// A host interrupt poll may have suspended or aborted the turn's
	// evaluation.  Inert in v1: the poll seam is unarmed, so the VM's
	// status stays Continue and neither branch fires (the suspend /
	// break stages make these live).
	if s.Vm.Status == vm.VM_STATUS_SUSPENDED {
		return stepResult(STEP_SUSPENDED, s.Counter, 0)
	}
	if s.Vm.Status == vm.VM_STATUS_BROKE {
		var broke @[]uint8
		s.Accumulated = broke
		return stepResult(STEP_BROKE, s.Counter, 0)
	}
	var empty @[]uint8
	s.Accumulated = empty
	s.Counter = s.Counter + 1
	return stepResult(STEP_EVALUATED, s.Counter, 0)
}

// IsComplete reports whether `code` is a complete submittable unit, using
// the same open-bracket depth heuristic Step's accumulation uses: depth 0 ⇒
// COMP_COMPLETE, depth > 0 ⇒ COMP_INCOMPLETE (carrying the depth as the
// continuation-indent hint).  A separate query from evaluation so a host can
// decide submit-vs-continue without pushing a line into Step.
func (s @kernel) IsComplete(code *[]readonly uint8) Completeness {
	var r Completeness
	var depth int = computeOpenDepth(code)
	if depth > 0 {
		r.Status = COMP_INCOMPLETE
		r.Indent = depth
	} else {
		r.Status = COMP_COMPLETE
		r.Indent = 0
	}
	return r
}

// KernelInfo returns the banner + language metadata as data.  The banner is
// the same string Init emits; exposing it as data lets a host render it
// wherever it likes rather than the engine printing it.
func (s @kernel) KernelInfo() KernelInfo {
	var info KernelInfo
	info.Banner = "Binate REPL (Tier 1 PoC). Ctrl-D to exit."
	info.LangName = "binate"
	info.LangVersion = ""
	info.FileExt = ".bn"
	return info
}
