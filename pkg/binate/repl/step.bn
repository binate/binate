package "pkg/binate/repl"

import "pkg/binate/vm"

// Execute / IsComplete / KernelInfo are the core of the request/reply Kernel
// surface: the driver asks whether a unit is complete (IsComplete), runs a
// complete unit (Execute), and reads the banner/metadata (KernelInfo).  The
// loop + presentation are the driver's (see RunReadLoop for an optional
// helper).  Result / Completeness / KernelInfo and the status values are
// declared in the package interface (repl.bni); this file holds the behavior.

// Execute runs ONE complete code unit and returns its structured outcome.
// Per-turn notices / diagnostics accumulate through out / err (drained here
// into the Result); output produced by EVALUATED user code goes wherever the
// driver's injected externs point (not captured here in v1).  A host interrupt
// poll may suspend / abort the turn — inert in v1 (the poll seam is unarmed),
// so the status stays EXEC_OK / EXEC_ERROR.  On a normal turn the counter
// advances (feeding the next __repl_<n>).
func (s @kernel) Execute(code *[]readonly uint8) Result {
	s.resetTurnOutput()
	var turnIdx int = s.Counter
	var owned @[]uint8 = copyBytes(code)
	// Ensure a trailing newline so the parser sees a statement terminator,
	// whether the driver supplied one (RunReadLoop appends one per line) or not
	// (a whole-cell driver may omit it).  Don't double an existing newline.
	if len(owned) == 0 || owned[len(owned) - 1] != 10 {
		owned = appendByteRepl(owned, 10)
	}
	s.evalReplLine(owned)
	var r Result
	r.Turn = turnIdx
	if s.Vm.Status == vm.VM_STATUS_SUSPENDED {
		r.Status = EXEC_SUSPENDED
	} else if s.Vm.Status == vm.VM_STATUS_BROKE {
		r.Status = EXEC_BROKE
	} else {
		s.Counter = s.Counter + 1
		if len(s.curErrs) > 0 {
			r.Status = EXEC_ERROR
		} else {
			r.Status = EXEC_OK
		}
	}
	r.Notices = s.curNotices
	r.Err = s.curErrs
	return r
}

// IsComplete reports whether `code` is a complete submittable unit, using the
// open-bracket depth heuristic a line-oriented driver accumulates with: depth
// 0 ⇒ COMP_COMPLETE, depth > 0 ⇒ COMP_INCOMPLETE (carrying the depth as the
// continuation-indent hint).  A separate query from evaluation so a driver can
// decide submit-vs-continue without pushing a line into Execute.
func (s @kernel) IsComplete(code *[]readonly uint8) Completeness {
	var r Completeness
	var depth int = computeOpenDepth(code)
	if depth > 0 {
		r.Status = COMP_INCOMPLETE
		r.Indent = depth
	} else {
		r.Status = COMP_COMPLETE
		r.Indent = 0
	}
	return r
}

// KernelInfo returns the banner + language metadata as data, so a driver
// renders it wherever it likes rather than the engine printing it.
func (s @kernel) KernelInfo() KernelInfo {
	var info KernelInfo
	info.Banner = "Binate REPL (Tier 1 PoC). Ctrl-D to exit."
	info.LangName = "binate"
	info.LangVersion = ""
	info.FileExt = ".bn"
	return info
}
