package "pkg/binate/repl"

import "pkg/builtins/testing"

// Tests for the push-driven Init / Step (step.bn): the host feeds one
// line at a time and renders the next prompt from the StepResult.
// setupReplState / toBytesRT live in testsupport_test.bn.
//
// NOTE: there is no end-to-end test here for Step's
// STEP_SUSPENDED/STEP_BROKE mapping (a poll firing during eval), because
// it requires installing a poll through s.SetPoll, whose param→field
// @func forwarding corrupts the func value under int mode — the same
// MAJOR bug as conformance/534 (capturing @func param→field), manifested
// for any @func passed through a forwarding parameter.  The VM-level
// poll mechanics ARE covered across modes in pkg/binate/vm
// (vm_poll_test.bn, direct vm.SetPoll); the inert Step mapping is a
// trivial Status→StepResult translation.  Re-add the end-to-end mapping
// test once the @func RefInc fix lands.

// Init reports ready for the first (primary) prompt.
func TestInitReturnsReadyForPrompt() testing.TestResult {
	var s @ReplSession = setupReplState()
	var r StepResult = s.Init()
	if r.Status != STEP_EVALUATED {
		return fail("Init should report ready (STEP_EVALUATED)")
	}
	if r.Depth != 0 {
		return fail("Init should request the primary prompt (Depth 0)")
	}
	return ""
}

// An unbalanced line accumulates and asks for more, carrying the
// open-bracket depth so the host can render a continuation prompt.
func TestStepNeedMoreOnOpenBracket() testing.TestResult {
	var s @ReplSession = setupReplState()
	var r StepResult = s.Step(toBytesRT("for i := 0; i < 1; i++ {"), false)
	if r.Status != STEP_NEED_MORE {
		return fail("an unbalanced line should yield STEP_NEED_MORE")
	}
	if r.Depth <= 0 {
		return fail("STEP_NEED_MORE should carry the open-bracket depth")
	}
	return ""
}

// A balanced line evaluates, requests the primary prompt, and advances
// the In[n] counter.
func TestStepEvaluatesAndAdvancesCounter() testing.TestResult {
	var s @ReplSession = setupReplState()
	var r StepResult = s.Step(toBytesRT("println(\"x\")"), false)
	if r.Status != STEP_EVALUATED {
		return fail("a complete line should evaluate (STEP_EVALUATED)")
	}
	if r.Depth != 0 {
		return fail("a completed turn requests the primary prompt")
	}
	if r.Counter != 1 {
		return fail("Counter should advance after a completed turn")
	}
	return ""
}

// An empty top-level line just reprompts at the primary prompt — it
// completes a turn (EVALUATED, Depth 0) but evaluates nothing, so the
// In[n] counter does NOT advance (distinct from a real eval).
func TestStepEmptyInputReprompts() testing.TestResult {
	var s @ReplSession = setupReplState()
	var none @[]uint8
	var r StepResult = s.Step(none, false)
	if r.Status != STEP_EVALUATED || r.Depth != 0 {
		return fail("empty input should reprompt at the primary prompt")
	}
	if r.Counter != 0 {
		return fail("empty input must not advance the In[n] counter")
	}
	return ""
}

// eof at a turn boundary (nothing buffered) is a clean exit.
func TestStepEofCleanAtBoundary() testing.TestResult {
	var s @ReplSession = setupReplState()
	var none @[]uint8
	var r StepResult = s.Step(none, true)
	if r.Status != STEP_EOF_CLEAN {
		return fail("eof at a turn boundary should be STEP_EOF_CLEAN")
	}
	return ""
}

// eof mid-accumulation discards the buffered input (the user bailed)
// and reports it distinctly so a richer host can react.
func TestStepEofUnbalancedDiscardsBuffer() testing.TestResult {
	var s @ReplSession = setupReplState()
	s.Step(toBytesRT("if x {"), false)
	var none @[]uint8
	var r StepResult = s.Step(none, true)
	if r.Status != STEP_EOF_UNBALANCED {
		return fail("eof mid-accumulation should be STEP_EOF_UNBALANCED")
	}
	if len(s.Accumulated) != 0 {
		return fail("the buffered input should be discarded on eof")
	}
	return ""
}
