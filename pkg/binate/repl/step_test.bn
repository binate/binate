package "pkg/binate/repl"

import "pkg/builtins/testing"

// Tests for the request/reply Kernel surface (step.bn): Execute runs a complete
// unit and returns a Result (notices / diagnostics as DATA), and IsComplete /
// KernelInfo are the completeness + metadata queries.  The accumulation / prompt
// logic lives in the RunReadLoop driver helper (see loop_test.bn).
// setupReplState / toBytesRT / seq / fail live in testsupport_test.bn.
//
// TestExecuteCapturingPollSuspends is the end-to-end seam test: a CAPTURING host
// poll (VM-free, @func() PollResult) installed through s.SetPoll fires during a
// turn's eval and its POLL_SUSPEND maps onto EXEC_SUSPENDED.  s.SetPoll wraps the
// host poll in a VM-level adapter before forwarding to vm.SetPoll; the captured
// counter advancing confirms a live capturing closure reached the VM with its
// capture intact.  (The VM-level poll mechanics are covered in pkg/binate/vm's
// vm_poll_test.bn.)

// A complete stmt-list unit evaluates: EXEC_OK, this turn's index (0), the
// counter advances, and a synthetic __repl_<n> lands in the module.
func TestExecuteEvaluatesAndAdvancesTurn() testing.TestResult {
	var s @kernel = setupReplState()
	var before int = len(s.MainMod.Funcs)
	var r Result = s.Execute(toBytesRT("println(\"x\")"))
	if r.Status != EXEC_OK {
		return fail("a complete stmt should evaluate (EXEC_OK)")
	}
	if r.Turn != 0 {
		return fail("the first turn's index should be 0")
	}
	if s.Counter != 1 {
		return fail("Counter should advance after an evaluated turn")
	}
	if len(s.MainMod.Funcs) != before + 1 {
		return fail("a stmt-list turn should add one synthetic __repl_<n>")
	}
	return ""
}

// A type error comes back in Result.Err as DATA (EXEC_ERROR), not printed —
// the whole point of the data-returning Execute.
func TestExecuteReportsErrorAsData() testing.TestResult {
	var s @kernel = setupReplState()
	var r Result = s.Execute(toBytesRT("println(undefinedSym)"))
	if r.Status != EXEC_ERROR {
		return fail("a type error should yield EXEC_ERROR")
	}
	if len(r.Err) == 0 {
		return fail("a diagnostic must come back in Result.Err (data, not printed)")
	}
	return ""
}

// Execute via the @Kernel INTERFACE (vtable dispatch) rather than the concrete
// @kernel — a driver that holds only the abstraction can run a turn, and the
// Result comes back intact through interface dispatch (not just its first field).
func TestInterfaceDispatchExecute() testing.TestResult {
	var concrete @kernel = setupReplState()
	var k @Kernel = concrete
	var r Result = k.Execute(toBytesRT("println(\"x\")"))
	if r.Status != EXEC_OK {
		return fail("Execute via the interface should report EXEC_OK")
	}
	if r.Turn != 0 {
		return fail("Result.Turn should survive interface dispatch")
	}
	return ""
}

// IsComplete maps a balanced unit to COMP_COMPLETE (Indent 0) and an
// unbalanced one to COMP_INCOMPLETE carrying the open-bracket depth — the
// completeness query a driver uses to decide submit-vs-continue.
func TestIsCompleteBalanced() testing.TestResult {
	var s @kernel = setupReplState()
	var c Completeness = s.IsComplete(toBytesRT("println(\"x\")"))
	if c.Status != COMP_COMPLETE {
		return fail("a balanced unit should be COMP_COMPLETE")
	}
	if c.Indent != 0 {
		return fail("COMP_COMPLETE should carry Indent 0")
	}
	return ""
}

func TestIsCompleteUnbalanced() testing.TestResult {
	var s @kernel = setupReplState()
	var c Completeness = s.IsComplete(toBytesRT("for i := 0; i < 1; i++ {"))
	if c.Status != COMP_INCOMPLETE {
		return fail("an open bracket should be COMP_INCOMPLETE")
	}
	if c.Indent <= 0 {
		return fail("COMP_INCOMPLETE should carry the open-bracket depth")
	}
	return ""
}

// KernelInfo exposes the banner + language metadata as data (the driver
// renders it), rather than the engine printing the banner itself.
func TestKernelInfoBannerAndLang() testing.TestResult {
	var s @kernel = setupReplState()
	var info KernelInfo = s.KernelInfo()
	if len(info.Banner) == 0 {
		return fail("KernelInfo should carry a non-empty banner")
	}
	if !seq(info.LangName, "binate") {
		return fail("KernelInfo.LangName should be binate")
	}
	if !seq(info.FileExt, ".bn") {
		return fail("KernelInfo.FileExt should be .bn")
	}
	return ""
}

// pollCounter is a managed object a capturing host poll closes over, so the
// seam test exercises the @func capture record crossing s.SetPoll → wrapper →
// vm.SetPoll.
type pollCounter struct {
	Hits int
}

// A CAPTURING host poll, forwarded through s.SetPoll, fires during a turn's
// eval and suspends it.  The poll closes over a managed counter, counts its
// fires, and returns POLL_SUSPEND past a threshold; evaluating a loop drives
// the VM's poll points, and the recorded SUSPEND maps onto EXEC_SUSPENDED.  The
// captured counter advancing proves s.SetPoll wrapped + forwarded a live,
// capturing closure that the VM invoked with its capture intact.
func TestExecuteCapturingPollSuspends() testing.TestResult {
	var s @kernel = setupReplState()
	var ctr @pollCounter = make(pollCounter)
	ctr.Hits = 0
	var poll @func() PollResult = func() PollResult {
		ctr.Hits = ctr.Hits + 1
		if ctr.Hits >= 3 { return POLL_SUSPEND }
		return POLL_CONTINUE
	}
	s.SetPoll(poll)
	var r Result = s.Execute(toBytesRT("for i := 0; i < 10; i++ { }"))
	if r.Status != EXEC_SUSPENDED {
		return fail("a capture-driven poll SUSPEND must map to EXEC_SUSPENDED")
	}
	if ctr.Hits < 3 {
		return fail("the forwarded capturing poll must fire (capture intact)")
	}
	return ""
}
