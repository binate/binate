package "pkg/binate/repl"

import "pkg/builtins/testing"

// Tests for the push-driven Init / Step (step.bn): the host feeds one
// line at a time and renders the next prompt from the StepResult.
// setupReplState / toBytesRT live in testsupport_test.bn.
//
// TestStepCapturingPollSuspendsTurn is the end-to-end seam test: a
// CAPTURING host poll (VM-free, @func() PollResult) installed through
// s.SetPoll fires during a turn's eval and its POLL_SUSPEND maps onto
// STEP_SUSPENDED.  s.SetPoll wraps the host poll in a VM-level adapter
// before forwarding to vm.SetPoll; the captured counter advancing
// confirms a live capturing closure reached the VM with its capture
// intact.  The VM-level poll mechanics are covered in pkg/binate/vm
// (vm_poll_test.bn, direct vm.SetPoll).

// Init reports ready for the first (primary) prompt.
func TestInitReturnsReadyForPrompt() testing.TestResult {
	var s @kernel = setupReplState()
	var r StepResult = s.Init()
	if r.Status != STEP_EVALUATED {
		return fail("Init should report ready (STEP_EVALUATED)")
	}
	if r.Depth != 0 {
		return fail("Init should request the primary prompt (Depth 0)")
	}
	return ""
}

// An unbalanced line accumulates and asks for more, carrying the
// open-bracket depth so the host can render a continuation prompt.
func TestStepNeedMoreOnOpenBracket() testing.TestResult {
	var s @kernel = setupReplState()
	var r StepResult = s.Step(toBytesRT("for i := 0; i < 1; i++ {"), false)
	if r.Status != STEP_NEED_MORE {
		return fail("an unbalanced line should yield STEP_NEED_MORE")
	}
	if r.Depth <= 0 {
		return fail("STEP_NEED_MORE should carry the open-bracket depth")
	}
	return ""
}

// A balanced line evaluates, requests the primary prompt, and advances
// the In[n] counter.
func TestStepEvaluatesAndAdvancesCounter() testing.TestResult {
	var s @kernel = setupReplState()
	var r StepResult = s.Step(toBytesRT("println(\"x\")"), false)
	if r.Status != STEP_EVALUATED {
		return fail("a complete line should evaluate (STEP_EVALUATED)")
	}
	if r.Depth != 0 {
		return fail("a completed turn requests the primary prompt")
	}
	if r.Counter != 1 {
		return fail("Counter should advance after a completed turn")
	}
	return ""
}

// An empty top-level line just reprompts at the primary prompt — it
// completes a turn (EVALUATED, Depth 0) but evaluates nothing, so the
// In[n] counter does NOT advance (distinct from a real eval).
func TestStepEmptyInputReprompts() testing.TestResult {
	var s @kernel = setupReplState()
	var none @[]uint8
	var r StepResult = s.Step(none, false)
	if r.Status != STEP_EVALUATED || r.Depth != 0 {
		return fail("empty input should reprompt at the primary prompt")
	}
	if r.Counter != 0 {
		return fail("empty input must not advance the In[n] counter")
	}
	return ""
}

// eof at a turn boundary (nothing buffered) is a clean exit.
func TestStepEofCleanAtBoundary() testing.TestResult {
	var s @kernel = setupReplState()
	var none @[]uint8
	var r StepResult = s.Step(none, true)
	if r.Status != STEP_EOF_CLEAN {
		return fail("eof at a turn boundary should be STEP_EOF_CLEAN")
	}
	return ""
}

// eof mid-accumulation discards the buffered input (the user bailed)
// and reports it distinctly so a richer host can react.
func TestStepEofUnbalancedDiscardsBuffer() testing.TestResult {
	var s @kernel = setupReplState()
	s.Step(toBytesRT("if x {"), false)
	var none @[]uint8
	var r StepResult = s.Step(none, true)
	if r.Status != STEP_EOF_UNBALANCED {
		return fail("eof mid-accumulation should be STEP_EOF_UNBALANCED")
	}
	if len(s.Accumulated) != 0 {
		return fail("the buffered input should be discarded on eof")
	}
	return ""
}

// pollCounter is a managed object a capturing host poll closes over, so
// the seam test exercises the @func capture record crossing the
// s.SetPoll → wrapper → vm.SetPoll forward.
type pollCounter struct {
	Hits int
}

// A CAPTURING host poll, forwarded through s.SetPoll, fires during a
// turn's eval and suspends it.  The poll closes over a managed counter,
// counts its fires, and returns POLL_SUSPEND once past a threshold;
// evaluating a loop drives the VM's poll points, and the recorded SUSPEND
// maps onto STEP_SUSPENDED.  The captured counter advancing proves
// s.SetPoll wrapped + forwarded a live, capturing closure that the VM
// invoked with its capture intact.
func TestStepCapturingPollSuspendsTurn() testing.TestResult {
	var s @kernel = setupReplState()
	var ctr @pollCounter = make(pollCounter)
	ctr.Hits = 0
	var poll @func() PollResult = func() PollResult {
		ctr.Hits = ctr.Hits + 1
		if ctr.Hits >= 3 { return POLL_SUSPEND }
		return POLL_CONTINUE
	}
	s.SetPoll(poll)
	var r StepResult = s.Step(toBytesRT("for i := 0; i < 10; i++ { }"), false)
	if r.Status != STEP_SUSPENDED {
		return fail("a capture-driven poll SUSPEND must map to STEP_SUSPENDED")
	}
	if ctr.Hits < 3 {
		return fail("the forwarded capturing poll must fire (capture intact)")
	}
	return ""
}

// TestInterfaceDispatchDrivesTurn drives a session through the
// @Kernel INTERFACE (vtable dispatch) rather than the concrete
// @kernel, proving a host that holds only the abstraction can run
// Init + Step — and (the regression this pins) that StepResult comes
// back intact through interface dispatch, not just its first field.
func TestInterfaceDispatchDrivesTurn() testing.TestResult {
	var concrete @kernel = setupReplState()
	var s @Kernel = concrete
	var r StepResult = s.Init()
	if r.Status != STEP_EVALUATED {
		return fail("Init via the interface should report STEP_EVALUATED")
	}
	if r.Depth != 0 {
		return fail("Init via the interface should request the primary prompt")
	}
	var r2 StepResult = s.Step(toBytesRT(""), false)
	if r2.Status != STEP_EVALUATED || r2.Depth != 0 {
		return fail("empty Step via the interface should reprompt at primary")
	}
	return ""
}
