package "pkg/binate/repl"

import "pkg/binate/ast"
import "pkg/binate/interp"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/binate/vm"
import "pkg/builtins/testing"

// Shared test helpers for the repl-engine unit tests: result/compare
// sugar (fail / seq), a char-slice → byte-slice converter (toBytesRT),
// a minimal session builder (setupReplState), and a tiny managed-slice
// append (appendToCharSlices).

// fail wraps a message as a failing TestResult.
func fail(msg @[]char) testing.TestResult {
	return msg
}

// seq compares two char slices for equality.
func seq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// toBytesRT copies a (readonly) char slice into a fresh @[]uint8 — the
// shape evalReplLine / Step consume.
func toBytesRT(s *[]readonly char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

// setupReplState builds a minimal session so the checker has a scope to
// install for CheckStmtListInScope.  Mirrors what NewReplSession does
// post-load, minus the loader / VM lowering of dependencies.  The host
// standard set (interp.RegisterStandardExterns) plus the pure-C
// pkg/bootstrap surface (interp.RegisterPureCExterns) bind
// pkg/bootstrap.Write + the format helpers, which is what the
// println-bearing eval tests need.
func setupReplState() @replSession {
	var srcStr *[]readonly char = "package \"main\"\nfunc main() { }\n"
	var src @[]uint8 = toBytesRT(srcStr)
	var p @parser.Parser = parser.New(src, "<test>")
	var f @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.CheckMainPersistent(f)
	var m @ir.Module = ir.InitModule(f.PkgName)
	var gc @ir.GenCtx = ir.NewGenCtx(m)
	ir.GeneratePackage(c, f, gc, make_slice(@ast.File, 0))
	var vmInst @vm.VM = vm.NewVM(64 * 1024)
	interp.RegisterStandardExterns(vmInst)
	interp.RegisterPureCExterns(vmInst)
	vmInst.LowerModule(m)
	// The import-session fields stay zero — these tests exercise the
	// stmt-list and decl paths, not mid-session `import`.
	var s @replSession = make(replSession)
	s.Vm = vmInst
	s.MainMod = m
	s.MainGc = gc
	s.Chk = c
	// Discard sink — these tests assert on module state, not output.
	// (Typed @func vars give the literals their flavour hint.)
	var wOut @func(*[]readonly char) int = func(str *[]readonly char) int {
		return len(str)
	}
	var wErr @func(*[]readonly char) int = func(str *[]readonly char) int {
		return len(str)
	}
	var io ReplIO
	io.WriteOut = wOut
	io.WriteErr = wErr
	s.Io = io
	return s
}

// appendToCharSlices appends one managed char slice to a managed slice
// of them.  Spelled inline (rather than via pkg/stdx/slices) to keep the
// test files free of generics.
func appendToCharSlices(dst @[]@[]char, s @[]char) @[]@[]char {
	var n int = len(dst)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = dst[i] }
	ns[n] = s
	return ns
}
