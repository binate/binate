package "pkg/binate/repl"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/std/containers/vec"

// A REPL code unit — what one Execute runs, a line at a CLI prompt or a whole
// notebook cell — is a sequence of entries, each evaluated as if entered on its
// own: an import, a top-level declaration, or a run of statements.  A unit
// starting with `import` or a declaration keyword starts with that entry, and
// the rest of the unit is read the same way; a run of statements extends to the
// end of the unit (so a unit has at most one, at its end), and a `var`, `const`
// or `type` among statements declares a local of the run, as in a function body.

// entryImport is an import entry (replEntry.Specs).
const entryImport int = 0

// entryDecl is a top-level declaration entry (replEntry.Decl).
const entryDecl int = 1

// entryStmts is a run of statements (replEntry.Stmts).
const entryStmts int = 2

// replEntry is one entry of a code unit; Kind says which of the other fields
// holds it.
type replEntry struct {
	Kind  int
	Specs @[]@ast.ImportSpec
	Decl  @ast.Decl
	Stmts @[]@ast.Stmt
}

// parseReplUnit parses the code unit p reads into its entries, in order,
// stopping after an entry with a parse error (p.Errors()).
func parseReplUnit(p @parser.Parser) @[]replEntry {
	var entries @vec.Vec[replEntry] = vec.New[replEntry]()
	for {
		var e replEntry
		if p.IsAtImport() {
			e.Kind = entryImport
			e.Specs = p.ParseImportDecl()
		} else if p.IsAtTopLevelDecl() {
			e.Kind = entryDecl
			e.Decl = p.ParseTopLevelDecl()
		} else {
			e.Kind = entryStmts
			e.Stmts = p.ParseStmtList()
			entries.Push(e)
			return entries.Items()
		}
		entries.Push(e)
		if len(p.Errors()) > 0 || !p.EndReplEntry() { return entries.Items() }
	}
}
