package "pkg/binate/repl"

import "pkg/builtins/testing"

// Tests for code units of several entries (unit.bn, evalReplLine).
// setupReplState / toBytesRT / fail live in testsupport_test.bn; containsSub /
// moduleHasFunc in decl_test.bn.

// A unit's declarations are all evaluated, in order, each initializer run: the
// next turn sees `i` as 5.
func TestUnitEvaluatesEveryDeclaration() testing.TestResult {
	s := setupReplState()
	var r Result = s.Execute(toBytesRT("var a [3]int\nvar i int = 5\n"))
	if r.Status != EXEC_OK {
		return fail("a unit of two declarations should evaluate cleanly")
	}
	r = s.Execute(toBytesRT("_ = a[i]"))
	if len(r.Err) != 1 || !containsSub(r.Err[0].Value, "index out of bounds: 5") {
		return fail("the unit's second declaration should have been evaluated")
	}
	if containsSub(r.Err[0].Value, "initialization of") {
		return fail("a statement's own fault should be reported as the bare runtime error")
	}
	return ""
}

// Declarations followed by statements, on one line: the statements run after
// the declarations they use — k's initializer, then the statement doubling k —
// as the turn's __repl_<n>.
func TestUnitDeclarationsThenStatements() testing.TestResult {
	s := setupReplState()
	s.Execute(toBytesRT("var arr [3]int"))
	var r Result = s.Execute(toBytesRT("func g() int { return 7 }; var k int = g(); k = k + g()"))
	if r.Status != EXEC_OK || len(r.Err) != 0 {
		return fail("declarations then statements should evaluate cleanly")
	}
	// A fresh session's second turn is turn 1.
	if !moduleHasFunc(s.MainMod, "main.__repl_1") {
		return fail("the statements should run as the turn's synthetic function")
	}
	r = s.Execute(toBytesRT("_ = arr[k]"))
	if len(r.Err) != 1 || !containsSub(r.Err[0].Value, "index out of bounds: 14") {
		return fail("k should be initialized and then doubled by the statement")
	}
	return ""
}

// An entry that fails ends the unit: the declaration after it is not evaluated.
func TestUnitStopsAtFailedEntry() testing.TestResult {
	s := setupReplState()
	var r Result = s.Execute(toBytesRT("var u int = \"s\"\nvar w int = 1\n"))
	if r.Status != EXEC_ERROR || len(r.Err) != 1 {
		return fail("the failing declaration should be the turn's one error")
	}
	r = s.Execute(toBytesRT("_ = w"))
	if len(r.Err) != 1 || !containsSub(r.Err[0].Value, "undefined: w") {
		return fail("the declaration after a failed entry should not be evaluated")
	}
	return ""
}

// A parse error anywhere in the unit runs none of it.
func TestUnitParseErrorRunsNothing() testing.TestResult {
	s := setupReplState()
	var r Result = s.Execute(toBytesRT("var v int = 1\nfunc (\n"))
	if r.Status != EXEC_ERROR {
		return fail("a unit with a parse error should fail")
	}
	r = s.Execute(toBytesRT("_ = v"))
	if len(r.Err) != 1 || !containsSub(r.Err[0].Value, "undefined: v") {
		return fail("a unit with a parse error should declare nothing")
	}
	return ""
}

// A `var` among statements is a local of the run, as before: the statements
// after it see it, and the next turn does not.
func TestUnitVarAmongStatementsIsLocal() testing.TestResult {
	s := setupReplState()
	var r Result = s.Execute(toBytesRT("x := 1\nvar y int = x + 1\n_ = x + y\n"))
	if r.Status != EXEC_OK {
		return fail("a run of statements with a local var should evaluate cleanly")
	}
	r = s.Execute(toBytesRT("_ = y"))
	if len(r.Err) != 1 || !containsSub(r.Err[0].Value, "undefined: y") {
		return fail("a var among statements should be local to the run")
	}
	return ""
}

// A parked declaration's error when it is retried — its initializer faulting,
// or its body failing to check — is reported, but is not the entry's: the rest
// of the unit is evaluated.
func TestUnitParkedErrorsDoNotEndUnit() testing.TestResult {
	s := setupReplState()
	s.Execute(toBytesRT("var arr [2]int"))
	s.Execute(toBytesRT("var z int = arr[w]"))
	s.Execute(toBytesRT("func f() int { return g(1) }"))
	var r Result = s.Execute(
			toBytesRT("var w int = 5\nfunc g() int { return 2 }\nvar after int = g()\n"))
	if len(r.Err) < 2 ||
			!containsSub(r.Err[0].Value,
					"initialization of variable z faulted: runtime error: index out of bounds: 5") {
		return fail("z's faulting initializer and f's check error should be reported")
	}
	r = s.Execute(toBytesRT("_ = after"))
	if r.Status != EXEC_OK {
		return fail("the entries after ones that let parked declarations resolve should be evaluated")
	}
	return ""
}

// A declaration whose initializer faults ends the unit, as one that fails to
// check does.
func TestUnitFaultEndsUnit() testing.TestResult {
	s := setupReplState()
	s.Execute(toBytesRT("var arr [2]int"))
	s.Execute(toBytesRT("var k int = 5"))
	var r Result = s.Execute(toBytesRT("var e int = arr[k]\nvar after int = 1\n"))
	if r.Status != EXEC_ERROR || len(r.Err) != 1 ||
			!containsSub(r.Err[0].Value,
					"initialization of variable e faulted: runtime error: index out of bounds: 5") {
		return fail("e's faulting initializer should be the turn's one error")
	}
	r = s.Execute(toBytesRT("_ = after"))
	if len(r.Err) != 1 || !containsSub(r.Err[0].Value, "undefined: after") {
		return fail("the declaration after a faulting one should not be evaluated")
	}
	return ""
}

// Declarations ending in a written `;` at the end of their lines are all
// evaluated as declarations, and leave no statements to run.
func TestUnitLineEndingSemicolons() testing.TestResult {
	s := setupReplState()
	var r Result = s.Execute(toBytesRT("var a int = 1;\nvar b int = 2;\n"))
	if r.Status != EXEC_OK || len(r.Err) != 0 {
		return fail("line-ending semicolons should be accepted")
	}
	if moduleHasFunc(s.MainMod, "main.__repl_0") {
		return fail("a unit of declarations should run no statements")
	}
	r = s.Execute(toBytesRT("_ = a + b"))
	if r.Status != EXEC_OK {
		return fail("both declarations should be persistent")
	}
	return ""
}
