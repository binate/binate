package "pkg/binate/repl"

import "pkg/builtins/testing"

// Tests for the pure package-local helpers in util.bn (streq, quotePath,
// appendCharSlice).  The loader/checker-plumbing helpers (addLoaderPaths,
// ensureBootstrapLoaded) need a populated loader and are exercised
// end-to-end by e2e/repl.sh.
// seq / fail live in testsupport_test.bn.

// ============================================================
// streq tests
// ============================================================

func TestStreqEqual() testing.TestResult {
	if !streq("hello", "hello") { return fail("same strings") }
	return ""
}

func TestStreqDifferent() testing.TestResult {
	if streq("hello", "world") { return fail("different strings") }
	return ""
}

func TestStreqDifferentLength() testing.TestResult {
	if streq("abc", "ab") { return fail("different lengths") }
	return ""
}

func TestStreqEmpty() testing.TestResult {
	if !streq("", "") { return fail("empty strings") }
	return ""
}

// ============================================================
// quotePath tests
// ============================================================

func TestQuotePathSimple() testing.TestResult {
	if !seq(quotePath("pkg/foo"), "\"pkg/foo\"") {
		return fail("expected \"pkg/foo\"")
	}
	return ""
}

func TestQuotePathEmpty() testing.TestResult {
	if !seq(quotePath(""), "\"\"") {
		return fail("empty path should quote to \"\"")
	}
	return ""
}

// ============================================================
// appendCharSlice tests
// ============================================================

func TestAppendCharSliceEmpty() testing.TestResult {
	var s @[]@[]char
	var r @[]@[]char = appendCharSlice(s, "a")
	if len(r) != 1 { return fail("len after append on empty == 1") }
	if !seq(r[0], "a") { return fail("first entry == a") }
	return ""
}

func TestAppendCharSliceGrows() testing.TestResult {
	var s @[]@[]char
	s = appendCharSlice(s, "a")
	s = appendCharSlice(s, "b")
	if len(s) != 2 { return fail("len after two appends == 2") }
	if !seq(s[0], "a") { return fail("entry 0 preserved") }
	if !seq(s[1], "b") { return fail("entry 1 == new") }
	return ""
}
