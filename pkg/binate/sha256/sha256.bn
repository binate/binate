package "pkg/binate/sha256"

// SHA-256 (FIPS 180-4).  Word values are kept in an int64 (a guaranteed 64-bit
// word — `int` is only 32 bits on ILP32) masked to 32 bits after every add/rotate
// (mask32), so wraparound is explicit and target-independent rather than relying
// on uint32 overflow semantics.  Indices / byte-lengths stay `int`.  Sum256 is
// one-shot: the code-signer (and most callers) hash whole buffers, so there is no
// streaming state.

// mask32 keeps a value in the low 32 bits (unsigned 32-bit wraparound).
const mask32 int64 = 0xffffffff

// The eight initial hash values H0..H7 (FIPS 180-4 §5.3.3): the first 32 bits of the
// fractional parts of the square roots of the first eight primes.
const (
	h0 int64 = 0x6a09e667
	h1 int64 = 0xbb67ae85
	h2 int64 = 0x3c6ef372
	h3 int64 = 0xa54ff53a
	h4 int64 = 0x510e527f
	h5 int64 = 0x9b05688c
	h6 int64 = 0x1f83d9ab
	h7 int64 = 0x5be0cd19
)

// ror rotates the low 32 bits of x right by n (0 < n < 32).  x must already be
// masked to 32 bits, so `x >> n` is a logical shift (x is non-negative).
func ror(x int64, n int) int64 { return ((x >> n) | (x << (32 - n))) & mask32 }

// be32 reads a big-endian 32-bit word from b at off (off + 4 <= len(b)).
func be32(b *[]readonly uint8, off int) int64 {
	return ((cast(int64, b[off]) << 24) | (cast(int64, b[off + 1]) << 16) |
			(cast(int64, b[off + 2]) << 8) | cast(int64, b[off + 3])) & mask32
}

// roundConstants returns the 64 SHA-256 round constants K (FIPS 180-4 §4.2.2): the
// first 32 bits of the fractional parts of the cube roots of the first 64 primes.
func roundConstants() @[]int64 {
	var k @[]int64 = make_slice(int64, 64)
	k[0] = 0x428a2f98
	k[1] = 0x71374491
	k[2] = 0xb5c0fbcf
	k[3] = 0xe9b5dba5
	k[4] = 0x3956c25b
	k[5] = 0x59f111f1
	k[6] = 0x923f82a4
	k[7] = 0xab1c5ed5
	k[8] = 0xd807aa98
	k[9] = 0x12835b01
	k[10] = 0x243185be
	k[11] = 0x550c7dc3
	k[12] = 0x72be5d74
	k[13] = 0x80deb1fe
	k[14] = 0x9bdc06a7
	k[15] = 0xc19bf174
	k[16] = 0xe49b69c1
	k[17] = 0xefbe4786
	k[18] = 0x0fc19dc6
	k[19] = 0x240ca1cc
	k[20] = 0x2de92c6f
	k[21] = 0x4a7484aa
	k[22] = 0x5cb0a9dc
	k[23] = 0x76f988da
	k[24] = 0x983e5152
	k[25] = 0xa831c66d
	k[26] = 0xb00327c8
	k[27] = 0xbf597fc7
	k[28] = 0xc6e00bf3
	k[29] = 0xd5a79147
	k[30] = 0x06ca6351
	k[31] = 0x14292967
	k[32] = 0x27b70a85
	k[33] = 0x2e1b2138
	k[34] = 0x4d2c6dfc
	k[35] = 0x53380d13
	k[36] = 0x650a7354
	k[37] = 0x766a0abb
	k[38] = 0x81c2c92e
	k[39] = 0x92722c85
	k[40] = 0xa2bfe8a1
	k[41] = 0xa81a664b
	k[42] = 0xc24b8b70
	k[43] = 0xc76c51a3
	k[44] = 0xd192e819
	k[45] = 0xd6990624
	k[46] = 0xf40e3585
	k[47] = 0x106aa070
	k[48] = 0x19a4c116
	k[49] = 0x1e376c08
	k[50] = 0x2748774c
	k[51] = 0x34b0bcb5
	k[52] = 0x391c0cb3
	k[53] = 0x4ed8aa4a
	k[54] = 0x5b9cca4f
	k[55] = 0x682e6ff3
	k[56] = 0x748f82ee
	k[57] = 0x78a5636f
	k[58] = 0x84c87814
	k[59] = 0x8cc70208
	k[60] = 0x90befffa
	k[61] = 0xa4506ceb
	k[62] = 0xbef9a3f7
	k[63] = 0xc67178f2
	return k
}

// pad builds the padded message: the data, a 0x80 byte, zero padding, and the
// 64-bit big-endian bit length, to a multiple of 64 bytes (FIPS 180-4 §5.1.1).
func pad(data *[]readonly uint8) @[]uint8 {
	var ml int = len(data)
	// After the 0x80 byte, pad with zeros so the length ends 8 bytes shy of a block.
	var rem int = (ml + 1) % 64
	var padZeros int = 56 - rem
	if rem > 56 { padZeros = 56 + 64 - rem }
	var total int = ml + 1 + padZeros + 8
	var msg @[]uint8 = make_slice(uint8, total)
	for i := 0; i < ml; i++ { msg[i] = data[i] }
	msg[ml] = cast(uint8, 0x80)
	// The trailing 8 bytes are the message length in BITS, big-endian.
	var bitLen int64 = cast(int64, ml) * 8
	for i := 0; i < 8; i++ { msg[total - 1 - i] = cast(uint8, (bitLen >> (8 * i)) & 0xff) }
	return msg
}

// Sum256 returns the 32-byte SHA-256 digest of data.
func Sum256(data *[]readonly uint8) @[]uint8 {
	var h @[]int64 = make_slice(int64, 8)
	h[0] = h0
	h[1] = h1
	h[2] = h2
	h[3] = h3
	h[4] = h4
	h[5] = h5
	h[6] = h6
	h[7] = h7
	var k @[]int64 = roundConstants()

	var msg @[]uint8 = pad(data)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow for be32
	var rmsg *[]readonly uint8 = msg
	var w @[]int64 = make_slice(int64, 64)
	var numBlocks int = len(msg) / 64
	for blk := 0; blk < numBlocks; blk++ {
		var base int = blk * 64
		for t := 0; t < 16; t++ { w[t] = be32(rmsg, base + 4 * t) }
		for t := 16; t < 64; t++ {
			var s0 int64 = ror(w[t - 15], 7) ^ ror(w[t - 15], 18) ^ (w[t - 15] >> 3)
			var s1 int64 = ror(w[t - 2], 17) ^ ror(w[t - 2], 19) ^ (w[t - 2] >> 10)
			w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & mask32
		}
		var a int64 = h[0]
		var b int64 = h[1]
		var c int64 = h[2]
		var d int64 = h[3]
		var e int64 = h[4]
		var f int64 = h[5]
		var g int64 = h[6]
		var hv int64 = h[7]
		for t := 0; t < 64; t++ {
			var s1 int64 = ror(e, 6) ^ ror(e, 11) ^ ror(e, 25)
			var ch int64 = (e & f) ^ ((e ^ mask32) & g) // e^mask32 is ~e within 32 bits
			var t1 int64 = (hv + s1 + ch + k[t] + w[t]) & mask32
			var s0 int64 = ror(a, 2) ^ ror(a, 13) ^ ror(a, 22)
			var maj int64 = (a & b) ^ (a & c) ^ (b & c)
			var t2 int64 = (s0 + maj) & mask32
			hv = g
			g = f
			f = e
			e = (d + t1) & mask32
			d = c
			c = b
			b = a
			a = (t1 + t2) & mask32
		}
		h[0] = (h[0] + a) & mask32
		h[1] = (h[1] + b) & mask32
		h[2] = (h[2] + c) & mask32
		h[3] = (h[3] + d) & mask32
		h[4] = (h[4] + e) & mask32
		h[5] = (h[5] + f) & mask32
		h[6] = (h[6] + g) & mask32
		h[7] = (h[7] + hv) & mask32
	}

	var out @[]uint8 = make_slice(uint8, 32)
	for i := 0; i < 8; i++ {
		out[4 * i + 0] = cast(uint8, (h[i] >> 24) & 0xff)
		out[4 * i + 1] = cast(uint8, (h[i] >> 16) & 0xff)
		out[4 * i + 2] = cast(uint8, (h[i] >> 8) & 0xff)
		out[4 * i + 3] = cast(uint8, h[i] & 0xff)
	}
	return out
}
