package "pkg/binate/sha256"

import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult { return msg }

// toHex renders bytes as a lowercase hex string for comparison against the known
// FIPS 180-4 digests.
func toHex(b @[]uint8) @[]char {
	var digits *[]readonly char = "0123456789abcdef"
	var out @[]char = make_slice(char, len(b) * 2)
	for i := 0; i < len(b); i++ {
		out[2 * i + 0] = digits[(cast(int, b[i]) >> 4) & 0xf]
		out[2 * i + 1] = digits[cast(int, b[i]) & 0xf]
	}
	return out
}

// strBytes copies a string's chars into a fresh uint8 buffer (the message input to
// Sum256), independent of any char/uint8 aliasing.
func strBytes(s *[]readonly char) @[]uint8 {
	var out @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ { out[i] = cast(uint8, s[i]) }
	return out
}

// digestEq returns "" if SHA-256(msg) matches the expected hex digest, else a message.
func digestEq(msg *[]readonly char, want *[]readonly char) @[]char {
	// Hold the buffer in a managed local so the raw borrow passed to Sum256 stays
	// live for the whole call (borrowing strBytes(msg) directly would dangle).
	var mb @[]uint8 = strBytes(msg)
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var raw *[]readonly uint8 = mb
	var got @[]char = toHex(Sum256(raw))
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var gotr *[]readonly char = got
	if !charsEq(gotr, want) { return fail(got) }
	return ""
}

// charsEq compares two raw char slices for equal contents.
func charsEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// The empty message — the canonical zero-length digest.
func TestSha256Empty() testing.TestResult {
	return digestEq("", "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
}

// "abc" — the FIPS 180-4 one-block example.
func TestSha256Abc() testing.TestResult {
	return digestEq("abc", "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
}

// The 56-byte FIPS 180-4 two-block example (exercises the multi-block path and the
// length-crosses-a-block padding case).
func TestSha256TwoBlock() testing.TestResult {
	return digestEq("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
			"248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
}

// A 64-byte message (exactly one block before padding, so padding adds a whole second
// block) — guards the rem==0 / rem>56 padding boundary.
func TestSha256OneFullBlock() testing.TestResult {
	return digestEq("0123456789012345678901234567890123456789012345678901234567890123",
			"9674d9e078535b7cec43284387a6ee39956188e735a85452b0050b55341cda56")
}

// All 256 byte values 0x00..0xff — binary data with high-bit bytes, spanning several
// blocks (this is the case that matters: the code-signer hashes binary code pages).
func TestSha256AllBytes() testing.TestResult {
	var msg @[]uint8 = make_slice(uint8, 256)
	for i := 0; i < 256; i++ { msg[i] = cast(uint8, i) }
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var raw *[]readonly uint8 = msg
	var got @[]char = toHex(Sum256(raw))
	// bnlint:allow managed-to-raw-assign - live local, read-only borrow
	var gotr *[]readonly char = got
	if !charsEq(gotr, "40aff2e9d2d8922e47afd4648e6967497158785fbd1da870e7110266bf944880") {
		return fail(got)
	}
	return ""
}
