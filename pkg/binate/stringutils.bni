// Package stringutils provides formatting helpers for pkg/std/strings'
// Builder that the Builder deliberately omits: integer and hex formatting,
// and a copying Freeze.  They are free functions taking a *strings.Builder
// (rather than Builder methods) so the stdlib type stays minimal — these
// are the pieces pkg/binate code needs to migrate off pkg/binate/buf.CharBuf
// onto Builder.
package "pkg/binate/stringutils"

import "pkg/std/strings"

// WriteInt appends the base-10 representation of n to b, with a leading
// '-' when n is negative.
func WriteInt(b *strings.Builder, n int)

// WriteInt64 appends the base-10 representation of a fixed-width int64 n.
// Distinct from WriteInt so it renders the full 64-bit range on a 32-bit
// host, where `int` is only 32 bits.
func WriteInt64(b *strings.Builder, n int64)

// WriteHexByte appends v's low 8 bits as two uppercase hex digits (e.g.
// 0xFF → "FF").
func WriteHexByte(b *strings.Builder, v int)

// Freeze copies b's accumulated bytes into a fresh, exactly-sized managed
// slice independent of b's backing — safe to retain after b grows, is
// reset, or is discarded.  Contrast b.String(), which shares the backing.
func Freeze(b *strings.Builder) @[]char
