package "pkg/binate/stringutils"

import "pkg/std/strconv"
import "pkg/std/strings"

// WriteInt appends the base-10 representation of n to b.
func WriteInt(b *strings.Builder, n int) {
	// Format into a stack buffer, then hand the whole run to Builder.Write
	// in one call (a single grow) rather than a digit at a time.  20 chars
	// is the widest a base-10 int64 is (INT64_MIN = "-9223372036854775808"),
	// so AppendInt always fits and returns a non-negative end index.
	var tmp [20]char
	var end int = strconv.AppendInt(tmp[0:20], 0, cast(int64, n), 10)
	b.Write(tmp[0:end])
}

// WriteInt64 appends the base-10 representation of a fixed-width int64 n.
// Distinct from WriteInt so it renders the full 64-bit range on a 32-bit
// host, where `int` is only 32 bits.
func WriteInt64(b *strings.Builder, n int64) {
	// Same stack-buffer + single-Write shape as WriteInt; 20 chars is the
	// widest a base-10 int64 can be, so AppendInt always fits.
	var tmp [20]char
	var end int = strconv.AppendInt(tmp[0:20], 0, n, 10)
	b.Write(tmp[0:end])
}

// WriteHexByte appends v's low 8 bits as two uppercase hex digits.  strconv
// emits lowercase hex, so the digits are computed by hand; formatting both
// into a stack buffer keeps the single-Write shape of WriteInt/WriteInt64.
func WriteHexByte(b *strings.Builder, v int) {
	var tmp [2]char
	tmp[0] = hexDigit(v >> 4 & 0xF)
	tmp[1] = hexDigit(v & 0xF)
	b.Write(tmp[0:2])
}

// hexDigit returns the uppercase hex digit ('0'..'9', 'A'..'F') for d in
// 0..15.
func hexDigit(d int) char {
	if d < 10 {
		return cast(char, cast(int, '0') + d)
	}
	return cast(char, cast(int, 'A') + d - 10)
}
