package "pkg/binate/stringutils"

import "pkg/builtins/testing"
import "pkg/std/strings"

func fail(msg @[]char) testing.TestResult { return msg }

func charsEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// WriteInt renders signed decimals into a Builder.
func TestWriteInt() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	WriteInt(b, 0)
	if !charsEq(b.String(), "0") { return fail("expected 0") }

	b = strings.NewBuilder()
	WriteInt(b, 42)
	if !charsEq(b.String(), "42") { return fail("expected 42") }

	b = strings.NewBuilder()
	WriteInt(b, -7)
	if !charsEq(b.String(), "-7") { return fail("expected -7") }

	b = strings.NewBuilder()
	WriteInt(b, 12345)
	if !charsEq(b.String(), "12345") { return fail("expected 12345") }

	// A large negative exercises the cast-to-int64 + sign path (the
	// reason WriteInt is distinct from WriteInt64) at full digit width.
	b = strings.NewBuilder()
	WriteInt(b, -1234567890)
	if !charsEq(b.String(), "-1234567890") { return fail("expected -1234567890") }
	return ""
}

// Successive WriteInt calls accumulate into the same Builder.
func TestWriteIntAccumulates() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	WriteInt(b, 1)
	WriteInt(b, 2)
	WriteInt(b, 3)
	if !charsEq(b.String(), "123") { return fail("expected 123") }
	return ""
}

// WriteInt64 spans the full 64-bit range even on a 32-bit host.
func TestWriteInt64() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	// int64-min: `0 - n` would overflow back to n; strconv's uint64-
	// magnitude path handles it.  Built from MAX-1 so the literal is
	// representable on a 32-bit host, where `int` is only 32 bits.
	WriteInt64(b, cast(int64, -9223372036854775807) - cast(int64, 1))
	if !charsEq(b.String(), "-9223372036854775808") {
		return fail("expected int64-min round-trip")
	}

	b = strings.NewBuilder()
	WriteInt64(b, cast(int64, 9223372036854775807))
	if !charsEq(b.String(), "9223372036854775807") {
		return fail("expected int64-max round-trip")
	}
	return ""
}

// WriteHexByte renders two uppercase hex digits.
func TestWriteHexByte() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	WriteHexByte(b, 0)
	if !charsEq(b.String(), "00") { return fail("expected 00") }

	b = strings.NewBuilder()
	WriteHexByte(b, 255)
	if !charsEq(b.String(), "FF") { return fail("expected FF") }

	b = strings.NewBuilder()
	WriteHexByte(b, 171)
	if !charsEq(b.String(), "AB") { return fail("expected AB") }

	// Only the low 8 bits are used: 256 (= 0x100) masks to 0x00.
	b = strings.NewBuilder()
	WriteHexByte(b, 256)
	if !charsEq(b.String(), "00") { return fail("expected 00 (256 & 0xFF)") }

	// A negative value uses its two's-complement low byte: -1's low 8
	// bits are 0xFF, so it prints "FF" — not a non-hex character.
	b = strings.NewBuilder()
	WriteHexByte(b, -1)
	if !charsEq(b.String(), "FF") { return fail("expected FF (-1 & 0xFF)") }
	return ""
}

// Freeze returns the accumulated bytes as an exactly-sized copy.
func TestFreeze() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("frozen")
	var s @[]char = Freeze(b)
	if len(s) != 6 { return fail("expected len 6") }
	if !charsEq(s, "frozen") { return fail("expected frozen") }
	return ""
}

// A frozen copy is independent of b's backing: appending to b after
// Freeze (enough to force a reallocation) does not change the frozen bytes.
func TestFreezeIndependent() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("keep")
	var s @[]char = Freeze(b)
	b.Write("-more-data-forcing-a-backing-reallocation")
	if !charsEq(s, "keep") { return fail("frozen copy should be unchanged") }
	return ""
}

// Freeze of an empty Builder yields an empty slice.
func TestFreezeEmpty() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	var s @[]char = Freeze(b)
	if len(s) != 0 { return fail("expected empty") }
	return ""
}

// The helpers interleave with Builder.Write to build a formatted run —
// the kind of mixed text/number formatting buf.CharBuf chains were used for.
func TestMixedFormatting() testing.TestResult {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("hex=")
	WriteHexByte(b, 255)
	b.Write(" int=")
	WriteInt(b, -42)
	if !charsEq(b.String(), "hex=FF int=-42") {
		return fail("expected 'hex=FF int=-42'")
	}
	return ""
}
