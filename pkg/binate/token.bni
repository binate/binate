// Package token defines the token types, source positions, and helper functions
// used by the lexer and parser. Token types are integer constants using iota.
package "pkg/binate/token"

// Token types
type Type int

const (
	ILLEGAL Type = iota
	EOF
	SEMICOLON

	IDENT
	INT
	FLOAT
	STRING
	CHAR

	keyword_start
	BREAK
	CASE
	CONST
	CONTINUE
	DEFAULT
	DEFER
	ELSE
	FALSE
	FOR
	FUNC
	IF
	IMPL
	IMPORT
	IN
	INTERFACE
	NIL
	PACKAGE
	READONLY
	RETURN
	SELF
	STRUCT
	SWITCH
	TRUE
	TYPE
	VAR
	keyword_end

	builtin_start
	MAKE
	MAKE_SLICE
	BOX
	CAST
	BIT_CAST
	UNSAFE_CAST   // `unsafe_cast(T, e)` — the possibly-unsafe superset of `cast`
	// (spec §8.7): everything `cast` does, plus the unverifiable
	// conversions `cast` rejects (drop element-level readonly,
	// raw pointer -> managed pointer, unchecked interface
	// narrowing, invariant-breaking scalar directions).
	LEN
	UNSAFE_INDEX
	UNSAFE_DIV   // `unsafe_div(a, b)` — integer divide WITHOUT the
	// divide-by-zero / MIN-overflow guard (the divisor
	// analogue of unsafe_index). Truncated like `/`.
	UNSAFE_REM // `unsafe_rem(a, b)` — integer remainder without the
	// guard. Truncated remainder like `%` (sign follows
	// the dividend) — NOT a Euclidean `mod`.
	UNSAFE_SHL // `unsafe_shl(v, n)` — integer left shift WITHOUT the
	// overshift guard or the negative-count check (the shift
	// analogue of unsafe_div). The caller asserts the count is
	// in [0, width); otherwise the result is target-defined.
	UNSAFE_SHR // `unsafe_shr(v, n)` — integer right shift (arithmetic for
	// a signed value, logical for unsigned) without the
	// overshift guard or the negative-count check.
	SIZEOF
	ALIGNOF
	PRESENT // `present(iv)` — true iff the interface value `iv`
	// holds a concrete impl (vtable slot filled).  The
	// honest "is this interface set?" test; interface
	// values are not nillable (see claude-notes.md:1141).
	SAME // `same(a, b)` — true iff `a` and `b` are the same
	// reference: same address (pointers), same boxed
	// object (interface values — both {data, vtable}
	// words), or same view (slices — {data, len}).  Both
	// operands must have the same static type.
	RAW_FUNC_ADDR // spelled "_func_handle" (canonical) — returns a
	// *uint8 pointing at the static 16-byte
	// {vtable_ptr, data_ptr} handle bnc emits per
	// function.  Underscore-prefixed because it's not
	// a permanent language feature; the goal is to
	// collapse it into ordinary function-value syntax
	// once function values cover this surface.  The
	// legacy spelling "_raw_func_addr" is accepted as
	// a transitional alias via pkg/binate/token.Lookup until
	// the prebuilt BUILDER catches up; see the comment
	// there.  The token enum value is intentionally
	// not renamed — once the alias drops, both the
	// enum and any remaining "raw" references can
	// rename together in one pass.
	C_CALL // `__c_call("sym", RetType, args...)` — calls the C
	// symbol `sym` verbatim (no name mangling).
	C_GLOBAL // `__c_global("sym", T)` — the address of the C global
	// variable `sym` (verbatim, no mangling) as a raw *T.
	// Compiled-mode only.
	C_ENTRY // `__c_entry(f)` — the address of a C entry of the declared
	// function `f`, as a raw *uint8, for handing f to C as a
	// callback (spec §16.9 pkg.centry).  Compiled-mode only.
	builtin_end

	PLUS
	MINUS
	STAR
	SLASH
	PERCENT
	AMP
	PIPE
	CARET
	TILDE
	SHL
	SHR
	EQ
	NEQ
	LT
	GT
	LEQ
	GEQ
	LAND
	LOR
	NOT
	ASSIGN
	DEFINE
	ADD_ASSIGN
	SUB_ASSIGN
	MUL_ASSIGN
	QUO_ASSIGN
	REM_ASSIGN
	AND_ASSIGN
	OR_ASSIGN
	XOR_ASSIGN
	SHL_ASSIGN
	SHR_ASSIGN
	INC
	DEC

	DOT
	COMMA
	COLON
	AT
	HASH
	LPAREN
	RPAREN
	LBRACKET
	RBRACKET
	LBRACE
	RBRACE
	ELLIPSIS

	NUM_TOKENS
)

// Source position
type Pos struct {
	File @[]char
	Line int
	Col  int
}

// A single lexical token.  Pos is the position of the token's first byte;
// End is the position one past its last byte (exclusive), so [Pos, End) spans
// the token's source text.  The lexer stamps End; the parser propagates it onto
// AST nodes so a node knows where it ends (used for comment attachment and
// range diagnostics).  End equals Pos for synthetic zero-width tokens (the
// ASI-inserted semicolon).
type Token struct {
	Typ Type
	Lit @[]char
	Pos Pos
	End Pos
}

// Comment is a source comment retained by the lexer in comment-collecting mode
// (lexer.NewCollecting); the ordinary lexer (lexer.New) discards comments and
// collects nothing, so the compiler path is unaffected.  Pos/End span the
// comment's source text ([Pos, End), End exclusive); Text is the exact source
// including the `//` or `/* */` delimiters, EXCEPT a line comment's text
// excludes a CRLF's trailing `\r` (the line terminator, not comment content);
// a block comment's interior bytes -- including any `\r` -- are byte-exact.
// OwnLine is true when no real token precedes the comment on its line (a
// leading / standalone comment -- whitespace and earlier comments do not
// count) and false when a token precedes it (a trailing comment) -- the
// leading-vs-trailing signal a formatter uses to attach the comment.
type Comment struct {
	Pos     Pos
	End     Pos
	Text    @[]char
	OwnLine bool
}

// IsKeyword reports whether t is a keyword token (if, for, func, etc.).
func IsKeyword(t Type) bool

// IsBuiltin reports whether t is a builtin name (make, len, cast, etc.).
func IsBuiltin(t Type) bool

// TriggersASI reports whether t triggers automatic semicolon insertion.
func TriggersASI(t Type) bool

// Keyword lookup: returns token type for keywords, IDENT otherwise
func Lookup(name *[]readonly char) Type

// Token type name (for error messages, debugging)
func TypeName(t Type) *[]readonly char

// Position formatting
func PosString(p Pos) @[]char
