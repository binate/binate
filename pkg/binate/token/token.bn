package "pkg/binate/token"

import "pkg/binate/buf"
import "pkg/std/mapfn"
import "pkg/std/strconv"

// Token type constants are defined in token.bni via iota.

// TypeName returns the display string for a token type.
func TypeName(t Type) *[]readonly char {
	switch t {
	// Special tokens
	case ILLEGAL:   return "ILLEGAL"
	case EOF:       return "EOF"
	case SEMICOLON: return ";"
	// Literals
	case IDENT:  return "IDENT"
	case INT:    return "INT"
	case FLOAT:  return "FLOAT"
	case STRING: return "STRING"
	case CHAR:   return "CHAR"
	// Keywords
	case BREAK:     return "break"
	case CASE:      return "case"
	case CONST:     return "const"
	case CONTINUE:  return "continue"
	case DEFAULT:   return "default"
	case ELSE:      return "else"
	case FALSE:     return "false"
	case FOR:       return "for"
	case FUNC:      return "func"
	case IF:        return "if"
	case IMPL:      return "impl"
	case IMPORT:    return "import"
	case IN:        return "in"
	case INTERFACE: return "interface"
	case NIL:       return "nil"
	case PACKAGE:   return "package"
	case READONLY:  return "readonly"
	case RETURN:    return "return"
	case SELF:      return "Self"
	case STRUCT:    return "struct"
	case SWITCH:    return "switch"
	case TRUE:      return "true"
	case TYPE:      return "type"
	case VAR:       return "var"
	// Builtins
	case MAKE:          return "make"
	case MAKE_SLICE:    return "make_slice"
	case BOX:           return "box"
	case CAST:          return "cast"
	case BIT_CAST:      return "bit_cast"
	case UNSAFE_CAST:   return "unsafe_cast"
	case LEN:           return "len"
	case UNSAFE_INDEX:  return "unsafe_index"
	case UNSAFE_DIV:    return "unsafe_div"
	case UNSAFE_REM:    return "unsafe_rem"
	case UNSAFE_SHL:    return "unsafe_shl"
	case UNSAFE_SHR:    return "unsafe_shr"
	case SIZEOF:        return "sizeof"
	case ALIGNOF:       return "alignof"
	case PRESENT:       return "present"
	case SAME:          return "same"
	case RAW_FUNC_ADDR: return "_func_handle"
	case C_CALL:        return "__c_call"
	case C_GLOBAL:      return "__c_global"
	case C_ENTRY:       return "__c_entry"
	// Operators
	case PLUS:       return "+"
	case MINUS:      return "-"
	case STAR:       return "*"
	case SLASH:      return "/"
	case PERCENT:    return "%"
	case AMP:        return "&"
	case PIPE:       return "|"
	case CARET:      return "^"
	case TILDE:      return "~"
	case SHL:        return "<<"
	case SHR:        return ">>"
	case EQ:         return "=="
	case NEQ:        return "!="
	case LT:         return "<"
	case GT:         return ">"
	case LEQ:        return "<="
	case GEQ:        return ">="
	case LAND:       return "&&"
	case LOR:        return "||"
	case NOT:        return "!"
	case ASSIGN:     return "="
	case DEFINE:     return ":="
	case ADD_ASSIGN: return "+="
	case SUB_ASSIGN: return "-="
	case MUL_ASSIGN: return "*="
	case QUO_ASSIGN: return "/="
	case REM_ASSIGN: return "%="
	case AND_ASSIGN: return "&="
	case OR_ASSIGN:  return "|="
	case XOR_ASSIGN: return "^="
	case SHL_ASSIGN: return "<<="
	case SHR_ASSIGN: return ">>="
	case INC:        return "++"
	case DEC:        return "--"
	// Punctuation
	case DOT:      return "."
	case COMMA:    return ","
	case COLON:    return ":"
	case AT:       return "@"
	case HASH:     return "#"
	case LPAREN:   return "("
	case RPAREN:   return ")"
	case LBRACKET: return "["
	case RBRACKET: return "]"
	case LBRACE:   return "{"
	case RBRACE:   return "}"
	case ELLIPSIS: return "..."
	default:       return "unknown"
	}
}

// IsKeyword reports whether t is a keyword token.
func IsKeyword(t Type) bool {
	return cast(int, t) > cast(int, keyword_start) && cast(int, t) < cast(int, keyword_end)
}

// IsBuiltin reports whether t is a builtin keyword token.
func IsBuiltin(t Type) bool {
	return cast(int, t) > cast(int, builtin_start) && cast(int, t) < cast(int, builtin_end)
}

// TriggersASI reports whether this token type triggers automatic
// semicolon insertion when it is the last token on a line.
func TriggersASI(t Type) bool {
	switch t {
	case IDENT, INT, FLOAT, STRING, CHAR, TRUE, FALSE, NIL, BREAK, CONTINUE, RETURN, INC, DEC, RPAREN,
			RBRACKET, RBRACE:
		return true
	}
	return false
}

// streq compares two char slices for equality.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// kwHash is the djb2 hash of a keyword/builtin spelling — MapFn's injected key
// hasher, paired with streq as its injected equality.
func kwHash(s *[]readonly char) uint {
	var h uint = 5381
	for i := 0; i < len(s); i++ {
		h = h * 33 + cast(uint, s[i])
	}
	return h
}

// keywordMap maps every keyword/builtin spelling to its Type so Lookup is O(1)
// instead of a linear scan over ~all keyword/builtin spellings (a streq each) on
// EVERY identifier the lexer reads — a top lexer hotspot in the load profile.  It
// is keyed by *[]readonly char whose keys are TypeName's immortal rodata literals,
// so a lookup neither allocates nor dangles.  Built once on first Lookup (the
// keyword set is fixed for the process).
var keywordMap @mapfn.MapFn[*[]readonly char, Type]

// buildKeywordMap populates a fresh MapFn with every keyword/builtin spelling →
// its Type, walking the same two Type ranges Lookup's old linear scan did.
func buildKeywordMap() @mapfn.MapFn[*[]readonly char, Type] {
	var m @mapfn.MapFn[*[]readonly char, Type] = mapfn.NewMapFn[*[]readonly char, Type](kwHash, streq)
	var t Type = keyword_start + 1
	for cast(int, t) < cast(int, keyword_end) {
		m.Put(TypeName(t), t)
		t = cast(Type, cast(int, t) + 1)
	}
	t = builtin_start + 1
	for cast(int, t) < cast(int, builtin_end) {
		m.Put(TypeName(t), t)
		t = cast(Type, cast(int, t) + 1)
	}
	return m
}

// Lookup maps an identifier string to its keyword/builtin token type, or IDENT if
// it is not one.
func Lookup(name *[]readonly char) Type {
	if keywordMap == nil {
		keywordMap = buildKeywordMap()
	}
	var t Type
	var ok bool
	t, ok = keywordMap.Get(name)
	if ok {
		return t
	}
	// Transitional alias: `_raw_func_addr` was renamed to
	// `_func_handle` (the value it returns is a function-value handle
	// pointer, not a raw fn pointer).  The old spelling
	// remains accepted so the prebuilt BUILDER (which lexes user
	// source as part of its own compile pipeline) can continue to
	// compile pkg/builtins/rt / cmd/bni / cmd/bnc callers that still use
	// `_raw_func_addr` until BUILDER bumps to a version that
	// natively recognizes `_func_handle`, after which the callers
	// can switch and this alias can drop.
	if streq(name, "_raw_func_addr") { return RAW_FUNC_ADDR }
	return IDENT
}

// PosString formats a Pos as "file:line:col" or "line:col".
func PosString(p Pos) @[]char {
	var s @[]char = strconv.Itoa(p.Line)
	s = buf.Concat(s, ":")
	s = buf.Concat(s, strconv.Itoa(p.Col))
	if len(p.File) > 0 {
		s = buf.Concat(buf.Concat(p.File, ":"), s)
	}
	return s
}
