// Package types implements type representation, construction, comparison,
// layout computation, scope/symbol management, and type checking for Binate.
package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"

// ============================================================
// Type Representations
// ============================================================

// TypeKind identifies what kind of type a Type represents.
const (
	TYP_INT int = iota
	TYP_FLOAT
	TYP_BOOL
	TYP_VOID
	TYP_NIL
	TYP_UNTYPED_INT
	TYP_UNTYPED_FLOAT
	TYP_UNTYPED_BOOL
	TYP_POINTER
	TYP_MANAGED_PTR
	TYP_SLICE
	TYP_MANAGED_SLICE
	TYP_ARRAY
	TYP_STRUCT
	TYP_FUNC
	TYP_FUNC_VALUE          // *func(args) ret — raw function value
	                        // (2-word {vtable, data}, 16 bytes)
	TYP_MANAGED_FUNC_VALUE  // @func(args) ret — managed function value
	                        // (2-word {vtable, data}, 16 bytes; data
	                        // pointer is refcounted)
	TYP_NAMED
	TYP_ALIAS
	TYP_READONLY
	TYP_INTERFACE  // declared interface — stores the method set on
	               // the type's Methods table. Bare interface name
	               // is NOT a usable value-type expression (see
	               // plan-interface-syntax-revision.md); usable
	               // forms are *Iface and @Iface, lowered to the
	               // TYP_INTERFACE_VALUE / TYP_INTERFACE_VALUE_MANAGED
	               // kinds below. TYP_INTERFACE itself is stored on
	               // the SYM_INTERFACE entry for the declared name
	               // and is referenced from interface-value types
	               // via t.Elem.
	TYP_INTERFACE_VALUE          // *Iface — raw interface value
	                             // (2-word {data, vtable}, 16 bytes)
	TYP_INTERFACE_VALUE_MANAGED  // @Iface — managed interface value
	                             // (2-word {data, vtable}, 16 bytes;
	                             // data ptr is refcounted)
	TYP_SELF                     // `Self` placeholder — appears in
	                             // interface method signatures only.
	                             // Substituted at impl-collection time
	                             // (substituteSelf) and at generic
	                             // instantiation time.  Singleton:
	                             // identity via pointer equality on
	                             // TypSelf().
	TYP_TYPE_PARAM               // Generic type parameter `T` — appears
	                             // in a generic decl's body scope until
	                             // instantiation substitutes a concrete
	                             // @Type for it.  Identity is via
	                             // (Owner generic decl, Index in the
	                             // type-param list); see Type.TypeParam
	                             // fields below.  Per plan-generics.md
	                             // Slice 2 / Q3.
	NUM_TYPE_KINDS
)

// Type represents a resolved type.
type Type struct {
	Kind    int
	Name    @[]char
	Width   int
	Signed  bool

	// Pkg: short package name where this type is declared. Set for
	// TYP_INTERFACE so cross-package iface refs preserve their
	// canonical (Pkg, Name) identity through IR-gen and codegen.
	// Empty for primitive types and for types where Pkg is implied
	// by enclosing identity (e.g., TYP_STRUCT carries its qualified
	// name in Name itself; TYP_NAMED's package comes from its
	// declaration scope). Slice 2.7 of plan-cross-package-
	// interfaces.md.
	Pkg @[]char

	// For pointer, managed ptr, slice, managed slice, array
	Elem @Type

	// For array
	ArrayLen int

	// For struct
	Fields @[]@Field

	// For func
	Params  @[]@Param
	Results @[]@Type
	// Generic type parameters for a TYP_FUNC.  Nil / empty for
	// non-generic functions.  Each entry is a TYP_TYPE_PARAM
	// instance shared between this func type's signature and its
	// body's type-param scope; identity-comparable per Q3.  Per
	// plan-generics.md Slice 2.
	TypeParams @[]@Type

	// For named (distinct type)
	Underlying @Type
	// IsPending: this type's resolution is parked on c.Pending
	// awaiting a forward-referenced dependency.  Only meaningful
	// for TYP_NAMED, TYP_ALIAS, and TYP_STRUCT today — once a
	// pending-type substrate lands (plan-repl-tier3-pending-
	// types.md Stage 2), use sites that need T's layout (struct
	// field, var, sized sig) capture T's name as a pending
	// dependency via capturePendingDep when this flag is set.
	// Reference uses (`@T`, `*T`, `@[]T`) are size-stable and
	// don't propagate.  Cleared by collectTypeDecl (or RetryPending-
	// Decls's type retry) once Underlying / Fields are populated
	// from the now-bound dependency.
	IsPending bool
	// Methods registered on this named type (declaration order). Only
	// meaningful when Kind == TYP_NAMED or Kind == TYP_INTERFACE.
	// For TYP_INTERFACE this is the interface's OWN methods only —
	// inherited methods from Parents are not duplicated here; use
	// ifaceFullMethods to walk the full set.
	Methods @[]@Method

	// For TYP_INTERFACE only: the parent interfaces this one extends
	// (declaration order).  An empty slice means no extension.  See
	// plan-interface-embedding.md.
	Parents @[]@Type

	// For alias
	Target @Type

	// For TYP_UNTYPED_INT only: when this type came from a direct
	// integer literal (EXPR_INT_LIT) or a unary-minus of one, these
	// carry the literal's mathematical value.  Used by AssignableTo
	// to fit-check the literal against the target type's range —
	// `var x uint8 = 256` rejects, `var x uint8 = 255` accepts.
	// Per claude-notes.md § "Integer literal value range and
	// constant-expression arithmetic — DECIDED 2026-05-15".  Other
	// untyped-int values (binary-op results before const-folding)
	// leave HasLitVal=false; AssignableTo then falls back to the
	// kind-only check (Slice 3 will extend the const-folding path).
	HasLitVal bool
	LitMag    uint64
	LitSign   bool

	// For TYP_TYPE_PARAM: identity is the (Owner, Index) pair —
	// two type-param refs are the same type iff their Owner generic
	// decl pointers are equal AND their Index values match.  Two
	// distinct generic decls each declaring a `T` produce distinct
	// type-param types.  TpConstraint is the constraint interface
	// (nil for `any`); used by Slice 3's satisfaction check.  Per
	// plan-generics.md Q3.
	TpOwner      *uint8  // opaque pointer to the owning generic
	                     // decl's symbol; bit_cast to the actual
	                     // type at the use site.  *uint8 keeps
	                     // `types` free of cyclic deps on `ast`.
	TpIndex      int
	TpConstraint @Type
	// Name field is reused for the source-text name of the
	// type-param (e.g. "T") — useful for error messages.

	// For an instantiated generic struct (TYP_NAMED) or interface
	// (TYP_INTERFACE) produced by instantiateGenericDeclWithArgs.
	// InstDecl is an opaque pointer to
	// the originating generic @ast.Decl (bit_cast at the use site,
	// like TpOwner above — keeps `types` free of a cyclic `ast`
	// dep); InstArgs are the type-arguments it was instantiated
	// with.  Both nil/empty for non-instantiated types.
	// substituteTypeParams reads them to re-instantiate an
	// instantiation that names a generic's own type parameter
	// (`Vec[T]` → `Vec[int]`) when building a generic function's
	// signature at its call site.  Per plan-generics.md.
	InstDecl *uint8
	InstArgs @[]@Type
}

type Field struct {
	Name @[]char
	Type @Type
}

type Param struct {
	Name @[]char
	Type @Type
}

// Method describes a method registered on a named type. RecvType is the
// full receiver type as written (T, *T, @T, *readonly T, etc.); FuncType is
// the function signature with the receiver included as Params[0].
type Method struct {
	Name     @[]char
	RecvType @Type
	FuncType @Type
}

// ============================================================
// Predeclared Type Singletons
// ============================================================

// TypInt returns the predeclared int type.
func TypInt() @Type
// TypInt8 returns the predeclared int8 type.
func TypInt8() @Type
// TypInt16 returns the predeclared int16 type.
func TypInt16() @Type
// TypInt32 returns the predeclared int32 type.
func TypInt32() @Type
// TypInt64 returns the predeclared int64 type.
func TypInt64() @Type
// TypUint returns the predeclared uint type.
func TypUint() @Type
// TypUint8 returns the predeclared uint8 type.
func TypUint8() @Type
// TypUint16 returns the predeclared uint16 type.
func TypUint16() @Type
// TypUint32 returns the predeclared uint32 type.
func TypUint32() @Type
// TypUint64 returns the predeclared uint64 type.
func TypUint64() @Type
// TypFloat32 returns the predeclared float32 type.
func TypFloat32() @Type
// TypFloat64 returns the predeclared float64 type.
func TypFloat64() @Type
// TypBool returns the predeclared bool type.
func TypBool() @Type
// TypChar returns the predeclared char type.
func TypChar() @Type
// TypByte returns the predeclared byte type (alias for uint8).
func TypByte() @Type
// TypVoid returns the predeclared void type.
func TypVoid() @Type
// TypNil returns the predeclared nil type.
func TypNil() @Type
// TypUntypedInt returns the untyped integer constant type.
func TypUntypedInt() @Type
// TypUntypedFloat returns the untyped float constant type.
func TypUntypedFloat() @Type
// TypUntypedBool returns the untyped boolean constant type.
func TypUntypedBool() @Type
// TypSelf returns the singleton TYP_SELF placeholder used inside
// interface method signatures.  Substituted away by
// substituteSelf at impl-collection time and at generic
// instantiation time; should not survive past either of those.
func TypSelf() @Type

// ============================================================
// Type Construction
// ============================================================

// MakePointerType creates a raw pointer type (*elem).
func MakePointerType(elem @Type) @Type
// MakeManagedPtrType creates a managed pointer type (@elem).
func MakeManagedPtrType(elem @Type) @Type
// MakeSliceType creates a raw slice type (*[]elem).
func MakeSliceType(elem @Type) @Type
// MakeManagedSliceType creates a managed-slice type (@[]elem).
func MakeManagedSliceType(elem @Type) @Type
// MakeArrayType creates an array type ([length]elem).
func MakeArrayType(elem @Type, length int) @Type
// Utf8Bytes returns the UTF-8 encoding of BMP code point cp (0..0xFFFF,
// non-surrogate) as up to three bytes b0,b1,b2 plus the byte count n
// (1..3).  Shared with the IR literal decoders so `\u` escapes expand to
// the same bytes in both the natural-type length and the emitted data.
func Utf8Bytes(cp int) (char, char, char, int)
// ReinterpretBitCast returns v reinterpreted as the integer type t (the value a
// `bit_cast` to t produces: truncate + sign-extend to t's width).  Shared by
// the type checker's evalConstIntValue and IR-gen's evalConstExpr so a constant
// bit_cast folds to the identical value in both.
func ReinterpretBitCast(v int, t @Type) int
// MakeStructType creates a struct type with the given name and fields.
func MakeStructType(name @[]char, fields @[]@Field) @Type
// MakeFuncType creates a function type with the given parameters and results.
func MakeFuncType(params @[]@Param, results @[]@Type) @Type
// MakeFuncValueType creates a raw function-value type (*func(args) ret).
// The 2-word {vtable, data} layout is uniform across signatures; the
// signature shows up only in vtable type generation downstream.
func MakeFuncValueType(params @[]@Param, results @[]@Type) @Type
// MakeManagedFuncValueType creates a managed function-value type
// (@func(args) ret). Same layout as MakeFuncValueType; the data
// pointer is refcounted.
func MakeManagedFuncValueType(params @[]@Param, results @[]@Type) @Type
// MakeNamedType creates a named (distinct) type with no underlying type set yet.
func MakeNamedType(name @[]char) @Type
// MakeTypeParamType creates a generic type-parameter placeholder.
// `owner` is an opaque pointer to the owning generic decl's symbol
// (bit_cast at the use site); two type-params from distinct decls
// share no identity even when their Name and Index match.  `index`
// is the position in the owner's type-param list.  `constraint` is
// the interface constraint (nil for `any`).  Per plan-generics.md
// Slice 2 / Q3.
func MakeTypeParamType(name @[]char, owner *uint8, index int,
	constraint @Type) @Type
// MakeAliasType creates a type alias that resolves to target.
func MakeAliasType(name @[]char, target @Type) @Type
// MakeInterfaceType creates a declared-interface type with no methods set,
// keyed by its defining package's short name. (Pkg, Name) is the canonical
// identity used by implCoversInterface so cross-package iface refs that
// share a Name don't false-match.
// yet. The Methods table is populated via AddMethod during type-checker
// pass-1 collection. See plan-interface-syntax-revision.md.
func MakeInterfaceType(pkg @[]char, name @[]char) @Type
// MakeInterfaceValueType wraps a TYP_INTERFACE in a raw interface-value
// type (`*Iface`). Layout is 2-word {data, vtable} (16 bytes), uniform
// across interfaces — the interface shows up only in vtable selection
// and method-dispatch checks downstream. The wrapped interface is
// stored as t.Elem.
func MakeInterfaceValueType(iface @Type) @Type
// MakeManagedInterfaceValueType wraps a TYP_INTERFACE in a managed
// interface-value type (`@Iface`). Same 2-word layout as
// MakeInterfaceValueType; the data pointer is refcounted.
func MakeManagedInterfaceValueType(iface @Type) @Type

// MakeMethod constructs a Method record. FuncType must include the
// receiver as Params[0].
func MakeMethod(name @[]char, recvType @Type, funcType @Type) @Method

// AddMethod appends m to the named type t's method set. Returns false
// (without modifying t) if a method with the same name is already
// present.
func (t @Type) AddMethod(m @Method) bool

// SetOrAppendMethod replaces an existing same-named method on t in
// place, or appends m if no match. REPL redefinition entry point:
// callers using SetOrAppendMethod in place of AddMethod opt out of
// the duplicate-method error so a method can be re-typed at the
// prompt. Returns false only if t isn't a method-bearing type.
func (t @Type) SetOrAppendMethod(m @Method) bool

// LookupMethod returns the method named `name` on the named type t, or
// nil if no such method is registered.
func (t @Type) LookupMethod(name *[]readonly char) @Method

// ReceiverBaseNamed unwraps a receiver type's outer pointer/managed/const
// wrappers and returns the underlying named type, or nil if the receiver
// is not (a wrapper around) a named type.
func (t @Type) ReceiverBaseNamed() @Type
// MakeReadonlyType wraps inner with the const type modifier.
func MakeReadonlyType(inner @Type) @Type
// IsReadonly reports whether t has the const modifier at its
// outermost level (after stripping aliases).
func (t @Type) IsReadonly() bool
// StripReadonly returns the inner type, peeling one const wrapper.
// Returns t unchanged if t is not const at the outermost level.
func (t @Type) StripReadonly() @Type

// ============================================================
// Type Queries
// ============================================================

// TypeName returns a human-readable name for the type.
func (t @Type) TypeName() @[]char
// IsInteger reports whether t is an integer type.
func (t @Type) IsInteger() bool

// IsFloat reports whether t is a floating-point type.
func (t @Type) IsFloat() bool
// IsNumeric reports whether t is a numeric type.
func (t @Type) IsNumeric() bool
// SignedMinForWidth returns the most-negative value of a signed integer
// of the given bit width as a 64-bit pattern (widths >= 64 saturate at
// the int64 minimum). Used by the DivCheck signed MIN / -1 overflow guard.
func SignedMinForWidth(width int) int64
// IsBool reports whether t is a boolean type.
func (t @Type) IsBool() bool
// IsPointer reports whether t is a pointer type (raw or managed).
func (t @Type) IsPointer() bool
// IsSlice reports whether t is a slice type (raw or managed).
func (t @Type) IsSlice() bool
// IsByvalParam reports whether a parameter of type t is passed via the
// >16-byte indirect (`ptr byval`) convention; the single predicate IR-gen
// and codegen share so their two halves of that lowering agree.
func (t @Type) IsByvalParam() bool
// IsNillable reports whether t can be assigned nil.
func (t @Type) IsNillable() bool
// Identical reports whether types a and b are structurally identical.
func (a @Type) Identical(b @Type) bool
// AssignableTo reports whether a value of type src is assignable to type dst.
// `c` supplies the active checker for the interface-value arms (which scan
// c.Impls); pass nil when no checker context applies — the interface-value
// cases then conservatively return false (no impl is reachable).
func (src @Type) AssignableTo(c @Checker, dst @Type) bool
// ResolveAlias follows alias chains and returns the underlying type.
func (t @Type) ResolveAlias() @Type
// SliceElem returns the element type of a slice or managed-slice type.
func (t @Type) SliceElem() @Type
// PointerElem returns the element type of a pointer or managed pointer type.
func (t @Type) PointerElem() @Type
// FieldByName looks up a struct field by name, returning nil if not found.
func (t @Type) FieldByName(name *[]readonly char) @Field
// NeedsDestruction reports whether t contains managed pointers requiring cleanup.
func (t @Type) NeedsDestruction() bool

// ============================================================
// Type Layout
// ============================================================

// TargetInfo describes the target platform's basic properties.
type TargetInfo struct {
	PointerSize int    // 4 or 8
	IntSize     int    // typically == PointerSize
	MaxAlign    int    // typically == PointerSize
}

// SetTarget configures the target platform properties for layout computation.
func SetTarget(info TargetInfo)
// GetTarget returns the current target platform properties.
func GetTarget() TargetInfo

// SizeOf computes the size in bytes of a value of type t.
func (t @Type) SizeOf() int
// AlignOf computes the alignment requirement in bytes of type t.
func (t @Type) AlignOf() int
// FieldOffset computes the byte offset of the field at the given index in a struct.
func (t @Type) FieldOffset(index int) int

// FieldLayout describes one field's position in the physical struct layout.
type FieldLayout struct {
	FieldIndex    int
	Offset        int
	Size          int
	PaddingBefore int
}

// StructLayout computes the physical layout of all fields in a struct type.
func (t @Type) StructLayout() @[]FieldLayout
// TrailingPadding computes the number of padding bytes after the last field in a struct.
func (t @Type) TrailingPadding() int

// Slice field indices
const SLICE_FIELD_DATA int = 0
const SLICE_FIELD_LEN int = 1

// Managed-slice field indices
const MSLICE_FIELD_DATA int = 0
const MSLICE_FIELD_LEN int = 1
const MSLICE_FIELD_BACKING int = 2
const MSLICE_FIELD_BACKING_LEN int = 3

// SliceDataOffset returns the byte offset of the data pointer in a raw slice.
func SliceDataOffset() int
// SliceLenOffset returns the byte offset of the length field in a raw slice.
func SliceLenOffset() int
// MSliceDataOffset returns the byte offset of the data pointer in a managed-slice.
func MSliceDataOffset() int
// MSliceLenOffset returns the byte offset of the length field in a managed-slice.
func MSliceLenOffset() int
// MSliceBackingOffset returns the byte offset of the backing pointer in a managed-slice.
func MSliceBackingOffset() int
// MSliceBackingLenOffset returns the byte offset of the backing length in a managed-slice.
func MSliceBackingLenOffset() int
// ManagedHeaderSize returns the size in bytes of the managed allocation header.
func ManagedHeaderSize() int
// ManagedRefcountOffset returns the byte offset of the refcount in a managed header.
func ManagedRefcountOffset() int
// ManagedFreeFnOffset returns the byte offset of the free function pointer in a managed header.
func ManagedFreeFnOffset() int

// ============================================================
// Scope and Symbols
// ============================================================

const (
	SYM_VAR int = iota
	SYM_CONST
	SYM_TYPE
	SYM_FUNC
	SYM_PKG
	SYM_INTERFACE  // declared interface (not a value type — see
	               // plan-interface-syntax-revision.md). Only legal
	               // in `*Iface` / `@Iface` type expressions, on the
	               // LHS of an `impl T : Iface` decl, or as the
	               // target of an interface alias.
)

type Symbol struct {
	Name    @[]char
	Type    @Type
	Kind    int
	PkgPath @[]char
	// For Kind == SYM_CONST with an integer value the checker could
	// fold: ConstVal holds that value and HasConstVal is true.  Lets
	// const consumers that need the value itself — notably evalConstInt
	// for array dimensions (`[N]int`) — read it without re-deriving it
	// from the initializer (which the symbol does not retain).  The
	// Type's HasLitVal/LitMag are documented for TYP_UNTYPED_INT only,
	// so a TYPED const's value lives here instead.
	ConstVal    int
	HasConstVal bool
}

type Scope struct {
	Parent  @Scope
	Syms    @[]@Symbol
	// DelegateDefine: when true, Define forwards to Parent instead of
	// inserting locally.  Set on a per-file IMPORT scope so package-level
	// symbols collected while that scope is active (the current decl's file
	// scope) land in the shared package scope, while the file's imports —
	// registered BEFORE the flag is set — stay local to the file.  This is
	// what makes imports file-scoped without reclassifying every collector's
	// define call.  See checkPackageImpl / buildFileScopes.
	DelegateDefine bool
}

// NewScope creates a new scope with the given parent (nil for the top-level scope).
func NewScope(parent @Scope) @Scope
// Define adds a symbol to the scope.
func (s @Scope) Define(sym @Symbol)
// Lookup searches for a symbol by name in the scope and its parents.
func (s @Scope) Lookup(name *[]readonly char) @Symbol

// ============================================================
// Checker
// ============================================================

type CheckError struct {
	Pos token.Pos
	Msg @[]char
}

// FormatCheckError renders a CheckError as "file:line:col: message"
// (or "line:col: message" when the position carries no filename).
func FormatCheckError(e CheckError) @[]char

// CaptureFrame tracks one active function-literal body during
// type-checking, for capture analysis (`plan-function-values-
// phase-2.md` B.1).  When an Ident inside the literal body
// resolves to a symbol defined OUTSIDE the body scope, the
// resolution crosses this frame's boundary and the symbol is
// recorded as a capture on the literal's Decl.  Nested literals
// stack frames so the recording can cascade outward: an inner
// literal capturing from outside the outer literal also records
// a capture on the outer (the outer needs the slot in its own
// closure struct to pass through).
type CaptureFrame struct {
	// LitDecl is the synthetic Decl for this literal.  Captures
	// are appended to LitDecl.Captures (deduplicated by name —
	// first-use wins layout order).
	LitDecl   @ast.Decl
	// BodyScope is the scope at which the literal's body checks.
	// Symbols defined in BodyScope or any descendant block scope
	// inside the body are local; symbols only reachable beyond
	// BodyScope are captures.
	BodyScope @Scope
}

type Checker struct {
	Errors    @[]CheckError
	// Warnings is a parallel list to Errors for non-blocking
	// diagnostics.  Used by Phase 2 of plan-type-decls.md to flag
	// duplicate .bni/.bn full struct definitions during the
	// migration window.  Drivers (cmd/bnc, cmd/bni) print these
	// after type-checking succeeds; they do NOT prevent code
	// generation.
	Warnings  @[]CheckError
	Scope     @Scope
	FuncRet   @[]@Type
	Packages  @[]@PkgEntry
	Iota      int
	InLoop    bool  // true inside for loops (break + continue valid)
	InSwitch  bool  // true inside switch (break valid, continue not)
	// InConstGroup: true while checking a grouped const block's members.
	// The signedness-aware const-value fold + ExprType stamping (which IR-gen's
	// genConst reads) are SINGLE-const only — genConstGroup doesn't read the
	// stamp, so applying them in a group would desync the checker (correct) from
	// IR-gen (signed host-int).  Skipped here keeps grouped consts consistently
	// folded by the host int on both sides (claude-todo h-group).
	InConstGroup bool

	// AllowRedef: when true, suppresses the bni-vs-bn signature
	// match check that normally fires whenever a function name is
	// already in local scope.  Set by REPL entry points
	// (CheckDeclInScope) so re-typing a func at the prompt isn't
	// reported as a "bni declared X" mismatch.  Off by default;
	// the compile-time path keeps the check active.
	AllowRedef bool

	// AllowSelf: when true, `Self` is a valid type expression.
	// Set transiently while resolving an interface method's
	// signature (argument and result types only).  Off everywhere
	// else — including inside interface alias targets, interface
	// extension parent lists, and ordinary func / var / type /
	// struct declarations.  A TEXPR_SELF reference reached with
	// AllowSelf=false produces a type error.  See
	// plan-self-type.md Slice S.2.
	AllowSelf bool

	// AllowUniverseRecv: when true, methods may be declared on
	// universe primitives (`int`, `bool`, `char`, etc.).  Set by
	// Check / CheckPackage when the source file's package is the
	// carve-out package (currently `pkg/builtins/lang`).  Off everywhere
	// else — user packages can't extend `int`.  Per
	// plan-primitives-impl-interfaces.md Slice 1.
	AllowUniverseRecv bool

	// PackageScope: the file/package-level scope, captured at the
	// start of pass-2 body checking.  Originally used by Phase 1's
	// checkFuncLit (Slice A.7) to reparent literal bodies and reject
	// captures; Phase 2 (plan-function-values-phase-2.md B.1)
	// removes that reparenting in favour of capture analysis.  The
	// field is kept because other code paths reference it as the
	// package-level lookup root.
	PackageScope @Scope

	// FileScopeNames / FileScopes: the per-file import scopes for the
	// package currently being checked (multi-file CheckPackage path only),
	// keyed by source-file path (a decl's Pos.File).  Built by
	// buildFileScopes; consulted per decl in collectDeclsBody / checkDecls /
	// resolveConstByName so a qualifier in file F resolves against only F's
	// imports.  Empty in single-file / REPL mode (imports go straight into
	// the one package scope as before).
	FileScopeNames @[]@[]char
	FileScopes     @[]@Scope

	// CaptureStack: active function-literal capture frames.  Pushed
	// on entry to a literal body in checkFuncLit, popped on exit;
	// each successful Ident lookup walks the stack from innermost
	// to outermost and records a capture on every frame the
	// resolution crosses.  See `plan-function-values-phase-2.md`
	// §"Capture analysis (type-checker)".  Empty stack means we're
	// not inside any literal body — captures are a no-op.
	CaptureStack @[]@CaptureFrame

	// Type registry: maps ResolvedTypeID → Type.
	// Populated during type checking; queried by downstream tools (linter, etc.).
	ExprTypes    @[]@Type
	NumExprTypes int

	// Impls: collected `impl T : Iface, ...` declarations. Slice 2.1
	// of plan-interface-syntax-revision.md only collects (resolves
	// the receiver type and interface names); satisfaction checks
	// land in a follow-up slice.
	Impls @[]@Impl

	// GenericTypeDecls: AST decls for generic struct declarations
	// (DECL_TYPE with non-empty TypeParams).  Per plan-generics.md
	// Slice 5b: Pass 1 stashes the AST here instead of resolving
	// the struct body (T is unbound at decl time); use sites
	// `Name[T1, T2]` look up by Name and instantiate fresh,
	// caching the result in GenericInstantiations.
	GenericTypeDecls @[]@ast.Decl

	// GenericTypeDeclPkgs: parallel array carrying each entry's
	// defining package's short-name — empty for the current
	// (main) package, the import alias for entries registered
	// from an imported .bni (Slice 7b of plan-generics.md).
	// lookupGenericTypeDeclPkg uses this to disambiguate
	// `Pair[int]` from `otherpkg.Pair[int]`.
	GenericTypeDeclPkgs @[]@[]char

	// GenericIfaceDecls: AST decls for generic interface
	// declarations (DECL_INTERFACE with non-empty TypeParams).
	// Per plan-generics.md Slice 6b: same pattern as
	// GenericTypeDecls — Pass 1 stashes the AST instead of
	// resolving the method set (T is unbound at decl time);
	// use sites `Name[T1, T2]` look up by Name and instantiate
	// fresh, caching alongside structs in GenericInstantiations.
	GenericIfaceDecls @[]@ast.Decl

	// GenericIfaceDeclPkgs: parallel pkg-pairing for
	// GenericIfaceDecls.  Slice 7c of plan-generics.md.
	GenericIfaceDeclPkgs @[]@[]char

	// GenericInstantiations: cache of (decl, type-args) →
	// instantiated @Type so `List[int]` produces the same @Type
	// across uses (Identical-comparison works).  Indexed in
	// insertion order; lookup walks the list.  Per Q1 of
	// plan-generics.md.
	GenericInstantiations @[]@GenericInstantiation

	// Tier 3 forward references — pending decl tracking.  When
	// TentativeMode is set, ALL errors during the body check
	// route to TentativeErrors instead of the user-visible
	// Errors slice.  errUndefined ALSO captures the name in
	// TentativeMissing.  After the body check, the REPL driver
	// uses this to decide:
	//   - TentativeMissing non-empty → park the decl (the
	//     missing names are why; the cascading errors that
	//     followed them are noise).
	//   - TentativeMissing empty but TentativeErrors non-empty
	//     → real errors with no missing-name blame; migrate
	//     them to Errors so the user sees them.
	TentativeMode    bool
	TentativeMissing @[]@[]char
	TentativeErrors  @[]CheckError
	Pending          @[]@PendingDecl

	// PendingMark is the length of Pending at the entry to the
	// most recent CheckDeclInScope call.  IsDeclPending() reports
	// whether Pending grew during that call (covering both the
	// single-decl case and DECL_GROUP per-member parking — where
	// TentativeMissing alone wouldn't, since the group loop
	// resets it per member).  REPL driver also walks
	// `Pending[PendingMark:]` to iterate every decl that just
	// parked, for per-decl "X parked (pending: ...)" announcements.
	PendingMark      int

	// ExpectedFVType is a transient hint set by callers of
	// checkExpr that already know the destination type's
	// function-value form — VarDecl with `var f @func()`, return
	// statements whose function returns @func, etc.  When set to
	// a TYP_MANAGED_FUNC_VALUE / TYP_FUNC_VALUE, checkFuncLit
	// consults it to resolve a literal whose signature matches
	// as the requested form rather than the default *func.  IR-
	// gen reads the literal's resolved type to choose stack-
	// alloc (raw *func) vs heap-alloc (managed @func).  Nil
	// outside the narrow set-and-clear windows; B.3b of
	// plan-function-values-phase-2.md.
	ExpectedFVType @Type

	// ConstResolving / ConstResolved drive dependency-ordered
	// resolution of top-level consts in pass 1 (resolveTopLevelConsts).
	// ConstResolving is the active depth-first stack, used to detect a
	// `const A = B; const B = A` cycle; ConstResolved memoizes names
	// whose real type+value have been recorded so re-entry is a no-op.
	// Both are reset per sweep and used only on the batch path.
	ConstResolving @[]@[]char
	ConstResolved  @[]@[]char

	// ReplDeclMode is set while CheckDeclInScope checks a single REPL
	// decl.  The batch-path dependency-ordered const sweep
	// (resolveTopLevelConsts) must NOT run there — a REPL const that
	// references a not-yet-entered name has to PARK (Tier-3 pending
	// machinery), not eagerly error; collectDeclsBody forward-registers
	// const placeholders for that path instead.  This is distinct from
	// TentativeMode, which is false during the REPL's pass-1 collectDecls
	// (it's only set for the pass-2 body check), and from AllowRedef,
	// which is about `.bni`/`.bn` redefinition tolerance.
	ReplDeclMode bool

	// GenericInstDepth is the current nesting depth of generic
	// instantiation (instantiateGenericDeclWithArgs).  Bounds
	// infinitely-growing instantiation chains (`type Box[T] struct {
	// inner @Box[Wrap[T]] }`) — each level has different type args, so
	// the placeholder cache never hits; the depth bound rejects them
	// with a clean diagnostic instead of overflowing the stack.
	GenericInstDepth int

	// GenericIfacePopulating is the stack of instantiated generic
	// interfaces whose extension clause is currently being resolved.
	// resolveInterfaceExtension consults it to detect an inheritance
	// cycle across distinct instantiated interfaces (`interface P[T] :
	// Q[T]` + `interface Q[T] : P[T]`): the back-edge parent resolves
	// to an interface still on this stack, so it is reported and
	// dropped — keeping the Parents graph acyclic so the ancestor-
	// closure walks (ifaceFullMethods / isDescendantInterface) can't
	// loop.  (Direct self-extension is caught separately by name.)
	GenericIfacePopulating @[]@Type

	// curPkgShort / curPkgPath: the package currently being checked /
	// whose .bni is being loaded — the short last-segment name and the
	// full path respectively.  curPkgShort stamps Pkg onto each
	// TYP_INTERFACE (cross-package iface identity is (Pkg, Name));
	// curPkgPath path-qualifies a named struct's Type.Name for mangling
	// (must equal IR-gen's per-module package path for the same module).
	// Per-checker (was package-global): the Check* entry points save the
	// prior value, set it for the pass, and restore on exit, so nested
	// checks (REPL-inside-compile) and concurrent checkers don't collide.
	curPkgShort @[]char
	curPkgPath  @[]char
}

// PendingDecl is one parked declaration that couldn't fully
// resolve at first-check time because it referenced names not
// yet bound.  Held in Checker.Pending; the REPL driver retries
// each entry after every subsequent decl, removing those that
// now resolve cleanly.
//
// IotaIdx is the parked decl's position within its containing
// `const ( ... )` group, or -1 if the decl is a free top-level
// (not a group member).  Carried so RetryPendingDecls can
// restore c.Iota to the correct positional value before re-
// checking — iota's value is determined by member position,
// not by which other members are resolved first.  Per Stage 1
// (c) of plan-repl-tier3-pending-types.md: groups are
// syntactic sugar; each member parks individually.
type PendingDecl struct {
	Decl         @ast.Decl
	MissingNames @[]@[]char
	IotaIdx      int
}

// Impl records a single `impl T : I1, I2, ...` declaration. The
// receiver type captures the receiver-kind nuance (TYP_POINTER vs
// TYP_MANAGED_PTR vs the bare type, plus const) so that downstream
// satisfaction checks and codegen can route correctly. Each
// interface entry is a TYP_INTERFACE.
type Impl struct {
	Pos        token.Pos
	RecvType   @Type
	Interfaces @[]@Type
}

type PkgEntry struct {
	Path  @[]char
	Scope @Scope
}

// GenericInstantiation caches one resolved `Name[T1, T2, ...]`
// type-instantiation against its source AST decl + type-arg list,
// so subsequent references hit a stable @Type instance.  Per
// plan-generics.md Slice 5b / Q1.
type GenericInstantiation struct {
	Decl     @ast.Decl
	TypeArgs @[]@Type
	Result   @Type
}

// NewChecker creates a new type checker with predeclared types in scope.
func NewChecker() @Checker
// Check type-checks a single file and records any errors in the checker.
func (c @Checker) Check(file @ast.File)
// CheckPackage type-checks a merged package file and registers it by path.
func (c @Checker) CheckPackage(path @[]char, merged @ast.File)
// CheckPackageDecls registers a package's exported surface by path WITHOUT
// type-checking function bodies — for packages loaded only as dependencies
// of the real check/lint targets.
func (c @Checker) CheckPackageDecls(path @[]char, merged @ast.File)
// LoadPackageInterface loads type information from a .bni interface file.
func (c @Checker) LoadPackageInterface(path @[]char, bni @ast.File)
// CheckMainPersistent type-checks a main source file like Check but
// leaves the file's scope installed on c.Scope when it returns, so
// a REPL session can issue subsequent CheckExpr / CheckStmtList
// calls against that scope.
func (c @Checker) CheckMainPersistent(file @ast.File)
// CheckDeclInScope type-checks a single top-level declaration
// against c.Scope — registers the symbol persistently and checks
// the body / initializer.  REPL entry point for Tier 2.
//
// Tier 3 forward refs: for DECL_FUNC, the body check runs in
// tentative mode.  If it referenced names not yet bound, the
// decl is parked on c.Pending and the missing names are
// returned via c.TentativeMissing — the REPL driver detects
// this and skips IR-gen.  Sig check is always immediate so the
// func's symbol enters c.Scope and other code can reference it.
func (c @Checker) CheckDeclInScope(d @ast.Decl)

// IsDeclPending reports whether the most recent CheckDeclInScope
// call parked its decl.  Equivalent to checking whether
// `c.TentativeMissing` is non-empty after the call.  Caller
// (REPL driver) uses this to gate IR-gen.
func (c @Checker) IsDeclPending() bool

// RetryPendingDecls re-runs the body check on every entry in
// c.Pending.  Returns the decls that now resolve cleanly
// (caller IR-gens them) and removes them from the queue.
// Decls still missing names stay parked.  Called by the REPL
// driver after every subsequent decl that successfully binds
// new names.
func (c @Checker) RetryPendingDecls() @[]@ast.Decl

// IsPendingDecl reports whether `name` is currently parked in
// the checker's pending queue — a top-level decl (free func,
// var, or const) whose body / initializer couldn't be fully
// checked because it referenced names that weren't bound.  Use-
// site references can surface a clear "X is unresolved" error
// via this rather than letting a parked symbol's stale type
// propagate.  Methods (`pd.Decl.Recv != nil`) are excluded;
// their resolution path is the receiver type's method set.
func (c @Checker) IsPendingDecl(name *[]readonly char) bool

// RegisterReplImport defines a package symbol in the REPL
// session scope after a mid-session `import` prompt entry.
// The package's scope must already be registered (via
// LoadPackageInterface / CheckPackage from the loader-side
// import path).  Returns false if no package is registered
// for `path` — caller surfaces the error.  Per Tier 5 of
// plan-repl.md.
func (c @Checker) RegisterReplImport(alias @[]char,
		path @[]char) bool

// FindFreshCycles walks c.Pending[fromIdx:] (decls parked
// during the most-recent CheckDeclInScope call) and returns
// any cycles their missing-names chains close in the global
// pending graph.  Each cycle is returned as a list of names
// starting and ending with the same name.  REPL driver
// formats them as `type cycle: A -> B -> A` so the user knows
// the pending chain won't resolve on its own.  Per Stage 4 of
// plan-repl-tier3-pending-types.md.
func (c @Checker) FindFreshCycles(fromIdx int) @[]@[]@[]char

// LookupMethodForDecl returns the method (if any) currently
// registered on the named base type of d.Recv with name d.Name,
// or nil if d isn't a method or no match is registered.  REPL
// driver calls this BEFORE CheckDeclInScope on a method decl to
// capture the pre-redef sig (CheckDeclInScope overwrites it via
// SetOrAppendMethod when c.AllowRedef is set), so the driver
// can decide replace vs shadow at the IR/VM layers.
func (c @Checker) LookupMethodForDecl(d @ast.Decl) @Method

// CheckExprInScope type-checks a single expression against c.Scope.
// REPL entry point; returns the resolved expression type.
func (c @Checker) CheckExprInScope(e @ast.Expr) @Type
// CheckStmtListInScope type-checks a statement list against c.Scope.
// REPL entry point; errors are appended to c.Errors.
func (c @Checker) CheckStmtListInScope(ss @[]@ast.Stmt)
// CheckerErrors returns the list of type errors accumulated during checking.
func (c @Checker) CheckerErrors() @[]CheckError
// CheckerWarnings returns the list of type warnings accumulated during
// checking — non-blocking diagnostics (e.g. duplicate .bni/.bn struct
// definitions in plan-type-decls.md's migration window).  Drivers print
// these but DO NOT abort on a non-empty list.
func (c @Checker) CheckerWarnings() @[]CheckError
// ExprType returns the resolved type for an expression by its ResolvedTypeID.
// Returns nil if the ID is 0 (unresolved) or out of range.
func (c @Checker) ExprType(id int) @Type


// PackageType returns the type registered for `name` in package `pkgPath`'s
// scope (nil if the package or member is not found).  Used by IR-gen to
// resolve a cross-package type (e.g. reflect.Package) without re-parsing.
func (c @Checker) PackageType(pkgPath *[]readonly char, name *[]readonly char) @Type
