// Package types implements type representation, construction, comparison,
// layout computation, scope/symbol management, and type checking for Binate.
package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/std/table"

// ============================================================
// Type Representations
// ============================================================

// TypeKind identifies what kind of type a Type represents.
const (
	TYP_INT int = iota
	TYP_FLOAT
	TYP_BOOL
	TYP_VOID
	TYP_NIL
	TYP_UNTYPED_INT
	TYP_UNTYPED_FLOAT
	TYP_UNTYPED_BOOL
	TYP_UNTYPED_STRING // an untyped string literal — adopts a char-slice /
	// char-array target by context (default @[]readonly
	// char), like the untyped scalar kinds above.  Carries
	// the literal's unescaped byte length in ArrayLen and
	// `readonly char` in Elem, so a context that needs the
	// natural [N]readonly char array (comparison, indexing,
	// constant len) can reconstruct it.  A runtime
	// [N]readonly char value is a TYP_ARRAY, never this — so
	// there is no array→slice decay for a runtime array to
	// masquerade through.
	TYP_POINTER
	TYP_MANAGED_PTR
	TYP_SLICE
	TYP_MANAGED_SLICE
	TYP_ARRAY
	TYP_STRUCT
	TYP_FUNC
	TYP_FUNC_VALUE    // *func(args) ret — raw function value
	// (2-word {vtable, data}, 16 bytes)
	TYP_MANAGED_FUNC_VALUE // @func(args) ret — managed function value
	// (2-word {vtable, data}, 16 bytes; data
	// pointer is refcounted)
	TYP_NAMED
	TYP_ALIAS
	TYP_READONLY
	TYP_INTERFACE // declared interface — stores the method set on
	// the type's Methods table. Bare interface name
	// is NOT a usable value-type expression; usable
	// forms are *Iface and @Iface, lowered to the
	// TYP_INTERFACE_VALUE / TYP_INTERFACE_VALUE_MANAGED
	// kinds below. TYP_INTERFACE itself is stored on
	// the SYM_INTERFACE entry for the declared name
	// and is referenced from interface-value types
	// via t.Elem.
	TYP_INTERFACE_VALUE // *Iface — raw interface value
	// (2-word {data, vtable}, 16 bytes)
	TYP_INTERFACE_VALUE_MANAGED // @Iface — managed interface value
	// (2-word {data, vtable}, 16 bytes;
	// data ptr is refcounted)
	TYP_SELF // `Self` placeholder — appears in
	// interface method signatures only.
	// Substituted at impl-collection time
	// (substituteSelf) and at generic
	// instantiation time.  Singleton:
	// identity via pointer equality on
	// TypSelf().
	TYP_TYPE_PARAM // Generic type parameter `T` — appears
	// in a generic decl's body scope until
	// instantiation substitutes a concrete
	// @Type for it.  Identity is via
	// (Owner generic decl, Index in the
	// type-param list); see Type.TypeParam
	// fields below.
	TYP_ERROR // Error sentinel — the type of an
	// expression for which a type error was
	// already reported.  Distinct from
	// TYP_VOID (a legitimate no-value result,
	// e.g. a call to a void-returning func) so
	// error-recovery can suppress follow-on
	// diagnostics without masking a real
	// "cannot assign void" error: AssignableTo
	// treats TYP_ERROR as compatible with any
	// type (both directions), and the
	// binary-op checker short-circuits on an
	// error operand instead of re-reporting.
	// Singleton via TypError().
	NUM_TYPE_KINDS
)

// Type represents a resolved type.
type Type struct {
	Kind   int
	Name   @[]char
	Width  int
	Signed bool

	// Pkg: the package where this type is declared, used as a
	// cross-package identity discriminant for same-short-named types.
	// Conventions differ by kind: for TYP_INTERFACE it is the SHORT
	// package name (so cross-package iface refs preserve their canonical
	// (Pkg, Name) identity through IR-gen and codegen); for a distinct
	// TYP_NAMED NON-struct type (e.g. `type T int`) it is the FULL
	// package path (checker-only — the discriminant in namedIdentityName
	// that keeps `red.T` and `blue.T` distinct; the full path avoids the
	// same-final-segment collision a short name would allow). Empty for
	// primitive types and where Pkg is implied by enclosing identity: a
	// named TYP_STRUCT carries its qualified name in the underlying's
	// Name itself, and a generic-instantiated named type pre-qualifies
	// its own Name.
	Pkg @[]char

	// For pointer, managed ptr, slice, managed slice, array
	Elem @Type

	// For array
	ArrayLen int

	// For struct
	Fields @[]@Field

	// For func
	Params  @[]@Param
	Results @[]@Type
	// Generic type parameters for a TYP_FUNC.  Nil / empty for
	// non-generic functions.  Each entry is a TYP_TYPE_PARAM
	// instance shared between this func type's signature and its
	// body's type-param scope; identity-comparable.
	TypeParams @[]@Type

	// For named (distinct type)
	Underlying @Type
	// OpaqueExportPkg: for a TYP_NAMED that was FORWARD-declared in a `.bni`
	// (`type Box`, opaque to importers) and whose layout is later FILLED from
	// the defining package's `.bn` (so the provider can build it), this holds
	// that defining package's path.  Empty means "not an opaque export" (a
	// fully-`.bni`-declared transparent type, or a package-private type).
	//
	// The fill is REQUIRED for the provider's own codegen, but it would
	// otherwise leak the layout to importers (the same Type object is shared):
	// the consumer's `b.v` would resolve Box's fields and wrongly compile.  So
	// field access consults this: a field access on an opaque-export type from a
	// DIFFERENT package than OpaqueExportPkg is rejected (the .bni surface is
	// opaque), while same-package access (the provider) sees the full layout.
	// IR-gen / codegen always use Underlying — the opacity is a CHECKER-only,
	// consumer-only view (a two-view model). See bug 211 / type.opaque.*.
	OpaqueExportPkg @[]char
	// IsPending: this type's resolution is parked on c.Pending
	// awaiting a forward-referenced dependency.  Only meaningful
	// for TYP_NAMED, TYP_ALIAS, and TYP_STRUCT today — once a
	// pending-type substrate lands, use sites that need T's layout
	// (struct field, var, sized sig) capture T's name as a pending
	// dependency via capturePendingDep when this flag is set.
	// Reference uses (`@T`, `*T`, `@[]T`) are size-stable and
	// don't propagate.  Cleared by collectTypeDecl (or RetryPending-
	// Decls's type retry) once Underlying / Fields are populated
	// from the now-bound dependency.
	IsPending bool
	// Methods registered on this named type (declaration order). Only
	// meaningful when Kind == TYP_NAMED or Kind == TYP_INTERFACE.
	// For TYP_INTERFACE this is the interface's OWN methods only —
	// inherited methods from Parents are not duplicated here; use
	// ifaceFullMethods to walk the full set.
	Methods @[]@Method

	// For TYP_INTERFACE only: the parent interfaces this one extends
	// (declaration order).  An empty slice means no extension.
	Parents @[]@Type

	// For alias
	Target @Type

	// For TYP_UNTYPED_INT only: when this type came from a direct
	// integer literal (EXPR_INT_LIT) or a unary-minus of one, these
	// carry the literal's mathematical value.  Used by AssignableTo
	// to fit-check the literal against the target type's range —
	// `var x uint8 = 256` rejects, `var x uint8 = 255` accepts.
	// Per claude-notes.md § "Integer literal value range and
	// constant-expression arithmetic — DECIDED 2026-05-15".  Other
	// untyped-int values (binary-op results before const-folding)
	// leave HasLitVal=false; AssignableTo then falls back to the
	// kind-only check (Slice 3 will extend the const-folding path).
	HasLitVal bool
	LitMag    uint64
	LitSign   bool

	// For a TYP_BOOL carrier stamped on a const initializer's ExprType
	// (attachConstBoolVal): the signedness-aware folded boolean value, read by
	// IR-gen's genConst in preference to re-folding the initializer — its
	// host-int evalConstBool compares unsigned operands >= 2^63 as SIGNED, a
	// silent miscompile (`const C bool = U > D`, 2^63 > 2^61, folds to false).
	HasBoolVal bool
	BoolVal    bool

	// IsConstStamp marks a Type that attachConstLitVal / attachConstBoolVal
	// wrote as the SIGNEDNESS-AWARE folded value of a const initializer (it
	// carries HasLitVal or HasBoolVal too).  IR-gen's genConst / genConstGroup
	// read the stamp only when this is set, so they ignore an incidental
	// HasLitVal that checkExpr leaves on a node — e.g. a bare iota-group member
	// re-checking the preceding member's SHARED initializer node overwrites its
	// ExprType with the last iota's HasLitVal, which is not a const stamp.
	IsConstStamp bool

	// For TYP_TYPE_PARAM: identity is the (Owner, Index) pair —
	// two type-param refs are the same type iff their Owner generic
	// decl pointers are equal AND their Index values match.  Two
	// distinct generic decls each declaring a `T` produce distinct
	// type-param types.  TpConstraint is the constraint interface
	// (nil for `any`); used by the satisfaction check.
	TpOwner *uint8 // opaque pointer to the owning generic
	// decl's symbol; bit_cast to the actual
	// type at the use site.  *uint8 keeps
	// `types` free of cyclic deps on `ast`.
	TpIndex      int
	TpConstraint @Type
	// Name field is reused for the source-text name of the
	// type-param (e.g. "T") — useful for error messages.

	// For an instantiated generic struct (TYP_NAMED) or interface
	// (TYP_INTERFACE) produced by instantiateGenericDeclWithArgs.
	// InstDecl is an opaque pointer to
	// the originating generic @ast.Decl (bit_cast at the use site,
	// like TpOwner above — keeps `types` free of a cyclic `ast`
	// dep); InstArgs are the type-arguments it was instantiated
	// with.  Both nil/empty for non-instantiated types.
	// substituteTypeParams reads them to re-instantiate an
	// instantiation that names a generic's own type parameter
	// (`Vec[T]` → `Vec[int]`) when building a generic function's
	// signature at its call site.
	InstDecl *uint8
	InstArgs @[]@Type

	// Cached wrapper types keyed by THIS type as the element: the raw-pointer
	// / managed-pointer / raw-slice / managed-slice type whose Elem is this
	// type.  Lazily populated by MakePointerType / MakeManagedPtrType /
	// MakeSliceType / MakeManagedSliceType, so a repeatedly-requested wrapper
	// (e.g. `@[]char` re-derived for every string-typed expression) is
	// allocated ONCE per element rather than once per request — a top driver
	// of type-check-time allocation otherwise.  Pure memoization: these
	// wrappers are immutable, and structural equality (Identical) ignores
	// these fields, so sharing them is transparent.  nil = not yet built.
	CachedPtr    @Type
	CachedMPtr   @Type
	CachedSlice  @Type
	CachedMSlice @Type
}

type Field struct {
	Name @[]char
	Type @Type
}

type Param struct {
	Name @[]char
	Type @Type
	// IsVariadic marks a variadic parameter.  Set only on the LAST param of a
	// variadic signature (`name ...T`); its Type is the raw-slice body type
	// `*[]T` that the callee sees.  Variadic-ness is part of a func type's
	// identity (func.variadic.identity, spec §10.3): a variadic signature is
	// distinct from the otherwise-identical one taking a plain `*[]T` param, so
	// every func-type equality/assignability comparison consults it (via the
	// funcIsVariadic helper in types_query.bn).  It rides on the last Param so
	// it survives receiver-prepend/drop and per-param generic substitution.
	IsVariadic bool
}

// Method describes a method registered on a named type. RecvType is the
// full receiver type as written (T, *T, @T, *readonly T, etc.); FuncType is
// the function signature with the receiver included as Params[0].
type Method struct {
	Name     @[]char
	RecvType @Type
	FuncType @Type
}

// ============================================================
// Predeclared Type Singletons
// ============================================================

// TypInt returns the predeclared int type.
func TypInt() @Type

// TypInt8 returns the predeclared int8 type.
func TypInt8() @Type

// TypInt16 returns the predeclared int16 type.
func TypInt16() @Type

// TypInt32 returns the predeclared int32 type.
func TypInt32() @Type

// TypInt64 returns the predeclared int64 type.
func TypInt64() @Type

// TypUint returns the predeclared uint type.
func TypUint() @Type

// TypUint8 returns the predeclared uint8 type.
func TypUint8() @Type

// TypUint16 returns the predeclared uint16 type.
func TypUint16() @Type

// TypUint32 returns the predeclared uint32 type.
func TypUint32() @Type

// TypUint64 returns the predeclared uint64 type.
func TypUint64() @Type

// TypFloat32 returns the predeclared float32 type.
func TypFloat32() @Type

// TypFloat64 returns the predeclared float64 type.
func TypFloat64() @Type

// TypBool returns the predeclared bool type.
func TypBool() @Type

// TypChar returns the predeclared char type.
func TypChar() @Type

// TypByte returns the predeclared byte type (alias for uint8).
func TypByte() @Type

// TypVoid returns the predeclared void type.
func TypVoid() @Type

// TypNil returns the predeclared nil type.
func TypNil() @Type

// TypUntypedInt returns the untyped integer constant type.
func TypUntypedInt() @Type

// TypUntypedFloat returns the untyped float constant type.
func TypUntypedFloat() @Type

// ============================================================
// Type Construction
// ============================================================

// MakePointerType creates a raw pointer type (*elem).
func MakePointerType(elem @Type) @Type

// MakeManagedPtrType creates a managed pointer type (@elem).
func MakeManagedPtrType(elem @Type) @Type

// MakeSliceType creates a raw slice type (*[]elem).
func MakeSliceType(elem @Type) @Type

// MakeManagedSliceType creates a managed-slice type (@[]elem).
func MakeManagedSliceType(elem @Type) @Type

// MakeManagedSliceTypeUncached creates a managed-slice type (@[]elem) without
// the compile-time memoization -- for runtime callers (interp value marshaling)
// whose descriptor is value-scoped, not part of the per-compilation cache.
func MakeManagedSliceTypeUncached(elem @Type) @Type

// ResetWrapperInterning drops the per-element wrapper memoization, breaking the
// element<->wrapper reference cycles so a prior compilation's type graph is
// reclaimed.  NewChecker calls it at each compilation boundary; a caller that
// builds types WITHOUT a checker across many back-to-back builds (test runners,
// long-lived tooling) should call it at its own boundary.  Pure memoization —
// correctness never depends on it.  Precondition: no cached wrapper is held
// through a RAW (*Type) borrow.
func ResetWrapperInterning()

// MakeArrayType creates an array type ([length]elem).
func MakeArrayType(elem @Type, length int) @Type

// Utf8Bytes returns the UTF-8 encoding of BMP code point cp (0..0xFFFF,
// non-surrogate) as up to three bytes b0,b1,b2 plus the byte count n
// (1..3).  Shared with the IR literal decoders so `\u` escapes expand to
// the same bytes in both the natural-type length and the emitted data.
func Utf8Bytes(cp int) (char, char, char, int)

// ReinterpretBitCast returns v reinterpreted as the integer type t (the value a
// `bit_cast` to t produces: truncate + sign-extend to t's width).  Shared by
// the type checker's evalConstIntValue and IR-gen's evalConstExpr so a constant
// bit_cast folds to the identical value in both.
func ReinterpretBitCast(v int, t @Type) int

// ParseCharLit returns the integer (byte) value of a char literal's raw quoted
// text (`'A'`, `'\n'`, `'\x41'`).  The single shared char-literal decoder for
// both the checker (evalConstIntValue / cast-fit folding) and IR-gen, so they
// cannot drift on a char-literal const's value.  Escapes are validated
// separately (checkCharLitEscapes / validateEscapes); a malformed literal is
// decoded defensively.
func ParseCharLit(s *[]readonly char) int

// MakeStructType creates a struct type with the given name and fields.
func MakeStructType(name @[]char, fields @[]@Field) @Type

// MakeFuncType creates a function type with the given parameters and results.
func MakeFuncType(params @[]@Param, results @[]@Type) @Type

// MakeFuncValueType creates a raw function-value type (*func(args) ret).
// The 2-word {vtable, data} layout is uniform across signatures; the
// signature shows up only in vtable type generation downstream.
func MakeFuncValueType(params @[]@Param, results @[]@Type) @Type

// MakeManagedFuncValueType creates a managed function-value type
// (@func(args) ret). Same layout as MakeFuncValueType; the data
// pointer is refcounted.
func MakeManagedFuncValueType(params @[]@Param, results @[]@Type) @Type

// MakeNamedType creates a named (distinct) type with no underlying type set yet.
func MakeNamedType(name @[]char) @Type

// MakeAliasType creates a type alias that resolves to target.
func MakeAliasType(name @[]char, target @Type) @Type

// MakeInterfaceType creates a declared-interface type with no methods set,
// keyed by its defining package's short name. (Pkg, Name) is the canonical
// identity used by implCoversInterface so cross-package iface refs that
// share a Name don't false-match.
// yet. The Methods table is populated via AddMethod during type-checker
// pass-1 collection.
func MakeInterfaceType(pkg @[]char, name @[]char) @Type

// MakeInterfaceValueType wraps a TYP_INTERFACE in a raw interface-value
// type (`*Iface`). Layout is 2-word {data, vtable} (16 bytes), uniform
// across interfaces — the interface shows up only in vtable selection
// and method-dispatch checks downstream. The wrapped interface is
// stored as t.Elem.
func MakeInterfaceValueType(iface @Type) @Type

// MakeManagedInterfaceValueType wraps a TYP_INTERFACE in a managed
// interface-value type (`@Iface`). Same 2-word layout as
// MakeInterfaceValueType; the data pointer is refcounted.
func MakeManagedInterfaceValueType(iface @Type) @Type

// LookupMethod returns the method named `name` on the named type t, or
// nil if no such method is registered.
func (t @Type) LookupMethod(name *[]readonly char) @Method

// ReceiverBaseNamed unwraps a receiver type's outer pointer/managed/const
// wrappers and returns the underlying named type, or nil if the receiver
// is not (a wrapper around) a named type.
func (t @Type) ReceiverBaseNamed() @Type

// MakeReadonlyType wraps inner with the const type modifier.
func MakeReadonlyType(inner @Type) @Type

// IsReadonly reports whether t has the const modifier at its
// outermost level (after stripping aliases).
func (t @Type) IsReadonly() bool

// StripReadonly returns the inner type, peeling one const wrapper.
// Returns t unchanged if t is not const at the outermost level.
func (t @Type) StripReadonly() @Type

// ============================================================
// Type Queries
// ============================================================

// TypeName returns a human-readable name for the type.
func (t @Type) TypeName() @[]char

// QualifiedTypeName returns the FULLY-QUALIFIED name (a named struct keeps its
// path-dotted prefix), used for mangling and cross-package identity — and for
// the per-type RTTI record's name field, where an unambiguous, canonical,
// TU-invariant name is wanted.
func (t @Type) QualifiedTypeName() @[]char

// IsInteger reports whether t is an integer type.
func (t @Type) IsInteger() bool

// IsFloat reports whether t is a floating-point type.
func (t @Type) IsFloat() bool

// IsNumeric reports whether t is a numeric type.
func (t @Type) IsNumeric() bool

// SignedMinForWidth returns the most-negative value of a signed integer
// of the given bit width as a 64-bit pattern (widths >= 64 saturate at
// the int64 minimum). Used by the DivCheck signed MIN / -1 overflow guard.
func SignedMinForWidth(width int) int64

// IsBool reports whether t is a boolean type.
func (t @Type) IsBool() bool

// IsByvalParam reports whether a parameter of type t is passed via the
// >16-byte indirect (`ptr byval`) convention; the single predicate IR-gen
// and codegen share so their two halves of that lowering agree.
func (t @Type) IsByvalParam() bool

// Identical reports whether types a and b are structurally identical.
func (a @Type) Identical(b @Type) bool

// ResolveAlias follows alias chains and returns the underlying type.
func (t @Type) ResolveAlias() @Type

// ResolveAliasAndConst follows both alias AND const/readonly wrappers to the
// underlying shape — like ResolveAlias but also seeing through readonly, the
// right peel for logic to which readonly is transparent (destruction, dtor/copy
// element-name mangling).
func (t @Type) ResolveAliasAndConst() @Type

// SliceElem returns the element type of a slice or managed-slice type.
func (t @Type) SliceElem() @Type

// FieldByName looks up a struct field by name, returning nil if not found.
func (t @Type) FieldByName(name *[]readonly char) @Field

// NeedsDestruction reports whether t contains managed pointers requiring cleanup.
func (t @Type) NeedsDestruction() bool

// ============================================================
// Type Layout
// ============================================================

// TargetInfo describes the target platform's basic properties.
type TargetInfo struct {
	PointerSize int // 4 or 8
	IntSize     int // typically == PointerSize
	MaxAlign    int // typically == PointerSize
	// BigEndian records the target byte order (§7.13.12: implementation-
	// defined, fixed per target).  false = little-endian — the ONLY order the
	// implementation supports; SetTarget rejects a big-endian target.
	BigEndian bool
	// Arch identifies the target CPU architecture (an ARCH_* member).  aa64
	// and x64 are both LP64, so PointerSize/IntSize/MaxAlign cannot tell them
	// apart; Arch is the discriminator that per-target ABI classification
	// (e.g. HfaInSimd) needs.  ARCH_UNKNOWN (the zero value) means no target
	// was configured — treated conservatively (no arch-specific ABI form).
	Arch int
	// FloatABI selects the floating-point calling convention (a FLOAT_ABI_*
	// member).  Arch alone cannot discriminate it: arm32-baremetal (soft) and
	// arm32-linux (hard, VFP) are both ARCH_ARM32, so the float ABI is a
	// separate axis (like aa64's Linux-vs-Darwin variant is kept off Arch).
	// FLOAT_ABI_DEFAULT (the zero value) is treated as soft — the gate
	// Arm32HardFloat() tests == FLOAT_ABI_HARD, so an unstamped target is soft.
	FloatABI int
}

// Target CPU architectures for TargetInfo.Arch.  ARCH_UNKNOWN is the zero
// value, meaning no target has been configured (SetArch not called); SetArch
// stamps a concrete arch.
const (
	ARCH_UNKNOWN int = iota
	ARCH_AA64
	ARCH_X64
	ARCH_ARM32
)

// Floating-point calling conventions for TargetInfo.FloatABI.
// FLOAT_ABI_DEFAULT is the zero value and is treated as soft (floats ride the
// GP registers / AEABI libcalls); FLOAT_ABI_HARD selects AAPCS-VFP (floats in
// the VFP register file).  FLOAT_ABI_SOFT is the explicit form of the default.
const (
	FLOAT_ABI_DEFAULT int = iota
	FLOAT_ABI_SOFT
	FLOAT_ABI_HARD
)

// SetTarget configures the target platform properties for layout computation.
func SetTarget(info TargetInfo)

// GetTarget returns the current target platform properties.
func GetTarget() TargetInfo

// SetArch stamps the target CPU architecture (an ARCH_* member) onto the
// current target, leaving the size/alignment fields untouched.  cmd/bnc calls
// it from applyTarget for every --target; code that never configures a target
// leaves Arch at ARCH_UNKNOWN.
func SetArch(a int)

// SetFloatABI stamps the floating-point calling convention (a FLOAT_ABI_*
// member) onto the current target, leaving other fields untouched.  Like
// SetArch it must be called AFTER any SetTarget (which resets every field);
// a target that never calls it leaves FloatABI at FLOAT_ABI_DEFAULT (soft).
func SetFloatABI(abi int)

// SizeOf computes the size in bytes of a value of type t.
func (t @Type) SizeOf() int

// AlignOf computes the alignment requirement in bytes of type t.
func (t @Type) AlignOf() int

// FieldOffset computes the byte offset of the field at the given index in a struct.
func (t @Type) FieldOffset(index int) int

// StripWrappers peels TYP_READONLY and TYP_NAMED wrappers to the representation
// type — an ABI / representation decision must see through them.
func StripWrappers(t @Type) @Type

// HfaClassify returns (memberCount, memberByteWidth) for an AAPCS64 Homogeneous
// Floating-point Aggregate — a struct/array of 1-4 same-type float members —
// else (0, 0).  memberByteWidth is 4 (float32 HFA) or 8 (float64 HFA).
func HfaClassify(t @Type) (int, int)

// HfaMemberCount returns the AAPCS64 HFA member count for t (1-4), else 0.
func HfaMemberCount(t @Type) int

// HfaInSimd reports whether Homogeneous Floating-point Aggregates are passed
// in SIMD/FP registers for the current target.  It is the SINGLE gate the LLVM
// backend (codegen) and the native backends both consult, so flipping it flips
// HFA passing in both halves of the toolchain in lockstep.  Currently false
// everywhere (HFAs are GP-coerced) while the cross-backend HFA work lands
// dormant.
func HfaInSimd() bool

// Eightbyte classes for SysVClassify (SysV-AMD64 register classification).
// EB_NONE is the zero value (a padding-only eightbyte); a classified aggregate
// yields only EB_SSE / EB_INTEGER entries.
const (
	EB_NONE int = iota
	EB_INTEGER
	EB_SSE
)

// SysVClassify returns the per-eightbyte class list (EB_INTEGER / EB_SSE) for a
// struct/array aggregate under SysV-AMD64, or empty when it is passed in MEMORY
// (> 16 bytes, empty, or not a struct/array).  Each 8-byte chunk is SSE (all
// float bytes) or INTEGER (any int/pointer byte).
func SysVClassify(t @Type) @[]int

// SysVSseInRegs reports whether SysV-AMD64 SSE-eightbyte aggregate passing is
// enabled for the current target — the x64 analogue of HfaInSimd() and the
// SINGLE gate the LLVM backend and native x64 backend both consult.  Currently
// false (x64 float aggregates stay GP-coerced) while the x64 SSE work lands
// dormant.
func SysVSseInRegs() bool

// Arm32HardFloat reports whether the current target uses the arm32 hard-float
// (AAPCS-VFP) calling convention: Arch == ARCH_ARM32 && FloatABI ==
// FLOAT_ABI_HARD.  The single shared gate both the native arm32 backend and
// codegen's callConvForTarget() consult (via common.AAPCS32()), so the two
// halves move in lockstep — mirroring HfaInSimd() / SysVSseInRegs().  Tests
// == FLOAT_ABI_HARD (not != SOFT) so an unstamped target (FLOAT_ABI_DEFAULT)
// reads soft.  Currently false everywhere (no target is stamped HARD yet)
// while the hard-float backend lands.
func Arm32HardFloat() bool

// SysVInSse reports whether aggregate t rides SSE (XMM) registers under
// SysV-AMD64 for the current target: an AggInRegCoercedKind aggregate that
// classifies with at least one SSE eightbyte, when SysVSseInRegs() is on.  The
// x64 counterpart of hfaSimdAggregate; dormant while SysVSseInRegs() is false.
func SysVInSse(t @Type) bool

// SysVAggHasSse is the gate-free structural core of SysVInSse (drops the
// SysVSseInRegs() gate): an AggInRegCoercedKind aggregate that classifies with at
// least one SSE eightbyte.  The native backend gates on its own cc.SseAggregates
// field plus this, so the SSE arg/return accounting is unit-testable with the
// field forced on while the global gate stays dormant.
func SysVAggHasSse(t @Type) bool

// SysV eightbyte forms (the exact register/LLVM shape of one eightbyte, finer
// than SysVClassify's SSE-vs-INTEGER): SEB_FLOAT `float`, SEB_2FLOAT
// `<2 x float>`, SEB_DOUBLE `double`, and the INTEGER widths SEB_I8/I16/I32/I64.
// SEB_NONE is the zero value.  Match clang x86_64's per-eightbyte coerced type.
const (
	SEB_NONE int = iota
	SEB_FLOAT
	SEB_2FLOAT
	SEB_DOUBLE
	SEB_I8
	SEB_I16
	SEB_I32
	SEB_I64
)

// SysVNumEightbytes returns the number of eightbytes t occupies under SysV
// register passing (1 or 2), or 0 when not register-passed.  = len(SysVClassify).
func SysVNumEightbytes(t @Type) int

// SysVEightbyteForm returns the SEB_* form of eightbyte eb of aggregate t
// (SEB_NONE if out of range).  Drives the codegen coerced-type speller and the
// native x64 move-width choice.
func SysVEightbyteForm(t @Type, eb int) int

// SysVArgInMemory reports whether argument `idx` of the SysV-AMD64 argument
// sequence `argTypes` is a ≤16-byte aggregate passed WHOLLY in memory (the
// all-or-nothing straddle/overflow case), given the register budget consumed by
// args 0..idx-1.  `argTypes` must already include any synthetic leading entries
// the target uses (an sret buffer pointer, an interface-dispatch data pointer)
// so the register positions match the native x64 walk.  Kind-agnostic (struct /
// array / slice / iface-value / func-value); false for a >16-byte aggregate (it
// rides a single pointer, which cannot straddle) and for any in-register
// aggregate.  SysV-AMD64 specific — codegen calls it only for the x64 target so
// it can emit a true `byval` for the memory-class case, matching native + clang.
func SysVArgInMemory(argTypes @[]@Type, idx int) bool

// SysVArgInMemoryC is SysVArgInMemory for the C boundary (an OP_C_CALL argument
// sequence): a >16-byte aggregate is MEMORY class (bytes on the stack, consuming
// NO argument register) rather than Binate's internal indirect-pointer form (one
// GP register).  This shifts the register cursor, so a ≤16-byte aggregate that
// FOLLOWS a >16-byte one is classified against the correct remaining register
// file — matching clang's SysV-AMD64 lowering (which the C callee expects).
// Codegen routes an OP_C_CALL's argument classification here; every other
// call/param path uses SysVArgInMemory.
func SysVArgInMemoryC(argTypes @[]@Type, idx int) bool

// NeedsSret reports whether a result of type t is returned via a hidden sret
// pointer (too large for the return registers): > 16 bytes on LP64, > 4 on ILP32.
func NeedsSret(t @Type) bool

// AggInRegCoercedKind reports whether t is the KIND of aggregate the in-register-
// coerced ABI applies to: a NAMED struct or any array (an anonymous multi-return
// tuple is excluded).
func AggInRegCoercedKind(t @Type) bool

// AggRetCoerced reports whether a single result of type t is returned via the
// `[N x i64]` in-register-coerced ABI (a <= 16-byte named struct/array, NOT sret,
// including a <= 8-byte one).
func AggRetCoerced(t @Type) bool

// IsAggregateReturn reports whether a function with result list `results` returns
// via the retbuf (aggregate) shim shape: a multi-return, a coerced named
// struct/array (incl. <= 8 bytes), or a single result wider than one pointer.
func IsAggregateReturn(results @[]@Type) bool

// IsAggregateReturnTyp is the single-TYPE adapter over IsAggregateReturn for a
// non-multi result: whether a function whose sole result is `t` returns via the
// retbuf shim shape.  A nil type (or a 0-byte aggregate) is void-like (false),
// so a `struct{}` / `[0]T` result routes to the void/scalar shim — matching the
// LLVM shim and VM cross-mode dispatch.  The native backends classify by the
// single result type, so they enter the shared size/kind logic through this.
func IsAggregateReturnTyp(t @Type) bool

// IsAggregateReturnKind reports whether t, after StripWrappers, is a by-address
// aggregate KIND — struct / array / slice / managed-slice / func-value /
// iface-value (managed or raw).  This is the pure-KIND gate WITHOUT the
// size/retbuf threshold IsAggregateReturnTyp applies, so it matches the bytecode
// VM's BC_RETURN copy-back condition (pkg/binate/vm's isMultiWordField ||
// isVMAddressAggregate): the VM copies any aggregate-kind result back onto vm.SP
// regardless of size.  Used by IR-gen to decide OP_SP_RESTORE for a call result.
func IsAggregateReturnKind(t @Type) bool

// IsAggregateArg reports whether a parameter of type t is passed to the cross-mode
// / func-value shim as a POINTER to the aggregate (SizeOf > one target word: > 8
// on LP64, > 4 on ILP32) rather than as a value in one register slot — the
// arg-side mirror of IsAggregateReturn.
func IsAggregateArg(t @Type) bool

// ResultImageSize returns the NATURAL (un-rounded) byte size of the result image
// a function with result list `results` writes into a caller-sized retbuf, or 0
// for a scalar / void / 0-byte result.  Unlike AggregateReturnSize this is NOT
// rounded to 8, so a cross-mode copy into a caller's natural-typed retbuf uses
// this to avoid overrunning it.
func ResultImageSize(results @[]@Type) int

// AggregateReturnSize returns the retbuf byte size (ResultImageSize rounded up to
// N*8) for a function with result list `results`, or 0 when the result is a
// scalar (no retbuf) — a nonzero value is itself the aggregate discriminator.
func AggregateReturnSize(results @[]@Type) int

// FieldLayout describes one field's position in the physical struct layout.
type FieldLayout struct {
	FieldIndex    int
	Offset        int
	Size          int
	PaddingBefore int
}

// StructLayout computes the physical layout of all fields in a struct type.
func (t @Type) StructLayout() @[]FieldLayout

// TrailingPadding computes the number of padding bytes after the last field in a struct.
func (t @Type) TrailingPadding() int

// Slice field indices
const SLICE_FIELD_DATA int = 0

const SLICE_FIELD_LEN int = 1

// Managed-slice field indices
const MSLICE_FIELD_DATA int = 0

const MSLICE_FIELD_LEN int = 1

const MSLICE_FIELD_BACKING int = 2

const MSLICE_FIELD_BACKING_LEN int = 3

// SliceDataOffset returns the byte offset of the data pointer in a raw slice.
func SliceDataOffset() int

// ManagedHeaderSize returns the size in bytes of the managed allocation header.
func ManagedHeaderSize() int

// FuncValueVtableIndex returns the field index of the vtable in a func-value.
func FuncValueVtableIndex() int

// FuncValueDataIndex returns the field index of the data pointer in a func-value.
func FuncValueDataIndex() int

// FuncValueVtableCallPackedIndex returns the slot index of the packed-dispatch
// entry (call_packed) within a func-value vtable {dtor@0, call@1, call_packed@2}.
func FuncValueVtableCallPackedIndex() int

// IfaceValueDataIndex returns the field index of the data pointer in an iface-value.
func IfaceValueDataIndex() int

// IfaceValueVtableIndex returns the field index of the vtable in an iface-value.
func IfaceValueVtableIndex() int

// FuncValueVtableOffset returns the byte offset of the vtable pointer in a func-value.
func FuncValueVtableOffset() int

// FuncValueDataOffset returns the byte offset of the data pointer in a func-value.
func FuncValueDataOffset() int

// IfaceValueDataOffset returns the byte offset of the data pointer in an iface-value.
func IfaceValueDataOffset() int

// IfaceValueVtableOffset returns the byte offset of the vtable pointer in an iface-value.
func IfaceValueVtableOffset() int

// ============================================================
// Scope and Symbols
// ============================================================

const (
	SYM_VAR int = iota
	SYM_CONST
	SYM_TYPE
	SYM_FUNC
	SYM_PKG
	SYM_INTERFACE      // declared interface (not a value type). Only legal
	// in `*Iface` / `@Iface` type expressions, on the
	// LHS of an `impl T : Iface` decl, or as the
	// target of an interface alias.
)

// ============================================================
// Checker
// ============================================================

type CheckError struct {
	Pos token.Pos
	Msg @[]char
}

// PendingDecl is one parked declaration that couldn't fully
// resolve at first-check time because it referenced names not
// yet bound.  Held in Checker.Pending; the REPL driver retries
// each entry after every subsequent decl, removing those that
// now resolve cleanly.
//
// IotaIdx is the parked decl's position within its containing
// `const ( ... )` group, or -1 if the decl is a free top-level
// (not a group member).  Carried so RetryPendingDecls can
// restore c.Iota to the correct positional value before re-
// checking — iota's value is determined by member position,
// not by which other members are resolved first.  Groups are
// syntactic sugar; each member parks individually.
type PendingDecl struct {
	Decl         @ast.Decl
	MissingNames @[]@[]char
	IotaIdx      int
}

// charEq reports whether two char slices contain the same bytes.
func CharEq(a *[]readonly char, b *[]readonly char) bool

// ensureInit lazily initializes all predeclared type singletons on first use.
func EnsureInit()

// funcIsVariadic reports whether a func-kind type's final parameter is
// variadic (`name ...T`; func.variadic.decl).  Variadic-ness is carried on the
// LAST Param (Param.IsVariadic) rather than the func Type so it survives
// receiver-prepend/drop and per-param generic substitution.  It is part of a
// func signature's type identity (func.variadic.identity, spec §10.3), so every
// func-type equality/assignability comparison consults this helper.  A non-func
// type (empty Params) is not variadic.
func FuncIsVariadic(t @Type) bool

// hexDigitVal returns the numeric value (0..15) of an ASCII hex digit.
// The caller must have verified isHexDigit; a non-digit yields 0.
func HexDigitVal(c char) int

// namedIdentityName returns the path-qualified identity name of a named
// type.  For a named STRUCT it is the underlying struct's qualified Name
// (e.g. "pkg/foo.Box") — the TYP_NAMED wrapper's own Name is the bare leaf
// ("Box"), which would false-match a same-short-named struct from another
// package.  For a named non-struct distinct type (e.g. `type Celsius int`)
// the wrapper's Name is the bare leaf too, so it is qualified with the
// wrapper's defining package (`.Pkg`, stamped at type-decl finalization) —
// otherwise two same-short-named cross-package scalars (`red.T` / `blue.T`,
// each `type T int`) would false-match and wrongly inter-assign.  A wrapper
// with no defining package (`.Pkg` empty — REPL / synthetic) qualifies to its
// bare Name, preserving the prior behavior for those.
func NamedIdentityName(t @Type) @[]char

// peelNamedBounded follows a named-distinct type's Underlying chain (resolving
// any alias / readonly wrapper at each step) down to its base type, with a
// depth bound.  A CYCLIC named type — `type A B; type B A`, or self `type A A`
// — is rejected at definition by collectTypeDecl, but the bound guards the
// operand predicates here too: without it a cycle makes `==` (comparabilityKind)
// loop forever and `<` (IsNumeric → IsInteger / IsFloat) stack-overflow on a
// parseable-but-malformed input.  Returns the base type, or nil when the bound
// is exceeded (i.e. a cyclic type that slipped past the decl-time check).
func PeelNamedBounded(t @Type) @Type

// QualifyName returns the fully-qualified `pkgPath.name` used for a named
// struct's mangling and identity, mirroring IR-gen's buildQualName /
// qualifyForCurrentModule byte-for-byte.  Idempotent: a name already
// containing '.' is returned unchanged.  An empty pkgPath returns the
// bare name (the REPL / unit-test path before a package context is set,
// matching qualifyForCurrentModule's empty-module passthrough).
func QualifyName(pkgPath @[]char, name @[]char) @[]char

// resolveAliasAndConst follows both alias and const wrappers to get
// at the "shape" of a type — useful in predicates like IsInteger,
// IsSlice, etc. where `const T` should answer the same as `T`.
// Does NOT recurse into pointer/slice element types.
func ResolveAliasAndConst(t @Type) @Type

// untypedStringNaturalArray reconstructs the [N]readonly char array type an
// untyped string adopts in a context that needs a concrete array (comparison,
// indexing, a constant `len`).  N and the readonly-char element are carried on
// the untyped type.
func UntypedStringNaturalArray(t @Type) @Type

// Utf8ByteLen returns the number of UTF-8 bytes for code point cp (1..3).
// Mirrors Utf8Bytes's thresholds (locked by escape_test.bn).
func Utf8ByteLen(cp int) int

// Utf8Bytes returns the UTF-8 encoding of code point cp as up to three
// bytes (b0,b1,b2) plus the byte count n (1..3).  cp must be a valid
// scalar value in the BMP (0..0xFFFF, non-surrogate) — the only source is
// a four-hex-digit `\u` escape, so larger code points cannot arise.  The
// length thresholds here are mirrored by Utf8ByteLen and by
// string_lit.bn:unescapedStrLen; escape_test.bn locks them together.
func Utf8Bytes(cp int) (char, char, char, int)

// TypError returns the predeclared error-sentinel singleton (TYP_ERROR) —
// the type given to an expression whose type error was already reported, so
// downstream checks suppress follow-on diagnostics (see AssignableTo) without
// masking a legitimate "cannot assign void" (which keeps TYP_VOID).
func TypError() @Type

// TypSelf returns the predeclared singleton for the `Self` type
// placeholder.  Only meaningful inside interface method
// signatures; substituted away by substituteSelf when an
// implementing type is bound.
func TypSelf() @Type

// TypUntypedBool returns the predeclared singleton for an untyped
// boolean (e.g., the result of a comparison before context fixes it).
func TypUntypedBool() @Type
