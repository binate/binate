// Package abi is the C calling-convention classification of types, per target:
// how a value of a type is passed and returned — a homogeneous float aggregate in
// SIMD registers on AAPCS64, the SysV eightbyte classes on x64, arm32's soft- and
// hard-float conventions, aggregate results through a result buffer, and
// parameters over 16 bytes passed indirectly.  These are language-level ABI
// decisions every compiler backend and the VM's cross-mode boundary must agree
// on, so they live in this shared layer rather than in a backend.  The target is
// the one types.SetTarget configured (types.GetTarget).
package "pkg/binate/types/abi"

import "pkg/binate/types"

// IsByvalParam reports whether a parameter of type t is passed via the
// >16-byte indirect (`ptr byval`) convention; the single predicate IR-gen
// and codegen share so their two halves of that lowering agree.
func IsByvalParam(t @types.Type) bool

// HfaClassify returns (memberCount, memberByteWidth) for an AAPCS64 Homogeneous
// Floating-point Aggregate — a struct/array of 1-4 same-type float members —
// else (0, 0).  memberByteWidth is 4 (float32 HFA) or 8 (float64 HFA).
func HfaClassify(t @types.Type) (int, int)

// HfaMemberCount returns the AAPCS64 HFA member count for t (1-4), else 0.
func HfaMemberCount(t @types.Type) int

// HfaInFpRegs reports whether Homogeneous Floating-point Aggregates are passed
// in FP registers for the current target: AArch64 (AAPCS64) and arm32 hard-float
// (AAPCS-VFP).  It is the SINGLE gate the LLVM backend (codegen) and the native
// backends both consult, so it moves HFA passing in both halves of the toolchain
// in lockstep.  Elsewhere HFAs are GP-coerced.
func HfaInFpRegs() bool

// HfaGpView returns the GP view of an HFA aggregate t — `[n]uint32` (float32 members) or
// `[n]uint64` (float64 members), the same size and alignment — else t itself: the
// type an HFA is classified as where it rides the core registers / memory, as in a
// variadic call under AAPCS-VFP's base standard.
func HfaGpView(t @types.Type) @types.Type

// Eightbyte classes for SysVClassify (SysV-AMD64 register classification).
// EB_NONE is the zero value (a padding-only eightbyte); a classified aggregate
// yields only EB_SSE / EB_INTEGER entries.
const (
	EB_NONE int = iota
	EB_INTEGER
	EB_SSE
)

// SysVClassify returns the per-eightbyte class list (EB_INTEGER / EB_SSE) for a
// struct/array aggregate under SysV-AMD64, or empty when it is passed in MEMORY
// (> 16 bytes, empty, or not a struct/array).  Each 8-byte chunk is SSE (all
// float bytes) or INTEGER (any int/pointer byte).
func SysVClassify(t @types.Type) @[]int

// SysVSseInRegs reports whether SysV-AMD64 SSE-eightbyte aggregate passing is
// enabled for the current target — the x64 analogue of HfaInFpRegs() and the
// SINGLE gate the LLVM backend and native x64 backend both consult: true on
// x86-64.
func SysVSseInRegs() bool

// Arm32HardFloat reports whether the current target uses the arm32 hard-float
// (AAPCS-VFP) calling convention: Arch == ARCH_ARM32 && FloatABI ==
// FLOAT_ABI_HARD.  The single shared gate both the native arm32 backend and
// codegen's callConvForTarget() consult (via callconv.AAPCS32()), so the two
// halves move in lockstep — mirroring HfaInFpRegs() / SysVSseInRegs().  Tests
// == FLOAT_ABI_HARD (not != SOFT) so an unstamped target (FLOAT_ABI_DEFAULT)
// reads soft.  True for --target arm32-linux.
func Arm32HardFloat() bool

// SysVInSse reports whether aggregate t rides SSE (XMM) registers under
// SysV-AMD64 for the current target: an AggInRegCoercedKind aggregate that
// classifies with at least one SSE eightbyte, when SysVSseInRegs() is on.  The
// x64 counterpart of hfaFpRegsAggregate; dormant while SysVSseInRegs() is false.
func SysVInSse(t @types.Type) bool

// SysVAggHasSse is the gate-free structural core of SysVInSse (drops the
// SysVSseInRegs() gate): an AggInRegCoercedKind aggregate that classifies with at
// least one SSE eightbyte.  The native backend gates on its own cc.SseAggregates
// field plus this, so the SSE arg/return accounting is unit-testable with the
// field forced on while the global gate stays dormant.
func SysVAggHasSse(t @types.Type) bool

// SysV eightbyte forms (the exact register/LLVM shape of one eightbyte, finer
// than SysVClassify's SSE-vs-INTEGER): SEB_FLOAT `float`, SEB_2FLOAT
// `<2 x float>`, SEB_DOUBLE `double`, and the INTEGER widths SEB_I8/I16/I32/I64.
// SEB_NONE is the zero value.  Match clang x86_64's per-eightbyte coerced type.
const (
	SEB_NONE int = iota
	SEB_FLOAT           // one f32 (4 bytes)      -> LLVM `float`
	SEB_2FLOAT          // two packed f32 (8 b)   -> LLVM `<2 x float>`
	SEB_DOUBLE          // one f64 (8 bytes)      -> LLVM `double`
	SEB_I8              // 1-byte integer leaf    -> LLVM `i8`
	SEB_I16             // 2-byte integer leaf    -> LLVM `i16`
	SEB_I32             // 4-byte integer leaf    -> LLVM `i32`
	SEB_I64             // full/merged eightbyte  -> LLVM `i64`
)

// SysVNumEightbytes returns the number of eightbytes t occupies under SysV
// register passing (1 or 2), or 0 when not register-passed.  = len(SysVClassify).
func SysVNumEightbytes(t @types.Type) int

// SysVEightbyteForm returns the SEB_* form of eightbyte eb of aggregate t
// (SEB_NONE if out of range).  Drives the codegen coerced-type speller and the
// native x64 move-width choice.
func SysVEightbyteForm(t @types.Type, eb int) int

// SysVArgInMemory reports whether argument `idx` of the SysV-AMD64 argument
// sequence `argTypes` is a ≤16-byte aggregate passed WHOLLY in memory (the
// all-or-nothing straddle/overflow case), given the register budget consumed by
// args 0..idx-1.  `argTypes` must already include any synthetic leading entries
// the target uses (an sret buffer pointer, an interface-dispatch data pointer)
// so the register positions match the native x64 walk.  Kind-agnostic (struct /
// array / slice / iface-value / func-value); false for a >16-byte aggregate
// (MEMORY class too — on the stack, consuming no register — but passed through
// codegen's `byval` path rather than as a straddle) and for any in-register
// aggregate.  SysV-AMD64 specific — codegen calls it only for the x64 target so
// it can emit a true `byval` for the memory-class case, matching native + clang.
func SysVArgInMemory(argTypes @[]@types.Type, idx int) bool

// Aapcs64ArgGpStart returns the general-purpose argument register (0..7) argument
// `idx` of the AAPCS64 argument list `argTypes` starts in, or -1 when it takes none —
// a float scalar or HFA (SIMD registers), or an argument that goes to the stack.  An
// aggregate is never split: one that does not fit the registers left goes wholly to
// the stack, and no later argument takes a register (AAPCS64 C.13).  An sret pointer
// rides x8, so it is not in `argTypes`.  An empty aggregate takes no register but
// reports its position.
func Aapcs64ArgGpStart(argTypes @[]@types.Type, idx int) int

// Aapcs64ArgStraddles reports whether argument `idx` of `argTypes` (as for
// Aapcs64ArgGpStart) is a two-word general-purpose aggregate arriving with exactly
// one argument register (x7) left — it goes wholly to the stack and x7 stays unused.
// Codegen consults it for the aarch64 target to keep a first-class aggregate
// (slice / iface-value / func-value), whose members LLVM would otherwise place one at
// a time, whole on the stack.
func Aapcs64ArgStraddles(argTypes @[]@types.Type, idx int) bool

// NeedsSret reports whether a result of type t is returned via a hidden sret
// pointer (too large for the return registers): > 16 bytes on LP64, > 4 on ILP32.
func NeedsSret(t @types.Type) bool

// AggInRegCoercedKind reports whether t is the KIND of aggregate the in-register-
// coerced ABI applies to: a NAMED struct or any array (an anonymous multi-return
// tuple is excluded).
func AggInRegCoercedKind(t @types.Type) bool

// AggRetCoerced reports whether a single result of type t is returned via the
// `[N x i64]` in-register-coerced ABI (a <= 16-byte named struct/array, NOT sret,
// including a <= 8-byte one).
func AggRetCoerced(t @types.Type) bool

// IsAggregateReturn reports whether a function with result list `results` returns
// via the retbuf (aggregate) shim shape: a multi-return, a coerced named
// struct/array (incl. <= 8 bytes), or a single result wider than one pointer.
func IsAggregateReturn(results @[]@types.Type) bool

// IsAggregateReturnTyp is the single-TYPE adapter over IsAggregateReturn for a
// non-multi result: whether a function whose sole result is `t` returns via the
// retbuf shim shape.  A nil type (or a 0-byte aggregate) is void-like (false),
// so a `struct{}` / `[0]T` result routes to the void/scalar shim — matching the
// LLVM shim and VM cross-mode dispatch.  The native backends classify by the
// single result type, so they enter the shared size/kind logic through this.
func IsAggregateReturnTyp(t @types.Type) bool

// IsAggregateReturnKind reports whether t, after StripWrappers, is a by-address
// aggregate KIND — struct / array / slice / managed-slice / func-value /
// iface-value (managed or raw).  This is the pure-KIND gate WITHOUT the
// size/retbuf threshold IsAggregateReturnTyp applies, so it matches the bytecode
// VM's BC_RETURN copy-back condition (pkg/binate/vm's isMultiWordField ||
// isVMAddressAggregate): the VM copies any aggregate-kind result back onto vm.SP
// regardless of size.  Used by IR-gen to decide OP_SP_RESTORE for a call result.
func IsAggregateReturnKind(t @types.Type) bool

// IsAggregateArg reports whether a parameter of type t is passed to the cross-mode
// / func-value shim as a POINTER to the aggregate (SizeOf > one target word: > 8
// on LP64, > 4 on ILP32) rather than as a value in one register slot — the
// arg-side mirror of IsAggregateReturn.
func IsAggregateArg(t @types.Type) bool

// ResultImageSize returns the NATURAL (un-rounded) byte size of the result image
// a function with result list `results` writes into a caller-sized retbuf, or 0
// for a scalar / void / 0-byte result.  Unlike AggregateReturnSize this is NOT
// rounded to 8, so a cross-mode copy into a caller's natural-typed retbuf uses
// this to avoid overrunning it.
func ResultImageSize(results @[]@types.Type) int

// AggregateReturnSize returns the retbuf byte size (ResultImageSize rounded up to
// N*8) for a function with result list `results`, or 0 when the result is a
// scalar (no retbuf) — a nonzero value is itself the aggregate discriminator.
func AggregateReturnSize(results @[]@types.Type) int
