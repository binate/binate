package "pkg/binate/types/abi"

import "pkg/binate/types"

// IsByvalParam reports whether a parameter of type t is passed via the
// >16-byte indirect (LLVM `ptr byval(<T>)`) calling convention rather
// than as a register/struct value.  THE single source of truth for both
// halves of that lowering, which MUST agree or the emitted function won't
// compile: IR-gen (gen_func.bn) flags the param ref (IsByvalParamRef) so
// its store into the param's slot copies from the byval pointer (on
// aarch64 the slot is the incoming copy itself when that store is the
// param's only use — native/common.InPlaceParamSlots); codegen
// (emit_util.bn) renders the param type as `ptr` and spills each arg
// through a `.bv` slot at the call site.
// (Native backends ignore the IR flag; their spillIncomingParams handle
// byval params off the arg reg directly.)
//
// The transparent wrappers (alias / readonly / named) are peeled first —
// exactly as SizeOf does — so a `readonly Big` / named- or alias-wrapped
// aggregate is classified by its representation, not mis-read as a non-
// aggregate scalar (which would lower it by value and read garbage /
// SIGSEGV, or type-mismatch the two halves above).
//
// Threshold = 16 bytes — SysV-AMD64's AggregateInRegMax / MEMORY-class
// cutoff and AAPCS64's >16-byte indirect threshold (two register words).
// The size is target-aware via SizeOf (a 3-int struct is 24 B on LP64 but
// 12 B on ILP32); the 16-byte cutoff itself matches both LP64 ABIs.
func IsByvalParam(t @types.Type) bool {
	// An HFA aggregate passes in consecutive SIMD registers (v0..v3 on aa64),
	// never indirectly-by-pointer — even a >16-byte HFA (3x/4x f64) that would
	// otherwise exceed the threshold below.  See hfaSimdAggregate; aa64 only
	// (HfaInSimd).
	if hfaSimdAggregate(t) { return false }
	// Peel transparent wrappers (alias / const / named) to the
	// representation type.  StripWrappers caps the named-chain walk
	// (defense-in-depth against a cyclic named type that slips the
	// decl-time check), matching every other named-peeling predicate.
	t = types.StripWrappers(t)
	if t == nil {
		return false
	}
	var k int = t.Kind
	if k != types.TYP_STRUCT && k != types.TYP_ARRAY && k != types.TYP_SLICE &&
			k != types.TYP_MANAGED_SLICE && k != types.TYP_FUNC_VALUE && k != types.TYP_MANAGED_FUNC_VALUE &&
			k != types.TYP_INTERFACE_VALUE && k != types.TYP_INTERFACE_VALUE_MANAGED {
		return false
	}
	return t.SizeOf() > 16
}
