package "pkg/binate/types/abi"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Test helpers for the abi package's tests.

func fail(msg @[]char) testing.TestResult {
	// An empty message would read as a pass.
	if len(msg) == 0 { return "check failed (with an empty failure message)" }
	return msg
}

// setTarget32 configures a 4-byte pointer / int target with 4-byte alignment.
func setTarget32() {
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 4
	types.SetTarget(t)
}

// setTarget64 configures an 8-byte pointer / int target with 8-byte alignment.
func setTarget64() {
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	types.SetTarget(t)
}

// setTargetArm32 is the arm32 (AAPCS32) layout: 4-byte pointer / int, but
// MaxAlign 8 (int64 / float64 are double-word-aligned).
func setTargetArm32() {
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
}

// deepLevels is how deep the deep tests nest an aggregate: far deeper than a walk with
// one stack frame per level could go.  The deep tests release their aggregates a link at
// a time (dropAggLinks), as spec §18.2's note says to, and are skipped on the bare-metal
// and double-VM unit-test lanes (scripts/unittest/*.skip.*).
const deepLevels int = 200000

// deepAggChain returns n links over leaf, alternating from the innermost out a
// one-field struct and a one-element array: struct { f [1]struct { f [1]... leaf } }.
func deepAggChain(n int, leaf @types.Type) @types.Type {
	var t @types.Type = leaf
	for i := 0; i < n; i++ {
		if i % 2 == 0 {
			t = hfaStruct("S", hfaTypes1(t))
		} else {
			t = types.MakeArrayType(t, 1)
		}
	}
	return t
}

// aggLinkChild returns what a link of deepAggChain holds.
func aggLinkChild(t @types.Type) @types.Type {
	if t.Kind == types.TYP_STRUCT { return t.Fields[0].Type }
	return t.Elem
}

// dropAggLinks releases the top n links of the chain *p, one at a time, leaving what is
// under them in *p.  The caller's variable is the chain's only reference, so each link
// is freed as it is left and no destruction nests.
func dropAggLinks(p *@types.Type, n int) {
	for i := 0; i < n; i++ {
		*p = aggLinkChild(*p)
	}
}
