package "pkg/binate/types/abi"

import "pkg/binate/types"

// HFA (Homogeneous Floating-point Aggregate) classification.  A struct/array
// folding to 1-4 members ALL the same float type is passed in SIMD registers
// under AAPCS64 (v0..v7); x64 SysV uses a different eightbyte-SSE rule layered on
// top.  Whether an aggregate is an HFA is a language-level ABI decision shared by
// every compiler backend (codegen/LLVM, the native backends) and consulted at the
// cross-backend boundary, so it lives in this shared package per
// explorations/ir-backend-guidelines.md (and must stay BUILDER-compilable).  This
// is the AAPCS64 fold (1-4 same-width float members); the x64 eightbyte rule is a
// separate per-target classification.

// hfaFold folds a composite into (memberCount, memberWidth): memberWidth is the
// shared float width (32 or 64) if every leaf is that float type, or -1 if any
// leaf is a non-float / the leaves mix widths (disqualifying).  A bare float is
// (1, width); an empty aggregate is (0, -1).  Nested structs/arrays are folded
// flat; any non-float leaf, a mixed float width, or >4 members disqualifies.
func hfaFold(t @types.Type) (int, int) {
	t = types.StripWrappers(t)
	if t == nil { return 0, -1 }
	if t.Kind == types.TYP_FLOAT { return 1, t.Width }
	if t.Kind == types.TYP_STRUCT {
		var total int = 0
		var w int = 0
		for i := 0; i < len(t.Fields); i++ {
			cn, cw := hfaFold(t.Fields[i].Type)
			if cn == 0 || cw < 0 { return total + cn, -1 }
			if w == 0 { w = cw } else if w != cw { return total + cn, -1 }
			total = total + cn
			if total > 4 { return total, w }
		}
		if total == 0 { return 0, -1 }
		return total, w
	}
	if t.Kind == types.TYP_ARRAY {
		if t.Elem == nil { return 0, -1 }
		var esz int = t.Elem.SizeOf()
		if esz <= 0 { return 0, -1 }
		var alen int = t.SizeOf() / esz
		cn, cw := hfaFold(t.Elem)
		if cn == 0 || cw < 0 || alen <= 0 { return 0, -1 }
		return cn * alen, cw
	}
	return 0, -1
}

// HfaClassify returns (memberCount, memberByteWidth) for an AAPCS64 Homogeneous
// Floating-point Aggregate — 1-4 same-type float members — else (0, 0).
// memberByteWidth is 4 (a float32 HFA) or 8 (a float64 HFA).  Backend emitters
// place/read the members in memberCount consecutive FP registers of
// memberByteWidth each.
func HfaClassify(t @types.Type) (int, int) {
	n, w := hfaFold(t)
	if n >= 1 && n <= 4 && w > 0 { return n, w / 8 }
	return 0, 0
}

// HfaMemberCount returns the AAPCS64 HFA member count for t (1-4), else 0.
func HfaMemberCount(t @types.Type) int {
	n, _ := HfaClassify(t)
	return n
}

// HfaInFpRegs reports whether HFAs are passed in FP registers for the current
// target.  It is the single gate that keeps the LLVM backend and the native
// backends agreeing on HFA passing (see the .bni contract).  Enabled for AArch64
// (AAPCS64: v0..v7, returned in v0..v3) and arm32 hard-float (AAPCS-VFP: one
// co-processor register candidate in s0..s15 / d0..d7, returned in s0..s3 /
// d0..d3): the LLVM backend emits `[N x float]` / `[N x double]`, the native
// backends place / read the members in FP registers, and the dispatch shims
// (func-value / closure / interface, incl. the stack-spill path) marshal them
// identically.  x64 SysV eightbyte-SSE passing is a separate per-target rule.
func HfaInFpRegs() bool {
	return types.GetTarget().Arch == types.ARCH_AA64 || Arm32HardFloat()
}

// HfaGpView returns the GP view of t when t is an HFA aggregate (a named struct or
// array, AggInRegCoercedKind — not a bare float, which folds as a one-member HFA) —
// `[n]uint32` for n float32 members, `[n]uint64` for n float64 members (same size
// and alignment, no float members) — else t itself.  AAPCS-VFP passes and returns
// every argument of a variadic call by the base standard, where an HFA is an ordinary
// composite in the core registers / memory; classifying the GP view gives exactly that
// placement.
func HfaGpView(t @types.Type) @types.Type {
	if !AggInRegCoercedKind(t) { return t }
	n, memberBytes := HfaClassify(t)
	if n > 0 && memberBytes == 4 { return types.MakeArrayType(types.TypUint32(), cast(int64, n)) }
	if n > 0 { return types.MakeArrayType(types.TypUint64(), cast(int64, n)) }
	return t
}

// hfaFpRegsAggregate reports whether t is an AGGREGATE (a named struct or array —
// NOT the anonymous multi-return tuple, per AggInRegCoercedKind) passed and
// returned as an HFA in FP registers for the current target: HfaInFpRegs() is on
// AND t folds to a 1-4 same-width-float HFA.  This is the EXACT set codegen
// SIMD-coerces (aggParamCoerced/aggRetCoerced gate on AggInRegCoercedKind and
// aggCoerceLLTy spells the SIMD form gated on HfaInFpRegs), so NeedsSret and
// IsByvalParam exempt precisely this set — a >16-byte HFA (3x/4x f64) must reach
// the SIMD-coerced path, not sret/byval.  A bare float scalar is excluded (it is
// already passed in an FP register with no coercion).  Always false where
// HfaInFpRegs() is false.
func hfaFpRegsAggregate(t @types.Type) bool {
	if !HfaInFpRegs() { return false }
	if !AggInRegCoercedKind(t) { return false }
	return HfaMemberCount(t) > 0
}
