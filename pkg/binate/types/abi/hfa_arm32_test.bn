package "pkg/binate/types/abi"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for HFAs on arm32 hard-float (AAPCS-VFP): HfaInFpRegs() is on there, so an HFA
// aggregate is exempt from the sret / byval GP paths at any size, like on aa64, while
// arm32 soft-float keeps it a plain aggregate; HfaGpView gives the GP view a variadic
// call classifies it as; the cross-mode dispatch seam predicates are unaffected.

// stampArm32 sets the arm32 ILP32 layout and the given float ABI.
func stampArm32(floatABI int) {
	setTargetArm32()
	types.SetArch(types.ARCH_ARM32)
	types.SetFloatABI(floatABI)
}

// unstamp resets the arch and float ABI to their defaults.
func unstamp() {
	types.SetArch(types.ARCH_UNKNOWN)
	types.SetFloatABI(types.FLOAT_ABI_DEFAULT)
	setTarget64()
}

// The gate: on for arm32 hard-float, off for soft-float.  A 24-byte D3 and an 8-byte
// F2 (over the 4-byte ILP32 sret cutoff) are then never sret, and the D3 never byval,
// on hard-float; on soft-float both sret and the D3 is byval.
func TestHfaArm32HardFloatGate() testing.TestResult {
	var d3 @types.Type = hfaStruct("D3",
			hfaTypes3(types.TypFloat64(), types.TypFloat64(), types.TypFloat64()))
	var f2 @types.Type = hfaStruct("F2", hfaTypes2(types.TypFloat32(), types.TypFloat32()))
	stampArm32(types.FLOAT_ABI_HARD)
	var hardOn bool = HfaInFpRegs()
	var hardSret bool = NeedsSret(d3) || NeedsSret(f2)
	var hardByval bool = IsByvalParam(d3)
	stampArm32(types.FLOAT_ABI_SOFT)
	var softOn bool = HfaInFpRegs()
	var softSret bool = NeedsSret(d3) && NeedsSret(f2)
	var softByval bool = IsByvalParam(d3)
	unstamp()
	if !hardOn { return fail("HfaInFpRegs() must be true for arm32 hard-float") }
	if hardSret { return fail("an HFA must not sret on arm32 hard-float (s0.. / d0..)") }
	if hardByval { return fail("a 24-byte HFA must not be byval on arm32 hard-float") }
	if softOn { return fail("HfaInFpRegs() must be false for arm32 soft-float") }
	if !softSret { return fail("on soft-float the 24- and 8-byte HFAs sret (GP aggregates)") }
	if !softByval { return fail("on soft-float the 24-byte HFA is byval") }
	return ""
}

// HfaGpView: an HFA aggregate becomes the same-size array of its member width's
// unsigned integer; a bare float and a non-HFA aggregate stay as they are.
func TestHfaGpView() testing.TestResult {
	stampArm32(types.FLOAT_ABI_HARD)
	var f3 @types.Type = HfaGpView(
			hfaStruct("F3", hfaTypes3(types.TypFloat32(), types.TypFloat32(), types.TypFloat32())))
	var d2 @types.Type = HfaGpView(hfaStruct("D2", hfaTypes2(types.TypFloat64(), types.TypFloat64())))
	var f @types.Type = HfaGpView(types.TypFloat32())
	var mixed @types.Type = hfaStruct("M", hfaTypes2(types.TypFloat32(), types.TypInt32()))
	var mixedSelf bool = same(HfaGpView(mixed), mixed)
	var f3ok bool = f3.Kind == types.TYP_ARRAY && f3.ArrayLen == 3 && f3.SizeOf() == 12 &&
			f3.AlignOf() == 4 && HfaMemberCount(f3) == 0
	var d2ok bool = d2.Kind == types.TYP_ARRAY && d2.ArrayLen == 2 && d2.SizeOf() == 16 &&
			d2.AlignOf() == 8
	unstamp()
	if !f3ok {
		return fail("F3's GP view must be a 12-byte, 4-aligned [3]uint32 with no float members")
	}
	if !d2ok { return fail("D2's GP view must be a 16-byte, 8-aligned [2]uint64") }
	if f.Kind != types.TYP_FLOAT { return fail("a bare float32 has no GP view") }
	if !mixedSelf { return fail("a non-HFA aggregate is its own GP view") }
	return ""
}

// The cross-mode dispatch seam is float-ABI agnostic: an HFA is an aggregate argument
// and result there on arm32 hard-float as on soft-float (passed by address, returned
// through a retbuf of its size), whatever the native convention does with it.
func TestHfaArm32DispatchSeamUnchanged() testing.TestResult {
	var d2 @types.Type = hfaStruct("D2", hfaTypes2(types.TypFloat64(), types.TypFloat64()))
	var rs @[]@types.Type = make_slice(@types.Type, 1)
	rs[0] = d2
	stampArm32(types.FLOAT_ABI_HARD)
	var hard bool = IsAggregateArg(d2) && IsAggregateReturn(rs) && AggregateReturnSize(rs) == 16
	stampArm32(types.FLOAT_ABI_SOFT)
	var soft bool = IsAggregateArg(d2) && IsAggregateReturn(rs) && AggregateReturnSize(rs) == 16
	unstamp()
	if !hard || !soft { return fail("an HFA must be a 16-byte seam aggregate under both float ABIs") }
	return ""
}
