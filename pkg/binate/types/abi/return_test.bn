package "pkg/binate/types/abi"

import "pkg/binate/types"
import "pkg/builtins/testing"

// struct1 builds a named single-field struct of the given field type (a small
// named aggregate for the coerced-return tests).
func struct1(name @[]char, fieldTyp @types.Type) @types.Type {
	var fs @[]@types.Field = make_slice(@types.Field, 1)
	var fld @types.Field = make(types.Field)
	fld.Name = "f"
	fld.Type = fieldTyp
	fs[0] = fld
	return types.MakeStructType(name, fs)
}

// resultList builds a 1- or 2-element result list for the IsAggregateReturn /
// AggregateReturnSize tests.
func resultList1(a @types.Type) @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, 1)
	r[0] = a
	return r
}

func resultList2(a @types.Type, b @types.Type) @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, 2)
	r[0] = a
	r[1] = b
	return r
}

// NeedsSret: > 16 bytes on LP64 returns via sret; <= 16 does not.
func TestNeedsSretThreshold() testing.TestResult {
	setTarget64()
	var s8 @types.Type = struct1("S8", types.TypInt64()) // 8B
	var s24 @types.Type = types.MakeArrayType(types.TypInt64(), 3) // 24B
	if NeedsSret(s8) { return fail("8B struct must not need sret on LP64") }
	if !NeedsSret(s24) { return fail("24B aggregate must need sret on LP64") }
	if NeedsSret(types.TypInt64()) { return fail("scalar int64 must not need sret") }
	return ""
}

// AggInRegCoercedKind: named struct / array yes; anonymous struct (multi-return
// tuple) and scalars no.
func TestAggInRegCoercedKind() testing.TestResult {
	var named @types.Type = struct1("P", types.TypInt64())
	var anon @types.Type = struct1("", types.TypInt64())
	var arr @types.Type = types.MakeArrayType(types.TypUint8(), 4)
	if !AggInRegCoercedKind(named) { return fail("named struct is coerced-kind") }
	if AggInRegCoercedKind(anon) { return fail("anonymous (tuple) struct is NOT coerced-kind") }
	if !AggInRegCoercedKind(arr) { return fail("array is coerced-kind") }
	if AggInRegCoercedKind(types.TypInt64()) { return fail("scalar is not coerced-kind") }
	// Peels transparent wrappers.
	if !AggInRegCoercedKind(types.MakeReadonlyType(named)) {
		return fail("readonly named struct still coerced-kind")
	}
	return ""
}

// AggRetCoerced: a <= 16-byte named struct/array is coerced (incl. <= 8 bytes);
// a > 16 one is sret; a scalar is not.
func TestAggRetCoerced() testing.TestResult {
	setTarget64()
	var s8 @types.Type = struct1("S8", types.TypInt64()) // 8B named
	var s24 @types.Type = types.MakeArrayType(types.TypInt64(), 3) // 24B array (sret)
	if !AggRetCoerced(s8) { return fail("8B named struct is coerced-returned") }
	if AggRetCoerced(s24) { return fail("24B aggregate is sret, not coerced") }
	if AggRetCoerced(types.TypInt64()) { return fail("scalar is not coerced") }
	return ""
}

// IsAggregateReturn over a result list: empty / scalar / managed-ptr -> false;
// <= 8-byte named struct, any multi-return, and > word single result -> true.
func TestIsAggregateReturn() testing.TestResult {
	setTarget64()
	var none @[]@types.Type
	if IsAggregateReturn(none) { return fail("no results is scalar (void)") }
	if IsAggregateReturn(resultList1(types.TypInt64())) {
		return fail("single int64 is scalar")
	}
	if IsAggregateReturn(resultList1(types.MakePointerType(types.TypUint8()))) {
		return fail("single pointer is scalar")
	}
	if !IsAggregateReturn(resultList1(struct1("S8", types.TypInt64()))) {
		return fail("8B named struct return is aggregate")
	}
	if !IsAggregateReturn(resultList2(types.TypInt64(), types.TypInt64())) {
		return fail("multi-return is aggregate")
	}
	if !IsAggregateReturn(resultList2(types.TypUint8(), types.TypUint8())) {
		return fail("<=8B multi-return is STILL aggregate")
	}
	if !IsAggregateReturn(resultList1(types.MakeArrayType(types.TypInt64(), 3))) {
		return fail(">word single result is aggregate")
	}
	return ""
}

// chkAgg threads a running result: if prev already failed it passes through;
// otherwise it asserts IsAggregateArg(t) == want, returning msg on mismatch.
// Threading the result (rather than a per-check `if`) keeps the caller flat so
// it can restore the (global) target on every path — SetTarget is global.
func chkAgg(prev testing.TestResult, t @types.Type, want bool, msg @[]char) testing.TestResult {
	if len(prev) != 0 { return prev }
	if IsAggregateArg(t) != want { return fail(msg) }
	return ""
}

// IsAggregateArg: an aggregate-KIND type (slice / managed-slice / struct / array
// / func-value / iface-value) wider than one target word is passed to the shim
// by address; scalars and pointers never are, even an 8-byte scalar on ILP32
// (the discriminating case the KIND gate exists for).  Transparent wrappers
// (alias / readonly / named) over an aggregate are seen through.
func TestIsAggregateArgKindGated() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	// `type AliasMS = @[]char`: an alias over a managed-slice must classify by
	// its representation, NOT as the bare TYP_ALIAS (else a func-value param of
	// this type is misclassified scalar, a shim/VM ABI disagreement).
	var aliasMS @types.Type = types.MakeAliasType("AliasMS",
			types.MakeManagedSliceType(types.TypChar()))
	var fvTyp @types.Type = types.MakeFuncValueType(make_slice(@types.Param, 0),
			make_slice(@types.Type, 0))
	var slice @types.Type = types.MakeSliceType(types.TypUint8())
	var mslice @types.Type = types.MakeManagedSliceType(types.TypUint8())
	var ptr @types.Type = types.MakePointerType(types.TypUint8())

	// LP64: word is 8, so no scalar reaches the > threshold anyway.
	setTarget64()
	var r testing.TestResult = ""
	r = chkAgg(r, slice, true, "LP64: 16B slice is agg arg")
	r = chkAgg(r, mslice, true, "LP64: 32B managed-slice is agg arg")
	r = chkAgg(r, aliasMS, true, "LP64: alias-over-mslice is agg arg (alias-transparent)")
	r = chkAgg(r, fvTyp, true, "LP64: 16B func-value is agg arg")
	r = chkAgg(r, types.TypInt64(), false, "LP64: int64 scalar is not agg arg")
	r = chkAgg(r, struct1("S8", types.TypInt64()), false, "LP64: 8B struct not wider than 8B word")
	r = chkAgg(r, types.MakeArrayType(types.TypInt64(), 3), true, "LP64: 24B array is agg arg")

	// ILP32: word is 4, so an 8-byte SCALAR (int64 / float64) is > word but must
	// STILL be scalar; the KIND gate is what keeps the shim's float path an
	// int/float slot instead of an i8* (its `bitcast i64 %a to double` would
	// otherwise fail to compile).
	setTarget32()
	r = chkAgg(r, slice, true, "ILP32: 8B slice (2 words) IS agg arg (the fix)")
	r = chkAgg(r, mslice, true, "ILP32: 16B managed-slice is agg arg")
	r = chkAgg(r, aliasMS, true, "ILP32: alias-over-mslice is agg arg (alias-transparent)")
	r = chkAgg(r, fvTyp, true, "ILP32: 8B func-value (2 words) is agg arg")
	r = chkAgg(r, types.TypInt64(), false, "ILP32: int64 is an 8B SCALAR, not agg arg (kind gate)")
	r = chkAgg(r, types.TypFloat64(), false, "ILP32: float64 is an 8B SCALAR, not agg arg")
	r = chkAgg(r, ptr, false, "ILP32: 4B pointer is not agg arg")
	r = chkAgg(r, types.MakeArrayType(types.TypUint8(), 4), false,
			"ILP32: 4B array is one word, not wider")

	types.SetTarget(saved)
	return r
}

// On ILP32 (AAPCS32) the sret threshold is one word (4 bytes), so a bare 64-bit
// SCALAR (int64 / float64, SizeOf 8) would exceed it — but a scalar is NEVER
// sret (int64 returns in the r0:r1 pair).  The aggregate-KIND gate keeps scalars
// out of sret while an aggregate > 4 bytes still sret's.  Without the gate a
// native-caller -> LLVM-callee int64 return wedges on arm32 (the LLVM callee
// expects an sret retbuf pointer the native caller never passes).  These assert
// under setTarget32 — under setTarget64 a size-only test gives the same answer
// (8 < 16) and would mask the bug.
func TestNeedsSretIlp32ScalarGate() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	setTarget32()
	var r testing.TestResult = ""
	if NeedsSret(types.TypInt64()) {
		r = fail("ILP32: int64 scalar must NOT sret (returns in the r0:r1 pair)")
	}
	if len(r) == 0 && NeedsSret(types.TypFloat64()) {
		r = fail("ILP32: float64 scalar must NOT sret")
	}
	if len(r) == 0 && NeedsSret(types.MakePointerType(types.TypUint8())) {
		r = fail("ILP32: pointer must NOT sret")
	}
	if len(r) == 0 && !NeedsSret(struct1("S8", types.TypInt64())) {
		r = fail("ILP32: 8B aggregate (> 4) must still sret")
	}
	if len(r) == 0 && NeedsSret(struct1("S4", types.TypInt32())) {
		r = fail("ILP32: 4B aggregate (not > 4) must NOT sret")
	}
	types.SetTarget(saved)
	return r
}

// IsAggregateReturn's single-result branch must likewise NOT flag a bare 64-bit
// scalar as an aggregate return on ILP32 (it returns in the r0:r1 pair, not via
// the retbuf shim) — the trailing SizeOf>word check is kind-gated.  An aggregate
// result (struct > word, slice) still IS an aggregate return.
func TestIsAggregateReturnIlp32ScalarGate() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	setTarget32()
	var r testing.TestResult = ""
	if IsAggregateReturn(resultList1(types.TypInt64())) {
		r = fail("ILP32: single int64 result is a pair return, not aggregate")
	}
	if len(r) == 0 && IsAggregateReturn(resultList1(types.TypFloat64())) {
		r = fail("ILP32: single float64 result is not an aggregate return")
	}
	if len(r) == 0 && !IsAggregateReturn(resultList1(struct1("S8", types.TypInt64()))) {
		r = fail("ILP32: 8B struct result IS an aggregate return")
	}
	if len(r) == 0 && !IsAggregateReturn(resultList1(types.MakeSliceType(types.TypUint8()))) {
		r = fail("ILP32: slice result IS an aggregate return")
	}
	types.SetTarget(saved)
	return r
}

// AggregateReturnSize: 0 for scalars; the retbuf byte size ROUNDED UP to N*8 for
// aggregates (a 12-byte aggregate's shim writes 16 bytes).
func TestAggregateReturnSizeRoundsUp() testing.TestResult {
	setTarget64()
	if AggregateReturnSize(resultList1(types.TypInt64())) != 0 {
		return fail("scalar return size is 0 (no retbuf)")
	}
	if AggregateReturnSize(resultList1(struct1("S8", types.TypInt64()))) != 8 {
		return fail("8B named struct retbuf is 8")
	}
	// 12-byte array: the retbuf rounds up to a whole number of 8-byte words,
	// so it must be 16.
	if AggregateReturnSize(resultList1(types.MakeArrayType(types.TypUint8(), 12))) != 16 {
		return fail("12B aggregate retbuf rounds up to 16")
	}
	// <=8B multi-return ({uint8,uint8} = 2B) rounds up to one word.
	if AggregateReturnSize(resultList2(types.TypUint8(), types.TypUint8())) != 8 {
		return fail("2B multi-return retbuf rounds up to 8")
	}
	if AggregateReturnSize(resultList2(types.TypInt64(), types.TypInt64())) != 16 {
		return fail("16B multi-return retbuf is 16")
	}
	return ""
}

// emptyStruct builds a 0-field named struct (a zero-size result / `struct{}`).
func emptyStruct(name @[]char) @types.Type {
	return types.MakeStructType(name, make_slice(@types.Field, 0))
}

// ResultImageSize is the NATURAL (un-rounded) result-image size — what a
// cross-mode aggregate copy must move into a caller-allocated retbuf sized to the
// natural type.  Critically it is NOT rounded to 8 like AggregateReturnSize: a
// 12-byte array is 12 here (16 there) and a 2-byte {u8,u8} tuple is 2 (8 there),
// so copying the rounded size would overrun the caller's natural-typed retbuf.
// 0 for a scalar / void / 0-byte result (no retbuf).
func TestResultImageSizeNatural() testing.TestResult {
	setTarget64()
	if ResultImageSize(resultList1(types.TypInt64())) != 0 {
		return fail("scalar return image size is 0 (no retbuf)")
	}
	// A 12-byte array: natural 12, NOT rounded up to 16 (that is
	// AggregateReturnSize's job for the VM's own 8-aligned retbufs).
	if ResultImageSize(resultList1(types.MakeArrayType(types.TypUint8(), 12))) != 12 {
		return fail("12B aggregate natural image size is 12 (un-rounded)")
	}
	if AggregateReturnSize(resultList1(types.MakeArrayType(types.TypUint8(), 12))) != 16 {
		return fail("AggregateReturnSize still rounds the same 12B aggregate to 16")
	}
	// A 2-byte {uint8,uint8} multi-return: natural 2, un-rounded.
	if ResultImageSize(resultList2(types.TypUint8(), types.TypUint8())) != 2 {
		return fail("2B multi-return natural image size is 2 (un-rounded)")
	}
	// A {int32,int32} tuple is a whole 8-byte word already (natural == rounded).
	if ResultImageSize(resultList2(types.TypInt32(), types.TypInt32())) != 8 {
		return fail("{int32,int32} natural image size is 8")
	}
	// An 8-byte named struct: already a whole word, so natural == rounded.
	if ResultImageSize(resultList1(struct1("S8", types.TypInt64()))) != 8 {
		return fail("8B named struct natural image size is 8")
	}
	// A 0-byte struct result is not an aggregate return: image size 0 (scalar
	// shim), aligning the VM's cross-mode dispatch with the compiled caller.
	if ResultImageSize(resultList1(emptyStruct("E0"))) != 0 {
		return fail("0-byte struct result image size is 0 (scalar shim)")
	}
	// A MULTI-return of all-zero-size fields is still an aggregate RETURN (a
	// compiled caller uses the retbuf shim shape unconditionally for len > 1) yet
	// its image is 0 bytes — so image size (a COPY size) must not be confused with
	// the retbuf-shape SELECTION discriminator (IsAggregateReturn).
	if !IsAggregateReturn(resultList2(emptyStruct("Ea"), emptyStruct("Eb"))) {
		return fail("an all-zero-size multi-return is still an aggregate return (retbuf shape)")
	}
	if ResultImageSize(resultList2(emptyStruct("Ea"), emptyStruct("Eb"))) != 0 {
		return fail("an all-zero-size multi-return has a 0-byte image (nothing to copy)")
	}
	return ""
}
