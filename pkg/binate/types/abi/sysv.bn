package "pkg/binate/types/abi"

import "pkg/binate/types"
import "pkg/std/vec"

// SysV-AMD64 (x86-64) eightbyte classification for aggregates passed in
// registers.  This is a DIFFERENT rule from the AAPCS64 HFA fold (hfa.bn):
// SysV classifies each 8-byte chunk ("eightbyte") of an aggregate as SSE (every
// field byte overlapping it is float) or INTEGER (any int/pointer byte in it),
// and passes each eightbyte in a register of its class (SSE -> XMM, INTEGER ->
// GP).  Homogeneity is NOT required — `{float,double}` is SSE+SSE, `{float,int}`
// is one INTEGER eightbyte — and an aggregate larger than two eightbytes (>16
// bytes) is passed in MEMORY (byval/sret), unlike aa64 which keeps 3-4 member
// HFAs in SIMD.  Whether an aggregate rides SSE registers is a language-level
// ABI decision shared by the LLVM backend and the native x64 backend, so it
// lives in this shared package per explorations/ir-backend-guidelines.md (and must
// stay BUILDER-compilable — the output is a flat @[]int).
//
// Verified against clang x86_64 (the reference ABI): sumF2(<2 x float>),
// sumD2(double,double), sumFD(float,double), sumFI(i64), sumD3(ptr byval).

// sysvLeaf is a scalar leaf of an aggregate: its byte offset from the aggregate's base,
// its size in bytes, and whether it is a float.
type sysvLeaf struct {
	off   int
	size  int
	float bool
}

// sysvPart is a part of an aggregate sysvListLeaves has still to take apart: its type,
// and its byte offset from the aggregate's base.
type sysvPart struct {
	t   @types.Type
	off int
}

// sysvParts holds the parts sysvListLeaves has still to take apart, the next one last.
var sysvParts @vec.Vec[sysvPart]

// sysvLeafList holds the leaves sysvListLeaves listed last; the next listing reuses it.
var sysvLeafList @vec.Vec[sysvLeaf]

// sysvListLeaves lists the scalar leaves of t -- through nested structs and arrays, at
// their byte offsets from t's base -- in field and element order, into sysvLeafList,
// which it returns.  A part whose type is nil, and an array of zero-size elements, has
// no leaves.  The parts are taken apart from sysvParts rather than by recursion, so an
// aggregate nested to any depth (a struct of one struct of one struct ...) is listed,
// in one layout query (so each struct is laid out once, not again for every level above
// it).
func sysvListLeaves(t @types.Type) @vec.Vec[sysvLeaf] {
	if sysvParts == nil { sysvParts = vec.New[sysvPart]() }
	if sysvLeafList == nil { sysvLeafList = vec.New[sysvLeaf]() }
	for sysvLeafList.Len() > 0 {
		_, _ = sysvLeafList.Pop()
	}
	types.BeginLayoutQuery()
	pushSysvPart(t, 0)
	for sysvParts.Len() > 0 {
		part, _ := sysvParts.Pop()
		var pt @types.Type = types.StripWrappers(part.t)
		if pt == nil { continue }
		if pt.Kind == types.TYP_STRUCT {
			for i := len(pt.Fields) - 1; i >= 0; i-- {
				pushSysvPart(pt.Fields[i].Type, part.off + boundedInt(pt.Offset(i)))
			}
		} else if pt.Kind == types.TYP_ARRAY {
			if pt.Elem == nil { continue }
			var esz int = boundedInt(pt.Elem.Size())
			if esz <= 0 { continue }
			for i := boundedInt(pt.ArrayLen) - 1; i >= 0; i-- {
				pushSysvPart(pt.Elem, part.off + i * esz)
			}
		} else {
			var leaf sysvLeaf
			leaf.off = part.off
			leaf.size = boundedInt(pt.Size())
			leaf.float = pt.Kind == types.TYP_FLOAT
			sysvLeafList.Push(leaf)
		}
	}
	types.EndLayoutQuery()
	return sysvLeafList
}

// pushSysvPart pushes the part of type t at byte offset off for sysvListLeaves.
func pushSysvPart(t @types.Type, off int) {
	var part sysvPart
	part.t = t
	part.off = off
	sysvParts.Push(part)
}

// sysvMarkNonFloat downgrades to EB_INTEGER every eightbyte that a non-float leaf of
// leaves overlaps.  Float leaves keep the eightbyte's initial EB_SSE.  The merge rule
// (SSE+INTEGER -> INTEGER) falls out of starting every eightbyte at EB_SSE and only
// ever downgrading.
func sysvMarkNonFloat(leaves @vec.Vec[sysvLeaf], classes @[]int) {
	for i := 0; i < leaves.Len(); i++ {
		var leaf sysvLeaf = leaves.Get(i)
		if leaf.float { continue }
		// A non-float scalar leaf (int / pointer / bool / char / slice word, ...):
		// mark every eightbyte its byte span overlaps as INTEGER.
		var sz int = leaf.size
		if sz < 1 { sz = 1 }
		var lo int = leaf.off / 8
		var hi int = (leaf.off + sz - 1) / 8
		for eb := lo; eb <= hi; eb++ {
			if eb >= 0 && eb < len(classes) {
				classes[eb] = EB_INTEGER
			}
		}
	}
}

// SysVClassify returns the per-eightbyte class list (EB_INTEGER / EB_SSE) for a
// struct/array aggregate under SysV-AMD64.  An empty result means the aggregate
// is passed in MEMORY (byval arg / sret return) — larger than two eightbytes (>16
// bytes), or not a struct/array — or, for a zero-size aggregate, in nothing (no
// register, no stack).  A ≤16-byte struct/array of nonzero size yields 1 or 2
// entries, one per eightbyte, each SSE (all float bytes) or INTEGER.
func SysVClassify(t @types.Type) @[]int {
	var empty @[]int = make_slice(int, 0)
	if t == nil { return empty }
	var pt @types.Type = types.StripWrappers(t)
	if pt == nil { return empty }
	if pt.Kind != types.TYP_STRUCT && pt.Kind != types.TYP_ARRAY {
		return empty
	}
	var sz int64 = pt.Size()
	if sz < 1 || sz > 16 {
		return empty
	}
	var nEb int = (boundedInt(sz) + 7) / 8
	var classes @[]int = make_slice(int, nEb)
	for i := 0; i < nEb; i++ {
		classes[i] = EB_SSE
	}
	sysvMarkNonFloat(sysvListLeaves(pt), classes)
	return classes
}

// SysVSseInRegs reports whether SysV-AMD64 SSE-eightbyte aggregate passing is
// enabled for the current target.  It is the x64 analogue of HfaInFpRegs(): the
// single gate the LLVM backend (codegen) and the native x64 backend both
// consult, so it keeps both halves agreeing on SSE passing.  Enabled for x64
// (SysV-AMD64): a ≤16-byte aggregate whose eightbytes classify SSE rides XMM
// (INTEGER eightbytes ride GP) — the LLVM backend emits the eightbyte-coerced
// type, the native x64 backend places/collects each eightbyte by class, and the
// dispatch shims (func-value / closure / interface, incl. the stack-spill path)
// + the VM cross-mode boundary all marshal them identically.  A >16-byte float
// aggregate still passes in MEMORY (byval/sret), unlike an aa64 HFA.
func SysVSseInRegs() bool {
	return types.GetTarget().Arch == types.ARCH_X64
}

// SysVInSse reports whether aggregate t is passed/returned in SSE (XMM)
// registers under SysV-AMD64 for the current target — an AggInRegCoercedKind
// aggregate (named struct / array, not the anonymous multi-return tuple) that
// classifies with at least one SSE eightbyte, when SysVSseInRegs() is on.  This
// is the x64 counterpart of hfaFpRegsAggregate: the exact set codegen SSE-coerces
// and that NeedsSret / IsByvalParam exempt from the GP paths — but NOT from
// MEMORY (a >16-byte float aggregate stays sret/byval on x64, unlike aa64).
// Always false off x64, where SysVSseInRegs() is false.
func SysVInSse(t @types.Type) bool {
	return SysVSseInRegs() && SysVAggHasSse(t)
}

// SysVAggHasSse is the GATE-FREE structural core of SysVInSse: t is an
// AggInRegCoercedKind aggregate that classifies with at least one SSE eightbyte,
// regardless of whether SysVSseInRegs() is on.  Codegen (LLVM-side) gates on the
// global via SysVInSse; the native backend gates on its own cc.SseAggregates
// field (= SysVSseInRegs() at ctor time) plus this structural check, so the two
// native predicates (arg + return placement) can be unit-tested with the field
// forced on under any target — the global predicate follows the target arch,
// which a unit test running on a non-x64 host would otherwise leave off.
func SysVAggHasSse(t @types.Type) bool {
	if !AggInRegCoercedKind(t) { return false }
	var cl @[]int = SysVClassify(t)
	for i := 0; i < len(cl); i++ {
		if cl[i] == EB_SSE { return true }
	}
	return false
}

// ------------------------------------------------------------
// Per-eightbyte FORM (the exact register/LLVM shape of one eightbyte)
// ------------------------------------------------------------
//
// SysVClassify says only SSE-vs-INTEGER per eightbyte; the LLVM backend and the
// native x64 backend also need the FORM — how many bytes an eightbyte carries
// and in what shape — to spell the coerced ABI type / choose the move width.
// This is a language-level ABI/layout fact (shared, so it lives in this
// package), verified against clang x86_64:
//   - SSE  : a lone f64 -> `double`; two packed f32 -> `<2 x float>`; a lone f32
//            (4-byte half, e.g. an f32 followed by padding, or the 4-byte tail of
//            a 12-byte aggregate) -> `float`.
//   - INTEGER: a SINGLE scalar leaf starting at the eightbyte base takes that
//            leaf's own width — char/bool -> i8, short -> i16, int -> i32,
//            long/pointer -> i64 (this is clang's getIntegerTypeAtOffset: it uses
//            the field, not the padded 8-byte span, so `{double,char}` is
//            `{double,i8}` not `{double,i64}`).  Any OTHER shape (two leaves, an
//            int+float merge, an array, a leaf not at the base) collapses to i64.
//
// The forms are the SEB_* enum (abi.bni), consumed by the codegen speller
// (form -> LLVM string) and by the native backend (form -> move width /
// register class).

// sysvFloatBits returns a bitmask of the float shapes among leaves that intersect the
// eightbyte at byte offset ebOff (relative to the aggregate base): bit 1 = an f64
// covering the eightbyte, bit 2 = an f32 in the low half [ebOff, ebOff+4), bit 4 = an
// f32 in the high half [ebOff+4, ebOff+8).  Under natural alignment a leaf never
// straddles the eightbyte boundary or a 4-byte half boundary, so each float contributes
// exactly one bit.
func sysvFloatBits(leaves @vec.Vec[sysvLeaf], ebOff int) int {
	var bits int = 0
	for i := 0; i < leaves.Len(); i++ {
		var leaf sysvLeaf = leaves.Get(i)
		if !leaf.float { continue }
		if leaf.off + leaf.size <= ebOff { continue }
		if leaf.off >= ebOff + 8 { continue }
		if leaf.size == 8 {
			bits = bits | 1
		} else if leaf.off - ebOff < 4 {
			bits = bits | 2
		} else {
			bits = bits | 4
		}
	}
	return bits
}

// sysvLeafCount returns the number of leaves (float or non-float) whose byte span
// intersects the eightbyte at byte offset ebOff.  Used to detect the clang "single
// clean leaf" case for INTEGER-eightbyte width.
func sysvLeafCount(leaves @vec.Vec[sysvLeaf], ebOff int) int {
	var c int = 0
	for i := 0; i < leaves.Len(); i++ {
		var leaf sysvLeaf = leaves.Get(i)
		var sz int = leaf.size
		if sz < 1 { sz = 1 }
		if leaf.off + sz > ebOff && leaf.off < ebOff + 8 { c = c + 1 }
	}
	return c
}

// sysvLeafWidthAtBase returns the byte width of the first of leaves, in field and
// element order, that STARTS exactly at byte offset ebOff and has a nonzero width (0 if
// none does).  Combined with a leaf count of 1, this is clang's single-field
// INTEGER-eightbyte width.
func sysvLeafWidthAtBase(leaves @vec.Vec[sysvLeaf], ebOff int) int {
	for i := 0; i < leaves.Len(); i++ {
		var leaf sysvLeaf = leaves.Get(i)
		if leaf.off == ebOff && leaf.size > 0 { return leaf.size }
	}
	return 0
}

// SysVNumEightbytes returns the number of eightbytes t occupies under SysV
// register passing (1 or 2), or 0 when t is not a register-passed aggregate
// (MEMORY / scalar / not a struct-array).  Equals len(SysVClassify(t)).
func SysVNumEightbytes(t @types.Type) int {
	return len(SysVClassify(t))
}

// SysVEightbyteForm returns the SEB_* form of eightbyte eb of aggregate t (see
// the form-enum comment above).  SEB_NONE if eb is out of range.  The form's ABI
// coercion (register class + width) matches clang x86_64 exactly for the shapes
// SysVInSse covers.  The one intentional TEXTUAL difference: a pointer eightbyte
// is SEB_I64 (`i64`), where clang spells `ptr` — register-identical (both INTEGER,
// 8 bytes, one GP register), so an `i64`-vs-`ptr` diff in an IR cross-check is
// expected, not a bug.
func SysVEightbyteForm(t @types.Type, eb int) int {
	var cl @[]int = SysVClassify(t)
	if eb < 0 || eb >= len(cl) { return SEB_NONE }
	var pt @types.Type = types.StripWrappers(t)
	if pt == nil { return SEB_NONE }
	var ebOff int = eb * 8
	var leaves @vec.Vec[sysvLeaf] = sysvListLeaves(pt)
	if cl[eb] == EB_SSE {
		var bits int = sysvFloatBits(leaves, ebOff)
		if (bits & 1) != 0 { return SEB_DOUBLE }
		if ((bits & 2) != 0) && ((bits & 4) != 0) { return SEB_2FLOAT }
		return SEB_FLOAT
	}
	// INTEGER: a single scalar leaf at the base takes its own width; any other
	// shape (multiple leaves, int+float merge, array, off-base leaf) is i64.
	if sysvLeafCount(leaves, ebOff) == 1 {
		var w int = sysvLeafWidthAtBase(leaves, ebOff)
		if w == 1 { return SEB_I8 }
		if w == 2 { return SEB_I16 }
		if w == 4 { return SEB_I32 }
		if w == 8 { return SEB_I64 }
	}
	return SEB_I64
}

// boundedInt narrows a size, offset or count within an aggregate a classifier has
// already bounded — a register candidate of at most 16 bytes — to int; a larger
// value reaching it is an internal error.
func boundedInt(v int64) int {
	if v < 0 || v > 64 {
		panic("internal error: an unbounded size or offset reached an ABI register classifier")
	}
	return cast(int, v)
}
