package "pkg/binate/types"

// ============================================================
// AAPCS64 general-purpose argument placement of aggregates
// ============================================================
//
// AAPCS64 never splits a composite argument between the general-purpose argument
// registers and the stack: an aggregate that does not fit the registers left goes
// wholly to the stack, and the next-register cursor (NGRN) is then set to 8, so no
// later argument takes a register either (stage C.13).  An HFA rides the SIMD
// registers instead, and a >16-byte aggregate is passed as a pointer to a copy (one
// register word), so the only aggregate that can meet the boundary is a ≤16-byte,
// two-word one arriving with exactly one register (x7) left.
//
// The native backend places arguments by this rule (callconv's AAPCS64 walk).  The
// LLVM backend passes a struct / array argument as `[N x i64]`, which AArch64 LLVM
// allocates whole (closing the registers when it does not fit), but a slice /
// iface-value / func-value as a first-class `{ptr, i64}` / `{ptr, ptr}`, whose
// members LLVM allocates one at a time — the first in x7, the second on the stack.
// Aapcs64ArgStraddles tells codegen where that happens, so it can occupy x7 with a
// dummy argument and keep the aggregate whole on the stack, as C places it.  The
// walk mirrors callconv's AAPCS64 arm; a cross-check unit test (native/callconv)
// pins the two to agree.

// aapcs64GpArgRegs is the AAPCS64 general-purpose argument-register count (x0..x7);
// it matches AAPCS64()'s NumGpArgRegs in native/callconv.
const aapcs64GpArgRegs int = 8

// aapcs64GpWords returns how many general-purpose argument registers an argument of
// type t needs: -1 for a float scalar or an HFA (SIMD registers, never a GP one), one
// for a scalar, a pointer or a >16-byte aggregate (a pointer to a copy), else the
// aggregate's 8-byte words (none for an empty one).
func aapcs64GpWords(t @Type) int {
	if sysvArgIsFloatScalar(t) { return -1 }
	if HfaMemberCount(t) > 0 { return -1 }
	if !sysvArgIsAggregate(t) { return 1 }
	var sz int = t.SizeOf()
	if sz > 16 { return 1 }
	return (sz + 7) / 8
}

// aapcs64NgrnBefore returns the NGRN in effect when argument idx of argTypes is
// placed: each earlier argument takes its words if they all fit, else NGRN becomes 8
// (C.13 — and a scalar arriving at 8 goes to the stack, leaving it there).
func aapcs64NgrnBefore(argTypes @[]@Type, idx int) int {
	var ngrn int = 0
	for k := 0; k < idx; k++ {
		var w int = aapcs64GpWords(argTypes[k])
		if w < 0 { continue }
		if ngrn + w <= aapcs64GpArgRegs {
			ngrn = ngrn + w
		} else {
			ngrn = aapcs64GpArgRegs
		}
	}
	return ngrn
}

// Aapcs64ArgGpStart returns the general-purpose argument register argument idx of
// argTypes (an AAPCS64 argument list; an sret pointer rides x8, not in the list)
// starts in, or -1 when it takes none (a float / HFA, or it goes to the stack).  An
// empty aggregate takes no register but reports its position, as the native walk
// does.
func Aapcs64ArgGpStart(argTypes @[]@Type, idx int) int {
	if idx < 0 || idx >= len(argTypes) { return -1 }
	var w int = aapcs64GpWords(argTypes[idx])
	if w < 0 { return -1 }
	var ngrn int = aapcs64NgrnBefore(argTypes, idx)
	if ngrn + w > aapcs64GpArgRegs { return -1 }
	return ngrn
}

// Aapcs64ArgStraddles reports whether argument idx of argTypes (as for
// Aapcs64ArgGpStart) is a two-word general-purpose aggregate arriving with exactly
// one argument register left: it goes wholly to the stack and that register stays
// unused.
func Aapcs64ArgStraddles(argTypes @[]@Type, idx int) bool {
	if idx < 0 || idx >= len(argTypes) { return false }
	if !sysvArgIsAggregate(argTypes[idx]) || aapcs64GpWords(argTypes[idx]) != 2 { return false }
	return aapcs64NgrnBefore(argTypes, idx) == aapcs64GpArgRegs - 1
}
