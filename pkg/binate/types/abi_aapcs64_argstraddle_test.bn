package "pkg/binate/types"

import "pkg/builtins/testing"

// Direct expected-value tests of Aapcs64ArgGpStart / Aapcs64ArgStraddles (the
// AAPCS64 GP placement of aggregates: never split, C.13).  The agreement with the
// native aarch64 walk is pinned separately by the cross-check test in
// pkg/binate/native/callconv.

// sevenI64Then builds [i64 x7, x, i64] so x lands at NGRN 7 (only x7 left), with a
// trailing scalar after it.
func sevenI64Then(x @Type) @[]@Type {
	var s @[]@Type = make_slice(@Type, 9)
	for i := 0; i < 7; i++ { s[i] = TypInt64() }
	s[7] = x
	s[8] = TypInt64()
	return s
}

// A two-word aggregate of any kind straddles at NGRN 7: it goes to the stack, and
// the trailing scalar follows it there (x7 stays unused).  A one-word aggregate
// still takes x7; a >16-byte one is a pointer in x7; an HFA rides SIMD registers.
func TestAapcs64ArgStraddlesKinds() testing.TestResult {
	setTarget64()
	SetArch(ARCH_AA64)
	defer SetArch(ARCH_UNKNOWN)
	var i64 @Type = TypInt64()
	var f64 @Type = TypFloat64()
	var slice @Type = MakeSliceType(i64)
	var iface @Type = MakeInterfaceValueType(MakeInterfaceType("m", "Iface"))
	var i2 @Type = hfaStruct("I2", twoTypes(i64, i64))
	var one @Type = hfaStruct("One", twoTypes(TypInt32(), TypInt32()))
	var big @Type = hfaStruct("Big24", threeTypes(i64, i64, i64))
	var hfa @Type = hfaStruct("F2", twoTypes(f64, f64))
	var mslice @Type = MakeManagedSliceType(i64)
	if !Aapcs64ArgStraddles(sevenI64Then(slice), 7) { return "a raw slice at NGRN 7 straddles" }
	if !Aapcs64ArgStraddles(sevenI64Then(iface), 7) { return "an iface value at NGRN 7 straddles" }
	if !Aapcs64ArgStraddles(sevenI64Then(i2), 7) { return "a 16-byte struct at NGRN 7 straddles" }
	if Aapcs64ArgGpStart(sevenI64Then(slice), 7) != -1 {
		return "a straddling slice takes no register"
	}
	if Aapcs64ArgGpStart(sevenI64Then(slice), 8) != -1 {
		return "the scalar after a straddling aggregate goes to the stack too (C.13)"
	}
	if Aapcs64ArgStraddles(sevenI64Then(one), 7) || Aapcs64ArgGpStart(sevenI64Then(one), 7) != 7 {
		return "an 8-byte struct takes x7"
	}
	if Aapcs64ArgStraddles(sevenI64Then(big), 7) || Aapcs64ArgGpStart(sevenI64Then(big), 7) != 7 {
		return "a >16-byte struct is a pointer in x7"
	}
	if Aapcs64ArgStraddles(sevenI64Then(mslice), 7) { return "a managed-slice is a pointer in x7" }
	if Aapcs64ArgStraddles(sevenI64Then(hfa), 7) || Aapcs64ArgGpStart(sevenI64Then(hfa), 8) != 7 {
		return "an HFA rides SIMD registers, leaving x7 to the next scalar"
	}
	return ""
}

// Floats and HFAs take no GP register, so they do not move the aggregate's position;
// an aggregate that fits the registers left takes them.
func TestAapcs64ArgGpStartCursor() testing.TestResult {
	setTarget64()
	SetArch(ARCH_AA64)
	defer SetArch(ARCH_UNKNOWN)
	var i64 @Type = TypInt64()
	var slice @Type = MakeSliceType(i64)
	var s @[]@Type = make_slice(@Type, 9)
	s[0] = TypFloat64()
	for i := 1; i < 7; i++ { s[i] = i64 }
	s[7] = slice
	s[8] = i64
	if Aapcs64ArgGpStart(s, 7) != 6 { return "a slice after one float and six ints starts at x6" }
	if Aapcs64ArgStraddles(s, 7) { return "it fits x6-x7, so it does not straddle" }
	if Aapcs64ArgGpStart(s, 8) != -1 { return "the next int finds the registers used up" }
	return ""
}
