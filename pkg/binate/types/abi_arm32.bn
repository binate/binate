package "pkg/binate/types"

// arm32 float-ABI gate.  arm32 has two calling conventions that share one Arch
// (ARCH_ARM32): baremetal is SOFT-float (floats ride the GP registers / AEABI
// libcalls) and arm32-linux (arm-linux-gnueabihf) is HARD-float (AAPCS-VFP,
// floats in the VFP register file).  Since Arch cannot tell them apart, the
// float ABI is a separate TargetInfo axis (FloatABI), and this single shared
// gate — consulted by BOTH the native arm32 backend and codegen's
// callConvForTarget() via common.AAPCS32() — keeps the two halves in lockstep,
// mirroring HfaInSimd() / SysVSseInRegs().  Lives in pkg/types (a language-level
// ABI decision shared across backends) and must stay BUILDER-compilable.

// Arm32HardFloat reports whether the current target uses arm32 hard-float
// (AAPCS-VFP).  Tests == FLOAT_ABI_HARD (not != FLOAT_ABI_SOFT) so an unstamped
// target (FLOAT_ABI_DEFAULT, the zero value) reads soft.  True for
// --target arm32-linux (cmd/bnc stamps FLOAT_ABI_HARD), false for
// arm32-baremetal and every non-arm32 target.
func Arm32HardFloat() bool {
	return GetTarget().Arch == ARCH_ARM32 && GetTarget().FloatABI == FLOAT_ABI_HARD
}
