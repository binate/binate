package "pkg/binate/types"

import "pkg/builtins/testing"

// Arm32HardFloat() is the shared arm32 float-ABI gate: true iff Arch ==
// ARCH_ARM32 AND FloatABI == FLOAT_ABI_HARD.  It must read soft for an
// unstamped target (FLOAT_ABI_DEFAULT), soft for an explicit SOFT stamp, hard
// only for an explicit HARD stamp on ARCH_ARM32, and never hard off arm32.
func TestArm32HardFloatGate() testing.TestResult {
	setTargetArm32()
	SetArch(ARCH_ARM32)
	// SetTarget (inside setTargetArm32) reset FloatABI to the zero value
	// (FLOAT_ABI_DEFAULT) — must read as soft.
	if Arm32HardFloat() {
		return fail("Arm32HardFloat() must be false for an unstamped (DEFAULT) arm32 target")
	}
	SetFloatABI(FLOAT_ABI_SOFT)
	if Arm32HardFloat() {
		return fail("Arm32HardFloat() must be false for an explicit SOFT arm32 target")
	}
	SetFloatABI(FLOAT_ABI_HARD)
	if !Arm32HardFloat() {
		return fail("Arm32HardFloat() must be true for a HARD arm32 target")
	}
	// A HARD stamp on a non-arm32 arch must NOT read hard (the gate requires
	// ARCH_ARM32) — guards against the field leaking onto aa64/x64.
	SetArch(ARCH_AA64)
	if Arm32HardFloat() {
		return fail("Arm32HardFloat() must be false off arm32 even when FloatABI == HARD")
	}
	setTarget64() // restore the LP64 default for subsequent tests
	return ""
}

// SetFloatABI round-trips through GetTarget().FloatABI and is reset by
// SetTarget (which zeroes the whole struct to FLOAT_ABI_DEFAULT).
func TestSetFloatABIRoundTrip() testing.TestResult {
	setTargetArm32()
	SetFloatABI(FLOAT_ABI_HARD)
	if GetTarget().FloatABI != FLOAT_ABI_HARD {
		return fail("SetFloatABI(HARD) must round-trip through GetTarget().FloatABI")
	}
	setTargetArm32() // SetTarget resets FloatABI to the zero value
	if GetTarget().FloatABI != FLOAT_ABI_DEFAULT {
		return fail("SetTarget must reset FloatABI to FLOAT_ABI_DEFAULT")
	}
	setTarget64()
	return ""
}
