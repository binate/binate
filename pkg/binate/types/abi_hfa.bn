package "pkg/binate/types"

// HFA (Homogeneous Floating-point Aggregate) classification.  A struct/array
// folding to 1-4 members ALL the same float type is passed in SIMD registers
// under AAPCS64 (v0..v7); x64 SysV uses a different eightbyte-SSE rule layered on
// top.  Whether an aggregate is an HFA is a language-level ABI decision shared by
// every compiler backend (codegen/LLVM, the native backends) and consulted at the
// cross-backend boundary, so it lives here in pkg/types per
// explorations/ir-backend-guidelines.md (and must stay BUILDER-compilable).  This
// is the AAPCS64 fold (1-4 same-width float members); the x64 eightbyte rule is a
// separate per-target classification.

// hfaPeel peels type-alias + readonly + named wrappers to the representation type
// — an ABI decision must see through all of them.  Interleaves alias resolution
// with the readonly/named peel to a fixpoint, matching pkg/binate/native/common's
// peelTransparent; distinct from StripWrappers, which does not resolve TYP_ALIAS.
func hfaPeel(t @Type) @Type {
	for t != nil {
		var p @Type = t.ResolveAlias()
		if p == nil { return t }
		if p.Kind == TYP_READONLY && p.Elem != nil {
			t = p.Elem
		} else if p.Kind == TYP_NAMED && p.Underlying != nil {
			t = p.Underlying
		} else {
			return p
		}
	}
	return t
}

// hfaFold folds a composite into (memberCount, memberWidth): memberWidth is the
// shared float width (32 or 64) if every leaf is that float type, or -1 if any
// leaf is a non-float / the leaves mix widths (disqualifying).  A bare float is
// (1, width); an empty aggregate is (0, -1).  Nested structs/arrays are folded
// flat; any non-float leaf, a mixed float width, or >4 members disqualifies.
func hfaFold(t @Type) (int, int) {
	if t == nil { return 0, -1 }
	t = hfaPeel(t)
	if t.Kind == TYP_FLOAT { return 1, t.Width }
	if t.Kind == TYP_STRUCT {
		var total int = 0
		var w int = 0
		for i := 0; i < len(t.Fields); i++ {
			cn, cw := hfaFold(t.Fields[i].Type)
			if cn == 0 || cw < 0 { return total + cn, -1 }
			if w == 0 { w = cw } else if w != cw { return total + cn, -1 }
			total = total + cn
			if total > 4 { return total, w }
		}
		if total == 0 { return 0, -1 }
		return total, w
	}
	if t.Kind == TYP_ARRAY {
		if t.Elem == nil { return 0, -1 }
		var esz int = t.Elem.SizeOf()
		if esz <= 0 { return 0, -1 }
		var alen int = t.SizeOf() / esz
		cn, cw := hfaFold(t.Elem)
		if cn == 0 || cw < 0 || alen <= 0 { return 0, -1 }
		return cn * alen, cw
	}
	return 0, -1
}

// HfaClassify returns (memberCount, memberByteWidth) for an AAPCS64 Homogeneous
// Floating-point Aggregate — 1-4 same-type float members — else (0, 0).
// memberByteWidth is 4 (a float32 HFA) or 8 (a float64 HFA).  Backend emitters
// place/read the members in memberCount consecutive FP registers of
// memberByteWidth each.
func HfaClassify(t @Type) (int, int) {
	n, w := hfaFold(t)
	if n >= 1 && n <= 4 && w > 0 { return n, w / 8 }
	return 0, 0
}

// HfaMemberCount returns the AAPCS64 HFA member count for t (1-4), else 0.
func HfaMemberCount(t @Type) int {
	n, _ := HfaClassify(t)
	return n
}

// HfaInSimd reports whether HFAs are passed in SIMD/FP registers for the
// current target.  It is the single gate that keeps the LLVM backend and the
// native backends agreeing on HFA passing (see the .bni contract).  It returns
// false while the cross-backend HFA work lands dormant, so the whole toolchain
// stays GP-consistent; it becomes `GetTarget().Arch == ARCH_AA64` once the aa64
// native side and dispatch shims are ready (Stage 3), and later also
// `== ARCH_X64` (Stage 4) — see explorations/plan-hfa-crossbackend.md.
func HfaInSimd() bool {
	return false
}
