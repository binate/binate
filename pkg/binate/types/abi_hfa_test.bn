package "pkg/binate/types"

import "pkg/builtins/testing"

// hfaStruct builds a named struct with the given field types (HFA-fold tests).
func hfaStruct(name @[]char, fieldTyps @[]@Type) @Type {
	var fs @[]@Field = make_slice(@Field, len(fieldTyps))
	for i := 0; i < len(fieldTyps); i++ {
		var fld @Field = make(Field)
		fld.Name = "f"
		fld.Type = fieldTyps[i]
		fs[i] = fld
	}
	return MakeStructType(name, fs)
}

func hfaTypes1(a @Type) @[]@Type {
	var r @[]@Type = make_slice(@Type, 1)
	r[0] = a
	return r
}

func hfaTypes2(a @Type, b @Type) @[]@Type {
	var r @[]@Type = make_slice(@Type, 2)
	r[0] = a
	r[1] = b
	return r
}

func hfaTypes3(a @Type, b @Type, c @Type) @[]@Type {
	var r @[]@Type = make_slice(@Type, 3)
	r[0] = a
	r[1] = b
	r[2] = c
	return r
}

func hfaTypes4(a @Type, b @Type, c @Type, d @Type) @[]@Type {
	var r @[]@Type = make_slice(@Type, 4)
	r[0] = a
	r[1] = b
	r[2] = c
	r[3] = d
	return r
}

func hfaTypes5(a @Type, b @Type, c @Type, d @Type, e @Type) @[]@Type {
	var r @[]@Type = make_slice(@Type, 5)
	r[0] = a
	r[1] = b
	r[2] = c
	r[3] = d
	r[4] = e
	return r
}

// A single float scalar is a 1-member HFA (byte width 4 for f32, 8 for f64).
func TestHfaScalarFloat() testing.TestResult {
	n, w := HfaClassify(TypFloat32())
	if n != 1 || w != 4 { return fail("float32 scalar is a 1-member 4-byte HFA") }
	n2, w2 := HfaClassify(TypFloat64())
	if n2 != 1 || w2 != 8 { return fail("float64 scalar is a 1-member 8-byte HFA") }
	return ""
}

// 2/3/4-member same-width float structs are HFAs; the byte width is per-member
// (4 for f32, 8 for f64); 4xf64 = 32B is still an HFA (the max member count).
func TestHfaFloatStructs() testing.TestResult {
	var d2 @Type = hfaStruct("D2", hfaTypes2(TypFloat64(), TypFloat64()))
	n, w := HfaClassify(d2)
	if n != 2 || w != 8 { return fail("{f64,f64} is a 2-member 8-byte HFA") }
	var f2 @Type = hfaStruct("F2", hfaTypes2(TypFloat32(), TypFloat32()))
	nf, wf := HfaClassify(f2)
	if nf != 2 || wf != 4 { return fail("{f32,f32} is a 2-member 4-byte HFA") }
	var d3 @Type = hfaStruct("D3", hfaTypes3(TypFloat64(), TypFloat64(), TypFloat64()))
	n3, w3 := HfaClassify(d3)
	if n3 != 3 || w3 != 8 { return fail("{f64,f64,f64} is a 3-member 8-byte HFA") }
	// flat 3-field f32 struct — the struct-accumulation path with member width 4.
	var f3 @Type = hfaStruct("F3", hfaTypes3(TypFloat32(), TypFloat32(), TypFloat32()))
	nf3, wf3 := HfaClassify(f3)
	if nf3 != 3 || wf3 != 4 { return fail("{f32,f32,f32} is a 3-member 4-byte HFA") }
	// 4-member boundary — the LARGEST valid HFA (accept bound n <= 4).
	var d4 @Type = hfaStruct("D4", hfaTypes4(TypFloat64(), TypFloat64(), TypFloat64(), TypFloat64()))
	n4, w4 := HfaClassify(d4)
	if n4 != 4 || w4 != 8 { return fail("{f64,f64,f64,f64} (32B) is a 4-member 8-byte HFA") }
	if HfaMemberCount(d4) != 4 { return fail("HfaMemberCount of a 4-member HFA is 4") }
	return ""
}

// A single-field float struct {f32}/{f64} is a 1-member HFA — the struct branch
// folding to total==1, distinct from the bare-float scalar short-circuit.
func TestHfaSingleMemberStruct() testing.TestResult {
	var s32 @Type = hfaStruct("S32", hfaTypes1(TypFloat32()))
	n, w := HfaClassify(s32)
	if n != 1 || w != 4 { return fail("{f32} is a 1-member 4-byte HFA") }
	var s64 @Type = hfaStruct("S64", hfaTypes1(TypFloat64()))
	n2, w2 := HfaClassify(s64)
	if n2 != 1 || w2 != 8 { return fail("{f64} is a 1-member 8-byte HFA") }
	return ""
}

// Cross-branch nesting: an array of float structs, and a struct of float arrays,
// both fold flat to their total member count.
func TestHfaCrossBranchNested() testing.TestResult {
	setTarget64()
	var f2 @Type = hfaStruct("F2", hfaTypes2(TypFloat32(), TypFloat32()))
	var arrOfStruct @Type = MakeArrayType(f2, 2) // [2]{f32,f32} = 4 members
	n, w := HfaClassify(arrOfStruct)
	if n != 4 || w != 4 { return fail("[2]{f32,f32} folds to a 4-member 4-byte HFA") }
	var a2 @Type = MakeArrayType(TypFloat32(), 2)
	var structOfArr @Type = hfaStruct("SA", hfaTypes2(a2, a2)) // {[2]f32,[2]f32} = 4 members
	n2, w2 := HfaClassify(structOfArr)
	if n2 != 4 || w2 != 4 { return fail("{[2]f32,[2]f32} folds to a 4-member 4-byte HFA") }
	return ""
}

// Nested float structs fold flat: {{f32,f32},f32} -> 3 members.
func TestHfaNestedFold() testing.TestResult {
	var inner @Type = hfaStruct("Inner", hfaTypes2(TypFloat32(), TypFloat32()))
	var outer @Type = hfaStruct("Outer", hfaTypes2(inner, TypFloat32()))
	n, w := HfaClassify(outer)
	if n != 3 || w != 4 { return fail("nested {{f32,f32},f32} folds to a 3-member 4-byte HFA") }
	return ""
}

// Arrays of float are HFAs (folded flat via SizeOf/elemSize). SizeOf is
// target-dependent.  Covers the length-4 boundary (the array-count division path
// at the max member count) for both widths.
func TestHfaFloatArray() testing.TestResult {
	setTarget64()
	var a3 @Type = MakeArrayType(TypFloat32(), 3)
	n, w := HfaClassify(a3)
	if n != 3 || w != 4 { return fail("[3]float32 is a 3-member 4-byte HFA") }
	var d2arr @Type = MakeArrayType(TypFloat64(), 2)
	n2, w2 := HfaClassify(d2arr)
	if n2 != 2 || w2 != 8 { return fail("[2]float64 is a 2-member 8-byte HFA") }
	var a4 @Type = MakeArrayType(TypFloat32(), 4)
	n4, w4 := HfaClassify(a4)
	if n4 != 4 || w4 != 4 { return fail("[4]float32 is a 4-member 4-byte HFA") }
	var d4arr @Type = MakeArrayType(TypFloat64(), 4)
	nd4, wd4 := HfaClassify(d4arr)
	if nd4 != 4 || wd4 != 8 { return fail("[4]float64 (32B) is a 4-member 8-byte HFA") }
	return ""
}

// Disqualifiers: mixed width, >4 members, a non-float field, empty, scalar-int.
func TestHfaDisqualifiers() testing.TestResult {
	setTarget64()
	var mixed @Type = hfaStruct("Mix", hfaTypes2(TypFloat32(), TypFloat64()))
	n, w := HfaClassify(mixed)
	if n != 0 || w != 0 { return fail("mixed-width {f32,f64} is NOT an HFA") }
	var five @Type = MakeArrayType(TypFloat32(), 5)
	n5, w5 := HfaClassify(five)
	if n5 != 0 || w5 != 0 { return fail("[5]float32 (>4 members) is NOT an HFA") }
	// >4 members via a STRUCT (the accumulation early-exit at total>4).
	var struct5 @Type = hfaStruct("S5",
			hfaTypes5(TypFloat32(), TypFloat32(), TypFloat32(), TypFloat32(), TypFloat32()))
	ns5, ws5 := HfaClassify(struct5)
	if ns5 != 0 || ws5 != 0 { return fail("{f32 x5} (>4 members) is NOT an HFA") }
	var hasInt @Type = hfaStruct("HI", hfaTypes2(TypFloat32(), TypInt()))
	ni, wi := HfaClassify(hasInt)
	if ni != 0 || wi != 0 { return fail("{f32,int} (non-float field) is NOT an HFA") }
	// A non-float leaf NESTED in a sub-struct disqualifies the whole aggregate.
	var innerBad @Type = hfaStruct("IB", hfaTypes2(TypFloat32(), TypInt()))
	var nestedBad @Type = hfaStruct("NB", hfaTypes2(TypFloat32(), innerBad))
	nn, wn := HfaClassify(nestedBad)
	if nn != 0 || wn != 0 { return fail("{f32,{f32,int}} (nested non-float leaf) is NOT an HFA") }
	var empty @Type = hfaStruct("E", make_slice(@Type, 0))
	ne, we := HfaClassify(empty)
	if ne != 0 || we != 0 { return fail("empty struct is NOT an HFA") }
	ns, ws := HfaClassify(TypInt64())
	if ns != 0 || ws != 0 { return fail("a scalar int is NOT an HFA") }
	return ""
}

// HfaMemberCount agrees with HfaClassify's member count.
func TestHfaMemberCount() testing.TestResult {
	var d2 @Type = hfaStruct("D2", hfaTypes2(TypFloat64(), TypFloat64()))
	if HfaMemberCount(d2) != 2 { return fail("HfaMemberCount {f64,f64} = 2") }
	if HfaMemberCount(TypInt64()) != 0 { return fail("HfaMemberCount(int) = 0") }
	if HfaMemberCount(TypFloat32()) != 1 { return fail("HfaMemberCount(float32) = 1") }
	return ""
}

// HFA SIMD passing is gated on the target arch (HfaInSimd()): on AArch64 an HFA
// aggregate rides SIMD registers, so it is exempt from the sret/byval GP paths
// regardless of size (a 24-byte 3x-f64 HFA comes back in v0..v2); on a
// non-AArch64 target (x64 — which uses the SysV-SSE eightbyte rule, not the
// AAPCS64 HFA fold) an HFA is classified like any other aggregate of its size,
// so a >16-byte one sret's and passes byval (SysV-SSE only helps ≤16 bytes).
// This pins the arch gate; NeedsSret / IsByvalParam are the shared predicates
// codegen and the native backends both consult.
func TestHfaSimdGatedByArch() testing.TestResult {
	setTarget64()
	var d3 @Type = hfaStruct("D3", hfaTypes3(TypFloat64(), TypFloat64(), TypFloat64()))
	var d2 @Type = hfaStruct("D2", hfaTypes2(TypFloat64(), TypFloat64()))
	// AArch64: an HFA rides SIMD — never sret / byval, even the 24-byte one.
	SetArch(ARCH_AA64)
	if !HfaInSimd() { return fail("HfaInSimd() must be true for ARCH_AA64") }
	if NeedsSret(d3) { return fail("a 24-byte HFA must NOT sret on aa64 (rides v0..v2)") }
	if d3.IsByvalParam() { return fail("a 24-byte HFA must NOT be byval on aa64") }
	// Non-AArch64 (x64): an HFA is a plain aggregate — the 24-byte one sret's + byval.
	SetArch(ARCH_X64)
	if HfaInSimd() { return fail("HfaInSimd() must be false for ARCH_X64 (x64 uses SysV-SSE)") }
	if !NeedsSret(d3) { return fail("a 24-byte HFA sret's on x64 (GP aggregate)") }
	if !d3.IsByvalParam() { return fail("a 24-byte HFA is byval on x64") }
	// A 16-byte aggregate is in-reg-coerced (never sret / byval) on any arch.
	if NeedsSret(d2) { return fail("a 16-byte HFA is never sret") }
	if d2.IsByvalParam() { return fail("a 16-byte HFA is never byval") }
	setTarget64() // restore Arch=UNKNOWN default for subsequent tests
	return ""
}

// A named / readonly / alias wrapper over a float struct classifies like the
// target — hfaPeel sees through TYP_NAMED / TYP_READONLY AND resolves TYP_ALIAS
// (its defining difference from StripWrappers), interleaved to a fixpoint.
func TestHfaPeelsWrappers() testing.TestResult {
	var d2 @Type = hfaStruct("D2", hfaTypes2(TypFloat64(), TypFloat64()))
	var named @Type = MakeNamedType("Vec")
	named.Underlying = d2
	n, w := HfaClassify(named)
	if n != 2 || w != 8 { return fail("named-over-{f64,f64} is a 2-member 8-byte HFA") }
	var ro @Type = MakeReadonlyType(named)
	nr, wr := HfaClassify(ro)
	if nr != 2 || wr != 8 { return fail("readonly-named-{f64,f64} is a 2-member 8-byte HFA") }
	// A type alias resolves to its target (StripWrappers would NOT peel this).
	var alias @Type = MakeAliasType("D2Alias", d2)
	na, wa := HfaClassify(alias)
	if na != 2 || wa != 8 { return fail("alias-of-{f64,f64} is a 2-member 8-byte HFA") }
	// Interleaved: readonly over an alias over the struct — exercises the
	// alias+wrapper fixpoint the hfaPeel loop guarantees.
	var roAlias @Type = MakeReadonlyType(alias)
	nra, wra := HfaClassify(roAlias)
	if nra != 2 || wra != 8 { return fail("readonly-alias-{f64,f64} is a 2-member 8-byte HFA") }
	return ""
}
