package "pkg/binate/types"

// ABI return-shape predicates: whether a function's RESULT is returned via a
// retbuf (the caller passes a hidden pointer the callee writes through) or as a
// scalar in the return register(s).  This is a language-level ABI contract
// shared by every compiler backend (codegen/LLVM, the native backends) AND the
// bytecode VM's cross-mode shim dispatch, so it lives in pkg/types per
// explorations/ir-backend-guidelines.md (and must stay BUILDER-compilable).

// StripWrappers peels the transparent semantic wrappers — TYP_ALIAS,
// TYP_READONLY and TYP_NAMED — down to the representation type.  An
// ABI/representation decision must see through them (a `readonly @T`, an
// alias-over-aggregate, or a named-over-aggregate type otherwise falls through
// every Kind-dispatch — e.g. a `type R = @[]char` param would read as
// TYP_ALIAS, not TYP_MANAGED_SLICE, and be misclassified as a scalar).
// Interleaves all peels to a fixpoint, so wrapper order (`readonly @T` vs
// named-over-readonly vs alias-over-named) doesn't matter.
func StripWrappers(t @Type) @Type {
	for t != nil {
		if t.Kind == TYP_ALIAS {
			t = t.Target
		} else if t.Kind == TYP_READONLY {
			t = t.Elem
		} else if t.Kind == TYP_NAMED && t.Underlying != nil {
			t = t.Underlying
		} else {
			return t
		}
	}
	return t
}

// NeedsSret reports whether a result of type t is returned via a hidden sret
// pointer (too large for the return registers).  Target-specific: > 16 bytes on
// LP64, > 4 (one word) on ILP32 ARM (AAPCS32) — verified against clang (an
// 8-byte struct already gets `sret` on ILP32, a 4-byte one returns in r0).
func NeedsSret(t @Type) bool {
	if t == nil { return false }
	// An HFA aggregate returns in consecutive SIMD registers (v0..v3 on aa64),
	// never via sret — even a 4x f64 (32-byte) HFA, which exceeds the size
	// threshold below.  See hfaSimdAggregate; dormant while HfaInSimd() is off.
	if hfaSimdAggregate(t) { return false }
	t = t.ResolveAlias()
	var threshold int = 16
	if GetTarget().PointerSize == 4 {
		threshold = 4
	}
	return t.SizeOf() > threshold
}

// AggInRegCoercedKind reports whether t is the KIND of aggregate the
// in-register-coerced ABI applies to: a NAMED struct or any array.  An
// ANONYMOUS struct is excluded — it is the multi-return tuple `{...}`, which has
// its own convention and must not be coerced (doing so would type-mismatch the
// call's `{...}` result against a `[N x i64]` bind).  A real by-value struct
// result is always a named struct (e.g. time.Point).
func AggInRegCoercedKind(t @Type) bool {
	if t == nil { return false }
	var s @Type = StripWrappers(t)
	if s == nil { return false }
	if s.Kind == TYP_ARRAY { return true }
	if s.Kind == TYP_STRUCT { return len(s.Name) > 0 }
	return false
}

// AggRetCoerced reports whether a single result of type t is returned using the
// `[N x i64]` in-register-coerced ABI: a named struct/array that fits in the
// return registers (NOT NeedsSret) — INCLUDING a <= 8-byte one, since the
// coerced ABI type is still a struct value the scalar return slot can't carry.
func AggRetCoerced(t @Type) bool {
	if !AggInRegCoercedKind(t) { return false }
	if t.SizeOf() < 1 { return false }
	return !NeedsSret(t)
}

// IsAggregateReturn reports whether a function whose result list is `results`
// returns via the retbuf (aggregate) shim shape rather than a scalar return
// register.  True for: a MULTI-return (the anonymous result-tuple is by
// definition multi-word); a coerced named struct/array (AggRetCoerced, incl.
// <= 8 bytes); or any single result wider than one pointer.  This is the single
// source of truth that codegen, the native backends, and the VM cross-mode
// dispatch must all agree on.
func IsAggregateReturn(results @[]@Type) bool {
	if len(results) == 0 { return false }
	if len(results) > 1 { return true }
	if results[0] == nil { return false }
	if AggRetCoerced(results[0]) { return true }
	return results[0].SizeOf() > GetTarget().PointerSize
}

// IsAggregateArg reports whether a parameter of type t is passed to the
// cross-mode / func-value shim as a POINTER to the aggregate (the shim loads it
// and re-marshals to the underlying ABI) rather than as a value in one register
// slot.  True for an aggregate-KIND type (slice / managed-slice / struct / array
// / func-value / iface-value) wider than one target word (GetTarget().-
// PointerSize) — the arg-side mirror of IsAggregateReturn.
//
// The KIND gate matters on ILP32 and is why this is not a size-only test: on
// LP64 (word = 8) no SCALAR exceeds one word, so the old hardcoded `SizeOf > 8`
// happened to select exactly the aggregates; on ILP32 (word = 4) an 8-byte
// SCALAR (int64 / uint64 / float64) is > 4, so a size-only `> PointerSize` would
// wrongly mark it an aggregate and hand the shim an i8* where it expects an
// int/float slot (the float path's `bitcast i64 %a to double` then fails to
// compile).  Gating on the aggregate kinds keeps 8-byte scalars scalar while
// promoting the genuinely 2-word aggregates (a slice / func-value is 8 bytes on
// ILP32) to by-address — matching what the VM cross-mode dispatcher already
// does, so the shim and the dispatcher agree (without the promotion the shim
// read the slice coerced-in-registers and its len came back garbage).
//
// A coerced in-register named struct/array (AggInRegCoercedKind) is handled
// separately by the caller (aggParamCoerced), so a small named struct still
// routes through that path via the `||` in shimParamType.  The single source of
// truth for codegen, the native backends, and the VM cross-mode dispatch.
func IsAggregateArg(t @Type) bool {
	if t == nil { return false }
	var s @Type = StripWrappers(t)
	if s == nil { return false }
	var isAgg bool = s.Kind == TYP_STRUCT || s.Kind == TYP_ARRAY ||
		s.Kind == TYP_SLICE || s.Kind == TYP_MANAGED_SLICE ||
		s.Kind == TYP_FUNC_VALUE || s.Kind == TYP_MANAGED_FUNC_VALUE ||
		s.Kind == TYP_INTERFACE_VALUE || s.Kind == TYP_INTERFACE_VALUE_MANAGED
	if !isAgg { return false }
	return t.SizeOf() > GetTarget().PointerSize
}

// AggregateReturnSize returns the retbuf byte size for a function with result
// list `results`: 0 when the result is returned as a scalar (no retbuf), else
// the retbuf size ROUNDED UP to a whole number of 8-byte words.  The aggregate
// shim writes the result as `[N x i64]` (N = ceil(SizeOf/8)); sizing the retbuf
// at the raw SizeOf would under-allocate for a non-multiple-of-8 aggregate
// (e.g. a 12-byte struct whose shim writes 16 bytes — a stack overrun).  A
// nonzero return is exactly the aggregate discriminator: only void / scalar
// returns yield 0.
func AggregateReturnSize(results @[]@Type) int {
	if !IsAggregateReturn(results) { return 0 }
	var sz int = 0
	if len(results) > 1 {
		var fields @[]@Field = make_slice(@Field, len(results))
		for i := 0; i < len(results); i++ {
			var fld @Field = make(Field)
			fld.Type = results[i]
			fields[i] = fld
		}
		sz = MakeStructType("", fields).SizeOf()
	} else {
		sz = results[0].SizeOf()
	}
	return (sz + 7) / 8 * 8
}
