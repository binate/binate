package "pkg/binate/types"

import "pkg/builtins/testing"

// struct1 builds a named single-field struct of the given field type (a small
// named aggregate for the coerced-return tests).
func struct1(name @[]char, fieldTyp @Type) @Type {
	var fs @[]@Field = make_slice(@Field, 1)
	var fld @Field = make(Field)
	fld.Name = "f"
	fld.Type = fieldTyp
	fs[0] = fld
	return MakeStructType(name, fs)
}

// resultList builds a 1- or 2-element result list for the IsAggregateReturn /
// AggregateReturnSize tests.
func resultList1(a @Type) @[]@Type {
	var r @[]@Type = make_slice(@Type, 1)
	r[0] = a
	return r
}

func resultList2(a @Type, b @Type) @[]@Type {
	var r @[]@Type = make_slice(@Type, 2)
	r[0] = a
	r[1] = b
	return r
}

// NeedsSret: > 16 bytes on LP64 returns via sret; <= 16 does not.
func TestNeedsSretThreshold() testing.TestResult {
	setTarget64()
	var s8 @Type = struct1("S8", TypInt64())                 // 8B
	var s24 @Type = MakeArrayType(TypInt64(), 3)             // 24B
	if NeedsSret(s8) { return fail("8B struct must not need sret on LP64") }
	if !NeedsSret(s24) { return fail("24B aggregate must need sret on LP64") }
	if NeedsSret(TypInt64()) { return fail("scalar int64 must not need sret") }
	return ""
}

// AggInRegCoercedKind: named struct / array yes; anonymous struct (multi-return
// tuple) and scalars no.
func TestAggInRegCoercedKind() testing.TestResult {
	var named @Type = struct1("P", TypInt64())
	var anon @Type = struct1("", TypInt64())
	var arr @Type = MakeArrayType(TypUint8(), 4)
	if !AggInRegCoercedKind(named) { return fail("named struct is coerced-kind") }
	if AggInRegCoercedKind(anon) { return fail("anonymous (tuple) struct is NOT coerced-kind") }
	if !AggInRegCoercedKind(arr) { return fail("array is coerced-kind") }
	if AggInRegCoercedKind(TypInt64()) { return fail("scalar is not coerced-kind") }
	// Peels transparent wrappers.
	if !AggInRegCoercedKind(MakeReadonlyType(named)) {
		return fail("readonly named struct still coerced-kind")
	}
	return ""
}

// AggRetCoerced: a <= 16-byte named struct/array is coerced (incl. <= 8 bytes);
// a > 16 one is sret; a scalar is not.
func TestAggRetCoerced() testing.TestResult {
	setTarget64()
	var s8 @Type = struct1("S8", TypInt64())                 // 8B named
	var s24 @Type = MakeArrayType(TypInt64(), 3)             // 24B array (sret)
	if !AggRetCoerced(s8) { return fail("8B named struct is coerced-returned") }
	if AggRetCoerced(s24) { return fail("24B aggregate is sret, not coerced") }
	if AggRetCoerced(TypInt64()) { return fail("scalar is not coerced") }
	return ""
}

// IsAggregateReturn over a result list: empty / scalar / managed-ptr -> false;
// <= 8-byte named struct, any multi-return, and > word single result -> true.
func TestIsAggregateReturn() testing.TestResult {
	setTarget64()
	var none @[]@Type
	if IsAggregateReturn(none) { return fail("no results is scalar (void)") }
	if IsAggregateReturn(resultList1(TypInt64())) {
		return fail("single int64 is scalar")
	}
	if IsAggregateReturn(resultList1(MakePointerType(TypUint8()))) {
		return fail("single pointer is scalar")
	}
	if !IsAggregateReturn(resultList1(struct1("S8", TypInt64()))) {
		return fail("8B named struct return is aggregate")
	}
	if !IsAggregateReturn(resultList2(TypInt64(), TypInt64())) {
		return fail("multi-return is aggregate")
	}
	if !IsAggregateReturn(resultList2(TypUint8(), TypUint8())) {
		return fail("<=8B multi-return is STILL aggregate")
	}
	if !IsAggregateReturn(resultList1(MakeArrayType(TypInt64(), 3))) {
		return fail(">word single result is aggregate")
	}
	return ""
}

// chkAgg threads a running result: if prev already failed it passes through;
// otherwise it asserts IsAggregateArg(t) == want, returning msg on mismatch.
// Threading the result (rather than a per-check `if`) keeps the caller flat so
// it can restore the (global) target on every path — SetTarget is global.
func chkAgg(prev testing.TestResult, t @Type, want bool,
		msg @[]char) testing.TestResult {
	if len(prev) != 0 { return prev }
	if IsAggregateArg(t) != want { return fail(msg) }
	return ""
}

// IsAggregateArg: an aggregate-KIND type (slice / managed-slice / struct / array
// / func-value / iface-value) wider than one target word is passed to the shim
// by address; scalars and pointers never are, even an 8-byte scalar on ILP32
// (the discriminating case the KIND gate exists for).  Transparent wrappers
// (alias / readonly / named) over an aggregate are seen through.
func TestIsAggregateArgKindGated() testing.TestResult {
	var saved TargetInfo = GetTarget()
	// `type AliasMS = @[]char`: an alias over a managed-slice must classify by
	// its representation, NOT as the bare TYP_ALIAS (else a func-value param of
	// this type is misclassified scalar, a shim/VM ABI disagreement).
	var aliasMS @Type = MakeAliasType("AliasMS", MakeManagedSliceType(TypChar()))
	var fvTyp @Type = MakeFuncValueType(make_slice(@Param, 0), make_slice(@Type, 0))
	var slice @Type = MakeSliceType(TypUint8())
	var mslice @Type = MakeManagedSliceType(TypUint8())
	var ptr @Type = MakePointerType(TypUint8())

	// LP64: word is 8, so no scalar reaches the > threshold anyway.
	setTarget64()
	var r testing.TestResult = ""
	r = chkAgg(r, slice, true, "LP64: 16B slice is agg arg")
	r = chkAgg(r, mslice, true, "LP64: 32B managed-slice is agg arg")
	r = chkAgg(r, aliasMS, true, "LP64: alias-over-mslice is agg arg (alias-transparent)")
	r = chkAgg(r, fvTyp, true, "LP64: 16B func-value is agg arg")
	r = chkAgg(r, TypInt64(), false, "LP64: int64 scalar is not agg arg")
	r = chkAgg(r, struct1("S8", TypInt64()), false, "LP64: 8B struct not wider than 8B word")
	r = chkAgg(r, MakeArrayType(TypInt64(), 3), true, "LP64: 24B array is agg arg")

	// ILP32: word is 4, so an 8-byte SCALAR (int64 / float64) is > word but must
	// STILL be scalar; the KIND gate is what keeps the shim's float path an
	// int/float slot instead of an i8* (its `bitcast i64 %a to double` would
	// otherwise fail to compile).
	setTarget32()
	r = chkAgg(r, slice, true, "ILP32: 8B slice (2 words) IS agg arg (the fix)")
	r = chkAgg(r, mslice, true, "ILP32: 16B managed-slice is agg arg")
	r = chkAgg(r, aliasMS, true, "ILP32: alias-over-mslice is agg arg (alias-transparent)")
	r = chkAgg(r, fvTyp, true, "ILP32: 8B func-value (2 words) is agg arg")
	r = chkAgg(r, TypInt64(), false, "ILP32: int64 is an 8B SCALAR, not agg arg (kind gate)")
	r = chkAgg(r, TypFloat64(), false, "ILP32: float64 is an 8B SCALAR, not agg arg")
	r = chkAgg(r, ptr, false, "ILP32: 4B pointer is not agg arg")
	r = chkAgg(r, MakeArrayType(TypUint8(), 4), false, "ILP32: 4B array is one word, not wider")

	SetTarget(saved)
	return r
}

// AggregateReturnSize: 0 for scalars; the retbuf byte size ROUNDED UP to N*8 for
// aggregates (a 12-byte aggregate's shim writes 16 bytes).
func TestAggregateReturnSizeRoundsUp() testing.TestResult {
	setTarget64()
	if AggregateReturnSize(resultList1(TypInt64())) != 0 {
		return fail("scalar return size is 0 (no retbuf)")
	}
	if AggregateReturnSize(resultList1(struct1("S8", TypInt64()))) != 8 {
		return fail("8B named struct retbuf is 8")
	}
	// 12-byte array: shim writes [2 x i64] = 16, so the retbuf must be 16.
	if AggregateReturnSize(resultList1(MakeArrayType(TypUint8(), 12))) != 16 {
		return fail("12B aggregate retbuf rounds up to 16")
	}
	// <=8B multi-return ({uint8,uint8} = 2B) rounds up to one word.
	if AggregateReturnSize(resultList2(TypUint8(), TypUint8())) != 8 {
		return fail("2B multi-return retbuf rounds up to 8")
	}
	if AggregateReturnSize(resultList2(TypInt64(), TypInt64())) != 16 {
		return fail("16B multi-return retbuf is 16")
	}
	return ""
}

// StripWrappers peels readonly + named to the representation type.
func TestStripWrappersPeels() testing.TestResult {
	var named @Type = MakeNamedType("N")
	named.Underlying = TypInt64()
	var wrapped @Type = MakeReadonlyType(named)
	if StripWrappers(wrapped) != TypInt64() {
		return fail("readonly-named peels to the underlying int64")
	}
	return ""
}
