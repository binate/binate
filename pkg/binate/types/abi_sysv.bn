package "pkg/binate/types"

// SysV-AMD64 (x86-64) eightbyte classification for aggregates passed in
// registers.  This is a DIFFERENT rule from the AAPCS64 HFA fold (abi_hfa.bn):
// SysV classifies each 8-byte chunk ("eightbyte") of an aggregate as SSE (every
// field byte overlapping it is float) or INTEGER (any int/pointer byte in it),
// and passes each eightbyte in a register of its class (SSE -> XMM, INTEGER ->
// GP).  Homogeneity is NOT required — `{float,double}` is SSE+SSE, `{float,int}`
// is one INTEGER eightbyte — and an aggregate larger than two eightbytes (>16
// bytes) is passed in MEMORY (byval/sret), unlike aa64 which keeps 3-4 member
// HFAs in SIMD.  Whether an aggregate rides SSE registers is a language-level
// ABI decision shared by the LLVM backend and the native x64 backend, so it
// lives here in pkg/types per explorations/ir-backend-guidelines.md (and must
// stay BUILDER-compilable — the output is a flat @[]int).
//
// Verified against clang x86_64 (the reference ABI): sumF2(<2 x float>),
// sumD2(double,double), sumFD(float,double), sumFI(i64), sumD3(ptr byval).

// Eightbyte classes for SysVClassify.  EB_NONE is the zero value (an eightbyte
// with no field bytes — padding only); a classified ≤16-byte aggregate yields
// only EB_SSE / EB_INTEGER entries.
const (
	EB_NONE    int = iota
	EB_INTEGER
	EB_SSE
)

// sysvPeel peels alias / readonly / named wrappers to the representation type,
// exactly as the HFA fold does (see hfaPeel in abi_hfa.bn) — an ABI decision
// must see through them.
func sysvPeel(t @Type) @Type {
	return hfaPeel(t)
}

// sysvMarkNonFloat walks t's leaves (recursively through nested structs/arrays)
// at their byte offsets from baseOff, and downgrades to EB_INTEGER every
// eightbyte that a non-float leaf overlaps.  Float leaves keep the eightbyte's
// initial EB_SSE.  The merge rule (SSE+INTEGER -> INTEGER) falls out of starting
// every eightbyte at EB_SSE and only ever downgrading.
func sysvMarkNonFloat(t @Type, baseOff int, classes @[]int) {
	t = sysvPeel(t)
	if t == nil { return }
	if t.Kind == TYP_FLOAT {
		return
	}
	if t.Kind == TYP_STRUCT {
		for i := 0; i < len(t.Fields); i++ {
			sysvMarkNonFloat(t.Fields[i].Type, baseOff + t.FieldOffset(i),
				classes)
		}
		return
	}
	if t.Kind == TYP_ARRAY {
		if t.Elem == nil { return }
		var esz int = t.Elem.SizeOf()
		if esz <= 0 { return }
		var n int = t.SizeOf() / esz
		for i := 0; i < n; i++ {
			sysvMarkNonFloat(t.Elem, baseOff + i * esz, classes)
		}
		return
	}
	// A non-float scalar leaf (int / pointer / bool / char / slice word, ...):
	// mark every eightbyte its byte span overlaps as INTEGER.
	var sz int = t.SizeOf()
	if sz < 1 { sz = 1 }
	var lo int = baseOff / 8
	var hi int = (baseOff + sz - 1) / 8
	for eb := lo; eb <= hi; eb++ {
		if eb >= 0 && eb < len(classes) {
			classes[eb] = EB_INTEGER
		}
	}
	return
}

// SysVClassify returns the per-eightbyte class list (EB_INTEGER / EB_SSE) for a
// struct/array aggregate under SysV-AMD64.  An empty result means the aggregate
// is passed in MEMORY (byval arg / sret return): larger than two eightbytes (>16
// bytes), empty, or not a struct/array.  A ≤16-byte struct/array yields 1 or 2
// entries, one per eightbyte, each SSE (all float bytes) or INTEGER.
func SysVClassify(t @Type) @[]int {
	var empty @[]int = make_slice(int, 0)
	if t == nil { return empty }
	var pt @Type = sysvPeel(t)
	if pt == nil { return empty }
	if pt.Kind != TYP_STRUCT && pt.Kind != TYP_ARRAY {
		return empty
	}
	var sz int = pt.SizeOf()
	if sz < 1 || sz > 16 {
		return empty
	}
	var nEb int = (sz + 7) / 8
	var classes @[]int = make_slice(int, nEb)
	for i := 0; i < nEb; i++ {
		classes[i] = EB_SSE
	}
	sysvMarkNonFloat(pt, 0, classes)
	return classes
}

// SysVSseInRegs reports whether SysV-AMD64 SSE-eightbyte aggregate passing is
// enabled for the current target.  It is the x64 analogue of HfaInSimd(): the
// single gate the LLVM backend (codegen) and the native x64 backend both
// consult, so flipping it flips both halves in lockstep.  Currently false
// everywhere (x64 float aggregates stay GP-coerced, self-consistent within the
// toolchain) while the x64 SSE work lands dormant — it becomes `GetTarget().Arch
// == ARCH_X64` once the codegen + native + shim halves are ready (Stage 4 flip).
// See explorations/plan-hfa-crossbackend.md.
func SysVSseInRegs() bool {
	return false
}

// SysVInSse reports whether aggregate t is passed/returned in SSE (XMM)
// registers under SysV-AMD64 for the current target — an AggInRegCoercedKind
// aggregate (named struct / array, not the anonymous multi-return tuple) that
// classifies with at least one SSE eightbyte, when SysVSseInRegs() is on.  This
// is the x64 counterpart of hfaSimdAggregate: the exact set codegen SSE-coerces
// and that NeedsSret / IsByvalParam exempt from the GP paths — but NOT from
// MEMORY (a >16-byte float aggregate stays sret/byval on x64, unlike aa64).
// Dormant while SysVSseInRegs() is false.
func SysVInSse(t @Type) bool {
	if !SysVSseInRegs() { return false }
	if !AggInRegCoercedKind(t) { return false }
	var cl @[]int = SysVClassify(t)
	for i := 0; i < len(cl); i++ {
		if cl[i] == EB_SSE { return true }
	}
	return false
}
