package "pkg/binate/types"

// ============================================================
// SysV-AMD64 memory-class argument classification
// ============================================================
//
// A ≤16-byte aggregate ARGUMENT that does not fully fit in the remaining
// SysV-AMD64 argument registers (given its position in the arg sequence) is
// MEMORY-classified: the WHOLE aggregate is passed by value on the outgoing
// stack, all-or-nothing, and NO argument register is consumed (a later,
// smaller arg can still take a leftover register).  This is the psABI §3.2.3
// rule clang implements by emitting `byval(<T>)` for such a parameter.
//
// The native x64 backend already does this (common_callconv.bn's
// argRegWordsStackWords, SysV branch).  The LLVM backend historically coerced
// every ≤16-byte aggregate to a SPLITTABLE form — `[N x i64]` for a
// struct/array, or the first-class `{i8*,i64}` / `{i8*,i8*}` for a slice /
// iface-value / func-value — which LLVM SPLITS at a straddle (first eightbyte in
// the last free GP reg, the rest on the stack), diverging from native (and from
// the C ABI) at the native↔LLVM boundary.  SysVArgInMemory lets codegen make the
// SAME position-aware memory decision the native walk makes, so it emits a true
// `byval` for the memory-class case and the two backends agree.
//
// SysV-AMD64-only: AAPCS64 / AAPCS32 SPLIT a straddling aggregate (native and
// LLVM both split, so they already agree), so codegen consults this only for the
// x64 target.  The walk uses the SysV register-file sizes (6 GP: RDI RSI RDX RCX
// R8 R9; 8 XMM) and mirrors the SysV arms of argRegWordsStackWords /
// advanceNgrn / advanceNsrn; a cross-check unit test (native/common) pins the
// two to agree over a battery of signatures.

// sysvGpArgRegs / sysvFpArgRegs are the SysV-AMD64 argument-register file sizes
// (RDI/RSI/RDX/RCX/R8/R9 and XMM0..XMM7).  They match SysV_AMD64()'s
// NumGpArgRegs / NumFpArgRegs in native/common — the cross-check test pins the
// agreement.
const (
	sysvGpArgRegs int = 6
	sysvFpArgRegs int = 8
)

// sysvArgIsFloatScalar reports whether t is a float scalar (rides an XMM arg
// register, consuming no GP register) — the types-side mirror of native's
// IsFloatScalarTyp.
func sysvArgIsFloatScalar(t @Type) bool {
	if t == nil { return false }
	var s @Type = StripWrappers(t)
	if s == nil { return false }
	return s.Kind == TYP_FLOAT || s.Kind == TYP_UNTYPED_FLOAT
}

// sysvArgIsAggregate reports whether t is an aggregate KIND (struct / array /
// slice / managed-slice / func-value / iface-value, managed or not) — the
// types-side mirror of native's IsAggregateTyp.  A slice / iface-value /
// func-value is a 2-word aggregate that can straddle exactly like a 16-byte
// struct, so it is classified here just like a struct/array.
func sysvArgIsAggregate(t @Type) bool {
	if t == nil { return false }
	var s @Type = StripWrappers(t)
	if s == nil { return false }
	return s.Kind == TYP_STRUCT || s.Kind == TYP_ARRAY || s.Kind == TYP_SLICE ||
			s.Kind == TYP_MANAGED_SLICE || s.Kind == TYP_FUNC_VALUE || s.Kind == TYP_MANAGED_FUNC_VALUE ||
			s.Kind == TYP_INTERFACE_VALUE || s.Kind == TYP_INTERFACE_VALUE_MANAGED
}

// sysvArgEightbyteCounts returns (intCount, sseCount) for a ≤16-byte SSE
// aggregate: how many of its eightbytes classify INTEGER (a GP reg) vs SSE (an
// XMM reg).  Mirrors native's sysvSseAggEightbyteCounts.
func sysvArgEightbyteCounts(t @Type) (int, int) {
	var cl @[]int = SysVClassify(t)
	var ic int = 0
	var sc int = 0
	for i := 0; i < len(cl); i++ {
		if cl[i] == EB_SSE {
			sc = sc + 1
		} else {
			ic = ic + 1
		}
	}
	return ic, sc
}

// sysvArgWords is the GP-word count of a ≤16-byte GP aggregate on LP64:
// ceil(SizeOf/8), at least 1.  Matches native's argWords(t, 8).
func sysvArgWords(t @Type) int {
	var sz int = t.SizeOf()
	var w int = (sz + 7) / 8
	if w < 1 { w = 1 }
	return w
}

// sysvArgConsumes classifies argument t at the running (ngrn, nsrn) SysV cursors
// and returns (gp, sse, memAgg): gp / sse are the GP / XMM registers it consumes
// (added to the cursors for the next arg), and memAgg is true iff t is a
// ≤16-byte aggregate placed WHOLLY in memory (the all-or-nothing straddle case).
// Mirrors the SysV arms of argRegWordsStackWords + advanceNgrn / advanceNsrn.
func sysvArgConsumes(t @Type, ngrn int, nsrn int) (int, int, bool) {
	// Float scalar: rides an XMM register (NSRN), never a GP register.  It
	// always advances NSRN — past the file too, so a later SSE aggregate sees
	// the file full — and is never a memory aggregate.
	if sysvArgIsFloatScalar(t) {
		return 0, 1, false
	}
	if !sysvArgIsAggregate(t) {
		// GP scalar: one GP register when the file has room, else on the stack
		// consuming no register (NGRN unchanged).
		if ngrn < sysvGpArgRegs { return 1, 0, false }
		return 0, 0, false
	}
	var sz int = t.SizeOf()
	if sz > 16 {
		// >16 aggregate: passed as a SINGLE pointer (IndirectLargeAggregates) —
		// one GP register if available, else one stack word.  A pointer cannot
		// straddle, so this is never a memory-class ≤16 aggregate.
		if ngrn < sysvGpArgRegs { return 1, 0, false }
		return 0, 0, false
	}
	// ≤16-byte aggregate.
	if SysVSseInRegs() && SysVAggHasSse(t) {
		// SSE aggregate: its INTEGER eightbytes ride GP regs, its SSE eightbytes
		// ride XMM regs.  In-register only if EVERY eightbyte fits its file;
		// otherwise the WHOLE aggregate goes to memory (neither cursor advances).
		ic, sc := sysvArgEightbyteCounts(t)
		if ngrn + ic <= sysvGpArgRegs && nsrn + sc <= sysvFpArgRegs {
			return ic, sc, false
		}
		return 0, 0, true
	}
	// ≤16-byte GP aggregate (struct / array / slice / iface-value / func-value
	// with only INTEGER eightbytes): fits wholly in the remaining GP regs, or
	// the WHOLE aggregate goes to memory (SysV never splits — NGRN unchanged).
	var w int = sysvArgWords(t)
	if ngrn + w <= sysvGpArgRegs {
		return w, 0, false
	}
	return 0, 0, true
}

// SysVArgInMemory reports whether argument `idx` of the SysV-AMD64 argument
// sequence `argTypes` is a ≤16-byte aggregate passed WHOLLY in memory (the
// all-or-nothing straddle/overflow case), given the register budget consumed by
// args 0..idx-1.  `argTypes` must already include any synthetic leading entries
// the target uses (the sret buffer pointer, an interface-dispatch data pointer,
// etc.) so the register positions match what the native backend walks — codegen
// builds the same prefixed list the native x64 emitters build.
//
// Kind-agnostic: true for a memory-class struct / array / slice / iface-value /
// func-value.  False for a >16-byte aggregate (that rides a single pointer, and
// a pointer cannot straddle) and for any in-register aggregate.  SysV-AMD64
// specific — codegen calls it only for the x64 target (AAPCS splits, so those
// targets already agree).
func SysVArgInMemory(argTypes @[]@Type, idx int) bool {
	if idx < 0 || idx >= len(argTypes) { return false }
	var ngrn int = 0
	var nsrn int = 0
	for k := 0; k <= idx; k++ {
		gp, sse, mem := sysvArgConsumes(argTypes[k], ngrn, nsrn)
		if k == idx { return mem }
		ngrn = ngrn + gp
		nsrn = nsrn + sse
	}
	return false
}
