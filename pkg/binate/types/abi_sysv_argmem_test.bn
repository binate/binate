package "pkg/binate/types"

import "pkg/builtins/testing"

// Direct expected-value tests of SysVArgInMemory (the SysV-AMD64 memory-class
// argument predicate).  The exhaustive agreement with the native x64 walk is
// pinned separately by the cross-check test in pkg/binate/native/common; here we
// assert the predicate's own classifications for representative signatures, so a
// regression in the walk is caught in the types package itself.

// am2 builds a named 2-field struct (a 16-byte {t0,t1} for 8-byte fields).
func am2(name @[]char, t0 @Type, t1 @Type) @Type {
	return hfaStruct(name, twoTypes(t0, t1))
}

// twoTypes / threeTypes wrap a fixed field-type list for hfaStruct.
func twoTypes(t0 @Type, t1 @Type) @[]@Type {
	var ts @[]@Type = make_slice(@Type, 2)
	ts[0] = t0
	ts[1] = t1
	return ts
}

func threeTypes(t0 @Type, t1 @Type, t2 @Type) @[]@Type {
	var ts @[]@Type = make_slice(@Type, 3)
	ts[0] = t0
	ts[1] = t1
	ts[2] = t2
	return ts
}

// fiveI64Then builds [i64,i64,i64,i64,i64, x] so arg x lands at NGRN=5 (one GP
// register left) — the straddle position for a 2-word aggregate.
func fiveI64Then(x @Type) @[]@Type {
	var s @[]@Type = make_slice(@Type, 6)
	var i64 @Type = TypInt64()
	for i := 0; i < 5; i++ { s[i] = i64 }
	s[5] = x
	return s
}

// TestSysVArgInMemoryGpStraddle: a run of i64 args followed by 16-byte structs
// so the trailing structs straddle the GP reg/stack boundary and go to memory.
func TestSysVArgInMemoryGpStraddle() testing.TestResult {
	setTarget64()
	SetArch(ARCH_X64)
	var i64 @Type = TypInt64()
	var i2 @Type = am2("I2", i64, i64)

	// [i64(lead), I2,I2,I2,I2]: lead->RDI; p1->RSI,RDX; p2->RCX,R8; p3 straddles
	// R9 => memory; p4 => memory.
	var sig @[]@Type = make_slice(@Type, 5)
	sig[0] = i64
	sig[1] = i2
	sig[2] = i2
	sig[3] = i2
	sig[4] = i2
	if SysVArgInMemory(sig, 0) { return "lead i64 is not an aggregate" }
	if SysVArgInMemory(sig, 1) { return "p1 fits in RSI:RDX" }
	if SysVArgInMemory(sig, 2) { return "p2 fits in RCX:R8" }
	if !SysVArgInMemory(sig, 3) { return "p3 must straddle => memory" }
	if !SysVArgInMemory(sig, 4) { return "p4 => memory (GP file exhausted)" }
	return ""
}

// TestSysVArgInMemoryPrefixShift: a leading pointer (modeling an sret buffer or
// an iface data pointer) shifts the register budget so an aggregate that would
// otherwise fit now straddles.
func TestSysVArgInMemoryPrefixShift() testing.TestResult {
	setTarget64()
	SetArch(ARCH_X64)
	var i64 @Type = TypInt64()
	var ptr @Type = MakePointerType(TypUint8())
	var i2 @Type = am2("I2", i64, i64)

	// Without prefix: [i64,i64,i64,i64, I2] — after 4 i64 (RDI..RCX? no: RDI RSI
	// RDX RCX = 4) NGRN=4, I2 needs 2 => R8,R9 fit, NOT memory.
	var noPrefix @[]@Type = make_slice(@Type, 5)
	for i := 0; i < 4; i++ { noPrefix[i] = i64 }
	noPrefix[4] = i2
	if SysVArgInMemory(noPrefix, 4) { return "I2 after 4 i64 fits in R8:R9" }

	// With a leading pointer: [ptr, i64,i64,i64,i64, I2] — NGRN=5 at the I2, so
	// it straddles R9 => memory.  This is the isum5 / iface-data-ptr case.
	var withPrefix @[]@Type = make_slice(@Type, 6)
	withPrefix[0] = ptr
	for i := 1; i < 5; i++ { withPrefix[i] = i64 }
	withPrefix[5] = i2
	if !SysVArgInMemory(withPrefix, 5) { return "I2 after ptr+4 i64 straddles => memory" }
	return ""
}

// TestSysVArgInMemoryKinds: slices and iface-values (2-word aggregates) straddle
// like a 16-byte struct; a managed-slice (32B) and a >16 struct ride a single
// pointer and are never memory-class.
func TestSysVArgInMemoryKinds() testing.TestResult {
	setTarget64()
	SetArch(ARCH_X64)
	var i64 @Type = TypInt64()
	var slice @Type = MakeSliceType(i64)
	var iface @Type = MakeInterfaceValueType(MakeInterfaceType("m", "Iface"))
	var mslice @Type = MakeManagedSliceType(i64) // 32B => >16 => indirect pointer
	var big @Type = hfaStruct("Big24", threeTypes(i64, i64, i64)) // 24B

	// [i64 x5, X]: X lands at NGRN=5.
	if !SysVArgInMemory(fiveI64Then(slice), 5) { return "raw slice straddle => memory" }
	if !SysVArgInMemory(fiveI64Then(iface), 5) { return "iface-value straddle => memory" }
	if SysVArgInMemory(fiveI64Then(mslice), 5) {
		return "managed-slice (32B) rides a pointer, not memory"
	}
	if SysVArgInMemory(fiveI64Then(big), 5) { return "big24 (>16) rides a pointer, not memory" }
	return ""
}

// TestSysVArgInMemorySse: an SSE aggregate with the GP file exhausted goes to
// memory; one placed while both files have room does not.
func TestSysVArgInMemorySse() testing.TestResult {
	setTarget64()
	SetArch(ARCH_X64)
	var i64 @Type = TypInt64()
	var f64 @Type = TypFloat64()
	var sseIF @Type = am2("IF", i64, f64) // 1 INTEGER + 1 SSE eightbyte

	// [i64 x6, {i64,f64}]: GP file full (6) => the INTEGER eightbyte cannot be
	// placed => whole aggregate memory.
	var full @[]@Type = make_slice(@Type, 7)
	for i := 0; i < 6; i++ { full[i] = i64 }
	full[6] = sseIF
	if !SysVArgInMemory(full, 6) { return "SSE agg with GP file full => memory" }

	// [i64 x4, {i64,f64}]: INTEGER eightbyte -> R8, SSE eightbyte -> XMM0: fits.
	var fit @[]@Type = make_slice(@Type, 5)
	for i := 0; i < 4; i++ { fit[i] = i64 }
	fit[4] = sseIF
	if SysVArgInMemory(fit, 4) { return "SSE agg that fits must NOT be memory" }
	return ""
}
