package "pkg/binate/types"

import "pkg/builtins/testing"

// classEq reports whether the eightbyte class list cl equals want.
func classEq(cl @[]int, want @[]int) bool {
	if len(cl) != len(want) { return false }
	for i := 0; i < len(cl); i++ {
		if cl[i] != want[i] { return false }
	}
	return true
}

// twoInts builds a @[]int{a, b}; oneInt / three variants for the expected lists.
func oneInt(a int) @[]int {
	var r @[]int = make_slice(int, 1)
	r[0] = a
	return r
}
func twoInts(a int, b int) @[]int {
	var r @[]int = make_slice(int, 2)
	r[0] = a
	r[1] = b
	return r
}

// A struct of same-width floats classifies as all-SSE eightbytes: {f64,f64} is
// two SSE eightbytes (XMM0,XMM1), {f32,f32} is ONE SSE eightbyte (2xf32 packed),
// {f32,f32,f32} is two SSE eightbytes (<2 x float> + float).
func TestSysVAllFloat() testing.TestResult {
	setTarget64()
	var d2 @Type = hfaStruct("D2", hfaTypes2(TypFloat64(), TypFloat64()))
	if !classEq(SysVClassify(d2), twoInts(EB_SSE, EB_SSE)) {
		return fail("{f64,f64} is [SSE,SSE]")
	}
	var f2 @Type = hfaStruct("F2", hfaTypes2(TypFloat32(), TypFloat32()))
	if !classEq(SysVClassify(f2), oneInt(EB_SSE)) {
		return fail("{f32,f32} (8B) is one SSE eightbyte")
	}
	var f3 @Type = hfaStruct("F3", hfaTypes3(TypFloat32(), TypFloat32(), TypFloat32()))
	if !classEq(SysVClassify(f3), twoInts(EB_SSE, EB_SSE)) {
		return fail("{f32,f32,f32} (12B) is [SSE,SSE]")
	}
	return ""
}

// A MIXED-WIDTH float struct is still all-SSE under SysV (unlike an AAPCS64 HFA,
// which requires homogeneity): {f32,f64} lays f32 in eightbyte 0, f64 in
// eightbyte 1 — both SSE.
func TestSysVMixedWidthFloat() testing.TestResult {
	setTarget64()
	var fd @Type = hfaStruct("FD", hfaTypes2(TypFloat32(), TypFloat64()))
	if !classEq(SysVClassify(fd), twoInts(EB_SSE, EB_SSE)) {
		return fail("{f32,f64} is [SSE,SSE] (mixed width is SSE on x64)")
	}
	// And confirm HfaClassify (AAPCS64) REJECTS it (mixed width), proving the
	// two classifiers genuinely differ.
	n, _ := HfaClassify(fd)
	if n != 0 { return fail("{f32,f64} is NOT an AAPCS64 HFA (mixed width)") }
	return ""
}

// An eightbyte containing ANY non-float byte is INTEGER (the merge rule):
// {f64,i64} is [SSE,INTEGER]; {i32,f32} (one eightbyte, has an int) is [INTEGER].
func TestSysVMergeRule() testing.TestResult {
	setTarget64()
	var di @Type = hfaStruct("DI", hfaTypes2(TypFloat64(), TypInt64()))
	if !classEq(SysVClassify(di), twoInts(EB_SSE, EB_INTEGER)) {
		return fail("{f64,i64} is [SSE,INTEGER]")
	}
	var ifs @Type = hfaStruct("IF", hfaTypes2(TypInt32(), TypFloat32()))
	if !classEq(SysVClassify(ifs), oneInt(EB_INTEGER)) {
		return fail("{i32,f32} (8B, int in the eightbyte) is [INTEGER]")
	}
	return ""
}

// > 16 bytes is MEMORY (empty class list) — the aa64-vs-x64 divergence: a
// 24-byte {f64,f64,f64} is byval/sret on x64, but rides v0..v2 on aa64.
func TestSysVMemory() testing.TestResult {
	setTarget64()
	var d3 @Type = hfaStruct("D3", hfaTypes3(TypFloat64(), TypFloat64(), TypFloat64()))
	if len(SysVClassify(d3)) != 0 {
		return fail("{f64,f64,f64} (24B) is MEMORY (empty class list) on x64")
	}
	// But it IS an AAPCS64 HFA (3 members) — again proving divergence.
	if HfaMemberCount(d3) != 3 { return fail("{f64,f64,f64} is a 3-member aa64 HFA") }
	// A scalar / non-aggregate classifies as empty (not a per-eightbyte agg).
	if len(SysVClassify(TypFloat64())) != 0 { return fail("a scalar float is not classified") }
	return ""
}

// Nested structs / arrays flatten to the same byte-chunk classification.
func TestSysVNested() testing.TestResult {
	setTarget64()
	var inner @Type = hfaStruct("Inner", hfaTypes2(TypFloat32(), TypFloat32()))
	var outer @Type = hfaStruct("Outer", hfaTypes2(inner, TypFloat64()))  // {{f32,f32},f64} 16B
	if !classEq(SysVClassify(outer), twoInts(EB_SSE, EB_SSE)) {
		return fail("{{f32,f32},f64} is [SSE,SSE]")
	}
	var arr @Type = MakeArrayType(TypFloat64(), 2)  // [2]f64 = 16B
	if !classEq(SysVClassify(arr), twoInts(EB_SSE, EB_SSE)) {
		return fail("[2]f64 is [SSE,SSE]")
	}
	return ""
}

// An INTEGER byte anywhere in an eightbyte makes THAT eightbyte INTEGER,
// independent of the field's position within it (int-first, int-last, a sub-word
// int, or a whole-word int in either eightbyte).  Differential-tested against
// clang x86_64.
func TestSysVIntPlacement() testing.TestResult {
	setTarget64()
	// int8 first vs last in an 8-byte eightbyte: either way [INTEGER].
	var i8f @Type = hfaStruct("I8F", hfaTypes2(TypInt8(), TypFloat32()))
	if !classEq(SysVClassify(i8f), oneInt(EB_INTEGER)) {
		return fail("{i8,f32} (int first) is [INTEGER]")
	}
	var fi8 @Type = hfaStruct("FI8", hfaTypes2(TypFloat32(), TypInt8()))
	if !classEq(SysVClassify(fi8), oneInt(EB_INTEGER)) {
		return fail("{f32,i8} (int last) is [INTEGER]")
	}
	// A sub-word int only downgrades ITS eightbyte: {f32,f32,i32} = [SSE,INTEGER].
	var ffi @Type = hfaStruct("FFI", hfaTypes3(TypFloat32(), TypFloat32(), TypInt32()))
	if !classEq(SysVClassify(ffi), twoInts(EB_SSE, EB_INTEGER)) {
		return fail("{f32,f32,i32} is [SSE,INTEGER]")
	}
	// A whole-word int in the second eightbyte: {f64,i32} = [SSE,INTEGER].
	var di @Type = hfaStruct("DI2", hfaTypes2(TypFloat64(), TypInt32()))
	if !classEq(SysVClassify(di), twoInts(EB_SSE, EB_INTEGER)) {
		return fail("{f64,i32} is [SSE,INTEGER]")
	}
	return ""
}

// Arrays classify by the same byte-chunk rule: [2]f32 packs into ONE SSE
// eightbyte, [4]f32 into two, and a mixed all-int array stays INTEGER.
func TestSysVArrays() testing.TestResult {
	setTarget64()
	if !classEq(SysVClassify(MakeArrayType(TypFloat32(), 2)), oneInt(EB_SSE)) {
		return fail("[2]f32 (8B) is one SSE eightbyte")
	}
	if !classEq(SysVClassify(MakeArrayType(TypFloat32(), 4)), twoInts(EB_SSE, EB_SSE)) {
		return fail("[4]f32 (16B) is [SSE,SSE]")
	}
	if !classEq(SysVClassify(MakeArrayType(TypInt64(), 2)), twoInts(EB_INTEGER, EB_INTEGER)) {
		return fail("[2]i64 is [INTEGER,INTEGER]")
	}
	// {f32, [2]f32}: f32 in eightbyte 0, array straddles into eightbyte 1 — all SSE.
	var fa @Type = hfaStruct("FA", hfaTypes2(TypFloat32(), MakeArrayType(TypFloat32(), 2)))
	if !classEq(SysVClassify(fa), twoInts(EB_SSE, EB_SSE)) {
		return fail("{f32,[2]f32} (12B) is [SSE,SSE]")
	}
	return ""
}

// SysVInSse is dormant while SysVSseInRegs() is off: even a genuine SSE
// aggregate is not SSE-passed (the landed state), so codegen/native stay on the
// GP path.  (Flips to arch-gated behavior at the Stage-4 flip.)
func TestSysVInSseDormant() testing.TestResult {
	setTarget64()
	if SysVSseInRegs() { return fail("SysVSseInRegs() is false in the landed dormant state") }
	var d2 @Type = hfaStruct("D2", hfaTypes2(TypFloat64(), TypFloat64()))
	if SysVInSse(d2) { return fail("SysVInSse is false while SysVSseInRegs() is off") }
	return ""
}
