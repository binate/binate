package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/stdx/slices"

// Building a package scope from a parsed .bni interface file.
// LoadPackageInterface in checker.bn is the public entry; it
// installs the produced scope on the Checker. Phase 1 pre-
// registers type-name placeholders so forward / mutually-
// recursive type references resolve, then Phase 2 resolves
// the actual definitions.

// ============================================================
// Build scope from .bni file
// ============================================================

// defineBniConst registers an imported `.bni` const, folding its initializer
// to a value so importers can use it where a constant integer is required —
// an array dimension (`[pkg.SZ]int`) or, critically, the negative-shift-count
// gate (`x << pkg.NEG`).  Without the folded value the const is defined
// value-less and evalConstIntValue's selector arm yields ok=false, so a
// negative imported count slips past the gate and silently miscompiles to 0.
// The fold mirrors IR-gen's evalConstExpr, keeping the checker's view of an
// imported const consistent with the value codegen emits.  The const is
// defined in BOTH the package scope `s` (read by importers via
// resolveQualifiedSym) and the temp build scope `c.Scope` (so a later sibling
// const in the same `.bni` can reference this one while folding).  A const
// that does not fold to an integer (a non-integer type, an initializer
// evalConstIntValue can't reduce — e.g. iota — or one that references another
// package's const; see the selector guard below) falls back to value-less, as
// before.
func defineBniConst(c @Checker, s @Scope, name @[]char, typ @Type,
		valueExpr @ast.Expr) {
	// Do NOT fold an initializer that references a cross-package selector
	// (`const X = otherpkg.Y`).  The checker CAN resolve it here (otherpkg's
	// scope is loaded), but IR-gen's RegisterImport folds it via THIS .bni's
	// local import alias and DROPS it to a garbage value when the top-level
	// importer doesn't also import otherpkg.  Folding here while IR-gen drops
	// makes the checker's const value disagree with the value codegen emits —
	// a silent wrong-size array / wrong shift.  Leaving it value-less keeps the
	// two consistent: the use site is cleanly rejected ("not a constant
	// integer") rather than silently miscompiled.  TODO: drop this guard once
	// IR-gen folds transitive .bni consts consistently (claude-todo.md).
	if valueExpr == nil || exprRefsSelector(valueExpr) {
		defineConst(s, name, typ)
		defineConst(c.Scope, name, typ)
		return
	}
	var iv int
	var ok bool
	iv, ok = evalConstIntValue(c, valueExpr)
	if typ != nil && typ.IsInteger() && ok {
		defineConstVal(s, name, typ, iv)
		defineConstVal(c.Scope, name, typ, iv)
		return
	}
	defineConst(s, name, typ)
	defineConst(c.Scope, name, typ)
}

// exprRefsSelector reports whether e contains a package-qualified selector
// (`pkg.Name`) anywhere in its tree — used to keep defineBniConst from folding
// a `.bni` const whose value transitively reads another package's const (which
// IR-gen cannot fold consistently at scope-build time; see defineBniConst).
func exprRefsSelector(e @ast.Expr) bool {
	if e == nil {
		return false
	}
	if e.Kind == ast.EXPR_SELECTOR {
		return true
	}
	if e.Kind == ast.EXPR_UNARY {
		return exprRefsSelector(e.X)
	}
	if e.Kind == ast.EXPR_BINARY {
		return exprRefsSelector(e.X) || exprRefsSelector(e.Y)
	}
	if e.Kind == ast.EXPR_BUILTIN || e.Kind == ast.EXPR_CALL {
		for i := 0; i < len(e.Args); i++ {
			if exprRefsSelector(e.Args[i]) {
				return true
			}
		}
		return false
	}
	return false
}

// buildScopeFromFile builds a package scope from a parsed .bni file's declarations.
func buildScopeFromFile(c @Checker, f @ast.File) @Scope {
	var s @Scope = NewScope(nil)

	var savedScope @Scope = c.Scope
	c.Scope = NewScope(c.Scope) // temp scope on top of universe

	// Register imports for qualified type resolution
	for i := 0; i < len(f.Imports); i++ {
		var imp @ast.ImportSpec = f.Imports[i]
		var path @[]char = stripQuotes(imp.Path)
		var name @[]char = imp.Alias
		if len(name) == 0 {
			name = lastPathSegment(path)
		}
		if lookupPackage(c, path) != nil {
			definePkg(c.Scope, name, path)
		}
	}

	// Pass 1: Pre-register type names as placeholders. Interface
	// declarations also pre-register here (with empty method sets)
	// so cross-references in interface method signatures resolve
	// regardless of declaration order — same pattern as type
	// placeholders. Aliases (`interface X = Y`) are deferred to
	// Pass 2 since they need their target resolved first.
	for i := 0; i < len(f.Decls); i++ {
		var d @ast.Decl = f.Decls[i]
		if d.Kind == ast.DECL_TYPE {
			// Slice 7b: generic type decls aren't representable as
			// a single named placeholder (T is unbound at decl
			// time).  Stash the AST in GenericTypeDecls under the
			// pkg short-name so cross-pkg use sites can find it.
			if len(d.TypeParams) > 0 {
				c.GenericTypeDecls = slices.Append[@ast.Decl](
					c.GenericTypeDecls, d)
				c.GenericTypeDeclPkgs = slices.Append[@[]char](
					c.GenericTypeDeclPkgs,
					buf.CopyStr(c.curPkgShort))
				continue
			}
			var placeholder @Type = MakeNamedType(d.Name)
			defineType(s, d.Name, placeholder)
			defineType(c.Scope, d.Name, placeholder)
		}
		if d.Kind == ast.DECL_INTERFACE && !d.IsAlias {
			// Slice 7c: same treatment for generic interface decls.
			if len(d.TypeParams) > 0 {
				c.GenericIfaceDecls = slices.Append[@ast.Decl](
					c.GenericIfaceDecls, d)
				c.GenericIfaceDeclPkgs = slices.Append[@[]char](
					c.GenericIfaceDeclPkgs,
					buf.CopyStr(c.curPkgShort))
				continue
			}
			var iface @Type = MakeInterfaceType(c.curPkgShort, d.Name)
			defineInterface(s, d.Name, iface)
			defineInterface(c.Scope, d.Name, iface)
		}
		if d.Kind == ast.DECL_GROUP {
			for j := 0; j < len(d.Decls); j++ {
				var inner @ast.Decl = d.Decls[j]
				if inner.Kind == ast.DECL_TYPE {
					if len(inner.TypeParams) > 0 {
						c.GenericTypeDecls = slices.Append[@ast.Decl](
							c.GenericTypeDecls, inner)
						c.GenericTypeDeclPkgs =
							slices.Append[@[]char](
								c.GenericTypeDeclPkgs,
								buf.CopyStr(c.curPkgShort))
						continue
					}
					var placeholder @Type = MakeNamedType(inner.Name)
					defineType(s, inner.Name, placeholder)
					defineType(c.Scope, inner.Name, placeholder)
				}
			}
		}
	}

	// Pass 2: Resolve declarations
	for i := 0; i < len(f.Decls); i++ {
		var d @ast.Decl = f.Decls[i]
		// Slice 7a/b/c: skip generic decls — they're stashed in
		// c.GenericDecls / GenericTypeDecls / GenericIfaceDecls
		// in Pass 1 (struct/iface) or here below (funcs).  Their
		// signatures / bodies can't be resolved at decl-load time
		// because the type-params are unbound.
		if d.Kind == ast.DECL_TYPE && len(d.TypeParams) > 0 {
			continue
		}
		if d.Kind == ast.DECL_INTERFACE && len(d.TypeParams) > 0 {
			continue
		}
		if d.Kind == ast.DECL_FUNC {
			var ft @Type = resolveFuncDeclType(c, d)
			defineFunc(s, d.Name, ft)
		}
		if d.Kind == ast.DECL_CONST {
			var typ @Type
			if d.TypeRef != nil {
				typ = resolveTypeExpr(c, d.TypeRef)
			} else {
				typ = TypInt()
			}
			defineBniConst(c, s, d.Name, typ, d.Value)
		}
		// A `.bni` `var X T` is an extern declaration (storage defined in
		// the package's `.bn`).  It must carry an explicit type — there is
		// no initializer to infer from.  Defined as SYM_VAR so importers
		// resolve `pkg.X` and the defining package can cross-check its
		// `.bn` definition against this declaration (checkBniVarMatch).
		if d.Kind == ast.DECL_VAR && d.TypeRef != nil {
			var vtyp @Type = resolveTypeExpr(c, d.TypeRef)
			if vtyp != nil {
				defineVar(s, d.Name, vtyp)
			}
		}
		if d.Kind == ast.DECL_TYPE {
			resolveTypeDeclInScope(c, s, d)
		}
		if d.Kind == ast.DECL_INTERFACE {
			resolveInterfaceDeclInScope(c, s, d)
		}
		if d.Kind == ast.DECL_GROUP {
			var groupType @Type = nil
			for j := 0; j < len(d.Decls); j++ {
				var inner @ast.Decl = d.Decls[j]
				if inner.Kind == ast.DECL_CONST {
					var typ @Type
					if inner.TypeRef != nil {
						typ = resolveTypeExpr(c, inner.TypeRef)
						groupType = typ
					} else if groupType != nil {
						typ = groupType
					} else {
						typ = TypInt()
					}
					defineBniConst(c, s, inner.Name, typ, inner.Value)
				}
				if inner.Kind == ast.DECL_TYPE {
					resolveTypeDeclInScope(c, s, inner)
				}
			}
		}
	}

	c.Scope = savedScope
	return s
}

// resolveInterfaceDeclInScope populates the methods of an interface
// pre-registered by Pass 1, or registers the alias for an alias-form
// `interface X = Y` declaration. Mirrors collectInterfaceDecl in
// check_interface.bn but writes into the bni's package scope `s`
// alongside the temp checker scope `c.Scope`. Slice 2.7 of plan-
// cross-package-interfaces.md.
func resolveInterfaceDeclInScope(c @Checker, s @Scope,
		d @ast.Decl) {
	if d.IsAlias {
		if d.TypeRef == nil { return }
		var target @Type = resolveTypeExprAllowInterface(c,
			d.TypeRef)
		if target == nil || target.Kind != TYP_INTERFACE { return }
		defineInterface(s, d.Name, target)
		defineInterface(c.Scope, d.Name, target)
		return
	}
	var sym @Symbol = s.Lookup(d.Name)
	if sym == nil || sym.Kind != SYM_INTERFACE { return }
	var iface @Type = sym.Type
	for i := 0; i < len(d.Decls); i++ {
		var m @ast.Decl = d.Decls[i]
		if m == nil || m.Kind != ast.DECL_FUNC { continue }
		// `Self` is valid in method arg/result types only.
		// Mirrors the AllowSelf gate in check_interface.bn so
		// .bni-declared interfaces (e.g., pkg/builtins/lang's Comparable
		// with `Compare(other Self) int`) resolve cleanly.
		var prevAllowSelf bool = c.AllowSelf
		c.AllowSelf = true
		var ft @Type = resolveFuncDeclType(c, m)
		c.AllowSelf = prevAllowSelf
		var method @Method = MakeMethod(m.Name, iface, ft)
		iface.AddMethod(method)
	}
	// plan-interface-embedding.md Slice E.2: propagate parents
	// for an interface declared in a .bni file the same way as
	// for a .bn-declared interface.  Parents resolved here go
	// through `c.Scope`, which has been populated by Pass 1
	// (so same-file forward references to other interfaces in
	// the .bni resolve).
	resolveInterfaceExtension(c, d, iface)
}

// resolveTypeDeclInScope resolves a type declaration and updates its placeholder in the scope.
// Forward declarations (IsForward, no TypeRef) leave the
// placeholder's Underlying nil — the type stays opaque to
// importers; the impl package's `.bn` provides the layout when
// the package itself is compiled.  See plan-type-decls.md Phase 3.
func resolveTypeDeclInScope(c @Checker, s @Scope, d @ast.Decl) {
	if d.IsForward {
		return
	}
	var resolved @Type = resolveTypeExpr(c, d.TypeRef)
	var sym @Symbol = s.Lookup(d.Name)
	if sym != nil && sym.Kind == SYM_TYPE {
		if d.IsAlias {
			var alias @Type = MakeAliasType(d.Name, resolved)
			sym.Type = alias
			// Also update in checker's temp scope
			var scopeSym @Symbol = c.Scope.Lookup(d.Name)
			if scopeSym != nil {
				scopeSym.Type = alias
			}
		} else {
			// Named type — set underlying
			if sym.Type.Kind == TYP_NAMED {
				sym.Type.Underlying = resolved
				// If it's a struct, set the (qualified) name
				if resolved.Kind == TYP_STRUCT {
					resolved.Name = QualifyName(c.curPkgPath, d.Name)
				}
			}
		}
	}
}
