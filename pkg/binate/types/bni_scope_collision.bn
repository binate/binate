package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/stdx/slices"

// Import-alias-vs-declaration collision checking over a package's merged file.

// checkImportDeclCollisions reports an import alias that collides with a
// package-level declaration of the same name.  registerImports defines the
// import's SYM_PKG and collectDecls defines the decl's symbol via the same
// overwriting Scope.Define, and checkDuplicateDecls compares decls-to-decls
// only — so the clash is otherwise silent: the decl wins and the import is
// shadowed (or, for a type, the build fails with no diagnostic).  Flag it.
//
// Runs on the merged file: merged.Imports (the deduped union, each spec keeping
// its source Pos) vs merged.Decls names, so it covers a same-package alias/decl
// clash whether they're in one file or split across files.
func checkImportDeclCollisions(c @Checker, file @ast.File) {
	if file == nil || len(file.Imports) == 0 { return }
	var names @[]@[]char = collectDeclNames(file.Decls)
	for i := 0; i < len(file.Imports); i++ {
		var imp @ast.ImportSpec = file.Imports[i]
		var alias @[]char = imp.Alias
		if len(alias) == 0 {
			alias = buf.CopyStr(lastPathSegment(stripQuotes(imp.Path)))
		}
		// Blank imports introduce no name, so they can't collide.
		if charEq(alias, "_") { continue }
		if nameInSlice(names, alias) {
			addCheckError(c, imp.Pos,
					buf.Concat(alias, ": import alias conflicts with a declaration of the same name"))
		}
	}
}

// collectDeclNames returns the names of package-level declarations that share
// the value/type namespace with import aliases (funcs, vars, consts, types,
// interfaces), recursing into groups.  Methods (Recv != nil) live in a type's
// method set, not the package namespace, and impls have no name — both skipped.
// An `expose` decl contributes no name of its own (its Name field is the target
// package PATH, not a declared name; the re-exported members enter the scope by
// injection, not through this list) — skipped.
func collectDeclNames(decls @[]@ast.Decl) @[]@[]char {
	var names @[]@[]char
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_GROUP {
			var sub @[]@[]char = collectDeclNames(d.Decls)
			for j := 0; j < len(sub); j++ {
				names = slices.Append[@[]char](names, sub[j])
			}
			continue
		}
		if d.Kind == ast.DECL_IMPL { continue }
		if d.Kind == ast.DECL_EXPOSE { continue }
		if d.Kind == ast.DECL_FUNC && d.Recv != nil { continue }
		if len(d.Name) == 0 { continue }
		names = slices.Append[@[]char](names, d.Name)
	}
	return names
}

// nameInSlice reports whether `n` is in `names`.
func nameInSlice(names @[]@[]char, n *[]readonly char) bool {
	for i := 0; i < len(names); i++ {
		if charEq(names[i], n) { return true }
	}
	return false
}
