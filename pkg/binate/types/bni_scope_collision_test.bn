package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/builtins/testing"

// Tests for bni_scope_collision.bn.  mkBniFile is shared from bni_scope_test.bn.

// TestCheckImportDeclCollisionsFlagsClash: an import alias matching a
// package-level declaration name is reported.
func TestCheckImportDeclCollisionsFlagsClash() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile("package \"a\"\nimport \"pkg/foo\"\nfunc foo()\n")
	checkImportDeclCollisions(c, f)
	if len(c.CheckerErrors()) == 0 {
		return fail("expected a collision error for import alias `foo` vs func foo")
	}
	return ""
}

// TestCheckImportDeclCollisionsNoClash: distinct names produce no error.
func TestCheckImportDeclCollisionsNoClash() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile("package \"a\"\nimport \"pkg/foo\"\nfunc bar()\n")
	checkImportDeclCollisions(c, f)
	if len(c.CheckerErrors()) != 0 {
		return fail("no collision expected for distinct names")
	}
	return ""
}

// TestCollectDeclNamesSkipsMethods: collectDeclNames returns package-namespace
// names (funcs, types, consts) but NOT methods (Recv != nil), which belong to a
// type's method set rather than the package namespace.
func TestCollectDeclNamesSkipsMethods() testing.TestResult {
	var f @ast.File = mkBniFile(
			"package \"a\"\n"
					"type T struct { x int }\n"
					"func Free()\n"
					"func (t *T) M()\n"
					"const K int = 1\n")
	var names @[]@[]char = collectDeclNames(f.Decls)
	// T, Free, K -> 3 names; the method M is skipped.
	if len(names) != 3 {
		return fail("expected 3 package-namespace names (T, Free, K); method skipped")
	}
	if !nameInSlice(names, "T") || !nameInSlice(names, "Free") || !nameInSlice(names, "K") {
		return fail("collectDeclNames missing an expected name")
	}
	if nameInSlice(names, "M") {
		return fail("method M must not be in the package namespace")
	}
	if nameInSlice(names, "Nope") {
		return fail("nameInSlice false positive")
	}
	return ""
}
