package "pkg/binate/types"

import "pkg/binate/ast"

// `expose "P"` whole-package re-export, at the checker/scope layer.

// injectExposedSurface implements `expose "P"`: for each such declaration in
// package A's .bni AST (f), it copies every EXPORTED symbol of the already-built
// package P into A's surface scope s, so `A.X` type-resolves to P's X with P's
// identity.
//
// Identity is preserved by SHARING P's `.Type` pointer — types/interfaces (and
// the impls that dispatch on them) resolve through the same @Type, so no
// re-export of impls is needed.  Each copied symbol is a NEW @Symbol (never P's
// original, which must not be mutated) stamped with its resolved HomePkg: P's
// path, or — for a symbol P itself re-exposed from Q — Q's already-stamped
// HomePkg, so transitivity (A exposes P exposes Q) mangles a Q-origin member to
// Q rather than P.
//
// Ordering this relies on: P is registered and fully scope-built before A.  The
// loader makes each `expose "P"` a dependency edge (recordExposes appends P to
// A.Imports), so P precedes A in ldr.Order and the driver runs
// LoadPackageInterface(P) before A.  SYM_PKG symbols (P's own import aliases)
// are NOT part of P's exported surface and are skipped.  Name collisions (two
// exposes, or an expose vs A's own decl) are the concern of a separate pass, not
// this one — Scope.Define silently overwrites, so detection must read the raw
// per-package symbol lists elsewhere.
func injectExposedSurface(c @Checker, s @Scope, f @ast.File) {
	if f == nil { return }
	for i := 0; i < len(f.Decls); i++ {
		if f.Decls[i].Kind != ast.DECL_EXPOSE { continue }
		var path @[]char = stripQuotes(f.Decls[i].Name)
		var pScope @Scope = lookupPackage(c, path)
		if pScope == nil { continue }
		for j := 0; j < len(pScope.Syms); j++ {
			var src @Symbol = pScope.Syms[j]
			if src.Kind == SYM_PKG { continue }
			var sym @Symbol = make(Symbol)
			sym.Name = src.Name
			sym.Type = src.Type
			sym.Kind = src.Kind
			sym.PkgPath = src.PkgPath
			sym.ConstVal = src.ConstVal
			sym.HasConstVal = src.HasConstVal
			// A transitively re-exposed symbol keeps its origin (Q); otherwise
			// the directly-exposing package P is the home.
			if len(src.HomePkg) > 0 {
				sym.HomePkg = src.HomePkg
			} else {
				sym.HomePkg = path
			}
			// Propagate a transitively-exposed generic marker (P was itself a
			// forwarder): its home is already stamped above, keep the flag.
			sym.IsGeneric = src.IsGeneric
			s.Define(sym)
		}
		// P's OWN generic decls have no scope symbol, so the Syms copy above
		// misses them; inject a marker for each so PackageMemberHome reports
		// their home.
		injectExposedGenericMarkers(c, s, path)
	}
}

// injectExposedGenericMarkers injects a bare `IsGeneric` marker into the
// forwarder scope `s` for each generic type / interface decl the exposed package
// `path` declares itself (keyed under `path` in the generic-decl registries).  A
// transitively-exposed generic instead rides through the Syms copy in
// injectExposedSurface as an already-injected marker.
func injectExposedGenericMarkers(c @Checker, s @Scope, path @[]char) {
	for i := 0; i < len(c.GenericTypeDecls) && i < len(c.GenericTypeDeclPkgs); i++ {
		if !charEq(c.GenericTypeDeclPkgs[i], path) { continue }
		s.Define(makeGenericMarker(c.GenericTypeDecls[i].Name, path, SYM_TYPE))
	}
	for i := 0; i < len(c.GenericIfaceDecls) && i < len(c.GenericIfaceDeclPkgs); i++ {
		if !charEq(c.GenericIfaceDeclPkgs[i], path) { continue }
		s.Define(makeGenericMarker(c.GenericIfaceDecls[i].Name, path, SYM_INTERFACE))
	}
}

// makeGenericMarker builds a bare exposed-generic marker symbol: Name + Kind +
// HomePkg + IsGeneric, with no usable Type (a bare reference to it is rejected).
func makeGenericMarker(name @[]char, home @[]char, kind int) @Symbol {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Kind = kind
	sym.HomePkg = home
	sym.IsGeneric = true
	return sym
}
