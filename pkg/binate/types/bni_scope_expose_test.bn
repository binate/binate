package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for expose scope injection (injectExposedSurface, exercised end-to-end
// through LoadPackageInterface -> buildScopeFromFile).  mkBniFile is shared from
// bni_scope_test.bn.  Order of LoadPackageInterface calls mirrors ldr.Order: an
// exposed package is loaded before the package that exposes it.

// TestExposeInjectsTypeWithIdentity: `expose "pkg/p"` copies P's exported type
// into A's surface, SHARING the same @Type (identity) and stamping HomePkg = P.
func TestExposeInjectsTypeWithIdentity() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/p", mkBniFile("package \"p\"\ntype Pt struct { x int }\n"))
	c.LoadPackageInterface("pkg/a", mkBniFile("package \"a\"\nexpose \"pkg/p\"\n"))

	var pScope @Scope = lookupPackage(c, "pkg/p")
	var aScope @Scope = lookupPackage(c, "pkg/a")
	if pScope == nil || aScope == nil { return fail("p or a scope missing") }

	var pSym @Symbol = pScope.Lookup("Pt")
	var aSym @Symbol = aScope.Lookup("Pt")
	if pSym == nil { return fail("Pt missing from p") }
	if aSym == nil { return fail("Pt was not injected into a") }
	if aSym.Kind != SYM_TYPE { return fail("injected Pt should be SYM_TYPE") }
	if !same(aSym.Type, pSym.Type) {
		return fail("injected Pt must share P's @Type (identity), not a copy")
	}
	if !charEq(aSym.HomePkg, "pkg/p") {
		return fail("injected Pt HomePkg should be pkg/p")
	}
	return ""
}

// TestExposeInjectsFunc: exposed funcs are injected as SYM_FUNC with HomePkg = P.
func TestExposeInjectsFunc() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/p", mkBniFile("package \"p\"\nfunc Add(a int, b int) int\n"))
	c.LoadPackageInterface("pkg/a", mkBniFile("package \"a\"\nexpose \"pkg/p\"\n"))

	var aScope @Scope = lookupPackage(c, "pkg/a")
	if aScope == nil { return fail("a scope missing") }
	var aSym @Symbol = aScope.Lookup("Add")
	if aSym == nil { return fail("Add was not injected into a") }
	if aSym.Kind != SYM_FUNC { return fail("injected Add should be SYM_FUNC") }
	if !charEq(aSym.HomePkg, "pkg/p") { return fail("injected Add HomePkg should be pkg/p") }
	return ""
}

// TestExposeInjectsInterface: exposed interfaces are injected as SYM_INTERFACE
// with shared @Type identity and HomePkg stamped, so an impl of the exposed
// interface dispatches through P's interface identity (design §3.2).
func TestExposeInjectsInterface() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/p", mkBniFile("package \"p\"\ninterface Speaker { Speak() }\n"))
	c.LoadPackageInterface("pkg/a", mkBniFile("package \"a\"\nexpose \"pkg/p\"\n"))

	var pScope @Scope = lookupPackage(c, "pkg/p")
	var aScope @Scope = lookupPackage(c, "pkg/a")
	if pScope == nil || aScope == nil { return fail("p or a scope missing") }

	var pSym @Symbol = pScope.Lookup("Speaker")
	var aSym @Symbol = aScope.Lookup("Speaker")
	if pSym == nil { return fail("Speaker missing from p") }
	if aSym == nil { return fail("Speaker was not injected into a") }
	if aSym.Kind != SYM_INTERFACE { return fail("injected Speaker should be SYM_INTERFACE") }
	if !same(aSym.Type, pSym.Type) {
		return fail("injected Speaker must share P's interface @Type (identity)")
	}
	if !charEq(aSym.HomePkg, "pkg/p") {
		return fail("injected Speaker HomePkg should be pkg/p")
	}
	return ""
}

// TestExposeTransitive: A exposes P, P exposes Q — Q's members reach A flat, and
// their HomePkg stays Q (the origin is preserved through the re-export chain, so
// a later phase mangles A.Qt to Q, not P).
func TestExposeTransitive() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/q", mkBniFile("package \"q\"\ntype Qt struct { v int }\n"))
	c.LoadPackageInterface("pkg/p", mkBniFile("package \"p\"\nexpose \"pkg/q\"\n"))
	c.LoadPackageInterface("pkg/a", mkBniFile("package \"a\"\nexpose \"pkg/p\"\n"))

	var aScope @Scope = lookupPackage(c, "pkg/a")
	if aScope == nil { return fail("a scope missing") }
	var aSym @Symbol = aScope.Lookup("Qt")
	if aSym == nil { return fail("Qt did not reach a transitively") }
	if aSym.Kind != SYM_TYPE { return fail("Qt should be SYM_TYPE") }
	if !charEq(aSym.HomePkg, "pkg/q") {
		return fail("transitive Qt HomePkg should stay pkg/q, not pkg/p")
	}
	return ""
}

// TestExposeGenericTypeHome: an exposed GENERIC type has no scope symbol of its
// own in P (only a generic-decl registry entry), so the Syms copy in
// injectExposedSurface misses it — injectExposedGenericMarkers must inject a
// marker so PackageMemberHome(forwarder, Box) still reports P.  This is the home
// remap the qualified-generic resolution relies on; a whole-generic-package
// forwarder (pkg/stdx/{cmp,hash} exposing pkg/std/{cmp,hash}) is USELESS without
// it, since every member is generic.
func TestExposeGenericTypeHome() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/p", mkBniFile("package \"p\"\ntype Box[T any] struct { v T }\n"))
	c.LoadPackageInterface("pkg/a", mkBniFile("package \"a\"\nexpose \"pkg/p\"\n"))

	var aScope @Scope = lookupPackage(c, "pkg/a")
	if aScope == nil { return fail("a scope missing") }
	var aSym @Symbol = aScope.Lookup("Box")
	if aSym == nil { return fail("generic Box marker was not injected into a") }
	if !aSym.IsGeneric { return fail("injected Box marker should be IsGeneric") }
	if !charEq(c.PackageMemberHome("pkg/a", "Box"), "pkg/p") {
		return fail("exposed generic Box should report home pkg/p through the forwarder")
	}
	return ""
}

// mkTestPkgAlias builds an `import alias "path"` package-alias symbol, so a test
// can populate a consumer's scope with the aliases a qualified reference resolves
// through.
func mkTestPkgAlias(name @[]char, path @[]char) @Symbol {
	var s @Symbol = make(Symbol)
	s.Name = name
	s.Kind = SYM_PKG
	s.PkgPath = path
	return s
}

// TestResolveQualifiedGenericDeclPkgRemapsForwarder: the shared qualifier resolver
// (used by all three qualified-generic sites — type expr, generic-call type-arg,
// method-expr head) remaps a FORWARDER qualifier to the exposed generic's HOME
// package (where its decl is registered), and leaves a DIRECT qualifier as its
// own path.  Regression for: `fwd.Gen[X]` resolving `undefined` outside the plain
// type-expression position.
func TestResolveQualifiedGenericDeclPkgRemapsForwarder() testing.TestResult {
	var c @Checker = NewChecker()
	var genSrc @[]char = "package \"genlib\"\ntype Box[T any] struct { v T }\n"
	c.LoadPackageInterface("pkg/genlib", mkBniFile(genSrc))
	c.LoadPackageInterface("pkg/fwd", mkBniFile("package \"fwd\"\nexpose \"pkg/genlib\"\n"))

	// Simulate a consumer's `import fwd "pkg/fwd"` + `import genlib "pkg/genlib"`.
	c.Scope.Define(mkTestPkgAlias("fwd", "pkg/fwd"))
	c.Scope.Define(mkTestPkgAlias("genlib", "pkg/genlib"))

	// Forwarder qualifier -> Box's HOME (pkg/genlib), where the generic decl lives.
	if !charEq(resolveQualifiedGenericDeclPkg(c, "fwd", "Box"), "pkg/genlib") {
		return fail("forwarder qualifier `fwd` should remap to home pkg/genlib")
	}
	// Direct qualifier -> its own package (native generic: no marker, no remap).
	if !charEq(resolveQualifiedGenericDeclPkg(c, "genlib", "Box"), "pkg/genlib") {
		return fail("direct qualifier `genlib` should resolve to pkg/genlib")
	}
	// A qualifier that is not a known package falls back to its own text (a later
	// registry lookup then reports undefined).
	if !charEq(resolveQualifiedGenericDeclPkg(c, "nope", "Box"), "nope") {
		return fail("unknown qualifier should fall back to its own text")
	}
	return ""
}

// TestExposeNonexistentTargetNoCrash: exposing an unregistered package is
// harmless (the member simply doesn't appear; the missing package is reported
// elsewhere by the loader).
func TestExposeNonexistentTargetNoCrash() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/a", mkBniFile("package \"a\"\nexpose \"pkg/nope\"\n"))
	var aScope @Scope = lookupPackage(c, "pkg/a")
	if aScope == nil { return fail("a scope should still build") }
	if aScope.Lookup("Anything") != nil {
		return fail("nothing should be injected from an unregistered target")
	}
	return ""
}

// TestPackageMemberHome: the checker lookup Phase-4 resolved-home mangling routes
// through — an exposed member reports its origin package; a native member and any
// unknown package/member report empty.
func TestPackageMemberHome() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/p", mkBniFile("package \"p\"\nfunc Add(a int, b int) int\n"))
	c.LoadPackageInterface("pkg/a", mkBniFile("package \"a\"\nexpose \"pkg/p\"\n"))

	// A.Add is injected from P -> home is pkg/p.
	if !charEq(c.PackageMemberHome("pkg/a", "Add"), "pkg/p") {
		return fail("PackageMemberHome(pkg/a, Add) should be pkg/p (exposed member)")
	}
	// P's own Add is natively declared -> empty home.
	if len(c.PackageMemberHome("pkg/p", "Add")) != 0 {
		return fail("PackageMemberHome(pkg/p, Add) should be empty (native member)")
	}
	// Unknown member / unregistered package -> empty.
	if len(c.PackageMemberHome("pkg/a", "Missing")) != 0 {
		return fail("PackageMemberHome for an unknown member should be empty")
	}
	if len(c.PackageMemberHome("pkg/nope", "Add")) != 0 {
		return fail("PackageMemberHome for an unregistered package should be empty")
	}
	return ""
}
