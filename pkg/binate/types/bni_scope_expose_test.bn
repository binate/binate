package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for expose scope injection (injectExposedSurface, exercised end-to-end
// through LoadPackageInterface -> buildScopeFromFile).  mkBniFile is shared from
// bni_scope_test.bn.  Order of LoadPackageInterface calls mirrors ldr.Order: an
// exposed package is loaded before the package that exposes it.

// TestExposeInjectsTypeWithIdentity: `expose "pkg/p"` copies P's exported type
// into A's surface, SHARING the same @Type (identity) and stamping HomePkg = P.
func TestExposeInjectsTypeWithIdentity() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/p", mkBniFile("package \"p\"\ntype Pt struct { x int }\n"))
	c.LoadPackageInterface("pkg/a", mkBniFile("package \"a\"\nexpose \"pkg/p\"\n"))

	var pScope @Scope = lookupPackage(c, "pkg/p")
	var aScope @Scope = lookupPackage(c, "pkg/a")
	if pScope == nil || aScope == nil { return fail("p or a scope missing") }

	var pSym @Symbol = pScope.Lookup("Pt")
	var aSym @Symbol = aScope.Lookup("Pt")
	if pSym == nil { return fail("Pt missing from p") }
	if aSym == nil { return fail("Pt was not injected into a") }
	if aSym.Kind != SYM_TYPE { return fail("injected Pt should be SYM_TYPE") }
	if !same(aSym.Type, pSym.Type) {
		return fail("injected Pt must share P's @Type (identity), not a copy")
	}
	if !charEq(aSym.HomePkg, "pkg/p") {
		return fail("injected Pt HomePkg should be pkg/p")
	}
	return ""
}

// TestExposeInjectsFunc: exposed funcs are injected as SYM_FUNC with HomePkg = P.
func TestExposeInjectsFunc() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/p", mkBniFile("package \"p\"\nfunc Add(a int, b int) int\n"))
	c.LoadPackageInterface("pkg/a", mkBniFile("package \"a\"\nexpose \"pkg/p\"\n"))

	var aScope @Scope = lookupPackage(c, "pkg/a")
	if aScope == nil { return fail("a scope missing") }
	var aSym @Symbol = aScope.Lookup("Add")
	if aSym == nil { return fail("Add was not injected into a") }
	if aSym.Kind != SYM_FUNC { return fail("injected Add should be SYM_FUNC") }
	if !charEq(aSym.HomePkg, "pkg/p") { return fail("injected Add HomePkg should be pkg/p") }
	return ""
}

// TestExposeInjectsInterface: exposed interfaces are injected as SYM_INTERFACE
// with shared @Type identity and HomePkg stamped, so an impl of the exposed
// interface dispatches through P's interface identity (design §3.2).
func TestExposeInjectsInterface() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/p", mkBniFile("package \"p\"\ninterface Speaker { Speak() }\n"))
	c.LoadPackageInterface("pkg/a", mkBniFile("package \"a\"\nexpose \"pkg/p\"\n"))

	var pScope @Scope = lookupPackage(c, "pkg/p")
	var aScope @Scope = lookupPackage(c, "pkg/a")
	if pScope == nil || aScope == nil { return fail("p or a scope missing") }

	var pSym @Symbol = pScope.Lookup("Speaker")
	var aSym @Symbol = aScope.Lookup("Speaker")
	if pSym == nil { return fail("Speaker missing from p") }
	if aSym == nil { return fail("Speaker was not injected into a") }
	if aSym.Kind != SYM_INTERFACE { return fail("injected Speaker should be SYM_INTERFACE") }
	if !same(aSym.Type, pSym.Type) {
		return fail("injected Speaker must share P's interface @Type (identity)")
	}
	if !charEq(aSym.HomePkg, "pkg/p") {
		return fail("injected Speaker HomePkg should be pkg/p")
	}
	return ""
}

// TestExposeTransitive: A exposes P, P exposes Q — Q's members reach A flat, and
// their HomePkg stays Q (the origin is preserved through the re-export chain, so
// a later phase mangles A.Qt to Q, not P).
func TestExposeTransitive() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/q", mkBniFile("package \"q\"\ntype Qt struct { v int }\n"))
	c.LoadPackageInterface("pkg/p", mkBniFile("package \"p\"\nexpose \"pkg/q\"\n"))
	c.LoadPackageInterface("pkg/a", mkBniFile("package \"a\"\nexpose \"pkg/p\"\n"))

	var aScope @Scope = lookupPackage(c, "pkg/a")
	if aScope == nil { return fail("a scope missing") }
	var aSym @Symbol = aScope.Lookup("Qt")
	if aSym == nil { return fail("Qt did not reach a transitively") }
	if aSym.Kind != SYM_TYPE { return fail("Qt should be SYM_TYPE") }
	if !charEq(aSym.HomePkg, "pkg/q") {
		return fail("transitive Qt HomePkg should stay pkg/q, not pkg/p")
	}
	return ""
}

// TestExposeNonexistentTargetNoCrash: exposing an unregistered package is
// harmless (the member simply doesn't appear; the missing package is reported
// elsewhere by the loader).
func TestExposeNonexistentTargetNoCrash() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("pkg/a", mkBniFile("package \"a\"\nexpose \"pkg/nope\"\n"))
	var aScope @Scope = lookupPackage(c, "pkg/a")
	if aScope == nil { return fail("a scope should still build") }
	if aScope.Lookup("Anything") != nil {
		return fail("nothing should be injected from an unregistered target")
	}
	return ""
}
