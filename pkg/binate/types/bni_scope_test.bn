package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for bni_scope.bn (buildScopeFromFile + resolveTypeDeclInScope).
// LoadPackageInterface (in checker.bn) is the public entry that wraps
// these — exercise through it for end-to-end coverage. Parsing
// .bni-shape source into ast.File is the parser's job; here we
// hand-build the parser pointed at the .bni mode.

func mkBniFile(src *[]readonly char) @ast.File {
	var b @[]uint8 = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ { b[i] = cast(uint8, src[i]) }
	var p @parser.Parser = parser.NewInterface(b, "test.bni")
	return p.ParseFile()
}

// A .bni-declared type must appear in the produced package scope as
// a SYM_TYPE binding. Without this the IR-gen / checker would be
// unable to resolve cross-package qualified type references.
func TestLoadPackageInterfaceTypeDecl() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile("package \"foo\"\ntype Pt struct { x int; y int }\n")
	c.LoadPackageInterface("foo", f)

	var pkgScope @Scope = lookupPackage(c, "foo")
	if pkgScope == nil {
		return fail("package scope for foo not found")
	}
	var sym @Symbol = pkgScope.Lookup("Pt")
	if sym == nil { return fail("Pt not in foo's scope") }
	if sym.Kind != SYM_TYPE { return fail("Pt should be SYM_TYPE") }
	return ""
}

// Checker.PackageType resolves a named type from a registered package's
// scope — the path IR-gen uses to get reflect.Package for the synthesized
// __Package() accessor (Phase B).  Returns nil for an unknown member or an
// unregistered package.
func TestPackageType() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile("package \"foo\"\ntype Pt struct { x int; y int }\n")
	c.LoadPackageInterface("foo", f)

	var t @Type = c.PackageType("foo", "Pt")
	if t == nil { return fail("PackageType(foo, Pt) should resolve the type") }
	if c.PackageType("foo", "Missing") != nil {
		return fail("PackageType for an unknown member should be nil")
	}
	if c.PackageType("nope", "Pt") != nil {
		return fail("PackageType for an unregistered package should be nil")
	}
	return ""
}

// A .bni-declared func must appear in scope as SYM_FUNC.
func TestLoadPackageInterfaceFuncDecl() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile("package \"foo\"\nfunc Add(a int, b int) int\n")
	c.LoadPackageInterface("foo", f)

	var pkgScope @Scope = lookupPackage(c, "foo")
	if pkgScope == nil { return fail("foo scope missing") }
	var sym @Symbol = pkgScope.Lookup("Add")
	if sym == nil { return fail("Add not in foo's scope") }
	if sym.Kind != SYM_FUNC { return fail("Add should be SYM_FUNC") }
	return ""
}

// A .bni-declared METHOD must NOT appear as a package-scope symbol: it
// belongs to its receiver type's method set.  Registering it in package
// scope would shadow a same-named free function.
func TestLoadPackageInterfaceMethodNotInScope() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile(
			"package \"foo\"\ntype Pt struct { x int }\nfunc (p *Pt) Stat() int\n")
	c.LoadPackageInterface("foo", f)

	var pkgScope @Scope = lookupPackage(c, "foo")
	if pkgScope == nil { return fail("foo scope missing") }
	if pkgScope.Lookup("Stat") != nil {
		return fail("method Stat must not be a package-scope symbol")
	}
	return ""
}

// A free function and a same-named method coexist: the package-scope name
// resolves to the FREE function (1 param), not the method (0 params).  This
// is the os.Stat (free) + File.Stat (method) pattern; before the method-skip
// in buildScopeFromFile, the method clobbered the free func in package scope
// and the free .bn func then mismatched ".bni declares 0 parameters".
func TestLoadPackageInterfaceFreeFuncAndMethodCoexist() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile(
			"package \"foo\"\ntype Pt struct { x int }\nfunc Stat(a int) int\nfunc (p *Pt) Stat() int\n")
	c.LoadPackageInterface("foo", f)

	var pkgScope @Scope = lookupPackage(c, "foo")
	if pkgScope == nil { return fail("foo scope missing") }
	var sym @Symbol = pkgScope.Lookup("Stat")
	if sym == nil { return fail("free func Stat missing from scope") }
	if sym.Kind != SYM_FUNC { return fail("Stat should be the free func (SYM_FUNC)") }
	if sym.Type == nil || sym.Type.Kind != TYP_FUNC {
		return fail("Stat symbol should carry a func type")
	}
	if len(sym.Type.Params) != 1 {
		return fail("package-scope Stat must be the free func (1 param), not the method (0)")
	}
	return ""
}

// A method must not shadow a same-named non-func package member: with a const
// Stat and a method (p *Pt) Stat, the package name resolves to the CONST.
// Before the method-skip, the method clobbered the const in package scope —
// the latent silent-shadowing the signature-mismatch error was a symptom of.
func TestLoadPackageInterfaceMethodDoesNotShadowConst() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile(
			"package \"foo\"\ntype Pt struct { x int }\nconst Stat int = 7\nfunc (p *Pt) Stat() int\n")
	c.LoadPackageInterface("foo", f)

	var pkgScope @Scope = lookupPackage(c, "foo")
	if pkgScope == nil { return fail("foo scope missing") }
	var sym @Symbol = pkgScope.Lookup("Stat")
	if sym == nil { return fail("const Stat missing from scope") }
	if sym.Kind != SYM_CONST {
		return fail("Stat should resolve to the const, not the method")
	}
	return ""
}

// A `.bni` `var X T` is an extern declaration and is defined as a
// SYM_VAR in the package scope, so importers can resolve `pkg.X`.
func TestLoadPackageInterfaceVarDecl() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile("package \"foo\"\nvar Count int\n")
	c.LoadPackageInterface("foo", f)

	var pkgScope @Scope = lookupPackage(c, "foo")
	if pkgScope == nil { return fail("foo scope missing") }
	var sym @Symbol = pkgScope.Lookup("Count")
	if sym == nil { return fail("Count not in foo's scope") }
	if sym.Kind != SYM_VAR {
		return fail("Count should be SYM_VAR")
	}
	return ""
}

// A generic function declared in a .bni whose signature references a
// generic struct declared in that SAME .bni must resolve the struct.
// buildScopeFromFile keys same-package generic decls under the package
// short name (for importers' qualified refs), but the function
// signature's `@Box[T]` head is unqualified — without the same-package
// fallback in lookupGenericTypeDeclPkg the head resolves to `undefined`
// and the parameter is recorded as `@void`, which then mismatches the
// body's `@Box[T]` ("undefined: Box" + ".bni has @void but .bn has
// @Box[T]").
func TestBniGenericFuncResolvesSamePkgGenericStruct() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile(
			"package \"foo\"\n"
					"type Box[T any] struct { v T }\n"
					"func GetMan[T any](b @Box[T]) T { return b.v }\n")
	c.LoadPackageInterface("foo", f)

	if len(c.CheckerErrors()) != 0 {
		return fail("generic func over same-.bni generic struct should resolve cleanly")
	}
	var pkgScope @Scope = lookupPackage(c, "foo")
	if pkgScope == nil { return fail("package scope for foo not found") }
	var sym @Symbol = pkgScope.Lookup("GetMan")
	if sym == nil { return fail("GetMan not in foo's scope") }
	if sym.Kind != SYM_FUNC { return fail("GetMan should be SYM_FUNC") }
	var ft @Type = sym.Type
	if ft == nil || ft.Kind != TYP_FUNC {
		return fail("GetMan should have a func type")
	}
	if len(ft.Params) != 1 { return fail("GetMan should have one parameter") }
	// The parameter is `@Box[T]`; the bug recorded it as `@void`.
	if streq(ft.Params[0].Type.QualifiedTypeName(), "@void") {
		return fail("GetMan's parameter resolved to @void (Box[T] unresolved)")
	}
	return ""
}

// Self-referencing type (struct with a field pointing at the same
// type via @T) requires the Phase 1 placeholder registration to
// work. Without it, the @Pt field in Pt's body would fail to
// resolve at the time it's encountered.
func TestLoadPackageInterfaceSelfRefType() testing.TestResult {
	var c @Checker = NewChecker()
	var f @ast.File = mkBniFile("package \"foo\"\ntype Node struct { next @Node; val int }\n")
	c.LoadPackageInterface("foo", f)

	if len(c.CheckerErrors()) != 0 {
		return fail("self-referencing type should resolve cleanly")
	}
	var pkgScope @Scope = lookupPackage(c, "foo")
	var sym @Symbol = pkgScope.Lookup("Node")
	if sym == nil { return fail("Node not in foo's scope") }
	if sym.Kind != SYM_TYPE { return fail("Node should be SYM_TYPE") }
	return ""
}
