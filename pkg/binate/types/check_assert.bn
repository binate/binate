package "pkg/binate/types"

import "pkg/binate/ast"

// Type-assertion checking (spec §11.12 `iface.assert`).  `x.(K T)` recovers a
// concrete type from an interface-value operand at run time; the checker types
// the expression and returns the recovered type.  CONCRETE targets only —
// interface targets (`x.(*J)`, the reader over the sat-entry root) are the
// Slice-5 work and are interim-rejected here.

// checkTypeAssert types an EXPR_TYPE_ASSERT.  The operand must be an interface
// value (`*I`/`@I`); the target is a mandatory recovery kind (`*`/`@`/value)
// over a nameable type, with an optional element `readonly`.  Returns the
// recovered type: `*T` (borrow), `@T` (retain), or `T` (value copy).
func checkTypeAssert(c @Checker, e @ast.Expr) @Type {
	var opType @Type = checkExpr(c, e.X)
	var opKind int = comparabilityKind(opType)
	if opKind != TYP_INTERFACE_VALUE && opKind != TYP_INTERFACE_VALUE_MANAGED {
		addCheckError(c, e.Pos, "type assertion operand must be an interface value")
		return TypVoid()
	}

	var target @ast.TypeExpr = e.TypeRef
	if target == nil {
		addCheckError(c, e.Pos, "type assertion requires a target type")
		return TypVoid()
	}
	// The recovery kind is the OUTER wrapper — `*T` = TEXPR_POINTER, `@T` =
	// TEXPR_MANAGED, a bare name = value copy.  An element `readonly` is a
	// TEXPR_CONST nested one level in (on the base), per parseAssertTarget.
	var recoveryKind int = target.Kind
	var inner @ast.TypeExpr = target
	if recoveryKind == ast.TEXPR_POINTER || recoveryKind == ast.TEXPR_MANAGED {
		inner = target.Base
	}
	var isReadonly bool = false
	if inner != nil && inner.Kind == ast.TEXPR_CONST {
		isReadonly = true
		inner = inner.Base
	}

	// Resolve the base named type.  Interfaces are allowed HERE: an interface
	// target `x.(*J)` recovers an interface value of J (via the runtime
	// satisfaction lookup), handled below.
	var baseT @Type = resolveTypeExprAllowInterface(c, inner)
	if baseT == nil || baseT.Kind == TYP_VOID {
		return TypVoid()
	}

	// Value recovery `x.(T)` (a field-wise copy of the pointee) is a distinct
	// lowering from the `*`/`@` pointer-recovery forms — deferred to a follow-up.
	if recoveryKind != ast.TEXPR_POINTER && recoveryKind != ast.TEXPR_MANAGED {
		addCheckError(c, e.Pos, "value-recovery type assertion not yet supported")
		return TypVoid()
	}

	// §11.12 `iface.assert.kind`: `@T` retains a reference, so it is legal only
	// from a managed operand `@I`; a raw `*I` has no reference to share.  This
	// governs interface targets too (`@J` needs `@I`).
	if recoveryKind == ast.TEXPR_MANAGED && opKind == TYP_INTERFACE_VALUE {
		addCheckError(c, e.Pos, "cannot recover @T from a raw interface value *I (no reference to share)")
		return TypVoid()
	}

	// Interface target `x.(*J)` / `x.(@J)`: the recovered value is an interface
	// value of J (assembled at run time from the satisfaction lookup), NOT a
	// concrete pointer.  An interface value has no inner readonly slot (§11.12
	// iface.value.no-readonly-slot), so an element `readonly` is meaningless and
	// rejected.  `recoveryKind` is TEXPR_POINTER or TEXPR_MANAGED here (value
	// recovery was rejected above).
	if baseT.Kind == TYP_INTERFACE {
		if isReadonly {
			addCheckError(c, e.Pos,
					"readonly is not allowed on an interface-value "
							"assertion target (an interface value has no inner readonly slot)")
			return TypVoid()
		}
		if recoveryKind == ast.TEXPR_POINTER {
			return MakeInterfaceValueType(baseT)
		}
		return MakeManagedInterfaceValueType(baseT)
	}

	// Element type with element `readonly` applied (add-only — a concrete base
	// is never itself readonly, so there is nothing to drop; §11.12
	// readonly.lattice-element).
	var elemT @Type = baseT
	if isReadonly {
		elemT = MakeReadonlyType(baseT)
	}
	if recoveryKind == ast.TEXPR_POINTER {
		return MakePointerType(elemT)
	}
	if recoveryKind == ast.TEXPR_MANAGED {
		return MakeManagedPtrType(elemT)
	}
	// Value recovery `x.(T)` yields a value T (a field-wise copy of the pointee).
	return elemT
}
