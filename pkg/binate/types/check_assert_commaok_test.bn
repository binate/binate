package "pkg/binate/types"

import "pkg/builtins/testing"

// Comma-ok type-assertion typing (`v, ok := x.(*T)` / `x.(@T)`, spec §11.12
// two-result form).  Reuses assertCheck's interface I / impl *T : I / operands
// `rv *I`, `mv @I`; the second target is always bool.  The recovered-type rules
// are the expression form's (check_assert_test.bn) — interface targets and
// value recovery are still interim-rejected here too.

// `*T` comma-ok from a raw `*I` (`:=`): p is `*T`, ok is bool.
func TestCommaOkBorrowFromRaw() testing.TestResult {
	return expectNoErrors(assertCheck("p, ok := rv.(*T)\nif ok { p.foo() }"))
}

// `@T` comma-ok from a managed `@I` (`:=`): p is `@T`, ok is bool.
func TestCommaOkRetainFromManaged() testing.TestResult {
	return expectNoErrors(assertCheck("p, ok := mv.(@T)\nif ok { p.foo() }"))
}

// The `=` form assigns (recovered, bool) to two pre-declared locations.
func TestCommaOkAssignForm() testing.TestResult {
	return expectNoErrors(assertCheck(
			"var p *T\nvar ok bool\np, ok = rv.(*T)\nif ok { p.foo() }"))
}

// A blank recovered target discards the value but still binds ok.
func TestCommaOkBlankRecovered() testing.TestResult {
	return expectNoErrors(assertCheck("_, ok := rv.(*T)\nif ok { }"))
}

// An INTERFACE target is interim-rejected in the comma-ok form too (Slice-5).
func TestCommaOkInterfaceTargetRejected() testing.TestResult {
	var c @Checker = assertCheck("p, ok := rv.(*J)\n_ = p\n_ = ok")
	return expectErrSub(c, "interface-target type assertion not yet supported")
}

// `@T` from a raw `*I` is rejected in the comma-ok form too — no ref to share.
func TestCommaOkManagedFromRawRejected() testing.TestResult {
	var c @Checker = assertCheck("p, ok := rv.(@T)\n_ = p\n_ = ok")
	return expectErrSub(c, "cannot recover @T from a raw interface value")
}
