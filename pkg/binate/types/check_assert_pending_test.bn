package "pkg/binate/types"

import "pkg/builtins/testing"

// Interim guard test: until Slice 6 adds real type-switch checking, the checker
// rejects STMT_TYPE_SWITCH with an explicit "not yet supported" diagnostic
// rather than accepting it silently — a bare STMT_TYPE_SWITCH would otherwise
// fall off checkStmt's arm chain (no default) and mask its body's errors.
// Delete this when the real checking lands.  (Type-assertion EXPR checking is
// real as of Slice 4 — see check_assert_test.bn.)

// A type-switch statement is rejected explicitly rather than silently no-op'd.
func TestCheckTypeSwitchNotYetSupported() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f(x int) { switch x.(type) { default: } }\n")
	return expectErrSub(c, "type switch not yet supported")
}
