package "pkg/binate/types"

import "pkg/builtins/testing"

// Interim guard tests: until Slice 4 (assertions) and Slice 6 (type switches)
// add real checking, the checker rejects both new nodes with an explicit
// "not yet supported" diagnostic rather than accepting them silently — a bare
// STMT_TYPE_SWITCH would otherwise fall off checkStmt's arm chain (no default)
// and mask its body's errors.  Delete these when the real checking lands.

// A type-assertion expression is rejected with a specific diagnostic (not the
// generic "unexpected expression" catch-all).
func TestCheckTypeAssertNotYetSupported() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nfunc f(x int) { x.(*T) }\n")
	return expectErrSub(c, "type assertion not yet supported")
}

// A type-switch statement is rejected explicitly rather than silently no-op'd.
func TestCheckTypeSwitchNotYetSupported() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f(x int) { switch x.(type) { default: } }\n")
	return expectErrSub(c, "type switch not yet supported")
}
