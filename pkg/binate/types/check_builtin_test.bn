package "pkg/binate/types"

import "pkg/builtins/testing"

// check_builtin.bn handles the per-builtin shape rules. The happy
// paths are exercised end-to-end by the conformance suite and by
// check_expr_test.bn (sizeof, make_slice, etc.). These tests pin
// the diagnostic-emission paths — wrong arity, wrong arg type,
// wrong arg shape — that are easy to silently regress.

// make_slice requires an integer length argument. A non-integer
// must produce a check error (not silently pass).
func TestCheckBuiltinMakeSliceLenMustBeInt() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nvar s @[]int = make_slice(int, true)\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("make_slice with non-int length must error")
	}
	return ""
}

// box(arg) returns a managed pointer to the boxed value. The arg
// type's default (e.g., untyped int → int) determines the result's
// element type.
func TestCheckBuiltinBoxReturnsManagedPtr() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nvar p @int = box(42)\n")
	return expectNoErrors(c)
}

// len's argument must be a slice or array — passing a bare int is
// a type error.
func TestCheckBuiltinLenRequiresSliceOrArray() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nvar n int = len(42)\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("len(int) must error")
	}
	return ""
}

// expectErrSub asserts the checker produced at least one error whose message
// contains needle (so the test pins the RIGHT diagnostic, not just "an error").
func expectErrSub(c @Checker, needle *[]readonly char) testing.TestResult {
	var errs @[]CheckError = c.CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if charsHaveSub(errs[i].Msg, needle) {
			return ""
		}
	}
	if len(errs) == 0 {
		return fail("expected an error, got none")
	}
	return fail(errs[0].Msg)
}

// make on a pure opaque type (forward decl, no full body — layout external)
// is rejected: allocation needs the layout.  Pointers/handles to it are fine.
func TestCheckBuiltinMakeOpaqueRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func f() { var p @Opaque = make(Opaque); _ = p }\n")
	return expectErrSub(c, "cannot make a value of an opaque type")
}

// make_slice with an opaque element type is rejected — the slice allocates
// n elements, which needs the element layout.
func TestCheckBuiltinMakeSliceOpaqueRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func f() { var s @[]Opaque = make_slice(Opaque, 3); _ = s }\n")
	return expectErrSub(c, "cannot make_slice with an opaque element type")
}

// sizeof on a pure opaque type is rejected — layout unknown.
func TestCheckBuiltinSizeofOpaqueRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func f() { var s uint = sizeof(Opaque); _ = s }\n")
	return expectErrSub(c, "cannot take sizeof/alignof of an opaque type")
}

// alignof on a pure opaque type is rejected — tested independently of sizeof
// (they share a message, so a sizeof-only test would mask an alignof regression).
func TestCheckBuiltinAlignofOpaqueRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func f() { var a uint = alignof(Opaque); _ = a }\n")
	return expectErrSub(c, "cannot take sizeof/alignof of an opaque type")
}

// make / make_slice / sizeof of a type that EMBEDS an opaque value (a generic
// instantiation, an anonymous struct) also needs the unavailable layout — the
// gates use embedsOpaqueByValue, so they reject the embedding aggregate, not
// just a bare opaque type.  This is the generic-instantiation collision fix:
// make(Box[Opaque]) can never form the value that IR-gen would lower to a
// colliding i64 Box.
func TestCheckBuiltinMakeOpaqueEmbeddingRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\ntype Box[T any] struct { v T }\n"
					"func f() { var b @Box[Opaque] = make(Box[Opaque]); _ = b }\n")
	return expectErrSub(c, "cannot make a value of an opaque type")
}

func TestCheckBuiltinMakeAnonStructOpaqueRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func f() { var b @struct { o Opaque } = make(struct { o Opaque }); _ = b }\n")
	return expectErrSub(c, "cannot make a value of an opaque type")
}

func TestCheckBuiltinSizeofOpaqueEmbeddingRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\ntype Box[T any] struct { v T }\n"
					"func f() { var n uint = sizeof(Box[Opaque]); _ = n }\n")
	return expectErrSub(c, "cannot take sizeof/alignof of an opaque type")
}

// The strengthened gates must NOT over-reject: make of a RECURSIVE managed type
// (the cycle embedsOpaqueByValue must terminate on) and make of a struct with a
// pointer-to-opaque field are both legal.
func TestCheckBuiltinMakeRecursiveManagedOk() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Node struct { kids @[]Node }\n"
					"func f() { var n @Node = make(Node); _ = n }\n")
	return expectNoErrors(c)
}

func TestCheckBuiltinMakeStructPointerFieldOk() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func f() { var b @struct { p *Opaque } = make(struct { p *Opaque });"
					" _ = b }\n")
	return expectNoErrors(c)
}

// A named-distinct type OVER an opaque type is opaque too — the gate peels
// to the bottom (like field access), so make on it is rejected.
func TestCheckBuiltinNamedDistinctOpaqueRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\ntype Handle Opaque\n"
					"func f() { var p @Handle = make(Handle); _ = p }\n")
	return expectErrSub(c, "cannot make a value of an opaque type")
}

// An alias to an opaque type is opaque too (an alias is transparent).
func TestCheckBuiltinAliasOpaqueRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\ntype Alias = Opaque\n"
					"func f() { var p @Alias = make(Alias); _ = p }\n")
	return expectErrSub(c, "cannot make a value of an opaque type")
}

// A POINTER / handle to an opaque type is allowed — its layout is known
// (pointer-sized) regardless of the pointee.  Guards against the gate
// false-firing on the legal opaque-handle pattern.
func TestCheckBuiltinPointerToOpaqueOk() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func f() { var n uint = sizeof(*Opaque); var m uint = alignof(*Opaque); _ = n; _ = m }\n")
	return expectNoErrors(c)
}

// make(T) / sizeof(T) inside a generic body must NOT be gated — a type
// parameter is TYP_TYPE_PARAM, not an opaque TYP_NAMED; monomorphization
// supplies the concrete layout.
func TestCheckBuiltinGenericTypeParamNotGated() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func makeOne[T any]() @T { return make(T) }\n"
					"func sizeOf[T any]() uint { return sizeof(T) }\n")
	return expectNoErrors(c)
}

// make / sizeof on a fully-defined type are fine — guards against the
// opaque gate false-firing on a normal (non-opaque) named type.
func TestCheckBuiltinMakeSizeofConcreteOk() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Point struct { x int }\n"
					"func f() { var p @Point = make(Point); var s uint = sizeof(Point); _ = p; _ = s }\n")
	return expectNoErrors(c)
}

// sizeof/alignof of an opaque type is rejected even when it reaches the
// checker through a CONST-FOLD context — as a cast operand, or as an array
// dimension — rather than as a bare builtin call.  Those contexts route
// through SizeOf()/AlignOf() during checking (to fold the constant), so the
// opaque gate must fire there too; otherwise SizeOf is asked for the layout
// of a layout-less type.
func TestCheckOpaqueSizeofInConstCastRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func f() { var n int = cast(int, sizeof(Opaque)); _ = n }\n")
	return expectErrSub(c, "cannot take sizeof/alignof of an opaque type")
}

func TestCheckOpaqueSizeofArrayDimRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func f() { var a [sizeof(Opaque)]int; _ = a }\n")
	return expectErrSub(c, "cannot take sizeof/alignof of an opaque type")
}

// The ALIGNOF arm of the gate is duplicated code (separate from SIZEOF), so it
// is covered independently — a sizeof-only test would mask an alignof-arm
// regression (the array-dimension form of alignof is TestEvalConstInt...).
func TestCheckOpaqueAlignofInConstCastRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func f() { var n int = cast(int, alignof(Opaque)); _ = n }\n")
	return expectErrSub(c, "cannot take sizeof/alignof of an opaque type")
}

// A slice / struct / array whose layout descends through an opaque type is
// rejected: the shared opaque guard (embedsOpaqueByValue, as used by `sizeof`)
// treats a slice-of-opaque as needing the element layout, so bit_cast reuses that
// predicate rather than inventing a looser one.  Here the target `*[]Opaque`.
func TestCheckBitCastRawSliceOpaqueElemRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func f(src *[]int8) { _ = bit_cast(*[]Opaque, src); }\n")
	return expectErrSub(c, "opaque-typed operand")
}

// An opaque type used BY VALUE has no layout here, so its size is unknowable and
// a bit_cast naming it is rejected before the size comparison it cannot make.
// The guard covers both operands (the `||` over s / d); here it is the target.
func TestCheckBitCastOpaqueByValueRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func f(p *int) { _ = bit_cast(Opaque, p); }\n")
	return expectErrSub(c, "opaque-typed operand")
}

// present(iv) requires an interface value; a non-iface arg is rejected.
func TestCheckBuiltinPresentRejectsNonIface() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nvar b bool = present(42)\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("present(42) must error")
	}
	return ""
}

// present on a managed interface value type-checks and yields bool.
func TestCheckBuiltinPresentAcceptsIface() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface S { m() }\n"
					"func use(s @S) bool { return present(s) }\n")
	if len(c.CheckerErrors()) != 0 {
		return fail("present(@S) should type-check and yield bool")
	}
	return ""
}

// present accepts a function value (set/unset is its sanctioned test —
// func values have no `== nil`).
func TestCheckBuiltinPresentAcceptsFuncValue() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func use(f @func() int) bool { return present(f) }\n")
	if len(c.CheckerErrors()) != 0 {
		return fail("present(@func) should type-check")
	}
	return ""
}

// present accepts a pointer (present ⇔ non-null).
func TestCheckBuiltinPresentAcceptsPointer() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func use(p *int) bool { return present(p) }\n")
	if len(c.CheckerErrors()) != 0 {
		return fail("present(*int) should type-check")
	}
	return ""
}

// present accepts a slice (present ⇔ len > 0).
func TestCheckBuiltinPresentAcceptsSlice() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func use(s @[]int) bool { return present(s) }\n")
	if len(c.CheckerErrors()) != 0 {
		return fail("present(@[]int) should type-check")
	}
	return ""
}

// present rejects a value type — a struct is never "unset".
func TestCheckBuiltinPresentRejectsStruct() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type S struct { x int }\n"
					"func use(s S) bool { return present(s) }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("present(struct value) must error")
	}
	return ""
}

// same(a, b) rejects non-reference operands (e.g. integers).
func TestCheckBuiltinSameRejectsNonRef() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nvar b bool = same(1, 2)\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("same(1, 2) must error")
	}
	return ""
}

// same(a, b) rejects operands of different static types.
func TestCheckBuiltinSameRejectsDifferentTypes() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(p *int, q *uint8) bool { return same(p, q) }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("same with mismatched pointer types must error")
	}
	return ""
}

// same(a, b) rejects func values — a function has no canonical identity.
func TestCheckBuiltinSameRejectsFuncValue() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a *func() int, b *func() int) bool { return same(a, b) }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("same on func values must error")
	}
	return ""
}

// same requires exactly two arguments.
func TestCheckBuiltinSameWrongArity() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(p *int) bool { return same(p) }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("same with one argument must error")
	}
	return ""
}

// same on two pointers of the same type type-checks and yields bool.
func TestCheckBuiltinSameAcceptsPointer() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(p *int, q *int) bool { return same(p, q) }\n")
	if len(c.CheckerErrors()) != 0 {
		return fail("same(*int, *int) should type-check")
	}
	return ""
}

// same on two managed interface values of the same type type-checks.
func TestCheckBuiltinSameAcceptsIface() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface S { m() }\n"
					"func use(a @S, b @S) bool { return same(a, b) }\n")
	if len(c.CheckerErrors()) != 0 {
		return fail("same(@S, @S) should type-check")
	}
	return ""
}

// same on two slices of the same type type-checks (view identity).
func TestCheckBuiltinSameAcceptsSlice() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a *[]int, b *[]int) bool { return same(a, b) }\n")
	if len(c.CheckerErrors()) != 0 {
		return fail("same(*[]int, *[]int) should type-check")
	}
	return ""
}

// _raw_func_addr(x) must reject anything other than a named-function
// reference. A bare int literal must not slip through (regression
// guard for the EXPR_IDENT/EXPR_SELECTOR shape check).
func TestCheckBuiltinRawFuncAddrRejectsNonFunc() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nvar p *uint8 = _raw_func_addr(42)\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("_raw_func_addr(42) must error")
	}
	return ""
}

// _raw_func_addr on a named function in the local package is
// accepted and returns *uint8.
func TestCheckBuiltinRawFuncAddrAcceptsNamedFunc() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc helper() { }\n"
			"var p *uint8 = _raw_func_addr(helper)\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// _func_handle is the canonical spelling.  Both end-to-end behaviors
// (reject non-func / accept named func) parallel the
// `_raw_func_addr` tests above to make sure the type-checker
// treats the two spellings identically — the alias is purely a
// lexer concern.
func TestCheckBuiltinFuncHandleRejectsNonFunc() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nvar p *uint8 = _func_handle(42)\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("_func_handle(42) must error")
	}
	return ""
}

func TestCheckBuiltinFuncHandleAcceptsNamedFunc() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc helper() { }\n"
			"var p *uint8 = _func_handle(helper)\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// unsafe_index requires an integer index — passing a non-integer
// must error (mirrors the rule for `coll[idx]`).
func TestCheckBuiltinUnsafeIndexIndexMustBeInt() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f() { var x int = unsafe_index(make_slice(int, 4), true) }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) == 0 {
		return fail("unsafe_index with non-int index must error")
	}
	return ""
}

// unsafe_index requires a slice/array/pointer collection. A bare
// integer is not indexable.
func TestCheckBuiltinUnsafeIndexCollMustBeIndexable() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var x int = unsafe_index(42, 0) }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) == 0 {
		return fail("unsafe_index on non-indexable must error")
	}
	return ""
}

// sizeof / alignof require a type argument (TypeRef set), not an
// expression. The parser enforces shape; this pins the resolver
// path that runs against the resolved type.
func TestCheckBuiltinSizeofResolvesType() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar n uint = sizeof(*[]int)\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// sizeof of an unknown named type must surface the underlying
// "undefined" diagnostic from resolveTypeExpr — confirming the
// builtin path doesn't swallow resolver errors.
func TestCheckBuiltinSizeofPropagatesUndefined() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar n uint = sizeof(NoSuchType)\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) == 0 {
		return fail("sizeof of unknown type must report undefined")
	}
	return ""
}

// unsafe_shl / unsafe_shr type-check like a regular shift: two integer
// operands, result is the LEFT operand's type.  A valid call checks cleanly.
func TestCheckUnsafeShiftValid() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f(x int, n uint8) int { return unsafe_shl(x, n) }\n")
	if len(c.CheckerErrors()) != 0 {
		return fail("unsafe_shl(int, uint8) must check cleanly")
	}
	return ""
}

// A non-integer operand to unsafe_shl / unsafe_shr is a type error.
func TestCheckUnsafeShiftRejectsFloat() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f(x float64, n int) float64 { return unsafe_shr(x, n) }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("unsafe_shr on a float must be a type error")
	}
	return ""
}

// A one-argument unsafe_shl is a compile error.  Arity is actually enforced by
// the PARSER (parseUnsafeBinaryCall requires `(a, b)`), so the checker's own
// arity guard is defensive/unreached — checkSrc runs only the checker, which
// rejects the malformed call (the missing operand parses as a bad node).  This
// pins the user-visible "rejected" behavior, not a specific checker branch.
func TestCheckUnsafeShiftRejectsArity() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f(x int) int { return unsafe_shl(x) }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("a one-argument unsafe_shl must be rejected")
	}
	return ""
}

// bit_cast shape rules (checkBitCastShapes): the ONLY requirement is equal
// PROXIMAL size.  Aggregates and aggregate<->scalar reinterprets are accepted
// (IR-gen lowers them via a scratch round-trip); only a size mismatch or an
// opaque-by-value operand is rejected.
func TestCheckBitCastRawSliceRetypeAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(u *[]uint8) *[]int8 { return bit_cast(*[]int8, u) }\n")
	return expectNoErrors(c)
}

// A managed-slice reinterpret is accepted: @[]uint8 and @[]int8 are both the
// 4-word managed-slice header.
func TestCheckBitCastManagedSliceAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(m @[]uint8) @[]int8 { return bit_cast(@[]int8, m) }\n")
	return expectNoErrors(c)
}

// A struct-to-struct reinterpret is accepted at equal size (P and Q are both one
// word).
func TestCheckBitCastStructAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type P struct { a int }\n"
					"type Q struct { x int }\n"
					"func f(p P) Q { return bit_cast(Q, p) }\n")
	return expectNoErrors(c)
}

// Element sizes NEED NOT match — only proximal size does.  `*[]uint8` and
// `*[]int32` are both a 2-word raw-slice header, so the reinterpret is accepted
// (its `len` would then count the wrong span — undefined, the programmer's
// responsibility — but that is not a checker concern).
func TestCheckBitCastRawSliceElemSizeMismatchAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(u *[]uint8) *[]int32 { return bit_cast(*[]int32, u) }\n")
	return expectNoErrors(c)
}

// A raw slice whose elements are MANAGED is accepted too: element managed-ness no
// longer matters, only the 2-word proximal size (here `*[]@int` -> `*[]*int`).
func TestCheckBitCastRawSliceManagedElemsAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(s *[]@int) *[]*int { return bit_cast(*[]*int, s) }\n")
	return expectNoErrors(c)
}

// An array reinterpret is accepted at equal size ([2]int -> [2]uint).
func TestCheckBitCastArrayAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a [2]int) [2]uint { return bit_cast([2]uint, a) }\n")
	return expectNoErrors(c)
}

// An aggregate<->scalar reinterpret across the storage boundary is accepted at
// equal size: a one-word struct and `int` are both one word.  How the aggregate
// is stored (by address vs by value) is a backend/ABI matter, not a language
// restriction, so this is NOT a "crossing" the language rejects.
func TestCheckBitCastStructScalarCrossingAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type W struct { a int }\n"
					"func f(w W) int { return bit_cast(int, w) }\n")
	return expectNoErrors(c)
}

// A size MISMATCH is the rejection that remains: a raw slice is two words, `int`
// is one, so this is rejected regardless of shape.
func TestCheckBitCastDifferentSizeRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(u *[]uint8) int { return bit_cast(int, u) }\n")
	return expectErrSub(c, "same size")
}

// A managed POINTER (@T) is a one-word pointer: bit_cast between managed pointers
// stays accepted (the @VM / @ast.Decl pattern).
func TestCheckBitCastManagedPointerAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(p @int) @uint { return bit_cast(@uint, p) }\n")
	return expectNoErrors(c)
}

// An interface value is a 2-word {data, vtable}; bit_cast to a same-size struct
// is accepted (an interface value is no longer a rejected bit_cast operand).
func TestCheckBitCastInterfaceValueAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type Words struct { a *uint8; b *uint8 }\n"
					"func f(x @any) Words { return bit_cast(Words, x) }\n")
	return expectNoErrors(c)
}

// A function value is likewise a 2-word aggregate; bit_cast to a same-size struct
// is accepted.
func TestCheckBitCastFuncValueAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type Words struct { a *uint8; b *uint8 }\n"
					"func f(fn *func(int) int) Words { return bit_cast(Words, fn) }\n")
	return expectNoErrors(c)
}

// unsafe_cast performs UNCHECKED interface narrowing: an interface-value operand
// recovered to a concrete pointer is accepted (no runtime type check, unlike
// `x.(@T)`).
func TestCheckUnsafeCastNarrowingAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type Box struct { v int }\n"
					"func f(x @any) @Box { return unsafe_cast(@Box, x) }\n")
	return expectNoErrors(c)
}

// unsafe_cast WIDENS a satisfying pointer to an interface value.
func TestCheckUnsafeCastWideningAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface I { id() int }\n"
					"type Mgd struct { v int }\n"
					"func (m @Mgd) id() int { return m.v }\n"
					"impl @Mgd : I\n"
					"func f(m @Mgd) @I { return unsafe_cast(@I, m) }\n")
	return expectNoErrors(c)
}

// A non-satisfying operand cannot widen (no matching impl).
func TestCheckUnsafeCastWideningNonSatisfyingRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface I { id() int }\n"
					"type Cat struct { v int }\n"
					"func f(x @Cat) @I { return unsafe_cast(@I, x) }\n")
	return expectErrSub(c, "does not satisfy")
}

// A bare VALUE cannot widen to an interface value (no implicit heap; box first).
func TestCheckUnsafeCastWideningValueRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface I { id() int }\n"
					"type Mgd struct { v int }\n"
					"func (m @Mgd) id() int { return m.v }\n"
					"impl @Mgd : I\n"
					"func f(m Mgd) @I { return unsafe_cast(@I, m) }\n")
	return expectErrSub(c, "pointer operand")
}

// Interface -> interface (super <-> sub) is out of scope; use a type assertion.
func TestCheckUnsafeCastIfaceToIfaceRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface A { f() int }\n"
					"interface B { f() int }\n"
					"func g(x @A) @B { return unsafe_cast(@B, x) }\n")
	return expectErrSub(c, "does not convert between interface values")
}

// A non-interface scalar conversion is accepted (delegates to cast); int8 -> bool
// is an invariant-breaking direction unsafe_cast is meant for.
func TestCheckUnsafeCastScalarAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(x int8) bool { return unsafe_cast(bool, x) }\n")
	return expectNoErrors(c)
}

// A CONSTANT operand that doesn't fit an integer target is rejected, exactly like
// cast (unsafe_cast does not launder constants; use bit_cast / masking).
func TestCheckUnsafeCastConstOutOfRangeRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f() int8 { return unsafe_cast(int8, 200) }\n")
	return expectError(c)
}

// *T -> @T (raw pointer -> managed pointer) is accepted — the raw->managed escape
// hatch (asserts a management header exists).
func TestCheckUnsafeCastRawToManagedAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(p *int) @int { return unsafe_cast(@int, p) }\n")
	return expectNoErrors(c)
}

// A CONSTANT unsafe_cast out of range is rejected in ARRAY-DIMENSION position too
// (validateDimCasts), not just value position — it must not silently fold to a
// wrong array length (unsafe_cast does not launder constants, like cast).
func TestCheckUnsafeCastArrayDimOutOfRangeRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f() { var a [unsafe_cast(int8, 200)]int; _ = a }\n")
	return expectError(c)
}

// `cast` from an interface value to a concrete type is rejected: an interface value
// is a 2-word {data, vtable}, and OP_CAST would mis-declare its LLVM type.  Recover a
// concrete type with a type assertion, not a cast.  (Conformance 1121 covers it
// end-to-end.)
func TestCheckCastFromInterfaceValueRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type Thing struct { x int }\n"
					"func f(a @any) @Thing { return cast(@Thing, a) }\n")
	return expectError(c)
}

// `cast` TO an interface value WIDENS a concrete value — accepted, because the
// safe-set gate accepts everything assignable (assignability case 7, interface
// satisfaction).  Only narrowing (cast FROM an interface value) stays rejected.
func TestCheckCastToInterfaceValueAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type Thing struct { x int }\n"
					"func f(m @Thing) @any { return cast(@any, m) }\n")
	return expectNoErrors(c)
}

// A `cast` between two named struct types with the same underlying stays valid
// (spec §8.5 named↔underlying) — the interface-value rejection must not
// over-reach, and it is a same-layout conversion, not a bit reinterpret.
func TestCheckCastBetweenStructsAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type A struct { x int }\n"
					"type B struct { x int }\n"
					"func f(a A) B { return cast(B, a) }\n")
	return expectNoErrors(c)
}

// The safe-set gate REJECTS a raw pointer -> managed pointer cast (it would invent
// a reference count); use unsafe_cast.
func TestCheckCastRawToManagedRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(p *int) @int { return cast(@int, p) }\n")
	return expectErrSub(c, "raw pointer to a managed pointer")
}

// The gate REJECTS a pointer <-> integer cast (a same-size reinterpret); use
// bit_cast.
func TestCheckCastPtrToIntRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(p *int) int { return cast(int, p) }\n")
	return expectErrSub(c, "between a pointer and an integer")
}

// The gate REJECTS an array -> managed-slice cast — the original MAJOR
// (`cast(@[]char, arr)` mis-lowered to garbage); construct explicitly instead.
func TestCheckCastArrayToManagedSliceRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a [3]char) @[]char { return cast(@[]char, a) }\n")
	return expectError(c)
}

// The gate REJECTS numeric -> bool (an int/float value need not be a valid bool);
// use unsafe_cast.
func TestCheckCastNumericToBoolRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(x int8) bool { return cast(bool, x) }\n")
	return expectErrSub(c, "to bool")
}

// The gate ACCEPTS bool -> numeric (a defined widening — bool is 0/1).
func TestCheckCastBoolToNumericAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(b bool) int { return cast(int, b) }\n")
	return expectNoErrors(c)
}

// A generic function has no single emitted symbol to take a handle of (only
// per-instantiation monomorphizations exist), so the checker must reject
// `_func_handle(GenericF)` — otherwise codegen's lookupFuncValueType returns nil,
// the __shim/__vt/__handle triple is skipped, and the `@__handle.<…>` reference
// dangles at link.  Mirrors __c_entry's non-generic guard.
func TestCheckBuiltinFuncHandleRejectsGeneric() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc gen[T any](x T) T { return x }\n"
					"var p *uint8 = _func_handle(gen)\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("_func_handle of a generic function must error")
	}
	return ""
}
