package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// checkCCall type-checks `__c_call("sym", RetType, args...)`.  The
// return type is RetType (e.TypeRef); each argument must be a
// C-ABI-passable type (scalar, pointer, or struct by value).  Variadic
// calls (CFixedArgs < len(Args)) are not yet supported.
func checkCCall(c @Checker, e @ast.Expr) @Type {
	// __c_call is native-only FFI: the bytecode VM never executes it (a
	// permanent non-goal).  In an interpreted context reject it here, at the
	// frontend — a clear type error, not a later lowering failure.  Compiled
	// code (cmd/bnc, Interpreted false) uses it freely; an interpreted program
	// that needs C supplies a Binate impl via package-level injection instead.
	if c.Interpreted {
		addCheckError(c, e.Pos,
				"__c_call cannot be interpreted (native-only FFI); it is usable "
						"only in compiled code")
	}
	noteCSymbolAndCheckClash(c, e, false)
	// A nil TypeRef is the void spelling — `__c_call("sym", "void", ...)`,
	// parsed straight to nil (no result).  Anything else is a real return
	// type and must be C-compatible (scalar or pointer).
	var ret @Type = TypVoid()
	if e.TypeRef != nil {
		ret = resolveTypeExpr(c, e.TypeRef)
		if !isCCompatibleArgType(ret) {
			addCheckError(c, e.Pos,
					"__c_call return type must be a scalar, pointer, or "
							"\"void\" (struct returns not yet supported)")
		}
	}
	for i := 0; i < len(e.Args); i++ {
		var at @Type = checkExpr(c, e.Args[i])
		if !isCCompatibleArgType(at) {
			addCheckError(c, e.Args[i].Pos,
					"__c_call argument must be a scalar or pointer "
							"(pass a pointer for slices, structs, and managed values)")
		}
	}
	return ret
}

// checkCGlobal type-checks `__c_global("sym", T)`.  It yields the ADDRESS of
// the external C global named `sym` (emitted verbatim, no mangling) as a RAW
// pointer *T — never @T, because the storage belongs to the C side and carries
// no reference-count header.  T is mandatory (unlike __c_call's optional "void"
// return) and must be C-ABI-passable (scalar or pointer), the same constraint
// as __c_call's arguments.  Native-only FFI: the bytecode VM never executes it.
// See spec §16.9 (pkg.cglobal), explorations/plan-c-global.md.
func checkCGlobal(c @Checker, e @ast.Expr) @Type {
	// __c_global is native-only FFI: reject it in an interpreted context at the
	// frontend, exactly as checkCCall does (no early return — keep surfacing
	// diagnostics).
	if c.Interpreted {
		addCheckError(c, e.Pos,
				"__c_global cannot be interpreted (native-only FFI); it is usable "
						"only in compiled code")
	}
	noteCSymbolAndCheckClash(c, e, true)
	// The type is mandatory — there is no "void" spelling (you cannot take the
	// address of a void global), and the grammar requires it, so a nil TypeRef
	// is only reachable via a malformed parse.  Recover with a clean message.
	if e.TypeRef == nil {
		addCheckError(c, e.Pos, "__c_global requires a type argument")
		return TypVoid()
	}
	var t @Type = resolveTypeExpr(c, e.TypeRef)
	if !isCCompatibleArgType(t) {
		addCheckError(c, e.Pos,
				"__c_global type must be a scalar or pointer (managed pointers, "
						"slices, and structs are not C-ABI globals)")
	}
	// The result is the ADDRESS of the global: a raw *T (MakePointerType), not a
	// managed @T.  For __c_global("environ", **char) this is ***char.
	return MakePointerType(t)
}

// noteCSymbolAndCheckClash records the verbatim C symbol e.Name used by a
// __c_call (asGlobal=false) or __c_global (asGlobal=true), and reports an error
// if that SAME symbol was already used the OTHER way anywhere in this compile.
// A C symbol is a function OR a data object, never both; the two forms emit an
// incompatible `declare <ret> @sym(...)` vs `@sym = external global <T>` pair
// into one LLVM module, so the clash is genuinely ill-typed (not merely a link
// hazard).  Compiled-mode only — under Interpreted both builtins are already
// rejected, so nothing is recorded.
func noteCSymbolAndCheckClash(c @Checker, e @ast.Expr, asGlobal bool) {
	if c.Interpreted { return }
	if asGlobal {
		if cSymInList(c.CCallSyms, e.Name) {
			addCheckError(c, e.Pos,
					"C symbol used as both a C global (__c_global) and a C function "
							"(__c_call); a C symbol is one or the other, not both")
		}
		c.CGlobalSyms = slices.Append[@[]char](c.CGlobalSyms, e.Name)
	} else {
		if cSymInList(c.CGlobalSyms, e.Name) {
			addCheckError(c, e.Pos,
					"C symbol used as both a C function (__c_call) and a C global "
							"(__c_global); a C symbol is one or the other, not both")
		}
		c.CCallSyms = slices.Append[@[]char](c.CCallSyms, e.Name)
	}
}

// cSymInList reports whether the verbatim C symbol sym is already in list
// (byte-exact comparison of the raw C names).
func cSymInList(list @[]@[]char, sym @[]char) bool {
	for i := 0; i < len(list); i++ {
		if len(list[i]) != len(sym) { continue }
		var eq bool = true
		for j := 0; j < len(sym); j++ {
			if list[i][j] != sym[j] { eq = false }
		}
		if eq { return true }
	}
	return false
}

// isCCompatibleArgType reports whether t can be passed across the C ABI
// by __c_call / __c_global: a scalar (int/float/bool) or a pointer (*T).
// Everything else — slices (raw and managed), structs, managed pointers,
// function values, interface values — is rejected; the caller must pass a
// pointer to the underlying data instead.  (Struct-by-value passing is a
// planned later addition.)  An outer
// `readonly` wrapper is peeled (resolveAliasAndConst, not ResolveAlias) so a
// `readonly *T` pointer is accepted symmetrically with a `readonly` scalar —
// both are equally C-ABI-passable; without the const-peel a readonly pointer
// resolves to TYP_READONLY (not TYP_POINTER) and would be wrongly rejected.
func isCCompatibleArgType(t @Type) bool {
	if t == nil { return false }
	var rt @Type = resolveAliasAndConst(t)
	if rt == nil { return false }
	if rt.IsInteger() || rt.IsFloat() || rt.IsBool() { return true }
	if rt.Kind == TYP_POINTER { return true }
	return false
}

// checkBitCastShapes restricts which operand/target shapes bit_cast accepts.
// Scalar and pointer (raw or managed-pointer) reinterprets are unrestricted —
// bit_cast is the low-level escape.  A raw slice may be reinterpreted to
// another raw slice ONLY when the element types are the same size and
// non-managed: that is a {ptr,len}-identical element retype (e.g.
// `*[]uint8` <-> `*[]int8`), a runtime no-op.  Everything else is rejected:
// a struct/array value reinterpret is a footgun (field layout, and a managed
// field would be mis-RefDec'd); a managed slice would need refcount-ownership
// semantics (reinterpret a raw view instead); a slice paired with a non-slice
// or mismatched element sizes breaks `len`.
func checkBitCastShapes(c @Checker, pos token.Pos, src @Type, dst @Type) {
	if src == nil || dst == nil { return }
	var s @Type = peelNamedBounded(src)
	var d @Type = peelNamedBounded(dst)
	var sSlice bool = s != nil && s.Kind == TYP_SLICE
	var dSlice bool = d != nil && d.Kind == TYP_SLICE
	if sSlice || dSlice {
		if !sSlice || !dSlice {
			addCheckError(c, pos, "bit_cast between a raw slice and a non-slice is not allowed")
			return
		}
		if s.Elem == nil || d.Elem == nil { return }
		// An opaque element type has no known size, so the same-size check
		// below cannot be evaluated; reject with a clean diagnostic rather
		// than calling SizeOf() on a layout-less type.
		if embedsOpaqueByValue(c, s.Elem) || embedsOpaqueByValue(c, d.Elem) {
			addCheckError(c, pos,
					"bit_cast does not support a raw slice with an opaque element"
							" type (its layout is not available here)")
			return
		}
		if s.Elem.SizeOf() != d.Elem.SizeOf() {
			addCheckError(c, pos, "bit_cast between raw slices requires same-size element types")
			return
		}
		if s.Elem.NeedsDestruction() || d.Elem.NeedsDestruction() {
			addCheckError(c, pos, "bit_cast does not support raw slices with managed element types")
			return
		}
		return
	}
	if isBitCastRejectedAggregate(s) || isBitCastRejectedAggregate(d) {
		addCheckError(c, pos,
				"bit_cast does not support managed-slice, struct, array, or "
						"other aggregate operands (reinterpret a pointer or a raw slice "
						"instead)")
	}
}

// isBitCastRejectedAggregate reports whether t is an aggregate that bit_cast
// rejects (everything except scalars, pointers, and raw slices).
func isBitCastRejectedAggregate(t @Type) bool {
	if t == nil { return false }
	return t.Kind == TYP_MANAGED_SLICE || t.Kind == TYP_STRUCT || t.Kind == TYP_ARRAY ||
			t.Kind == TYP_FUNC_VALUE || t.Kind == TYP_MANAGED_FUNC_VALUE || t.Kind == TYP_INTERFACE_VALUE ||
			t.Kind == TYP_INTERFACE_VALUE_MANAGED
}
