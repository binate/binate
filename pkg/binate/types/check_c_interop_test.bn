package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for the C-interop checks in check_c_interop.bn (checkCCall / checkCGlobal
// / C-symbol clash).  Shared checkSrc/expectError helpers live in the other
// types *_test.bn files (same package).

// __c_call returns its declared return type; scalar args are accepted.
func TestCheckCCallBasic() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f(x int32) int32 { return __c_call(\"abs\", int32, x) }\n")
	return expectNoErrors(c)
}

// In interpreted mode (Checker.Interpreted — the interp / REPL config), __c_call
// is native-only FFI the bytecode VM can't run, so it is rejected at the
// frontend.  The compiled default (TestCheckCCallBasic, above) accepts it.
func TestCheckCCallInterpretedRejected() testing.TestResult {
	var c @Checker = checkSrcInterpreted(
			"package \"test\"\nfunc f(x int32) int32 { return __c_call(\"abs\", int32, x) }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("__c_call in interpreted mode must be a type error")
	}
	return ""
}

// A managed-slice argument has a defined ABI layout (the 4-word managed-slice
// header), so it is passable to C: the C side sees the header struct and honors
// the ordinary parameter-ownership contract (§18.5 mem.param) by hand.  It is
// accepted, not rejected.
func TestCheckCCallAcceptsManagedSlice() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f(s @[]char) int { return __c_call(\"g\", int, s) }\n")
	return expectNoErrors(c)
}

// A raw-slice argument (`*[]T` → `{T*, ptrdiff_t}`) has a defined 2-word ABI
// layout, so it is passable to C.
func TestCheckCCallAcceptsRawSlice() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f(s *[]int32) int { return __c_call(\"g\", int, s) }\n")
	return expectNoErrors(c)
}

// A struct-by-value argument has a defined ABI layout (the platform C small-struct
// / byval convention), so it is passable to C.
func TestCheckCCallAcceptsStructByValue() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Pair struct { x int; y int }\n"
					"func f(p Pair) int { return __c_call(\"g\", int, p) }\n")
	return expectNoErrors(c)
}

// A managed-pointer argument (`@T`) is a single pointer word to C; it is passable,
// with the C side honoring the mem.param borrow contract (§18.5) by hand.
func TestCheckCCallAcceptsManagedPointer() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype T struct { x int }\n"
					"func f(p @T) int { return __c_call(\"g\", int, p) }\n")
	return expectNoErrors(c)
}

// Pointer arguments — the other half of the v1 contract — must be
// accepted alongside scalars (a regression here would block almost
// every real C call: write(buf), read(buf), strlen(s), free(p) …).
func TestCheckCCallPointerArg() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f(p *uint8) int { return __c_call(\"strlen\", int, p) }\n")
	return expectNoErrors(c)
}

// Struct return is a planned later addition — until codegen handles
// the sret path, the type checker must reject it (a silent-pass would
// reach codegen and emit malformed IR).
func TestCheckCCallRejectsStructReturn() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Pair struct { x int; y int }\n"
			"func f() Pair { return __c_call(\"makePair\", Pair) }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) == 0 {
		return fail("__c_call struct return must error")
	}
	return ""
}

// Variadic __c_call accepts the `...` boundary marker.  The checker
// validates types on both sides of the marker; the LLVM lowering emits
// a varargs declare/call.  Fixed and variadic args here are both int32
// scalars, so the checker accepts.
func TestCheckCCallVariadicAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f(x int32) int32 { return __c_call(\"h\", int32, x, ..., x) }\n")
	return expectNoErrors(c)
}

// __c_global("sym", T) yields a raw *T (the address of the C global).  For a
// scalar T the result is *T — pinned here by returning it as *int (a wrong
// result type would fail the return-type check).
func TestCheckCGlobalBasic() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f() *int { return __c_global(\"g\", int) }\n")
	return expectNoErrors(c)
}

// The canonical example: environ has C type char** (Binate **char), so
// __c_global("environ", **char) is a ***char.  Pinned via the return type —
// a managed (@) or wrong-arity result would not match ***char.
func TestCheckCGlobalEnvironShape() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f() ***char { return __c_global(\"environ\", **char) }\n")
	return expectNoErrors(c)
}

// Native-only FFI: in interpreted mode (Checker.Interpreted) __c_global is
// rejected at the frontend, exactly like __c_call.
func TestCheckCGlobalInterpretedRejected() testing.TestResult {
	var c @Checker = checkSrcInterpreted(
			"package \"test\"\nfunc f() *int { return __c_global(\"g\", int) }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("__c_global in interpreted mode must be a type error")
	}
	return ""
}

// A struct BY VALUE has a defined ABI layout, so __c_global accepts it — the
// address of a C global struct, as a raw *S.  (The C global is read/written as a
// whole struct through *p; the C side honors the struct's ABI layout.)
func TestCheckCGlobalAcceptsStruct() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type S struct { x int; y int }\n"
			"func f() *S { return __c_global(\"g\", S) }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// An array type has a defined ABI layout, so __c_global accepts it: the address
// of a C global array as a raw pointer-to-array.
func TestCheckCGlobalAcceptsArray() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f() *([8]int32) { return __c_global(\"g\", [8]int32) }\n")
	return expectNoErrors(c)
}

// A managed type has a defined ABI layout too, so __c_global admits it — the same
// widened C-representability __c_call applies to its arguments.  The C side honors
// the ABI (including the refcount discipline for a managed value, e.g. an immortal
// managed pointer); the recovered *T merely borrows the foreign storage.
func TestCheckCGlobalAcceptsManagedSlice() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f() *(@[]int) { return __c_global(\"g\", @[]int) }\n")
	return expectNoErrors(c)
}

// The only rejection is an opaque-by-value type — its layout is unavailable here,
// so it maps to no C type.  Reachable cross-package as an opaque export used by
// value; here the local pure opaque `type O` suffices.
func TestCheckCGlobalRejectsOpaqueByValue() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype O\n"
					"func f() *O { return __c_global(\"g\", O) }\n")
	return expectErrSub(c, "defined ABI layout")
}

// A `readonly` POINTER is C-representable and must be accepted — isCArgType
// (embedsOpaqueByValue) peels the outer const and sees a pointer, not an opaque, so
// `readonly *char` is not mis-rejected.
func TestCheckCGlobalReadonlyPointer() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f() { var p = __c_global(\"g\", readonly *char); _ = p }\n")
	return expectNoErrors(c)
}

// A `readonly *char` ARG to __c_call is likewise accepted — __c_call's arguments
// and __c_global's type share the widened isCArgType predicate, whose
// embedsOpaqueByValue peels the outer const and sees a pointer.
func TestCheckCCallReadonlyPointerArg() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f(p readonly *char) int { return __c_call(\"g\", int, p) }\n")
	return expectNoErrors(c)
}

// A C symbol used as BOTH a C function (__c_call) and a C global (__c_global)
// in one compile is a contradiction — a C symbol is one or the other, and the
// two forms emit an incompatible `declare @sym(...)` + `@sym = external global`
// pair into one LLVM module.  The checker rejects the clash rather than letting
// codegen emit an ill-formed module.
func TestCheckCSymbolClashCallThenGlobal() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f() int32 { return __c_call(\"clash\", int32) }\n"
					"func g() *int32 { return __c_global(\"clash\", int32) }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("same symbol used as __c_call and __c_global must error")
	}
	return ""
}

// Order-independent: __c_global first, then __c_call, still clashes.
func TestCheckCSymbolClashGlobalThenCall() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func g() *int32 { return __c_global(\"clash2\", int32) }\n"
					"func f() int32 { return __c_call(\"clash2\", int32) }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("clash must be detected regardless of order")
	}
	return ""
}

// Distinct symbols for the call and the global are fine (no clash).
func TestCheckCSymbolDistinctNoClash() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f() int32 { return __c_call(\"afunc\", int32) }\n"
					"func g() *int32 { return __c_global(\"aglobal\", int32) }\n")
	return expectNoErrors(c)
}

// __c_entry(f) on a top-level function yields *uint8 and is accepted in compiled
// mode (spec §16.9 pkg.centry).
func TestCheckCEntryBasic() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g(x int32) int32 { return x }\n"
					"func use() *uint8 { return __c_entry(g) }\n")
	return expectNoErrors(c)
}

// __c_entry is native-only FFI (the VM does no FFI), so an interpreted context
// rejects it at the frontend, exactly as __c_call / __c_global do.
func TestCheckCEntryInterpretedRejected() testing.TestResult {
	var c @Checker = checkSrcInterpreted(
			"package \"test\"\nfunc g(x int32) int32 { return x }\n"
					"func use() *uint8 { return __c_entry(g) }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("__c_entry in interpreted mode must be a type error")
	}
	return ""
}

// A generic function cannot become a C function pointer (no type arguments in a
// C pointer) — pkg.centry.eligible rejects it.
func TestCheckCEntryRejectsGeneric() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc gen[T any](x T) T { return x }\n"
					"func use() *uint8 { return __c_entry(gen) }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("__c_entry of a generic function must error")
	}
	return ""
}

// A non-function operand (a local variable) is rejected: __c_entry needs a
// declared top-level function reference.
func TestCheckCEntryRejectsNonFunction() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc use() *uint8 { var x int32 = 3; return __c_entry(x) }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("__c_entry of a non-function must error")
	}
	return ""
}

// A function *value* (a local of function type) carries a context slot and is not
// a declared function reference, so it is rejected.
func TestCheckCEntryRejectsFuncValue() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g(x int32) int32 { return x }\n"
					"func use() *uint8 { var fp func(int32) int32 = g; return __c_entry(fp) }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("__c_entry of a function value must error")
	}
	return ""
}

// A __c_entry target may take a struct BY VALUE: a struct has a defined ABI
// layout, so the C side can declare and pass it.  Accepted, not rejected.
func TestCheckCEntryAcceptsStructParam() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Point struct { x int; y int }\n"
					"func g(p Point) int { return p.x }\n"
					"func use() *uint8 { return __c_entry(g) }\n")
	return expectNoErrors(c)
}

// A managed-slice parameter has a defined ABI layout (the 4-word header), so a
// __c_entry target taking one is accepted — the same widened surface __c_call
// admits for its arguments.
func TestCheckCEntryAcceptsManagedSliceParam() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g(s @[]int) int { return len(s) }\n"
					"func use() *uint8 { return __c_entry(g) }\n")
	return expectNoErrors(c)
}

// A multi-value return is C-representable (the C entry adapts it via the shared
// #[c_export] return machinery), so a __c_entry target with a tuple return is
// accepted.
func TestCheckCEntryAcceptsMultiReturn() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g(x int) (int, int) { return x, x }\n"
					"func use() *uint8 { return __c_entry(g) }\n")
	return expectNoErrors(c)
}

// A __c_entry target whose PARAMETER is an opaque-by-value type has no layout at
// the C boundary and is rejected.  The firing case is cross-package: `op.T` is
// opaque to the importing package, so `op.G(x T)` reads as an opaque-by-value
// parameter here even though it is concrete inside `op`.
func TestCheckCEntryRejectsOpaqueByValueParam() testing.TestResult {
	var c @Checker = checkSrcImporting("op", "package \"op\"\ntype T\nfunc G(x T) int\n",
			"package \"test\"\nimport \"op\"\n"
					"func use() *uint8 { return __c_entry(op.G) }\n")
	return expectErrSub(c, "parameter with no defined ABI layout")
}

// Symmetric to the parameter case: a __c_entry target that RETURNS an
// opaque-by-value type is rejected — the return has no layout to marshal at the C
// boundary.
func TestCheckCEntryRejectsOpaqueByValueReturn() testing.TestResult {
	var c @Checker = checkSrcImporting("op", "package \"op\"\ntype T\nfunc H() T\n",
			"package \"test\"\nimport \"op\"\n"
					"func use() *uint8 { return __c_entry(op.H) }\n")
	return expectErrSub(c, "return with no defined ABI layout")
}

// A pointer/handle to an opaque type has a defined layout (a pointer word), so a
// __c_entry target taking `*Opaque` / `@Opaque` is accepted: embedsOpaqueByValue
// stops recursion at pointers/handles.  Pins the pointer-stops-recursion behavior
// at the __c_entry boundary directly, guarding against a future over-rejection.
func TestCheckCEntryAcceptsOpaquePointerParam() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func g(p *Opaque, h @Opaque) int { return 0 }\n"
					"func use() *uint8 { return __c_entry(g) }\n")
	return expectNoErrors(c)
}
