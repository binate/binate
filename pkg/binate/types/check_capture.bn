package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// Capture analysis (Slice B.1 of plan-function-values-phase-2.md).
//
// Function literals can reference identifiers from enclosing
// function or block scopes; each such reference is recorded as a
// capture on the literal's synthetic Decl so IR-gen (B.2..B.4)
// can lay out the closure struct + dtor + per-shape call shim.
//
// Recording lives in this file; the entry points are:
//
//   pushCaptureFrame(c, d, bodyScope)
//       Call at the start of checking a function-literal body.
//
//   popCaptureFrame(c)
//       Call when the body checks out — pops the innermost frame.
//
//   noteCaptureIfNeeded(c, sym, name, pos)
//       Call from any Ident-lookup site that has resolved a name
//       to a Symbol.  No-op when not inside a literal body; when
//       inside, walks the capture stack from innermost outward
//       and appends to LitDecl.Captures on every frame whose
//       BodyScope the resolution crosses.  Dedup by name.
//
// Captures are by-value per the design (see
// plan-function-values-phase-2.md §"Capture semantics") — Kind
// indicates the refcount class (CAP_VAL / CAP_RAW_PTR /
// CAP_MANAGED) so IR-gen knows whether to emit RefInc/RefDec
// pairs around the captured slot.

// pushCaptureFrame pushes a fresh frame for `d` with `bodyScope`
// as the capture boundary.  The frame stays on the stack until
// popCaptureFrame is called.
func pushCaptureFrame(c @Checker, d @ast.Decl, bodyScope @Scope) {
	var f @CaptureFrame = make(CaptureFrame)
	f.LitDecl = d
	f.BodyScope = bodyScope
	c.CaptureStack = slices.Append[@CaptureFrame](c.CaptureStack, f)
}

// popCaptureFrame removes and returns the innermost capture
// frame.  Returns nil if the stack is empty (should not happen
// in well-formed input).
func popCaptureFrame(c @Checker) @CaptureFrame {
	var n int = len(c.CaptureStack)
	if n == 0 { return nil }
	var f @CaptureFrame = c.CaptureStack[n - 1]
	c.CaptureStack = sliceCaptureFrames(c.CaptureStack, 0, n - 1)
	return f
}

// noteCaptureIfNeeded records a capture on every active frame
// the resolution crosses.  Skipped for symbol kinds that are
// not captured (package handles, type names, declared
// interfaces) — those resolve to compile-time-static identities
// that don't need a closure slot.
func noteCaptureIfNeeded(c @Checker, sym @Symbol, name @[]char, pos token.Pos) {
	if sym == nil { return }
	if len(c.CaptureStack) == 0 { return }
	if !isCapturableKind(sym.Kind) { return }
	if sym.Type == nil { return }
	// A package-level global is a SYM_VAR too, but it has static storage
	// accessible by name from anywhere (like a func or const), so a closure
	// must READ IT LIVE, not capture a snapshot at creation — otherwise it
	// diverges from an ordinary function's live read (a silent miscompile).
	// IR-gen's lookupVar falls back to Module.GlobalVars for a name absent
	// from the capture params, so leaving the global out of Captures makes
	// the body read the live global.
	if symIsPackageGlobal(c, sym, name) { return }

	// Walk innermost-to-outermost.  The first frame at which the
	// symbol resolves locally (LookupLocal succeeds at or before
	// BodyScope) is the owning frame; outer frames don't need a
	// capture for this name.
	for i := len(c.CaptureStack) - 1; i >= 0; i = i - 1 {
		var f @CaptureFrame = c.CaptureStack[i]
		if !isBeyondBoundary(c.Scope, f.BodyScope, name) {
			// Name resolves locally for this frame and any frame
			// nested inside it (already handled above).  Stop.
			return
		}
		recordCaptureOnFrame(c, f, sym, name, pos)
	}
}

// isCapturableKind reports whether a symbol of this kind needs
// a closure-struct slot when referenced from inside a function
// literal.  Only ordinary variables count: package-level funcs
// (SYM_FUNC), package-level consts (SYM_CONST), package handles
// (SYM_PKG), type names (SYM_TYPE), and declared interfaces
// (SYM_INTERFACE) are all link-time / static entities accessible
// by name from anywhere in the program — no per-frame storage
// is needed for them, so closures don't capture them.  A
// FUNCTION-LOCAL SYM_VAR (a source `var f = ...` / param / `:=`
// binding inside an enclosing function) IS captured; a
// PACKAGE-level SYM_VAR is excluded separately (symIsPackageGlobal),
// since it too has static storage and must be read live.
func isCapturableKind(kind int) bool {
	if kind == SYM_VAR { return true }
	return false
}

// symIsPackageGlobal reports whether `sym` (already resolved for `name`) is a
// package-LEVEL variable — one owned by the package scope, not an enclosing
// function/block local.  Compared by symbol IDENTITY (not name) so a local
// that SHADOWS a package global is still captured (its resolved symbol is the
// local, a different object from the package-scope symbol).  A package global
// has static storage read live by name from anywhere, so a closure must not
// snapshot it into a capture slot — see noteCaptureIfNeeded.
func symIsPackageGlobal(c @Checker, sym @Symbol, name @[]char) bool {
	if c.PackageScope == nil { return false }
	var g @Symbol = c.PackageScope.LookupLocal(name)
	return g != nil && same(g, sym)
}

// isBeyondBoundary reports whether `name`, looked up from scope
// `from`, resolves to a symbol defined OUTSIDE the scope subtree
// rooted at `body`.  Walks parents of `from` up to and including
// `body`; if LookupLocal succeeds at any of those, the symbol is
// local to the body (returns false).  Otherwise — the resolution
// crosses the boundary into outer scopes (returns true).
func isBeyondBoundary(from @Scope, body @Scope, name @[]char) bool {
	var s @Scope = from
	for s != nil {
		if s.LookupLocal(name) != nil {
			return false
		}
		if s == body {
			// Walked all the way down to body without a local
			// hit; any further hit (Lookup found something) must
			// be from beyond.
			return true
		}
		s = s.Parent
	}
	// Walked past body (shouldn't normally happen — from should
	// always be within body's subtree when this is called).
	return true
}

// recordCaptureOnFrame appends a Capture entry to f.LitDecl.Captures
// for `name`, unless an entry already exists (dedup — first use
// wins layout order).
func recordCaptureOnFrame(c @Checker, f @CaptureFrame, sym @Symbol, name @[]char, pos token.Pos) {
	var caps @[]@ast.Capture = f.LitDecl.Captures
	for i := 0; i < len(caps); i++ {
		if charEq(caps[i].Name, name) {
			return
		}
	}
	var cap @ast.Capture = make(ast.Capture)
	cap.Pos = pos
	cap.Name = name
	cap.Kind = captureKindFromType(sym.Type)
	cap.ResolvedTypeID = registerExprType(c, sym.Type)
	f.LitDecl.Captures = slices.Append[@ast.Capture](f.LitDecl.Captures, cap)
}

// captureKindFromType maps a captured value's Type to its
// refcount class (the CAP_* constants in pkg/binate/ast).  Managed
// pointer / managed-slice / managed function-value / managed
// interface-value are CAP_MANAGED (RefInc on capture, RefDec
// at closure destruction).  Raw pointer is CAP_RAW_PTR (plain
// copy, lifetime user's responsibility).  Everything else is
// CAP_VAL (plain copy, no refcount).
func captureKindFromType(t @Type) int {
	if t == nil { return ast.CAP_VAL }
	var rt @Type = t.ResolveAlias()
	if rt == nil { return ast.CAP_VAL }
	if rt.Kind == TYP_READONLY { rt = rt.Elem.ResolveAlias() }
	if rt == nil { return ast.CAP_VAL }
	if rt.Kind == TYP_MANAGED_PTR { return ast.CAP_MANAGED }
	if rt.Kind == TYP_MANAGED_SLICE { return ast.CAP_MANAGED }
	if rt.Kind == TYP_MANAGED_FUNC_VALUE { return ast.CAP_MANAGED }
	if rt.Kind == TYP_INTERFACE_VALUE_MANAGED { return ast.CAP_MANAGED }
	if rt.Kind == TYP_POINTER { return ast.CAP_RAW_PTR }
	return ast.CAP_VAL
}

// sliceCaptureFrames returns s[lo:hi] as a fresh managed slice.
// Used by popCaptureFrame to shrink the stack without holding
// a borrow.
func sliceCaptureFrames(s @[]@CaptureFrame, lo int, hi int) @[]@CaptureFrame {
	var n int = hi - lo
	if n <= 0 {
		var empty @[]@CaptureFrame
		return empty
	}
	var ns @[]@CaptureFrame = make_slice(@CaptureFrame, n)
	for i := 0; i < n; i++ { ns[i] = s[lo + i] }
	return ns
}
