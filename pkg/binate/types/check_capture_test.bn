package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/builtins/testing"

// Unit tests for the capture-recording helpers in check_capture.bn.
// End-to-end capture detection (literal-body → Decl.Captures) is
// covered by the TestCheckFuncLit* tests in check_func_lit_test.bn;
// these tests exercise the building-block helpers directly.

// pushCaptureFrame + popCaptureFrame round-trip leaves the stack
// empty and returns the pushed frame.
func TestCaptureFrameRoundTrip() testing.TestResult {
	var c @Checker = NewChecker()
	var d @ast.Decl = make(ast.Decl)
	d.Name = "__funclit_0"
	var body @Scope = NewScope(c.Scope)
	pushCaptureFrame(c, d, body)
	if len(c.CaptureStack) != 1 {
		return fail("expected 1 frame after push")
	}
	var f @CaptureFrame = popCaptureFrame(c)
	if f == nil { return fail("popCaptureFrame returned nil") }
	if f.LitDecl == nil || !streq(f.LitDecl.Name, "__funclit_0") {
		return fail("popped frame has wrong LitDecl")
	}
	if len(c.CaptureStack) != 0 {
		return fail("expected empty stack after pop")
	}
	return ""
}

// noteCaptureIfNeeded with no active frame is a silent no-op.
func TestNoteCaptureNoFrameIsNoop() testing.TestResult {
	var c @Checker = NewChecker()
	var sym @Symbol = make(Symbol)
	sym.Name = "x"
	sym.Type = TypInt()
	sym.Kind = SYM_VAR
	noteCaptureIfNeeded(c, sym, "x", token.Pos{})
	// No frame to record onto — just verify nothing crashes.
	return ""
}

// captureKindFromType maps types to the right CAP_* constant.
func TestCaptureKindFromTypeInt() testing.TestResult {
	if captureKindFromType(TypInt()) != ast.CAP_VAL {
		return fail("int should map to CAP_VAL")
	}
	return ""
}

func TestCaptureKindFromTypeManagedPtr() testing.TestResult {
	var fields @[]@Field
	var s @Type = MakeStructType("Box", fields)
	var mt @Type = MakeManagedPtrType(s)
	if captureKindFromType(mt) != ast.CAP_MANAGED {
		return fail("@T should map to CAP_MANAGED")
	}
	return ""
}

func TestCaptureKindFromTypeRawPtr() testing.TestResult {
	var pt @Type = MakePointerType(TypInt())
	if captureKindFromType(pt) != ast.CAP_RAW_PTR {
		return fail("*T should map to CAP_RAW_PTR")
	}
	return ""
}

func TestCaptureKindFromTypeManagedSlice() testing.TestResult {
	var mst @Type = MakeManagedSliceType(TypInt())
	if captureKindFromType(mst) != ast.CAP_MANAGED {
		return fail("@[]T should map to CAP_MANAGED")
	}
	return ""
}

func TestCaptureKindFromTypeRawSlice() testing.TestResult {
	var rst @Type = MakeSliceType(TypInt())
	if captureKindFromType(rst) != ast.CAP_VAL {
		return fail("*[]T should map to CAP_VAL (raw — plain copy)")
	}
	return ""
}

func TestCaptureKindFromTypeNil() testing.TestResult {
	if captureKindFromType(nil) != ast.CAP_VAL {
		return fail("nil type should default to CAP_VAL")
	}
	return ""
}

// isBeyondBoundary walks the scope chain correctly: hits inside
// the body return false; hits past the body return true.
func TestIsBeyondBoundaryLocalHit() testing.TestResult {
	var outer @Scope = NewScope(nil)
	var sym @Symbol = make(Symbol)
	sym.Name = "x"
	sym.Type = TypInt()
	sym.Kind = SYM_VAR
	outer.Define(sym)
	var body @Scope = NewScope(outer)
	// Define x locally too — Lookup from body finds it locally.
	body.Define(sym)
	if isBeyondBoundary(body, body, "x") {
		return fail("local hit should not be a capture")
	}
	return ""
}

func TestIsBeyondBoundaryOuterHit() testing.TestResult {
	var outer @Scope = NewScope(nil)
	var sym @Symbol = make(Symbol)
	sym.Name = "x"
	sym.Type = TypInt()
	sym.Kind = SYM_VAR
	outer.Define(sym)
	var body @Scope = NewScope(outer)
	// `x` is defined only at outer; from body's view it's beyond.
	if !isBeyondBoundary(body, body, "x") {
		return fail("outer hit should be a capture")
	}
	return ""
}

// Nested-block walk: a reference from a block inside the literal
// body finds a local-to-body symbol without crossing the boundary.
func TestIsBeyondBoundaryNestedBlock() testing.TestResult {
	var outer @Scope = NewScope(nil)
	var body @Scope = NewScope(outer)
	var sym @Symbol = make(Symbol)
	sym.Name = "y"
	sym.Type = TypInt()
	sym.Kind = SYM_VAR
	body.Define(sym)  // y is local to body
	var innerBlock @Scope = NewScope(body)
	if isBeyondBoundary(innerBlock, body, "y") {
		return fail("body-local sym reached from nested block is not a capture")
	}
	return ""
}

// isCapturableKind: only SYM_VAR captures.
func TestIsCapturableKind() testing.TestResult {
	if !isCapturableKind(SYM_VAR) {
		return fail("SYM_VAR should be capturable")
	}
	if isCapturableKind(SYM_FUNC) {
		return fail("SYM_FUNC (package-level fn) should not capture")
	}
	if isCapturableKind(SYM_CONST) {
		return fail("SYM_CONST should not capture")
	}
	if isCapturableKind(SYM_PKG) {
		return fail("SYM_PKG should not capture")
	}
	if isCapturableKind(SYM_TYPE) {
		return fail("SYM_TYPE should not capture")
	}
	if isCapturableKind(SYM_INTERFACE) {
		return fail("SYM_INTERFACE should not capture")
	}
	return ""
}

// symIsPackageGlobal: a package-scope symbol is a global (by IDENTITY); a
// distinct same-named symbol (a shadowing local) is not; an absent name is not.
func TestSymIsPackageGlobalIdentity() testing.TestResult {
	var c @Checker = NewChecker()
	var pkg @Scope = NewScope(nil)
	c.PackageScope = pkg
	var g @Symbol = make(Symbol)
	g.Name = "g"
	g.Type = TypInt()
	g.Kind = SYM_VAR
	pkg.Define(g)
	if !symIsPackageGlobal(c, g, "g") {
		return fail("the package-scope symbol should be a package global")
	}
	// A distinct symbol with the same name (a local that shadows the global)
	// must NOT be treated as the global — identity, not name, decides.
	var local @Symbol = make(Symbol)
	local.Name = "g"
	local.Type = TypInt()
	local.Kind = SYM_VAR
	if symIsPackageGlobal(c, local, "g") {
		return fail("a shadowing local (distinct identity) is not the global")
	}
	if symIsPackageGlobal(c, g, "absent") {
		return fail("a name not in package scope is not a global")
	}
	return ""
}

// symIsPackageGlobal is a safe no-op (false) when no package scope is set.
func TestSymIsPackageGlobalNilScope() testing.TestResult {
	var c @Checker = NewChecker()
	c.PackageScope = nil
	var s @Symbol = make(Symbol)
	s.Name = "x"
	s.Type = TypInt()
	s.Kind = SYM_VAR
	if symIsPackageGlobal(c, s, "x") {
		return fail("nil PackageScope should yield false")
	}
	return ""
}
