package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/bignum"
import "pkg/binate/token"

// ============================================================
// Cast Constant Fit-Checking
// ============================================================
//
// A `cast` to an integer type is value-preserving: a CONSTANT operand
// whose value does not fit the target type's range is an error (a
// deliberate truncation / reinterpretation uses bit_cast or masking).
// foldConstNum folds the operand EXACTLY in bignum.Num, so a magnitude
// >= 2^63 (or an arithmetic overflow past 2^64-1) is judged correctly
// rather than wrapped through a host int.  Shared by checkBuiltinCall
// (value position) and validateDimCasts (the array-dimension walk).

// castTargetIsInteger reports whether t (after peeling alias / const /
// named wrappers, mirroring untypedIntLitFitsTarget) is an integer
// type.  Only integer cast targets have a constant arg range-checked;
// untypedIntLitFitsTarget returns false for any non-integer target, so
// without this guard a valid cast like `cast(float64, 5)` would be
// wrongly rejected.
func castTargetIsInteger(t @Type) bool {
	var d @Type = resolveAliasAndConst(t)
	if d == nil { return false }
	if d.Kind == TYP_NAMED && d.Underlying != nil {
		d = d.Underlying
	}
	return d != nil && d.Kind == TYP_INT
}

// FOLD_OK / FOLD_OVERFLOW / FOLD_UNKNOWN classify foldConstNum's result.
const (
	FOLD_OK int = iota
	FOLD_OVERFLOW
	FOLD_UNKNOWN
)

// isBitwiseOp reports whether op is a binary bitwise/shift operator
// (&, |, ^, <<, >>) — the operators foldBitwise handles.  All fold on the
// NON-NEGATIVE magnitudes (the caller routes negative operands to the
// host-int fallback, where a width-fixed two's-complement / arithmetic
// shift applies).  `>>` is a LOGICAL shift here — correct for the unsigned
// operands this path serves.
func isBitwiseOp(op int) bool {
	return op == cast(int, token.AMP) || op == cast(int, token.PIPE) || op == cast(int, token.CARET) ||
			op == cast(int, token.SHL) || op == cast(int, token.SHR)
}

// foldBitwise applies a binary bitwise/shift operator to two NON-NEGATIVE
// bignum operands (the caller guarantees non-negativity).  ok=false on
// overflow (only a left shift past 2^64-1 can overflow).
func foldBitwise(op int, a bignum.Num, b bignum.Num) (bignum.Num, bool) {
	if op == cast(int, token.AMP) {
		return a.And(b)
	}
	if op == cast(int, token.PIPE) {
		return a.Or(b)
	}
	if op == cast(int, token.CARET) {
		return a.Xor(b)
	}
	if op == cast(int, token.SHL) {
		return a.Shl(b)
	}
	return a.Shr(b)
}

// foldConstNum folds a constant integer expression to an EXACT bignum.Num for
// the cast fit-check.  Unlike evalConstIntValue (which folds through a host int
// and silently wraps a magnitude >= 2^63), bignum.Num covers [-2^63, 2^64-1]
// and its Add/Sub/Mul/Div/Mod/Neg + non-negative &/|/^/<< report out-of-range,
// so const ARITHMETIC and non-negative BITWISE/left-shift are judged exactly:
//   FOLD_OK       — n is the exact value.
//   FOLD_OVERFLOW — the value is outside [-2^63, 2^64-1], so it fits NO integer
//                   type (the widest are int64 / uint64) — the cast is rejected.
//   FOLD_UNKNOWN  — not foldable here (a non-constant, a bit_cast, a right shift,
//                   or a bitwise op with a NEGATIVE operand, whose two's
//                   complement is width-dependent); the caller falls back to the
//                   host-int path, exact for the magnitudes it handles.
// A const-ident / qualified const is reconstructed exactly from the symbol's
// int64 ConstVal + declared signedness (a >= 2^63 unsigned const is stored as
// a negative int64 whose uint64 bit pattern is its exact magnitude).
func foldConstNum(c @Checker, e @ast.Expr) (bignum.Num, int) {
	if e == nil {
		return bignum.Zero(), FOLD_UNKNOWN
	}
	if e.Kind == ast.EXPR_INT_LIT {
		var n bignum.Num
		var ok bool
		n, ok = bignum.ParseLiteral(e.Name)
		if ok {
			return n, FOLD_OK
		}
		return bignum.Zero(), FOLD_OVERFLOW
	}
	if e.Kind == ast.EXPR_CHAR_LIT {
		return bignum.FromInt(ParseCharLit(e.Name)), FOLD_OK
	}
	if e.Kind == ast.EXPR_IDENT || e.Kind == ast.EXPR_SELECTOR {
		var sym @Symbol = nil
		if e.Kind == ast.EXPR_IDENT {
			sym = c.Scope.Lookup(e.Name)
		} else {
			sym = resolveQualifiedSym(c, e)
		}
		if sym == nil || sym.Kind != SYM_CONST || !sym.HasConstVal {
			return bignum.Zero(), FOLD_UNKNOWN
		}
		var p @Type = peelNamedBounded(sym.Type)
		if p == nil || p.Kind != TYP_INT {
			return bignum.Zero(), FOLD_UNKNOWN
		}
		if p.Signed {
			return bignum.FromInt64(sym.ConstVal), FOLD_OK
		}
		return bignum.FromUint64(cast(uint64, sym.ConstVal)), FOLD_OK
	}
	if e.Kind == ast.EXPR_UNARY {
		var x bignum.Num
		var k int
		x, k = foldConstNum(c, e.X)
		if k != FOLD_OK {
			return x, k
		}
		if e.Op == cast(int, token.PLUS) {
			return x, FOLD_OK
		}
		if e.Op == cast(int, token.MINUS) {
			var r bignum.Num
			var ok bool
			r, ok = x.Neg()
			if ok {
				return r, FOLD_OK
			}
			return bignum.Zero(), FOLD_OVERFLOW
		}
		return bignum.Zero(), FOLD_UNKNOWN
	}
	if e.Kind == ast.EXPR_BINARY {
		var lhs bignum.Num
		var lk int
		lhs, lk = foldConstNum(c, e.X)
		if lk == FOLD_UNKNOWN {
			return bignum.Zero(), FOLD_UNKNOWN
		}
		var rhs bignum.Num
		var rk int
		rhs, rk = foldConstNum(c, e.Y)
		if rk == FOLD_UNKNOWN {
			return bignum.Zero(), FOLD_UNKNOWN
		}
		if lk == FOLD_OVERFLOW || rk == FOLD_OVERFLOW {
			return bignum.Zero(), FOLD_OVERFLOW
		}
		var r bignum.Num
		var ok bool = false
		if e.Op == cast(int, token.PLUS) {
			r, ok = lhs.Add(rhs)
		} else if e.Op == cast(int, token.MINUS) {
			r, ok = lhs.Sub(rhs)
		} else if e.Op == cast(int, token.STAR) {
			r, ok = lhs.Mul(rhs)
		} else if e.Op == cast(int, token.SLASH) {
			if rhs.IsZero() {
				return bignum.Zero(), FOLD_UNKNOWN
			}
			r, ok = lhs.Div(rhs)
		} else if e.Op == cast(int, token.PERCENT) {
			if rhs.IsZero() {
				return bignum.Zero(), FOLD_UNKNOWN
			}
			r, ok = lhs.Mod(rhs)
		} else if isBitwiseOp(e.Op) {
			// Bitwise (&, |, ^) and left shift (<<): bignum models these for
			// NON-NEGATIVE operands only (a two's-complement bitwise op on a
			// negative value is width-dependent, which a width-less constant
			// can't represent).  A negative operand falls back to the host-int
			// fold, which folds a fixed-width-64 two's complement — symmetric
			// with IR-gen's evalConstExpr, so no silent miscompile.  (For SHL
			// the left operand is the value and the right is the count; a
			// negative count is also routed to the fallback, where
			// checkShiftCountNonNegative reports it.)  Right shift is excluded
			// (see isBitwiseOp) and reaches the host-int fallback below.
			if lhs.IsNegative() || rhs.IsNegative() {
				return bignum.Zero(), FOLD_UNKNOWN
			}
			r, ok = foldBitwise(e.Op, lhs, rhs)
		} else {
			return bignum.Zero(), FOLD_UNKNOWN
		}
		if ok {
			return r, FOLD_OK
		}
		return bignum.Zero(), FOLD_OVERFLOW
	}
	if e.Kind == ast.EXPR_BUILTIN {
		if e.Op == cast(int, token.SIZEOF) {
			var t @Type = resolveTypeExpr(c, e.TypeRef)
			if t == nil {
				return bignum.Zero(), FOLD_UNKNOWN
			}
			// An opaque type has no known size.  Don't fabricate one (SizeOf
			// returns ptrSize as a fallback): folding it here would make the
			// fit-check judge a wrong magnitude and emit a spurious "does not
			// fit" on top of the opaque diagnostic the sizeof builtin already
			// reports.  FOLD_UNKNOWN defers to the (gated) host-int fallback.
			if embedsOpaqueByValue(c, t) {
				return bignum.Zero(), FOLD_UNKNOWN
			}
			return bignum.FromInt(t.SizeOf()), FOLD_OK
		}
		if e.Op == cast(int, token.ALIGNOF) {
			var t @Type = resolveTypeExpr(c, e.TypeRef)
			if t == nil {
				return bignum.Zero(), FOLD_UNKNOWN
			}
			if embedsOpaqueByValue(c, t) {
				return bignum.Zero(), FOLD_UNKNOWN
			}
			return bignum.FromInt(t.AlignOf()), FOLD_OK
		}
		if e.Op == cast(int, token.CAST) {
			// A cast passes its (in-range) operand through; an out-of-range
			// inner cast is itself rejected by checkCastConstFits at its site.
			if len(e.Args) != 1 {
				return bignum.Zero(), FOLD_UNKNOWN
			}
			return foldConstNum(c, e.Args[0])
		}
		// bit_cast reinterprets bits — not modeled here; fall back.
		return bignum.Zero(), FOLD_UNKNOWN
	}
	return bignum.Zero(), FOLD_UNKNOWN
}

// isRelationalOp reports whether op is one of ==, !=, <, >, <=, >= — the
// comparison operators foldConstBoolValue folds.
func isRelationalOp(op int) bool {
	return op == cast(int, token.EQ) || op == cast(int, token.NEQ) || op == cast(int, token.LT) ||
			op == cast(int, token.GT) || op == cast(int, token.LEQ) || op == cast(int, token.GEQ)
}

// foldConstBoolValue folds a constant BOOLEAN expression to (value, ok),
// signedness-correctly.  It handles bool literals, the logical operators (!,
// &&, ||) over operands it folds, and the relational comparisons (==, !=, <, >,
// <=, >=) of two integer const operands — folded via the EXACT bignum value
// (foldConstNum) and ordered with Num.Cmp, so an UNSIGNED operand >= 2^63
// compares unsigned (Cmp orders by sign then magnitude, and foldConstNum encodes
// such an operand as a non-negative Num).  The host-int comparison IR-gen's
// evalConstBool does would fold the operands SIGNED and compare them signed,
// silently miscompiling `const C bool = U > D` (2^63 > 2^61) to false.  ok=false
// for any form it can't reduce — a bool const ident (the checker doesn't record
// bool const values), an out-of-range or non-constant operand — and the caller
// then leaves the const value-less so IR-gen's evalConstBool (correct for the
// non-comparison forms) computes it.
func foldConstBoolValue(c @Checker, e @ast.Expr) (bool, bool) {
	if e == nil {
		return false, false
	}
	if e.Kind == ast.EXPR_BOOL_LIT {
		return e.BoolVal, true
	}
	if e.Kind == ast.EXPR_UNARY && e.Op == cast(int, token.NOT) {
		var x bool
		var xok bool
		x, xok = foldConstBoolValue(c, e.X)
		if !xok {
			return false, false
		}
		return !x, true
	}
	if e.Kind == ast.EXPR_BINARY {
		if e.Op == cast(int, token.LAND) || e.Op == cast(int, token.LOR) {
			var l bool
			var lok bool
			l, lok = foldConstBoolValue(c, e.X)
			if !lok {
				return false, false
			}
			var r bool
			var rok bool
			r, rok = foldConstBoolValue(c, e.Y)
			if !rok {
				return false, false
			}
			if e.Op == cast(int, token.LAND) {
				return l && r, true
			}
			return l || r, true
		}
		if isRelationalOp(e.Op) {
			var ln bignum.Num
			var lk int
			ln, lk = foldConstNum(c, e.X)
			if lk != FOLD_OK {
				return false, false
			}
			var rn bignum.Num
			var rk int
			rn, rk = foldConstNum(c, e.Y)
			if rk != FOLD_OK {
				return false, false
			}
			var cmp int = ln.Cmp(rn)
			if e.Op == cast(int, token.EQ) {
				return cmp == 0, true
			}
			if e.Op == cast(int, token.NEQ) {
				return cmp != 0, true
			}
			if e.Op == cast(int, token.LT) {
				return cmp < 0, true
			}
			if e.Op == cast(int, token.GT) {
				return cmp > 0, true
			}
			if e.Op == cast(int, token.LEQ) {
				return cmp <= 0, true
			}
			if e.Op == cast(int, token.GEQ) {
				return cmp >= 0, true
			}
		}
	}
	return false, false
}

// foldConstIntValue folds a constant integer expression to its host-int bit
// pattern via the signedness-aware bignum foldConstNum — so the
// signedness-DEPENDENT ops (/, %, >>) over an unsigned operand >= 2^63 yield
// the correct value, unlike evalConstIntValue's host-int fold (which folds them
// signed).  ok=false when foldConstNum can't fold the expression exactly (a
// non-constant, a bitwise op with a negative operand, or an out-of-range
// result); the caller then falls back to evalConstIntValue.  ToInt returns the
// two's-complement bit pattern (a magnitude >= 2^63 reads back as a negative
// host int — its exact stored representation).
func foldConstIntValue(c @Checker, e @ast.Expr) (int64, bool) {
	var n bignum.Num
	var k int
	n, k = foldConstNum(c, e)
	if k != FOLD_OK {
		return 0, false
	}
	return n.ToInt64(), true
}

// numFitsTarget reports whether bignum value n fits integer cast target typ.
// A non-integer target is unconstrained.
func numFitsTarget(n bignum.Num, typ @Type) bool {
	var p @Type = peelNamedBounded(typ)
	if p == nil || p.Kind != TYP_INT {
		return true
	}
	var w int = p.SizeOf() * 8
	if p.Signed {
		return n.FitsSigned(w)
	}
	return n.FitsUnsigned(w)
}

// checkCastConstFits reports "constant does not fit the cast target type (use
// bit_cast to reinterpret)" when a `cast` to an integer type has a CONSTANT
// operand whose value does not fit that type's range.  A cast is value-
// preserving: a constant that doesn't fit is an error, and a deliberate
// truncation / reinterpretation uses bit_cast (same-size) or explicit masking.
// Casting a constant does NOT launder it — `cast(int8, cast(int, 200))` folds
// to the constant 200 and is rejected just like `cast(int8, 200)`.  The operand
// is folded EXACTLY via the bignum foldConstNum (literals, const idents,
// +,-,*,/,% arithmetic, and non-negative &,|,^,<< — so a result >= 2^63 is
// judged correctly, not wrapped through a host int); a form bignum can't model
// (a bit_cast, a right shift, or a bitwise op with a NEGATIVE operand) falls
// back to the HasLitVal / host-int fold.  Shared by the value-position check
// (checkBuiltinCall) and the array-dimension walk (validateDimCasts).
func checkCastConstFits(c @Checker, pos token.Pos, typ @Type, argType @Type, argExpr @ast.Expr) {
	if !castTargetIsInteger(typ) {
		return
	}
	var n bignum.Num
	var k int
	n, k = foldConstNum(c, argExpr)
	if k == FOLD_OVERFLOW {
		addCheckError(c, pos, "constant does not fit the cast target type (use bit_cast to reinterpret)")
		return
	}
	if k == FOLD_OK {
		if !numFitsTarget(n, typ) {
			addCheckError(c, pos, "constant does not fit the cast target type (use bit_cast to reinterpret)")
		}
		return
	}
	// FOLD_UNKNOWN (a bitwise op, bit_cast, or a non-constant): fall back to the
	// untyped-literal bignum (HasLitVal) or the host-int fold.
	var fits @Type = nil
	if argType != nil && argType.HasLitVal {
		fits = argType
	} else {
		var v int
		var ok bool
		v, ok = evalConstIntValue(c, argExpr)
		if ok {
			fits = makeUntypedIntWithLit(v)
		}
	}
	if fits != nil && !untypedIntLitFitsTarget(fits, typ) {
		addCheckError(c, pos, "constant does not fit the cast target type (use bit_cast to reinterpret)")
	}
}
