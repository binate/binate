package "pkg/binate/types"

import "pkg/builtins/testing"

// Constant cast fit-checking (check_cast_fits.bn): a `cast` to an integer
// type rejects a CONSTANT operand whose value is out of the target's range.
// These pin the diagnostic paths — direct literals, const idents, nested
// casts (no laundering), high-magnitude (>= 2^63) consts, and exact bignum
// arithmetic folding — which are easy to silently regress.

// A constant cast to an integer type whose value is out of range is a
// compile error (cast(uint, -1), cast(uint8, 256)); bit_cast is the
// unchecked reinterpretation escape. §8.
func TestCheckCastConstantOverflowRejected() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint = cast(uint, -1)\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("cast(uint, -1) must be a fit-check error")
	}
	var c2 @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = cast(uint8, 256)\n")
	if len(c2.CheckerErrors()) == 0 {
		return fail("cast(uint8, 256) must be a fit-check error")
	}
	return ""
}

// An in-range constant cast checks cleanly, and a non-integer target
// (float) must NOT be range-rejected (untypedIntLitFitsTarget is false
// for any non-int target, so the cast must be guarded on TYP_INT).
func TestCheckCastConstantInRangeAccepted() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = cast(uint8, 255)\n")
	if len(c.CheckerErrors()) != 0 {
		return fail("cast(uint8, 255) must check cleanly")
	}
	var c2 @Checker = checkSrc(
		"package \"test\"\nvar x float64 = cast(float64, 5)\n")
	if len(c2.CheckerErrors()) != 0 {
		return fail("cast(float64, 5) must check cleanly (non-int target)")
	}
	return ""
}

// A cast does NOT launder a constant: an out-of-range cast is an error even
// when the operand is a const-ident or a nested cast (it folds to the constant),
// not only a direct literal.  §8 / DECIDED 2026-06-17.
func TestCheckCastConstIdentOverflowRejected() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nconst M int = 257\nvar v uint8 = cast(uint8, M)\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("cast(uint8, M) with M=257 must be a fit-check error")
	}
	return ""
}

func TestCheckCastLaunderedOverflowRejected() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar v int8 = cast(int8, cast(int, 200))\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("cast(int8, cast(int, 200)) must be a fit-check error (no laundering)")
	}
	return ""
}

// An in-range const-ident / nested cast still checks cleanly (no over-reject).
func TestCheckCastConstInRangeAccepted() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nconst M int = 100\nvar v int8 = cast(int8, M)\n")
	if len(c.CheckerErrors()) != 0 {
		return fail("cast(int8, M) with M=100 must check cleanly")
	}
	var c2 @Checker = checkSrc(
		"package \"test\"\nvar v int8 = cast(int8, cast(int, 100))\n")
	if len(c2.CheckerErrors()) != 0 {
		return fail("cast(int8, cast(int, 100)) must check cleanly")
	}
	return ""
}

// A const with magnitude >= 2^63 is fit-checked EXACTLY (foldConstNum folds it
// in bignum), not through the lossy host-int fold: 2^63 does not fit int64, but
// a same-type cast is fine.
func TestCheckCastHighMagnitudeConstRejected() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nconst M uint64 = 0x8000000000000000\n"
		"var v int64 = cast(int64, M)\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("cast(int64, M) with M=2^63 must be a fit-check error")
	}
	var c2 @Checker = checkSrc(
		"package \"test\"\nconst M uint64 = 0x8000000000000000\n"
		"var v uint64 = cast(uint64, M)\n")
	if len(c2.CheckerErrors()) != 0 {
		return fail("cast(uint64, M) with M=2^63 must check cleanly (same type)")
	}
	return ""
}

// Const ARITHMETIC is fit-checked in bignum (foldConstNum), so a result >= 2^63
// or an overflow past 2^64-1 is judged by its TRUE value, not a wrapped host
// int.  `A*B`==2^63 doesn't fit int64 -> reject; `A*A`==2^64 fits no int type ->
// reject; `A*2+1`==2^63+1 fits uint64 -> accept (the host-int fold wrongly
// rejected it).
func TestCheckCastConstArithmeticExact() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nconst A uint64 = 0x4000000000000000\n"
		"var v int64 = cast(int64, A * 2)\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("cast(int64, A*2)==2^63 must be rejected")
	}
	var c2 @Checker = checkSrc(
		"package \"test\"\nconst A uint64 = 0x100000000\n"
		"var v uint8 = cast(uint8, A * A)\n")
	if len(c2.CheckerErrors()) == 0 {
		return fail("cast(uint8, A*A)==2^64 (overflow) must be rejected")
	}
	var c3 @Checker = checkSrc(
		"package \"test\"\nconst A uint64 = 0x4000000000000000\n"
		"var v uint64 = cast(uint64, A * 2 + 1)\n")
	if len(c3.CheckerErrors()) != 0 {
		return fail("cast(uint64, A*2+1)==2^63+1 fits uint64 — must NOT be rejected")
	}
	return ""
}

// Non-negative const BITWISE/shift is folded in bignum too, so a result >= 2^63
// is judged exactly.  `A<<1`==2^63 doesn't fit int64 -> reject; `A<<3`==2^65
// overflows -> reject; `M|1`==2^63+1 fits uint64 -> accept.  A NEGATIVE operand
// is width-dependent, so it falls back to the host-int fold (`-1 & 0xff`==0xff
// fits uint8 -> accept) — exercising that the fallback still works.
func TestCheckCastConstBitwiseExact() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nconst A uint64 = 0x4000000000000000\n"
		"var v int64 = cast(int64, A << 1)\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("cast(int64, A<<1)==2^63 must be rejected")
	}
	var c2 @Checker = checkSrc(
		"package \"test\"\nconst A uint64 = 0x4000000000000000\n"
		"var v uint64 = cast(uint64, A << 3)\n")
	if len(c2.CheckerErrors()) == 0 {
		return fail("cast(uint64, A<<3)==2^65 (overflow) must be rejected")
	}
	var c3 @Checker = checkSrc(
		"package \"test\"\nconst M uint64 = 0x8000000000000000\n"
		"var v uint64 = cast(uint64, M | 1)\n")
	if len(c3.CheckerErrors()) != 0 {
		return fail("cast(uint64, M|1)==2^63+1 fits uint64 — must NOT be rejected")
	}
	var c4 @Checker = checkSrc(
		"package \"test\"\nvar v uint8 = cast(uint8, (0 - 1) & 0xff)\n")
	if len(c4.CheckerErrors()) != 0 {
		return fail("cast(uint8, (-1)&0xff)==0xff via host-int fallback — must NOT be rejected")
	}
	return ""
}
