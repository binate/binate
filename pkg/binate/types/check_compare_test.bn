package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for the == / != and relational operand rules (checkEqOperands /
// the relational branch in checkBinop).  Equality is defined on scalars
// and pointers; rejected outright on slices, interface values, and
// function values; defined on a struct / array iff every transitive
// field / element is comparable (rejected if it transitively contains a
// slice / interface / function).  Relational operators require numeric
// operands.

// charsHaveSub reports whether hay contains needle as a contiguous
// subsequence (a tiny substring search — the test package has no
// general one).
func charsHaveSub(hay @[]char, needle *[]readonly char) bool {
	var nn int = len(needle)
	if nn == 0 {
		return true
	}
	var nh int = len(hay)
	var i int = 0
	for i + nn <= nh {
		var j int = 0
		for j < nn && hay[i + j] == needle[j] {
			j = j + 1
		}
		if j == nn {
			return true
		}
		i = i + 1
	}
	return false
}

// compareErrHas asserts the checker's first error message contains
// needle.  Pinning the specific diagnostic (rather than just "some
// error") keeps a stray parse/type error in the test source from
// masquerading as the expected rejection.
func compareErrHas(c @Checker, needle *[]readonly char) testing.TestResult {
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) == 0 {
		return fail("expected a comparison error, got none")
	}
	if !charsHaveSub(errs[0].Msg, needle) {
		return fail(errs[0].Msg)
	}
	return ""
}

// --- accepted: scalars and pointers ---

func TestCompareIntEqAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a int, b int) bool { return a == b }\n")
	return expectNoErrors(c)
}

func TestCompareBoolEqAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a bool, b bool) bool { return a != b }\n")
	return expectNoErrors(c)
}

func TestCompareCharEqAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a char, b char) bool { return a == b }\n")
	return expectNoErrors(c)
}

func TestCompareRawPtrEqAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a *int, b *int) bool { return a == b }\n")
	return expectNoErrors(c)
}

func TestCompareRawPtrEqNilAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a *int) bool { return a == nil }\n")
	return expectNoErrors(c)
}

func TestCompareManagedPtrEqAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type S struct { x int }\n"
					"func f(a @S, b @S) bool { return a == b }\n")
	return expectNoErrors(c)
}

// --- accepted: relational on numeric ---

func TestCompareRelationalCharAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a char, b char) bool { return a < b }\n")
	return expectNoErrors(c)
}

// --- rejected: slices, interface values, function values ---

func TestCompareRawSliceEqRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a *[]int, b *[]int) bool { return a == b }\n")
	return compareErrHas(c, "slices cannot be compared")
}

func TestCompareManagedSliceEqRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a @[]int, b @[]int) bool { return a == b }\n")
	return compareErrHas(c, "slices cannot be compared")
}

func TestCompareManagedIfaceEqRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface I { m() }\n"
					"func f(a @I, b @I) bool { return a == b }\n")
	return compareErrHas(c, "interface values cannot be compared")
}

func TestCompareRawIfaceEqRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"interface I { m() }\n"
					"func f(a *I, b *I) bool { return a == b }\n")
	return compareErrHas(c, "interface values cannot be compared")
}

func TestCompareRawFuncValEqRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a *func() int, b *func() int) bool { return a == b }\n")
	return compareErrHas(c, "function values cannot be compared")
}

func TestCompareManagedFuncValEqRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a @func() int, b @func() int) bool { return a == b }\n")
	return compareErrHas(c, "function values cannot be compared")
}

// --- accepted: structs and arrays of comparable fields/elements ---

func TestCompareStructEqAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type Pt struct { x int }\n"
					"func f(a Pt, b Pt) bool { return a == b }\n")
	return expectNoErrors(c)
}

func TestCompareArrayEqAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f() bool { var a [3]int; var b [3]int; return a == b }\n")
	return expectNoErrors(c)
}

func TestCompareNestedStructEqAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type Inner struct { p *int; a [2]int }\n"
					"type Outer struct { i Inner; n int }\n"
					"func f(a Outer, b Outer) bool { return a == b }\n")
	return expectNoErrors(c)
}

// --- rejected: aggregates transitively containing a non-comparable field ---

func TestCompareStructWithSliceEqRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type S struct { v @[]int }\n"
					"func f(a S, b S) bool { return a == b }\n")
	return compareErrHas(c, "this struct is not comparable")
}

func TestCompareStructWithNestedSliceEqRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type Inner struct { v *[]int }\n"
					"type Outer struct { i Inner }\n"
					"func f(a Outer, b Outer) bool { return a == b }\n")
	return compareErrHas(c, "this struct is not comparable")
}

func TestCompareArrayOfSliceEqRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f() bool { var a [2]@[]int; var b [2]@[]int; return a == b }\n")
	return compareErrHas(c, "this array is not comparable")
}

// --- != reuses the same rule ---

func TestCompareSliceNeqRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a *[]int, b *[]int) bool { return a != b }\n")
	return compareErrHas(c, "slices cannot be compared")
}

// --- relational rejects pointers and aggregates ---

func TestCompareRelationalRawPtrRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a *int, b *int) bool { return a < b }\n")
	return compareErrHas(c, "require numeric operands")
}

func TestCompareRelationalStructRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type Pt struct { x int }\n"
					"func f(a Pt, b Pt) bool { return a < b }\n")
	return compareErrHas(c, "require numeric operands")
}

func TestCompareRelationalSliceRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a *[]int, b *[]int) bool { return a > b }\n")
	return compareErrHas(c, "require numeric operands")
}

// --- generic bodies: type-param comparisons are deferred, not rejected,
// at definition time (the concrete instantiation is where a bad element
// type would surface) ---

func TestCompareGenericEqDeferred() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func eq[T any](a T, b T) bool { return a == b }\n")
	return expectNoErrors(c)
}

func TestCompareGenericRelationalDeferred() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func lt[T any](a T, b T) bool { return a < b }\n")
	return expectNoErrors(c)
}

// --- named-distinct scalars resolve to their underlying kind, so both
// == and relational are accepted (comparabilityKind / relationalOperandOK
// follow the Underlying chain) ---

func TestCompareNamedScalarEqAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type Celsius int\n"
					"func f(a Celsius, b Celsius) bool { return a == b }\n")
	return expectNoErrors(c)
}

func TestCompareNamedScalarRelationalAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"type Celsius int\n"
					"func f(a Celsius, b Celsius) bool { return a < b }\n")
	return expectNoErrors(c)
}
