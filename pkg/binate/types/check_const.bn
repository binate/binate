package "pkg/binate/types"

import "pkg/binate/ast"

// Constant-declaration checking: forward-registration placeholder typing,
// single- and grouped-const type checking (including iota), and the
// untyped-int literal-value carrier.  The collection/driver passes and
// the var/type decl kinds live in check_decl.bn; function- and
// method-decl checking lives in check_decl_func.bn.

// untypedConstPlaceholder returns the pass-1 forward-registration type
// for an untyped single const (`const X = <lit>`), inferred from the
// initializer's literal kind so a reference checked before the const
// resolves.  A non-literal initializer (`const X = Y`) gets a
// conservative untyped-int placeholder — checkExpr-ing the value during
// collection would emit a spurious `undefined` for a reference-valued
// const.  checkConstDecl attaches the real type + value in pass 2.
func untypedConstPlaceholder(e @ast.Expr) @Type {
	if e == nil { return TypUntypedInt() }
	if e.Kind == ast.EXPR_INT_LIT {
		// Carry the literal value on the placeholder so an expression
		// like `N + 1` (forward ref) folds to N+1, not 1: without
		// HasLitVal, foldIntArith falls to commonType, which inherits the
		// LitVal of the OTHER operand (the literal) — the same trap the
		// bare iota-group member placeholder sidesteps via
		// makeUntypedIntWithLit.
		return makeUntypedIntWithLit(parseIntLiteral(e.Name))
	}
	if e.Kind == ast.EXPR_FLOAT_LIT { return TypUntypedFloat() }
	if e.Kind == ast.EXPR_BOOL_LIT { return TypUntypedBool() }
	if e.Kind == ast.EXPR_CHAR_LIT { return TypChar() }
	return TypUntypedInt()
}

// checkConstDecl type-checks a constant declaration, handling iota in grouped const blocks.
func checkConstDecl(c @Checker, d @ast.Decl) {
	if d.Value == nil {
		// Bare name in grouped const — iota continues.  Attach the
		// current iota value as HasLitVal on the symbol's Type so
		// downstream binop folds (foldIntArith / foldIntBitwise)
		// can compute the right result when the const is referenced
		// as an operand.  Without this the symbol carries only
		// TYP_UNTYPED_INT (no LitVal); commonType then mistakenly
		// inherits the LitVal from the OTHER operand, giving
		// `keyword_start + 1` a folded value of `1` instead of
		// `iota_of_keyword_start + 1`.  See claude-todo.md.
		if c.Iota >= 0 {
			if d.TypeRef != nil {
				var typ @Type = resolveTypeExpr(c, d.TypeRef)
				capturePendingIfSized(c, typ)
				if typ != nil && typ.IsInteger() {
					defineConstVal(c.Scope, d.Name, typ, c.Iota)
				} else {
					defineConst(c.Scope, d.Name, typ)
				}
			} else {
				defineConstVal(c.Scope, d.Name,
					makeUntypedIntWithLit(c.Iota), c.Iota)
			}
			return
		}
		// Not an iota-group member: a const must carry a value (there
		// is no value-less / extern const — group inheritance counts).
		errConstMissingValue(c, d.Pos, d.Name)
		return
	}
	var valType @Type = checkExpr(c, d.Value)
	if d.TypeRef != nil {
		var declType @Type = resolveTypeExpr(c, d.TypeRef)
		capturePendingIfSized(c, declType)
		if !valType.AssignableTo(declType) {
			errCannotAssign(c, d.Value.Pos, valType, declType)
		}
		// const is scalar-only: a non-scalar immutable value is a
		// `var X readonly T = ...`, not a const.  Still define it
		// (with declType) so downstream references don't cascade.
		if !declType.IsScalar() {
			errNonScalarConst(c, d.Value.Pos, d.Name, declType)
		}
		var iv int
		var hasIv bool
		iv, hasIv = litIntValue(valType)
		if declType != nil && declType.IsInteger() && hasIv {
			defineConstVal(c.Scope, d.Name, declType, iv)
		} else {
			defineConst(c.Scope, d.Name, declType)
		}
	} else {
		if !valType.IsScalar() {
			errNonScalarConst(c, d.Value.Pos, d.Name, valType)
		}
		var uv int
		var hasUv bool
		uv, hasUv = litIntValue(valType)
		if valType != nil && valType.IsInteger() && hasUv {
			defineConstVal(c.Scope, d.Name, valType, uv)
		} else {
			defineConst(c.Scope, d.Name, valType)
		}
	}
}

// makeUntypedIntWithLit returns a fresh TYP_UNTYPED_INT Type
// carrying `v` as HasLitVal / LitMag / LitSign, so fold paths
// (foldIntArith / foldIntBitwise) can compute correct results when
// this const is referenced as a binop operand.
func makeUntypedIntWithLit(v int) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_UNTYPED_INT
	t.Name = TypUntypedInt().Name
	t.HasLitVal = true
	if v < 0 {
		t.LitSign = true
		t.LitMag = cast(uint64, 0) - cast(uint64, v)
	} else {
		t.LitSign = false
		t.LitMag = cast(uint64, v)
	}
	return t
}

// checkGroupDecl type-checks a grouped declaration block, managing iota for const groups.
func checkGroupDecl(c @Checker, d @ast.Decl) {
	// Check if this is a const group
	var hasConst bool = false
	for i := 0; i < len(d.Decls); i++ {
		if d.Decls[i].Kind == ast.DECL_CONST {
			hasConst = true
			break
		}
	}
	if hasConst {
		var savedIota int = c.Iota
		c.Iota = 0
		for i := 0; i < len(d.Decls); i++ {
			var inner @ast.Decl = d.Decls[i]
			if inner.Kind == ast.DECL_CONST {
				checkConstDecl(c, inner)
				c.Iota = c.Iota + 1
			} else {
				var singleDecl @[]@ast.Decl = make_slice(@ast.Decl, 1)
				singleDecl[0] = inner
				checkDecls(c, singleDecl)
			}
		}
		c.Iota = savedIota
	} else {
		checkDecls(c, d.Decls)
	}
}
