package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Constant-declaration checking: forward-registration placeholder typing,
// single- and grouped-const type checking (including iota), and the
// untyped-int literal-value carrier.  The collection/driver passes and
// the var/type decl kinds live in check_decl.bn; function- and
// method-decl checking lives in check_decl_func.bn.

// untypedConstPlaceholder returns the pass-1 forward-registration type
// for an untyped single const (`const X = <lit>`), inferred from the
// initializer's literal kind so a reference checked before the const
// resolves.  A non-literal initializer (`const X = Y`) gets a
// conservative untyped-int placeholder — checkExpr-ing the value during
// collection would emit a spurious `undefined` for a reference-valued
// const.  checkConstDecl attaches the real type + value in pass 2.
func untypedConstPlaceholder(e @ast.Expr) @Type {
	if e == nil { return TypUntypedInt() }
	if e.Kind == ast.EXPR_INT_LIT {
		// Carry the literal value on the placeholder so an expression
		// like `N + 1` (forward ref) folds to N+1, not 1: without
		// HasLitVal, foldIntArith falls to commonType, which inherits the
		// LitVal of the OTHER operand (the literal) — the same trap the
		// bare iota-group member placeholder sidesteps via
		// makeUntypedIntWithLit.
		return makeUntypedIntWithLit(parseIntLiteral(e.Name))
	}
	if e.Kind == ast.EXPR_FLOAT_LIT { return TypUntypedFloat() }
	if e.Kind == ast.EXPR_BOOL_LIT { return TypUntypedBool() }
	if e.Kind == ast.EXPR_CHAR_LIT { return TypChar() }
	return TypUntypedInt()
}

// checkConstDecl type-checks a constant declaration, handling iota in grouped const blocks.
func checkConstDecl(c @Checker, d @ast.Decl) {
	if d.Value == nil {
		// Bare name in grouped const — iota continues.  Attach the
		// current iota value as HasLitVal on the symbol's Type so
		// downstream binop folds (foldIntArith / foldIntBitwise)
		// can compute the right result when the const is referenced
		// as an operand.  Without this the symbol carries only
		// TYP_UNTYPED_INT (no LitVal); commonType then mistakenly
		// inherits the LitVal from the OTHER operand, giving
		// `keyword_start + 1` a folded value of `1` instead of
		// `iota_of_keyword_start + 1`.  See claude-todo.md.
		if c.Iota >= 0 {
			if d.TypeRef != nil {
				var typ @Type = resolveTypeExpr(c, d.TypeRef)
				capturePendingIfSized(c, typ)
				if typ != nil && typ.IsInteger() {
					defineConstVal(c.Scope, d.Name, typ, c.Iota)
				} else {
					defineConst(c.Scope, d.Name, typ)
				}
			} else {
				defineConstVal(c.Scope, d.Name,
					makeUntypedIntWithLit(c.Iota), c.Iota)
			}
			return
		}
		// Not an iota-group member: a const must carry a value (there
		// is no value-less / extern const — group inheritance counts).
		errConstMissingValue(c, d.Pos, d.Name)
		return
	}
	var valType @Type = checkExpr(c, d.Value)
	if d.TypeRef != nil {
		var declType @Type = resolveTypeExpr(c, d.TypeRef)
		capturePendingIfSized(c, declType)
		if !valType.AssignableTo(c, declType) {
			errCannotAssign(c, d.Value.Pos, valType, declType)
		}
		// const is scalar-only: a non-scalar immutable value is a
		// `var X readonly T = ...`, not a const.  Still define it
		// (with declType) so downstream references don't cascade.
		if !declType.IsScalar() {
			errNonScalarConst(c, d.Value.Pos, d.Name, declType)
		}
		var iv int
		var hasIv bool
		iv, hasIv = constIntFor(c, valType, d.Value)
		if declType != nil && declType.IsInteger() && hasIv {
			defineConstVal(c.Scope, d.Name, declType, iv)
			if !c.InGroupBareMember {
				attachConstLitVal(c, d.Value, declType, iv)
			}
		} else {
			defineConst(c.Scope, d.Name, declType)
			stampConstBoolIfBool(c, d.Value, declType)
		}
	} else {
		if !valType.IsScalar() {
			errNonScalarConst(c, d.Value.Pos, d.Name, valType)
		}
		var uv int
		var hasUv bool
		uv, hasUv = constIntFor(c, valType, d.Value)
		if valType != nil && valType.IsInteger() && hasUv {
			defineConstVal(c.Scope, d.Name, valType, uv)
			if !c.InGroupBareMember {
				attachConstLitVal(c, d.Value, valType, uv)
			}
		} else {
			defineConst(c.Scope, d.Name, valType)
			stampConstBoolIfBool(c, d.Value, valType)
		}
	}
}

// attachConstLitVal records const value v (interpreted with typ's signedness)
// as a HasLitVal carrier on e's registered ExprType, so IR-gen's genConst reads
// the SAME value the checker folded — scope-free, via Checker.ExprType.  This is
// the lockstep channel for /, %, >> over an unsigned operand >= 2^63: the
// checker folds them correctly (foldConstNum, here, with the package scope
// live), but IR-gen's host-int evalConstExpr would fold them SIGNED.  Each expr
// has a unique ExprType id (registerExprType never dedups), so overwriting the
// entry only affects this initializer.
func attachConstLitVal(c @Checker, e @ast.Expr, typ @Type, v int) {
	if e == nil || e.ResolvedTypeID <= 0 || e.ResolvedTypeID >= c.NumExprTypes {
		return
	}
	var t @Type = make(Type)
	t.Kind = TYP_UNTYPED_INT
	t.Name = TypUntypedInt().Name
	t.HasLitVal = true
	t.IsConstStamp = true
	var p @Type = peelNamedBounded(typ)
	if p != nil && p.Kind == TYP_INT && !p.Signed {
		// Unsigned: v's bit pattern is the magnitude (a value >= 2^63 reads
		// back as a negative host int, but it is non-negative).
		t.LitMag = cast(uint64, v)
		t.LitSign = false
	} else if v < 0 {
		t.LitSign = true
		t.LitMag = cast(uint64, 0) - cast(uint64, v)
	} else {
		t.LitSign = false
		t.LitMag = cast(uint64, v)
	}
	c.ExprTypes[e.ResolvedTypeID] = t
}

// attachConstBoolVal records the folded boolean value v as a HasBoolVal carrier
// on e's registered ExprType — the bool analogue of attachConstLitVal — so
// IR-gen's genConst reads the signedness-aware value the checker folded
// (foldConstBoolValue) instead of re-folding via the host-int evalConstBool,
// which compares unsigned operands >= 2^63 SIGNED (h-cmp).
func attachConstBoolVal(c @Checker, e @ast.Expr, v bool) {
	if e == nil || e.ResolvedTypeID <= 0 || e.ResolvedTypeID >= c.NumExprTypes {
		return
	}
	var t @Type = make(Type)
	t.Kind = TYP_BOOL
	t.Name = TypBool().Name
	t.HasBoolVal = true
	t.BoolVal = v
	t.IsConstStamp = true
	c.ExprTypes[e.ResolvedTypeID] = t
}

// stampConstBoolIfBool folds and stamps a const's boolean value when its type is
// boolean, so IR-gen reads the checker's signedness-aware value rather than
// re-folding the initializer.  A no-op for a non-bool const, and SKIPPED for a
// BARE-repeat group member (its shared node carries the explicit member's stamp;
// genConstGroup folds bare members via the host int).
func stampConstBoolIfBool(c @Checker, e @ast.Expr, typ @Type) {
	if c.InGroupBareMember {
		return
	}
	var p @Type = peelNamedBounded(typ)
	if p == nil || p.Kind != TYP_BOOL {
		return
	}
	var v bool
	var ok bool
	v, ok = foldConstBoolValue(c, e)
	if ok {
		attachConstBoolVal(c, e, v)
	}
}

// constIntFor returns the integer value to record for a const whose checked
// value type is `valType` and whose initializer AST is `valueExpr`.  It
// prefers the value the language folder carries on the type (litIntValue —
// untyped-literal arithmetic, the bignum-correct LitMag/LitSign), then the
// signedness-aware bignum fold of the initializer (foldConstIntValue, so /, %,
// >> over an unsigned operand >= 2^63 fold UNSIGNED — the host-int
// evalConstIntValue would fold them signed and record the wrong value), then
// the host-int fold (evalConstIntValue) — the fallback that gives a cast-wrapped
// const (`const N int8 = cast(int8, 0) - cast(int8, 3)`) its real value (-3)
// instead of being defined value-less.  Recording the value matters for the
// negative-shift-count gate (`x << N`) and array dimensions (`[N]int`), and
// matches IR-gen's genConst — so the checker's view of a const stays consistent
// with the value codegen emits.  ok=false when no path yields a constant integer.
func constIntFor(c @Checker, valType @Type, valueExpr @ast.Expr) (int, bool) {
	var v int
	var ok bool
	v, ok = litIntValue(valType)
	if ok {
		return v, true
	}
	// Prefer the signedness-aware bignum fold: it folds /, %, >> correctly for
	// unsigned operands >= 2^63, where evalConstIntValue's host-int fold would
	// fold them SIGNED and record the wrong value (silently miscompiling, since
	// IR-gen must agree — see foldConstIntValue / genConst).  SKIPPED for a
	// BARE-repeat group member: it re-uses a shared node, so genConstGroup folds
	// it via the host int rather than the stamp; the recorded value stays
	// host-int to match (an EXPLICIT grouped member IS stamped — claude-todo h-group).
	if !c.InGroupBareMember {
		v, ok = foldConstIntValue(c, valueExpr)
		if ok {
			return v, true
		}
	}
	return evalConstIntValue(c, valueExpr)
}

// makeUntypedIntWithLit returns a fresh TYP_UNTYPED_INT Type
// carrying `v` as HasLitVal / LitMag / LitSign, so fold paths
// (foldIntArith / foldIntBitwise) can compute correct results when
// this const is referenced as a binop operand.
func makeUntypedIntWithLit(v int) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_UNTYPED_INT
	t.Name = TypUntypedInt().Name
	t.HasLitVal = true
	if v < 0 {
		t.LitSign = true
		t.LitMag = cast(uint64, 0) - cast(uint64, v)
	} else {
		t.LitSign = false
		t.LitMag = cast(uint64, v)
	}
	return t
}

// checkGroupDecl type-checks a grouped declaration block, managing iota for const groups.
func checkGroupDecl(c @Checker, d @ast.Decl) {
	// Check if this is a const group
	var hasConst bool = false
	for i := 0; i < len(d.Decls); i++ {
		if d.Decls[i].Kind == ast.DECL_CONST {
			hasConst = true
			break
		}
	}
	if hasConst {
		var savedIota int = c.Iota
		c.Iota = 0
		// Track the last explicit member's initializer so a following bare
		// member repeats it (re-evaluated at THIS iota), matching IR-gen's
		// genConstGroup — otherwise a bare member after `1 << iota` gets
		// the plain iota index as its compile-time value instead of the
		// folded repeat (`1<<1`, `1<<2`, …), desyncing from the runtime
		// value.  A first bare member (no prevExpr) keeps the lenient
		// plain-iota fallback in checkConstDecl.
		var prevExpr @ast.Expr = nil
		var prevTypeRef @ast.TypeExpr = nil
		for i := 0; i < len(d.Decls); i++ {
			var inner @ast.Decl = d.Decls[i]
			if inner.Kind == ast.DECL_CONST {
				// Effective type: the member's own type if it has one,
				// else the closest preceding member's (inherited across
				// bare members) — mirroring IR-gen's genConstGroup
				// prevTyp.  A bare member is then range-checked at its
				// INHERITED width, so `const ( B0 uint8 = 1<<iota; …; B8 )`
				// rejects B8 (=256) like the explicit `const B8 uint8 =
				// 256` does, instead of silently truncating to 0 at IR-gen.
				var effTypeRef @ast.TypeExpr = inner.TypeRef
				if effTypeRef == nil { effTypeRef = prevTypeRef }
				prevTypeRef = effTypeRef
				if inner.Value == nil && prevExpr != nil {
					var rep @ast.Decl = make(ast.Decl)
					rep.Kind = ast.DECL_CONST
					rep.Name = inner.Name
					rep.Value = prevExpr
					rep.TypeRef = effTypeRef
					rep.Pos = inner.Pos
					// Bare-repeat member: re-uses prevExpr's shared node, so
					// suppress the signedness-aware fold + stamp (it would
					// restamp the node the explicit member owns).
					var savedBare bool = c.InGroupBareMember
					c.InGroupBareMember = true
					checkConstDecl(c, rep)
					c.InGroupBareMember = savedBare
				} else {
					checkConstDecl(c, inner)
					if inner.Value != nil {
						prevExpr = inner.Value
					}
				}
				c.Iota = c.Iota + 1
			} else {
				var singleDecl @[]@ast.Decl = make_slice(@ast.Decl, 1)
				singleDecl[0] = inner
				checkDecls(c, singleDecl)
			}
		}
		c.Iota = savedIota
	} else {
		checkDecls(c, d.Decls)
	}
}

// ============================================================
// Pass-1 dependency-ordered resolution (M6)
// ============================================================

// registerOneConstPlaceholder forward-registers a single top-level const's
// NAME with a placeholder type (declared type for a typed const; an
// initializer-literal-inferred placeholder for an untyped one) plus its
// folded integer value when one is available.  resolveTopLevelConsts (and,
// on the REPL path, collectDeclsBody) call this so a const value that
// references another const resolves by name; dependency-ordered resolution
// then refines each top-level const to its real type+value.
func registerOneConstPlaceholder(c @Checker, d @ast.Decl) {
	// File-scoped imports: a const's type/value may reference an import, so
	// resolve under the const's own file scope (see checkPackageImpl).
	if fileScopedActive(c) {
		c.Scope = scopeForFile(c, d.Pos.File)
	}
	var ctyp @Type = nil
	if d.TypeRef != nil {
		ctyp = resolveTypeExpr(c, d.TypeRef)
		capturePendingIfSized(c, ctyp)
	} else {
		ctyp = untypedConstPlaceholder(d.Value)
	}
	var iv int
	var ok bool
	iv, ok = evalConstIntValue(c, d.Value)
	if ctyp != nil && ctyp.IsInteger() && ok {
		defineConstVal(c.Scope, d.Name, ctyp, iv)
	} else {
		defineConst(c.Scope, d.Name, ctyp)
	}
}

// registerGroupConstPlaceholder forward-registers a grouped const member's
// NAME.  A bare iota-continuation member (no explicit type) is always
// iota-valued (untyped int), so an untyped-int placeholder agrees with the
// real value checkGroupDecl attaches in pass 2.
func registerGroupConstPlaceholder(c @Checker, inner @ast.Decl) {
	if fileScopedActive(c) {
		c.Scope = scopeForFile(c, inner.Pos.File)
	}
	if inner.TypeRef != nil {
		var typ @Type = resolveTypeExpr(c, inner.TypeRef)
		capturePendingIfSized(c, typ)
		defineConst(c.Scope, inner.Name, typ)
	} else {
		defineConst(c.Scope, inner.Name, TypUntypedInt())
	}
}

// registerConstPlaceholders forward-registers every const name (top-level
// and grouped, recursing nested groups) with a placeholder, so any const
// initializer referencing another const resolves by name during the
// dependency walk that follows.
func registerConstPlaceholders(c @Checker, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_CONST && d.Value != nil {
			registerOneConstPlaceholder(c, d)
		}
		if d.Kind == ast.DECL_GROUP {
			for j := 0; j < len(d.Decls); j++ {
				if d.Decls[j].Kind == ast.DECL_CONST {
					registerGroupConstPlaceholder(c, d.Decls[j])
				}
			}
			registerConstPlaceholders(c, d.Decls)
		}
	}
}

// resolveTopLevelConsts resolves every top-level const's real type and
// value in DEPENDENCY order during pass 1, so a forward reference sees the
// const's real type — not a value-less untyped-int placeholder that
// AssignableTo would silently accept against any integer target (the M6
// false-accept).  Resolving before the rest of collection also makes a
// const's folded value available when a struct field's array dimension
// resolves, regardless of source order (the M3-residual struct-before-const
// case).  Batch path only; the REPL keeps its park/retry resolution.
func resolveTopLevelConsts(c @Checker, decls *[]@ast.Decl) {
	var emptyResolving @[]@[]char
	c.ConstResolving = emptyResolving
	var emptyResolved @[]@[]char
	c.ConstResolved = emptyResolved
	registerConstPlaceholders(c, decls)
	var names @[]@[]char
	var cdecls @[]@ast.Decl
	for i := 0; i < len(decls); i++ {
		if decls[i].Kind == ast.DECL_CONST && decls[i].Value != nil {
			names = slices.Append[@[]char](names, decls[i].Name)
			cdecls = slices.Append[@ast.Decl](cdecls, decls[i])
		}
	}
	for i := 0; i < len(names); i++ {
		resolveConstByName(c, names[i], names, cdecls)
	}
}

// resolveConstByName resolves the top-level const `name` to its real type
// and value: it first resolves every other local top-level const its
// initializer references (so they carry real types when checkConstDecl
// folds this one), then runs checkConstDecl.  c.ConstResolving guards
// against `const A = B; const B = A` cycles; c.ConstResolved memoizes
// completed names.
func resolveConstByName(c @Checker, name @[]char, names @[]@[]char,
		cdecls @[]@ast.Decl) {
	if nameInList(c.ConstResolved, name) { return }
	if nameInList(c.ConstResolving, name) {
		var cd @ast.Decl = findConstDecl(names, cdecls, name)
		if cd != nil {
			errConstCycle(c, cd.Pos, name)
		}
		c.ConstResolved = slices.Append[@[]char](c.ConstResolved, name)
		return
	}
	var d @ast.Decl = findConstDecl(names, cdecls, name)
	if d == nil { return }
	c.ConstResolving = slices.Append[@[]char](c.ConstResolving, name)
	var deps @[]@[]char
	deps = collectConstDeps(d.Value, deps)
	for i := 0; i < len(deps); i++ {
		if nameInList(names, deps[i]) {
			resolveConstByName(c, deps[i], names, cdecls)
		}
	}
	// Resolve THIS const's value under its own file scope (the recursion above
	// left c.Scope at a dependency's file scope); see checkPackageImpl.
	if fileScopedActive(c) {
		c.Scope = scopeForFile(c, d.Pos.File)
	}
	checkConstDecl(c, d)
	c.ConstResolving = c.ConstResolving[:len(c.ConstResolving) - 1]
	c.ConstResolved = slices.Append[@[]char](c.ConstResolved, name)
}

// collectConstDeps appends the identifier names referenced by const-expr
// `e` to `deps` (recursing through unary / binary operators and builtin /
// call arguments).  Package-qualified selectors and type arguments are not
// local consts, so any name collected that isn't a local top-level const is
// simply ignored by the caller.
func collectConstDeps(e @ast.Expr, deps @[]@[]char) @[]@[]char {
	if e == nil { return deps }
	if e.Kind == ast.EXPR_IDENT {
		return slices.Append[@[]char](deps, e.Name)
	}
	if e.Kind == ast.EXPR_UNARY {
		return collectConstDeps(e.X, deps)
	}
	if e.Kind == ast.EXPR_BINARY {
		deps = collectConstDeps(e.X, deps)
		return collectConstDeps(e.Y, deps)
	}
	if e.Kind == ast.EXPR_BUILTIN || e.Kind == ast.EXPR_CALL {
		for i := 0; i < len(e.Args); i++ {
			deps = collectConstDeps(e.Args[i], deps)
		}
		return deps
	}
	return deps
}

// nameInList reports whether `name` is present in `list`.
func nameInList(list @[]@[]char, name @[]char) bool {
	for i := 0; i < len(list); i++ {
		if charEq(list[i], name) { return true }
	}
	return false
}

// findConstDecl returns the decl registered for top-level const `name`, or
// nil if `name` is not a local top-level const (a builtin, an imported
// const, a grouped member, or a non-const).
func findConstDecl(names @[]@[]char, cdecls @[]@ast.Decl,
		name @[]char) @ast.Decl {
	for i := 0; i < len(names); i++ {
		if charEq(names[i], name) { return cdecls[i] }
	}
	return nil
}

// errConstCycle reports a constant-definition cycle (`const A = B;
// const B = A`).  Resolving such a const would otherwise recurse forever;
// the cycle is broken at detection and reported here.
func errConstCycle(c @Checker, pos token.Pos, name @[]char) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("constant definition cycle involving `")
	cb.Write(name)
	cb.Write("`")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errCyclicType reports a cyclic named-type definition (`type A B; type B A`,
// or self `type A A`), mirroring errConstCycle.  A cyclic named type has no
// well-defined underlying; the cycle is broken at the detection site so the
// operand-comparability walks (comparabilityKind / IsInteger …) terminate.
func errCyclicType(c @Checker, pos token.Pos, name @[]char) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("cyclic type definition involving `")
	cb.Write(name)
	cb.Write("`")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}
