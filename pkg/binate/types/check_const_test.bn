package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for constant-declaration checking in check_const.bn:
// single and grouped consts (iota), scalar-only enforcement,
// forward references, and const-as-array-dimension resolution.

func TestCheckConstDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst x int = 42\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckConstGroup() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst (\n\tA int = iota\n\tB\n\tC\n)\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// const is scalar-only: bool and float consts are accepted (int is
// covered by TestCheckConstDecl).  Guards that the scalar-only rule
// doesn't reject the legitimate non-int scalar families.
func TestCheckConstBoolFloatOK() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst B bool = true\nconst F float64 = 1.5\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A string-typed const is rejected — const requires a scalar type; a
// string immutable value is a `var X readonly *[]readonly char = ...`.
func TestCheckRejectConstString() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst X *[]readonly char = \"hi\"\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A struct-typed const is rejected for the same reason (non-scalar).
func TestCheckRejectConstStruct() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Pt struct { x int }\n"
		"const P Pt = Pt{x: 1}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// A value-less standalone const is rejected — every const carries a
// value (only iota-group members may omit it).
func TestCheckRejectConstNoValue() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst X int\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A FORWARD reference to a bare iota-continuation const-group member
// (one with no explicit type, e.g. B / C below) must resolve.
// collectDecls forward-registers every const-group member so a use in
// a decl checked BEFORE the group resolves — the same path that makes
// a const group usable across files of one package (files are merged,
// and the using file may be ordered before the defining group).
// Regression: bare members (no TypeRef) were skipped during
// collection, so this failed with `undefined: B`.
func TestForwardRefBareIotaConstMember() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"func use() int { return B }\n"
		"const (\n"
		"\tA int = iota\n"
		"\tB\n"
		"\tC\n"
		")\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A forward reference to an UNTYPED single const (`const X = 5`, no
// explicit type) resolves: collectDecls forward-registers it with a
// placeholder type inferred from the initializer literal, mirroring the
// bare iota group-member arm (TestForwardRefBareIotaConstMember).  The
// value is NOT checkExpr'd during collection, so a reference-valued const
// (`const X = Y; const Y = 5`) doesn't emit a spurious `undefined`.
func TestForwardRefUntypedSingleConst() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"func use() int { return X }\n"
		"const X = 5\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A reference-valued untyped const (`const X = Y` with Y declared after)
// must not emit a spurious `undefined` during pass-1 collection: X is
// forward-registered with a conservative placeholder WITHOUT checkExpr-
// ing its value, and pass 2 resolves Y normally.  This is the hazard the
// literal-only placeholder mapping guards against.
func TestForwardRefUntypedConstReferencingConst() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"const X = Y\n"
		"const Y = 5\n"
		"func use() int { return X }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A const used as an array dimension in a STRUCT FIELD resolves to the
// right length.  Struct types resolve once in pass 1; the const's folded
// value must therefore be recorded in pass 1 too (collectDecls does this
// via defineConstVal), or the field's array type would resolve to a
// zero-length array and a valid use of it would be spuriously rejected.
func TestConstArrayDimInStructField() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"const N int = 3\n"
		"type S struct { arr [N]int }\n"
		"func g(a [3]int) int { return a[0] }\n"
		"func use(s S) int { return g(s.arr) }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A forward reference to a NON-literal untyped const resolves via the
// const's real type, not a permissive placeholder.  Top-level consts are
// resolved in dependency order in pass 1 (resolveTopLevelConsts), so here
// `var x int = A` (A = B = 1.5, both declared after x) sees A's real type
// — float — and the float-to-int assignment is correctly rejected.
func TestForwardRefNonLiteralUntypedFloatConstRejected() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"var x int = A\n"
		"const A = B\n"
		"const B = 1.5\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A const used as a struct field's array dimension resolves regardless of
// source order: dependency-ordered const resolution runs before struct
// types are collected, so `type S struct { arr [N]int }` declared BEFORE
// `const N int = 3` still gets a [3]int field (not [0]int) and a valid use
// is accepted.
func TestStructBeforeConstDim() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"type S struct { arr [N]int }\n"
		"const N int = 3\n"
		"func g(a [3]int) int { return a[0] }\n"
		"func use(s S) int { return g(s.arr) }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A forward reference to a non-literal INT const must be accepted — its
// real (untyped-int) type, folded in dependency order, is assignable to an
// int target.  This is the legal case the coarse "don't forward-register"
// fix would have wrongly rejected.
func TestForwardRefNonLiteralIntConstAccepted() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"var x int = A\n"
		"const A = 1 + 2\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A multi-link forward chain of non-literal consts ending in a float is
// rejected when assigned to an int (the float type propagates through the
// chain during dependency-ordered resolution).
func TestForwardRefNonLiteralFloatChainRejected() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"var x int = A\n"
		"const A = B\n"
		"const B = C\n"
		"const C = 2.5\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A constant definition cycle (`const A = B; const B = A`) is reported as
// an error rather than recursing forever during resolution.
func TestConstDefinitionCycleRejected() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"const A = B\n"
		"const B = A\n"
		"func use() int { return A }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A self-referential const (`const A = A`) is a degenerate cycle and is
// likewise rejected.
func TestConstSelfCycleRejected() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"const A = A + 1\n"
		"func use() int { return A }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A forward reference to a non-literal INT const whose folded value does
// not fit a narrower target is rejected: dependency-ordered resolution
// gives the const its real value, so the fit-check applies just as it does
// for a literal const.
func TestForwardRefNonLiteralIntConstOutOfRangeRejected() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"var x uint8 = A\n"
		"const A = 200 + 100\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}
