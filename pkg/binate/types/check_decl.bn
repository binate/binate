package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/stdx/slices"

// Top-level declaration checking — driver pipeline (collect + check
// passes) plus the simple decl kinds (var, const, type, group).
// Function- and method-decl-specific machinery — `.bni` signature
// matching, method-receiver collection, function-body checking, and
// control-flow termination analysis — lives in check_decl_func.bn.

// ============================================================
// Declaration Collection (Pass 1)
// ============================================================

// checkDuplicateDecls reports errors for names declared more than once
// in the same declaration list. This catches user errors like defining
// two functions with the same name, but does NOT flag .bni→.bn matches
// (those are in the scope from LoadPackageInterface, not in decls).
//
// Methods (DECL_FUNC with Recv != nil) are skipped here — they live in
// per-type method sets and method-name duplicates are detected by
// AddMethod when the method is registered.
func checkDuplicateDecls(c @Checker, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var name @[]char = decls[i].Name
		if len(name) == 0 { continue }
		// Skip type decls (handled by preRegisterTypeNames)
		if decls[i].Kind == ast.DECL_TYPE { continue }
		// Skip groups (checked recursively)
		if decls[i].Kind == ast.DECL_GROUP { continue }
		// Skip methods (per-type method-set duplicate check is in AddMethod)
		if decls[i].Kind == ast.DECL_FUNC && decls[i].Recv != nil { continue }
		for j := 0; j < i; j++ {
			if len(decls[j].Name) > 0 && charEq(decls[j].Name, name) {
				if decls[j].Kind == ast.DECL_TYPE { continue }
				if decls[j].Kind == ast.DECL_GROUP { continue }
				if decls[j].Kind == ast.DECL_FUNC && decls[j].Recv != nil { continue }
				var cb buf.CharBuf = buf.New()
				cb = cb.WriteStr(name)
				cb = cb.WriteStr(" redeclared in this block")
				addCheckError(c, decls[i].Pos, cb.Bytes())
				break
			}
		}
	}
}

// collectDecls runs pass 1: registers type names, resolves top-level
// consts in dependency order, then collects func/var/const symbols.
//
// preRegisterTypeNames runs once here (it already recurses into groups, and
// re-running it would double-append generic type decls).  Top-level consts
// are then resolved in dependency order (batch path) so a forward reference
// sees a const's real type and a struct field array dimension sees its
// folded value regardless of source order — see resolveTopLevelConsts.  The
// REPL path (TentativeMode) skips that sweep and keeps its park/retry
// resolution; collectDeclsBody registers const placeholders for it instead.
func collectDecls(c @Checker, decls *[]@ast.Decl) {
	preRegisterTypeNames(c, decls)
	if !c.ReplDeclMode {
		// A top-level const's declared type may be a named distinct
		// scalar (`const C Rate = 0.5` over `type Rate float64`).
		// resolveTopLevelConsts (next) needs that type's underlying to
		// validate the const is scalar and the value assignable, but
		// collectDeclsBody — which sets underlyings — runs after.  Fill
		// in the underlyings that can't depend on a const (named types
		// over a builtin scalar) here first.
		resolveBuiltinScalarTypeDecls(c, decls)
		resolveTopLevelConsts(c, decls)
	}
	collectDeclsBody(c, decls)
}

// isConcreteScalar reports whether t is a builtin scalar Type object
// (a real, stable int / float / bool — not a named wrapper, alias, or
// placeholder).  Used by resolveBuiltinScalarTypeDecls to restrict its
// eager underlying-fill to targets that are already fully resolved and
// will never be replaced by a later collection pass.
func isConcreteScalar(t @Type) bool {
	if t == nil {
		return false
	}
	return t.Kind == TYP_INT || t.Kind == TYP_FLOAT || t.Kind == TYP_BOOL
}

// resolveBuiltinScalarTypeDecls fills the underlying of each distinct
// named type whose body is a bare builtin scalar name (`type Celsius
// int`, `type Rate float64`), BEFORE top-level consts are resolved, so
// a const of such a type sees its underlying.  Restricted to builtin
// scalar targets: those resolve to a stable concrete type (never a
// not-yet-collected placeholder that a later pass would replace, which
// would leave a stale reference), and they never embed a const-dependent
// array dimension.  Mutates the placeholder created by preRegisterType-
// Names in place, so collectDeclsBody's later collectTypeDecl sees the
// underlying already set and treats it as a benign re-declaration.
// Aliases, structs, arrays, generics, forward decls, and named-over-
// named/-alias/-qualified types are left for collectDeclsBody.
func resolveBuiltinScalarTypeDecls(c @Checker, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_TYPE && len(d.TypeParams) == 0 &&
				!d.IsForward && !d.IsAlias && d.TypeRef != nil &&
				d.TypeRef.Kind == ast.TEXPR_NAMED &&
				len(d.TypeRef.Pkg) == 0 {
			var sym @Symbol = c.Scope.Lookup(d.Name)
			if sym != nil && sym.Type != nil &&
					sym.Type.Kind == TYP_NAMED &&
					sym.Type.Underlying == nil {
				var u @Symbol = c.Scope.Lookup(d.TypeRef.Name)
				if u != nil && u.Kind == SYM_TYPE &&
						isConcreteScalar(u.Type) {
					sym.Type.Underlying = u.Type
				}
			}
		}
		if d.Kind == ast.DECL_GROUP {
			resolveBuiltinScalarTypeDecls(c, d.Decls)
		}
	}
}

// collectDeclsBody is the per-level collection loop (also the target of the
// grouped-decl recursion).  Const names are forward-registered here only on
// the REPL path; on the batch path resolveTopLevelConsts (run once in
// collectDecls) already recorded their real types.
func collectDeclsBody(c @Checker, decls *[]@ast.Decl) {
	// Check for duplicate declarations within this file
	checkDuplicateDecls(c, decls)

	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_FUNC {
			if d.Recv != nil {
				collectMethodDecl(c, d)
			} else {
				var ft @Type = resolveFuncDeclType(c, d)
				// Check .bni → .bn signature match: if the function was already
				// declared (from .bni), verify the .bn definition matches.
				checkBniSignatureMatch(c, d, ft)
				defineFunc(c.Scope, d.Name, ft)
			}
		}
		if d.Kind == ast.DECL_TYPE {
			collectTypeDecl(c, d)
		}
		if d.Kind == ast.DECL_VAR {
			if d.TypeRef != nil {
				var typ @Type = resolveTypeExpr(c, d.TypeRef)
				capturePendingIfSized(c, typ)
				// If a `.bni` declared this var (extern), verify the `.bn`
				// definition's type agrees — an importer reads the type
				// from the `.bni`, so a mismatch would misread the storage.
				checkBniVarMatch(c, d, typ)
				defineVar(c.Scope, d.Name, typ)
			}
		}
		if d.Kind == ast.DECL_CONST && d.Value != nil {
			if c.ReplDeclMode {
				registerOneConstPlaceholder(c, d)
			}
		}
		if d.Kind == ast.DECL_GROUP {
			if c.ReplDeclMode {
				for j := 0; j < len(d.Decls); j++ {
					if d.Decls[j].Kind == ast.DECL_CONST {
						registerGroupConstPlaceholder(c, d.Decls[j])
					}
				}
			}
			collectDeclsBody(c, d.Decls)
		}
		if d.Kind == ast.DECL_INTERFACE {
			collectInterfaceDecl(c, d)
		}
		if d.Kind == ast.DECL_IMPL {
			collectImplDecl(c, d)
		}
	}
}

// preRegisterTypeNames creates placeholder named types for all type
// declarations (enables forward refs).  Generic struct decls
// (DECL_TYPE with non-empty TypeParams) register a placeholder
// alongside their AST entry in c.GenericTypeDecls so use sites
// can find the source decl when instantiating.  Per plan-
// generics.md Slice 5b.
func preRegisterTypeNames(c @Checker, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_TYPE {
			if c.Scope.Lookup(d.Name) == nil {
				var placeholder @Type = MakeNamedType(d.Name)
				defineType(c.Scope, d.Name, placeholder)
			}
			if len(d.TypeParams) > 0 {
				c.GenericTypeDecls = slices.Append[@ast.Decl](
					c.GenericTypeDecls, d)
				var emptyPkg @[]char
				c.GenericTypeDeclPkgs = slices.Append[@[]char](
					c.GenericTypeDeclPkgs, emptyPkg)
			}
		}
		if d.Kind == ast.DECL_GROUP {
			preRegisterTypeNames(c, d.Decls)
		}
	}
}

// collectTypeDecl resolves a type declaration (alias, struct, or named) and defines it in scope.
// Generic decls are skipped — their struct bodies stay AST-form
// in c.GenericTypeDecls until an instantiation site resolves them
// with the type-param scope installed (Slice 5b).
// namedTypeDefIsCyclic reports whether following `start`'s named-distinct
// Underlying chain loops back to `start` (`type A B; type B A`) or to itself
// (`type A A`).  Such a type has no well-defined underlying; the definition is
// rejected and the cycle broken at the call site, so the operand-comparability
// walks (comparabilityKind / IsInteger / …) can't hang `==` / stack-overflow
// `<` on a parseable-but-malformed input.  The depth bound is a backstop for
// any cycle not passing through `start`.
func namedTypeDefIsCyclic(start @Type) bool {
	if start == nil || start.Underlying == nil {
		return false
	}
	var t @Type = resolveAliasAndConst(start.Underlying)
	var depth int = 0
	for t != nil && t.Kind == TYP_NAMED && t.Underlying != nil {
		if charSliceEq(t.Name, start.Name) {
			return true
		}
		if depth >= 1024 {
			return true
		}
		t = resolveAliasAndConst(t.Underlying)
		depth = depth + 1
	}
	return false
}

// collectTypeDecl registers a top-level type declaration in the current
// scope during pass-1 collection, so later declarations and forward
// references resolve by name.  Generic decls (with type params) are
// skipped here — they're instantiated on demand; a forward decl registers
// a bodyless TYP_NAMED placeholder; an alias registers a TYP_ALIAS; a
// struct / named-distinct decl registers its underlying (or fills a
// previously-registered forward placeholder's).
func collectTypeDecl(c @Checker, d @ast.Decl) {
	if len(d.TypeParams) > 0 {
		return
	}
	if d.IsForward {
		// Forward declaration: register as TYP_NAMED with no
		// Underlying.  The .bn impl's `type S struct { ... }` (if
		// present) fills in the body via the same path used for
		// generic-decl placeholders (the TYP_NAMED-with-nil-
		// Underlying branch below).  Idempotent — a second forward
		// decl of the same name is a no-op.  See plan-type-decls.md
		// Phase 2.
		var sym @Symbol = c.Scope.Lookup(d.Name)
		if sym != nil {
			return
		}
		var named @Type = MakeNamedType(d.Name)
		defineType(c.Scope, d.Name, named)
		return
	}
	if d.IsAlias {
		var target @Type = resolveTypeExpr(c, d.TypeRef)
		capturePendingIfSized(c, target)
		var alias @Type = MakeAliasType(d.Name, target)
		defineType(c.Scope, d.Name, alias)
	} else if d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
		var st @Type = resolveStructType(c, d.TypeRef)
		st.Name = QualifyName(currentPkgPath, d.Name)
		var sym @Symbol = c.Scope.Lookup(d.Name)
		if sym != nil && sym.Type.Kind == TYP_NAMED {
			if sym.Type.Underlying == nil {
				sym.Type.Underlying = st
				return
			}
			// Forward decl already filled in.  Re-emit on the
			// underlying-struct mismatch path below.
			if structFieldsMatch(sym.Type.Underlying, st) {
				return
			}
			addCheckError(c, d.Pos, dupTypeMsg(d.Name))
			return
		}
		if sym != nil && sym.Type.Kind == TYP_STRUCT {
			// Two full struct defs for the same name.  Warn ONLY
			// if the field lists actually disagree — same-shape
			// duplicates fire through several paths (loader merge,
			// LoadPackageInterface + CheckPackage re-processing
			// the same .bni decls) and are benign during the
			// migration window.  See plan-type-decls.md Phase 2.
			if structFieldsMatch(sym.Type, st) {
				return
			}
			addCheckError(c, d.Pos, dupTypeMsg(d.Name))
			return
		}
		defineType(c.Scope, d.Name, st)
	} else {
		var underlying @Type = resolveTypeExpr(c, d.TypeRef)
		capturePendingIfSized(c, underlying)
		var sym @Symbol = c.Scope.Lookup(d.Name)
		if sym != nil && sym.Type.Kind == TYP_NAMED {
			if sym.Type.Underlying == nil {
				sym.Type.Underlying = underlying
				if namedTypeDefIsCyclic(sym.Type) {
					errCyclicType(c, d.Pos, d.Name)
					sym.Type.Underlying = nil
				}
				return
			}
			// Same shape (same underlying TypeName) is a benign
			// re-declaration; warn only on actual mismatch.
			if charSliceEq(sym.Type.Underlying.QualifiedTypeName(),
					underlying.QualifiedTypeName()) {
				return
			}
			addCheckError(c, d.Pos, dupTypeMsg(d.Name))
			return
		}
		var named @Type = MakeNamedType(d.Name)
		named.Underlying = underlying
		if namedTypeDefIsCyclic(named) {
			errCyclicType(c, d.Pos, d.Name)
			named.Underlying = nil
		}
		defineType(c.Scope, d.Name, named)
	}
}

// structFieldsMatch reports whether two struct types have exactly
// the same field list (same names, same types, same order).  Used
// by collectTypeDecl to silently dedup same-shape duplicate
// declarations (which can arise from the loader merging .bni decls
// into the .bn impl, or from LoadPackageInterface re-processing
// the .bni after CheckPackage) so the Phase 2 warning only fires
// on the cases that actually cause silent miscompiles — i.e.
// when the two declarations disagree about the layout.
func structFieldsMatch(a @Type, b @Type) bool {
	if a == nil || b == nil { return a == b }
	if a.Kind != TYP_STRUCT || b.Kind != TYP_STRUCT { return false }
	if len(a.Fields) != len(b.Fields) { return false }
	for i := 0; i < len(a.Fields); i++ {
		var fa @Field = a.Fields[i]
		var fb @Field = b.Fields[i]
		if !charSliceEq(fa.Name, fb.Name) { return false }
		// Compare field types by structural equality.  Pointer
		// identity is too strict (cross-file lookups may produce
		// distinct Type instances for the same underlying form);
		// TypeName comparison catches name + kind for named types
		// and works fine for primitives.  More-thorough structural
		// equality lands in Phase 3 if the simple check turns out
		// to be too permissive in practice.
		if !charSliceEq(fa.Type.QualifiedTypeName(), fb.Type.QualifiedTypeName()) {
			return false
		}
	}
	return true
}

// charSliceEq compares two @[]char by length + byte content.
// Local because the obvious helpers live in other packages and we
// want check_decl.bn self-contained for the Phase 2 change.
func charSliceEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// dupTypeMsg produces the warning text used when a type name is
// defined more than once (the bni + bn duplication pattern that
// triggered the Stage 4 silent miscompile).  Pulled into a helper
// so the four collectTypeDecl branches stay terse and the wording
// stays consistent.
func dupTypeMsg(name @[]char) @[]char {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("duplicate type definition: ")
	cb = cb.WriteStr(name)
	cb = cb.WriteStr(" (see plan-type-decls.md — define in .bni OR .bn, not both; use `type ")
	cb = cb.WriteStr(name)
	cb = cb.WriteStr("` forward-decl in .bni for opaque export)")
	return cb.Bytes()
}

// ============================================================
// Declaration Checking (Pass 2)
// ============================================================

// checkDecls runs pass 2: type-checks function bodies, variable initializers, and const values.
func checkDecls(c @Checker, decls *[]@ast.Decl) {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind == ast.DECL_FUNC {
			checkFuncDecl(c, d)
		}
		if d.Kind == ast.DECL_VAR {
			checkVarDecl(c, d)
		}
		if d.Kind == ast.DECL_CONST {
			// Batch path: top-level consts with a value were already
			// resolved in dependency order during pass 1
			// (resolveTopLevelConsts); re-checking here would double any
			// error.  A value-less const (`const X` with no initializer,
			// not an iota member) is NOT swept, so it must still be checked
			// here to report the missing value.  The REPL path
			// (TentativeMode) resolves all consts here.
			if c.TentativeMode || d.Value == nil {
				checkConstDecl(c, d)
			}
		}
		if d.Kind == ast.DECL_GROUP {
			checkGroupDecl(c, d)
		}
	}
}

// checkVarDecl type-checks a variable declaration, validating initializer assignability.
// Blank-identifier declarations (`var _ T = expr` / `var _ = expr`) check the
// initializer for side effects but do NOT enter any name into scope.
func checkVarDecl(c @Checker, d @ast.Decl) {
	if isBlank(d.Name) {
		if d.TypeRef != nil && d.Value != nil {
			var declType @Type = resolveTypeExpr(c, d.TypeRef)
			capturePendingIfSized(c, declType)
			var valType @Type = checkExpr(c, d.Value)
			if !valType.AssignableTo(declType) {
				errCannotAssign(c, d.Value.Pos, valType, declType)
			}
		} else if d.Value != nil {
			checkExpr(c, d.Value)
		}
		return
	}
	if d.TypeRef != nil && d.Value != nil {
		var declType @Type = resolveTypeExpr(c, d.TypeRef)
		capturePendingIfSized(c, declType)
		// B.3b: when the destination is a function-value type,
		// pass it down as a hint so checkFuncLit can resolve a
		// matching literal as @func / *func per the destination
		// rather than always returning the raw form.
		var valType @Type = checkExprWithFVHint(c, d.Value, declType)
		if !valType.AssignableTo(declType) {
			errCannotAssign(c, d.Value.Pos, valType, declType)
		}
		defineVar(c.Scope, d.Name, declType)
	} else if d.TypeRef != nil {
		var declType @Type = resolveTypeExpr(c, d.TypeRef)
		capturePendingIfSized(c, declType)
		defineVar(c.Scope, d.Name, declType)
	} else if d.Value != nil {
		var valType @Type = checkExpr(c, d.Value)
		valType = defaultTypeForExpr(valType, d.Value)
		defineVar(c.Scope, d.Name, valType)
	}
}

// checkBniVarMatch verifies a `.bn` `var X T` definition agrees with a
// `.bni` `var X T2` extern declaration: the types must be identical, or
// an importer — which reads X's type from the `.bni` — would misread the
// `.bn`-defined storage.  Mirrors checkBniSignatureMatch for funcs; the
// `.bni` symbol was pre-loaded into the package scope (CheckPackage),
// so a SYM_VAR already in scope under this name came from the `.bni`.
func checkBniVarMatch(c @Checker, d @ast.Decl, bnType @Type) {
	if c.AllowRedef { return }
	var existing @Symbol = c.Scope.LookupLocal(d.Name)
	if existing == nil { return }
	if existing.Kind != SYM_VAR { return }
	var bniType @Type = existing.Type
	if bniType == nil || bnType == nil { return }
	if !bniType.Identical(bnType) {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteStr(d.Name)
		cb = cb.WriteStr(": .bn defines var of type ")
		cb = cb.WriteStr(bnType.TypeName())
		cb = cb.WriteStr(" but .bni declares ")
		cb = cb.WriteStr(bniType.TypeName())
		addCheckError(c, d.Pos, cb.Bytes())
	}
}
