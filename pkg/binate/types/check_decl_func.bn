package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// Function- and method-declaration checking, split out of
// check_decl.bn for file-length hygiene.  Three concerns live
// here, all specific to func/method decls:
//
//   1. .bni → .bn signature matching for free functions.
//   2. Method-receiver collection (pass 1): walking the
//      receiver type expression, validating it, registering
//      the method on its base named type.
//   3. Function-body checking (pass 2): scope setup, body
//      check, missing-return analysis (stmtTerminates and
//      friends — control-flow termination is a discrete
//      analysis, used only from here).
//
// The simpler decl kinds (var, const, type, group) and the
// pass-1/pass-2 driver functions stay in check_decl.bn.

// ============================================================
// .bni → .bn Signature Matching
// ============================================================

// checkBniSignatureMatch checks that a .bn function definition matches
// its .bni declaration's signature (parameter and return types).
//
// REPL bypass: when c.AllowRedef is set (CheckDeclInScope sets it),
// the check returns silently — re-typing a func at the prompt
// is a redefinition, not a .bni-vs-.bn mismatch, and the
// "X: .bni declares N" wording would be misleading.
func checkBniSignatureMatch(c @Checker, d @ast.Decl, bnType @Type) {
	if c.AllowRedef { return }
	// The `.bni` symbol lives in the package scope; under file-scoped imports
	// c.Scope is the decl's file scope, so look in the package scope.
	var existing @Symbol = pkgScopeLookupLocal(c, d.Name)
	if existing == nil { return }
	if existing.Kind != SYM_FUNC { return }
	var bniType @Type = existing.Type
	if bniType == nil || bniType.Kind != TYP_FUNC { return }

	// Compare parameter count
	var bniParams int = len(bniType.Params)
	var bnParams int = len(bnType.Params)
	if bniParams != bnParams {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write(d.Name)
		cb.Write(": .bn has ")
		stringutils.WriteInt(cb, bnParams)
		cb.Write(" parameters but .bni declares ")
		stringutils.WriteInt(cb, bniParams)
		addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
		return
	}

	// Compare parameter types
	for i := 0; i < bniParams; i++ {
		if !bniType.Params[i].Type.Identical(bnType.Params[i].Type) {
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write(d.Name)
			cb.Write(": parameter ")
			stringutils.WriteInt(cb, i)
			cb.Write(" type mismatch: .bni has ")
			cb.Write(bniType.Params[i].Type.QualifiedTypeName())
			cb.Write(" but .bn has ")
			cb.Write(bnType.Params[i].Type.QualifiedTypeName())
			addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
		}
	}

	// Compare result count
	var bniResults int = len(bniType.Results)
	var bnResults int = len(bnType.Results)
	if bniResults != bnResults {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write(d.Name)
		cb.Write(": .bn has ")
		stringutils.WriteInt(cb, bnResults)
		cb.Write(" return values but .bni declares ")
		stringutils.WriteInt(cb, bniResults)
		addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
		return
	}

	// Compare result types
	for i := 0; i < bniResults; i++ {
		if !bniType.Results[i].Identical(bnType.Results[i]) {
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write(d.Name)
			cb.Write(": return type ")
			stringutils.WriteInt(cb, i)
			cb.Write(" mismatch: .bni has ")
			cb.Write(bniType.Results[i].QualifiedTypeName())
			cb.Write(" but .bn has ")
			cb.Write(bnType.Results[i].QualifiedTypeName())
			addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
		}
	}
}

// ============================================================
// Method Declaration Collection (Pass 1)
// ============================================================

// collectMethodDecl resolves a method declaration's receiver and
// signature, validates the receiver, and registers the method on its
// base named type. Errors are reported via the Checker; the method is
// silently dropped on validation failure (the body is still type-checked
// in pass 2 via checkFuncDecl, but with no method-set entry).
//
// REPL redefinition: when c.AllowRedef is set (CheckDeclInScope
// sets it), the method is registered via SetOrAppendMethod so a
// re-typed method replaces its predecessor on the receiver type's
// method set instead of tripping AddMethod's duplicate check.  The
// REPL driver decides replace vs shadow at the IR/VM layers based
// on the captured pre-redef method type.
func collectMethodDecl(c @Checker, d @ast.Decl) {
	// Generics v1 has no generic METHODS — only generic free functions
	// and generic types. The parser accepts a `[T any]` list after a
	// receiver, so reject it here at collection time; otherwise the
	// declaration type-checks clean and fails only at a call site, with
	// a confusing "cannot index this type" (`b.Get` is a selector, so
	// `b.Get[int](…)` parses the `[int]` as indexing).
	if len(d.TypeParams) > 0 {
		addCheckError(c, d.Pos, "methods cannot have type parameters")
		return
	}
	var named @Type = resolveMethodReceiver(c, d)
	if named == nil {
		return
	}
	// Build FuncType with the receiver as Params[0].
	var recvType @Type = resolveTypeExpr(c, d.Recv.Type)
	var ft @Type = resolveFuncDeclType(c, d)
	var combined @[]@Param = prependRecvParam(d.Recv.Name, recvType, ft.Params)
	var methodFuncType @Type = MakeFuncType(combined, ft.Results)

	var m @Method = MakeMethod(d.Name, recvType, methodFuncType)
	if c.AllowRedef {
		named.SetOrAppendMethod(m)
		return
	}
	if !named.AddMethod(m) {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("method ")
		cb.Write(d.Name)
		cb.Write(" redeclared on type ")
		cb.Write(named.TypeName())
		addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
	}
}

// LookupMethodForDecl returns the method (if any) currently
// registered on the named base type of d.Recv with name d.Name —
// or nil if d isn't a method, the receiver doesn't resolve to a
// known named type in c.Scope, or no method by that name is
// registered.  REPL entry point: the driver calls this BEFORE
// CheckDeclInScope to capture the pre-redef sig (CheckDeclInScope
// will overwrite it via SetOrAppendMethod when c.AllowRedef is
// set), so the driver can decide replace vs shadow at the IR/VM
// layers.
func (c @Checker) LookupMethodForDecl(d @ast.Decl) @Method {
	if d == nil { return nil }
	if d.Kind != ast.DECL_FUNC { return nil }
	if d.Recv == nil { return nil }
	// Walk the receiver TypeExpr to find the base named symbol —
	// mirrors resolveMethodReceiver but never reports errors and
	// returns nil rather than addCheckError on any miss (this is
	// a peek, not a validation).
	var base @ast.TypeExpr = d.Recv.Type
	for base != nil {
		if base.Kind == ast.TEXPR_POINTER ||
			base.Kind == ast.TEXPR_MANAGED ||
			base.Kind == ast.TEXPR_CONST ||
			base.Kind == ast.TEXPR_PAREN {
			base = base.Base
		} else {
			break
		}
	}
	if base == nil || base.Kind != ast.TEXPR_NAMED { return nil }
	if len(base.Pkg) > 0 { return nil }
	// Receiver types are package-level; under file-scoped imports c.Scope is a
	// file scope, so look in the package scope.
	var sym @Symbol = pkgScopeLookupLocal(c, base.Name)
	if sym == nil || sym.Kind != SYM_TYPE { return nil }
	if sym.Type == nil || sym.Type.Kind != TYP_NAMED { return nil }
	return sym.Type.LookupMethod(d.Name)
}


// resolveMethodReceiver validates a method's receiver type and returns
// the base named type. The receiver must be (a wrapper around) a named
// type defined in the current package — wrappers may include `*`, `@`,
// `const`, and parens. Returns nil and reports an error otherwise.
func resolveMethodReceiver(c @Checker, d @ast.Decl) @Type {
	// Walk the parsed receiver type expression to find the base name.
	var base @ast.TypeExpr = d.Recv.Type
	for base != nil {
		if base.Kind == ast.TEXPR_POINTER ||
			base.Kind == ast.TEXPR_MANAGED ||
			base.Kind == ast.TEXPR_CONST ||
			base.Kind == ast.TEXPR_PAREN {
			base = base.Base
		} else {
			break
		}
	}
	if base == nil || base.Kind != ast.TEXPR_NAMED {
		addCheckError(c, d.Pos,
			"method receiver must be a named type defined in this package")
		return nil
	}
	if len(base.Pkg) > 0 {
		addCheckError(c, d.Pos,
			"cannot define methods on types from other packages")
		return nil
	}
	// Receiver types are package-level; under file-scoped imports c.Scope is a
	// file scope, so look in the package scope.
	var sym @Symbol = pkgScopeLookupLocal(c, base.Name)
	if sym == nil && c.AllowUniverseRecv {
		// In the carve-out package, fall back to the full chain so
		// universe primitives (`int`, `bool`, ...) defined on the
		// universe scope resolve.  Per
		// plan-primitives-impl-interfaces.md Slice 1.
		sym = pkgScopeLookup(c, base.Name)
	}
	if sym == nil || sym.Kind != SYM_TYPE {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("method receiver ")
		cb.Write(base.Name)
		cb.Write(" is not a type defined in this package")
		addCheckError(c, d.Pos, buf.CopyStr(cb.String()))
		return nil
	}
	if sym.Type == nil || sym.Type.Kind != TYP_NAMED {
		// Aliases (TYP_ALIAS) and predeclared types fall here.
		// Carve-out: in the stdlib package, accept methods on
		// universe primitives (TYP_INT / TYP_FLOAT / TYP_BOOL).
		// Aliases stay rejected — they're transparent to method
		// resolution and would mean the method registers on the
		// underlying type at a confusing distance.
		if c.AllowUniverseRecv && sym.Type != nil &&
				isUniversePrimitive(sym.Type) {
			return sym.Type
		}
		addCheckError(c, d.Pos,
			"method receiver must be a named type (not an alias or builtin)")
		return nil
	}
	return sym.Type
}

// isUniversePrimitive reports whether t is one of the universe-
// scope predeclared primitive types — `int`, `bool`, `char`,
// floats, etc.  Used by the stdlib carve-out
// (resolveMethodReceiver, AddMethod) to recognize legal method
// receivers in `pkg/builtins/lang`.
func isUniversePrimitive(t @Type) bool {
	if t == nil { return false }
	if t.Kind == TYP_INT { return true }
	if t.Kind == TYP_FLOAT { return true }
	if t.Kind == TYP_BOOL { return true }
	return false
}

// lookupMethodFuncType returns the FuncType of a method declaration as
// previously registered by collectMethodDecl. Returns nil if registration
// failed (errors were already reported in pass 1).
func lookupMethodFuncType(c @Checker, d @ast.Decl) @Type {
	var named @Type = resolveTypeExpr(c, d.Recv.Type).ReceiverBaseNamed()
	if named == nil {
		return nil
	}
	var m @Method = named.LookupMethod(d.Name)
	if m == nil {
		return nil
	}
	return m.FuncType
}

// prependRecvParam returns a new param list with (recvName recvType) at
// position 0, followed by the existing params.
func prependRecvParam(recvName @[]char, recvType @Type, params @[]@Param) @[]@Param {
	var n int = len(params)
	var out @[]@Param = make_slice(@Param, n+1)
	var p @Param = make(Param)
	p.Name = recvName
	p.Type = recvType
	out[0] = p
	for i := 0; i < n; i++ {
		out[i+1] = params[i]
	}
	return out
}

// ============================================================
// Function-Body Checking (Pass 2)
// ============================================================

// checkMainSignature enforces the program entry-point SIGNATURE
// (prog.main.signature, §17.3): a `func main` in package `main` must be
// `func main()` -- no parameters, no results, and not generic.  The entry
// synthesis otherwise accepts any `main` (a `func main(x int)` ignores the
// extra parameter; a `func main() int` discards the result).
//
// This is the COMPILE-TIME facet of §17.3.1: compiling the `main` package
// sees its own `main`, so the shape is checkable here.  The complementary
// facet -- whether the *program* has a `main` package at ALL -- is NOT
// compile-time-knowable (Binate compiles one package at a time) and is a
// link/program-assembly concern; this function does not (and cannot) check it.
// Only the top-level `main` of package `main` is gated; a method named `main`
// (d.Recv != nil) or a `main` in any other package is an ordinary function.
func checkMainSignature(c @Checker, d @ast.Decl, ft @Type) {
	if d.Recv != nil { return }
	if !charEq(d.Name, "main") { return }
	if !charEq(c.curPkgPath, "main") { return }
	if len(ft.Params) != 0 || len(ft.Results) != 0 ||
			len(ft.TypeParams) != 0 {
		addCheckError(c, d.Pos,
			"entry function main must be declared `func main()` (no parameters, no results)")
	}
}

// checkFuncDecl type-checks a function or method declaration's body
// with parameters (and the method receiver, if any) in scope.
func checkFuncDecl(c @Checker, d @ast.Decl) {
	var ft @Type = nil
	if d.Recv != nil {
		ft = lookupMethodFuncType(c, d)
	} else {
		var sym @Symbol = c.Scope.Lookup(d.Name)
		if sym == nil {
			return
		}
		if sym.Type == nil || sym.Type.Kind != TYP_FUNC {
			return
		}
		ft = sym.Type
	}
	if ft == nil {
		return
	}

	checkMainSignature(c, d, ft)

	pushScope(c)

	// Re-install the generic type-param scope for body checking, so
	// references to `T` in local var decls / casts / etc. resolve
	// to the same TYP_TYPE_PARAM @Type instances stored on ft —
	// identity-comparable with their appearance in ft.Params /
	// ft.Results.  Slice 2 / Q3 of plan-generics.md.
	for i := 0; i < len(ft.TypeParams); i++ {
		defineType(c.Scope, ft.TypeParams[i].Name, ft.TypeParams[i])
	}

	// Define parameters (for methods, ft.Params[0] is the receiver, so
	// it gets bound under the receiver name, accessible inside the body).
	for i := 0; i < len(ft.Params); i++ {
		defineVar(c.Scope, ft.Params[i].Name, ft.Params[i].Type)
	}

	// Set expected return types
	var oldRet @[]@Type = c.FuncRet
	c.FuncRet = ft.Results

	if d.Body != nil {
		checkBlockStmt(c, d.Body)
	}

	// Missing-return check: a function with at least one result must
	// terminate on every path. We use a simplified Go-style termination
	// analysis (see stmtTerminates).
	if len(ft.Results) > 0 && d.Body != nil {
		if !stmtTerminates(d.Body) {
			errMissingReturn(c, d.Pos, d.Name)
		}
	}

	c.FuncRet = oldRet
	popScope(c)
}

// ============================================================
// Control-Flow Termination Analysis
// ============================================================

// stmtTerminates reports whether s unconditionally ends control flow
// (via a return, panic, or infinite loop with no break, etc.). Rules:
//   - RETURN: terminates.
//   - `panic(...)` call statement: terminates (panic is non-recoverable).
//   - BLOCK: terminates iff its last statement does.
//   - IF: terminates iff it has an else AND both branches terminate.
//   - FOR with no condition AND no break in body: terminates
//     (infinite loop with no escape).
//   - SWITCH with default AND every case ends in a terminator AND no
//     break: terminates.
//   - Anything else: does not terminate.
//
// Labels are not supported, so any break in a for/switch body
// disqualifies it.
func stmtTerminates(s @ast.Stmt) bool {
	if s == nil { return false }
	if s.Kind == ast.STMT_RETURN { return true }
	if s.Kind == ast.STMT_EXPR && isPanicCall(s.X) { return true }
	if s.Kind == ast.STMT_BLOCK {
		if len(s.Stmts) == 0 { return false }
		return stmtTerminates(s.Stmts[len(s.Stmts) - 1])
	}
	if s.Kind == ast.STMT_IF {
		if s.Else == nil { return false }
		return stmtTerminates(s.Body) && stmtTerminates(s.Else)
	}
	if s.Kind == ast.STMT_FOR {
		// Only unconditional for-loops (for {} and for _,_ in ... won't
		// match — that's a range form). X is nil for plain `for { ... }`.
		if s.X != nil { return false }
		if s.Init != nil || s.Post != nil { return false }
		if s.ForKey != nil || s.ForVal != nil { return false }
		return !stmtContainsBreak(s.Body)
	}
	if s.Kind == ast.STMT_SWITCH {
		if len(s.Cases) == 0 { return false }
		var hasDefault bool = false
		for i := 0; i < len(s.Cases); i++ {
			var cc @ast.CaseClause = s.Cases[i]
			if len(cc.Exprs) == 0 { hasDefault = true }
			if !caseTerminates(cc) { return false }
		}
		return hasDefault
	}
	return false
}

// isPanicCall reports whether e is a call to the builtin `panic`.
// Used by stmtTerminates — a `panic(...)` call is a terminator just
// like `return`, since panic is non-recoverable in Binate.
func isPanicCall(e @ast.Expr) bool {
	if e == nil { return false }
	if e.Kind != ast.EXPR_CALL { return false }
	if e.X == nil { return false }
	if e.X.Kind != ast.EXPR_IDENT { return false }
	return charEq(e.X.Name, "panic")
}

// caseTerminates reports whether every path through a switch case ends
// in a terminator (and no top-level break in the body).
func caseTerminates(cc @ast.CaseClause) bool {
	if len(cc.Body) == 0 { return false }
	for i := 0; i < len(cc.Body); i++ {
		if cc.Body[i].Kind == ast.STMT_BREAK { return false }
	}
	return stmtTerminates(cc.Body[len(cc.Body) - 1])
}

// stmtContainsBreak reports whether s or any nested statement contains a
// top-level break (not inside a nested for or switch, which would
// consume it). Used to decide whether a `for {}` loop is terminating.
func stmtContainsBreak(s @ast.Stmt) bool {
	if s == nil { return false }
	if s.Kind == ast.STMT_BREAK { return true }
	if s.Kind == ast.STMT_FOR || s.Kind == ast.STMT_SWITCH {
		// A nested for/switch consumes its own breaks.
		return false
	}
	if s.Kind == ast.STMT_BLOCK {
		for i := 0; i < len(s.Stmts); i++ {
			if stmtContainsBreak(s.Stmts[i]) { return true }
		}
		return false
	}
	if s.Kind == ast.STMT_IF {
		if stmtContainsBreak(s.Body) { return true }
		return stmtContainsBreak(s.Else)
	}
	return false
}
