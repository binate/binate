package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for methods on generic types (gen.method.generic-recv) — the
// collection path in check_decl_func_generic.bn and its body-pass hooks.
// Shared helpers (checkSrc / expectNoErrors / expectError) live in
// types_test.bn.

// A method on a generic type type-checks: the receiver `*Cursor[T]` binds T,
// and the body accesses a field of the abstract receiver.
func TestCheckGenericTypeMethod() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Cursor[T any] struct { i int }\n"
			"func (it *Cursor[T]) At() int { return it.i }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// The method references the bound T in a result type and in the body.
func TestCheckGenericTypeMethodReturnsT() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"func (b *Box[T]) Get() T { return b.v }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A managed receiver on a generic type binds T just as a raw-pointer one does.
func TestCheckGenericTypeMethodManagedRecv() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"func (b @Box[T]) Get() T { return b.v }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A multi-parameter generic type binds all its parameters positionally.
func TestCheckGenericTypeMethodMultiParam() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Pair[K any, V any] struct { k K\n v V }\n"
			"func (p *Pair[K, V]) Key() K { return p.k }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A receiver binding the wrong number of parameters is rejected.
func TestCheckGenericTypeMethodWrongArity() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"func (b *Box[T, U]) Get() T { return b.v }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A specific-instantiation receiver (a concrete type arg) is rejected — a method
// binds fresh names, it does not specialize (gen.no-conditional-impls).
func TestCheckGenericTypeMethodSpecificInstantiation() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"func (b *Box[int]) Get() int { return b.v }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A type-arg receiver on a non-generic type is rejected.
func TestCheckGenericTypeMethodNotGeneric() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box struct { v int }\n"
			"func (b *Box[T]) Get() int { return b.v }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A parameterized-receiver impl whose generic type provides the interface's
// method (abstractly) is accepted (gen.impl.generic-recv).
func TestCheckGenericImplCovers() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Iter[T any] { Next() (T, bool) }\n"
			"type Cursor[T any] struct { i int }\n"
			"func (c *Cursor[T]) Next() (T, bool) { var z T\n return z, false }\n"
			"impl *Cursor[T] : Iter[T]\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A parameterized impl whose generic type is missing the interface method is
// rejected.
func TestCheckGenericImplMissingMethod() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Iter[T any] { Next() (T, bool) }\n"
			"type Cursor[T any] struct { i int }\n"
			"impl *Cursor[T] : Iter[T]\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A parameterized impl whose method has the wrong signature is rejected.
func TestCheckGenericImplSigMismatch() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Iter[T any] { Next() (T, bool) }\n"
			"type Cursor[T any] struct { i int }\n"
			"func (c *Cursor[T]) Next() T { var z T\n return z }\n"
			"impl *Cursor[T] : Iter[T]\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A specific-instantiation impl receiver (`impl *Cursor[int] : …`) is rejected.
func TestCheckGenericImplSpecificInstantiation() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Iter[T any] { Next() (T, bool) }\n"
			"type Cursor[T any] struct { i int }\n"
			"func (c *Cursor[T]) Next() (T, bool) { var z T\n return z, false }\n"
			"impl *Cursor[int] : Iter[int]\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A concrete instantiation carries the generic type's methods, substituted: a
// direct method call on Box[int] resolves to Get() with result int (Phase 3).
func TestCheckGenericInstMethodCall() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"func (b @Box[T]) Get() T { return b.v }\n"
			"func use() int {\n"
			"var b @Box[int] = make(Box[int])\n"
			"return b.Get()\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// An instantiation used as a global-var type BEFORE its method decl is collected
// still resolves the method: the post-collection back-fill re-syncs the
// method-less-cached instantiation (the population-ordering hazard — without the
// back-fill `g.Get()` is spuriously `undefined`).
func TestCheckGenericInstMethodOrderingBackfill() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"var g Box[int]\n"
			"func (b *Box[T]) Get() T { return b.v }\n"
			"func use() int {\n"
			"g.v = 1\n"
			"return g.Get()\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A generic type's method body may call a SIBLING method on its receiver: the
// abstract self-shell `Box[T]` exposes the type's own method set (after the
// back-fill), so `b.Get()` inside another method resolves.
func TestCheckGenericTypeMethodSiblingCall() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"func (b *Box[T]) Get() T { return b.v }\n"
			"func (b *Box[T]) Twice() T { return b.Get() }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// An instantiation forced (as a var type) BETWEEN two method decls is cached
// partially populated — only the earlier method (Get).  The back-fill must add
// the later one (Set) too, or `g.Set(...)` is spuriously `undefined`.  Exercises
// copyPlaceholderMethods's back-fill-missing (not skip-if-any) behavior.
func TestCheckGenericInstMethodInterleavedBackfill() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"func (b *Box[T]) Get() T { return b.v }\n"
			"var g Box[int]\n"
			"func (b *Box[T]) Set(x T) { b.v = x }\n"
			"func use() int {\n"
			"g.Set(3)\n"
			"return g.Get()\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A concrete instantiation is assignable to the managed interface value of the
// interface its generic type impls, via binder substitution (Phase 3).
func TestCheckGenericInstAssignableToIface() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Iter[T any] { Next() (T, bool) }\n"
			"type Cursor[T any] struct { i int }\n"
			"func (c @Cursor[T]) Next() (T, bool) { var z T\n return z, false }\n"
			"impl @Cursor[T] : Iter[T]\n"
			"func use() {\n"
			"var c @Cursor[int] = make(Cursor[int])\n"
			"var it @Iter[int] = c\n"
			"_ = it\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A concrete instantiation is NOT assignable to an interface its generic type
// does not impl.
func TestCheckGenericInstNotAssignableToUnrelatedIface() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Iter[T any] { Next() (T, bool) }\n"
			"interface Other[T any] { Other() T }\n"
			"type Cursor[T any] struct { i int }\n"
			"func (c @Cursor[T]) Next() (T, bool) { var z T\n return z, false }\n"
			"impl @Cursor[T] : Iter[T]\n"
			"func use() {\n"
			"var c @Cursor[int] = make(Cursor[int])\n"
			"var it @Other[int] = c\n"
			"_ = it\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}
