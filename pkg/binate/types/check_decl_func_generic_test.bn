package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for methods on generic types (gen.method.generic-recv) — the
// collection path in check_decl_func_generic.bn and its body-pass hooks.
// Shared helpers (checkSrc / expectNoErrors / expectError) live in
// types_test.bn.

// A method on a generic type type-checks: the receiver `*Cursor[T]` binds T,
// and the body accesses a field of the abstract receiver.
func TestCheckGenericTypeMethod() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Cursor[T any] struct { i int }\n"
			"func (it *Cursor[T]) At() int { return it.i }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// The method references the bound T in a result type and in the body.
func TestCheckGenericTypeMethodReturnsT() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"func (b *Box[T]) Get() T { return b.v }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A managed receiver on a generic type binds T just as a raw-pointer one does.
func TestCheckGenericTypeMethodManagedRecv() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"func (b @Box[T]) Get() T { return b.v }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A multi-parameter generic type binds all its parameters positionally.
func TestCheckGenericTypeMethodMultiParam() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Pair[K any, V any] struct { k K\n v V }\n"
			"func (p *Pair[K, V]) Key() K { return p.k }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A receiver binding the wrong number of parameters is rejected.
func TestCheckGenericTypeMethodWrongArity() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"func (b *Box[T, U]) Get() T { return b.v }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A specific-instantiation receiver (a concrete type arg) is rejected — a method
// binds fresh names, it does not specialize (gen.no-conditional-impls).
func TestCheckGenericTypeMethodSpecificInstantiation() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"func (b *Box[int]) Get() int { return b.v }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A type-arg receiver on a non-generic type is rejected.
func TestCheckGenericTypeMethodNotGeneric() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box struct { v int }\n"
			"func (b *Box[T]) Get() int { return b.v }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}
