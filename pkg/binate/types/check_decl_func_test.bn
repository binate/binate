package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests that exercise the func/method-decl machinery in
// check_decl_func.bn: simple func decls, the missing-return /
// termination analysis, and method declarations.

// ============================================================
// Function declarations
// ============================================================

func TestCheckFuncDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc add(a int, b int) int { return a + b }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFuncReturnTypeMismatch() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() int { return true }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// ============================================================
// Generic function declarations (plan-generics.md Slice 2)
// ============================================================

// Identity function — references T in param and result types and
// in the body's return path; type-checks with the type-param
// scope installed by resolveFuncDeclType + checkFuncDecl.
func TestCheckGenericIdentity() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc id[T any](x T) T { return x }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Two type params, both used in the signature.
func TestCheckGenericPair() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func pickFirst[T any, U any](x T, y U) T { return x }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// T appears inside a composite type (pointer-to-T).  Tests that
// the type-param scope is visible during composite-type resolution.
func TestCheckGenericPointerT() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc thru[T any](p *T) T { return *p }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Non-`any` constraint is rejected in Slice 2.  Constraint
// resolution proceeds with nil so the rest of the decl still
// checks; the test asserts at least one error fires.
func TestCheckGenericConstraintNotAnyRejected() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc bad[T int](x T) T { return x }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Calling a generic function without explicit type arguments is
// rejected — Binate has no type inference, so the no-brackets
// call form is unusable for generics.  (The brackets form lands
// in Slice 2b instantiation work; for now it errors at the
// "generic instantiation not yet supported" gate.)
func TestCheckGenericCallWithoutTypeArgsRejected() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func id[T any](x T) T { return x }\n"
			"func main() { id(5) }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Body references that aren't covered by the type-param: a free
// `Q` in the body should still resolve as an undefined name, not
// silently get treated as a type-param.  Regression check on the
// scope teardown.
func TestCheckGenericBodyDoesNotLeakTypeParam() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func g[T any](x T) T { return x }\n"
			"func bad() { var x T }\n"
	// `T` is not in scope outside g's body

	var c @Checker = checkSrc(src)
	return expectError(c)
}

