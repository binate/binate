package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests that exercise the func/method-decl machinery in
// check_decl_func.bn: simple func decls, the missing-return /
// termination analysis, and method declarations.

// ============================================================
// Function declarations
// ============================================================

func TestCheckFuncDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc add(a int, b int) int { return a + b }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFuncReturnTypeMismatch() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() int { return true }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// ============================================================
// Generic function declarations (plan-generics.md Slice 2)
// ============================================================

// Identity function — references T in param and result types and
// in the body's return path; type-checks with the type-param
// scope installed by resolveFuncDeclType + checkFuncDecl.
func TestCheckGenericIdentity() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nfunc id[T any](x T) T { return x }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Two type params, both used in the signature.
func TestCheckGenericPair() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nfunc pickFirst[T any, U any](x T, y U) T { return x }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// T appears inside a composite type (pointer-to-T).  Tests that
// the type-param scope is visible during composite-type resolution.
func TestCheckGenericPointerT() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nfunc thru[T any](p *T) T { return *p }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Non-`any` constraint is rejected in Slice 2.  Constraint
// resolution proceeds with nil so the rest of the decl still
// checks; the test asserts at least one error fires.
func TestCheckGenericConstraintNotAnyRejected() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nfunc bad[T int](x T) T { return x }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Calling a generic function without explicit type arguments is
// rejected — Binate has no type inference, so the no-brackets
// call form is unusable for generics.  (The brackets form lands
// in Slice 2b instantiation work; for now it errors at the
// "generic instantiation not yet supported" gate.)
func TestCheckGenericCallWithoutTypeArgsRejected() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func id[T any](x T) T { return x }\n"
		"func main() { id(5) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Body references that aren't covered by the type-param: a free
// `Q` in the body should still resolve as an undefined name, not
// silently get treated as a type-param.  Regression check on the
// scope teardown.
func TestCheckGenericBodyDoesNotLeakTypeParam() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func g[T any](x T) T { return x }\n"
		// `T` is not in scope outside g's body
		"func bad() { var x T }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// ============================================================
// Termination analysis / missing-return detection
// ============================================================

// Void function with no return is fine (no check applies).
func TestMissingReturnVoidOk() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Missing return at end of non-void function is an error.
func TestMissingReturnFallthrough() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() int { var x int = 1 }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// if without else cannot terminate — fall-through possible.
func TestMissingReturnIfNoElse() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func f(x int) int { if x > 0 { return 1 } }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// if/else where only one branch returns is an error.
func TestMissingReturnIfElsePartial() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func f(x int) int {\n"
		"  if x > 0 { return 1 } else { var y int = 2 }\n"
		"}\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// if/else where both branches return terminates.
func TestTerminatesIfElseBothReturn() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func f(x int) int {\n"
		"  if x > 0 { return 1 } else { return -1 }\n"
		"}\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Unconditional for-loop with no break terminates.
func TestTerminatesForNoBreak() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func f() int { for { var x int = 1 } }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Unconditional for-loop with a top-level break does NOT terminate.
func TestMissingReturnForWithBreak() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func f() int { for { break } }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// for with a condition does NOT terminate (the cond may be false).
func TestMissingReturnForWithCond() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func f() int {\n"
		"  for i := 0; i < 10; i++ { }\n"
		"}\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Switch with default + all cases terminating = terminates.
func TestTerminatesSwitchWithDefault() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func f(x int) int {\n"
		"  switch x {\n"
		"  case 1: return 10\n"
		"  default: return 0\n"
		"  }\n"
		"}\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Switch with no default does NOT terminate.
func TestMissingReturnSwitchNoDefault() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func f(x int) int {\n"
		"  switch x {\n"
		"  case 1: return 10\n"
		"  case 2: return 20\n"
		"  }\n"
		"}\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Switch where one case doesn't return does NOT terminate.
func TestMissingReturnSwitchCaseNoReturn() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func f(x int) int {\n"
		"  switch x {\n"
		"  case 1: return 10\n"
		"  default: var y int = 0\n"
		"  }\n"
		"}\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Switch case containing a top-level `break` does NOT terminate
// (break escapes the switch without returning).
func TestMissingReturnSwitchCaseBreak() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func f(x int) int {\n"
		"  switch x {\n"
		"  case 1: break\n"
		"  default: return 0\n"
		"  }\n"
		"}\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Nested: a `break` inside a nested for should not disqualify the
// outer for { } as terminating.
func TestTerminatesNestedBreakIgnored() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func f() int {\n"
		"  for {\n"
		"    for i := 0; i < 3; i++ { break }\n"
		"  }\n"
		"}\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// panic(...) as the final statement is a terminator. Non-void
// functions need not have an explicit return after a panic.
func TestTerminatesPanic() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() int { panic(\"nope\") }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// panic in the fall-through position after a conditional return.
func TestTerminatesIfReturnElsePanic() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func f(x int) int {\n"
		"  if x > 0 { return x }\n"
		"  panic(\"nope\")\n"
		"}\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// panic in both branches of an if/else.
func TestTerminatesIfElseBothPanic() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func f(x int) int {\n"
		"  if x > 0 { panic(\"a\") } else { panic(\"b\") }\n"
		"}\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Regular function calls that look like panic but aren't are not
// terminators. A return is still required.
func TestNonPanicExprDoesNotTerminate() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func g() { }\n"
		"func f() int { g() }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// ============================================================
// Method declarations (Stage 2 of plan-receivers.md)
// ============================================================

