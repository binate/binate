	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Counter struct { n int }\n"
		"func (c Counter) Get() int { return c.n }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

func TestCheckMethodManagedRecv() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Node struct { val int }\n"
		"func (n @Node) Val() int { return n.val }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

func TestCheckMethodOnNamedPrimitive() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Celsius int\n"
		"func (c Celsius) Zero() bool { return false }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
