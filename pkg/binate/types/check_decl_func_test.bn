}

func TestCheckMethodOnAliasIsError() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type MyInt = int\n"
		"func (m MyInt) Get() int { return 0 }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

func TestCheckMethodOnBuiltinIsError() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc (i int) Foo() int { return 0 }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckMethodDuplicateIsError() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Point struct { x int }\n"
		"func (p *Point) X() int { return p.x }\n"
		"func (p *Point) X() int { return 0 }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// Free function and method with the same name are allowed: methods
// live in per-type method sets, not the package symbol table.
func TestCheckMethodAndFreeFunctionSameNameOK() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Point struct { x int }\n"
		"func (p *Point) Foo() int { return p.x }\n"
		"func Foo() int { return 42 }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// Two methods with the same name on different types are allowed.
func TestCheckMethodSameNameDifferentTypesOK() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type A struct { x int }\n"
		"type B struct { y int }\n"
		"func (a *A) Get() int { return a.x }\n"
		"func (b *B) Get() int { return b.y }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// The receiver name must be visible inside the method body.
func TestCheckMethodBodySeesReceiver() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Point struct { x int; y int }\n"
		"func (p *Point) Sum() int { return p.x + p.y }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// Method bodies type-check normally; an int-vs-bool mismatch is reported.
func TestCheckMethodBodyTypeError() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Point struct { x int }\n"
		"func (p *Point) X() bool { return p.x }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// ============================================================
// Method redefinition (Tier 4 follow-up: REPL prompt)
// ============================================================

// SetOrAppendMethod replaces a same-named method on the type's
// method set in place; AddMethod refuses.  This is the substrate
// the REPL c.AllowRedef branch in collectMethodDecl uses.
//
// We distinguish the old vs new entry by giving them different
// FuncType return types (int vs bool) and comparing via
// Identical — direct @Method comparison isn't supported by the
// bootstrap interpreter.
func TestSetOrAppendMethodReplaces() testing.TestResult {
	var t @Type = MakeNamedType("Counter")
	var noParams @[]@Param

	var resInt @[]@Type = make_slice(@Type, 1)
	resInt[0] = TypInt()
	var ftInt @Type = MakeFuncType(noParams, resInt)

	var resBool @[]@Type = make_slice(@Type, 1)
	resBool[0] = TypBool()
	var ftBool @Type = MakeFuncType(noParams, resBool)

	if !t.AddMethod(MakeMethod("Inc", t, ftInt)) {
		return fail("first AddMethod failed")
	}
	if len(t.Methods) != 1 { return fail("expected 1 method after first add") }

	if !t.SetOrAppendMethod(MakeMethod("Inc", t, ftBool)) {
		return fail("SetOrAppendMethod returned false")
	}
	if len(t.Methods) != 1 {
		return fail("expected method-set length to stay at 1 after replace")
	}
	if !t.Methods[0].FuncType.Identical(ftBool) {
		return fail("expected the new (bool-returning) FuncType in place")
	}
	return ""
}

// SetOrAppendMethod with a fresh name behaves like AddMethod
// (appends, doesn't replace).
func TestSetOrAppendMethodAppendsFresh() testing.TestResult {
	var t @Type = MakeNamedType("Counter")
	var noParams @[]@Param
	var noResults @[]@Type
	var ft @Type = MakeFuncType(noParams, noResults)
	if !t.SetOrAppendMethod(MakeMethod("Inc", t, ft)) {
		return fail("first SetOrAppendMethod failed")
	}
	if !t.SetOrAppendMethod(MakeMethod("Dec", t, ft)) {
		return fail("second SetOrAppendMethod failed")
	}
	if len(t.Methods) != 2 {
		return fail("expected 2 methods on the type after distinct names")
	}
	return ""
}

// CheckDeclInScope on a method redef does NOT error (sets
// AllowRedef, which routes collectMethodDecl through
// SetOrAppendMethod) — and the receiver type's method set still
// has only one entry by that name.  This is the type-checker
// half of the REPL "method redefinition" Tier 4 follow-up.
func TestCheckDeclInScopeMethodRedefSameSig() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\ntype Counter struct { n int }\nfunc main() {}\n"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "test.bn")
	var f @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.CheckMainPersistent(f)
	if len(c.CheckerErrors()) != 0 {
		return fail("loading base file produced errors")
	}

	// First-time method definition.
	var m1Src *[]readonly char =
		"func (c *Counter) Inc() { c.n = c.n + 1 }"
	var p1 @parser.Parser = parser.New(toBytes(m1Src), "<repl>")
	var d1 @ast.Decl = p1.ParseTopLevelDecl()
	c.CheckDeclInScope(d1)
	if len(c.CheckerErrors()) != 0 {
		return fail("first method definition errored")
	}

	// Redefinition with the same sig.
	var m2Src *[]readonly char =
		"func (c *Counter) Inc() { c.n = c.n + 2 }"
	var p2 @parser.Parser = parser.New(toBytes(m2Src), "<repl>")
	var d2 @ast.Decl = p2.ParseTopLevelDecl()
	c.CheckDeclInScope(d2)
	if len(c.CheckerErrors()) != 0 {
		return fail("method redef under AllowRedef should not error")
	}

	// Receiver type's method set still has exactly one Inc.
	var counterSym @Symbol = c.Scope.Lookup("Counter")
	if counterSym == nil || counterSym.Type == nil {
		return fail("Counter not found in scope")
	}
	var count int = 0
	for i := 0; i < len(counterSym.Type.Methods); i++ {
		if charEq(counterSym.Type.Methods[i].Name, "Inc") {
			count = count + 1
		}
	}
	if count != 1 {
		return fail("expected exactly one Inc on Counter after redef")
	}
	return ""
}

// LookupMethodForDecl returns the registered Method (used by the
// REPL driver to capture the pre-redef sig before
// CheckDeclInScope overwrites it).
func TestLookupMethodForDeclFindsExisting() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\ntype Counter struct { n int }\nfunc (c *Counter) Inc() {}\nfunc main() {}\n"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "test.bn")
	var f @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.CheckMainPersistent(f)
	if len(c.CheckerErrors()) != 0 { return fail("setup errored") }

	var redefSrc *[]readonly char =
		"func (c *Counter) Inc() { c.n = 1 }"
	var rp @parser.Parser = parser.New(toBytes(redefSrc), "<repl>")
	var d @ast.Decl = rp.ParseTopLevelDecl()
	var existing @Method = c.LookupMethodForDecl(d)
	if existing == nil {
		return fail("expected to find existing Inc method")
	}
	if !charEq(existing.Name, "Inc") {
		return fail("LookupMethodForDecl returned wrong method")
	}
	return ""
}

// LookupMethodForDecl returns nil for a free func decl, an
// unknown receiver type, or a decl whose method isn't yet
// registered.  Same nil-on-miss contract the REPL driver relies
// on to detect first-time-definition vs redef.
func TestLookupMethodForDeclNilOnMiss() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\ntype Counter struct { n int }\nfunc main() {}\n"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "test.bn")
	var f @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.CheckMainPersistent(f)

	// Free func: nil.
	var freeSrc *[]readonly char = "func plain() int { return 0 }"
	var fp @parser.Parser = parser.New(toBytes(freeSrc), "<repl>")
	var fd @ast.Decl = fp.ParseTopLevelDecl()
	if c.LookupMethodForDecl(fd) != nil {
		return fail("expected nil for a free func decl")
	}

	// Unknown receiver type: nil.
	var unkSrc *[]readonly char = "func (u *Unknown) M() {}"
	var up @parser.Parser = parser.New(toBytes(unkSrc), "<repl>")
	var ud @ast.Decl = up.ParseTopLevelDecl()
	if c.LookupMethodForDecl(ud) != nil {
		return fail("expected nil for an unknown receiver type")
	}

	// Known receiver, unregistered method name: nil.
	var newSrc *[]readonly char = "func (c *Counter) Brand() {}"
	var np @parser.Parser = parser.New(toBytes(newSrc), "<repl>")
	var nd @ast.Decl = np.ParseTopLevelDecl()
	if c.LookupMethodForDecl(nd) != nil {
		return fail("expected nil for an unregistered method name")
	}
	return ""
}
