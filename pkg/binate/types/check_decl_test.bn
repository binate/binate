package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests that exercise the simple-decl-kind machinery in
// check_decl.bn: var, const, type/group, plus undefined-name
// detection.  Function- and method-decl tests live in
// check_decl_func_test.bn.

func TestCheckVarDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x int = 42\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckVarDeclTypeMismatch() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x bool = 42\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckStringVar() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x @[]readonly char = \"hello\"\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckUndefined() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x int = y\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckConstDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst x int = 42\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Forward-declared types are accepted as opaque references —
// `*S`/`@S` can be held — but the type's underlying layout is
// not yet known.  Phase 2 of plan-type-decls.md.
func TestCheckForwardDeclAccepted() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype Opaque\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Two struct declarations with identical field lists are
// SILENTLY collapsed — the loader prepending .bni decls to the
// .bn impl is a common benign-duplicate source.  Phase 2 only
// warns on actual mismatches.
func TestCheckDuplicateStructSameShapeNoWarning() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"type S struct { a int; b int }\n"
		"type S struct { a int; b int }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) > 0 {
		return "same-shape duplicate must not error"
	}
	if len(c.CheckerWarnings()) > 0 {
		return "same-shape duplicate must not warn (loader-merged bni/bn is benign)"
	}
	return ""
}

// Two struct decls with DIFFERENT field lists trigger the Phase 5
// error.  Captures the silent-miscompile shape from Stage 4 of
// plan-c-call.md: .bni says one layout, .bn says another, the
// codegen picks one and downstream field accesses get the wrong
// offset.  Phase 2 emitted this as a warning during the migration
// window; Phase 5 (post-cleanup) flips to a hard error so no
// future refactor can re-introduce the silent miscompile.
func TestCheckDuplicateStructMismatchErrors() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"type S struct { a int; b int; c bool }\n"
		"type S struct { a int; b int }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) == 0 {
		return "mismatched duplicate must error (Phase 5 post-cleanup)"
	}
	return ""
}

// Forward decl + matching full body: the body fills in the
// underlying.  No warning even though the name appears twice —
// that's the intended .bni-forward + .bn-body pattern.
func TestCheckForwardDeclPlusBodyNoWarning() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"type S\n"
		"type S struct { a int; b int }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) > 0 {
		return "forward + body must not error"
	}
	if len(c.CheckerWarnings()) > 0 {
		return "forward + body must not warn — it's the intended pattern"
	}
	return ""
}

// Named-type (distinct-type, non-struct) duplicates follow the
// same rule as struct duplicates: same underlying TypeName silently
// dedups, mismatched underlying warns.  Symmetric with the struct
// path so a future cleanup pass can treat the two consistently.
func TestCheckDuplicateNamedTypeSameUnderlyingNoWarning() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"type Id int\n"
		"type Id int\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) > 0 {
		return "same-underlying named-type duplicate must not error"
	}
	if len(c.CheckerWarnings()) > 0 {
		return "same-underlying named-type duplicate must not warn"
	}
	return ""
}

func TestCheckDuplicateNamedTypeMismatchErrors() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"type Id int\n"
		"type Id int64\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) == 0 {
		return "mismatched named-type duplicate must error (Phase 5 post-cleanup)"
	}
	return ""
}

func TestCheckConstGroup() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst (\n\tA int = iota\n\tB\n\tC\n)\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// const is scalar-only: bool and float consts are accepted (int is
// covered by TestCheckConstDecl).  Guards that the scalar-only rule
// doesn't reject the legitimate non-int scalar families.
func TestCheckConstBoolFloatOK() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst B bool = true\nconst F float64 = 1.5\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A string-typed const is rejected — const requires a scalar type; a
// string immutable value is a `var X readonly *[]readonly char = ...`.
func TestCheckRejectConstString() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst X *[]readonly char = \"hi\"\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A struct-typed const is rejected for the same reason (non-scalar).
func TestCheckRejectConstStruct() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Pt struct { x int }\n"
		"const P Pt = Pt{x: 1}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// A value-less standalone const is rejected — every const carries a
// value (only iota-group members may omit it).
func TestCheckRejectConstNoValue() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nconst X int\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Taking the address of a const is rejected — a const is a
// compile-time value with no storage.
func TestCheckRejectAddrOfConst() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"const C int = 5\n"
		"func f() { var p *int = &C; _ = p }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// `&pkg.C` (address of an IMPORTED const) is rejected just like `&C`:
// the const has no storage to point at.  The token.AMP check resolves
// the package-qualified EXPR_SELECTOR the same way the selector read
// path does, gating on SYM_CONST so an imported func / type / (future)
// extern var stays addressable.
func TestCheckRejectAddrOfQualifiedConst() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/x",
		"package \"pkg/x\"\nconst MAX int = 10\n",
		"package \"test\"\nimport \"pkg/x\"\n"
		"func f() { var p *int = &x.MAX; _ = p }\n")
	return expectError(c)
}

// `pkg.C = v` (assigning to an imported const) is rejected — a const has
// no storage.  Assignment sibling of the &pkg.C rejection above; both
// resolve the qualified member via resolveQualifiedSym.
func TestCheckRejectAssignQualifiedConst() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/x",
		"package \"pkg/x\"\nconst MAX int = 10\n",
		"package \"test\"\nimport \"pkg/x\"\n"
		"func f() { x.MAX = 5 }\n")
	return expectError(c)
}

// READING a package-qualified const (no `&`) is unaffected — the new
// EXPR_SELECTOR arm fires only under token.AMP, so normal qualified
// access still type-checks.  Positive control for the rejection above.
func TestCheckQualifiedConstReadOK() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/x",
		"package \"pkg/x\"\nconst MAX int = 10\n",
		"package \"test\"\nimport \"pkg/x\"\n"
		"func f() { var n int = x.MAX; _ = n }\n")
	return expectNoErrors(c)
}

// Reading an exported `.bni` `var` cross-package type-checks: the var is
// a SYM_VAR member resolved like any qualified access (the read half of
// `.bni` extern vars).  Conformance 548 covers the full pipeline; this is
// the fast checker-level guard.
func TestCheckQualifiedVarReadOK() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/x",
		"package \"pkg/x\"\nvar Count int\n",
		"package \"test\"\nimport \"pkg/x\"\n"
		"func f() { var n int = x.Count; _ = n }\n")
	return expectNoErrors(c)
}

// Assigning to an imported (non-readonly) var type-checks — it is mutable
// storage, unlike a const.  (Conformance 552 covers the runtime write.)
func TestCheckAssignQualifiedVarOK() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/x",
		"package \"pkg/x\"\nvar Count int\n",
		"package \"test\"\nimport \"pkg/x\"\n"
		"func f() { x.Count = 5 }\n")
	return expectNoErrors(c)
}

// `&pkg.Var` (address of an imported var) is LEGAL — vars have storage.
// Guards that deferral-3's `&pkg.Const` rejection (gated on SYM_CONST)
// leaves an imported SYM_VAR addressable.  (This is the type-checker
// guard; compiled codegen for a global's address-as-value is a separate
// tracked bug — see conformance/551.)
func TestCheckAddrOfQualifiedVarOK() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/x",
		"package \"pkg/x\"\nvar Count int\n",
		"package \"test\"\nimport \"pkg/x\"\n"
		"func f() { var p *int = &x.Count; _ = p }\n")
	return expectNoErrors(c)
}

// A FORWARD reference to a bare iota-continuation const-group member
// (one with no explicit type, e.g. B / C below) must resolve.
// collectDecls forward-registers every const-group member so a use in
// a decl checked BEFORE the group resolves — the same path that makes
// a const group usable across files of one package (files are merged,
// and the using file may be ordered before the defining group).
// Regression: bare members (no TypeRef) were skipped during
// collection, so this failed with `undefined: B`.
func TestForwardRefBareIotaConstMember() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"func use() int { return B }\n"
		"const (\n"
		"\tA int = iota\n"
		"\tB\n"
		"\tC\n"
		")\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A forward reference to an UNTYPED single const (`const X = 5`, no
// explicit type) resolves: collectDecls forward-registers it with a
// placeholder type inferred from the initializer literal, mirroring the
// bare iota group-member arm (TestForwardRefBareIotaConstMember).  The
// value is NOT checkExpr'd during collection, so a reference-valued const
// (`const X = Y; const Y = 5`) doesn't emit a spurious `undefined`.
func TestForwardRefUntypedSingleConst() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"func use() int { return X }\n"
		"const X = 5\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A reference-valued untyped const (`const X = Y` with Y declared after)
// must not emit a spurious `undefined` during pass-1 collection: X is
// forward-registered with a conservative placeholder WITHOUT checkExpr-
// ing its value, and pass 2 resolves Y normally.  This is the hazard the
// literal-only placeholder mapping guards against.
func TestForwardRefUntypedConstReferencingConst() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"const X = Y\n"
		"const Y = 5\n"
		"func use() int { return X }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckTypeDecl() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Point struct { X int; Y int }\n")
	cb = cb.WriteStr("func f() { var p Point; p.X = 1 }\n")
	var src *[]readonly char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// KNOWN GAP (claude-todo C1, adversarial review 2026-06-06): inc/dec on a
// local const is NOT rejected — STMT_INC_DEC checks only IsInteger(), not
// const-ness — so `const C int = 5; C++` type-checks and (after local-const
// materialization) mutates the const at runtime.  Assign / compound-assign /
// &C are correctly rejected; only ++/-- slip through.  Flip to expectError
// when fixed.
func TestIncDecOnConstNotRejectedKnownGap() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"func f() { const C int = 5; C++ }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// KNOWN GAP (claude-todo M3, adversarial review 2026-06-06): a const array
// dimension in a STRUCT FIELD resolves to a zero-length array (struct types
// resolve once in pass 1, before const values are recorded), so a valid use
// of the field is spuriously rejected.  IR-gen is unaffected (resolves the
// dim independently), so this is a false-positive rejection.  Flip to
// expectNoErrors when fixed.
func TestConstArrayDimInStructFieldKnownGap() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"const N int = 3\n"
		"type S struct { arr [N]int }\n"
		"func g(a [3]int) int { return a[0] }\n"
		"func use(s S) int { return g(s.arr) }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// KNOWN GAP (claude-todo M6, adversarial review 2026-06-06): a forward
// reference to a NON-literal untyped const whose real type is non-int is
// silently accepted — the pass-1 value-less untyped-int placeholder is
// assignable to any integer target.  Here `var x int = A` (A = B = 1.5,
// both declared after x) should error but does not.  Flip to expectError
// when fixed.
func TestForwardRefNonLiteralUntypedConstFalseAcceptKnownGap() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"var x int = A\n"
		"const A = B\n"
		"const B = 1.5\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}
