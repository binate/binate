package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the var / type / group decl kinds and const-misuse
// rejection (addr-of / assign / inc-dec) in check_decl.bn and the
// statement/expression arms.  Const-DECLARATION checking tests live
// in check_const_test.bn.

func TestCheckVarDecl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x int = 42\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckVarDeclTypeMismatch() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x bool = 42\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckStringVar() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x @[]readonly char = \"hello\"\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckUndefined() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x int = y\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Forward-declared types are accepted as opaque references —
// `*S`/`@S` can be held — but the type's underlying layout is
// not yet known.  Phase 2 of plan-type-decls.md.
func TestCheckForwardDeclAccepted() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype Opaque\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Forward decl + matching full body: the body fills in the
// underlying.  No warning even though the name appears twice —
// that's the intended .bni-forward + .bn-body pattern.
func TestCheckForwardDeclPlusBodyNoWarning() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"type S\n"
		"type S struct { a int; b int }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) > 0 {
		return "forward + body must not error"
	}
	if len(c.CheckerWarnings()) > 0 {
		return "forward + body must not warn — it's the intended pattern"
	}
	return ""
}

// Taking the address of a const is rejected — a const is a
// compile-time value with no storage.
func TestCheckRejectAddrOfConst() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"const C int = 5\n"
		"func f() { var p *int = &C; _ = p }\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// `&pkg.C` (address of an IMPORTED const) is rejected just like `&C`:
// the const has no storage to point at.  The token.AMP check resolves
// the package-qualified EXPR_SELECTOR the same way the selector read
// path does, gating on SYM_CONST so an imported func / type / (future)
// extern var stays addressable.
func TestCheckRejectAddrOfQualifiedConst() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/x",
		"package \"pkg/x\"\nconst MAX int = 10\n",
		"package \"test\"\nimport \"pkg/x\"\n"
		"func f() { var p *int = &x.MAX; _ = p }\n")
	return expectError(c)
}

// `pkg.C = v` (assigning to an imported const) is rejected — a const has
// no storage.  Assignment sibling of the &pkg.C rejection above; both
// resolve the qualified member via resolveQualifiedSym.
func TestCheckRejectAssignQualifiedConst() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/x",
		"package \"pkg/x\"\nconst MAX int = 10\n",
		"package \"test\"\nimport \"pkg/x\"\n"
		"func f() { x.MAX = 5 }\n")
	return expectError(c)
}

// READING a package-qualified const (no `&`) is unaffected — the new
// EXPR_SELECTOR arm fires only under token.AMP, so normal qualified
// access still type-checks.  Positive control for the rejection above.
func TestCheckQualifiedConstReadOK() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/x",
		"package \"pkg/x\"\nconst MAX int = 10\n",
		"package \"test\"\nimport \"pkg/x\"\n"
		"func f() { var n int = x.MAX; _ = n }\n")
	return expectNoErrors(c)
}

// Reading an exported `.bni` `var` cross-package type-checks: the var is
// a SYM_VAR member resolved like any qualified access (the read half of
// `.bni` extern vars).  Conformance 548 covers the full pipeline; this is
// the fast checker-level guard.
func TestCheckQualifiedVarReadOK() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/x",
		"package \"pkg/x\"\nvar Count int\n",
		"package \"test\"\nimport \"pkg/x\"\n"
		"func f() { var n int = x.Count; _ = n }\n")
	return expectNoErrors(c)
}

// Assigning to an imported (non-readonly) var type-checks — it is mutable
// storage, unlike a const.  (Conformance 552 covers the runtime write.)
func TestCheckAssignQualifiedVarOK() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/x",
		"package \"pkg/x\"\nvar Count int\n",
		"package \"test\"\nimport \"pkg/x\"\n"
		"func f() { x.Count = 5 }\n")
	return expectNoErrors(c)
}

// `&pkg.Var` (address of an imported var) is LEGAL — vars have storage.
// Guards that deferral-3's `&pkg.Const` rejection (gated on SYM_CONST)
// leaves an imported SYM_VAR addressable.  (This is the type-checker
// guard; compiled codegen for a global's address-as-value is a separate
// tracked bug — see conformance/551.)
func TestCheckAddrOfQualifiedVarOK() testing.TestResult {
	var c @Checker = checkSrcImporting("pkg/x",
		"package \"pkg/x\"\nvar Count int\n",
		"package \"test\"\nimport \"pkg/x\"\n"
		"func f() { var p *int = &x.Count; _ = p }\n")
	return expectNoErrors(c)
}

func TestCheckTypeDecl() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"test\"\n")
	cb.Write("type Point struct { X int; Y int }\n")
	cb.Write("func f() { var p Point; p.X = 1 }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// inc/dec on a const is rejected (it has no storage to mutate), like
// assignment / compound-assignment / &C.  Without this the checker accepted
// `C++` and, once a local const is materialized into a slot, ++/-- mutated
// the const at runtime.
func TestIncDecOnConstRejected() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"func f() { const C int = 5; C++ }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// `type A B; type B A` (a cyclic named type) has no well-defined underlying.
// collectTypeDecl rejects it with a clear diagnostic rather than letting the
// later ==/< operand-comparability walk hang / stack-overflow.  CR-2 Plan-1
// Round-2.
func TestCheckCyclicTypeDefRejected() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"type A B\n"
		"type B A\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A self-cyclic type `type A A` is likewise rejected.
func TestCheckSelfCyclicTypeDefRejected() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"type A A\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}
