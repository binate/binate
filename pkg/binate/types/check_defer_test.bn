package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Checker tests for defer statements (§14.13): stmt.defer (enclosing function),
// stmt.defer.call (operand must be a call), stmt.defer.no-loop.

// A defer of a plain function call inside a function is accepted.
func TestCheckDeferCallOK() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g() {}\nfunc f() { defer g() }\n")
	return expectNoErrors(c)
}

// A conditional defer (`if cond { defer g() }`) is accepted — the core Go idiom.
func TestCheckDeferConditionalOK() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g() {}\n"
					"func f(cond bool) { if cond { defer g() } }\n")
	return expectNoErrors(c)
}

// A defer nested in an if/switch/block (but NOT in a loop) is accepted.
func TestCheckDeferNestedBlockOK() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g() {}\n"
					"func f() { { { defer g() } } }\n")
	return expectNoErrors(c)
}

// A defer inside a function literal that is itself inside a loop is accepted —
// the defer belongs to the literal, not the loop (stmt.defer.no-loop).
func TestCheckDeferInLiteralInLoopOK() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g() {}\n"
					"func f() { for i := 0; i < 3; i = i + 1 { "
					"var h @func() = func() { defer g() }; h() } }\n")
	return expectNoErrors(c)
}

// stmt.defer.call: a non-call operand is rejected.
func TestCheckDeferNonCallRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f() { defer 1 + 1 }\n")
	return expectErrSub(c, "defer requires a function, method, or "
			"function-value call")
}

// stmt.defer.call: a builtin keyword form (make/cast/sizeof/…) is a special call
// shape, not a call, and is rejected.
func TestCheckDeferBuiltinRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc f() { defer sizeof(int) }\n")
	return expectErrSub(c, "defer requires a function, method, or "
			"function-value call")
}

// stmt.defer.no-loop: a defer lexically inside a for loop is rejected.
func TestCheckDeferInLoopRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g() {}\n"
					"func f() { for i := 0; i < 3; i = i + 1 { defer g() } }\n")
	return expectErrSub(c, "defer may not appear in a loop")
}

// stmt.defer.no-loop: a defer nested in an if inside a for is still rejected
// (nested non-literal blocks do not lift the loop restriction).
func TestCheckDeferInLoopNestedRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g() {}\n"
					"func f() { for i := 0; i < 3; i = i + 1 { "
					"if i > 0 { defer g() } } }\n")
	return expectErrSub(c, "defer may not appear in a loop")
}

// stmt.defer.no-loop: a for-in loop is covered too.
func TestCheckDeferInForInRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc g() {}\n"
					"func f(xs *[]int) { for _, x := range xs { defer g() } }\n")
	return expectErrSub(c, "defer may not appear in a loop")
}

// stmt.defer: a bare defer in the REPL's immediate mode (no enclosing function)
// is rejected.
func TestCheckDeferImmediateModeRejected() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nfunc g() {}\n")
	var pst @parser.Parser = parser.New(toBytes("defer g()"), "<repl>")
	var ss @[]@ast.Stmt = pst.ParseStmtList()
	c.CheckStmtListInScope(ss)
	return expectErrSub(c, "defer requires an enclosing function")
}
