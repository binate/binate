package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"
import "pkg/stdx/slices"

// Deferring generic-instantiation constraint checks during batch collection, and
// replaying them once every impl is recorded.
//
// A generic instantiation is constraint-checked the moment a signature naming it
// is resolved.  During collection that would consult an INCOMPLETE c.Impls (impls
// are recorded inline by collectDeclsBody), so an instantiation whose type-arg's
// `impl` is declared later would be wrongly rejected — top-level decls are
// order-independent.  collectDecls therefore sets Checker.CollectingDecls, which
// makes instantiateGenericDeclWithArgs resolve instantiations non-user-facing
// (built and cached for identity, the check skipped and left unlatched) and record
// the deferred check here.  recheckDeferredConstraints then replays each recorded
// check after every impl is recorded.
//
// Recording the exact deferred (decl, args, pos) — rather than re-walking the decl
// list by kind and re-resolving "the type expressions that can name a generic" —
// is what makes the replay COMPLETE.  Enumerating by decl kind repeatedly missed
// use-site shapes (a type alias or named-distinct wrapper over an instantiation,
// an interface extension parent or alias target, a generic-receiver method
// signature); the pending list captures whatever was actually deferred, so nothing
// is dropped.

// recordPendingConstraintCheck notes that the constraint check for instantiation
// (d, args) requested at usePos was deferred; recheckDeferredConstraints replays
// it.  Called from instantiateGenericDeclWithArgs on every user-facing resolution
// while CollectingDecls is set.
func recordPendingConstraintCheck(c @Checker, d @ast.Decl, args @[]@Type, usePos token.Pos) {
	var p @PendingConstraintCheck = make(PendingConstraintCheck)
	p.Decl = d
	p.Args = args
	p.Pos = usePos
	c.PendingChecks = slices.Append[@PendingConstraintCheck](c.PendingChecks, p)
}

// recheckDeferredConstraints replays every constraint check deferred during the
// batch collection, now that collectDeclsBody has recorded every impl.  Each entry
// fires at most once (ConstraintsChecked latches, and identical diagnostics dedup
// by position/message), reporting a genuine miss at the recorded use site against
// the complete impl set.  Mirrors the firing instantiateGenericDeclWithArgs does
// for a first user-facing use, including the interface-method sizing check.  Runs
// once at the end of collectDecls, then clears the list for the next package.
func recheckDeferredConstraints(c @Checker) {
	for i := 0; i < len(c.PendingChecks); i++ {
		var p @PendingConstraintCheck = c.PendingChecks[i]
		if p == nil {
			continue
		}
		var entry @GenericInstantiation = lookupCachedInstantiationEntry(c, p.Decl, p.Args)
		if entry == nil || entry.ConstraintsChecked {
			continue
		}
		entry.ConstraintsChecked = true
		checkInstantiationConstraints(c, p.Decl, p.Args, p.Pos)
		if entry.Result != nil && entry.Result.Kind == TYP_INTERFACE {
			requireInstantiatedIfaceMethodsSized(c, entry.Result, p.Pos)
		}
	}
	var empty @[]@PendingConstraintCheck
	c.PendingChecks = empty
}
