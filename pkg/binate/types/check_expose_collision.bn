package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/std/strings"
import "pkg/stdx/slices"

// `expose` collision checking: reject a name surfaced through this package's
// `expose` declarations that clashes with another expose or with the package's
// own exported declaration.

// checkExposeCollisions reports a name reachable through this package's `expose`
// declarations that collides — either with a name surfaced by ANOTHER `expose`
// (two forwarders re-exporting the same name), or with one of THIS package's own
// exported declarations.
//
// It runs over each exposed package's exported-surface names — its RAW registered
// Syms list plus its generic type/interface decls (which have no scope symbol) —
// not this package's post-injection scope, which Scope.Define has already
// collapsed to a single survivor per name (so the collision is otherwise silent),
// plus the own-declaration names from `merged`.  There is no two-position facility,
// so a collision is one message naming BOTH origins by full path, positioned at
// the offending `expose` declaration.  Runs only for the real compilation target
// (its caller is gated on checkBodies), so a decls-only dependency's own clash is
// reported when that package is compiled directly, not smeared onto importers.
func checkExposeCollisions(c @Checker, merged @ast.File, bni @ast.File) {
	if bni == nil { return }
	var ownNames @[]@[]char
	if merged != nil {
		ownNames = collectDeclNames(merged.Decls)
	}
	var processed @[]@[]char // exposed paths already handled (dedup a doubled expose)
	var seenNames @[]@[]char // names surfaced by an earlier expose
	var seenOrigins @[]@[]char // the exposed package that first surfaced each seenNames entry
	for i := 0; i < len(bni.Decls); i++ {
		var d @ast.Decl = bni.Decls[i]
		if d.Kind != ast.DECL_EXPOSE { continue }
		var bPath @[]char = stripQuotes(d.Name)
		if nameInSlice(processed, bPath) { continue }
		processed = slices.Append[@[]char](processed, bPath)
		var bNames @[]@[]char = collectExposedSurfaceNames(c, bPath)
		for j := 0; j < len(bNames); j++ {
			var name @[]char = bNames[j]
			if len(name) == 0 { continue }
			// Case 2: collides with this package's own exported declaration.
			if nameInSlice(ownNames, name) {
				addCheckError(c, d.Pos, exposeVsOwnMsg(name, bPath))
			}
			// Case 1: collides with a name surfaced by an earlier expose.
			var idx int = indexOfName(seenNames, name)
			if idx >= 0 {
				addCheckError(c, d.Pos, twoExposesMsg(name, seenOrigins[idx], bPath))
			} else {
				seenNames = slices.Append[@[]char](seenNames, name)
				seenOrigins = slices.Append[@[]char](seenOrigins, bPath)
			}
		}
	}
}

// collectExposedSurfaceNames returns the names in package `path`'s exported
// surface: its scope symbols (skipping SYM_PKG import aliases) PLUS its generic
// type / interface decls, which have no scope symbol and so live only in the
// GenericTypeDecls/GenericIfaceDecls registries.  Without the generic names a
// collision between two exposed generics of the same name would go silently
// undiagnosed (Scope.Define collapses the injected markers to one survivor),
// unlike the non-generic case.
// The names are DEDUPED: a package's exported surface has each name at most
// once, but a generic decl can appear more than once in the GenericTypeDecls/
// GenericIfaceDecls registries (a package processed for both its `.bni` and its
// merged `.bn` stashes it each time), so an undeduped scan would surface a name
// twice and self-collide.  Deduping a single package's own names cannot mask a
// REAL collision, which is between DISTINCT exposed packages (checked via the
// caller's cross-`expose` seenNames).
func collectExposedSurfaceNames(c @Checker, path *[]readonly char) @[]@[]char {
	var names @[]@[]char
	var s @Scope = lookupPackage(c, path)
	if s != nil {
		for j := 0; j < len(s.Syms); j++ {
			if s.Syms[j].Kind == SYM_PKG { continue }
			if len(s.Syms[j].Name) == 0 { continue }
			if nameInSlice(names, s.Syms[j].Name) { continue }
			names = slices.Append[@[]char](names, s.Syms[j].Name)
		}
	}
	for i := 0; i < len(c.GenericTypeDecls) && i < len(c.GenericTypeDeclPkgs); i++ {
		if charEq(c.GenericTypeDeclPkgs[i], path) && !nameInSlice(names, c.GenericTypeDecls[i].Name) {
			names = slices.Append[@[]char](names, c.GenericTypeDecls[i].Name)
		}
	}
	for i := 0; i < len(c.GenericIfaceDecls) && i < len(c.GenericIfaceDeclPkgs); i++ {
		if charEq(c.GenericIfaceDeclPkgs[i], path) && !nameInSlice(names, c.GenericIfaceDecls[i].Name) {
			names = slices.Append[@[]char](names, c.GenericIfaceDecls[i].Name)
		}
	}
	return names
}

// indexOfName returns the index of `n` in `names`, or -1.
func indexOfName(names @[]@[]char, n *[]readonly char) int {
	for i := 0; i < len(names); i++ {
		if charEq(names[i], n) { return i }
	}
	return -1
}

// twoExposesMsg: a name re-exported by two distinct `expose` targets.  Full
// paths (b1/b2 are keyed by full path — two packages with a coinciding last
// segment are distinct surfaces, so disambiguate).
func twoExposesMsg(name @[]char, b1 @[]char, b2 @[]char) @[]char {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write(name)
	sb.Write(": exposed by both \"")
	sb.Write(b1)
	sb.Write("\" and \"")
	sb.Write(b2)
	sb.Write("\"")
	return buf.CopyStr(sb.String())
}

// exposeVsOwnMsg: an exposed name that collides with this package's own decl.
func exposeVsOwnMsg(name @[]char, b @[]char) @[]char {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write(name)
	sb.Write(": exposed by \"")
	sb.Write(b)
	sb.Write("\" conflicts with this package's own declaration of the same name")
	return buf.CopyStr(sb.String())
}
