package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/bignum"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"

// ============================================================
// Expression Checking
// ============================================================

// checkExpr type-checks an expression, registers its type, and returns it.
func checkExpr(c @Checker, e @ast.Expr) @Type {
	if e == nil {
		return TypVoid()
	}

	var t @Type = checkExprInner(c, e)
	e.ResolvedTypeID = registerExprType(c, t)
	return t
}

// checkExprWithFVHint is checkExpr with a transient function-value
// type hint installed on the Checker.  Used by VarDecl / return /
// call-arg sites so a child function-literal whose signature matches
// the hint can resolve as the hint's flavour (@func or *func) rather
// than the default raw form.  Restores the previous hint on exit;
// non-FUNC_VALUE / non-MANAGED_FUNC_VALUE hints are ignored to keep
// the propagation narrowly targeted at the literal-resolution
// decision in checkFuncLit.  B.3b of plan-function-values-phase-2.md.
func checkExprWithFVHint(c @Checker, e @ast.Expr, hint @Type) @Type {
	var prev @Type = c.ExpectedFVType
	if hint != nil && (hint.Kind == TYP_FUNC_VALUE ||
			hint.Kind == TYP_MANAGED_FUNC_VALUE ||
			namedUnderlyingIsFuncValue(hint)) {
		c.ExpectedFVType = hint
	}
	var t @Type = checkExpr(c, e)
	c.ExpectedFVType = prev
	return t
}

// namedUnderlyingIsFuncValue reports whether t is a NAMED type whose
// (peeled) underlying is a func-value type -- `type Fn @func(...)` /
// `type Fn *func(...)`.  Such a hint is installed so a func LITERAL assigned
// into the nominal Fn (`var f Fn = func(...){...}`) can resolve as Fn rather
// than a bare @func/*func that isn't Identical to it (checkFuncLit).
func namedUnderlyingIsFuncValue(t @Type) bool {
	if t == nil || t.Kind != TYP_NAMED { return false }
	var u @Type = peelNamedBounded(t)
	return u != nil && (u.Kind == TYP_FUNC_VALUE ||
		u.Kind == TYP_MANAGED_FUNC_VALUE)
}

// checkExprInner dispatches expression checking by expression kind.
func checkExprInner(c @Checker, e @ast.Expr) @Type {
	if e.Kind == ast.EXPR_IDENT {
		return checkIdent(c, e)
	}
	if e.Kind == ast.EXPR_INT_LIT {
		// Parse the literal and carry its mathematical value on the
		// returned TYP_UNTYPED_INT so AssignableTo can fit-check
		// against the target type's range (e.g. `var x uint8 = 256`
		// rejects; `var x uint8 = 255` accepts).  Out-of-range
		// magnitude is reported here; we still return a value-bearing
		// type so downstream checks see something self-consistent.
		// claude-notes.md § "Integer literal value range and
		// constant-expression arithmetic — DECIDED 2026-05-15".
		var n bignum.Num
		var ok bool
		n, ok = bignum.ParseLiteral(e.Name)
		if !ok {
			addCheckError(c, e.Pos, "integer literal out of range")
		}
		var t @Type = make(Type)
		t.Kind = TYP_UNTYPED_INT
		t.Name = TypUntypedInt().Name
		t.HasLitVal = true
		t.LitMag = n.Magnitude
		t.LitSign = n.Sign
		return t
	}
	if e.Kind == ast.EXPR_FLOAT_LIT {
		return TypUntypedFloat()
	}
	if e.Kind == ast.EXPR_STRING_LIT {
		checkStrLitEscapes(c, e.Name, e.Pos)
		return StringLitNaturalType(e.Name)
	}
	if e.Kind == ast.EXPR_CHAR_LIT {
		checkCharLitEscapes(c, e.Name, e.Pos)
		return TypChar()
	}
	if e.Kind == ast.EXPR_BOOL_LIT {
		return TypUntypedBool()
	}
	if e.Kind == ast.EXPR_NIL_LIT {
		return TypNil()
	}
	if e.Kind == ast.EXPR_BINARY {
		return checkBinaryExpr(c, e)
	}
	if e.Kind == ast.EXPR_UNARY {
		return checkUnaryExpr(c, e)
	}
	if e.Kind == ast.EXPR_CALL {
		return checkCallExpr(c, e)
	}
	if e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		return checkInstantiateOrIndex(c, e)
	}
	if e.Kind == ast.EXPR_SLICE {
		return checkSliceExpr(c, e)
	}
	if e.Kind == ast.EXPR_SELECTOR {
		return checkSelectorExpr(c, e)
	}
	if e.Kind == ast.EXPR_COMPOSITE {
		return checkCompositeLit(c, e)
	}
	if e.Kind == ast.EXPR_BUILTIN {
		return checkBuiltinCall(c, e)
	}
	if e.Kind == ast.EXPR_FUNC_LIT {
		return checkFuncLit(c, e)
	}
	if e.Kind == ast.EXPR_TYPE {
		// EXPR_TYPE only belongs as a generic-instantiation type
		// argument (consumed by typeArgFromExpr, not checkExpr).
		// Reaching here means a type form was used in value
		// position — e.g. `arr[@T]` where `arr` isn't a generic
		// function, so the index fallback checked the arg as an
		// expression.
		addCheckError(c, e.Pos,
			"type not valid in expression position")
		return TypVoid()
	}

	addCheckError(c, e.Pos, "unexpected expression")
	return TypVoid()
}

// checkIdent resolves an identifier to its type via scope lookup (handles iota).
// The blank identifier `_` resolves to void — it's not a defined name, and
// the surrounding context (assign/var-decl LHS) is responsible for treating
// it as a write-only sink. Reading `_` as an rvalue is still an error (no
// name in scope, but we skip the errUndefined noise for `_`).
//
// Tier 3 forward refs: when resolving outside TentativeMode, an
// identifier that looks up to a still-pending function is an
// error — its body hasn't been IR-gen'd, so any use would fail
// at runtime.  Surface a clear "function X is unresolved
// (pending: ...)" message instead of letting the runtime hit
// "extern not found" later.  Inside TentativeMode (a body-check
// pass for another decl), pending funcs are NOT errored — their
// sig is in scope, that's enough for the tentative pass.
func checkIdent(c @Checker, e @ast.Expr) @Type {
	if charEq(e.Name, "iota") && c.Iota >= 0 {
		// Carry iota's value as HasLitVal so the const-fold paths
		// (foldIntArith / foldIntBitwise) can fold an expression that
		// CONTAINS iota — `1 << iota`, `iota + N` — to a compile-time
		// value.  A bare TYP_UNTYPED_INT (no LitVal) makes the fold
		// short-circuit to commonType, leaving a bit-flag const's
		// compile-time value wrong/absent (array dims, narrow-type
		// overflow checks).  Runtime values were already correct via
		// IR-gen's evalConstExpr; this aligns the checker.
		return makeUntypedIntWithLit(c.Iota)
	}
	if isBlank(e.Name) {
		return TypVoid()
	}
	var sym @Symbol = c.Scope.Lookup(e.Name)
	if sym == nil {
		// Every package has a compiler-synthesized `__Package()
		// @reflect.Package` accessor (Phase B of notes-package-
		// introspection.md).  It is not declared in any .bni, so an
		// UNQUALIFIED reference to the current package's own accessor
		// resolves here — mirroring checkSelectorExpr's qualified
		// `pkg.__Package` special case (check_expr_access.bn).
		if charEq(e.Name, "__Package") {
			var accTyp @Type = packageAccessorType(c)
			if accTyp != nil { return accTyp }
		}
		errUndefined(c, e.Pos, e.Name)
		return TypVoid()
	}
	if !c.TentativeMode && c.IsPendingDecl(e.Name) {
		errPendingDecl(c, e.Pos, e.Name)
		// Return the real symbol type so cascading checks
		// (call/arity/return for funcs; assignability for vars
		// and consts) don't add noise on top of the pending
		// error.  IR-gen / lowering won't run because the
		// surrounding stmt-list / decl errored.
		return sym.Type
	}
	// Capture analysis (B.1 of plan-function-values-phase-2.md):
	// inside a function-literal body, an Ident resolved past the
	// literal's BodyScope is a capture.  No-op when the capture
	// stack is empty.
	noteCaptureIfNeeded(c, sym, e.Name, e.Pos)
	return sym.Type
}

// errPendingDecl reports an "X Y is unresolved (pending: ...)"
// type error with the still-missing names pulled from the
// pending entry.  X is the decl-kind noun (function / variable
// / constant); the wording matches the rest of the language's
// error vocabulary.  Pulled per-kind so users get the right
// mental model — "variable x is unresolved" suggests redefining
// the missing name, not "calling foo before it's defined."
func errPendingDecl(c @Checker, pos token.Pos, name *[]readonly char) {
	var pd @PendingDecl = lookupPending(c, name)
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(pendingDeclKindNoun(pd))
	cb.Write(" ")
	cb.Write(name)
	cb.Write(" is unresolved (pending: ")
	if pd != nil {
		for i := 0; i < len(pd.MissingNames); i++ {
			if i > 0 { cb.Write(", ") }
			cb.Write(pd.MissingNames[i])
		}
	}
	cb.Write(")")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// pendingDeclKindNoun returns the user-facing noun for a
// parked decl's kind ("function" / "variable" / "constant").
// Falls back to "function" if the pending entry is nil —
// shouldn't happen in practice, but keeps the error well-
// formed.  Stage 1 (c) of plan-repl-tier3-pending-types.md
// switched group parking from atomic to per-member, so the
// DECL_GROUP case no longer arises here — each member is its
// own DECL_CONST PendingDecl.
func pendingDeclKindNoun(pd @PendingDecl) @[]char {
	if pd != nil {
		if pd.Decl.Kind == ast.DECL_VAR { return "variable" }
		if pd.Decl.Kind == ast.DECL_CONST { return "constant" }
		if pd.Decl.Kind == ast.DECL_TYPE { return "type" }
	}
	return "function"
}

// lookupPending returns the PendingDecl for `name` from
// c.Pending, or nil if not parked.  Matches any scope-name
// decl kind (free func, var, const, or type); methods are
// excluded — their resolution path is the receiver type's
// method set, not name lookup.
func lookupPending(c @Checker, name *[]readonly char) @PendingDecl {
	for i := 0; i < len(c.Pending); i++ {
		var pd @PendingDecl = c.Pending[i]
		if pd.Decl.Recv != nil { continue }
		if pd.Decl.Kind != ast.DECL_FUNC &&
				pd.Decl.Kind != ast.DECL_VAR &&
				pd.Decl.Kind != ast.DECL_CONST &&
				pd.Decl.Kind != ast.DECL_TYPE {
			continue
		}
		if charEq(pd.Decl.Name, name) { return pd }
	}
	return nil
}

// isBlank reports whether name is the blank identifier ("_").
func isBlank(name *[]readonly char) bool {
	return len(name) == 1 && name[0] == '_'
}

// isVariadicBuiltinCall reports whether e is a call to one of the
// empty-parameter variadic builtins (print / println / panic), which —
// unlike a user `func f()` — legitimately accept extra arguments.  These
// are defined in the universe scope as plain zero-param func types
// (scope.bn), so the only distinguishing signal at the call site is the
// callee name (mirrors isPanicCall in check_decl_func.bn).
func isVariadicBuiltinCall(e @ast.Expr) bool {
	if e == nil || e.X == nil { return false }
	if e.X.Kind != ast.EXPR_IDENT { return false }
	return charEq(e.X.Name, "print") || charEq(e.X.Name, "println") ||
		charEq(e.X.Name, "panic")
}

// errSpreadIntoBuiltin reports a spread (`expr...`) onto one of the empty-param
// builtins (print / println / panic).  These are heterogeneous, not
// user-variadic (their param list is empty, §15.7), so a spread has no `...T`
// element type to forward into — it is rejected by name (func.variadic.spread).
func errSpreadIntoBuiltin(c @Checker, pos token.Pos, name @[]char) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("cannot spread into ")
	cb.Write(name)
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// checkCallExpr type-checks a function call, validating argument count and
// types.  Method calls (`obj.M(args)`) are detected first when the callee is
// a selector expression — see tryMethodCall in check_method.bn.  If it
// returns nil, e is not a method call and we fall back to the regular
// function-call path.  (Stage 3 of plan-receivers.md.)
func checkCallExpr(c @Checker, e @ast.Expr) @Type {
	if e.X != nil && e.X.Kind == ast.EXPR_SELECTOR {
		var mtype @Type = tryMethodCall(c, e)
		if mtype != nil {
			// Spread (`obj.M(x...)`) into a method is handled by the method-call
			// binding sites themselves (checkResolvedMethodCall / interface /
			// generic): a variadic method binds the spread, a non-variadic one
			// rejects it.  Not gated here — that would wrongly reject a valid
			// spread into a variadic method.
			return mtype
		}
	}

	// Peel a named func-value type (`type Fn @func(...)`) to its underlying
	// func value so a value of the named type is callable and the param /
	// result lists below read from the underlying.  peelNamedBounded also
	// resolves alias / readonly wrappers; a non-func type peels to itself
	// (or to nil for a cyclic named type) and still fails the kind check.
	var fnType @Type = peelNamedBounded(checkExpr(c, e.X))
	if fnType == nil ||
		(fnType.Kind != TYP_FUNC &&
		 fnType.Kind != TYP_FUNC_VALUE &&
		 fnType.Kind != TYP_MANAGED_FUNC_VALUE) {
		addCheckError(c, e.X.Pos, "cannot call non-function")
		return TypVoid()
	}
	// A generic function requires explicit type arguments — Binate
	// has no inference (claude-notes.md § "Generics — DECIDED").
	// Callers must use the `f[T](args)` form, which lands in
	// checkInstantiateOrIndex (Slice 2+'s eventual home for
	// instantiation).
	if fnType.Kind == TYP_FUNC && len(fnType.TypeParams) > 0 {
		addCheckError(c, e.Pos,
			"generic function requires type arguments — use f[T](...)")
		return TypVoid()
	}

	// The heterogeneous builtins (print / println) have empty param lists.
	var numParams int = len(fnType.Params)
	var numResults int = len(fnType.Results)
	var numArgs int = len(e.Args)

	// panic takes exactly one (string) message argument — unlike the genuinely
	// variadic print / println.  genPanicCall materializes that single arg for
	// rt.Panic(*[]readonly char); arbitrary args / value-formatting are gone.
	if isPanicCall(e) && numArgs != 1 {
		addCheckError(c, e.Pos, "panic takes exactly one argument")
	}

	// A spread argument (`expr...`) is valid ONLY into a user-defined variadic
	// callee.  Rejecting it here — BEFORE the binding branches — is what keeps the
	// numParams==0 bypass below from silently accepting `println(x...)` and keeps a
	// non-variadic callee from binding the spread operand as an ordinary argument.
	// A valid spread into a variadic callee flows to checkVariadicCallBinding.
	if e.Spread && !funcIsVariadic(fnType) {
		if isVariadicBuiltinCall(e) {
			errSpreadIntoBuiltin(c, e.X.Pos, e.X.Name)
		} else {
			addCheckError(c, e.Pos, "cannot spread into non-variadic function")
		}
		for i := 0; i < numArgs; i++ {
			checkExpr(c, e.Args[i])
		}
	} else if numParams == 0 && numArgs > 0 {
		// Only the variadic builtins (print / println / panic) accept extra
		// args with an empty parameter list.  A user `func f()` called as
		// `f(1, 2)` is "too many arguments" — without this gate every
		// zero-param function silently accepted and discarded extra args.
		// The args are still checked below so their own errors surface.
		if !isVariadicBuiltinCall(e) {
			addCheckError(c, e.Pos, "too many arguments")
		}
		for i := 0; i < numArgs; i++ {
			checkExpr(c, e.Args[i])
		}
	} else if funcIsVariadic(fnType) {
		checkVariadicCallBinding(c, e, fnType.Params)
	} else if numArgs != numParams {
		addCheckError(c, e.Pos, "wrong number of arguments")
	} else {
		// Each arg is type-checked with the matching declared param
		// type installed as the function-value hint, so a function-
		// literal arg whose signature matches the declared param
		// resolves as the declared flavour (@func or *func) rather
		// than the raw form.  Without this, `g(func() { ... })` for
		// `g(f @func())` would resolve the literal as `*func()` and
		// stack-allocate the closure — losing the heap-managed
		// lifetime @func promises.  B.3b of plan-function-values-
		// phase-2.md.
		for i := 0; i < numArgs; i++ {
			var at @Type = checkExprWithFVHint(c, e.Args[i],
				fnType.Params[i].Type)
			if !at.AssignableTo(c, fnType.Params[i].Type) {
				errCannotAssign(c, e.Args[i].Pos, at, fnType.Params[i].Type)
			}
		}
	}

	if numResults == 0 {
		return TypVoid()
	}
	if numResults == 1 {
		// A call MATERIALIZES its result as a value, so a by-value opaque (or
		// cross-package opaque-export) return is rejected here.  A handle return
		// (`@Box` / `*Box`) is fine — requireSizedType no-ops on it.  This is why
		// a provider exporting `func MakeBox() Box` is useless to an importer
		// (bug 211); a `var x = f()` / `x := f()` / bare `f()` all flow through
		// this single result.
		requireSizedType(c, fnType.Results[0], e.Pos)
		return fnType.Results[0]
	}
	// Multiple returns — return the FuncType for multi-assign detection
	return fnType
}

// checkVariadicCallBinding binds a call's arguments to a variadic callee
// (func.call.apply / func.variadic.pack): the leading `k` arguments bind to the
// `k` fixed parameters positionally, and the zero-or-more trailing arguments each
// bind to the variadic parameter's ELEMENT type `T` (the *[]T body type's
// element).  A valid individual-arg call therefore has `numArgs >= k`.  A spread
// call (`expr...`, func.variadic.spread) instead forwards a single slice operand
// and is bound by checkSpreadCallBinding.
// `params` is the callee's PARAMETER list with the last entry variadic —
// receiver already dropped for a method call, so the same binder serves
// free-function, method, interface-method, and generic-constraint-method calls.
func checkVariadicCallBinding(c @Checker, e @ast.Expr, params *[]@Param) {
	var numParams int = len(params)
	var k int = numParams - 1
	var numArgs int = len(e.Args)
	if e.Spread {
		checkSpreadCallBinding(c, e, params, k)
		return
	}
	if numArgs < k {
		addCheckError(c, e.Pos, "wrong number of arguments")
		for i := 0; i < numArgs; i++ { checkExpr(c, e.Args[i]) }
		return
	}
	// Bind the k fixed parameters positionally.
	for i := 0; i < k; i++ {
		var at @Type = checkExprWithFVHint(c, e.Args[i], params[i].Type)
		if !at.AssignableTo(c, params[i].Type) {
			errCannotAssign(c, e.Args[i].Pos, at, params[i].Type)
		}
	}
	// Each trailing argument binds to the variadic element type T.
	var elemTyp @Type = params[k].Type.SliceElem()
	if elemTyp == nil {
		elemTyp = params[k].Type
	}
	for i := k; i < numArgs; i++ {
		var at @Type = checkExprWithFVHint(c, e.Args[i], elemTyp)
		if !at.AssignableTo(c, elemTyp) {
			errCannotAssign(c, e.Args[i].Pos, at, elemTyp)
		}
	}
}

// checkSpreadCallBinding binds a spread call `f(fixed…, s...)`
// (func.variadic.spread): the `k` fixed parameters bind positionally and the
// single trailing operand `s` — the whole `*[]T` variadic argument, not one
// element — must be a slice assignable to the variadic body type *[]T.  A spread
// supplies EXACTLY one operand, so a valid spread call has exactly `k+1` args
// (fewer = unfilled fixed params; more = a spread mixed with individual variadic
// args, D-F ‡).  The callee-is-variadic and callee-is-not-a-builtin guards live
// in checkCallExpr, so a spread that reaches here always has a variadic callee.
func checkSpreadCallBinding(c @Checker, e @ast.Expr, params *[]@Param, k int) {
	var numArgs int = len(e.Args)
	if numArgs != k + 1 {
		addCheckError(c, e.Pos, "wrong number of arguments")
		for i := 0; i < numArgs; i++ { checkExpr(c, e.Args[i]) }
		return
	}
	// Bind the k fixed parameters positionally (identical to the pack path).
	for i := 0; i < k; i++ {
		var at @Type = checkExprWithFVHint(c, e.Args[i], params[i].Type)
		if !at.AssignableTo(c, params[i].Type) {
			errCannotAssign(c, e.Args[i].Pos, at, params[i].Type)
		}
	}
	// The spread operand must be a SLICE by KIND — checked BEFORE AssignableTo.
	// AssignableTo alone is not sufficient: it accepts a `[N]readonly char` array
	// (and hence every string literal, which has array type) as assignable to a
	// char slice via the string-literal decay arm, so without this gate
	// `f("abc"...)` and any bare-array spread would be wrongly accepted.  A bare
	// array must be sub-sliced first (`arr[:]...`; a string literal `lit[:]...`).
	// Peel with peelNamedBounded (named + alias + readonly) — NOT
	// resolveAliasAndConst, which leaves a named-distinct slice type (`type Buf
	// @[]T`) as TYP_NAMED and wrongly rejects `f(buf...)` even though its
	// underlying @[]T is assignable to *[]T (and IR-gen already peels it via
	// peelTransparent).  A bare array still peels to TYP_ARRAY and is rejected.
	// The variadic body type params[k].Type is the raw *[]T, so AssignableTo
	// against it gives the @[]T->*[]T decay plus the element-readonly lattice for
	// free (no hand-rolled element comparison).
	var sliceTyp @Type = params[k].Type
	var operand @Type = checkExpr(c, e.Args[k])
	var peeled @Type = peelNamedBounded(operand)
	if peeled == nil ||
			(peeled.Kind != TYP_SLICE && peeled.Kind != TYP_MANAGED_SLICE) {
		addCheckError(c, e.Args[k].Pos,
			"cannot spread non-slice argument (sub-slice an array with a[:])")
		return
	}
	if !operand.AssignableTo(c, sliceTyp) {
		errCannotAssign(c, e.Args[k].Pos, operand, sliceTyp)
	}
}
