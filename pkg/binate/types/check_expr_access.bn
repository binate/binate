package "pkg/binate/types"

import "pkg/binate/ast"

// Type checking for access-shape expressions: index / instantiate-or-
// index, slice, and selector.  Extracted from check_expr.bn to keep
// that file under the hygiene soft-length cap.  Binary / unary / call
// dispatch stays in check_expr.bn alongside the top-level checkExpr
// entry point.

// checkInstantiateOrIndex dispatches an EXPR_INSTANTIATE_OR_INDEX
// node.  When the head resolves to a generic function, treats the
// brackets as generic instantiation (Slice 2b of
// plan-generics.md); otherwise falls back to value indexing.
//
// Cross-package generic instantiation (Slice 7) — e.X may also be
// EXPR_SELECTOR `pkg.Name`; look up Name in the imported package's
// scope.
func checkInstantiateOrIndex(c @Checker, e @ast.Expr) @Type {
	// Generic-instantiation interpretation, available only when the
	// head is a bare identifier or a package-qualified selector
	// resolving to a generic FUNC symbol.
	if e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		var sym @Symbol = c.Scope.Lookup(e.X.Name)
		if sym != nil && sym.Kind == SYM_FUNC && sym.Type != nil &&
				len(sym.Type.TypeParams) > 0 {
			return instantiateGenericFunc(c, e, sym.Type)
		}
	}
	if e.X != nil && e.X.Kind == ast.EXPR_SELECTOR &&
			e.X.X != nil && e.X.X.Kind == ast.EXPR_IDENT {
		var pkgSym @Symbol = c.Scope.Lookup(e.X.X.Name)
		if pkgSym != nil && pkgSym.Kind == SYM_PKG {
			var pkgScope @Scope = lookupPackage(c, pkgSym.PkgPath)
			if pkgScope != nil {
				var sym @Symbol = pkgScope.Lookup(e.X.Name)
				if sym != nil && sym.Kind == SYM_FUNC &&
						sym.Type != nil &&
						len(sym.Type.TypeParams) > 0 {
					return instantiateGenericFunc(c, e, sym.Type)
				}
			}
		}
	}
	if len(e.Args) != 1 {
		addCheckError(c, e.Pos,
			"generic instantiation requires a generic function head")
		return TypVoid()
	}
	return checkIndexExpr(c, e)
}

// checkIndexExpr type-checks an index expression (slice, array, pointer, or string indexing).
// e.X is the collection; e.Args[0] is the index.
func checkIndexExpr(c @Checker, e @ast.Expr) @Type {
	var xt @Type = checkExpr(c, e.X)
	var idx @ast.Expr = e.Args[0]
	var idxType @Type = checkExpr(c, idx)
	if !idxType.IsInteger() {
		addCheckError(c, idx.Pos, "index must be integer")
	}

	// peelNamedBounded sees through alias / readonly / named-distinct wrappers
	// to the concrete underlying, so indexing works on a named slice/array/
	// pointer type (`type Buf @[]int; b[0]`) as well as the bare composite.
	xt = peelNamedBounded(xt)
	if xt == nil {
		return TypVoid()
	}
	if xt.Kind == TYP_SLICE || xt.Kind == TYP_MANAGED_SLICE || xt.Kind == TYP_ARRAY {
		return xt.Elem
	}
	if xt.Kind == TYP_POINTER {
		return xt.Elem
	}
	addCheckError(c, e.X.Pos, "cannot index this type")
	return TypVoid()
}

// checkSliceExpr type-checks a slice expression (x[lo:hi]).
func checkSliceExpr(c @Checker, e @ast.Expr) @Type {
	var xt @Type = checkExpr(c, e.X)
	// Z = lo, Y = hi in the AST
	if e.Z != nil {
		var lt @Type = checkExpr(c, e.Z)
		if !lt.IsInteger() {
			addCheckError(c, e.Z.Pos, "slice index must be integer")
		}
	}
	if e.Y != nil {
		var ht @Type = checkExpr(c, e.Y)
		if !ht.IsInteger() {
			addCheckError(c, e.Y.Pos, "slice index must be integer")
		}
	}

	// peelNamedBounded sees through alias / readonly / named-distinct wrappers
	// to the concrete underlying.  The outer readonly-ness (a property of the
	// storage handle) does not ride along to the fresh subslice value — only
	// element readonly-ness does, and that is carried by the underlying slice's
	// Elem.  Mirrors checkIndexExpr's peel.
	xt = peelNamedBounded(xt)
	if xt == nil {
		return TypVoid()
	}
	if xt.Kind == TYP_SLICE || xt.Kind == TYP_MANAGED_SLICE {
		return xt
	}
	if xt.Kind == TYP_ARRAY {
		return MakeSliceType(xt.Elem)
	}
	addCheckError(c, e.X.Pos, "cannot slice this type")
	return TypVoid()
}

// packageAccessorType returns the type of the compiler-synthesized
// `__Package()` accessor — `func() @reflect.Package` — or nil if
// pkg/builtins/reflect is not loaded (so the caller falls through to the
// normal undefined-member error).  Every package has a generated
// `__Package()` (Phase B of notes-package-introspection.md / codegen's
// emit_pkg_descriptor.bn); it is not declared in any .bni, so selector
// resolution synthesizes its type here.  reflect is force-loaded by the
// driver (ensureReflectLoaded), so the lookup normally succeeds.
func packageAccessorType(c @Checker) @Type {
	var reflectScope @Scope = lookupPackage(c, "pkg/builtins/reflect")
	if reflectScope == nil { return nil }
	var pkgSym @Symbol = reflectScope.Lookup("Package")
	if pkgSym == nil || pkgSym.Type == nil { return nil }
	var noParams @[]@Param
	var results @[]@Type = make_slice(@Type, 1)
	results[0] = MakeManagedPtrType(pkgSym.Type)
	return MakeFuncType(noParams, results)
}

// resolveQualifiedSym resolves a package-qualified selector `pkg.Name`
// to the package member's symbol (any kind), or nil if e is not such a
// selector — a struct-field access, or `pkg` not an imported package.
// Shared by the const-write rejections (`&pkg.C` in check_expr.bn,
// `pkg.C = v` in check_stmt.bn), which both gate on member.Kind ==
// SYM_CONST.
func resolveQualifiedSym(c @Checker, e @ast.Expr) @Symbol {
	if e == nil || e.Kind != ast.EXPR_SELECTOR { return nil }
	if e.X == nil || e.X.Kind != ast.EXPR_IDENT { return nil }
	var psym @Symbol = c.Scope.Lookup(e.X.Name)
	if psym == nil || psym.Kind != SYM_PKG { return nil }
	var pkgScope @Scope = lookupPackage(c, psym.PkgPath)
	if pkgScope == nil { return nil }
	return pkgScope.Lookup(e.Name)
}

// peelFieldAccessBase peels alias / readonly / named-distinct wrappers from t
// to the concrete base for field access, returning that base (nil if opaque
// nil-underlying or cyclic) and whether any `readonly` wrapper was crossed
// (object-const: a readonly path makes the reached fields read-only).
//
// A named-distinct type is transparent to its underlying for field access
// (`type H @Box; h.field` reaches Box's field — claude-notes.md "Type
// declarations"), so TYP_NAMED with a concrete Underlying is peeled.  An
// OPAQUE named type (TYP_NAMED with nil Underlying — e.g. a `.bni` forward
// `type Foo`) stays unpeeled: the bare TYP_NAMED is returned, and the caller
// rejects field access on it (encapsulation across the package boundary).
func peelFieldAccessBase(t @Type) (@Type, bool) {
	var konst bool = false
	var depth int = 0
	for t != nil && depth < 1024 {
		if t.Kind == TYP_ALIAS {
			t = t.Target
		} else if t.Kind == TYP_READONLY {
			konst = true
			t = t.Elem
		} else if t.Kind == TYP_NAMED && t.Underlying != nil {
			t = t.Underlying
		} else {
			return t, konst
		}
		depth = depth + 1
	}
	return nil, konst
}

// checkSelectorExpr type-checks a selector (x.Name), handling package access and struct fields.
func checkSelectorExpr(c @Checker, e @ast.Expr) @Type {
	// Check for package-qualified access: pkg.Name
	if e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		var sym @Symbol = c.Scope.Lookup(e.X.Name)
		if sym != nil && sym.Kind == SYM_PKG {
			var pkgScope @Scope = lookupPackage(c, sym.PkgPath)
			if pkgScope == nil {
				errUndefined(c, e.X.Pos, e.X.Name)
				return TypVoid()
			}
			var member @Symbol = pkgScope.Lookup(e.Name)
			if member == nil {
				// Every package has a compiler-synthesized
				// `__Package() @reflect.Package` accessor (Phase B of
				// notes-package-introspection.md).  It is not declared in
				// any .bni, so resolve it here rather than via the scope.
				if charEq(e.Name, "__Package") {
					var accTyp @Type = packageAccessorType(c)
					if accTyp != nil { return accTyp }
				}
				errUndefined(c, e.Pos, e.Name)
				return TypVoid()
			}
			return member.Type
		}
		// Method expression: T.M where T is a named type. The result
		// is a function value whose signature includes the method's
		// receiver as the first parameter (per the method's declared
		// receiver kind — value, *T, or @T). A.6 of plan-function-
		// values.md.
		if sym != nil && sym.Kind == SYM_TYPE {
			var t @Type = sym.Type
			var m @Method = t.LookupMethod(e.Name)
			if m == nil {
				errUndefined(c, e.Pos, e.Name)
				return TypVoid()
			}
			// m.FuncType already has the receiver baked in as Params[0].
			return MakeFuncValueType(m.FuncType.Params, m.FuncType.Results)
		}
	}

	var xt @Type = checkExpr(c, e.X)
	// Preserve the ORIGINAL receiver type before any auto-deref —
	// the method-value path below needs it to decide what shape
	// the capture takes (T, *T, @T).  Method lookup off origXt finds
	// the NAMED type's OWN method set — a named-distinct type does NOT
	// inherit its underlying's methods — so origXt must stay as-written.
	var origXt @Type = xt

	// Peel alias / readonly / named-distinct wrappers to the concrete
	// base, tracking whether any readonly was crossed (object-const).
	// A named-distinct type is field-transparent (`type H @Box; h.f`),
	// so the named wrapper is peeled BEFORE the auto-deref below.
	//
	// pathConst signals that the access path was const.  Writing
	// through a const access path is rejected at the assign site; we
	// signal it by propagating const onto the returned field type so
	// that `checkAssignStmt` observes outer-const on the LHS and rejects.
	var pathConst bool
	xt, pathConst = peelFieldAccessBase(xt)
	if xt == nil {
		return TypVoid()
	}

	// Auto-dereference a pointer base, peeling the pointee's own
	// wrappers too — the pointee may itself be a named struct (and the
	// pointee may be readonly, which makes the reached fields const).
	var elem @Type = xt.PointerElem()
	if elem != nil {
		var ec bool
		xt, ec = peelFieldAccessBase(elem)
		if ec {
			pathConst = true
		}
		if xt == nil {
			return TypVoid()
		}
	}

	// Struct field access — fields take precedence over methods of
	// the same name (Go convention; pins the existing behavior).
	if xt.Kind == TYP_STRUCT {
		var f @Field = xt.FieldByName(e.Name)
		if f != nil {
			if pathConst { return MakeReadonlyType(f.Type) }
			return f.Type
		}
	}

	// Method value (B.4 of plan-function-values-phase-2.md):
	// `x.M` where x is a value and M is a method on x's base type
	// is a function value whose signature is the method's
	// signature MINUS the receiver — the receiver is captured at
	// the selector site.  origXt is the receiver type as written
	// (T, *T, @T); IR-gen uses it to lay out the closure struct.
	var recvNamed @Type = origXt.ReceiverBaseNamed()
	if recvNamed != nil {
		var m @Method = recvNamed.LookupMethod(e.Name)
		if m != nil && m.FuncType != nil &&
				len(m.FuncType.Params) >= 1 {
			// Drop the receiver (Params[0]) to produce the user-
			// visible function-value type.
			var paramsNoRecv @[]@Param =
				make_slice(@Param, len(m.FuncType.Params) - 1)
			for i := 1; i < len(m.FuncType.Params); i++ {
				paramsNoRecv[i - 1] = m.FuncType.Params[i]
			}
			return MakeFuncValueType(paramsNoRecv,
				m.FuncType.Results)
		}
	}

	// Neither field nor method matched.  Distinguish "struct without
	// that field" (preserves the existing `undefined: <name>` message
	// that conformance tests pin) from "not a field-bearing type."
	// xt is the peeled base here, so a named-over-struct has already
	// been reduced to TYP_STRUCT; an opaque named type (nil Underlying)
	// reaches this point as the bare TYP_NAMED and falls to the generic
	// rejection, preserving cross-package encapsulation.
	if xt.Kind == TYP_STRUCT {
		errUndefined(c, e.Pos, e.Name)
		return TypVoid()
	}
	addCheckError(c, e.Pos, "cannot access field on this type")
	return TypVoid()
}
