package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Type-checker tests for access-shape expressions (instantiate-or-
// index, index, slice, selector).  Matches check_expr_access.bn.
// Tests that don't directly exercise an access-shape entry point
// (binary / unary / call / builtin) live in check_expr_test.bn.

// ============================================================
// Index expressions — checkInstantiateOrIndex / checkIndexExpr
// ============================================================

// Single-arg `[i]` form goes through checkIndexExpr.  s is a raw
// slice; s[0] is well-typed at int.
func TestCheckSliceIndex() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var s *[]int; var x int = s[0] }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Indexing a non-indexable type rejects.
func TestCheckIndexNonIndexable() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var n int; var x int = n[0] }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Non-integer index rejects.  Per `plan-generics.md` Slice 1 +
// checkIndexExpr's `idxType.IsInteger()` gate.
func TestCheckIndexNonIntegerIndex() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var s *[]int; var x int = s[true] }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Multi-arg bracketed form `name[T1, T2]` is the syntactic shape
// of a generic instantiation; Slice 1's checkInstantiateOrIndex
// rejects with "generic instantiation not yet supported."
func TestCheckMultiArgInstantiateRejected() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var s *[]int; var x int = s[0, 1] }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// ============================================================
// Slice expressions — checkSliceExpr
// ============================================================

// Basic two-bound slice on a *[]int — preserves slice type.
func TestCheckSliceExprTwoBounds() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var s *[]int; var t *[]int = s[1:3] }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Open lower bound (`s[:hi]`).
func TestCheckSliceExprOpenLo() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var s *[]int; var t *[]int = s[:2] }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Array-to-slice via slice expression: `arr[1:3]` on a `[4]int`
// is a `*[]int`.
func TestCheckSliceExprArrayToSlice() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func f() { var arr [4]int; var s *[]int = arr[1:3] }\n")
	var src *[]readonly char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Slicing a non-sliceable type (a plain int) rejects.
func TestCheckSliceExprNotSliceable() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var n int; var s *[]int = n[0:1] }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Non-integer hi-bound rejects.
func TestCheckSliceExprNonIntegerBound() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func f() { var s *[]int; var t *[]int = s[0:true] }\n")
	var src *[]readonly char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// ============================================================
// Selector expressions — checkSelectorExpr
// ============================================================

// Accessing a non-existent field rejects.
func TestCheckSelectorUndefined() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Point struct { X int }\n"
		"func f() { var p Point; p.Z = 1 }\n")
	var src *[]readonly char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Auto-deref through *T pointer to read a struct field.
func TestCheckSelectorAutoDeref() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Point struct { X int }\n"
		"func f() { var pp *Point; var x int = pp.X }\n")
	var src *[]readonly char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Accessing a field on a non-struct rejects.
func TestCheckSelectorOnNonStruct() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f() { var n int; var x int = n.foo }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}
