package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"

// ============================================================
// Binary-operator type checking
// ============================================================

// checkBinaryExpr type-checks a binary expression (both operands and the operator).
func checkBinaryExpr(c @Checker, e @ast.Expr) @Type {
	var lt @Type = checkExpr(c, e.X)
	var rt @Type = checkExpr(c, e.Y)
	checkShiftCountNonNegative(c, e.Pos, e.Op, e.Y, rt)
	return checkBinaryOp(c, e.Pos, e.Op, lt, rt)
}

// checkShiftCountNonNegative rejects a CONSTANT negative shift count at compile
// time — a shift count is non-negative, matching Go (a runtime negative count
// panics; see the OP_SHIFT_CHECK guard).  op is a base operator; only SHL / SHR
// are checked.  A non-constant or non-negative count is a no-op.  Shared by the
// expression (checkBinaryExpr) and compound-assign (checkAssignStmt) shift
// sites.  The sign is taken from the language folder's bignum-correct LitSign
// rather than re-folding through the SIGNED evalConstIntValue (which a huge
// magnitude overflows into a negative):
//   - an unsigned count type can't be negative (peel TYP_NAMED so a NAMED
//     unsigned type, `type C uint64`, is recognized too, not just predeclared
//     uintN);
//   - a folded constant count carries HasLitVal + LitSign from the folder
//     (literals, arithmetic, bitwise, unary-minus, AND `~` — checkUnaryExpr now
//     complements its literal), so a huge POSITIVE count, literal OR computed
//     (`x << 0x8000000000000000`, `x << (1 << 63)`), is accepted while `-1` /
//     `~0` are caught — no signed-overflow false-positive.
//   - everything else (a non-folding const, e.g. a concrete-typed const ident)
//     falls back to evalConstIntValue, whose values are in range.
func checkShiftCountNonNegative(c @Checker, pos token.Pos, op int, countExpr @ast.Expr,
		countType @Type) {
	if op != cast(int, token.SHL) && op != cast(int, token.SHR) {
		return
	}
	if countType != nil {
		var peeled @Type = peelNamedBounded(countType)
		if peeled != nil && peeled.Kind == TYP_INT && !peeled.Signed {
			return
		}
		if countType.HasLitVal {
			if countType.LitSign && countType.LitMag != cast(uint64, 0) {
				addCheckError(c, pos, "negative shift count")
			}
			return
		}
	}
	var v int
	var isConst bool
	v, isConst = evalConstIntValue(c, countExpr)
	if isConst && v < 0 {
		addCheckError(c, pos, "negative shift count")
	}
}

// checkBinaryOp validates a binary operator against its operand types and returns the result type.
func checkBinaryOp(c @Checker, pos token.Pos, op int, lt @Type, rt @Type) @Type {
	// An operand whose type error was already reported (TYP_ERROR) poisons
	// the whole binary op: re-checking it here would pile a second
	// "requires numeric/integer/bool operands" onto the primary diagnostic.
	// Propagate the error sentinel silently so the result stays suppressible
	// (AssignableTo treats TYP_ERROR as compatible with anything).
	if (lt != nil && lt.Kind == TYP_ERROR) || (rt != nil && rt.Kind == TYP_ERROR) {
		return TypError()
	}
	// Arithmetic
	if op == cast(int, token.PLUS) || op == cast(int, token.MINUS) || op == cast(int, token.STAR) ||
			op == cast(int, token.SLASH) || op == cast(int, token.PERCENT) {
		return checkArithOp(c, pos, op, lt, rt)
	}
	// Bitwise (& | ^): integer operands; result is their common type.
	if op == cast(int, token.AMP) || op == cast(int, token.PIPE) || op == cast(int, token.CARET) {
		if !lt.IsInteger() || !rt.IsInteger() {
			addCheckError(c, pos, "bitwise op requires integer operands")
			return TypError()
		}
		return foldIntBitwise(c, pos, op, lt, rt)
	}
	// Shift (<< >>): the result type is the LEFT operand's type; the
	// shift count (right operand) may be ANY integer type, independent
	// of the left operand.  A shift is not a symmetric binop, so the
	// count must NOT be unified with the value via commonType — doing
	// so wrongly rejected `int64 << int` in 32-bit-int modes (where
	// `int` != `int64`) with "mismatched types".  Both operands must be
	// integers.
	if op == cast(int, token.SHL) || op == cast(int, token.SHR) {
		if !lt.IsInteger() || !rt.IsInteger() {
			addCheckError(c, pos, "shift requires integer operands")
			return TypError()
		}
		// When either operand is untyped, defer to foldIntBitwise — it folds
		// the both-untyped constant case and otherwise applies the standard
		// untyped-operand coercion (commonType), exactly as before this split.
		// Only a TYPED-vs-TYPED pair returns lt directly: commonType would
		// reject `int64 << int` in 32-bit-int modes (where `int` != `int64`)
		// as "mismatched types", but a shift's count type is independent of
		// the value, so the result is simply the left (value) type.
		if lt.Kind == TYP_UNTYPED_INT || rt.Kind == TYP_UNTYPED_INT {
			return foldIntBitwise(c, pos, op, lt, rt)
		}
		return lt
	}
	// Equality (==, !=): operands must be mutually assignable, and the
	// operand type must be one that equality is defined on.  Scalars and
	// pointers compare directly; structs/arrays are deferred (not yet
	// implemented); slices, interface values, and function values are
	// rejected (they have purpose-built alternatives).  See
	// checkEqOperands.
	if op == cast(int, token.EQ) || op == cast(int, token.NEQ) {
		if !lt.AssignableTo(c, rt) && !rt.AssignableTo(c, lt) {
			errTypeMismatch(c, pos, lt, rt)
			return TypUntypedBool()
		}
		checkEqOperands(c, pos, lt, rt)
		return TypUntypedBool()
	}
	// Relational (<, >, <=, >=): numeric operands only.  Ordering is not
	// defined for pointers (claude-notes.md:898 — pointers compare with
	// == / != only) or for any aggregate (slice, array, struct,
	// interface value, function value), nor for a type parameter (constrain it
	// and order via a method — spec §13.6).
	if op == cast(int, token.LT) || op == cast(int, token.GT) || op == cast(int, token.LEQ) ||
			op == cast(int, token.GEQ) {
		if !lt.AssignableTo(c, rt) && !rt.AssignableTo(c, lt) {
			errTypeMismatch(c, pos, lt, rt)
			return TypUntypedBool()
		}
		if containsByValueTypeParam(lt) || containsByValueTypeParam(rt) {
			addCheckError(c, pos,
					"< > <= >= is not defined on a type parameter (constrain it, e.g. "
							"`[T lang.Orderable]`, and order via a method: `a.Compare(b) < 0`)")
		} else if !relationalOperandOK(lt) || !relationalOperandOK(rt) {
			addCheckError(c, pos, "relational operators (< > <= >=) require numeric operands")
		}
		return TypUntypedBool()
	}
	// Logical
	if op == cast(int, token.LAND) || op == cast(int, token.LOR) {
		if !lt.IsBool() || !rt.IsBool() {
			addCheckError(c, pos, "logical op requires bool operands")
		}
		return TypUntypedBool()
	}
	addCheckError(c, pos, "invalid binary operator")
	return TypError()
}

// containsByValueTypeParam reports whether t IS a type parameter (or Self), or a
// struct / array that transitively contains one BY VALUE.  Recursion stops at a
// pointer / slice — a type parameter behind `@T` / `*T` compares by identity
// regardless of T, and a slice is separately non-comparable — matching
// aggregateComparable's by-value walk.  It is what makes a comparison whose
// comparability/order depends on an unresolved type parameter a clean checker
// rejection (comparison is not defined on type parameters; spec §12/§13.6),
// rather than deferring to instantiation.  Termination: a struct cannot contain
// itself by value (only through a pointer, which stops the recursion).
func containsByValueTypeParam(t @Type) bool {
	var b @Type = peelNamedBounded(t)
	if b == nil {
		return false
	}
	if b.Kind == TYP_TYPE_PARAM || b.Kind == TYP_SELF {
		return true
	}
	if b.Kind == TYP_STRUCT {
		for i := 0; i < len(b.Fields); i++ {
			if containsByValueTypeParam(b.Fields[i].Type) {
				return true
			}
		}
		return false
	}
	if b.Kind == TYP_ARRAY {
		return containsByValueTypeParam(b.Elem)
	}
	return false
}

// checkArithOp validates an arithmetic operator. The `%` operator is
// integer-only; other arithmetic ops accept ints or floats but not a
// mix. Binate has no string `+` operator (claude-notes.md:334).
func checkArithOp(c @Checker, pos token.Pos, op int, lt @Type, rt @Type) @Type {
	if op == cast(int, token.PERCENT) {
		if !lt.IsInteger() || !rt.IsInteger() {
			addCheckError(c, pos, "operator % requires integer operands")
			return TypError()
		}
		return foldIntArith(c, pos, op, lt, rt)
	}
	if !lt.IsNumeric() || !rt.IsNumeric() {
		addCheckError(c, pos, "arithmetic op requires numeric operands")
		return TypError()
	}
	// Reject mixing int and float without an explicit cast.
	if lt.IsInteger() && rt.IsFloat() {
		addCheckError(c, pos, "cannot mix int and float without cast")
		return TypError()
	}
	if lt.IsFloat() && rt.IsInteger() {
		addCheckError(c, pos, "cannot mix int and float without cast")
		return TypError()
	}
	if lt.IsInteger() && rt.IsInteger() {
		return foldIntArith(c, pos, op, lt, rt)
	}
	return commonType(c, pos, lt, rt)
}
