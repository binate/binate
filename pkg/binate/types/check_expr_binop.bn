package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"

// ============================================================
// Binary-operator type checking
// ============================================================

// checkBinaryExpr type-checks a binary expression (both operands and the operator).
func checkBinaryExpr(c @Checker, e @ast.Expr) @Type {
	var lt @Type = checkExpr(c, e.X)
	var rt @Type = checkExpr(c, e.Y)
	checkShiftCountNonNegative(c, e.Pos, e.Op, e.Y, rt)
	return checkBinaryOp(c, e.Pos, e.Op, lt, rt)
}

// checkShiftCountNonNegative rejects a CONSTANT negative shift count at compile
// time — a shift count is non-negative, matching Go (a runtime negative count
// panics; see the OP_SHIFT_CHECK guard).  op is a base operator; only SHL / SHR
// are checked.  An unsigned count type can't be negative and is skipped —
// without that gate a huge unsigned constant would fold (through the signed
// evalConstIntValue) to a negative value and be wrongly rejected.  A
// non-constant or non-negative count is a no-op.  Shared by the expression
// (checkBinaryExpr) and compound-assign (checkAssignStmt) shift sites.
func checkShiftCountNonNegative(c @Checker, pos token.Pos, op int,
		countExpr @ast.Expr, countType @Type) {
	if op != cast(int, token.SHL) && op != cast(int, token.SHR) {
		return
	}
	if countType != nil && countType.Kind == TYP_INT && !countType.Signed {
		return
	}
	var v int
	var isConst bool
	v, isConst = evalConstIntValue(c, countExpr)
	if isConst && v < 0 {
		addCheckError(c, pos, "negative shift count")
	}
}

// checkBinaryOp validates a binary operator against its operand types and returns the result type.
func checkBinaryOp(c @Checker, pos token.Pos, op int, lt @Type, rt @Type) @Type {
	// Arithmetic
	if op == cast(int, token.PLUS) || op == cast(int, token.MINUS) ||
		op == cast(int, token.STAR) || op == cast(int, token.SLASH) ||
		op == cast(int, token.PERCENT) {
		return checkArithOp(c, pos, op, lt, rt)
	}
	// Bitwise (& | ^): integer operands; result is their common type.
	if op == cast(int, token.AMP) || op == cast(int, token.PIPE) ||
		op == cast(int, token.CARET) {
		if !lt.IsInteger() || !rt.IsInteger() {
			addCheckError(c, pos, "bitwise op requires integer operands")
			return TypVoid()
		}
		return foldIntBitwise(c, pos, op, lt, rt)
	}
	// Shift (<< >>): the result type is the LEFT operand's type; the
	// shift count (right operand) may be ANY integer type, independent
	// of the left operand.  A shift is not a symmetric binop, so the
	// count must NOT be unified with the value via commonType — doing
	// so wrongly rejected `int64 << int` in 32-bit-int modes (where
	// `int` != `int64`) with "mismatched types".  Both operands must be
	// integers.
	if op == cast(int, token.SHL) || op == cast(int, token.SHR) {
		if !lt.IsInteger() || !rt.IsInteger() {
			addCheckError(c, pos, "shift requires integer operands")
			return TypVoid()
		}
		// When either operand is untyped, defer to foldIntBitwise — it folds
		// the both-untyped constant case and otherwise applies the standard
		// untyped-operand coercion (commonType), exactly as before this split.
		// Only a TYPED-vs-TYPED pair returns lt directly: commonType would
		// reject `int64 << int` in 32-bit-int modes (where `int` != `int64`)
		// as "mismatched types", but a shift's count type is independent of
		// the value, so the result is simply the left (value) type.
		if lt.Kind == TYP_UNTYPED_INT || rt.Kind == TYP_UNTYPED_INT {
			return foldIntBitwise(c, pos, op, lt, rt)
		}
		return lt
	}
	// Equality (==, !=): operands must be mutually assignable, and the
	// operand type must be one that equality is defined on.  Scalars and
	// pointers compare directly; structs/arrays are deferred (not yet
	// implemented); slices, interface values, and function values are
	// rejected (they have purpose-built alternatives).  See
	// checkEqOperands.
	if op == cast(int, token.EQ) || op == cast(int, token.NEQ) {
		if !lt.AssignableTo(rt) && !rt.AssignableTo(lt) {
			errTypeMismatch(c, pos, lt, rt)
			return TypUntypedBool()
		}
		checkEqOperands(c, pos, lt, rt)
		return TypUntypedBool()
	}
	// Relational (<, >, <=, >=): numeric operands only.  Ordering is not
	// defined for pointers (claude-notes.md:898 — pointers compare with
	// == / != only) or for any aggregate (slice, array, struct,
	// interface value, function value).
	if op == cast(int, token.LT) || op == cast(int, token.GT) ||
		op == cast(int, token.LEQ) || op == cast(int, token.GEQ) {
		if !lt.AssignableTo(rt) && !rt.AssignableTo(lt) {
			errTypeMismatch(c, pos, lt, rt)
			return TypUntypedBool()
		}
		if !relationalOperandOK(lt) || !relationalOperandOK(rt) {
			addCheckError(c, pos,
				"relational operators (< > <= >=) require numeric operands")
		}
		return TypUntypedBool()
	}
	// Logical
	if op == cast(int, token.LAND) || op == cast(int, token.LOR) {
		if !lt.IsBool() || !rt.IsBool() {
			addCheckError(c, pos, "logical op requires bool operands")
		}
		return TypUntypedBool()
	}
	addCheckError(c, pos, "invalid binary operator")
	return TypVoid()
}

// checkArithOp validates an arithmetic operator. The `%` operator is
// integer-only; other arithmetic ops accept ints or floats but not a
// mix. Binate has no string `+` operator (claude-notes.md:334).
func checkArithOp(c @Checker, pos token.Pos, op int, lt @Type, rt @Type) @Type {
	if op == cast(int, token.PERCENT) {
		if !lt.IsInteger() || !rt.IsInteger() {
			addCheckError(c, pos, "operator % requires integer operands")
			return TypVoid()
		}
		return foldIntArith(c, pos, op, lt, rt)
	}
	if !lt.IsNumeric() || !rt.IsNumeric() {
		addCheckError(c, pos, "arithmetic op requires numeric operands")
		return TypVoid()
	}
	// Reject mixing int and float without an explicit cast.
	if lt.IsInteger() && rt.IsFloat() {
		addCheckError(c, pos, "cannot mix int and float without cast")
		return TypVoid()
	}
	if lt.IsFloat() && rt.IsInteger() {
		addCheckError(c, pos, "cannot mix int and float without cast")
		return TypVoid()
	}
	if lt.IsInteger() && rt.IsInteger() {
		return foldIntArith(c, pos, op, lt, rt)
	}
	return commonType(c, pos, lt, rt)
}
