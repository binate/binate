package "pkg/binate/types"

import "pkg/builtins/testing"
import "pkg/std/strings"

// ============================================================
// Binary-operator type checking tests
// ============================================================

func TestCheckBinaryExpr() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x int = 1 + 2\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckBoolExpr() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x bool = true && false\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckComparison() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x bool = 1 < 2\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloatArith() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"var a float64 = 1.0 + 2.0\n"
		"var b float64 = 3.0 - 1.0\n"
		"var c float64 = 2.0 * 3.0\n"
		"var d float64 = 6.0 / 2.0\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloatCompare() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"var a bool = 1.0 < 2.0\n"
		"var b bool = 1.0 == 1.0\n"
		"var d bool = 3.0 >= 2.5\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A shift's count may be ANY integer type, independent of the value's
// type; the result type is the value's.  `int64 << int` (typed-vs-typed
// with differing widths) previously failed in 32-bit-int modes.
func TestCheckShiftMixedCountType() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"var a int64 = 1\n"
		"var n int32 = 2\n"
		"var r int64 = a << n\n"   // count narrower than value
		"var b uint8 = 3\n"
		"var m int = 1\n"
		"var s uint8 = b << m\n"   // count wider than value
		"var t int64 = a >> n\n")  // result type is the value's (int64)
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Negative: mixing int and float without an explicit cast must error.
func TestCheckRejectIntPlusFloat() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x float64 = 1 + 2.0\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Negative: `%` on floats is a type error.
func TestCheckRejectFloatRem() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x float64 = 3.0 % 1.5\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Negative: bitwise operators on floats are a type error.
func TestCheckRejectFloatBitwise() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x float64 = 1.5 & 2.0\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A shift count is non-negative; a CONSTANT negative count is a compile
// error (a runtime negative count panics instead).  A bare negative literal
// count.
func TestCheckRejectNegativeConstShiftCount() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x int = 1\nvar y int = x << -1\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A negative count via a named constant folds to a negative value and is
// likewise rejected at compile time.
func TestCheckRejectNegativeConstIdentShiftCount() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"const n int = -1\n"
		"var x int = 1\n"
		"var y int = x >> n\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// The same rule applies to a compound shift-assign (`<<=` / `>>=`).
func TestCheckRejectNegativeShiftAssignCount() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func f() {\n"
		"  var x int = 1\n"
		"  x <<= -1\n"
		"  _ = x\n"
		"}\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A NON-negative constant count (even a large one that overshifts — that is
// defined at run time, not a compile error) must NOT be rejected.
func TestCheckAllowNonNegativeConstShiftCount() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"var x uint = 1\n"
		"var y uint = x << 100\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A high-bit-set CONCRETE-unsigned const count folds to a negative host int
// but is non-negative as a uint, so the unsigned gate must skip it (NOT a
// "negative shift count").  This is the case the gate exists for.
func TestCheckAllowHighBitUnsignedConstShiftCount() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"const n uint = 0xFFFFFFFFFFFFFFFF\n"
		"var x int = 1\n"
		"var y int = x << n\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A NAMED unsigned type count must also be recognized as non-negative (the
// gate peels TYP_NAMED) — without the peel it folds negative and is wrongly
// rejected.
func TestCheckAllowNamedUnsignedShiftCount() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type C uint64\n"
		"const m C = 0x8000000000000000\n"
		"var x int = 1\n"
		"var y int = x << m\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A huge POSITIVE untyped-int LITERAL count overflows the signed fold but is
// non-negative (a defined overshift), so it must NOT be rejected; the sign
// comes from LitSign, not the overflowed value.
func TestCheckAllowHugeLiteralShiftCount() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"var x int = 1\n"
		"var y int = x << 0x8000000000000000\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}
