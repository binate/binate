package "pkg/binate/types"

import "pkg/binate/ast"

// Composite-literal type-checking, split out of check_expr.bn for
// file-length hygiene. Same package; checkExpr / checkExprInner
// in check_expr.bn dispatch into checkCompositeLit here.

// checkCompositeLit type-checks a composite literal (struct, array,
// or managed-slice).
func checkCompositeLit(c @Checker, e @ast.Expr) @Type {
	var typ @Type = resolveTypeExpr(c, e.TypeRef)
	capturePendingIfSized(c, typ)
	var xt @Type = typ.ResolveAlias()

	if xt != nil && xt.Kind == TYP_STRUCT {
		checkStructLit(c, e, xt)
	}
	if xt != nil && xt.Kind == TYP_ARRAY {
		checkArrayLit(c, e, xt)
	}
	if xt != nil && xt.Kind == TYP_MANAGED_SLICE {
		checkSliceLit(c, e, xt)
	}
	if xt != nil && xt.Kind == TYP_SLICE {
		// Raw-slice composite literal: `*[]readonly T{...}` is
		// allowed (rodata or stack backing); `*[]T{...}` (non-
		// const element) is rejected — no sound mutable backing.
		var unused @Type
		var elemIsConst bool
		unused, elemIsConst = elemHasConst(xt.Elem)
		if !elemIsConst {
			addCheckError(c, e.Pos,
				"raw-slice composite literal requires const elements; use *[]readonly T{...} or @[]T{...}")
		} else {
			checkSliceLit(c, e, xt)
		}
	}
	if xt != nil && xt.Kind == TYP_NAMED && xt.Underlying != nil {
		if xt.Underlying.Kind == TYP_STRUCT {
			checkStructLit(c, e, xt.Underlying)
		}
	}

	return typ
}

// checkSliceLit validates managed-slice literal elements against
// the slice's element type. (Raw slice literals are not supported
// — the parser doesn't even produce them today; if it ever does,
// the rule per the plan is: rejected unless elements are const.)
func checkSliceLit(c @Checker, e @ast.Expr, st @Type) {
	var elemTyp @Type = st.Elem
	if elemTyp == nil { return }
	for i := 0; i < len(e.Elems); i++ {
		var vt @Type = checkExpr(c, e.Elems[i].Value)
		if !vt.AssignableTo(elemTyp) {
			errCannotAssign(c, e.Elems[i].Value.Pos, vt, elemTyp)
		}
	}
}

// checkStructLit validates struct literal elements against the struct's field types.
func checkStructLit(c @Checker, e @ast.Expr, st @Type) {
	for i := 0; i < len(e.Elems); i++ {
		var el @ast.Element = e.Elems[i]
		if el.Key != nil {
			var f @Field = st.FieldByName(el.Key.Name)
			if f == nil {
				errUndefined(c, el.Key.Pos, el.Key.Name)
				continue
			}
			var vt @Type = checkExpr(c, el.Value)
			if !vt.AssignableTo(f.Type) {
				errCannotAssign(c, el.Value.Pos, vt, f.Type)
			}
		} else {
			checkExpr(c, el.Value)
		}
	}
}

// checkArrayLit validates array literal elements against the array's element type.
func checkArrayLit(c @Checker, e @ast.Expr, at @Type) {
	// Reject more elements than the array holds: IR-gen stores element i at
	// index i, so an over-count emits out-of-bounds stores past the
	// fixed-size alloca (memory-unsafety).  (Indexed elements — `el.Key` —
	// are a separate, still-open concern; this positional count check is
	// correct for the positional form the checker handles today.)
	if len(e.Elems) > at.ArrayLen {
		addCheckError(c, e.Pos, "too many elements in array literal")
	}
	for i := 0; i < len(e.Elems); i++ {
		var vt @Type = checkExpr(c, e.Elems[i].Value)
		if !vt.AssignableTo(at.Elem) {
			errCannotAssign(c, e.Elems[i].Value.Pos, vt, at.Elem)
		}
	}
}
