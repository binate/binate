package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for check_expr_composite.bn — composite-literal type
// checking (struct / array / managed-slice / raw-slice forms).
// Uses the helpers (checkSrc, expectNoErrors, expectError) defined
// in check_expr_test.bn — package-level visibility.

func TestCheckCompositeLit() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Point struct { X int; Y int }\n")
	cb = cb.WriteStr("func f() { var p Point = Point{X: 1, Y: 2} }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}
