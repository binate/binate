package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for check_expr_constfold.bn — fold + - * and & | ^ << >>
// at type-check time so the literal-fits-target check at the
// assignment site sees the final value.  These exercise the
// end-to-end happy and rejection paths via checkSrc; conformance
// 421 / 420 pin the same shapes through the full compile pipeline.

func TestConstFoldArithSubCancels() testing.TestResult {
	// 1000 - 1000 = 0 fits uint8 even though `1000` alone doesn't.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 1000 - 1000\n")
	return expectNoErrors(c)
}

func TestConstFoldArithAddFits() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 100 + 100\n")
	return expectNoErrors(c)
}

func TestConstFoldArithMulFits() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 5 * 50\n")
	return expectNoErrors(c)
}

func TestConstFoldArithAddOverflowsTarget() testing.TestResult {
	// 200 + 100 = 300 doesn't fit uint8 [0, 255].
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 200 + 100\n")
	return expectError(c)
}

func TestConstFoldArithSignedNegBoundary() testing.TestResult {
	// 64 + 64 - 128 = 0 — int8 boundary case, fits.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x int8 = 64 + 64 - 128\n")
	return expectNoErrors(c)
}

func TestConstFoldBitwiseAnd() testing.TestResult {
	// 0xF0 & 0x0F = 0 fits any unsigned target.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 0xF0 & 0x0F\n")
	return expectNoErrors(c)
}

func TestConstFoldBitwiseOrFits() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 0xF0 | 0x0F\n")
	return expectNoErrors(c)
}

func TestConstFoldBitwiseShlFits() testing.TestResult {
	// 1 << 7 = 128 fits uint8.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 1 << 7\n")
	return expectNoErrors(c)
}

func TestConstFoldBitwiseShlOverflowsTarget() testing.TestResult {
	// 1 << 8 = 256 doesn't fit uint8.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 1 << 8\n")
	return expectError(c)
}

func TestConstFoldBitwiseShrFits() testing.TestResult {
	// 0x80 >> 3 = 16 fits uint8.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 0x80 >> 3\n")
	return expectNoErrors(c)
}

func TestConstFoldDivFits() testing.TestResult {
	// 200 / 4 = 50 fits uint8.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 200 / 4\n")
	return expectNoErrors(c)
}

func TestConstFoldDivByZero() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar x int = 10 / 0\n")
	return expectError(c)
}

func TestConstFoldModFits() testing.TestResult {
	// 256 % 100 = 56 fits uint8.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 256 % 100\n")
	return expectNoErrors(c)
}

func TestConstFoldModByZero() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar x int = 10 % 0\n")
	return expectError(c)
}

// ============================================================
// Unary minus + nesting
// ============================================================

// `-128` fits int8 (negative boundary).  `-129` doesn't.  The unary-
// minus propagator on EXPR_INT_LIT carries the literal's value into
// the result Type so AssignableTo's fit-check sees -128 / -129.
func TestConstFoldUnaryMinusBoundary() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar x int8 = -128\n")
	return expectNoErrors(c)
}

func TestConstFoldUnaryMinusOverflowsInt8() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar x int8 = -129\n")
	return expectError(c)
}

// Nested const-expr: `(a + b) * c` where the inner fold's result is
// itself a HasLitVal untyped-int, feeding the outer fold.  Pins
// that HasLitVal propagation works across multiple binop layers.
func TestConstFoldNestedExpression() testing.TestResult {
	// (3 + 4) * 100 = 700 doesn't fit uint8 → rejected.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = (3 + 4) * 100\n")
	return expectError(c)
}

func TestConstFoldNestedExpressionFits() testing.TestResult {
	// (3 + 4) * 30 = 210 fits uint8.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = (3 + 4) * 30\n")
	return expectNoErrors(c)
}

// Hex literals: parse + fold + fit-check round-trip.
func TestConstFoldHexLiterals() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint32 = 0xFF * 0x100 | 0xAB\n")
	return expectNoErrors(c)
}

// SHL overflow at the uint64 boundary: pre-overflow-check rejection
// before AssignableTo fires.
func TestConstFoldShlUint64Overflow() testing.TestResult {
	// `0x8000000000000000 << 1` overflows uint64 — the bit at
	// position 63 is shifted out.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint64 = 0x8000000000000000 << 1\n")
	return expectError(c)
}

// Arithmetic overflow at the union-range boundary: 0xFFFFFFFFFFFFFFFF
// + 1 = 2^64 doesn't fit the int64 ∪ uint64 union — rejected at
// const-fold time, not deferred to runtime.
func TestConstFoldAddBeyondUint64Max() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint64 = 0xFFFFFFFFFFFFFFFF + 1\n")
	return expectError(c)
}

// An iota-counted bare const in a const group should carry its
// iota value as HasLitVal on the symbol's Type, so a downstream
// const-fold can compute correct results when the symbol is used
// as a binop operand.  Pre-fix the symbol carried TYP_UNTYPED_INT
// without a LitVal; commonType then inherited the LitVal from
// the OTHER (literal) operand, mis-folding e.g. `A + 1` to `1`
// for any iota value of A.  Pin the fix by exercising fit-checks
// that depend on the iota value being known.
//
// 250 fits uint8.  If keyword_start_like (iota=2) gets dropped
// down to LitMag=0 / no-LitVal, the fold returns the
// literal-248's value and AssignableTo would accept.  With
// HasLitVal propagation, the fold yields 250 → still accepted.
// The complementary rejection variant below catches the missed
// fold directly.
func TestConstFoldIotaConstPlusLiteralFits() testing.TestResult {
	// Untyped base (`A = iota`), so the bare members stay untyped and
	// narrow freely at the use site: C = 2, C + 248 = 250 fits uint8.
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("package \"test\"\nconst (\n")
	cb.Write("\tA = iota\n\tB\n\tC\n)\n")
	cb.Write("var x uint8 = C + 248\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// C + 254 = 2 + 254 = 256 doesn't fit uint8 — fold must compute
// the right value (256, NOT just 254 inherited from the literal).
// Pre-fix the fit-check accepted this because commonType returned
// the literal-254's Type (LitMag=254, fits uint8).  Untyped base so
// the overflow is checked at the narrowing use site (var x uint8 = ...).
func TestConstFoldIotaConstPlusLiteralOverflows() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("package \"test\"\nconst (\n")
	cb.Write("\tA = iota\n\tB\n\tC\n)\n")
	cb.Write("var x uint8 = C + 254\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// A bit-flag const's bare members repeat the explicit `1 << iota`
// initializer (re-evaluated at THIS iota) AND inherit the preceding
// member's TYPE — so in a uint8 group B8 folds to 1<<8 = 256, which
// overflows its inherited uint8 type and is REJECTED at the declaration.
// Two pre-fix bugs this guards: (1) the checker left iota unfolded, so a
// bare member stored the plain iota index (B8 = 8, which fits); (2) the
// bare member was untyped (no range check), so even folded to 256 it was
// accepted and then truncated to 0 by IR-gen — a silent miscompile.
func TestConstFoldIotaBitflagBareRepeatOverflows() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("package \"test\"\nconst (\n")
	cb.Write("\tB0 uint8 = 1 << iota\n\tB1\n\tB2\n\tB3\n\tB4\n")
	cb.Write("\tB5\n\tB6\n\tB7\n\tB8\n)\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// The fits side: B7 = 1<<7 = 128 fits the inherited uint8 type — the fold
// must not spuriously reject a bare bit-flag member whose folded value is
// in range, so the whole uint8 group declaration is accepted.
func TestConstFoldIotaBitflagBareRepeatFits() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("package \"test\"\nconst (\n")
	cb.Write("\tB0 uint8 = 1 << iota\n\tB1\n\tB2\n\tB3\n\tB4\n")
	cb.Write("\tB5\n\tB6\n\tB7\n)\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// A bare member inherits the preceding member's concrete TYPE (decision
// A): in a uint16 group B1 is uint16, so narrowing it to uint8 needs an
// explicit cast — a plain `var x uint8 = B1` is a type error.  Pins the
// typed-inheritance semantics (pre-fix bare members were untyped and
// narrowed silently).
func TestConstFoldIotaBareMemberInheritsConcreteType() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("package \"test\"\nconst (\n")
	cb.Write("\tB0 uint16 = 1 << iota\n\tB1\n)\n")
	cb.Write("var x uint8 = B1\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}
