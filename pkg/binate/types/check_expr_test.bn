package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// ============================================================
// Expression Checking Tests
// ============================================================

func TestCheckUnaryNeg() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x int = -42\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckUnaryNot() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x bool = !true\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// ============================================================
// Float Expression Tests
// ============================================================

func TestCheckFloatLit() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x float64 = 3.14\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloat32Lit() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x float32 = 3.14\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloatDefaultInferred() testing.TestResult {
	// Without an explicit type, an untyped float literal should default
	// to float64 — and then be usable as float64.
	var src *[]readonly char = "package \"test\"\nvar x = 3.14\nvar y float64 = x\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloatNegate() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar x float64 = -3.14\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloatCast() testing.TestResult {
	// int -> float, float -> int, float32 <-> float64.
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"var i int = 5\n"
		"var f float64 = cast(float64, i)\n"
		"var g float32 = cast(float32, f)\n"
		"var j int = cast(int, f)\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Negative: assigning a float to an int variable without cast is an error.
func TestCheckRejectFloatToInt() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar f float64 = 1.5\nvar i int = f\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Negative: assigning an int to a float variable without cast is an error
// when the int is a typed variable (not an untyped literal).
func TestCheckRejectIntToFloat() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar i int = 5\nvar f float64 = i\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Float identifier lookup from universe scope.
func TestFloatInUniverseScope() testing.TestResult {
	var src *[]readonly char = "package \"test\"\ntype MyFloat float64\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// ============================================================
// readonly type modifier — Stage 0 end-to-end (parse + type check)
// ============================================================

// `var x readonly int = 42` — readonly wrapping a primitive.
func TestCheckReadonlyInt() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc main() { var x readonly int = 42; _ = x }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// `var p *readonly int = ...` — pointer to readonly int.
func TestCheckPointerToReadonly() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 5\n"
		"  var p *readonly int = &x\n"
		"  _ = p\n"
		"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// `var s *[]readonly int = arr[:]` — raw slice of readonly int.
func TestCheckReadonlySliceElem() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func main() {\n"
		"  var a [3]int\n"
		"  var s *[]readonly int = a[:]\n"
		"  _ = s\n"
		"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// `readonly int → int` is allowed — value-type copy-out can't leak
// mutation capabilities.
func TestCheckReadonlyValueCopyOut() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func main() {\n"
		"  var x readonly int = 1\n"
		"  var y int = x\n"
		"  _ = y\n"
		"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// Negative: reassigning a readonly-typed variable.
func TestCheckRejectReadonlyReassign() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func main() {\n"
		"  var x readonly int = 1\n"
		"  x = 2\n"
		"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// Negative: dropping readonly via a pointer element — capability leak.
func TestCheckRejectDropReadonlyViaPointer() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 5\n"
		"  var p *readonly int = &x\n"
		"  var q *int = p\n"
		"  _ = q\n"
		"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// Negative: writing through a pointer-to-readonly.
func TestCheckRejectWriteThroughReadonlyPtr() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 5\n"
		"  var p *readonly int = &x\n"
		"  *p = 10\n"
		"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// Negative: writing a slice-of-readonly element.
func TestCheckRejectWriteReadonlySliceElem() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func main() {\n"
		"  var a [3]int\n"
		"  var s *[]readonly int = a[:]\n"
		"  s[0] = 7\n"
		"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// Negative: field assign through a pointer-to-readonly-struct.
func TestCheckRejectReadonlyFieldAssign() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Point struct { X int }\n"
		"func main() {\n"
		"  var p Point\n"
		"  var q *readonly Point = &p\n"
		"  q.X = 9\n"
		"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// Widening is still accepted: `*int → *readonly int`.
func TestCheckWidenPointerElem() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 5\n"
		"  var p *readonly int = &x\n"
		"  _ = p\n"
		"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// Outer-readonly-on-pointer → non-readonly pointer: the pointer value is
// copied out, original is unchanged. Allowed.
func TestCheckOuterReadonlyPtrCopyOut() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 5\n"
		"  var p readonly *int = &x\n"
		"  var q *int = p\n"
		"  _ = q\n"
		"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// `cast` drops readonly explicitly — capability escape hatch.
func TestCheckCastDropsReadonly() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 5\n"
		"  var p *readonly int = &x\n"
		"  var q *int = cast(*int, p)\n"
		"  _ = q\n"
		"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

// readonly parameter type.
func TestCheckReadonlyParam() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func f(p *readonly int) int { return *p }\n"
		"func main() {\n"
		"  var x int = 5\n"
		"  var y int = f(&x)\n"
		"  _ = y\n"
		"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

