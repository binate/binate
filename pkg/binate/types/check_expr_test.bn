package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// ============================================================
// Expression Checking Tests
// ============================================================

func TestCheckBinaryExpr() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x int = 1 + 2\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckBoolExpr() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x bool = true && false\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckComparison() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x bool = 1 < 2\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckUnaryNeg() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x int = -42\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckUnaryNot() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x bool = !true\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// ============================================================
// Float Expression Tests
// ============================================================

func TestCheckFloatLit() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x float64 = 3.14\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloat32Lit() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x float32 = 3.14\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloatDefaultInferred() testing.TestResult {
	// Without an explicit type, an untyped float literal should default
	// to float64 — and then be usable as float64.
	var src *[]const char = "package \"test\"\nvar x = 3.14\nvar y float64 = x\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloatArith() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"var a float64 = 1.0 + 2.0\n"
		"var b float64 = 3.0 - 1.0\n"
		"var c float64 = 2.0 * 3.0\n"
		"var d float64 = 6.0 / 2.0\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloatCompare() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"var a bool = 1.0 < 2.0\n"
		"var b bool = 1.0 == 1.0\n"
		"var d bool = 3.0 >= 2.5\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloatNegate() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x float64 = -3.14\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloatCast() testing.TestResult {
	// int -> float, float -> int, float32 <-> float64.
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"var i int = 5\n"
		"var f float64 = cast(float64, i)\n"
		"var g float32 = cast(float32, f)\n"
		"var j int = cast(int, f)\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Negative: mixing int and float without an explicit cast must error.
func TestCheckRejectIntPlusFloat() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x float64 = 1 + 2.0\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Negative: `%` on floats is a type error.
func TestCheckRejectFloatRem() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x float64 = 3.0 % 1.5\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Negative: bitwise operators on floats are a type error.
func TestCheckRejectFloatBitwise() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x float64 = 1.5 & 2.0\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Negative: assigning a float to an int variable without cast is an error.
func TestCheckRejectFloatToInt() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar f float64 = 1.5\nvar i int = f\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Negative: assigning an int to a float variable without cast is an error
// when the int is a typed variable (not an untyped literal).
func TestCheckRejectIntToFloat() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar i int = 5\nvar f float64 = i\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Float identifier lookup from universe scope.
func TestFloatInUniverseScope() testing.TestResult {
	var src *[]const char = "package \"test\"\ntype MyFloat float64\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// ============================================================
// const type modifier — Stage 0 end-to-end (parse + type check)
// ============================================================

// `var x const int = 42` — const wrapping a primitive.
func TestCheckConstInt() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc main() { var x const int = 42; _ = x }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// `var p *const int = ...` — pointer to const int.
func TestCheckPointerToConst() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 5\n"
		"  var p *const int = &x\n"
		"  _ = p\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// `var s *[]const int = arr[:]` — raw slice of const int.
func TestCheckConstSliceElem() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var a [3]int\n"
		"  var s *[]const int = a[:]\n"
		"  _ = s\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// `const int → int` is allowed — value-type copy-out can't leak
// mutation capabilities.
func TestCheckConstValueCopyOut() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var x const int = 1\n"
		"  var y int = x\n"
		"  _ = y\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Negative: reassigning a const-typed variable.
func TestCheckRejectConstReassign() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var x const int = 1\n"
		"  x = 2\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Negative: dropping const via a pointer element — capability leak.
func TestCheckRejectDropConstViaPointer() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 5\n"
		"  var p *const int = &x\n"
		"  var q *int = p\n"
		"  _ = q\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Negative: writing through a pointer-to-const.
func TestCheckRejectWriteThroughConstPtr() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 5\n"
		"  var p *const int = &x\n"
		"  *p = 10\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Negative: writing a slice-of-const element.
func TestCheckRejectWriteConstSliceElem() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var a [3]int\n"
		"  var s *[]const int = a[:]\n"
		"  s[0] = 7\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Negative: field assign through a pointer-to-const-struct.
func TestCheckRejectConstFieldAssign() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Point struct { X int }\n"
		"func main() {\n"
		"  var p Point\n"
		"  var q *const Point = &p\n"
		"  q.X = 9\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Widening is still accepted: `*int → *const int`.
func TestCheckWidenPointerElem() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 5\n"
		"  var p *const int = &x\n"
		"  _ = p\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Outer-const-on-pointer → non-const pointer: the pointer value is
// copied out, original is unchanged. Allowed.
func TestCheckOuterConstPtrCopyOut() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 5\n"
		"  var p const *int = &x\n"
		"  var q *int = p\n"
		"  _ = q\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// `cast` drops const explicitly — capability escape hatch.
func TestCheckCastDropsConst() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 5\n"
		"  var p *const int = &x\n"
		"  var q *int = cast(*int, p)\n"
		"  _ = q\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// const parameter type.
func TestCheckConstParam() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func f(p *const int) int { return *p }\n"
		"func main() {\n"
		"  var x int = 5\n"
		"  var y int = f(&x)\n"
		"  _ = y\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// ============================================================
// unsafe_index tests
// ============================================================

func TestCheckUnsafeIndexSlice() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var s *[]int\n"
		"  var x int = unsafe_index(s, 0)\n"
		"  _ = x\n"
		"}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckUnsafeIndexArray() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var a [4]int\n"
		"  var x int = unsafe_index(a, 2)\n"
		"  _ = x\n"
		"}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Non-integer index rejected.
func TestCheckUnsafeIndexNonIntIndex() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var s *[]int\n"
		"  var x int = unsafe_index(s, true)\n"
		"  _ = x\n"
		"}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Non-indexable collection rejected.
func TestCheckUnsafeIndexBadColl() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var n int = 5\n"
		"  var x int = unsafe_index(n, 0)\n"
		"  _ = x\n"
		"}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Wrong arg count rejected.
func TestCheckUnsafeIndexArity() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var s *[]int\n"
		"  var x int = unsafe_index(s)\n"
		"  _ = x\n"
		"}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// ============================================================
// sizeof / alignof tests
// ============================================================

func TestCheckSizeofBasic() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x uint = sizeof(int)\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckAlignofBasic() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x uint = alignof(float64)\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// sizeof of a composite type (slice) — the value is the size of the
// slice header, not the referenced data.
func TestCheckSizeofSlice() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x uint = sizeof(*[]int)\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// sizeof returns `uint`, which is assignable to other int-family
// targets only via explicit cast (no implicit uint→int flow).
func TestCheckSizeofIntCoercion() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x int = cast(int, sizeof(int))\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// ============================================================
// Blank identifier `_` tests
// ============================================================

// `_ = expr` as a statement discards the value; no error.
func TestBlankAssign() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc main() { _ = 42 }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// `var _ T = expr` is a valid declaration that binds no name.
func TestBlankVarDecl() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc main() { var _ int = 42 }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// `var _ = expr` infers a type but still binds no name.
func TestBlankVarDeclInferred() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc main() { var _ = 42 }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Reading `_` as an rvalue doesn't emit "undefined: _" but also
// doesn't resolve to a useful value — `_` is write-only. The checker
// accepts the use without an error.
func TestBlankReadNoUndefinedError() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc f(x int) int { return x }\nfunc main() { f(_) }\n"
	var c @Checker = checkSrc(src)
	// We expect no "undefined: _" error. There may be other errors
	// (void can't be assigned to int), but specifically checking no
	// undefined message would require inspecting the error list.
	// For simplicity, just verify the checker doesn't crash.
	var _ @Checker = c
	return ""
}

// Multi-return discard: `_, y := f()` keeps y, ignores the first.
func TestBlankShortVarMultiReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func pair() (int, bool) { return 1, true }\n"
		"func main() { _, y := pair(); if y { return } }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Multi-assign discard: `_, z = f()` keeps z, ignores the first.
func TestBlankMultiAssign() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func pair() (int, int) { return 1, 2 }\n"
		"func main() { var z int = 0; _, z = pair(); z = z + 1 }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckPointerDeref() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc f() { var p *int; var x int = *p }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckMakeBuiltin() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Foo struct { X int }\n"
		"func f() { var p @Foo = make(Foo) }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckLenBuiltin() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc f() { var s *[]int; var n int = len(s) }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckCastBuiltin() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc f() { var x int = cast(int, 42) }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckMakeSliceBuiltin() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nfunc f() { var s @[]int = make_slice(int, 1); s[0] = 1 }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Per the language spec there is no `string` type and no string `+`
// operator. Both halves of the original test are now spec violations,
// so the expression is rejected.
func TestCheckStringConcatRejected() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x @[]const char = \"hello\" + \" world\"\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}
