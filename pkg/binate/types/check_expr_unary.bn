package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"

// ============================================================
// Unary-expression checking (-, !, ~, *, &)
// ============================================================

// checkUnaryExpr type-checks a unary expression (-, !, ~, *, &).
func checkUnaryExpr(c @Checker, e @ast.Expr) @Type {
	var xt @Type = checkExpr(c, e.X)
	if e.Op == cast(int, token.PLUS) {
		// Unary + is a numeric identity: it requires a numeric operand and
		// yields it unchanged (including any carried untyped-literal value, so
		// `var x int8 = +5` fit-checks exactly like `5`).
		if !xt.IsNumeric() {
			addCheckError(c, e.Pos, "unary + requires numeric operand")
		}
		return xt
	}
	if e.Op == cast(int, token.MINUS) {
		if !xt.IsNumeric() {
			addCheckError(c, e.Pos, "unary - requires numeric operand")
		}
		// Propagate the literal value through unary minus so that
		// `var x int8 = -128` accepts and `var x int8 = -129`
		// rejects in the AssignableTo fit-check.  Sign is flipped
		// directly (canonicalizing zero stays positive).
		if xt != nil && xt.Kind == TYP_UNTYPED_INT && xt.HasLitVal {
			var nt @Type = make(Type)
			nt.Kind = TYP_UNTYPED_INT
			nt.Name = xt.Name
			nt.HasLitVal = true
			nt.LitMag = xt.LitMag
			nt.LitSign = xt.LitSign
			if xt.LitMag != 0 {
				nt.LitSign = !xt.LitSign
			}
			return nt
		}
		return xt
	}
	if e.Op == cast(int, token.NOT) {
		if !xt.IsBool() {
			addCheckError(c, e.Pos, "unary ! requires bool operand")
		}
		return TypUntypedBool()
	}
	if e.Op == cast(int, token.TILDE) {
		if !xt.IsInteger() {
			addCheckError(c, e.Pos, "unary ~ requires integer operand")
		}
		// Propagate the COMPLEMENTED literal value through `~`: ~x = -x - 1.
		// For a non-negative operand (value m) the result is -(m+1); for a
		// negative operand (value -m, m>=1) it is m-1 (non-negative).  Without
		// this the carried LitMag/LitSign stay the operand's — so e.g. `~0`
		// (== -1) would wrongly read as non-negative in the AssignableTo
		// fit-check and the negative-shift-count gate.
		if xt != nil && xt.Kind == TYP_UNTYPED_INT && xt.HasLitVal {
			var nt @Type = make(Type)
			nt.Kind = TYP_UNTYPED_INT
			nt.Name = xt.Name
			nt.HasLitVal = true
			if xt.LitSign && xt.LitMag != cast(uint64, 0) {
				nt.LitMag = xt.LitMag - cast(uint64, 1)
				nt.LitSign = false
				return nt
			}
			// Non-negative operand m → ~m == -(m+1).  At m == uint64-max, m+1
			// overflows uint64 so the complement -(2^64) has no LitMag: fall
			// through to `return xt`, leaving the operand's (un-complemented)
			// LitMag/LitSign.  The fit-check then sees the wrong magnitude for
			// `~0xFFFFFFFFFFFFFFFF` — an imprecise carry at this one boundary;
			// IR-gen still computes `~` at runtime.  TODO: fold it exactly.
			if xt.LitMag != (cast(uint64, 0) - cast(uint64, 1)) {
				nt.LitMag = xt.LitMag + cast(uint64, 1)
				nt.LitSign = true
				return nt
			}
		}
		return xt
	}
	if e.Op == cast(int, token.STAR) {
		// Dereference
		var elem @Type = xt.PointerElem()
		if elem == nil {
			addCheckError(c, e.Pos, "cannot dereference non-pointer")
			return TypVoid()
		}
		// Reading `*p` MATERIALIZES the pointee as a value, so an opaque (or
		// cross-package opaque-export) pointee is rejected here — the escape
		// hatch is to hold `*Opaque` / `@Opaque` and pass it around, never to
		// deref it to a value whose layout is unavailable.  Bug 211 / 846.
		requireSizedType(c, elem, e.Pos)
		return elem
	}
	if e.Op == cast(int, token.AMP) {
		// Address-of.  The operand must be an addressable lvalue — it must
		// have storage.  `isAddressable` is the single gate; `reportCannotAddr`
		// picks the most specific diagnostic.  A pointer type is still
		// returned so the use site doesn't cascade a second error.
		if !isAddressable(c, e.X) {
			reportCannotAddr(c, e)
		}
		return MakePointerType(xt)
	}
	addCheckError(c, e.Pos, "invalid unary operator")
	return TypVoid()
}
