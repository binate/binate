package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for check_expr_unary.bn — the unary operators, in particular the
// literal-value propagation through `-` and `~` so the assignment-site
// fit-check (and the negative-shift-count gate) sees the final value.

// `~` propagates the COMPLEMENTED literal value (~x = -x-1), so the fit-check
// sees the real value: `~0` == -1 does NOT fit an unsigned uint8.
func TestUnaryTildeNegativeDoesNotFitUnsigned() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar x uint8 = ~0\n")
	return expectError(c)
}

// And `~127` == -128 DOES fit int8 (its boundary) — the fold's magnitude/sign
// must be exact, not the operand's.
func TestUnaryTildeFitsSignedBoundary() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar x int8 = ~127\n")
	return expectNoErrors(c)
}

// Unary minus likewise: `-128` fits int8, `-129` does not.
func TestUnaryMinusFitCheck() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar x int8 = -128\n")
	if len(c.CheckerErrors()) != 0 {
		return fail("-128 must fit int8")
	}
	var c2 @Checker = checkSrc("package \"test\"\nvar x int8 = -129\n")
	if len(c2.CheckerErrors()) == 0 {
		return fail("-129 must not fit int8")
	}
	return ""
}
