package "pkg/binate/types"

import "pkg/binate/ast"

// Function literal type-checking.  Originally A.7 of plan-function
// -values.md; updated by B.1 of plan-function-values-phase-2.md to
// allow captures.
//
// `func(<params>) <results> { <body> }` in expression position
// evaluates to a function value (`*func(...)` raw form).  The body
// is checked in a scope parented at the ENCLOSING scope (not the
// package scope), so references to outer function/block locals
// resolve normally.  Each such reference is recorded as a capture
// on the literal's synthetic Decl via the capture-frame stack —
// see check_capture.bn for the recording logic.  IR-gen (B.2..B.4)
// reads Decl.Captures to lay out the closure struct + dtor +
// per-shape call shim.

// checkFuncLit type-checks a function literal expression and returns
// its function-value type.
func checkFuncLit(c @Checker, e @ast.Expr) @Type {
	var d @ast.Decl = e.DeclRef
	if d == nil {
		return TypVoid()
	}

	var ft @Type = resolveFuncDeclType(c, d)
	if ft == nil {
		return TypVoid()
	}

	// Save state: we'll nest a body scope and adjust FuncRet.
	var savedScope @Scope = c.Scope
	var savedFuncRet @[]@Type = c.FuncRet

	// Body scope nested on the current (enclosing) scope.  Captures
	// are detected by noteCaptureIfNeeded — see check_capture.bn.
	pushScope(c)
	var bodyScope @Scope = c.Scope

	// Push a capture frame so noteCaptureIfNeeded can find this
	// literal as a recording target.  Pop on exit (deferred via
	// the explicit pop at the end of the function — we don't have
	// `defer` in Binate yet).
	pushCaptureFrame(c, d, bodyScope)

	// Define params in the body scope.
	for i := 0; i < len(ft.Params); i++ {
		defineVar(c.Scope, ft.Params[i].Name, ft.Params[i].Type)
	}

	c.FuncRet = ft.Results

	if d.Body != nil {
		checkBlockStmt(c, d.Body)
	}

	// Missing-return check: a literal with declared results must
	// terminate on every path (mirrors checkFuncDecl).
	if len(ft.Results) > 0 && d.Body != nil {
		if !stmtTerminates(d.Body) {
			errMissingReturn(c, d.Pos, "<func literal>")
		}
	}

	popCaptureFrame(c)
	c.Scope = savedScope
	c.FuncRet = savedFuncRet

	// B.3b: if the enclosing context already established that the
	// literal flows into an @func slot (VarDecl / return / call
	// arg with a @func target), resolve as @func when the
	// signature matches.  IR-gen reads the resolved type to
	// decide stack-alloc vs heap-alloc.  The "matches" check
	// is a structural compare on params + results — checkFuncLit
	// can't return @func when the destination is @func() int but
	// the literal is `func(int) bool`.  When the hint doesn't
	// match (signature mismatch, hint absent, hint says raw
	// *func), the default raw form is returned and the
	// assignability check at the destination site decides.
	if c.ExpectedFVType != nil &&
			c.ExpectedFVType.Kind == TYP_MANAGED_FUNC_VALUE {
		var rawVal @Type = MakeFuncValueType(ft.Params, ft.Results)
		if rawVal.Identical(MakeFuncValueType(
				c.ExpectedFVType.Params,
				c.ExpectedFVType.Results)) {
			return MakeManagedFuncValueType(ft.Params, ft.Results)
		}
	}
	return MakeFuncValueType(ft.Params, ft.Results)
}
