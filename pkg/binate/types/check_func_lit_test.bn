package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// checkSrcReturningFile mirrors checkSrc (in types_test.bn) but
// also returns the parsed File so capture-recording tests can
// walk the AST to locate the function-literal's synthetic Decl.
func checkSrcReturningFile(src *[]readonly char) (@Checker, @ast.File) {
	var srcBytes @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(srcBytes, "test.bn")
	var file @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.Check(file)
	return c, file
}

// findFirstFuncLit walks the parsed File's top-level Decls (and
// their function bodies) looking for the first EXPR_FUNC_LIT and
// returns the synthetic Decl attached via DeclRef.  Returns nil
// if no literal is found.
func findFirstFuncLit(file @ast.File) @ast.Decl {
	if file == nil { return nil }
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d == nil || d.Body == nil { continue }
		var r @ast.Decl = findFuncLitInStmt(d.Body)
		if r != nil { return r }
	}
	return nil
}

// findFuncLitInStmt recursively walks a Stmt subtree for the
// first EXPR_FUNC_LIT.  Covers all variant fields used by if /
// for / switch / block / decl-stmt so literals nested inside
// control flow are reachable.
func findFuncLitInStmt(s @ast.Stmt) @ast.Decl {
	if s == nil { return nil }
	for i := 0; i < len(s.Stmts); i++ {
		var r @ast.Decl = findFuncLitInStmt(s.Stmts[i])
		if r != nil { return r }
	}
	for i := 0; i < len(s.Exprs); i++ {
		var r @ast.Decl = findFuncLitInExpr(s.Exprs[i])
		if r != nil { return r }
	}
	for i := 0; i < len(s.Exprs2); i++ {
		var r @ast.Decl = findFuncLitInExpr(s.Exprs2[i])
		if r != nil { return r }
	}
	if s.X != nil {
		var r @ast.Decl = findFuncLitInExpr(s.X)
		if r != nil { return r }
	}
	if s.Init != nil {
		var r @ast.Decl = findFuncLitInStmt(s.Init)
		if r != nil { return r }
	}
	if s.Body != nil {
		var r @ast.Decl = findFuncLitInStmt(s.Body)
		if r != nil { return r }
	}
	if s.Else != nil {
		var r @ast.Decl = findFuncLitInStmt(s.Else)
		if r != nil { return r }
	}
	if s.Post != nil {
		var r @ast.Decl = findFuncLitInStmt(s.Post)
		if r != nil { return r }
	}
	for i := 0; i < len(s.Cases); i++ {
		var cc @ast.CaseClause = s.Cases[i]
		if cc == nil { continue }
		for j := 0; j < len(cc.Body); j++ {
			var r @ast.Decl = findFuncLitInStmt(cc.Body[j])
			if r != nil { return r }
		}
	}
	if s.DeclRef != nil && s.DeclRef.Value != nil {
		var r @ast.Decl = findFuncLitInExpr(s.DeclRef.Value)
		if r != nil { return r }
	}
	return nil
}

// findFuncLitInExpr recursively walks an Expr subtree.
func findFuncLitInExpr(e @ast.Expr) @ast.Decl {
	if e == nil { return nil }
	if e.Kind == ast.EXPR_FUNC_LIT && e.DeclRef != nil {
		return e.DeclRef
	}
	if e.X != nil {
		var r @ast.Decl = findFuncLitInExpr(e.X)
		if r != nil { return r }
	}
	if e.Y != nil {
		var r @ast.Decl = findFuncLitInExpr(e.Y)
		if r != nil { return r }
	}
	if e.Z != nil {
		var r @ast.Decl = findFuncLitInExpr(e.Z)
		if r != nil { return r }
	}
	for i := 0; i < len(e.Args); i++ {
		var r @ast.Decl = findFuncLitInExpr(e.Args[i])
		if r != nil { return r }
	}
	return nil
}

// Tests for checkFuncLit (Slice A.7 of plan-function-values).
// Type-check-only — IR-gen for function literals lands in A.7.b.

// Non-capturing function literal type-checks cleanly.
func TestCheckFuncLitNonCapturing() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var f *func(int) int = func(x int) int { return x * 2 }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Function literal with multi-return signature.
func TestCheckFuncLitMultiReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var f *func(int) (int, int) = func(x int) (int, int) { return x, x }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Function literal can reference package-level decls.
func TestCheckFuncLitReferencesPackageScope() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func double(x int) int { return x * 2 }\n"
		"func main() {\n"
		"  var f *func(int) int = func(x int) int { return double(x) + 1 }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Capture from the enclosing function: type-checks cleanly and the
// captured name appears on the literal's Decl.Captures.  Phase 2
// B.1 (plan-function-values-phase-2.md) replaced the Phase 1
// rejection with capture analysis.
func TestCheckFuncLitCapturesEnclosingLocal() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 10\n"
		"  var f *func(int) int = func(y int) int { return x + y }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	// Find the literal's Decl and verify the capture entry.
	var lit @ast.Decl = findFirstFuncLit(file)
	if lit == nil { return fail("no function literal found") }
	if len(lit.Captures) != 1 {
		return fail("expected 1 capture, got more or fewer")
	}
	if !streq(lit.Captures[0].Name, "x") {
		return fail("expected capture name `x`")
	}
	if lit.Captures[0].Kind != ast.CAP_VAL {
		return fail("expected CAP_VAL for int capture")
	}
	return ""
}

// Capture from an outer scope, referenced from inside a nested
// block within the literal body.  The walk through nested blocks
// up to the literal body must not record a spurious local hit.
func TestCheckFuncLitCapturesThroughNestedBlock() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 10\n"
		"  if x > 0 {\n"
		"    var f *func() int = func() int { return x }\n"
		"    _ = f\n"
		"  }\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var lit @ast.Decl = findFirstFuncLit(file)
	if lit == nil { return fail("no function literal found") }
	if len(lit.Captures) != 1 {
		return fail("expected 1 capture for `x`")
	}
	if !streq(lit.Captures[0].Name, "x") {
		return fail("expected capture name `x`")
	}
	return ""
}

// Locals declared INSIDE the literal body are not captures, even
// though they're reached via a nested block.
func TestCheckFuncLitInnerLocalsAreNotCaptures() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var f *func(int) int = func(x int) int {\n"
		"    var y int = x * 2\n"
		"    if y > 0 { return y } else { return 0 }\n"
		"  }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var lit @ast.Decl = findFirstFuncLit(file)
	if lit == nil { return fail("no function literal found") }
	if len(lit.Captures) != 0 {
		return fail("expected no captures (only own params/locals used)")
	}
	return ""
}

// Package-level references stay non-captures — they resolve at
// PackageScope, not via any enclosing-function frame.
func TestCheckFuncLitPackageRefsAreNotCaptures() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func double(x int) int { return x * 2 }\n"
		"func main() {\n"
		"  var f *func(int) int = func(x int) int { return double(x) }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var lit @ast.Decl = findFirstFuncLit(file)
	if lit == nil { return fail("no function literal found") }
	if len(lit.Captures) != 0 {
		return fail("package-level `double` should not be a capture")
	}
	return ""
}

// Managed pointer captures get CAP_MANAGED (will drive RefInc /
// RefDec emission in B.2 / B.3).
func TestCheckFuncLitCaptureKindManaged() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Box struct { N int }\n"
		"func main() {\n"
		"  var b @Box = make(Box)\n"
		"  var f *func() int = func() int { return b.N }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var lit @ast.Decl = findFirstFuncLit(file)
	if lit == nil { return fail("no function literal found") }
	if len(lit.Captures) != 1 {
		return fail("expected 1 capture `b`")
	}
	if lit.Captures[0].Kind != ast.CAP_MANAGED {
		return fail("expected CAP_MANAGED for @Box capture")
	}
	return ""
}

// Captures are deduplicated by name — referencing the same local
// twice yields one Capture entry.
func TestCheckFuncLitCaptureDedup() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 10\n"
		"  var f *func() int = func() int { return x + x + x }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var lit @ast.Decl = findFirstFuncLit(file)
	if lit == nil { return fail("no function literal found") }
	if len(lit.Captures) != 1 {
		return fail("expected 1 dedup'd capture for `x`")
	}
	return ""
}

// Function literal can reference its own params and locals.
func TestCheckFuncLitOwnLocals() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var f *func(int) int = func(x int) int {\n"
		"    var doubled int = x * 2\n"
		"    return doubled\n"
		"  }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Missing-return on a literal that declares a result is reported.
func TestCheckFuncLitMissingReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var f *func(int) int = func(x int) int {\n"
		"    var _ int = x\n"
		"  }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Capture from an enclosing function parameter (not a local var).
// Params live in the enclosing function's body scope, so the same
// capture rules apply — referencing one inside a literal records
// a capture on the literal's Decl.
func TestCheckFuncLitCapturesEnclosingParam() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func adderFor(base int) {\n"
		"  var f *func(int) int = func(x int) int { return base + x }\n"
		"  _ = f\n"
		"}\n"
		"func main() { adderFor(10) }\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var lit @ast.Decl = findFirstFuncLit(file)
	if lit == nil { return fail("no function literal found") }
	if len(lit.Captures) != 1 {
		return fail("expected 1 capture for `base`")
	}
	if !streq(lit.Captures[0].Name, "base") {
		return fail("expected capture name `base`")
	}
	if lit.Captures[0].Kind != ast.CAP_VAL {
		return fail("expected CAP_VAL for int param capture")
	}
	return ""
}

// Capture of a raw pointer to a local — kind is CAP_RAW_PTR
// (the closure holds the raw pointer; lifetime is the user's
// responsibility).  End-to-end check of the kind-from-type path.
func TestCheckFuncLitCaptureKindRawPtr() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 7\n"
		"  var p *int = &x\n"
		"  var f *func() int = func() int { return *p }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var lit @ast.Decl = findFirstFuncLit(file)
	if lit == nil { return fail("no function literal found") }
	if len(lit.Captures) != 1 {
		return fail("expected 1 capture for `p`")
	}
	if lit.Captures[0].Kind != ast.CAP_RAW_PTR {
		return fail("expected CAP_RAW_PTR for *int capture")
	}
	return ""
}

// Capture entry has a populated ResolvedTypeID pointing at the
// captured type in Checker.ExprTypes — IR-gen consumes this via
// the same currentChecker.ExprType(id) path used by Expr.
func TestCheckFuncLitCaptureResolvedTypeID() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 42\n"
		"  var f *func() int = func() int { return x }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var lit @ast.Decl = findFirstFuncLit(file)
	if lit == nil { return fail("no function literal found") }
	if len(lit.Captures) != 1 {
		return fail("expected 1 capture")
	}
	var cap @ast.Capture = lit.Captures[0]
	if cap.ResolvedTypeID <= 0 {
		return fail("expected non-zero ResolvedTypeID")
	}
	var captureTyp @Type = c.ExprType(cap.ResolvedTypeID)
	if captureTyp == nil {
		return fail("ExprType returned nil for capture's TypeID")
	}
	if !captureTyp.IsInteger() {
		return fail("expected capture type to be integer")
	}
	return ""
}

// Nested literal capture cascade: when an INNER literal captures
// a name defined OUTSIDE the outer literal too, both literals
// must record the capture so the outer's closure-struct passes
// the value through to the inner's.
func TestCheckFuncLitNestedCaptureCascade() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 1\n"
		"  var outer *func() *func() int = func() *func() int {\n"
		"    return func() int { return x }\n"
		"  }\n"
		"  _ = outer\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	// findFirstFuncLit returns the FIRST literal in source order.
	// In this source that's the OUTER literal — it appears first
	// in the parse tree even though the inner is nested in its
	// body.  Verify it captured `x` to pass through to the inner.
	var outerLit @ast.Decl = findFirstFuncLit(file)
	if outerLit == nil { return fail("no outer literal found") }
	if len(outerLit.Captures) != 1 {
		return fail("outer literal must cascade-capture `x`")
	}
	if !streq(outerLit.Captures[0].Name, "x") {
		return fail("outer's capture should be `x`")
	}
	// The inner literal — also captures `x` (directly, from its
	// view this is an outside reference).
	var innerLit @ast.Decl = findFuncLitInStmt(outerLit.Body)
	if innerLit == nil { return fail("no inner literal found") }
	if len(innerLit.Captures) != 1 {
		return fail("inner literal must capture `x`")
	}
	if !streq(innerLit.Captures[0].Name, "x") {
		return fail("inner's capture should be `x`")
	}
	return ""
}

// Cascade stops at the frame that owns the name.  When an inner
// literal references a local defined in the OUTER literal's body,
// the outer must NOT also record the same name as a capture
// (it's local to outer's frame).
func TestCheckFuncLitNestedCaptureStopsAtOwner() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var f *func() *func() int = func() *func() int {\n"
		"    var localToOuter int = 7\n"
		"    return func() int { return localToOuter }\n"
		"  }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var outerLit @ast.Decl = findFirstFuncLit(file)
	if outerLit == nil { return fail("no outer literal found") }
	if len(outerLit.Captures) != 0 {
		return fail("outer must not capture its own local")
	}
	var innerLit @ast.Decl = findFuncLitInStmt(outerLit.Body)
	if innerLit == nil { return fail("no inner literal found") }
	if len(innerLit.Captures) != 1 {
		return fail("inner must capture `localToOuter`")
	}
	if !streq(innerLit.Captures[0].Name, "localToOuter") {
		return fail("inner's capture should be `localToOuter`")
	}
	return ""
}

// B.3b: when the destination is @func and the literal's signature
// matches, the literal resolves as @func.  Pin via the literal's
// resolved type — TYP_MANAGED_FUNC_VALUE for the @func slot,
// TYP_FUNC_VALUE for *func.
func TestCheckFuncLitHintResolvesAsManagedFunc() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var f @func(int) int = func(x int) int { return x }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var litExpr @ast.Expr = findFirstFuncLitExpr(file)
	if litExpr == nil { return fail("literal Expr not found") }
	var t @Type = c.ExprType(litExpr.ResolvedTypeID)
	if t == nil { return fail("literal type unresolved") }
	if t.Kind != TYP_MANAGED_FUNC_VALUE {
		return fail("expected TYP_MANAGED_FUNC_VALUE for @func slot")
	}
	return ""
}

// Default (no hint, *func destination) keeps the raw form.  Pinned
// alongside the @func case so the routing's both-direction.
func TestCheckFuncLitDefaultsToRawFunc() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var f *func(int) int = func(x int) int { return x }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var litExpr @ast.Expr = findFirstFuncLitExpr(file)
	if litExpr == nil { return fail("literal Expr not found") }
	var t @Type = c.ExprType(litExpr.ResolvedTypeID)
	if t == nil { return fail("literal type unresolved") }
	if t.Kind != TYP_FUNC_VALUE {
		return fail("expected TYP_FUNC_VALUE for *func slot")
	}
	return ""
}

// B.3b context-propagation extension to plain assignment: a func literal
// RHS of `f = func(...){...}` (f being @func(...)) resolves as @func,
// matching the var-init / return / call-arg sites.  Pre-extension the
// simple-assign loop checked the RHS without the LHS hint, so the literal
// defaulted to *func and the assignability check then rejected it.
func TestCheckFuncLitHintPropagatesThroughAssign() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var f @func(int) int\n"
		"  f = func(x int) int { return x }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var litExpr @ast.Expr = findFirstFuncLitExpr(file)
	if litExpr == nil { return fail("literal Expr not found") }
	var t @Type = c.ExprType(litExpr.ResolvedTypeID)
	if t == nil { return fail("literal type unresolved") }
	if t.Kind != TYP_MANAGED_FUNC_VALUE {
		return fail("expected TYP_MANAGED_FUNC_VALUE for @func assign")
	}
	return ""
}

// The default direction: a plain `=` assign to a *func LHS keeps the raw
// form (the hint only upgrades to @func when the LHS is managed).
func TestCheckFuncLitAssignDefaultsToRawFunc() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var f *func(int) int\n"
		"  f = func(x int) int { return x }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var litExpr @ast.Expr = findFirstFuncLitExpr(file)
	if litExpr == nil { return fail("literal Expr not found") }
	var t @Type = c.ExprType(litExpr.ResolvedTypeID)
	if t == nil { return fail("literal type unresolved") }
	if t.Kind != TYP_FUNC_VALUE {
		return fail("expected TYP_FUNC_VALUE for *func assign")
	}
	return ""
}

// B.3b context-propagation extension to return statements: a
// function literal in tail position of `return <lit>` from a
// function declaring `@func(...)` returns resolves the literal as
// @func, matching the VarDecl propagation.  Pre-extension only
// `var x @func(...) = <lit>` propagated; bare `return` defaulted
// to *func and the assignability check then failed.
func TestCheckFuncLitHintPropagatesThroughReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func makeAdder(b int) @func(int) int {\n"
		"  return func(x int) int { return b + x }\n"
		"}\n"
		"func main() {}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var litExpr @ast.Expr = findFirstFuncLitExpr(file)
	if litExpr == nil { return fail("literal Expr not found") }
	var t @Type = c.ExprType(litExpr.ResolvedTypeID)
	if t == nil { return fail("literal type unresolved") }
	if t.Kind != TYP_MANAGED_FUNC_VALUE {
		return fail(
			"expected TYP_MANAGED_FUNC_VALUE — return slot's @func hint should propagate")
	}
	return ""
}

// B.3b context-propagation extension to call args: a function
// literal passed as an argument to a function whose matching
// parameter is `@func(...)` resolves the literal as @func.
// Pre-extension, the literal would default to *func and the
// assignability check would fail (or the literal would silently
// stack-alloc).
func TestCheckFuncLitHintPropagatesThroughCallArg() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func runWith(f @func(int) int, x int) int {\n"
		"  return f(x)\n"
		"}\n"
		"func main() {\n"
		"  var k int = 1\n"
		"  var r int = runWith(func(x int) int { return k + x }, 0)\n"
		"  _ = r\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var litExpr @ast.Expr = findFirstFuncLitExpr(file)
	if litExpr == nil { return fail("literal Expr not found") }
	var t @Type = c.ExprType(litExpr.ResolvedTypeID)
	if t == nil { return fail("literal type unresolved") }
	if t.Kind != TYP_MANAGED_FUNC_VALUE {
		return fail(
			"expected TYP_MANAGED_FUNC_VALUE — call-arg @func param hint should propagate")
	}
	return ""
}

// Return-position with *func hint stays raw — keep both directions
// pinned so a future change can't accidentally promote everything
// to @func.
func TestCheckFuncLitReturnDefaultsToRawFunc() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func makeAdder(b int) *func(int) int {\n"
		"  return func(x int) int { return b + x }\n"
		"}\n"
		"func main() {}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var litExpr @ast.Expr = findFirstFuncLitExpr(file)
	if litExpr == nil { return fail("literal Expr not found") }
	var t @Type = c.ExprType(litExpr.ResolvedTypeID)
	if t == nil { return fail("literal type unresolved") }
	if t.Kind != TYP_FUNC_VALUE {
		return fail("expected TYP_FUNC_VALUE for *func return slot")
	}
	return ""
}

// Signature-mismatch with @func hint: the destination wants
// @func(int) bool but the literal returns int.  Must surface
// as an assignability error.  Before the Type.Identical fix
// (binate <commit>) this incorrectly accepted because
// `Identical` had no TYP_FUNC_VALUE / TYP_MANAGED_FUNC_VALUE
// branch — two same-kind values fell through to the catchall
// `return true`, erasing param / result differences.
func TestCheckFuncLitHintMismatchFallsThrough() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var f @func(int) bool = func(x int) int { return x }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Helper: find the first EXPR_FUNC_LIT Expr node (vs Decl).  Used
// by the B.3b hint tests to inspect ResolvedTypeID.
func findFirstFuncLitExpr(file @ast.File) @ast.Expr {
	if file == nil { return nil }
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d == nil || d.Body == nil { continue }
		var r @ast.Expr = findFuncLitExprInStmt(d.Body)
		if r != nil { return r }
	}
	return nil
}

func findFuncLitExprInStmt(s @ast.Stmt) @ast.Expr {
	if s == nil { return nil }
	for i := 0; i < len(s.Stmts); i++ {
		var r @ast.Expr = findFuncLitExprInStmt(s.Stmts[i])
		if r != nil { return r }
	}
	for i := 0; i < len(s.Exprs); i++ {
		var r @ast.Expr = findFuncLitExprInExpr(s.Exprs[i])
		if r != nil { return r }
	}
	// Exprs2 holds the RHS of an assignment (`f = func(){...}`), so the
	// walk must descend it to reach an assign-RHS literal — mirrors
	// findFuncLitInStmt.
	for i := 0; i < len(s.Exprs2); i++ {
		var r @ast.Expr = findFuncLitExprInExpr(s.Exprs2[i])
		if r != nil { return r }
	}
	if s.X != nil {
		var r @ast.Expr = findFuncLitExprInExpr(s.X)
		if r != nil { return r }
	}
	if s.Init != nil {
		var r @ast.Expr = findFuncLitExprInStmt(s.Init)
		if r != nil { return r }
	}
	if s.Body != nil {
		var r @ast.Expr = findFuncLitExprInStmt(s.Body)
		if r != nil { return r }
	}
	if s.DeclRef != nil && s.DeclRef.Value != nil {
		return findFuncLitExprInExpr(s.DeclRef.Value)
	}
	return nil
}

func findFuncLitExprInExpr(e @ast.Expr) @ast.Expr {
	if e == nil { return nil }
	if e.Kind == ast.EXPR_FUNC_LIT { return e }
	if e.X != nil {
		var r @ast.Expr = findFuncLitExprInExpr(e.X)
		if r != nil { return r }
	}
	if e.Y != nil {
		var r @ast.Expr = findFuncLitExprInExpr(e.Y)
		if r != nil { return r }
	}
	for i := 0; i < len(e.Args); i++ {
		var r @ast.Expr = findFuncLitExprInExpr(e.Args[i])
		if r != nil { return r }
	}
	return nil
}
