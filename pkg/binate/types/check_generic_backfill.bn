package "pkg/binate/types"

import "pkg/binate/ast"

// Method back-fill for generic-type instantiations, split out of
// check_generic_type.bn for file-length hygiene.  A generic type instantiated
// (as a var/field/param/receiver type) DURING pass-1 collection is cached before
// some — or all — of its method decls are attached to its placeholder, so the
// cached instantiation can be method-less or only partially populated.
// backfillInstantiationMethods re-syncs every such instantiation at the end of
// collectDecls, once all generic-receiver methods are attached; copyPlaceholderMethods
// does the substitute-and-copy for one instantiation (and is also the populate-time
// path, from populateInstantiatedStruct).

// copyPlaceholderMethods substitutes the generic type `d`'s placeholder
// (abstract) methods onto an instantiation `named` (binder→args via
// substituteTypeParams, which matches type params by index).  It back-fills only
// the methods MISSING from `named` — AddMethod is a no-op on a name already
// present (check_types AddMethod dedups by name) — so it is idempotent and safe
// to call both when an instantiation is first populated and again from the
// post-collection back-fill.  The re-sync matters because an instantiation forced
// by a top-level var/field/param/receiver type is cached DURING pass-1 collection,
// possibly before some of its method decls are attached to the placeholder: a
// method decl BEFORE the forcing site is copied at populate time, one AFTER is
// added later — so `named` can be PARTIALLY populated, which is why the guard is
// "copy the missing ones", NOT "skip if any are present".  Without this a
// `.Method()` on such an instantiation would be spuriously rejected as undefined.
func copyPlaceholderMethods(c @Checker, d @ast.Decl, args @[]@Type, named @Type) {
	if named == nil || named.Kind != TYP_NAMED {
		return
	}
	// The consumer-scope placeholder (holding d's abstract methods) exists only in
	// d's OWN defining package.  c.GenericInstantiations accumulates across every
	// checked package, and backfillInstantiationMethods re-syncs the WHOLE list under
	// the current package's scope — so for an instantiation of a DIFFERENT package's
	// generic, c.Scope.Lookup(d.Name) would return a SAME-NAMED placeholder from the
	// current package (the wrong type, whose methods reference a different `T` with a
	// different constraint), which then instantiates d with that foreign `T` and
	// spuriously reports "type argument T does not satisfy constraint ...".  Trust
	// the by-name scope lookup only when d is a CURRENT-package generic; otherwise d
	// is imported — resolve its own stashed method decls (copyImportedGenericMethods).
	if charEq(genericTypeDeclPkg(c, d), c.curPkgPath) {
		var phSym @Symbol = c.Scope.Lookup(d.Name)
		if phSym != nil && phSym.Type != nil && phSym.Type.Kind == TYP_NAMED {
			var placeholder @Type = phSym.Type
			for i := 0; i < len(placeholder.Methods); i++ {
				var pm @Method = placeholder.Methods[i]
				var subFt @Type = substituteTypeParams(c, pm.FuncType, args)
				var subRecv @Type = substituteTypeParams(c, pm.RecvType, args)
				named.AddMethod(MakeMethod(pm.Name, subRecv, subFt))
			}
			return
		}
	}
	// No trustworthy consumer-scope placeholder — this is an IMPORTED generic type.
	// Resolve its stashed method decls with the concrete args (copyImportedGenericMethods).
	copyImportedGenericMethods(c, d, named)
}

// copyImportedGenericMethods attaches an imported generic type's methods onto an
// instantiation `named`, resolved with the concrete args.  The imported type has
// no consumer-scope placeholder, so instead of copying abstract methods and
// substituting, it resolves each stashed method decl's signature under the
// populate scope — which populateInstantiatedStruct has already set to the
// generic's DEFINING-file imports with each type-param bound to its concrete arg,
// so the signature resolves straight to the instantiation (e.g. `Get() T`
// resolves `T` to `int`).  Idempotent (skips methods already present).
func copyImportedGenericMethods(c @Checker, d @ast.Decl, named @Type) {
	var definingPkg @[]char = genericTypeDeclPkg(c, d)
	for i := 0; i < len(c.ImportedGenericMethodDecls); i++ {
		if !charEq(c.ImportedGenericMethodDeclPkgs[i], definingPkg) {
			continue
		}
		var mdecl @ast.Decl = c.ImportedGenericMethodDecls[i]
		var inst @ast.TypeExpr = receiverBaseInstantiation(mdecl.Recv.Type)
		if inst == nil || inst.Base == nil || !charEq(inst.Base.Name, d.Name) {
			continue
		}
		if named.LookupMethod(mdecl.Name) != nil {
			continue
		}
		// The method may RENAME the type's params in its receiver
		// (`func (p @Pair[A, B]) First() A` on `type Pair[K, V]`): A/B are the
		// method's own binder names.  The populate scope only binds K/V → args, so
		// alias each of the method's binder names to the same concrete arg (via the
		// type param it stands in for) before resolving the signature.  SNAPSHOT the
		// args from the populate scope FIRST, then install the aliases: a binder
		// name may collide with a SIBLING type param's name (a swap `@Pair[V, K]`),
		// and looking a name up in the same scope aliases are written into would let
		// an earlier binder shadow a later lookup.
		var binderArgs @[]@Type = make_slice(@Type, len(d.TypeParams))
		for j := 0; j < len(d.TypeParams); j++ {
			var sym @Symbol = c.Scope.Lookup(d.TypeParams[j].Name)
			if sym != nil {
				binderArgs[j] = sym.Type
			}
		}
		pushScope(c)
		for j := 0; j < len(inst.TypeArgs) && j < len(binderArgs); j++ {
			var binder @ast.TypeExpr = inst.TypeArgs[j]
			if binder != nil && binder.Kind == ast.TEXPR_NAMED && binderArgs[j] != nil {
				defineType(c.Scope, binder.Name, binderArgs[j])
			}
		}
		var recvType @Type = resolveTypeExpr(c, mdecl.Recv.Type)
		var ft @Type = resolveFuncDeclType(c, mdecl)
		popScope(c)
		var combined @[]@Param = prependRecvParam(mdecl.Recv.Name, recvType, ft.Params)
		var methodFuncType @Type = MakeFuncType(combined, ft.Results)
		named.AddMethod(MakeMethod(mdecl.Name, recvType, methodFuncType))
	}
}

// backfillInstantiationMethods re-syncs every generic-struct instantiation that
// was cached method-less because it was forced (by a var/field/param/receiver
// type) before the generic type's method decls were collected.  Run once at the
// end of collectDecls, when every generic-receiver method is attached to its
// placeholder.  This closes the population-ordering hazard for both concrete
// instantiations (`Box[int]` used as a global-var/field/param type before the
// method decl) and the abstract self-shell (`Box[T]` built during the first
// method's receiver resolution, before any method is on the placeholder — which
// is what lets a method body call a sibling method or itself).
func backfillInstantiationMethods(c @Checker) {
	for i := 0; i < len(c.GenericInstantiations); i++ {
		var entry @GenericInstantiation = c.GenericInstantiations[i]
		if entry == nil {
			continue
		}
		copyPlaceholderMethods(c, entry.Decl, entry.TypeArgs, entry.Result)
	}
}
