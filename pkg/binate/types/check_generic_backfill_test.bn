package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for the method-population back-fill (check_generic_backfill.bn): a
// generic instantiation forced by a var/field/param/receiver type before (some
// of) its methods are collected must still expose the full method set after
// collection.  Shared helpers (checkSrc / expectNoErrors) live in types_test.bn.

// An instantiation used as a global-var type BEFORE its method decl is collected
// still resolves the method: the post-collection back-fill re-syncs the
// method-less-cached instantiation (the population-ordering hazard — without the
// back-fill `g.Get()` is spuriously `undefined`).
func TestCheckGenericInstMethodOrderingBackfill() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"var g Box[int]\n"
			"func (b *Box[T]) Get() T { return b.v }\n"
			"func use() int {\n"
			"g.v = 1\n"
			"return g.Get()\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A generic type's method body may call a SIBLING method on its receiver: the
// abstract self-shell `Box[T]` exposes the type's own method set (after the
// back-fill), so `b.Get()` inside another method resolves.
func TestCheckGenericTypeMethodSiblingCall() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"func (b *Box[T]) Get() T { return b.v }\n"
			"func (b *Box[T]) Twice() T { return b.Get() }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// An instantiation forced (as a var type) BETWEEN two method decls is cached
// partially populated — only the earlier method (Get).  The back-fill must add
// the later one (Set) too, or `g.Set(...)` is spuriously `undefined`.  Exercises
// copyPlaceholderMethods's back-fill-missing (not skip-if-any) behavior.
func TestCheckGenericInstMethodInterleavedBackfill() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"func (b *Box[T]) Get() T { return b.v }\n"
			"var g Box[int]\n"
			"func (b *Box[T]) Set(x T) { b.v = x }\n"
			"func use() int {\n"
			"g.Set(3)\n"
			"return g.Get()\n"
			"}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}
