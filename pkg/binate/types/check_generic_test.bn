package "pkg/binate/types"

import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for generic-instantiation type checking — Slice 2b of
// plan-generics.md.  These exercise the call path
// `f[T1, ...](args)`: head resolves to a generic FUNC symbol,
// brackets carry type-args, instantiateGenericFunc substitutes
// type params with concrete @Types, the resulting FUNC type
// drives the caller's arg type-checking.
//
// Slice-1 parser test files (parse_func_test.bn,
// parse_expr_test.bn) cover the syntactic shape.  Slice-2a's
// generic-decl body checks live in check_decl_func_test.bn.

// Basic instantiation with a single primitive type arg.
func TestCheckGenericInstantiateIdentInt() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func id[T any](x T) T { return x }\n"
		"func main() { var y int = id[int](5) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Two type-params, one passed as result, one ignored.
func TestCheckGenericInstantiateTwoParams() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func pickFirst[T any, U any](x T, y U) T { return x }\n"
		"func main() { var z int = pickFirst[int, bool](1, true) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Pointer type arg: `id[*int](&x)`.
func TestCheckGenericInstantiatePointerTypeArg() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func id[T any](x T) T { return x }\n"
		"func main() { var x int; var p *int = id[*int](&x) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A generic function whose RESULT type names a generic struct
// instantiated with the function's own type parameter (`Vec[T]`)
// must substitute the type arg, so `newVal[int]()` yields `Vec[int]`
// and assigns to a `Vec[int]` variable.  Regression: before
// substituteTypeParams recursed into the nested instantiation's
// args, the result stayed `Vec[T]` and this failed with
// `cannot assign Vec[T] to Vec[int]`.
func TestCheckGenericStructResultInGenericFunc() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Vec[T any] struct { first T; n int }\n"
		"func newVal[T any]() Vec[T] { var v Vec[T]; return v }\n"
		"func main() { var a Vec[int] = newVal[int]() }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// The managed result form `@Vec[T]` substitutes the same way.
func TestCheckGenericManagedStructResultInGenericFunc() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Vec[T any] struct { first T; n int }\n"
		"func newBox[T any]() @Vec[T] { return make(Vec[T]) }\n"
		"func main() { var a @Vec[int] = newBox[int]() }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A generic struct over the function's own type parameter in
// PARAMETER position (both value `Vec[T]` and the `Push`-style
// managed `@Vec[T]`) substitutes so concrete-instantiation args
// type-check against it.
func TestCheckGenericStructParamInGenericFunc() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Vec[T any] struct { first T; n int }\n"
		"func getN[T any](v Vec[T]) int { return v.n }\n"
		"func bump[T any](v @Vec[T], by int) { v.n = v.n + by }\n"
		"func main() {\n"
		"\tvar a Vec[int]\n"
		"\tvar b @Vec[int] = make(Vec[int])\n"
		"\tvar k int = getN[int](a)\n"
		"\tbump[int](b, k)\n"
		"}\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// The substitution must produce the SPECIFIC instantiation, not just
// any `Vec[...]`: `newVal[int]()` is `Vec[int]`, which is NOT
// assignable to `Vec[bool]`.  Guards against a fix that drops the
// type arg entirely (which would make every `Vec[X]` interchangeable).
func TestCheckGenericStructInGenericFuncMismatchRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Vec[T any] struct { first T; n int }\n"
		"func newVal[T any]() Vec[T] { var v Vec[T]; return v }\n"
		"func main() { var a Vec[bool] = newVal[int]() }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// The interface form of the substitution: a generic INTERFACE
// instantiated with the function's own type parameter inside an
// interface-value (`@Container[T]`) must substitute so a matching
// concrete impl assigns to the parameter.  Regression: before
// substituteTypeParams recursed into the interface-value wrapper,
// `@Container[T]` stayed unsubstituted and the call was rejected.
func TestCheckGenericIfaceParamInGenericFunc() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Container[T any] { get() T }\n"
		"type IntBox struct { v int }\n"
		"impl @IntBox : Container[int]\n"
		"func (b @IntBox) get() int { return b.v }\n"
		"func useIt[T any](c @Container[T]) T { return c.get() }\n"
		"func main() { var b @IntBox = make(IntBox); var k int = useIt[int](b) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// The interface substitution must produce the SPECIFIC instantiation:
// `useIt[bool]` takes `@Container[bool]`, which `@IntBox` (impl of
// Container[int]) does NOT satisfy.  Guards against leaving the type
// arg unsubstituted (which made any `@IntBox` assign to `@Container[T]`).
func TestCheckGenericIfaceInGenericFuncMismatchRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Container[T any] { get() T }\n"
		"type IntBox struct { v int }\n"
		"impl @IntBox : Container[int]\n"
		"func (b @IntBox) get() int { return b.v }\n"
		"func useIt[T any](c @Container[T]) T { return c.get() }\n"
		"func main() { var b @IntBox = make(IntBox); var k bool = useIt[bool](b) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A constrained generic that forwards its own type parameter as the
// type ARGUMENT to another generic with the SAME constraint must
// type-check: T's declared bound (Ord) IS the callee's constraint.
// Regression: before typeSatisfiesConstraint consulted a type-param's
// TpConstraint, the forwarded `mid[T]` was rejected with `type
// argument T does not satisfy constraint Ord`.
func TestCheckGenericConstraintForwardedSameConstraint() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Cmp { f() int }\n"
		"interface Ord : Cmp {}\n"
		"func mid[T Ord](a T) int { return 0 }\n"
		"func top[T Ord](a T) int { return mid[T](a) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Forwarding a STRONGER-bounded type param (Ord) to a callee with a
// WEAKER constraint (Cmp) is accepted via interface inheritance
// (Ord extends Cmp).  Exercises the isDescendantInterface arm of the
// type-param branch.
func TestCheckGenericConstraintForwardedStrongerBound() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Cmp { f() int }\n"
		"interface Ord : Cmp {}\n"
		"func base[T Cmp](a T) int { return 0 }\n"
		"func top[T Ord](a T) int { return base[T](a) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// The widening must not go too far: forwarding a WEAKER-bounded type
// param (Cmp) to a callee with a STRONGER constraint (Ord) is
// rejected — Cmp does not extend Ord.  Guards against accepting any
// type-param regardless of its bound.
func TestCheckGenericConstraintForwardedWeakerBoundRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Cmp { f() int }\n"
		"interface Ord : Cmp {}\n"
		"func strict[T Ord](a T) int { return 0 }\n"
		"func top[T Cmp](a T) int { return strict[T](a) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// An `any`-bounded type param satisfies no non-trivial constraint, so
// forwarding it to a constrained callee is rejected.
func TestCheckGenericConstraintForwardedFromAnyRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Cmp { f() int }\n"
		"func strict[T Cmp](a T) int { return 0 }\n"
		"func top[T any](a T) int { return strict[T](a) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// An instantiated generic interface records its (substituted) parents,
// so `WideBox[int] : Box[int]` is recognized as a descendant: a type
// param bounded by WideBox[int], forwarded to a Box[int]-constrained
// callee, is accepted.  Regression: before buildInstantiatedInterface
// populated `.Parents`, the instantiation looked like it extended
// nothing and this was wrongly rejected.
func TestCheckGenericIfaceInstantiationRecordsParents() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Box[T any] { get() T }\n"
		"interface WideBox[T any] : Box[T] { extra() int }\n"
		"func inner[T Box[int]](a T) int { return 0 }\n"
		"func outer[T WideBox[int]](a T) int { return inner[T](a) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// The recorded parents carry the right DIRECTION: the parent
// `Box[int]` does NOT extend the child `WideBox[int]`, so forwarding a
// `Box[int]`-bound param into a `WideBox[int]`-constrained callee is
// rejected.  Guards against a fix that records parents but loses the
// child/ancestor orientation.
func TestCheckGenericIfaceInstantiationParentDirectionRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Box[T any] { get() T }\n"
		"interface WideBox[T any] : Box[T] { extra() int }\n"
		"func inner[T WideBox[int]](a T) int { return 0 }\n"
		"func outer[T Box[int]](a T) int { return inner[T](a) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// A constraint that names another type parameter (`T Container[X]`)
// is substituted with the resolved args before the satisfaction
// check, so `use[int, @IntBox]` checks @IntBox against the concrete
// `Container[int]` (which it impls).  Regression: before the
// constraint was substituted, the unsubstituted `Container[X]` never
// matched and this was wrongly rejected.
func TestCheckGenericConstraintTypeParamArg() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Container[T any] { get() T }\n"
		"type IntBox struct { v int }\n"
		"impl @IntBox : Container[int]\n"
		"func (b @IntBox) get() int { return b.v }\n"
		"func use[X any, T Container[X]](a T) X { return a.get() }\n"
		"func main() { var b @IntBox = make(IntBox); var k int = use[int, @IntBox](b) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// The substituted constraint must be the SPECIFIC instantiation:
// `use[bool, @IntBox]` checks @IntBox against `Container[bool]`, which
// it does not impl (only `Container[int]`), so it is rejected.  Guards
// against substituting the wrong arg (or skipping the check).
func TestCheckGenericConstraintTypeParamArgMismatchRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Container[T any] { get() T }\n"
		"type IntBox struct { v int }\n"
		"impl @IntBox : Container[int]\n"
		"func (b @IntBox) get() int { return b.v }\n"
		"func use[X any, T Container[X]](a T) int { return 0 }\n"
		"func main() { var b @IntBox = make(IntBox); var k int = use[bool, @IntBox](b) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Two type params each used as the arg to a generic STRUCT must stay
// distinct: feeding a `Box[int]` into a `Box[bool]` parameter slot is
// rejected.  Regression: before Identical compared type params by
// (owner, index), Box[A] and Box[B] aliased in the cache, so the
// Box[B] param was typed Box[int] and this was wrongly ACCEPTED
// (unsound — the body would monomorphize y with the wrong type).
func TestCheckGenericTwoDistinctTypeParamStructsRejectUnsound() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Box[T any] struct { v T }\n"
		"func mk[T any](x T) Box[T] { var b Box[T]; b.v = x; return b }\n"
		"func combine[A any, B any](x Box[A], y Box[B]) int { return 0 }\n"
		"func main() { var bi Box[int] = mk[int](1); var k int = combine[int, bool](bi, bi) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Two type params each used as the arg to a generic-interface CONSTRAINT
// stay distinct, so a valid pairing (each impl matches its own
// instantiation) type-checks.  Regression: before the Identical fix,
// Container[X] and Container[Y] aliased, so U's constraint was checked
// against X's instantiation and this valid program was wrongly rejected.
func TestCheckGenericTwoDistinctTypeParamConstraints() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Container[T any] { get() T }\n"
		"type IB struct { v int }\n"
		"impl @IB : Container[int]\n"
		"func (b @IB) get() int { return b.v }\n"
		"type BB struct { v bool }\n"
		"impl @BB : Container[bool]\n"
		"func (b @BB) get() bool { return b.v }\n"
		"func use2[X any, Y any, T Container[X], U Container[Y]](a T, b U) int { return 0 }\n"
		"func main() {\n"
		"\tvar i @IB = make(IB)\n"
		"\tvar j @BB = make(BB)\n"
		"\tvar k int = use2[int, bool, @IB, @BB](i, j)\n"
		"}\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// The distinct-param constraints are checked against their OWN args:
// slotting @IB (Container[int]) into the U=Container[Y]=Container[bool]
// position is rejected.  Before the Identical fix this was an unsound
// ACCEPT (Container[Y] aliased to Container[int]).
func TestCheckGenericTwoDistinctTypeParamConstraintsRejectUnsound() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Container[T any] { get() T }\n"
		"type IB struct { v int }\n"
		"impl @IB : Container[int]\n"
		"func (b @IB) get() int { return b.v }\n"
		"func use2[X any, Y any, T Container[X], U Container[Y]](a T, b U) int { return 0 }\n"
		"func main() {\n"
		"\tvar i @IB = make(IB)\n"
		"\tvar k int = use2[int, bool, @IB, @IB](i, i)\n"
		"}\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Distinct type parameters are not interchangeable in a generic body:
// `var z A = y` (y has the OTHER param's type B) is rejected.  This is
// the most direct manifestation of the Identical type-param fix — body
// assignment routes through AssignableTo → Identical; before the fix
// every type-param pair compared identical, so B was wrongly assignable
// to A.
func TestCheckGenericDistinctTypeParamsNotAssignable() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func f[A any, B any](x A, y B) { var z A = y; _ = z }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Control for the above: assigning a type param to itself is fine.
func TestCheckGenericSameTypeParamAssignable() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func f[A any, B any](x A, y B) { var z A = x; _ = z }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A recursive generic struct (linked list — recursion behind a managed
// pointer) instantiates without looping: the cache pre-registers an
// in-progress placeholder so `Node[int]`'s `next @Node[int]` field
// resolves back to it.  Before that, this overflowed the stack.
func TestCheckGenericRecursiveStructAccepts() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Node[T any] struct { val T; next @Node[T] }\n"
		"func main() { var n Node[int]; n.val = 1; _ = n }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A generic interface extending its own instantiation is rejected with
// a clean diagnostic (the self-extension guard fires on the placeholder),
// not a stack overflow.
func TestCheckGenericIfaceSelfCycleRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface N[T any] : N[T] { get() T }\n"
		"func main() { var x *N[int]; _ = x }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Two generic interfaces that transitively extend each other through
// their instantiations are rejected (the in-progress cycle check drops
// the back-edge), not looped on in the ancestor-closure walk.
func TestCheckGenericIfaceMutualCycleRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface P[T any] : Q[T] { p() T }\n"
		"interface Q[T any] : P[T] { q() T }\n"
		"func main() { var x *P[int]; _ = x }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Wrong number of type args (one expected, two given) errors.
func TestCheckGenericInstantiateWrongArity() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func id[T any](x T) T { return x }\n"
		"func main() { var y int = id[int, bool](5) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Argument-type mismatch after substitution: `id[int]` expects an
// int, supplying a bool rejects.
func TestCheckGenericInstantiateArgTypeMismatch() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"func id[T any](x T) T { return x }\n"
		"func main() { var y int = id[int](true) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
