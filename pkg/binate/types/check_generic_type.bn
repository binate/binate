package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Generic TYPE instantiation: resolving `Name[T1, T2, ...]` to a
// concrete @Type (struct -> TYP_NAMED, interface -> TYP_INTERFACE),
// with a (decl, args) cache and an in-progress placeholder
// pre-registered before the body/parents are resolved so recursive
// references resolve to it instead of overflowing the stack, plus the
// per-decl lookups.  Generic-FUNCTION instantiation + constraint
// checking lives in check_generic.bn.

// resolveTypeInstantiation resolves a `Name[T1, T2, ...]` type
// expression to a concrete @Type by:
//   1. looking up the generic struct decl via name + package
//      (unqualified names only for Slice 5b — cross-package
//      generics land in Slice 7),
//   2. validating arg count against decl.TypeParams,
//   3. checking the cache; reusing a prior instantiation when
//      (decl, args) match by identity,
//   4. otherwise installing a type-param scope, resolving the
//      struct body fresh, wrapping in a TYP_NAMED, caching, and
//      returning.
// Per plan-generics.md Slice 5b.
func resolveTypeInstantiation(c @Checker, te @ast.TypeExpr) @Type {
	var head @ast.TypeExpr = te.Base
	if head == nil || head.Kind != ast.TEXPR_NAMED {
		addCheckError(c, te.Pos, "generic instantiation requires a named-type head")
		return TypVoid()
	}
	// Slice 7b/7c: pkg-qualified head.  Generic STRUCTS and INTERFACES are both
	// stashed under the FULL package path, so resolve a qualified head's import
	// alias to its path — two same-final-segment packages share a short name but
	// not a path (the same-segment collision), and a custom alias (`import g
	// "pkg/gen"; g.Holder[int]`) only reaches the decl once resolved.  An empty
	// qualifier (same-package) is left empty so the curPkgPath fallback in
	// lookupGeneric*DeclPkg handles it.
	var declPkg @[]char
	if len(head.Pkg) > 0 {
		var psym @Symbol = c.Scope.Lookup(head.Pkg)
		if psym != nil && psym.Kind == SYM_PKG {
			declPkg = psym.PkgPath
		} else {
			declPkg = head.Pkg
		}
	}
	var d @ast.Decl = lookupGenericTypeDeclPkg(c, declPkg, head.Name)
	var isIface bool = false
	if d == nil {
		d = lookupGenericIfaceDeclPkg(c, declPkg, head.Name)
		isIface = d != nil
	}
	if d == nil {
		errUndefined(c, head.Pos, head.Name)
		return TypVoid()
	}
	if len(te.TypeArgs) != len(d.TypeParams) {
		addCheckError(c, te.Pos, "wrong number of type arguments to generic type")
		return TypVoid()
	}
	var argTypes @[]@Type
	for i := 0; i < len(te.TypeArgs); i++ {
		var at @Type = resolveTypeExpr(c, te.TypeArgs[i])
		if at == nil { at = TypVoid() }
		argTypes = slices.Append[@Type](argTypes, at)
	}
	return instantiateGenericDeclWithArgs(c, d, isIface, argTypes, te.Pos)
}

// checkInstantiationConstraints verifies each concrete type-argument of a
// generic struct/interface instantiation satisfies its type-parameter's
// constraint -- the type-instantiation analogue of the check
// instantiateGenericFunc performs for generic functions.  Without it
// `type Box[T lang.Orderable] struct{...}` instantiated as `Box[NoOrder]`
// (no `impl NoOrder : Orderable`) is wrongly accepted
// (gen.satisfy.struct-iface-unchecked).
//
// Constraints are resolved under the generic decl's DEFINING-file scope and
// package (its imports / same-package interface names) with the type-params
// bound to their concrete args, so a constraint naming an earlier param
// (`[X any, T Container[X]]`) resolves to the concrete `Container[arg]`.
// Mirrors populateInstantiatedStruct's scope setup.  Generic type-param
// constraints are not resolved at decl time (the body is resolved lazily at
// instantiation), so this is their first resolution -- no double-reporting.
//
// usePos anchors the diagnostic at the instantiation site (the `Name[args]`
// expression), matching the function path's use-site anchoring -- not at the
// generic decl, which would be unhelpful and (because identical errors dedup
// on position) could collapse distinct bad use-sites to one message.
func checkInstantiationConstraints(c @Checker, d @ast.Decl, argTypes @[]@Type, usePos token.Pos) {
	if len(d.TypeParams) == 0 { return }
	var savedScope @Scope = c.Scope
	var savedPkgPath @[]char = c.curPkgPath
	c.curPkgPath = genericTypeDeclPkg(c, d)
	var defScope @Scope = lookupGenericDeclScope(c, d)
	if defScope != nil {
		c.Scope = NewScope(defScope)
	} else {
		pushScope(c)
	}
	for i := 0; i < len(d.TypeParams) && i < len(argTypes); i++ {
		defineType(c.Scope, d.TypeParams[i].Name, argTypes[i])
	}
	for i := 0; i < len(d.TypeParams) && i < len(argTypes); i++ {
		var constraint @Type = resolveTypeParamConstraint(c, d.TypeParams[i])
		if constraint == nil { continue }
		if !typeSatisfiesConstraint(c, argTypes[i], constraint) {
			reportConstraintMiss(c, usePos, argTypes[i], constraint)
		}
	}
	c.Scope = savedScope
	c.curPkgPath = savedPkgPath
}

// instantiateGenericDeclWithArgs returns the cached instantiation of
// generic decl d with the given concrete argTypes, building and
// caching it on a miss.  isIface selects interface vs struct
// construction.  Shared by resolveTypeInstantiation (the
// `Name[args]` type-expression path) and substituteTypeParams
// (re-instantiating a `Vec[T]`-shaped signature type when a generic
// function is instantiated), so both routes land on the same cached
// @Type and thus the same name-based identity.  usePos anchors any
// constraint diagnostic at the instantiation site.
//
// The result @Type (with its final mangled name + InstDecl/InstArgs)
// is created and registered in the cache BEFORE its body / parents are
// resolved, so a recursive reference to the SAME (decl, args) during
// that resolution — `type Node[T] struct { next @Node[T] }` (legit,
// behind a pointer) or `interface N[T] : N[T]` (illegal, caught by the
// self-extension guard) — resolves to this in-progress type instead of
// re-entering and overflowing the stack.  An infinitely-GROWING chain
// (`type Box[T] struct { inner @Box[Wrap[T]] }`) instead has different
// args at every level, so the cache never hits; the GenericInstDepth
// bound rejects it with a clean diagnostic.
func instantiateGenericDeclWithArgs(c @Checker, d @ast.Decl, isIface bool, argTypes @[]@Type,
		usePos token.Pos) @Type {
	var cached @Type = lookupCachedInstantiation(c, d, argTypes)
	if cached != nil { return cached }
	// Bound well below the native stack budget: each level adds several
	// resolver frames, so a high cap (e.g. 1024) overflows the stack
	// before the diagnostic fires.  128 is far above any realistic
	// hand-written generic nesting.
	if c.GenericInstDepth >= 128 {
		addCheckError(c, d.Pos,
				"generic instantiation nested too deeply (cyclic or unbounded type argument?)")
		return TypVoid()
	}
	// Create the result shell with its final identity, then register it
	// before populating (see the doc comment above for why).
	var result @Type
	if isIface {
		// Identity by DEFINING package (full path), not the consumer's — see
		// genericIfaceDeclPkg — so two same-final-segment packages' `C[int]`
		// are distinct interfaces and an impl of one is not matched to the other.
		result = MakeInterfaceType(genericIfaceDeclPkg(c, d), mangleInstantiatedName(d.Name, argTypes))
	} else {
		result = MakeNamedType(
				mangleInstantiatedName(
						QualifyName(genericTypeDeclPkg(c, d), d.Name), argTypes))
	}
	result.InstDecl = bit_cast(*uint8, d)
	result.InstArgs = argTypes
	var entry @GenericInstantiation = make(GenericInstantiation)
	entry.Decl = d
	entry.TypeArgs = argTypes
	entry.Result = result
	c.GenericInstantiations = slices.Append[@GenericInstantiation](
			c.GenericInstantiations, entry)

	c.GenericInstDepth = c.GenericInstDepth + 1
	// Constraint satisfaction (gen.satisfy, §12.4): each concrete type-arg
	// must satisfy its type-parameter's constraint, exactly as
	// instantiateGenericFunc enforces for generic FUNCTIONS.  Runs once per
	// unique (decl, args) -- after the cache check above -- so a repeated
	// `Box[NoOrder]` reports the miss once.  Build (populate*) still proceeds
	// after a miss so downstream field/method uses don't cascade.
	checkInstantiationConstraints(c, d, argTypes, usePos)
	if isIface {
		// Mark this instantiated interface as in-progress so a parent
		// reference that loops back to it (an inheritance cycle across
		// distinct instantiations) is detected in resolveInterfaceExtension.
		c.GenericIfacePopulating = slices.Append[@Type](
				c.GenericIfacePopulating, result)
		populateInstantiatedInterface(c, d, argTypes, result)
		c.GenericIfacePopulating = c.GenericIfacePopulating[0:len(c.GenericIfacePopulating) - 1]
	} else {
		populateInstantiatedStruct(c, d, argTypes, result)
	}
	c.GenericInstDepth = c.GenericInstDepth - 1
	return result
}

// lookupGenericIfaceDeclPkg finds a generic interface decl registered under
// (pkg, name).  Generic-iface decls are stashed under the FULL defining path
// (curPkgPath) — the imported ones by buildScopeFromFile, the current package's
// own by collectInterfaceDecl — so an unqualified (empty-pkg) request, which
// names the current package's OWN generics, resolves via the curPkgPath
// fallback below after the exact-key lookup misses.  Mirrors
// lookupGenericTypeDeclPkg.  Slice 7c.
func lookupGenericIfaceDeclPkg(c @Checker, pkg @[]char, name *[]readonly char) @ast.Decl {
	var d @ast.Decl = findGenericDeclKeyed(c.GenericIfaceDecls, c.GenericIfaceDeclPkgs, pkg, name)
	if d != nil {
		return d
	}
	if len(pkg) == 0 && len(c.curPkgPath) > 0 {
		return findGenericDeclKeyed(c.GenericIfaceDecls, c.GenericIfaceDeclPkgs, c.curPkgPath, name)
	}
	return nil
}

// lookupGenericDeclScope returns the defining-file import scope recorded for a
// generic struct/interface decl (parallel to GenericTypeDecls/GenericIfaceDecls),
// or nil.  The generic's body must resolve its package-qualified field/method
// types against THIS scope, not the use-site scope (which would bind a qualifier
// to the consumer's imports → wrong package / wrong layout).
func lookupGenericDeclScope(c @Checker, d @ast.Decl) @Scope {
	for i := 0; i < len(c.GenericTypeDecls); i++ {
		if same(c.GenericTypeDecls[i], d) {
			return c.GenericTypeDeclScopes[i]
		}
	}
	for i := 0; i < len(c.GenericIfaceDecls); i++ {
		if same(c.GenericIfaceDecls[i], d) {
			return c.GenericIfaceDeclScopes[i]
		}
	}
	var none @Scope
	return none
}

// populateInstantiatedInterface fills the pre-created (and already
// cache-registered) instantiated TYP_INTERFACE `iface` with its methods
// AND parent interfaces, each TYP_TYPE_PARAM substituted for the
// matching type-arg.  Pushes a per-decl type-param scope so the
// method-signature and parent resolution see T bound to its concrete
// @Type.  Per plan-generics.md Slice 6b.  `iface` is created and
// registered by instantiateGenericDeclWithArgs first so a recursive
// `interface N[T] : N[T]` resolves its parent back to this in-progress
// iface (and the self-extension guard rejects it) instead of looping.
//
// Generic interface decls are deferred at collectInterfaceDecl (no
// stable TYP_INTERFACE at decl time), so this is the sole place a
// generic interface's extension clause is resolved — hence the
// resolveInterfaceExtension call here rather than at decl time.
// Without it an instantiated `WideBox[int]` would have empty
// Parents, so isDescendantInterface would report it as extending
// nothing — wrongly rejecting a valid `@WideBox[int]` → `@Box[int]`
// upcast / constraint-satisfaction.
func populateInstantiatedInterface(c @Checker, d @ast.Decl, args @[]@Type, iface @Type) {
	// Resolve the body under the generic's DEFINING-file scope (its imports),
	// with type-params layered on top — not the use-site scope.
	var savedScope @Scope = c.Scope
	var defScope @Scope = lookupGenericDeclScope(c, d)
	if defScope != nil {
		c.Scope = NewScope(defScope)
	} else {
		pushScope(c)
	}
	for i := 0; i < len(d.TypeParams); i++ {
		defineType(c.Scope, d.TypeParams[i].Name, args[i])
	}
	// Same per-method pattern as collectInterfaceDecl: each
	// method is a stub DECL_FUNC; resolve its FuncType with the
	// type-param scope active so T → concrete in params/results.
	var prevAllowSelf bool = c.AllowSelf
	c.AllowSelf = true
	for i := 0; i < len(d.Decls); i++ {
		var m @ast.Decl = d.Decls[i]
		if m == nil || m.Kind != ast.DECL_FUNC { continue }
		var ft @Type = resolveFuncDeclType(c, m)
		// Reject a method whose (substituted) param / result embeds an opaque
		// value — `Getter[Opaque]` with `get() T`: calling it would form / pass
		// an opaque value.  A type-param used only behind `*T` / `@T` stays
		// legal.  See plan-opaque-step2.md.
		for j := 0; j < len(ft.Params); j++ {
			requireSizedType(c, ft.Params[j].Type, m.Pos)
		}
		for j := 0; j < len(ft.Results); j++ {
			requireSizedType(c, ft.Results[j], m.Pos)
		}
		var method @Method = MakeMethod(m.Name, iface, ft)
		iface.AddMethod(method)
	}
	c.AllowSelf = prevAllowSelf
	// Resolve the extension clause with the type-param scope still
	// active so a parent `Box[T]` substitutes to `Box[int]`; this
	// fills iface.Parents (and runs the same validation /
	// method-conflict checks as the non-generic path).
	resolveInterfaceExtension(c, d, iface)
	c.Scope = savedScope
}

// lookupGenericTypeDeclPkg finds a generic struct decl
// registered under (pkg, name).  Pkg empty matches same-package
// entries; an import alias matches a decl stashed by
// buildScopeFromFile when loading that package's .bni.
// Slice 7b.
//
// Same-package fallback: an unqualified (empty-pkg) request also
// names the current package's OWN generics.  buildScopeFromFile (the
// .bni interface-scope builder) keys a package's generic type/iface
// decls under its short name — so an importer's qualified
// `pkg.Box[…]` resolves — but the package's own function / var / const
// signatures in that same .bni reference those generics UNQUALIFIED
// (empty pkg).  Without the fallback the signature head resolves to
// `undefined` and the parameter/field type is recorded as `void`,
// while the impl-side pass (which stashes the same decl under the
// empty key via preRegisterTypeNames) records the real type — so the
// .bni↔.bn signature-match check reports a `void` vs `Box[…]`
// mismatch.  The fallback runs only after the exact-key lookup misses,
// so every previously-resolving lookup is unchanged.
func lookupGenericTypeDeclPkg(c @Checker, pkg @[]char, name *[]readonly char) @ast.Decl {
	var d @ast.Decl = findGenericDeclKeyed(c.GenericTypeDecls, c.GenericTypeDeclPkgs, pkg, name)
	if d != nil {
		return d
	}
	// Same-package fallback: an unqualified (empty-pkg) request names the
	// current package's OWN generics, which are stashed under the full
	// package path (curPkgPath) by both preRegisterTypeNames and
	// buildScopeFromFile.  Runs only after the exact-key miss.
	if len(pkg) == 0 && len(c.curPkgPath) > 0 {
		return findGenericDeclKeyed(c.GenericTypeDecls, c.GenericTypeDeclPkgs, c.curPkgPath, name)
	}
	return nil
}

// findGenericDeclKeyed scans the parallel (decls, pkgs) stash lists for
// the first entry whose source-text name equals `name` and whose
// pkg-key equals `pkg`.  Returns nil on no match.  Shared by the
// generic struct and generic interface lookups.
func findGenericDeclKeyed(decls @[]@ast.Decl, pkgs @[]@[]char, pkg @[]char,
		name *[]readonly char) @ast.Decl {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d == nil { continue }
		if !charEq(d.Name, name) { continue }
		var declPkg @[]char
		if i < len(pkgs) {
			declPkg = pkgs[i]
		}
		if !charEq(declPkg, pkg) { continue }
		return d
	}
	return nil
}

// genericTypeDeclPkg returns the full package path a generic struct decl was
// stashed under (its DEFINING package), so the instantiated type's name is
// qualified by the defining package — keeping aa.Box[int] and bb.Box[int]
// (same short name, different packages) distinct.  Falls back to the current
// package when d isn't found (e.g. a synthesized decl).
func genericTypeDeclPkg(c @Checker, d @ast.Decl) @[]char {
	for i := 0; i < len(c.GenericTypeDecls); i++ {
		if c.GenericTypeDecls[i] == d {
			if i < len(c.GenericTypeDeclPkgs) {
				return c.GenericTypeDeclPkgs[i]
			}
		}
	}
	return c.curPkgPath
}

// genericIfaceDeclPkg returns the full defining-package path of a generic
// INTERFACE decl (the iface analog of genericTypeDeclPkg), so an instantiated
// generic interface's nominal (Pkg, Name) identity keys on where the interface
// was DECLARED, not the consumer's package — otherwise two same-final-segment
// packages' `C[int]` collide and an impl of one is wrongly matched against the
// other.  Both the local and imported stashes key on the full path (curPkgPath),
// so a registered empty entry (should not occur) falls back to curPkgPath.
func genericIfaceDeclPkg(c @Checker, d @ast.Decl) @[]char {
	for i := 0; i < len(c.GenericIfaceDecls); i++ {
		if c.GenericIfaceDecls[i] == d {
			if i < len(c.GenericIfaceDeclPkgs) && len(c.GenericIfaceDeclPkgs[i]) > 0 {
				return c.GenericIfaceDeclPkgs[i]
			}
		}
	}
	return c.curPkgPath
}

// lookupCachedInstantiation walks c.GenericInstantiations looking
// for a (Decl, args) match — Decl pointer-equal AND each arg
// Identical.  Returns the cached Result or nil on miss.
func lookupCachedInstantiation(c @Checker, d @ast.Decl, args @[]@Type) @Type {
	for i := 0; i < len(c.GenericInstantiations); i++ {
		var entry @GenericInstantiation = c.GenericInstantiations[i]
		if entry == nil || entry.Decl != d { continue }
		if len(entry.TypeArgs) != len(args) { continue }
		var match bool = true
		for j := 0; j < len(args); j++ {
			if !entry.TypeArgs[j].Identical(args[j]) {
				match = false
				continue
			}
		}
		if match { return entry.Result }
	}
	return nil
}

// populateInstantiatedStruct fills the pre-created (and already
// cache-registered) instantiated TYP_NAMED `named` with the generic
// decl's struct body, each TYP_TYPE_PARAM substituted for the matching
// type-arg.  Pushes a per-decl type-param scope so the field-type
// resolution sees T bound to its concrete @Type.  `named` is created
// and registered by instantiateGenericDeclWithArgs first, so a
// recursive field `next @Node[T]` (behind a managed pointer, hence
// size-stable) resolves back to this in-progress `named` instead of
// looping; its Underlying is nil during field resolution and filled in
// below.
func populateInstantiatedStruct(c @Checker, d @ast.Decl, args @[]@Type, named @Type) {
	// Resolve the body under the generic's DEFINING-file scope (its imports),
	// so a qualified field type `dep.Thing` binds to the generic's own `dep`,
	// not the consumer's — otherwise the wrong struct (wrong layout) is used.
	var savedScope @Scope = c.Scope
	// Also resolve under the generic's DEFINING package: generic struct decls
	// are keyed by full package path, and an UNQUALIFIED same-package generic
	// field head (`@Node[T]` self-ref, `@Pair[T]`) resolves via
	// lookupGenericTypeDeclPkg's curPkgPath fallback — which must name the
	// generic's own package, not the consumer instantiating it.
	var savedPkgPath @[]char = c.curPkgPath
	c.curPkgPath = genericTypeDeclPkg(c, d)
	var defScope @Scope = lookupGenericDeclScope(c, d)
	if defScope != nil {
		c.Scope = NewScope(defScope)
	} else {
		pushScope(c)
	}
	// Install type-params keyed on names (resolveTypeExpr's
	// TEXPR_NAMED branch finds them by scope lookup).  Each
	// type-param's @Type is the substituted concrete arg —
	// not a TYP_TYPE_PARAM placeholder; substitution happens
	// in-line during field resolution.
	for i := 0; i < len(d.TypeParams); i++ {
		var nm @[]char = d.TypeParams[i].Name
		defineType(c.Scope, nm, args[i])
	}
	if d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
		var underlying @Type = resolveStructType(c, d.TypeRef)
		underlying.Name = named.Name
		named.Underlying = underlying
	}
	// Substitute the generic type's methods (attached to its placeholder named
	// type by collectGenericMethodDecl) onto this instantiation, replacing the
	// type parameters with the concrete args.  substituteTypeParams matches type
	// params by index, so no per-method AST re-resolution is needed.  (A method
	// collected AFTER this type was first instantiated would be missed — the
	// method-population ordering hazard noted in plan-generic-type-methods.md;
	// in practice concrete instantiations arise in pass 2, after collection.)
	var phSym @Symbol = c.Scope.Lookup(d.Name)
	if phSym != nil && phSym.Type != nil && phSym.Type.Kind == TYP_NAMED &&
			len(named.Methods) == 0 {
		var placeholder @Type = phSym.Type
		for i := 0; i < len(placeholder.Methods); i++ {
			var pm @Method = placeholder.Methods[i]
			var subFt @Type = substituteTypeParams(c, pm.FuncType, args)
			var subRecv @Type = substituteTypeParams(c, pm.RecvType, args)
			named.AddMethod(MakeMethod(pm.Name, subRecv, subFt))
		}
	}
	c.Scope = savedScope
	c.curPkgPath = savedPkgPath
}

// mangleInstantiatedName produces a stable name for the
// instantiated TYP_NAMED — primarily for diagnostics and any
// downstream identity-by-name comparisons.  Mirrors the IR
// layer's instantiation mangle so the two layers can match
// when IR-gen for generic structs lands in Slice 5c.
func mangleInstantiatedName(base @[]char, args @[]@Type) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(base)
	cb.Write("[")
	for i := 0; i < len(args); i++ {
		if i > 0 { cb.Write(",") }
		if args[i] != nil {
			cb.Write(args[i].QualifiedTypeName())
		}
	}
	cb.Write("]")
	return buf.CopyStr(cb.String())
}
