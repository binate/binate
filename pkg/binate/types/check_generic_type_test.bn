package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for generic TYPE instantiation (check_generic_type.bn):
// resolving `Name[args]` to a concrete @Type — struct -> TYP_NAMED,
// interface -> TYP_INTERFACE — with the (decl, args) cache, the
// in-progress placeholder that bounds recursive instantiation, and
// the per-decl lookups.  Generic-FUNCTION instantiation + constraint
// tests live in check_generic_test.bn.  Helpers (checkSrc,
// expectError, expectNoErrors) live in types_test.bn.

// Generic struct instantiation type-checks cleanly: `var v
// List[int]` resolves to a TYP_NAMED with a substituted struct
// body.  Per plan-generics.md Slice 5b.
func TestCheckGenericStructInstantiation() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type List[T any] struct { head T }\n"
		"var v List[int]\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Wrong arg count rejects.
func TestCheckGenericTypeInstantiateWrongArity() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type List[T any] struct { head T }\n"
		"var v List[int, bool]\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Two-param generic instantiation works.
func TestCheckGenericPairInstantiation() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Pair[T any, U any] struct { fst T; snd U }\n"
		"var p Pair[int, bool]\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Instantiation cache: two uses of `List[int]` produce the same
// @Type instance, so an assignment between the two var decls
// type-checks via Identical.
func TestCheckGenericTypeInstantiationCached() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Box[T any] struct { val T }\n"
		"var a Box[int]\n"
		"var b Box[int] = a\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Unknown generic name surfaces as undefined.
func TestCheckGenericTypeInstantiateUnknown() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nvar v Bogus[int]\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Field type is a composite of T — pointer-to-T.  Substitution
// has to descend into TEXPR_POINTER and produce `*int`-typed
// field, not leave it as `*T`.
func TestCheckGenericStructFieldPointerT() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Ref[T any] struct { p *T }\n"
		"var r Ref[int]\n"
		"func f() { var x int; r.p = &x }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Package-qualified head is rejected with a clean
// "cross-package generic" message — Slice 7 territory.
func TestCheckGenericTypeInstantiateCrossPkgRejected() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nvar v other.List[int]\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Generic interface decl is parser-accepted and type-check
// accepted (Slice 6b stashes it in GenericIfaceDecls for use
// sites to instantiate against).  Without a use site there's
// no instantiation pressure — the decl alone is benign.
func TestCheckGenericInterfaceDeclAccepted() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"interface Container[T any] { get(i int) T }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// `var v *Container[int]` instantiates the generic interface
// to a per-(decl, args) TYP_INTERFACE wrapped in
// TYP_INTERFACE_VALUE.  Type-checker only — IR-gen (vtable
// layout) is Slice 6c territory.
func TestCheckGenericInterfaceInstantiation() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"interface Container[T any] { get(i int) T }\n"
		"func use(v *Container[int]) int { return v.get(0) }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Two-param generic interface.
func TestCheckGenericInterfaceTwoParams() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"interface Map[K any, V any] { lookup(k K) V }\n"
		"func use(m *Map[int, bool]) bool { return m.lookup(0) }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Cache identity: two function params typed *Container[int] are
// the same TYP_INTERFACE under the hood, so the assignment
// `dst = src` between them must type-check via Identical.
func TestCheckGenericInterfaceInstantiationCached() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"interface Container[T any] { get(i int) T }\n"
		"func pass(src *Container[int]) *Container[int] { return src }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Managed iface value: @Container[int] should also resolve via
// TYP_INTERFACE_VALUE_MANAGED.
func TestCheckGenericInterfaceManaged() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"interface Container[T any] { get(i int) T }\n"
		"func use(v @Container[int]) int { return v.get(0) }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// A broken generic-interface extension clause (`: NotAnIface`, a
// non-interface) is a property of the decl, so it must be reported ONCE
// even when the interface is instantiated at several distinct
// type-arguments.  The extension clause is resolved at each instantiation
// (Bad[int], Bad[bool]), so without dedup the same diagnostic fired once
// per instantiation.
func TestGenericIfaceExtensionErrorReportedOnce() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"type NotAnIface struct { x int }\n"
		"interface Bad[T any] : NotAnIface { f() T }\n"
		"func a(v @Bad[int]) {}\n"
		"func b(v @Bad[bool]) {}\n"
	var c @Checker = checkSrc(src)
	var errs @[]CheckError = c.CheckerErrors()
	var n int = 0
	for i := 0; i < len(errs); i++ {
		if streq(errs[i].Msg,
				"interface extension target must be an interface, got NotAnIface") {
			n = n + 1
		}
	}
	if n != 1 {
		return fail("broken generic-iface extension must report exactly once")
	}
	return ""
}

// Wrong arity at instantiation rejects.
func TestCheckGenericInterfaceWrongArity() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"interface Container[T any] { get(i int) T }\n"
		"func bad(v *Container[int, bool]) {}\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// `impl Foo : Container[int]` parses (Slice 6c-mid) and the
// type checker accepts it via resolveTypeInstantiation on the
// iface ref + impl-satisfaction against the substituted method
// set.  IR-gen still rejects this at compile time (Slice 6c-full
// is the remaining vtable work) — exercise only via checkSrc.
func TestCheckImplOnGenericInterfaceInstantiation() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"type Foo struct { x int }\n"
		"interface Container[T any] { get() T }\n"
		"impl Foo : Container[int]\n"
		"func (f Foo) get() int { return f.x }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Extension form parses the generic-iface ref the same way as
// impl: `interface Wide : Container[int] { extra() int }`.
// Slice 6c-mid extended parseInterfaceRef to cover both slots.
func TestCheckExtendsGenericInterfaceInstantiation() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"interface Container[T any] { get() T }\n"
		"interface Wide : Container[int] { extra() int }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Multi-level inheritance: `impl Foo : Grand` satisfies a
// `T : Base` constraint when Grand extends Child extends Base.
// Tests isDescendantInterface's transitive walk through the
// satisfaction predicate.
func TestCheckGenericConstraintSatisfiedMultiLevel() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Foo struct { X int }\n"
		"interface Base { B() int }\n"
		"interface Child : Base { C() int }\n"
		"interface Grand : Child { G() int }\n"
		"impl Foo : Grand\n"
		"func (f Foo) B() int { return 1 }\n"
		"func (f Foo) C() int { return 2 }\n"
		"func (f Foo) G() int { return 3 }\n"
		"func need[T Base](t T) int { return t.B() }\n"
		"func main() { var f Foo; var n int = need[Foo](f) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Satisfaction through interface inheritance: `impl Foo : Child`
// satisfies a `T : Base` constraint because Child extends Base.
// Without the transitive check in typeSatisfiesConstraint this
// would reject — Foo has no direct `impl Foo : Base`.
func TestCheckGenericConstraintSatisfiedTransitively() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Foo struct { X int }\n"
		"interface Base { Tag() int }\n"
		"interface Child : Base { Extra() int }\n"
		"impl Foo : Child\n"
		"func (f Foo) Tag() int { return 1 }\n"
		"func (f Foo) Extra() int { return 2 }\n"
		"func need[T Base](t T) int { return t.Tag() }\n"
		"func main() { var f Foo; var n int = need[Foo](f) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Constraint = an interface that extends another.  Methods from
// the parent are reachable on T : Child via lookupFullIfaceMethod.
func TestCheckGenericConstraintInterfaceExtension() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"type Foo struct { X int }\n"
		"interface Base { Tag() int }\n"
		"interface Child : Base { Extra() int }\n"
		"impl Foo : Child\n"
		"func (f Foo) Tag() int { return 1 }\n"
		"func (f Foo) Extra() int { return 2 }\n"
		// use[T Child] calls Tag (parent method) — must resolve.
		"func use[T Child](t T) int { return t.Tag() }\n"
		"func main() { var f Foo; var n int = use[Foo](f) }\n")
	var src *[]readonly char = cb.String()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}
