package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// A user-declared empty interface is a NOMINAL marker (requires an
// explicit `impl`), NOT a structural universal like the built-in `any`
// — Binate interfaces are nominal, not duck-typed.  Same-interface
// managed->raw decay (`@Iface -> *Iface`) is a supported conversion for
// every interface.  Drives the assignability rules in
// types_assignable.bn (isUniverseAny / sameInterface) end-to-end.
// Helpers checkSrc / expectError / expectNoErrors live in sibling
// _test.bn files.

// A concrete `*T` does NOT satisfy an unrelated user empty interface
// without an `impl` — but DOES once the impl is declared.
func TestEmptyInterfaceRequiresImpl() testing.TestResult {
	var noImpl @strings.Builder = strings.NewBuilder()
	noImpl.Write(
			"package \"test\"\n"
					"interface Empty {}\n"
					"type T struct { v int }\n"
					"func f() {\n"
					"\tvar t T\n"
					"\tvar e *Empty = &t\n"
					"\t_ = e\n"
					"}\n")
	var c1 @Checker = checkSrc(buf.CopyStr(noImpl.String()))
	var r1 testing.TestResult = expectError(c1)
	if len(r1) != 0 { return r1 }

	var withImpl @strings.Builder = strings.NewBuilder()
	withImpl.Write(
			"package \"test\"\n"
					"interface Empty {}\n"
					"type T struct { v int }\n"
					"impl *T : Empty\n"
					"func f() {\n"
					"\tvar t T\n"
					"\tvar e *Empty = &t\n"
					"\t_ = e\n"
					"}\n")
	var c2 @Checker = checkSrc(buf.CopyStr(withImpl.String()))
	return expectNoErrors(c2)
}

// An interface value cannot upcast to an UNRELATED user empty interface
// (it is not `any`, not the same interface, not an ancestor).
func TestIfaceValueToUnrelatedEmptyRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Speaker { speak() int }\n"
					"interface Empty {}\n"
					"type T struct { v int }\n"
					"func (t *T) speak() int { return t.v }\n"
					"impl *T : Speaker\n"
					"func f() {\n"
					"\tvar t @T = make(T)\n"
					"\tvar sm @Speaker = t\n"
					"\tvar e *Empty = sm\n"
					"\t_ = e\n"
					"}\n")
	return expectError(checkSrc(buf.CopyStr(cb.String())))
}

// An unrelated NON-empty interface is also rejected (the nominal rule is
// not specific to empty targets) — control for the rule above.
func TestIfaceValueToUnrelatedNonEmptyRejected() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Speaker { speak() int }\n"
					"interface Walker { walk() int }\n"
					"type T struct { v int }\n"
					"func (t *T) speak() int { return t.v }\n"
					"impl *T : Speaker\n"
					"func f() {\n"
					"\tvar t @T = make(T)\n"
					"\tvar sm @Speaker = t\n"
					"\tvar w *Walker = sm\n"
					"\t_ = w\n"
					"}\n")
	return expectError(checkSrc(buf.CopyStr(cb.String())))
}

// The built-in `any` IS universally satisfiable — a concrete value
// assigns to `*any` / `@any` with no impl (raw and managed forms).
func TestAnyAcceptsConcreteWithoutImpl() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"type T struct { v int }\n"
					"func f() {\n"
					"\tvar t T\n"
					"\tvar a *any = &t\n"
					"\t_ = a\n"
					"\tvar mt @T = make(T)\n"
					"\tvar ma @any = mt\n"
					"\t_ = ma\n"
					"}\n")
	return expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
}

// Same-interface managed->raw decay (`@Iface -> *Iface`) is accepted for
// a non-empty interface AND a zero-method one.
func TestSameInterfaceDecayAccepted() testing.TestResult {
	var nonEmpty @strings.Builder = strings.NewBuilder()
	nonEmpty.Write(
			"package \"test\"\n"
					"interface Speaker { speak() int }\n"
					"type T struct { v int }\n"
					"func (t *T) speak() int { return t.v }\n"
					"impl *T : Speaker\n"
					"func f() {\n"
					"\tvar t @T = make(T)\n"
					"\tvar sm @Speaker = t\n"
					"\tvar sr *Speaker = sm\n"
					"\t_ = sr\n"
					"}\n")
	var r1 testing.TestResult = expectNoErrors(checkSrc(buf.CopyStr(nonEmpty.String())))
	if len(r1) != 0 { return r1 }

	var empty @strings.Builder = strings.NewBuilder()
	empty.Write(
			"package \"test\"\n"
					"interface E {}\n"
					"type T struct { v int }\n"
					"impl *T : E\n"
					"func f() {\n"
					"\tvar t @T = make(T)\n"
					"\tvar em @E = t\n"
					"\tvar er *E = em\n"
					"\t_ = er\n"
					"}\n")
	return expectNoErrors(checkSrc(buf.CopyStr(empty.String())))
}

// A real child->parent upcast still works (the nominal rule does not
// over-reject genuine descendants).
func TestDescendantIfaceUpcastStillAccepted() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Animal { legs() int }\n"
					"interface Dog : Animal { bark() int }\n"
					"type T struct { v int }\n"
					"func (t *T) legs() int { return 4 }\n"
					"func (t *T) bark() int { return t.v }\n"
					"impl *T : Dog\n"
					"func f() {\n"
					"\tvar t @T = make(T)\n"
					"\tvar d @Dog = t\n"
					"\tvar a @Animal = d\n"
					"\t_ = a\n"
					"}\n")
	return expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
}

// Upcast to an EMPTY interface that is an explicit PARENT is accepted —
// the nominal rule rejects an UNRELATED empty interface, not a declared
// ancestor that happens to have zero methods.  Distinct from the
// non-empty descendant test above: an empty parent used to be accepted
// via the (now-removed) zero-method shortcut, so this pins that the
// descendant path handles a zero-method ancestor.
func TestUpcastToEmptyParentAccepted() testing.TestResult {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(
			"package \"test\"\n"
					"interface Marker {}\n"
					"interface Sub : Marker { id() int }\n"
					"type T struct { v int }\n"
					"func (t *T) id() int { return t.v }\n"
					"impl *T : Sub\n"
					"func f() {\n"
					"\tvar t @T = make(T)\n"
					"\tvar s @Sub = t\n"
					"\tvar m *Marker = s\n"
					"\t_ = m\n"
					"}\n")
	return expectNoErrors(checkSrc(buf.CopyStr(cb.String())))
}
