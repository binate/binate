package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for interface extension parent resolution and method-set
// propagation (check_iface_extends.bn).  Slice E.2 of
// plan-interface-embedding.md.

// ============================================================
// Successful extension
// ============================================================

func TestInterfaceExtendSingleParent() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Closer { Close() }\n")
	cb = cb.WriteStr("interface RC : Closer { Read() int }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestInterfaceExtendMultiParent() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Reader { Read() int }\n")
	cb = cb.WriteStr("interface Writer { Write() int }\n")
	cb = cb.WriteStr("interface RW : Reader, Writer {}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestInterfaceExtendDeep() testing.TestResult {
	// A : Top, B : A, C : B  — three-deep chain, validates clean.
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Top { Top() }\n")
	cb = cb.WriteStr("interface A : Top { A() }\n")
	cb = cb.WriteStr("interface B : A { B() }\n")
	cb = cb.WriteStr("interface C : B { C() }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestInterfaceExtendDiamondHarmless() testing.TestResult {
	// D extends both B and C, both of which extend Top.  Top's
	// methods reach D via two paths; the dedup must not flag this.
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Top { Top() }\n")
	cb = cb.WriteStr("interface B : Top { B() }\n")
	cb = cb.WriteStr("interface C : Top { C() }\n")
	cb = cb.WriteStr("interface D : B, C {}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// ============================================================
// Parents stored on the Type
// ============================================================

func TestInterfaceExtendParentsRecorded() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface P { foo() }\n")
	cb = cb.WriteStr("interface Q { bar() }\n")
	cb = cb.WriteStr("interface X : P, Q {}\n")
	var c @Checker = checkSrcResolved(cb.Bytes())
	if len(c.CheckerErrors()) != 0 {
		return "unexpected errors"
	}
	var sym @Symbol = c.Scope.Lookup("X")
	if sym == nil { return "X not in scope" }
	if sym.Type == nil || sym.Type.Kind != TYP_INTERFACE {
		return "X is not TYP_INTERFACE"
	}
	if len(sym.Type.Parents) != 2 {
		return "expected 2 parents on X"
	}
	if !charEq(sym.Type.Parents[0].Name, "P") {
		return "expected parent[0] = P"
	}
	if !charEq(sym.Type.Parents[1].Name, "Q") {
		return "expected parent[1] = Q"
	}
	return ""
}

// ifaceFullMethods returns own + inherited methods in DFS
// preorder, deduped by name.
func TestInterfaceFullMethodsOrder() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface A { a() }\n")
	cb = cb.WriteStr("interface B { b() }\n")
	cb = cb.WriteStr("interface X : A, B { x() }\n")
	var c @Checker = checkSrcResolved(cb.Bytes())
	if len(c.CheckerErrors()) != 0 {
		return "unexpected errors"
	}
	var sym @Symbol = c.Scope.Lookup("X")
	if sym == nil { return "X not in scope" }
	var ms @[]@Method = ifaceFullMethods(sym.Type)
	if len(ms) != 3 {
		return "expected 3 methods (a, b, x)"
	}
	if !charEq(ms[0].Name, "a") {
		return "expected ms[0] = a"
	}
	if !charEq(ms[1].Name, "b") {
		return "expected ms[1] = b"
	}
	if !charEq(ms[2].Name, "x") {
		return "expected ms[2] = x"
	}
	return ""
}

// ============================================================
// Failure cases
// ============================================================

func TestInterfaceExtendForwardRefRejected() testing.TestResult {
	// Parent B is declared after the extension.  Without
	// pre-registration of interfaces, the lookup at decl time
	// fails — surfaces as an "undefined" error of some shape.
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface A : B {}\n")
	cb = cb.WriteStr("interface B {}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

func TestInterfaceExtendSelfRejected() testing.TestResult {
	// `interface A : A {}` — A is in scope when its own parents are
	// resolved (pre-defined for self-referential method types), so
	// resolveInterfaceExtension rejects the self-cycle explicitly.
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface A : A {}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// A self-referential interface METHOD — one whose result type is the
// interface itself — must typecheck: the interface symbol is in scope
// while its own method signatures resolve.  Regression for the in-`.bn`
// self-ref bug where `next() @Node` fired "undefined: Node" (the `.bni`
// path worked because bni_scope pre-registers interface symbols).
func TestInterfaceSelfReferentialMethod() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Node {\n")
	cb = cb.WriteStr("\tval() int\n")
	cb = cb.WriteStr("\tnext() @Node\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestInterfaceExtendNonInterfaceRejected() testing.TestResult {
	// Parent is a struct, not an interface — must error.
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type S struct { x int }\n")
	cb = cb.WriteStr("interface A : S {}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

func TestInterfaceExtendDuplicateParentRejected() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface P { foo() }\n")
	cb = cb.WriteStr("interface A : P, P {}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

func TestInterfaceExtendSignatureConflictRejected() testing.TestResult {
	// Two parents declare same-name method with different signatures.
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface P { foo() }\n")
	cb = cb.WriteStr("interface Q { foo() int }\n")
	cb = cb.WriteStr("interface X : P, Q {}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Same-name same-signature across parents is harmless.
func TestInterfaceExtendSameSignatureAcrossParentsAllowed() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Top { foo() int }\n")
	cb = cb.WriteStr("interface A : Top {}\n")
	cb = cb.WriteStr("interface B : Top {}\n")
	cb = cb.WriteStr("interface X : A, B {}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}
