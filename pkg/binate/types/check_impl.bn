package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"
import "pkg/stdx/slices"

// Impl-declaration type-checking. Parse + collect are handled
// elsewhere; this file adds the
// satisfaction check (does the receiver type actually implement
// every interface method, with compatible signatures and receiver
// kinds?). Codegen (vtables, dispatch through interface values)
// is further out.

// collectImplDecl resolves the receiver type and the interface names,
// records the impl on the checker, and reports basic structural
// errors (interface name doesn't resolve to an interface, receiver
// type fails to resolve).
func collectImplDecl(c @Checker, d @ast.Decl) {
	if d == nil || d.Kind != ast.DECL_IMPL {
		return
	}

	// A parameterized-receiver impl (`impl *Cursor[T] : Iterator[T]`) binds the
	// type's parameters; handle it separately (gen.impl.generic-recv).
	if receiverBaseInstantiation(d.TypeRef) != nil {
		collectGenericImplDecl(c, d)
		return
	}

	var recv @Type = resolveTypeExpr(c, d.TypeRef)
	capturePendingIfSized(c, recv)
	if recv == nil { recv = TypVoid() }

	var ifaces @[]@Type
	for i := 0; i < len(d.Interfaces); i++ {
		var ref @ast.TypeExpr = d.Interfaces[i]
		var t @Type = resolveImplInterfaceRef(c, ref)
		if t != nil {
			ifaces = slices.Append[@Type](ifaces, t)
		}
	}

	var rec @Impl = make(Impl)
	rec.Pos = d.Pos
	rec.RecvType = recv
	rec.Interfaces = ifaces
	// Stamp the DEFINING package's carve-out status now (pass 1 runs under
	// this package's AllowUniverseRecv); the satisfaction pass runs under a
	// possibly-different package's flag, so it must read this, not the live one.
	rec.CarveOut = c.AllowUniverseRecv
	c.Impls = slices.Append[@Impl](c.Impls, rec)
}

// resolveImplInterfaceRef resolves a name in the interface-list
// position of an `impl T : ...` clause. The name must denote a
// declared interface (TYP_INTERFACE); anything else is an error.
// Returns nil on error.
func resolveImplInterfaceRef(c @Checker, te @ast.TypeExpr) @Type {
	if te == nil { return nil }
	var t @Type = resolveTypeExprAllowInterface(c, te)
	if t == nil || t.Kind == TYP_VOID {
		return nil
	}
	if t.Kind != TYP_INTERFACE {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("expected interface name in impl, got ")
		cb.Write(t.TypeName())
		addCheckError(c, te.Pos, buf.CopyStr(cb.String()))
		return nil
	}
	return t
}

// checkAllImplsSatisfaction validates that every collected impl
// actually satisfies the interfaces it claims. For each interface
// method M, the receiver type must have a same-named method with a
// compatible signature (params after the receiver, plus results)
// and a receiver kind reachable from the impl's receiver via the
// existing safe-direction smoothing rules (receiverAssignable).
//
// Runs once per
// type-check pass, after collectDecls has populated c.Impls and
// every named type's method set.
func checkAllImplsSatisfaction(c @Checker) {
	for i := 0; i < len(c.Impls); i++ {
		checkImplSatisfaction(c, c.Impls[i])
	}
}

// checkImplSatisfaction validates a single Impl record. Walks each
// declared interface and each of its methods, looking for a matching
// impl method on the receiver's underlying named type. Reports per-
// method errors so a multi-missing-method impl produces a useful
// error list instead of failing on the first one.
func checkImplSatisfaction(c @Checker, rec @Impl) {
	if rec == nil { return }
	var recv @Type = rec.RecvType
	if recv == nil { return }
	var named @Type = recv.ReceiverBaseNamed()
	if named == nil {
		addCheckError(c, rec.Pos, "impl receiver must be (a wrapper around) a named type")
		return
	}
	// A parameterized-receiver impl checks coverage against the generic type's
	// abstract method set, which lives on its placeholder named type (RecvType's
	// base is the empty instantiation shell — see Impl.Placeholder).
	if rec.Placeholder != nil {
		named = rec.Placeholder
	}
	// Carve-out gate (§11.10 iface.canonical.carveout): exactly one
	// package, pkg/builtins/lang, may declare impls on the universe
	// primitives (int / float / bool); "no other package may".  A
	// primitive impl whose interface HAS methods is already blocked
	// indirectly (the method-declaration pass's AllowUniverseRecv gate
	// rejects the `func (x int) m()` needed to satisfy it), but an impl
	// of an empty interface reaches no method-declaration check, so gate
	// it here -- mirroring resolveMethodReceiver's AllowUniverseRecv.  Use
	// the impl's OWN stamped CarveOut (its defining package), not the live
	// c.AllowUniverseRecv: c.Impls accumulates across packages, so lang's
	// own primitive impls reach this loop while a NON-lang package is being
	// checked, and the live flag would wrongly reject them.
	if isUniversePrimitive(named) && !rec.CarveOut {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("cannot impl an interface on primitive type ")
		cb.Write(named.TypeName())
		cb.Write(" outside pkg/builtins/lang")
		addCheckError(c, rec.Pos, buf.CopyStr(cb.String()))
		return
	}
	for i := 0; i < len(rec.Interfaces); i++ {
		var iface @Type = rec.Interfaces[i]
		if iface == nil { continue }
		checkImplCoversInterface(c, rec, recv, named, iface)
	}
}

// checkImplCoversInterface runs the per-interface satisfaction loop:
// for every method declared on the interface (including methods
// inherited from extended parents),
// the receiver's named type must register a matching method.
func checkImplCoversInterface(c @Checker, rec @Impl, recv @Type, named @Type, iface @Type) {
	var methods @[]@Method = ifaceFullMethods(iface)
	for i := 0; i < len(methods); i++ {
		var im @Method = methods[i]
		var rm @Method = named.LookupMethod(im.Name)
		if rm == nil {
			emitMissingMethodError(c, rec.Pos, named, iface, im)
			continue
		}
		if !methodSigSatisfies(rm.FuncType, im.FuncType, named) {
			emitMethodSigMismatchError(c, rec.Pos, named, iface, im)
			continue
		}
		// Receiver-kind compatibility: at dispatch through the
		// interface value, the impl's R-shaped data is passed as
		// rm's declared receiver. Enforce safe-direction smoothing.
		if rm.FuncType != nil && len(rm.FuncType.Params) > 0 {
			var rmRecv @Type = rm.FuncType.Params[0].Type
			if !receiverAssignable(recv, rmRecv) {
				emitMethodReceiverMismatchError(c, rec.Pos, named, iface, im, rmRecv)
			}
		}
	}
}

// methodSigSatisfies checks that an impl method's func type matches
// the interface method's func type, ignoring the impl method's
// leading receiver parameter. Both must have the same number of
// non-receiver parameters and results, and each pair must be
// Identical *after* substituting the interface side's `Self` with
// the implementing named type.
func methodSigSatisfies(implFt @Type, ifaceFt @Type, named @Type) bool {
	if implFt == nil || ifaceFt == nil { return false }
	// Impl has receiver as Params[0]; interface has no receiver.
	var implParams int = len(implFt.Params) - 1
	if implParams < 0 { return false }
	if implParams != len(ifaceFt.Params) { return false }
	if len(implFt.Results) != len(ifaceFt.Results) { return false }
	for i := 0; i < implParams; i++ {
		var expected @Type = substituteSelf(
				ifaceFt.Params[i].Type, named)
		if !implFt.Params[i + 1].Type.Identical(expected) {
			return false
		}
	}
	for i := 0; i < len(implFt.Results); i++ {
		var expected @Type = substituteSelf(ifaceFt.Results[i], named)
		if !implFt.Results[i].Identical(expected) {
			return false
		}
	}
	// A variadic impl method satisfies only a variadic interface method, and a
	// fixed one only a fixed one (func.variadic.identity; iface.impl.coverage).
	// funcIsVariadic reads the LAST param — for the impl that is the last user
	// param (the receiver at Params[0] is never variadic), so this compares the
	// two methods' user-facing variadic-ness directly.
	if funcIsVariadic(implFt) != funcIsVariadic(ifaceFt) {
		return false
	}
	return true
}

// emitMissingMethodError reports that the receiver's named type has
// no method matching the named interface method.
func emitMissingMethodError(c @Checker, pos token.Pos, named @Type, iface @Type, im @Method) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("type ")
	cb.Write(named.TypeName())
	cb.Write(" does not implement ")
	cb.Write(iface.Name)
	cb.Write(" (missing method `")
	cb.Write(im.Name)
	cb.Write("`)")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// emitMethodSigMismatchError reports that the receiver's same-named
// method has the wrong parameter or result types.
func emitMethodSigMismatchError(c @Checker, pos token.Pos, named @Type, iface @Type, im @Method) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("type ")
	cb.Write(named.TypeName())
	cb.Write(" does not implement ")
	cb.Write(iface.Name)
	cb.Write(" (method `")
	cb.Write(im.Name)
	cb.Write("` has wrong signature)")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// emitMethodReceiverMismatchError reports that the receiver's
// matching method has a receiver kind unreachable from the impl's
// declared receiver via safe-direction smoothing.
func emitMethodReceiverMismatchError(c @Checker, pos token.Pos, named @Type, iface @Type,
		im @Method, rmRecv @Type) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("type ")
	cb.Write(named.TypeName())
	cb.Write(" does not implement ")
	cb.Write(iface.Name)
	cb.Write(" (method `")
	cb.Write(im.Name)
	cb.Write(
			"` receiver kind incompatible with impl receiver)")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// Impl records a single `impl T : I1, I2, ...` declaration. The
// receiver type captures the receiver-kind nuance (TYP_POINTER vs
// TYP_MANAGED_PTR vs the bare type, plus const) so that downstream
// satisfaction checks and codegen can route correctly. Each
// interface entry is a TYP_INTERFACE.
//
// CarveOut records whether the DEFINING package was the universe-impl
// carve-out (pkg/builtins/lang) -- stamped at collection time from
// c.AllowUniverseRecv.  c.Impls accumulates across every package, so the
// satisfaction pass (which runs under the CURRENTLY-checked package's
// AllowUniverseRecv) must consult this per-impl flag, not the live one, to
// decide whether an `impl <primitive> : I` is legal (§11.10 carve-out).
type Impl struct {
	Pos        token.Pos
	RecvType   @Type
	Interfaces @[]@Type
	CarveOut   bool
	// Placeholder is set for a parameterized-receiver impl
	// (`impl *Cursor[T] : Iterator[T]`): the generic type's placeholder named
	// type, which carries the abstract method set. The satisfaction pass looks
	// methods up here (RecvType's ReceiverBaseNamed is the empty instantiation
	// shell). nil for a concrete-receiver impl.
	Placeholder @Type
}
