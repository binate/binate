package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for interface declaration type-checking
// (collectInterfaceDecl in check_interface.bn). Phase 1 of
// plan-interface-syntax-revision.md only validates the declaration
// shape — bare interface names aren't yet usable as type
// expressions, so these tests stop at "interface symbol is defined
// with the right method set."

func TestCheckInterfaceEmpty() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\ninterface Empty {\n}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckInterfaceSingleMethod() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Stringer {\n"
		"\ttoString() *[]readonly char\n"
		"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

func TestCheckInterfaceMultiMethod() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Comparator {\n"
		"\tcompare(a int, b int) int\n"
		"\tequal(a int, b int) bool\n"
		"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

func TestCheckInterfaceMultiReturn() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface MR {\n"
		"\tpair() (int, int)\n"
		"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectNoErrors(c)
}

func TestCheckInterfaceDuplicateMethod() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Bad {\n"
		"\tdoIt() int\n"
		"\tdoIt(x int) int\n"
		"}\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// `*Iface` resolves to TYP_INTERFACE_VALUE, with the interface
// reachable via Elem.
func TestCheckInterfaceValueRaw() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Stringer {\n"
		"\ttoString() *[]readonly char\n"
		"}\n"
		"var s *Stringer\n")
	var c @Checker = checkSrcResolved(buf.CopyStr(cb.String()))
	if len(c.CheckerErrors()) > 0 {
		return "unexpected errors"
	}
	var sym @Symbol = c.Scope.Lookup("s")
	if sym == nil { return "var s not in scope" }
	if sym.Type == nil { return "s has nil Type" }
	if sym.Type.Kind != TYP_INTERFACE_VALUE {
		return "s.Type.Kind != TYP_INTERFACE_VALUE"
	}
	if sym.Type.Elem == nil ||
		sym.Type.Elem.Kind != TYP_INTERFACE {
		return "*Stringer.Elem should be TYP_INTERFACE"
	}
	return ""
}

// `@Iface` resolves to TYP_INTERFACE_VALUE_MANAGED.
func TestCheckInterfaceValueManaged() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Stringer {\n"
		"\ttoString() *[]readonly char\n"
		"}\n"
		"var s @Stringer\n")
	var c @Checker = checkSrcResolved(buf.CopyStr(cb.String()))
	if len(c.CheckerErrors()) > 0 {
		return "unexpected errors"
	}
	var sym @Symbol = c.Scope.Lookup("s")
	if sym == nil { return "var s not in scope" }
	if sym.Type == nil { return "s has nil Type" }
	if sym.Type.Kind != TYP_INTERFACE_VALUE_MANAGED {
		return "s.Type.Kind != TYP_INTERFACE_VALUE_MANAGED"
	}
	return ""
}

// Bare `Iface` as a type expression must error — pointing at *Iface
// or @Iface as the usable forms.
func TestCheckInterfaceBareNameRejected() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Stringer {\n"
		"\ttoString() *[]readonly char\n"
		"}\n"
		"var s Stringer\n")
	var c @Checker = checkSrc(buf.CopyStr(cb.String()))
	return expectError(c)
}

// Interface-value types are 2 words wide ({data, vtable}) — 16 bytes
// on 64-bit, 8 bytes on 32-bit.  Pin to 64-bit (via scope_test's
// setTarget64 helper, sibling in this package's test set) so the
// assertion is host-independent — the size derives from ptrSize() on
// the live target, which is dynamic.
func TestCheckInterfaceValueSize() testing.TestResult {
	setTarget64()
	var iface @Type = MakeInterfaceType("test", "I")
	var raw @Type = MakeInterfaceValueType(iface)
	var managed @Type = MakeManagedInterfaceValueType(iface)
	if raw.SizeOf() != 16 { return "*Iface size should be 16" }
	if managed.SizeOf() != 16 {
		return "@Iface size should be 16"
	}
	if raw.AlignOf() != 8 { return "*Iface align should be 8" }
	if managed.AlignOf() != 8 {
		return "@Iface align should be 8"
	}
	return ""
}

// Verify the interface symbol is registered in the checker scope
// with the right Type kind and method count. Uses checkSrcResolved
// so the file's scope persists through the test (checkSrc pops it).
func TestCheckInterfaceSymbolDefined() testing.TestResult {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(
		"package \"test\"\n"
		"interface Two {\n"
		"\ta() int\n"
		"\tb() bool\n"
		"}\n")
	var c @Checker = checkSrcResolved(buf.CopyStr(cb.String()))
	if len(c.CheckerErrors()) > 0 {
		return "unexpected errors"
	}
	var sym @Symbol = c.Scope.Lookup("Two")
	if sym == nil { return "Two not in scope" }
	if sym.Kind != SYM_INTERFACE {
		return "Two symbol kind != SYM_INTERFACE"
	}
	if sym.Type == nil { return "Two has nil Type" }
	if sym.Type.Kind != TYP_INTERFACE {
		return "Two.Type.Kind != TYP_INTERFACE"
	}
	if len(sym.Type.Methods) != 2 {
		return "Two.Type.Methods should have 2 entries"
	}
	return ""
}
