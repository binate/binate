// Argument count mismatch is reported.
func TestCheckMethodCallWrongArgCount() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Point struct { x int }\n"
		"func (p *Point) Set(v int) { p.x = v }\n"
		"func main() {\n"
		"  var pp *Point = nil\n"
		"  pp.Set()\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Method call on a type with no such method is an error.
func TestCheckMethodCallUnknownMethod() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Point struct { x int }\n"
		"func main() {\n"
		"  var pp *Point = nil\n"
		"  pp.MissingMethod()\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// *T receiver expression cannot satisfy @T method (no implicit raw → managed).
func TestCheckMethodCallPointerOnManagedRejected() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Node struct { val int }\n"
		"func (n @Node) Val() int { return n.val }\n"
		"func main() {\n"
		"  var pp *Node = nil\n"
		"  pp.Val()\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Two methods on different types with the same name resolve by receiver type.
func TestCheckMethodCallDispatchByType() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type A struct { v int }\n"
		"type B struct { v bool }\n"
		"func (a *A) Get() int { return a.v }\n"
		"func (b *B) Get() bool { return b.v }\n"
		"func main() {\n"
		"  var pa *A = nil\n"
		"  var pb *B = nil\n"
		"  var x int = pa.Get()\n"
		"  var y bool = pb.Get()\n"
		"  println(x); println(y)\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// ============================================================
// Pointer-to-iface-value smoothing (Slice P.3 of plan-pointers-
// to-iface-values.md).  `p.Foo()` for `p` of kind `**I`, `*@I`,
// `@(*I)`, or `@(@I)` peels one pointer layer and looks up the
// method on the iv.  Pre-Slice-P.3 every shape rejected at type
// check with "cannot access field on this type".
// ============================================================

func TestCheckMethodCallSmoothPtrRawIvRaw() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"interface I { Foo() int }\n"
		"type T struct { x int }\n"
		"func (t *T) Foo() int { return t.x }\n"
		"impl *T : I\n"
		"func use(p **I) int { return p.Foo() }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestCheckMethodCallSmoothPtrRawIvMgd() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"interface I { Foo() int }\n"
		"type T struct { x int }\n"
		"func (t *T) Foo() int { return t.x }\n"
		"impl *T : I\n"
		"func use(p *@I) int { return p.Foo() }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestCheckMethodCallSmoothPtrMgdIvRaw() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"interface I { Foo() int }\n"
		"type T struct { x int }\n"
		"func (t *T) Foo() int { return t.x }\n"
		"impl *T : I\n"
		"func use(p @(*I)) int { return p.Foo() }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestCheckMethodCallSmoothPtrMgdIvMgd() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"interface I { Foo() int }\n"
		"type T struct { x int }\n"
		"func (t *T) Foo() int { return t.x }\n"
		"impl *T : I\n"
		"func use(p @(@I)) int { return p.Foo() }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Method name not on the iface — even after smoothing, the
// method must exist in the iface's method set.
func TestCheckMethodCallSmoothPtrUnknownMethodRejected() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"interface I { Foo() int }\n"
		"type T struct { x int }\n"
		"func (t *T) Foo() int { return t.x }\n"
		"impl *T : I\n"
		"func use(p **I) int { return p.Nope() }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// OBJECT-const receiver model (plan-cr2-1 Defect 2b).  `readonly @Box` is a
// const POINTER to a MUTABLE object, so it dispatches to any method (the
// readonly is on the handle, not the pointee).
func TestCheckMethodCallReadonlyManagedPtrAllowed() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Box struct { v int }\n"
		"func (b *Box) setV(x int) { b.v = x }\n"
		"func use(p @Box) {\n"
		"  var rp readonly @Box = p\n"
		"  rp.setV(9)\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// A method call through an ALIAS-typed receiver (`type AB = @Box`) must
// dispatch.  ReceiverBaseNamed peels pointer/managed/readonly but NOT
// TYP_ALIAS, so the named-base lookup is done off the alias-peeled `resolved`
// (not raw recvType) — else an alias receiver resolves to nil ("cannot call
// non-function").  CR-2 Plan-1 Round-2, alias sibling of the readonly Defect-2
// receiver peel.
func TestCheckMethodCallAliasReceiverAllowed() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Box struct { v int }\n"
		"func (b *Box) getV() int { return b.v }\n"
		"type AB = @Box\n"
		"func use(p @Box) {\n"
		"  var x AB = p\n"
		"  println(x.getV())\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// `@(readonly Box)` is a mutable pointer to a CONST object, so calling a
// method whose receiver is `*Box` (which could mutate the object) is rejected.
func TestCheckMethodCallConstObjectRejectsMutableReceiver() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Box struct { v int }\n"
		"func (b *Box) setV(x int) { b.v = x }\n"
		"func use(p @Box) {\n"
		"  var op @(readonly Box) = p\n"
		"  op.setV(9)\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// A `@(readonly Box)` const object CAN call a method whose receiver is itself
// const-pointee (`*readonly Box`) — that method promises not to mutate.
func TestCheckMethodCallConstObjectAllowsConstReceiver() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Box struct { v int }\n"
		"func (b *readonly Box) peek() int { return b.v }\n"
		"func use(p @Box) int {\n"
		"  var op @(readonly Box) = p\n"
		"  return op.peek()\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// A `readonly @Iface` receiver dispatches through the interface method set:
// tryMethodCall resolves the receiver with resolveAliasAndConst (not
// ResolveAlias), which peels the IR-transparent `readonly` wrapper so the
// interface-value arm is reached.  Pre-fix this rejected with "cannot access
// field on this type", which ruled out ALL interface use of a readonly value
// (claude-todo readonly CRITICAL Symptom 2 / plan-cr2-1 Defect 2).
func TestCheckMethodCallReadonlyIfaceDispatch() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"interface Getter { get() int }\n"
		"type Impl struct { v int }\n"
		"func (im *Impl) get() int { return im.v }\n"
		"impl *Impl : Getter\n"
		"func use(r @Getter) int {\n"
		"  var rr readonly @Getter = r\n"
		"  return rr.get()\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}
