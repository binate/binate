package "pkg/binate/types"

import "pkg/binate/token"
import "pkg/stdx/slices"

// Opaque-type predicates and the value-embedding gate.  An opaque type is a
// forward-declared `type T` with no body (TYP_NAMED, Underlying == nil) whose
// layout is unknown (supplied externally in C/asm).  It may be held behind a
// pointer / handle (`*T` / `@T`), but a VALUE of it can never be formed —
// SizeOf/AlignOf would fabricate ptrSize and silently miscompile.  These gates
// give a clean use-site diagnostic instead.

// isOpaqueType reports whether t bottoms out at an opaque type.  It peels alias
// / readonly / named-distinct wrappers via peelFieldAccessBase, so a distinct
// type over an opaque base (`type A Opaque`) is opaque too — matching how field
// access treats the same type.  A generic type parameter is TYP_TYPE_PARAM (not
// TYP_NAMED), so it is correctly NOT opaque here.
//
// The whole-program build loads every dependency's .bn, so a cross-package
// opaque export's body is filled at importer use sites (not opaque there); the
// gate fires for pure opaque types — no full definition anywhere — which is the
// case that matters.
func isOpaqueType(t @Type) bool {
	var base @Type
	base, _ = peelFieldAccessBase(t)
	return base != nil && base.Kind == TYP_NAMED && base.Underlying == nil
}

// isCrossPkgOpaqueExport reports whether t bottoms out at an OPAQUE-EXPORT type
// (a `.bni` forward decl whose layout was filled from its own package's `.bn` —
// OpaqueExportPkg set; see Type.OpaqueExportPkg / bug 211) viewed from a
// DIFFERENT package than the one that owns it.  Such a type has a non-nil
// Underlying (so isOpaqueType misses it under co-compilation) but is opaque to
// THIS package: a value of it can no more be formed here than a pure opaque
// type can.  Peels alias / readonly / transparent-named wrappers — but NOT
// pointers (a `*Box` / `@Box` handle to it is the legal escape hatch), matching
// isOpaqueType's peel.  Same-package use (OpaqueExportPkg == curPkgPath) is not
// opaque — the provider forms its own values.
func isCrossPkgOpaqueExport(c @Checker, t @Type) bool {
	var depth int = 0
	for t != nil && depth < 1024 {
		depth = depth + 1
		if t.Kind == TYP_NAMED && len(t.OpaqueExportPkg) > 0 && !charEq(t.OpaqueExportPkg, c.curPkgPath) {
			return true
		}
		if t.Kind == TYP_ALIAS {
			t = t.Target
		} else if t.Kind == TYP_READONLY {
			t = t.Elem
		} else if t.Kind == TYP_NAMED && t.Underlying != nil {
			t = t.Underlying
		} else {
			return false
		}
	}
	return false
}

// isOpaqueValueType reports whether forming a VALUE of t is forbidden because t
// is opaque to the current package — either a pure opaque type (nil Underlying)
// or a cross-package opaque export (filled layout, but the .bni surface is
// opaque here).  The single predicate the by-value gates key off.
func isOpaqueValueType(c @Checker, t @Type) bool {
	return isOpaqueType(t) || isCrossPkgOpaqueExport(c, t)
}

// embedsOpaqueByValue reports whether using t BY VALUE requires an opaque
// type's (unknown) layout: t itself is opaque, or t aggregates an opaque value
// — an array element, a struct field, or a slice element.  A raw/managed slice
// of a bare opaque element (`*[]Opaque` / `@[]Opaque`) is included: indexing
// needs the element stride, which is unknown, so the slice type is ill-formed.
// Pointers / handles (`*T` / `@T`) stop the recursion — their layout is known
// regardless of the pointee — so `*Opaque`, `[N]@Opaque`, `struct { p *Opaque }`,
// and `@[]@Opaque` (a slice of pointers) are all fine.
func embedsOpaqueByValue(c @Checker, t @Type) bool {
	var seen @[]@[]char
	return embedsOpaqueByValueSeen(c, t, seen)
}

// embedsOpaqueByValueSeen is the cycle-aware worker.  `seen` is the set of
// named types already on the current branch (by qualified name).  Recursing
// into a slice element can revisit a recursive managed type
// (`struct { kids @[]Node }`), so an edge back to a name already on the branch
// is a cycle that introduces no NEW opaque and stops the recursion.  A fresh
// `seen` per named-type step keeps sibling branches independent — the len-bound
// makes a shared backing array safe; mirrors dfsCycleSearch
// (check_pending_cycles.bn).  Recurses over resolved @Type fields / elements
// (alias / named-distinct peeled), not AST.
func embedsOpaqueByValueSeen(c @Checker, t @Type, seen @[]@[]char) bool {
	if isOpaqueValueType(c, t) {
		return true
	}
	if t != nil && len(t.Name) > 0 {
		if containsName(seen, t.Name) {
			return false
		}
		seen = slices.Append[@[]char](seen, t.Name)
	}
	var base @Type
	base, _ = peelFieldAccessBase(t)
	if base == nil {
		return false
	}
	if base.Kind == TYP_ARRAY {
		return embedsOpaqueByValueSeen(c, base.Elem, seen)
	}
	if base.Kind == TYP_STRUCT {
		for i := 0; i < len(base.Fields); i++ {
			if embedsOpaqueByValueSeen(c, base.Fields[i].Type, seen) {
				return true
			}
		}
		return false
	}
	if base.Kind == TYP_SLICE || base.Kind == TYP_MANAGED_SLICE {
		return embedsOpaqueByValueSeen(c, base.Elem, seen)
	}
	return false
}

// requireSizedType reports an error if t embeds an opaque type by value in a
// context that needs its layout — a value-typed variable, a struct value field,
// an array element, a slice element, or a by-value function parameter or
// return.  An opaque type can only be held behind a pointer or handle (`*T` /
// `@T`), never embedded by value.  MUST be called only after type collection
// (when a forward-referenced placeholder is filled and only genuine opaques
// remain nil-Underlying) — see checkValueEmbedding.
func requireSizedType(c @Checker, t @Type, pos token.Pos) {
	if embedsOpaqueByValue(c, t) {
		addCheckError(c, pos,
				"cannot use an opaque type by value"
						" (its layout is not available here; hold it via *T or @T)")
		return
	}
	// A pointer / handle whose ULTIMATE pointee embeds an opaque type by value
	// but is not itself bare opaque (`*Box[Opaque]`, `**Box[Opaque]`,
	// `@(*struct { o Opaque })`) is ill-formed: that pointee can never be a
	// value (every field access is rejected) and merely forming the type
	// instantiates / lays out a struct IR-gen would fabricate.  Bare `*Opaque`
	// / `@Opaque` — the escape hatch — stay legal (the pointee IS bare opaque).
	// This closes the pointer-to-opaque-embedding residual so IR-gen never sees
	// an opaque arg.
	if pointeeEmbedsOpaque(c, t) {
		addCheckError(c, pos,
				"cannot form a pointer to a type that embeds an opaque type by"
						" value (it can never be a value; hold the opaque directly via"
						" *Opaque / @Opaque)")
	}
}

// pointeeEmbedsOpaque reports whether t is a pointer / handle (possibly nested,
// alias / named peeled) whose ULTIMATE pointee embeds an opaque type by value
// but is not itself bare opaque.  Peels through every pointer/handle level; a
// self-referential pointer chain (`type P *P`) terminates via the visited-name
// set with no opaque found.  Returns false for a non-pointer t (the value case
// is handled by embedsOpaqueByValue) and for the bare `*Opaque` / `@Opaque`
// escape hatch (the pointee is bare opaque).
func pointeeEmbedsOpaque(c @Checker, t @Type) bool {
	var seen @[]@[]char
	var cur @Type = t
	var peeledPointer bool = false
	for cur != nil {
		if len(cur.Name) > 0 {
			if containsName(seen, cur.Name) {
				return false
			}
			seen = slices.Append[@[]char](seen, cur.Name)
		}
		var base @Type
		base, _ = peelFieldAccessBase(cur)
		if base == nil {
			return false
		}
		if base.Kind == TYP_POINTER || base.Kind == TYP_MANAGED_PTR {
			cur = base.Elem
			peeledPointer = true
			continue
		}
		// base is the ultimate non-pointer pointee.  Flag it only if t was
		// actually a pointer (otherwise embedsOpaqueByValue already covered it).
		if !peeledPointer {
			return false
		}
		return embedsOpaqueByValue(c, base) && !isOpaqueValueType(c, base)
	}
	return false
}
