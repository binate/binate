package "pkg/binate/types"

import "pkg/builtins/testing"

// Value-embedding an opaque type needs its (unavailable) layout, so each is
// rejected: a value-typed var, a struct value field, an array element, a
// by-value parameter, and a by-value return.  Holding it behind *T / @T is
// fine (TestCheckOpaqueBehindPointerOk).
func TestCheckOpaqueValueVarRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\nfunc f() { var x Opaque; _ = x }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

func TestCheckOpaqueStructValueFieldRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\ntype S struct { o Opaque }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

func TestCheckOpaqueArrayElementRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\nfunc f() { var a [3]Opaque; _ = a }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

func TestCheckOpaqueStructArrayFieldRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\ntype S struct { a [3]Opaque }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

func TestCheckOpaqueByValueParamRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\nfunc f(o Opaque) {}\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

func TestCheckOpaqueByValueReturnRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\nfunc f() Opaque {}\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

// embedsOpaqueByValue recurses into struct fields (not just array elements): an
// ANONYMOUS struct value field embeds an opaque value and is rejected.
func TestCheckOpaqueAnonStructValueFieldRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\nfunc f(s struct { o Opaque }) {}\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

// A nested aggregate (array of a struct with an opaque field) is caught through
// the combined array -> struct recursion.
func TestCheckOpaqueNestedArrayStructRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func f() { var a [2]struct { o Opaque }; _ = a }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

// A raw / managed slice of a bare opaque ELEMENT is ill-formed (indexing needs
// the unknown element stride), so it is rejected as a var type and as a struct
// field; nested slices and array-of-slice are caught through the recursion.
func TestCheckOpaqueRawSliceElemRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\nfunc f() { var s *[]Opaque; _ = s }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

func TestCheckOpaqueManagedSliceElemRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\nfunc f() { var s @[]Opaque; _ = s }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

func TestCheckOpaqueSliceInStructFieldRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\ntype S struct { items @[]Opaque }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

func TestCheckOpaqueNestedSliceRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\nfunc f() { var s @[]@[]Opaque; _ = s }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

// A RECURSIVE managed type must NOT loop or false-fire: `@[]Node` inside Node
// is a cycle the visited-set breaks (no opaque is reached), so it compiles.
// This is the regression that an unbounded slice recursion would hang on.
func TestCheckOpaqueRecursiveManagedTypeOk() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Node struct { kids @[]Node }\n"
					"func f(n @Node) { _ = n }\n")
	return expectNoErrors(c)
}

// Opaque behind a pointer / handle is fine in every value-embedding position —
// struct fields, array elements, an anonymous struct with a pointer field, and
// a slice of pointers (`@[]@Opaque` / `*[]*Opaque`): the pointer element stops
// the recursion even though slice elements are now walked.
func TestCheckOpaqueBehindPointerOk() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"type S struct { o @Opaque; p *Opaque; a [2]*Opaque }\n"
					"func f(o @Opaque, sl @[]@Opaque, rs *[]*Opaque,"
					" as struct { p *Opaque }) *Opaque {"
					" var x @Opaque; _ = x; _ = sl; _ = rs; _ = as; return nil }\n")
	return expectNoErrors(c)
}

// A by-value use of a type FORWARD-REFERENCED before its (non-opaque) decl must
// NOT error — the check runs post-collection, so the placeholder is resolved by
// then.  This is the os.bni `Seek(whence Whence)` / `type Whence int`
// regression: an inline-at-resolution gate false-fires here.
func TestCheckForwardRefValueTypeOk() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(w Whence) Whence { return w }\n"
					"type S struct { w Whence }\n"
					"type Whence int\n")
	return expectNoErrors(c)
}

// Instantiating a generic FUNCTION whose (substituted) param or result embeds
// an opaque value is rejected at the call site — `mk[Opaque]()` returns an
// opaque value (and would otherwise monomorphize to an i64-returning function
// colliding with `mk[int]`).  The discard form has no var to catch it, so the
// instantiation gate is what fires.
func TestCheckOpaqueGenericFuncReturnRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\nfunc mk[T any]() T { var z T; return z }\n"
					"func f() { _ = mk[Opaque]() }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

// Instantiating a generic INTERFACE whose method param / result embeds an
// opaque value is rejected — `Getter[Opaque]` with `get() T`.
func TestCheckOpaqueGenericInterfaceMethodRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\ninterface Getter[T any] { get() T }\n"
					"func f(g @Getter[Opaque]) { _ = g }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

// Positives: a generic function / interface instantiated with a concrete type,
// or with a type-param used only behind a pointer, stays legal.
func TestCheckOpaqueGenericConcreteOk() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc mk[T any]() T { var z T; return z }\n"
					"interface Getter[T any] { get() T }\n"
					"func f(g @Getter[int]) { var n int = mk[int](); _ = n; _ = g }\n")
	return expectNoErrors(c)
}

func TestCheckOpaqueGenericPointerParamOk() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\nfunc ptr[T any](x *T) *T { return x }\n"
					"func f(o *Opaque) { _ = ptr[Opaque](o) }\n")
	return expectNoErrors(c)
}

// A composite literal FORMS a value, so an opaque (or opaque-embedding) one is
// rejected at the literal — the choke point for any context (var init, discard).
func TestCheckOpaqueCompositeLitRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\nfunc f() { var x = Opaque{}; _ = x }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

func TestCheckOpaqueCompositeLitDiscardRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\nfunc f() { _ = Opaque{} }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

func TestCheckOpaqueCompositeLitEmbeddingRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\ntype Box[T any] struct { v T }\n"
					"func f() { var x = Box[Opaque]{}; _ = x }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

// An INFERRED var (no type annotation) binding an opaque value the composite
// gate doesn't see — a deref load `var x = *opaquePtr` — is rejected too.
func TestCheckOpaqueInferredVarDerefRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\nfunc g() *Opaque { return nil }\n"
					"func f() { var x = *g(); _ = x }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

// The gates must NOT over-reject a normal composite literal or inferred var.
func TestCheckOpaqueCompositeLitConcreteOk() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Point struct { x int; y int }\n"
					"func f() { var p = Point{1, 2}; var n = 5; _ = p; _ = n }\n")
	return expectNoErrors(c)
}

// A deref-as-rvalue forms an opaque value even when no typed var binds it:
// discarding a deref-load (`_ = *p`) and copying one opaque slot to another
// (`*dst = *src`) are rejected at the assignment RHS; a `:=` short var decl is
// caught too.
func TestCheckOpaqueDerefDiscardRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\nfunc g() *Opaque { return nil }\n"
					"func f() { _ = *g() }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

func TestCheckOpaqueDerefAssignRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func f(dst *Opaque, src *Opaque) { *dst = *src }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

func TestCheckOpaqueDerefShortVarRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\nfunc g() *Opaque { return nil }\n"
					"func f() { x := *g(); _ = x }\n")
	return expectErrSub(c, "cannot use an opaque type by value")
}

// Normal assignments / discards must NOT be over-rejected.
func TestCheckOpaqueAssignConcreteOk() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\nfunc h() int { return 1 }\n"
					"func f() { var a int = 0; a = h(); _ = h(); b := h(); _ = a; _ = b }\n")
	return expectNoErrors(c)
}

// A pointer / handle to a type that EMBEDS opaque by value (but isn't bare
// opaque) is ill-formed — `*Box[Opaque]` / `@Box[Opaque]`: the pointee can
// never be a value and merely forming it lays out a struct IR-gen would
// fabricate (a colliding `Box__bn_inst__int`).  Closing this keeps an opaque
// arg from ever reaching IR-gen.  Bare `*Opaque` / `@Opaque` (the escape hatch)
// and `*Box[int]` (concrete) stay legal.
func TestCheckOpaquePointerToEmbeddingRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\ntype Box[T any] struct { v T }\n"
					"func f(p *Box[Opaque]) { _ = p }\n")
	return expectErrSub(c, "cannot form a pointer to a type that embeds an opaque")
}

func TestCheckOpaqueHandleToEmbeddingRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\ntype Box[T any] struct { v T }\n"
					"func f(p @Box[Opaque]) { _ = p }\n")
	return expectErrSub(c, "cannot form a pointer to a type that embeds an opaque")
}

func TestCheckOpaquePointerToAnonStructEmbeddingRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\n"
					"func f(p *struct { o Opaque }) { _ = p }\n")
	return expectErrSub(c, "cannot form a pointer to a type that embeds an opaque")
}

func TestCheckOpaquePointerToConcreteOrBareOk() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\ntype Box[T any] struct { v T }\n"
					"func f(bare *Opaque, h @Opaque, conc *Box[int]) {"
					" _ = bare; _ = h; _ = conc }\n")
	return expectNoErrors(c)
}

// The pointee check peels through NESTED pointers (`**Box[Opaque]` /
// `@(*Box[Opaque])`), and terminates on a self-referential pointer chain
// (`type P *P`) via the visited-name set — without over-rejecting it.
func TestCheckOpaqueNestedPointerToEmbeddingRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype Opaque\ntype Box[T any] struct { v T }\n"
					"func f(p **Box[Opaque], q @(*Box[Opaque])) { _ = p; _ = q }\n")
	return expectErrSub(c, "cannot form a pointer to a type that embeds an opaque")
}

func TestCheckOpaqueSelfReferentialPointerOk() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\ntype P *P\nfunc f(x P) { _ = x }\n")
	return expectNoErrors(c)
}
