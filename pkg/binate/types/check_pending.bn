package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/stdx/slices"

// Tier 3 forward references — pending-decl plumbing.  Kept in
// its own file because the substrate is a discrete subsystem
// (queue mutation + retry mechanics + a couple of small
// predicates) and pulling it out keeps checker.bn under the
// file-length cap.  The TentativeMode error-routing in
// errUndefined / addCheckError stays in checker.bn alongside
// the rest of the error reporters; everything else is here.

// migrateTentativeErrors moves any errors captured in
// TentativeMode from c.TentativeErrors into c.Errors, then
// clears TentativeErrors.  Called when no missing names were
// captured — meaning the errors are genuinely the user's, not
// cascade noise from forward refs.
func migrateTentativeErrors(c @Checker) {
	for i := 0; i < len(c.TentativeErrors); i++ {
		c.Errors = appendUniqueCheckError(c.Errors, c.TentativeErrors[i])
	}
	var emptyTentErrs @[]CheckError
	c.TentativeErrors = emptyTentErrs
}

// parkPendingDecl appends a {decl, missing-names} record to
// c.Pending.  Caller (CheckDeclInScope) does this after a
// tentative body check found undefined names but no other
// errors.  For a parked group member (one DECL_CONST inside a
// DECL_GROUP), use parkPendingDeclMember instead so the iota
// position survives across the park / retry cycle.
func parkPendingDecl(c @Checker, d @ast.Decl,
		missing @[]@[]char) {
	parkPendingDeclMember(c, d, missing, -1)
}

// parkPendingDeclMember is the variant that records IotaIdx —
// the parked decl's position within its containing const group.
// Free top-level decls pass -1; group members pass their
// 0-based index.  RetryPendingDecls restores c.Iota from
// IotaIdx before re-running checkConstDecl so the same iota
// value is used at retry time as would have been at the
// original definition time.
func parkPendingDeclMember(c @Checker, d @ast.Decl,
		missing @[]@[]char, iotaIdx int) {
	var pd @PendingDecl = make(PendingDecl)
	pd.Decl = d
	pd.MissingNames = missing
	pd.IotaIdx = iotaIdx
	c.Pending = slices.Append[@PendingDecl](c.Pending, pd)
}

// capturePendingDep records `name` as a missing-name dependency
// on whatever decl is currently being checked.  Used by callers
// of `resolveTypeExpr` whose context needs the resolved type's
// layout (struct field, var, sized sig position) and that get
// back a `Type` with `IsPending = true` — rather than letting
// the layout-needing operation crash or compute garbage, the
// caller captures the pending type's name so the surrounding
// decl parks waiting on that type to resolve.
//
// No-op outside TentativeMode — pending-type propagation is
// fundamentally a "this body / sig referenced something
// unresolved" signal, which only makes sense inside the same
// tentative-check pass that parks decls on TentativeMissing.
// Dedups against names already captured so multiple sized uses
// of the same pending type don't park the name multiple times.
//
// Stage 2 (a) of plan-repl-tier3-pending-types.md ships this
// helper alongside the `Type.IsPending` field; the per-caller
// gating at sized-use sites lands in Stage 2 (b)+(c).
func capturePendingDep(c @Checker, name *[]readonly char) {
	if !c.TentativeMode { return }
	if containsName(c.TentativeMissing, name) { return }
	var copy @[]char = make_slice(char, len(name))
	for i := 0; i < len(name); i++ { copy[i] = name[i] }
	c.TentativeMissing = slices.Append[@[]char](
		c.TentativeMissing, copy)
}

// IsDeclPending reports whether the most recent
// CheckDeclInScope call parked any decl.  For DECL_FUNC /
// DECL_VAR / DECL_CONST this is one decl; for DECL_GROUP it
// may be zero or more (per-member parking — Stage 1 (c) of
// plan-repl-tier3-pending-types.md).  Tracked via c.PendingMark,
// the snapshot of len(c.Pending) at CheckDeclInScope entry.
// REPL driver gate for "skip IR-gen, print parked-message(s)";
// driver also walks Pending[PendingMark:] to enumerate which
// specific decls parked.
func (c @Checker) IsDeclPending() bool {
	return len(c.Pending) > c.PendingMark
}

// RetryPendingDecls re-runs the body check (in TentativeMode)
// on every entry of c.Pending.  Returns the decls that now
// resolve cleanly so the REPL driver can IR-gen and lower
// them.  Decls still missing names stay parked.
func (c @Checker) RetryPendingDecls() @[]@ast.Decl {
	var resolved @[]@ast.Decl
	if len(c.Pending) == 0 { return resolved }
	var stillPending @[]@PendingDecl
	for i := 0; i < len(c.Pending); i++ {
		var pd @PendingDecl = c.Pending[i]
		var emptyMissing @[]@[]char
		c.TentativeMissing = emptyMissing
		var emptyTentErrs @[]CheckError
		c.TentativeErrors = emptyTentErrs
		c.TentativeMode = true
		// Group-member retry: restore the original iota value
		// before re-checking, so the member's value (any iota
		// references in d.Value) matches its source-order
		// position.  Group-atomic parking (IotaIdx == -1) goes
		// through the regular checkDecls path; iota for those
		// is managed by checkGroupDecl.
		if pd.IotaIdx >= 0 {
			var savedIota int = c.Iota
			c.Iota = pd.IotaIdx
			checkConstDecl(c, pd.Decl)
			c.Iota = savedIota
		} else if pd.Decl.Kind == ast.DECL_TYPE {
			// DECL_TYPE retry: re-run collectTypeDecl (the type's
			// resolution lives in pass 1, not checkDecls).  On
			// success, the type's IsPending was reset by the
			// caller (via checkDeclTypeTentative); but since we
			// run collectTypeDecl directly here, do the same
			// fixup ourselves.
			collectTypeDecl(c, pd.Decl)
			if len(c.TentativeMissing) == 0 {
				var sym @Symbol = c.Scope.Lookup(pd.Decl.Name)
				if sym != nil && sym.Type != nil {
					sym.Type.IsPending = false
				}
			}
		} else {
			// DECL_FUNC retry needs the sig audit too — a func
			// might be parked solely because its sig references
			// a pending type whose Underlying is now filled but
			// whose placeholder is still pending in OTHER ways
			// (transitive forward-ref chain).  Without the
			// audit, checkDecls's body-only check would
			// incorrectly report the func as resolved.
			if pd.Decl.Kind == ast.DECL_FUNC {
				captureFuncSigPendingDeps(c, pd.Decl)
			}
			var single @[]@ast.Decl = make_slice(@ast.Decl, 1)
			single[0] = pd.Decl
			checkDecls(c, single)
		}
		c.TentativeMode = false
		if len(c.TentativeMissing) == 0 {
			// Body now resolves cleanly enough to leave
			// tentative mode.  Any TentativeErrors are real
			// errors (post-resolution type mismatches, etc.)
			// — surface them and treat the decl as "resolved
			// but error-bearing" by not adding to resolved
			// (caller wouldn't IR-gen a real-error decl).
			migrateTentativeErrors(c)
			resolved = slices.Append[@ast.Decl](resolved, pd.Decl)
		} else {
			pd.MissingNames = c.TentativeMissing
			stillPending = slices.Append[@PendingDecl](stillPending, pd)
		}
	}
	c.Pending = stillPending
	var emptyMissing2 @[]@[]char
	c.TentativeMissing = emptyMissing2
	return resolved
}

// IsPendingDecl reports whether `name` is currently parked in
// the checker's pending queue — a top-level decl (free func,
// var, or const) whose body / initializer couldn't be fully
// checked because it referenced names that weren't bound.
// Use-site references can surface a clear "X is unresolved"
// error rather than letting a parked symbol's stale type
// propagate, or letting an undefined-symbol path mask the
// underlying forward-ref cause.
//
// Methods (`pd.Decl.Recv != nil`) are excluded — methods are
// resolved via the receiver type's method set, not via a name
// lookup against c.Scope, so the IsPendingDecl predicate (used
// from `checkIdent`) wouldn't see them.  A future Stage 2
// pending-method follow-up would need a separate per-receiver
// predicate.
func (c @Checker) IsPendingDecl(name *[]readonly char) bool {
	for i := 0; i < len(c.Pending); i++ {
		var pd @PendingDecl = c.Pending[i]
		if pd.Decl.Recv != nil { continue }
		if pd.Decl.Kind != ast.DECL_FUNC &&
				pd.Decl.Kind != ast.DECL_VAR &&
				pd.Decl.Kind != ast.DECL_CONST &&
				pd.Decl.Kind != ast.DECL_TYPE {
			continue
		}
		if charEq(pd.Decl.Name, name) { return true }
	}
	return false
}

// isParkableKind reports whether a decl of this AST kind can
// be parked on c.Pending today.  Stage 1 of plan-repl-tier3-
// pending-types.md ships DECL_FUNC + DECL_VAR + DECL_CONST.
// DECL_GROUP is dispatched separately to checkGroupDeclTentative
// for per-member parking.  Stage 2 adds DECL_TYPE.
func isParkableKind(kind int) bool {
	if kind == ast.DECL_FUNC { return true }
	if kind == ast.DECL_VAR { return true }
	if kind == ast.DECL_CONST { return true }
	return false
}

// checkDeclTypeTentative runs collectTypeDecl on `d` under
// TentativeMode so undefined names in field types / aliases /
// underlyings park rather than fire.  On a successful clean
// pass the placeholder type's IsPending is cleared.  On failure,
// IsPending is set so use sites in sized contexts propagate the
// pending dependency, and (for TYP_NAMED placeholders) Underlying
// is cleared so RetryPendingDecls can re-resolve the body on
// the next attempt — otherwise the half-filled tentative result
// would block the inner `if Underlying == nil` guard that
// gates the in-place fill in collectTypeDecl.
//
// Stage 2 (b) of plan-repl-tier3-pending-types.md.
func checkDeclTypeTentative(c @Checker, d @ast.Decl) {
	c.TentativeMode = true
	collectTypeDecl(c, d)
	c.TentativeMode = false
	var sym @Symbol = c.Scope.Lookup(d.Name)
	if len(c.TentativeMissing) > 0 {
		if sym != nil && sym.Type != nil {
			// For TYP_NAMED placeholders, clear the
			// tentatively-populated Underlying so retry can
			// re-resolve.
			if sym.Type.Kind == TYP_NAMED {
				var nilUnderlying @Type
				sym.Type.Underlying = nilUnderlying
			}
			// IsPending propagates to use sites via
			// capturePendingIfSized.  TYP_ALIAS: the tentative
			// pass overwrote the placeholder with a fresh
			// MakeAliasType; retry will overwrite again with
			// a clean target.
			sym.Type.IsPending = true
		}
		parkPendingDecl(c, d, c.TentativeMissing)
	} else {
		if sym != nil && sym.Type != nil {
			sym.Type.IsPending = false
		}
		migrateTentativeErrors(c)
	}
}

// captureFuncSigPendingDeps re-resolves a func decl's receiver,
// parameter, and result type expressions in TentativeMode so
// any pending-type references in the sig park the func.  Pass 2
// (checkFuncDecl) only inspects the BODY, so without this
// explicit sig audit a func with `func f(x T) int { return 0 }`
// (where T is pending) wouldn't park — its body has no T
// reference to capture.  Callers set c.TentativeMode = true
// before calling; this routine doesn't toggle the flag itself.
//
// For the RECEIVER of a method, the wrapper (`*T` / `@T`) is
// size-stable but the body dereferences through it to access
// fields, so the BASE named type's pending state must propagate.
// `peelToNamedBase` walks through pointer / managed-ptr
// wrappers to find the base; `capturePendingIfSized` then
// captures if it's pending.
//
// Stages 2 (d) + (e) of plan-repl-tier3-pending-types.md.
func captureFuncSigPendingDeps(c @Checker, d @ast.Decl) {
	if d.Recv != nil {
		var rt @Type = resolveTypeExpr(c, d.Recv.Type)
		capturePendingIfSized(c, peelToNamedBase(rt))
	}
	for i := 0; i < len(d.Params); i++ {
		var pt @Type = resolveTypeExpr(c, d.Params[i].Type)
		capturePendingIfSized(c, pt)
	}
	for i := 0; i < len(d.Results); i++ {
		var rt @Type = resolveTypeExpr(c, d.Results[i])
		capturePendingIfSized(c, rt)
	}
}

// peelToNamedBase walks pointer / managed-ptr / alias wrappers
// to find the underlying base type.  Used by the method-receiver
// case in captureFuncSigPendingDeps: a method's receiver of type
// `*T` / `@T` references the wrapper (which is size-stable),
// but the method body dereferences through it to access T's
// fields — so T's pending state is what matters.  Returns the
// peeled type (which may itself be a TYP_NAMED, primitive, or
// nil).  capturePendingIfSized at the caller side decides
// whether the peeled type is pending.
func peelToNamedBase(t @Type) @Type {
	var cur @Type = t
	for cur != nil {
		if cur.Kind == TYP_POINTER || cur.Kind == TYP_MANAGED_PTR {
			cur = cur.Elem
			continue
		}
		if cur.Kind == TYP_ALIAS {
			cur = cur.Target
			continue
		}
		return cur
	}
	return nil
}

// capturePendingIfSized is called by every sized-use site of
// resolveTypeExpr (a context that needs the resolved type's
// layout: struct field, var decl with the type, sized sig
// position, named-type underlying, etc.).  If the resolved type
// carries IsPending, the type's name is captured as a pending
// dependency on c.TentativeMissing — the surrounding decl's
// CheckDeclInScope call (which is in TentativeMode for the
// parkable kinds) sees the capture and parks waiting on the
// pending type to resolve.
//
// Reference contexts (pointer / managed-ptr / slice / managed-
// slice elements) don't call this — their containing aggregate
// is size-stable regardless of the element's pending state.
//
// No-op outside TentativeMode (capturePendingDep returns
// without doing anything).
func capturePendingIfSized(c @Checker, t @Type) {
	if t == nil { return }
	if !t.IsPending { return }
	capturePendingDep(c, t.Name)
}

// checkGroupDeclTentative is the per-member tentative-check
// pass for a top-level `const ( ... )` group.  Each member
// runs through checkConstDecl independently under TentativeMode;
// undefined-name captures park that member alone (with its
// iota position so retry uses the right value), while members
// whose values resolve cleanly land normally.  Members other
// than DECL_CONST (rare — really only iota / value-bearing
// consts belong in a group) are checked strictly.
//
// Resets TentativeMissing per member so one member's missing
// names don't leak into the next member's decision.
// TentativeErrors continues to migrate per member — a member
// that has a real (post-resolution) type error surfaces that
// error AND doesn't park.
func checkGroupDeclTentative(c @Checker, d @ast.Decl) {
	var savedIota int = c.Iota
	c.Iota = 0
	// Track the last explicit member's initializer so a bare member
	// repeats it (re-evaluated at this iota) — mirroring checkGroupDecl
	// and IR-gen's genConstGroup.  Crucially for the REPL: when that
	// initializer references an undefined name, checking the SYNTHESIZED
	// repeat (not the value-less bare decl) captures the dependency, so
	// the bare member PARKS too and resolves to the repeated value on
	// retry — not the plain iota index.
	var prevExpr @ast.Expr = nil
	var prevTypeRef @ast.TypeExpr = nil
	for i := 0; i < len(d.Decls); i++ {
		var m @ast.Decl = d.Decls[i]
		if m.Kind != ast.DECL_CONST {
			var single @[]@ast.Decl = make_slice(@ast.Decl, 1)
			single[0] = m
			checkDecls(c, single)
			continue
		}
		// Effective type: the member's own type if it has one, else the
		// closest preceding member's (inherited across bare members) —
		// mirroring checkGroupDecl / genConstGroup.  Carrying it on the
		// synthesized repeat means a bare member is range-checked at its
		// INHERITED width and, when parked, resolves at that width on
		// retry instead of as untyped int.
		var effTypeRef @ast.TypeExpr = m.TypeRef
		if effTypeRef == nil { effTypeRef = prevTypeRef }
		prevTypeRef = effTypeRef
		// A bare member with a preceding initializer is checked (and
		// parked, on retry) as a synthesized decl carrying that
		// initializer, so checkConstDecl folds the repeat and GenConstMember
		// re-folds it on retry.  A first bare member (no prevExpr) keeps
		// the lenient plain-iota fallback in checkConstDecl.
		var member @ast.Decl = m
		if m.Value == nil && prevExpr != nil {
			var rep @ast.Decl = make(ast.Decl)
			rep.Kind = ast.DECL_CONST
			rep.Name = m.Name
			rep.Value = prevExpr
			rep.TypeRef = effTypeRef
			rep.Pos = m.Pos
			member = rep
		}
		var emptyMissing @[]@[]char
		c.TentativeMissing = emptyMissing
		var emptyTentErrs @[]CheckError
		c.TentativeErrors = emptyTentErrs
		c.TentativeMode = true
		checkConstDecl(c, member)
		c.TentativeMode = false
		if len(c.TentativeMissing) > 0 {
			parkPendingDeclMember(c, member, c.TentativeMissing, c.Iota)
		} else {
			migrateTentativeErrors(c)
		}
		if m.Value != nil {
			prevExpr = m.Value
		}
		c.Iota = c.Iota + 1
	}
	c.Iota = savedIota
}
