package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/stdx/slices"

// Cycle detection over the REPL pending-decl missing-names graph:
// FindFreshCycles + its DFS helpers (findCyclePathFromName / dfsCycleSearch
// / pendingByName).  The REPL driver calls FindFreshCycles to report a
// `type A -> B -> A` cycle that will never resolve on its own.  Split out
// of check_pending.bn to keep that file under the length cap; the parking
// / retry substrate it queries (c.Pending, PendingDecl) lives there.

// FindFreshCycles walks c.Pending[fromIdx:] (decls parked
// during the most-recent CheckDeclInScope call) and returns
// any cycles their missing-names chains close in the global
// pending graph.  Each cycle is returned as a list of names
// starting AND ending with the same name (e.g.
// `["A", "B", "A"]` for the canonical `type A struct { B B };
// type B struct { A A }` case).  REPL driver formats these
// as `type cycle: A -> B -> A` so the user knows the pending
// chain won't resolve on its own.
//
// Skips method decls (Recv != nil) as cycle starts — methods
// aren't in the scope-name graph, so they aren't cycle nodes;
// any cycle that transitively involves a method is detected
// from the type-side of the chain.
//
// Dedups cycles that overlap on the same node set so the same
// cycle isn't reported twice when multiple freshly-parked
// entries belong to it.
func (c @Checker) FindFreshCycles(fromIdx int) @[]@[]@[]char {
	var cycles @[]@[]@[]char
	if fromIdx >= len(c.Pending) { return cycles }
	var seen @[]@[]char
	for i := fromIdx; i < len(c.Pending); i++ {
		var pd @PendingDecl = c.Pending[i]
		if pd.Decl.Recv != nil { continue }
		if containsName(seen, pd.Decl.Name) { continue }
		var path @[]@[]char = findCyclePathFromName(c, pd.Decl.Name)
		if len(path) == 0 { continue }
		cycles = slices.Append[@[]@[]char](cycles, path)
		for j := 0; j < len(path); j++ {
			if !containsName(seen, path[j]) {
				seen = slices.Append[@[]char](seen, path[j])
			}
		}
	}
	return cycles
}

// findCyclePathFromName attempts to find a cycle starting and
// ending at `start` in the pending missing-names graph.
// Returns the path (start, ..., start) on success, an empty
// slice otherwise.  DFS with a per-branch visited set so a
// graph like `A -> B; A -> C -> A` only traces the closing
// path.
func findCyclePathFromName(c @Checker, start *[]readonly char) @[]@[]char {
	var initial @[]@[]char
	var startCopy @[]char = make_slice(char, len(start))
	for i := 0; i < len(start); i++ { startCopy[i] = start[i] }
	initial = slices.Append[@[]char](initial, startCopy)
	return dfsCycleSearch(c, start, start, initial)
}

// dfsCycleSearch is the recursive worker for findCyclePathFromName.
// `target` is the cycle's anchor (the starting name we want to
// close back to); `current` is the node currently being expanded.
// `visited` is the path so far (managed; new slice each recursive
// step to keep branches independent).  Returns the closed path
// (visited + target) on success.
func dfsCycleSearch(c @Checker, target *[]readonly char, current *[]readonly char,
		visited @[]@[]char) @[]@[]char {
	var pd @PendingDecl = pendingByName(c, current)
	if pd == nil {
		var empty @[]@[]char
		return empty
	}
	for i := 0; i < len(pd.MissingNames); i++ {
		var next @[]char = pd.MissingNames[i]
		if charEq(next, target) {
			// Cycle closed.  Re-append target as the explicit
			// closing-marker.
			var result @[]@[]char = visited
			result = slices.Append[@[]char](result, next)
			return result
		}
		if containsName(visited, next) { continue }
		var newVisited @[]@[]char = visited
		newVisited = slices.Append[@[]char](newVisited, next)
		var sub @[]@[]char = dfsCycleSearch(c, target, next, newVisited)
		if len(sub) > 0 { return sub }
	}
	var empty @[]@[]char
	return empty
}

// pendingByName returns the PendingDecl for `name` from
// c.Pending, or nil if no parked top-level scope-name decl
// matches.  Sibling of check_expr.bn's `lookupPending` —
// duplicated here to keep cycle detection self-contained in
// the pending-decl substrate.  Methods are excluded; same
// rationale as in `lookupPending` + IsPendingDecl.
func pendingByName(c @Checker, name *[]readonly char) @PendingDecl {
	for i := 0; i < len(c.Pending); i++ {
		var pd @PendingDecl = c.Pending[i]
		if pd.Decl.Recv != nil { continue }
		if pd.Decl.Kind != ast.DECL_FUNC && pd.Decl.Kind != ast.DECL_VAR &&
				pd.Decl.Kind != ast.DECL_CONST && pd.Decl.Kind != ast.DECL_TYPE {
			continue
		}
		if charEq(pd.Decl.Name, name) { return pd }
	}
	return nil
}
