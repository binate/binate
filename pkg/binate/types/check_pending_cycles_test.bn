package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for the pending-graph cycle detection in check_pending_cycles.bn
// (FindFreshCycles + its DFS helpers).  Split out alongside the source;
// the shared helpers (toBytes, fail, charEq, NewChecker) live in sibling
// test files (check_pending_test.bn / types_test.bn).

// TestFindFreshCyclesDepth2 verifies Stage 4: when a fresh
// park closes a cycle (`type A struct { B B }; type B struct
// { A A }`), FindFreshCycles returns the cycle path.
func TestFindFreshCyclesDepth2() testing.TestResult {
	var c @Checker = NewChecker()

	var aSrc *[]readonly char = "type A struct { B B }"
	var pa @parser.Parser = parser.New(toBytes(aSrc), "<repl>")
	var ad @ast.Decl = pa.ParseTopLevelDecl()
	c.CheckDeclInScope(ad)
	if !c.IsPendingDecl("A") {
		return fail("setup: A should park")
	}

	// B's decl closes the cycle: its field A is a sized use of
	// the (still pending) A placeholder, so B parks waiting on
	// A.  At this point B's MissingNames = [A], A's
	// MissingNames = [B] → cycle.
	var bSrc *[]readonly char = "type B struct { A A }"
	var pb @parser.Parser = parser.New(toBytes(bSrc), "<repl>")
	var bd @ast.Decl = pb.ParseTopLevelDecl()
	c.CheckDeclInScope(bd)
	if !c.IsPendingDecl("B") {
		return fail("B should also park (cycle)")
	}

	// FindFreshCycles called with fromIdx=c.PendingMark sees
	// the freshly-parked B and finds the cycle.
	var cycles @[]@[]@[]char = c.FindFreshCycles(c.PendingMark)
	if len(cycles) != 1 {
		return fail("expected exactly one cycle")
	}
	var path @[]@[]char = cycles[0]
	if len(path) != 3 {
		return fail("expected cycle path of length 3 (B, A, B)")
	}
	if !charEq(path[0], "B") { return fail("path[0] should be B") }
	if !charEq(path[1], "A") { return fail("path[1] should be A") }
	if !charEq(path[2], "B") { return fail("path[2] should be B (closes)") }
	return ""
}

// TestFindFreshCyclesNoFalsePositiveOnDangling verifies that a
// pending decl whose missing name is genuinely undefined (NOT
// itself parked) doesn't trip the cycle detector — that's a
// chain waiting on an external dep, not a cycle.
func TestFindFreshCyclesNoFalsePositiveOnDangling() testing.TestResult {
	var c @Checker = NewChecker()

	// A waits on B; B is never defined.  No cycle.
	var aSrc *[]readonly char = "type A struct { F B }"
	var pa @parser.Parser = parser.New(toBytes(aSrc), "<repl>")
	var ad @ast.Decl = pa.ParseTopLevelDecl()
	c.CheckDeclInScope(ad)
	if !c.IsPendingDecl("A") { return fail("setup: A should park") }

	var cycles @[]@[]@[]char = c.FindFreshCycles(c.PendingMark)
	if len(cycles) != 0 {
		return fail("expected no cycles for dangling forward-ref")
	}
	return ""
}
