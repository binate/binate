package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for checkReservedDeclNames (check_decl.bn): a user declaration
// whose name is reserved for compiler-synthesized symbols (a `__` prefix,
// or carrying the `__bn_inst__` instantiation marker) is rejected, because
// it would otherwise mangle to the same linker symbol as a compiler helper
// (a silent duplicate-symbol miscompilation).  See mangle.IsReservedIdentifier.

// reservedErr reports whether any checker error message names the reserved-
// identifier rule (so the test pins THAT error, not an unrelated one).
func reservedErr(c @Checker) bool {
	var errs @[]CheckError = c.CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if msgContains(errs[i].Msg, "reserved identifier") { return true }
	}
	return false
}

// msgContains reports whether haystack contains needle as a substring.
func msgContains(haystack *[]readonly char, needle *[]readonly char) bool {
	if len(needle) > len(haystack) { return false }
	for i := 0; i <= len(haystack) - len(needle); i++ {
		var match bool = true
		for j := 0; j < len(needle); j++ {
			if haystack[i + j] != needle[j] { match = false; break }
		}
		if match { return true }
	}
	return false
}

// A free function named `__entry` would mangle to the reserved `bn_entry`
// (the C-runtime entry symbol) — rejected.
func TestReservedFuncDunderEntry() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"func __entry() { }\n"
	if !reservedErr(checkSrc(src)) {
		return "func __entry must be rejected as a reserved identifier"
	}
	return ""
}

// A free function whose name carries the `__bn_inst__` marker as an infix
// would be misread by the mangler as a generic instantiation (a crafted
// name can alias a real instantiation's symbol) — rejected.
func TestReservedFuncInstMarkerInfix() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"func foo__bn_inst__bar() { }\n"
	if !reservedErr(checkSrc(src)) {
		return "func foo__bn_inst__bar must be rejected as a reserved identifier"
	}
	return ""
}

// A `__`-prefixed global collides with synthesized helpers (`bn_G`).
func TestReservedGlobalDunder() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"var __g int = 0\n"
	if !reservedErr(checkSrc(src)) {
		return "var __g must be rejected as a reserved identifier"
	}
	return ""
}

// A `__`-prefixed type name collides with synthesized struct symbols (`bn_S`).
func TestReservedTypeDunder() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"type __T int\n"
	if !reservedErr(checkSrc(src)) {
		return "type __T must be rejected as a reserved identifier"
	}
	return ""
}

// A `__`-prefixed method name is rejected too (a synthesized dtor/copy
// helper could collide); the reservation is uniform across declarations.
func TestReservedMethodDunder() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"type T struct { x int }\n"
		"func (t *T) __m() { }\n"
	if !reservedErr(checkSrc(src)) {
		return "method __m must be rejected as a reserved identifier"
	}
	return ""
}

// Ordinary names — including the single-underscore convention — are NOT
// reserved.  This guards against the rule being over-broad: `_priv`,
// single-leading-underscore names, and an infix double-underscore that is not
// the marker (`a__b`) all type-check cleanly.
func TestReservedAllowsOrdinaryNames() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\n"
		"func _priv() { }\n"
		"var a__b int = 0\n"
		"type Point struct { x int }\n"
	if reservedErr(checkSrc(src)) {
		return "ordinary / single-underscore names must NOT be reserved"
	}
	return ""
}

// A REPL top-level reserved type name (`type __T`) must be rejected.  The
// REPL entry CheckDeclInScope special-cases DECL_TYPE and returns before
// collectDecls (where checkReservedDeclNames runs for every other kind), so
// the reserved-name check is invoked directly in that branch.
func TestReplReservedTypeRejected() testing.TestResult {
	var base *[]readonly char = "package \"test\"\nfunc main() {}\n"
	var bp @parser.Parser = parser.New(toBytes(base), "test.bn")
	var f @ast.File = bp.ParseFile()
	var c @Checker = NewChecker()
	c.CheckMainPersistent(f)
	if len(c.CheckerErrors()) != 0 {
		return "base REPL file should load clean"
	}
	var dp @parser.Parser = parser.New(toBytes("type __T int"), "<repl>")
	var d @ast.Decl = dp.ParseTopLevelDecl()
	c.CheckDeclInScope(d)
	if !reservedErr(c) {
		return "REPL `type __T` must be rejected as a reserved identifier"
	}
	return ""
}
