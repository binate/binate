package "pkg/binate/types"

import "pkg/stdx/slices"

// `Self` type substitution and detection — the type-checker
// substrate for `plan-self-type.md` Slice S.2.  Three concerns:
//
//   - substituteSelf: replaces every `TYP_SELF` occurrence in a
//     type with the implementing type.  Used by impl-validation
//     (methodSigSatisfies) and will be used by generic
//     instantiation (plan-generics.md Slice 3).
//   - typeContainsSelf: predicate — does this type mention
//     TYP_SELF anywhere?  Used by funcTypeUsesSelf.
//   - funcTypeUsesSelf: predicate on a FuncType — used by
//     plan-self-type.md Slice S.3 to reject method calls
//     through interface values when the resolved method uses
//     Self.

// substituteSelf returns a copy of `t` with every TYP_SELF
// occurrence replaced by `recv` (typically the base named type
// of the impl's receiver).  Composites recurse.  Returns `t`
// unchanged when there's nothing to substitute (the common
// case for non-Self-using interfaces).
func substituteSelf(t @Type, recv @Type) @Type {
	if t == nil { return nil }
	if t.Kind == TYP_SELF { return recv }
	// Composite types: recurse on the element type.  Reconstruct
	// only when the element changed, to preserve identity for the
	// (common) non-Self case.
	if t.Kind == TYP_POINTER {
		var sub @Type = substituteSelf(t.Elem, recv)
		if sub == t.Elem { return t }
		return MakePointerType(sub)
	}
	if t.Kind == TYP_MANAGED_PTR {
		var sub @Type = substituteSelf(t.Elem, recv)
		if sub == t.Elem { return t }
		return MakeManagedPtrType(sub)
	}
	if t.Kind == TYP_SLICE {
		var sub @Type = substituteSelf(t.Elem, recv)
		if sub == t.Elem { return t }
		return MakeSliceType(sub)
	}
	if t.Kind == TYP_MANAGED_SLICE {
		var sub @Type = substituteSelf(t.Elem, recv)
		if sub == t.Elem { return t }
		return MakeManagedSliceType(sub)
	}
	if t.Kind == TYP_ARRAY {
		var sub @Type = substituteSelf(t.Elem, recv)
		if sub == t.Elem { return t }
		return MakeArrayType(sub, t.ArrayLen)
	}
	if t.Kind == TYP_READONLY {
		var sub @Type = substituteSelf(t.Elem, recv)
		if sub == t.Elem { return t }
		return MakeReadonlyType(sub)
	}
	// Function types and function-VALUE types carry Self in their
	// Params/Results (an interface method `apply(f *func(Self) int)`),
	// so recurse there and rebuild with the matching constructor —
	// rebuilding only when something changed, to preserve identity for
	// the (common) Self-free case.
	if t.Kind == TYP_FUNC || t.Kind == TYP_FUNC_VALUE || t.Kind == TYP_MANAGED_FUNC_VALUE {
		var newParams @[]@Param
		var changed bool = false
		for i := 0; i < len(t.Params); i++ {
			var sub @Type = substituteSelf(t.Params[i].Type, recv)
			if sub != t.Params[i].Type { changed = true }
			var p @Param = make(Param)
			p.Name = t.Params[i].Name
			p.Type = sub
			p.IsVariadic = t.Params[i].IsVariadic
			newParams = slices.Append[@Param](newParams, p)
		}
		var newResults @[]@Type
		for i := 0; i < len(t.Results); i++ {
			var sub @Type = substituteSelf(t.Results[i], recv)
			if sub != t.Results[i] { changed = true }
			newResults = slices.Append[@Type](newResults, sub)
		}
		if !changed { return t }
		if t.Kind == TYP_FUNC_VALUE { return MakeFuncValueType(newParams, newResults) }
		if t.Kind == TYP_MANAGED_FUNC_VALUE { return MakeManagedFuncValueType(newParams, newResults) }
		return MakeFuncType(newParams, newResults)
	}
	// Other kinds (primitives, NAMED, INTERFACE, STRUCT, etc.) carry
	// no Self references in their internal shape.  STRUCT in
	// principle could contain Self in a field, but Self isn't allowed
	// in struct types (per the decision in claude-notes.md), so we
	// don't recurse into Fields.
	return t
}

// typeContainsSelf reports whether `t` mentions TYP_SELF
// anywhere in its (possibly composite) shape.
func typeContainsSelf(t @Type) bool {
	if t == nil { return false }
	if t.Kind == TYP_SELF { return true }
	if t.Kind == TYP_POINTER || t.Kind == TYP_MANAGED_PTR || t.Kind == TYP_SLICE ||
			t.Kind == TYP_MANAGED_SLICE || t.Kind == TYP_ARRAY || t.Kind == TYP_READONLY {
		return typeContainsSelf(t.Elem)
	}
	// Function / function-value types carry Self in Params/Results, not Elem —
	// so the S.3 object-safety gate (funcTypeUsesSelf) sees `apply(f *func(Self))`.
	if t.Kind == TYP_FUNC || t.Kind == TYP_FUNC_VALUE || t.Kind == TYP_MANAGED_FUNC_VALUE {
		for i := 0; i < len(t.Params); i++ {
			if typeContainsSelf(t.Params[i].Type) { return true }
		}
		for i := 0; i < len(t.Results); i++ {
			if typeContainsSelf(t.Results[i]) { return true }
		}
		return false
	}
	return false
}

// funcTypeUsesSelf reports whether `ft` (a TYP_FUNC) has Self
// in any parameter or result type.  Used by plan-self-type.md
// Slice S.3 to gate method dispatch through interface values:
// a method whose interface-side signature uses Self can't be
// called through `*Iface` / `@Iface`.
func funcTypeUsesSelf(ft @Type) bool {
	if ft == nil { return false }
	for i := 0; i < len(ft.Params); i++ {
		if typeContainsSelf(ft.Params[i].Type) { return true }
	}
	for i := 0; i < len(ft.Results); i++ {
		if typeContainsSelf(ft.Results[i]) { return true }
	}
	return false
}
