package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"

// ============================================================
// Statement Checking
// ============================================================

// checkStmt type-checks a single statement, dispatching by statement kind.
func checkStmt(c @Checker, s @ast.Stmt) {
	if s == nil {
		return
	}

	if s.Kind == ast.STMT_BLOCK {
		pushScope(c)
		checkBlockStmt(c, s)
		popScope(c)
		return
	}

	if s.Kind == ast.STMT_EXPR {
		checkExpr(c, s.X)
		return
	}

	if s.Kind == ast.STMT_ASSIGN {
		checkAssignStmt(c, s)
		return
	}

	if s.Kind == ast.STMT_SHORT_VAR {
		checkShortVarDecl(c, s)
		return
	}

	if s.Kind == ast.STMT_INC_DEC {
		var t @Type = checkExpr(c, s.X)
		if !t.IsInteger() {
			addCheckError(c, s.X.Pos, "inc/dec requires integer operand")
		}
		// Reject ++/-- on a const — like assignment, a const has no
		// storage to mutate (unqualified `C++` and qualified `pkg.C++`).
		// Without this the checker accepts it and, once a local const is
		// materialized into a slot, ++/-- mutates the const at runtime.
		if s.X.Kind == ast.EXPR_IDENT {
			var sym @Symbol = c.Scope.Lookup(s.X.Name)
			if sym != nil && sym.Kind == SYM_CONST {
				var cb @strings.Builder = strings.NewBuilder()
				cb.Write("cannot inc/dec const ")
				cb.Write(s.X.Name)
				addCheckError(c, s.X.Pos, buf.CopyStr(cb.String()))
			}
		}
		var qm @Symbol = resolveQualifiedSym(c, s.X)
		if qm != nil && qm.Kind == SYM_CONST {
			var qcb @strings.Builder = strings.NewBuilder()
			qcb.Write("cannot inc/dec const ")
			qcb.Write(s.X.Name)
			addCheckError(c, s.X.Pos, buf.CopyStr(qcb.String()))
		}
		return
	}

	if s.Kind == ast.STMT_RETURN {
		checkReturnStmt(c, s)
		return
	}

	if s.Kind == ast.STMT_IF {
		var cond @Type = checkExpr(c, s.X)
		if !cond.IsBool() {
			addCheckError(c, s.X.Pos, "non-bool condition")
		}
		pushScope(c)
		checkBlockStmt(c, s.Body)
		popScope(c)
		if s.Else != nil {
			checkStmt(c, s.Else)
		}
		return
	}

	if s.Kind == ast.STMT_FOR {
		checkForStmt(c, s)
		return
	}

	if s.Kind == ast.STMT_SWITCH {
		checkSwitchStmt(c, s)
		return
	}

	if s.Kind == ast.STMT_DECL {
		if s.DeclRef != nil {
			if s.DeclRef.Kind == ast.DECL_VAR {
				// Check for redeclaration of local vars in the current scope
				if len(s.DeclRef.Name) > 0 {
					var existing @Symbol = c.Scope.LookupLocal(s.DeclRef.Name)
					if existing != nil {
						var cb @strings.Builder = strings.NewBuilder()
						cb.Write(s.DeclRef.Name)
						cb.Write(" redeclared in this scope")
						addCheckError(c, s.DeclRef.Pos, buf.CopyStr(cb.String()))
					}
				}
				checkVarDecl(c, s.DeclRef)
			}
			if s.DeclRef.Kind == ast.DECL_CONST {
				checkConstDecl(c, s.DeclRef)
			}
			if s.DeclRef.Kind == ast.DECL_TYPE {
				collectTypeDecl(c, s.DeclRef)
			}
		}
		return
	}

	if s.Kind == ast.STMT_BREAK {
		if !c.InLoop && !c.InSwitch {
			addCheckError(c, s.Pos, "break outside loop or switch")
		}
		return
	}

	if s.Kind == ast.STMT_CONTINUE {
		if !c.InLoop {
			addCheckError(c, s.Pos, "continue outside loop")
		}
		return
	}

	// STMT_EMPTY — nothing to check
}

// checkBlockStmt type-checks all statements in a block.
func checkBlockStmt(c @Checker, s @ast.Stmt) {
	if s == nil {
		return
	}
	for i := 0; i < len(s.Stmts); i++ {
		checkStmt(c, s.Stmts[i])
	}
}

// checkAssignStmt type-checks assignment statements (simple and compound), including multi-return.
// hasExpandableResults reports whether a single-expression RHS of type t is a
// multi-result call that can be destructured across several assignment / short-
// var / return targets.  checkCallExpr returns the callee's whole type for a
// multi-result call, so this is true for a free function (TYP_FUNC) AND for a
// function VALUE call (`*func`/`@func` — TYP_FUNC_VALUE / TYP_MANAGED_FUNC_VALUE);
// the func-value kinds carry the same `.Results`, so the count + per-result
// AssignableTo checks at the call sites are kind-agnostic once the kind is
// admitted.  Guarding on TYP_FUNC alone rejected `a, b := fv()` for a
// multi-return func value (`assignment count mismatch`).
func hasExpandableResults(t @Type) bool {
	if t == nil { return false }
	return t.Kind == TYP_FUNC || t.Kind == TYP_FUNC_VALUE ||
		t.Kind == TYP_MANAGED_FUNC_VALUE
}

// checkAssignTargetConst rejects assigning to a target that has no writable
// storage: a const symbol (unqualified `C` or package-qualified `pkg.C`), or a
// readonly-typed (const) LOCATION — a `readonly @T` / `readonly *T` etc., where
// the binding itself is read-only (distinct from `@(readonly T)`, whose pointer
// IS rebindable).  Applied by the multi-return-destructure path (the simple-
// and compound-assign paths inline the equivalent checks): the destructure path missing the
// readonly check compiled an illegal assignment to a `readonly @T` local, whose
// multi-assign then RefDec'd an uninitialized slot at runtime (SIGBUS) —
// claude-todo #114.
func checkAssignTargetConst(c @Checker, target @ast.Expr, lhsType @Type) {
	if target.Kind == ast.EXPR_IDENT {
		var sym @Symbol = c.Scope.Lookup(target.Name)
		if sym != nil && sym.Kind == SYM_CONST {
			var cb @strings.Builder = strings.NewBuilder()
			cb.Write("cannot assign to const ")
			cb.Write(target.Name)
			addCheckError(c, target.Pos, buf.CopyStr(cb.String()))
		}
	}
	var qmember @Symbol = resolveQualifiedSym(c, target)
	if qmember != nil && qmember.Kind == SYM_CONST {
		var qcb @strings.Builder = strings.NewBuilder()
		qcb.Write("cannot assign to const ")
		qcb.Write(target.Name)
		addCheckError(c, target.Pos, buf.CopyStr(qcb.String()))
	}
	if lhsType != nil && lhsType.IsReadonly() {
		addCheckError(c, target.Pos,
			"cannot assign to const-typed location")
	}
}

// checkAssignStmt validates an assignment statement — a plain `a = b` (with
// blank-identifier handling and per-target assignability), a compound `a += b`,
// and the multi-return destructure `a, b = call()` (via hasExpandableResults).
func checkAssignStmt(c @Checker, s @ast.Stmt) {
	if s.Op == cast(int, token.ASSIGN) {
		// Simple assignment
		if len(s.Exprs) != len(s.Exprs2) {
			// Multi-return case
			if len(s.Exprs2) == 1 {
				var rhsType @Type = checkExpr(c, s.Exprs2[0])
				if hasExpandableResults(rhsType) && len(rhsType.Results) == len(s.Exprs) {
					for i := 0; i < len(s.Exprs); i++ {
						// Blank identifier: discard this result.
						if s.Exprs[i].Kind == ast.EXPR_IDENT &&
								isBlank(s.Exprs[i].Name) {
							continue
						}
						var lhsType @Type = checkExpr(c, s.Exprs[i])
						checkAssignTargetConst(c, s.Exprs[i], lhsType)
						if !rhsType.Results[i].AssignableTo(c, lhsType) {
							errCannotAssign(c, s.Exprs[i].Pos, rhsType.Results[i], lhsType)
						}
					}
					return
				}
			}
			addCheckError(c, s.Pos, "assignment count mismatch")
			return
		}
		for i := 0; i < len(s.Exprs); i++ {
			// Blank identifier on LHS: type-check the RHS for side
			// effects but skip the assignability check — there's no
			// target to constrain.
			if s.Exprs[i].Kind == ast.EXPR_IDENT && isBlank(s.Exprs[i].Name) {
				checkExpr(c, s.Exprs2[i])
				continue
			}
			// Reject assignment to constants — unqualified (`C = v`) and
			// package-qualified (`pkg.C = v`).  A const has no storage; the
			// qualified case otherwise slips through to a silently-no-op
			// store (sibling of the &pkg.C rejection in check_expr.bn).
			if s.Exprs[i].Kind == ast.EXPR_IDENT {
				var sym @Symbol = c.Scope.Lookup(s.Exprs[i].Name)
				if sym != nil && sym.Kind == SYM_CONST {
					var cb @strings.Builder = strings.NewBuilder()
					cb.Write("cannot assign to const ")
					cb.Write(s.Exprs[i].Name)
					addCheckError(c, s.Exprs[i].Pos, buf.CopyStr(cb.String()))
				}
			}
			var qmember @Symbol = resolveQualifiedSym(c, s.Exprs[i])
			if qmember != nil && qmember.Kind == SYM_CONST {
				var qcb @strings.Builder = strings.NewBuilder()
				qcb.Write("cannot assign to const ")
				qcb.Write(s.Exprs[i].Name)
				addCheckError(c, s.Exprs[i].Pos, buf.CopyStr(qcb.String()))
			}
			var lhsType @Type = checkExpr(c, s.Exprs[i])
			// Apply the LHS type as the function-value flavour hint, so a
			// bare func literal RHS (`f = func(){...}`) resolves to the
			// LHS's @func / *func flavour — mirroring the var-init,
			// call-arg, and return sites.  Without it the literal defaults
			// to raw *func(), which is not assignable to an @func() LHS.
			var rhsType @Type = checkExprWithFVHint(c, s.Exprs2[i], lhsType)
			if lhsType.IsReadonly() {
				addCheckError(c, s.Exprs[i].Pos,
					"cannot assign to const-typed location")
			}
			if !rhsType.AssignableTo(c, lhsType) {
				errCannotAssign(c, s.Exprs2[i].Pos, rhsType, lhsType)
			}
		}
	} else {
		// Compound assignment (+=, etc.) — also check const
		if s.Exprs[0].Kind == ast.EXPR_IDENT {
			var sym @Symbol = c.Scope.Lookup(s.Exprs[0].Name)
			if sym != nil && sym.Kind == SYM_CONST {
				var cb @strings.Builder = strings.NewBuilder()
				cb.Write("cannot assign to const ")
				cb.Write(s.Exprs[0].Name)
				addCheckError(c, s.Exprs[0].Pos, buf.CopyStr(cb.String()))
			}
		}
		var lhsType @Type = checkExpr(c, s.Exprs[0])
		var rhsType @Type = checkExpr(c, s.Exprs2[0])
		if lhsType.IsReadonly() {
			addCheckError(c, s.Exprs[0].Pos,
				"cannot compound-assign to const-typed location")
		}
		var baseOp int = compoundToBase(s.Op)
		checkShiftCountNonNegative(c, s.Pos, baseOp, s.Exprs2[0], rhsType)
		checkBinaryOp(c, s.Pos, baseOp, lhsType, rhsType)
	}
}

// checkShortVarDecl type-checks a short variable declaration (:=), defining new variables.
// Blank identifiers (`_`) on the LHS are skipped — the RHS is still
// checked for side effects, but no name enters scope.
func checkShortVarDecl(c @Checker, s @ast.Stmt) {
	// s.Exprs = names (as ident exprs), s.Exprs2 = RHS values
	if len(s.Exprs) != len(s.Exprs2) {
		// Multi-return
		if len(s.Exprs2) == 1 {
			var rhsType @Type = checkExpr(c, s.Exprs2[0])
			if hasExpandableResults(rhsType) && len(rhsType.Results) == len(s.Exprs) {
				for i := 0; i < len(s.Exprs); i++ {
					if isBlank(s.Exprs[i].Name) { continue }
					defineVar(c.Scope, s.Exprs[i].Name, rhsType.Results[i])
				}
				return
			}
		}
		addCheckError(c, s.Pos, "assignment count mismatch")
		return
	}
	for i := 0; i < len(s.Exprs); i++ {
		var rhsType @Type = checkExpr(c, s.Exprs2[i])
		if isBlank(s.Exprs[i].Name) { continue }
		rhsType = defaultTypeForExpr(rhsType, s.Exprs2[i])
		defineVar(c.Scope, s.Exprs[i].Name, rhsType)
	}
}

// checkReturnStmt validates return value count and types against the enclosing function signature.
//
// Each return expression is type-checked with the matching return-
// slot type installed as the function-value hint, so a function-
// literal whose signature matches the declared return type resolves
// as the declared flavour (@func or *func) rather than the default
// raw form.  Without the hint, `return func() { ... }` from a
// function returning `@func()` would resolve the literal as
// `*func()` and the assignability check would then fail (or, if
// AssignableTo is permissive, the literal would be allocated on
// the stack rather than the heap — same lifetime bug as
// `func-value-escape` flags for the same shape).  B.3b of plan-
// function-values-phase-2.md.
func checkReturnStmt(c @Checker, s @ast.Stmt) {
	if len(c.FuncRet) == 0 && len(s.Exprs) == 0 {
		return
	}
	if len(s.Exprs) != len(c.FuncRet) {
		// Single-expression return for a multi-return function:
		// `return f(...)` where f returns the matching tuple. Mirrors
		// the multi-return shape accepted by checkShortVarDecl above
		// (checkCallExpr returns the callee's full func type for multi-
		// return calls — a free function or a `*func`/`@func` value).
		if len(s.Exprs) == 1 && len(c.FuncRet) > 1 {
			var rhsType @Type = checkExpr(c, s.Exprs[0])
			if hasExpandableResults(rhsType) &&
					len(rhsType.Results) == len(c.FuncRet) {
				for i := 0; i < len(c.FuncRet); i++ {
					if !rhsType.Results[i].AssignableTo(c, c.FuncRet[i]) {
						errCannotAssign(c, s.Exprs[0].Pos,
							rhsType.Results[i], c.FuncRet[i])
					}
				}
				return
			}
		}
		addCheckError(c, s.Pos, "wrong number of return values")
		return
	}
	for i := 0; i < len(s.Exprs); i++ {
		var rt @Type = checkExprWithFVHint(c, s.Exprs[i], c.FuncRet[i])
		if !rt.AssignableTo(c, c.FuncRet[i]) {
			errCannotAssign(c, s.Exprs[i].Pos, rt, c.FuncRet[i])
		}
	}
}

// checkForStmt type-checks for loops (C-style and for-in range loops).
func checkForStmt(c @Checker, s @ast.Stmt) {
	pushScope(c)

	if s.ForVal != nil {
		// For-in
		var iterType @Type = checkExpr(c, s.X)
		var elemType @Type = forInElemType(c, s.X.Pos, iterType)
		if s.ForKey != nil {
			defineVar(c.Scope, s.ForKey.Name, TypInt())
		}
		if s.ForVal != nil {
			defineVar(c.Scope, s.ForVal.Name, elemType)
		}
	} else {
		if s.Init != nil {
			checkStmt(c, s.Init)
		}
		if s.X != nil {
			var cond @Type = checkExpr(c, s.X)
			if !cond.IsBool() {
				addCheckError(c, s.X.Pos, "non-bool condition")
			}
		}
		if s.Post != nil {
			checkStmt(c, s.Post)
		}
	}

	var savedInLoop bool = c.InLoop
	c.InLoop = true
	checkBlockStmt(c, s.Body)
	c.InLoop = savedInLoop
	popScope(c)
}

// forInElemType returns the element type for a for-in range expression
// (slice, managed-slice, or array).
func forInElemType(c @Checker, pos token.Pos, t @Type) @Type {
	t = t.ResolveAlias()
	if t == nil {
		return TypVoid()
	}
	if t.Kind == TYP_SLICE || t.Kind == TYP_MANAGED_SLICE || t.Kind == TYP_ARRAY {
		return t.Elem
	}
	addCheckError(c, pos, "cannot range over non-iterable type")
	return TypVoid()
}

// checkSwitchStmt type-checks a switch statement, including case expression types.
func checkSwitchStmt(c @Checker, s @ast.Stmt) {
	var tagType @Type = nil
	if s.X != nil {
		tagType = checkExpr(c, s.X)
	}
	var savedInSwitch bool = c.InSwitch
	c.InSwitch = true  // break is valid inside switch
	for i := 0; i < len(s.Cases); i++ {
		var cc @ast.CaseClause = s.Cases[i]
		for j := 0; j < len(cc.Exprs); j++ {
			var ct @Type = checkExpr(c, cc.Exprs[j])
			if tagType != nil && !ct.AssignableTo(c, tagType) {
				errTypeMismatch(c, cc.Exprs[j].Pos, ct, tagType)
			}
		}
		pushScope(c)
		for j := 0; j < len(cc.Body); j++ {
			checkStmt(c, cc.Body[j])
		}
		popScope(c)
	}
	c.InSwitch = savedInSwitch
}
