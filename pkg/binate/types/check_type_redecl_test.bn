package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for the no-full-redeclaration rule (check_type_redecl.bn).  A type
// may be declared full at most once per package.  checkSrc tags every
// parsed decl FromBNI == false, so these inline duplicates are .bn-origin
// redeclarations; the benign .bni-reprocessing case (FromBNI == true) is
// exercised at the conformance level (transparent fixtures + self-compile).

// Two full struct declarations of the same name must error, even with
// identical field lists — a type may be declared full at most once.
func TestCheckDuplicateStructSameShapeErrors() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type S struct { a int; b int }\n"
			"type S struct { a int; b int }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) == 0 {
		return "same-shape .bn redeclaration must error"
	}
	return ""
}

// Distinct named-type duplicates follow the same rule: a redeclaration
// errors even when the underlying matches.
func TestCheckDuplicateNamedTypeSameUnderlyingErrors() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Id int\n"
			"type Id int\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) == 0 {
		return "same-underlying named-type .bn redeclaration must error"
	}
	return ""
}

// Alias duplicates follow the same rule: a redeclaration errors even with
// an identical target.
func TestCheckDuplicateAliasErrors() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type R = int\n"
			"type R = int\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) == 0 {
		return "alias .bn redeclaration must error"
	}
	return ""
}

// A single alias decl (no duplicate) is fine — guards against the rule
// false-firing on a first, lone declaration.
func TestCheckSingleAliasNoError() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type R = int\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Mismatched-shape duplicates are rejected too: redeclaration is by name,
// regardless of whether the bodies agree.  (Catching a .bni-says-X /
// .bn-says-Y layout disagreement is exactly the silent-miscompile class the
// rule prevents.)
func TestCheckDuplicateStructMismatchErrors() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type S struct { a int; b int; c bool }\n"
			"type S struct { a int; b int }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) == 0 {
		return "mismatched-shape redeclaration must error"
	}
	return ""
}

// Distinct named-type redeclaration with a different underlying is rejected
// too — by name, not by underlying match.
func TestCheckDuplicateNamedTypeMismatchErrors() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Id int\n"
			"type Id int64\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) == 0 {
		return "mismatched named-type redeclaration must error"
	}
	return ""
}

// A generic type declared full twice is rejected just like a non-generic
// one — generics are not exempt from the no-redeclaration rule (a layout
// disagreement between a .bni and .bn generic decl would otherwise
// silently miscompile).  See conformance/794.
func TestCheckDuplicateGenericTypeErrors() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
			"type Box[T any] struct { v T }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) == 0 {
		return "generic type redeclaration must error"
	}
	return ""
}

// A single generic type decl must not error — guards against the rule
// false-firing on a lone generic declaration.
func TestCheckSingleGenericTypeNoError() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box[T any] struct { v T }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// parseTypeDecls parses source into its top-level decl list.  Used by the
// FromBNI tests, which must set Decl.FromBNI directly — that tag is set by
// the loader, not the parser, so checkSrc (parse + check in one step) can't
// exercise it.
func parseTypeDecls(src *[]readonly char) @[]@ast.Decl {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	return file.Decls
}

// tagTypeFromBNI marks the first full type decl named `name` as
// originating in the .bni, simulating the loader's merge-prepend tag.
func tagTypeFromBNI(decls @[]@ast.Decl, name *[]readonly char) {
	for i := 0; i < len(decls); i++ {
		if decls[i].Kind == ast.DECL_TYPE && streq(decls[i].Name, name) {
			decls[i].FromBNI = true
			return
		}
	}
}

// A type declared full in both the .bni (FromBNI) and a .bn errors with the
// full-in-both-specific message, and points at the .bn decl.  Exercises the
// FromBNI discrimination directly (the conformance fixture 801 covers it
// end-to-end, but no parse-based unit test can set FromBNI).
func TestCheckTypeRedeclFullInBothMessage() testing.TestResult {
	var decls @[]@ast.Decl = parseTypeDecls(
			"package \"test\"\n"
					"type S struct { a int }\n"
					"type S struct { a int }\n")
	tagTypeFromBNI(decls, "S")
	var c @Checker = NewChecker()
	checkTypeRedeclaration(c, decls)
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) == 0 {
		return "full-in-both must error"
	}
	if !charsHaveSub(errs[0].Msg, "declared in full in both the .bni and a .bn") {
		return fail(errs[0].Msg)
	}
	return ""
}

// Two full .bn decls (neither FromBNI) error with the plain-duplicate
// message, NOT the full-in-both phrasing.
func TestCheckTypeRedeclBnDupMessage() testing.TestResult {
	var decls @[]@ast.Decl = parseTypeDecls(
			"package \"test\"\n"
					"type S struct { a int }\n"
					"type S struct { a int }\n")
	var c @Checker = NewChecker()
	checkTypeRedeclaration(c, decls)
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) == 0 {
		return "bn-dup must error"
	}
	if !charsHaveSub(errs[0].Msg, "may be declared in full only once") {
		return fail(errs[0].Msg)
	}
	return ""
}

// A single FromBNI decl (transparent: full in .bni only, re-seen via the
// merge-prepend) must NOT error — guards the benign-reprocessing case that
// the rule must tolerate.
func TestCheckTypeRedeclTransparentNoError() testing.TestResult {
	var decls @[]@ast.Decl = parseTypeDecls(
			"package \"test\"\n"
					"type S struct { a int }\n")
	tagTypeFromBNI(decls, "S")
	var c @Checker = NewChecker()
	checkTypeRedeclaration(c, decls)
	if len(c.CheckerErrors()) > 0 {
		return "single .bni decl must not error"
	}
	return ""
}
