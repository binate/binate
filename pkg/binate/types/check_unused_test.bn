package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the unused-local warning (plan-unused-checks item (b)).
// The rule is CONSERVATIVE: a local is marked used on ANY reference
// (reads and writes), so it flags only never-referenced locals — a
// write-only local is not yet caught (a documented follow-up).

// hasUnusedWarning reports whether the checker warned that local `name`
// was declared and not used.
func hasUnusedWarning(c @Checker, name *[]readonly char) bool {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("declared and not used: ")
	cb.Write(name)
	var want @[]char = buf.CopyStr(cb.String())
	var warns @[]CheckError = c.CheckerWarnings()
	for i := 0; i < len(warns); i++ {
		if charEq(warns[i].Msg, want) { return true }
	}
	return false
}

// A never-referenced local is flagged.
func TestUnusedLocalFlagged() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nfunc f() { var x int = 0 }\n")
	if !hasUnusedWarning(c, "x") { return "expected unused-local warning for x" }
	return ""
}

// A local that is read is not flagged.
func TestUsedLocalNotFlagged() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nfunc f() int { var x int = 0\n return x }\n")
	if hasUnusedWarning(c, "x") { return "used local x must not be flagged" }
	return ""
}

// An unused parameter is not flagged (params are contract-bound).
func TestUnusedParamNotFlagged() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nfunc f(x int) {}\n")
	if hasUnusedWarning(c, "x") { return "unused param x must not be flagged" }
	return ""
}

// The blank identifier is never flagged.
func TestBlankLocalNotFlagged() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nfunc f() { var _ int = 0 }\n")
	if len(c.CheckerWarnings()) > 0 { return "blank local must not warn" }
	return ""
}

// Taking a local's address counts as a use.
func TestAddressOfMarksUsed() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nfunc f() { var x int = 0\n var p *int = &x\n _ = p }\n")
	if hasUnusedWarning(c, "x") { return "&x must mark x used" }
	if hasUnusedWarning(c, "p") { return "p is used via _ = p" }
	return ""
}

// A local captured by a closure counts as used (the closure body's
// reference resolves it and marks it used).
func TestCapturedLocalNotFlagged() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\n"
		"func f() int {\n"
		"\tvar x int = 5\n"
		"\tvar g @func() int = func() int { return x }\n"
		"\treturn g()\n"
		"}\n")
	if hasUnusedWarning(c, "x") { return "captured x must not be flagged" }
	return ""
}

// A block-local variable is swept too (not just the top function scope).
func TestUnusedBlockLocalFlagged() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nfunc f() { if true { var y int = 0 } }\n")
	if !hasUnusedWarning(c, "y") { return "expected unused-local warning for y" }
	return ""
}

// A for-in HEADER binding (`for _, v := range`) is not yet swept by the
// conservative rule — a safe under-warning, folded into the write-only
// follow-up.  A for-BODY local IS swept (see TestUnusedBlockLocalFlagged).
func TestUnusedForInValNotFlaggedYet() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nfunc f(xs @[]int) { for _, v := range xs {} }\n")
	if hasUnusedWarning(c, "v") {
		return "for-in header sweeping changed — update this test + the follow-up"
	}
	return ""
}

// Package-level vars are NOT swept by this rule (that is unused-global's
// job, in bnlint).  A never-referenced package var produces no warning.
func TestUnusedPackageVarNotSwept() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\nvar g int = 0\n")
	if hasUnusedWarning(c, "g") { return "package var must not be swept here" }
	return ""
}

// Conservative stance: a write-only local (assigned, never read) is NOT
// flagged yet — the write marks it used.  Documents the current behavior;
// write-only detection is a planned follow-up.
func TestWriteOnlyLocalNotFlaggedConservative() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nfunc f() { var x int = 0\n x = 5 }\n")
	if hasUnusedWarning(c, "x") {
		return "conservative rule must not flag a write-only local yet"
	}
	return ""
}
