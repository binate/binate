package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/stdx/slices"

// ============================================================
// Checker
// ============================================================

// NewChecker creates a new type checker with predeclared types in scope.
func NewChecker() @Checker {
	var c @Checker = make(Checker)
	c.Iota = -1
	c.Scope = universeScope()
	c.ExprTypes = make_slice(@Type, 256)
	// Reserve index 0 as "unresolved" (Expr.ResolvedTypeID zero-inits to 0).
	c.NumExprTypes = 1
	return c
}

// CheckerErrors returns the list of type errors accumulated during checking.
func (c @Checker) CheckerErrors() @[]CheckError {
	return c.Errors
}

// ExprType returns the resolved type for an expression by its ResolvedTypeID (nil if unresolved).
func (c @Checker) ExprType(id int) @Type {
	if id <= 0 || id >= c.NumExprTypes {
		return nil
	}
	return c.ExprTypes[id]
}

// PackageType returns the type registered for `name` in package `pkgPath`'s
// scope (nil if the package or member is not found).  Lets IR-gen resolve a
// cross-package type — e.g. reflect.Package, for the synthesized
// `__Package() @reflect.Package` accessor (Phase B) — without re-parsing.
func (c @Checker) PackageType(pkgPath *[]readonly char, name *[]readonly char) @Type {
	var s @Scope = lookupPackage(c, pkgPath)
	if s == nil { return nil }
	var sym @Symbol = s.Lookup(name)
	if sym == nil { return nil }
	return sym.Type
}

// PackageMemberHome returns the resolved HOME package of a member of the given
// package — non-empty ONLY for an expose-INJECTED member of ANY kind (func, var,
// const, type, or interface), whose HomePkg was stamped to the exposing chain's
// origin by injectExposedSurface.  Empty for a natively declared member, or an
// unknown package/member.  Resolved-home mangling reads it so a reference `A.X`
// to an exposed member — a value reference OR a qualified type/interface
// reference — resolves to X's home package (the symbol/type that actually
// exists) rather than A's forwarder spelling.
func (c @Checker) PackageMemberHome(pkgPath *[]readonly char, name *[]readonly char) @[]char {
	var empty @[]char
	var s @Scope = lookupPackage(c, pkgPath)
	if s == nil { return empty }
	var sym @Symbol = s.Lookup(name)
	if sym == nil { return empty }
	return sym.HomePkg
}

// registerExprType stores a type in the registry and returns its ID.
func registerExprType(c @Checker, t @Type) int {
	var id int = c.NumExprTypes
	if id >= len(c.ExprTypes) {
		var newCap int = len(c.ExprTypes) * 2
		var newArr @[]@Type = make_slice(@Type, newCap)
		for i := 0; i < id; i++ {
			newArr[i] = c.ExprTypes[i]
		}
		c.ExprTypes = newArr
	}
	c.ExprTypes[id] = t
	c.NumExprTypes = id + 1
	return id
}

// ============================================================
// Package Management
// ============================================================

// lookupPackage returns the scope for a registered package, or nil if not found.
func lookupPackage(c @Checker, path *[]readonly char) @Scope {
	for i := 0; i < len(c.Packages); i++ {
		if charEq(c.Packages[i].Path, path) {
			return c.Packages[i].Scope
		}
	}
	return nil
}

// registerPackage associates a package path with its scope, updating if already registered.
func registerPackage(c @Checker, path @[]char, scope @Scope) {
	// Check if already registered
	for i := 0; i < len(c.Packages); i++ {
		if charEq(c.Packages[i].Path, path) {
			c.Packages[i].Scope = scope
			return
		}
	}
	var entry @PkgEntry = make(PkgEntry)
	entry.Path = path
	entry.Scope = scope
	c.Packages = slices.Append[@PkgEntry](c.Packages, entry)
}

// LoadPackageInterface registers a package scope from a parsed .bni file.
func (c @Checker) LoadPackageInterface(path @[]char, bni @ast.File) {
	if lookupPackage(c, path) != nil {
		return
	}
	var prevPkg @[]char = c.curPkgShort
	var prevPath @[]char = c.curPkgPath
	c.curPkgShort = lastPathSegment(path)
	c.curPkgPath = path
	var scope @Scope = buildScopeFromFile(c, bni)
	c.curPkgPath = prevPath
	c.curPkgShort = prevPkg
	registerPackage(c, path, scope)
}

// ExposeTestFunc registers a `Test*` function into package `path`'s already-
// registered checker scope as a no-arg func returning `@[]char`.  A test
// function lives in a `_test.bn` file and so is absent from the package's `.bni`
// interface scope — the only scope cross-package name resolution consults — so
// without this the synthetic `--test` runner (a separate file the checker
// type-checks so its expressions get resolved types for IR-gen's `*any` boxing)
// cannot resolve `pkg.TestName()`.  The `--test` discovery filter guarantees
// every such function is nullary and returns a `@[]char`-shaped `TestResult`, so
// the erased `func() @[]char` signature is exactly what the runner's
// `var r @[]char = pkg.TestName()` needs; the runner never observes a finer type.
func (c @Checker) ExposeTestFunc(path *[]readonly char, funcName @[]char) {
	var scope @Scope = lookupPackage(c, path)
	if scope == nil {
		return
	}
	var results @[]@Type = make_slice(@Type, 1)
	results[0] = MakeManagedSliceType(TypChar())
	var noParams @[]@Param
	defineFunc(scope, funcName, MakeFuncType(noParams, results))
}

// CheckPackage type-checks a package's implementation files, including
// function bodies, and registers the package's scope by path.
//
// `files` are the package's per-file impl ASTs (loader.Package.Files) and `bni`
// its interface AST (loader.Package.BNI); both carry per-file `Imports` so each
// decl is resolved against ONLY its own file's imports (imports are file-scoped,
// not package-scoped).  `merged` still drives the decl set (it carries the .bni
// prepend + Exported marks the loader applied).
func (c @Checker) CheckPackage(path @[]char, merged @ast.File, files @[]@ast.File, bni @ast.File) {
	checkPackageImpl(c, path, merged, files, bni, true)
}

// CheckPackageDecls registers a package's exported surface WITHOUT
// type-checking function bodies.  Use it for packages loaded only as
// dependencies of the real check/lint targets: a dependent consumes only
// the dep's exported declarations (collected here + registered), so re-
// checking the dep's bodies is redundant — and, worse, leaks the dep's
// body-level errors into every dependent (a dep that uses a language
// feature the running checker doesn't accept would fail every importer's
// check).  Body-check only the targets; decls-only the rest.
func (c @Checker) CheckPackageDecls(path @[]char, merged @ast.File, files @[]@ast.File,
		bni @ast.File) {
	checkPackageImpl(c, path, merged, files, bni, false)
}

// checkPackageImpl is the shared body for CheckPackage (checkBodies=true)
// and CheckPackageDecls (checkBodies=false).  Both run Pass 1 (collect
// declarations) and register the package scope; only the full check runs
// Pass 1.5 (impl satisfaction) and Pass 2 (body checking).
func checkPackageImpl(c @Checker, path @[]char, merged @ast.File, files @[]@ast.File, bni @ast.File,
		checkBodies bool) {
	var savedScope @Scope = c.Scope
	var savedFuncRet @[]@Type = c.FuncRet
	var savedPackageScope @Scope = c.PackageScope
	var savedFileScopeNames @[]@[]char = c.FileScopeNames
	var savedFileScopes @[]@Scope = c.FileScopes
	var prevPkg @[]char = c.curPkgShort
	var prevPath @[]char = c.curPkgPath
	c.curPkgShort = lastPathSegment(path)
	c.curPkgPath = path
	var savedAllowUniverseRecv bool = c.AllowUniverseRecv
	c.AllowUniverseRecv = isCarveOutPackage(path)

	pushScope(c)
	c.PackageScope = c.Scope

	// Import .bni declarations into implementation scope
	var bniScope @Scope = lookupPackage(c, path)
	if bniScope != nil {
		for i := 0; i < len(bniScope.Syms); i++ {
			var sym @Symbol = make(Symbol)
			sym.Name = bniScope.Syms[i].Name
			sym.Type = bniScope.Syms[i].Type
			sym.Kind = bniScope.Syms[i].Kind
			sym.PkgPath = bniScope.Syms[i].PkgPath
			sym.HomePkg = bniScope.Syms[i].HomePkg
			// Carry the exposed-generic marker flag so a `.bn` that references an
			// exposed generic by bare name is rejected the same as in the `.bni`.
			sym.IsGeneric = bniScope.Syms[i].IsGeneric
			c.Scope.Define(sym)
		}
	}

	// Build per-file import scopes (file-scoped imports): instead of dumping
	// every file's imports into the one package scope, each file gets its own
	// import scope (child of the package scope).  collectDecls / checkDecls /
	// resolveConstByName switch c.Scope to a decl's file scope, so a qualifier
	// in file F resolves against only F's imports.  Package symbols still land
	// in c.PackageScope (the file scopes delegate their defines upward).
	buildFileScopes(c, files, bni, c.PackageScope)
	if !fileScopedActive(c) {
		// No per-file provenance (no files passed, or synthetic ASTs with no
		// Pos.File — single-file / REPL / unit-test paths).  Fall back to
		// registering the merged imports package-wide: with effectively one
		// file there is no cross-file collision, so package == file scope.
		registerImports(c, merged)
	}

	// Pass 1: collect declarations
	collectDecls(c, merged.Decls)
	c.Scope = c.PackageScope
	// Reject opaque-by-value embedding now that forward refs are resolved.
	checkValueEmbedding(c, merged.Decls)

	if checkBodies {
		// Report an import alias that collides with a package-level decl name
		// (only for the real target — a decls-only dependency's own clash is
		// reported when that package is compiled directly).
		checkImportDeclCollisions(c, merged)
		// Report an `expose`-surfaced name that collides with another expose or
		// with this package's own declaration (same real-target gating).
		checkExposeCollisions(c, merged, bni)
		// Pass 1.5: validate impl satisfaction (every impl's receiver
		// covers each named interface's method set with sig-compatible
		// methods and reachable receiver kinds).
		checkAllImplsSatisfaction(c)

		// Pass 2: check bodies
		checkDecls(c, merged.Decls)
		c.Scope = c.PackageScope
	}

	// If no .bni, register implementation scope
	if lookupPackage(c, path) == nil {
		registerPackage(c, path, c.PackageScope)
	}

	clearFileScopes(c)
	c.Scope = savedScope
	c.FuncRet = savedFuncRet
	c.PackageScope = savedPackageScope
	c.FileScopeNames = savedFileScopeNames
	c.FileScopes = savedFileScopes
	c.AllowUniverseRecv = savedAllowUniverseRecv
	c.curPkgPath = prevPath
	c.curPkgShort = prevPkg
}

// Check type-checks a source file (single-file mode).
func (c @Checker) Check(file @ast.File) {
	var savedPackageScope @Scope = c.PackageScope
	var prevPkg @[]char = c.curPkgShort
	var prevPath @[]char = c.curPkgPath
	c.curPkgShort = file.PkgName
	c.curPkgPath = stripQuotes(file.PkgName)
	var savedAllowUniverseRecv bool = c.AllowUniverseRecv
	c.AllowUniverseRecv = isCarveOutPackage(file.PkgName)
	pushScope(c)
	c.PackageScope = c.Scope
	registerImports(c, file)
	collectDecls(c, file.Decls)
	checkImportDeclCollisions(c, file)
	checkValueEmbedding(c, file.Decls)
	checkAllImplsSatisfaction(c)
	checkDecls(c, file.Decls)
	popScope(c)
	c.PackageScope = savedPackageScope
	c.AllowUniverseRecv = savedAllowUniverseRecv
	c.curPkgPath = prevPath
	c.curPkgShort = prevPkg
}

// isCarveOutPackage reports whether `name` (the package path
// from `package "..."` or the path argument to CheckPackage)
// is the stdlib carve-out package — the one place methods can
// be declared on universe primitives (`int`, `bool`, etc.).
// `name` may come from file.PkgName (raw, includes the
// surrounding quotes from the source) or from a CheckPackage
// path argument (already-stripped); strip defensively.
func isCarveOutPackage(name *[]readonly char) bool {
	if len(name) == 0 { return false }
	var stripped @[]char = stripQuotes(buf.CopyStr(name))
	return charEq(stripped, "pkg/builtins/lang")
}

// registerImports processes a file's import declarations, defining
// package symbols in the current scope (single-file / REPL path).
func registerImports(c @Checker, file @ast.File) {
	registerImportsInto(c, file.Imports, c.Scope)
}

// ============================================================
// Scope Helpers
// ============================================================

// pushScope enters a new nested scope.
func pushScope(c @Checker) {
	c.Scope = NewScope(c.Scope)
}

// popScope exits the current scope, returning to its parent.
func popScope(c @Checker) {
	c.Scope = c.Scope.Parent
}
