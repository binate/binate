package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/stdx/slices"

// ============================================================
// Error Reporting
// ============================================================

// FormatCheckError renders a CheckError as "file:line:col: message"
// (or "line:col: message" when the position carries no filename).
// Without the location a bare "cannot assign untyped int to int"
// gives no hint where to look — costly in large packages.
func FormatCheckError(e CheckError) @[]char {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(token.PosString(e.Pos))
	cb.Write(": ")
	cb.Write(e.Msg)
	return buf.CopyStr(cb.String())
}

// addCheckError appends a type error with the given position and message to the checker.
//
// Tier 3 forward refs: when c.TentativeMode is set, errors
// route to c.TentativeErrors instead of c.Errors.  After the
// body check, the caller decides whether to migrate them back
// (real errors, no missing-name blame) or discard (parked,
// the cascading errors are noise from the missing names).
func addCheckError(c @Checker, pos token.Pos, msg @[]char) {
	var e CheckError
	e.Pos = pos
	e.Msg = msg
	if c.TentativeMode {
		c.TentativeErrors = slices.Append[CheckError](c.TentativeErrors, e)
		return
	}
	c.Errors = slices.Append[CheckError](c.Errors, e)
}

// addCheckWarning appends a non-blocking diagnostic to the checker.
// Used by Phase 2 of plan-type-decls.md for the duplicate-.bni/.bn
// struct-definition warning during the migration window.  Tentative
// mode suppresses warnings entirely — they're discarded when the
// surrounding tentative body parks/retries, since the warning would
// otherwise duplicate on every retry.
func addCheckWarning(c @Checker, pos token.Pos, msg @[]char) {
	if c.TentativeMode {
		return
	}
	var e CheckError
	e.Pos = pos
	e.Msg = msg
	c.Warnings = slices.Append[CheckError](c.Warnings, e)
}

// errUndefined reports an "undefined: <name>" type error.
//
// Tier 3 forward refs: when c.TentativeMode is set, capture
// the name in c.TentativeMissing instead of reporting via
// c.Errors.  The REPL driver uses TentativeMissing to detect
// that a decl referenced names not yet bound and should be
// parked (rather than rejected outright).
func errUndefined(c @Checker, pos token.Pos, name *[]readonly char) {
	if c.TentativeMode {
		// Capture and swallow.  Dedup the missing-names list
		// so a body referencing the same undefined name twice
		// doesn't park it on the same name twice.
		if !containsName(c.TentativeMissing, name) {
			var copy @[]char = make_slice(char, len(name))
			for i := 0; i < len(name); i++ { copy[i] = name[i] }
			c.TentativeMissing = slices.Append[@[]char](
				c.TentativeMissing, copy)
		}
		return
	}
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("undefined: ")
	cb.Write(name)
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// containsName reports whether `names` already has an entry
// equal to `name` (byte-for-byte).
func containsName(names @[]@[]char, name *[]readonly char) bool {
	for i := 0; i < len(names); i++ {
		if charEq(names[i], name) { return true }
	}
	return false
}

// errNotAType reports a "<name> is not a type" error.
func errNotAType(c @Checker, pos token.Pos, name *[]readonly char) {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write(name)
	cb.Write(" is not a type")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errInterfaceNotAType reports the bare-interface-name-as-type error
// with a pointer at the usable forms. Per plan-interface-syntax-
// revision.md, bare `Iface` is a referenceable name only — value-type
// uses must spell `*Iface` (raw) or `@Iface` (managed).
func errInterfaceNotAType(c @Checker, pos token.Pos,
		name *[]readonly char) {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("interface name `")
	cb.Write(name)
	cb.Write(
		"` is not a type expression; use `*")
	cb.Write(name)
	cb.Write("` or `@")
	cb.Write(name)
	cb.Write("`")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errNonScalarConst reports a const declaration whose type isn't
// scalar.  `const` is for compile-time scalar constants (no storage);
// an addressable, immutable value of a non-scalar type (string, slice,
// struct, pointer, …) is expressed as `var X readonly T = ...` instead.
func errNonScalarConst(c @Checker, pos token.Pos, name *[]readonly char,
		typ @Type) {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("const `")
	cb.Write(name)
	cb.Write("` requires a scalar type, got `")
	cb.Write(typ.TypeName())
	cb.Write("`; use `var ")
	cb.Write(name)
	cb.Write(" readonly ...` for a non-scalar immutable value")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errConstMissingValue reports a const declaration with no value.
// Every const carries a compile-time value (iota-group members inherit
// the previous spec); there is no value-less / extern const.
func errConstMissingValue(c @Checker, pos token.Pos, name *[]readonly char) {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("const `")
	cb.Write(name)
	cb.Write("` must have a value")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errCannotAddrConst reports taking the address of a constant.  A const
// is a compile-time value with no storage, so `&X` is invalid; declare
// a `var` if an address is needed.
func errCannotAddrConst(c @Checker, pos token.Pos, name *[]readonly char) {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("cannot take the address of constant `")
	cb.Write(name)
	cb.Write("`")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errCannotAddrFunc reports `&g` / `&pkg.g` for a named function g — a
// function is not an addressable lvalue (name it directly to get its value).
func errCannotAddrFunc(c @Checker, pos token.Pos, name *[]readonly char) {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("cannot take the address of function `")
	cb.Write(name)
	cb.Write("`")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errCannotAssign reports a "cannot assign <src> to <dst>" type error.
func errCannotAssign(c @Checker, pos token.Pos, src @Type, dst @Type) {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("cannot assign ")
	cb.Write(src.TypeName())
	cb.Write(" to ")
	cb.Write(dst.TypeName())
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errMissingReturn reports a "missing return at end of function <name>" error.
func errMissingReturn(c @Checker, pos token.Pos, name *[]readonly char) {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("missing return at end of function ")
	cb.Write(name)
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errTypeMismatch reports a "mismatched types <a> and <b>" error.
func errTypeMismatch(c @Checker, pos token.Pos, a @Type, b @Type) {
	var cb @buf.Builder = buf.NewBuilder()
	cb.Write("mismatched types ")
	cb.Write(a.TypeName())
	cb.Write(" and ")
	cb.Write(b.TypeName())
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// checkEqOperands reports the diagnostic for an == / != whose operand
// type does not support equality.  Scalars and pointers compare directly
// and produce no error.  Structs and arrays are comparable in principle,
// but the field/element-wise lowering is not implemented yet, so they are
// reported as such.  Slices, interface values, and function values are
// never comparable with == / != — each has a purpose-built alternative.
// `lt` and `rt` are already known mutually-assignable; nil is judged by
// the other operand (so `ptr == nil` is fine, `iface == nil` is not).
// Type parameters (in a generic body) and any unrecognized kind fall
// through with no error — deferred to the concrete instantiation.
func checkEqOperands(c @Checker, pos token.Pos, lt @Type, rt @Type) {
	var t @Type = lt
	if comparabilityKind(lt) == TYP_NIL {
		t = rt
	}
	var k int = comparabilityKind(t)
	if k == TYP_INT || k == TYP_FLOAT || k == TYP_BOOL ||
			k == TYP_UNTYPED_INT || k == TYP_UNTYPED_FLOAT ||
			k == TYP_UNTYPED_BOOL || k == TYP_POINTER ||
			k == TYP_MANAGED_PTR || k == TYP_NIL || k == TYP_VOID {
		return
	}
	if k == TYP_SLICE || k == TYP_MANAGED_SLICE {
		addCheckError(c, pos,
			"slices cannot be compared with == or != "
			"(compare len(s), or compare elements)")
	} else if k == TYP_INTERFACE_VALUE ||
			k == TYP_INTERFACE_VALUE_MANAGED {
		addCheckError(c, pos,
			"interface values cannot be compared with == or != "
			"(use present() to test whether one holds a value)")
	} else if k == TYP_FUNC_VALUE || k == TYP_MANAGED_FUNC_VALUE {
		addCheckError(c, pos,
			"function values cannot be compared with == or !=")
	} else if k == TYP_STRUCT {
		addCheckError(c, pos,
			"comparing struct values with == or != is not yet implemented")
	} else if k == TYP_ARRAY {
		addCheckError(c, pos,
			"comparing array values with == or != is not yet implemented")
	}
}
