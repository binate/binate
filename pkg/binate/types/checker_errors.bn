package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"
import "pkg/stdx/slices"

// ============================================================
// Error Reporting
// ============================================================

// FormatCheckError renders a CheckError as "file:line:col: message"
// (or "line:col: message" when the position carries no filename).
// Without the location a bare "cannot assign untyped int to int"
// gives no hint where to look — costly in large packages.
func FormatCheckError(e CheckError) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(token.PosString(e.Pos))
	cb.Write(": ")
	cb.Write(e.Msg)
	return buf.CopyStr(cb.String())
}

// addCheckError appends a type error with the given position and message to the checker.
//
// Tier 3 forward refs: when c.TentativeMode is set, errors
// route to c.TentativeErrors instead of c.Errors.  After the
// body check, the caller decides whether to migrate them back
// (real errors, no missing-name blame) or discard (parked,
// the cascading errors are noise from the missing names).
func addCheckError(c @Checker, pos token.Pos, msg @[]char) {
	var e CheckError
	e.Pos = pos
	e.Msg = msg
	if c.TentativeMode {
		c.TentativeErrors = slices.Append[CheckError](c.TentativeErrors, e)
		return
	}
	c.Errors = appendUniqueCheckError(c.Errors, e)
}

// appendUniqueCheckError appends e to errs unless an identical diagnostic
// (same position and message) is already present, returning the result.
// Suppressing exact duplicates keeps a diagnostic that is a property of a
// declaration, not a use, from being re-reported once per occurrence:
// e.g. a generic interface's extension-clause error (`interface Bad[T] :
// NotAnIface`) is resolved at each distinct instantiation (Bad[int],
// Bad[bool]), so resolveInterfaceExtension would emit it once per
// instantiation.  One diagnostic per (pos, message) is always the right
// count.  Used by both append-to-c.Errors paths — direct (addCheckError)
// and tentative-error migration — so the dedup is uniform.
func appendUniqueCheckError(errs @[]CheckError, e CheckError) @[]CheckError {
	for i := 0; i < len(errs); i++ {
		if checkErrorsEqual(errs[i], e) {
			return errs
		}
	}
	return slices.Append[CheckError](errs, e)
}

// checkErrorsEqual reports whether two diagnostics are the same — same
// source position and message.
func checkErrorsEqual(a CheckError, b CheckError) bool {
	return a.Pos.Line == b.Pos.Line && a.Pos.Col == b.Pos.Col &&
		charEq(a.Pos.File, b.Pos.File) && charEq(a.Msg, b.Msg)
}

// errUndefined reports an "undefined: <name>" type error.
//
// Tier 3 forward refs: when c.TentativeMode is set, capture
// the name in c.TentativeMissing instead of reporting via
// c.Errors.  The REPL driver uses TentativeMissing to detect
// that a decl referenced names not yet bound and should be
// parked (rather than rejected outright).
func errUndefined(c @Checker, pos token.Pos, name *[]readonly char) {
	if c.TentativeMode {
		// Capture and swallow.  Dedup the missing-names list
		// so a body referencing the same undefined name twice
		// doesn't park it on the same name twice.
		if !containsName(c.TentativeMissing, name) {
			var copy @[]char = make_slice(char, len(name))
			for i := 0; i < len(name); i++ { copy[i] = name[i] }
			c.TentativeMissing = slices.Append[@[]char](
				c.TentativeMissing, copy)
		}
		return
	}
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("undefined: ")
	cb.Write(name)
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errDuplicateImport reports two imports in the same compilation unit that
// resolve to the same short name `name` but different package paths -- e.g.
// `import "pkg/aa/gen"` + `import "pkg/bb/gen"` (both default to `gen`), where a
// qualifier `gen.X` would silently bind to one of them.  The user must alias
// one of the imports.
func errDuplicateImport(c @Checker, pos token.Pos, name @[]char,
		path1 @[]char, path2 @[]char) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("`")
	cb.Write(name)
	cb.Write("` is imported more than once (")
	cb.Write(path1)
	cb.Write(" and ")
	cb.Write(path2)
	cb.Write("); give one of them an explicit alias")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errNoSuchField reports a keyed-struct-literal key that names no field of
// the struct, e.g. `T{a: 1, z: 2}` where T has no field `z`.  More specific
// than errUndefined ("undefined: z"), which resolves the key as a free
// identifier and obscures that the real problem is a missing FIELD.
func errNoSuchField(c @Checker, pos token.Pos, st @Type,
		key *[]readonly char) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("no field `")
	cb.Write(key)
	cb.Write("` in ")
	if st != nil && len(st.Name) > 0 {
		cb.Write(st.Name)
	} else {
		cb.Write("struct literal")
	}
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// containsName reports whether `names` already has an entry
// equal to `name` (byte-for-byte).
func containsName(names @[]@[]char, name *[]readonly char) bool {
	for i := 0; i < len(names); i++ {
		if charEq(names[i], name) { return true }
	}
	return false
}

// errNotAType reports a "<name> is not a type" error.
func errNotAType(c @Checker, pos token.Pos, name *[]readonly char) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(name)
	cb.Write(" is not a type")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errInterfaceNotAType reports the bare-interface-name-as-type error
// with a pointer at the usable forms. Per plan-interface-syntax-
// revision.md, bare `Iface` is a referenceable name only — value-type
// uses must spell `*Iface` (raw) or `@Iface` (managed).
func errInterfaceNotAType(c @Checker, pos token.Pos,
		name *[]readonly char) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("interface name `")
	cb.Write(name)
	cb.Write(
		"` is not a type expression; use `*")
	cb.Write(name)
	cb.Write("` or `@")
	cb.Write(name)
	cb.Write("`")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errNonScalarConst reports a const declaration whose type isn't
// scalar.  `const` is for compile-time scalar constants (no storage);
// an addressable, immutable value of a non-scalar type (string, slice,
// struct, pointer, …) is expressed as `var X readonly T = ...` instead.
func errNonScalarConst(c @Checker, pos token.Pos, name *[]readonly char,
		typ @Type) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("const `")
	cb.Write(name)
	cb.Write("` requires a scalar type, got `")
	cb.Write(typ.TypeName())
	cb.Write("`; use `var ")
	cb.Write(name)
	cb.Write(" readonly ...` for a non-scalar immutable value")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errConstMissingValue reports a const declaration with no value.
// Every const carries a compile-time value (iota-group members inherit
// the previous spec); there is no value-less / extern const.
func errConstMissingValue(c @Checker, pos token.Pos, name *[]readonly char) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("const `")
	cb.Write(name)
	cb.Write("` must have a value")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errCannotAddrConst reports taking the address of a constant.  A const
// is a compile-time value with no storage, so `&X` is invalid; declare
// a `var` if an address is needed.
func errCannotAddrConst(c @Checker, pos token.Pos, name *[]readonly char) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("cannot take the address of constant `")
	cb.Write(name)
	cb.Write("`")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errCannotAddrFunc reports `&g` / `&pkg.g` for a named function g — a
// function is not an addressable lvalue (name it directly to get its value).
func errCannotAddrFunc(c @Checker, pos token.Pos, name *[]readonly char) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("cannot take the address of function `")
	cb.Write(name)
	cb.Write("`")
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errCannotAssign reports a "cannot assign <src> to <dst>" type error.
// When the two types' short display names collide (distinct cross-package
// types with the same leaf, e.g. `red.T` vs `blue.T` — both display "T"), the
// qualified identity is used instead so the message is not the baffling
// "cannot assign T to T".
func errCannotAssign(c @Checker, pos token.Pos, src @Type, dst @Type) {
	var sName @[]char = src.TypeName()
	var dName @[]char = dst.TypeName()
	if charEq(sName, dName) {
		sName = disambiguatingTypeName(src)
		dName = disambiguatingTypeName(dst)
	}
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("cannot assign ")
	cb.Write(sName)
	cb.Write(" to ")
	cb.Write(dName)
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// disambiguatingTypeName renders a type like TypeName but with any NAMED leaf
// (at whatever pointer/slice/readonly wrapper depth) shown by its package-
// qualified identity (namedIdentityName — e.g. "pkg/red.T").  Used only when
// two error operands share a short display name, so a cross-package same-leaf
// mismatch reads "cannot assign @pkg/red.T to @pkg/blue.T" rather than the
// baffling "@T to @T".  Wrapper prefixes mirror typeNameImpl; anything that is
// neither a named type nor a peelable wrapper falls back to the plain display.
func disambiguatingTypeName(t @Type) @[]char {
	if t == nil {
		return "nil"
	}
	if t.Kind == TYP_NAMED {
		return namedIdentityName(t)
	}
	var prefix @[]char
	if t.Kind == TYP_POINTER {
		prefix = "*"
	} else if t.Kind == TYP_MANAGED_PTR {
		prefix = "@"
	} else if t.Kind == TYP_SLICE {
		prefix = "*[]"
	} else if t.Kind == TYP_MANAGED_SLICE {
		prefix = "@[]"
	} else if t.Kind == TYP_READONLY {
		prefix = "readonly "
	} else {
		return t.TypeName()
	}
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write(prefix)
	cb.Write(disambiguatingTypeName(t.Elem))
	return buf.CopyStr(cb.String())
}

// errMissingReturn reports a "missing return at end of function <name>" error.
func errMissingReturn(c @Checker, pos token.Pos, name *[]readonly char) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("missing return at end of function ")
	cb.Write(name)
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// errTypeMismatch reports a "mismatched types <a> and <b>" error.
func errTypeMismatch(c @Checker, pos token.Pos, a @Type, b @Type) {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("mismatched types ")
	cb.Write(a.TypeName())
	cb.Write(" and ")
	cb.Write(b.TypeName())
	addCheckError(c, pos, buf.CopyStr(cb.String()))
}

// checkEqOperands reports the diagnostic for an == / != whose operand
// type does not support equality.  Scalars and pointers compare directly
// and produce no error.  A struct or array is comparable iff every
// transitive field / element is comparable (aggregateComparable) — such a
// value lowers to a field/element-wise compare (gen_eq_aggregate.bn); one
// that transitively contains a slice, interface value, or function value
// is rejected.  Slices, interface values, and function values are
// themselves never comparable with == / != — each has a purpose-built
// alternative.  `lt` and `rt` are already known mutually-assignable; nil
// is judged by the other operand (so `ptr == nil` is fine, `iface == nil`
// is not).  Type parameters (in a generic body) and any unrecognized kind
// fall through with no error; the concrete type argument is re-checked at
// instantiation (recordTypeParamComparison / instantiateGenericFunc).
func checkEqOperands(c @Checker, pos token.Pos, lt @Type, rt @Type) {
	var t @Type = lt
	if comparabilityKind(lt) == TYP_NIL {
		t = rt
	}
	var k int = comparabilityKind(t)
	if k == TYP_INT || k == TYP_FLOAT || k == TYP_BOOL ||
			k == TYP_UNTYPED_INT || k == TYP_UNTYPED_FLOAT ||
			k == TYP_UNTYPED_BOOL || k == TYP_POINTER ||
			k == TYP_MANAGED_PTR || k == TYP_NIL || k == TYP_VOID {
		return
	}
	if k == TYP_SLICE || k == TYP_MANAGED_SLICE {
		addCheckError(c, pos,
			"slices cannot be compared with == or != "
			"(compare len(s), or compare elements)")
	} else if k == TYP_INTERFACE_VALUE ||
			k == TYP_INTERFACE_VALUE_MANAGED {
		addCheckError(c, pos,
			"interface values cannot be compared with == or != "
			"(use present() to test whether one holds a value)")
	} else if k == TYP_FUNC_VALUE || k == TYP_MANAGED_FUNC_VALUE {
		addCheckError(c, pos,
			"function values cannot be compared with == or !=")
	} else if k == TYP_STRUCT {
		if !aggregateComparable(t) {
			addCheckError(c, pos,
				"this struct is not comparable with == or != "
				"(it has a slice, interface, or function field)")
		}
	} else if k == TYP_ARRAY {
		if !aggregateComparable(t) {
			addCheckError(c, pos,
				"this array is not comparable with == or != "
				"(its element type has a slice, interface, or function)")
		}
	}
}
