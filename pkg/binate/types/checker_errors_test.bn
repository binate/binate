package "pkg/binate/types"

import "pkg/binate/token"
import "pkg/builtins/testing"

// Tests for the error-reporting helpers in checker_errors.bn.
// Most error reporting is exercised end-to-end through negative
// type-check tests (errCannotAssign etc. fire from real source);
// this file pins the direct API for the helpers that route errors
// to c.Errors vs. c.TentativeErrors and dedup TentativeMissing.

func TestAddCheckErrorRoutesToErrors() testing.TestResult {
	var c @Checker = NewChecker()
	var pos token.Pos
	addCheckError(c, pos, "boom")
	if len(c.Errors) != 1 { return "expected 1 error in c.Errors" }
	if !streq(c.Errors[0].Msg, "boom") { return "wrong message" }
	if len(c.TentativeErrors) != 0 {
		return "TentativeErrors should be empty"
	}
	return ""
}

func TestAddCheckErrorRoutesToTentativeUnderTentativeMode() testing.TestResult {
	var c @Checker = NewChecker()
	c.TentativeMode = true
	var pos token.Pos
	addCheckError(c, pos, "boom")
	if len(c.Errors) != 0 {
		return "Errors should be empty in tentative mode"
	}
	if len(c.TentativeErrors) != 1 {
		return "expected 1 TentativeError"
	}
	return ""
}

// addCheckError suppresses an exact duplicate (same pos + message) while
// keeping diagnostics that differ in position or message.  A decl-level
// diagnostic re-reported per use — e.g. a generic interface's broken
// extension clause, resolved at each distinct instantiation — collapses
// to one.
func TestAddCheckErrorDedupesIdentical() testing.TestResult {
	var c @Checker = NewChecker()
	var pos token.Pos
	pos.File = "f.bn"
	pos.Line = 3
	pos.Col = 5
	addCheckError(c, pos, "boom")
	addCheckError(c, pos, "boom")
	if len(c.Errors) != 1 {
		return "exact-duplicate error must be suppressed"
	}
	addCheckError(c, pos, "different")
	if len(c.Errors) != 2 {
		return "a different message at the same pos must be kept"
	}
	var pos2 token.Pos
	pos2.File = "f.bn"
	pos2.Line = 9
	pos2.Col = 1
	addCheckError(c, pos2, "boom")
	if len(c.Errors) != 3 {
		return "the same message at a different pos must be kept"
	}
	return ""
}

// migrateTentativeErrors moves tentative errors into c.Errors and must
// dedup against what's already there — otherwise a tentative error
// identical to a direct one (or one captured across a forward-ref body
// retry) would reintroduce a duplicate, bypassing addCheckError's dedup.
func TestMigrateTentativeErrorsDedups() testing.TestResult {
	var c @Checker = NewChecker()
	var pos token.Pos
	pos.File = "f.bn"
	pos.Line = 1
	pos.Col = 1
	addCheckError(c, pos, "boom")
	c.TentativeMode = true
	addCheckError(c, pos, "boom")
	c.TentativeMode = false
	if len(c.Errors) != 1 { return "direct error not recorded" }
	if len(c.TentativeErrors) != 1 { return "tentative error not staged" }
	migrateTentativeErrors(c)
	if len(c.Errors) != 1 {
		return "migrated identical error must be suppressed"
	}
	if len(c.TentativeErrors) != 0 {
		return "tentative errors must be cleared after migration"
	}
	return ""
}

func TestFormatCheckErrorWithFile() testing.TestResult {
	var e CheckError
	e.Pos.File = "foo.bn"
	e.Pos.Line = 12
	e.Pos.Col = 3
	e.Msg = "cannot assign untyped int to int"
	if !streq(FormatCheckError(e), "foo.bn:12:3: cannot assign untyped int to int") {
		return "wrong formatted error with file"
	}
	return ""
}

// With no filename, PosString omits it, so the rendering is
// "line:col: message".
func TestFormatCheckErrorNoFile() testing.TestResult {
	var e CheckError
	e.Pos.Line = 5
	e.Pos.Col = 9
	e.Msg = "boom"
	if !streq(FormatCheckError(e), "5:9: boom") {
		return "wrong formatted error without file"
	}
	return ""
}

func TestErrUndefinedDedupsTentativeMissing() testing.TestResult {
	var c @Checker = NewChecker()
	c.TentativeMode = true
	var pos token.Pos
	errUndefined(c, pos, "x")
	errUndefined(c, pos, "x")
	errUndefined(c, pos, "y")
	if len(c.TentativeMissing) != 2 {
		return "expected 2 distinct missing names (x, y)"
	}
	return ""
}
