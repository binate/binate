package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

func TestNewChecker() testing.TestResult {
	var c @Checker = NewChecker()
	if c == nil { return fail("NewChecker returned nil") }
	if c.Scope == nil { return fail("expected universe scope") }
	return ""
}

func TestCheckerErrorsEmpty() testing.TestResult {
	var c @Checker = NewChecker()
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) != 0 { return fail("new checker should have no errors") }
	return ""
}

func TestUniverseScope() testing.TestResult {
	var s @Scope = universeScope()
	if s == nil { return fail("universe scope is nil") }
	// Should contain built-in types: int, bool, char, etc.
	var intSym @Symbol = s.Lookup("int")
	if intSym == nil { return fail("int not in universe scope") }
	var boolSym @Symbol = s.Lookup("bool")
	if boolSym == nil { return fail("bool not in universe scope") }
	return ""
}

func TestDefineAndLookup() testing.TestResult {
	var s @Scope = NewScope(nil)
	defineVar(s, "x", TypInt())
	var sym @Symbol = s.Lookup("x")
	if sym == nil { return fail("x not found after define") }
	if sym.Type == nil { return fail("x type is nil") }
	if sym.Type.Kind != TYP_INT { return fail("x should be int") }
	return ""
}

func TestScopeNesting() testing.TestResult {
	var outer @Scope = NewScope(nil)
	defineVar(outer, "a", TypInt())
	var inner @Scope = NewScope(outer)
	defineVar(inner, "b", TypBool())
	// Inner should see both a and b
	if inner.Lookup("a") == nil { return fail("a not visible in inner") }
	if inner.Lookup("b") == nil { return fail("b not visible in inner") }
	// Outer should only see a
	if outer.Lookup("a") == nil { return fail("a not in outer") }
	if outer.Lookup("b") != nil { return fail("b should not be in outer") }
	return ""
}

// TestCheckPackageDeclsSkipsBodies pins the decls-only contract:
// CheckPackageDecls must NOT report function-body type errors (it is
// for packages loaded only as dependencies), whereas the full
// CheckPackage on the same source must.  This is what stops a
// dependency's body errors from leaking into every importer's check.
func TestCheckPackageDeclsSkipsBodies() testing.TestResult {
	// `undef` is undefined — a body-level type error.
	var src *[]readonly char = "package \"test\"\nfunc F() int { return undef }\n"
	var b @[]uint8 = toBytes(src)

	var p1 @parser.Parser = parser.New(b, "test.bn")
	var f1 @ast.File = p1.ParseFile()
	var c1 @Checker = NewChecker()
	c1.CheckPackageDecls("test", f1, make_slice(@ast.File, 0), nil)
	if len(c1.CheckerErrors()) != 0 {
		return fail("CheckPackageDecls must not report body errors")
	}

	var p2 @parser.Parser = parser.New(b, "test.bn")
	var f2 @ast.File = p2.ParseFile()
	var c2 @Checker = NewChecker()
	c2.CheckPackage("test", f2, make_slice(@ast.File, 0), nil)
	if len(c2.CheckerErrors()) == 0 {
		return fail("CheckPackage must report the body error")
	}
	return ""
}

// TestCheckPackageDeclsRegistersScope verifies CheckPackageDecls still
// registers the package's exported surface by path — a dependent
// consumes those declarations even though the bodies are unchecked.
func TestCheckPackageDeclsRegistersScope() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc Exported() int { return undef }\n"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "test.bn")
	var f @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.CheckPackageDecls("test", f, make_slice(@ast.File, 0), nil)
	var pkgScope @Scope = lookupPackage(c, "test")
	if pkgScope == nil {
		return fail("CheckPackageDecls must register the package scope")
	}
	if pkgScope.Lookup("Exported") == nil {
		return fail("exported decl not registered by CheckPackageDecls")
	}
	return ""
}

// TestCheckPackageDeclsDependentResolves is the composition the bnlint
// fix relies on: a dependency registered decls-only (a) exposes enough
// surface for a dependent to resolve its exported function, and (b) does
// NOT surface its own body error when the dependent is the one being
// checked.  This is exactly the leak the fix prevents — vm's bad body no
// longer fails repl/bni just because they import vm.
func TestCheckPackageDeclsDependentResolves() testing.TestResult {
	// Dependency: valid exported signature, but a body type error (undef).
	var depSrc *[]readonly char = "package \"dep\"\nfunc Helper() int { return undef }\n"
	var dp @parser.Parser = parser.New(toBytes(depSrc), "dep.bn")
	var depFile @ast.File = dp.ParseFile()
	var c @Checker = NewChecker()
	c.CheckPackageDecls("dep", depFile, make_slice(@ast.File, 0), nil)
	if len(c.CheckerErrors()) != 0 {
		return fail("decls-only dependency must not surface body errors")
	}

	// Dependent (a "target"): fully checked, calls the dep's exported
	// function.  It must resolve against the decls-only registration and
	// pick up NO error — neither an unresolved import nor the dep's
	// leaked body error.
	var userSrc *[]readonly char = "package \"user\"\nimport \"dep\"\n"
			"func Use() int { return dep.Helper() }\n"
	var up @parser.Parser = parser.New(toBytes(userSrc), "user.bn")
	var userFile @ast.File = up.ParseFile()
	c.CheckPackage("user", userFile, make_slice(@ast.File, 0), nil)
	if len(c.CheckerErrors()) != 0 {
		return fail(
				"dependent must resolve a decls-only dependency "
						"without surfacing its body errors")
	}
	return ""
}

// A package whose .bni declares BOTH a free function and a same-named method
// (the os.Stat + File.Stat pattern), with a .bn defining both, must check
// clean.  Before buildScopeFromFile skipped methods, the method clobbered the
// free func in package scope, and the .bn free func then failed signature
// matching: "Stat: .bn has 1 parameters but .bni declares 0".  This is the
// end-to-end guard for that diagnostic (the bni_scope tests pin the scope
// layer; this drives CheckPackage → checkBniSignatureMatch).
func TestCheckPackageFreeFuncAndMethodNoBniMismatch() testing.TestResult {
	var c @Checker = NewChecker()
	c.LoadPackageInterface("foo",
			mkBniFile(
					"package \"foo\"\ntype Pt struct { x int }\nfunc Stat(a int) int\nfunc (p *Pt) Stat() int\n"))

	// .bn defines both; Pt comes from the .bni scope (as os.bn uses File).
	var src *[]readonly char = "package \"foo\"\n"
			"func Stat(a int) int { return a }\n"
			"func (p *Pt) Stat() int { return p.x }\n"
	var p @parser.Parser = parser.New(toBytes(src), "foo.bn")
	var f @ast.File = p.ParseFile()
	c.CheckPackage("foo", f, make_slice(@ast.File, 0), nil)

	if len(c.CheckerErrors()) != 0 {
		return fail("free func + same-named method must check clean (no .bni signature mismatch)")
	}
	return ""
}
