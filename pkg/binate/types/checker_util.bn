package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"

// ============================================================
// Helpers
// ============================================================

// commonType returns the common type of a and b, reporting a mismatch
// error if they differ. An untyped constant takes on the concrete
// peer's type; two untyped operands of the same class yield an untyped
// result.
func commonType(c @Checker, pos token.Pos, a @Type, b @Type) @Type {
	if a != nil && a.Kind == TYP_UNTYPED_INT {
		return b
	}
	if b != nil && b.Kind == TYP_UNTYPED_INT {
		return a
	}
	if a != nil && a.Kind == TYP_UNTYPED_FLOAT {
		return b
	}
	if b != nil && b.Kind == TYP_UNTYPED_FLOAT {
		return a
	}
	if !a.Identical(b) {
		errTypeMismatch(c, pos, a, b)
	}
	return a
}

// defaultType returns the default concrete type for an untyped type
// (int for untyped int, float64 for untyped float, etc.).
func defaultType(t @Type) @Type {
	if t == nil {
		return TypVoid()
	}
	if t.Kind == TYP_UNTYPED_INT {
		return TypInt()
	}
	if t.Kind == TYP_UNTYPED_FLOAT {
		return TypFloat64()
	}
	if t.Kind == TYP_UNTYPED_BOOL {
		return TypBool()
	}
	// A bare top-level function reference has type TYP_FUNC, which is not a
	// storable value; in an inference context (`var f = add`) it decays to a
	// managed func value @func — the same managed-by-default choice as a func
	// literal (checkFuncLit) and @[]T.  An @func referencing a captureless
	// top-level function carries a nil data word, so this is ~free; it borrows
	// to *func at a destination that wants raw.
	if t.Kind == TYP_FUNC {
		return MakeManagedFuncValueType(t.Params, t.Results)
	}
	return t
}

// defaultTypeForExpr is defaultType, plus the string-literal default:
// EXPR_STRING_LIT decays from its [N]readonly char natural type to the
// default @[]readonly char in inference contexts (var x = "...", x := "...").
// Other [N]readonly char values keep their type.
func defaultTypeForExpr(t @Type, e @ast.Expr) @Type {
	if e != nil && e.Kind == ast.EXPR_STRING_LIT {
		return defaultStringLitType()
	}
	return defaultType(t)
}

// compoundToBase converts a compound assignment operator (+=, -=, etc.) to its base operator.
func compoundToBase(op int) int {
	if op == cast(int, token.ADD_ASSIGN) { return cast(int, token.PLUS) }
	if op == cast(int, token.SUB_ASSIGN) { return cast(int, token.MINUS) }
	if op == cast(int, token.MUL_ASSIGN) { return cast(int, token.STAR) }
	if op == cast(int, token.QUO_ASSIGN) { return cast(int, token.SLASH) }
	if op == cast(int, token.REM_ASSIGN) { return cast(int, token.PERCENT) }
	if op == cast(int, token.AND_ASSIGN) { return cast(int, token.AMP) }
	if op == cast(int, token.OR_ASSIGN) { return cast(int, token.PIPE) }
	if op == cast(int, token.XOR_ASSIGN) { return cast(int, token.CARET) }
	if op == cast(int, token.SHL_ASSIGN) { return cast(int, token.SHL) }
	if op == cast(int, token.SHR_ASSIGN) { return cast(int, token.SHR) }
	return op
}

// litIntValue extracts the integer value carried by an untyped-int
// literal type (HasLitVal), reconstructing the sign from LitMag/LitSign.
// ok=false when t carries no literal value.
func litIntValue(t @Type) (int, bool) {
	if t == nil || !t.HasLitVal {
		return 0, false
	}
	var v int = cast(int, t.LitMag)
	if t.LitSign {
		v = -v
	}
	return v, true
}

// evalConstIntValue evaluates a constant integer expression to
// (value, ok) WITHOUT reporting errors.  Handles int and char literals,
// const idents — in-package (`N`) and package-qualified (`pkg.N`) — that
// fold to a known integer (SYM_CONST with HasConstVal), the unary/binary
// arithmetic + bitwise operators, and integer cast / bit_cast (the operand
// value passed through unchanged) — so an array dimension may be a plain
// const (`[N]int`) or a constant expression over consts (`[N+1]int`,
// `[2*M]int`), and a cast-wrapped const count (`cast(int8, 0) -
// cast(int8, 3)`) folds to its underlying value so the negative-shift-count
// gate (checkShiftCountNonNegative) sees it.
//
// These forms mirror IR-gen's evalConstExpr (gen_const_fold.bn) so the
// checker's view of a const stays consistent with the value codegen emits.
// In particular the cast / bit_cast handling matches it EXACTLY — same value
// passthrough, NO truncation to the target type.  Diverging (e.g. truncating
// here) would desync the two: a `const N int8 = bit_cast(int8, cast(uint8,
// 253))` would read as -3 here but the source 253 in IR-gen, so `[N]int` and
// `x << N` would disagree.  The shared passthrough is imprecise for a
// sign-reinterpreting bit_cast (`bit_cast(int8, cast(uint8, 253))` folds to
// 253, not -3), but the imprecision is shared with IR-gen, so the two stay
// consistent (see claude-todo.md gap (c)).  evalConstExpr additionally folds
// iota / sizeof / alignof, which this does NOT — they are always
// non-negative, so they pose no negative-shift risk; folding them here for
// array-dimension parity is a separate, tracked improvement.  ok=false for
// any non-constant or unsupported form; the public evalConstInt turns that
// into the one diagnostic.
func evalConstIntValue(c @Checker, e @ast.Expr) (int, bool) {
	if e == nil {
		return 0, false
	}
	if e.Kind == ast.EXPR_INT_LIT {
		return parseIntLiteral(e.Name), true
	}
	if e.Kind == ast.EXPR_CHAR_LIT {
		return parseCharLiteral(e.Name), true
	}
	if e.Kind == ast.EXPR_IDENT {
		var sym @Symbol = c.Scope.Lookup(e.Name)
		if sym != nil && sym.Kind == SYM_CONST && sym.HasConstVal {
			return sym.ConstVal, true
		}
		return 0, false
	}
	if e.Kind == ast.EXPR_SELECTOR {
		// A package-qualified const (`pkg.N`).  Resolve the member symbol and
		// read its folded value, mirroring IR-gen's evalConstExpr EXPR_SELECTOR
		// arm — so a negative imported const used as a shift count (`x << pkg.N`)
		// is rejected, and a positive one used as an array dim (`[pkg.SZ]int`)
		// folds (the checker previously could fold only in-package idents here).
		var sym @Symbol = resolveQualifiedSym(c, e)
		if sym != nil && sym.Kind == SYM_CONST && sym.HasConstVal {
			return sym.ConstVal, true
		}
		return 0, false
	}
	if e.Kind == ast.EXPR_UNARY {
		var x int
		var ok bool
		x, ok = evalConstIntValue(c, e.X)
		if !ok {
			return 0, false
		}
		if e.Op == cast(int, token.MINUS) {
			return -x, true
		}
		if e.Op == cast(int, token.PLUS) {
			return x, true
		}
		if e.Op == cast(int, token.TILDE) {
			return -x - 1, true
		}
		return 0, false
	}
	if e.Kind == ast.EXPR_BINARY {
		var lhs int
		var lok bool
		lhs, lok = evalConstIntValue(c, e.X)
		if !lok {
			return 0, false
		}
		var rhs int
		var rok bool
		rhs, rok = evalConstIntValue(c, e.Y)
		if !rok {
			return 0, false
		}
		if e.Op == cast(int, token.PLUS) {
			return lhs + rhs, true
		}
		if e.Op == cast(int, token.MINUS) {
			return lhs - rhs, true
		}
		if e.Op == cast(int, token.STAR) {
			return lhs * rhs, true
		}
		if e.Op == cast(int, token.SLASH) {
			if rhs == 0 {
				return 0, false
			}
			return lhs / rhs, true
		}
		if e.Op == cast(int, token.PERCENT) {
			if rhs == 0 {
				return 0, false
			}
			return lhs - (lhs / rhs) * rhs, true
		}
		if e.Op == cast(int, token.AMP) {
			return lhs & rhs, true
		}
		if e.Op == cast(int, token.PIPE) {
			return lhs | rhs, true
		}
		if e.Op == cast(int, token.CARET) {
			return lhs ^ rhs, true
		}
		if e.Op == cast(int, token.SHL) {
			return lhs << rhs, true
		}
		if e.Op == cast(int, token.SHR) {
			return lhs >> rhs, true
		}
		return 0, false
	}
	if e.Kind == ast.EXPR_BUILTIN {
		// Integer cast / bit_cast over a constant operand: pass the operand
		// value through unchanged, mirroring IR-gen's evalConstExpr.  This is
		// what lets a negative const count hidden behind a cast (`cast(int8,
		// 0) - cast(int8, 3)` == -3) fold to its real value so
		// checkShiftCountNonNegative rejects it — otherwise the count reaches
		// IR-gen's emitConstOvershiftOrNil, whose unsigned magnitude compare
		// silently treats -3 as a huge overshift and yields 0.  A non-integer
		// cast operand (`cast(int, 1.5)`) doesn't fold, so ok=false flows out.
		if e.Op == cast(int, token.CAST) ||
				e.Op == cast(int, token.BIT_CAST) {
			if len(e.Args) == 0 {
				return 0, false
			}
			return evalConstIntValue(c, e.Args[0])
		}
		return 0, false
	}
	return 0, false
}

// isConstShaped reports whether e is built only from integer/char literals
// and named-const references (through the unary / binary operators) —
// i.e. it is the SHAPE of a constant integer expression, regardless of
// whether every referenced const's value is known yet.  Used to defer
// (rather than reject) an array dimension during pass 1, when a const
// declared later in the file is registered before its value is folded.
func isConstShaped(c @Checker, e @ast.Expr) bool {
	if e == nil {
		return false
	}
	if e.Kind == ast.EXPR_INT_LIT || e.Kind == ast.EXPR_CHAR_LIT {
		return true
	}
	if e.Kind == ast.EXPR_IDENT {
		var sym @Symbol = c.Scope.Lookup(e.Name)
		return sym != nil && sym.Kind == SYM_CONST
	}
	if e.Kind == ast.EXPR_UNARY {
		return isConstShaped(c, e.X)
	}
	if e.Kind == ast.EXPR_BINARY {
		return isConstShaped(c, e.X) && isConstShaped(c, e.Y)
	}
	return false
}

// dimFullyKnown reports whether every const referenced by const-shaped
// array-dimension expression `e` already has a folded value — i.e. the
// dimension's value is fully determined now, not pending a later pass.
// Used to tell a genuine constant-arithmetic fault (division by zero, the
// only fold failure left once all operands are known) apart from a
// legitimately-deferred dimension whose const isn't resolved yet.
func dimFullyKnown(c @Checker, e @ast.Expr) bool {
	if e == nil {
		return false
	}
	if e.Kind == ast.EXPR_INT_LIT || e.Kind == ast.EXPR_CHAR_LIT {
		return true
	}
	if e.Kind == ast.EXPR_IDENT {
		var sym @Symbol = c.Scope.Lookup(e.Name)
		return sym != nil && sym.Kind == SYM_CONST && sym.HasConstVal
	}
	if e.Kind == ast.EXPR_UNARY {
		return dimFullyKnown(c, e.X)
	}
	if e.Kind == ast.EXPR_BINARY {
		return dimFullyKnown(c, e.X) && dimFullyKnown(c, e.Y)
	}
	return false
}

// evalConstInt evaluates a constant integer expression (for array
// lengths), reporting a diagnostic when it is not a valid constant length.
func evalConstInt(c @Checker, e @ast.Expr) int {
	if e == nil {
		return 0
	}
	var v int
	var ok bool
	v, ok = evalConstIntValue(c, e)
	if ok {
		// A negative length has no valid layout (codegen would emit an
		// `alloca [-N x T]`, which the backend rejects).
		if v < 0 {
			addCheckError(c, e.Pos,
				"array length must be non-negative")
			return 0
		}
		return v
	}
	// Not foldable here.  If the dimension is constant-shaped but a
	// referenced const's value isn't known yet, defer quietly: this is
	// pass 1 resolving the array type before the const's value is recorded
	// (re-resolved once it is).  But if every operand IS known and it still
	// didn't fold, the expression itself is invalid — a division / modulo
	// by zero — so report it rather than silently yielding a [0]T array.
	if isConstShaped(c, e) {
		if dimFullyKnown(c, e) {
			addCheckError(c, e.Pos,
				"array length: division by zero in constant expression")
			return 0
		}
		return 0
	}
	addCheckError(c, e.Pos, "array length must be a constant integer")
	return 0
}

// parseIntLiteral parses an integer literal string (decimal, hex, octal, or binary).
func parseIntLiteral(s *[]readonly char) int {
	if len(s) > 2 {
		if s[0] == '0' && (s[1] == 'x' || s[1] == 'X') {
			return parseHexInt(s, 2)
		}
		if s[0] == '0' && (s[1] == 'o' || s[1] == 'O') {
			return parseOctalInt(s, 2)
		}
		if s[0] == '0' && (s[1] == 'b' || s[1] == 'B') {
			return parseBinaryInt(s, 2)
		}
	}
	return parseDecimalInt(s, 0)
}

// parseCharLiteral returns the integer (byte) value of a char literal's raw
// quoted text (`'A'`, `'\n'`, `'\x41'`, `'A'`).  It mirrors IR-gen's
// parseCharLit so the checker folds a char-literal const exactly as code
// generation does — used by evalConstIntValue so a char-literal const
// expression (e.g. the shift count `cast(int, 'A') - cast(int, 'Z')`) folds
// to its real value rather than being unfoldable and slipping past the
// negative-shift-count gate.  Escapes are validated separately by
// checkCharLitEscapes; a malformed literal is decoded defensively.
func parseCharLiteral(s *[]readonly char) int {
	if len(s) >= 2 && s[0] == '\'' && s[len(s)-1] == '\'' {
		s = s[1:len(s)-1]
	}
	if len(s) == 0 {
		return 0
	}
	if s[0] == '\\' && len(s) > 1 {
		if s[1] == 'n' { return 10 }
		if s[1] == 'r' { return 13 }
		if s[1] == 't' { return 9 }
		if s[1] == '\\' { return 92 }
		if s[1] == '\'' { return 39 }
		if s[1] == '"' { return 34 }
		if s[1] == '0' { return 0 }
		if s[1] == 'x' && len(s) >= 4 {
			return hexDigitVal(s[2]) * 16 + hexDigitVal(s[3])
		}
		if s[1] == 'u' && len(s) >= 6 {
			// A char-literal `\u` is constrained to a single byte
			// (code point <= U+007F), so the code point IS the byte value.
			return hexDigitVal(s[2]) * 4096 + hexDigitVal(s[3]) * 256 +
				hexDigitVal(s[4]) * 16 + hexDigitVal(s[5])
		}
		// Unrecognized escape: rejected upstream by checkCharLitEscapes;
		// keep the char and drop the backslash defensively.
		return cast(int, s[1])
	}
	return cast(int, s[0])
}

// parseDecimalInt parses a decimal integer from the string starting at the given index.
func parseDecimalInt(s *[]readonly char, start int) int {
	var v int = 0
	for i := start; i < len(s); i++ {
		v = v*10 + cast(int, s[i]) - cast(int, '0')
	}
	return v
}

// parseHexInt parses a hexadecimal integer from the string starting at the given index.
func parseHexInt(s *[]readonly char, start int) int {
	var v int = 0
	for i := start; i < len(s); i++ {
		var d int = 0
		if s[i] >= '0' && s[i] <= '9' {
			d = cast(int, s[i]) - cast(int, '0')
		} else if s[i] >= 'a' && s[i] <= 'f' {
			d = cast(int, s[i]) - cast(int, 'a') + 10
		} else if s[i] >= 'A' && s[i] <= 'F' {
			d = cast(int, s[i]) - cast(int, 'A') + 10
		}
		v = v*16 + d
	}
	return v
}

// parseOctalInt parses an octal integer from the string starting at the given index.
func parseOctalInt(s *[]readonly char, start int) int {
	var v int = 0
	for i := start; i < len(s); i++ {
		v = v*8 + cast(int, s[i]) - cast(int, '0')
	}
	return v
}

// parseBinaryInt parses a binary integer from the string starting at the given index.
func parseBinaryInt(s *[]readonly char, start int) int {
	var v int = 0
	for i := start; i < len(s); i++ {
		v = v*2 + cast(int, s[i]) - cast(int, '0')
	}
	return v
}

// stripQuotes removes surrounding double quotes from a string literal.
func stripQuotes(s @[]char) @[]char {
	if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
		return s[1:len(s)-1]
	}
	return s
}

// lastPathSegment returns the portion of the path after the last '/'
// (used for default import names).
func lastPathSegment(path @[]char) @[]char {
	var last int = 0
	for i := 0; i < len(path); i++ {
		if path[i] == '/' {
			last = i + 1
		}
	}
	return path[last:]
}
