package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/std/strings"

// Escape-sequence handling shared by the string/char literal checks and
// (via Utf8Bytes) the IR-level decoders in pkg/binate/ir.  The recognized
// set is exactly grammar.ebnf's escape_seq:
//   \n \r \t \\ \' \" \0   \xHH   \uHHHH
// A `\uHHHH` escape denotes the Unicode code point U+HHHH and expands, at
// compile time, to its UTF-8 encoding (1-3 bytes).  This is pure source
// sugar: Binate strings remain byte sequences and there is no runtime
// UTF-8/Unicode machinery (no `rune`, no Unicode-aware `string` type).

// isHexDigit reports whether c is an ASCII hex digit.
func isHexDigit(c char) bool {
	return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') ||
		(c >= 'A' && c <= 'F')
}

// hexDigitVal returns the numeric value (0..15) of an ASCII hex digit.
// The caller must have verified isHexDigit; a non-digit yields 0.
func hexDigitVal(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	if c >= 'A' && c <= 'F' { return cast(int, c) - cast(int, 'A') + 10 }
	return 0
}

// Utf8Bytes returns the UTF-8 encoding of code point cp as up to three
// bytes (b0,b1,b2) plus the byte count n (1..3).  cp must be a valid
// scalar value in the BMP (0..0xFFFF, non-surrogate) — the only source is
// a four-hex-digit `\u` escape, so larger code points cannot arise.  The
// length thresholds here are mirrored by Utf8ByteLen and by
// string_lit.bn:unescapedStrLen; escape_test.bn locks them together.
func Utf8Bytes(cp int) (char, char, char, int) {
	if cp < 0x80 {
		return cast(char, cp), cast(char, 0), cast(char, 0), 1
	}
	if cp < 0x800 {
		return cast(char, 0xC0 | (cp >> 6)),
			cast(char, 0x80 | (cp & 0x3F)),
			cast(char, 0), 2
	}
	return cast(char, 0xE0 | (cp >> 12)),
		cast(char, 0x80 | ((cp >> 6) & 0x3F)),
		cast(char, 0x80 | (cp & 0x3F)), 3
}

// Utf8ByteLen returns the number of UTF-8 bytes for code point cp (1..3).
// Mirrors Utf8Bytes's thresholds (locked by escape_test.bn).
func Utf8ByteLen(cp int) int {
	if cp < 0x80 { return 1 }
	if cp < 0x800 { return 2 }
	return 3
}

// uEscapeCodePoint decodes the four hex digits of a `\u` escape whose `u`
// sits at body[i] (digits at body[i+1..i+4]).  The caller must have
// verified the four digits exist and are hex.
func uEscapeCodePoint(body *[]readonly char, i int) int {
	return hexDigitVal(body[i+1]) * 4096 +
		hexDigitVal(body[i+2]) * 256 +
		hexDigitVal(body[i+3]) * 16 +
		hexDigitVal(body[i+4])
}

// validateEscapes walks the unquoted body of a string/char literal and
// reports the first malformed escape via addCheckError.  When inChar is
// true the single-byte constraint applies: a `\u` escape must encode to
// exactly one byte (code point <= U+007F), since a `char` is one byte.
// Any backslash not starting a recognized escape (e.g. `\a`) is rejected.
func validateEscapes(c @Checker, body *[]readonly char, pos token.Pos,
		inChar bool) {
	var i int = 0
	for i < len(body) {
		if body[i] != '\\' {
			i = i + 1
			continue
		}
		if i+1 >= len(body) {
			addCheckError(c, pos, "incomplete escape sequence at end of literal")
			return
		}
		var e char = body[i+1]
		if e == 'n' || e == 'r' || e == 't' || e == '\\' ||
				e == '\'' || e == '"' || e == '0' {
			i = i + 2
			continue
		}
		if e == 'x' {
			if i+3 >= len(body) || !isHexDigit(body[i+2]) ||
					!isHexDigit(body[i+3]) {
				addCheckError(c, pos, "\\x escape requires two hex digits")
				return
			}
			i = i + 4
			continue
		}
		if e == 'u' {
			if i+5 >= len(body) || !isHexDigit(body[i+2]) ||
					!isHexDigit(body[i+3]) || !isHexDigit(body[i+4]) ||
					!isHexDigit(body[i+5]) {
				addCheckError(c, pos, "\\u escape requires four hex digits")
				return
			}
			var cp int = uEscapeCodePoint(body, i+1)
			if cp >= 0xD800 && cp <= 0xDFFF {
				addCheckError(c, pos,
					"\\u escape is a UTF-16 surrogate, not a valid code point")
				return
			}
			if inChar && cp > 0x7F {
				addCheckError(c, pos,
					"\\u escape in a char literal must be a single byte (code point <= U+007F)")
				return
			}
			i = i + 6
			continue
		}
		// Any other character after a backslash is not a recognized
		// escape (grammar.ebnf escape_seq); reject it rather than silently
		// dropping the backslash.
		addCheckError(c, pos, unknownEscapeMsg(e))
		return
	}
}

// unknownEscapeMsg builds the diagnostic for an unrecognized escape,
// naming the offending character (e.g. "unknown escape sequence '\a'").
func unknownEscapeMsg(e char) @[]char {
	var mb @strings.Builder = strings.NewBuilder()
	mb.Write("unknown escape sequence '\\")
	mb.WriteByte(e)
	mb.Write("'")
	return buf.CopyStr(mb.String())
}

// checkStrLitEscapes validates the escapes in a string literal's raw
// (quoted) text, reporting errors at pos.
func checkStrLitEscapes(c @Checker, text *[]readonly char, pos token.Pos) {
	var s *[]readonly char = text
	if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
		s = s[1:len(s)-1]
	}
	validateEscapes(c, s, pos, false)
}

// checkCharLitEscapes validates the escapes in a char literal's raw
// (quoted) text, reporting errors at pos.
func checkCharLitEscapes(c @Checker, text *[]readonly char, pos token.Pos) {
	var s *[]readonly char = text
	if len(s) >= 2 && s[0] == '\'' && s[len(s)-1] == '\'' {
		s = s[1:len(s)-1]
	}
	validateEscapes(c, s, pos, true)
}
