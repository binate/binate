package "pkg/binate/types"

import "pkg/builtins/testing"

// ============================================================
// Utf8Bytes / Utf8ByteLen encoder
// ============================================================

func TestUtf8BytesAscii() testing.TestResult {
	var b0 char
	var b1 char
	var b2 char
	var n int
	b0, b1, b2, n = Utf8Bytes(0x41)
	if n != 1 { return fail("U+0041 should be one byte") }
	if cast(int, b0) != 0x41 { return fail("expected 0x41") }
	return ""
}

func TestUtf8BytesTwoByte() testing.TestResult {
	var b0 char
	var b1 char
	var b2 char
	var n int
	b0, b1, b2, n = Utf8Bytes(0xE9)
	if n != 2 { return fail("U+00E9 should be two bytes") }
	if cast(int, b0) != 0xC3 { return fail("expected 0xC3") }
	if cast(int, b1) != 0xA9 { return fail("expected 0xA9") }
	return ""
}

func TestUtf8BytesThreeByte() testing.TestResult {
	var b0 char
	var b1 char
	var b2 char
	var n int
	b0, b1, b2, n = Utf8Bytes(0x20AC)
	if n != 3 { return fail("U+20AC should be three bytes") }
	if cast(int, b0) != 0xE2 { return fail("expected 0xE2") }
	if cast(int, b1) != 0x82 { return fail("expected 0x82") }
	if cast(int, b2) != 0xAC { return fail("expected 0xAC") }
	return ""
}

// checkByteLen asserts Utf8ByteLen and the byte count Utf8Bytes returns
// agree for cp — they are two copies of the same thresholds.
func checkByteLen(cp int, want int) testing.TestResult {
	if Utf8ByteLen(cp) != want { return fail("Utf8ByteLen mismatch") }
	var b0 char
	var b1 char
	var b2 char
	var n int
	b0, b1, b2, n = Utf8Bytes(cp)
	if n != want { return fail("Utf8Bytes count mismatch") }
	return ""
}

// Cover both sides of each 1/2/3-byte boundary.
func TestUtf8ByteLenConsistent() testing.TestResult {
	var r testing.TestResult
	r = checkByteLen(0x7F, 1); if len(r) > 0 { return r }
	r = checkByteLen(0x80, 2); if len(r) > 0 { return r }
	r = checkByteLen(0x7FF, 2); if len(r) > 0 { return r }
	r = checkByteLen(0x800, 3); if len(r) > 0 { return r }
	r = checkByteLen(0xFFFF, 3); if len(r) > 0 { return r }
	return ""
}

// ============================================================
// Escape validation through the checker
// ============================================================

// A well-formed multi-byte `\u` in a string literal is accepted.
func TestCheckUEscapeStringValid() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar s @[]readonly char = \"\\u20ac\"\n")
	return expectNoErrors(c)
}

// An ASCII `\u` in a char literal (one byte) is accepted.
func TestCheckUEscapeCharAscii() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar ch char = '\\u0041'\n")
	return expectNoErrors(c)
}

// Fewer than four hex digits is rejected.
func TestCheckUEscapeIncompleteRejected() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar s @[]readonly char = \"\\u12\"\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("\\u with two digits must error")
	}
	return ""
}

// A surrogate code point (U+D800..U+DFFF) is not a valid scalar value.
func TestCheckUEscapeSurrogateRejected() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar s @[]readonly char = \"\\ud800\"\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("\\u surrogate must error")
	}
	return ""
}

// A `\u` whose code point needs more than one byte cannot fit a char.
func TestCheckUEscapeCharOverflowRejected() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar ch char = '\\u00e9'\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("multi-byte \\u in a char literal must error")
	}
	return ""
}

// A raw multi-byte char literal (`'é'`, UTF-8 0xC3 0xA9) is rejected — a
// `char` is one byte, so it cannot hold a two-byte UTF-8 character (it must
// not silently decode to the first byte).
func TestCheckCharLitMultiByteRejected() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar ch char = 'é'\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("a raw multi-byte char literal must error")
	}
	return ""
}

// A multi-character char literal (`'AB'`) is rejected — exactly one char unit
// is allowed.
func TestCheckCharLitMultiCharRejected() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar ch char = 'AB'\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("a multi-character char literal must error")
	}
	return ""
}

// An escape followed by trailing content (`'\nx'`) is rejected — the escape
// must consume the whole literal.
func TestCheckCharLitEscapeTrailingRejected() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar ch char = '\\nx'\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("an escape with trailing content must error")
	}
	return ""
}

// Positive control: valid single-unit char literals (a raw ASCII byte and a
// `\x` escape) are NOT over-rejected by the single-character rule.
func TestCheckCharLitSingleUnitOK() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar a char = 'A'\nvar b char = '\\x41'\n")
	if len(c.CheckerErrors()) != 0 {
		return fail("valid single-unit char literals must not error")
	}
	return ""
}

// An incomplete `\x` (one hex digit) is rejected.
func TestCheckXEscapeIncompleteRejected() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar s @[]readonly char = \"\\x1\"\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("\\x with one digit must error")
	}
	return ""
}

// Any backslash not starting a recognized escape (e.g. \a) is rejected.
func TestCheckUnknownEscapeRejected() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar s @[]readonly char = \"\\a\"\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("unknown escape must error")
	}
	return ""
}
