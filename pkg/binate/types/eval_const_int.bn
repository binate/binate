package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/token"

// Constant integer evaluation, primarily for array dimensions and the
// const-fold contexts (cast operands, shift counts) that must agree with
// IR-gen's evalConstExpr.  evalConstIntValue does the (value, ok) fold
// without diagnostics; evalConstInt wraps it for array lengths and reports
// the one diagnostic.  The dim* / validateDim* helpers classify and
// validate dimension expressions; the parse* helpers read integer and
// char literals.

// evalConstIntValue evaluates a constant integer expression to
// (value, ok) WITHOUT reporting errors.  Handles int and char literals,
// const idents — in-package (`N`) and package-qualified (`pkg.N`) — that
// fold to a known integer (SYM_CONST with HasConstVal), the unary/binary
// arithmetic + bitwise operators, and integer cast / bit_cast — so an array
// dimension may be a plain const (`[N]int`) or a constant expression over
// consts (`[N+1]int`, `[2*M]int`), and a cast-wrapped const count
// (`cast(int8, 0) - cast(int8, 3)`) folds to its underlying value so the
// negative-shift-count gate (checkShiftCountNonNegative) sees it.
//
// These forms mirror IR-gen's evalConstExpr (gen_const_fold.bn) so the
// checker's view of a const stays consistent with the value codegen emits.
// A `cast` passes its (in-range; out-of-range narrowing is rejected) operand
// through; a `bit_cast` reinterprets it to the target width via the shared
// ReinterpretBitCast — both EXACTLY as evalConstExpr folds them, so a bit_cast
// const reads the same here as at codegen (`bit_cast(int8, 253)` == -3 in
// both) and `[N]int` / `x << N` cannot disagree.  sizeof / alignof fold to the
// target-parameterized size / alignment, also as evalConstExpr does.  The one
// form evalConstExpr folds that this does NOT is `iota`, meaningful only inside
// a const group (checkGroupDecl handles it) and non-negative.  ok=false for any
// non-constant or unsupported form; the public evalConstInt turns that into the
// one diagnostic.
func evalConstIntValue(c @Checker, e @ast.Expr) (int, bool) {
	if e == nil {
		return 0, false
	}
	if e.Kind == ast.EXPR_INT_LIT {
		return parseIntLiteral(e.Name), true
	}
	if e.Kind == ast.EXPR_CHAR_LIT {
		return ParseCharLit(e.Name), true
	}
	if e.Kind == ast.EXPR_IDENT {
		var sym @Symbol = c.Scope.Lookup(e.Name)
		if sym != nil && sym.Kind == SYM_CONST && sym.HasConstVal {
			return sym.ConstVal, true
		}
		return 0, false
	}
	if e.Kind == ast.EXPR_SELECTOR {
		// A package-qualified const (`pkg.N`).  Resolve the member symbol and
		// read its folded value, mirroring IR-gen's evalConstExpr EXPR_SELECTOR
		// arm — so a negative imported const used as a shift count (`x << pkg.N`)
		// is rejected, and a positive one used as an array dim (`[pkg.SZ]int`)
		// folds (the checker previously could fold only in-package idents here).
		var sym @Symbol = resolveQualifiedSym(c, e)
		if sym != nil && sym.Kind == SYM_CONST && sym.HasConstVal {
			return sym.ConstVal, true
		}
		return 0, false
	}
	if e.Kind == ast.EXPR_UNARY {
		var x int
		var ok bool
		x, ok = evalConstIntValue(c, e.X)
		if !ok {
			return 0, false
		}
		if e.Op == cast(int, token.MINUS) {
			return -x, true
		}
		if e.Op == cast(int, token.PLUS) {
			return x, true
		}
		if e.Op == cast(int, token.TILDE) {
			return -x - 1, true
		}
		return 0, false
	}
	if e.Kind == ast.EXPR_BINARY {
		var lhs int
		var lok bool
		lhs, lok = evalConstIntValue(c, e.X)
		if !lok {
			return 0, false
		}
		var rhs int
		var rok bool
		rhs, rok = evalConstIntValue(c, e.Y)
		if !rok {
			return 0, false
		}
		if e.Op == cast(int, token.PLUS) {
			return lhs + rhs, true
		}
		if e.Op == cast(int, token.MINUS) {
			return lhs - rhs, true
		}
		if e.Op == cast(int, token.STAR) {
			return lhs * rhs, true
		}
		if e.Op == cast(int, token.SLASH) {
			if rhs == 0 {
				return 0, false
			}
			return lhs / rhs, true
		}
		if e.Op == cast(int, token.PERCENT) {
			if rhs == 0 {
				return 0, false
			}
			return lhs - (lhs / rhs) * rhs, true
		}
		if e.Op == cast(int, token.AMP) {
			return lhs & rhs, true
		}
		if e.Op == cast(int, token.PIPE) {
			return lhs | rhs, true
		}
		if e.Op == cast(int, token.CARET) {
			return lhs ^ rhs, true
		}
		if e.Op == cast(int, token.SHL) {
			return lhs << rhs, true
		}
		if e.Op == cast(int, token.SHR) {
			return lhs >> rhs, true
		}
		return 0, false
	}
	if e.Kind == ast.EXPR_BUILTIN {
		// sizeof / alignof fold to the (target-parameterized) byte size /
		// alignment, mirroring IR-gen's evalConstExpr — so a `[sizeof(T)]int`
		// array dim folds, and a NEGATED const count `0 - cast(int, sizeof(T))`
		// is seen by checkShiftCountNonNegative and rejected rather than
		// reaching IR-gen and overshifting to 0.
		if e.Op == cast(int, token.SIZEOF) {
			var t @Type = resolveTypeExpr(c, e.TypeRef)
			if t == nil {
				return 0, false
			}
			// An opaque type has no layout.  Emit the clean diagnostic and
			// stop folding rather than calling t.SizeOf() (which has no
			// meaningful value here).  Matches the builtin-call gate; the
			// (pos,msg) dedup collapses a double report.
			if embedsOpaqueByValue(t) {
				addCheckError(c, e.Pos,
					"cannot take sizeof/alignof of an opaque type"
					" (its layout is not available here)")
				return 0, false
			}
			return t.SizeOf(), true
		}
		if e.Op == cast(int, token.ALIGNOF) {
			var t @Type = resolveTypeExpr(c, e.TypeRef)
			if t == nil {
				return 0, false
			}
			if embedsOpaqueByValue(t) {
				addCheckError(c, e.Pos,
					"cannot take sizeof/alignof of an opaque type"
					" (its layout is not available here)")
				return 0, false
			}
			return t.AlignOf(), true
		}
		// A constant `cast` over an integer: pass the operand value through
		// unchanged — letting a negative const count hidden behind a cast
		// (`cast(int8, 0) - cast(int8, 3)` == -3) fold to its real value so
		// checkShiftCountNonNegative rejects it.  A non-integer cast operand
		// (`cast(int, 1.5)`) doesn't fold, so ok=false flows out.  Passthrough
		// (not truncation) is correct because an out-of-range constant cast is
		// rejected by checkCastConstFits in value AND array-dimension position
		// (validateDimCasts); a deliberate truncation/reinterpret uses masking
		// or bit_cast.  (foldConstNum judges const arithmetic and non-negative
		// &/|/^/<< exactly in bignum; a right shift, or a bitwise op with a
		// NEGATIVE operand — both width/sign-dependent — still route here.)
		if e.Op == cast(int, token.CAST) {
			if len(e.Args) == 0 {
				return 0, false
			}
			return evalConstIntValue(c, e.Args[0])
		}
		// A constant `bit_cast` reinterprets the operand's bits as the target
		// type — truncate + sign-extend to the target width.  ReinterpretBitCast
		// is shared with IR-gen's evalConstExpr, so the folded value AGREES
		// exactly (`bit_cast(int8, 253)` == -3 in both), letting the gate reject
		// a bit_cast that reinterprets a positive source into a negative count
		// rather than letting it slip to IR-gen's overshift -> 0.
		if e.Op == cast(int, token.BIT_CAST) {
			if len(e.Args) == 0 {
				return 0, false
			}
			var v int
			var ok bool
			v, ok = evalConstIntValue(c, e.Args[0])
			if !ok {
				return 0, false
			}
			return ReinterpretBitCast(v, resolveTypeExpr(c, e.TypeRef)), true
		}
		return 0, false
	}
	return 0, false
}

// isConstShaped reports whether e is built only from integer/char literals
// and named-const references (through the unary / binary operators) —
// i.e. it is the SHAPE of a constant integer expression, regardless of
// whether every referenced const's value is known yet.  Used to defer
// (rather than reject) an array dimension during pass 1, when a const
// declared later in the file is registered before its value is folded.
func isConstShaped(c @Checker, e @ast.Expr) bool {
	if e == nil {
		return false
	}
	if e.Kind == ast.EXPR_INT_LIT || e.Kind == ast.EXPR_CHAR_LIT {
		return true
	}
	if e.Kind == ast.EXPR_IDENT {
		var sym @Symbol = c.Scope.Lookup(e.Name)
		return sym != nil && sym.Kind == SYM_CONST
	}
	if e.Kind == ast.EXPR_UNARY {
		return isConstShaped(c, e.X)
	}
	if e.Kind == ast.EXPR_BINARY {
		return isConstShaped(c, e.X) && isConstShaped(c, e.Y)
	}
	if e.Kind == ast.EXPR_BUILTIN {
		// The const-folding EXPR_BUILTIN forms evalConstIntValue handles:
		// sizeof / alignof depend only on a (resolvable) type, so they are
		// always const-shaped; cast / bit_cast are const-shaped iff their
		// operand is.  Without this a dim mixing one of these with a const
		// declared later (`[sizeof(T) + N]int`) is mis-classified as
		// non-constant rather than deferred until N resolves.
		if e.Op == cast(int, token.SIZEOF) ||
				e.Op == cast(int, token.ALIGNOF) {
			return true
		}
		if e.Op == cast(int, token.CAST) ||
				e.Op == cast(int, token.BIT_CAST) {
			return len(e.Args) == 1 && isConstShaped(c, e.Args[0])
		}
		return false
	}
	return false
}

// dimFullyKnown reports whether every const referenced by const-shaped
// array-dimension expression `e` already has a folded value — i.e. the
// dimension's value is fully determined now, not pending a later pass.
// Used to tell a genuine constant-arithmetic fault (division by zero, the
// only fold failure left once all operands are known) apart from a
// legitimately-deferred dimension whose const isn't resolved yet.
func dimFullyKnown(c @Checker, e @ast.Expr) bool {
	if e == nil {
		return false
	}
	if e.Kind == ast.EXPR_INT_LIT || e.Kind == ast.EXPR_CHAR_LIT {
		return true
	}
	if e.Kind == ast.EXPR_IDENT {
		var sym @Symbol = c.Scope.Lookup(e.Name)
		return sym != nil && sym.Kind == SYM_CONST && sym.HasConstVal
	}
	if e.Kind == ast.EXPR_UNARY {
		return dimFullyKnown(c, e.X)
	}
	if e.Kind == ast.EXPR_BINARY {
		return dimFullyKnown(c, e.X) && dimFullyKnown(c, e.Y)
	}
	if e.Kind == ast.EXPR_BUILTIN {
		// sizeof / alignof resolve from the type alone (no forward-const
		// dependency), so they are always known; cast / bit_cast are known iff
		// their operand is.  Mirrors isConstShaped so a `[sizeof(T) + N]int`
		// dim defers (rather than reporting a spurious fault) until N folds.
		if e.Op == cast(int, token.SIZEOF) ||
				e.Op == cast(int, token.ALIGNOF) {
			// An opaque type has no knowable size/alignment; its sizeof is
			// separately diagnosed (evalConstIntValue), and it never folds.
			// Classify it as NOT known so evalConstInt takes the quiet path
			// rather than reporting a spurious "division by zero" fault.
			var t @Type = resolveTypeExpr(c, e.TypeRef)
			if t != nil && embedsOpaqueByValue(t) {
				return false
			}
			return true
		}
		if e.Op == cast(int, token.CAST) ||
				e.Op == cast(int, token.BIT_CAST) {
			return len(e.Args) == 1 && dimFullyKnown(c, e.Args[0])
		}
		return false
	}
	return false
}

// validateDimCharLitEscapes reports malformed escapes in any char literal
// appearing in array-dimension expression `e`.  An array dimension is folded
// via evalConstInt -> evalConstIntValue -> ParseCharLit, a path that never
// runs checkExpr — so without this a malformed escape in a dim-position char
// literal (`['\q']int`) would fold silently instead of being diagnosed the way
// it is in value position (checkExpr's EXPR_CHAR_LIT arm).  Errors dedupe, so
// re-resolving the same array type across passes reports each escape once.
func validateDimCharLitEscapes(c @Checker, e @ast.Expr) {
	if e == nil {
		return
	}
	if e.Kind == ast.EXPR_CHAR_LIT {
		checkCharLitEscapes(c, e.Name, e.Pos)
		return
	}
	if e.Kind == ast.EXPR_UNARY {
		validateDimCharLitEscapes(c, e.X)
		return
	}
	if e.Kind == ast.EXPR_BINARY {
		validateDimCharLitEscapes(c, e.X)
		validateDimCharLitEscapes(c, e.Y)
		return
	}
	if e.Kind == ast.EXPR_BUILTIN || e.Kind == ast.EXPR_CALL {
		for i := 0; i < len(e.Args); i++ {
			validateDimCharLitEscapes(c, e.Args[i])
		}
	}
}

// validateDimCasts runs the cast out-of-range fit-check on every `cast` node in
// array-dimension expression `e`.  Array dims fold via evalConstInt without
// checkExpr/checkBuiltinCall, so without this a constant out-of-range cast in a
// dimension (`[cast(int8, 200)]int`) would silently fold to a wrong length
// instead of being rejected the way it is in value position.  Errors dedupe, so
// re-resolving the array type across passes reports once.  bit_cast is NOT
// walked (it is the reinterpret escape).
func validateDimCasts(c @Checker, e @ast.Expr) {
	if e == nil {
		return
	}
	if e.Kind == ast.EXPR_BUILTIN && e.Op == cast(int, token.CAST) &&
			len(e.Args) == 1 {
		var typ @Type = resolveTypeExpr(c, e.TypeRef)
		// For a DIRECT-literal operand, check the literal so checkCastConstFits
		// gets its exact bignum (HasLitVal) — matching value position.  Without
		// this an array-dim literal cast >= 2^63 would route through the lossy
		// host-int fold and report the wrong diagnostic ("array length must be
		// non-negative") or, if it wrapped to a small positive, escape the
		// fit-check entirely.  Only literals are checked here (pure, no
		// resolution-order risk); other operands stay on the argType=nil path.
		var argType @Type = nil
		if e.Args[0].Kind == ast.EXPR_INT_LIT ||
				e.Args[0].Kind == ast.EXPR_CHAR_LIT {
			argType = checkExpr(c, e.Args[0])
		}
		checkCastConstFits(c, e.Args[0].Pos, typ, argType, e.Args[0])
	}
	if e.Kind == ast.EXPR_UNARY {
		validateDimCasts(c, e.X)
		return
	}
	if e.Kind == ast.EXPR_BINARY {
		validateDimCasts(c, e.X)
		validateDimCasts(c, e.Y)
		return
	}
	if e.Kind == ast.EXPR_BUILTIN || e.Kind == ast.EXPR_CALL {
		for i := 0; i < len(e.Args); i++ {
			validateDimCasts(c, e.Args[i])
		}
	}
}

// evalConstInt evaluates a constant integer expression (for array
// lengths), reporting a diagnostic when it is not a valid constant length.
func evalConstInt(c @Checker, e @ast.Expr) int {
	if e == nil {
		return 0
	}
	validateDimCharLitEscapes(c, e)
	validateDimCasts(c, e)
	var v int
	var ok bool
	v, ok = evalConstIntValue(c, e)
	if ok {
		// A negative length has no valid layout (codegen would emit an
		// `alloca [-N x T]`, which the backend rejects).
		if v < 0 {
			addCheckError(c, e.Pos,
				"array length must be non-negative")
			return 0
		}
		return v
	}
	// Not foldable here.  If the dimension is constant-shaped but a
	// referenced const's value isn't known yet, defer quietly: this is
	// pass 1 resolving the array type before the const's value is recorded
	// (re-resolved once it is).  But if every operand IS known and it still
	// didn't fold, the expression itself is invalid — a division / modulo
	// by zero — so report it rather than silently yielding a [0]T array.
	if isConstShaped(c, e) {
		if dimFullyKnown(c, e) {
			addCheckError(c, e.Pos,
				"array length: division by zero in constant expression")
			return 0
		}
		return 0
	}
	addCheckError(c, e.Pos, "array length must be a constant integer")
	return 0
}
