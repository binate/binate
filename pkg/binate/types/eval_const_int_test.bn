package "pkg/binate/types"

import "pkg/builtins/testing"

// evalConstInt / evalConstIntValue fold array dimensions (and the const
// contexts — shift counts, cast fits — that must agree with IR-gen).  These
// exercise the evaluator end-to-end through array-dimension positions.

// A constant-arithmetic dimension folds without error.
func TestEvalConstIntArithDimFolds() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\ntype S struct { a [2*3 + 1]int }\n")
	return expectNoErrors(c)
}

// A division-by-zero in a fully-known constant dimension is reported (not
// silently yielded as a [0]T array).
func TestEvalConstIntDivByZeroRejected() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\ntype S struct { a [1/0]int }\n")
	return expectErrSub(c, "division by zero")
}

// A non-constant dimension (a runtime parameter) is rejected as non-constant.
func TestEvalConstIntNonConstDimRejected() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nfunc f(n int) { var a [n]int; _ = a }\n")
	return expectErrSub(c, "must be a constant integer")
}

// An opaque sizeof used as a dimension reports the opaque diagnostic and does
// NOT additionally report a spurious "division by zero": dimFullyKnown treats
// an opaque sizeof as not-known, so evalConstInt takes its quiet path instead
// of mistaking the (separately diagnosed) non-fold for an arithmetic fault.
func TestEvalConstIntOpaqueSizeofDimRejected() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\ntype Opaque\n"
		"func f() { var a [sizeof(Opaque)]int; _ = a }\n")
	var r testing.TestResult = expectErrSub(c,
		"cannot take sizeof/alignof of an opaque type")
	if len(r) != 0 { return r }
	var errs @[]CheckError = c.CheckerErrors()
	for i := 0; i < len(errs); i++ {
		if charsHaveSub(errs[i].Msg, "division by zero") {
			return fail(
				"opaque sizeof dim must not report a spurious division-by-zero")
		}
	}
	return ""
}
