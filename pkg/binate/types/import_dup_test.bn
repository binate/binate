package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for the duplicate-same-short-name import check (registerImportsInto):
// two imports that resolve to the same short name but DIFFERENT paths collide
// (a qualifier `gen.X` would silently bind to one of them by import order), so
// one must be aliased.  mkBniFile / toBytes / anyErrContains live in sibling
// *_test.bn files (same package).

// checkMainImporting2 loads two package interfaces, then type-checks a main
// source that may import them.
func checkMainImporting2(aPath @[]char, aBni *[]readonly char,
		bPath @[]char, bBni *[]readonly char,
		mainSrc *[]readonly char) @Checker {
	var c @Checker = NewChecker()
	c.LoadPackageInterface(aPath, mkBniFile(aBni))
	c.LoadPackageInterface(bPath, mkBniFile(bBni))
	var p @parser.Parser = parser.New(toBytes(mainSrc), "test.bn")
	var file @ast.File = p.ParseFile()
	c.Check(file)
	return c
}

// Two same-final-segment packages imported BOTH unaliased (both default to
// `gen`) is a collision and is rejected.
func TestDuplicateSameSegmentImportRejected() testing.TestResult {
	var c @Checker = checkMainImporting2(
		"pkg/aa/gen", "package \"pkg/aa/gen\"\nconst A int = 1\n",
		"pkg/bb/gen", "package \"pkg/bb/gen\"\nconst B int = 2\n",
		"package \"main\"\n"
		"import \"pkg/aa/gen\"\n"
		"import \"pkg/bb/gen\"\n"
		"func main() { }\n")
	if !anyErrContains(c, "imported more than once") {
		return fail("two same-segment unaliased imports (both `gen`) should be rejected")
	}
	return ""
}

// Aliasing one of the colliding imports resolves the clash -- distinct names,
// no error.
func TestDuplicateImportAliasedAccepted() testing.TestResult {
	var c @Checker = checkMainImporting2(
		"pkg/aa/gen", "package \"pkg/aa/gen\"\nconst A int = 1\n",
		"pkg/bb/gen", "package \"pkg/bb/gen\"\nconst B int = 2\n",
		"package \"main\"\n"
		"import \"pkg/aa/gen\"\n"
		"import gen2 \"pkg/bb/gen\"\n"
		"func main() { }\n")
	return expectNoErrors(c)
}

// Importing the SAME package twice (same path) is a redundant re-import, not a
// collision -- it must NOT error.
func TestSamePathImportTwiceNoError() testing.TestResult {
	var c @Checker = checkMainImporting2(
		"pkg/aa/gen", "package \"pkg/aa/gen\"\nconst A int = 1\n",
		"pkg/bb/other", "package \"pkg/bb/other\"\nconst B int = 2\n",
		"package \"main\"\n"
		"import \"pkg/aa/gen\"\n"
		"import \"pkg/aa/gen\"\n"
		"func main() { }\n")
	return expectNoErrors(c)
}

// Two blank imports (`import _ "..."`) of different paths are side-effect-only
// and legitimately repeatable -- not a collision.
func TestBlankImportsNotCollision() testing.TestResult {
	var c @Checker = checkMainImporting2(
		"pkg/aa/gen", "package \"pkg/aa/gen\"\nconst A int = 1\n",
		"pkg/bb/gen", "package \"pkg/bb/gen\"\nconst B int = 2\n",
		"package \"main\"\n"
		"import _ \"pkg/aa/gen\"\n"
		"import _ \"pkg/bb/gen\"\n"
		"func main() { }\n")
	return expectNoErrors(c)
}

// Two imports given the SAME explicit alias but different paths collide on that
// alias -- rejected, like the unaliased same-segment case.
func TestSameAliasDifferentPathsRejected() testing.TestResult {
	var c @Checker = checkMainImporting2(
		"pkg/aa/thing", "package \"pkg/aa/thing\"\nconst A int = 1\n",
		"pkg/bb/other", "package \"pkg/bb/other\"\nconst B int = 2\n",
		"package \"main\"\n"
		"import g \"pkg/aa/thing\"\n"
		"import g \"pkg/bb/other\"\n"
		"func main() { }\n")
	if !anyErrContains(c, "imported more than once") {
		return fail("two imports with the same alias `g` should be rejected")
	}
	return ""
}
