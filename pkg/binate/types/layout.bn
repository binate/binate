package "pkg/binate/types"

// ============================================================
// Type Layout
// ============================================================

// target holds the current target platform description.  If SetTarget is
// never called, initTarget defaults it to the host's sizes.
var target TargetInfo

// initTarget sets default target properties (the host's) if not yet configured.
func initTarget() {
	if target.PointerSize == 0 {
		// Defaults reflect the HOST these sizes are measured on — at
		// runtime `sizeof(int)` / `sizeof(*uint8)` evaluate to whatever
		// the running process's target was compiled for, so an arm32
		// build defaults to ILP32 and an amd64 build to LP64.  Cross-
		// compilation drivers (cmd/bnc with --target) still call
		// SetTarget explicitly before any types op and override these;
		// these defaults only matter when no one has called SetTarget,
		// which is the "use the types library on the host" case (e.g.
		// pkg/binate/vm in-process tests; the predeclared `int`
		// singleton's Width is fixed from this default on first use —
		// see types.bn's ensureInit comment).
		target.PointerSize = cast(int, sizeof(*uint8))
		target.IntSize = cast(int, sizeof(int))
		// MaxAlign is the max fundamental alignment (int64 / uint64 / float64 =
		// 8), NOT the pointer size — the two only coincide on LP64.  AAPCS (the
		// ILP32 arm32 EABI) 8-aligns the 8-byte fundamentals even though pointers
		// and int are 4, and AlignOf's TYP_NIL arm already assumes ma == 8 on
		// ILP32.  Deriving it from sizeof(*uint8) undersizes alignof(int64) /
		// alignof(float64) to 4 on an ILP32 host (e.g. bni cross-built to arm32,
		// which never calls SetTarget), corrupting every 8-byte-member struct's
		// layout.  cmd/bnc's setArm32Layout sets this same 8 for the same reason.
		target.MaxAlign = 8
		// target.BigEndian stays false: every Binate host is little-endian,
		// and the implementation is little-endian only (see SetTarget).
	}
}

// SetTarget configures the target platform properties for layout computation.
//
// The word-sized `int` / `uint` singletons carry their width on the type (so
// type identity and IR-gen can read it), and that width is set once at
// ensureInit from the then-current target.  Without re-setting it here, a
// SetTarget that runs AFTER first init — a driver that touched types before
// resolving --target, or a cross-compile target picked while a host-width int
// was already locked — would leave `int` reporting the wrong size (e.g. 8 on a
// 32-bit target), even though sizeof(int) folds correctly.  Pointer / slice
// sizes already track the live target via ptrSize()/maxAlign(); int/uint are
// the only widths carried on a locked singleton, so re-set just those.
func SetTarget(info TargetInfo) {
	// Byte order is implementation-defined (§7.13.12) and this implementation
	// is little-endian ONLY — every byte-emission site (the object writers'
	// WriteU16/32/64, the irdata.DataGlobal int terms, bit_cast / the
	// representation builtins) assumes it.  Reject a big-endian target loudly
	// at the single chokepoint every target flows through, rather than
	// silently emitting wrong-endian bytes.
	if info.BigEndian {
		panic("big-endian target not implemented (§7.13.12: little-endian only)")
	}
	target = info
	if typesInitialized {
		predeclaredInt.Width = info.IntSize * 8
		predeclaredUint.Width = info.IntSize * 8
	}
}

// GetTarget returns the current target platform properties, initializing defaults if needed.
func GetTarget() TargetInfo {
	initTarget()
	return target
}

// SetArch stamps just the target CPU architecture (an ARCH_* member) onto the
// live target, leaving PointerSize/IntSize/MaxAlign/BigEndian untouched.  It
// must be called AFTER any SetTarget, which resets every field (Arch included)
// from its info arg — setArm32Layout in cmd/bnc calls SetArch after SetTarget
// for exactly this reason.  A host/LP64 target that never calls SetTarget can
// call SetArch on its own.
func SetArch(a int) {
	initTarget()
	target.Arch = a
}

// SetFloatABI stamps just the floating-point calling convention (a FLOAT_ABI_*
// member) onto the live target, leaving every other field untouched.  Like
// SetArch it must be called AFTER any SetTarget (which resets FloatABI to
// FLOAT_ABI_DEFAULT along with every other field); a target that never calls it
// stays at FLOAT_ABI_DEFAULT, which abi.Arm32HardFloat() treats as soft.
func SetFloatABI(abi int) {
	initTarget()
	target.FloatABI = abi
}

// ptrSize returns the target pointer size, initializing defaults if needed.
func ptrSize() int {
	initTarget()
	return target.PointerSize
}

// intSize returns the target int size, initializing defaults if needed.
func intSize() int {
	initTarget()
	return target.IntSize
}

// maxAlign returns the target max alignment, initializing defaults if needed.
func maxAlign() int {
	initTarget()
	return target.MaxAlign
}

// Size returns the size of a type in bytes, including trailing padding.  Const
// wrappers are transparent — `const T` has the same layout as `T`, since const is a
// compile-time-only restriction on modifiability through this access path.  A type
// too large for the target (which the checker rejects: SizeIfFits) is an internal
// error.
func (t @Type) Size() int64 {
	beginLayout()
	var s int64 = sizeOf(t)
	endLayout()
	if s < 0 { panicTooLarge() }
	return s
}

// SizeIfFits returns the size of a type in bytes, and whether it fits the target
// (spec type.layout.max-size); the size is meaningless when it does not.
func (t @Type) SizeIfFits() (int64, bool) {
	beginLayout()
	var s int64 = sizeOf(t)
	endLayout()
	return s, s >= 0
}

// SizeOf returns Size() as the host's int.  A size that does not fit it is an
// internal error: the int forms of the layout queries serve the callers not yet moved
// to the int64 ones, which on a 32-bit host would otherwise wrap.
func (t @Type) SizeOf() int {
	return HostInt(t.Size())
}

// ArrayLenHost returns an array type's length as the host's int, checking that the
// whole array's size fits it (so an index times the element size does too).
func (t @Type) ArrayLenHost() int {
	_ = HostInt(t.Size())
	return HostInt(t.ArrayLen)
}

// layoutGen numbers the layout queries (SizeOf, AlignOf, FieldOffset,
// StructLayout, NeedsDestruction); layoutDepth counts the ones in progress, so
// the queries a query makes for its parts share its generation and its memoized
// struct layouts (Type.layoutMemoGen).  A new outermost query starts a new
// generation: a type may change between queries (a forward-declared type is
// completed), never within one.
var layoutGen int

// layoutDepth is the number of layout queries in progress (layoutGen).
var layoutDepth int

// beginLayout enters a layout query, starting a new generation at the outermost.
func beginLayout() {
	if layoutDepth == 0 { layoutGen = layoutGen + 1 }
	layoutDepth = layoutDepth + 1
}

// endLayout leaves a layout query.
func endLayout() {
	layoutDepth = layoutDepth - 1
}

// structLayoutOf returns struct type t's size and alignment, computed once per
// layout query: each field aligned to its own alignment, the size padded to the
// largest one; an empty struct is size 0, alignment 1.
func structLayoutOf(t @Type) (int64, int) {
	if t.layoutMemoGen == layoutGen { return t.layoutSize, t.layoutAlign }
	var offset int64 = 0
	var maxA int = 1
	for i := 0; i < len(t.Fields); i++ {
		var a int = alignOf(t.Fields[i].Type)
		offset = addSize(alignUp(offset, a), sizeOf(t.Fields[i].Type))
		if a > maxA { maxA = a }
	}
	offset = alignUp(offset, maxA)
	t.layoutMemoGen = layoutGen
	t.layoutSize = offset
	t.layoutAlign = maxA
	return offset, maxA
}

// sizeOf is Size within a layout query, sizeTooLarge for a type too large.
func sizeOf(t @Type) int64 {
	t = t.ResolveAlias()
	if t != nil && t.Kind == TYP_READONLY { return sizeOf(t.Elem) }
	if t == nil { return cast(int64, ptrSize()) }
	if t.Kind == TYP_TUPLE {
		panic("internal error: a call's result tuple has no size (it is not a value)")
	}
	if t.Kind == TYP_BOOL { return 1 }
	if t.Kind == TYP_INT || t.Kind == TYP_UNTYPED_INT {
		if t.Width > 0 { return cast(int64, t.Width / 8) }
		return cast(int64, intSize())
	}
	if t.Kind == TYP_FLOAT {
		if t.Width > 0 { return cast(int64, t.Width / 8) }
		return 8
	}
	if t.Kind == TYP_UNTYPED_FLOAT { return 8 }
	var w int64 = cast(int64, ptrSize())
	if t.Kind == TYP_POINTER || t.Kind == TYP_MANAGED_PTR { return w }
	if t.Kind == TYP_SLICE { return 2 * w }
	if t.Kind == TYP_MANAGED_SLICE { return 4 * w }
	if t.Kind == TYP_FUNC_VALUE || t.Kind == TYP_MANAGED_FUNC_VALUE { return 2 * w }
	if t.Kind == TYP_INTERFACE_VALUE || t.Kind == TYP_INTERFACE_VALUE_MANAGED { return 2 * w }
	if t.Kind == TYP_ARRAY {
		if t.Elem == nil || t.ArrayLen == 0 { return 0 }
		return mulSize(t.ArrayLen, sizeOf(t.Elem))
	}
	if t.Kind == TYP_STRUCT {
		var size int64
		size, _ = structLayoutOf(t)
		return size
	}
	if t.Kind == TYP_NAMED {
		if t.Underlying != nil { return sizeOf(t.Underlying) }
		// Opaque type (forward decl, no body) — layout unknown.  Falls
		// through to the pointer size below; must NOT panic, because Size is
		// reachable from source (sizeof/alignof const-fold, bit_cast
		// element-size, array dimensions).  The checker rejects forming an
		// opaque VALUE (make/sizeof/alignof gates, requireSizedType,
		// checkValueEmbedding, and the const-fold / bit_cast gates), so a
		// genuine value layout should never reach here.
	}
	return w
}

// AlignOf returns the alignment requirement of a type in bytes.
// Const is transparent (same reasoning as Size).
func (t @Type) AlignOf() int {
	beginLayout()
	var a int = alignOf(t)
	endLayout()
	return a
}

// alignOf is AlignOf within a layout query.
func alignOf(t @Type) int {
	t = t.ResolveAlias()
	if t != nil && t.Kind == TYP_READONLY { return alignOf(t.Elem) }
	var ma int = maxAlign()
	if t == nil { return ma }
	if t.Kind == TYP_TUPLE {
		panic("internal error: a call's result tuple has no alignment (it is not a value)")
	}
	if t.Kind == TYP_BOOL { return 1 }
	if t.Kind == TYP_INT || t.Kind == TYP_UNTYPED_INT {
		var size int = intSize()
		if t.Width > 0 { size = t.Width / 8 }
		if size > ma { return ma }
		return size
	}
	if t.Kind == TYP_FLOAT || t.Kind == TYP_UNTYPED_FLOAT {
		var size int = 8
		if t.Kind == TYP_FLOAT && t.Width > 0 { size = t.Width / 8 }
		if size > ma { return ma }
		return size
	}
	if t.Kind == TYP_POINTER || t.Kind == TYP_MANAGED_PTR { return ptrSize() }
	// TYP_NIL is the untyped `nil` literal's type; it coerces to a pointer /
	// slice / iface / func value, all ptrSize-aligned, and Size already gives it
	// ptrSize.  Return ptrSize here too — NOT the maxAlign fall-through below: on
	// ILP32 maxAlign is 8, which makes NeedsEvenReg(nil) true, so a bare `nil`
	// argument to a non-slice nil-able param (e.g. `@Node`) mis-pads to an even
	// core register and lands in the wrong arg register (a wrong-code ABI bug).
	if t.Kind == TYP_NIL { return ptrSize() }
	if t.Kind == TYP_SLICE || t.Kind == TYP_MANAGED_SLICE { return ptrSize() }
	if t.Kind == TYP_FUNC_VALUE || t.Kind == TYP_MANAGED_FUNC_VALUE {
		return ptrSize()
	}
	if t.Kind == TYP_INTERFACE_VALUE || t.Kind == TYP_INTERFACE_VALUE_MANAGED {
		return ptrSize()
	}
	if t.Kind == TYP_ARRAY {
		if t.Elem == nil { return 1 }
		return alignOf(t.Elem)
	}
	if t.Kind == TYP_STRUCT {
		var align int
		_, align = structLayoutOf(t)
		return align
	}
	if t.Kind == TYP_NAMED {
		if t.Underlying != nil { return alignOf(t.Underlying) }
		// Opaque type — layout unknown; falls through to `return ma`.  Must
		// NOT panic (reachable from source); the checker rejects forming an
		// opaque value.  See Size.
	}
	return ma
}

// Offset returns the byte offset of field at index in a struct type.  A struct too
// large for the target is an internal error (Size).
func (t @Type) Offset(index int) int64 {
	beginLayout()
	var size int64 = sizeOf(t)
	var off int64 = fieldOffset(t, index)
	endLayout()
	if size < 0 { panicTooLarge() }
	return off
}

// FieldOffset returns Offset(index) as the host's int, checking that the whole struct's
// size fits it (SizeOf), so a sum of its field offsets and sizes does too.
func (t @Type) FieldOffset(index int) int {
	_ = t.SizeOf()
	return HostInt(t.Offset(index))
}

// fieldOffset is Offset within a layout query.
func fieldOffset(t @Type, index int) int64 {
	// Peel transparent wrappers (alias / readonly / named) to the struct, as
	// Size / AlignOf do; else a struct reached through a `readonly S` (e.g. a
	// `*readonly S` receiver, whose pointee an SSA-opt-rewritten field GEP base
	// carries) yields an empty layout and the field index/offset is read wrong.
	t = StripWrappers(t)
	if t == nil || t.Kind != TYP_STRUCT || len(t.Fields) == 0 { return 0 }
	var offset int64 = 0
	for i := 0; i <= index && i < len(t.Fields); i++ {
		offset = alignUp(offset, alignOf(t.Fields[i].Type))
		if i == index { return offset }
		offset = addSize(offset, sizeOf(t.Fields[i].Type))
	}
	return offset
}

// StructLayout returns the physical layout of all fields in a struct type.  A struct
// too large for the target is an internal error (Size).
func (t @Type) StructLayout() @[]FieldLayout {
	beginLayout()
	var size int64 = sizeOf(t)
	var l @[]FieldLayout = structLayout(t)
	endLayout()
	if size < 0 { panicTooLarge() }
	return l
}

// structLayout is StructLayout within a layout query.
func structLayout(t @Type) @[]FieldLayout {
	// Peel transparent wrappers (alias / readonly / named) to the struct, as
	// Size / AlignOf do; else a struct reached through a `readonly S` (e.g. a
	// `*readonly S` receiver, whose pointee an SSA-opt-rewritten field GEP base
	// carries) yields an empty layout and the field index/offset is read wrong.
	t = StripWrappers(t)
	if t == nil || t.Kind != TYP_STRUCT || len(t.Fields) == 0 {
		var empty @[]FieldLayout
		return empty
	}
	var result @[]FieldLayout = make_slice(FieldLayout, len(t.Fields))
	var offset int64 = 0
	for i := 0; i < len(t.Fields); i++ {
		var aligned int64 = alignUp(offset, alignOf(t.Fields[i].Type))
		var fl FieldLayout
		fl.FieldIndex = i
		fl.Offset = aligned
		fl.Size = sizeOf(t.Fields[i].Type)
		fl.PaddingBefore = aligned - offset
		result[i] = fl
		offset = addSize(aligned, fl.Size)
	}
	return result
}

// TrailingPadding returns the number of padding bytes after the last field.
func (t @Type) TrailingPadding() int64 {
	// Peel transparent wrappers (alias / readonly / named) to the struct, as
	// Size / AlignOf do; else a struct reached through a `readonly S` (e.g. a
	// `*readonly S` receiver, whose pointee an SSA-opt-rewritten field GEP base
	// carries) yields an empty layout and the field index/offset is read wrong.
	t = StripWrappers(t)
	if t == nil || t.Kind != TYP_STRUCT || len(t.Fields) == 0 { return 0 }
	var lastIdx int = len(t.Fields) - 1
	return t.Size() - (t.Offset(lastIdx) + t.Fields[lastIdx].Type.Size())
}
