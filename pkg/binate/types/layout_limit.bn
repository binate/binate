package "pkg/binate/types"

// Layout is computed in int64, whatever the host's int: a compiler hosted on a 32-bit
// machine lays out a 64-bit target's types exactly.  A type's size may not exceed the
// target int's maximum (spec type.layout.max-size; maxObjectSize); the layout arithmetic
// saturates to sizeTooLarge past it and passes that through, so an aggregate with a part
// too large is too large itself.  The checker rejects such a type (SizeIfFits), so the
// public accessors treat one as an internal error rather than return the sentinel, which a
// caller comparing sizes (`<= 0`, `> 16`) would read as empty or small.

// sizeTooLarge is the internal size of a type larger than maxObjectSize.
const sizeTooLarge int64 = -1

// maxObjectSize returns the largest size a type may have on the target: the maximum of
// its int (spec type.layout.max-size).
func maxObjectSize() int64 {
	var bits int = intSize() * 8
	if bits >= 64 { return 9223372036854775807 }
	return (cast(int64, 1) << (bits - 1)) - 1
}

// addSize returns a + b, or sizeTooLarge when either is, or the sum exceeds
// maxObjectSize.
func addSize(a int64, b int64) int64 {
	if a < 0 || b < 0 || a > maxObjectSize() - b { return sizeTooLarge }
	return a + b
}

// mulSize returns n elements of size bytes each, or sizeTooLarge when either is, or
// the product exceeds maxObjectSize.
func mulSize(n int64, size int64) int64 {
	if n < 0 || size < 0 { return sizeTooLarge }
	if n == 0 || size == 0 { return 0 }
	if n > maxObjectSize() / size { return sizeTooLarge }
	return n * size
}

// alignUp returns off rounded up to alignment a (a power of two), or sizeTooLarge
// when off is, or the result exceeds maxObjectSize.
func alignUp(off int64, a int) int64 {
	if off < 0 { return sizeTooLarge }
	if a <= 1 { return off }
	var m int64 = cast(int64, a) - 1
	if off > maxObjectSize() - m { return sizeTooLarge }
	return (off + m) & ~m
}

// HostInt returns v as the host's int.  A value that does not fit it is an internal
// error: a target size or offset narrowed for a use bounded by host memory.
func HostInt(v int64) int {
	var n int = cast(int, v)
	if cast(int64, n) != v {
		panic("internal error: a type's size or offset does not fit the host's int")
	}
	return n
}

// panicTooLarge reports a type too large for the target reaching layout.
func panicTooLarge() {
	panic("internal error: a type too large for the target reached layout (the checker rejects it)")
}
