package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for layout_limit.bn: the largest size a type may have (the target int's
// maximum, spec type.layout.max-size) and the layout arithmetic that saturates past it.

// The limit is the target int's maximum: 2^31 - 1 on a 32-bit target, 2^63 - 1 on a
// 64-bit one.
func TestMaxObjectSize() testing.TestResult {
	setTargetArm32()
	if maxObjectSize() != 2147483647 { return fail("2^31 - 1 on a 32-bit target") }
	setTarget64()
	if maxObjectSize() != 9223372036854775807 { return fail("2^63 - 1 on a 64-bit target") }
	return ""
}

// The arithmetic saturates to sizeTooLarge past the limit and passes it through.
func TestLayoutArithSaturates() testing.TestResult {
	setTargetArm32()
	if addSize(2147483646, 1) != 2147483647 { return fail("a sum at the limit fits") }
	if addSize(2147483647, 1) != sizeTooLarge { return fail("a sum past the limit is too large") }
	if addSize(sizeTooLarge, 0) != sizeTooLarge { return fail("too large plus 0 stays too large") }
	if mulSize(1 << 29, 4) != sizeTooLarge { return fail("2^31 is too large") }
	if mulSize((1 << 29) - 1, 4) != 2147483644 { return fail("2^31 - 4 fits") }
	if mulSize(0, sizeTooLarge) != sizeTooLarge { return fail("a too-large element stays too large") }
	if mulSize(1 << 40, 0) != 0 { return fail("zero-size elements take no space") }
	if alignUp(2147483640, 8) != 2147483640 { return fail("an aligned offset stays") }
	if alignUp(2147483641, 8) != sizeTooLarge {
		return fail("rounding up past the limit is too large")
	}
	setTarget64()
	if mulSize(1 << 40, 1 << 23) != sizeTooLarge { return fail("2^63 is too large") }
	if mulSize(1 << 40, (1 << 22) + (1 << 21)) != (1 << 62) + (1 << 61) {
		return fail("2^62 + 2^61 fits")
	}
	return ""
}

// A type past the limit does not fit (SizeIfFits), whether an array, a struct of
// fields that each fit, or a part of either; one at the limit does.
func TestSizeIfFits() testing.TestResult {
	setTargetArm32()
	var ok bool
	_, ok = MakeArrayType(TypUint8(), 2147483647).SizeIfFits()
	if !ok { return fail("2^31 - 1 bytes fit a 32-bit target") }
	var half @Type = MakeArrayType(TypUint8(), 1 << 30)
	_, ok = MakeArrayType(half, 2).SizeIfFits()
	if ok { return fail("2^31 bytes are too large for a 32-bit target") }
	var fs @[]@Field = make_slice(@Field, 2)
	fs[0] = makeField("a", half)
	fs[1] = makeField("b", half)
	var s @Type = MakeStructType("S", fs)
	_, ok = s.SizeIfFits()
	if ok { return fail("two fields of 2^30 are too large together") }
	var outer @[]@Field = make_slice(@Field, 1)
	outer[0] = makeField("s", s)
	_, ok = MakeStructType("T", outer).SizeIfFits()
	if ok { return fail("a struct holding a too-large one is too large") }
	setTarget64()
	_, ok = s.SizeIfFits()
	if !ok { return fail("2^31 bytes fit a 64-bit target") }
	var big @Type = MakeArrayType(MakeArrayType(TypUint8(), 1 << 40), 1 << 23)
	_, ok = big.SizeIfFits()
	if ok { return fail("2^63 bytes are too large for a 64-bit target") }
	return ""
}
