package "pkg/binate/types"

import "pkg/builtins/testing"

// repeatedStructDag builds depth levels of a struct whose four fields are all the
// level below, over L0 = struct { x int8; y int32 } (size 8, alignment 4): a type
// DAG with one node per level, which as a tree has 4^depth leaves.
func repeatedStructDag(depth int) @Type {
	var l0 @[]@Field = make_slice(@Field, 2)
	l0[0] = makeField("x", TypInt8())
	l0[1] = makeField("y", TypInt32())
	var lvl @Type = MakeStructType("L0", l0)
	for n := 1; n <= depth; n++ {
		var fs @[]@Field = make_slice(@Field, 4)
		fs[0] = makeField("f0", lvl)
		fs[1] = makeField("f1", lvl)
		fs[2] = makeField("f2", lvl)
		fs[3] = makeField("f3", lvl)
		lvl = MakeStructType("Ln", fs)
	}
	return lvl
}

// A struct repeated through twenty nesting levels is laid out once per level per
// query: walked as a tree, each query would visit 4^20 structs and this test would
// not finish.  Size 8 * 4^20, alignment 4, fields 8 * 4^19 apart.
func TestLayoutRepeatedStructDag() testing.TestResult {
	setTarget64()
	var t @Type = repeatedStructDag(20)
	var step int = 8
	for i := 0; i < 19; i++ {
		step = step * 4
	}
	if t.SizeOf() != 4 * step { return fail("size should be 8 * 4^20") }
	if t.AlignOf() != 4 { return fail("alignment should be 4") }
	if t.FieldOffset(3) != 3 * step { return fail("field 3 should be at 3 * 8 * 4^19") }
	var l @[]FieldLayout = t.StructLayout()
	if len(l) != 4 || l[1].Offset != step || l[3].Size != step {
		return fail("StructLayout should give the four fields 8 * 4^19 apart")
	}
	return ""
}

// A struct completed after a layout query is laid out afresh by the next one: the
// memo lasts for one query.
func TestLayoutMemoPerQuery() testing.TestResult {
	setTarget64()
	var f @[]@Field = make_slice(@Field, 1)
	f[0] = makeField("a", TypInt8())
	var s @Type = MakeStructType("Grows", f)
	if s.SizeOf() != 1 { return fail("one int8 field: size 1") }
	var g @[]@Field = make_slice(@Field, 2)
	g[0] = f[0]
	g[1] = makeField("b", TypInt64())
	s.Fields = g
	if s.SizeOf() != 16 || s.AlignOf() != 8 {
		return fail("after a field is added, the next query should see size 16, alignment 8")
	}
	return ""
}

// NeedsDestruction of a struct repeated through twenty nesting levels: true when
// the innermost struct holds a managed pointer, false when it holds none -- each
// answered without walking the 4^20 paths.
func TestNeedsDestructionRepeatedStructDag() testing.TestResult {
	var plain @Type = repeatedStructDag(20)
	if plain.NeedsDestruction() { return fail("no managed field: no destruction") }
	var inner @[]@Field = make_slice(@Field, 1)
	inner[0] = makeField("p", MakeManagedPtrType(TypInt()))
	var lvl @Type = MakeStructType("M0", inner)
	for n := 1; n <= 20; n++ {
		var fs @[]@Field = make_slice(@Field, 4)
		fs[0] = makeField("f0", lvl)
		fs[1] = makeField("f1", lvl)
		fs[2] = makeField("f2", lvl)
		fs[3] = makeField("f3", lvl)
		lvl = MakeStructType("Mn", fs)
	}
	if !lvl.NeedsDestruction() { return fail("a managed pointer at the bottom: needs destruction") }
	return ""
}
