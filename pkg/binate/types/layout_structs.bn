// Struct layout without recursion: the structs a struct holds by value are laid out
// innermost first from an explicit stack, so a struct nested by value to any depth
// lays out without exhausting the compiler's stack.
package "pkg/binate/types"

import "pkg/std/vec"

// layoutBusy marks, in layoutSize, a struct being laid out (on layStructs's stack).
// Meeting it again is a struct that holds itself by value, which the checker rejects.
const layoutBusy int64 = -2

// layFrame is a struct on layStructs's stack: t, and the index of the first field
// whose base it has not looked at yet.
type layFrame struct {
	t    @Type
	next int
}

// layStack is layStructs's stack, kept from one layout to the next (layStructs never
// re-enters), so a layout allocates only to grow it.
var layStack @vec.Vec[layFrame]

// structLayoutOf returns struct type t's size and alignment, computed once per layout
// query.  A struct holding no struct by value that the query has not laid out --
// nearly every struct -- is laid out at once; any other from layStack (layStructs).
func structLayoutOf(t @Type) (int64, int) {
	if t.layoutMemoGen != layoutGen {
		var held @Type = nil
		held, _ = nextHeldStruct(t, 0)
		if held == nil {
			layOneStruct(t)
			t.layoutMemoGen = layoutGen
		} else {
			layStructs(t)
		}
	}
	return t.layoutSize, t.layoutAlign
}

// layStructs lays out struct t and each struct it holds by value that this query has
// not laid out yet, innermost first: a struct is laid out (layOneStruct) once every
// struct its fields hold by value is.
func layStructs(t @Type) {
	if layStack == nil { layStack = vec.New[layFrame]() }
	layStack.Push(busyFrame(t))
	for layStack.Len() > 0 {
		var top int = layStack.Len() - 1
		var f layFrame = layStack.Get(top)
		var held @Type = nil
		held, f.next = nextHeldStruct(f.t, f.next)
		layStack.Set(top, f)
		if held != nil {
			layStack.Push(busyFrame(held))
		} else {
			layOneStruct(f.t)
			_, _ = layStack.Pop()
		}
	}
}

// nextHeldStruct returns the first struct that a field of struct t, from index from on,
// holds by value (valueBase) and this query has not laid out, with the index of the
// field after it; or nil and len(t.Fields).  One being laid out (layoutBusy) holds t
// by value: an internal error.
func nextHeldStruct(t @Type, from int) (@Type, int) {
	for i := from; i < len(t.Fields); i++ {
		var b @Type = valueBase(t.Fields[i].Type)
		if b != nil && b.Kind == TYP_STRUCT {
			if b.layoutMemoGen != layoutGen { return b, i + 1 }
			if b.layoutSize == layoutBusy {
				panic("internal error: a struct holds itself by value (the checker rejects it)")
			}
		}
	}
	return nil, len(t.Fields)
}

// busyFrame marks struct t as being laid out and returns its frame.
func busyFrame(t @Type) layFrame {
	t.layoutMemoGen = layoutGen
	t.layoutSize = layoutBusy
	var f layFrame
	f.t = t
	return f
}

// layOneStruct lays out struct t, each struct its fields hold by value laid out
// already: each field aligned to its own alignment, the size padded to the largest
// one; an empty struct is size 0, alignment 1.
func layOneStruct(t @Type) {
	var offset int64 = 0
	var maxA int = 1
	for i := 0; i < len(t.Fields); i++ {
		var a int = alignOf(t.Fields[i].Type)
		offset = addSize(alignUp(offset, a), sizeOf(t.Fields[i].Type))
		if a > maxA { maxA = a }
	}
	t.layoutSize = alignUp(offset, maxA)
	t.layoutAlign = maxA
}

// valueBase returns the type t holds by value at its base: t with aliases, readonly,
// named types with an underlying and arrays peeled.
func valueBase(t @Type) @Type {
	var steps int = 0
	var g chainGuard
	for t != nil {
		t = t.ResolveAlias()
		if t == nil { return nil }
		if t.Kind == TYP_READONLY {
			t = t.Elem
		} else if t.Kind == TYP_NAMED && t.Underlying != nil {
			t = t.Underlying
		} else if t.Kind == TYP_ARRAY && t.Elem != nil {
			t = t.Elem
		} else {
			return t
		}
		steps = steps + 1
		if t != nil && steps >= guardFrom && guardCloses(&g, steps, t) { panicCyclicLayout() }
	}
	return nil
}

// panicCyclicLayout reports a cyclic chain of types reaching layout, which the checker
// rejects at its declaration.
func panicCyclicLayout() {
	panic("internal error: a cyclic type reached layout (the checker rejects it)")
}
