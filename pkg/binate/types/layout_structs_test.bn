package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Layout of types nested far deeper than a walk with one stack frame per level could
// go: sizeOf and alignOf are loops, and layStructs lays out from an explicit stack.
// Each test releases its deep types a link at a time, as spec §18.2's note says to:
// releasing one whole would nest one destruction per level.  The deep tests are skipped
// on the bare-metal lane, whose 4 MiB arena cannot hold them, and on the double-VM
// lane, which would take an hour over them (scripts/unittest/*.skip.*).

// deepLevels is how deep these tests nest a type.
const deepLevels int = 200000

// pairStruct returns struct { a a; b b }.
func pairStruct(a @Type, b @Type) @Type {
	var fs @[]@Field = make_slice(@Field, 2)
	fs[0] = makeField(buf.CopyStr("a"), a)
	fs[1] = makeField(buf.CopyStr("b"), b)
	return MakeStructType(buf.CopyStr("S"), fs)
}

// Structs held by value inside each other, deepLevels deep: struct { a int8; b S }
// puts b at 8 over an 8-aligned S, so each level adds 8 bytes.
func TestLayoutDeepStructs() testing.TestResult {
	var saved TargetInfo = GetTarget()
	setTarget64()
	var t @Type = pairStruct(TypInt64(), TypInt64())
	for i := 0; i < deepLevels; i++ {
		t = pairStruct(TypInt8(), t)
	}
	var want int64 = 16 + 8 * cast(int64, deepLevels)
	var size int64 = t.Size()
	var align int = t.AlignOf()
	var off int64 = t.Offset(1)
	var fields @[]FieldLayout = t.StructLayout()
	SetTarget(saved)
	for t.Kind == TYP_STRUCT && len(t.Fields) == 2 {
		t = t.Fields[1].Type
	}
	if size != want { return fail("a deeply nested struct has the wrong size") }
	if align != 8 { return fail("a deeply nested struct has the wrong alignment") }
	if off != 8 { return fail("a deeply nested struct's second field is not at 8") }
	if len(fields) != 2 || fields[1].Offset != 8 {
		return fail("a deeply nested struct's layout is wrong")
	}
	return ""
}

// A chain of deepLevels named types, and arrays nested deepLevels deep.
func TestLayoutDeepNamedAndArrays() testing.TestResult {
	var saved TargetInfo = GetTarget()
	setTarget64()
	var s @Type = pairStruct(TypInt8(), TypInt64())
	var named @Type = namedChain(deepLevels, s)
	var arr @Type = TypInt32()
	for i := 0; i < deepLevels; i++ {
		arr = MakeArrayType(arr, 1)
	}
	var namedOK bool = named.Size() == 16 && named.AlignOf() == 8
	var arrOK bool = arr.Size() == 4 && arr.AlignOf() == 4
	SetTarget(saved)
	for named.Kind == TYP_NAMED {
		named = named.Underlying
	}
	for arr.Kind == TYP_ARRAY {
		arr = arr.Elem
	}
	if !namedOK { return fail("a long chain of named types must have its struct's layout") }
	if !arrOK { return fail("arrays nested deeply must have their element's layout") }
	return ""
}

// A chain mixing every level layout walks down -- struct { a int8; b [1]readonly N }
// with N named over the next struct -- 50,000 levels deep: each adds 8 bytes.
func TestLayoutDeepMixedChain() testing.TestResult {
	var saved TargetInfo = GetTarget()
	setTarget64()
	var levels int = 50000
	var t @Type = pairStruct(TypInt64(), TypInt64())
	for i := 0; i < levels; i++ {
		var named @Type = MakeNamedType("N")
		named.Underlying = t
		t = pairStruct(TypInt8(), MakeArrayType(MakeReadonlyType(named), 1))
	}
	var size int64 = t.Size()
	var align int = t.AlignOf()
	SetTarget(saved)
	for t.Kind == TYP_STRUCT && len(t.Fields) == 2 && t.Fields[1].Type.Kind == TYP_ARRAY {
		t = t.Fields[1].Type.Elem.Elem.Underlying
	}
	if size != 16 + 8 * cast(int64, levels) || align != 8 {
		return fail("a deep chain of structs, arrays, readonly and named types has the wrong layout")
	}
	return ""
}

// An array's size is its element's times the lengths, multiplied from the innermost
// array out: a zero length or a zero-size element gives 0 however large the other
// lengths, and a negative length is too large.
func TestLayoutArraySizes() testing.TestResult {
	var saved TargetInfo = GetTarget()
	setTarget64()
	var big int64 = 1 << 40
	var empty @[]@Field
	var zeroLen @Type = MakeArrayType(MakeArrayType(MakeArrayType(TypUint8(), 0), big), big)
	var zeroElem @Type = MakeArrayType(MakeArrayType(MakeStructType(buf.CopyStr("E"), empty), big),
			big)
	var negative @Type = MakeArrayType(MakeArrayType(TypInt8(), -1), 2)
	var s1 int64 = 0
	var ok1 bool = false
	s1, ok1 = zeroLen.SizeIfFits()
	var s2 int64 = 0
	var ok2 bool = false
	s2, ok2 = zeroElem.SizeIfFits()
	var ok3 bool = true
	_, ok3 = negative.SizeIfFits()
	SetTarget(saved)
	if !ok1 || s1 != 0 { return fail("arrays over a zero-length array must have size 0") }
	if !ok2 || s2 != 0 { return fail("arrays of a zero-size element must have size 0") }
	if ok3 { return fail("an array of negative length must be too large") }
	return ""
}

// A struct held by value only under a zero-length array takes no space but still sets
// the alignment: struct { a int8; z [0]struct { x int64 } } is 8 bytes, 8-aligned.
func TestLayoutZeroLengthArrayOfStruct() testing.TestResult {
	var saved TargetInfo = GetTarget()
	setTarget64()
	var inner @Type = pairStruct(TypInt64(), TypInt64())
	var t @Type = pairStruct(TypInt8(), MakeArrayType(inner, 0))
	var size int64 = t.Size()
	var align int = t.AlignOf()
	SetTarget(saved)
	if size != 8 || align != 8 {
		return fail("a struct under a zero-length array must set alignment only")
	}
	return ""
}
