package "pkg/binate/types"

import "pkg/builtins/testing"

// ============================================================
// Layout Tests
// ============================================================

func makeField(name @[]char, t @Type) @Field {
	var f @Field = make(Field)
	f.Name = name
	f.Type = t
	return f
}

func TestSizeOfPrimitives() testing.TestResult {
	setTarget64()
	// Pin to 64-bit so int/uint report 8 regardless of host: SetTarget re-sets
	// the word-sized int/uint singletons, so a layout test is host-independent
	// once it pins a target.  Fixed-width types stay hardcoded.
	if TypBool().SizeOf() != 1 { return fail("bool size") }
	if TypInt8().SizeOf() != 1 { return fail("int8 size") }
	if TypUint8().SizeOf() != 1 { return fail("uint8 size") }
	if TypInt16().SizeOf() != 2 { return fail("int16 size") }
	if TypUint16().SizeOf() != 2 { return fail("uint16 size") }
	if TypInt32().SizeOf() != 4 { return fail("int32 size") }
	if TypUint32().SizeOf() != 4 { return fail("uint32 size") }
	var hostInt int = 8
	if TypInt().SizeOf() != hostInt { return fail("int size") }
	if TypUint().SizeOf() != hostInt { return fail("uint size") }
	if TypInt64().SizeOf() != 8 { return fail("int64 size") }
	if TypUint64().SizeOf() != 8 { return fail("uint64 size") }
	return ""
}

func TestSizeOfPointers() testing.TestResult {
	// Pointer types compute SizeOf via ptrSize() (the LIVE target's
	// pointer size, not the int singleton).  Pin the target to
	// 64-bit so the assertion is independent of host AND of which
	// test ran previously.
	setTarget64()
	if MakePointerType(TypInt()).SizeOf() != 8 {
		return fail("*int size")
	}
	if MakeManagedPtrType(TypInt()).SizeOf() != 8 {
		return fail("@int size")
	}
	return ""
}

func TestSizeOfSlice() testing.TestResult {
	// Slice = 2 words (data, len) — size = 2 * ptrSize(), dynamic
	// per the live target.  Pin target to 64-bit so the assertion
	// is host-independent.
	setTarget64()
	if MakeSliceType(TypInt()).SizeOf() != 16 { return fail("*[]int size") }
	if MakeSliceType(TypInt8()).SizeOf() != 16 { return fail("*[]int8 size") }
	return ""
}

func TestSizeOfFuncValue() testing.TestResult {
	// *func(...) and @func(...) are 2-word {vtable, data} values (16 B
	// on 64-bit) regardless of the inner signature.  Pin target to
	// 64-bit so the assertion is host-independent.
	setTarget64()
	var noParams @[]@Param
	var noResults @[]@Type
	if MakeFuncValueType(noParams, noResults).SizeOf() != 16 {
		return fail("*func() size")
	}
	if MakeManagedFuncValueType(noParams, noResults).SizeOf() != 16 {
		return fail("@func() size")
	}
	// Different signature, same layout.
	var params @[]@Param = make_slice(@Param, 1)
	var p0 @Param = make(Param)
	p0.Type = TypInt()
	params[0] = p0
	var results @[]@Type = make_slice(@Type, 1)
	results[0] = TypInt()
	if MakeFuncValueType(params, results).SizeOf() != 16 {
		return fail("*func(int) int size")
	}
	if MakeFuncValueType(noParams, noResults).AlignOf() != 8 {
		return fail("*func() align")
	}
	return ""
}

func TestSizeOfArray() testing.TestResult {
	setTarget64()
	// Array of TypInt: size = N * TypInt.SizeOf().  TypInt is a
	// word-sized singleton; with the target pinned to 64-bit it is 8.
	var hostInt int = 8
	if MakeArrayType(TypInt(), 5).SizeOf() != 5 * hostInt {
		return fail("[5]int size")
	}
	if MakeArrayType(TypInt8(), 10).SizeOf() != 10 { return fail("[10]int8 size") }
	if MakeArrayType(TypInt(), 0).SizeOf() != 0 { return fail("[0]int size") }
	return ""
}

func TestAlignOfPrimitives() testing.TestResult {
	// Pointer / slice AlignOf go through maxAlign() (dynamic on the
	// live target); pin to 64-bit so those assertions are
	// host-independent.  TypInt's AlignOf is its width for the pinned 64-bit target (8).
	setTarget64()
	if TypBool().AlignOf() != 1 { return fail("bool align") }
	if TypInt8().AlignOf() != 1 { return fail("int8 align") }
	if TypInt16().AlignOf() != 2 { return fail("int16 align") }
	if TypInt32().AlignOf() != 4 { return fail("int32 align") }
	var hostInt int = 8
	if TypInt().AlignOf() != hostInt { return fail("int align") }
	if MakePointerType(TypInt()).AlignOf() != 8 { return fail("*int align") }
	if MakeSliceType(TypInt()).AlignOf() != 8 { return fail("*[]int align") }
	return ""
}

// On ILP32 (AAPCS: 4-byte pointer/int, MaxAlign 8) the 8-byte fundamentals
// int64 / uint64 / float64 must still align to 8 — AlignOf caps at maxAlign()
// (8 here), NOT at the pointer size.  This pins the layout contract that a
// MaxAlign derived from the pointer size (4) would break: it would cap
// alignof(int64) to 4 and undersize every 8-byte-member struct.  Pointers /
// slices stay ptrSize(4)-aligned (they go through ptrSize(), not maxAlign()).
func TestAlignOfInt64Ilp32() testing.TestResult {
	setTargetArm32()
	if TypInt64().AlignOf() != 8 { return fail("int64 align (ILP32)") }
	if TypUint64().AlignOf() != 8 { return fail("uint64 align (ILP32)") }
	if TypFloat64().AlignOf() != 8 { return fail("float64 align (ILP32)") }
	if TypInt().AlignOf() != 4 { return fail("int align (ILP32)") }
	if TypInt32().AlignOf() != 4 { return fail("int32 align (ILP32)") }
	if TypFloat32().AlignOf() != 4 { return fail("float32 align (ILP32)") }
	if MakePointerType(TypInt()).AlignOf() != 4 { return fail("*int align (ILP32)") }
	if MakeSliceType(TypInt()).AlignOf() != 4 { return fail("*[]int align (ILP32)") }
	// A struct with an 8-byte member takes the member's 8-alignment.
	var fields @[]@Field = make_slice(@Field, 1)
	fields[0] = makeField("a", TypInt64())
	var s @Type = MakeStructType("OneI64", fields)
	if s.AlignOf() != 8 { return fail("struct{int64} align (ILP32)") }
	if s.SizeOf() != 8 { return fail("struct{int64} size (ILP32)") }
	return ""
}

func TestAlignOfArray() testing.TestResult {
	setTarget64()
	// Array of TypInt inherits TypInt's alignment (8 for the pinned target).
	var hostInt int = 8
	if MakeArrayType(TypInt(), 5).AlignOf() != hostInt {
		return fail("[5]int align")
	}
	if MakeArrayType(TypInt8(), 10).AlignOf() != 1 { return fail("[10]int8 align") }
	if MakeArrayType(TypInt32(), 3).AlignOf() != 4 { return fail("[3]int32 align") }
	return ""
}

func TestSizeOfUniformStruct() testing.TestResult {
	setTarget64()
	// struct { X int; Y int } — two TypInt fields.  Size = 2 *
	// TypInt.SizeOf(), 8 for the pinned 64-bit target.
	var fields @[]@Field = make_slice(@Field, 2)
	fields[0] = makeField("X", TypInt())
	fields[1] = makeField("Y", TypInt())
	var s @Type = MakeStructType("TwoInts", fields)
	var hostInt int = 8
	if s.SizeOf() != 2 * hostInt { return fail("TwoInts size") }
	if s.AlignOf() != hostInt { return fail("TwoInts align") }
	return ""
}

func TestSizeOfMixedStruct() testing.TestResult {
	// struct { a int8; b int64; c int8 } — int64's alignment is
	// capped by maxAlign() (dynamic on the live target).  Pin to
	// 64-bit so maxAlign=8 and the assertions stand on any host.
	//   offset 0: a (1) + 7 padding
	//   offset 8: b (8)
	//   offset 16: c (1) + 7 trailing padding
	//   total: 24, align 8
	setTarget64()
	var fields @[]@Field = make_slice(@Field, 3)
	fields[0] = makeField("a", TypInt8())
	fields[1] = makeField("b", TypInt64())
	fields[2] = makeField("c", TypInt8())
	var s @Type = MakeStructType("Mixed", fields)
	if s.SizeOf() != 24 { return fail("Mixed size") }
	if s.AlignOf() != 8 { return fail("Mixed align") }
	return ""
}

func TestFieldOffsetUniform() testing.TestResult {
	setTarget64()
	// struct { X int; Y int } — Y's offset = TypInt.SizeOf() = 8 (pinned 64-bit).
	var fields @[]@Field = make_slice(@Field, 2)
	fields[0] = makeField("X", TypInt())
	fields[1] = makeField("Y", TypInt())
	var s @Type = MakeStructType("TwoInts", fields)
	var hostInt int = 8
	if s.FieldOffset(0) != 0 { return fail("X offset") }
	if s.FieldOffset(1) != hostInt { return fail("Y offset") }
	return ""
}

func TestFieldOffsetMixed() testing.TestResult {
	// int64's alignment cap depends on maxAlign(); pin to 64-bit.
	setTarget64()
	var fields @[]@Field = make_slice(@Field, 3)
	fields[0] = makeField("a", TypInt8())
	fields[1] = makeField("b", TypInt64())
	fields[2] = makeField("c", TypInt8())
	var s @Type = MakeStructType("Mixed", fields)
	if s.FieldOffset(0) != 0 { return fail("a offset") }
	if s.FieldOffset(1) != 8 { return fail("b offset") }
	if s.FieldOffset(2) != 16 { return fail("c offset") }
	return ""
}

func TestFieldOffsetPackedSmall() testing.TestResult {
	// struct { a int8; b int8; c int16; d int32 }
	//   offset 0: a (1)
	//   offset 1: b (1)
	//   offset 2: c (2)
	//   offset 4: d (4)
	//   total: 8, align 4
	var fields @[]@Field = make_slice(@Field, 4)
	fields[0] = makeField("a", TypInt8())
	fields[1] = makeField("b", TypInt8())
	fields[2] = makeField("c", TypInt16())
	fields[3] = makeField("d", TypInt32())
	var s @Type = MakeStructType("Packed", fields)
	if s.FieldOffset(0) != 0 { return fail("a offset") }
	if s.FieldOffset(1) != 1 { return fail("b offset") }
	if s.FieldOffset(2) != 2 { return fail("c offset") }
	if s.FieldOffset(3) != 4 { return fail("d offset") }
	if s.SizeOf() != 8 { return fail("Packed size") }
	if s.AlignOf() != 4 { return fail("Packed align") }
	return ""
}

func TestSizeOfNestedStruct() testing.TestResult {
	setTarget64()
	// Inner: struct { x int; y int } — size = 2 * TypInt.SizeOf(),
	// align = TypInt.AlignOf().  All 8 for the pinned 64-bit target.
	var innerFields @[]@Field = make_slice(@Field, 2)
	innerFields[0] = makeField("x", TypInt())
	innerFields[1] = makeField("y", TypInt())
	var inner @Type = MakeStructType("Inner", innerFields)
	// Outer: struct { a int8; b Inner }
	//   offset 0: a (1) + (hostInt-1) padding to align inner
	//   offset hostInt: b (2 * hostInt)
	//   total: 3 * hostInt, align hostInt
	var outerFields @[]@Field = make_slice(@Field, 2)
	outerFields[0] = makeField("a", TypInt8())
	outerFields[1] = makeField("b", inner)
	var outer @Type = MakeStructType("Outer", outerFields)
	var hostInt int = 8
	if outer.SizeOf() != 3 * hostInt { return fail("Outer size") }
	if outer.FieldOffset(1) != hostInt { return fail("b offset") }
	return ""
}

func TestSizeOfStructWithSlice() testing.TestResult {
	// struct { tag int8; data *[]int }
	//   offset 0: tag (1) + 7 padding
	//   offset 8: data (16)
	//   total: 24, align 8
	var fields @[]@Field = make_slice(@Field, 2)
	fields[0] = makeField("tag", TypInt8())
	fields[1] = makeField("data", MakeSliceType(TypInt()))
	var s @Type = MakeStructType("Tagged", fields)
	if s.SizeOf() != 24 { return fail("Tagged size") }
	if s.FieldOffset(1) != 8 { return fail("data offset") }
	return ""
}

func TestSizeOfEmptyStruct() testing.TestResult {
	var emptyFields @[]@Field
	var s @Type = MakeStructType("Empty", emptyFields)
	if s.SizeOf() != 0 { return fail("Empty size") }
	return ""
}

// ============================================================
// Target Tests (32-bit)
// ============================================================

func setTarget32() {
	var t TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 4
	SetTarget(t)
}

func setTarget64() {
	var t TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	SetTarget(t)
}

// setTargetArm32 is the REAL arm32 (AAPCS32) layout: 4-byte pointer / int but
// MaxAlign 8 (int64 / float64 are double-word-aligned), matching cmd/bnc's
// setArm32Layout.  Distinct from setTarget32 (MaxAlign 4) — a MaxAlign-4 ILP32
// config masks 8-alignment-specific behavior (e.g. the TYP_NIL / even-register-pad
// path), so alignment-sensitive tests must use THIS one.
func setTargetArm32() {
	var t TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	SetTarget(t)
}

// SetArch stamps ONLY the Arch field (GetTarget reflects it), and SetTarget
// resets Arch from its info arg's zero value — so SetArch must follow SetTarget.
// This pins the ordering contract cmd/bnc's setArm32Layout relies on and the
// ARCH_UNKNOWN default a host build starts from.
func TestSetArchField() testing.TestResult {
	setTarget64()
	SetArch(ARCH_AA64)
	if GetTarget().Arch != ARCH_AA64 {
		return "SetArch(ARCH_AA64) should set GetTarget().Arch to ARCH_AA64"
	}
	SetArch(ARCH_X64)
	if GetTarget().Arch != ARCH_X64 {
		return "SetArch(ARCH_X64) should overwrite the stamped arch"
	}
	// SetTarget resets every field, including Arch, to its info arg's value —
	// setTarget64 leaves Arch unset, so it reverts to ARCH_UNKNOWN.
	setTarget64()
	if GetTarget().Arch != ARCH_UNKNOWN {
		return "SetTarget must reset Arch to ARCH_UNKNOWN (info arg's zero value)"
	}
	return ""
}

// A target's byte order round-trips through SetTarget/GetTarget, and every
// supported target (and the default) is little-endian.  A big-endian target is
// rejected by SetTarget with a panic — not unit-testable without recover, so
// this pins only the supported little-endian path.
func TestTargetByteOrderLittleEndian() testing.TestResult {
	var t TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	// BigEndian defaults false (little-endian).
	SetTarget(t)
	if GetTarget().BigEndian {
		return "a little-endian target must report BigEndian == false"
	}
	setTarget64() // restore for later tests
	return ""
}

func TestTarget32Primitives() testing.TestResult {
	setTarget32()
	// SetTarget re-sets the word-sized int/uint singletons, so after setTarget32
	// they report 4 (ILP32).  Reset to 64 at the end so later tests see the
	// default 64-bit target.  (Whether `int` and `int64` are the SAME type by
	// width on a 64-bit target — distinct from their SIZE tracking the target —
	// is a separate identity issue; see claude-todo.md.)
	var hostInt int = 4
	if TypInt().SizeOf() != hostInt { setTarget64(); return fail("int size 32") }
	if TypBool().SizeOf() != 1 { setTarget64(); return fail("bool size 32") }
	if TypInt8().SizeOf() != 1 { setTarget64(); return fail("int8 size 32") }
	if TypInt16().SizeOf() != 2 { setTarget64(); return fail("int16 size 32") }
	if TypInt32().SizeOf() != 4 { setTarget64(); return fail("int32 size 32") }
	if TypInt64().SizeOf() != 8 { setTarget64(); return fail("int64 size 32") }
	setTarget64()
	return ""
}

func TestTarget32Pointers() testing.TestResult {
	setTarget32()
	if MakePointerType(TypInt()).SizeOf() != 4 { setTarget64(); return fail("*int size 32") }
	if MakeManagedPtrType(TypInt()).SizeOf() != 4 { setTarget64(); return fail("@int size 32") }
	if MakePointerType(TypInt()).AlignOf() != 4 { setTarget64(); return fail("*int align 32") }
	setTarget64()
	return ""
}

func TestTarget32Slices() testing.TestResult {
	setTarget32()
	if MakeSliceType(TypInt()).SizeOf() != 8 { setTarget64(); return fail("*[]int size 32") }
	if MakeManagedSliceType(TypInt()).SizeOf() != 16 { setTarget64(); return fail("@[]int size 32") }
	if MakeSliceType(TypInt()).AlignOf() != 4 { setTarget64(); return fail("*[]int align 32") }
	setTarget64()
	return ""
}

func TestTarget32StructLayout() testing.TestResult {
	setTarget32()
	// struct { a int8; b *int } on 32-bit:
	//   offset 0: a (1) + 3 padding
	//   offset 4: b (4)
	//   total: 8, align 4
	var fields @[]@Field = make_slice(@Field, 2)
	fields[0] = makeField("a", TypInt8())
	fields[1] = makeField("b", MakePointerType(TypInt()))
	var s @Type = MakeStructType("S32", fields)
	if s.SizeOf() != 8 { setTarget64(); return fail("S32 size") }
	if s.AlignOf() != 4 { setTarget64(); return fail("S32 align") }
	if s.FieldOffset(0) != 0 { setTarget64(); return fail("S32 a offset") }
	if s.FieldOffset(1) != 4 { setTarget64(); return fail("S32 b offset") }
	setTarget64()
	return ""
}

func TestTarget32Func() testing.TestResult {
	setTarget32()
	var params @[]@Param
	var results @[]@Type
	var ft @Type = MakeFuncType(params, results)
	if ft.SizeOf() != 4 { setTarget64(); return fail("func size 32") }
	setTarget64()
	return ""
}

// ============================================================
// StructLayout Tests
// ============================================================

func TestStructLayoutUniform() testing.TestResult {
	setTarget64()
	// struct { X int; Y int } — no padding.  Pinned to 64-bit, so each int
	// field is 8 bytes.
	var fields @[]@Field = make_slice(@Field, 2)
	fields[0] = makeField("X", TypInt())
	fields[1] = makeField("Y", TypInt())
	var s @Type = MakeStructType("TwoInts", fields)
	var layout @[]FieldLayout = s.StructLayout()
	var hostInt int = 8
	if len(layout) != 2 { return fail("layout len") }
	if layout[0].Offset != 0 { return fail("X offset") }
	if layout[0].PaddingBefore != 0 { return fail("X padding") }
	if layout[0].Size != hostInt { return fail("X size") }
	if layout[1].Offset != hostInt { return fail("Y offset") }
	if layout[1].PaddingBefore != 0 { return fail("Y padding") }
	if s.TrailingPadding() != 0 { return fail("trailing") }
	return ""
}

func TestStructLayoutMixed() testing.TestResult {
	// struct { a int8; b int64; c int8 } — int64's alignment cap
	// depends on maxAlign().  Pin to 64-bit so the layout is
	// host-independent.
	//   a at 0 (1 byte), 7 padding, b at 8 (8 bytes), c at 16 (1 byte), 7 trailing
	setTarget64()
	var fields @[]@Field = make_slice(@Field, 3)
	fields[0] = makeField("a", TypInt8())
	fields[1] = makeField("b", TypInt64())
	fields[2] = makeField("c", TypInt8())
	var s @Type = MakeStructType("Mixed", fields)
	var layout @[]FieldLayout = s.StructLayout()
	if len(layout) != 3 { return fail("layout len") }
	if layout[0].Offset != 0 { return fail("a offset") }
	if layout[0].PaddingBefore != 0 { return fail("a padding") }
	if layout[0].Size != 1 { return fail("a size") }
	if layout[1].Offset != 8 { return fail("b offset") }
	if layout[1].PaddingBefore != 7 { return fail("b padding") }
	if layout[1].Size != 8 { return fail("b size") }
	if layout[2].Offset != 16 { return fail("c offset") }
	if layout[2].PaddingBefore != 0 { return fail("c padding") }
	if layout[2].Size != 1 { return fail("c size") }
	if s.TrailingPadding() != 7 { return fail("trailing") }
	return ""
}

func TestStructLayoutPacked() testing.TestResult {
	// struct { a int8; b int8; c int16; d int32 }
	//   a:0, b:1 (no pad), c:2 (no pad), d:4 (no pad), total 8, no trailing
	var fields @[]@Field = make_slice(@Field, 4)
	fields[0] = makeField("a", TypInt8())
	fields[1] = makeField("b", TypInt8())
	fields[2] = makeField("c", TypInt16())
	fields[3] = makeField("d", TypInt32())
	var s @Type = MakeStructType("Packed", fields)
	var layout @[]FieldLayout = s.StructLayout()
	if layout[0].PaddingBefore != 0 { return fail("a pad") }
	if layout[1].PaddingBefore != 0 { return fail("b pad") }
	if layout[2].PaddingBefore != 0 { return fail("c pad") }
	if layout[3].PaddingBefore != 0 { return fail("d pad") }
	if s.TrailingPadding() != 0 { return fail("trailing") }
	return ""
}

func TestStructLayoutEmpty() testing.TestResult {
	var emptyFields @[]@Field
	var s @Type = MakeStructType("Empty", emptyFields)
	var layout @[]FieldLayout = s.StructLayout()
	if len(layout) != 0 { return fail("empty should be empty") }
	if s.TrailingPadding() != 0 { return fail("trailing") }
	return ""
}

func TestStructLayout32Bit() testing.TestResult {
	setTarget32()
	// struct { a int8; b *int } on 32-bit:
	//   a at 0 (1 byte), 3 padding, b at 4 (4 bytes), total 8, no trailing
	var fields @[]@Field = make_slice(@Field, 2)
	fields[0] = makeField("a", TypInt8())
	fields[1] = makeField("b", MakePointerType(TypInt()))
	var s @Type = MakeStructType("S32", fields)
	var layout @[]FieldLayout = s.StructLayout()
	if layout[0].PaddingBefore != 0 { setTarget64(); return fail("a pad") }
	if layout[1].PaddingBefore != 3 { setTarget64(); return fail("b pad") }
	if layout[1].Offset != 4 { setTarget64(); return fail("b offset") }
	if layout[1].Size != 4 { setTarget64(); return fail("b size") }
	if s.TrailingPadding() != 0 { setTarget64(); return fail("trailing") }
	setTarget64()
	return ""
}

func TestTargetDefault64() testing.TestResult {
	// After resetting to 64-bit target, sizes computed from the LIVE
	// target (pointer, slice, managed-slice — they call ptrSize()
	// dynamically) reflect the just-set 64-bit values; sizes baked
	// on the word-sized int/uint singletons also track the just-set target
	// (SetTarget re-sets them), so they are 8 too.
	setTarget64()
	var hostInt int = 8
	if TypInt().SizeOf() != hostInt { return fail("int size after reset") }
	if MakePointerType(TypInt()).SizeOf() != 8 { return fail("*int size after reset") }
	if MakeSliceType(TypInt()).SizeOf() != 16 { return fail("*[]int size after reset") }
	if MakeManagedSliceType(TypInt()).SizeOf() != 32 { return fail("@[]int size after reset") }
	return ""
}
