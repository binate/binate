package "pkg/binate/types"

// Integer and char literal text -> integer value.  Used by
// evalConstIntValue (eval_const_int.bn) to fold literal constants
// exactly as IR-gen's evalConstExpr does, so the checker and codegen
// agree on a const value (array dims, shift counts, cast fits).

// ParseCharLit returns the integer (byte) value of a char literal's raw
// quoted text (`'A'`, `'\n'`, `'\x41'`).  It is the single shared char-literal
// decoder for BOTH the checker (evalConstIntValue / cast-fit folding) and
// IR-gen (gen_expr / gen_composite / gen_const_fold), so the two stay in
// lockstep on a char-literal const's value (array dims, shift counts, cast
// fits) — there is exactly one decoder, so they cannot drift.  Escapes are
// validated separately (checkCharLitEscapes / validateEscapes); a malformed
// literal is decoded defensively.
func ParseCharLit(s *[]readonly char) int {
	if len(s) >= 2 && s[0] == '\'' && s[len(s) - 1] == '\'' {
		s = s[1:len(s) - 1]
	}
	if len(s) == 0 {
		return 0
	}
	if s[0] == '\\' && len(s) > 1 {
		if s[1] == 'n' { return 10 }
		if s[1] == 'r' { return 13 }
		if s[1] == 't' { return 9 }
		if s[1] == '\\' { return 92 }
		if s[1] == '\'' { return 39 }
		if s[1] == '"' { return 34 }
		if s[1] == '0' { return 0 }
		if s[1] == 'x' && len(s) >= 4 {
			return HexDigitVal(s[2]) * 16 + HexDigitVal(s[3])
		}
		if s[1] == 'u' && len(s) >= 6 {
			// A char-literal `\u` is constrained to a single byte
			// (code point <= U+007F), so the code point IS the byte value.
			return HexDigitVal(s[2]) * 4096 + HexDigitVal(s[3]) * 256 + HexDigitVal(s[4]) * 16 +
					HexDigitVal(s[5])
		}
		// Unrecognized escape: rejected upstream by checkCharLitEscapes;
		// keep the char and drop the backslash defensively.
		return cast(int, s[1])
	}
	return cast(int, s[0])
}
