package "pkg/binate/types"

import "pkg/builtins/testing"

func TestParseIntLiteral() testing.TestResult {
	if parseIntLiteral("0") != 0 { return fail("expected 0") }
	if parseIntLiteral("42") != 42 { return fail("expected 42") }
	if parseIntLiteral("0xFF") != 255 { return fail("expected 255 for 0xFF") }
	if parseIntLiteral("0o17") != 15 { return fail("expected 15 for 0o17") }
	if parseIntLiteral("0b1010") != 10 { return fail("expected 10 for 0b1010") }
	return ""
}

func TestParseCharLiteral() testing.TestResult {
	if parseCharLiteral("'A'") != 65 { return fail("expected 65 for 'A'") }
	if parseCharLiteral("'0'") != 48 { return fail("expected 48 for '0'") }
	if parseCharLiteral("'\\n'") != 10 { return fail("expected 10 for backslash-n") }
	if parseCharLiteral("'\\t'") != 9 { return fail("expected 9 for backslash-t") }
	if parseCharLiteral("'\\\\'") != 92 { return fail("expected 92 for backslash") }
	if parseCharLiteral("'\\0'") != 0 { return fail("expected 0 for backslash-0") }
	if parseCharLiteral("'\\x41'") != 65 { return fail("expected 65 for backslash-x41") }
	if parseCharLiteral("'\\u0041'") != 65 { return fail("expected 65 for backslash-u0041") }
	return ""
}
