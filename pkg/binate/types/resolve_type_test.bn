package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// resolve_type.bn is exercised end-to-end by the existing check_decl
// / check_expr tests (every type appearing in source flows through
// resolveTypeExpr). These narrow tests pin a few specific shapes
// where a regression would silently produce the wrong Type kind
// rather than a checker error.

// checkSrcResolved checks `src` as a main file, leaving the file's
// scope installed on c.Scope so tests can introspect resolved
// Symbol.Type values. checkSrc (used elsewhere) pops the scope at
// end of Check so package-level vars aren't visible afterwards.
func checkSrcResolved(src *[]readonly char) @Checker {
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "test.bn")
	var f @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.CheckMainPersistent(f)
	return c
}

// `*T` AST → TYP_POINTER wrapping the resolved base. Without this,
// `var p *int = ...` would resolve to int (wrong) and var-init
// type-check would reject every legitimate pointer assignment.
func TestResolvePointerType() testing.TestResult {
	var c @Checker = checkSrcResolved("package \"test\"\nvar p *int\n")
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) != 0 {
		return fail("expected clean resolution of *int")
	}
	var sym @Symbol = c.Scope.Lookup("p")
	if sym == nil { return fail("var p not in scope") }
	if sym.Type == nil || sym.Type.Kind != TYP_POINTER {
		return fail("p's type should be TYP_POINTER")
	}
	if sym.Type.Elem == nil || sym.Type.Elem.Kind != TYP_INT {
		return fail("*int's base should be TYP_INT")
	}
	return ""
}

// `@T` → TYP_MANAGED_PTR. Distinct kind from raw pointer; the
// codegen path for managed pointers is wholly different.
func TestResolveManagedPtrType() testing.TestResult {
	var c @Checker = checkSrcResolved("package \"test\"\nvar p @int\n")
	if len(c.CheckerErrors()) != 0 {
		return fail("expected clean resolution of @int")
	}
	var sym @Symbol = c.Scope.Lookup("p")
	if sym == nil || sym.Type == nil ||
			sym.Type.Kind != TYP_MANAGED_PTR {
		return fail("p's type should be TYP_MANAGED_PTR")
	}
	return ""
}

// `[N]T` → TYP_ARRAY with the literal length carried on Type.Len.
// Array kinds need their length pinned for size/alignment math
// downstream; if this drops, layout silently differs from the spec.
func TestResolveArrayType() testing.TestResult {
	var c @Checker = checkSrcResolved("package \"test\"\nvar a [4]int\n")
	if len(c.CheckerErrors()) != 0 {
		return fail("expected clean resolution of [4]int")
	}
	var sym @Symbol = c.Scope.Lookup("a")
	if sym == nil || sym.Type == nil ||
			sym.Type.Kind != TYP_ARRAY {
		return fail("a's type should be TYP_ARRAY")
	}
	if sym.Type.ArrayLen != 4 {
		return fail("array length should be 4")
	}
	return ""
}

// An array dimension may be a const ident (`[N]int`) or a constant
// expression (`[N+1]int`).  evalConstInt must read the const's folded
// value (not return 0 for a SYM_CONST ident) and fold the expression
// (not error on EXPR_BINARY), so the array resolves to the right length
// — which feeds SizeOf/layout and len().  Pre-fix, `a` resolved to a
// zero-length array and `b` produced a spurious "array length must be a
// constant" error.
func TestResolveArrayDimFromConst() testing.TestResult {
	var c @Checker = checkSrcResolved(
		"package \"test\"\n"
		"const N int = 3\n"
		"var a [N]int\n"
		"var b [N + 1]int\n")
	if len(c.CheckerErrors()) != 0 {
		return fail("const-dimensioned arrays should resolve without error")
	}
	var sa @Symbol = c.Scope.Lookup("a")
	if sa == nil || sa.Type == nil || sa.Type.Kind != TYP_ARRAY {
		return fail("a should resolve to an array type")
	}
	if sa.Type.ArrayLen != 3 {
		return fail("[N]int with N=3 should have length 3")
	}
	var sb @Symbol = c.Scope.Lookup("b")
	if sb == nil || sb.Type == nil || sb.Type.Kind != TYP_ARRAY {
		return fail("b should resolve to an array type")
	}
	if sb.Type.ArrayLen != 4 {
		return fail("[N+1]int with N=3 should have length 4")
	}
	return ""
}

// Anonymous struct types resolve their field list. Each field's
// type goes through resolveTypeExpr recursively.
func TestResolveStructType() testing.TestResult {
	var c @Checker = checkSrcResolved("package \"test\"\nvar s struct { x int; y int }\n")
	if len(c.CheckerErrors()) != 0 {
		return fail("expected clean resolution of anon struct")
	}
	var sym @Symbol = c.Scope.Lookup("s")
	if sym == nil || sym.Type == nil ||
			sym.Type.Kind != TYP_STRUCT {
		return fail("s's type should be TYP_STRUCT")
	}
	if len(sym.Type.Fields) != 2 {
		return fail("struct should have 2 fields")
	}
	return ""
}

// A reference to an unknown name in type position must produce a
// "undefined" check error and a TypVoid placeholder — not silently
// resolve to int (the previous error mode that masked typos).
func TestResolveNamedTypeUndefined() testing.TestResult {
	var c @Checker = checkSrcResolved("package \"test\"\nvar v UnknownT\n")
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) == 0 {
		return fail("undefined type should produce a check error")
	}
	return ""
}

// A reference where the name resolves to something other than a type
// (e.g., a const) reports a distinct "not a type" diagnostic.
func TestResolveNamedTypeNotAType() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nconst N int = 4\nvar v N\n"
	var c @Checker = checkSrcResolved(src)
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) == 0 {
		return fail("non-type ident in type position should error")
	}
	return ""
}

// resolveFuncDeclType detects duplicate parameter names — a regression
// here would let `func(x int, x int)` slip through and produce
// confusing downstream errors at the IR-gen stage.
func TestResolveFuncDeclTypeRejectsDuplicateParams() testing.TestResult {
	var src *[]readonly char =
		"package \"test\"\nfunc f(x int, x int) { }\n"
	var c @Checker = checkSrcResolved(src)
	if len(c.CheckerErrors()) == 0 {
		return fail("duplicate param name should be a check error")
	}
	return ""
}
