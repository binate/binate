package "pkg/binate/types"

import "pkg/stdx/slices"

// ============================================================
// Scope and Symbols
// ============================================================

// NewScope creates a new scope with the given parent (nil for the top-level scope).
func NewScope(parent @Scope) @Scope {
	var s @Scope = make(Scope)
	s.Parent = parent
	return s
}

// scopeHashThreshold is the symbol count past which a scope switches from a
// linear Syms scan to the name→index hash.  Below it, the scan is cheap and the
// hash's bucket allocation would be pure overhead across the many tiny block /
// function scopes; above it (the package scope), the linear scan is the
// O(N²)-per-package cost the hash removes.
const scopeHashThreshold int = 16

// scopeHashMinCap is the starting bucket count for an activated hash (power of
// two; sized so a just-over-threshold scope fits under the 75% load line).
const scopeHashMinCap int = 32

// scopeHashName is a djb2 hash of a symbol name.  Sign is not meaningful;
// callers mask with symMask.
func scopeHashName(name *[]readonly char) int {
	var h int = 5381
	for i := 0; i < len(name); i++ {
		h = h * 33 + cast(int, name[i])
	}
	return h
}

// symIndexLookup returns the Syms index of `name`, or -1.  Only valid when the
// hash is active (symMask != 0); open-addressing linear probe, empty slot = -1.
func (s @Scope) symIndexLookup(name *[]readonly char) int {
	var bucket int = scopeHashName(name) & s.symMask
	for probes := 0; probes <= s.symMask; probes++ {
		var pos int = (bucket + probes) & s.symMask
		var idx int = s.symBuckets[pos]
		if idx < 0 {
			return -1
		}
		if charEq(s.Syms[idx].Name, name) {
			return idx
		}
	}
	return -1
}

// symIndexInsert records Syms[idx]'s name → idx into the active bucket table.
// The caller has already ensured the name is not present (Define overwrites in
// place before appending), so this only fills the first empty slot.
func (s @Scope) symIndexInsert(idx int) {
	var bucket int = scopeHashName(s.Syms[idx].Name) & s.symMask
	for probes := 0; probes <= s.symMask; probes++ {
		var pos int = (bucket + probes) & s.symMask
		if s.symBuckets[pos] < 0 {
			s.symBuckets[pos] = idx
			return
		}
	}
}

// symHashRebuild sizes the bucket table for the current Syms at under 75% load
// and reindexes every symbol.  Called when the scope first crosses the
// threshold and whenever a later append would exceed 75% — O(N), so amortized
// O(1) per Define.
func (s @Scope) symHashRebuild() {
	var newCap int = scopeHashMinCap
	for newCap * 3 < len(s.Syms) * 4 {
		newCap = newCap * 2
	}
	s.symBuckets = make_slice(int, newCap)
	for i := 0; i < newCap; i++ {
		s.symBuckets[i] = -1
	}
	s.symMask = newCap - 1
	for i := 0; i < len(s.Syms); i++ {
		s.symIndexInsert(i)
	}
}

// LookupLocal searches for a symbol in this scope only (not parents).
func (s @Scope) LookupLocal(name *[]readonly char) @Symbol {
	if s.symMask != 0 {
		var idx int = s.symIndexLookup(name)
		if idx < 0 {
			return nil
		}
		return s.Syms[idx]
	}
	for i := 0; i < len(s.Syms); i++ {
		if charEq(s.Syms[i].Name, name) {
			return s.Syms[i]
		}
	}
	return nil
}

// Define adds a symbol to the scope, overwriting any existing symbol with the same name.
func (s @Scope) Define(sym @Symbol) {
	// A per-file import scope forwards package-symbol defines to the shared
	// package scope (its parent), so collecting a file's decls under its own
	// import scope still registers the symbols package-wide.  The file's
	// imports themselves are registered before DelegateDefine is set, so they
	// stay local to the file.
	if s.DelegateDefine && s.Parent != nil {
		s.Parent.Define(sym)
		return
	}
	// Overwrite if existing — O(1) via the hash once active, else linear.
	if s.symMask != 0 {
		var idx int = s.symIndexLookup(sym.Name)
		if idx >= 0 {
			s.Syms[idx] = sym
			return
		}
	} else {
		for i := 0; i < len(s.Syms); i++ {
			if charEq(s.Syms[i].Name, sym.Name) {
				s.Syms[i] = sym
				return
			}
		}
	}
	s.Syms = slices.Append[@Symbol](s.Syms, sym)
	if s.symMask != 0 {
		// Keep load under 75%; rebuild bigger if this append would exceed it,
		// else index the one new entry.
		if len(s.Syms) * 4 > (s.symMask + 1) * 3 {
			s.symHashRebuild()
		} else {
			s.symIndexInsert(len(s.Syms) - 1)
		}
	} else if len(s.Syms) > scopeHashThreshold {
		s.symHashRebuild()
	}
}

// Lookup searches for a symbol by name in the scope and its parents.
func (s @Scope) Lookup(name *[]readonly char) @Symbol {
	var local @Symbol = s.LookupLocal(name)
	if local != nil {
		return local
	}
	if s.Parent != nil {
		return s.Parent.Lookup(name)
	}
	return nil
}

// ============================================================
// Helpers
// ============================================================

// charEq reports whether two char slices contain the same bytes.
func charEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// ============================================================
// Scope construction + symbol definition
// ============================================================

// universeScope creates the top-level scope containing all predeclared
// types, constants, and builtins.
func universeScope() @Scope {
	ensureInit()
	var s @Scope = NewScope(nil)

	defineType(s, "bool", TypBool())
	defineType(s, "char", TypChar())
	defineType(s, "int", TypInt())
	defineType(s, "int8", TypInt8())
	defineType(s, "int16", TypInt16())
	defineType(s, "int32", TypInt32())
	defineType(s, "int64", TypInt64())
	defineType(s, "uint", TypUint())
	defineType(s, "uint8", TypUint8())
	defineType(s, "uint16", TypUint16())
	defineType(s, "uint32", TypUint32())
	defineType(s, "uint64", TypUint64())
	defineType(s, "float32", TypFloat32())
	defineType(s, "float64", TypFloat64())
	defineType(s, "byte", TypByte())

	// `any` is the implicit universal interface.  Empty method set,
	// so every type satisfies it; usable spellings are `*any` and
	// `@any`.  Bare `any` as a type expression is rejected by
	// resolveTypeExpr, except in the generic-constraint position
	// where `any` means "no constraint" (see
	// resolveTypeParamConstraint's name-based fast path).
	var emptyPkg @[]char
	var anyName @[]char = "any"
	var anyIface @Type = MakeInterfaceType(emptyPkg, anyName)
	defineInterface(s, anyName, anyIface)

	defineConst(s, "true", TypUntypedBool())
	defineConst(s, "false", TypUntypedBool())
	defineConst(s, "nil", TypNil())

	// Builtin functions — variadic, checked specially
	var emptyParams @[]@Param
	var emptyResults @[]@Type
	var variadicType @Type = MakeFuncType(emptyParams, emptyResults)
	defineFunc(s, "panic", variadicType)

	return s
}

// defineType adds a type symbol to the scope.
func defineType(s @Scope, name @[]char, t @Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = SYM_TYPE
	s.Define(sym)
}

// defineConst adds a constant symbol to the scope.
func defineConst(s @Scope, name @[]char, t @Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = SYM_CONST
	s.Define(sym)
}

// defineConstVal adds a constant symbol that also carries its folded
// integer value (val), so consumers like evalConstInt (array dimensions)
// can read the value the symbol's declared type does not retain.
func defineConstVal(s @Scope, name @[]char, t @Type, val int64) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = SYM_CONST
	sym.ConstVal = val
	sym.HasConstVal = true
	s.Define(sym)
}

// defineConstBoolVal adds a boolean constant symbol carrying its folded value
// (SymBoolVal), so foldConstBoolValue can resolve a reference to it.  The value
// rides SymBoolVal, not ConstVal, so int-const consumers see HasConstVal false.
func defineConstBoolVal(s @Scope, name @[]char, t @Type, v bool) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = SYM_CONST
	sym.SymBoolVal = v
	sym.HasSymBoolVal = true
	s.Define(sym)
}

// defineFunc adds a function symbol to the scope.
func defineFunc(s @Scope, name @[]char, t @Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = SYM_FUNC
	s.Define(sym)
}

// defineVar adds a variable symbol to the scope.
func defineVar(s @Scope, name @[]char, t @Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = SYM_VAR
	s.Define(sym)
}

// definePkg adds a package symbol to the scope, mapping the local name to its import path.
func definePkg(s @Scope, name @[]char, path @[]char) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Kind = SYM_PKG
	sym.PkgPath = path
	s.Define(sym)
}
