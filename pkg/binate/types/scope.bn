package "pkg/binate/types"

import "pkg/stdx/slices"

// ============================================================
// Scope and Symbols
// ============================================================

// NewScope creates a new scope with the given parent (nil for the top-level scope).
func NewScope(parent @Scope) @Scope {
	var s @Scope = make(Scope)
	s.Parent = parent
	return s
}

// LookupLocal searches for a symbol in this scope only (not parents).
func (s @Scope) LookupLocal(name *[]readonly char) @Symbol {
	for i := 0; i < len(s.Syms); i++ {
		if charEq(s.Syms[i].Name, name) {
			return s.Syms[i]
		}
	}
	return nil
}

// Define adds a symbol to the scope, overwriting any existing symbol with the same name.
func (s @Scope) Define(sym @Symbol) {
	// A per-file import scope forwards package-symbol defines to the shared
	// package scope (its parent), so collecting a file's decls under its own
	// import scope still registers the symbols package-wide.  The file's
	// imports themselves are registered before DelegateDefine is set, so they
	// stay local to the file.
	if s.DelegateDefine && s.Parent != nil {
		s.Parent.Define(sym)
		return
	}
	// Overwrite if existing
	for i := 0; i < len(s.Syms); i++ {
		if charEq(s.Syms[i].Name, sym.Name) {
			s.Syms[i] = sym
			return
		}
	}
	s.Syms = slices.Append[@Symbol](s.Syms, sym)
}

// Lookup searches for a symbol by name in the scope and its parents.
func (s @Scope) Lookup(name *[]readonly char) @Symbol {
	for i := 0; i < len(s.Syms); i++ {
		if charEq(s.Syms[i].Name, name) {
			return s.Syms[i]
		}
	}
	if s.Parent != nil {
		return s.Parent.Lookup(name)
	}
	return nil
}

// ============================================================
// Type Layout
// ============================================================

// target holds the current target platform description.
// Default is 64-bit (LP64) so existing behavior is preserved.
var target TargetInfo

// initTarget sets default target properties (64-bit LP64) if not yet configured.
func initTarget() {
	if target.PointerSize == 0 {
		// Defaults reflect the HOST these sizes are measured on — at
		// runtime `sizeof(int)` / `sizeof(*uint8)` evaluate to whatever
		// the running process's target was compiled for, so an arm32
		// build defaults to ILP32 and an amd64 build to LP64.  Cross-
		// compilation drivers (cmd/bnc with --target) still call
		// SetTarget explicitly before any types op and override these;
		// these defaults only matter when no one has called SetTarget,
		// which is the "use the types library on the host" case (e.g.
		// pkg/binate/vm in-process tests, where the predeclared `int`
		// singleton's Width was previously locked at LP64 regardless
		// of host — see types.bn's ensureInit comment).
		target.PointerSize = cast(int, sizeof(*uint8))
		target.IntSize = cast(int, sizeof(int))
		target.MaxAlign = cast(int, sizeof(*uint8))
		// target.BigEndian stays false: every Binate host is little-endian,
		// and the implementation is little-endian only (see SetTarget).
	}
}

// SetTarget configures the target platform properties for layout computation.
//
// The word-sized `int` / `uint` singletons carry their width on the type (so
// type identity and IR-gen can read it), and that width is set once at
// ensureInit from the then-current target.  Without re-setting it here, a
// SetTarget that runs AFTER first init — a driver that touched types before
// resolving --target, or a cross-compile target picked while a host-width int
// was already locked — would leave `int` reporting the wrong size (e.g. 8 on a
// 32-bit target), even though sizeof(int) folds correctly.  Pointer / slice
// sizes already track the live target via ptrSize()/maxAlign(); int/uint are
// the only widths carried on a locked singleton, so re-set just those.
func SetTarget(info TargetInfo) {
	// Byte order is implementation-defined (§7.13.12) and this implementation
	// is little-endian ONLY — every byte-emission site (the object writers'
	// WriteU16/32/64, the ir.DataGlobal int terms, bit_cast / the
	// representation builtins) assumes it.  Reject a big-endian target loudly
	// at the single chokepoint every target flows through, rather than
	// silently emitting wrong-endian bytes.
	if info.BigEndian {
		panic("big-endian target not implemented (§7.13.12: little-endian only)")
	}
	target = info
	if typesInitialized {
		predeclaredInt.Width = info.IntSize * 8
		predeclaredUint.Width = info.IntSize * 8
	}
}

// GetTarget returns the current target platform properties, initializing defaults if needed.
func GetTarget() TargetInfo {
	initTarget()
	return target
}

// ptrSize returns the target pointer size, initializing defaults if needed.
func ptrSize() int {
	initTarget()
	return target.PointerSize
}

// intSize returns the target int size, initializing defaults if needed.
func intSize() int {
	initTarget()
	return target.IntSize
}

// maxAlign returns the target max alignment, initializing defaults if needed.
func maxAlign() int {
	initTarget()
	return target.MaxAlign
}

// SizeOf returns the size of a type in bytes, including trailing padding.
// Const wrappers are transparent — `const T` has the same layout as
// `T`, since const is a compile-time-only restriction on modifiability
// through this access path.
func (t @Type) SizeOf() int {
	t = t.ResolveAlias()
	if t != nil && t.Kind == TYP_READONLY { return t.Elem.SizeOf() }
	if t == nil { return ptrSize() }
	if t.Kind == TYP_BOOL { return 1 }
	if t.Kind == TYP_INT || t.Kind == TYP_UNTYPED_INT {
		if t.Width > 0 { return t.Width / 8 }
		return intSize()
	}
	if t.Kind == TYP_FLOAT {
		if t.Width > 0 { return t.Width / 8 }
		return 8
	}
	if t.Kind == TYP_UNTYPED_FLOAT { return 8 }
	if t.Kind == TYP_POINTER || t.Kind == TYP_MANAGED_PTR { return ptrSize() }
	if t.Kind == TYP_SLICE { return 2 * ptrSize() }
	if t.Kind == TYP_MANAGED_SLICE { return 4 * ptrSize() }
	if t.Kind == TYP_FUNC_VALUE ||
		t.Kind == TYP_MANAGED_FUNC_VALUE {
		return 2 * ptrSize()
	}
	if t.Kind == TYP_INTERFACE_VALUE ||
		t.Kind == TYP_INTERFACE_VALUE_MANAGED {
		return 2 * ptrSize()
	}
	if t.Kind == TYP_ARRAY {
		if t.Elem == nil || t.ArrayLen == 0 { return 0 }
		return t.ArrayLen * t.Elem.SizeOf()
	}
	if t.Kind == TYP_STRUCT {
		if len(t.Fields) == 0 { return 0 }
		var lastIdx int = len(t.Fields) - 1
		var size int = t.FieldOffset(lastIdx) + t.Fields[lastIdx].Type.SizeOf()
		var align int = t.AlignOf()
		if align > 1 {
			size = (size + align - 1) / align * align
		}
		return size
	}
	if t.Kind == TYP_NAMED {
		if t.Underlying != nil { return t.Underlying.SizeOf() }
		// Opaque type (forward decl, no body) — layout unknown.  Falls
		// through to ptrSize() below; must NOT panic, because SizeOf is
		// reachable from source (sizeof/alignof const-fold, bit_cast
		// element-size, array dimensions).  The checker rejects forming an
		// opaque VALUE (make/sizeof/alignof gates, requireSizedType,
		// checkValueEmbedding, and the const-fold / bit_cast gates), so a
		// genuine value layout should never reach here.  See
		// plan-type-decls.md.
	}
	if t.Kind == TYP_FUNC { return ptrSize() }
	return ptrSize()
}

// IsByvalParam reports whether a parameter of type t is passed via the
// >16-byte indirect (LLVM `ptr byval(<T>)`) calling convention rather
// than as a register/struct value.  THE single source of truth for both
// halves of that lowering, which MUST agree or the emitted function won't
// compile: IR-gen (gen_func.bn) skips the standard alloca + store-param
// pattern and flags the param ref (IsByvalParamRef) so the callee copies
// from the byval pointer; codegen (emit_util.bn) renders the param type
// as `ptr` and spills each arg through a `.bv` slot at the call site.
// (Native backends ignore the IR flag; their spillIncomingParams handle
// byval params off the arg reg directly.)
//
// The transparent wrappers (alias / readonly / named) are peeled first —
// exactly as SizeOf does — so a `readonly Big` / named- or alias-wrapped
// aggregate is classified by its representation, not mis-read as a non-
// aggregate scalar (which would lower it by value and read garbage /
// SIGSEGV, or type-mismatch the two halves above).
//
// Threshold = 16 bytes — SysV-AMD64's AggregateInRegMax / MEMORY-class
// cutoff and AAPCS64's >16-byte indirect threshold (two register words).
// The size is target-aware via SizeOf (a 3-int struct is 24 B on LP64 but
// 12 B on ILP32); the 16-byte cutoff itself matches both LP64 ABIs.  See
// explorations/plan-codegen-byval.md.
func (t @Type) IsByvalParam() bool {
	// Peel transparent wrappers (alias / const / named) to the
	// representation type.  peelNamedBounded caps the named-chain walk
	// (defense-in-depth against a cyclic named type that slips the
	// decl-time check), matching every other named-peeling predicate.
	t = peelNamedBounded(t)
	if t == nil {
		return false
	}
	var k int = t.Kind
	if k != TYP_STRUCT &&
			k != TYP_ARRAY &&
			k != TYP_SLICE &&
			k != TYP_MANAGED_SLICE &&
			k != TYP_FUNC_VALUE &&
			k != TYP_MANAGED_FUNC_VALUE &&
			k != TYP_INTERFACE_VALUE &&
			k != TYP_INTERFACE_VALUE_MANAGED {
		return false
	}
	return t.SizeOf() > 16
}

// AlignOf returns the alignment requirement of a type in bytes.
// Const is transparent (same reasoning as SizeOf).
func (t @Type) AlignOf() int {
	t = t.ResolveAlias()
	if t != nil && t.Kind == TYP_READONLY { return t.Elem.AlignOf() }
	var ma int = maxAlign()
	if t == nil { return ma }
	if t.Kind == TYP_BOOL { return 1 }
	if t.Kind == TYP_INT || t.Kind == TYP_UNTYPED_INT {
		var size int = intSize()
		if t.Width > 0 { size = t.Width / 8 }
		if size > ma { return ma }
		return size
	}
	if t.Kind == TYP_FLOAT || t.Kind == TYP_UNTYPED_FLOAT {
		var size int = 8
		if t.Kind == TYP_FLOAT && t.Width > 0 { size = t.Width / 8 }
		if size > ma { return ma }
		return size
	}
	if t.Kind == TYP_POINTER || t.Kind == TYP_MANAGED_PTR { return ptrSize() }
	if t.Kind == TYP_SLICE || t.Kind == TYP_MANAGED_SLICE { return ptrSize() }
	if t.Kind == TYP_FUNC_VALUE ||
		t.Kind == TYP_MANAGED_FUNC_VALUE {
		return ptrSize()
	}
	if t.Kind == TYP_INTERFACE_VALUE ||
		t.Kind == TYP_INTERFACE_VALUE_MANAGED {
		return ptrSize()
	}
	if t.Kind == TYP_ARRAY {
		if t.Elem == nil { return 1 }
		return t.Elem.AlignOf()
	}
	if t.Kind == TYP_STRUCT {
		var maxA int = 1
		for i := 0; i < len(t.Fields); i++ {
			var a int = t.Fields[i].Type.AlignOf()
			if a > maxA { maxA = a }
		}
		return maxA
	}
	if t.Kind == TYP_NAMED {
		if t.Underlying != nil { return t.Underlying.AlignOf() }
		// Opaque type — layout unknown; falls through to `return ma`.  Must
		// NOT panic (reachable from source); the checker rejects forming an
		// opaque value.  See SizeOf.
	}
	return ma
}

// FieldOffset returns the byte offset of field at index in a struct type.
func (t @Type) FieldOffset(index int) int {
	t = t.ResolveAlias()
	if t == nil || t.Kind != TYP_STRUCT || len(t.Fields) == 0 { return 0 }
	var offset int = 0
	for i := 0; i <= index && i < len(t.Fields); i++ {
		var fieldAlign int = t.Fields[i].Type.AlignOf()
		if fieldAlign > 1 {
			offset = (offset + fieldAlign - 1) / fieldAlign * fieldAlign
		}
		if i == index { return offset }
		offset = offset + t.Fields[i].Type.SizeOf()
	}
	return offset
}

// StructLayout returns the physical layout of all fields in a struct type.
func (t @Type) StructLayout() @[]FieldLayout {
	t = t.ResolveAlias()
	if t == nil || t.Kind != TYP_STRUCT || len(t.Fields) == 0 {
		var empty @[]FieldLayout
		return empty
	}
	var result @[]FieldLayout = make_slice(FieldLayout, len(t.Fields))
	var offset int = 0
	for i := 0; i < len(t.Fields); i++ {
		var fieldAlign int = t.Fields[i].Type.AlignOf()
		var aligned int = offset
		if fieldAlign > 1 {
			aligned = (offset + fieldAlign - 1) / fieldAlign * fieldAlign
		}
		var fl FieldLayout
		fl.FieldIndex = i
		fl.Offset = aligned
		fl.Size = t.Fields[i].Type.SizeOf()
		fl.PaddingBefore = aligned - offset
		result[i] = fl
		offset = aligned + fl.Size
	}
	return result
}

// TrailingPadding returns the number of padding bytes after the last field.
func (t @Type) TrailingPadding() int {
	t = t.ResolveAlias()
	if t == nil || t.Kind != TYP_STRUCT || len(t.Fields) == 0 { return 0 }
	var lastIdx int = len(t.Fields) - 1
	var contentEnd int = t.FieldOffset(lastIdx) + t.Fields[lastIdx].Type.SizeOf()
	return t.SizeOf() - contentEnd
}


// ============================================================
// Composite Type Layout
// ============================================================

// Slice layout: { data *T, len int }
func SliceDataOffset() int { return 0 }
// SliceLenOffset returns the byte offset of the length field in a raw slice.
func SliceLenOffset() int  { return ptrSize() }

// Managed-slice layout: { data *T, len int, backing *uint8, backingLen int }
func MSliceDataOffset() int      { return 0 }
// MSliceLenOffset returns the byte offset of the length field in a managed-slice.
func MSliceLenOffset() int       { return ptrSize() }
// MSliceBackingOffset returns the byte offset of the backing pointer in a managed-slice.
func MSliceBackingOffset() int   { return 2 * ptrSize() }
// MSliceBackingLenOffset returns the byte offset of the backing length in a managed-slice.
func MSliceBackingLenOffset() int { return 3 * ptrSize() }

// Managed pointer header: [refcount, free_fn] at negative offset from payload
// ManagedHeaderSize returns the size in bytes of the managed allocation header.
func ManagedHeaderSize() int      { return 2 * ptrSize() }
// ManagedRefcountOffset returns the byte offset of the refcount in a managed header (negative).
func ManagedRefcountOffset() int  { return -(2 * ptrSize()) }
// ManagedFreeFnOffset returns the byte offset of the free function pointer in a managed header.
func ManagedFreeFnOffset() int    { return -ptrSize() }

// Func-value layout: { vtable *uint8, data *uint8 }.  Interface-value layout:
// { data *uint8, vtable *uint8 } — the deliberate ABI asymmetry (vtable first
// for a func-value, data first for an iface-value).  These four field POSITIONS
// are the single source of truth for the order, shared by codegen (LLVM
// extractvalue/insertvalue/GEP operand indices), the bytecode VM (word-slot
// `[N]` indices into an `*int`), and the native backends (byte offset = index *
// pointer size).  The *Offset helpers track ptrSize(), so a native field access
// is ILP32-correct rather than a hardcoded LP64 8.
func FuncValueVtableIndex() int  { return 0 }
// FuncValueDataIndex returns the field index of the data pointer in a func-value.
func FuncValueDataIndex() int    { return 1 }
// IfaceValueDataIndex returns the field index of the data pointer in an iface-value.
func IfaceValueDataIndex() int   { return 0 }
// IfaceValueVtableIndex returns the field index of the vtable pointer in an iface-value.
func IfaceValueVtableIndex() int { return 1 }
// FuncValueVtableOffset returns the byte offset of the vtable pointer in a func-value.
func FuncValueVtableOffset() int  { return FuncValueVtableIndex() * ptrSize() }
// FuncValueDataOffset returns the byte offset of the data pointer in a func-value.
func FuncValueDataOffset() int    { return FuncValueDataIndex() * ptrSize() }
// IfaceValueDataOffset returns the byte offset of the data pointer in an iface-value.
func IfaceValueDataOffset() int   { return IfaceValueDataIndex() * ptrSize() }
// IfaceValueVtableOffset returns the byte offset of the vtable pointer in an iface-value.
func IfaceValueVtableOffset() int { return IfaceValueVtableIndex() * ptrSize() }

// ============================================================
// Helpers
// ============================================================

// charEq reports whether two char slices contain the same bytes.
func charEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// ============================================================
// Scope construction + symbol definition
// ============================================================

// universeScope creates the top-level scope containing all predeclared
// types, constants, and builtins.
func universeScope() @Scope {
	ensureInit()
	var s @Scope = NewScope(nil)

	defineType(s, "bool", TypBool())
	defineType(s, "char", TypChar())
	defineType(s, "int", TypInt())
	defineType(s, "int8", TypInt8())
	defineType(s, "int16", TypInt16())
	defineType(s, "int32", TypInt32())
	defineType(s, "int64", TypInt64())
	defineType(s, "uint", TypUint())
	defineType(s, "uint8", TypUint8())
	defineType(s, "uint16", TypUint16())
	defineType(s, "uint32", TypUint32())
	defineType(s, "uint64", TypUint64())
	defineType(s, "float32", TypFloat32())
	defineType(s, "float64", TypFloat64())
	defineType(s, "byte", TypByte())

	// `any` is the implicit universal interface (per
	// plan-interface-syntax-revision.md § 6).  Empty method set,
	// so every type satisfies it; usable spellings are `*any` and
	// `@any`.  Bare `any` as a type expression is rejected by
	// resolveTypeExpr, except in the generic-constraint position
	// where `any` means "no constraint" (see
	// resolveTypeParamConstraint's name-based fast path).
	var emptyPkg @[]char
	var anyName @[]char = "any"
	var anyIface @Type = MakeInterfaceType(emptyPkg, anyName)
	defineInterface(s, anyName, anyIface)

	defineConst(s, "true", TypUntypedBool())
	defineConst(s, "false", TypUntypedBool())
	defineConst(s, "nil", TypNil())

	// Builtin functions — variadic, checked specially
	var emptyParams @[]@Param
	var emptyResults @[]@Type
	var variadicType @Type = MakeFuncType(emptyParams, emptyResults)
	defineFunc(s, "print", variadicType)
	defineFunc(s, "println", variadicType)
	defineFunc(s, "panic", variadicType)

	return s
}

// defineType adds a type symbol to the scope.
func defineType(s @Scope, name @[]char, t @Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = SYM_TYPE
	s.Define(sym)
}

// defineConst adds a constant symbol to the scope.
func defineConst(s @Scope, name @[]char, t @Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = SYM_CONST
	s.Define(sym)
}

// defineConstVal adds a constant symbol that also carries its folded
// integer value (val), so consumers like evalConstInt (array dimensions)
// can read the value the symbol's declared type does not retain.
func defineConstVal(s @Scope, name @[]char, t @Type, val int) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = SYM_CONST
	sym.ConstVal = val
	sym.HasConstVal = true
	s.Define(sym)
}

// defineFunc adds a function symbol to the scope.
func defineFunc(s @Scope, name @[]char, t @Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = SYM_FUNC
	s.Define(sym)
}

// defineVar adds a variable symbol to the scope.
func defineVar(s @Scope, name @[]char, t @Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = SYM_VAR
	s.Define(sym)
}

// definePkg adds a package symbol to the scope, mapping the local name to its import path.
func definePkg(s @Scope, name @[]char, path @[]char) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Kind = SYM_PKG
	sym.PkgPath = path
	s.Define(sym)
}
