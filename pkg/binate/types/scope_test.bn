package "pkg/binate/types"

import "pkg/builtins/testing"

// ============================================================
// Scope & Symbol Tests
// ============================================================

func TestScope() testing.TestResult {
	var s @Scope = NewScope(nil)
	var sym @Symbol = make(Symbol)
	sym.Name = "x"
	sym.Type = TypInt()
	sym.Kind = SYM_VAR
	s.Define(sym)

	var found @Symbol = s.Lookup("x")
	if found == nil { return fail("lookup should find x") }
	if !found.Type.Identical(TypInt()) { return fail("x type wrong") }

	var notFound @Symbol = s.Lookup("y")
	if !(notFound == nil) { return fail("y should not be found") }
	return ""
}

func TestScopeParent() testing.TestResult {
	var parent @Scope = NewScope(nil)
	var sym @Symbol = make(Symbol)
	sym.Name = "x"
	sym.Type = TypInt()
	sym.Kind = SYM_VAR
	parent.Define(sym)

	var child @Scope = NewScope(parent)
	var found @Symbol = child.Lookup("x")
	if found == nil { return fail("should find x from parent") }

	// Shadow
	var sym2 @Symbol = make(Symbol)
	sym2.Name = "x"
	sym2.Type = TypBool()
	sym2.Kind = SYM_VAR
	child.Define(sym2)

	var shadowed @Symbol = child.Lookup("x")
	if !shadowed.Type.Identical(TypBool()) { return fail("child should shadow parent") }

	// Parent unchanged
	var parentSym @Symbol = parent.Lookup("x")
	if !parentSym.Type.Identical(TypInt()) { return fail("parent should be unchanged") }
	return ""
}

func TestFieldByName() testing.TestResult {
	var f1 @Field = make(Field)
	f1.Name = "X"
	f1.Type = TypInt()
	var f2 @Field = make(Field)
	f2.Name = "Y"
	f2.Type = TypBool()
	var fields @[]@Field = make_slice(@Field, 2)
	fields[0] = f1
	fields[1] = f2
	var s @Type = MakeStructType("Point", fields)

	var found @Field = s.FieldByName("Y")
	if found == nil { return fail("should find Y") }
	if !found.Type.Identical(TypBool()) { return fail("Y type wrong") }

	var notFound @Field = s.FieldByName("Z")
	if !(notFound == nil) { return fail("Z should not be found") }
	return ""
}
