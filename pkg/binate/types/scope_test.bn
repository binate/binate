package "pkg/binate/types"

import "pkg/builtins/testing"

// ============================================================
// Scope & Symbol Tests
// ============================================================

func TestScope() testing.TestResult {
	var s @Scope = NewScope(nil)
	var sym @Symbol = make(Symbol)
	sym.Name = "x"
	sym.Type = TypInt()
	sym.Kind = SYM_VAR
	s.Define(sym)

	var found @Symbol = s.Lookup("x")
	if found == nil { return fail("lookup should find x") }
	if !found.Type.Identical(TypInt()) { return fail("x type wrong") }

	var notFound @Symbol = s.Lookup("y")
	if !(notFound == nil) { return fail("y should not be found") }
	return ""
}

func TestScopeParent() testing.TestResult {
	var parent @Scope = NewScope(nil)
	var sym @Symbol = make(Symbol)
	sym.Name = "x"
	sym.Type = TypInt()
	sym.Kind = SYM_VAR
	parent.Define(sym)

	var child @Scope = NewScope(parent)
	var found @Symbol = child.Lookup("x")
	if found == nil { return fail("should find x from parent") }

	// Shadow
	var sym2 @Symbol = make(Symbol)
	sym2.Name = "x"
	sym2.Type = TypBool()
	sym2.Kind = SYM_VAR
	child.Define(sym2)

	var shadowed @Symbol = child.Lookup("x")
	if !shadowed.Type.Identical(TypBool()) { return fail("child should shadow parent") }

	// Parent unchanged
	var parentSym @Symbol = parent.Lookup("x")
	if !parentSym.Type.Identical(TypInt()) { return fail("parent should be unchanged") }
	return ""
}

func TestFieldByName() testing.TestResult {
	var f1 @Field = make(Field)
	f1.Name = "X"
	f1.Type = TypInt()
	var f2 @Field = make(Field)
	f2.Name = "Y"
	f2.Type = TypBool()
	var fields @[]@Field = make_slice(@Field, 2)
	fields[0] = f1
	fields[1] = f2
	var s @Type = MakeStructType("Point", fields)

	var found @Field = s.FieldByName("Y")
	if found == nil { return fail("should find Y") }
	if !found.Type.Identical(TypBool()) { return fail("Y type wrong") }

	var notFound @Field = s.FieldByName("Z")
	if !(notFound == nil) { return fail("Z should not be found") }
	return ""
}

// scName builds a distinct 2-char name for index i ("aa","ab",…), so a test can
// define many collision-free symbols.  Valid for i in [0, 676).
func scName(i int) @[]char {
	var s @[]char = make_slice(char, 2)
	s[0] = cast(char, cast(int, 'a') + (i / 26))
	s[1] = cast(char, cast(int, 'a') + (i % 26))
	return s
}

// TestScopeHashActiveOverwriteAndGrow pins the HASH-ACTIVE path the linear tests
// above don't reach: defining > scopeHashThreshold (16) symbols activates symIndex
// and forces the table.Table to grow, and overwriting names in that mode exercises
// Define's re-Put (the borrow-key refresh that keeps the stored key pointing at the
// live replacement's Name rather than the freed old @Symbol's).
func TestScopeHashActiveOverwriteAndGrow() testing.TestResult {
	var s @Scope = NewScope(nil)
	var n int = 40
	for i := 0; i < n; i++ {
		var sym @Symbol = make(Symbol)
		sym.Name = scName(i)
		sym.Type = TypInt()
		sym.Kind = SYM_VAR
		s.Define(sym)
	}
	for i := 0; i < n; i++ {
		if s.Lookup(scName(i)) == nil {
			return fail("every name must resolve in a hash-active scope")
		}
	}
	if len(s.Syms) != n {
		return fail("n distinct names must yield n Syms entries")
	}
	// Overwrite one name in the active hash (fresh Name backing, equal content) —
	// the re-Put/key-refresh path; the old @Symbol is dropped.
	var repl @Symbol = make(Symbol)
	repl.Name = scName(5)
	repl.Type = TypBool()
	repl.Kind = SYM_VAR
	s.Define(repl)
	if len(s.Syms) != n {
		return fail("overwrite must not grow Syms")
	}
	var got @Symbol = s.Lookup(scName(5))
	if got == nil {
		return fail("overwritten name must still resolve")
	}
	if !got.Type.Identical(TypBool()) {
		return fail("overwrite must replace the symbol (Bool)")
	}
	// Overwrite every name (stress the refreshed keys across the table), then
	// confirm all still resolve to the replacement — a dangling key would miss here.
	for i := 0; i < n; i++ {
		var os @Symbol = make(Symbol)
		os.Name = scName(i)
		os.Type = TypInt()
		os.Kind = SYM_VAR
		s.Define(os)
	}
	for i := 0; i < n; i++ {
		var r @Symbol = s.Lookup(scName(i))
		if r == nil {
			return fail("all names must still resolve after mass overwrite")
		}
		if !r.Type.Identical(TypInt()) {
			return fail("overwrite must have taken effect for every name")
		}
	}
	if len(s.Syms) != n {
		return fail("mass overwrite must not grow Syms")
	}
	return ""
}
