package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/std/strings"

// Signature serialization for reflect.FunctionInfo.Sig.  The compiler renders each exported
// function's signature to a stable, opaque string and emits it as rodata in
// the per-package descriptor.  The VM never parses it in Phase B; it exists
// for signature-equality, debug, and the Phase-C / `.bni`-replacement hook.

// SigString renders a function-value type's signature to the canonical
// "(param0,param1,...)(result0,result1,...)" form, each type via
// QualifiedTypeName (path-qualified, so two same-short-named types from
// different packages stay distinct).  Called on a TYP_FUNC_VALUE /
// TYP_MANAGED_FUNC_VALUE; a void return renders as an empty result list "()".
//
// Stability: the encoding is deterministic (no addresses, no map iteration) so
// the emitted string is reproducible build-to-build — a requirement for a
// descriptor consumed by a separately-built VM.
//
// Limitation: array and func-value PARAM/RESULT types render via
// QualifiedTypeName's placeholders ("[...]" / "func(...)"), so two distinct
// array or nested-func signatures can collide.  Acceptable while Sig is opaque
// (Phase B never compares it); revisit if Phase C needs to distinguish them.
func (t @Type) SigString() @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.WriteByte('(')
	if t != nil {
		for i := 0; i < len(t.Params); i++ {
			if i > 0 { cb.WriteByte(',') }
			// A variadic final param renders as `...T` (the element type),
			// matching the source form; its stored Type is the `*[]T` body
			// type, so peel to the element.  Distinguishes a variadic from a
			// fixed-`*[]T` func in the reflect Sig (func.variadic.identity).
			if i == len(t.Params) - 1 && funcIsVariadic(t) {
				cb.Write("...")
				var elem @Type = t.Params[i].Type.SliceElem()
				if elem != nil {
					cb.Write(elem.QualifiedTypeName())
				} else {
					cb.Write(t.Params[i].Type.QualifiedTypeName())
				}
			} else {
				cb.Write(t.Params[i].Type.QualifiedTypeName())
			}
		}
	}
	cb.Write(")(")
	if t != nil {
		for i := 0; i < len(t.Results); i++ {
			if i > 0 { cb.WriteByte(',') }
			cb.Write(t.Results[i].QualifiedTypeName())
		}
	}
	cb.WriteByte(')')
	return buf.CopyStr(cb.String())
}
