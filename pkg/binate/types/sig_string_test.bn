package "pkg/binate/types"

import "pkg/builtins/testing"

// SigString renders a func-value type's signature as
// "(params)(results)" using each type's QualifiedTypeName.

// Scalars: (int64, bool) -> (int64).
func TestSigStringScalars() testing.TestResult {
	var params @[]@Param = make_slice(@Param, 2)
	var p0 @Param = make(Param)
	p0.Type = TypInt64()
	params[0] = p0
	var p1 @Param = make(Param)
	p1.Type = TypBool()
	params[1] = p1
	var results @[]@Type = make_slice(@Type, 1)
	results[0] = TypInt64()
	var fv @Type = MakeFuncValueType(params, results)
	if !charsEqSig(fv.SigString(), "(int64,bool)(int64)") {
		return "expected (int64,bool)(int64)"
	}
	return ""
}

// A void return (no results) renders an empty result list "()".
func TestSigStringVoidReturn() testing.TestResult {
	var params @[]@Param = make_slice(@Param, 1)
	var p0 @Param = make(Param)
	p0.Type = TypInt()
	params[0] = p0
	var results @[]@Type
	var fv @Type = MakeFuncValueType(params, results)
	if !charsEqSig(fv.SigString(), "(int)()") {
		return "expected (int)()"
	}
	return ""
}

// A composite param (managed pointer) delegates to QualifiedTypeName,
// which keeps the '@' prefix — confirms the delegation in this context.
func TestSigStringManagedPtr() testing.TestResult {
	var pt @Type = make(Type)
	pt.Kind = TYP_MANAGED_PTR
	pt.Elem = TypInt64()
	var params @[]@Param = make_slice(@Param, 1)
	var p0 @Param = make(Param)
	p0.Type = pt
	params[0] = p0
	var results @[]@Type
	var fv @Type = MakeFuncValueType(params, results)
	if !charsEqSig(fv.SigString(), "(@int64)()") {
		return "expected (@int64)()"
	}
	return ""
}

// A variadic final param renders as `...T` (the element type), distinct from a
// fixed `*[]T` param — so the reflect Sig distinguishes them (func.variadic.identity).
func TestSigStringVariadic() testing.TestResult {
	var params @[]@Param = make_slice(@Param, 1)
	var p0 @Param = make(Param)
	p0.Type = MakeSliceType(TypInt())
	p0.IsVariadic = true
	params[0] = p0
	var results @[]@Type
	var fv @Type = MakeFuncValueType(params, results)
	if !charsEqSig(fv.SigString(), "(...int)()") {
		return "expected (...int)() for a variadic param"
	}
	// The fixed *[]int form renders differently.
	var params2 @[]@Param = make_slice(@Param, 1)
	var p1 @Param = make(Param)
	p1.Type = MakeSliceType(TypInt())
	params2[0] = p1
	var fv2 @Type = MakeFuncValueType(params2, results)
	if charsEqSig(fv2.SigString(), fv.SigString()) {
		return "variadic and fixed *[]int Sig must differ"
	}
	return ""
}

// charsEqSig reports whether `a` equals the literal `b`.
func charsEqSig(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
