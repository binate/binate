package "pkg/binate/types"

// String literal type semantics:
//   - Natural type: [N]readonly char where N is the unescaped byte length.
//   - Default type (in inference contexts): @[]readonly char (a managed-slice
//     view into static data; refcount-exempt because the bytes live in
//     rodata).
// There is no `string` type in Binate.

// unescapedStrLen returns the byte count of a string literal's content
// after stripping surrounding quotes and processing escape sequences.
// Mirrors pkg/binate/ir/gen_util_literals.bn:unescapeStr but counts bytes
// instead of allocating the result.
func unescapedStrLen(s *[]readonly char) int {
	if len(s) >= 2 && s[0] == '"' && s[len(s) - 1] == '"' {
		s = s[1:len(s) - 1]
	}
	var n int = 0
	var i int = 0
	for i < len(s) {
		if s[i] == '\\' && i + 1 < len(s) {
			i = i + 1
			if s[i] == 'n' || s[i] == 'r' || s[i] == 't' || s[i] == '\\' || s[i] == '"' || s[i] == '0' {
				n = n + 1
				i = i + 1
				continue
			}
			if s[i] == 'x' && i + 2 < len(s) {
				n = n + 1
				i = i + 3
				continue
			}
			if s[i] == 'u' && i + 4 < len(s) {
				// `\u` expands to the UTF-8 encoding of its code point
				// (1-3 bytes), so the natural-type length counts those
				// bytes, not the six source characters.
				n = n + Utf8ByteLen(uEscapeCodePoint(s, i))
				i = i + 5
				continue
			}
			n = n + 1
			i = i + 1
		} else {
			n = n + 1
			i = i + 1
		}
	}
	return n
}

// isReadonlyCharArray reports whether t is a `[N]readonly char` array (TYP_ARRAY
// with a const-char element).  This is a RUNTIME array type — a string literal is
// untyped (TYP_UNTYPED_STRING), not this — so the AssignableTo arm that uses it
// governs the legal `[N]readonly char → [N]char` value-copy of a runtime array, not
// any string-literal decay.
func isReadonlyCharArray(t @Type) bool {
	t = peelOuterConstAndAlias(t)
	if t == nil { return false }
	if t.Kind != TYP_ARRAY { return false }
	var elem @Type
	var elemIsConst bool
	elem, elemIsConst = elemHasConst(t.Elem)
	if !isCharElem(elem) { return false }
	return elemIsConst
}

// defaultStringLitType returns the default type of a string literal in
// an inference context (e.g., `x := "..."` with no explicit target):
// @[]readonly char — a zero-copy managed-slice view into static data.
func defaultStringLitType() @Type {
	ensureInit()
	return MakeManagedSliceType(MakeReadonlyType(predeclaredUint8))
}

// makeUntypedString returns a fresh TYP_UNTYPED_STRING carrying the literal's
// unescaped byte length n.  Elem is `readonly char` so untypedStringNaturalArray
// can reconstruct the [n]readonly char natural type for the contexts that need it.
func makeUntypedString(n int) @Type {
	ensureInit()
	var t @Type = make(Type)
	t.Kind = TYP_UNTYPED_STRING
	t.Elem = MakeReadonlyType(predeclaredUint8)
	t.ArrayLen = n
	return t
}

// isUntypedString reports whether t is an untyped string literal
// (TYP_UNTYPED_STRING), peeling nothing — the kind is produced only for a bare
// string-literal expression and never wrapped.
func isUntypedString(t @Type) bool {
	return t != nil && t.Kind == TYP_UNTYPED_STRING
}

// untypedStringNaturalArray reconstructs the [N]readonly char array type an
// untyped string adopts in a context that needs a concrete array (comparison,
// indexing, a constant `len`).  N and the readonly-char element are carried on
// the untyped type.
func untypedStringNaturalArray(t @Type) @Type {
	ensureInit()
	if t == nil || t.Kind != TYP_UNTYPED_STRING {
		return t
	}
	return MakeArrayType(t.Elem, t.ArrayLen)
}
