package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for string-literal type semantics:
//   - natural type: [N]readonly char
//   - default type (inference): @[]readonly char
//   - assignability rules from the natural type
// See string_lit.bn for the productions; types.bn for the AssignableTo
// rules that consume them.

// unescapedStrLen counts bytes after escape processing.
func TestUnescapedStrLenSimple() testing.TestResult {
	if unescapedStrLen("\"hello\"") != 5 {
		return fail("len(\"hello\") should be 5")
	}
	return ""
}

func TestUnescapedStrLenEmpty() testing.TestResult {
	if unescapedStrLen("\"\"") != 0 {
		return fail("len(\"\") should be 0")
	}
	return ""
}

func TestUnescapedStrLenEscapes() testing.TestResult {
	// \n \t \\ \" \0 each count as 1 byte.
	if unescapedStrLen("\"a\\nb\\tc\"") != 5 {
		return fail("\\n and \\t each = 1 byte")
	}
	if unescapedStrLen("\"\\x41\"") != 1 {
		return fail("\\xNN = 1 byte")
	}
	return ""
}

// StringLitNaturalType returns [N]readonly char.
func TestStringLitNaturalTypeShape() testing.TestResult {
	var t @Type = StringLitNaturalType("\"abcde\"")
	if t == nil || t.Kind != TYP_ARRAY {
		return fail("natural type should be array")
	}
	if t.ArrayLen != 5 {
		return fail("ArrayLen should be 5")
	}
	if t.Elem == nil || t.Elem.Kind != TYP_READONLY {
		return fail("element should be readonly-wrapped")
	}
	var inner @Type = t.Elem.Elem
	if inner == nil || inner.Kind != TYP_INT || inner.Width != 8 || inner.Signed {
		return fail("inner element should be uint8")
	}
	return ""
}

// isStringLitNaturalType matches the natural shape.
func TestIsStringLitNaturalTypeMatches() testing.TestResult {
	var t @Type = StringLitNaturalType("\"hello\"")
	if !isStringLitNaturalType(t) {
		return fail("natural type should be recognized")
	}
	// Also matches user-written [N]readonly char.
	var u @Type = MakeArrayType(MakeReadonlyType(TypChar()), 3)
	if !isStringLitNaturalType(u) {
		return fail("[3]readonly char should be recognized")
	}
	return ""
}

// isStringLitNaturalType rejects non-matching shapes.
func TestIsStringLitNaturalTypeRejects() testing.TestResult {
	if isStringLitNaturalType(MakeArrayType(TypChar(), 3)) {
		return fail("[3]char (no readonly) should NOT match")
	}
	if isStringLitNaturalType(MakeArrayType(MakeReadonlyType(TypInt()), 3)) {
		return fail("[3]readonly int should NOT match")
	}
	if isStringLitNaturalType(MakeSliceType(MakeReadonlyType(TypChar()))) {
		return fail("*[]readonly char (slice, not array) should NOT match")
	}
	return ""
}

// defaultStringLitType returns @[]readonly char.
func TestDefaultStringLitType() testing.TestResult {
	var t @Type = defaultStringLitType()
	if t == nil || t.Kind != TYP_MANAGED_SLICE {
		return fail("default should be managed-slice")
	}
	if t.Elem == nil || t.Elem.Kind != TYP_READONLY {
		return fail("element should be readonly-wrapped")
	}
	return ""
}

// [N]readonly char → @[]readonly char is allowed (zero-copy borrow).
func TestStringLitAssignToManagedReadonlySlice() testing.TestResult {
	var src @Type = StringLitNaturalType("\"abc\"")
	var dst @Type = MakeManagedSliceType(MakeReadonlyType(TypChar()))
	if !src.AssignableTo(nil, dst) {
		return fail("[3]readonly char → @[]readonly char")
	}
	return ""
}

// [N]readonly char → *[]readonly char is allowed (zero-copy raw borrow).
func TestStringLitAssignToRawReadonlySlice() testing.TestResult {
	var src @Type = StringLitNaturalType("\"abc\"")
	var dst @Type = MakeSliceType(MakeReadonlyType(TypChar()))
	if !src.AssignableTo(nil, dst) {
		return fail("[3]readonly char → *[]readonly char")
	}
	return ""
}

// [N]readonly char → @[]char is allowed (literal-init copy).
func TestStringLitAssignToManagedMutableSlice() testing.TestResult {
	var src @Type = StringLitNaturalType("\"abc\"")
	var dst @Type = MakeManagedSliceType(TypChar())
	if !src.AssignableTo(nil, dst) {
		return fail("[3]readonly char → @[]char")
	}
	return ""
}

// [N]readonly char → *[]char is REJECTED (raw mutable borrow of rodata).
func TestStringLitRejectsRawMutableSlice() testing.TestResult {
	var src @Type = StringLitNaturalType("\"abc\"")
	var dst @Type = MakeSliceType(TypChar())
	if src.AssignableTo(nil, dst) {
		return fail("[3]readonly char → *[]char should NOT be assignable")
	}
	return ""
}

// [N]readonly char → [M]char (length match) drops outer element readonly.
// Allowed because the array is value-copied.
func TestStringLitAssignToMutableArray() testing.TestResult {
	var src @Type = StringLitNaturalType("\"abc\"")
	var dst @Type = MakeArrayType(TypChar(), 3)
	if !src.AssignableTo(nil, dst) {
		return fail("[3]readonly char → [3]char (length match)")
	}
	return ""
}

// [N]readonly char → [M]char with N != M is rejected.
func TestStringLitRejectsArrayLengthMismatch() testing.TestResult {
	var src @Type = StringLitNaturalType("\"abc\"")
	var dst @Type = MakeArrayType(TypChar(), 5)
	if src.AssignableTo(nil, dst) {
		return fail("[3]readonly char → [5]char should NOT be assignable")
	}
	return ""
}

// [N]readonly char → @[]int (non-char element) is rejected.
func TestStringLitRejectsNonCharSlice() testing.TestResult {
	var src @Type = StringLitNaturalType("\"abc\"")
	var dst @Type = MakeManagedSliceType(TypInt())
	if src.AssignableTo(nil, dst) {
		return fail("[3]readonly char → @[]int should NOT be assignable")
	}
	return ""
}
