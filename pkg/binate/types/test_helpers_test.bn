package "pkg/binate/types"

import "pkg/builtins/testing"

// fail builds a failing TestResult carrying the given message — the shared
// assertion helper for this package's tests.
func fail(msg @[]char) testing.TestResult {
	return msg
}

func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}
