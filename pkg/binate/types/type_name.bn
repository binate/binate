package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/std/strings"
import "pkg/std/vec"

// Type-name formatting: the user-facing DISPLAY name (TypeName — leaf-only
// for a path-qualified named struct) vs the FULLY-QUALIFIED name used for
// mangling and cross-package identity (QualifiedTypeName).

// TypeName returns the user-facing DISPLAY name of a type — for a named
// struct the package-path prefix is stripped (errors read "Package", not
// "pkg/binate/loader.Package").  For anything that keys a symbol or a
// cross-package identity comparison, use QualifiedTypeName instead.
func (t @Type) TypeName() @[]char {
	return t.typeNameImpl(true)
}

// QualifiedTypeName returns the FULLY-QUALIFIED name used for mangling and
// identity: a named struct keeps its path-dotted name verbatim, so two
// same-short-named structs from different packages never collide as symbols
// nor falsely compare equal.
func (t @Type) QualifiedTypeName() @[]char {
	return t.typeNameImpl(false)
}

// typeNameImpl formats a type's name.  short=true strips a named type's
// package-path prefix (display); short=false keeps it (mangling/identity).
// Composite types are written part by part from nameStack, not by recursion, so a
// type of any depth is named.
func (t @Type) typeNameImpl(short bool) @[]char {
	name, leaf := leafTypeName(t, short)
	if leaf { return name }
	if nameStack == nil { nameStack = vec.New[namePart]() }
	var base int = nameStack.Len()
	var cb @strings.Builder = strings.NewBuilder()
	writeTypeName(cb, t, short)
	for nameStack.Len() > base {
		p, _ := nameStack.Pop()
		if p.isType {
			writeTypeName(cb, p.t, short)
		} else {
			cb.Write(p.text)
		}
	}
	return buf.CopyStr(cb.String())
}

// namePart is a piece of a type's name still to write: the name of type t (isType),
// or text.
type namePart struct {
	isType bool
	t      @Type
	text   *[]readonly char
}

// nameStack holds the pieces of the names being written (typeNameImpl), the next one
// last, kept from one name to the next; a name leaves it as it found it.
var nameStack @vec.Vec[namePart]

// pushNameType pushes the name of t to write later.
func pushNameType(t @Type) {
	var p namePart
	p.isType = true
	p.t = t
	nameStack.Push(p)
}

// pushNameText pushes text to write later.  It must outlive the name's writing.
func pushNameText(text *[]readonly char) {
	var p namePart
	p.text = text
	nameStack.Push(p)
}

// leafTypeName returns t's name, and true, when it is written whole: nil, a named type,
// an interface, or any type with a name but an anonymous struct.  Any other type's
// name is written from its parts (writeTypeName).
func leafTypeName(t @Type, short bool) (@[]char, bool) {
	var none @[]char
	if t == nil { return "nil", true }
	// An anonymous struct has no user-given name — the checker leaves `.Name` EMPTY,
	// and IR-gen assigns an occurrence-ordered `__anon_<N>` (neither a meaningful nor
	// a TU-invariant display name).  Render it from its FIELDS as `struct { … }` so
	// %T / panics / diagnostics read meaningfully (rather than `<unknown>`) and
	// the RTTI record's name word is a TU-invariant pure function of structure.  A
	// NAMED struct (a real `.Name`) keeps the nominal name below.
	if t.Kind == TYP_STRUCT && (len(t.Name) == 0 || startsWithAnonPrefix(t.Name)) {
		return none, false
	}
	// An interface keeps its package apart (`.Pkg`; `.Name` is the bare leaf,
	// unlike a named struct's already-qualified name), so the identity form
	// qualifies it: two packages' `P` are different interfaces, and a key built
	// from the bare leaf — an instantiation's mangled type argument (`H[*a.P]`
	// vs `H[*b.P]`), a checker instantiation key, a signature string — would
	// make them one.  The universe `any` has no package.
	// A named type likewise: the checker keeps a named type's package in
	// `.Pkg` (its `.Name` is the bare leaf), so its identity form is the two
	// qualified — two packages' `type T int` are different types (an IR-gen
	// named type's `.Name` is already qualified, with no `.Pkg`).  Its OWN name:
	// never its underlying struct's, or `type N S` would name S.
	if t.Kind == TYP_NAMED && !short && len(t.Name) > 0 { return QualifyName(t.Pkg, t.Name), true }
	if t.Kind == TYP_INTERFACE && !short && len(t.Pkg) > 0 && len(t.Name) > 0 {
		var qb @strings.Builder = strings.NewBuilder()
		qb.Write(t.Pkg)
		qb.WriteByte('.')
		qb.Write(t.Name)
		return buf.CopyStr(qb.String()), true
	}
	if len(t.Name) > 0 {
		if short { return displayLeafName(t.Name), true }
		return t.Name, true
	}
	return none, false
}

// writeTypeName writes what of t's name comes first into cb, and pushes the rest --
// last piece first, so the pieces pop in order.
func writeTypeName(cb @strings.Builder, t @Type, short bool) {
	name, leaf := leafTypeName(t, short)
	if leaf {
		cb.Write(name)
		return
	}
	if t.Kind == TYP_STRUCT {
		// An anonymous one: a struct with a name is written whole.
		writeAnonStructName(cb, t)
		return
	}
	if t.Kind == TYP_POINTER || t.Kind == TYP_INTERFACE_VALUE {
		cb.WriteByte('*')
		pushNameType(t.Elem)
		return
	}
	if t.Kind == TYP_MANAGED_PTR || t.Kind == TYP_INTERFACE_VALUE_MANAGED {
		cb.WriteByte('@')
		pushNameType(t.Elem)
		return
	}
	if t.Kind == TYP_SLICE {
		cb.Write("*[]")
		pushNameType(t.Elem)
		return
	}
	if t.Kind == TYP_MANAGED_SLICE {
		cb.Write("@[]")
		pushNameType(t.Elem)
		return
	}
	if t.Kind == TYP_UNTYPED_STRING {
		// Render an untyped string literal by its natural [N]readonly uint8 shape —
		// the concrete form a diagnostic ("cannot assign [3]readonly uint8 to …")
		// reads naturally.  It never reaches mangleInstantiatedName (a literal is
		// always adopted to a concrete type before instantiation), so there is no
		// type-confusion concern here.
		pushNameType(UntypedStringNaturalArray(t))
		return
	}
	if t.Kind == TYP_ARRAY {
		// Render the length AND element ([N]T), not a non-distinct "[...]": as with
		// func-value types, QualifiedTypeName feeds mangleInstantiatedName, so a
		// placeholder would conflate Box[[3]int], Box[[5]int], Box[[3]bool] into one
		// instantiation (silent type confusion).
		cb.WriteByte('[')
		stringutils.WriteInt64(cb, t.ArrayLen)
		cb.WriteByte(']')
		pushNameType(t.Elem)
		return
	}
	// Function types and function-VALUE types render their full signature, not a
	// `func(...)` placeholder: QualifiedTypeName feeds mangleInstantiatedName, so a
	// non-distinct name would make `Box[@func(int)uint]` and `Box[@func(bool)uint]`
	// the SAME instantiation (a type-confusion bug).  The func-value kinds carry the
	// `*`/`@` prefix that distinguishes a raw from a managed function value.
	if t.Kind == TYP_FUNC || t.Kind == TYP_FUNC_VALUE || t.Kind == TYP_MANAGED_FUNC_VALUE {
		if t.Kind == TYP_FUNC_VALUE {
			cb.WriteByte('*')
		} else if t.Kind == TYP_MANAGED_FUNC_VALUE {
			cb.WriteByte('@')
		}
		cb.Write("func(")
		pushSignatureName(t)
		return
	}
	if t.Kind == TYP_READONLY {
		cb.Write("readonly ")
		pushNameType(t.Elem)
		return
	}
	if t.Kind == TYP_TUPLE {
		cb.WriteByte('(')
		pushNameText(")")
		for i := len(t.Results) - 1; i >= 0; i-- {
			pushNameType(t.Results[i])
			if i > 0 { pushNameText(", ") }
		}
		return
	}
	cb.Write("<unknown>")
}

// pushSignatureName pushes the rest of function type t's name after `func(`: its
// parameters, `)` and its results.  A variadic parameter's stored type is the *[]T
// slice body; it is written in the source form `...T` by peeling to the element
// (matching SigString).
func pushSignatureName(t @Type) {
	if len(t.Results) == 1 {
		pushNameType(t.Results[0])
	} else if len(t.Results) > 1 {
		pushNameText(")")
		for i := len(t.Results) - 1; i >= 0; i-- {
			pushNameType(t.Results[i])
			if i > 0 { pushNameText(",") }
		}
		pushNameText("(")
	}
	pushNameText(")")
	for i := len(t.Params) - 1; i >= 0; i-- {
		if t.Params[i].IsVariadic {
			var elem @Type = t.Params[i].Type.SliceElem()
			if elem != nil {
				pushNameType(elem)
			} else {
				pushNameType(t.Params[i].Type)
			}
			pushNameText("...")
		} else {
			pushNameType(t.Params[i].Type)
		}
		if i > 0 { pushNameText(",") }
	}
}

// startsWithAnonPrefix reports whether `name` is the compiler-synthesized
// anonymous-struct name (`__anon_<N>`, assigned by IR-gen), as opposed to a
// user-written nominal name.  (An anonymous struct is otherwise EMPTY-named in the
// checker; both spellings render as `struct { … }`.)
func startsWithAnonPrefix(name *[]readonly char) bool {
	var pfx *[]readonly char = "__anon_"
	if len(name) < len(pfx) { return false }
	for i := 0; i < len(pfx); i++ {
		if name[i] != pfx[i] { return false }
	}
	return true
}

// writeAnonStructName writes an anonymous struct's name from its fields as
// `struct { f0 t0; f1 t1 }` (`struct {}` when field-less), the field types pushed, so
// the whole rendering is a pure function of the nested structure — TU-invariant,
// as the RTTI name word needs.
func writeAnonStructName(cb @strings.Builder, t @Type) {
	cb.Write("struct {")
	if len(t.Fields) > 0 { pushNameText(" }") } else { pushNameText("}") }
	for i := len(t.Fields) - 1; i >= 0; i-- {
		pushNameType(t.Fields[i].Type)
		pushNameText(" ")
		pushNameText(t.Fields[i].Name)
		if i > 0 { pushNameText("; ") } else { pushNameText(" ") }
	}
}

// displayLeafName strips package-path prefixes from a (possibly mangled)
// type name for display: each `pkg/path.Leaf` segment becomes `Leaf`,
// including segments nested inside an instantiated generic name's type
// arguments.  So `main.Box[@pkg/foo.Pair[bool,bool]]` displays as
// `Box[@Pair[bool,bool]]` rather than splitting on the first '.' (which
// lands inside the bracketed argument and drops the leading `Box[@` —
// the source of a dangling-bracket display).
//
// A '.' is a package/name separator only when it follows a path segment
// and precedes an identifier start, so the '...' in an array/func
// placeholder (`[...]`, `func(...)`) is preserved.  Type-syntax
// delimiters (`[ ] , @ * ( )` and the space in `readonly X`) end a
// segment; the run of path chars before a separating '.' is dropped.
func displayLeafName(name @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	var segStart int = 0
	for i := 0; i < len(name); i++ {
		var c char = name[i]
		if c == '.' && i + 1 < len(name) && isIdentStartChar(name[i + 1]) {
			// Package-path separator: drop this segment's prefix.
			segStart = i + 1
		} else if isTypeNameDelim(c) {
			cb.Write(name[segStart:i])
			cb.WriteByte(c)
			segStart = i + 1
		}
	}
	cb.Write(name[segStart:])
	return buf.CopyStr(cb.String())
}

// isTypeNameDelim reports whether c ends a name segment in a mangled
// type-name string (so the package-path strip in displayLeafName
// applies per-segment, not just to the leading segment).
func isTypeNameDelim(c char) bool {
	return c == '[' || c == ']' || c == ',' || c == '@' || c == '*' || c == ' ' || c == '(' || c == ')'
}

// isIdentStartChar reports whether c can begin an identifier (a type or
// package name) — used to distinguish a package-path separator '.' from
// the '.' runs in a `[...]` / `func(...)` placeholder.
func isIdentStartChar(c char) bool {
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}
