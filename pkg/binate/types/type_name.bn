package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/std/strings"

// Type-name formatting: the user-facing DISPLAY name (TypeName — leaf-only
// for a path-qualified named struct) vs the FULLY-QUALIFIED name used for
// mangling and cross-package identity (QualifiedTypeName).

// TypeName returns the user-facing DISPLAY name of a type — for a named
// struct the package-path prefix is stripped (errors read "Package", not
// "pkg/binate/loader.Package").  For anything that keys a symbol or a
// cross-package identity comparison, use QualifiedTypeName instead.
func (t @Type) TypeName() @[]char {
	return t.typeNameImpl(true)
}

// QualifiedTypeName returns the FULLY-QUALIFIED name used for mangling and
// identity: a named struct keeps its path-dotted name verbatim, so two
// same-short-named structs from different packages never collide as symbols
// nor falsely compare equal.
func (t @Type) QualifiedTypeName() @[]char {
	return t.typeNameImpl(false)
}

// typeNameImpl formats a type's name.  short=true strips a named type's
// package-path prefix (display); short=false keeps it (mangling/identity).
// Composite cases recurse with the same flag.
func (t @Type) typeNameImpl(short bool) @[]char {
	if t == nil {
		return "nil"
	}
	if len(t.Name) > 0 {
		if short {
			return displayLeafName(t.Name)
		}
		return t.Name
	}
	if t.Kind == TYP_POINTER {
		var cb @strings.Builder = strings.NewBuilder()
		cb.WriteByte('*')
		cb.Write(t.Elem.typeNameImpl(short))
		return buf.CopyStr(cb.String())
	}
	if t.Kind == TYP_MANAGED_PTR {
		var cb @strings.Builder = strings.NewBuilder()
		cb.WriteByte('@')
		cb.Write(t.Elem.typeNameImpl(short))
		return buf.CopyStr(cb.String())
	}
	if t.Kind == TYP_SLICE {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("*[]")
		cb.Write(t.Elem.typeNameImpl(short))
		return buf.CopyStr(cb.String())
	}
	if t.Kind == TYP_MANAGED_SLICE {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("@[]")
		cb.Write(t.Elem.typeNameImpl(short))
		return buf.CopyStr(cb.String())
	}
	if t.Kind == TYP_ARRAY {
		return "[...]"
	}
	if t.Kind == TYP_FUNC {
		return "func(...)"
	}
	if t.Kind == TYP_READONLY {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("readonly ")
		cb.Write(t.Elem.typeNameImpl(short))
		return buf.CopyStr(cb.String())
	}
	if t.Kind == TYP_INTERFACE_VALUE {
		var cb @strings.Builder = strings.NewBuilder()
		cb.WriteByte('*')
		cb.Write(t.Elem.typeNameImpl(short))
		return buf.CopyStr(cb.String())
	}
	if t.Kind == TYP_INTERFACE_VALUE_MANAGED {
		var cb @strings.Builder = strings.NewBuilder()
		cb.WriteByte('@')
		cb.Write(t.Elem.typeNameImpl(short))
		return buf.CopyStr(cb.String())
	}
	return "<unknown>"
}

// displayLeafName strips package-path prefixes from a (possibly mangled)
// type name for display: each `pkg/path.Leaf` segment becomes `Leaf`,
// including segments nested inside an instantiated generic name's type
// arguments.  So `main.Box[@pkg/foo.Pair[bool,bool]]` displays as
// `Box[@Pair[bool,bool]]` rather than splitting on the first '.' (which
// lands inside the bracketed argument and drops the leading `Box[@` —
// the source of a dangling-bracket display).
//
// A '.' is a package/name separator only when it follows a path segment
// and precedes an identifier start, so the '...' in an array/func
// placeholder (`[...]`, `func(...)`) is preserved.  Type-syntax
// delimiters (`[ ] , @ * ( )` and the space in `readonly X`) end a
// segment; the run of path chars before a separating '.' is dropped.
func displayLeafName(name @[]char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	var segStart int = 0
	for i := 0; i < len(name); i++ {
		var c char = name[i]
		if c == '.' && i + 1 < len(name) && isIdentStartChar(name[i + 1]) {
			// Package-path separator: drop this segment's prefix.
			segStart = i + 1
		} else if isTypeNameDelim(c) {
			cb.Write(name[segStart:i])
			cb.WriteByte(c)
			segStart = i + 1
		}
	}
	cb.Write(name[segStart:])
	return buf.CopyStr(cb.String())
}

// isTypeNameDelim reports whether c ends a name segment in a mangled
// type-name string (so the package-path strip in displayLeafName
// applies per-segment, not just to the leading segment).
func isTypeNameDelim(c char) bool {
	return c == '[' || c == ']' || c == ',' || c == '@' ||
		c == '*' || c == ' ' || c == '(' || c == ')'
}

// isIdentStartChar reports whether c can begin an identifier (a type or
// package name) — used to distinguish a package-path separator '.' from
// the '.' runs in a `[...]` / `func(...)` placeholder.
func isIdentStartChar(c char) bool {
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}
