package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for the type-name formatting in type_name.bn: TypeName (short
// DISPLAY name) vs QualifiedTypeName (path-qualified mangling/identity),
// the composite recursion, and the displayLeafName prefix strip.  Helpers
// `fail` / `streq` live in types_test.bn (sibling file).

func TestTypeName() testing.TestResult {
	if !streq(TypInt().TypeName(), "int") { return fail("int name") }
	if !streq(TypBool().TypeName(), "bool") { return fail("bool name") }
	if !streq(MakePointerType(TypInt()).TypeName(), "*int") { return fail("*int name") }
	if !streq(MakeManagedPtrType(TypInt()).TypeName(), "@int") { return fail("@int name") }
	if !streq(MakeSliceType(TypInt()).TypeName(), "*[]int") { return fail("*[]int name") }
	// A nil @Type dispatches to TypeName's `t == nil` branch (returns "nil").
	// This must hold in every mode, including the bytecode VM — method dispatch
	// through a nil managed pointer must reach the body without faulting.
	var nilType @Type
	if !streq(nilType.TypeName(), "nil") { return fail("nil @Type name") }
	return ""
}

// A path-qualified named struct: TypeName strips the package-path prefix
// for display while QualifiedTypeName keeps it for mangling/identity, and
// the distinction recurses through composites.
func TestTypeNameDisplayVsQualified() testing.TestResult {
	var noFields @[]@Field = make_slice(@Field, 0)
	var s @Type = MakeStructType("pkg/foo.Bar", noFields)
	if !streq(s.TypeName(), "Bar") {
		return fail("display name must strip the package-path prefix")
	}
	if !streq(s.QualifiedTypeName(), "pkg/foo.Bar") {
		return fail("qualified name must keep the path-dotted form")
	}
	// A composite over a qualified struct: prefix stripped only in display.
	var mp @Type = MakeManagedPtrType(s)
	if !streq(mp.TypeName(), "@Bar") {
		return fail("@-display must strip the prefix")
	}
	if !streq(mp.QualifiedTypeName(), "@pkg/foo.Bar") {
		return fail("@-qualified must keep the path")
	}
	// A bare (already-short) name is unchanged by display.
	var b @Type = MakeStructType("Plain", noFields)
	if !streq(b.TypeName(), "Plain") {
		return fail("bare name must be unchanged in display")
	}
	return ""
}

// displayLeafName must strip the package-path prefix of EVERY segment of
// a mangled instantiated-generic name, including names nested inside the
// `[...]` type-argument, not just the leading segment.  Splitting on the
// first '.' would land inside the bracket and drop the `Box[@` prefix,
// leaving a dangling bracket (`Pair[bool,bool]]`).
func TestDisplayLeafNameNestedGenericArgs() testing.TestResult {
	// base qualified, nested arg qualified with a multi-segment path.
	if !streq(displayLeafName(
			"main.Box[@pkg/foo.Pair[bool,bool]]"), "Box[@Pair[bool,bool]]") {
		return fail("nested qualified generic arg must strip every prefix")
	}
	// base unqualified, arg qualified — the original first-'.' bug case.
	if !streq(displayLeafName("Box[@main.Pair[bool,bool]]"), "Box[@Pair[bool,bool]]") {
		return fail("unqualified base with qualified arg must not drop base")
	}
	// readonly arg (the space delimiter) + qualified element.
	if !streq(displayLeafName("Holder[readonly pkg/foo.Item]"), "Holder[readonly Item]") {
		return fail("readonly-qualified arg must strip the path")
	}
	// array placeholder's '...' must survive (no ident-start after '.').
	if !streq(displayLeafName("Box[[...]]"), "Box[[...]]") {
		return fail("array placeholder dots must be preserved")
	}
	// plain qualified leaf — unchanged behavior.
	if !streq(displayLeafName("pkg/binate/loader.Package"), "Package") {
		return fail("plain qualified leaf must strip to the leaf")
	}
	return ""
}

// An anonymous struct (empty checker name OR the synthetic `__anon_<N>` IR name)
// renders from its FIELDS as `struct { … }` — a readable, TU-invariant name for %T
// / diagnostics / the RTTI name word — not `<unknown>` / `__anon_N`.  A NAMED struct
// is unaffected.
func TestTypeNameAnonStruct() testing.TestResult {
	var fx @Field = make(Field)
	fx.Name = "x"
	fx.Type = TypInt()
	var fy @Field = make(Field)
	fy.Name = "y"
	fy.Type = TypBool()
	var flds @[]@Field = make_slice(@Field, 2)
	flds[0] = fx
	flds[1] = fy
	// Checker form (empty name) and IR form (`__anon_<N>`) render identically —
	// TU-invariantly — from the fields.
	if !streq(MakeStructType("", flds).TypeName(), "struct { x int; y bool }") {
		return fail("empty-name anon struct should render struct { … }")
	}
	if !streq(MakeStructType("__anon_3", flds).QualifiedTypeName(), "struct { x int; y bool }") {
		return fail("__anon_<N> struct should render struct { … }")
	}
	// A field-less anon struct renders `struct {}`.
	var noFields @[]@Field = make_slice(@Field, 0)
	if !streq(MakeStructType("", noFields).TypeName(), "struct {}") {
		return fail("field-less anon struct should render struct {}")
	}
	// A NAMED struct keeps its nominal name.
	if !streq(MakeStructType("main.Pt", flds).TypeName(), "Pt") {
		return fail("a named struct must keep its nominal name")
	}
	return ""
}

// A call's result tuple names its results in order, and is identical (or
// strictly identical, `readonly` counted) to another tuple exactly when its
// results are.
func TestTupleTypeNameAndIdentity() testing.TestResult {
	var ib @[]@Type = make_slice(@Type, 2)
	ib[0] = TypInt()
	ib[1] = TypBool()
	var t @Type = MakeTupleType(ib)
	if !streq(t.TypeName(), "(int, bool)") { return fail("tuple name") }
	var ib2 @[]@Type = make_slice(@Type, 2)
	ib2[0] = TypInt()
	ib2[1] = TypBool()
	if !t.Identical(MakeTupleType(ib2)) { return fail("same results are identical") }
	if !t.IdenticalStrict(MakeTupleType(ib2)) { return fail("same results are strictly identical") }
	var bi @[]@Type = make_slice(@Type, 2)
	bi[0] = TypBool()
	bi[1] = TypInt()
	if t.Identical(MakeTupleType(bi)) { return fail("different order is not identical") }
	var three @[]@Type = make_slice(@Type, 3)
	three[0] = TypInt()
	three[1] = TypBool()
	three[2] = TypInt()
	if t.Identical(MakeTupleType(three)) { return fail("different count is not identical") }
	var rb @[]@Type = make_slice(@Type, 2)
	rb[0] = MakeReadonlyType(TypInt())
	rb[1] = TypBool()
	if !t.Identical(MakeTupleType(rb)) { return fail("a readonly result is identical, not strictly") }
	if t.IdenticalStrict(MakeTupleType(rb)) {
		return fail("a readonly result is not strictly identical")
	}
	return ""
}
