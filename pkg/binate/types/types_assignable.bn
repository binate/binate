package "pkg/binate/types"

import "pkg/binate/bignum"

// Assignability rules: AssignableTo and the interface-value
// assignability helpers it dispatches into. Extracted from
// types_query.bn so that file stays under the hygiene length cap;
// the predicates / structural identity / element accessors stay in
// types_query.bn.

// AssignableTo reports whether a value of type src can be assigned to type dst.
// Const rule (Stage 1): widening is allowed (`T → const T`), narrowing is not
// (`const T → T` requires an explicit `cast`). Const-drop is detected
// structurally at any position — e.g., `*readonly T → *T` is rejected because
// the pointer's element type loses const.
func (src @Type) AssignableTo(c @Checker, dst @Type) bool {
	// String literal natural type → array target with matching length.
	// Checked before the generic Identical+dropsConst path because
	// `[N]readonly char → [N]char` is structurally identical (mod const)
	// but drops element-level const — which would otherwise be rejected.
	// The drop is safe here because arrays are value-copied, so the
	// destination is a fresh independent array. Slice/raw-slice targets
	// are handled later (those decay paths don't intersect Identical).
	//
	// LENGTH MATCH IS EXACT here: a `[N]readonly char` type is the natural
	// type of a string literal AND of any user-written `[N]readonly char`
	// VALUE (indistinguishable — isStringLitNaturalType), so a length-loose
	// rule here would silently zero-pad a runtime array into a larger one.
	// The shorter-literal-into-larger-buffer init (zero-padded) is a
	// string-LITERAL feature, gated on the source EXPRESSION being a string
	// literal — see stringLitInitFitsArray and its use at the var-decl /
	// struct-literal sites.
	ensureInit()
	// Error sentinel: an expression whose type error was already reported is
	// assignable to (and from) anything, so the surrounding assignment /
	// return / arg check doesn't pile a follow-on "cannot assign <error>"
	// onto the primary diagnostic.  TYP_VOID is deliberately NOT treated this
	// way -- a real void-returning call assigned to a value is a genuine error
	// worth reporting (the distinction TYP_ERROR exists to preserve).
	if src.Kind == TYP_ERROR || dst.Kind == TYP_ERROR {
		return true
	}
	if isStringLitNaturalType(src) && isStringWritableArrayTarget(dst) && arrayLengthsMatch(src, dst) {
		return true
	}

	// Distinct named integer types (int, int8, …, int64, and their unsigned
	// counterparts) do NOT inter-assign without an explicit cast, even when they
	// share width + signedness (`int` == `int64` on a 64-bit target).  Without
	// this gate `var x int64 = anInt` would silently compile; Go requires
	// `int64(anInt)`.  Untyped int constants still coerce (handled below).
	if distinctNamedInts(src, dst) {
		return false
	}

	if src.Identical(dst) {
		// `Identical` is const-transparent, so types that differ only
		// in const at some position still match here. Reject if the
		// difference is a narrowing (const present in src but not in
		// the corresponding dst position).
		if dropsConst(src, dst) {
			return false
		}
		return true
	}

	// Untyped constants assignable to their concrete counterparts.
	// When the literal's value is known (HasLitVal), also require it
	// to fit the target type's range — `var x uint8 = 256` rejects
	// here, `var x uint8 = 255` accepts.  Per claude-notes.md §
	// "Integer literal value range and constant-expression
	// arithmetic — DECIDED 2026-05-15".
	if src != nil && src.Kind == TYP_UNTYPED_INT {
		if !dst.IsInteger() { return false }
		if src.HasLitVal { return untypedIntLitFitsTarget(src, dst) }
		return true
	}
	if src != nil && src.Kind == TYP_UNTYPED_FLOAT {
		return dst.IsFloat()
	}
	if src != nil && src.Kind == TYP_UNTYPED_BOOL {
		return dst.IsBool()
	}
	// An untyped string literal adopts a char-slice or char-array target.  This is
	// type-only yet SAFE (unlike the removed runtime-array→slice decay): the kind is
	// produced ONLY for a bare string-literal expression, so a runtime [N]readonly
	// char array (a TYP_ARRAY) can never reach it.
	if src != nil && src.Kind == TYP_UNTYPED_STRING {
		return untypedStringAssignableTo(src, dst)
	}

	// Named-distinct transparency (Go's assignability rule): exactly one
	// side is a named-distinct type whose CONCRETE underlying is an unnamed
	// composite (slice / pointer / array / struct / func-value).  Recurse on
	// that side's immediate Underlying so the existing Identical / const-drop
	// / decay logic applies unchanged (this preserves readonly protection —
	// we never strip readonly before the const check).  A scalar/named
	// underlying (`type Celsius float64` ↔ `float64`) or two named types fall
	// through → a `cast` is required.
	//
	// Resolve a transparent alias off each side first (an alias IS its target), so
	// an alias to a named-distinct type — `type Ali = pkg.Named`, e.g.
	// `testing.TestResult = testing/sys.TestResult` — is treated as that named type
	// here.  Without the peel the TYP_NAMED test misses an alias-to-named (its Kind
	// is TYP_ALIAS), and a `"lit" -> Ali` / `@[]T -> Ali` assignment is wrongly
	// rejected: the string/slice-target fallbacks below peel the alias but not the
	// named underneath (peelOuterConstAndAlias / resolveAliasAndConst stop at the
	// named).  The direct `pkg.Named` case already reaches this arm; the peel just
	// extends the same handling to an alias for it.
	var srcN @Type = src.ResolveAlias()
	var dstN @Type = dst.ResolveAlias()
	if srcN != nil && dstN != nil && (srcN.Kind == TYP_NAMED) != (dstN.Kind == TYP_NAMED) {
		// A named-distinct type does NOT inherit its underlying's methods, so it
		// does NOT inherit interface SATISFACTION either: `type PS *S; impl *S :
		// Getter` must NOT make `var g *Getter = ps` compile (it did, then crashed,
		// because this decay recursed to *S which satisfies Getter).  Skip the
		// src-underlying decay for an interface-value destination so the source's
		// OWN (empty) method set is what canAssignToRawInterfaceValue checks below
		// — which rejects a TYP_NAMED source.  A direct impl on the named type
		// keeps working (it is not reached via this decay).
		var dpeel @Type = resolveAliasAndConst(dstN)
		var dstIsIface bool = dpeel != nil &&
				(dpeel.Kind == TYP_INTERFACE_VALUE || dpeel.Kind == TYP_INTERFACE_VALUE_MANAGED)
		if srcN.Kind == TYP_NAMED && srcN.Underlying != nil &&
				isUnnamedCompositeKind(comparabilityKind(srcN)) && !dstIsIface {
			return srcN.Underlying.AssignableTo(c, dstN)
		}
		if dstN.Kind == TYP_NAMED && dstN.Underlying != nil &&
				isUnnamedCompositeKind(comparabilityKind(dstN)) {
			return srcN.AssignableTo(c, dstN.Underlying)
		}
	}

	// nil assignable to nillable types
	if src != nil && src.Kind == TYP_NIL {
		return dst.IsNillable()
	}

	// Named function reference → function-value type (raw or managed).
	// `var f *func(int) int = add` where `add` is a top-level function.
	// The dst's transparent wrappers (alias / named / readonly) are peeled
	// first so a NAMED func-value type (`type Fn @func(int) int`) is
	// constructible from a func reference, mirroring how the anonymous
	// `@func(...)` spelling already accepts it.  A func VALUE assigned to
	// the named type stays nominal — that source is a func-value kind, not
	// TYP_FUNC, so it never reaches this arm.  Signature match: identical
	// param + result types; the TYP_FUNC carries param Names while the
	// function-value type's params are anonymous — compare types only.
	if src != nil && dst != nil && src.Kind == TYP_FUNC {
		var fvDst @Type = peelNamedBounded(dst)
		if fvDst != nil && (fvDst.Kind == TYP_FUNC_VALUE || fvDst.Kind == TYP_MANAGED_FUNC_VALUE) {
			return funcSignaturesMatch(src, fvDst)
		}
	}

	// Resolve transparent wrappers (alias / readonly) off the destination
	// ONCE here: the managed→raw decay arms below AND the interface-value
	// arms further down all test the peeled destination's kind.  Peeling up
	// front (not per-arm) lets `@T → readonly *T` / `@[]T → readonly *[]T`
	// decay the same as the bare `@T → *T` / `@[]T → *[]T` — readonly is
	// strictly more restrictive on capability and layout-transparent, so
	// adding it to the raw target is sound.  The element-level const check is
	// unchanged: dropsConst still rejects dropping const BEHIND the reference.
	var d @Type = resolveAliasAndConst(dst)

	// @T → *T (managed to raw pointer). Element must match with no
	// const drop at element level.
	if src != nil && d != nil && src.Kind == TYP_MANAGED_PTR && d.Kind == TYP_POINTER {
		return src.Elem.Identical(d.Elem) && !dropsConst(src.Elem, d.Elem)
	}

	// @[]T → *[]T (managed to raw slice). Same element-const check.
	if src != nil && d != nil && src.Kind == TYP_MANAGED_SLICE && d.Kind == TYP_SLICE {
		return src.Elem.Identical(d.Elem) && !dropsConst(src.Elem, d.Elem)
	}

	// @func → *func (managed to raw function value): a borrow.  The two share
	// an identical 2-word {vtable, data} layout, so this is refcount-neutral —
	// the *func borrows the @func owner's record (kept alive by the owner) and
	// itself owns nothing.  Signatures must match (params + results); func
	// values carry no const, so there is no element-const check.  Tests the
	// wrapper-peeled `d` so `@func → readonly *func` decays like the bare
	// form (consistent with the @T / @[]T arms above).
	if src != nil && d != nil && src.Kind == TYP_MANAGED_FUNC_VALUE && d.Kind == TYP_FUNC_VALUE {
		return funcSignaturesMatch(src, d)
	}

	// String literal natural type → slice / array (Stage 2c default-flip):
	// EXPR_STRING_LIT has natural type [N]readonly char (see string_lit.bn).
	// The same rules apply to any structurally-equivalent value.
	//   [N]readonly char → *[]readonly char    : zero-copy raw-slice borrow
	//   [N]readonly char → @[]readonly char    : zero-copy managed-slice borrow
	//   [N]readonly char → @[]char          : literal-init allocate+copy
	//   [N]readonly char → *[]char          : REJECTED — raw slice with mutable
	//                                       view of rodata is unsound
	//   [N]readonly char → [M]readonly char (M==N) : array copy, no const drop
	//   [N]readonly char → [M]char (M==N)       : array copy with outer
	//                                       element-const drop (safe — the
	//                                       array is value-copied, not aliased)
	if isStringLitNaturalType(src) && isStringWritableSliceTarget(dst) {
		return true
	}

	// *T / @T → *Iface (raw interface value): the source is some
	// pointer-shaped value whose underlying named type has an impl
	// for the interface. At construction sites, only explicit
	// conversions apply: value `T` is
	// rejected (caller must write `&t`); `*T` matches if some impl's
	// receiver is reachable via safe smoothing; `@T` works through
	// the existing managed-as-raw path. Lookup walks
	// c.Impls.
	// `d` (the wrapper-peeled dst, computed above) also lets a
	// `readonly @Iface` / `readonly *Iface` construction target reach these
	// interface-value arms instead of falling through to `return false`.
	// readonly is layout-transparent; the canAssign helpers re-check the kind
	// on what they receive, so pass the peeled `d`.
	if d != nil && d.Kind == TYP_INTERFACE_VALUE {
		return canAssignToRawInterfaceValue(c, src, d)
	}

	// @T → @Iface (managed interface value): only managed sources
	// are admitted — raw `*T` cannot promote to `@Iface` (would
	// invent a refcount on something that has none). The matched
	// impl's receiver kind must be reachable from `@T` via
	// receiverAssignable. Construction-site conversions are
	// explicit only.
	if d != nil && d.Kind == TYP_INTERFACE_VALUE_MANAGED {
		return canAssignToManagedInterfaceValue(c, src, d)
	}

	return false
}

// untypedStringAssignableTo reports whether an untyped string literal `src`
// (TYP_UNTYPED_STRING, carrying its byte length N) adopts destination `dst`.
// The rodata-backed literal decays to:
//   *[]readonly char / @[]readonly char : zero-copy borrow of the rodata bytes
//   @[]char                             : allocate + copy
//   [M]char / [M]readonly char, M >= N  : fixed-buffer init, zero-padded tail
// `*[]char` (a mutable raw view of rodata) is REJECTED by
// isStringWritableSliceTarget.  Named-distinct / alias / readonly-wrapped targets
// (e.g. `testing.TestResult = @[]char`) are peeled first.  A runtime [N]readonly
// char array never reaches here — it is a TYP_ARRAY, not TYP_UNTYPED_STRING — so
// there is no array→slice hole.
func untypedStringAssignableTo(src @Type, dst @Type) bool {
	var d @Type = peelNamedBounded(dst)
	if d == nil {
		return false
	}
	if isStringWritableSliceTarget(d) {
		return true
	}
	if isStringWritableArrayTarget(d) {
		return stringLitFitsArray(untypedStringNaturalArray(src), d)
	}
	return false
}

// untypedIntLitFitsTarget reports whether the literal value carried
// on src's LitMag / LitSign fits dst's range.  Unwraps `TYP_NAMED`
// (e.g. `token.Type = int`) and `TYP_ALIAS` / `TYP_READONLY` so
// `var x token.Type = 42` keeps working — the named-int's
// underlying carries the actual width / signedness.  Delegates the
// width-bounded check to bignum.Num.FitsSigned / FitsUnsigned.
func untypedIntLitFitsTarget(src @Type, dst @Type) bool {
	if dst == nil { return false }
	var d @Type = resolveAliasAndConst(dst)
	if d == nil { return false }
	if d.Kind == TYP_UNTYPED_INT { return true }
	if d.Kind == TYP_NAMED && d.Underlying != nil {
		d = d.Underlying
	}
	if d.Kind != TYP_INT { return false }
	var v bignum.Num
	v.Magnitude = src.LitMag
	v.Sign = src.LitSign
	if d.Signed { return v.FitsSigned(d.Width) }
	return v.FitsUnsigned(d.Width)
}
