package "pkg/binate/types"

import "pkg/binate/bignum"

// Assignability rules: AssignableTo and the interface-value
// assignability helpers it dispatches into. Extracted from
// types_query.bn so that file stays under the hygiene length cap;
// the predicates / structural identity / element accessors stay in
// types_query.bn.

// AssignableTo reports whether a value of type src can be assigned to type dst.
// Const rule (Stage 1): widening is allowed (`T → const T`), narrowing is not
// (`const T → T` requires an explicit `cast`). Const-drop is detected
// structurally at any position — e.g., `*readonly T → *T` is rejected because
// the pointer's element type loses const.
func (src @Type) AssignableTo(c @Checker, dst @Type) bool {
	// String literal natural type → array target with matching length.
	// Checked before the generic Identical+dropsConst path because
	// `[N]readonly char → [N]char` is structurally identical (mod const)
	// but drops element-level const — which would otherwise be rejected.
	// The drop is safe here because arrays are value-copied, so the
	// destination is a fresh independent array. Slice/raw-slice targets
	// are handled later (those decay paths don't intersect Identical).
	//
	// LENGTH MATCH IS EXACT here: a `[N]readonly char` type is the natural
	// type of a string literal AND of any user-written `[N]readonly char`
	// VALUE (indistinguishable — isStringLitNaturalType), so a length-loose
	// rule here would silently zero-pad a runtime array into a larger one.
	// The shorter-literal-into-larger-buffer init (zero-padded) is a
	// string-LITERAL feature, gated on the source EXPRESSION being a string
	// literal — see stringLitInitFitsArray and its use at the var-decl /
	// struct-literal sites.
	ensureInit()
	// Error sentinel: an expression whose type error was already reported is
	// assignable to (and from) anything, so the surrounding assignment /
	// return / arg check doesn't pile a follow-on "cannot assign <error>"
	// onto the primary diagnostic.  TYP_VOID is deliberately NOT treated this
	// way -- a real void-returning call assigned to a value is a genuine error
	// worth reporting (the distinction TYP_ERROR exists to preserve).
	if src.Kind == TYP_ERROR || dst.Kind == TYP_ERROR {
		return true
	}
	if isStringLitNaturalType(src) && isStringWritableArrayTarget(dst) && arrayLengthsMatch(src, dst) {
		return true
	}

	// Distinct named integer types (int, int8, …, int64, and their unsigned
	// counterparts) do NOT inter-assign without an explicit cast, even when they
	// share width + signedness (`int` == `int64` on a 64-bit target).  Without
	// this gate `var x int64 = anInt` would silently compile; Go requires
	// `int64(anInt)`.  Untyped int constants still coerce (handled below).
	if distinctNamedInts(src, dst) {
		return false
	}

	if src.Identical(dst) {
		// `Identical` is const-transparent, so types that differ only
		// in const at some position still match here. Reject if the
		// difference is a narrowing (const present in src but not in
		// the corresponding dst position).
		if dropsConst(src, dst) {
			return false
		}
		return true
	}

	// Untyped constants assignable to their concrete counterparts.
	// When the literal's value is known (HasLitVal), also require it
	// to fit the target type's range — `var x uint8 = 256` rejects
	// here, `var x uint8 = 255` accepts.  Per claude-notes.md §
	// "Integer literal value range and constant-expression
	// arithmetic — DECIDED 2026-05-15".
	if src != nil && src.Kind == TYP_UNTYPED_INT {
		if !dst.IsInteger() { return false }
		if src.HasLitVal { return untypedIntLitFitsTarget(src, dst) }
		return true
	}
	if src != nil && src.Kind == TYP_UNTYPED_FLOAT {
		return dst.IsFloat()
	}
	if src != nil && src.Kind == TYP_UNTYPED_BOOL {
		return dst.IsBool()
	}

	// Named-distinct transparency (Go's assignability rule): exactly one
	// side is a named-distinct type whose CONCRETE underlying is an unnamed
	// composite (slice / pointer / array / struct / func-value).  Recurse on
	// that side's immediate Underlying so the existing Identical / const-drop
	// / decay logic applies unchanged (this preserves readonly protection —
	// we never strip readonly before the const check).  A scalar/named
	// underlying (`type Celsius float64` ↔ `float64`) or two named types fall
	// through → a `cast` is required.
	if src != nil && dst != nil && (src.Kind == TYP_NAMED) != (dst.Kind == TYP_NAMED) {
		if src.Kind == TYP_NAMED && src.Underlying != nil &&
				isUnnamedCompositeKind(comparabilityKind(src)) {
			return src.Underlying.AssignableTo(c, dst)
		}
		if dst.Kind == TYP_NAMED && dst.Underlying != nil &&
				isUnnamedCompositeKind(comparabilityKind(dst)) {
			return src.AssignableTo(c, dst.Underlying)
		}
	}

	// nil assignable to nillable types
	if src != nil && src.Kind == TYP_NIL {
		return dst.IsNillable()
	}

	// Named function reference → function-value type (raw or managed).
	// `var f *func(int) int = add` where `add` is a top-level function.
	// The dst's transparent wrappers (alias / named / readonly) are peeled
	// first so a NAMED func-value type (`type Fn @func(int) int`) is
	// constructible from a func reference, mirroring how the anonymous
	// `@func(...)` spelling already accepts it.  A func VALUE assigned to
	// the named type stays nominal — that source is a func-value kind, not
	// TYP_FUNC, so it never reaches this arm.  Signature match: identical
	// param + result types; the TYP_FUNC carries param Names while the
	// function-value type's params are anonymous — compare types only.
	if src != nil && dst != nil && src.Kind == TYP_FUNC {
		var fvDst @Type = peelNamedBounded(dst)
		if fvDst != nil && (fvDst.Kind == TYP_FUNC_VALUE || fvDst.Kind == TYP_MANAGED_FUNC_VALUE) {
			return funcSignaturesMatch(src, fvDst)
		}
	}

	// Resolve transparent wrappers (alias / readonly) off the destination
	// ONCE here: the managed→raw decay arms below AND the interface-value
	// arms further down all test the peeled destination's kind.  Peeling up
	// front (not per-arm) lets `@T → readonly *T` / `@[]T → readonly *[]T`
	// decay the same as the bare `@T → *T` / `@[]T → *[]T` — readonly is
	// strictly more restrictive on capability and layout-transparent, so
	// adding it to the raw target is sound.  The element-level const check is
	// unchanged: dropsConst still rejects dropping const BEHIND the reference.
	var d @Type = resolveAliasAndConst(dst)

	// @T → *T (managed to raw pointer). Element must match with no
	// const drop at element level.
	if src != nil && d != nil && src.Kind == TYP_MANAGED_PTR && d.Kind == TYP_POINTER {
		return src.Elem.Identical(d.Elem) && !dropsConst(src.Elem, d.Elem)
	}

	// @[]T → *[]T (managed to raw slice). Same element-const check.
	if src != nil && d != nil && src.Kind == TYP_MANAGED_SLICE && d.Kind == TYP_SLICE {
		return src.Elem.Identical(d.Elem) && !dropsConst(src.Elem, d.Elem)
	}

	// @func → *func (managed to raw function value): a borrow.  The two share
	// an identical 2-word {vtable, data} layout, so this is refcount-neutral —
	// the *func borrows the @func owner's record (kept alive by the owner) and
	// itself owns nothing.  Signatures must match (params + results); func
	// values carry no const, so there is no element-const check.  Tests the
	// wrapper-peeled `d` so `@func → readonly *func` decays like the bare
	// form (consistent with the @T / @[]T arms above).
	if src != nil && d != nil && src.Kind == TYP_MANAGED_FUNC_VALUE && d.Kind == TYP_FUNC_VALUE {
		return funcSignaturesMatch(src, d)
	}

	// String literal natural type → slice / array (Stage 2c default-flip):
	// EXPR_STRING_LIT has natural type [N]readonly char (see string_lit.bn).
	// The same rules apply to any structurally-equivalent value.
	//   [N]readonly char → *[]readonly char    : zero-copy raw-slice borrow
	//   [N]readonly char → @[]readonly char    : zero-copy managed-slice borrow
	//   [N]readonly char → @[]char          : literal-init allocate+copy
	//   [N]readonly char → *[]char          : REJECTED — raw slice with mutable
	//                                       view of rodata is unsound
	//   [N]readonly char → [M]readonly char (M==N) : array copy, no const drop
	//   [N]readonly char → [M]char (M==N)       : array copy with outer
	//                                       element-const drop (safe — the
	//                                       array is value-copied, not aliased)
	if isStringLitNaturalType(src) && isStringWritableSliceTarget(dst) {
		return true
	}

	// *T / @T → *Iface (raw interface value): the source is some
	// pointer-shaped value whose underlying named type has an impl
	// for the interface. Per plan-interface-syntax-revision.md
	// "Construction-site conversions — explicit only": value `T` is
	// rejected (caller must write `&t`); `*T` matches if some impl's
	// receiver is reachable via safe smoothing; `@T` works through
	// the existing managed-as-raw path. Lookup walks
	// c.Impls.
	// `d` (the wrapper-peeled dst, computed above) also lets a
	// `readonly @Iface` / `readonly *Iface` construction target reach these
	// interface-value arms instead of falling through to `return false`.
	// readonly is layout-transparent; the canAssign helpers re-check the kind
	// on what they receive, so pass the peeled `d`.
	if d != nil && d.Kind == TYP_INTERFACE_VALUE {
		return canAssignToRawInterfaceValue(c, src, d)
	}

	// @T → @Iface (managed interface value): only managed sources
	// are admitted — raw `*T` cannot promote to `@Iface` (would
	// invent a refcount on something that has none). The matched
	// impl's receiver kind must be reachable from `@T` via
	// receiverAssignable. Per plan-interface-syntax-revision.md
	// "Construction-site conversions — explicit only" (Slice 2.3b).
	if d != nil && d.Kind == TYP_INTERFACE_VALUE_MANAGED {
		return canAssignToManagedInterfaceValue(c, src, d)
	}

	return false
}

// untypedIntLitFitsTarget reports whether the literal value carried
// on src's LitMag / LitSign fits dst's range.  Unwraps `TYP_NAMED`
// (e.g. `token.Type = int`) and `TYP_ALIAS` / `TYP_READONLY` so
// `var x token.Type = 42` keeps working — the named-int's
// underlying carries the actual width / signedness.  Delegates the
// width-bounded check to bignum.Num.FitsSigned / FitsUnsigned.
func untypedIntLitFitsTarget(src @Type, dst @Type) bool {
	if dst == nil { return false }
	var d @Type = resolveAliasAndConst(dst)
	if d == nil { return false }
	if d.Kind == TYP_UNTYPED_INT { return true }
	if d.Kind == TYP_NAMED && d.Underlying != nil {
		d = d.Underlying
	}
	if d.Kind != TYP_INT { return false }
	var v bignum.Num
	v.Magnitude = src.LitMag
	v.Sign = src.LitSign
	if d.Signed { return v.FitsSigned(d.Width) }
	return v.FitsUnsigned(d.Width)
}

// canAssignToRawInterfaceValue returns true if a source of type
// src can be implicitly assigned to a raw interface-value type
// (*Iface). Two source shapes accepted:
//
//   - Pointer-shaped value (`*T` / `@T`) whose underlying named
//     type has an impl for the interface — the construction-site
//     case from plan-interface-syntax-revision.md Slice 2.3b.
//     Value `T` is still rejected (caller must write `&t`).
//   - Another interface value (`*ChildIface` / `@ChildIface`)
//     whose interface is a descendant of dst.Elem — the upcast
//     case from plan-interface-embedding.md Slice E.4 part 2.
//     Identical-interface assignment goes through Identical at
//     the caller layer and never reaches here; this arm handles
//     the strict-ancestor case.
func canAssignToRawInterfaceValue(c @Checker, src @Type, dst @Type) bool {
	if c == nil { return false }
	if dst == nil || dst.Kind != TYP_INTERFACE_VALUE { return false }
	var iface @Type = dst.Elem
	if iface == nil { return false }
	var srcResolved @Type = src.ResolveAlias()
	if srcResolved == nil { return false }
	// Iface-value-to-iface-value upcast.  Source may be raw or
	// managed — both have a data + vtable pair, so the upcast is
	// a pointer-offset adjustment on the vtable side.
	if srcResolved.Kind == TYP_INTERFACE_VALUE || srcResolved.Kind == TYP_INTERFACE_VALUE_MANAGED {
		// `any` is the ONLY universal interface: a source iface value
		// upcasts to `*any` by reusing its own vtable (slot 0 is T's
		// dtor, which doubles as any's whole vtable since any has no
		// methods).  A user-declared empty interface is a nominal
		// marker — NOT universally satisfiable — so it does not take
		// this path (it requires an explicit impl, like any other).
		if isUniverseAny(iface) { return true }
		// Same interface, managed->raw: the `@X -> *X` decay.  Not the
		// Identical case (managed vs raw differ in Kind), so admit it
		// here; the vtable offset is 0 (X's vtable IS the target's).
		if sameInterface(srcResolved.Elem, iface) { return true }
		return isDescendantInterface(srcResolved.Elem, iface)
	}
	if srcResolved.Kind != TYP_POINTER && srcResolved.Kind != TYP_MANAGED_PTR {
		return false
	}
	// Only universe `any` is satisfied by every type with no impl
	// record.  A user-declared empty interface is a nominal marker
	// requiring an explicit `impl` — Binate interfaces are nominal,
	// not structural, so "zero methods" does NOT mean "anything fits".
	if isUniverseAny(iface) {
		return true
	}
	for i := 0; i < len(c.Impls); i++ {
		var rec @Impl = c.Impls[i]
		if rec == nil { continue }
		if !implSatisfiesInterface(rec, iface) { continue }
		if receiverAssignable(src, rec.RecvType) {
			return true
		}
	}
	return false
}

// canAssignToManagedInterfaceValue returns true if a source of
// type src can be implicitly assigned to a managed interface-value
// type (@Iface).  Two source shapes accepted:
//
//   - Managed pointer (`@T`) whose underlying named type has an
//     impl for the interface — Slice 2.3b construction-site case.
//     Raw `*T` cannot promote to `@Iface` (would invent a
//     refcount on something with no header).
//   - Another managed interface value (`@ChildIface`) whose
//     interface is a descendant of dst.Elem — the upcast case
//     from plan-interface-embedding.md Slice E.4 part 2.  Raw
//     interface values (`*ChildIface`) are similarly rejected as
//     `@Iface` sources for the same refcount-invention reason.
func canAssignToManagedInterfaceValue(c @Checker, src @Type, dst @Type) bool {
	if c == nil { return false }
	if dst == nil || dst.Kind != TYP_INTERFACE_VALUE_MANAGED { return false }
	var iface @Type = dst.Elem
	if iface == nil { return false }
	var srcResolved @Type = src.ResolveAlias()
	if srcResolved == nil { return false }
	// Managed iface-value-to-managed-iface-value upcast.  Raw
	// iface values are rejected (same rule as `*T` not promoting
	// to `@Iface`).
	if srcResolved.Kind == TYP_INTERFACE_VALUE_MANAGED {
		// Only `any` is universal (reuses the source vtable); a user
		// empty interface is a nominal marker and does not.  Same-
		// interface managed->managed (`@X -> @X`) is the Identical
		// case, handled by the caller, so it never reaches here.
		if isUniverseAny(iface) { return true }
		return isDescendantInterface(srcResolved.Elem, iface)
	}
	if srcResolved.Kind != TYP_MANAGED_PTR { return false }
	// Only universe `any` is satisfied without an impl record (see the
	// raw side); a user-declared empty interface is a nominal marker.
	if isUniverseAny(iface) {
		return true
	}
	for i := 0; i < len(c.Impls); i++ {
		var rec @Impl = c.Impls[i]
		if rec == nil { continue }
		if !implSatisfiesInterface(rec, iface) { continue }
		if receiverAssignable(src, rec.RecvType) {
			return true
		}
	}
	return false
}

// isUniverseAny reports whether `iface` is the built-in universal
// interface `any` (TYP_INTERFACE, empty package, name "any").  Only
// `any` is universally satisfiable; a user-declared empty interface
// is a nominal marker that requires an explicit `impl`.  Mirrors the
// IR-gen predicate of the same name (gen_iface.bn) so the checker and
// IR agree on which empty interface is the universe.
func isUniverseAny(iface @Type) bool {
	if iface == nil { return false }
	if iface.Kind != TYP_INTERFACE { return false }
	if len(iface.Pkg) != 0 { return false }
	return charEq(iface.Name, "any")
}

// sameInterface reports whether `a` and `b` are the same nominal
// interface (equal canonical package + name), both TYP_INTERFACE.
// Used to admit the managed->raw decay `@X -> *X`, which is not the
// Identical case (managed vs raw differ in Kind) yet targets the same
// interface.
func sameInterface(a @Type, b @Type) bool {
	if a == nil || b == nil { return false }
	if a.Kind != TYP_INTERFACE || b.Kind != TYP_INTERFACE { return false }
	return charEq(a.Pkg, b.Pkg) && charEq(a.Name, b.Name)
}

// isDescendantInterface reports whether `child` extends `ancestor`
// (transitively), where both are TYP_INTERFACE.  Returns false if
// either is nil or the wrong kind, and false if child == ancestor (an
// interface is not its own descendant; same-interface assignment is
// the Identical case for same-Kind sources and the sameInterface case
// for the cross-Kind `@X -> *X` decay, both handled by the caller).
// plan-interface-embedding.md Slice E.4 part 2.
func isDescendantInterface(child @Type, ancestor @Type) bool {
	if child == nil || ancestor == nil { return false }
	if child.Kind != TYP_INTERFACE { return false }
	if ancestor.Kind != TYP_INTERFACE { return false }
	for i := 0; i < len(child.Parents); i++ {
		var p @Type = child.Parents[i]
		if p == nil { continue }
		if p.Kind != TYP_INTERFACE { continue }
		if charEq(p.Pkg, ancestor.Pkg) && charEq(p.Name, ancestor.Name) {
			return true
		}
		if isDescendantInterface(p, ancestor) {
			return true
		}
	}
	return false
}

// implCoversInterface returns true if the impl's interface list
// includes the given interface, identified by canonical (Pkg, Name).
// Each interface declaration's TYP_INTERFACE Type object carries the
// declaring package's short-name in Pkg (set by MakeInterfaceType
// callers — Slice 2.7), so cross-package iface refs that share a
// Name don't false-match. Aliases collapse to the same target Type
// at the type-checker level, so they share Pkg/Name with the
// underlying iface and match here. Slice 2.7 replaced the prior
// name-only comparison.
func implCoversInterface(rec @Impl, iface @Type) bool {
	if rec == nil || iface == nil { return false }
	for i := 0; i < len(rec.Interfaces); i++ {
		var entry @Type = rec.Interfaces[i]
		if entry == nil { continue }
		if !charEq(entry.Pkg, iface.Pkg) { continue }
		if !charEq(entry.Name, iface.Name) { continue }
		return true
	}
	return false
}

// implSatisfiesInterface reports whether impl `rec` makes its receiver satisfy
// `iface` -- directly (rec lists iface) OR transitively through interface
// embedding: `impl R : Sub` where `interface Sub : Base` also satisfies Base,
// because Sub's method set includes Base's.  Mirrors the ancestor walk
// typeSatisfiesConstraint already performs for generic constraints
// (check_generic.bn); without it a `*R -> *Base` / `@R -> @Base` upcast was
// wrongly rejected even though R implements a descendant of Base.
func implSatisfiesInterface(rec @Impl, iface @Type) bool {
	if implCoversInterface(rec, iface) { return true }
	if rec == nil { return false }
	for j := 0; j < len(rec.Interfaces); j++ {
		var entry @Type = rec.Interfaces[j]
		if entry == nil { continue }
		if isDescendantInterface(entry, iface) { return true }
	}
	return false
}

// arrayLengthsMatch reports whether src and dst are both array types
// (after peeling outer const/alias) with equal ArrayLen.  Used for the
// general char-array copy in AssignableTo, which is EXACT-length per the
// ratified spec §6.6 (a `[N]readonly char` value -- literal OR variable --
// assigns to `[N]char` only when lengths match).
func arrayLengthsMatch(src @Type, dst @Type) bool {
	src = peelOuterConstAndAlias(src)
	dst = peelOuterConstAndAlias(dst)
	if src == nil || dst == nil { return false }
	if src.Kind != TYP_ARRAY || dst.Kind != TYP_ARRAY { return false }
	return src.ArrayLen == dst.ArrayLen
}

// stringLitFitsArray reports whether a string literal's natural type src
// (a fixed char array) fits a longer-or-equal char-array target dst — both
// arrays (after peeling outer const/alias) with dst at least as long as src.
// A shorter literal is allowed: the store copies the literal's bytes and
// zero-pads the tail (a fixed-size string buffer init, §6.6).  An OVER-long
// literal (src longer than dst) does not fit.  Used ONLY by
// stringLitInitFitsArray, i.e. when the source is statically a string LITERAL
// — never for a runtime `[N]readonly char` value (which stays exact-length).
func stringLitFitsArray(src @Type, dst @Type) bool {
	src = peelOuterConstAndAlias(src)
	dst = peelOuterConstAndAlias(dst)
	if src == nil || dst == nil { return false }
	if src.Kind != TYP_ARRAY || dst.Kind != TYP_ARRAY { return false }
	return dst.ArrayLen >= src.ArrayLen
}
