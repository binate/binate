package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for the assignability rules in types_assignable.bn.
// Helpers `fail` and `streq` are defined in types_test.bn (sibling file).

func TestAssignableTo() testing.TestResult {
	// Same types
	if !TypInt().AssignableTo(nil, TypInt()) { return fail("int to int") }
	// Untyped int to int
	if !TypUntypedInt().AssignableTo(nil, TypInt()) { return fail("untyped int to int") }
	if !TypUntypedInt().AssignableTo(nil, TypInt32()) { return fail("untyped int to int32") }
	// Untyped bool to bool
	if !TypUntypedBool().AssignableTo(nil, TypBool()) { return fail("untyped bool to bool") }
	// nil to pointer
	if !TypNil().AssignableTo(nil, MakePointerType(TypInt())) { return fail("nil to *int") }
	// nil to slice — NOT allowed
	if TypNil().AssignableTo(nil, MakeSliceType(TypInt())) { return fail("nil to *[]int should fail") }
	if TypNil().AssignableTo(nil, MakeManagedSliceType(TypInt())) {
		return fail("nil to @[]int should fail")
	}
	// Managed to raw pointer
	if !MakeManagedPtrType(TypInt()).AssignableTo(nil, MakePointerType(TypInt())) {
		return fail("@int to *int")
	}
	// String literal natural type ([N]readonly char) → *[]char is rejected
	// (Stage 2a — mutable raw borrow of rodata is unsound). Use
	// *[]readonly char instead.
	var natStr @Type = MakeArrayType(MakeReadonlyType(TypChar()), 5)
	if natStr.AssignableTo(nil, MakeSliceType(TypChar())) {
		return fail("[5]readonly char to *[]char should NOT be assignable")
	}
	// [N]readonly char → *[]readonly char (zero-copy raw-slice borrow, allowed).
	if !natStr.AssignableTo(nil, MakeSliceType(MakeReadonlyType(TypChar()))) {
		return fail("[5]readonly char to *[]readonly char")
	}
	// [N]readonly char → @[]readonly char (zero-copy managed borrow, allowed).
	if !natStr.AssignableTo(nil, MakeManagedSliceType(MakeReadonlyType(TypChar()))) {
		return fail("[5]readonly char to @[]readonly char")
	}
	// [N]readonly char → @[]char (literal-init copy at codegen time, allowed).
	if !natStr.AssignableTo(nil, MakeManagedSliceType(TypChar())) {
		return fail("[5]readonly char to @[]char")
	}
	// @[]T → *[]T (managed to raw slice).
	if !MakeManagedSliceType(TypInt()).AssignableTo(nil, MakeSliceType(TypInt())) {
		return fail("@[]int to *[]int")
	}
	// @[]T → readonly *[]T and @T → readonly *T: the managed→raw decay must
	// see through a readonly (or alias) wrapper on the destination, the same
	// way the interface-value arms do.  readonly is strictly more restrictive
	// on capability, so adding it to the raw target is sound (and layout-
	// transparent).
	if !MakeManagedSliceType(TypInt()).AssignableTo(nil,
			MakeReadonlyType(MakeSliceType(TypInt()))) {
		return fail("@[]int to readonly *[]int")
	}
	if !MakeManagedPtrType(TypInt()).AssignableTo(nil,
			MakeReadonlyType(MakePointerType(TypInt()))) {
		return fail("@int to readonly *int")
	}
	// Not assignable
	if TypInt().AssignableTo(nil, TypBool()) { return fail("int to bool should fail") }

	// Function reference → function-value type. Same signature: assignable.
	var fnParams @[]@Param = make_slice(@Param, 1)
	var fnP0 @Param = make(Param)
	fnP0.Type = TypInt()
	fnParams[0] = fnP0
	var fnResults @[]@Type = make_slice(@Type, 1)
	fnResults[0] = TypInt()
	var fn @Type = MakeFuncType(fnParams, fnResults)
	var fv @Type = MakeFuncValueType(fnParams, fnResults)
	if !fn.AssignableTo(nil, fv) {
		return fail("func(int) int → *func(int) int (matching sig)")
	}
	var fvm @Type = MakeManagedFuncValueType(fnParams, fnResults)
	if !fn.AssignableTo(nil, fvm) {
		return fail("func(int) int → @func(int) int")
	}
	// @func → readonly *func: the managed→raw func-value decay sees through a
	// readonly wrapper on the destination, like the @T / @[]T decay arms.
	if !fvm.AssignableTo(nil, MakeReadonlyType(fv)) {
		return fail("@func(int) int → readonly *func(int) int")
	}
	// Mismatched signature: return type differs.
	var fvBoolResult @[]@Type = make_slice(@Type, 1)
	fvBoolResult[0] = TypBool()
	var fvMismatch @Type = MakeFuncValueType(fnParams, fvBoolResult)
	if fn.AssignableTo(nil, fvMismatch) {
		return fail("func(int) int → *func(int) bool should fail")
	}
	// Mismatched signature: param count differs.
	var fnNoParams @[]@Param
	var fvDiffParams @Type = MakeFuncValueType(fnNoParams, fnResults)
	if fn.AssignableTo(nil, fvDiffParams) {
		return fail("func(int) int → *func() int should fail")
	}
	return ""
}

// TestNamedDistinctAssignability checks the named-distinct transparency
// arm of AssignableTo (Go's rule): an unnamed composite crosses a
// named-distinct boundary without a cast, but a scalar-underlying distinct
// type and two distinct named types still require an explicit cast.
func TestNamedDistinctAssignability() testing.TestResult {
	// (a) scalar-underlying distinct type: `type Celsius float64`.
	// A named type whose concrete underlying is a SCALAR is NOT
	// assignable to/from that scalar — the rule only crosses for
	// unnamed COMPOSITE underlyings.
	var celsius @Type = MakeNamedType("Celsius")
	celsius.Underlying = TypFloat64()
	if TypFloat64().AssignableTo(nil, celsius) {
		return fail("float64 to Celsius should require cast")
	}
	if celsius.AssignableTo(nil, TypFloat64()) {
		return fail("Celsius to float64 should require cast")
	}

	// (b) two distinct named types with identical composite underlying:
	// `type A @[]int; type B @[]int`.  Both sides are named, so the
	// "exactly one side named" guard excludes them — NOT mutually
	// assignable.
	var aTy @Type = MakeNamedType("A")
	aTy.Underlying = MakeManagedSliceType(TypInt())
	var bTy @Type = MakeNamedType("B")
	bTy.Underlying = MakeManagedSliceType(TypInt())
	if aTy.AssignableTo(nil, bTy) {
		return fail("A to B (distinct named @[]int) should require cast")
	}
	if bTy.AssignableTo(nil, aTy) {
		return fail("B to A (distinct named @[]int) should require cast")
	}

	// (c) sanity positive: unnamed `@[]int` <-> `type Buf @[]int`.
	var buf @Type = MakeNamedType("Buf")
	buf.Underlying = MakeManagedSliceType(TypInt())
	if !MakeManagedSliceType(TypInt()).AssignableTo(nil, buf) {
		return fail("@[]int to Buf (named @[]int) should be assignable")
	}
	if !buf.AssignableTo(nil, MakeManagedSliceType(TypInt())) {
		return fail("Buf to @[]int should be assignable")
	}
	return ""
}
