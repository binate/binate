package "pkg/binate/types"

// Const type modifier support: constructors, predicates, and the
// assignability helpers that enforce widening-only conversion
// (T → const T is safe; const T → T behind a reference is not).

// MakeReadonlyType wraps `inner` with the `const` type modifier.
// The result has the same size/align as `inner` — const is purely
// a semantic flag about modifiability through this access path.
// Collapses `const (const T)` into a single `const T` to keep the
// representation canonical.
func MakeReadonlyType(inner @Type) @Type {
	if inner != nil && inner.Kind == TYP_READONLY {
		return inner
	}
	var t @Type = make(Type)
	t.Kind = TYP_READONLY
	t.Elem = inner
	return t
}

// IsReadonly reports whether t has the const modifier at its
// outermost level (after stripping aliases).
func (t @Type) IsReadonly() bool {
	t = t.ResolveAlias()
	if t == nil { return false }
	return t.Kind == TYP_READONLY
}

// StripReadonly returns the inner type, peeling one const wrapper.
// Returns t unchanged if t is not const at the outermost level.
// Does NOT recurse: `*readonly int` stripped is still `*readonly int`
// (the outer is TYP_POINTER, not TYP_READONLY).
func (t @Type) StripReadonly() @Type {
	if t == nil { return nil }
	if t.Kind == TYP_READONLY { return t.Elem }
	return t
}

// resolveAliasAndConst follows both alias and const wrappers to get
// at the "shape" of a type — useful in predicates like IsInteger,
// IsSlice, etc. where `const T` should answer the same as `T`.
// Does NOT recurse into pointer/slice element types.
func resolveAliasAndConst(t @Type) @Type {
	for t != nil {
		if t.Kind == TYP_ALIAS {
			t = t.Target
		} else if t.Kind == TYP_READONLY {
			t = t.Elem
		} else {
			return t
		}
	}
	return t
}

// dropsConst reports whether src → dst would leak write capability
// by dropping const somewhere "behind a reference."
//
// Outermost const is NOT a capability concern — `const T → T` at the
// top level is a value copy (for any T, value or reference), and the
// original const handle is unaffected. So the outer layer is permissive.
//
// Const on an element type (inside a pointer / slice / array) IS a
// capability. Dropping it means a new handle could write to pointees
// that the original handle promised not to. Strict.
//
// Called only when src and dst are already known structurally
// compatible (per `Identical`).
func dropsConst(src @Type, dst @Type) bool {
	src = stripOuterConstAndAlias(src)
	dst = stripOuterConstAndAlias(dst)
	if src == nil || dst == nil { return false }
	if src.Kind != dst.Kind { return false }
	// Reference types: element is behind a handle — strict check.
	if src.Kind == TYP_POINTER || src.Kind == TYP_MANAGED_PTR || src.Kind == TYP_SLICE ||
			src.Kind == TYP_MANAGED_SLICE || src.Kind == TYP_ARRAY {
		return dropsConstStrict(src.Elem, dst.Elem)
	}
	// Value types (int, bool, struct, string, func, …): outermost
	// const is only about the holder, and we already stripped it.
	return false
}

// stripOuterConstAndAlias removes outer const and alias wrappers
// (but not element-level const). Helper for dropsConst.
func stripOuterConstAndAlias(t @Type) @Type {
	for t != nil {
		if t.Kind == TYP_ALIAS {
			t = t.Target
		} else if t.Kind == TYP_READONLY {
			t = t.Elem
		} else {
			return t
		}
	}
	return t
}

// dropsConstStrict is the element-position variant of dropsConst:
// const at any nested level counts as a capability promise, and
// dropping it is rejected.
func dropsConstStrict(src @Type, dst @Type) bool {
	for src != nil && src.Kind == TYP_ALIAS { src = src.Target }
	for dst != nil && dst.Kind == TYP_ALIAS { dst = dst.Target }
	if src == nil || dst == nil { return false }

	var srcC bool = src.Kind == TYP_READONLY
	var dstC bool = dst.Kind == TYP_READONLY
	if srcC && !dstC { return true }
	if srcC { src = src.Elem }
	if dstC { dst = dst.Elem }
	for src != nil && src.Kind == TYP_ALIAS { src = src.Target }
	for dst != nil && dst.Kind == TYP_ALIAS { dst = dst.Target }
	if src == nil || dst == nil { return false }

	if src.Kind != TYP_READONLY && dst.Kind == TYP_READONLY {
		return false
	}
	if src.Kind != dst.Kind { return false }
	if src.Kind == TYP_POINTER || src.Kind == TYP_MANAGED_PTR || src.Kind == TYP_SLICE ||
			src.Kind == TYP_MANAGED_SLICE || src.Kind == TYP_ARRAY {
		return dropsConstStrict(src.Elem, dst.Elem)
	}
	return false
}

// peelOuterConstAndAlias strips outer TYP_READONLY and TYP_ALIAS
// wrappers from t. Helper for the string-target predicates and
// raw-slice-literal element check.
func peelOuterConstAndAlias(t @Type) @Type {
	for t != nil {
		if t.Kind == TYP_ALIAS {
			t = t.Target
		} else if t.Kind == TYP_READONLY {
			t = t.Elem
		} else {
			return t
		}
	}
	return t
}

// elemHasConst peels alias/const wrappers from an element type
// and reports both the unwrapped type and whether any TYP_READONLY
// was found along the way.
func elemHasConst(elem @Type) (@Type, bool) {
	var hadConst bool = false
	for elem != nil {
		if elem.Kind == TYP_ALIAS {
			elem = elem.Target
		} else if elem.Kind == TYP_READONLY {
			hadConst = true
			elem = elem.Elem
		} else {
			break
		}
	}
	return elem, hadConst
}

// isCharElem reports whether t (already peeled of alias/const)
// is the char/uint8 element type — TYP_INT with Width 8, unsigned.
func isCharElem(t @Type) bool {
	if t == nil { return false }
	return t.Kind == TYP_INT && t.Width == 8 && !t.Signed
}

// isStringWritableSliceTarget reports whether a string literal may
// be assigned to a slice-typed destination. Allows all char-slice
// shapes EXCEPT `*[]char` (non-const raw slice) — Stage 2a ratchet.
func isStringWritableSliceTarget(dst @Type) bool {
	dst = peelOuterConstAndAlias(dst)
	if dst == nil { return false }
	if dst.Kind != TYP_SLICE && dst.Kind != TYP_MANAGED_SLICE {
		return false
	}
	var elem @Type
	var elemIsConst bool
	elem, elemIsConst = elemHasConst(dst.Elem)
	if !isCharElem(elem) { return false }
	if dst.Kind == TYP_MANAGED_SLICE { return true }
	// *[]char — rejected; *[]readonly char — allowed.
	return elemIsConst
}

// isStringWritableArrayTarget reports whether a string literal may
// initialize a fixed-size char-array destination. Length matching
// is deferred to IR-gen time (the literal's StrVal isn't in this
// type's hands).
func isStringWritableArrayTarget(dst @Type) bool {
	dst = peelOuterConstAndAlias(dst)
	if dst == nil { return false }
	if dst.Kind != TYP_ARRAY { return false }
	var elem @Type
	elem, _ = elemHasConst(dst.Elem)
	return isCharElem(elem)
}
