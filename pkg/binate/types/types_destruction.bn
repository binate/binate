// Whether a type needs destruction, decided without recursion: through readonly,
// aliases, named types and arrays by a loop, and through the structs a struct holds by
// value from an explicit stack, so a type nested to any depth is decided.
package "pkg/binate/types"

import "pkg/std/vec"

// destrFrame is a struct on destrStack: t, and the index of the field to look at next.
type destrFrame struct {
	t    @Type
	next int
}

// destrStack holds the structs whose destruction is being decided (decideStructs),
// kept from one decision to the next; a decision leaves it as it found it.
var destrStack @vec.Vec[destrFrame]

// needsDestruction is NeedsDestruction within a layout query (layout.bn): a managed
// kind, or a struct one of whose fields needs destruction (structNeedsDestruction).
func needsDestruction(t @Type) bool {
	t = destrBase(t)
	if t == nil { return false }
	if t.Kind == TYP_MANAGED_PTR { return true }
	if t.Kind == TYP_MANAGED_SLICE { return true }
	if t.Kind == TYP_MANAGED_FUNC_VALUE { return true }
	if t.Kind == TYP_INTERFACE_VALUE_MANAGED { return true }
	if t.Kind == TYP_STRUCT { return structNeedsDestruction(t) }
	return false
}

// destrBase returns the type whose destruction t's is: t with readonly, aliases, named
// types with an underlying and arrays peeled.  ResolveAliasAndConst (not
// ResolveAlias): readonly is transparent to destruction — a `readonly @Box` still owns
// its managed pointer and must be destroyed, so the readonly wrapper is peeled too
// (else it falls through to false — a leak, were such a type ever constructible).
func destrBase(t @Type) @Type {
	var steps int = 0
	var g chainGuard
	for t != nil {
		t = t.ResolveAliasAndConst()
		if t == nil { return nil }
		if t.Kind == TYP_NAMED && t.Underlying != nil {
			t = t.Underlying
		} else if t.Kind == TYP_ARRAY {
			t = t.Elem
		} else {
			return t
		}
		steps = steps + 1
		if t != nil && steps >= guardFrom && guardCloses(&g, steps, t) { panicCyclicLayout() }
	}
	return nil
}

// structNeedsDestruction reports whether struct t needs destruction, which a struct
// answers once per layout query (memoized, as its layout is).  A struct holding no
// struct by value that the query has not decided -- nearly every struct -- is decided
// at once; any other from destrStack (decideStructs).
func structNeedsDestruction(t @Type) bool {
	if t.needsDestrMemoGen == layoutGen { return t.needsDestr }
	var r bool = false
	var held @Type = nil
	r, held, _ = scanDestruction(t, 0)
	if held == nil {
		t.needsDestrMemoGen = layoutGen
		t.needsDestr = r
		return r
	}
	return decideStructs(t)
}

// decideStructs decides whether struct t needs destruction, deciding first each
// struct it holds by value that the query has not decided, innermost first: a struct
// is decided once every struct its fields hold by value up to the first field that
// needs destruction is.  A struct being decided carries the query's generation
// negated, so meeting it again -- a struct holding itself by value, which the checker
// rejects -- is an internal error.
func decideStructs(t @Type) bool {
	if destrStack == nil { destrStack = vec.New[destrFrame]() }
	var base int = destrStack.Len()
	destrStack.Push(destrBusy(t))
	for destrStack.Len() > base {
		var top int = destrStack.Len() - 1
		var f destrFrame = destrStack.Get(top)
		var r bool = false
		var held @Type = nil
		r, held, f.next = scanDestruction(f.t, f.next)
		destrStack.Set(top, f)
		if held != nil {
			destrStack.Push(destrBusy(held))
		} else {
			f.t.needsDestrMemoGen = layoutGen
			f.t.needsDestr = r
			_, _ = destrStack.Pop()
		}
	}
	return t.needsDestr
}

// destrBusy marks struct t as being decided and returns its frame.
func destrBusy(t @Type) destrFrame {
	t.needsDestrMemoGen = -layoutGen
	var f destrFrame
	f.t = t
	return f
}

// scanDestruction looks at struct t's fields from index from on, in order: it returns
// (true, nil, i) at the first field i that needs destruction, (false, s, i) at the
// first field i holding by value a struct s not yet decided this query -- decide s,
// then scan again from i -- and (false, nil, len(t.Fields)) when no field does.
func scanDestruction(t @Type, from int) (bool, @Type, int) {
	for i := from; i < len(t.Fields); i++ {
		var b @Type = destrBase(t.Fields[i].Type)
		if b != nil {
			if b.Kind == TYP_MANAGED_PTR || b.Kind == TYP_MANAGED_SLICE ||
					b.Kind == TYP_MANAGED_FUNC_VALUE || b.Kind == TYP_INTERFACE_VALUE_MANAGED {
				return true, nil, i
			}
			if b.Kind == TYP_STRUCT {
				if b.needsDestrMemoGen == -layoutGen {
					panic("internal error: a struct holds itself by value (the checker rejects it)")
				}
				if b.needsDestrMemoGen != layoutGen { return false, b, i }
				if b.needsDestr { return true, nil, i }
			}
		}
	}
	return false, nil, len(t.Fields)
}
