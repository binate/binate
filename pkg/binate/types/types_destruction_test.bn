package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for types_destruction.bn.  The deep tests release their types a link at a
// time, as the layout ones do (layout_structs_test.bn).

// oneField returns struct { f t }.
func oneField(t @Type) @Type {
	var fs @[]@Field = make_slice(@Field, 1)
	fs[0] = makeField("f", t)
	return MakeStructType("O", fs)
}

// A struct is decided once the structs its fields hold by value are, in field order:
// a field holding a plain struct is passed over to the next, and a field that needs
// destruction -- directly, in a held struct, an array or a named type over one --
// decides it at once.
func TestNeedsDestructionHeldStructs() testing.TestResult {
	var plain @Type = oneField(TypInt())
	var owning @Type = oneField(MakeManagedPtrType(TypInt()))
	if pairStruct(plain, plain).NeedsDestruction() { return fail("two plain structs") }
	if !pairStruct(plain, owning).NeedsDestruction() {
		return fail("a plain struct, then an owning one")
	}
	if !pairStruct(owning, plain).NeedsDestruction() {
		return fail("an owning struct, then a plain one")
	}
	if !pairStruct(plain, MakeManagedSliceType(TypInt())).NeedsDestruction() {
		return fail("a plain struct, then a managed-slice")
	}
	var named @Type = MakeNamedType("main.Own")
	named.Underlying = owning
	if !pairStruct(MakeArrayType(plain, 2), MakeReadonlyType(named)).NeedsDestruction() {
		return fail("an array of plain structs, then a readonly named type over an owning one")
	}
	if !oneField(oneField(oneField(owning))).NeedsDestruction() {
		return fail("an owning struct three structs down")
	}
	return ""
}

// Structs held by value inside each other, deepLevels deep -- struct { a int8; b S }
// -- need destruction only when the innermost one holds a managed field; the first
// field of a struct over the whole chain is decided before its second.
func TestDeepNeedsDestructionStructs() testing.TestResult {
	var t @Type = pairStruct(TypInt8(), TypInt64())
	for i := 0; i < deepLevels; i++ {
		t = pairStruct(TypInt8(), t)
	}
	var bottom @Type = t
	for bottom.Fields[1].Type.Kind == TYP_STRUCT {
		bottom = bottom.Fields[1].Type
	}
	var plain bool = t.NeedsDestruction()
	var over bool = pairStruct(t, MakeManagedPtrType(TypInt())).NeedsDestruction()
	bottom.Fields[1].Type = MakeManagedPtrType(TypInt())
	var owning bool = t.NeedsDestruction()
	bottom = nil
	for t.Kind == TYP_STRUCT {
		t = t.Fields[1].Type
	}
	if plain { return fail("a deep chain of plain structs needs no destruction") }
	if !over { return fail("a managed field after a deep plain chain needs destruction") }
	if !owning { return fail("a managed field at the bottom of a deep chain needs destruction") }
	return ""
}

// A chain mixing every level the decision walks down -- struct { a int8; b [1]readonly
// N } with N named over the next struct -- 50,000 levels deep.
func TestDeepNeedsDestructionMixedChain() testing.TestResult {
	var levels int = 50000
	var t @Type = pairStruct(TypInt8(), TypInt64())
	var bottom @Type = t
	for i := 0; i < levels; i++ {
		var named @Type = MakeNamedType("N")
		named.Underlying = t
		t = pairStruct(TypInt8(), MakeArrayType(MakeReadonlyType(named), 1))
	}
	var plain bool = t.NeedsDestruction()
	bottom.Fields[0].Type = MakeManagedSliceType(TypInt())
	var owning bool = t.NeedsDestruction()
	bottom = nil
	for t.Kind == TYP_STRUCT && len(t.Fields) == 2 && t.Fields[1].Type.Kind == TYP_ARRAY {
		t = t.Fields[1].Type.Elem.Elem.Underlying
	}
	if plain { return fail("a deep mixed chain of plain structs needs no destruction") }
	if !owning { return fail("a managed-slice at the bottom of a deep mixed chain needs destruction") }
	return ""
}
