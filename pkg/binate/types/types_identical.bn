package "pkg/binate/types"

// Identical reports whether types a and b are structurally identical.
// Const wrappers are transparent here — `const T` and `T` are
// identical; a const-drop is rejected at assignment sites by
// `AssignableTo` specifically.
func (a @Type) Identical(b @Type) bool {
	return identicalWalk(a, b, false)
}

// IdenticalStrict is Identical but with `readonly` treated as SIGNIFICANT: a
// `readonly T` is NOT identical to `T` at any nesting depth.  Identical peels
// `readonly` (via resolveAliasAndConst) — correct for shape predicates, but WRONG
// as a generic-instantiation cache key: `Foo[readonly T]` and `Foo[T]` are
// DISTINCT monomorphizations (their substituted method signatures differ), and
// the two already carry distinct mangled names (typeNameImpl keeps `readonly `).
// Keying the instantiation cache on Identical merges them, so a `readonly` type
// argument from one instantiation leaks into another's cache slot — surfacing
// when one checker checks multiple bodies (bnlint's multi-root lint) as, e.g.,
// `format`'s `vec.Vec[@[]readonly char]` poisoning `setfn`'s `iter.Iterator[@[]char]`
// (spurious "cannot assign @[]readonly uint8 to @[]uint8").
//
// Only alias wrappers are peeled (readonly is kept); composite element / field /
// parameter / result types compare strictly; non-composite leaves defer to
// Identical (readonly cannot occur there, and Identical carries the (TpOwner,
// TpIndex) type-param identity and cross-package named/interface identity).
func (a @Type) IdenticalStrict(b @Type) bool {
	return identicalWalk(a, b, true)
}

// FieldByName returns the field with the given name, or nil.  A blank `_`
// field is unnamed padding: it is never found (so it can be neither selected
// nor named as a composite-literal key).
func (t @Type) FieldByName(name *[]readonly char) @Field {
	if t == nil {
		return nil
	}
	if len(name) == 1 && name[0] == '_' {
		return nil
	}
	for i := 0; i < len(t.Fields); i++ {
		if CharEq(t.Fields[i].Name, name) {
			return t.Fields[i]
		}
	}
	return nil
}

// NeedsDestruction reports whether values of type t require cleanup when
// their containing managed allocation is freed. This is true for:
//   - @T (managed pointers) — always
//   - @[]T (managed-slices) — always
//   - struct types with any field that needs destruction
//   - [N]T arrays where T needs destruction
func (t @Type) NeedsDestruction() bool {
	beginLayout()
	var r bool = needsDestruction(t)
	endLayout()
	return r
}
