package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for types_identical.bn.  The helper `fail` is in test_helpers_test.bn.

// sharedPairChain returns `Pair[P, P]` nested n levels deep, each level's two
// arguments the one type below it, over `Pair[leaf, leaf]`.
func sharedPairChain(n int, leaf @Type) @Type {
	var t @Type = leaf
	for i := 0; i <= n; i++ {
		var p @Type = MakeNamedType("main.Pair")
		var args @[]@Type = make_slice(@Type, 2)
		args[0] = t
		args[1] = t
		p.InstArgs = args
		t = p
	}
	return t
}

// A type is identical to itself at once: an instance forty levels deep whose
// two arguments are one type is not compared by walking both arguments at every
// level.
func TestIdenticalToItselfSharedArgs() testing.TestResult {
	var t @Type = sharedPairChain(40, TypInt())
	if !t.Identical(t) { return fail("identical to itself") }
	if !t.IdenticalStrict(t) { return fail("strictly identical to itself") }
	var alias @Type = MakeAliasType("main.P", t)
	if !alias.Identical(t) { return fail("an alias is identical to its target") }
	if !t.IdenticalStrict(alias) { return fail("a target is strictly identical to its alias") }
	return ""
}

// Two instances built apart are still compared by their arguments: equal ones
// are identical, and ones differing at the bottom are not.
func TestIdenticalSharedArgsBuiltApart() testing.TestResult {
	var a @Type = sharedPairChain(6, TypInt())
	var b @Type = sharedPairChain(6, TypInt())
	if !a.Identical(b) { return fail("equal chains built apart are identical") }
	if !a.IdenticalStrict(b) { return fail("equal chains built apart are strictly identical") }
	var c @Type = sharedPairChain(6, TypBool())
	if a.Identical(c) { return fail("chains over int and bool are not identical") }
	var ro @Type = sharedPairChain(6, MakeReadonlyType(TypInt()))
	if !a.Identical(ro) { return fail("a readonly leaf is identical") }
	return ""
}
