// Type identity without recursion: Identical and IdenticalStrict compare two types
// part by part from an explicit stack of pairs, so types nested to any depth compare
// without exhausting the compiler's stack.
package "pkg/binate/types"

import "pkg/std/vec"

// identPair is a pair of types still to compare: strictly (readonly significant, as
// IdenticalStrict) or not (as Identical).
type identPair struct {
	a      @Type
	b      @Type
	strict bool
}

// identStack holds the pairs an identity walk has still to compare, kept from one walk
// to the next; a walk leaves it as it found it.
var identStack @vec.Vec[identPair]

// identicalWalk reports whether a and b are identical -- strictly when strict --
// comparing their parts from identStack.  A pair's parts are pushed last first, so they
// are compared in the order they appear, each one's own parts before the next, and the
// first mismatch ends the walk.
func identicalWalk(a @Type, b @Type, strict bool) bool {
	if identStack == nil { identStack = vec.New[identPair]() }
	var base int = identStack.Len()
	var ok bool = identicalStep(a, b, strict)
	for ok && identStack.Len() > base {
		p, _ := identStack.Pop()
		ok = identicalStep(p.a, p.b, p.strict)
	}
	for identStack.Len() > base {
		_, _ = identStack.Pop()
	}
	return ok
}

// pushIdent adds the pair (a, b) for identicalWalk to compare.
func pushIdent(a @Type, b @Type, strict bool) {
	var p identPair
	p.a = a
	p.b = b
	p.strict = strict
	identStack.Push(p)
}

// identicalStep compares a and b themselves, pushing the pairs of their parts for
// identicalWalk to compare, and reports whether they can still be identical.
func identicalStep(a @Type, b @Type, strict bool) bool {
	if strict {
		// Only alias wrappers are peeled (readonly is kept).
		a = a.ResolveAlias()
		b = b.ResolveAlias()
	} else {
		a = ResolveAliasAndConst(a)
		b = ResolveAliasAndConst(b)
	}
	// A type is identical to itself.  Comparing an instance with itself by its
	// arguments instead walks every argument, which is exponential in the depth
	// when the arguments share a type (`Pair[P, P]`, P itself `Pair[Q, Q]`, …).
	if a == b {
		return true
	}
	if a == nil || b == nil {
		return false
	}
	if a.Kind != b.Kind {
		return false
	}
	if strict { return strictStep(a, b) }
	if a.Kind == TYP_TYPE_PARAM {
		// Two type parameters are identical iff they are the SAME
		// parameter — same owning generic decl (TpOwner) and position
		// (TpIndex), per the (Owner, Index) identity rule (types.bni).
		// Without this arm distinct params (`A` vs `B`) fell through to
		// the catchall `return true`, so the generic-instantiation
		// cache (lookupCachedInstantiation) aliased `Foo[A]` and
		// `Foo[B]` — corrupting substituted types and constraint checks
		// (an unsound accept / wrong reject for multi-type-param
		// generics).
		return a.TpOwner == b.TpOwner && a.TpIndex == b.TpIndex
	}
	if a.Kind == TYP_POINTER || a.Kind == TYP_MANAGED_PTR || a.Kind == TYP_SLICE ||
			a.Kind == TYP_MANAGED_SLICE || a.Kind == TYP_INTERFACE_VALUE ||
			a.Kind == TYP_INTERFACE_VALUE_MANAGED {
		// Interface values agree iff their wrapped interfaces do: the 2-word
		// {data, vtable} layout is shared across all iface-values, but type
		// identity is nominal.
		pushIdent(a.Elem, b.Elem, false)
		return true
	}
	if a.Kind == TYP_ARRAY {
		// An array whose length depends on a type parameter has a placeholder
		// ArrayLen: it is never identical to a concrete array (two dependent
		// arrays compare by placeholder, as each instantiation checks them).
		if a.ArrayLenDependent != b.ArrayLenDependent || a.ArrayLen != b.ArrayLen { return false }
		pushIdent(a.Elem, b.Elem, false)
		return true
	}
	if a.Kind == TYP_STRUCT {
		return structFieldsStep(a, b, false)
	}
	if a.Kind == TYP_FUNC || a.Kind == TYP_FUNC_VALUE || a.Kind == TYP_MANAGED_FUNC_VALUE {
		// Structural signature compare for both TYP_FUNC (named
		// top-level functions) and the function-value variants
		// (`*func(...)` / `@func(...)`).  Without it, two function-
		// values with the same Kind but different params or
		// results would fall through to the catchall `return true`
		// at the bottom — silently treating, say, `*func(int) int`
		// as Identical to `*func(int) bool`.  AssignableTo would
		// then accept the mismatched assignment, producing wrong
		// code (a callee returning int read by the caller as
		// bool, etc.).
		return signatureStep(a, b, false)
	}
	// For INT, BOOL, STRING, VOID, NIL, UNTYPED_*, NAMED — match by kind and name
	if a.Kind == TYP_INT {
		// Every integer type is one of the predeclared singletons, each with
		// its own name; two of them are identical only when they are the same
		// type.  Width and signedness do not decide it: `int` and `int64` share
		// both on a 64-bit target (as `int` and `int32` do on a 32-bit one) yet
		// are distinct types, and treating them as one would make `Box[int]`
		// and `Box[int64]` a single generic instance and accept `*int` for
		// `*int64` on one target but not the other.  `byte` and `char` ARE
		// `uint8` (the same singleton).
		return CharEq(a.Name, b.Name)
	}
	if a.Kind == TYP_FLOAT {
		return a.Width == b.Width
	}
	if a.Kind == TYP_NAMED {
		return CharEq(NamedIdentityName(a), NamedIdentityName(b)) && instArgsStep(a, b)
	}
	if a.Kind == TYP_INTERFACE {
		// Two interface declarations are identical iff they are
		// the same nominal declaration — keyed on (Pkg, Name).
		return CharEq(a.Pkg, b.Pkg) && CharEq(a.Name, b.Name) && instArgsStep(a, b)
	}
	if a.Kind == TYP_TUPLE {
		return resultsStep(a, b, false)
	}
	// BOOL, STRING, VOID, NIL, UNTYPED_INT, UNTYPED_BOOL — same kind is enough
	return true
}

// strictStep is identicalStep for a strict pair a, b of the same kind: readonly is
// significant, composite parts compare strictly, and any other kind -- where readonly
// cannot occur -- compares as Identical does, which carries the (TpOwner, TpIndex)
// type-param identity and the cross-package named / interface identity.
func strictStep(a @Type, b @Type) bool {
	if a.Kind == TYP_READONLY || a.Kind == TYP_POINTER || a.Kind == TYP_MANAGED_PTR ||
			a.Kind == TYP_SLICE || a.Kind == TYP_MANAGED_SLICE || a.Kind == TYP_INTERFACE_VALUE ||
			a.Kind == TYP_INTERFACE_VALUE_MANAGED {
		pushIdent(a.Elem, b.Elem, true)
		return true
	}
	if a.Kind == TYP_ARRAY {
		if a.ArrayLenDependent != b.ArrayLenDependent || a.ArrayLen != b.ArrayLen { return false }
		pushIdent(a.Elem, b.Elem, true)
		return true
	}
	if a.Kind == TYP_STRUCT { return structFieldsStep(a, b, true) }
	if a.Kind == TYP_FUNC || a.Kind == TYP_FUNC_VALUE || a.Kind == TYP_MANAGED_FUNC_VALUE {
		return signatureStep(a, b, true)
	}
	if a.Kind == TYP_TUPLE { return resultsStep(a, b, true) }
	return identicalStep(a, b, false)
}

// structFieldsStep compares structs a and b: named ones by name; anonymous ones field
// by field, names in order here and types pushed.
func structFieldsStep(a @Type, b @Type, strict bool) bool {
	// Named structs: identical iff same name
	if len(a.Name) > 0 || len(b.Name) > 0 {
		return CharEq(a.Name, b.Name)
	}
	// Anonymous structs: structural equivalence (names + types in order)
	if len(a.Fields) != len(b.Fields) {
		return false
	}
	for i := 0; i < len(a.Fields); i++ {
		if !CharEq(a.Fields[i].Name, b.Fields[i].Name) {
			return false
		}
	}
	for i := len(a.Fields) - 1; i >= 0; i-- {
		pushIdent(a.Fields[i].Type, b.Fields[i].Type, strict)
	}
	return true
}

// signatureStep compares function types a and b: parameters and results pushed (the
// results first, to be compared after the parameters), and variadic-ness here.
func signatureStep(a @Type, b @Type, strict bool) bool {
	if len(a.Params) != len(b.Params) || len(a.Results) != len(b.Results) {
		return false
	}
	// Variadic-ness is part of signature identity: `func f(xs ...int)` is
	// distinct from `func g(xs *[]int)` (func.variadic.identity).  Missing
	// this makes a variadic and a fixed-`*[]T` func interchangeable, which
	// would unsoundly accept func-value / interface / method-value
	// assignments across the two.
	if FuncIsVariadic(a) != FuncIsVariadic(b) {
		return false
	}
	if !resultsStep(a, b, strict) { return false }
	for i := len(a.Params) - 1; i >= 0; i-- {
		pushIdent(a.Params[i].Type, b.Params[i].Type, strict)
	}
	return true
}

// resultsStep compares the results of function or tuple types a and b, pushed.
func resultsStep(a @Type, b @Type, strict bool) bool {
	if len(a.Results) != len(b.Results) {
		return false
	}
	for i := len(a.Results) - 1; i >= 0; i-- {
		pushIdent(a.Results[i], b.Results[i], strict)
	}
	return true
}

// instArgsStep compares the type arguments of the named or interface types a and b,
// whose names agree, when both are generic instances, pushing the pairs.  An
// instance's name spells a type parameter by its bare name, so instances over two
// generics' same-named parameters — `N[T]` written in `S[T any]`, and N's own `N[T]` —
// share a name, while a type parameter's identity is its owner and position (the
// TYP_TYPE_PARAM arm of identicalStep).  Without this, S's `N[T]` is taken for N's own,
// whose fields and methods are in N's parameter: `x.get().v` in a generic over
// `@Get[N[T]]` has N's `T`, not the generic's, and is reported as "cannot assign T to T".
func instArgsStep(a @Type, b @Type) bool {
	if len(a.InstArgs) == 0 || len(b.InstArgs) == 0 { return true }
	if len(a.InstArgs) != len(b.InstArgs) { return false }
	for i := len(a.InstArgs) - 1; i >= 0; i-- {
		pushIdent(a.InstArgs[i], b.InstArgs[i], false)
	}
	return true
}
