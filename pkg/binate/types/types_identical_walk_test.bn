package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for types_identical_walk.bn, and the chains of types nested far deeper than a
// walk with one stack frame per level could go that the other walks' deep tests use
// too.  Each deep test releases its chains a link at a time (dropLinks), as spec
// §18.2's note says to: releasing one whole would nest one destruction per level.  The
// TestDeep tests are skipped where TestLayoutDeep is (scripts/unittest/*.skip.*).

// linkKinds is how many kinds of link deepLink makes: a pointer, a managed-pointer, a
// raw and a managed-slice, a one-element array, an anonymous struct, a function value
// and a generic instance.  The instance, last, does not show in a type's name.
const linkKinds int = 8

// deepLink returns a type of link kind k over t, built apart from any other (the
// constructors that intern a wrapper on its element are not used).
func deepLink(k int, t @Type) @Type {
	if k == 5 {
		var fs @[]@Field = make_slice(@Field, 1)
		fs[0] = makeField("x", t)
		return MakeStructType("", fs)
	}
	if k == 6 {
		var p @Param = make(Param)
		p.Type = t
		var ps @[]@Param = make_slice(@Param, 1)
		ps[0] = p
		var rs @[]@Type = make_slice(@Type, 1)
		rs[0] = TypInt()
		return MakeFuncValueType(ps, rs)
	}
	if k == 7 {
		var n @Type = MakeNamedType("main.N")
		var args @[]@Type = make_slice(@Type, 1)
		args[0] = t
		n.InstArgs = args
		return n
	}
	var w @Type = make(Type)
	w.Elem = t
	if k == 0 {
		w.Kind = TYP_POINTER
	} else if k == 1 {
		w.Kind = TYP_MANAGED_PTR
	} else if k == 2 {
		w.Kind = TYP_SLICE
	} else if k == 3 {
		w.Kind = TYP_MANAGED_SLICE
	} else {
		w.Kind = TYP_ARRAY
		w.ArrayLen = 1
	}
	return w
}

// deepChild returns the type a link of deepLink holds.
func deepChild(t @Type) @Type {
	if t.Kind == TYP_STRUCT { return t.Fields[0].Type }
	if t.Kind == TYP_FUNC_VALUE { return t.Params[0].Type }
	if t.Kind == TYP_NAMED { return t.InstArgs[0] }
	return t.Elem
}

// deepChain returns n links over leaf, cycling through the first kinds link kinds
// from the innermost link out.
func deepChain(n int, kinds int, leaf @Type) @Type {
	var t @Type = leaf
	for i := 0; i < n; i++ {
		t = deepLink(i % kinds, t)
	}
	return t
}

// dropLinks releases the top n links of the chain *p, one at a time, leaving what is
// under them in *p.  The caller's variable is the chain's only reference, so each link
// is freed as it is left and no destruction nests.
func dropLinks(p *@Type, n int) {
	for i := 0; i < n; i++ {
		*p = deepChild(*p)
	}
}

// innermostLink returns the innermost of the n links of the chain t: a pointer, the
// first link kind.
func innermostLink(t @Type, n int) @Type {
	for i := 1; i < n; i++ {
		t = deepChild(t)
	}
	return t
}

// Chains of every link kind deepLevels long, built apart, compare part by part: equal
// ones are identical, and IdenticalStrict too (below the outermost link, a generic
// instance, it compares type arguments as Identical does), and ones differing only at
// the bottom -- in the leaf, or in one link more -- are not.
func TestDeepIdentical() testing.TestResult {
	var a @Type = deepChain(deepLevels, linkKinds, MakeNamedType("main.L"))
	var b @Type = deepChain(deepLevels, linkKinds, MakeNamedType("main.L"))
	var bottom @Type = innermostLink(b, deepLevels)
	var equal bool = a.Identical(b) && a.IdenticalStrict(b)
	bottom.Elem = TypBool()
	var leafDiffers bool = !a.Identical(b) && !b.IdenticalStrict(a)
	bottom.Elem = deepLink(0, MakeNamedType("main.L"))
	var linkMore bool = !a.Identical(b) && !b.Identical(a)
	bottom = nil
	dropLinks(&a, deepLevels)
	dropLinks(&b, deepLevels)
	if !equal { return fail("equal deep chains built apart must be identical, strictly too") }
	if !leafDiffers { return fail("deep chains over different leaves must not be identical") }
	if !linkMore { return fail("deep chains one link apart must not be identical") }
	return ""
}

// A readonly at the bottom of a deep chain of the link kinds that compare their parts
// strictly is significant only to IdenticalStrict.
func TestDeepIdenticalStrictReadonly() testing.TestResult {
	var a @Type = deepChain(deepLevels, linkKinds - 1, TypInt())
	var b @Type = deepChain(deepLevels, linkKinds - 1, TypInt())
	var bottom @Type = innermostLink(b, deepLevels)
	var equal bool = a.IdenticalStrict(b)
	bottom.Elem = MakeReadonlyType(TypInt())
	var loose bool = a.Identical(b)
	var strict bool = a.IdenticalStrict(b)
	bottom = nil
	dropLinks(&a, deepLevels)
	dropLinks(&b, deepLevels)
	if !equal { return fail("equal deep chains built apart must be strictly identical") }
	if !loose { return fail("a readonly at the bottom must not matter to Identical") }
	if strict { return fail("a readonly at the bottom must matter to IdenticalStrict") }
	return ""
}

// walkSig returns func(p0, ...p1) (r0, r1) over named types built apart, the last
// parameter's type a slice of p1, variadic when variadic.
func walkSig(p0 @[]char, p1 @[]char, r0 @[]char, r1 @[]char, variadic bool) @Type {
	var ps @[]@Param = make_slice(@Param, 2)
	ps[0] = make(Param)
	ps[0].Type = MakeNamedType(p0)
	ps[1] = make(Param)
	ps[1].Type = deepLink(2, MakeNamedType(p1))
	ps[1].IsVariadic = variadic
	var rs @[]@Type = make_slice(@Type, 2)
	rs[0] = MakeNamedType(r0)
	rs[1] = MakeNamedType(r1)
	return MakeFuncType(ps, rs)
}

// walkStruct returns struct { n0 t0; n1 t1 } over named types built apart.
func walkStruct(n0 @[]char, t0 @[]char, n1 @[]char, t1 @[]char) @Type {
	var fs @[]@Field = make_slice(@Field, 2)
	fs[0] = makeField(n0, MakeNamedType(t0))
	fs[1] = makeField(n1, MakeNamedType(t1))
	return MakeStructType("", fs)
}

// walkTuple returns the tuple (t0, t1) over named types built apart.
func walkTuple(t0 @[]char, t1 @[]char) @Type {
	var rs @[]@Type = make_slice(@Type, 2)
	rs[0] = MakeNamedType(t0)
	rs[1] = MakeNamedType(t1)
	return MakeTupleType(rs)
}

// Each composite kind's parts are compared, over leaves built apart so that no pair is
// decided by being one type: equal ones are identical, strictly too, and a mismatch in
// any one position -- a parameter, a result, variadic-ness, a field's name or type, a
// tuple's result, a type argument -- is not.
func TestIdenticalWalkParts() testing.TestResult {
	var sig @Type = walkSig("P", "Q", "P", "Q", false)
	var sig2 @Type = walkSig("P", "Q", "P", "Q", false)
	if !sig.Identical(sig2) || !sig.IdenticalStrict(sig2) {
		return fail("equal signatures built apart")
	}
	if sig.Identical(walkSig("Q", "Q", "P", "Q", false)) { return fail("the first parameter differs") }
	if sig.Identical(walkSig("P", "P", "P", "Q", false)) { return fail("the last parameter differs") }
	if sig.Identical(walkSig("P", "Q", "P", "P", false)) { return fail("the last result differs") }
	if sig.Identical(walkSig("P", "Q", "P", "Q", true)) { return fail("variadic-ness differs") }
	var st @Type = walkStruct("x", "P", "y", "Q")
	var st2 @Type = walkStruct("x", "P", "y", "Q")
	if !st.Identical(st2) || !st.IdenticalStrict(st2) {
		return fail("equal anonymous structs built apart")
	}
	if st.Identical(walkStruct("x", "P", "z", "Q")) { return fail("a field's name differs") }
	if st.Identical(walkStruct("x", "P", "y", "P")) { return fail("a field's type differs") }
	if !walkTuple("P", "Q").Identical(walkTuple("P", "Q")) { return fail("equal tuples built apart") }
	if walkTuple("P", "Q").Identical(walkTuple("Q", "Q")) { return fail("a tuple's result differs") }
	var n1 @Type = deepLink(linkKinds - 1, MakeNamedType("P"))
	if !n1.Identical(deepLink(linkKinds - 1, MakeNamedType("P"))) { return fail("equal instances") }
	if n1.Identical(deepLink(linkKinds - 1, MakeNamedType("Q"))) {
		return fail("type arguments differ")
	}
	return ""
}
