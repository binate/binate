package "pkg/binate/types"

import "pkg/stdx/slices"

// ============================================================
// Methods (registered on named types)
// ============================================================

// MakeMethod constructs a Method record. FuncType must include the
// receiver as Params[0].
func MakeMethod(name @[]char, recvType @Type, funcType @Type) @Method {
	var m @Method = make(Method)
	m.Name = name
	m.RecvType = recvType
	m.FuncType = funcType
	return m
}

// AddMethod appends m to a named type's or interface's method set.
// Returns false (without modifying t) if a method with the same name
// is already present, so callers can report duplicate-decl errors.
//
// Accepts TYP_NAMED, TYP_INTERFACE, and the universe primitives
// (TYP_INT / TYP_FLOAT / TYP_BOOL) — the last so the stdlib
// carve-out can hang the
// canonical Comparable / Stringer / etc. methods on the
// primitive singletons.  Note: mutations to a primitive
// singleton persist for the lifetime of the process; callers
// that care about test isolation should use a per-checker
// reset helper.
func (t @Type) AddMethod(m @Method) bool {
	if t == nil || m == nil {
		return false
	}
	if !typeAcceptsMethods(t) {
		return false
	}
	for i := 0; i < len(t.Methods); i++ {
		if charEq(t.Methods[i].Name, m.Name) {
			return false
		}
	}
	t.Methods = slices.Append[@Method](t.Methods, m)
	return true
}

// SetOrAppendMethod replaces an existing method on t with the same
// name in place, or appends m if no match.  REPL redefinition uses
// this so a method can be re-typed at the prompt without tripping
// AddMethod's duplicate-decl check.  Same accepted-receiver shapes
// as AddMethod (TYP_NAMED / TYP_INTERFACE / universe primitives).
func (t @Type) SetOrAppendMethod(m @Method) bool {
	if t == nil || m == nil {
		return false
	}
	if !typeAcceptsMethods(t) {
		return false
	}
	for i := 0; i < len(t.Methods); i++ {
		if charEq(t.Methods[i].Name, m.Name) {
			t.Methods[i] = m
			return true
		}
	}
	t.Methods = slices.Append[@Method](t.Methods, m)
	return true
}

// typeAcceptsMethods reports whether t is a Type kind that can
// carry a method set: declared types (TYP_NAMED), declared
// interfaces (TYP_INTERFACE), or universe primitives (the
// stdlib carve-out).
// The collectMethodDecl pass enforces the carve-out gate
// (AllowUniverseRecv); this predicate is purely about whether
// the @Type record has somewhere to store the method.
func typeAcceptsMethods(t @Type) bool {
	if t == nil { return false }
	if t.Kind == TYP_NAMED { return true }
	if t.Kind == TYP_INTERFACE { return true }
	if t.Kind == TYP_INT { return true }
	if t.Kind == TYP_FLOAT { return true }
	if t.Kind == TYP_BOOL { return true }
	return false
}

// LookupMethod returns the method named `name` on the named type,
// interface, or universe-primitive t, or nil if no such method is
// registered.  Universe-primitive lookups support the stdlib
// carve-out: impls declared
// in `pkg/builtins/lang` (e.g., `func (x int) Compare(...) int`) hang on
// the primitive's singleton method set and are reachable from
// every package via this lookup.
func (t @Type) LookupMethod(name *[]readonly char) @Method {
	if t == nil { return nil }
	if !typeAcceptsMethods(t) {
		return nil
	}
	for i := 0; i < len(t.Methods); i++ {
		if charEq(t.Methods[i].Name, name) {
			return t.Methods[i]
		}
	}
	return nil
}

// ReceiverBaseNamed unwraps a receiver type's outer pointer/managed/const
// wrappers and returns the underlying named type (or universe primitive
// for the stdlib carve-out), or
// nil if the receiver is not (a wrapper around) a method-bearing type.
func (t @Type) ReceiverBaseNamed() @Type {
	if t == nil {
		return nil
	}
	// An alias is transparent to its target, so an alias receiver
	// (`type AB = @Box; ab.getV` / `impl AB : Getter`) resolves to the same
	// method-bearing named type as the target.  Peel it before the wrapper
	// unwinding below, so method-value resolution and impl-satisfaction see the
	// target's method set.  IR-gen mirrors this alias resolution for the impl
	// vtable key (ir.recvBaseTypeName) so dispatch lands on the target's methods
	// rather than a null slot keyed on the alias name (bug 754).
	if t.Kind == TYP_ALIAS {
		return t.Target.ReceiverBaseNamed()
	}
	if t.Kind == TYP_POINTER || t.Kind == TYP_MANAGED_PTR || t.Kind == TYP_READONLY {
		return t.Elem.ReceiverBaseNamed()
	}
	if t.Kind == TYP_INT || t.Kind == TYP_FLOAT || t.Kind == TYP_BOOL {
		return t
	}
	if t.Kind == TYP_NAMED {
		return t
	}
	return nil
}
