package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for types_method.bn.

// primMethod returns a method named name on the universe primitive recv.
func primMethod(name @[]char, recv @Type) @Method {
	var m @Method = make(Method)
	m.Name = name
	m.RecvType = recv
	return m
}

// A method on a universe primitive persists on its singleton until
// ResetPrimitiveMethods clears it; then the same name may be added again, as the
// next compilation's check of pkg/builtins/lang does.
func TestResetPrimitiveMethods() testing.TestResult {
	ResetPrimitiveMethods()
	if !TypInt().AddMethod(primMethod("ResetProbe", TypInt())) {
		return fail("adding a method to int failed")
	}
	if TypInt().AddMethod(primMethod("ResetProbe", TypInt())) {
		return fail("a second method of the same name should be refused")
	}
	if !TypBool().AddMethod(primMethod("ResetProbe", TypBool())) {
		return fail("adding a method to bool failed")
	}
	ResetPrimitiveMethods()
	if TypInt().LookupMethod("ResetProbe") != nil || TypBool().LookupMethod("ResetProbe") != nil {
		return fail("ResetPrimitiveMethods should clear the primitives' methods")
	}
	if !TypInt().AddMethod(primMethod("ResetProbe", TypInt())) {
		return fail("after the reset the method should be accepted again")
	}
	ResetPrimitiveMethods()
	return ""
}
