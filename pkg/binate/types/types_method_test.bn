package "pkg/binate/types"

import "pkg/builtins/testing"

// Test for the type-method operations in types_method.bn — MakeMethod builds a
// method record, AddMethod registers it on a receiver type, and LookupMethod finds
// it (returning nil on a miss).  clearPrimitiveMethodSets keeps the shared TypInt
// singleton clean across tests.  Shared fail/clearPrimitiveMethodSets helpers live
// in the other types *_test.bn files (same package, same test build).
func TestTypeMethodAddAndLookup() testing.TestResult {
	clearPrimitiveMethodSets()
	var noParams @[]@Param
	var noResults @[]@Type
	var ft @Type = MakeFuncType(noParams, noResults)
	var m @Method = MakeMethod("TypeMethodProbe", TypInt(), ft)
	if !TypInt().AddMethod(m) {
		clearPrimitiveMethodSets()
		return fail("AddMethod should accept a fresh method on TypInt")
	}
	if TypInt().LookupMethod("TypeMethodProbe") == nil {
		clearPrimitiveMethodSets()
		return fail("LookupMethod should find the just-added method")
	}
	if TypInt().AddMethod(m) {
		clearPrimitiveMethodSets()
		return fail("AddMethod should reject a duplicate method name")
	}
	clearPrimitiveMethodSets()
	return ""
}
