package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for types_method.bn.

// primMethod returns a method named name on the universe primitive recv.
func primMethod(name @[]char, recv @Type) @Method {
	var m @Method = make(Method)
	m.Name = name
	m.RecvType = recv
	return m
}

// A method on a universe primitive persists on its singleton until
// ResetPrimitiveMethods clears it; then the same name may be added again, as the
// next compilation's check of pkg/builtins/lang does.
func TestResetPrimitiveMethods() testing.TestResult {
	ResetPrimitiveMethods()
	if !TypInt().AddMethod(primMethod("ResetProbe", TypInt())) {
		return fail("adding a method to int failed")
	}
	if TypInt().AddMethod(primMethod("ResetProbe", TypInt())) {
		return fail("a second method of the same name should be refused")
	}
	if !TypBool().AddMethod(primMethod("ResetProbe", TypBool())) {
		return fail("adding a method to bool failed")
	}
	ResetPrimitiveMethods()
	if TypInt().LookupMethod("ResetProbe") != nil || TypBool().LookupMethod("ResetProbe") != nil {
		return fail("ResetPrimitiveMethods should clear the primitives' methods")
	}
	if !TypInt().AddMethod(primMethod("ResetProbe", TypInt())) {
		return fail("after the reset the method should be accepted again")
	}
	ResetPrimitiveMethods()
	return ""
}

// receiverLink returns an alias, a pointer or a readonly type over t, by k % 3, built
// apart from any other.
func receiverLink(k int, t @Type) @Type {
	if k % 3 == 0 { return MakeAliasType("main.A", t) }
	var w @Type = make(Type)
	w.Elem = t
	w.Kind = TYP_POINTER
	if k % 3 == 2 { w.Kind = TYP_READONLY }
	return w
}

// A receiver type's base is found through aliases, pointers and readonly wrappers
// deepLevels deep: the named type or universe primitive at the bottom, or nil over
// any other type.
func TestDeepReceiverBaseNamed() testing.TestResult {
	var n @Type = MakeNamedType("main.T")
	var bottom @Type = receiverLink(1, n)
	var t @Type = bottom
	for i := 2; i <= deepLevels; i++ {
		t = receiverLink(i, t)
	}
	var named bool = same(t.ReceiverBaseNamed(), n)
	bottom.Elem = TypInt()
	var prim bool = same(t.ReceiverBaseNamed(), TypInt())
	bottom.Elem = MakeStructType("", make_slice(@Field, 0))
	var other bool = t.ReceiverBaseNamed() == nil
	bottom = nil
	for t.Kind == TYP_ALIAS || t.Kind == TYP_POINTER || t.Kind == TYP_READONLY {
		if t.Kind == TYP_ALIAS {
			t = t.Target
		} else {
			t = t.Elem
		}
	}
	if !named { return fail("a deep receiver chain over a named type must reach it") }
	if !prim { return fail("a deep receiver chain over int must reach int") }
	if !other { return fail("a deep receiver chain over an anonymous struct has no base") }
	return ""
}

// An alias chain that loops (`type A = *A`, which the checker rejects) has no receiver
// base: the walk stops rather than going round forever.
func TestReceiverBaseNamedAliasLoop() testing.TestResult {
	var a @Type = MakeAliasType("main.A", nil)
	var p @Type = make(Type)
	p.Kind = TYP_POINTER
	p.Elem = a
	a.Target = p
	var base @Type = a.ReceiverBaseNamed()
	a.Target = nil
	if base != nil { return fail("a looping alias chain has no receiver base") }
	return ""
}

// A method declared by the last of a chain of interfaces deepLevels deep, each the
// next's parent, is found from the first.
func TestDeepLookupInterfaceMethod() testing.TestResult {
	var m @Method = make(Method)
	m.Name = "Get"
	var t @Type = MakeInterfaceType("main", "I")
	t.Methods = make_slice(@Method, 1)
	t.Methods[0] = m
	for i := 1; i < deepLevels; i++ {
		var child @Type = MakeInterfaceType("main", "I")
		child.Parents = make_slice(@Type, 1)
		child.Parents[0] = t
		t = child
	}
	var found bool = t.LookupInterfaceMethod("Get") == m
	var none bool = t.LookupInterfaceMethod("Put") == nil
	for i := 1; i < deepLevels; i++ {
		t = t.Parents[0]
	}
	if !found { return "the deepest parent's method is found" }
	if !none { return "a method no interface of the chain declares is not found" }
	return ""
}
