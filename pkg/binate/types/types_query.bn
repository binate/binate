package "pkg/binate/types"

import "pkg/binate/buf"
import "pkg/std/strings"

// QualifyName returns the fully-qualified `pkgPath.name` used for a named
// struct's mangling and identity, mirroring IR-gen's buildQualName /
// qualifyForCurrentModule byte-for-byte.  Idempotent: a name already
// containing '.' is returned unchanged.  An empty pkgPath returns the
// bare name (the REPL / unit-test path before a package context is set,
// matching qualifyForCurrentModule's empty-module passthrough).
func QualifyName(pkgPath @[]char, name @[]char) @[]char {
	if len(pkgPath) == 0 {
		return name
	}
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			return name
		}
	}
	var b @strings.Builder = strings.NewBuilder()
	b.Write(pkgPath)
	b.WriteByte('.')
	b.Write(name)
	return buf.CopyStr(b.String())
}

// ============================================================
// Type Queries
// ============================================================

// ResolveAlias follows alias chains and returns the underlying non-alias type.
func (t @Type) ResolveAlias() @Type {
	for t != nil && t.Kind == TYP_ALIAS {
		t = t.Target
	}
	return t
}

// peelNamedBounded follows a named-distinct type's Underlying chain (resolving
// any alias / readonly wrapper at each step) down to its base type, with a
// depth bound.  A CYCLIC named type — `type A B; type B A`, or self `type A A`
// — is rejected at definition by collectTypeDecl, but the bound guards the
// operand predicates here too: without it a cycle makes `==` (comparabilityKind)
// loop forever and `<` (IsNumeric → IsInteger / IsFloat) stack-overflow on a
// parseable-but-malformed input.  Returns the base type, or nil when the bound
// is exceeded (i.e. a cyclic type that slipped past the decl-time check).
func peelNamedBounded(t @Type) @Type {
	t = resolveAliasAndConst(t)
	var depth int = 0
	for t != nil && t.Kind == TYP_NAMED && t.Underlying != nil {
		if depth >= 1024 {
			return nil
		}
		t = resolveAliasAndConst(t.Underlying)
		depth = depth + 1
	}
	return t
}

// isInterfaceValueType reports whether t is an interface value — a raw `*I`
// (TYP_INTERFACE_VALUE) or a managed `@I` (TYP_INTERFACE_VALUE_MANAGED), the 2-word
// `{data, vtable}` shape.  Pass a peeled type; this does not peel wrappers.
func isInterfaceValueType(t @Type) bool {
	if t == nil {
		return false
	}
	return t.Kind == TYP_INTERFACE_VALUE || t.Kind == TYP_INTERFACE_VALUE_MANAGED
}

// ReinterpretBitCast returns v reinterpreted as the integer type t — the value
// a `bit_cast` to t produces: v truncated to t's width and, when t is signed
// and the resulting top bit is set, sign-extended.  Both the type checker
// (evalConstIntValue) and IR-gen (evalConstExpr) fold a constant bit_cast
// through this ONE function so they agree exactly — e.g. `bit_cast(int8, 253)`
// folds to -3 in both, letting the negative-shift-count gate reject a bit_cast
// that reinterprets a positive source into a negative count, and array
// dimensions / const values match what codegen emits.
//
// A non-integer t, or a width >= 64 (no truncation representable in the host
// int), returns v unchanged; for the sub-64-bit integer types (int8..int32 /
// uint8..uint32, and a 32-bit-target int/uint) the truncate+sign-extend is
// exact.  Assumes a >= 64-bit host int — true for every current build /
// conformance config (the compiler runs as a 64-bit binary).
func ReinterpretBitCast(v int, t @Type) int {
	var p @Type = peelNamedBounded(t)
	if p == nil || p.Kind != TYP_INT {
		return v
	}
	var w int = p.SizeOf() * 8
	if w <= 0 || w >= 64 {
		return v
	}
	var r int = v & ((1 << w) - 1)
	if p.Signed && (r & (1 << (w - 1))) != 0 {
		r = r - (1 << w)
	}
	return r
}

// IsInteger reports whether t is an integer type (including untyped int and named integer types).
func (t @Type) IsInteger() bool {
	var b @Type = peelNamedBounded(t)
	if b == nil {
		return false
	}
	return b.Kind == TYP_INT || b.Kind == TYP_UNTYPED_INT
}

// IsFloat reports whether t is a floating-point type (including untyped
// float and named float types).
func (t @Type) IsFloat() bool {
	var b @Type = peelNamedBounded(t)
	if b == nil {
		return false
	}
	return b.Kind == TYP_FLOAT || b.Kind == TYP_UNTYPED_FLOAT
}

// IsNumeric reports whether t is a numeric type (integer or float).
func (t @Type) IsNumeric() bool {
	return t.IsInteger() || t.IsFloat()
}

// SignedMinForWidth returns the most-negative value of a signed
// integer of the given bit width (8 → -128, 32 → INT32_MIN, 64 →
// INT64_MIN), as a 64-bit pattern.  The DivCheck divide-fault guard
// uses it to detect the signed MIN / -1 overflow.  Widths of 64 or
// more saturate at the int64 minimum (computing it as `1 << 63` would
// overflow into the sign bit).
func SignedMinForWidth(width int) int64 {
	if width >= 64 {
		return cast(int64, -9223372036854775807) - cast(int64, 1)
	}
	var shifted int64 = cast(int64, 1) << (width - 1)
	return cast(int64, 0) - shifted
}

// IsBool reports whether t is a boolean type (including untyped bool).
func (t @Type) IsBool() bool {
	var b @Type = peelNamedBounded(t)
	if b == nil {
		return false
	}
	return b.Kind == TYP_BOOL || b.Kind == TYP_UNTYPED_BOOL
}

// IsScalar reports whether t is a scalar type: an integer (incl. char,
// uint, the sized int/uint types), float, or bool — possibly via a
// named type, alias, or `readonly` modifier (those are seen through).
// Composites (slices, arrays, structs, pointers, managed pointers,
// function-value / interface-value types) are NOT scalar.  Used to
// enforce that const declarations carry a scalar type; non-scalar
// immutable values are expressed as `var X readonly T = ...`.
func (t @Type) IsScalar() bool {
	return t.IsInteger() || t.IsFloat() || t.IsBool()
}

// IsPointer reports whether t is a pointer type (raw or managed).
// Named-distinct types whose concrete underlying is a pointer are seen
// through (consistent with IsInteger); an opaque named type (nil
// Underlying) stays false because peelNamedBounded returns the bare
// TYP_NAMED.
func (t @Type) IsPointer() bool {
	t = peelNamedBounded(t)
	if t == nil {
		return false
	}
	return t.Kind == TYP_POINTER || t.Kind == TYP_MANAGED_PTR
}

// IsSlice reports whether t is a slice type (raw or managed).
// Named-distinct types whose concrete underlying is a slice are seen
// through (consistent with IsInteger); an opaque named type (nil
// Underlying) stays false because peelNamedBounded returns the bare
// TYP_NAMED.
func (t @Type) IsSlice() bool {
	t = peelNamedBounded(t)
	if t == nil {
		return false
	}
	return t.Kind == TYP_SLICE || t.Kind == TYP_MANAGED_SLICE
}

// comparabilityKind returns t's kind with alias, readonly, and
// named-distinct wrappers resolved away — the kind the == / != operand
// rules are applied to.  Returns TYP_VOID when t is nil.  Named types are
// followed to their underlying, so `type Pt struct{…}` is treated as a
// struct and `type Handle *T` as a pointer.
func comparabilityKind(t @Type) int {
	var b @Type = peelNamedBounded(t)
	if b == nil {
		return TYP_VOID
	}
	return b.Kind
}

// isUnnamedCompositeKind reports whether k is an unnamed composite type
// literal (slice/pointer/array/struct) — the kinds for which an unnamed
// value freely crosses a named-distinct boundary (Go's rule).  Func-value
// kinds are deliberately EXCLUDED: a named func-value type is NOMINAL for
// func values (Option A / B2 — `type Fn @func(int)int; var f Fn = g` where g
// is a `@func` value is rejected; Fn is constructible only from a func
// reference/literal).  See conformance/regressions/named-func-value-reject-value.
func isUnnamedCompositeKind(k int) bool {
	return k == TYP_SLICE || k == TYP_MANAGED_SLICE || k == TYP_POINTER || k == TYP_MANAGED_PTR ||
			k == TYP_ARRAY || k == TYP_STRUCT
}

// relationalOperandOK reports whether t is acceptable as an operand of a
// relational operator (< > <= >=).  Numeric types are; everything else
// (pointers, slices, structs, interface/func values, bool, nil) is not —
// ordering is defined only for numbers.  A type parameter / Self is NOT numeric,
// so ordering is not defined on it (spec §13.6): to order values of a type
// parameter, constrain it (e.g. `[T lang.Orderable]`) and call a method
// (`a.Compare(b) < 0`).  Only the error type (TYP_VOID) falls through here, to
// avoid cascading a diagnostic off an already-reported error.
func relationalOperandOK(t @Type) bool {
	if t.IsNumeric() {
		return true
	}
	return comparabilityKind(t) == TYP_VOID
}

// aggregateComparable reports whether a struct or array type supports == / !=
// — i.e. every transitive field / element is itself comparable.  Comparability
// bottoms out at scalars and pointers (which compare directly); a struct is
// comparable iff all its fields are, and an array iff its element type is.
// Slices, interface values, and function values are never comparable, so any
// aggregate transitively containing one is not.  A type parameter / Self is
// treated as comparable here so this predicate reports only the concrete
// slice/iface/func case; a comparison whose comparability actually depends on a
// type parameter is rejected up front by checkEqOperands via
// containsByValueTypeParam (comparison is not defined on type parameters), so it
// never reaches this predicate for that decision.  Termination is guaranteed: a
// struct cannot contain itself (or any cycle) by value — only through a pointer,
// which bottoms out without recursing.
func aggregateComparable(t @Type) bool {
	var k int = comparabilityKind(t)
	if k == TYP_INT || k == TYP_FLOAT || k == TYP_BOOL || k == TYP_UNTYPED_INT ||
			k == TYP_UNTYPED_FLOAT || k == TYP_UNTYPED_BOOL || k == TYP_POINTER || k == TYP_MANAGED_PTR ||
			k == TYP_NIL || k == TYP_VOID || k == TYP_TYPE_PARAM || k == TYP_SELF {
		return true
	}
	if k == TYP_STRUCT {
		var b @Type = peelNamedBounded(t)
		if b == nil {
			return false
		}
		for i := 0; i < len(b.Fields); i++ {
			if !aggregateComparable(b.Fields[i].Type) {
				return false
			}
		}
		return true
	}
	if k == TYP_ARRAY {
		var b @Type = peelNamedBounded(t)
		if b == nil || b.Elem == nil {
			return false
		}
		return aggregateComparable(b.Elem)
	}
	// slice, interface value, function value, or anything else: not comparable
	return false
}

// IsNillable reports whether t can be assigned nil. True for pointer
// types and function-value types (raw or managed). Function values
// have a 2-word {vtable, data} layout, but a nil function value is a
// meaningful state — both halves zero — and the assignment is
// accepted (slices, by contrast, reject nil-assignment and use bare-
// decl zero-init instead).
func (t @Type) IsNillable() bool {
	if t.IsPointer() { return true }
	t = resolveAliasAndConst(t)
	if t == nil { return false }
	return t.Kind == TYP_FUNC_VALUE || t.Kind == TYP_MANAGED_FUNC_VALUE
}

// funcIsVariadic reports whether a func-kind type's final parameter is
// variadic (`name ...T`; func.variadic.decl).  Variadic-ness is carried on the
// LAST Param (Param.IsVariadic) rather than the func Type so it survives
// receiver-prepend/drop and per-param generic substitution.  It is part of a
// func signature's type identity (func.variadic.identity, spec §10.3), so every
// func-type equality/assignability comparison consults this helper.  A non-func
// type (empty Params) is not variadic.
func funcIsVariadic(t @Type) bool {
	if t == nil { return false }
	n := len(t.Params)
	if n == 0 { return false }
	return t.Params[n - 1].IsVariadic
}

// funcSignaturesMatch reports whether a TYP_FUNC and a TYP_FUNC_VALUE
// (or TYP_MANAGED_FUNC_VALUE) have identical signatures: same number
// of params with identical types, same number of results with identical
// types, and the same variadic-ness. Param names are ignored — function-value
// types have anonymous params anyway.
func funcSignaturesMatch(fn @Type, fv @Type) bool {
	if fn == nil || fv == nil { return false }
	if len(fn.Params) != len(fv.Params) { return false }
	if len(fn.Results) != len(fv.Results) { return false }
	for i := 0; i < len(fn.Params); i++ {
		if !fn.Params[i].Type.Identical(fv.Params[i].Type) {
			return false
		}
	}
	for i := 0; i < len(fn.Results); i++ {
		if !fn.Results[i].Identical(fv.Results[i]) {
			return false
		}
	}
	// A variadic func is assignable only to a matching variadic func-value type
	// and vice versa (func.variadic.identity).
	if funcIsVariadic(fn) != funcIsVariadic(fv) {
		return false
	}
	return true
}

// SliceElem returns the element type of a slice or managed-slice, or nil if t is not a slice.
func (t @Type) SliceElem() @Type {
	t = resolveAliasAndConst(t)
	if t == nil {
		return nil
	}
	if t.Kind == TYP_SLICE || t.Kind == TYP_MANAGED_SLICE {
		return t.Elem
	}
	return nil
}

// PointerElem returns the element type of a pointer or managed pointer, or nil if not a pointer.
func (t @Type) PointerElem() @Type {
	t = resolveAliasAndConst(t)
	if t == nil {
		return nil
	}
	if t.Kind == TYP_POINTER || t.Kind == TYP_MANAGED_PTR {
		return t.Elem
	}
	return nil
}

// namedIdentityName returns the path-qualified identity name of a named
// type.  For a named STRUCT it is the underlying struct's qualified Name
// (e.g. "pkg/foo.Box") — the TYP_NAMED wrapper's own Name is the bare leaf
// ("Box"), which would false-match a same-short-named struct from another
// package.  For a named non-struct distinct type (e.g. `type Celsius int`)
// the wrapper's Name is the bare leaf too, so it is qualified with the
// wrapper's defining package (`.Pkg`, stamped at type-decl finalization) —
// otherwise two same-short-named cross-package scalars (`red.T` / `blue.T`,
// each `type T int`) would false-match and wrongly inter-assign.  A wrapper
// with no defining package (`.Pkg` empty — REPL / synthetic) qualifies to its
// bare Name, preserving the prior behavior for those.
func namedIdentityName(t @Type) @[]char {
	if t.Underlying != nil && t.Underlying.Kind == TYP_STRUCT && len(t.Underlying.Name) > 0 {
		return t.Underlying.Name
	}
	return QualifyName(t.Pkg, t.Name)
}

// distinctNamedInts reports whether a and b are two DIFFERENT predeclared
// integer types (int, int8, int16, int32, int64, uint, …) — i.e. both TYP_INT
// but with different names.  `Identical` compares only width + signedness, so
// `int` and `int64` look identical on a 64-bit target (and `int` / `int32` on a
// 32-bit one); this is the extra gate that keeps them DISTINCT for assignment,
// comparison, and arithmetic (Go's rule: a cast is required to mix them).
// Untyped int constants are TYP_UNTYPED_INT (not TYP_INT) and so are never
// caught here — they still coerce to any integer type.
func distinctNamedInts(a @Type, b @Type) bool {
	return a != nil && b != nil && a.Kind == TYP_INT && b.Kind == TYP_INT && !charEq(a.Name, b.Name)
}
