package "pkg/binate/types"

import "pkg/binate/buf"

// currentChecker is the Checker the type-system queries route
// through for context-dependent answers — at present, just
// interface-value assignability (which has to scan c.Impls to find
// a matching impl for *T / @T → *Iface). Set by the Check* entry
// points via WithChecker. Cleared on exit so tests that call
// AssignableTo standalone aren't surprised by stale impl state.
var currentChecker @Checker

// WithChecker installs c as the active checker for the duration
// of the caller's pass. Returns the prior checker, which the
// caller must pass to RestoreChecker on exit. Keeps the global
// re-entrant across nested checks (e.g., REPL inside a regular
// compile).
func WithChecker(c @Checker) @Checker {
	var prev @Checker = currentChecker
	currentChecker = c
	return prev
}

// RestoreChecker reinstalls the previously-active checker (the
// return value from a matching WithChecker call). Use in defer-
// style pairing.
func RestoreChecker(prev @Checker) {
	currentChecker = prev
}

// currentPkgShort is the short package name of the package
// currently being checked / whose bni is being loaded. Used by
// MakeInterfaceType callers (check_interface.bn / bni_scope.bn) to
// stamp Pkg on each TYP_INTERFACE so cross-package iface identity
// is (Pkg, Name) — required by implCoversInterface to distinguish
// same-named interfaces in different packages without needing
// pointer equality (which the bootstrap interp doesn't support on
// @T values). Slice 2.7.
var currentPkgShort @[]char

// WithPkgShort installs `pkg` as the active package short-name and
// returns the prior value, which the caller must pass to
// RestorePkgShort on exit (defer-style pairing).
func WithPkgShort(pkg @[]char) @[]char {
	var prev @[]char = currentPkgShort
	currentPkgShort = pkg
	return prev
}

// RestorePkgShort reinstalls the previously-active short package
// name (the return value from WithPkgShort).
func RestorePkgShort(prev @[]char) {
	currentPkgShort = prev
}

// ============================================================
// Type Queries
// ============================================================

// TypeName returns a human-readable name for the type.
func (t @Type) TypeName() @[]char {
	if t == nil {
		return "nil"
	}
	if len(t.Name) > 0 {
		return t.Name
	}
	if t.Kind == TYP_POINTER {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteByte('*')
		cb = cb.WriteStr(t.Elem.TypeName())
		return cb.Bytes()
	}
	if t.Kind == TYP_MANAGED_PTR {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteByte('@')
		cb = cb.WriteStr(t.Elem.TypeName())
		return cb.Bytes()
	}
	if t.Kind == TYP_SLICE {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteStr("*[]")
		cb = cb.WriteStr(t.Elem.TypeName())
		return cb.Bytes()
	}
	if t.Kind == TYP_MANAGED_SLICE {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteStr("@[]")
		cb = cb.WriteStr(t.Elem.TypeName())
		return cb.Bytes()
	}
	if t.Kind == TYP_ARRAY {
		return "[...]"
	}
	if t.Kind == TYP_FUNC {
		return "func(...)"
	}
	if t.Kind == TYP_READONLY {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteStr("readonly ")
		cb = cb.WriteStr(t.Elem.TypeName())
		return cb.Bytes()
	}
	if t.Kind == TYP_INTERFACE_VALUE {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteByte('*')
		cb = cb.WriteStr(t.Elem.TypeName())
		return cb.Bytes()
	}
	if t.Kind == TYP_INTERFACE_VALUE_MANAGED {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteByte('@')
		cb = cb.WriteStr(t.Elem.TypeName())
		return cb.Bytes()
	}
	return "<unknown>"
}

// ResolveAlias follows alias chains and returns the underlying non-alias type.
func (t @Type) ResolveAlias() @Type {
	for t != nil && t.Kind == TYP_ALIAS {
		t = t.Target
	}
	return t
}

// peelNamedBounded follows a named-distinct type's Underlying chain (resolving
// any alias / readonly wrapper at each step) down to its base type, with a
// depth bound.  A CYCLIC named type — `type A B; type B A`, or self `type A A`
// — is rejected at definition by collectTypeDecl, but the bound guards the
// operand predicates here too: without it a cycle makes `==` (comparabilityKind)
// loop forever and `<` (IsNumeric → IsInteger / IsFloat) stack-overflow on a
// parseable-but-malformed input.  Returns the base type, or nil when the bound
// is exceeded (i.e. a cyclic type that slipped past the decl-time check).
func peelNamedBounded(t @Type) @Type {
	t = resolveAliasAndConst(t)
	var depth int = 0
	for t != nil && t.Kind == TYP_NAMED && t.Underlying != nil {
		if depth >= 1024 {
			return nil
		}
		t = resolveAliasAndConst(t.Underlying)
		depth = depth + 1
	}
	return t
}

// IsInteger reports whether t is an integer type (including untyped int and named integer types).
func (t @Type) IsInteger() bool {
	var b @Type = peelNamedBounded(t)
	if b == nil {
		return false
	}
	return b.Kind == TYP_INT || b.Kind == TYP_UNTYPED_INT
}

// IsFloat reports whether t is a floating-point type (including untyped
// float and named float types).
func (t @Type) IsFloat() bool {
	var b @Type = peelNamedBounded(t)
	if b == nil {
		return false
	}
	return b.Kind == TYP_FLOAT || b.Kind == TYP_UNTYPED_FLOAT
}

// IsNumeric reports whether t is a numeric type (integer or float).
func (t @Type) IsNumeric() bool {
	return t.IsInteger() || t.IsFloat()
}

// SignedMinForWidth returns the most-negative value of a signed
// integer of the given bit width (8 → -128, 32 → INT32_MIN, 64 →
// INT64_MIN), as a 64-bit pattern.  The DivCheck divide-fault guard
// uses it to detect the signed MIN / -1 overflow.  Widths of 64 or
// more saturate at the int64 minimum (computing it as `1 << 63` would
// overflow into the sign bit).
func SignedMinForWidth(width int) int64 {
	if width >= 64 {
		return cast(int64, -9223372036854775807) - cast(int64, 1)
	}
	var shifted int64 = cast(int64, 1) << (width - 1)
	return cast(int64, 0) - shifted
}

// IsBool reports whether t is a boolean type (including untyped bool).
func (t @Type) IsBool() bool {
	var b @Type = peelNamedBounded(t)
	if b == nil {
		return false
	}
	return b.Kind == TYP_BOOL || b.Kind == TYP_UNTYPED_BOOL
}

// IsScalar reports whether t is a scalar type: an integer (incl. char,
// uint, the sized int/uint types), float, or bool — possibly via a
// named type, alias, or `readonly` modifier (those are seen through).
// Composites (slices, arrays, structs, pointers, managed pointers,
// function-value / interface-value types) are NOT scalar.  Used to
// enforce that const declarations carry a scalar type; non-scalar
// immutable values are expressed as `var X readonly T = ...`.
func (t @Type) IsScalar() bool {
	return t.IsInteger() || t.IsFloat() || t.IsBool()
}

// IsPointer reports whether t is a pointer type (raw or managed).
func (t @Type) IsPointer() bool {
	t = resolveAliasAndConst(t)
	if t == nil {
		return false
	}
	return t.Kind == TYP_POINTER || t.Kind == TYP_MANAGED_PTR
}

// IsSlice reports whether t is a slice type (raw or managed).
func (t @Type) IsSlice() bool {
	t = resolveAliasAndConst(t)
	if t == nil {
		return false
	}
	return t.Kind == TYP_SLICE || t.Kind == TYP_MANAGED_SLICE
}

// comparabilityKind returns t's kind with alias, readonly, and
// named-distinct wrappers resolved away — the kind the == / != operand
// rules are applied to.  Returns TYP_VOID when t is nil.  Named types are
// followed to their underlying, so `type Pt struct{…}` is treated as a
// struct and `type Handle *T` as a pointer.
func comparabilityKind(t @Type) int {
	var b @Type = peelNamedBounded(t)
	if b == nil {
		return TYP_VOID
	}
	return b.Kind
}

// relationalOperandOK reports whether t is acceptable as an operand of a
// relational operator (< > <= >=).  Numeric types are; everything else
// (pointers, slices, structs, interface/func values, bool, nil) is not —
// ordering is defined only for numbers.  Type parameters and Self are
// opaque at generic-definition time, so they are deferred (accepted here)
// rather than rejected; the concrete instantiation is where a bad
// element type would surface.
func relationalOperandOK(t @Type) bool {
	if t.IsNumeric() {
		return true
	}
	var k int = comparabilityKind(t)
	return k == TYP_TYPE_PARAM || k == TYP_SELF || k == TYP_VOID
}

// IsNillable reports whether t can be assigned nil. True for pointer
// types and function-value types (raw or managed). Function values
// have a 2-word {vtable, data} layout, but a nil function value is a
// meaningful state — both halves zero — and the assignment is
// accepted (slices, by contrast, reject nil-assignment and use bare-
// decl zero-init instead).
func (t @Type) IsNillable() bool {
	if t.IsPointer() { return true }
	t = resolveAliasAndConst(t)
	if t == nil { return false }
	return t.Kind == TYP_FUNC_VALUE ||
		t.Kind == TYP_MANAGED_FUNC_VALUE
}

// funcSignaturesMatch reports whether a TYP_FUNC and a TYP_FUNC_VALUE
// (or TYP_MANAGED_FUNC_VALUE) have identical signatures: same number
// of params with identical types, and same number of results with
// identical types. Param names are ignored — function-value types
// have anonymous params anyway.
func funcSignaturesMatch(fn @Type, fv @Type) bool {
	if fn == nil || fv == nil { return false }
	if len(fn.Params) != len(fv.Params) { return false }
	if len(fn.Results) != len(fv.Results) { return false }
	for i := 0; i < len(fn.Params); i++ {
		if !fn.Params[i].Type.Identical(fv.Params[i].Type) {
			return false
		}
	}
	for i := 0; i < len(fn.Results); i++ {
		if !fn.Results[i].Identical(fv.Results[i]) {
			return false
		}
	}
	return true
}

// SliceElem returns the element type of a slice or managed-slice, or nil if t is not a slice.
func (t @Type) SliceElem() @Type {
	t = resolveAliasAndConst(t)
	if t == nil {
		return nil
	}
	if t.Kind == TYP_SLICE || t.Kind == TYP_MANAGED_SLICE {
		return t.Elem
	}
	return nil
}

// PointerElem returns the element type of a pointer or managed pointer, or nil if not a pointer.
func (t @Type) PointerElem() @Type {
	t = resolveAliasAndConst(t)
	if t == nil {
		return nil
	}
	if t.Kind == TYP_POINTER || t.Kind == TYP_MANAGED_PTR {
		return t.Elem
	}
	return nil
}

// Identical reports whether types a and b are structurally identical.
// Stage 0 of the const rollout: const wrappers are transparent here —
// `const T` and `T` are identical. Stage 1 will keep transparency in
// this predicate but reject const-drop at assignment sites in
// `AssignableTo` specifically.
func (a @Type) Identical(b @Type) bool {
	a = resolveAliasAndConst(a)
	b = resolveAliasAndConst(b)
	if a == nil && b == nil {
		return true
	}
	if a == nil || b == nil {
		return false
	}
	if a.Kind != b.Kind {
		return false
	}
	if a.Kind == TYP_POINTER || a.Kind == TYP_MANAGED_PTR ||
			a.Kind == TYP_SLICE || a.Kind == TYP_MANAGED_SLICE {
		return a.Elem.Identical(b.Elem)
	}
	if a.Kind == TYP_ARRAY {
		return a.ArrayLen == b.ArrayLen && a.Elem.Identical(b.Elem)
	}
	if a.Kind == TYP_STRUCT {
		// Named structs: identical iff same name
		if len(a.Name) > 0 || len(b.Name) > 0 {
			return charEq(a.Name, b.Name)
		}
		// Anonymous structs: structural equivalence (names + types in order)
		if len(a.Fields) != len(b.Fields) {
			return false
		}
		for i := 0; i < len(a.Fields); i++ {
			if !charEq(a.Fields[i].Name, b.Fields[i].Name) {
				return false
			}
			if !a.Fields[i].Type.Identical(b.Fields[i].Type) {
				return false
			}
		}
		return true
	}
	if a.Kind == TYP_FUNC || a.Kind == TYP_FUNC_VALUE ||
			a.Kind == TYP_MANAGED_FUNC_VALUE {
		// Structural signature compare for both TYP_FUNC (named
		// top-level functions) and the function-value variants
		// (`*func(...)` / `@func(...)`).  Before this branch was
		// extended to cover the value variants, two function-
		// values with the same Kind but different params or
		// results fell through to the catchall `return true` at
		// the bottom — silently treating, say, `*func(int) int`
		// as Identical to `*func(int) bool`.  AssignableTo then
		// accepted the mismatched assignment, producing wrong-
		// code (a callee returning int read by the caller as
		// bool, etc.).  See claude-todo.md.
		if len(a.Params) != len(b.Params) || len(a.Results) != len(b.Results) {
			return false
		}
		for i := 0; i < len(a.Params); i++ {
			if !a.Params[i].Type.Identical(b.Params[i].Type) {
				return false
			}
		}
		for i := 0; i < len(a.Results); i++ {
			if !a.Results[i].Identical(b.Results[i]) {
				return false
			}
		}
		return true
	}
	// For INT, BOOL, STRING, VOID, NIL, UNTYPED_*, NAMED — match by kind and name
	if a.Kind == TYP_INT {
		return a.Width == b.Width && a.Signed == b.Signed
	}
	if a.Kind == TYP_FLOAT {
		return a.Width == b.Width
	}
	if a.Kind == TYP_NAMED {
		return charEq(a.Name, b.Name)
	}
	if a.Kind == TYP_INTERFACE {
		// Two interface declarations are identical iff they are
		// the same nominal declaration — keyed on (Pkg, Name).
		return charEq(a.Pkg, b.Pkg) && charEq(a.Name, b.Name)
	}
	if a.Kind == TYP_INTERFACE_VALUE ||
			a.Kind == TYP_INTERFACE_VALUE_MANAGED {
		// Interface values agree iff their wrapped interfaces do.
		// The 2-word {data, vtable} layout is shared across all
		// iface-values, but type identity is nominal.
		return a.Elem.Identical(b.Elem)
	}
	// BOOL, STRING, VOID, NIL, UNTYPED_INT, UNTYPED_BOOL — same kind is enough
	return true
}

// FieldByName returns the field with the given name, or nil.
func (t @Type) FieldByName(name *[]readonly char) @Field {
	if t == nil {
		return nil
	}
	for i := 0; i < len(t.Fields); i++ {
		if charEq(t.Fields[i].Name, name) {
			return t.Fields[i]
		}
	}
	return nil
}

// NeedsDestruction reports whether values of type t require cleanup when
// their containing managed allocation is freed. This is true for:
//   - @T (managed pointers) — always
//   - @[]T (managed-slices) — always
//   - struct types with any field that needs destruction
//   - [N]T arrays where T needs destruction
func (t @Type) NeedsDestruction() bool {
	if t == nil { return false }
	t = t.ResolveAlias()
	if t.Kind == TYP_NAMED && t.Underlying != nil {
		return t.Underlying.NeedsDestruction()
	}
	if t.Kind == TYP_MANAGED_PTR { return true }
	if t.Kind == TYP_MANAGED_SLICE { return true }
	if t.Kind == TYP_MANAGED_FUNC_VALUE { return true }
	if t.Kind == TYP_INTERFACE_VALUE_MANAGED { return true }
	if t.Kind == TYP_STRUCT {
		for i := 0; i < len(t.Fields); i++ {
			if t.Fields[i].Type.NeedsDestruction() {
				return true
			}
		}
		return false
	}
	if t.Kind == TYP_ARRAY {
		return t.Elem.NeedsDestruction()
	}
	return false
}
