package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for IsWiderThanInt (types_query.bn).

// On a 32-bit target int64 / uint64 (and a named type over one) are wider than
// int; int, uint, int32 and the narrower ints are not, nor is a non-integer.
func TestIsWiderThanIntOn32BitTarget() testing.TestResult {
	var saved TargetInfo = GetTarget()
	setTarget32()
	var named @Type = MakeNamedType("Big")
	named.Underlying = TypInt64()
	var ok bool = IsWiderThanInt(TypInt64()) && IsWiderThanInt(TypUint64()) && IsWiderThanInt(named) &&
			!IsWiderThanInt(TypInt()) && !IsWiderThanInt(TypUint()) && !IsWiderThanInt(TypInt32()) &&
			!IsWiderThanInt(TypFloat64())
	SetTarget(saved)
	if !ok {
		return fail("32-bit target: only the 64-bit ints are wider than int")
	}
	return ""
}

// On a 64-bit target no integer is wider than int.
func TestIsWiderThanIntOn64BitTarget() testing.TestResult {
	var saved TargetInfo = GetTarget()
	setTarget64()
	var ok bool = !IsWiderThanInt(TypInt64()) && !IsWiderThanInt(TypUint64()) &&
			!IsWiderThanInt(TypInt())
	SetTarget(saved)
	if !ok {
		return fail("64-bit target: no integer is wider than int")
	}
	return ""
}

// Tests for StripWrappers' and IsReadonly's walks, which end on a loop and on no
// chain that ends, however long.

// namedChain returns the head of a chain of n named types, each over the next, the
// last over base.
func namedChain(n int, base @Type) @Type {
	var t @Type = base
	for i := 0; i < n; i++ {
		var named @Type = MakeNamedType("N")
		named.Underlying = t
		t = named
	}
	return t
}

// A chain far past any step count peels fully, through alias and readonly links.
func TestStripWrappersLongChain() testing.TestResult {
	if !same(StripWrappers(namedChain(5000, TypInt64())), TypInt64()) {
		return fail("a chain of 5000 named types must peel to its base")
	}
	var mixed @Type = namedChain(3000,
			MakeReadonlyType(namedChain(3000, MakeAliasType("A", TypInt32()))))
	if !same(StripWrappers(mixed), TypInt32()) {
		return fail("a long chain through readonly and an alias must peel to its base")
	}
	if !namedChain(3000, MakeReadonlyType(TypInt())).IsReadonly() {
		return fail("a long chain over a readonly type must be readonly")
	}
	return ""
}

// A loop gives nil (IsReadonly false), whether the chain starts on it or reaches it,
// and through readonly too.  Each loop is broken after, so nothing is left holding
// itself.
func TestStripWrappersLoops() testing.TestResult {
	var a @Type = MakeNamedType("A")
	var b @Type = MakeNamedType("B")
	a.Underlying = a
	var self bool = StripWrappers(a) == nil && !a.IsReadonly()
	a.Underlying = b
	b.Underlying = a
	var pair bool = StripWrappers(a) == nil && StripWrappers(b) == nil
	var lead bool = StripWrappers(namedChain(10, a)) == nil && !namedChain(10, a).IsReadonly()
	a.Underlying = MakeReadonlyType(b)
	var ro bool = StripWrappers(b) == nil
	a.Underlying = nil
	b.Underlying = nil
	if !self { return fail("a named type over itself must give nil") }
	if !pair { return fail("two named types over each other must give nil") }
	if !lead { return fail("a chain leading into a loop must give nil") }
	if !ro { return fail("a loop through readonly must give nil") }
	return ""
}
