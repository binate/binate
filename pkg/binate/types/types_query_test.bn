package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for IsWiderThanInt (types_query.bn).

// On a 32-bit target int64 / uint64 (and a named type over one) are wider than
// int; int, uint, int32 and the narrower ints are not, nor is a non-integer.
func TestIsWiderThanIntOn32BitTarget() testing.TestResult {
	var saved TargetInfo = GetTarget()
	setTarget32()
	var named @Type = MakeNamedType("Big")
	named.Underlying = TypInt64()
	var ok bool = IsWiderThanInt(TypInt64()) && IsWiderThanInt(TypUint64()) && IsWiderThanInt(named) &&
			!IsWiderThanInt(TypInt()) && !IsWiderThanInt(TypUint()) && !IsWiderThanInt(TypInt32()) &&
			!IsWiderThanInt(TypFloat64())
	SetTarget(saved)
	if !ok {
		return fail("32-bit target: only the 64-bit ints are wider than int")
	}
	return ""
}

// On a 64-bit target no integer is wider than int.
func TestIsWiderThanIntOn64BitTarget() testing.TestResult {
	var saved TargetInfo = GetTarget()
	setTarget64()
	var ok bool = !IsWiderThanInt(TypInt64()) && !IsWiderThanInt(TypUint64()) &&
			!IsWiderThanInt(TypInt())
	SetTarget(saved)
	if !ok {
		return fail("64-bit target: no integer is wider than int")
	}
	return ""
}
