package "pkg/binate/types"

import "pkg/builtins/testing"

// Tests for the predicates in types_query.bn. Assignability tests
// live in types_assignable_test.bn (split for the file-length cap).
// Helpers `fail` and `streq` are defined in types_test.bn (sibling file).

// ============================================================
// Type Query Tests
// ============================================================

func TestIsInteger() testing.TestResult {
	if !TypInt().IsInteger() { return fail("int should be integer") }
	if !TypInt32().IsInteger() { return fail("int32 should be integer") }
	if !TypUint64().IsInteger() { return fail("uint64 should be integer") }
	if !TypUntypedInt().IsInteger() { return fail("untyped int should be integer") }
	if TypBool().IsInteger() { return fail("bool should not be integer") }
	return ""
}

func TestSignedMinForWidth() testing.TestResult {
	if SignedMinForWidth(8) != cast(int64, -128) {
		return fail("int8 MIN should be -128")
	}
	if SignedMinForWidth(16) != cast(int64, -32768) {
		return fail("int16 MIN should be -32768")
	}
	if SignedMinForWidth(32) != cast(int64, -2147483648) {
		return fail("int32 MIN should be -2147483648")
	}
	var i64min int64 = cast(int64, -9223372036854775807) - cast(int64, 1)
	if SignedMinForWidth(64) != i64min {
		return fail("int64 MIN should be INT64_MIN")
	}
	// Widths above 63 saturate at the int64 minimum (no shift overflow).
	if SignedMinForWidth(128) != i64min {
		return fail("width > 64 should saturate at INT64_MIN")
	}
	return ""
}

func TestIsBool() testing.TestResult {
	if !TypBool().IsBool() { return fail("bool should be bool") }
	if !TypUntypedBool().IsBool() { return fail("untyped bool should be bool") }
	if TypInt().IsBool() { return fail("int should not be bool") }
	return ""
}

func TestIsPointer() testing.TestResult {
	if !MakePointerType(TypInt()).IsPointer() { return fail("*int should be pointer") }
	if !MakeManagedPtrType(TypInt()).IsPointer() { return fail("@int should be pointer") }
	if TypInt().IsPointer() { return fail("int should not be pointer") }
	return ""
}

func TestIsSlice() testing.TestResult {
	if !MakeSliceType(TypInt()).IsSlice() { return fail("*[]int should be slice") }
	if !MakeManagedSliceType(TypInt()).IsSlice() { return fail("@[]int should be slice") }
	if TypInt().IsSlice() { return fail("int should not be slice") }
	return ""
}

func TestIsNillable() testing.TestResult {
	if !MakePointerType(TypInt()).IsNillable() { return fail("*int should be nillable") }
	if !MakeManagedPtrType(TypInt()).IsNillable() { return fail("@int should be nillable") }
	if MakeSliceType(TypInt()).IsNillable() { return fail("*[]int should not be nillable") }
	if MakeManagedSliceType(TypInt()).IsNillable() { return fail("@[]int should not be nillable") }
	if TypInt().IsNillable() { return fail("int should not be nillable") }
	return ""
}

func TestSliceElem() testing.TestResult {
	var s @Type = MakeSliceType(TypInt())
	var e @Type = s.SliceElem()
	if !e.Identical(TypInt()) { return fail("slice elem wrong") }
	if !(TypInt().SliceElem() == nil) { return fail("non-slice should return nil") }
	return ""
}

func TestPointerElem() testing.TestResult {
	var p @Type = MakePointerType(TypBool())
	var e @Type = p.PointerElem()
	if !e.Identical(TypBool()) { return fail("pointer elem wrong") }
	if !(TypInt().PointerElem() == nil) { return fail("non-pointer should return nil") }
	return ""
}

func TestIdentical() testing.TestResult {
	if !TypInt().Identical(TypInt()) { return fail("int == int") }
	if TypInt().Identical(TypBool()) { return fail("int != bool") }
	if !MakePointerType(TypInt()).Identical(MakePointerType(TypInt())) { return fail("*int == *int") }
	if MakePointerType(TypInt()).Identical(MakePointerType(TypBool())) {
		return fail("*int != *bool")
	}
	if !MakeSliceType(TypInt()).Identical(MakeSliceType(TypInt())) { return fail("*[]int == *[]int") }
	if !MakeArrayType(TypInt(), 5).Identical(MakeArrayType(TypInt(), 5)) {
		return fail("[5]int == [5]int")
	}
	if MakeArrayType(TypInt(), 5).Identical(MakeArrayType(TypInt(), 10)) {
		return fail("[5]int != [10]int")
	}
	return ""
}

// Type parameters are identical iff they are the SAME parameter:
// matching (TpOwner, TpIndex).  Distinct params (different index, or a
// different owning generic decl) are NOT identical.  Before the
// TYP_TYPE_PARAM arm, both pairs below fell through to the catchall and
// compared equal, which aliased `Foo[A]` and `Foo[B]` in the
// instantiation cache.
func TestIdenticalTypeParams() testing.TestResult {
	// Two distinct owners — addresses of distinct locals.
	var declA int = 0
	var declB int = 0
	var ownerA *uint8 = bit_cast(*uint8, &declA)
	var ownerB *uint8 = bit_cast(*uint8, &declB)

	var a0 @Type = MakeTypeParamType("A", ownerA, 0, nil)
	var a0again @Type = MakeTypeParamType("A", ownerA, 0, nil)
	var a1 @Type = MakeTypeParamType("B", ownerA, 1, nil)
	var b0 @Type = MakeTypeParamType("A", ownerB, 0, nil)

	if !a0.Identical(a0again) {
		return fail("same (owner, index) type params must be identical")
	}
	if a0.Identical(a1) {
		return fail("same owner, different index must NOT be identical")
	}
	if a0.Identical(b0) {
		return fail("different owner, same index must NOT be identical")
	}
	return ""
}

// Two named structs from different packages that share a short name are
// distinct: Identical keys a TYP_NAMED on its underlying struct's path-
// qualified Name (the bare wrapper Name "Box" would false-match).  Same
// underlying qualified struct -> Identical even through distinct wrappers.
func TestIdenticalDistinguishesCrossPkgNamedStructs() testing.TestResult {
	var noFields @[]@Field = make_slice(@Field, 0)
	var sA @Type = MakeStructType("pkg/a.Box", noFields)
	var nA @Type = MakeNamedType("Box")
	nA.Underlying = sA
	var sB @Type = MakeStructType("pkg/b.Box", noFields)
	var nB @Type = MakeNamedType("Box")
	nB.Underlying = sB
	if nA.Identical(nB) {
		return fail("cross-pkg same-short-named named structs must NOT be Identical")
	}
	var nA2 @Type = MakeNamedType("Box")
	nA2.Underlying = sA
	if !nA.Identical(nA2) {
		return fail("same underlying qualified struct must be Identical")
	}
	// A named non-struct distinct type keys on its own (wrapper) name.
	var cA @Type = MakeNamedType("Celsius")
	cA.Underlying = TypInt()
	var cB @Type = MakeNamedType("Celsius")
	cB.Underlying = TypInt()
	if !cA.Identical(cB) {
		return fail("same-named distinct scalar types must be Identical")
	}
	return ""
}

// Identical on declared interfaces matches nominally — same (Pkg,
// Name) tuple — and on interface values agrees iff their wrapped
// interfaces do.  Pre-Slice-E.4-part-2a, the trailing default
// "same kind is enough" branch incorrectly reported all iface
// values as identical regardless of wrapped interface; the bug
// was masked until cross-interface assignment became possible
// with extension.  Direct test pins the fix.
func TestIdenticalInterfaceValues() testing.TestResult {
	var a @Type = MakeInterfaceType("test", "A")
	var b @Type = MakeInterfaceType("test", "B")
	if !a.Identical(a) { return fail("A == A (same Type)") }
	if a.Identical(b) { return fail("A != B (different names)") }
	var a2 @Type = MakeInterfaceType("test", "A")
	if !a.Identical(a2) {
		return fail("A == A (different Type instances, same (Pkg, Name))")
	}
	var ax @Type = MakeInterfaceType("other", "A")
	if a.Identical(ax) {
		return fail("test.A != other.A (different Pkg)")
	}
	// Raw interface values: same wrapped iface → identical;
	// different wrapped iface → not identical.
	var ivA @Type = MakeInterfaceValueType(a)
	var ivB @Type = MakeInterfaceValueType(b)
	if !ivA.Identical(ivA) { return fail("*A == *A") }
	if ivA.Identical(ivB) { return fail("*A != *B") }
	// Managed interface values: same rule.
	var mivA @Type = MakeManagedInterfaceValueType(a)
	var mivB @Type = MakeManagedInterfaceValueType(b)
	if !mivA.Identical(mivA) { return fail("@A == @A") }
	if mivA.Identical(mivB) { return fail("@A != @B") }
	// Raw and managed wrappers of the same iface are NOT identical
	// — they differ in kind (TYP_INTERFACE_VALUE vs _MANAGED).
	if ivA.Identical(mivA) { return fail("*A != @A (different kinds)") }
	return ""
}

// Identical on `*func` / `@func` walks params + results structurally
// — same kind isn't enough.  Pre-fix (binate `12bbb548`) the
// TYP_FUNC_VALUE / TYP_MANAGED_FUNC_VALUE branches were missing from
// Identical and any two values with the same Kind fell through to
// the catchall `return true`, silently treating `*func(int) int` as
// Identical to `*func(int) bool`; downstream AssignableTo accepted
// the mismatched assignment, producing wrong-code generation across
// every backend.  Direct test pins the fix in the same spirit as
// TestIdenticalInterfaceValues above.
func TestIdenticalFuncValues() testing.TestResult {
	// Helpers for the test: build *func(int) int, *func(int) bool,
	// *func(bool) int, *func() int, and the matching @func variants.
	var pi @Param = make(Param)
	pi.Type = TypInt()
	var pbool @Param = make(Param)
	pbool.Type = TypBool()
	var params1Int @[]@Param = make_slice(@Param, 1)
	params1Int[0] = pi
	var params1Bool @[]@Param = make_slice(@Param, 1)
	params1Bool[0] = pbool
	var noParams @[]@Param
	var resultsInt @[]@Type = make_slice(@Type, 1)
	resultsInt[0] = TypInt()
	var resultsBool @[]@Type = make_slice(@Type, 1)
	resultsBool[0] = TypBool()

	var fInt2Int @Type = MakeFuncValueType(params1Int, resultsInt)
	var fInt2Bool @Type = MakeFuncValueType(params1Int, resultsBool)
	var fBool2Int @Type = MakeFuncValueType(params1Bool, resultsInt)
	var fNullary @Type = MakeFuncValueType(noParams, resultsInt)

	// Same sig: Identical.  Different result, different param,
	// or different param count: NOT Identical.
	if !fInt2Int.Identical(fInt2Int) {
		return fail("*func(int) int == *func(int) int")
	}
	if fInt2Int.Identical(fInt2Bool) {
		return fail("*func(int) int != *func(int) bool")
	}
	if fInt2Int.Identical(fBool2Int) {
		return fail("*func(int) int != *func(bool) int")
	}
	if fInt2Int.Identical(fNullary) {
		return fail("*func(int) int != *func() int")
	}

	// Same checks for @func.
	var mInt2Int @Type = MakeManagedFuncValueType(params1Int, resultsInt)
	var mInt2Bool @Type = MakeManagedFuncValueType(params1Int, resultsBool)
	if !mInt2Int.Identical(mInt2Int) {
		return fail("@func(int) int == @func(int) int")
	}
	if mInt2Int.Identical(mInt2Bool) {
		return fail("@func(int) int != @func(int) bool")
	}

	// *func and @func with the SAME sig are NOT identical — they
	// differ in Kind (TYP_FUNC_VALUE vs TYP_MANAGED_FUNC_VALUE), so
	// the early Kind-mismatch return at the top of Identical kicks
	// in.  Without this guarantee the assignability rules between
	// the raw and managed forms would collapse.
	if fInt2Int.Identical(mInt2Int) {
		return fail("*func(int) int != @func(int) int (different kinds)")
	}
	return ""
}

// Field order is part of the structural identity: `{x int, y bool}`
// is NOT identical to `{y bool, x int}`. The loop in Identical walks
// fields in declaration order; flipping them would also flip the
// LLVM layout (field offsets shift), so reordering is observable.
func TestIdenticalAnonymousStructsFieldOrder() testing.TestResult {
	var f1 @Field = make(Field)
	f1.Name = "X"
	f1.Type = TypInt()
	var f2 @Field = make(Field)
	f2.Name = "Y"
	f2.Type = TypBool()
	var ab @[]@Field = make_slice(@Field, 2)
	ab[0] = f1
	ab[1] = f2
	var ba @[]@Field = make_slice(@Field, 2)
	ba[0] = f2
	ba[1] = f1
	var a @Type = MakeStructType("", ab)
	var b @Type = MakeStructType("", ba)
	if a.Identical(b) {
		return fail("{X int, Y bool} should not be identical to {Y bool, X int}")
	}
	return ""
}

// Same field names but different types must reject. The basic anon
// test already covers different-names; this pins different-types-
// with-same-names so a future "match on names only" regression
// would fail.
func TestIdenticalAnonymousStructsTypesDiffer() testing.TestResult {
	var f1 @Field = make(Field)
	f1.Name = "X"
	f1.Type = TypInt()
	var f2 @Field = make(Field)
	f2.Name = "Y"
	f2.Type = TypBool()
	var ab @[]@Field = make_slice(@Field, 2)
	ab[0] = f1
	ab[1] = f2

	var g1 @Field = make(Field)
	g1.Name = "X"
	g1.Type = TypBool()
	var g2 @Field = make(Field)
	g2.Name = "Y"
	g2.Type = TypInt()
	var swapped @[]@Field = make_slice(@Field, 2)
	swapped[0] = g1
	swapped[1] = g2

	var a @Type = MakeStructType("", ab)
	var c @Type = MakeStructType("", swapped)
	if a.Identical(c) {
		return fail("same field names with swapped types should not be identical")
	}
	return ""
}

// Nested anonymous struct: `struct { Inner struct { Y int } }`.
// Identical recurses through field types, so two such structs
// with identical inner shape must match, and a difference in the
// inner shape must reject.
func TestIdenticalAnonymousStructsNested() testing.TestResult {
	var innerYInt @Field = make(Field)
	innerYInt.Name = "Y"
	innerYInt.Type = TypInt()
	var innerFieldsInt @[]@Field = make_slice(@Field, 1)
	innerFieldsInt[0] = innerYInt
	var innerInt @Type = MakeStructType("", innerFieldsInt)

	var outerA @Field = make(Field)
	outerA.Name = "Inner"
	outerA.Type = innerInt
	var outerFieldsA @[]@Field = make_slice(@Field, 1)
	outerFieldsA[0] = outerA
	var a @Type = MakeStructType("", outerFieldsA)

	// Fresh inner struct with the same shape — different Type
	// instance — must still be identical.
	var innerYInt2 @Field = make(Field)
	innerYInt2.Name = "Y"
	innerYInt2.Type = TypInt()
	var innerFieldsInt2 @[]@Field = make_slice(@Field, 1)
	innerFieldsInt2[0] = innerYInt2
	var innerInt2 @Type = MakeStructType("", innerFieldsInt2)
	var outerB @Field = make(Field)
	outerB.Name = "Inner"
	outerB.Type = innerInt2
	var outerFieldsB @[]@Field = make_slice(@Field, 1)
	outerFieldsB[0] = outerB
	var b @Type = MakeStructType("", outerFieldsB)

	if !a.Identical(b) {
		return fail("nested anon structs with same inner shape should be identical")
	}

	// Inner field type differs (Y: int vs Y: bool) — outer is not identical.
	var innerYBool @Field = make(Field)
	innerYBool.Name = "Y"
	innerYBool.Type = TypBool()
	var innerFieldsBool @[]@Field = make_slice(@Field, 1)
	innerFieldsBool[0] = innerYBool
	var innerBool @Type = MakeStructType("", innerFieldsBool)
	var outerC @Field = make(Field)
	outerC.Name = "Inner"
	outerC.Type = innerBool
	var outerFieldsC @[]@Field = make_slice(@Field, 1)
	outerFieldsC[0] = outerC
	var c @Type = MakeStructType("", outerFieldsC)
	if a.Identical(c) {
		return fail("nested anon with different inner shape should not be identical")
	}
	return ""
}

// Anonymous structs with managed fields (@T / @[]T) — the field-
// type recursion goes through TYP_MANAGED_PTR / TYP_MANAGED_SLICE,
// each of which compares Elem.Identical. Pin that both halves of
// the comparison see the same managed-slice shape.
func TestIdenticalAnonymousStructsManagedFields() testing.TestResult {
	var f1 @Field = make(Field)
	f1.Name = "Name"
	f1.Type = MakeManagedSliceType(TypChar())
	var f2 @Field = make(Field)
	f2.Name = "Box"
	f2.Type = MakeManagedPtrType(TypInt())
	var fieldsA @[]@Field = make_slice(@Field, 2)
	fieldsA[0] = f1
	fieldsA[1] = f2
	var a @Type = MakeStructType("", fieldsA)

	var g1 @Field = make(Field)
	g1.Name = "Name"
	g1.Type = MakeManagedSliceType(TypChar())
	var g2 @Field = make(Field)
	g2.Name = "Box"
	g2.Type = MakeManagedPtrType(TypInt())
	var fieldsB @[]@Field = make_slice(@Field, 2)
	fieldsB[0] = g1
	fieldsB[1] = g2
	var b @Type = MakeStructType("", fieldsB)

	if !a.Identical(b) {
		return fail("anon structs with managed fields should be identical")
	}

	// @[]char and @[]int are not the same managed slice → reject.
	var g3 @Field = make(Field)
	g3.Name = "Name"
	g3.Type = MakeManagedSliceType(TypInt())
	var fieldsC @[]@Field = make_slice(@Field, 2)
	fieldsC[0] = g3
	fieldsC[1] = g2
	var c @Type = MakeStructType("", fieldsC)
	if a.Identical(c) {
		return fail("anon structs with differing managed-slice elem should not be identical")
	}
	return ""
}

func TestIdenticalAnonymousStructs() testing.TestResult {
	// Same fields → identical
	var f1 @Field = make(Field)
	f1.Name = "X"
	f1.Type = TypInt()
	var f2 @Field = make(Field)
	f2.Name = "Y"
	f2.Type = TypBool()
	var fieldsA @[]@Field = make_slice(@Field, 2)
	fieldsA[0] = f1
	fieldsA[1] = f2
	var a @Type = MakeStructType("", fieldsA)

	var g1 @Field = make(Field)
	g1.Name = "X"
	g1.Type = TypInt()
	var g2 @Field = make(Field)
	g2.Name = "Y"
	g2.Type = TypBool()
	var fieldsB @[]@Field = make_slice(@Field, 2)
	fieldsB[0] = g1
	fieldsB[1] = g2
	var b @Type = MakeStructType("", fieldsB)

	if !a.Identical(b) { return fail("same anon structs should be identical") }

	// Different field names → not identical
	var h1 @Field = make(Field)
	h1.Name = "A"
	h1.Type = TypInt()
	var h2 @Field = make(Field)
	h2.Name = "B"
	h2.Type = TypBool()
	var fieldsC @[]@Field = make_slice(@Field, 2)
	fieldsC[0] = h1
	fieldsC[1] = h2
	var c @Type = MakeStructType("", fieldsC)
	if a.Identical(c) { return fail("different field names should not be identical") }

	// Named structs → not structurally equal
	var named1 @Type = MakeStructType("Foo", fieldsA)
	var named2 @Type = MakeStructType("Bar", fieldsB)
	if named1.Identical(named2) { return fail("different named structs should not be identical") }

	return ""
}

func TestResolveAlias() testing.TestResult {
	var target @Type = TypInt()
	var alias @Type = MakeAliasType("MyInt", target)
	var resolved @Type = alias.ResolveAlias()
	if !resolved.Identical(target) { return fail("alias should resolve to target") }
	// Non-alias passthrough
	var plain @Type = TypBool()
	if !plain.ResolveAlias().Identical(plain) { return fail("non-alias should pass through") }
	return ""
}

// IsByvalParam classifies a parameter for the >16-byte indirect
// (`ptr byval`) calling convention.  It must peel the transparent
// wrappers (alias / readonly / named) before the aggregate-Kind + size
// test, or a `readonly Big` param is mis-read as a non-aggregate scalar
// and lowered by value — and the IR-gen / codegen halves that share this
// one predicate disagree, so the emitted function fails to compile.
// Fixed-width int64 fields keep the 24 / 16 / 32-byte sizes independent
// of the locked `int` singleton's width.
func TestIsByvalParamPeelsWrappers() testing.TestResult {
	setTarget64()
	var f3 @[]@Field = make_slice(@Field, 3)
	for i := 0; i < 3; i++ {
		var fld @Field = make(Field)
		fld.Name = "f"
		fld.Type = TypInt64()
		f3[i] = fld
	}
	var big @Type = MakeStructType("Big", f3) // 24 B, > 16

	if !big.IsByvalParam() { return fail("plain 24B struct must be byval") }
	if !MakeReadonlyType(big).IsByvalParam() {
		return fail("readonly 24B struct must be byval")
	}
	var named @Type = MakeNamedType("BigName")
	named.Underlying = big
	if !named.IsByvalParam() { return fail("named 24B struct must be byval") }
	if !MakeAliasType("BigAlias", big).IsByvalParam() {
		return fail("alias 24B struct must be byval")
	}
	if !MakeReadonlyType(MakeAliasType("BA2", big)).IsByvalParam() {
		return fail("readonly-alias 24B struct must be byval")
	}
	if !MakeReadonlyType(MakeArrayType(TypInt64(), 4)).IsByvalParam() {
		return fail("readonly [4]int64 (32B) must be byval")
	}

	var f2 @[]@Field = make_slice(@Field, 2)
	var ga @Field = make(Field)
	ga.Name = "a"
	ga.Type = TypInt64()
	f2[0] = ga
	var gb @Field = make(Field)
	gb.Name = "b"
	gb.Type = TypInt64()
	f2[1] = gb
	var small @Type = MakeStructType("Pair", f2) // 16 B, == 16 (not >)
	if small.IsByvalParam() { return fail("16B struct must NOT be byval") }
	if MakeReadonlyType(small).IsByvalParam() {
		return fail("readonly 16B struct must NOT be byval")
	}

	if TypInt64().IsByvalParam() { return fail("int64 must NOT be byval") }
	if MakeReadonlyType(TypInt64()).IsByvalParam() {
		return fail("readonly int64 must NOT be byval")
	}
	return ""
}

// A cyclic named type (`type A B; type B A`) must not hang the operand
// predicates: peelNamedBounded's depth bound makes comparabilityKind /
// IsInteger / IsBool terminate (reporting the type as non-comparable /
// non-numeric) rather than looping forever.  Defense-in-depth for the
// decl-time cyclic-type reject.  CR-2 Plan-1 Round-2.
func TestPeelNamedBoundedCyclicTerminates() testing.TestResult {
	var a @Type = MakeNamedType("A")
	var b @Type = MakeNamedType("B")
	a.Underlying = b
	b.Underlying = a
	if comparabilityKind(a) != TYP_VOID {
		return fail("cyclic comparabilityKind should bottom out to TYP_VOID")
	}
	if a.IsInteger() { return fail("cyclic type must not report IsInteger") }
	if a.IsNumeric() { return fail("cyclic type must not report IsNumeric") }
	if a.IsBool() { return fail("cyclic type must not report IsBool") }
	return ""
}
