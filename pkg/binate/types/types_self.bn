package "pkg/binate/types"

// MentionsSelf reports whether t mentions the `Self` type anywhere in its shape:
// t itself, the element of a pointer / slice / array / readonly / interface-value
// type, a field of an anonymous struct, a parameter or result of a function type or
// a tuple, or a type argument of a generic instance (`Box[Self]`, the interface of
// `*G[Self]`).  A named type's fields and an interface's methods are not walked:
// neither can mention `Self` except through its type arguments.
func MentionsSelf(t @Type) bool {
	if t == nil { return false }
	if t.Kind == TYP_SELF { return true }
	for i := 0; i < len(t.InstArgs); i++ {
		if MentionsSelf(t.InstArgs[i]) { return true }
	}
	var k int = t.Kind
	if k == TYP_POINTER || k == TYP_MANAGED_PTR || k == TYP_SLICE || k == TYP_MANAGED_SLICE ||
			k == TYP_ARRAY || k == TYP_READONLY || k == TYP_INTERFACE_VALUE ||
			k == TYP_INTERFACE_VALUE_MANAGED {
		return MentionsSelf(t.Elem)
	}
	if k == TYP_STRUCT && len(t.Name) == 0 {
		for i := 0; i < len(t.Fields); i++ {
			if MentionsSelf(t.Fields[i].Type) { return true }
		}
		return false
	}
	if k == TYP_FUNC || k == TYP_FUNC_VALUE || k == TYP_MANAGED_FUNC_VALUE || k == TYP_TUPLE {
		return FuncMentionsSelf(t)
	}
	return false
}

// FuncMentionsSelf reports whether any parameter or result of the function type ft
// mentions `Self` (MentionsSelf).  A method whose interface signature does is
// object-unsafe: it cannot be called through an interface value (spec
// iface.self.object-safety).
func FuncMentionsSelf(ft @Type) bool {
	if ft == nil { return false }
	for i := 0; i < len(ft.Params); i++ {
		if MentionsSelf(ft.Params[i].Type) { return true }
	}
	for i := 0; i < len(ft.Results); i++ {
		if MentionsSelf(ft.Results[i]) { return true }
	}
	return false
}
