package "pkg/binate/types"

import "pkg/std/vec"

// MentionsSelf reports whether t mentions the `Self` type anywhere in its shape:
// t itself, the element of a pointer / slice / array / readonly / interface-value
// type, a field of an anonymous struct, a parameter or result of a function type or
// a tuple, or a type argument of a generic instance (`Box[Self]`, the interface of
// `*G[Self]`).  A named type's fields and an interface's methods are not walked:
// neither can mention `Self` except through its type arguments.
func MentionsSelf(t @Type) bool {
	return selfSearch(t, nil)
}

// FuncMentionsSelf reports whether any parameter or result of the function type ft
// mentions `Self` (MentionsSelf).  A method whose interface signature does is
// object-unsafe: it cannot be called through an interface value (spec
// iface.self.object-safety).
func FuncMentionsSelf(ft @Type) bool {
	return selfSearch(nil, ft)
}

// selfStack holds the types a Self search has still to look at, kept from one search
// to the next; a search leaves it as it found it.
var selfStack @vec.Vec[@Type]

// selfSearch reports whether t (when non-nil) or a parameter or result of the function
// type ft (when non-nil) mentions `Self`, looking at the parts from selfStack, not by
// recursion, so a type of any depth is searched.
func selfSearch(t @Type, ft @Type) bool {
	if selfStack == nil { selfStack = vec.New[@Type]() }
	var base int = selfStack.Len()
	if ft != nil { pushSignature(ft) }
	var found bool = false
	if t != nil { found = selfStep(t) }
	for !found && selfStack.Len() > base {
		next, _ := selfStack.Pop()
		found = selfStep(next)
	}
	for selfStack.Len() > base {
		_, _ = selfStack.Pop()
	}
	return found
}

// selfStep reports whether t itself is `Self`, pushing the parts of t that can mention
// it -- type arguments, then the element of a pointer / slice / array / readonly /
// interface-value type, an anonymous struct's fields, or a function type's or tuple's
// parameters and results -- last first, so they are searched in that order.
func selfStep(t @Type) bool {
	if t == nil { return false }
	if t.Kind == TYP_SELF { return true }
	var k int = t.Kind
	if k == TYP_POINTER || k == TYP_MANAGED_PTR || k == TYP_SLICE || k == TYP_MANAGED_SLICE ||
			k == TYP_ARRAY || k == TYP_READONLY || k == TYP_INTERFACE_VALUE ||
			k == TYP_INTERFACE_VALUE_MANAGED {
		selfStack.Push(t.Elem)
	} else if k == TYP_STRUCT && len(t.Name) == 0 {
		for i := len(t.Fields) - 1; i >= 0; i-- {
			selfStack.Push(t.Fields[i].Type)
		}
	} else if k == TYP_FUNC || k == TYP_FUNC_VALUE || k == TYP_MANAGED_FUNC_VALUE || k == TYP_TUPLE {
		pushSignature(t)
	}
	for i := len(t.InstArgs) - 1; i >= 0; i-- {
		selfStack.Push(t.InstArgs[i])
	}
	return false
}

// pushSignature pushes the parameter and result types of function type ft, last first.
func pushSignature(ft @Type) {
	for i := len(ft.Results) - 1; i >= 0; i-- {
		selfStack.Push(ft.Results[i])
	}
	for i := len(ft.Params) - 1; i >= 0; i-- {
		selfStack.Push(ft.Params[i].Type)
	}
}
