package "pkg/binate/types"

import "pkg/builtins/testing"

// selfFuncType returns a function type with params ps and results rs.
func selfFuncType(ps @[]@Type, rs @[]@Type) @Type {
	var params @[]@Param = make_slice(@Param, len(ps))
	for i := 0; i < len(ps); i++ {
		var p @Param = make(Param)
		p.Type = ps[i]
		params[i] = p
	}
	return MakeFuncType(params, rs)
}

// oneType returns the one-element type list {t}.
func oneType(t @Type) @[]@Type {
	var ts @[]@Type = make_slice(@Type, 1)
	ts[0] = t
	return ts
}

func TestMentionsSelfComposites() testing.TestResult {
	if !MentionsSelf(TypSelf()) { return "bare Self" }
	if !MentionsSelf(MakeManagedSliceType(MakePointerType(TypSelf()))) { return "@[]*Self" }
	if !MentionsSelf(MakeReadonlyType(MakeArrayType(TypSelf(), 2))) { return "readonly [2]Self" }
	var noParams @[]@Param
	if !MentionsSelf(MakeFuncValueType(noParams, oneType(TypSelf()))) { return "*func() Self" }
	if MentionsSelf(MakeManagedSliceType(TypInt())) { return "@[]int mentions no Self" }
	if MentionsSelf(nil) { return "nil mentions no Self" }
	return ""
}

// An anonymous struct's fields are walked; a named struct's are not (they
// cannot mention Self except through type arguments).
func TestMentionsSelfStructFields() testing.TestResult {
	var f @Field = make(Field)
	f.Name = "x"
	f.Type = MakePointerType(TypSelf())
	var fields @[]@Field = make_slice(@Field, 1)
	fields[0] = f
	if !MentionsSelf(MakeStructType("", fields)) { return "struct { x *Self }" }
	var g @Field = make(Field)
	g.Name = "x"
	g.Type = TypInt()
	var plain @[]@Field = make_slice(@Field, 1)
	plain[0] = g
	if MentionsSelf(MakeStructType("", plain)) { return "struct { x int } mentions no Self" }
	return ""
}

// A generic instance's type arguments are walked, through an interface value
// to its interface too.
func TestMentionsSelfTypeArgs() testing.TestResult {
	var bx @Type = MakeNamedType("main.Box[Self]")
	bx.InstArgs = oneType(TypSelf())
	if !MentionsSelf(MakePointerType(bx)) { return "*Box[Self]" }
	var g @Type = MakeInterfaceType("main", "G[Self]")
	g.InstArgs = oneType(MakeManagedSliceType(TypSelf()))
	if !MentionsSelf(MakeInterfaceValueType(g)) { return "*G[@[]Self]" }
	var gi @Type = MakeInterfaceType("main", "G[int]")
	gi.InstArgs = oneType(TypInt())
	if MentionsSelf(MakeManagedInterfaceValueType(gi)) { return "@G[int] mentions no Self" }
	return ""
}

func TestFuncMentionsSelfParamsAndResults() testing.TestResult {
	var none @[]@Type
	if !FuncMentionsSelf(selfFuncType(oneType(TypSelf()), none)) { return "Self param" }
	if !FuncMentionsSelf(selfFuncType(none, oneType(MakePointerType(TypSelf())))) {
		return "*Self result"
	}
	if FuncMentionsSelf(selfFuncType(oneType(TypInt()), oneType(TypBool()))) {
		return "func(int) bool mentions no Self"
	}
	if FuncMentionsSelf(nil) { return "nil mentions no Self" }
	return ""
}
