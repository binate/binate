package "pkg/binate/types"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/parser"
import "pkg/builtins/testing"
import "pkg/std/strconv"
import "pkg/std/strings"

// ============================================================
// Helpers
// ============================================================

func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

func fail(msg @[]char) testing.TestResult {
	return msg
}

// ============================================================
// Type Construction & Query Tests
// ============================================================

func TestPredeclaredTypes() testing.TestResult {
	var t @Type = TypInt()
	if t == nil { return fail("TypInt is nil") }
	if t.Kind != TYP_INT { return fail("TypInt kind wrong") }
	if !streq(t.Name, "int") { return fail("TypInt name wrong") }

	var b @Type = TypBool()
	if b == nil { return fail("TypBool is nil") }
	if b.Kind != TYP_BOOL { return fail("TypBool kind wrong") }

	var v @Type = TypVoid()
	if v == nil { return fail("TypVoid is nil") }
	if v.Kind != TYP_VOID { return fail("TypVoid kind wrong") }

	var e @Type = TypError()
	if e == nil { return fail("TypError is nil") }
	if e.Kind != TYP_ERROR { return fail("TypError kind wrong") }
	// The error sentinel must be DISTINCT from void: they are both "no usable
	// value" but a real void result is still a reportable assignment error,
	// whereas the error sentinel suppresses follow-on diagnostics.
	if e.Kind == TYP_VOID { return fail("TypError must not be TYP_VOID") }

	return ""
}

func TestIntTypes() testing.TestResult {
	var t8 @Type = TypInt8()
	if t8.Width != 8 { return fail("int8 width wrong") }
	if !t8.Signed { return fail("int8 should be signed") }

	var u32 @Type = TypUint32()
	if u32.Width != 32 { return fail("uint32 width wrong") }
	if u32.Signed { return fail("uint32 should be unsigned") }

	return ""
}

func TestFloatTypes() testing.TestResult {
	var f32 @Type = TypFloat32()
	if f32 == nil { return fail("TypFloat32 is nil") }
	if f32.Kind != TYP_FLOAT { return fail("TypFloat32 kind wrong") }
	if f32.Width != 32 { return fail("TypFloat32 width wrong") }
	if !streq(f32.Name, "float32") { return fail("TypFloat32 name wrong") }

	var f64 @Type = TypFloat64()
	if f64 == nil { return fail("TypFloat64 is nil") }
	if f64.Kind != TYP_FLOAT { return fail("TypFloat64 kind wrong") }
	if f64.Width != 64 { return fail("TypFloat64 width wrong") }
	if !streq(f64.Name, "float64") { return fail("TypFloat64 name wrong") }

	if f32.Identical(f64) { return fail("float32 vs float64 should differ") }
	return ""
}

func TestIsFloat() testing.TestResult {
	if !TypFloat32().IsFloat() { return fail("float32 is float") }
	if !TypFloat64().IsFloat() { return fail("float64 is float") }
	if !TypUntypedFloat().IsFloat() { return fail("untyped float is float") }
	if TypInt().IsFloat() { return fail("int is not float") }
	if TypUntypedInt().IsFloat() { return fail("untyped int is not float") }
	if TypBool().IsFloat() { return fail("bool is not float") }
	return ""
}

func TestIsNumericIncludesFloats() testing.TestResult {
	if !TypFloat32().IsNumeric() { return fail("float32 should be numeric") }
	if !TypFloat64().IsNumeric() { return fail("float64 should be numeric") }
	if !TypUntypedFloat().IsNumeric() { return fail("untyped float should be numeric") }
	return ""
}

func TestAssignableFloat() testing.TestResult {
	var uf @Type = TypUntypedFloat()
	var f32 @Type = TypFloat32()
	var f64 @Type = TypFloat64()
	if !uf.AssignableTo(nil, f32) { return fail("untyped float -> float32") }
	if !uf.AssignableTo(nil, f64) { return fail("untyped float -> float64") }
	if !f64.AssignableTo(nil, f64) { return fail("float64 -> float64") }
	if f32.AssignableTo(nil, f64) {
		return fail("float32 not implicitly -> float64")
	}
	if TypUntypedInt().AssignableTo(nil, f64) {
		return fail("untyped int not implicitly -> float64")
	}
	if TypInt().AssignableTo(nil, f64) {
		return fail("int not implicitly -> float64")
	}
	return ""
}

func TestDefaultTypeUntypedFloat() testing.TestResult {
	var dt @Type = defaultType(TypUntypedFloat())
	if !dt.Identical(TypFloat64()) { return fail("default type of untyped float should be float64") }
	return ""
}

func TestSizeOfFloat() testing.TestResult {
	if TypFloat32().SizeOf() != 4 { return fail("float32.SizeOf() != 4") }
	if TypFloat64().SizeOf() != 8 { return fail("float64.SizeOf() != 8") }
	return ""
}

// ============================================================
// readonly type modifier — Stage 0 (syntax + permissive)
// ============================================================

func TestMakeReadonlyType() testing.TestResult {
	var inner @Type = TypInt()
	var c @Type = MakeReadonlyType(inner)
	if c == nil { return fail("MakeReadonlyType returned nil") }
	if c.Kind != TYP_READONLY { return fail("expected TYP_READONLY") }
	if !c.Elem.Identical(inner) { return fail("elem should be int") }
	return ""
}

// MakeReadonlyType on an already-readonly type collapses to one wrapper.
func TestMakeReadonlyCollapses() testing.TestResult {
	var once @Type = MakeReadonlyType(TypInt())
	var twice @Type = MakeReadonlyType(once)
	if twice.Kind != TYP_READONLY { return fail("twice not TYP_READONLY") }
	if twice.Elem == nil { return fail("twice.Elem nil") }
	if twice.Elem.Kind == TYP_READONLY {
		return fail("two readonly wrappers stacked; expected one")
	}
	return ""
}

func TestIsReadonly() testing.TestResult {
	if TypInt().IsReadonly() { return fail("int is not readonly") }
	if !MakeReadonlyType(TypInt()).IsReadonly() {
		return fail("readonly int is readonly")
	}
	// `*readonly int` is a pointer, not readonly at the outer level.
	var ptrConst @Type = MakePointerType(MakeReadonlyType(TypInt()))
	if ptrConst.IsReadonly() { return fail("*readonly int outer is pointer") }
	return ""
}

func TestStripReadonly() testing.TestResult {
	var ci @Type = MakeReadonlyType(TypInt())
	var stripped @Type = ci.StripReadonly()
	if !stripped.Identical(TypInt()) {
		return fail("readonly int.StripReadonly() should be int")
	}
	// Non-readonly input returns unchanged.
	var i @Type = TypInt()
	if !i.StripReadonly().Identical(i) {
		return fail("StripReadonly on non-readonly should return as-is")
	}
	return ""
}

// Stage 0: Identical treats readonly as transparent (permissive).
func TestIdenticalReadonlyTransparent() testing.TestResult {
	if !MakeReadonlyType(TypInt()).Identical(TypInt()) {
		return fail("readonly int should be identical to int (Stage 0)")
	}
	return ""
}

// Predicates see through readonly.
func TestIsIntegerThroughReadonly() testing.TestResult {
	if !MakeReadonlyType(TypInt()).IsInteger() {
		return fail("readonly int is integer")
	}
	return ""
}

func TestIsSliceThroughReadonly() testing.TestResult {
	var s @Type = MakeSliceType(TypInt())
	if !MakeReadonlyType(s).IsSlice() {
		return fail("readonly *[]int is slice")
	}
	return ""
}

// SliceElem / PointerElem see through readonly at the OUTER level only.
func TestSliceElemThroughReadonly() testing.TestResult {
	var s @Type = MakeSliceType(TypInt())
	var cs @Type = MakeReadonlyType(s)
	var elem @Type = cs.SliceElem()
	if !elem.Identical(TypInt()) {
		return fail("readonly *[]int.SliceElem() should be int")
	}
	return ""
}

// SizeOf / AlignOf are transparent to readonly (same layout).
func TestSizeOfReadonly() testing.TestResult {
	if MakeReadonlyType(TypFloat64()).SizeOf() != 8 {
		return fail("readonly float64.SizeOf() != 8")
	}
	return ""
}

func TestAlignOfReadonly() testing.TestResult {
	// int64's AlignOf is capped by maxAlign() (dynamic on the live
	// target).  Pin to 64-bit so maxAlign=8 and the assertion is
	// host-independent.  `setTarget64` is from scope_test.bn,
	// sibling in this package's test set.
	setTarget64()
	if MakeReadonlyType(TypInt64()).AlignOf() != 8 {
		return fail("readonly int64.AlignOf() != 8")
	}
	return ""
}

// TypeName renders readonly with a "readonly " prefix.
func TestTypeNameReadonly() testing.TestResult {
	var ci @Type = MakeReadonlyType(TypInt())
	if !streq(ci.TypeName(), "readonly int") {
		return fail("readonly int.TypeName() should be 'readonly int'")
	}
	var cs @Type = MakeReadonlyType(MakeSliceType(TypInt()))
	if !streq(cs.TypeName(), "readonly *[]int") {
		return fail("readonly *[]int.TypeName() should be 'readonly *[]int'")
	}
	return ""
}

func TestCharByteAlias() testing.TestResult {
	var ch @Type = TypChar()
	var by @Type = TypByte()
	var u8 @Type = TypUint8()
	if !ch.Identical(u8) { return fail("char should be uint8") }
	if !by.Identical(u8) { return fail("byte should be uint8") }
	return ""
}

func TestMakePointerType() testing.TestResult {
	var p @Type = MakePointerType(TypInt())
	if p.Kind != TYP_POINTER { return fail("kind wrong") }
	if !p.Elem.Identical(TypInt()) { return fail("elem wrong") }
	return ""
}

func TestMakeManagedPtrType() testing.TestResult {
	var p @Type = MakeManagedPtrType(TypInt())
	if p.Kind != TYP_MANAGED_PTR { return fail("kind wrong") }
	if !p.Elem.Identical(TypInt()) { return fail("elem wrong") }
	return ""
}

func TestMakeSliceType() testing.TestResult {
	var s @Type = MakeSliceType(TypInt())
	if s.Kind != TYP_SLICE { return fail("kind wrong") }
	if !s.Elem.Identical(TypInt()) { return fail("elem wrong") }
	return ""
}

func TestMakeArrayType() testing.TestResult {
	var a @Type = MakeArrayType(TypInt(), 10)
	if a.Kind != TYP_ARRAY { return fail("kind wrong") }
	if a.ArrayLen != 10 { return fail("length wrong") }
	return ""
}

func TestMakeStructType() testing.TestResult {
	var f1 @Field = make(Field)
	f1.Name = "X"
	f1.Type = TypInt()
	var f2 @Field = make(Field)
	f2.Name = "Y"
	f2.Type = TypBool()
	var fields @[]@Field = make_slice(@Field, 2)
	fields[0] = f1
	fields[1] = f2
	var s @Type = MakeStructType("Point", fields)
	if s.Kind != TYP_STRUCT { return fail("kind wrong") }
	if len(s.Fields) != 2 { return fail("field count wrong") }
	return ""
}

func TestMakeFuncType() testing.TestResult {
	var p1 @Param = make(Param)
	p1.Name = "x"
	p1.Type = TypInt()
	var params @[]@Param = make_slice(@Param, 1)
	params[0] = p1
	var results @[]@Type = make_slice(@Type, 1)
	results[0] = TypBool()
	var ft @Type = MakeFuncType(params, results)
	if ft.Kind != TYP_FUNC { return fail("kind wrong") }
	if len(ft.Params) != 1 { return fail("param count wrong") }
	if len(ft.Results) != 1 { return fail("result count wrong") }
	return ""
}

// ============================================================
// Checker Integration Tests
// ============================================================

func toBytes(s *[]readonly char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

func checkSrc(src *[]readonly char) @Checker {
	var srcBytes @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(srcBytes, "test.bn")
	var file @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.Check(file)
	return c
}

// checkSrcInterpreted is checkSrc with Checker.Interpreted set — the config an
// interpreter host (interp / REPL) uses, under which __c_call is rejected.
func checkSrcInterpreted(src *[]readonly char) @Checker {
	var srcBytes @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(srcBytes, "test.bn")
	var file @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.Interpreted = true
	c.Check(file)
	return c
}

// checkSrcImporting loads a sibling package's interface (bniSrc) under
// pkgPath, then type-checks mainSrc (which may `import` pkgPath).  For
// cross-package checker tests that need a real imported symbol — e.g.
// resolving `pkg.X` to an imported const.
func checkSrcImporting(pkgPath @[]char, bniSrc *[]readonly char,
		mainSrc *[]readonly char) @Checker {
	var c @Checker = NewChecker()
	c.LoadPackageInterface(pkgPath, mkBniFile(bniSrc))
	var p @parser.Parser = parser.New(toBytes(mainSrc), "test.bn")
	var file @ast.File = p.ParseFile()
	c.Check(file)
	return c
}

func expectNoErrors(c @Checker) testing.TestResult {
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) > 0 {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("expected no errors, got ")
		cb.Write(strconv.Itoa(len(errs)))
		cb.Write(": ")
		cb.Write(errs[0].Msg)
		var result @[]char = buf.CopyStr(cb.String())
		return result
	}
	return ""
}

func expectError(c @Checker) testing.TestResult {
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) == 0 {
		return "expected errors but got none"
	}
	return ""
}

// ============================================================
// Additional Type Construction Tests
// ============================================================

func TestMakeManagedSliceType() testing.TestResult {
	var ms @Type = MakeManagedSliceType(TypInt())
	if ms.Kind != TYP_MANAGED_SLICE { return fail("kind should be managed_slice") }
	if ms.Elem == nil { return fail("elem should not be nil") }
	if ms.Elem.Kind != TYP_INT { return fail("elem should be int") }
	return ""
}

func TestMakeNamedType() testing.TestResult {
	var nt @Type = MakeNamedType("MyInt")
	if nt.Kind != TYP_NAMED { return fail("kind should be named") }
	if !streq(nt.Name, "MyInt") { return fail("name wrong") }
	// Underlying should be nil until set
	if nt.Underlying != nil { return fail("underlying should be nil initially") }
	// Set underlying and verify
	nt.Underlying = TypInt()
	if !nt.Underlying.Identical(TypInt()) { return fail("underlying should be int after set") }
	return ""
}

// A named distinct scalar is classified and sized by its underlying:
// IsFloat / IsInteger / IsBool / IsScalar peel TYP_NAMED (recursing, so
// a named-over-named also resolves), and SizeOf / AlignOf use the
// underlying's layout.  Without these peels a named float reads as
// non-float (the const-scalar rejection / mis-lowering) and a named
// sub-word scalar mis-sizes any aggregate containing it.
func TestNamedScalarPredicatesAndLayout() testing.TestResult {
	var nf @Type = MakeNamedType("Rate")
	nf.Underlying = TypFloat32()
	if !nf.IsFloat() { return fail("named float must be IsFloat") }
	if nf.IsInteger() { return fail("named float must not be IsInteger") }
	if !nf.IsScalar() { return fail("named float must be IsScalar") }
	if nf.SizeOf() != 4 { return fail("named float32 SizeOf must be 4") }

	var nb @Type = MakeNamedType("Flag")
	nb.Underlying = TypBool()
	if !nb.IsBool() { return fail("named bool must be IsBool") }
	if !nb.IsScalar() { return fail("named bool must be IsScalar") }

	var ni @Type = MakeNamedType("Celsius")
	ni.Underlying = TypInt()
	if !ni.IsInteger() { return fail("named int must be IsInteger") }

	// Named-over-named: B's underlying is A (itself a named float).
	var nn @Type = MakeNamedType("Nested")
	nn.Underlying = nf
	if !nn.IsFloat() { return fail("named-over-named float must be IsFloat") }
	return ""
}

func TestNeedsDestruction() testing.TestResult {
	// Primitives: no
	if TypInt().NeedsDestruction() { return fail("int needs no dtor") }
	if TypBool().NeedsDestruction() { return fail("bool needs no dtor") }

	// Raw pointer/slice: no
	if MakePointerType(TypInt()).NeedsDestruction() { return fail("*int needs no dtor") }
	if MakeSliceType(TypInt()).NeedsDestruction() { return fail("*[]int needs no dtor") }

	// Managed pointer: yes
	if !MakeManagedPtrType(TypInt()).NeedsDestruction() { return fail("@int needs dtor") }

	// Managed-slice: yes
	if !MakeManagedSliceType(TypInt()).NeedsDestruction() { return fail("@[]int needs dtor") }

	// Struct with no managed fields: no
	var f1 @Field = make(Field)
	f1.Name = "X"
	f1.Type = TypInt()
	var plainFields @[]@Field = make_slice(@Field, 1)
	plainFields[0] = f1
	var plainStruct @Type = MakeStructType("Plain", plainFields)
	if plainStruct.NeedsDestruction() { return fail("struct{int} needs no dtor") }

	// Struct with managed field: yes
	var f2 @Field = make(Field)
	f2.Name = "Ptr"
	f2.Type = MakeManagedPtrType(TypInt())
	var managedFields @[]@Field = make_slice(@Field, 2)
	managedFields[0] = f1
	managedFields[1] = f2
	var managedStruct @Type = MakeStructType("HasPtr", managedFields)
	if !managedStruct.NeedsDestruction() { return fail("struct{int, @int} needs dtor") }

	// Array of ints: no
	var arrInt @Type = MakeArrayType(TypInt(), 5)
	if arrInt.NeedsDestruction() { return fail("[5]int needs no dtor") }

	// Array of managed ptrs: yes
	var arrManaged @Type = MakeArrayType(MakeManagedPtrType(TypInt()), 3)
	if !arrManaged.NeedsDestruction() { return fail("[3]@int needs dtor") }

	// Named type wrapping struct with managed field: yes
	var named @Type = MakeNamedType("MyStruct")
	named.Underlying = managedStruct
	if !named.NeedsDestruction() { return fail("named struct with @int field needs dtor") }

	// Named type wrapping plain struct: no
	var namedPlain @Type = MakeNamedType("PlainNamed")
	namedPlain.Underlying = plainStruct
	if namedPlain.NeedsDestruction() { return fail("named struct{int} needs no dtor") }

	return ""
}

func TestExprTypeAnnotation() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc foo() int { var x int = 42; return x }"
	var srcBytes @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(srcBytes, "test.bn")
	var file @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.Check(file)
	var r testing.TestResult = expectNoErrors(c)
	if len(r) > 0 { return r }

	// The file should have one func decl with a body containing two stmts.
	// The var decl's value (42) and the return's expr (x) should have type IDs.
	var funcDecl @ast.Decl = file.Decls[0]
	var body @ast.Stmt = funcDecl.Body
	// stmt 0: var x int = 42
	var varStmt @ast.Stmt = body.Stmts[0]
	var varDecl @ast.Decl = varStmt.DeclRef
	var valExpr @ast.Expr = varDecl.Value
	if valExpr.ResolvedTypeID == 0 {
		return "var value expr should have ResolvedTypeID set"
	}
	var valType @Type = c.ExprType(valExpr.ResolvedTypeID)
	if valType == nil {
		return "ExprType should return non-nil for resolved expr"
	}
	// 42 is untyped int
	if valType.Kind != TYP_UNTYPED_INT {
		return "42 should resolve to untyped int"
	}

	// stmt 1: return x
	var retStmt @ast.Stmt = body.Stmts[1]
	var retExpr @ast.Expr = retStmt.Exprs[0]
	if retExpr.ResolvedTypeID == 0 {
		return "return expr should have ResolvedTypeID set"
	}
	var retType @Type = c.ExprType(retExpr.ResolvedTypeID)
	if retType == nil {
		return "ExprType should return non-nil for return expr"
	}
	if retType.Kind != TYP_INT {
		return "x should resolve to int"
	}

	// Verify unresolved ID returns nil
	var nilType @Type = c.ExprType(0)
	if nilType != nil {
		return "ExprType(0) should return nil (unresolved)"
	}

	return ""
}

// End-to-end check that *func(...) and @func(...) parse + resolve
// through the type-checker without errors. Verifies that the new
// AST kinds reach resolveTypeExpr and produce TYP_FUNC_VALUE /
// TYP_MANAGED_FUNC_VALUE Types.
func TestCheckFuncValueTypeParam() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f(g *func(int) int) {}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckManagedFuncValueTypeParam() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f(g @func()) {}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFuncValueTypeMultiReturn() testing.TestResult {
	// Multi-return func value as a parameter type — a slightly more
	// involved shape that exercises ResultTypes parsing + resolution.
	var src *[]readonly char = "package \"test\"\nfunc f(g *func(int) (int, *int)) {}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// AssignableTo accepts TYP_FUNC → TYP_FUNC_VALUE / TYP_MANAGED_FUNC_VALUE
// when the signatures match. This is the type-system half of A.5: an
// expression of TYP_FUNC (a bare function reference) flows into a slot
// of function-value type. Without this, IR-gen's coercion would still
// fire but the assignment / call / return / composite-lit site would be
// rejected at type-check time.
func TestAssignableTo_FuncRefToFuncValue() testing.TestResult {
	var paramsInt @[]@Param = make_slice(@Param, 1)
	var p0 @Param = make(Param)
	p0.Type = TypInt()
	paramsInt[0] = p0
	var resultsInt @[]@Type = make_slice(@Type, 1)
	resultsInt[0] = TypInt()

	var fn @Type = MakeFuncType(paramsInt, resultsInt)
	var fv @Type = MakeFuncValueType(paramsInt, resultsInt)
	var mfv @Type = MakeManagedFuncValueType(paramsInt, resultsInt)

	if !fn.AssignableTo(nil, fv) {
		return fail("func(int) int → *func(int) int should be assignable")
	}
	if !fn.AssignableTo(nil, mfv) {
		return fail("func(int) int → @func(int) int should be assignable")
	}

	// Mismatched signature: not assignable.
	var noParams @[]@Param
	var fnNoArgs @Type = MakeFuncType(noParams, resultsInt)
	if fnNoArgs.AssignableTo(nil, fv) {
		return fail("func() int should not be assignable to *func(int) int")
	}

	// Mismatched result: not assignable.
	var resultsBool @[]@Type = make_slice(@Type, 1)
	resultsBool[0] = TypBool()
	var fnBool @Type = MakeFuncType(paramsInt, resultsBool)
	if fnBool.AssignableTo(nil, fv) {
		return fail(
				"func(int) bool should not be assignable to *func(int) int")
	}

	return ""
}

func TestIsNumeric() testing.TestResult {
	if !TypInt().IsNumeric() { return fail("int should be numeric") }
	if !TypInt32().IsNumeric() { return fail("int32 should be numeric") }
	if !TypUint64().IsNumeric() { return fail("uint64 should be numeric") }
	if !TypUntypedInt().IsNumeric() { return fail("untyped int should be numeric") }
	if TypBool().IsNumeric() { return fail("bool should not be numeric") }
	return ""
}

// IsScalar: integers (incl. char/sized), floats, and bool — seen
// through readonly — are scalar; composites are not.  Backs the
// scalar-only-const rule (checkConstDecl).
func TestIsScalar() testing.TestResult {
	if !TypInt().IsScalar() { return fail("int should be scalar") }
	if !TypChar().IsScalar() { return fail("char should be scalar") }
	if !TypBool().IsScalar() { return fail("bool should be scalar") }
	if !TypFloat64().IsScalar() { return fail("float64 should be scalar") }
	if !TypUntypedInt().IsScalar() { return fail("untyped int should be scalar") }
	if !MakeReadonlyType(TypInt()).IsScalar() {
		return fail("readonly int should be scalar")
	}
	if MakeSliceType(TypInt()).IsScalar() {
		return fail("*[]int should NOT be scalar")
	}
	if MakePointerType(TypInt()).IsScalar() {
		return fail("*int should NOT be scalar")
	}
	if MakeManagedPtrType(TypInt()).IsScalar() {
		return fail("@int should NOT be scalar")
	}
	return ""
}
