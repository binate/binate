package "pkg/binate/types"

import "pkg/builtins/testing"

// TYP_UNTYPED_STRING adoption arm (untypedStringAssignableTo), exercised directly
// via makeUntypedString — the kind the string-literal expression will produce
// (Inc 2).  A runtime [N]readonly char array is a TYP_ARRAY and never this kind,
// so these arms cannot be reached by a runtime array (the whole point of the
// untyped model).

// An untyped string adopts every string-writable slice target.
func TestUntypedStringToManagedCharSlice() testing.TestResult {
	var src @Type = makeUntypedString(3)
	if !src.AssignableTo(nil, MakeManagedSliceType(TypChar())) {
		return fail("untyped string → @[]char should be assignable")
	}
	if !src.AssignableTo(nil, MakeManagedSliceType(MakeReadonlyType(TypChar()))) {
		return fail("untyped string → @[]readonly char should be assignable")
	}
	if !src.AssignableTo(nil, MakeSliceType(MakeReadonlyType(TypChar()))) {
		return fail("untyped string → *[]readonly char should be assignable")
	}
	return ""
}

// *[]char (a mutable raw view of rodata) is the ratchet: rejected.
func TestUntypedStringRejectsRawMutableSlice() testing.TestResult {
	var src @Type = makeUntypedString(3)
	if src.AssignableTo(nil, MakeSliceType(TypChar())) {
		return fail("untyped string → *[]char should NOT be assignable")
	}
	return ""
}

// Non-char slice / scalar / pointer targets are rejected.
func TestUntypedStringRejectsNonCharTargets() testing.TestResult {
	var src @Type = makeUntypedString(3)
	if src.AssignableTo(nil, MakeSliceType(TypInt())) {
		return fail("untyped string → *[]int should NOT be assignable")
	}
	if src.AssignableTo(nil, TypInt()) {
		return fail("untyped string → int should NOT be assignable")
	}
	if src.AssignableTo(nil, MakePointerType(TypChar())) {
		return fail("untyped string → *char should NOT be assignable")
	}
	return ""
}

// Array targets via BARE AssignableTo are EXACT-length: [N]char accepted, any
// other length rejected.  The shorter-literal zero-padded buffer init (M > N) is a
// var-decl / struct-literal-only feature (stringLitInitFitsArray), exercised at the
// expression level, not through AssignableTo.
func TestUntypedStringToArrayTargets() testing.TestResult {
	var src @Type = makeUntypedString(3)
	if !src.AssignableTo(nil, MakeArrayType(TypChar(), 3)) {
		return fail("untyped string (N=3) → [3]char should be assignable (exact)")
	}
	if !src.AssignableTo(nil, MakeArrayType(MakeReadonlyType(TypChar()), 3)) {
		return fail("untyped string (N=3) → [3]readonly char should be assignable (exact)")
	}
	if src.AssignableTo(nil, MakeArrayType(TypChar(), 5)) {
		return fail("untyped string (N=3) → [5]char should NOT be assignable (bare, non-exact)")
	}
	if src.AssignableTo(nil, MakeArrayType(TypChar(), 2)) {
		return fail("untyped string (N=3) → [2]char should NOT be assignable (over-long)")
	}
	return ""
}

// The default type of an untyped string is @[]readonly char (a managed slice with
// a readonly-char element), the same inference default as before.
func TestUntypedStringDefaultType() testing.TestResult {
	var d @Type = defaultType(makeUntypedString(4))
	if d == nil || d.Kind != TYP_MANAGED_SLICE {
		return fail("default should be a managed slice")
	}
	if d.Elem == nil || d.Elem.Kind != TYP_READONLY {
		return fail("default element should be readonly-wrapped")
	}
	return ""
}

// untypedStringNaturalArray reconstructs the [N]readonly char natural array.
func TestUntypedStringNaturalArray() testing.TestResult {
	var a @Type = untypedStringNaturalArray(makeUntypedString(3))
	if a == nil || a.Kind != TYP_ARRAY || a.ArrayLen != 3 {
		return fail("natural array should be [3]...")
	}
	if a.Elem == nil || a.Elem.Kind != TYP_READONLY {
		return fail("natural array element should be readonly char")
	}
	return ""
}

// ============================================================
// Expression-level (end-to-end) — the MAJOR bug fix and preserved behaviors
// ============================================================

// THE BUG FIX: a RUNTIME [N]readonly char array returned/assigned where a slice is
// expected is a type error (array→slice is not a legal implicit conversion; lowering
// a stack array into a slice buffer is a use-after-free).
func TestRuntimeReadonlyArrayToManagedSliceRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f() @[]char { var a [3]readonly char; return a }\n")
	return expectError(c)
}

func TestRuntimeReadonlyArrayToRawSliceRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f() *[]readonly char { var a [3]readonly char; return a }\n")
	return expectError(c)
}

// A string LITERAL in the same position is still accepted (it is untyped and adopts
// the slice).
func TestStringLitToManagedSliceAccepted() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\n"
			"func f() @[]char { return \"hi\" }\n")
	return expectNoErrors(c)
}

func TestStringLitToRawReadonlySliceAccepted() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\n"
			"func f() *[]readonly char { return \"hi\" }\n")
	return expectNoErrors(c)
}

// A string literal inferred with `:=` defaults to @[]readonly char.
func TestStringLitInferDefault() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\n"
			"func f() { x := \"hi\"; _ = x }\n")
	return expectNoErrors(c)
}

// The shorter-literal zero-padded buffer init IS allowed at a var-decl (M > N).
func TestStringLitZeroPadVarDeclAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f() { var buf [5]char = \"abc\"; _ = buf }\n")
	return expectNoErrors(c)
}

// ...but NOT through a bare return (the zero-pad is a var-decl/struct-literal-only
// feature; a return is an exact-length assignability check).  Preserves pre-untyped
// behavior — this asymmetry is intentional, not introduced by the untyped rework.
func TestStringLitZeroPadReturnRejected() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\n"
			"func f() [5]char { return \"abc\" }\n")
	return expectError(c)
}

// An exact-length char-array return IS accepted.
func TestStringLitExactArrayReturnAccepted() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\n"
			"func f() [3]char { return \"abc\" }\n")
	return expectNoErrors(c)
}

// TWO string literals are NOT comparable with == / != : each is untyped with no
// concrete peer, so each defaults to @[]readonly char (a slice), which is
// incomparable (§13.6 expr.compare.incomparable, via §6.2 const.default).  This
// also forecloses the two-literal pointer comparison that used to slip through
// (only accidentally correct when the literals dedup).
func TestStringLitEqRejected() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\n"
			"func f() bool { return \"a\" == \"a\" }\n")
	return expectError(c)
}

func TestStringLitDifferentLenEqRejected() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\n"
			"func f() bool { return \"a\" == \"bb\" }\n")
	return expectError(c)
}

func TestStringLitNeqRejected() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\n"
			"func f() bool { return \"a\" != \"b\" }\n")
	return expectError(c)
}

// A string literal compared to a SLICE is rejected in BOTH orders: the literal
// adopts the slice type, and slices are incomparable (§13.6).
func TestStringLitVsSliceEqRejectedLitLeft() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\n"
			"func f(s @[]char) bool { return \"a\" == s }\n")
	return expectError(c)
}

func TestStringLitVsSliceEqRejectedSliceLeft() testing.TestResult {
	var c @Checker = checkSrc("package \"test\"\n"
			"func f(s @[]char) bool { return s == \"a\" }\n")
	return expectError(c)
}

// A char array compared to a WRONG-LENGTH string literal is rejected — the literal
// adopts a char array only at EXACT length, so `[2]char == "abc"` is a type
// mismatch, not a comparison.
func TestArrayLenMismatchVsStringLitRejected() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a [2]char) bool { return a == \"abc\" }\n")
	return expectError(c)
}

// A char-array VARIABLE compared to a string literal IS comparable in BOTH operand
// orders (== is commutative): the untyped literal adopts the array's type (like an
// untyped int in `x == 5`), so the comparison is element-wise (§13.6
// expr.compare.aggregate).  Runtime correctness is verified in conformance
// 13-expressions/056_string_literal_array_compare.
func TestArrayVsStringLitEqAcceptedArrayLeft() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a [3]char) bool { return a == \"abc\" }\n")
	return expectNoErrors(c)
}

func TestArrayVsStringLitEqAcceptedLitLeft() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a [3]char) bool { return \"abc\" == a }\n")
	return expectNoErrors(c)
}

// A string-literal switch case against a char-array tag IS accepted (the case
// matches the tag by an implicit ==, element-wise).
func TestStringLitSwitchCaseAccepted() testing.TestResult {
	var c @Checker = checkSrc(
			"package \"test\"\n"
					"func f(a [3]char) { switch a { case \"abc\": var x int = 0\n_ = x } }\n")
	return expectNoErrors(c)
}
