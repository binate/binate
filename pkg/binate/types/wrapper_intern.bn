package "pkg/binate/types"

import "pkg/std/vec"

// Teardown for the per-element wrapper memoization (the Type.Cached* fields,
// populated by MakePointerType / MakeManagedPtrType / MakeSliceType /
// MakeManagedSliceType).
//
// A cached wrapper and its element point at each other with MANAGED (@Type)
// pointers — `elem.CachedPtr` owns the `*elem` wrapper, and the wrapper's `Elem`
// owns `elem` — so the pair forms a reference CYCLE.  A pointer type must own
// its element (you cannot have a live `*T` whose `T` was freed), so the wrapper
// side of the cycle cannot be made non-owning; and Binate is refcounted with no
// cycle collector, so the pair is never reclaimed on its own.  Left alone that
// would leak one type graph per compilation — fine for a one-shot `bnc`/`bni`
// (the OS reclaims at exit) but an unbounded accumulation in a process that runs
// many compilations back to back.
//
// So the caches are process-global (the factories are free functions with no
// per-compilation context to hang a cache on) but are TORN DOWN at each
// compilation boundary: NewChecker calls ResetWrapperInterning, which nil-s the
// Cached* fields of every element that has them, breaking the cycles so the
// previous compilation's wrappers (and the per-compilation element types they
// pinned) become collectable.  Correctness never depends on any of this — the
// cache is a pure memoization keyed on element identity — only prompt
// reclamation does.

// wrapperInternRegistry lists every element type that currently has a cached
// wrapper, so ResetWrapperInterning knows which Cached* fields to clear.  An
// element may appear more than once (it is registered once per wrapper KIND it
// was first asked for); that is harmless because clearing is idempotent.
var wrapperInternRegistry @vec.Vec[@Type] = vec.New[@Type]()

// registerInternedElem records that `elem` now has at least one cached wrapper.
// Called by the MakeXType factories when they first cache a wrapper on `elem`.
func registerInternedElem(elem @Type) {
	wrapperInternRegistry.Push(elem)
}

// ResetWrapperInterning drops every cached wrapper by nil-ing the Cached* fields
// of each registered element, breaking the element<->wrapper reference cycles so
// the prior compilation's type graph can be reclaimed.  Called at the start of
// NewChecker (a no-op on the first call, since the registry starts empty).
//
// INVARIANT this relies on: no NewChecker runs while a cached wrapper is still
// held through a RAW (`*Type`) borrow.  Managed (`@Type`) holders are always
// safe — the reset only RefDecs, and a still-referenced wrapper survives — but a
// raw borrow into a cached wrapper held across a NewChecker would be freed out
// from under it (UAF).  It holds today because the phases that borrow wrapper
// types raw (IR-gen / codegen / native lowering) never create a checker; the
// compilation drivers create exactly one checker before those phases.  A future
// change that spun up a checker mid-lowering while holding a raw wrapper borrow
// would break it.
func ResetWrapperInterning() {
	for i := 0; i < wrapperInternRegistry.Len(); i++ {
		var e @Type = wrapperInternRegistry.Get(i)
		if e == nil { continue }
		e.CachedPtr = nil
		e.CachedMPtr = nil
		e.CachedSlice = nil
		e.CachedMSlice = nil
	}
	wrapperInternRegistry = vec.New[@Type]()
}
