package "pkg/binate/types"

import "pkg/builtins/testing"

// freshWrapperElem returns a distinct struct-typed element with empty wrapper
// caches, so the interning tests are isolated from the shared predeclared
// singletons (whose caches other tests may have populated).
func freshWrapperElem(name @[]char) @Type {
	var e @Type = make(Type)
	e.Kind = TYP_STRUCT
	e.Name = name
	return e
}

// MakeManagedSliceType memoizes on its element: repeated requests share one
// wrapper object, the wrapper is stored on the element, and
// ResetWrapperInterning drops the memo so the next request rebuilds.
func TestWrapperInterningCachesAndResets() testing.TestResult {
	ResetWrapperInterning()
	var e @Type = freshWrapperElem("WrapElemA")
	var a @Type = MakeManagedSliceType(e)
	var b @Type = MakeManagedSliceType(e)
	if !same(a, b) {
		return fail("repeated MakeManagedSliceType must return the memoized wrapper")
	}
	if !same(e.CachedMSlice, a) {
		return fail("the wrapper must be cached on the element")
	}
	ResetWrapperInterning()
	if e.CachedMSlice != nil {
		return fail("ResetWrapperInterning must clear the element's cache field")
	}
	var c @Type = MakeManagedSliceType(e)
	if same(a, c) {
		return fail("after reset a fresh wrapper must be built, not the old one")
	}
	return ""
}

// MakeManagedSliceTypeUncached never memoizes: each call yields a distinct
// wrapper and the element's cache field is left untouched — so a runtime caller
// gets a value-scoped descriptor, not a cached one.
func TestWrapperInterningUncached() testing.TestResult {
	ResetWrapperInterning()
	var e @Type = freshWrapperElem("WrapElemB")
	var u1 @Type = MakeManagedSliceTypeUncached(e)
	var u2 @Type = MakeManagedSliceTypeUncached(e)
	if same(u1, u2) {
		return fail("uncached must return a distinct wrapper each call")
	}
	if e.CachedMSlice != nil {
		return fail("uncached must not populate the element cache")
	}
	return ""
}

// Each of the four factories memoizes independently on the same element, and
// different wrapper kinds are distinct objects.
func TestWrapperInterningAllKinds() testing.TestResult {
	ResetWrapperInterning()
	var e @Type = freshWrapperElem("WrapElemC")
	if !same(MakePointerType(e), MakePointerType(e)) {
		return fail("*e must be memoized")
	}
	if !same(MakeManagedPtrType(e), MakeManagedPtrType(e)) {
		return fail("@e must be memoized")
	}
	if !same(MakeSliceType(e), MakeSliceType(e)) {
		return fail("*[]e must be memoized")
	}
	if !same(MakeManagedSliceType(e), MakeManagedSliceType(e)) {
		return fail("@[]e must be memoized")
	}
	if same(MakePointerType(e), MakeManagedPtrType(e)) {
		return fail("*e and @e must be distinct objects")
	}
	// All four kinds are now cached on e; ResetWrapperInterning must clear every
	// one of them (not just CachedMSlice).
	if e.CachedPtr == nil || e.CachedMPtr == nil || e.CachedSlice == nil || e.CachedMSlice == nil {
		return fail("all four wrapper kinds must be cached on the element")
	}
	ResetWrapperInterning()
	if e.CachedPtr != nil || e.CachedMPtr != nil || e.CachedSlice != nil || e.CachedMSlice != nil {
		return fail("ResetWrapperInterning must clear all four cache fields")
	}
	return ""
}
