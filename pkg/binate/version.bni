// Package version exposes the binate-toolchain release identifier the
// calling tool was built from.
package "pkg/binate/version"

// Version is the build's release identifier: `X.Y.Z` for a tagged
// release, `X.Y.Z-preN` for a working-tree build between releases
// (starting at `-pre1` right after a release).  A calling tool
// prepends its own display name (e.g. `bnc-` + Version).
var Version *[]readonly char
