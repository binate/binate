// Package version exposes the binate-toolchain release identifier
// the calling tool was built from.  See plan-version-info.md.
package "pkg/binate/version"

// Format returns the calling tool's display version.  Given a short
// tool name (`"bnc"`, `"bni"`, `"bnas"`, `"bnlint"`), strips the
// `bnc-` prefix from the build's version string and prepends
// `<tool>-` instead — so `Format("bni")` of a `bnc-0.0.7-pre` build
// returns `"bni-0.0.7-pre"`.  The version string itself is
// package-private (see version.bn); Format is the public accessor.
func Format(tool *[]readonly char) @[]char
