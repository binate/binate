// Package version exposes the binate-toolchain release identifier
// the calling tool was built from.  See plan-version-info.md.
package "pkg/binate/version"

// Version names the build this came from.  Format `bnc-X.Y.Z` for
// a tagged release; `bnc-X.Y.Z-pre` for a working-tree build
// between releases.
const Version *[]const char = "bnc-0.0.6-pre"

// Format returns the calling tool's display version.  Given a short
// tool name (`"bnc"`, `"bni"`, `"bnas"`, `"bnlint"`), strips the
// `bnc-` prefix from Version and prepends `<tool>-` instead — so
// `Format("bni")` of a `bnc-0.0.6-pre` build returns
// `"bni-0.0.6-pre"`.
func Format(tool *[]const char) @[]char
