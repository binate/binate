package "pkg/binate/version"

import "pkg/binate/buf"

// version names the build this came from.  Format `bnc-X.Y.Z` for a
// tagged release; `bnc-X.Y.Z-pre` for a working-tree build between
// releases.  Package-private — the public accessor is Format().
// Kept identical to the repo-root VERSION file by the version-sync
// hygiene check.
//
// Type is `*[]readonly char`, not `readonly *[]readonly char`,
// because slicing a `readonly`-wrapped slice isn't supported yet
// (Format does `version[bncPrefixLen:]`); the outer `readonly` that
// would enforce immutability is omitted until that gap is fixed.
// See claude-todo.md.
var version *[]readonly char = "bnc-0.0.7-pre"

// Length of the `bnc-` prefix version always carries.  Stripped in
// Format so the calling tool can substitute its own name.
const bncPrefixLen int = 4

// Format strips version's leading `bnc-` prefix and prepends
// `<tool>-` instead.  Tool-name validity is the caller's
// responsibility — Format does not check that `tool` corresponds
// to a real binate binary.
func Format(tool *[]readonly char) @[]char {
	var tail *[]readonly char = version[bncPrefixLen:]
	return buf.Concat(buf.Concat(tool, "-"), tail)
}
