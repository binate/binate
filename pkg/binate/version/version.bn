package "pkg/binate/version"

// Version names the build this came from: `X.Y.Z` for a tagged stable
// release, `X.Y.ZpreN` for a tagged pre-release (a general toolchain
// bundle used e.g. as CHECK_TOOLS_VERSION — see
// plan-check-tools-version.md), and `X.Y.Z-pre` for an untagged
// working-tree build between releases.  A calling tool prepends its own
// display name (e.g. bnc reports `bnc-` + Version).  Kept in sync with
// the repo-root VERSION file — which additionally carries a `bnc-`
// builder prefix — by the version-sync hygiene check.
var Version *[]readonly char = "0.0.11pre1"
