package "pkg/binate/version"

// Version names the build this came from: `X.Y.Z` for a tagged stable
// release, and `X.Y.Z-preN` for a prerelease — either a tagged toolchain
// bundle (used e.g. as CHECK_TOOLS_VERSION — see
// plan-check-tools-version.md) or the untagged working tree between
// releases, which starts at `-pre1` immediately after a release and
// increments from there.  Prerelease is always hyphenated (`-pre[N]`),
// consistent with semver.  A calling tool prepends its own
// display name (e.g. bnc reports `bnc-` + Version).  Kept in sync with —
// and format-checked against — the repo-root VERSION file (which
// additionally carries a `bnc-` builder prefix) by the version-sync
// hygiene check.
var Version *[]readonly char = "0.0.12-pre5"
