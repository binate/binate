package "pkg/binate/version"

import "pkg/binate/buf"

// Length of the `bnc-` prefix Version always carries.  Stripped
// in Format so the calling tool can substitute its own name.
const bncPrefixLen int = 4

// Format strips Version's leading `bnc-` prefix and prepends
// `<tool>-` instead.  Tool-name validity is the caller's
// responsibility — Format does not check that `tool` corresponds
// to a real binate binary.
func Format(tool *[]const char) @[]char {
	var tail *[]const char = Version[bncPrefixLen:]
	return buf.Concat(buf.Concat(tool, "-"), tail)
}
