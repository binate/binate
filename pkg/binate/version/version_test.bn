package "pkg/binate/version"

import "pkg/builtins/testing"

func charEq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ { if a[i] != b[i] { return false } }
	return true
}

func TestFormatSubstitutesToolName() testing.TestResult {
	var got @[]char = Format("bni")
	// Expect leading "bni-"
	if len(got) < 4 { return "result too short" }
	if got[0] != 'b' || got[1] != 'n' || got[2] != 'i' || got[3] != '-' {
		return "expected leading 'bni-'"
	}
	// Tail (after "bni-") must equal Version's tail (after "bnc-").
	if len(got) != len(Version) {
		return "length mismatch: 'bni-' is same length as 'bnc-'"
	}
	for i := 4; i < len(got); i++ {
		if got[i] != Version[i] { return "tail diverges from Version" }
	}
	return ""
}

func TestVersionStartsWithBncDash() testing.TestResult {
	if len(Version) < 4 { return "Version too short" }
	if Version[0] != 'b' || Version[1] != 'n' || Version[2] != 'c' || Version[3] != '-' {
		return "Version must start with 'bnc-'"
	}
	return ""
}
