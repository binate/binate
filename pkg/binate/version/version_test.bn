package "pkg/binate/version"

import "pkg/builtins/testing"

// Version carries no tool prefix: it begins with a digit (e.g.
// "0.0.7-pre1"), unlike the repo-root VERSION file's `bnc-...`.
// Reading Version here also exercises the package's `__init`-time
// global initialization, which the bytecode VM (`-int` modes) must
// run before tests — a zero-length read would fail this.
func TestVersionHasNoPrefix() testing.TestResult {
	if len(Version) < 3 { return "version too short" }
	if Version[0] < '0' || Version[0] > '9' {
		return "version must start with a digit (no tool prefix)"
	}
	return ""
}
