// Package vm implements a bytecode interpreter that executes IR-derived
// bytecode. Refcounting correctness is inherited from the compiler's IR gen.
package "pkg/binate/vm"

import "pkg/binate/vmdata"

import "pkg/binate/ir"
import "pkg/binate/iropt"
import "pkg/builtins/reflect"
import "pkg/std/cmp"
import "pkg/std/hash"
import "pkg/std/table"
import "pkg/std/vec"

// ============================================================
// Bytecode opcodes
// ============================================================

// ============================================================
// Bytecode instruction
// ============================================================

type BCInstr struct {
	Op   int // opcode
	Dst  int // destination register (-1 for void)
	Src1 int // first source register
	Src2 int // second source register
	Imm  int // immediate value
	Aux  int // auxiliary (jump target, func ID, name index, etc.)
}

// No managed fields in BCInstr — function/builtin names are stored
// in VMFunc.Names and referenced by index via Aux.

// ============================================================
// Cross-mode argument interface-vtable layout
// ============================================================

// ============================================================
// Compiled function
// ============================================================

type VMFunc struct {
	Name  @[]char
	Code  @[]BCInstr // bytecode
	Names @[]@[]char // name table (for call/builtin targets)
	// Vtable / ClosureRec / Handle: lazily-allocated heap blocks
	// used when this function is taken as a function value.  All
	// nil until the first BC_FUNC_VALUE / BC_FUNC_HANDLE executes.
	// Managed so VMFunc's auto-emitted dtor refdecs them on death.
	// Handle is the {VtableAddr=&Vtable, DataAddr=&ClosureRec} pair
	// that BC_FUNC_HANDLE returns the address of for a vm-local
	// function — matches the static `@__handle.F` shape so dispatch
	// is uniform across natively-compiled and bytecode-only
	// functions.
	Vtable     @vmdata.VMFuncVtable
	ClosureRec @vmdata.VMClosureRec
	Handle     @vmdata.VMFuncHandle
	// CallCache: parallel to Names; per-call-site memoized result of
	// LookupFunc(vm, Names[i]).  -2 = unresolved (not yet looked up),
	// -1 = extern (not a VM function), >=0 = vm.Funcs index.  Filled
	// lazily on first execution of each call site.  A future REPL that
	// mutates vm.Funcs must invalidate this cache (full flush, or
	// targeted -1 reset on append).
	CallCache @[]int
	Strings   @[]@[]char // string constants (per-module, shared across
	// all VMFuncs lowered from the same module)
	NumRegs   int // register slots needed
	FrameSize int // stack frame size (bytes)
	// MaxStmtTempGrowth is the worst-case number of bytes vm.SP can grow above
	// the frame base WITHIN this function between two OP_SP_RESTOREs (the max
	// per-statement temp growth: make_slice / iface-value / string-copy headers,
	// call return images, the callee return-image build, and cross-mode
	// arg-substitution scratch).  pushFrame reserves frameExtent +
	// MaxStmtTempGrowth so no statement can overrun vm.Stack.  Computed at lower
	// time by computeMaxStmtTempGrowth; VM-only (compiled backends ignore it).
	MaxStmtTempGrowth int
	NumParams         int // number of parameters
	// NumParamSlots is the number of register slots the parameters
	// occupy.  On a 64-bit host it equals NumParams (one slot per
	// param); on a host whose word is < 8 bytes, an int64/uint64/
	// float64 param occupies a register pair, so the slot count can
	// exceed the param count.  Set by lower_func from
	// argSlots(p.Typ).
	NumParamSlots int
	NumResults    int // number of results
	// For multi-return: per-result byte sizes and offsets
	// in the packed anonymous result struct, plus a parallel
	// "is this a multi-word value" flag. The flag matters even
	// when size is 8 (e.g. struct{int}), because for any
	// multi-word type lowerLoad returns the alloca *pointer*
	// (not the bytes), so packing must MEMCPY through that
	// pointer instead of treating it as a scalar word.
	ResultSizes     @[]int
	ResultOffsets   @[]int
	ResultMultiWord @[]bool

	// ResultUsesRetbuf: whether a compiled caller dispatches this func's value
	// through the RETBUF shim shape (void(retbuf, data, args)) rather than the
	// scalar shape — types.IsAggregateReturn of its result list, the SAME
	// predicate the compiled caller keys its call shape on.  ensureHandle selects
	// TrampolineAggregate iff this is true.  True for EVERY multi-return tuple
	// (len > 1, unconditionally — including a tuple whose fields are all zero-size,
	// where the image below is 0 bytes) and any single wide / coerced aggregate;
	// false for a scalar / void / single 0-byte-struct result.  Set by
	// populateResultMetadata.  This is the SELECTION discriminator; the COPY SIZE
	// is ResultRetbufBytes — the two differ for an all-zero-size tuple (retbuf
	// shape, 0-byte copy).
	ResultUsesRetbuf bool

	// ResultRetbufBytes: the NATURAL (un-rounded) byte size of this func's result
	// image (types.ResultImageSize of its result list), or 0 for a scalar / void /
	// 0-byte-image result.  This is the COPY SIZE TrampolineAggregate memcpys into
	// the caller's natural-typed retbuf — the un-rounded size (NOT the 8-rounded
	// AggregateReturnSize), because the compiled caller sizes its retbuf `alloca`
	// to the natural result type, so a rounded copy would overrun it.  Selection
	// is ResultUsesRetbuf, not this: an all-zero-size tuple is retbuf-dispatched
	// (ResultUsesRetbuf) yet has a 0-byte image.  Set by populateResultMetadata.
	ResultRetbufBytes int

	// ResultReg64Scalar: this func's single result is a bare 64-bit scalar
	// (int64/uint64/float64) that rides a register PAIR on a host whose word is
	// < 8 bytes.  ensureHandle picks TrampolineScalar64 (i64 return) over
	// TrampolineScalar so a native caller gets the full 64 bits.  Always false on
	// a 64-bit host and for multi/aggregate/one-word results.
	ResultReg64Scalar bool

	// ResultIfaceVtOffsets: byte offsets, within this func's SINGLE aggregate
	// result image, of every interface-value VTABLE WORD (recursing into a struct
	// / array result).  Empty for a non-single-result func, or a result carrying
	// no interface value.  When a native caller re-enters the VM through
	// TrampolineAggregate and the returned image holds a bytecode impl's VM-index
	// vtable word, native code would fault dereferencing it — so the trampoline
	// substitutes each of these words for the impl's native handle-vtable in the
	// retbuf COPY it hands back (the RETURN direction).
	// Computed at lower time from the result type (ifaceVtOffsetsFor), so it is a
	// static-type fact, never a runtime scan.
	ResultIfaceVtOffsets @[]int

	// ArgIfaceLayouts: per-call-site argument interface-vtable layouts for the
	// cross-mode calls in THIS function's body — the ARGUMENT-direction analog of
	// ResultIfaceVtOffsets (which is a per-callee-function result fact), here a
	// per-caller-call-site fact because the arg types belong to the call, not a
	// callee record (a func-value / iface-method callee is a native pointer with
	// no VMFunc to hang it on).  A call instruction that passes an interface value
	// (top-level OR nested in a by-value aggregate) carries a 1-based index into
	// this table in free Imm bits; 0 = no interface args.  The three cross-mode
	// dispatchers (dispatchExternBinding, dispatchCompiledFuncValue,
	// dispatchCompiledIfaceMethod) look the layout up here and substitute each
	// listed slot's VM-index vtable words for the impl's native handle-vtable in a
	// non-destructive copy (substArgSlotIface).  Built at lower time
	// (buildArgIfaceLayout); empty when the function makes no such call.
	ArgIfaceLayouts @[]@vmdata.ArgIfaceLayout

	// IsClosure / NumCaptureParams / CaptureOffsets back the B.2
	// capturing-literal path.
	// IsClosure=true marks the VMFunc as a capturing function
	// literal whose first NumCaptureParams params are captures
	// (prepended at IR-gen time).  CaptureOffsets is the byte
	// offset of each capture inside the closure struct laid out at
	// the construction site — the BC_CALL_FUNC_VALUE
	// DATA_KIND_COMPILED_CLOSURE branch uses these to copy capture
	// values from the struct into the callee's leading regs before
	// the user args.  Empty for non-closure VMFuncs.
	IsClosure        bool
	NumCaptureParams int
	CaptureOffsets   @[]int
	// CaptureByPtr indicates which captures are passed to the
	// wrapper as POINTERS into the closure struct (struct /
	// slice / interface / func-value types — anything the VM
	// passes by pointer per its calling convention) vs as
	// single-word values (scalars).  Indexed parallel to
	// CaptureOffsets.  Empty for non-closure VMFuncs.
	CaptureByPtr @[]bool
	// CaptureWide marks captures that are 64-bit scalars (int64 / uint64 /
	// float64) occupying a register PAIR on a host whose word is < 8 bytes.
	// The capture-read dispatcher reads two words for these and advances the
	// callee-reg cursor by 2 slots (a scalar capture is NOT always one word,
	// contrary to CaptureByPtr's "single-word values" note — that holds only
	// on LP64).  Always all-false on a 64-bit host.  Indexed parallel to
	// CaptureOffsets; empty for non-closure VMFuncs.
	CaptureWide @[]bool
	// ClosureStructDtorName is the (qualified) name of this capturing
	// closure's struct destructor, or empty when the closure struct has
	// no managed fields.  BC_REFDEC_INLINE_FAST resolves it via
	// LookupFunc and runs it on the heap closure struct when the @func
	// value's COMPILED_CLOSURE record is freed, so the captured managed
	// values (and the struct) are released rather than leaked.  Empty
	// for non-closure VMFuncs.
	ClosureStructDtorName @[]char
	// FaultTable maps recoverable-fault PCs to cleanup-pad PCs as inline
	// (opPC, padPC) pairs sorted by opPC (binary-searched at fault time).  Built
	// by VM lowering from each faulting/call op's ir.Instr.PadBlock.  Empty for
	// functions with no fault sites.
	FaultTable @[]int
}

// ============================================================
// VM state
// ============================================================

type VM struct {
	Funcs @vec.Vec[@VMFunc] // function table
	Stack *uint8 // raw base for SP-relative arithmetic — a non-owning view into stackBuf
	// stackBuf OWNS the execution-stack backing.  It is a managed @[]uint8 so
	// @VM's generated destructor frees it when the last VM reference drops —
	// without it the stack (a raw rt.RawAlloc) leaked on every VM teardown, and
	// since embedding a VM is a core feature (an app spins VMs up and down), that
	// leaked unboundedly on host as well as exhausting the bare-metal arena.  The
	// stack is pure internal scratch (nothing outside the VM points into it), so
	// refcount-driven release is safe.  Stack is &stackBuf[0].
	stackBuf  @[]uint8
	StackSize int // total stack size
	// StackRedZone is stack (bytes) reserved above a NORMAL user call's reach so a
	// recoverable stack-overflow fault (Plan 2) has room to UNWIND: a normal
	// pushFrame overflows once SP+frame would pass StackSize-StackRedZone, but a
	// cleanup push (CleanupDepth > 0 — a destructor frame the unwind's RefDec cascade
	// spawns) gets the full StackSize.  Because popping frees space as the unwind
	// proceeds, the red zone only has to cover the faulting frame's deepest single
	// dtor cascade; a cascade deeper than that exhausts even the full stack and stays
	// fatal via the §6 cleanup-context guard.  Defaults to StackSize/16 in NewVM; an
	// embedder may raise/lower it before running to fit its workload.
	StackRedZone int
	SP           int // current stack pointer
	Globals      *uint8 // global variable area
	GlobalsSize  int // globals area size
	Strings      @[]@[]char // string constants (proper managed-slices)
	// Opt selects the IR optimization passes applied to each module at
	// LowerModule time via iropt.RunOptConfig, before bytecode lowering — so the
	// interpreter shares the compiled backends' IR-opt passes.  NewVM sets it
	// to iropt.VMOptConfig(); a host may change it (e.g. Interp.SetOptConfig
	// from cmd/bni's -f<pass> / -fno-<pass> flags) before the program loads.
	Opt iropt.OptConfig

	// Name → vm.Funcs idx hash.  Kept in sync by LowerModule /
	// LowerOneFunc.  Used by LookupFunc for O(1) callee resolution; also
	// enables eager CallCache fill at lowering time, which is the substrate
	// the Tier 4 shadow path needs (per-call-site resolution must be frozen
	// at lowering time so an old caller keeps its old callee even after a
	// same-named func gets shadowed).  A stdlib table.Table under the
	// zero-size VmNameHasher / VmNameEq policies (direct dispatch); nil until
	// the first funcIndexSet.  Its *[]readonly char keys borrow each name's
	// backing, kept alive by the append-only vm.Funcs (whose VMFunc.Name owns
	// it), so the borrow never dangles.
	FuncIndex @table.Table[*[]readonly char, int, vmdata.VmNameHasher, vmdata.VmNameEq]

	// Externs registry: name → {vtable, data} of a compiled-side
	// function value.  When BC_CALL fails to resolve a name in
	// vm.Funcs, execExtern checks this registry; if found, it
	// dispatches via the always-shim convention through
	// rt._call_shim_scalar — the same path bytecode-side function-
	// value calls take in dispatchCompiledFuncValue.  Registration
	// happens once at VM init via RegisterExtern; the legacy hand-
	// coded execExtern switch remains for residual cases (multi-
	// word returns, refcount-surgical multi-value externs).
	//
	// vm.Externs is an amortized-doubling backing: ExternsLen is the
	// logical count and the slice may be longer (trailing zero
	// bindings are never indexed — resolution goes through the
	// ExternIndex* hash below or a [0, ExternsLen) scan).  Injecting
	// the standard package set calls RegisterExtern once per function
	// of every package (hundreds), so a grow-by-one copy of every
	// prior binding plus a linear dup-scan made it O(N²) — invisible
	// at native speed but ~minutes under the double-VM unit lane.
	Externs    @[]vmdata.ExternBinding
	ExternsLen int // logical count; <= len(Externs)

	// TrampolinePackedCall caches the native TrampolinePacked entry that ensureHandle
	// writes into EVERY VM function value's vtable call_packed slot (slot 2) —
	// i.e. `bit_cast(*int, Externs[<TrampolinePacked binding>].VtableAddr)[1]` (the
	// Call slot of the compiler-built func value for `var tp = TrampolinePacked`).
	// The func-value fast path (execCallFuncValue) uses it as the thunk-IDENTITY
	// test to recognize a VM function value — its call_packed slot equals this —
	// WITHOUT peeking the untagged closure `data`, then pushes the callee's frame
	// directly instead of round-tripping through the native trampoline.  0 = not yet
	// computed; filled lazily by vmTrampolinePackedCall on first func-value dispatch.
	TrampolinePackedCall int

	// Extern name→index hash into vm.Externs — the Externs analog of
	// FuncIndex above (same table.Table + VmNameHasher / VmNameEq policies),
	// making both the dup-check and LookupExtern O(1) instead of O(N).  nil
	// until the first RegisterExtern; keys borrow each ExternBinding.Name,
	// owned by the append-only vm.Externs.
	ExternIndex @table.Table[*[]readonly char, int, vmdata.VmNameHasher, vmdata.VmNameEq]

	// IfaceVtables: per-(impl, interface) vtable records. Each
	// entry is a heap-allocated array of 1-based VM function
	// indices in the interface's method-declaration order. Set up
	// by LowerModule from m.Impls. BC_IFACE_VALUE references a
	// vtable by index into this slice (the index is encoded as
	// Aux on the bytecode instruction). BC_CALL_IFACE_METHOD reads
	// the vtable address from the iv slot and indexes into it at
	// the method slot to recover the VM function index.
	IfaceVtables @vec.Vec[@vmdata.IfaceVtable]

	// Interrupt seam (inert in v1).
	// Poll is the host's cooperative-interrupt delegate, consulted at
	// statement boundaries and loop back-edges (set via SetPoll).
	// PollEnabled gates the hot path: false ⇒ Poll is never consulted
	// (a single not-taken branch per poll point, zero allocation) — the
	// v1 default.  Status carries the most recent poll outcome up the
	// execLoop → execFunc → Call* chain; it is VM_STATUS_CONTINUE
	// throughout v1 (a nil/absent Poll never yields Suspend/Break).
	// ResumePC / ResumeFuncIdx / ResumeRegsOff spill a suspended frame's
	// resume point; unused until the suspend stage lands.
	Poll        @func(@VM) int
	PollEnabled bool
	// ShutdownDone guards the OPTIONAL @VM.Shutdown against a double run: once the
	// per-package `__vm_teardown_globals` functions have RefDec'd every managed
	// global's content, a second Shutdown must be a no-op (re-running would
	// double-RefDec → double-free).  Zero (false) from make(VM); set true by the
	// first Shutdown.
	ShutdownDone  bool
	Status        int
	ResumePC      int
	ResumeFuncIdx int
	ResumeRegsOff int
	// FaultMsg carries the message of the most recent RECOVERABLE user-code
	// fault (Plan 2): set alongside Status = VM_STATUS_FAULTED and read by the
	// host to report it.  Empty otherwise; cleared at the start of each host
	// Call* so a prior turn's fault does not linger.
	FaultMsg @[]char
	// FaultRaised is the transient "a guard just raised a recoverable fault; branch
	// to its cleanup pad NOW" signal, distinct from the terminal Status ==
	// VM_STATUS_FAULTED.  setFault sets it; the exec loop CONSUMES it (clears it) the
	// moment it dispatches to the faulting op's pad.  The split is load-bearing:
	// while a pad — and the destructor sub-frames it spawns — unwinds, Status stays
	// FAULTED but FaultRaised is clear, so a managed-memory op that merely runs
	// during unwind (a passing bounds check, a RefInc in a dtor) does NOT re-dispatch.
	// Cleared at each host Call* alongside Status.
	FaultRaised bool
	// CleanupDepth counts the cleanup contexts the VM is currently nested inside: a
	// live cleanup pad (fault unwind) and/or a destructor frame.  Incremented on pad
	// entry and dtor-frame push, decremented on pad exit (BC_UNWIND_RETURN) and
	// dtor-frame pop (BC_RETURN with freeOnPop).  While it is non-zero, setFault turns
	// a guard fault FATAL instead of recoverable (§6 dtor invariant): a fault raised
	// while a cleanup is half-done would abandon a partial RefDec cascade and corrupt
	// the managed heap, so it must abort rather than start a second unwind.  Dtors and
	// pads are guard-free except for the stack-overflow a deep dtor chain can hit, so
	// this only bites once stack-overflow is recoverable — and there it MUST stay
	// fatal.  Reset to 0 at each host Call* (a balanced turn always leaves it 0; the
	// reset is defensive).
	CleanupDepth int

	// IR-to-bytecode lowering state — per-VM (was package-global).
	// Holding it on the VM is what lets two VMs lower modules in one
	// process without clobbering each other's tables.
	//
	// Session-lifetime; accumulate across every LowerModule on this VM:
	globalNames     @vec.Vec[@[]char] // global-var names, parallel to globalAddrs
	globalAddrs     @vec.Vec[int] // heap address of each global
	vtableInjNames  @vec.Vec[@[]char] // injected native-only vtable names
	vtableInjAddrs  @vec.Vec[int] // each injected vtable's raw @__ivt address
	vtableInjShims  @vec.Vec[int] // each injected vtable's @__ivtshim address
	vtableInjSizes  @vec.Vec[int] // each injected vtable's slot count (extent bound)
	satEntryTypes   @vec.Vec[int] // injected satisfaction entries: &TypeInfo(T) per (T,J)
	satEntryIfaces  @vec.Vec[int] // parallel: &IfaceId(J) per (T,J)
	satEntryVtables @vec.Vec[int] // parallel: &__ivt.<T>__<J> sub-vtable per (T,J)
	dataSymNames    @vec.Vec[@[]char] // materialized data-global symbols (__typeinfo.<T>, …)
	dataSymAddrs    @vec.Vec[int] // parallel: runtime address of each materialized record
	// Data-symbol name→index hash into dataSymNames/dataSymAddrs — the
	// data-symbol analog of FuncIndex (vm.Funcs) / ExternIndex (vm.Externs),
	// making lookupDataSymAddr O(1) instead of a linear scan (see
	// datasym_index.bn).  nil until the first insert; keys borrow each
	// dataSymNames entry, which owns the backing (append-only vec).
	DataSymIndex @table.Table[*[]readonly char, int, vmdata.VmNameHasher, vmdata.VmNameEq]
	// ownedBlocks OWNS every heap block the VM allocates for its own static data
	// (global-var storage now; package descriptors / TypeInfos / native vtables as
	// those families convert).  Each block is a managed @[]uint8 whose backing carries
	// the refcount; the raw addresses the tables above hold are BORROWS into these
	// slices.  The generated @VM destructor RefDecs this vec → every block frees at
	// teardown, replacing the old never-freed rt.RawAlloc blocks.  Injected external
	// (binary-image) addresses are never added here — only what this VM allocated.
	ownedBlocks @vec.Vec[@[]uint8]
	// Per-module scratch; reset at each LowerModule / LowerOneFunc(Shadow):
	modulePkgName @[]char // pkg path used to qualify call targets
	moduleStrings @[]@[]char // materialized string headers for the module
	curStrings    @[]ir.StringConst // active module's string-constant slice
	// Per-function scratch; reset at the top of each lowerFunc:
	curNames @vec.Vec[@[]char] // name table being built for the current func
	// curArgIfaceLayouts accumulates the current func's per-call-site argument
	// interface-vtable layouts (buildArgIfaceLayout appends one per cross-mode
	// call with interface args); assigned to VMFunc.ArgIfaceLayouts at the end of
	// lowerFunc.  Parallel to curNames — a per-function-in-progress accumulator so
	// the 1-based index a call instruction carries stays per-function (small).
	curArgIfaceLayouts @vec.Vec[@vmdata.ArgIfaceLayout]
}

// ============================================================
// Public API
// ============================================================

// NewVM creates a new VM with the given stack size.
func NewVM(stackSize int) @VM

// VM execution status, threaded up the exec chain by the interrupt
// seam.  VM_STATUS_CONTINUE (0, the make-zero default) is the only
// value v1 ever produces; SUSPENDED / BROKE / FAULTED are reserved for
// the suspend / break / recoverable-fault stages.
const VM_STATUS_CONTINUE int = 0

const VM_STATUS_SUSPENDED int = 1

const VM_STATUS_BROKE int = 2

// VM_STATUS_FAULTED marks a RECOVERABLE user-code runtime fault (a bad
// interpreted program: bounds / divide-by-zero / negative-shift / nil-deref /
// stack-overflow / call-through-nil).  The host survives and reads FaultMsg;
// distinct from an internal-invariant abort (still a hard rt.Panic).  Live as of
// Inc 2b for a bounds fault in the ENTRY frame — the exec loop unwinds through the
// op's cleanup pad and returns here for the host to read.  A fault in a NESTED
// call still takes the legacy fatal path until call-site pads land (Inc 3).
const VM_STATUS_FAULTED int = 3

// Poll delegate return values — what a host's Poll asks the VM to do
// at a poll point.  Inert in v1 (no Poll is installed, so the delegate
// is never consulted).
const POLL_CONTINUE int = 0

const POLL_BREAK int = 1

const POLL_SUSPEND int = 2

// SetPoll installs the host's cooperative-interrupt delegate, consulted
// at statement boundaries and loop back-edges, and arms the poll
// fast-path gate.  Until a delegate is set (the v1 default) the seam is
// inert — the gate stays false and the delegate is never called.
// Reserved for the suspend / break stages; v1 never yields a
// non-Continue poll result.
func (vm @VM) SetPoll(poll @func(@VM) int)

// Resume continues a VM suspended by a prior poll (one whose Status is
// VM_STATUS_SUSPENDED).  No-op in v1: the poll seam is inert so a VM
// never suspends, hence there is nothing to resume.  Reserved so the
// host-facing API is stable before the suspend stage fills in the
// reload-from-Resume* path.
func (vm @VM) Resume() int

// TrampolineScalar is the cross-mode dispatch trampoline for VM-side
// function values with scalar return. Compiled code reaches it
// through vtable.call after constructing or receiving a VM-side
// function value. Reads the VMClosureRec from `data` (which carries
// both the VM handle and the vm_func_idx), packs the user args into
// argv, and calls execFunc on that VM. The fixed 7-arg shape is
// intentional.
// Not normally called directly; BC_FUNC_VALUE wires its address into
// vtable.call.
func TrampolineScalar(data *uint8, a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int) int

// TrampolineAggregate is the aggregate-return counterpart of
// TrampolineScalar — vtable.call slot for VM-side function values
// whose return type is multi-word (slice / managed-slice / multi-
// word struct).  Convention matches the aggregate-shim shape:
// caller allocates retbuf, trampoline dispatches into the bytecode
// VMFunc and memcpys ResultSizes[0] bytes from execFunc's returned
// address into retbuf.  See pkg/binate/vm/vm.bn for the body.
func TrampolineAggregate(retbuf *uint8, data *uint8, a0 int, a1 int, a2 int, a3 int, a4 int, a5 int,
		a6 int)

// LowerModule converts an IR module to bytecode functions and adds them to the VM.
func (vm @VM) LowerModule(m @ir.Module)

// SetModuleContext re-establishes the VM's per-module lowering context (the
// package name used to qualify bare same-module symbols, and the string table)
// from `m`.  The REPL calls it after a mid-session import so a following per-decl
// op (e.g. MaterializeOneGlobal) qualifies against the session module, not the
// last import-lowered package.
func (vm @VM) SetModuleContext(m @ir.Module)

// LowerOneFunc lowers a single IR function to a VMFunc and appends
// it to vm.Funcs.  REPL entry point.  Caller must have AddFunc'd f
// into m and previously called LowerModule(vm, m).
func (vm @VM) LowerOneFunc(m @ir.Module, f @ir.Func) @VMFunc

// LowerOneFuncShadow lowers a single IR function to a VMFunc and
// always APPENDS to vm.Funcs (never replaces).  REPL entry point
// for Tier 4 shadow path: incompatible-signature redefinition
// keeps the OLD VMFunc reachable at its existing idx for any
// caller whose CallCache already resolved that callee.  The
// funcIndex is re-pointed to the new idx so fresh lowerings
// resolve to the new VMFunc.
func (vm @VM) LowerOneFuncShadow(m @ir.Module, f @ir.Func) @VMFunc

// MaterializeOneGlobal allocates storage for a single newly-declared
// global and appends it to the VM's per-name global tables.  REPL
// entry point for `var` decls typed at the prompt.  Storage is
// zero-initialized; like the file-load path, declared initializers
// are not applied (the user can assign in a follow-up prompt entry).
func (vm @VM) MaterializeOneGlobal(g @ir.Global)

// CallFunc calls a function by name with the given arguments.
func (vm @VM) CallFunc(name *[]readonly char, args @[]int) int

// CallByVMFunc executes a VMFunc directly, skipping LookupFunc.
// REPL entry point: invokes the synthetic __repl_n func returned by
// LowerOneFunc without a name lookup.
func (vm @VM) CallByVMFunc(vmf @VMFunc, args @[]int) int

// CallFuncAggregate calls a function by name and copies its aggregate /
// multi-return result (retbufSize bytes = types.AggregateReturnSize of the
// results) into the caller-provided retbuf, so a host can unpack aggregate and
// multi-return results (CallFunc returns only one word and truncates an
// aggregate/tuple address).  A scalar/void return (retbufSize 0) leaves retbuf
// untouched and the returned word is the value.  On a recoverable fault the
// retbuf is untouched; inspect vm.Status / vm.FaultMsg.
func (vm @VM) CallFuncAggregate(name *[]readonly char, args @[]int, retbuf *uint8,
		retbufSize int) int

// CallIfaceMethod invokes interface-method `slot` (absolute vtable slot) on the
// interface value whose 2-word image is at `ivAddr`, host-driven.  The receiver is
// prepended to `args` (at most 6 user args); a scalar/scalar64 result is the
// returned word, an aggregate is written into `retbuf` (retbufSize =
// types.AggregateReturnSize of the method's results).  A nil interface value raises
// a recoverable fault (inspect vm.Status / vm.FaultMsg).  Interface-typed method
// args are unsupported.  Requires a substituted (native) vtable word (SI-4).
func (vm @VM) CallIfaceMethod(ivAddr int, slot int, retbufSize int, scalar64 bool, args @[]int,
		retbuf *uint8) int

// Shutdown runs each lowered package's `__vm_teardown_globals`, RefDec'ing the
// independently-allocated CONTENT of every managed global (a `@T` pointee, or
// the managed values inside a struct/array global).  OPTIONAL and opt-in: an
// embedder spinning VMs up and down calls it before dropping a VM so managed-
// global content does not accumulate across lifecycles; a one-VM process need
// not (the OS reclaims at exit).  Idempotent — a second call is a no-op.
func (vm @VM) Shutdown()

// LookupFunc returns the index of a function by name, or -1.
func (vm @VM) LookupFunc(name *[]readonly char) int

// RegisterExtern binds a name to a compiled-side function value.
// fvAddr must point at a 16-byte {vtable, data} struct (a Phase-1
// non-capturing function value, typically obtained via
// `var fv *func(...) ... = someFunc; bit_cast(*uint8, &fv)`).
// The 16 bytes are copied into the binding so the user's source
// fv may go out of scope after registration.  Re-registering an
// existing name overwrites it.
//
// retbufSize is the aggregate RETBUF size (types.AggregateReturnSize:
// 0 for a scalar/pointer/void return, else the rounded retbuf byte
// count) and tells dispatchExternBinding which shim convention to use:
// 0 -> rt._call_shim_scalar; > 0 -> rt._call_shim_aggregate with a
// retbuf of retbufSize bytes on vm.Stack.  Pass 0 for ANY scalar return
// — a nonzero scalar size would wrongly dispatch as aggregate.
//
// At BC_CALL time, when LookupFunc returns no VM function, the
// registry is consulted.  Hits dispatch through the appropriate
// shim convention (scalar via rt._call_shim_scalar, aggregate via
// rt._call_shim_aggregate) — same path as dispatchCompiledFuncValue.
func (vm @VM) RegisterExtern(name *[]readonly char, fvAddr *uint8, retbufSize int, rawFnAddr int)

// LookupExtern returns the index of a registered extern by name,
// or -1.  Diagnostic / wired into execExtern's dispatcher.  O(1) via
// the extern name→index hash.
func (vm @VM) LookupExtern(name *[]readonly char) int

// ExternCount returns the number of registered externs (the logical
// length of vm.Externs, which may have a longer amortized backing).
func (vm @VM) ExternCount() int

// RegisterVmTrampolines binds the VM's own cross-mode dispatch
// trampolines (TrampolineScalar / TrampolineAggregate) into vm's extern
// registry.  These are required for cross-mode dispatch by any host, so a
// host registering its packages calls this alongside RegisterPackage*.
// See pkg/binate/vm/extern_register.bn for why they stay hand-bound by
// name (not auto-enumerated) and the native-vs-bytecode call-slot detail.
func RegisterVmTrampolines(vmInst @VM)

// RegisterPackageFunctions auto-enumerates a compiled package's exported
// functions from its `__Package().Functions` table and binds each into the
// VM's extern registry — the package-level injection primitive.  A host
// that links a native package P (e.g. a __c_call stdlib package the VM
// can't interpret) injects it by calling
// `vm.RegisterPackageFunctions(vmInst, P.__Package())`, then skipping P
// when lowering the program's bytecode so P's calls resolve to the
// injected native externs.  Extern (pure-C) entries are excluded from the
// table, so a package whose surface is extern needs those hand-bound.
func RegisterPackageFunctions(vmInst @VM, p @reflect.Package)

// RegisterPackageGlobals auto-enumerates a compiled package's exported globals
// from its `__Package().Globals` table and binds each global's native storage
// address into the VM's global table, so a bytecode cross-package read of one
// (e.g. a sentinel `errors.NotFound`) resolves to the SINGLE native instance —
// the pointer identity `errors.Is` matches on.  The package-level companion to
// RegisterPackageFunctions: a host injecting a native-only package P calls both
// `vm.RegisterPackageFunctions(vmInst, P.__Package())` and
// `vm.RegisterPackageGlobals(vmInst, P.__Package())`.
func RegisterPackageGlobals(vmInst @VM, p @reflect.Package)

// RegisterPackageVtables registers a native-only injected package's
// interface-impl vtables from its `__Package().Vtables` table, binding each
// vtable's bare mangled name to its native `@__ivt` address, so a bytecode-built
// interface value over the package's struct resolves the vtable instead of
// fatally missing the un-lowered vm.IfaceVtables (conformance 726).  The
// package-level companion to RegisterPackageFunctions / RegisterPackageGlobals:
// a host injecting a native-only package P calls all three with `P.__Package()`.
func RegisterPackageVtables(vmInst @VM, p @reflect.Package)

// RegisterPackageSatEntries records a native-only injected package's
// interface-satisfaction facts from its `__Package().SatEntries` table, binding
// each `(TypeInfo(T), IfaceId(J)) -> __ivt.<T>__<J>` triple into the VM's
// per-instance satisfaction registry, so the Phase-5 assertion reader can resolve
// a scrutinee's dynamic type without re-deriving it.  The package-level companion
// to RegisterPackageFunctions / RegisterPackageGlobals / RegisterPackageVtables: a
// host injecting a native-only package P calls all four with `P.__Package()`.
// Inert until the Phase-5 reader consults the registry.
func RegisterPackageSatEntries(vmInst @VM, p @reflect.Package)

// GlobalCount returns the number of entries in the per-VM global registry.
// RegisterPackageGlobals grows it at injection; materializeGlobals /
// MaterializeOneGlobal also add a lowered program's / a REPL line's globals — so
// the count is injected-only just after New (before any LoadProgram), where a
// host uses it to verify an inject-set's globals were bound (the FUNCTION count
// `ExternCount()` is blind to this registry).
func (vm @VM) GlobalCount() int

// InjectedVtableCount returns the number of native-injected interface-impl
// vtable bindings RegisterPackageVtables has grown.  Introspection parallel to
// GlobalCount (and distinct from IfaceVtables, the VM-LOWERED vtables) for a
// host verifying that an inject-set's impl vtables were bound.
func (vm @VM) InjectedVtableCount() int

// RegisterPackageRttiSyms binds ONLY a package's native RTTI identity data symbols
// -- its `__typeinfo.<T>` (SatEntries TypeSym/Type) AND its `__ifaceid.<J>`
// (IfaceSym/Iface) -- into the VM data-symbol table.  The minimal registration that
// lets a package stay LOWERED yet have its cross-mode assertions resolve by the same
// native addresses native code uses: the typeinfo makes a boxed value carry the
// native TypeInfo (native g_satTable HIT), and the ifaceid makes the VM-registry
// FALLBACK (satFallbackFn) key its iface on the native `&IfaceId(J)` so a user type
// implementing the package's interface resolves too.  For pkg/builtins/lang, which
// cannot be injected native-only but whose typeinfos + ifaceids must be native for
// cross-mode `x.(*lang.Stringer)`.  Registers NO satentries or vtables (those would
// duplicate the lowered package's own VM-side registrations).
func RegisterPackageRttiSyms(vmInst @VM, p @reflect.Package)
