// Package vm implements a bytecode interpreter that executes IR-derived
// bytecode. Refcounting correctness is inherited from the compiler's IR gen.
package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/builtins/reflect"

// ============================================================
// Bytecode opcodes
// ============================================================

const (
	BC_NOP int = iota

	// Constants
	BC_LOAD_IMM        // Dst = Imm
	BC_LOAD_STR        // Dst = ptr to string constant (as managed-slice)
	BC_STRING_COPY_MS  // Dst = fresh @[]char managed-slice copy of string Imm
	BC_STRING_COPY_ARR // Dst = ptr to fresh stack buffer of size Aux,
	//  zero-padded, with string Imm bytes copied in

	// Arithmetic
	BC_ADD  // Dst = Src1 + Src2
	BC_SUB  // Dst = Src1 - Src2
	BC_MUL  // Dst = Src1 * Src2
	BC_DIV  // Dst = Src1 / Src2 (signed)
	BC_UDIV // Dst = Src1 / Src2 (unsigned)
	BC_REM  // Dst = Src1 % Src2 (signed)
	BC_UREM // Dst = Src1 % Src2 (unsigned)

	// Floating-point arithmetic (float64; operands bit-cast through
	// int registers). float32 is narrowed/widened at memory boundaries
	// so arithmetic is always done at float64 precision.
	BC_FADD // Dst = bit_cast(float64, Src1) + bit_cast(float64, Src2)
	BC_FSUB // Dst = ...
	BC_FMUL // Dst = ...
	BC_FDIV // Dst = ...

	// Bitwise
	BC_AND  // Dst = Src1 & Src2
	BC_OR   // Dst = Src1 | Src2
	BC_XOR  // Dst = Src1 ^ Src2
	BC_SHL  // Dst = Src1 << Src2
	BC_SHR  // Dst = Src1 >> Src2 (arithmetic)
	BC_LSHR // Dst = Src1 >> Src2 (logical)

	// Comparison (result is 0 or 1)
	BC_EQ  // Dst = Src1 == Src2
	BC_NE  // Dst = Src1 != Src2
	BC_SLT // Dst = Src1 < Src2 (signed)
	BC_SLE // Dst = Src1 <= Src2 (signed)
	BC_SGT // Dst = Src1 > Src2 (signed)
	BC_SGE // Dst = Src1 >= Src2 (signed)
	BC_ULT // Dst = Src1 < Src2 (unsigned)
	BC_ULE // Dst = Src1 <= Src2 (unsigned)
	BC_UGT // Dst = Src1 > Src2 (unsigned)
	BC_UGE // Dst = Src1 >= Src2 (unsigned)

	// Floating-point comparison (float64; ordered predicates — NaN → 0)
	BC_FEQ // Dst = bit_cast(float64, Src1) == bit_cast(float64, Src2)
	BC_FNE // Dst = ...
	BC_FLT // Dst = ...
	BC_FLE // Dst = ...
	BC_FGT // Dst = ...
	BC_FGE // Dst = ...

	// Unary
	BC_NEG    // Dst = -Src1
	BC_NOT    // Dst = !Src1 (logical)
	BC_BITNOT // Dst = ~Src1
	BC_FNEG   // Dst = bit-cast of -bit_cast(float64, Src1)

	// Memory
	BC_STACK_ALLOC // Dst = FrameBase + Imm (stack offset)
	BC_LOAD8       // Dst = *(uint8*)Src1 (zero-extended)
	BC_LOAD64      // Dst = *(int64*)Src1
	BC_STORE8      // *(uint8*)Src1 = (uint8)Src2
	BC_STORE64     // *(int64*)Src1 = Src2
	BC_MEMCPY      // memcpy(Src1, Src2, Imm)
	BC_MEMSET      // memset(Src1, 0, Imm)
	BC_FIELD_PTR   // Dst = Src1 + Imm (field byte offset)
	BC_ELEM_PTR    // Dst = Src1 + Src2 * Imm (element byte offset)

	// Control flow
	BC_JUMP   // PC = Aux
	BC_BRANCH // if Src1 != 0: PC = Imm; else: PC = Aux
	BC_CALL   // Dst = call result. Aux = NAME-TABLE index into
	//   f.Names / f.CallCache (NOT a func index) — the callee
	//   is resolved by name at first execution and cached.
	//   Src1 = callArgBase; args in [Src1, Src1+Imm-1]. Imm =
	//   packed slot count (a 64-bit arg = 2 slots when
	//   REG_SLOT < 8). A negative cached resolution routes to
	//   execExtern (vm.Externs) — the only extern path
	//   (BC_CALL_EXTERN is dead).
	BC_CALL_EXTERN // DEAD: never emitted, no execLoop arm. Extern calls go
	//   through BC_CALL (negative CallCache → execExtern,
	//   vm.Externs). Reserved enum slot — do not add a
	//   handler without an emitter.
	BC_CALL_INDIRECT // Dst = call (fnIdx - 1)(args...). Src1 = reg
	//   holding 1-based VM function index, Src2 =
	//   callArgBase, Imm = arg count. fn_ptr in
	//   indirect-call IR maps to a VM function index.
	BC_RETURN // ends the function; delivered values were already
	//   ownership-transferred by IR-gen (backends add/elide
	//   no refcount). Dst is a SHAPE CODE:
	//     -1  : void.
	//      0  : single return, Src1 = value reg. Aux = byte
	//           count to copy back when the value lives in the
	//           callee frame (multi-word aggregate OR 16-byte
	//           address-aggregate — iface value, and per
	//           contract func value); 0 = none.
	//     N>0 : multi-return; Dst = result count, Src1 =
	//           callArgBase, Imm = result count →
	//           packMultiReturn writes each result at
	//           ResultOffsets[i] and copies the struct back.
	BC_RETURN64 // return the (Src1, Src1+1) pair — int64/uint64/
	// float64 single-return on a host whose word
	// is < 8 bytes (Layer 2 step 2b).
	BC_MOV // Dst = Src1 (register copy, from phi resolution)

	// 64-bit (register-pair) ops — emitted only when REG_SLOT < 8 (a
	// host whose word can't hold a 64-bit value in one slot).  A
	// 64-bit operand/dest is a register pair: base slot = low 32
	// bits, base+1 = high 32 bits.  Handled by execOp64; the bit-math
	// uses splitInt64 / joinInt64.  See
	// explorations/plan-vm-64bit-on-32bit.md (Layer 2 step 3).
	BC_LOAD_IMM64 // (Dst, Dst+1) = (Imm:low, Aux:high)
	BC_MOV64      // (Dst, Dst+1) = (Src1, Src1+1); int64↔float64 bitcast
	// Casts between a single slot and a pair.  Widens read a single
	// slot; narrows write a single slot.
	BC_WIDEN64_S // Dst-pair = sign-extend(regs[Src1])
	BC_WIDEN64_U // Dst-pair = zero-extend(regs[Src1])
	BC_NARROW64  // regs[Dst] = Src1-pair's low slot
	// Unary 64-bit ops.
	BC_NEG64    // Dst-pair = -(Src1-pair)
	BC_BITNOT64 // Dst-pair = Src1-pair ^ -1
	// Pair memory ops: load/store 8 bytes (two 32-bit words) at the
	// host address in regs[Src1].  The existing BC_LOAD64/STORE64 use
	// *int indexing, which is one VM word — only 4 bytes on a 32-bit
	// host — so they cannot move a 64-bit value across memory there.
	// These variants index through *uint32 (always 4 bytes per
	// element) so they portably read/write 8 bytes as (lo, hi).
	BC_LOAD64_PAIR  // (Dst, Dst+1) = read 8 bytes at regs[Src1]
	BC_STORE64_PAIR // write (Src2, Src2+1) pair as 8 bytes at regs[Src1]
	BC_ADD64        // Dst-pair = Src1-pair + Src2-pair
	BC_SUB64        // Dst-pair = Src1-pair - Src2-pair
	BC_MUL64        // Dst-pair = Src1-pair * Src2-pair
	BC_DIV64        // signed
	BC_UDIV64       // unsigned
	BC_REM64        // signed
	BC_UREM64       // unsigned
	BC_AND64
	BC_OR64
	BC_XOR64
	// Shifts: Src1 is a pair (the value); Src2 is read as a single
	// slot (the count's low word — counts are small).
	BC_SHL64
	BC_SHR64  // arithmetic (signed)
	BC_LSHR64 // logical (unsigned)
	// Compares read two pairs and write a 0/1 bool to Dst (one slot).
	BC_EQ64
	BC_NE64
	BC_SLT64
	BC_SLE64
	BC_SGT64
	BC_SGE64
	BC_ULT64
	BC_ULE64
	BC_UGT64
	BC_UGE64
	// Float64 register-pair ops: same pair pattern as the integer
	// BC_*64 family, but the joined int64 bits ride through float64
	// for the compute.  Unary, arithmetic, and ordered compares
	// (Dst is a single bool slot for the compares, a pair for the
	// rest).  Emitted only when REG_SLOT < 8 — on a 64-bit host,
	// float64 fits one slot and the existing BC_F* ops handle it.
	BC_FNEG64
	BC_FADD64
	BC_FSUB64
	BC_FMUL64
	BC_FDIV64
	BC_FEQ64
	BC_FNE64
	BC_FLT64
	BC_FLE64
	BC_FGT64
	BC_FGE64

	// Managed memory
	BC_REFINC_INLINE // inline RefInc(Src1): nil-check + load/add/store
	// on the header at Src1-16. Lowered from OP_REFINC.
	BC_REFDEC_INLINE_FAST // the core managed-refcount RELEASE op. Src1 =
	//   managed ptr (header at Src1-16); nil-check, then
	//   decrement inline; hd[0] < 0 is the immortal static
	//   sentinel and skips. Src2 = a func-value HANDLE ptr
	//   (NOT a dtor func index). On reaching zero, one of
	//   FOUR dtor paths:
	//     Src2 == 0 : rt.Free (no dtor).
	//     Src2 == compiledClosureDtorMark (-1) : Src1 is a
	//        COMPILED_CLOSURE rec — free it, then RefDec + run
	//        the dtor on the heap closure struct it points at.
	//     handle.data is a VM_CLOSURE_REC : iterative dtor-
	//        frame push (no host recursion); freed on pop.
	//     else : refDecCrossModeDispatch via the handle's
	//        vtable.call shim, then rt.Free.
	//   Lowered from OP_REFDEC.
	BC_ALLOC        // Dst = rt.Alloc(Imm)
	BC_BOX          // Dst = rt.Box(Src1, Imm=size)
	BC_MAKE_SLICE   // Dst = rt.MakeManagedSlice(Imm=elemSize, Src1=length)
	BC_NIL_CHECK    // panic if Src1 == 0
	BC_BOUNDS_CHECK // panic if Src1 < 0 || Src1 >= Src2
	BC_DIV_CHECK    // panic if integer divide would fault: Src1 =
	//   dividend, Src2 = divisor (both 64-bit), Imm =
	//   operand bit width, Aux = isSigned (0/1).
	//   signedMin is recovered from Imm. Lowered from
	//   OP_DIV_CHECK; calls rt.DivCheck.
	BC_SHIFT_CHECK // panic if Src1 (the 64-bit sign-extended shift
	//   count) is negative. Lowered from OP_SHIFT_CHECK;
	//   calls rt.ShiftCheck.
	BC_FUNC_HANDLE // Dst = *uint8 pointing at a 16-byte
	//   {vtable_ptr, data_ptr} handle.  Sourced
	//   from the executing vm's Externs registry
	//   (binding.HandleAddr — a managed copy of
	//   the registrant's handle) when the function
	//   is registered, or lazily heap-allocated on
	//   the VMFunc's Handle field for vm-local-only
	//   functions.  See plan-uniform-native-fnptrs.md
	//   Phase 4.
	BC_FUNC_VALUE // Dst = stack addr of a fresh 16-byte fv
	//   {vtable_addr @ slot0, data_addr @ slot1} —
	//   vtable-FIRST, opposite of iface. Aux = name index in
	//   VMFunc.Names; Src1 = closure-struct reg (capturing)
	//   or -1 (non-capturing). Vtable/ClosureRec lazily built
	//   by ensureHandle on first use.
	//   Non-capturing (Src1==-1): data = the shared per-callee
	//     ClosureRec, RefInc'd here so this fv owns a ref —
	//     without it the shared rec frees on the first copy's
	//     RefDec, dangling survivors.
	//   Capturing (Src1!=-1): data = a fresh heap
	//     COMPILED_CLOSURE rec; released for @func via the
	//     compiledClosureDtorMark arm of BC_REFDEC_INLINE_FAST
	//     (raw *func intentionally leaks, B.2).
	//   See plan-function-values.md "VM-mode vtables".
	BC_CALL_FUNC_VALUE // Dst = call f(args). Src1 = register holding
	//   the function value's stack address (16-byte
	//   {vtable_addr, closure_rec_addr}). Src2 =
	//   callArgBase. Imm = arg count. Within-VM
	//   dispatch short-circuits the trampoline:
	//   reads closure_rec[0] (vm_func_idx) directly
	//   and execFuncs into the VM. See plan-function-
	//   values.md "VM-mode vtables — Phase 1".
	BC_IFACE_VALUE // Dst = stack addr of a fresh 16-byte iv
	//   {data_ptr @ slot0, vtIdx+1 @ slot1}. Src1 = data ptr
	//   reg (source's *T / @T cast through int); Aux = name
	//   index of the mangled vtable id ("__ivt.<...>").
	//   slot1 holds a 1-BASED INDEX into vm.IfaceVtables
	//   (0 = nil-interface sentinel), NOT a vtable address.
	//   Vtables are pre-built by LowerModule
	//   (lowerImplVtables); the handler resolves the name to
	//   an index via findIfaceVtable. Slice 2.3c of
	//   plan-interface-syntax-revision.md.
	BC_IFACE_VALUE_DYN // Dst = stack addr of a fresh 16-byte iv
	//   {data @ slot0, vtable_word @ slot1} built from runtime
	//   registers: Src1 = data ptr reg, Src2 = vtable-WORD reg.
	//   The dynamic-vtable OP_IFACE_VALUE form — the recovered
	//   value of an interface-target assertion x.(*J), whose
	//   vtable word is the SatLookup sub-vtable (a 1-based
	//   vm.IfaceVtables index for a VM-lowered (T,J), or a native
	//   @__ivt address for an injected package; ifaceVtIsNative
	//   discriminates at dispatch).  Unlike BC_IFACE_VALUE it
	//   resolves no name — the word is already in a register.
	//   RTTI Slice 5b-2.
	BC_CALL_IFACE_METHOD // Dst = result of iv.method(args). Src1 =
	//   register holding the interface value's
	//   stack address. Src2 = callArgBase. Imm =
	//   arg count. Aux = the ABSOLUTE concat-vtable slot
	//   (slots 0-1 = any-block: dtor, *TypeInfo;
	//   first method = slot 2).
	//   Reads (data_ptr, vtable_addr) from the iv
	//   slot, indexes into the vtable, and calls
	//   the impl method via execFunc with data_ptr
	//   prepended to the user args.
	BC_IFACE_DTOR // Dst = the receiver type's dtor as a func-value
	//   HANDLE ptr (bit_cast(int, handle)), or 0 if no dtor /
	//   nil iv. Src1 = reg holding the iv stack-slot addr;
	//   the handler reads iv[1] (1-based vtable index, 0=nil),
	//   looks up vt.Methods[0] (the dtor's 1-based VM func
	//   idx), then ensureHandle-builds its handle. Dst feeds
	//   BC_REFDEC_INLINE_FAST's Src2 slot, which derefs it as
	//   a HANDLE (a raw index would bit_cast to a ptr and
	//   crash). @Iface scope-exit cleanup. Slice 2.5b of
	//   plan-interface-syntax-revision.md.
	BC_FUNC_VALUE_DTOR // Dst = vtable.Dtor of an @func value (0 if
	//   the value has no dtor / nil fv / nil
	//   vtable). Src1 = register holding the
	//   fv's stack address; the handler reads
	//   fv[0] as vtable_addr, then vtable[0] as
	//   Dtor. Used by @func scope-exit cleanup
	//   — the int feeds straight into
	//   BC_REFDEC_INLINE_FAST's Src2 dtor slot.
	//   Mirror of BC_IFACE_DTOR; the only
	//   layout difference is which slot of the
	//   2-word value carries the vtable (fv[0]
	//   vs iv[1]).
	BC_IFACE_UPCAST // Dst = stack address of a fresh iv with
	//   the same data ptr as Src1's iv and a
	//   vtable swapped to the target interface's
	//   (R, target) vtable.  Src1 = register
	//   holding the source iv's stack address.
	//   Aux = name index for the combined
	//   `<src_iface_pkg>__<src_iface_name>|<tgt_iface_pkg>__<tgt_iface_name>`
	//   suffixes.  Handler reads the source
	//   vtable's mangled name, swaps the iface
	//   suffix to the target's, looks the result
	//   up in vm.IfaceVtables.  Slice E.4 part
	//   2b of plan-interface-embedding.md.
	BC_IFACE_TYPEINFO // Dst = the iv's dynamic *TypeInfo address (as
	//   int), read from vtable any-block slot 1.  Src1 = reg
	//   holding the iv's stack-slot addr; the handler reads
	//   iv[1] (the 1-based vtable index, 0=nil) and, for a
	//   VM-built iv, resolves through vm.IfaceVtables[idx-1].
	//   Methods[1] (the materialized __typeinfo.<R> address).
	//   Mirror of BC_IFACE_DTOR at slot 1.  A native-INJECTED iv
	//   (ifaceVtIsNative) loud-fails: its native __typeinfo
	//   address would not match the VM's own materialized record,
	//   so the cross-mode mapping is deferred to RTTI Slice 5b-2.
	//   Feeds a concrete type assertion's identity compare /
	//   dynamic-name read.  RTTI Slice 5b of
	//   plan-type-assertions-execution.md.
	BC_DATA_SYM_ADDR // Dst = the runtime address of a LOCAL Binate data
	//   global named by Aux (name-table index of the mangled
	//   symbol, e.g. "__typeinfo.<T>"), resolved against the
	//   VM's materialized data-symbol table (lookupDataSymAddr;
	//   lower_typeinfo.bn), or 0 if the symbol was not
	//   materialized.  The VM analog of the native backends'
	//   OP_DATA_SYM_ADDR (a linker-resolved symbol address);
	//   materializes &__typeinfo.<T> / &__ifaceid.<J> for an
	//   assertion's static identity operands.  RTTI Slice 5b.
	BC_SAT_LOOKUP // Dst = the sub-vtable WORD for the interface-satisfaction
	//   query (Src1 = *TypeInfo reg, Src2 = &__ifaceid.<J> reg) via
	//   lookupSatEntry over the VM's @VM satentry registry, or 0
	//   (MISS).  The VM's lowering of OP_SAT_LOOKUP — the native
	//   backends instead call rt.SatLookup, but the VM's bytecode
	//   rt.SatLookup would MISS (the native itab-hash is never built
	//   in the VM).  The word is a 1-based vm.IfaceVtables index for
	//   a VM-lowered (T,J) or a native @__ivt sub-vtable address for
	//   an injected package.  RTTI Slice 5b-2.

	// Conversions.  Integer narrowing + sub-word canonicalization all go
	// through BC_SEXT/BC_ZEXT: narrowToWidth masks to Imm bits then extends
	// per signedness, yielding the canonical register form (sign-extended for
	// a signed type, zero-extended for an unsigned one) that loads and arith
	// also produce.
	BC_SEXT    // Dst = sign-extend Src1 from low Imm bits
	BC_ZEXT    // Dst = zero-extend Src1 from low Imm bits
	BC_SITOF   // Dst = bit_cast(int, float64(cast(int, Src1)))  — signed source
	BC_UITOF   // Dst = bit_cast(int, float64(cast(uint64, Src1)))  — unsigned source
	BC_FTOSI   // Dst = int64 truncation of bit_cast(float64, Src1)  — signed dest
	BC_FTOUI   // Dst = uint64 truncation of bit_cast(float64, Src1)  — unsigned dest
	BC_F32TOSI // Dst = int64 trunc of float32 (low 4 bytes of Src1)  — signed dest
	BC_F32TOUI // Dst = uint64 trunc of float32 (low 4 bytes of Src1)  — unsigned dest
	BC_SITOF32 // Dst = float32 bits (low 4 bytes) of float32(int Src1)  — signed src
	BC_UITOF32 // Dst = float32 bits (low 4 bytes) of float32(uint64 Src1)  — unsigned src
	// Float-width conversions. VM registers carry IEEE bits in their
	// declared type's width — float32 in low 4 bytes (zero-extended),
	// float64 in 8 bytes — so a width change needs real conversion,
	// not a no-op move.
	BC_F64_TO_F32 // Dst = float32 IEEE bits (in low 4 bytes) of bit_cast(float64, Src1)
	BC_F32_TO_F64 // Dst = float64 bits of float32 in low 4 bytes of Src1

	// int64/uint64 <-> float conversion variants for a 32-bit host, where the
	// int64/uint64 operand occupies a register PAIR.  Lowering emits these (in
	// place of the single-slot BC_SITOF/BC_FTOSI/... above) only when the int
	// operand is 64-bit AND REG_SLOT < 8; their handlers ALWAYS pair the int64
	// side (join the source / split the dest), so they are exercisable by direct
	// unit tests on a 64-bit host — the execOp64 pair-opcode convention.  The
	// float64 operand rides its pair too (dst for ->float64, src for float64->);
	// a float32 operand stays a single slot (fits 4 bytes) on any host.
	BC_SI64TOF   // Dst-pair = float64 bits of float64(int64  Src1-pair)  — signed src
	BC_UI64TOF   // Dst-pair = float64 bits of float64(uint64 Src1-pair)  — unsigned src
	BC_SI64TOF32 // Dst = float32 bits of float32(int64  Src1-pair)  — signed src
	BC_UI64TOF32 // Dst = float32 bits of float32(uint64 Src1-pair)  — unsigned src
	BC_FTOSI64   // Dst-pair = int64  trunc of bit_cast(float64, Src1-pair)  — signed dst
	BC_FTOUI64   // Dst-pair = uint64 trunc of bit_cast(float64, Src1-pair)  — unsigned dst
	BC_F32TOSI64 // Dst-pair = int64  trunc of float32 (low 4 bytes of Src1)  — signed dst
	BC_F32TOUI64 // Dst-pair = uint64 trunc of float32 (low 4 bytes of Src1)  — unsigned dst

	// Struct
	BC_EXTRACT // Dst = field of the aggregate at Src1, by Aux mode:
	//   Aux=0: scalar load *(int*)(Src1 + Imm), Imm =
	//          FieldOffset (NOT *8) — dominant struct path.
	//   Aux=1: POINTER mode, Dst = Src1 + Imm (no load), for
	//          16-byte address-aggregate fields (iface/func)
	//          and multi-word fields (struct/slice/mslice/
	//          array): yields the field's slot ADDRESS so
	//          BOTH words survive. Matches packMultiReturn.
	//   Aux=2: legacy word-indexed load p[Imm] (non-struct
	//          sources, e.g. slice-header fields); Imm = idx.

	// Lifetime
	BC_SP_RESTORE // vm.SP = frameStart + frame.totalSize.
	//   No operands. Lowered from OP_SP_RESTORE.
	//   Reclaims vm.Stack temporaries pushed during
	//   the just-ended statement (aggregate return
	//   copy-backs, BC_MAKE_SLICE / BC_STRING_COPY*
	//   / BC_FUNC_VALUE pushes). IR-gen emits at
	//   end-of-statement only when the statement
	//   contains a vm.SP-growing op, so scalar-only
	//   statements pay no per-iteration cost.
	BC_LOAD_AGGREGATE // Dst = FrameBase + Imm (this load's OWN frame
	//   region, reserved by the planner), after
	//   memcpy(Dst, regs[Src1], Aux=byte size).  An
	//   aggregate OP_LOAD copies the source bytes into
	//   its own region instead of aliasing the source,
	//   so the loaded value can't dangle when later
	//   cleanup frees the source — e.g.
	//   `return container[i]`, whose element header
	//   lives in the local container's backing.
	//   Mirrors the LLVM/native aggregate load.

	// Float32 (single-precision) arithmetic. Operands carry their f32 IEEE
	// bits in the low 4 bytes; computed at single precision (not as a
	// float64 on the raw bits, which would be garbage) and the f32 result
	// bits stored back in the low 4 bytes.
	BC_F32ADD // Dst = bits(f32(Src1) + f32(Src2))
	BC_F32SUB // Dst = bits(f32(Src1) - f32(Src2))
	BC_F32MUL // Dst = bits(f32(Src1) * f32(Src2))
	BC_F32DIV // Dst = bits(f32(Src1) / f32(Src2))
	BC_F32NEG // Dst = Src1 ^ (1<<31) — flip the float32 sign bit

	// Float32 (single-precision) comparison.  Operands' f32 bits are in
	// the low 4 bytes; compared as float32, not as a float64 on the raw
	// bits (which would be garbage — e.g. a negative f32 reads as a large
	// positive double, flipping the order).
	BC_F32EQ // Dst = f32(Src1) == f32(Src2)
	BC_F32NE // Dst = f32(Src1) != f32(Src2)
	BC_F32LT // Dst = f32(Src1) < f32(Src2)
	BC_F32LE // Dst = f32(Src1) <= f32(Src2)
	BC_F32GT // Dst = f32(Src1) > f32(Src2)
	BC_F32GE // Dst = f32(Src1) >= f32(Src2)

	// BC_UNWIND_RETURN terminates a VM-only cleanup landing pad: pop the frame
	// (no return value) and continue the fault unwind in the caller.  Inert in
	// Inc 2a (nothing branches to pads yet — the exec arm traps).  See
	// plan-rt-fault-cleanup-pads.md (Plan 2).
	BC_UNWIND_RETURN

	BC_NUM_OPS
)

// ============================================================
// Bytecode instruction
// ============================================================

type BCInstr struct {
	Op   int // opcode
	Dst  int // destination register (-1 for void)
	Src1 int // first source register
	Src2 int // second source register
	Imm  int // immediate value
	Aux  int // auxiliary (jump target, func ID, name index, etc.)
}

// No managed fields in BCInstr — function/builtin names are stored
// in VMFunc.Names and referenced by index via Aux.

// ============================================================
// Compiled function
// ============================================================

// VMFuncVtable is the heap-allocated function-value vtable for a
// VMFunc taken as a function value.  Field layout matches the
// statically-emitted vtable bnc produces for compiled functions:
//   - Dtor: 0 for non-capturing; will hold a destructor func ptr
//     for capturing closures (Phase 2 of plan-function-values).
//   - Call: the per-function shim address (compiled native fn)
//     OR a universal trampoline address (TrampolineScalar /
//     TrampolineAggregate) when constructed by BC_FUNC_VALUE
//     Path B for a bytecode-only function.
// Heap-allocated and referenced from a VMFunc managed field so
// its lifetime ties to the VMFunc — no leak on VMFunc death.
type VMFuncVtable struct {
	Dtor int
	Call int
}

// VMFuncHandle is the heap-allocated {vtable_ptr, data_ptr} block
// returned by BC_FUNC_HANDLE for bytecode-only functions.  Layout
// matches the static `@__handle.F` symbol bnc emits for natively-
// compiled functions, so consumers (`_call_free_fn` / `_call_dtor`
// via OP_CALL_HANDLE) dispatch uniformly through both kinds.
// Heap-allocated and referenced from a VMFunc managed field so its
// lifetime ties to the VMFunc.
type VMFuncHandle struct {
	VtableAddr int
	DataAddr   int
}

// VMClosureRec is the heap-allocated closure record carried by a
// VMFunc-derived function value.  The universal trampolines
// (TrampolineScalar / TrampolineAggregate) read it as their
// `data` argument and dispatch via `execFunc(Vm, FnIdx-1, args)`.
//   - Kind: discriminates VM closure records from other
//     compiler-emitted closure data shapes; always set to
//     `rt.DATA_KIND_VM_CLOSURE_REC`.
//   - Vm:   `bit_cast(int, @VM)` — the VM to dispatch into.
//   - FnIdx: 1-based function index in `Vm.Funcs`.  0 reserved.
//   - Captured: captured-context pointer for closures (Phase 2);
//     0 in Phase 1.
// Heap-allocated and referenced from a VMFunc managed field so
// its lifetime ties to the VMFunc — no leak on VMFunc death.
type VMClosureRec struct {
	Kind     int
	Vm       int
	FnIdx    int
	Captured int
}

type VMFunc struct {
	Name  @[]char
	Code  @[]BCInstr // bytecode
	Names @[]@[]char // name table (for call/builtin targets)
	// Vtable / ClosureRec / Handle: lazily-allocated heap blocks
	// used when this function is taken as a function value.  All
	// nil until the first BC_FUNC_VALUE / BC_FUNC_HANDLE executes.
	// Managed so VMFunc's auto-emitted dtor refdecs them on death.
	// Handle is the {VtableAddr=&Vtable, DataAddr=&ClosureRec} pair
	// that BC_FUNC_HANDLE returns the address of for a vm-local
	// function — matches the static `@__handle.F` shape so dispatch
	// is uniform across natively-compiled and bytecode-only
	// functions.  Phase 4 of plan-uniform-native-fnptrs.md.
	Vtable     @VMFuncVtable
	ClosureRec @VMClosureRec
	Handle     @VMFuncHandle
	// CallCache: parallel to Names; per-call-site memoized result of
	// LookupFunc(vm, Names[i]).  -2 = unresolved (not yet looked up),
	// -1 = extern (not a VM function), >=0 = vm.Funcs index.  Filled
	// lazily on first execution of each call site.  A future REPL that
	// mutates vm.Funcs must invalidate this cache (full flush, or
	// targeted -1 reset on append; see notes-profiling-bni).
	CallCache @[]int
	Strings   @[]@[]char // string constants (per-module, shared across
	// all VMFuncs lowered from the same module)
	NumRegs   int // register slots needed
	FrameSize int // stack frame size (bytes)
	NumParams int // number of parameters
	// NumParamSlots is the number of register slots the parameters
	// occupy.  On a 64-bit host it equals NumParams (one slot per
	// param); on a host whose word is < 8 bytes, an int64/uint64/
	// float64 param occupies a register pair, so the slot count can
	// exceed the param count.  Set by lower_func from
	// argSlots(p.Typ).
	NumParamSlots int
	NumResults    int // number of results
	// For multi-return: per-result byte sizes and offsets
	// in the packed anonymous result struct, plus a parallel
	// "is this a multi-word value" flag. The flag matters even
	// when size is 8 (e.g. struct{int}), because for any
	// multi-word type lowerLoad returns the alloca *pointer*
	// (not the bytes), so packing must MEMCPY through that
	// pointer instead of treating it as a scalar word.
	ResultSizes     @[]int
	ResultOffsets   @[]int
	ResultMultiWord @[]bool

	// ResultReg64Scalar: this func's single result is a bare 64-bit scalar
	// (int64/uint64/float64) that rides a register PAIR on a host whose word is
	// < 8 bytes.  ensureHandle picks TrampolineScalar64 (i64 return) over
	// TrampolineScalar so a native caller gets the full 64 bits.  Always false on
	// a 64-bit host and for multi/aggregate/one-word results.
	ResultReg64Scalar bool

	// IsClosure / NumCaptureParams / CaptureOffsets back the B.2
	// capturing-literal path (plan-function-values-phase-2.md).
	// IsClosure=true marks the VMFunc as a capturing function
	// literal whose first NumCaptureParams params are captures
	// (prepended at IR-gen time).  CaptureOffsets is the byte
	// offset of each capture inside the closure struct laid out at
	// the construction site — the BC_CALL_FUNC_VALUE
	// DATA_KIND_COMPILED_CLOSURE branch uses these to copy capture
	// values from the struct into the callee's leading regs before
	// the user args.  Empty for non-closure VMFuncs.
	IsClosure        bool
	NumCaptureParams int
	CaptureOffsets   @[]int
	// CaptureByPtr indicates which captures are passed to the
	// wrapper as POINTERS into the closure struct (struct /
	// slice / interface / func-value types — anything the VM
	// passes by pointer per its calling convention) vs as
	// single-word values (scalars).  Indexed parallel to
	// CaptureOffsets.  Empty for non-closure VMFuncs.
	CaptureByPtr @[]bool
	// ClosureStructDtorName is the (qualified) name of this capturing
	// closure's struct destructor, or empty when the closure struct has
	// no managed fields.  BC_REFDEC_INLINE_FAST resolves it via
	// LookupFunc and runs it on the heap closure struct when the @func
	// value's COMPILED_CLOSURE record is freed, so the captured managed
	// values (and the struct) are released rather than leaked.  Empty
	// for non-closure VMFuncs.
	ClosureStructDtorName @[]char
	// FaultTable maps recoverable-fault PCs to cleanup-pad PCs as inline
	// (opPC, padPC) pairs sorted by opPC (binary-searched at fault time).  Built
	// by VM lowering from each faulting/call op's ir.Instr.PadBlock.  Empty for
	// functions with no fault sites.  See plan-rt-fault-cleanup-pads.md (Plan 2).
	FaultTable @[]int
}

// ============================================================
// VM state
// ============================================================

type VM struct {
	Funcs       @[]@VMFunc // function table
	Stack       *uint8 // stack memory base
	StackSize   int // total stack size
	SP          int // current stack pointer
	Globals     *uint8 // global variable area
	GlobalsSize int // globals area size
	Strings     @[]@[]char // string constants (proper managed-slices)

	// Name → vm.Funcs idx hash (open-addressing, linear probing).
	// Kept in sync by LowerModule / LowerOneFunc.  Used by
	// LookupFunc for O(1) callee resolution; also enables eager
	// CallCache fill at lowering time, which is the substrate the
	// Tier 4 shadow path needs (per-call-site resolution must be
	// frozen at lowering time so an old caller keeps its old
	// callee even after a same-named func gets shadowed).
	//
	// Capacity is always a power of two so `& IndexMask` replaces
	// modulo.  IndexBuckets is lazy-initialized on first insert.
	IndexBuckets @[]FuncIndexEntry
	IndexCount   int // populated entries
	IndexMask    int // capacity - 1; 0 before lazy init

	// Externs registry: name → {vtable, data} of a compiled-side
	// function value.  When BC_CALL fails to resolve a name in
	// vm.Funcs, execExtern checks this registry; if found, it
	// dispatches via the always-shim convention through
	// rt._call_shim_scalar — the same path bytecode-side function-
	// value calls take in dispatchCompiledFuncValue.  Registration
	// happens once at VM init via RegisterExtern; the legacy hand-
	// coded execExtern switch remains for residual cases (multi-
	// word returns, refcount-surgical bootstrap.Args / ReadDir).
	Externs @[]ExternBinding

	// IfaceVtables: per-(impl, interface) vtable records. Each
	// entry is a heap-allocated array of 1-based VM function
	// indices in the interface's method-declaration order. Set up
	// by LowerModule from m.Impls. BC_IFACE_VALUE references a
	// vtable by index into this slice (the index is encoded as
	// Aux on the bytecode instruction). BC_CALL_IFACE_METHOD reads
	// the vtable address from the iv slot and indexes into it at
	// the method slot to recover the VM function index. See plan-
	// interface-syntax-revision.md (Slice 2.3c).
	IfaceVtables @[]@IfaceVtable

	// Interrupt seam (inert in v1; see plan-repl-embeddable.md Stage 5).
	// Poll is the host's cooperative-interrupt delegate, consulted at
	// statement boundaries and loop back-edges (set via SetPoll).
	// PollEnabled gates the hot path: false ⇒ Poll is never consulted
	// (a single not-taken branch per poll point, zero allocation) — the
	// v1 default.  Status carries the most recent poll outcome up the
	// execLoop → execFunc → Call* chain; it is VM_STATUS_CONTINUE
	// throughout v1 (a nil/absent Poll never yields Suspend/Break).
	// ResumePC / ResumeFuncIdx / ResumeRegsOff spill a suspended frame's
	// resume point; unused until the suspend stage lands.
	Poll          @func(@VM) int
	PollEnabled   bool
	Status        int
	ResumePC      int
	ResumeFuncIdx int
	ResumeRegsOff int
	// FaultMsg carries the message of the most recent RECOVERABLE user-code
	// fault (Plan 2): set alongside Status = VM_STATUS_FAULTED and read by the
	// host to report it.  Empty otherwise; cleared at the start of each host
	// Call* so a prior turn's fault does not linger.  See plan-rt-abort-panic.md.
	FaultMsg @[]char

	// IR-to-bytecode lowering state — per-VM (was package-global).
	// Holding it on the VM is what lets two VMs lower modules in one
	// process without clobbering each other's tables.
	//
	// Session-lifetime; accumulate across every LowerModule on this VM:
	globalNames     @[]@[]char // global-var names, parallel to globalAddrs
	globalAddrs     @[]int // heap address of each global
	vtableInjNames  @[]@[]char // injected native-only vtable names
	vtableInjAddrs  @[]int // each injected vtable's raw @__ivt address
	vtableInjShims  @[]int // each injected vtable's @__ivtshim address
	vtableInjSizes  @[]int // each injected vtable's slot count (extent bound)
	satEntryTypes   @[]int // injected satisfaction entries: &TypeInfo(T) per (T,J)
	satEntryIfaces  @[]int // parallel: &IfaceId(J) per (T,J)
	satEntryVtables @[]int // parallel: &__ivt.<T>__<J> sub-vtable per (T,J)
	dataSymNames    @[]@[]char // materialized data-global symbols (__typeinfo.<T>, …)
	dataSymAddrs    @[]int // parallel: runtime address of each materialized record
	// Per-module scratch; reset at each LowerModule / LowerOneFunc(Shadow):
	modulePkgName @[]char // pkg path used to qualify call targets
	moduleStrings @[]@[]char // materialized string headers for the module
	curStrings    @[]ir.StringConst // active module's string-constant slice
	// Per-function scratch; reset at the top of each lowerFunc:
	curNames @[]@[]char // name table being built for the current func
}

// IfaceVtable holds the runtime-resolved VM function indices for a
// single (impl, interface) pair. The Methods slice is in the
// interface's method-declaration order; each entry is a 1-based
// VM function index (0 = not found, treated as a fatal at dispatch
// time). Name is the mangled `__ivt.<...>` form used by IR-gen so
// VM lower can find a vtable by name when lowering OP_IFACE_VALUE.
type IfaceVtable struct {
	Name    @[]char
	Methods @[]int
}

// FuncIndexEntry: one slot in the VM's name→idx hash.  An empty
// slot has Name == nil (or len(Name) == 0).
type FuncIndexEntry struct {
	Name @[]char
	Idx  int
}

// ExternBinding: name → compiled-side function value, populated by
// RegisterExtern.  The 16-byte function value's two words are stored
// inline so the binding owns its own copy (the user's source fv may
// be a stack local — copying decouples its lifetime from the VM's).
// VtableAddr's `call` slot is the per-function shim; DataAddr is
// null for non-capturing function refs.
//
// RetbufSize is the aggregate RETBUF size (types.AggregateReturnSize:
// rounded to N*8, or 0 for a scalar return) — the cross-mode dispatch
// shape, agreeing with codegen's isAggregateReturn:
//   - 0: scalar dispatch via rt._call_shim_scalar — vtable.call is
//     `<ret>(i8*, args...)*`.
//   - > 0: aggregate dispatch via rt._call_shim_aggregate (a coerced
//     ≤ 8-byte struct, a multi-return, a slice / managed-slice, or any
//     > word result) — vtable.call is `void(i8* retbuf, i8* data,
//     args...)*` and dispatchExternBinding reserves RetbufSize retbuf
//     bytes before calling.
type ExternBinding struct {
	Name       @[]char
	VtableAddr int
	DataAddr   int
	RetbufSize int
	// HandleAddr is the binding's owned copy of the registered
	// function's 16-byte {VtableAddr, DataAddr} function-value
	// handle.  Populated by RegisterExtern from the caller's
	// `_func_handle(F)` argument (which may be a static
	// `@__handle.F` global in native or a heap allocation on
	// VMFunc.Handle in bytecode); RegisterExtern copies the two
	// words into a fresh managed allocation so the binding's
	// lifetime is independent of the caller's source.
	// BC_FUNC_HANDLE casts this managed pointer to int and returns
	// it — the resulting *uint8 points at a uniformly-shaped handle
	// across all vm-nesting depths.  nil if the registrant didn't
	// supply one (e.g. legacy tests).
	HandleAddr @VMFuncHandle
}

// ============================================================
// Public API
// ============================================================

// NewVM creates a new VM with the given stack size.
func NewVM(stackSize int) @VM

// VM execution status, threaded up the exec chain by the interrupt
// seam.  VM_STATUS_CONTINUE (0, the make-zero default) is the only
// value v1 ever produces; SUSPENDED / BROKE / FAULTED are reserved for
// the suspend / break / recoverable-fault stages.
const VM_STATUS_CONTINUE int = 0

const VM_STATUS_SUSPENDED int = 1

const VM_STATUS_BROKE int = 2

// VM_STATUS_FAULTED marks a RECOVERABLE user-code runtime fault (a bad
// interpreted program: bounds / divide-by-zero / negative-shift / nil-deref /
// stack-overflow / call-through-nil).  The host survives and reads FaultMsg;
// distinct from an internal-invariant abort (still a hard rt.Panic).  Reserved
// by Inc 1 — the guard sites move onto it and the exec loop unwinds in later
// increments.  See plan-rt-abort-panic.md (Plan 2).
const VM_STATUS_FAULTED int = 3

// Poll delegate return values — what a host's Poll asks the VM to do
// at a poll point.  Inert in v1 (no Poll is installed, so the delegate
// is never consulted).
const POLL_CONTINUE int = 0

const POLL_BREAK int = 1

const POLL_SUSPEND int = 2

// SetPoll installs the host's cooperative-interrupt delegate, consulted
// at statement boundaries and loop back-edges, and arms the poll
// fast-path gate.  Until a delegate is set (the v1 default) the seam is
// inert — the gate stays false and the delegate is never called.
// Reserved for the suspend / break stages; v1 never yields a
// non-Continue poll result.
func (vm @VM) SetPoll(poll @func(@VM) int)

// Resume continues a VM suspended by a prior poll (one whose Status is
// VM_STATUS_SUSPENDED).  No-op in v1: the poll seam is inert so a VM
// never suspends, hence there is nothing to resume.  Reserved so the
// host-facing API is stable before the suspend stage fills in the
// reload-from-Resume* path.
func (vm @VM) Resume() int

// TrampolineScalar is the cross-mode dispatch trampoline for VM-side
// function values with scalar return. Compiled code reaches it
// through vtable.call after constructing or receiving a VM-side
// function value. Reads the VMClosureRec from `data` (which carries
// both the VM handle and the vm_func_idx), packs the user args into
// argv, and calls execFunc on that VM. The fixed 7-arg shape is
// intentional — see plan-function-values-phase-3.md (Slice 3.2).
// Not normally called directly; BC_FUNC_VALUE wires its address into
// vtable.call.
func TrampolineScalar(data *uint8, a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int) int

// TrampolineAggregate is the aggregate-return counterpart of
// TrampolineScalar — vtable.call slot for VM-side function values
// whose return type is multi-word (slice / managed-slice / multi-
// word struct).  Convention matches the aggregate-shim shape:
// caller allocates retbuf, trampoline dispatches into the bytecode
// VMFunc and memcpys ResultSizes[0] bytes from execFunc's returned
// address into retbuf.  See pkg/binate/vm/vm.bn for the body.
func TrampolineAggregate(retbuf *uint8, data *uint8, a0 int, a1 int, a2 int, a3 int, a4 int, a5 int,
		a6 int)

// LowerModule converts an IR module to bytecode functions and adds them to the VM.
func (vm @VM) LowerModule(m @ir.Module)

// LowerOneFunc lowers a single IR function to a VMFunc and appends
// it to vm.Funcs.  REPL entry point.  Caller must have AddFunc'd f
// into m and previously called LowerModule(vm, m).
func (vm @VM) LowerOneFunc(m @ir.Module, f @ir.Func) @VMFunc

// LowerOneFuncShadow lowers a single IR function to a VMFunc and
// always APPENDS to vm.Funcs (never replaces).  REPL entry point
// for Tier 4 shadow path: incompatible-signature redefinition
// keeps the OLD VMFunc reachable at its existing idx for any
// caller whose CallCache already resolved that callee.  The
// funcIndex is re-pointed to the new idx so fresh lowerings
// resolve to the new VMFunc.
func (vm @VM) LowerOneFuncShadow(m @ir.Module, f @ir.Func) @VMFunc

// MaterializeOneGlobal allocates storage for a single newly-declared
// global and appends it to the VM's per-name global tables.  REPL
// entry point for `var` decls typed at the prompt.  Storage is
// zero-initialized; like the file-load path, declared initializers
// are not applied (the user can assign in a follow-up prompt entry).
func (vm @VM) MaterializeOneGlobal(g @ir.Global)

// CallFunc calls a function by name with the given arguments.
func (vm @VM) CallFunc(name *[]readonly char, args @[]int) int

// CallByVMFunc executes a VMFunc directly, skipping LookupFunc.
// REPL entry point: invokes the synthetic __repl_n func returned by
// LowerOneFunc without a name lookup.
func (vm @VM) CallByVMFunc(vmf @VMFunc, args @[]int) int

// LookupFunc returns the index of a function by name, or -1.
func (vm @VM) LookupFunc(name *[]readonly char) int

// RegisterExtern binds a name to a compiled-side function value.
// fvAddr must point at a 16-byte {vtable, data} struct (a Phase-1
// non-capturing function value, typically obtained via
// `var fv *func(...) ... = someFunc; bit_cast(*uint8, &fv)`).
// The 16 bytes are copied into the binding so the user's source
// fv may go out of scope after registration.  Re-registering an
// existing name overwrites it.
//
// retbufSize is the aggregate RETBUF size (types.AggregateReturnSize:
// 0 for a scalar/pointer/void return, else the rounded retbuf byte
// count) and tells dispatchExternBinding which shim convention to use:
// 0 -> rt._call_shim_scalar; > 0 -> rt._call_shim_aggregate with a
// retbuf of retbufSize bytes on vm.Stack.  Pass 0 for ANY scalar return
// — a nonzero scalar size would wrongly dispatch as aggregate.
//
// At BC_CALL time, when LookupFunc returns no VM function, the
// registry is consulted.  Hits dispatch through the appropriate
// shim convention (scalar via rt._call_shim_scalar, aggregate via
// rt._call_shim_aggregate) — same path as dispatchCompiledFuncValue.
func (vm @VM) RegisterExtern(name *[]readonly char, fvAddr *uint8, retbufSize int, rawFnAddr int)

// LookupExtern returns the index of a registered extern by name,
// or -1.  Diagnostic / wired into execExtern's dispatcher.
func (vm @VM) LookupExtern(name *[]readonly char) int

// RegisterVmTrampolines binds the VM's own cross-mode dispatch
// trampolines (TrampolineScalar / TrampolineAggregate) into vm's extern
// registry.  These are required for cross-mode dispatch by any host, so a
// host registering its packages calls this alongside RegisterPackage*.
// See pkg/binate/vm/extern_register.bn for why they stay hand-bound by
// name (not auto-enumerated) and the native-vs-bytecode call-slot detail.
func RegisterVmTrampolines(vmInst @VM)

// RegisterPackageFunctions auto-enumerates a compiled package's exported
// functions from its `__Package().Functions` table and binds each into the
// VM's extern registry — the package-level injection primitive.  A host
// that links a native package P (e.g. a __c_call stdlib package the VM
// can't interpret) injects it by calling
// `vm.RegisterPackageFunctions(vmInst, P.__Package())`, then skipping P
// when lowering the program's bytecode so P's calls resolve to the
// injected native externs.  Extern (pure-C) entries are excluded from the
// table, so a package whose surface is extern needs those hand-bound.
func RegisterPackageFunctions(vmInst @VM, p @reflect.Package)

// RegisterPackageGlobals auto-enumerates a compiled package's exported globals
// from its `__Package().Globals` table and binds each global's native storage
// address into the VM's global table, so a bytecode cross-package read of one
// (e.g. a sentinel `errors.NotFound`) resolves to the SINGLE native instance —
// the pointer identity `errors.Is` matches on.  The package-level companion to
// RegisterPackageFunctions: a host injecting a native-only package P calls both
// `vm.RegisterPackageFunctions(vmInst, P.__Package())` and
// `vm.RegisterPackageGlobals(vmInst, P.__Package())`.
func RegisterPackageGlobals(vmInst @VM, p @reflect.Package)

// RegisterPackageVtables registers a native-only injected package's
// interface-impl vtables from its `__Package().Vtables` table, binding each
// vtable's bare mangled name to its native `@__ivt` address, so a bytecode-built
// interface value over the package's struct resolves the vtable instead of
// fatally missing the un-lowered vm.IfaceVtables (conformance 726).  The
// package-level companion to RegisterPackageFunctions / RegisterPackageGlobals:
// a host injecting a native-only package P calls all three with `P.__Package()`.
func RegisterPackageVtables(vmInst @VM, p @reflect.Package)

// RegisterPackageSatEntries records a native-only injected package's
// interface-satisfaction facts from its `__Package().SatEntries` table, binding
// each `(TypeInfo(T), IfaceId(J)) -> __ivt.<T>__<J>` triple into the VM's
// per-instance satisfaction registry, so the Phase-5 assertion reader can resolve
// a scrutinee's dynamic type without re-deriving it.  The package-level companion
// to RegisterPackageFunctions / RegisterPackageGlobals / RegisterPackageVtables: a
// host injecting a native-only package P calls all four with `P.__Package()`.
// Inert until the Phase-5 reader consults the registry.
func RegisterPackageSatEntries(vmInst @VM, p @reflect.Package)
