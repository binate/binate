package "pkg/binate/vm"

import "pkg/builtins/rt"

// CallFuncAggregate calls a function by name and copies its aggregate /
// multi-return result into the caller-provided `retbuf` (`retbufSize` bytes =
// `types.AggregateReturnSize` of the function's results).  Unlike CallFunc —
// which returns one word and so truncates an aggregate/tuple *address* — this
// delivers the FULL result image, so a host (e.g. interp's RunFuncTyped) can
// unpack aggregate and multi-return results.  A scalar/void return (retbufSize
// 0) leaves `retbuf` untouched and the returned word is the value, exactly as
// CallFunc.  On a recoverable fault (Plan 2) the retbuf is left untouched and
// the caller inspects `vm.Status` / `vm.FaultMsg` (as with CallFunc + RunMain).
//
// This is the host-driven counterpart of TrampolineAggregate (the func-value
// dispatch path), generalized from single-result to any multi-return — the
// packed tuple image is contiguous at the returned address, so one exact-size
// MemCopy captures it.  LIMITATION: this only handles a result image UP TO 64
// BYTES.  execFunc's top-level entry-frame relocation caps the live result
// window at 64 bytes (vm_exec_helpers.bn) and resets vm.SP just past it, so a
// `retbufSize` > 64 would MemCopy past the reset SP (freed stack) and read
// truncated high bytes; lifting that cap for this path is a follow-up.  Today's
// callers stay within it (interp's RunFuncTyped returns @[]char = 32 bytes; the
// Stage-A tests use 16-byte results).  Interface-value results implemented by a
// bytecode impl carry a VM-index
// vtable word the native host can't dereference; each is substituted for the
// impl's native handle-vtable in the retbuf COPY (the VM's own box is untouched,
// so identity holds).  `ResultIfaceVtOffsets` covers every result — a single
// aggregate OR every multi-return tuple slot — so an iface value in any slot is
// translated (populateResultMetadata / ifaceVtOffsetsForResults).
func (vm @VM) CallFuncAggregate(name *[]readonly char, args @[]int, retbuf *uint8,
		retbufSize int) int {
	var idx int = vm.LookupFunc(name)
	if idx < 0 {
		vmPanicName("vm: function not found: ", name)
	}
	// Start from a clean interrupt / fault status, mirroring CallFunc.
	vm.Status = VM_STATUS_CONTINUE
	var noFaultMsg @[]char
	vm.FaultMsg = noFaultMsg
	vm.FaultRaised = false
	vm.CleanupDepth = 0
	var resultAddr int = cast(int, execFunc(vm, idx, args))
	// A recoverable fault unwound to the host: leave the retbuf untouched; the
	// result word/address is meaningless, but return it for symmetry with CallFunc.
	if vm.Status == VM_STATUS_FAULTED {
		return resultAddr
	}
	if retbufSize > 0 {
		rt.MemCopy(retbuf, bit_cast(*readonly uint8, resultAddr), retbufSize)
		var f @VMFunc = vm.Funcs.Get(idx)
		if len(f.ResultIfaceVtOffsets) > 0 {
			substituteVtWords(vm, bit_cast(int, retbuf), f.ResultIfaceVtOffsets)
		}
	}
	return resultAddr
}
