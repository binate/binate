package "pkg/binate/vm"

import "pkg/builtins/testing"

// Tests for CallFuncAggregate (vm.bn): the host-driven entry point that copies a
// function's FULL aggregate / multi-return result image into a caller retbuf,
// where CallFunc would only return (and truncate) one word.  `lowerFromSource`
// lives in lower_test.bn (same package).  int64 fields keep the byte layout
// target-independent (8 bytes each on every target).

// A struct return: the whole struct image must land in the retbuf, not a
// truncated word.
func TestCallFuncAggregateStructReturn() testing.TestResult {
	var vm @VM = lowerFromSource(
			"package \"test\"\n"
					"type Pair struct { a int64; b int64 }\n"
					"func mk() Pair { var p Pair; p.a = cast(int64, 3); p.b = cast(int64, 7); return p }\n")
	var retbuf @[]uint8 = make_slice(uint8, 16)
	var noArgs @[]int
	vm.CallFuncAggregate("test.mk", noArgs, &retbuf[0], 16)
	var w *int64 = bit_cast(*int64, &retbuf[0])
	if w[0] != cast(int64, 3) { return "struct field a should be 3" }
	if w[1] != cast(int64, 7) { return "struct field b should be 7" }
	return ""
}

// A two-value multi-return: the packed tuple image lands in the retbuf at the
// per-result offsets (0, 8).
func TestCallFuncAggregateMultiReturn() testing.TestResult {
	var vm @VM = lowerFromSource(
			"package \"test\"\n"
					"func pair() (int64, int64) { return cast(int64, 11), cast(int64, 13) }\n")
	var retbuf @[]uint8 = make_slice(uint8, 16)
	var noArgs @[]int
	vm.CallFuncAggregate("test.pair", noArgs, &retbuf[0], 16)
	var w *int64 = bit_cast(*int64, &retbuf[0])
	if w[0] != cast(int64, 11) { return "multi-return [0] should be 11" }
	if w[1] != cast(int64, 13) { return "multi-return [1] should be 13" }
	return ""
}

// A scalar return with retbufSize 0 delegates to the plain scalar path: the
// return word is the value and the retbuf is left untouched.
func TestCallFuncAggregateScalarNoRetbuf() testing.TestResult {
	var vm @VM = lowerFromSource("package \"test\"\nfunc answer() int { return 42 }\n")
	var noArgs @[]int
	var dummy @[]uint8 = make_slice(uint8, 1)
	var rc int = vm.CallFuncAggregate("test.answer", noArgs, &dummy[0], 0)
	if rc != 42 { return "scalar return should be 42" }
	return ""
}
