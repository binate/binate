package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/builtins/rt"

// CallIfaceMethod invokes interface-method `slot` on the interface value whose
// 2-word {data, vtable} image lives at `ivAddr`, host-driven — a native caller
// (e.g. interp's RunFuncTyped, holding a marshaled iface RESULT) calling a method
// on it.  It is the synchronous counterpart of dispatchCompiledIfaceMethod's
// native arm minus the BCInstr / register file: resolve the method's func-value
// handle from the iface's (native) vtable, prepend the receiver as a0, and dispatch
// through the handle's marshaling shim.  There is NO execFunc / frame push here;
// the shim itself re-enters the VM for a bytecode-impl method.  It handles both a
// VM-impl iface (SI-4-substituted buildNativeIfaceVtable, handles in the word) and
// a native-injected-package iface (raw @__ivt, handles in the parallel @__ivtshim
// via lookupShimVtable) — see the resolution below.
//
// Convention (mirrors CallFuncAggregate): `args` is one word per user arg (any
// count — the packed dispatch carries ANY arity); a scalar / scalar64 result comes
// back as the returned word, an aggregate is written into the caller-provided
// `retbuf` (sized to types.AggregateReturnSize, host-owned — so execFunc's 64-byte
// result window does not apply).  A nil interface value raises a recoverable fault
// (the caller inspects vm.Status / vm.FaultMsg); a contract violation (a
// non-substituted VM-index vtable word) is a vmPanic.  Interface-typed method ARGS
// are unsupported — they need the arg-direction substitution the host cannot supply,
// so callers must reject them.
//
// The `slot` is the ABSOLUTE vtable slot (slot 0 = dtor, slot 1 = *TypeInfo, method
// slots at 2+); the interp layer resolves it from (interface, method name).
func (vm @VM) CallIfaceMethod(ivAddr int, slot int, retbufSize int, scalar64 bool, args @[]int,
		retbuf *uint8) int {
	// Start from a clean fault status, mirroring CallFunc / CallFuncAggregate.
	vm.Status = VM_STATUS_CONTINUE
	var noFaultMsg @[]char
	vm.FaultMsg = noFaultMsg
	vm.FaultRaised = false
	vm.CleanupDepth = 0

	if ivAddr == 0 {
		setFault(vm, "vm: method call on a nil interface value")
		return 0
	}
	var iv *int = bit_cast(*int, ivAddr)
	var vtword int = iv[types.IfaceValueVtableIndex()]
	if vtword == 0 {
		setFault(vm, "vm: method call on a nil interface value")
		return 0
	}
	if !ifaceVtIsNative(vm, vtword) {
		// The host must pass a marshaled / SI-4-substituted image, never a raw VM
		// box — a VM-index word here is a host-contract violation, not user error.
		vmPanic("vm: CallIfaceMethod requires a substituted (native) vtable word")
	}
	// "Native" covers TWO vtable representations; both hold func-value @__handle
	// {vtable, data} per slot, but at different addresses:
	//   (1) a VM-impl iface whose word SI-4 substituted to a buildNativeIfaceVtable
	//       handle-vtable — the handles are in that word directly;
	//   (2) a native-injected COMPILED package's iface carrying a raw @__ivt whose
	//       slots hold raw method fns — the handles live in the PARALLEL @__ivtshim
	//       that lookupShimVtable resolves (exactly as dispatchCompiledIfaceMethod).
	// lookupShimVtable returns non-zero ONLY for a registered raw @__ivt (a VM-owned
	// substituted block is not one), so it distinguishes the two: use the shim
	// vtable when it resolves, else the substituted word itself.  Reading a raw
	// method fn as a handle would wild-dispatch, so this resolution is load-bearing.
	var handleVt int = vtword
	var shimVt int = lookupShimVtable(vm, vtword)
	if shimVt != 0 {
		handleVt = shimVt
	}
	// The chosen vtable holds a func-value @__handle {vtable, data} per slot; slot 2
	// of that handle's vtable is the call_packed target (the method's __shimP) — the
	// uniform packed-int-slot entry carrying ANY arg/return shape, exactly as
	// func-value / extern dispatch reads it.
	var handle *int = bit_cast(*int, bit_cast(*int, handleVt)[slot])
	if bit_cast(int, handle) == 0 {
		vmPanic("vm: iface method slot has no handle")
	}
	var vtable *int = bit_cast(*int, handle[types.FuncValueVtableIndex()])
	var callPacked int = vtable[types.FuncValueVtableCallPackedIndex()]
	if callPacked == 0 {
		vmPanic("vm: iface method's vtable.call_packed is nil")
	}
	var callPackedFn *uint8 = bit_cast(*uint8, callPacked)
	var dataPtr *uint8 = bit_cast(*uint8, handle[types.FuncValueDataIndex()])

	// The packed args are [receiver, user args...]: the receiver (the method's first
	// param, the iv data ptr — a borrow, no RefInc) is packed slot 0, user args follow
	// one word per slot, matching how __shimP / the impl shim reads them.  Build the
	// contiguous slot array (the receiver and the caller's args slice are not
	// contiguous), any arity.
	var nPacked int = len(args) + 1
	var packed @[]int = make_slice(int, nPacked)
	packed[0] = iv[types.IfaceValueDataIndex()]
	for i := 0; i < len(args); i++ {
		packed[i + 1] = args[i]
	}

	// A bytecode-impl method re-enters the VM through its handle; the cross-mode
	// SatLookup fallback keys off g_crossModeVmAddr, so set it around the dispatch
	// (mirroring dispatchExternBinding) and restore it after.  Invoke call_packed
	// through the existing rt._call_shim_scalar64 indirect-call vehicle: its fixed
	// arity places (data, argsPtr, nSlots, retbuf) in the first arg registers on every
	// target ABI (call_packed(data, args, nSlots, retbuf)).
	var savedVmAddr int = g_crossModeVmAddr
	g_crossModeVmAddr = bit_cast(int, vm)
	var argsPtr int = bit_cast(int, &packed[0])
	var result int = 0
	if retbufSize > 0 {
		// Aggregate return: call_packed writes the natural-typed result through the
		// caller's retbuf.  A method returning another interface value hands back
		// native words automatically (the callee's shim applies substituteVtWords over
		// its ResultIfaceVtOffsets).  The i64 return is unused (call_packed returns 0).
		rt._call_shim_scalar64(callPackedFn, dataPtr, argsPtr, nPacked, bit_cast(int, retbuf), 0, 0, 0, 0)
		result = bit_cast(int, retbuf)
	} else {
		// Scalar return (one-word OR bare 64-bit): call_packed returns the scalar as
		// i64 bits.  The host receives it as one `int` word — the full value on LP64,
		// the low word of a 64-bit scalar on an ILP32 target (the documented scalar
		// truncation).  The scalar64 parameter no longer selects a distinct primitive
		// (the uniform i64 return covers both), so it does not steer the dispatch here.
		result = cast(int, rt._call_shim_scalar64(callPackedFn, dataPtr, argsPtr, nPacked, 0, 0, 0, 0, 0))
	}
	g_crossModeVmAddr = savedVmAddr
	return result
}
