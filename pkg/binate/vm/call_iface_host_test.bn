package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// The absolute vtable slot of the first (declaration-order) interface method:
// slot 0 = dtor, slot 1 = *TypeInfo, method slots at 2+.
var kFirstMethodSlot int = 2

// A host-driven SCALAR interface-method call: mk() returns a @Shape (its vtable
// word substituted to a native handle-vtable by CallFuncAggregate), then
// CallIfaceMethod invokes area() on it synchronously through the handle shim.
func TestCallIfaceMethodScalar() testing.TestResult {
	var vm @VM = lowerFromSource(
			"package \"test\"\n"
					"interface Shape { area() int }\n"
					"type sq struct { side int }\n"
					"func (s @sq) area() int { return s.side * s.side }\n"
					"impl @sq : Shape\n"
					"func mk() @Shape { var s @sq = make(sq); s.side = 5; return s }\n")
	RegisterVmTrampolines(vm)
	var retbuf @[]uint8 = make_slice(uint8, 2 * REG_SLOT)
	var noArgs @[]int
	vm.CallFuncAggregate("test.mk", noArgs, &retbuf[0], 2 * REG_SLOT)
	var noMethodArgs @[]int
	var noRetbuf *uint8
	var result int = vm.CallIfaceMethod(bit_cast(int, &retbuf[0]), kFirstMethodSlot, 0, false,
			noMethodArgs, noRetbuf)
	releaseHostIfaceValue(&retbuf[0])
	if result != 25 {
		return "area() should be 25 (5 * 5)"
	}
	return ""
}

// A host-driven AGGREGATE-RETURN interface-method call: mk() returns a @Named,
// then CallIfaceMethod invokes name() @[]char and the shim writes the 4-word
// managed-slice image into the caller's retbuf.  This is the bare-VM counterpart
// of the interp SI-5c aggregate round-trip; the impl builds its @[]char field from
// a string literal, so NO StandardPackages / stdlib helper is needed to construct
// the fixture (only the interp's host-side @[]char ARG marshaling needs that — the
// dispatch and aggregate return themselves do not).
func TestCallIfaceMethodAggregate() testing.TestResult {
	var vm @VM = lowerFromSource(
			"package \"test\"\n"
					"interface Named { name() @[]char; size() int }\n"
					"type Boxed struct { s @[]char; n int }\n"
					"func (b @Boxed) name() @[]char { return b.s }\n"
					"func (b @Boxed) size() int { return b.n }\n"
					"impl @Boxed : Named\n"
					"func mk() @Named { var b @Boxed = make(Boxed); b.s = \"hi\"; b.n = 5; return b }\n")
	RegisterVmTrampolines(vm)
	var ivbuf @[]uint8 = make_slice(uint8, 2 * REG_SLOT)
	var noArgs @[]int
	vm.CallFuncAggregate("test.mk", noArgs, &ivbuf[0], 2 * REG_SLOT)
	// name() is the first-declared method (slot 2); it returns @[]char = a 4-word
	// managed slice, so the call takes a 4-word retbuf (retbufSize != 0).
	var retbuf @[]uint8 = make_slice(uint8, 4 * REG_SLOT)
	var noMethodArgs @[]int
	vm.CallIfaceMethod(bit_cast(int, &ivbuf[0]), kFirstMethodSlot, 4 * REG_SLOT, false, noMethodArgs,
			&retbuf[0])
	var words *int = bit_cast(*int, &retbuf[0])
	var ok bool = words[types.MSLICE_FIELD_LEN] == 2
	releaseHostIfaceMSlice(&retbuf[0])
	releaseHostIfaceValue(&ivbuf[0])
	if !ok {
		return "name() should return the 2-char string 'hi'"
	}
	return ""
}

// A nil interface value raises a recoverable fault rather than crashing.
func TestCallIfaceMethodNilFaults() testing.TestResult {
	var vm @VM = lowerFromSource("package \"test\"\nfunc noop() {}\n")
	var zero @[]uint8 = make_slice(uint8, 2 * REG_SLOT) // {0, 0} = nil interface value
	var noArgs @[]int
	var noRetbuf *uint8
	vm.CallIfaceMethod(bit_cast(int, &zero[0]), kFirstMethodSlot, 0, false, noArgs, noRetbuf)
	if vm.Status != VM_STATUS_FAULTED {
		return "a nil interface method call should fault, not crash"
	}
	return ""
}

// releaseHostIfaceValue drops a marshaled iface value the way interp's releaseImage
// does: RefDec the data word through the slot-0 dtor handle.
func releaseHostIfaceValue(ptr *uint8) {
	var words *int = bit_cast(*int, ptr)
	var dataPtr int = words[types.IfaceValueDataIndex()]
	if dataPtr == 0 {
		return
	}
	var vtword int = words[types.IfaceValueVtableIndex()]
	var dtorHandle *uint8
	if vtword != 0 {
		dtorHandle = bit_cast(*uint8, bit_cast(*int, vtword)[0])
	}
	rt.RefDec(bit_cast(*uint8, dataPtr), dtorHandle)
}

// releaseHostIfaceMSlice drops a marshaled @[]char RESULT (name()'s +1-owned
// return): RefDec its backing through a nil dtor handle (a char backing needs no
// destructor).  A nil backing (empty slice) is a no-op.
func releaseHostIfaceMSlice(ptr *uint8) {
	var words *int = bit_cast(*int, ptr)
	var backing int = words[types.MSLICE_FIELD_BACKING]
	if backing == 0 {
		return
	}
	var noDtor *uint8
	rt.RefDec(bit_cast(*uint8, backing), noDtor)
}
