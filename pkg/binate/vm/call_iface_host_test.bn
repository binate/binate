package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// The absolute vtable slot of the first (declaration-order) interface method:
// slot 0 = dtor, slot 1 = *TypeInfo, method slots at 2+.
var kFirstMethodSlot int = 2

// A host-driven SCALAR interface-method call: mk() returns a @Shape (its vtable
// word substituted to a native handle-vtable by CallFuncAggregate), then
// CallIfaceMethod invokes area() on it synchronously through the handle shim.
func TestCallIfaceMethodScalar() testing.TestResult {
	var vm @VM = lowerFromSource(
			"package \"test\"\n"
					"interface Shape { area() int }\n"
					"type sq struct { side int }\n"
					"func (s @sq) area() int { return s.side * s.side }\n"
					"impl @sq : Shape\n"
					"func mk() @Shape { var s @sq = make(sq); s.side = 5; return s }\n")
	RegisterVmTrampolines(vm)
	var retbuf @[]uint8 = make_slice(uint8, 2 * REG_SLOT)
	var noArgs @[]int
	vm.CallFuncAggregate("test.mk", noArgs, &retbuf[0], 2 * REG_SLOT)
	var noMethodArgs @[]int
	var noRetbuf *uint8
	var result int = vm.CallIfaceMethod(bit_cast(int, &retbuf[0]), kFirstMethodSlot, 0, false,
			noMethodArgs, noRetbuf)
	releaseHostIfaceValue(&retbuf[0])
	if result != 25 {
		return "area() should be 25 (5 * 5)"
	}
	return ""
}

// (An aggregate-RETURN method — the .Error() @[]char shape — is exercised
// end-to-end through the interp in SI-5c, not here: constructing that fixture at
// the bare-VM level needs the interp's StandardPackages setup, which NewVM lacks.)

// A nil interface value raises a recoverable fault rather than crashing.
func TestCallIfaceMethodNilFaults() testing.TestResult {
	var vm @VM = lowerFromSource("package \"test\"\nfunc noop() {}\n")
	var zero @[]uint8 = make_slice(uint8, 2 * REG_SLOT) // {0, 0} = nil interface value
	var noArgs @[]int
	var noRetbuf *uint8
	vm.CallIfaceMethod(bit_cast(int, &zero[0]), kFirstMethodSlot, 0, false, noArgs, noRetbuf)
	if vm.Status != VM_STATUS_FAULTED {
		return "a nil interface method call should fault, not crash"
	}
	return ""
}

// releaseHostIfaceValue drops a marshaled iface value the way interp's releaseImage
// does: RefDec the data word through the slot-0 dtor handle.
func releaseHostIfaceValue(ptr *uint8) {
	var words *int = bit_cast(*int, ptr)
	var dataPtr int = words[types.IfaceValueDataIndex()]
	if dataPtr == 0 {
		return
	}
	var vtword int = words[types.IfaceValueVtableIndex()]
	var dtorHandle *uint8
	if vtword != 0 {
		dtorHandle = bit_cast(*uint8, bit_cast(*int, vtword)[0])
	}
	rt.RefDec(bit_cast(*uint8, dataPtr), dtorHandle)
}
