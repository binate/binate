package "pkg/binate/vm"

import "pkg/std/table"

// Data-symbol name→index table into the parallel dataSymNames / dataSymAddrs
// vectors — the data-symbol-table analog of func_index.bn (vm.Funcs) and
// extern_index.bn (vm.Externs).  A stdlib table.Table[*[]readonly char, int,
// VmNameHasher, VmNameEq] under the shared engine + zero-size policies; nil until
// the first insert.
//
// Without it, lookupDataSymAddr was a linear scan of the whole table, so
// registering the standard set's typeinfos + iface-ids (each insert guarded by a
// lookup) was O(N²) — a secondary contributor, after the extern registry, to
// interp.New()'s double-VM cost.  It also speeds the per-BC_DATA_SYM_ADDR
// execution-time lookup (vm_exec_funcref.bn).  Keys borrow each dataSymNames
// entry, which owns the backing (append-only vec), so the borrow never dangles.

// dataSymIndexLookup returns the dataSymNames/dataSymAddrs index for `name`, or
// -1 if absent.
func dataSymIndexLookup(vm @VM, name *[]readonly char) int {
	if vm.DataSymIndex == nil { return -1 }
	var idx int
	var ok bool
	idx, ok = vm.DataSymIndex.Get(name)
	if ok { return idx }
	return -1
}

// dataSymIndexSet records `name -> idx`, replacing any existing mapping.  Creates
// the table on first call.  `name` is BORROWED — its backing must outlive the
// table: dataSymInsert passes the @[]char it just pushed onto the append-only
// dataSymNames vec, and a string literal aliases immortal rodata.  (A borrow
// param, not @[]char, so a literal arg is not copied to a mortal heap slice.)
func dataSymIndexSet(vm @VM, name *[]readonly char, idx int) {
	if vm.DataSymIndex == nil {
		vm.DataSymIndex = table.NewTable[*[]readonly char, int, VmNameHasher, VmNameEq](VmNameHasher{},
				VmNameEq{})
	}
	vm.DataSymIndex.Put(name, idx)
}
