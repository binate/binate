package "pkg/binate/vm"

// Open-addressing hash mapping data-symbol names to their index in the
// parallel dataSymNames / dataSymAddrs vectors — the data-symbol-table
// analog of func_index.bn (vm.Funcs) and extern_index.bn (vm.Externs).
// Same djb2 hash, linear probing, power-of-two capacity, 75%-load
// resize; shares hashName / nameEq / FuncIndexEntry.  Lazy-initialized
// on first insert.
//
// Without it, lookupDataSymAddr was a linear scan of the whole table,
// so registering the standard set's typeinfos + iface-ids (each insert
// guarded by a lookup) was O(N²) — a secondary contributor, after the
// extern registry, to interp.New()'s double-VM cost.  It also speeds
// the per-BC_DATA_SYM_ADDR execution-time lookup (vm_exec_funcref.bn).
//
// Insert semantics: replace-if-present (the callers dedup before
// inserting, so replace is defensive — it keeps the hash consistent if
// a name is ever re-inserted).

// initialDataSymIndexCap is the starting bucket count — power of two,
// sized so the standard set fits with at most a couple of resizes.
const initialDataSymIndexCap int = 256

// dataSymIndexLookup returns the dataSymNames/dataSymAddrs index for
// `name`, or -1 if absent.  O(1) amortized.  Empty-slot marker is
// `len(Name) == 0` (real data-symbol names are always non-empty).
func dataSymIndexLookup(vm @VM, name *[]readonly char) int {
	if vm.dataSymIndexMask == 0 { return -1 }
	var h int = hashName(name)
	var bucket int = h & vm.dataSymIndexMask
	var probes int = 0
	for probes <= vm.dataSymIndexMask {
		var pos int = (bucket + probes) & vm.dataSymIndexMask
		var e FuncIndexEntry = vm.dataSymIndexBuckets[pos]
		if len(e.Name) == 0 {
			return -1
		}
		if nameEq(e.Name, name) {
			return e.Idx
		}
		probes = probes + 1
	}
	return -1
}

// dataSymIndexSet records `name -> idx`, replacing any existing
// mapping.  Lazy-initializes the bucket table on first call; resizes
// at 75% load.  `name` is the vector's owned @[]char, shared with the
// bucket entry.
func dataSymIndexSet(vm @VM, name @[]char, idx int) {
	if vm.dataSymIndexMask == 0 {
		vm.dataSymIndexBuckets = make_slice(FuncIndexEntry, initialDataSymIndexCap)
		vm.dataSymIndexMask = initialDataSymIndexCap - 1
	}
	dataSymIndexSetInternal(vm.dataSymIndexBuckets, vm.dataSymIndexMask, name, idx, vm)
	// Resize at 75% load: count*4 > capacity*3.
	if vm.dataSymIndexCount * 4 > (vm.dataSymIndexMask + 1) * 3 {
		dataSymIndexResize(vm)
	}
}

// dataSymIndexSetInternal performs one insert into the given buckets
// slice with the given mask.  Bumps vm.dataSymIndexCount on a fresh
// insert (no bump on replace).  Caller owns the resize decision.
func dataSymIndexSetInternal(buckets @[]FuncIndexEntry, mask int, name @[]char, idx int, vm @VM) {
	var h int = hashName(name)
	var bucket int = h & mask
	var probes int = 0
	for probes <= mask {
		var pos int = (bucket + probes) & mask
		if len(buckets[pos].Name) == 0 {
			buckets[pos].Name = name
			buckets[pos].Idx = idx
			vm.dataSymIndexCount = vm.dataSymIndexCount + 1
			return
		}
		if nameEq(buckets[pos].Name, name) {
			buckets[pos].Idx = idx
			return
		}
		probes = probes + 1
	}
	// Unreachable if resize is triggered at 75% load.
}

// dataSymIndexResize doubles the bucket capacity and rehashes every
// populated entry.  O(N) — called rarely (logarithmic in inserts).
func dataSymIndexResize(vm @VM) {
	var oldBuckets @[]FuncIndexEntry = vm.dataSymIndexBuckets
	var newCap int = (vm.dataSymIndexMask + 1) * 2
	vm.dataSymIndexBuckets = make_slice(FuncIndexEntry, newCap)
	vm.dataSymIndexMask = newCap - 1
	vm.dataSymIndexCount = 0
	for i := 0; i < len(oldBuckets); i++ {
		var e FuncIndexEntry = oldBuckets[i]
		if len(e.Name) > 0 {
			dataSymIndexSetInternal(vm.dataSymIndexBuckets, vm.dataSymIndexMask, e.Name, e.Idx, vm)
		}
	}
}
