package "pkg/binate/vm"

import "pkg/builtins/testing"
import "pkg/std/vec"

// Direct unit coverage for the data-symbol name→index hash — the
// dataSym analog of func_index_test.bn / extern_index_test.bn.
// Exercises lookup / insert / replace / resize on dataSymIndex*, plus
// the lookupDataSymAddr → dataSymIndex integration.  Reuses mkVM /
// makeName from func_index_test.bn (same package).

func TestDataSymIndexEmptyLookup() testing.TestResult {
	var vm @VM = mkVM()
	if dataSymIndexLookup(vm, "anything") != -1 {
		return "empty index must return -1"
	}
	return ""
}

func TestDataSymIndexInsertAndLookup() testing.TestResult {
	var vm @VM = mkVM()
	dataSymIndexSet(vm, "alpha", 0)
	dataSymIndexSet(vm, "beta", 1)
	dataSymIndexSet(vm, "gamma", 2)
	if dataSymIndexLookup(vm, "alpha") != 0 { return "alpha != 0" }
	if dataSymIndexLookup(vm, "beta") != 1 { return "beta != 1" }
	if dataSymIndexLookup(vm, "gamma") != 2 { return "gamma != 2" }
	if dataSymIndexLookup(vm, "missing") != -1 {
		return "absent name must return -1"
	}
	return ""
}

func TestDataSymIndexReplace() testing.TestResult {
	var vm @VM = mkVM()
	dataSymIndexSet(vm, "x", 7)
	if dataSymIndexLookup(vm, "x") != 7 { return "first insert" }
	var beforeCount int = vm.DataSymIndex.Len()
	dataSymIndexSet(vm, "x", 99)
	if dataSymIndexLookup(vm, "x") != 99 { return "replace didn't update" }
	if vm.DataSymIndex.Len() != beforeCount {
		return "count changed on replace; should be stable"
	}
	return ""
}

// TestDataSymIndexResize inserts far more entries than the table's initial
// capacity to force several grow-and-rehash steps; every name must remain findable
// after each rehash.  The insert names are held in `names` because DataSymIndex
// borrows each key's backing (real callers keep it alive via dataSymNames).
func TestDataSymIndexResize() testing.TestResult {
	var vm @VM = mkVM()
	var n int = 500
	var names @vec.Vec[@[]char] = vec.New[@[]char]()
	for i := 0; i < n; i++ {
		var nm @[]char = makeName("t", i)
		names.Push(nm)
		dataSymIndexSet(vm, nm, i)
	}
	for i := 0; i < n; i++ {
		if dataSymIndexLookup(vm, makeName("t", i)) != i {
			return "post-resize lookup mismatch"
		}
	}
	if vm.DataSymIndex.Len() != n {
		return "count != expected after bulk insert"
	}
	return ""
}

// TestRegisterDataSymManyResolves registers many data symbols through
// registerDataSymAddr (the public write path) and confirms each resolves
// to its address via lookupDataSymAddr — the O(N)→O(1) fix keeps the
// vec storage and the hash index in sync across amortized growth.
func TestRegisterDataSymManyResolves() testing.TestResult {
	var vm @VM = mkVM()
	var n int = 400
	for i := 0; i < n; i++ {
		// Addresses must be non-zero (0 is the "absent" sentinel); i+1 avoids it.
		registerDataSymAddr(vm, makeName("__typeinfo.T", i), (i + 1) * 8)
	}
	for i := 0; i < n; i++ {
		if lookupDataSymAddr(vm, makeName("__typeinfo.T", i)) != (i + 1) * 8 {
			return "lookupDataSymAddr mismatch after amortized growth"
		}
	}
	// A repeat registration is ignored (first binding wins).
	registerDataSymAddr(vm, makeName("__typeinfo.T", 3), 0xDEAD)
	if lookupDataSymAddr(vm, makeName("__typeinfo.T", 3)) != 4 * 8 {
		return "repeat registration must not overwrite the first binding"
	}
	return ""
}
