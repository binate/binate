package "pkg/binate/vm"

// Open-addressing hash mapping extern names to vm.Externs indices —
// the Externs-registry analog of func_index.bn (which does the same
// for vm.Funcs).  Same djb2 hash, linear probing, power-of-two
// capacity, and 75%-load resize; it shares hashName / nameEq /
// FuncIndexEntry with func_index.bn (both keyed by name, valued by an
// index).  Lazy-initialized on first insert (zero-valued VM has empty
// ExternIndexBuckets / Mask=0 / Count=0).
//
// It exists because RegisterExtern is called once per function of
// every injected standard package (hundreds), so the old linear
// dup-scan plus grow-by-one append was O(N²) — see the ExternIndex*
// fields' note in vm.bni.
//
// Insert semantics: replace-if-present (an extern re-registration
// updates the stored index in place, matching RegisterExtern).

// initialExternIndexCap is the starting bucket count for a freshly
// initialized extern index — power of two, sized so the standard
// package set fits with at most a couple of resizes.
const initialExternIndexCap int = 256

// externIndexLookup returns the vm.Externs index for `name`, or -1 if
// not present.  O(1) amortized.  Empty-slot marker is `len(Name) == 0`
// (real extern names are always non-empty).
func externIndexLookup(vm @VM, name *[]readonly char) int {
	if vm.ExternIndexMask == 0 { return -1 }
	var h int = hashName(name)
	var bucket int = h & vm.ExternIndexMask
	var probes int = 0
	for probes <= vm.ExternIndexMask {
		var pos int = (bucket + probes) & vm.ExternIndexMask
		var e FuncIndexEntry = vm.ExternIndexBuckets[pos]
		if len(e.Name) == 0 {
			return -1
		}
		if nameEq(e.Name, name) {
			return e.Idx
		}
		probes = probes + 1
	}
	return -1
}

// externIndexSet records `name -> idx`, replacing any existing
// mapping.  Lazy-initializes the bucket table on first call; resizes
// at 75% load.  `name` is the binding's owned @[]char, shared with the
// bucket entry.
func externIndexSet(vm @VM, name @[]char, idx int) {
	if vm.ExternIndexMask == 0 {
		vm.ExternIndexBuckets = make_slice(FuncIndexEntry, initialExternIndexCap)
		vm.ExternIndexMask = initialExternIndexCap - 1
	}
	externIndexSetInternal(vm.ExternIndexBuckets, vm.ExternIndexMask, name, idx, vm)
	// Resize at 75% load: count*4 > capacity*3.
	if vm.ExternIndexCount * 4 > (vm.ExternIndexMask + 1) * 3 {
		externIndexResize(vm)
	}
}

// externIndexSetInternal performs one insert into the given buckets
// slice with the given mask.  Bumps vm.ExternIndexCount on a fresh
// insert (no bump on replace).  Caller owns the resize decision.
func externIndexSetInternal(buckets @[]FuncIndexEntry, mask int, name @[]char, idx int, vm @VM) {
	var h int = hashName(name)
	var bucket int = h & mask
	var probes int = 0
	for probes <= mask {
		var pos int = (bucket + probes) & mask
		if len(buckets[pos].Name) == 0 {
			buckets[pos].Name = name
			buckets[pos].Idx = idx
			vm.ExternIndexCount = vm.ExternIndexCount + 1
			return
		}
		if nameEq(buckets[pos].Name, name) {
			buckets[pos].Idx = idx
			return
		}
		probes = probes + 1
	}
	// Unreachable if resize is triggered at 75% load.
}

// externIndexResize doubles the bucket capacity and rehashes every
// populated entry.  O(N) — called rarely (logarithmic in inserts).
func externIndexResize(vm @VM) {
	var oldBuckets @[]FuncIndexEntry = vm.ExternIndexBuckets
	var newCap int = (vm.ExternIndexMask + 1) * 2
	vm.ExternIndexBuckets = make_slice(FuncIndexEntry, newCap)
	vm.ExternIndexMask = newCap - 1
	vm.ExternIndexCount = 0
	for i := 0; i < len(oldBuckets); i++ {
		var e FuncIndexEntry = oldBuckets[i]
		if len(e.Name) > 0 {
			externIndexSetInternal(vm.ExternIndexBuckets, vm.ExternIndexMask, e.Name, e.Idx, vm)
		}
	}
}
