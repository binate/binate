package "pkg/binate/vm"

import "pkg/std/table"

// Extern name→index table into vm.Externs — the Externs analog of func_index.bn
// (vm.Funcs).  A stdlib table.Table[*[]readonly char, int, VmNameHasher,
// VmNameEq] under the shared engine + zero-size policies; nil until the first
// RegisterExtern.  It exists because RegisterExtern runs once per function of
// every injected standard package (hundreds), so the old linear dup-scan plus
// grow-by-one append was O(N²).  Keys borrow each ExternBinding.Name, owned by
// the append-only vm.Externs, so the borrow never dangles.

// externIndexLookup returns the vm.Externs index for `name`, or -1 if absent.
func externIndexLookup(vm @VM, name *[]readonly char) int {
	if vm.ExternIndex == nil { return -1 }
	var idx int
	var ok bool
	idx, ok = vm.ExternIndex.Get(name)
	if ok { return idx }
	return -1
}

// externIndexSet records `name -> idx`, replacing any existing mapping.  Creates
// the table on first call.  `name` is BORROWED — its backing must outlive the
// table: RegisterExtern passes the ExternBinding.Name it just stored in the
// append-only vm.Externs, and a string literal aliases immortal rodata.  (A borrow
// param, not @[]char, so a literal arg is not copied to a mortal heap slice.)
func externIndexSet(vm @VM, name *[]readonly char, idx int) {
	if vm.ExternIndex == nil {
		vm.ExternIndex = table.NewTable[*[]readonly char, int, VmNameHasher, VmNameEq](VmNameHasher{},
				VmNameEq{})
	}
	vm.ExternIndex.Put(name, idx)
}
