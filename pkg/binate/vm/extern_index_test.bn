package "pkg/binate/vm"

import "pkg/builtins/testing"

// Direct unit coverage for the per-VM extern name→idx hash — the
// Externs analog of func_index_test.bn.  Exercises lookup / insert /
// replace / resize on externIndex* without going through
// RegisterExtern, so bucket-management bugs surface independently.
// Reuses mkVM / makeName from func_index_test.bn (same package).

func TestExternIndexEmptyLookup() testing.TestResult {
	var vm @VM = mkVM()
	if externIndexLookup(vm, "anything") != -1 {
		return "empty index must return -1"
	}
	return ""
}

func TestExternIndexInsertAndLookup() testing.TestResult {
	var vm @VM = mkVM()
	externIndexSet(vm, "alpha", 0)
	externIndexSet(vm, "beta", 1)
	externIndexSet(vm, "gamma", 2)
	if externIndexLookup(vm, "alpha") != 0 { return "alpha != 0" }
	if externIndexLookup(vm, "beta") != 1 { return "beta != 1" }
	if externIndexLookup(vm, "gamma") != 2 { return "gamma != 2" }
	if externIndexLookup(vm, "missing") != -1 {
		return "absent name must return -1"
	}
	return ""
}

func TestExternIndexReplace() testing.TestResult {
	var vm @VM = mkVM()
	externIndexSet(vm, "x", 7)
	if externIndexLookup(vm, "x") != 7 { return "first insert" }
	// Replace the same key — Idx update only, Count unchanged.
	var beforeCount int = vm.ExternIndexCount
	externIndexSet(vm, "x", 99)
	if externIndexLookup(vm, "x") != 99 { return "replace didn't update" }
	if vm.ExternIndexCount != beforeCount {
		return "Count changed on replace; should be stable"
	}
	return ""
}

// TestExternIndexResize forces several resizes by inserting more
// entries than the initial 256-slot capacity holds under the 75%
// load threshold; every name must remain findable after each rehash.
func TestExternIndexResize() testing.TestResult {
	var vm @VM = mkVM()
	var n int = 500
	for i := 0; i < n; i++ {
		externIndexSet(vm, makeName("k", i), i)
	}
	for i := 0; i < n; i++ {
		var got int = externIndexLookup(vm, makeName("k", i))
		if got != i {
			return "post-resize lookup mismatch"
		}
	}
	if vm.ExternIndexCount != n {
		return "Count != expected after bulk insert"
	}
	if vm.ExternIndexMask + 1 < n {
		return "capacity should have grown past initial 256"
	}
	return ""
}

// TestRegisterExternManyAmortized registers many externs through the
// public RegisterExtern path (the O(N²)→O(N) fix): all must be
// findable by their stable insertion index and ExternCount must equal
// the number of DISTINCT names (a re-registration replaces in place).
func TestRegisterExternManyAmortized() testing.TestResult {
	var vm @VM = mkVM()
	var n int = 400
	for i := 0; i < n; i++ {
		var fv fakeFV
		fv.Vt = i + 1
		fv.Data = i + 1
		vm.RegisterExtern(makeName("fn", i), bit_cast(*uint8, &fv), 0, 0)
	}
	if vm.ExternCount() != n {
		return "ExternCount != n after n distinct registrations"
	}
	for i := 0; i < n; i++ {
		if vm.LookupExtern(makeName("fn", i)) != i {
			return "LookupExtern index mismatch after amortized growth"
		}
	}
	// Re-register an existing name: replace in place, no growth.
	var fv2 fakeFV
	fv2.Vt = 1234
	fv2.Data = 5678
	vm.RegisterExtern(makeName("fn", 3), bit_cast(*uint8, &fv2), 0, 0)
	if vm.ExternCount() != n {
		return "re-registration must not grow the count"
	}
	if vm.LookupExtern(makeName("fn", 3)) != 3 {
		return "re-registration must keep the original index"
	}
	return ""
}
