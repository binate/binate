package "pkg/binate/vm"

import "pkg/binate/buf"
import "pkg/builtins/reflect"

// This file holds the VM's extern-registration MECHANISM — the
// package-level injection primitives (RegisterPackageFunctions /
// RegisterPackageGlobals / RegisterPackageVtables) and the VM's own
// cross-mode dispatch trampolines (RegisterVmTrampolines).  It does NOT
// decide WHICH packages a host registers: that policy (rt, reflect,
// the pkg/std set, and the standard-set bundling) lives in the
// host layer (pkg/binate/interp), so the VM stays an execution engine and
// does not bake in a standard library.  pkg/binate/vm's own unit tests get
// their externs from a test-local helper (extern_test_helpers_test.bn),
// since vm cannot import interp.

// scalarResult is the RetbufSize for a scalar / pointer / void return: 0,
// since RetbufSize carries the aggregate RETBUF size (nonzero) for
// retbuf-returning functions and 0 for scalars — the dispatcher's
// `> 0`-is-aggregate branch (see dispatchExternBinding).  The auto-enumerated
// package functions take their RetbufSize from FunctionInfo.RetbufSize
// (= AggregateReturnSize) instead; the hand-bound trampolines below — all
// scalar — use this constant.
const scalarResult int = 0

// RegisterPackageFunctions auto-enumerates a package's exported
// functions from its `__Package().Functions` table (the reflect
// FunctionInfo array emitted per module) and binds each into the VM's
// extern registry: one entry per `.bni`-exported func, keyed by the
// fully-qualified `FunctionInfo.Name`, with the func value taken from
// `FunctionInfo.Value` and the scalar/aggregate dispatch discriminator
// from `FunctionInfo.RetbufSize`.  This is the package-level injection
// primitive a host uses to bind a native package's whole exported
// surface (e.g. pkg/builtins/rt, or a native-only pkg/std package the VM
// can't interpret).
//
// `FunctionInfo.Value` is the static `&@__handle.<mangled>` {vtable,
// data} block (force-emitted for every exported func), so fvAddr and rawFnAddr below
// both point at the SAME block: RegisterExtern reads the vtable/data
// slots from fvAddr and copies the binding's owned handle from
// rawFnAddr, which are identical for a static handle.
//
// The table excludes extern (pure-C) functions — emit_pkg_descriptor
// skips IsExtern — so a package whose surface is entirely extern (a
// pure-C I/O shim layer) is NOT fully covered by this and needs
// its externs hand-bound separately.
//
// Some rt entries (_call_shim_scalar / _call_shim_aggregate /
// _call_dtor / _call_free_fn) are IR-magic intrinsics the compiler
// lowers directly to BC_CALL_INDIRECT / BC_CALL_FUNC_VALUE (see
// lower_call.bn) — they are NEVER dispatched by name through the
// registry, so registering them here (even with their >7-word raw
// shapes, which the registry dispatch can't carry) is inert: the
// binding for those names is simply never consulted.
func RegisterPackageFunctions(vmInst @VM, p @reflect.Package) {
	var fns *[]@reflect.FunctionInfo = p.Functions
	for i := 0; i < len(fns); i++ {
		var fi @reflect.FunctionInfo = fns[i]
		vmInst.RegisterExtern(fi.Name, fi.Value, fi.RetbufSize, bit_cast(int, fi.Value))
	}
}

// RegisterPackageGlobals binds an injected COMPILED package's exported globals
// to their native storage cells, so a bytecode cross-package read of a sentinel
// (e.g. `errors.NotFound`) resolves to the single native instance the package's
// own code roots in — the pointer identity `errors.Is` matches on.  Counterpart
// to RegisterPackageFunctions, called alongside it for every native-only
// injected package.  The global table it writes (via registerGlobalAddr) lives
// on `vmInst` (the VM's per-instance global registry).
func RegisterPackageGlobals(vmInst @VM, p @reflect.Package) {
	var gs *[]@reflect.GlobalInfo = p.Globals
	for i := 0; i < len(gs); i++ {
		var gi @reflect.GlobalInfo = gs[i]
		registerGlobalAddr(vmInst, gi.Name, bit_cast(int, gi.Addr))
	}
}

// RegisterPackageVtables binds each of a native-only injected package's
// interface-impl vtables (the descriptor's VtableInfo table) to its native
// `@__ivt` address via registerVtableAddr, so a bytecode-built interface value
// over the package's struct (BC_IFACE_VALUE) resolves the vtable instead of
// fatally missing the un-lowered vm.IfaceVtables (conformance 726).  Counterpart
// to RegisterPackageFunctions / RegisterPackageGlobals, called alongside them
// for every native-only injected package.  The registry it writes
// (registerVtableAddr) lives on `vmInst` (the VM's per-instance vtable registry).
func RegisterPackageVtables(vmInst @VM, p @reflect.Package) {
	var vts *[]@reflect.VtableInfo = p.Vtables
	for i := 0; i < len(vts); i++ {
		var vi @reflect.VtableInfo = vts[i]
		registerVtableAddr(vmInst, vi.Name, bit_cast(int, vi.Addr), bit_cast(int, vi.ShimAddr),
				vi.SlotCount)
	}
}

// RegisterPackageSatEntries binds each of a native-only injected package's
// interface-satisfaction facts (the descriptor's SatEntryInfo table) into the
// VM's per-instance satisfaction registry, so an interface assertion on an interface
// value the package handed the VM resolves the same way it would natively — the
// cross-mode analog of how a compiled binary's `__satentry.<T,J>` globals form
// the itab-style registry.  Counterpart to RegisterPackageFunctions /
// RegisterPackageGlobals / RegisterPackageVtables, called alongside them for
// every native-only injected package.
//
// Every identity record the package's code or entries name is bound to its native
// address under its NEUTRAL name in the data-symbol table (bindNativeIdentity;
// every package naming a record gives the one address the link coalesced it to),
// before any module is lowered:
//   - TYPE side: the scrutinee's dynamic type is read out of its native `@__ivt`
//     slot 1 (BC_IFACE_TYPEINFO returns that NATIVE `&TypeInfo(T)`), and a
//     concrete `x.(*T)` compares its canonical record against
//     `BC_DATA_SYM_ADDR(__typeinfo.<T>)`.  So bind the native `se.Type` under
//     se.TypeSym, and key the satentry on `se.Type`.  A native concrete assertion
//     site registers a `(T, any)` entry, so the record every native comparison
//     uses arrives here, and a box the VM makes of T carries it.
//   - IFACE side: an interface `x.(*J)` keys the lookup on `&__ifaceid.<J>`, in
//     the VM `BC_DATA_SYM_ADDR(__ifaceid.<J>)` (ensureIfaceIdSym).  Bind the native
//     marker of each J the package's code looks up (the IfaceIds table) and of each
//     entry's J (se.Iface), and key the entry on se.Iface, so the VM's lookups, the
//     entries it lowers for its own types and the native ones all key on the marker
//     an injected package's native code presents -- and native rt.SatLookup's
//     fallback into this registry (satFallbackFn), taken for a box of a bytecode
//     type, finds them.
// The name strings (IfaceIdInfo.Name, se.TypeSym / se.IfaceSym) are raw rodata
// slices, copied into owned storage for the session-lifetime tables.
func RegisterPackageSatEntries(vmInst @VM, p @reflect.Package) {
	var ids *[]@reflect.IfaceIdInfo = p.IfaceIds
	for i := 0; i < len(ids); i++ {
		bindNativeIdentity(vmInst, ids[i].Name, bit_cast(int, ids[i].Addr))
	}
	var ses *[]@reflect.SatEntryInfo = p.SatEntries
	for i := 0; i < len(ses); i++ {
		var se @reflect.SatEntryInfo = ses[i]
		bindNativeIdentity(vmInst, se.TypeSym, bit_cast(int, se.Type))
		bindNativeIdentity(vmInst, se.IfaceSym, bit_cast(int, se.Iface))
		registerSatEntry(vmInst, bit_cast(int, se.Type), bit_cast(int, se.Iface),
				bit_cast(int, se.Vtable))
	}
}

// bindNativeIdentity binds an injected package's identity record `sym` (a
// `__typeinfo.<T>` or `__ifaceid.<J>`) to its native address.  Several packages
// name the same record, every one at the single address the link coalesced it to,
// so a repeat is a no-op.  A binding to another address means a module was lowered
// -- making the VM's own record -- before the package was injected; the VM's boxes
// and lookups would then disagree with the package's native code, silently, so
// that is an internal error.
func bindNativeIdentity(vm @VM, sym *[]readonly char, addr int) {
	var existing int = lookupDataSymAddr(vm, sym)
	if existing == addr { return }
	if existing != 0 {
		vmPanicName("internal error: vm: a native identity record is bound elsewhere: ", sym)
	}
	dataSymInsert(vm, buf.CopyStr(sym), addr)
}

// RegisterVmTrampolines binds the universal cross-mode dispatch
// trampolines (TrampolineScalar / TrampolineAggregate) into the
// registry.  They are the VM's OWN functions (defined in this package),
// required for cross-mode dispatch by any host, so registering them is
// part of VM setup rather than host stdlib policy — the host calls this
// alongside its package registrations.
//
// Although both ARE `.bni`-exported (they live in pkg/binate/vm's own
// Functions table), they are NOT auto-enumerated via
// RegisterPackageFunctions: doing so would mean enumerating the ENTIRE
// pkg/binate/vm API as externs (the VM's whole exported surface), which
// is wrong — only these two functions are meant to be cross-mode
// dispatch targets.  So they stay hand-bound by name.
//
// Their `vtable.call` slot needs to hold the trampoline's NATIVE
// FUNCTION address — NOT its per-function shim — because the shim
// convention strips the implicit `data` parameter before calling the
// underlying function (correct for ordinary captured closures, but the
// trampolines need `data` as their closure-record argument; stripping
// it routes the user's first arg into the slot the trampoline expects
// the closure record at).  bnc emits __vt.<trampoline>.call directly at
// the function symbol (bypassing __shim) — see isUniversalTrampoline in
// pkg/binate/codegen/emit_funcvals.bn — so the standard registration
// below produces a binding whose vtable.call slot is the actual
// function, not __shim.*.
//
// Two paths populate the binding correctly depending on whether
// RegisterVmTrampolines runs natively or as bytecode:
//
//   (a) Native — `_func_handle` resolves to the function symbol; we
//       hand-build the binding directly with that address.
//   (b) Bytecode — `_func_handle` lowers to BC_FUNC_ADDR which
//       returns a 1-based vm idx (wrong), so we instead use the
//       standard `var ts *func(...) = TrampolineScalar;
//       RegisterExtern(...)` form.  At bytecode level that goes through
//       BC_FUNC_VALUE's Path B, which reads the executing vm's Externs
//       registry — already populated by the outermost native startup
//       via (a).  Net effect: the same native address propagates
//       downward via the standard Externs-copy mechanism.
func RegisterVmTrampolines(vmInst @VM) {
	var ts *func(*uint8, int, int, int, int, int, int, int) int = TrampolineScalar
	vmInst.RegisterExtern("pkg/binate/vm.TrampolineScalar", bit_cast(*uint8, &ts), scalarResult,
			bit_cast(int, _func_handle(TrampolineScalar)))
	var ta *func(*uint8, *uint8, int, int, int, int, int, int, int) = TrampolineAggregate
	vmInst.RegisterExtern("pkg/binate/vm.TrampolineAggregate", bit_cast(*uint8, &ta), scalarResult,
			bit_cast(int, _func_handle(TrampolineAggregate)))
	// TrampolineScalar64 returns int64 (r0:r1) for a VM func value whose result
	// is a bare 64-bit scalar on a <8-byte host; same shim-bypass rationale as
	// the other two (isUniversalTrampoline emits its __vt.call at the raw
	// function so `data` reaches it as the closure record).
	var ts64 *func(*uint8, int, int, int, int, int, int, int) int64 = TrampolineScalar64
	vmInst.RegisterExtern("pkg/binate/vm.TrampolineScalar64", bit_cast(*uint8, &ts64), scalarResult,
			bit_cast(int, _func_handle(TrampolineScalar64)))
	// TrampolinePacked is the uniform packed-int-slot bridge (vtable slot 2,
	// call_packed) every VM function value's slot-2 entry points at — the VM
	// caller uses it for any-shape cross-mode dispatch.  One entry serves all
	// return shapes (retbuf drives the aggregate path; the i64 return carries a
	// scalar), so unlike the slot-1 trampolines it needs no per-shape selection.
	var tp *func(*uint8, *int, int, *uint8) int64 = TrampolinePacked
	vmInst.RegisterExtern("pkg/binate/vm.TrampolinePacked", bit_cast(*uint8, &tp), scalarResult,
			bit_cast(int, _func_handle(TrampolinePacked)))
	// Install the native rt.SatLookup MISS fallback that routes an injected-native
	// `x.(*J)` on a bytecode-boxed value to this VM's satentry registry (process-
	// global in rt, keyed to the executing VM via g_crossModeVmAddr).  Part of VM
	// setup, like the trampolines above.
	InstallSatFallback()
}
