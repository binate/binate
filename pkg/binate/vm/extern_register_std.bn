package "pkg/binate/vm"

import "pkg/bootstrap"
import "pkg/builtins/reflect"
import "pkg/builtins/rt"

// scalarResult is the conventional ResultSize for scalar/pointer/void
// returns — the dispatcher's ≤ 8 branch.  Used by the hand-bound
// descriptor accessors, the bootstrap C-shaped surface, and the
// trampolines below; the auto-enumerated package functions take their
// ResultSize from FunctionInfo.ResultSize instead.
const scalarResult int = 8

// RegisterStandardExterns binds the host-package functions every
// pkg/binate/vm-using host needs.  It works in two layers:
//
//   1. registerPackageDescriptorExterns binds each builtin package's
//      compiler-synthesized `_Package()` accessor.  These MUST come
//      first: they are the bootstrap that makes the table enumeration
//      below reachable (a bytecode-level `pkg._Package()` call resolves
//      through the registry — see RegisterPackageFunctions).
//   2. RegisterPackageFunctions auto-enumerates a package's
//      `_Package().Functions` table (the reflect.FunctionInfo array B0
//      emits per module) and binds every exported function.  This is
//      the package-level injection that replaces the former
//      hand-maintained per-function rt registration block.
//
// pkg/bootstrap stays hand-bound (registerBootstrapExterns): its
// C-shaped surface is mostly extern, which the FunctionInfo table
// excludes (emit_pkg_functions skips IsExtern), and bootstrap is on the
// deprecation path — so rather than teach the table to enumerate
// externs for a package being removed, its whole set stays hand-bound
// as a temporary accommodation.  The universal trampolines likewise
// stay hand-bound (registerVmTrampolines) — see that function's doc.
//
// BC_FUNC_VALUE construction on every name here works in either native
// or bytecode dispatch contexts because execFuncRefOp's registry-
// fallback (vm_exec_funcref.bn) consults vm.Externs on LookupFunc miss.
//
// cmd/bni's main may layer further registrations (e.g.,
// progArgsAfterDash overriding bootstrap.Args).
func RegisterStandardExterns(vmInst @VM) {
	registerPackageDescriptorExterns(vmInst)
	RegisterPackageFunctions(vmInst, rt._Package())
	// reflect is interface-only — its Functions table is empty today,
	// so this is a no-op now, but enumerating it keeps the set uniform
	// and auto-picks-up any future exported reflect functions.
	RegisterPackageFunctions(vmInst, reflect._Package())
	registerBootstrapExterns(vmInst)
	registerVmTrampolines(vmInst)
}

// RegisterPackageFunctions auto-enumerates a package's exported
// functions from its `_Package().Functions` table (the reflect
// FunctionInfo array B0 emits per module) and binds each into the VM's
// extern registry: one entry per `.bni`-exported func, keyed by the
// fully-qualified `FunctionInfo.Name`, with the func value taken from
// `FunctionInfo.Value` and the scalar/aggregate dispatch discriminator
// from `FunctionInfo.ResultSize`.
//
// `FunctionInfo.Value` is the static `&@__handle.<mangled>` {vtable,
// data} block (force-emitted per B0), so fvAddr and rawFnAddr below
// both point at the SAME block: RegisterExtern reads the vtable/data
// slots from fvAddr and copies the binding's owned handle from
// rawFnAddr, which are identical for a static handle.
//
// The table excludes extern (pure-C) functions — emit_pkg_functions
// skips IsExtern — so a package whose surface is extern (e.g.
// pkg/bootstrap's C-shaped I/O) is NOT fully covered by this and needs
// its externs hand-bound separately.
//
// Some rt entries (_call_shim_scalar / _call_shim_aggregate /
// _call_dtor / _call_free_fn) are IR-magic intrinsics the compiler
// lowers directly to BC_CALL_INDIRECT / BC_CALL_FUNC_VALUE (see
// lower_call.bn) — they are NEVER dispatched by name through the
// registry, so registering them here (even with their >7-word raw
// shapes, which the registry dispatch can't carry) is inert: the
// binding for those names is simply never consulted.
func RegisterPackageFunctions(vmInst @VM, p @reflect.Package) {
	var fns *[]@reflect.FunctionInfo = p.Functions
	for i := 0; i < len(fns); i++ {
		var fi @reflect.FunctionInfo = fns[i]
		vmInst.RegisterExtern(fi.Name, fi.Value, fi.ResultSize,
			bit_cast(int, fi.Value))
	}
}

// RegisterPackageGlobals binds an injected COMPILED package's exported globals
// to their native storage cells, so a bytecode cross-package read of a sentinel
// (e.g. `errors.NotFound`) resolves to the single native instance the package's
// own code roots in — the pointer identity `errors.Is` matches on.  Counterpart
// to RegisterPackageFunctions, called alongside it for every native-only
// injected package.  `vmInst` is accepted for call-site symmetry; the global
// table it writes (via registerGlobalAddr) is module-level (see lower_data.bn).
func RegisterPackageGlobals(vmInst @VM, p @reflect.Package) {
	var gs *[]@reflect.GlobalInfo = p.Globals
	for i := 0; i < len(gs); i++ {
		var gi @reflect.GlobalInfo = gs[i]
		registerGlobalAddr(gi.Name, bit_cast(int, gi.Addr))
	}
}

// registerPackageDescriptorExterns binds each builtin package's
// compiler-synthesized `_Package() @reflect.Package` accessor (Phase B
// of notes-package-introspection.md) so interpreted code can call
// `pkg._Package()`.  These accessors are codegen-only (no `.bn` body)
// and are NOT `.bni`-exported, so they never appear in any package's
// own Functions table — they cannot be auto-enumerated and must be
// hand-bound here.  They are also load-bearing for the enumeration
// itself: RegisterPackageFunctions reaches `<pkg>._Package()` through
// these very bindings when it runs as bytecode in an outer VM.
//
// The front-end synthesizes their `func() @reflect.Package` type at the
// selector and accepts `_func_handle(pkg._Package)`, while bnc emits the
// `_Package` definition + its func-value triple per module.  The
// dispatch is a plain scalar (managed-pointer) return; the static-
// managed descriptor node's sentinel refcount makes the returned
// `@reflect.Package` safe to RefDec.
func registerPackageDescriptorExterns(vmInst @VM) {
	var rtPkg *func() @reflect.Package = rt._Package
	vmInst.RegisterExtern("pkg/builtins/rt._Package",
		bit_cast(*uint8, &rtPkg), scalarResult,
		bit_cast(int, _raw_func_addr(rt._Package)))
	var btPkg *func() @reflect.Package = bootstrap._Package
	vmInst.RegisterExtern("pkg/bootstrap._Package",
		bit_cast(*uint8, &btPkg), scalarResult,
		bit_cast(int, _raw_func_addr(bootstrap._Package)))
	var reflectPkg *func() @reflect.Package = reflect._Package
	vmInst.RegisterExtern("pkg/builtins/reflect._Package",
		bit_cast(*uint8, &reflectPkg), scalarResult,
		bit_cast(int, _raw_func_addr(reflect._Package)))
}

// registerBootstrapExterns binds pkg/bootstrap's surface.  bootstrap is
// native-only in the VM (cmd/bni skips lowering it), so EVERY
// bytecode-reachable bootstrap symbol must be registered or a bytecode
// `bootstrap.X` call hits execExtern's "extern not found":
//   - C-shaped I/O: scalar (Close, Exit, Open, Read, Write, Stat, Exec)
//     and aggregate-return (Args, ReadDir → @[]@[]char = 32 bytes).
//   - Format helpers (formatInt/Int64/Uint/Bool/Float) — pure Binate,
//     formerly run as bytecode; now native externs since the package
//     isn't lowered.  print/println lower to formatInt64 + Write, so
//     these are load-bearing for every print in the VM.
// Slice-arg entries flow through the aggregate-arg shim convention
// (emit_funcvals.bn — `i8*` + dereference); aggregate-return entries
// flow through the sret-aware shim path.  formatFloat takes a float64
// arg, dispatched via the all-int shim ABI (the shim int-ifies the
// float slot — see plan-float-arg-shim.md).
//
// Unlike rt, this set is NOT auto-enumerated from bootstrap's Functions
// table: the C-shaped I/O entries are extern (the table skips IsExtern),
// and bootstrap is on the deprecation path, so the whole set stays
// hand-bound as a temporary accommodation rather than special-casing
// the table for a package being removed.
func registerBootstrapExterns(vmInst @VM) {
	var btClose *func(int) int = bootstrap.Close
	vmInst.RegisterExtern("pkg/bootstrap.Close", bit_cast(*uint8, &btClose),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Close)))
	var btExit *func(int) = bootstrap.Exit
	vmInst.RegisterExtern("pkg/bootstrap.Exit", bit_cast(*uint8, &btExit),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Exit)))
	var btOpen *func(*[]readonly char, int) int = bootstrap.Open
	vmInst.RegisterExtern("pkg/bootstrap.Open", bit_cast(*uint8, &btOpen),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Open)))
	var btRead *func(int, *[]uint8) int = bootstrap.Read
	vmInst.RegisterExtern("pkg/bootstrap.Read", bit_cast(*uint8, &btRead),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Read)))
	var btWrite *func(int, *[]readonly uint8) int = bootstrap.Write
	vmInst.RegisterExtern("pkg/bootstrap.Write", bit_cast(*uint8, &btWrite),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Write)))
	var btStat *func(*[]readonly char) int = bootstrap.Stat
	vmInst.RegisterExtern("pkg/bootstrap.Stat", bit_cast(*uint8, &btStat),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Stat)))
	var btExec *func(*[]readonly char, *[]@[]char) int = bootstrap.Exec
	vmInst.RegisterExtern("pkg/bootstrap.Exec", bit_cast(*uint8, &btExec),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Exec)))
	var btArgs *func() @[]@[]char = bootstrap.Args
	vmInst.RegisterExtern("pkg/bootstrap.Args", bit_cast(*uint8, &btArgs),
		32, bit_cast(int, _raw_func_addr(bootstrap.Args)))
	var btReadDir *func(*[]readonly char) @[]@[]char = bootstrap.ReadDir
	vmInst.RegisterExtern("pkg/bootstrap.ReadDir", bit_cast(*uint8, &btReadDir),
		32, bit_cast(int, _raw_func_addr(bootstrap.ReadDir)))
	// Format helpers (native-only since bootstrap isn't lowered) — all
	// five return int (scalar).
	var btFormatInt *func(int, *[]uint8) int = bootstrap.formatInt
	vmInst.RegisterExtern("pkg/bootstrap.formatInt", bit_cast(*uint8, &btFormatInt),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.formatInt)))
	var btFormatInt64 *func(int64, *[]uint8) int = bootstrap.formatInt64
	vmInst.RegisterExtern("pkg/bootstrap.formatInt64", bit_cast(*uint8, &btFormatInt64),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.formatInt64)))
	var btFormatUint *func(uint64, *[]uint8) int = bootstrap.formatUint
	vmInst.RegisterExtern("pkg/bootstrap.formatUint", bit_cast(*uint8, &btFormatUint),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.formatUint)))
	var btFormatBool *func(bool, *[]uint8) int = bootstrap.formatBool
	vmInst.RegisterExtern("pkg/bootstrap.formatBool", bit_cast(*uint8, &btFormatBool),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.formatBool)))
	var btFormatFloat *func(float64, *[]uint8) int = bootstrap.formatFloat
	vmInst.RegisterExtern("pkg/bootstrap.formatFloat", bit_cast(*uint8, &btFormatFloat),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.formatFloat)))
}

// registerVmTrampolines binds the universal cross-mode dispatch
// trampolines (TrampolineScalar / TrampolineAggregate) into the
// registry.  Although both ARE `.bni`-exported (they live in
// pkg/binate/vm's own Functions table), they are NOT auto-enumerated
// via RegisterPackageFunctions: doing so would mean enumerating the
// ENTIRE pkg/binate/vm API as externs (the VM's whole exported surface),
// which is wrong — only these two functions are meant to be cross-mode
// dispatch targets.  So they stay hand-bound by name.
//
// Their `vtable.call` slot needs to hold the trampoline's NATIVE
// FUNCTION address — NOT its per-function shim — because the shim
// convention strips the implicit `data` parameter before calling the
// underlying function (correct for ordinary captured closures, but the
// trampolines need `data` as their closure-record argument; stripping
// it routes the user's first arg into the slot the trampoline expects
// the closure record at).  bnc emits __vt.<trampoline>.call directly at
// the function symbol (bypassing __shim) — see isUniversalTrampoline in
// pkg/binate/codegen/emit_funcvals.bn — so the standard registration
// below produces a binding whose vtable.call slot is the actual
// function, not __shim.*.  See `explorations/plan-uniform-native-fnptrs.md`.
//
// Two paths populate the binding correctly depending on whether
// registerVmTrampolines runs natively or as bytecode:
//
//   (a) Native — `_raw_func_addr` resolves to the function symbol; we
//       hand-build the binding directly with that address.
//   (b) Bytecode — `_raw_func_addr` lowers to BC_FUNC_ADDR which
//       returns a 1-based vm idx (wrong), so we instead use the
//       standard `var ts *func(...) = TrampolineScalar;
//       RegisterExtern(...)` form.  At bytecode level that goes through
//       BC_FUNC_VALUE's Path B, which reads the executing vm's Externs
//       registry — already populated by the outermost native startup
//       via (a).  Net effect: the same native address propagates
//       downward via the standard Externs-copy mechanism.
func registerVmTrampolines(vmInst @VM) {
	var ts *func(*uint8, int, int, int, int, int, int, int) int =
		TrampolineScalar
	vmInst.RegisterExtern("pkg/binate/vm.TrampolineScalar",
		bit_cast(*uint8, &ts), scalarResult,
		bit_cast(int, _raw_func_addr(TrampolineScalar)))
	var ta *func(*uint8, *uint8,
		int, int, int, int, int, int, int) = TrampolineAggregate
	vmInst.RegisterExtern("pkg/binate/vm.TrampolineAggregate",
		bit_cast(*uint8, &ta), scalarResult,
		bit_cast(int, _raw_func_addr(TrampolineAggregate)))
}
