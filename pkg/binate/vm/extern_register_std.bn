package "pkg/binate/vm"

import "pkg/bootstrap"
import "pkg/builtins/reflect"
import "pkg/builtins/rt"

// scalarResult is the conventional ResultSize for scalar/pointer/void
// returns — the dispatcher's ≤ 8 branch.  Aggregate (multi-word)
// returns pass their byte size explicitly: 32 for managed-slice
// (rt.MakeManagedSlice, bootstrap.Args / ReadDir results), 16 for raw
// slice or function value, etc.
const scalarResult int = 8

// RegisterStandardExterns binds the host-package functions every
// pkg/binate/vm-using host needs: pkg/builtins/rt's runtime (rt is
// native-only in the VM — see registerRtExterns) and pkg/bootstrap's
// C-shaped surface (including the slice-arg / aggregate-return entries
// that flow through the registry via emit_funcvals.bn's aggregate-arg +
// sret-aware shim machinery).
//
// BC_FUNC_VALUE construction on every name here works in either
// native or bytecode dispatch contexts because execFuncRefOp's
// registry-fallback (vm_exec_funcref.bn) consults vm.Externs on
// LookupFunc miss.
//
// cmd/bni's main may layer further registrations (e.g.,
// progArgsAfterDash overriding bootstrap.Args).
func RegisterStandardExterns(vmInst @VM) {
	registerRtExterns(vmInst)
	registerBootstrapExterns(vmInst)
	registerVmTrampolines(vmInst)
	registerPackageDescriptorExterns(vmInst)
}

// registerPackageDescriptorExterns binds each builtin package's
// compiler-synthesized `_Package() @reflect.Package` accessor (Phase B
// of notes-package-introspection.md) so interpreted code can call
// `pkg._Package()`.  These accessors are codegen-only (no `.bn` body);
// the front-end synthesizes their `func() @reflect.Package` type at the
// selector and accepts `_func_handle(pkg._Package)`, while bnc emits the
// `_Package` definition + its func-value triple per module.  The
// dispatch is a plain scalar (managed-pointer) return; the static-
// managed descriptor node's sentinel refcount makes the returned
// `@reflect.Package` safe to RefDec.
//
// This is the hand-maintained precursor to the full interop Functions-
// table (auto-enumerated per-package registration) — covering the
// builtin packages compiled into the host binary, whose `_Package` is a
// real symbol the shim can call.  User packages run as bytecode and have
// no `_Package` body; those await the table + cross-package registry.
func registerPackageDescriptorExterns(vmInst @VM) {
	var rtPkg *func() @reflect.Package = rt._Package
	vmInst.RegisterExtern("pkg/builtins/rt._Package",
		bit_cast(*uint8, &rtPkg), scalarResult,
		bit_cast(int, _raw_func_addr(rt._Package)))
	var btPkg *func() @reflect.Package = bootstrap._Package
	vmInst.RegisterExtern("pkg/bootstrap._Package",
		bit_cast(*uint8, &btPkg), scalarResult,
		bit_cast(int, _raw_func_addr(bootstrap._Package)))
	var reflectPkg *func() @reflect.Package = reflect._Package
	vmInst.RegisterExtern("pkg/builtins/reflect._Package",
		bit_cast(*uint8, &reflectPkg), scalarResult,
		bit_cast(int, _raw_func_addr(reflect._Package)))
}

// registerVmTrampolines binds the universal cross-mode dispatch
// trampolines (TrampolineScalar / TrampolineAggregate) into the
// registry.  Their `vtable.call` slot needs to hold the
// trampoline's NATIVE FUNCTION address — NOT its per-function
// shim — because the shim convention strips the implicit `data`
// parameter before calling the underlying function (correct for
// ordinary captured closures, but the trampolines need `data` as
// their closure-record argument; stripping it routes the user's
// first arg into the slot the trampoline expects the closure
// record at).  See `explorations/plan-uniform-native-fnptrs.md`.
//
// Two paths to populate the binding correctly depending on
// whether registerVmTrampolines runs natively or as bytecode:
//
//   (a) Native — `_raw_func_addr` resolves to the function
//       symbol; we hand-build the binding directly with that
//       address.
//   (b) Bytecode — `_raw_func_addr` lowers to BC_FUNC_ADDR which
//       returns a 1-based vm idx (wrong), so we instead use the
//       standard `var ts *func(...) = TrampolineScalar;
//       RegisterExtern(...)` form.  At bytecode level that goes
//       through BC_FUNC_VALUE's Path B, which reads the
//       executing vm's Externs registry — already populated by
//       the outermost native startup via (a).  Net effect: the
//       same native address propagates downward via the standard
//       Externs-copy mechanism the C-shaped bootstrap.* externs use.
//
// We dispatch on the magnitude of `_raw_func_addr` — real code-
// segment addresses are way above any plausible vm.Funcs index,
// so the test cleanly separates the two cases.  Native is the
// case that needs the hand-built override; bytecode skips that
// step and relies on the standard registration's Path B output.
func registerVmTrampolines(vmInst @VM) {
	// Path (b) — bytecode-safe registration that Path B reads
	// through.  Also runs at native, where it puts a shim-based
	// binding in place that the subsequent override below fixes.
	var ts *func(*uint8, int, int, int, int, int, int, int) int =
		TrampolineScalar
	vmInst.RegisterExtern("pkg/binate/vm.TrampolineScalar",
		bit_cast(*uint8, &ts), scalarResult,
		bit_cast(int, _raw_func_addr(TrampolineScalar)))
	var ta *func(*uint8, *uint8,
		int, int, int, int, int, int, int) = TrampolineAggregate
	vmInst.RegisterExtern("pkg/binate/vm.TrampolineAggregate",
		bit_cast(*uint8, &ta), scalarResult,
		bit_cast(int, _raw_func_addr(TrampolineAggregate)))

	// Phase 4 removed the hand-built override that was needed
	// before bnc started emitting __vt.<trampoline>.call directly
	// at the function symbol (bypassing __shim) — see
	// isUniversalTrampoline in pkg/binate/codegen/emit_funcvals.bn.  The
	// standard registration above now produces a correct binding
	// whose vtable.call slot is &TrampolineScalar / &TrampolineAggregate
	// (the actual functions, NOT __shim.* which would strip the
	// data argument the trampolines need as their closure record).
}

// registerRtExterns binds pkg/builtins/rt's bytecode-friendly surface into
// the registry.  All entries here have a Binate `.bn` body, so
// BC_FUNC_VALUE construction succeeds in either native or bytecode
// dispatch context.
func registerRtExterns(vmInst @VM) {
	var rtAlloc *func(int) *uint8 = rt.Alloc
	vmInst.RegisterExtern("pkg/builtins/rt.Alloc", bit_cast(*uint8, &rtAlloc),
		scalarResult, bit_cast(int, _raw_func_addr(rt.Alloc)))
	var rtFree *func(*uint8) = rt.Free
	vmInst.RegisterExtern("pkg/builtins/rt.Free", bit_cast(*uint8, &rtFree),
		scalarResult, bit_cast(int, _raw_func_addr(rt.Free)))
	var rtRefInc *func(*uint8) = rt.RefInc
	vmInst.RegisterExtern("pkg/builtins/rt.RefInc", bit_cast(*uint8, &rtRefInc),
		scalarResult, bit_cast(int, _raw_func_addr(rt.RefInc)))
	var rtRefDec *func(*uint8, *uint8) = rt.RefDec
	vmInst.RegisterExtern("pkg/builtins/rt.RefDec", bit_cast(*uint8, &rtRefDec),
		scalarResult, bit_cast(int, _raw_func_addr(rt.RefDec)))
	var rtRefcount *func(*uint8) int = rt.Refcount
	vmInst.RegisterExtern("pkg/builtins/rt.Refcount", bit_cast(*uint8, &rtRefcount),
		scalarResult, bit_cast(int, _raw_func_addr(rt.Refcount)))
	var rtBoundsCheck *func(int, int) = rt.BoundsCheck
	vmInst.RegisterExtern("pkg/builtins/rt.BoundsCheck", bit_cast(*uint8, &rtBoundsCheck),
		scalarResult, bit_cast(int, _raw_func_addr(rt.BoundsCheck)))
	var rtBox *func(*uint8, int) *uint8 = rt.Box
	vmInst.RegisterExtern("pkg/builtins/rt.Box", bit_cast(*uint8, &rtBox),
		scalarResult, bit_cast(int, _raw_func_addr(rt.Box)))
	var rtRawAlloc *func(int) *uint8 = rt.RawAlloc
	vmInst.RegisterExtern("pkg/builtins/rt.RawAlloc", bit_cast(*uint8, &rtRawAlloc),
		scalarResult, bit_cast(int, _raw_func_addr(rt.RawAlloc)))
	var rtRawAllocZero *func(int) *uint8 = rt.RawAllocZero
	vmInst.RegisterExtern("pkg/builtins/rt.RawAllocZero", bit_cast(*uint8, &rtRawAllocZero),
		scalarResult, bit_cast(int, _raw_func_addr(rt.RawAllocZero)))
	var rtRawFree *func(*uint8) = rt.RawFree
	vmInst.RegisterExtern("pkg/builtins/rt.RawFree", bit_cast(*uint8, &rtRawFree),
		scalarResult, bit_cast(int, _raw_func_addr(rt.RawFree)))
	var rtMemZero *func(*uint8, int) = rt.MemZero
	vmInst.RegisterExtern("pkg/builtins/rt.MemZero", bit_cast(*uint8, &rtMemZero),
		scalarResult, bit_cast(int, _raw_func_addr(rt.MemZero)))
	var rtMemCopy *func(*uint8, *readonly uint8, int) = rt.MemCopy
	vmInst.RegisterExtern("pkg/builtins/rt.MemCopy", bit_cast(*uint8, &rtMemCopy),
		scalarResult, bit_cast(int, _raw_func_addr(rt.MemCopy)))
	var rtBoundsFail *func(int, int) = rt.BoundsFail
	vmInst.RegisterExtern("pkg/builtins/rt.BoundsFail", bit_cast(*uint8, &rtBoundsFail),
		scalarResult, bit_cast(int, _raw_func_addr(rt.BoundsFail)))
	// DivCheck backs the OP_DIV_CHECK / BC_DIV_CHECK divide-fault guard.
	// The bytecode VM's BC_DIV_CHECK arm calls rt.DivCheck inline, so when
	// the VM itself runs as bytecode in an outer interpreter (int-int) that
	// call resolves through this extern — without the binding it falls to
	// execExtern's "extern not found".  Mirrors rt.BoundsCheck.
	var rtDivCheck *func(int64, int64, int64, int) = rt.DivCheck
	vmInst.RegisterExtern("pkg/builtins/rt.DivCheck", bit_cast(*uint8, &rtDivCheck),
		scalarResult, bit_cast(int, _raw_func_addr(rt.DivCheck)))
	// rt is native-only in the VM, so EVERY rt symbol reachable from
	// bytecode must be registered (bytecode rt.X misses LookupFunc and
	// falls to execExtern).  Exit and ZeroRefDestroy round out the set.
	var rtExit *func(int) = rt.Exit
	vmInst.RegisterExtern("pkg/builtins/rt.Exit", bit_cast(*uint8, &rtExit),
		scalarResult, bit_cast(int, _raw_func_addr(rt.Exit)))
	var rtZeroRefDestroy *func(*uint8, *uint8) = rt.ZeroRefDestroy
	vmInst.RegisterExtern("pkg/builtins/rt.ZeroRefDestroy", bit_cast(*uint8, &rtZeroRefDestroy),
		scalarResult, bit_cast(int, _raw_func_addr(rt.ZeroRefDestroy)))

	// Aggregate-return: rt.MakeManagedSlice returns a 32-byte
	// rt.ManagedSlice struct.  Routed through the aggregate-shim
	// path: in compiled mode, vtable.call points at the per-function
	// __shim.bn_pkg__builtins__rt__MakeManagedSlice (retbuf-style) emitted by
	// emit_funcvals.bn; in bytecode mode (when this helper itself
	// runs as bytecode in an outer VM), BC_FUNC_VALUE picks
	// TrampolineAggregate based on the VMFunc's ResultMultiWord
	// shape.  Either way, dispatchExternBinding's aggregate path
	// allocates retbuf, calls the shim, and returns the retbuf
	// address as the bytecode caller's aggregate-return value.
	var rtMS *func(int, int) rt.ManagedSlice = rt.MakeManagedSlice
	vmInst.RegisterExtern("pkg/builtins/rt.MakeManagedSlice", bit_cast(*uint8, &rtMS),
		32, bit_cast(int, _raw_func_addr(rt.MakeManagedSlice)))
}

// registerBootstrapExterns binds pkg/bootstrap's surface.  bootstrap is
// native-only in the VM (cmd/bni skips lowering it), so EVERY
// bytecode-reachable bootstrap symbol must be registered or a bytecode
// `bootstrap.X` call hits execExtern's "extern not found":
//   - C-shaped I/O: scalar (Close, Exit, Open, Read, Write, Stat, Exec)
//     and aggregate-return (Args, ReadDir → @[]@[]char = 32 bytes).
//   - Format helpers (formatInt/Int64/Uint/Bool/Float, Itoa) — pure
//     Binate, formerly run as bytecode; now native externs since the
//     package isn't lowered.  print/println lower to formatInt64 +
//     Write, so these are load-bearing for every print in the VM.
// Slice-arg entries flow through the aggregate-arg shim convention
// (emit_funcvals.bn — `i8*` + dereference); aggregate-return entries
// flow through the sret-aware shim path.  formatFloat takes a float64
// arg, dispatched via the all-int shim ABI (the shim int-ifies the
// float slot — see plan-float-arg-shim.md).
func registerBootstrapExterns(vmInst @VM) {
	var btClose *func(int) int = bootstrap.Close
	vmInst.RegisterExtern("pkg/bootstrap.Close", bit_cast(*uint8, &btClose),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Close)))
	var btExit *func(int) = bootstrap.Exit
	vmInst.RegisterExtern("pkg/bootstrap.Exit", bit_cast(*uint8, &btExit),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Exit)))
	var btOpen *func(*[]readonly char, int) int = bootstrap.Open
	vmInst.RegisterExtern("pkg/bootstrap.Open", bit_cast(*uint8, &btOpen),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Open)))
	var btRead *func(int, *[]uint8) int = bootstrap.Read
	vmInst.RegisterExtern("pkg/bootstrap.Read", bit_cast(*uint8, &btRead),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Read)))
	var btWrite *func(int, *[]readonly uint8) int = bootstrap.Write
	vmInst.RegisterExtern("pkg/bootstrap.Write", bit_cast(*uint8, &btWrite),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Write)))
	var btStat *func(*[]readonly char) int = bootstrap.Stat
	vmInst.RegisterExtern("pkg/bootstrap.Stat", bit_cast(*uint8, &btStat),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Stat)))
	var btExec *func(*[]readonly char, *[]@[]char) int = bootstrap.Exec
	vmInst.RegisterExtern("pkg/bootstrap.Exec", bit_cast(*uint8, &btExec),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Exec)))
	var btArgs *func() @[]@[]char = bootstrap.Args
	vmInst.RegisterExtern("pkg/bootstrap.Args", bit_cast(*uint8, &btArgs),
		32, bit_cast(int, _raw_func_addr(bootstrap.Args)))
	var btReadDir *func(*[]readonly char) @[]@[]char = bootstrap.ReadDir
	vmInst.RegisterExtern("pkg/bootstrap.ReadDir", bit_cast(*uint8, &btReadDir),
		32, bit_cast(int, _raw_func_addr(bootstrap.ReadDir)))
	// Format helpers (native-only since bootstrap isn't lowered).  Five
	// return int (scalar); Itoa returns @[]char (32-byte aggregate).
	var btFormatInt *func(int, *[]uint8) int = bootstrap.formatInt
	vmInst.RegisterExtern("pkg/bootstrap.formatInt", bit_cast(*uint8, &btFormatInt),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.formatInt)))
	var btFormatInt64 *func(int64, *[]uint8) int = bootstrap.formatInt64
	vmInst.RegisterExtern("pkg/bootstrap.formatInt64", bit_cast(*uint8, &btFormatInt64),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.formatInt64)))
	var btFormatUint *func(uint64, *[]uint8) int = bootstrap.formatUint
	vmInst.RegisterExtern("pkg/bootstrap.formatUint", bit_cast(*uint8, &btFormatUint),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.formatUint)))
	var btFormatBool *func(bool, *[]uint8) int = bootstrap.formatBool
	vmInst.RegisterExtern("pkg/bootstrap.formatBool", bit_cast(*uint8, &btFormatBool),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.formatBool)))
	var btFormatFloat *func(float64, *[]uint8) int = bootstrap.formatFloat
	vmInst.RegisterExtern("pkg/bootstrap.formatFloat", bit_cast(*uint8, &btFormatFloat),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.formatFloat)))
	var btItoa *func(int) @[]char = bootstrap.Itoa
	vmInst.RegisterExtern("pkg/bootstrap.Itoa", bit_cast(*uint8, &btItoa),
		32, bit_cast(int, _raw_func_addr(bootstrap.Itoa)))
}
