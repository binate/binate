package "pkg/binate/vm"

import "pkg/builtins/testing"

// Smoke test for RegisterStandardExterns.  Verifies that a freshly-
// created VM has no externs, and that calling
// RegisterStandardExterns adds bindings for the rt.* and bootstrap.*
// names the helper covers.  We don't enumerate every binding here —
// that would couple this test to the helper's binding list.  Instead we
// spot-check a representative sample (rt.Alloc, rt.Free, rt.Refcount)
// plus rt.Exit / rt.ZeroRefDestroy and the bootstrap format helpers
// specifically: rt AND bootstrap are native-only in the VM, so EVERY
// bytecode-reachable symbol must be registered or a call from bytecode
// hits execExtern's "extern not found".  Those were the registration
// gaps closed when each package went native-only, so they get explicit
// guards.
//
// End-to-end dispatch (registry → dispatchExternBinding →
// rt._call_shim_scalar → real callee) is verified by the conformance
// suite, which runs user programs that call rt externs through this
// path.

func TestRegisterStandardExternsPopulatesRegistry() testing.TestResult {
	var vm @VM = NewVM(64 * 1024)
	if len(vm.Externs) != 0 {
		return "fresh VM should have empty Externs"
	}
	RegisterStandardExterns(vm)
	if len(vm.Externs) == 0 {
		return "RegisterStandardExterns added no bindings"
	}
	if vm.LookupExtern("pkg/builtins/rt.Alloc") < 0 {
		return "pkg/builtins/rt.Alloc not registered"
	}
	if vm.LookupExtern("pkg/builtins/rt.Free") < 0 {
		return "pkg/builtins/rt.Free not registered"
	}
	if vm.LookupExtern("pkg/builtins/rt.Refcount") < 0 {
		return "pkg/builtins/rt.Refcount not registered"
	}
	if vm.LookupExtern("pkg/builtins/rt.Exit") < 0 {
		return "pkg/builtins/rt.Exit not registered (native-only rt needs it)"
	}
	if vm.LookupExtern("pkg/builtins/rt.ZeroRefDestroy") < 0 {
		return "pkg/builtins/rt.ZeroRefDestroy not registered (native-only rt needs it)"
	}
	// DivCheck backs the divide-fault guard; the bytecode VM's BC_DIV_CHECK
	// calls it inline, so under int-int (VM-as-bytecode) the call resolves
	// through this extern.  Missing it = "extern not found" on any runtime
	// division.
	if vm.LookupExtern("pkg/builtins/rt.DivCheck") < 0 {
		return "pkg/builtins/rt.DivCheck not registered (native-only rt needs it)"
	}
	// bootstrap is native-only too: spot-check a format helper (scalar)
	// and formatFloat (the only float-arg one, with no unit-test
	// coverage).  print/println lower to formatInt64 + Write, so a
	// missing format-helper binding breaks every print from bytecode.
	if vm.LookupExtern("pkg/bootstrap.formatInt") < 0 {
		return "pkg/bootstrap.formatInt not registered (native-only bootstrap needs it)"
	}
	if vm.LookupExtern("pkg/bootstrap.formatFloat") < 0 {
		return "pkg/bootstrap.formatFloat not registered (native-only bootstrap needs it)"
	}
	if vm.LookupExtern("not.a.real.extern") >= 0 {
		return "unrelated name found in registry"
	}
	return ""
}

// rt is now auto-enumerated from its FunctionInfo table
// (registerPackageFunctions), so the scalar/aggregate dispatch
// discriminator ExternBinding.ResultSize comes from
// FunctionInfo.ResultSize rather than a hand-coded literal.  Verify the
// table carries it correctly across the boundary dispatchExternBinding
// keys on: a scalar/pointer return (rt.Alloc) is 8 (≤8 → scalar shim),
// and the aggregate return (rt.MakeManagedSlice → 32-byte
// rt.ManagedSlice) is 32 (>8 → aggregate-retbuf path).  A wrong size
// here silently mis-dispatches every call to the function.
func TestRegisterPackageFunctionsCarriesResultSize() testing.TestResult {
	var vm @VM = NewVM(64 * 1024)
	RegisterStandardExterns(vm)
	var allocIdx int = vm.LookupExtern("pkg/builtins/rt.Alloc")
	if allocIdx < 0 { return "pkg/builtins/rt.Alloc not registered" }
	if vm.Externs[allocIdx].ResultSize != 8 {
		return "rt.Alloc (scalar) ResultSize should be 8 from the table"
	}
	var msIdx int = vm.LookupExtern("pkg/builtins/rt.MakeManagedSlice")
	if msIdx < 0 { return "pkg/builtins/rt.MakeManagedSlice not registered" }
	if vm.Externs[msIdx].ResultSize != 32 {
		return "rt.MakeManagedSlice (aggregate) ResultSize should be 32 "
			"from the table"
	}
	return ""
}

// Verifies registration is idempotent — calling
// RegisterStandardExterns twice doesn't grow the registry.
// Re-registration overwrites in place (per RegisterExtern's contract).
func TestRegisterStandardExternsIdempotent() testing.TestResult {
	var vm @VM = NewVM(64 * 1024)
	RegisterStandardExterns(vm)
	var nFirst int = len(vm.Externs)
	RegisterStandardExterns(vm)
	var nSecond int = len(vm.Externs)
	if nFirst != nSecond {
		return "second call grew the registry"
	}
	return ""
}

// Verifies the trampolines are registered with NATIVE function-
// pointer call slots — the property BC_FUNC_VALUE Path B
// (in a follow-up phase) will rely on for cross-mode dispatch.
// "Native" here means a value that isn't plausibly a 1-based VM
// function index: shim addresses live in the binary's code segment
// (typically > 0x100000000 on macOS arm64; > 0x400000 on Linux),
// well above any vm.Funcs.len.
func TestRegisterStandardExternsRegistersTrampolines() testing.TestResult {
	var vm @VM = NewVM(64 * 1024)
	RegisterStandardExterns(vm)
	var tsIdx int = vm.LookupExtern("pkg/binate/vm.TrampolineScalar")
	if tsIdx < 0 { return "vm.TrampolineScalar not registered" }
	var taIdx int = vm.LookupExtern("pkg/binate/vm.TrampolineAggregate")
	if taIdx < 0 { return "vm.TrampolineAggregate not registered" }

	// vtable.call must look like a code address.  Use len(vm.Funcs)
	// as the lower bound — any value below it is in the 1-based VM
	// idx range we're trying to eliminate as a possible call slot.
	// Native shim addresses are far above that.
	var tsBinding ExternBinding = vm.Externs[tsIdx]
	var tsVtable *int = bit_cast(*int, tsBinding.VtableAddr)
	if tsVtable[1] <= len(vm.Funcs) {
		return "TrampolineScalar.call slot is in 1-based-vm-idx range, not native"
	}

	var taBinding ExternBinding = vm.Externs[taIdx]
	var taVtable *int = bit_cast(*int, taBinding.VtableAddr)
	if taVtable[1] <= len(vm.Funcs) {
		return "TrampolineAggregate.call slot is in 1-based-vm-idx range, not native"
	}
	return ""
}
