package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/bootstrap"
import "pkg/builtins/reflect"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// registerTestExterns binds the standard host set the VM's own unit tests
// need: the builtin package descriptor accessors, rt's auto-enumerated
// functions, the pkg/bootstrap C-shaped surface (so print/println work
// from bytecode), and the VM's cross-mode trampolines.  This is the
// test-local counterpart to the host's production registration
// (pkg/binate/interp): the package-choice policy lives in interp, but vm
// cannot import interp (interp imports vm), so vm's tests roll their own
// set here via the same vm mechanism (RegisterPackageFunctions /
// RegisterVmTrampolines + hand-bound bootstrap externs).  (bootstrap.Args is
// no longer bound: argv reaches an interpreted program via os.Args, which
// cmd/bni installs through os.SetArgs — design-os-args-vm.md.)
func registerTestExterns(vmInst @VM) {
	registerTestDescriptorExterns(vmInst)
	RegisterPackageFunctions(vmInst, rt.__Package())
	RegisterPackageFunctions(vmInst, reflect.__Package())
	registerTestBootstrapExterns(vmInst)
	RegisterVmTrampolines(vmInst)
}

// registerTestDescriptorExterns binds the builtin packages'
// compiler-synthesized `__Package()` accessors so interpreted code can
// call `pkg.__Package()`.  These accessors are codegen-only (no `.bn`
// body) and not `.bni`-exported, so they never appear in any package's
// own Functions table and must be hand-bound.  They are also load-bearing
// for the enumeration itself: RegisterPackageFunctions reaches
// `<pkg>.__Package()` through these bindings when it runs as bytecode in an
// outer VM.
func registerTestDescriptorExterns(vmInst @VM) {
	var rtPkg *func() @reflect.Package = rt.__Package
	vmInst.RegisterExtern("pkg/builtins/rt.__Package", bit_cast(*uint8, &rtPkg), scalarResult,
			bit_cast(int, _func_handle(rt.__Package)))
	var btPkg *func() @reflect.Package = bootstrap.__Package
	vmInst.RegisterExtern("pkg/bootstrap.__Package", bit_cast(*uint8, &btPkg), scalarResult,
			bit_cast(int, _func_handle(bootstrap.__Package)))
	var reflectPkg *func() @reflect.Package = reflect.__Package
	vmInst.RegisterExtern("pkg/builtins/reflect.__Package", bit_cast(*uint8, &reflectPkg),
			scalarResult, bit_cast(int, _func_handle(reflect.__Package)))
}

// registerTestBootstrapExterns binds pkg/bootstrap's surface for the VM's
// own tests.  bootstrap is native-only in the VM, so EVERY
// bytecode-reachable bootstrap symbol must be registered or a bytecode
// `bootstrap.X` call hits execExtern's "extern not found": process control
// (Exec) and the print/println lowering's I/O sink (Write) plus
// its formatInt64/formatFloat/... helpers.  (General file I/O moved to
// pkg/std/os; bootstrap's Open/Read/Close/Stat/ReadDir surface was retired.)
func registerTestBootstrapExterns(vmInst @VM) {
	var btWrite *func(int, *[]readonly uint8) int = bootstrap.Write
	vmInst.RegisterExtern("pkg/bootstrap.Write", bit_cast(*uint8, &btWrite), scalarResult,
			bit_cast(int, _func_handle(bootstrap.Write)))
	var btExec *func(*[]readonly char, *[]@[]char) int = bootstrap.Exec
	vmInst.RegisterExtern("pkg/bootstrap.Exec", bit_cast(*uint8, &btExec), scalarResult,
			bit_cast(int, _func_handle(bootstrap.Exec)))
	var btFormatInt *func(int, *[]uint8) int = bootstrap.formatInt
	vmInst.RegisterExtern("pkg/bootstrap.formatInt", bit_cast(*uint8, &btFormatInt), scalarResult,
			bit_cast(int, _func_handle(bootstrap.formatInt)))
	var btFormatInt64 *func(int64, *[]uint8) int = bootstrap.formatInt64
	vmInst.RegisterExtern("pkg/bootstrap.formatInt64", bit_cast(*uint8, &btFormatInt64), scalarResult,
			bit_cast(int, _func_handle(bootstrap.formatInt64)))
	var btFormatUint *func(uint64, *[]uint8) int = bootstrap.formatUint
	vmInst.RegisterExtern("pkg/bootstrap.formatUint", bit_cast(*uint8, &btFormatUint), scalarResult,
			bit_cast(int, _func_handle(bootstrap.formatUint)))
	var btFormatBool *func(bool, *[]uint8) int = bootstrap.formatBool
	vmInst.RegisterExtern("pkg/bootstrap.formatBool", bit_cast(*uint8, &btFormatBool), scalarResult,
			bit_cast(int, _func_handle(bootstrap.formatBool)))
	var btFormatFloat *func(float64, *[]uint8) int = bootstrap.formatFloat
	vmInst.RegisterExtern("pkg/bootstrap.formatFloat", bit_cast(*uint8, &btFormatFloat), scalarResult,
			bit_cast(int, _func_handle(bootstrap.formatFloat)))
}

// Smoke test for registerTestExterns.  Verifies that a freshly-created VM
// has no externs, and that the helper adds bindings for the rt.* and
// bootstrap.* names it covers.  We don't enumerate every binding — that
// would couple this test to the helper's binding list.  Instead we
// spot-check a representative sample (rt.Alloc, rt.Free, rt.Refcount)
// plus rt.Exit / rt.ZeroRefDestroy and the bootstrap format helpers
// specifically: rt AND bootstrap are native-only in the VM, so EVERY
// bytecode-reachable symbol must be registered or a call from bytecode
// hits execExtern's "extern not found".
//
// End-to-end dispatch (registry → dispatchExternBinding →
// rt._call_shim_scalar → real callee) is verified by the conformance
// suite, which runs user programs that call rt externs through this path.
func TestRegisterTestExternsPopulatesRegistry() testing.TestResult {
	var vm @VM = NewVM(64 * 1024)
	if len(vm.Externs) != 0 {
		return "fresh VM should have empty Externs"
	}
	registerTestExterns(vm)
	if len(vm.Externs) == 0 {
		return "registerTestExterns added no bindings"
	}
	if vm.LookupExtern("pkg/builtins/rt.Alloc") < 0 {
		return "pkg/builtins/rt.Alloc not registered"
	}
	if vm.LookupExtern("pkg/builtins/rt.Free") < 0 {
		return "pkg/builtins/rt.Free not registered"
	}
	if vm.LookupExtern("pkg/builtins/rt.Refcount") < 0 {
		return "pkg/builtins/rt.Refcount not registered"
	}
	if vm.LookupExtern("pkg/builtins/rt.Exit") < 0 {
		return "pkg/builtins/rt.Exit not registered (native-only rt needs it)"
	}
	if vm.LookupExtern("pkg/builtins/rt.ZeroRefDestroy") < 0 {
		return "pkg/builtins/rt.ZeroRefDestroy not registered (native-only rt needs it)"
	}
	// DivCheck backs the divide-fault guard; the bytecode VM's BC_DIV_CHECK
	// calls it inline, so under int-int (VM-as-bytecode) the call resolves
	// through this extern.  Missing it = "extern not found" on any runtime
	// division.
	if vm.LookupExtern("pkg/builtins/rt.DivCheck") < 0 {
		return "pkg/builtins/rt.DivCheck not registered (native-only rt needs it)"
	}
	// bootstrap is native-only too: spot-check a format helper (scalar)
	// and formatFloat (the only float-arg one, with no unit-test
	// coverage).  print/println lower to formatInt64 + Write, so a
	// missing format-helper binding breaks every print from bytecode.
	if vm.LookupExtern("pkg/bootstrap.formatInt") < 0 {
		return "pkg/bootstrap.formatInt not registered (native-only bootstrap needs it)"
	}
	if vm.LookupExtern("pkg/bootstrap.formatFloat") < 0 {
		return "pkg/bootstrap.formatFloat not registered (native-only bootstrap needs it)"
	}
	if vm.LookupExtern("not.a.real.extern") >= 0 {
		return "unrelated name found in registry"
	}
	return ""
}

// rt is auto-enumerated from its FunctionInfo table
// (RegisterPackageFunctions), so the scalar/aggregate dispatch
// discriminator ExternBinding.RetbufSize comes from
// FunctionInfo.RetbufSize (= types.AggregateReturnSize) rather than a
// hand-coded literal.  Verify the table carries it correctly across the
// boundary dispatchExternBinding keys on: a scalar/pointer return
// (rt.Alloc) is 0 (no retbuf → scalar shim), and the aggregate return
// (rt.MakeManagedSlice → 32-byte rt.ManagedSlice) is 32 (the retbuf byte
// size → aggregate-retbuf path).  A wrong size here silently mis-dispatches
// every call to the function.
func TestRegisterPackageFunctionsCarriesRetbufSize() testing.TestResult {
	var vm @VM = NewVM(64 * 1024)
	RegisterPackageFunctions(vm, rt.__Package())
	var allocIdx int = vm.LookupExtern("pkg/builtins/rt.Alloc")
	if allocIdx < 0 { return "pkg/builtins/rt.Alloc not registered" }
	if vm.Externs[allocIdx].RetbufSize != 0 {
		return "rt.Alloc (scalar pointer) RetbufSize should be 0 (no retbuf)"
	}
	var msIdx int = vm.LookupExtern("pkg/builtins/rt.MakeManagedSlice")
	if msIdx < 0 { return "pkg/builtins/rt.MakeManagedSlice not registered" }
	// A managed-slice is 4 target words, so its retbuf byte size is target-
	// dependent (LP64 32, ILP32 16) — derive it from the type rather than
	// hardcoding the LP64 value.
	var wantMs int = types.MakeManagedSliceType(types.TypUint8()).SizeOf()
	if vm.Externs[msIdx].RetbufSize != wantMs {
		return "rt.MakeManagedSlice (aggregate) RetbufSize should be the "
				"managed-slice retbuf byte size"
	}
	return ""
}

// Verifies registration is idempotent — calling registerTestExterns
// twice doesn't grow the registry.  Re-registration overwrites in place
// (per RegisterExtern's contract).
func TestRegisterTestExternsIdempotent() testing.TestResult {
	var vm @VM = NewVM(64 * 1024)
	registerTestExterns(vm)
	var nFirst int = len(vm.Externs)
	registerTestExterns(vm)
	var nSecond int = len(vm.Externs)
	if nFirst != nSecond {
		return "second call grew the registry"
	}
	return ""
}

// Verifies the trampolines are registered with NATIVE function-
// pointer call slots — the property BC_FUNC_VALUE Path B relies on for
// cross-mode dispatch.  "Native" here means a value that isn't plausibly
// a 1-based VM function index: shim addresses live in the binary's code
// segment (typically > 0x100000000 on macOS arm64; > 0x400000 on Linux),
// well above any vm.Funcs.len.
func TestRegisterVmTrampolinesNativeSlots() testing.TestResult {
	var vm @VM = NewVM(64 * 1024)
	RegisterVmTrampolines(vm)
	var tsIdx int = vm.LookupExtern("pkg/binate/vm.TrampolineScalar")
	if tsIdx < 0 { return "vm.TrampolineScalar not registered" }
	var taIdx int = vm.LookupExtern("pkg/binate/vm.TrampolineAggregate")
	if taIdx < 0 { return "vm.TrampolineAggregate not registered" }

	// vtable.call must look like a code address.  Use vm.Funcs.Len()
	// as the lower bound — any value below it is in the 1-based VM
	// idx range we're trying to eliminate as a possible call slot.
	// Native shim addresses are far above that.
	var tsBinding ExternBinding = vm.Externs[tsIdx]
	var tsVtable *int = bit_cast(*int, tsBinding.VtableAddr)
	if tsVtable[1] <= vm.Funcs.Len() {
		return "TrampolineScalar.call slot is in 1-based-vm-idx range, not native"
	}

	var taBinding ExternBinding = vm.Externs[taIdx]
	var taVtable *int = bit_cast(*int, taBinding.VtableAddr)
	if taVtable[1] <= vm.Funcs.Len() {
		return "TrampolineAggregate.call slot is in 1-based-vm-idx range, not native"
	}
	return ""
}
