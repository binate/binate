package "pkg/binate/vm"

// handleExternIdx returns the vm.Externs index of the binding a BC_FUNC_HANDLE
// naming f.Names[aux] resolves to — a registered extern that carries a handle —
// or -1 when the handle comes from a VM function instead.  The answer is
// memoized per site in f.HandleCache and reused while vm.externGen is
// unchanged: RegisterExtern is the only write to vm.Externs (an append, or a
// replace that may add or drop the handle), and it bumps externGen.  A managed
// pointer's RefDec takes its dtor handle through BC_FUNC_HANDLE, so an
// unmemoized lookup would probe the extern name table on every release of a
// struct with a dtor, nearly always to find nothing.  lowerFunc allocates the
// memo (newHandleCache), so this allocates nothing.
func handleExternIdx(vm @VM, f @VMFunc, aux int) int {
	var gen int = vm.externGen + 1
	if f.HandleCache[2 * aux] == gen {
		return f.HandleCache[2 * aux + 1]
	}
	var eIdx int = vm.LookupExtern(f.Names[aux])
	if eIdx >= 0 && vm.Externs[eIdx].HandleAddr == nil {
		eIdx = -1
	}
	f.HandleCache[2 * aux] = gen
	f.HandleCache[2 * aux + 1] = eIdx
	return eIdx
}

// newHandleCache returns the HandleCache for a function with the given code and
// nNames names: two words per name, all unresolved, when the code holds a
// BC_FUNC_HANDLE, and nothing otherwise.  It is allocated at lowering, not on a
// site's first execution: the VM shares the program's heap, so a block the VM
// allocated while the program runs would count in the program's own live-block
// accounting (rt.LiveBlocks) as if the program had leaked it.
func newHandleCache(code *[]BCInstr, nNames int) @[]int {
	var none @[]int
	for i := 0; i < len(code); i++ {
		if code[i].Op == BC_FUNC_HANDLE {
			return make_slice(int, 2 * nNames)
		}
	}
	return none
}
