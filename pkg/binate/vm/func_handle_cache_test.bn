package "pkg/binate/vm"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// handleTestModule builds `func target(p *uint8) {}` and `func main() *uint8 {
// return <handle of target> }`, so main's result is whatever BC_FUNC_HANDLE
// resolves "test.target" to.
func handleTestModule() @ir.Module {
	var m @ir.Module = ir.NewModule("\"test\"")
	var u8Ptr @types.Type = types.MakePointerType(types.TypUint8())
	var targetParams @[]@ir.Param = make_slice(@ir.Param, 1)
	targetParams[0] = make(ir.Param)
	targetParams[0].Name = "p"
	targetParams[0].Typ = u8Ptr
	targetParams[0].ID = 0
	var noResults @[]@types.Type
	var target @ir.Func = ir.NewFunc("", "target", targetParams, noResults)
	target.NextID = 1
	var noRet @[]@ir.Instr
	irbuild.EmitReturn(ir.AddBlock(target, "entry"), noRet)
	m.AddFunc(target)

	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = u8Ptr
	var mainFn @ir.Func = ir.NewFunc("", "main", noParams, results)
	var entry @ir.Block = ir.AddBlock(mainFn, "entry")
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = irbuild.EmitFuncHandle(entry, "target")
	irbuild.EmitReturn(entry, retArgs)
	m.AddFunc(mainFn)
	return m
}

// funcHandleAux returns the name-table index of the first BC_FUNC_HANDLE in
// fn's code, or -1.
func funcHandleAux(fn @VMFunc) int {
	for i := 0; i < len(fn.Code); i++ {
		if fn.Code[i].Op == BC_FUNC_HANDLE {
			return fn.Code[i].Aux
		}
	}
	return -1
}

// TestFuncHandleCacheFollowsRegisterExtern pins handleExternIdx's memo: a
// BC_FUNC_HANDLE site resolves to the VM function's handle while no extern
// carries the name, keeps that answer across executions, switches to the
// extern's handle once RegisterExtern binds the name with one, and switches
// back when a replace drops the handle.  A memo that outlived a RegisterExtern
// would keep returning the first answer.  The memo is allocated by lowering,
// and only for a function with a BC_FUNC_HANDLE: executing a site must not
// allocate, since the VM's blocks count in the program's rt.LiveBlocks.
func TestFuncHandleCacheFollowsRegisterExtern() testing.TestResult {
	var vm @VM = newTestVM(testVMStackSize)
	// A VM function's handle dispatches through the VM's trampolines.
	RegisterVmTrampolines(vm)
	vm.LowerModule(handleTestModule())
	var mainIdx int = vm.LookupFunc("test.main")
	var targetIdx int = vm.LookupFunc("test.target")
	if mainIdx < 0 || targetIdx < 0 { return "test.main / test.target not found" }
	var mainFn @VMFunc = vm.Funcs.Get(mainIdx)
	var aux int = funcHandleAux(mainFn)
	if aux < 0 { return "expected a BC_FUNC_HANDLE in test.main" }
	var lowered @[]int = mainFn.HandleCache
	if len(lowered) != 2 * len(mainFn.Names) || lowered[2 * aux] != 0 {
		return "expected lowering to allocate the site's memo, unresolved"
	}
	if len(vm.Funcs.Get(targetIdx).HandleCache) != 0 {
		return "expected no memo for a function without a BC_FUNC_HANDLE"
	}
	var noArgs @[]int

	var first int64 = execFunc(vm, mainIdx, noArgs)
	var vmHandle int64 = cast(int64, bit_cast(int, vm.Funcs.Get(targetIdx).Handle))
	if vmHandle == 0 || first != vmHandle {
		return "expected the VM function's handle before any extern is registered"
	}
	if len(mainFn.HandleCache) != 2 * len(mainFn.Names) ||
			mainFn.HandleCache[2 * aux] != vm.externGen + 1 || mainFn.HandleCache[2 * aux + 1] != -1 {
		return "expected the site's resolution memoized as no-extern for the current generation"
	}
	if execFunc(vm, mainIdx, noArgs) != vmHandle {
		return "expected the memoized resolution to give the VM function's handle again"
	}
	if !same(lowered, mainFn.HandleCache) {
		return "expected executing the site to keep the memo lowering allocated"
	}

	var fv fakeFV
	fv.Vt = 0x0AFE0001
	fv.Data = 0x0AFE0002
	vm.RegisterExtern("test.target", bit_cast(*uint8, &fv), 0, bit_cast(int, &fv))
	var eIdx int = vm.LookupExtern("test.target")
	if eIdx < 0 || vm.Externs[eIdx].HandleAddr == nil {
		return "expected test.target bound with a handle"
	}
	var externHandle int64 = cast(int64, bit_cast(int, vm.Externs[eIdx].HandleAddr))
	if execFunc(vm, mainIdx, noArgs) != externHandle {
		return "expected the extern's handle once RegisterExtern binds the name with one"
	}

	vm.RegisterExtern("test.target", bit_cast(*uint8, &fv), 0, 0)
	if execFunc(vm, mainIdx, noArgs) != vmHandle {
		return "expected the VM function's handle again once a replace drops the extern's handle"
	}
	return ""
}
