package "pkg/binate/vm"

import "pkg/binate/vmdata"

import "pkg/std/table"

// The per-VM name→index tables (FuncIndex / ExternIndex / DataSymIndex on @VM)
// are stdlib table.Table[*[]readonly char, int, VmNameHasher, VmNameEq] — the
// shared open-addressing engine under the zero-size VmNameHasher / VmNameEq
// policies, so hash/equality stay DIRECT (inlinable) calls.  This file holds the
// shared hash/eq (hashName / nameEq and the policy methods over them) plus the
// vm.Funcs table's accessors; extern_index.bn / datasym_index.bn are the
// vm.Externs / dataSymNames analogs.
//
// Each table maps a qualified name to an index in the corresponding store
// (vm.Funcs / vm.Externs / dataSymNames).  The *[]readonly char key borrows that
// store's owned @[]char name, so the name must outlive the table.  The stores are
// append-only — names are never freed — with ONE exception: LowerOneFunc's
// same-signature REPL redefinition REPLACES a vm.Funcs entry in place (Set),
// dropping the old VMFunc and its Name backing.  That path re-Puts the name (see
// lower.bn) BEFORE the Set, so table.Put's key refresh re-points the stored key at
// the replacement's live Name while the old backing is still valid to probe
// against.  vm.Externs' replace path leaves the entry's Name untouched, so its key
// stays valid without a re-Put.

// funcIndexLookup returns the vm.Funcs index for `name`, or -1 if not present.
func funcIndexLookup(vm @VM, name *[]readonly char) int {
	if vm.FuncIndex == nil { return -1 }
	var idx int
	var ok bool
	idx, ok = vm.FuncIndex.Get(name)
	if ok { return idx }
	return -1
}

// funcIndexSet records `name -> vmIdx`, replacing any existing mapping.  Creates
// the table on first call.  `name` is BORROWED — the table stores the raw
// *[]readonly char, so its backing must outlive the table: real callers pass
// vm.Funcs' owned VMFunc.Name (kept by the append-only Funcs), and a string
// literal aliases immortal rodata.  (A borrow param, not @[]char, so a literal
// arg is NOT copied to a mortal heap slice that would free out from under the
// stored key at end of statement.)
func funcIndexSet(vm @VM, name *[]readonly char, vmIdx int) {
	if vm.FuncIndex == nil {
		vm.FuncIndex = table.NewTable[*[]readonly char, int, vmdata.VmNameHasher, vmdata.VmNameEq](
				vmdata.VmNameHasher{}, vmdata.VmNameEq{})
	}
	vm.FuncIndex.Put(name, vmIdx)
}
