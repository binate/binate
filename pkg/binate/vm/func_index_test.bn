package "pkg/binate/vm"

import "pkg/builtins/testing"
import "pkg/std/strconv"

// Direct unit coverage for the per-VM name→idx hash.  These
// exercise the hash without going through LowerModule /
// LowerOneFunc, so any bucket-management bugs (resize, replace,
// linear-probe wraparound) surface independently of the lowerer.

func mkVM() @VM {
	return NewVM(64 * 1024)
}

func TestFuncIndexEmptyLookup() testing.TestResult {
	var vm @VM = mkVM()
	if funcIndexLookup(vm, "anything") != -1 {
		return "empty index must return -1"
	}
	return ""
}

func TestFuncIndexInsertAndLookup() testing.TestResult {
	var vm @VM = mkVM()
	funcIndexSet(vm, "alpha", 0)
	funcIndexSet(vm, "beta", 1)
	funcIndexSet(vm, "gamma", 2)
	if funcIndexLookup(vm, "alpha") != 0 { return "alpha != 0" }
	if funcIndexLookup(vm, "beta") != 1 { return "beta != 1" }
	if funcIndexLookup(vm, "gamma") != 2 { return "gamma != 2" }
	if funcIndexLookup(vm, "missing") != -1 {
		return "absent name must return -1"
	}
	return ""
}

func TestFuncIndexReplace() testing.TestResult {
	var vm @VM = mkVM()
	funcIndexSet(vm, "x", 7)
	if funcIndexLookup(vm, "x") != 7 { return "first insert" }
	// Replace the same key — Idx update only, Count unchanged.
	var beforeCount int = vm.IndexCount
	funcIndexSet(vm, "x", 99)
	if funcIndexLookup(vm, "x") != 99 { return "replace didn't update" }
	if vm.IndexCount != beforeCount {
		return "Count changed on replace; should be stable"
	}
	return ""
}

// TestFuncIndexResize forces several resizes by inserting more
// entries than the initial 256-slot capacity can hold under the
// 75% load threshold.  Verifies every name is still findable
// after the rehash.
func TestFuncIndexResize() testing.TestResult {
	var vm @VM = mkVM()
	var n int = 500
	for i := 0; i < n; i++ {
		funcIndexSet(vm, makeName("k", i), i)
	}
	// All entries must still be findable.
	for i := 0; i < n; i++ {
		var got int = funcIndexLookup(vm, makeName("k", i))
		if got != i {
			return "post-resize lookup mismatch"
		}
	}
	if vm.IndexCount != n {
		return "Count != expected after bulk insert"
	}
	if vm.IndexMask + 1 < n {
		return "capacity should have grown past initial 256"
	}
	return ""
}

// makeName builds "<prefix><i>" as @[]char.
func makeName(prefix *[]readonly char, i int) @[]char {
	var digits @[]char = strconv.Itoa(i)
	var out @[]char = make_slice(char, len(prefix) + len(digits))
	for j := 0; j < len(prefix); j++ { out[j] = prefix[j] }
	for j := 0; j < len(digits); j++ {
		out[len(prefix) + j] = digits[j]
	}
	return out
}
