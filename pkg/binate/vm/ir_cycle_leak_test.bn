package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropt"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A dropped module frees its IR.  Branch targets and phi predecessors are raw
// references (the function owns its blocks), so neither a loop's back edge nor a
// phi's predecessor closes a reference cycle that would keep a function's blocks
// and instructions alive forever.  Each check builds the module once first:
// that first build interns types and names the later ones reuse.

// cycleLoopSrc has a loop (a back edge) and no phi until mem2reg runs.
func cycleLoopSrc() *[]readonly char {
	return "package \"test\"\n"
			"func f(n int) int {\n"
			"\tvar s int = 0\n"
			"\tfor i := 0; i < n; i++ {\n"
			"\t\ts = s + i\n"
			"\t}\n"
			"\treturn s\n"
			"}\n"
}

// cycleMergeSrc is loop-free; mem2reg places a phi at the if/else merge, and at
// -O2 the inliner clones the multi-block g into h.
func cycleMergeSrc() *[]readonly char {
	return "package \"test\"\n"
			"func g(c bool, a int) int {\n"
			"\tvar r int = a\n"
			"\tif c {\n\t\tr = a * 2\n\t} else {\n\t\tr = a + 1\n\t}\n"
			"\treturn r + 3\n"
			"}\n"
			"func h(a int) int {\n"
			"\treturn g(a > 2, a) + g(false, a)\n"
			"}\n"
}

// buildDropGrowth returns the rt.LiveBlocks() growth across building src's
// module, optimizing it with c, lowering it into a VM when lower is set, and
// dropping it all.
func buildDropGrowth(src *[]readonly char, c iropt.OptConfig, lower bool) int {
	var before int = rt.LiveBlocks()
	buildDropScope(src, c, lower)
	return rt.LiveBlocks() - before
}

// buildDropScope holds the module (and VM), so both drop when it returns.
func buildDropScope(src *[]readonly char, c iropt.OptConfig, lower bool) {
	var m @ir.Module = genModule(src)
	if lower {
		var v @VM = NewVM(testVMStackSize)
		v.Opt = c
		v.LowerModule(m)
		v.Shutdown()
		return
	}
	iropt.RunOptConfig(m, c)
}

// dropsClean reports whether a second build of src (after a warm-up one) frees
// everything it allocated.
func dropsClean(src *[]readonly char, c iropt.OptConfig, lower bool) bool {
	buildDropGrowth(src, c, lower)
	return buildDropGrowth(src, c, lower) == 0
}

func mem2regOnly() iropt.OptConfig {
	return iropt.WithOptPass(iropt.LevelOptConfig(0), iropt.PASS_MEM2REG, true)
}

func TestLoopModuleDropsClean() testing.TestResult {
	if !dropsClean(cycleLoopSrc(), iropt.LevelOptConfig(0), false) {
		return "a module with a loop must be freed when dropped (back edge)"
	}
	return ""
}

func TestLoopModuleLoweredDropsClean() testing.TestResult {
	if !dropsClean(cycleLoopSrc(), iropt.LevelOptConfig(0), true) {
		return "a lowered module with a loop must be freed when dropped"
	}
	return ""
}

func TestMergePhiModuleDropsClean() testing.TestResult {
	if !dropsClean(cycleMergeSrc(), mem2regOnly(), false) {
		return "a module with an if/else-merge phi must be freed when dropped (phi predecessor)"
	}
	return ""
}

// Lowering destructs the phi (EliminatePhis: copies on each incoming edge,
// critical-edge blocks), which must not leave a cycle either.
func TestMergePhiModuleLoweredDropsClean() testing.TestResult {
	if !dropsClean(cycleMergeSrc(), mem2regOnly(), true) {
		return "a lowered module with an if/else-merge phi must be freed when dropped"
	}
	return ""
}

// Every pass keeps the IR well-formed: after the full pipeline (inlining, and
// mem2reg's phis) every branch target and phi predecessor is still a block of
// its function (irbuild.VerifyModule).
func TestMergePhiModuleVerifiesAfterO2() testing.TestResult {
	var m @ir.Module = genModule(cycleMergeSrc())
	iropt.RunOptConfig(m, iropt.LevelOptConfig(2))
	if len(irbuild.VerifyModule(m)) != 0 { return "the optimized module must verify clean" }
	return ""
}

func TestMergePhiModuleO2DropsClean() testing.TestResult {
	if !dropsClean(cycleMergeSrc(), iropt.LevelOptConfig(2), false) {
		return "a module optimized at -O2 (inlining, phis, no loop) must be freed when dropped"
	}
	return ""
}

func TestMergePhiModuleO2LoweredDropsClean() testing.TestResult {
	if !dropsClean(cycleMergeSrc(), iropt.LevelOptConfig(2), true) {
		return "a lowered module optimized at -O2 must be freed when dropped"
	}
	return ""
}

// cycleLoopPhiSrc's loop gets header phis for every kind of phi operand: a
// loop-carried value (s, i), a parameter (x starts as p), a global's address
// (q starts as &ga and may become &gb), and a dead loop-body temporary (t, whose
// header phi dead-phi removes).  A phi's operand is not owning, so none of them
// closes a cycle with the phi, and the parameter and global refs stay owned by
// their function and module.
func cycleLoopPhiSrc() *[]readonly char {
	return "package \"test\"\n"
			"var ga int = 1\n"
			"var gb int = 2\n"
			"func loopy(n int, p int) int {\n"
			"\tvar s int = 0\n"
			"\tvar x int = p\n"
			"\tvar q *int = &ga\n"
			"\tvar t int = 0\n"
			"\tfor i := 0; i < n; i++ {\n"
			"\t\tt = i * 2\n"
			"\t\ts = s + t + *q\n"
			"\t\tif i == 3 {\n\t\t\tx = i\n\t\t\tq = &gb\n\t\t}\n"
			"\t}\n"
			"\treturn s + x\n"
			"}\n"
			"func caller(n int) int {\n"
			"\treturn loopy(n, 5) + loopy(2, n)\n"
			"}\n"
}

func TestLoopPhiModuleVerifiesAfterPasses() testing.TestResult {
	var cs @[]iropt.OptConfig = make_slice(iropt.OptConfig, 3)
	cs[0] = mem2regOnly()
	cs[1] = iropt.VMOptConfig()
	cs[2] = iropt.LevelOptConfig(2)
	for i := 0; i < len(cs); i++ {
		var m @ir.Module = genModule(cycleLoopPhiSrc())
		iropt.RunOptConfig(m, cs[i])
		if len(irbuild.VerifyModule(m)) != 0 {
			return "the optimized loop module must verify clean (phi operands owned)"
		}
	}
	return ""
}

func TestLoopPhiModuleDropsClean() testing.TestResult {
	if !dropsClean(cycleLoopPhiSrc(), mem2regOnly(), false) {
		return "a module with loop-carried phis must be freed when dropped"
	}
	if !dropsClean(cycleLoopPhiSrc(), iropt.VMOptConfig(), false) {
		return "a module optimized with the VM pass set must be freed when dropped"
	}
	if !dropsClean(cycleLoopPhiSrc(), iropt.LevelOptConfig(2), false) {
		return "a module optimized at -O2 must be freed when dropped"
	}
	return ""
}

// Lowering destructs the phis (copies, critical-edge blocks, swap temps; the
// phis leave their blocks and are owned by their users' Args).
func TestLoopPhiModuleLoweredDropsClean() testing.TestResult {
	if !dropsClean(cycleLoopPhiSrc(), iropt.VMOptConfig(), true) {
		return "a lowered module optimized with the VM pass set must be freed when dropped"
	}
	if !dropsClean(cycleLoopPhiSrc(), iropt.LevelOptConfig(2), true) {
		return "a lowered module optimized at -O2 must be freed when dropped"
	}
	return ""
}

// cyclePhiChainSrc has phis whose only use is an operand of a later phi: two
// sequential merges of x where the second assigns a constant (the first merge's
// phi is read only by the second's), and a nested loop whose counter is read
// only inside the loops (the outer header's phi is read only by the inner
// header's).  Lowering destructs the phis block by block, and each must stay
// alive until every later phi that names it has been destructed.
func cyclePhiChainSrc() *[]readonly char {
	return "package \"test\"\n"
			"func chain(p int, c bool, d bool) int {\n"
			"\tvar x int = p\n"
			"\tif c {\n\t\tx = 1\n\t}\n"
			"\tif d {\n\t\tx = 2\n\t}\n"
			"\treturn x\n"
			"}\n"
			"func nest(n int) int {\n"
			"\tvar x int = 0\n"
			"\tfor i := 0; i < n; i++ {\n"
			"\t\tfor j := 0; j < n; j++ {\n"
			"\t\t\tx = x + 1\n"
			"\t\t}\n"
			"\t}\n"
			"\treturn 7\n"
			"}\n"
			"func run() int {\n"
			"\treturn chain(5, true, false) * 10000 + chain(5, false, false) * 1000 + chain(5, true, true) * 100 + nest(3)\n"
			"}\n"
}

func TestPhiChainLoweredRunsAndDropsClean() testing.TestResult {
	var cs @[]iropt.OptConfig = make_slice(iropt.OptConfig, 2)
	cs[0] = iropt.VMOptConfig()
	cs[1] = iropt.LevelOptConfig(2)
	for i := 0; i < len(cs); i++ {
		var r int
		var faulted bool
		var leak int
		r, faulted, leak = shapedRun(cyclePhiChainSrc(), "test.run", cs[i], 3)
		// chain(5,t,f) = 1, chain(5,f,f) = 5, chain(5,t,t) = 2, nest(3) = 7.
		if faulted || r != 15207 { return "phi chains must lower and run correctly" }
		if leak != 0 { return "running must not leak" }
		if !dropsClean(cyclePhiChainSrc(), cs[i], true) {
			return "the lowered module must be freed when dropped"
		}
	}
	return ""
}
