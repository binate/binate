package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// TestNoLeakAcrossVMLifecycle is the leak regression for the VM static-data
// refcount work: a VM that lowers a module and is then dropped must free EVERY
// block it allocated, so rt.LiveBlocks() returns to its pre-scope baseline.
//
// The module is built OUTSIDE the measured scope (and kept alive past the
// measurement) so the front-end's own allocations are not counted — only the
// VM's create → lower → teardown.  It exercises the static-data families a
// loader-less module reaches: the execution stack, global-var storage (the
// global), and — through the shared lowerDataGlobals — TypeInfo + the impl
// vtable's receiver *TypeInfo and IfaceId (the interface + impl), so the slice-3
// lowerDataGlobals ownership is guarded (revert it and this goes red).  NOT
// reached by this harness: the package-descriptor accessor (emitPackageDescriptorVM
// needs the reflect.Package type loaded) and native vtables (need cross-mode
// dispatch) — both use the same vmOwn/ownedBlocks path.
func TestNoLeakAcrossVMLifecycle() testing.TestResult {
	var m @ir.Module = genModule(
			"package \"test\"\n"
					"interface Greeter { greet() int }\n"
					"type Thing struct { x int }\n"
					"func (t *Thing) greet() int { return t.x }\n"
					"impl *Thing : Greeter\n"
					"var g int = 5\n"
					"func main() int { var t Thing\n t.x = g\n return t.x }\n")
	var before int = rt.LiveBlocks()
	lowerAndDropVM(m)
	var after int = rt.LiveBlocks()
	// Keep m alive across the measurement so its allocations are not attributed
	// to the VM scope.
	if m == nil {
		return "internal: module went nil"
	}
	if after != before {
		return "VM lifecycle leaked raw blocks: rt.LiveBlocks() did not return to baseline"
	}
	return ""
}

// lowerAndDropVM builds a VM, lowers the (externally-owned) module into it, and
// lets the VM go out of scope (dropped → generated destructor → teardown) so the
// caller measures only the VM's own allocations across the scope.
func lowerAndDropVM(m @ir.Module) {
	var v @VM = NewVM(1024 * 1024)
	v.LowerModule(m)
	_ = v
}

// TestVMShutdownRefDecsManagedGlobalContent is Part B of the VM leak fix: a
// managed global (`var g @Foo`) holds an independently-allocated @Foo CONTENT
// (the pointee) after main assigns it.  Part A (ownedBlocks) already frees the
// static-data BLOCK the global's storage lives in when the VM drops, but the
// @Foo content it points at leaks unless something RefDecs it.  v.Shutdown()
// runs the synthesized `<pkg>.__vm_teardown_globals`, which RefDecs the managed
// global, so rt.LiveBlocks() returns to its pre-scope baseline after the VM is
// dropped.  Without the teardown (or the Shutdown call) the @Foo persists and
// this goes red.
//
// The module is built OUTSIDE the measured scope (and kept alive past it) so the
// front-end's allocations are not counted — only the VM's create → lower → run
// main → shutdown → drop, mirroring TestNoLeakAcrossVMLifecycle.
func TestVMShutdownRefDecsManagedGlobalContent() testing.TestResult {
	var m @ir.Module = genModule(
			"package \"test\"\n"
					"type Foo struct { x int }\n"
					"var g @Foo\n"
					"func main() int { g = make(Foo)\n"
					" g.x = 5\n"
					" return g.x }\n")
	var before int = rt.LiveBlocks()
	runMainThenShutdownAndDropVM(m)
	var after int = rt.LiveBlocks()
	// Keep m alive across the measurement so its allocations are not attributed
	// to the VM scope.
	if m == nil {
		return "internal: module went nil"
	}
	if after != before {
		return "managed global content leaked: Shutdown did not RefDec g's @Foo"
	}
	return ""
}

// runMainThenShutdownAndDropVM builds a VM, lowers the (externally-owned)
// module, runs main (which assigns the managed global), calls Shutdown (which
// RefDecs the global's content), and drops the VM — so the caller measures only
// the VM's own allocations across the scope.  Shutdown is called TWICE to
// exercise idempotency: the second call must be a no-op (a re-run would
// double-RefDec g's @Foo → double-free), so the baseline is still restored.
func runMainThenShutdownAndDropVM(m @ir.Module) {
	var v @VM = NewVM(1024 * 1024)
	v.LowerModule(m)
	var noArgs @[]int
	_ = v.CallFunc("test.main", noArgs)
	v.Shutdown()
	v.Shutdown()
	_ = v
}
