package "pkg/binate/vm"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/std/strings"
import "pkg/stdx/slices"

// LowerOneFuncShadow lowers a single IR function to a VMFunc and
// always APPENDS it to vm.Funcs (never replaces, even when a
// VMFunc with the same qualified name already exists).  REPL
// entry point for Tier 4 shadow: incompatible-signature
// redefinition keeps the OLD VMFunc reachable at its existing
// idx for any caller whose CallCache already resolved that
// callee — those callers continue calling the old shape.
//
// The funcIndex is updated to point at the NEW (later) idx, so
// fresh lowerings (eager-fill at lowering time) resolve to the
// new VMFunc.  Old callers, whose CallCache was eager-filled at
// THEIR lowering time, hold the OLD idx and stay routed to the
// old VMFunc — exactly the shadow semantic.
//
// Preconditions match LowerOneFunc.  Returns the new VMFunc, or
// nil if `f` is extern.
func (vm @VM) LowerOneFuncShadow(m @ir.Module, f @ir.Func) @VMFunc {
	if f.IsExtern { return nil }
	m.FinalizeStrings()
	// Re-establish the module context from `m` so a stale modulePkgName left
	// by a prior LowerModule of a DIFFERENT package (the REPL mid-session-
	// import path: LowerModule(importedPkg) then LowerOneFunc*(mainMod))
	// doesn't mis-qualify f's bare same-package call targets.
	vm.modulePkgName = mangle.PkgPathFromQuoted(m.Name)
	vm.moduleStrings = materializeModuleStrings(m.Strings)
	vm.curStrings = m.Strings
	var vmf @VMFunc = lowerFunc(vm, f)
	var newIdx int = len(vm.Funcs)
	vm.Funcs = slices.Append[@VMFunc](vm.Funcs, vmf)
	// Re-point the funcIndex at the new idx; old idx stays in
	// vm.Funcs as a callable shadowed entry.
	funcIndexSet(vm, vmf.Name, newIdx)
	eagerFillCallCache(vm, vmf)
	return vmf
}

// LowerOneFunc lowers a single IR function to a VMFunc and
// installs it in vm.Funcs.  REPL entry point: per-function analog
// of LowerModule's inner loop.
//
// Install semantics:
//   - If vm.Funcs already has an entry with the same qualified
//     name, replace it in place (Tier 4 redefinition: same idx,
//     so the existing per-call-site CallCache stays valid).
//   - Otherwise append (Tier 1 / 2 first-time lower).
//
// In both cases, the name→idx hash on the VM is updated
// accordingly so subsequent LookupFunc calls resolve in O(1).
//
// Preconditions:
//   - vm.LowerModule(m) was previously called for `m` so `m`'s globals
//     are materialized in the per-VM global table.  (The module's
//     package context — modulePkgName — is re-established here from `m`,
//     so it need not be carried over from that LowerModule call.)
//   - Caller has already AddFunc'd `f` into `m` so string
//     collection can see it.
//
// Returns the installed VMFunc, or nil if `f` is extern (nothing
// lowered).
func (vm @VM) LowerOneFunc(m @ir.Module, f @ir.Func) @VMFunc {
	if f.IsExtern { return nil }
	// Re-collect strings: existing IDs are stable (encounter
	// order), new strings get appended IDs.  Re-materialize
	// moduleStrings so the new VMFunc's BC_LOAD_STR references
	// have a fresh @[]@[]char to share via vmf.Strings.
	m.FinalizeStrings()
	// Re-establish module context from `m` (see LowerOneFuncShadow) so a
	// stale modulePkgName from a prior LowerModule of another package can't
	// mis-qualify f's bare same-package call targets.
	vm.modulePkgName = mangle.PkgPathFromQuoted(m.Name)
	vm.moduleStrings = materializeModuleStrings(m.Strings)
	vm.curStrings = m.Strings
	var vmf @VMFunc = lowerFunc(vm, f)
	var existing int = funcIndexLookup(vm, vmf.Name)
	var isFreshName bool = false
	if existing >= 0 {
		vm.Funcs[existing] = vmf
		// Hash entry already maps name → existing; no update.
	} else {
		var newIdx int = len(vm.Funcs)
		vm.Funcs = slices.Append[@VMFunc](vm.Funcs, vmf)
		funcIndexSet(vm, vmf.Name, newIdx)
		isFreshName = true
	}
	// Eager-fill CallCache against the now-current funcIndex so
	// per-call-site resolution is frozen at lowering time (the
	// substrate the Tier 4 shadow path relies on).
	eagerFillCallCache(vm, vmf)
	// Tier 3 forward references: if this is the first time
	// `vmf.Name` enters funcIndex, any earlier-lowered VMFunc
	// that referenced this name (and got -1 cached, since the
	// name was unknown then) needs its cache upgraded to the
	// real idx.  Tier 4 shadow correctness preserved — only
	// -1 entries are touched, real cached indices stay put.
	if isFreshName {
		backfillExternCachesForName(vm, vmf.Name)
	}
	return vmf
}

// eagerFillCallCache replaces every -2 entry in vmf.CallCache with
// the result of looking up the corresponding name on `vm` right
// now (-1 if the name isn't a VM function).  Called after a
// VMFunc is registered in the per-VM funcIndex so that all the
// VMFuncs it references are resolvable.
//
// Why eager: per-call-site lazy fill (the historical default)
// resolves on first execution.  That timing is fine for the
// non-REPL world where vm.Funcs never changes after load, but
// it's wrong for the Tier 4 shadow path: an old caller whose
// CallCache slot is still -2 when its callee gets shadowed would
// pick up the new (incompatible) callee on its next execution.
// Eager fill freezes the binding at lowering time, which is the
// semantic the language design pins down.
func eagerFillCallCache(vm @VM, vmf @VMFunc) {
	for i := 0; i < len(vmf.CallCache); i++ {
		if vmf.CallCache[i] == -2 {
			vmf.CallCache[i] = funcIndexLookup(vm, vmf.Names[i])
		}
	}
}

// backfillExternCachesForName walks every VMFunc in vm.Funcs and
// converts any CallCache slot that's currently -1 (cached as
// "extern, unknown to the VM") AND whose Names[i] equals
// `name` into the now-correct funcIndex entry.
//
// Why: Tier 3 forward references mean a caller can be lowered
// before its callee.  At that lower-time, eagerFillCallCache
// caches -1 for the unknown name (extern fallback path).  When
// the callee later lowers, those -1 entries need to be
// upgraded to the new idx — otherwise the old caller's
// BC_CALL hits the extern path and fails.
//
// Tier 4 shadow correctness is preserved: this only upgrades
// -1 (= "no real func known") slots; existing >=0 caches
// (real func indices, including those for now-shadowed
// callees) are left untouched.
func backfillExternCachesForName(vm @VM, name *[]readonly char) {
	var newIdx int = funcIndexLookup(vm, name)
	if newIdx < 0 { return }
	for f := 0; f < len(vm.Funcs); f++ {
		var caller @VMFunc = vm.Funcs[f]
		for i := 0; i < len(caller.CallCache); i++ {
			if caller.CallCache[i] != -1 { continue }
			if streq(caller.Names[i], name) {
				caller.CallCache[i] = newIdx
			}
		}
	}
}

// funcHasCCall reports whether f contains an OP_C_CALL instruction (a
// `__c_call` to a C symbol).  Such functions are native-only — the bytecode
// VM has no representation for the C call — so LowerModule skips them and
// the host injects the owning compiled package instead.
func funcHasCCall(f @ir.Func) bool {
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == ir.OP_C_CALL { return true }
		}
	}
	return false
}

// LowerModule converts all functions in an IR module to bytecode,
// skipping native-only `__c_call` functions (see funcHasCCall) — those
// are dispatched through the injected compiled package instead.
func (vm @VM) LowerModule(m @ir.Module) {
	// Finalize string constants
	if len(m.Strings) == 0 {
		m.FinalizeStrings()
	}

	// Materialize string constants as managed-slice headers.
	// Keep a per-module strings slice in moduleStrings so each
	// VMFunc lowered from this module can reference it; earlier
	// modules' strings are preserved in their own VMFuncs. (Old
	// behavior overwrote vm.Strings each LowerModule call, which
	// invalidated BC_LOAD_STR indices baked into earlier modules'
	// functions — e.g. pkg/binate/token's TypeName would return pkg/binate/lexer
	// strings after pkg/binate/lexer was lowered.)
	vm.moduleStrings = materializeModuleStrings(m.Strings)
	vm.curStrings = m.Strings

	// Derive the package path from m.Name (e.g., `"pkg/binate/asm"` →
	// `pkg/binate/asm`).  Used to qualify function names so multiple
	// packages can define same-named functions without colliding in
	// the VM's function table.  The mangler short-names this
	// internally for now (full-path migration — see pkg/binate/mangle).
	vm.modulePkgName = mangle.PkgPathFromQuoted(m.Name)

	// Allocate globals: each global gets c_malloc'd memory.
	materializeGlobals(vm, m.Globals)

	// Two-pass to support cross-references between funcs lowered in
	// the same module: pass 1 lowers and registers every VMFunc on
	// vm.Funcs / the funcIndex; pass 2 eager-fills CallCaches now
	// that all names are known.  A single pass would leave any
	// forward call within the module resolving to -1 (extern) at
	// fill time, then either crashing or routing through the
	// extern path at execution.
	var firstNewIdx int = len(vm.Funcs)
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if f.IsExtern { continue }
		// A function that calls __c_call (direct OS / C access) cannot be
		// expressed in bytecode — it runs only as the injected COMPILED
		// package (registered native externs).  Skip lowering it so callers
		// miss LookupFunc and fall to the extern registry; the host
		// (cmd/bni) injects the owning package via RegisterPackageFunctions.
		// This is per-function, not per-package: a __c_call package's
		// pure-Binate funcs — including its Test* functions — still lower and
		// run as bytecode, dispatching their __c_call calls to the injected
		// externs.
		if funcHasCCall(f) { continue }
		var vmf @VMFunc = lowerFunc(vm, f)
		var newIdx int = len(vm.Funcs)
		vm.Funcs = slices.Append[@VMFunc](vm.Funcs, vmf)
		funcIndexSet(vm, vmf.Name, newIdx)
	}
	for i := firstNewIdx; i < len(vm.Funcs); i++ {
		eagerFillCallCache(vm, vm.Funcs[i])
	}
	// Slice 2.3c of plan-interface-syntax-revision.md: register a
	// VM-side vtable per (impl, interface) pair. Each vtable holds
	// 1-based VM function indices in the interface's method-
	// declaration order. Runs after eagerFillCallCache so all
	// methods are registered and resolvable by name.
	lowerImplVtables(vm, m)
}

// lowerImplVtables walks m.Impls and appends one IfaceVtable to
// vm.IfaceVtables per impl, using the concat layout from
// plan-interface-embedding.md Slice E.3 — `[dtor]` followed by
// each parent's full vtable inlined (recursive), then this
// interface's own methods.  For a non-extended interface this
// reduces to the original [dtor, m1, m2, ...] layout.
// Slice E.4 of plan-interface-embedding.md.
//
// Each method name is the qualified
// `<recvPkg>.<recvName>.<methodName>` form (matching the codegen
// side's buildMethodFuncName) so this VM table and the LLVM
// global agree slot-by-slot regardless of where the slot's value
// lives in the concat structure.  Function indices are 1-based
// (or 0 if not registered).
func lowerImplVtables(vm @VM, m @ir.Module) {
	for i := 0; i < len(m.Impls); i++ {
		var info @ir.ImplInfo = m.Impls[i]
		if info == nil { continue }
		var vt @IfaceVtable = make(IfaceVtable)
		vt.Name = implVtableName(info)
		var nSlots int = ir.IfaceFullVtableSize(info.IfacePkg,
			info.IfaceName)
		vt.Methods = make_slice(int, nSlots)
		var dtorIdx int = -1
		if len(info.DtorFuncName) > 0 {
			dtorIdx = vm.LookupFunc(info.DtorFuncName)
		}
		fillVtableLayout(vm, m, vt.Methods, info, info.IfacePkg,
			info.IfaceName, 0, dtorIdx+1)
		vm.IfaceVtables = slices.Append[@IfaceVtable](vm.IfaceVtables, vt)
	}
}

// fillVtableLayout writes `(R, X)`'s slot values into `slots`
// starting at `base`, mirroring the recursive concat layout the
// LLVM emitter uses (pkg/binate/codegen/emit_impls.bn:emitImplVtableLayout).
// `dtorEntry` is the 1-based dtor index already resolved by the
// caller; it's the same value at every nested any-block slot.
func fillVtableLayout(vm @VM, m @ir.Module, slots @[]int,
		info @ir.ImplInfo, ifacePkg *[]readonly char,
		ifaceName *[]readonly char, base int, dtorEntry int) {
	// X's any-block (dtor at slot `base`).
	slots[base] = dtorEntry
	var cursor int = base + 1
	// Each parent's full vtable inlined (recursive).
	var parentPkgs @[]@[]char = ir.IfaceParentPkgs(ifacePkg, ifaceName)
	var parentNames @[]@[]char = ir.IfaceParentNames(ifacePkg, ifaceName)
	for i := 0; i < len(parentPkgs); i++ {
		fillVtableLayout(vm, m, slots, info, parentPkgs[i],
			parentNames[i], cursor, dtorEntry)
		cursor = cursor + ir.IfaceFullVtableSize(parentPkgs[i],
			parentNames[i])
	}
	// X's own methods.  For value-receiver methods the slot
	// points at the per-(R, M) thunk so the iv dispatch's
	// pointer-shape arg gets dereffed before the method runs.
	// See plan-primitives-impl-interfaces.md § "Interface-value
	// dispatch and value receivers".
	var ownMethods @[]@[]char = ir.IfaceOwnMethodNames(ifacePkg, ifaceName)
	for i := 0; i < len(ownMethods); i++ {
		var qualified @[]char = buildMethodFuncName(info.RecvPkg,
			info.RecvTypeName, ownMethods[i])
		var slotName @[]char = ir.LookupVtableSlotName(m, qualified)
		var idx int = vm.LookupFunc(slotName)
		slots[cursor+i] = idx + 1
	}
}

// buildMethodFuncName mirrors pkg/binate/codegen/emit_impls.bn's helper
// of the same name: `<recvPkg>.<recvName>.<methodName>`.  Used
// when filling parent-block slots in fillVtableLayout so the
// VM agrees with codegen on which function backs each slot.
func buildMethodFuncName(recvPkg @[]char, recvName @[]char,
		methodName @[]char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write(recvPkg)
	b.WriteByte('.')
	b.Write(recvName)
	b.WriteByte('.')
	b.Write(methodName)
	return buf.CopyStr(b.String())
}

// buildIfaceUpcastSuffixes packs the source and target interface
// (Pkg, Name) pairs into a single string used by BC_IFACE_UPCAST's
// runtime name-rewrite:
//   `<srcPkg>__<srcName>|<tgtPkg>__<tgtName>`
// The runtime takes the source vtable's mangled name, finds the
// LAST occurrence of `__<srcPkg>__<srcName>`, replaces it with
// `__<tgtPkg>__<tgtName>`, and looks the result up in
// vm.IfaceVtables.  Slice E.4 part 2b of
// plan-interface-embedding.md.
func buildIfaceUpcastSuffixes(srcTyp @types.Type,
		tgtTyp @types.Type) @[]char {
	// The pkg components are full package paths; fold their slashes
	// to `__` so the suffixes match the slash-folded vtable symbol
	// the runtime rewrites (full-path mangling — see pkg/binate/mangle).
	var b @strings.Builder = strings.NewBuilder()
	if srcTyp != nil && srcTyp.Elem != nil {
		writeVtablePkgIdent(b, srcTyp.Elem.Pkg)
		b.Write("__")
		b.Write(srcTyp.Elem.Name)
	}
	b.WriteByte('|')
	if tgtTyp != nil && tgtTyp.Elem != nil {
		writeVtablePkgIdent(b, tgtTyp.Elem.Pkg)
		b.Write("__")
		b.Write(tgtTyp.Elem.Name)
	}
	return buf.CopyStr(b.String())
}

// implVtableName builds the same mangled identifier that IR-gen
// stores on OP_IFACE_VALUE — the canonical
// `__ivt.bn_<recv_pkg>__<recv_name>__<iface_pkg>__<iface_name>` form
// adopted by Slice 2.6. The VM uses this as the key when
// BC_IFACE_VALUE looks up the right vtable record. Mirrors the LLVM
// codegen function of the same name (pkg/binate/codegen/emit_impls.bn) and
// IR-gen's buildImplVtableSymbol — three copies kept in sync via
// shared ImplInfo fields rather than a shared helper, since the
// three layers don't share an import path today.
func implVtableName(info @ir.ImplInfo) @[]char {
	// RecvPkg / IfacePkg are full package paths; fold their slashes
	// into the identifier-safe form so this key matches the symbol
	// IR-gen stores on OP_IFACE_VALUE (full-path mangling — see
	// pkg/binate/mangle).
	var b @strings.Builder = strings.NewBuilder()
	b.Write("__ivt.bn_")
	writeVtablePkgIdent(b, info.RecvPkg)
	b.Write("__")
	b.Write(info.RecvTypeName)
	b.Write("__")
	writeVtablePkgIdent(b, info.IfacePkg)
	b.Write("__")
	b.Write(info.IfaceName)
	return buf.CopyStr(b.String())
}

// writeVtablePkgIdent appends a package path to b with every `/`
// replaced by `__`, matching the mangler's package-component
// encoding.
func writeVtablePkgIdent(b @strings.Builder, pkg *[]readonly char) {
	for i := 0; i < len(pkg); i++ {
		if pkg[i] == '/' {
			b.Write("__")
		} else {
			b.WriteByte(pkg[i])
		}
	}
}

// findIfaceVtable returns the 0-based index of the vtable in
// vm.IfaceVtables matching `name`, or -1 if not found.
func findIfaceVtable(vm @VM, name @[]readonly char) int {
	for i := 0; i < len(vm.IfaceVtables); i++ {
		if streq2(vm.IfaceVtables[i].Name, name) {
			return i
		}
	}
	return -1
}

// qualifyCallName returns the fully-qualified function name for a call
// target. Thin wrapper around mangle.QualifyName that plugs in the
// current module's short package name.
func qualifyCallName(vm @VM, name @[]char) @[]char {
	return mangle.QualifyName(vm.modulePkgName, name)
}
