package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/iropcode"

// lowerCallOp lowers the function-value, interface, and call IR ops to
// bytecode — the indirect-dispatch and call family split out of lowerInstr.
// Returns (bc, true) when instr.Op is one of these ops; (bc, false)
// otherwise, so lowerInstr falls through to its remaining cases. bc arrives
// with Dst already set to instr.ID.
func lowerCallOp(vm @VM, instr @ir.Instr, bc BCInstr, callArgBase int) (BCInstr, bool) {
	if instr.Op == iropcode.OP_FUNC_HANDLE {
		bc.Op = BC_FUNC_HANDLE
		bc.Aux = addName(vm, qualifyCallName(vm, instr.StrVal))
		return bc, true
	}
	if instr.Op == iropcode.OP_FUNC_VALUE {
		bc.Op = BC_FUNC_VALUE
		bc.Aux = addName(vm, qualifyCallName(vm, instr.StrVal))
		// B.2 capturing literal: Args[0] is the alloca'd closure
		// struct pointer.  BC_FUNC_VALUE handler reads from Src1
		// when Src1 != -1 and builds a COMPILED_CLOSURE record
		// per evaluation (see vm_exec_funcref.bn).  Phase 1
		// non-capturing literals leave Args empty / Src1 = -1.
		if len(instr.Args) > 0 {
			bc.Src1 = instr.Args[0].ID
		} else {
			bc.Src1 = -1
		}
		return bc, true
	}
	if instr.Op == iropcode.OP_IFACE_VALUE {
		// Aux = name index for the mangled vtable identifier.
		// Src1 = the data ptr register. The handler in
		// vm_exec_helpers.bn looks the vtable up by name on first
		// execution and caches the address. Slice 2.3c of plan-
		// interface-syntax-revision.md.
		//
		// The DYNAMIC-vtable form (empty StrVal, vtable in Args[1]) is a
		// native-only construction from interface-assertion recovery (RTTI
		// Slice 2b); the VM's BC_IFACE_VALUE resolves the vtable BY NAME, so
		// an empty StrVal would addName("") and resolve to a bogus vtable
		// index.  Fail loud rather than silently miscompile — the dynamic VM
		// path is deferred to RTTI Slice 5.
		if len(instr.StrVal) == 0 {
			vmPanic(
					"vm/lower: dynamic-vtable OP_IFACE_VALUE (interface assertion) "
							"not yet supported in the VM — RTTI Slice 5")
		}
		bc.Op = BC_IFACE_VALUE
		bc.Src1 = instr.Args[0].ID
		bc.Aux = addName(vm, instr.StrVal)
		return bc, true
	}
	if instr.Op == iropcode.OP_CALL_IFACE_METHOD {
		// Args[0] = interface value (16-byte stack-slot addr);
		// Args[1..] are pre-packed into [callArgBase, callArgBase+N-1].
		// Aux = method slot index. Imm = packed slot count of the
		// user args (Layer 2 step 2b); the iface's data ptr is
		// prepended by the handler in slot 0.
		bc.Op = BC_CALL_IFACE_METHOD
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = callArgBase
		var slots int = 0
		for k := 1; k < len(instr.Args); k++ {
			slots = slots + argSlots(instr.Args[k].Typ)
		}
		bc.Imm = slots
		// Aux = method slot in the low 16 bits, the AGGREGATE RETBUF SIZE
		// (instr.RetbufSize, stamped at IR-gen from the method's full result
		// list; 0 for a scalar return) in the high bits.  This lets the
		// native-vtable dispatch path (dispatchCompiledIfaceMethod, reached
		// when the iface value came from an injected COMPILED package) pick
		// the shim shape — retbuf when nonzero, scalar when 0 — agreeing with
		// codegen's isAggregateReturn.  Deriving it from instr.Typ.SizeOf()
		// here was the B1/C1 bug: a <=8-byte coerced struct / multi-return
		// (lowered to an anonymous tuple) reads <=8 and mis-dispatches scalar.
		// Both a method slot and the retbuf size are far under 16 bits.
		// The retbuf sub-field's bit 0 (Aux bit 16) also carries the scalar64
		// flag (packRetbufScalar64): a bare 64-bit scalar return has retbuf
		// size 0 but must be read back as a register PAIR on ILP32, not a
		// single word — see vm_crossmode_ret64.bn.
		bc.Aux = instr.Index |
				(packRetbufScalar64(instr.RetbufSize, is64BitScalarReturn(instr.Typ, REG_SLOT)) << 16)
		return bc, true
	}
	if instr.Op == iropcode.OP_IFACE_DTOR {
		// Load slot 0 (the dtor's 1-based VM func index, or 0 if
		// the receiver type has no dtor) from the iv's vtable.
		// Src1 = iv slot addr; Dst gets the int directly. The
		// downstream consumer is BC_REFDEC_INLINE_FAST, which
		// reads the dtor func index from a register. Slice 2.5b
		// of plan-interface-syntax-revision.md.
		bc.Op = BC_IFACE_DTOR
		bc.Src1 = instr.Args[0].ID
		return bc, true
	}
	if instr.Op == iropcode.OP_FUNC_VALUE_DTOR {
		// Load vtable.Dtor (slot 0 of the @func value's vtable, or
		// 0 if the fv is nil or has no dtor).  Src1 = fv stack
		// addr; Dst receives the int (a function pointer's bits or
		// a 1-based VM func index, per the dtor's runtime kind).
		// Feeds BC_REFDEC_INLINE_FAST's Src2 dtor slot; today VM-
		// constructed fvs always carry Dtor=0 (Phase 2 closure-
		// struct dtors not wired yet — see ensureHandle in
		// vm_exec_funcref.bn), so the path is operationally
		// equivalent to RawFree.  Surfacing the load anyway keeps
		// the VM lowering honest and unblocks the Phase 2 wiring.
		bc.Op = BC_FUNC_VALUE_DTOR
		bc.Src1 = instr.Args[0].ID
		return bc, true
	}
	if instr.Op == iropcode.OP_IFACE_UPCAST {
		// Slice E.4 part 2b of plan-interface-embedding.md.  Src1 = source
		// iv's stack addr; Dst = result iv's stack addr.  The runtime takes
		// two paths by source-vtable kind (ifaceVtIsNative):
		//
		//   * VM-built source — Aux encodes a combined string
		//     `<src_iface_suffix>|<target_iface_suffix>`; the runtime strips
		//     the src-iface suffix off the source vtable name, appends the
		//     target's, and looks the result up in vm.IfaceVtables.  R (the
		//     receiver type) flows in from the source's vtable name at runtime
		//     — it can't be baked here because the iv is polymorphic.
		//
		//   * COMPILED (injected) source — Imm carries the parent-interface
		//     vtable SLOT offset, precomputed at IR-gen (EmitIfaceUpcast) via
		//     IfaceParentSlotOffset and read off the same instr field the
		//     LLVM/native backends use.  The runtime advances the native
		//     vtable pointer by offset slots (mirroring emit_iface_upcast.bn)
		//     instead of a name swap.  0 for upcast-to-`any` / managed<->raw
		//     decay; -1 (invalid upcast the checker rejects) aborts at runtime.
		bc.Op = BC_IFACE_UPCAST
		bc.Src1 = instr.Args[0].ID
		bc.Aux = addName(vm, buildIfaceUpcastSuffixes(
				instr.Args[0].Typ, instr.Typ))
		bc.Imm = instr.IfaceUpcastSlotOffset
		return bc, true
	}
	if instr.Op == iropcode.OP_CALL {
		bc.Op = BC_CALL
		// Imm is the packed slot count (Layer 2 step 2b): a 64-bit-scalar
		// arg packs into 2 slots on a host whose word is < 8 bytes.  A
		// by-value aggregate (coerced or byval) rides ONE by-address slot
		// — the per-function shim loads + re-coerces it to the underlying's
		// ABI (emit_funcvals_shim) — identical to the OP_CALL_IFACE_METHOD
		// / func-value packing.
		var slots int = 0
		for k := 0; k < len(instr.Args); k++ {
			slots = slots + argSlots(instr.Args[k].Typ)
		}
		// Imm bit 20 (packCallImm) flags a 64-bit-scalar return: a direct call
		// (extern OR vm-func) returning a bare int64/uint64/float64 must be read
		// back as a register PAIR on ILP32 via _call_shim_scalar64, not the
		// truncating _call_shim_scalar — see vm_crossmode_ret64.bn.  The three
		// BC_CALL Imm readers (the >7 guard, the extern arg-copy, the vm-func
		// arg-copy) all mask it off via callImmSlots.
		bc.Imm = packCallImm(slots, is64BitScalarReturn(instr.Typ, REG_SLOT))
		bc.Src1 = callArgBase
		bc.Aux = addName(vm, qualifyCallName(vm, instr.StrVal))
		return bc, true
	}
	if instr.Op == iropcode.OP_CALL_INDIRECT {
		// Args[0] = native fn pointer (a per-function __shim address);
		// Args[1..] are pre-packed into [callArgBase, callArgBase+N-1].
		// Only `_call_shim_scalar` / `_call_shim_aggregate` reach here
		// after Phase 4 of plan-uniform-native-fnptrs.md.  Shim args
		// are all narrow, so packed slot count == arg count for those
		// shapes (matches the Imm==8/9 shape selectors in
		// dispatchNativeIndirect).
		bc.Op = BC_CALL_INDIRECT
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = callArgBase
		var slots int = 0
		for k := 1; k < len(instr.Args); k++ {
			slots = slots + argSlots(instr.Args[k].Typ)
		}
		bc.Imm = slots
		// Aux flags a 64-bit-scalar return (the _call_shim_scalar64 primitive,
		// whose result is int64) for the nested-VM path: _call_shim_scalar64 has
		// the same 8-arg shape as _call_shim_scalar (both Imm==8), so
		// dispatchNativeIndirect cannot tell them apart by Imm and reads this
		// flag to pick the wide primitive + pair split.  Aux is otherwise unused
		// on BC_CALL_INDIRECT.
		if is64BitScalarReturn(instr.Typ, REG_SLOT) {
			bc.Aux = 1
		}
		return bc, true
	}
	if instr.Op == iropcode.OP_CALL_FUNC_VALUE {
		// Args[0] = function value (16-byte stack-slot address);
		// Args[1..] are pre-packed into [callArgBase, callArgBase+N-1].
		// Imm is the packed slot count (Layer 2 step 2b).  Aux carries the
		// AGGREGATE RETBUF SIZE (instr.RetbufSize, stamped at IR-gen from the
		// func value's result list; 0 for a scalar return) so the cross-mode
		// dispatch (dispatchCompiledFuncValue) picks the retbuf shim when
		// nonzero; the VM-side push path ignores Aux.  Without this a func
		// value of a native-injected function returning an aggregate (e.g.
		// strconv.Itoa → @[]char, or a <=8-byte coerced struct) dispatches
		// through the scalar shim and loses its result.
		bc.Op = BC_CALL_FUNC_VALUE
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = callArgBase
		var slots int = 0
		for k := 1; k < len(instr.Args); k++ {
			slots = slots + argSlots(instr.Args[k].Typ)
		}
		bc.Imm = slots
		// Aux bit 0 (packRetbufScalar64) also flags a 64-bit-scalar return
		// (retbuf size 0) so dispatchCompiledFuncValue reads it back as a
		// register PAIR — see vm_crossmode_ret64.bn.
		bc.Aux = packRetbufScalar64(instr.RetbufSize, is64BitScalarReturn(instr.Typ, REG_SLOT))
		return bc, true
	}
	if instr.Op == iropcode.OP_CALL_HANDLE {
		// Args[0] = handle pointer (*uint8 pointing at a 16-byte
		// {vtable_ptr, data_ptr} block) — same shape as a function
		// value's stack-slot address, so reuse BC_CALL_FUNC_VALUE's
		// runtime handler (reads vtable.call(data, args)).  Phase 4
		// of plan-uniform-native-fnptrs.md.  Aux = the aggregate retbuf
		// size (instr.RetbufSize), which EmitCallHandle leaves 0: handle
		// calls are emitted only for `_call_dtor` / `_call_free_fn`, both
		// VOID, so the aggregate retbuf path is never taken.
		bc.Op = BC_CALL_FUNC_VALUE
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = callArgBase
		var slots int = 0
		for k := 1; k < len(instr.Args); k++ {
			slots = slots + argSlots(instr.Args[k].Typ)
		}
		bc.Imm = slots
		// OP_CALL_HANDLE is emitted only for VOID _call_dtor / _call_free_fn, so
		// the scalar64 flag is always clear here; packed uniformly for symmetry.
		bc.Aux = packRetbufScalar64(instr.RetbufSize, is64BitScalarReturn(instr.Typ, REG_SLOT))
		return bc, true
	}
	return bc, false
}
