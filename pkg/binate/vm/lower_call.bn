package "pkg/binate/vm"

import "pkg/binate/ir"

// lowerCallOp lowers the function-value, interface, and call IR ops to
// bytecode — the indirect-dispatch and call family split out of lowerInstr.
// Returns (bc, true) when instr.Op is one of these ops; (bc, false)
// otherwise, so lowerInstr falls through to its remaining cases. bc arrives
// with Dst already set to instr.ID.
func lowerCallOp(instr @ir.Instr, bc BCInstr, callArgBase int) (BCInstr, bool) {
	if instr.Op == ir.OP_FUNC_HANDLE {
		bc.Op = BC_FUNC_HANDLE
		bc.Aux = addName(qualifyCallName(instr.StrVal))
		return bc, true
	}
	if instr.Op == ir.OP_FUNC_VALUE {
		bc.Op = BC_FUNC_VALUE
		bc.Aux = addName(qualifyCallName(instr.StrVal))
		// B.2 capturing literal: Args[0] is the alloca'd closure
		// struct pointer.  BC_FUNC_VALUE handler reads from Src1
		// when Src1 != -1 and builds a COMPILED_CLOSURE record
		// per evaluation (see vm_exec_funcref.bn).  Phase 1
		// non-capturing literals leave Args empty / Src1 = -1.
		if len(instr.Args) > 0 {
			bc.Src1 = instr.Args[0].ID
		} else {
			bc.Src1 = -1
		}
		return bc, true
	}
	if instr.Op == ir.OP_IFACE_VALUE {
		// Aux = name index for the mangled vtable identifier.
		// Src1 = the data ptr register. The handler in
		// vm_exec_helpers.bn looks the vtable up by name on first
		// execution and caches the address. Slice 2.3c of plan-
		// interface-syntax-revision.md.
		bc.Op = BC_IFACE_VALUE
		bc.Src1 = instr.Args[0].ID
		bc.Aux = addName(instr.StrVal)
		return bc, true
	}
	if instr.Op == ir.OP_CALL_IFACE_METHOD {
		// Args[0] = interface value (16-byte stack-slot addr);
		// Args[1..] are pre-packed into [callArgBase, callArgBase+N-1].
		// Aux = method slot index. Imm = packed slot count of the
		// user args (Layer 2 step 2b); the iface's data ptr is
		// prepended by the handler in slot 0.
		bc.Op = BC_CALL_IFACE_METHOD
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = callArgBase
		var slots int = 0
		for k := 1; k < len(instr.Args); k++ {
			slots = slots + argSlots(instr.Args[k].Typ)
		}
		bc.Imm = slots
		// Aux = method slot in the low 16 bits, method RESULT BYTE-SIZE in
		// the high bits.  The size lets the native-vtable dispatch path
		// (dispatchCompiledIfaceMethod, reached when the iface value came
		// from an injected COMPILED package) pick the result shape — scalar
		// (≤8), by-value pair (9–16, X0:X1), or sret (>16) — since a raw
		// method fn returns by the native ABI and there is no callee VMFunc
		// to read ResultSizes from, unlike the VM-index path.  Both a method
		// slot and any iface-method result size are far under 16 bits.
		var ifaceResultSize int = 0
		if instr.Typ != nil { ifaceResultSize = instr.Typ.SizeOf() }
		bc.Aux = instr.Index | (ifaceResultSize << 16)
		return bc, true
	}
	if instr.Op == ir.OP_IFACE_DTOR {
		// Load slot 0 (the dtor's 1-based VM func index, or 0 if
		// the receiver type has no dtor) from the iv's vtable.
		// Src1 = iv slot addr; Dst gets the int directly. The
		// downstream consumer is BC_REFDEC_INLINE_FAST, which
		// reads the dtor func index from a register. Slice 2.5b
		// of plan-interface-syntax-revision.md.
		bc.Op = BC_IFACE_DTOR
		bc.Src1 = instr.Args[0].ID
		return bc, true
	}
	if instr.Op == ir.OP_FUNC_VALUE_DTOR {
		// Load vtable.Dtor (slot 0 of the @func value's vtable, or
		// 0 if the fv is nil or has no dtor).  Src1 = fv stack
		// addr; Dst receives the int (a function pointer's bits or
		// a 1-based VM func index, per the dtor's runtime kind).
		// Feeds BC_REFDEC_INLINE_FAST's Src2 dtor slot; today VM-
		// constructed fvs always carry Dtor=0 (Phase 2 closure-
		// struct dtors not wired yet — see ensureHandle in
		// vm_exec_funcref.bn), so the path is operationally
		// equivalent to RawFree.  Surfacing the load anyway keeps
		// the VM lowering honest and unblocks the Phase 2 wiring.
		bc.Op = BC_FUNC_VALUE_DTOR
		bc.Src1 = instr.Args[0].ID
		return bc, true
	}
	if instr.Op == ir.OP_IFACE_UPCAST {
		// Slice E.4 part 2b of plan-interface-embedding.md.
		// Src1 = source iv's stack addr; Dst = result iv's
		// stack addr.  Aux encodes a combined string
		// `<src_iface_suffix>|<target_iface_suffix>` so the
		// runtime can take the source vtable name, strip the
		// src_iface suffix, append the target_iface suffix, and
		// look up the resulting vtable.  R (the receiver type)
		// flows in from the source's vtable name at runtime —
		// we can't bake it in here because the iv is
		// polymorphic.
		bc.Op = BC_IFACE_UPCAST
		bc.Src1 = instr.Args[0].ID
		bc.Aux = addName(buildIfaceUpcastSuffixes(
			instr.Args[0].Typ, instr.Typ))
		return bc, true
	}
	if instr.Op == ir.OP_CALL {
		bc.Op = BC_CALL
		// Imm is the packed slot count (Layer 2 step 2b): a
		// 64-bit-scalar arg packs into 2 slots on a host whose word
		// is < 8 bytes.  On a 64-bit host this equals len(Args).
		var slots int = 0
		for k := 0; k < len(instr.Args); k++ {
			slots = slots + argSlots(instr.Args[k].Typ)
		}
		bc.Imm = slots
		bc.Src1 = callArgBase
		bc.Aux = addName(qualifyCallName(instr.StrVal))
		return bc, true
	}
	if instr.Op == ir.OP_CALL_INDIRECT {
		// Args[0] = native fn pointer (a per-function __shim address);
		// Args[1..] are pre-packed into [callArgBase, callArgBase+N-1].
		// Only `_call_shim_scalar` / `_call_shim_aggregate` reach here
		// after Phase 4 of plan-uniform-native-fnptrs.md.  Shim args
		// are all narrow, so packed slot count == arg count for those
		// shapes (matches the Imm==8/9 shape selectors in
		// dispatchNativeIndirect).
		bc.Op = BC_CALL_INDIRECT
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = callArgBase
		var slots int = 0
		for k := 1; k < len(instr.Args); k++ {
			slots = slots + argSlots(instr.Args[k].Typ)
		}
		bc.Imm = slots
		// `_call_shim_pair` / `_call_shim_quad` share `_call_shim_scalar`'s
		// 8-slot arg shape (data + 7 args) but return a by-value aggregate, so
		// their slot count collides with the scalar selector.  Re-tag by result
		// size with the dedicated selector so dispatchNativeIndirect's bytecode
		// arm captures ALL the words rather than mis-reading it as a scalar (or
		// the wrong width).  A by-value aggregate result (>8 bytes) is unique to
		// these among the OP_CALL_INDIRECT magics — scalar returns an int,
		// aggregate returns void.
		if instr.Typ != nil {
			var rsz int = instr.Typ.SizeOf()
			if rsz > 16 {
				bc.Imm = INDIRECT_SHAPE_QUAD
			} else if rsz > 8 {
				bc.Imm = INDIRECT_SHAPE_PAIR
			}
		}
		return bc, true
	}
	if instr.Op == ir.OP_CALL_FUNC_VALUE {
		// Args[0] = function value (16-byte stack-slot address);
		// Args[1..] are pre-packed into [callArgBase, callArgBase+N-1].
		// Imm is the packed slot count (Layer 2 step 2b).
		bc.Op = BC_CALL_FUNC_VALUE
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = callArgBase
		var slots int = 0
		for k := 1; k < len(instr.Args); k++ {
			slots = slots + argSlots(instr.Args[k].Typ)
		}
		bc.Imm = slots
		return bc, true
	}
	if instr.Op == ir.OP_CALL_HANDLE {
		// Args[0] = handle pointer (*uint8 pointing at a 16-byte
		// {vtable_ptr, data_ptr} block) — same shape as a function
		// value's stack-slot address, so reuse BC_CALL_FUNC_VALUE's
		// runtime handler (reads vtable.call(data, args)).  Phase 4
		// of plan-uniform-native-fnptrs.md.
		bc.Op = BC_CALL_FUNC_VALUE
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = callArgBase
		var slots int = 0
		for k := 1; k < len(instr.Args); k++ {
			slots = slots + argSlots(instr.Args[k].Typ)
		}
		bc.Imm = slots
		return bc, true
	}
	return bc, false
}
