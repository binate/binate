package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"

// funcValueNeedsFrameRec reports whether an OP_FUNC_VALUE's VM closure record
// should live in the constructing frame (reclaimed on frame pop) rather than on
// the heap.  True for a CAPTURING (Args[0] present) func value whose result type
// is a RAW *func (TYP_FUNC_VALUE) — a method value or a *func closure literal.  A
// raw *func has no RefInc/RefDec lifecycle, so a heap record would leak (nothing
// ever frees it); a *func is a BORROW, so its record lives exactly as long as the
// frame that built it (like the closure struct alloca itself).  A managed @func
// (TYP_MANAGED_FUNC_VALUE) is excluded — its record is heap-allocated and freed by
// the value's scope-end RefDec, and it may escape the frame.  A non-capturing value
// (no Args) has no per-value record.  Fail-safe: a false negative (e.g. a wrapped
// type) degrades to the pre-existing heap record, never to corruption.
func funcValueNeedsFrameRec(instr @ir.Instr) bool {
	return len(instr.Args) > 0 && instr.Typ != nil && instr.Typ.Kind == types.TYP_FUNC_VALUE
}

// lowerCallOp lowers the function-value, interface, and call IR ops to
// bytecode — the indirect-dispatch and call family split out of lowerInstr.
// Returns (bc, true) when instr.Op is one of these ops; (bc, false)
// otherwise, so lowerInstr falls through to its remaining cases. bc arrives
// with Dst already set to instr.ID.  allocaOffsets carries the frame-layout
// offsets computed in lowerFunc (indexed by instr.ID) so the OP_FUNC_VALUE arm can
// read the frame slot reserved for a raw *func's closure record.
func lowerCallOp(vm @VM, instr @ir.Instr, bc BCInstr, allocaOffsets *[]int,
		callArgBase int) (BCInstr, bool) {
	if instr.Op == iropcode.OP_FUNC_HANDLE {
		bc.Op = BC_FUNC_HANDLE
		bc.Aux = addName(vm, qualifyCallName(vm, instr.StrVal))
		return bc, true
	}
	if instr.Op == iropcode.OP_STACK_CHECK {
		// Recoverable stack-overflow pre-check for the upcoming call to StrVal
		// (the callee name, same qualification as OP_CALL): Aux = the name-table
		// index the exec resolves to the callee's frame extent.  No result / no
		// arg registers.
		bc.Op = BC_STACK_CHECK
		bc.Dst = -1
		bc.Aux = addName(vm, qualifyCallName(vm, instr.StrVal))
		return bc, true
	}
	if instr.Op == iropcode.OP_STACK_CHECK_FV {
		// Func-value recoverable stack-overflow pre-check for the upcoming call:
		// Src1 = the register holding the func-value operand (Args[0]); the exec
		// resolves a same-vm VM callee from it and faults into this op's cleanup pad
		// on overflow / nil.  No result.
		bc.Op = BC_STACK_CHECK_FV
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		return bc, true
	}
	if instr.Op == iropcode.OP_STACK_CHECK_IM {
		// Iface-method recoverable stack-overflow pre-check: Src1 = the register
		// holding the interface-value receiver (Args[0]); Aux = the absolute method
		// vtable slot (instr.IntVal).  The exec resolves a VM callee from the receiver
		// vtable + slot and faults into this op's cleanup pad on overflow / nil.  No
		// result.
		bc.Op = BC_STACK_CHECK_IM
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		bc.Aux = cast(int, instr.IntVal)
		return bc, true
	}
	if instr.Op == iropcode.OP_FUNC_VALUE {
		bc.Op = BC_FUNC_VALUE
		bc.Aux = addName(vm, qualifyCallName(vm, instr.StrVal))
		// B.2 capturing literal: Args[0] is the alloca'd closure
		// struct pointer.  BC_FUNC_VALUE handler reads from Src1
		// when Src1 != -1 and builds a COMPILED_CLOSURE record
		// per evaluation (see vm_exec_funcref.bn).  Phase 1
		// non-capturing literals leave Args empty / Src1 = -1.
		if len(instr.Args) > 0 {
			bc.Src1 = instr.Args[0].ID
		} else {
			bc.Src1 = -1
		}
		// For a raw *func capturing value (method value / *func closure literal), the
		// closure record lives in the frame, not the heap — carry its frame offset in
		// Imm, biased by +1 so Imm==0 unambiguously means "heap record" (a managed
		// @func, or a wrapped-type fallback).  lowerFunc reserved the slot at
		// allocaOffsets[instr.ID]; the handler recovers the address as
		// frameBase + (Imm - 1).  See funcValueNeedsFrameRec.
		if funcValueNeedsFrameRec(instr) {
			bc.Imm = allocaOffsets[instr.ID] + 1
		}
		return bc, true
	}
	if instr.Op == iropcode.OP_IFACE_VALUE {
		// Aux = name index for the mangled vtable identifier.
		// Src1 = the data ptr register. The handler in
		// vm_exec_helpers.bn looks the vtable up by name on first
		// execution and caches the address.
		//
		// The DYNAMIC-vtable form (empty StrVal, vtable in Args[1]) is the
		// recovered value of an interface-target assertion x.(*J): the vtable
		// word is a runtime register (the SatLookup sub-vtable), not a name.
		// Lower to BC_IFACE_VALUE_DYN, which stores that word verbatim — RTTI
		// Slice 5b-2.
		if len(instr.StrVal) == 0 {
			bc.Op = BC_IFACE_VALUE_DYN
			bc.Src1 = instr.Args[0].ID
			bc.Src2 = instr.Args[1].ID
			return bc, true
		}
		bc.Op = BC_IFACE_VALUE
		bc.Src1 = instr.Args[0].ID
		bc.Aux = addName(vm, instr.StrVal)
		return bc, true
	}
	if instr.Op == iropcode.OP_CALL_IFACE_METHOD {
		// Args[0] = interface value (16-byte stack-slot addr);
		// Args[1..] are pre-packed into [callArgBase, callArgBase+N-1].
		// Aux = method slot index. Imm = packed slot count of the
		// user args (Layer 2 step 2b); the iface's data ptr is
		// prepended by the handler in slot 0.
		bc.Op = BC_CALL_IFACE_METHOD
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = callArgBase
		var slots int = 0
		for k := 1; k < len(instr.Args); k++ {
			slots = slots + argSlots(instr.Args[k].Typ)
		}
		// Imm packs the user-arg slot count (low 16 bits) with the argument-
		// interface-layout index (bits [16,25], over Args[1..]).  When the iface
		// value's vtable is NATIVE (an injected COMPILED package), dispatchCompiled-
		// IfaceMethod runs the method as native code, so a bytecode-impl iface arg
		// (top-level OR nested in a by-value aggregate) needs its VM-index vtable
		// word substituted for the impl's native handle-vtable — same treatment as
		// the func-value sibling.  (No injected
		// stdlib iface method takes an iface arg today, so the index is 0 in
		// practice; it fires for an embedder-injected native package whose iface
		// method does.)  The VM-push arm masks the index off via ifaceMethodImmSlots.
		bc.Imm = packIfaceMethodImm(slots, buildArgIfaceLayout(vm, instr.Args, 1))
		// Aux packs the method vtable slot with the AGGREGATE RETBUF SIZE
		// (instr.RetbufSize, stamped at IR-gen from the method's full result list; 0
		// for a scalar return) in a WIDE low field.  This lets the native-vtable
		// dispatch path (dispatchCompiledIfaceMethod, reached when the iface value
		// came from an injected COMPILED package) pick the shim shape — retbuf when
		// nonzero, scalar when 0 — agreeing with codegen's isAggregateReturn.
		// Deriving it from instr.Typ.SizeOf() here was the B1/C1 bug: a <=8-byte
		// coerced struct / multi-return (lowered to an anonymous tuple) reads <=8 and
		// mis-dispatches scalar.  The retbuf field's bit 0 also carries the scalar64
		// flag (packRetbufScalar64): a bare 64-bit scalar return has retbuf size 0
		// but must be read back as a register PAIR on ILP32.  The retbuf field is
		// wide (not the old 16-bit high half) so a ≥64 KB aggregate return no longer
		// under-reserves; the small method
		// slot takes the narrow high field.  See vm_crossmode_ret64.bn.
		bc.Aux = packIfaceMethodAux(instr.Index, instr.RetbufSize,
				is64BitScalarReturn(instr.Typ, REG_SLOT))
		return bc, true
	}
	if instr.Op == iropcode.OP_IFACE_DTOR {
		// Load slot 0 (the dtor's 1-based VM func index, or 0 if
		// the receiver type has no dtor) from the iv's vtable.
		// Src1 = iv slot addr; Dst gets the int directly. The
		// downstream consumer is BC_REFDEC_INLINE_FAST, which
		// reads the dtor func index from a register.
		bc.Op = BC_IFACE_DTOR
		bc.Src1 = instr.Args[0].ID
		return bc, true
	}
	if instr.Op == iropcode.OP_IFACE_TYPEINFO {
		// Read slot 1 (the dynamic *TypeInfo) of the iv's vtable.  Src1 = iv
		// slot addr; Dst receives the *TypeInfo address (as int).
		// BC_IFACE_TYPEINFO branches on ifaceVtIsNative — a VM-built iv
		// resolves through vm.IfaceVtables[idx-1].Methods[1] (the materialized
		// __typeinfo.<R> address), a native-injected iv reads its @__ivt slot 1.
		bc.Op = BC_IFACE_TYPEINFO
		bc.Src1 = instr.Args[0].ID
		return bc, true
	}
	if instr.Op == iropcode.OP_SAT_LOOKUP {
		// RTTI Slice 5b-2: resolve the interface-satisfaction query
		// (Src1 = *TypeInfo reg, Src2 = &__ifaceid.<J> reg) -> sub-vtable word
		// via the VM's own registry (lookupSatEntry).  MUST precede the OP_CALL
		// arm below: OP_SAT_LOOKUP carries rt.SatLookup's name (so the native
		// backends lower it as that call), but the VM's bytecode rt.SatLookup
		// would MISS, so the VM resolves it against @VM state instead.
		bc.Op = BC_SAT_LOOKUP
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc, true
	}
	if instr.Op == iropcode.OP_FUNC_VALUE_DTOR {
		// Load vtable.Dtor (slot 0 of the @func value's vtable, or
		// 0 if the fv is nil or has no dtor).  Src1 = fv stack
		// addr; Dst receives the int (a function pointer's bits or
		// a 1-based VM func index, per the dtor's runtime kind).
		// Feeds BC_REFDEC_INLINE_FAST's Src2 dtor slot; today VM-
		// constructed fvs always carry Dtor=0 (Phase 2 closure-
		// struct dtors not wired yet — see ensureHandle in
		// vm_exec_funcref.bn), so the path is operationally
		// equivalent to RawFree.  Surfacing the load anyway keeps
		// the VM lowering honest and unblocks the Phase 2 wiring.
		bc.Op = BC_FUNC_VALUE_DTOR
		bc.Src1 = instr.Args[0].ID
		return bc, true
	}
	if instr.Op == iropcode.OP_IFACE_UPCAST {
		// Src1 = source
		// iv's stack addr; Dst = result iv's stack addr.  The runtime takes
		// two paths by source-vtable kind (ifaceVtIsNative):
		//
		//   * VM-built source — Aux encodes a combined string
		//     `<src_iface_suffix>|<target_iface_suffix>`; the runtime strips
		//     the src-iface suffix off the source vtable name, appends the
		//     target's, and looks the result up in vm.IfaceVtables.  R (the
		//     receiver type) flows in from the source's vtable name at runtime
		//     — it can't be baked here because the iv is polymorphic.
		//
		//   * COMPILED (injected) source — Imm carries the parent-interface
		//     vtable SLOT offset, precomputed at IR-gen (EmitIfaceUpcast) via
		//     IfaceParentSlotOffset and read off the same instr field the
		//     LLVM/native backends use.  The runtime advances the native
		//     vtable pointer by offset slots (mirroring emit_iface_upcast.bn)
		//     instead of a name swap.  0 for upcast-to-`any` / managed<->raw
		//     decay; -1 (invalid upcast the checker rejects) aborts at runtime.
		bc.Op = BC_IFACE_UPCAST
		bc.Src1 = instr.Args[0].ID
		bc.Aux = addName(vm, buildIfaceUpcastSuffixes(
				instr.Args[0].Typ, instr.Typ))
		bc.Imm = instr.IfaceUpcastSlotOffset
		return bc, true
	}
	if instr.Op == iropcode.OP_CALL {
		bc.Op = BC_CALL
		// Imm is the packed slot count (Layer 2 step 2b): a 64-bit-scalar
		// arg packs into 2 slots on a host whose word is < 8 bytes.  A
		// by-value aggregate (coerced or byval) rides ONE by-address slot
		// — the per-function shim loads + re-coerces it to the underlying's
		// ABI (emit_funcvals_shim) — identical to the OP_CALL_IFACE_METHOD
		// / func-value packing.
		var slots int = 0
		// Total packed slot count (a 64-bit scalar takes 2 slots on ILP32; a by-value
		// aggregate rides 1 by-address slot).  Any `*[]*any` (raw-slice-of-raw-iface)
		// arg whose ELEMENTS need cross-mode vtable substitution is recorded per-slot in
		// the ArgIfaceLayout (buildArgIfaceLayout, below) — a list, not a slot bitmap,
		// since the 64-slot dispatch buffer outruns a host int on ILP32.
		for k := 0; k < len(instr.Args); k++ {
			slots = slots + argSlots(instr.Args[k].Typ)
		}
		// Argument-interface-layout index: an injected-NATIVE callee can't deref a
		// bytecode impl's VM-index vtable word (SIGSEGV); the extern dispatch uses
		// this layout to substitute a native handle-vtable for the interface args
		// (top-level OR nested in a by-value aggregate).
		// Built ONLY for a call whose target is an injected extern (callTargetIs-
		// Extern is decidable at lower time, since externs register before lowering):
		// a vm-func BC_CALL never dispatches cross-mode, so it needs no layout, which
		// also keeps the per-function index space tiny.  0 = no interface args.
		var layoutIdx int = 0
		if callTargetIsExtern(vm, instr) {
			layoutIdx = buildArgIfaceLayout(vm, instr.Args, 0)
		}
		// Imm bit 20 (packCallImm) flags a 64-bit-scalar return: a direct call
		// (extern OR vm-func) returning a bare int64/uint64/float64 must be read
		// back as a register PAIR on ILP32 via _call_shim_scalar64, not the
		// truncating _call_shim_scalar — see vm_crossmode_ret64.bn.  The three
		// BC_CALL Imm readers (the >7 guard, the extern arg-copy, the vm-func
		// arg-copy) all mask the flag + layout index off via callImmSlots.
		bc.Imm = packCallImm(slots, is64BitScalarReturn(instr.Typ, REG_SLOT), layoutIdx)
		bc.Src1 = callArgBase
		bc.Aux = addName(vm, qualifyCallName(vm, instr.StrVal))
		return bc, true
	}
	if instr.Op == iropcode.OP_CALL_INDIRECT {
		// Args[0] = native fn pointer (a per-function __shim address);
		// Args[1..] are pre-packed into [callArgBase, callArgBase+N-1].
		// Only `_call_shim_scalar` / `_call_shim_aggregate` reach here
		// Shim args
		// are all narrow, so packed slot count == arg count for those
		// shapes (matches the Imm==8/9 shape selectors in
		// dispatchNativeIndirect).
		bc.Op = BC_CALL_INDIRECT
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = callArgBase
		var slots int = 0
		for k := 1; k < len(instr.Args); k++ {
			slots = slots + argSlots(instr.Args[k].Typ)
		}
		bc.Imm = slots
		// Aux flags a 64-bit-scalar return (the _call_shim_scalar64 primitive,
		// whose result is int64) for the nested-VM path: _call_shim_scalar64 has
		// the same 8-arg shape as _call_shim_scalar (both Imm==8), so
		// dispatchNativeIndirect cannot tell them apart by Imm and reads this
		// flag to pick the wide primitive + pair split.  Aux is otherwise unused
		// on BC_CALL_INDIRECT.
		if is64BitScalarReturn(instr.Typ, REG_SLOT) {
			bc.Aux = 1
		}
		return bc, true
	}
	if instr.Op == iropcode.OP_CALL_FUNC_VALUE {
		// Args[0] = function value (16-byte stack-slot address);
		// Args[1..] are pre-packed into [callArgBase, callArgBase+N-1].
		// Imm is the packed slot count (Layer 2 step 2b).  Aux carries the
		// AGGREGATE RETBUF SIZE (instr.RetbufSize, stamped at IR-gen from the
		// func value's result list; 0 for a scalar return) so the cross-mode
		// dispatch (dispatchCompiledFuncValue) picks the retbuf shim when
		// nonzero; the VM-side push path ignores Aux.  Without this a func
		// value of a native-injected function returning an aggregate (e.g.
		// strconv.Itoa → @[]char, or a <=8-byte coerced struct) dispatches
		// through the scalar shim and loses its result.
		bc.Op = BC_CALL_FUNC_VALUE
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = callArgBase
		var slots int = 0
		for k := 1; k < len(instr.Args); k++ {
			slots = slots + argSlots(instr.Args[k].Typ)
		}
		// Imm packs the user-arg slot count (low 16 bits) with the argument-
		// interface-layout index (bits [16,25], over the user args Args[1..], which
		// pack at a0..).  A COMPILED-side (native) func value dispatched from bytecode
		// with a bytecode-impl iface arg (top-level OR nested in a by-value aggregate)
		// would fault dereferencing its VM-index vtable word, so the cross-mode
		// dispatch substitutes those args.  Both dispatch
		// paths mask the index off via funcValueImmSlots.
		bc.Imm = packFuncValueImm(slots, buildArgIfaceLayout(vm, instr.Args, 1))
		// Aux is the retbuf field (retbuf size + the scalar64 flag in bit 0, so
		// dispatchCompiledFuncValue reads a 64-bit-scalar return back as a register
		// PAIR) at FULL width — the interface layout moved to Imm, so the retbuf field
		// no longer shares Aux with a bitmap and a ≥64 KB aggregate return no longer
		// under-reserves.  The VM-push path
		// ignores Aux.  Read via retbufFieldBytes / retbufFieldScalar64 directly.
		bc.Aux = packRetbufScalar64(instr.RetbufSize, is64BitScalarReturn(instr.Typ, REG_SLOT))
		return bc, true
	}
	if instr.Op == iropcode.OP_CALL_HANDLE {
		// Args[0] = handle pointer (*uint8 pointing at a 16-byte
		// {vtable_ptr, data_ptr} block) — same shape as a function
		// value's stack-slot address, so reuse BC_CALL_FUNC_VALUE's
		// runtime handler (reads vtable.call(data, args)).  Aux = the
		// aggregate retbuf
		// size (instr.RetbufSize), which EmitCallHandle leaves 0: handle
		// calls are emitted only for `_call_dtor` / `_call_free_fn`, both
		// VOID, so the aggregate retbuf path is never taken.
		bc.Op = BC_CALL_FUNC_VALUE
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = callArgBase
		var slots int = 0
		for k := 1; k < len(instr.Args); k++ {
			slots = slots + argSlots(instr.Args[k].Typ)
		}
		bc.Imm = slots
		// OP_CALL_HANDLE is emitted only for VOID _call_dtor / _call_free_fn, so
		// the scalar64 flag is always clear here; packed uniformly for symmetry.
		bc.Aux = packRetbufScalar64(instr.RetbufSize, is64BitScalarReturn(instr.Typ, REG_SLOT))
		return bc, true
	}
	return bc, false
}
