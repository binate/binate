package "pkg/binate/vm"

import "pkg/builtins/testing"

// A direct call whose aggregate result is stored whole into a local delivers it there:
// the BC_CALL carries the local's frame offset (Src2, plus one), the store is a BC_NOP,
// and the caller reserves no stack for a result image.  A result stored elsewhere (a
// package variable) keeps the image.
func TestCallResultIntoLocalSlot() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "type W struct { a [64]int64 }\n")
	src = concatStr(src, "var g W\n")
	src = concatStr(src, "func get(s *W) W { return *s }\n")
	src = concatStr(src, "func toLocal(s *W) int64 {\n\tvar r W = get(s)\n\treturn r.a[3]\n}\n")
	src = concatStr(src, "func toGlobal(s *W) { g = get(s) }\n")
	src = concatStr(src, "func main() {}\n")
	var vm @VM = lowerFromSource(src)
	var local @VMFunc = findVMFunc(vm, "test.toLocal")
	var global @VMFunc = findVMFunc(vm, "test.toGlobal")
	if local == nil || global == nil { return "toLocal and toGlobal are lowered" }
	if callSlotOf(local) <= 0 { return "the call into a local carries the local's frame offset" }
	if countOpsIn(vm, "test.toLocal", BC_MEMCPY) != 0 { return "the store into the local is a BC_NOP" }
	if local.MaxStmtTempGrowth != 0 { return "a call into a local reserves no result image" }
	if hasOpAux(local, BC_STACK_ALLOC, 64 * 8) { return "the local is not zeroed after the delivery" }
	if callSlotOf(global) != 0 { return "a call stored into a package variable delivers no slot" }
	if global.MaxStmtTempGrowth < 64 * 8 { return "a call stored elsewhere reserves its result image" }
	return ""
}

// findVMFunc returns vm's function name, or nil.
func findVMFunc(vm @VM, name *[]readonly char) @VMFunc {
	for i := 0; i < vm.Funcs.Len(); i++ {
		if streq(vm.Funcs.Get(i).Name, name) { return vm.Funcs.Get(i) }
	}
	return nil
}

// hasOpAux reports whether f's code has an op with that Aux.
func hasOpAux(f @VMFunc, op int, aux int) bool {
	for i := 0; i < len(f.Code); i++ {
		if f.Code[i].Op == op && f.Code[i].Aux == aux { return true }
	}
	return false
}

// callSlotOf returns the Src2 of f's one BC_CALL, or -1 without one.
func callSlotOf(f @VMFunc) int {
	for i := 0; i < len(f.Code); i++ {
		if f.Code[i].Op == BC_CALL { return f.Code[i].Src2 }
	}
	return -1
}

// A result returned from a load read in place is copied out at the return, wherever its
// source lies: held while a later argument changes the source, it keeps its value (the
// caller would otherwise hold an alias of the source).
func TestReturnedInPlaceLoadIsCopiedOut() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type W struct { a [8]int64 }\n"
			"func get(s *W) W { return *s }\n"
			"func bump(s *W) int64 {\n\ts.a[0] = 9\n\treturn 1\n}\n"
			"func use(v W, k int64) int64 { return v.a[0] * 10 + k }\n"
			"func main() int {\n\tvar x W\n\tx.a[0] = 3\n\treturn cast(int, use(get(&x), bump(&x)))\n}\n"
	if runVMAtLevel(src, 0) != 31 { return "the returned value is the source as it was at the return" }
	return ""
}

// A call delivering its result into a slot leaves its own register holding the slot's
// address: a fault pad run before the slot's store releases the result through that
// register.  `return mk(), a[i]` with a pending defer stores mk's managed result in a
// slot the call writes (the deferred return's), and a[i] faulting runs a pad that
// releases the result -- neither crashing on an unwritten register nor leaking.
func TestResultSlotCallFaultBeforeStore() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type R struct { s @[]int }\n"
			"func mk() R {\n\tvar r R\n\tr.s = make_slice(int, 3)\n\treturn r\n}\n"
			"func touch(a @[]int) { a[0] = 1 }\n"
			"func two(a @[]int, i int) (R, int) {\n\tdefer { touch(a) }\n\treturn mk(), a[i]\n}\n"
			"func doFault() int {\n\tvar a @[]int = make_slice(int, 2)\n\tr, n := two(a, 5)\n"
			"\treturn len(r.s) + n\n}\n"
	var vm @VM = lowerFromSource(src)
	var two @VMFunc = findVMFunc(vm, "test.two")
	if two == nil || callSlotOf(two) <= 0 { return "mk's result is delivered into a slot" }
	var d int = faultLoopDelta(src, "test.doFault", 0, 30, true)
	if d == -1000000 { return "two(a, 5) faults" }
	if d != 0 { return "the result delivered into the slot is released on the fault" }
	return ""
}
