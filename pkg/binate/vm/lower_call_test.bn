package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for lowerCallOp (lower_call.bn): lowering of the function-value,
// interface, and call IR ops. Shared helpers (concatStr, lowerFromSource,
// streq) live in the sibling vm test files (same package).

func TestLowerCallArgPacking() testing.TestResult {
	// Calls should emit MOV instructions to pack args
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func add(a int, b int) int {\n")
	src = concatStr(src, "  return a + b\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  return add(10, 20)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	// Find main's BC_CALL and verify MOVs precede it
	var mainIdx int = -1
	for i := 0; i < vm.Funcs.Len(); i++ {
		if streq(vm.Funcs.Get(i).Name, "test.main") {
			mainIdx = i
		}
	}
	if mainIdx < 0 { return "main not found" }
	var callIdx int = -1
	for i := 0; i < len(vm.Funcs.Get(mainIdx).Code); i++ {
		if vm.Funcs.Get(mainIdx).Code[i].Op == BC_CALL {
			callIdx = i
		}
	}
	if callIdx < 0 { return "expected BC_CALL" }
	// Should have MOVs before the call for arg packing
	if callIdx < 2 { return "expected MOVs before BC_CALL" }
	if vm.Funcs.Get(mainIdx).Code[callIdx - 1].Op != BC_MOV &&
			vm.Funcs.Get(mainIdx).Code[callIdx - 2].Op != BC_MOV {
		return "expected MOV for arg packing"
	}
	return ""
}

// mainCallImm returns the Imm of the (single) BC_CALL in test.main lowered from
// src, or -1 if none.
func mainCallImm(src *[]readonly char) int {
	var vm @VM = lowerFromSource(src)
	var mainIdx int = -1
	for i := 0; i < vm.Funcs.Len(); i++ {
		if streq(vm.Funcs.Get(i).Name, "test.main") { mainIdx = i }
	}
	if mainIdx < 0 { return -1 }
	for i := 0; i < len(vm.Funcs.Get(mainIdx).Code); i++ {
		if vm.Funcs.Get(mainIdx).Code[i].Op == BC_CALL {
			return vm.Funcs.Get(mainIdx).Code[i].Imm
		}
	}
	return -1
}

// TestLowerCall64BitScalarReturnFlag: a direct call whose result is a bare
// int64 stamps the scalar64 flag into the BC_CALL Imm on a 32-bit host, so the
// cross-mode extern dispatch reads the return back as a register PAIR via
// _call_shim_scalar64.  Like the pair-variant cast tests, the ILP32 branch runs
// only on a 32-bit-host unit build (REG_SLOT < 8); on LP64 the flag is absent.
func TestLowerCall64BitScalarReturnFlag() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func g() int64 {\n")
	src = concatStr(src, "  return 5\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() int64 {\n")
	src = concatStr(src, "  return g()\n")
	src = concatStr(src, "}\n")
	var imm int = mainCallImm(src)
	if imm < 0 { return "expected BC_CALL to g" }
	if REG_SLOT < 8 {
		if !callImmScalar64(imm) {
			return "ILP32: int64-return BC_CALL must carry the scalar64 flag"
		}
	} else {
		if callImmScalar64(imm) {
			return "LP64: int64-return BC_CALL must not carry the scalar64 flag"
		}
	}
	return ""
}

// TestLowerCallNarrowReturnNoFlag: a call whose result is a host-width int (not a
// 64-bit scalar) never carries the scalar64 flag, on any host.
func TestLowerCallNarrowReturnNoFlag() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func g() int {\n")
	src = concatStr(src, "  return 5\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  return g()\n")
	src = concatStr(src, "}\n")
	var imm int = mainCallImm(src)
	if imm < 0 { return "expected BC_CALL to g" }
	if callImmScalar64(imm) {
		return "int-return BC_CALL must never carry the scalar64 flag"
	}
	return ""
}

// lowerRawCallInstr builds a minimal call IR instr — one leading Arg (the
// callee / receiver / fn-ptr) and no user args — with the given op, result
// type, retbuf size, and method-slot Index, and lowers it.  The func-value /
// iface / indirect ops need no name table, but the VM is still built via NewVM
// (the standard constructor — a bare `make(VM)` leaves its vector-typed fields
// nil).  Used to pin the scalar64 Aux stamp on the three forward dispatch sites
// the source-driven BC_CALL test can't reach.
func lowerRawCallInstr(op int, typ @types.Type, retbufSize int, index int) BCInstr {
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var a0 @ir.Instr = make(ir.Instr)
	a0.ID = 10
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = a0
	var instr @ir.Instr = make(ir.Instr)
	instr.Op = op
	instr.ID = 11
	instr.Args = args
	instr.Typ = typ
	instr.RetbufSize = retbufSize
	instr.Index = index
	var emptyOffsets @[]int
	var vm @VM = newTestVM(1024)
	return lowerInstr(vm, instr, emptyOffsets, emptyOffsets, f, 0)
}

// TestLowerFuncValueCall64BitReturnFlag: a func-value call whose result is a
// bare int64 stamps the scalar64 flag into BC_CALL_FUNC_VALUE's Aux bit 0 (the
// retbuf size is 0 for a scalar, so the whole field is the flag) on a 32-bit
// host, and leaves it clear on LP64.  A non-64-bit result never sets it.
func TestLowerFuncValueCall64BitReturnFlag() testing.TestResult {
	var bc BCInstr = lowerRawCallInstr(iropcode.OP_CALL_FUNC_VALUE, types.TypInt64(), 0, 0)
	if bc.Op != BC_CALL_FUNC_VALUE { return "expected BC_CALL_FUNC_VALUE" }
	if REG_SLOT < 8 {
		if !retbufFieldScalar64(bc.Aux) {
			return "ILP32: int64-return func value must set the scalar64 Aux flag"
		}
	} else {
		if retbufFieldScalar64(bc.Aux) {
			return "LP64: func value must not set the scalar64 Aux flag"
		}
	}
	var bcNarrow BCInstr = lowerRawCallInstr(iropcode.OP_CALL_FUNC_VALUE, types.TypInt32(), 0, 0)
	if retbufFieldScalar64(bcNarrow.Aux) {
		return "int32-return func value must never set the scalar64 flag"
	}
	return ""
}

// TestLowerIfaceMethod64BitReturnFlag: an interface method whose result is a
// bare int64 stamps the scalar64 flag into bit 0 of BC_CALL_IFACE_METHOD's Aux
// retbuf field, leaving the method vtable slot (the Aux high sub-field) intact,
// on a 32-bit host; clear on LP64.  The retbuf field is the WIDE low sub-field
// now (follow-up #2), so the decode goes through ifaceMethodAux* not raw masks.
func TestLowerIfaceMethod64BitReturnFlag() testing.TestResult {
	var slot int = 3
	var bc BCInstr = lowerRawCallInstr(iropcode.OP_CALL_IFACE_METHOD, types.TypInt64(), 0, slot)
	if bc.Op != BC_CALL_IFACE_METHOD { return "expected BC_CALL_IFACE_METHOD" }
	if ifaceMethodAuxSlot(bc.Aux) != slot {
		return "method slot must survive in the Aux slot sub-field"
	}
	var retbufField int = ifaceMethodAuxRetbufField(bc.Aux)
	if REG_SLOT < 8 {
		if !retbufFieldScalar64(retbufField) {
			return "ILP32: int64-return iface method must set the retbuf scalar64 flag"
		}
	} else {
		if retbufFieldScalar64(retbufField) {
			return "LP64: iface method must not set the retbuf scalar64 flag"
		}
	}
	return ""
}

// TestLowerCallIndirect64BitReturnFlag: an OP_CALL_INDIRECT whose result is a
// bare int64 (the _call_shim_scalar64 primitive) sets BC_CALL_INDIRECT's Aux to
// flag the nested-VM dispatch, since its 8-arg shape collides with the plain
// _call_shim_scalar in the Imm shape selector; clear on LP64 and for a narrow
// result.
func TestLowerCallIndirect64BitReturnFlag() testing.TestResult {
	var bc BCInstr = lowerRawCallInstr(iropcode.OP_CALL_INDIRECT, types.TypInt64(), 0, 0)
	if bc.Op != BC_CALL_INDIRECT { return "expected BC_CALL_INDIRECT" }
	if REG_SLOT < 8 {
		if bc.Aux == 0 {
			return "ILP32: int64-return indirect call must set the Aux flag"
		}
	} else {
		if bc.Aux != 0 {
			return "LP64: indirect call must not set the Aux flag"
		}
	}
	var bcNarrow BCInstr = lowerRawCallInstr(iropcode.OP_CALL_INDIRECT, types.TypInt32(), 0, 0)
	if bcNarrow.Aux != 0 {
		return "int32-return indirect call must never set the Aux flag"
	}
	return ""
}

// OP_FUNC_VALUE_DTOR was previously hitting the default arm of
// lowerInstr (silent BC_NOP), which masked a real miscompile: the
// downstream BC_REFDEC_INLINE_FAST read its dtor reg from whatever
// stale register the NOP left, dispatching with garbage or 0 and
// thereby skipping the closure-struct dtor for managed func values.
// Pin the dedicated lowering so the wiring stays honest.
func TestLowerOpFuncValueDtor() testing.TestResult {
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var argInstr @ir.Instr = make(ir.Instr)
	argInstr.ID = 42
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = argInstr
	var instr @ir.Instr = make(ir.Instr)
	instr.Op = iropcode.OP_FUNC_VALUE_DTOR
	instr.ID = 43
	instr.Args = args
	var emptyOffsets @[]int
	var vm @VM = newTestVM(1024)
	var bc BCInstr = lowerInstr(vm, instr, emptyOffsets, emptyOffsets, f, 0)
	if bc.Op != BC_FUNC_VALUE_DTOR {
		return "expected BC_FUNC_VALUE_DTOR"
	}
	if bc.Src1 != 42 {
		return "expected Src1 = fv arg instr ID"
	}
	if bc.Dst != 43 {
		return "expected Dst = OP_FUNC_VALUE_DTOR's own ID"
	}
	return ""
}
