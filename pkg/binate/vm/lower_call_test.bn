package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for lowerCallOp (lower_call.bn): lowering of the function-value,
// interface, and call IR ops. Shared helpers (concatStr, lowerFromSource,
// streq) live in the sibling vm test files (same package).

func TestLowerCallArgPacking() testing.TestResult {
	// Calls should emit MOV instructions to pack args
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func add(a int, b int) int {\n")
	src = concatStr(src, "  return a + b\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  return add(10, 20)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	// Find main's BC_CALL and verify MOVs precede it
	var mainIdx int = -1
	for i := 0; i < len(vm.Funcs); i++ {
		if streq(vm.Funcs[i].Name, "test.main") {
			mainIdx = i
		}
	}
	if mainIdx < 0 { return "main not found" }
	var callIdx int = -1
	for i := 0; i < len(vm.Funcs[mainIdx].Code); i++ {
		if vm.Funcs[mainIdx].Code[i].Op == BC_CALL {
			callIdx = i
		}
	}
	if callIdx < 0 { return "expected BC_CALL" }
	// Should have MOVs before the call for arg packing
	if callIdx < 2 { return "expected MOVs before BC_CALL" }
	if vm.Funcs[mainIdx].Code[callIdx-1].Op != BC_MOV &&
		vm.Funcs[mainIdx].Code[callIdx-2].Op != BC_MOV {
		return "expected MOV for arg packing"
	}
	return ""
}

// OP_FUNC_VALUE_DTOR was previously hitting the default arm of
// lowerInstr (silent BC_NOP), which masked a real miscompile: the
// downstream BC_REFDEC_INLINE_FAST read its dtor reg from whatever
// stale register the NOP left, dispatching with garbage or 0 and
// thereby skipping the closure-struct dtor for managed func values.
// Pin the dedicated lowering so the wiring stays honest.
func TestLowerOpFuncValueDtor() testing.TestResult {
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("test", noParams, noResults)
	var argInstr @ir.Instr = make(ir.Instr)
	argInstr.ID = 42
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = argInstr
	var instr @ir.Instr = make(ir.Instr)
	instr.Op = ir.OP_FUNC_VALUE_DTOR
	instr.ID = 43
	instr.Args = args
	var emptyOffsets @[]int
	var vm @VM = make(VM)
	var bc BCInstr = lowerInstr(vm, instr, emptyOffsets, emptyOffsets, f, 0)
	if bc.Op != BC_FUNC_VALUE_DTOR {
		return "expected BC_FUNC_VALUE_DTOR"
	}
	if bc.Src1 != 42 {
		return "expected Src1 = fv arg instr ID"
	}
	if bc.Dst != 43 {
		return "expected Dst = OP_FUNC_VALUE_DTOR's own ID"
	}
	return ""
}
