package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// lowerCast handles OP_CAST — integer ↔ integer (incl. int32↔int64
// width changes), integer ↔ float (BC_SITOF / BC_FTOSI / BC_F32TOSI),
// and float ↔ float width changes (BC_F64_TO_F32 / BC_F32_TO_F64).
//
// Layer 2: on a host whose word is < 8 bytes, int64/uint64 occupies
// a register pair, so a crossing between pair and single-slot must
// widen (BC_WIDEN64_S/U) or narrow (BC_NARROW64) rather than MOV.
//
// VM register form for floats: the IEEE bits in the type's declared
// width — float64 in 8 bytes, float32 in low 4 bytes (zero-extended).
// Untyped-float literals start at float64 precision (BC_LOAD_IMM
// stores the parsed float64 bit pattern), so for cast-emission
// purposes we treat them as 64-bit on the source side.
func lowerCast(instr @ir.Instr, bc BCInstr) BCInstr {
	// Peel TYP_NAMED: a cast to/from a named distinct scalar selects its
	// fp/int conversion, width, and signedness from the underlying.
	var srcTyp @types.Type = vmUnwrapNamed(instr.Args[0].Typ)
	var dstTyp @types.Type = vmUnwrapNamed(instr.TypeArg)
	var srcIsFloat bool = srcTyp != nil &&
		(srcTyp.Kind == types.TYP_FLOAT ||
			srcTyp.Kind == types.TYP_UNTYPED_FLOAT)
	var dstIsFloat bool = dstTyp != nil &&
		(dstTyp.Kind == types.TYP_FLOAT ||
			dstTyp.Kind == types.TYP_UNTYPED_FLOAT)
	var srcW int = 64
	if srcTyp != nil && srcTyp.Kind == types.TYP_FLOAT &&
			srcTyp.Width > 0 {
		srcW = srcTyp.Width
	}
	var dstW int = 64
	if dstTyp != nil && dstTyp.Kind == types.TYP_FLOAT &&
			dstTyp.Width > 0 {
		dstW = dstTyp.Width
	}
	if !srcIsFloat && dstIsFloat {
		// Integer → float. BC_SITOF/BC_UITOF land at float64; if dst is
		// float32 we narrow afterwards. Today narrowing-int-to-f32
		// isn't exercised; emit the simple form and let future work
		// add a fused BC_SITOF32 if needed.  The source's signedness
		// picks the conversion: an unsigned source with its high bit set
		// must convert to a large positive double, not a negative one.
		// Only a concrete unsigned integer type (TYP_INT, !Signed)
		// qualifies — an untyped int literal defaults to signed `int`
		// (its Signed flag is unset, so an IsInteger()+!Signed test
		// would misclassify it as unsigned).
		if srcTyp != nil && srcTyp.Kind == types.TYP_INT &&
				!srcTyp.Signed {
			bc.Op = BC_UITOF
		} else {
			bc.Op = BC_SITOF
		}
	} else if srcIsFloat && !dstIsFloat {
		if srcW == 32 {
			bc.Op = BC_F32TOSI
		} else if common.IsUnsignedIntType(dstTyp) {
			// float64 → unsigned: a value in [2^63, 2^64) must land as
			// the right large unsigned, not the saturated/overflowed
			// signed result BC_FTOSI gives.  (float32 → unsigned is not
			// yet exercised; it stays on the signed BC_F32TOSI above.)
			bc.Op = BC_FTOUI
		} else {
			bc.Op = BC_FTOSI
		}
	} else if srcIsFloat && dstIsFloat {
		if srcW == 64 && dstW == 32 {
			bc.Op = BC_F64_TO_F32
		} else if srcW == 32 && dstW == 64 {
			bc.Op = BC_F32_TO_F64
		} else {
			bc.Op = BC_MOV
		}
	} else {
		// Integer ↔ integer.  Layer 2: pair ↔ single-slot crossings
		// must widen or narrow rather than MOV.
		var srcIs64 bool = is64BitScalar(srcTyp) && REG_SLOT < 8
		var dstIs64 bool = is64BitScalar(dstTyp) && REG_SLOT < 8
		if srcIs64 && !dstIs64 {
			if dstTyp != nil && dstTyp.Width == 8 {
				// BC_TRUNC8 reads regs[Src1] (the low slot of the
				// pair) and masks to 8 bits — correct, since the
				// low byte of a little-endian int64 lives there.
				bc.Op = BC_TRUNC8
			} else {
				bc.Op = BC_NARROW64
			}
		} else if !srcIs64 && dstIs64 {
			// Single slot → pair.  Sign- or zero-extend based on the
			// *source* signedness (the dst's signedness only
			// determines how downstream reads the bits).
			if srcTyp != nil && srcTyp.IsInteger() &&
					!srcTyp.Signed {
				bc.Op = BC_WIDEN64_U
			} else {
				bc.Op = BC_WIDEN64_S
			}
		} else {
			// Single-slot ↔ single-slot.  Widths may still differ
			// in bits — on a 64-bit host this covers int↔int32
			// (TRUNC32 / SEXT|ZEXT 32-bit); on any host this covers
			// the int8/int16 narrow-int family.  Without proper
			// narrow/widen here, `cast(int64, cast(int32, x))` (the
			// widen64Signed idiom) silently leaves the upper bits
			// as they were rather than sign-extending bit 31.
			bc.Op = pickSingleSlotIntCastOp(srcTyp, dstTyp)
			if bc.Op == BC_SEXT || bc.Op == BC_ZEXT {
				bc.Imm = intBitWidth(srcTyp)
			}
		}
	}
	bc.Src1 = instr.Args[0].ID
	return bc
}

// pickSingleSlotIntCastOp chooses the bytecode for an int↔int cast
// that doesn't cross the pair boundary.  When widths match, BC_MOV
// (no-op reinterpret — same bit pattern, possibly different sign
// interpretation, which the consumer's op handles).  When narrowing,
// BC_TRUNC8 / BC_TRUNC32 mask the low bits (upper zero-filled).
// When widening, BC_SEXT (signed src) / BC_ZEXT (unsigned src) fill
// the upper bits per the source's sign — the destination's
// signedness only governs how downstream consumers read the result.
// 16-bit narrowing isn't exercised today and falls back to BC_MOV.
func pickSingleSlotIntCastOp(srcTyp @types.Type,
		dstTyp @types.Type) int {
	if srcTyp == nil || dstTyp == nil { return BC_MOV }
	var srcW int = intBitWidth(srcTyp)
	var dstW int = intBitWidth(dstTyp)
	if srcW == dstW { return BC_MOV }
	if srcW > dstW {
		if dstW == 8 { return BC_TRUNC8 }
		if dstW == 32 { return BC_TRUNC32 }
		return BC_MOV
	}
	if srcTyp.IsInteger() && !srcTyp.Signed { return BC_ZEXT }
	return BC_SEXT
}

// intBitWidth returns the effective bit width of an integer type.
// Untyped int and types without an explicit Width fall back to the
// host word width (REG_SLOT * 8) — at lowering time an untyped int
// has either already been narrowed to a concrete type or is
// indistinguishable from a host-int from the bytecode's view.
func intBitWidth(t @types.Type) int {
	if t == nil { return REG_SLOT * 8 }
	t = vmUnwrapNamed(t)
	if t.Width > 0 { return t.Width }
	return REG_SLOT * 8
}
