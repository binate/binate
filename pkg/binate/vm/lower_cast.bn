package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"

// lowerCast handles OP_CAST — integer ↔ integer (incl. int32↔int64
// width changes), integer → float (BC_SITOF / BC_UITOF to float64,
// BC_SITOF32 / BC_UITOF32 to float32), float → integer (BC_FTOSI /
// BC_FTOUI from float64, BC_F32TOSI / BC_F32TOUI from float32), and
// float ↔ float width changes (BC_F64_TO_F32 / BC_F32_TO_F64).
//
// Layer 2: on a host whose word is < 8 bytes, int64/uint64 occupies
// a register pair, so a crossing between pair and single-slot must
// widen (BC_WIDEN64_S/U) or narrow (BC_NARROW64) rather than MOV.
//
// VM register form for floats: the IEEE bits in the type's declared
// width — float64 in 8 bytes, float32 in low 4 bytes (zero-extended).
// Untyped-float literals start at float64 precision (BC_LOAD_IMM
// stores the parsed float64 bit pattern), so for cast-emission
// purposes we treat them as 64-bit on the source side.
func lowerCast(instr @ir.Instr, bc BCInstr) BCInstr {
	// Peel TYP_NAMED: a cast to/from a named distinct scalar selects its
	// fp/int conversion, width, and signedness from the underlying.
	var srcTyp @types.Type = vmUnwrapNamed(instr.Args[0].Typ)
	var dstTyp @types.Type = vmUnwrapNamed(instr.TypeArg)
	var srcIsFloat bool = srcTyp != nil &&
		(srcTyp.Kind == types.TYP_FLOAT ||
			srcTyp.Kind == types.TYP_UNTYPED_FLOAT)
	var dstIsFloat bool = dstTyp != nil &&
		(dstTyp.Kind == types.TYP_FLOAT ||
			dstTyp.Kind == types.TYP_UNTYPED_FLOAT)
	var srcW int = 64
	if srcTyp != nil && srcTyp.Kind == types.TYP_FLOAT &&
			srcTyp.Width > 0 {
		srcW = srcTyp.Width
	}
	var dstW int = 64
	if dstTyp != nil && dstTyp.Kind == types.TYP_FLOAT &&
			dstTyp.Width > 0 {
		dstW = dstTyp.Width
	}
	if !srcIsFloat && dstIsFloat {
		// Integer → float.  A float32 destination uses the fused
		// BC_SITOF32/BC_UITOF32 (result is the float32 IEEE bits in the
		// low 4 bytes — the VM's float32 register form); a float64
		// destination uses BC_SITOF/BC_UITOF.  Going through the float64
		// ops for a float32 dst would leave a float64 bit pattern in the
		// register, whose low 4 bytes (read as the float32) are usually
		// zero — so e.g. `cast(float32, 1)` would read back as ~0.
		//
		// The source's signedness picks the signed/unsigned variant: an
		// unsigned source with its high bit set must convert to a large
		// positive float, not a negative one.  Only a concrete unsigned
		// integer type (TYP_INT, !Signed) qualifies — an untyped int
		// literal defaults to signed `int` (its Signed flag is unset, so
		// an IsInteger()+!Signed test would misclassify it as unsigned).
		var unsignedSrc bool = srcTyp != nil &&
			srcTyp.Kind == types.TYP_INT && !srcTyp.Signed
		// On a 32-bit host an int64/uint64 SOURCE rides a register pair, so pick
		// the pair-source variant (its handler joins Src1/Src1+1) — see
		// vm_exec_cast64.bn.
		var srcIs64 bool = is64BitScalar(srcTyp) && REG_SLOT < 8
		if dstW == 32 {
			if unsignedSrc {
				bc.Op = BC_UITOF32
				if srcIs64 { bc.Op = BC_UI64TOF32 }
			} else {
				bc.Op = BC_SITOF32
				if srcIs64 { bc.Op = BC_SI64TOF32 }
			}
		} else if unsignedSrc {
			bc.Op = BC_UITOF
			if srcIs64 { bc.Op = BC_UI64TOF }
		} else {
			bc.Op = BC_SITOF
			if srcIs64 { bc.Op = BC_SI64TOF }
		}
	} else if srcIsFloat && !dstIsFloat {
		// Float → integer.  An unsigned destination needs the unsigned
		// conversion (BC_F32TOUI / BC_FTOUI): a source value in
		// [2^(W-1), 2^W) must land as the right large unsigned, not the
		// saturated/overflowed signed result the signed convert gives
		// (e.g. float32 2^63 → uint64 saturates to INT64_MAX under the
		// signed BC_F32TOSI).  srcW selects the float32 vs float64 op.
		var unsignedDst bool = common.IsUnsignedIntType(dstTyp)
		// On a 32-bit host an int64/uint64 DEST rides a register pair, so pick the
		// pair-dest variant (its handler splits into Dst/Dst+1) — see
		// vm_exec_cast64.bn.
		var dstIs64 bool = is64BitScalar(dstTyp) && REG_SLOT < 8
		if srcW == 32 {
			if unsignedDst {
				bc.Op = BC_F32TOUI
				if dstIs64 { bc.Op = BC_F32TOUI64 }
			} else {
				bc.Op = BC_F32TOSI
				if dstIs64 { bc.Op = BC_F32TOSI64 }
			}
		} else if unsignedDst {
			bc.Op = BC_FTOUI
			if dstIs64 { bc.Op = BC_FTOUI64 }
		} else {
			bc.Op = BC_FTOSI
			if dstIs64 { bc.Op = BC_FTOSI64 }
		}
	} else if srcIsFloat && dstIsFloat {
		if srcW == 64 && dstW == 32 {
			bc.Op = BC_F64_TO_F32
		} else if srcW == 32 && dstW == 64 {
			bc.Op = BC_F32_TO_F64
		} else {
			bc.Op = BC_MOV
		}
	} else {
		// Integer ↔ integer.  A cast's result register must hold the DEST
		// type's canonical form — sign-extended for a signed type,
		// zero-extended for an unsigned one — the SAME form loads and arith
		// produce, so a direct-use (unstored) cast result compares and orders
		// correctly (matching LLVM/native), not just after a store/reload.
		//
		// Layer 2: on a host whose word is < 8 bytes, int64/uint64 occupies a
		// register pair, so a crossing between pair and single-slot narrows or
		// widens rather than MOV.
		var srcIs64 bool = is64BitScalar(srcTyp) && REG_SLOT < 8
		var dstIs64 bool = is64BitScalar(dstTyp) && REG_SLOT < 8
		if srcIs64 && !dstIs64 {
			// Pair → single-slot narrow (32-bit host).  The value's low bits
			// live in the pair's low slot (regs[Src1]), which BC_SEXT/BC_ZEXT
			// read, so canonicalize a sub-word dst from that slot per its
			// signedness (or copy the slot verbatim for a full-word int32 dst).
			bc.Op, bc.Imm = pairToSingleNarrowOp(dstTyp)
		} else if !srcIs64 && dstIs64 {
			// Single slot → pair.  Sign- or zero-extend based on the
			// *source* signedness (the dst's signedness only
			// determines how downstream reads the bits).
			if srcTyp != nil && srcTyp.IsInteger() &&
					!srcTyp.Signed {
				bc.Op = BC_WIDEN64_U
			} else {
				bc.Op = BC_WIDEN64_S
			}
		} else {
			// Single-slot ↔ single-slot: canonicalize to the dst form (covers
			// narrowing, same-width signedness reinterpret, and widening — the
			// widen64Signed idiom `cast(int64, cast(int32, x))` included).
			bc.Op, bc.Imm = pickSingleSlotIntCastOp(srcTyp, dstTyp)
		}
	}
	bc.Src1 = instr.Args[0].ID
	return bc
}

// pickSingleSlotIntCastOp chooses the (op, Imm) for a single-slot int↔int cast
// so the result register holds the DEST type's canonical form.
//
//   - Sub-word dst (dstW < host word): BC_ZEXT/BC_SEXT Imm=dstW per the DEST's
//     signedness — narrowToWidth masks to dstW then extends, which is the
//     canonical form for narrowing, same-width signedness reinterpret (e.g.
//     int32→uint32), AND widening into a sub-word type (the source is already
//     canonical in its slot, so re-extending from dstW yields the right value).
//   - Full-word dst, widening from a sub-word source: BC_ZEXT/BC_SEXT Imm=srcW
//     per the SOURCE's signedness (the value fits the wider type; the dst
//     signedness is irrelevant).  Covers the widen64Signed idiom on a 64-bit
//     host (int32→int).
//   - Full-word dst, same width (int↔uint / int64↔uint64): BC_MOV — the bit
//     pattern is the value; there is no sub-word form to normalize.
func pickSingleSlotIntCastOp(srcTyp @types.Type,
		dstTyp @types.Type) (int, int) {
	if srcTyp == nil || dstTyp == nil { return BC_MOV, 0 }
	var srcW int = intBitWidth(srcTyp)
	var dstW int = intBitWidth(dstTyp)
	if dstW < REG_SLOT * 8 {
		if common.IsUnsignedIntType(dstTyp) { return BC_ZEXT, dstW }
		return BC_SEXT, dstW
	}
	if srcW < dstW {
		if common.IsUnsignedIntType(srcTyp) { return BC_ZEXT, srcW }
		return BC_SEXT, srcW
	}
	return BC_MOV, 0
}

// pairToSingleNarrowOp chooses the (op, Imm) for narrowing an int64/uint64
// register PAIR (32-bit host) to a single-slot integer dst.  The value's low
// bits are in the pair's low slot (regs[Src1]) — which BC_SEXT/BC_ZEXT read —
// so a sub-word dst canonicalizes from that slot per its signedness; a
// full-word single-slot dst (int32 on a 32-bit host, which IS the whole
// register) copies the low slot verbatim via BC_NARROW64.
func pairToSingleNarrowOp(dstTyp @types.Type) (int, int) {
	var dstW int = intBitWidth(dstTyp)
	if dstW < REG_SLOT * 8 {
		if common.IsUnsignedIntType(dstTyp) { return BC_ZEXT, dstW }
		return BC_SEXT, dstW
	}
	return BC_NARROW64, 0
}

// intBitWidth returns the effective bit width of an integer type.
// Untyped int and types without an explicit Width fall back to the
// host word width (REG_SLOT * 8) — at lowering time an untyped int
// has either already been narrowed to a concrete type or is
// indistinguishable from a host-int from the bytecode's view.
func intBitWidth(t @types.Type) int {
	if t == nil { return REG_SLOT * 8 }
	t = vmUnwrapNamed(t)
	if t.Width > 0 { return t.Width }
	return REG_SLOT * 8
}
