package "pkg/binate/vm"

import "pkg/builtins/testing"

// Tests for OP_CAST lowering (lower_cast.bn).  Source-driven via
// lowerFromSource (from lower_test.bn) so the int↔float bytecode
// flavor selection is exercised through the real type-checker /
// lowering pipeline rather than a hand-rolled IR.

// Integer → float64 lowers to BC_SITOF.  (`5` is an untyped int
// literal, which defaults to signed `int` — it must NOT pick the
// unsigned BC_UITOF.)
func TestLowerCastIntToFloat64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() float64 {\n")
	src = concatStr(src, "  return cast(float64, 5)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_UITOF {
			return "untyped int literal must lower signed (BC_SITOF)"
		}
		if vm.Funcs[0].Code[i].Op == BC_SITOF { return "" }
	}
	return "expected BC_SITOF"
}

// Unsigned integer → float64 lowers to BC_UITOF, so a high-bit-set
// uint64 converts to a large positive double, not a negative one.
func TestLowerCastUintToFloat64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() float64 {\n")
	src = concatStr(src, "  var x uint64 = 1\n")
	src = concatStr(src, "  return cast(float64, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_UITOF { return "" }
	}
	return "expected BC_UITOF"
}

// float64 → int lowers to BC_FTOSI (not BC_F32TOSI — float64 src is
// 64-bit-wide on the source side).
func TestLowerCastFloat64ToInt() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x float64 = 5.0\n")
	src = concatStr(src, "  return cast(int, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_FTOSI { return "" }
	}
	return "expected BC_FTOSI"
}

// float64 → unsigned lowers to BC_FTOUI, so a value >= 2^63 truncates
// to the right large unsigned instead of the signed BC_FTOSI result.
func TestLowerCastFloat64ToUint64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() uint64 {\n")
	src = concatStr(src, "  var x float64 = 5.0\n")
	src = concatStr(src, "  return cast(uint64, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_FTOUI { return "" }
	}
	return "expected BC_FTOUI"
}

// Width-narrowing int → uint8 lowers to BC_TRUNC8 — masks to 8 bits
// at the destination.
func TestLowerCastIntToUint8() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var b uint8 = cast(uint8, 300)\n")
	src = concatStr(src, "  return cast(int, b)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_TRUNC8 { return "" }
	}
	return "expected BC_TRUNC8"
}

// int32 → int64 widening must sign-extend (BC_SEXT with Imm=32) so
// that an int32 holding 0xFFFFFFFF widens to int64 = -1, not
// 4294967295.  This is the bug TestWiden64SignedVsUnsigned exposed
// when the -int unit-test runner first started working: lowering
// previously emitted BC_MOV for single-slot int width changes, which
// preserved the source's stored bits unchanged regardless of sign.
func TestLowerCastInt32SignExtendsToInt64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var n int32 = cast(int32, -1)\n")
	src = concatStr(src, "  var w int64 = cast(int64, n)\n")
	src = concatStr(src, "  if w == cast(int64, -1) { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 1 {
		return "int32(-1) should sign-extend to int64(-1)"
	}
	return ""
}

// uint32 → uint64 must zero-extend (BC_ZEXT with Imm=32) so a uint32
// holding 0xFFFFFFFF widens to uint64 = 4294967295, NOT -1.  The
// signed-vs-unsigned widening choice keys off the source's sign.
func TestLowerCastUint32ZeroExtendsToUint64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var n uint32 = cast(uint32, 4294967295)\n")
	src = concatStr(src, "  var w uint64 = cast(uint64, n)\n")
	src = concatStr(src, "  if w == cast(uint64, 4294967295) { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 1 {
		return "uint32(max) should zero-extend to uint64(max), not sign-extend to -1"
	}
	return ""
}

// Integer → float32 lowers to the fused BC_SITOF32, NOT BC_SITOF.
// BC_SITOF lands at float64; for a float32 destination its float64 bit
// pattern would sit in the register whose low 4 bytes (read as the
// float32) are usually zero — so `cast(float32, 1)` would read back as
// ~0.  BC_SITOF32 writes the float32 IEEE bits directly.
func TestLowerCastIntToFloat32() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() float32 {\n")
	src = concatStr(src, "  return cast(float32, 5)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		var op int = vm.Funcs[0].Code[i].Op
		if op == BC_SITOF || op == BC_UITOF {
			return "float32 dst must use the fused BC_SITOF32, not the float64 BC_SITOF/BC_UITOF"
		}
		if op == BC_SITOF32 { return "" }
	}
	return "expected BC_SITOF32"
}

// Unsigned integer → float32 lowers to BC_UITOF32, so a high-bit-set
// source converts to a large positive float32, not a negative one.
func TestLowerCastUintToFloat32() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() float32 {\n")
	src = concatStr(src, "  var x uint64 = 1\n")
	src = concatStr(src, "  return cast(float32, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_UITOF32 { return "" }
	}
	return "expected BC_UITOF32"
}

// End-to-end: `cast(float32, 42)` must produce a real float32 value
// (the bit pattern in the low 4 bytes), so the round-trip back through
// `cast(int, …)` recovers 42.  Before BC_SITOF32 the conversion left a
// float64 bit pattern whose low word was zero, so the round-trip gave 0
// — the headline symptom (`cast(float32, 1) > 0.0` was false).
func TestExecIntToFloat32RoundTrips() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var f float32 = cast(float32, 42)\n")
	src = concatStr(src, "  return cast(int, f)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 42 {
		return "cast(float32, 42) must round-trip to 42, not 0"
	}
	return ""
}

// float32 → unsigned lowers to BC_F32TOUI (not the signed BC_F32TOSI),
// so a value >= 2^63 truncates to the right large unsigned instead of
// saturating to INT64_MAX the way the signed convert does.
func TestLowerCastFloat32ToUint64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() uint64 {\n")
	src = concatStr(src, "  var x float32 = 5.0\n")
	src = concatStr(src, "  return cast(uint64, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_F32TOSI {
			return "float32 -> unsigned must use BC_F32TOUI, not the signed BC_F32TOSI"
		}
		if vm.Funcs[0].Code[i].Op == BC_F32TOUI { return "" }
	}
	return "expected BC_F32TOUI"
}

// End-to-end: the 2^63 round-trip `cast(uint64, cast(float32, 2^63))`
// must recover 2^63.  Under the signed BC_F32TOSI the float32→uint64
// step saturated 2^63 to INT64_MAX, so the round-trip mismatched (the
// surviving scalar-diff float-to-int/64/unsigned tuple).
func TestExecFloat32ToUint64HighBitRoundTrips() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var y uint64 = 9223372036854775808\n")
	src = concatStr(src, "  var f float32 = cast(float32, y)\n")
	src = concatStr(src, "  var b uint64 = cast(uint64, f)\n")
	src = concatStr(src, "  if b == y { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 1 {
		return "cast(uint64, cast(float32, 2^63)) must round-trip to 2^63"
	}
	return ""
}

// Same-width float64 → float64 (e.g. through an untyped intermediate)
// lowers to BC_MOV — the bitcast path falls through every
// width-conversion branch and lands on the default register copy.
func TestLowerCastFloat64ToFloat64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() float64 {\n")
	src = concatStr(src, "  var x float64 = 2.5\n")
	src = concatStr(src, "  return cast(float64, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	// Just confirm lowering didn't produce a width-conversion op:
	// BC_F64_TO_F32 / BC_F32_TO_F64 would indicate a misfired
	// width-change path.
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		var op int = vm.Funcs[0].Code[i].Op
		if op == BC_F64_TO_F32 || op == BC_F32_TO_F64 {
			return "same-width float64 cast must not emit a width conv"
		}
	}
	return ""
}
