package "pkg/binate/vm"

import "pkg/builtins/testing"

// Tests for OP_CAST lowering (lower_cast.bn).  Source-driven via
// lowerFromSource (from lower_test.bn) so the int↔float bytecode
// flavor selection is exercised through the real type-checker /
// lowering pipeline rather than a hand-rolled IR.

// Integer → float64 lowers to BC_SITOF.  (`5` is an untyped int
// literal, which defaults to signed `int` — it must NOT pick the
// unsigned BC_UITOF.)
func TestLowerCastIntToFloat64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() float64 {\n")
	src = concatStr(src, "  return cast(float64, 5)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_UITOF {
			return "untyped int literal must lower signed (BC_SITOF)"
		}
		if vm.Funcs[0].Code[i].Op == BC_SITOF { return "" }
	}
	return "expected BC_SITOF"
}

// Unsigned integer → float64 lowers to BC_UITOF, so a high-bit-set
// uint64 converts to a large positive double, not a negative one.
func TestLowerCastUintToFloat64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() float64 {\n")
	src = concatStr(src, "  var x uint64 = 1\n")
	src = concatStr(src, "  return cast(float64, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	// On a 32-bit host a uint64 source rides a register pair, so lowering picks
	// the pair-source variant (BC_UI64TOF); on a 64-bit host it stays BC_UITOF.
	var want int = BC_UITOF
	if REG_SLOT < 8 { want = BC_UI64TOF }
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == want { return "" }
	}
	return "expected the uint64->float64 conversion op"
}

// float64 → int lowers to BC_FTOSI (not BC_F32TOSI — float64 src is
// 64-bit-wide on the source side).
func TestLowerCastFloat64ToInt() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x float64 = 5.0\n")
	src = concatStr(src, "  return cast(int, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_FTOSI { return "" }
	}
	return "expected BC_FTOSI"
}

// float64 → unsigned lowers to BC_FTOUI, so a value >= 2^63 truncates
// to the right large unsigned instead of the signed BC_FTOSI result.
func TestLowerCastFloat64ToUint64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() uint64 {\n")
	src = concatStr(src, "  var x float64 = 5.0\n")
	src = concatStr(src, "  return cast(uint64, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	// On a 32-bit host a uint64 dest rides a register pair, so lowering picks the
	// pair-dest variant (BC_FTOUI64); on a 64-bit host it stays BC_FTOUI.
	var want int = BC_FTOUI
	if REG_SLOT < 8 { want = BC_FTOUI64 }
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == want { return "" }
	}
	return "expected the float64->uint64 conversion op"
}

// Width-narrowing int → uint8 lowers to BC_ZEXT with Imm=8 — masks to the
// low 8 bits and zero-extends, the canonical register form for an unsigned
// sub-word dst (a signed dst would use BC_SEXT; see the int8 test below).
func TestLowerCastIntToUint8() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var b uint8 = cast(uint8, 300)\n")
	src = concatStr(src, "  return cast(int, b)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_ZEXT &&
				vm.Funcs[0].Code[i].Imm == 8 {
			return ""
		}
	}
	return "expected BC_ZEXT Imm=8 for cast(uint8, ...)"
}

// Width-narrowing int → int8 lowers to BC_SEXT with Imm=8 — masks to the low
// 8 bits and SIGN-extends (not zero-fill), so a direct-use signed sub-word
// value orders/compares correctly (the 953 bug class: BC_TRUNC8 zero-filled).
func TestLowerCastIntToInt8SignExtends() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var v int = -1\n")
	src = concatStr(src, "  var b int8 = cast(int8, v)\n")
	src = concatStr(src, "  return cast(int, b)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_SEXT &&
				vm.Funcs[0].Code[i].Imm == 8 {
			return ""
		}
	}
	return "expected BC_SEXT Imm=8 for cast(int8, ...)"
}

// int32 → int64 widening must sign-extend (BC_SEXT with Imm=32) so
// that an int32 holding 0xFFFFFFFF widens to int64 = -1, not
// 4294967295.  This is the bug TestWiden64SignedVsUnsigned exposed
// when the -int unit-test runner first started working: lowering
// previously emitted BC_MOV for single-slot int width changes, which
// preserved the source's stored bits unchanged regardless of sign.
func TestLowerCastInt32SignExtendsToInt64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var n int32 = cast(int32, -1)\n")
	src = concatStr(src, "  var w int64 = cast(int64, n)\n")
	src = concatStr(src, "  if w == cast(int64, -1) { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 1 {
		return "int32(-1) should sign-extend to int64(-1)"
	}
	return ""
}

// uint32 → uint64 must zero-extend (BC_ZEXT with Imm=32) so a uint32
// holding 0xFFFFFFFF widens to uint64 = 4294967295, NOT -1.  The
// signed-vs-unsigned widening choice keys off the source's sign.
func TestLowerCastUint32ZeroExtendsToUint64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var n uint32 = cast(uint32, 4294967295)\n")
	src = concatStr(src, "  var w uint64 = cast(uint64, n)\n")
	src = concatStr(src, "  if w == cast(uint64, 4294967295) { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 1 {
		return "uint32(max) should zero-extend to uint64(max), not sign-extend to -1"
	}
	return ""
}

// bit_cast to a SUB-WORD UNSIGNED integer used DIRECTLY (no intervening typed
// store) must re-normalize the register to the target's zero-extended canonical
// form: bit_cast(uint32, int32 -1) read directly is 4294967295, not -1.
// OP_BIT_CAST formerly lowered to a plain BC_MOV, leaving int32 -1's sign
// extension (0xFFFF…FFFF) in the register so the direct uint32 compare failed.
func TestLowerBitCastSubWordZeroExtendsDirectUse() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var v int32 = cast(int32, -1)\n")
	src = concatStr(src, "  if bit_cast(uint32, v) == cast(uint32, 4294967295) { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 1 {
		return "bit_cast(uint32, int32 -1) used directly should be 4294967295, not -1"
	}
	return ""
}

// bit_cast to a SUB-WORD SIGNED integer used directly must sign-extend:
// bit_cast(int32, uint32 0xFFFFFFFF) is -1, not 4294967295.  Compared against
// the literal -1 (the canonical sign-extended form), not cast(int32,-1): a
// direct-use cast to a signed sub-word is itself not sign-extended yet (a
// separate facet of the sub-word-narrowing gap), so comparing two differently-
// produced direct-use sub-word expressions would conflate the two bugs.
func TestLowerBitCastSubWordSignExtendsDirectUse() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var u uint32 = cast(uint32, 4294967295)\n")
	src = concatStr(src, "  if bit_cast(int32, u) == -1 { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 1 {
		return "bit_cast(int32, uint32 max) used directly should be -1"
	}
	return ""
}

// The narrowing is width-driven, not hard-coded to 32: an 8-bit
// bit_cast(uint8, int8 -1) used directly is 255.
func TestLowerBitCastSubWordUint8DirectUse() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var v int8 = cast(int8, -1)\n")
	src = concatStr(src, "  if bit_cast(uint8, v) == cast(uint8, 255) { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 1 {
		return "bit_cast(uint8, int8 -1) used directly should be 255"
	}
	return ""
}

// Integer → float32 lowers to the fused BC_SITOF32, NOT BC_SITOF.
// BC_SITOF lands at float64; for a float32 destination its float64 bit
// pattern would sit in the register whose low 4 bytes (read as the
// float32) are usually zero — so `cast(float32, 1)` would read back as
// ~0.  BC_SITOF32 writes the float32 IEEE bits directly.
func TestLowerCastIntToFloat32() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() float32 {\n")
	src = concatStr(src, "  return cast(float32, 5)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		var op int = vm.Funcs[0].Code[i].Op
		if op == BC_SITOF || op == BC_UITOF {
			return "float32 dst must use the fused BC_SITOF32, not the float64 BC_SITOF/BC_UITOF"
		}
		if op == BC_SITOF32 { return "" }
	}
	return "expected BC_SITOF32"
}

// Unsigned integer → float32 lowers to BC_UITOF32, so a high-bit-set
// source converts to a large positive float32, not a negative one.
func TestLowerCastUintToFloat32() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() float32 {\n")
	src = concatStr(src, "  var x uint64 = 1\n")
	src = concatStr(src, "  return cast(float32, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	// On a 32-bit host a uint64 source rides a register pair, so lowering picks
	// the pair-source variant (BC_UI64TOF32); on a 64-bit host it's BC_UITOF32.
	var want int = BC_UITOF32
	if REG_SLOT < 8 { want = BC_UI64TOF32 }
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == want { return "" }
	}
	return "expected the uint64->float32 conversion op"
}

// End-to-end: `cast(float32, 42)` must produce a real float32 value
// (the bit pattern in the low 4 bytes), so the round-trip back through
// `cast(int, …)` recovers 42.  Before BC_SITOF32 the conversion left a
// float64 bit pattern whose low word was zero, so the round-trip gave 0
// — the headline symptom (`cast(float32, 1) > 0.0` was false).
func TestExecIntToFloat32RoundTrips() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var f float32 = cast(float32, 42)\n")
	src = concatStr(src, "  return cast(int, f)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 42 {
		return "cast(float32, 42) must round-trip to 42, not 0"
	}
	return ""
}

// float32 → unsigned lowers to BC_F32TOUI (not the signed BC_F32TOSI),
// so a value >= 2^63 truncates to the right large unsigned instead of
// saturating to INT64_MAX the way the signed convert does.
func TestLowerCastFloat32ToUint64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() uint64 {\n")
	src = concatStr(src, "  var x float32 = 5.0\n")
	src = concatStr(src, "  return cast(uint64, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	// On a 32-bit host a uint64 dest rides a register pair, so lowering picks the
	// pair-dest variant (BC_F32TOUI64); on a 64-bit host it stays BC_F32TOUI.
	var wantU int = BC_F32TOUI
	var rejectS int = BC_F32TOSI
	if REG_SLOT < 8 {
		wantU = BC_F32TOUI64
		rejectS = BC_F32TOSI64
	}
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == rejectS {
			return "float32 -> unsigned must use the unsigned variant, not the signed"
		}
		if vm.Funcs[0].Code[i].Op == wantU { return "" }
	}
	return "expected the float32->uint64 conversion op"
}

// Signed int64 <-> float lowering picks the SIGNED pair variants on a 32-bit
// host (the signed branches are live only there; these guard a copy/paste
// regression — a wrong opcode or dropped REG_SLOT guard — that would otherwise
// go uncaught since conformance never runs the VM on a 32-bit host).

// int64 -> float64: BC_SI64TOF on a 32-bit host, else BC_SITOF.
func TestLowerCastInt64ToFloat64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() float64 {\n")
	src = concatStr(src, "  var x int64 = 5\n")
	src = concatStr(src, "  return cast(float64, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var want int = BC_SITOF
	if REG_SLOT < 8 { want = BC_SI64TOF }
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == want { return "" }
	}
	return "expected the int64->float64 conversion op"
}

// float64 -> int64: BC_FTOSI64 on a 32-bit host, else BC_FTOSI.
func TestLowerCastFloat64ToInt64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int64 {\n")
	src = concatStr(src, "  var x float64 = 5.0\n")
	src = concatStr(src, "  return cast(int64, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var want int = BC_FTOSI
	if REG_SLOT < 8 { want = BC_FTOSI64 }
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == want { return "" }
	}
	return "expected the float64->int64 conversion op"
}

// int64 -> float32: BC_SI64TOF32 on a 32-bit host, else BC_SITOF32.
func TestLowerCastInt64ToFloat32() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() float32 {\n")
	src = concatStr(src, "  var x int64 = 5\n")
	src = concatStr(src, "  return cast(float32, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var want int = BC_SITOF32
	if REG_SLOT < 8 { want = BC_SI64TOF32 }
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == want { return "" }
	}
	return "expected the int64->float32 conversion op"
}

// float32 -> int64: BC_F32TOSI64 on a 32-bit host, else BC_F32TOSI.
func TestLowerCastFloat32ToInt64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int64 {\n")
	src = concatStr(src, "  var x float32 = 5.0\n")
	src = concatStr(src, "  return cast(int64, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var want int = BC_F32TOSI
	if REG_SLOT < 8 { want = BC_F32TOSI64 }
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == want { return "" }
	}
	return "expected the float32->int64 conversion op"
}

// End-to-end: the 2^63 round-trip `cast(uint64, cast(float32, 2^63))`
// must recover 2^63.  Under the signed BC_F32TOSI the float32→uint64
// step saturated 2^63 to INT64_MAX, so the round-trip mismatched (the
// surviving scalar-diff float-to-int/64/unsigned tuple).
func TestExecFloat32ToUint64HighBitRoundTrips() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var y uint64 = 9223372036854775808\n")
	src = concatStr(src, "  var f float32 = cast(float32, y)\n")
	src = concatStr(src, "  var b uint64 = cast(uint64, f)\n")
	src = concatStr(src, "  if b == y { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 1 {
		return "cast(uint64, cast(float32, 2^63)) must round-trip to 2^63"
	}
	return ""
}

// float32 → signed int truncates toward zero via BC_F32TOSI, reading
// the float32 from the low 4 bytes of the register.  A float32 literal
// (materialized directly, no int→float32 op) isolates the signed
// float32→int path that the unsigned BC_F32TOUI fix contrasts against.
func TestExecFloat32ToSignedIntTruncates() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var f float32 = -3.75\n")
	src = concatStr(src, "  return cast(int, f)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != -3 {
		return "cast(int, float32 -3.75) must truncate to -3"
	}
	return ""
}

// int → float32 rounds to nearest-even via BC_SITOF32.  16777217 =
// 2^24+1 is not representable in float32 (24-bit mantissa) and rounds
// down to the even 2^24 = 16777216 — pinning the new op's rounding at
// the representability boundary (the round-trip tests only used exactly
// representable values).
func TestExecIntToFloat32RoundsToNearestEven() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var f float32 = cast(float32, 16777217)\n")
	src = concatStr(src, "  return cast(int, f)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 16777216 {
		return "cast(float32, 16777217) must round to even 16777216"
	}
	return ""
}

// uint32 high-bit value → float32 via BC_UITOF32: 2^31 is exactly
// representable, so the round-trip recovers it.  Exercises the unsigned
// float32 op at a sub-word source width whose magnitude the conformance
// net only sign-checks (it round-trips uint32 high values via float64).
func TestExecUint32HighBitToFloat32() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x uint32 = 2147483648\n")
	src = concatStr(src, "  var f float32 = cast(float32, x)\n")
	src = concatStr(src, "  return cast(int, f)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 2147483648 {
		return "cast(float32, uint32 2^31) must round-trip to 2^31"
	}
	return ""
}

// Same-width float64 → float64 (e.g. through an untyped intermediate)
// lowers to BC_MOV — the bitcast path falls through every
// width-conversion branch and lands on the default register copy.
func TestLowerCastFloat64ToFloat64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() float64 {\n")
	src = concatStr(src, "  var x float64 = 2.5\n")
	src = concatStr(src, "  return cast(float64, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	// Just confirm lowering didn't produce a width-conversion op:
	// BC_F64_TO_F32 / BC_F32_TO_F64 would indicate a misfired
	// width-change path.
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		var op int = vm.Funcs[0].Code[i].Op
		if op == BC_F64_TO_F32 || op == BC_F32_TO_F64 {
			return "same-width float64 cast must not emit a width conv"
		}
	}
	return ""
}

// A same-width 64-bit int cast (int64 -> uint64) is a pair->pair reinterpret on
// a 32-bit host: it must copy BOTH slots (BC_MOV64), not one (a single-slot
// BC_MOV dropped the high half, so println(uint64) truncated).  On a 64-bit host
// the value is one slot and no BC_MOV64 is emitted.  Like the other pair-variant
// tests, the ILP32 branch only runs on a 32-bit-host unit build (REG_SLOT < 8);
// on LP64 it asserts the pair op is absent.
func TestLowerCastInt64ToUint64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() uint64 {\n")
	src = concatStr(src, "  var x int64 = 5000000000\n")
	src = concatStr(src, "  return cast(uint64, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var hasMov64 bool = false
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_MOV64 { hasMov64 = true }
	}
	if REG_SLOT < 8 {
		if !hasMov64 {
			return "ILP32: pair->pair 64-bit cast must emit BC_MOV64 (both slots)"
		}
	} else {
		if hasMov64 {
			return "LP64: a 64-bit value is one slot; no BC_MOV64 expected"
		}
	}
	return ""
}
