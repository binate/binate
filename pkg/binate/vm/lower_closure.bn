// How a capturing closure's captures reach its leading parameters.
package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/types"

// captureNeedsPtrPass reports whether a capture of type `t`
// must be passed to the closure-wrapper as a pointer (the field
// address inside the closure struct) rather than as its value.
// Matches lowerLoad / lowerStore's multi-word
// type list — these are the types the VM passes by pointer
// throughout the call convention, so a capture-as-value would
// reach the wrapper's body in a shape it can't interpret.  Every
// transparent wrapper (named / alias / readonly) is peeled first: a
// closure-struct field keeps a capture's `readonly` (e.g. a captured
// `readonly @[]int` local), and a wrapper has no Kind of its own, so an
// unpeeled test would pass a multi-word capture by its first word.
func captureNeedsPtrPass(t @types.Type) bool {
	t = types.StripWrappers(t)
	if t == nil { return false }
	var k int = t.Kind
	if k == types.TYP_STRUCT { return true }
	if k == types.TYP_SLICE { return true }
	if k == types.TYP_MANAGED_SLICE { return true }
	if k == types.TYP_ARRAY { return true }
	if k == types.TYP_FUNC_VALUE { return true }
	if k == types.TYP_MANAGED_FUNC_VALUE { return true }
	if k == types.TYP_INTERFACE_VALUE { return true }
	if k == types.TYP_INTERFACE_VALUE_MANAGED { return true }
	return false
}

// lowerCaptures records how capturing closure f's captures reach its leading
// parameters (writeCaptures): each one's byte offset in the closure struct, and whether
// it passes as the field's address (captureNeedsPtrPass), as a register pair (a 64-bit
// scalar on a host whose registers are narrower, CaptureWide), or as a value read at
// its own width -- CaptureBytes bytes, sign-extended when CaptureSigned, as a load of
// its type reads it (scalarLoadBytes) -- so a narrow capture arrives as a register
// holding a value of its type does, with none of the next capture's bytes.
func lowerCaptures(vmf @VMFunc, f @ir.Func) {
	vmf.IsClosure = true
	vmf.NumCaptureParams = f.NumCaptureParams
	vmf.CaptureOffsets = make_slice(int, f.NumCaptureParams)
	vmf.CaptureByPtr = make_slice(bool, f.NumCaptureParams)
	vmf.CaptureWide = make_slice(bool, f.NumCaptureParams)
	vmf.CaptureBytes = make_slice(int, f.NumCaptureParams)
	vmf.CaptureSigned = make_slice(bool, f.NumCaptureParams)
	if f.ClosureStruct == nil { return }
	for i := 0; i < f.NumCaptureParams; i++ {
		var t @types.Type = f.ClosureStruct.Fields[i].Type
		vmf.CaptureOffsets[i] = types.HostInt(f.ClosureStruct.Offset(i))
		vmf.CaptureByPtr[i] = captureNeedsPtrPass(t)
		// is64BitScalar is false for the by-pointer aggregate types, so the two
		// flags never both set.
		vmf.CaptureWide[i] = is64BitScalar(t) && REG_SLOT < 8
		if !vmf.CaptureByPtr[i] && !vmf.CaptureWide[i] {
			vmf.CaptureBytes[i] = scalarLoadBytes(t)
			vmf.CaptureSigned[i] = scalarLoadSigned(t)
		}
	}
}
