package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for lowerFunc's B.2 closure-metadata propagation
// (plan-function-values-phase-2.md): for an ir.Func with
// IsClosure=true and a populated ClosureStruct, the resulting
// VMFunc carries matching NumCaptureParams + CaptureOffsets.
// The end-to-end behavior is exercised by
// conformance/501_capture_value in VM modes; this pins the
// thin propagation layer in isolation.

// TestLowerFuncClosureMetadata: a hand-crafted ir.Func with two
// int captures lowers to a VMFunc with NumCaptureParams=2 and
// CaptureOffsets matching FieldOffset on the closure struct.
func TestLowerFuncClosureMetadata() testing.TestResult {
	// Build a closure struct {x int, y int}.
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var fx @types.Field = make(types.Field)
	fx.Name = "x"
	fx.Type = types.TypInt()
	fields[0] = fx
	var fy @types.Field = make(types.Field)
	fy.Name = "y"
	fy.Type = types.TypInt()
	fields[1] = fy
	var cs @types.Type = types.MakeStructType("__closure_lit", fields)

	// Build a minimal IsClosure Func with two prepended capture
	// params (matching the layout IR-gen produces).
	var f @ir.Func = ir.NewFunc("main.__funclit_0",
		make_slice(@ir.Param, 0), make_slice(@types.Type, 0))
	var px @ir.Param = ir.NewParam(f, "x", types.TypInt())
	var py @ir.Param = ir.NewParam(f, "y", types.TypInt())
	var params @[]@ir.Param = make_slice(@ir.Param, 2)
	params[0] = px
	params[1] = py
	f.Params = params
	f.IsClosure = true
	f.NumCaptureParams = 2
	f.ClosureStruct = cs

	// Lower.
	var vmf @VMFunc = lowerFunc(f)
	if !vmf.IsClosure {
		return "expected VMFunc.IsClosure=true"
	}
	if vmf.NumCaptureParams != 2 {
		return "expected NumCaptureParams=2"
	}
	if len(vmf.CaptureOffsets) != 2 {
		return "expected CaptureOffsets length 2"
	}
	// Offsets must match the closure struct's natural field
	// offsets — that's the contract BC_CALL_FUNC_VALUE relies on
	// when copying captures from the struct into the callee's
	// leading regs.
	if vmf.CaptureOffsets[0] != cs.FieldOffset(0) {
		return "CaptureOffsets[0] != FieldOffset(0)"
	}
	if vmf.CaptureOffsets[1] != cs.FieldOffset(1) {
		return "CaptureOffsets[1] != FieldOffset(1)"
	}
	return ""
}

// TestLowerFuncNonClosureNoMetadata: a regular (non-closure)
// Func lowers without IsClosure/NumCaptureParams/CaptureOffsets
// — the metadata must stay default so Phase 1 paths aren't
// misinterpreted as closures by BC_CALL_FUNC_VALUE dispatch.
func TestLowerFuncNonClosureNoMetadata() testing.TestResult {
	var f @ir.Func = ir.NewFunc("main.PlainFn",
		make_slice(@ir.Param, 0), make_slice(@types.Type, 0))
	// f.IsClosure defaults to false; don't touch it.
	var vmf @VMFunc = lowerFunc(f)
	if vmf.IsClosure {
		return "expected IsClosure=false on plain fn"
	}
	if vmf.NumCaptureParams != 0 {
		return "expected NumCaptureParams=0 on plain fn"
	}
	if len(vmf.CaptureOffsets) != 0 {
		return "expected empty CaptureOffsets on plain fn"
	}
	return ""
}

// captureNeedsPtrPass drives the BC_CALL_FUNC_VALUE dispatcher's
// choice between "load word from struct" (scalar captures) and
// "pass field address" (multi-word captures the VM moves through
// pointers).  Wrong answer → struct captures become 1-word values
// reinterpreted as memory addresses by BC_MEMCPY → SIGSEGV (the
// exact bug B.4 value-receiver hit pre-fix).

// Scalar types: int / bool / pointer / managed-pointer → false.
func TestCaptureNeedsPtrPassScalar() testing.TestResult {
	if captureNeedsPtrPass(types.TypInt()) {
		return "int should not need ptr-pass"
	}
	if captureNeedsPtrPass(types.TypBool()) {
		return "bool should not need ptr-pass"
	}
	if captureNeedsPtrPass(types.MakePointerType(types.TypInt())) {
		return "*int should not need ptr-pass (raw ptr is one word)"
	}
	if captureNeedsPtrPass(
			types.MakeManagedPtrType(types.TypInt())) {
		return "@int should not need ptr-pass (managed ptr is one word)"
	}
	return ""
}

// Multi-word types: struct / slice / managed-slice / array /
// func-value / managed-func-value / interface-value /
// managed-interface-value → true.  These are the VM-by-pointer
// types from lowerLoad/lowerStore.
func TestCaptureNeedsPtrPassStruct() testing.TestResult {
	var fields @[]@types.Field
	var s @types.Type = types.MakeStructType("S", fields)
	if !captureNeedsPtrPass(s) {
		return "struct should need ptr-pass"
	}
	return ""
}

func TestCaptureNeedsPtrPassSlice() testing.TestResult {
	if !captureNeedsPtrPass(types.MakeSliceType(types.TypInt())) {
		return "*[]T should need ptr-pass"
	}
	if !captureNeedsPtrPass(
			types.MakeManagedSliceType(types.TypInt())) {
		return "@[]T should need ptr-pass"
	}
	return ""
}

func TestCaptureNeedsPtrPassFuncValue() testing.TestResult {
	var params @[]@types.Param
	var results @[]@types.Type
	var fv @types.Type =
		types.MakeFuncValueType(params, results)
	if !captureNeedsPtrPass(fv) {
		return "*func() should need ptr-pass"
	}
	return ""
}

// A NAMED type wrapping a struct is still a struct under the
// hood — pass-by-pointer must look through the Underlying.
func TestCaptureNeedsPtrPassNamedStruct() testing.TestResult {
	var fields @[]@types.Field
	var underlying @types.Type =
		types.MakeStructType("__inner", fields)
	var named @types.Type = make(types.Type)
	named.Kind = types.TYP_NAMED
	named.Name = "MyStruct"
	named.Underlying = underlying
	if !captureNeedsPtrPass(named) {
		return "named struct should need ptr-pass via Underlying"
	}
	return ""
}

// Nil-safe: an empty/nil type doesn't trip the helper.
func TestCaptureNeedsPtrPassNil() testing.TestResult {
	if captureNeedsPtrPass(nil) {
		return "nil should not need ptr-pass"
	}
	return ""
}
