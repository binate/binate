package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/mangle"

// Per-module VM-side data: materialized strings, globals,
// per-function name tables, and the lookup helpers that go with
// them. Set up by LowerModule and LowerOneFunc(Shadow), read by
// lowerFunc and lowerInstr.

// materializeModuleStrings creates proper @[]char values for the
// given module's string constants. Returns a fresh slice; callers
// hold references that stay alive as long as the VMFuncs lowered
// from that module.
func materializeModuleStrings(strings *[]ir.StringConst) @[]@[]char {
	var n int = len(strings)
	var out @[]@[]char = make_slice(@[]char, n)
	for i := 0; i < n; i++ {
		var slen int = strings[i].Len
		var s @[]char = make_slice(char, slen)
		var src @[]char = strings[i].Data
		for j := 0; j < slen; j++ {
			s[j] = src[j]
		}
		out[i] = s
	}
	return out
}

// addName appends a name to the current function's name table
// (vm.curNames) and returns its index.
func addName(vm @VM, name @[]char) int {
	var idx int = vm.curNames.Len()
	vm.curNames.Push(name)
	return idx
}

// materializeGlobals allocates memory for each global variable and
// registers it under its package-qualified name.  APPENDS across
// modules: the driver lowers each package once, accumulating a single
// cross-package global table.  (The old per-module overwrite kept only
// the last module's globals — fine for same-package reads, which bake
// their address at lower time, but it left a cross-package read with
// nothing to resolve.)  Keying by qualifyCallName — the same scheme call
// targets use — lets a same-package read (bare name, qualified at
// lookup) and a cross-package read (dotted defining-pkg name) both
// resolve.  An imported extern var (IsExtern) is owned + allocated by
// its defining package, so the importer's declaration must NOT allocate
// a second copy; its qualified read resolves to the owner's storage
// (registered when the owner's module was lowered).
func materializeGlobals(vm @VM, globals *[]@ir.Global) {
	for i := 0; i < len(globals); i++ {
		if globals[i].IsExtern { continue }
		var size int = globals[i].Typ.SizeOf()
		if size < 8 { size = 8 }
		var ptr *uint8 = vmOwn(vm, size) // VM-owned; freed at teardown (make_slice zero-fills)
		vm.globalNames.Push(qualifyCallName(vm, globals[i].Name))
		vm.globalAddrs.Push(bit_cast(int, ptr))
	}
}

// MaterializeOneGlobal allocates storage for a single newly-declared
// global and appends it to the per-VM globalNames / globalAddrs
// tables.  REPL entry point: a `var` declaration typed at the prompt
// adds one entry that subsequent prompt entries can read and write
// through `lookupGlobalAddr` (the existing path used by all
// `IsGlobalRef` instructions during lowering).  Storage is
// zero-initialized; like the file-load path, declared initializers
// (`var x int = 42`) are not applied — the user can assign in a
// follow-up prompt entry.
func (vm @VM) MaterializeOneGlobal(g @ir.Global) {
	var size int = g.Typ.SizeOf()
	if size < 8 { size = 8 }
	var ptr *uint8 = vmOwn(vm, size) // VM-owned; freed at teardown (make_slice zero-fills)
	vm.globalNames.Push(qualifyCallName(vm, g.Name))
	vm.globalAddrs.Push(bit_cast(int, ptr))
}

// registerGlobalAddr binds a global's fully-qualified name to an externally-
// owned storage address, so a bytecode cross-package read resolves to it via
// lookupGlobalAddr.  Used by RegisterPackageGlobals to inject a native-only
// compiled package's sentinel globals (e.g. `pkg/std/errors.NotFound`): the
// bytecode importer's read is an IsExtern global (materializeGlobals skips
// allocating it), so the only entry under that name is this injected native
// address — giving the single-instance pointer identity errors.Is needs.
//
// `name` is already fully-qualified (the descriptor's GlobalInfo.Name), so it
// needs no qualifyCallName pass — a dotted name is what lookupGlobalAddr's
// QualifyName produces unchanged.  The bytes are copied into an owned @[]char
// because the table outlives the caller's (readonly) name slice.
func registerGlobalAddr(vm @VM, name *[]readonly char, addr int) {
	var owned @[]char = make_slice(char, len(name))
	for i := 0; i < len(name); i++ {
		owned[i] = name[i]
	}
	vm.globalNames.Push(owned)
	vm.globalAddrs.Push(addr)
}

// GlobalCount returns the number of entries in the per-VM global registry
// (globalNames / globalAddrs).  RegisterPackageGlobals grows it with a
// native-only package's exported globals at injection; materializeGlobals /
// MaterializeOneGlobal also add a lowered program's / a REPL line's globals — so
// the count is injected-only just after New (before any LoadProgram), which is
// where a host uses it to verify an inject-set's globals were bound (the FUNCTION
// count `len(Externs)` is blind to this registry).
func (vm @VM) GlobalCount() int {
	return vm.globalNames.Len()
}

// lookupGlobalAddr returns the address of a global variable, or 0.
// The lookup name is qualified the same way materializeGlobals keys its
// entries (qualifyCallName: a bare same-package name gets the current
// module's package prefix; a dotted cross-package name passes through),
// so both same-package and imported-extern-var reads resolve.
func lookupGlobalAddr(vm @VM, name *[]readonly char) int {
	var qn @[]char = mangle.QualifyName(vm.modulePkgName, name)
	for i := 0; i < vm.globalNames.Len(); i++ {
		if streq2(vm.globalNames.Get(i), qn) { return vm.globalAddrs.Get(i) }
	}
	return 0
}

// streq2 returns true if raw slices a and b have identical contents.
func streq2(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
