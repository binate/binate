package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// Tests for the helpers in lower_data.bn — module-level data
// management for the VM. The end-to-end paths (string literals
// loaded via BC_LOAD_STR, globals read/written through
// lookupGlobalAddr) are exercised by the conformance suite; these
// tests pin the small helpers directly.

// streq2 compares two raw char slices. Pin the three cases the
// implementation explicitly handles: equal contents, different
// contents same length, different lengths.
func TestStreq2() testing.TestResult {
	if !streq2("hello", "hello") {
		return "equal strings should compare equal"
	}
	if streq2("hello", "world") {
		return "different content same length should compare unequal"
	}
	if streq2("abc", "ab") {
		return "different lengths should compare unequal"
	}
	if !streq2("", "") {
		return "two empty strings should compare equal"
	}
	return ""
}

// appendIntSlice grows an int slice by one element, preserving
// existing entries.
func TestAppendIntSlice() testing.TestResult {
	var empty @[]int
	var r1 @[]int = slices.Append[int](empty, 7)
	if len(r1) != 1 { return "len after append-empty should be 1" }
	if r1[0] != 7 { return "first byte should be 7" }

	var two @[]int = make_slice(int, 2)
	two[0] = 1
	two[1] = 2
	var r2 @[]int = slices.Append[int](two, 3)
	if len(r2) != 3 { return "len after grow should be 3" }
	if r2[0] != 1 { return "byte 0 preserved" }
	if r2[1] != 2 { return "byte 1 preserved" }
	if r2[2] != 3 { return "byte 2 == new" }
	return ""
}

// appendNameStr grows a name slice. Same shape as appendIntSlice
// but with @[]char elements; pin separately so a regression in
// one pattern doesn't silently break the other.
func TestAppendNameStr() testing.TestResult {
	var empty @[]@[]char
	var r1 @[]@[]char = slices.Append[@[]char](empty, "first")
	if len(r1) != 1 { return "len after append-empty should be 1" }
	if !streq2(r1[0], "first") { return "first entry should be 'first'" }

	var r2 @[]@[]char = slices.Append[@[]char](r1, "second")
	if len(r2) != 2 { return "len after grow should be 2" }
	if !streq2(r2[0], "first") { return "first preserved" }
	if !streq2(r2[1], "second") { return "second appended" }
	return ""
}

// materializeModuleStrings copies StringConst byte data into fresh
// @[]char slices. Each output entry must be a deep copy whose
// length matches the StringConst.Len.
func TestMaterializeModuleStrings() testing.TestResult {
	var consts @[]ir.StringConst = make_slice(ir.StringConst, 2)
	consts[0].ID = 0
	consts[0].Data = "hello"
	consts[0].Len = 5
	consts[1].ID = 1
	consts[1].Data = "hi"
	consts[1].Len = 2
	var out @[]@[]char = materializeModuleStrings(consts)
	if len(out) != 2 { return "expected 2 materialized strings" }
	if !streq2(out[0], "hello") { return "out[0] should be 'hello'" }
	if !streq2(out[1], "hi") { return "out[1] should be 'hi'" }
	return ""
}

// lookupGlobalAddr walks globalNames/globalAddrs and returns the
// address of a matching name, or 0 on miss. MaterializeOneGlobal
// drives the registration; this test exercises both together via
// the package-level globalNames/globalAddrs state.
func TestLookupGlobalAddrHitAndMiss() testing.TestResult {
	// Reset shared state to a known empty.
	var empty1 @[]@[]char
	globalNames = empty1
	var empty2 @[]int
	globalAddrs = empty2

	// Register one global.
	var g @ir.Global = make(ir.Global)
	g.Name = "x"
	g.Typ = nil  // SizeOf(nil) returns 0 → MaterializeOneGlobal
	             // bumps to a min-8-byte alloc.
	MaterializeOneGlobal(g)

	if lookupGlobalAddr("x") == 0 {
		return "registered global x should have non-zero addr"
	}
	if lookupGlobalAddr("nonexistent") != 0 {
		return "miss should return 0"
	}
	return ""
}

// registerGlobalAddr binds a fully-qualified global name to an EXTERNALLY-owned
// address (the global-injection path: a native-only package's sentinel cell),
// and a later bytecode cross-package read must resolve to that EXACT address —
// that pointer identity is what makes cross-mode errors.Is work.  The injected
// name is fully-qualified (dotted), so it resolves regardless of the current
// module's pkg prefix (QualifyName passes dotted names through unchanged).
func TestRegisterGlobalAddrResolvesToInjectedAddr() testing.TestResult {
	var empty1 @[]@[]char
	globalNames = empty1
	var empty2 @[]int
	globalAddrs = empty2

	// A fake "native sentinel cell" address; lookupGlobalAddr must return it
	// verbatim, not merely non-zero.
	var nativeAddr int = 305419896 // 0x12345678
	registerGlobalAddr("pkg/std/errors.NotFound", nativeAddr)

	if lookupGlobalAddr("pkg/std/errors.NotFound") != nativeAddr {
		return "injected global must resolve to its exact native address"
	}
	// A different injected sentinel under the same package resolves independently.
	registerGlobalAddr("pkg/std/errors.AlreadyExists", nativeAddr + 16)
	if lookupGlobalAddr("pkg/std/errors.AlreadyExists") != nativeAddr+16 {
		return "second injected global must resolve to its own address"
	}
	if lookupGlobalAddr("pkg/std/errors.NotFound") != nativeAddr {
		return "first injected global must stay resolvable after a second"
	}
	if lookupGlobalAddr("pkg/std/errors.Missing") != 0 {
		return "an unregistered sentinel must miss (0)"
	}
	return ""
}
