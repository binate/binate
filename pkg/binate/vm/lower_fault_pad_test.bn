package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for VM lowering of cleanup landing pads (Plan 2 Inc 2a): lower_func
// lowers the VM-only Func.FaultPads blocks after the body and builds
// VMFunc.FaultTable from each faulting op's ir.Instr.PadBlock.  IR-gen does not
// emit pads until Inc 2a-2, so the pad is constructed by hand here to exercise
// the lowering consumption (combinedBlocks + fault-table assembly) in isolation.

// A bounds-check tagged with a cleanup pad lowers to a VMFunc whose FaultTable
// maps the op's resume pc -> the pad's pc, with the pad's BC_UNWIND_RETURN
// terminator emitted AFTER the body.
func TestLowerFaultPadBuildsFaultTable() testing.TestResult {
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("test", "f", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var idx @ir.Instr = entry.EmitConstInt(0, types.TypInt())
	var ln @ir.Instr = entry.EmitConstInt(1, types.TypInt())
	entry.EmitBoundsCheck(idx, ln)
	var chk @ir.Instr = entry.Instrs[len(entry.Instrs) - 1]
	var noVals @[]@ir.Instr
	entry.EmitReturn(noVals)
	// A cleanup pad in FaultPads (NOT Blocks): a bare unwind terminator.
	var pad @ir.Block = ir.AddFaultPad(f, "fault_pad")
	pad.EmitUnwindReturn()
	chk.PadBlock = pad

	var vm @VM = NewVM(64 * 1024)
	var vmf @VMFunc = lowerFunc(vm, f)

	if len(vmf.FaultTable) != 2 {
		return "expected one fault entry (2 ints) in FaultTable"
	}
	var keyPC int = vmf.FaultTable[0]
	var padPC int = vmf.FaultTable[1]
	if keyPC <= 0 || keyPC >= len(vmf.Code) {
		return "fault key pc out of range"
	}
	// keyPC is the pc AFTER the guard's bytecode (the pc a fault observes).
	if vmf.Code[keyPC - 1].Op != BC_BOUNDS_CHECK {
		return "fault key pc should follow the BC_BOUNDS_CHECK"
	}
	if padPC < 0 || padPC >= len(vmf.Code) {
		return "pad pc out of range"
	}
	if vmf.Code[padPC].Op != BC_UNWIND_RETURN {
		return "pad bytecode should be BC_UNWIND_RETURN"
	}
	// The pad is emitted after the body (which ends before padPC).
	if padPC <= keyPC {
		return "pad should be emitted after the body"
	}
	return ""
}

// A function with no cleanup pads lowers to an empty FaultTable — the common
// case (pads are opt-in per faulting op), and the combined-block path is a no-op
// when FaultPads is empty.
func TestLowerNoPadsEmptyFaultTable() testing.TestResult {
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("test", "g", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var noVals @[]@ir.Instr
	entry.EmitReturn(noVals)

	var vm @VM = NewVM(64 * 1024)
	var vmf @VMFunc = lowerFunc(vm, f)
	if len(vmf.FaultTable) != 0 {
		return "a function with no pads should have an empty FaultTable"
	}
	return ""
}

// End-to-end (Inc 2a-2): a real function whose bounds check has a live managed
// local emits a cleanup pad through IR-gen (genBoundsCheck -> attachFaultPad), so
// lowering yields a non-empty FaultTable whose pad PCs land inside the code.
// `lowerFromSource` / `concatStr` live in lower_test.bn.
func TestBoundsCheckEmitsFaultPadEndToEnd() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func f(s @[]int, i int) int { return s[i] }\n")
	var vm @VM = lowerFromSource(src)
	var sawFaultTable bool = false
	for fi := 0; fi < len(vm.Funcs); fi++ {
		var ft @[]int = vm.Funcs[fi].FaultTable
		if len(ft) == 0 { continue }
		sawFaultTable = true
		if len(ft) % 2 != 0 {
			return "FaultTable must be (opPC, padPC) pairs (even length)"
		}
		for k := 0; k < len(ft); k = k + 2 {
			var padPC int = ft[k + 1]
			if padPC < 0 || padPC >= len(vm.Funcs[fi].Code) {
				return "fault-table padPC out of range"
			}
		}
	}
	if !sawFaultTable {
		return "a function with a bounds check should emit a fault pad (non-empty FaultTable)"
	}
	return ""
}
