package "pkg/binate/vm"

import "pkg/builtins/testing"

// Field access through a pointer produced by a bit_cast (fieldPtrBaseType,
// lower_memory.bn): the field offset must come from the pointee struct, not from
// the bit_cast's target type (a managed pointer).

// bitCastFieldSrc reads field b (offset 8) of a struct reached through
// `var s @S = bit_cast(@S, p)`.  Once load-forwarding forwards s, the field
// access's base is the bit_cast itself.
func bitCastFieldSrc() *[]readonly char {
	return "package \"test\"\n"
			"type S struct {\n\ta int\n\tb int\n}\n"
			"func get(p *uint8) int {\n"
			"\tvar s @S = bit_cast(@S, p)\n"
			"\treturn s.b\n"
			"}\n"
			"func main() int {\n"
			"\tvar s @S = make(S)\n"
			"\ts.a = 7\n"
			"\ts.b = 42\n"
			"\treturn get(bit_cast(*uint8, s))\n"
			"}\n"
}

func TestFieldPtrThroughBitCastNoPasses() testing.TestResult {
	if runVMAtLevel(bitCastFieldSrc(), 0) != 42 { return "s.b must read field b (42), not a" }
	return ""
}

func TestFieldPtrThroughBitCastForwarded() testing.TestResult {
	if runVMAtLevel(bitCastFieldSrc(), 2) != 42 {
		return "with s forwarded to the bit_cast, s.b must still read field b (42), not a (7)"
	}
	return ""
}
