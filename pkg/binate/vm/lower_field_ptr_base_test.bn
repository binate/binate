package "pkg/binate/vm"

import "pkg/binate/iropt"
import "pkg/builtins/testing"

// Field access through a pointer produced by a bit_cast (lowerGetFieldPtr,
// ir.FieldPtrBaseType): the field offset must come from the pointee struct, not
// from the bit_cast's target type (a managed pointer).

// bitCastFieldSrc reads field b (offset 8) of a struct reached through
// `var s @S = bit_cast(@S, p)`.  Once load-forwarding forwards s, the field
// access's base is the bit_cast itself.
func bitCastFieldSrc() *[]readonly char {
	return "package \"test\"\n"
			"type S struct {\n\ta int\n\tb int\n}\n"
			"func get(p *uint8) int {\n"
			"\tvar s @S = bit_cast(@S, p)\n"
			"\treturn s.b\n"
			"}\n"
			"func main() int {\n"
			"\tvar s @S = make(S)\n"
			"\ts.a = 7\n"
			"\ts.b = 42\n"
			"\treturn get(bit_cast(*uint8, s))\n"
			"}\n"
}

// runBitCastField runs bitCastFieldSrc's main under pass config c and checks
// it reads field b without faulting or leaking.
func runBitCastField(c iropt.OptConfig) testing.TestResult {
	var r int
	var faulted bool
	var leak int
	r, faulted, leak = shapedRun(bitCastFieldSrc(), "test.main", c, 5)
	if faulted { return "main must not fault" }
	if r != 42 { return "s.b must read field b (42), not a (7)" }
	if leak != 0 { return "main must not leak" }
	return ""
}

func TestFieldPtrThroughBitCastNoPasses() testing.TestResult {
	return runBitCastField(iropt.LevelOptConfig(0))
}

// With the passes on but inlining off, load-forwarding forwards s inside get,
// so the field access's base is the bit_cast.
func TestFieldPtrThroughBitCastForwarded() testing.TestResult {
	return runBitCastField(iropt.WithOptPass(iropt.LevelOptConfig(2), iropt.PASS_INLINE, false))
}
