package "pkg/binate/vm"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropt"
import "pkg/binate/types"
import "pkg/std/containers/vec"
import "pkg/std/strconv"

// A function's frame — the regions lowering gives the values it keeps in memory (its
// locals, its parameters, the aggregates it loads, ...: planFrameRegions) — may not pass
// the target's limit (types.FrameLimit, spec §21.4), as the native backends hold a frame to
// it: such a function does not load.  A frame within that limit that this host cannot hold
// (past hostFrameCap) loads, and calling it is the VM's recoverable stack-overflow fault,
// as a native call with such a frame overflows its stack (vmFrameSize).

// frameSaturated is the value a frame size saturates to (the int64 maximum) instead of
// wrapping: frameAdd, frameRoundUp8.
const frameSaturated int64 = 0x7FFFFFFFFFFFFFFF

// frameAdd returns a + b for frame sizes a, b >= 0, saturating at frameSaturated.
func frameAdd(a int64, b int64) int64 {
	if b > frameSaturated - a { return frameSaturated }
	return a + b
}

// frameRoundUp8 rounds the frame size n >= 0 up to a multiple of 8, saturating.
func frameRoundUp8(n int64) int64 {
	if n > frameSaturated - 7 { return frameSaturated }
	return (n + 7) & ~cast(int64, 7)
}

// hostFrameCap returns the largest frame the VM holds: half the host's int range, the rest
// left for the frame header and registers sized beside it (vm.bn).
func hostFrameCap() int64 {
	return cast(int64, cast(int, ~cast(uint, 0) >> 1)) / 2
}

// vmFrameSize returns the frame size the VM gives a function whose frame, within the
// target's limit, is frame bytes: the frame, or for one past hostFrameCap the cap, which no
// VM stack holds, so pushing the frame is the stack-overflow fault.
func vmFrameSize(frame int64) int {
	if frame > hostFrameCap() { return types.HostInt(hostFrameCap()) }
	return types.HostInt(frame)
}

// frameError returns the error for the frame of the function named name, frame bytes,
// when it passes the target's limit (a saturated sum does: frameAdd), or "".
func frameError(name *[]readonly char, frame int64) @[]char {
	if frame <= types.FrameLimit() && frame != frameSaturated { return "" }
	var limit @[]char = strconv.FormatInt(types.FrameLimit(), 10)
	return buf.Concat(
			buf.Concat(buf.Concat("the frame of ", name), " is larger than the target allows (at most "),
			buf.Concat(limit, " bytes)"))
}

// funcFrameBytes plans f's frame as lowerFunc does — its phis eliminated first (as lowering
// does; idempotent), over its body and fault-pad blocks, with the loads it reads in place —
// and returns the frame's size.  A function with a phi naming a predecessor not one of its
// blocks (irbuild.ForeignPhiPredError) is invalid IR, as lowerFunc finds it: its phis are
// not eliminated (EliminatePhis would change a block not among them: another function's,
// a fault pad or one dropped from its blocks), its error is recorded as a lowering error
// (noteLowerErr), and it is given no frame (0).
func funcFrameBytes(vm @VM, f @ir.Func) int64 {
	var phiErr @[]char = irbuild.ForeignPhiPredError(f)
	if len(phiErr) > 0 {
		noteLowerErr(vm, phiErr)
		return 0
	}
	iropt.EliminatePhis(f)
	var blocks @[]@ir.Block = combinedBlocks(f)
	_, frame := planFrameRegions(blocks, inPlaceLoads(f, blocks))
	return frame
}

// frameErrors returns the frame errors of fs, as they stand, one per function whose frame
// passes the target's limit, and records on vm the error of a function with invalid phis
// (funcFrameBytes).  Its callers stop with that error (failOnLowerErrs) before they return
// a frame error: it is the compiler's error, not the program's, and a frame error of
// another function would otherwise be reported in its place.
func frameErrors(vm @VM, fs *[]@ir.Func) @[]@[]char {
	var errs @vec.Vec[@[]char] = vec.New[@[]char]()
	for i := 0; i < len(fs); i++ {
		if fs[i].IsExtern { continue }
		var e @[]char = frameError(fs[i].Name, funcFrameBytes(vm, fs[i]))
		if len(e) > 0 { errs.Push(e) }
	}
	return errs.Items()
}

// FrameCheck returns the frame errors of fs after the per-function passes; see vm.bni.
func (vm @VM) FrameCheck(fs *[]@ir.Func) @[]@[]char {
	for i := 0; i < len(fs); i++ {
		if !fs[i].IsExtern { iropt.RunOptConfigFunc(fs[i], vm.Opt) }
	}
	var errs @[]@[]char = frameErrors(vm, fs)
	failOnLowerErrs(vm)
	return errs
}

// noteLowerErr records msg as an error lowering found (VM.lowerErrs).
func noteLowerErr(vm @VM, msg @[]char) {
	if vm.lowerErrs == nil { vm.lowerErrs = vec.New[@[]char]() }
	vm.lowerErrs.Push(msg)
}

// failOnLowerErrs stops with the first error lowering, or the frame check before it
// (frameErrors), recorded, an internal error either way.  A frame past the limit: every
// lowering entry point's functions are checked first — LowerModule's as it starts
// (frameErrors), the one-function entry points' by their callers (FrameCheck), and the
// functions generated after that check (a REPL receiver thunk, a destructor or copy
// helper) have frames no larger than a checked one's.  A phi naming a predecessor that is
// not one of its function's blocks (lowerFunc, funcFrameBytes) or a branch to a block that
// is neither one of them nor one of its fault pads (findBlockOffset): the IR is invalid.
func failOnLowerErrs(vm @VM) {
	if vm.lowerErrs == nil || vm.lowerErrs.Len() == 0 { return }
	var first @[]char = vm.lowerErrs.Get(0)
	vm.lowerErrs = nil
	vmPanic(buf.Concat("internal error: vm: ", first))
}
