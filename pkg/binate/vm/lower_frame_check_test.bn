package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the frame check (lower_frame_check.bn).  genModule is lower_test.bn's,
// newTestVM vm_test's.  Nothing here runs the code, so a target other than the host's
// can be pinned.

// frameSrc returns a module holding small, whose frame fits any target, and big, whose
// three locals of n, n and 64 bytes make its frame.
func frameSrc(n *[]readonly char) @[]char {
	var b @[]char = "package \"test\"\n"
			"func small() int { var a [8]uint8; a[1] = 2; return cast(int, a[1]) }\n"
	b = concatStr(b, "func big() int { var x [")
	b = concatStr(b, n)
	b = concatStr(b, "]uint8; var y [")
	b = concatStr(b, n)
	b = concatStr(b, "]uint8; var z [64]uint8; x[5] = 1; y[6] = 2; z[7] = 3\n")
	return concatStr(b, "return cast(int, x[5]) + cast(int, y[6]) + cast(int, z[7]) }\n")
}

// pinTarget sets a target of word bytes and returns the one it replaces.
func pinTarget(word int) types.TargetInfo {
	var old types.TargetInfo = types.GetTarget()
	var t types.TargetInfo
	t.PointerSize = word
	t.IntSize = word
	t.MaxAlign = 8
	types.SetTarget(t)
	return old
}

// A frame past a 32-bit target's 4 GiB (two locals of nearly 2 GiB and one of 64 bytes)
// cannot be built, as the native backends reject it: FrameCheck reports it, and
// LowerModule, which makes the check as it lowers, returns it, so the module does not load.
func TestFramePastTargetLimit() testing.TestResult {
	var old types.TargetInfo = pinTarget(4)
	defer { types.SetTarget(old) }
	var want *[]readonly char = "the frame of test.big is larger than the target allows (at most 42949"
			"67295 bytes)"
	var m @ir.Module = genModule(frameSrc("0x7FFFFFF8"))
	var errs @[]@[]char = newTestVM(testVMStackSize).FrameCheck(m.Funcs)
	if len(errs) != 1 || !streq(errs[0], want) { return "FrameCheck should report big's frame alone" }
	var loadErrs @[]@[]char = newTestVM(testVMStackSize).LowerModule(genModule(frameSrc("0x7FFFFFF8")))
	if len(loadErrs) != 1 || !streq(loadErrs[0], want) {
		return "LowerModule should return big's frame error"
	}
	return ""
}

// A frame within the target's limit that this host cannot hold loads, as the native
// backends compile it, and calling the function is the recoverable stack-overflow fault, as
// a native call with such a frame overflows its stack.  On the host's own target, as the
// function runs: two locals of 1 GiB on a 32-bit host, of 2^61 bytes on a 64-bit one.
func TestFramePastHostLoadsAndFaults() testing.TestResult {
	var n *[]readonly char = "0x2000000000000000"
	if sizeof(int) == 4 { n = "0x40000000" }
	var vm @VM = newTestVM(testVMStackSize)
	var errs @[]@[]char = vm.LowerModule(genModule(frameSrc(n)))
	if len(errs) != 0 { return concatStr("big should load: ", errs[0]) }
	var noArgs @[]int
	vm.CallFunc("test.big", noArgs)
	if vm.Status != VM_STATUS_FAULTED || !faultStrEq(vm.FaultMsg, "runtime error: stack overflow") {
		return "calling big should be the stack-overflow fault"
	}
	return ""
}

// Frame sizes saturate rather than wrap: two locals near 2^63 bytes on a 64-bit target (whose
// sum wraps to a small frame in int64) pass its limit, as the native backends hold them.
func TestFrameSumSaturates() testing.TestResult {
	var old types.TargetInfo = pinTarget(8)
	defer { types.SetTarget(old) }
	var want *[]readonly char = "the frame of test.big is larger than the target allows (at most 92233"
			"72036854775807 bytes)"
	var errs @[]@[]char = newTestVM(testVMStackSize).LowerModule(
			genModule(frameSrc("0x7FFFFFFFFFFFFFF0")))
	if len(errs) != 1 || !streq(errs[0], want) { return "the saturated frame should not load" }
	return ""
}
