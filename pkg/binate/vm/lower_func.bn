package "pkg/binate/vm"

import "pkg/binate/iropt"

import "pkg/binate/vmdata"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/std/containers/vec"

// Per-function IR-to-bytecode lowering: lowerFunc and its
// instruction-/phi-/call-arg helpers.  Module-level lowering
// (LowerModule, LowerOneFunc, vtable wiring, name/cache helpers) is in
// lower.bn.

// captureNeedsPtrPass reports whether a capture of type `t`
// must be passed to the closure-wrapper as a pointer (the field
// address inside the closure struct) rather than as the field's
// first-word value.  Matches lowerLoad / lowerStore's multi-word
// type list — these are the types the VM passes by pointer
// throughout the call convention, so a capture-as-value would
// reach the wrapper's body in a shape it can't interpret.  Every
// transparent wrapper (named / alias / readonly) is peeled first: a
// closure-struct field keeps a capture's `readonly` (e.g. a captured
// `readonly @[]int` local), and a wrapper has no Kind of its own, so an
// unpeeled test would pass a multi-word capture by its first word.
func captureNeedsPtrPass(t @types.Type) bool {
	t = types.StripWrappers(t)
	if t == nil { return false }
	var k int = t.Kind
	if k == types.TYP_STRUCT { return true }
	if k == types.TYP_SLICE { return true }
	if k == types.TYP_MANAGED_SLICE { return true }
	if k == types.TYP_ARRAY { return true }
	if k == types.TYP_FUNC_VALUE { return true }
	if k == types.TYP_MANAGED_FUNC_VALUE { return true }
	if k == types.TYP_INTERFACE_VALUE { return true }
	if k == types.TYP_INTERFACE_VALUE_MANAGED { return true }
	return false
}

// lowerFunc converts one IR function to a VMFunc with bytecode.
func lowerFunc(vm @VM, f @ir.Func) @VMFunc {
	// Destruct SSA first: the VM has no phi opcode, so iropt.EliminatePhis replaces
	// OP_PHIs with OP_COPY moves (splitting critical edges).  Must run before the
	// block/register sizing below, which reads f.Blocks and f.NextID (the pass
	// appends split blocks and mints copy-temp ids).  Idempotent; a no-op for a
	// phi-free function.
	iropt.EliminatePhis(f)
	var vmf @VMFunc = make(VMFunc)
	// f.Name is the canonical fully-qualified form; pass it through
	// qualifyCallName which is a no-op for dotted names but stays
	// defensive against any not-yet-qualified Func arrivals.
	vmf.Name = qualifyCallName(vm, f.Name)
	vmf.NumParams = len(f.Params)
	// NumParamSlots is the packed slot count of the parameters: a
	// 64-bit-scalar param occupies 2 slots when the host word is <
	// 8 bytes.  BC_CALL receives an Imm = packed
	// slot count and copies that many slots from the caller's packed
	// region into the callee's regs[0..NumParamSlots).
	vmf.NumParamSlots = 0
	for i := 0; i < len(f.Params); i++ {
		vmf.NumParamSlots = vmf.NumParamSlots + argSlots(f.Params[i].Typ)
	}
	// Result-derived metadata (NumResults, per-result sizes/offsets/multi-word
	// flags, the single-64-bit-scalar-return flag, and the single-result interface
	// vtable-word offsets) is a pure function of the result types, factored into a
	// helper so this file stays under the soft length cap.
	populateResultMetadata(vmf, f)

	// Capture metadata for capturing closures.  The closure
	// struct's field layout drives the offsets the BC dispatcher
	// uses to read captures into the callee's regs.  Per-capture
	// pass-by-pointer flag flips when the capture type is one
	// the VM passes by pointer (struct / slice / interface / func
	// value); the dispatcher then writes the FIELD ADDRESS rather
	// than the field's first word into the callee's reg.
	if f.IsClosure {
		vmf.IsClosure = true
		vmf.NumCaptureParams = f.NumCaptureParams
		vmf.CaptureOffsets = make_slice(int, f.NumCaptureParams)
		vmf.CaptureByPtr = make_slice(bool, f.NumCaptureParams)
		vmf.CaptureWide = make_slice(bool, f.NumCaptureParams)
		if f.ClosureStruct != nil {
			for i := 0; i < f.NumCaptureParams; i++ {
				vmf.CaptureOffsets[i] = f.ClosureStruct.FieldOffset(i)
				vmf.CaptureByPtr[i] = captureNeedsPtrPass(
						f.ClosureStruct.Fields[i].Type)
				// A 64-bit scalar capture rides a register pair on ILP32;
				// is64BitScalar is false for the by-ptr aggregate types, so
				// the two flags never both set.
				vmf.CaptureWide[i] = is64BitScalar(f.ClosureStruct.Fields[i].Type) && REG_SLOT < 8
			}
		}
		// qualifyCallName mirrors how vmf.Name is set, so the runtime
		// LookupFunc in BC_REFDEC matches the dtor VMFunc's Name.
		if len(f.ClosureStructDtorName) > 0 {
			vmf.ClosureStructDtorName = qualifyCallName(vm, f.ClosureStructDtorName)
		}
	}

	vm.curNames = vec.New[@[]char]()
	// Per-call-site argument interface-vtable layouts accumulate here as call ops
	// emit (buildArgIfaceLayout appends); assigned to vmf.ArgIfaceLayouts below.
	// Reset per function so the 1-based index a call instruction carries stays
	// per-function (matching curNames' per-function lifetime).
	vm.curArgIfaceLayouts = vec.New[@vmdata.ArgIfaceLayout]()

	// `blocks` is the function's body blocks followed by its VM-only cleanup
	// pads (Func.FaultPads); the VM lowers both (pads get PCs after the body so a
	// fault can branch to one), while the compiled backends iterate only
	// Func.Blocks.  Empty FaultPads ⇒ blocks == f.Blocks (no copy, no behavior
	// change).  See combinedBlocks.
	var blocks @[]@ir.Block = combinedBlocks(f)

	// Each value's register is the slot assignSlots gives it (values whose live
	// ranges do not overlap share one), then come the extra registers for call
	// arg packing and globals.
	var wide @[]bool = regWidths(f, f.NextID, REG_SLOT)
	var slotOf @[]int
	var numSlots int
	slotOf, numSlots = assignSlots(f, blocks, wide)
	var maxArgs int = findMaxCallArgs(vm, f)
	var callArgBase int = numSlots
	// Distinct registers for global-address temporaries: an instruction
	// with N global-address args (e.g. `return &G, &H`, `&G == &H`) needs
	// N registers so the per-arg LOAD_IMMs don't clobber one another
	// before the instruction consumes them.
	var globalRegBase int = numSlots + maxArgs
	// Reserve one register per global-address arg of the widest
	// instruction, but always at least one (the prior frame size — a
	// function with 0 or 1 global args keeps exactly one global slot, so
	// only genuinely multi-global instructions change the layout).
	var globalRegs int = findMaxGlobalsPerInstr(vm, f)
	if globalRegs < 1 { globalRegs = 1 }
	vmf.NumRegs = numSlots + maxArgs + globalRegs

	// First pass: compute the stack frame layout — each region-owning
	// instruction's offset, by its index over `blocks` (planFrameRegions).
	var regionOffs @[]int
	var frameSize int
	var inPlace @[]bool = inPlaceLoads(f, blocks)
	regionOffs, frameSize = planFrameRegions(blocks, inPlace)
	var slotsByID @[]int = resultSlots(f)
	var resultSlotsAt @resultSlotPlan = planResultSlots(f, blocks, regionOffs, slotsByID)
	vmf.FrameSize = frameSize

	// Second pass: compute block offsets (label → bytecode index)
	// We need to know how many bytecodes each block produces.
	// Do a dry run to count, then a real emit pass.
	var blockOffsets @[]int = make_slice(int, len(blocks))
	var totalInstrs int = 0
	// faultCount: ops tagged with a cleanup pad (ir.Instr.PadBlock) — counted
	// here so the emit pass fills fixed-size fault-entry arrays.
	var faultCount int = 0
	for i := 0; i < len(blocks); i++ {
		blockOffsets[i] = totalInstrs
		var blk @ir.Block = blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			if instr.PadBlock != nil {
				faultCount = faultCount + 1
			}
			totalInstrs = totalInstrs + 1
			// OP_CALL packs each arg with a single BC_MOV / BC_MOV64 — a
			// by-value aggregate rides ONE by-address slot (the shim loads
			// + re-coerces it), so no per-word expansion.  Must match the
			// third-pass emission exactly.
			if instr.Op == iropcode.OP_CALL {
				totalInstrs = totalInstrs + len(instr.Args)
			}
			// Multi-return emits one MOV per result.
			if instr.Op == iropcode.OP_RETURN && len(instr.Args) > 1 {
				totalInstrs = totalInstrs + len(instr.Args)
			}
			// OP_CALL_INDIRECT: fn_ptr is Args[0] and is read from
			// its register at execution; only Args[1..] need MOVs
			// to the contiguous callArgBase region.
			if instr.Op == iropcode.OP_CALL_INDIRECT {
				totalInstrs = totalInstrs + len(instr.Args) - 1
			}
			// OP_CALL_FUNC_VALUE: Args[0] is the function value's
			// register (read at execution); Args[1..] need MOVs to
			// callArgBase like OP_CALL_INDIRECT.
			if instr.Op == iropcode.OP_CALL_FUNC_VALUE {
				totalInstrs = totalInstrs + len(instr.Args) - 1
			}
			// OP_CALL_HANDLE: same arg-packing shape as
			// OP_CALL_FUNC_VALUE (Args[0] = handle ptr read at
			// execution; Args[1..] pre-packed into callArgBase).
			if instr.Op == iropcode.OP_CALL_HANDLE {
				totalInstrs = totalInstrs + len(instr.Args) - 1
			}
			// OP_CALL_IFACE_METHOD: Args[0] is the interface
			// value's register; Args[1..] need MOVs.
			if instr.Op == iropcode.OP_CALL_IFACE_METHOD {
				totalInstrs = totalInstrs + len(instr.Args) - 1
			}
			// Post-call sub-word/bool RETURN narrow (BC_ZEXT/BC_SEXT) for a
			// cross-mode call -- must match the third-pass emission exactly
			// (callReturnNeedsSubWordNarrow + subWordReturnInfo).
			if callReturnNeedsSubWordNarrow(vm, instr) {
				var nrw int
				var nrs bool
				nrw, nrs = subWordReturnInfo(instr.Typ)
				_ = nrs
				if nrw > 0 {
					totalInstrs = totalInstrs + 1
				}
			}
			// Global refs emit extra LOAD_IMM (one per occurrence).
			// Detection uses Instr.IsGlobalRef (set by lookupVar's
			// global-fallback path). Must NOT use a name-based
			// heuristic: a local alloca whose variable name happens
			// to collide with a global (e.g. a parameter named
			// `target` in a package that also declares
			// `var target TargetInfo`) would otherwise be routed to
			// the global's storage. Must match the third-pass
			// condition exactly so block offsets agree.
			for k := 0; k < len(instr.Args); k++ {
				if instr.Args[k] != nil && instr.Args[k].IsGlobalRef {
					totalInstrs = totalInstrs + 1
				}
			}
		}
	}

	// Third pass: emit bytecode
	var code @[]BCInstr = make_slice(BCInstr, totalInstrs)
	var codeIdx int = 0

	// Fault entries: parallel arrays filled as pad-tagged ops emit.
	// faultKeyPCs[k] is the PC AFTER the faulting/call op's main bytecode (the
	// resume pc a fault or a caller-unwind observes — the loop pre-increments pc,
	// and pushFrame saves that post-op pc as callerPC); faultPadIdxs[k] the op's
	// cleanup-pad index in `blocks`.  Resolved into VMFunc.FaultTable after emit.
	var faultKeyPCs @[]int = make_slice(int, faultCount)
	var faultPadIdxs @[]int = make_slice(int, faultCount)
	var faultIdx int = 0

	// While the bytecode is emitted each value's ID is its slot, so every
	// register a lowering forms from an ID is the slot; the IDs are put back
	// after.
	var renumbered @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
	var formerIDs @vec.Vec[int] = vec.New[int]()
	renumberValues(f, blocks, slotOf, renumbered, formerIDs)
	var instrIdx int = 0
	// The aggregate load read in place last emitted (inPlace); its one store follows it.
	var inPlaceLoad @ir.Instr
	for i := 0; i < len(blocks); i++ {
		blockOffsets[i] = codeIdx
		var blk @ir.Block = blocks[i]

		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			var pos int = instrIdx
			var regionOff int = regionOffs[pos]
			var loadInPlace bool = inPlace[pos]
			instrIdx = instrIdx + 1

			// Fix up global references: IR generation may share
			// the same pseudo-global-ref @Instr across multiple
			// uses (e.g. load-old-then-store-new of a global
			// managed slice). Detect via IsGlobalRef (set by
			// lookupVar) — name-based detection would falsely
			// match local allocas whose variable name collides
			// with a global. Materialize each global address with
			// its own LOAD_IMM into a DISTINCT register
			// (globalRegBase + g): per use, so an address clobbered
			// by a later instruction is reloaded; and per arg, so
			// two distinct global addresses in ONE instruction
			// (`return &G, &H`, `&G == &H`) don't alias the same
			// register.
			var gReg int = globalRegBase
			for k := 0; k < len(instr.Args); k++ {
				if instr.Args[k] != nil && instr.Args[k].IsGlobalRef {
					var addr int = lookupGlobalAddr(vm, instr.Args[k].StrVal)
					if addr == 0 {
						// LowerModule load-checks a module first (LoadCheck), and the REPL
						// a prompt entry's functions: code lowered without that check stops
						// here.
						vmPanicName("vm: nothing in the program defines the package variable ", instr.Args[k].StrVal)
					}
					var loadImm BCInstr
					loadImm.Op = BC_LOAD_IMM
					loadImm.Dst = gReg
					loadImm.Imm = addr
					code[codeIdx] = loadImm
					codeIdx = codeIdx + 1
					instr.Args[k].ID = gReg
					gReg = gReg + 1
				}
			}

			// For OP_CALL, pack args with width awareness — a
			// 64-bit-scalar arg occupies 2 slots in the call-arg
			// region (BC_MOV64) on a host whose word is < 8 bytes;
			// the destination offset advances by
			// the width.  On a 64-bit host every arg is one slot, so
			// the behavior is unchanged.
			if instr.Op == iropcode.OP_CALL {
				// Pack each arg with a single MOV — a by-value aggregate
				// rides ONE by-address slot (the VM register holds the
				// struct's ADDRESS); the per-function shim loads + re-coerces
				// it to the underlying's ABI (emit_funcvals_shim).  Identical
				// to the OP_CALL_IFACE_METHOD / func-value packing below.
				var packOff int = 0
				for k := 0; k < len(instr.Args); k++ {
					var mov BCInstr
					var sw int = argSlots(instr.Args[k].Typ)
					if sw == 2 {
						mov.Op = BC_MOV64
					} else {
						mov.Op = BC_MOV
					}
					mov.Dst = callArgBase + packOff
					mov.Src1 = instr.Args[k].ID
					code[codeIdx] = mov
					codeIdx = codeIdx + 1
					packOff = packOff + sw
				}
			}
			// Multi-return packing is pair-aware: an int64/uint64/
			// float64 return value packs into 2 slots on a host
			// whose word is < 8 bytes.  The BC_RETURN.Dst>0
			// executor mirrors the packed layout via srcSlot
			// accounting.
			if instr.Op == iropcode.OP_RETURN && len(instr.Args) > 1 {
				var packOff int = 0
				for k := 0; k < len(instr.Args); k++ {
					var mov BCInstr
					var w int = argSlots(instr.Args[k].Typ)
					if w == 2 {
						mov.Op = BC_MOV64
					} else {
						mov.Op = BC_MOV
					}
					mov.Dst = callArgBase + packOff
					mov.Src1 = instr.Args[k].ID
					code[codeIdx] = mov
					codeIdx = codeIdx + 1
					packOff = packOff + w
				}
			}
			// OP_CALL_INDIRECT: pack only Args[1..] (Args[0] is fn_ptr,
			// passed via its own register). OP_CALL_FUNC_VALUE,
			// OP_CALL_HANDLE, and OP_CALL_IFACE_METHOD share the
			// same arg-packing shape.
			if instr.Op == iropcode.OP_CALL_INDIRECT || instr.Op == iropcode.OP_CALL_FUNC_VALUE ||
					instr.Op == iropcode.OP_CALL_HANDLE || instr.Op == iropcode.OP_CALL_IFACE_METHOD {
				// Args[0] is the receiver (fn ptr / func value /
				// iface) read by the call's own handler — not
				// packed here.  Args[1..] are pair-aware-packed
				// just like OP_CALL.
				var packOff int = 0
				for k := 1; k < len(instr.Args); k++ {
					var mov BCInstr
					var w int = argSlots(instr.Args[k].Typ)
					if w == 2 {
						mov.Op = BC_MOV64
					} else {
						mov.Op = BC_MOV
					}
					mov.Dst = callArgBase + packOff
					mov.Src1 = instr.Args[k].ID
					code[codeIdx] = mov
					codeIdx = codeIdx + 1
					packOff = packOff + w
				}
			}
			var bc BCInstr = applyResultSlot(lowerInstr(vm, instr, regionOff, blockOffsets, f, callArgBase),
					resultSlotsAt, pos)
			if loadInPlace {
				// Read in place (inPlaceLoads): the value is its source's address.
				bc.Op = BC_MOV
				inPlaceLoad = instr
			} else if instr.Op == iropcode.OP_STORE && bc.Op == BC_MEMCPY && inPlaceLoad != nil &&
					instr.Args[1] == inPlaceLoad {
				bc.Op = BC_MEMMOVE
			}
			code[codeIdx] = bc
			codeIdx = codeIdx + 1
			if instr.PadBlock != nil {
				// Tagged faulting/call op: record (resume pc, pad-block index).
				// codeIdx is now the pc past the op's main bytecode — exactly the
				// pc a fault sees (loop pre-increments) or a caller-unwind resumes
				// at (pushFrame saved it as callerPC).  Resolved below.
				faultKeyPCs[faultIdx] = codeIdx
				faultPadIdxs[faultIdx] = blockIndexOf(blocks, instr.PadBlock)
				faultIdx = faultIdx + 1
			}
			// Canonicalize a cross-mode sub-word/bool scalar RETURN: the native
			// shim leaves bits above the value's width undefined (garbage on
			// x86-64), and the VM reads the return as a full i64, so a direct use
			// (!b, a compare) would misread it.  Narrow Dst to its width.  Applies
			// to a direct extern OP_CALL AND to the runtime-dispatched ops (iface
			// method / func value / handle / indirect), whose callee may be native
			// — a no-op when it resolves to a VM function (callReturnNeedsSubWordNarrow).
			if callReturnNeedsSubWordNarrow(vm, instr) {
				var nw int
				var ns bool
				nw, ns = subWordReturnInfo(instr.Typ)
				if nw > 0 {
					var narrow BCInstr
					if ns {
						narrow.Op = BC_SEXT
					} else {
						narrow.Op = BC_ZEXT
					}
					narrow.Dst = bc.Dst
					narrow.Src1 = bc.Dst
					narrow.Imm = nw
					code[codeIdx] = narrow
					codeIdx = codeIdx + 1
				}
			}
		}
	}

	restoreValueIDs(renumbered, formerIDs)
	vmf.Code = code[:codeIdx]

	// Pass 2 counted faultCount pad-tagged ops; pass 3 must have emitted exactly
	// that many entries.  If they diverge (a future emit-side skip not mirrored
	// in the pass-2 count), catch it here rather than reading unwritten slots and
	// silently corrupting the table.
	if faultIdx != faultCount {
		vmPanic("vm: fault-entry count mismatch between lowering passes")
	}

	// Assemble the recoverable-fault table: each pad-tagged op's resume pc → its
	// cleanup pad's pc, as inline (opPC, padPC) pairs.  Emission is in ascending
	// pc order, so the table is already sorted for lookupFaultPad's binary search.
	if faultCount > 0 {
		var ft @[]int = make_slice(int, faultCount * 2)
		for i := 0; i < faultCount; i++ {
			if faultPadIdxs[i] < 0 {
				vmPanic("vm: fault-pad block not found in function (lowering bug)")
			}
			ft[i * 2] = faultKeyPCs[i]
			ft[i * 2 + 1] = blockOffsets[faultPadIdxs[i]]
		}
		vmf.FaultTable = ft
	}

	vmf.Names = vm.curNames.Items()
	vmf.ArgIfaceLayouts = vm.curArgIfaceLayouts.Items()
	vmf.CallCache = make_slice(int, vm.curNames.Len())
	for i := 0; i < vm.curNames.Len(); i++ {
		vmf.CallCache[i] = -2
	}
	vmf.HandleCache = newHandleCache(vmf.Code, vm.curNames.Len())
	vmf.Strings = vm.moduleStrings
	// Worst-case per-statement vm.SP temp growth, reserved on top of frameExtent
	// at pushFrame so no statement can overrun vm.Stack.  Computed from the
	// IR (f), not the lowered bytecode.
	vmf.MaxStmtTempGrowth = computeMaxStmtTempGrowth(vm, f, slotsByID)
	return vmf
}
