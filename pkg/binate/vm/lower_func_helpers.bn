package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/binate/types/abi"

// populateResultMetadata fills vmf's result-derived metadata from f's result
// types: NumResults, the per-result sizes / offsets / multi-word flags, the
// single-64-bit-scalar-return flag, and the single-result interface vtable-word
// offsets.  Factored out of lowerFunc so that file stays under the soft length
// cap; a pure function of the result types, so it needs no other lowering state.
func populateResultMetadata(vmf @VMFunc, f @ir.Func) {
	vmf.NumResults = len(f.Results)

	// Compute per-result sizes and offsets.  Populated for both single-result and
	// multi-return functions: BC_RETURN's multi-return packing reads ResultOffsets
	// (which slot each value lands in) and ResultMultiWord (whether a slot carries
	// a pointer to memcpy vs a scalar word).  Layout matches IR's
	// makeMultiReturnStructType: each field is aligned to its natural alignment.
	// (The cross-mode func-value trampoline SELECTION and its memcpy size are
	// driven by ResultRetbufBytes, set below, not by this per-result table.)
	if len(f.Results) >= 1 {
		vmf.ResultSizes = make_slice(int, len(f.Results))
		vmf.ResultOffsets = make_slice(int, len(f.Results))
		vmf.ResultMultiWord = make_slice(bool, len(f.Results))
		var off int = 0
		for i := 0; i < len(f.Results); i++ {
			var t @types.Type = f.Results[i]
			var align int = t.AlignOf()
			if align > 1 {
				off = (off + align - 1) / align * align
			}
			vmf.ResultOffsets[i] = off
			vmf.ResultSizes[i] = t.SizeOf()
			// An interface- or function-value result component is a 16-byte
			// address-based aggregate: packMultiReturn must memcpy it from the
			// address in its register, not copy a single scalar word (which leaves
			// the value's second word garbage in caller space — see
			// isVMAddressAggregate).
			vmf.ResultMultiWord[i] = isMultiWordField(t) || isVMAddressAggregate(t)
			off = off + vmf.ResultSizes[i]
		}
	}

	// Cross-mode func-value dispatch metadata, keyed off the SAME predicates the
	// compiled caller uses (its single source of truth), so the VM's trampoline
	// selection and copy agree with the caller's shim shape:
	//   - ResultUsesRetbuf (abi.IsAggregateReturn): whether the caller uses the
	//     retbuf shim shape — true for every multi-return tuple (which the old
	//     per-result ResultMultiWord gate missed) and any single wide/coerced
	//     aggregate; false for a scalar/void/single-0-byte-struct result (aligning
	//     that edge to the scalar shim).  ensureHandle selects TrampolineAggregate
	//     iff this holds.
	//   - ResultRetbufBytes (abi.ResultImageSize): the natural byte count the
	//     trampoline copies into the caller's natural-typed retbuf.  Distinct from
	//     selection: an all-zero-size tuple is retbuf-dispatched yet copies 0 bytes.
	vmf.ResultUsesRetbuf = abi.IsAggregateReturn(f.Results)
	vmf.ResultRetbufBytes = types.HostInt(abi.ResultImageSize(f.Results))

	// ResultReg64Scalar: a single bare 64-bit scalar result (int64 / uint64 /
	// float64) on a host whose word is < 8 bytes rides a register PAIR, so
	// ensureHandle picks TrampolineScalar64 (i64 return) over TrampolineScalar (one
	// word) to carry both halves back to a native caller.  Peel all transparent
	// wrappers (StripWrappers: alias + readonly + named) to agree with
	// funcSignatureLLVM's i64 vtable.call type, which is decided over the raw
	// declared result the same way — a readonly/alias 64-bit scalar must not
	// disagree, or the caller reads r0:r1 while a narrow trampoline sets only r0.
	vmf.ResultReg64Scalar = len(f.Results) == 1 &&
			is64BitScalarReturn(types.StripWrappers(f.Results[0]), REG_SLOT)

	// ResultIfaceVtOffsets: the byte offsets of every interface vtable word across
	// ALL results (recursing into a struct / array, and shifting each tuple slot by
	// its ResultOffsets[i]).  When this func is dispatched cross-mode its returned
	// image is copied into the caller's retbuf; a bytecode impl's VM-index vtable
	// word there would fault native code, so substituteVtWords replaces each of
	// these words with the impl's native handle-vtable in that copy.  A single
	// aggregate result goes through TrampolineAggregate; a multi-return tuple with
	// an interface slot goes through CallFuncAggregate — both consume this list, so
	// it must cover every result, not just a single one.
	vmf.ResultIfaceVtOffsets = ifaceVtOffsetsForResults(f.Results, vmf.ResultOffsets)
}

// Per-function lowering helpers.  Instruction counting
// (findMaxCallArgs / findMaxGlobalsPerInstr — sizing the call-arg and
// global-address register regions) and block-offset lookup
// (findBlockOffset).  lowerFunc and captureNeedsPtrPass are in lower_func.bn.

// callTargetIsExtern reports whether a concrete OP_CALL targets an injected
// (native) extern rather than a bytecode VM function — i.e. the call dispatches
// through the cross-mode shim, where a coerced aggregate argument must be expanded
// into its value words.  Externs are registered (RegisterStandardExterns /
// InjectStdlibExterns) before LowerModule, so the lookup is valid at lowering
// time, and a pkg/std package UNDER TEST is lowered to bytecode (not injected), so
// it correctly returns false there.  Only OP_CALL (a statically-named target) is
// classifiable; the iface/func-value cross-mode cases are runtime-determined, so
// this does not classify them.
func callTargetIsExtern(vm @VM, instr @ir.Instr) bool {
	if instr.Op != iropcode.OP_CALL { return false }
	return vm.LookupExtern(qualifyCallName(vm, instr.StrVal)) >= 0
}

// callReturnNeedsSubWordNarrow reports whether a call's scalar return must get a
// post-call canonicalizing narrow (BC_ZEXT/BC_SEXT).  A cross-mode native callee
// leaves bits above a sub-word/bool result's width undefined and the VM reads the
// shim's return as a full word, so a direct use (`!b`, a compare) would misread
// it.  True for a direct OP_CALL to an injected extern (callTargetIsExtern) and
// ALWAYS for the runtime-dispatched ops (iface method / func value / handle /
// indirect): their callee is resolved at runtime, so the narrow is emitted
// unconditionally — a no-op when the resolved callee is a VM function (its return
// is already clean) and needed when it is native.  The caller still gates on
// subWordReturnInfo, so a full-word / pointer / float / aggregate / void return
// (width 0) adds no narrow.
func callReturnNeedsSubWordNarrow(vm @VM, instr @ir.Instr) bool {
	if instr.Op == iropcode.OP_CALL {
		return callTargetIsExtern(vm, instr)
	}
	if instr.Op == iropcode.OP_CALL_IFACE_METHOD { return true }
	if instr.Op == iropcode.OP_CALL_FUNC_VALUE { return true }
	if instr.Op == iropcode.OP_CALL_HANDLE { return true }
	if instr.Op == iropcode.OP_CALL_INDIRECT { return true }
	return false
}

// findMaxCallArgs returns the maximum number of register slots needed
// for the call-arg-packing region across all call/multi-return
// instructions.  A 64-bit-scalar arg packs into 2 slots on a host
// whose word is < 8 bytes; on a 64-bit host this degenerates to the
// arg count.  A by-value aggregate rides ONE by-address slot (the shim
// loads + re-coerces it).  A multi-return packs its results into the
// same region, pair-aware the same way.
func findMaxCallArgs(vm @VM, f @ir.Func) int {
	var max int = 0
	var bl @[]@ir.Block = combinedBlocks(f)
	for i := 0; i < len(bl); i++ {
		var blk @ir.Block = bl[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			var n int = 0
			var start int = -1
			if instr.Op == iropcode.OP_CALL { start = 0 }
			if instr.Op == iropcode.OP_CALL_INDIRECT { start = 1 }
			if instr.Op == iropcode.OP_CALL_FUNC_VALUE { start = 1 }
			if instr.Op == iropcode.OP_CALL_HANDLE { start = 1 }
			if instr.Op == iropcode.OP_CALL_IFACE_METHOD { start = 1 }
			if start >= 0 {
				for k := start; k < len(instr.Args); k++ {
					n = n + argSlots(instr.Args[k].Typ)
				}
			}
			if instr.Op == iropcode.OP_RETURN && len(instr.Args) > 1 {
				// Multi-return packs results into the same
				// region, pair-aware.
				for k := 0; k < len(instr.Args); k++ {
					n = n + argSlots(instr.Args[k].Typ)
				}
			}
			if n > max { max = n }
		}
	}
	return max
}

// findMaxGlobalsPerInstr returns the largest number of distinct
// global-address args carried by any single instruction — IsGlobalRef
// args, set by lookupVar's global fallback (one that resolves to no
// global stops lowering, in lowerFunc).  lowerFunc reserves this many
// global-address registers so an instruction with several global args
// (e.g. `return &G, &H` or `&G == &H`) gives each its own register; one
// shared register would have the later LOAD_IMMs clobber the earlier
// addresses before the instruction reads them.  Matches the condition
// the emit pass uses, so reservation and use agree.
func findMaxGlobalsPerInstr(vm @VM, f @ir.Func) int {
	var max int = 0
	var bl @[]@ir.Block = combinedBlocks(f)
	for i := 0; i < len(bl); i++ {
		var blk @ir.Block = bl[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			var n int = 0
			for k := 0; k < len(instr.Args); k++ {
				if instr.Args[k] != nil && instr.Args[k].IsGlobalRef {
					n = n + 1
				}
			}
			if n > max { max = n }
		}
	}
	return max
}

// findBlockOffset returns the bytecode index for a target block.  Searches body
// blocks (indices 0..len(Blocks)-1 in blockOffsets) then FaultPads (indices
// len(Blocks)..) — matching combinedBlocks' order — so a branch INSIDE a cleanup
// pad (a managed slice / iface-value / func-value RefDec splits blocks) maps to
// its pad block's PC while body branches still hit body blocks.  Searched inline
// (not via combinedBlocks) to avoid allocating a joined slice on every branch
// resolution.
func findBlockOffset(f @ir.Func, target *ir.Block, blockOffsets *[]int) int {
	for i := 0; i < len(f.Blocks); i++ {
		if f.Blocks[i] == target {
			return blockOffsets[i]
		}
	}
	for i := 0; i < len(f.FaultPads); i++ {
		if f.FaultPads[i] == target {
			return blockOffsets[len(f.Blocks) + i]
		}
	}
	return 0
}

// combinedBlocks returns the function's body blocks followed by its VM-only
// cleanup pad blocks (Func.FaultPads).  The VM lowers BOTH — pads get bytecode
// PCs after the body so a fault can branch to one
// — while the compiled backends iterate only Func.Blocks and never see them.
// Returns f.Blocks directly (no copy) in the common no-pad case; body blocks keep
// indices 0..len(Blocks)-1, so findBlockOffset (body-only branch targets) is
// unaffected.
func combinedBlocks(f @ir.Func) @[]@ir.Block {
	if len(f.FaultPads) == 0 {
		return f.Blocks
	}
	var out @[]@ir.Block = make_slice(@ir.Block, len(f.Blocks) + len(f.FaultPads))
	for i := 0; i < len(f.Blocks); i++ {
		out[i] = f.Blocks[i]
	}
	for i := 0; i < len(f.FaultPads); i++ {
		out[len(f.Blocks) + i] = f.FaultPads[i]
	}
	return out
}

// blockIndexOf returns the index of the block `target` points at within `blocks`
// (by pointer identity), or -1.  Resolves a faulting op's ir.Instr.PadBlock (a
// raw *Block back-ref, like Block.Func) to its slot so VM lowering can map the
// op's bytecode PC onto its cleanup pad's PC in VMFunc.FaultTable.  A @Block and
// a *Block pointing at the same Block bit_cast to the same payload address.
func blockIndexOf(blocks @[]@ir.Block, target *ir.Block) int {
	var t int = bit_cast(int, target)
	for i := 0; i < len(blocks); i++ {
		if bit_cast(int, blocks[i]) == t {
			return i
		}
	}
	return -1
}

// inPlaceStoredLoads reports, by instruction index over blocks, each aggregate OP_LOAD
// of f's body whose one use is a whole store that may read its source in place
// (common.AGG_LOAD_IN_PLACE_OVERLAPPING) and that no fault pad names (padUsesValue):
// the load owns no frame region and carries its source's address, and its store copies
// as memmove does (BC_MEMMOVE).  A region would cost the aggregate's size in VM stack,
// which a large one overflows.  Computed before the lowering renumbers the IDs, which
// the elision analysis reads.
func inPlaceStoredLoads(f @ir.Func, blocks @[]@ir.Block) @[]bool {
	var n int = 0
	for i := 0; i < len(blocks); i++ { n = n + len(blocks[i].Instrs) }
	var out @[]bool = make_slice(bool, n)
	var elider @common.AggLoadElider
	var base int = 0
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			if instr.Op != iropcode.OP_LOAD || !isAggregateLoadTyp(instr.Typ) { continue }
			if elider == nil { elider = common.NewAggLoadElider(f) }
			out[base + j] = elider.Elision(instr) == common.AGG_LOAD_IN_PLACE_OVERLAPPING &&
					!padUsesValue(f, instr)
		}
		base = base + len(blk.Instrs)
	}
	return out
}

// padUsesValue reports whether an instruction of f's fault pads names v.  The elision
// analysis leaves the pads out (only the VM runs them), and a pad run after a fault
// would read a load read in place as its source is then, not as it was loaded.
func padUsesValue(f @ir.Func, v @ir.Instr) bool {
	for i := 0; i < len(f.FaultPads); i++ {
		var pad @ir.Block = f.FaultPads[i]
		for j := 0; j < len(pad.Instrs); j++ {
			var ins @ir.Instr = pad.Instrs[j]
			for k := 0; k < len(ins.Args); k++ {
				if ins.Args[k] == v { return true }
			}
		}
	}
	return false
}

// planFrameRegions lays out the frame regions instructions of `blocks` own —
// an alloca's, an aggregate load's (one inPlace marks owns none), a frame-lived
// closure record's, an aggregate nil's image — and returns each instruction's region
// offset (by its index over `blocks`, in order; 0 for one that owns none) and the frame
// size.  Keyed by position rather than value ID: lowering renumbers the IDs to register
// slots, which values share.
func planFrameRegions(blocks @[]@ir.Block, inPlace @[]bool) (@[]int, int) {
	var n int = 0
	for i := 0; i < len(blocks); i++ { n = n + len(blocks[i].Instrs) }
	var offs @[]int = make_slice(int, n)
	var frameOffset int = 0
	var base int = 0
	for i := 0; i < len(blocks); i++ {
		var blk @ir.Block = blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			var g int = base + j
			if instr.Op == iropcode.OP_ALLOC && instr.TypeArg != nil {
				var size int = instr.TypeArg.SizeOf()
				// Align to 8 bytes
				frameOffset = (frameOffset + 7) / 8 * 8
				offs[g] = frameOffset
				frameOffset = frameOffset + size
			} else if instr.Op == iropcode.OP_LOAD && isAggregateLoadTyp(instr.Typ) && !inPlace[g] {
				// An aggregate OP_LOAD owns its bytes: reserve a region
				// it copies into (BC_LOAD_AGGREGATE), so the loaded value
				// can't alias a source the cleanup frees first (e.g.
				// `return container[i]`).  Same shape as an alloca region.
				var lsize int = instr.Typ.SizeOf()
				frameOffset = (frameOffset + 7) / 8 * 8
				offs[g] = frameOffset
				frameOffset = frameOffset + lsize
			} else if instr.Op == iropcode.OP_FUNC_VALUE && funcValueNeedsFrameRec(instr) {
				// A raw *func capturing value's VM closure record is a frame-lived
				// borrow (funcValueNeedsFrameRec): reserve a 4-word region
				// ({kind, vm, fnIdx+1, captured}) for it here, owned by the
				// OP_FUNC_VALUE, so it is reclaimed on frame pop and never leaks.  lowerCallOp carries the
				// offset to the handler via Imm; BC_FUNC_VALUE writes the record into
				// this slot instead of rt.Alloc.  (A managed @func's record stays on the
				// heap, freed by RefDec; a non-capturing value has no record.)
				frameOffset = (frameOffset + 7) / 8 * 8
				offs[g] = frameOffset
				frameOffset = frameOffset + 4 * REG_SLOT
			} else if instr.Op == iropcode.OP_CONST_NIL && isAggregateLoadTyp(instr.Typ) {
				// An aggregate nil is an address-aggregate: the VM carries
				// a slice / struct / iface- / func-value by the address of
				// its in-memory image, not as an immediate.  Reserve a
				// dedicated region for the nil image — zeroed at frame entry
				// by pushFrame and never written — so the value's register
				// points at a valid {0, ...} image.  Without it the scalar-0
				// fallback (BC_LOAD_IMM) yields a null address, and any
				// by-address consumer (a call argument, an OP_EXTRACT such as
				// len()) reads through null.  Mirrors the native "dedicated
				// data region" and the LLVM alloca + zero-fill for aggregate
				// OP_CONST_NIL.
				var nsize int = instr.Typ.SizeOf()
				frameOffset = (frameOffset + 7) / 8 * 8
				offs[g] = frameOffset
				frameOffset = frameOffset + nsize
			}
		}
		base = base + len(blk.Instrs)
	}
	return offs, frameOffset
}
