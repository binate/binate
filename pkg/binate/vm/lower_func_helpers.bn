package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/iropcode"

// Per-function lowering helpers, split out of lower_func.bn so that
// file stays under the soft length cap.  Instruction counting
// (findMaxCallArgs / findMaxGlobalsPerInstr — sizing the call-arg and
// global-address register regions), phi-copy insertion (insertPhiCopies
// / insertPhiCopiesForSucc), and block-offset lookup (findBlockOffset).
// lowerFunc and captureNeedsPtrPass stay in lower_func.bn.

// insertPhiCopies inserts MOV instructions for phi nodes in
// successor blocks.
func insertPhiCopies(f @ir.Func, code @[]BCInstr, codeIdx int,
	curBlock @ir.Block, terminator @ir.Instr) int {
	// Find successor blocks
	if terminator.Block1 != nil {
		codeIdx = insertPhiCopiesForSucc(f, code, codeIdx, curBlock, terminator.Block1)
	}
	if terminator.Block2 != nil {
		codeIdx = insertPhiCopiesForSucc(f, code, codeIdx, curBlock, terminator.Block2)
	}
	return codeIdx
}

// insertPhiCopiesForSucc emits MOV for each phi in succBlock
// that has curBlock as predecessor.
func insertPhiCopiesForSucc(f @ir.Func, code @[]BCInstr,
	codeIdx int, curBlock @ir.Block,
	succBlock @ir.Block) int {
	for i := 0; i < len(succBlock.Instrs); i++ {
		var instr @ir.Instr = succBlock.Instrs[i]
		if instr.Op != iropcode.OP_PHI { break }
		// Find the phi entry for curBlock
		for j := 0; j < len(instr.Phis); j++ {
			if instr.Phis[j].Block == curBlock {
				var bc BCInstr
				bc.Op = BC_MOV
				bc.Dst = instr.ID
				bc.Src1 = instr.Phis[j].Val.ID
				code[codeIdx] = bc
				codeIdx = codeIdx + 1
			}
		}
	}
	return codeIdx
}

// findMaxCallArgs returns the maximum number of register slots needed
// for the call-arg-packing region across all call/multi-return
// instructions.  A 64-bit-scalar arg packs into 2 slots on a host
// whose word is < 8 bytes (Layer 2 step 2b); on a 64-bit host this
// degenerates to the arg count.  Multi-return packing currently stays
// single-slot per result (int64 multi-return is a follow-up); sizing
// the region as 1-slot-per result is enough until that lands.
func findMaxCallArgs(f @ir.Func) int {
	var max int = 0
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			var n int = 0
			var start int = -1
			if instr.Op == iropcode.OP_CALL { start = 0 }
			if instr.Op == iropcode.OP_CALL_INDIRECT { start = 1 }
			if instr.Op == iropcode.OP_CALL_FUNC_VALUE { start = 1 }
			if instr.Op == iropcode.OP_CALL_IFACE_METHOD { start = 1 }
			if start >= 0 {
				for k := start; k < len(instr.Args); k++ {
					n = n + argSlots(instr.Args[k].Typ)
				}
			}
			if instr.Op == iropcode.OP_RETURN &&
				len(instr.Args) > 1 {
				// Multi-return packs results into the same
				// region, pair-aware (Layer 2 step 2b).
				for k := 0; k < len(instr.Args); k++ {
					n = n + argSlots(instr.Args[k].Typ)
				}
			}
			if n > max { max = n }
		}
	}
	return max
}

// findMaxGlobalsPerInstr returns the largest number of distinct
// global-address args carried by any single instruction — IsGlobalRef
// args (set by lookupVar's global fallback) that resolve to a
// materialized global.  lowerFunc reserves this many global-address
// registers so an instruction with several global args (e.g.
// `return &G, &H` or `&G == &H`) gives each its own register; one
// shared register would have the later LOAD_IMMs clobber the earlier
// addresses before the instruction reads them.  Matches the condition
// the emit pass uses, so reservation and use agree.
func findMaxGlobalsPerInstr(vm @VM, f @ir.Func) int {
	var max int = 0
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			var n int = 0
			for k := 0; k < len(instr.Args); k++ {
				if instr.Args[k] != nil &&
					instr.Args[k].IsGlobalRef &&
					lookupGlobalAddr(vm, instr.Args[k].StrVal) != 0 {
					n = n + 1
				}
			}
			if n > max { max = n }
		}
	}
	return max
}

// findBlockOffset returns the bytecode index for a target block.
func findBlockOffset(f @ir.Func, target @ir.Block,
	blockOffsets *[]int) int {
	for i := 0; i < len(f.Blocks); i++ {
		if f.Blocks[i] == target {
			return blockOffsets[i]
		}
	}
	return 0
}
