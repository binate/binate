package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for lower_func_helpers.bn — the per-function lowering helpers
// (instruction counting, phi-copy insertion, block-offset lookup),
// exercised through lowerFromSource: the shared-instr block-offset
// agreement (first-pass count vs third-pass emit), distinct
// global-address registers for multiple globals in one instruction, and
// the size of the call-arg packing region.

// TestLowerGlobalRefSharedAcrossUses: IR generation may share a
// single pseudo-global-ref @Instr across a load-old-then-store-new
// sequence (e.g. `g = make_slice(...)` which loads the old value to
// RefDec its backing, then stores the new value).  The VM's first
// pass must count BC_LOAD_IMMs the way the third pass emits them: a
// first pass that counts one per occurrence while the third pass
// deduplicates on the shared @Instr's already-patched ID computes
// block offsets that disagree with the actual ones, so JUMP/BRANCH
// targets point one past where they should.
//
// Every JUMP target must land on the first instruction of its block,
// not one past it.
// Concretely: the loop's post-block back-jump must target a
// BC_LOAD64 (loading the loop variable), not the subsequent
// BC_LOAD_IMM that loads the constant 3.
func TestLowerGlobalRefSharedAcrossUses() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "var gBuf @[]uint8\n")
	src = concatStr(src, "func setup() {\n")
	src = concatStr(src, "  gBuf = make_slice(uint8, 5)\n")
	src = concatStr(src, "  for i := 0; i < 3; i++ {}\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var setupIdx int = -1
	for i := 0; i < vm.Funcs.Len(); i++ {
		if streq(vm.Funcs.Get(i).Name, "test.setup") { setupIdx = i }
	}
	if setupIdx < 0 { return "test.setup not found" }
	var code @[]BCInstr = vm.Funcs.Get(setupIdx).Code
	// Find the back-edge JUMP (the one whose Aux points to an
	// earlier pc — that's the post-increment → cond edge).
	var backEdgeTarget int = -1
	for i := 0; i < len(code); i++ {
		if code[i].Op == BC_JUMP && code[i].Aux < i {
			backEdgeTarget = code[i].Aux
		}
	}
	if backEdgeTarget < 0 {
		return "no back-edge JUMP found"
	}
	// The back-edge lands on cond block's first instruction, which
	// loads the loop variable from its stack slot.  On a 64-bit host
	// `int` is 8 bytes → BC_LOAD64; on a 32-bit host the sub-word
	// path emits BC_LOAD8 with Imm = byte count.
	var expected int = BC_LOAD64
	if cast(int, sizeof(int)) < 8 { expected = BC_LOAD8 }
	if code[backEdgeTarget].Op != expected {
		return "back-edge target is not the expected int-load op (off-by-one)"
	}
	return ""
}

// TestLowerGlobalRefMultiplePerInstr guards two distinct global
// addresses as args to ONE instruction (`return &gA, &gB`).  The VM
// materializes each IsGlobalRef arg with its own BC_LOAD_IMM, and each
// must load into a DISTINCT register: with a single shared globalReg,
// the second LOAD_IMM clobbers the first and both args read the last
// address.
func TestLowerGlobalRefMultiplePerInstr() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "var gA int = 1\n")
	src = concatStr(src, "var gB int = 2\n")
	src = concatStr(src, "func pair() (*int, *int) { return &gA, &gB }\n")
	var vm @VM = lowerFromSource(src)
	var idx int = -1
	for i := 0; i < vm.Funcs.Len(); i++ {
		if streq(vm.Funcs.Get(i).Name, "test.pair") { idx = i }
	}
	if idx < 0 { return "test.pair not found" }
	var code @[]BCInstr = vm.Funcs.Get(idx).Code
	// pair() loads no constants, so the only BC_LOAD_IMMs are the two
	// global addresses; capture the first two destination registers.
	var loads int = 0
	var first int = -1
	var second int = -1
	for i := 0; i < len(code); i++ {
		if code[i].Op == BC_LOAD_IMM {
			if loads == 0 { first = code[i].Dst }
			if loads == 1 { second = code[i].Dst }
			loads = loads + 1
		}
	}
	if loads < 2 {
		return "expected two BC_LOAD_IMM for the two global addresses"
	}
	if first == second {
		return "two global addresses in one instruction share a register (clobber)"
	}
	return ""
}

// TestFindMaxCallArgsCountsCallHandle: an OP_CALL_HANDLE packs its Args[1..]
// at callArgBase like the other indirect calls, so the call-arg region must
// hold them.  A region sized without it would have the pack MOVs of a function
// whose only arg-carrying call is a call-handle op write the global-address
// registers that follow the region, or past the registers altogether.
func TestFindMaxCallArgsCountsCallHandle() testing.TestResult {
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("test", "f", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var h @ir.Instr = irbuild.EmitFuncHandle(b, "g")
	var wideArg @ir.Instr = irbuild.EmitConstInt64(b, cast(int64, 7), types.TypInt64())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 2)
	args[0] = h
	args[1] = wideArg
	irbuild.EmitCallHandle(b, h, args, types.TypVoid())
	var noVals @[]@ir.Instr
	irbuild.EmitReturn(b, noVals)
	var want int = 1 + argSlots(types.TypInt64())
	if findMaxCallArgs(newTestVM(testVMStackSize), f) != want {
		return "the call-arg region must hold a call-handle op's packed args"
	}
	return ""
}

// A load stored whole is read in place (inPlaceStoredLoads) unless a fault pad names it:
// the elision analysis leaves the pads out, and a pad run after a fault would read the
// source as it is then.
func TestInPlaceStoredLoadsSkipsPadUses() testing.TestResult {
	for pass := 0; pass < 2; pass++ {
		var t @types.Type = types.MakeArrayType(types.TypUint8(), 64)
		var noParams @[]@ir.Param
		var noResults @[]@types.Type
		var noRets @[]@ir.Instr
		var f @ir.Func = ir.NewFunc("", "t", noParams, noResults)
		var e @ir.Block = ir.AddBlock(f, "entry")
		var p @ir.Instr = irbuild.EmitAlloc(e, types.MakePointerType(t))
		var v @ir.Instr = irbuild.EmitLoad(e, irbuild.EmitLoad(e, p, types.MakePointerType(t)), t)
		var dst @ir.Instr = irbuild.EmitAlloc(e, t)
		irbuild.EmitStore(e, dst, v)
		irbuild.EmitReturn(e, noRets)
		if pass == 1 {
			var pad @ir.Block = ir.AddFaultPad(f, "pad")
			var other @ir.Instr = irbuild.EmitAlloc(pad, t)
			irbuild.EmitStore(pad, other, v)
			irbuild.EmitReturn(pad, noRets)
		}
		var inPlace @[]bool = inPlaceStoredLoads(f, combinedBlocks(f))
		var at int = -1
		for j := 0; j < len(e.Instrs); j++ {
			if e.Instrs[j] == v { at = j }
		}
		if at < 0 { return "the load is not in the entry block" }
		if pass == 0 && !inPlace[at] { return "a load stored whole is read in place" }
		if pass == 1 && inPlace[at] { return "a load a fault pad names keeps its copy" }
	}
	return ""
}
