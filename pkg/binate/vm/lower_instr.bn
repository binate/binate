package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/rt"

// applySubWordNarrow records a sub-word re-narrow on bc for a host-width
// integer result of type t: bc.Imm = result width in bits (0 = none, e.g. a
// host-word or non-integer result), bc.Aux = 1 when signed.  The exec applies
// it after the op so a uint8/16/32 (or int8/16/32) result never carries dirty
// upper bits into a later shift, unsigned compare, division, or widening read.
func applySubWordNarrow(bc BCInstr, t @types.Type) BCInstr {
	var nw int
	var sgn bool
	nw, sgn = common.SubWordNarrow(t, REG_SLOT * 8)
	if nw > 0 {
		bc.Imm = nw
		if sgn { bc.Aux = 1 }
	}
	return bc
}

// lowerInstr converts one IR instruction to one bytecode instruction.
func lowerInstr(vm @VM, instr @ir.Instr, allocaOffsets *[]int,
	blockOffsets *[]int, f @ir.Func,
	callArgBase int) BCInstr {
	var bc BCInstr
	bc.Dst = instr.ID

	// Constants
	if instr.Op == iropcode.OP_CONST_INT {
		// 64-bit-scalar constants on a host whose word is < 8 bytes
		// land in a register pair (Layer 2): emit BC_LOAD_IMM64 with
		// the value split into low/high 32-bit halves carried in
		// Imm/Aux.  On a 64-bit host the value fits one slot, so use
		// the existing BC_LOAD_IMM (cast lossless: int == int64).
		if is64BitScalar(instr.Typ) && REG_SLOT < 8 {
			bc.Op = BC_LOAD_IMM64
			bc.Imm, bc.Aux = splitInt64(instr.IntVal)
			return bc
		}
		bc.Op = BC_LOAD_IMM
		bc.Imm = cast(int, instr.IntVal)
		return bc
	}
	if instr.Op == iropcode.OP_CONST_BOOL {
		bc.Op = BC_LOAD_IMM
		if instr.BoolVal { bc.Imm = 1 } else { bc.Imm = 0 }
		return bc
	}
	if instr.Op == iropcode.OP_CONST_NIL {
		// An aggregate nil (slice / struct / iface- / func-value) is
		// carried by the address of a zeroed image, like any aggregate
		// value in the VM — point at the region the planner reserved
		// (zeroed at frame entry, never written).  A scalar nil (pointer /
		// managed pointer) is the immediate 0.  Emitting the scalar 0 for
		// an aggregate would hand a null address to a by-address consumer
		// (a call argument, an OP_EXTRACT such as len()) → null deref.
		if isAggregateLoadTyp(instr.Typ) {
			bc.Op = BC_STACK_ALLOC
			bc.Imm = allocaOffsets[instr.ID]
			return bc
		}
		bc.Op = BC_LOAD_IMM
		bc.Imm = 0
		return bc
	}
	if instr.Op == iropcode.OP_CONST_STRING {
		bc.Op = BC_LOAD_STR
		bc.Imm = ir.FindStringID(vm.curStrings, instr.StrVal)
		return bc
	}
	if instr.Op == iropcode.OP_CONST_FLOAT {
		// Float bits ride int64 so the bit_cast is 64↔64 on every
		// host (`bit_cast(int, float64)` would size-mismatch on a
		// 32-bit host).  When the constant is float64-typed AND the
		// host word is < 8 bytes, the value occupies a register pair
		// — emit BC_LOAD_IMM64 with the bits split low/high.
		// Otherwise (64-bit host, OR a non-float64 constant whose
		// downstream consumer narrows via BC_F64_TO_F32) keep one
		// slot via BC_LOAD_IMM.
		// A float32-typed constant carries its narrowed single-precision
		// value: round the f64 literal pattern to float32 (ties-to-even),
		// not the low 32 bits of the double pattern.  bit_cast(int32, C)
		// then observes the true float32 representation.  (An untyped
		// float literal stays float64-wide and takes the path below.)
		var ct @types.Type = vmUnwrapNamed(instr.Typ)
		if ct != nil && ct.Kind == types.TYP_FLOAT &&
			ct.Width == 32 {
			var f32 uint32 = common.F64BitsToF32Bits(
				common.ParseFloatLitToBits(instr.StrVal))
			bc.Op = BC_LOAD_IMM
			bc.Imm = cast(int, f32)
			return bc
		}
		// Reinterpret the shared text→bits result (a uint64 IEEE pattern)
		// as int64 so the bit_cast/load stays 64↔64 on every host.  Using
		// the same parser as the native backends keeps the float-constant
		// value identical across all execution modes.
		var bits int64 = cast(int64, common.ParseFloatLitToBits(instr.StrVal))
		if is64BitScalar(instr.Typ) && REG_SLOT < 8 {
			bc.Op = BC_LOAD_IMM64
			bc.Imm, bc.Aux = splitInt64(bits)
			return bc
		}
		bc.Op = BC_LOAD_IMM
		bc.Imm = cast(int, bits)
		return bc
	}

	// Arithmetic — binary ops: Dst = Src1 op Src2
	if instr.Op == iropcode.OP_ADD || instr.Op == iropcode.OP_SUB ||
		instr.Op == iropcode.OP_MUL || instr.Op == iropcode.OP_DIV ||
		instr.Op == iropcode.OP_REM || instr.Op == iropcode.OP_AND ||
		instr.Op == iropcode.OP_OR || instr.Op == iropcode.OP_XOR ||
		instr.Op == iropcode.OP_SHL || instr.Op == iropcode.OP_SHR {
		bc.Op = lowerBinOp(instr)
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return applySubWordNarrow(bc, instr.Typ)
	}

	// Comparison — binary ops: Dst = Src1 cmp Src2
	if instr.Op == iropcode.OP_EQ || instr.Op == iropcode.OP_NE ||
		instr.Op == iropcode.OP_LT || instr.Op == iropcode.OP_LE ||
		instr.Op == iropcode.OP_GT || instr.Op == iropcode.OP_GE {
		bc.Op = lowerCmpOp(instr)
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}

	// Unary
	if instr.Op == iropcode.OP_NEG {
		// Peel TYP_NAMED so a named float32 negate flips the f32 sign
		// bit (a bare TYP_NAMED has Width 0, which would pick the
		// float64 FNEG).
		var nt @types.Type = vmUnwrapNamed(instr.Typ)
		var nIsFloat bool = nt != nil && nt.IsFloat()
		var nIsFloat32 bool = nIsFloat && nt.Width == 32
		var nIsPair bool = is64BitScalar(nt) && REG_SLOT < 8
		if nIsFloat32 {
			// float32 negate flips bit 31; a float64 FNEG would flip
			// bit 63 and leave the f32 sign untouched.
			bc.Op = BC_F32NEG
		} else if nIsFloat && nIsPair {
			bc.Op = BC_FNEG64
		} else if nIsFloat {
			bc.Op = BC_FNEG
		} else if nIsPair {
			bc.Op = BC_NEG64
		} else {
			bc.Op = BC_NEG
		}
		bc.Src1 = instr.Args[0].ID
		// BC_NEG runs at host width; narrow a sub-word result.  The float
		// negates and BC_NEG64 are non-integer / full-width, so the narrow is
		// a no-op for them.
		return applySubWordNarrow(bc, instr.Typ)
	}
	if instr.Op == iropcode.OP_NOT {
		bc.Op = BC_NOT
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == iropcode.OP_BITNOT {
		if is64BitScalar(instr.Typ) && REG_SLOT < 8 {
			bc.Op = BC_BITNOT64
		} else {
			bc.Op = BC_BITNOT
		}
		bc.Src1 = instr.Args[0].ID
		// BC_BITNOT runs at host width; narrow a sub-word result (BC_BITNOT64
		// is full-width and needs none).
		return applySubWordNarrow(bc, instr.Typ)
	}

	// Logical AND/OR (non-short-circuit in this context)
	if instr.Op == iropcode.OP_LAND {
		bc.Op = BC_AND
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}
	if instr.Op == iropcode.OP_LOR {
		bc.Op = BC_OR
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}

	// --- Memory ---

	if instr.Op == iropcode.OP_ALLOC {
		bc.Op = BC_STACK_ALLOC
		bc.Imm = allocaOffsets[instr.ID]
		return bc
	}
	if instr.Op == iropcode.OP_LOAD {
		return lowerLoad(instr, bc, allocaOffsets)
	}
	if instr.Op == iropcode.OP_STORE {
		return lowerStore(instr, bc)
	}
	if instr.Op == iropcode.OP_GET_FIELD_PTR {
		return lowerGetFieldPtr(instr, bc)
	}
	if instr.Op == iropcode.OP_GET_ELEM_PTR {
		bc.Op = BC_ELEM_PTR
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		if instr.Typ != nil && instr.Typ.Elem != nil {
			bc.Imm = instr.Typ.Elem.SizeOf()
		} else {
			bc.Imm = 8
		}
		return bc
	}

	// --- Control flow ---

	if instr.Op == iropcode.OP_JUMP {
		bc.Op = BC_JUMP
		bc.Dst = -1
		bc.Aux = findBlockOffset(
			f, instr.Block1, blockOffsets)
		return bc
	}
	if instr.Op == iropcode.OP_BRANCH {
		bc.Op = BC_BRANCH
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		bc.Imm = findBlockOffset(
			f, instr.Block1, blockOffsets)
		bc.Aux = findBlockOffset(
			f, instr.Block2, blockOffsets)
		return bc
	}
	if instr.Op == iropcode.OP_RETURN {
		return lowerReturn(instr, bc, callArgBase)
	}

	// --- Managed memory ---

	if instr.Op == iropcode.OP_REFINC {
		// Fused inline-RefInc bytecode: one dispatch handles the
		// nil-check + header load/add/store. Single dispatch is
		// the dominant VM win over lowering to ~5 primitive ops.
		bc.Op = BC_REFINC_INLINE
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == iropcode.OP_REFDEC {
		// Fused inline-RefDec bytecode: one dispatch handles the
		// nil-check, header load/sub/store, and zero-check; only
		// reaches the slow path (Free or iterative dtor dispatch)
		// when refcount hits zero.
		bc.Op = BC_REFDEC_INLINE_FAST
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = -1  // -1 means null dtor
		if len(instr.Args) > 1 {
			bc.Src2 = instr.Args[1].ID
		}
		return bc
	}
	if instr.Op == iropcode.OP_BOX {
		return lowerBox(instr, bc)
	}
	if instr.Op == iropcode.OP_MAKE {
		bc.Op = BC_ALLOC
		if instr.TypeArg != nil {
			bc.Imm = instr.TypeArg.SizeOf()
		} else {
			bc.Imm = 8
		}
		return bc
	}
	if instr.Op == iropcode.OP_MAKE_SLICE {
		bc.Op = BC_MAKE_SLICE
		bc.Src1 = instr.Args[0].ID
		if instr.TypeArg != nil {
			bc.Imm = instr.TypeArg.SizeOf()
		} else {
			bc.Imm = 8
		}
		return bc
	}
	if instr.Op == iropcode.OP_DEREF {
		bc.Op = BC_LOAD64
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == iropcode.OP_NIL_CHECK {
		bc.Op = BC_NIL_CHECK
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == iropcode.OP_BOUNDS_CHECK {
		bc.Op = BC_BOUNDS_CHECK
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}
	if instr.Op == iropcode.OP_DIV_CHECK {
		bc.Op = BC_DIV_CHECK
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		bc.Imm = cast(int, instr.IntVal)  // operand bit width
		bc.Aux = 0
		if instr.BoolVal { bc.Aux = 1 }
		return bc
	}
	if instr.Op == iropcode.OP_SHIFT_CHECK {
		bc.Op = BC_SHIFT_CHECK
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID  // 64-bit sign-extended shift count
		return bc
	}

	// --- Conversions ---

	if instr.Op == iropcode.OP_CAST {
		return lowerCast(instr, bc)
	}
	if instr.Op == iropcode.OP_BIT_CAST {
		// int64 ↔ float64 bitcast occupies a register pair on a
		// host whose word is < 8 bytes; reinterpret = MOV pair.
		// (BIT_CAST is same-width, so checking the src suffices.)
		var srcTyp @types.Type = instr.Args[0].Typ
		if is64BitScalar(srcTyp) && REG_SLOT < 8 {
			bc.Op = BC_MOV64
		} else {
			bc.Op = BC_MOV
		}
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == iropcode.OP_MANAGED_TO_RAW {
		bc.Op = BC_MOV
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == iropcode.OP_RODATA_ARRAY {
		// Phase 3.2b: copy bytes into a fresh stack buffer of size N
		// (the destination array length), zero-padded. Returns a
		// pointer to the buffer; the subsequent OP_STORE on the array
		// alloca memcpys the bytes into place.
		bc.Op = BC_STRING_COPY_ARR
		bc.Imm = ir.FindStringID(vm.curStrings, instr.StrVal)
		var arrLen int = 0
		var at @types.Type = vmUnwrapNamed(instr.Typ)
		if at != nil && at.Kind == types.TYP_ARRAY {
			arrLen = at.ArrayLen
		}
		bc.Aux = arrLen
		return bc
	}

	// Phase 3: rodata composite-literal ops. Both produce a slice
	// header pointing into rodata. Reuse BC_LOAD_STR — the VM's
	// %BnManagedSlice prefix `{data, len, ...}` is also valid as
	// a 2-word `*[]readonly T` (consumer reads only fields 0 and 1).
	if instr.Op == iropcode.OP_RODATA_MSLICE ||
			instr.Op == iropcode.OP_RODATA_SLICE {
		bc.Op = BC_LOAD_STR
		bc.Imm = ir.FindStringID(vm.curStrings, instr.StrVal)
		bc.Aux = 1 // load header pointer (data + len + ...)
		return bc
	}
	if instr.Op == iropcode.OP_RODATA_MSLICE_COPY {
		bc.Op = BC_STRING_COPY_MS
		bc.Imm = ir.FindStringID(vm.curStrings, instr.StrVal)
		return bc
	}

	// --- Struct/Extract ---

	if instr.Op == iropcode.OP_EXTRACT {
		bc.Op = BC_EXTRACT
		bc.Src1 = instr.Args[0].ID
		var srcTyp @types.Type = instr.Args[0].Typ
		if srcTyp != nil {
			srcTyp = resolveToStruct(srcTyp)
		}
		if srcTyp != nil &&
			srcTyp.Kind == types.TYP_STRUCT {
			// Anonymous multi-return struct or named struct.
			// Use byte offset and detect multi-word fields.
			bc.Imm = srcTyp.FieldOffset(instr.Index)
			if instr.Index < len(srcTyp.Fields) {
				var ft @types.Type =
					srcTyp.Fields[instr.Index].Type
				// Interface- and function-value fields are 16-byte
				// address-based aggregates too: extract them in pointer
				// mode so the result is the address of the field's slot
				// — matching how packMultiReturn writes a multi-return
				// component and how such a value is otherwise carried
				// (its register holds the slot address).  See
				// isVMAddressAggregate.
				if isMultiWordField(ft) ||
						isVMAddressAggregate(ft) {
					bc.Aux = 1 // pointer mode
				}
			}
		} else {
			// Legacy: word-indexed (managed-slice fields)
			bc.Imm = instr.Index
			bc.Aux = 2
		}
		return bc
	}
	// Function-value, interface, and call ops lower in lowerCallOp
	// (lower_call.bn) — the indirect-dispatch and call family.
	var callBc BCInstr
	var callOk bool
	callBc, callOk = lowerCallOp(vm, instr, bc, callArgBase)
	if callOk { return callBc }

	if instr.Op == iropcode.OP_STRUCT_LIT {
		bc.Op = BC_NOP
		bc.Dst = -1
		return bc
	}
	if instr.Op == iropcode.OP_UNREACHABLE {
		bc.Op = BC_NOP
		bc.Dst = -1
		return bc
	}
	if instr.Op == iropcode.OP_SP_RESTORE {
		// Statement-end marker — execLoop's BC_SP_RESTORE handler
		// resets vm.SP back to the function's frame end, reclaiming
		// any aggregate temporaries pushed during the just-ended
		// statement. No operands.
		bc.Op = BC_SP_RESTORE
		bc.Dst = -1
		return bc
	}

	// Default: unhandled IR op.  Loud-fail rather than silently
	// emitting BC_NOP — the prior NOP fallback masked real
	// miscompiles (see the OP_FUNC_VALUE_DTOR fix one commit back:
	// the missing arm silently lowered to NOP and the downstream
	// RefDec read its dtor reg from a stale slot).  Surfacing
	// unhandled ops at load time forces every new OP_* to either
	// land a lowering or get an explicit decision.
	print("vm/lower: unhandled IR opcode ")
	print(iropcode.OpName(instr.Op))
	print(" (op=")
	print(instr.Op)
	println(")")
	rt.Exit(1)
	return bc
}
