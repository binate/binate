package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/builtins/rt"

// lowerInstr converts one IR instruction to one bytecode instruction.
func lowerInstr(instr @ir.Instr, allocaOffsets *[]int,
	blockOffsets *[]int, f @ir.Func,
	callArgBase int) BCInstr {
	var bc BCInstr
	bc.Dst = instr.ID

	// Constants
	if instr.Op == ir.OP_CONST_INT {
		// 64-bit-scalar constants on a host whose word is < 8 bytes
		// land in a register pair (Layer 2): emit BC_LOAD_IMM64 with
		// the value split into low/high 32-bit halves carried in
		// Imm/Aux.  On a 64-bit host the value fits one slot, so use
		// the existing BC_LOAD_IMM (cast lossless: int == int64).
		if is64BitScalar(instr.Typ) && REG_SLOT < 8 {
			bc.Op = BC_LOAD_IMM64
			bc.Imm, bc.Aux = splitInt64(instr.IntVal)
			return bc
		}
		bc.Op = BC_LOAD_IMM
		bc.Imm = cast(int, instr.IntVal)
		return bc
	}
	if instr.Op == ir.OP_CONST_BOOL {
		bc.Op = BC_LOAD_IMM
		if instr.BoolVal { bc.Imm = 1 } else { bc.Imm = 0 }
		return bc
	}
	if instr.Op == ir.OP_CONST_NIL {
		bc.Op = BC_LOAD_IMM
		bc.Imm = 0
		return bc
	}
	if instr.Op == ir.OP_CONST_STRING {
		bc.Op = BC_LOAD_STR
		bc.Imm = ir.FindStringID(curStrings, instr.StrVal)
		return bc
	}
	if instr.Op == ir.OP_CONST_FLOAT {
		// Float bits ride int64 so the bit_cast is 64↔64 on every
		// host (`bit_cast(int, float64)` would size-mismatch on a
		// 32-bit host).  When the constant is float64-typed AND the
		// host word is < 8 bytes, the value occupies a register pair
		// — emit BC_LOAD_IMM64 with the bits split low/high.
		// Otherwise (64-bit host, OR a non-float64 constant whose
		// downstream consumer narrows via BC_F64_TO_F32) keep one
		// slot via BC_LOAD_IMM.
		// Reinterpret the shared text→bits result (a uint64 IEEE pattern)
		// as int64 so the bit_cast/load stays 64↔64 on every host.  Using
		// the same parser as the native backends keeps the float-constant
		// value identical across all execution modes.
		var bits int64 = cast(int64, common.ParseFloatLitToBits(instr.StrVal))
		if is64BitScalar(instr.Typ) && REG_SLOT < 8 {
			bc.Op = BC_LOAD_IMM64
			bc.Imm, bc.Aux = splitInt64(bits)
			return bc
		}
		bc.Op = BC_LOAD_IMM
		bc.Imm = cast(int, bits)
		return bc
	}

	// Arithmetic — binary ops: Dst = Src1 op Src2
	if instr.Op == ir.OP_ADD || instr.Op == ir.OP_SUB ||
		instr.Op == ir.OP_MUL || instr.Op == ir.OP_DIV ||
		instr.Op == ir.OP_REM || instr.Op == ir.OP_AND ||
		instr.Op == ir.OP_OR || instr.Op == ir.OP_XOR ||
		instr.Op == ir.OP_SHL || instr.Op == ir.OP_SHR {
		bc.Op = lowerBinOp(instr)
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}

	// Comparison — binary ops: Dst = Src1 cmp Src2
	if instr.Op == ir.OP_EQ || instr.Op == ir.OP_NE ||
		instr.Op == ir.OP_LT || instr.Op == ir.OP_LE ||
		instr.Op == ir.OP_GT || instr.Op == ir.OP_GE {
		bc.Op = lowerCmpOp(instr)
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}

	// Unary
	if instr.Op == ir.OP_NEG {
		var nIsFloat bool = instr.Typ != nil && instr.Typ.IsFloat()
		var nIsPair bool = is64BitScalar(instr.Typ) && REG_SLOT < 8
		if nIsFloat && nIsPair {
			bc.Op = BC_FNEG64
		} else if nIsFloat {
			bc.Op = BC_FNEG
		} else if nIsPair {
			bc.Op = BC_NEG64
		} else {
			bc.Op = BC_NEG
		}
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_NOT {
		bc.Op = BC_NOT
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_BITNOT {
		if is64BitScalar(instr.Typ) && REG_SLOT < 8 {
			bc.Op = BC_BITNOT64
		} else {
			bc.Op = BC_BITNOT
		}
		bc.Src1 = instr.Args[0].ID
		return bc
	}

	// Logical AND/OR (non-short-circuit in this context)
	if instr.Op == ir.OP_LAND {
		bc.Op = BC_AND
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}
	if instr.Op == ir.OP_LOR {
		bc.Op = BC_OR
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}

	// --- Memory ---

	if instr.Op == ir.OP_ALLOC {
		bc.Op = BC_STACK_ALLOC
		bc.Imm = allocaOffsets[instr.ID]
		return bc
	}
	if instr.Op == ir.OP_LOAD {
		return lowerLoad(instr, bc)
	}
	if instr.Op == ir.OP_STORE {
		return lowerStore(instr, bc)
	}
	if instr.Op == ir.OP_GET_FIELD_PTR {
		return lowerGetFieldPtr(instr, bc)
	}
	if instr.Op == ir.OP_GET_ELEM_PTR {
		bc.Op = BC_ELEM_PTR
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		if instr.Typ != nil && instr.Typ.Elem != nil {
			bc.Imm = instr.Typ.Elem.SizeOf()
		} else {
			bc.Imm = 8
		}
		return bc
	}

	// --- Control flow ---

	if instr.Op == ir.OP_JUMP {
		bc.Op = BC_JUMP
		bc.Dst = -1
		bc.Aux = findBlockOffset(
			f, instr.Block1, blockOffsets)
		return bc
	}
	if instr.Op == ir.OP_BRANCH {
		bc.Op = BC_BRANCH
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		bc.Imm = findBlockOffset(
			f, instr.Block1, blockOffsets)
		bc.Aux = findBlockOffset(
			f, instr.Block2, blockOffsets)
		return bc
	}
	if instr.Op == ir.OP_RETURN {
		return lowerReturn(instr, bc, callArgBase)
	}

	// --- Managed memory ---

	if instr.Op == ir.OP_REFINC {
		// Fused inline-RefInc bytecode: one dispatch handles the
		// nil-check + header load/add/store. Single dispatch is
		// the dominant VM win over lowering to ~5 primitive ops.
		bc.Op = BC_REFINC_INLINE
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_REFDEC {
		// Fused inline-RefDec bytecode: one dispatch handles the
		// nil-check, header load/sub/store, and zero-check; only
		// reaches the slow path (Free or iterative dtor dispatch)
		// when refcount hits zero.
		bc.Op = BC_REFDEC_INLINE_FAST
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = -1  // -1 means null dtor
		if len(instr.Args) > 1 {
			bc.Src2 = instr.Args[1].ID
		}
		return bc
	}
	if instr.Op == ir.OP_BOX {
		return lowerBox(instr, bc)
	}
	if instr.Op == ir.OP_MAKE {
		bc.Op = BC_ALLOC
		if instr.TypeArg != nil {
			bc.Imm = instr.TypeArg.SizeOf()
		} else {
			bc.Imm = 8
		}
		return bc
	}
	if instr.Op == ir.OP_MAKE_SLICE {
		bc.Op = BC_MAKE_SLICE
		bc.Src1 = instr.Args[0].ID
		if instr.TypeArg != nil {
			bc.Imm = instr.TypeArg.SizeOf()
		} else {
			bc.Imm = 8
		}
		return bc
	}
	if instr.Op == ir.OP_DEREF {
		bc.Op = BC_LOAD64
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_NIL_CHECK {
		bc.Op = BC_NIL_CHECK
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_BOUNDS_CHECK {
		bc.Op = BC_BOUNDS_CHECK
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}

	// --- Conversions ---

	if instr.Op == ir.OP_CAST {
		return lowerCast(instr, bc)
	}
	if instr.Op == ir.OP_BIT_CAST {
		// int64 ↔ float64 bitcast occupies a register pair on a
		// host whose word is < 8 bytes; reinterpret = MOV pair.
		// (BIT_CAST is same-width, so checking the src suffices.)
		var srcTyp @types.Type = instr.Args[0].Typ
		if is64BitScalar(srcTyp) && REG_SLOT < 8 {
			bc.Op = BC_MOV64
		} else {
			bc.Op = BC_MOV
		}
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_MANAGED_TO_RAW {
		bc.Op = BC_MOV
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_RODATA_ARRAY {
		// Phase 3.2b: copy bytes into a fresh stack buffer of size N
		// (the destination array length), zero-padded. Returns a
		// pointer to the buffer; the subsequent OP_STORE on the array
		// alloca memcpys the bytes into place.
		bc.Op = BC_STRING_COPY_ARR
		bc.Imm = ir.FindStringID(curStrings, instr.StrVal)
		var arrLen int = 0
		if instr.Typ != nil && instr.Typ.Kind == types.TYP_ARRAY {
			arrLen = instr.Typ.ArrayLen
		}
		bc.Aux = arrLen
		return bc
	}

	// Phase 3: rodata composite-literal ops. Both produce a slice
	// header pointing into rodata. Reuse BC_LOAD_STR — the VM's
	// %BnManagedSlice prefix `{data, len, ...}` is also valid as
	// a 2-word `*[]readonly T` (consumer reads only fields 0 and 1).
	if instr.Op == ir.OP_RODATA_MSLICE ||
			instr.Op == ir.OP_RODATA_SLICE {
		bc.Op = BC_LOAD_STR
		bc.Imm = ir.FindStringID(curStrings, instr.StrVal)
		bc.Aux = 1 // load header pointer (data + len + ...)
		return bc
	}
	if instr.Op == ir.OP_RODATA_MSLICE_COPY {
		bc.Op = BC_STRING_COPY_MS
		bc.Imm = ir.FindStringID(curStrings, instr.StrVal)
		return bc
	}

	// --- Struct/Extract ---

	if instr.Op == ir.OP_EXTRACT {
		bc.Op = BC_EXTRACT
		bc.Src1 = instr.Args[0].ID
		var srcTyp @types.Type = instr.Args[0].Typ
		if srcTyp != nil {
			srcTyp = resolveToStruct(srcTyp)
		}
		if srcTyp != nil &&
			srcTyp.Kind == types.TYP_STRUCT {
			// Anonymous multi-return struct or named struct.
			// Use byte offset and detect multi-word fields.
			bc.Imm = srcTyp.FieldOffset(instr.Index)
			if instr.Index < len(srcTyp.Fields) {
				var ft @types.Type =
					srcTyp.Fields[instr.Index].Type
				// Interface- and function-value fields are 16-byte
				// address-based aggregates too: extract them in pointer
				// mode so the result is the address of the field's slot
				// — matching how packMultiReturn writes a multi-return
				// component and how such a value is otherwise carried
				// (its register holds the slot address).  See
				// isVMAddressAggregate.
				if isMultiWordField(ft) ||
						isVMAddressAggregate(ft) {
					bc.Aux = 1 // pointer mode
				}
			}
		} else {
			// Legacy: word-indexed (managed-slice fields)
			bc.Imm = instr.Index
			bc.Aux = 2
		}
		return bc
	}
	// Function-value, interface, and call ops lower in lowerCallOp
	// (lower_call.bn) — the indirect-dispatch and call family.
	var callBc BCInstr
	var callOk bool
	callBc, callOk = lowerCallOp(instr, bc, callArgBase)
	if callOk { return callBc }

	if instr.Op == ir.OP_STRUCT_LIT {
		bc.Op = BC_NOP
		bc.Dst = -1
		return bc
	}
	if instr.Op == ir.OP_UNREACHABLE {
		bc.Op = BC_NOP
		bc.Dst = -1
		return bc
	}
	if instr.Op == ir.OP_PANIC {
		bc.Op = BC_NOP // TODO: implement panic
		bc.Dst = -1
		return bc
	}
	if instr.Op == ir.OP_SP_RESTORE {
		// Statement-end marker — execLoop's BC_SP_RESTORE handler
		// resets vm.SP back to the function's frame end, reclaiming
		// any aggregate temporaries pushed during the just-ended
		// statement. No operands.
		bc.Op = BC_SP_RESTORE
		bc.Dst = -1
		return bc
	}

	// Default: unhandled IR op.  Loud-fail rather than silently
	// emitting BC_NOP — the prior NOP fallback masked real
	// miscompiles (see the OP_FUNC_VALUE_DTOR fix one commit back:
	// the missing arm silently lowered to NOP and the downstream
	// RefDec read its dtor reg from a stale slot).  Surfacing
	// unhandled ops at load time forces every new OP_* to either
	// land a lowering or get an explicit decision.
	print("vm/lower: unhandled IR opcode ")
	print(ir.OpName(instr.Op))
	print(" (op=")
	print(instr.Op)
	println(")")
	rt.Exit(1)
	return bc
}
