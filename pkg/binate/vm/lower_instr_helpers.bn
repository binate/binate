package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/types"

// Per-op handlers and op-map helpers extracted from lower_instr.bn.
// lowerInstr in lower_instr.bn calls into these:
//
//   - lowerReturn / lowerBox: per-op lowering helpers, too complex
//     for an inline arm in lowerInstr's dispatch.
//   - lowerBinOp / lowerCmpOp: IR-op → BC-op mapping tables.
//   - isMultiWordField / resolveToStruct: struct-shape queries used
//     by lowerReturn and the OP_EXTRACT arm.

// --- Helper functions ---

// lowerReturn handles OP_RETURN for void, single, and multi-return.
//
// For single return, bc.Aux encodes the byte count to copy back if
// retVal points into the callee's stack region. Aggregate types
// (struct/array/slice/managed-slice) live in the callee's frame and
// must be copied to caller space; otherwise the BC_RETURN pop would
// leak the entire callee frame on every call (see vm.bn BC_RETURN
// for the runtime side). Scalars/pointers fit in a register; Aux=0
// signals "no copy needed".
func lowerReturn(instr @ir.Instr, bc BCInstr,
	callArgBase int) BCInstr {
	bc.Op = BC_RETURN
	if len(instr.Args) == 0 {
		bc.Dst = -1
	} else if len(instr.Args) == 1 {
		bc.Dst = 0
		bc.Src1 = instr.Args[0].ID
		var argTyp @types.Type = instr.Args[0].Typ
		// Layer 2 step 2b: a 64-bit-scalar single-return lives in a
		// register pair on a host whose word is < 8 bytes; BC_RETURN64
		// copies both slots back to the caller.
		if is64BitScalar(argTyp) && REG_SLOT < 8 {
			bc.Op = BC_RETURN64
		} else if isMultiWordField(argTyp) {
			bc.Aux = argTyp.SizeOf()
		} else if isVMAddressAggregate(argTyp) {
			// Interface and function values are 16-byte address-based
			// aggregates: the callee builds the value in its own frame,
			// so a single-value return must be copied back to caller
			// space (like a struct/slice) or its address dangles into the
			// reclaimed callee frame and the next call clobbers it.  An
			// iface then reads as nil at the consumer's dispatch
			// (520_iface_dtor_callee_sole_ref / 554); a func value
			// returned and passed straight on as an arg reads a nil
			// vtable (funcval-return-as-arg).
			bc.Aux = argTyp.SizeOf()
		}
	} else {
		bc.Dst = len(instr.Args)
		bc.Src1 = callArgBase
		bc.Imm = len(instr.Args)
	}
	return bc
}

// lowerBox handles OP_BOX with proper size resolution.
func lowerBox(instr @ir.Instr, bc BCInstr) BCInstr {
	bc.Op = BC_BOX
	bc.Src1 = instr.Args[0].ID
	// A scalar / single-word source holds its VALUE in the register, not an
	// address — so BC_BOX must box from the register SLOT's address, else it
	// dereferences the value as a pointer (e.g. box(42) reads address 42 →
	// SIGSEGV).  OP_ALLOC and aggregate sources (struct/slice/array/iface/
	// func-value) already hold an address; flag only the value-carrying case.
	if instr.Args[0].Op != ir.OP_ALLOC &&
			!isAggregateLoadTyp(instr.Args[0].Typ) {
		bc.Src2 = 1
	}
	if instr.TypeArg != nil {
		bc.Imm = instr.TypeArg.SizeOf()
	} else if instr.Typ != nil && instr.Typ.Elem != nil {
		bc.Imm = instr.Typ.Elem.SizeOf()
	} else if instr.Args[0].TypeArg != nil {
		bc.Imm = instr.Args[0].TypeArg.SizeOf()
	} else {
		bc.Imm = 8
	}
	return bc
}

// isMultiWordField returns true if a type is a multi-word value
// stored as a pointer in VM registers (struct, slice, managed-slice,
// array). Used to decide if EXTRACT should return a pointer vs load.
func isMultiWordField(t @types.Type) bool {
	if t == nil { return false }
	t = t.ResolveAlias()
	if t.Kind == types.TYP_NAMED && t.Underlying != nil {
		t = t.Underlying
	}
	if t.Kind == types.TYP_STRUCT { return true }
	if t.Kind == types.TYP_SLICE { return true }
	if t.Kind == types.TYP_MANAGED_SLICE { return true }
	if t.Kind == types.TYP_ARRAY { return true }
	return false
}

// isVMAddressAggregate reports whether t is a 16-byte address-based
// aggregate in the bytecode VM — an interface value or a function
// value — whose holding register carries the ADDRESS of the value's
// slot, not the value itself.  A multi-return component of this type
// must be packed by memcpy (like a struct), not copied as one scalar
// word: copying a single word propagates only the address and leaves
// the value's second word as stale caller-stack bytes — an iface's
// 1-based vtable index (→ out-of-range iface_dtor crash) or a func's
// data pointer (→ an invalid closure record).  Kept separate from
// isMultiWordField (structs/slices/arrays): the two feed different
// copy-back mechanics, and the single-return path in lowerReturn
// consults THIS predicate to copy an iface/func-value result back into
// stable caller space.
func isVMAddressAggregate(t @types.Type) bool {
	if t == nil { return false }
	t = t.ResolveAlias()
	if t.Kind == types.TYP_NAMED && t.Underlying != nil {
		t = t.Underlying
	}
	if t.Kind == types.TYP_INTERFACE_VALUE { return true }
	if t.Kind == types.TYP_INTERFACE_VALUE_MANAGED { return true }
	if t.Kind == types.TYP_FUNC_VALUE { return true }
	if t.Kind == types.TYP_MANAGED_FUNC_VALUE { return true }
	return false
}

// isAggregateLoadTyp reports whether an OP_LOAD of this type yields a
// multi-word aggregate the VM holds by pointer (struct / array / slice /
// managed-slice / func value / iface value).  Such a load must
// materialize its own copy (BC_LOAD_AGGREGATE, into a region the planner
// reserves) rather than alias the source: a source local is RefDec'd by
// the function's cleanup before the loaded value is consumed (e.g.
// `return container[i]`), so an alias reads freed memory.  The planner
// (region reservation) and lowerLoad (emit) must agree exactly, so both
// consult this one predicate; it matches native common.IsAggregateTyp.
func isAggregateLoadTyp(t @types.Type) bool {
	if t == nil { return false }
	t = vmUnwrapNamed(t)
	return t.Kind == types.TYP_STRUCT ||
		t.Kind == types.TYP_ARRAY ||
		t.Kind == types.TYP_MANAGED_SLICE ||
		t.Kind == types.TYP_SLICE ||
		t.Kind == types.TYP_FUNC_VALUE ||
		t.Kind == types.TYP_MANAGED_FUNC_VALUE ||
		t.Kind == types.TYP_INTERFACE_VALUE ||
		t.Kind == types.TYP_INTERFACE_VALUE_MANAGED
}

// vmUnwrapNamed peels TYP_NAMED wrappers to the underlying concrete
// type so the VM's Kind / width / signedness lowering decisions see the
// real scalar.  A named distinct scalar (`type F float32`) reaches
// lowering as a TYP_NAMED carrying its name (kept for method dispatch in
// IR-gen); its bytecode form is the underlying's.  Loops for named-over-
// named.
func vmUnwrapNamed(t @types.Type) @types.Type {
	for t != nil && t.Kind == types.TYP_NAMED && t.Underlying != nil {
		t = t.Underlying
	}
	return t
}

// resolveToStruct resolves a type through aliases, named types,
// and Underlying pointers to find the concrete struct (or slice)
// type with fields. Returns the original type if already concrete.
func resolveToStruct(t @types.Type) @types.Type {
	// Try ResolveAlias first
	t = t.ResolveAlias()
	// Resolve TYP_NAMED via Underlying
	for t != nil && t.Kind == types.TYP_NAMED {
		if t.Underlying != nil {
			t = t.Underlying
		} else if len(t.Fields) > 0 {
			// Named type has fields directly
			return t
		} else {
			break
		}
	}
	return t
}

// lowerBinOp maps an IR binary arithmetic op to a bytecode opcode.
// Floating-point operands dispatch to the BC_F* family.  Integer
// 64-bit-scalar results on a host whose word is < 8 bytes dispatch
// to the BC_*64 (register-pair) family.  Float64 results on a host
// whose word is < 8 bytes likewise dispatch to BC_F*64 (the
// float64-on-32-bit pair pattern, mirroring the int64 path) —
// see Layer 2 step 3.
func lowerBinOp(instr @ir.Instr) int {
	// Peel TYP_NAMED so a named scalar's float-ness, signedness, and
	// width come from its underlying (the .Signed / .Width fields on a
	// bare TYP_NAMED are unset, which would pick unsigned opcodes for a
	// named signed type and the float64 family for a named float32).
	var t @types.Type = vmUnwrapNamed(instr.Typ)
	var isFloat bool = t != nil && t.IsFloat()
	// Unsigned-integer DIV / REM need their own opcodes: signed
	// `/` and `%` on uint values with the high bit set give wrong
	// results (e.g. uint64Max / 7 evaluated signed is 0).
	var isUnsigned bool = t != nil &&
		t.IsInteger() && !t.Signed
	var isPairWide bool = is64BitScalar(t) && REG_SLOT < 8
	var isIntPair bool = !isFloat && isPairWide
	var isFloatPair bool = isFloat && isPairWide
	// float32 (a single 4-byte slot, never a register pair) computes at
	// single precision via the BC_F32* opcodes — a float64 op on the raw
	// f32 bit pattern would reinterpret it as a garbage double.
	var isFloat32 bool = isFloat && t.Width == 32
	if instr.Op == ir.OP_ADD {
		if isFloat32 { return BC_F32ADD }
		if isFloatPair { return BC_FADD64 }
		if isIntPair { return BC_ADD64 }
		if isFloat { return BC_FADD }
		return BC_ADD
	}
	if instr.Op == ir.OP_SUB {
		if isFloat32 { return BC_F32SUB }
		if isFloatPair { return BC_FSUB64 }
		if isIntPair { return BC_SUB64 }
		if isFloat { return BC_FSUB }
		return BC_SUB
	}
	if instr.Op == ir.OP_MUL {
		if isFloat32 { return BC_F32MUL }
		if isFloatPair { return BC_FMUL64 }
		if isIntPair { return BC_MUL64 }
		if isFloat { return BC_FMUL }
		return BC_MUL
	}
	if instr.Op == ir.OP_DIV {
		if isFloat32 { return BC_F32DIV }
		if isFloatPair { return BC_FDIV64 }
		if isIntPair {
			if isUnsigned { return BC_UDIV64 }
			return BC_DIV64
		}
		if isFloat { return BC_FDIV }
		if isUnsigned { return BC_UDIV }
		return BC_DIV
	}
	if instr.Op == ir.OP_REM {
		if isIntPair {
			if isUnsigned { return BC_UREM64 }
			return BC_REM64
		}
		if isUnsigned { return BC_UREM }
		return BC_REM
	}
	if instr.Op == ir.OP_AND {
		if isIntPair { return BC_AND64 }
		return BC_AND
	}
	if instr.Op == ir.OP_OR {
		if isIntPair { return BC_OR64 }
		return BC_OR
	}
	if instr.Op == ir.OP_XOR {
		if isIntPair { return BC_XOR64 }
		return BC_XOR
	}
	if instr.Op == ir.OP_SHL {
		if isIntPair { return BC_SHL64 }
		return BC_SHL
	}
	if instr.Op == ir.OP_SHR {
		if isIntPair {
			if isUnsigned { return BC_LSHR64 }
			return BC_SHR64
		}
		if isUnsigned { return BC_LSHR }
		return BC_SHR
	}
	return BC_NOP
}

// lowerCmpOp maps an IR comparison op to a bytecode opcode.
// Floating-point operand types dispatch to BC_F* comparison opcodes;
// unsigned-integer types dispatch to BC_U*.  When the operand is a
// 64-bit scalar on a host whose word is < 8 bytes, the value is in a
// register pair — BC_*64 / BC_F*64 read both pairs (Dst is still a
// single bool slot for the compare result).
func lowerCmpOp(instr @ir.Instr) int {
	var isFloat bool = false
	var isUnsigned bool = false
	var isPairWide bool = false
	var isFloat32 bool = false
	if len(instr.Args) > 0 && instr.Args[0].Typ != nil {
		// Peel TYP_NAMED: a named scalar compares with its underlying's
		// float-ness / signedness / width (a bare TYP_NAMED reads as
		// signed, non-float32).
		var t @types.Type = vmUnwrapNamed(instr.Args[0].Typ)
		isFloat = t.IsFloat()
		isUnsigned = t.IsInteger() && !t.Signed
		isPairWide = is64BitScalar(t) && REG_SLOT < 8
		isFloat32 = isFloat && t.Width == 32
	}
	var isIntPair bool = !isFloat && isPairWide
	var isFloatPair bool = isFloat && isPairWide
	if instr.Op == ir.OP_EQ {
		if isFloat32 { return BC_F32EQ }
		if isFloatPair { return BC_FEQ64 }
		if isIntPair { return BC_EQ64 }
		if isFloat { return BC_FEQ }
		return BC_EQ
	}
	if instr.Op == ir.OP_NE {
		if isFloat32 { return BC_F32NE }
		if isFloatPair { return BC_FNE64 }
		if isIntPair { return BC_NE64 }
		if isFloat { return BC_FNE }
		return BC_NE
	}
	if instr.Op == ir.OP_LT {
		if isFloat32 { return BC_F32LT }
		if isFloatPair { return BC_FLT64 }
		if isIntPair {
			if isUnsigned { return BC_ULT64 }
			return BC_SLT64
		}
		if isFloat { return BC_FLT }
		if isUnsigned { return BC_ULT }
		return BC_SLT
	}
	if instr.Op == ir.OP_LE {
		if isFloat32 { return BC_F32LE }
		if isFloatPair { return BC_FLE64 }
		if isIntPair {
			if isUnsigned { return BC_ULE64 }
			return BC_SLE64
		}
		if isFloat { return BC_FLE }
		if isUnsigned { return BC_ULE }
		return BC_SLE
	}
	if instr.Op == ir.OP_GT {
		if isFloat32 { return BC_F32GT }
		if isFloatPair { return BC_FGT64 }
		if isIntPair {
			if isUnsigned { return BC_UGT64 }
			return BC_SGT64
		}
		if isFloat { return BC_FGT }
		if isUnsigned { return BC_UGT }
		return BC_SGT
	}
	if instr.Op == ir.OP_GE {
		if isFloat32 { return BC_F32GE }
		if isFloatPair { return BC_FGE64 }
		if isIntPair {
			if isUnsigned { return BC_UGE64 }
			return BC_SGE64
		}
		if isFloat { return BC_FGE }
		if isUnsigned { return BC_UGE }
		return BC_SGE
	}
	return BC_NOP
}
