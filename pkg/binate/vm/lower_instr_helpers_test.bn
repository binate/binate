package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the helpers extracted from lowerInstr — direct unit
// tests of the IR-op → BC-op mapping (lowerBinOp / lowerCmpOp),
// the type-shape queries (isMultiWordField / resolveToStruct),
// and the per-op handlers (lowerReturn / lowerBox). The end-to-
// end behavior is exercised by the existing TestLowerArithOpcodes
// / TestLowerCompareOpcodes tests in lower_instr_test.bn.

// lowerBinOp on integer-typed OP_ADD picks BC_ADD; the float-typed
// flavor picks BC_FADD (or BC_FADD64 when float64 lives in a register
// pair on a host whose word is < 8 bytes).  Same dispatch shape for
// SUB/MUL/DIV.
func TestLowerBinOpIntegerVsFloat() testing.TestResult {
	var addInt @ir.Instr = make(ir.Instr)
	addInt.Op = ir.OP_ADD
	addInt.Typ = types.TypInt()
	if lowerBinOp(addInt) != BC_ADD {
		return "int OP_ADD should map to BC_ADD"
	}

	var addFloat @ir.Instr = make(ir.Instr)
	addFloat.Op = ir.OP_ADD
	addFloat.Typ = types.TypFloat64()
	var expectedFloat int = BC_FADD
	if REG_SLOT < 8 { expectedFloat = BC_FADD64 }
	if lowerBinOp(addFloat) != expectedFloat {
		return "float OP_ADD should map to BC_FADD (or BC_FADD64 on 32-bit host)"
	}
	return ""
}

// lowerBinOp's float64-pair branch (BC_FADD64 etc.) is gated on
// REG_SLOT < 8 — on the 64-bit host these tests run on, float64
// OP_ADD must still pick BC_FADD, not BC_FADD64.  Catches a
// hypothetical gate regression that would emit BC_FADD64 on a host
// whose word holds a full float64 in one slot.
func TestLowerBinOpFloatPairGate() testing.TestResult {
	if REG_SLOT < 8 {
		// 32-bit target — the pair branch IS active; skip this gate
		// test.  End-to-end coverage of the pair path comes via arm32
		// conformance once lowering emits BC_F*64 there.
		return ""
	}
	var ops @[]int = @[]int{
		ir.OP_ADD, ir.OP_SUB, ir.OP_MUL, ir.OP_DIV}
	var expected @[]int = @[]int{
		BC_FADD, BC_FSUB, BC_FMUL, BC_FDIV}
	for i := 0; i < len(ops); i++ {
		var instr @ir.Instr = make(ir.Instr)
		instr.Op = ops[i]
		instr.Typ = types.TypFloat64()
		if lowerBinOp(instr) != expected[i] {
			return "float64 binop must NOT take pair branch on 64-bit host"
		}
	}
	return ""
}

// REM / AND / OR / XOR / SHL / SHR are integer-only and don't have
// a float counterpart — lowerBinOp returns the integer opcode for
// signed types.  REM / DIV / SHR additionally dispatch to BC_U* /
// BC_LSHR for unsigned types (signed semantics on uint with the
// high bit set give wrong results — uint64Max / 7 = 0, etc.).
func TestLowerBinOpIntegerOnlyOps() testing.TestResult {
	var rem @ir.Instr = make(ir.Instr)
	rem.Op = ir.OP_REM
	rem.Typ = types.TypInt()
	if lowerBinOp(rem) != BC_REM { return "OP_REM should map to BC_REM" }

	var and @ir.Instr = make(ir.Instr)
	and.Op = ir.OP_AND
	and.Typ = types.TypInt()
	if lowerBinOp(and) != BC_AND { return "OP_AND should map to BC_AND" }
	return ""
}

// Unsigned-int OP_DIV / OP_REM / OP_SHR dispatch to BC_UDIV /
// BC_UREM / BC_LSHR.  TypUint64 specifically is a register-pair
// type on a host whose word is < 8 bytes, where the dispatch goes
// to the BC_*64 family instead.
func TestLowerBinOpUnsignedDispatch() testing.TestResult {
	var u64Div int = BC_UDIV
	var u64Rem int = BC_UREM
	var u64Shr int = BC_LSHR
	if REG_SLOT < 8 {
		u64Div = BC_UDIV64
		u64Rem = BC_UREM64
		u64Shr = BC_LSHR64
	}

	var divU @ir.Instr = make(ir.Instr)
	divU.Op = ir.OP_DIV
	divU.Typ = types.TypUint64()
	if lowerBinOp(divU) != u64Div {
		return "uint64 OP_DIV should map to BC_UDIV (or BC_UDIV64 on 32-bit host)"
	}

	var divS @ir.Instr = make(ir.Instr)
	divS.Op = ir.OP_DIV
	divS.Typ = types.TypInt()
	if lowerBinOp(divS) != BC_DIV {
		return "int OP_DIV should map to BC_DIV"
	}

	var remU @ir.Instr = make(ir.Instr)
	remU.Op = ir.OP_REM
	remU.Typ = types.TypUint64()
	if lowerBinOp(remU) != u64Rem {
		return "uint64 OP_REM should map to BC_UREM (or BC_UREM64 on 32-bit host)"
	}

	var remS @ir.Instr = make(ir.Instr)
	remS.Op = ir.OP_REM
	remS.Typ = types.TypInt()
	if lowerBinOp(remS) != BC_REM {
		return "int OP_REM should map to BC_REM"
	}

	var shrU @ir.Instr = make(ir.Instr)
	shrU.Op = ir.OP_SHR
	shrU.Typ = types.TypUint64()
	if lowerBinOp(shrU) != u64Shr {
		return "uint64 OP_SHR should map to BC_LSHR (or BC_LSHR64 on 32-bit host)"
	}

	var shrS @ir.Instr = make(ir.Instr)
	shrS.Op = ir.OP_SHR
	shrS.Typ = types.TypInt()
	if lowerBinOp(shrS) != BC_SHR {
		return "int OP_SHR should map to BC_SHR"
	}
	return ""
}

// lowerCmpOp picks BC_F* variants when the FIRST argument's type
// is float (the result type is always bool, so it can't be the
// dispatch key — the operand type is).  On a host whose word is
// < 8 bytes, 64-bit operands (TypFloat64, TypUint64) route to the
// BC_*64 pair family instead.
func TestLowerCmpOpDispatchByArgType() testing.TestResult {
	var intArg @ir.Instr = make(ir.Instr)
	intArg.Typ = types.TypInt()

	var ltInt @ir.Instr = make(ir.Instr)
	ltInt.Op = ir.OP_LT
	ltInt.Args = make_slice(@ir.Instr, 1)
	ltInt.Args[0] = intArg
	if lowerCmpOp(ltInt) != BC_SLT {
		return "int OP_LT should map to BC_SLT"
	}

	var floatArg @ir.Instr = make(ir.Instr)
	floatArg.Typ = types.TypFloat64()

	var ltFloat @ir.Instr = make(ir.Instr)
	ltFloat.Op = ir.OP_LT
	ltFloat.Args = make_slice(@ir.Instr, 1)
	ltFloat.Args[0] = floatArg
	var fltExpected int = BC_FLT
	if REG_SLOT < 8 { fltExpected = BC_FLT64 }
	if lowerCmpOp(ltFloat) != fltExpected {
		return "float64 OP_LT should map to BC_FLT (or BC_FLT64 on 32-bit host)"
	}

	// Unsigned-int operands route to BC_U*.  TypUint64 is pair-wide
	// on a 32-bit host → BC_ULT64.
	var uintArg @ir.Instr = make(ir.Instr)
	uintArg.Typ = types.TypUint64()

	var ltU @ir.Instr = make(ir.Instr)
	ltU.Op = ir.OP_LT
	ltU.Args = make_slice(@ir.Instr, 1)
	ltU.Args[0] = uintArg
	var ultExpected int = BC_ULT
	if REG_SLOT < 8 { ultExpected = BC_ULT64 }
	if lowerCmpOp(ltU) != ultExpected {
		return "uint64 OP_LT should map to BC_ULT (or BC_ULT64 on 32-bit host)"
	}
	// Float64-pair gate (mirrors TestLowerBinOpFloatPairGate above):
	// on a 64-bit host the float compare must NOT take BC_F*64.
	if REG_SLOT >= 8 {
		var ltF64 @ir.Instr = make(ir.Instr)
		ltF64.Op = ir.OP_LT
		ltF64.Args = make_slice(@ir.Instr, 1)
		ltF64.Args[0] = floatArg
		if lowerCmpOp(ltF64) != BC_FLT {
			return "float64 OP_LT must NOT take pair branch on 64-bit host"
		}
	}

	var ugeExpected int = BC_UGE
	var uleExpected int = BC_ULE
	var ugtExpected int = BC_UGT
	if REG_SLOT < 8 {
		ugeExpected = BC_UGE64
		uleExpected = BC_ULE64
		ugtExpected = BC_UGT64
	}

	var geU @ir.Instr = make(ir.Instr)
	geU.Op = ir.OP_GE
	geU.Args = make_slice(@ir.Instr, 1)
	geU.Args[0] = uintArg
	if lowerCmpOp(geU) != ugeExpected {
		return "uint64 OP_GE should map to BC_UGE (or BC_UGE64 on 32-bit host)"
	}

	// Fill out the rest of the unsigned cmp matrix so a future
	// edit can't silently drop one predicate.
	var leU @ir.Instr = make(ir.Instr)
	leU.Op = ir.OP_LE
	leU.Args = make_slice(@ir.Instr, 1)
	leU.Args[0] = uintArg
	if lowerCmpOp(leU) != uleExpected {
		return "uint64 OP_LE should map to BC_ULE (or BC_ULE64 on 32-bit host)"
	}

	var gtU @ir.Instr = make(ir.Instr)
	gtU.Op = ir.OP_GT
	gtU.Args = make_slice(@ir.Instr, 1)
	gtU.Args[0] = uintArg
	if lowerCmpOp(gtU) != ugtExpected {
		return "uint64 OP_GT should map to BC_UGT (or BC_UGT64 on 32-bit host)"
	}
	return ""
}

// isMultiWordField says yes for struct / slice / managed-slice /
// array and no for scalars. Drives whether OP_EXTRACT returns a
// pointer or a value.
func TestIsMultiWordField() testing.TestResult {
	if isMultiWordField(nil) {
		return "nil should not be multi-word"
	}
	if isMultiWordField(types.TypInt()) {
		return "int should not be multi-word"
	}
	if isMultiWordField(types.TypBool()) {
		return "bool should not be multi-word"
	}
	if !isMultiWordField(types.MakeSliceType(types.TypInt())) {
		return "*[]int should be multi-word"
	}
	if !isMultiWordField(types.MakeManagedSliceType(types.TypInt())) {
		return "@[]int should be multi-word"
	}
	if !isMultiWordField(types.MakeArrayType(types.TypInt(), 4)) {
		return "[4]int should be multi-word"
	}
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	if !isMultiWordField(types.MakeStructType("S", fields)) {
		return "struct S should be multi-word"
	}
	return ""
}

// isAggregateLoadTyp must peel every transparent wrapper (readonly / alias /
// named) before classifying — a `readonly @[]int` is carried by address like
// a bare managed-slice.  Pre-fix it peeled only TYP_NAMED (vmUnwrapNamed), so
// a readonly-wrapped managed-slice fell outside the aggregate set and was
// loaded / stored as a single scalar word, handing a by-address consumer
// (len(), a call argument) a one-word value (conformance 686).
func TestIsAggregateLoadTypPeelsTransparent() testing.TestResult {
	if isAggregateLoadTyp(nil) { return "nil should not be aggregate" }
	if isAggregateLoadTyp(types.TypInt()) { return "int is not aggregate" }
	var ms @types.Type = types.MakeManagedSliceType(types.TypInt())
	if !isAggregateLoadTyp(ms) { return "@[]int should be aggregate" }
	if !isAggregateLoadTyp(types.MakeReadonlyType(ms)) {
		return "readonly @[]int should be aggregate (peel transparent)"
	}
	if !isAggregateLoadTyp(types.MakeAliasType("MS", ms)) {
		return "alias-of-@[]int should be aggregate"
	}
	var named @types.Type = types.MakeNamedType("MSlice")
	named.Underlying = ms
	if !isAggregateLoadTyp(named) {
		return "named-over-@[]int should be aggregate"
	}
	if !isAggregateLoadTyp(types.MakeReadonlyType(named)) {
		return "readonly-over-named-over-@[]int should be aggregate"
	}
	if isAggregateLoadTyp(types.MakeReadonlyType(types.TypInt())) {
		return "readonly int is a scalar, not an aggregate"
	}
	return ""
}

// resolveToStruct unwraps named-type / alias indirection until it
// hits the concrete struct (or whatever non-named type is below).
// Plain types pass through unchanged.
func TestResolveToStructPlain() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	var st @types.Type = types.MakeStructType("S", fields)
	if resolveToStruct(st) != st {
		return "plain struct should resolve to itself"
	}
	if resolveToStruct(types.TypInt()) != types.TypInt() {
		return "int should resolve to itself"
	}
	return ""
}

// lowerBox uses TypeArg.SizeOf as the box payload size when set.
// (Other resolution paths — instr.Typ.Elem, Args[0].TypeArg,
// fallback 8 — are exercised end-to-end by the conformance suite.)
func TestLowerBoxUsesTypeArgSize() testing.TestResult {
	var boxed @ir.Instr = make(ir.Instr)
	boxed.ID = 7
	boxed.Args = make_slice(@ir.Instr, 1)
	boxed.Args[0] = make(ir.Instr)
	boxed.Args[0].ID = 3
	boxed.TypeArg = types.TypInt()
	var bc BCInstr
	bc.Dst = boxed.ID
	bc = lowerBox(boxed, bc)
	if bc.Op != BC_BOX { return "expected BC_BOX" }
	if bc.Src1 != 3 { return "expected Src1 = arg ID 3" }
	if bc.Imm != types.TypInt().SizeOf() {
		return "Imm should be sizeof(int)"
	}
	return ""
}

// A scalar (value-carrying) box source is flagged Src2 = 1 so BC_BOX boxes from
// the register SLOT's address (the register holds the value, not a pointer); an
// OP_ALLOC / aggregate source (register holds an address) is not flagged.  CR-2
// follow-up Plan A — box(scalar) used to SIGSEGV on the VM (and emit nothing on
// native) by treating the scalar value as a source pointer.
func TestLowerBoxScalarFlagsValueCarrying() testing.TestResult {
	// Scalar source (int): value-carrying -> Src2 = 1.
	var sc @ir.Instr = make(ir.Instr)
	sc.Args = make_slice(@ir.Instr, 1)
	sc.Args[0] = make(ir.Instr)
	sc.Args[0].ID = 3
	sc.Args[0].Typ = types.TypInt()
	sc.TypeArg = types.TypInt()
	var bc1 BCInstr
	bc1 = lowerBox(sc, bc1)
	if bc1.Src2 != 1 { return "scalar box source should set Src2 = 1" }

	// OP_ALLOC source: the register holds an address -> Src2 stays 0.
	var al @ir.Instr = make(ir.Instr)
	al.Args = make_slice(@ir.Instr, 1)
	al.Args[0] = make(ir.Instr)
	al.Args[0].ID = 4
	al.Args[0].Op = ir.OP_ALLOC
	al.TypeArg = types.TypInt()
	var bc2 BCInstr
	bc2 = lowerBox(al, bc2)
	if bc2.Src2 != 0 { return "OP_ALLOC box source should not set Src2" }

	// Aggregate source (raw slice): the register holds an address -> Src2 = 0.
	var ag @ir.Instr = make(ir.Instr)
	ag.Args = make_slice(@ir.Instr, 1)
	ag.Args[0] = make(ir.Instr)
	ag.Args[0].ID = 5
	ag.Args[0].Typ = types.MakeSliceType(types.TypInt())
	ag.TypeArg = ag.Args[0].Typ
	var bc3 BCInstr
	bc3 = lowerBox(ag, bc3)
	if bc3.Src2 != 0 { return "aggregate box source should not set Src2" }
	return ""
}

// lowerReturn on a void return (no Args) sets Dst = -1 and emits
// BC_RETURN — the marker the runtime uses to skip the value-
// packing path.
func TestLowerReturnVoid() testing.TestResult {
	var ret @ir.Instr = make(ir.Instr)
	ret.Op = ir.OP_RETURN
	var bc BCInstr
	bc = lowerReturn(ret, bc, 0)
	if bc.Op != BC_RETURN { return "expected BC_RETURN" }
	if bc.Dst != -1 { return "void return should have Dst = -1" }
	return ""
}

// Single-return scalar: Dst = 0, Src1 = arg ID, Aux = 0 (no copy
// needed for a scalar that fits in a register).
func TestLowerReturnSingleScalar() testing.TestResult {
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 5
	arg.Typ = types.TypInt()
	var ret @ir.Instr = make(ir.Instr)
	ret.Op = ir.OP_RETURN
	ret.Args = make_slice(@ir.Instr, 1)
	ret.Args[0] = arg
	var bc BCInstr
	bc = lowerReturn(ret, bc, 0)
	if bc.Op != BC_RETURN { return "expected BC_RETURN" }
	if bc.Dst != 0 { return "single return should have Dst = 0" }
	if bc.Src1 != 5 { return "Src1 should be arg ID 5" }
	if bc.Aux != 0 { return "scalar return should have Aux = 0 (no copy)" }
	return ""
}

// Single-return aggregate: Aux records the byte count to copy
// back when retVal points into the callee's frame. Without this,
// the BC_RETURN pop would leak the entire callee frame.
func TestLowerReturnSingleAggregate() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt()
	var st @types.Type = types.MakeStructType("S", fields)

	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 5
	arg.Typ = st
	var ret @ir.Instr = make(ir.Instr)
	ret.Op = ir.OP_RETURN
	ret.Args = make_slice(@ir.Instr, 1)
	ret.Args[0] = arg
	var bc BCInstr
	bc = lowerReturn(ret, bc, 0)
	if bc.Aux != st.SizeOf() {
		return "aggregate return should set Aux = sizeof(struct)"
	}
	return ""
}

// Single-return managed func value: a 16-byte {vtable, data} record the
// callee builds in its own frame.  Like a struct / interface value it
// must set Aux = SizeOf so BC_RETURN copies it back to stable caller
// space; otherwise the result register holds an address into the
// reclaimed callee frame and the vtable reads nil (funcval-return-as-arg).
func TestLowerReturnSingleFuncValue() testing.TestResult {
	var fv @types.Type = types.MakeManagedFuncValueType(
		make_slice(@types.Param, 0), make_slice(@types.Type, 0))
	if fv.SizeOf() != 16 {
		return "managed func value should be 16 bytes"
	}
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 7
	arg.Typ = fv
	var ret @ir.Instr = make(ir.Instr)
	ret.Op = ir.OP_RETURN
	ret.Args = make_slice(@ir.Instr, 1)
	ret.Args[0] = arg
	var bc BCInstr
	bc = lowerReturn(ret, bc, 0)
	if bc.Aux != fv.SizeOf() {
		return "func-value return should set Aux = sizeof for copy-back"
	}
	return ""
}
