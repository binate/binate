package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for instruction-level lowering (lower_instr.bn).
// Uses lowerFromSource and concatStr from lower_test.bn.

func TestLowerArithOpcodes() testing.TestResult {
	// Operands must be runtime values (params), not constants: the
	// checker folds a constant arithmetic expression to a single
	// OP_CONST_INT (genBinary's Phase-A4 fold), so a literal
	// `3 + 4 * 5 - 2` would emit no BC_ADD/BC_MUL/BC_SUB at all.
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func f(a int, b int) int {\n")
	src = concatStr(src, "  return a + b * a - b\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var hasAdd bool = false
	var hasMul bool = false
	var hasSub bool = false
	for i := 0; i < len(vm.Funcs.Get(0).Code); i++ {
		var op int = vm.Funcs.Get(0).Code[i].Op
		if op == BC_ADD { hasAdd = true }
		if op == BC_MUL { hasMul = true }
		if op == BC_SUB { hasSub = true }
	}
	if !hasAdd { return "expected BC_ADD" }
	if !hasMul { return "expected BC_MUL" }
	if !hasSub { return "expected BC_SUB" }
	return ""
}

// A non-constant signed integer divide lowers a BC_DIV_CHECK guard
// (operand width in Imm, signedness in Aux) before the BC_DIV.
func TestLowerSignedDivCheck() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func d(a int, b int) int { return a / b }\n")
	var vm @VM = lowerFromSource(src)
	var hasCheck bool = false
	var hasDiv bool = false
	var width int = 0
	var aux int = -1
	for fi := 0; fi < vm.Funcs.Len(); fi++ {
		for i := 0; i < len(vm.Funcs.Get(fi).Code); i++ {
			var ins BCInstr = vm.Funcs.Get(fi).Code[i]
			if ins.Op == BC_DIV_CHECK {
				hasCheck = true
				width = ins.Imm
				aux = ins.Aux
			}
			if ins.Op == BC_DIV { hasDiv = true }
		}
	}
	if !hasCheck { return "expected BC_DIV_CHECK" }
	if !hasDiv { return "expected BC_DIV" }
	if width <= 0 { return "BC_DIV_CHECK Imm (width) should be positive" }
	if aux != 1 { return "signed divide → Aux 1" }
	return ""
}

// An unsigned divide lowers BC_UDIV with a BC_DIV_CHECK whose Aux is 0.
func TestLowerUnsignedDivCheck() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func d(a uint32, b uint32) uint32 { return a / b }\n")
	var vm @VM = lowerFromSource(src)
	var hasCheck bool = false
	var hasUDiv bool = false
	var aux int = -1
	for fi := 0; fi < vm.Funcs.Len(); fi++ {
		for i := 0; i < len(vm.Funcs.Get(fi).Code); i++ {
			var ins BCInstr = vm.Funcs.Get(fi).Code[i]
			if ins.Op == BC_DIV_CHECK {
				hasCheck = true
				aux = ins.Aux
			}
			if ins.Op == BC_UDIV { hasUDiv = true }
		}
	}
	if !hasCheck { return "expected BC_DIV_CHECK" }
	if !hasUDiv { return "expected BC_UDIV" }
	if aux != 0 { return "unsigned divide → Aux 0" }
	return ""
}

// A non-constant SIGNED shift count lowers a BC_SHIFT_CHECK guard before
// the shift; an UNSIGNED count does not (it can't be negative).
func TestLowerSignedShiftCheck() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func s(a int, n int) int { return a << n }\n")
	var vm @VM = lowerFromSource(src)
	var hasCheck bool = false
	for fi := 0; fi < vm.Funcs.Len(); fi++ {
		for i := 0; i < len(vm.Funcs.Get(fi).Code); i++ {
			if vm.Funcs.Get(fi).Code[i].Op == BC_SHIFT_CHECK { hasCheck = true }
		}
	}
	if !hasCheck { return "expected BC_SHIFT_CHECK for a signed-count shift" }
	return ""
}

// An unsigned shift count emits no BC_SHIFT_CHECK guard.
func TestLowerNoShiftCheckForUnsignedCount() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func s(a int, n uint) int { return a << n }\n")
	var vm @VM = lowerFromSource(src)
	for fi := 0; fi < vm.Funcs.Len(); fi++ {
		for i := 0; i < len(vm.Funcs.Get(fi).Code); i++ {
			if vm.Funcs.Get(fi).Code[i].Op == BC_SHIFT_CHECK {
				return "unsigned shift count must not emit BC_SHIFT_CHECK"
			}
		}
	}
	return ""
}

func TestLowerCompareOpcodes() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x int = 5\n")
	src = concatStr(src, "  if x > 3 { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var hasCmp bool = false
	for i := 0; i < len(vm.Funcs.Get(0).Code); i++ {
		if vm.Funcs.Get(0).Code[i].Op == BC_SGT {
			hasCmp = true
		}
	}
	if !hasCmp { return "expected BC_SGT" }
	return ""
}

func TestLowerMemoryOps() testing.TestResult {
	// Check that struct field access generates FIELD_PTR
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "type P struct { X int; Y int }\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var p P\n")
	src = concatStr(src, "  p.X = 1\n")
	src = concatStr(src, "  return p.X\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var hasFieldPtr bool = false
	var hasStackAlloc bool = false
	for i := 0; i < len(vm.Funcs.Get(0).Code); i++ {
		if vm.Funcs.Get(0).Code[i].Op == BC_FIELD_PTR {
			hasFieldPtr = true
		}
		if vm.Funcs.Get(0).Code[i].Op == BC_STACK_ALLOC {
			hasStackAlloc = true
		}
	}
	if !hasStackAlloc { return "expected BC_STACK_ALLOC" }
	if !hasFieldPtr { return "expected BC_FIELD_PTR" }
	return ""
}

// TestLowerOpRefInc verifies that OP_REFINC lowers to BC_REFINC_INLINE
// (the fused single-dispatch bytecode op).
func TestLowerOpRefInc() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"test\"")
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var ptr @ir.Instr = entry.EmitConstNil(rawPtrTyp)
	entry.EmitRefInc(ptr)
	var noRetArgs @[]@ir.Instr
	entry.EmitReturn(noRetArgs)

	m.AddFunc(f)

	var vm @VM = NewVM(1024 * 1024)
	vm.LowerModule(m)

	if vm.Funcs.Len() < 1 { return "expected 1 function" }
	var hasInline bool = false
	for i := 0; i < len(vm.Funcs.Get(0).Code); i++ {
		if vm.Funcs.Get(0).Code[i].Op == BC_REFINC_INLINE { hasInline = true }
	}
	if !hasInline { return "expected BC_REFINC_INLINE" }
	return ""
}

// TestLowerOpRefDec verifies that OP_REFDEC lowers to
// BC_REFDEC_INLINE_FAST (the fused single-dispatch bytecode op).
func TestLowerOpRefDec() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"test\"")
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "main", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var ptr @ir.Instr = entry.EmitConstNil(rawPtrTyp)
	entry.EmitRefDec(ptr)
	var noRetArgs @[]@ir.Instr
	entry.EmitReturn(noRetArgs)

	m.AddFunc(f)

	var vm @VM = NewVM(1024 * 1024)
	vm.LowerModule(m)

	if vm.Funcs.Len() < 1 { return "expected 1 function" }
	var hasInline bool = false
	for i := 0; i < len(vm.Funcs.Get(0).Code); i++ {
		if vm.Funcs.Get(0).Code[i].Op == BC_REFDEC_INLINE_FAST { hasInline = true }
	}
	if !hasInline { return "expected BC_REFDEC_INLINE_FAST" }
	return ""
}

// TestExecRefIncRefDecInline drives BC_REFINC_INLINE and the
// BC_REFDEC_INLINE_FAST fast path through the VM dispatch loop.
// Builds a minimal hand-rolled IR (EmitMake → EmitRefInc → EmitRefDec
// → rt.Refcount → return) and verifies the runtime refcount is what
// the inline ops produced. Without this, BC_REFINC_INLINE / the
// fast path of BC_REFDEC_INLINE_FAST are only validated end-to-end
// by conformance — this is a focused unit-level guard.
func TestExecRefIncRefDecInline() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"test\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "main", noParams, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var p @ir.Instr = entry.EmitMake(types.TypInt()) // rc = 1
	entry.EmitRefInc(p) // rc = 2 (BC_REFINC_INLINE)
	entry.EmitRefDec(p) // rc = 1 (BC_REFDEC_INLINE_FAST fast path)

	// rt.Refcount(p) — pkg/binate/vm/vm_extern.bn dispatches by name.
	var rcArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rcArgs[0] = p
	var rc @ir.Instr = entry.EmitCall("pkg/builtins/rt.Refcount", rcArgs, types.TypInt())

	// Final RefDec to avoid the lingering refcount=1 leak — exercises
	// the slow path with no dtor (rt.Free).
	entry.EmitRefDec(p)

	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = rc
	entry.EmitReturn(retArgs)

	m.AddFunc(f)

	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var idx int = vm.LookupFunc("test.main")
	if idx < 0 { return "test.main not found" }
	var noArgs @[]int
	var result int64 = execFunc(vm, idx, noArgs)
	if result != 1 {
		return "expected refcount 1 after inc+dec; inline refcount ops misbehaved"
	}
	return ""
}

// TestLowerOpRefDecDtorViaHandle pins the post-Phase-4 wiring:
// EmitRefDecDtor(ptr, dtor) where dtor is EmitFuncHandle(name)
// lowers to a BC_REFDEC_INLINE_FAST whose Src2 register is fed by a
// BC_FUNC_HANDLE (the bytecode lowering of OP_FUNC_HANDLE).  Pre-
// Phase-4 / the stop-gap fed it from BC_FUNC_ADDR (1-based intra-vm
// idx) — flipping the wrong way would silently break cross-mode
// interop, since BC_REFDEC's slow path now derefs Src2 as a 16-byte
// `{vtable, data}` struct and idx values aren't valid pointers.
// End-to-end the kind-discriminating dispatch is exercised by every
// int-int test that allocates a managed struct with a dtor; this is
// the focused unit-level guard for the lowering wiring.
func TestLowerOpRefDecDtorViaHandle() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"test\"")
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	// Standalone target the dtor handle can reference; body is
	// empty (test doesn't execute, just inspects the lowering).
	var u8Ptr @types.Type = types.MakePointerType(types.TypUint8())
	var dtorParams @[]@ir.Param = make_slice(@ir.Param, 1)
	dtorParams[0] = make(ir.Param)
	dtorParams[0].Name = "p"
	dtorParams[0].Typ = u8Ptr
	dtorParams[0].ID = 0
	var dtorFn @ir.Func = ir.NewFunc("", "__dtor_probe", dtorParams, noResults)
	dtorFn.NextID = 1
	var dtorEntry @ir.Block = ir.AddBlock(dtorFn, "entry")
	var dtorRet @[]@ir.Instr
	dtorEntry.EmitReturn(dtorRet)
	m.AddFunc(dtorFn)

	var f @ir.Func = ir.NewFunc("", "main", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var p @ir.Instr = entry.EmitMake(types.TypUint8())
	var dtor @ir.Instr = entry.EmitFuncHandle("__dtor_probe")
	entry.EmitRefDecDtor(p, dtor)
	entry.EmitReturn(dtorRet)
	m.AddFunc(f)

	var vm @VM = NewVM(1024 * 1024)
	vm.LowerModule(m)
	var idx int = vm.LookupFunc("test.main")
	if idx < 0 { return "test.main not found" }
	var code @[]BCInstr = vm.Funcs.Get(idx).Code
	var refdecIdx int = -1
	for i := 0; i < len(code); i++ {
		if code[i].Op == BC_REFDEC_INLINE_FAST {
			refdecIdx = i
			break
		}
	}
	if refdecIdx < 0 {
		return "expected BC_REFDEC_INLINE_FAST"
	}
	if code[refdecIdx].Src2 < 0 {
		return "expected BC_REFDEC_INLINE_FAST.Src2 >= 0 (the dtor reg)"
	}
	// Walk back from the BC_REFDEC: find the most-recent producer of
	// the Src2 register and check its op.  Pre-Phase-4 stop-gap →
	// BC_FUNC_ADDR (returns an intra-vm idx).  Post-Phase-4 →
	// BC_FUNC_HANDLE (returns a handle pointer).
	var src2 int = code[refdecIdx].Src2
	var producerOp int = -1
	for i := refdecIdx - 1; i >= 0; i = i - 1 {
		if code[i].Dst == src2 {
			producerOp = code[i].Op
			break
		}
	}
	if producerOp != BC_FUNC_HANDLE {
		return "expected BC_REFDEC dtor reg fed by BC_FUNC_HANDLE (Phase 4), not BC_FUNC_ADDR"
	}
	return ""
}

// TestExecRefDecInlineSlowPath drives BC_REFDEC_INLINE_FAST's slow
// path (refcount → 0 → no-dtor → rt.Free). Allocates, immediately
// RefDecs to zero, then returns a constant. If the slow path is
// broken (wrong header offset, calling Free on a stale ptr, etc.)
// the test crashes in rt.Free or via memory corruption.
func TestExecRefDecInlineSlowPath() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"test\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "main", noParams, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var p @ir.Instr = entry.EmitMake(types.TypInt()) // rc = 1
	entry.EmitRefDec(p) // rc = 0 → slow path → rt.Free

	var fortyTwo @ir.Instr = entry.EmitConstInt(42, types.TypInt())
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = fortyTwo
	entry.EmitReturn(retArgs)

	m.AddFunc(f)

	var vm @VM = NewVM(1024 * 1024)
	vm.LowerModule(m)
	var idx int = vm.LookupFunc("test.main")
	if idx < 0 { return "test.main not found" }
	var noArgs @[]int
	var result int64 = execFunc(vm, idx, noArgs)
	if result != 42 {
		return "expected 42 — RefDec slow path (no dtor) should Free cleanly"
	}
	return ""
}

func TestLowerRefcountOps() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var p @int = make(int)\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var hasAlloc bool = false
	var hasRefDec bool = false
	for i := 0; i < len(vm.Funcs.Get(0).Code); i++ {
		if vm.Funcs.Get(0).Code[i].Op == BC_ALLOC {
			hasAlloc = true
		}
		if vm.Funcs.Get(0).Code[i].Op == BC_REFDEC_INLINE_FAST {
			hasRefDec = true
		}
	}
	if !hasAlloc { return "expected BC_ALLOC" }
	if !hasRefDec { return "expected BC_REFDEC_INLINE_FAST" }
	return ""
}

// IR's OP_SP_RESTORE lowers to BC_SP_RESTORE — a void op (no
// operands, Dst=-1) that execLoop's handler turns into
// `vm.SP = regsOff + f.NumRegs*8 + f.FrameSize`. The end-to-end
// vm.SP truncation is exercised by IR-gen (Step 5 of the vm.SP-leak
// fix) + conformance; this is the focused unit-level guard for the
// lowering arm.
func TestLowerOpSPRestore() testing.TestResult {
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "test", noParams, noResults)
	var instr @ir.Instr = make(ir.Instr)
	instr.Op = iropcode.OP_SP_RESTORE
	instr.ID = -1
	var emptyOffsets @[]int
	var vm @VM = NewVM(1024)
	var bc BCInstr = lowerInstr(vm, instr, emptyOffsets, emptyOffsets, f, 0)
	if bc.Op != BC_SP_RESTORE {
		return "expected BC_SP_RESTORE"
	}
	if bc.Dst != -1 {
		return "BC_SP_RESTORE should be void (Dst=-1)"
	}
	return ""
}

// OP_CONST_FLOAT's pair branch (BC_LOAD_IMM64 with splitInt64
// halves) is gated on is64BitScalar(instr.Typ) && REG_SLOT < 8.  On
// the 64-bit host these tests run on, a float64 constant must still
// emit BC_LOAD_IMM (single slot).  Catches a hypothetical gate
// regression that would emit BC_LOAD_IMM64 on a host whose word
// holds a full float64 in one slot — the resulting bytecode would
// then over-use a register on the 64-bit path.
func TestLowerConstFloatGateOn64BitHost() testing.TestResult {
	if REG_SLOT < 8 {
		// 32-bit target — the pair branch IS active; end-to-end
		// coverage comes via arm32 conformance.
		return ""
	}
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() float64 {\n")
	src = concatStr(src, "  return 1.5\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var sawImm bool = false
	for i := 0; i < len(vm.Funcs.Get(0).Code); i++ {
		var op int = vm.Funcs.Get(0).Code[i].Op
		if op == BC_LOAD_IMM64 {
			return "float64 const must NOT take pair branch on 64-bit host"
		}
		if op == BC_LOAD_IMM { sawImm = true }
	}
	if !sawImm {
		return "expected BC_LOAD_IMM for the float64 const"
	}
	return ""
}
