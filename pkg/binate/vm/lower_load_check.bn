package "pkg/binate/vm"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/std/containers/vec"
import "pkg/std/strconv"

// Load checking.  A package variable the code refers to needs storage — a
// lowered module's materialized global, or one a host bound
// (RegisterPackageGlobals).  A `.bni` `var` only declares its variable (§9.2
// decl.var.extern): a package with no `.bn` files defines its variables, if at
// all, in a compiled library or the host that injects it.  So a function that
// refers to one nothing defines cannot be lowered — there is nothing to point
// the reference at — and loading it fails, the VM's counterpart of a compiled
// program's undefined-symbol link error.  Only code that is lowered counts: a
// generic function's body, say, only in the instances that are emitted.

// LoadCheck returns the load errors of fs, functions of module m lowered
// together (see the .bni).
func (vm @VM) LoadCheck(m @ir.Module, fs *[]@ir.Func) @[]@[]char {
	var pkg @[]char = mangle.PkgPathFromQuoted(m.Name)
	var own @[]@[]char = moduleStorage(m, pkg)
	var errs @vec.Vec[@[]char] = vec.New[@[]char]()
	for i := 0; i < len(fs); i++ {
		if fs[i].IsExtern { continue }
		var e @[]char = undefinedGlobalError(vm, own, pkg, fs[i])
		if len(e) > 0 {
			errs.Push(e)
		}
	}
	return errs.Items()
}

// moduleStorage returns the qualified names of the globals m declares with
// storage of its own, still to be materialized — not an extern global (an
// imported variable), which is its owner's.
func moduleStorage(m @ir.Module, pkg *[]readonly char) @[]@[]char {
	var names @vec.Vec[@[]char] = vec.New[@[]char]()
	for i := 0; i < len(m.Globals); i++ {
		if !m.Globals[i].IsExtern {
			names.Push(mangle.QualifyName(pkg, m.Globals[i].Name))
		}
	}
	return names.Items()
}

// undefinedGlobalError returns the load error for the first package variable f
// refers to that nothing in the program defines — no registered storage, and
// not one of own (moduleStorage) — or an empty slice.
func undefinedGlobalError(vm @VM, own *[]@[]char, pkg *[]readonly char, f @ir.Func) @[]char {
	var none @[]char
	var e @[]char = undefinedGlobalInBlocks(vm, own, pkg, f, f.Blocks)
	if len(e) > 0 { return e }
	e = undefinedGlobalInBlocks(vm, own, pkg, f, f.FaultPads)
	if len(e) > 0 { return e }
	return none
}

// undefinedGlobalInBlocks is undefinedGlobalError over blocks, f's blocks or its
// fault pads.
func undefinedGlobalInBlocks(vm @VM, own *[]@[]char, pkg *[]readonly char, f @ir.Func,
		blocks *[]@ir.Block) @[]char {
	var none @[]char
	for b := 0; b < len(blocks); b++ {
		var instrs @[]@ir.Instr = blocks[b].Instrs
		for i := 0; i < len(instrs); i++ {
			var args @[]@ir.Instr = instrs[i].Args
			for k := 0; k < len(args); k++ {
				if args[k] == nil || !args[k].IsGlobalRef { continue }
				var qn @[]char = mangle.QualifyName(pkg, args[k].StrVal)
				if !globalRegistered(vm, qn) && !nameIn(own, qn) {
					return undefinedGlobalMsg(qn, f, instrs[i].Line)
				}
			}
		}
	}
	return none
}

// globalRegistered reports whether the VM's global registry has storage under
// the qualified name qn.
func globalRegistered(vm @VM, qn *[]readonly char) bool {
	for i := 0; i < vm.globalNames.Len(); i++ {
		if streq2(vm.globalNames.Get(i), qn) { return true }
	}
	return false
}

// nameIn reports whether names holds name.
func nameIn(names *[]@[]char, name *[]readonly char) bool {
	for i := 0; i < len(names); i++ {
		if streq2(names[i], name) { return true }
	}
	return false
}

// undefinedGlobalMsg renders the load error for a reference to qn, which nothing
// in the program defines, in function f at line (0 if unknown).
func undefinedGlobalMsg(qn *[]readonly char, f @ir.Func, line int) @[]char {
	var e @[]char = buf.Concat(buf.Concat("nothing in the program defines the package variable ", qn),
			buf.Concat(" (used by ", f.Name))
	if line > 0 {
		e = buf.Concat(buf.Concat(e, ", line "), strconv.Itoa(line))
	}
	return buf.Concat(e, ")")
}
