package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/builtins/testing"

// Tests for LoadCheck (lower_load_check.bn).  genModule is lower_test.bn's.

// noNames is an empty unavailable list.
var noNames @[]@[]char

// loadCheckSrc declares G, a function reading it, one calling that function,
// and one doing neither.
var loadCheckSrc *[]readonly char = "package \"test\"\nvar G int\n"
		"func read() int { return G }\nfunc caller() int { return read() }\n"
		"func other() int { return 1 }\n"

// externG returns loadCheckSrc's module with G marked extern — another
// package's storage, as an imported variable is — and the index of each function.
func externG() (@ir.Module, int, int, int) {
	var m @ir.Module = genModule(loadCheckSrc)
	for i := 0; i < len(m.Globals); i++ {
		if streq(m.Globals[i].Name, "G") { m.Globals[i].IsExtern = true }
	}
	var read int = -1
	var caller int = -1
	var other int = -1
	for i := 0; i < len(m.Funcs); i++ {
		if streq(m.Funcs[i].Name, "test.read") { read = i }
		if streq(m.Funcs[i].Name, "test.caller") { caller = i }
		if streq(m.Funcs[i].Name, "test.other") { other = i }
	}
	return m, read, caller, other
}

// A module's own global, still to be materialized, has storage: everything
// loads.
func TestLoadCheckOwnGlobalLoads() testing.TestResult {
	var m @ir.Module = genModule(loadCheckSrc)
	var ok @[]bool
	var errs @[]@[]char
	ok, errs = newTestVM(testVMStackSize).LoadCheck(m, m.Funcs, noNames)
	if len(errs) != 0 { return errs[0] }
	for i := 0; i < len(ok); i++ {
		if !ok[i] { return "every function should load" }
	}
	return ""
}

// A function reading a variable nothing defines does not load, and nor does one
// calling it; the error names the variable and the function.  LowerModule
// returns it and lowers nothing.
func TestLoadCheckUndefinedVariable() testing.TestResult {
	var m @ir.Module
	var read int
	var caller int
	var other int
	m, read, caller, other = externG()
	if read < 0 || caller < 0 || other < 0 { return "expected test.read, test.caller and test.other" }
	var vm @VM = newTestVM(testVMStackSize)
	var ok @[]bool
	var errs @[]@[]char
	ok, errs = vm.LoadCheck(m, m.Funcs, noNames)
	if ok[read] || ok[caller] || !ok[other] {
		return "read and caller should not load, other should"
	}
	var want *[]readonly char = "nothing in the program defines the package variable test.G "
			"(used by test.read, line 3)"
	if len(errs) != 1 || !streq(errs[0], want) {
		return "expected the one error, on test.read's reference to test.G"
	}
	var before int = vm.Funcs.Len()
	var loadErrs @[]@[]char = vm.LowerModule(m)
	if len(loadErrs) != 1 || vm.Funcs.Len() != before {
		return "LowerModule should return the error and lower nothing"
	}
	return ""
}

// Storage a host registered under the variable's qualified name counts.
func TestLoadCheckRegisteredStorage() testing.TestResult {
	var m @ir.Module
	m, _, _, _ = externG()
	var vm @VM = newTestVM(testVMStackSize)
	var cell @[]int = make_slice(int, 1)
	registerGlobalAddr(vm, "test.G", bit_cast(int, &cell[0]))
	var errs @[]@[]char
	_, errs = vm.LoadCheck(m, m.Funcs, noNames)
	if len(errs) != 0 { return errs[0] }
	return ""
}

// A function naming something the caller will not provide — here the call
// target in test.caller, as the IR writes it — cannot be lowered; the function
// named, and one naming nothing unavailable, can.
func TestLoadCheckUnavailableName() testing.TestResult {
	var m @ir.Module
	var read int
	var caller int
	var other int
	m, read, caller, other = externG()
	for i := 0; i < len(m.Globals); i++ { m.Globals[i].IsExtern = false }
	var target @[]char
	var blocks @[]@ir.Block = m.Funcs[caller].Blocks
	for b := 0; b < len(blocks); b++ {
		for i := 0; i < len(blocks[b].Instrs); i++ {
			if len(blocks[b].Instrs[i].StrVal) > 0 { target = blocks[b].Instrs[i].StrVal }
		}
	}
	if len(target) == 0 { return "expected test.caller to name its call target" }
	var unavailable @[]@[]char = make_slice(@[]char, 1)
	unavailable[0] = target
	var ok @[]bool
	var errs @[]@[]char
	ok, errs = newTestVM(testVMStackSize).LoadCheck(m, m.Funcs, unavailable)
	if len(errs) != 0 { return "naming an unavailable name is no load error of its own" }
	if ok[caller] || !ok[read] || !ok[other] {
		return "only caller, which names the unavailable target, should not load"
	}
	return ""
}
