package "pkg/binate/vm"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// mgOp builds a bare IR op (spGrowthBytes reads only .Op for the fixed-header
// ops used here — OP_MAKE_SLICE etc. — and terminators need only Block1/Block2).
func mgOp(op int) @ir.Instr {
	var instr @ir.Instr = make(ir.Instr)
	instr.Op = op
	return instr
}

func mgJump(target @ir.Block) @ir.Instr {
	var instr @ir.Instr = make(ir.Instr)
	instr.Op = iropcode.OP_JUMP
	instr.Block1 = target
	return instr
}

func mgBranch(t1 @ir.Block, t2 @ir.Block) @ir.Instr {
	var instr @ir.Instr = make(ir.Instr)
	instr.Op = iropcode.OP_BRANCH
	instr.Block1 = t1
	instr.Block2 = t2
	return instr
}

// mgSetInstrs replaces a hand-built block's instruction list (AddBlock seeds an
// empty view; the dataflow reads Instrs).
func mgSetInstrs(blk @ir.Block, instrs @[]@ir.Instr) {
	blk.Instrs = instrs
}

func mgNoParams() @[]@ir.Param {
	var p @[]@ir.Param
	return p
}

func mgNoResults() @[]@types.Type {
	var r @[]@types.Type
	return r
}

// TestMaxGrowthLinear: two single-make_slice statements, each reclaimed by its
// own SP_RESTORE, so the peak is one make_slice (4 words), not their sum.
func TestMaxGrowthLinear() testing.TestResult {
	var f @ir.Func = ir.NewFunc("test", "f", mgNoParams(), mgNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var instrs @[]@ir.Instr = make_slice(@ir.Instr, 5)
	instrs[0] = mgOp(iropcode.OP_MAKE_SLICE)
	instrs[1] = mgOp(iropcode.OP_SP_RESTORE)
	instrs[2] = mgOp(iropcode.OP_MAKE_SLICE)
	instrs[3] = mgOp(iropcode.OP_SP_RESTORE)
	instrs[4] = mgOp(iropcode.OP_RETURN)
	mgSetInstrs(entry, instrs)
	var vm @VM = newTestVM(64 * 1024)
	if computeMaxStmtTempGrowth(vm, f) != 4 * REG_SLOT {
		return "two SP_RESTORE-separated make_slices should peak at one (4 words)"
	}
	return ""
}

// TestMaxGrowthAccumulateInRegion: two make_slices in ONE region (no SP_RESTORE
// between them) accumulate to 8 words before the region's SP_RESTORE.
func TestMaxGrowthAccumulateInRegion() testing.TestResult {
	var f @ir.Func = ir.NewFunc("test", "f", mgNoParams(), mgNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var instrs @[]@ir.Instr = make_slice(@ir.Instr, 4)
	instrs[0] = mgOp(iropcode.OP_MAKE_SLICE)
	instrs[1] = mgOp(iropcode.OP_MAKE_SLICE)
	instrs[2] = mgOp(iropcode.OP_SP_RESTORE)
	instrs[3] = mgOp(iropcode.OP_RETURN)
	mgSetInstrs(entry, instrs)
	var vm @VM = newTestVM(64 * 1024)
	if computeMaxStmtTempGrowth(vm, f) != 8 * REG_SLOT {
		return "two make_slices in one region should accumulate to 8 words"
	}
	return ""
}

// TestMaxGrowthCrossBlock: a make_slice in entry and another in a successor,
// with the SP_RESTORE only in the merge block — the entry->b1->merge path
// accumulates BOTH (8 words) with no intervening reset.  A per-block max would
// wrongly report 4 words; the CFG dataflow must report 8.
func TestMaxGrowthCrossBlock() testing.TestResult {
	var f @ir.Func = ir.NewFunc("test", "f", mgNoParams(), mgNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var b1 @ir.Block = ir.AddBlock(f, "b1")
	var merge @ir.Block = ir.AddBlock(f, "merge")
	var ei @[]@ir.Instr = make_slice(@ir.Instr, 2)
	ei[0] = mgOp(iropcode.OP_MAKE_SLICE)
	ei[1] = mgBranch(b1, merge)
	mgSetInstrs(entry, ei)
	var bi @[]@ir.Instr = make_slice(@ir.Instr, 2)
	bi[0] = mgOp(iropcode.OP_MAKE_SLICE)
	bi[1] = mgJump(merge)
	mgSetInstrs(b1, bi)
	var mi @[]@ir.Instr = make_slice(@ir.Instr, 2)
	mi[0] = mgOp(iropcode.OP_SP_RESTORE)
	mi[1] = mgOp(iropcode.OP_RETURN)
	mgSetInstrs(merge, mi)
	var vm @VM = newTestVM(64 * 1024)
	if computeMaxStmtTempGrowth(vm, f) != 8 * REG_SLOT {
		return "cross-block growth (entry->b1->merge, no reset until merge) should be 8 words"
	}
	return ""
}

// TestMaxGrowthLoopResets: a loop whose header and body each grow one make_slice
// and SP_RESTORE it every iteration must NOT accumulate across iterations — the
// fixpoint converges to a single make_slice (4 words).
func TestMaxGrowthLoopResets() testing.TestResult {
	var f @ir.Func = ir.NewFunc("test", "f", mgNoParams(), mgNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var ei @[]@ir.Instr = make_slice(@ir.Instr, 1)
	ei[0] = mgJump(header)
	mgSetInstrs(entry, ei)
	var hi @[]@ir.Instr = make_slice(@ir.Instr, 3)
	hi[0] = mgOp(iropcode.OP_MAKE_SLICE)
	hi[1] = mgOp(iropcode.OP_SP_RESTORE)
	hi[2] = mgBranch(body, exit)
	mgSetInstrs(header, hi)
	var bi @[]@ir.Instr = make_slice(@ir.Instr, 3)
	bi[0] = mgOp(iropcode.OP_MAKE_SLICE)
	bi[1] = mgOp(iropcode.OP_SP_RESTORE)
	bi[2] = mgJump(header)
	mgSetInstrs(body, bi)
	var xi @[]@ir.Instr = make_slice(@ir.Instr, 1)
	xi[0] = mgOp(iropcode.OP_RETURN)
	mgSetInstrs(exit, xi)
	var vm @VM = newTestVM(64 * 1024)
	if computeMaxStmtTempGrowth(vm, f) != 4 * REG_SLOT {
		return "a loop that SP_RESTOREs each iteration must not accumulate (4 words)"
	}
	return ""
}

// TestMaxGrowthReturnImage: a struct-returning function's OP_RETURN grows vm.SP
// by the packed result image (AggregateReturnSize) — the callee-side term.
func TestMaxGrowthReturnImage() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 4)
	for i := 0; i < 4; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var st @types.Type = types.MakeStructType("R", fields)
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = st
	var want int = types.AggregateReturnSize(results)
	if want <= 0 {
		return "test setup: struct return image should be positive"
	}
	var f @ir.Func = ir.NewFunc("test", "g", mgNoParams(), results)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var instrs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	instrs[0] = mgOp(iropcode.OP_RETURN)
	mgSetInstrs(entry, instrs)
	var vm @VM = newTestVM(64 * 1024)
	if computeMaxStmtTempGrowth(vm, f) != want {
		return "struct-returning function must reserve the return-image build (AggregateReturnSize)"
	}
	return ""
}

// TestMaxGrowthWithFaultPad: a function carrying a (non-growing) fault pad still
// computes its body's MaxStmtTempGrowth without tripping the fault-pad
// zero-growth guard.  The pad (a bare unwind return) is off f.Blocks, so it does
// not add to the body peak.
func TestMaxGrowthWithFaultPad() testing.TestResult {
	var f @ir.Func = ir.NewFunc("test", "f", mgNoParams(), mgNoResults())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var instrs @[]@ir.Instr = make_slice(@ir.Instr, 3)
	instrs[0] = mgOp(iropcode.OP_MAKE_SLICE)
	instrs[1] = mgOp(iropcode.OP_SP_RESTORE)
	instrs[2] = mgOp(iropcode.OP_RETURN)
	mgSetInstrs(entry, instrs)
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	irbuild.EmitUnwindReturn(pad)
	var vm @VM = newTestVM(64 * 1024)
	if computeMaxStmtTempGrowth(vm, f) != 4 * REG_SLOT {
		return "a non-growing fault pad must not change the body's MaxStmtTempGrowth"
	}
	return ""
}

// TestArgSubstBytes pins the cross-mode arg-substitution scratch: a cross-mode
// call (start=1) with an interface-value arg reserves align8(SizeOf) per iface
// slot; non-substituting call shapes reserve nothing.
func TestArgSubstBytes() testing.TestResult {
	var vm @VM = newTestVM(64 * 1024)
	var ivType @types.Type = types.MakeInterfaceValueType(nil)
	var want int = (ivType.SizeOf() + 7) / 8 * 8
	if want <= 0 {
		return "iface-value SizeOf should be positive"
	}
	var recv @ir.Instr = make(ir.Instr)
	recv.Typ = types.TypInt()
	var ivArg @ir.Instr = make(ir.Instr)
	ivArg.Typ = ivType
	var args2 @[]@ir.Instr = make_slice(@ir.Instr, 2)
	args2[0] = recv
	args2[1] = ivArg

	var im @ir.Instr = make(ir.Instr)
	im.Op = iropcode.OP_CALL_IFACE_METHOD
	im.Args = args2
	if argSubstBytes(vm, im) != want {
		return "iface-method call with an iface-value arg must reserve substitution scratch"
	}

	var fv @ir.Instr = make(ir.Instr)
	fv.Op = iropcode.OP_CALL_FUNC_VALUE
	fv.Args = args2
	if argSubstBytes(vm, fv) != want {
		return "func-value call with an iface-value arg must reserve substitution scratch"
	}

	// An indirect call does no cross-mode substitution.
	var ic @ir.Instr = make(ir.Instr)
	ic.Op = iropcode.OP_CALL_INDIRECT
	ic.Args = args2
	if argSubstBytes(vm, ic) != 0 {
		return "an indirect call must not reserve arg-substitution scratch"
	}

	// A non-call op reserves nothing even with an iface-value operand.
	var ld @ir.Instr = make(ir.Instr)
	ld.Op = iropcode.OP_LOAD
	ld.Args = args2
	if argSubstBytes(vm, ld) != 0 {
		return "a non-call op must not reserve arg-substitution scratch"
	}
	return ""
}
