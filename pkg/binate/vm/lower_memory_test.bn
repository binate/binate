package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for memory-instruction lowering (lower_memory.bn).
// Uses lowerFromSource and concatStr from sibling test files.

// mkTargetWord builds a TargetInfo with a uniform PointerSize / IntSize /
// MaxAlign of `word` bytes — for exercising the target-parameterized field
// offsets (the byte order / other fields are left at their zero default, matching
// the types package's own setTarget32 / setTarget64 test helpers).
func mkTargetWord(word int) types.TargetInfo {
	var t types.TargetInfo
	t.PointerSize = word
	t.IntSize = word
	t.MaxAlign = word
	return t
}

// hasOp returns true if any instruction in the first function uses op.
func hasOp(vm @VM, op int) bool {
	if len(vm.Funcs) == 0 { return false }
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == op { return true }
	}
	return false
}

// ============================================================
// lowerLoad / lowerStore — scalar widths
// ============================================================

func TestLoadStoreInt() testing.TestResult {
	// `int` width tracks the host: 8-byte (BC_LOAD64 / BC_STORE64)
	// on a 64-bit host, 4-byte (BC_LOAD8 / BC_STORE8 with Imm = byte
	// count — the sub-word path in lower_memory.bn) on a 32-bit host.
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var a int = 7\n")
	src = concatStr(src, "  return a\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	if cast(int, sizeof(int)) == 8 {
		if !hasOp(vm, BC_STORE64) { return "expected BC_STORE64 for int store on 64-bit host" }
		if !hasOp(vm, BC_LOAD64) { return "expected BC_LOAD64 for int load on 64-bit host" }
	} else {
		if !hasOp(vm, BC_STORE8) { return "expected BC_STORE8 (sub-word) for int store on 32-bit host" }
		if !hasOp(vm, BC_LOAD8) { return "expected BC_LOAD8 (sub-word) for int load on 32-bit host" }
	}
	return ""
}

func TestLoadStoreUint8() testing.TestResult {
	// uint8 is 8 bits → LOAD8/STORE8.
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() uint8 {\n")
	src = concatStr(src, "  var b uint8 = 255\n")
	src = concatStr(src, "  return b\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	if !hasOp(vm, BC_STORE8) { return "expected BC_STORE8 for uint8 store" }
	if !hasOp(vm, BC_LOAD8) { return "expected BC_LOAD8 for uint8 load" }
	return ""
}

func TestLoadStoreBool() testing.TestResult {
	// bool is 8 bits in memory → LOAD8/STORE8.
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() bool {\n")
	src = concatStr(src, "  var b bool = true\n")
	src = concatStr(src, "  return b\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	if !hasOp(vm, BC_STORE8) { return "expected BC_STORE8 for bool store" }
	if !hasOp(vm, BC_LOAD8) { return "expected BC_LOAD8 for bool load" }
	return ""
}

// ============================================================
// lowerStore — multi-word values use MEMCPY; nil uses MEMSET
// ============================================================

func TestStoreStructUsesMemcpy() testing.TestResult {
	// Assigning a struct value should lower to a MEMCPY, not STORE64.
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "type Pair struct { A int; B int }\n")
	src = concatStr(src, "func main() {\n")
	src = concatStr(src, "  var p Pair\n")
	src = concatStr(src, "  var q Pair = p\n")
	src = concatStr(src, "  q.A = 0\n") // keep q live
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	if !hasOp(vm, BC_MEMCPY) { return "expected BC_MEMCPY for struct copy" }
	return ""
}

// An aggregate OP_LOAD must lower to BC_LOAD_AGGREGATE — a copy into the
// load's own frame region — not a BC_MOV that aliases the source.  When
// the loaded value outlives its source (here `return s[0]`, whose element
// header lives in the local container's backing), the alias dangles: the
// function's cleanup RefDecs (frees) the backing before the returned value
// is copied out, so the VM returned an empty slice.
// conformance/regressions/return-aggregate-element-of-local is the
// end-to-end guard; this pins the lowering.
func TestAggregateElementLoadMaterializesCopy() testing.TestResult {
	// Use a struct-array element returned directly, built by field stores
	// (NO composite literal): `return arr[0]` is then the ONLY aggregate
	// OP_LOAD in the module, so the assertion genuinely pins the element-
	// load path.  A `@[]@[]char{...}` literal would itself emit a
	// BC_LOAD_AGGREGATE and mask a regression of `return arr[0]` to an
	// aliasing BC_MOV.
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "type T struct { a int; b int }\n")
	src = concatStr(src, "func f() T {\n")
	src = concatStr(src, "  var arr [2]T\n")
	src = concatStr(src, "  arr[0].a = 7\n")
	src = concatStr(src, "  return arr[0]\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() {}\n")
	var vm @VM = lowerFromSource(src)
	var found bool = false
	for fi := 0; fi < len(vm.Funcs); fi++ {
		for ci := 0; ci < len(vm.Funcs[fi].Code); ci++ {
			if vm.Funcs[fi].Code[ci].Op == BC_LOAD_AGGREGATE {
				found = true
			}
		}
	}
	if !found {
		return "expected BC_LOAD_AGGREGATE for a struct-array element load (got an aliasing BC_MOV)"
	}
	return ""
}

// ============================================================
// lowerGetFieldPtr — FIELD_PTR emitted for struct field access
// (struct field offset path; the slice/managed-slice path is
//  separately covered when slice field assigns get exercised.)
// ============================================================

func TestGetFieldPtrStruct() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "type Q struct { X int; Y int; Z int }\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var q Q\n")
	src = concatStr(src, "  q.Z = 42\n")
	src = concatStr(src, "  return q.Z\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	if !hasOp(vm, BC_FIELD_PTR) { return "expected BC_FIELD_PTR for struct field access" }
	return ""
}

// mkFieldPtr builds a GET_FIELD_PTR whose base carries structTyp as its
// TypeArg and selects field `index`, then lowers it and returns the resulting
// BC_FIELD_PTR's Imm (the byte offset).
func mkFieldPtr(structTyp @types.Type, index int) int {
	var base @ir.Instr = make(ir.Instr)
	base.TypeArg = structTyp
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = base
	var instr @ir.Instr = make(ir.Instr)
	instr.Args = args
	instr.Index = index
	var bc BCInstr
	return lowerGetFieldPtr(instr, bc).Imm
}

// A (managed-)slice field offset is index * ONE TARGET WORD, not a hardcoded 8.
// The slice header is word-per-field ({data, len[, refptr, backingLen]}); a
// hardcoded 8 put the len field at offset 8 in an 8-byte raw slice on a 32-bit
// target — past the 2-word aggregate — so the cross-mode-marshaled slice read
// len 0.  Exercised on both word sizes via SetTarget (PointerSize is
// target-parameterized, unlike the compile-time host REG_SLOT).
func TestGetFieldPtrSliceOffsetTargetAware() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	var sliceTyp @types.Type = types.MakeSliceType(types.TypUint8())
	var msTyp @types.Type = types.MakeManagedSliceType(types.TypUint8())

	types.SetTarget(mkTargetWord(8))
	if mkFieldPtr(sliceTyp, 1) != 8 {
		types.SetTarget(saved)
		return "LP64: raw-slice field 1 (len) offset must be 8 (one word)"
	}
	if mkFieldPtr(msTyp, 2) != 16 {
		types.SetTarget(saved)
		return "LP64: managed-slice field 2 (refptr) offset must be 16 (two words)"
	}

	types.SetTarget(mkTargetWord(4))
	if mkFieldPtr(sliceTyp, 1) != 4 {
		types.SetTarget(saved)
		return "ILP32: raw-slice field 1 (len) offset must be 4 (one word), not 8"
	}
	if mkFieldPtr(msTyp, 2) != 8 {
		types.SetTarget(saved)
		return "ILP32: managed-slice field 2 (refptr) offset must be 8 (two words), not 16"
	}

	types.SetTarget(saved)
	return ""
}
