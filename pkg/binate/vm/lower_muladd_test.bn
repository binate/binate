package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/builtins/testing"

// lowerAtOpt compiles src and lowers it at the given opt level.
func lowerAtOpt(src *[]readonly char, level int) @VM {
	var m @ir.Module = genModule(src)
	var vm @VM = newTestVM(testVMStackSize)
	vm.OptLevel = level
	vm.LowerModule(m)
	return vm
}

// At -O1 the fuse-mul-add pass rewrites `a*b + c` to OP_MADD, which lowers to a
// single BC_MADD (Src1=a, Src2=b, Aux=c) with the standalone BC_MUL gone.
func TestLowerMaddO1() testing.TestResult {
	var vm @VM = lowerAtOpt(
			"package \"test\"\nfunc f(a int, b int, c int) int { return a * b + c }\n", 1)
	if countBCOp(vm, BC_MADD) != 1 { return "expected one BC_MADD at -O1" }
	if countBCOp(vm, BC_MUL) != 0 { return "the fused BC_MUL must be gone" }
	return ""
}

// `c - a*b` lowers to BC_MSUB.
func TestLowerMsubO1() testing.TestResult {
	var vm @VM = lowerAtOpt(
			"package \"test\"\nfunc f(a int, b int, c int) int { return c - a * b }\n", 1)
	if countBCOp(vm, BC_MSUB) != 1 { return "expected one BC_MSUB at -O1" }
	if countBCOp(vm, BC_MUL) != 0 { return "the fused BC_MUL must be gone" }
	return ""
}

// At -O0 nothing fuses: the plain BC_MUL + BC_ADD path is lowered, no BC_MADD.
func TestLowerNoFuseO0() testing.TestResult {
	var vm @VM = lowerAtOpt(
			"package \"test\"\nfunc f(a int, b int, c int) int { return a * b + c }\n", 0)
	if countBCOp(vm, BC_MADD) != 0 { return "no BC_MADD should be produced at -O0" }
	if countBCOp(vm, BC_MUL) != 1 { return "expected the plain BC_MUL at -O0" }
	return ""
}
