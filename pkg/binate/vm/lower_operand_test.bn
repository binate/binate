package "pkg/binate/vm"

import "pkg/binate/irbuild"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/check"
import "pkg/binate/ir"
import "pkg/binate/irgen"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// An operand that is not one of its function's own values (irbuild.ForeignOperandError)
// is a lowering error (lowerFunc, and the frame check before lowering: funcFrameBytes),
// found before phi elimination; once a function's phis are eliminated, its instructions
// read phis that have left their blocks, which is no error.  phiPredFunc, foreignBlock and
// keepsPhi are lower_phi_pred_test's.  Nothing here runs code.

// foreignReturn makes f's return (the last instruction of merge) read the constant of
// the block of g that foreignBlock returns -- of id 0, the id of f's own condition, which a
// register named by the operand's id would hold instead.
func foreignReturn(merge @ir.Block, foreign @ir.Block) {
	merge.Instrs[len(merge.Instrs) - 1].Args[0] = foreign.Instrs[0]
}

// A return reading another function's instruction is the one lowering error of an
// otherwise valid function, naming the function, the block, the operand and its function;
// f is left as it was (no phi elimination).
func TestLowerFuncRejectsForeignOperand() testing.TestResult {
	var f @ir.Func
	var bs @[]@ir.Block
	var p @ir.Instr
	f, bs, p = phiPredFunc()
	var m @ir.Module = ir.NewModule("\"test\"")
	m.AddFunc(f)
	var g @ir.Func
	var foreign @ir.Block
	g, foreign = foreignBlock()
	m.AddFunc(g)
	foreignReturn(bs[3], foreign)
	var vm @VM = newTestVM(64 * 1024)
	_ = lowerFunc(vm, f, irbuild.NewModuleValues(m))
	var want *[]readonly char = "a return in test.f (block merge.3) has its operand 0 (v0) outside "
			"the function (an instruction of test.g)"
	var got @[]char = "(none)"
	if vm.lowerErrs != nil && vm.lowerErrs.Len() > 0 { got = vm.lowerErrs.Get(0) }
	if vm.lowerErrs == nil || vm.lowerErrs.Len() != 1 || !faultStrEq(got, want) {
		return buf.Concat("g's constant must be the one lowering error; got: ", got)
	}
	if !keepsPhi(f, bs[3], p) { return "lowering must leave f as it was (no phi elimination)" }
	return ""
}

// The frame check (frameErrors) records the error of a function whose return reads another
// function's instruction as the one lowering error, which FrameCheck and LowerModule then
// stop with as an internal error; it reports no frame error for the function, and leaves it
// as it was (no phi elimination).
func TestFrameErrorsRecordForeignOperand() testing.TestResult {
	var f @ir.Func
	var bs @[]@ir.Block
	var p @ir.Instr
	f, bs, p = phiPredFunc()
	var m @ir.Module = ir.NewModule("\"test\"")
	m.AddFunc(f)
	var g @ir.Func
	var foreign @ir.Block
	g, foreign = foreignBlock()
	m.AddFunc(g)
	foreignReturn(bs[3], foreign)
	var fs @[]@ir.Func = make_slice(@ir.Func, 1)
	fs[0] = f
	var vm @VM = newTestVM(testVMStackSize)
	var errs @[]@[]char = frameErrors(vm, fs, irbuild.NewModuleValues(m))
	if len(errs) != 0 {
		return buf.Concat("the frame check must report no frame error; got: ", errs[0])
	}
	var want *[]readonly char = "a return in test.f (block merge.3) has its operand 0 (v0) outside "
			"the function (an instruction of test.g)"
	var got @[]char = "(none)"
	if vm.lowerErrs != nil && vm.lowerErrs.Len() > 0 { got = vm.lowerErrs.Get(0) }
	if vm.lowerErrs == nil || vm.lowerErrs.Len() != 1 || !faultStrEq(got, want) {
		return buf.Concat("the frame check must record g's constant as the one lowering error; got: ",
				got)
	}
	if !keepsPhi(f, bs[3], p) { return "the frame check must leave f as it was (no phi elimination)" }
	return ""
}

// The frame check eliminates a function's phis, after which its return reads a phi no
// block holds and its operands cannot be checked; lowering it then records no error, nor
// does a second frame check: each checks operands only while the phis are not eliminated
// (ir.Func.PhisEliminated).
func TestLowerFuncAfterPhiEliminationTakesPhis() testing.TestResult {
	var f @ir.Func
	var bs @[]@ir.Block
	var p @ir.Instr
	f, bs, p = phiPredFunc()
	var values @irbuild.ModuleValues = testValues()
	var vm @VM = newTestVM(64 * 1024)
	_ = funcFrameBytes(vm, f, values)
	if vm.lowerErrs != nil && vm.lowerErrs.Len() > 0 {
		return buf.Concat("the frame check must record no error; got: ", vm.lowerErrs.Get(0))
	}
	if keepsPhi(f, bs[3], p) { return "the frame check must eliminate f's phis" }
	if bs[3].Instrs[len(bs[3].Instrs) - 1].Args[0] != p { return "f's return must read the phi" }
	_ = funcFrameBytes(vm, f, values)
	if vm.lowerErrs != nil && vm.lowerErrs.Len() > 0 {
		return buf.Concat("a second frame check must record no error; got: ", vm.lowerErrs.Get(0))
	}
	_ = lowerFunc(vm, f, values)
	if vm.lowerErrs != nil && vm.lowerErrs.Len() > 0 {
		return buf.Concat("lowering after the frame check must record no error; got: ",
				vm.lowerErrs.Get(0))
	}
	return ""
}

// LowerModule, LowerOneFunc and LowerFuncsShadow each check the functions they lower
// against the module they are given: a function that reads the module's package variable
// through the module's global-address pseudo lowers (another module's would stop the
// entry point with an internal error), the redefinitions' phis not eliminated beforehand.
func TestLowerEntryPointsTakeModulesGlobals() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nvar g int\nfunc a() int { return g }\n"
			"func main() int { return 0 }\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = mustParse(p)
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	var m @ir.Module = irgen.GenModule(c, file)
	var vm @VM = newTestVM(testVMStackSize)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var noArgs @[]int
	if vm.CallFunc("test.a", noArgs) != 0 { return "LowerModule: a must read g" }
	var one @ir.Func = replRedef(c, m, "func a() int { return g + 1 }")
	if one == nil || one.PhisEliminated { return "the first redefinition must generate, unlowered" }
	vm.LowerOneFunc(m, one)
	if vm.CallFunc("test.a", noArgs) != 1 { return "LowerOneFunc: a must read g" }
	var group @[]@ir.Func = make_slice(@ir.Func, 1)
	group[0] = replRedef(c, m, "func a() int { return g + 2 }")
	if group[0] == nil || group[0].PhisEliminated {
		return "the second redefinition must generate, unlowered"
	}
	vm.LowerFuncsShadow(m, group)
	if vm.CallFunc("test.a", noArgs) != 2 { return "LowerFuncsShadow: a must read g" }
	return ""
}

// FrameCheck takes the functions of a module that read its package variable through the
// module's global-address pseudos.
func TestFrameCheckTakesModulesGlobals() testing.TestResult {
	var m @ir.Module = genModule("package \"test\"\nvar g int\nfunc f() int { g = g + 1; return g }\n")
	var errs @[]@[]char = newTestVM(testVMStackSize).FrameCheck(m, m.Funcs)
	if len(errs) != 0 { return buf.Concat("FrameCheck must report no frame error; got: ", errs[0]) }
	return ""
}
