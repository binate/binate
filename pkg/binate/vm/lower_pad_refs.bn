package "pkg/binate/vm"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/std/cmp"
import "pkg/std/containers/table"

// A function's fault pads (ir.Func.FaultPads) are the pads lowering gives code: a
// fault lands in the pad its op names (ir.Instr.PadBlock), and a pad's cleanup jumps
// or branches on through further pads.  A pass that drops blocks drops the pads only
// they reached from FaultPads, and a pad dropped stays allocated as long as its
// function (ir.Func.AddedBlocks), so an op left naming one names a pad lowering has
// no code for.

// padRefError describes the first instruction of f.Blocks, then of f.FaultPads, whose
// fault lands in a block that is not one of f.FaultPads, or that jumps or branches to a
// fault pad that is not one of them -- a pad dropped from them, or another function's --
// naming f, the block or pad that holds it and the pad, or is empty when there is none.
// lowerFunc records it as a lowering error before anything resolves a pad: the fault
// table (lowerFunc), the register plan (buildSlotPlan) and the result-slot analysis
// (padChainNamesID) look a pad up among f's blocks and pads.  A jump to a block that is
// no pad is findBlockOffset's to judge.
func padRefError(f @ir.Func) @[]char {
	// f.FaultPads' addresses, gathered at the first instruction naming a pad.
	var own @table.Table[int, bool, ir.AddrHasher, cmp.Default[int]]
	for list := 0; list < 2; list++ {
		var blocks @[]@ir.Block = f.Blocks
		var holder *[]readonly char = "block"
		if list == 1 {
			blocks = f.FaultPads
			holder = "pad"
		}
		for bi := 0; bi < len(blocks); bi++ {
			var b @ir.Block = blocks[bi]
			for ii := 0; ii < len(b.Instrs); ii++ {
				var ins @ir.Instr = b.Instrs[ii]
				if ins.PadBlock == nil && !isPadBlock(ins.Block1) && !isPadBlock(ins.Block2) { continue }
				if own == nil { own = padAddrs(f) }
				var fault @[]char = padRefFault(f, own, ins.PadBlock)
				if len(fault) > 0 { return padRefIn("a fault op", f, holder, b, " lands in ", fault) }
				var kind *[]readonly char = "a branch"
				if ins.Op == iropcode.OP_JUMP { kind = "a jump" }
				if isPadBlock(ins.Block1) { fault = padRefFault(f, own, ins.Block1) }
				if len(fault) == 0 && isPadBlock(ins.Block2) { fault = padRefFault(f, own, ins.Block2) }
				if len(fault) > 0 { return padRefIn(kind, f, holder, b, " targets ", fault) }
			}
		}
	}
	return ""
}

// isPadBlock reports whether b is a fault pad (ir.Block.IsFaultPad), of any function.
func isPadBlock(b *ir.Block) bool { return b != nil && b.IsFaultPad }

// padAddrs returns the set of the addresses of f.FaultPads.
func padAddrs(f @ir.Func) @table.Table[int, bool, ir.AddrHasher, cmp.Default[int]] {
	var own @table.Table[int, bool, ir.AddrHasher, cmp.Default[int]] = table.NewTable[int, bool,
			ir.AddrHasher, cmp.Default[int]](
					ir.AddrHasher{}, cmp.Default[int]{})
	for pi := 0; pi < len(f.FaultPads); pi++ {
		own.Put(bit_cast(int, f.FaultPads[pi]), true)
	}
	return own
}

// padRefFault returns how pad, named by an instruction of f as a pad, is not one of
// f.FaultPads, whose addresses own holds -- "<label>, which is not one of the
// function's fault pads (<why>)", why being "a block of <function>" for another
// function's block, "not a fault pad" for a block of f that is none, and "a pad
// dropped from them" otherwise -- or "" when it is nil or one of them.
func padRefFault(f @ir.Func, own @table.Table[int, bool, ir.AddrHasher, cmp.Default[int]],
		pad *ir.Block) @[]char {
	if pad == nil || own.Has(bit_cast(int, pad)) { return "" }
	var why @[]char = "a pad dropped from them"
	if pad.Func != f {
		// A block that neither ir.AddBlock nor ir.AddFaultPad made has no Func.
		var owner @[]char = "no function"
		if pad.Func != nil { owner = pad.Func.Name }
		why = buf.Concat("a block of ", owner)
	} else if !pad.IsFaultPad {
		why = "not a fault pad"
	}
	var label @[]char = buf.Concat(pad.Label, ", which is not one of the function's fault pads (")
	return buf.Concat(buf.Concat(label, why), ")")
}

// padRefIn describes fault (a padRefFault) of an instruction of kind ("a fault op", "a
// jump", "a branch") in b of f, a holder ("block" of f.Blocks, or "pad" of f.FaultPads),
// joined by how ("lands in", "targets").
func padRefIn(kind *[]readonly char, f @ir.Func, holder *[]readonly char, b @ir.Block,
		how *[]readonly char, fault *[]readonly char) @[]char {
	var where @[]char = buf.Concat(buf.Concat(kind, " in "), f.Name)
	where = buf.Concat(buf.Concat(buf.Concat(where, " ("), holder), " ")
	where = buf.Concat(where, b.Label)
	return buf.Concat(buf.Concat(where, ")"), buf.Concat(how, fault))
}
