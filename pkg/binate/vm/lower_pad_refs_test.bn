package "pkg/binate/vm"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/containers/vec"

// Tests for padRefError (lower_pad_refs.bn): an instruction naming, as the pad its fault
// lands in or as a jump target, a pad that is not one of its function's fault pads is
// the one lowering error of its function.  Nothing here runs code.

// padRefFunc builds test.f, `entry: bounds-check 0, 1 (lands in pad.0); return`, whose
// pad pad.0 jumps to pad.1, which unwinds; and returns it and the check.
func padRefFunc() (@ir.Func, @ir.Instr) {
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var noInstrs @[]@ir.Instr
	var f @ir.Func = ir.NewFunc("", "test.f", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var pad0 @ir.Block = ir.AddFaultPad(f, "pad")
	var pad1 @ir.Block = ir.AddFaultPad(f, "pad")
	irbuild.EmitJump(pad0, pad1)
	irbuild.EmitUnwindReturn(pad1)
	var c0 @ir.Instr = irbuild.EmitConstInt(entry, 0, types.TypInt())
	var c1 @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	irbuild.EmitBoundsCheck(entry, c0, c1)
	var check @ir.Instr = entry.Instrs[2]
	check.PadBlock = pad0
	irbuild.EmitReturn(entry, noInstrs)
	return f, check
}

// keepPads cuts f.FaultPads to its first n pads as pruning pads drops the rest: the list
// and its builder are replaced, so nothing of f's but f.AddedBlocks holds the rest.
func keepPads(f @ir.Func, n int) {
	var kept @vec.Vec[@ir.Block] = vec.New[@ir.Block]()
	for i := 0; i < n; i++ { kept.Push(f.FaultPads[i]) }
	f.FaultPadsVec = kept
	f.FaultPads = kept.Items()
}

// A fault op landing in a pad dropped from f.FaultPads, in another function's pad or in
// a block of f that is no pad, a pad's jump to a pad dropped from f.FaultPads, a body
// block's jump to one, and a pad's branch whose else target is one, are each the one
// lowering error of an otherwise valid function, naming the function, the block or pad
// holding the op and the pad.  The dropped pads are named after the drop with nothing of
// the test's holding them (ir.Func.AddedBlocks keeps them allocated).
func TestLowerFuncRejectsPadNotAmongFaultPads() testing.TestResult {
	var f @ir.Func
	var check @ir.Instr
	var n int
	var msg @[]char
	f, check = padRefFunc()
	n, msg = lowerErrsOf(f)
	if n != 0 { return buf.Concat("its own pads must lower with no error; got: ", msg) }
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var g @ir.Func = ir.NewFunc("", "test.g", noParams, noResults)
	var foreign @ir.Block = ir.AddFaultPad(g, "gpad")
	irbuild.EmitUnwindReturn(foreign)
	var wants @[]*[]readonly char = make_slice(*[]readonly char, 6)
	wants[0] = "a fault op in test.f (block entry.0) lands in late.2, which is not one of the "
			"function's fault pads (a pad dropped from them)"
	wants[1] = "a fault op in test.f (block entry.0) lands in gpad.0, which is not one of the "
			"function's fault pads (a block of test.g)"
	wants[2] = "a fault op in test.f (block entry.0) lands in entry.0, which is not one of the "
			"function's fault pads (not a fault pad)"
	wants[3] = "a jump in test.f (pad pad.0) targets pad.1, which is not one of the function's "
			"fault pads (a pad dropped from them)"
	wants[4] = "a jump in test.f (block tail.1) targets late.2, which is not one of the "
			"function's fault pads (a pad dropped from them)"
	wants[5] = "a branch in test.f (pad split.2) targets late.3, which is not one of the "
			"function's fault pads (a pad dropped from them)"
	var whats @[]*[]readonly char = make_slice(*[]readonly char, 6)
	whats[0] = "a fault op landing in a dropped pad"
	whats[1] = "a fault op landing in another function's pad"
	whats[2] = "a fault op landing in a block that is no pad"
	whats[3] = "a pad's jump to a dropped pad"
	whats[4] = "a body block's jump to a dropped pad"
	whats[5] = "a pad's branch whose else target is a dropped pad"
	for k := 0; k < 6; k++ {
		f, check = padRefFunc()
		if k == 0 {
			var late @ir.Block = ir.AddFaultPad(f, "late")
			irbuild.EmitUnwindReturn(late)
			check.PadBlock = late
			keepPads(f, 2)
		}
		if k == 1 { check.PadBlock = foreign }
		if k == 2 { check.PadBlock = f.Blocks[0] }
		if k == 3 { keepPads(f, 1) }
		if k == 4 {
			var late @ir.Block = ir.AddFaultPad(f, "late")
			irbuild.EmitUnwindReturn(late)
			irbuild.EmitJump(ir.AddBlock(f, "tail"), late)
			keepPads(f, 2)
		}
		if k == 5 {
			// split.2 branches to pad.1, kept, or to late.3, dropped.
			var split @ir.Block = ir.AddFaultPad(f, "split")
			var late @ir.Block = ir.AddFaultPad(f, "late")
			irbuild.EmitUnwindReturn(late)
			irbuild.EmitBranch(split, irbuild.EmitConstBool(split, true), f.FaultPads[1], late)
			keepPads(f, 3)
		}
		n, msg = lowerErrsOf(f)
		if n != 1 || !faultStrEq(msg, wants[k]) {
			return buf.Concat(buf.Concat(whats[k], ": must be the one lowering error; got: "), msg)
		}
	}
	return ""
}
