package "pkg/binate/vm"

import "pkg/binate/irbuild"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A phi whose predecessor is not one of its function's blocks (irbuild.ForeignPhiPredError)
// is a lowering error (lowerFunc, and the frame check before lowering: funcFrameBytes), and
// phi elimination never runs on its function: it would place that edge's copies in the
// block the phi names.  Nothing here runs code.

// phiPredFunc builds test.f, `entry: branch true, then, else; then: jump merge; else:
// jump merge; merge: p = phi [10, then], [20, else]; return p`, and returns it, its
// blocks and its phi.
func phiPredFunc() (@ir.Func, @[]@ir.Block, @ir.Instr) {
	var f @ir.Func = ir.NewFunc("", "test.f", phiNoParams(), intResult())
	var bs @[]@ir.Block = make_slice(@ir.Block, 4)
	bs[0] = ir.AddBlock(f, "entry")
	bs[1] = ir.AddBlock(f, "then")
	bs[2] = ir.AddBlock(f, "else")
	bs[3] = ir.AddBlock(f, "merge")
	irbuild.EmitBranch(bs[0], irbuild.EmitConstBool(bs[0], true), bs[1], bs[2])
	var t @ir.Instr = irbuild.EmitConstInt(bs[1], 10, types.TypInt())
	irbuild.EmitJump(bs[1], bs[3])
	var e @ir.Instr = irbuild.EmitConstInt(bs[2], 20, types.TypInt())
	irbuild.EmitJump(bs[2], bs[3])
	var p @ir.Instr = irbuild.EmitPhi(bs[3], types.TypInt(), phiEntries2(bs[1], t, bs[2], e))
	irbuild.EmitReturn(bs[3], retInstr(p))
	return f, bs, p
}

// foreignBlock returns the block `then: return 0` of a new function test.g, which the
// caller keeps alive in g while a phi of another function names the block.
func foreignBlock() (@ir.Func, @ir.Block) {
	var g @ir.Func = ir.NewFunc("", "test.g", phiNoParams(), intResult())
	var b @ir.Block = ir.AddBlock(g, "then")
	irbuild.EmitReturn(b, retInstr(irbuild.EmitConstInt(b, 0, types.TypInt())))
	return g, b
}

// keepsPhi reports whether f still has its four blocks and merge still leads with p:
// phi elimination has not run on f.
func keepsPhi(f @ir.Func, merge @ir.Block, p @ir.Instr) bool {
	return len(f.Blocks) == 4 && len(merge.Instrs) == 2 && merge.Instrs[0] == p
}

// A phi whose predecessor is another function's block, nil, one of f's fault pads, or a
// block of f a pass dropped from f.Blocks is the one lowering error of an otherwise valid
// function, naming the function, the phi's block and the predecessor; f, the other
// function's block, the pad and the dropped block are left as they were.
func TestLowerFuncRejectsPhiPredOutsideFunction() testing.TestResult {
	var f @ir.Func
	var bs @[]@ir.Block
	var p @ir.Instr
	var n int
	var msg @[]char
	f, bs, p = phiPredFunc()
	n, msg = lowerErrsOf(f)
	if n != 0 { return buf.Concat("own predecessors must lower with no error; got: ", msg) }
	var g @ir.Func
	var foreign @ir.Block
	g, foreign = foreignBlock()
	var wants @[]*[]readonly char = make_slice(*[]readonly char, 4)
	wants[0] = "a phi in test.f (block merge.3) has its predecessor then.0 outside the function (a "
			"block of test.g)"
	wants[1] = "a phi in test.f (block merge.3) has no predecessor"
	wants[2] = "a phi in test.f (block merge.3) has its predecessor pad.0 outside the function's "
			"blocks (a fault pad)"
	wants[3] = "a phi in test.f (block merge.3) has its predecessor gone.4 outside the function's "
			"blocks (a block dropped from them)"
	var whats @[]*[]readonly char = make_slice(*[]readonly char, 4)
	whats[0] = "a predecessor in g"
	whats[1] = "a nil predecessor"
	whats[2] = "a fault-pad predecessor"
	whats[3] = "a predecessor dropped from f.Blocks"
	var none *ir.Block
	for k := 0; k < 4; k++ {
		f, bs, p = phiPredFunc()
		var pad @ir.Block = ir.AddFaultPad(f, "pad")
		irbuild.EmitUnwindReturn(pad)
		// A block that jumps to merge, dropped from f.Blocks as a pass pruning blocks
		// drops one: phi elimination would put the edge's copies before its jump.
		var gone @ir.Block = ir.AddBlock(f, "gone")
		irbuild.EmitJump(gone, bs[3])
		f.Blocks = bs
		if k == 0 { p.Phis[0].Block = foreign }
		if k == 1 { p.Phis[1].Block = none }
		if k == 2 { p.Phis[1].Block = pad }
		if k == 3 { p.Phis[1].Block = gone }
		n, msg = lowerErrsOf(f)
		if n != 1 || !faultStrEq(msg, wants[k]) {
			return buf.Concat(buf.Concat(whats[k], ": must be the one lowering error; got: "), msg)
		}
		if !keepsPhi(f, bs[3], p) || len(pad.Instrs) != 1 || len(gone.Instrs) != 1 {
			return buf.Concat(whats[k],
					": f, its pad and the dropped block must be left as they were (no phi elimination)")
		}
	}
	if len(foreign.Instrs) != 2 || g.Blocks[0] != foreign {
		return "g's block must be left as it was: its constant and return, no copies"
	}
	return ""
}

// The frame check (frameErrors) records the error of a function whose phi names another
// function's block as the one lowering error, which FrameCheck and LowerModule then stop
// with as an internal error, not a load error of the program's; it reports no frame error
// for the function, and leaves it and the other function's block as they were -- phi
// elimination would put the edge's copies in that block.
func TestFrameErrorsRecordPhiPredOutsideFunction() testing.TestResult {
	var f @ir.Func
	var bs @[]@ir.Block
	var p @ir.Instr
	f, bs, p = phiPredFunc()
	var g @ir.Func
	var foreign @ir.Block
	g, foreign = foreignBlock()
	p.Phis[0].Block = foreign
	var fs @[]@ir.Func = make_slice(@ir.Func, 1)
	fs[0] = f
	var vm @VM = newTestVM(testVMStackSize)
	var errs @[]@[]char = frameErrors(vm, fs)
	if len(errs) != 0 {
		return buf.Concat("the frame check must report no frame error; got: ", errs[0])
	}
	var want *[]readonly char = "a phi in test.f (block merge.3) has its predecessor then.0 "
			"outside the function (a block of test.g)"
	var got @[]char = "(none)"
	if vm.lowerErrs != nil && vm.lowerErrs.Len() > 0 { got = vm.lowerErrs.Get(0) }
	if vm.lowerErrs == nil || vm.lowerErrs.Len() != 1 || !faultStrEq(got, want) {
		return buf.Concat(
				"the frame check must record the phi's error as the one lowering error; "
						"got: ",
				got)
	}
	if !keepsPhi(f, bs[3], p) {
		return "the frame check must leave f as it was (no phi elimination)"
	}
	if len(foreign.Instrs) != 2 || g.Blocks[0] != foreign {
		return "the frame check must leave g's block as it was: its constant and return, no copies"
	}
	return ""
}
