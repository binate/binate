package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// End-to-end tests for the VM's phi handling: lowerFunc runs ir.EliminatePhis
// (removing OP_PHI, inserting OP_COPY moves), and OP_COPY lowers to BC_MOV.  These
// hand-build phi IR (nothing in the compiler emits phis yet), lower + EXECUTE it,
// and check the result.

func phiNoParams() @[]@ir.Param {
	var p @[]@ir.Param
	return p
}

func intResult() @[]@types.Type {
	var r @[]@types.Type = make_slice(@types.Type, 1)
	r[0] = types.TypInt()
	return r
}

func phiEntries2(b1 @ir.Block, v1 @ir.Instr, b2 @ir.Block, v2 @ir.Instr) @[]ir.PhiEntry {
	var pe1 ir.PhiEntry
	pe1.Block = b1
	pe1.Val = v1
	var pe2 ir.PhiEntry
	pe2.Block = b2
	pe2.Val = v2
	var es @[]ir.PhiEntry = make_slice(ir.PhiEntry, 2)
	es[0] = pe1
	es[1] = pe2
	return es
}

func retInstr(v @ir.Instr) @[]@ir.Instr {
	var r @[]@ir.Instr = make_slice(@ir.Instr, 1)
	r[0] = v
	return r
}

// buildPhiDiamond builds `f() int` returning thenVal if condVal else elseVal via a
// merge-block phi, then lowers it through the VM (which runs EliminatePhis).
func buildPhiDiamond(condVal bool, thenVal int, elseVal int) @VM {
	var f @ir.Func = ir.NewFunc("", "test.f", phiNoParams(), intResult())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var elseB @ir.Block = ir.AddBlock(f, "else")
	var merge @ir.Block = ir.AddBlock(f, "merge")
	var c @ir.Instr = entry.EmitConstBool(condVal)
	entry.EmitBranch(c, thenB, elseB)
	var t @ir.Instr = thenB.EmitConstInt(thenVal, types.TypInt())
	thenB.EmitJump(merge)
	var e @ir.Instr = elseB.EmitConstInt(elseVal, types.TypInt())
	elseB.EmitJump(merge)
	var phi @ir.Instr = merge.EmitPhi(types.TypInt(), phiEntries2(thenB, t, elseB, e))
	merge.EmitReturn(retInstr(phi))
	var m @ir.Module = ir.NewModule("\"test\"")
	m.AddFunc(f)
	var vm @VM = newTestVM(64 * 1024)
	vm.LowerModule(m)
	return vm
}

func TestVMPhiDiamondThen() testing.TestResult {
	var vm @VM = buildPhiDiamond(true, 10, 20)
	var argv @[]int
	if vm.CallFunc("test.f", argv) != 10 {
		return "phi diamond (cond true) should return the then-value 10"
	}
	return ""
}

func TestVMPhiDiamondElse() testing.TestResult {
	var vm @VM = buildPhiDiamond(false, 10, 20)
	var argv @[]int
	if vm.CallFunc("test.f", argv) != 20 {
		return "phi diamond (cond false) should return the else-value 20"
	}
	return ""
}

// buildPhiCriticalEdge builds `f() int` where `entry` ends in a CONDITIONAL
// branch straight into a 2-predecessor merge — a critical edge.  EliminatePhis
// must split it: the entry->merge copy lands in a new block on the edge, not at
// the branch.  cond true takes that split block (→ mergeVal); cond false goes
// entry->other->merge (→ otherVal).
func buildPhiCriticalEdge(condVal bool, mergeVal int, otherVal int) @VM {
	var f @ir.Func = ir.NewFunc("", "test.f", phiNoParams(), intResult())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var other @ir.Block = ir.AddBlock(f, "other")
	var merge @ir.Block = ir.AddBlock(f, "merge")
	var mv @ir.Instr = entry.EmitConstInt(mergeVal, types.TypInt())
	var c @ir.Instr = entry.EmitConstBool(condVal)
	entry.EmitBranch(c, merge, other) // entry->merge is the critical edge
	var ov @ir.Instr = other.EmitConstInt(otherVal, types.TypInt())
	other.EmitJump(merge)
	var phi @ir.Instr = merge.EmitPhi(types.TypInt(), phiEntries2(entry, mv, other, ov))
	merge.EmitReturn(retInstr(phi))
	var m @ir.Module = ir.NewModule("\"test\"")
	m.AddFunc(f)
	var vm @VM = newTestVM(64 * 1024)
	vm.LowerModule(m)
	return vm
}

func TestVMPhiCriticalEdge() testing.TestResult {
	var vm1 @VM = buildPhiCriticalEdge(true, 11, 22)
	var a1 @[]int
	if vm1.CallFunc("test.f", a1) != 11 {
		return "critical-edge phi (cond true): entry->merge via the split block should return 11"
	}
	var vm2 @VM = buildPhiCriticalEdge(false, 11, 22)
	var a2 @[]int
	if vm2.CallFunc("test.f", a2) != 22 {
		return "critical-edge phi (cond false): other->merge should return 22"
	}
	return ""
}

// TestVMPhiSwapLoop exercises the cycle-breaking end to end.  `f()` runs a single
// loop iteration whose back-edge swaps two loop-carried phis (a<-b, b<-a) — the
// classic parallel-copy cycle EliminatePhis breaks with a temp.  A `done` phi
// (false, flipped to true on the back-edge) stops after one swap.  Returning b:
// after one correct swap b holds a's original value (100); a lost-copy bug would
// leave b at 200.  This also proves the fresh cycle-break temp gets a register
// (NumRegs is sized from f.NextID AFTER EliminatePhis runs).
func TestVMPhiSwapLoop() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "test.f", phiNoParams(), intResult())
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var header @ir.Block = ir.AddBlock(f, "header")
	var body @ir.Block = ir.AddBlock(f, "body")
	var latch @ir.Block = ir.AddBlock(f, "latch")
	var exit @ir.Block = ir.AddBlock(f, "exit")

	var a0 @ir.Instr = entry.EmitConstInt(100, types.TypInt())
	var b0 @ir.Instr = entry.EmitConstInt(200, types.TypInt())
	var done0 @ir.Instr = entry.EmitConstBool(false)
	entry.EmitJump(header)

	// The latch's back-edge value for `done` — emitted before wiring the phis.
	var trueVal @ir.Instr = latch.EmitConstBool(true)
	latch.EmitJump(header)

	// Header phis: placeholder entries first, then the real 2-entry lists (the a/b
	// pair reference each other on the latch edge → a swap).
	var phiA @ir.Instr = header.EmitPhi(types.TypInt(), phiEntries2(entry, a0, entry, a0))
	var phiB @ir.Instr = header.EmitPhi(types.TypInt(), phiEntries2(entry, b0, entry, b0))
	var phiDone @ir.Instr = header.EmitPhi(types.TypBool(), phiEntries2(entry, done0, entry, done0))
	phiA.Phis = phiEntries2(entry, a0, latch, phiB)
	phiB.Phis = phiEntries2(entry, b0, latch, phiA)
	phiDone.Phis = phiEntries2(entry, done0, latch, trueVal)

	header.EmitBranch(phiDone, exit, body) // done ? exit : body
	body.EmitJump(latch)
	exit.EmitReturn(retInstr(phiB))

	var m @ir.Module = ir.NewModule("\"test\"")
	m.AddFunc(f)
	var vm @VM = newTestVM(64 * 1024)
	vm.LowerModule(m)

	var argv @[]int
	var r int = vm.CallFunc("test.f", argv)
	if r != 100 {
		return "phi swap loop should return b == 100 after one correct swap (a lost-copy bug returns 200)"
	}
	return ""
}
