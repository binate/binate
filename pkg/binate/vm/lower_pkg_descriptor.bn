package "pkg/binate/vm"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/std/strings"
import "pkg/stdx/containers/vec"

// Per-package bytecode reflect descriptor: the VM equivalent of
// codegen/emit_pkg_descriptor.bn and native/*/_pkg_descriptor.bn.  A
// package compiled to bytecode has no native `__Package` symbol, so without
// this its `__Package()` call falls through to the extern registry and fails
// ("extern not found: <pkg>.__Package").  Here the VM builds the immortal
// static-managed `reflect.Package` descriptor in its own runtime memory and
// synthesizes a leaf bytecode `__Package()` accessor that returns it.
//
// The descriptor's byte layout is NOT re-implemented here: it is built once
// by irdata.BuildPackageDescriptors (the single source of truth the LLVM and
// native backends also lower), and lowerDataGlobals lays the resulting term
// list into memory — the VM's runtime equivalent of the native EmitDataGlobal
// + linker fixups, so the three backends cannot drift on the layout.

// lowerDataGlobals lays a built irdata.DataGlobal list into immortal VM memory,
// resolving symrefs to runtime addresses (the runtime analog of the native
// assembler's symbol table + absolute relocations).  Two passes: pass 1
// allocates each block and records its name -> base address; pass 2 writes
// every term, turning a DT_SYMREF into the resolved (target base + addend)
// word.  Two passes are required because a term can reference a symbol whose
// block is allocated later in the list (the descriptor node, emitted last,
// points back at its tables).  Returns parallel name/addr slices so the
// caller can find a particular blob's address (e.g. the descriptor node).
//
// The blocks are never freed: like the native backend's static data they are
// package-lifetime immortal.  A node carrying a managed header gets its
// negative rt.STATIC_REFCOUNT sentinel from its own DataInt term, so every
// later RefInc/RefDec on it is a no-op rather than a heap free — no leak.
func lowerDataGlobals(dgs @[]@irdata.DataGlobal) (@[]@[]char, @[]int) {
	var namesV @vec.Vec[@[]char] = vec.New[@[]char]()
	var addrsV @vec.Vec[int] = vec.New[int]()
	for i := 0; i < len(dgs); i++ {
		var dg @irdata.DataGlobal = dgs[i]
		var sz int = dataGlobalByteLen(dg)
		if sz < 1 { sz = 1 }
		var p *uint8 = rt.RawAllocZero(sz)
		namesV.Push(dg.Name)
		addrsV.Push(bit_cast(int, p))
	}
	var names @[]@[]char = namesV.Items()
	var addrs @[]int = addrsV.Items()
	for i := 0; i < len(dgs); i++ {
		fillDataGlobal(dgs[i], addrs[i], names, addrs)
	}
	return names, addrs
}

// dataGlobalByteLen sums a DataGlobal's contiguous term widths: DT_INT /
// DT_ZERO carry an explicit Width, DT_BYTES is its byte count, and a DT_SYMREF
// is one target pointer.  Mirrors how emitDataTerm lays each term, so the
// allocated block is exactly the size the fill pass writes.
func dataGlobalByteLen(dg @irdata.DataGlobal) int {
	var n int = 0
	for i := 0; i < len(dg.Init); i++ {
		var t @irdata.DataTerm = dg.Init[i]
		switch t.Kind {
		case irdata.DT_INT:
			n = n + t.Width
		case irdata.DT_BYTES:
			n = n + len(t.Bytes)
		case irdata.DT_SYMREF:
			n = n + types.GetTarget().PointerSize
		default:
			n = n + t.Width
		}
	}
	return n
}

// fillDataGlobal writes dg's terms contiguously into its allocated block at
// `base`, resolving each DT_SYMREF via the (names, addrs) table — the runtime
// equivalent of emitDataTerm.  An empty-Sym symref lays a null word (an empty
// table slice's data pointer); DT_ZERO is left as the RawAllocZero zero-fill.
func fillDataGlobal(dg @irdata.DataGlobal, base int, names @[]@[]char, addrs @[]int) {
	var off int = 0
	for i := 0; i < len(dg.Init); i++ {
		var t @irdata.DataTerm = dg.Init[i]
		switch t.Kind {
		case irdata.DT_INT:
			writeLE(base + off, t.IntVal, t.Width)
			off = off + t.Width
		case irdata.DT_BYTES:
			var dst *uint8 = bit_cast(*uint8, base + off)
			for j := 0; j < len(t.Bytes); j++ {
				dst[j] = t.Bytes[j]
			}
			off = off + len(t.Bytes)
		case irdata.DT_SYMREF:
			var w int = types.GetTarget().PointerSize
			var val int = 0
			if len(t.Sym) > 0 {
				val = resolveSym(names, addrs, t.Sym) + t.Addend
			}
			writeLE(base + off, bit_cast(uint64, cast(int64, val)), w)
			off = off + w
		default:
			off = off + t.Width
		}
	}
	return
}

// writeLE stores `val`'s low `width` bytes little-endian at `addr`.  The
// target byte order is written explicitly rather than relying on the host's,
// so a descriptor laid on one host is read correctly per the target ABI.
func writeLE(addr int, val uint64, width int) {
	var p *uint8 = bit_cast(*uint8, addr)
	var v uint64 = val
	for i := 0; i < width; i++ {
		p[i] = cast(uint8, v & cast(uint64, 0xFF))
		v = v >> cast(uint64, 8)
	}
	return
}

// resolveSym returns the allocated base address recorded for `sym` during
// pass 1, or 0 if absent.  Linear scan: a descriptor's symbol set is tiny
// (a handful of blobs per package), so a hash would not pay for itself.
func resolveSym(names @[]@[]char, addrs @[]int, sym @[]char) int {
	for i := 0; i < len(names); i++ {
		if streq2(names[i], sym) { return addrs[i] }
	}
	return 0
}

// emitPackageDescriptorVM builds the just-lowered module m's immortal
// reflect.Package descriptor in VM memory and registers a bytecode
// __Package() accessor returning it.  The caller gates this on
// m.PackageAccessorSig (set only when reflect was loaded), matching the
// LLVM/native emitters' gate.
//
// The Functions table is populated (one reflect.FunctionInfo per
// `.bni`-exported / struct-dtor function + the self-listed __Package
// accessor), mirroring codegen's collectPackageFuncs.  Each entry's Value is
// lowered as a null word (an empty HandleSym) and then back-patched with the
// function's callable VM func-value handle (patchFuncValueHandles) — a
// bytecode function has no static `@__handle` symbol the descriptor could
// symref, so the handle (a runtime heap block) is resolved post-lowering.
//
// The Globals table is populated (one reflect.GlobalInfo per `.bni`-exported
// package-level global), with each Addr back-patched to the global's runtime
// storage cell (patchGlobalAddrs) — the VM analog of the native descriptor's
// `&<global>`.  The Vtables table is populated by Name (one per non-generic
// impl), but its Addr/ShimAddr are left null: a bytecode impl has no native
// `@__ivt`/`@__ivtshim` array — dispatch over its own interface values goes
// through vm.IfaceVtables by name — so there is no environment-equivalent
// address, and the Name is the portable reflective info.
func emitPackageDescriptorVM(vm @VM, m @ir.Module) {
	var pkgName @[]char = vm.modulePkgName
	var nameSym @[]char = mangle.GlobalName(pkgName, "_pkgname")
	var infoSym @[]char = mangle.GlobalName(pkgName, "_pkg_info")
	var funcsSym @[]char = mangle.GlobalName(pkgName, "_pkg_funcs")
	var globalsSym @[]char = mangle.GlobalName(pkgName, "_pkg_globals")
	var vtablesSym @[]char = mangle.GlobalName(pkgName, "_pkg_vtables")
	var satentriesSym @[]char = mangle.GlobalName(pkgName, "_pkg_satentries")

	var funcs @[]@irdata.PkgFuncEntry = gatherPackageFuncs(m, pkgName)
	var globals @[]@irdata.PkgGlobalEntry
	var gAddrs @[]int
	globals, gAddrs = gatherPackageGlobals(vm, m, pkgName)
	var vtables @[]@irdata.PkgVtableEntry = gatherPackageVtables(m, pkgName)
	// The bytecode backend lowers no native __satentry globals, so the SatEntries
	// table is empty for now (the VM's own-program satisfaction is a Phase-5
	// concern; cross-mode injected native packages carry their own descriptors).
	var noSatEntries @[]@[]char

	var dgs @[]@irdata.DataGlobal = irdata.BuildPackageDescriptors(
			rt.STATIC_REFCOUNT, infoSym, nameSym, buf.CopyStr(pkgName), funcsSym, funcs, globalsSym, globals,
			vtablesSym, vtables, satentriesSym, noSatEntries)

	var names @[]@[]char
	var addrs @[]int
	names, addrs = lowerDataGlobals(dgs)

	// The accessor returns the node's PAYLOAD pointer — past the 2-word
	// managed header — i.e. the @reflect.Package value (matching the native
	// accessor's `lea node; add hdr; ret`).  hdr = 2*IntSize assumes
	// PointerSize == IntSize, the same assumption BuildPackageDescriptor makes.
	var infoAddr int = resolveSym(names, addrs, infoSym)
	var hdr int = 2 * types.GetTarget().IntSize
	registerPackageAccessor(vm, infoAddr + hdr)

	// Fill each FunctionInfo.Value with the function's callable VM func-value
	// handle (now that the accessor — the __Package self-entry's target — is
	// registered too), and each GlobalInfo.Addr with the global's runtime cell.
	patchFuncValueHandles(vm, funcs, names, addrs)
	patchGlobalAddrs(globals, gAddrs, names, addrs)
	return
}

// gatherPackageFuncs builds the reflect.FunctionInfo rows for module m's
// descriptor: one per `.bni`-exported, non-extern function (plus own-package
// struct dtors, which are injectable when native-only) and — last — the
// compiler-synthesized __Package accessor itself, so a package is reflectable
// through its own table.  Mirrors codegen's collectPackageFuncs; each entry's
// HandleSym is EMPTY (the Value is back-patched with the runtime handle, since
// a bytecode function has no static handle symbol).
func gatherPackageFuncs(m @ir.Module, pkgName @[]char) @[]@irdata.PkgFuncEntry {
	var funcs @vec.Vec[@irdata.PkgFuncEntry] = vec.New[@irdata.PkgFuncEntry]()
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if f.IsExtern { continue }
		if !f.Exported && !f.IsStructDtor { continue }
		var fv @types.Type = funcValueTypeOf(f)
		if fv == nil { continue }
		funcs.Push(pkgFuncEntry(pkgName, f.Name, fv))
	}
	// Self-list __Package (the accessor is not in m.Funcs — it is
	// backend-synthesized).  Name is the FQ `<pkg>.__Package`; the func-value
	// type is the one IR-gen stashed for the backends to share.
	if m.PackageAccessorSig != nil {
		var nameP @[]char = mangle.QualifyName(pkgName, "__Package")
		funcs.Push(pkgFuncEntry(pkgName, nameP, m.PackageAccessorSig))
	}
	return funcs.Items()
}

// pkgFuncEntry builds one reflect.FunctionInfo row.  The node/name/sig symbols
// are unique transient keys (the VM has no linker — they only key the
// pass-local relocation table); HandleSym is empty so Value lowers to null and
// is back-patched.  RetbufSize / ParamSlots come from the same shared helpers
// the LLVM and native gathers use, so the row metadata is identical.
func pkgFuncEntry(pkgName @[]char, name @[]char, fv @types.Type) @irdata.PkgFuncEntry {
	var mangled @[]char = mangle.FuncName(pkgName, name)
	return irdata.NewPkgFuncEntry(catSym(mangled, "__fninfo"), catSym(mangled, "__fnname"),
			buf.CopyStr(name), catSym(mangled, "__fnsig"), buf.CopyStr(fv.SigString()), "",
			types.AggregateReturnSize(fv.Results), len(fv.Params))
}

// funcValueTypeOf synthesizes a TYP_FUNC_VALUE from a function's param/result
// signature (ir.Param and types.Param share a shape but are distinct nominal
// types, so the params are copied field-by-field).  Mirrors codegen's
// lookupFuncValueType.
func funcValueTypeOf(f @ir.Func) @types.Type {
	var params @vec.Vec[@types.Param] = vec.New[@types.Param]()
	for j := 0; j < len(f.Params); j++ {
		var p @types.Param = make(types.Param)
		p.Name = f.Params[j].Name
		p.Type = f.Params[j].Typ
		params.Push(p)
	}
	return types.MakeFuncValueType(params.Items(), f.Results)
}

// gatherPackageGlobals builds the reflect.GlobalInfo rows for module m's
// descriptor — one per `.bni`-exported, non-extern package-level global,
// mirroring codegen's collectPackageGlobals.  Each entry's StorageSym is EMPTY
// (Addr lowers null and is back-patched), and the parallel returned int is the
// global's RUNTIME storage address (materializeGlobals ran earlier in
// LowerModule, so lookupGlobalAddr resolves the bare name here).
func gatherPackageGlobals(vm @VM, m @ir.Module,
		pkgName @[]char) (@[]@irdata.PkgGlobalEntry, @[]int) {
	var globals @vec.Vec[@irdata.PkgGlobalEntry] = vec.New[@irdata.PkgGlobalEntry]()
	var gAddrs @vec.Vec[int] = vec.New[int]()
	for i := 0; i < len(m.Globals); i++ {
		var g @ir.Global = m.Globals[i]
		if g.IsExtern { continue }
		if !g.Exported { continue }
		var fqName @[]char = mangle.QualifyName(pkgName, g.Name)
		var glSym @[]char = mangle.GlobalName(pkgName, g.Name)
		globals.Push(
				irdata.NewPkgGlobalEntry(catSym(glSym, "__glinfo"), catSym(glSym, "__glname"), fqName, ""))
		gAddrs.Push(lookupGlobalAddr(vm, g.Name))
	}
	return globals.Items(), gAddrs.Items()
}

// gatherPackageVtables builds the reflect.VtableInfo rows for module m's
// descriptor — one per NON-generic impl (generic instantiations are excluded;
// mirroring codegen's collectPackageVtables and the native collectVtables*).
// The exclusion is SAFE — not a cross-mode gap — because a generic instantiation
// is re-lowered by whichever bytecode module boxes it: IR-gen calls ensureGeneric
// ImplInfo + ensureInstantiatedMethods at the boxing site, so the importer emits
// its OWN (row + monomorphized method bodies) and resolves the iface value through
// vm.IfaceVtables by name (findIfaceVtable), never through this descriptor.  A
// descriptor row would be redundant.  (The vm_exec_iface.bn "vtable not found"
// path is the defensive assert for a broken importer, not a reachable case; see
// conformance/regressions/xmode-generic-box-received-value.)
// Both symbol fields are EMPTY, so Addr/ShimAddr lower NULL: a bytecode impl has
// no native `@__ivt`/`@__ivtshim` array (its interface-value dispatch runs
// through vm.IfaceVtables by name), so there is no environment-equivalent
// address — only the (portable) mangled vtable Name is reflected.  SlotCount is
// still the real vtable extent (for reflection parity); it is inert for the shim
// range lookup, which only consults native-injected vtables (non-NULL Addr).
func gatherPackageVtables(m @ir.Module, pkgName @[]char) @[]@irdata.PkgVtableEntry {
	var vtables @vec.Vec[@irdata.PkgVtableEntry] = vec.New[@irdata.PkgVtableEntry]()
	for i := 0; i < len(m.Impls); i++ {
		var info @ir.ImplInfo = m.Impls[i]
		if info == nil { continue }
		if mangle.IsInstantiationName(info.RecvTypeName) { continue }
		var vtName @[]char = mangle.ImplVtableName(info.RecvPkg, info.RecvTypeName, info.IfacePkg,
				info.IfaceName)
		vtables.Push(
				irdata.NewPkgVtableEntry(catSym(vtName, "__vtinfo"), catSym(vtName, "__vtname"),
						buf.CopyStr(vtName), "", "", ir.IfaceFullVtableSize(m, info.IfacePkg, info.IfaceName)))
	}
	return vtables.Items()
}

// patchGlobalAddrs writes each GlobalInfo node's Addr word with the global's
// runtime storage address (gathered alongside the entry).  Addr sits at byte
// offset 4w — past the 2-word header and the Name {data,len} pair
// (buildGlobalInfoNode's term order).  An unresolved global (addr 0) keeps a
// null Addr.
func patchGlobalAddrs(globals @[]@irdata.PkgGlobalEntry, gAddrs @[]int, names @[]@[]char,
		addrs @[]int) {
	var w int = types.GetTarget().IntSize
	var psz int = types.GetTarget().PointerSize
	for i := 0; i < len(globals); i++ {
		if gAddrs[i] == 0 { continue }
		var nodeAddr int = resolveSym(names, addrs, globals[i].NodeSym)
		if nodeAddr == 0 { continue }
		writeLE(nodeAddr + 4 * w, bit_cast(uint64, cast(int64, gAddrs[i])), psz)
	}
	return
}

// patchFuncValueHandles writes each FunctionInfo node's Value word with the
// callable VM func-value handle of the function it describes.  The native
// descriptor symrefs a static `@__handle.<mangled>` block; the VM has no such
// symbol, so ensureHandle builds the function's runtime {vtable,data} handle
// (kept alive by the VMFunc, which lives for the VM's lifetime — so the
// immortal descriptor's raw Value pointer never dangles) and the handle's
// address is written into the node.  A function not lowered as a VM function
// (idx < 0) keeps a null Value.
//
// Value sits at byte offset 5w in the node — past the 2-word header, the Pkg
// symref, and the Name {data,len} pair (buildFuncInfoNode's term order).
func patchFuncValueHandles(vm @VM, funcs @[]@irdata.PkgFuncEntry, names @[]@[]char, addrs @[]int) {
	var w int = types.GetTarget().IntSize
	var psz int = types.GetTarget().PointerSize
	for i := 0; i < len(funcs); i++ {
		var e @irdata.PkgFuncEntry = funcs[i]
		var idx int = funcIndexLookup(vm, e.Name)
		if idx < 0 { continue }
		var callee @VMFunc = vm.Funcs.Get(idx)
		ensureHandle(vm, callee, idx)
		var nodeAddr int = resolveSym(names, addrs, e.NodeSym)
		if nodeAddr == 0 { continue }
		writeLE(nodeAddr + 5 * w, bit_cast(uint64, cast(int64, bit_cast(int, callee.Handle))), psz)
	}
	return
}

// catSym concatenates two name fragments into a fresh owned symbol — e.g.
// catSym(mangled, "__fninfo").
func catSym(a @[]char, b *[]readonly char) @[]char {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write(a)
	sb.Write(b)
	return buf.CopyStr(sb.String())
}

// registerPackageAccessor synthesizes and installs the bytecode __Package()
// accessor for the current module: a leaf VMFunc with no params and a single
// scalar (pointer) result that loads the immortal descriptor's payload address
// and returns it.  The returned @reflect.Package is static-managed, so the
// caller's end-of-statement RefDec sees the negative header and no-ops.
//
// Two instructions suffice — BC_LOAD_IMM bakes the runtime payload address
// (known now, since the VM lowers at runtime, exactly as global refs bake
// their storage address), then BC_RETURN returns it as a scalar.  Only
// register 0 is used (a pointer, never a 64-bit-scalar pair), so no slot
// remapping is needed and NumRegs is 1 on every host.
func registerPackageAccessor(vm @VM, payloadAddr int) {
	var vmf @VMFunc = make(VMFunc)
	vmf.Name = qualifyCallName(vm, "__Package")
	vmf.NumParams = 0
	vmf.NumParamSlots = 0
	vmf.NumResults = 1
	vmf.ResultSizes = make_slice(int, 1)
	vmf.ResultOffsets = make_slice(int, 1)
	vmf.ResultMultiWord = make_slice(bool, 1)
	vmf.ResultSizes[0] = types.GetTarget().PointerSize
	vmf.ResultOffsets[0] = 0
	vmf.ResultMultiWord[0] = false
	vmf.NumRegs = 1
	vmf.FrameSize = 0

	var code @[]BCInstr = make_slice(BCInstr, 2)
	var load BCInstr
	load.Op = BC_LOAD_IMM
	load.Dst = 0
	load.Imm = payloadAddr
	code[0] = load
	var ret BCInstr
	ret.Op = BC_RETURN
	ret.Dst = 0
	ret.Src1 = 0
	ret.Aux = 0
	code[1] = ret
	vmf.Code = code

	vmf.Names = make_slice(@[]char, 0)
	vmf.CallCache = make_slice(int, 0)
	vmf.Strings = vm.moduleStrings

	var newIdx int = vm.Funcs.Len()
	vm.Funcs.Push(vmf)
	funcIndexSet(vm, vmf.Name, newIdx)
	return
}
