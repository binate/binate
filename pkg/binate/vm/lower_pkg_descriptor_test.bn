package "pkg/binate/vm"

import "pkg/binate/buf"
import "pkg/binate/irdata"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/builtins/testing"
import "pkg/stdx/slices"

// readWordAt reads one host-int word at a raw address.  The unit tests run on
// the LP64 host, so a word is 8 bytes — matching what writeLE lays for an
// IntSize/PointerSize term here.
func readWordAt(addr int) int {
	var p *int = bit_cast(*int, addr)
	return p[0]
}

// TestLowerDataGlobalsRelocatesSymrefs exercises every DataTerm kind through
// the VM's runtime relocation lowerer: raw bytes, a sized integer, a symref
// resolved to another block's address, an empty (null) symref, and zero
// padding.  A later block referencing an earlier one pins the two-pass
// ordering (all addresses known before any term is filled).
func TestLowerDataGlobalsRelocatesSymrefs() testing.TestResult {
	var w int = types.GetTarget().PointerSize
	// Block A: the raw bytes "ABC".
	var dgA @irdata.DataGlobal = irdata.NewDataGlobal("A", irdata.DG_LOCAL, 1, true)
	var abc @[]uint8 = make_slice(uint8, 3)
	abc[0] = cast(uint8, 0x41)
	abc[1] = cast(uint8, 0x42)
	abc[2] = cast(uint8, 0x43)
	dgA.Init = slices.Append[@irdata.DataTerm](dgA.Init, irdata.DataBytes(abc))
	// Block B: int8 marker, symref->A, null symref, int4, zero(8).
	var dgB @irdata.DataGlobal = irdata.NewDataGlobal("B", irdata.DG_WEAK, w, true)
	dgB.Init = slices.Append[@irdata.DataTerm](dgB.Init,
			irdata.DataInt(8, cast(uint64, 0x1122334455667788)))
	dgB.Init = slices.Append[@irdata.DataTerm](dgB.Init, irdata.DataSymref("A", 0))
	dgB.Init = slices.Append[@irdata.DataTerm](dgB.Init, irdata.DataSymref("", 0))
	dgB.Init = slices.Append[@irdata.DataTerm](dgB.Init, irdata.DataInt(4, cast(uint64, 0xDEADBEEF)))
	dgB.Init = slices.Append[@irdata.DataTerm](dgB.Init, irdata.DataZero(8))

	var dgs @[]@irdata.DataGlobal = make_slice(@irdata.DataGlobal, 2)
	dgs[0] = dgA
	dgs[1] = dgB
	var addrs @[]int
	// vm owns the lowered blocks (freed at teardown); kept alive for the test.
	var vm @VM = newTestVM(1024)
	_, addrs = lowerDataGlobals(vm, dgs)

	var aAddr int = addrs[0]
	var bAddr int = addrs[1]
	var ap *uint8 = bit_cast(*uint8, aAddr)
	if cast(int, ap[0]) != 0x41 || cast(int, ap[1]) != 0x42 || cast(int, ap[2]) != 0x43 {
		return "block A bytes wrong"
	}
	var bw0 *uint64 = bit_cast(*uint64, bAddr)
	if bw0[0] != cast(uint64, 0x1122334455667788) {
		return "block B int64 term wrong"
	}
	if readWordAt(bAddr + 8) != aAddr {
		return "symref to A not relocated to A's address"
	}
	if readWordAt(bAddr + 8 + w) != 0 {
		return "empty symref should lay a null word"
	}
	var b4 *uint32 = bit_cast(*uint32, bAddr + 8 + 2 * w)
	if b4[0] != cast(uint32, 0xDEADBEEF) {
		return "int32 term wrong"
	}
	return ""
}

// TestLowerDataGlobalsAppliesSymrefAddend pins that a symref's addend is added
// to the resolved address — the convention the descriptor uses so a pointer-
// array entry / FunctionInfo.Pkg lands on a node's payload (node + header).
func TestLowerDataGlobalsAppliesSymrefAddend() testing.TestResult {
	var dgA @irdata.DataGlobal = irdata.NewDataGlobal("A", irdata.DG_LOCAL, 1, true)
	var bytes @[]uint8 = make_slice(uint8, 16)
	dgA.Init = slices.Append[@irdata.DataTerm](dgA.Init, irdata.DataBytes(bytes))
	var dgB @irdata.DataGlobal = irdata.NewDataGlobal("B", irdata.DG_WEAK, 8, true)
	dgB.Init = slices.Append[@irdata.DataTerm](dgB.Init, irdata.DataSymref("A", 8))

	var dgs @[]@irdata.DataGlobal = make_slice(@irdata.DataGlobal, 2)
	dgs[0] = dgA
	dgs[1] = dgB
	var addrs @[]int
	// vm owns the lowered blocks (freed at teardown); kept alive for the test.
	var vm @VM = newTestVM(1024)
	_, addrs = lowerDataGlobals(vm, dgs)
	if readWordAt(addrs[1]) != addrs[0] + 8 {
		return "symref addend not applied"
	}
	return ""
}

// TestEmitPackageDescriptorLayout builds a real (empty-table) package
// descriptor through irdata.BuildPackageDescriptors — the single source of truth —
// and lowers it, then reads back the in-memory image the bytecode __Package()
// accessor returns: the immortal-static header sentinel, the package Name
// (data relocated to the name bytes + correct length), and the {null,0} empty
// Functions table.  This pins that the VM lowering produces the reflect.Package
// layout the field-access path reads.
func TestEmitPackageDescriptorLayout() testing.TestResult {
	var pkgName @[]char = buf.CopyStr("pkg/demo")
	var infoSym @[]char = mangle.GlobalName(pkgName, "_pkg_info")
	var nameSym @[]char = mangle.GlobalName(pkgName, "_pkgname")
	var funcsSym @[]char = mangle.GlobalName(pkgName, "_pkg_funcs")
	var globalsSym @[]char = mangle.GlobalName(pkgName, "_pkg_globals")
	var vtablesSym @[]char = mangle.GlobalName(pkgName, "_pkg_vtables")
	var funcs @[]@irdata.PkgFuncEntry = make_slice(@irdata.PkgFuncEntry, 0)
	var globals @[]@irdata.PkgGlobalEntry = make_slice(@irdata.PkgGlobalEntry, 0)
	var vtables @[]@irdata.PkgVtableEntry = make_slice(@irdata.PkgVtableEntry, 0)

	var dgs @[]@irdata.DataGlobal = irdata.BuildPackageDescriptors(
			rt.STATIC_REFCOUNT, infoSym, nameSym, buf.CopyStr(pkgName), funcsSym, funcs, globalsSym, globals,
			vtablesSym, vtables, buf.CopyStr("_satentries"), make_slice(@[]char, 0))
	var names @[]@[]char
	var addrs @[]int
	// vm owns the lowered blocks (freed at teardown); kept alive for the test.
	var vm @VM = newTestVM(1024)
	names, addrs = lowerDataGlobals(vm, dgs)

	var infoAddr int = resolveSym(names, addrs, infoSym)
	if infoAddr == 0 { return "descriptor node not lowered" }
	var w int = types.GetTarget().IntSize
	if readWordAt(infoAddr) != rt.STATIC_REFCOUNT {
		return "header refcount is not the static sentinel"
	}
	if readWordAt(infoAddr + w) != 0 { return "header freefn not null" }

	// Payload: Name {data, len} at +2w (past the 2-word header).
	var nameData int = readWordAt(infoAddr + 2 * w)
	var nameLen int = readWordAt(infoAddr + 3 * w)
	if nameLen != len(pkgName) { return "Name.len wrong" }
	var np *uint8 = bit_cast(*uint8, nameData)
	for i := 0; i < len(pkgName); i++ {
		if cast(int, np[i]) != cast(int, pkgName[i]) {
			return "Name bytes mismatch"
		}
	}
	// Functions {data, len} at +4w is the empty slice {null, 0}.
	if readWordAt(infoAddr + 4 * w) != 0 {
		return "empty Functions table should have null data"
	}
	if readWordAt(infoAddr + 5 * w) != 0 {
		return "empty Functions table should have length 0"
	}
	return ""
}

// TestPatchFuncValueHandlesWritesCallableHandle pins the FULL-milestone
// back-patch: a FunctionInfo node's Value (lowered null, since a bytecode
// function has no static handle symbol) is overwritten with the function's
// callable VM func-value handle, at byte offset 5w (past the 2-word header +
// Pkg + Name{data,len}).  Uses registerTestExterns for the trampolines
// ensureHandle needs.
func TestPatchFuncValueHandlesWritesCallableHandle() testing.TestResult {
	var vmInst @VM = newTestVM(256 * 1024)
	registerTestExterns(vmInst)

	// A minimal scalar-returning VMFunc for the entry to describe + dispatch to.
	var f @VMFunc = make(VMFunc)
	f.Name = buf.CopyStr("test.foo")
	f.NumResults = 1
	f.ResultSizes = make_slice(int, 1)
	f.ResultOffsets = make_slice(int, 1)
	f.ResultMultiWord = make_slice(bool, 1)
	f.ResultSizes[0] = types.GetTarget().PointerSize
	f.NumRegs = 1
	f.Code = make_slice(BCInstr, 0)
	f.Names = make_slice(@[]char, 0)
	f.CallCache = make_slice(int, 0)
	var idx int = vmInst.Funcs.Len()
	vmInst.Funcs.Push(f)
	funcIndexSet(vmInst, f.Name, idx)

	// A one-entry Functions table for it (empty HandleSym -> null Value).
	var entry @irdata.PkgFuncEntry = irdata.NewPkgFuncEntry(
			buf.CopyStr("test.foo__fninfo"), buf.CopyStr("test.foo__fnname"), buf.CopyStr("test.foo"),
			buf.CopyStr("test.foo__fnsig"), buf.CopyStr("()()"), buf.CopyStr(""), 0, 0)
	var funcs @[]@irdata.PkgFuncEntry = make_slice(@irdata.PkgFuncEntry, 1)
	funcs[0] = entry
	var globals @[]@irdata.PkgGlobalEntry = make_slice(@irdata.PkgGlobalEntry, 0)
	var vtables @[]@irdata.PkgVtableEntry = make_slice(@irdata.PkgVtableEntry, 0)
	var dgs @[]@irdata.DataGlobal = irdata.BuildPackageDescriptors(
			rt.STATIC_REFCOUNT, buf.CopyStr("test._pkg_info"), buf.CopyStr("test._pkgname"),
			buf.CopyStr("test"), buf.CopyStr("test._pkg_funcs"), funcs, buf.CopyStr("test._pkg_globals"),
			globals, buf.CopyStr("test._pkg_vtables"), vtables, buf.CopyStr("_satentries"),
			make_slice(@[]char, 0))
	var names @[]@[]char
	var addrs @[]int
	// vm owns the lowered blocks (freed at teardown); kept alive for the test.
	var vm @VM = newTestVM(1024)
	names, addrs = lowerDataGlobals(vm, dgs)

	var w int = types.GetTarget().IntSize
	var nodeAddr int = resolveSym(names, addrs, buf.CopyStr("test.foo__fninfo"))
	if nodeAddr == 0 { return "func info node not lowered" }
	if readWordAt(nodeAddr + 5 * w) != 0 {
		return "Value should be null before back-patch"
	}
	patchFuncValueHandles(vmInst, funcs, names, addrs)
	if f.Handle == nil {
		return "ensureHandle should have built the func-value handle"
	}
	if readWordAt(nodeAddr + 5 * w) != bit_cast(int, f.Handle) {
		return "Value not back-patched to the callable handle address"
	}
	return ""
}

// TestPatchGlobalAddrsWritesStorageAddr pins the Globals-table back-patch: a
// GlobalInfo node's Addr (lowered null via an empty StorageSym) is overwritten
// with the global's runtime storage address, at byte offset 4w (past the 2-word
// header + Name{data,len}).
func TestPatchGlobalAddrsWritesStorageAddr() testing.TestResult {
	var entry @irdata.PkgGlobalEntry = irdata.NewPkgGlobalEntry(
			buf.CopyStr("g.G__glinfo"), buf.CopyStr("g.G__glname"), buf.CopyStr("demo.G"), buf.CopyStr(""))
	var globals @[]@irdata.PkgGlobalEntry = make_slice(@irdata.PkgGlobalEntry, 1)
	globals[0] = entry
	var gAddrs @[]int = make_slice(int, 1)
	// A fake storage address with bit 31 CLEAR so the constant fits a 32-bit
	// host `int` (0xCAFE0000 would not type-check on ILP32); any non-zero value
	// round-trips through the back-patch.
	gAddrs[0] = 0x7AFE0000
	var funcs @[]@irdata.PkgFuncEntry = make_slice(@irdata.PkgFuncEntry, 0)
	var vtables @[]@irdata.PkgVtableEntry = make_slice(@irdata.PkgVtableEntry, 0)
	var dgs @[]@irdata.DataGlobal = irdata.BuildPackageDescriptors(
			rt.STATIC_REFCOUNT, buf.CopyStr("demo._pkg_info"), buf.CopyStr("demo._pkgname"),
			buf.CopyStr("demo"), buf.CopyStr("demo._pkg_funcs"), funcs, buf.CopyStr("demo._pkg_globals"),
			globals, buf.CopyStr("demo._pkg_vtables"), vtables, buf.CopyStr("_satentries"),
			make_slice(@[]char, 0))
	var names @[]@[]char
	var addrs @[]int
	// vm owns the lowered blocks (freed at teardown); kept alive for the test.
	var vm @VM = newTestVM(1024)
	names, addrs = lowerDataGlobals(vm, dgs)

	var w int = types.GetTarget().IntSize
	var nodeAddr int = resolveSym(names, addrs, buf.CopyStr("g.G__glinfo"))
	if nodeAddr == 0 { return "global info node not lowered" }
	if readWordAt(nodeAddr + 4 * w) != 0 {
		return "Addr should be null before back-patch"
	}
	patchGlobalAddrs(globals, gAddrs, names, addrs)
	if readWordAt(nodeAddr + 4 * w) != 0x7AFE0000 {
		return "Addr not back-patched to the storage address"
	}
	return ""
}

// TestVtableInfoAddrsNullForBytecodeImpl pins that a bytecode package's
// VtableInfo carries its Name but NULL Addr/ShimAddr (offsets 4w/5w): a bytecode
// impl has no native @__ivt/@__ivtshim, so those addresses have no equivalent.
func TestVtableInfoAddrsNullForBytecodeImpl() testing.TestResult {
	var entry @irdata.PkgVtableEntry = irdata.NewPkgVtableEntry(
			buf.CopyStr("vt__vtinfo"), buf.CopyStr("vt__vtname"), buf.CopyStr("__ivt.bn_demo"),
			buf.CopyStr(""), buf.CopyStr(""), 3)
	var vtables @[]@irdata.PkgVtableEntry = make_slice(@irdata.PkgVtableEntry, 1)
	vtables[0] = entry
	var funcs @[]@irdata.PkgFuncEntry = make_slice(@irdata.PkgFuncEntry, 0)
	var globals @[]@irdata.PkgGlobalEntry = make_slice(@irdata.PkgGlobalEntry, 0)
	var dgs @[]@irdata.DataGlobal = irdata.BuildPackageDescriptors(
			rt.STATIC_REFCOUNT, buf.CopyStr("demo._pkg_info"), buf.CopyStr("demo._pkgname"),
			buf.CopyStr("demo"), buf.CopyStr("demo._pkg_funcs"), funcs, buf.CopyStr("demo._pkg_globals"),
			globals, buf.CopyStr("demo._pkg_vtables"), vtables, buf.CopyStr("_satentries"),
			make_slice(@[]char, 0))
	var names @[]@[]char
	var addrs @[]int
	// vm owns the lowered blocks (freed at teardown); kept alive for the test.
	var vm @VM = newTestVM(1024)
	names, addrs = lowerDataGlobals(vm, dgs)

	var w int = types.GetTarget().IntSize
	var nodeAddr int = resolveSym(names, addrs, buf.CopyStr("vt__vtinfo"))
	if nodeAddr == 0 { return "vtable info node not lowered" }
	// Name (data,len) at +2w/+3w is populated; Addr/ShimAddr at +4w/+5w null.
	if readWordAt(nodeAddr + 3 * w) != len("__ivt.bn_demo") {
		return "Vtable Name length wrong"
	}
	if readWordAt(nodeAddr + 4 * w) != 0 { return "Vtable Addr should be null" }
	if readWordAt(nodeAddr + 5 * w) != 0 {
		return "Vtable ShimAddr should be null"
	}
	// SlotCount at +6w is the real vtable extent even for a bytecode impl.
	if readWordAt(nodeAddr + 6 * w) != 3 {
		return "Vtable SlotCount should be 3"
	}
	return ""
}
