package "pkg/binate/vm"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the VM's register-slot assignment (assignSlots): values whose live
// ranges do not overlap share a slot, and the ranges cover loops, cleanup pads
// and the frame's entry.

var raNoParams @[]@ir.Param

var raNoResults @[]@types.Type

// raSlots assigns f's slots with no wide value.
func raSlots(f @ir.Func) (@[]int, int) {
	var wide @[]bool = make_slice(bool, f.NextID)
	return assignSlots(f, combinedBlocks(f), wide)
}

// A chain whose every value dies at the next instruction needs two slots: a
// value and the one computed from it never share (they meet at that
// instruction), but a value shares with the one two steps on.
func TestAssignSlotsChainSharesSlots() testing.TestResult {
	var f @ir.Func = ir.NewFunc("test", "f", raNoParams, raNoResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Instr = irbuild.EmitConstInt(b, 1, types.TypInt())
	var x @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, a, a, types.TypInt())
	var y @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, x, x, types.TypInt())
	var z @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, y, y, types.TypInt())
	var vals @[]@ir.Instr = make_slice(@ir.Instr, 1)
	vals[0] = z
	irbuild.EmitReturn(b, vals)
	var slotOf @[]int
	var n int
	slotOf, n = raSlots(f)
	if slotOf[a.ID] == slotOf[x.ID] || slotOf[x.ID] == slotOf[y.ID] || slotOf[y.ID] == slotOf[z.ID] {
		return "an operand and the result computed from it must not share a slot"
	}
	if slotOf[a.ID] != slotOf[y.ID] || slotOf[x.ID] != slotOf[z.ID] {
		return "values two steps apart should share a slot"
	}
	if n != 2 { return "expected 2 slots" }
	return ""
}

// The operands of an instruction that dies there and its result get three
// different slots.
func TestAssignSlotsResultNotOnOperand() testing.TestResult {
	var f @ir.Func = ir.NewFunc("test", "f", raNoParams, raNoResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Instr = irbuild.EmitConstInt(b, 1, types.TypInt())
	var c @ir.Instr = irbuild.EmitConstInt(b, 2, types.TypInt())
	var s @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_SUB, a, c, types.TypInt())
	var vals @[]@ir.Instr = make_slice(@ir.Instr, 1)
	vals[0] = s
	irbuild.EmitReturn(b, vals)
	var slotOf @[]int
	var n int
	slotOf, n = raSlots(f)
	if slotOf[s.ID] == slotOf[a.ID] || slotOf[s.ID] == slotOf[c.ID] || slotOf[a.ID] == slotOf[c.ID] {
		return "operands and result must have three different slots"
	}
	_ = n
	return ""
}

// A value defined before a loop and read inside it stays live around the loop:
// a value defined in the loop after that read must not take its slot, or the
// next iteration would read the wrong value.
func TestAssignSlotsLoopKeepsValueLive() testing.TestResult {
	var f @ir.Func = ir.NewFunc("test", "f", raNoParams, raNoResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var loop @ir.Block = ir.AddBlock(f, "loop")
	var exit @ir.Block = ir.AddBlock(f, "exit")
	var v @ir.Instr = irbuild.EmitConstInt(entry, 5, types.TypInt())
	irbuild.EmitJump(entry, loop)
	var u @ir.Instr = irbuild.EmitBinop(loop, iropcode.OP_ADD, v, v, types.TypInt())
	var w @ir.Instr = irbuild.EmitConstInt(loop, 9, types.TypInt())
	var cond @ir.Instr = irbuild.EmitBinop(loop, iropcode.OP_LT, w, u, types.TypBool())
	irbuild.EmitBranch(loop, cond, loop, exit)
	var noVals @[]@ir.Instr
	irbuild.EmitReturn(exit, noVals)
	var slotOf @[]int
	var n int
	slotOf, n = raSlots(f)
	if slotOf[w.ID] == slotOf[v.ID] {
		return "a value defined in the loop took the slot of a value the loop reads again"
	}
	_ = n
	return ""
}

// A value only a cleanup pad reads is live at the instruction the pad is attached
// to: the operands of that instruction, defined after the value, must not take
// its slot.
func TestAssignSlotsPadKeepsValueLive() testing.TestResult {
	var f @ir.Func = ir.NewFunc("test", "f", raNoParams, raNoResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var m @ir.Instr = irbuild.EmitConstInt(entry, 7, types.TypInt())
	var idx @ir.Instr = irbuild.EmitConstInt(entry, 0, types.TypInt())
	var ln @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	irbuild.EmitBoundsCheck(entry, idx, ln)
	var chk @ir.Instr = entry.Instrs[len(entry.Instrs) - 1]
	var noVals @[]@ir.Instr
	irbuild.EmitReturn(entry, noVals)
	var pad @ir.Block = ir.AddFaultPad(f, "fault_pad")
	var used @ir.Instr = irbuild.EmitBinop(pad, iropcode.OP_ADD, m, m, types.TypInt())
	irbuild.EmitUnwindReturn(pad)
	chk.PadBlock = pad
	var slotOf @[]int
	var n int
	slotOf, n = raSlots(f)
	if slotOf[m.ID] == slotOf[idx.ID] || slotOf[m.ID] == slotOf[ln.ID] {
		return "a value a pad reads shared a slot with a value defined before the pad's instruction"
	}
	if slotOf[used.ID] < 0 { return "the pad's own value should have a slot" }
	_ = n
	return ""
}

// The parameters keep the packed slots a call copies them into (a wide one takes
// two), and a value read before anything defines it — which must read the zero a
// fresh frame holds — shares no parameter's slot, even an unread parameter's.
func TestAssignSlotsParamsAndEntryReads() testing.TestResult {
	var params @[]@ir.Param = make_slice(@ir.Param, 3)
	for i := 0; i < 3; i++ { params[i] = make(ir.Param) }
	params[0].Name = "a"
	params[0].Typ = types.TypInt()
	params[1].Name = "b"
	params[1].Typ = types.TypInt64()
	params[2].Name = "c"
	params[2].Typ = types.TypInt()
	var f @ir.Func = ir.NewFunc("test", "f", params, raNoResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var undef @ir.Instr = ir.NewInstr(f, iropcode.OP_CONST_INT, types.TypInt())
	var r @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, undef, undef, types.TypInt())
	var vals @[]@ir.Instr = make_slice(@ir.Instr, 1)
	vals[0] = r
	irbuild.EmitReturn(entry, vals)
	var wide @[]bool = make_slice(bool, f.NextID)
	wide[f.Params[1].ID] = true
	var slotOf @[]int
	var n int
	slotOf, n = assignSlots(f, combinedBlocks(f), wide)
	if slotOf[f.Params[0].ID] != 0 || slotOf[f.Params[1].ID] != 1 || slotOf[f.Params[2].ID] != 3 {
		return "parameters must keep their packed slots 0, 1 (two slots) and 3"
	}
	if slotOf[undef.ID] < 4 {
		return "a value read before any definition must not share a parameter's slot"
	}
	_ = n
	return ""
}

// A wide value takes two consecutive slots, neither of them a slot of a value
// live beside it.
func TestAssignSlotsWideTakesTwoSlots() testing.TestResult {
	var f @ir.Func = ir.NewFunc("test", "f", raNoParams, raNoResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var nrw @ir.Instr = irbuild.EmitConstInt(b, 1, types.TypInt())
	var w @ir.Instr = irbuild.EmitConstInt64(b, cast(int64, 2), types.TypInt64())
	var s @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, nrw, nrw, types.TypInt())
	var t @ir.Instr = irbuild.EmitBinop(b, iropcode.OP_ADD, w, w, types.TypInt64())
	var vals @[]@ir.Instr = make_slice(@ir.Instr, 2)
	vals[0] = s
	vals[1] = t
	irbuild.EmitReturn(b, vals)
	var wide @[]bool = make_slice(bool, f.NextID)
	wide[w.ID] = true
	wide[t.ID] = true
	var slotOf @[]int
	var n int
	slotOf, n = assignSlots(f, combinedBlocks(f), wide)
	var ws int = slotOf[w.ID]
	if slotOf[nrw.ID] == ws || slotOf[nrw.ID] == ws + 1 {
		return "a narrow value live beside a wide one must not take either of its slots"
	}
	if n < ws + 2 { return "the slot count must cover the wide value's second slot" }
	return ""
}

// A long straight-line function needs few registers — each statement's values
// die within it — and still computes the right result.
func TestLowerLongFunctionFewRegisters() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\nfunc main() int {\n\tvar a int = 1\n")
	for i := 0; i < 40; i++ { src = concatStr(src, "\ta = (a * 3) % 1000 + 7\n") }
	src = concatStr(src, "\treturn a\n}\n")
	var vm @VM = lowerFromSource(src)
	var idx int = vm.LookupFunc("test.main")
	if vm.Funcs.Get(idx).NumRegs >= 24 {
		return "a 40-statement straight-line function should need under 24 registers"
	}
	var noArgs @[]int
	if execFunc(vm, idx, noArgs) != cast(int64, 601) { return "expected 601" }
	return ""
}

// A value a cleanup pad reads stays live up to every instruction the pad is attached
// to, not only the first: with one pad on two bounds checks, values defined between
// them must not take the slot of the value the pad reads.
func TestAssignSlotsSharedPadKeepsValueLiveToLastSite() testing.TestResult {
	var f @ir.Func = ir.NewFunc("test", "f", raNoParams, raNoResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var m @ir.Instr = irbuild.EmitConstInt(entry, 7, types.TypInt())
	var i0 @ir.Instr = irbuild.EmitConstInt(entry, 0, types.TypInt())
	var l0 @ir.Instr = irbuild.EmitConstInt(entry, 1, types.TypInt())
	irbuild.EmitBoundsCheck(entry, i0, l0)
	var chk1 @ir.Instr = entry.Instrs[len(entry.Instrs) - 1]
	var x @ir.Instr = irbuild.EmitConstInt(entry, 3, types.TypInt())
	var y @ir.Instr = irbuild.EmitBinop(entry, iropcode.OP_ADD, x, x, types.TypInt())
	irbuild.EmitBoundsCheck(entry, y, y)
	var chk2 @ir.Instr = entry.Instrs[len(entry.Instrs) - 1]
	var noVals @[]@ir.Instr
	irbuild.EmitReturn(entry, noVals)
	var pad @ir.Block = ir.AddFaultPad(f, "fault_pad")
	_ = irbuild.EmitBinop(pad, iropcode.OP_ADD, m, m, types.TypInt())
	irbuild.EmitUnwindReturn(pad)
	chk1.PadBlock = pad
	chk2.PadBlock = pad
	var slotOf @[]int
	var n int
	slotOf, n = raSlots(f)
	if slotOf[m.ID] == slotOf[x.ID] || slotOf[m.ID] == slotOf[y.ID] {
		return "a value a pad reads shared a slot with one defined before the pad's second fault op"
	}
	_ = n
	return ""
}
