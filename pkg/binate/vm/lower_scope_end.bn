package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/std/containers/vec"

// The VM gives every alloca a frame slot of its own, so the end of a scope's storage
// (OP_SCOPE_END) needs no bytecode: lowering drops the markers first rather than
// spend a dispatch on each scope exit.

// dropScopeEnds removes every OP_SCOPE_END from f's blocks and fault pads, leaving
// a block with none untouched.  Idempotent.
func dropScopeEnds(f @ir.Func) {
	dropBlocksScopeEnds(f.Blocks)
	dropBlocksScopeEnds(f.FaultPads)
}

// dropBlocksScopeEnds is dropScopeEnds over one list of blocks.
func dropBlocksScopeEnds(blocks *[]@ir.Block) {
	for i := 0; i < len(blocks); i++ {
		var b @ir.Block = blocks[i]
		if !hasScopeEnd(b) { continue }
		var kept @vec.Vec[@ir.Instr] = vec.New[@ir.Instr]()
		for j := 0; j < len(b.Instrs); j++ {
			if b.Instrs[j].Op != iropcode.OP_SCOPE_END { kept.Push(b.Instrs[j]) }
		}
		b.InstrsVec = kept
		b.Instrs = kept.Items()
	}
}

// hasScopeEnd reports whether b holds an OP_SCOPE_END.
func hasScopeEnd(b @ir.Block) bool {
	for j := 0; j < len(b.Instrs); j++ {
		if b.Instrs[j].Op == iropcode.OP_SCOPE_END { return true }
	}
	return false
}
