package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/irbuild"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// scopeEndFunc returns a void function whose entry holds an int alloca in scope 1,
// then (when ended) the end of scope 1, then a return.
func scopeEndFunc(ended bool) @ir.Func {
	var f @ir.Func = ir.NewFunc("", "main.scoped", make_slice(@ir.Param, 0),
			make_slice(@types.Type, 0))
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var a @ir.Instr = irbuild.EmitAlloc(entry, types.TypInt())
	a.Scope = irbuild.NewScope(f)
	if ended { irbuild.EmitScopeEnd(entry, a.Scope) }
	var noArgs @[]@ir.Instr
	irbuild.EmitReturn(entry, noArgs)
	return f
}

// dropScopeEnds removes a block's scope ends and a fault pad's, keeping the rest in
// order; a second run changes nothing.
func TestDropScopeEnds() testing.TestResult {
	var f @ir.Func = scopeEndFunc(true)
	var pad @ir.Block = ir.AddFaultPad(f, "pad")
	irbuild.EmitScopeEnd(pad, 1)
	irbuild.EmitUnwindReturn(pad)
	dropScopeEnds(f)
	var e @ir.Block = f.Blocks[0]
	if len(e.Instrs) != 2 || e.Instrs[0].Op != iropcode.OP_ALLOC ||
			e.Instrs[1].Op != iropcode.OP_RETURN {
		return "the entry keeps its alloca and its return, in order, without the scope end"
	}
	if len(pad.Instrs) != 1 || pad.Instrs[0].Op != iropcode.OP_UNWIND_RETURN {
		return "the fault pad loses its scope end"
	}
	if e.InstrsVec.Len() != 2 { return "InstrsVec stays in step with Instrs" }
	dropScopeEnds(f)
	if len(e.Instrs) != 2 || len(pad.Instrs) != 1 { return "a second run changes nothing" }
	return ""
}

// A function with a scope end lowers to the same bytecode as one without.
func TestLowerFuncScopeEndEmitsNothing() testing.TestResult {
	var ended @VMFunc = lowerFunc(newTestVM(1024), scopeEndFunc(true), testValues())
	var plain @VMFunc = lowerFunc(newTestVM(1024), scopeEndFunc(false), testValues())
	if len(ended.Code) != len(plain.Code) { return "a scope end must add no bytecode" }
	for i := 0; i < len(ended.Code); i++ {
		if ended.Code[i].Op != plain.Code[i].Op { return "a scope end must not change the bytecode" }
	}
	return ""
}

// The frame check plans the frame lowering will build, so it drops the scope ends
// first too.
func TestFuncFrameBytesDropsScopeEnds() testing.TestResult {
	var f @ir.Func = scopeEndFunc(true)
	_ = funcFrameBytes(newTestVM(1024), f, testValues())
	var b @ir.Block = f.Blocks[0]
	for i := 0; i < len(b.Instrs); i++ {
		if b.Instrs[i].Op == iropcode.OP_SCOPE_END { return "funcFrameBytes must drop the scope end" }
	}
	return ""
}
