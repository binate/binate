package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/iropt"
import "pkg/binate/mangle"

// LowerOneFuncShadow lowers a single IR function to a VMFunc and
// always APPENDS it to vm.Funcs (never replaces, even when a
// VMFunc with the same qualified name already exists).  REPL
// entry point for Tier 4 shadow: incompatible-signature
// redefinition keeps the OLD VMFunc reachable at its existing
// idx for any caller whose CallCache already resolved that
// callee — those callers continue calling the old shape.
//
// The funcIndex is updated to point at the NEW (later) idx, so
// fresh lowerings (eager-fill at lowering time) resolve to the
// new VMFunc.  Old callers, whose CallCache was eager-filled at
// THEIR lowering time, hold the OLD idx and stay routed to the
// old VMFunc — exactly the shadow semantic.
//
// Preconditions match LowerOneFunc.  Returns the new VMFunc, or
// nil if `f` is extern.
func (vm @VM) LowerOneFuncShadow(m @ir.Module, f @ir.Func) @VMFunc {
	if f.IsExtern { return nil }
	setShadowContext(vm, m)
	var vmf @VMFunc = installShadow(vm, f)
	eagerFillCallCache(vm, vmf)
	return vmf
}

// LowerFuncsShadow shadow-lowers fs (LowerOneFuncShadow) as one group: every
// function is installed, and its name re-pointed at it, before any of their
// call caches is filled, so a call from one to another reaches the new one,
// not the definition it shadows.
func (vm @VM) LowerFuncsShadow(m @ir.Module, fs *[]@ir.Func) {
	setShadowContext(vm, m)
	var installed @[]@VMFunc = make_slice(@VMFunc, len(fs))
	for i := 0; i < len(fs); i++ {
		if !fs[i].IsExtern { installed[i] = installShadow(vm, fs[i]) }
	}
	for i := 0; i < len(installed); i++ {
		if installed[i] != nil { eagerFillCallCache(vm, installed[i]) }
	}
}

// setShadowContext prepares a shadow lowering of functions of m: its strings
// collected and its module context re-established, so a stale modulePkgName
// left by a prior LowerModule of a DIFFERENT package (the REPL mid-session-
// import path: LowerModule(importedPkg) then LowerOneFunc*(mainMod)) doesn't
// mis-qualify their bare same-package call targets.
func setShadowContext(vm @VM, m @ir.Module) {
	m.FinalizeStrings()
	vm.modulePkgName = mangle.PkgPathFromQuoted(m.Name)
	vm.moduleStrings = materializeModuleStrings(m.Strings)
	vm.curStrings = m.Strings
}

// installShadow lowers f (with the per-function passes, as in LowerOneFunc),
// appends it to vm.Funcs and re-points its name at it; the old idx stays in
// vm.Funcs as a callable shadowed entry.  Its call cache is not filled.
func installShadow(vm @VM, f @ir.Func) @VMFunc {
	iropt.RunOptConfigFunc(f, vm.Opt)
	var vmf @VMFunc = lowerFunc(vm, f)
	var newIdx int = vm.Funcs.Len()
	vm.Funcs.Push(vmf)
	funcIndexSet(vm, vmf.Name, newIdx)
	return vmf
}
