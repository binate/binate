package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/iropt"
import "pkg/binate/mangle"

// LowerFuncsShadow lowers fs to VMFuncs as one group of shadowing definitions:
// each is APPENDED to vm.Funcs (never replacing a VMFunc of the same qualified
// name) and its name re-pointed at it, and only then are their call caches
// filled, so a call from one to another reaches the new one, not the
// definition it shadows.  The old VMFunc keeps its index, so a caller whose
// CallCache was eager-filled at its own lowering keeps calling the old shape,
// while one lowered afterwards resolves to the new one: the REPL's shadowing
// redefinition.  An extern in fs is skipped; the preconditions are
// LowerOneFunc's.
func (vm @VM) LowerFuncsShadow(m @ir.Module, fs *[]@ir.Func) {
	setShadowContext(vm, m)
	var installed @[]@VMFunc = make_slice(@VMFunc, len(fs))
	for i := 0; i < len(fs); i++ {
		if !fs[i].IsExtern { installed[i] = installShadow(vm, fs[i]) }
	}
	for i := 0; i < len(installed); i++ {
		if installed[i] != nil { eagerFillCallCache(vm, installed[i]) }
	}
}

// setShadowContext prepares a shadow lowering of functions of m: its strings
// collected and its module context re-established, so a stale modulePkgName
// left by a prior LowerModule of a DIFFERENT package (the REPL mid-session-
// import path: LowerModule(importedPkg) then LowerOneFunc*(mainMod)) doesn't
// mis-qualify their bare same-package call targets.
func setShadowContext(vm @VM, m @ir.Module) {
	m.FinalizeStrings()
	vm.modulePkgName = mangle.PkgPathFromQuoted(m.Name)
	vm.moduleStrings = materializeModuleStrings(m.Strings)
	vm.curStrings = m.Strings
}

// installShadow lowers f (with the per-function passes, as in LowerOneFunc),
// appends it to vm.Funcs and re-points its name at it; the old idx stays in
// vm.Funcs as a callable shadowed entry.  Its call cache is not filled.
func installShadow(vm @VM, f @ir.Func) @VMFunc {
	iropt.RunOptConfigFunc(f, vm.Opt)
	var vmf @VMFunc = lowerFunc(vm, f)
	failOnLowerErrs(vm)
	var newIdx int = vm.Funcs.Len()
	vm.Funcs.Push(vmf)
	funcIndexSet(vm, vmf.Name, newIdx)
	return vmf
}

// RenameFunc renames the function name to newName (see vm.bni): its VMFunc
// takes the new name, which the function index's key borrows, as for any other.
// The old name's key, which borrows the VMFunc's old Name, is removed BEFORE the
// assignment frees that Name (func_index.bn).
func (vm @VM) RenameFunc(name *[]readonly char, newName *[]readonly char) bool {
	var idx int = funcIndexLookup(vm, qualifyCallName(vm, name))
	var newQual @[]char = qualifyCallName(vm, newName)
	if idx < 0 || funcIndexLookup(vm, newQual) >= 0 { return false }
	var f @VMFunc = vm.Funcs.Get(idx)
	if !vm.FuncIndex.Remove(f.Name) {
		panic("internal error: a function's index key is not its name (compiler bug)")
	}
	f.Name = newQual
	funcIndexSet(vm, f.Name, idx)
	return true
}
