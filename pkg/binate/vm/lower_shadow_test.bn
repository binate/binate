package "pkg/binate/vm"

import "pkg/binate/ast"
import "pkg/binate/check"
import "pkg/binate/ir"
import "pkg/binate/irgen"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for lower_shadow.bn.  newTestVM / registerTestExterns live in
// extern_test_helpers_test.bn, toBytes in vm_test.bn.

// replRedef checks and IR-gens declaration src as a REPL redefinition in m and
// returns the function it generated.
func replRedef(c @check.Checker, m @ir.Module, src *[]readonly char) @ir.Func {
	var p @parser.Parser = parser.New(toBytes(src), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) != 0 || len(irgen.GenDecl(d, irgen.NewGenCtx(m))) > 0 { return nil }
	return m.Funcs[len(m.Funcs) - 1]
}

// Functions shadowed as one group call each other's new definitions: the new a
// calls the new b, though a is lowered first.
func TestLowerFuncsShadowBindsGroup() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc b() int { return 1 }\n"
			"func a() int { return b() }\nfunc main() int { return 0 }\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	var m @ir.Module = irgen.GenModule(c, file)
	var vm @VM = newTestVM(testVMStackSize)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var oldA int = vm.LookupFunc("test.a")
	var group @[]@ir.Func = make_slice(@ir.Func, 2)
	group[0] = replRedef(c, m, "func a() int { return b() + 10 }")
	group[1] = replRedef(c, m, "func b() int { return 2 }")
	if group[0] == nil || group[1] == nil { return "the redefinitions must check and generate" }
	vm.LowerFuncsShadow(m, group)
	var noArgs @[]int
	if vm.CallFunc("test.a", noArgs) != 12 { return "the new a must call the new b" }
	if vm.LookupFunc("test.a") == oldA { return "a must be re-pointed at its new definition" }
	return ""
}
