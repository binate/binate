package "pkg/binate/vm"

import "pkg/binate/vmdata"

import "pkg/binate/ir"
import "pkg/binate/native/common"
import "pkg/binate/types"
import "pkg/std/containers/vec"

// Register slots of the bytecode VM.  A VM register slot is one host
// word (REG_SLOT bytes).  A 64-bit scalar value that does not fit one
// slot — i.e. on a host whose word is smaller than 8 bytes — occupies a
// pair of consecutive slots (assignSlots gives it two).

// is64BitScalar reports whether a register holding a value of type t
// needs 64 bits — t is a 64-bit scalar (int64 / uint64 / float64).
// A pointer, a narrower integer, host-width `int` (32-bit on a 32-bit
// target), and float32 all fit one host-word slot, so they are not
// wide.  Aggregates never live in a register directly (a register
// holds a pointer to them), so they are not considered here.
func is64BitScalar(t @types.Type) bool {
	if t == nil { return false }
	// StripWrappers (alias + readonly + named), not a named-only peel:
	// a `readonly float64` / alias-of-int64 is still a 64-bit scalar and must
	// ride a register pair on ILP32.  Peeling only NAMED left the outer
	// TYP_READONLY visible, so this reported false and the value was mis-sized to
	// one slot everywhere it flows (load / store / arg / capture / cast).
	// is64BitScalarReturn already strips wrappers at its call site.
	t = types.StripWrappers(t)
	if t.Kind == types.TYP_INT && t.Width == 64 { return true }
	if t.Kind == types.TYP_FLOAT && t.Width == 64 { return true }
	// Untyped float literals default to float64 — IR-gen emits them
	// with Typ = TypUntypedFloat (no Width set), so a plain
	// Kind+Width check misses them.  Treat them as 64-bit so the
	// slot allocator reserves a pair (and lowering emits the pair-
	// aware BC_LOAD_IMM64).  Untyped int is NOT included here:
	// untyped int defaults to host-`int`, which is 32-bit on a 32-bit
	// target — not pair-wide.
	if t.Kind == types.TYP_UNTYPED_FLOAT { return true }
	return false
}

// splitInt64 splits a 64-bit value into its low and high 32-bit
// halves, each returned as a host `int` bit pattern (a half with its
// bit 31 set reads back as a negative int32 on a 32-bit host — that
// is fine, joinInt64 reinterprets via uint32).  A 64-bit value lives
// in a VM register pair (base slot = low, base+1 = high) on a host
// whose word is < 8 bytes; this packs a constant into that pair.
func splitInt64(v int64) (int, int) {
	var lo int = cast(int, v & cast(int64, 0xFFFFFFFF))
	var hi int = cast(int, (v >> cast(int64, 32)) & cast(int64, 0xFFFFFFFF))
	return lo, hi
}

// joinInt64 reassembles a 64-bit value from its low/high 32-bit
// halves.  Each half is zero-extended through uint32 first, so a
// high-bit-set low half does not sign-pollute the upper 32 bits — the
// subtle step that, if dropped, silently corrupts 64-bit values only
// on a 32-bit host.
func joinInt64(lo int, hi int) int64 {
	return cast(int64, cast(uint32, lo)) | (cast(int64, cast(uint32, hi)) << cast(int64, 32))
}

// argSlots returns the number of register slots a value of type t
// occupies when packed into the call-arg region (or, equivalently,
// the number of slots a same-typed param occupies in the callee's
// register file): 2 for a 64-bit scalar on a host whose word is <
// 8 bytes, 1 otherwise.  Used both for sizing the call-arg region
// and for packed-arg ↔ packed-slot accounting in BC_CALL.
func argSlots(t @types.Type) int {
	if is64BitScalar(t) && REG_SLOT < 8 {
		return 2
	}
	return 1
}

// buildArgIfaceLayout computes the per-call-site ARGUMENT interface-vtable layout
// for a call's args `args[start:]` and, when non-empty, appends it to the
// function-in-progress accumulator (vm.curArgIfaceLayouts), returning its 1-based
// index (0 = the call passes no interface value, so no substitution is needed).
// `start` is 0 for a direct/extern call (whose Args are all user args) and 1 for
// the func-value / iface-method forms whose Args[0] is the callee / receiver
// (read from its own register, not packed).  For each packed arg SLOT whose type
// carries an interface value — top-level OR nested in a by-value struct / array
// (ifaceVtOffsetsFor non-empty) — it records the slot, the copy byte size, and
// the vtable-word offset list.  The slot accounting mirrors the emitter's
// (argSlots).  Every interface-carrying arg is recorded regardless of slot: the
// cross-mode dispatch buffer (64 slots) bounds how many the call can actually pack,
// enforced at dispatch time (a `n + 1 > len(callArgs)` panic), NOT by dropping layout
// entries here — dropping one would silently skip substitution for that interface
// arg.  (A flat per-slot bitmap would not do: it could mark WHICH top-level slots
// were interfaces but not the nested field offsets a by-value aggregate arg needs.)
func buildArgIfaceLayout(vm @VM, args @[]@ir.Instr, start int) int {
	var entries @vec.Vec[@vmdata.ArgSlotIfaceLayout] = vec.New[@vmdata.ArgSlotIfaceLayout]()
	var sliceSlots @vec.Vec[int] = vec.New[int]()
	var slot int = 0
	for k := start; k < len(args); k++ {
		var t @types.Type = args[k].Typ
		var offsets @[]int = ifaceVtOffsetsFor(t)
		if len(offsets) > 0 {
			var e @vmdata.ArgSlotIfaceLayout = make(vmdata.ArgSlotIfaceLayout)
			e.Slot = slot
			e.ByteSize = t.SizeOf()
			e.Offsets = offsets
			entries.Push(e)
		}
		// A `*[]*any` (raw slice of raw interface) needs its ELEMENTS' vtable words
		// translated at cross-mode dispatch (substituteSliceIfaceArgs); record the slot.
		if argIsSliceOfRawIface(t) {
			sliceSlots.Push(slot)
		}
		slot = slot + argSlots(t)
	}
	if entries.Len() == 0 && sliceSlots.Len() == 0 {
		return 0
	}
	var layout @vmdata.ArgIfaceLayout = make(vmdata.ArgIfaceLayout)
	layout.Slots = entries.Items()
	layout.SliceIfaceSlots = sliceSlots.Items()
	vm.curArgIfaceLayouts.Push(layout)
	var idx int = vm.curArgIfaceLayouts.Len()
	if idx > ARG_IFACE_LAYOUT_MASK {
		// The 1-based index rides a bounded free bit field of the call instruction
		// (ARG_IFACE_LAYOUT_MASK wide).  A function with more distinct interface-arg
		// call sites than that is beyond any realistic input — fail loudly rather
		// than silently truncate the index and mis-resolve the layout.
		vmPanic("vm: too many cross-mode interface-arg call sites in one function")
	}
	return idx
}

// argIsSliceOfRawIface reports whether a call argument of type t is a RAW slice
// (`*[]T`) whose element is a RAW interface value (`*I`/`*any`, TYP_INTERFACE_
// VALUE) — the shape a `...*any` / `...*I` variadic packs (func.variadic.pack: an
// ordinary 2-word raw slice).  A bytecode-boxed element carries a VM-index vtable
// word an injected-native callee cannot dereference, and the per-arg-slot arg-iface
// layout (buildArgIfaceLayout → substArgSlotIface) never reaches values
// NESTED in a slice — so a cross-mode extern dispatch records these slots
// in the call's ArgIfaceLayout (SliceIfaceSlots) and translates each element via
// substituteSliceIfaceArgs.  Peels alias / named wrappers on both the slice and its
// element.  A slice
// of MANAGED interface elements (`*[]@I`) is deliberately NOT matched — its
// element stride differs and no current variadic produces it; that stays an
// untranslated gap rather than a mis-strided walk.
func argIsSliceOfRawIface(t @types.Type) bool {
	if t == nil {
		return false
	}
	t = t.ResolveAlias()
	if t == nil {
		return false
	}
	if t.Kind == types.TYP_NAMED && t.Underlying != nil {
		t = t.Underlying
	}
	if t.Kind != types.TYP_SLICE {
		return false
	}
	var elem @types.Type = t.SliceElem()
	if elem == nil {
		return false
	}
	elem = elem.ResolveAlias()
	if elem == nil {
		return false
	}
	if elem.Kind == types.TYP_NAMED && elem.Underlying != nil {
		elem = elem.Underlying
	}
	return elem.Kind == types.TYP_INTERFACE_VALUE
}

// subWordReturnInfo returns (width, signed) for a CROSS-MODE call's scalar return
// that must be canonicalized, or (0, false) if none is needed.  A native function
// returning a bool / sub-word integer leaves the bits above its width UNDEFINED in
// the return register (garbage on x86-64 System V; arm64 happens to clear them),
// and the VM reads the shim's return as a full i64 (rt._call_shim_scalar) — so a
// `bool` / `int8` / `int16` / `int32` (and unsigned/char) result carries garbage
// upper bits, and a DIRECT use (`!b`, a comparison) misreads it while a typed
// store happens to canonicalize it (the store narrows).  Full-word / float /
// pointer / aggregate / void returns need no fixup (width 0).
func subWordReturnInfo(t @types.Type) (int, bool) {
	if t == nil { return 0, false }
	// A bool's canonical form is 0/1 in the low byte (native SETcc), so mask to
	// 8 bits.  The sub-word INTEGER case is the shared classifier the native
	// backends already use (common.SubWordNarrow), reused here so the two cannot
	// drift; it returns 0 for full-word / float / pointer / aggregate types.
	var s @types.Type = types.StripWrappers(t)
	if s != nil && s.Kind == types.TYP_BOOL { return 8, false }
	return common.SubWordNarrow(t, REG_SLOT * 8)
}

// regWidths builds the per-value wide-flags for func f's value ids
// [0, numRegs).  A value is wide when it is a 64-bit scalar AND the host
// word (wordSize bytes) cannot hold it in one slot: assignSlots then gives
// it two consecutive slots.  Params and instruction results — in the body
// and in the cleanup pads — carry the value type.  Returns all-false when
// wordSize >= 8 (a 64-bit host needs no pairs — int64 fits one slot).
func regWidths(f @ir.Func, numRegs int, wordSize int) @[]bool {
	var wide @[]bool = make_slice(bool, numRegs)
	if wordSize >= 8 {
		return wide
	}
	for i := 0; i < len(f.Params); i++ {
		var p @ir.Param = f.Params[i]
		if p.ID >= 0 && p.ID < numRegs && is64BitScalar(p.Typ) {
			wide[p.ID] = true
		}
	}
	var blocks @[]@ir.Block = combinedBlocks(f)
	for b := 0; b < len(blocks); b++ {
		var blk @ir.Block = blocks[b]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.ID >= 0 && ins.ID < numRegs && is64BitScalar(ins.Typ) {
				wide[ins.ID] = true
			}
		}
	}
	return wide
}
