package "pkg/binate/vm"

import "pkg/binate/irbuild"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

var swParams @[]@ir.Param

var swResults @[]@types.Type

func TestIs64BitScalarIntAndFloat() testing.TestResult {
	if !is64BitScalar(types.TypInt64()) { return "int64 is 64-bit" }
	if !is64BitScalar(types.TypUint64()) { return "uint64 is 64-bit" }
	if !is64BitScalar(types.TypFloat64()) { return "float64 is 64-bit" }
	return ""
}

// int32 / uint32 / float32 / pointers fit one host-word slot.
func TestIs64BitScalarNarrowTypes() testing.TestResult {
	if is64BitScalar(types.TypInt32()) { return "int32 is not 64-bit" }
	if is64BitScalar(types.TypUint32()) { return "uint32 is not 64-bit" }
	if is64BitScalar(types.TypFloat32()) { return "float32 is not 64-bit" }
	if is64BitScalar(nil) { return "nil is not 64-bit" }
	return ""
}

// ifaceVtOffsetsFor drives the cross-mode argument iface-vtable layout: it must
// yield exactly the one vtable-word offset for a top-level interface value (raw
// `*I` or managed `@I`), NOTHING for a scalar / nil, and — the case the removed
// flat top-level bitmap could never reach — the nested word offset for a by-VALUE
// struct carrying an interface field (an aggregate arg is not itself an iface
// value, so a top-level classifier saw zero words to substitute).
func TestIfaceVtOffsetsForArgClassification() testing.TestResult {
	var iface @types.Type = types.MakeInterfaceType("pkg/std/errors", "Error")
	var rawOff @[]int = ifaceVtOffsetsFor(types.MakeInterfaceValueType(iface))
	if len(rawOff) != 1 || rawOff[0] != types.IfaceValueVtableIndex() * REG_SLOT {
		return "raw *Iface must yield one vtable-word offset"
	}
	var mgOff @[]int = ifaceVtOffsetsFor(types.MakeManagedInterfaceValueType(iface))
	if len(mgOff) != 1 || mgOff[0] != types.IfaceValueVtableIndex() * REG_SLOT {
		return "managed @Iface must yield one vtable-word offset"
	}
	if len(ifaceVtOffsetsFor(types.TypInt64())) != 0 { return "int64 carries no iface word" }
	if len(ifaceVtOffsetsFor(types.TypInt32())) != 0 { return "int32 carries no iface word" }
	if len(ifaceVtOffsetsFor(nil)) != 0 { return "nil carries no iface word" }
	// A by-VALUE struct { n int; f @Iface }: the iface field's vtable word sits at
	// f's FieldOffset (one word past n) + the in-iface vtable-word offset.
	var fn @types.Field = make(types.Field)
	fn.Name = "n"
	fn.Type = types.TypInt()
	var ff @types.Field = make(types.Field)
	ff.Name = "f"
	ff.Type = types.MakeManagedInterfaceValueType(iface)
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = fn
	fields[1] = ff
	var stOff @[]int = ifaceVtOffsetsFor(types.MakeStructType("Nested", fields))
	if len(stOff) != 1 {
		return "a struct with one iface field must yield one nested vtable-word offset"
	}
	if stOff[0] != REG_SLOT + types.IfaceValueVtableIndex() * REG_SLOT {
		return "nested iface vtable word must be at f's FieldOffset + the in-iface word offset"
	}
	return ""
}

// split/join round-trips across the tricky cases: a high-bit-set low
// half (must not sign-pollute the high word), negative values, and the
// int64 extremes.  Validates the pair bit-math on any host.
func TestSplitJoinInt64RoundTrip() testing.TestResult {
	var cases @[]int64 = make_slice(int64, 7)
	cases[0] = cast(int64, 0)
	cases[1] = cast(int64, 1)
	cases[2] = cast(int64, -1) // 0xFFFFFFFFFFFFFFFF
	cases[3] = cast(int64, 0xFFFFFFFF) // low half all ones, high 0
	cases[4] = cast(int64, 1) << cast(int64, 40) // only a high-word bit
	cases[5] = cast(int64, 9223372036854775807) // int64-max
	cases[6] = cast(int64, -9223372036854775807) - cast(int64, 1) // int64-min
	for i := 0; i < len(cases); i++ {
		var lo int
		var hi int
		lo, hi = splitInt64(cases[i])
		if joinInt64(lo, hi) != cases[i] {
			return "split/join round-trip failed"
		}
	}
	return ""
}

// The low half's bit 31 must NOT leak into the high word on rejoin.
func TestJoinInt64ZeroExtendsLowHalf() testing.TestResult {
	// lo = 0x80000000 (bit 31 set), hi = 0 → value is 0x0000000080000000,
	// NOT 0xFFFFFFFF80000000.
	var lo int
	var hi int
	lo, hi = splitInt64(cast(int64, 0x80000000))
	if joinInt64(lo, hi) != cast(int64, 0x80000000) {
		return "low half bit 31 sign-polluted the high word"
	}
	return ""
}

// regWidths flags the int64 value's register wide and the int32 one
// narrow (wordSize=4 forces the 32-bit path on any host).
func TestRegWidthsFlagsWideValues() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", swParams, swResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var w @ir.Instr = irbuild.EmitConstInt64(b, cast(int64, 5), types.TypInt64())
	var nrw @ir.Instr = irbuild.EmitConstInt(b, 5, types.TypInt32())
	var wide @[]bool = regWidths(f, f.NextID, 4)
	if !wide[w.ID] { return "int64 value should be wide" }
	if wide[nrw.ID] { return "int32 value should not be wide" }
	return ""
}

// On a 64-bit host (wordSize >= 8) no register is wide — int64 fits
// one slot, so the mapping stays the identity.
func TestRegWidthsNoneWideOn64Bit() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", swParams, swResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var w @ir.Instr = irbuild.EmitConstInt64(b, cast(int64, 5), types.TypInt64())
	var wide @[]bool = regWidths(f, f.NextID, 8)
	if wide[w.ID] { return "no register is wide when wordSize >= 8" }
	return ""
}

// An array whose element type holds no interface value yields no offsets without
// walking its elements (a [1 << 40]uint8 would take hours); one whose elements hold an
// interface value yields one offset per element, at the element stride.
func TestIfaceVtOffsetsForArrays() testing.TestResult {
	if len(ifaceVtOffsetsFor(types.MakeArrayType(types.TypUint8(), cast(int64, 1) << 40))) != 0 {
		return "a byte array carries no iface word"
	}
	var iface @types.Type = types.MakeInterfaceType("pkg/std/errors", "Error")
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Name = "n"
	fields[0].Type = types.TypInt()
	fields[1] = make(types.Field)
	fields[1].Name = "f"
	fields[1].Type = types.MakeManagedInterfaceValueType(iface)
	var elem @types.Type = types.MakeStructType("Held", fields)
	var off @[]int = ifaceVtOffsetsFor(types.MakeArrayType(elem, 3))
	var want int = REG_SLOT + types.IfaceValueVtableIndex() * REG_SLOT
	var stride int = elem.SizeOf()
	if len(off) != 3 || off[0] != want || off[1] != want + stride || off[2] != want + 2 * stride {
		return "three elements holding an iface yield three offsets at the stride"
	}
	if !holdsIfaceValue(elem) || holdsIfaceValue(types.TypInt()) {
		return "holdsIfaceValue misclassifies"
	}
	var named @types.Type = types.MakeNamedType("NamedHeld")
	named.Underlying = elem
	var wrapped @[]@types.Type = make_slice(@types.Type, 3)
	wrapped[0] = named
	wrapped[1] = types.MakeReadonlyType(elem)
	wrapped[2] = types.MakeAliasType("AliasHeld", elem)
	for i := 0; i < len(wrapped); i++ {
		if !holdsIfaceValue(wrapped[i]) {
			return "holdsIfaceValue misses an iface behind a named, readonly or alias element"
		}
		off = ifaceVtOffsetsFor(types.MakeArrayType(wrapped[i], 2))
		if len(off) != 2 || off[0] != want || off[1] != want + stride {
			return "a named, readonly or alias element holding an iface yields one offset per element"
		}
	}
	var managed @types.Type = types.MakeManagedInterfaceValueType(iface)
	var inner @types.Type = types.MakeArrayType(managed, 2)
	var ifaceSize int = managed.SizeOf()
	off = ifaceVtOffsetsFor(types.MakeArrayType(inner, 2))
	var vt int = types.IfaceValueVtableIndex() * REG_SLOT
	if len(off) != 4 || off[0] != vt || off[1] != vt + ifaceSize || off[2] != vt + 2 * ifaceSize ||
			off[3] != vt + 3 * ifaceSize {
		return "a [2][2]@Iface yields four offsets, one per iface"
	}
	if !holdsIfaceValue(inner) || holdsIfaceValue(types.MakeArrayType(managed, 0)) {
		return "holdsIfaceValue misclassifies a nested or empty iface array"
	}
	return ""
}
