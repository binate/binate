package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

var swParams @[]@ir.Param

var swResults @[]@types.Type

// With no wide registers (e.g. on a 64-bit host, where int64 fits one
// slot), the slot map is the identity and slot count == register count.
func TestBuildSlotMapIdentityWhenNoneWide() testing.TestResult {
	var wide @[]bool = make_slice(bool, 4)
	var slotOf @[]int
	var n int
	slotOf, n = buildSlotMap(wide)
	if n != 4 { return "expected 4 slots" }
	for i := 0; i < 4; i++ {
		if slotOf[i] != i { return "expected identity slot map" }
	}
	return ""
}

// A wide register reserves two consecutive slots, shifting every
// later register up by one per preceding wide register.
func TestBuildSlotMapPairsReserveTwoSlots() testing.TestResult {
	// registers: r0 narrow, r1 wide, r2 narrow, r3 wide
	var wide @[]bool = make_slice(bool, 4)
	wide[1] = true
	wide[3] = true
	var slotOf @[]int
	var n int
	slotOf, n = buildSlotMap(wide)
	if slotOf[0] != 0 { return "r0 -> slot 0" }
	if slotOf[1] != 1 { return "r1 -> slot 1" }
	if slotOf[2] != 3 { return "r2 -> slot 3 (after r1's pair)" }
	if slotOf[3] != 4 { return "r3 -> slot 4" }
	if n != 6 { return "expected 6 slots total (two pairs)" }
	return ""
}

func TestIs64BitScalarIntAndFloat() testing.TestResult {
	if !is64BitScalar(types.TypInt64()) { return "int64 is 64-bit" }
	if !is64BitScalar(types.TypUint64()) { return "uint64 is 64-bit" }
	if !is64BitScalar(types.TypFloat64()) { return "float64 is 64-bit" }
	return ""
}

// int32 / uint32 / float32 / pointers fit one host-word slot.
func TestIs64BitScalarNarrowTypes() testing.TestResult {
	if is64BitScalar(types.TypInt32()) { return "int32 is not 64-bit" }
	if is64BitScalar(types.TypUint32()) { return "uint32 is not 64-bit" }
	if is64BitScalar(types.TypFloat32()) { return "float32 is not 64-bit" }
	if is64BitScalar(nil) { return "nil is not 64-bit" }
	return ""
}

// argIsIfaceValue classifies exactly the 2-word interface value shapes (raw
// `*I` and managed `@I`) and rejects scalars / nil — the stamp that drives the
// cross-mode extern iface-arg substitution, so a scalar arg is never mistaken
// for an interface pointer.
func TestArgIsIfaceValue() testing.TestResult {
	var pkg @[]char = "pkg/std/errors"
	var name @[]char = "Error"
	var iface @types.Type = types.MakeInterfaceType(pkg, name)
	if !argIsIfaceValue(types.MakeInterfaceValueType(iface)) {
		return "raw *Iface must classify as an iface value"
	}
	if !argIsIfaceValue(types.MakeManagedInterfaceValueType(iface)) {
		return "managed @Iface must classify as an iface value"
	}
	if argIsIfaceValue(types.TypInt64()) { return "int64 is not an iface value" }
	if argIsIfaceValue(types.TypInt32()) { return "int32 is not an iface value" }
	if argIsIfaceValue(nil) { return "nil is not an iface value" }
	return ""
}

// split/join round-trips across the tricky cases: a high-bit-set low
// half (must not sign-pollute the high word), negative values, and the
// int64 extremes.  Validates the pair bit-math on any host.
func TestSplitJoinInt64RoundTrip() testing.TestResult {
	var cases @[]int64 = make_slice(int64, 7)
	cases[0] = cast(int64, 0)
	cases[1] = cast(int64, 1)
	cases[2] = cast(int64, -1) // 0xFFFFFFFFFFFFFFFF
	cases[3] = cast(int64, 0xFFFFFFFF) // low half all ones, high 0
	cases[4] = cast(int64, 1) << cast(int64, 40) // only a high-word bit
	cases[5] = cast(int64, 9223372036854775807) // int64-max
	cases[6] = cast(int64, -9223372036854775807) - cast(int64, 1) // int64-min
	for i := 0; i < len(cases); i++ {
		var lo int
		var hi int
		lo, hi = splitInt64(cases[i])
		if joinInt64(lo, hi) != cases[i] {
			return "split/join round-trip failed"
		}
	}
	return ""
}

// The low half's bit 31 must NOT leak into the high word on rejoin.
func TestJoinInt64ZeroExtendsLowHalf() testing.TestResult {
	// lo = 0x80000000 (bit 31 set), hi = 0 → value is 0x0000000080000000,
	// NOT 0xFFFFFFFF80000000.
	var lo int
	var hi int
	lo, hi = splitInt64(cast(int64, 0x80000000))
	if joinInt64(lo, hi) != cast(int64, 0x80000000) {
		return "low half bit 31 sign-polluted the high word"
	}
	return ""
}

// BC_RETURN64's Dst is the same shape code as BC_RETURN's (0 for a
// single-pair return), not a register — must not be translated.
func TestRemapRegistersRespectsReturn64() testing.TestResult {
	var slotOf @[]int = make_slice(int, 3)
	slotOf[0] = 0
	slotOf[1] = 2
	slotOf[2] = 3
	var code @[]BCInstr = make_slice(BCInstr, 1)
	var r64 BCInstr
	r64.Op = BC_RETURN64
	r64.Dst = 1 // shape code; must NOT be remapped to slotOf[1]=2
	r64.Src1 = 1 // pair base register; SHOULD be remapped
	r64.Src2 = -1
	code[0] = r64
	remapRegisters(code, slotOf)
	if code[0].Dst != 1 { return "RETURN64 Dst (shape) must be left intact" }
	if code[0].Src1 != 2 { return "RETURN64 Src1 (pair base) must be remapped" }
	return ""
}

// remapRegisters translates register fields through slotOf, but must
// leave BC_RETURN's Dst (the return-shape code) intact, and pass -1
// (void / absent) through unchanged.
func TestRemapRegisters() testing.TestResult {
	// reg 1 was wide, so slotOf shifts: 0->0, 1->2, 2->3
	var slotOf @[]int = make_slice(int, 3)
	slotOf[0] = 0
	slotOf[1] = 2
	slotOf[2] = 3
	var code @[]BCInstr = make_slice(BCInstr, 2)
	var add BCInstr
	add.Op = BC_ADD
	add.Dst = 2
	add.Src1 = 1
	add.Src2 = 0
	code[0] = add
	var ret BCInstr
	ret.Op = BC_RETURN
	ret.Dst = 1 // return-shape code — must NOT be remapped
	ret.Src1 = 1 // return-value register — must be remapped
	ret.Src2 = -1 // absent — passes through
	code[1] = ret
	remapRegisters(code, slotOf)
	if code[0].Dst != 3 { return "ADD Dst 2->3" }
	if code[0].Src1 != 2 { return "ADD Src1 1->2" }
	if code[0].Src2 != 0 { return "ADD Src2 0->0" }
	if code[1].Dst != 1 { return "RETURN Dst (shape) must be left intact" }
	if code[1].Src1 != 2 { return "RETURN Src1 1->2" }
	if code[1].Src2 != -1 { return "RETURN Src2 -1 passes through" }
	return ""
}

// regWidths flags the int64 value's register wide and the int32 one
// narrow (wordSize=4 forces the 32-bit path on any host).
func TestRegWidthsFlagsWideValues() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", swParams, swResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var w @ir.Instr = b.EmitConstInt64(cast(int64, 5), types.TypInt64())
	var nrw @ir.Instr = b.EmitConstInt(5, types.TypInt32())
	var wide @[]bool = regWidths(f, f.NextID, 4)
	if !wide[w.ID] { return "int64 value should be wide" }
	if wide[nrw.ID] { return "int32 value should not be wide" }
	return ""
}

// On a 64-bit host (wordSize >= 8) no register is wide — int64 fits
// one slot, so the mapping stays the identity.
func TestRegWidthsNoneWideOn64Bit() testing.TestResult {
	var f @ir.Func = ir.NewFunc("", "t", swParams, swResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var w @ir.Instr = b.EmitConstInt64(cast(int64, 5), types.TypInt64())
	var wide @[]bool = regWidths(f, f.NextID, 8)
	if wide[w.ID] { return "no register is wide when wordSize >= 8" }
	return ""
}
