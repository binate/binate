package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// spTestInstr builds a bare IR instr carrying just the op and result type —
// all spGrowthBytes needs.
func spTestInstr(op int, typ @types.Type) @ir.Instr {
	var instr @ir.Instr = make(ir.Instr)
	instr.Op = op
	instr.Typ = typ
	return instr
}

// TestSPGrowthFixedHeaderOps pins the fixed-word growths against their handlers.
func TestSPGrowthFixedHeaderOps() testing.TestResult {
	if spGrowthBytes(spTestInstr(iropcode.OP_MAKE_SLICE, nil)) != 4 * REG_SLOT {
		return "make_slice must grow 4 words (managed-slice header)"
	}
	if spGrowthBytes(spTestInstr(iropcode.OP_IFACE_VALUE, nil)) != 2 * REG_SLOT {
		return "iface-value must grow 2 words"
	}
	if spGrowthBytes(spTestInstr(iropcode.OP_IFACE_UPCAST, nil)) != 2 * REG_SLOT {
		return "iface-upcast must grow 2 words"
	}
	if spGrowthBytes(spTestInstr(iropcode.OP_FUNC_VALUE, nil)) != 2 * REG_SLOT {
		return "func-value must grow 2 words"
	}
	if spGrowthBytes(spTestInstr(iropcode.OP_RODATA_MSLICE_COPY, nil)) != 8 * REG_SLOT {
		return "rodata-mslice-copy must grow 8 words (transient header + result)"
	}
	return ""
}

// TestSPGrowthRodataArray pins the 4-word header + 8-byte-aligned buffer growth.
func TestSPGrowthRodataArray() testing.TestResult {
	// [5]char: 4-word header + align8(5) = 4*REG_SLOT + 8.
	var a5 @ir.Instr = spTestInstr(
			iropcode.OP_RODATA_ARRAY, types.MakeArrayType(types.TypChar(), 5))
	if spGrowthBytes(a5) != 4 * REG_SLOT + 8 {
		return "rodata-array [5]char must grow 4 words + align8(5)=8"
	}
	// [8]char: align8(8) = 8.
	var a8 @ir.Instr = spTestInstr(
			iropcode.OP_RODATA_ARRAY, types.MakeArrayType(types.TypChar(), 8))
	if spGrowthBytes(a8) != 4 * REG_SLOT + 8 {
		return "rodata-array [8]char must grow 4 words + 8"
	}
	// [9]char: align8(9) = 16.
	var a9 @ir.Instr = spTestInstr(
			iropcode.OP_RODATA_ARRAY, types.MakeArrayType(types.TypChar(), 9))
	if spGrowthBytes(a9) != 4 * REG_SLOT + 16 {
		return "rodata-array [9]char must grow 4 words + align8(9)=16"
	}
	return ""
}

// spPairStructType is a two-int struct — an aggregate return image.
func spPairStructType() @types.Type {
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt()
	return types.MakeStructType("Pair", fields)
}

// TestSPGrowthCallReturnImage pins the caller-side copy-back growth: 0 for
// scalar/void returns, align8(SizeOf) for aggregate returns, uniformly across
// every call op.
func TestSPGrowthCallReturnImage() testing.TestResult {
	if spGrowthBytes(spTestInstr(iropcode.OP_CALL, types.TypInt())) != 0 {
		return "scalar-returning call must grow 0 (returned in registers)"
	}
	if spGrowthBytes(spTestInstr(iropcode.OP_CALL, nil)) != 0 {
		return "void call must grow 0"
	}
	var st @types.Type = spPairStructType()
	var want int = (st.SizeOf() + 7) / 8 * 8
	if want <= 0 {
		return "test setup: struct SizeOf should be positive"
	}
	if spGrowthBytes(spTestInstr(iropcode.OP_CALL, st)) != want {
		return "aggregate-returning direct call must grow align8(SizeOf(result))"
	}
	if spGrowthBytes(spTestInstr(iropcode.OP_CALL_IFACE_METHOD, st)) != want {
		return "aggregate-returning iface-method call must grow align8(SizeOf(result))"
	}
	if spGrowthBytes(spTestInstr(iropcode.OP_CALL_FUNC_VALUE, st)) != want {
		return "aggregate-returning func-value call must grow align8(SizeOf(result))"
	}
	if spGrowthBytes(spTestInstr(iropcode.OP_CALL_INDIRECT, st)) != want {
		return "aggregate-returning indirect call must grow align8(SizeOf(result))"
	}
	if spGrowthBytes(spTestInstr(iropcode.OP_C_CALL, st)) != want {
		return "aggregate-returning C call must grow align8(SizeOf(result))"
	}
	if spGrowthBytes(spTestInstr(iropcode.OP_CALL_HANDLE, st)) != want {
		return "aggregate-returning handle call must grow align8(SizeOf(result))"
	}
	return ""
}

// TestSPGrowthNonGrowingOps confirms the call gate: a non-call op grows 0 even
// with an aggregate result type (only calls copy a return image into the caller
// frame), and plain scalar ops / nil grow 0.
func TestSPGrowthNonGrowingOps() testing.TestResult {
	if spGrowthBytes(spTestInstr(iropcode.OP_LOAD, spPairStructType())) != 0 {
		return "OP_LOAD of a struct must not be counted as vm.SP growth"
	}
	if spGrowthBytes(spTestInstr(iropcode.OP_ADD, types.TypInt())) != 0 {
		return "OP_ADD must grow 0"
	}
	var none @ir.Instr = nil
	if spGrowthBytes(none) != 0 {
		return "nil instr must grow 0"
	}
	return ""
}
