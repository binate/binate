package "pkg/binate/vm"

import "pkg/binate/ir"

// lowerStackFrames lowers OP_STACK_FRAMES (pkg/std/debug stacktrace capture) to
// BC_STACK_FRAMES.  bc arrives with bc.Dst already set to the result register
// (the by-value int depth).  Src1 carries the buf *[]Frame register (its value is
// the address of the {data,len} image) and Src2 carries the skip-count register;
// execStackFrames reads both and walks vm.Stack's frame headers.  Both operands
// are REGISTER ids, so they MUST ride register fields (Dst/Src1/Src2) — the ONLY
// fields remapRegisters rewrites id→slot.  Aux is NOT remapped (it holds
// immediates / name-table indices), so a register id placed there would be read
// as a raw id and index the wrong slot on any host where the slot map is not the
// identity (a 32-bit VM host, where a wide 64-bit-scalar register splits slots).
func lowerStackFrames(bc BCInstr, instr @ir.Instr) BCInstr {
	bc.Op = BC_STACK_FRAMES
	bc.Src1 = instr.Args[1].ID
	bc.Src2 = instr.Args[0].ID
	return bc
}
