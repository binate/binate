package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// TestLowerStackFrames checks that OP_STACK_FRAMES lowers to BC_STACK_FRAMES with
// Src1 = the buf arg register, Src2 = the skip arg register, and Dst preserved.
// Both operands are register ids and so must land in remapped fields (Src1/Src2),
// never Aux (which is not id→slot remapped).
func TestLowerStackFrames() testing.TestResult {
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("pkg/std/debug", "Callers", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var skip @ir.Instr = entry.EmitConstInt(0, types.TypInt())
	var buf @ir.Instr = entry.EmitConstInt(1, types.TypInt())
	var sf @ir.Instr = entry.EmitStackFrames(skip, buf, types.TypInt())

	var bc BCInstr
	bc.Dst = sf.ID
	bc = lowerStackFrames(bc, sf)

	if bc.Op != BC_STACK_FRAMES { return "expected BC_STACK_FRAMES" }
	if bc.Src1 != buf.ID { return "Src1 should be the buf arg register" }
	if bc.Src2 != skip.ID { return "Src2 should be the skip arg register" }
	if bc.Dst != sf.ID { return "Dst should be preserved" }
	return ""
}
