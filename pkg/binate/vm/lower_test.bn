package "pkg/binate/vm"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for module-level lowering (lower.bn): LowerModule,
// multi-function wiring, string-constant collection, extern
// handling, cross-module string isolation. Per-function lowering
// (register allocation, frame size, branch resolution, params,
// etc.) lives in lower_func_test.bn alongside lower_func.bn.

func lowerFromSource(src *[]readonly char) @VM {
	var srcBytes @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(srcBytes, "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	var m @ir.Module = ir.GenModule(c, file)
	var vm @VM = NewVM(1024 * 1024)
	vm.LowerModule(m)
	return vm
}

// genModule parses and IR-gens without building a VM.
func genModule(src *[]readonly char) @ir.Module {
	var srcBytes @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(srcBytes, "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	return ir.GenModule(c, file)
}

func TestLowerSimpleFunc() testing.TestResult {
	var vm @VM = lowerFromSource("package \"test\"\nfunc main() int { return 42 }\n")
	if vm.Funcs.Len() != 1 { return "expected 1 function" }
	if len(vm.Funcs.Get(0).Code) == 0 { return "expected non-empty bytecode" }
	if !streq(vm.Funcs.Get(0).Name, "test.main") { return "expected func name 'test.main'" }
	return ""
}

// countBCBoundsChecks counts BC_BOUNDS_CHECK ops across every lowered function's
// bytecode — the observable for the LowerModule opt-passes wiring.
func countBCBoundsChecks(vm @VM) int {
	var n int = 0
	for fi := 0; fi < vm.Funcs.Len(); fi++ {
		var code @[]BCInstr = vm.Funcs.Get(fi).Code
		for i := 0; i < len(code); i++ {
			if code[i].Op == BC_BOUNDS_CHECK { n = n + 1 }
		}
	}
	return n
}

// LowerModule runs ir.RunOptPasses(m, vm.OptLevel) before lowering, so the
// interpreter shares the compiled backends' IR opt passes.  A program with two
// constant-index fixed-array accesses lowers with BC_BOUNDS_CHECKs at -O0 and
// with them eliminated at -O1 (constant-index bounds-check elimination).
func TestLowerModuleOptLevelBCE() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc main() int {\n\tvar a [4]int\n\ta[2] = 7\n"
			"\treturn a[2]\n}\n"
	// -O0: checks lowered as-is (default — no passes).
	var m0 @ir.Module = genModule(src)
	var vm0 @VM = NewVM(1024 * 1024)
	vm0.OptLevel = 0
	vm0.LowerModule(m0)
	var n0 int = countBCBoundsChecks(vm0)
	if n0 < 1 { return "expected >=1 BC_BOUNDS_CHECK at -O0" }
	// -O1: constant-index BCE removes the statically-safe checks (0 <= 2 < 4).
	var m1 @ir.Module = genModule(src)
	var vm1 @VM = NewVM(1024 * 1024)
	vm1.OptLevel = 1
	vm1.LowerModule(m1)
	var n1 int = countBCBoundsChecks(vm1)
	if n1 >= n0 { return "expected fewer BC_BOUNDS_CHECK at -O1 than -O0" }
	if n1 != 0 { return "expected all constant-index checks removed at -O1" }
	return ""
}

func TestLowerMultipleFuncs() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func add(a int, b int) int { return a + b }\n")
	src = concatStr(src, "func main() int { return add(1, 2) }\n")
	var vm @VM = lowerFromSource(src)
	if vm.Funcs.Len() != 2 { return "expected 2 functions" }
	// Check that the call function has a name in its name table
	var mainIdx int = -1
	for i := 0; i < vm.Funcs.Len(); i++ {
		if streq(vm.Funcs.Get(i).Name, "test.main") { mainIdx = i }
	}
	if mainIdx < 0 { return "main not found" }
	if len(vm.Funcs.Get(mainIdx).Names) == 0 { return "expected non-empty name table for main" }
	return ""
}

func TestLowerStringConstants() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() { _ = \"hello\" }\n")
	var vm @VM = lowerFromSource(src)
	if len(vm.Funcs.Get(0).Strings) == 0 { return "expected string constants" }
	return ""
}

// TestLowerMultipleModulesStringIsolation guards against a bug
// where the VM kept a single shared Strings slice that got
// overwritten each time LowerModule was called, so BC_LOAD_STR
// indices baked into earlier modules' functions ended up reading
// later modules' strings at runtime.
func TestLowerMultipleModulesStringIsolation() testing.TestResult {
	var vm @VM = NewVM(1024 * 1024)

	// Module A has "mod-a-str" at some index.
	var srcA @[]char
	srcA = concatStr(srcA, "package \"mod_a\"\n")
	srcA = concatStr(srcA, "func A() { _ = \"mod-a-str\" }\n")
	var mA @ir.Module = genModule(srcA)
	vm.LowerModule(mA)
	var funcsAfterA int = vm.Funcs.Len()

	// Module B has MORE string constants, so if they overwrote A's
	// strings, A's BC_LOAD_STR index would point into B's table.
	var srcB @[]char
	srcB = concatStr(srcB, "package \"mod_b\"\n")
	srcB = concatStr(srcB, "func B() { _ = \"b1\"; _ = \"b2\"; _ = \"b3\" }\n")
	var mB @ir.Module = genModule(srcB)
	vm.LowerModule(mB)

	if funcsAfterA < 1 { return "expected at least one function from module A" }
	// Find A's function and verify its Strings slice still has mod-a-str.
	var aStrings @[]@[]char = vm.Funcs.Get(funcsAfterA - 1).Strings
	if len(aStrings) == 0 { return "A's Strings lost" }
	var found bool = false
	for i := 0; i < len(aStrings); i++ {
		if streq(aStrings[i], "mod-a-str") { found = true }
	}
	if !found { return "A's Strings no longer contains 'mod-a-str'" }
	return ""
}

// TestLowerMultipleModulesGlobalsAccumulate guards the cross-package
// globals table: each module's globals must ACCUMULATE under their
// qualified names, not overwrite.  The old per-module overwrite kept
// only the last module's globals — fine for same-package reads (which
// bake their address at lower time), but it left a cross-package
// extern-var read with nothing to resolve.  After lowering mod_b, an
// earlier module's global must still resolve by its qualified name.
func TestLowerMultipleModulesGlobalsAccumulate() testing.TestResult {
	var vm @VM = NewVM(1024 * 1024)

	var srcA @[]char
	srcA = concatStr(srcA, "package \"mod_a\"\n")
	srcA = concatStr(srcA, "var GA int = 1\n")
	srcA = concatStr(srcA, "func A() int { return GA }\n")
	var mA @ir.Module = genModule(srcA)
	vm.LowerModule(mA)

	var srcB @[]char
	srcB = concatStr(srcB, "package \"mod_b\"\n")
	srcB = concatStr(srcB, "var GB int = 2\n")
	srcB = concatStr(srcB, "func B() int { return GB }\n")
	var mB @ir.Module = genModule(srcB)
	vm.LowerModule(mB)

	// Both resolve by qualified name (dotted names pass through the
	// lookup's qualification unchanged).  Pre-fix, GA was dropped.
	if lookupGlobalAddr(vm, "mod_a.GA") == 0 {
		return "mod_a.GA address lost after lowering mod_b"
	}
	if lookupGlobalAddr(vm, "mod_b.GB") == 0 {
		return "mod_b.GB not registered"
	}
	return ""
}

func TestLowerExternsSkipped() testing.TestResult {
	// Extern functions should not produce bytecode
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int { return 1 }\n")
	var vm @VM = lowerFromSource(src)
	// All lowered functions should be non-extern
	for i := 0; i < vm.Funcs.Len(); i++ {
		if len(vm.Funcs.Get(i).Code) == 0 {
			return "found function with no code"
		}
	}
	return ""
}

// LowerOneFunc must re-establish modulePkgName from its OWN module, not
// inherit a stale value left by a prior LowerModule of a different package.
// Repro of the REPL mid-session-import path: LowerModule(importedPkg) sets
// modulePkgName=importedPkg, then a prompt entry LowerOneFunc(mainMod) would,
// without the re-establish, qualify the func's bare same-package call targets
// against the wrong package.
func TestLowerOneFuncReestablishesModulePkg() testing.TestResult {
	var vm @VM = NewVM(1024 * 1024)
	// mod_a: caller() invokes helper() — a bare, same-package call target
	// that is qualified at lower time using modulePkgName.
	var srcA @[]char
	srcA = concatStr(srcA, "package \"mod_a\"\n")
	srcA = concatStr(srcA, "func helper() int { return 1 }\n")
	srcA = concatStr(srcA, "func caller() int { return helper() }\n")
	var mA @ir.Module = genModule(srcA)
	vm.LowerModule(mA)

	// Lower a DIFFERENT package, leaving vm.modulePkgName = mod_b.
	var srcB @[]char
	srcB = concatStr(srcB, "package \"mod_b\"\n")
	srcB = concatStr(srcB, "func other() int { return 2 }\n")
	var mB @ir.Module = genModule(srcB)
	vm.LowerModule(mB)

	// Re-lower caller (from mod_a) via LowerOneFunc.  Its bare "helper" call
	// target must qualify to "mod_a.helper", NOT the stale "mod_b.helper".
	var target @[]char
	for i := 0; i < len(mA.Funcs); i++ {
		var vmf @VMFunc = vm.LowerOneFunc(mA, mA.Funcs[i])
		if vmf == nil { continue }
		for j := 0; j < len(vmf.Names); j++ {
			if streq2(vmf.Names[j], "mod_a.helper") || streq2(vmf.Names[j], "mod_b.helper") {
				target = vmf.Names[j]
			}
		}
	}
	if len(target) == 0 {
		return "caller's helper call target not found in lowered names"
	}
	if !streq2(target, "mod_a.helper") {
		return "stale modulePkgName mis-qualified call target (want mod_a.helper)"
	}
	return ""
}
