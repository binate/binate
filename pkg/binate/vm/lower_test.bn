package "pkg/binate/vm"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for module-level lowering (lower.bn): LowerModule,
// multi-function wiring, string-constant collection, extern
// handling, cross-module string isolation. Per-function lowering
// (register allocation, frame size, branch resolution, params,
// etc.) lives in lower_func_test.bn alongside lower_func.bn.

func lowerFromSource(src *[]readonly char) @VM {
	var srcBytes @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(srcBytes, "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	var m @ir.Module = ir.GenModule(file)
	var vm @VM = NewVM(1024 * 1024)
	vm.LowerModule(m)
	return vm
}

// genModule parses and IR-gens without building a VM.
func genModule(src *[]readonly char) @ir.Module {
	var srcBytes @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(srcBytes, "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	return ir.GenModule(file)
}

func TestLowerSimpleFunc() testing.TestResult {
	var vm @VM = lowerFromSource("package \"test\"\nfunc main() int { return 42 }\n")
	if len(vm.Funcs) != 1 { return "expected 1 function" }
	if len(vm.Funcs[0].Code) == 0 { return "expected non-empty bytecode" }
	if !streq(vm.Funcs[0].Name, "test.main") { return "expected func name 'test.main'" }
	return ""
}

func TestLowerMultipleFuncs() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func add(a int, b int) int { return a + b }\n")
	src = concatStr(src, "func main() int { return add(1, 2) }\n")
	var vm @VM = lowerFromSource(src)
	if len(vm.Funcs) != 2 { return "expected 2 functions" }
	// Check that the call function has a name in its name table
	var mainIdx int = -1
	for i := 0; i < len(vm.Funcs); i++ {
		if streq(vm.Funcs[i].Name, "test.main") { mainIdx = i }
	}
	if mainIdx < 0 { return "main not found" }
	if len(vm.Funcs[mainIdx].Names) == 0 { return "expected non-empty name table for main" }
	return ""
}

func TestLowerStringConstants() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() { println(\"hello\") }\n")
	var vm @VM = lowerFromSource(src)
	if len(vm.Funcs[0].Strings) == 0 { return "expected string constants" }
	return ""
}

// TestLowerMultipleModulesStringIsolation guards against a bug
// where the VM kept a single shared Strings slice that got
// overwritten each time LowerModule was called, so BC_LOAD_STR
// indices baked into earlier modules' functions ended up reading
// later modules' strings at runtime.
func TestLowerMultipleModulesStringIsolation() testing.TestResult {
	var vm @VM = NewVM(1024 * 1024)

	// Module A has "mod-a-str" at some index.
	var srcA @[]char
	srcA = concatStr(srcA, "package \"mod_a\"\n")
	srcA = concatStr(srcA, "func A() { println(\"mod-a-str\") }\n")
	var mA @ir.Module = genModule(srcA)
	vm.LowerModule(mA)
	var funcsAfterA int = len(vm.Funcs)

	// Module B has MORE string constants, so if they overwrote A's
	// strings, A's BC_LOAD_STR index would point into B's table.
	var srcB @[]char
	srcB = concatStr(srcB, "package \"mod_b\"\n")
	srcB = concatStr(srcB, "func B() { println(\"b1\"); println(\"b2\"); println(\"b3\") }\n")
	var mB @ir.Module = genModule(srcB)
	vm.LowerModule(mB)

	if funcsAfterA < 1 { return "expected at least one function from module A" }
	// Find A's function and verify its Strings slice still has mod-a-str.
	var aStrings @[]@[]char = vm.Funcs[funcsAfterA - 1].Strings
	if len(aStrings) == 0 { return "A's Strings lost" }
	var found bool = false
	for i := 0; i < len(aStrings); i++ {
		if streq(aStrings[i], "mod-a-str") { found = true }
	}
	if !found { return "A's Strings no longer contains 'mod-a-str'" }
	return ""
}

func TestLowerExternsSkipped() testing.TestResult {
	// Extern functions should not produce bytecode
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int { return 1 }\n")
	var vm @VM = lowerFromSource(src)
	// All lowered functions should be non-extern
	for i := 0; i < len(vm.Funcs); i++ {
		if len(vm.Funcs[i].Code) == 0 {
			return "found function with no code"
		}
	}
	return ""
}

// LowerModule must skip functions whose qualified name is in the
// VM's extern registry — the registered native pointer is the
// canonical impl, the bytecode body would shadow it incorrectly.
// Pin via a test module containing a function whose qualified name
// (`shadow_pkg.Probe`) is pre-registered as an extern; after
// LowerModule, vm.Funcs MUST NOT contain a bytecode entry for it,
// and LookupFunc MUST return -1 so BC_CALL falls through to the
// extern registry.
//
// Constructs IR directly (no parse → GenModule pipeline) to avoid
// leaking `currentModulePkgPath` into later tests in the same
// binary — a long-standing IR-layer foot-gun.
func TestLowerSkipsExternShadowedFuncs() testing.TestResult {
	var vm @VM = NewVM(1024 * 1024)
	// Register a dummy extern under the qualified name we'll later
	// try to lower.  Pointer fields can be anything non-nil here
	// — we only check the skip-lowering plumbing, not extern
	// dispatch.
	var dummyAddr int = 1
	vm.RegisterExtern("shadow_pkg.Probe",
		bit_cast(*uint8, &dummyAddr), scalarResult,
		bit_cast(int, &dummyAddr))
	var m @ir.Module = ir.NewModule("\"shadow_pkg\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var noRetArgs @[]@ir.Instr
	var probe @ir.Func =
		ir.NewFunc("shadow_pkg.Probe", noParams, results)
	var probeEntry @ir.Block = ir.AddBlock(probe, "entry")
	var probeC @ir.Instr = probeEntry.EmitConstInt(1, types.TypInt())
	var probeRet @[]@ir.Instr = make_slice(@ir.Instr, 1)
	probeRet[0] = probeC
	probeEntry.EmitReturn(probeRet)
	m.AddFunc(probe)
	var bystander @ir.Func =
		ir.NewFunc("shadow_pkg.Bystander", noParams, results)
	var byEntry @ir.Block = ir.AddBlock(bystander, "entry")
	var byC @ir.Instr = byEntry.EmitConstInt(2, types.TypInt())
	var byRet @[]@ir.Instr = make_slice(@ir.Instr, 1)
	byRet[0] = byC
	byEntry.EmitReturn(byRet)
	m.AddFunc(bystander)
	_ = noRetArgs

	var funcsBefore int = len(vm.Funcs)
	vm.LowerModule(m)
	// Bystander should have lowered; Probe should NOT have.
	if vm.LookupFunc("shadow_pkg.Bystander") < 0 {
		return "expected Bystander to be lowered"
	}
	if vm.LookupFunc("shadow_pkg.Probe") >= 0 {
		return "Probe is extern-shadowed; LookupFunc must return -1"
	}
	if len(vm.Funcs) != funcsBefore + 1 {
		return "expected exactly one new VMFunc (Bystander); Probe should have been skipped"
	}
	return ""
}
