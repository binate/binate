package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/stdx/slices"

// Per-module materialization of the RTTI `__typeinfo.<T>` records into VM
// memory — the VM's counterpart to the native backends' static `__typeinfo`
// data globals, and the "d-i" (data-injection) decision of Slice 5b
// (plan-type-assertions-execution.md).
//
// A concrete type assertion `x.(*T)` compares the scrutinee's dynamic
// `*TypeInfo` (vtable any-block slot 1) against `&__typeinfo.<T>`, and a
// wrong-type miss reads the dynamic type's NAME out of its TypeInfo record
// (words 3–4).  Both operands must therefore resolve, WITHIN the VM, to a real
// per-type record: the dynamic side is written into the vtable slot by
// fillVtableLayout (lower.bn); the static side is materialized here and reached
// by BC_DATA_SYM_ADDR.  Per spec §7.13.14 the two engines need not share the
// native record's ADDRESS — only agree on the boolean result — so the VM mints
// its OWN record per type; pointer-equality of these VM records yields the same
// HIT/MISS a native pointer compare would.
//
// The records are the SAME irdata.BuildTypeInfo blobs the native/LLVM backends
// lower (so the layout cannot drift), laid into immortal VM memory by
// lowerDataGlobals.  The word-0 dtor symref is left null (DtorSym unset): the
// VM never reaches a type's dtor through its TypeInfo record — @Iface cleanup
// runs the dtor via the vtable's Methods[0] (BC_IFACE_DTOR) — so the record
// carries only the identity + size/align + name an assertion reads.

// materializeTypeInfos lays module `m`'s per-type `__typeinfo.<T>` records into
// VM memory, registering each record's runtime address under its mangled symbol
// in the session-lifetime data-symbol table (dataSymNames / dataSymAddrs).
// Runs in LowerModule BEFORE lowerImplVtables so fillVtableLayout can read the
// receiver type's record address back out.  Weak coalescing: a type already
// materialized by an earlier module (a generic instantiated in two TUs) is
// skipped, so its single record — hence single identity — is shared, exactly as
// the native weak `__typeinfo.<T>` linkage coalesces.
func materializeTypeInfos(vm @VM, m @ir.Module) {
	var descs @[]@irdata.TypeInfoDesc = ir.CollectTypeInfoDescs(m)
	for i := 0; i < len(descs); i++ {
		var desc @irdata.TypeInfoDesc = descs[i]
		if lookupDataSymAddr(vm, desc.Sym) != 0 {
			continue
		}
		var dgs @[]@irdata.DataGlobal = irdata.BuildTypeInfo(desc)
		var names @[]@[]char
		var addrs @[]int
		names, addrs = lowerDataGlobals(dgs)
		vm.dataSymNames = slices.Append[@[]char](vm.dataSymNames, desc.Sym)
		vm.dataSymAddrs = slices.Append[int](vm.dataSymAddrs, resolveSym(names, addrs, desc.Sym))
	}
}

// lookupDataSymAddr returns the runtime address materialized for a data-global
// symbol (an already-mangled `__typeinfo.<T>` name), or 0 if the symbol was not
// materialized.  Linear scan — a program's distinct-type set is small, and this
// is consulted only per assertion (BC_DATA_SYM_ADDR) and per impl vtable
// (fillVtableLayout), not in any hot loop.
func lookupDataSymAddr(vm @VM, sym *[]readonly char) int {
	for i := 0; i < len(vm.dataSymNames); i++ {
		if streq2(vm.dataSymNames[i], sym) {
			return vm.dataSymAddrs[i]
		}
	}
	return 0
}
