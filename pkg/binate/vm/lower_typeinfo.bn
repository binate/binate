package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/irdata"
import "pkg/binate/types"
import "pkg/stdx/containers/vec"

// Per-module materialization of the RTTI `__typeinfo.<T>` records into VM
// memory — the VM's counterpart to the native backends' static `__typeinfo`
// data globals, and the "d-i" (data-injection) decision of Slice 5b
// (plan-type-assertions-execution.md).
//
// A concrete type assertion `x.(*T)` compares the scrutinee's dynamic
// `*TypeInfo` (vtable any-block slot 1) against `&__typeinfo.<T>`, and a
// wrong-type miss reads the dynamic type's NAME out of its TypeInfo record
// (words 3–4).  Both operands must therefore resolve, WITHIN the VM, to a real
// per-type record: the dynamic side is written into the vtable slot by
// fillVtableLayout (lower.bn); the static side is materialized here and reached
// by BC_DATA_SYM_ADDR.  Per spec §7.13.14 the two engines need not share the
// native record's ADDRESS — only agree on the boolean result — so the VM mints
// its OWN record per type; pointer-equality of these VM records yields the same
// HIT/MISS a native pointer compare would.
//
// The records are the SAME irdata.BuildTypeInfo blobs the native/LLVM backends
// lower (so the layout cannot drift), laid into immortal VM memory by
// lowerDataGlobals.  The word-0 dtor symref is left null (DtorSym unset): the
// VM never reaches a type's dtor through its TypeInfo record — @Iface cleanup
// runs the dtor via the vtable's Methods[0] (BC_IFACE_DTOR) — so the record
// carries only the identity + size/align + name an assertion reads.

// materializeTypeInfos lays module `m`'s per-type `__typeinfo.<T>` records into
// VM memory, registering each record's runtime address under its mangled symbol
// in the session-lifetime data-symbol table (dataSymNames / dataSymAddrs).
// Runs in LowerModule BEFORE lowerImplVtables so fillVtableLayout can read the
// receiver type's record address back out.  Weak coalescing: a type already
// materialized by an earlier module (a generic instantiated in two TUs) is
// skipped, so its single record — hence single identity — is shared, exactly as
// the native weak `__typeinfo.<T>` linkage coalesces.
func materializeTypeInfos(vm @VM, m @ir.Module) {
	var descs @[]@irdata.TypeInfoDesc = ir.CollectTypeInfoDescs(m)
	// Phase 1: allocate + register every not-yet-materialized type's record (and
	// its trailer blobs), resolving INTRA-type symrefs (record→name-blob,
	// record→field-table, FieldEntry→field-names).  A FieldEntry's typeinfo-ptr
	// (word 5) references __typeinfo.<FieldType> — a DIFFERENT type's batch — so
	// lowerDataGlobals cannot resolve it here; it lands null and is back-patched
	// in phase 2, once every type's record address is in the session table.
	// Retain each freshly-materialized struct's field-table base + its desc for
	// that back-patch (the field-table blob is never resolved by name at runtime,
	// so it is deliberately NOT registered in the session table).
	var patchDescs @vec.Vec[@irdata.TypeInfoDesc] = vec.New[@irdata.TypeInfoDesc]()
	var patchBases @vec.Vec[int] = vec.New[int]()
	for i := 0; i < len(descs); i++ {
		var desc @irdata.TypeInfoDesc = descs[i]
		if lookupDataSymAddr(vm, desc.Sym) != 0 {
			continue
		}
		var dgs @[]@irdata.DataGlobal = irdata.BuildTypeInfo(desc)
		var names @[]@[]char
		var addrs @[]int
		names, addrs = lowerDataGlobals(dgs)
		vm.dataSymNames.Push(desc.Sym)
		vm.dataSymAddrs.Push(resolveSym(names, addrs, desc.Sym))
		if len(desc.Fields) > 0 {
			patchDescs.Push(desc)
			patchBases.Push(resolveSym(names, addrs, desc.FieldsSym))
		}
	}
	// Phase 2: every type's record is now in the session table, so a field's
	// __typeinfo.<FieldType> resolves via lookupDataSymAddr regardless of which
	// module materialized the field type (weak-coalesced single identity).
	// Back-patch FieldEntry word 5 in place.  PointerSize == IntSize on every
	// current target (the assumption BuildTypeInfo documents), so each 8-word
	// FieldEntry j starts at base + j*8*w and its typeinfo-ptr is at +5*w.
	var w int = types.GetTarget().PointerSize
	for i := 0; i < patchDescs.Len(); i++ {
		var desc @irdata.TypeInfoDesc = patchDescs.Get(i)
		var base int = patchBases.Get(i)
		for j := 0; j < len(desc.Fields); j++ {
			var fld @irdata.FieldInfoDesc = desc.Fields[j]
			if len(fld.TypeInfoSym) == 0 { continue }
			var tiAddr int = lookupDataSymAddr(vm, fld.TypeInfoSym)
			if tiAddr == 0 { continue }
			writeLE(base + j * 8 * w + 5 * w, bit_cast(uint64, cast(int64, tiAddr)), w)
		}
	}
}

// materializeIfaceIds lays module `m`'s per-interface `__ifaceid.<J>` markers
// (the 1-byte weak identity tokens, spec §11.12 `iface.rtti`) into VM memory,
// registering each under its mangled symbol in the data-symbol table — the
// interface-side counterpart to materializeTypeInfos (RTTI Slice 5b-2).  An
// interface-target assertion `x.(*J)` materializes `&__ifaceid.<J>` via
// BC_DATA_SYM_ADDR and keys the satisfaction lookup on it; lowerImplVtables
// registers each VM-lowered `(T, J)` satentry under the SAME address.  Run
// before lowerImplVtables, weak-coalesced (skip an already-materialized symbol)
// like the typeinfo records.
func materializeIfaceIds(vm @VM, m @ir.Module) {
	var syms @[]@[]char = ir.CollectIfaceIdSyms(m)
	for i := 0; i < len(syms); i++ {
		ensureIfaceIdSym(vm, syms[i])
	}
}

// ensureIfaceIdSym returns the materialized address of the `__ifaceid.<J>`
// marker named `sym`, laying it into VM memory (BuildIfaceId + lowerDataGlobals)
// on first request and returning the existing address on any repeat (weak
// coalescing).  Unlike a bare lookupDataSymAddr it GUARANTEES a non-zero
// address, so lowerImplVtables can key a `(T, J)` satentry on it even for an
// interface CollectIfaceIdSyms didn't surface — a 0 there would collapse the
// key to `(ti, 0)`, which a `x.(*OtherJ)` assertion (also 0) would wrongly HIT.
func ensureIfaceIdSym(vm @VM, sym @[]char) int {
	var existing int = lookupDataSymAddr(vm, sym)
	if existing != 0 {
		return existing
	}
	var dgs @[]@irdata.DataGlobal = make_slice(@irdata.DataGlobal, 1)
	dgs[0] = irdata.BuildIfaceId(sym)
	var names @[]@[]char
	var addrs @[]int
	names, addrs = lowerDataGlobals(dgs)
	var addr int = resolveSym(names, addrs, sym)
	vm.dataSymNames.Push(sym)
	vm.dataSymAddrs.Push(addr)
	return addr
}

// registerDataSymAddr binds `addr` under the already-mangled data-symbol `sym`
// in the session-lifetime table (dataSymNames / dataSymAddrs), ignoring a repeat
// (the first binding wins — weak coalescing, like materializeTypeInfos' own
// skip).  The cross-mode counterpart to materializeTypeInfos' inline append:
// RegisterPackageSatEntries (extern_register.bn) uses it to bind a native-only
// injected type's `&TypeInfo(T)` under the NEUTRAL `__typeinfo.<T>` name, so a
// VM concrete assertion `x.(*T)` resolves that name (via BC_DATA_SYM_ADDR) to the
// SAME native address the scrutinee's slot-1 read yields.  `sym` must be owned
// (the table retains it) — the caller copies the native rodata name string.
func registerDataSymAddr(vm @VM, sym @[]char, addr int) {
	if lookupDataSymAddr(vm, sym) != 0 {
		return
	}
	vm.dataSymNames.Push(sym)
	vm.dataSymAddrs.Push(addr)
}

// lookupDataSymAddr returns the runtime address materialized for a data-global
// symbol (an already-mangled `__typeinfo.<T>` name), or 0 if the symbol was not
// materialized.  Linear scan — a program's distinct-type set is small, and this
// is consulted only per assertion (BC_DATA_SYM_ADDR) and per impl vtable
// (fillVtableLayout), not in any hot loop.
func lookupDataSymAddr(vm @VM, sym *[]readonly char) int {
	for i := 0; i < vm.dataSymNames.Len(); i++ {
		if streq2(vm.dataSymNames.Get(i), sym) {
			return vm.dataSymAddrs.Get(i)
		}
	}
	return 0
}
