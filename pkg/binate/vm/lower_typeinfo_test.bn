package "pkg/binate/vm"

import "pkg/binate/buf"
import "pkg/binate/irdata"
import "pkg/builtins/testing"

// Tests for the RTTI data-injection helpers (lower_typeinfo.bn):
// lookupDataSymAddr's table resolution and materializeTypeInfos' end-to-end
// registration of a `__typeinfo.<T>` record.  Runtime correctness of the
// materialized records (assertion HIT/MISS/name-read) is covered by conformance
// 998-1002 across the -int modes; these pin the mechanism at the unit level.

// lookupDataSymAddr resolves a registered data-symbol name to its address and
// returns 0 for an unknown symbol.
func TestLookupDataSymAddr() testing.TestResult {
	var vm @VM = newTestVM(1024)
	// Register through the write path (vecs + dataSymIndex hash stay in sync);
	// a raw vec.Push would leave the hash — which lookupDataSymAddr uses —
	// empty.
	registerDataSymAddr(vm, buf.CopyStr("__typeinfo.A"), 0x1000)
	registerDataSymAddr(vm, buf.CopyStr("__typeinfo.B"), 0x2000)

	if lookupDataSymAddr(vm, buf.CopyStr("__typeinfo.A")) != 0x1000 {
		return "lookupDataSymAddr must resolve the first registered symbol"
	}
	if lookupDataSymAddr(vm, buf.CopyStr("__typeinfo.B")) != 0x2000 {
		return "lookupDataSymAddr must resolve a later registered symbol"
	}
	if lookupDataSymAddr(vm, buf.CopyStr("__typeinfo.Z")) != 0 {
		return "lookupDataSymAddr must return 0 for an unmaterialized symbol"
	}
	return ""
}

// A record whose raw-origin variant's record is registered (a native package's)
// binds to the record that variant names as canonical; with no registered variant,
// or one whose canonical word is not yet set, it is not bound.
func TestBindViaOriginVariant() testing.TestResult {
	var vm @VM = newTestVM(1024)
	var variantRec @[]int = make_slice(int, 12)
	var canonRec @[]int = make_slice(int, 12)
	variantRec[irdata.TYPEINFO_CANONICAL_WORD] = bit_cast(int, &canonRec[0])
	registerDataSymAddr(vm, buf.CopyStr("__typeinfo.V"), bit_cast(int, &variantRec[0]))
	var unset @[]int = make_slice(int, 12)
	registerDataSymAddr(vm, buf.CopyStr("__typeinfo.U"), bit_cast(int, &unset[0]))
	var desc @irdata.TypeInfoDesc = make(irdata.TypeInfoDesc)
	desc.Sym = buf.CopyStr("__typeinfo.T")
	desc.OriginVariantSym = buf.CopyStr("__typeinfo.U")
	if bindViaOriginVariant(vm, desc) || lookupDataSymAddr(vm, desc.Sym) != 0 {
		return "a variant record with no canonical word set should not bind"
	}
	desc.OriginVariantSym = buf.CopyStr("__typeinfo.Z")
	if bindViaOriginVariant(vm, desc) {
		return "an unregistered variant should not bind"
	}
	desc.OriginVariantSym = buf.CopyStr("__typeinfo.V")
	if !bindViaOriginVariant(vm, desc) ||
			lookupDataSymAddr(vm, desc.Sym) != bit_cast(int, &canonRec[0]) {
		return "a registered variant should bind the record to its canonical record"
	}
	return ""
}

// materializeTypeInfos (run inside LowerModule) registers a real, non-zero
// `__typeinfo.<T>` record for each concrete type with a local impl — the record
// address a concrete assertion's static identity operand (BC_DATA_SYM_ADDR)
// resolves to.  A program with one impl'd type must leave exactly such a record
// in the data-symbol table.
func TestMaterializeTypeInfosRegistersRecord() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "interface I { foo() }\n")
	src = concatStr(src, "type T struct { x int }\n")
	src = concatStr(src, "func (t *T) foo() { }\n")
	src = concatStr(src, "impl *T : I\n")
	src = concatStr(src, "func main() { }\n")
	var vm @VM = lowerFromSource(src)
	if vm.dataSymNames.Len() < 1 {
		return "materializeTypeInfos must register a __typeinfo record for an impl'd type"
	}
	// Every registered record must carry a real (non-zero) runtime address —
	// a 0 would make an assertion silently MISS.
	for i := 0; i < vm.dataSymAddrs.Len(); i++ {
		if vm.dataSymAddrs.Get(i) == 0 {
			return "a materialized __typeinfo record must have a non-zero address"
		}
	}
	return ""
}
