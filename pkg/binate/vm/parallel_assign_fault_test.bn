package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A recoverable VM fault raised mid-parallel-assign must not leak the values that
// EARLIER phase-1 entries already acquired.  Parallel assign (`a, b = ...`)
// acquires every managed RHS up front (phase 1) before storing any target (phase
// 2), so the swap idiom is safe; but if a LATER phase-1 entry faults, an earlier
// entry's acquire reference is orphaned (no slot owns it yet).  The fault pad must
// release it — gen_assign_parallel.bn registers each acquire into ctx.Temps, which
// the pad RefDecs — or the block leaks by 1 per faulting call.  Only the bytecode
// VM reaches this (its faults are recoverable; compiled backends stay fatal), so
// these live only here.  The signal is a flat rt.LiveBlocks() across a loop of
// faulting calls: pre-fix it grows by one block per call.

// TestParallelAssignFaultNoLeakScalar covers a managed-scalar (managed-slice)
// acquire: `a, b = make_slice(int, 3), t[5]` acquires the fresh make_slice for
// `a` (entry 0), then entry 1's out-of-bounds `t[5]` faults before any store. The
// fault pad must RefDec the acquired slice; without the fix its slot-acquire
// RefInc leaks the make_slice backing.
func TestParallelAssignFaultNoLeakScalar() testing.TestResult {
	var m @ir.Module = genModule(
			"package \"test\"\n"
					"func doFault() int {\n"
					"	var a @[]int\n"
					"	var b @[]int\n"
					"	var t @[]@[]int = make_slice(@[]int, 1)\n"
					"	a, b = make_slice(int, 3), t[5]\n"
					"	return len(a) + len(b)\n"
					"}\n")
	var vm @VM = newTestVM(testVMStackSize)
	registerTestExterns(vm)
	vm.LowerModule(m)

	var noArgs @[]int
	// Warm up once so any one-time allocation is already in the baseline.
	vm.CallFunc("test.doFault", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "the out-of-bounds parallel-assign RHS must recover with Status = FAULTED"
	}
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc("test.doFault", noArgs)
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated faulting call must recover identically (VM state intact)"
	}
	if rt.LiveBlocks() != base {
		return "fault leaked an acquired managed-slice (acquire RefInc not released by the pad)"
	}
	return ""
}

// TestParallelAssignFaultNoLeakStruct covers the managed struct/array acquire
// path (emitStructCopy into a temp alloca): `a, b = src, t[5]` copy-acquires the
// managed-field struct `src` for `a` (entry 0), then entry 1 faults. The fault pad
// must dtor the acquired temp (releasing the copied field RefInc); without the fix
// the copy of src.data leaks. Exercises the isStructOrArrayAlloc pad arm, distinct
// from the scalar RefInc path above.
func TestParallelAssignFaultNoLeakStruct() testing.TestResult {
	var m @ir.Module = genModule(
			"package \"test\"\n"
					"type Box struct { data @[]int }\n"
					"func doFault() int {\n"
					"	var a Box\n"
					"	var b Box\n"
					"	var src Box\n"
					"	src.data = make_slice(int, 3)\n"
					"	var t @[]Box = make_slice(Box, 1)\n"
					"	a, b = src, t[5]\n"
					"	return len(a.data) + len(b.data)\n"
					"}\n")
	var vm @VM = newTestVM(testVMStackSize)
	registerTestExterns(vm)
	vm.LowerModule(m)

	var noArgs @[]int
	vm.CallFunc("test.doFault", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "the out-of-bounds struct parallel-assign RHS must recover with Status = FAULTED"
	}
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc("test.doFault", noArgs)
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated faulting struct call must recover identically (VM state intact)"
	}
	if rt.LiveBlocks() != base {
		return "fault leaked an acquired struct copy (temp dtor not run by the pad)"
	}
	return ""
}
