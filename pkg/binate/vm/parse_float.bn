package "pkg/binate/vm"

// parseFloatLit converts a Binate float literal's raw source text to
// a float64. Accepts the forms produced by the lexer:
//   - <digits>
//   - <digits>.<digits>
//   - .<digits>
//   - <mantissa>[eE][+-]?<digits>
// Rounds per standard IEEE-754 double conversion.
func parseFloatLit(text *[]readonly char) float64 {
	var n int = len(text)
	if n == 0 { return 0.0 }
	var i int = 0
	var sign float64 = 1.0
	if text[i] == '-' {
		sign = -1.0
		i = i + 1
	} else if text[i] == '+' {
		i = i + 1
	}

	var mantissa float64 = 0.0
	// Integer part.
	for i < n && text[i] >= '0' && text[i] <= '9' {
		mantissa = mantissa * 10.0 +
			cast(float64, cast(int, text[i]) - cast(int, '0'))
		i = i + 1
	}
	// Fractional part.
	if i < n && text[i] == '.' {
		i = i + 1
		var frac float64 = 0.0
		var scale float64 = 1.0
		for i < n && text[i] >= '0' && text[i] <= '9' {
			frac = frac * 10.0 +
				cast(float64, cast(int, text[i]) - cast(int, '0'))
			scale = scale * 10.0
			i = i + 1
		}
		mantissa = mantissa + frac / scale
	}
	// Exponent.
	var expSign int = 1
	var exp int = 0
	if i < n && (text[i] == 'e' || text[i] == 'E') {
		i = i + 1
		if i < n && text[i] == '-' {
			expSign = -1
			i = i + 1
		} else if i < n && text[i] == '+' {
			i = i + 1
		}
		for i < n && text[i] >= '0' && text[i] <= '9' {
			exp = exp * 10 + (cast(int, text[i]) - cast(int, '0'))
			i = i + 1
		}
	}

	var scaling float64 = 1.0
	var absExp int = exp
	if absExp < 0 { absExp = -absExp }
	for j := 0; j < absExp; j++ {
		scaling = scaling * 10.0
	}
	if expSign < 0 {
		mantissa = mantissa / scaling
	} else {
		mantissa = mantissa * scaling
	}
	return sign * mantissa
}
