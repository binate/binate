package "pkg/binate/vm"

import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/iropt"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// A function the passes drop blocks from keeps the fault pads its remaining code lands
// in, and a fault there runs its pad: the VM recovers (Status = FAULTED) without
// leaking, the signal being a flat rt.LiveBlocks() across a loop of faulting calls.

// prunedPadSrc's f(k) faults at t[k] for k >= 2, landing in a pad that releases t.  Its
// other faults lie in blocks no path reaches -- the `if dbg` arm, which a branch on a
// constant false never takes once mem2reg promotes dbg, and the code after the if /
// else, both arms of which return -- and land in pads that also release w or u, locals
// of those blocks.
func prunedPadSrc() *[]readonly char {
	return "package \"test\"\n"
			"func f(k int) int {\n"
			"	var t @[]int = make_slice(int, 2)\n"
			"	t[0] = 10\n"
			"	t[1] = 20\n"
			"	var dbg bool = false\n"
			"	var total int = t[k]\n"
			"	if dbg {\n"
			"		var w @[]int = make_slice(int, 3)\n"
			"		total = total + w[k] + t[k]\n"
			"	}\n"
			"	if k > 100 {\n"
			"		return total\n"
			"	} else {\n"
			"		return total + 1\n"
			"	}\n"
			"	var u @[]int = make_slice(int, 4)\n"
			"	return u[k] + t[k]\n"
			"}\n"
}

// padCountOf returns the number of fault pads of m's function named name, or -1 when m
// has none of that name.
func padCountOf(m @ir.Module, name *[]readonly char) int {
	for i := 0; i < len(m.Funcs); i++ {
		if streq(m.Funcs[i].Name, name) { return len(m.Funcs[i].FaultPads) }
	}
	return -1
}

// withNum returns "<what>: <msg><n>".
func withNum(what *[]readonly char, msg *[]readonly char, n int) @[]char {
	return buf.Concat(buf.Concat(buf.Concat(what, ": "), msg), strconv.Itoa(n))
}

// With the VM's passes, mem2reg drops the code after the if / else and the pads only it
// reached; with branch folding and jump threading as well, the fold drops the `if dbg`
// arm and the pad only it reached too.  Either way f runs, and f(5) faults at t[k],
// recovering through the pad kept for it without leaking.
func TestFaultRunsPadKeptByPruning() testing.TestResult {
	var prev int = padCountOf(genModule(prunedPadSrc()), "test.f")
	if prev < 3 {
		return withNum("IR-gen", "gives f a pad for t[k] and others for the dead code's; pads: ", prev)
	}
	var withFold iropt.OptConfig = iropt.WithOptPass(iropt.VMOptConfig(), iropt.PASS_FOLD_BRANCH, true)
	withFold = iropt.WithOptPass(withFold, iropt.PASS_THREAD_JUMPS, true)
	for ci := 0; ci < 2; ci++ {
		var what *[]readonly char = "the VM's passes"
		var c iropt.OptConfig = iropt.VMOptConfig()
		if ci == 1 {
			what = "the VM's passes with fold-branch and thread-jumps"
			c = withFold
		}
		var m @ir.Module = genModule(prunedPadSrc())
		var vm @VM = newTestVM(testVMStackSize)
		registerTestExterns(vm)
		vm.Opt = c
		vm.LowerModule(m)
		var kept int = padCountOf(m, "test.f")
		if kept < 1 || kept >= prev {
			var msg @[]char = withNum(what, "only t[k]'s pads stay; pads before: ", prev)
			return buf.Concat(buf.Concat(msg, ", after: "), strconv.Itoa(kept))
		}
		prev = kept
		var r int = vm.CallFunc("test.f", args1(1))
		if r != 21 || vm.Status != VM_STATUS_CONTINUE {
			var msg @[]char = withNum(what, "f(1) runs to its end, returning 21; got ", r)
			return buf.Concat(buf.Concat(msg, ", status "), strconv.Itoa(vm.Status))
		}
		var faulted bool
		var flat bool
		faulted, flat = callFaulting(vm, "test.f", args1(5))
		if !faulted {
			return withNum(what, "f(5) faults at t[k] on every call; status ", vm.Status)
		}
		if !flat {
			return buf.Concat(what, ": f(5)'s fault recovers without leaking (rt.LiveBlocks grew)")
		}
		if !faultStrEq(vm.FaultMsg, "runtime error: index out of bounds: 5 (len 2)") {
			return buf.Concat(buf.Concat(what, ": the fault is t[k]'s; got: "), vm.FaultMsg)
		}
	}
	return ""
}
