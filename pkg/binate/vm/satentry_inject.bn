package "pkg/binate/vm"

import "pkg/stdx/slices"

// Injected interface-satisfaction registry — the cross-mode counterpart to
// vtable_inject.bn's injected-vtable table.  A native-only package skips VM
// lowering, so its `__satentry.<T,J>` satisfaction facts (the distributed RTTI
// registry, spec §11.12 `iface.rtti`) never reach a VM-side structure.
// RegisterPackageSatEntries (extern_register.bn) instead binds each entry's
// three raw addresses here, read out of the package's reflect descriptor
// (`Package.SatEntries`).  The Phase-5 assertion reader will consult this
// registry to resolve a scrutinee's `(TypeInfo, IfaceId)` to the sub-vtable an
// `x.(*J)` recovers — the itab lookup — the way lookupVtableAddr backstops a
// bytecode-built interface value.  Until that reader lands the registry is
// populated but not yet read (inert-but-wired, mirroring how the 3c-1 descriptor
// slice lists the nodes before any consumer walks them).

// registerSatEntry records one interface-satisfaction fact `(T, J)`, keyed by
// the `&TypeInfo(T)` and `&IfaceId(J)` raw addresses and valued by the
// `&__ivt.<T>__<J>` sub-vtable address — appending to the VM's per-instance
// registry (vm.satEntryTypes / satEntryIfaces / satEntryVtables, three parallel
// slices).  All three are raw global addresses the descriptor already resolved,
// so — unlike registerVtableAddr — there is no name to copy into owned storage.
func registerSatEntry(vm @VM, typeAddr int, ifaceAddr int, vtableAddr int) {
	vm.satEntryTypes = slices.Append[int](vm.satEntryTypes, typeAddr)
	vm.satEntryIfaces = slices.Append[int](vm.satEntryIfaces, ifaceAddr)
	vm.satEntryVtables = slices.Append[int](vm.satEntryVtables, vtableAddr)
}

// lookupSatEntry resolves an interface-satisfaction query `(TypeInfo, IfaceId)`
// to the registered sub-vtable WORD, or 0 (MISS) if the pair is not registered.
// The VM-side itab reader — the counterpart to the native rt.SatLookup, which
// the OP_SAT_LOOKUP lowering routes here for the bytecode VM (the native rt
// itab-hash is never built in the VM, so its own registry, filled by
// lowerImplVtables for VM-lowered impls and RegisterPackageSatEntries for
// injected native-only packages, is the source of truth).  Linear scan mirrors
// lookupVtableAddr — the registered set is small and this runs only per
// interface-target assertion.  The returned word is a 1-based vm.IfaceVtables
// index for a VM-lowered `(T, J)` (so the recovered iface value dispatches
// through the VM) or a native `@__ivt` sub-vtable address for an injected
// package (ifaceVtIsNative discriminates the two at use).
func lookupSatEntry(vm @VM, typeAddr int, ifaceAddr int) int {
	for i := 0; i < len(vm.satEntryTypes); i++ {
		if vm.satEntryTypes[i] == typeAddr && vm.satEntryIfaces[i] == ifaceAddr {
			return vm.satEntryVtables[i]
		}
	}
	return 0
}
