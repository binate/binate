package "pkg/binate/vm"

import "pkg/builtins/testing"

// Tests for satentry_inject.bn — the injected interface-satisfaction registry
// that RegisterPackageSatEntries populates and the Phase-5 assertion reader will
// consult.  No lookup helper exists yet (its only consumer is the not-yet-landed
// reader), so these read the parallel registry slices directly to pin that
// registerSatEntry appends each `(TypeInfo, IfaceId) -> sub-vtable` triple.

// registerSatEntry appends one satisfaction fact per call, keyed by the
// &TypeInfo(T) / &IfaceId(J) addresses and valued by the &__ivt.<T>__<J>
// sub-vtable address, into three parallel per-instance slices.
func TestSatEntryInjectRegistry() testing.TestResult {
	var vm @VM = make(VM)
	registerSatEntry(vm, 0x1000, 0x2000, 0x3000)
	registerSatEntry(vm, 0x1100, 0x2000, 0x3100)

	if len(vm.satEntryTypes) != 2 {
		return "two registrations should append two entries"
	}
	if len(vm.satEntryIfaces) != 2 || len(vm.satEntryVtables) != 2 {
		return "the three parallel slices must stay the same length"
	}
	if vm.satEntryTypes[0] != 0x1000 || vm.satEntryIfaces[0] != 0x2000 ||
			vm.satEntryVtables[0] != 0x3000 {
		return "entry 0 should store its (TypeInfo, IfaceId, sub-vtable) triple"
	}
	// The second entry shares IfaceId J (two types implementing the same
	// interface) but carries its own type token and sub-vtable.
	if vm.satEntryTypes[1] != 0x1100 || vm.satEntryIfaces[1] != 0x2000 ||
			vm.satEntryVtables[1] != 0x3100 {
		return "entry 1 should store its own type + sub-vtable under the shared IfaceId"
	}
	return ""
}

// Per-instance isolation: entries registered on one VM must NOT be visible on a
// second VM (the embeddability guarantee — same as the injected-vtable registry).
func TestSatEntryInjectPerInstanceIsolation() testing.TestResult {
	var a @VM = make(VM)
	registerSatEntry(a, 0x1000, 0x2000, 0x3000)
	var b @VM = make(VM)
	if len(b.satEntryTypes) != 0 {
		return "a satisfaction entry registered on VM a must not appear on VM b"
	}
	if len(a.satEntryTypes) != 1 {
		return "VM a must still hold its own registered entry"
	}
	return ""
}
