package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// Fault ops whose live set is the same land in one cleanup pad (IR-gen shares it),
// so a fault at any of them — not only the first — runs that pad.  These tests run
// programs whose later fault sites share a pad (in an if / else arm, in a loop, with
// a managed temporary live) and fault there: the VM must recover (Status =
// FAULTED) without leaking, the signal being a flat rt.LiveBlocks() across a loop
// of faulting calls.

// sharedPadSrc's fault(k, n) declares a managed slice, then indexes it in a then
// arm, an else arm and a loop — fault sites with the same live set; temp(i) indexes
// a managed temporary while the slice is live.
func sharedPadSrc() *[]readonly char {
	return "package \"test\"\n"
			"func fault(k int, n int) int {\n"
			"	var s @[]int = make_slice(int, 2)\n"
			"	var total int = s[0]\n"
			"	if k > 0 {\n"
			"		total = total + s[1]\n"
			"	} else {\n"
			"		total = total + s[k + 3]\n"
			"	}\n"
			"	for i := 0; i < n; i++ {\n"
			"		total = total + s[i]\n"
			"	}\n"
			"	return total + 7\n"
			"}\n"
			"func mk() @[]int { return make_slice(int, 2) }\n"
			"func temp(i int) int {\n"
			"	var s @[]int = make_slice(int, 2)\n"
			"	return s[0] + mk()[i] + s[1] + 5\n"
			"}\n"
}

// faultOpsAndPads counts m's fault ops (instructions with a cleanup pad) and the
// distinct pads they land in.
func faultOpsAndPads(m @ir.Module) (int, int) {
	var ops int = 0
	var pads @[]*ir.Block
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @ir.Func = m.Funcs[fi]
		for bi := 0; bi < len(f.Blocks); bi++ {
			for ii := 0; ii < len(f.Blocks[bi].Instrs); ii++ {
				var pad *ir.Block = f.Blocks[bi].Instrs[ii].PadBlock
				if pad == nil { continue }
				ops++
				var seen bool = false
				for k := 0; k < len(pads); k++ {
					if pads[k] == pad { seen = true }
				}
				if !seen {
					var grown @[]*ir.Block = make_slice(*ir.Block, len(pads) + 1)
					for k := 0; k < len(pads); k++ { grown[k] = pads[k] }
					grown[len(pads)] = pad
					pads = grown
				}
			}
		}
	}
	return ops, len(pads)
}

// callFaulting calls fn with args once (a warm-up), then 20 times more, and
// reports whether every call faulted and rt.LiveBlocks() stayed where it was after
// the first.
func callFaulting(vm @VM, fn *[]readonly char, args @[]int) (bool, bool) {
	vm.CallFunc(fn, args)
	if vm.Status != VM_STATUS_FAULTED { return false, true }
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc(fn, args)
		if vm.Status != VM_STATUS_FAULTED { return false, true }
	}
	return true, rt.LiveBlocks() == base
}

// args2 returns the argument list (a, b).
func args2(a int, b int) @[]int {
	var r @[]int = make_slice(int, 2)
	r[0] = a
	r[1] = b
	return r
}

// args1 returns the argument list (a).
func args1(a int) @[]int {
	var r @[]int = make_slice(int, 1)
	r[0] = a
	return r
}

// The program's fault sites do share pads, it runs normally when nothing faults,
// and a fault at a later site of a shared pad — in a then arm's loop, in an else
// arm, at an index of a managed temporary — recovers without leaking.
func TestSharedFaultPadRecoversWithoutLeak() testing.TestResult {
	var m @ir.Module = genModule(sharedPadSrc())
	var ops int
	var pads int
	ops, pads = faultOpsAndPads(m)
	if pads == 0 || ops <= pads { return "the program's fault sites must share pads" }
	var vm @VM = newTestVM(testVMStackSize)
	registerTestExterns(vm)
	vm.LowerModule(m)

	if vm.CallFunc("test.fault", args2(1, 2)) != 7 || vm.Status != VM_STATUS_CONTINUE {
		return "fault(1, 2) runs to its end"
	}
	if vm.CallFunc("test.temp", args1(1)) != 5 || vm.Status != VM_STATUS_CONTINUE {
		return "temp(1) runs to its end"
	}
	var faulted bool
	var flat bool
	faulted, flat = callFaulting(vm, "test.fault", args2(1, 5))
	if !faulted || !flat { return "a fault in the loop recovers without leaking" }
	faulted, flat = callFaulting(vm, "test.fault", args2(-9, 0))
	if !faulted || !flat { return "a fault in the else arm recovers without leaking" }
	faulted, flat = callFaulting(vm, "test.temp", args1(5))
	if !faulted || !flat { return "a fault at a managed temporary's index recovers without leaking" }
	return ""
}
