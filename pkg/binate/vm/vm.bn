package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/std/vec"

// REG_SLOT is the size in bytes of one VM register slot — the host
// word size.  Registers hold host-word values (pointers, `int`); a
// 64-bit value on a 32-bit host spans two adjacent slots.  Frame
// layout math sizes the register area as NumRegs * REG_SLOT, so
// register-slot stride
// equals the `regs *int` access stride on every host.
const REG_SLOT int = cast(int, sizeof(int))

// MANAGED_HDR is the size in bytes of pkg/builtins/rt's managed-allocation
// header — `sizeof(rt.ManagedHeader)`.  Declared locally as a
// sibling of REG_SLOT / FRAME_HDR because current bnc doesn't
// const-fold cross-package `sizeof(rt.X)` at the use site (the
// inline BC_REFINC_INLINE / BC_REFDEC_INLINE_FAST handlers reach
// the header via `ptr - MANAGED_HDR`, which needs a same-package
// const).  16 on LP64, 8 on a 32-bit host.  Stays in lockstep
// with rt.ManagedHeader's layout — bump the formula here if the
// struct changes.
const MANAGED_HDR int = cast(int, sizeof(rt.ManagedHeader))

// Frame header size: 6 words (savedPC, savedFuncIdx,
// savedRegsOff, savedSP, callerDst, freeOnPop), each one host word.
//
// freeOnPop carries a managed-pointer payload that BC_RETURN
// rt.Free's after popping the frame. Used by the iterative dtor
// dispatch in BC_REFDEC_INLINE_FAST: instead of recursing through
// execFunc → execLoop (which grows the host stack per dtor cascade
// level), BC_REFDEC_INLINE_FAST pushes a frame for the dtor like
// BC_CALL does and stashes the ptr-to-free here. The dtor runs in
// the same execLoop iteration; on return, the pop frees the
// payload. 0 = no action.
const FRAME_HDR int = 6 * REG_SLOT

// NewVM allocates a VM with a zero-initialized stack.
func NewVM(stackSize int) @VM {
	var vm @VM = make(VM)
	// stackBuf owns the backing (managed → freed by @VM's dtor); Stack is a raw
	// view into it.  make_slice zero-fills, so no explicit MemZero is needed.
	vm.stackBuf = make_slice(uint8, stackSize)
	vm.Stack = &vm.stackBuf[0]
	vm.StackSize = stackSize
	// Reserve 1/16 of the stack as the recoverable-overflow unwind red zone (Plan 2);
	// an embedder may override vm.StackRedZone before running.  See pushFrame.
	vm.StackRedZone = stackSize / 16
	vm.SP = 0
	// The per-VM growable tables — the function table (lower.bn) and the session
	// registries: interface-satisfaction (satentry_inject.bn), global-var addresses
	// (lower_data.bn), injected vtables (vtable_inject.bn), materialized data symbols
	// (lower_typeinfo.bn), and VM-lowered interface vtables (lower.bn) — are @vec.Vec
	// fields; initialize their backing vectors so Push paths (and a pre-population
	// bounds read, e.g. a func-index range check) have a live target.  Any VM that
	// grows them must be built here (a bare `make(VM)` leaves the vectors nil); all
	// lowering and every vm unit test construct via NewVM.
	vm.satEntryTypes = vec.New[int]()
	vm.satEntryIfaces = vec.New[int]()
	vm.satEntryVtables = vec.New[int]()
	vm.globalNames = vec.New[@[]char]()
	vm.globalAddrs = vec.New[int]()
	vm.vtableInjNames = vec.New[@[]char]()
	vm.vtableInjAddrs = vec.New[int]()
	vm.vtableInjShims = vec.New[int]()
	vm.vtableInjSizes = vec.New[int]()
	vm.dataSymNames = vec.New[@[]char]()
	vm.dataSymAddrs = vec.New[int]()
	vm.ownedBlocks = vec.New[@[]uint8]()
	vm.IfaceVtables = vec.New[@IfaceVtable]()
	vm.Funcs = vec.New[@VMFunc]()
	return vm
}

// vmOwn allocates `sz` zero-filled bytes as a managed @[]uint8 owned by the VM
// (pushed onto ownedBlocks, freed by the @VM destructor at teardown) and returns
// the raw base pointer for the existing address-based uses.  It replaces a raw
// rt.RawAlloc(sz)+MemZero for a block whose lifetime should follow the VM: the
// backing slice carries the refcount and make_slice zero-fills, so callers get
// the same zeroed block they did before, now reclaimed instead of leaked.  sz
// must be > 0 (every static-data / global block is).
func vmOwn(vm @VM, sz int) *uint8 {
	var b @[]uint8 = make_slice(uint8, sz)
	vm.ownedBlocks.Push(b)
	return &b[0]
}

// TrampolineScalar is a generic ABI-aware bridge: compiled code
// calls it through a VM-side function value's vtable.call slot,
// passing data as the first arg and user args in subsequent
// register slots per AAPCS. The trampoline reads the VM handle
// and vm_func_idx from data, packs the user args into argv, and
// dispatches via execFunc.
//
// Variadic-style register reading: the trampoline accepts a fixed
// 7-arg shape (a0..a6). Callers bitcast vtable.call to their
// function value's actual signature (typically narrower) and call
// with whatever args they have. Per AAPCS, register args land in
// X1..X7 deterministically; the trampoline reads only the first
// f.NumParams of them (execFunc uses len(args) and f.NumParams to
// limit the copy). Args beyond the caller's actual count are
// uninitialized but unread — sound on AAPCS, equivalent to how
// variadic C functions work.
//
// Shape constraint: scalars + pointers + bools only,
// no floats, no aggregates pass through. ≤7 user args. Broader
// signatures need a different shape (additional V-register
// trampoline or the always-pack convention) — out of scope here.
//
// Used by VM-side function values constructed in BC_FUNC_VALUE;
// see vm_exec_helpers.bn.
func TrampolineScalar(data *uint8, a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int) int {
	if data == nil {
		vmPanic("vm: TrampolineScalar called with nil data")
	}
	var rec *int = bit_cast(*int, data)
	if rec[0] != rt.DATA_KIND_VM_CLOSURE_REC {
		vmPanic("vm: TrampolineScalar: data is not a VM closure record")
	}
	var vmAddr int = rec[1]
	if vmAddr == 0 {
		vmPanic("vm: TrampolineScalar: closure record has nil VM handle")
	}
	var vm @VM = bit_cast(@VM, vmAddr)
	var fnIdx int = rec[2] - 1
	if fnIdx < 0 || fnIdx >= vm.Funcs.Len() {
		vmPanic("vm: TrampolineScalar: vm_func_idx out of range")
	}
	var argv @[]int = make_slice(int, 7)
	argv[0] = a0
	argv[1] = a1
	argv[2] = a2
	argv[3] = a3
	argv[4] = a4
	argv[5] = a5
	argv[6] = a6
	// One host word: TrampolineScalar is selected (ensureHandle) only for a
	// result that fits one register; a 64-bit scalar result uses
	// TrampolineScalar64 instead.  Narrow execFunc's int64 to the low word.
	return cast(int, execFunc(vm, fnIdx, argv))
}

// TrampolineScalar64 is the 64-bit-scalar-return counterpart of
// TrampolineScalar, selected by ensureHandle when a VM func's single result is
// a bare int64 / uint64 / float64 on a host whose word is < 8 bytes.  The
// compiled caller invokes vtable.call typed `i64(i8*, args)` (funcSignatureLLVM
// → writeShimResultLLVM declares an i64 return for a 64-bit scalar), so the
// trampoline must return the full int64 (r0:r1 on AAPCS32) — execFunc already
// yields it.  On a 64-bit host int64 fits one register, so this trampoline is
// never selected (ensureHandle's REG_SLOT < 8 gate) and TrampolineScalar is used.
func TrampolineScalar64(data *uint8, a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int) int64 {
	if data == nil {
		vmPanic("vm: TrampolineScalar64 called with nil data")
	}
	var rec *int = bit_cast(*int, data)
	if rec[0] != rt.DATA_KIND_VM_CLOSURE_REC {
		vmPanic("vm: TrampolineScalar64: data is not a VM closure record")
	}
	var vmAddr int = rec[1]
	if vmAddr == 0 {
		vmPanic("vm: TrampolineScalar64: closure record has nil VM handle")
	}
	var vm @VM = bit_cast(@VM, vmAddr)
	var fnIdx int = rec[2] - 1
	if fnIdx < 0 || fnIdx >= vm.Funcs.Len() {
		vmPanic("vm: TrampolineScalar64: vm_func_idx out of range")
	}
	var argv @[]int = make_slice(int, 7)
	argv[0] = a0
	argv[1] = a1
	argv[2] = a2
	argv[3] = a3
	argv[4] = a4
	argv[5] = a5
	argv[6] = a6
	return execFunc(vm, fnIdx, argv)
}

// TrampolineAggregate is the aggregate-return counterpart of
// TrampolineScalar.  Compiled code calls it through a VM-side
// function value's vtable.call slot when the function value's
// return type is multi-word (slice / managed-slice / multi-word
// struct).
//
// Convention: matches the aggregate-shim shape (`void(i8* retbuf,
// i8* data, args...)`).  The retbuf is a caller-allocated buffer
// of the function's return-type size; the trampoline writes the
// VM-side bytecode function's result there and returns void.
//
// Implementation: the bytecode VMFunc's BC_RETURN packs aggregate
// returns onto vm.Stack and returns the address.  This trampoline
// dispatches via execFunc, gets the resulting address, and
// memcpys ResultSizes[0] bytes (taken from the VMFunc's metadata)
// into retbuf.
//
// Used by VM-side function values whose return type is aggregate;
// vtable.call selection happens in BC_FUNC_VALUE (vm_exec_helpers.bn).
func TrampolineAggregate(retbuf *uint8, data *uint8, a0 int, a1 int, a2 int, a3 int, a4 int, a5 int,
		a6 int) {
	if data == nil {
		vmPanic("vm: TrampolineAggregate called with nil data")
	}
	var rec *int = bit_cast(*int, data)
	if rec[0] != rt.DATA_KIND_VM_CLOSURE_REC {
		vmPanic("vm: TrampolineAggregate: data is not a VM closure record")
	}
	var vmAddr int = rec[1]
	if vmAddr == 0 {
		vmPanic("vm: TrampolineAggregate: closure record has nil VM handle")
	}
	var vm @VM = bit_cast(@VM, vmAddr)
	var fnIdx int = rec[2] - 1
	if fnIdx < 0 || fnIdx >= vm.Funcs.Len() {
		vmPanic("vm: TrampolineAggregate: vm_func_idx out of range")
	}
	var f @VMFunc = vm.Funcs.Get(fnIdx)
	if len(f.ResultSizes) != 1 {
		vmPanic("vm: TrampolineAggregate: aggregate return must be single-result")
	}
	var argv @[]int = make_slice(int, 7)
	argv[0] = a0
	argv[1] = a1
	argv[2] = a2
	argv[3] = a3
	argv[4] = a4
	argv[5] = a5
	argv[6] = a6
	// The aggregate result is an ADDRESS (a host word); narrow execFunc's int64.
	var resultAddr int = cast(int, execFunc(vm, fnIdx, argv))
	rt.MemCopy(retbuf, bit_cast(*readonly uint8, resultAddr), f.ResultSizes[0])
	// Cross-mode RETURN direction: if the result is
	// (or contains) an interface value implemented by a bytecode impl, its vtable
	// word in the just-copied retbuf is a VM index the native caller cannot
	// dereference.  Substitute each for the impl's native handle-vtable in the
	// retbuf COPY (native-owned; the VM's own box is untouched, so identity holds).
	if len(f.ResultIfaceVtOffsets) > 0 {
		substituteVtWords(vm, bit_cast(int, retbuf), f.ResultIfaceVtOffsets)
	}
}

// LookupFunc returns the index of a function by name, or -1.
// Uses strict exact match: names are qualified at lowering time
// (see qualifyCallName in lower.bn), so callers must use the
// fully-qualified form (e.g. "asm.New", "main.main").  O(1) via
// the per-VM name→idx hash (`vm.IndexBuckets`); the hash is kept
// in sync by `LowerModule` and `LowerOneFunc` whenever a VMFunc
// enters or replaces an entry in `vm.Funcs`.
func (vm @VM) LookupFunc(name *[]readonly char) int {
	return funcIndexLookup(vm, name)
}

// SetPoll installs the host's cooperative-interrupt delegate and arms
// the poll fast-path gate.  See the interrupt-seam fields on VM.
func (vm @VM) SetPoll(poll @func(@VM) int) {
	vm.Poll = poll
	vm.PollEnabled = true
}

// Resume continues a suspended VM.  No-op in v1 — the poll seam is
// inert so a VM never suspends; the suspend stage fills in the
// reload-from-Resume* path.
func (vm @VM) Resume() int {
	return 0
}

// CallFunc looks up a function by name and executes it.
func (vm @VM) CallFunc(name *[]readonly char, args @[]int) int {
	var idx int = vm.LookupFunc(name)
	if idx < 0 {
		vmPanicName("vm: function not found: ", name)
	}
	// Start each top-level host call from a clean interrupt / fault status, so a
	// prior call's (future) Suspend/Break or (Plan 2) fault does not leak into
	// this one.
	vm.Status = VM_STATUS_CONTINUE
	var noFaultMsg @[]char
	vm.FaultMsg = noFaultMsg
	vm.FaultRaised = false
	vm.CleanupDepth = 0
	// Host API is one word: a 64-bit-scalar top-level result is truncated to its
	// low word here (host callers use CallFunc for exit codes / addresses).  A
	// native caller that needs the full 64 bits goes through the func-value
	// vtable.call (TrampolineScalar64), not CallFunc.
	return cast(int, execFunc(vm, idx, args))
}

// CallByVMFunc executes a previously-lowered VMFunc directly,
// skipping the LookupFunc-by-name path.  REPL entry point: after
// LowerOneFunc returns the synthetic __repl_n func, the prompt
// invokes it without going through the named-lookup path.  Args
// are 1-word integer values; for void functions pass an empty
// slice and ignore the return.  Returns 0 if vmf is not present
// in vm.Funcs (defensive — shouldn't happen if it was just
// lowered into this VM).
func (vm @VM) CallByVMFunc(vmf @VMFunc, args @[]int) int {
	vm.Status = VM_STATUS_CONTINUE
	var noFaultMsg @[]char
	vm.FaultMsg = noFaultMsg
	vm.FaultRaised = false
	vm.CleanupDepth = 0
	for i := 0; i < vm.Funcs.Len(); i++ {
		if vm.Funcs.Get(i) == vmf {
			return cast(int, execFunc(vm, i, args))
		}
	}
	return 0
}

// pushFrame allocates a call frame on the VM stack and returns
// the offset of the register area.
func pushFrame(vm @VM, f @VMFunc, savedPC int, savedFuncIdx int, savedRegsOff int, savedSP int,
		callerDst int) int {
	var frameStart int = vm.SP
	var totalSize int = FRAME_HDR + f.NumRegs * REG_SLOT + f.FrameSize
	// Recoverable stack-overflow (Plan 2): a NORMAL user-call push (CleanupDepth == 0)
	// must stop StackRedZone short of the end so a fault has room to UNWIND — its
	// cleanup pads may push destructor frames.  A cleanup push (CleanupDepth > 0) IS
	// that unwind and gets the FULL stack (the reserved red zone); a cascade deeper
	// than the whole stack overflows here with CleanupDepth > 0, so setFault vmPanics
	// (the §6 fatal-in-cleanup guard) rather than starting a second unwind.
	var limit int = vm.StackSize
	if vm.CleanupDepth == 0 {
		var rz int = vm.StackRedZone
		// Defensive: a pathological embedder value (negative, or >= the whole stack)
		// would make every normal push fault and render the VM unusable.  Fall back to
		// no reservation — recovery then degrades to best-effort with no unwind
		// headroom, but the VM still runs.
		if rz < 0 || rz >= vm.StackSize {
			rz = 0
		}
		limit = vm.StackSize - rz
	}
	if frameStart + totalSize > limit {
		// No frame pushed: setFault flags the recoverable fault (the caller sees
		// FaultRaised and dispatches to the call op's cleanup pad, or — at the entry
		// frame — returns FAULTED to the host).  -1 is an unused-regsOff sentinel; on
		// the CleanupDepth > 0 path setFault vmPanics and never returns it.
		setFault(vm, "runtime error: stack overflow")
		return -1
	}
	// Write header
	var hdr *int = stackPtr(vm, frameStart)
	hdr[0] = savedPC
	hdr[1] = savedFuncIdx
	hdr[2] = savedRegsOff
	hdr[3] = savedSP
	hdr[4] = callerDst
	hdr[5] = 0 // freeOnPop default (no action)
	// Zero registers and allocas
	var regsOff int = frameStart + FRAME_HDR
	rt.MemZero(bit_cast(*uint8, stackPtr(vm, regsOff)), f.NumRegs * REG_SLOT + f.FrameSize)
	vm.SP = frameStart + totalSize
	return regsOff
}

// stackPtr returns a *int at the given offset into vm.Stack.
func stackPtr(vm @VM, off int) *int {
	return bit_cast(*int, bit_cast(int, vm.Stack) + off)
}

// pushManagedSlice copies a 4-word @[]char managed-slice header ({data,
// len, refptr, backingLen}) from src onto the VM stack.  The byte count
// is 4 target words (4*REG_SLOT), not a hardcoded 32 (which is 4*8, LP64
// only — on a 32-bit host it would copy 16 bytes of adjacent stack past
// the header).
func pushManagedSlice(vm @VM, src *uint8) int {
	var addr int = bit_cast(int, vm.Stack) + vm.SP
	vm.SP = vm.SP + 4 * REG_SLOT
	rt.MemCopy(bit_cast(*uint8, addr), src, 4 * REG_SLOT)
	return addr
}

// streq returns true if two char slices have identical content.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// RegisterExtern binds a name to a compiled-side function value.
// Reads the 16-byte {vtable, data} pair at fvAddr, copies it into a
// fresh ExternBinding, and appends to vm.Externs.  Re-registration
// of an existing name overwrites the prior binding (no list growth)
// — supports late-binding patterns at startup without leaking
// duplicate entries.
//
// retbufSize is the aggregate RETBUF size (0 for a scalar/void return,
// else types.AggregateReturnSize — the rounded retbuf byte count) and
// selects the dispatch path: 0 -> rt._call_shim_scalar (int return),
// > 0 -> rt._call_shim_aggregate (retbuf of retbufSize bytes).  Pass 0
// for ANY scalar/pointer/void return; a nonzero scalar size would wrongly
// dispatch as aggregate.
//
// The Name field stores its own managed-slice copy of the input
// name so the registry's lifetime is independent of the caller's
// string source.
func (vm @VM) RegisterExtern(name *[]readonly char, fvAddr *uint8, retbufSize int, rawFnAddr int) {
	if fvAddr == nil {
		vmPanic("vm: RegisterExtern: nil fvAddr")
	}
	var fv *int = bit_cast(*int, fvAddr)
	var vtableAddr int = fv[types.FuncValueVtableIndex()]
	var dataAddr int = fv[types.FuncValueDataIndex()]
	// Build a managed copy of the caller's function-value handle so
	// the binding owns it: even if the source was a static
	// `@__handle.F` global (native registrants) we end up with a
	// uniform heap allocation, and if the source was a heap handle
	// from a VMFunc the binding's lifetime is decoupled from the
	// originating VMFunc.  rawFnAddr == 0 → leave HandleAddr nil
	// (legacy callers that didn't supply a handle).
	var handleCopy @VMFuncHandle
	if rawFnAddr != 0 {
		handleCopy = make(VMFuncHandle)
		var srcHandle *int = bit_cast(*int, rawFnAddr)
		handleCopy.VtableAddr = srcHandle[types.FuncValueVtableIndex()]
		handleCopy.DataAddr = srcHandle[types.FuncValueDataIndex()]
	}
	// Replace if name already registered (O(1) via the extern hash).
	var existing int = externIndexLookup(vm, name)
	if existing >= 0 {
		vm.Externs[existing].VtableAddr = vtableAddr
		vm.Externs[existing].DataAddr = dataAddr
		vm.Externs[existing].RetbufSize = retbufSize
		vm.Externs[existing].HandleAddr = handleCopy
		return
	}
	// Append new binding.  Copy the bytes byte-by-byte into a
	// fresh @[]char the binding (and the hash entry) share, so the
	// registry's lifetime is decoupled from the caller's source.
	var nameCopy @[]char = make_slice(char, len(name))
	for i := 0; i < len(name); i++ {
		nameCopy[i] = cast(char, name[i])
	}
	var binding ExternBinding = ExternBinding{
			Name: nameCopy, VtableAddr: vtableAddr, DataAddr: dataAddr, RetbufSize: retbufSize,
			HandleAddr: handleCopy}
	// Amortized-doubling append: copy the prior bindings only when the
	// backing is full, so registering N externs is O(N) total rather
	// than the O(N²) that a grow-by-one copy-all incurred (each copy
	// refcounts every prior binding's managed Name/HandleAddr).
	if vm.ExternsLen == len(vm.Externs) {
		var newCap int = len(vm.Externs) * 2
		if newCap == 0 { newCap = 8 }
		var grown @[]ExternBinding = make_slice(ExternBinding, newCap)
		for i := 0; i < vm.ExternsLen; i++ {
			grown[i] = vm.Externs[i]
		}
		vm.Externs = grown
	}
	var idx int = vm.ExternsLen
	vm.Externs[idx] = binding
	vm.ExternsLen = vm.ExternsLen + 1
	externIndexSet(vm, nameCopy, idx)
}

// LookupExtern returns the index of a registered extern by name,
// or -1.  O(1) via the extern name→index hash (externIndexLookup).
func (vm @VM) LookupExtern(name *[]readonly char) int {
	return externIndexLookup(vm, name)
}

// ExternCount returns the number of registered externs — the logical
// length of vm.Externs, which may have a longer amortized backing.
func (vm @VM) ExternCount() int {
	return vm.ExternsLen
}
