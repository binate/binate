package "pkg/binate/vm"

import "pkg/binate/types"

// Cross-mode 64-bit-SCALAR return transport on a <8-byte-word (ILP32) VM host.
//
// A bare int64 / uint64 / float64 return is a register PAIR on ILP32 (SizeOf 8 >
// PointerSize 4), NOT a retbuf aggregate — types.IsAggregateReturn gates on
// aggregate KIND, so a 64-bit scalar takes the scalar shim shape.  The
// per-function cross-mode shim correctly returns it as an i64 (r0:r1), but the
// default scalar dispatch primitive rt._call_shim_scalar returns ONE host word
// (i32 on ILP32), dropping the high half.  The dispatchers detect a 64-bit
// scalar return (a flag stamped at lower time) and read it back via the wide
// rt._call_shim_scalar64 (i64), splitting into the destination register pair.
//
// This file holds the flag encoding + the shared read-back so the four dispatch
// sites (dispatchCompiledFuncValue, dispatchCompiledIfaceMethod, the BC_CALL
// extern arm, dispatchNativeIndirect) and their lower-time producers in
// lower_call.bn cannot drift.

// BC_CALL_RET_SCALAR64 marks a BC_CALL whose result is a 64-bit scalar returned
// as a register pair.  It rides a high bit of the Imm slot-count field (BC_CALL
// has no spare register/Aux slot); bit 20 sits far above any realistic packed
// slot count and far below the sign bit even on a 32-bit build host.
const BC_CALL_RET_SCALAR64 int = 1048576 // 1 << 20

// is64BitScalarReturn reports whether a call whose result type is t needs the
// wide (register-pair) cross-mode return: t is a 64-bit scalar and the host word
// (wordSize) cannot hold it in one slot.  This is the SAME predicate regWidths
// uses to make the result register wide, so the pair read-back fills exactly the
// two slots the allocator reserved.  Live callers pass REG_SLOT; tests pass an
// explicit width for host independence.
func is64BitScalarReturn(t @types.Type, wordSize int) bool {
	return is64BitScalar(t) && wordSize < 8
}

// packRetbufScalar64 folds the scalar64 flag into a retbuf-size field.  Retbuf
// sizes are always a multiple of 8 (types.AggregateReturnSize rounds up), so bit
// 0 is free; a 64-bit scalar has retbuf size 0, so its field is just the flag
// bit.  Used for BC_CALL_FUNC_VALUE's Aux and the low 21-bit sub-field of
// BC_CALL_IFACE_METHOD's Aux; decode with retbufFieldBytes / retbufFieldScalar64.
func packRetbufScalar64(retbufSize int, scalar64 bool) int {
	if scalar64 { return retbufSize | 1 }
	return retbufSize
}

// retbufFieldBytes returns the retbuf byte size from a packed field, with the
// scalar64 flag bit removed — the size to reserve on vm.Stack (0 for a scalar).
// The flag is bit 0 and a real size is a multiple of 8, so subtracting bit 0
// recovers the size exactly.
func retbufFieldBytes(field int) int {
	return field - (field & 1)
}

// retbufFieldScalar64 reports whether a packed retbuf field carries the scalar64
// flag.
func retbufFieldScalar64(field int) bool {
	return (field & 1) != 0
}

// ARG_IFACE_LAYOUT_MASK bounds the 1-based per-function argument-interface-layout
// index every cross-mode call instruction carries in free Imm bits (0 = the call
// passes no interface value).  10 bits (≤ 1023) is far more than the distinct
// interface-arg call sites any single function has — buildArgIfaceLayout guards
// against overflow rather than silently truncating.  The index selects the
// caller VMFunc.ArgIfaceLayouts entry that lists which arg slots carry interface
// vtable words (top-level OR nested) and where — replacing the flat 7-bit per-
// slot bitmap S2/S3 used, which could not carry per-arg nested field offsets.
const ARG_IFACE_LAYOUT_MASK int = 1023

// BC_CALL_LAYOUT_SHIFT positions the argument-interface-layout index in a BC_CALL
// Imm: bits [21, 30].  It sits ABOVE the scalar64 flag (bit 20) and the packed
// slot count (bits 0..19), and below the sign bit even on a 32-bit build host.
const BC_CALL_LAYOUT_SHIFT int = 21

// packCallImm folds the scalar64 flag and the argument-interface-layout index
// into a BC_CALL packed slot count.  A slot count is far below BC_CALL_RET_
// SCALAR64 (bit 20), and the layout index occupies bits at/above BC_CALL_LAYOUT_
// SHIFT (bit 21), so the three fields never collide.
func packCallImm(slots int, scalar64 bool, layoutIdx int) int {
	var imm int = slots | (layoutIdx << BC_CALL_LAYOUT_SHIFT)
	if scalar64 { imm = imm | BC_CALL_RET_SCALAR64 }
	return imm
}

// callImmSlots returns the packed arg-slot count from a BC_CALL Imm, with the
// scalar64 flag and the layout index removed (both live at/above bit 20).
func callImmSlots(imm int) int {
	return imm & (BC_CALL_RET_SCALAR64 - 1)
}

// callImmLayout returns the 1-based argument-interface-layout index from a
// BC_CALL Imm (0 = no interface args).  See VMFunc.ArgIfaceLayouts.
func callImmLayout(imm int) int {
	return (imm >> BC_CALL_LAYOUT_SHIFT) & ARG_IFACE_LAYOUT_MASK
}

// callImmScalar64 reports whether a BC_CALL Imm carries the scalar64 flag.
func callImmScalar64(imm int) bool {
	return (imm & BC_CALL_RET_SCALAR64) != 0
}

// SIBLING_LAYOUT_SHIFT positions the argument-interface-layout index in a
// BC_CALL_FUNC_VALUE Imm and a BC_CALL_IFACE_METHOD Imm: bits [16, 25], above the
// packed slot count (low 16 bits).  A packed slot count never approaches 16 bits,
// so the index never collides with it.  Placing the index in Imm (not Aux) frees
// each sibling op's Aux to carry its retbuf field at FULL width — undoing the S3
// narrowing that capped the func-value retbuf at 16 bits (plan-iface-crossmode.md
// follow-up #2).
const SIBLING_LAYOUT_SHIFT int = 16

// packFuncValueImm folds the argument-interface-layout index into a
// BC_CALL_FUNC_VALUE Imm alongside the packed user-arg slot count.  Decode with
// funcValueImmSlots / funcValueImmLayout.
func packFuncValueImm(slots int, layoutIdx int) int {
	return slots | (layoutIdx << SIBLING_LAYOUT_SHIFT)
}

// funcValueImmSlots returns the packed user-arg slot count from a
// BC_CALL_FUNC_VALUE Imm, with the layout index masked off.
func funcValueImmSlots(imm int) int {
	return imm & 65535
}

// funcValueImmLayout returns the 1-based argument-interface-layout index from a
// BC_CALL_FUNC_VALUE Imm (0 = no interface args).  See VMFunc.ArgIfaceLayouts.
func funcValueImmLayout(imm int) int {
	return (imm >> SIBLING_LAYOUT_SHIFT) & ARG_IFACE_LAYOUT_MASK
}

// packIfaceMethodImm folds the argument-interface-layout index into a
// BC_CALL_IFACE_METHOD Imm alongside the packed user-arg slot count.  Decode with
// ifaceMethodImmSlots / ifaceMethodImmLayout.
func packIfaceMethodImm(slots int, layoutIdx int) int {
	return slots | (layoutIdx << SIBLING_LAYOUT_SHIFT)
}

// ifaceMethodImmSlots returns the packed user-arg slot count from a
// BC_CALL_IFACE_METHOD Imm, with the layout index masked off.
func ifaceMethodImmSlots(imm int) int {
	return imm & 65535
}

// ifaceMethodImmLayout returns the 1-based argument-interface-layout index from a
// BC_CALL_IFACE_METHOD Imm (0 = no interface args).  See VMFunc.ArgIfaceLayouts.
func ifaceMethodImmLayout(imm int) int {
	return (imm >> SIBLING_LAYOUT_SHIFT) & ARG_IFACE_LAYOUT_MASK
}

// IFACE_METHOD_SLOT_SHIFT splits a BC_CALL_IFACE_METHOD Aux into a WIDE retbuf
// field (low bits [0, 20]) and the method vtable slot (high bits [21, 30]).  The
// retbuf field gets the wide low field because an aggregate return can be large
// (a ≥64 KB by-value aggregate needs > 16 bits); the method slot — a small
// absolute vtable slot index — takes the narrow high field.  This widens the
// pre-existing 16-bit iface-method retbuf cap (Aux high half) the same way
// follow-up #2 widens the func-value retbuf, so a large-aggregate-return method
// no longer under-reserves its retbuf.  On a 32-bit build host the layout stays
// below the sign bit.
const IFACE_METHOD_SLOT_SHIFT int = 21

// IFACE_METHOD_RETBUF_MASK is the low-[0,20] retbuf-field mask (bits under
// IFACE_METHOD_SLOT_SHIFT).
const IFACE_METHOD_RETBUF_MASK int = 2097151 // (1 << 21) - 1

// IFACE_METHOD_SLOT_MASK is the 10-bit method-slot mask (the Aux high field).
const IFACE_METHOD_SLOT_MASK int = 1023 // (1 << 10) - 1

// packIfaceMethodAux folds the method vtable slot and the retbuf field (retbuf
// size + scalar64 flag in bit 0, via packRetbufScalar64) into a BC_CALL_IFACE_
// METHOD Aux.  Decode with ifaceMethodAuxSlot / ifaceMethodAuxRetbufField.
func packIfaceMethodAux(methodSlot int, retbufSize int, scalar64 bool) int {
	// Fail loud rather than silently truncate, matching buildArgIfaceLayout's
	// layout-index guard: an interface with more than IFACE_METHOD_SLOT_MASK (1023)
	// vtable slots, or a retbuf larger than the retbuf sub-field holds, would
	// otherwise overflow into the neighbouring field and mis-dispatch.  Both are far
	// beyond any real interface / aggregate-return size, so this never fires in
	// practice — it just refuses to encode a corrupting value.
	if methodSlot < 0 || methodSlot > IFACE_METHOD_SLOT_MASK {
		vmPanic("vm: interface method slot exceeds the BC_CALL_IFACE_METHOD Aux slot field (>1023 slots)")
	}
	var retbufField int = packRetbufScalar64(retbufSize, scalar64)
	if retbufField < 0 || retbufField > IFACE_METHOD_RETBUF_MASK {
		vmPanic("vm: interface-method retbuf size exceeds the BC_CALL_IFACE_METHOD Aux retbuf field")
	}
	return retbufField | (methodSlot << IFACE_METHOD_SLOT_SHIFT)
}

// ifaceMethodAuxSlot returns the method vtable slot from a BC_CALL_IFACE_METHOD
// Aux (the high field).
func ifaceMethodAuxSlot(aux int) int {
	return (aux >> IFACE_METHOD_SLOT_SHIFT) & IFACE_METHOD_SLOT_MASK
}

// ifaceMethodAuxRetbufField returns the packed retbuf field (retbuf size +
// scalar64 flag) from a BC_CALL_IFACE_METHOD Aux — feed it to retbufFieldBytes /
// retbufFieldScalar64.
func ifaceMethodAuxRetbufField(aux int) int {
	return aux & IFACE_METHOD_RETBUF_MASK
}

// storeScalar64Result writes a wide (register-pair) cross-mode return value into
// the destination register pair — regs[dst] = low 32 bits, regs[dst+1] = high 32
// bits, little-endian per splitInt64 (matching every other VM pair site).  A
// void result (dst < 0) writes nothing.  Shared by every cross-mode dispatcher
// that reads a 64-bit scalar back via rt._call_shim_scalar64.
func storeScalar64Result(regs *int, dst int, r int64) {
	if dst < 0 { return }
	var lo int
	var hi int
	lo, hi = splitInt64(r)
	regs[dst] = lo
	regs[dst + 1] = hi
}

// storeExternResult writes a BC_CALL extern dispatch's int64 result into the
// destination register: a 64-bit scalar return (scalar64) splits into the
// register pair; anything else (a one-word scalar, or an aggregate retbuf
// pointer) rides the low word.  dispatchExternBinding returns int64 precisely so
// this one call site can distinguish the two without a second return channel.
func storeExternResult(regs *int, dst int, result int64, scalar64 bool) {
	if dst < 0 { return }
	if scalar64 {
		storeScalar64Result(regs, dst, result)
		return
	}
	regs[dst] = cast(int, result)
}
