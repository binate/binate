package "pkg/binate/vm"

import "pkg/binate/types"

// Cross-mode 64-bit-SCALAR return transport on a <8-byte-word (ILP32) VM host.
//
// A bare int64 / uint64 / float64 return is a register PAIR on ILP32 (SizeOf 8 >
// PointerSize 4), NOT a retbuf aggregate — types.IsAggregateReturn gates on
// aggregate KIND, so a 64-bit scalar takes the scalar shim shape.  The
// per-function cross-mode shim correctly returns it as an i64 (r0:r1), but the
// default scalar dispatch primitive rt._call_shim_scalar returns ONE host word
// (i32 on ILP32), dropping the high half.  The dispatchers detect a 64-bit
// scalar return (a flag stamped at lower time) and read it back via the wide
// rt._call_shim_scalar64 (i64), splitting into the destination register pair.
//
// This file holds the flag encoding + the shared read-back so the four dispatch
// sites (dispatchCompiledFuncValue, dispatchCompiledIfaceMethod, the BC_CALL
// extern arm, dispatchNativeIndirect) and their lower-time producers in
// lower_call.bn cannot drift.

// BC_CALL_RET_SCALAR64 marks a BC_CALL whose result is a 64-bit scalar returned
// as a register pair.  It rides a high bit of the Imm slot-count field (BC_CALL
// has no spare register/Aux slot); bit 20 sits far above any realistic packed
// slot count and far below the sign bit even on a 32-bit build host.
const BC_CALL_RET_SCALAR64 int = 1048576 // 1 << 20

// is64BitScalarReturn reports whether a call whose result type is t needs the
// wide (register-pair) cross-mode return: t is a 64-bit scalar and the host word
// (wordSize) cannot hold it in one slot.  This is the SAME predicate regWidths
// uses to make the result register wide, so the pair read-back fills exactly the
// two slots the allocator reserved.  Live callers pass REG_SLOT; tests pass an
// explicit width for host independence.
func is64BitScalarReturn(t @types.Type, wordSize int) bool {
	return is64BitScalar(t) && wordSize < 8
}

// packRetbufScalar64 folds the scalar64 flag into a retbuf-size field.  Retbuf
// sizes are always a multiple of 8 (types.AggregateReturnSize rounds up), so bit
// 0 is free; a 64-bit scalar has retbuf size 0, so its field is just the flag
// bit.  Used for BC_CALL_FUNC_VALUE's Aux and the high 16-bit sub-field of
// BC_CALL_IFACE_METHOD's Aux; decode with retbufFieldBytes / retbufFieldScalar64.
func packRetbufScalar64(retbufSize int, scalar64 bool) int {
	if scalar64 { return retbufSize | 1 }
	return retbufSize
}

// retbufFieldBytes returns the retbuf byte size from a packed field, with the
// scalar64 flag bit removed — the size to reserve on vm.Stack (0 for a scalar).
// The flag is bit 0 and a real size is a multiple of 8, so subtracting bit 0
// recovers the size exactly.
func retbufFieldBytes(field int) int {
	return field - (field & 1)
}

// retbufFieldScalar64 reports whether a packed retbuf field carries the scalar64
// flag.
func retbufFieldScalar64(field int) bool {
	return (field & 1) != 0
}

// packCallImm folds the scalar64 flag into a BC_CALL packed slot count.  A slot
// count is far below BC_CALL_RET_SCALAR64, so the OR never collides.
func packCallImm(slots int, scalar64 bool) int {
	if scalar64 { return slots | BC_CALL_RET_SCALAR64 }
	return slots
}

// callImmSlots returns the packed arg-slot count from a BC_CALL Imm, with the
// scalar64 flag bit removed.
func callImmSlots(imm int) int {
	return imm & (BC_CALL_RET_SCALAR64 - 1)
}

// callImmScalar64 reports whether a BC_CALL Imm carries the scalar64 flag.
func callImmScalar64(imm int) bool {
	return (imm & BC_CALL_RET_SCALAR64) != 0
}

// storeScalar64Result writes a wide (register-pair) cross-mode return value into
// the destination register pair — regs[dst] = low 32 bits, regs[dst+1] = high 32
// bits, little-endian per splitInt64 (matching every other VM pair site).  A
// void result (dst < 0) writes nothing.  Shared by every cross-mode dispatcher
// that reads a 64-bit scalar back via rt._call_shim_scalar64.
func storeScalar64Result(regs *int, dst int, r int64) {
	if dst < 0 { return }
	var lo int
	var hi int
	lo, hi = splitInt64(r)
	regs[dst] = lo
	regs[dst + 1] = hi
}

// storeExternResult writes a BC_CALL extern dispatch's int64 result into the
// destination register: a 64-bit scalar return (scalar64) splits into the
// register pair; anything else (a one-word scalar, or an aggregate retbuf
// pointer) rides the low word.  dispatchExternBinding returns int64 precisely so
// this one call site can distinguish the two without a second return channel.
func storeExternResult(regs *int, dst int, result int64, scalar64 bool) {
	if dst < 0 { return }
	if scalar64 {
		storeScalar64Result(regs, dst, result)
		return
	}
	regs[dst] = cast(int, result)
}
