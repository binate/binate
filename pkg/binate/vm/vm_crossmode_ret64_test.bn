package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the cross-mode 64-bit-scalar-return flag encoding + predicate
// (vm_crossmode_ret64.bn).  All host-independent: the predicate takes an
// explicit wordSize and the pack/unpack helpers are pure bit arithmetic, so the
// wide (wordSize < 8) path is exercised even on a 64-bit build host.

// TestIs64BitScalarReturn: the wide-return predicate is true for a 64-bit scalar
// on a <8-byte host word, false for everything else (narrower scalars, host int,
// pointers, and any type on an 8-byte host).
func TestIs64BitScalarReturn() testing.TestResult {
	if !is64BitScalarReturn(types.TypInt64(), 4) {
		return "int64 @ word 4 should be wide"
	}
	if !is64BitScalarReturn(types.TypUint64(), 4) {
		return "uint64 @ word 4 should be wide"
	}
	if !is64BitScalarReturn(types.TypFloat64(), 4) {
		return "float64 @ word 4 should be wide"
	}
	if is64BitScalarReturn(types.TypInt64(), 8) {
		return "int64 @ word 8 must not be wide (fits one slot)"
	}
	if is64BitScalarReturn(types.TypFloat64(), 8) {
		return "float64 @ word 8 must not be wide"
	}
	if is64BitScalarReturn(types.TypInt32(), 4) {
		return "int32 @ word 4 must not be wide"
	}
	// NOTE: types.TypInt() is deliberately NOT tested here — the predeclared
	// `int` carries the BUILD host's width (64 on an LP64 test host), so
	// is64BitScalar(TypInt()) is host-dependent.  In real lowering `int`'s width
	// tracks the TARGET (32 on ILP32), and the wordSize < 8 gate excludes it on
	// LP64 regardless, so a host `int` return is never wide either way.
	if is64BitScalarReturn(types.TypFloat32(), 4) {
		return "float32 @ word 4 must not be wide"
	}
	if is64BitScalarReturn(types.MakePointerType(types.TypInt()), 4) {
		return "pointer @ word 4 must not be wide"
	}
	return ""
}

// TestRetbufFieldPacking: the retbuf-field pack/unpack (used for
// BC_CALL_FUNC_VALUE's Aux and the low sub-field of BC_CALL_IFACE_METHOD's Aux)
// round-trips, with the scalar64 flag on bit 0 not disturbing a multiple-of-8
// retbuf size.
func TestRetbufFieldPacking() testing.TestResult {
	// A scalar (retbuf size 0) with the flag: the field is exactly the flag bit.
	var f0 int = packRetbufScalar64(0, true)
	if retbufFieldBytes(f0) != 0 {
		return "scalar64 field must decode to 0 bytes"
	}
	if !retbufFieldScalar64(f0) {
		return "scalar64 field must carry the flag"
	}
	// An aggregate (retbuf size 16), no flag.
	var f16 int = packRetbufScalar64(16, false)
	if retbufFieldBytes(f16) != 16 {
		return "aggregate field must decode to 16 bytes"
	}
	if retbufFieldScalar64(f16) {
		return "aggregate field must not carry the flag"
	}
	// A multiple-of-8 size survives even when the flag bit is set alongside it.
	var f8 int = packRetbufScalar64(8, true)
	if retbufFieldBytes(f8) != 8 {
		return "size 8 must survive the flag bit"
	}
	if !retbufFieldScalar64(f8) {
		return "flag must be readable alongside size 8"
	}
	return ""
}

// TestCallImmPacking: the BC_CALL Imm pack (slot count + scalar64 flag + the
// argument-interface-layout index, in disjoint bit ranges) round-trips, and the
// three fields never collide.
func TestCallImmPacking() testing.TestResult {
	var imm int = packCallImm(3, true, 0)
	if callImmSlots(imm) != 3 {
		return "packed Imm must decode 3 slots"
	}
	if !callImmScalar64(imm) {
		return "packed Imm must carry the scalar64 flag"
	}
	if callImmLayout(imm) != 0 {
		return "packed Imm with no iface args must decode layout index 0"
	}
	var imm2 int = packCallImm(5, false, 0)
	if callImmSlots(imm2) != 5 {
		return "packed Imm must decode 5 slots"
	}
	if callImmScalar64(imm2) {
		return "unflagged Imm must not carry the flag"
	}
	// Layout index 42 alongside a 64-bit-scalar return and a 6-slot count — every
	// field must decode independently.
	var imm3 int = packCallImm(6, true, 42)
	if callImmSlots(imm3) != 6 {
		return "layout-packed Imm must still decode 6 slots"
	}
	if !callImmScalar64(imm3) {
		return "layout-packed Imm must still carry the scalar64 flag"
	}
	if callImmLayout(imm3) != 42 {
		return "layout-packed Imm must decode layout index 42"
	}
	// The full 10-bit layout index survives without leaking into slots/scalar64.
	var imm4 int = packCallImm(0, false, ARG_IFACE_LAYOUT_MASK)
	if callImmLayout(imm4) != ARG_IFACE_LAYOUT_MASK {
		return "full layout index must round-trip"
	}
	if callImmSlots(imm4) != 0 || callImmScalar64(imm4) {
		return "full layout index must not leak into slots or the scalar64 flag"
	}
	return ""
}

// TestSiblingImmPacking: the BC_CALL_FUNC_VALUE / BC_CALL_IFACE_METHOD Imm pack
// (packed user-arg slot count in the low 16 bits + the argument-interface-layout
// index above) round-trips, and the two fields never collide even at a large slot
// count.
func TestSiblingImmPacking() testing.TestResult {
	var fv int = packFuncValueImm(6, 100)
	if funcValueImmSlots(fv) != 6 {
		return "func-value Imm must decode 6 slots"
	}
	if funcValueImmLayout(fv) != 100 {
		return "func-value Imm must decode layout index 100"
	}
	// A 5-digit slot count (well within the 16-bit field) must not touch the index.
	var fvWide int = packFuncValueImm(40000, 7)
	if funcValueImmSlots(fvWide) != 40000 {
		return "func-value Imm must decode a 40000 slot count"
	}
	if funcValueImmLayout(fvWide) != 7 {
		return "a large slot count must not disturb the layout index"
	}
	var im int = packIfaceMethodImm(6, ARG_IFACE_LAYOUT_MASK)
	if ifaceMethodImmSlots(im) != 6 {
		return "iface-method Imm must decode 6 slots"
	}
	if ifaceMethodImmLayout(im) != ARG_IFACE_LAYOUT_MASK {
		return "iface-method Imm must decode the full layout index"
	}
	return ""
}

// TestIfaceMethodAuxPacking: the BC_CALL_IFACE_METHOD Aux pack (method vtable
// slot + a WIDE retbuf field) round-trips, and — the follow-up #2 stress — a
// retbuf size that would have overflowed the old 16-bit high-half field
// (> 65535) survives the widened field without corrupting the method slot.
func TestIfaceMethodAuxPacking() testing.TestResult {
	var aux int = packIfaceMethodAux(37, 16, false)
	if ifaceMethodAuxSlot(aux) != 37 {
		return "Aux must decode method slot 37"
	}
	if retbufFieldBytes(ifaceMethodAuxRetbufField(aux)) != 16 {
		return "Aux must decode a 16-byte retbuf"
	}
	if retbufFieldScalar64(ifaceMethodAuxRetbufField(aux)) {
		return "a 16-byte retbuf must not carry the scalar64 flag"
	}
	// A scalar64 return (retbuf 0 + flag) alongside a method slot.
	var auxS int = packIfaceMethodAux(9, 0, true)
	if ifaceMethodAuxSlot(auxS) != 9 {
		return "Aux must decode method slot 9 alongside scalar64"
	}
	if !retbufFieldScalar64(ifaceMethodAuxRetbufField(auxS)) {
		return "Aux must carry the scalar64 flag"
	}
	// STRESS (#2): a 100000-byte aggregate return (> the old 16-bit cap of 65535)
	// packed with a nonzero method slot — both must decode intact.  Under the old
	// 16-bit-high-half retbuf field this size would have been truncated
	// (100000 & 65535 = 34464), under-reserving the retbuf.
	var auxBig int = packIfaceMethodAux(12, 100000, false)
	if retbufFieldBytes(ifaceMethodAuxRetbufField(auxBig)) != 100000 {
		return "the widened Aux retbuf field must carry a 100000-byte size intact"
	}
	if ifaceMethodAuxSlot(auxBig) != 12 {
		return "a large retbuf must not corrupt the method slot"
	}
	return ""
}

// TestFuncValueAuxWideRetbuf: follow-up #2 for the func-value path — with the
// interface bitmap gone from Aux, the retbuf field reclaims the full Aux width, so
// a retbuf size that overflowed the S3-narrowed 16-bit field (> 65535) round-trips
// through the same packRetbufScalar64 / retbufFieldBytes the func-value dispatch
// reads directly (no mask).
func TestFuncValueAuxWideRetbuf() testing.TestResult {
	// 100000 bytes (> 65535) with no flag: must decode intact.
	var aux int = packRetbufScalar64(100000, false)
	if retbufFieldBytes(aux) != 100000 {
		return "func-value Aux must carry a 100000-byte retbuf intact (no 16-bit cap)"
	}
	if retbufFieldScalar64(aux) {
		return "a 100000-byte retbuf must not carry the scalar64 flag"
	}
	// A larger, still-8-multiple size with the scalar64 bit clear.
	var auxBig int = packRetbufScalar64(1048576, false)
	if retbufFieldBytes(auxBig) != 1048576 {
		return "func-value Aux must carry a 1 MB retbuf intact"
	}
	return ""
}

// TestLowerFuncResultReg64Scalar: lowerFunc flags a single bare-64-bit-scalar
// result as ResultReg64Scalar iff the host word is < 8 bytes (so ensureHandle
// picks TrampolineScalar64 for the reverse cross-mode return); a one-word result
// is never flagged.  Like the pair-variant cast tests, the SET branch runs only
// on a 32-bit-host unit build (REG_SLOT < 8); on LP64 it asserts the flag stays
// clear.
func TestLowerFuncResultReg64Scalar() testing.TestResult {
	var vm @VM = lowerFromSource(
			"package \"test\"\nfunc f() int64 { return 5 }\nfunc g() int { return 5 }\n")
	var fi int = vm.LookupFunc("test.f")
	var gi int = vm.LookupFunc("test.g")
	if fi < 0 || gi < 0 { return "test.f / test.g not found" }
	var wantF bool = REG_SLOT < 8
	if vm.Funcs.Get(fi).ResultReg64Scalar != wantF {
		return "int64-result func ResultReg64Scalar must equal (REG_SLOT < 8)"
	}
	if vm.Funcs.Get(gi).ResultReg64Scalar {
		return "one-word-result func must not be flagged ResultReg64Scalar"
	}
	return ""
}

// TestEnsureHandleSelectsScalar64Trampoline: ensureHandle points a
// 64-bit-scalar-returning VM func's vtable.call at TrampolineScalar64 on a
// <8-byte host (so a native caller reads the full i64 in r0:r1), and at the
// one-word TrampolineScalar otherwise.  Closes the reverse-direction selection
// gap on both hosts.
func TestEnsureHandleSelectsScalar64Trampoline() testing.TestResult {
	var vm @VM = lowerFromSource(
			"package \"test\"\nfunc f() int64 { return 5 }\n")
	registerTestExterns(vm)
	var fi int = vm.LookupFunc("test.f")
	if fi < 0 { return "test.f not found" }
	ensureHandle(vm, vm.Funcs.Get(fi), fi)
	var wantName *[]readonly char = "pkg/binate/vm.TrampolineScalar"
	if REG_SLOT < 8 { wantName = "pkg/binate/vm.TrampolineScalar64" }
	var tIdx int = vm.LookupExtern(wantName)
	if tIdx < 0 { return "expected trampoline not registered" }
	var tVtable *int = bit_cast(*int, vm.Externs[tIdx].VtableAddr)
	if vm.Funcs.Get(fi).Vtable == nil {
		return "ensureHandle did not build the vtable"
	}
	if vm.Funcs.Get(fi).Vtable.Call != tVtable[1] {
		return "ensureHandle picked the wrong trampoline for a 64-bit scalar result"
	}
	return ""
}

// TestTrampolineScalar64ReturnsFullInt64: calling TrampolineScalar64 directly
// (the native-caller entry) on a VM func returning a 64-bit scalar delivers the
// FULL value — a truncated low word (5000000000 & 0xFFFFFFFF = 705032704) would
// fail.  Host-independent: execFunc returns int64 on both hosts, so this
// exercises the TrampolineScalar64 body even on LP64 (where ensureHandle would
// not select it).  Built via DIRECT IR (EmitConstInt64) rather than
// lowerFromSource — to isolate the int64-return ABI path from
// source-literal lowering: the value under test is an unambiguous emitted
// constant, independent of how a source literal would be typed.
func TestTrampolineScalar64ReturnsFullInt64() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"test\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt64()
	var fn @ir.Func = ir.NewFunc("", "f", noParams, results)
	var entry @ir.Block = ir.AddBlock(fn, "entry")
	var c @ir.Instr = entry.EmitConstInt64(5000000000, types.TypInt64())
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = c
	entry.EmitReturn(retArgs)
	m.AddFunc(fn)

	var vm @VM = newTestVM(testVMStackSize)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var fi int = vm.LookupFunc("test.f")
	if fi < 0 { return "test.f not found" }
	ensureHandle(vm, vm.Funcs.Get(fi), fi)
	var rec *uint8 = bit_cast(*uint8, vm.Funcs.Get(fi).ClosureRec)
	var got int64 = TrampolineScalar64(rec, 0, 0, 0, 0, 0, 0, 0)
	if got != 5000000000 {
		return "TrampolineScalar64 must return the full int64 5e9, not a truncated word"
	}
	return ""
}
