package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/builtins/testing"

// The two bytecode-driven cross-mode dispatchers — dispatchCompiledFuncValue
// (vm_exec_funcref.bn) and dispatchCompiledIfaceMethod (vm_exec_iface.bn) — must
// PUBLISH g_crossModeVmAddr around the native call, so a native callee that runs an
// internal `x.(*J)` on a bytecode-boxed value resolves through THIS vm's satentry
// registry (satFallbackFn) instead of MISSing the native g_satTable.  The extern
// (dispatchExternBinding) and host (CallIfaceMethod) paths already do; these tests
// pin the same publish on the func-value and iface-method paths.
//
// Each probe returns the g_crossModeVmAddr it observes; the dispatch stores that in
// regs[Dst], so the test reads back what the native callee saw during the call.  The
// probes are dispatched DIRECTLY (like the extern tests call dispatchExternBinding),
// so no bytecode module / injected package is needed to reach the native arm.

// crossModeVmProbe is the func-value probe: a native no-arg function returning the
// g_crossModeVmAddr in force during its call.  Its `_func_handle` carries the __shimP
// (vtable slot 2) dispatchCompiledFuncValue invokes.
func crossModeVmProbe() int {
	return g_crossModeVmAddr
}

// crossModeVmProbeMethod is the iface-method probe: it takes a receiver (ignored,
// never dereferenced) so its __shimP has a method's (receiver-first) shape, and
// returns the observed g_crossModeVmAddr.
func crossModeVmProbeMethod(recv *uint8) int {
	return g_crossModeVmAddr
}

// TestDispatchCompiledFuncValuePublishesCrossModeVm: a compiled-side func value
// (data == 0, native vtable) dispatched from the VM caller must publish
// g_crossModeVmAddr = the dispatching vm for the native callee's duration, then
// restore it.  Pre-fix (no publish) the probe observes 0, not the vm.
func TestDispatchCompiledFuncValuePublishesCrossModeVm() testing.TestResult {
	var vm @VM = newTestVM(testVMStackSize)
	registerTestExterns(vm)
	// Build a compiled-side func value {vtable: crossModeVmProbe's vtable, data: 0}:
	// data == 0 is what routes a call to dispatchCompiledFuncValue.
	var handle *int = bit_cast(*int, _func_handle(crossModeVmProbe))
	var fv @[]int = make_slice(int, 2)
	fv[types.FuncValueVtableIndex()] = handle[types.FuncValueVtableIndex()]
	fv[types.FuncValueDataIndex()] = 0

	// This test verifies the COMPILED-side cross-mode dispatch, so it needs
	// crossModeVmProbe to be a NATIVE function: its func-value vtable's call_packed
	// is then a per-signature __shimP that dispatches a data==0 (non-capturing)
	// value as a bare native call, and this test observes the g_crossModeVmAddr
	// publish/restore around it.  That holds only when this package runs natively.
	// Under the bytecode VM, crossModeVmProbe is a VM function: ensureHandle sets
	// its vtable call_packed == this vm's TrampolinePacked, which requires a live
	// closure record — and a data==0 VM func value has none (no callee index), so
	// the native dispatch this test exercises is simply unreachable here (a real VM
	// func value never carries a null record; only this synthetic data==0 value
	// does).  Recognize that mode by thunk identity and treat it as not-applicable;
	// the native unit-test modes cover the real behaviour.
	var vtable *int = bit_cast(*int, fv[types.FuncValueVtableIndex()])
	if vtable[types.FuncValueVtableCallPackedIndex()] == vmTrampolinePackedCall(vm) {
		return ""
	}

	var regs @[]int = make_slice(int, 4)
	var instr BCInstr
	instr.Dst = 0
	instr.Src2 = 1 // packed-arg window base (no user args)
	instr.Imm = packFuncValueImm(0, 0) // 0 arg slots, no iface layout
	instr.Aux = packRetbufScalar64(0, false) // one-word scalar return

	var before int = g_crossModeVmAddr
	dispatchCompiledFuncValue(vm, &fv[0], &regs[0], instr, nil)
	if regs[0] != bit_cast(int, vm) {
		return "dispatchCompiledFuncValue must publish g_crossModeVmAddr = the dispatching vm "
				"during the native call (the probe observed the wrong value)"
	}
	if g_crossModeVmAddr != before {
		return "dispatchCompiledFuncValue must restore g_crossModeVmAddr after the call"
	}
	return ""
}

// TestDispatchCompiledIfaceMethodPublishesCrossModeVm: a native-vtable iface method
// dispatched from the VM caller must likewise publish g_crossModeVmAddr for the
// native method's duration.  A crafted @__ivtshim (slot 2 = the probe's handle) +
// registerVtableAddr binding lets the dispatch resolve the probe without an injected
// package; the receiver word is arbitrary (the probe never dereferences it).
func TestDispatchCompiledIfaceMethodPublishesCrossModeVm() testing.TestResult {
	var vm @VM = newTestVM(testVMStackSize)
	registerTestExterns(vm)
	// The shim vtable holds the method's func-value @__handle at its method slot
	// (slot 2 = kFirstMethodSlot); the handle's vtable slot 2 is the probe's __shimP.
	var shim @[]int = make_slice(int, kFirstMethodSlot + 1)
	shim[kFirstMethodSlot] = bit_cast(int, _func_handle(crossModeVmProbeMethod))
	var shimAddr int = bit_cast(int, &shim[0])
	// The raw @__ivt block: only its ADDRESS matters (dispatch reads the parallel shim
	// vtable for the handle), so its contents are irrelevant.
	var rawIvt @[]int = make_slice(int, kFirstMethodSlot + 1)
	var rawAddr int = bit_cast(int, &rawIvt[0])
	registerVtableAddr(vm, "__ivt.crossModeProbe", rawAddr, shimAddr, kFirstMethodSlot + 1)

	// Native iface value {data, native @__ivt word}: the word is a real address
	// (>> IfaceVtables.Len()), so ifaceVtIsNative routes to dispatchCompiledIfaceMethod.
	var iv @[]int = make_slice(int, 2)
	iv[types.IfaceValueDataIndex()] = 0x1234 // receiver ptr, never dereferenced
	iv[types.IfaceValueVtableIndex()] = rawAddr

	var regs @[]int = make_slice(int, 4)
	var callArgs @[]int = make_slice(int, 64)
	var instr BCInstr
	instr.Dst = 0
	instr.Src2 = 1 // user-arg window base (no user args)
	instr.Imm = packIfaceMethodImm(0, 0) // 0 user slots
	instr.Aux = packIfaceMethodAux(kFirstMethodSlot, 0, false) // method slot 2, scalar

	var before int = g_crossModeVmAddr
	dispatchCompiledIfaceMethod(vm, &regs[0], instr, &iv[0], nil, callArgs)
	if regs[0] != bit_cast(int, vm) {
		return "dispatchCompiledIfaceMethod must publish g_crossModeVmAddr = the dispatching vm "
				"during the native method call (the probe observed the wrong value)"
	}
	if g_crossModeVmAddr != before {
		return "dispatchCompiledIfaceMethod must restore g_crossModeVmAddr after the call"
	}
	return ""
}
