package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/binate/vmdata"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// The func-value and native interface-method dispatchers translate a `...*any`
// slice's interface values for a native callee, as the extern dispatch does: on
// vm.Stack when the copy fits, on the heap -- freed once the callee returns --
// when it does not.  Each probe returns the vtable word of the first value it is
// passed, so the test reads back what the native callee saw.

// sliceVtProbe returns the vtable word of the first of the raw interface values in s.
func sliceVtProbe(s *[]*any) int {
	var w *int = bit_cast(*int, &s[0])
	return w[types.IfaceValueVtableIndex()]
}

// sliceVtProbeMethod is sliceVtProbe shaped as a method: a receiver first, ignored.
func sliceVtProbeMethod(recv *uint8, s *[]*any) int {
	var w *int = bit_cast(*int, &s[0])
	return w[types.IfaceValueVtableIndex()]
}

// sliceLayout returns an argument layout listing one slice of interface values, at
// slot 0.
func sliceLayout() @vmdata.ArgIfaceLayout {
	var layout @vmdata.ArgIfaceLayout = make(vmdata.ArgIfaceLayout)
	layout.SliceIfaceSlots = make_slice(int, 1)
	return layout
}

// A native function called through a function value gets a slice of bytecode impls'
// interface values translated, from vm.Stack and, when vm.Stack lacks room, from the
// heap, freed once it returns.
func TestDispatchCompiledFuncValueTranslatesSlice() testing.TestResult {
	var vm @VM = lowerFromSource(ifaceVtSource())
	registerTestExterns(vm)
	if vm.IfaceVtables.Len() < 1 { return "expected a lowered impl vtable" }
	var handle *int = bit_cast(*int, _func_handle(sliceVtProbe))
	var fv @[]int = make_slice(int, 2)
	fv[types.FuncValueVtableIndex()] = handle[types.FuncValueVtableIndex()]
	fv[types.FuncValueDataIndex()] = 0
	// Under the bytecode VM sliceVtProbe is a VM function, and this synthetic data == 0
	// value has no closure record for its trampoline; the native modes cover it.
	var vtable *int = bit_cast(*int, fv[types.FuncValueVtableIndex()])
	if vtable[types.FuncValueVtableCallPackedIndex()] == vmTrampolinePackedCall(vm) {
		return ""
	}
	var nativeVt int = buildNativeIfaceVtable(vm, vm.IfaceVtables.Get(0))
	// The copy on vm.Stack; on the heap, as vm.Stack lacks room for it; and on the heap
	// as vm.Stack has room for it but not for the statement's growth after it too.
	var size int = (2 * 2 + 2) * REG_SLOT
	for c := 0; c < 3; c++ {
		var backing @[]int
		var hdr @[]int
		backing, hdr = ifaceSliceOf(2, 1)
		var regs @[]int = make_slice(int, 4)
		regs[1] = bit_cast(int, &hdr[0])
		var instr BCInstr
		instr.Dst = 0
		instr.Src2 = 1
		instr.Imm = packFuncValueImm(1, 0)
		instr.Aux = packRetbufScalar64(0, false)
		var layout @vmdata.ArgIfaceLayout = sliceLayout()
		var sp int = vm.SP
		var growth int = 0
		if c == 1 { vm.SP = stackLimit(vm, 0) - REG_SLOT }
		if c == 2 {
			vm.SP = stackLimit(vm, 0) - size - REG_SLOT
			growth = 64 * REG_SLOT
		}
		var spBefore int = vm.SP
		var live int = rt.LiveBlocks()
		dispatchCompiledFuncValue(vm, &fv[0], &regs[0], instr, layout, growth)
		var grew int = vm.SP - spBefore
		vm.SP = sp
		if vm.FaultRaised { return "the dispatch should not fault" }
		if regs[0] != nativeVt { return "the native callee should see the translated vtable word" }
		if backing[types.IfaceValueVtableIndex()] != 1 {
			return "the original backing should be left as it was"
		}
		if c == 0 && grew != size { return "a copy that fits should ride vm.Stack" }
		if c > 0 && grew != 0 { return "a copy without room on vm.Stack should go on the heap" }
		if c > 0 && rt.LiveBlocks() != live {
			return "the heap copy should be freed once the callee returns"
		}
	}
	return ""
}

// A native interface method gets a slice of bytecode impls' interface values
// translated the same way.  A crafted @__ivtshim (its method slot the probe's handle)
// bound by registerVtableAddr lets the dispatch resolve the probe with no injected
// package; the receiver word is arbitrary (the probe never reads it).
func TestDispatchCompiledIfaceMethodTranslatesSlice() testing.TestResult {
	var vm @VM = lowerFromSource(ifaceVtSource())
	registerTestExterns(vm)
	if vm.IfaceVtables.Len() < 1 { return "expected a lowered impl vtable" }
	var shim @[]int = make_slice(int, kFirstMethodSlot + 1)
	shim[kFirstMethodSlot] = bit_cast(int, _func_handle(sliceVtProbeMethod))
	var rawIvt @[]int = make_slice(int, kFirstMethodSlot + 1)
	var rawAddr int = bit_cast(int, &rawIvt[0])
	registerVtableAddr(vm, "__ivt.sliceProbe", rawAddr, bit_cast(int, &shim[0]), kFirstMethodSlot + 1)
	var iv @[]int = make_slice(int, 2)
	iv[types.IfaceValueDataIndex()] = 0x1234
	iv[types.IfaceValueVtableIndex()] = rawAddr
	var nativeVt int = buildNativeIfaceVtable(vm, vm.IfaceVtables.Get(0))
	// The copy on vm.Stack; on the heap, as vm.Stack lacks room for it; and on the heap
	// as vm.Stack has room for it but not for the statement's growth after it too.
	var size int = (2 * 2 + 2) * REG_SLOT
	for c := 0; c < 3; c++ {
		var backing @[]int
		var hdr @[]int
		backing, hdr = ifaceSliceOf(2, 1)
		var regs @[]int = make_slice(int, 4)
		regs[1] = bit_cast(int, &hdr[0])
		var callArgs @[]int = make_slice(int, 64)
		var instr BCInstr
		instr.Dst = 0
		instr.Src2 = 1
		instr.Imm = packIfaceMethodImm(1, 0)
		instr.Aux = packIfaceMethodAux(kFirstMethodSlot, 0, false)
		var layout @vmdata.ArgIfaceLayout = sliceLayout()
		var sp int = vm.SP
		var growth int = 0
		if c == 1 { vm.SP = stackLimit(vm, 0) - REG_SLOT }
		if c == 2 {
			vm.SP = stackLimit(vm, 0) - size - REG_SLOT
			growth = 64 * REG_SLOT
		}
		var spBefore int = vm.SP
		var live int = rt.LiveBlocks()
		dispatchCompiledIfaceMethod(vm, &regs[0], instr, &iv[0], layout, callArgs, growth)
		var grew int = vm.SP - spBefore
		vm.SP = sp
		if vm.FaultRaised { return "the dispatch should not fault" }
		if regs[0] != nativeVt { return "the native method should see the translated vtable word" }
		if backing[types.IfaceValueVtableIndex()] != 1 {
			return "the original backing should be left as it was"
		}
		if c == 0 && grew != size { return "a copy that fits should ride vm.Stack" }
		if c > 0 && grew != 0 { return "a copy without room on vm.Stack should go on the heap" }
		if c > 0 && rt.LiveBlocks() != live {
			return "the heap copy should be freed once the method returns"
		}
	}
	return ""
}
