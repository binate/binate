package "pkg/binate/vm"

import "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/irgen"
import "pkg/binate/parser"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A DEFERRED call gets the same recoverable-stack-overflow PRE-CHECK
// (OP_STACK_CHECK{,_FV,_IM}) an ordinary call does: emitDeferRun loads the
// operands, pre-checks the callee's frame push, and only THEN delivers the args —
// so a deferred call whose callee's frame push overflows faults BEFORE the moved
// (@I) arg is committed, and the still-slot-owned box is released by the
// pre-check's pad instead of being orphaned at the failed push.  Each callee here
// reserves a frame far larger than the small test stack, so the deferred call's
// own push overflows even though the caller exits normally (a normal exit is what
// runs the defers — a fault does not, stmt.defer.no-abort).  A stable
// rt.LiveBlocks() across repeated overflows is the signal: pre-fix, the moved arg
// leaked one block per overflow.

// runDeferOverflowNoLeak checks that repeatedly calling `test.start` (a function
// that defers a call whose callee overflows the stack while moving an @I arg)
// faults cleanly and leaks nothing.
func runDeferOverflowNoLeak(src *[]readonly char, leakMsg testing.TestResult) testing.TestResult {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = irgen.GenModule(c, file)
	var vm @VM = newTestVM(64 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)

	var noArgs @[]int
	vm.CallFunc("test.start", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "the deferred call's frame push must overflow with Status = FAULTED"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: stack overflow") {
		return "expected the stack-overflow fault message"
	}
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc("test.start", noArgs)
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated deferred-call overflow must recover identically (VM state intact)"
	}
	if rt.LiveBlocks() != base {
		return leakMsg
	}
	return ""
}

// TestDeferredDirectOverflowNoLeak: `defer big(cast(@I, make(T)))` — a DEFER_DIRECT
// call (EmitStackCheck).  The box is evaluated at the defer site and moved to big
// at exit; big's local array makes its reserved frame dwarf the 64 KiB test stack,
// so the deferred call's own frame push overflows.
func TestDeferredDirectOverflowNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface I { m() int }\n"
			"type T struct { x int }\n"
			"func (t @T) m() int { return t.x }\n"
			"impl @T : I\n"
			"func big(iv @I) int {\n"
			"	var buf [100000]int\n"
			"	buf[0] = iv.m()\n"
			"	return buf[0]\n"
			"}\n"
			"func start() int {\n"
			"	defer big(cast(@I, make(T)))\n"
			"	return 0\n"
			"}\n"
	return runDeferOverflowNoLeak(src,
			"deferred direct-call overflow leaked (the moved @I arg orphaned at the failed frame push)")
}

// TestDeferredFuncValueOverflowNoLeak: `defer fn(mkBox())` through a func-value
// variable — a DEFER_FUNCVAL call (EmitStackCheckFV).  The loaded func value is
// the dispatch target; the managed-field struct `Box` is the moved arg (delivered
// by a struct copy that RefInc's its @T field).
func TestDeferredFuncValueOverflowNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type T struct { x int }\n"
			"type Box struct { p @T }\n"
			"func mkBox() Box {\n"
			"	var b Box\n"
			"	b.p = make(T)\n"
			"	return b\n"
			"}\n"
			"func big(b Box) int {\n"
			"	var buf [100000]int\n"
			"	buf[0] = b.p.x\n"
			"	return buf[0]\n"
			"}\n"
			"func start() int {\n"
			"	var fn *func(Box) int = big\n"
			"	defer fn(mkBox())\n"
			"	return 0\n"
			"}\n"
	return runDeferOverflowNoLeak(src,
			"deferred func-value-call overflow leaked (moved struct arg orphaned at frame push)")
}

// TestDeferredIfaceMethodOverflowNoLeak: `defer jv.grow(mkBox())` on an
// interface-value receiver — a DEFER_IFACE call (EmitStackCheckIM).  The stored
// receiver dispatches to the overflowing method; the managed-field struct `Box` is
// the moved arg.
func TestDeferredIfaceMethodOverflowNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type T struct { x int }\n"
			"type Box struct { p @T }\n"
			"func mkBox() Box {\n"
			"	var b Box\n"
			"	b.p = make(T)\n"
			"	return b\n"
			"}\n"
			"interface J { grow(b Box) int }\n"
			"type U struct { y int }\n"
			"func (u @U) grow(b Box) int {\n"
			"	var buf [100000]int\n"
			"	buf[0] = b.p.x\n"
			"	return buf[0]\n"
			"}\n"
			"impl @U : J\n"
			"func start() int {\n"
			"	var jv @J = cast(@J, make(U))\n"
			"	defer jv.grow(mkBox())\n"
			"	return 0\n"
			"}\n"
	return runDeferOverflowNoLeak(src,
			"deferred iface-method-call overflow leaked (moved struct arg orphaned at frame push)")
}
