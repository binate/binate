package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/std/strconv"

// execFunc and the non-control-flow opcode helpers
// (execStringOp / execFuncRefOp / execNumericCast)
// live in vm_exec_helpers.bn. This file holds execLoop, the
// iterative dispatch loop whose remaining handlers all touch
// the loop-local control state (pc, funcIdx, f, code, regsOff,
// regs, frameBase, freeOnPop) and so can't be hoisted out into
// helper functions without invasive in/out-pointer plumbing.

// execLoop is the iterative bytecode dispatch loop. It handles
// BC_CALL by pushing frames on the VM stack (no native recursion).
// BC_RETURN pops frames. Returns when the initial frame returns — as int64 so a
// top-level 64-bit-scalar result carries its full register pair back (a one-word
// scalar / aggregate address rides the sign-extended low word).
func execLoop(vm @VM, funcIdx int, regsOff int) int64 {
	var f @VMFunc = vm.Funcs[funcIdx]
	var code @[]BCInstr = f.Code
	var regs *int = stackPtr(vm, regsOff)
	var frameBase *uint8 = bit_cast(*uint8, bit_cast(int, vm.Stack) + regsOff + f.NumRegs * REG_SLOT)
	var pc int = 0
	// Hoisted: BC_CALL extern's per-call args buffer. Allocated
	// ONCE at function entry with generous capacity; reused across
	// every extern call in this execLoop invocation. Required for
	// host-stack-leak avoidance: declaring or make_slice'ing this
	// inside the BC_CALL branch caused bnc to emit the @[]int
	// header alloca (and the make_slice temp) in that branch's
	// basic block, leaking 32 bytes of host stack per extern call
	// — only released on execLoop return. For builder-comp-int-int
	// this triggered host stack overflow after ~218s on any
	// non-trivial run. Capacity 64 covers any plausible extern
	// signature; if a call somehow exceeds it, BC_CALL handler
	// panics (loud failure beats silent corruption).
	var callArgs @[]int = make_slice(int, 64)

	for {
		var instr BCInstr = code[pc]
		pc = pc + 1

		if instr.Op == BC_NOP { continue }

		if instr.Op == BC_SP_RESTORE {
			// Statement-end marker: reclaim any vm.Stack
			// temporaries pushed during the just-ended statement
			// (aggregate return copy-backs from BC_RETURN,
			// BC_MAKE_SLICE / BC_STRING_COPY* / BC_FUNC_VALUE
			// pushes). Reset vm.SP back to the function's frame
			// end. regsOff is frameStart + FRAME_HDR, so the
			// frame end (= frameStart + totalSize) is regsOff +
			// f.NumRegs*REG_SLOT + f.FrameSize. IR-gen is the oracle for
			// when this is safe — emits OP_SP_RESTORE only at
			// statement boundaries where no register holds an
			// address into the about-to-be-reclaimed region.
			vm.SP = regsOff + f.NumRegs * REG_SLOT + f.FrameSize
			// Interrupt poll point (statement boundary).  Inert unless a
			// host armed a Poll: the gate is one not-taken branch in v1.
			// Resume point is the next instruction (pc already advanced).
			if vm.PollEnabled { vmPollPoint(vm, funcIdx, pc, regsOff) }
			continue
		}

		if instr.Op == BC_LOAD_IMM {
			regs[instr.Dst] = instr.Imm
			continue
		}
		if execStringOp(vm, f, regs, instr) { continue }
		if instr.Op == BC_MOV {
			regs[instr.Dst] = regs[instr.Src1]
			continue
		}

		// Pure register-only ops live in vm_exec_pure.bn:
		// arithmetic (BC_ADD..BC_FDIV), comparison
		// (BC_EQ..BC_FGE), unary (BC_NEG..BC_FNEG). Memory ops
		// (incl. BC_STACK_ALLOC) live in execMemoryOp in
		// vm_exec_helpers.bn — already extracted on main.
		if execArithOp(regs, instr) { continue }
		if execCmpOp(regs, instr) { continue }
		if execUnaryOp(regs, instr) { continue }
		// 64-bit register-pair ops (vm_exec64.bn), emitted only when
		// the host word is < 8 bytes; a no-op match on a 64-bit host.
		if execOp64(regs, instr) { continue }
		if execMemoryOp(regs, frameBase, instr) { continue }

		// --- Control flow ---
		// Interrupt poll points fire only on BACKWARD jumps (loop
		// back-edges: target at or before the jump), bounding poll
		// frequency to once per loop iteration.  The resume point is the
		// branch target.  Inert unless a host armed a Poll.
		if instr.Op == BC_JUMP {
			if vm.PollEnabled && instr.Aux < pc {
				vmPollPoint(vm, funcIdx, instr.Aux, regsOff)
			}
			pc = instr.Aux
			continue
		}
		if instr.Op == BC_BRANCH {
			var tgt int = instr.Aux
			if regs[instr.Src1] != 0 { tgt = instr.Imm }
			if vm.PollEnabled && tgt < pc {
				vmPollPoint(vm, funcIdx, tgt, regsOff)
			}
			pc = tgt
			continue
		}

		if instr.Op == BC_RETURN || instr.Op == BC_RETURN64 {
			var retVal int = 0
			var retHi int = 0
			var copySize int = 0
			// Pair return (int64/uint64/float64 single-return on a
			// host whose word is < 8 bytes — Layer 2 step 2b): read
			// both slots of the source pair; copySize stays 0 so the
			// pointer-into-callee memcpy below is skipped (the value
			// lives in registers, not callee memory).
			var isPair bool = instr.Op == BC_RETURN64
			if isPair {
				retVal = regs[instr.Src1]
				retHi = regs[instr.Src1 + 1]
			} else if instr.Dst == 0 {
				retVal = regs[instr.Src1]
				// Aggregate single-return: bytes to copy back
				// (set by lowerReturn). 0 for scalars/pointers.
				copySize = instr.Aux
			} else if instr.Dst > 0 {
				retVal, copySize = packMultiReturn(
						vm, regs, instr, f)
			}
			// Read frame header (just before registers)
			var hdr *int = stackPtr(vm, regsOff - FRAME_HDR)
			if hdr[0] == -1 {
				// Top-level frame -> execFunc: a pair (BC_RETURN64, 64-bit
				// scalar on ILP32) joins both slots; a one-word result
				// (scalar / pointer / aggregate address) sign-extends.
				if isPair { return joinInt64(retVal, retHi) }
				return cast(int64, retVal)
			}
			// Pop frame: restore caller state
			var callerPC int = hdr[0]
			var callerFuncIdx int = hdr[1]
			var callerRegsOff int = hdr[2]
			var callerSP int = hdr[3]
			var callerDst int = hdr[4]
			// freeOnPop: set by BC_REFDEC_INLINE_FAST's iterative
			// dispatch when it pushes a dtor frame. After we restore
			// caller state below, rt.Free this payload — completing
			// the "decrement → run dtor → free" sequence without
			// host recursion. 0 = no action.
			var freeOnPop int = hdr[5]
			// If retVal points into the callee's region (a struct
			// alloca, packed multi-return, or managed-slice
			// header), we must copy it back to caller space so
			// the callee's frame can be popped cleanly. Without
			// this copy, callerSP would have to be bumped to
			// vm.SP, leaking the entire callee frame on every
			// call — a tight loop blows the stack quickly.
			// Mirrors execFunc's same logic for the entry frame.
			var sbase int = bit_cast(int, vm.Stack)
			if copySize > 0 && retVal >= sbase + callerSP && retVal < sbase + vm.SP {
				rt.MemCopy(
						bit_cast(*uint8, sbase + callerSP), bit_cast(*uint8, retVal), copySize)
				retVal = sbase + callerSP
				callerSP = callerSP + copySize
			}
			vm.SP = callerSP
			// Restore caller context
			funcIdx = callerFuncIdx
			f = vm.Funcs[funcIdx]
			code = f.Code
			regsOff = callerRegsOff
			regs = stackPtr(vm, regsOff)
			frameBase = bit_cast(*uint8, bit_cast(int, vm.Stack) + regsOff + f.NumRegs * REG_SLOT)
			pc = callerPC
			if callerDst >= 0 {
				regs[callerDst] = retVal
				if isPair {
					regs[callerDst + 1] = retHi
				}
			}
			if freeOnPop != 0 {
				rt.Free(bit_cast(*uint8, freeOnPop))
			}
			continue
		}

		if instr.Op == BC_UNWIND_RETURN {
			// Cleanup-pad terminator (Plan 2): the live managed set at the fault
			// point has been RefDec'd.  In Inc 2b the exec loop branches to a pad
			// ONLY in the entry frame (a nested fault takes the legacy fatal path —
			// see the execManagedMemoryOp consume point above), so a pad always
			// terminates in the entry frame: pop nothing, just return to the host
			// with Status == VM_STATUS_FAULTED (the value is unused on the fault
			// path — the host reads Status, not the result).  Cross-frame unwind (a
			// pad popping to a caller's call-site pad) needs call-site pads and lands
			// in Inc 3; until then a non-entry pad is a lowering/logic bug.
			var uhdr *int = stackPtr(vm, regsOff - FRAME_HDR)
			if uhdr[0] != -1 {
				vmPanic("vm: BC_UNWIND_RETURN in a non-entry frame (cross-frame recovery is Inc 3)")
			}
			return cast(int64, 0)
		}

		// --- Function calls ---
		if instr.Op == BC_CALL {
			// Imm packs the arg-slot count with a scalar64-return flag (bit 20,
			// packCallImm); every Imm read below uses the masked nSlots.  The
			// flag only steers the extern result store (see storeExternResult).
			var nSlots int = callImmSlots(instr.Imm)
			var calleeFuncIdx int = f.CallCache[instr.Aux]
			if calleeFuncIdx == -2 {
				calleeFuncIdx = vm.LookupFunc(f.Names[instr.Aux])
				f.CallCache[instr.Aux] = calleeFuncIdx
			}
			if calleeFuncIdx < 0 {
				// Extern call (no VM frame pushed — returns inline, so it lives
				// in a helper): dispatch through the per-function shim and store
				// the result.  See execExternCall in vm_extern.bn.
				execExternCall(vm, f, regs, callArgs, instr, nSlots)
				continue
			}
			// VM function call: push frame, switch context
			var calleeFunc @VMFunc = vm.Funcs[calleeFuncIdx]
			var newRegsOff int = pushFrame(vm, calleeFunc, pc, funcIdx, regsOff, vm.SP, instr.Dst)
			// Copy args to callee params.  Imm is the packed slot
			// count (Layer 2 step 2b); NumParamSlots is the callee's
			// matching slot count.  On a 64-bit host both equal the
			// arg/param count, so this is unchanged there.
			var newRegs *int = stackPtr(vm, newRegsOff)
			for i := 0; i < nSlots && i < calleeFunc.NumParamSlots; i++ {
				newRegs[i] = regs[instr.Src1 + i]
			}
			// Switch to callee
			funcIdx = calleeFuncIdx
			f = calleeFunc
			code = f.Code
			regsOff = newRegsOff
			regs = newRegs
			frameBase = bit_cast(*uint8, bit_cast(int, vm.Stack) + newRegsOff + f.NumRegs * REG_SLOT)
			pc = 0
			continue
		}

		if instr.Op == BC_CALL_INDIRECT {
			// After Phase 4 of plan-uniform-native-fnptrs.md the only
			// IR-magic callers of OP_CALL_INDIRECT are
			// `_call_shim_scalar` / `_call_shim_aggregate` (see
			// gen_call.bn).  Both pass a native fn ptr in Src1 — never
			// an intra-vm idx — so dispatchNativeIndirect handles
			// every reachable case.  `_call_dtor` and `_call_free_fn`
			// now go through OP_CALL_HANDLE → BC_CALL_FUNC_VALUE; the
			// old magnitude-based discrimination (small fnIdx → vm
			// idx, large → native ptr) is gone.
			var fnPtr int = regs[instr.Src1]
			if fnPtr == 0 {
				println("vm: indirect call through nil function pointer")
				rt.Exit(1)
			}
			if dispatchNativeIndirect(vm, regs, instr, fnPtr) {
				continue
			}
			vmPanicName("vm: indirect call: unhandled Imm shape; Imm=", strconv.Itoa(instr.Imm))
		}

		if instr.Op == BC_CALL_FUNC_VALUE {
			// Dispatch extracted to execCallFuncValue (vm_exec_funcref.bn)
			// for file length.  It either handles a compiled-side value
			// inline (pushed=false, continue at pc) or pushes a VM frame
			// (pushed=true) whose control state we switch to here.
			var nfi int = 0
			var nro int = 0
			var pushed bool = false
			nfi, nro, pushed = execCallFuncValue(vm, instr, pc, funcIdx, regsOff, regs)
			if pushed {
				funcIdx = nfi
				f = vm.Funcs[funcIdx]
				code = f.Code
				regsOff = nro
				regs = stackPtr(vm, regsOff)
				frameBase = bit_cast(*uint8, bit_cast(int, vm.Stack) + regsOff + f.NumRegs * REG_SLOT)
				pc = 0
			}
			continue
		}

		if instr.Op == BC_CALL_IFACE_METHOD {
			// Slice 2.3c of plan-interface-syntax-revision.md.
			// Read the iv slot at regs[Src1]; iv[0] = data ptr,
			// iv[1] = 1-based vtable index into vm.IfaceVtables
			// (0 = nil iv — see execIfaceOp's BC_IFACE_VALUE arm
			// for the encoding rationale). Aux is the absolute
			// vtable slot (slot 0 = dtor; see below). Args follow
			// at [Src2, Src2+Imm-1]; the data ptr is prepended to
			// them as the impl method's receiver argument.
			var ivAddr int = regs[instr.Src1]
			if ivAddr == 0 {
				println("vm: call through nil interface value")
				rt.Exit(1)
			}
			var iv *int = bit_cast(*int, ivAddr)
			var dataPtr int = iv[types.IfaceValueDataIndex()]
			var vtIdxPlus int = iv[types.IfaceValueVtableIndex()]
			if vtIdxPlus == 0 {
				println("vm: call through nil interface value")
				rt.Exit(1)
			}
			if ifaceVtIsNative(vm, vtIdxPlus) {
				// iv came from an injected COMPILED package: iv[1] is a
				// native @__ivt pointer.  Dispatch the method natively
				// through the shim primitives (no VM frame).
				dispatchCompiledIfaceMethod(vm, regs, instr, iv)
				continue
			}
			var vtIdx int = vtIdxPlus - 1
			if vtIdx < 0 || vtIdx >= len(vm.IfaceVtables) {
				vmPanic("vm: interface vtable index out of range")
			}
			var vt @IfaceVtable = vm.IfaceVtables[vtIdx]
			// instr.Aux is the absolute vtable slot (Slice E.4 of
			// plan-interface-embedding.md).  Slots 0-1 are the any-block
			// (dtor, then *TypeInfo); methods live at slot >= 2, with
			// extended interfaces' inherited methods landing inside nested
			// parent sub-vtables (still absolute offsets).
			// Aux's low 16 bits hold the slot; the high bits carry the
			// method result size (used only by the native-vtable path,
			// dispatchCompiledIfaceMethod) — mask them off here.
			var slot int = instr.Aux & 65535
			if slot < 2 || slot >= len(vt.Methods) {
				vmPanic("vm: interface method slot out of range")
			}
			var fnIdx int = vt.Methods[slot]
			if fnIdx == 0 {
				vmPanic("vm: interface method slot is empty")
			}
			var calleeFuncIdx int = fnIdx - 1
			var calleeFunc @VMFunc = vm.Funcs[calleeFuncIdx]
			var newRegsOff int = pushFrame(vm, calleeFunc, pc, funcIdx, regsOff, vm.SP, instr.Dst)
			var newRegs *int = stackPtr(vm, newRegsOff)
			// Receiver: data ptr in slot 0 (pointer = one slot);
			// user args follow as packed slots.  Imm is the packed
			// slot count of user args (Layer 2 step 2b); bound
			// against NumParamSlots, which includes the 1-slot
			// receiver.  No-op on a 64-bit host.
			newRegs[0] = dataPtr
			for i := 0; i < instr.Imm && i + 1 < calleeFunc.NumParamSlots; i++ {
				newRegs[i + 1] = regs[instr.Src2 + i]
			}
			funcIdx = calleeFuncIdx
			f = calleeFunc
			code = f.Code
			regsOff = newRegsOff
			regs = newRegs
			frameBase = bit_cast(*uint8, bit_cast(int, vm.Stack) + newRegsOff + f.NumRegs * REG_SLOT)
			pc = 0
			continue
		}

		// --- Managed memory ---
		// BC_REFINC_INLINE / BC_ALLOC / BC_BOX / BC_NIL_CHECK /
		// BC_BOUNDS_CHECK / BC_MAKE_SLICE all dispatch through
		// execManagedMemoryOp; they don't touch loop-local control
		// state and so live in vm_exec_helpers.bn.
		if execManagedMemoryOp(vm, regs, instr) {
			if vm.FaultRaised {
				// A guard inside execManagedMemoryOp raised a recoverable fault (Plan
				// 2).  Consume the signal and jump to the cleanup pad; pc is already
				// the post-op pc (loop pre-incremented) == the op's FaultTable key.
				vm.FaultRaised = false
				pc = dispatchFaultPad(vm, f, regsOff, pc)
			}
			continue
		}
		if instr.Op == BC_REFDEC_INLINE_FAST {
			// Inline-fast-path RefDec: nil-check + decrement always
			// inline (no rt.RefDec call).  Slow path picks one of:
			//   * No-dtor (Src2 == 0): rt.Free(ptr).
			//   * VM-side dtor (handle.data is a VMClosureRec):
			//     iterative push — inline here because it mutates
			//     execLoop's frame locals (funcIdx, f, code,
			//     regsOff, regs, frameBase, pc).  BC_RETURN pops the
			//     frame and frees ptr via freeOnPop, so no host
			//     C-stack recursion through the dtor field graph
			//     (which is what blows the stack at -int-int depths).
			//   * Cross-mode dtor: handed off to
			//     refDecCrossModeDispatch in vm_exec_helpers.bn.
			//     That path can't mutate loop state safely (it
			//     calls back through native), so it lives in a
			//     separate function.
			// Src2 register holds a function-value handle pointer
			// (post-Phase-4 of plan-uniform-native-fnptrs.md;
			// emitManagedPtrRefDec emits OP_FUNC_HANDLE for it).
			var ptr *uint8 = bit_cast(*uint8, regs[instr.Src1])
			if ptr == nil { continue }
			var hd *int = bit_cast(*int, bit_cast(int, ptr) - MANAGED_HDR)
			if hd[0] < 0 { continue } // immortal static-managed data
			hd[0] = hd[0] - 1
			if hd[0] != 0 { continue }
			var dtorHandle int = 0
			if instr.Src2 >= 0 { dtorHandle = regs[instr.Src2] }
			if dtorHandle == compiledClosureDtorMark {
				// ptr is a capturing closure's COMPILED_CLOSURE record
				// (only IsClosure callees mark their vtable dtor slot
				// with the sentinel).  The rec owns the heap closure
				// struct at rec[3]; func-value copies RefInc/RefDec the
				// rec, not the struct, so the struct sits at refcount 1
				// and must be released now (the last copy is dying) or
				// it and its captured managed values leak.  Free the
				// rec, then RefDec the struct; at zero run its dtor
				// (iterative push, like the VM_CLOSURE_REC arm below) so
				// captures are released and the struct freed.
				var ccRec *int = bit_cast(*int, ptr)
				var csAddr int = ccRec[3]
				var ccFnIdx int = ccRec[2]
				rt.Free(ptr)
				if csAddr == 0 { continue }
				var csHd *int = bit_cast(*int, csAddr - MANAGED_HDR)
				if csHd[0] < 0 { continue } // immortal closure struct
				csHd[0] = csHd[0] - 1
				if csHd[0] != 0 { continue }
				var ccFunc @VMFunc = vm.Funcs[ccFnIdx - 1]
				if len(ccFunc.ClosureStructDtorName) == 0 {
					// No managed captures: just free the struct.
					rt.Free(bit_cast(*uint8, csAddr))
					continue
				}
				var dIdx int = vm.LookupFunc(ccFunc.ClosureStructDtorName)
				if dIdx < 0 {
					vmPanic("vm: closure-struct dtor not found")
				}
				var ccDtor @VMFunc = vm.Funcs[dIdx]
				var ccRegsOff int = pushFrame(vm, ccDtor, pc, funcIdx, regsOff, vm.SP, -1)
				var ccHdr *int = stackPtr(vm, ccRegsOff - FRAME_HDR)
				ccHdr[5] = csAddr
				var ccRegs *int = stackPtr(vm, ccRegsOff)
				ccRegs[0] = csAddr
				funcIdx = dIdx
				f = ccDtor
				code = f.Code
				regsOff = ccRegsOff
				regs = ccRegs
				frameBase = bit_cast(*uint8, bit_cast(int, vm.Stack) + ccRegsOff + f.NumRegs * REG_SLOT)
				pc = 0
				continue
			}
			if dtorHandle == 0 {
				rt.Free(ptr)
				continue
			}
			var handlePtr *int = bit_cast(*int, dtorHandle)
			var dataAddr int = handlePtr[types.FuncValueDataIndex()]
			if dataAddr != 0 {
				var closureRec *int = bit_cast(*int, dataAddr)
				if closureRec[0] == rt.DATA_KIND_VM_CLOSURE_REC {
					var fnIdx int = closureRec[2]
					if fnIdx == 0 {
						vmPanic("vm: BC_REFDEC dtor closure rec has nil func_idx")
					}
					var dtorFunc @VMFunc = vm.Funcs[fnIdx - 1]
					var newRegsOff int = pushFrame(vm, dtorFunc, pc, funcIdx, regsOff, vm.SP, -1)
					var newHdr *int = stackPtr(vm, newRegsOff - FRAME_HDR)
					newHdr[5] = bit_cast(int, ptr)
					var newRegs *int = stackPtr(vm, newRegsOff)
					newRegs[0] = bit_cast(int, ptr)
					funcIdx = fnIdx - 1
					f = dtorFunc
					code = f.Code
					regsOff = newRegsOff
					regs = newRegs
					frameBase = bit_cast(*uint8, bit_cast(int, vm.Stack) + newRegsOff + f.NumRegs * REG_SLOT)
					pc = 0
					continue
				}
			}
			refDecCrossModeDispatch(handlePtr[types.FuncValueVtableIndex()], dataAddr, ptr)
			continue
		}
		if execFuncRefOp(vm, f, regs, instr) { continue }
		if execNumericCast(regs, instr) { continue }
		if execNumericCast64(regs, instr) { continue }

		vmPanicName("vm: unhandled opcode ", strconv.Itoa(instr.Op))
	}
	return 0
}
