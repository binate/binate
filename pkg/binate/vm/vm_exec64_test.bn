package "pkg/binate/vm"

import "pkg/builtins/testing"

// Coverage for the pure 64-bit op computation (evalArith64 /
// evalCmp64).  execOp64's glue (join src pairs → eval → split to dst)
// rests on these plus the tested splitInt64/joinInt64, and is
// exercised end-to-end by the int64-on-arm32 conformance test.

func TestEvalArith64() testing.TestResult {
	var big int64 = cast(int64, 1) << cast(int64, 40) // > 2^32
	var r int64
	var ok bool
	r, ok = evalArith64(BC_ADD64, big, cast(int64, 5))
	if !ok || r != big + cast(int64, 5) { return "ADD64" }
	r, ok = evalArith64(BC_SUB64, big, cast(int64, 5))
	if !ok || r != big - cast(int64, 5) { return "SUB64" }
	r, ok = evalArith64(BC_MUL64, cast(int64, 3000000000), cast(int64, 3))
	if !ok || r != cast(int64, 9000000000) { return "MUL64 past 2^32" }
	r, ok = evalArith64(BC_AND64, big, big)
	if !ok || r != big { return "AND64" }
	// not an arith op
	r, ok = evalArith64(BC_EQ64, big, big)
	if ok { return "evalArith64 must reject a compare op" }
	return ""
}

// Unsigned division/remainder must treat a bit-63-set operand as a
// large positive, not a negative (where signed / would give 0).
func TestEvalArith64Unsigned() testing.TestResult {
	var hi int64 = cast(int64, -1) // 0xFFFFFFFFFFFFFFFF as uint64 = max
	var r int64
	var ok bool
	r, ok = evalArith64(BC_UDIV64, hi, cast(int64, 7))
	if !ok { return "UDIV64 not handled" }
	if r != cast(int64, cast(uint64, hi) / cast(uint64, 7)) {
		return "UDIV64 should divide as unsigned"
	}
	// signed DIV64 of the same bit pattern (-1 / 7) is 0 — confirms
	// the unsigned path differs.
	r, ok = evalArith64(BC_DIV64, hi, cast(int64, 7))
	if r != cast(int64, 0) { return "signed DIV64(-1,7) should be 0" }
	return ""
}

// NEG64 / BITNOT64 round-trip across the 32-bit boundary, and
// BITNOT64's XOR-with-(-1) idiom flips every bit (so ~0 == -1 and
// ~-1 == 0).
func TestEvalUnary64() testing.TestResult {
	var big int64 = cast(int64, 1) << cast(int64, 40)
	var r int64
	var ok bool
	r, ok = evalUnary64(BC_NEG64, big)
	if !ok || r != cast(int64, 0) - big { return "NEG64 of big" }
	r, ok = evalUnary64(BC_BITNOT64, cast(int64, 0))
	if !ok || r != cast(int64, -1) { return "BITNOT64 of 0 should be -1" }
	r, ok = evalUnary64(BC_BITNOT64, cast(int64, -1))
	if !ok || r != cast(int64, 0) { return "BITNOT64 of -1 should be 0" }
	r, ok = evalUnary64(BC_ADD64, big)
	if ok { return "evalUnary64 must reject a binary op" }
	return ""
}

// widen64Signed and widen64Unsigned diverge precisely on a
// bit-31-set input: signed sign-extends (the result is negative),
// unsigned zero-extends.  This is the case where dropping the
// distinction silently corrupts widened values on a 32-bit host.
func TestWiden64SignedVsUnsigned() testing.TestResult {
	// A host int whose low 32 bits are all-ones (bit 31 set): -1 IS that
	// pattern on both hosts, and widen64Signed/Unsigned read only the low 32
	// bits.  (`cast(int, cast(uint32, 0xFFFFFFFF))` would fail on ILP32: the
	// 0xFFFFFFFF constant does not fit a 32-bit signed cast target.)
	var x int = -1
	if widen64Signed(x) != cast(int64, -1) {
		return "widen64Signed should sign-extend to -1"
	}
	if widen64Unsigned(x) != cast(int64, 0xFFFFFFFF) {
		return "widen64Unsigned should zero-extend to 0xFFFFFFFF"
	}
	// Small positive: both agree.
	if widen64Signed(42) != cast(int64, 42) { return "S(42) != 42" }
	if widen64Unsigned(42) != cast(int64, 42) { return "U(42) != 42" }
	return ""
}

// Shifts span the 32-bit boundary (so the pair representation
// matters) and distinguish arithmetic (BC_SHR64, sign-propagating)
// from logical (BC_LSHR64, zero-filling) right shifts.
func TestEvalShift64() testing.TestResult {
	var r int64
	var ok bool
	// 1 << 40 lands entirely in the high word.
	r, ok = evalShift64(BC_SHL64, cast(int64, 1), 40)
	if !ok || r != cast(int64, 1) << cast(int64, 40) { return "SHL64 by 40" }
	// arithmetic >> of a negative keeps the sign.
	r, ok = evalShift64(BC_SHR64, cast(int64, -1), 8)
	if !ok || r != cast(int64, -1) { return "SHR64 of -1 stays -1 (arith)" }
	// logical >> of -1 (=u64 max) by 8 shifts in zeros.
	r, ok = evalShift64(BC_LSHR64, cast(int64, -1), 8)
	if !ok || r != cast(int64, bit_cast(uint64, cast(int64, -1)) >> cast(uint64, 8)) {
		return "LSHR64 must zero-fill"
	}
	r, ok = evalShift64(BC_ADD64, cast(int64, 1), 1)
	if ok { return "evalShift64 must reject a non-shift op" }
	return ""
}

func TestEvalCmp64() testing.TestResult {
	var big int64 = cast(int64, 1) << cast(int64, 40)
	var c bool
	var ok bool
	c, ok = evalCmp64(BC_SLT64, cast(int64, 5), big)
	if !ok || !c { return "5 <s big" }
	c, ok = evalCmp64(BC_EQ64, big, big)
	if !ok || !c { return "big ==  big" }
	// signed vs unsigned on a bit-63-set value: -1 <s 1 but -1 >u 1.
	c, ok = evalCmp64(BC_SLT64, cast(int64, -1), cast(int64, 1))
	if !ok || !c { return "-1 <s 1" }
	c, ok = evalCmp64(BC_ULT64, cast(int64, -1), cast(int64, 1))
	if !ok || c { return "-1 (=max u64) is NOT <u 1" }
	// not a compare op
	c, ok = evalCmp64(BC_ADD64, big, big)
	if ok { return "evalCmp64 must reject an arith op" }
	return ""
}

// Float64 helpers: ADD/SUB/MUL/DIV at float64 precision; the helpers
// take float64 directly so any bit-pattern subtleties live in the
// glue around them, not the math.  Op-routing rejection mirrors the
// int64 helpers.
func TestEvalFloatArith64() testing.TestResult {
	var r float64
	var ok bool
	r, ok = evalFloatArith64(BC_FADD64, 1.5, 2.25)
	if !ok || r != 3.75 { return "FADD64 1.5 + 2.25" }
	r, ok = evalFloatArith64(BC_FSUB64, 1.5, 2.25)
	if !ok || r != 0.0 - 0.75 { return "FSUB64 1.5 - 2.25" }
	r, ok = evalFloatArith64(BC_FMUL64, 2.5, 4.0)
	if !ok || r != 10.0 { return "FMUL64 2.5 * 4.0" }
	r, ok = evalFloatArith64(BC_FDIV64, 9.0, 4.0)
	if !ok || r != 2.25 { return "FDIV64 9.0 / 4.0" }
	// Sub-normal: 1e-300 * 1e-30 underflows float32 but is fine at
	// float64 precision — establishes the helper isn't accidentally
	// narrowing through float32.
	r, ok = evalFloatArith64(BC_FMUL64, 1.0e-300, 1.0e-30)
	if !ok || r != 1.0e-330 { return "FMUL64 must keep float64 precision" }
	// not an arith op
	r, ok = evalFloatArith64(BC_FEQ64, 1.0, 1.0)
	if ok { return "evalFloatArith64 must reject a compare op" }
	return ""
}

// Float64 compares follow IEEE 754 / Go: `==` and the four relationals
// are ordered (false when either operand is NaN), and `!=` is unordered
// (true when either is NaN) so it stays the exact complement of `==`.
// evalFloatCmp64 realizes each via the host operator, so this pins the
// VM side of the float-compare semantics.
func TestEvalFloatCmp64() testing.TestResult {
	var c bool
	var ok bool
	c, ok = evalFloatCmp64(BC_FEQ64, 1.0, 1.0)
	if !ok || !c { return "1.0 == 1.0" }
	c, ok = evalFloatCmp64(BC_FNE64, 1.0, 2.0)
	if !ok || !c { return "1.0 != 2.0" }
	c, ok = evalFloatCmp64(BC_FLT64, 1.0, 2.0)
	if !ok || !c { return "1.0 < 2.0" }
	c, ok = evalFloatCmp64(BC_FLE64, 1.0, 1.0)
	if !ok || !c { return "1.0 <= 1.0" }
	c, ok = evalFloatCmp64(BC_FGT64, 2.0, 1.0)
	if !ok || !c { return "2.0 > 1.0" }
	c, ok = evalFloatCmp64(BC_FGE64, 1.0, 1.0)
	if !ok || !c { return "1.0 >= 1.0" }
	// NaN: the ordered compares (==, <, <=, >, >=) are false, but `!=`
	// is unordered and must be true (the IEEE complement of ==).
	var nan float64 = 0.0 / 0.0
	c, ok = evalFloatCmp64(BC_FEQ64, nan, nan)
	if !ok || c { return "NaN == NaN must be false" }
	c, ok = evalFloatCmp64(BC_FNE64, nan, nan)
	if !ok || !c { return "NaN != NaN must be true (unordered, IEEE)" }
	c, ok = evalFloatCmp64(BC_FLT64, nan, 0.0)
	if !ok || c { return "NaN < 0.0 must be false" }
	c, ok = evalFloatCmp64(BC_FLE64, nan, 0.0)
	if !ok || c { return "NaN <= 0.0 must be false" }
	c, ok = evalFloatCmp64(BC_FGT64, nan, 0.0)
	if !ok || c { return "NaN > 0.0 must be false" }
	c, ok = evalFloatCmp64(BC_FGE64, nan, 0.0)
	if !ok || c { return "NaN >= 0.0 must be false" }
	// not a compare op
	c, ok = evalFloatCmp64(BC_FADD64, 1.0, 1.0)
	if ok { return "evalFloatCmp64 must reject an arith op" }
	return ""
}

// Float64 negation mirrors BC_FNEG's `0.0 - a` idiom — so `-1.5`
// round-trips with FNEG, large magnitudes work, and a NaN stays NaN.
// (The `0 - 0 == +0` IEEE-default-rounding rule means FNEG64 of 0.0
// stays bit-identical to 0.0; that's the same behavior as BC_FNEG,
// not a distinction worth testing.)  Op-routing rejection mirrors
// the int64 unary helper.
func TestEvalFloatNeg64() testing.TestResult {
	var r float64
	var ok bool
	r, ok = evalFloatNeg64(BC_FNEG64, 1.5)
	if !ok || r != 0.0 - 1.5 { return "FNEG64 1.5" }
	r, ok = evalFloatNeg64(BC_FNEG64, 0.0 - 1.5)
	if !ok || r != 1.5 { return "FNEG64 of -1.5" }
	// Large magnitude past 2^32 — well within float64 dynamic range,
	// catches a hypothetical narrowing-through-float32 mistake.
	r, ok = evalFloatNeg64(BC_FNEG64, 1.0e20)
	if !ok || r != 0.0 - 1.0e20 { return "FNEG64 of 1e20" }
	// not a unary op (BC_FADD64 is binary)
	r, ok = evalFloatNeg64(BC_FADD64, 1.0)
	if ok { return "evalFloatNeg64 must reject a non-FNEG64 op" }
	return ""
}

// execOp64 glue for BC_F*64: the dispatch is unreachable from
// lowered code on a 64-bit host (REG_SLOT == 8, lowering keeps
// float64 in a single slot) so these direct tests are how the glue
// is validated until float64-on-32-bit lowering lands and an arm32
// conformance test exercises it end-to-end.

// execOp64 BC_FADD64: write a pair, read it back as float64, add to
// another pair, write the sum pair, read it back, check.  Exercises
// the full join → bit_cast → compute → bit_cast → split chain.
func TestExecOp64FloatBinary() testing.TestResult {
	// Lay out a small register file as a stack array: slots 0,1 =
	// src1 pair (1.5), slots 2,3 = src2 pair (2.25), slots 4,5 =
	// dst pair.  Stack array (not @[]int) so `&regsArr[0]` is a
	// plain *int into a contiguous buffer.
	var regsArr [8]int
	var alo int
	var ahi int
	alo, ahi = splitInt64(bit_cast(int64, 1.5))
	regsArr[0] = alo
	regsArr[1] = ahi
	var blo int
	var bhi int
	blo, bhi = splitInt64(bit_cast(int64, 2.25))
	regsArr[2] = blo
	regsArr[3] = bhi

	var instr BCInstr
	instr.Op = BC_FADD64
	instr.Dst = 4
	instr.Src1 = 0
	instr.Src2 = 2
	if !execOp64(&regsArr[0], instr) {
		return "execOp64 must handle BC_FADD64"
	}
	var rbits int64 = joinInt64(regsArr[4], regsArr[5])
	var r float64 = bit_cast(float64, rbits)
	if r != 3.75 { return "BC_FADD64 1.5 + 2.25 should be 3.75" }
	return ""
}

// execOp64 BC_FNEG64: unary path — single source pair, single
// destination pair.  Exercises the float-unary branch (which is
// distinct from the int-unary BC_NEG64 / BC_BITNOT64 branch).
func TestExecOp64FloatNeg() testing.TestResult {
	var regsArr [4]int
	var alo int
	var ahi int
	alo, ahi = splitInt64(bit_cast(int64, 1.5))
	regsArr[0] = alo
	regsArr[1] = ahi

	var instr BCInstr
	instr.Op = BC_FNEG64
	instr.Dst = 2
	instr.Src1 = 0
	if !execOp64(&regsArr[0], instr) {
		return "execOp64 must handle BC_FNEG64"
	}
	var rbits int64 = joinInt64(regsArr[2], regsArr[3])
	var r float64 = bit_cast(float64, rbits)
	if r != 0.0 - 1.5 { return "BC_FNEG64 of 1.5 should be -1.5" }
	return ""
}

// execOp64 BC_FLT64: compare path — two source pairs, Dst is a
// single bool slot (NOT a pair).  The single-slot write distinguishes
// this glue from the binary-arith glue above.
func TestExecOp64FloatCmpWritesSingleSlot() testing.TestResult {
	var regsArr [6]int
	var alo int
	var ahi int
	alo, ahi = splitInt64(bit_cast(int64, 1.0))
	regsArr[0] = alo
	regsArr[1] = ahi
	var blo int
	var bhi int
	blo, bhi = splitInt64(bit_cast(int64, 2.0))
	regsArr[2] = blo
	regsArr[3] = bhi
	// Pre-poison Dst+1 with a sentinel.  A correct compare writes
	// ONLY regs[Dst]; a buggy split-write would clobber Dst+1.
	regsArr[4] = 0
	regsArr[5] = -42

	var instr BCInstr
	instr.Op = BC_FLT64
	instr.Dst = 4
	instr.Src1 = 0
	instr.Src2 = 2
	if !execOp64(&regsArr[0], instr) {
		return "execOp64 must handle BC_FLT64"
	}
	if regsArr[4] != 1 { return "BC_FLT64 1.0 < 2.0 should be 1" }
	if regsArr[5] != -42 {
		return "BC_FLT64 must write only a single slot; Dst+1 was clobbered"
	}
	return ""
}
