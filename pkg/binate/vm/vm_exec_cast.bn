package "pkg/binate/vm"

// Numeric-cast bytecode execution (the OP_CAST family) — see execNumericCast.

// execNumericCast dispatches the numeric narrowing / int-float casts
// (BC_TRUNC8, BC_SITOF, BC_UITOF, BC_SITOF32, BC_UITOF32, BC_FTOSI,
// BC_FTOUI, BC_F32TOSI, BC_F32TOUI, BC_F64_TO_F32, BC_F32_TO_F64). Pure
// register-to-register; no side effects.
//
// Float64 bits ride through int64 (not host-int) so the bit_cast is
// always 64↔64 — portable across hosts whose word is smaller than 8
// bytes, where `bit_cast(int, float64)` would be a size mismatch.  On
// a 64-bit host the cast(int, int64) / cast(int64, int) hops are
// identities.  On a 32-bit host these handlers are dead path (lowering
// will emit pair-aware variants once float64-on-32-bit lowering lands)
// — they only need to compile cleanly.
func execNumericCast(regs *int, instr BCInstr) bool {
	switch instr.Op {
	case BC_TRUNC8: regs[instr.Dst] = regs[instr.Src1] & 255; return true
	case BC_TRUNC32:
		// Mask to low 32 bits.  Cast through uint32: on a 32-bit host
		// this is identity (host word == uint32); on a 64-bit host it
		// drops the upper 32 bits then zero-extends back to int.
		regs[instr.Dst] = cast(int, cast(uint32, regs[instr.Src1]))
		return true
	case BC_SEXT:
		regs[instr.Dst] = narrowToWidth(regs[instr.Src1], instr.Imm, true)
		return true
	case BC_ZEXT:
		regs[instr.Dst] = narrowToWidth(regs[instr.Src1], instr.Imm, false)
		return true
	case BC_SITOF:
		// int → float64.  On a 32-bit host the float64 result
		// occupies a register pair (Src1 stays a single int slot —
		// the source is host-int, not int64-on-32-bit).
		var i int = regs[instr.Src1]
		var bits int64 = bit_cast(int64, cast(float64, i))
		if REG_SLOT < 8 {
			var lo int
			var hi int
			lo, hi = splitInt64(bits)
			regs[instr.Dst] = lo
			regs[instr.Dst + 1] = hi
		} else {
			regs[instr.Dst] = cast(int, bits)
		}
		return true
	case BC_UITOF:
		// unsigned int → float64.  Reinterpret the host-int register
		// bits as uint64 before converting, so a value with the high bit
		// set yields a large positive double — not the negative one the
		// signed BC_SITOF would.  (uint32 and narrower are zero-extended,
		// so they already agree with BC_SITOF; this only changes the
		// uint64/uint high-bit-set case.)
		var u uint64 = cast(uint64, regs[instr.Src1])
		var ubits int64 = bit_cast(int64, cast(float64, u))
		if REG_SLOT < 8 {
			var ulo int
			var uhi int
			ulo, uhi = splitInt64(ubits)
			regs[instr.Dst] = ulo
			regs[instr.Dst + 1] = uhi
		} else {
			regs[instr.Dst] = cast(int, ubits)
		}
		return true
	case BC_FTOSI:
		// float64 → int.  On a 32-bit host the float64 source
		// occupies a register pair (low at Src1, high at Src1+1);
		// the int result stays a single host-int slot.
		var fbits int64
		if REG_SLOT < 8 {
			fbits = joinInt64(regs[instr.Src1], regs[instr.Src1 + 1])
		} else {
			fbits = cast(int64, regs[instr.Src1])
		}
		var f float64 = bit_cast(float64, fbits)
		regs[instr.Dst] = cast(int, f)
		return true
	case BC_FTOUI:
		// float64 → unsigned int.  Cast through uint64 so a value in
		// [2^63, 2^64) lands as the right large unsigned rather than the
		// saturated/overflowed signed result BC_FTOSI would give.
		var ufbits int64
		if REG_SLOT < 8 {
			ufbits = joinInt64(regs[instr.Src1], regs[instr.Src1 + 1])
		} else {
			ufbits = cast(int64, regs[instr.Src1])
		}
		var uf float64 = bit_cast(float64, ufbits)
		regs[instr.Dst] = cast(int, cast(uint64, uf))
		return true
	case BC_F32TOSI:
		// float32 → signed int.  float32 fits a single slot on any host;
		// no pair handling needed.
		var u32 uint32 = cast(uint32, regs[instr.Src1])
		var f32 float32 = bit_cast(float32, u32)
		regs[instr.Dst] = cast(int, f32)
		return true
	case BC_F32TOUI:
		// float32 → unsigned int.  Cast through uint64 so a value in
		// [2^63, 2^64) lands as the right large unsigned rather than the
		// saturated/overflowed signed result BC_F32TOSI would give
		// (mirrors BC_FTOUI vs BC_FTOSI for the float64 source).
		var u32u uint32 = cast(uint32, regs[instr.Src1])
		var f32u float32 = bit_cast(float32, u32u)
		regs[instr.Dst] = cast(int, cast(uint64, f32u))
		return true
	case BC_SITOF32:
		// signed int → float32.  The result is the float32 IEEE bits in
		// the low 4 bytes (the VM's float32 register form) — NOT a
		// float64 bit pattern, whose low word is usually zero and would
		// read back as ~0.  Source is a single host-int slot.
		var si int = regs[instr.Src1]
		var sif32 float32 = cast(float32, si)
		regs[instr.Dst] = cast(int, bit_cast(uint32, sif32))
		return true
	case BC_UITOF32:
		// unsigned int → float32.  Reinterpret the source register bits
		// as uint64 before converting, so a high-bit-set value rounds to
		// a large positive float32 rather than the negative one the
		// signed BC_SITOF32 would give (mirrors BC_UITOF vs BC_SITOF).
		var ui uint64 = cast(uint64, regs[instr.Src1])
		var uif32 float32 = cast(float32, ui)
		regs[instr.Dst] = cast(int, bit_cast(uint32, uif32))
		return true
	case BC_F64_TO_F32:
		// float64 → float32.  Source is pair on a 32-bit host;
		// destination is a single slot (float32 always fits one).
		var f64bits int64
		if REG_SLOT < 8 {
			f64bits = joinInt64(regs[instr.Src1], regs[instr.Src1 + 1])
		} else {
			f64bits = cast(int64, regs[instr.Src1])
		}
		var f64 float64 = bit_cast(float64, f64bits)
		var f32 float32 = cast(float32, f64)
		var u32 uint32 = bit_cast(uint32, f32)
		regs[instr.Dst] = cast(int, u32)
		return true
	case BC_F32_TO_F64:
		// float32 → float64.  Source is a single slot; destination
		// is a pair on a 32-bit host.
		var u32 uint32 = cast(uint32, regs[instr.Src1])
		var f32 float32 = bit_cast(float32, u32)
		var f64 float64 = cast(float64, f32)
		var f64bits int64 = bit_cast(int64, f64)
		if REG_SLOT < 8 {
			var lo int
			var hi int
			lo, hi = splitInt64(f64bits)
			regs[instr.Dst] = lo
			regs[instr.Dst + 1] = hi
		} else {
			regs[instr.Dst] = cast(int, f64bits)
		}
		return true
	}
	return false
}
