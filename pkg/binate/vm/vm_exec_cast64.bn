package "pkg/binate/vm"

// int64/uint64 <-> float conversion casts for a 32-bit host — the register-pair
// int64 counterparts of the single-slot casts in vm_exec_cast.bn.  Lowering
// (lower_cast.bn) emits these in place of BC_SITOF/BC_FTOSI/... only when the
// int operand is 64-bit AND REG_SLOT < 8, so the int64/uint64 side ALWAYS rides
// a register pair.  The handlers pair it UNCONDITIONALLY (join the source /
// split the dest) rather than branching on REG_SLOT, so a direct unit test on a
// 64-bit host exercises the real ILP32 data path — the same host-testable
// convention as execOp64's BC_*64 ops.  The float64 operand rides its own pair
// (dst for ->float64, src for float64->); a float32 operand is a single slot on
// any host.
func execNumericCast64(regs *int, instr BCInstr) bool {
	switch instr.Op {
	case BC_SI64TOF:
		// int64 -> float64: source pair, dest pair.
		var i64 int64 = joinInt64(regs[instr.Src1], regs[instr.Src1 + 1])
		var bits int64 = bit_cast(int64, cast(float64, i64))
		var lo int
		var hi int
		lo, hi = splitInt64(bits)
		regs[instr.Dst] = lo
		regs[instr.Dst + 1] = hi
		return true
	case BC_UI64TOF:
		// uint64 -> float64: reinterpret the joined pair as uint64 so a
		// high-bit-set value converts to a large positive double, not a negative.
		var u uint64 = cast(uint64,
			joinInt64(regs[instr.Src1], regs[instr.Src1 + 1]))
		var bits int64 = bit_cast(int64, cast(float64, u))
		var lo int
		var hi int
		lo, hi = splitInt64(bits)
		regs[instr.Dst] = lo
		regs[instr.Dst + 1] = hi
		return true
	case BC_SI64TOF32:
		// int64 -> float32: source pair, dest single (float32 bits, low 4 bytes).
		var i64 int64 = joinInt64(regs[instr.Src1], regs[instr.Src1 + 1])
		var f32 float32 = cast(float32, i64)
		regs[instr.Dst] = cast(int, bit_cast(uint32, f32))
		return true
	case BC_UI64TOF32:
		// uint64 -> float32: source pair (as uint64), dest single.
		var u uint64 = cast(uint64,
			joinInt64(regs[instr.Src1], regs[instr.Src1 + 1]))
		var f32 float32 = cast(float32, u)
		regs[instr.Dst] = cast(int, bit_cast(uint32, f32))
		return true
	case BC_FTOSI64:
		// float64 -> int64: source pair (float64 bits), dest pair (int64).
		var fbits int64 = joinInt64(regs[instr.Src1], regs[instr.Src1 + 1])
		var f float64 = bit_cast(float64, fbits)
		var lo int
		var hi int
		lo, hi = splitInt64(cast(int64, f))
		regs[instr.Dst] = lo
		regs[instr.Dst + 1] = hi
		return true
	case BC_FTOUI64:
		// float64 -> uint64: cast through uint64 so a value in [2^63, 2^64) lands
		// as the right large unsigned, not the saturated signed result.
		var fbits int64 = joinInt64(regs[instr.Src1], regs[instr.Src1 + 1])
		var f float64 = bit_cast(float64, fbits)
		var lo int
		var hi int
		lo, hi = splitInt64(bit_cast(int64, cast(uint64, f)))
		regs[instr.Dst] = lo
		regs[instr.Dst + 1] = hi
		return true
	case BC_F32TOSI64:
		// float32 -> int64: source single (float32), dest pair (int64).
		var u32 uint32 = cast(uint32, regs[instr.Src1])
		var f32 float32 = bit_cast(float32, u32)
		var lo int
		var hi int
		lo, hi = splitInt64(cast(int64, f32))
		regs[instr.Dst] = lo
		regs[instr.Dst + 1] = hi
		return true
	case BC_F32TOUI64:
		// float32 -> uint64: cast through uint64, dest pair.
		var u32 uint32 = cast(uint32, regs[instr.Src1])
		var f32 float32 = bit_cast(float32, u32)
		var lo int
		var hi int
		lo, hi = splitInt64(bit_cast(int64, cast(uint64, f32)))
		regs[instr.Dst] = lo
		regs[instr.Dst + 1] = hi
		return true
	}
	return false
}
