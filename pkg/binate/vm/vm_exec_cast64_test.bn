package "pkg/binate/vm"

import "pkg/builtins/testing"

// Direct handler coverage for execNumericCast64 (the int64<->float pair-variant
// conversions).  Each test drives a value whose HIGH 32 bits are significant, so
// a single-slot (host-int) read or write would truncate — the exact ILP32 bug
// these opcodes fix.  Because the handlers pair the int64 side unconditionally
// (not under REG_SLOT<8), these run on the 64-bit build host.  9e9 / 5e9 exceed
// 2^32; 1e19 exceeds 2^63 (int64 max) but fits uint64.

// int64 -> float64 (source pair, dest pair): the full 64-bit source converts.
func TestExecNumericCast64SI64TOF() testing.TestResult {
	var regsArr [4]int
	var v int64 = cast(int64, 9000000000)
	var lo int
	var hi int
	lo, hi = splitInt64(v)
	regsArr[0] = lo
	regsArr[1] = hi
	var instr BCInstr
	instr.Op = BC_SI64TOF
	instr.Dst = 2
	instr.Src1 = 0
	if !execNumericCast64(&regsArr[0], instr) {
		return "execNumericCast64 must handle BC_SI64TOF"
	}
	var r float64 = bit_cast(float64, joinInt64(regsArr[2], regsArr[3]))
	if r != cast(float64, v) {
		return "BC_SI64TOF must convert the full int64 (high half preserved)"
	}
	return ""
}

// uint64 -> float64: a bit-63-set source is a large POSITIVE double, not the
// negative one the signed variant would give.
func TestExecNumericCast64UI64TOF() testing.TestResult {
	var regsArr [4]int
	var v int64 = bit_cast(int64, cast(uint64, 0x8000000000000000))
	var lo int
	var hi int
	lo, hi = splitInt64(v)
	regsArr[0] = lo
	regsArr[1] = hi
	var instr BCInstr
	instr.Op = BC_UI64TOF
	instr.Dst = 2
	instr.Src1 = 0
	if !execNumericCast64(&regsArr[0], instr) {
		return "execNumericCast64 must handle BC_UI64TOF"
	}
	var r float64 = bit_cast(float64, joinInt64(regsArr[2], regsArr[3]))
	if r < 0.0 { return "BC_UI64TOF of a bit-63-set value must be positive" }
	if r != cast(float64, cast(uint64, v)) {
		return "BC_UI64TOF must treat the source as unsigned"
	}
	return ""
}

// int64 -> float32 (source pair, dest single slot).
func TestExecNumericCast64SI64TOF32() testing.TestResult {
	var regsArr [3]int
	var v int64 = cast(int64, 9000000000)
	var lo int
	var hi int
	lo, hi = splitInt64(v)
	regsArr[0] = lo
	regsArr[1] = hi
	var instr BCInstr
	instr.Op = BC_SI64TOF32
	instr.Dst = 2
	instr.Src1 = 0
	if !execNumericCast64(&regsArr[0], instr) {
		return "execNumericCast64 must handle BC_SI64TOF32"
	}
	var f32 float32 = bit_cast(float32, cast(uint32, regsArr[2]))
	if f32 != cast(float32, v) {
		return "BC_SI64TOF32 must convert the full int64 to float32"
	}
	return ""
}

// uint64 -> float32: unsigned source, single-slot dest.
func TestExecNumericCast64UI64TOF32() testing.TestResult {
	var regsArr [3]int
	var v int64 = bit_cast(int64, cast(uint64, 0x8000000000000000))
	var lo int
	var hi int
	lo, hi = splitInt64(v)
	regsArr[0] = lo
	regsArr[1] = hi
	var instr BCInstr
	instr.Op = BC_UI64TOF32
	instr.Dst = 2
	instr.Src1 = 0
	if !execNumericCast64(&regsArr[0], instr) {
		return "execNumericCast64 must handle BC_UI64TOF32"
	}
	var f32 float32 = bit_cast(float32, cast(uint32, regsArr[2]))
	if f32 != cast(float32, cast(uint64, v)) {
		return "BC_UI64TOF32 must treat the source as unsigned"
	}
	return ""
}

// float64 -> int64 (source pair, dest pair): round-trips the SI64TOF value.
func TestExecNumericCast64FTOSI64() testing.TestResult {
	var regsArr [4]int
	var v int64 = cast(int64, 9000000000)
	var lo int
	var hi int
	lo, hi = splitInt64(bit_cast(int64, cast(float64, v)))
	regsArr[0] = lo
	regsArr[1] = hi
	var instr BCInstr
	instr.Op = BC_FTOSI64
	instr.Dst = 2
	instr.Src1 = 0
	if !execNumericCast64(&regsArr[0], instr) {
		return "execNumericCast64 must handle BC_FTOSI64"
	}
	if joinInt64(regsArr[2], regsArr[3]) != v {
		return "BC_FTOSI64 must write the full int64 (high half written)"
	}
	return ""
}

// float64 -> uint64: a value in (2^63, 2^64) lands as the right large unsigned,
// not the saturated signed result.
func TestExecNumericCast64FTOUI64() testing.TestResult {
	var regsArr [4]int
	var f float64 = 1.0e19
	var lo int
	var hi int
	lo, hi = splitInt64(bit_cast(int64, f))
	regsArr[0] = lo
	regsArr[1] = hi
	var instr BCInstr
	instr.Op = BC_FTOUI64
	instr.Dst = 2
	instr.Src1 = 0
	if !execNumericCast64(&regsArr[0], instr) {
		return "execNumericCast64 must handle BC_FTOUI64"
	}
	var r uint64 = cast(uint64, joinInt64(regsArr[2], regsArr[3]))
	if r != cast(uint64, f) {
		return "BC_FTOUI64 must produce the large unsigned value"
	}
	return ""
}

// float32 -> int64 (source single, dest pair).
func TestExecNumericCast64F32TOSI64() testing.TestResult {
	var regsArr [3]int
	var v float32 = cast(float32, 5000000000)
	regsArr[0] = cast(int, bit_cast(uint32, v))
	var instr BCInstr
	instr.Op = BC_F32TOSI64
	instr.Dst = 1
	instr.Src1 = 0
	if !execNumericCast64(&regsArr[0], instr) {
		return "execNumericCast64 must handle BC_F32TOSI64"
	}
	if joinInt64(regsArr[1], regsArr[2]) != cast(int64, v) {
		return "BC_F32TOSI64 must write the full int64 from a float32 > 2^32"
	}
	return ""
}

// float32 -> uint64 (source single, dest pair): unsigned conversion.
func TestExecNumericCast64F32TOUI64() testing.TestResult {
	var regsArr [3]int
	var v float32 = cast(float32, 1.0e19)
	regsArr[0] = cast(int, bit_cast(uint32, v))
	var instr BCInstr
	instr.Op = BC_F32TOUI64
	instr.Dst = 1
	instr.Src1 = 0
	if !execNumericCast64(&regsArr[0], instr) {
		return "execNumericCast64 must handle BC_F32TOUI64"
	}
	var r uint64 = cast(uint64, joinInt64(regsArr[1], regsArr[2]))
	if r != cast(uint64, v) {
		return "BC_F32TOUI64 must produce the large unsigned value from float32"
	}
	return ""
}
