package "pkg/binate/vm"

import "pkg/builtins/testing"

// Tests for execNumericCast (vm_exec_cast.bn) — the OP_CAST execution
// family.  Driven via compileAndRun so the real lowering + VM execution
// path runs, rather than a hand-built BCInstr.  (Additional int->float32
// / float32->unsigned cast coverage lives in lower_cast_test.bn, which
// exercises the lowering decision plus these same handlers end-to-end.)

// Exercises execNumericCast's BC_FTOSI arm.
func TestVMFloatLitAndCast() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x float64 = 3.75\n")
	src = concatStr(src, "  return cast(int, x)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 3 { return "expected 3" }
	return ""
}

// Round-trip int → float64 → int. Exercises execNumericCast's
// BC_SITOF (going in) and BC_FTOSI (coming back).
func TestVMFloatIntConversion() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var i int = 7\n")
	src = concatStr(src, "  var f float64 = cast(float64, i)\n")
	src = concatStr(src, "  return cast(int, f)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 7 { return "expected 7" }
	return ""
}
