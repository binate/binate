package "pkg/binate/vm"

import "pkg/builtins/testing"

// Tests for execNumericCast (vm_exec_cast.bn) — the OP_CAST execution
// family.  Driven via compileAndRun so the real lowering + VM execution
// path runs, rather than a hand-built BCInstr.  (Additional int->float32
// / float32->unsigned cast coverage lives in lower_cast_test.bn, which
// exercises the lowering decision plus these same handlers end-to-end.)

// Exercises execNumericCast's BC_FTOSI arm.
func TestVMFloatLitAndCast() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x float64 = 3.75\n")
	src = concatStr(src, "  return cast(int, x)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 3 { return "expected 3" }
	return ""
}

// Round-trip int → float64 → int. Exercises execNumericCast's
// BC_SITOF (going in) and BC_FTOSI (coming back).
func TestVMFloatIntConversion() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var i int = 7\n")
	src = concatStr(src, "  var f float64 = cast(float64, i)\n")
	src = concatStr(src, "  return cast(int, f)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 7 { return "expected 7" }
	return ""
}

// zeroExtendHostWord must ZERO-extend the host word for an unsigned int→float
// source, not sign-extend it.  This is host-testable via an explicit slotBytes:
// the slotBytes==4 branch reproduces the real ILP32 bug (a uint32 2^31 fills the
// `int` slot and reads back negative) even on a 64-bit-host test run, where
// BC_UITOF/BC_UITOF32 themselves take the REG_SLOT==8 branch and can't.
func TestZeroExtendHostWordZeroExtends() testing.TestResult {
	// Build the expected uint64s by shifting so the test source has no bare
	// literal >= 2^31 (which would default to `int` and overflow on ILP32).
	var twoPow31 uint64 = cast(uint64, 1) << 31
	var uint32Max uint64 = (cast(uint64, 1) << 32) - cast(uint64, 1)
	// uint32 2^31 as a signed host int is -2147483648; on a 4-byte word it must
	// come back as 2^31, not the sign-extended 0xFFFFFFFF80000000.
	if zeroExtendHostWord(-2147483648, 4) != twoPow31 {
		return "slotBytes=4: high-bit host word must zero-extend to 2^31"
	}
	// All-ones 32-bit word (uint32 max) → 2^32-1, not -1 sign-extended.
	if zeroExtendHostWord(-1, 4) != uint32Max {
		return "slotBytes=4: all-ones word must be uint32 max"
	}
	// A low positive value is unaffected by the mask.
	if zeroExtendHostWord(255, 4) != cast(uint64, 255) {
		return "slotBytes=4: low value must pass through"
	}
	// On an 8-byte word there is no masking: the full sign-extended pattern is
	// kept (0xFFFFFFFF80000000 — the correct reinterpret for a real 64-bit
	// source, which never reaches the < 8-byte masking branch).
	var full64 uint64 = (uint32Max << 32) | twoPow31
	if zeroExtendHostWord(-2147483648, 8) != full64 {
		return "slotBytes=8: full 64-bit word kept unchanged"
	}
	return ""
}
