package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/std/strconv"

// Func-ref / function-value bytecode dispatch (BC_FUNC_HANDLE,
// BC_FUNC_VALUE, plus the cross-mode call shims). Split out of
// vm_exec_helpers.bn so that file stays under the soft length cap.
// execLoop in vm_exec.bn still calls execFuncRefOp directly; the
// move is text-only.

// compiledClosureDtorMark is the sentinel stored in a capturing closure's
// func-value vtable dtor slot (ensureHandle, for IsClosure callees).
// BC_REFDEC_INLINE_FAST recognizes it to know the value being freed is a
// COMPILED_CLOSURE record (and so must release the heap closure struct it
// points at).  A genuine dtor handle is the address of a heap/static
// VMFuncHandle and 0 means "no dtor", so -1 — never a valid address (the
// top of the address space is unmapped) and never 0 — can never collide.
const compiledClosureDtorMark int = -1

// execFuncRefOp dispatches BC_FUNC_HANDLE / BC_FUNC_VALUE. These
// read the call-site name cache and may lazily allocate a vtable +
// VM closure record on the heap — but they don't touch execLoop's
// control flow.
func execFuncRefOp(vm @VM, f @VMFunc, regs *int, instr BCInstr) bool {
	if instr.Op == BC_FUNC_HANDLE {
		// Phase 4: return *uint8 pointing at a two-word {vtable_ptr,
		// data_ptr} handle — same shape as native `@__handle.F`.
		// Two sources:
		//   1. Externs registry (the function is registered via
		//      RegisterExtern with a handle pointer; the binding
		//      owns a managed copy in HandleAddr) — propagated
		//      through nested vms by Externs-copy.
		//   2. Lazy heap-alloc on the VMFunc.Handle field for vm-
		//      local-only functions; the universal trampoline reads
		//      the closure record to dispatch via execFunc.
		var name @[]char = f.Names[instr.Aux]
		var eIdx int = vm.LookupExtern(name)
		if eIdx >= 0 && vm.Externs[eIdx].HandleAddr != nil {
			regs[instr.Dst] =
				bit_cast(int, vm.Externs[eIdx].HandleAddr)
			return true
		}
		var idx int = f.CallCache[instr.Aux]
		if idx == -2 {
			idx = vm.LookupFunc(name)
			f.CallCache[instr.Aux] = idx
		}
		if idx < 0 {
			vmPanicName("vm: function not found: ", name)
		}
		var callee @VMFunc = vm.Funcs[idx]
		ensureHandle(vm, callee, idx)
		regs[instr.Dst] = bit_cast(int, callee.Handle)
		return true
	}
	if instr.Op == BC_FUNC_VALUE {
		// Function-value construction. Look up the target
		// function (caching the index on the call site for
		// repeated executions), lazily allocate its vtable +
		// VM closure record on first use, and copy the two-word
		// {vtable_addr, closure_rec_addr} pair into a fresh
		// stack slot.
		//
		// Phase 1: vtable.call is left as 0 (placeholder).
		// Phase 3 will populate it with a per-signature
		// trampoline so cross-mode dispatch works. See
		// explorations/plan-function-values.md "VM-mode
		// vtables — interop-compatible from Phase 1".
		var idx int = f.CallCache[instr.Aux]
		if idx == -2 {
			idx = vm.LookupFunc(f.Names[instr.Aux])
			f.CallCache[instr.Aux] = idx
		}
		if idx < 0 {
			// LookupFunc miss: fall back to the executing VM's
			// vm.Externs registry.  Hosts (cmd/bni's main, test
			// drivers) populate the registry with bindings whose
			// VtableAddr already points at the right __vt — for
			// the C-shaped pkg/bootstrap surface (and pkg/builtins/rt,
			// which is native-only in the VM) this is the only
			// construction path available because they have no `.bn`
			// body the VM lowers.  Each layer's host
			// registers into the next layer's VM before that
			// layer's main runs, so this dispatch works at
			// arbitrary recursion depth (cmd/bni-on-cmd/bni etc.).
			var name @[]char = f.Names[instr.Aux]
			var eIdx int = vm.LookupExtern(name)
			if eIdx >= 0 {
				var binding ExternBinding = vm.Externs[eIdx]
				var fvAddr *int = stackPtr(vm, vm.SP)
				var fvAddrInt int =
					bit_cast(int, vm.Stack) + vm.SP
				vm.SP = vm.SP + 2 * REG_SLOT
				fvAddr[types.FuncValueVtableIndex()] = binding.VtableAddr
				fvAddr[types.FuncValueDataIndex()] = binding.DataAddr
				regs[instr.Dst] = fvAddrInt
				return true
			}
			vmPanicName("vm: function not found: ", name)
		}
		var callee @VMFunc = vm.Funcs[idx]
		ensureHandle(vm, callee, idx)
		// Build the function value in a fresh two-word {vtable,
		// data} stack slot at SP (2*REG_SLOT bytes — 16 on LP64, 8
		// on a 32-bit host); the slot's address is the result.
		var fvAddr *int = stackPtr(vm, vm.SP)
		var fvAddrInt int = bit_cast(int, vm.Stack) + vm.SP
		vm.SP = vm.SP + 2 * REG_SLOT
		fvAddr[types.FuncValueVtableIndex()] = bit_cast(int, callee.Vtable)
		// Data slot:
		//   - non-capturing (Src1 == -1): use the cached
		//     per-callee ClosureRec (Phase 1, shared identity).
		//   - capturing (Src1 != -1): allocate a fresh
		//     COMPILED_CLOSURE record on the VM stack pointing
		//     at the alloca'd closure struct in regs[Src1].
		if instr.Src1 == -1 {
			// Non-capturing: the data slot is the shared per-callee
			// ClosureRec.  RefInc it so this @func value owns a ref,
			// balancing the RefDec that emitManagedFuncValueRefDec
			// emits at the value's scope end.  Without this the shared
			// rec is freed by the first instance's scope-end RefDec,
			// dangling any surviving copy (e.g. one returned inside a
			// managed aggregate) — it later reaches BC_CALL_FUNC_VALUE
			// as a freed, zeroed record (kind 0).  (hd[0] < 0 is the
			// immortal static-managed sentinel.)
			var recAddr int = bit_cast(int, callee.ClosureRec)
			fvAddr[types.FuncValueDataIndex()] = recAddr
			var hd *int = bit_cast(*int, recAddr - MANAGED_HDR)
			if hd[0] >= 0 { hd[0] = hd[0] + 1 }
		} else {
			// Capturing closure: the data slot must survive the
			// statement-end SP_RESTORE that wipes vm.SP back to
			// frame_end.  A stack-allocated rec at SP would be
			// overwritten by the next statement's pushes (e.g.
			// BC_STRING_COPY_MS in a following println).  Heap-
			// allocate via rt.Alloc — a 4-word rec
			// ({kind, vm, fnIdx+1, captured}), 4*REG_SLOT bytes; the
			// rec is never freed (small leak, acceptable for B.2
			// *func — B.3 @func will hook this into the closure's
			// refcount lifecycle).
			var captureStructAddr int = regs[instr.Src1]
			var recPtr *uint8 = rt.Alloc(4 * REG_SLOT)
			var rec *int = bit_cast(*int, recPtr)
			rec[0] = rt.DATA_KIND_COMPILED_CLOSURE
			rec[1] = bit_cast(int, vm)
			rec[2] = idx + 1
			rec[3] = captureStructAddr
			fvAddr[types.FuncValueDataIndex()] = bit_cast(int, recPtr)
		}
		regs[instr.Dst] = fvAddrInt
		return true
	}
	if execIfaceOp(vm, f, regs, instr) { return true }
	return false
}

// ensureHandle lazy-populates callee.Vtable, callee.ClosureRec, and
// callee.Handle so BC_FUNC_HANDLE / BC_FUNC_VALUE can return stable
// references without per-call allocation.  All three fields are
// managed (refcounted) so VMFunc's auto-emitted dtor releases them
// on VMFunc death.  The vtable's call slot points at the universal
// trampoline whose native address is reachable from the executing
// vm's Externs registry.  TrampolineAggregate is picked when the
// callee returns a single multi-word value; the self-reference
// override handles the trampolines themselves so they don't recurse.
// Phase 4 of plan-uniform-native-fnptrs.md.
func ensureHandle(vm @VM, callee @VMFunc, idx int) {
	if callee.Vtable == nil {
		var trampolineName *[]readonly char = "pkg/binate/vm.TrampolineScalar"
		if len(callee.ResultMultiWord) == 1 &&
				callee.ResultMultiWord[0] {
			trampolineName = "pkg/binate/vm.TrampolineAggregate"
		}
		if streq(callee.Name, "pkg/binate/vm.TrampolineScalar") {
			trampolineName = "pkg/binate/vm.TrampolineScalar"
		}
		if streq(callee.Name, "pkg/binate/vm.TrampolineAggregate") {
			trampolineName = "pkg/binate/vm.TrampolineAggregate"
		}
		var tIdx int = vm.LookupExtern(trampolineName)
		if tIdx < 0 {
			vmPanicName("vm: ensureHandle: trampoline not registered: ", trampolineName)
		}
		var tVtable *int = bit_cast(*int,
			vm.Externs[tIdx].VtableAddr)
		var vt @VMFuncVtable = make(VMFuncVtable)
		vt.Dtor = 0
		if callee.IsClosure {
			// Capturing closure: all of this callee's func values carry
			// a heap COMPILED_CLOSURE record.  Mark the vtable dtor slot
			// with the sentinel so the value's RefDec-to-zero (which
			// targets the rec) releases the heap closure struct the rec
			// points at, instead of leaking it.  See
			// BC_REFDEC_INLINE_FAST in vm_exec.bn.
			vt.Dtor = compiledClosureDtorMark
		}
		vt.Call = tVtable[1]
		callee.Vtable = vt
	}
	if callee.ClosureRec == nil {
		var rec @VMClosureRec = make(VMClosureRec)
		rec.Kind = rt.DATA_KIND_VM_CLOSURE_REC
		rec.Vm = bit_cast(int, vm)
		rec.FnIdx = idx + 1
		rec.Captured = 0
		callee.ClosureRec = rec
	}
	if callee.Handle == nil {
		var h @VMFuncHandle = make(VMFuncHandle)
		h.VtableAddr = bit_cast(int, callee.Vtable)
		h.DataAddr = bit_cast(int, callee.ClosureRec)
		callee.Handle = h
	}
}

// dispatchNativeIndirect dispatches BC_CALL_INDIRECT against a native
// fn pointer.  After Phase 4 of plan-uniform-native-fnptrs.md, the
// only IR-magic callers reaching BC_CALL_INDIRECT are `_call_shim_scalar` /
// `_call_shim_aggregate` — both pass a native pointer (a per-function __shim
// address), never a vm idx, so the caller already knows it's a native call.
// Imm encodes the shim shape (8 = scalar / 7-arg, 9 = aggregate /
// retbuf-style); unknown shapes return false so the caller can diagnose.
func dispatchNativeIndirect(vm @VM, regs *int, instr BCInstr,
		fnIdx int) bool {
	var nativeFn *uint8 = bit_cast(*uint8, fnIdx)
	if instr.Imm == 8 {
		// rt._call_shim_scalar(fn, data, a0..a6) shape — the
		// always-shim convention from
		// plan-function-values-phase-3.md (Slice 3.1).  Dispatches
		// any compiled-side function value (and any registered
		// extern via dispatchExternBinding) to its per-function
		// shim.  When this path runs natively (e.g. from a bytecode
		// program executed by cmd/bni's native execLoop), the
		// rt._call_shim_scalar IR-magic call lowers to OP_CALL_INDIRECT
		// → real native indirect call to the shim.  When this same
		// dispatch runs as bytecode (a nested-VM scenario where
		// pkg/binate/vm itself is bytecode in the outer VM), the bytecode
		// rt._call_shim_scalar emits BC_CALL_INDIRECT against the
		// shim address, which re-enters this very arm — ultimately
		// the outer native execLoop runs the actual call.
		var data *uint8 = bit_cast(*uint8, regs[instr.Src2])
		var a0 int = regs[instr.Src2 + 1]
		var a1 int = regs[instr.Src2 + 2]
		var a2 int = regs[instr.Src2 + 3]
		var a3 int = regs[instr.Src2 + 4]
		var a4 int = regs[instr.Src2 + 5]
		var a5 int = regs[instr.Src2 + 6]
		var a6 int = regs[instr.Src2 + 7]
		if instr.Aux != 0 {
			// 64-bit scalar return: _call_shim_scalar64 shares the Imm==8
			// (8-arg) shape with _call_shim_scalar, so lower_call.bn flags it in
			// Aux instead.  Read the pair via the wide primitive + split.
			storeScalar64Result(regs, instr.Dst,
				rt._call_shim_scalar64(nativeFn, data,
					a0, a1, a2, a3, a4, a5, a6))
			return true
		}
		var result int = rt._call_shim_scalar(nativeFn, data,
			a0, a1, a2, a3, a4, a5, a6)
		if instr.Dst >= 0 {
			regs[instr.Dst] = result
		}
		return true
	}
	if instr.Imm == 9 {
		// rt._call_shim_aggregate(fn, retbuf, data, a0..a6) shape —
		// the retbuf-style aggregate counterpart.  Dispatches
		// aggregate-return function values (slices, managed-slices,
		// multi-word structs) through their retbuf-style shim.  The
		// caller (dispatchExternBinding's aggregate path, or compiled
		// emitCallFuncValue's aggregate branch) has already alloca'd
		// retbuf and writes the aggregate result there; the shim
		// returns void.  Same nested-bytecode soundness rationale as
		// the Imm==8 arm above.
		var retbuf *uint8 = bit_cast(*uint8, regs[instr.Src2])
		var data *uint8 = bit_cast(*uint8, regs[instr.Src2 + 1])
		var a0 int = regs[instr.Src2 + 2]
		var a1 int = regs[instr.Src2 + 3]
		var a2 int = regs[instr.Src2 + 4]
		var a3 int = regs[instr.Src2 + 5]
		var a4 int = regs[instr.Src2 + 6]
		var a5 int = regs[instr.Src2 + 7]
		var a6 int = regs[instr.Src2 + 8]
		rt._call_shim_aggregate(nativeFn, retbuf, data,
			a0, a1, a2, a3, a4, a5, a6)
		// instr.Dst is -1 for the void return; nothing to store.
		return true
	}
	return false
}

// dispatchCompiledFuncValue handles the cross-mode arm of
// BC_CALL_FUNC_VALUE: compiled-side function value (data == null)
// reached from bytecode. Reads vtable.call (the per-function shim,
// always-shim convention) and dispatches via the marshaling shim —
// its lowering in the natively-compiled VM is OP_CALL_INDIRECT
// against the native pointer. The fixed 7-int-arg shape mirrors
// vm.TrampolineScalar's variadic-style register-bank reading.
//
// A SCALAR (≤ word) return uses rt._call_shim_scalar and lands the
// result in regs[Dst].  An AGGREGATE (multi-word) return — a managed
// slice / raw slice / multi-word struct, as for a func value of a
// native-injected function like strconv.Itoa → @[]char — must use the
// retbuf-style rt._call_shim_aggregate instead (the scalar shim can
// only carry one word back), exactly like dispatchCompiledIfaceMethod.
// instr.Aux carries the result byte size (set by lowerCallOp); the
// aggregate path is taken when it exceeds the VM host's word size.
//
// fv points at the function value's two-word {vtable_addr,
// data_addr} struct on vm.Stack; data_addr is null on entry (the
// caller already branched on it). regs and instr are the
// bytecode call site's register bank and BCInstr.  vm supplies the
// stack for the aggregate retbuf.
func dispatchCompiledFuncValue(vm @VM, fv *int, regs *int, instr BCInstr) {
	var vtableAddr int = fv[types.FuncValueVtableIndex()]
	if vtableAddr == 0 {
		vmPanic("vm: function value has nil vtable")
	}
	var vtable *int = bit_cast(*int, vtableAddr)
	var callPtr int = vtable[1]
	if callPtr == 0 {
		vmPanic("vm: function value's vtable.call is nil")
	}
	var fnPtr *uint8 = bit_cast(*uint8, callPtr)
	var dataPtr *uint8 = nil
	var nArgs int = instr.Imm
	if nArgs > 7 {
		// The shim primitives carry 7 arg slots (a0..a6).  A wider call
		// can't be dispatched until they widen — fail loudly rather than
		// silently truncate, matching dispatchCompiledIfaceMethod's guard.
		vmPanic("vm: cross-mode func value has >7 arg slots (unsupported)")
	}
	var a0 int = 0
	var a1 int = 0
	var a2 int = 0
	var a3 int = 0
	var a4 int = 0
	var a5 int = 0
	var a6 int = 0
	if nArgs > 0 { a0 = regs[instr.Src2 + 0] }
	if nArgs > 1 { a1 = regs[instr.Src2 + 1] }
	if nArgs > 2 { a2 = regs[instr.Src2 + 2] }
	if nArgs > 3 { a3 = regs[instr.Src2 + 3] }
	if nArgs > 4 { a4 = regs[instr.Src2 + 4] }
	if nArgs > 5 { a5 = regs[instr.Src2 + 5] }
	if nArgs > 6 { a6 = regs[instr.Src2 + 6] }
	// instr.Aux packs the aggregate retbuf size (stamped at IR-gen via
	// types.AggregateReturnSize from the func value's result list) in its high
	// bits and the scalar64 flag in bit 0: retbufFieldBytes > 0 = the callee's
	// shim is retbuf-shaped; else retbufFieldScalar64 = a bare 64-bit scalar
	// return (register PAIR on ILP32); else a one-word scalar.  The aggregate
	// size mirrors codegen's isAggregateReturn exactly (multi-return, an
	// aggRetCoerced ≤16-byte named struct/array INCLUDING ≤8-byte, or an
	// aggregate-KIND > word) — deriving it from a raw SizeOf > 8 here was the
	// B1/C1 cross-mode-dispatch divergence.
	var retbufSize int = retbufFieldBytes(instr.Aux)
	if retbufSize > 0 {
		// Aggregate return: the shim writes the natural-typed result through
		// a retbuf (its first param).  retbufSize (types.AggregateReturnSize)
		// is rounded up to a whole number of 8-byte words -- a conservative
		// over-allocation shared by every backend and the VM regardless of
		// target word size -- so it is the true byte count to reserve on
		// vm.Stack.
		var retbuf *uint8 = bit_cast(*uint8,
			bit_cast(int, vm.Stack) + vm.SP)
		vm.SP = vm.SP + retbufSize
		rt._call_shim_aggregate(fnPtr, retbuf, dataPtr,
			a0, a1, a2, a3, a4, a5, a6)
		if instr.Dst >= 0 { regs[instr.Dst] = bit_cast(int, retbuf) }
		return
	}
	if retbufFieldScalar64(instr.Aux) {
		// 64-bit scalar return: the shim declares i64; read both words via the
		// wide primitive and split into the destination register pair (ILP32).
		storeScalar64Result(regs, instr.Dst,
			rt._call_shim_scalar64(fnPtr, dataPtr,
				a0, a1, a2, a3, a4, a5, a6))
		return
	}
	var result int = rt._call_shim_scalar(fnPtr, dataPtr,
		a0, a1, a2, a3, a4, a5, a6)
	if instr.Dst >= 0 {
		regs[instr.Dst] = result
	}
}

// execCallFuncValue handles a BC_CALL_FUNC_VALUE dispatch — a function-
// value call whose two-word {vtable_addr, data_addr} lives in
// regs[instr.Src1].  A COMPILED-side function value (no closure record)
// is dispatched inline through vtable.call and control continues at the
// current pc — returns (0, 0, false).  A VM-side function value pushes a
// new frame, copies its captures (COMPILED_CLOSURE) then the user args
// into the callee's leading regs, and returns (calleeFuncIdx,
// newRegsOff, true); the caller switches execLoop's control state to
// that frame (pc=0) and recomputes f/code/regs/frameBase from
// funcIdx/regsOff.  Extracted from execLoop for file length — it leaves
// execLoop's loop-local control state to the caller rather than mutating
// it, so it can live outside the dispatch loop.
func execCallFuncValue(vm @VM, instr BCInstr, pc int, funcIdx int,
		regsOff int, regs *int) (int, int, bool) {
	var fvAddr int = regs[instr.Src1]
	if fvAddr == 0 {
		println("vm: call through nil function value")
		rt.Exit(1)
	}
	var fv *int = bit_cast(*int, fvAddr)
	var closureRecAddr int = fv[types.FuncValueDataIndex()]
	if closureRecAddr == 0 {
		// Cross-mode: compiled-side function value with no closure
		// record.  Dispatch via vtable.call; no control-state change.
		dispatchCompiledFuncValue(vm, fv, regs, instr)
		return 0, 0, false
	}
	var closureRec *int = bit_cast(*int, closureRecAddr)
	var dataKind int = closureRec[0]
	if dataKind != rt.DATA_KIND_VM_CLOSURE_REC &&
		dataKind != rt.DATA_KIND_COMPILED_CLOSURE {
		vmPanicName("vm: unsupported function-value data kind: ", strconv.Itoa(dataKind))
	}
	// Closure rec layout (both VM_CLOSURE_REC and COMPILED_CLOSURE):
	// { kind, vm_handle, vm_func_idx, captured_ctx }.  For
	// VM_CLOSURE_REC, captured_ctx is 0 (Phase 1).  For
	// COMPILED_CLOSURE, captured_ctx is the address of the alloca'd
	// closure struct whose fields are copied into the callee's leading
	// regs below.
	var fnIdx int = closureRec[2]
	if fnIdx == 0 {
		vmPanic("vm: function value's vm_func_idx is 0")
	}
	var calleeFuncIdx int = fnIdx - 1
	if calleeFuncIdx < 0 || calleeFuncIdx >= len(vm.Funcs) {
		vmPanic("vm: function-value call: idx out of range")
	}
	var calleeFunc @VMFunc = vm.Funcs[calleeFuncIdx]
	var newRegsOff int = pushFrame(vm, calleeFunc,
		pc, funcIdx, regsOff, vm.SP, instr.Dst)
	var newRegs *int = stackPtr(vm, newRegsOff)
	// For COMPILED_CLOSURE, copy captures from the closure struct into
	// the leading regs before the user args.  CaptureOffsets gives the
	// byte offset of each capture inside the struct.
	var nCaps int = 0
	if dataKind == rt.DATA_KIND_COMPILED_CLOSURE {
		nCaps = calleeFunc.NumCaptureParams
		var captureStructAddr int = closureRec[3]
		for i := 0; i < nCaps; i++ {
			var ofs int = calleeFunc.CaptureOffsets[i]
			if calleeFunc.CaptureByPtr[i] {
				// Multi-word VM type (struct / slice / iface / func
				// value): pass the FIELD ADDRESS — VM convention reads
				// multi-word params through a pointer.
				newRegs[i] = captureStructAddr + ofs
			} else {
				var capPtr *int = bit_cast(*int,
					captureStructAddr + ofs)
				newRegs[i] = capPtr[0]
			}
		}
	}
	// Imm is the packed slot count of user args (Layer 2 step 2b);
	// bound against the callee's NumParamSlots.  User args land AFTER
	// the captures.
	for i := 0; i < instr.Imm &&
		nCaps + i < calleeFunc.NumParamSlots; i++ {
		newRegs[nCaps + i] = regs[instr.Src2 + i]
	}
	return calleeFuncIdx, newRegsOff, true
}
