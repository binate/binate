package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the func-ref / function-value bytecode dispatch in
// vm_exec_funcref.bn (execFuncRefOp + dispatchNativeIndirect +
// dispatchCompiledFuncValue). End-to-end coverage for func-ref
// construction is mostly through vm_test.bn / vm_extern_test.bn;
// this file pins the specifically-execFuncRefOp behavior that
// would silently regress if the dispatch arms moved out of sync
// with the BC_FUNC_VALUE / BC_FUNC_ADDR opcodes.

// TestBCFuncValueRegistryFallback exercises execFuncRefOp's
// LookupFunc-miss → vm.Externs fallback path.  The setup: a name
// that has no `.bn` body in this VM but IS registered in the
// extern registry.  Pre-fallback, BC_FUNC_VALUE would call
// rt.Exit(1) ("function not found").  With the fallback, it
// builds the function value from the binding's VtableAddr /
// DataAddr and returns normally.
//
// The test doesn't dispatch the resulting function value (that
// would require the binding to point at a real shim — out of
// scope for unit-test setup); it just verifies that
// construction succeeds and that main returns its trailing
// constant.  Returning normally proves the fallback fired,
// because pre-fix the LookupFunc miss would terminate the
// process before the return.
func TestBCFuncValueRegistryFallback() testing.TestResult {
	// Build: func main() int { var fv *func() = fake.RegistryOnly; return 99 }
	var noFnParams @[]@types.Param
	var noFnResults @[]@types.Type
	var fvTyp @types.Type = types.MakeFuncValueType(noFnParams, noFnResults)

	var m @ir.Module = ir.NewModule("\"test\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var fn @ir.Func = ir.NewFunc("", "main", noParams, results)
	var entry @ir.Block = ir.AddBlock(fn, "entry")

	// OP_FUNC_VALUE for a name with no .bn body in this VM.
	// Without the registry fallback, this triggers
	// "vm: function not found" + rt.Exit(1).
	entry.EmitFuncValue("fake.RegistryOnly", fvTyp)

	var c99 @ir.Instr = entry.EmitConstInt(99, types.TypInt())
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = c99
	entry.EmitReturn(retArgs)
	m.AddFunc(fn)

	var vm @VM = NewVM(1024 * 1024)
	// Register the name with sentinel addrs.  The fallback uses
	// these as the function value's vtable / data words; nothing
	// here calls through them, so any non-zero values are fine.
	// Values fit a 32-bit `int` (bit 31 clear) so the test compiles
	// for a 32-bit target, where Vt/Data are i32.
	var fv fakeFV
	fv.Vt = 0x0AFE0001
	fv.Data = 0x0AFE0002
	vm.RegisterExtern("fake.RegistryOnly", bit_cast(*uint8, &fv), 0, 0)

	vm.LowerModule(m)
	var idx int = vm.LookupFunc("test.main")
	if idx < 0 { return "test.main not found" }
	var noArgs @[]int
	var result int64 = execFunc(vm, idx, noArgs)
	if result != 99 {
		return "expected 99 — fallback path likely didn't fire"
	}
	return ""
}

// A call through a nil function value is a RECOVERABLE user fault (Plan 2): a nil
// @func is {vtable:0, data:0}, so data==0 routes to dispatchCompiledFuncValue, whose
// vtable==0 check raises the fault via setFault; the exec loop then unwinds to the
// host with Status = FAULTED + message rather than killing it.  VM-level counterpart
// to conformance 1092 — asserts the in-process VM state a CLI golden can't see.
func TestNilFuncValueCallRecovers() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func driver() int {\n")
	src = concatStr(src, "  var f @func() int = nil\n")
	src = concatStr(src, "  return f()\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var noArgs @[]int
	vm.CallFunc("test.driver", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "a call through a nil function value must recover with Status = FAULTED"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: call of nil function value") {
		return "the recovered nil-func-value fault must carry the call-of-nil message"
	}
	return ""
}
