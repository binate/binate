package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/builtins/rt"

// execFunc enters the VM for a function call. This is the entry
// point from compiled code (CallFunc, execExtern's rt.CallDtor arm).
// Pushes an initial frame and runs the iterative dispatch loop.
func execFunc(vm @VM, funcIdx int, args @[]int) int {
	var f @VMFunc = vm.Funcs[funcIdx]
	var savedSP int = vm.SP

	// Push frame: header + registers + allocas
	var regsOff int = pushFrame(vm, f, -1, -1, 0, 0, -1)

	// Copy arguments into parameter registers.  args is a flat slot
	// sequence (Layer 2 step 2b: caller packs 64-bit-scalar args as
	// 2 slots on a host whose word is < 8 bytes); NumParamSlots is
	// the matching callee slot count.  On a 64-bit host both equal
	// NumParams and this is unchanged.
	var regs *int = stackPtr(vm, regsOff)
	for i := 0; i < len(args) && i < f.NumParamSlots; i++ {
		regs[i] = args[i]
	}

	var result int = execLoop(vm, funcIdx, regsOff)

	// If result points into callee's stack region, copy it
	// to caller space before popping.
	var sbase int = bit_cast(int, vm.Stack)
	if result >= sbase + savedSP && result < sbase + vm.SP {
		var sz int = sbase + vm.SP - result
		if sz > 64 { sz = 64 }
		rt.MemCopy(bit_cast(*uint8, sbase + savedSP),
			bit_cast(*uint8, result), sz)
		result = sbase + savedSP
		savedSP = savedSP + sz
	}

	vm.SP = savedSP
	return result
}

// vmPollPoint consults the host's interrupt delegate at a poll point (a
// statement boundary or loop back-edge) and RECORDS any requested
// interrupt into vm.Status + the resume side-fields.  Called only when
// vm.PollEnabled — the nil-poll fast path skips it entirely, so v1
// (which installs no Poll) never reaches here.  Recording is all it
// does: actually acting on a non-Continue status (unwinding the frame
// to suspend, or running cleanup pads to break) is the suspend / break
// stages' job — see plan-repl-embeddable.md.  resumePC is the
// instruction the suspended frame should resume at.
func vmPollPoint(vm @VM, funcIdx int, resumePC int, regsOff int) {
	var req int = vm.Poll(vm)
	if req == POLL_SUSPEND {
		vm.Status = VM_STATUS_SUSPENDED
		vm.ResumeFuncIdx = funcIdx
		vm.ResumePC = resumePC
		vm.ResumeRegsOff = regsOff
	} else if req == POLL_BREAK {
		vm.Status = VM_STATUS_BROKE
	}
}

// execStringOp dispatches BC_LOAD_STR / BC_STRING_COPY_MS /
// BC_STRING_COPY_ARR. These don't touch execLoop's control-flow
// state (pc, funcIdx, frameBase) — they only read instr / f /
// regs and push managed-slice headers / array buffers onto vm.SP.
// Returns true if instr.Op was one of these and the dispatch was
// handled; false otherwise so execLoop falls through to the next
// arm.
func execStringOp(vm @VM, f @VMFunc, regs *int, instr BCInstr) bool {
	switch instr.Op {
	case BC_LOAD_STR:
		// Return a stable pointer directly to the i-th
		// managed-slice header inside f.Strings's backing
		// (which is alive for the lifetime of the VMFunc /
		// module). Previously we copied the header onto
		// vm.SP per call — that turned `for { f("foo") }`-
		// style loops into vm.Stack overflows at ~262K
		// iterations because pushManagedSlice never popped.
		//
		// f.Strings is a 4-word managed slice: {data, len,
		// refptr, backingLen}. The `data` field (first
		// word) points at an array of @[]char headers (32
		// bytes each). Hand-compute the offset because
		// Binate's `&slice[i]` is currently restricted to
		// slice-of-struct in genIndexPtr.
		var stringsField *int = bit_cast(*int, &f.Strings)
		var dataPtr int = stringsField[0]
		var hdrPtr int = dataPtr + instr.Imm * 32
		if instr.Aux == 1 {
			regs[instr.Dst] = hdrPtr
		} else {
			var p *int = bit_cast(*int, hdrPtr)
			regs[instr.Dst] = p[0]
		}
		return true
	case BC_STRING_COPY_MS:
		// Stage 2b: allocate a fresh managed-slice copy of the
		// literal. Refcount 1; independent of rodata.
		var str @[]char = f.Strings[instr.Imm]
		var strHdr int = pushManagedSlice(vm,
			bit_cast(*uint8, &str))
		var hdrP *int = bit_cast(*int, strHdr)
		var srcPtr int = hdrP[0]
		var strLen int = hdrP[1]
		var ms rt.ManagedSlice = rt.MakeManagedSlice(1, strLen)
		if strLen > 0 {
			rt.MemCopy(ms.Data,
				bit_cast(*uint8, srcPtr), strLen)
		}
		var msAddr *int = stackPtr(vm, vm.SP)
		vm.SP = vm.SP + 32
		msAddr[0] = bit_cast(int, ms.Data)
		msAddr[1] = ms.Len
		msAddr[2] = bit_cast(int, ms.Refptr)
		msAddr[3] = ms.BackingLen
		regs[instr.Dst] = bit_cast(int, msAddr)
		return true
	case BC_STRING_COPY_ARR:
		// Stage 2c Phase 1: copy a string literal into a fresh
		// stack buffer of size Aux, zero-padded. Returns pointer
		// to the buffer; OP_STORE memcpys it into the target alloca.
		var str @[]char = f.Strings[instr.Imm]
		var strHdr int = pushManagedSlice(vm,
			bit_cast(*uint8, &str))
		var hdrP *int = bit_cast(*int, strHdr)
		var srcPtr int = hdrP[0]
		var strLen int = hdrP[1]
		var arrLen int = instr.Aux
		var bufAddr int = bit_cast(int, vm.Stack) + vm.SP
		vm.SP = vm.SP + arrLen
		rt.MemZero(bit_cast(*uint8, bufAddr), arrLen)
		var copyLen int = strLen
		if copyLen > arrLen { copyLen = arrLen }
		if copyLen > 0 {
			rt.MemCopy(bit_cast(*uint8, bufAddr),
				bit_cast(*uint8, srcPtr), copyLen)
		}
		regs[instr.Dst] = bufAddr
		return true
	}
	return false
}


// narrowToWidth reduces v to a `bits`-wide integer held in a host word:
// sign-extends (signed) or zero-extends (unsigned) source bit (bits-1)
// through the upper bits.  A `bits` at or above the host word leaves v
// unchanged (and dodges a full-word shift, which is UB).  This is the
// one primitive behind BC_SEXT / BC_ZEXT and the post-arith sub-word
// narrow in execArithOp.
func narrowToWidth(v int, bits int, signed bool) int {
	var hw int = REG_SLOT * 8
	if bits >= hw { return v }
	if signed {
		var shift int = hw - bits
		return (v << shift) >> shift
	}
	var mask int = (cast(int, 1) << bits) - 1
	return v & mask
}

// execNumericCast dispatches the numeric narrowing / int-float casts
// (BC_TRUNC8, BC_SITOF, BC_FTOSI, BC_F32TOSI, BC_F64_TO_F32,
// BC_F32_TO_F64). Pure register-to-register; no side effects.
//
// Float64 bits ride through int64 (not host-int) so the bit_cast is
// always 64↔64 — portable across hosts whose word is smaller than 8
// bytes, where `bit_cast(int, float64)` would be a size mismatch.  On
// a 64-bit host the cast(int, int64) / cast(int64, int) hops are
// identities.  On a 32-bit host these handlers are dead path (lowering
// will emit pair-aware variants once float64-on-32-bit lowering lands)
// — they only need to compile cleanly.
func execNumericCast(regs *int, instr BCInstr) bool {
	switch instr.Op {
	case BC_TRUNC8: regs[instr.Dst] = regs[instr.Src1] & 255; return true
	case BC_TRUNC32:
		// Mask to low 32 bits.  Cast through uint32: on a 32-bit host
		// this is identity (host word == uint32); on a 64-bit host it
		// drops the upper 32 bits then zero-extends back to int.
		regs[instr.Dst] = cast(int, cast(uint32, regs[instr.Src1]))
		return true
	case BC_SEXT:
		regs[instr.Dst] = narrowToWidth(regs[instr.Src1], instr.Imm, true)
		return true
	case BC_ZEXT:
		regs[instr.Dst] = narrowToWidth(regs[instr.Src1], instr.Imm, false)
		return true
	case BC_SITOF:
		// int → float64.  On a 32-bit host the float64 result
		// occupies a register pair (Src1 stays a single int slot —
		// the source is host-int, not int64-on-32-bit).
		var i int = regs[instr.Src1]
		var bits int64 = bit_cast(int64, cast(float64, i))
		if REG_SLOT < 8 {
			var lo int
			var hi int
			lo, hi = splitInt64(bits)
			regs[instr.Dst] = lo
			regs[instr.Dst + 1] = hi
		} else {
			regs[instr.Dst] = cast(int, bits)
		}
		return true
	case BC_UITOF:
		// unsigned int → float64.  Reinterpret the host-int register
		// bits as uint64 before converting, so a value with the high bit
		// set yields a large positive double — not the negative one the
		// signed BC_SITOF would.  (uint32 and narrower are zero-extended,
		// so they already agree with BC_SITOF; this only changes the
		// uint64/uint high-bit-set case.)
		var u uint64 = cast(uint64, regs[instr.Src1])
		var ubits int64 = bit_cast(int64, cast(float64, u))
		if REG_SLOT < 8 {
			var ulo int
			var uhi int
			ulo, uhi = splitInt64(ubits)
			regs[instr.Dst] = ulo
			regs[instr.Dst + 1] = uhi
		} else {
			regs[instr.Dst] = cast(int, ubits)
		}
		return true
	case BC_FTOSI:
		// float64 → int.  On a 32-bit host the float64 source
		// occupies a register pair (low at Src1, high at Src1+1);
		// the int result stays a single host-int slot.
		var fbits int64
		if REG_SLOT < 8 {
			fbits = joinInt64(regs[instr.Src1], regs[instr.Src1 + 1])
		} else {
			fbits = cast(int64, regs[instr.Src1])
		}
		var f float64 = bit_cast(float64, fbits)
		regs[instr.Dst] = cast(int, f)
		return true
	case BC_F32TOSI:
		// float32 → int.  float32 fits a single slot on any host;
		// no pair handling needed.
		var u32 uint32 = cast(uint32, regs[instr.Src1])
		var f32 float32 = bit_cast(float32, u32)
		regs[instr.Dst] = cast(int, f32)
		return true
	case BC_F64_TO_F32:
		// float64 → float32.  Source is pair on a 32-bit host;
		// destination is a single slot (float32 always fits one).
		var f64bits int64
		if REG_SLOT < 8 {
			f64bits = joinInt64(regs[instr.Src1], regs[instr.Src1 + 1])
		} else {
			f64bits = cast(int64, regs[instr.Src1])
		}
		var f64 float64 = bit_cast(float64, f64bits)
		var f32 float32 = cast(float32, f64)
		var u32 uint32 = bit_cast(uint32, f32)
		regs[instr.Dst] = cast(int, u32)
		return true
	case BC_F32_TO_F64:
		// float32 → float64.  Source is a single slot; destination
		// is a pair on a 32-bit host.
		var u32 uint32 = cast(uint32, regs[instr.Src1])
		var f32 float32 = bit_cast(float32, u32)
		var f64 float64 = cast(float64, f32)
		var f64bits int64 = bit_cast(int64, f64)
		if REG_SLOT < 8 {
			var lo int
			var hi int
			lo, hi = splitInt64(f64bits)
			regs[instr.Dst] = lo
			regs[instr.Dst + 1] = hi
		} else {
			regs[instr.Dst] = cast(int, f64bits)
		}
		return true
	}
	return false
}

// execManagedMemoryOp dispatches the managed-memory bytecodes that
// don't update execLoop's control flow: BC_REFINC_INLINE, BC_ALLOC,
// BC_BOX, BC_NIL_CHECK, BC_BOUNDS_CHECK, BC_MAKE_SLICE. Each reads
// regs / instr, may push 32 bytes onto vm.SP (BC_MAKE_SLICE) or
// fail loudly on a runtime check; none of them push or pop a frame.
// Returns true if instr.Op was one of these and was handled; false
// otherwise so execLoop falls through. Mirrors execStringOp /
// execFuncRefOp in shape.
//
// BC_REFDEC_INLINE_FAST is NOT covered here: its slow path pushes a
// dtor frame on the VM stack and updates execLoop's funcIdx / pc /
// frameBase, so it can't be hoisted without invasive in/out-pointer
// plumbing. It stays inline in execLoop.
func execManagedMemoryOp(vm @VM, regs *int, instr BCInstr) bool {
	switch instr.Op {
	case BC_REFINC_INLINE:
		var ptr *uint8 = bit_cast(*uint8, regs[instr.Src1])
		if ptr == nil { return true }
		var hd *int = bit_cast(*int,
			bit_cast(int, ptr) - MANAGED_HDR)
		if hd[0] < 0 { return true }  // immortal static-managed data
		hd[0] = hd[0] + 1
		return true
	case BC_ALLOC:
		regs[instr.Dst] = bit_cast(int,
			rt.Alloc(instr.Imm))
		return true
	case BC_BOX:
		regs[instr.Dst] = bit_cast(int,
			rt.Box(bit_cast(*uint8, regs[instr.Src1]),
				instr.Imm))
		return true
	case BC_NIL_CHECK:
		if regs[instr.Src1] == 0 {
			println("vm: nil pointer dereference")
			rt.Exit(1)
		}
		return true
	case BC_BOUNDS_CHECK:
		rt.BoundsCheck(regs[instr.Src1], regs[instr.Src2])
		return true
	case BC_DIV_CHECK:
		// Imm = operand bit width, Aux = isSigned; recover the type's
		// signed MIN (only consulted for the signed overflow case).
		var dcMin int64 = cast(int64, 0)
		if instr.Aux != 0 {
			dcMin = types.SignedMinForWidth(instr.Imm)
		}
		rt.DivCheck(cast(int64, regs[instr.Src1]),
			cast(int64, regs[instr.Src2]), dcMin, instr.Aux)
		return true
	case BC_MAKE_SLICE:
		var ms rt.ManagedSlice = rt.MakeManagedSlice(instr.Imm, regs[instr.Src1])
		var msAddr *int = stackPtr(vm, vm.SP)
		vm.SP = vm.SP + 32
		msAddr[0] = bit_cast(int, ms.Data)
		msAddr[1] = ms.Len
		msAddr[2] = bit_cast(int, ms.Refptr)
		msAddr[3] = ms.BackingLen
		regs[instr.Dst] = bit_cast(int, msAddr)
		return true
	}
	return false
}

// execMemoryOp dispatches the per-instruction memory ops:
// BC_STACK_ALLOC, BC_LOAD64, BC_STORE64, BC_LOAD8, BC_STORE8,
// BC_MEMCPY, BC_MEMSET, BC_FIELD_PTR, BC_ELEM_PTR, BC_EXTRACT.
// All non-control-flow: just touch regs and addresses (BC_STACK_ALLOC
// also reads frameBase). Returns true if instr.Op was one of these.
func execMemoryOp(regs *int, frameBase *uint8, instr BCInstr) bool {
	switch instr.Op {
	case BC_STACK_ALLOC:
		regs[instr.Dst] = bit_cast(int, frameBase) + instr.Imm
		return true
	case BC_LOAD64:
		var p *int = bit_cast(*int, regs[instr.Src1])
		regs[instr.Dst] = p[0]
		return true
	case BC_STORE64:
		var p *int = bit_cast(*int, regs[instr.Src1])
		p[0] = regs[instr.Src2]
		return true
	case BC_LOAD8:
		var p *uint8 = bit_cast(*uint8, regs[instr.Src1])
		var nbytes int = instr.Imm
		if nbytes < 1 { nbytes = 1 }
		var val int = 0
		for i := nbytes - 1; i >= 0; i-- { val = (val << 8) | cast(int, p[i]) }
		// Aux == 1: sign-extend the byte payload (lowerLoad sets
		// this for signed sub-word loads).  Width 64 doesn't go
		// through BC_LOAD8 so we never need to fold the no-op
		// case in here.
		if instr.Aux == 1 && nbytes < 8 {
			var bits int = nbytes * 8
			var signBit int = 1 << (bits - 1)
			if (val & signBit) != 0 {
				val = val | (((1 << bits) - 1) ^ -1)
			}
		}
		regs[instr.Dst] = val
		return true
	case BC_STORE8:
		var p *uint8 = bit_cast(*uint8, regs[instr.Src1])
		if instr.Imm <= 1 { p[0] = cast(uint8, regs[instr.Src2]) } else {
			var val int = regs[instr.Src2]
			for i := 0; i < instr.Imm; i++ { p[i] = cast(uint8, val & 255); val = val >> 8 }
		}
		return true
	case BC_MEMCPY:
		rt.MemCopy(bit_cast(*uint8, regs[instr.Src1]),
			bit_cast(*uint8, regs[instr.Src2]),
			instr.Imm)
		return true
	case BC_MEMSET:
		rt.MemZero(bit_cast(*uint8, regs[instr.Src1]),
			instr.Imm)
		return true
	case BC_FIELD_PTR:
		regs[instr.Dst] = regs[instr.Src1] + instr.Imm
		return true
	case BC_ELEM_PTR:
		regs[instr.Dst] = regs[instr.Src1] +
			regs[instr.Src2] * instr.Imm
		return true
	case BC_EXTRACT:
		// Imm = byte offset (or word index in legacy mode)
		// Aux = 0: load 1 word at offset
		// Aux = 1: return pointer (offset arithmetic only)
		// Aux = 2: legacy word-indexed load (Imm * 8)
		if instr.Aux == 1 {
			regs[instr.Dst] = regs[instr.Src1] +
				instr.Imm
		} else if instr.Aux == 2 {
			var p *int = bit_cast(*int,
				regs[instr.Src1])
			regs[instr.Dst] = p[instr.Imm]
		} else {
			var p *int = bit_cast(*int,
				regs[instr.Src1] + instr.Imm)
			regs[instr.Dst] = p[0]
		}
		return true
	}
	return false
}

// refDecCrossModeDispatch handles BC_REFDEC_INLINE_FAST's cross-mode
// arm: the dtor handle's data slot is null (compiled-side dtor with
// no captured ctx) or carries a kind discriminator we can't short-
// circuit (e.g. a future DATA_KIND_COMPILED_CLOSURE).  Load
// handle.vtable.call (the per-function shim, always-shim convention)
// and dispatch via rt._call_shim_scalar; then rt.Free(ptr) to complete
// the destroy.  Takes a host frame, but can't recurse back into the
// bytecode VM, so depth is bounded by the cross-mode call chain
// rather than the dtor's field graph.  Phase 4 of
// plan-uniform-native-fnptrs.md.  Split out of execLoop so the
// surrounding `if instr.Op == BC_REFDEC_INLINE_FAST` block stays
// short — the iterative VMClosureRec arm has to live inline because
// it mutates the loop's frame locals.
func refDecCrossModeDispatch(vtableAddr int, dataAddr int, ptr *uint8) {
	if vtableAddr == 0 {
		println("vm: BC_REFDEC dtor handle has nil vtable")
		rt.Exit(1)
	}
	var vtable *int = bit_cast(*int, vtableAddr)
	var shimPtr *uint8 = bit_cast(*uint8, vtable[1])
	if shimPtr == nil {
		println("vm: BC_REFDEC dtor vtable.call is nil")
		rt.Exit(1)
	}
	var dataPtr *uint8 = bit_cast(*uint8, dataAddr)
	rt._call_shim_scalar(shimPtr, dataPtr,
		bit_cast(int, ptr), 0, 0, 0, 0, 0, 0)
	rt.Free(ptr)
}
