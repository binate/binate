package "pkg/binate/vm"

import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/std/strings"

// ifaceVtIsNative reports whether an interface value's vtable word (iv[1])
// is a NATIVE @__ivt pointer rather than a 1-based index into
// vm.IfaceVtables.  An interface returned by an injected COMPILED package
// (e.g. an @errors.Error from pkg/std/os) carries the compiled vtable's
// address there; a VM-built iface carries a 1-based index.  Legal VM
// indices are exactly [1, len(IfaceVtables)] (0 is the nil sentinel,
// handled before this is reached), so anything outside that range is a
// native vtable address.  Using the RANGE (not a magnitude floor) makes it
// exact — it can't false-positive on a low-mapped native vtable.  Both
// representations share the {data, vtable_word} layout and diverge only in
// what vtable_word holds, so the discrimination is per-VALUE: one iface
// site can legitimately see both a VM-index iv and a native-pointer iv.
func ifaceVtIsNative(vm @VM, vtIdxPlus int) bool {
	return vtIdxPlus < 1 || vtIdxPlus > len(vm.IfaceVtables)
}

// dispatchCompiledIfaceMethod calls an interface method whose vtable is a
// NATIVE @__ivt pointer (the iface value came from an injected COMPILED package,
// or a bytecode BC_IFACE_VALUE over a native-only package's struct — see
// ifaceVtIsNative).  It does NOT call the raw @__ivt method fn directly: an
// arg/return marshaling that matches the native ABI (floats→FP regs, ≤16-byte
// aggregates by value, >16-byte by pointer, stack overflow) is exactly the work
// the per-function SHIM already does correctly, so replicating it here from byte
// sizes is unsound (it would miscompile floats, HFAs, and 32-bit targets).
// Instead it resolves the PARALLEL shim vtable (registered raw-@__ivt-addr →
// @__ivtshim-addr by RegisterPackageVtables), reads the method's function-value
// HANDLE from slot, and dispatches through the handle's marshaling shim — the
// same retbuf-style convention dispatchExternBinding uses.  The shim takes the
// receiver as its first arg (a0); user args ride a1.. as the by-address slots
// the bytecode already packs.  Writes regs[instr.Dst] in place; the caller
// `continue`s (no VM frame is pushed).
func dispatchCompiledIfaceMethod(vm @VM, regs *int, instr BCInstr, iv *int) {
	var shimVtAddr int = lookupShimVtable(vm, iv[types.IfaceValueVtableIndex()])
	if shimVtAddr == 0 {
		// The iface value carries a native @__ivt with no registered shim
		// vtable — RegisterPackageVtables should have bound both for every
		// injected native-only package.  Fail loudly rather than mis-dispatch.
		vmPanic("vm: no shim vtable for native interface method dispatch")
	}
	var shimVt *int = bit_cast(*int, shimVtAddr)
	var slot int = instr.Aux & 65535
	// High bits = the aggregate retbuf size (stamped at IR-gen via
	// types.AggregateReturnSize from the method's full result list): nonzero =
	// retbuf-shaped shim, 0 = scalar.  Mirrors codegen's isAggregateReturn.
	var retbufSize int = (instr.Aux >> 16) & 65535
	// Slot holds the method's @__handle ({vtable, data}); the marshaling shim is
	// vtable.call, exactly as a function-value / extern dispatch reads it.
	var handle *int = bit_cast(*int, shimVt[slot])
	if bit_cast(int, handle) == 0 {
		// A null shim slot means the impl-vtable slot collector couldn't resolve the impl
		// method locally (its func isn't in the defining package's TU), so no
		// @__handle was emitted.  The descriptor lists only fully-local impls
		// today, so this is unreachable — but diagnose rather than deref null.
		vmPanic("vm: compiled iface method slot has no shim handle")
	}
	var vtable *int = bit_cast(*int, handle[types.FuncValueVtableIndex()])
	var fnPtr *uint8 = bit_cast(*uint8, vtable[1])
	var dataPtr *uint8 = bit_cast(*uint8, handle[types.FuncValueDataIndex()])
	var n int = instr.Imm
	if n > 6 {
		// The shim primitives carry 7 arg slots (a0..a6); the receiver takes
		// a0, leaving 6 for user args.  A wider method can't be dispatched
		// until the primitives widen — fail loudly rather than drop args.
		vmPanic("vm: compiled iface method has >6 user arg slots (unsupported)")
	}
	// a0 = receiver (the iv data ptr); a1.. = user args (1 by-address slot each;
	// the shim marshals each to the native ABI).
	var a0 int = iv[types.IfaceValueDataIndex()]
	var a1 int = 0
	var a2 int = 0
	var a3 int = 0
	var a4 int = 0
	var a5 int = 0
	var a6 int = 0
	if n > 0 { a1 = regs[instr.Src2 + 0] }
	if n > 1 { a2 = regs[instr.Src2 + 1] }
	if n > 2 { a3 = regs[instr.Src2 + 2] }
	if n > 3 { a4 = regs[instr.Src2 + 3] }
	if n > 4 { a5 = regs[instr.Src2 + 4] }
	if n > 5 { a6 = regs[instr.Src2 + 5] }
	if retbufSize > 0 {
		// Aggregate return: the shim writes the natural-typed result through
		// a retbuf (its first param).  retbufSize (types.AggregateReturnSize)
		// is rounded up to a whole number of 8-byte words -- a conservative
		// over-allocation shared by every backend and the VM regardless of
		// target word size -- so it is the true byte count to reserve on
		// vm.Stack.
		var retbuf *uint8 = bit_cast(*uint8,
			bit_cast(int, vm.Stack) + vm.SP)
		vm.SP = vm.SP + retbufSize
		rt._call_shim_aggregate(fnPtr, retbuf, dataPtr,
			a0, a1, a2, a3, a4, a5, a6)
		if instr.Dst >= 0 { regs[instr.Dst] = bit_cast(int, retbuf) }
		return
	}
	var result int = rt._call_shim_scalar(fnPtr, dataPtr,
		a0, a1, a2, a3, a4, a5, a6)
	if instr.Dst >= 0 { regs[instr.Dst] = result }
}

// execIfaceOp dispatches the interface-value bytecode ops:
// BC_IFACE_VALUE (constructs a two-word {data, vtable_idx_plus_1} on
// the VM stack) and BC_IFACE_DTOR (extracts vtable slot 0 — the
// receiver type's dtor as a 1-based VM func index — for use as
// BC_REFDEC_INLINE_FAST's Src2 dtor argument). Split out of
// execFuncRefOp / vm_exec_helpers.bn alongside Slice 2.5b so that
// file stays close to its soft length limit.
//
// iv[1] is 1-based: storing `vtIdx + 1` lets a zero-initialized iv
// (e.g. `var iv *I` no-init) carry iv[1] == 0 as a "nil interface"
// sentinel. BC_CALL_IFACE_METHOD / BC_IFACE_DTOR detect it and
// panic, matching the deterministic-SEGV behavior the compiled
// path gets from a null vtable load.
func execIfaceOp(vm @VM, f @VMFunc, regs *int, instr BCInstr) bool {
	if instr.Op == BC_IFACE_VALUE {
		// Slice 2.3c of plan-interface-syntax-revision.md.
		// Aux = name index for the mangled vtable identifier
		// (`__ivt.<...>`); Src1 = data ptr register; Dst =
		// result register (will hold the iv stack-slot addr).
		//
		// Note: doesn't share f.CallCache. eagerFillCallCache
		// resolves every entry as a function name — for the
		// vtable name that's a miss (-1), and a cached -1 would
		// look indistinguishable from "not found" at lookup
		// time. Linear scan over vm.IfaceVtables instead;
		// vtable count is small. (TODO: per-call-site cache if
		// it becomes hot.)
		var vtIdx int = findIfaceVtable(vm, f.Names[instr.Aux])
		if vtIdx < 0 {
			// Not in vm.IfaceVtables — which is expected when the receiver's
			// package is native-only (its impls were never lowered).  Fall back
			// to the injected native-vtable registry (RegisterPackageVtables): a
			// hit stores the raw `@__ivt` address, which ifaceVtIsNative routes
			// to dispatchCompiledIfaceMethod / the native dtor path — the same
			// way an iface value returned BY native code is dispatched.
			var natAddr int = lookupVtableAddr(vm, f.Names[instr.Aux])
			if natAddr != 0 {
				var natIv *int = stackPtr(vm, vm.SP)
				var natIvInt int = bit_cast(int, vm.Stack) + vm.SP
				vm.SP = vm.SP + 2 * REG_SLOT
				// natIv = {data ptr, native @__ivt addr}; the native vtable
				// address makes ifaceVtIsNative true for this iface value.
				natIv[types.IfaceValueDataIndex()] = regs[instr.Src1]
				natIv[types.IfaceValueVtableIndex()] = natAddr
				regs[instr.Dst] = natIvInt
				return true
			}
			vmPanicName("vm: interface vtable not found: ", f.Names[instr.Aux])
		}
		var ivAddr *int = stackPtr(vm, vm.SP)
		var ivAddrInt int = bit_cast(int, vm.Stack) + vm.SP
		vm.SP = vm.SP + 2 * REG_SLOT
		ivAddr[types.IfaceValueDataIndex()] = regs[instr.Src1]   // data ptr
		ivAddr[types.IfaceValueVtableIndex()] = vtIdx + 1          // vtable index (1-based; 0 = nil)
		regs[instr.Dst] = ivAddrInt
		return true
	}
	if instr.Op == BC_IFACE_DTOR {
		// Slice 2.5b of plan-interface-syntax-revision.md.
		// Src1 = register holding the iv stack-slot addr; Dst
		// gets vt.Methods[0] (the dtor as a 1-based VM func
		// index, or 0 if the receiver has no dtor). Feeds
		// directly into BC_REFDEC_INLINE_FAST's Src2 slot.
		var ivAddr int = regs[instr.Src1]
		if ivAddr == 0 {
			vmPanic("vm: iface_dtor on nil interface value")
		}
		var iv *int = bit_cast(*int, ivAddr)
		var vtIdxPlus int = iv[types.IfaceValueVtableIndex()]
		if vtIdxPlus == 0 {
			// Nil iv (zero-initialized via no-init `var iv @I`).
			// The dtor extraction is on the scope-exit cleanup
			// path; for a nil iv there's nothing to clean up.
			// Returning a 0 dtor index lets BC_REFDEC_INLINE_FAST
			// skip dispatch (its Src2 == 0 means "no dtor").
			regs[instr.Dst] = 0
			return true
		}
		if ifaceVtIsNative(vm, vtIdxPlus) {
			// The iface value came from an injected COMPILED package
			// (e.g. an @errors.Error returned by pkg/std/os): iv[1] is a
			// native @__ivt pointer, not a 1-based vm.IfaceVtables index.
			// Slot 0 of that native vtable is the receiver-dtor's
			// %BnFuncValue HANDLE pointer (or null for a no-managed-field
			// receiver) — exactly the form BC_REFDEC_INLINE_FAST's
			// cross-mode arm (refDecCrossModeDispatch) consumes — so hand it
			// straight through.  natVt[0] == 0 yields the no-dtor 0.
			var natVt *int = bit_cast(*int, vtIdxPlus)
			regs[instr.Dst] = natVt[0]
			return true
		}
		var vtIdx int = vtIdxPlus - 1
		if vtIdx < 0 || vtIdx >= len(vm.IfaceVtables) {
			vmPanic("vm: iface_dtor: vtable index out of range")
		}
		var vt @IfaceVtable = vm.IfaceVtables[vtIdx]
		// vt.Methods[0] is the receiver dtor's 1-based VM func index (0 =
		// the receiver has no dtor).  BC_REFDEC_INLINE_FAST consumes its
		// dtor slot (Src2) as a func-value HANDLE — it derefs handlePtr[1]
		// to find a VM_CLOSURE_REC and iterative-pushes rec's FnIdx — not
		// as a raw func index, which it would bit_cast to a pointer and
		// crash on.  So hand it the dtor func's handle (the same
		// VMFuncHandle the @func dtor path uses): ensureHandle builds the
		// {Vtable, ClosureRec{Kind=VM_CLOSURE_REC, FnIdx}} that arm
		// expects, and the iterative push then runs the receiver dtor with
		// the receiver pointer as its argument and frees it via freeOnPop.
		// Without this, an interface value that is the last holder of a
		// managed-field receiver crashes the VM when it RefDec's to zero
		// (520_iface_dtor_callee_sole_ref / 554 / 556).
		var dtorFuncIdx int = vt.Methods[0]
		if dtorFuncIdx == 0 {
			regs[instr.Dst] = 0
			return true
		}
		var dtorFunc @VMFunc = vm.Funcs[dtorFuncIdx - 1]
		ensureHandle(vm, dtorFunc, dtorFuncIdx - 1)
		regs[instr.Dst] = bit_cast(int, dtorFunc.Handle)
		return true
	}
	if instr.Op == BC_FUNC_VALUE_DTOR {
		// Mirror of BC_IFACE_DTOR for @func values.  fv layout is
		// {vtable_addr (slot 0), data_addr (slot 1)} so the dtor
		// lives at vtable[0]; iv layout swaps those roles, hence
		// the structurally identical code with a different slot.
		//
		// Two nil cases, with the same split as BC_IFACE_DTOR:
		//   * fvAddr == 0 (the SSA register holds 0 instead of a
		//     stack-slot address) is an IR-gen bug — fatal.
		//   * vtable_addr == 0 (the fv struct's slot 0 is zero,
		//     i.e. the fv was zero-initialized via no-init
		//     `var f @func()`) is the normal zero-init case —
		//     return 0 so BC_REFDEC_INLINE_FAST skips dispatch.
		var fvAddr int = regs[instr.Src1]
		if fvAddr == 0 {
			vmPanic("vm: func_value_dtor on nil fv address")
		}
		var fv *int = bit_cast(*int, fvAddr)
		var vtableAddr int = fv[types.FuncValueVtableIndex()]
		if vtableAddr == 0 {
			regs[instr.Dst] = 0
			return true
		}
		var vtable *int = bit_cast(*int, vtableAddr)
		regs[instr.Dst] = vtable[0]
		return true
	}
	if instr.Op == BC_IFACE_UPCAST {
		// Slice E.4 part 2b of plan-interface-embedding.md.
		// Read source iv, swap the iface portion of its vtable
		// name to the target's, and build a fresh iv with the
		// same data ptr and the target's vtable index.
		var srcAddr int = regs[instr.Src1]
		if srcAddr == 0 {
			vmPanic("vm: iface_upcast on nil interface value")
		}
		var srcIv *int = bit_cast(*int, srcAddr)
		var srcData int = srcIv[types.IfaceValueDataIndex()]
		var srcVtIdxPlus int = srcIv[types.IfaceValueVtableIndex()]
		if srcVtIdxPlus == 0 {
			// Nil source iv — propagate as nil into the new iv.
			var ivAddr *int = stackPtr(vm, vm.SP)
			var ivAddrInt int = bit_cast(int, vm.Stack) + vm.SP
			vm.SP = vm.SP + 2 * REG_SLOT
			ivAddr[types.IfaceValueDataIndex()] = 0
			ivAddr[types.IfaceValueVtableIndex()] = 0
			regs[instr.Dst] = ivAddrInt
			return true
		}
		if ifaceVtIsNative(vm, srcVtIdxPlus) {
			// The source iface value came from an injected COMPILED package
			// (its vtable word is the native @__ivt address, not a 1-based
			// vm.IfaceVtables index — see ifaceVtIsNative).  Mirror the
			// LLVM/native OP_IFACE_UPCAST lowering (emit_iface_upcast.bn): the
			// target ancestor's sub-vtable begins `offset` slots into the
			// source's concat-laid-out native vtable, so advance the vtable
			// WORD by offset*8 bytes (data unchanged) and keep it native.  The
			// 8 is the LP64 VM-host pointer size, the same assumption
			// dispatchCompiledIfaceMethod makes.  offset (IfaceParentSlotOffset,
			// baked into Imm at lower time) is 0 for upcast-to-`any` and the
			// managed<->raw decay (the vtable passes through unchanged); a
			// real-parent upcast (offset>0) advances the word to the parent
			// sub-block, so it points INTERIOR to the registered base @__ivt.  A
			// later method dispatch on the RESULT range-resolves that interior
			// word to the parent's shim sub-block (lookupShimVtable bounds each
			// vtable by its registered slot count) — reachable whenever an
			// embedder injects a native package whose interface extends another.
			var offset int = instr.Imm
			if offset < 0 {
				// IfaceParentSlotOffset returns -1 only when target is not an
				// ancestor of source — an invalid upcast the checker rejects.
				// Abort rather than walk the vtable pointer before its base.
				vmPanic("vm: iface_upcast: negative slot offset (target not an ancestor of source)")
			}
			var natIv *int = stackPtr(vm, vm.SP)
			var natIvInt int = bit_cast(int, vm.Stack) + vm.SP
			vm.SP = vm.SP + 2 * REG_SLOT
			natIv[types.IfaceValueDataIndex()] = srcData
			// offset advances the NATIVE @__ivt pointer by `offset`
			// vtable slots; a slot is one pointer, so scale by the
			// target pointer size (a hardcoded 8 was LP64-only and
			// double-stepped on a 32-bit host).
			natIv[types.IfaceValueVtableIndex()] =
				srcVtIdxPlus + offset * types.GetTarget().PointerSize
			regs[instr.Dst] = natIvInt
			return true
		}
		var srcVtIdx int = srcVtIdxPlus - 1
		if srcVtIdx < 0 || srcVtIdx >= len(vm.IfaceVtables) {
			vmPanic("vm: iface_upcast: source vtable index out of range")
		}
		// Plan §6 iv→universe-`any`: encoded target suffix is
		// `__any` (empty pkg + name "any"); the upcast reuses the
		// source's vtable wholesale (offset-0 layout match between
		// any's `[2 x i8*]` view and the source's any-block).  Skip
		// the name swap + lookup — those would fail because no
		// `__ivt.<...>__any` global is registered on the VM side
		// for iv-source upcasts.
		var tgtVtPlus int = 0
		if iface_upcastTargetIsAny(f.Names[instr.Aux]) {
			tgtVtPlus = srcVtIdxPlus
		} else {
			var srcName @[]char = vm.IfaceVtables[srcVtIdx].Name
			var tgtName @[]readonly char = swapIfaceSuffix(srcName,
				f.Names[instr.Aux])
			if len(tgtName) == 0 {
				vmPanicName("vm: iface_upcast: cannot compute target vtable for ", srcName)
			}
			var tgtVtIdx int = findIfaceVtable(vm, tgtName)
			if tgtVtIdx < 0 {
				vmPanicName("vm: iface_upcast: target vtable not found: ", tgtName)
			}
			tgtVtPlus = tgtVtIdx + 1
		}
		var ivAddr *int = stackPtr(vm, vm.SP)
		var ivAddrInt int = bit_cast(int, vm.Stack) + vm.SP
		vm.SP = vm.SP + 2 * REG_SLOT
		ivAddr[types.IfaceValueDataIndex()] = srcData
		ivAddr[types.IfaceValueVtableIndex()] = tgtVtPlus
		regs[instr.Dst] = ivAddrInt
		return true
	}
	return false
}

// swapIfaceSuffix rewrites an interface-impl vtable name by replacing its
// SOURCE interface with the TARGET (an iface-value upcast `@Src -> @Tgt`).
// `srcName` is a full vtable name (the `__ivt.`/`__ivtshim.` decoration on
// a bn_V/bn_W core, e.g. `__ivt.bn_V<recvPkg><recvType><ifacePkg><iface>`);
// `suffixes` is the lower-time-encoded `<srcPkgPath>.<srcName>|<tgtPkgPath>.<tgtName>`
// pair (raw paths).  It demangles the core, checks the recovered interface
// matches the source pair, and re-encodes the SAME receiver against the
// target interface via mangle.ImplVtableName — the cross-mode contract is
// now the demangler, not a byte-scan.  Returns the rewritten name, or an
// empty slice if the decoration/parse fails or the source interface doesn't
// match.
func swapIfaceSuffix(srcName @[]char,
		suffixes @[]char) @[]readonly char {
	var empty @[]readonly char
	var sepIdx int = -1
	for i := 0; i < len(suffixes); i++ {
		if suffixes[i] == '|' { sepIdx = i; break }
	}
	if sepIdx < 0 { return empty }
	// Split the source / target halves at "|", then each half into
	// (pkgPath, name) at its LAST ".".
	var src @ifaceHalf = splitIfaceHalf(suffixes, 0, sepIdx)
	var tgt @ifaceHalf = splitIfaceHalf(suffixes, sepIdx + 1, len(suffixes))
	var srcPkg @[]char = src.Pkg
	var srcIf @[]char = src.Name
	var tgtPkg @[]char = tgt.Pkg
	var tgtIf @[]char = tgt.Name

	// Peel the `__ivt.` / `__ivtshim.` decoration to the bn_ core.
	var decoLen int = ifaceDecorationLen(srcName)
	if decoLen < 0 { return empty }
	var core @[]readonly char = srcName[decoLen:]

	var d @mangle.DemangledName
	var ok bool
	d, ok = mangle.Demangle(core)
	if !ok { return empty }
	if d.Kind != mangle.KIND_IMPL_VTABLE && d.Kind != mangle.KIND_IMPL_SHIM {
		return empty
	}
	// The recovered interface must match the source half (defensive: the
	// suffix and the vtable name must describe the same upcast).
	if !charEqRaw(joinSlashSegs(d.IfacePkg), srcPkg) { return empty }
	if !charEqRaw(d.IfaceName, srcIf) { return empty }

	// Re-encode the SAME receiver against the TARGET interface; the encoder
	// re-applies the matching decoration (V -> __ivt., W -> __ivtshim.).
	if d.Kind == mangle.KIND_IMPL_SHIM {
		return mangle.ImplVtableShimName(joinSlashSegs(d.Pkg), d.RecvType,
			tgtPkg, tgtIf)
	}
	return mangle.ImplVtableName(joinSlashSegs(d.Pkg), d.RecvType,
		tgtPkg, tgtIf)
}

// ifaceHalf is one side of an iface-upcast suffix: a (raw pkg path, iface
// name) pair.
type ifaceHalf struct {
	Pkg  @[]char
	Name @[]char
}

// splitIfaceHalf reads suffixes[begin:end] as `<pkgPath>.<name>` (pkgPath
// raw, possibly empty).  The split is at the LAST ".", so an empty half
// yields empty pkg + empty name.
func splitIfaceHalf(suffixes @[]char, begin int, end int) @ifaceHalf {
	var out @ifaceHalf = make(ifaceHalf)
	var lastDot int = -1
	for i := begin; i < end; i++ {
		if suffixes[i] == '.' { lastDot = i }
	}
	if lastDot < 0 {
		out.Pkg = buf.CopyStr(suffixes[begin:end])
		return out
	}
	out.Pkg = buf.CopyStr(suffixes[begin:lastDot])
	out.Name = buf.CopyStr(suffixes[lastDot + 1:end])
	return out
}

// ifaceDecorationLen returns the byte length of the `__ivt.` / `__ivtshim.`
// decoration prefixing an interface-impl vtable name, or -1 if neither is
// present.
func ifaceDecorationLen(name @[]char) int {
	if iface_startsWith(name, "__ivtshim.") { return 10 }
	if iface_startsWith(name, "__ivt.") { return 6 }
	return -1
}

// iface_startsWith reports whether haystack begins with needle.
func iface_startsWith(haystack @[]char, needle *[]readonly char) bool {
	if len(needle) > len(haystack) { return false }
	for i := 0; i < len(needle); i++ {
		if haystack[i] != needle[i] { return false }
	}
	return true
}

// joinSlashSegs joins "/"-split package segments back into a raw path
// (`[pkg, geom]` -> `pkg/geom`); the empty segment list yields the empty
// string (a primitive / universe receiver/interface package).
func joinSlashSegs(segs @[]@[]char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	for i := 0; i < len(segs); i++ {
		if i > 0 { b.WriteByte('/') }
		b.Write(segs[i])
	}
	return buf.CopyStr(b.String())
}

// charEqRaw reports byte-equality of two strings.
func charEqRaw(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// iface_upcastTargetIsAny reports whether the target half of an iface-upcast
// suffix encoding names the universe `any` interface (empty pkg, name "any"
// — encoded as `.any` after the `|` separator).  Plan §6.
func iface_upcastTargetIsAny(suffixes @[]char) bool {
	var sepIdx int = -1
	for i := 0; i < len(suffixes); i++ {
		if suffixes[i] == '|' { sepIdx = i; break }
	}
	if sepIdx < 0 { return false }
	var tgtLen int = len(suffixes) - sepIdx - 1
	if tgtLen != 4 { return false }
	return suffixes[sepIdx + 1] == '.' &&
		suffixes[sepIdx + 2] == 'a' &&
		suffixes[sepIdx + 3] == 'n' &&
		suffixes[sepIdx + 4] == 'y'
}
