package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/fmt"

// Tests for execIfaceOp (BC_IFACE_VALUE / BC_IFACE_DTOR). The
// execIfaceOp dispatcher itself doesn't carry distinct semantics
// from the underlying handlers — it's just where execFuncRefOp
// delegates iface ops. These lower-from-source tests check that
// the lowering produces the right bytecode ops and that they
// reach the dispatcher; runtime correctness for iface dispatch
// is covered end-to-end by conformance tests 354+ across both
// builder-comp-int and builder-comp.

// Lowering an `interface I { foo() }` + impl yields BC_IFACE_VALUE
// for the iv-construction site.
func TestLowerEmitsBcIfaceValue() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "interface I { foo() }\n")
	src = concatStr(src, "type T struct { x int }\n")
	src = concatStr(src, "func (t *T) foo() { }\n")
	src = concatStr(src, "impl *T : I\n")
	src = concatStr(src, "func main() {\n")
	src = concatStr(src, "  var t T\n")
	src = concatStr(src, "  var iv *I = &t\n")
	src = concatStr(src, "  _ = iv\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var hasIfaceValue bool = false
	for i := 0; i < vm.Funcs.Len(); i++ {
		var fn @VMFunc = vm.Funcs.Get(i)
		for j := 0; j < len(fn.Code); j++ {
			if fn.Code[j].Op == BC_IFACE_VALUE {
				hasIfaceValue = true
			}
		}
	}
	if !hasIfaceValue {
		return "expected at least one BC_IFACE_VALUE in lowered bytecode"
	}
	return ""
}

// Lowering an `@Iface` whose receiver type has a managed field
// emits BC_IFACE_DTOR at the iv's scope-exit RefDec site (the
// dtor func index gets fed into BC_REFDEC_INLINE_FAST's Src2).
func TestLowerEmitsBcIfaceDtor() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "interface I { foo() }\n")
	src = concatStr(src, "type Inner struct { v int }\n")
	src = concatStr(src, "type T struct { p @Inner }\n")
	src = concatStr(src, "func (t *T) foo() { }\n")
	src = concatStr(src, "impl *T : I\n")
	src = concatStr(src, "func use(iv @I) { }\n")
	src = concatStr(src, "func main() {\n")
	src = concatStr(src, "  var h @T = make(T)\n")
	src = concatStr(src, "  use(h)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var hasIfaceDtor bool = false
	for i := 0; i < vm.Funcs.Len(); i++ {
		var fn @VMFunc = vm.Funcs.Get(i)
		for j := 0; j < len(fn.Code); j++ {
			if fn.Code[j].Op == BC_IFACE_DTOR {
				hasIfaceDtor = true
			}
		}
	}
	if !hasIfaceDtor {
		return "expected at least one BC_IFACE_DTOR in lowered bytecode"
	}
	return ""
}

// BC_FUNC_VALUE_DTOR's normal arm: given a non-nil fv whose vtable
// has a non-zero Dtor in slot 0, dispatch loads the Dtor into Dst.
// End-to-end coverage via closure conformance tests runs through
// the Phase 1 path where Dtor=0 (operationally no-op); this synthetic
// test pins the slot-0 load itself so the Phase 2 wiring it will
// carry has a unit-level guard.
func TestExecBcFuncValueDtorNormal() testing.TestResult {
	// Stack-local synthetic vtable and fv.  `[N]int` (not `@[]int`)
	// so `&arr[0]` is a plain *int into contiguous backing.
	var vtableArr [2]int
	vtableArr[0] = 12345 // Dtor sentinel
	vtableArr[1] = 0 // Call (not consumed by this op)
	var fvArr [2]int
	fvArr[0] = bit_cast(int, &vtableArr[0]) // vtable_addr
	fvArr[1] = 0 // data_addr (not consumed)
	var regsArr [2]int
	regsArr[0] = bit_cast(int, &fvArr[0]) // Src1 reg: fv address
	regsArr[1] = -42 // Dst reg: pre-poison

	var instr BCInstr
	instr.Op = BC_FUNC_VALUE_DTOR
	instr.Src1 = 0
	instr.Dst = 1

	var vm @VM = NewVM(1024)
	var f @VMFunc = make(VMFunc)
	if !execIfaceOp(vm, f, &regsArr[0], instr) {
		return "execIfaceOp must handle BC_FUNC_VALUE_DTOR"
	}
	if regsArr[1] != 12345 {
		fmt.Println(regsArr[1])
		return "expected Dst = vtable[0] (12345 sentinel)"
	}
	return ""
}

// BC_FUNC_VALUE_DTOR's nil-vtable arm: a zero-initialized fv (no-
// init `var f @func()`) has vtable_addr=0 in slot 0.  Dispatch must
// short-circuit to 0 — chasing slot 0 via a nil pointer would crash.
// Not reachable from IR-gen-emitted bytecode today (capturing
// closures aren't fully wired in VM mode), but pinned here so the
// arm stays correct when Phase 2 closure dtors land.
func TestExecBcFuncValueDtorNilVtable() testing.TestResult {
	var fvArr [2]int
	fvArr[0] = 0
	fvArr[1] = 0
	var regsArr [2]int
	regsArr[0] = bit_cast(int, &fvArr[0])
	regsArr[1] = -42

	var instr BCInstr
	instr.Op = BC_FUNC_VALUE_DTOR
	instr.Src1 = 0
	instr.Dst = 1

	var vm @VM = NewVM(1024)
	var f @VMFunc = make(VMFunc)
	if !execIfaceOp(vm, f, &regsArr[0], instr) {
		return "execIfaceOp must handle BC_FUNC_VALUE_DTOR"
	}
	if regsArr[1] != 0 {
		return "nil-vtable fv must yield Dst = 0 (no dtor)"
	}
	return ""
}

// BC_IFACE_UPCAST's COMPILED-source branch: an iface value from an injected
// compiled package carries a native @__ivt address (any vtable word outside
// [1, len(vm.IfaceVtables)] — empty here — is native), so the upcast advances
// the vtable WORD by offset*8 bytes (the target ancestor's sub-vtable within
// the source's concat layout) and leaves the data pointer alone.  The branch
// does pure pointer arithmetic and never dereferences the vtable word, so a
// sentinel native address is sufficient to pin the arithmetic.  This is the
// VM mirror of emit_iface_upcast.bn's GEP; the offset comes from
// IfaceParentSlotOffset, baked into Imm at lower time.
func TestExecBcIfaceUpcastNativeSource() testing.TestResult {
	var srcIv [2]int
	srcIv[0] = 0xDEAD // data ptr (must be preserved)
	srcIv[1] = 0x100000 // native vtable base (sentinel; > len(IfaceVtables))
	var regsArr [2]int
	regsArr[0] = bit_cast(int, &srcIv[0]) // Src1: source iv address
	regsArr[1] = -42 // Dst: pre-poison (result iv addr)

	var instr BCInstr
	instr.Op = BC_IFACE_UPCAST
	instr.Src1 = 0
	instr.Dst = 1
	instr.Imm = 3 // parent ancestor begins 3 slots into the source vtable

	var vm @VM = NewVM(1024)
	var f @VMFunc = make(VMFunc)
	if !execIfaceOp(vm, f, &regsArr[0], instr) {
		return "execIfaceOp must handle BC_IFACE_UPCAST"
	}
	var resIv *int = bit_cast(*int, regsArr[1])
	if resIv[0] != 0xDEAD {
		return "native upcast must preserve the data pointer"
	}
	if resIv[1] != 0x100000 + 3 * types.GetTarget().PointerSize {
		return "native upcast must advance the vtable by offset*PointerSize bytes"
	}
	return ""
}

// BC_IFACE_UPCAST's COMPILED-source branch with offset 0 — the upcast-to-`any`
// and managed<->raw-decay case.  The native vtable word passes through
// unchanged so a later native method dispatch still resolves the registered
// base.
func TestExecBcIfaceUpcastNativeSourceZeroOffset() testing.TestResult {
	var srcIv [2]int
	srcIv[0] = 0xBEEF
	srcIv[1] = 0x200000
	var regsArr [2]int
	regsArr[0] = bit_cast(int, &srcIv[0])
	regsArr[1] = -42

	var instr BCInstr
	instr.Op = BC_IFACE_UPCAST
	instr.Src1 = 0
	instr.Dst = 1
	instr.Imm = 0

	var vm @VM = NewVM(1024)
	var f @VMFunc = make(VMFunc)
	if !execIfaceOp(vm, f, &regsArr[0], instr) {
		return "execIfaceOp must handle BC_IFACE_UPCAST"
	}
	var resIv *int = bit_cast(*int, regsArr[1])
	if resIv[0] != 0xBEEF {
		return "zero-offset native upcast must preserve the data pointer"
	}
	if resIv[1] != 0x200000 {
		return "zero-offset native upcast must pass the vtable through unchanged"
	}
	return ""
}

// Lowering a concrete type assertion `iv.(*T)` emits BC_IFACE_TYPEINFO at the
// dynamic-*TypeInfo read the assertion's identity compare consumes (RTTI Slice
// 5b).  Runtime correctness is covered end-to-end by conformance 998–1002
// across the -int modes; this pins that the concrete-assert lowering reaches
// the op.
func TestLowerEmitsBcIfaceTypeInfo() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "interface I { foo() }\n")
	src = concatStr(src, "type T struct { x int }\n")
	src = concatStr(src, "func (t *T) foo() { }\n")
	src = concatStr(src, "impl *T : I\n")
	src = concatStr(src, "func main() {\n")
	src = concatStr(src, "  var t T\n")
	src = concatStr(src, "  var iv *I = &t\n")
	src = concatStr(src, "  var b *T = iv.(*T)\n")
	src = concatStr(src, "  _ = b\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var hasTypeInfo bool = false
	for i := 0; i < vm.Funcs.Len(); i++ {
		var fn @VMFunc = vm.Funcs.Get(i)
		for j := 0; j < len(fn.Code); j++ {
			if fn.Code[j].Op == BC_IFACE_TYPEINFO {
				hasTypeInfo = true
			}
		}
	}
	if !hasTypeInfo {
		return "expected at least one BC_IFACE_TYPEINFO in lowered bytecode"
	}
	return ""
}

// (The NATIVE-injected branch of BC_IFACE_TYPEINFO returns the native
// `&TypeInfo(T)` read from the value's `@__ivt` slot 1 (RTTI Slice X.2); it HITs
// because RegisterPackageSatEntries binds that same native address under the
// type's `__typeinfo.<T>` symbol and keys the (T, J) satentry on it.  The whole
// cross-mode path — native-injected value asserted concrete `x.(*T)` + interface
// `x.(*J)` under the -int modes — is covered end-to-end by conformance
// stdlib/strings/004_cross_mode_iface_assert.  The VM-built branch is covered by
// conformance 998–1002 and by TestLowerEmitsBcIfaceTypeInfo above.)

// An interface-target assertion x.(*J) builds its recovered value on the VM
// stack (BC_IFACE_VALUE_DYN grows vm.SP), so the enclosing statement MUST emit
// BC_SP_RESTORE to reclaim that slot — else a looped assertion leaks vm.SP and
// eventually overflows vm.Stack.  This pins that the assertion lowering marks
// the statement SP-growing (recoverInterfaceValue -> noteSPGrowingResult).  A
// runtime overflow test would need ~500k iterations, impractically slow in the
// double-interpreted -int-int mode; here `f`'s scrutinee is a PARAMETER (not
// boxed in-function), so the assertion is the only SP-growing op and any
// BC_SP_RESTORE is the one the fix emits.  RTTI Slice 5b-2.
func TestIfaceAssertEmitsSpRestore() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "interface A { m() int }\n")
	src = concatStr(src, "interface B { m() int }\n")
	src = concatStr(src, "type Thing struct { x int }\n")
	src = concatStr(src, "func (t *Thing) m() int { return t.x }\n")
	src = concatStr(src, "impl *Thing : A\n")
	src = concatStr(src, "impl *Thing : B\n")
	src = concatStr(src, "func f(g *A) int {\n")
	src = concatStr(src, "  var b *B = g.(*B)\n")
	src = concatStr(src, "  _ = b\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() { }\n")
	var vm @VM = lowerFromSource(src)
	var hasSpRestore bool = false
	for i := 0; i < vm.Funcs.Len(); i++ {
		var fn @VMFunc = vm.Funcs.Get(i)
		for j := 0; j < len(fn.Code); j++ {
			if fn.Code[j].Op == BC_SP_RESTORE {
				hasSpRestore = true
			}
		}
	}
	if !hasSpRestore {
		return "interface-target assertion must emit BC_SP_RESTORE to reclaim the recovered value's VM st"
				"ack slot"
	}
	return ""
}
