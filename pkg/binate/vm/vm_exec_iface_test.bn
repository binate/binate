package "pkg/binate/vm"

import "pkg/builtins/bootstrap"
import "pkg/builtins/testing"

// Tests for execIfaceOp (BC_IFACE_VALUE / BC_IFACE_DTOR). The
// execIfaceOp dispatcher itself doesn't carry distinct semantics
// from the underlying handlers — it's just where execFuncRefOp
// delegates iface ops. These lower-from-source tests check that
// the lowering produces the right bytecode ops and that they
// reach the dispatcher; runtime correctness for iface dispatch
// is covered end-to-end by conformance tests 354+ across both
// builder-comp-int and builder-comp.

// Lowering an `interface I { foo() }` + impl yields BC_IFACE_VALUE
// for the iv-construction site.
func TestLowerEmitsBcIfaceValue() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "interface I { foo() }\n")
	src = concatStr(src, "type T struct { x int }\n")
	src = concatStr(src, "func (t *T) foo() { }\n")
	src = concatStr(src, "impl *T : I\n")
	src = concatStr(src, "func main() {\n")
	src = concatStr(src, "  var t T\n")
	src = concatStr(src, "  var iv *I = &t\n")
	src = concatStr(src, "  _ = iv\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var hasIfaceValue bool = false
	for i := 0; i < len(vm.Funcs); i++ {
		var fn @VMFunc = vm.Funcs[i]
		for j := 0; j < len(fn.Code); j++ {
			if fn.Code[j].Op == BC_IFACE_VALUE {
				hasIfaceValue = true
			}
		}
	}
	if !hasIfaceValue {
		return "expected at least one BC_IFACE_VALUE in lowered bytecode"
	}
	return ""
}

// Lowering an `@Iface` whose receiver type has a managed field
// emits BC_IFACE_DTOR at the iv's scope-exit RefDec site (the
// dtor func index gets fed into BC_REFDEC_INLINE_FAST's Src2).
// Slice 2.5b of plan-interface-syntax-revision.md.
func TestLowerEmitsBcIfaceDtor() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "interface I { foo() }\n")
	src = concatStr(src, "type Inner struct { v int }\n")
	src = concatStr(src, "type T struct { p @Inner }\n")
	src = concatStr(src, "func (t *T) foo() { }\n")
	src = concatStr(src, "impl *T : I\n")
	src = concatStr(src, "func use(iv @I) { }\n")
	src = concatStr(src, "func main() {\n")
	src = concatStr(src, "  var h @T = make(T)\n")
	src = concatStr(src, "  use(h)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var hasIfaceDtor bool = false
	for i := 0; i < len(vm.Funcs); i++ {
		var fn @VMFunc = vm.Funcs[i]
		for j := 0; j < len(fn.Code); j++ {
			if fn.Code[j].Op == BC_IFACE_DTOR {
				hasIfaceDtor = true
			}
		}
	}
	if !hasIfaceDtor {
		return "expected at least one BC_IFACE_DTOR in lowered bytecode"
	}
	return ""
}

// BC_FUNC_VALUE_DTOR's normal arm: given a non-nil fv whose vtable
// has a non-zero Dtor in slot 0, dispatch loads the Dtor into Dst.
// End-to-end coverage via closure conformance tests runs through
// the Phase 1 path where Dtor=0 (operationally no-op); this synthetic
// test pins the slot-0 load itself so the Phase 2 wiring it will
// carry has a unit-level guard.
func TestExecBcFuncValueDtorNormal() testing.TestResult {
	// Stack-local synthetic vtable and fv.  `[N]int` (not `@[]int`)
	// so `&arr[0]` is a plain *int into contiguous backing.
	var vtableArr [2]int
	vtableArr[0] = 12345  // Dtor sentinel
	vtableArr[1] = 0      // Call (not consumed by this op)
	var fvArr [2]int
	fvArr[0] = bit_cast(int, &vtableArr[0])  // vtable_addr
	fvArr[1] = 0                              // data_addr (not consumed)
	var regsArr [2]int
	regsArr[0] = bit_cast(int, &fvArr[0])    // Src1 reg: fv address
	regsArr[1] = -42                          // Dst reg: pre-poison

	var instr BCInstr
	instr.Op = BC_FUNC_VALUE_DTOR
	instr.Src1 = 0
	instr.Dst = 1

	var vm @VM = NewVM(1024)
	var f @VMFunc = make(VMFunc)
	if !execIfaceOp(vm, f, &regsArr[0], instr) {
		return "execIfaceOp must handle BC_FUNC_VALUE_DTOR"
	}
	if regsArr[1] != 12345 {
		println(bootstrap.Itoa(regsArr[1]))
		return "expected Dst = vtable[0] (12345 sentinel)"
	}
	return ""
}

// BC_FUNC_VALUE_DTOR's nil-vtable arm: a zero-initialized fv (no-
// init `var f @func()`) has vtable_addr=0 in slot 0.  Dispatch must
// short-circuit to 0 — chasing slot 0 via a nil pointer would crash.
// Not reachable from IR-gen-emitted bytecode today (capturing
// closures aren't fully wired in VM mode), but pinned here so the
// arm stays correct when Phase 2 closure dtors land.
func TestExecBcFuncValueDtorNilVtable() testing.TestResult {
	var fvArr [2]int
	fvArr[0] = 0
	fvArr[1] = 0
	var regsArr [2]int
	regsArr[0] = bit_cast(int, &fvArr[0])
	regsArr[1] = -42

	var instr BCInstr
	instr.Op = BC_FUNC_VALUE_DTOR
	instr.Src1 = 0
	instr.Dst = 1

	var vm @VM = NewVM(1024)
	var f @VMFunc = make(VMFunc)
	if !execIfaceOp(vm, f, &regsArr[0], instr) {
		return "execIfaceOp must handle BC_FUNC_VALUE_DTOR"
	}
	if regsArr[1] != 0 {
		return "nil-vtable fv must yield Dst = 0 (no dtor)"
	}
	return ""
}
