package "pkg/binate/vm"

import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Tests for execIfaceOp (BC_IFACE_VALUE / BC_IFACE_DTOR). The
// execIfaceOp dispatcher itself doesn't carry distinct semantics
// from the underlying handlers — it's just where execFuncRefOp
// delegates iface ops. These lower-from-source tests check that
// the lowering produces the right bytecode ops and that they
// reach the dispatcher; runtime correctness for iface dispatch
// is covered end-to-end by conformance tests 354+ across both
// builder-comp-int and builder-comp.

// Lowering an `interface I { foo() }` + impl yields BC_IFACE_VALUE
// for the iv-construction site.
func TestLowerEmitsBcIfaceValue() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "interface I { foo() }\n")
	src = concatStr(src, "type T struct { x int }\n")
	src = concatStr(src, "func (t *T) foo() { }\n")
	src = concatStr(src, "impl *T : I\n")
	src = concatStr(src, "func main() {\n")
	src = concatStr(src, "  var t T\n")
	src = concatStr(src, "  var iv *I = &t\n")
	src = concatStr(src, "  _ = iv\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var hasIfaceValue bool = false
	for i := 0; i < len(vm.Funcs); i++ {
		var fn @VMFunc = vm.Funcs[i]
		for j := 0; j < len(fn.Code); j++ {
			if fn.Code[j].Op == BC_IFACE_VALUE {
				hasIfaceValue = true
			}
		}
	}
	if !hasIfaceValue {
		return "expected at least one BC_IFACE_VALUE in lowered bytecode"
	}
	return ""
}

// Lowering an `@Iface` whose receiver type has a managed field
// emits BC_IFACE_DTOR at the iv's scope-exit RefDec site (the
// dtor func index gets fed into BC_REFDEC_INLINE_FAST's Src2).
// Slice 2.5b of plan-interface-syntax-revision.md.
func TestLowerEmitsBcIfaceDtor() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "interface I { foo() }\n")
	src = concatStr(src, "type Inner struct { v int }\n")
	src = concatStr(src, "type T struct { p @Inner }\n")
	src = concatStr(src, "func (t *T) foo() { }\n")
	src = concatStr(src, "impl *T : I\n")
	src = concatStr(src, "func use(iv @I) { }\n")
	src = concatStr(src, "func main() {\n")
	src = concatStr(src, "  var h @T = make(T)\n")
	src = concatStr(src, "  use(h)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var hasIfaceDtor bool = false
	for i := 0; i < len(vm.Funcs); i++ {
		var fn @VMFunc = vm.Funcs[i]
		for j := 0; j < len(fn.Code); j++ {
			if fn.Code[j].Op == BC_IFACE_DTOR {
				hasIfaceDtor = true
			}
		}
	}
	if !hasIfaceDtor {
		return "expected at least one BC_IFACE_DTOR in lowered bytecode"
	}
	return ""
}

// BC_FUNC_VALUE_DTOR's normal arm: given a non-nil fv whose vtable
// has a non-zero Dtor in slot 0, dispatch loads the Dtor into Dst.
// End-to-end coverage via closure conformance tests runs through
// the Phase 1 path where Dtor=0 (operationally no-op); this synthetic
// test pins the slot-0 load itself so the Phase 2 wiring it will
// carry has a unit-level guard.
func TestExecBcFuncValueDtorNormal() testing.TestResult {
	// Stack-local synthetic vtable and fv.  `[N]int` (not `@[]int`)
	// so `&arr[0]` is a plain *int into contiguous backing.
	var vtableArr [2]int
	vtableArr[0] = 12345 // Dtor sentinel
	vtableArr[1] = 0 // Call (not consumed by this op)
	var fvArr [2]int
	fvArr[0] = bit_cast(int, &vtableArr[0]) // vtable_addr
	fvArr[1] = 0 // data_addr (not consumed)
	var regsArr [2]int
	regsArr[0] = bit_cast(int, &fvArr[0]) // Src1 reg: fv address
	regsArr[1] = -42 // Dst reg: pre-poison

	var instr BCInstr
	instr.Op = BC_FUNC_VALUE_DTOR
	instr.Src1 = 0
	instr.Dst = 1

	var vm @VM = NewVM(1024)
	var f @VMFunc = make(VMFunc)
	if !execIfaceOp(vm, f, &regsArr[0], instr) {
		return "execIfaceOp must handle BC_FUNC_VALUE_DTOR"
	}
	if regsArr[1] != 12345 {
		println(strconv.Itoa(regsArr[1]))
		return "expected Dst = vtable[0] (12345 sentinel)"
	}
	return ""
}

// BC_FUNC_VALUE_DTOR's nil-vtable arm: a zero-initialized fv (no-
// init `var f @func()`) has vtable_addr=0 in slot 0.  Dispatch must
// short-circuit to 0 — chasing slot 0 via a nil pointer would crash.
// Not reachable from IR-gen-emitted bytecode today (capturing
// closures aren't fully wired in VM mode), but pinned here so the
// arm stays correct when Phase 2 closure dtors land.
func TestExecBcFuncValueDtorNilVtable() testing.TestResult {
	var fvArr [2]int
	fvArr[0] = 0
	fvArr[1] = 0
	var regsArr [2]int
	regsArr[0] = bit_cast(int, &fvArr[0])
	regsArr[1] = -42

	var instr BCInstr
	instr.Op = BC_FUNC_VALUE_DTOR
	instr.Src1 = 0
	instr.Dst = 1

	var vm @VM = NewVM(1024)
	var f @VMFunc = make(VMFunc)
	if !execIfaceOp(vm, f, &regsArr[0], instr) {
		return "execIfaceOp must handle BC_FUNC_VALUE_DTOR"
	}
	if regsArr[1] != 0 {
		return "nil-vtable fv must yield Dst = 0 (no dtor)"
	}
	return ""
}

// BC_IFACE_UPCAST's COMPILED-source branch: an iface value from an injected
// compiled package carries a native @__ivt address (any vtable word outside
// [1, len(vm.IfaceVtables)] — empty here — is native), so the upcast advances
// the vtable WORD by offset*8 bytes (the target ancestor's sub-vtable within
// the source's concat layout) and leaves the data pointer alone.  The branch
// does pure pointer arithmetic and never dereferences the vtable word, so a
// sentinel native address is sufficient to pin the arithmetic.  This is the
// VM mirror of emit_iface_upcast.bn's GEP; the offset comes from
// IfaceParentSlotOffset, baked into Imm at lower time.
func TestExecBcIfaceUpcastNativeSource() testing.TestResult {
	var srcIv [2]int
	srcIv[0] = 0xDEAD // data ptr (must be preserved)
	srcIv[1] = 0x100000 // native vtable base (sentinel; > len(IfaceVtables))
	var regsArr [2]int
	regsArr[0] = bit_cast(int, &srcIv[0]) // Src1: source iv address
	regsArr[1] = -42 // Dst: pre-poison (result iv addr)

	var instr BCInstr
	instr.Op = BC_IFACE_UPCAST
	instr.Src1 = 0
	instr.Dst = 1
	instr.Imm = 3 // parent ancestor begins 3 slots into the source vtable

	var vm @VM = NewVM(1024)
	var f @VMFunc = make(VMFunc)
	if !execIfaceOp(vm, f, &regsArr[0], instr) {
		return "execIfaceOp must handle BC_IFACE_UPCAST"
	}
	var resIv *int = bit_cast(*int, regsArr[1])
	if resIv[0] != 0xDEAD {
		return "native upcast must preserve the data pointer"
	}
	if resIv[1] != 0x100000 + 3 * 8 {
		return "native upcast must advance the vtable by offset*8 bytes"
	}
	return ""
}

// BC_IFACE_UPCAST's COMPILED-source branch with offset 0 — the upcast-to-`any`
// and managed<->raw-decay case.  The native vtable word passes through
// unchanged so a later native method dispatch still resolves the registered
// base.
func TestExecBcIfaceUpcastNativeSourceZeroOffset() testing.TestResult {
	var srcIv [2]int
	srcIv[0] = 0xBEEF
	srcIv[1] = 0x200000
	var regsArr [2]int
	regsArr[0] = bit_cast(int, &srcIv[0])
	regsArr[1] = -42

	var instr BCInstr
	instr.Op = BC_IFACE_UPCAST
	instr.Src1 = 0
	instr.Dst = 1
	instr.Imm = 0

	var vm @VM = NewVM(1024)
	var f @VMFunc = make(VMFunc)
	if !execIfaceOp(vm, f, &regsArr[0], instr) {
		return "execIfaceOp must handle BC_IFACE_UPCAST"
	}
	var resIv *int = bit_cast(*int, regsArr[1])
	if resIv[0] != 0xBEEF {
		return "zero-offset native upcast must preserve the data pointer"
	}
	if resIv[1] != 0x200000 {
		return "zero-offset native upcast must pass the vtable through unchanged"
	}
	return ""
}

// ============================================================
// swapIfaceSuffix — the iv-upcast vtable-name rewrite.  The two
// BC_IFACE_UPCAST tests above take the NATIVE-source branch, which
// short-circuits before swapIfaceSuffix; these pin it directly.  It
// is the most-rewired Demangle consumer (demangle the bn_V/bn_W core,
// re-encode the same receiver against the target interface), so each
// of its return paths gets a unit-level guard here.  Runtime coverage
// is end-to-end via the iv-source upcast conformance tests, but those
// can only exercise the success paths.
// ============================================================

// swapIfaceSuffix rewrites a managed-impl `__ivt.bn_V` vtable name to a
// DIFFERENT interface in the SAME package: the receiver and decoration
// are preserved, only the interface name changes.  Equivalent to
// re-encoding the same receiver against the target interface directly.
func TestSwapIfaceSuffixVtable() testing.TestResult {
	var srcName @[]char = mangle.ImplVtableName("pkg/geom", "Point", "pkg/io", "Writer")
	var suffixes @[]char = buf.CopyStr("pkg/io.Writer|pkg/io.Reader")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	var want @[]char = mangle.ImplVtableName("pkg/geom", "Point", "pkg/io", "Reader")
	if !charEqRaw(got, want) {
		return "swapIfaceSuffix V must re-encode the receiver against the target iface"
	}
	return ""
}

// swapIfaceSuffix on a `__ivtshim.bn_W` name re-applies the SHIM
// decoration (W -> __ivtshim.), not the plain `__ivt.` one — the
// decoration is recovered from the demangled kind, not copied verbatim.
func TestSwapIfaceSuffixShim() testing.TestResult {
	var srcName @[]char = mangle.ImplVtableShimName("main", "Buf", "pkg/io", "Reader")
	var suffixes @[]char = buf.CopyStr("pkg/io.Reader|pkg/io.Writer")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	var want @[]char = mangle.ImplVtableShimName("main", "Buf", "pkg/io", "Writer")
	if !charEqRaw(got, want) {
		return "swapIfaceSuffix W must re-encode through ImplVtableShimName"
	}
	return ""
}

// swapIfaceSuffix with a target interface in a DIFFERENT package than
// the source exercises the full package-path swap (not just the leaf
// name): both the iface package segments and the name change.
func TestSwapIfaceSuffixCrossPackageTarget() testing.TestResult {
	var srcName @[]char = mangle.ImplVtableName("pkg/geom", "Point", "pkg/io", "Writer")
	var suffixes @[]char = buf.CopyStr("pkg/io.Writer|pkg/fmt.Stringer")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	var want @[]char = mangle.ImplVtableName("pkg/geom", "Point", "pkg/fmt", "Stringer")
	if !charEqRaw(got, want) {
		return "swapIfaceSuffix must swap both the iface package and name"
	}
	return ""
}

// A suffix encoding with no "|" separator is malformed; swapIfaceSuffix
// returns the empty slice rather than guessing a split.
func TestSwapIfaceSuffixNoSeparator() testing.TestResult {
	var srcName @[]char = mangle.ImplVtableName("pkg/geom", "Point", "pkg/io", "Writer")
	var suffixes @[]char = buf.CopyStr("pkg/io.Writer")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	if len(got) != 0 {
		return "swapIfaceSuffix must reject a suffix with no '|' separator"
	}
	return ""
}

// A source name lacking the `__ivt.` / `__ivtshim.` decoration cannot be
// a vtable name; swapIfaceSuffix returns empty (ifaceDecorationLen < 0).
func TestSwapIfaceSuffixBadDecoration() testing.TestResult {
	var srcName @[]char = buf.CopyStr("bn_Vno_decoration_prefix")
	var suffixes @[]char = buf.CopyStr("pkg/io.Writer|pkg/io.Reader")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	if len(got) != 0 {
		return "swapIfaceSuffix must reject a name without an __ivt/__ivtshim decoration"
	}
	return ""
}

// A decorated name whose core does not demangle (garbage after `__ivt.`)
// is rejected: Demangle returns ok=false, so swapIfaceSuffix returns
// empty rather than re-encoding junk.
func TestSwapIfaceSuffixGarbageCore() testing.TestResult {
	var srcName @[]char = buf.CopyStr("__ivt.not_a_valid_symbol")
	var suffixes @[]char = buf.CopyStr("pkg/io.Writer|pkg/io.Reader")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	if len(got) != 0 {
		return "swapIfaceSuffix must reject a decoration over a non-demanglable core"
	}
	return ""
}

// A decorated name whose core demangles to a NON-vtable kind (here a
// plain function, bn_F) is rejected — the kind guard requires
// IMPL_VTABLE or IMPL_SHIM.
func TestSwapIfaceSuffixWrongKindCore() testing.TestResult {
	var srcName @[]char = buf.Concat("__ivt.", mangle.FuncName("pkg/geom", "doThing"))
	var suffixes @[]char = buf.CopyStr("pkg/io.Writer|pkg/io.Reader")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	if len(got) != 0 {
		return "swapIfaceSuffix must reject a decoration over a non-vtable core"
	}
	return ""
}

// The defensive source-interface check: when the suffix's SOURCE half
// names a different interface than the vtable actually implements,
// swapIfaceSuffix returns empty (the upcast and the name disagree).
func TestSwapIfaceSuffixSourceMismatch() testing.TestResult {
	var srcName @[]char = mangle.ImplVtableName("pkg/geom", "Point", "pkg/io", "Writer")
	// Source half says Reader, but the vtable implements Writer.
	var suffixes @[]char = buf.CopyStr("pkg/io.Reader|pkg/io.Closer")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	if len(got) != 0 {
		return "swapIfaceSuffix must reject a source-iface mismatch"
	}
	return ""
}

// The source-interface PACKAGE mismatch path (the line-385 return, distinct
// from the NAME mismatch above): the suffix's source iface NAME matches the
// vtable's but its PACKAGE differs, so swapIfaceSuffix returns empty.
func TestSwapIfaceSuffixSourcePkgMismatch() testing.TestResult {
	var srcName @[]char = mangle.ImplVtableName("pkg/geom", "Point", "pkg/io", "Writer")
	// Source half: name Writer matches, but package pkg/fmt != pkg/io.
	var suffixes @[]char = buf.CopyStr("pkg/fmt.Writer|pkg/io.Reader")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	if len(got) != 0 {
		return "swapIfaceSuffix must reject a source-iface package mismatch"
	}
	return ""
}

// Lowering a concrete type assertion `iv.(*T)` emits BC_IFACE_TYPEINFO at the
// dynamic-*TypeInfo read the assertion's identity compare consumes (RTTI Slice
// 5b).  Runtime correctness is covered end-to-end by conformance 998–1002
// across the -int modes; this pins that the concrete-assert lowering reaches
// the op.
func TestLowerEmitsBcIfaceTypeInfo() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "interface I { foo() }\n")
	src = concatStr(src, "type T struct { x int }\n")
	src = concatStr(src, "func (t *T) foo() { }\n")
	src = concatStr(src, "impl *T : I\n")
	src = concatStr(src, "func main() {\n")
	src = concatStr(src, "  var t T\n")
	src = concatStr(src, "  var iv *I = &t\n")
	src = concatStr(src, "  var b *T = iv.(*T)\n")
	src = concatStr(src, "  _ = b\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var hasTypeInfo bool = false
	for i := 0; i < len(vm.Funcs); i++ {
		var fn @VMFunc = vm.Funcs[i]
		for j := 0; j < len(fn.Code); j++ {
			if fn.Code[j].Op == BC_IFACE_TYPEINFO {
				hasTypeInfo = true
			}
		}
	}
	if !hasTypeInfo {
		return "expected at least one BC_IFACE_TYPEINFO in lowered bytecode"
	}
	return ""
}

// (The NATIVE-injected branch of BC_IFACE_TYPEINFO loud-fails — its native
// __typeinfo address would not match the VM's own materialized record, so the
// cross-mode mapping is deferred to RTTI Slice 5b-2 — so it has no return value
// to unit-test.  The VM-built branch is covered end-to-end by conformance
// 998–1002 and by TestLowerEmitsBcIfaceTypeInfo above.)
