package "pkg/binate/vm"

import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/builtins/testing"

// Unit tests for the iface-upcast vtable-name machinery (vm_exec_iface_upcast.bn):
// swapIfaceSuffix's demangle/re-encode and each of its early-return paths.  The
// BC_IFACE_UPCAST exec arm (vm_exec_iface.bn) short-circuits before
// swapIfaceSuffix on a native-injected source, so the runtime conformance tests
// exercise only its success paths; these pin every return path directly.

// swapIfaceSuffix rewrites a managed-impl `__ivt.bn_V` vtable name to a
// DIFFERENT interface in the SAME package: the receiver and decoration
// are preserved, only the interface name changes.  Equivalent to
// re-encoding the same receiver against the target interface directly.
func TestSwapIfaceSuffixVtable() testing.TestResult {
	var srcName @[]char = mangle.ImplVtableName("pkg/geom", "Point", "pkg/io", "Writer")
	var suffixes @[]char = buf.CopyStr("pkg/io.Writer|pkg/io.Reader")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	var want @[]char = mangle.ImplVtableName("pkg/geom", "Point", "pkg/io", "Reader")
	if !charEqRaw(got, want) {
		return "swapIfaceSuffix V must re-encode the receiver against the target iface"
	}
	return ""
}

// swapIfaceSuffix on a `__ivtshim.bn_W` name re-applies the SHIM
// decoration (W -> __ivtshim.), not the plain `__ivt.` one — the
// decoration is recovered from the demangled kind, not copied verbatim.
func TestSwapIfaceSuffixShim() testing.TestResult {
	var srcName @[]char = mangle.ImplVtableShimName("main", "Buf", "pkg/io", "Reader")
	var suffixes @[]char = buf.CopyStr("pkg/io.Reader|pkg/io.Writer")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	var want @[]char = mangle.ImplVtableShimName("main", "Buf", "pkg/io", "Writer")
	if !charEqRaw(got, want) {
		return "swapIfaceSuffix W must re-encode through ImplVtableShimName"
	}
	return ""
}

// swapIfaceSuffix with a target interface in a DIFFERENT package than
// the source exercises the full package-path swap (not just the leaf
// name): both the iface package segments and the name change.
func TestSwapIfaceSuffixCrossPackageTarget() testing.TestResult {
	var srcName @[]char = mangle.ImplVtableName("pkg/geom", "Point", "pkg/io", "Writer")
	var suffixes @[]char = buf.CopyStr("pkg/io.Writer|pkg/fmt.Stringer")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	var want @[]char = mangle.ImplVtableName("pkg/geom", "Point", "pkg/fmt", "Stringer")
	if !charEqRaw(got, want) {
		return "swapIfaceSuffix must swap both the iface package and name"
	}
	return ""
}

// A suffix encoding with no "|" separator is malformed; swapIfaceSuffix
// returns the empty slice rather than guessing a split.
func TestSwapIfaceSuffixNoSeparator() testing.TestResult {
	var srcName @[]char = mangle.ImplVtableName("pkg/geom", "Point", "pkg/io", "Writer")
	var suffixes @[]char = buf.CopyStr("pkg/io.Writer")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	if len(got) != 0 {
		return "swapIfaceSuffix must reject a suffix with no '|' separator"
	}
	return ""
}

// A source name lacking the `__ivt.` / `__ivtshim.` decoration cannot be
// a vtable name; swapIfaceSuffix returns empty (ifaceDecorationLen < 0).
func TestSwapIfaceSuffixBadDecoration() testing.TestResult {
	var srcName @[]char = buf.CopyStr("bn_Vno_decoration_prefix")
	var suffixes @[]char = buf.CopyStr("pkg/io.Writer|pkg/io.Reader")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	if len(got) != 0 {
		return "swapIfaceSuffix must reject a name without an __ivt/__ivtshim decoration"
	}
	return ""
}

// A decorated name whose core does not demangle (garbage after `__ivt.`)
// is rejected: Demangle returns ok=false, so swapIfaceSuffix returns
// empty rather than re-encoding junk.
func TestSwapIfaceSuffixGarbageCore() testing.TestResult {
	var srcName @[]char = buf.CopyStr("__ivt.not_a_valid_symbol")
	var suffixes @[]char = buf.CopyStr("pkg/io.Writer|pkg/io.Reader")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	if len(got) != 0 {
		return "swapIfaceSuffix must reject a decoration over a non-demanglable core"
	}
	return ""
}

// A decorated name whose core demangles to a NON-vtable kind (here a
// plain function, bn_F) is rejected — the kind guard requires
// IMPL_VTABLE or IMPL_SHIM.
func TestSwapIfaceSuffixWrongKindCore() testing.TestResult {
	var srcName @[]char = buf.Concat("__ivt.", mangle.FuncName("pkg/geom", "doThing"))
	var suffixes @[]char = buf.CopyStr("pkg/io.Writer|pkg/io.Reader")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	if len(got) != 0 {
		return "swapIfaceSuffix must reject a decoration over a non-vtable core"
	}
	return ""
}

// The defensive source-interface check: when the suffix's SOURCE half
// names a different interface than the vtable actually implements,
// swapIfaceSuffix returns empty (the upcast and the name disagree).
func TestSwapIfaceSuffixSourceMismatch() testing.TestResult {
	var srcName @[]char = mangle.ImplVtableName("pkg/geom", "Point", "pkg/io", "Writer")
	// Source half says Reader, but the vtable implements Writer.
	var suffixes @[]char = buf.CopyStr("pkg/io.Reader|pkg/io.Closer")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	if len(got) != 0 {
		return "swapIfaceSuffix must reject a source-iface mismatch"
	}
	return ""
}

// The source-interface PACKAGE mismatch path (the line-385 return, distinct
// from the NAME mismatch above): the suffix's source iface NAME matches the
// vtable's but its PACKAGE differs, so swapIfaceSuffix returns empty.
func TestSwapIfaceSuffixSourcePkgMismatch() testing.TestResult {
	var srcName @[]char = mangle.ImplVtableName("pkg/geom", "Point", "pkg/io", "Writer")
	// Source half: name Writer matches, but package pkg/fmt != pkg/io.
	var suffixes @[]char = buf.CopyStr("pkg/fmt.Writer|pkg/io.Reader")
	var got @[]readonly char = swapIfaceSuffix(srcName, suffixes)
	if len(got) != 0 {
		return "swapIfaceSuffix must reject a source-iface package mismatch"
	}
	return ""
}
