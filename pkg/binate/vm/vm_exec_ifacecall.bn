package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/builtins/rt"

// execCallIfaceMethod handles a BC_CALL_IFACE_METHOD dispatch — an interface-method
// call whose two-word {data_ptr, vtable_word} interface value lives at
// regs[instr.Src1].  A NATIVE-vtable iface (an injected COMPILED package's value)
// dispatches inline through the shim primitives and control continues at the current
// pc — returns (0, 0, false).  A VM-lowered iface resolves the method's VM function
// index from vm.IfaceVtables, pushes a new frame (receiver data ptr in slot 0, then
// the packed user args), and returns (calleeFuncIdx, newRegsOff, true); the caller
// switches execLoop's control state to that frame (pc=0) and recomputes
// f/code/regs/frameBase from funcIdx/regsOff.  Extracted from execLoop for file
// length — like execCallFuncValue it leaves the loop-local control state to the
// caller rather than mutating it, so it can live outside the dispatch loop.
// Slice 2.3c of plan-interface-syntax-revision.md.
func execCallIfaceMethod(vm @VM, instr BCInstr, pc int, funcIdx int, regsOff int,
		regs *int) (int, int, bool) {
	// Read the iv slot at regs[Src1]; iv[0] = data ptr, iv[1] = 1-based vtable index
	// into vm.IfaceVtables (0 = nil iv — see execIfaceOp's BC_IFACE_VALUE arm for the
	// encoding rationale).  Aux is the absolute vtable slot (slot 0 = dtor; see below).
	// Args follow at [Src2, Src2+Imm-1]; the data ptr is prepended to them as the impl
	// method's receiver argument.
	var ivAddr int = regs[instr.Src1]
	if ivAddr == 0 {
		println("vm: call through nil interface value")
		rt.Exit(1)
	}
	var iv *int = bit_cast(*int, ivAddr)
	var dataPtr int = iv[types.IfaceValueDataIndex()]
	var vtIdxPlus int = iv[types.IfaceValueVtableIndex()]
	if vtIdxPlus == 0 {
		println("vm: call through nil interface value")
		rt.Exit(1)
	}
	if ifaceVtIsNative(vm, vtIdxPlus) {
		// iv came from an injected COMPILED package: iv[1] is a native @__ivt
		// pointer.  Dispatch the method natively through the shim primitives (no VM
		// frame).
		dispatchCompiledIfaceMethod(vm, regs, instr, iv)
		return 0, 0, false
	}
	var vtIdx int = vtIdxPlus - 1
	if vtIdx < 0 || vtIdx >= len(vm.IfaceVtables) {
		vmPanic("vm: interface vtable index out of range")
	}
	var vt @IfaceVtable = vm.IfaceVtables[vtIdx]
	// instr.Aux is the absolute vtable slot (Slice E.4 of plan-interface-embedding.md).
	// Slots 0-1 are the any-block (dtor, then *TypeInfo); methods live at slot >= 2,
	// with extended interfaces' inherited methods landing inside nested parent
	// sub-vtables (still absolute offsets).  Aux's low 16 bits hold the slot; the high
	// bits carry the method result size (used only by the native-vtable path,
	// dispatchCompiledIfaceMethod) — mask them off here.
	var slot int = instr.Aux & 65535
	if slot < 2 || slot >= len(vt.Methods) {
		vmPanic("vm: interface method slot out of range")
	}
	var fnIdx int = vt.Methods[slot]
	if fnIdx == 0 {
		vmPanic("vm: interface method slot is empty")
	}
	var calleeFuncIdx int = fnIdx - 1
	var calleeFunc @VMFunc = vm.Funcs[calleeFuncIdx]
	var newRegsOff int = pushFrame(vm, calleeFunc, pc, funcIdx, regsOff, vm.SP, instr.Dst)
	var newRegs *int = stackPtr(vm, newRegsOff)
	// Receiver: data ptr in slot 0 (pointer = one slot); user args follow as packed
	// slots.  Imm is the packed slot count of user args (Layer 2 step 2b); bound
	// against NumParamSlots, which includes the 1-slot receiver.  No-op on a 64-bit
	// host.
	newRegs[0] = dataPtr
	for i := 0; i < instr.Imm && i + 1 < calleeFunc.NumParamSlots; i++ {
		newRegs[i + 1] = regs[instr.Src2 + i]
	}
	return calleeFuncIdx, newRegsOff, true
}
