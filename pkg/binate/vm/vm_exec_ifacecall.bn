package "pkg/binate/vm"

import "pkg/binate/vmdata"

import "pkg/binate/types"
import "pkg/builtins/rt"

// execCallIfaceMethod handles a BC_CALL_IFACE_METHOD dispatch — an interface-method
// call whose two-word {data_ptr, vtable_word} interface value lives at
// regs[instr.Src1].  A NATIVE-vtable iface (an injected COMPILED package's value)
// dispatches inline through the shim primitives and control continues at the current
// pc — returns (0, 0, false).  A VM-lowered iface resolves the method's VM function
// index from vm.IfaceVtables, pushes a new frame (receiver data ptr in slot 0, then
// the packed user args), and returns (calleeFuncIdx, newRegsOff, true); the caller
// switches execLoop's control state to that frame (pc=0) and recomputes
// f/code/regs/frameBase from funcIdx/regsOff.  Extracted from execLoop for file
// length — like execCallFuncValue it leaves the loop-local control state to the
// caller rather than mutating it, so it can live outside the dispatch loop.
func execCallIfaceMethod(vm @VM, instr BCInstr, pc int, funcIdx int, regsOff int, regs *int,
		callArgs @[]int) (int, int, bool) {
	// Read the iv slot at regs[Src1]; iv[0] = data ptr, iv[1] = 1-based vtable index
	// into vm.IfaceVtables (0 = nil iv — see execIfaceOp's BC_IFACE_VALUE arm for the
	// encoding rationale).  Aux is the absolute vtable slot (slot 0 = dtor; see below).
	// Args follow at [Src2, Src2+Imm-1]; the data ptr is prepended to them as the impl
	// method's receiver argument.
	var ivAddr int = regs[instr.Src1]
	if ivAddr == 0 {
		// Recoverable: a method call through a nil interface value is a user
		// fault.  setFault flags it; the caller (execLoop's BC_CALL_IFACE_METHOD arm),
		// seeing FaultRaised, dispatches to this call op's cleanup pad.  pushed=false
		// keeps the fault path off the frame switch.
		setFault(vm, "runtime error: call of nil interface value")
		return 0, 0, false
	}
	var iv *int = bit_cast(*int, ivAddr)
	var dataPtr int = iv[types.IfaceValueDataIndex()]
	var vtIdxPlus int = iv[types.IfaceValueVtableIndex()]
	if vtIdxPlus == 0 {
		// A zero-initialized iv (data ptr set but vtable index 0) is likewise a nil
		// interface value — same recoverable fault.
		setFault(vm, "runtime error: call of nil interface value")
		return 0, 0, false
	}
	if ifaceVtIsNative(vm, vtIdxPlus) {
		// iv came from an injected COMPILED package: iv[1] is a native @__ivt
		// pointer.  Dispatch the method natively through the shim primitives (no VM
		// frame).  Resolve this call site's argument interface-vtable layout against
		// the CALLER's VMFunc (funcIdx is the running frame's function) for the
		// cross-mode iface-USER-arg substitution.
		var caller @VMFunc = vm.Funcs.Get(funcIdx)
		var layout @vmdata.ArgIfaceLayout = argIfaceLayoutFor(caller, ifaceMethodImmLayout(instr.Imm))
		dispatchCompiledIfaceMethod(vm, regs, instr, iv, layout, callArgs, caller.MaxStmtTempGrowth)
		return 0, 0, false
	}
	var vtIdx int = vtIdxPlus - 1
	if vtIdx < 0 || vtIdx >= vm.IfaceVtables.Len() {
		vmPanic("vm: interface vtable index out of range")
	}
	var vt @vmdata.IfaceVtable = vm.IfaceVtables.Get(vtIdx)
	// instr.Aux is the absolute vtable slot.
	// Slots 0-1 are the any-block (dtor, then *TypeInfo); methods live at slot >= 2,
	// with extended interfaces' inherited methods landing inside nested parent
	// sub-vtables (still absolute offsets).  The Aux slot sub-field holds it; the
	// retbuf field (used only by the native-vtable path, dispatchCompiledIfaceMethod)
	// is masked off here via ifaceMethodAuxSlot.
	var slot int = ifaceMethodAuxSlot(instr.Aux)
	if slot < 2 || slot >= len(vt.Methods) {
		vmPanic("vm: interface method slot out of range")
	}
	var fnIdx int = vt.Methods[slot]
	if fnIdx == 0 {
		vmPanic("vm: interface method slot is empty")
	}
	var calleeFuncIdx int = fnIdx - 1
	var calleeFunc @VMFunc = vm.Funcs.Get(calleeFuncIdx)
	var newRegsOff int = pushFrame(vm, calleeFunc, pc, funcIdx, regsOff, vm.SP, instr.Dst)
	if vm.FaultRaised {
		// The push overflowed the stack: pushed=false; execLoop's arm sees
		// FaultRaised and dispatches to this call op's cleanup pad.
		return 0, 0, false
	}
	var newRegs *int = stackPtr(vm, newRegsOff)
	// Receiver: data ptr in slot 0 (pointer = one slot); user args follow as packed
	// slots.  ifaceMethodImmSlots(instr.Imm) is the packed slot count of user args
	// (pair-aware), masking off the cross-mode iface bitmap the Imm's high bits
	// carry for the native-vtable arm; bound against NumParamSlots, which includes
	// the 1-slot receiver.  No-op on a 64-bit host.
	newRegs[0] = dataPtr
	var nUserSlots int = ifaceMethodImmSlots(instr.Imm)
	for i := 0; i < nUserSlots && i + 1 < calleeFunc.NumParamSlots; i++ {
		newRegs[i + 1] = regs[instr.Src2 + i]
	}
	return calleeFuncIdx, newRegsOff, true
}

// stackCheckIfaceMethod is the BC_STACK_CHECK_IM pre-check: given the interface-value
// receiver's register value (regs[Src1]) and the absolute method vtable slot, it
// raises a recoverable fault (returning true) if calling the method would orphan the
// caller's still-owned moved args:
//   - a NIL interface value ({data,vtable:0}, or a zero register word) → "call of nil
//     interface value", BEFORE the args are consumed so this op's args-owning pad
//     releases them;
//   - a VM iface value (the direct-push dispatch) whose resolved callee's reserved
//     frame (frameReserve) would overflow → "stack overflow".
// It mirrors execCallIfaceMethod's resolution 1:1 (nil checks, ifaceVtIsNative, vtable
// index + slot ranges, vt.Methods[slot]-1), so the pre-check fires for exactly the
// callees the VM dispatch pushes a frame for.  The overflow check is EXACT: the VM
// iface-method dispatch pushes at the current SP with no marshalling growth.  A native
// (injected-package) interface value dispatches through the shim (no recoverable VM
// frame), so this returns false; a malformed vtable/slot also returns false (the
// dispatch fails loud on it, which the pre-check must not mask as a recoverable fault).
func stackCheckIfaceMethod(vm @VM, ivAddr int, slot int) bool {
	if ivAddr == 0 {
		setFault(vm, "runtime error: call of nil interface value")
		return true
	}
	var iv *int = bit_cast(*int, ivAddr)
	var vtIdxPlus int = iv[types.IfaceValueVtableIndex()]
	if vtIdxPlus == 0 {
		setFault(vm, "runtime error: call of nil interface value")
		return true
	}
	if ifaceVtIsNative(vm, vtIdxPlus) {
		return false
	}
	var vtIdx int = vtIdxPlus - 1
	if vtIdx < 0 || vtIdx >= vm.IfaceVtables.Len() {
		return false
	}
	var vt @vmdata.IfaceVtable = vm.IfaceVtables.Get(vtIdx)
	if slot < 2 || slot >= len(vt.Methods) {
		return false
	}
	var fnIdx int = vt.Methods[slot]
	if fnIdx == 0 {
		return false
	}
	if wouldFrameOverflow(vm, frameReserve(vm.Funcs.Get(fnIdx - 1))) {
		setFault(vm, "runtime error: stack overflow")
		return true
	}
	return false
}

// dispatchCompiledIfaceMethod calls an interface method whose vtable is a
// NATIVE @__ivt pointer (the iface value came from an injected COMPILED package,
// or a bytecode BC_IFACE_VALUE over a native-only package's struct — see
// ifaceVtIsNative).  It does NOT call the raw @__ivt method fn directly: an
// arg/return marshaling that matches the native ABI (floats→FP regs, ≤16-byte
// aggregates by value, >16-byte by pointer, stack overflow) is exactly the work
// the per-function SHIM already does correctly, so replicating it here from byte
// sizes is unsound (it would miscompile floats, HFAs, and 32-bit targets).
// Instead it resolves the PARALLEL shim vtable (registered raw-@__ivt-addr →
// @__ivtshim-addr by RegisterPackageVtables), reads the method's function-value
// HANDLE from slot, and dispatches through the handle's CALL_PACKED slot (slot 2) —
// the method's per-signature __shimP, the uniform packed-int-slot entry carrying ANY
// arg/return shape, exactly as the func-value / extern cross-mode paths.  The packed
// args are [receiver, user args...]: the receiver (the method's first param) is
// packed slot 0, matching how __shimP / the impl shim reads it.  Writes regs[instr.Dst]
// in place; the caller `continue`s (no VM frame is pushed).
//
// callArgs is execLoop's hoisted scratch buffer, reused to build the packed
// [receiver, args...] array off vm.Stack (no reservation growth): the receiver (the
// iv data ptr) and the callArgBase user-arg window are not contiguous in regs, so the
// receiver must be prepended into a fresh contiguous slot array.
func dispatchCompiledIfaceMethod(vm @VM, regs *int, instr BCInstr, iv *int,
		layout @vmdata.ArgIfaceLayout, callArgs @[]int, growth int) {
	var shimVtAddr int = lookupShimVtable(vm, iv[types.IfaceValueVtableIndex()])
	if shimVtAddr == 0 {
		// The iface value carries a native @__ivt with no registered shim
		// vtable — RegisterPackageVtables should have bound both for every
		// injected native-only package.  Fail loudly rather than mis-dispatch.
		vmPanic("vm: no shim vtable for native interface method dispatch")
	}
	var shimVt *int = bit_cast(*int, shimVtAddr)
	var slot int = ifaceMethodAuxSlot(instr.Aux)
	// The Aux retbuf field (its WIDE low sub-field) = the aggregate retbuf size
	// (stamped at IR-gen via abi.AggregateReturnSize from the method's full result
	// list) with the scalar64 flag in its bit 0: retbufFieldBytes > 0 = retbuf-shaped
	// return; else retbufFieldScalar64 = a bare 64-bit scalar return (register PAIR on
	// ILP32); else a one-word scalar.  Mirrors isAggregateReturn.  The field is wide
	// (not a 16-bit high half) so a ≥64 KB aggregate return does not
	// under-reserve.
	var retbufField int = ifaceMethodAuxRetbufField(instr.Aux)
	var retbufSize int = retbufFieldBytes(retbufField)
	// Slot holds the method's @__handle ({vtable, data}); slot 2 of its vtable is the
	// call_packed target (the method's __shimP), exactly as a function-value / extern
	// dispatch reads it.
	var handle *int = bit_cast(*int, shimVt[slot])
	if bit_cast(int, handle) == 0 {
		// A null shim slot means the impl-vtable slot collector couldn't resolve the impl
		// method locally (its func isn't in the defining package's TU), so no
		// @__handle was emitted.  The descriptor lists only fully-local impls
		// today, so this is unreachable — but diagnose rather than deref null.
		vmPanic("vm: compiled iface method slot has no shim handle")
	}
	var vtable *int = bit_cast(*int, handle[types.FuncValueVtableIndex()])
	var callPacked int = vtable[types.FuncValueVtableCallPackedIndex()]
	if callPacked == 0 {
		vmPanic("vm: compiled iface method's vtable.call_packed is nil")
	}
	var callPackedFn *uint8 = bit_cast(*uint8, callPacked)
	var dataPtr *uint8 = bit_cast(*uint8, handle[types.FuncValueDataIndex()])
	// Imm's low bits are the user-arg slot count; the high bits carry the
	// argument-interface-layout index (masked off here; the layout is passed in).
	var n int = ifaceMethodImmSlots(instr.Imm)
	// Build the packed [receiver, user args...] slot array in callArgs (off vm.Stack):
	// receiver at slot 0, the n callArgBase user-arg slots at 1..n.  n+1 packed slots;
	// callArgs holds 64, the practical ceiling (the packed SHAPE is unlimited; only
	// the scratch buffer bounds the arity).
	if n + 1 > len(callArgs) {
		vmPanic("vm: compiled iface method arg slots exceed the dispatch buffer")
	}
	callArgs[0] = iv[types.IfaceValueDataIndex()]
	for i := 0; i < n; i++ {
		callArgs[i + 1] = regs[instr.Src2 + i]
	}
	// Cross-mode iface-arg substitution over the USER-arg slots: this method runs as
	// native code (the receiver's vtable came from an injected COMPILED package), so a
	// bytecode-impl iface USER arg (top-level OR nested in a by-value aggregate) would
	// reach it with a VM-index vtable word native code cannot dereference.  For each
	// user-arg slot the layout lists, swap in the impl's native handle-vtable COPY —
	// the receiver (slot 0) is never a bytecode index here (it is the native iface
	// value that routed us to this path).  User args live at callArgs[1..], so
	// substituteLayoutArgs indexes from &callArgs[1] (layout slot k → callArgs[k+1]).
	// A `...*I` slice's ELEMENTS are translated too (substituteSliceIfaceArgs, the
	// layout's SliceIfaceSlots), as the extern dispatch does; a translated copy that does
	// not fit on vm.Stack goes on the heap, freed once the method returns
	// (releaseSliceCopies); the reserve is what may still be pushed after it, the
	// calling statement's growth (`growth`, its function's MaxStmtTempGrowth) and the
	// retbuf this dispatch takes.  No injected stdlib iface method takes an iface arg or a
	// variadic of them, so this fires only for an embedder-injected native package
	// whose iface method does; the identical func-value sibling substitution is
	// exercised by conformance.
	var heapCopies @[]int
	if layout != nil {
		substituteLayoutArgs(vm, &callArgs[1], layout)
		if len(layout.SliceIfaceSlots) > 0 {
			heapCopies = substituteSliceIfaceArgs(vm, &callArgs[1], layout.SliceIfaceSlots,
					growth + retbufSize)
		}
	}
	// Invoke call_packed through the existing rt._call_shim_scalar64 indirect-call
	// vehicle: its fixed arity places (data, argsPtr, nSlots, retbuf) in the first arg
	// registers on every target ABI (call_packed(data, args, nSlots, retbuf)).
	var argsPtr int = bit_cast(int, &callArgs[0])
	var nPacked int = n + 1
	// Publish THIS vm to the installed rt.SatLookup fallback (satFallbackFn) for the
	// native method's duration, so an injected-native `x.(*J)` on a bytecode-boxed value
	// (whose (T, J) fact lives only VM-side) resolves through this vm's satentry registry
	// instead of MISSing the native g_satTable — mirroring dispatchExternBinding.
	// Save/restore keeps it re-entrant (a native callee may re-enter the vm).
	var savedVmAddr int = g_crossModeVmAddr
	g_crossModeVmAddr = bit_cast(int, vm)
	if retbufSize > 0 {
		// Aggregate return: call_packed writes the natural-typed result through a
		// retbuf.  retbufSize (abi.AggregateReturnSize) is rounded up to a whole
		// number of 8-byte words — a conservative over-allocation shared by every
		// backend and the VM regardless of target word size — so it is the true byte
		// count to reserve on vm.Stack.  The i64 return is unused (call_packed
		// returns 0).
		var retbuf *uint8 = bit_cast(*uint8, bit_cast(int, vm.Stack) + vm.SP)
		vm.SP = vm.SP + retbufSize
		rt._call_shim_scalar64(callPackedFn, dataPtr, argsPtr, nPacked, bit_cast(int, retbuf), 0, 0, 0, 0)
		releaseSliceCopies(heapCopies)
		g_crossModeVmAddr = savedVmAddr
		if instr.Dst >= 0 { regs[instr.Dst] = bit_cast(int, retbuf) }
		return
	}
	if retbufFieldScalar64(retbufField) {
		// 64-bit scalar return: read the full i64 (retbuf null) and split into the
		// destination register pair (ILP32).
		storeScalar64Result(regs, instr.Dst,
				rt._call_shim_scalar64(callPackedFn, dataPtr, argsPtr, nPacked, 0, 0, 0, 0, 0))
		releaseSliceCopies(heapCopies)
		g_crossModeVmAddr = savedVmAddr
		return
	}
	// One-word scalar return: narrow the i64 to the host word (retbuf null).
	var result int = cast(int, rt._call_shim_scalar64(callPackedFn, dataPtr, argsPtr, nPacked, 0, 0, 0,
			0, 0))
	releaseSliceCopies(heapCopies)
	g_crossModeVmAddr = savedVmAddr
	if instr.Dst >= 0 { regs[instr.Dst] = result }
}
