package "pkg/binate/vm"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// Tests for execCallIfaceMethod (vm_exec_ifacecall.bn) — the BC_CALL_IFACE_METHOD
// dispatch extracted from execLoop.  The VM-push path carries the interesting logic:
// resolve the method's VM func index from the interface value's vtable, push a frame
// with the receiver data ptr in slot 0 and the packed user args after it, and hand
// the new frame's control state back to execLoop.  Native-vtable dispatch (an
// injected COMPILED package's iface) is covered end-to-end by the injected-package
// conformance tests (726+).

// A concrete-impl interface method dispatched through an interface value must reach
// the impl method with the receiver and user arg wired correctly and return its
// result — the receiver-in-slot-0 + arg-after-receiver frame push execCallIfaceMethod
// performs.  base 40 + k 2 == 42 confirms both the receiver field read and the arg.
func TestExecCallIfaceMethodDispatchesReceiverAndArg() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "interface Calc { compute(k int) int }\n")
	src = concatStr(src, "type Box struct { base int }\n")
	src = concatStr(src, "func (b *Box) compute(k int) int { return b.base + k }\n")
	src = concatStr(src, "impl *Box : Calc\n")
	src = concatStr(src, "func driver() int {\n")
	src = concatStr(src, "  var bx Box\n")
	src = concatStr(src, "  bx.base = 40\n")
	src = concatStr(src, "  var c *Calc = &bx\n")
	src = concatStr(src, "  return c.compute(2)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var noArgs @[]int
	var got int = vm.CallFunc("test.driver", noArgs)
	if got != 42 {
		return "iface-method dispatch must reach *Box.compute with base 40, k 2 -> 42"
	}
	return ""
}

// A method call through a nil interface value is a RECOVERABLE user fault (Plan 2):
// execCallIfaceMethod raises it via setFault and the exec loop unwinds to the host
// with Status = FAULTED + message, rather than killing the host.  The VM-level
// counterpart to conformance 386 — asserts the in-process VM state a CLI golden
// can't see.
func TestExecCallIfaceMethodNilRecovers() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "interface Calc { compute() int }\n")
	src = concatStr(src, "func driver() int {\n")
	src = concatStr(src, "  var c *Calc\n")
	src = concatStr(src, "  return c.compute()\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var noArgs @[]int
	vm.CallFunc("test.driver", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "a method call on a nil interface value must recover with Status = FAULTED"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: call of nil interface value") {
		return "the recovered nil-interface fault must carry the call-of-nil message"
	}
	return ""
}

// TestIfaceMethodOverflowNoLeak: an interface-method call recursing with a fresh
// moved `@I` arg each level until the VM stack overflows must recover leak-free —
// stable LiveBlocks across repeated overflows.  The VM iface-method dispatch pushes
// the callee frame directly, and the pre-delivery OP_STACK_CHECK_IM faults while its
// args-owning pad still covers the moved arg, so the box is released instead of
// orphaned at the frame push.
func TestIfaceMethodOverflowNoLeak() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "interface I { go(@I, int) int }\n")
	src = concatStr(src, "type T struct { x int }\n")
	src = concatStr(src, "func (t @T) go(arg @I, depth int) int {\n")
	src = concatStr(src, "  if depth <= 0 { return t.x }\n")
	src = concatStr(src, "  return arg.go(cast(@I, make(T)), depth - 1)\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "impl @T : I\n")
	src = concatStr(src, "func start(depth int) int {\n")
	src = concatStr(src, "  var t @I = cast(@I, make(T))\n")
	src = concatStr(src, "  return t.go(cast(@I, make(T)), depth)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var argv @[]int = make_slice(int, 1)
	argv[0] = 100000000 // deep enough to overflow
	vm.CallFunc("test.start", argv)
	if vm.Status != VM_STATUS_FAULTED {
		return "deep iface-method recursion must overflow with Status = FAULTED"
	}
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc("test.start", argv)
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated iface-method overflow must recover identically"
	}
	if rt.LiveBlocks() != base {
		return "iface-method overflow LEAKS the moved @I arg"
	}
	return ""
}

// TestNilIfaceMethodMovedArgNoLeak: calling a method on a NIL interface value with a
// MOVED managed arg (`cast(@I, make(T))`) must release that arg, not orphan it.  The
// pre-delivery OP_STACK_CHECK_IM faults on the nil value while its args-owning pad
// still covers the arg — BEFORE delivery consumes it — so LiveBlocks stays stable
// across repeated nil calls.
func TestNilIfaceMethodMovedArgNoLeak() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "interface I { go(@I) int }\n")
	src = concatStr(src, "type T struct { x int }\n")
	src = concatStr(src, "func (t @T) go(arg @I) int { return t.x }\n")
	src = concatStr(src, "impl @T : I\n")
	src = concatStr(src, "func callNil() int {\n")
	src = concatStr(src, "  var c *I\n")
	src = concatStr(src, "  return c.go(cast(@I, make(T)))\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var noArgs @[]int
	vm.CallFunc("test.callNil", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "a method call on a nil interface value must fault with Status = FAULTED"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: call of nil interface value") {
		return "the recovered nil-interface fault must carry the call-of-nil message"
	}
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc("test.callNil", noArgs)
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated nil iface-method call must recover identically"
	}
	if rt.LiveBlocks() != base {
		return "nil iface-method call LEAKS the moved @I arg (pre-check must release it)"
	}
	return ""
}
