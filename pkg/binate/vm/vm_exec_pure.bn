package "pkg/binate/vm"

// Pure register-only bytecode handlers — arithmetic, comparison,
// and unary ops that read/write `regs` but don't touch execLoop's
// control state (pc, funcIdx, f, code, regsOff, frameBase,
// freeOnPop). Hoisted out of vm_exec.bn so the execLoop dispatch
// stays focused on control-flow handlers and the file stays under
// the file-length cap. Memory ops live in execMemoryOp in
// vm_exec_helpers.bn (a separate extraction).
//
// Each helper returns true if the dispatch was handled (caller
// `continue`s) and false otherwise (caller falls through).

// execArithOp handles integer arithmetic (BC_ADD..BC_SHR) and
// float64 arithmetic (BC_FADD..BC_FDIV). All ops read two
// register operands and write one register destination.
func execArithOp(regs *int, instr BCInstr) bool {
	switch instr.Op {
	case BC_ADD: regs[instr.Dst] = regs[instr.Src1] + regs[instr.Src2]; return true
	case BC_SUB: regs[instr.Dst] = regs[instr.Src1] - regs[instr.Src2]; return true
	case BC_MUL: regs[instr.Dst] = regs[instr.Src1] * regs[instr.Src2]; return true
	case BC_DIV: regs[instr.Dst] = regs[instr.Src1] / regs[instr.Src2]; return true
	case BC_REM: regs[instr.Dst] = regs[instr.Src1] % regs[instr.Src2]; return true
	case BC_UDIV:
		var a uint64 = cast(uint64, regs[instr.Src1])
		var b uint64 = cast(uint64, regs[instr.Src2])
		regs[instr.Dst] = cast(int, a / b)
		return true
	case BC_UREM:
		var a uint64 = cast(uint64, regs[instr.Src1])
		var b uint64 = cast(uint64, regs[instr.Src2])
		regs[instr.Dst] = cast(int, a % b)
		return true
	case BC_AND: regs[instr.Dst] = regs[instr.Src1] & regs[instr.Src2]; return true
	case BC_OR:  regs[instr.Dst] = regs[instr.Src1] | regs[instr.Src2]; return true
	case BC_XOR: regs[instr.Dst] = regs[instr.Src1] ^ regs[instr.Src2]; return true
	case BC_SHL: regs[instr.Dst] = regs[instr.Src1] << regs[instr.Src2]; return true
	case BC_SHR: regs[instr.Dst] = regs[instr.Src1] >> regs[instr.Src2]; return true
	case BC_LSHR:
		var a uint64 = cast(uint64, regs[instr.Src1])
		var n uint64 = cast(uint64, regs[instr.Src2])
		regs[instr.Dst] = cast(int, a >> n)
		return true

	// Float64 arithmetic. Operands bit-cast through int registers;
	// arithmetic is always at float64 precision.  The float64 bits ride
	// through int64 (not host-int) so the bit_cast is always 64↔64 —
	// portable across hosts whose word is smaller than 8 bytes, where
	// `bit_cast(int, float64)` would be a size mismatch.  On a 64-bit
	// host the cast(int64, int) / cast(int, int64) hops are identities;
	// on a 32-bit host the BC_F* opcodes are dead path (lowering emits
	// BC_F*64 pair ops there) — these handlers stay compile-clean.
	case BC_FADD:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		regs[instr.Dst] = cast(int, bit_cast(int64, a + b))
		return true
	case BC_FSUB:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		regs[instr.Dst] = cast(int, bit_cast(int64, a - b))
		return true
	case BC_FMUL:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		regs[instr.Dst] = cast(int, bit_cast(int64, a * b))
		return true
	case BC_FDIV:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		regs[instr.Dst] = cast(int, bit_cast(int64, a / b))
		return true
	}
	return false
}

// execCmpOp handles integer comparison (BC_EQ..BC_SGE) and
// float64 comparison (BC_FEQ..BC_FGE). Result is 0 or 1 in the
// destination register.
func execCmpOp(regs *int, instr BCInstr) bool {
	switch instr.Op {
	case BC_EQ:
		if regs[instr.Src1] == regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_NE:
		if regs[instr.Src1] != regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_SLT:
		if regs[instr.Src1] < regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_SLE:
		if regs[instr.Src1] <= regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_SGT:
		if regs[instr.Src1] > regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_SGE:
		if regs[instr.Src1] >= regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true

	// Unsigned integer comparison: reinterpret the int register
	// bits as uint64 first (Binate's `<` / `<=` / `>` / `>=` on
	// uint64 is unsigned, which is what we need).
	case BC_ULT:
		var a uint64 = cast(uint64, regs[instr.Src1])
		var b uint64 = cast(uint64, regs[instr.Src2])
		if a < b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_ULE:
		var a uint64 = cast(uint64, regs[instr.Src1])
		var b uint64 = cast(uint64, regs[instr.Src2])
		if a <= b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_UGT:
		var a uint64 = cast(uint64, regs[instr.Src1])
		var b uint64 = cast(uint64, regs[instr.Src2])
		if a > b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_UGE:
		var a uint64 = cast(uint64, regs[instr.Src1])
		var b uint64 = cast(uint64, regs[instr.Src2])
		if a >= b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true

	// Float64 comparison: ordered predicates — NaN → 0.  Float bits go
	// through int64 for the same host-portability reason as BC_FADD
	// above.
	case BC_FEQ:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		if a == b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_FNE:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		if a != b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_FLT:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		if a < b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_FLE:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		if a <= b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_FGT:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		if a > b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_FGE:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		if a >= b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	}
	return false
}

// execUnaryOp handles unary arithmetic / logical ops (BC_NEG,
// BC_NOT, BC_BITNOT) and float negation (BC_FNEG).
func execUnaryOp(regs *int, instr BCInstr) bool {
	switch instr.Op {
	case BC_NEG:
		regs[instr.Dst] = 0 - regs[instr.Src1]
		return true
	case BC_NOT:
		if regs[instr.Src1] == 0 { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_BITNOT:
		regs[instr.Dst] = regs[instr.Src1] ^ -1
		return true
	case BC_FNEG:
		var x float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		regs[instr.Dst] = cast(int, bit_cast(int64, 0.0 - x))
		return true
	}
	return false
}
