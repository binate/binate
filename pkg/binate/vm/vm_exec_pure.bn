package "pkg/binate/vm"

// Pure register-only bytecode handlers — arithmetic, comparison,
// and unary ops that read/write `regs` but don't touch execLoop's
// control state (pc, funcIdx, f, code, regsOff, frameBase,
// freeOnPop). Hoisted out of vm_exec.bn so the execLoop dispatch
// stays focused on control-flow handlers and the file stays under
// the file-length cap. Memory ops live in execMemoryOp in
// vm_exec_helpers.bn (a separate extraction).
//
// Each helper returns true if the dispatch was handled (caller
// `continue`s) and false otherwise (caller falls through).

// execArithOp handles integer arithmetic (BC_ADD..BC_LSHR), float64
// arithmetic (BC_FADD..BC_FDIV), and float32 arithmetic (BC_F32ADD..
// BC_F32DIV). All ops read two register operands and write one
// register destination.
func execArithOp(regs *int, instr BCInstr) bool {
	if execIntArithOp(regs, instr) {
		applyNarrow(regs, instr)
		return true
	}
	return execFloatArithOp(regs, instr)
}

// applyNarrow re-narrows regs[Dst] to the sub-word result width the lowerer
// recorded: Imm holds the result width in bits (0 = host-word-wide, no narrow);
// Aux selects sign-extend (1) vs zero-extend (0).  The integer ops compute at
// host width, so without this an int8/16/32 (or uint8/16/32) result would carry
// dirty upper bits into a later shift, unsigned compare, division, or widening
// read.  Shared by the arithmetic and unary paths so the narrow can't drift
// between them; the lowerer sets Imm/Aux via common.SubWordNarrow.
func applyNarrow(regs *int, instr BCInstr) {
	if instr.Imm > 0 {
		regs[instr.Dst] = narrowToWidth(regs[instr.Dst], instr.Imm, instr.Aux == 1)
	}
}

// execIntArithOp handles integer arithmetic (BC_ADD..BC_LSHR) at host
// width; the caller re-narrows the result to its type width.
func execIntArithOp(regs *int, instr BCInstr) bool {
	switch instr.Op {
	case BC_ADD: regs[instr.Dst] = regs[instr.Src1] + regs[instr.Src2]; return true
	case BC_SUB: regs[instr.Dst] = regs[instr.Src1] - regs[instr.Src2]; return true
	case BC_MUL: regs[instr.Dst] = regs[instr.Src1] * regs[instr.Src2]; return true
	case BC_DIV: regs[instr.Dst] = regs[instr.Src1] / regs[instr.Src2]; return true
	case BC_REM: regs[instr.Dst] = regs[instr.Src1] % regs[instr.Src2]; return true
	case BC_UDIV:
		// zeroExtendHostWord, not cast(uint64, …): on a host whose word is < 8
		// bytes a uint whose top host-word bit is set fills the signed `int`
		// slot and reads back negative, so a plain cast(uint64, …) SIGN-extends
		// it (0x…80000000 → 0xFFFFFFFF80000000) and the division sees a huge
		// wrong magnitude.  On a 64-bit host the slot is already zero-extended so
		// this is a no-op.  Same reasoning for BC_UREM / BC_LSHR below.
		var a uint64 = zeroExtendHostWord(regs[instr.Src1], REG_SLOT)
		var b uint64 = zeroExtendHostWord(regs[instr.Src2], REG_SLOT)
		regs[instr.Dst] = cast(int, a / b)
		return true
	case BC_UREM:
		var a uint64 = zeroExtendHostWord(regs[instr.Src1], REG_SLOT)
		var b uint64 = zeroExtendHostWord(regs[instr.Src2], REG_SLOT)
		regs[instr.Dst] = cast(int, a % b)
		return true
	case BC_AND: regs[instr.Dst] = regs[instr.Src1] & regs[instr.Src2]; return true
	case BC_OR:  regs[instr.Dst] = regs[instr.Src1] | regs[instr.Src2]; return true
	case BC_XOR: regs[instr.Dst] = regs[instr.Src1] ^ regs[instr.Src2]; return true
	case BC_SHL: regs[instr.Dst] = regs[instr.Src1] << regs[instr.Src2]; return true
	case BC_SHR: regs[instr.Dst] = regs[instr.Src1] >> regs[instr.Src2]; return true
	case BC_LSHR:
		// Logical (zero-filling) shift: the value operand must be zero-extended
		// from the host word (see BC_UDIV) or a set top bit sign-fills the shift
		// on an ILP32 host, turning e.g. 0x80000000 >> 1 into 0xC0000000 instead
		// of 0x40000000.  The count needs no such care (always small, positive).
		var a uint64 = zeroExtendHostWord(regs[instr.Src1], REG_SLOT)
		var n uint64 = cast(uint64, regs[instr.Src2])
		regs[instr.Dst] = cast(int, a >> n)
		return true
	}
	return false
}

// execFloatArithOp handles float64 arithmetic (BC_FADD..BC_FDIV).
func execFloatArithOp(regs *int, instr BCInstr) bool {
	switch instr.Op {
	// Float64 arithmetic. Operands bit-cast through int registers;
	// arithmetic is always at float64 precision.  The float64 bits ride
	// through int64 (not host-int) so the bit_cast is always 64↔64 —
	// portable across hosts whose word is smaller than 8 bytes, where
	// `bit_cast(int, float64)` would be a size mismatch.  On a 64-bit
	// host the cast(int64, int) / cast(int, int64) hops are identities;
	// on a 32-bit host the BC_F* opcodes are dead path (lowering emits
	// BC_F*64 pair ops there) — these handlers stay compile-clean.
	case BC_FADD:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		regs[instr.Dst] = cast(int, bit_cast(int64, a + b))
		return true
	case BC_FSUB:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		regs[instr.Dst] = cast(int, bit_cast(int64, a - b))
		return true
	case BC_FMUL:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		regs[instr.Dst] = cast(int, bit_cast(int64, a * b))
		return true
	case BC_FDIV:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		regs[instr.Dst] = cast(int, bit_cast(int64, a / b))
		return true
	// Float32 arithmetic at single precision: the operand f32 bits sit in
	// the low 4 bytes of the register; compute as float32 and store the
	// f32 result bits back (zero-extended).  Doing this at float64 on the
	// raw f32 bit pattern would reinterpret it as a garbage double.
	case BC_F32ADD:
		var a float32 = bit_cast(float32, cast(uint32, regs[instr.Src1]))
		var b float32 = bit_cast(float32, cast(uint32, regs[instr.Src2]))
		regs[instr.Dst] = cast(int, bit_cast(uint32, a + b))
		return true
	case BC_F32SUB:
		var a float32 = bit_cast(float32, cast(uint32, regs[instr.Src1]))
		var b float32 = bit_cast(float32, cast(uint32, regs[instr.Src2]))
		regs[instr.Dst] = cast(int, bit_cast(uint32, a - b))
		return true
	case BC_F32MUL:
		var a float32 = bit_cast(float32, cast(uint32, regs[instr.Src1]))
		var b float32 = bit_cast(float32, cast(uint32, regs[instr.Src2]))
		regs[instr.Dst] = cast(int, bit_cast(uint32, a * b))
		return true
	case BC_F32DIV:
		var a float32 = bit_cast(float32, cast(uint32, regs[instr.Src1]))
		var b float32 = bit_cast(float32, cast(uint32, regs[instr.Src2]))
		regs[instr.Dst] = cast(int, bit_cast(uint32, a / b))
		return true
	}
	return false
}

// execCmpOp handles integer comparison (BC_EQ..BC_SGE) and
// float64 comparison (BC_FEQ..BC_FGE). Result is 0 or 1 in the
// destination register.
func execCmpOp(regs *int, instr BCInstr) bool {
	switch instr.Op {
	case BC_EQ:
		if regs[instr.Src1] == regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_NE:
		if regs[instr.Src1] != regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_SLT:
		if regs[instr.Src1] < regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_SLE:
		if regs[instr.Src1] <= regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_SGT:
		if regs[instr.Src1] > regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_SGE:
		if regs[instr.Src1] >= regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true

	// Unsigned integer comparison: reinterpret the int register
	// bits as uint64 first (Binate's `<` / `<=` / `>` / `>=` on
	// uint64 is unsigned, which is what we need).
	case BC_ULT:
		var a uint64 = cast(uint64, regs[instr.Src1])
		var b uint64 = cast(uint64, regs[instr.Src2])
		if a < b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_ULE:
		var a uint64 = cast(uint64, regs[instr.Src1])
		var b uint64 = cast(uint64, regs[instr.Src2])
		if a <= b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_UGT:
		var a uint64 = cast(uint64, regs[instr.Src1])
		var b uint64 = cast(uint64, regs[instr.Src2])
		if a > b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_UGE:
		var a uint64 = cast(uint64, regs[instr.Src1])
		var b uint64 = cast(uint64, regs[instr.Src2])
		if a >= b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true

	// Float64 comparison: ordered predicates — NaN → 0.  Float bits go
	// through int64 for the same host-portability reason as BC_FADD
	// above.
	case BC_FEQ:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		if a == b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_FNE:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		if a != b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_FLT:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		if a < b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_FLE:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		if a <= b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_FGT:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		if a > b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_FGE:
		var a float64 = bit_cast(float64, cast(int64, regs[instr.Src1]))
		var b float64 = bit_cast(float64, cast(int64, regs[instr.Src2]))
		if a >= b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	// Float32 comparison at single precision: the operand f32 bits are in
	// the low 4 bytes; comparing them as float64 (the BC_F* cases above)
	// would reinterpret the bits as a garbage double — e.g. a negative
	// float32 becomes a large positive double, flipping the order.
	case BC_F32EQ:
		var a float32 = bit_cast(float32, cast(uint32, regs[instr.Src1]))
		var b float32 = bit_cast(float32, cast(uint32, regs[instr.Src2]))
		if a == b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_F32NE:
		var a float32 = bit_cast(float32, cast(uint32, regs[instr.Src1]))
		var b float32 = bit_cast(float32, cast(uint32, regs[instr.Src2]))
		if a != b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_F32LT:
		var a float32 = bit_cast(float32, cast(uint32, regs[instr.Src1]))
		var b float32 = bit_cast(float32, cast(uint32, regs[instr.Src2]))
		if a < b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_F32LE:
		var a float32 = bit_cast(float32, cast(uint32, regs[instr.Src1]))
		var b float32 = bit_cast(float32, cast(uint32, regs[instr.Src2]))
		if a <= b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_F32GT:
		var a float32 = bit_cast(float32, cast(uint32, regs[instr.Src1]))
		var b float32 = bit_cast(float32, cast(uint32, regs[instr.Src2]))
		if a > b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_F32GE:
		var a float32 = bit_cast(float32, cast(uint32, regs[instr.Src1]))
		var b float32 = bit_cast(float32, cast(uint32, regs[instr.Src2]))
		if a >= b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	}
	return false
}

// execUnaryOp handles unary arithmetic / logical ops (BC_NEG,
// BC_NOT, BC_BITNOT) and float negation (BC_FNEG).
func execUnaryOp(regs *int, instr BCInstr) bool {
	switch instr.Op {
	case BC_NEG:
		regs[instr.Dst] = 0 - regs[instr.Src1]
		applyNarrow(regs, instr)
		return true
	case BC_NOT:
		if regs[instr.Src1] == 0 { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	case BC_BITNOT:
		regs[instr.Dst] = regs[instr.Src1] ^ -1
		applyNarrow(regs, instr)
		return true
	case BC_FNEG:
		// IEEE negate is a sign-bit flip; for float64 that's bit 63.  `0.0 - x`
		// is a different function — under round-to-nearest it maps -0.0 to +0.0,
		// dropping the sign of a zero.  Compiled mode flips the bit, so computing
		// the negation as a subtraction here would make the two modes disagree
		// on ±0.  Sign mask is `cast(int64, 1) << 63` (the x64/arm32 backends'
		// idiom), not the untyped `1 << 63`.
		regs[instr.Dst] = cast(int, cast(int64, regs[instr.Src1]) ^ (cast(int64, 1) << 63))
		return true
	case BC_F32NEG:
		// IEEE negate is a sign-bit flip; for float32 that's bit 31 of the
		// pattern in the low 4 bytes.  A float64 FNEG would flip bit 63 and
		// leave the f32 sign untouched.
		regs[instr.Dst] = cast(int, cast(uint32, regs[instr.Src1]) ^
				(cast(uint32, 1) << cast(uint32, 31)))
		return true
	}
	return false
}
