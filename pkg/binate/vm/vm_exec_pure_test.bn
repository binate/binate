package "pkg/binate/vm"

import "pkg/builtins/testing"

// Coverage for vm_exec_pure.bn: execArithOp / execCmpOp /
// execUnaryOp. Each helper covers a family of opcodes; testing one
// representative per family with end-to-end compileAndRun is enough
// to catch dispatch-table regressions (e.g. a misnamed BC_op
// constant after extraction). The full op surface is exercised by
// the conformance suite — these targeted tests just pin the
// helpers' opcodes against the loop's `if execXxx { continue }`
// dispatch order. `compileAndRun` and `concatStr` live in
// vm_test.bn.

// execArithOp — integer arithmetic (BC_ADD).
func TestVMExecArithIntAdd() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  return 13 + 29\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 42 { return "expected 42" }
	return ""
}

// execArithOp — integer division (BC_DIV) — non-trivial bit
// pattern in case the helper somehow swaps Src1 / Src2 ordering.
func TestVMExecArithIntDiv() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  return 100 / 4\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 25 { return "expected 25" }
	return ""
}

// execArithOp — float64 arithmetic (BC_FADD). Bit-cast through int
// regs is the part most likely to break in a refactor.
func TestVMExecArithFloatAdd() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var a float64 = 1.5\n")
	src = concatStr(src, "  var b float64 = 2.5\n")
	src = concatStr(src, "  return cast(int, a + b)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 4 { return "expected 4" }
	return ""
}

// execCmpOp — integer comparison (BC_SLT). Comparison helpers
// produce 0/1 in dst; condition flowing into a `return ... else ...`
// branch confirms the result is observable.
func TestVMExecCmpIntLT() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  if 3 < 5 { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 1 { return "expected 1" }
	return ""
}

// execCmpOp — float64 ordered comparison (BC_FGT).
func TestVMExecCmpFloatGT() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var a float64 = 2.0\n")
	src = concatStr(src, "  var b float64 = 1.0\n")
	src = concatStr(src, "  if a > b { return 7 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 7 { return "expected 7" }
	return ""
}

// execUnaryOp — integer negation (BC_NEG).
func TestVMExecUnaryIntNeg() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x int = 17\n")
	src = concatStr(src, "  var y int = -x\n")
	src = concatStr(src, "  return y + 20\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 3 { return "expected 3" }
	return ""
}

// execUnaryOp — bitwise complement (BC_BITNOT). ~5 = -6.
func TestVMExecUnaryBitNot() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x int = 5\n")
	src = concatStr(src, "  return ~x\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != -6 { return "expected -6" }
	return ""
}
