package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/builtins/rt"

// execRefDecZeroDtor runs the COLD path of BC_REFDEC_INLINE_FAST — reached only
// when an inline RefDec drops a managed pointer's refcount to zero — dispatching
// its destructor.  Factored out of execLoop's hot dispatch (the nil-check +
// immortal-check + fast decrement stay inline there) so the loop body stays under
// the file-length cap; the zero-refcount path is cold (most RefDecs don't free),
// so the extra call is off the hot path.  `dtorHandle` is the op's Src2 func-value
// handle (0 = no dtor).
//
// Returns (newFuncIdx, newRegsOff, pushed).  A VM-side destructor is run by
// PUSHING its frame and returning pushed=true, so the caller switches execLoop's
// frame locals to it — BC_RETURN then pops the frame and frees `ptr` via
// freeOnPop, so there is NO host C-stack recursion through the dtor field graph
// (which is what blows the host stack at -int-int depths).  A no-dtor free, an
// immortal / still-live closure struct, and the cross-mode hand-off all release
// inline and return pushed=false (the caller simply continues).
//
// A VM/closure dtor enters its cleanup context (CleanupDepth++) BEFORE the push
// (§6): pushFrame then gives it the FULL stack (the red zone), and a cascade
// deeper than the whole stack overflows with CleanupDepth > 0 → fatal, not a
// second unwind.  The pop (BC_RETURN with freeOnPop != 0) balances it.
func execRefDecZeroDtor(vm @VM, ptr *uint8, dtorHandle int, pc int, funcIdx int,
		regsOff int) (int, int, bool) {
	if dtorHandle == compiledClosureDtorMark {
		// ptr is a capturing closure's COMPILED_CLOSURE record (only IsClosure
		// callees mark their vtable dtor slot with the sentinel).  The rec owns the
		// heap closure struct at rec[3]; func-value copies RefInc/RefDec the rec, not
		// the struct, so the struct sits at refcount 1 and must be released now (the
		// last copy is dying) or it and its captured managed values leak.  Free the
		// rec, then RefDec the struct; at zero run its dtor (a frame push, like the
		// VM_CLOSURE_REC arm below) so captures are released and the struct freed.
		var ccRec *int = bit_cast(*int, ptr)
		var csAddr int = ccRec[3]
		var ccFnIdx int = ccRec[2]
		rt.Free(ptr)
		if csAddr == 0 { return funcIdx, regsOff, false }
		var csHd *int = bit_cast(*int, csAddr - MANAGED_HDR)
		if csHd[0] < 0 { return funcIdx, regsOff, false } // immortal closure struct
		csHd[0] = csHd[0] - 1
		if csHd[0] != 0 { return funcIdx, regsOff, false }
		var ccFunc @VMFunc = vm.Funcs.Get(ccFnIdx - 1)
		if len(ccFunc.ClosureStructDtorName) == 0 {
			// No managed captures: just free the struct.
			rt.Free(bit_cast(*uint8, csAddr))
			return funcIdx, regsOff, false
		}
		var dIdx int = vm.LookupFunc(ccFunc.ClosureStructDtorName)
		if dIdx < 0 {
			vmPanic("vm: closure-struct dtor not found")
		}
		var ccDtor @VMFunc = vm.Funcs.Get(dIdx)
		vm.CleanupDepth = vm.CleanupDepth + 1
		var ccRegsOff int = pushFrame(vm, ccDtor, pc, funcIdx, regsOff, vm.SP, -1)
		var ccHdr *int = stackPtr(vm, ccRegsOff - FRAME_HDR)
		ccHdr[5] = csAddr
		var ccRegs *int = stackPtr(vm, ccRegsOff)
		ccRegs[0] = csAddr
		return dIdx, ccRegsOff, true
	}
	if dtorHandle == 0 {
		rt.Free(ptr)
		return funcIdx, regsOff, false
	}
	var handlePtr *int = bit_cast(*int, dtorHandle)
	var dataAddr int = handlePtr[types.FuncValueDataIndex()]
	if dataAddr != 0 {
		var closureRec *int = bit_cast(*int, dataAddr)
		if closureRec[0] == rt.DATA_KIND_VM_CLOSURE_REC {
			var fnIdx int = closureRec[2]
			if fnIdx == 0 {
				vmPanic("vm: BC_REFDEC dtor closure rec has nil func_idx")
			}
			var dtorFunc @VMFunc = vm.Funcs.Get(fnIdx - 1)
			vm.CleanupDepth = vm.CleanupDepth + 1
			var newRegsOff int = pushFrame(vm, dtorFunc, pc, funcIdx, regsOff, vm.SP, -1)
			var newHdr *int = stackPtr(vm, newRegsOff - FRAME_HDR)
			newHdr[5] = bit_cast(int, ptr)
			var newRegs *int = stackPtr(vm, newRegsOff)
			newRegs[0] = bit_cast(int, ptr)
			return fnIdx - 1, newRegsOff, true
		}
	}
	refDecCrossModeDispatch(handlePtr[types.FuncValueVtableIndex()], dataAddr, ptr)
	return funcIdx, regsOff, false
}
