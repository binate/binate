package "pkg/binate/vm"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// execRefDecZeroDtor's no-dtor path (dtorHandle == 0): the block is freed via
// rt.Free and nothing is pushed, so the caller's frame locals pass through
// unchanged (funcIdx, regsOff) with pushed == false.  This is the isolated unit
// coverage for the cold RefDec-zero path; the destructor-PUSH paths (VM-closure
// rec and capturing-closure struct) are exercised end-to-end by the leak / fault
// suites (leak_test.bn, vm_inline_leak_test.bn, parallel_assign_fault_test.bn),
// which fail loudly on a leak or double-free if the extraction dropped a RefDec.
func TestExecRefDecZeroDtorNoDtorFrees() testing.TestResult {
	var vm @VM = newTestVM(testVMStackSize)
	var base int = rt.LiveBlocks()
	var ptr *uint8 = rt.Alloc(8)
	if rt.LiveBlocks() != base + 1 {
		return "rt.Alloc should have added one live block"
	}
	// dtorHandle 0 = no destructor: execRefDecZeroDtor frees the block and returns
	// the caller's frame locals unchanged, pushed == false.  pc/funcIdx/regsOff are
	// arbitrary sentinels — the no-dtor path never touches them beyond echoing the
	// two it returns.
	var nfi int = 0
	var nro int = 0
	var pushed bool = true
	nfi, nro, pushed = execRefDecZeroDtor(vm, ptr, 0, 3, 5, 7)
	if pushed {
		return "the no-dtor path must not push a destructor frame"
	}
	if nfi != 5 || nro != 7 {
		return "the no-dtor path must return the caller's funcIdx / regsOff unchanged"
	}
	if rt.LiveBlocks() != base {
		return "the no-dtor path must free the block (live count back to baseline)"
	}
	return ""
}
