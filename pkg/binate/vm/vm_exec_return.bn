package "pkg/binate/vm"

import "pkg/builtins/rt"

// packMultiReturn handles BC_RETURN's multi-return packing path:
// write the caller's return values inline at the offsets matching
// the anonymous result-struct layout (f.ResultSizes / ResultOffsets),
// push the packed struct onto vm.Stack at vm.SP, and return its base
// address + total byte size so execLoop's caller-frame logic can
// memcpy it back into caller space.
//
// Layer 2 step 2b: pair-aware.  A 64-bit scalar (size 8, non-multi-
// word) on a host whose word is < 8 bytes occupies a register pair,
// so the source-register index advances by the value's actual slot
// width (srcSlot) rather than by the result-index i.  Aggregates
// (ResultMultiWord) carry a pointer in one slot regardless.
//
// Extracted from vm_exec.bn's BC_RETURN handler.  Pure of execLoop's
// control state (pc / funcIdx / code / regsOff / frameBase): only
// vm.SP and vm.Stack are written, which the caller already owns.
// Returns (retVal, copySize): retVal is the packed struct's address
// on vm.Stack; copySize is the totalSize rounded up to 8 (so the
// caller-frame memcpy-back size matches what was pushed here).
func packMultiReturn(vm @VM, regs *int, instr BCInstr, f @VMFunc) (int, int) {
	var sbase int = bit_cast(int, vm.Stack)
	var dstBase int = sbase + vm.SP
	var totalSize int = 0
	var srcSlot int = 0
	for i := 0; i < instr.Imm; i++ {
		var sz int = f.ResultSizes[i]
		var off int = f.ResultOffsets[i]
		// Pair-vs-single decision per slot.
		var isPair bool = sz == 8 && !f.ResultMultiWord[i] && REG_SLOT < 8
		if f.ResultMultiWord[i] {
			var srcVal int = regs[instr.Src1 + srcSlot]
			rt.MemCopy(
					bit_cast(*uint8, dstBase + off), bit_cast(*uint8, srcVal), sz)
			srcSlot = srcSlot + 1
		} else if isPair {
			// Write 8 bytes from the source pair into the result
			// struct at its byte offset, using *uint32 indexing so
			// the layout matches the target's little-endian 8-byte
			// scalar (lo at off, hi at off+4).
			var p *uint32 = bit_cast(*uint32, dstBase + off)
			p[0] = cast(uint32, regs[instr.Src1 + srcSlot])
			p[1] = cast(uint32, regs[instr.Src1 + srcSlot + 1])
			srcSlot = srcSlot + 2
		} else {
			var p *int = bit_cast(*int, dstBase + off)
			p[0] = regs[instr.Src1 + srcSlot]
			srcSlot = srcSlot + 1
		}
		if off + sz > totalSize {
			totalSize = off + sz
		}
	}
	// Align total size to 8 — the caller-frame memcpy-back stride
	// rounds to 8-byte words.
	totalSize = (totalSize + 7) / 8 * 8
	vm.SP = vm.SP + totalSize
	return dstBase, totalSize
}
