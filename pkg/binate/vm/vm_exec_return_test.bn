package "pkg/binate/vm"

import "pkg/builtins/testing"

// End-to-end coverage of packMultiReturn (vm_exec_return.bn), driven
// through compileAndRun so the full BC_RETURN packing path executes.
// Tests focus on the shapes packMultiReturn discriminates:
//   - all-scalar multi-return (one slot per value)
//   - mixed-size values exercising the per-value offset / size path
// The pair (64-bit-scalar on a 32-bit-host) path is dead on the
// 64-bit host these tests run on; that path is end-to-end exercised
// by conformance under arm32 once pkg/binate/vm's LLVM codegen unblocks.

// Two-scalar multi-return: caller unpacks both and folds them into a
// single int.  Exercises ResultSizes={8,8}, no pair, no multi-word.
func TestPackMultiReturnTwoScalars() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func twoReturns() (int, int) {\n")
	src = concatStr(src, "  return 5, 7\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var a int\n")
	src = concatStr(src, "  var b int\n")
	src = concatStr(src, "  a, b = twoReturns()\n")
	src = concatStr(src, "  return a * 10 + b\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 57 { return "expected 57" }
	return ""
}

// Three-scalar multi-return covers the inner loop running > 2
// iterations and the per-iteration totalSize / srcSlot advance.
func TestPackMultiReturnThreeScalars() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func threeReturns() (int, int, int) {\n")
	src = concatStr(src, "  return 1, 2, 3\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var a int\n")
	src = concatStr(src, "  var b int\n")
	src = concatStr(src, "  var c int\n")
	src = concatStr(src, "  a, b, c = threeReturns()\n")
	src = concatStr(src, "  return a * 100 + b * 10 + c\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 123 { return "expected 123" }
	return ""
}
