package "pkg/binate/vm"

import "pkg/builtins/testing"

// execStringOp (vm_exec_string.bn) handles the string-materializing opcodes
// BC_LOAD_STR / BC_STRING_COPY_MS / BC_STRING_COPY_ARR.  These run the compiled
// program end to end via compileAndRun (shared with vm_test.bn) rather than
// hand-building BCInstrs, since the interesting behavior is the header/backing
// each op pushes onto vm.SP and how the loaded value reads back.

// BC_LOAD_STR: a string-literal read yields a stable @[]char header, so len()
// and an indexed byte both resolve.  "hi" → len 2 + 'h'(104) = 106.
func TestExecStringOpLoadStr() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func main() int {\n"
			"\tvar s *[]readonly char = \"hi\"\n"
			"\treturn len(s) + cast(int, s[0]) }\n"
	if compileAndRun(src) != 106 {
		return "BC_LOAD_STR program should return len(\"hi\")=2 + 'h'(104) = 106"
	}
	return ""
}

// BC_STRING_COPY_ARR: a composite literal copies a string into a fixed [N]char
// field.  W{arr: "xy"} then reads arr[1] = 'y'(121).
func TestExecStringOpCopyArr() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type W struct { arr [2]char }\n"
			"func main() int {\n"
			"\tvar w W = W{arr: \"xy\"}\n"
			"\treturn cast(int, w.arr[1]) }\n"
	if compileAndRun(src) != 121 {
		return "BC_STRING_COPY_ARR program should return w.arr[1] = 'y'(121)"
	}
	return ""
}
