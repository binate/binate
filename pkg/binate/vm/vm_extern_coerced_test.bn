package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Cross-mode dispatch of a NATIVE callee that takes a coerced-aggregate
// argument BY VALUE and returns a sub-word (bool) — the two residuals of the
// by-address coerced-agg func-value ABI (binate 233cc82d) that conformance
// 937/938 don't reach: those are bytecode->bytecode and return int32, so they
// never exercise (a) a real NATIVE shim re-coercing a by-value aggregate arg,
// nor (b) the sub-word/bool RETURN canonicalization on the cross-mode path.
//
// The struct arg is produced by a WORKING native struct-return extern (mkPair /
// mkWide — the return side is covered by TestExternSmallStructAggregateDispatch)
// and fed straight into the by-value-arg extern, so the aggregate lives at a
// real frame address the by-address dispatch passes as one slot; the callee's
// shim re-coerces it.  Pair is 8 bytes (one coerced register); Wide is 16 bytes
// (two coerced registers — `A == B` checks a field in each survives).  The bool
// return exercises the sub-word narrow: the native ABI leaves bits above the low
// byte undefined, so the VM (reading the shim's return as a full word) must mask
// to 0/1 (BC_ZEXT width 8, emitted for OP_CALL_FUNC_VALUE / OP_CALL alike).
//
// The interface-method path (dispatchCompiledIfaceMethod) packs each user arg as
// ONE raw slot and narrows the return through the SAME shared code, but its
// native @__ivtshim cannot be hand-forged at the unit level (the point of the
// shim design), so this func-value / direct fixture is its representative unit
// coverage; the iface path's end-to-end lives in the conformance suite.

type Wide struct {
	A int
	B int
}

func mkWide(a int, b int) Wide {
	var w Wide
	w.A = a
	w.B = b
	return w
}

// pairEq / wideEq take the aggregate BY VALUE (coerced into 1 / 2 registers by
// the shim) and return whether the two fields are equal.
func pairEq(p Pair) bool {
	return p.A == p.B
}

func wideEq(w Wide) bool {
	return w.A == w.B
}

// pairAggType / wideAggType rebuild the struct types for the hand-built IR.
func pairAggType() @types.Type {
	var fa @types.Field = make(types.Field)
	fa.Name = "A"
	fa.Type = types.TypInt32()
	var fb @types.Field = make(types.Field)
	fb.Name = "B"
	fb.Type = types.TypInt32()
	var pf @[]@types.Field = make_slice(@types.Field, 2)
	pf[0] = fa
	pf[1] = fb
	return types.MakeStructType("Pair", pf)
}

func wideAggType() @types.Type {
	var fa @types.Field = make(types.Field)
	fa.Name = "A"
	fa.Type = types.TypInt()
	var fb @types.Field = make(types.Field)
	fb.Name = "B"
	fb.Type = types.TypInt()
	var wf @[]@types.Field = make_slice(@types.Field, 2)
	wf[0] = fa
	wf[1] = fb
	return types.MakeStructType("Wide", wf)
}

// runEqDispatch builds `func main() bool { var s = mkFn(a, b); return
// <fv|direct>(eqFn)(s) }`, registers the struct-return `mkFn` (retbuf) and the
// by-value-arg `eqFn` (scalar/bool) as native externs, lowers, and runs it —
// returning the raw bool result slot (0 or 1 iff the sub-word return was
// canonicalized).  `mkName`/`eqName` are the qualified extern names; `structTyp`
// is the aggregate type; `mkRetbuf` its retbuf byte size.
func runEqDispatch(a int, b int, viaFuncValue bool, structTyp @types.Type,
		mkName @[]char, eqName @[]char, mkRetbuf int, mkFvAddr *uint8,
		mkRawAddr int, eqFvAddr *uint8, eqRawAddr int) int {
	var m @ir.Module = ir.NewModule("\"test\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypBool()
	var fn @ir.Func = ir.NewFunc("", "main", noParams, results)
	var entry @ir.Block = ir.AddBlock(fn, "entry")

	// var s = mkFn(a, b)  — an aggregate materialized in the frame.
	var mkArgs @[]@ir.Instr = make_slice(@ir.Instr, 2)
	mkArgs[0] = entry.EmitConstInt(a, types.TypInt())
	mkArgs[1] = entry.EmitConstInt(b, types.TypInt())
	var s @ir.Instr = entry.EmitCall(mkName, mkArgs, structTyp)

	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = s
	var call @ir.Instr
	if viaFuncValue {
		var params @[]@types.Param = make_slice(@types.Param, 1)
		var p0 @types.Param = make(types.Param)
		p0.Type = structTyp
		params[0] = p0
		var fvResults @[]@types.Type = make_slice(@types.Type, 1)
		fvResults[0] = types.TypBool()
		var fvTyp @types.Type = types.MakeFuncValueType(params, fvResults)
		var fvInstr @ir.Instr = entry.EmitFuncValue(eqName, fvTyp)
		call = entry.EmitCallFuncValue(fvInstr, args, types.TypBool())
	} else {
		call = entry.EmitCall(eqName, args, types.TypBool())
	}
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = call
	entry.EmitReturn(retArgs)
	m.AddFunc(fn)

	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.RegisterExtern(mkName, mkFvAddr, mkRetbuf, mkRawAddr)
	vm.RegisterExtern(eqName, eqFvAddr, 0, eqRawAddr)
	vm.LowerModule(m)
	var idx int = vm.LookupFunc("test.main")
	if idx < 0 { return -1 }
	var noArgs @[]int
	return cast(int, execFunc(vm, idx, noArgs))
}

func runPairEq(a int, b int, viaFuncValue bool) int {
	var mfv *func(int, int) Pair = mkPair
	var efv *func(Pair) bool = pairEq
	return runEqDispatch(a, b, viaFuncValue, pairAggType(),
		"test.mkPair", "test.pairEq", 8,
		bit_cast(*uint8, &mfv), bit_cast(int, _raw_func_addr(mkPair)),
		bit_cast(*uint8, &efv), bit_cast(int, _raw_func_addr(pairEq)))
}

func runWideEq(a int, b int, viaFuncValue bool) int {
	var mfv *func(int, int) Wide = mkWide
	var efv *func(Wide) bool = wideEq
	var wt @types.Type = wideAggType()
	var wres @[]@types.Type = make_slice(@types.Type, 1)
	wres[0] = wt
	return runEqDispatch(a, b, viaFuncValue, wt,
		"test.mkWide", "test.wideEq", types.AggregateReturnSize(wres),
		bit_cast(*uint8, &mfv), bit_cast(int, _raw_func_addr(mkWide)),
		bit_cast(*uint8, &efv), bit_cast(int, _raw_func_addr(wideEq)))
}

// FUNC-VALUE dispatch (dispatchCompiledFuncValue): a coerced-agg arg by value +
// a bool return, one register (Pair) and two registers (Wide).
//
// Skipped in the VM (double-VM) modes — scripts/unittest/pkg-binate-vm.skip.
// builder-comp-int{,-comp-int}.  This test builds an INNER vm.VM and dispatches
// `pairEq`/`wideEq` as a compiled-side FUNCTION VALUE (`efv = pairEq`).  That is
// meaningful only when this test is COMPILED: `efv` is then a native
// (data==null) func value the inner VM dispatches through vtable.call.  When the
// test is itself INTERPRETED, `efv` is an OUTER-VM bytecode func value (its data
// points to an outer-VM closure rec), so the inner VM takes the VM-side path and
// reads an outer-VM vm_func_idx that is out of range in the inner VM ("function-
// value call: idx out of range").  The DIRECT-extern variant below has no such
// issue (extern dispatch works interpreted), so it is NOT skipped.
func TestFuncValueCoercedAggArgSubWordReturn() testing.TestResult {
	if runPairEq(5, 5, true) != 1 { return "fv Pair{5,5} should be true (1)" }
	if runPairEq(5, 9, true) != 0 { return "fv Pair{5,9} should be false (0)" }
	if runWideEq(7, 7, true) != 1 { return "fv Wide{7,7} should be true (1)" }
	if runWideEq(7, 3, true) != 0 { return "fv Wide{7,3} should be false (0)" }
	return ""
}

// DIRECT extern OP_CALL (dispatchExternBinding): the same coerced-agg arg +
// sub-word return through the other cross-mode dispatcher.
func TestDirectExternCoercedAggArgSubWordReturn() testing.TestResult {
	if runPairEq(8, 8, false) != 1 { return "direct Pair{8,8} should be true (1)" }
	if runPairEq(8, 2, false) != 0 { return "direct Pair{8,2} should be false (0)" }
	if runWideEq(4, 4, false) != 1 { return "direct Wide{4,4} should be true (1)" }
	if runWideEq(4, 6, false) != 0 { return "direct Wide{4,6} should be false (0)" }
	return ""
}
