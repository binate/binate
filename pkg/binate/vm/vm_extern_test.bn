package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/iropcode"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for extern dispatch and builtin handling (vm_extern.bn).
// Uses compileAndRun from vm_test.bn.

func TestExternPrintString() testing.TestResult {
	// print_string should produce output without crashing.
	// (Was TestExternPrintInt; switched to println of a string
	// because println(int) now lowers to bootstrap.formatInt +
	// bootstrap.Write — both are Binate functions in pkg/bootstrap,
	// which compileAndRun doesn't load. The string path still uses
	// the bn_print_string extern dispatch this test exercises.)
	var result int = compileAndRun(
			"package \"test\"\nfunc main() int {\n  println(\"hello\")\n  return 0\n}\n")
	if result != 0 { return "expected 0" }
	return ""
}

// Repro for ir.appendModuleConst loss-of-Name bug under builder-comp-int:
// struct contains a @[]char field. appendMC copy-grows a managed-slice
// element-by-element (`ns[i] = s[i]`). After several appends, earlier
// elements' @[]char field reads back as empty — backing was freed
// because struct-copy didn't RefInc the inner managed slice.
func TestRepro_StructWithManagedSliceFieldAppend() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "type Pair struct { Name @[]char; Val int }\n")
	src = concatStr(src, "func appendPair(s @[]Pair, v Pair) @[]Pair {\n")
	src = concatStr(src, "  var n int = len(s)\n")
	src = concatStr(src, "  var ns @[]Pair = make_slice(Pair, n + 1)\n")
	src = concatStr(src, "  for i := 0; i < n; i++ { ns[i] = s[i] }\n")
	src = concatStr(src, "  ns[n] = v\n")
	src = concatStr(src, "  return ns\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func mkName(c char) @[]char {\n")
	src = concatStr(src, "  var s @[]char = make_slice(char, 1)\n")
	src = concatStr(src, "  s[0] = c\n")
	src = concatStr(src, "  return s\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var s @[]Pair\n")
	src = concatStr(src, "  for i := 0; i < 3; i++ {\n")
	src = concatStr(src, "    var p Pair\n")
	src = concatStr(src, "    p.Name = mkName('A')\n")
	src = concatStr(src, "    p.Val = i\n")
	src = concatStr(src, "    s = appendPair(s, p)\n")
	src = concatStr(src, "  }\n")
	// All three Names should still be 1 char long; if the bug is
	// present, earlier ones will be empty (len == 0).
	src = concatStr(src, "  return len(s[0].Name) * 100 + len(s[1].Name) * 10 + len(s[2].Name)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 111 {
		return "Name fields lost during slice-element copy"
	}
	return ""
}

// vmTestFloatBits / vmTestFloatId are native (compiled into this test
// binary) functions with float64 signatures, registered as externs so
// the registry-dispatch tests below exercise a bytecode caller invoking
// a NATIVE float callee through the per-function shim (@__shim) — the
// exact shape the real bni host hits for bootstrap.formatFloat once
// bootstrap is native-only.  This is the one path the float-arg shim
// fix (plan-float-arg-shim.md) targets: it can't be reached by a user
// float func-value in -int (that's bytecode->bytecode via all-int VM
// slots).  Pre-fix these miscompiled in builder-comp / builder-comp-comp
// (the float bits sat in a GP register while the natural-typed shim
// read an FP register).
func vmTestFloatBits(x float64) int64 {
	return bit_cast(int64, x)
}

func vmTestFloatId(x float64) float64 {
	return x
}

// TestExternFloatArgViaRegistry: a bytecode caller passes a float64 arg
// to a native extern through the all-int dispatch.  Returning the arg's
// bit pattern pins the transfer bit-exactly.
func TestExternFloatArgViaRegistry() testing.TestResult {
	// func main() int64 { return vmTestFloatBits(<3.14>) }
	// Load 3.14's bits via an int64 const typed float64, so the slot
	// carries the exact pattern with no float-const parsing in the VM.
	var m @ir.Module = ir.NewModule("\"test\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt64()
	var fn @ir.Func = ir.NewFunc("", "main", noParams, results)
	var entry @ir.Block = ir.AddBlock(fn, "entry")
	// 3.14 -> 0x40091EB851EB851F = 4614253070214989087.
	var arg @ir.Instr = entry.EmitConstInt64(4614253070214989087, types.TypFloat64())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = arg
	var call @ir.Instr = entry.EmitCall("test.vmTestFloatBits", args, types.TypInt64())
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = call
	entry.EmitReturn(retArgs)
	m.AddFunc(fn)

	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	var fv *func(float64) int64 = vmTestFloatBits
	vm.RegisterExtern("test.vmTestFloatBits", bit_cast(*uint8, &fv), scalarResult,
			bit_cast(int, _func_handle(vmTestFloatBits)))
	vm.LowerModule(m)
	var idx int = vm.LookupFunc("test.main")
	if idx < 0 { return "test.main not found" }
	var noArgs @[]int
	var result int64 = execFunc(vm, idx, noArgs)
	if result != 4614253070214989087 {
		return "float arg to native extern miscompiled (GP/FP register mismatch)"
	}
	return ""
}

// TestExternFloatReturnViaRegistry: a native extern that takes AND
// returns a float64, called from bytecode.  execFunc returns the raw
// 64-bit slot, which for a float64 return is the IEEE bit pattern —
// it must round-trip exactly.  Exercises both float-arg and float-
// return int-ification through the shim.
func TestExternFloatReturnViaRegistry() testing.TestResult {
	// func main() float64 { return vmTestFloatId(<3.14>) }
	var m @ir.Module = ir.NewModule("\"test\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypFloat64()
	var fn @ir.Func = ir.NewFunc("", "main", noParams, results)
	var entry @ir.Block = ir.AddBlock(fn, "entry")
	var arg @ir.Instr = entry.EmitConstInt64(4614253070214989087, types.TypFloat64())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = arg
	var call @ir.Instr = entry.EmitCall("test.vmTestFloatId", args, types.TypFloat64())
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = call
	entry.EmitReturn(retArgs)
	m.AddFunc(fn)

	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	var fv *func(float64) float64 = vmTestFloatId
	vm.RegisterExtern("test.vmTestFloatId", bit_cast(*uint8, &fv), scalarResult,
			bit_cast(int, _func_handle(vmTestFloatId)))
	vm.LowerModule(m)
	var idx int = vm.LookupFunc("test.main")
	if idx < 0 { return "test.main not found" }
	var noArgs @[]int
	var result int64 = execFunc(vm, idx, noArgs)
	if result != 4614253070214989087 {
		return "float return from native extern miscompiled (GP/FP register mismatch)"
	}
	return ""
}

// TestExternInt64ReturnPairReadback: a native extern returning a bare int64
// (vmTestFloatBits: float64 -> int64), called from bytecode, must deliver the
// FULL 64-bit value to the caller.  The returned value is compared against the
// expected bits IN BYTECODE (a 64-bit OP_EQ over the register pair on ILP32;
// main returns the bool), so a low-word-only truncation of the cross-mode
// return is caught even where execFunc itself would narrow a 64-bit top-level
// result to one host word.  On ILP32 this exercises the scalar64 read-back
// (rt._call_shim_scalar64 + splitInt64 into the destination register pair); on
// LP64 the equivalent one-word path.  Blocking under builder-comp_arm32_linux.
func TestExternInt64ReturnPairReadback() testing.TestResult {
	// func main() bool { return vmTestFloatBits(<3.14 bits>) == <3.14 bits> }
	var m @ir.Module = ir.NewModule("\"test\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypBool()
	var fn @ir.Func = ir.NewFunc("", "main", noParams, results)
	var entry @ir.Block = ir.AddBlock(fn, "entry")
	var arg @ir.Instr = entry.EmitConstInt64(4614253070214989087, types.TypFloat64())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = arg
	var call @ir.Instr = entry.EmitCall("test.vmTestFloatBits", args, types.TypInt64())
	var expected @ir.Instr = entry.EmitConstInt64(4614253070214989087, types.TypInt64())
	var cmp @ir.Instr = entry.EmitBinop(iropcode.OP_EQ, call, expected, types.TypBool())
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = cmp
	entry.EmitReturn(retArgs)
	m.AddFunc(fn)

	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	var fv *func(float64) int64 = vmTestFloatBits
	vm.RegisterExtern("test.vmTestFloatBits", bit_cast(*uint8, &fv), scalarResult,
			bit_cast(int, _func_handle(vmTestFloatBits)))
	vm.LowerModule(m)
	var idx int = vm.LookupFunc("test.main")
	if idx < 0 { return "test.main not found" }
	var noArgs @[]int
	if execFunc(vm, idx, noArgs) != 1 {
		return "cross-mode int64 return truncated (in-bytecode 64-bit compare failed)"
	}
	return ""
}

// vmTestFloat32Bits exercises the float32 (i32 exact-width slot) path
// through native extern dispatch — the "sharp edge" where the slot
// width must equal the type width (never widen float32 into an i64
// slot).  Returns int64 to dodge int32 result truncation in execFunc.
func vmTestFloat32Bits(x float32) int64 {
	return cast(int64, bit_cast(int32, x))
}

// TestExternFloat32ArgViaRegistry: float32 arg to a native extern,
// carried through the all-int dispatch in an i32 slot.
func TestExternFloat32ArgViaRegistry() testing.TestResult {
	// func main() int64 { return vmTestFloat32Bits(<1.5f>) }
	var m @ir.Module = ir.NewModule("\"test\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt64()
	var fn @ir.Func = ir.NewFunc("", "main", noParams, results)
	var entry @ir.Block = ir.AddBlock(fn, "entry")
	// 1.5f -> 0x3FC00000 = 1069547520.
	var arg @ir.Instr = entry.EmitConstInt(1069547520, types.TypFloat32())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = arg
	var call @ir.Instr = entry.EmitCall("test.vmTestFloat32Bits", args, types.TypInt64())
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = call
	entry.EmitReturn(retArgs)
	m.AddFunc(fn)

	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	var fv *func(float32) int64 = vmTestFloat32Bits
	vm.RegisterExtern("test.vmTestFloat32Bits", bit_cast(*uint8, &fv), scalarResult,
			bit_cast(int, _func_handle(vmTestFloat32Bits)))
	vm.LowerModule(m)
	var idx int = vm.LookupFunc("test.main")
	if idx < 0 { return "test.main not found" }
	var noArgs @[]int
	var result int64 = execFunc(vm, idx, noArgs)
	if result != 1069547520 {
		return "float32 arg to native extern miscompiled (i32 slot)"
	}
	return ""
}

func TestExternMakeSlice() testing.TestResult {
	// make_slice calls BC_MAKE_SLICE which uses the VM stack
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var s @[]int = make_slice(int, 5)\n")
	src = concatStr(src, "  s[0] = 99\n")
	src = concatStr(src, "  return s[0]\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 99 { return "expected 99" }
	return ""
}

// TestExternRtMakeManagedSliceViaRegistry exercises the registry's
// aggregate-return path end-to-end: register rt.MakeManagedSlice with
// RetbufSize=32; bytecode user code calls it; LookupFunc misses (the
// inner VM doesn't load pkg/builtins/rt's bytecode); execExtern falls into the
// registry; dispatchExternBinding's aggregate path allocates retbuf,
// dispatches via rt._call_shim_aggregate (BC_CALL_INDIRECT against
// the shim's native pointer); native execLoop's BC_CALL_INDIRECT
// → dispatchNativeIndirect Imm==9 arm → native shim → in this case
// TrampolineAggregate (since rt.MakeManagedSlice is a VM-side
// bytecode VMFunc in the outer cmd/bni VM) → execFunc → bytecode
// rt.MakeManagedSlice → result address → memcpy 32 bytes to retbuf.
//
// IR is built directly (not via compileAndRun) because compileAndRun
// type-checks single source files without loading imports — which
// would resolve `rt.ManagedSlice` and `rt.MakeManagedSlice` to default
// types and emit wrong IR.  Building IR by hand bypasses the type
// checker; the OP_CALL just uses the dotted name and lets dispatch
// route through the registry.
//
// Pre-aggregate-shim, this returned wrong .Len (only the first 8 bytes
// captured by _call_shim_scalar's int return).  Pre-TrampolineAggregate
// (when the outer VMFunc wraps the bytecode rt.MakeManagedSlice with
// vtable.call = TrampolineScalar), this crashed in TrampolineScalar
// trying to dispatch a struct-returning callee through scalar conventions.
func TestExternRtMakeManagedSliceViaRegistry() testing.TestResult {
	// Build a struct type matching rt.ManagedSlice's layout:
	// {Data *uint8, Len int, Refptr *uint8, BackingLen int}.
	var f0 @types.Field = make(types.Field)
	f0.Name = "Data"
	f0.Type = types.MakePointerType(types.TypUint8())
	var f1 @types.Field = make(types.Field)
	f1.Name = "Len"
	f1.Type = types.TypInt()
	var f2 @types.Field = make(types.Field)
	f2.Name = "Refptr"
	f2.Type = types.MakePointerType(types.TypUint8())
	var f3 @types.Field = make(types.Field)
	f3.Name = "BackingLen"
	f3.Type = types.TypInt()
	var fields @[]@types.Field = make_slice(@types.Field, 4)
	fields[0] = f0
	fields[1] = f1
	fields[2] = f2
	fields[3] = f3
	var msTyp @types.Type = types.MakeStructType("ManagedSlice", fields)

	// func main() int { return rt.MakeManagedSlice(8, 7).Len }
	var m @ir.Module = ir.NewModule("\"test\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var fn @ir.Func = ir.NewFunc("", "main", noParams, results)
	var entry @ir.Block = ir.AddBlock(fn, "entry")

	var c8 @ir.Instr = entry.EmitConstInt(8, types.TypInt())
	var c7 @ir.Instr = entry.EmitConstInt(7, types.TypInt())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 2)
	args[0] = c8
	args[1] = c7
	var ms @ir.Instr = entry.EmitCall("pkg/builtins/rt.MakeManagedSlice", args, msTyp)

	// Extract field 1 (Len, 8-byte int).
	var lenInstr @ir.Instr = entry.EmitExtract(ms, 1, types.TypInt())

	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = lenInstr
	entry.EmitReturn(retArgs)
	m.AddFunc(fn)

	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var idx int = vm.LookupFunc("test.main")
	if idx < 0 { return "test.main not found" }
	var noArgs @[]int
	var result int64 = execFunc(vm, idx, noArgs)
	if result != 7 {
		return "pkg/builtins/rt.MakeManagedSlice via registry returned wrong .Len"
	}
	return ""
}

// Pair is an 8-byte NAMED struct — returned via the in-register-coerced retbuf
// shim (isAggregateReturn is true even though it fits a register).  mkPair is
// the cross-mode fixture for the B1/C1 regression test below.
type Pair struct {
	A int32
	B int32
}

func mkPair(a int, b int) Pair {
	var p Pair
	p.A = cast(int32, a)
	p.B = cast(int32, b)
	return p
}

// A cross-mode call to a native function returning a <= 8-byte NAMED struct must
// dispatch through the AGGREGATE (retbuf) shim, not the scalar shim.  This is
// the B1/C1 bug: the VM used to key dispatch on raw SizeOf > 8, so an 8-byte
// struct (8 is not > 8) was scalar-dispatched against mkPair's retbuf-shaped
// shim — the args shift by one and the result is read from a register the void
// shim never set, corrupting it.  With the fix the registered RetbufSize is the
// retbuf size (8, nonzero), so the > 0 branch dispatches the aggregate shim and
// the struct round-trips.
func TestExternSmallStructAggregateDispatch() testing.TestResult {
	var fa @types.Field = make(types.Field)
	fa.Name = "A"
	fa.Type = types.TypInt32()
	var fb @types.Field = make(types.Field)
	fb.Name = "B"
	fb.Type = types.TypInt32()
	var pf @[]@types.Field = make_slice(@types.Field, 2)
	pf[0] = fa
	pf[1] = fb
	var pairTyp @types.Type = types.MakeStructType("Pair", pf)

	// func main() int32 { return mkPair(5, 9).B }   (B = 9)
	var m @ir.Module = ir.NewModule("\"test\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt32()
	var fn @ir.Func = ir.NewFunc("", "main", noParams, results)
	var entry @ir.Block = ir.AddBlock(fn, "entry")
	var c5 @ir.Instr = entry.EmitConstInt(5, types.TypInt())
	var c9 @ir.Instr = entry.EmitConstInt(9, types.TypInt())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 2)
	args[0] = c5
	args[1] = c9
	var pair @ir.Instr = entry.EmitCall("test.mkPair", args, pairTyp)
	var bField @ir.Instr = entry.EmitExtract(pair, 1, types.TypInt32())
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = bField
	entry.EmitReturn(retArgs)
	m.AddFunc(fn)

	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	// Register mkPair as a native extern with its retbuf size (8 — the
	// aggregate retbuf byte size of an 8-byte named struct, nonzero).
	var fv *func(int, int) Pair = mkPair
	vm.RegisterExtern("test.mkPair", bit_cast(*uint8, &fv), 8, bit_cast(int, _func_handle(mkPair)))
	vm.LowerModule(m)
	var idx int = vm.LookupFunc("test.main")
	if idx < 0 { return "test.main not found" }
	var noArgs @[]int
	var result int64 = execFunc(vm, idx, noArgs)
	if result != 9 {
		return "8-byte struct cross-mode dispatch corrupted .B (expected 9)"
	}
	return ""
}
