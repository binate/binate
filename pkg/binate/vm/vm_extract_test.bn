package "pkg/binate/vm"

import "pkg/builtins/testing"

// Coverage for vm_extract.bn: lowerExtract (OP_EXTRACT -> BC_EXTRACT lowering)
// and execExtractOp (the executor).  A multi-return destructure emits OP_EXTRACT
// per result field, so end-to-end compileAndRun through one pins the extraction
// against dispatch / opcode regressions after the file split; the ILP32 pair
// path and the full field-shape surface are covered by the conformance suite.
// compileAndRun / concatStr live in vm_test.bn.

// A multi-return of two ints: destructuring emits OP_EXTRACT per field and the
// executor reads each int field back out of the packed tuple.
func TestVMExtractMultiReturnInts() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func mr() (int, int) { return 13, 29 }\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var a int\n")
	src = concatStr(src, "  var b int\n")
	src = concatStr(src, "  a, b = mr()\n")
	src = concatStr(src, "  return a + b\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 42 { return "expected 42" }
	return ""
}

// A mixed multi-return with a bool field exercises the sub-word (byte-accumulate)
// EXTRACT path: the 1-byte bool is read back as its own value, not a full word
// pulling in adjacent tuple bytes.
func TestVMExtractMultiReturnBoolField() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func mr() (int, bool) { return 42, true }\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var a int\n")
	src = concatStr(src, "  var ok bool\n")
	src = concatStr(src, "  a, ok = mr()\n")
	src = concatStr(src, "  if ok { return a }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 42 { return "expected 42" }
	return ""
}
