package "pkg/binate/vm"

import "pkg/binate/buf"
import "pkg/std/strconv"
import "pkg/std/strings"

// Recoverable user-code faults (Plan 2): a bad interpreted program (out of
// bounds today; divide / shift / nil-deref / stack-overflow / call-through-nil in
// later increments) flips the VM into an unwind rather than killing the host.  A
// guard calls setFault; the exec loop, seeing FaultRaised, branches to the
// faulting op's cleanup pad (which RefDecs the live managed set, then
// BC_UNWIND_RETURNs) and unwinds to the entry frame, returning to the host with
// Status == VM_STATUS_FAULTED.  See plan-rt-fault-cleanup-pads.md.

// setFault records a recoverable fault: Status marks the terminal outcome the host
// reads, FaultMsg carries the diagnostic, and FaultRaised is the transient
// "dispatch to a cleanup pad NOW" signal the exec loop consumes.  The FaultRaised /
// Status split is load-bearing — while a pad (and the destructor sub-frames it
// spawns) unwinds, Status stays FAULTED but FaultRaised is clear, so a managed op
// that merely RUNS during unwind (a passing bounds check, a RefInc inside a dtor)
// does not spuriously re-dispatch.
func setFault(vm @VM, msg @[]char) {
	vm.Status = VM_STATUS_FAULTED
	vm.FaultMsg = msg
	vm.FaultRaised = true
}

// boundsFaultMsg renders the out-of-bounds diagnostic as a fresh owned @[]char —
// the same text rt.BoundsFail prints in compiled code, so a recovered fault reads
// identically to a fatal one.  Built only on the cold fault path, so the
// strings.Builder allocation is not a hot-path cost.
func boundsFaultMsg(idx int, ln int) @[]char {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("runtime error: index out of bounds: ")
	sb.Write(strconv.Itoa(idx))
	sb.Write(" (len ")
	sb.Write(strconv.Itoa(ln))
	sb.Write(")")
	return buf.CopyStr(sb.String())
}

// dispatchFaultPad returns the cleanup-pad pc for a just-raised recoverable fault
// at op pc `pc` in f, for the exec loop to jump to.  The pad RefDecs the live
// managed set at the fault point, then BC_UNWIND_RETURNs — unwinding frame by frame
// (each caller's call-site pad in turn) to the entry frame, which returns to the
// host with Status == FAULTED.  The VM never decides fatal-vs-recover itself: it
// always unwinds to the host, and each embedder picks the policy (the REPL reports
// + continues; a `bni`-run program prints + exits; a test run fails the test).  A
// missing pad is a lowering bug — every faulting op is emitted with one.
//
// The pad RefDecs EVERY managed local/temp in the function's lexical scope, not
// only those already produced at the fault point.  That is leak- and
// double-free-safe only because of two VM invariants: pushFrame zero-fills the
// frame's register + alloca area, so a slot for a local/temp whose initializer has
// not yet run reads 0 and its RefDec (nil) no-ops; and each managed value occupies
// a distinct, lifetime-long register (its SSA value id — no packing/reuse), so
// nothing is RefDec'd twice.  A future VM change that reuses registers or stops
// zero-filling the frame would silently turn a recovered fault into a wild RefDec.
func dispatchFaultPad(f @VMFunc, pc int) int {
	var padPC int = lookupFaultPad(f, pc)
	if padPC < 0 {
		vmPanic("vm: recoverable fault with no cleanup pad (lowering bug)")
	}
	return padPC
}

// lookupFaultPad returns the bytecode PC of the cleanup pad for the fault site at
// resume pc `pc` in f, or -1 if f registers no pad for it.  f.FaultTable is inline
// (opPC, padPC) pairs sorted ascending by opPC (VM lowering emits them in pc
// order); binary-searched here.  The caller passes the post-op pc — the exec
// loop's pre-incremented pc, which is exactly the opPC key lowering recorded.
func lookupFaultPad(f @VMFunc, pc int) int {
	var lo int = 0
	var hi int = len(f.FaultTable) / 2
	for lo < hi {
		var mid int = lo + (hi - lo) / 2
		var key int = f.FaultTable[mid * 2]
		if key == pc {
			return f.FaultTable[mid * 2 + 1]
		}
		if key < pc {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	return -1
}
