package "pkg/binate/vm"

import "pkg/builtins/testing"

// Tests for vm_fault.bn — the recoverable-fault helpers (Plan 2 Inc 2b).

// faultStrEq compares an @[]char against an expected literal (byte-for-byte).
func faultStrEq(got @[]char, want *[]readonly char) bool {
	if len(got) != len(want) { return false }
	for i := 0; i < len(got); i++ {
		if got[i] != want[i] { return false }
	}
	return true
}

// boundsFaultMsg renders exactly the text rt.BoundsFail prints, so a recovered
// fault reads the same as a fatal one.
func TestBoundsFaultMsg() testing.TestResult {
	var got @[]char = boundsFaultMsg(5, 3)
	if !faultStrEq(got, "runtime error: index out of bounds: 5 (len 3)") {
		return "boundsFaultMsg: wrong text"
	}
	return ""
}

// setFault records the terminal Status, the diagnostic, and the transient
// dispatch signal (FaultRaised) together.
func TestSetFault() testing.TestResult {
	var vm @VM = NewVM(4096)
	setFault(vm, "runtime error: index out of bounds: 5 (len 3)")
	if vm.Status != VM_STATUS_FAULTED {
		return "setFault must set Status = VM_STATUS_FAULTED"
	}
	if !vm.FaultRaised {
		return "setFault must set FaultRaised"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: index out of bounds: 5 (len 3)") {
		return "setFault must store the message in FaultMsg"
	}
	return ""
}

// lookupFaultPad binary-searches the (opPC, padPC) pairs: a present key returns
// its pad pc, an absent key returns -1.
func TestLookupFaultPad() testing.TestResult {
	var f @VMFunc = make(VMFunc)
	// Three fault sites, ascending by op pc: 4 -> 20, 9 -> 25, 12 -> 30.
	var ft @[]int = make_slice(int, 6)
	ft[0] = 4
	ft[1] = 20
	ft[2] = 9
	ft[3] = 25
	ft[4] = 12
	ft[5] = 30
	f.FaultTable = ft
	if lookupFaultPad(f, 4) != 20 { return "lookupFaultPad(4) should be 20" }
	if lookupFaultPad(f, 9) != 25 { return "lookupFaultPad(9) should be 25" }
	if lookupFaultPad(f, 12) != 30 { return "lookupFaultPad(12) should be 30" }
	if lookupFaultPad(f, 5) != -1 { return "lookupFaultPad(5) miss should be -1" }
	if lookupFaultPad(f, 0) != -1 { return "lookupFaultPad(0) miss should be -1" }
	if lookupFaultPad(f, 99) != -1 { return "lookupFaultPad(99) miss should be -1" }
	return ""
}

// A function with no fault sites (empty table) always misses.
func TestLookupFaultPadEmpty() testing.TestResult {
	var f @VMFunc = make(VMFunc)
	if lookupFaultPad(f, 0) != -1 { return "empty table should miss at 0" }
	if lookupFaultPad(f, 4) != -1 { return "empty table should miss at 4" }
	return ""
}
