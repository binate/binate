package "pkg/binate/vm"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for vm_fault.bn — the recoverable-fault helpers (Plan 2 Inc 2b).

// faultStrEq compares an @[]char against an expected literal (byte-for-byte).
func faultStrEq(got *[]readonly char, want *[]readonly char) bool {
	if len(got) != len(want) { return false }
	for i := 0; i < len(got); i++ {
		if got[i] != want[i] { return false }
	}
	return true
}

// boundsFaultMsg renders exactly the text rt.BoundsFail prints, so a recovered
// fault reads the same as a fatal one.
func TestBoundsFaultMsg() testing.TestResult {
	var got @[]char = boundsFaultMsg(5, 3)
	if !faultStrEq(got, "runtime error: index out of bounds: 5 (len 3)") {
		return "boundsFaultMsg: wrong text"
	}
	return ""
}

// setFault records the terminal Status, the diagnostic, and the transient
// dispatch signal (FaultRaised) together — the recoverable path, taken because a
// fresh VM has CleanupDepth 0 (not inside a pad/dtor).
func TestSetFault() testing.TestResult {
	var vm @VM = NewVM(4096)
	if vm.CleanupDepth != 0 {
		return "a fresh VM must start with CleanupDepth 0 (recoverable-fault precondition)"
	}
	setFault(vm, "runtime error: index out of bounds: 5 (len 3)")
	if vm.Status != VM_STATUS_FAULTED {
		return "setFault must set Status = VM_STATUS_FAULTED"
	}
	if !vm.FaultRaised {
		return "setFault must set FaultRaised"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: index out of bounds: 5 (len 3)") {
		return "setFault must store the message in FaultMsg"
	}
	return ""
}

// faultDuringCleanup drives setFault's fatal-vs-recoverable decision (§6): a fault
// is fatal exactly while the VM is inside a cleanup pad or destructor frame
// (CleanupDepth != 0).  The fatal branch itself vmPanics and can't run in-process,
// so the predicate is what's testable; nesting (depth 2) still reads fatal.
func TestFaultDuringCleanup() testing.TestResult {
	var vm @VM = NewVM(4096)
	if faultDuringCleanup(vm) {
		return "depth 0 (normal execution) must be recoverable, not fatal"
	}
	vm.CleanupDepth = 1
	if !faultDuringCleanup(vm) {
		return "depth 1 (one cleanup context) must be fatal"
	}
	vm.CleanupDepth = 2
	if !faultDuringCleanup(vm) {
		return "depth 2 (nested cleanup) must be fatal"
	}
	vm.CleanupDepth = 0
	if faultDuringCleanup(vm) {
		return "back to depth 0 must be recoverable again"
	}
	return ""
}

// lookupFaultPad binary-searches the (opPC, padPC) pairs: a present key returns
// its pad pc, an absent key returns -1.
func TestLookupFaultPad() testing.TestResult {
	var f @VMFunc = make(VMFunc)
	// Three fault sites, ascending by op pc: 4 -> 20, 9 -> 25, 12 -> 30.
	var ft @[]int = make_slice(int, 6)
	ft[0] = 4
	ft[1] = 20
	ft[2] = 9
	ft[3] = 25
	ft[4] = 12
	ft[5] = 30
	f.FaultTable = ft
	if lookupFaultPad(f, 4) != 20 { return "lookupFaultPad(4) should be 20" }
	if lookupFaultPad(f, 9) != 25 { return "lookupFaultPad(9) should be 25" }
	if lookupFaultPad(f, 12) != 30 { return "lookupFaultPad(12) should be 30" }
	if lookupFaultPad(f, 5) != -1 { return "lookupFaultPad(5) miss should be -1" }
	if lookupFaultPad(f, 0) != -1 { return "lookupFaultPad(0) miss should be -1" }
	if lookupFaultPad(f, 99) != -1 { return "lookupFaultPad(99) miss should be -1" }
	return ""
}

// A function with no fault sites (empty table) always misses.
func TestLookupFaultPadEmpty() testing.TestResult {
	var f @VMFunc = make(VMFunc)
	if lookupFaultPad(f, 0) != -1 { return "empty table should miss at 0" }
	if lookupFaultPad(f, 4) != -1 { return "empty table should miss at 4" }
	return ""
}

// TestCrossFramePopUnwindsToHost drives BC_UNWIND_RETURN's cross-frame pop (Plan 2
// Inc 3a-1) in isolation.  The entry-frame gate keeps real nested faults on the
// legacy path, so a real fault can't reach the cross-frame arm from a test;
// instead the callee's BODY is a bare OP_UNWIND_RETURN — a callee whose cleanup
// pad has just run and is unwinding — and the caller carries a hand-built
// call-site pad (which IR-gen emits automatically in Inc 3a-2).  A CLEAN RETURN
// from CallFunc proves the whole chain: the callee's BC_UNWIND_RETURN pops to the
// caller, lookupFaultPad(caller, callerPC) finds the call-site pad (pc-key
// alignment holds), the pad's BC_UNWIND_RETURN pops the entry frame, and the VM
// returns to the host.  A pc-misalignment or a missing pad would vmPanic (abort
// the test) instead of returning.
func TestCrossFramePopUnwindsToHost() testing.TestResult {
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var noInstrs @[]@ir.Instr

	// callee: a bare OP_UNWIND_RETURN body — simulates a callee mid-unwind.
	var callee @ir.Func = ir.NewFunc("", "test.callee", noParams, noResults)
	var calleeEntry @ir.Block = ir.AddBlock(callee, "entry")
	calleeEntry.EmitUnwindReturn()

	// caller: calls callee, with the call op tagged with a call-site cleanup pad.
	var caller @ir.Func = ir.NewFunc("", "test.caller", noParams, noResults)
	var callerEntry @ir.Block = ir.AddBlock(caller, "entry")
	var callOp @ir.Instr = callerEntry.EmitCall("test.callee", noInstrs, types.TypVoid())
	callerEntry.EmitReturn(noInstrs) // the normal path, unreached on the unwind
	var callerPad @ir.Block = ir.AddFaultPad(caller, "call_pad")
	callerPad.EmitUnwindReturn()
	callOp.PadBlock = callerPad

	// callee added first so the caller's eager call-cache fill resolves it.
	var m @ir.Module = ir.NewModule("\"test\"")
	m.AddFunc(callee)
	m.AddFunc(caller)
	var vm @VM = NewVM(64 * 1024)
	vm.LowerModule(m)

	// Entry frame = caller.  Reaching the line after CallFunc means the cross-frame
	// unwind chain completed (callee -> caller call-site pad -> entry -> host)
	// without a vmPanic.
	var argv @[]int
	vm.CallFunc("test.caller", argv)
	return ""
}

// TestVMOptLevelBCEKeepsLiveFault is the executable counterpart to
// TestLowerModuleOptLevelBCE: it proves that at -O1, eliminating a statically-safe
// constant-index check (which orphans its cleanup pad in Func.FaultPads) does NOT
// misroute a SURVIVING runtime-index check's fault.  `f` has both a[2] (const,
// removed) and a[i] (runtime, kept) in one function; running f(10) must fault via
// the live check — the VM's FaultTable is built from the post-BCE blk.Instrs, so
// nothing maps to the orphaned pad.
func TestVMOptLevelBCEKeepsLiveFault() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc f(i int) int {\n\tvar a [4]int\n\ta[2] = 7\n"
			"\treturn a[i]\n}\n"
	var m @ir.Module = genModule(src)
	var vm @VM = NewVM(64 * 1024)
	vm.OptLevel = 1
	vm.LowerModule(m)
	// a[2] (const, in-bounds) removed; a[i] (runtime) survives ⇒ one check left.
	if countBCBoundsChecks(vm) != 1 {
		return "expected exactly the runtime-index check to survive at -O1"
	}
	// f(10): a[10] on [4]int is out of bounds → the LIVE check must fault.
	var argv @[]int = make_slice(int, 1)
	argv[0] = 10
	vm.CallFunc("test.f", argv)
	if vm.Status != VM_STATUS_FAULTED {
		return "OOB runtime index must fault at -O1 (live check, not the orphaned pad)"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: index out of bounds: 10 (len 4)") {
		return "expected the live check's OOB fault message"
	}
	return ""
}

// TestNilCheckFaultRecovers drives the recoverable nil-pointer-deref fault (Plan 2
// opt-in nil-checking, N1) in isolation: a hand-built function nil-checks a nil (const
// 0) pointer, with the check op tagged with a cleanup pad.  BC_NIL_CHECK setFaults, the
// exec loop dispatches to the pad, and the VM unwinds to the host with Status = FAULTED
// + message.  IR-gen does not emit OP_NIL_CHECK yet (that is N2), so this proves the VM
// guard alone.  A vmPanic (missing pad / no setFault) would abort the test instead.
func TestNilCheckFaultRecovers() testing.TestResult {
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("", "test.f", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	// A nil pointer (const 0), then a nil-check on it — the check fires.
	var nilPtr @ir.Instr = entry.EmitConstInt(0, types.TypInt())
	var nilOp @ir.Instr = entry.EmitNilCheck(nilPtr)
	// Tag the check with a cleanup pad (IR-gen's attachFaultPad does this in N2).
	var pad @ir.Block = ir.AddFaultPad(f, "nil_pad")
	pad.EmitUnwindReturn()
	nilOp.PadBlock = pad
	var noInstrs @[]@ir.Instr
	entry.EmitReturn(noInstrs)

	var m @ir.Module = ir.NewModule("\"test\"")
	m.AddFunc(f)
	var vm @VM = NewVM(64 * 1024)
	vm.LowerModule(m)
	var argv @[]int
	vm.CallFunc("test.f", argv)
	if vm.Status != VM_STATUS_FAULTED {
		return "a nil-pointer deref check must recover with Status = FAULTED"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: nil pointer dereference") {
		return "the recovered nil-check fault must carry the nil-deref message"
	}
	return ""
}

// TestNestedFaultRecoversCrossFrame is the end-to-end proof of the Inc 3a-2 flip:
// a fault in a NESTED call (helper, called from driver) unwinds THROUGH the
// caller's IR-gen-emitted call-site pad to the host, rather than dying.  driver
// holds a live managed local (owned) across the helper() call, so the call-site
// pad must RefDec it on the way out — the whole point of call-site pads.  helper
// makes its own managed slice then indexes out of bounds; the unwind is:
// helper's fault pad (frees s) -> driver's call-site pad (frees owned) -> driver's
// entry frame -> host, Status = FAULTED.  Recovery + message assert the flip;
// a leak/double-free would show up as a crash or refcount corruption on repeat.
func TestNestedFaultRecoversCrossFrame() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func helper() int {\n"
			"	var s @[]int = make_slice(int, 1)\n"
			"	var y int = s[5]\n"
			"	return 0\n"
			"}\n"
			"func driver() int {\n"
			"	var owned @[]int = make_slice(int, 2)\n"
			"	var z int = helper()\n"
			"	return len(owned)\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = ir.GenModule(c, file)
	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)

	// driver is the entry frame; the fault is nested in helper.
	var noArgs @[]int
	vm.CallFunc("test.driver", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "a nested fault must unwind cross-frame to the host with Status = FAULTED"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: index out of bounds: 5 (len 1)") {
		return "the recovered nested fault must carry the bounds message"
	}
	// A clean second call on the same VM proves the cross-frame unwind left the VM
	// in a consistent state (SP restored, no lingering fault).
	vm.CallFunc("test.driver", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeat nested fault must recover identically (VM state intact)"
	}
	return ""
}

// TestNestedFaultRecoversThroughMethodCall guards the call-site pad on CONCRETE
// method calls (gen_method.bn) — a user-level call that a memory-safety review
// found un-padded.  driver takes a bounds-checked index first (a padded op, so
// driver's FaultTable is non-empty), then faults inside a concrete method call
// bx.compute().  Without the method-call pad the unwind would reach driver's
// method-call pc, miss (non-empty table), and vmPanic — crashing this test; with
// the pad it unwinds through driver's call-site pad (freeing owned) to the host.
func TestNestedFaultRecoversThroughMethodCall() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Box struct { n int }\n"
			"func (b Box) compute() int {\n"
			"	var s @[]int = make_slice(int, 1)\n"
			"	var y int = s[5]\n"
			"	return 0\n"
			"}\n"
			"func driver() int {\n"
			"	var owned @[]int = make_slice(int, 2)\n"
			"	var q int = owned[0]\n"
			"	var bx Box\n"
			"	var z int = bx.compute()\n"
			"	return len(owned) + q + z\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = ir.GenModule(c, file)
	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)

	var noArgs @[]int
	vm.CallFunc("test.driver", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "a fault in a concrete method call must recover cross-frame to the host"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: index out of bounds: 5 (len 1)") {
		return "the recovered method-call fault must carry the bounds message"
	}
	return ""
}

// TestEntryFrameFaultCleansManagedElementSlice exercises the harder cleanup-pad
// shape: the live managed local is a managed-ELEMENT slice (@[]@[]int), so its
// RefDec iterates and releases each element — a MULTI-BLOCK (branching) pad, unlike
// the straight-line pad for a @[]int.  One element is populated (a live nested
// managed value the pad must free) and one left nil (RefDec(nil) no-op) before the
// out-of-bounds index, so recovery must walk the branching cleanup without leaking
// the inner slice or double-freeing the nil slot.  Uses a real module function via
// LowerModule (not the incremental LowerOneFunc path) so the generated
// managed-slice-of-managed-slice destructor the pad calls is lowered too.  Host
// survival + FAULTED is the observable; the pad's per-element RefDec is what this
// shape adds over the bare case.  toBytes / registerTestExterns are shared vm test
// helpers (vm_test.bn).
func TestEntryFrameFaultCleansManagedElementSlice() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func doFault() int {\n"
			"	var s @[]@[]int = make_slice(@[]int, 2)\n"
			"	s[0] = make_slice(int, 1)\n"
			"	var y @[]int = s[5]\n"
			"	return 0\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = ir.GenModule(c, file)
	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)

	// doFault runs as the entry frame (CallFunc -> execFunc, saved pc -1), so its
	// out-of-bounds index recovers rather than killing the host.
	var noArgs @[]int
	vm.CallFunc("test.doFault", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "an entry-frame fault over a managed-element slice must leave Status = FAULTED"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: index out of bounds: 5 (len 2)") {
		return "the recovered fault must carry the bounds message"
	}
	return ""
}

// TestStackOverflowRecovers drives the recoverable stack-overflow fault (Plan 2):
// unbounded recursion fills the stack, pushFrame's red-zone check faults instead of
// killing the host, and the exec loop unwinds every frame back to the host with
// Status = FAULTED + message.  rec is non-tail (rec()+1) so it genuinely grows the
// stack; a small VM stack makes the overflow fast.  The live set at each frame is
// empty (no managed locals), so the unwind is pure pop — the point here is the
// pushFrame fault + full-depth unwind, not cleanup.  A clean repeat call proves the
// VM state (SP, CleanupDepth) was fully restored.
func TestStackOverflowRecovers() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func rec() int {\n"
			"	return rec() + 1\n"
			"}\n"
			"func driver() int {\n"
			"	return rec()\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = ir.GenModule(c, file)
	var vm @VM = NewVM(128 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)

	var noArgs @[]int
	vm.CallFunc("test.driver", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "unbounded recursion must recover with Status = FAULTED, not kill the host"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: stack overflow") {
		return "the recovered overflow must carry the stack-overflow message"
	}
	if vm.CleanupDepth != 0 {
		return "the full-depth unwind must leave CleanupDepth back at 0"
	}
	// The VM must be reusable: SP restored, no lingering fault state.
	vm.CallFunc("test.driver", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeat overflow must recover identically (VM state intact)"
	}
	return ""
}

// TestFaultCleanupDepthBalances proves the §6 CleanupDepth counter is balanced across
// a full cross-frame unwind whose cleanup pushes a DESTRUCTOR frame — the flow that
// touches all four counter sites.  driver holds a managed struct @Node (with a managed
// @[]int field) live across a nested helper() fault; helper's index-out-of-bounds
// unwinds through driver's call-site pad, which RefDecs n to zero, pushing Node's
// generated destructor frame (CleanupDepth: pad-entry +1, dtor-push +1, dtor-pop -1,
// pad-exit -1).  Recovery to the host must leave CleanupDepth back at 0 — a stuck
// counter would make every subsequent guard fault spuriously fatal.  A repeat call
// confirms the reset holds.
func TestFaultCleanupDepthBalances() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Node struct { data @[]int }\n"
			"func helper() int {\n"
			"	var s @[]int = make_slice(int, 1)\n"
			"	var y int = s[5]\n"
			"	return 0\n"
			"}\n"
			"func driver() int {\n"
			"	var n @Node = make(Node)\n"
			"	n.data = make_slice(int, 2)\n"
			"	var z int = helper()\n"
			"	return len(n.data) + z\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = ir.GenModule(c, file)
	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)

	var noArgs @[]int
	vm.CallFunc("test.driver", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "a nested fault over a managed-struct local must recover to the host"
	}
	if vm.CleanupDepth != 0 {
		return "CleanupDepth must return to 0 after a dtor-pushing cleanup unwind (counter leak)"
	}
	// A second recovering call must behave identically — proving the balanced counter
	// (and the per-call reset) left the VM in a clean cleanup state.
	vm.CallFunc("test.driver", noArgs)
	if vm.Status != VM_STATUS_FAULTED || vm.CleanupDepth != 0 {
		return "a repeat fault must recover with CleanupDepth back at 0"
	}
	return ""
}
