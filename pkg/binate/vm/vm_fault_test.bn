package "pkg/binate/vm"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for vm_fault.bn — the recoverable-fault helpers (Plan 2 Inc 2b).

// faultStrEq compares an @[]char against an expected literal (byte-for-byte).
func faultStrEq(got @[]char, want *[]readonly char) bool {
	if len(got) != len(want) { return false }
	for i := 0; i < len(got); i++ {
		if got[i] != want[i] { return false }
	}
	return true
}

// boundsFaultMsg renders exactly the text rt.BoundsFail prints, so a recovered
// fault reads the same as a fatal one.
func TestBoundsFaultMsg() testing.TestResult {
	var got @[]char = boundsFaultMsg(5, 3)
	if !faultStrEq(got, "runtime error: index out of bounds: 5 (len 3)") {
		return "boundsFaultMsg: wrong text"
	}
	return ""
}

// setFault records the terminal Status, the diagnostic, and the transient
// dispatch signal (FaultRaised) together.
func TestSetFault() testing.TestResult {
	var vm @VM = NewVM(4096)
	setFault(vm, "runtime error: index out of bounds: 5 (len 3)")
	if vm.Status != VM_STATUS_FAULTED {
		return "setFault must set Status = VM_STATUS_FAULTED"
	}
	if !vm.FaultRaised {
		return "setFault must set FaultRaised"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: index out of bounds: 5 (len 3)") {
		return "setFault must store the message in FaultMsg"
	}
	return ""
}

// lookupFaultPad binary-searches the (opPC, padPC) pairs: a present key returns
// its pad pc, an absent key returns -1.
func TestLookupFaultPad() testing.TestResult {
	var f @VMFunc = make(VMFunc)
	// Three fault sites, ascending by op pc: 4 -> 20, 9 -> 25, 12 -> 30.
	var ft @[]int = make_slice(int, 6)
	ft[0] = 4
	ft[1] = 20
	ft[2] = 9
	ft[3] = 25
	ft[4] = 12
	ft[5] = 30
	f.FaultTable = ft
	if lookupFaultPad(f, 4) != 20 { return "lookupFaultPad(4) should be 20" }
	if lookupFaultPad(f, 9) != 25 { return "lookupFaultPad(9) should be 25" }
	if lookupFaultPad(f, 12) != 30 { return "lookupFaultPad(12) should be 30" }
	if lookupFaultPad(f, 5) != -1 { return "lookupFaultPad(5) miss should be -1" }
	if lookupFaultPad(f, 0) != -1 { return "lookupFaultPad(0) miss should be -1" }
	if lookupFaultPad(f, 99) != -1 { return "lookupFaultPad(99) miss should be -1" }
	return ""
}

// A function with no fault sites (empty table) always misses.
func TestLookupFaultPadEmpty() testing.TestResult {
	var f @VMFunc = make(VMFunc)
	if lookupFaultPad(f, 0) != -1 { return "empty table should miss at 0" }
	if lookupFaultPad(f, 4) != -1 { return "empty table should miss at 4" }
	return ""
}

// TestEntryFrameFaultCleansManagedElementSlice exercises the harder cleanup-pad
// shape: the live managed local is a managed-ELEMENT slice (@[]@[]int), so its
// RefDec iterates and releases each element — a MULTI-BLOCK (branching) pad, unlike
// the straight-line pad for a @[]int.  One element is populated (a live nested
// managed value the pad must free) and one left nil (RefDec(nil) no-op) before the
// out-of-bounds index, so recovery must walk the branching cleanup without leaking
// the inner slice or double-freeing the nil slot.  Uses a real module function via
// LowerModule (not the incremental LowerOneFunc path) so the generated
// managed-slice-of-managed-slice destructor the pad calls is lowered too.  Host
// survival + FAULTED is the observable; the pad's per-element RefDec is what this
// shape adds over the bare case.  toBytes / registerTestExterns are shared vm test
// helpers (vm_test.bn).
func TestEntryFrameFaultCleansManagedElementSlice() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func doFault() int {\n"
			"	var s @[]@[]int = make_slice(@[]int, 2)\n"
			"	s[0] = make_slice(int, 1)\n"
			"	var y @[]int = s[5]\n"
			"	return 0\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = ir.GenModule(c, file)
	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)

	// doFault runs as the entry frame (CallFunc -> execFunc, saved pc -1), so its
	// out-of-bounds index recovers rather than killing the host.
	var noArgs @[]int
	vm.CallFunc("test.doFault", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "an entry-frame fault over a managed-element slice must leave Status = FAULTED"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: index out of bounds: 5 (len 2)") {
		return "the recovered fault must carry the bounds message"
	}
	return ""
}
