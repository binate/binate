package "pkg/binate/vm"

import "pkg/builtins/testing"

// The VM keeps vm.SP 8-aligned at every point a frame header is written (through
// an `*int` in pushFrame): a hosted x86 target tolerates an unaligned header
// store, but a strict-alignment target (arm) DATA-ABORTS on it and, with no
// bare-metal fault recovery, spins forever.  frameExtent is the single rounded
// footprint both pushFrame and BC_SP_RESTORE derive vm.SP from; these tests pin
// the invariant at the sites hosted CI can reach directly, plus one compiled-and-
// run shape that a regression of the SP_RESTORE wiring would hang on arm.

// TestFrameExtentIs8Aligned pins the shared helper: whatever the (sub-word-odd)
// FrameSize and register count, the rounded extent is a multiple of 8, so a frame
// that starts 8-aligned ends 8-aligned.
func TestFrameExtentIs8Aligned() testing.TestResult {
	var regsN int = 0
	for regsN <= 7 {
		var szN int = 0
		for szN <= 9 {
			var f @VMFunc = make(VMFunc)
			f.NumRegs = regsN
			f.FrameSize = szN // includes the sub-word-odd cases (1, 3, 9)
			if frameExtent(f) % 8 != 0 {
				return "frameExtent not 8-aligned for an odd FrameSize/NumRegs combo"
			}
			szN = szN + 1
		}
		regsN = regsN + 1
	}
	return ""
}

// TestPushFrameKeepsSPAligned drives the pushFrame site: pushing a chain of
// odd-FrameSize frames must leave every frame base (= the prior vm.SP) 8-aligned.
// Fails without the rounding even on a hosted LP64 build (48 + 5*8 + 9 = 97).
func TestPushFrameKeepsSPAligned() testing.TestResult {
	var vm @VM = newTestVM(64 * 1024)
	var f @VMFunc = make(VMFunc)
	f.NumRegs = 5
	f.FrameSize = 9 // odd extent — e.g. a single `bool` local

	var regsOff int = FRAME_HDR // seed a plausible caller regsOff
	var i int = 0
	for i < 4 {
		if vm.SP % 8 != 0 {
			return "frame base (vm.SP) unaligned before pushFrame"
		}
		regsOff = pushFrame(vm, f, 0, 0, regsOff, vm.SP, 0)
		if vm.FaultRaised {
			return "unexpected stack overflow in the alignment probe"
		}
		if vm.SP % 8 != 0 {
			return "pushFrame left vm.SP unaligned (frame extent not rounded to 8)"
		}
		i = i + 1
	}
	return ""
}

// TestFrameAlignSPRestoreThenCall drives the BC_SP_RESTORE wiring end to end: a
// function with an odd trailing local (`ok bool` → odd FrameSize) runs an
// SP-GROWING statement (the multi-return copy-back of `a, ok = mr()`), which the
// end-of-statement OP_SP_RESTORE reclaims, and THEN makes a call.  If SP_RESTORE
// restored vm.SP to the unrounded (odd) frame end, that call's pushFrame would
// write its header at an unaligned vm.SP — fine on x86, a hang on arm.  A hosted
// run just confirms the value; the arm bare-metal unit run is where a regression
// of the shared-extent wiring surfaces as a hang.
func TestFrameAlignSPRestoreThenCall() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func mr() (int, bool) { return 42, true }\n"
			"func noop() {}\n"
			"func main() int {\n"
			"\tvar a int\n"
			"\tvar ok bool\n"
			"\ta, ok = mr()\n"
			"\tnoop()\n"
			"\tif ok { return a }\n"
			"\treturn 0\n"
			"}\n"
	if compileAndRun(src) != 42 {
		return "SP_RESTORE-then-call program should return 42"
	}
	return ""
}

// TestFrameAlignStringArrayThenCall drives the BC_STRING_COPY_ARR wiring: a
// composite literal materializes a string into an odd [3]char field (STRING_COPY_
// ARR grows vm.SP by 3) and, in the SAME expression, a `g()` field pushes a frame
// at that grown vm.SP.  With the advance unrounded, that push writes its header at
// an unaligned vm.SP — a data abort on strict-align arm.  A hosted run just checks
// the value; the arm bare-metal unit run is where a regression of the round-up
// surfaces as a hang.
func TestFrameAlignStringArrayThenCall() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type W struct { arr [3]char\n n int }\n"
			"func g() int { return 5 }\n"
			"func main() int { var w W = W{arr: \"abc\", n: g()}\n"
			"\treturn w.n + cast(int, w.arr[0]) }\n"
	if compileAndRun(src) != 102 {
		return "string-[3]char-then-call program should return 5 + 'a'(97) = 102"
	}
	return ""
}
