package "pkg/binate/vm"

import "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/irgen"
import "pkg/binate/parser"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// TestFuncValueOverflowNoLeak: a func-value call recursing with a fresh moved `@I`
// box each level until the VM stack overflows must recover leak-free — stable
// LiveBlocks across repeated overflows.  A same-vm VM func value takes the
// direct-push fast path, whose pre-delivery overflow check (OP_STACK_CHECK_FV) faults
// while its args-owning pad still covers the moved arg, so the box is released
// instead of orphaned at the frame push.
func TestFuncValueOverflowNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface I { m() int }\n"
			"type T struct { x int }\n"
			"func (t @T) m() int { return t.x }\n"
			"impl @T : I\n"
			"var gFn *func(@I, int) int = nil\n"
			"func recur(iv @I, depth int) int {\n"
			"	if depth <= 0 { return iv.m() }\n"
			"	return gFn(cast(@I, make(T)), depth - 1)\n"
			"}\n"
			"func start(depth int) int {\n"
			"	gFn = recur\n"
			"	return recur(cast(@I, make(T)), depth)\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = irgen.GenModule(c, file)
	var vm @VM = newTestVM(64 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var argv @[]int = make_slice(int, 1)
	argv[0] = 100000000 // deep enough to overflow
	vm.CallFunc("test.start", argv)
	if vm.Status != VM_STATUS_FAULTED {
		return "deep func-value recursion must overflow with Status = FAULTED"
	}
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc("test.start", argv)
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated func-value overflow must recover identically"
	}
	if rt.LiveBlocks() != base {
		return "func-value overflow LEAKS the moved @I arg"
	}
	return ""
}

// TestAggFuncValueOverflowNoLeak: the aggregate-return variant — the func value
// returns a struct (retbuf-dispatched), recursing with a moved `@I` until overflow.
// The direct-push fast path relocates the aggregate result via BC_RETURN (no
// caller-side retbuf on vm.SP), so the pre-check's frame prediction stays exact and
// the moved arg is released on overflow — stable LiveBlocks.  (Before the fast path
// this case crashed via TrampolinePacked's retbuf MemCopy on a fault-0 result.)
func TestAggFuncValueOverflowNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface I { m() int }\n"
			"type T struct { x int }\n"
			"func (t @T) m() int { return t.x }\n"
			"impl @T : I\n"
			"type Pair struct { a int\n b int }\n"
			"var gFn *func(@I, int) Pair = nil\n"
			"func recur(iv @I, depth int) Pair {\n"
			"	if depth <= 0 {\n"
			"		var p Pair\n"
			"		p.a = iv.m()\n"
			"		return p\n"
			"	}\n"
			"	return gFn(cast(@I, make(T)), depth - 1)\n"
			"}\n"
			"func start(depth int) int {\n"
			"	gFn = recur\n"
			"	var p Pair = recur(cast(@I, make(T)), depth)\n"
			"	return p.a\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = irgen.GenModule(c, file)
	var vm @VM = newTestVM(64 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var argv @[]int = make_slice(int, 1)
	argv[0] = 100000000
	vm.CallFunc("test.start", argv)
	if vm.Status != VM_STATUS_FAULTED {
		return "deep aggregate-returning func-value recursion must overflow with Status = FAULTED"
	}
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc("test.start", argv)
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated aggregate func-value overflow must recover identically"
	}
	if rt.LiveBlocks() != base {
		return "aggregate-returning func-value overflow LEAKS the moved @I arg"
	}
	return ""
}

// TestNilFuncValueMovedArgNoLeak: calling a NIL func value with a MOVED managed arg
// (`cast(@I, make(T))`) must release that arg, not orphan it.  The pre-delivery
// check (OP_STACK_CHECK_FV) faults on the nil value while its args-owning pad still
// covers the arg — BEFORE delivery consumes it — so LiveBlocks stays stable across
// repeated nil calls (a nil func value dispatched without the pre-check would fault
// only after delivery, leaving the moved arg on the non-owning post-call pad).
func TestNilFuncValueMovedArgNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface I { m() int }\n"
			"type T struct { x int }\n"
			"func (t @T) m() int { return t.x }\n"
			"impl @T : I\n"
			"var gFn *func(@I) int = nil\n"
			"func callNil() int {\n"
			"	return gFn(cast(@I, make(T)))\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = irgen.GenModule(c, file)
	var vm @VM = newTestVM(64 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var noArgs @[]int
	vm.CallFunc("test.callNil", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "calling a nil func value must fault with Status = FAULTED"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: call of nil function value") {
		return "the recovered nil-func-value fault must carry the nil-func-value message"
	}
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc("test.callNil", noArgs)
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated nil func-value call must recover identically"
	}
	if rt.LiveBlocks() != base {
		return "nil func-value call LEAKS the moved @I arg (pre-check must release it)"
	}
	return ""
}
