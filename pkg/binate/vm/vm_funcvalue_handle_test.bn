package "pkg/binate/vm"

import "pkg/builtins/testing"

// Tests for ensureHandle (vm_funcvalue_handle.bn) — the lazy builder of a VMFunc's
// Vtable / ClosureRec / Handle used by func-value / handle references.  (Trampoline
// SELECTION for a 64-bit-scalar result is pinned separately in
// vm_crossmode_ret64_test.bn.)

// ensureHandle populates all three managed fields on first call, wires the
// ClosureRec to the owning VM + 1-based func index, and is idempotent — a second
// call reuses the same records rather than allocating fresh ones.
func TestEnsureHandlePopulatesAndIsIdempotent() testing.TestResult {
	var vm @VM = lowerFromSource("package \"test\"\nfunc f() int { return 7 }\n")
	registerTestExterns(vm)
	var fi int = vm.LookupFunc("test.f")
	if fi < 0 { return "test.f not found" }
	var fn @VMFunc = vm.Funcs.Get(fi)
	ensureHandle(vm, fn, fi)
	if fn.Vtable == nil || fn.ClosureRec == nil || fn.Handle == nil {
		return "ensureHandle must populate Vtable, ClosureRec, and Handle"
	}
	if fn.ClosureRec.FnIdx != fi + 1 {
		return "ClosureRec.FnIdx must be the 1-based VM func index"
	}
	if fn.ClosureRec.Vm != bit_cast(int, vm) {
		return "ClosureRec.Vm must point at the owning VM"
	}
	// Idempotency: capture the record identities, call again, confirm reuse.
	var vt0 int = bit_cast(int, fn.Vtable)
	var rec0 int = bit_cast(int, fn.ClosureRec)
	var h0 int = bit_cast(int, fn.Handle)
	ensureHandle(vm, fn, fi)
	if bit_cast(int, fn.Vtable) != vt0 || bit_cast(int, fn.ClosureRec) != rec0 {
		return "a second ensureHandle must reuse the existing vtable + closure rec"
	}
	if bit_cast(int, fn.Handle) != h0 {
		return "a second ensureHandle must reuse the existing handle"
	}
	return ""
}

// A MULTI-return VM function selects the retbuf trampoline (TrampolineAggregate):
// a compiled caller uses the retbuf shim shape for ANY multi-return func value
// (types.IsAggregateReturn is unconditionally true for len > 1), so the VM must
// match.  The old per-result `ResultMultiWord[0]` gate fired only for a SINGLE
// multi-word result, so it left a multi-return func value on the one-word
// TrampolineScalar — the compiled caller's retbuf pointer would have landed in
// `data` (misdispatch).  A single-scalar function still selects TrampolineScalar.
func TestEnsureHandleSelectsAggregateForMultiReturn() testing.TestResult {
	var vm @VM = lowerFromSource(
			"package \"test\"\nfunc mr() (int, int) { return 1, 2 }\nfunc sc() int { return 3 }\n")
	registerTestExterns(vm)
	var mi int = vm.LookupFunc("test.mr")
	var si int = vm.LookupFunc("test.sc")
	if mi < 0 || si < 0 { return "test.mr / test.sc not found" }

	// The selection discriminator both sides agree on: types.IsAggregateReturn.
	if !vm.Funcs.Get(mi).ResultUsesRetbuf {
		return "a multi-return func must use the retbuf shim shape"
	}
	if vm.Funcs.Get(si).ResultUsesRetbuf {
		return "a scalar-return func must not use the retbuf shim shape"
	}

	ensureHandle(vm, vm.Funcs.Get(mi), mi)
	ensureHandle(vm, vm.Funcs.Get(si), si)

	var aggIdx int = vm.LookupExtern("pkg/binate/vm.TrampolineAggregate")
	var scIdx int = vm.LookupExtern("pkg/binate/vm.TrampolineScalar")
	if aggIdx < 0 || scIdx < 0 { return "trampolines not registered" }
	var aggVt *int = bit_cast(*int, vm.Externs[aggIdx].VtableAddr)
	var scVt *int = bit_cast(*int, vm.Externs[scIdx].VtableAddr)

	if vm.Funcs.Get(mi).Vtable.Call != aggVt[1] {
		return "a multi-return func must select TrampolineAggregate"
	}
	if vm.Funcs.Get(si).Vtable.Call != scVt[1] {
		return "a scalar func must select TrampolineScalar"
	}
	return ""
}

// TrampolineAggregate copies the FULL multi-return image into the caller's
// retbuf: a compiled caller passes a retbuf sized to the natural tuple type and
// reads every slot back.  Exercises the generalized (multi-result) copy — the
// old body panicked on any result list whose length was not 1, and copied only
// ResultSizes[0].  The retbuf is sized to the NATURAL image size
// (ResultRetbufBytes), and each slot lands at its ResultOffsets entry.
func TestTrampolineAggregateCopiesMultiReturn() testing.TestResult {
	var vm @VM = lowerFromSource(
			"package \"test\"\nfunc mr() (int, int) { return 11, 22 }\n")
	registerTestExterns(vm)
	var fi int = vm.LookupFunc("test.mr")
	if fi < 0 { return "test.mr not found" }
	var f @VMFunc = vm.Funcs.Get(fi)
	ensureHandle(vm, f, fi)

	var n int = f.ResultRetbufBytes
	if n <= 0 { return "multi-return retbuf image size must be > 0" }
	var retbuf @[]uint8 = make_slice(uint8, n)
	var rec *uint8 = bit_cast(*uint8, f.ClosureRec)
	TrampolineAggregate(&retbuf[0], rec, 0, 0, 0, 0, 0, 0, 0)

	var base int = bit_cast(int, &retbuf[0])
	var slot0 *int = bit_cast(*int, base + f.ResultOffsets[0])
	var slot1 *int = bit_cast(*int, base + f.ResultOffsets[1])
	if slot0[0] != 11 {
		return "first result slot must be 11"
	}
	if slot1[0] != 22 {
		return "second result slot must be 22"
	}
	return ""
}

// A 0-byte struct result routes to the SCALAR shim (ResultRetbufBytes 0), not
// the aggregate trampoline — aligning the VM with a compiled caller, whose
// types.IsAggregateReturn is false for a 0-byte result.  The old per-result
// multi-word gate classified `struct{}` as aggregate (isMultiWordField sees a
// STRUCT kind), mismatching the compiled scalar shape.
func TestEnsureHandleZeroByteStructUsesScalar() testing.TestResult {
	var vm @VM = lowerFromSource(
			"package \"test\"\ntype Empty struct {}\n"
					"func f() Empty { var e Empty\n return e }\n")
	registerTestExterns(vm)
	var fi int = vm.LookupFunc("test.f")
	if fi < 0 { return "test.f not found" }
	if vm.Funcs.Get(fi).ResultUsesRetbuf {
		return "a single 0-byte struct result must not use the retbuf shim shape"
	}
	if vm.Funcs.Get(fi).ResultRetbufBytes != 0 {
		return "a 0-byte struct result must have retbuf image size 0 (scalar shim)"
	}
	ensureHandle(vm, vm.Funcs.Get(fi), fi)
	var scIdx int = vm.LookupExtern("pkg/binate/vm.TrampolineScalar")
	if scIdx < 0 { return "TrampolineScalar not registered" }
	var scVt *int = bit_cast(*int, vm.Externs[scIdx].VtableAddr)
	if vm.Funcs.Get(fi).Vtable.Call != scVt[1] {
		return "a 0-byte struct result must select TrampolineScalar, not the aggregate trampoline"
	}
	return ""
}

// A MULTI-return tuple whose fields are ALL zero-size (`func() (Empty, Empty)`)
// still dispatches through the retbuf trampoline: a compiled caller uses the
// retbuf shim shape unconditionally for len > 1, so ResultUsesRetbuf is true even
// though the copy size (ResultRetbufBytes) is 0.  A size-based selection gate
// would wrongly pick TrampolineScalar here and land the caller's retbuf pointer
// in `data`; the 0-byte copy is a no-op.
func TestEnsureHandleAllZeroSizeMultiReturnUsesAggregate() testing.TestResult {
	var vm @VM = lowerFromSource(
			"package \"test\"\ntype Empty struct {}\n"
					"func f() (Empty, Empty) { var e Empty\n return e, e }\n")
	registerTestExterns(vm)
	var fi int = vm.LookupFunc("test.f")
	if fi < 0 { return "test.f not found" }
	if !vm.Funcs.Get(fi).ResultUsesRetbuf {
		return "an all-zero-size multi-return must use the retbuf shim shape"
	}
	if vm.Funcs.Get(fi).ResultRetbufBytes != 0 {
		return "an all-zero-size multi-return has a 0-byte copy image"
	}
	ensureHandle(vm, vm.Funcs.Get(fi), fi)
	var aggIdx int = vm.LookupExtern("pkg/binate/vm.TrampolineAggregate")
	if aggIdx < 0 { return "TrampolineAggregate not registered" }
	var aggVt *int = bit_cast(*int, vm.Externs[aggIdx].VtableAddr)
	if vm.Funcs.Get(fi).Vtable.Call != aggVt[1] {
		return "an all-zero-size multi-return must select TrampolineAggregate, not the scalar trampoline"
	}
	return ""
}
