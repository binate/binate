package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// Leak regressions for the VM func-value closure RECORD (the 4-word
// {kind, vm, fnIdx+1, captured} the capturing BC_FUNC_VALUE builds).
//
// A raw *func value (a method value or a *func closure literal) has no
// RefInc/RefDec lifecycle, so a HEAP record for it is never freed → one leaked
// block per construction.  The fix (funcValueNeedsFrameRec) homes such a record
// in the constructing FRAME instead, so it is reclaimed on frame pop and never
// leaks.  A managed @func value keeps its heap record (freed by scope-end
// RefDec) and must remain leak-free that way — the negative control below guards
// it.

// funcValueRecLeakDelta lowers `test.main`, runs it ONCE to warm up (outside the
// window), then runs it a SECOND time measuring the net change in rt.LiveBlocks()
// (written to *out).  The warm-up triggers the one-time lazy allocations a first
// func-value use makes — the wrapper's vtable + handle + shared ClosureRec
// (ensureHandle) — so they are not mistaken for a leak; the measured run adds no
// such setup, so its net is exactly the blocks the run leaks (0 iff each
// construction's record is reclaimed; the loop count on a per-construction heap
// leak).  Both runs must also return `want`, so the test verifies the record is
// read at the CORRECT address (right captured value), not merely that nothing
// leaks or crashes.
func funcValueRecLeakDelta(src *[]readonly char, want int, out *int) testing.TestResult {
	var m @ir.Module = genModule(src)
	// Raw NewVM, not newTestVM — see leak_test.bn's lowerAndDropVM: the interner
	// teardown must not run inside the rt.LiveBlocks() window.  RegisterVmTrampolines
	// is required to CALL a func value (ensureHandle installs TrampolineScalar).
	var v @VM = NewVM(testVMStackSize)
	v.LowerModule(m)
	RegisterVmTrampolines(v)
	var noArgs @[]int
	if v.CallFunc("test.main", noArgs) != want {
		return "warm-up call returned the wrong sum (record read the wrong captured value)"
	}
	var before int = rt.LiveBlocks()
	if v.CallFunc("test.main", noArgs) != want {
		return "measured call returned the wrong sum (record read the wrong captured value)"
	}
	var after int = rt.LiveBlocks()
	// Keep v and m alive past the measurement so neither's teardown is attributed
	// to the window.
	_ = v
	if m == nil {
		return "internal: module went nil"
	}
	*out = after - before
	return ""
}

// A method value (`obj.M`, a raw *func) constructed N times must not leak: its
// closure record lives in the frame, reclaimed on frame pop.  Non-vacuous —
// before the frame-record fix each of the 100 constructions rt.Alloc'd a record
// that was never freed, so this netted 100.
func TestMethodValueRecNoLeak() testing.TestResult {
	var delta int = 0
	var r testing.TestResult = funcValueRecLeakDelta(
			"package \"test\"\n"
					"type T struct {\n\tx int\n}\n"
					"func (t T) get() int { return t.x }\n"
					"func main() int {\n"
					"\tvar t T\n"
					"\tt.x = 1\n"
					"\tvar sum int = 0\n"
					"\tfor i := 0; i < 100; i = i + 1 {\n"
					"\t\tvar mv *func() int = t.get\n"
					"\t\tsum = sum + mv()\n"
					"\t}\n"
					"\treturn sum\n}\n",
			100, &delta)
	if len(r) > 0 {
		return r
	}
	if delta != 0 {
		return "method-value closure records leaked: rt.LiveBlocks() grew across main"
	}
	return ""
}

// A raw *func CLOSURE LITERAL (`var fn *func() = func(){...}`) capturing a local
// is the same raw-borrow case as a method value — its record must live in the
// frame too.  Non-vacuous for the same reason (100 un-freed records before the
// fix).
func TestRawFuncClosureLitRecNoLeak() testing.TestResult {
	var delta int = 0
	var r testing.TestResult = funcValueRecLeakDelta(
			"package \"test\"\n"
					"func main() int {\n"
					"\tvar base int = 10\n"
					"\tvar sum int = 0\n"
					"\tfor i := 0; i < 100; i = i + 1 {\n"
					"\t\tvar fn *func() int = func() int { return base }\n"
					"\t\tsum = sum + fn()\n"
					"\t}\n"
					"\treturn sum\n}\n",
			1000, &delta)
	if len(r) > 0 {
		return r
	}
	if delta != 0 {
		return "*func closure-literal records leaked: rt.LiveBlocks() grew across main"
	}
	return ""
}

// Negative control: a managed @func CLOSURE LITERAL keeps its HEAP record, freed
// by the value's scope-end RefDec each iteration.  This path is untouched by the
// frame-record fix (funcValueNeedsFrameRec excludes @func); the test guards that
// it stays leak-free — a regression that broke the heap free path (or wrongly
// routed @func through the frame slot) would net 100 here.
func TestManagedFuncClosureLitStillFrees() testing.TestResult {
	var delta int = 0
	var r testing.TestResult = funcValueRecLeakDelta(
			"package \"test\"\n"
					"func main() int {\n"
					"\tvar base int = 10\n"
					"\tvar sum int = 0\n"
					"\tfor i := 0; i < 100; i = i + 1 {\n"
					"\t\tvar fn @func() int = func() int { return base }\n"
					"\t\tsum = sum + fn()\n"
					"\t}\n"
					"\treturn sum\n}\n",
			1000, &delta)
	if len(r) > 0 {
		return r
	}
	if delta != 0 {
		return "@func closure-literal heap records leaked: scope-end RefDec did not free them"
	}
	return ""
}

// A function reference cast to a managed @func (`cast(@func(int) int, add1)`)
// takes a reference to the callee's shared per-function ClosureRec when it is
// built; the cast's result is a relabel that the variable copies (RefInc), so
// the construction's own reference must be released at the end of the
// statement.  The ClosureRec's refcount after a second run of `main` must equal
// its refcount after the first — non-vacuous: without the release it grew by one
// per loop iteration.
func TestCastFuncRefToManagedReleasesClosureRec() testing.TestResult {
	var m @ir.Module = genModule(
			"package \"test\"\n"
					"func add1(x int) int { return x + 1 }\n"
					"func main() int {\n"
					"\tvar sum int = 0\n"
					"\tfor i := 0; i < 10; i = i + 1 {\n"
					"\t\tvar a = cast(@func(int) int, add1)\n"
					"\t\tsum = sum + a(i)\n"
					"\t}\n"
					"\treturn sum\n}\n")
	var v @VM = NewVM(testVMStackSize)
	v.LowerModule(m)
	RegisterVmTrampolines(v)
	var noArgs @[]int
	if v.CallFunc("test.main", noArgs) != 55 {
		return "first call returned the wrong sum"
	}
	var fi int = v.LookupFunc("test.add1")
	if fi < 0 { return "test.add1 not found" }
	var rec *uint8 = bit_cast(*uint8, v.Funcs.Get(fi).ClosureRec)
	if rec == nil { return "add1 has no ClosureRec after a func-value use" }
	var before int = rt.Refcount(rec)
	if v.CallFunc("test.main", noArgs) != 55 {
		return "second call returned the wrong sum"
	}
	var after int = rt.Refcount(rec)
	if after != before {
		return "cast of a function reference to @func leaked references to the shared ClosureRec"
	}
	return ""
}

// A raw *func of a function reference (`var f *func(int) int = add1`) has no
// RefInc / RefDec lifecycle, so building one must leave the callee's shared
// ClosureRec refcount unchanged: the refcount after a second run of `main` must
// equal its refcount after the first.
func TestRawFuncRefLeavesClosureRec() testing.TestResult {
	var m @ir.Module = genModule(
			"package \"test\"\n"
					"func add1(x int) int { return x + 1 }\n"
					"func main() int {\n"
					"\tvar sum int = 0\n"
					"\tfor i := 0; i < 10; i = i + 1 {\n"
					"\t\tvar f *func(int) int = add1\n"
					"\t\tsum = sum + f(i)\n"
					"\t}\n"
					"\treturn sum\n}\n")
	var v @VM = NewVM(testVMStackSize)
	v.LowerModule(m)
	RegisterVmTrampolines(v)
	var noArgs @[]int
	if v.CallFunc("test.main", noArgs) != 55 {
		return "first call returned the wrong sum"
	}
	var fi int = v.LookupFunc("test.add1")
	if fi < 0 { return "test.add1 not found" }
	var rec *uint8 = bit_cast(*uint8, v.Funcs.Get(fi).ClosureRec)
	if rec == nil { return "add1 has no ClosureRec after a func-value use" }
	var before int = rt.Refcount(rec)
	if v.CallFunc("test.main", noArgs) != 55 {
		return "second call returned the wrong sum"
	}
	var after int = rt.Refcount(rec)
	if after != before {
		return "building a raw *func of a function reference leaked references to the shared ClosureRec"
	}
	return ""
}

// A NAMED managed function-value type (`type MFn @func(int) int`) built from a
// function reference is managed: it takes its reference to the shared
// ClosureRec (the lowering peels the named wrapper) and releases it at its
// scope end, so the ClosureRec refcount after a second run of `main` equals its
// refcount after the first — not lower (an over-release if the wrapper hid the
// managed kind) and not higher.
func TestNamedManagedFuncRefBalancesClosureRec() testing.TestResult {
	var m @ir.Module = genModule(
			"package \"test\"\n"
					"type MFn @func(int) int\n"
					"func add1(x int) int { return x + 1 }\n"
					"func main() int {\n"
					"\tvar sum int = 0\n"
					"\tfor i := 0; i < 10; i = i + 1 {\n"
					"\t\tvar f MFn = add1\n"
					"\t\tsum = sum + f(i)\n"
					"\t}\n"
					"\treturn sum\n}\n")
	var v @VM = NewVM(testVMStackSize)
	v.LowerModule(m)
	RegisterVmTrampolines(v)
	var noArgs @[]int
	if v.CallFunc("test.main", noArgs) != 55 {
		return "first call returned the wrong sum"
	}
	var fi int = v.LookupFunc("test.add1")
	if fi < 0 { return "test.add1 not found" }
	var rec *uint8 = bit_cast(*uint8, v.Funcs.Get(fi).ClosureRec)
	if rec == nil { return "add1 has no ClosureRec after a func-value use" }
	var before int = rt.Refcount(rec)
	if v.CallFunc("test.main", noArgs) != 55 {
		return "second call returned the wrong sum"
	}
	var after int = rt.Refcount(rec)
	if after != before {
		return "a named @func of a function reference did not balance its ClosureRec reference"
	}
	return ""
}
