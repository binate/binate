package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/std/vec"

// Cross-mode interface-value substitution shared by the RETURN and ARGUMENT
// directions, including NESTED (struct / array) interface fields, built on the
// buildNativeIfaceVtable machinery in vm_iface_native_vt.bn (the per-index
// NativeVt cache + the ifaceVtIsNative range discrimination).
//
// A bytecode impl's VM-index vtable word cannot be dereferenced by injected-
// native code (SIGSEGV).  Every crossing where such a word would reach native
// code is closed by the SAME substitution — swap each VM-index vtable word for
// the impl's native handle-vtable:
//   - an interface ARGUMENT (top-level, OR nested in a by-value struct / array)
//     passed to an injected-native callee (substArgSlotIface, driven by the per-
//     call-site ArgIfaceLayout the caller VMFunc carries),
//   - a value RETURNED by a VM method to native code (native errors.Is calling a
//     user Unwrap that returns ANOTHER user impl), top-level or nested in the
//     result aggregate (VMFunc.ResultIfaceVtOffsets, consumed by the aggregate
//     trampoline).
// Both directions reuse ifaceVtOffsetsFor (the recursive byte-offset list) and
// substituteVtWords.  The image is always a COPY native code owns (a retbuf, or
// scratch on vm.Stack) — never a VM-owned box — so identity (`same` on the data
// ptr, which is copied verbatim) survives and no VM value is mutated in place.

// collectIfaceVtOffsets appends, to `out`, the BYTE offset of every interface-
// value VTABLE WORD inside a value of type `t` laid out in memory at byte
// `base`.  An interface value contributes one offset (base +
// IfaceValueVtableIndex()*REG_SLOT); a struct recurses into each field at its
// FieldOffset; an array recurses into each element at its stride; alias / named /
// readonly wrappers are peeled.  A func value is deliberately NOT collected: a
// VM-built func value already carries a native trampoline vtable word (ensure-
// Handle), so it needs no translation — only interface values carry the VM
// index that native code cannot dereference.  The REG_SLOT stride matches the
// `iv *int` word indexing buildNativeIfaceVtable and substArgSlotIface use, and
// equals the target pointer size types layout uses for FieldOffset in the VM
// (host == target), so nested field offsets and the in-iface word offset agree.
func collectIfaceVtOffsets(t @types.Type, base int, out @vec.Vec[int]) {
	if t == nil {
		return
	}
	t = t.ResolveAlias()
	if t == nil {
		return
	}
	if t.Kind == types.TYP_READONLY && t.Elem != nil {
		collectIfaceVtOffsets(t.Elem, base, out)
		return
	}
	if t.Kind == types.TYP_NAMED && t.Underlying != nil {
		collectIfaceVtOffsets(t.Underlying, base, out)
		return
	}
	if t.Kind == types.TYP_INTERFACE_VALUE || t.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		out.Push(base + types.IfaceValueVtableIndex() * REG_SLOT)
		return
	}
	if t.Kind == types.TYP_STRUCT {
		for i := 0; i < len(t.Fields); i++ {
			collectIfaceVtOffsets(t.Fields[i].Type, base + t.FieldOffset(i), out)
		}
		return
	}
	if t.Kind == types.TYP_ARRAY {
		if t.Elem == nil || t.ArrayLen == 0 {
			return
		}
		var stride int = t.Elem.SizeOf()
		for i := 0; i < t.ArrayLen; i++ {
			collectIfaceVtOffsets(t.Elem, base + i * stride, out)
		}
		return
	}
	// Scalars, pointers, managed pointers, raw/managed slices, and func values
	// carry no directly-embedded interface value; nothing to collect.
}

// ifaceVtOffsetsFor returns the byte-offset list of type t's interface vtable
// words (base 0), or an empty slice when t carries none.  Thin wrapper over
// collectIfaceVtOffsets for the lower-time metadata builders (result offsets on
// VMFunc, per-arg struct plans in lower_call.bn).
func ifaceVtOffsetsFor(t @types.Type) @[]int {
	var out @vec.Vec[int] = vec.New[int]()
	collectIfaceVtOffsets(t, 0, out)
	return out.Items()
}

// ifaceVtOffsetsForResults returns the byte offsets of every interface vtable
// word across a function's whole result list, each result's offsets shifted by
// its tuple offset (offsets[i] == VMFunc.ResultOffsets[i]).  This covers a MULTI-
// return: an interface value in any tuple slot needs its VM-index vtable word
// substituted in the retbuf copy, not just a single result.  For a single result
// offsets[0] is 0, so this reduces to ifaceVtOffsetsFor(results[0]).  Empty for a
// void result (the loop does not run).
func ifaceVtOffsetsForResults(results @[]@types.Type, offsets @[]int) @[]int {
	var out @vec.Vec[int] = vec.New[int]()
	for i := 0; i < len(results); i++ {
		collectIfaceVtOffsets(results[i], offsets[i], out)
	}
	return out.Items()
}

// substituteVtWords rewrites, IN PLACE, each interface-value vtable word at the
// given byte offsets inside the native-owned image at `imageInt`: a word that is
// a VM index (a bytecode impl, !ifaceVtIsNative) is replaced by that impl's
// native handle-vtable (buildNativeIfaceVtable, VM-lifetime immortal); a null
// (nil-iface sentinel) or already-native word is left untouched.  The image MUST
// be a copy native code owns (a retbuf, or scratch on vm.Stack) — mutating a
// VM-owned box in place would corrupt `same`/identity.  Only the vtable word is
// touched; the data pointer beside it is left as the copy already carries it.
func substituteVtWords(vm @VM, imageInt int, offsets @[]int) {
	for i := 0; i < len(offsets); i++ {
		var wordPtr *int = bit_cast(*int, imageInt + offsets[i])
		var vtWord int = wordPtr[0]
		if vtWord == 0 {
			continue
		}
		if ifaceVtIsNative(vm, vtWord) {
			continue
		}
		wordPtr[0] = buildNativeIfaceVtable(vm, vm.IfaceVtables.Get(vtWord - 1))
	}
}

// argIfaceLayoutFor resolves the 1-based argument-interface-layout index a call
// instruction carries against the CALLER's VMFunc.ArgIfaceLayouts, returning the
// layout (or nil for index 0 = no interface args).  The three cross-mode
// dispatchers call this with the caller VMFunc and the decoded Imm layout index.
func argIfaceLayoutFor(caller @VMFunc, idx int) @ArgIfaceLayout {
	if idx == 0 {
		return nil
	}
	return caller.ArgIfaceLayouts[idx - 1]
}

// substArgSlotIface performs the ARGUMENT-direction interface substitution for
// ONE by-address argument slot crossing bytecode -> injected-native, handling an
// aggregate arg carrying nested interface fields as well as a top-level interface.
// `argPtr` is the register value for the slot (the address of the argument's image
// on vm.Stack); `e` lists the interface vtable-word byte offsets inside that image
// and its copy size.  If ANY listed word is a VM index (a bytecode impl the native
// callee cannot dereference), it writes a fresh COPY of the whole image onto
// vm.Stack, rewrites each such word to the impl's native handle-vtable in the copy,
// and returns the copy's address; otherwise (every word already native / the nil
// sentinel, or a nil argPtr) it returns argPtr UNCHANGED, never copying and never
// touching the VM-owned original.  A top-level interface arg is the degenerate
// single-offset case: its 2-word image is copied verbatim except the one vtable
// word, preserving the data pointer (so `same`/`present`/identity hold).
//
// The copy rides vm.Stack exactly like the aggregate retbuf and the S2 top-level
// copy: it is scratch that only has to outlive the synchronous native call and is
// reclaimed at the next statement boundary (BC_SP_RESTORE).  A callee that
// RETAINS the argument copies it BY VALUE into its own storage — that copy carries
// the immortal native vtable word and the real data pointer, never the scratch
// address — so the reclaim dangles nothing, exactly as for any by-value aggregate
// argument passed through a caller temp.
func substArgSlotIface(vm @VM, argPtr int, e @ArgSlotIfaceLayout) int {
	if argPtr == 0 {
		return argPtr
	}
	var needsCopy bool = false
	for i := 0; i < len(e.Offsets); i++ {
		var wordPtr *int = bit_cast(*int, argPtr + e.Offsets[i])
		var w int = wordPtr[0]
		if w != 0 && !ifaceVtIsNative(vm, w) {
			needsCopy = true
		}
	}
	if !needsCopy {
		return argPtr
	}
	// Copy exactly ByteSize (the type's SizeOf, never over-reading the source), but
	// advance vm.SP by the 8-rounded size so the next scratch stays 8-aligned —
	// matching the aggregate-retbuf reservation granularity, since vm.Stack holds
	// ≤8-byte-aligned aggregates.
	var copyInt int = bit_cast(int, vm.Stack) + vm.SP
	vm.SP = vm.SP + (e.ByteSize + 7) / 8 * 8
	rt.MemCopy(bit_cast(*uint8, copyInt), bit_cast(*readonly uint8, argPtr), e.ByteSize)
	substituteVtWords(vm, copyInt, e.Offsets)
	return copyInt
}

// substituteLayoutArgs applies a call site's ArgIfaceLayout to the packed extern
// arg array IN PLACE: for each slot the layout lists, args[slot] is replaced by
// substArgSlotIface's native-handle-vtable copy when the arg carries a bytecode
// impl (top-level or nested).  Used by the extern dispatch, whose args are already
// an array; the func-value / iface-method siblings drive the same substArgSlot-
// Iface over their a0..a6 register locals.
func substituteLayoutArgs(vm @VM, args @[]int, layout @ArgIfaceLayout) {
	for i := 0; i < len(layout.Slots); i++ {
		var e @ArgSlotIfaceLayout = layout.Slots[i]
		args[e.Slot] = substArgSlotIface(vm, args[e.Slot], e)
	}
}
