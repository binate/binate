package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// Argument-direction cross-mode interface substitution: a bytecode-impl
// interface value passed as an argument to an
// injected-native callee — top-level OR nested in a by-value struct — must have
// its VM-index vtable word substituted for the impl's native handle-vtable before
// the callee dispatches / RefDecs it.  The lowered per-call ArgIfaceLayout drives
// it; substArgSlotIface performs the non-destructive copy + substitution.  Uses
// ifaceVtSource / registerTestExterns from the sibling test files (same package).

// topLevelIfaceEntry builds the ArgSlotIfaceLayout for a TOP-LEVEL interface arg
// (slot 0): a 2-word image whose single vtable-word offset is the in-iface one.
func topLevelIfaceEntry() @ArgSlotIfaceLayout {
	var e @ArgSlotIfaceLayout = make(ArgSlotIfaceLayout)
	e.Slot = 0
	e.ByteSize = 2 * REG_SLOT
	e.Offsets = make_slice(int, 1)
	e.Offsets[0] = types.IfaceValueVtableIndex() * REG_SLOT
	return e
}

// pairStructType builds a by-VALUE struct type { a @iface; n int; b @iface } — two
// interface fields around a scalar — whose two nested iface vtable words sit at
// REG_SLOT (field a) and 4*REG_SLOT (field b at struct offset 3*REG_SLOT).
func pairStructType(iface @types.Type) @types.Type {
	var fa @types.Field = make(types.Field)
	fa.Name = "a"
	fa.Type = types.MakeManagedInterfaceValueType(iface)
	var fn @types.Field = make(types.Field)
	fn.Name = "n"
	fn.Type = types.TypInt()
	var fb @types.Field = make(types.Field)
	fb.Name = "b"
	fb.Type = types.MakeManagedInterfaceValueType(iface)
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	fields[0] = fa
	fields[1] = fn
	fields[2] = fb
	return types.MakeStructType("PairStruct", fields)
}

// nestedPairEntry is the ArgSlotIfaceLayout for a by-value PairStruct arg (slot 0):
// a 5-word image with the two nested iface vtable-word offsets.
func nestedPairEntry() @ArgSlotIfaceLayout {
	var e @ArgSlotIfaceLayout = make(ArgSlotIfaceLayout)
	e.Slot = 0
	e.ByteSize = 5 * REG_SLOT
	e.Offsets = make_slice(int, 2)
	e.Offsets[0] = REG_SLOT
	e.Offsets[1] = 4 * REG_SLOT
	return e
}

// nestedPairLayout wraps nestedPairEntry into a single-slot ArgIfaceLayout.
func nestedPairLayout() @ArgIfaceLayout {
	var layout @ArgIfaceLayout = make(ArgIfaceLayout)
	layout.Slots = make_slice(@ArgSlotIfaceLayout, 1)
	layout.Slots[0] = nestedPairEntry()
	return layout
}

// obsPair mirrors PairStruct's in-memory layout as raw words so a native callee
// can read each interface field's data/vtable word directly: { a.data, a.vt, n,
// b.data, b.vt }.
type obsPair struct {
	aData int
	aVt   int
	n     int
	bData int
	bVt   int
}

// observePair is the crafted injected-native callee: it receives the by-value
// struct through the REAL cross-mode shim and reports what its two interface
// fields' vtable words look like from native code AFTER substitution.  Returns the
// shared native handle-vtable word when BOTH fields were substituted off the VM
// index (1) to the SAME native word (so native code can dispatch/RefDec them), -1
// if either still carries the raw VM index (unsubstituted — the pre-fix bug), -2
// if the two disagree.
func observePair(s obsPair) int {
	if s.aVt == 1 || s.bVt == 1 {
		return -1
	}
	if s.aVt != s.bVt {
		return -2
	}
	return s.aVt
}

// substArgSlotIface on a TOP-LEVEL interface arg (the degenerate single-offset
// case): a bytecode-impl iface value {data, vtable_word=1} is copied with its
// vtable word substituted for the native handle-vtable, the data pointer
// preserved, and the original block left untouched.
func TestSubstArgSlotIfaceTopLevel() testing.TestResult {
	var vm @VM = lowerFromSource(ifaceVtSource())
	registerTestExterns(vm)
	if vm.IfaceVtables.Len() < 1 {
		return "expected a lowered impl vtable"
	}
	var iv *int = bit_cast(*int, rt.RawAlloc(2 * REG_SLOT))
	var fakeData int = 12345
	iv[types.IfaceValueDataIndex()] = fakeData
	iv[types.IfaceValueVtableIndex()] = 1
	var ivInt int = bit_cast(int, iv)
	var sub int = substArgSlotIface(vm, ivInt, topLevelIfaceEntry())
	if sub == ivInt {
		return "a bytecode-impl iface arg must be replaced with a copy"
	}
	var copyPtr *int = bit_cast(*int, sub)
	if copyPtr[types.IfaceValueDataIndex()] != fakeData {
		return "copy must preserve the original data pointer"
	}
	if !ifaceVtIsNative(vm, copyPtr[types.IfaceValueVtableIndex()]) {
		return "copy's vtable word must be a native address"
	}
	if copyPtr[types.IfaceValueVtableIndex()] != vm.IfaceVtables.Get(0).NativeVt {
		return "copy's vtable word must be the built native handle-vtable"
	}
	if iv[types.IfaceValueDataIndex()] != fakeData || iv[types.IfaceValueVtableIndex()] != 1 {
		return "the original iface block must not be mutated"
	}
	return ""
}

// substArgSlotIface leaves an already-native vtable word (or the nil arg) as-is —
// no copy, no mutation.
func TestSubstArgSlotIfaceLeavesNativeAndNil() testing.TestResult {
	var vm @VM = lowerFromSource(ifaceVtSource())
	registerTestExterns(vm)
	var nativeWord int = 0x40000000
	var iv *int = bit_cast(*int, rt.RawAlloc(2 * REG_SLOT))
	iv[types.IfaceValueDataIndex()] = 999
	iv[types.IfaceValueVtableIndex()] = nativeWord
	var ivInt int = bit_cast(int, iv)
	if substArgSlotIface(vm, ivInt, topLevelIfaceEntry()) != ivInt {
		return "an already-native iface arg must be left as-is (no copy)"
	}
	if substArgSlotIface(vm, 0, topLevelIfaceEntry()) != 0 {
		return "a nil iface arg must be left as 0"
	}
	return ""
}

// substArgSlotIface on a by-VALUE struct with TWO nested interface fields — the
// case the removed flat top-level substitution could not reach.  BOTH nested
// vtable words are substituted in the copy; data + scalar fields preserved; the
// original untouched.  The BEFORE control replays the old single-top-level-offset
// substitution on a fresh copy to make the miss concrete: it touches only field a
// and leaves field b's nested word a VM index.
func TestSubstArgSlotIfaceNestedStruct() testing.TestResult {
	var vm @VM = lowerFromSource(ifaceVtSource())
	registerTestExterns(vm)
	if vm.IfaceVtables.Len() < 1 {
		return "expected a lowered impl vtable"
	}
	var s *int = bit_cast(*int, rt.RawAlloc(5 * REG_SLOT))
	s[0] = 111
	s[1] = 1
	s[2] = 42
	s[3] = 222
	s[4] = 1
	var sub int = substArgSlotIface(vm, bit_cast(int, s), nestedPairEntry())
	var wantVt int = vm.IfaceVtables.Get(0).NativeVt
	if sub == bit_cast(int, s) {
		return "a nested-iface struct arg must be copied and substituted"
	}
	var c *int = bit_cast(*int, sub)
	if c[1] != wantVt || c[4] != wantVt {
		return "BOTH nested vtable words must be substituted to the native handle-vtable"
	}
	if c[0] != 111 || c[2] != 42 || c[3] != 222 {
		return "the copy must preserve both data pointers and the scalar field"
	}
	if s[1] != 1 || s[4] != 1 {
		return "the original struct's vtable words must not be mutated"
	}
	// BEFORE control: the removed top-level-only substitution used a SINGLE offset
	// (the in-iface vtable-word offset), so on this aggregate it substitutes only
	// field a and MISSES field b's nested word.
	var s3 *int = bit_cast(*int, rt.RawAlloc(5 * REG_SLOT))
	s3[0] = 111
	s3[1] = 1
	s3[2] = 42
	s3[3] = 222
	s3[4] = 1
	var oneOff @[]int = make_slice(int, 1)
	oneOff[0] = types.IfaceValueVtableIndex() * REG_SLOT
	substituteVtWords(vm, bit_cast(int, s3), oneOff)
	if s3[1] != wantVt {
		return "control: the single top-level offset should still substitute field a"
	}
	if s3[4] != 1 {
		return "control: a single top-level offset leaves field b's nested word a VM "
				"index (the miss the general layout closes)"
	}
	return ""
}

// End-to-end (the general capability): a CRAFTED injected-native package function
// (observePair) whose signature takes a by-VALUE struct with two interface fields
// is registered, then a bytecode caller passes a struct whose fields hold a
// bytecode impl (VM index 1).  Dispatched through the REAL extern path
// (dispatchExternBinding), the callee observes BOTH nested vtable words substituted
// to the impl's native handle-vtable (so it can dispatch/RefDec them), and the
// copy preserves the data pointers while the VM-owned original is untouched.  The
// BEFORE control (nil layout — what the old flat top-level bitmap yielded for a
// struct arg, since a struct is not itself an interface value) shows the callee
// otherwise seeing the raw VM-index words: the SIGSEGV-on-dispatch bug.
func TestExternDispatchNestedStructArgSubstituted() testing.TestResult {
	var vm @VM = lowerFromSource(ifaceVtSource())
	registerTestExterns(vm)
	if vm.IfaceVtables.Len() < 1 {
		return "expected a lowered impl vtable"
	}
	// RegisterExtern is the primitive RegisterPackageFunctions calls per
	// FunctionInfo; using it directly is the same injection a crafted
	// @reflect.Package descriptor would drive for this native function.
	var ofv *func(obsPair) int = observePair
	vm.RegisterExtern("test.observePair", bit_cast(*uint8, &ofv), scalarResult,
			bit_cast(int, _func_handle(observePair)))
	var bi int = vm.LookupExtern("test.observePair")
	if bi < 0 {
		return "observePair not registered"
	}

	var s *int = bit_cast(*int, rt.RawAlloc(5 * REG_SLOT))
	s[0] = 0xA11
	s[1] = 1
	s[2] = 42
	s[3] = 0xB22
	s[4] = 1
	var args @[]int = make_slice(int, 7)
	args[0] = bit_cast(int, s)
	var r int = cast(int, dispatchExternBinding(vm, vm.Externs[bi], args, false, nestedPairLayout(),
			0))
	var wantVt int = vm.IfaceVtables.Get(0).NativeVt
	if wantVt == 0 {
		return "the native handle-vtable must have been built during substitution"
	}
	if r != wantVt {
		return "the injected-native callee must observe BOTH nested iface fields "
				"substituted to the impl's native handle-vtable"
	}
	// The copy dispatchExternBinding pointed the arg at carries the substituted
	// words and PRESERVED data; the VM-owned original is untouched.
	if args[0] == bit_cast(int, s) {
		return "a nested-iface struct arg must be replaced with a copy"
	}
	var c *int = bit_cast(*int, args[0])
	if c[1] != wantVt || c[4] != wantVt {
		return "both nested vtable words in the copy must be the native handle-vtable"
	}
	if c[0] != 0xA11 || c[3] != 0xB22 {
		return "the copy must preserve both interface fields' data pointers"
	}
	if s[1] != 1 || s[4] != 1 || s[0] != 0xA11 || s[3] != 0xB22 {
		return "the original struct must not be mutated (identity survives)"
	}

	// BEFORE control: no layout -> no substitution -> the native callee sees the raw
	// VM indices.
	var s2 *int = bit_cast(*int, rt.RawAlloc(5 * REG_SLOT))
	s2[0] = 0xA11
	s2[1] = 1
	s2[2] = 42
	s2[3] = 0xB22
	s2[4] = 1
	var args2 @[]int = make_slice(int, 7)
	args2[0] = bit_cast(int, s2)
	var r2 int = cast(int, dispatchExternBinding(vm, vm.Externs[bi], args2, false, nil, 0))
	if r2 != -1 {
		return "control: with no layout the native callee must see the raw VM-index "
				"words (the pre-fix behavior this closes)"
	}
	return ""
}

// Lowering builds the ArgIfaceLayout on the caller VMFunc: a bytecode call to an
// injected extern taking a by-VALUE struct with two interface fields must produce
// one layout whose slot lists BOTH nested vtable-word offsets — the static-type
// fact the flat top-level bitmap could not represent.
func TestArgIfaceLayoutLoweredForExternStructArg() testing.TestResult {
	var iface @types.Type = types.MakeInterfaceType("test", "Shape")
	var pairTyp @types.Type = pairStructType(iface)

	var m @ir.Module = ir.NewModule("\"test\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var fn @ir.Func = ir.NewFunc("", "main", noParams, results)
	var entry @ir.Block = ir.AddBlock(fn, "entry")
	// Only the arg's TYPE drives the layout; a zero aggregate value is enough.
	var arg @ir.Instr = entry.EmitConstNil(pairTyp)
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = arg
	var call @ir.Instr = entry.EmitCall("test.sink", args, types.TypInt())
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = call
	entry.EmitReturn(retArgs)
	m.AddFunc(fn)

	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	// Register sink so callTargetIsExtern is true at lower time (never called here).
	var sfv *func(obsPair) int = observePair
	vm.RegisterExtern("test.sink", bit_cast(*uint8, &sfv), scalarResult,
			bit_cast(int, _func_handle(observePair)))
	vm.LowerModule(m)

	var mi int = vm.LookupFunc("test.main")
	if mi < 0 {
		return "test.main not lowered"
	}
	var mf @VMFunc = vm.Funcs.Get(mi)
	if len(mf.ArgIfaceLayouts) != 1 {
		return "lowering must build exactly one arg-iface layout for the struct-arg call"
	}
	var lay @ArgIfaceLayout = mf.ArgIfaceLayouts[0]
	if len(lay.Slots) != 1 {
		return "the call has one interface-carrying arg slot"
	}
	var e @ArgSlotIfaceLayout = lay.Slots[0]
	if e.Slot != 0 {
		return "the struct arg packs at slot 0"
	}
	if e.ByteSize != pairTyp.SizeOf() {
		return "ByteSize must be the struct's SizeOf"
	}
	if len(e.Offsets) != 2 {
		return "PairStruct nests two interface vtable words"
	}
	if e.Offsets[0] != REG_SLOT {
		return "field a's vtable word must be at REG_SLOT"
	}
	if e.Offsets[1] != 4 * REG_SLOT {
		return "field b's vtable word must be at 4*REG_SLOT"
	}
	return ""
}

// A vm-func BC_CALL (not an extern target) builds NO arg-iface layout even when it
// passes an interface value: only cross-mode (extern) calls dispatch native code,
// so a vm-func call never substitutes — keeping the per-function index space to
// exactly the cross-mode sites.
func TestNoArgIfaceLayoutForVmFuncCall() testing.TestResult {
	var vm @VM = lowerFromSource(
			"package \"test\"\n"
					"interface Shape { Area() int }\n"
					"type sq struct { side int }\n"
					"func (s @sq) Area() int { return s.side * s.side }\n"
					"impl @sq : Shape\n"
					"func take(x @Shape) int { return x.Area() }\n"
					"func main() int { return take(make(sq)) }\n")
	var mi int = vm.LookupFunc("test.main")
	if mi < 0 {
		return "test.main not lowered"
	}
	// main calls the vm-func `take` with an interface arg, but `take` is a bytecode
	// function (not a registered extern), so no layout is built.
	if len(vm.Funcs.Get(mi).ArgIfaceLayouts) != 0 {
		return "a vm-func call must not build an arg-iface layout"
	}
	return ""
}
