package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/builtins/testing"

// findFuncByName returns the VMFunc whose Name equals `name`, or nil.
func findFuncByName(vm @VM, name *[]readonly char) @VMFunc {
	for i := 0; i < vm.Funcs.Len(); i++ {
		if streq(vm.Funcs.Get(i).Name, name) {
			return vm.Funcs.Get(i)
		}
	}
	var none @VMFunc
	return none
}

// crossmodeSource lowers a package with three functions whose single results
// exercise collectIfaceVtOffsets: a plain int (no iface word), a top-level
// interface value (one word), and a struct carrying two interface fields around a
// scalar (two words, recursed).
func crossmodeSource() @[]char {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "interface Shape { Area() int }\n")
	src = concatStr(src, "type sq struct { side int }\n")
	src = concatStr(src, "func (s @sq) Area() int { return s.side * s.side }\n")
	src = concatStr(src, "impl @sq : Shape\n")
	src = concatStr(src, "type Pair struct { a @Shape; n int; b @Shape }\n")
	src = concatStr(src, "func retInt() int { return 7 }\n")
	src = concatStr(src, "func retIface() @Shape { return make(sq) }\n")
	// A multi-return whose second slot is an interface value: its vtable word must
	// be collected too (shifted by the slot's tuple offset), which single-result-
	// only collection would miss.
	src = concatStr(src, "func retTuple() (int, @Shape) { return 9, make(sq) }\n")
	// Pair (by VALUE, not @Pair): the struct's iface fields ride inline in the
	// aggregate result, which is what the nested-return recursion must find.
	src = concatStr(src, "func retPair() Pair {\n")
	src = concatStr(src, "	var p Pair\n")
	src = concatStr(src, "	p.a = make(sq)\n")
	src = concatStr(src, "	p.n = 5\n")
	src = concatStr(src, "	p.b = make(sq)\n")
	src = concatStr(src, "	return p\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() {\n")
	src = concatStr(src, "	var i int = retInt()\n")
	src = concatStr(src, "	var s @Shape = retIface()\n")
	src = concatStr(src, "	var p Pair = retPair()\n")
	src = concatStr(src, "	var tn int\n")
	src = concatStr(src, "	var ts @Shape\n")
	src = concatStr(src, "	tn, ts = retTuple()\n")
	src = concatStr(src, "	_ = i\n")
	src = concatStr(src, "	_ = s\n")
	src = concatStr(src, "	_ = p\n")
	src = concatStr(src, "	_ = tn\n")
	src = concatStr(src, "	_ = ts\n")
	src = concatStr(src, "}\n")
	return src
}

// A scalar (non-aggregate) result carries no interface vtable word, so its
// ResultIfaceVtOffsets is empty and TrampolineAggregate never substitutes.
func TestResultIfaceVtOffsetsScalar() testing.TestResult {
	var vm @VM = lowerFromSource(crossmodeSource())
	var f @VMFunc = findFuncByName(vm, "test.retInt")
	if f == nil {
		return "test.retInt not lowered"
	}
	if len(f.ResultIfaceVtOffsets) != 0 {
		return "an int result must carry no iface vtable-word offsets"
	}
	return ""
}

// A top-level interface result contributes exactly one vtable-word offset — the
// vtable word within the 2-word iface value (IfaceValueVtableIndex()*REG_SLOT).
func TestResultIfaceVtOffsetsTopLevel() testing.TestResult {
	var vm @VM = lowerFromSource(crossmodeSource())
	var f @VMFunc = findFuncByName(vm, "test.retIface")
	if f == nil {
		return "test.retIface not lowered"
	}
	if len(f.ResultIfaceVtOffsets) != 1 {
		return "a top-level iface result must carry exactly one vtable-word offset"
	}
	if f.ResultIfaceVtOffsets[0] != types.IfaceValueVtableIndex() * REG_SLOT {
		return "the iface vtable-word offset must be IfaceValueVtableIndex()*REG_SLOT"
	}
	return ""
}

// A struct result with two interface fields around a scalar contributes TWO
// vtable-word offsets — collectIfaceVtOffsets recursing into the struct fields at
// their FieldOffsets.  Layout on any host: a @Shape at 0 (word at REG_SLOT),
// n int at 2*REG_SLOT, b @Shape at 3*REG_SLOT (word at 4*REG_SLOT).
func TestResultIfaceVtOffsetsNestedStruct() testing.TestResult {
	var vm @VM = lowerFromSource(crossmodeSource())
	var f @VMFunc = findFuncByName(vm, "test.retPair")
	if f == nil {
		return "test.retPair not lowered"
	}
	if len(f.ResultIfaceVtOffsets) != 2 {
		return "a struct with two iface fields must yield two vtable-word offsets"
	}
	if f.ResultIfaceVtOffsets[0] != REG_SLOT {
		return "first iface field's vtable word must be at REG_SLOT (field 0, word 1)"
	}
	if f.ResultIfaceVtOffsets[1] != 4 * REG_SLOT {
		return "second iface field's vtable word must be at 4*REG_SLOT (field b at 3*REG_SLOT)"
	}
	return ""
}

// A MULTI-RETURN (int, @Shape) contributes one vtable-word offset — the iface
// slot's, shifted by that slot's tuple offset (ResultOffsets[1]).  Before the
// offsets were collected across all results (not just a single one), this was
// empty and CallFuncAggregate left the retbuf's iface word an unusable VM index.
func TestResultIfaceVtOffsetsMultiReturn() testing.TestResult {
	var vm @VM = lowerFromSource(crossmodeSource())
	var f @VMFunc = findFuncByName(vm, "test.retTuple")
	if f == nil {
		return "test.retTuple not lowered"
	}
	if len(f.ResultIfaceVtOffsets) != 1 {
		return "a (int, @Shape) tuple must carry exactly one vtable-word offset (the @Shape slot)"
	}
	var want int = f.ResultOffsets[1] + types.IfaceValueVtableIndex() * REG_SLOT
	if f.ResultIfaceVtOffsets[0] != want {
		return "the iface vtable word must be at ResultOffsets[1] + IfaceValueVtableIndex()*REG_SLOT"
	}
	return ""
}

// End-to-end: calling the multi-return through CallFuncAggregate must leave the
// @Shape slot's vtable word in the retbuf a NATIVE handle-vtable (substituted
// from the bytecode impl's VM index), so a native host could dereference it.
func TestCallFuncAggregateMultiReturnIfaceSubstituted() testing.TestResult {
	var vm @VM = lowerFromSource(crossmodeSource())
	// Executing retTuple constructs an interface value, which needs the cross-mode
	// dispatch trampolines bound (ensureHandle looks them up by name).
	RegisterVmTrampolines(vm)
	var f @VMFunc = findFuncByName(vm, "test.retTuple")
	if f == nil {
		return "test.retTuple not lowered"
	}
	var retSize int = f.ResultOffsets[1] + 2 * REG_SLOT // int slot + 2-word iface
	var retbuf @[]uint8 = make_slice(uint8, retSize)
	var noArgs @[]int
	vm.CallFuncAggregate("test.retTuple", noArgs, &retbuf[0], retSize)
	var vtOff int = f.ResultOffsets[1] + types.IfaceValueVtableIndex() * REG_SLOT
	var vtWordPtr *int = bit_cast(*int, bit_cast(int, &retbuf[0]) + vtOff)
	if !ifaceVtIsNative(vm, vtWordPtr[0]) {
		return "the retbuf iface vtable word must be substituted to a native handle-vtable"
	}
	return ""
}
