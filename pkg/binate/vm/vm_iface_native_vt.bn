package "pkg/binate/vm"

import "pkg/binate/vmdata"

import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/stdx/slices"

// g_crossModeVmAddr is the VM currently dispatching an injected-native callee — set
// (and restored, for re-entrancy) around each native dispatch (dispatchExternBinding,
// dispatchCompiledFuncValue, dispatchCompiledIfaceMethod) so that a native
// rt.SatLookup MISS, routed through the
// installed rt fallback (satFallbackFn), can reach THIS VM's satentry registry.  A
// raw address, not an @VM, so the global never perturbs the VM's own refcount.
// 0 = no VM is currently dispatching native code, so the fallback declines.
var g_crossModeVmAddr int = 0

// InstallSatFallback wires satFallbackFn as rt.SatLookup's MISS fallback (rt
// SetSatFallback).  The host calls it once at VM setup (RegisterVmTrampolines), so
// an injected-native callee's `x.(*J)` on a bytecode-boxed value whose (T,J) fact
// lives only VM-side resolves through the VM registry rather than MISSing.
func InstallSatFallback() {
	rt.SetSatFallback(satFallbackFn)
}

// satFallbackFn is the rt.SetSatFallback resolver: on a native rt.SatLookup MISS it
// consults the executing VM's own satentry registry (lookupSatEntry) so a `(T, J)`
// fact that lives only VM-side — a bytecode program's own user type asserted by
// injected-native code — still resolves.  A VM-index result (a bytecode-lowered
// impl) is translated to a native handle-vtable (buildNativeIfaceVtable) so the
// recovered value's method re-enters the VM; a native `@__ivt` result (an injected
// package) is returned as-is (ifaceVtIsNative discriminates).  Non-capturing (reads
// the g_crossModeVmAddr global), as an rt `*func` requires.
func satFallbackFn(ti *uint8, id *uint8) *uint8 {
	if g_crossModeVmAddr == 0 {
		return nil
	}
	var vm @VM = bit_cast(@VM, g_crossModeVmAddr)
	var w int = lookupSatEntry(vm, bit_cast(int, ti), bit_cast(int, id))
	if w == 0 {
		return nil
	}
	if ifaceVtIsNative(vm, w) {
		return bit_cast(*uint8, w)
	}
	return bit_cast(*uint8, buildNativeIfaceVtable(vm, vm.IfaceVtables.Get(w - 1)))
}

// Cross-mode interface-value marshalling.
//
// A bytecode (user) impl's interface value carries a VM-index vtable word (a
// 1-based index into vm.IfaceVtables), which an injected-NATIVE stdlib callee
// (e.g. errors.Is) cannot dereference — native code treats the vtable word as
// a native @__ivt pointer and faults on the small index.  At the bytecode →
// native marshalling boundary (the extern, func-value and native interface-method
// dispatchers), every interface-typed
// arg whose word is a VM index is replaced by a COPY pointing at a NATIVE
// handle-based vtable built from the same vm.IfaceVtables entry, so the callee's
// RefDec (slot 0) and method dispatch (method slots) re-enter the VM through the
// func-value handle convention native dispatch was unified onto.

// buildNativeIfaceVtable returns the native handle-based vtable for a bytecode
// impl's vm.IfaceVtables entry, building it once and caching the address on the
// entry (vt.NativeVt).  The layout mirrors the native @__ivt an equivalent
// compiled impl would carry (the concat any-block layout fillVtableLayout
// produced into vt.Methods), so a native upcast that advances the vtable pointer
// by whole slots still lands on a correctly-shaped sub-block:
//   - a slot holding a 1-based VM function index (dtor slot 0, or a method slot)
//     becomes that VMFunc's {vtable, data} HANDLE — ensureHandle builds the
//     universal-trampoline vtable + VMClosureRec{vm, fnIdx} once and shares it,
//     so native `handle.vtable.call(handle.data, recv, args)` / `_call_dtor
//     (handle, ptr)` re-enter execFunc.  A 0 (no dtor / a method the impl didn't
//     resolve locally) stays 0 — native code reads a null dtor as "just free".
//   - the *TypeInfo slot (slot 1, and each nested any-block's slot 1) is a
//     materialized `__typeinfo.<R>` record address, passed through verbatim.
// The two are told apart by RANGE, the same discipline ifaceVtIsNative uses for
// the vtable word itself: a real function index lies in [1, vm.Funcs.Len()],
// while a *TypeInfo record address is a heap/immortal pointer far above the
// function count (and 0 is the null sentinel) — so the classification is exact,
// never a magnitude guess.
//
// The array is VM-owned (a managed @[]uint8 in ownedBlocks, freed at VM
// teardown — see vmOwn): it holds only int words (handle addresses / a *TypeInfo
// / 0), no managed refs, and the handles it points at live on their VMFuncs for
// the VM's lifetime.  A raw address into it that escapes into a native-owned
// iface-value copy is a borrow (holder's responsibility past teardown), like the
// descriptor GlobalInfo.Addr / func-handle pointers.
func buildNativeIfaceVtable(vm @VM, vt @vmdata.IfaceVtable) int {
	if vt.NativeVt != 0 {
		return vt.NativeVt
	}
	var n int = len(vt.Methods)
	// VM-owned (freed at teardown via ownedBlocks); n >= 1 (every vtable has a
	// dtor slot), so vmOwn's make_slice base is in-bounds.  Holds only int words
	// (handle addresses / *TypeInfo / 0) — no managed content to RefDec.
	var nativeVt *int = bit_cast(*int, vmOwn(vm, n * REG_SLOT))
	var funcCount int = vm.Funcs.Len()
	for j := 0; j < n; j++ {
		var v int = vt.Methods[j]
		if v >= 1 && v <= funcCount {
			var fn @VMFunc = vm.Funcs.Get(v - 1)
			ensureHandle(vm, fn, v - 1)
			nativeVt[j] = bit_cast(int, fn.Handle)
		} else {
			nativeVt[j] = v
		}
	}
	vt.NativeVt = bit_cast(int, nativeVt)
	return vt.NativeVt
}

// substituteSliceIfaceArgs is the slice-element analog of the per-arg-slot
// substitution (substArgSlotIface): it rewrites the flagged RAW-SLICE args whose
// ELEMENTS are raw interface values.  For each arg SLOT k in `slots` (the layout's
// SliceIfaceSlots), args[k] is the by-address pointer to a 2-word raw slice
// `{data, len}` whose backing holds `len` raw interface values (2 words each,
// `{data, vtable_word}` — e.g. the `*[]*any` a `...*any` variadic packs).  A bytecode
// impl's element carries a VM-index vtable word an injected-native callee cannot
// dereference; the per-arg-slot arg-iface layout (substArgSlotIface) covers interface
// words WITHIN an arg image (top-level OR nested in a by-value aggregate) but never
// reaches values NESTED behind a slice's data pointer, so those elements would reach
// native code untranslated (a SIGSEGV when the callee reads the small index as a
// native @__ivt).  This copies the backing, translating each VM-index element to the
// impl's native handle-vtable (buildNativeIfaceVtable) while keeping its data
// pointer, copies the `{data, len}` header pointing at that translated backing, and
// repoints args[k] at the copy.  A native/nil element word is copied verbatim, and a
// slice with no VM-index element is passed as it is.
//
// The ORIGINAL backing is never written: the native vtable words are for the callee
// only, and the caller's own values keep their VM words.  A copy rides vm.Stack
// (scratch reclaimed at the next BC_SP_RESTORE) when it fits with `reserve` bytes
// more and the red zone still free (wouldFrameOverflow): the reserve is what may
// still be pushed after it -- the rest of the calling statement's growth (its
// function's MaxStmtTempGrowth, all the frame-entry reservation covers) and the
// return buffer the dispatch takes -- so a stack copy never moves a later push past
// the limit.  Otherwise it goes on the heap, and is returned for the caller to free once the
// native call has returned (releaseSliceCopies).  Nothing faults here: the call's
// arguments are delivered by now, and its cleanup pad leaves delivered arguments
// alone, so a fault would leak them.  Only RAW interface elements (2-word) are
// handled; a slice of MANAGED interface elements is not flagged by the lower-time
// classifier (argIsSliceOfRawIface), so it never reaches here.
func substituteSliceIfaceArgs(vm @VM, argsBase *int, slots @[]int, reserve int) @[]int {
	var heapCopies @[]int
	for si := 0; si < len(slots); si++ {
		var k int = slots[si]
		var hdrInt int = argsBase[k]
		if hdrInt == 0 {
			continue
		}
		var hdr *int = bit_cast(*int, hdrInt)
		var dataInt int = hdr[0]
		var n int = hdr[1]
		if dataInt == 0 || n <= 0 {
			continue
		}
		var src *int = bit_cast(*int, dataInt)
		if !sliceHoldsVmIface(vm, src, n) {
			continue
		}
		// The backing (n elements x 2 words), then the {data, len} header.
		var size int = (n * 2 + 2) * REG_SLOT
		var copyInt int
		if wouldFrameOverflow(vm, size + reserve) {
			copyInt = bit_cast(int, rt.Alloc(size))
			heapCopies = slices.Append[int](heapCopies, copyInt)
		} else {
			copyInt = bit_cast(int, vm.Stack) + vm.SP
			vm.SP = vm.SP + size
		}
		var copyBacking *int = bit_cast(*int, copyInt)
		for e := 0; e < n; e++ {
			var dataIdx int = e * 2 + types.IfaceValueDataIndex()
			var vtIdx int = e * 2 + types.IfaceValueVtableIndex()
			copyBacking[dataIdx] = src[dataIdx]
			var vtWord int = src[vtIdx]
			if ifaceVtIsNative(vm, vtWord) {
				copyBacking[vtIdx] = vtWord
			} else {
				copyBacking[vtIdx] = buildNativeIfaceVtable(vm, vm.IfaceVtables.Get(vtWord - 1))
			}
		}
		var copyHdrInt int = copyInt + n * 2 * REG_SLOT
		var copyHdr *int = bit_cast(*int, copyHdrInt)
		copyHdr[0] = copyInt
		copyHdr[1] = n
		argsBase[k] = copyHdrInt
	}
	return heapCopies
}

// sliceHoldsVmIface reports whether any of the n raw interface values at src carries
// a VM-index vtable word (a bytecode impl's), which a native callee cannot
// dereference.
func sliceHoldsVmIface(vm @VM, src *int, n int) bool {
	for e := 0; e < n; e++ {
		if !ifaceVtIsNative(vm, src[e * 2 + types.IfaceValueVtableIndex()]) { return true }
	}
	return false
}

// releaseSliceCopies frees the heap copies substituteSliceIfaceArgs made, once the
// native call they were passed to has returned.
func releaseSliceCopies(copies @[]int) {
	for i := 0; i < len(copies); i++ {
		rt.Free(bit_cast(*uint8, copies[i]))
	}
}
