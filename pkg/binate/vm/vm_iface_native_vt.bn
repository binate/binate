package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/builtins/rt"

// g_crossModeVmAddr is the VM currently dispatching an injected-native callee — set
// (and restored, for re-entrancy) around each native extern dispatch
// (dispatchExternBinding) so that a native rt.SatLookup MISS, routed through the
// installed rt fallback (satFallbackFn), can reach THIS VM's satentry registry.  A
// raw address, not an @VM, so the global never perturbs the VM's own refcount.
// 0 = no VM is currently dispatching native code, so the fallback declines.
var g_crossModeVmAddr int = 0

// InstallSatFallback wires satFallbackFn as rt.SatLookup's MISS fallback (rt
// SetSatFallback).  The host calls it once at VM setup (RegisterVmTrampolines), so
// an injected-native callee's `x.(*J)` on a bytecode-boxed value whose (T,J) fact
// lives only VM-side resolves through the VM registry rather than MISSing.
func InstallSatFallback() {
	rt.SetSatFallback(satFallbackFn)
}

// satFallbackFn is the rt.SetSatFallback resolver: on a native rt.SatLookup MISS it
// consults the executing VM's own satentry registry (lookupSatEntry) so a `(T, J)`
// fact that lives only VM-side — a bytecode program's own user type asserted by
// injected-native code — still resolves.  A VM-index result (a bytecode-lowered
// impl) is translated to a native handle-vtable (buildNativeIfaceVtable) so the
// recovered value's method re-enters the VM; a native `@__ivt` result (an injected
// package) is returned as-is (ifaceVtIsNative discriminates).  Non-capturing (reads
// the g_crossModeVmAddr global), as an rt `*func` requires.
func satFallbackFn(ti *uint8, id *uint8) *uint8 {
	if g_crossModeVmAddr == 0 {
		return nil
	}
	var vm @VM = bit_cast(@VM, g_crossModeVmAddr)
	var w int = lookupSatEntry(vm, bit_cast(int, ti), bit_cast(int, id))
	if w == 0 {
		return nil
	}
	if ifaceVtIsNative(vm, w) {
		return bit_cast(*uint8, w)
	}
	return bit_cast(*uint8, buildNativeIfaceVtable(vm, vm.IfaceVtables.Get(w - 1)))
}

// Cross-mode interface-value marshalling (plan-iface-crossmode.md S2).
//
// A bytecode (user) impl's interface value carries a VM-index vtable word (a
// 1-based index into vm.IfaceVtables), which an injected-NATIVE stdlib callee
// (e.g. errors.Is) cannot dereference — native code treats the vtable word as
// a native @__ivt pointer and faults on the small index.  At the bytecode →
// native marshalling boundary (dispatchExternBinding), every interface-typed
// arg whose word is a VM index is replaced by a COPY pointing at a NATIVE
// handle-based vtable built from the same vm.IfaceVtables entry, so the callee's
// RefDec (slot 0) and method dispatch (method slots) re-enter the VM through the
// func-value handle convention S1 unified native dispatch onto.

// buildNativeIfaceVtable returns the native handle-based vtable for a bytecode
// impl's vm.IfaceVtables entry, building it once and caching the address on the
// entry (vt.NativeVt).  The layout mirrors the native @__ivt an equivalent
// compiled impl would carry (the concat any-block layout fillVtableLayout
// produced into vt.Methods), so a native upcast that advances the vtable pointer
// by whole slots still lands on a correctly-shaped sub-block:
//   - a slot holding a 1-based VM function index (dtor slot 0, or a method slot)
//     becomes that VMFunc's {vtable, data} HANDLE — ensureHandle builds the
//     universal-trampoline vtable + VMClosureRec{vm, fnIdx} once and shares it,
//     so native `handle.vtable.call(handle.data, recv, args)` (S1) / `_call_dtor
//     (handle, ptr)` re-enter execFunc.  A 0 (no dtor / a method the impl didn't
//     resolve locally) stays 0 — native code reads a null dtor as "just free".
//   - the *TypeInfo slot (slot 1, and each nested any-block's slot 1) is a
//     materialized `__typeinfo.<R>` record address, passed through verbatim.
// The two are told apart by RANGE, the same discipline ifaceVtIsNative uses for
// the vtable word itself: a real function index lies in [1, vm.Funcs.Len()],
// while a *TypeInfo record address is a heap/immortal pointer far above the
// function count (and 0 is the null sentinel) — so the classification is exact,
// never a magnitude guess.
//
// The array is raw immortal memory (VM-lifetime, like the descriptor blocks):
// it holds only int words (handle addresses / a *TypeInfo / 0), no managed refs,
// and the handles it points at live on their VMFuncs for the VM's lifetime.
func buildNativeIfaceVtable(vm @VM, vt @IfaceVtable) int {
	if vt.NativeVt != 0 {
		return vt.NativeVt
	}
	var n int = len(vt.Methods)
	var nativeVt *int = bit_cast(*int, rt.RawAlloc(n * REG_SLOT))
	var funcCount int = vm.Funcs.Len()
	for j := 0; j < n; j++ {
		var v int = vt.Methods[j]
		if v >= 1 && v <= funcCount {
			var fn @VMFunc = vm.Funcs.Get(v - 1)
			ensureHandle(vm, fn, v - 1)
			nativeVt[j] = bit_cast(int, fn.Handle)
		} else {
			nativeVt[j] = v
		}
	}
	vt.NativeVt = bit_cast(int, nativeVt)
	return vt.NativeVt
}

// substTopLevelIfaceSlot substitutes ONE by-address top-level interface value
// (at ivPtr) for the bytecode → injected-native crossing: if it is a live iface
// value whose vtable_word is a VM index (a bytecode impl — !ifaceVtIsNative), it
// writes a fresh 2-word COPY on vm.Stack that keeps the ORIGINAL data pointer (so
// `same`/`present`/identity still see the real box) but swaps in the impl's
// native handle-vtable pointer, and returns the copy's address; otherwise (a nil
// slot, a 0 vtable word, or an already-native word) it returns ivPtr unchanged.
// The original iface block is never mutated.
//
// The copy rides vm.Stack exactly like the aggregate retbuf: it is scratch that
// only has to outlive the synchronous native call and is reclaimed at the next
// statement boundary (BC_SP_RESTORE), so it needs no explicit free.  Native code
// that retains the arg past the call stores the 2-word VALUE (data + immortal
// native vtable), never the scratch address, so the reclaim is safe.  Shared by
// the extern dispatch (substituteIfaceArgs) and the func-value / iface-method
// sibling dispatchers (plan-iface-crossmode.md S2/S3).
func substTopLevelIfaceSlot(vm @VM, ivPtr int) int {
	if ivPtr == 0 {
		return ivPtr
	}
	var iv *int = bit_cast(*int, ivPtr)
	var vtWord int = iv[types.IfaceValueVtableIndex()]
	if ifaceVtIsNative(vm, vtWord) {
		// Already a native @__ivt address, or the 0 nil-iface sentinel — the
		// callee handles both directly; nothing to translate.
		return ivPtr
	}
	var nativeVt int = buildNativeIfaceVtable(vm, vm.IfaceVtables.Get(vtWord - 1))
	var copyInt int = bit_cast(int, vm.Stack) + vm.SP
	var copyPtr *int = bit_cast(*int, copyInt)
	vm.SP = vm.SP + 2 * REG_SLOT
	copyPtr[types.IfaceValueDataIndex()] = iv[types.IfaceValueDataIndex()]
	copyPtr[types.IfaceValueVtableIndex()] = nativeVt
	return copyInt
}

// substituteIfaceArgs rewrites the flagged top-level interface args of a bytecode
// → injected-native extern call.  For each arg SLOT k set in ifaceBits (the
// caller's static-type-derived per-slot interface bitmap), args[k] is replaced by
// substTopLevelIfaceSlot's native-handle-vtable copy when it is a bytecode impl.
func substituteIfaceArgs(vm @VM, args @[]int, ifaceBits int) {
	for k := 0; k < 7; k++ {
		if (ifaceBits & (1 << k)) != 0 {
			args[k] = substTopLevelIfaceSlot(vm, args[k])
		}
	}
}

// substituteSliceIfaceArgs is substituteIfaceArgs one level down: it rewrites the
// flagged RAW-SLICE args whose ELEMENTS are raw interface values.  For each arg
// SLOT k set in sliceIfaceBits, args[k] is the by-address pointer to a 2-word raw
// slice `{data, len}` whose backing holds `len` raw interface values (2 words each,
// `{data, vtable_word}` — e.g. the `*[]*any` a `...*any` variadic packs).  A
// bytecode impl's element carries a VM-index vtable word an injected-native callee
// cannot dereference; the top-level substituteIfaceArgs bitmap never reaches values
// NESTED in a slice, so those elements would reach native code untranslated (a
// SIGSEGV when the callee reads the small index as a native @__ivt).  This copies
// the backing array to vm.Stack, translating each VM-index element to the impl's
// native handle-vtable (buildNativeIfaceVtable) while keeping its data pointer,
// copies the `{data, len}` header pointing at that translated backing, and repoints
// args[k] at the copy.  A native/nil element word is copied verbatim.
//
// Like substituteIfaceArgs the copies ride vm.Stack (scratch reclaimed at the next
// BC_SP_RESTORE) and the ORIGINAL backing is never mutated — a spread `s...` of a
// user slice must see its own elements unchanged.  Only RAW interface elements
// (2-word) are handled; a slice of MANAGED interface elements is not flagged by the
// lower-time classifier (argIsSliceOfRawIface), so it never reaches here.
func substituteSliceIfaceArgs(vm @VM, args @[]int, sliceIfaceBits int) {
	for k := 0; k < 7; k++ {
		if (sliceIfaceBits & (1 << k)) == 0 {
			continue
		}
		var hdrInt int = args[k]
		if hdrInt == 0 {
			continue
		}
		var hdr *int = bit_cast(*int, hdrInt)
		var dataInt int = hdr[0]
		var n int = hdr[1]
		if dataInt == 0 || n <= 0 {
			continue
		}
		// Unlike substituteIfaceArgs (a fixed 2 words) and the aggregate retbuf (a
		// static return-type size), this scratch bump is a RUNTIME slice length, so
		// bound it: a pathologically large cross-mode `...*any` spread must fail loud
		// rather than write the translated backing + header past vm.Stack's end.
		if vm.SP + (n * 2 + 2) * REG_SLOT > vm.StackSize {
			vmPanic("vm: cross-mode variadic slice too large for VM scratch stack")
		}
		var src *int = bit_cast(*int, dataInt)
		// Copy the backing (n elements x 2 words) onto vm.Stack, translating each
		// element's vtable word.
		var copyBackingInt int = bit_cast(int, vm.Stack) + vm.SP
		var copyBacking *int = bit_cast(*int, copyBackingInt)
		vm.SP = vm.SP + n * 2 * REG_SLOT
		for e := 0; e < n; e++ {
			var dataIdx int = e * 2 + types.IfaceValueDataIndex()
			var vtIdx int = e * 2 + types.IfaceValueVtableIndex()
			copyBacking[dataIdx] = src[dataIdx]
			var vtWord int = src[vtIdx]
			if ifaceVtIsNative(vm, vtWord) {
				copyBacking[vtIdx] = vtWord
			} else {
				copyBacking[vtIdx] = buildNativeIfaceVtable(vm, vm.IfaceVtables.Get(vtWord - 1))
			}
		}
		// Copy the {data, len} header pointing at the translated backing.
		var copyHdrInt int = bit_cast(int, vm.Stack) + vm.SP
		var copyHdr *int = bit_cast(*int, copyHdrInt)
		vm.SP = vm.SP + 2 * REG_SLOT
		copyHdr[0] = copyBackingInt
		copyHdr[1] = n
		args[k] = copyHdrInt
	}
}
