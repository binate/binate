package "pkg/binate/vm"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// ifaceVtSource is a single-method interface with a user impl, lowered so the
// VM carries exactly one vm.IfaceVtables entry (index 0, vtable word 1) whose
// concat layout is [dtor, *TypeInfo, Area-method].  main boxes the impl so the
// impl actually participates.
func ifaceVtSource() @[]char {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "interface Shape { Area() int }\n")
	src = concatStr(src, "type sq struct { side int }\n")
	src = concatStr(src, "func (s @sq) Area() int { return s.side * s.side }\n")
	src = concatStr(src, "impl @sq : Shape\n")
	src = concatStr(src, "func main() { var x @Shape = make(sq); _ = x }\n")
	return src
}

// buildNativeIfaceVtable wraps each method/dtor func-index slot in the func
// value's HANDLE, passes the *TypeInfo slot through verbatim, and caches the
// result on the IfaceVtable — so an injected-native callee can dispatch a
// bytecode impl by re-entering the VM.
func TestBuildNativeIfaceVtable() testing.TestResult {
	var vm @VM = lowerFromSource(ifaceVtSource())
	// buildNativeIfaceVtable → ensureHandle needs the cross-mode trampolines.
	registerTestExterns(vm)
	if vm.IfaceVtables.Len() < 1 {
		return "expected a lowered impl vtable"
	}
	var vt @IfaceVtable = vm.IfaceVtables.Get(0)
	if len(vt.Methods) < 3 {
		return "expected [dtor, typeinfo, Area] layout"
	}
	var addr int = buildNativeIfaceVtable(vm, vt)
	if addr == 0 {
		return "native vtable address must be nonzero"
	}
	// Cached: a second build returns the very same address (built once).
	if buildNativeIfaceVtable(vm, vt) != addr {
		return "native vtable must be cached per entry"
	}
	if vt.NativeVt != addr {
		return "native vtable address must be cached on the entry"
	}
	var nativeVt *int = bit_cast(*int, addr)
	// Slot 0 (dtor): sq has no managed field, so its dtor slot is 0 — a native
	// null dtor (ZeroRefDestroy just frees).  Verbatim pass-through of the 0.
	if nativeVt[0] != vt.Methods[0] {
		return "no-managed-field dtor slot must pass through (0)"
	}
	// Slot 1 (*TypeInfo): a materialized record address, passed through verbatim
	// (outside [1, Funcs.Len()], so never wrapped).
	if nativeVt[1] != vt.Methods[1] {
		return "typeinfo slot must pass through verbatim"
	}
	if vt.Methods[1] == 0 {
		return "typeinfo slot should be a real record address"
	}
	// Slot 2 (Area method): a 1-based func index in [1, Funcs.Len()], so wrapped
	// into that VMFunc's {vtable, data} handle — distinct from the raw index.
	if nativeVt[2] == vt.Methods[2] {
		return "method slot must be wrapped into a handle, not the raw index"
	}
	if nativeVt[2] == 0 {
		return "method handle must be nonzero"
	}
	// The handle's data word is a VMClosureRec pointing back at the method's VM
	// function index — the payload the trampoline re-enters execFunc with.
	var handle *int = bit_cast(*int, nativeVt[2])
	var rec *int = bit_cast(*int, handle[1])
	if rec[0] != rt.DATA_KIND_VM_CLOSURE_REC {
		return "method handle data must be a VM closure record"
	}
	if rec[2] != vt.Methods[2] {
		return "closure record must carry the method's 1-based func index"
	}
	return ""
}
