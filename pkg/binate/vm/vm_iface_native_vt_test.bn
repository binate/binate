package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/binate/vmdata"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// ifaceVtSource is a single-method interface with a user impl, lowered so the
// VM carries exactly one vm.IfaceVtables entry (index 0, vtable word 1) whose
// concat layout is [dtor, *TypeInfo, Area-method].  main boxes the impl so the
// impl actually participates.
func ifaceVtSource() @[]char {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "interface Shape { Area() int }\n")
	src = concatStr(src, "type sq struct { side int }\n")
	src = concatStr(src, "func (s @sq) Area() int { return s.side * s.side }\n")
	src = concatStr(src, "impl @sq : Shape\n")
	src = concatStr(src, "func main() { var x @Shape = make(sq); _ = x }\n")
	return src
}

// buildNativeIfaceVtable wraps each method/dtor func-index slot in the func
// value's HANDLE, passes the *TypeInfo slot through verbatim, and caches the
// result on the IfaceVtable — so an injected-native callee can dispatch a
// bytecode impl by re-entering the VM.
func TestBuildNativeIfaceVtable() testing.TestResult {
	var vm @VM = lowerFromSource(ifaceVtSource())
	// buildNativeIfaceVtable → ensureHandle needs the cross-mode trampolines.
	registerTestExterns(vm)
	if vm.IfaceVtables.Len() < 1 {
		return "expected a lowered impl vtable"
	}
	var vt @vmdata.IfaceVtable = vm.IfaceVtables.Get(0)
	if len(vt.Methods) < 3 {
		return "expected [dtor, typeinfo, Area] layout"
	}
	var addr int = buildNativeIfaceVtable(vm, vt)
	if addr == 0 {
		return "native vtable address must be nonzero"
	}
	// Cached: a second build returns the very same address (built once).
	if buildNativeIfaceVtable(vm, vt) != addr {
		return "native vtable must be cached per entry"
	}
	if vt.NativeVt != addr {
		return "native vtable address must be cached on the entry"
	}
	var nativeVt *int = bit_cast(*int, addr)
	// Slot 0 (dtor): sq has no managed field, so its dtor slot is 0 — a native
	// null dtor (ZeroRefDestroy just frees).  Verbatim pass-through of the 0.
	if nativeVt[0] != vt.Methods[0] {
		return "no-managed-field dtor slot must pass through (0)"
	}
	// Slot 1 (*TypeInfo): a materialized record address, passed through verbatim
	// (outside [1, Funcs.Len()], so never wrapped).
	if nativeVt[1] != vt.Methods[1] {
		return "typeinfo slot must pass through verbatim"
	}
	if vt.Methods[1] == 0 {
		return "typeinfo slot should be a real record address"
	}
	// Slot 2 (Area method): a 1-based func index in [1, Funcs.Len()], so wrapped
	// into that VMFunc's {vtable, data} handle — distinct from the raw index.
	if nativeVt[2] == vt.Methods[2] {
		return "method slot must be wrapped into a handle, not the raw index"
	}
	if nativeVt[2] == 0 {
		return "method handle must be nonzero"
	}
	// The handle's data word is a VMClosureRec pointing back at the method's VM
	// function index — the payload the trampoline re-enters execFunc with.
	var handle *int = bit_cast(*int, nativeVt[2])
	var rec *int = bit_cast(*int, handle[1])
	if rec[0] != rt.DATA_KIND_VM_CLOSURE_REC {
		return "method handle data must be a VM closure record"
	}
	if rec[2] != vt.Methods[2] {
		return "closure record must carry the method's 1-based func index"
	}
	return ""
}

// ifaceSliceOf returns the backing of n raw interface values -- the i-th
// {data: 100 + i, vtable word: vtWord} -- and a raw slice header {data, len} over it.
func ifaceSliceOf(n int, vtWord int) (@[]int, @[]int) {
	var backing @[]int = make_slice(int, n * 2)
	for i := 0; i < n; i++ {
		backing[i * 2 + types.IfaceValueDataIndex()] = 100 + i
		backing[i * 2 + types.IfaceValueVtableIndex()] = vtWord
	}
	var hdr @[]int = make_slice(int, 2)
	hdr[0] = bit_cast(int, &backing[0])
	hdr[1] = n
	return backing, hdr
}

// sliceTranslated returns "" when hdrInt is a copy of the slice header orig over a
// copy of backing (n values, each carrying the VM vtable word 1) whose vtable words
// are the lowered impl's native handle-vtable and whose data words are kept, the
// original left as it was; else what is wrong.
func sliceTranslated(vm @VM, hdrInt int, orig *[]int, backing *[]int, n int) testing.TestResult {
	if hdrInt == bit_cast(int, &orig[0]) { return "the slice argument should point at a copy" }
	var copyHdr *int = bit_cast(*int, hdrInt)
	if copyHdr[1] != n { return "the copy should keep the slice's length" }
	var copied *int = bit_cast(*int, copyHdr[0])
	var nativeVt int = vm.IfaceVtables.Get(0).NativeVt
	for i := 0; i < n; i++ {
		if copied[i * 2 + types.IfaceValueDataIndex()] != 100 + i {
			return "the copy should keep each data word"
		}
		if copied[i * 2 + types.IfaceValueVtableIndex()] != nativeVt {
			return "the copy's vtable words should be the native handle-vtable"
		}
		if backing[i * 2 + types.IfaceValueVtableIndex()] != 1 {
			return "the original backing should be left as it was"
		}
	}
	return ""
}

// A slice of bytecode impls' interface values is translated into a copy on vm.Stack
// when the copy fits there.
func TestSliceIfaceCopyOnStack() testing.TestResult {
	var vm @VM = lowerFromSource(ifaceVtSource())
	registerTestExterns(vm)
	if vm.IfaceVtables.Len() < 1 { return "expected a lowered impl vtable" }
	var backing @[]int
	var hdr @[]int
	backing, hdr = ifaceSliceOf(3, 1)
	var args @[]int = make_slice(int, 1)
	args[0] = bit_cast(int, &hdr[0])
	var slots @[]int = make_slice(int, 1)
	var sp int = vm.SP
	var heapCopies @[]int = substituteSliceIfaceArgs(vm, &args[0], slots, 0)
	var grew int = vm.SP - sp
	vm.SP = sp
	if len(heapCopies) != 0 { return "a copy that fits should ride vm.Stack" }
	if grew != (3 * 2 + 2) * REG_SLOT { return "the stack copy should take its size from vm.Stack" }
	return sliceTranslated(vm, args[0], hdr, backing, 3)
}

// A copy that does not fit on vm.Stack -- with the caller's reserve -- goes on the
// heap, and nothing faults; releaseSliceCopies frees it.
func TestSliceIfaceCopyTooLargeGoesToHeap() testing.TestResult {
	var vm @VM = lowerFromSource(ifaceVtSource())
	registerTestExterns(vm)
	if vm.IfaceVtables.Len() < 1 { return "expected a lowered impl vtable" }
	// The first translation builds and caches the impl's native vtable, which lives on;
	// build it now, so the counts below see only the copy.
	buildNativeIfaceVtable(vm, vm.IfaceVtables.Get(0))
	var size int = (3 * 2 + 2) * REG_SLOT
	var sp int = vm.SP
	// Too little room for the copy, then room for the copy but not for the reserve too.
	var room @[]int = make_slice(int, 2)
	room[0] = size - REG_SLOT
	room[1] = size + REG_SLOT
	for r := 0; r < len(room); r++ {
		var backing @[]int
		var hdr @[]int
		backing, hdr = ifaceSliceOf(3, 1)
		var args @[]int = make_slice(int, 1)
		args[0] = bit_cast(int, &hdr[0])
		var slots @[]int = make_slice(int, 1)
		var live int = rt.LiveBlocks()
		vm.SP = stackLimit(vm, 0) - room[r]
		var spBefore int = vm.SP
		var heapCopies @[]int = substituteSliceIfaceArgs(vm, &args[0], slots, 4 * REG_SLOT)
		var grew int = vm.SP - spBefore
		vm.SP = sp
		if vm.FaultRaised { return "a copy too large for vm.Stack should not fault" }
		if len(heapCopies) != 1 || grew != 0 {
			return "a copy too large for vm.Stack should go on the heap"
		}
		var r2 testing.TestResult = sliceTranslated(vm, args[0], hdr, backing, 3)
		if len(r2) > 0 { return r2 }
		releaseSliceCopies(heapCopies)
		var none @[]int
		heapCopies = none
		if rt.LiveBlocks() != live { return "releaseSliceCopies should free the heap copy" }
	}
	return ""
}

// A slice none of whose interface values is a bytecode impl's -- nil or native vtable
// words -- is passed as it is, with no copy; one holding a bytecode impl's value among
// native ones is copied, the native words verbatim.
func TestSliceIfaceNoVmIfaceNotCopied() testing.TestResult {
	var vm @VM = lowerFromSource(ifaceVtSource())
	registerTestExterns(vm)
	if vm.IfaceVtables.Len() < 1 { return "expected a lowered impl vtable" }
	var nativeVt int = buildNativeIfaceVtable(vm, vm.IfaceVtables.Get(0))
	var words @[]int = make_slice(int, 2)
	// A native vtable word is an address, outside the VM's 1-based vtable indexes.
	words[1] = bit_cast(int, &words[0])
	var sp int = vm.SP
	for w := 0; w < len(words); w++ {
		var backing @[]int
		var hdr @[]int
		backing, hdr = ifaceSliceOf(3, words[w])
		var args @[]int = make_slice(int, 1)
		args[0] = bit_cast(int, &hdr[0])
		var slots @[]int = make_slice(int, 1)
		var heapCopies @[]int = substituteSliceIfaceArgs(vm, &args[0], slots, 0)
		if len(heapCopies) != 0 || vm.SP != sp || args[0] != bit_cast(int, &hdr[0]) {
			return "a slice with no bytecode impl's interface value should be passed with no copy"
		}
		if backing[2 + types.IfaceValueVtableIndex()] != words[w] {
			return "its backing should be left as it was"
		}
	}
	var backing @[]int
	var hdr @[]int
	backing, hdr = ifaceSliceOf(3, words[1])
	backing[2 + types.IfaceValueVtableIndex()] = 1
	var args @[]int = make_slice(int, 1)
	args[0] = bit_cast(int, &hdr[0])
	var slots @[]int = make_slice(int, 1)
	var heapCopies @[]int = substituteSliceIfaceArgs(vm, &args[0], slots, 0)
	var grew int = vm.SP - sp
	vm.SP = sp
	if len(heapCopies) != 0 || grew != (3 * 2 + 2) * REG_SLOT || args[0] == bit_cast(int, &hdr[0]) {
		return "a slice holding a bytecode impl's interface value should be copied"
	}
	var copied *int = bit_cast(*int, bit_cast(*int, args[0])[0])
	for i := 0; i < 3; i++ {
		var want int = words[1]
		if i == 1 { want = nativeVt }
		if copied[i * 2 + types.IfaceValueVtableIndex()] != want {
			return "the copy should translate the bytecode impl's word and keep the native ones"
		}
	}
	return ""
}
