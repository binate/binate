package "pkg/binate/vm"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// TestAggFuncValueOverflowNoCrash: an AGGREGATE-returning func value (returns a
// struct, so the dispatch reserves a retbuf and dispatches through the packed
// trampoline) that recurses until the VM stack overflows must terminate with
// Status = FAULTED, NOT crash the host.  On an entry-pushFrame overflow execFunc
// clears FaultRaised and returns 0; before the crash guard, TrampolinePacked's
// retbuf path then did rt.MemCopy(retbuf, addr=0, ...) — a read from address 0 →
// SEGV.  The guard skips the MemCopy when execFunc left Status = FAULTED, so the
// overflow unwinds gracefully instead of crashing.  (Leak-freedom of the moved arg
// is a separate concern fixed by the func-value fast-path; this test asserts only
// that the process survives — a crash takes the whole test binary down.)
func TestAggFuncValueOverflowNoCrash() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Pair struct { a int\n b int }\n"
			"var gFn *func(int) Pair = nil\n"
			"func recur(depth int) Pair {\n"
			"	if depth <= 0 {\n"
			"		var p Pair\n"
			"		p.a = depth\n"
			"		return p\n"
			"	}\n"
			"	return gFn(depth - 1)\n"
			"}\n"
			"func start(depth int) int {\n"
			"	gFn = recur\n"
			"	var p Pair = recur(depth)\n"
			"	return p.a\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = ir.GenModule(c, file)
	var vm @VM = newTestVM(64 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var argv @[]int = make_slice(int, 1)
	argv[0] = 100000000 // deep enough to overflow
	vm.CallFunc("test.start", argv)
	if vm.Status != VM_STATUS_FAULTED {
		return "deep aggregate-returning func-value recursion must overflow with Status = FAULTED (no cra"
				"sh)"
	}
	// Repeat: each overflow must recover to the host identically (no crash across runs).
	for i := 0; i < 10; i++ {
		vm.CallFunc("test.start", argv)
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated aggregate func-value overflow must recover identically"
	}
	return ""
}
