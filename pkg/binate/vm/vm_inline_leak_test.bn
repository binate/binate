package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// Leak/control coverage of inliner Inc 3a (empty-pad faulting-op callees).  The
// core invariant: a fault inside an inlined empty-pad callee reuses the CALLER's
// call-site pad, which must RefDec the caller's live-at-call managed set exactly
// once (no leak, no double-free) and unwind the single merged frame.  Each test
// measures rt.LiveBlocks() across a fault loop (0 delta = no leak) and pairs the
// leak check with a positive/negative inlining control so it can never go vacuous.

// faultLoopDelta lowers `src` at OptLevel `level`, warms up one call to `fn`, then
// loops `iters` calls measuring rt.LiveBlocks() delta.  0 = no leak.  Returns the
// delta; -1000000 flags "did not fault as expected" (callers that expect a fault).
func faultLoopDelta(src *[]readonly char, fn *[]readonly char, level int, iters int,
		wantFault bool) int {
	var m @ir.Module = genModule(src)
	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.OptLevel = level
	vm.LowerModule(m)
	var noArgs @[]int
	vm.CallFunc(fn, noArgs)
	if wantFault && vm.Status != VM_STATUS_FAULTED {
		return -1000000
	}
	if !wantFault && vm.Status == VM_STATUS_FAULTED {
		return -1000000
	}
	var base int = rt.LiveBlocks()
	for i := 0; i < iters; i++ {
		vm.CallFunc(fn, noArgs)
	}
	var delta int = rt.LiveBlocks() - base
	// keep m alive
	if m == nil { return -999 }
	return delta
}

// TestAdvInlineFaultReusesCallerPadNoLeak: the caller holds a managed local `g`
// live across a call to an empty-pad fault callee `at` that faults OOB.  At -O1
// `at` is inlined and the cloned bounds check reuses main's call-site pad, which
// must RefDec `g`.  A leak here (call-site pad not run, or run without g) grows
// LiveBlocks by 1 per call.  Compared against the -O0 (un-inlined) baseline.
func TestAdvInlineFaultReusesCallerPadNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func at(s *[]int, i int) int { return s[i] }\n"
			"func doFault() int {\n"
			"\tvar g @[]int = make_slice(int, 4)\n"
			"\tvar a [3]int\n"
			"\tvar r int = at(a[:], 5)\n"
			"\treturn len(g) + r\n"
			"}\n"
	var d0 int = faultLoopDelta(src, "test.doFault", 0, 30, true)
	var d1 int = faultLoopDelta(src, "test.doFault", 1, 30, true)
	if d0 == -1000000 { return "O0: doFault must fault (OOB)" }
	if d1 == -1000000 { return "O1: inlined doFault must still fault (OOB)" }
	if d0 != 0 { return "O0 baseline itself leaks on recovered fault (pre-existing, not Inc 3a)" }
	if d1 != 0 {
		return "O1 INLINED fault LEAKS caller managed local: reused call-site pad did not RefDec g"
	}
	return ""
}

// TestAdvInlineFaultInBoundsNoLeak: same shape, in-bounds — normal completion.
// The inlined path must produce the same result and not leak `g`.
func TestAdvInlineFaultInBoundsNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func at(s *[]int, i int) int { return s[i] }\n"
			"func ok() int {\n"
			"\tvar g @[]int = make_slice(int, 4)\n"
			"\tvar a [3]int\n"
			"\ta[1] = 7\n"
			"\tvar r int = at(a[:], 1)\n"
			"\treturn len(g) + r\n"
			"}\n"
	var d1 int = faultLoopDelta(src, "test.ok", 1, 30, false)
	if d1 == -1000000 { return "O1: ok() must NOT fault (in-bounds)" }
	if d1 != 0 { return "O1 inlined in-bounds path leaks caller managed local g" }
	return ""
}

// TestAdvInlineManagedLocalAfterFaultOOB: the callee creates a managed @Node
// local AFTER its bounds check, so the check's pad is EMPTY (nothing managed live
// yet) and the callee is inlinable — even though it DOES have a managed local.
// On an OOB fault the fault fires BEFORE make(Node) runs, so `n` is never
// allocated: nothing to leak.  The caller also holds a managed `g`.  Stress both
// the caller-pad RefDec (g) and the "managed local exists but is downstream of the
// fault" reasoning behind #2a.
func TestAdvInlineManagedLocalAfterFaultOOB() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Node struct { v int }\n"
			"func mk(s *[]int, i int) @Node {\n"
			"\tvar x int = s[i]\n"
			"\tvar n @Node = make(Node)\n"
			"\tn.v = x\n"
			"\treturn n\n"
			"}\n"
			"func doFault() int {\n"
			"\tvar g @[]int = make_slice(int, 4)\n"
			"\tvar a [3]int\n"
			"\tvar p @Node = mk(a[:], 5)\n"
			"\treturn len(g)\n"
			"}\n"
	var d0 int = faultLoopDelta(src, "test.doFault", 0, 30, true)
	var d1 int = faultLoopDelta(src, "test.doFault", 1, 30, true)
	if d0 == -1000000 { return "O0: mk OOB must fault" }
	if d1 == -1000000 { return "O1: inlined mk OOB must fault" }
	if d0 != 0 { return "O0 baseline leaks (pre-existing)" }
	if d1 != 0 { return "O1 inlined managed-local-after-fault OOB LEAKS" }
	return ""
}

// TestAdvInlineManagedLocalAfterFaultInBounds: same callee, in-bounds.  Now
// make(Node) runs, is returned, and the caller must RefDec it (via p's scope
// exit).  The inlined path must balance the managed-ptr return refcount AND not
// leak — the Inc 1 managed-return refcount composed with the Inc 3a fault-op
// clone.
func TestAdvInlineManagedLocalAfterFaultInBounds() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Node struct { v int }\n"
			"func mk(s *[]int, i int) @Node {\n"
			"\tvar x int = s[i]\n"
			"\tvar n @Node = make(Node)\n"
			"\tn.v = x\n"
			"\treturn n\n"
			"}\n"
			"func ok() int {\n"
			"\tvar a [3]int\n"
			"\ta[1] = 9\n"
			"\tvar p @Node = mk(a[:], 1)\n"
			"\treturn p.v\n"
			"}\n"
	var d0 int = faultLoopDelta(src, "test.ok", 0, 30, false)
	var d1 int = faultLoopDelta(src, "test.ok", 1, 30, false)
	if d1 == -1000000 { return "O1: ok() must NOT fault (in-bounds)" }
	if d0 != 0 { return "O0 baseline managed-return leaks (pre-existing)" }
	if d1 != 0 { return "O1 inlined managed-return LEAKS (Inc1/Inc3a refcount interaction)" }
	return ""
}

// TestAdvInlineTwoFaultCallsNoLeak: two calls to the same empty-pad fault callee
// in one caller; the SECOND faults while a managed local from an earlier managed
// alloc is live.  Both calls' cloned fault ops must reuse their OWN call-site pad
// (call.PadBlock is per-call).  Leak check across a loop.
func TestAdvInlineTwoFaultCallsNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func at(s *[]int, i int) int { return s[i] }\n"
			"func doFault() int {\n"
			"\tvar g @[]int = make_slice(int, 4)\n"
			"\tvar a [3]int\n"
			"\ta[0] = 1\n"
			"\tvar r1 int = at(a[:], 0)\n"
			"\tvar r2 int = at(a[:], 9)\n"
			"\treturn len(g) + r1 + r2\n"
			"}\n"
	var d1 int = faultLoopDelta(src, "test.doFault", 1, 30, true)
	if d1 == -1000000 { return "O1: second call OOB must fault" }
	if d1 != 0 { return "O1 two-inlined-calls second-fault LEAKS caller managed local" }
	return ""
}

// TestInlineManagedPtrParamFaultInBounds (Inc 3b): the same managed-ptr PARAM
// callee, in-bounds — p is RefDec'd on the normal (non-fault) path.  The inlined
// path must not leak q/g across repeated runs and must give 10/2 = 5.
func TestInlineManagedPtrParamFaultInBounds() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Node struct { v int }\n"
			"func at(p @Node, d int) int { return 10 / d }\n"
			"func okrun() int {\n"
			"\tvar g @[]int = make_slice(int, 4)\n"
			"\tvar q @Node = make(Node)\n"
			"\tvar r int = at(q, 2)\n"
			"\treturn len(g) + q.v + r\n"
			"}\n"
			"func main() int {\n"
			"\tvar q @Node = make(Node)\n"
			"\treturn at(q, 2)\n"
			"}\n"
	var mc @ir.Module = genModule(src)
	var vmc @VM = NewVM(1024 * 1024)
	registerTestExterns(vmc)
	vmc.OptLevel = 1
	vmc.LowerModule(mc)
	if countAllBCCalls(vmc) != 0 {
		return "small managed-ptr PARAM callee should inline at -O1 (in-bounds test vacuous)"
	}
	var d1 int = faultLoopDelta(src, "test.okrun", 1, 30, false)
	if d1 == -1000000 { return "O1: okrun must NOT fault (in-bounds)" }
	if d1 != 0 { return "O1 inlined managed-ptr PARAM in-bounds LEAKS q or g" }
	var r0 int = runVMAtLevel(src, 0)
	var r1 int = runVMAtLevel(src, 1)
	if r0 != 5 { return "O0 baseline should be 10/2 = 5" }
	if r1 != 5 { return "O1 inlined managed-ptr PARAM result should be 5" }
	return ""
}

// countBCCallsTo counts BC_CALL ops whose caller-func target-name slot resolves
// to `name` across every lowered function.  Used as a positive control: if the
// empty-pad fault callee `at` is inlined, the caller has zero BC_CALLs to it.
// We approximate by counting TOTAL BC_CALL ops (the test module has exactly one
// user call), which drops from >=1 (O0) to 0 (O1) iff inlining fired.
func countAllBCCalls(vm @VM) int {
	var n int = 0
	for fi := 0; fi < vm.Funcs.Len(); fi++ {
		var code @[]BCInstr = vm.Funcs.Get(fi).Code
		for i := 0; i < len(code); i++ {
			if code[i].Op == BC_CALL { n = n + 1 }
		}
	}
	return n
}

// TestAdvInlinePositiveControl: confirm the empty-pad fault callee `at` is ACTUALLY
// inlined at -O1 (so the leak tests above exercise the inlined path, not a silent
// no-inline).  BC_CALL count must drop from >=1 at -O0 to 0 at -O1.
func TestAdvInlinePositiveControl() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func at(s *[]int, i int) int { return s[i] }\n"
			"func doFault() int {\n"
			"\tvar g @[]int = make_slice(int, 4)\n"
			"\tvar a [3]int\n"
			"\tvar r int = at(a[:], 5)\n"
			"\treturn len(g) + r\n"
			"}\n"
	var m0 @ir.Module = genModule(src)
	var vm0 @VM = NewVM(1024 * 1024)
	registerTestExterns(vm0)
	vm0.OptLevel = 0
	vm0.LowerModule(m0)
	var c0 int = countAllBCCalls(vm0)

	var m1 @ir.Module = genModule(src)
	var vm1 @VM = NewVM(1024 * 1024)
	registerTestExterns(vm1)
	vm1.OptLevel = 1
	vm1.LowerModule(m1)
	var c1 int = countAllBCCalls(vm1)

	if c0 < 1 { return "positive control broken: expected >=1 BC_CALL at -O0" }
	if c1 != 0 {
		return "empty-pad fault callee `at` was NOT inlined at -O1 (leak tests would be vacuous)"
	}
	return ""
}

// TestAdvInlineDivFaultVM: a divide-by-zero fault op (int params -> empty pad) is
// inlined at -O1; the caller holds a managed local `g`.  On b==0 the DIV faults
// and reuses main's call-site pad (must RefDec g).  Covers the div fault kind
// (gen_binary.bn attachFaultPad), not just bounds.
func TestAdvInlineDivFaultVM() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func dv(a int, b int) int { return a / b }\n"
			"func doFault() int {\n"
			"\tvar g @[]int = make_slice(int, 4)\n"
			"\tvar r int = dv(10, 0)\n"
			"\treturn len(g) + r\n"
			"}\n"
	var d1 int = faultLoopDelta(src, "test.doFault", 1, 30, true)
	if d1 == -1000000 { return "O1: div-by-zero must fault" }
	if d1 != 0 { return "O1 inlined DIV fault LEAKS caller managed local g" }
	// positive control: dv must be inlined
	var m1 @ir.Module = genModule(src)
	var vm1 @VM = NewVM(1024 * 1024)
	registerTestExterns(vm1)
	vm1.OptLevel = 1
	vm1.LowerModule(m1)
	if countAllBCCalls(vm1) != 0 { return "div callee dv was NOT inlined at -O1 (test vacuous)" }
	return ""
}

// TestAdvInlineShiftFaultVM: a negative-shift fault op (int params -> empty pad)
// inlined at -O1; leak check with a live caller managed local.
func TestAdvInlineShiftFaultVM() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func sh(a int, b int) int { return a << b }\n"
			"func doFault() int {\n"
			"\tvar g @[]int = make_slice(int, 4)\n"
			"\tvar r int = sh(1, -1)\n"
			"\treturn len(g) + r\n"
			"}\n"
	var d1 int = faultLoopDelta(src, "test.doFault", 1, 30, true)
	if d1 == -1000000 { return "O1: negative shift must fault" }
	if d1 != 0 { return "O1 inlined SHIFT fault LEAKS caller managed local g" }
	return ""
}

// A multi-block + fault + OOB *leak* test is intentionally absent: a single-return
// multi-block callee that also contains a fault op exceeds the default
// InlineSizeThreshold, so it does not inline at -O1 (a size gate, not a defect).
// That combination's leak-safety follows by composition — the fault-pad reuse is
// covered by the single-block leak tests above, and the multi-block CFG split with
// a fault op present is covered by TestAdvInlineMultiBlockFaultInBounds below.

// TestAdvInlineMultiBlockFaultInBounds: same multi-block callee, in-bounds (c
// true, valid i) and the not-taken branch (c false) — both must give correct
// results at -O1 matching -O0, exercising the CFG-split merge with a fault op
// present.
func TestAdvInlineMultiBlockFaultInBounds() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func pick(s *[]int, c bool, i int) int {\n"
			"\tvar r int = 0\n"
			"\tif c {\n"
			"\t\tr = s[i]\n"
			"\t}\n"
			"\treturn r\n"
			"}\n"
			"func main() int {\n"
			"\tvar a [3]int\n"
			"\ta[2] = 42\n"
			"\tvar x int = pick(a[:], true, 2)\n"
			"\tvar y int = pick(a[:], false, 2)\n"
			"\treturn x + y * 100\n"
			"}\n"
	var r0 int = runVMAtLevel(src, 0)
	var r1 int = runVMAtLevel(src, 1)
	if r0 != 42 { return "O0 baseline should be 42" }
	if r1 != 42 { return "O1 inlined multi-block-with-fault result mismatch" }
	return ""
}

// TestAdvManagedTempAtFaultRejected: a callee that bounds-checks an index into a
// freshly-made managed-slice TEMP has that temp live (ctx.Temps) at the check, so
// its pad RefDecs the temp -> NON-empty -> must NOT be inlined.  This relies on
// the managed temp being registered BEFORE attachFaultPad runs (emit order).  If
// it were wrongly inlined, the reused call-site pad would not release the callee's
// make_slice temp -> leak on fault.  Negative control (stays a BC_CALL) + leak.
func TestInlineManagedSliceTempFaultNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f(i int) int { return make_slice(int, 3)[i] }\n"
			"func doFault() int {\n"
			"\tvar g @[]int = make_slice(int, 4)\n"
			"\tvar r int = f(9)\n"
			"\treturn len(g) + r\n"
			"}\n"
	var m1 @ir.Module = genModule(src)
	var vm1 @VM = NewVM(1024 * 1024)
	registerTestExterns(vm1)
	vm1.OptLevel = 1
	vm1.LowerModule(m1)
	// The make_slice(int,3) TEMP is a managed-slice of NON-managed elements, so
	// its cleanup is straight-line (RefDec the backing; no per-element dtor loop)
	// -> a single-block pad Inc 3b clones.  So the callee IS inlined at -O1, and
	// the cloned pad must RefDec the temp on the OOB fault (then chain to doFault's
	// call-site pad, which RefDecs g).  A dropped clone leaks the temp or g.
	if countAllBCCalls(vm1) != 0 {
		return "single-block managed-slice-TEMP fault callee should be inlined at -O1 (Inc 3b)"
	}
	var d1 int = faultLoopDelta(src, "test.doFault", 1, 30, true)
	if d1 == -1000000 { return "O1: f(9) OOB must fault" }
	if d1 != 0 {
		return "O1 inlined managed-slice-TEMP fault LEAKS (cloned pad dropped the temp or g)"
	}
	return ""
}

// TestInlineNonEmptyPadLocalNoLeak (Inc 3b): the callee holds a managed-ptr LOCAL
// (`@Node n`) live at its bounds check, so the pad is NON-empty but single-block
// (straight-line RefDec of n).  At -O1 it inlines; the cloned pad RefDecs n and
// CHAINS into doFault's call-site pad (which RefDecs g).  An OOB fault must free
// BOTH n and g — a dropped clone or a broken chain leaks one or both.
func TestInlineNonEmptyPadLocalNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Node struct { v int }\n"
			"func dv(d int) int {\n"
			"\tvar n @Node = make(Node)\n"
			"\treturn 10 / d\n"
			"}\n"
			"func doFault() int {\n"
			"\tvar g @[]int = make_slice(int, 4)\n"
			"\tvar r int = dv(0)\n"
			"\treturn len(g) + r\n"
			"}\n"
	var m1 @ir.Module = genModule(src)
	var vm1 @VM = NewVM(1024 * 1024)
	registerTestExterns(vm1)
	vm1.OptLevel = 1
	vm1.LowerModule(m1)
	if countAllBCCalls(vm1) != 0 {
		return "non-empty-pad LOCAL (div-fault) callee `dv` was NOT inlined at -O1 (over threshold?)"
	}
	var d0 int = faultLoopDelta(src, "test.doFault", 0, 30, true)
	var d1 int = faultLoopDelta(src, "test.doFault", 1, 30, true)
	if d0 == -1000000 { return "O0: dv(0) div-by-zero must fault" }
	if d1 == -1000000 { return "O1: inlined dv(0) must fault" }
	if d0 != 0 { return "O0 baseline leaks on recovered fault (pre-existing)" }
	if d1 != 0 { return "O1 inlined non-empty-pad LOCAL fault LEAKS: cloned pad/chain dropped n or g" }
	return ""
}

// TestInlineNonEmptyPadLocalInBounds (Inc 3b): same callee, in-bounds — n is
// created, used, and RefDec'd on the normal (non-fault) path.  The inlined path
// must not leak n across repeated calls, and give n.v(3)+a[1](7)=10.
func TestInlineNonEmptyPadLocalInBounds() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Node struct { v int }\n"
			"func dv(d int) int {\n"
			"\tvar n @Node = make(Node)\n"
			"\treturn 10 / d\n"
			"}\n"
			"func main() int {\n"
			"\treturn dv(2)\n"
			"}\n"
	var mc @ir.Module = genModule(src)
	var vmc @VM = NewVM(1024 * 1024)
	registerTestExterns(vmc)
	vmc.OptLevel = 1
	vmc.LowerModule(mc)
	if countAllBCCalls(vmc) != 0 {
		return "non-empty-pad LOCAL (div-fault) callee `dv` was NOT inlined at -O1 (in-bounds test vacuou"
				"s)"
	}
	var d1 int = faultLoopDelta(src, "test.main", 1, 30, false)
	if d1 == -1000000 { return "O1: dv(2) must NOT fault" }
	if d1 != 0 { return "O1 inlined non-empty-pad LOCAL in-bounds LEAKS n" }
	var r0 int = runVMAtLevel(src, 0)
	var r1 int = runVMAtLevel(src, 1)
	if r0 != 5 { return "O0 baseline should be 10/2=5" }
	if r1 != 5 { return "O1 inlined non-empty-pad LOCAL result should be 5 (n made+freed)" }
	return ""
}

// TestInlineManagedPtrParamFaultNoLeak (Inc 3b): a SMALL callee with a managed-ptr
// PARAM `p` live at a div-by-zero check has a single-block non-empty pad (RefDec
// p), so Inc 3b inlines it.  On the fault the cloned pad RefDecs p (the caller's
// arg q) and chains into doFault's call-site pad (RefDecs g and q); the
// entry-RefInc of the owned param balances the cloned pad's RefDec, so q is freed
// exactly once.  A leak/double-free here means that balance broke.
func TestInlineManagedPtrParamFaultNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Node struct { v int }\n"
			"func at(p @Node, d int) int { return 10 / d }\n"
			"func doFault() int {\n"
			"\tvar g @[]int = make_slice(int, 4)\n"
			"\tvar q @Node = make(Node)\n"
			"\tvar r int = at(q, 0)\n"
			"\treturn len(g) + q.v + r\n"
			"}\n"
	var m1 @ir.Module = genModule(src)
	var vm1 @VM = NewVM(1024 * 1024)
	registerTestExterns(vm1)
	vm1.OptLevel = 1
	vm1.LowerModule(m1)
	if countAllBCCalls(vm1) != 0 {
		return "small managed-ptr PARAM fault callee should inline at -O1 (Inc 3b)"
	}
	var d1 int = faultLoopDelta(src, "test.doFault", 1, 30, true)
	if d1 == -1000000 { return "O1: at(q,0) div-by-zero must fault" }
	if d1 != 0 { return "O1 inlined managed-ptr PARAM fault LEAKS/imbalances q or g" }
	return ""
}

// A multi-block + non-empty-pad + OOB *leak* test is intentionally absent: a
// single-return multi-block callee that also owns a managed value live at a fault
// exceeds the default InlineSizeThreshold, so it does not inline at -O1 (a size
// gate, not a defect).  Its safety follows by composition — the pad clone+chain
// is cloneSingleBlockPad (covered by the single-block leak tests above), and the
// multi-block CFG split is covered by the non-fault multi-block exec tests
// (vm_inline_test.bn TestInlineMultiBlockExecVM; ir TestInlineMultiBlockCallee).

// TestInlineMultiReturnExecVM (Inc 4): a callee with TWO return sites (early
// return) is inlined via the multi-block merge SLOT (each return stores its value
// then jumps; the continuation loads the slot).  Both paths must give the -O0
// result.  classify(5)=105, classify(-5)=-105 -> 105 + (-105)*1000 = -104895.
func TestInlineMultiReturnExecVM() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func classify(x int) int {\n"
			"\tif x > 0 {\n"
			"\t\treturn x + 100\n"
			"\t}\n"
			"\treturn x - 100\n"
			"}\n"
			"func main() int {\n"
			"\treturn classify(5) + classify(-5) * 1000\n"
			"}\n"
	var mc @ir.Module = genModule(src)
	var vmc @VM = NewVM(1024 * 1024)
	registerTestExterns(vmc)
	vmc.OptLevel = 1
	vmc.LowerModule(mc)
	if countAllBCCalls(vmc) != 0 {
		return "multi-return callee `classify` should be inlined at -O1 (Inc 4)"
	}
	var r0 int = runVMAtLevel(src, 0)
	var r1 int = runVMAtLevel(src, 1)
	if r0 != -104895 { return "baseline -O0 should be -104895" }
	if r1 != -104895 { return "inlined multi-return -O1 must match -O0 (-104895)" }
	return ""
}

// TestInlineMultiReturnManagedNoLeak (Inc 4): a multi-return callee returning a
// MANAGED @Node (each `return make(Node)` RefIncs the returned value; the merge
// slot holds it, the continuation loads it as the +1-owned call result).  Exactly
// one return path runs, so make/RefInc/store balance the caller's eventual RefDec
// — no leak.  Positive control + rt.LiveBlocks() delta over 30 runs.
func TestInlineMultiReturnManagedNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Node struct { v int }\n"
			"func mk(c bool) @Node {\n"
			"\tif c {\n"
			"\t\treturn make(Node)\n"
			"\t}\n"
			"\treturn make(Node)\n"
			"}\n"
			"func run() int {\n"
			"\tvar g @[]int = make_slice(int, 4)\n"
			"\tvar p @Node = mk(true)\n"
			"\treturn len(g) + p.v\n"
			"}\n"
	var m1 @ir.Module = genModule(src)
	var vm1 @VM = NewVM(1024 * 1024)
	registerTestExterns(vm1)
	vm1.OptLevel = 1
	vm1.LowerModule(m1)
	if countAllBCCalls(vm1) != 0 {
		return "multi-return managed callee `mk` should be inlined at -O1 (Inc 4)"
	}
	var d1 int = faultLoopDelta(src, "test.run", 1, 30, false)
	if d1 == -1000000 { return "O1: run() must NOT fault" }
	if d1 != 0 {
		return "O1 inlined multi-return MANAGED result LEAKS (merge-slot RefInc/store imbalance)"
	}
	return ""
}

// TestInlineAggStructReturnVM (Inc 5a): a callee returning a by-value struct
// inlines; the aggregate return VALUE flows to the caller's field extracts just
// like a scalar.  mkpt(3,4): q.x*10 + q.y = 34.
func TestInlineAggStructReturnVM() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Point struct { x int\n y int }\n"
			"func mkpt(a int, b int) Point {\n\tvar p Point\n\tp.x = a\n\tp.y = b\n\treturn p\n}\n"
			"func main() int {\n\tvar q Point = mkpt(3, 4)\n\treturn q.x * 10 + q.y\n}\n"
	var mc @ir.Module = genModule(src)
	var vmc @VM = NewVM(1024 * 1024)
	registerTestExterns(vmc)
	vmc.OptLevel = 1
	vmc.LowerModule(mc)
	if countAllBCCalls(vmc) != 0 {
		return "by-value struct-return callee should inline at -O1 (Inc 5a)"
	}
	var r0 int = runVMAtLevel(src, 0)
	var r1 int = runVMAtLevel(src, 1)
	if r0 != 34 { return "baseline -O0 should be 34" }
	if r1 != 34 { return "inlined struct-return -O1 must be 34" }
	return ""
}

// TestInlineAggMultiReturnStructVM (Inc 5a + Inc 4): a struct-returning callee
// with TWO return sites inlines via the aggregate-typed merge slot (each return
// stores its struct value; the continuation loads it).
func TestInlineAggMultiReturnStructVM() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type Pt struct { x int\n y int }\n"
			"func pick(c bool) Pt {\n\tvar p Pt\n\tif c {\n"
			"\t\tp.x = 7\n\t\treturn p\n\t}\n\tp.x = 2\n\treturn p\n}\n"
			"func main() int {\n\tvar q Pt = pick(true)\n\treturn q.x\n}\n"
	var mc @ir.Module = genModule(src)
	var vmc @VM = NewVM(1024 * 1024)
	registerTestExterns(vmc)
	vmc.OptLevel = 1
	vmc.LowerModule(mc)
	if countAllBCCalls(vmc) != 0 {
		return "multi-return struct callee should inline at -O1 (Inc 5a)"
	}
	var r0 int = runVMAtLevel(src, 0)
	var r1 int = runVMAtLevel(src, 1)
	if r0 != 7 { return "baseline -O0 should be 7" }
	if r1 != 7 { return "inlined multi-return struct -O1 must be 7" }
	return ""
}

// TestInlineAggManagedSliceReturnNoLeak (Inc 5a): a callee returning a managed
// slice (@[]int, +1 owned on the backing) inlines; the 4-word slice value (incl.
// the refptr) is bit-copied through retVal with no implicit refcount, so the +1
// flows to the caller unchanged.  rt.LiveBlocks() delta 0 over repeated runs.
func TestInlineAggManagedSliceReturnNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func mk(n int) @[]int { return make_slice(int, n) }\n"
			"func run() int {\n\tvar s @[]int = mk(4)\n\treturn len(s)\n}\n"
	var m1 @ir.Module = genModule(src)
	var vm1 @VM = NewVM(1024 * 1024)
	registerTestExterns(vm1)
	vm1.OptLevel = 1
	vm1.LowerModule(m1)
	if countAllBCCalls(vm1) != 0 {
		return "managed-slice-return callee should inline at -O1 (Inc 5a)"
	}
	var d1 int = faultLoopDelta(src, "test.run", 1, 30, false)
	if d1 == -1000000 { return "O1: run() must NOT fault" }
	if d1 != 0 { return "O1 inlined managed-slice return LEAKS (bit-copy dropped/dup'd the +1)" }
	return ""
}
