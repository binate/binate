package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/builtins/testing"

// Execution-based coverage of the within-package inliner (pkg/binate/ir
// inline_calls.bn / inline_multiblock.bn), which runs in RunOptPasses at
// OptLevel >= 1.  Conformance/e2e run at -O0, so the inliner never executes
// there; this RUNS a multi-block-inlined program on the bytecode VM at -O1 and
// checks the result against the -O0 baseline — guarding the CFG-split path's
// runtime correctness on the VM (the backend most prone to a SILENT miscompile
// from a bad remap, since it keys register/frame slots by SSA id).
// genModule / registerTestExterns / execFunc live in the vm test harness.

// runVMAtLevel compiles `src`, runs ir.RunOptPasses at `level` (via
// vm.OptLevel), lowers to bytecode, and executes test.main, returning its int
// result.
func runVMAtLevel(src *[]readonly char, level int) int {
	var m @ir.Module = genModule(src)
	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.OptLevel = level
	vm.LowerModule(m)
	var idx int = vm.LookupFunc("test.main")
	if idx < 0 {
		return -1
	}
	var noArgs @[]int
	return cast(int, execFunc(vm, idx, noArgs))
}

// TestInlineMultiBlockExecVM: a multi-block (diamond) single-return callee
// `pick` is inlined at -O1 via the CFG split; running the program on the VM must
// give the same result as the un-inlined -O0 baseline.  `pick(true,5)=0` (the
// if-branch zeroes r) and `pick(false,5)=5` (r keeps a); `x + y*10 = 50`
// distinguishes correct branch behavior from a mis-wired CFG.
func TestInlineMultiBlockExecVM() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func pick(c bool, a int) int {\n"
			"\tvar r int = a\n"
			"\tif c {\n"
			"\t\tr = 0\n"
			"\t}\n"
			"\treturn r\n"
			"}\n"
			"func main() int {\n"
			"\tvar x int = pick(true, 5)\n"
			"\tvar y int = pick(false, 5)\n"
			"\treturn x + y * 10\n"
			"}\n"
	var r0 int = runVMAtLevel(src, 0) // no inlining
	var r1 int = runVMAtLevel(src, 1) // inliner runs (multi-block pick inlined)
	if r0 != 50 {
		return "baseline -O0 result should be 50"
	}
	if r1 != 50 {
		return "inlined -O1 result should match the -O0 baseline (50)"
	}
	return ""
}

// TestInlineSingleBlockExecVM: the single-block splice path, executed at -O1 on
// the VM.  add(a,b) inlines; the sum must be correct.
func TestInlineSingleBlockExecVM() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func add(a int, b int) int { return a + b }\n"
			"func main() int {\n"
			"\treturn add(3, 4) + add(10, 20)\n"
			"}\n"
	var r1 int = runVMAtLevel(src, 1)
	if r1 != 37 {
		return "inlined -O1 result should be 3+4 + 10+20 = 37"
	}
	return ""
}

// TestInlineFaultOpExecVM (Inc 3a): a callee with a bounds check whose pad is
// EMPTY (raw-slice param + int, no managed locals) is inlined at -O1, with the
// cloned check reusing the caller's call-site pad.  In-bounds must give the same
// result as the -O0 baseline.
func TestInlineFaultOpExecVM() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func at(s *[]int, i int) int { return s[i] }\n"
			"func main() int {\n"
			"\tvar a [3]int\n"
			"\ta[0] = 10\n"
			"\ta[1] = 20\n"
			"\ta[2] = 30\n"
			"\treturn at(a[:], 1)\n"
			"}\n"
	var r0 int = runVMAtLevel(src, 0)
	var r1 int = runVMAtLevel(src, 1)
	if r0 != 20 {
		return "baseline -O0 result should be 20"
	}
	if r1 != 20 {
		return "inlined -O1 fault-op callee should give 20"
	}
	return ""
}

// TestInlineFaultOpFaultsVM (Inc 3a): an OOB access inside an inlined empty-pad
// fault-op callee must still FAULT at -O1 — the cloned bounds check reuses the
// caller's call-site pad, so the recoverable fault unwinds correctly on the VM.
func TestInlineFaultOpFaultsVM() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func at(s *[]int, i int) int { return s[i] }\n"
			"func main() int {\n"
			"\tvar a [3]int\n"
			"\ta[0] = 10\n"
			"\treturn at(a[:], 5)\n"
			"}\n"
	var m @ir.Module = genModule(src)
	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.OptLevel = 1
	vm.LowerModule(m)
	var argv @[]int
	vm.CallFunc("test.main", argv)
	if vm.Status != VM_STATUS_FAULTED {
		return "OOB in an inlined empty-pad fault-op callee must fault at -O1"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: index out of bounds: 5 (len 3)") {
		return "expected the inlined OOB fault message"
	}
	return ""
}
