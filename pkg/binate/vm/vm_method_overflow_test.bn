package "pkg/binate/vm"

import "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/irgen"
import "pkg/binate/parser"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A static method call delivers its receiver only AFTER the recoverable-stack-
// overflow pre-check (genMethodCall: evaluate, OP_STACK_CHECK, deliver), as genCall
// does its args.  A receiver represented as a managed interface value (`type X @J`)
// is an @Iface argument (mem.param: the caller hands the callee one reference), so a
// borrowed one is acquired and a fresh one moved; delivered BEFORE the check, a
// frame-push overflow — where the method never starts to release it — orphans that
// reference.  `rec` recurses on a borrowed receiver (`x.rec`), `recFresh` on a fresh
// one (`mkX().recFresh`); each overflow must recover with Status = FAULTED and leak
// nothing.

func methodOverflowSrc() *[]readonly char {
	return "package \"test\"\n"
			"interface J { Get() int }\n"
			"type C struct { n int }\n"
			"func (c @C) Get() int { return c.n }\n"
			"impl @C : J\n"
			"type X @J\n"
			"func mkX() X { return cast(X, cast(@J, make(C))) }\n"
			"func (x X) rec(depth int) int {\n"
			"	if depth <= 0 { return 0 }\n"
			"	return x.rec(depth - 1)\n"
			"}\n"
			"func (x X) recFresh(depth int) int {\n"
			"	if depth <= 0 { return 0 }\n"
			"	return mkX().recFresh(depth - 1)\n"
			"}\n"
			"func start(depth int) int { return mkX().rec(depth) }\n"
			"func startFresh(depth int) int { return mkX().recFresh(depth) }\n"
}

// methodOverflowLeaks calls fn (which must overflow the VM stack) once to warm up,
// then 20 more times, and reports the net rt.LiveBlocks() growth of those 20 calls
// in *out.  Returns "" on success, else a failure.
func methodOverflowLeaks(fn *[]readonly char, out *int) testing.TestResult {
	var p @parser.Parser = parser.New(toBytes(methodOverflowSrc()), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = irgen.GenModule(c, file)
	var vm @VM = newTestVM(64 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)

	var argv @[]int = make_slice(int, 1)
	argv[0] = 100000000 // deep enough to overflow the 64 KiB stack
	vm.CallFunc(fn, argv)
	if vm.Status != VM_STATUS_FAULTED {
		return "deep method recursion must recover with Status = FAULTED (stack overflow)"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: stack overflow") {
		return "expected the stack-overflow fault message"
	}
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc(fn, argv)
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated overflow must recover identically (VM state intact)"
	}
	*out = rt.LiveBlocks() - base
	return ""
}

// TestMethodCallOverflowBorrowedReceiverNoLeak: a borrowed @Iface-represented
// receiver is acquired only after the pre-check, so an overflow leaks nothing.
func TestMethodCallOverflowBorrowedReceiverNoLeak() testing.TestResult {
	var leaked int
	var r testing.TestResult = methodOverflowLeaks("test.start", &leaked)
	if len(r) != 0 { return r }
	if leaked != 0 {
		return "a method-call overflow leaked the acquired receiver reference"
	}
	return ""
}

// TestMethodCallOverflowFreshReceiverNoLeak: a fresh @Iface-represented receiver
// stays a live temp until after the pre-check, so the check's pad releases it.
func TestMethodCallOverflowFreshReceiverNoLeak() testing.TestResult {
	var leaked int
	var r testing.TestResult = methodOverflowLeaks("test.startFresh", &leaked)
	if len(r) != 0 { return r }
	if leaked != 0 {
		return "a method-call overflow leaked the moved fresh receiver"
	}
	return ""
}
