package "pkg/binate/vm"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/irgen"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A method-value WRAPPER's forwarding call gets a recoverable-stack-overflow
// pre-check (OP_STACK_CHECK on the wrapped method): synthMethodValueWrapper loads
// its params, pre-checks the forward, and attachMethodValueForwardPad releases the
// wrapper's OWNED moved params on overflow.  Without it, the wrapper forwards its
// owned @I param to the method BY MOVE, so a frame-push overflow — where the method
// never starts to release it — orphans the param.
//
// The signal is a DIFFERENCE, not an absolute count: a method value over a managed
// receiver also leaks its closure record on the overflow fault — a SEPARATE,
// tracked bug (claude-todo.md) that leaks identically whether or not there is a
// moved param.  So two programs — one whose method takes a moved @I param, one that
// takes none, with the same receiver + overflowing frame — leak the same closure
// record; the PARAM leak is the extra block the with-param program leaks.  With the
// pre-check they leak equally; without it the with-param program leaks one more.

// mvOverflowLeakDelta calls `test.start` (which must overflow the VM stack via a
// method-value wrapper's forward), then measures the net rt.LiveBlocks() growth of
// one further call and writes it to *out.  Returns "" on success, else a failure.
func mvOverflowLeakDelta(src *[]readonly char, out *int) testing.TestResult {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = irgen.GenModule(c, file)
	var vm @VM = newTestVM(64 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)

	var noArgs @[]int
	vm.CallFunc("test.start", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "the wrapper's forward frame push must overflow with Status = FAULTED"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: stack overflow") {
		return "expected the stack-overflow fault message"
	}
	var base int = rt.LiveBlocks()
	vm.CallFunc("test.start", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated wrapper-forward overflow must recover identically (VM state intact)"
	}
	*out = rt.LiveBlocks() - base
	return ""
}

// TestMethodValueForwardOverflowParamNoLeak: the wrapper pre-check releases the
// moved @I param on the forward overflow, so a method whose wrapper forwards a
// moved @I arg leaks no more than the same method with no arg (both leak only the
// separately-tracked closure record).  Without the pre-check the with-param program
// leaks one extra block (the orphaned @I).
func TestMethodValueForwardOverflowParamNoLeak() testing.TestResult {
	// Program A: `run(iv @I)` — the wrapper forwards a moved @I param.
	var srcA *[]readonly char = "package \"test\"\n"
			"interface I { m() int }\n"
			"type T struct { x int }\n"
			"func (t @T) m() int { return t.x }\n"
			"impl @T : I\n"
			"type Big struct { y int }\n"
			"func (b @Big) run(iv @I) int {\n"
			"	var buf [100000]int\n"
			"	buf[0] = iv.m()\n"
			"	return buf[0]\n"
			"}\n"
			"func start() int {\n"
			"	var b @Big = make(Big)\n"
			"	var mv *func(@I) int = b.run\n"
			"	return mv(cast(@I, make(T)))\n"
			"}\n"
	// Program B: `run()` — same receiver + overflowing frame, no moved param.
	var srcB *[]readonly char = "package \"test\"\n"
			"type Big struct { y int }\n"
			"func (b @Big) run() int {\n"
			"	var buf [100000]int\n"
			"	buf[0] = b.y\n"
			"	return buf[0]\n"
			"}\n"
			"func start() int {\n"
			"	var b @Big = make(Big)\n"
			"	var mv *func() int = b.run\n"
			"	return mv()\n"
			"}\n"
	var dA int = 0
	var rA testing.TestResult = mvOverflowLeakDelta(srcA, &dA)
	if len(rA) > 0 { return rA }
	var dB int = 0
	var rB testing.TestResult = mvOverflowLeakDelta(srcB, &dB)
	if len(rB) > 0 { return rB }
	if dA != dB {
		return "wrapper forward overflow leaked the moved @I param (with-param delta > no-param)"
	}
	return ""
}
