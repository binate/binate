package "pkg/binate/vm"

import "pkg/builtins/testing"

// A call result that IR-gen moves into the variable, literal or element keeping it
// (spec mem.move) is released exactly once when a recoverable fault later unwinds
// the function — by the fault pad that releases its new owner — and, when a
// deferred call faults at a return before the move, as the statement's temp.  Each
// function below faults through a nil function-value call (in boom, or deferred);
// runReturnLeak loops it and compares live blocks.

// moveFaultSrc is a package whose R holds a freshly made @B, and whose functions
// fault after a call result of R has been moved somewhere.
func moveFaultSrc() *[]readonly char {
	return "package \"test\"\n"
			"type B struct { v int }\n"
			"type R struct {\n\tb @B\n\tn int\n}\n"
			"type P struct {\n\tr R\n\tk int\n}\n"
			"func mk() R {\n\tvar r R\n\tr.b = make(B)\n\treturn r\n}\n"
			"func boom() int {\n\tvar fv @func() int\n\treturn fv()\n}\n"
			"func intoVar() int {\n\tvar r R = mk()\n\treturn r.n + boom()\n}\n"
			"func intoAssign() int {\n\tvar r R\n\tr = mk()\n\treturn r.n + boom()\n}\n"
			"func intoLiteral() int {\n\tvar p P = P{r: mk(), k: boom()}\n\treturn p.k\n}\n"
			"func intoSlice() int {\n\tvar s @[]R = @[]R{mk(), mk()}\n"
			"\ts[1] = mk()\n\treturn len(s) + boom()\n}\n"
			"func returned() R {\n\tvar fv @func() int\n\tdefer fv()\n\treturn mk()\n}\n"
}

// runMoveFault runs moveFaultSrc's function fn (test.<name>) through
// runReturnLeak: it must fault, and leave no block behind per faulting call.
func runMoveFault(fn *[]readonly char) testing.TestResult {
	var base int = 0
	var after int = 0
	base, after = runReturnLeak(moveFaultSrc(), fn)
	if base == -1 { return "unexpected checker errors" }
	if base == -2 { return "the function should fault (Status = FAULTED)" }
	if after != base { return "a moved call result leaked, or was released twice, on the fault" }
	return ""
}

// A call result moved into a variable is released with it.
func TestMovedIntoVarReleasedOnFault() testing.TestResult { return runMoveFault("test.intoVar") }

// A call result assigned to a variable is released with it.
func TestMovedIntoAssignReleasedOnFault() testing.TestResult {
	return runMoveFault("test.intoAssign")
}

// A call result moved into a struct literal's field is released with the literal
// when a later field faults.
func TestMovedIntoLiteralReleasedOnFault() testing.TestResult {
	return runMoveFault("test.intoLiteral")
}

// Call results moved into a managed-slice literal and a slice element are released
// with the slice.
func TestMovedIntoSliceReleasedOnFault() testing.TestResult {
	return runMoveFault("test.intoSlice")
}

// A returned call result, when a deferred call faults before the move, is released
// as the statement's temp.
func TestReturnedCallResultReleasedOnDeferredFault() testing.TestResult {
	return runMoveFault("test.returned")
}
