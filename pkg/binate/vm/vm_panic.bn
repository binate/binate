package "pkg/binate/vm"

import "pkg/std/strings"

// vmPanic / vmPanicName terminate the VM on an internal-invariant violation —
// a "this should never happen" condition (the VM was handed invalid IR/bytecode
// or is itself broken).  They route through the panic() builtin (→ rt.Panic →
// rt.Abort), so every VM fatal diagnostic shares one output sink (and one place
// to later redirect to stderr).  Thin wrappers rather than panic() at each call
// site: panic() is noreturn, so wrapping it in a normal call keeps the call
// sites drop-in for the former print-then-terminate without churning control
// flow, and lets vmPanicName build a dynamic message in one place.
//
// User-code faults (a bad interpreted program: out-of-bounds, divide-by-zero,
// nil deref, stack overflow, call-through-nil) do NOT use these — they stay on
// the rt fault handlers (which abort), slated to become VM-recoverable rather than
// host-killing (plan-rt-abort-panic.md, Plan 2).

// vmPanic aborts with the message msg (rendered as "panic: <msg>").
func vmPanic(msg *[]readonly char) {
	panic(msg)
}

// panicMessage renders prefix followed by name as one owned string — the body
// of vmPanicName, factored out so it is unit-testable (vmPanic / vmPanicName
// themselves terminate the process and cannot be called in-process).
func panicMessage(prefix *[]readonly char, name *[]readonly char) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write(prefix)
	b.Write(name)
	return b.String()
}

// vmPanicName aborts with prefix followed by a computed name/value (e.g. an
// extern, vtable, or function name), avoiding a strings.Builder dance at each
// dynamic abort site.
func vmPanicName(prefix *[]readonly char, name *[]readonly char) {
	vmPanic(panicMessage(prefix, name))
}
