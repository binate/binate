package "pkg/binate/vm"

import "pkg/builtins/testing"

// panicMessage is the testable body of vmPanicName (the abort wrappers
// themselves terminate the process, so they can't be exercised in-process).
func TestPanicMessage() testing.TestResult {
	var got @[]readonly char = panicMessage(
		"vm: extern not found: ", "pkg/std/os.cLseek")
	var want *[]readonly char = "vm: extern not found: pkg/std/os.cLseek"
	if len(got) != len(want) {
		return "panicMessage: wrong length"
	}
	for i := 0; i < len(got); i++ {
		if got[i] != want[i] {
			return "panicMessage: wrong content"
		}
	}
	return ""
}

// An empty prefix or name composes cleanly.
func TestPanicMessageEmptyParts() testing.TestResult {
	var a @[]readonly char = panicMessage("", "bare")
	if len(a) != 4 { return "empty prefix should give just the name" }
	var b @[]readonly char = panicMessage("only", "")
	if len(b) != 4 { return "empty name should give just the prefix" }
	return ""
}
