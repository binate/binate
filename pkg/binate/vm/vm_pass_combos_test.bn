package "pkg/binate/vm"

import "pkg/binate/iropt"
import "pkg/builtins/testing"

// VM execution under pass configurations other than the -O levels: each pass
// must be correct whichever others run.

// sumSrc sums a managed slice through a local initialized from its length: with
// load-forwarding but not mem2reg, `n`'s single store is forwarded, and its
// stored value (the slice's length extract) is one that slice-load RLE and
// extract coalescing replace — the forwarded loads must follow that replacement.
func sumSrc() *[]readonly char {
	return "package \"test\"\n"
			"func sum(b @[]int) int {\n"
			"\tvar e int = 0\n"
			"\tvar n int = len(b)\n"
			"\tfor i := 0; i < n; i++ {\n"
			"\t\te = e + b[i]\n"
			"\t}\n"
			"\treturn e\n"
			"}\n"
			"func run() int {\n"
			"\tvar s @[]int = make_slice(int, 3)\n"
			"\ts[0] = 4\n"
			"\ts[1] = 5\n"
			"\ts[2] = 6\n"
			"\treturn sum(s)\n"
			"}\n"
}

func TestVMLoadFwdWithoutMem2reg() testing.TestResult {
	var configs @[]iropt.OptConfig = make_slice(iropt.OptConfig, 3)
	configs[0] = iropt.WithOptPass(iropt.LevelOptConfig(0), iropt.PASS_LOAD_FWD, true)
	configs[1] = iropt.WithOptPass(iropt.LevelOptConfig(2), iropt.PASS_MEM2REG, false)
	configs[2] = iropt.LevelOptConfig(2)
	for i := 0; i < len(configs); i++ {
		var r int
		var f bool
		var d int
		r, f, d = shapedRun(sumSrc(), "test.run", configs[i], 5)
		if f { return "run() must not fault" }
		if r != 15 { return "sum through a forwarded length local must be 15" }
		if d != 0 { return "run() must not leak" }
	}
	return ""
}
