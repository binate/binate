package "pkg/binate/vm"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the interrupt-seam poll hooks (vm_exec.bn / vmPollPoint).
// The seam is inert by default (no Poll installed); these install a Poll
// via SetPoll to prove the hooks fire at loop back-edges / statement
// boundaries, that POLL_CONTINUE is transparent, and that a non-Continue
// poll result is recorded into vm.Status.  toBytes / concatStr live in
// vm_test.bn (same package).
//
// NOTE: these polls are deliberately NON-CAPTURING.  A capturing @func
// stored via SetPoll (the real-world case — a host poll closes over its
// interrupt state) currently hits a MAJOR refcount bug (capturing @func
// param → struct field is not RefInc'd → use-after-free): see
// conformance/534_func_value_param_to_field_capture and the CRITICAL
// "@func/@Iface copy-RefInc symmetry" entry in claude-todo.md.  Firing
// is still proven below WITHOUT a capture: TestPollSuspendRecordsStatus
// shows vm.Status flips to SUSPENDED, which only happens if vmPollPoint
// actually ran at a hook.

// loopSrc is a function with a 10-iteration for-loop, guaranteeing the
// seam's back-edge / statement-boundary poll points are exercised; main
// returns 0+1+...+9 = 45.
func loopSrc() @[]char {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var sum int = 0\n")
	src = concatStr(src, "  for i := 0; i < 10; i++ { sum = sum + i }\n")
	src = concatStr(src, "  return sum\n")
	src = concatStr(src, "}\n")
	return src
}

// buildLoopVM compiles loopSrc into a fresh VM, ready to run "test.main".
func buildLoopVM() @VM {
	var p @parser.Parser = parser.New(toBytes(loopSrc()), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	var m @ir.Module = ir.GenModule(file)
	var vm @VM = NewVM(1024 * 1024)
	RegisterStandardExterns(vm)
	vm.LowerModule(m)
	return vm
}

// A CONTINUE-returning poll leaves execution byte-for-byte unchanged.
func TestPollContinueIsTransparent() testing.TestResult {
	var vm @VM = buildLoopVM()
	var poll @func(@VM) int = func(v @VM) int {
		return POLL_CONTINUE
	}
	vm.SetPoll(poll)
	var noArgs @[]int
	var result int = vm.CallFunc("test.main", noArgs)
	if result != 45 {
		return "CONTINUE poll must be transparent: loop sum should be 45"
	}
	if vm.Status != VM_STATUS_CONTINUE {
		return "a CONTINUE poll must leave Status at Continue"
	}
	return ""
}

// A SUSPEND-returning poll is RECORDED into Status (v1 does not yet
// unwind, so the loop still completes — recording is the whole seam).
// Status flipping to SUSPENDED also PROVES the hook actually fired.
func TestPollSuspendRecordsStatus() testing.TestResult {
	var vm @VM = buildLoopVM()
	var poll @func(@VM) int = func(v @VM) int {
		return POLL_SUSPEND
	}
	vm.SetPoll(poll)
	var noArgs @[]int
	var result int = vm.CallFunc("test.main", noArgs)
	if result != 45 {
		return "v1 records but does not unwind: the loop still completes"
	}
	if vm.Status != VM_STATUS_SUSPENDED {
		return "a SUSPEND poll must fire and record VM_STATUS_SUSPENDED"
	}
	// The resume point is recorded too (a poll point is always at pc > 0
	// inside the function body, so a recorded ResumePC proves the spill).
	if vm.ResumePC <= 0 {
		return "a SUSPEND poll must record a resume pc"
	}
	return ""
}

// A BREAK-returning poll records VM_STATUS_BROKE (the abort-to-prompt
// signal).  Symmetric to the SUSPEND path; v1 records without unwinding.
func TestPollBreakRecordsStatus() testing.TestResult {
	var vm @VM = buildLoopVM()
	var poll @func(@VM) int = func(v @VM) int {
		return POLL_BREAK
	}
	vm.SetPoll(poll)
	var noArgs @[]int
	var result int = vm.CallFunc("test.main", noArgs)
	if result != 45 {
		return "v1 records but does not unwind: the loop still completes"
	}
	if vm.Status != VM_STATUS_BROKE {
		return "a BREAK poll must fire and record VM_STATUS_BROKE"
	}
	return ""
}

// With no Poll installed the gate stays closed, the loop runs untouched,
// and Status stays Continue — the inert default.
func TestSeamInertByDefault() testing.TestResult {
	var vm @VM = buildLoopVM()
	if vm.PollEnabled {
		return "PollEnabled must default to false (inert seam)"
	}
	var noArgs @[]int
	var result int = vm.CallFunc("test.main", noArgs)
	if result != 45 { return "loop should run normally with no poll" }
	if vm.Status != VM_STATUS_CONTINUE {
		return "Status must stay Continue with no poll installed"
	}
	return ""
}

// SetPoll arms the gate; Resume is a no-op in v1.
func TestSetPollArmsGateResumeNoOp() testing.TestResult {
	var vm @VM = buildLoopVM()
	var poll @func(@VM) int = func(v @VM) int { return POLL_CONTINUE }
	vm.SetPoll(poll)
	if !vm.PollEnabled {
		return "SetPoll must arm the poll gate"
	}
	if vm.Resume() != 0 {
		return "Resume must be a no-op (return 0) in v1"
	}
	return ""
}
