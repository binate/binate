package "pkg/binate/vm"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for the interrupt-seam poll hooks (vm_exec.bn / vmPollPoint).
// The seam is inert by default (no Poll installed); these install a Poll
// via SetPoll to prove the hooks fire at loop back-edges / statement
// boundaries, that POLL_CONTINUE is transparent, and that a non-Continue
// poll result is recorded into vm.Status.  toBytes / concatStr live in
// vm_test.bn (same package).
//
// Both poll shapes are covered.  The basic firing / inert-default tests
// below use NON-CAPTURING polls; TestCapturingPoll* install a CAPTURING
// @func — the real-world shape, where a host poll closes over its
// interrupt state.  The capturing case matters because SetPoll stores the
// poll into vm.Poll (an @func param→field store): that store must RefInc
// the closure record so it and its captured managed state outlive the
// caller's local, or the VM's later vm.Poll(vm) call reads a freed
// record.  A captured counter advancing on each fire proves the closure
// survived the store and was invoked with its capture intact
// (conformance/534 is the cross-mode anchor for the same param→field
// path; conformance/550 anchors the capture record's dtor).

// loopSrc is a function with a 10-iteration for-loop, guaranteeing the
// seam's back-edge / statement-boundary poll points are exercised; main
// returns 0+1+...+9 = 45.
func loopSrc() @[]char {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var sum int = 0\n")
	src = concatStr(src, "  for i := 0; i < 10; i++ { sum = sum + i }\n")
	src = concatStr(src, "  return sum\n")
	src = concatStr(src, "}\n")
	return src
}

// buildLoopVM compiles loopSrc into a fresh VM, ready to run "test.main".
func buildLoopVM() @VM {
	var p @parser.Parser = parser.New(toBytes(loopSrc()), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	var m @ir.Module = ir.GenModule(nil, file)
	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)
	return vm
}

// A CONTINUE-returning poll leaves execution byte-for-byte unchanged.
func TestPollContinueIsTransparent() testing.TestResult {
	var vm @VM = buildLoopVM()
	var poll @func(@VM) int = func(v @VM) int {
		return POLL_CONTINUE
	}
	vm.SetPoll(poll)
	var noArgs @[]int
	var result int = vm.CallFunc("test.main", noArgs)
	if result != 45 {
		return "CONTINUE poll must be transparent: loop sum should be 45"
	}
	if vm.Status != VM_STATUS_CONTINUE {
		return "a CONTINUE poll must leave Status at Continue"
	}
	return ""
}

// A SUSPEND-returning poll is RECORDED into Status (v1 does not yet
// unwind, so the loop still completes — recording is the whole seam).
// Status flipping to SUSPENDED also PROVES the hook actually fired.
func TestPollSuspendRecordsStatus() testing.TestResult {
	var vm @VM = buildLoopVM()
	var poll @func(@VM) int = func(v @VM) int {
		return POLL_SUSPEND
	}
	vm.SetPoll(poll)
	var noArgs @[]int
	var result int = vm.CallFunc("test.main", noArgs)
	if result != 45 {
		return "v1 records but does not unwind: the loop still completes"
	}
	if vm.Status != VM_STATUS_SUSPENDED {
		return "a SUSPEND poll must fire and record VM_STATUS_SUSPENDED"
	}
	// The resume point is recorded too (a poll point is always at pc > 0
	// inside the function body, so a recorded ResumePC proves the spill).
	if vm.ResumePC <= 0 {
		return "a SUSPEND poll must record a resume pc"
	}
	return ""
}

// A BREAK-returning poll records VM_STATUS_BROKE (the abort-to-prompt
// signal).  Symmetric to the SUSPEND path; v1 records without unwinding.
func TestPollBreakRecordsStatus() testing.TestResult {
	var vm @VM = buildLoopVM()
	var poll @func(@VM) int = func(v @VM) int {
		return POLL_BREAK
	}
	vm.SetPoll(poll)
	var noArgs @[]int
	var result int = vm.CallFunc("test.main", noArgs)
	if result != 45 {
		return "v1 records but does not unwind: the loop still completes"
	}
	if vm.Status != VM_STATUS_BROKE {
		return "a BREAK poll must fire and record VM_STATUS_BROKE"
	}
	return ""
}

// With no Poll installed the gate stays closed, the loop runs untouched,
// and Status stays Continue — the inert default.
func TestSeamInertByDefault() testing.TestResult {
	var vm @VM = buildLoopVM()
	if vm.PollEnabled {
		return "PollEnabled must default to false (inert seam)"
	}
	var noArgs @[]int
	var result int = vm.CallFunc("test.main", noArgs)
	if result != 45 { return "loop should run normally with no poll" }
	if vm.Status != VM_STATUS_CONTINUE {
		return "Status must stay Continue with no poll installed"
	}
	return ""
}

// SetPoll arms the gate; Resume is a no-op in v1.
func TestSetPollArmsGateResumeNoOp() testing.TestResult {
	var vm @VM = buildLoopVM()
	var poll @func(@VM) int = func(v @VM) int { return POLL_CONTINUE }
	vm.SetPoll(poll)
	if !vm.PollEnabled {
		return "SetPoll must arm the poll gate"
	}
	if vm.Resume() != 0 {
		return "Resume must be a no-op (return 0) in v1"
	}
	return ""
}

// pollCounter is a managed object a capturing poll closes over, so the
// capturing-poll tests exercise the @func capture record (and the managed
// value it holds) crossing SetPoll's param→field store.
type pollCounter struct {
	Hits int
}

// A CAPTURING CONTINUE poll fires transparently and mutates its captured
// counter.  The counter advancing proves the closure survived SetPoll's
// @func param→field store and was invoked by the VM with its capture
// intact — the path that UAF'd before the @func copy-RefInc fix.
func TestCapturingPollFiresViaSetPoll() testing.TestResult {
	var vm @VM = buildLoopVM()
	var ctr @pollCounter = make(pollCounter)
	ctr.Hits = 0
	var poll @func(@VM) int = func(v @VM) int {
		ctr.Hits = ctr.Hits + 1
		return POLL_CONTINUE
	}
	vm.SetPoll(poll)
	var noArgs @[]int
	var result int = vm.CallFunc("test.main", noArgs)
	if result != 45 {
		return "a capturing CONTINUE poll must be transparent: sum should be 45"
	}
	if ctr.Hits <= 0 {
		return "the capturing poll must fire and mutate its captured counter"
	}
	return ""
}

// A CAPTURING poll that suspends once its captured counter crosses a
// threshold: the capture must be both readable and writable across the
// VM's repeated internal invocations, and the recorded Status must reflect
// the poll's capture-driven decision.
func TestCapturingPollSuspendsAfterThreshold() testing.TestResult {
	var vm @VM = buildLoopVM()
	var ctr @pollCounter = make(pollCounter)
	ctr.Hits = 0
	var poll @func(@VM) int = func(v @VM) int {
		ctr.Hits = ctr.Hits + 1
		if ctr.Hits >= 3 { return POLL_SUSPEND }
		return POLL_CONTINUE
	}
	vm.SetPoll(poll)
	var noArgs @[]int
	var result int = vm.CallFunc("test.main", noArgs)
	if result != 45 {
		return "v1 records but does not unwind: the loop still completes"
	}
	if ctr.Hits < 3 {
		return "the poll must fire through its threshold (capture intact)"
	}
	if vm.Status != VM_STATUS_SUSPENDED {
		return "a capture-driven SUSPEND must record VM_STATUS_SUSPENDED"
	}
	return ""
}

// wrapPoll adapts a nullary host poll into the VM's @func(@VM) int shape
// by capturing it — mirroring how an embedder (pkg/binate/repl) keeps its
// poll delegate VM-free.  The wrapper captures a @func and calls it; that
// capture must RefInc the captured @func (gen_func_lit.bn
// emitCaptureRefInc) or the wrapper's dtor RefDec's a freed record (a UAF
// that surfaced as a flaky native crash here).  conformance/586 pins the
// root cause deterministically.
func wrapPoll(host @func() int) @func(@VM) int {
	var wrapped @func(@VM) int = func(v @VM) int {
		return host()
	}
	return wrapped
}

// A WRAPPER poll — a closure capturing another @func — installed via
// SetPoll and driven to SUSPEND through the VM poll path.  Same outcome as
// TestCapturingPollSuspendsAfterThreshold, but with the extra
// captured-@func layer an embedder uses to keep its poll VM-free.
func TestWrappedCapturingPollSuspends() testing.TestResult {
	var vm @VM = buildLoopVM()
	var ctr @pollCounter = make(pollCounter)
	ctr.Hits = 0
	var host @func() int = func() int {
		ctr.Hits = ctr.Hits + 1
		if ctr.Hits >= 3 { return POLL_SUSPEND }
		return POLL_CONTINUE
	}
	var w @func(@VM) int = wrapPoll(host)
	vm.SetPoll(w)
	var noArgs @[]int
	var result int = vm.CallFunc("test.main", noArgs)
	if result != 45 {
		return "v1 records but does not unwind: the loop still completes"
	}
	if ctr.Hits < 3 {
		return "the wrapped poll must fire through its threshold"
	}
	if vm.Status != VM_STATUS_SUSPENDED {
		return "a wrapped capture-driven SUSPEND must record VM_STATUS_SUSPENDED"
	}
	return ""
}
