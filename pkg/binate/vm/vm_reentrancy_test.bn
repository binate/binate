package "pkg/binate/vm"

import "pkg/builtins/testing"

// End-to-end reentrancy test.  It runs the WHOLE interpreter pipeline (parse ->
// type-check -> IR-gen -> VM-lower -> execute) twice, back to back and
// interleaved, in one process via compileAndRun (which builds a fresh
// @Checker / @Module / @VM each call — see vm_test.bn).
//
// The two programs both declare an interface NAMED "Speaker", but with
// DIFFERENT method sets (1 vs 2 methods) and different impls — so their
// vtables, interface registries, module structs/funcs, and emitted globals
// are structurally distinct.  Running them alternately exercises a full
// compile+run cycle's worth of IR-gen state (per-@Module:
// Consts/Structs/FuncSigs/GlobalVars/TypeAliases/Interfaces, the import-
// alias map, the gen context) and VM-lowering state (per-@VM:
// global/vtable registries).  If any of that were process-global
// and survived between sessions, the second program would dispatch against the
// first's "Speaker" (wrong vtable shape) and crash or return a wrong value.
// The per-subsystem isolation is unit-tested directly elsewhere
// (loader TestLoaderLoadingStackIsolation, vm TestGlobalAddrPerInstanceIsolation
// / TestVtableInjectPerInstanceIsolation, ir TestGenCtxRegistryIsolation); this
// test is the integration proof that the assembled pipeline is sequentially
// reentrant.

// reentrancyProgA: a 1-method `interface Speaker`; Dog.greet returns 7 + field.
// main constructs a Dog (field 3), dispatches via *Speaker -> 7 + 3 = 10.
func reentrancyProgA() @[]char {
	var s @[]char
	s = concatStr(s, "package \"test\"\n")
	s = concatStr(s, "interface Speaker { greet() int }\n")
	s = concatStr(s, "type Dog struct { n int }\n")
	s = concatStr(s, "func (d *Dog) greet() int { return 7 + d.n }\n")
	s = concatStr(s, "impl *Dog : Speaker\n")
	s = concatStr(s, "func main() int {\n")
	s = concatStr(s, "  var d Dog\n")
	s = concatStr(s, "  d.n = 3\n")
	s = concatStr(s, "  var sp *Speaker = &d\n")
	s = concatStr(s, "  return sp.greet()\n")
	s = concatStr(s, "}\n")
	return s
}

// reentrancyProgB: a 2-method `interface Speaker` (SAME name, different shape);
// Cat.lo returns 20, Cat.hi returns 5 + field.  main dispatches both via
// *Speaker -> 20 + (5 + 4) = 29.  Two methods means a different vtable size
// from progA's Speaker, so a leaked interface registry would mis-dispatch hi().
func reentrancyProgB() @[]char {
	var s @[]char
	s = concatStr(s, "package \"test\"\n")
	s = concatStr(s, "interface Speaker { lo() int; hi() int }\n")
	s = concatStr(s, "type Cat struct { k int }\n")
	s = concatStr(s, "func (c *Cat) lo() int { return 20 }\n")
	s = concatStr(s, "func (c *Cat) hi() int { return 5 + c.k }\n")
	s = concatStr(s, "impl *Cat : Speaker\n")
	s = concatStr(s, "func main() int {\n")
	s = concatStr(s, "  var c Cat\n")
	s = concatStr(s, "  c.k = 4\n")
	s = concatStr(s, "  var sp *Speaker = &c\n")
	s = concatStr(s, "  return sp.lo() + sp.hi()\n")
	s = concatStr(s, "}\n")
	return s
}

func TestVMTwoSessionReentrancy() testing.TestResult {
	// Interleave A / B / A / B so contamination from either order surfaces.
	var a1 int = compileAndRun(reentrancyProgA())
	if a1 != 10 {
		return "session A (1st run) should return 10"
	}
	var b1 int = compileAndRun(reentrancyProgB())
	if b1 != 29 {
		return "session B (after A) should return 29 — leaked iface/vtable state?"
	}
	var a2 int = compileAndRun(reentrancyProgA())
	if a2 != 10 {
		return "session A (after B) should STILL return 10 — cross-session contamination"
	}
	var b2 int = compileAndRun(reentrancyProgB())
	if b2 != 29 {
		return "session B (2nd run) should STILL return 29 — cross-session contamination"
	}
	return ""
}
