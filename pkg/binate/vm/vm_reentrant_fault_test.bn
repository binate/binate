package "pkg/binate/vm"

import "pkg/binate/ir"
import "pkg/binate/types"
import "pkg/builtins/testing"

// A recoverable VM fault raised inside a RE-ENTRANT execFunc — a VM function
// re-entered from compiled/native code while an OUTER execLoop is suspended on
// the host stack — must PROPAGATE to the outer frame, not be swallowed.  The
// nested execFunc unwinds to its own entry frame, clears the transient
// FaultRaised, and returns Status == FAULTED plus a garbage result to its native
// caller; compiled code has no way to inspect vm.Status, so the OUTER execLoop
// that dispatched the call must itself notice the terminal FAULTED status and
// continue the unwind rather than proceed on the callee's garbage result.

// reentrantFaultingApply plays a compiled higher-order function: dispatched from
// bytecode as an extern (execExternCall), it re-enters the VM to run the bytecode
// callback `test.boom` (which indexes out of bounds and faults), then — exactly
// as compiled code would — returns the callback's garbage result WITHOUT
// inspecting vm.Status.  Calling execFunc directly is what a cross-mode
// trampoline (TrampolineScalar / _call_shim_*) does on the compiled→VM re-entry.
// g_crossModeVmAddr is the executing VM, published by dispatchExternBinding for
// the duration of every extern call.
func reentrantFaultingApply() int {
	var vm @VM = bit_cast(@VM, g_crossModeVmAddr)
	var bi int = vm.LookupFunc("test.boom")
	if bi < 0 {
		return -1
	}
	var noArgs @[]int
	return cast(int, execFunc(vm, bi, noArgs))
}

// buildFaultingBoom builds `func boom() int` whose body indexes out of bounds
// (index 5 into length 1) and so raises a recoverable bounds fault; a bare
// cleanup pad unwinds it to the entry frame.
func buildFaultingBoom() @ir.Func {
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "boom", noParams, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var idx @ir.Instr = entry.EmitConstInt(5, types.TypInt())
	var ln @ir.Instr = entry.EmitConstInt(1, types.TypInt())
	entry.EmitBoundsCheck(idx, ln)
	var chk @ir.Instr = entry.Instrs[len(entry.Instrs) - 1]
	var zero @ir.Instr = entry.EmitConstInt(0, types.TypInt())
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = zero
	entry.EmitReturn(rets)
	var pad @ir.Block = ir.AddFaultPad(f, "fault_pad")
	pad.EmitUnwindReturn()
	chk.PadBlock = pad
	return f
}

// buildReentrantMain builds `func main() int` that calls the extern `test.apply`
// (reentrantFaultingApply) and then returns the sentinel 42.  The call carries a
// bare call-site cleanup pad — every call op does (see ir gen_call) — so a fault
// propagated from the extern unwinds THIS frame instead of vmPanicking on a
// missing pad; if the fault were (wrongly) swallowed, main falls through to
// return 42.
func buildReentrantMain() @ir.Func {
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("", "main", noParams, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	var call @ir.Instr = entry.EmitCall("test.apply", noArgs, types.TypInt())
	var pad @ir.Block = ir.AddFaultPad(f, "fault_pad")
	pad.EmitUnwindReturn()
	call.PadBlock = pad
	var sentinel @ir.Instr = entry.EmitConstInt(42, types.TypInt())
	var rets @[]@ir.Instr = make_slice(@ir.Instr, 1)
	rets[0] = sentinel
	entry.EmitReturn(rets)
	return f
}

// TestReentrantExecFuncFaultPropagates: the outer execLoop must not run past an
// extern call whose re-entrant VM callback faulted.  Pre-fix, execExternCall
// stored the callback's garbage 0 and the loop fell through to `return 42`
// (swallowed).  Post-fix, the loop sees Status == FAULTED and unwinds main to the
// host with the bounds diagnostic intact.
func TestReentrantExecFuncFaultPropagates() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"test\"")
	m.AddFunc(buildFaultingBoom())
	m.AddFunc(buildReentrantMain())

	var vm @VM = newTestVM(testVMStackSize)
	registerTestExterns(vm)
	var applyFv *func() int = reentrantFaultingApply
	vm.RegisterExtern("test.apply", bit_cast(*uint8, &applyFv), scalarResult,
			bit_cast(int, _func_handle(reentrantFaultingApply)))
	vm.LowerModule(m)

	var noArgs @[]int
	var result int = vm.CallFunc("test.main", noArgs)

	if result == 42 {
		return "the outer execLoop swallowed the re-entrant fault and ran past the extern call"
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a fault in a re-entrant execFunc must leave the VM Status = FAULTED"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: index out of bounds: 5 (len 1)") {
		return "the propagated fault must carry boom's out-of-bounds message"
	}
	return ""
}
