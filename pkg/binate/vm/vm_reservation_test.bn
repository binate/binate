package "pkg/binate/vm"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// TestR3FrameReserveIncludesTempGrowth pins the R3 wiring: the per-call
// reservation is frameExtent + MaxStmtTempGrowth (a frame with no temp growth
// reserves exactly its extent; adding growth adds to the reservation), while the
// frame ADVANCE (frameExtent) is unchanged.
func TestR3FrameReserveIncludesTempGrowth() testing.TestResult {
	var vmf @VMFunc = make(VMFunc)
	vmf.NumRegs = 4
	vmf.FrameSize = 0
	vmf.MaxStmtTempGrowth = 0
	if frameReserve(vmf) != frameExtent(vmf) {
		return "zero temp growth: frameReserve must equal frameExtent"
	}
	vmf.MaxStmtTempGrowth = 128
	if frameReserve(vmf) != frameExtent(vmf) + 128 {
		return "frameReserve must add MaxStmtTempGrowth to frameExtent"
	}
	return ""
}

// TestR3PushFrameReservesTempGrowth is the load-bearing wiring test: it positions
// vm.SP so a callee's frameExtent fits EXACTLY but frameExtent + MaxStmtTempGrowth
// does not, and asserts pushFrame faults.  A control frame with zero temp growth
// at the same position succeeds — so the fault is attributable to
// MaxStmtTempGrowth, i.e. pushFrame reserves frameReserve, not frameExtent
// (reverting either site to frameExtent turns the fault case green → red here).
func TestR3PushFrameReservesTempGrowth() testing.TestResult {
	// Fault case: frameExtent fits (SP + extent == StackSize), reserve does not.
	var grow @VMFunc = make(VMFunc)
	grow.NumRegs = 1
	grow.FrameSize = 0
	grow.MaxStmtTempGrowth = 256
	var vm @VM = newTestVM(4096)
	vm.StackRedZone = 0 // limit == StackSize, so the arithmetic is exact
	var ext int = frameExtent(grow)
	vm.SP = vm.StackSize - ext // SP + ext == StackSize (fits); SP + reserve overflows
	var regsOff int = pushFrame(vm, grow, 0, 0, 0, vm.SP, 0)
	if regsOff != -1 {
		return "pushFrame must fault: frameExtent fits but frameExtent+MaxStmtTempGrowth does not"
	}
	if !vm.FaultRaised {
		return "a reserved-growth overflow must set FaultRaised"
	}
	// Control: same position, zero temp growth (frameReserve == frameExtent) fits.
	var flat @VMFunc = make(VMFunc)
	flat.NumRegs = 1
	flat.FrameSize = 0
	flat.MaxStmtTempGrowth = 0
	var vm2 @VM = newTestVM(4096)
	vm2.StackRedZone = 0
	vm2.SP = vm2.StackSize - frameExtent(flat)
	if pushFrame(vm2, flat, 0, 0, 0, vm2.SP, 0) == -1 {
		return "a zero-temp-growth frame that fits by extent must not fault at the same position"
	}
	return ""
}

// TestR3TempGrowingRecursionCleanFault drives a recursion whose every frame grows
// vm.SP with a managed-slice temp (make_slice, an UNCHECKED growth op) to a stack
// overflow.  With MaxStmtTempGrowth folded into the pushFrame reservation (R3),
// each frame reserves its temp growth up front, so the overflow is caught cleanly
// at frame entry — Status = FAULTED — and the fault unwind RefDecs every live
// managed temp, so repeated overflows leak nothing (rt.LiveBlocks stable).
func TestR3TempGrowingRecursionCleanFault() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func recur(depth int) int {\n"
			"	if depth <= 0 { return 0 }\n"
			"	var s @[]int = make_slice(int, 2)\n"
			"	s[0] = depth\n"
			"	return recur(depth - 1) + s[0]\n"
			"}\n"
			"func start(depth int) int {\n"
			"	return recur(depth)\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = ir.GenModule(c, file)
	var vm @VM = newTestVM(64 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)

	var argv @[]int = make_slice(int, 1)
	argv[0] = 100000000 // deep enough to overflow the 64 KiB stack
	vm.CallFunc("test.start", argv)
	if vm.Status != VM_STATUS_FAULTED {
		return "a temp-growing recursion must overflow cleanly with Status = FAULTED"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: stack overflow") {
		return "expected the stack-overflow fault message"
	}
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc("test.start", argv)
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated overflow must recover identically (VM state intact)"
	}
	if rt.LiveBlocks() != base {
		return "temp-growing overflow recovery leaked a managed-slice temp"
	}
	return ""
}

// TestR5CrossModeSliceOverflowFaults exercises the one runtime-sized cross-mode
// scratch the frame-entry reservation cannot cover: a `...*any` spread whose slice
// length is known only at runtime.  substituteSliceIfaceArgs must raise a
// RECOVERABLE stack-overflow fault (setFault) when the translated backing would
// exceed vm.Stack — NOT a process-fatal vmPanic — so the offending VM terminates
// cleanly without killing the host.  (A vmPanic here would abort this test
// process, so a regression fails loudly rather than as a returned message.)
func TestR5CrossModeSliceOverflowFaults() testing.TestResult {
	var vm @VM = newTestVM(4096)
	// A {data, len} slice header with a huge element count: (n*2+2) words far
	// exceeds the 4 KiB scratch stack, and the check fires before any copy.
	var hdr @[]int = make_slice(int, 2)
	hdr[0] = bit_cast(int, vm.Stack) // any non-null data pointer
	hdr[1] = 1000000 // n: (n*2+2)*REG_SLOT >> 4096
	var args @[]int = make_slice(int, 1)
	args[0] = bit_cast(int, &hdr[0]) // slot 0 = pointer to the header
	substituteSliceIfaceArgs(vm, &args[0], 1)
	if !vm.FaultRaised {
		return "an oversized cross-mode ...*any spread must setFault (recoverable), not vmPanic"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: stack overflow") {
		return "expected the stack-overflow fault message"
	}
	return ""
}

// r5SliceSink is a benign native callee registered as the extern target for the
// abort-before-shim test below.  When the guard works it is never invoked (the
// call is aborted on the arg-substitution fault); if it WERE invoked it returns a
// distinctive 42 so the test can tell the shim ran.
func r5SliceSink(x int) int {
	return 42
}

// TestR5CrossModeSliceOverflowAbortsBeforeShim drives the REAL extern dispatch
// entry (dispatchExternBinding), covering the R5 abort-before-shim guard that the
// direct substituteSliceIfaceArgs test can't: once the oversized-`...*any` fault
// is raised, dispatchExternBinding must return the 0 sentinel BEFORE packing args
// or calling the native shim — not the callee's 42.  (Deleting the
// `if vm.FaultRaised { return 0 }` guard makes this return 42, failing the test.)
func TestR5CrossModeSliceOverflowAbortsBeforeShim() testing.TestResult {
	var vm @VM = newTestVM(4096)
	var sfv *func(int) int = r5SliceSink
	vm.RegisterExtern("test.r5SliceSink", bit_cast(*uint8, &sfv), 0,
			bit_cast(int, _func_handle(r5SliceSink)))
	var bi int = vm.LookupExtern("test.r5SliceSink")
	if bi < 0 {
		return "r5SliceSink not registered"
	}
	// Slot 0 = a slice-of-iface header with a huge element count.
	var hdr @[]int = make_slice(int, 2)
	hdr[0] = bit_cast(int, vm.Stack) // non-null data pointer
	hdr[1] = 1000000 // huge n -> scratch >> 4 KiB
	var args @[]int = make_slice(int, 7)
	args[0] = bit_cast(int, &hdr[0])
	// Drive dispatchExternBinding through its execLoop-caller convention: the packed
	// user args are the register window at &regs[Src1] (regs = &args[0], Src1 = 0), and
	// instr.Src2 carries the slice-of-iface bitmap (slot 0 set).
	var instr BCInstr
	instr.Src2 = 1
	var r int = cast(int, dispatchExternBinding(vm, vm.Externs[bi], &args[0], instr, nil, 1))
	if !vm.FaultRaised {
		return "an oversized cross-mode ...*any spread must raise a recoverable fault"
	}
	if r != 0 {
		return "dispatchExternBinding must abort with the 0 sentinel before the shim "
				"(got the callee's result -- the abort-before-shim guard is missing)"
	}
	return ""
}
