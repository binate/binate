package "pkg/binate/vm"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A directly-returned FRESH managed value produced by a move-only path (an
// interface-widening box, a capturing @func literal) was tracked in neither
// ctx.Vars nor ctx.Temps, relying on "always moved to the caller".  When the move
// never happens because a fault unwinds first — here a deferred nil-func-value
// call faults at the value return — the fault pad could not release it, leaking
// one block per call.  IR-gen now registers these boxes as cleanup temps
// (gen_builtin.bn registerIfaceBox, gen_func_lit.bn), so the fault pad releases
// them and a consumer still moves them out on the normal path.

// runReturnLeak compiles `src`, runs `fn` once (which faults via a deferred nil
// func-value call at its value return), then LOOPS it and returns
// (baseline, final) live-block counts — equal iff the return value is released
// exactly once per faulting call.
func runReturnLeak(src *[]readonly char, fn *[]readonly char) (int, int) {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 { return -1, -1 }
	var m @ir.Module = ir.GenModule(c, file)
	var vm @VM = newTestVM(testVMStackSize)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var noArgs @[]int
	vm.CallFunc(fn, noArgs)
	if vm.Status != VM_STATUS_FAULTED { return -2, -2 }
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc(fn, noArgs)
	}
	return base, rt.LiveBlocks()
}

// A `return cast(@I, t)` widening box RefIncs its source `t`; the box must be a
// cleanup temp so a deferred-call fault at the return releases that ref.
func TestReturnedIfaceBoxNoLeakOnDeferredFault() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface I { m() int }\n"
			"type T struct { x int }\n"
			"func (t @T) m() int { return t.x }\n"
			"impl @T : I\n"
			"func doDefer() @I {\n"
			"	var t @T = make(T)\n"
			"	var fv @func() int\n"
			"	defer fv()\n"
			"	return cast(@I, t)\n"
			"}\n"
	var base int = 0
	var after int = 0
	base, after = runReturnLeak(src, "test.doDefer")
	if base == -1 { return "unexpected checker errors" }
	if base == -2 { return "doDefer should recover with Status = FAULTED" }
	if after != base {
		return "returned cast(@I,t) box leaked its data ref on the deferred-call fault"
	}
	return ""
}

// A directly-returned capturing @func literal OWNS its heap closure struct; the
// fresh func value must be a cleanup temp so a deferred-call fault at the return
// frees the struct.
func TestReturnedClosureNoLeakOnDeferredFault() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func doDefer() @func() int {\n"
			"	var x int = 42\n"
			"	var fv @func() int\n"
			"	defer fv()\n"
			"	return func() int { return x }\n"
			"}\n"
	var base int = 0
	var after int = 0
	base, after = runReturnLeak(src, "test.doDefer")
	if base == -1 { return "unexpected checker errors" }
	if base == -2 { return "doDefer should recover with Status = FAULTED" }
	if after != base {
		return "returned capturing closure literal leaked its closure struct on the deferred-call fault"
	}
	return ""
}

// The IMPLICIT concrete->@Iface lift (`return t` where `@T` widens to the
// declared `@I` result) RefIncs the source exactly like an explicit
// `cast(@I, t)`, so it must be registered as a cleanup temp too (gen_util.bn
// genExprOrFuncRef) — else it leaks on a deferred-call fault at the return.
func TestReturnedImplicitIfaceLiftNoLeakOnDeferredFault() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface I { m() int }\n"
			"type T struct { x int }\n"
			"func (t @T) m() int { return t.x }\n"
			"impl @T : I\n"
			"func doDefer() @I {\n"
			"	var t @T = make(T)\n"
			"	var fv @func() int\n"
			"	defer fv()\n"
			"	return t\n"
			"}\n"
	var base int = 0
	var after int = 0
	base, after = runReturnLeak(src, "test.doDefer")
	if base == -1 { return "unexpected checker errors" }
	if base == -2 { return "doDefer should recover with Status = FAULTED" }
	if after != base {
		return "returned implicit @T->@I lift leaked its data ref on the deferred-call fault"
	}
	return ""
}
