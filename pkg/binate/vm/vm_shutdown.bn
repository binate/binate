package "pkg/binate/vm"

// Optional VM lifecycle teardown: reclaiming the CONTENT of managed globals
// when an embedder drops a bytecode VM.  Kept apart from the core execution /
// frame machinery in vm.bn because it is a distinct, opt-in concern.

// Shutdown runs each lowered package's `<pkg>.__vm_teardown_globals` function,
// which RefDecs the independently-allocated CONTENT of that package's managed
// globals — the `@T` pointee a `var g @T` holds, or the managed values inside a
// struct/array global.  The static-data BLOCKS a global's storage lives in are
// freed by @VM's own destructor (ownedBlocks) when the VM drops; this reclaims
// the CONTENT those globals still reference, which the destructor cannot reach
// (it frees the storage cell, not what the cell points at).
//
// OPTIONAL and opt-in: an embedder that spins VMs up and down calls Shutdown
// before dropping a VM so managed-global content does not accumulate across VM
// lifecycles.  A process that runs one VM to program lifetime need NOT call it —
// the OS reclaims everything at exit — so no caller is forced to.  Idempotent:
// ShutdownDone guards against a second run (which would double-RefDec →
// double-free).
func (vm @VM) Shutdown() {
	if vm.ShutdownDone { return }
	vm.ShutdownDone = true
	var noArgs @[]int
	for i := 0; i < vm.Funcs.Len(); i++ {
		var f @VMFunc = vm.Funcs.Get(i)
		if nameHasTeardownSuffix(f.Name) {
			_ = vm.CallByVMFunc(f, noArgs)
		}
	}
}

// nameHasTeardownSuffix reports whether a lowered VMFunc's qualified name ends
// in `.__vm_teardown_globals` — the reserved base IR-gen emits for a package's
// global-teardown function, always package-qualified (`<pkg>.__vm_teardown_globals`).
// Matching on the dotted boundary (not a bare suffix) keeps it from also matching
// a hypothetical `<ident>__vm_teardown_globals`; the base is `__`-prefixed and
// reserved besides, so no user function can spell it.
func nameHasTeardownSuffix(name *[]readonly char) bool {
	// A RAW readonly slice, not @[]char: binding a string literal to a managed
	// `@[]char` heap-copies it (and this helper runs per func in vm.Funcs), so the
	// managed form would allocate — and leak — a copy on every call.  A raw slice
	// borrows the literal's static bytes with no allocation.
	var suffix *[]readonly char = ".__vm_teardown_globals"
	if len(name) < len(suffix) { return false }
	var off int = len(name) - len(suffix)
	for i := 0; i < len(suffix); i++ {
		if name[off + i] != suffix[i] { return false }
	}
	return true
}
