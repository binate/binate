package "pkg/binate/vm"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// Unit tests for vm_shutdown.bn.  The end-to-end leak behavior (Shutdown
// RefDecs a managed global's content so LiveBlocks returns to baseline) is
// covered by TestVMShutdownRefDecsManagedGlobalContent in leak_test.bn; these
// cover the suffix matcher and the no-managed-global / idempotent paths.

// TestNameHasTeardownSuffixMatches checks the suffix matcher accepts a
// qualified teardown name and rejects non-teardown names.
func TestNameHasTeardownSuffixMatches() testing.TestResult {
	if !nameHasTeardownSuffix("test.__vm_teardown_globals") {
		return "expected match for test.__vm_teardown_globals"
	}
	if !nameHasTeardownSuffix("pkg/deep/path.__vm_teardown_globals") {
		return "expected match for a deeply-qualified teardown name"
	}
	if nameHasTeardownSuffix("test.main") {
		return "test.main must not match"
	}
	if nameHasTeardownSuffix("__vm_teardown_global") {
		return "a shorter/near-miss name must not match"
	}
	if nameHasTeardownSuffix("") {
		return "empty name must not match"
	}
	return ""
}

// TestShutdownNoManagedGlobalsIsNoop verifies Shutdown on a module with no
// managed global (hence no teardown function) neither crashes nor changes the
// live-block count.
func TestShutdownNoManagedGlobalsIsNoop() testing.TestResult {
	var vm @VM = lowerFromSource(
			"package \"test\"\n"
					"var n int = 7\n"
					"func main() int { return n }\n")
	var noArgs @[]int
	_ = vm.CallFunc("test.main", noArgs)
	var before int = rt.LiveBlocks()
	vm.Shutdown()
	var after int = rt.LiveBlocks()
	_ = vm
	if after != before {
		return "Shutdown with no managed globals changed the live-block count"
	}
	return ""
}

// TestShutdownIsIdempotent verifies a second Shutdown is a no-op (the guard
// prevents re-running the teardown, which would double-free managed content).
func TestShutdownIsIdempotent() testing.TestResult {
	var vm @VM = lowerFromSource(
			"package \"test\"\n"
					"type Foo struct { x int }\n"
					"var g @Foo\n"
					"func main() int { g = make(Foo)\n"
					" g.x = 3\n"
					" return g.x }\n")
	var noArgs @[]int
	_ = vm.CallFunc("test.main", noArgs)
	vm.Shutdown()
	var afterFirst int = rt.LiveBlocks()
	vm.Shutdown()
	var afterSecond int = rt.LiveBlocks()
	_ = vm
	if afterSecond != afterFirst {
		return "second Shutdown was not a no-op (double-free / re-run)"
	}
	return ""
}
