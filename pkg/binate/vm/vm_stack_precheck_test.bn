package "pkg/binate/vm"

import "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/irgen"
import "pkg/binate/parser"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// The recoverable-stack-overflow PRE-CHECK (OP_STACK_CHECK) faults a call BEFORE
// it commits its args, so a moved (@Iface) arg is not orphaned when the frame
// would overflow.  `recur` recurses with a FRESH `cast(@I, make(T))` box as a
// moved arg at each level until the VM stack overflows; each overflow must
// recover with Status = FAULTED and leak NOTHING — the in-flight box is released
// by the pre-check's pad, and every pushed frame's @I param by the unwind.  A
// stable rt.LiveBlocks() across repeated overflowing calls is the signal (pre-fix,
// the moved arg orphaned at pushFrame leaked one block per overflow).
func TestStackOverflowPrecheckNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface I { m() int }\n"
			"type T struct { x int }\n"
			"func (t @T) m() int { return t.x }\n"
			"impl @T : I\n"
			"func recur(iv @I, depth int) int {\n"
			"	if depth <= 0 { return iv.m() }\n"
			"	return recur(cast(@I, make(T)), depth - 1)\n"
			"}\n"
			"func start(depth int) int {\n"
			"	return recur(cast(@I, make(T)), depth)\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = irgen.GenModule(c, file)
	var vm @VM = newTestVM(64 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)

	var argv @[]int = make_slice(int, 1)
	argv[0] = 100000000 // deep enough to overflow the 64 KiB stack
	vm.CallFunc("test.start", argv)
	if vm.Status != VM_STATUS_FAULTED {
		return "deep recursion must recover with Status = FAULTED (stack overflow)"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: stack overflow") {
		return "expected the stack-overflow fault message"
	}
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc("test.start", argv)
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated overflow must recover identically (VM state intact)"
	}
	if rt.LiveBlocks() != base {
		return "stack-overflow recovery leaked (the moved @I arg orphaned at the failed frame push)"
	}
	return ""
}

// The arg-building eval/deliver SPLIT: a call evaluates ALL its args (leaving each
// managed one a live cleanup temp) before delivering/consuming ANY of them, so a
// fault while evaluating a LATER arg still leaves an EARLIER managed arg covered by
// the cleanup pad.  `start` calls `sink(mk(), deep(...))`: arg0 `mk()` is a fresh
// @I temp, and evaluating arg1 `deep(...)` overflows the stack.  With the split,
// arg0's box is still in ctx.Temps at the deep() call site, so start's pad releases
// it on the unwind; per-arg eval+deliver (the pre-split shape) would have consumed
// arg0 before deep() ran, orphaning it.  A stable rt.LiveBlocks() across repeated
// overflows is the signal.
func TestStackOverflowMidArgEvalNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface I { m() int }\n"
			"type T struct { x int }\n"
			"func (t @T) m() int { return t.x }\n"
			"impl @T : I\n"
			"func mk() @I { return cast(@I, make(T)) }\n"
			"func deep(iv @I, n int) int {\n"
			"	if n <= 0 { return iv.m() }\n"
			"	return deep(cast(@I, make(T)), n - 1)\n"
			"}\n"
			"func sink(a @I, b int) int { return a.m() + b }\n"
			"func start(depth int) int {\n"
			"	return sink(mk(), deep(cast(@I, make(T)), depth))\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = irgen.GenModule(c, file)
	var vm @VM = newTestVM(64 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)

	var argv @[]int = make_slice(int, 1)
	argv[0] = 100000000 // deep enough to overflow the 64 KiB stack
	vm.CallFunc("test.start", argv)
	if vm.Status != VM_STATUS_FAULTED {
		return "deep recursion must recover with Status = FAULTED (stack overflow)"
	}
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc("test.start", argv)
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated overflow must recover identically (VM state intact)"
	}
	if rt.LiveBlocks() != base {
		return "mid-arg-eval overflow leaked (arg0 orphaned when a later arg's eval faulted)"
	}
	return ""
}

// countBCCallsToName counts BC_CALL ops targeting `name` (BC_CALL.Aux indexes the
// caller func's Names) across every lowered function — a positive inlining control.
func countBCCallsToName(vm @VM, name *[]readonly char) int {
	var n int = 0
	for fi := 0; fi < vm.Funcs.Len(); fi++ {
		var fn @VMFunc = vm.Funcs.Get(fi)
		var code @[]BCInstr = fn.Code
		for i := 0; i < len(code); i++ {
			if code[i].Op == BC_CALL {
				var idx int = code[i].Aux
				if idx >= 0 && idx < len(fn.Names) && faultStrEq(fn.Names[idx], name) {
					n = n + 1
				}
			}
		}
	}
	return n
}

// TestInlineMultiBlockPadStackCheckNoLeak exercises multi-block cleanup-pad cloning
// end-to-end.  `wrap` is a small box-and-forward wrapper whose forward to the
// recursive `deep` carries an OP_STACK_CHECK — its PRE-delivery pad covers the moved
// @I, a BRANCHING (multi-block) iface-refdec pad.  At -O1 `wrap` inlines (its body is
// small; the pre-check is size-excluded), while `deep` stays a call (recursive), so
// the cloned OP_STACK_CHECK and its whole MULTI-BLOCK pad land in `start`.  Driving
// `start` to a stack overflow fires that cloned pad, which must release the in-flight
// moved @I each time; a dropped or mis-cloned multi-block pad leaks one block per
// overflow.  Before the multi-block-pad-clone support, `wrap` was (correctly) refused
// inlining because its check pad branches, so the positive control also guards the
// fix itself.
func TestInlineMultiBlockPadStackCheckNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface I { m() int }\n"
			"type T struct { x int }\n"
			"func (t @T) m() int { return t.x }\n"
			"impl @T : I\n"
			"func deep(iv @I, n int) int {\n"
			"	if n <= 0 { return iv.m() }\n"
			"	return deep(cast(@I, make(T)), n - 1)\n"
			"}\n"
			"func wrap(n int) int { return deep(cast(@I, make(T)), n) }\n"
			"func start(n int) int { return wrap(n) }\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = irgen.GenModule(c, file)
	var vm @VM = newTestVM(64 * 1024)
	registerTestExterns(vm)
	vm.OptLevel = 1
	vm.LowerModule(m)
	// Positive control: `wrap` must be inlined at -O1 (else this test is vacuous —
	// and, pre-fix, its multi-block check pad blocked inlining).
	if countBCCallsToName(vm, "test.wrap") != 0 {
		return "wrap should inline at -O1 (its multi-block check pad must be clonable)"
	}

	var argv @[]int = make_slice(int, 1)
	argv[0] = 100000000 // deep enough to overflow the 64 KiB stack
	vm.CallFunc("test.start", argv)
	if vm.Status != VM_STATUS_FAULTED {
		return "deep recursion via inlined wrap must overflow-fault"
	}
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc("test.start", argv)
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated overflow must recover identically (VM state intact)"
	}
	if rt.LiveBlocks() != base {
		return "inlined multi-block check-pad clone LEAKS the moved @I on overflow"
	}
	return ""
}

// TestSPGrowthArrayOverflowRecovers exercises the reservation catching a giant
// TEMP-GROWTH op end-to-end, on real IR: `f` materializes a [40000]char buffer (an
// OP_RODATA_ARRAY whose ~40 KiB on-stack copy dominates f's MaxStmtTempGrowth).
// f's frame alone (~40 KiB, mostly the buf alloca) fits the 64 KiB stack, but
// frameExtent + MaxStmtTempGrowth (~80 KiB) does not — so f's pushFrame reserves
// the temp growth up front and faults cleanly AT FRAME ENTRY, instead of the old
// per-op check or a write past vm.Stack.  Repeated overflows recover identically
// (Status = FAULTED, VM state intact).  (Releasing a LIVE managed value on a
// recoverable overflow is covered separately by TestR3TempGrowingRecursionClean-
// Fault; here the fault precedes the body, so nothing is allocated to leak.)
func TestSPGrowthArrayOverflowRecovers() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f() int {\n"
			"	var buf [40000]char = \"x\"\n"
			"	return cast(int, buf[0])\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = irgen.GenModule(c, file)
	var vm @VM = newTestVM(64 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var noArgs @[]int
	vm.CallFunc("test.f", noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "f must overflow-fault at frame entry (frameExtent fits, +MaxStmtTempGrowth doesn't)"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: stack overflow") {
		return "expected the stack-overflow fault message"
	}
	for i := 0; i < 20; i++ {
		vm.CallFunc("test.f", noArgs)
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated temp-growth overflow must recover identically (VM state intact)"
	}
	return ""
}

// TestStructLitPartialInitFaultNoLeak: a struct literal moves each managed field in
// as it goes (emitStoreManagedSlot isInit → consumeTemp), and registers the alloca
// for cleanup BEFORE the field loop, so a recoverable fault while evaluating a LATER
// field releases the fields moved so far.  `f` builds `S{m: make_slice(...), n:
// arr[i]}` with i out of bounds — the bounds-check faults DURING field n's eval,
// after `m` is already moved into the partial struct; the fault pad must release `m`
// (stable LiveBlocks).  Pre-fix (alloca registered only after the loop) this leaked
// `m` per occurrence.
func TestStructLitPartialInitFaultNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type S struct { m @[]int\n n int }\n"
			"func f(i int) int {\n"
			"	var arr [3]int\n"
			"	var s S = S{m: make_slice(int, 4), n: arr[i]}\n"
			"	return len(s.m) + s.n\n"
			"}\n"
	return compositeLitFaultDelta(src, "test.f", 99)
}

// TestManagedSliceLitPartialInitFaultNoLeak: same for a MANAGED-SLICE literal (a
// different cleanup path — the backing's element dtor, not a struct-alloca dtor).
// Element 0 is a fresh @[]int moved into the backing; element 1's eval
// (make_slice(int, arr[i]), i OOB) faults, so element 0 must be released via the
// slice registered before the element loop.
func TestManagedSliceLitPartialInitFaultNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"func f(i int) int {\n"
			"	var arr [3]int\n"
			"	var s @[]@[]int = @[]@[]int{make_slice(int, 4), make_slice(int, arr[i])}\n"
			"	return len(s)\n"
			"}\n"
	return compositeLitFaultDelta(src, "test.f", 99)
}

// compositeLitFaultDelta compiles `src`, calls `fn(arg)` (which must fault via an
// OOB index during a composite literal's later element), then loops 20 calls
// measuring rt.LiveBlocks() — 0 delta = the partial aggregate's already-moved
// managed members were released on the recovered fault.
func compositeLitFaultDelta(src *[]readonly char, fn *[]readonly char, arg int) testing.TestResult {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = irgen.GenModule(c, file)
	var vm @VM = newTestVM(64 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var argv @[]int = make_slice(int, 1)
	argv[0] = arg
	vm.CallFunc(fn, argv)
	if vm.Status != VM_STATUS_FAULTED {
		return "the OOB index in a later composite-literal member must fault"
	}
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc(fn, argv)
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated fault must recover identically (VM state intact)"
	}
	if rt.LiveBlocks() != base {
		return "partial composite-literal init LEAKS an already-moved managed member on fault"
	}
	return ""
}

// TestShortCircuitAggregateLitNoLeak: a managed-field aggregate literal inside a
// `&&` operand is cleaned by the SHORT-CIRCUIT operand cleanup
// (emitTempCleanupSince), which must run the struct dtor on the literal's alloca
// temp — else its managed fields leak.  `f(true)` evaluates the RHS
// `(S{m: make_slice(...), n: 1}.n > 0)`, creating and cleaning the literal; stable
// rt.LiveBlocks across 20 calls is the signal.  Pre-fix, emitTempCleanupSince lacked
// the isStructOrArrayAlloc dtor arm, so `m` leaked per call.
func TestShortCircuitAggregateLitNoLeak() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"type S struct { m @[]int\n n int }\n"
			"func f(flag bool) int {\n"
			"	var r int = 0\n"
			"	if flag && (S{m: make_slice(int, 4), n: 1}.n > 0) {\n"
			"		r = 1\n"
			"	}\n"
			"	return r\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = irgen.GenModule(c, file)
	var vm @VM = newTestVM(64 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var argv @[]int = make_slice(int, 1)
	argv[0] = 1 // flag = true → the && RHS (with the aggregate literal) is evaluated
	vm.CallFunc("test.f", argv)
	if vm.Status == VM_STATUS_FAULTED {
		return "f(true) must not fault"
	}
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc("test.f", argv)
	}
	if rt.LiveBlocks() != base {
		return "managed-field aggregate literal in a && operand LEAKS "
				"(emitTempCleanupSince dropped its struct dtor)"
	}
	return ""
}

// countBCOp counts occurrences of bytecode op `op` across every lowered function.
func countBCOp(vm @VM, op int) int {
	var n int = 0
	for fi := 0; fi < vm.Funcs.Len(); fi++ {
		var fn @VMFunc = vm.Funcs.Get(fi)
		var code @[]BCInstr = fn.Code
		for i := 0; i < len(code); i++ {
			if code[i].Op == op {
				n = n + 1
			}
		}
	}
	return n
}

// TestIfaceUpcastReclaimsVMStack pins the fix for OP_IFACE_UPCAST being absent
// from noteSPGrowingResult's SP-growing-op set.  BC_IFACE_UPCAST grows vm.SP by 2
// words to build the upcast iface value on the interpreter stack; the statement
// that produces it must therefore lower to an OP_SP_RESTORE so those words are
// reclaimed at statement end — otherwise a hot upcast loop grows vm.SP unbounded
// (write past vm.Stack).  In this module `withUpcast` is the ONLY function whose
// body grows vm.SP (the `@WideBox -> @Box` upcast); `noUpcast` / `get` / `extra`
// grow nothing (all return plain ints, and the iface values arrive as params, so
// no OP_IFACE_VALUE construction).  So exactly one BC_SP_RESTORE must appear.
// Pre-fix the count is 0 (the upcast statement emitted no reclaim).
func TestIfaceUpcastReclaimsVMStack() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Box { get() int }\n"
			"interface WideBox : Box { extra() int }\n"
			"type Impl struct { v int }\n"
			"impl @Impl : WideBox\n"
			"func (i @Impl) get() int { return i.v }\n"
			"func (i @Impl) extra() int { return 100 }\n"
			"func withUpcast(w @WideBox) int {\n"
			"	var b @Box = w\n"
			"	return b.get()\n"
			"}\n"
			"func noUpcast(w @WideBox) int {\n"
			"	return w.get()\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = irgen.GenModule(c, file)
	var vm @VM = newTestVM(64 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var restores int = countBCOp(vm, BC_SP_RESTORE)
	if restores != 1 {
		return "iface-value upcast must lower to exactly one BC_SP_RESTORE (reclaim "
				"the 2 words BC_IFACE_UPCAST grows vm.SP by); OP_IFACE_UPCAST missing "
				"from noteSPGrowingResult's SP-growing set drops it to 0"
	}
	return ""
}

// TestIfaceUpcastLoopBounded runs a many-iteration pure-upcast loop in a small VM
// stack.  With the reclaim in place peak vm.SP is frameExtent + one live upcast (2
// words), so the loop completes with the correct sum even in 64 KiB.  Without the
// reclaim vm.SP grows 2 words/iteration (~320 KiB here), overrunning vm.Stack —
// the end-to-end symptom of the missing OP_SP_RESTORE.
func TestIfaceUpcastLoopBounded() testing.TestResult {
	var src *[]readonly char = "package \"test\"\n"
			"interface Box { get() int }\n"
			"interface WideBox : Box { extra() int }\n"
			"type Impl struct { v int }\n"
			"impl @Impl : WideBox\n"
			"func (i @Impl) get() int { return i.v }\n"
			"func (i @Impl) extra() int { return 100 }\n"
			"func upcastLoop(n int) int {\n"
			"	var im @Impl = make(Impl)\n"
			"	im.v = 7\n"
			"	var w @WideBox = im\n"
			"	var acc int = 0\n"
			"	for i := 0; i < n; i = i + 1 {\n"
			"		var b @Box = w\n"
			"		acc = acc + b.get()\n"
			"	}\n"
			"	return acc\n"
			"}\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = irgen.GenModule(c, file)
	var vm @VM = newTestVM(64 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var argv @[]int = make_slice(int, 1)
	argv[0] = 20000 // 20000 * 2 words = ~320 KiB unbounded — far over the 64 KiB stack
	var got int = vm.CallFunc("test.upcastLoop", argv)
	if vm.Status == VM_STATUS_FAULTED {
		return "upcastLoop must not overflow the VM stack (upcast growth must be "
				"reclaimed each iteration)"
	}
	if got != 7 * 20000 {
		return "upcastLoop returned the wrong sum (vm.SP growth likely overran "
				"vm.Stack without the per-statement reclaim)"
	}
	return ""
}
