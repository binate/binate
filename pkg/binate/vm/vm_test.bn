}

func TestPhiResolution() testing.TestResult {
	// Tests phi node resolution: variable assigned in both branches of if/else
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func pick(x int) int {\n")
	src = concatStr(src, "  var r int\n")
	src = concatStr(src, "  if x > 0 {\n")
	src = concatStr(src, "    r = x * 2\n")
	src = concatStr(src, "  } else {\n")
	src = concatStr(src, "    r = x * 3\n")
	src = concatStr(src, "  }\n")
	src = concatStr(src, "  return r\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() int { return pick(5) + pick(-4) }\n")
	var result int = compileAndRun(src)
	// pick(5) = 10, pick(-4) = -12 → -2
	if result != -2 { return "expected -2" }
	return ""
}

func TestArrayAccess() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var a [3]int\n")
	src = concatStr(src, "  a[0] = 100\n")
	src = concatStr(src, "  a[1] = 200\n")
	src = concatStr(src, "  a[2] = 300\n")
	src = concatStr(src, "  return a[0] + a[1] + a[2]\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 600 { return "expected 600" }
	return ""
}

func concatStr(a @[]char, b *[]readonly char) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	if len(a) > 0 { cb.Write(a) }
	cb.Write(b)
	// concatStr is a shared test helper whose @[]char result is held in
	// `var src @[]char` locals across many vm test files; hand off an owned
	// copy rather than cascade readonly through the whole suite.
	return buf.CopyStr(cb.String())
}
