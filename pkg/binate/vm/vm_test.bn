// Higher-level integration tests for the VM (control flow, function
// calls, recursion, managed types, slices, arrays). Pure opcode tests
// (arithmetic, comparison, float, bitwise, shift, unary) live in
// vm_exec_test.bn and reuse the helpers below.

func toBytes(s *[]readonly char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

func compileAndRun(src *[]readonly char) int {
	var srcBytes @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(srcBytes, "test.bn")
	var file @ast.File = p.ParseFile()

	var c @types.Checker = types.NewChecker()
	c.Check(file)

	var m @ir.Module = ir.GenModule(c, file)

	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)

	var idx int = vm.LookupFunc("test.main")
	if idx < 0 { return -1 }
	var noArgs @[]int
	return cast(int, execFunc(vm, idx, noArgs))
}

func TestSimpleReturn() testing.TestResult {
	var result int = compileAndRun("package \"test\"\nfunc main() int { return 42 }\n")
	if result != 42 { return "expected 42" }
	return ""
}

func TestVariable() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x int = 10\n")
	src = concatStr(src, "  var y int = 20\n")
	src = concatStr(src, "  return x + y\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 30 { return "expected 30" }
	return ""
}

