	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() int { return abs(-5) + abs(3) }\n")
	var result int = compileAndRun(src)
	if result != 8 { return "expected 8" }
	return ""
}

func TestRecursion() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func fib(n int) int {\n")
	src = concatStr(src, "  if n <= 1 { return n }\n")
	src = concatStr(src, "  return fib(n-1) + fib(n-2)\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() int { return fib(10) }\n")
	var result int = compileAndRun(src)
	if result != 55 { return "expected 55" }
	return ""
}

