// TestLowerOneFuncAndCall exercises the REPL pipeline: load a tiny
// module, then build / IR-gen / lower / call a synthetic stmt list
// against that module's VM state.  Verifies the function-table
// grows by exactly one and CallByVMFunc executes the new VMFunc
// without crashing.
func TestLowerOneFuncAndCall() testing.TestResult {
	// Step 1: load a tiny module the normal way.
	var src *[]readonly char = "package \"test\"\nfunc main() int { return 0 }\n"
	var srcBytes @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(srcBytes, "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	var m @ir.Module = ir.GenModule(c, file)
	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var initialCount int = vm.Funcs.Len()

	// Step 2: parse a bare stmt list at the "prompt".
	var stmtSrc *[]readonly char = "var x int = 5; x = x + 1"
	var p2 @parser.Parser = parser.New(toBytes(stmtSrc), "repl")
	var ss @[]@ast.Stmt = p2.ParseStmtList()

	// Step 3: type-check the stmt list against the loaded scope.
	c.CheckStmtListInScope(ss)
	if len(c.CheckerErrors()) != 0 {
		return "expected no checker errors on REPL stmt list"
	}

	// Step 4: IR-gen the stmt list as a synthetic function and add
	// it to the module.
	var f @ir.Func = ir.GenSyntheticFunc(ir.NewGenCtx(m), "__repl_0", ss)
	m.AddFunc(f)

	// Step 5: lower the synthetic func into the existing VM.
	var vmf @VMFunc = vm.LowerOneFunc(m, f)
	if vmf == nil { return "LowerOneFunc returned nil" }
	if vm.Funcs.Len() != initialCount + 1 {
		return "vm.Funcs did not grow by one"
	}

	// Step 6: call it.  Return value for a void synthetic is
	// unspecified (treated as 0); we only verify it doesn't crash.
	var noArgs @[]int
	vm.CallByVMFunc(vmf, noArgs)
	return ""
}

// TestEntryFrameBoundsFaultRecovers is the end-to-end proof of Plan 2 Inc 2b: a
// bounds fault in the ENTRY frame (a synthetic prompt func, run via CallByVMFunc)
// unwinds through the op's cleanup pad instead of killing the host.  The prompt
// makes a managed slice — a live managed local at the fault point — then indexes
// it out of bounds, so the pad must RefDec the slice on the way out (no leak).
// CallByVMFunc RETURNING at all is the host-survival check (pre-2b this rt.Exit'd
// the process, which would take the test runner down); Status + FaultMsg confirm
// the fault was recorded for the host to read.
func TestEntryFrameBoundsFaultRecovers() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc main() int { return 0 }\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	var m @ir.Module = ir.GenModule(c, file)
	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)

	// The prompt: allocate a managed slice (live at the fault), then index out of
	// bounds.  s[5] on a len-3 slice faults; the cleanup pad RefDecs `s`.
	var stmtSrc *[]readonly char = "var s @[]int = make_slice(int, 3); var y int = s[5]"
	var p2 @parser.Parser = parser.New(toBytes(stmtSrc), "repl")
	var ss @[]@ast.Stmt = p2.ParseStmtList()
	c.CheckStmtListInScope(ss)
	if len(c.CheckerErrors()) != 0 {
		return "expected no checker errors on the prompt stmt list"
	}
	var f @ir.Func = ir.GenSyntheticFunc(ir.NewGenCtx(m), "__repl_0", ss)
	m.AddFunc(f)
	var vmf @VMFunc = vm.LowerOneFunc(m, f)
	if vmf == nil { return "LowerOneFunc returned nil" }

	// Must RETURN (host survives) rather than abort the process.
	var noArgs @[]int
	vm.CallByVMFunc(vmf, noArgs)
	if vm.Status != VM_STATUS_FAULTED {
		return "an entry-frame bounds fault must leave Status = VM_STATUS_FAULTED"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: index out of bounds: 5 (len 3)") {
		return "the recovered fault must carry the bounds message"
	}
	// A second prompt turn runs cleanly on the same VM — the fault did not corrupt
	// VM state, and CallByVMFunc reset the fault status at entry.
	var stmt2 *[]readonly char = "var z int = 7"
	var p3 @parser.Parser = parser.New(toBytes(stmt2), "repl")
	var ss2 @[]@ast.Stmt = p3.ParseStmtList()
	c.CheckStmtListInScope(ss2)
	var f2 @ir.Func = ir.GenSyntheticFunc(ir.NewGenCtx(m), "__repl_1", ss2)
	m.AddFunc(f2)
	var vmf2 @VMFunc = vm.LowerOneFunc(m, f2)
	vm.CallByVMFunc(vmf2, noArgs)
	if vm.Status == VM_STATUS_FAULTED {
		return "a clean turn after a fault must reset Status (not stay FAULTED)"
	}
	return ""
}

// TestLowerOneFuncReplacesExisting verifies that lowering a func with
// a name that's already in vm.Funcs replaces the existing entry
// in place (Tier 4 redefinition contract: same idx, no append).
func TestLowerOneFuncReplacesExisting() testing.TestResult {
	// Step 1: load a tiny module with a `helper` function.
	var src *[]readonly char = "package \"test\"\nfunc helper() int { return 1 }\n"
			"func main() int { return 0 }\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	var m @ir.Module = ir.GenModule(c, file)
	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var initialCount int = vm.Funcs.Len()
	var helperIdx int = vm.LookupFunc("test.helper")
	if helperIdx < 0 { return "test.helper not in vm.Funcs after load" }

	// Step 2: parse + check + IR-gen a redefinition of helper.
	var declSrc *[]readonly char = "func helper() int { return 99 }"
	var p2 @parser.Parser = parser.New(toBytes(declSrc), "<repl>")
	var d @ast.Decl = p2.ParseTopLevelDecl()
	if d == nil { return "ParseTopLevelDecl returned nil" }
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) != 0 {
		return "expected no checker errors on same-sig redef"
	}
	var msg @[]char = ir.GenDecl(d, ir.NewGenCtx(m))
	if len(msg) > 0 { return "ir.GenDecl returned an error" }

	// Step 3: lower — must REPLACE in place, not append.
	var newFunc @ir.Func = m.Funcs[len(m.Funcs) - 1]
	var vmf @VMFunc = vm.LowerOneFunc(m, newFunc)
	if vmf == nil { return "LowerOneFunc returned nil" }
	if vm.Funcs.Len() != initialCount {
		return "vm.Funcs grew on redefinition; expected in-place replace"
	}
	if vm.Funcs.Get(helperIdx) != vmf {
		return "vm.Funcs.Get(helperIdx) not pointing at the new VMFunc"
	}
	return ""
}

// TestLowerOneFuncRedefRefreshesIndexKey drives REPEATED same-signature
// redefinitions of `helper` through LowerOneFunc, which REPLACES vm.Funcs[idx] in
// place — dropping the prior VMFunc and freeing its Name backing.  FuncIndex keys
// its slot by a *[]readonly char borrow of that Name, so each replace must re-Put
// to re-point the key at the live replacement's Name; otherwise the key dangles
// and the NEXT redefinition's internal funcIndexLookup reads freed memory.  Once
// the freed backing is reclaimed by the churn of parsing/checking/IR-gen the next
// redefinition, that stale read makes the lookup MISS, so LowerOneFunc wrongly
// APPENDS a duplicate instead of replacing — which this test catches as vm.Funcs
// growing (and the name failing to resolve to its stable index).
func TestLowerOneFuncRedefRefreshesIndexKey() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc helper() int { return 1 }\n"
			"func main() int { return 0 }\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	var m @ir.Module = ir.GenModule(c, file)
	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var initialCount int = vm.Funcs.Len()
	var helperIdx int = vm.LookupFunc("test.helper")
	if helperIdx < 0 { return "test.helper not in vm.Funcs after load" }

	for i := 0; i < 8; i++ {
		var declSrc *[]readonly char = "func helper() int { return 99 }"
		var p2 @parser.Parser = parser.New(toBytes(declSrc), "<repl>")
		var d @ast.Decl = p2.ParseTopLevelDecl()
		if d == nil { return "ParseTopLevelDecl returned nil" }
		c.CheckDeclInScope(d)
		if len(c.CheckerErrors()) != 0 {
			return "expected no checker errors on same-sig redef"
		}
		var msg @[]char = ir.GenDecl(d, ir.NewGenCtx(m))
		if len(msg) > 0 { return "ir.GenDecl returned an error" }
		var newFunc @ir.Func = m.Funcs[len(m.Funcs) - 1]
		var vmf @VMFunc = vm.LowerOneFunc(m, newFunc)
		if vmf == nil { return "LowerOneFunc returned nil" }
		// In-place replace: vm.Funcs must NOT grow, and the name must still resolve
		// to its stable slot.  A dangling FuncIndex key breaks both.
		if vm.Funcs.Len() != initialCount {
			return "vm.Funcs grew on same-sig redefinition (funcIndex key dangled -> duplicate)"
		}
		if vm.LookupFunc("test.helper") != helperIdx {
			return "test.helper stopped resolving to its stable index after redef"
		}
	}
	return ""
}

// TestLowerOneFuncShadowAppends verifies that LowerOneFuncShadow
// always APPENDS a new vm.Funcs entry even when the qualified name
// already exists, and re-points the per-VM funcIndex at the new
// (later) index.  Old vm.Funcs.Get(helperIdx) stays intact so any
// caller whose CallCache holds that index continues to call the
// old VMFunc — the substrate of the Tier 4 shadow semantic.
func TestLowerOneFuncShadowAppends() testing.TestResult {
	var src *[]readonly char = "package \"test\"\nfunc helper() int { return 1 }\n"
			"func main() int { return 0 }\n"
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	var m @ir.Module = ir.GenModule(c, file)
	var vm @VM = NewVM(1024 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)
	var initialCount int = vm.Funcs.Len()
	var oldHelperIdx int = vm.LookupFunc("test.helper")
	if oldHelperIdx < 0 { return "test.helper not in vm.Funcs after load" }
	var oldHelperVMF @VMFunc = vm.Funcs.Get(oldHelperIdx)

	// Parse + check + IR-gen a same-name redef.  AllowRedef bypass
	// kicks in via CheckDeclInScope so the .bni-sig check stays
	// silent — but the new sig isn't relevant to this test, only
	// the lowering behavior is.
	var declSrc *[]readonly char = "func helper() int { return 99 }"
	var p2 @parser.Parser = parser.New(toBytes(declSrc), "<repl>")
	var d @ast.Decl = p2.ParseTopLevelDecl()
	if d == nil { return "ParseTopLevelDecl returned nil" }
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) != 0 {
		return "expected no checker errors"
	}
	var msg @[]char = ir.GenDecl(d, ir.NewGenCtx(m))
	if len(msg) > 0 { return "ir.GenDecl returned an error" }

	// Use Shadow path: must APPEND, not replace.
	var newFunc @ir.Func = m.Funcs[len(m.Funcs) - 1]
	var vmf @VMFunc = vm.LowerOneFuncShadow(m, newFunc)
	if vmf == nil { return "LowerOneFuncShadow returned nil" }
	if vm.Funcs.Len() != initialCount + 1 {
		return "vm.Funcs must grow by exactly one on shadow"
	}
	// Old slot untouched — a previously-resolved caller still finds
	// the old VMFunc at its captured idx.
	if vm.Funcs.Get(oldHelperIdx) != oldHelperVMF {
		return "old vm.Funcs.Get(helperIdx) must be unchanged after shadow"
	}
	// funcIndex re-points at the new (later) entry.
	if vm.LookupFunc("test.helper") != initialCount {
		return "funcIndex should point at the new (appended) idx"
	}
	return ""
}

// TestBCFuncAddrCacheHit calls _raw_func_addr on the same function
// twice from the same VMFunc. The two BC_FUNC_ADDR sites share the
// same Names entry (and thus the same CallCache slot), so the second
// call exercises the cache-hit path. Verifies both calls return the
// same 1-based VM function index, which is non-zero.
func TestBCFuncAddrCacheHit() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func helper() int { return 7 }\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var a int = bit_cast(int, _raw_func_addr(helper))\n")
	src = concatStr(src, "  var b int = bit_cast(int, _raw_func_addr(helper))\n")
	src = concatStr(src, "  if a != b { return -1 }\n")
	src = concatStr(src, "  if a == 0 { return -2 }\n")
	src = concatStr(src, "  return 42\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 42 { return "expected 42" }
	return ""
}

