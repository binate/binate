package "pkg/binate/vm"

import "pkg/binate/check"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/irgen"
import "pkg/binate/parser"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// An interface-dispatch receiver thunk (a value-receiver method reached through an
// interface) forwards its owned values to the method BY MOVE: the receiver it
// acquires (`type X @J` — an @Iface receiver the caller delivers) or field-RefIncs
// (a value struct with a managed field), and the caller-delivered @Iface /
// managed-field struct params.  Its forward gets a recoverable-stack-overflow
// pre-check (OP_STACK_CHECK) whose pad releases them; without it a frame push that
// overflows at the forward — the method never starts to release them — orphans
// them.  Each method's large frame (a local array) makes the method push, not the
// thunk's, the one that overflows; repeated overflows must leak no block.

func thunkOverflowSrc() *[]readonly char {
	return "package \"test\"\n"
			"interface J { Get() int }\n"
			"type C struct { n int }\n"
			"func (c @C) Get() int { return c.n }\n"
			"impl @C : J\n"
			"type X @J\n"
			"interface R { rec(d int, j @J) int }\n"
			"func (x X) rec(d int, j @J) int {\n"
			"	var big [256]int\n"
			"	big[d % 256] = d\n"
			"	if d <= 0 { return big[0] }\n"
			"	var r *R = &x\n"
			"	return r.rec(d - 1, j)\n"
			"}\n"
			"impl X : R\n"
			"func start(d int) int {\n"
			"	var x X = cast(X, cast(@J, make(C)))\n"
			"	var r *R = &x\n"
			"	return r.rec(d, cast(@J, make(C)))\n"
			"}\n"
			"type S struct { p @C; n int }\n"
			"interface R2 { rec2(d int, w S) int }\n"
			"func (s S) rec2(d int, w S) int {\n"
			"	var big [256]int\n"
			"	big[d % 256] = d\n"
			"	if d <= 0 { return big[0] }\n"
			"	var r *R2 = &s\n"
			"	return r.rec2(d - 1, w)\n"
			"}\n"
			"impl S : R2\n"
			"func start2(d int) int {\n"
			"	var s S\n"
			"	s.p = make(C)\n"
			"	var w S\n"
			"	w.p = make(C)\n"
			"	var r *R2 = &s\n"
			"	return r.rec2(d, w)\n"
			"}\n"
}

// thunkOverflowLeaks calls fn (which must overflow the VM stack at a thunk's
// forward) once to warm up, then 20 more times, and reports the net
// rt.LiveBlocks() growth of those 20 calls in *out.  Returns "" on success, else a
// failure.
func thunkOverflowLeaks(fn *[]readonly char, out *int) testing.TestResult {
	var p @parser.Parser = parser.New(toBytes(thunkOverflowSrc()), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @check.Checker = check.NewChecker()
	c.Check(file)
	if len(c.CheckerErrors()) != 0 {
		return "unexpected checker errors on the source"
	}
	var m @ir.Module = irgen.GenModule(c, file)
	var vm @VM = newTestVM(64 * 1024)
	registerTestExterns(vm)
	vm.LowerModule(m)

	var argv @[]int = make_slice(int, 1)
	argv[0] = 100000000 // deep enough to overflow the 64 KiB stack
	vm.CallFunc(fn, argv)
	if vm.Status != VM_STATUS_FAULTED {
		return "deep dispatch recursion must recover with Status = FAULTED (stack overflow)"
	}
	if !faultStrEq(vm.FaultMsg, "runtime error: stack overflow") {
		return "expected the stack-overflow fault message"
	}
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		vm.CallFunc(fn, argv)
	}
	if vm.Status != VM_STATUS_FAULTED {
		return "a repeated overflow must recover identically (VM state intact)"
	}
	*out = rt.LiveBlocks() - base
	return ""
}

// TestThunkForwardOverflowIfaceReceiverNoLeak: the pad releases the acquired @Iface
// receiver and the moved @J param.
func TestThunkForwardOverflowIfaceReceiverNoLeak() testing.TestResult {
	var leaked int
	var r testing.TestResult = thunkOverflowLeaks("test.start", &leaked)
	if len(r) != 0 { return r }
	if leaked != 0 {
		return "a thunk-forward overflow leaked the acquired receiver / moved @J param"
	}
	return ""
}

// TestThunkForwardOverflowStructReceiverNoLeak: the pad releases the struct
// receiver's field references (RefInc'd in place on the box's object) and the moved
// managed-field struct param.
func TestThunkForwardOverflowStructReceiverNoLeak() testing.TestResult {
	var leaked int
	var r testing.TestResult = thunkOverflowLeaks("test.start2", &leaked)
	if len(r) != 0 { return r }
	if leaked != 0 {
		return "a thunk-forward overflow leaked the struct receiver's fields / moved struct param"
	}
	return ""
}
