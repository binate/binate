package "pkg/binate/vm"

import "pkg/builtins/rt"

// Cross-mode VM-side function-value dispatch: the per-return-shape trampolines a
// VM function value's vtable.call slot points at (ensureHandle selects one by the
// callee's return shape).  A COMPILED caller — or the VM's own execCallFuncValue
// dispatching through the thunk — reaches a VM function value here; the trampoline
// reads its closure record, marshals captures + user args (closureArgv), and
// re-enters execFunc.  Extracted from vm.bn for file length.
// closureRecIsVm reports whether a function-value data record's kind word is a
// VM record — a non-capturing VM_CLOSURE_REC or a capturing COMPILED_CLOSURE.  A
// trampoline is only ever a VM function value's vtable.call (a native closure has
// its own per-closure shim, never a trampoline), so a trampoline's `data` is
// always one of these two; anything else is a corrupt record.
func closureRecIsVm(kind int) bool {
	return kind == rt.DATA_KIND_VM_CLOSURE_REC || kind == rt.DATA_KIND_COMPILED_CLOSURE
}

// writeCaptures marshals a VM function value's CAPTURES into the leading argv
// slots and returns the number of slots written.  For a COMPILED_CLOSURE the
// captures live at rec[3] (the captured-struct address) and are read via the
// callee's CaptureOffsets; a non-capturing record (NumCaptureParams 0) writes
// none.  A CaptureByPtr capture passes the field ADDRESS (VM multi-word
// convention); a CaptureWide 64-bit scalar on an ILP32 host rides two slots
// (lo, hi).  argv must have room for NumCaptureParams*2 leading slots.  Shared by
// closureArgv (fixed a0..a6) and closureArgvPacked (a packed args array).
func writeCaptures(argv @[]int, rec *int, f @VMFunc) int {
	var nCaps int = f.NumCaptureParams
	var capSlots int = 0
	if nCaps > 0 {
		var captureStructAddr int = rec[3]
		for i := 0; i < nCaps; i++ {
			var ofs int = f.CaptureOffsets[i]
			if f.CaptureByPtr[i] {
				argv[capSlots] = captureStructAddr + ofs
				capSlots = capSlots + 1
			} else if f.CaptureWide[i] {
				var wp *uint32 = bit_cast(*uint32, captureStructAddr + ofs)
				argv[capSlots] = cast(int, wp[0])
				argv[capSlots + 1] = cast(int, wp[1])
				capSlots = capSlots + 2
			} else {
				var capPtr *int = bit_cast(*int, captureStructAddr + ofs)
				argv[capSlots] = capPtr[0]
				capSlots = capSlots + 1
			}
		}
	}
	return capSlots
}

// closureArgv builds the flat execFunc argv for a VM function value dispatched
// through a fixed-arity trampoline: the record's captures (writeCaptures) at the
// leading param slots, then the user args a0..a6.  This is the capture
// marshalling the VM caller used to do inline before pushing a frame; moving it
// into the trampoline makes the trampoline the SINGLE dispatcher for a VM
// function value — so a VM caller and a NATIVE caller reach a capturing VM
// closure the same way (the latter previously panicked on a COMPILED_CLOSURE
// record).  Used by the fixed-shape TrampolineScalar/64/Aggregate; the packed
// trampoline uses closureArgvPacked.
func closureArgv(vm @VM, rec *int, fnIdx int, a0 int, a1 int, a2 int, a3 int, a4 int, a5 int,
		a6 int) @[]int {
	var f @VMFunc = vm.Funcs.Get(fnIdx)
	var argv @[]int = make_slice(int, f.NumCaptureParams * 2 + 7)
	var capSlots int = writeCaptures(argv, rec, f)
	argv[capSlots + 0] = a0
	argv[capSlots + 1] = a1
	argv[capSlots + 2] = a2
	argv[capSlots + 3] = a3
	argv[capSlots + 4] = a4
	argv[capSlots + 5] = a5
	argv[capSlots + 6] = a6
	return argv[0:capSlots + 7]
}

// closureArgvPacked builds the execFunc argv for the PACKED trampoline: the
// record's captures (writeCaptures) at the leading param slots, then nSlots user
// args copied verbatim from the packed args array.  Unlike closureArgv this
// carries ANY arg shape — the packed array already holds the VM's uniform
// int-slot representation of every user arg (a float as its bits, an aggregate as
// its by-address word, a 64-bit scalar as two slots on ILP32), so no fixed 7-word
// ceiling and no per-shape handling is needed here.
func closureArgvPacked(vm @VM, rec *int, fnIdx int, args *int, nSlots int) @[]int {
	var f @VMFunc = vm.Funcs.Get(fnIdx)
	var argv @[]int = make_slice(int, f.NumCaptureParams * 2 + nSlots)
	var capSlots int = writeCaptures(argv, rec, f)
	for i := 0; i < nSlots; i++ {
		argv[capSlots + i] = args[i]
	}
	return argv[0:capSlots + nSlots]
}

// TrampolineScalar is a generic ABI-aware bridge: compiled code
// calls it through a VM-side function value's vtable.call slot,
// passing data as the first arg and user args in subsequent
// register slots per AAPCS. The trampoline reads the VM handle
// and vm_func_idx from data, marshals captures + user args into argv
// (closureArgv), and dispatches via execFunc.
//
// Variadic-style register reading: the trampoline accepts a fixed
// 7-arg shape (a0..a6). Callers bitcast vtable.call to their
// function value's actual signature (typically narrower) and call
// with whatever args they have. Per AAPCS, register args land in
// X1..X7 deterministically; the trampoline reads only the first
// f.NumParams of them (execFunc uses len(args) and f.NumParams to
// limit the copy). Args beyond the caller's actual count are
// uninitialized but unread — sound on AAPCS, equivalent to how
// variadic C functions work.
//
// Shape constraint: scalars + pointers + bools only,
// no floats, no aggregates pass through. ≤7 user args. Broader
// signatures need a different shape (additional V-register
// trampoline or the always-pack convention) — out of scope here.
//
// Used by VM-side function values constructed in BC_FUNC_VALUE;
// see vm_exec_helpers.bn.
func TrampolineScalar(data *uint8, a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int) int {
	if data == nil {
		vmPanic("vm: TrampolineScalar called with nil data")
	}
	var rec *int = bit_cast(*int, data)
	if !closureRecIsVm(rec[0]) {
		vmPanic("vm: TrampolineScalar: data is not a VM closure record")
	}
	var vmAddr int = rec[1]
	if vmAddr == 0 {
		vmPanic("vm: TrampolineScalar: closure record has nil VM handle")
	}
	var vm @VM = bit_cast(@VM, vmAddr)
	var fnIdx int = rec[2] - 1
	if fnIdx < 0 || fnIdx >= vm.Funcs.Len() {
		vmPanic("vm: TrampolineScalar: vm_func_idx out of range")
	}
	var argv @[]int = closureArgv(vm, rec, fnIdx, a0, a1, a2, a3, a4, a5, a6)
	// One host word: TrampolineScalar is selected (ensureHandle) only for a
	// result that fits one register; a 64-bit scalar result uses
	// TrampolineScalar64 instead.  Narrow execFunc's int64 to the low word.
	return cast(int, execFunc(vm, fnIdx, argv))
}

// TrampolineScalar64 is the 64-bit-scalar-return counterpart of
// TrampolineScalar, selected by ensureHandle when a VM func's single result is
// a bare int64 / uint64 / float64 on a host whose word is < 8 bytes.  The
// compiled caller invokes vtable.call typed `i64(i8*, args)` (funcSignatureLLVM
// → writeShimResultLLVM declares an i64 return for a 64-bit scalar), so the
// trampoline must return the full int64 (r0:r1 on AAPCS32) — execFunc already
// yields it.  On a 64-bit host int64 fits one register, so this trampoline is
// never selected (ensureHandle's REG_SLOT < 8 gate) and TrampolineScalar is used.
func TrampolineScalar64(data *uint8, a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int) int64 {
	if data == nil {
		vmPanic("vm: TrampolineScalar64 called with nil data")
	}
	var rec *int = bit_cast(*int, data)
	if !closureRecIsVm(rec[0]) {
		vmPanic("vm: TrampolineScalar64: data is not a VM closure record")
	}
	var vmAddr int = rec[1]
	if vmAddr == 0 {
		vmPanic("vm: TrampolineScalar64: closure record has nil VM handle")
	}
	var vm @VM = bit_cast(@VM, vmAddr)
	var fnIdx int = rec[2] - 1
	if fnIdx < 0 || fnIdx >= vm.Funcs.Len() {
		vmPanic("vm: TrampolineScalar64: vm_func_idx out of range")
	}
	var argv @[]int = closureArgv(vm, rec, fnIdx, a0, a1, a2, a3, a4, a5, a6)
	return execFunc(vm, fnIdx, argv)
}

// TrampolineAggregate is the aggregate-return counterpart of
// TrampolineScalar.  Compiled code calls it through a VM-side
// function value's vtable.call slot when the function value's
// return uses the retbuf shim shape (types.IsAggregateReturn):
// a single wide / coerced aggregate (slice / managed-slice /
// multi-word or coerced struct / array / func-value / iface-value)
// OR a MULTI-return tuple (which is always retbuf-shaped for a
// func value, regardless of register count).
//
// Convention: matches the aggregate-shim shape (`void(i8* retbuf,
// i8* data, args...)`).  The retbuf is a caller-allocated buffer
// sized to the NATURAL result-image type (types.ResultImageSize);
// the trampoline writes the VM-side bytecode function's result
// there and returns void.
//
// Implementation: the bytecode VMFunc's BC_RETURN packs an aggregate
// or multi-return result contiguously onto vm.Stack and returns its
// address (packMultiReturn for a tuple; the single-aggregate address
// otherwise).  This trampoline dispatches via execFunc, gets the
// resulting address, and memcpys ResultRetbufBytes (the natural image
// size — NOT the 8-rounded AggregateReturnSize, which would overrun
// the caller's natural-typed retbuf) into retbuf.
//
// LIMITATION (shared with CallFuncAggregate): execFunc's entry-frame
// relocation caps the live result window at 64 bytes and resets vm.SP
// just past it, so a result image wider than 64 bytes would read past
// the freed window.  This is fail-loud rather than a silent over-read.
//
// Used by VM-side function values whose return is retbuf-shaped;
// vtable.call selection happens in ensureHandle (vm_funcvalue_handle.bn).
func TrampolineAggregate(retbuf *uint8, data *uint8, a0 int, a1 int, a2 int, a3 int, a4 int, a5 int,
		a6 int) {
	if data == nil {
		vmPanic("vm: TrampolineAggregate called with nil data")
	}
	var rec *int = bit_cast(*int, data)
	if !closureRecIsVm(rec[0]) {
		vmPanic("vm: TrampolineAggregate: data is not a VM closure record")
	}
	var vmAddr int = rec[1]
	if vmAddr == 0 {
		vmPanic("vm: TrampolineAggregate: closure record has nil VM handle")
	}
	var vm @VM = bit_cast(@VM, vmAddr)
	var fnIdx int = rec[2] - 1
	if fnIdx < 0 || fnIdx >= vm.Funcs.Len() {
		vmPanic("vm: TrampolineAggregate: vm_func_idx out of range")
	}
	var f @VMFunc = vm.Funcs.Get(fnIdx)
	if f.ResultRetbufBytes > 64 {
		vmPanic("vm: TrampolineAggregate: result image exceeds the 64-byte cross-mode window")
	}
	var argv @[]int = closureArgv(vm, rec, fnIdx, a0, a1, a2, a3, a4, a5, a6)
	// The aggregate result is an ADDRESS (a host word); narrow execFunc's int64.
	var resultAddr int = cast(int, execFunc(vm, fnIdx, argv))
	rt.MemCopy(retbuf, bit_cast(*readonly uint8, resultAddr), f.ResultRetbufBytes)
	// Cross-mode RETURN direction: if the result is
	// (or contains) an interface value implemented by a bytecode impl, its vtable
	// word in the just-copied retbuf is a VM index the native caller cannot
	// dereference.  Substitute each for the impl's native handle-vtable in the
	// retbuf COPY (native-owned; the VM's own box is untouched, so identity holds).
	if len(f.ResultIfaceVtOffsets) > 0 {
		substituteVtWords(vm, bit_cast(int, retbuf), f.ResultIfaceVtOffsets)
	}
}

// TrampolinePacked is the UNIFORM packed-int-slot bridge — the vtable's slot-2
// `call_packed` entry for every VM function value.  Unlike the fixed-arity
// TrampolineScalar/64/Aggregate (selected per return shape on slot 1 for compiled
// callers), one TrampolinePacked serves ALL VM func values: the bytecode VM
// caller invokes it with the user args as a packed int-slot array (its own
// register window, zero-copy) plus a count, so cross-mode dispatch carries ANY
// arg/return shape without the 7-word / scalar-only ceiling.
//
// `data` is the closure record; `args`/`nSlots` are the packed user args;
// `retbuf` is non-nil exactly when the callee is retbuf-dispatched
// (f.ResultUsesRetbuf) — the caller allocates it then.  Return: the scalar result
// as i64 bits (a one-word scalar in the low word; a bare 64-bit scalar / float in
// full; ignored for the retbuf case, which writes the natural-size result image
// into retbuf).  execFunc yields a VALUE for a scalar callee and the result
// image's ADDRESS for a retbuf callee, so this branches on f.ResultUsesRetbuf
// (the callee's authoritative return mode) and fails loud on a caller/callee
// return-mode divergence.
func TrampolinePacked(data *uint8, args *int, nSlots int, retbuf *uint8) int64 {
	if data == nil {
		vmPanic("vm: TrampolinePacked called with nil data")
	}
	var rec *int = bit_cast(*int, data)
	if !closureRecIsVm(rec[0]) {
		vmPanic("vm: TrampolinePacked: data is not a VM closure record")
	}
	var vmAddr int = rec[1]
	if vmAddr == 0 {
		vmPanic("vm: TrampolinePacked: closure record has nil VM handle")
	}
	var vm @VM = bit_cast(@VM, vmAddr)
	var fnIdx int = rec[2] - 1
	if fnIdx < 0 || fnIdx >= vm.Funcs.Len() {
		vmPanic("vm: TrampolinePacked: vm_func_idx out of range")
	}
	var f @VMFunc = vm.Funcs.Get(fnIdx)
	var argv @[]int = closureArgvPacked(vm, rec, fnIdx, args, nSlots)
	if f.ResultUsesRetbuf {
		if retbuf == nil {
			vmPanic("vm: TrampolinePacked: retbuf-dispatched callee but caller passed nil retbuf")
		}
		if f.ResultRetbufBytes > 64 {
			vmPanic("vm: TrampolinePacked: result image exceeds the 64-byte cross-mode window")
		}
		var resultAddr int = cast(int, execFunc(vm, fnIdx, argv))
		rt.MemCopy(retbuf, bit_cast(*readonly uint8, resultAddr), f.ResultRetbufBytes)
		// Cross-mode RETURN direction: substitute any bytecode-impl iface vtable
		// word in the copied image for the impl's native handle-vtable (as
		// TrampolineAggregate does) so a native caller can dereference it.
		if len(f.ResultIfaceVtOffsets) > 0 {
			substituteVtWords(vm, bit_cast(int, retbuf), f.ResultIfaceVtOffsets)
		}
		return 0
	}
	// Scalar (incl. bare 64-bit scalar / float bits): execFunc returns the value.
	return execFunc(vm, fnIdx, argv)
}
