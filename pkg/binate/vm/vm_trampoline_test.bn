package "pkg/binate/vm"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// Tests for the cross-mode trampoline helpers (vm_trampoline.bn).  The
// trampolines themselves dispatch through execFunc and are exercised end-to-end
// by e2e/xmfuncvalue.sh and the VM-mode closure conformance; these pin the
// capture-marshalling helper closureArgv and the kind predicate in isolation.

// closureArgv lays a VM closure's captures (read from the record's capture-struct
// address via the callee's CaptureOffsets) at the leading argv slots, then the
// user args — the prep the trampoline hands to execFunc.
func TestClosureArgvCapturesThenUserArgs() testing.TestResult {
	var vm @VM = newTestVM(4096)
	// A callee with two 1-slot int captures at env byte offsets 0 and REG_SLOT.
	var f @VMFunc = make(VMFunc)
	f.NumCaptureParams = 2
	var offs @[]int = make_slice(int, 2)
	offs[0] = 0
	offs[1] = REG_SLOT
	f.CaptureOffsets = offs
	f.CaptureByPtr = make_slice(bool, 2)
	f.CaptureWide = make_slice(bool, 2)
	f.CaptureBytes = make_slice(int, 2)
	f.CaptureSigned = make_slice(bool, 2)
	var fnIdx int = vm.Funcs.Len()
	vm.Funcs.Push(f)

	// A capture struct {11, 22} in memory; the record's rec[3] points at it.
	var capStruct @[]int = make_slice(int, 2)
	capStruct[0] = 11
	capStruct[1] = 22
	var rec @[]int = make_slice(int, 4)
	rec[0] = rt.DATA_KIND_COMPILED_CLOSURE
	rec[3] = bit_cast(int, &capStruct[0])

	var argv @[]int = closureArgv(vm, &rec[0], fnIdx, 100, 200, 0, 0, 0, 0, 0)
	if len(argv) != 9 {
		return "expected argv length 9 (2 capture slots + 7 user slots)"
	}
	if argv[0] != 11 || argv[1] != 22 {
		return "captures must lead the argv"
	}
	if argv[2] != 100 || argv[3] != 200 {
		return "user args must follow the captures"
	}
	return ""
}

// A non-capturing VM function value (NumCaptureParams 0) contributes no capture
// slots; argv is just the user args, and rec[3] is never read.
func TestClosureArgvNonCapturing() testing.TestResult {
	var vm @VM = newTestVM(4096)
	var f @VMFunc = make(VMFunc)
	f.NumCaptureParams = 0
	var fnIdx int = vm.Funcs.Len()
	vm.Funcs.Push(f)
	var rec @[]int = make_slice(int, 4)
	rec[0] = rt.DATA_KIND_VM_CLOSURE_REC
	var argv @[]int = closureArgv(vm, &rec[0], fnIdx, 7, 8, 9, 0, 0, 0, 0)
	if len(argv) != 7 {
		return "non-capturing argv is the 7 user slots"
	}
	if argv[0] != 7 || argv[1] != 8 || argv[2] != 9 {
		return "user args lead a non-capturing argv"
	}
	return ""
}

// closureRecIsVm accepts both VM record kinds and rejects anything else — a
// trampoline's data is always a VM record (a native closure has its own shim).
func TestClosureRecIsVm() testing.TestResult {
	if !closureRecIsVm(rt.DATA_KIND_VM_CLOSURE_REC) {
		return "VM_CLOSURE_REC must be a VM record"
	}
	if !closureRecIsVm(rt.DATA_KIND_COMPILED_CLOSURE) {
		return "COMPILED_CLOSURE must be a VM record"
	}
	if closureRecIsVm(0) {
		return "kind 0 (freed/zeroed) is not a VM record"
	}
	if closureRecIsVm(99) {
		return "an arbitrary kind is not a VM record"
	}
	return ""
}

// closureArgvPacked lays captures then the packed user args verbatim — and
// carries MORE than 7 user args (a fixed a0..a6 shim's ceiling), the whole point
// of the packed path.  Mirrors TestClosureArgvCapturesThenUserArgs but sources
// the user args from an int-slot array of arbitrary length.
func TestClosureArgvPacked() testing.TestResult {
	var vm @VM = newTestVM(4096)
	var f @VMFunc = make(VMFunc)
	f.NumCaptureParams = 2
	var offs @[]int = make_slice(int, 2)
	offs[0] = 0
	offs[1] = REG_SLOT
	f.CaptureOffsets = offs
	f.CaptureByPtr = make_slice(bool, 2)
	f.CaptureWide = make_slice(bool, 2)
	f.CaptureBytes = make_slice(int, 2)
	f.CaptureSigned = make_slice(bool, 2)
	var fnIdx int = vm.Funcs.Len()
	vm.Funcs.Push(f)

	var capStruct @[]int = make_slice(int, 2)
	capStruct[0] = 11
	capStruct[1] = 22
	var rec @[]int = make_slice(int, 4)
	rec[0] = rt.DATA_KIND_COMPILED_CLOSURE
	rec[3] = bit_cast(int, &capStruct[0])

	// 9 user args (> the 7-word fixed ceiling).
	var args @[]int = make_slice(int, 9)
	for i := 0; i < 9; i++ {
		args[i] = 100 + i
	}
	var argv @[]int = closureArgvPacked(vm, &rec[0], fnIdx, &args[0], 9)
	if len(argv) != 11 {
		return "expected argv length 11 (2 capture slots + 9 user slots)"
	}
	if argv[0] != 11 || argv[1] != 22 {
		return "captures must lead the argv"
	}
	if argv[2] != 100 || argv[10] != 108 {
		return "packed user args must follow the captures, in order, past the 7-word ceiling"
	}
	return ""
}

// A non-capturing packed dispatch: argv is just the nSlots packed user args.
func TestClosureArgvPackedNonCapturing() testing.TestResult {
	var vm @VM = newTestVM(4096)
	var f @VMFunc = make(VMFunc)
	f.NumCaptureParams = 0
	var fnIdx int = vm.Funcs.Len()
	vm.Funcs.Push(f)
	var rec @[]int = make_slice(int, 4)
	rec[0] = rt.DATA_KIND_VM_CLOSURE_REC
	var args @[]int = make_slice(int, 3)
	args[0] = 7
	args[1] = 8
	args[2] = 9
	var argv @[]int = closureArgvPacked(vm, &rec[0], fnIdx, &args[0], 3)
	if len(argv) != 3 {
		return "non-capturing packed argv is just the user slots"
	}
	if argv[0] != 7 || argv[1] != 8 || argv[2] != 9 {
		return "user args lead a non-capturing packed argv"
	}
	return ""
}

// writeCaptures reads each narrow capture at its own width: a negative int8, int32 and
// int16 arrive sign-extended and a uint16 zero-extended, and none takes the bytes after
// it (0xFF after the first three, 0x00 after the int16, so that a whole-word read differs
// from each).
func TestWriteCapturesNarrow() testing.TestResult {
	var f @VMFunc = make(VMFunc)
	f.NumCaptureParams = 4
	var offs @[]int = make_slice(int, 4)
	offs[1] = 2
	offs[2] = 4
	offs[3] = 8
	f.CaptureOffsets = offs
	f.CaptureByPtr = make_slice(bool, 4)
	f.CaptureWide = make_slice(bool, 4)
	var widths @[]int = make_slice(int, 4)
	widths[0] = 1
	widths[1] = 2
	widths[2] = 4
	widths[3] = 2
	f.CaptureBytes = widths
	var signed @[]bool = make_slice(bool, 4)
	signed[0] = true
	signed[2] = true
	signed[3] = true
	f.CaptureSigned = signed
	// int8 -3 at 0, uint16 40000 at 2, int32 -5 at 4, int16 -300 at 8, little-endian.
	var mem @[]uint8 = make_slice(uint8, 16)
	for i := 0; i < len(mem); i++ {
		mem[i] = 0xFF
	}
	mem[0] = 0xFD
	mem[2] = 0x40
	mem[3] = 0x9C
	mem[4] = 0xFB
	mem[8] = 0xD4
	mem[9] = 0xFE
	mem[10] = 0x00
	var rec @[]int = make_slice(int, 4)
	rec[0] = rt.DATA_KIND_COMPILED_CLOSURE
	rec[3] = bit_cast(int, &mem[0])
	var argv @[]int = make_slice(int, 8)
	if writeCaptures(argv, &rec[0], f) != 4 { return "expected 4 capture slots" }
	if argv[0] != -3 { return "an int8 capture must be sign-extended" }
	if argv[1] != 40000 { return "a uint16 capture must be zero-extended, without the bytes after it" }
	if argv[2] != -5 { return "an int32 capture must be sign-extended" }
	if argv[3] != -300 { return "an int16 capture must be sign-extended" }
	return ""
}
