package "pkg/binate/vm"

import "pkg/stdx/slices"

// Injected interface-impl vtable registry — the cross-mode counterpart to
// lower_data.bn's globalNames/globalAddrs (exported-global injection).  A
// native-only package skips VM lowering, so lowerImplVtables never registers its
// `@__ivt` vtables in vm.IfaceVtables.  RegisterPackageVtables (extern_register_
// std.bn) instead binds each such vtable's bare mangled name to its native
// `@__ivt` address here, from the package's reflect descriptor.  A bytecode
// BC_IFACE_VALUE whose name misses vm.IfaceVtables falls back to lookupVtableAddr
// and stores the raw native address in the interface value, where ifaceVtIsNative
// routes method dispatch (dispatchCompiledIfaceMethod) and the dtor through the
// same path an iface returned BY native code already uses.

// registerVtableAddr binds an interface-impl vtable's bare mangled name to its
// native `@__ivt` address (addr), parallel `@__ivtshim` address (shimAddr), and
// slot count (slotCount — the vtable's extent, for the upcast range lookup),
// appending to the VM's injected-vtable registry (vm.vtableInjNames /
// vtableInjAddrs / vtableInjShims / vtableInjSizes).
// `name` is the descriptor's VtableInfo.Name (already the canonical bare form —
// no qualification needed); the bytes are copied into an owned @[]char because
// the table outlives the caller's readonly slice.
func registerVtableAddr(vm @VM, name *[]readonly char, addr int, shimAddr int,
		slotCount int) {
	var owned @[]char = make_slice(char, len(name))
	for i := 0; i < len(name); i++ {
		owned[i] = name[i]
	}
	vm.vtableInjNames = slices.Append[@[]char](vm.vtableInjNames, owned)
	vm.vtableInjAddrs = slices.Append[int](vm.vtableInjAddrs, addr)
	vm.vtableInjShims = slices.Append[int](vm.vtableInjShims, shimAddr)
	vm.vtableInjSizes = slices.Append[int](vm.vtableInjSizes, slotCount)
}

// lookupVtableAddr returns the native `@__ivt` address registered for a vtable
// name, or 0 if none.  The name is the bare `__ivt.bn_…` form (already canonical
// — vtable names are not package-qualified), so a direct scan resolves it.
func lookupVtableAddr(vm @VM, name *[]readonly char) int {
	for i := 0; i < len(vm.vtableInjNames); i++ {
		if streq2(vm.vtableInjNames[i], name) { return vm.vtableInjAddrs[i] }
	}
	return 0
}

// lookupShimVtable maps a raw `@__ivt` vtable WORD (an iface value's vtable
// word) to the corresponding `@__ivtshim` address, or 0 if the word falls in no
// registered vtable.  A non-upcast native value's word is exactly a registered
// base (offset 0 → the shim base); an interface UPCAST to a parent advances the
// word by offset*8 to the parent sub-block, so the word is INTERIOR to the base
// @__ivt (offset>0).  Match the registered vtable whose extent
// [base, base + slotCount*8) contains rawAddr and return the SAME byte offset
// into its parallel shim (shim + (rawAddr - base)); dispatchCompiledIfaceMethod
// then indexes the method slot within that sub-block.  The `*8` is the LP64
// VM-host pointer size, matching the OP_IFACE_UPCAST word arithmetic.  An address
// outside every extent yields 0, so the caller aborts loudly rather than
// dispatching through a mis-resolved slot.
func lookupShimVtable(vm @VM, rawAddr int) int {
	for i := 0; i < len(vm.vtableInjAddrs); i++ {
		var base int = vm.vtableInjAddrs[i]
		if rawAddr >= base && rawAddr < base + vm.vtableInjSizes[i] * 8 {
			return vm.vtableInjShims[i] + (rawAddr - base)
		}
	}
	return 0
}
