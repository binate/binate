package "pkg/binate/vm"

import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for vtable_inject.bn — the injected interface-impl vtable registry that
// RegisterPackageVtables populates and dispatchCompiledIfaceMethod /
// BC_IFACE_VALUE read.

// registerVtableAddr binds a vtable name to its raw @__ivt address, parallel
// @__ivtshim address, and slot count; lookupVtableAddr resolves by name (the
// BC_IFACE_VALUE fallback) and lookupShimVtable maps a raw @__ivt WORD (a base or
// an offset>0 upcast interior address, bounded by the slot count) to the parallel
// shim word (the dispatchCompiledIfaceMethod path).  A slot is one target pointer
// (w bytes), so A's 4 slots span [4096, 4096 + 4*w) and B's span [12288, 12288 + 4*w)
// — the extent scales with the target word size (w = 8 on LP64, 4 on ILP32).
func TestVtableInjectRegistry() testing.TestResult {
	var w int = types.GetTarget().PointerSize
	var vm @VM = make(VM)
	registerVtableAddr(vm, "__ivt.bn_vtest_A", 4096, 8192, 4)
	registerVtableAddr(vm, "__ivt.bn_vtest_B", 12288, 16384, 4)

	if lookupVtableAddr(vm, "__ivt.bn_vtest_A") != 4096 {
		return "lookupVtableAddr A should resolve to its raw @__ivt addr"
	}
	if lookupVtableAddr(vm, "__ivt.bn_vtest_B") != 12288 {
		return "lookupVtableAddr B should resolve to its raw @__ivt addr"
	}
	if lookupVtableAddr(vm, "__ivt.bn_vtest_missing") != 0 {
		return "an unregistered name should resolve to 0"
	}
	// lookupShimVtable maps the RAW @__ivt word (the iface value's vtable word) to
	// the parallel @__ivtshim word.  A base word (offset 0) → the shim base.
	if lookupShimVtable(vm, 4096) != 8192 {
		return "lookupShimVtable should map A's base addr to its shim base"
	}
	if lookupShimVtable(vm, 12288) != 16384 {
		return "lookupShimVtable should map B's base addr to its shim base"
	}
	// An offset>0 upcast advances the word INTERIOR to A's @__ivt; the shim word
	// advances by the SAME byte offset (parallel layout): slot 2 → 4096 + 2*w maps
	// to 8192 + 2*w.
	if lookupShimVtable(vm, 4096 + 2 * w) != 8192 + 2 * w {
		return "lookupShimVtable should range-map an interior (upcast) word to the same shim offset"
	}
	// The last valid slot (offset 3 of 4): still within A's extent.
	if lookupShimVtable(vm, 4096 + 3 * w) != 8192 + 3 * w {
		return "lookupShimVtable should range-map the last in-extent slot"
	}
	// One past A's extent (offset 4 == slotCount): outside [4096, 4096 + 4*w) and
	// below B's base → 0, so the caller aborts rather than mis-resolving.
	if lookupShimVtable(vm, 4096 + 4 * w) != 0 {
		return "an address one past a vtable's extent should resolve to 0"
	}
	if lookupShimVtable(vm, 99999) != 0 {
		return "an address outside every registered extent should resolve to 0"
	}
	return ""
}

// Per-instance isolation: a vtable registered on one VM must NOT be
// visible on a second VM (the embeddability guarantee).
func TestVtableInjectPerInstanceIsolation() testing.TestResult {
	var a @VM = make(VM)
	registerVtableAddr(a, "__ivt.bn_iso", 4096, 8192, 4)
	var b @VM = make(VM)
	if lookupVtableAddr(b, "__ivt.bn_iso") != 0 {
		return "a vtable registered on VM a must not resolve on VM b"
	}
	if lookupShimVtable(b, 4096) != 0 {
		return "VM b must not map VM a's raw vtable address"
	}
	if lookupVtableAddr(a, "__ivt.bn_iso") != 4096 {
		return "VM a must still resolve its own vtable"
	}
	return ""
}
