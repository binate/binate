package "pkg/binate/vm"

import "pkg/builtins/testing"

// Tests for vtable_inject.bn — the injected interface-impl vtable registry that
// RegisterPackageVtables populates and dispatchCompiledIfaceMethod /
// BC_IFACE_VALUE read.

// registerVtableAddr binds a vtable name to its raw @__ivt address and parallel
// @__ivtshim address; lookupVtableAddr resolves by name (the BC_IFACE_VALUE
// fallback) and lookupShimVtable maps the raw address to the shim vtable (the
// dispatchCompiledIfaceMethod path).
func TestVtableInjectRegistry() testing.TestResult {
	registerVtableAddr("__ivt.bn_vtest_A", 4096, 8192)
	registerVtableAddr("__ivt.bn_vtest_B", 12288, 16384)

	if lookupVtableAddr("__ivt.bn_vtest_A") != 4096 {
		return "lookupVtableAddr A should resolve to its raw @__ivt addr"
	}
	if lookupVtableAddr("__ivt.bn_vtest_B") != 12288 {
		return "lookupVtableAddr B should resolve to its raw @__ivt addr"
	}
	if lookupVtableAddr("__ivt.bn_vtest_missing") != 0 {
		return "an unregistered name should resolve to 0"
	}
	// lookupShimVtable maps the RAW @__ivt address (the iface value's vtable
	// word) to the parallel @__ivtshim address.
	if lookupShimVtable(4096) != 8192 {
		return "lookupShimVtable should map A's raw addr to its shim vtable"
	}
	if lookupShimVtable(12288) != 16384 {
		return "lookupShimVtable should map B's raw addr to its shim vtable"
	}
	if lookupShimVtable(99999) != 0 {
		return "an unregistered raw address should resolve to 0"
	}
	return ""
}
