// Package vmdata holds the bytecode VM's runtime value/layout types — the
// func vtable/handle/closure records, extern binding, iface-arg layouts, and the
// name-index hash/eq policies — split out of the VM core so vm.bni carries only
// the VM engine + VMFunc.  Depends only on leaf packages, so vm imports it.
package "pkg/binate/vmdata"

import "pkg/std/cmp"
import "pkg/std/hash"

// ArgSlotIfaceLayout describes, for ONE by-address argument slot of a cross-mode
// call, where the interface-value VTABLE WORDS sit inside the argument's image
// and how many bytes to copy.  It is the ARGUMENT-direction analog of the return
// side's VMFunc.ResultIfaceVtOffsets, generalized from a single top-level word to
// the recursive set an aggregate arg can carry:
//   - Slot: the packed argument-slot index (0-based, a0.. for a direct/func-value
//     call; the receiver a0 is excluded and user args pack from index 0 for an
//     iface method, mapping to a1..).
//   - ByteSize: the argument image's byte size (its type's SizeOf), the amount a
//     non-destructive substitution copies onto vm.Stack (the copy's SP reservation
//     is rounded up to 8 for alignment; the copy itself is exactly ByteSize).
//   - Offsets: byte offsets, within the image, of every interface vtable word
//     (ifaceVtOffsetsFor, recursing into struct / array fields).  A top-level
//     interface arg is the degenerate one-offset case (IfaceValueVtableIndex()*
//     REG_SLOT), a by-value struct with nested interface fields the general case.
type ArgSlotIfaceLayout struct {
	Slot     int
	ByteSize int
	Offsets  @[]int
}

// ArgIfaceLayout is a single call site's per-argument interface-vtable layout:
// the list of argument slots that carry interface content (top-level OR nested in
// a by-value aggregate) with each slot's copy size and vtable-word offsets.  It
// REPLACES the flat 7-bit per-slot interface bitmap S2/S3 crammed into free
// Imm/Aux bits (which could only mark WHICH top-level slots were interfaces, not
// the nested field offsets).  Built at lower time by buildArgIfaceLayout and
// stored on the CALLER's VMFunc (VMFunc.ArgIfaceLayouts); the call instruction
// carries a 1-based index into that table (0 = the call has no interface args).
// The cross-mode dispatchers substitute each listed slot via substArgSlotIface.
type ArgIfaceLayout struct {
	Slots @[]@ArgSlotIfaceLayout
	// SliceIfaceSlots: the arg SLOT indices whose value is a `*[]*any` (a raw slice of
	// raw interface values).  The cross-mode extern dispatch translates each such
	// slice's ELEMENTS' VM-index vtable words to the impl's native handle-vtable
	// (substituteSliceIfaceArgs) — the nested-behind-a-data-pointer analog of Slots.
	// A per-slot LIST, not a bitmap: the 64-slot dispatch buffer outruns a host int
	// (32-bit on ILP32), where the old per-slot bitmap rode instr.Src2.  Populated for
	// every cross-mode call shape by buildArgIfaceLayout; consumed only by the extern
	// dispatcher (dispatchExternBinding).
	SliceIfaceSlots @[]int
}

// VMFuncVtable is the heap-allocated function-value vtable for a
// VMFunc taken as a function value.  Field layout matches the
// statically-emitted vtable bnc produces for compiled functions:
//   - Dtor: 0 for non-capturing; will hold a destructor func ptr
//     for capturing closures.
//   - Call: the per-function shim address (compiled native fn)
//     OR a universal trampoline address (TrampolineScalar /
//     TrampolineAggregate) when constructed by BC_FUNC_VALUE
//     Path B for a bytecode-only function.
// Heap-allocated and referenced from a VMFunc managed field so
// its lifetime ties to the VMFunc — no leak on VMFunc death.
type VMFuncVtable struct {
	Dtor int
	Call int
	// CallPacked is the packed-int-slot dispatch entry (vtable slot 2, matching
	// the native `@__vt` {dtor, call, call_packed} layout).  The bytecode VM
	// caller invokes THIS entry so cross-mode dispatch carries any arg/return
	// shape; the real-ABI `Call` slot serves compiled callers.
	CallPacked int
}

// VMFuncHandle is the heap-allocated {vtable_ptr, data_ptr} block
// returned by BC_FUNC_HANDLE for bytecode-only functions.  Layout
// matches the static `@__handle.F` symbol bnc emits for natively-
// compiled functions, so consumers (`_call_free_fn` / `_call_dtor`
// via OP_CALL_HANDLE) dispatch uniformly through both kinds.
// Heap-allocated and referenced from a VMFunc managed field so its
// lifetime ties to the VMFunc.
type VMFuncHandle struct {
	VtableAddr int
	DataAddr   int
}

// VMClosureRec is the heap-allocated closure record carried by a
// VMFunc-derived function value.  The universal trampolines
// (TrampolineScalar / TrampolineAggregate) read it as their
// `data` argument and dispatch via `execFunc(Vm, FnIdx-1, args)`.
//   - Kind: discriminates VM closure records from other
//     compiler-emitted closure data shapes; always set to
//     `rt.DATA_KIND_VM_CLOSURE_REC`.
//   - Vm:   `bit_cast(int, @VM)` — the VM to dispatch into.
//   - FnIdx: 1-based function index in `Vm.Funcs`.  0 reserved.
//   - Captured: captured-context pointer for closures (Phase 2);
//     0 in Phase 1.
// Heap-allocated and referenced from a VMFunc managed field so
// its lifetime ties to the VMFunc — no leak on VMFunc death.
type VMClosureRec struct {
	Kind     int
	Vm       int
	FnIdx    int
	Captured int
}

// IfaceVtable holds the runtime-resolved VM function indices for a
// single (impl, interface) pair. The Methods slice is in the
// interface's method-declaration order; each entry is a 1-based
// VM function index (0 = not found, treated as a fatal at dispatch
// time). Name is the mangled `__ivt.<...>` form used by IR-gen so
// VM lower can find a vtable by name when lowering OP_IFACE_VALUE.
type IfaceVtable struct {
	Name    @[]char
	Methods @[]int
	// NativeVt caches the impl's NATIVE handle-based vtable — a raw @__ivt-
	// shaped array (dtor handle at slot 0, *TypeInfo at slot 1, method handles
	// after) built lazily the first time this bytecode impl's interface value
	// crosses to an injected-native callee (buildNativeIfaceVtable), so the
	// native code can RefDec / dispatch it by re-entering the VM.  0 = not yet
	// built; a nonzero value is the array's stable native address (immortal,
	// VM-lifetime).  Per-index cache: it lives on the @IfaceVtable held in
	// vm.IfaceVtables, so it is reused across every cross-mode call.
	NativeVt int
}

// VmNameHasher / VmNameEq are the ZERO-SIZE trait-type policies for the VM's
// name→index tables (FuncIndex / ExternIndex / DataSymIndex; bodies in
// func_index.bn).  Being zero-size with method Hash/Equal, they monomorphize the
// tables' hash/equality to DIRECT (inlinable) calls — parity with the former
// open-coded probe tables — while sharing the one stdlib table.Table engine.
type VmNameHasher struct {}

// Hash is VmNameHasher's method (body in func_index.bn).
func (h VmNameHasher) Hash(k *[]readonly char) uint

impl VmNameHasher : hash.Hasher[*[]readonly char]

// VmNameEq is the equality policy paired with VmNameHasher (body in func_index.bn).
type VmNameEq struct {}

// Equal is VmNameEq's method (body in func_index.bn).
func (e VmNameEq) Equal(a *[]readonly char, b *[]readonly char) bool

impl VmNameEq : cmp.Eq[*[]readonly char]

// ExternBinding: name → compiled-side function value, populated by
// RegisterExtern.  The 16-byte function value's two words are stored
// inline so the binding owns its own copy (the user's source fv may
// be a stack local — copying decouples its lifetime from the VM's).
// VtableAddr's `call` slot is the per-function shim; DataAddr is
// null for non-capturing function refs.
//
// RetbufSize is the aggregate RETBUF size (types.AggregateReturnSize:
// rounded to N*8, or 0 for a scalar return) — the cross-mode dispatch
// shape, agreeing with codegen's isAggregateReturn:
//   - 0: scalar dispatch via rt._call_shim_scalar — vtable.call is
//     `<ret>(i8*, args...)*`.
//   - > 0: aggregate dispatch via rt._call_shim_aggregate (a coerced
//     ≤ 8-byte struct, a multi-return, a slice / managed-slice, or any
//     > word result) — vtable.call is `void(i8* retbuf, i8* data,
//     args...)*` and dispatchExternBinding reserves RetbufSize retbuf
//     bytes before calling.
type ExternBinding struct {
	Name       @[]char
	VtableAddr int
	DataAddr   int
	RetbufSize int
	// HandleAddr is the binding's owned copy of the registered
	// function's 16-byte {VtableAddr, DataAddr} function-value
	// handle.  Populated by RegisterExtern from the caller's
	// `_func_handle(F)` argument (which may be a static
	// `@__handle.F` global in native or a heap allocation on
	// VMFunc.Handle in bytecode); RegisterExtern copies the two
	// words into a fresh managed allocation so the binding's
	// lifetime is independent of the caller's source.
	// BC_FUNC_HANDLE casts this managed pointer to int and returns
	// it — the resulting *uint8 points at a uniformly-shaped handle
	// across all vm-nesting depths.  nil if the registrant didn't
	// supply one (e.g. legacy tests).
	HandleAddr @VMFuncHandle
}

// VmNameHasher.Hash — the zero-size hashing policy's method (type + impl in vm.bni).
func (h VmNameHasher) Hash(k *[]readonly char) uint

// VmNameEq.Equal — the zero-size equality policy's method (type + impl in vm.bni).
func (e VmNameEq) Equal(a *[]readonly char, b *[]readonly char) bool
