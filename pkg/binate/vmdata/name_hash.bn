package "pkg/binate/vmdata"

// VmNameHasher.Hash — the zero-size hashing policy's method (type + impl in vm.bni).
func (h VmNameHasher) Hash(k *[]readonly char) uint {
	return cast(uint, hashName(k))
}

// VmNameEq.Equal — the zero-size equality policy's method (type + impl in vm.bni).
func (e VmNameEq) Equal(a *[]readonly char, b *[]readonly char) bool {
	return nameEq(a, b)
}

// hashName returns a djb2 hash of `name`.  Sign is not meaningful (VmNameHasher
// casts it to uint, and masking to a bucket takes the low bits regardless); djb2
// is cheap and well-distributed for the short qualified names ("pkg.Func",
// "T.Method") that callee / extern / data-symbol resolution sees.
func hashName(name *[]readonly char) int {
	var h int = 5381
	for i := 0; i < len(name); i++ {
		h = h * 33 + cast(int, name[i])
	}
	return h
}

// nameEq reports whether two char slices contain identical bytes.
func nameEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
