package "pkg/bootstrap"

import "pkg/builtins/testing"

// Unit tests for the print/println format helpers in bootstrap.bn.
// Pre-existing coverage was end-to-end via println in user
// programs, which misses the int-min boundary and the new
// formatUint path.  Directly exercising the format helpers
// catches future regressions at the level of the formatter
// itself.

// Helper: compare the first n bytes of buf against an expected
// string s.
func bufEq(buf *[]uint8, n int, s *[]readonly char) bool {
	if n != len(s) { return false }
	for i := 0; i < n; i++ {
		if cast(int, buf[i]) != cast(int, s[i]) { return false }
	}
	return true
}

func fail(msg @[]char) testing.TestResult {
	return msg
}

// ============================================================
// formatInt
// ============================================================

func TestFormatIntZero() testing.TestResult {
	var buf @[]uint8 = make_slice(uint8, 20)
	var n int = formatInt(0, buf)
	if !bufEq(buf, n, "0") { return fail("formatInt(0) != \"0\"") }
	return ""
}

func TestFormatIntPositive() testing.TestResult {
	var buf @[]uint8 = make_slice(uint8, 20)
	var n int = formatInt(42, buf)
	if !bufEq(buf, n, "42") { return fail("formatInt(42) != \"42\"") }
	return ""
}

func TestFormatIntNegative() testing.TestResult {
	var buf @[]uint8 = make_slice(uint8, 20)
	var n int = formatInt(-7, buf)
	if !bufEq(buf, n, "-7") { return fail("formatInt(-7) != \"-7\"") }
	return ""
}

// formatInt takes a host-width `int`, so its min/max boundary is the
// target's int width — int32 on a 32-bit host, int64 on a 64-bit one.
// The boundary value (and expected string) is computed from
// sizeof(int) rather than baked in, since the int64 extremes don't
// even fit `int` on a 32-bit target.  int-min is the value with only
// the sign bit set; it exercises the `0 - n` overflow path, where a
// naive negate would emit just "-".  (formatInt64 covers the fixed
// 64-bit extremes in TestFormatInt64Boundaries.)
func TestFormatIntIntMin() testing.TestResult {
	var buf @[]uint8 = make_slice(uint8, 24)
	var shift uint = cast(uint, cast(int, sizeof(int)) * 8 - 1)
	var minInt int = cast(int, cast(uint, 1) << shift)
	var n int = formatInt(minInt, buf)
	var want *[]readonly char = "-9223372036854775808"
	if cast(int, sizeof(int)) == 4 { want = "-2147483648" }
	if !bufEq(buf, n, want) {
		return fail("formatInt(int-min) wrong")
	}
	return ""
}

func TestFormatIntIntMax() testing.TestResult {
	var buf @[]uint8 = make_slice(uint8, 24)
	var shift uint = cast(uint, cast(int, sizeof(int)) * 8 - 1)
	var maxInt int = cast(int, (cast(uint, 1) << shift) - cast(uint, 1))
	var n int = formatInt(maxInt, buf)
	var want *[]readonly char = "9223372036854775807"
	if cast(int, sizeof(int)) == 4 { want = "2147483647" }
	if !bufEq(buf, n, want) {
		return fail("formatInt(int-max) wrong")
	}
	return ""
}

// ============================================================
// formatInt64
// ============================================================

func TestFormatInt64Boundaries() testing.TestResult {
	var buf @[]uint8 = make_slice(uint8, 20)
	var n int = formatInt64(cast(int64, -9223372036854775807) - cast(int64, 1), buf)
	if !bufEq(buf, n, "-9223372036854775808") {
		return fail("formatInt64(int64-min) wrong")
	}
	n = formatInt64(cast(int64, 9223372036854775807), buf)
	if !bufEq(buf, n, "9223372036854775807") {
		return fail("formatInt64(int64-max) wrong")
	}
	return ""
}

// ============================================================
// formatUint
// ============================================================

func TestFormatUintZero() testing.TestResult {
	var buf @[]uint8 = make_slice(uint8, 20)
	var n int = formatUint(cast(uint64, 0), buf)
	if !bufEq(buf, n, "0") { return fail("formatUint(0) != \"0\"") }
	return ""
}

func TestFormatUintSmall() testing.TestResult {
	var buf @[]uint8 = make_slice(uint8, 20)
	var n int = formatUint(cast(uint64, 42), buf)
	if !bufEq(buf, n, "42") { return fail("formatUint(42) != \"42\"") }
	return ""
}

func TestFormatUintHighBit() testing.TestResult {
	// 2^63 — the case that breaks signed formatInt (would print
	// "-9223372036854775808").  formatUint must print
	// "9223372036854775808".
	var buf @[]uint8 = make_slice(uint8, 20)
	var n int = formatUint(cast(uint64, 1) << 63, buf)
	if !bufEq(buf, n, "9223372036854775808") {
		return fail("formatUint(2^63) wrong")
	}
	return ""
}

func TestFormatUintUint64Max() testing.TestResult {
	// 2^64 - 1 — the largest representable uint64.  formatUint
	// must produce all 20 digits.
	var buf @[]uint8 = make_slice(uint8, 20)
	var maxU uint64 =
		(cast(uint64, 1) << 63) | ((cast(uint64, 1) << 63) - 1)
	var n int = formatUint(maxU, buf)
	if !bufEq(buf, n, "18446744073709551615") {
		return fail("formatUint(uint64-max) wrong")
	}
	return ""
}

// ============================================================
// formatBool
// ============================================================

func TestFormatBoolTrue() testing.TestResult {
	var buf @[]uint8 = make_slice(uint8, 5)
	var n int = formatBool(true, buf)
	if !bufEq(buf, n, "true") { return fail("formatBool(true) wrong") }
	return ""
}

func TestFormatBoolFalse() testing.TestResult {
	var buf @[]uint8 = make_slice(uint8, 5)
	var n int = formatBool(false, buf)
	if !bufEq(buf, n, "false") {
		return fail("formatBool(false) wrong")
	}
	return ""
}

// ============================================================
// Itoa
// ============================================================

func TestItoaZero() testing.TestResult {
	var s @[]char = Itoa(0)
	if len(s) != 1 || s[0] != '0' { return fail("Itoa(0) wrong") }
	return ""
}

func TestItoaPositive() testing.TestResult {
	var s @[]char = Itoa(12345)
	if len(s) != 5 { return fail("Itoa(12345) wrong len") }
	if s[0] != '1' || s[1] != '2' || s[2] != '3' || s[3] != '4' || s[4] != '5' {
		return fail("Itoa(12345) wrong digits")
	}
	return ""
}

// Itoa takes a host-width `int`, so int-min is the target's int-min
// (int32 on a 32-bit host) — computed from sizeof(int), since the
// int64 literal doesn't fit `int` there.  int-min triggers the
// `0 - v` overflow path.
func TestItoaIntMin() testing.TestResult {
	var shift uint = cast(uint, cast(int, sizeof(int)) * 8 - 1)
	var minInt int = cast(int, cast(uint, 1) << shift)
	var s @[]char = Itoa(minInt)
	var want *[]readonly char = "-9223372036854775808"
	if cast(int, sizeof(int)) == 4 { want = "-2147483648" }
	if len(s) != len(want) { return fail("Itoa(int-min) wrong len") }
	for i := 0; i < len(s); i++ {
		if s[i] != want[i] { return fail("Itoa(int-min) wrong digits") }
	}
	return ""
}
