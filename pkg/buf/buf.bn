package "pkg/buf"

// INITIAL_CAP is the backing capacity allocated by New(). Tuned for
// short append chains; grow() doubles from here as needed.
const INITIAL_CAP int = 64

// New returns a CharBuf with a freshly allocated INITIAL_CAP backing
// and Len=0. Caller owns the returned managed-slice via the value.
func New() CharBuf {
	var b CharBuf
	b.Data = make_slice(char, INITIAL_CAP)
	b.Len = 0
	return b
}

// grow ensures room for needed more bytes, doubling capacity as needed.
// Returns the updated CharBuf (may have a new Data allocation if the
// old one was too small — previous subslices of Data remain valid but
// point to the old backing).
func grow(b CharBuf, needed int) CharBuf {
	var cap int = len(b.Data)
	if b.Len + needed <= cap {
		return b
	}
	// Double until sufficient
	var newCap int = cap
	if newCap == 0 {
		newCap = INITIAL_CAP
	}
	for newCap < b.Len + needed {
		newCap = newCap * 2
	}
	var newData @[]char = make_slice(char, newCap)
	// Copy existing data
	for i := 0; i < b.Len; i++ {
		newData[i] = b.Data[i]
	}
	b.Data = newData
	return b
}

// ============================================================
// Methods on CharBuf
// ============================================================

// WriteByte appends a single character to b, growing the backing if
// needed. Returns the (possibly grown) CharBuf.
func (b CharBuf) WriteByte(c char) CharBuf {
	b = grow(b, 1)
	b.Data[b.Len] = c
	b.Len = b.Len + 1
	return b
}

// WriteStr appends every byte of s to b. Returns the (possibly grown)
// CharBuf — caller must use the returned value for subsequent writes.
func (b CharBuf) WriteStr(s *[]const char) CharBuf {
	var n int = len(s)
	b = grow(b, n)
	for i := 0; i < n; i++ {
		b.Data[b.Len + i] = s[i]
	}
	b.Len = b.Len + n
	return b
}

// WriteInt appends the decimal representation of n (with leading '-' if
// negative). Returns the (possibly grown) CharBuf.
func (b CharBuf) WriteInt(n int) CharBuf {
	if n == 0 {
		return b.WriteByte('0')
	}
	var neg bool = false
	if n < 0 {
		neg = true
		n = 0 - n
	}
	// Write digits in reverse into a small buffer, then copy forward
	var digits [20]char
	var count int = 0
	for n > 0 {
		digits[count] = cast(char, n % 10 + cast(int, '0'))
		n = n / 10
		count = count + 1
	}
	if neg {
		b = b.WriteByte('-')
	}
	for i := count - 1; i >= 0; i-- {
		b = b.WriteByte(digits[i])
	}
	return b
}

// WriteHexByte appends v as two uppercase hex digits (e.g. 0xFF -> "FF").
// Only the low 8 bits of v are used. Returns the (possibly grown) CharBuf.
func (b CharBuf) WriteHexByte(v int) CharBuf {
	var hi int = (v / 16) % 16
	var lo int = v % 16
	if hi < 10 {
		b = b.WriteByte(cast(char, cast(int, '0') + hi))
	} else {
		b = b.WriteByte(cast(char, cast(int, 'A') + hi - 10))
	}
	if lo < 10 {
		b = b.WriteByte(cast(char, cast(int, '0') + lo))
	} else {
		b = b.WriteByte(cast(char, cast(int, 'A') + lo - 10))
	}
	return b
}

// Bytes returns the written portion as a managed subslice of the backing.
// The returned slice shares storage with the CharBuf — further writes to
// the CharBuf that trigger grow() will NOT invalidate the returned slice
// (grow allocates a new backing, leaving the old one alive via refcount),
// but they will diverge (the returned slice won't see new writes).
func (b CharBuf) Bytes() @[]char {
	if b.Len < len(b.Data) {
		return b.Data[0:b.Len]
	}
	return b.Data
}

// Len returns the number of bytes currently written into b (b.Len).
// May be less than len(b.Data) — the buffer is over-allocated for growth.
func (b CharBuf) Len() int {
	return b.Len
}

// Freeze copies the written bytes into a new, exactly-sized managed slice.
// Unlike Bytes, the returned slice is independent of the CharBuf's backing.
func (b CharBuf) Freeze() @[]char {
	var n int = b.Len
	var result @[]char = make_slice(char, n)
	var raw @[]char = b.Bytes()
	for i := 0; i < n; i++ {
		result[i] = raw[i]
	}
	return result
}

// ============================================================
// Free-function aliases (deprecated; will be removed as callers migrate)
// ============================================================


// CopyStr copies a raw slice into a new managed slice. The returned slice
// is independent of the input — safe to store in data structures.
func CopyStr(s *[]const char) @[]char {
	var n int = len(s)
	var result @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		result[i] = s[i]
	}
	return result
}
