package "pkg/builtins/lang"

import "pkg/binate/buf"
import "pkg/bootstrap"

// Canonical Stringer impls for every universe primitive.  Per
// `plan-primitives-impl-interfaces.md` Slice 2a, this is the
// stdlib carve-out's "out-of-the-box" support: importing
// pkg/builtins/lang makes `*Stringer` accept any primitive value, so a
// user-written `printIt(s *Stringer)` works for `int`,
// `bool`, etc. without per-type wrappers.
//
// Receivers are value (`int`, `bool`, ...) — these methods
// don't mutate the receiver and the natural shape mirrors
// the primitive's own value semantics.  iv dispatch goes
// through per-(R, M) thunks emitted by the IR-gen
// thunk-generation pass (see plan-primitives-impl-
// interfaces.md § "Interface-value dispatch and value
// receivers").

// ============================================================
// Signed integers
// ============================================================

// String formats an int in decimal.
func (x int) String() @[]char {
	return bootstrap.Itoa(x)
}

// String formats an int8 in decimal.
func (x int8) String() @[]char {
	return bootstrap.Itoa(cast(int, x))
}

// String formats an int16 in decimal.
func (x int16) String() @[]char {
	return bootstrap.Itoa(cast(int, x))
}

// String formats an int32 in decimal.
func (x int32) String() @[]char {
	return bootstrap.Itoa(cast(int, x))
}

// String formats an int64 in decimal.
func (x int64) String() @[]char {
	return bootstrap.Itoa(cast(int, x))
}

// ============================================================
// Unsigned integers
// ============================================================
//
// Itoa takes a signed int.  For uint values that fit in
// positive int range (< 2^63), the cast preserves the value.
// Values above 2^63 print as a (wrong) negative number — a
// known limitation of this first cut; a dedicated unsigned
// formatter is a follow-up if it bites.
//
// Note: char and byte are aliases of uint8 (TypChar() and
// TypByte() return the same singleton as TypUint8()), so the
// uint8 impl below covers all three.

// String formats a uint in decimal.
func (x uint) String() @[]char {
	return bootstrap.Itoa(cast(int, x))
}

// String formats a uint8 (also char / byte) in decimal.
func (x uint8) String() @[]char {
	return bootstrap.Itoa(cast(int, x))
}

// String formats a uint16 in decimal.
func (x uint16) String() @[]char {
	return bootstrap.Itoa(cast(int, x))
}

// String formats a uint32 in decimal.
func (x uint32) String() @[]char {
	return bootstrap.Itoa(cast(int, x))
}

// String formats a uint64 in decimal.
func (x uint64) String() @[]char {
	return bootstrap.Itoa(cast(int, x))
}

// ============================================================
// Booleans
// ============================================================

// String returns "true" or "false".
func (b bool) String() @[]char {
	if b {
		return buf.CopyStr("true")
	}
	return buf.CopyStr("false")
}

// ============================================================
// Floats
// ============================================================
//
// Defers to bootstrap.formatFloat (bootstrap-grade output —
// fixed-point integer.6digits for normal-magnitude values,
// mantissa*2^exponent fallback for very large or very small
// values).  Not %g-compatible; see bootstrap.bni notes.
// Allocates a fresh @[]char of the exact required length so
// the caller doesn't see trailing garbage.

// String formats a float32 via bootstrap's float formatter.
func (x float32) String() @[]char {
	return floatToCharSlice(cast(float64, x))
}

// String formats a float64 via bootstrap's float formatter.
func (x float64) String() @[]char {
	return floatToCharSlice(x)
}

// floatToCharSlice converts a float64 to a freshly-allocated
// @[]char via bootstrap.formatFloat, trimmed to the actual
// written length.  Helper for the float impls above.
func floatToCharSlice(x float64) @[]char {
	var b @[]uint8 = make_slice(uint8, 32)
	var n int = bootstrap.formatFloat(x, b)
	var s @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		s[i] = cast(char, b[i])
	}
	return s
}

// ============================================================
// Impl declarations
// ============================================================
//
// Each impl pairs a primitive with the Stringer interface.
// The cross-package vtable machinery
// (`plan-cross-package-interfaces.md`) emits the per-(R, I)
// vtable globals (e.g.,
// __ivt.bn_pkg_std__int__pkg_std__Stringer); the iv-dispatch
// thunks (Slice A of plan-primitives-impl-interfaces.md) sit
// in the slot to adapt the iv pointer-shape ABI to the value-
// receiver methods above.

impl int : Stringer
impl int8 : Stringer
impl int16 : Stringer
impl int32 : Stringer
impl int64 : Stringer
impl uint : Stringer
impl uint8 : Stringer
impl uint16 : Stringer
impl uint32 : Stringer
impl uint64 : Stringer
impl bool : Stringer
impl float32 : Stringer
impl float64 : Stringer
