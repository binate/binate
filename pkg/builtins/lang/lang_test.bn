package "pkg/builtins/lang"

import "pkg/builtins/testing"

// Direct unit-test coverage for the canonical Stringer impls
// shipped with pkg/builtins/lang.  End-to-end iv-dispatch coverage lives
// in the conformance suite (411_pkg_std_stringer); these
// tests exercise the value-receiver methods themselves via
// the named-type method-call path.

// streq compares two char slices for equality.  Test-local
// helper to avoid pulling in pkg/binate/buf or bootstrap.
func streq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// fail wraps a TestResult for readability.
func fail(msg @[]char) testing.TestResult {
	return msg
}

// ============================================================
// Integer impls
// ============================================================

func TestIntStringPositive() testing.TestResult {
	var x int = 42
	if !streq(x.String(), "42") {
		return fail("int 42 should format as \"42\"")
	}
	return ""
}

func TestIntStringZero() testing.TestResult {
	var x int = 0
	if !streq(x.String(), "0") {
		return fail("int 0 should format as \"0\"")
	}
	return ""
}

func TestIntStringNegative() testing.TestResult {
	var x int = -7
	if !streq(x.String(), "-7") {
		return fail("int -7 should format as \"-7\"")
	}
	return ""
}

func TestInt8String() testing.TestResult {
	var x int8 = 127
	if !streq(x.String(), "127") {
		return fail("int8 127 should format as \"127\"")
	}
	return ""
}

func TestInt32StringNegative() testing.TestResult {
	var x int32 = -2147483648
	if !streq(x.String(), "-2147483648") {
		return fail("int32 INT_MIN unexpected")
	}
	return ""
}

// ============================================================
// Unsigned-integer impls
// ============================================================

func TestUintString() testing.TestResult {
	var x uint = 100
	if !streq(x.String(), "100") {
		return fail("uint 100 should format as \"100\"")
	}
	return ""
}

func TestUint8String() testing.TestResult {
	var x uint8 = 255
	if !streq(x.String(), "255") {
		return fail("uint8 255 should format as \"255\"")
	}
	return ""
}

// ============================================================
// Bool impl
// ============================================================

func TestBoolStringTrue() testing.TestResult {
	var b bool = true
	if !streq(b.String(), "true") {
		return fail("bool true should format as \"true\"")
	}
	return ""
}

func TestBoolStringFalse() testing.TestResult {
	var b bool = false
	if !streq(b.String(), "false") {
		return fail("bool false should format as \"false\"")
	}
	return ""
}

// ============================================================
// Float impls
// ============================================================
//
// formatFloat output is bootstrap-grade (fixed-point integer.
// 6digits for normal-magnitude values).  We assert the leading
// digits, not the full string, so the tests don't drift if the
// formatter's tail changes.

func TestFloat64StringSimple() testing.TestResult {
	var x float64 = 3.0
	var s @[]char = x.String()
	if len(s) < 1 || s[0] != cast(char, '3') {
		return fail("float64 3.0 should start with '3'")
	}
	return ""
}

func TestFloat32StringNegative() testing.TestResult {
	var x float32 = -1.0
	var s @[]char = x.String()
	if len(s) < 1 || s[0] != cast(char, '-') {
		return fail("float32 -1.0 should start with '-'")
	}
	return ""
}
