package "pkg/builtins/lang"

import "pkg/builtins/testing"

// Unit coverage for the canonical Comparable / Hashable impls
// in order.bn.  End-to-end iv/direct-call coverage lives in
// the conformance suite (412_pkg_std_compare,
// 413_err_pkg_std_iv_compare); these tests exercise the
// value-receiver methods directly via the named-type
// method-call path.

// ============================================================
// Compare — integers
// ============================================================

func TestIntCompareLess() testing.TestResult {
	var a int = 3
	var b int = 5
	if a.Compare(b) != -1 {
		return fail("int 3.Compare(5) should be -1")
	}
	return ""
}

func TestIntCompareGreater() testing.TestResult {
	var a int = 5
	var b int = 3
	if a.Compare(b) != 1 {
		return fail("int 5.Compare(3) should be 1")
	}
	return ""
}

func TestIntCompareEqual() testing.TestResult {
	var a int = 7
	if a.Compare(a) != 0 {
		return fail("int 7.Compare(7) should be 0")
	}
	return ""
}

func TestInt32CompareNegatives() testing.TestResult {
	var a int32 = -5
	var b int32 = 5
	if a.Compare(b) != -1 {
		return fail("int32 -5.Compare(5) should be -1")
	}
	return ""
}

func TestUintCompare() testing.TestResult {
	var a uint = 100
	var b uint = 200
	if a.Compare(b) != -1 {
		return fail("uint 100.Compare(200) should be -1")
	}
	return ""
}

// ============================================================
// Compare — bool (false < true)
// ============================================================

func TestBoolCompareFalseLess() testing.TestResult {
	var a bool = false
	var b bool = true
	if a.Compare(b) != -1 {
		return fail("bool false.Compare(true) should be -1")
	}
	return ""
}

func TestBoolCompareTrueGreater() testing.TestResult {
	var a bool = true
	var b bool = false
	if a.Compare(b) != 1 {
		return fail("bool true.Compare(false) should be 1")
	}
	return ""
}

func TestBoolCompareEqual() testing.TestResult {
	var a bool = true
	if a.Compare(a) != 0 {
		return fail("bool true.Compare(true) should be 0")
	}
	return ""
}

// ============================================================
// Compare — floats
// ============================================================

func TestFloat64CompareLess() testing.TestResult {
	var a float64 = 1.5
	var b float64 = 2.5
	if a.Compare(b) != -1 {
		return fail("float64 1.5.Compare(2.5) should be -1")
	}
	return ""
}

func TestFloat64CompareEqual() testing.TestResult {
	var a float64 = 3.14
	if a.Compare(a) != 0 {
		return fail("float64 3.14.Compare(3.14) should be 0")
	}
	return ""
}

// ============================================================
// Hash — consistency with Compare equality
// ============================================================

func TestIntHashConsistent() testing.TestResult {
	var a int = 42
	var b int = 42
	if a.Hash() != b.Hash() {
		return fail("equal ints should hash to the same value")
	}
	return ""
}

func TestIntHashDistinct() testing.TestResult {
	var a int = 42
	var b int = 43
	if a.Hash() == b.Hash() {
		return fail("distinct small ints should hash differently (trivial-cast impl)")
	}
	return ""
}

func TestBoolHashDistinct() testing.TestResult {
	var t bool = true
	var f bool = false
	if t.Hash() == f.Hash() {
		return fail("true and false should hash differently")
	}
	return ""
}

func TestBoolHashConsistent() testing.TestResult {
	var t1 bool = true
	var t2 bool = true
	if t1.Hash() != t2.Hash() {
		return fail("two `true`s should hash the same")
	}
	return ""
}

func TestFloat64HashConsistent() testing.TestResult {
	var a float64 = 1.5
	var b float64 = 1.5
	if a.Hash() != b.Hash() {
		return fail("equal float64s should hash to the same value")
	}
	return ""
}
