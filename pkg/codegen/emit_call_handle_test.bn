package "pkg/codegen"

import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/types"

// Tests for emitCallHandle (the OP_CALL_HANDLE lowering in
// emit_call_handle.bn).

// TestEmitCallHandleVoid checks the LLVM lowering of OP_CALL_HANDLE for
// a void-returning call with one i64 argument.  Expected shape: load
// the handle's data and vtable.call slots, bitcast the call slot to a
// `void(i8*, i64)*` fn ptr, and invoke `<fn>(data, arg)`.
func TestEmitCallHandleVoid() testing.TestResult {
	setTarget64()
	var m @ir.Module = ir.NewModule("\"main\"")

	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("caller", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var handle @ir.Instr = entry.EmitConstNil(rawPtrTyp)
	var arg @ir.Instr = entry.EmitConstInt(42, types.TypInt())
	var callArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	callArgs[0] = arg
	entry.EmitCallHandle(handle, callArgs, types.TypVoid())

	var noRetArgs @[]@ir.Instr
	entry.EmitReturn(noRetArgs)

	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if !contains(out, "bitcast i8* %") {
		return fail("expected bitcast of handle to %BnFuncValue*")
	}
	if !contains(out, "to %BnFuncValue*") {
		return fail("expected bitcast target %BnFuncValue*")
	}
	if !contains(out, "getelementptr inbounds %BnFuncValue") {
		return fail("expected GEP into %BnFuncValue for data/vtable")
	}
	if !contains(out, "to %BnVtable*") {
		return fail("expected vtable bitcast to %BnVtable*")
	}
	if !contains(out, "to void(i8*, i64)*") {
		return fail("expected fn-ptr bitcast `void(i8*, i64)*`")
	}
	if !contains(out, "call void %") {
		return fail("expected indirect call through register")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitCallHandleInt covers the int-returning path: the call is
// assigned to a value register and the bitcast target carries the int
// return type.
func TestEmitCallHandleInt() testing.TestResult {
	setTarget64()
	var m @ir.Module = ir.NewModule("\"main\"")

	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("caller", noParams, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var handle @ir.Instr = entry.EmitConstNil(rawPtrTyp)
	var noArgs @[]@ir.Instr
	var result @ir.Instr = entry.EmitCallHandle(handle, noArgs, types.TypInt())

	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = result
	entry.EmitReturn(retArgs)

	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if !contains(out, "to i64(i8*)*") {
		return fail("expected fn-ptr bitcast `i64(i8*)*`")
	}
	if !contains(out, "= call i64 %") {
		return fail("expected int-returning indirect call")
	}
	var pass testing.TestResult
	return pass
}
