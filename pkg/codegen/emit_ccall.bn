package "pkg/codegen"

import "pkg/buf"
import "pkg/ir"
import "pkg/types"

// ============================================================
// __c_call lowering (Stage 1: fixed-arg, scalar/pointer args + return)
// ============================================================
//
// OP_C_CALL emits `<%vID> = call <ret> @<symbol>(<args>)` with the
// symbol verbatim (NOT mangled — `instr.StrVal` already holds the raw
// C symbol). The type checker restricts Stage 1 to scalar/pointer
// return + args and rejects variadic calls, so the lowering here can
// stay simple: no sret, no varargs sig, no struct-by-value handling.
// Each of those is a planned follow-on stage of
// explorations/plan-c-call.md.

// emitCCall emits LLVM IR for an OP_C_CALL instruction.
func emitCCall(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	// Emit width-cast preludes for any arg whose SSA value's LLVM
	// width differs from its declared type — mirrors emitCall.
	for i := 0; i < len(instr.Args); i++ {
		var argBits int = llvmTypeBits(instr.Args[i])
		var declBits int = typeBits(instr.Args[i].Typ)
		if argBits != declBits && argBits > 0 && declBits > 0 {
			out = out.WriteStr("%v")
			out = out.WriteInt(instr.ID)
			out = out.WriteStr(".a")
			out = out.WriteInt(i)
			if argBits > declBits {
				out = out.WriteStr(" = trunc ")
			} else {
				out = out.WriteStr(" = zext ")
			}
			out = out.WriteStr(llvmTypeForBits(argBits))
			out = out.WriteByte(' ')
			out = emitRef(out, instr.Args[i].ID)
			out = out.WriteStr(" to ")
			out = out.WriteStr(llvmTypeForBits(declBits))
			out = out.WriteStr("\n  ")
		}
	}

	// `%vID = call <ret> @<symbol>(<args>)`.  Stage-1 checker
	// enforces a scalar/pointer return, so no void/sret arm here.
	out = emitRef(out, instr.ID)
	out = out.WriteStr(" = call ")
	out = out.WriteStr(llvmType(instr.Typ))
	out = out.WriteStr(" @")
	out = out.WriteStr(instr.StrVal)
	out = out.WriteByte('(')
	for i := 0; i < len(instr.Args); i++ {
		if i > 0 { out = out.WriteStr(", ") }
		var argBits int = llvmTypeBits(instr.Args[i])
		var declBits int = typeBits(instr.Args[i].Typ)
		out = out.WriteStr(llvmType(instr.Args[i].Typ))
		out = out.WriteByte(' ')
		if argBits != declBits && argBits > 0 && declBits > 0 {
			out = out.WriteStr("%v")
			out = out.WriteInt(instr.ID)
			out = out.WriteStr(".a")
			out = out.WriteInt(i)
		} else {
			out = emitRef(out, instr.Args[i].ID)
		}
	}
	out = out.WriteStr(")\n")
	return out
}

// emitCCallDeclares emits `declare <ret> @<symbol>(<argtypes>)` for
// every distinct C symbol referenced by an OP_C_CALL in the module.
// Called from emitModule's preamble alongside the extern-function loop
// and the implicit-libc-Memcpy declare.
func emitCCallDeclares(out buf.CharBuf, m @ir.Module) buf.CharBuf {
	var seen @[]@[]char
	for fi := 0; fi < len(m.Funcs); fi++ {
		var f @ir.Func = m.Funcs[fi]
		if f.IsExtern { continue }
		for bi := 0; bi < len(f.Blocks); bi++ {
			var b @ir.Block = f.Blocks[bi]
			for ii := 0; ii < len(b.Instrs); ii++ {
				var ins @ir.Instr = b.Instrs[ii]
				if ins.Op != ir.OP_C_CALL { continue }
				if cCallSymbolSeen(seen, ins.StrVal) { continue }
				seen = appendCCallSymbol(seen, ins.StrVal)
				out = emitCCallDeclare(out, ins)
			}
		}
	}
	return out
}

// emitCCallDeclare writes one `declare` line for the OP_C_CALL.  The
// signature is reconstructed from the instr's arg types and return
// type (the same data codegen uses to emit the call itself).
func emitCCallDeclare(out buf.CharBuf, ins @ir.Instr) buf.CharBuf {
	out = out.WriteStr("declare ")
	out = out.WriteStr(llvmType(ins.Typ))
	out = out.WriteStr(" @")
	out = out.WriteStr(ins.StrVal)
	out = out.WriteByte('(')
	for i := 0; i < len(ins.Args); i++ {
		if i > 0 { out = out.WriteStr(", ") }
		out = out.WriteStr(llvmType(ins.Args[i].Typ))
	}
	out = out.WriteStr(")\n")
	return out
}

// cCallSymbolSeen reports whether sym is already in the per-module
// dedup list of declared C symbols built up by emitCCallDeclares.
func cCallSymbolSeen(seen @[]@[]char, sym @[]char) bool {
	for i := 0; i < len(seen); i++ {
		if cCallStrEq(seen[i], sym) { return true }
	}
	return false
}

// appendCCallSymbol returns seen with sym appended; used to grow the
// dedup list by one symbol per distinct OP_C_CALL callee.
func appendCCallSymbol(seen @[]@[]char, sym @[]char) @[]@[]char {
	var n int = len(seen)
	var grown @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { grown[i] = seen[i] }
	grown[n] = sym
	return grown
}

// cCallStrEq compares two C-symbol names for exact byte equality.  A
// tiny local helper to keep emit_ccall.bn free of cross-package
// dependencies (pkg/codegen's other string-compare helpers live with
// their consumers).
func cCallStrEq(a @[]char, b @[]char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
