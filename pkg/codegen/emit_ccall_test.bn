package "pkg/codegen"

import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/types"

// Tests for emit_ccall.bn — the OP_C_CALL LLVM lowering used by the
// __c_call intrinsic.  Covers:
//   * the emitted call uses the raw (UN-mangled) symbol name,
//   * each distinct C symbol gets exactly one extern `declare`,
//   * the small per-module dedup helpers behave as documented.

// emitCCall must emit `<%vID> = call <ret> @<rawSym>(<args>)` with the
// symbol VERBATIM — no `bn_<pkg>__` mangling.  This is the property
// that distinguishes __c_call from every other call op in codegen.
func TestEmitCCallEmitsRawSymbol() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt32()
	var f @ir.Func = ir.NewFunc("caller", noParams, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	// __c_call("abs", int32, cast(int32, -42))
	var argInt @ir.Instr = entry.EmitConstInt(-42, types.TypInt32())
	var ccArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	ccArgs[0] = argInt
	var ret @ir.Instr = entry.EmitCCall("abs", ccArgs, types.TypInt32(), 1)

	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = ret
	entry.EmitReturn(retArgs)
	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if !contains(out, "call i32 @abs(") {
		return fail("expected verbatim `call i32 @abs(...)` (no mangling)")
	}
	// Make sure we are NOT routing through the bn_<pkg>__ mangler —
	// any leak of `bn_main__abs` or similar would mean the dedicated
	// emit path silently fell back to the normal OP_CALL lowering.
	if contains(out, "bn_main__abs") {
		return fail("`abs` must not be name-mangled by __c_call lowering")
	}
	return ""
}

// Each distinct C symbol referenced in the module must get exactly
// one `declare <ret> @<sym>(<argtypes>)`.  emitCCallDeclares dedupes,
// so calling `abs` twice still yields a single declare.
func TestEmitCCallDeclaresAreDeduped() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("caller", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var a1 @ir.Instr = entry.EmitConstInt(1, types.TypInt32())
	var a2 @ir.Instr = entry.EmitConstInt(2, types.TypInt32())
	var args1 @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args1[0] = a1
	var args2 @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args2[0] = a2
	entry.EmitCCall("abs", args1, types.TypInt32(), 1)
	entry.EmitCCall("abs", args2, types.TypInt32(), 1)

	var noRet @[]@ir.Instr
	entry.EmitReturn(noRet)
	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if !contains(out, "declare i32 @abs(i32)") {
		return fail("expected `declare i32 @abs(i32)` line")
	}
	if countOccurrences(out, "declare i32 @abs(") != 1 {
		return fail("expected exactly one declare for `abs` (dedup)")
	}
	return ""
}

// Different symbols must each get their own declare; ensures the
// dedup is keyed by symbol, not "any C call seen".
func TestEmitCCallDeclaresKeyedBySymbol() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("caller", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var a @ir.Instr = entry.EmitConstInt(1, types.TypInt32())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = a
	entry.EmitCCall("abs", args, types.TypInt32(), 1)
	entry.EmitCCall("labs", args, types.TypInt32(), 1)

	var noRet @[]@ir.Instr
	entry.EmitReturn(noRet)
	m.AddFunc(f)

	var out @[]char = EmitModule(m)
	if !contains(out, "declare i32 @abs(") {
		return fail("expected declare for `abs`")
	}
	if !contains(out, "declare i32 @labs(") {
		return fail("expected declare for `labs`")
	}
	return ""
}

// Direct unit test for cCallStrEq — exercises the equal, unequal,
// and length-mismatch branches.
func TestCCallStrEq() testing.TestResult {
	if !cCallStrEq("abs", "abs") { return fail("equal strings should compare equal") }
	if cCallStrEq("abs", "ABS")  { return fail("case-different strings must not compare equal") }
	if cCallStrEq("abs", "absx") { return fail("length-mismatched strings must not compare equal") }
	if cCallStrEq("", "")        { } else { return fail("empty strings should compare equal") }
	return ""
}

// cCallSymbolSeen + appendCCallSymbol together implement the
// per-module dedup; both ends of the contract matter (Seen reports
// presence; Append actually grows the list so Seen flips to true).
func TestCCallSymbolDedup() testing.TestResult {
	var seen @[]@[]char
	if cCallSymbolSeen(seen, "abs") {
		return fail("empty list should not report `abs` seen")
	}
	seen = appendCCallSymbol(seen, "abs")
	if !cCallSymbolSeen(seen, "abs") {
		return fail("after Append, Seen should report `abs` present")
	}
	if cCallSymbolSeen(seen, "labs") {
		return fail("Seen must not false-positive a different symbol")
	}
	seen = appendCCallSymbol(seen, "labs")
	if len(seen) != 2 {
		return fail("Append should grow the list by one each call")
	}
	return ""
}

// countOccurrences counts non-overlapping occurrences of needle in
// haystack — small local helper used to verify the declare-dedup
// invariant (exactly one occurrence).
func countOccurrences(haystack *[]const char, needle *[]const char) int {
	if len(needle) == 0 || len(haystack) < len(needle) { return 0 }
	var n int = 0
	var i int = 0
	for i <= len(haystack) - len(needle) {
		var match bool = true
		for j := 0; j < len(needle); j++ {
			if haystack[i + j] != needle[j] { match = false; break }
		}
		if match { n = n + 1; i = i + len(needle) } else { i = i + 1 }
	}
	return n
}
