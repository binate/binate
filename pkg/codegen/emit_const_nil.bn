package "pkg/codegen"

import "pkg/buf"
import "pkg/ir"
import "pkg/types"

// emitConstNil emits a nil constant (zeroinitializer for slices, null for pointers).
func emitConstNil(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	if instr.Typ != nil && instr.Typ.Kind == types.TYP_SLICE {
		// Nil raw slice: alloca, store zeroinitializer, load back
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a = alloca %BnSlice\n")
		out = out.WriteStr("  store %BnSlice zeroinitializer, %BnSlice* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		out = out.WriteStr("  ")
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = load %BnSlice, %BnSlice* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		return out
	}
	if instr.Typ != nil && instr.Typ.Kind == types.TYP_MANAGED_SLICE {
		// Nil managed slice: alloca, store zeroinitializer, load back
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a = alloca %BnManagedSlice\n")
		out = out.WriteStr("  store %BnManagedSlice zeroinitializer, %BnManagedSlice* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		out = out.WriteStr("  ")
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = load %BnManagedSlice, %BnManagedSlice* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		return out
	}
	if instr.Typ != nil &&
		(instr.Typ.Kind == types.TYP_FUNC_VALUE ||
			instr.Typ.Kind == types.TYP_MANAGED_FUNC_VALUE) {
		// Nil function value: alloca, store zeroinitializer, load back.
		// Same idiom as the slice arms above; the LLVM type is the
		// uniform %BnFuncValue regardless of the function signature.
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a = alloca %BnFuncValue\n")
		out = out.WriteStr("  store %BnFuncValue zeroinitializer, %BnFuncValue* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		out = out.WriteStr("  ")
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = load %BnFuncValue, %BnFuncValue* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		return out
	}
	if instr.Typ != nil &&
		(instr.Typ.Kind == types.TYP_INTERFACE_VALUE ||
			instr.Typ.Kind == types.TYP_INTERFACE_VALUE_MANAGED) {
		// Nil interface value: alloca, store zeroinitializer, load
		// back. Same idiom as the func-value arm above; the LLVM
		// type is the uniform %BnIfaceValue regardless of the
		// interface's method set. Without this, `var iv *I` (no
		// init) leaves the alloca undef, and the optimizer is free
		// to misbehave on the subsequent dispatch — defining the
		// no-init form to be all-zeros makes nil-iface dispatch a
		// deterministic SEGV rather than UB.
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a = alloca %BnIfaceValue\n")
		out = out.WriteStr("  store %BnIfaceValue zeroinitializer, %BnIfaceValue* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		out = out.WriteStr("  ")
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = load %BnIfaceValue, %BnIfaceValue* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		return out
	}
	if instr.Typ != nil &&
		(instr.Typ.Kind == types.TYP_STRUCT ||
			instr.Typ.Kind == types.TYP_ARRAY ||
			(instr.Typ.Kind == types.TYP_NAMED && instr.Typ.Underlying != nil)) {
		// Nil struct/array: alloca, store zeroinitializer, load back
		var ty @[]char = llvmType(instr.Typ)
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a = alloca ")
		out = out.WriteStr(ty)
		out = out.WriteByte('\n')
		out = out.WriteStr("  store ")
		out = out.WriteStr(ty)
		out = out.WriteStr(" zeroinitializer, ")
		out = out.WriteStr(ty)
		out = out.WriteStr("* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		out = out.WriteStr("  ")
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = load ")
		out = out.WriteStr(ty)
		out = out.WriteStr(", ")
		out = out.WriteStr(ty)
		out = out.WriteStr("* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		return out
	}
	out = emitRef(out, instr.ID)
	out = out.WriteStr(" = inttoptr ")
	out = out.WriteStr(intLL())
	out = out.WriteStr(" 0 to i8*\n")
	return out
}
