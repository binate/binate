package "pkg/codegen"

import "pkg/buf"
import "pkg/ir"
import "pkg/types"

// ============================================================
// Function emission
// ============================================================

// emitFuncDbg emits an LLVM function definition with optional DWARF debug annotations.
func emitFuncDbg(
	out buf.CharBuf, f @ir.Func,
	strings *[]ir.StringConst,
	funcRetTypes *[]FuncRetType,
	dbgSubprogramID int,
) buf.CharBuf {
	if f.IsExtern {
		return out
	}

	retSeq = 0
	tmpSeq = 0

	// define <rettype> @<name>(<params>) [!dbg !N] {
	var retTyp @[]char
	if len(f.Results) == 0 {
		retTyp = "void"
	} else if len(f.Results) == 1 {
		retTyp = llvmType(f.Results[0])
	} else {
		retTyp = multiReturnType(f.Results)
	}

	if f.IsLinkOnce {
		// weak_odr: same merge semantics as linkonce_odr, but cannot be
		// discarded when locally unreferenced.  Required for cross-TU dtor /
		// copy helpers — at -O2 the optimizer would otherwise DCE the
		// definition in its home TU after inlining all local callers, leaving
		// extern references in other TUs unresolved.
		out = out.WriteStr("define weak_odr ")
	} else {
		out = out.WriteStr("define ")
	}
	out = out.WriteStr(retTyp)
	out = out.WriteStr(" @")
	out = writeBuf(out, mangle.FuncName(modulePkgName,f.Name))
	out = out.WriteByte('(')

	for i := 0; i < len(f.Params); i++ {
		if i > 0 {
			out = out.WriteStr(", ")
		}
		out = out.WriteStr(llvmType(f.Params[i].Typ))
		out = out.WriteByte(' ')
		out = emitRef(out, f.Params[i].ID)
	}

	if dbgSubprogramID >= 0 {
		out = out.WriteStr(") !dbg !")
		out = out.WriteInt(dbgSubprogramID)
		out = out.WriteStr(" {\n")
	} else {
		out = out.WriteStr(") {\n")
	}

	// Build function body with per-instruction debug locations.
	// All OP_ALLOC decls are hoisted to the top of the entry block
	// so that allocas inside loop bodies don't leak native stack
	// per iteration. The zero-init store for struct/array allocas
	// stays at the original location (so each visit re-zeroes the
	// slot), and llvm.dbg.declare likewise stays in place.
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = f.Blocks[i]
		if i > 0 {
			out = out.WriteByte('\n')
		}
		out = out.WriteStr(blk.Label)
		out = out.WriteStr(":\n")
		// Hoist all allocas to the top of the entry block.
		if i == 0 {
			for hi := 0; hi < len(f.Blocks); hi++ {
				var hblk @ir.Block = f.Blocks[hi]
				for hj := 0; hj < len(hblk.Instrs); hj++ {
					var hinstr @ir.Instr = hblk.Instrs[hj]
					if hinstr.Op != ir.OP_ALLOC { continue }
					out = emitAllocDecl(out, hinstr)
					if dbgSubprogramID >= 0 {
						var hline int = hinstr.Line
						if hline <= 0 { hline = 1 }
						out = addDbgToLastLine(out, hline, dbgSubprogramID)
					}
				}
			}
		}
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			out = emitInstr(out, instr, strings, funcRetTypes)
			// Append !dbg with real line number if debug info is enabled.
			// For OP_ALLOC, emitAlloc now emits only the zero-init store
			// (or nothing for non-struct/array), so we only add !dbg if
			// something was actually emitted.
			if dbgSubprogramID >= 0 {
				var line int = instr.Line
				if line <= 0 { line = 1 }
				if instr.Op == ir.OP_ALLOC {
					var needsZero bool = instr.TypeArg != nil &&
						(instr.TypeArg.Kind == types.TYP_STRUCT ||
							instr.TypeArg.Kind == types.TYP_ARRAY)
					if needsZero {
						out = addDbgToLastLine(out, line, dbgSubprogramID)
					}
				} else {
					out = addDbgToLastLine(out, line, dbgSubprogramID)
				}
				// Emit llvm.dbg.declare for named allocas
				if instr.Op == ir.OP_ALLOC && len(instr.StrVal) > 0 {
					out = emitDbgDeclare(out, instr, dbgSubprogramID, line)
				}
			}
		}
	}

	out = out.WriteStr("}\n")
	return out
}

// addDbgToLastLine replaces the trailing newline of the last emitted line
// with ", !dbg !DILocation(line: N, scope: !M)\n".
func addDbgToLastLine(out buf.CharBuf, line int, scopeID int) buf.CharBuf {
	// The last character in out should be '\n' from emitInstr.
	// Decrement Len to remove it, then append dbg + newline.
	if out.Len > 0 {
		out.Len = out.Len - 1
	}
	out = out.WriteStr(", !dbg !DILocation(line: ")
	out = out.WriteInt(line)
	out = out.WriteStr(", scope: !")
	out = out.WriteInt(scopeID)
	out = out.WriteStr(")\n")
	return out
}

// emitDbgDeclare emits a call to @llvm.dbg.declare for a named alloca.
func emitDbgDeclare(out buf.CharBuf, instr @ir.Instr, scopeID int, line int) buf.CharBuf {
	// call void @llvm.dbg.declare(metadata <type>* %vN,
	//   metadata !DILocalVariable(...),
	//   metadata !DIExpression()), !dbg !DILocation(...)
	var allocTyp @[]char = llvmType(instr.TypeArg)
	out = out.WriteStr("  call void @llvm.dbg.declare(metadata ")
	out = out.WriteStr(allocTyp)
	out = out.WriteStr("* ")
	out = emitRef(out, instr.ID)
	out = out.WriteStr(", metadata !DILocalVariable(name: \"")
	out = out.WriteStr(instr.StrVal)
	out = out.WriteStr("\", scope: !")
	out = out.WriteInt(scopeID)
	out = out.WriteStr(", file: !3, line: ")
	out = out.WriteInt(line)
	out = out.WriteStr(", type: !5)")
	out = out.WriteStr(", metadata !DIExpression())")
	out = out.WriteStr(", !dbg !DILocation(line: ")
	out = out.WriteInt(line)
	out = out.WriteStr(", scope: !")
	out = out.WriteInt(scopeID)
	out = out.WriteStr(")\n")
	return out
}

// addDbgAnnotations inserts dbgRef (e.g., ", !dbg !6") before the newline
// on every instruction line (lines starting with a space character).
// Writes directly into out.
func addDbgAnnotations(out buf.CharBuf, body *[]const char, dbgRef *[]const char) buf.CharBuf {
	var lineStart int = 0
	for i := 0; i < len(body); i++ {
		if body[i] == '\n' {
			var isInstr bool = lineStart < i && body[lineStart] == ' '
			out = out.WriteStr(body[lineStart:i])
			if isInstr {
				out = out.WriteStr(dbgRef)
			}
			out = out.WriteByte('\n')
			lineStart = i + 1
		}
	}
	// Copy any trailing content without newline
	if lineStart < len(body) {
		out = out.WriteStr(body[lineStart:len(body)])
	}
	return out
}

// emitDebugMetadata appends DWARF debug metadata nodes to the module output.
// Uses LineTablesOnly emission for lightweight function-level debug info.
func emitDebugMetadata(out buf.CharBuf, m @ir.Module, dbgFuncIDs *[]int) buf.CharBuf {
	var modName *[]const char = stripQuotes(m.Name)

	// Named metadata
	out = out.WriteStr("!llvm.dbg.cu = !{!0}\n")
	out = out.WriteStr("!llvm.module.flags = !{!1, !2}\n\n")

	// !0 = DICompileUnit
	out = out.WriteStr("!0 = distinct !DICompileUnit(")
	out = out.WriteStr("language: DW_LANG_C99, file: !3, ")
	out = out.WriteStr("producer: \"binate\", ")
	out = out.WriteStr("isOptimized: false, ")
	out = out.WriteStr("runtimeVersion: 0, ")
	out = out.WriteStr("emissionKind: FullDebug)\n")

	// !1 = Dwarf Version flag
	out = out.WriteStr("!1 = !{i32 7, !\"Dwarf Version\", i32 4}\n")

	// !2 = Debug Info Version flag
	out = out.WriteStr("!2 = !{i32 2, !\"Debug Info Version\", i32 3}\n")

	// !3 = DIFile
	out = out.WriteStr("!3 = !DIFile(filename: \"")
	out = out.WriteStr(modName)
	out = out.WriteStr(".bn\", directory: \".\")\n")

	// !4 = DISubroutineType (shared, generic)
	out = out.WriteStr("!4 = !DISubroutineType(types: !{})\n")

	// !5 = DIBasicType for i64 (generic type for all variables)
	out = out.WriteStr("!5 = !DIBasicType(name: \"int\", size: 64, encoding: DW_ATE_signed)\n")

	// Emit DISubprogram + DILocation for each non-extern function
	for i := 0; i < len(m.Funcs); i++ {
		if dbgFuncIDs[i] < 0 {
			continue
		}
		var f @ir.Func = m.Funcs[i]
		var spID int = dbgFuncIDs[i]
		var locID int = spID + 1

		// DISubprogram
		out = out.WriteByte('!')
		out = out.WriteInt(spID)
		out = out.WriteStr(" = distinct !DISubprogram(name: \"")
		out = out.WriteStr(f.Name)
		out = out.WriteStr("\", linkageName: \"")
		out = writeBuf(out, mangle.FuncName(modulePkgName,f.Name))
		out = out.WriteStr("\", scope: !3, file: !3, ")
		out = out.WriteStr("line: 0, type: !4, scopeLine: 0, ")
		out = out.WriteStr("spFlags: DISPFlagDefinition, ")
		out = out.WriteStr("unit: !0)\n")

		// DILocation entries are now emitted inline on each instruction.
		// Keep the metadata slot reserved for ID numbering consistency.
		out = out.WriteByte('!')
		out = out.WriteInt(locID)
		out = out.WriteStr(" = !DILocation(line: 0, scope: !")
		out = out.WriteInt(spID)
		out = out.WriteStr(")\n")
	}

	return out
}

