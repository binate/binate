package "pkg/codegen"

import "pkg/ast"
import "pkg/buf"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/parser"
import "pkg/types"

// Tests for DWARF debug metadata emission.

func TestEmitDebugMetadata() testing.TestResult {
	SetDebugInfo(true)
	var src *[]const char = "package \"main\"\nfunc main() { println(1) }\n"
	var out @[]char = compileToLLVM(src)
	SetDebugInfo(false)
	if !contains(out, "!DICompileUnit") {
		return fail("expected DICompileUnit in debug output")
	}
	if !contains(out, "!DISubprogram") {
		return fail("expected DISubprogram in debug output")
	}
	var pass testing.TestResult
	return pass
}

func TestEmitNoDebugByDefault() testing.TestResult {
	SetDebugInfo(false)
	var src *[]const char = "package \"main\"\nfunc main() { println(1) }\n"
	var out @[]char = compileToLLVM(src)
	if contains(out, "!DICompileUnit") {
		return fail("should not emit debug info when disabled")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitDebugDoesNotAnnotateLabels guards against a regression where
// addDbgToLastLine appended `, !dbg !DILocation(...)` to the last line
// of multi-line emissions like emitRefIncInline / emitRefDecInline,
// which end on a basic-block label (e.g., "ri.0.skip:"). LLVM rejects
// `<label>:, !dbg !N` as invalid IR. Source: any program exercising
// OP_REFINC or OP_REFDEC under -g — i.e., any managed-pointer usage.
// TestDbgTypeIDScalars verifies the kind/width/signed → metadata-id
// mapping that emitDbgDeclare uses. These IDs must agree with the
// DIBasicType slots emitted by emitDebugMetadata.
func TestDbgTypeIDScalars() testing.TestResult {
	if dbgTypeID(types.TypInt()) != 5 {
		return fail("int → !5")
	}
	if dbgTypeID(types.TypInt8()) != 6 {
		return fail("int8 → !6")
	}
	if dbgTypeID(types.TypInt16()) != 7 {
		return fail("int16 → !7")
	}
	if dbgTypeID(types.TypInt32()) != 8 {
		return fail("int32 → !8")
	}
	if dbgTypeID(types.TypInt64()) != 5 {
		return fail("int64 → !5 (shares signed-64 slot with int)")
	}
	if dbgTypeID(types.TypUint()) != 9 {
		return fail("uint → !9")
	}
	if dbgTypeID(types.TypUint8()) != 10 {
		return fail("uint8 → !10")
	}
	if dbgTypeID(types.TypChar()) != 10 {
		return fail("char (uint8 alias) → !10")
	}
	if dbgTypeID(types.TypUint16()) != 11 {
		return fail("uint16 → !11")
	}
	if dbgTypeID(types.TypUint32()) != 12 {
		return fail("uint32 → !12")
	}
	if dbgTypeID(types.TypUint64()) != 9 {
		return fail("uint64 → !9 (shares unsigned-64 slot with uint)")
	}
	if dbgTypeID(types.TypFloat32()) != 13 {
		return fail("float32 → !13")
	}
	if dbgTypeID(types.TypFloat64()) != 14 {
		return fail("float64 → !14")
	}
	if dbgTypeID(types.TypBool()) != 15 {
		return fail("bool → !15")
	}
	// Non-scalar fallback: a managed-slice type stays on the legacy
	// !5 slot until step 4 lands proper DICompositeType emission.
	if dbgTypeID(types.MakeManagedSliceType(types.TypInt())) != 5 {
		return fail("non-scalar fallback → !5")
	}
	// TYP_NAMED (e.g. `type Pos int`) is also non-scalar from
	// dbgTypeID's perspective — Underlying isn't peeled. Pinned
	// here so step 4 (DIDerivedType for typedefs) has to come
	// update this test as part of the fix.
	if dbgTypeID(types.MakeNamedType("Pos")) != 5 {
		return fail("named type → !5 (typedef coverage is step 4)")
	}
	if dbgTypeID(nil) != 5 {
		return fail("nil → !5")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitDebugBasicTypesEmitted verifies emitDebugMetadata writes the
// full DIBasicType bank (one node per scalar kind) so emitDbgDeclare's
// type IDs always resolve. Pinned with the encoding strings — those
// determine how lldb/gdb format the values.
func TestEmitDebugBasicTypesEmitted() testing.TestResult {
	SetDebugInfo(true)
	var src *[]const char = "package \"main\"\nfunc main() { println(1) }\n"
	var out @[]char = compileToLLVM(src)
	SetDebugInfo(false)
	if !contains(out, "!DIBasicType(name: \"int\", size: 64, encoding: DW_ATE_signed)") {
		return fail("expected int DIBasicType node")
	}
	if !contains(out, "!DIBasicType(name: \"int8\", size: 8, encoding: DW_ATE_signed)") {
		return fail("expected int8 DIBasicType node")
	}
	if !contains(out, "!DIBasicType(name: \"int16\", size: 16, encoding: DW_ATE_signed)") {
		return fail("expected int16 DIBasicType node")
	}
	if !contains(out, "!DIBasicType(name: \"int32\", size: 32, encoding: DW_ATE_signed)") {
		return fail("expected int32 DIBasicType node")
	}
	if !contains(out, "!DIBasicType(name: \"uint\", size: 64, encoding: DW_ATE_unsigned)") {
		return fail("expected uint DIBasicType node")
	}
	if !contains(out, "!DIBasicType(name: \"uint8\", size: 8, encoding: DW_ATE_unsigned_char)") {
		return fail("expected uint8 DIBasicType node")
	}
	if !contains(out, "!DIBasicType(name: \"uint16\", size: 16, encoding: DW_ATE_unsigned)") {
		return fail("expected uint16 DIBasicType node")
	}
	if !contains(out, "!DIBasicType(name: \"uint32\", size: 32, encoding: DW_ATE_unsigned)") {
		return fail("expected uint32 DIBasicType node")
	}
	if !contains(out, "!DIBasicType(name: \"float32\", size: 32, encoding: DW_ATE_float)") {
		return fail("expected float32 DIBasicType node")
	}
	if !contains(out, "!DIBasicType(name: \"float64\", size: 64, encoding: DW_ATE_float)") {
		return fail("expected float64 DIBasicType node")
	}
	if !contains(out, "!DIBasicType(name: \"bool\", size: 8, encoding: DW_ATE_boolean)") {
		return fail("expected bool DIBasicType node")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitDebugFuncIDBase pins the slot id where per-function
// DISubprogram metadata starts. Slots !5..!15 are DIBasicType, so
// the first DISubprogram must be at !16. A regression that forgot
// to bump dbgFuncIDBase past the new DIBasicType range would clash
// with the bool slot and clang would reject the IR — but checking
// the position explicitly localises the failure.
func TestEmitDebugFuncIDBase() testing.TestResult {
	SetDebugInfo(true)
	var src *[]const char = "package \"main\"\nfunc main() { println(1) }\n"
	var out @[]char = compileToLLVM(src)
	SetDebugInfo(false)
	if !contains(out, "!16 = distinct !DISubprogram") {
		return fail("expected first DISubprogram at !16 (after DIBasicType slots !5..!15)")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitDebugDeclareReferencesScalarType verifies a named alloca's
// dbg.declare references the scalar slot picked by dbgTypeID rather
// than the legacy !5 fallback. Two scalars instead of one: bool
// (slot !15, far from !5 — catches a TypeArg-not-plumbed regression)
// and uint8 (slot !10, exercises the unsigned dispatch arm).
func TestEmitDebugDeclareReferencesScalarType() testing.TestResult {
	SetDebugInfo(true)
	var src *[]const char =
		"package \"main\"\nfunc main() {\n\tvar b bool = true\n\tvar c uint8 = 0\n\tprintln(1)\n}\n"
	var out @[]char = compileToLLVM(src)
	SetDebugInfo(false)
	if !contains(out, "!DILocalVariable(name: \"b\"") {
		return fail("expected DILocalVariable for b")
	}
	if !contains(out, "type: !15)") {
		return fail("expected b's dbg.declare to reference bool slot !15")
	}
	if !contains(out, "!DILocalVariable(name: \"c\"") {
		return fail("expected DILocalVariable for c")
	}
	if !contains(out, "type: !10)") {
		return fail("expected c's dbg.declare to reference uint8 slot !10")
	}
	var pass testing.TestResult
	return pass
}

func TestEmitDebugDoesNotAnnotateLabels() testing.TestResult {
	SetDebugInfo(true)
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type N struct { V int }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar a @N = make(N)\n")
	cb = cb.WriteStr("\tvar b @N = a\n")
	cb = cb.WriteStr("\tprintln(b.V)\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	SetDebugInfo(false)
	// Inline RefInc/RefDec sites should still emit their labels.
	if !contains(out, ".skip:") {
		return fail("expected inline refcount skip label")
	}
	// And those labels must not have !dbg appended (invalid IR).
	if contains(out, ".skip:, !dbg") {
		return fail("label declaration must not carry !dbg metadata")
	}
	if contains(out, ".do:, !dbg") {
		return fail("RefInc do-block label must not carry !dbg")
	}
	if contains(out, ".dec:, !dbg") {
		return fail("RefDec dec-block label must not carry !dbg")
	}
	if contains(out, ".destroy:, !dbg") {
		return fail("RefDec destroy-block label must not carry !dbg")
	}
	var pass testing.TestResult
	return pass
}
