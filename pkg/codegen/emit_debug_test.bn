package "pkg/codegen"

import "pkg/ast"
import "pkg/buf"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/parser"

// Tests for DWARF debug metadata emission.

func TestEmitDebugMetadata() testing.TestResult {
	SetDebugInfo(true)
	var src *[]const char = "package \"main\"\nfunc main() { println(1) }\n"
	var out @[]char = compileToLLVM(src)
	SetDebugInfo(false)
	if !contains(out, "!DICompileUnit") {
		return fail("expected DICompileUnit in debug output")
	}
	if !contains(out, "!DISubprogram") {
		return fail("expected DISubprogram in debug output")
	}
	var pass testing.TestResult
	return pass
}

func TestEmitNoDebugByDefault() testing.TestResult {
	SetDebugInfo(false)
	var src *[]const char = "package \"main\"\nfunc main() { println(1) }\n"
	var out @[]char = compileToLLVM(src)
	if contains(out, "!DICompileUnit") {
		return fail("should not emit debug info when disabled")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitDebugDoesNotAnnotateLabels guards against a regression where
// addDbgToLastLine appended `, !dbg !DILocation(...)` to the last line
// of multi-line emissions like emitRefIncInline / emitRefDecInline,
// which end on a basic-block label (e.g., "ri.0.skip:"). LLVM rejects
// `<label>:, !dbg !N` as invalid IR. Source: any program exercising
// OP_REFINC or OP_REFDEC under -g — i.e., any managed-pointer usage.
func TestEmitDebugDoesNotAnnotateLabels() testing.TestResult {
	SetDebugInfo(true)
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type N struct { V int }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar a @N = make(N)\n")
	cb = cb.WriteStr("\tvar b @N = a\n")
	cb = cb.WriteStr("\tprintln(b.V)\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	SetDebugInfo(false)
	// Inline RefInc/RefDec sites should still emit their labels.
	if !contains(out, ".skip:") {
		return fail("expected inline refcount skip label")
	}
	// And those labels must not have !dbg appended (invalid IR).
	if contains(out, ".skip:, !dbg") {
		return fail("label declaration must not carry !dbg metadata")
	}
	if contains(out, ".do:, !dbg") {
		return fail("RefInc do-block label must not carry !dbg")
	}
	if contains(out, ".dec:, !dbg") {
		return fail("RefDec dec-block label must not carry !dbg")
	}
	if contains(out, ".destroy:, !dbg") {
		return fail("RefDec destroy-block label must not carry !dbg")
	}
	var pass testing.TestResult
	return pass
}
