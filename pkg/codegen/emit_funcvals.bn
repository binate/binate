package "pkg/codegen"

import "pkg/buf"
import "pkg/ir"
import "pkg/mangle"
import "pkg/types"

// ============================================================
// Function-value LLVM emission
// ============================================================

// funcSignatureLLVM formats the LLVM function-pointer type for a
// function-value type. As of Phase 3 (always-shim), the call slot
// always takes `i8* data` as its first parameter, followed by the
// function's user-visible arg types: `<ret>(i8*, <args>)*`.
// fvTyp must be a TYP_FUNC_VALUE or TYP_MANAGED_FUNC_VALUE.
func funcSignatureLLVM(fvTyp @types.Type) @[]char {
	var b buf.CharBuf = buf.New()
	b = writeFuncResultsLLVM(b, fvTyp)
	b = b.WriteByte('(')
	b = b.WriteStr("i8*")
	for i := 0; i < len(fvTyp.Params); i++ {
		b = b.WriteStr(", ")
		b = b.WriteStr(llvmType(fvTyp.Params[i].Type))
	}
	b = b.WriteStr(")*")
	return b.Bytes()
}

// writeFuncResultsLLVM writes the LLVM return-type form for a
// function-value signature into b. void / single-type / multi-
// return-anonymous-struct.
func writeFuncResultsLLVM(b buf.CharBuf, fvTyp @types.Type) buf.CharBuf {
	if len(fvTyp.Results) == 0 {
		return b.WriteStr("void")
	}
	if len(fvTyp.Results) == 1 {
		return b.WriteStr(llvmType(fvTyp.Results[0]))
	}
	b = b.WriteStr("{")
	for i := 0; i < len(fvTyp.Results); i++ {
		if i > 0 { b = b.WriteStr(", ") }
		b = b.WriteStr(llvmType(fvTyp.Results[i]))
	}
	return b.WriteStr("}")
}

// emitFuncValueVtables walks the module's instructions, collects
// unique function names referenced by OP_FUNC_VALUE, and emits, per
// name:
//   1. A per-function shim `@__shim.<mangled>` that takes
//      `(i8* data, <args>)`, ignores `data`, and tail-calls the
//      real function. (Phase 3, always-shim — see
//      plan-function-values-phase-3.md.)
//   2. A `@__vt.<mangled> = weak_odr constant %BnVtable {...}` whose
//      `call` slot points at the shim. dtor stays null (non-
//      capturing has no captured ctx to clean up).
func emitFuncValueVtables(out buf.CharBuf, m @ir.Module) buf.CharBuf {
	var seen @[]@[]char
	var sigs @[]@types.Type
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if f.IsExtern { continue }
		for j := 0; j < len(f.Blocks); j++ {
			var blk @ir.Block = f.Blocks[j]
			for k := 0; k < len(blk.Instrs); k++ {
				var instr @ir.Instr = blk.Instrs[k]
				if instr.Op != ir.OP_FUNC_VALUE { continue }
				var dup bool = false
				for s := 0; s < len(seen); s++ {
					if charsEqual(seen[s], instr.StrVal) {
						dup = true
						break
					}
				}
				if dup { continue }
				seen = appendCharSliceLocal(seen, instr.StrVal)
				sigs = appendTypePtrLocal(sigs, instr.Typ)
			}
		}
	}
	if len(seen) == 0 { return out }
	for i := 0; i < len(seen); i++ {
		var mangled @[]char =
			mangle.FuncName(modulePkgName, seen[i]).Bytes()
		out = emitFuncValueShim(out, mangled, sigs[i])
		out = emitFuncValueVtable(out, mangled, sigs[i])
	}
	out = out.WriteByte('\n')
	return out
}

// emitFuncValueShim emits the always-shim wrapper:
//   define <ret> @__shim.<mangled>(i8* %data, <args>) {
//     <ret> %r = tail call <ret> @<mangled>(<args>)
//     ret <ret> %r
//   }
// For void return: tail call + ret void. data is unused.
// weak_odr matches the existing vtable-global linkage, so cross-TU
// duplicate shims dedupe at link time.
func emitFuncValueShim(out buf.CharBuf, mangled @[]char, fvTyp @types.Type) buf.CharBuf {
	var isVoid bool = len(fvTyp.Results) == 0
	out = out.WriteStr("define weak_odr ")
	out = writeFuncResultsLLVM(out, fvTyp)
	out = out.WriteStr(" @__shim.")
	out = out.WriteStr(mangled)
	out = out.WriteStr("(i8* %data")
	for i := 0; i < len(fvTyp.Params); i++ {
		out = out.WriteStr(", ")
		out = out.WriteStr(llvmType(fvTyp.Params[i].Type))
		out = out.WriteStr(" %a")
		out = out.WriteInt(i)
	}
	out = out.WriteStr(") {\n  ")
	if !isVoid {
		out = out.WriteStr("%r = ")
	}
	out = out.WriteStr("tail call ")
	out = writeFuncResultsLLVM(out, fvTyp)
	out = out.WriteStr(" @")
	out = out.WriteStr(mangled)
	out = out.WriteByte('(')
	for i := 0; i < len(fvTyp.Params); i++ {
		if i > 0 { out = out.WriteStr(", ") }
		out = out.WriteStr(llvmType(fvTyp.Params[i].Type))
		out = out.WriteStr(" %a")
		out = out.WriteInt(i)
	}
	out = out.WriteStr(")\n  ")
	if isVoid {
		out = out.WriteStr("ret void\n}\n")
	} else {
		out = out.WriteStr("ret ")
		out = writeFuncResultsLLVM(out, fvTyp)
		out = out.WriteStr(" %r\n}\n")
	}
	return out
}

// emitFuncValueVtable emits the @__vt.<mangled> global pointing
// its call slot at @__shim.<mangled>.
func emitFuncValueVtable(out buf.CharBuf, mangled @[]char, fvTyp @types.Type) buf.CharBuf {
	var sig @[]char = funcSignatureLLVM(fvTyp)
	out = out.WriteStr("@__vt.")
	out = out.WriteStr(mangled)
	out = out.WriteStr(
		" = weak_odr constant %BnVtable { i8* null, i8* bitcast (")
	out = out.WriteStr(sig)
	out = out.WriteStr(" @__shim.")
	out = out.WriteStr(mangled)
	out = out.WriteStr(" to i8*) }\n")
	return out
}

// appendCharSliceLocal appends a char-slice pointer to a managed
// slice. Local helper because pkg/codegen doesn't have a generic
// append for @[]@[]char yet.
func appendCharSliceLocal(s @[]@[]char, v @[]char) @[]@[]char {
	var n int = len(s)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendTypePtrLocal appends a types.Type pointer to a managed slice.
func appendTypePtrLocal(s @[]@types.Type, v @types.Type) @[]@types.Type {
	var n int = len(s)
	var ns @[]@types.Type = make_slice(@types.Type, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}
