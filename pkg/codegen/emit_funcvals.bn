package "pkg/codegen"

import "pkg/binate/buf"
import "pkg/binate/mangle"
import "pkg/ir"
import "pkg/slices"
import "pkg/types"

// ============================================================
// Function-value LLVM emission
// ============================================================

// isAggregateReturn reports whether the function value's return type
// is too large to fit in a single host-int-sized return register and
// thus needs the retbuf-style shim.
//
// Threshold: SizeOf > target's PointerSize.  On LP64 (= 8 bytes) this
// covers slices (16 bytes), managed-slices (32 bytes), function values
// (16 bytes), and any struct/array whose layout exceeds an int.  ≤ 8
// byte returns (int, pointer, bool, float, 1-int struct) keep using
// the scalar shape so existing dispatch paths (Phase 3
// dispatchCompiledFuncValue's rt._call_shim_scalar) work unchanged.
// On ILP32 the threshold drops to > 4, which matches AAPCS32 / arm-
// linux-gnueabihf — slices, managed-slices, function values, and any
// >4-byte struct route through the aggregate-retbuf shim shape; the
// scalar shape only handles single-word returns (int/pointer/bool/
// float / *T).  Without target awareness, 5..8-byte aggregates on
// arm32 stayed at the scalar shim shape while emit.bn / emit_call.bn
// already emitted sret(...) for them, mismatching caller and callee.
//
// Multi-return is treated as aggregate (the anonymous-struct return
// type is by definition multi-word).
func isAggregateReturn(fvTyp @types.Type) bool {
	if len(fvTyp.Results) == 0 { return false }
	if len(fvTyp.Results) > 1 { return true }
	return fvTyp.Results[0].SizeOf() > types.GetTarget().PointerSize
}

// isAggregateArg reports whether a parameter type doesn't fit in a
// single 8-byte register slot and thus needs pointer-to-aggregate
// passing in the shim convention.  Same threshold as isAggregateReturn:
// SizeOf > 8.  Slices, managed-slices, function values, and any
// >8-byte struct/array qualify.
//
// In the shim, aggregate-arg slots take `i8*` (pointer to the
// aggregate); the shim loads the value before calling the underlying.
// This lets the bytecode-side dispatcher (rt._call_shim_scalar /
// rt._call_shim_aggregate, both of which pass int args) carry slice
// values via their existing pointer-in-register convention without
// needing a parallel int-pair-per-slice ABI.
func isAggregateArg(t @types.Type) bool {
	return t.SizeOf() > 8
}

// funcSignatureLLVM formats the LLVM function-pointer type for a
// function-value type's vtable.call slot.
//
//   - Scalar/void return + scalar args: `<ret>(i8*, <args>)*` — the
//     Phase 3 shape from plan-function-values-phase-3.md (Slice 3.1).
//   - Aggregate return: `void(i8*, i8*, <args>)*` — retbuf-style.
//   - Aggregate args: each aggregate arg becomes i8* (pointer-to-
//     aggregate); shim loads before calling underlying.
// All three transforms compose freely.
//
// fvTyp must be a TYP_FUNC_VALUE or TYP_MANAGED_FUNC_VALUE.
func funcSignatureLLVM(fvTyp @types.Type) @[]char {
	var b buf.CharBuf = buf.New()
	if isAggregateReturn(fvTyp) {
		b = b.WriteStr("void(i8*, i8*")
		for i := 0; i < len(fvTyp.Params); i++ {
			b = b.WriteStr(", ")
			b = b.WriteStr(shimParamType(fvTyp.Params[i].Type))
		}
		b = b.WriteStr(")*")
		return b.Bytes()
	}
	b = writeFuncResultsLLVM(b, fvTyp)
	b = b.WriteByte('(')
	b = b.WriteStr("i8*")
	for i := 0; i < len(fvTyp.Params); i++ {
		b = b.WriteStr(", ")
		b = b.WriteStr(shimParamType(fvTyp.Params[i].Type))
	}
	b = b.WriteStr(")*")
	return b.Bytes()
}

// shimParamType returns the LLVM type for a shim parameter.
// Aggregate args (SizeOf > 8) become i8* (pointer-to-aggregate);
// scalars keep their natural type.
func shimParamType(t @types.Type) @[]char {
	if isAggregateArg(t) {
		var b buf.CharBuf = buf.New()
		b = b.WriteStr("i8*")
		return b.Bytes()
	}
	return llvmType(t)
}

// writeFuncResultsLLVM writes the LLVM return-type form for a
// function-value signature into b. void / single-type / multi-
// return-anonymous-struct.
func writeFuncResultsLLVM(b buf.CharBuf, fvTyp @types.Type) buf.CharBuf {
	if len(fvTyp.Results) == 0 {
		return b.WriteStr("void")
	}
	if len(fvTyp.Results) == 1 {
		return b.WriteStr(llvmType(fvTyp.Results[0]))
	}
	b = b.WriteStr("{")
	for i := 0; i < len(fvTyp.Results); i++ {
		if i > 0 { b = b.WriteStr(", ") }
		b = b.WriteStr(llvmType(fvTyp.Results[i]))
	}
	return b.WriteStr("}")
}

// emitFuncValueVtables walks the module's instructions, collects
// unique function names referenced by OP_FUNC_VALUE, and emits, per
// name:
//   1. A per-function shim `@__shim.<mangled>` that takes
//      `(i8* data, <args>)`, ignores `data`, and tail-calls the
//      real function. (Phase 3, always-shim — see
//      plan-function-values-phase-3.md.)
//   2. A `@__vt.<mangled> = weak_odr constant %BnVtable {...}` whose
//      `call` slot points at the shim. dtor stays null (non-
//      capturing has no captured ctx to clean up).
func emitFuncValueVtables(out buf.CharBuf, m @ir.Module) buf.CharBuf {
	var seen @[]@[]char
	var sigs @[]@types.Type
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if f.IsExtern { continue }
		for j := 0; j < len(f.Blocks); j++ {
			var blk @ir.Block = f.Blocks[j]
			for k := 0; k < len(blk.Instrs); k++ {
				var instr @ir.Instr = blk.Instrs[k]
				// Collect OP_FUNC_VALUE (carries the function-value
				// type in instr.Typ) and OP_FUNC_HANDLE (user-facing
				// `_func_handle(F)` and emitManagedPtrRefDec's dtor
				// refs — Phase 4 of plan-uniform-native-fnptrs.md).
				// OP_FUNC_HANDLE's result type is opaque *uint8, so
				// synthesize a TYP_FUNC_VALUE from the referenced
				// function's Params/Results.  Both kinds need the same
				// per-function __shim / __vt / __handle backing:
				// OP_FUNC_HANDLE's native lowering references
				// @__handle.<mangled>, which depends on @__vt.<mangled>
				// (in turn depends on @__shim.<mangled>).
				if instr.Op != ir.OP_FUNC_VALUE &&
						instr.Op != ir.OP_FUNC_HANDLE {
					continue
				}
				var dup bool = false
				for s := 0; s < len(seen); s++ {
					if charsEqual(seen[s], instr.StrVal) {
						dup = true
						break
					}
				}
				if dup { continue }
				var sigTyp @types.Type = instr.Typ
				if instr.Op == ir.OP_FUNC_HANDLE {
					sigTyp = lookupFuncValueType(m, instr.StrVal)
					if sigTyp == nil { continue }
				}
				seen = slices.Append[@[]char](seen, instr.StrVal)
				sigs = slices.Append[@types.Type](sigs, sigTyp)
			}
		}
	}
	if len(seen) == 0 { return out }
	for i := 0; i < len(seen); i++ {
		var mangled @[]char =
			mangle.FuncName(modulePkgName, seen[i]).Bytes()
		var useSret bool = funcValueUsesSret(m, seen[i], sigs[i])
		// If the referenced function is a closure (IsClosure=true),
		// route through the closure-shim emitter which reads
		// captures out of the data pointer before tail-calling the
		// underlying (B.2 of plan-function-values-phase-2.md).
		var closureFunc @ir.Func = lookupClosureFunc(m, seen[i])
		if closureFunc != nil {
			out = emitClosureShim(out, mangled, sigs[i], closureFunc)
		} else {
			out = emitFuncValueShim(out, mangled, sigs[i], useSret)
		}
		out = emitFuncValueVtable(out, mangled, sigs[i])
		out = emitFuncValueHandle(out, mangled)
	}
	out = out.WriteByte('\n')
	return out
}

// funcValueUsesSret reports whether the underlying callee for an
// OP_FUNC_VALUE reference uses the sret return convention
// (`void f(ptr sret(...) align 8, ...args)`).  True for any
// aggregate return >16 bytes — the same threshold emit.bn applies
// to extern declarations and emit_call.bn applies to call sites
// (post round-5: pkg/codegen forces sret universally so LLVM's
// per-shape pack-vs-sret heuristic can't break the convention).
// Without this check the aggregate-return shim would emit a
// register-style call against an sret-declared function, producing
// memory corruption when the callee writes the result through what
// it thinks is the sret pointer (which is actually the first user
// arg).
func funcValueUsesSret(m @ir.Module, name @[]char, fvTyp @types.Type) bool {
	if !isAggregateReturn(fvTyp) { return false }
	if len(fvTyp.Results) != 1 { return false }
	// Route through needsSret so the threshold tracks the target's
	// host ABI — 16 bytes on LP64 (AAPCS64 / SysV-AMD64), 4 bytes on
	// ILP32 (AAPCS32 arm32-linux).  Without this, the hardcoded `> 16`
	// path leaves 5..16-byte aggregate-returning func-values at
	// register-style shim emission while pkg/codegen/emit_call.bn
	// and the declaration in emit.bn already emit sret(...) for them
	// on arm32; the caller-vs-callee mismatch silently corrupts the
	// returned struct and the pkg/vm test binary segfaults at init.
	return needsSret(fvTyp.Results[0])
}

// emitFuncValueShim emits the per-function shim wrapper.
//
// Scalar/void return — Phase 3's always-shim shape:
//   define <ret> @__shim.<m>(i8* %data, <args>) {
//     <ret> %r = tail call <ret> @<m>(<args>)
//     ret <ret> %r
//   }
//
// Aggregate return — retbuf-style shim:
//   define void @__shim.<m>(i8* %retbuf, i8* %data, <args>) {
//     <ret> %r = call <ret> @<m>(<args>)
//     <ret>* %rb = bitcast i8* %retbuf to <ret>*
//     store <ret> %r, <ret>* %rb
//     ret void
//   }
// The retbuf shape lets bytecode dispatchers (dispatchExternBinding,
// dispatchCompiledFuncValue) capture the full multi-word result via
// a fixed-shape rt._call_shim_aggregate helper.  The compiled-side
// caller (emitCallFuncValue) allocates retbuf, calls the shim, and
// loads the result back.
//
// data is unused in non-capturing function values (Phase 1); future
// Phase 2 closures will populate it.  weak_odr lets cross-TU
// duplicate shims dedupe at link time.
func emitFuncValueShim(out buf.CharBuf, mangled @[]char,
		fvTyp @types.Type, useSret bool) buf.CharBuf {
	if isAggregateReturn(fvTyp) {
		return emitFuncValueShimAggregate(out, mangled, fvTyp, useSret)
	}
	var isVoid bool = len(fvTyp.Results) == 0
	out = out.WriteStr("define weak_odr ")
	out = writeFuncResultsLLVM(out, fvTyp)
	out = out.WriteStr(" @__shim.")
	out = out.WriteStr(mangled)
	out = out.WriteStr("(i8* %data")
	for i := 0; i < len(fvTyp.Params); i++ {
		out = out.WriteStr(", ")
		out = out.WriteStr(shimParamType(fvTyp.Params[i].Type))
		out = out.WriteStr(" %a")
		out = out.WriteInt(i)
	}
	out = out.WriteStr(") {\n  ")
	// Load aggregate args from their pointer slots before calling the
	// underlying.  Scalars pass through unchanged.
	out = emitShimArgLoads(out, fvTyp)
	if !isVoid {
		out = out.WriteStr("%r = ")
	}
	out = out.WriteStr("tail call ")
	out = writeFuncResultsLLVM(out, fvTyp)
	out = out.WriteStr(" @")
	out = out.WriteStr(mangled)
	out = out.WriteByte('(')
	for i := 0; i < len(fvTyp.Params); i++ {
		if i > 0 { out = out.WriteStr(", ") }
		out = out.WriteStr(llvmType(fvTyp.Params[i].Type))
		out = writeShimArgRef(out, fvTyp.Params[i].Type, i)
	}
	out = out.WriteStr(")\n  ")
	if isVoid {
		out = out.WriteStr("ret void\n}\n")
	} else {
		out = out.WriteStr("ret ")
		out = writeFuncResultsLLVM(out, fvTyp)
		out = out.WriteStr(" %r\n}\n")
	}
	return out
}

// emitShimArgLoads emits LLVM `load` instructions for each aggregate
// arg in the shim's signature, producing %a<i>_v values that hold the
// dereferenced aggregate.  Scalars don't need loading; they pass
// through as %a<i>.
func emitShimArgLoads(out buf.CharBuf, fvTyp @types.Type) buf.CharBuf {
	for i := 0; i < len(fvTyp.Params); i++ {
		var pt @types.Type = fvTyp.Params[i].Type
		if !isAggregateArg(pt) { continue }
		out = out.WriteStr("%a")
		out = out.WriteInt(i)
		out = out.WriteStr("_p = bitcast i8* %a")
		out = out.WriteInt(i)
		out = out.WriteStr(" to ")
		out = out.WriteStr(llvmType(pt))
		out = out.WriteStr("*\n  %a")
		out = out.WriteInt(i)
		out = out.WriteStr("_v = load ")
		out = out.WriteStr(llvmType(pt))
		out = out.WriteStr(", ")
		out = out.WriteStr(llvmType(pt))
		out = out.WriteStr("* %a")
		out = out.WriteInt(i)
		out = out.WriteStr("_p\n  ")
	}
	return out
}

// writeShimArgRef writes the arg reference used in the underlying-
// call argument list.  For aggregate args, it's `%a<i>_v` (the
// loaded value).  For scalars, it's `%a<i>` (the parameter
// directly).  A leading space is included for readability after
// the type.
func writeShimArgRef(out buf.CharBuf, t @types.Type, i int) buf.CharBuf {
	if isAggregateArg(t) {
		out = out.WriteStr(" %a")
		out = out.WriteInt(i)
		return out.WriteStr("_v")
	}
	out = out.WriteStr(" %a")
	return out.WriteInt(i)
}

// emitFuncValueShimAggregate emits the retbuf-style aggregate shim.
// Called from emitFuncValueShim when the return type is multi-word.
// Aggregate args still use the pointer-arg convention (shim derefs).
//
// useSret indicates whether the underlying callee is a C-extern with
// >16-byte return that uses the C-ABI sret convention.  When true,
// the shim passes retbuf directly as the callee's first sret arg
// (bypassing the intermediate %r value).  When false, the callee
// returns the aggregate by value and the shim stores the result
// through retbuf.
func emitFuncValueShimAggregate(out buf.CharBuf, mangled @[]char,
		fvTyp @types.Type, useSret bool) buf.CharBuf {
	out = out.WriteStr("define weak_odr void @__shim.")
	out = out.WriteStr(mangled)
	out = out.WriteStr("(i8* %retbuf, i8* %data")
	for i := 0; i < len(fvTyp.Params); i++ {
		out = out.WriteStr(", ")
		out = out.WriteStr(shimParamType(fvTyp.Params[i].Type))
		out = out.WriteStr(" %a")
		out = out.WriteInt(i)
	}
	out = out.WriteStr(") {\n  ")
	// Load aggregate args (if any) before calling the underlying.
	out = emitShimArgLoads(out, fvTyp)
	if useSret {
		// Sret call: pass retbuf as the sret arg directly; the
		// callee writes the aggregate result through it.
		out = out.WriteStr("%rb = bitcast i8* %retbuf to ")
		out = writeFuncResultsLLVM(out, fvTyp)
		out = out.WriteStr("*\n  ")
		out = out.WriteStr("call void @")
		out = out.WriteStr(mangled)
		out = out.WriteStr("(ptr sret(")
		out = writeFuncResultsLLVM(out, fvTyp)
		out = out.WriteStr(") align 8 %rb")
		for i := 0; i < len(fvTyp.Params); i++ {
			out = out.WriteStr(", ")
			out = out.WriteStr(llvmType(fvTyp.Params[i].Type))
			out = writeShimArgRef(out, fvTyp.Params[i].Type, i)
		}
		out = out.WriteStr(")\n  ret void\n}\n")
		return out
	}
	// Register-return path: callee returns the aggregate by value.
	out = out.WriteStr("%r = call ")
	out = writeFuncResultsLLVM(out, fvTyp)
	out = out.WriteStr(" @")
	out = out.WriteStr(mangled)
	out = out.WriteByte('(')
	for i := 0; i < len(fvTyp.Params); i++ {
		if i > 0 { out = out.WriteStr(", ") }
		out = out.WriteStr(llvmType(fvTyp.Params[i].Type))
		out = writeShimArgRef(out, fvTyp.Params[i].Type, i)
	}
	out = out.WriteStr(")\n  ")
	out = out.WriteStr("%rb = bitcast i8* %retbuf to ")
	out = writeFuncResultsLLVM(out, fvTyp)
	out = out.WriteStr("*\n  ")
	out = out.WriteStr("store ")
	out = writeFuncResultsLLVM(out, fvTyp)
	out = out.WriteStr(" %r, ")
	out = writeFuncResultsLLVM(out, fvTyp)
	out = out.WriteStr("* %rb\n  ret void\n}\n")
	return out
}

// isUniversalTrampoline reports whether the function-value reference
// resolves to one of the universal cross-mode trampolines
// (vm.TrampolineScalar / vm.TrampolineAggregate).  These are special:
// their `data` parameter IS the closure record (not implicit context
// the shim should strip), so the standard "shim strips data" wrapper
// would route the actual closure rec to the wrong argument slot.
// emitFuncValueVtable below sets __vt.<mangled>.call to the function
// directly (bypassing __shim) for these names.
func isUniversalTrampoline(mangled @[]char) bool {
	return charsEqual(mangled, "bn_pkg__vm__TrampolineScalar") ||
		charsEqual(mangled, "bn_pkg__vm__TrampolineAggregate")
}

// emitFuncValueVtable emits the @__vt.<mangled> global pointing
// its call slot at @__shim.<mangled>.  Universal trampolines
// bypass __shim (call points at the function itself) — see
// `isUniversalTrampoline` above.
func emitFuncValueVtable(out buf.CharBuf, mangled @[]char, fvTyp @types.Type) buf.CharBuf {
	var sig @[]char = funcSignatureLLVM(fvTyp)
	out = out.WriteStr("@__vt.")
	out = out.WriteStr(mangled)
	out = out.WriteStr(
		" = weak_odr constant %BnVtable { i8* null, i8* bitcast (")
	out = out.WriteStr(sig)
	if isUniversalTrampoline(mangled) {
		// Skip the shim — call slot points directly at the
		// function.  The trampoline's first parameter IS the
		// closure record that the caller passes via the function
		// value's data slot, so no implicit-data stripping should
		// happen.
		out = out.WriteStr(" @")
		out = out.WriteStr(mangled)
	} else {
		out = out.WriteStr(" @__shim.")
		out = out.WriteStr(mangled)
	}
	out = out.WriteStr(" to i8*) }\n")
	return out
}

// lookupFuncValueType finds a function in the module by qualified
// name and synthesizes a TYP_FUNC_VALUE from its parameter / result
// signature.  Used by emitFuncValueVtables to back OP_FUNC_HANDLE
// references (whose IR result type is the opaque `*uint8`, not the
// underlying function type) so they get the same per-function
// __shim / __vt / __handle emission as OP_FUNC_VALUE references.
// Returns nil if the function isn't in the module — caller should
// skip emission in that case (cross-module references resolve at
// link time and don't need locally-emitted shims).
func lookupFuncValueType(m @ir.Module, qname @[]char) @types.Type {
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if !charsEqual(f.Name, qname) { continue }
		// ir.Param and types.Param have the same shape (Name +
		// Type) but are distinct nominal types; copy field-by-field
		// into a fresh `@[]@types.Param`.
		var params @[]@types.Param
		for j := 0; j < len(f.Params); j++ {
			var p @types.Param = make(types.Param)
			p.Name = f.Params[j].Name
			p.Type = f.Params[j].Typ
			params = slices.Append[@types.Param](params, p)
		}
		return types.MakeFuncValueType(params, f.Results)
	}
	return nil
}

// emitFuncValueHandle emits the @__handle.<mangled> global — a
// long-lived 16-byte function-value structure { vtable_ptr,
// data_ptr } that the renamed `_func_handle(F)` IR-magic (Phase 4
// of plan-uniform-native-fnptrs.md) returns the address of.
// vtable points at @__vt.<mangled>; data is null (non-capturing).
// At dispatch time consumers read handle.vtable.call(handle.data,
// args...) — collapsing _call_free_fn / _call_dtor into the same
// shape BC_CALL_FUNC_VALUE uses, so a single dispatch mechanism
// covers both natively-compiled functions and bytecode-only
// functions (whose handles are heap-allocated at runtime; see
// VMFunc.Vtable / VMFunc.ClosureRec).
func emitFuncValueHandle(out buf.CharBuf, mangled @[]char) buf.CharBuf {
	out = out.WriteStr("@__handle.")
	out = out.WriteStr(mangled)
	out = out.WriteStr(
		" = weak_odr constant %BnFuncValue { i8* bitcast (%BnVtable* @__vt.")
	out = out.WriteStr(mangled)
	out = out.WriteStr(" to i8*), i8* null }\n")
	return out
}
