package "pkg/codegen"

import "pkg/buf"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/types"

// Tests for emit_funcvals.bn — funcSignatureLLVM and
// emitFuncValueVtables. The vtables emitter walks the module for
// OP_FUNC_VALUE instructions and emits one `@__vt.<mangled>` global
// per unique referenced function, with the function pointer in the
// `call` slot and null in the `dtor` slot (Phase 1 — no captured
// context). Helpers (compileToLLVM, contains, fail) live in
// emit_test.bn.

// TestEmitFuncValueVtable: a function-value reference must produce
// a `@__vt.<callee>` global in the LLVM output, not an inline
// constant or a missing definition. Without this, OP_CALL_FUNC_VALUE
// would dispatch through a vtable address that doesn't exist.
func TestEmitFuncValueVtable() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func add(a int, b int) int { return a + b }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar f *func(int, int) int = add\n")
	cb = cb.WriteStr("\t_ = f\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if !contains(out, "@__vt.") {
		return fail("expected @__vt.<name> vtable global for function-value reference")
	}
	if !contains(out, "weak_odr constant %BnVtable") {
		return fail("expected vtable to be a weak_odr %BnVtable constant")
	}
	if !contains(out, "i8* null") {
		return fail("expected dtor slot to be null (Phase 1, no captured ctx)")
	}
	return ""
}

// TestFuncSignatureLLVMVoid: a function-value type with no results
// renders as `void(<args>)*`. funcSignatureLLVM is consumed by
// emitFuncValueVtables when wiring up the call slot's bitcast, so a
// regression in either piece would surface as malformed LLVM.
func TestFuncSignatureLLVMVoid() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func helper() {}\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar h @func() = helper\n")
	cb = cb.WriteStr("\t_ = h\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if !contains(out, "void(i8*)*") {
		return fail("expected void(i8*)* signature for @func() type (hidden ctx)")
	}
	return ""
}

// TestEmitFuncValueShimAggregateSret: when a function value
// references a C-extern with a >16-byte return, the aggregate-shim
// must use sret convention (`call void @fn(ptr sret(...) align 8
// %rb, ...)`) — NOT the register-style `%r = call <ret> @fn(...)`
// shape it would otherwise emit.  Without this, the shim's call
// signature mismatches the declared sret signature and the callee
// writes the result through what it thinks is the sret pointer
// (the first user arg's value), corrupting memory.
//
// Surfaced by trying to register `bootstrap.ReadDir` (which returns
// @[]@[]char = 32 bytes, IsCExtern) directly through the
// vm.Externs registry: cmd/bni built fine but boot-comp-int-int
// 313/317 tests failed because the inner cmd/bni's loader.bn
// got back garbage from ReadDir.
func TestEmitFuncValueShimAggregateSret() testing.TestResult {
	// Build: an IsCExtern function `bootstrap.Concat(*[]const char,
	// *[]const char) @[]char` (32-byte managed-slice return),
	// plus a free function in the same module that references it
	// via OP_FUNC_VALUE so the shim gets emitted.
	var m @ir.Module = ir.NewModule("\"main\"")

	var concatParams @[]@ir.Param = make_slice(@ir.Param, 2)
	var p1 @ir.Param = make(ir.Param)
	p1.Name = "a"
	p1.Typ = types.MakeSliceType(types.MakeConstType(types.TypChar()))
	concatParams[0] = p1
	var p2 @ir.Param = make(ir.Param)
	p2.Name = "b"
	p2.Typ = types.MakeSliceType(types.MakeConstType(types.TypChar()))
	concatParams[1] = p2
	var concatResults @[]@types.Type = make_slice(@types.Type, 1)
	concatResults[0] = types.MakeManagedSliceType(types.TypChar())
	var concatFn @ir.Func =
		ir.NewExternFunc("bootstrap.Concat", concatParams, concatResults)
	concatFn.IsCExtern = true
	m.AddFunc(concatFn)

	// `func main() { var f *func(...) @[]char = bootstrap.Concat }`
	// — emits OP_FUNC_VALUE for "bootstrap.Concat" so the shim is
	// generated.
	var mainNoParams @[]@ir.Param
	var mainNoResults @[]@types.Type
	var mainFn @ir.Func =
		ir.NewFunc("main", mainNoParams, mainNoResults)
	var entry @ir.Block = ir.AddBlock(mainFn, "entry")
	var fvParams @[]@types.Param = make_slice(@types.Param, 2)
	var fp1 @types.Param = make(types.Param)
	fp1.Name = "a"
	fp1.Type = types.MakeSliceType(types.MakeConstType(types.TypChar()))
	fvParams[0] = fp1
	var fp2 @types.Param = make(types.Param)
	fp2.Name = "b"
	fp2.Type = types.MakeSliceType(types.MakeConstType(types.TypChar()))
	fvParams[1] = fp2
	var fvResults @[]@types.Type = make_slice(@types.Type, 1)
	fvResults[0] = types.MakeManagedSliceType(types.TypChar())
	var fvTyp @types.Type = types.MakeFuncValueType(fvParams, fvResults)
	ir.EmitFuncValue(mainFn, entry, "bootstrap.Concat", fvTyp)
	var noRetArgs @[]@ir.Instr
	ir.EmitReturn(entry, noRetArgs)
	m.AddFunc(mainFn)

	var out @[]char = EmitModule(m)

	// The emitted aggregate-shim should pass retbuf as the sret
	// arg — NOT call the C-extern as if it returned the aggregate
	// in registers.
	if !contains(out,
		"call void @bn_bootstrap__Concat(ptr sret(%BnManagedSlice) align 8 %rb") {
		return fail("aggregate-shim must dispatch IsCExtern callee with sret convention")
	}
	// And it must NOT contain the register-return form for this
	// callee (which would mismatch the sret-declared signature).
	if contains(out, "%r = call %BnManagedSlice @bn_bootstrap__Concat") {
		return fail("aggregate-shim must not emit register-style call for sret callee")
	}
	return ""
}

// TestEmitFuncValueShimAggregateNoSret: a Binate (non-CExtern)
// function value with aggregate return continues to use the
// register-return path — Binate's calling convention returns
// >16-byte aggregates by value and `store` of the result through
// retbuf is correct.  Confirms the sret detection only kicks in
// for IsCExtern.
func TestEmitFuncValueShimAggregateNoSret() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")

	var noFnParams @[]@ir.Param
	var fnResults @[]@types.Type = make_slice(@types.Type, 1)
	fnResults[0] = types.MakeManagedSliceType(types.TypChar())
	var helperFn @ir.Func =
		ir.NewFunc("getSlice", noFnParams, fnResults)
	var helperEntry @ir.Block = ir.AddBlock(helperFn, "entry")
	var nilInstr @ir.Instr =
		ir.EmitConstNil(helperFn, helperEntry, fnResults[0])
	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = nilInstr
	ir.EmitReturn(helperEntry, retArgs)
	m.AddFunc(helperFn)

	var noMainParams @[]@ir.Param
	var noMainResults @[]@types.Type
	var mainFn @ir.Func =
		ir.NewFunc("main", noMainParams, noMainResults)
	var entry @ir.Block = ir.AddBlock(mainFn, "entry")
	var noFvParams @[]@types.Param
	var fvResults @[]@types.Type = make_slice(@types.Type, 1)
	fvResults[0] = types.MakeManagedSliceType(types.TypChar())
	var fvTyp @types.Type = types.MakeFuncValueType(noFvParams, fvResults)
	ir.EmitFuncValue(mainFn, entry, "getSlice", fvTyp)
	var noRetArgs @[]@ir.Instr
	ir.EmitReturn(entry, noRetArgs)
	m.AddFunc(mainFn)

	var out @[]char = EmitModule(m)

	// The shim's call should be the register-return form.
	if !contains(out, "%r = call %BnManagedSlice @bn_main__getSlice") {
		return fail("aggregate-shim for Binate callee must use register-return form")
	}
	// And it must NOT have an sret call — Binate functions don't
	// use sret regardless of return size.
	if contains(out, "call void @bn_main__getSlice(ptr sret") {
		return fail("Binate (non-CExtern) callee must not be dispatched with sret")
	}
	return ""
}
