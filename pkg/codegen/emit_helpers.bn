package "pkg/codegen"

import "pkg/buf"
import "pkg/ir"
import "pkg/mangle"
import "pkg/types"

// emitConstNil emits a nil constant (zeroinitializer for slices, null for pointers).
func emitConstNil(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	if instr.Typ != nil && instr.Typ.Kind == types.TYP_SLICE {
		// Nil raw slice: alloca, store zeroinitializer, load back
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a = alloca %BnSlice\n")
		out = out.WriteStr("  store %BnSlice zeroinitializer, %BnSlice* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		out = out.WriteStr("  ")
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = load %BnSlice, %BnSlice* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		return out
	}
	if instr.Typ != nil && instr.Typ.Kind == types.TYP_MANAGED_SLICE {
		// Nil managed slice: alloca, store zeroinitializer, load back
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a = alloca %BnManagedSlice\n")
		out = out.WriteStr("  store %BnManagedSlice zeroinitializer, %BnManagedSlice* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		out = out.WriteStr("  ")
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = load %BnManagedSlice, %BnManagedSlice* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		return out
	}
	if instr.Typ != nil &&
		(instr.Typ.Kind == types.TYP_FUNC_VALUE ||
			instr.Typ.Kind == types.TYP_MANAGED_FUNC_VALUE) {
		// Nil function value: alloca, store zeroinitializer, load back.
		// Same idiom as the slice arms above; the LLVM type is the
		// uniform %BnFuncValue regardless of the function signature.
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a = alloca %BnFuncValue\n")
		out = out.WriteStr("  store %BnFuncValue zeroinitializer, %BnFuncValue* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		out = out.WriteStr("  ")
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = load %BnFuncValue, %BnFuncValue* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		return out
	}
	if instr.Typ != nil &&
		(instr.Typ.Kind == types.TYP_STRUCT ||
			instr.Typ.Kind == types.TYP_ARRAY ||
			(instr.Typ.Kind == types.TYP_NAMED && instr.Typ.Underlying != nil)) {
		// Nil struct/array: alloca, store zeroinitializer, load back
		var ty @[]char = llvmType(instr.Typ)
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a = alloca ")
		out = out.WriteStr(ty)
		out = out.WriteByte('\n')
		out = out.WriteStr("  store ")
		out = out.WriteStr(ty)
		out = out.WriteStr(" zeroinitializer, ")
		out = out.WriteStr(ty)
		out = out.WriteStr("* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		out = out.WriteStr("  ")
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = load ")
		out = out.WriteStr(ty)
		out = out.WriteStr(", ")
		out = out.WriteStr(ty)
		out = out.WriteStr("* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".a\n")
		return out
	}
	out = emitRef(out, instr.ID)
	out = out.WriteStr(" = inttoptr i64 0 to i8*\n")
	return out
}

// emitAllocDecl emits just the `alloca` instruction for an OP_ALLOC.
// All alloca declarations are hoisted to the function entry block so
// that allocas inside loop bodies don't leak native stack per iteration
// (LLVM allocas in non-entry blocks allocate fresh stack each time the
// block is executed and aren't freed until function return).
func emitAllocDecl(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	var allocTyp @[]char = llvmType(instr.TypeArg)
	out = emitRef(out, instr.ID)
	out = out.WriteStr(" = alloca ")
	out = out.WriteStr(allocTyp)
	out = out.WriteByte('\n')
	return out
}

// emitMakeSliceAllocDecl emits just the `.p = alloca %BnManagedSlice`
// for an OP_MAKE_SLICE instruction. Same hoisting rationale as
// emitAllocDecl: keeping it inline at the OP_MAKE_SLICE site (a
// non-entry block, e.g. inside a loop body or if-branch) leaks
// native stack per execution. The store/bitcast/load from the call
// result stay at the original location.
func emitMakeSliceAllocDecl(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".p = alloca %BnManagedSlice\n")
	return out
}

// emitSretAllocDecl emits just the `.sret = alloca <type>` for an
// OP_CALL that uses sret return convention. Same hoisting rationale
// as emitAllocDecl. The actual `call void` and result load stay at
// the original location.
func emitSretAllocDecl(out buf.CharBuf, instr @ir.Instr,
		funcRetTypes *[]FuncRetType) buf.CharBuf {
	var callNameBuf buf.CharBuf =
		mangle.FuncName(modulePkgName, instr.StrVal)
	if !lookupIsSret(funcRetTypes, callNameBuf.Bytes()) {
		return out
	}
	var sretRetType @[]char =
		lookupRetType(funcRetTypes, callNameBuf.Bytes())
	out = emitRef(out, instr.ID)
	out = out.WriteStr(".sret = alloca ")
	out = out.WriteStr(sretRetType)
	out = out.WriteByte('\n')
	return out
}

// emitAlloc emits the zeroinitializer store for struct/array OP_ALLOCs.
// The alloca itself is hoisted to the entry block by emitAllocDecl;
// this runs at the original location so that each time control reaches
// the declaration (e.g. each loop iteration) the slot is re-zeroed.
func emitAlloc(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	var isStructOrArray bool = instr.TypeArg != nil &&
		(instr.TypeArg.Kind == types.TYP_STRUCT ||
			instr.TypeArg.Kind == types.TYP_ARRAY)
	if !isStructOrArray {
		return out
	}
	var allocTyp @[]char = llvmType(instr.TypeArg)
	out = out.WriteStr("  store ")
	out = out.WriteStr(allocTyp)
	out = out.WriteStr(" zeroinitializer, ")
	out = out.WriteStr(allocTyp)
	out = out.WriteStr("* ")
	out = emitRef(out, instr.ID)
	out = out.WriteByte('\n')
	return out
}

// emitGetFieldPtr emits a getelementptr for struct field access, with bitcast if needed.
func emitGetFieldPtr(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	// getelementptr inbounds %Struct, %Struct* %ptr, i32 0, i32 <index>
	var baseTyp @types.Type = instr.Args[0].TypeArg
	if baseTyp == nil && instr.Args[0].Typ != nil && instr.Args[0].Typ.Elem != nil {
		baseTyp = instr.Args[0].Typ.Elem
	}
	// Unwrap pointer-to-struct to get the struct type itself
	if baseTyp != nil && (baseTyp.Kind == types.TYP_POINTER || baseTyp.Kind == types.TYP_MANAGED_PTR) {
		if baseTyp.Elem != nil {
			baseTyp = baseTyp.Elem
		}
	}
	var baseLL @[]char = "i64"
	if baseTyp != nil {
		baseLL = llvmType(baseTyp)
	}

	// If the source is a pointer that's i8* at LLVM level, bitcast to struct pointer.
	// Managed pointers and bitcast results are i8*; allocas are already %Struct*.
	var needsBitcast bool = false
	if instr.Args[0].Typ != nil && baseTyp != nil {
		if instr.Args[0].Typ.Kind == types.TYP_MANAGED_PTR {
			needsBitcast = true
		}
		if instr.Args[0].Typ.Kind == types.TYP_POINTER && instr.Args[0].Op != ir.OP_ALLOC {
			needsBitcast = true
		}
	}
	var useBitcast bool = false
	if needsBitcast {
		// Emit bitcast: %vN.sc = bitcast i8* %vM to %Struct*
		out = emitRef(out, instr.ID)
		out = out.WriteStr(".sc = bitcast i8* ")
		out = emitPtrRef(out, instr.Args[0])
		out = out.WriteStr(" to ")
		out = out.WriteStr(baseLL)
		out = out.WriteStr("*\n  ")
		useBitcast = true
	}

	// Map Binate field index to LLVM index (accounts for padding fields)
	var llvmFieldIdx int = instr.Index
	if baseTyp != nil {
		llvmFieldIdx = structLLVMIndex(baseTyp, instr.Index)
	}

	out = emitRef(out, instr.ID)
	out = out.WriteStr(" = getelementptr inbounds ")
	out = out.WriteStr(baseLL)
	out = out.WriteStr(", ")
	out = out.WriteStr(baseLL)
	out = out.WriteStr("* ")
	if useBitcast {
		out = emitRef(out, instr.ID)
		out = out.WriteStr(".sc")
	} else {
		out = emitPtrRef(out, instr.Args[0])
	}
	out = out.WriteStr(", i32 0, i32 ")
	out = out.WriteInt(llvmFieldIdx)
	out = out.WriteByte('\n')
	return out
}

// emitGetElemPtr emits a getelementptr for array/pointer element indexing.
func emitGetElemPtr(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	var baseTyp @types.Type = instr.Args[0].TypeArg
	// Raw pointer indexing: base is a pointer value (not an alloca)
	var isRawPtr bool =
		instr.Args[0].Op != ir.OP_ALLOC &&
			instr.Args[0].Typ != nil &&
			instr.Args[0].Typ.Kind == types.TYP_POINTER
	if isRawPtr {
		// Raw pointer indexing: bitcast i8* to ElemT*, then single-index GEP
		var elemTypLL @[]char = "i64"
		if instr.Typ != nil && instr.Typ.Elem != nil {
			elemTypLL = llvmType(instr.Typ.Elem)
		}
		// %vN.bc = bitcast i8* %base to ElemT*
		out = emitRef(out, instr.ID)
		out = out.WriteStr(".bc = bitcast i8* ")
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(" to ")
		out = out.WriteStr(elemTypLL)
		out = out.WriteStr("*\n  ")
		// %vN = getelementptr ElemT, ElemT* %vN.bc, i64 %idx
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = getelementptr ")
		out = out.WriteStr(elemTypLL)
		out = out.WriteStr(", ")
		out = out.WriteStr(elemTypLL)
		out = out.WriteStr("* ")
		out = emitRef(out, instr.ID)
		out = out.WriteStr(".bc, i64 ")
		out = emitRef(out, instr.Args[1].ID)
		out = out.WriteByte('\n')
	} else {
		// Array alloca: double-index GEP: ptr[0][index]
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = getelementptr inbounds ")
		if baseTyp != nil {
			out = out.WriteStr(llvmType(baseTyp))
		} else {
			out = out.WriteStr("i64")
		}
		out = out.WriteStr(", ")
		if baseTyp != nil {
			out = out.WriteStr(llvmType(baseTyp))
		} else {
			out = out.WriteStr("i64")
		}
		out = out.WriteStr("* ")
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(", i64 0, i64 ")
		out = emitRef(out, instr.Args[1].ID)
		out = out.WriteByte('\n')
	}
	return out
}

// emitReturn emits a ret instruction, packing multiple returns via insertvalue.
func emitReturn(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	if len(instr.Args) == 0 {
		out = out.WriteStr("ret void\n")
	} else if len(instr.Args) == 1 {
		// NOTE: RefInc for ownership transfer on return is emitted in the IR gen
		// (before scope-exit RefDecs), not here. See genReturn in gen_stmt.bn.
		out = out.WriteStr("ret ")
		out = out.WriteStr(llvmType(instr.Args[0].Typ))
		out = out.WriteByte(' ')
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteByte('\n')
	} else {
		// Multi-return: pack values into struct with insertvalue
		var structTyp @[]char
		if instr.Typ != nil {
			structTyp = llvmType(instr.Typ)
		} else {
			structTyp = multiReturnType_args(instr.Args)
		}
		// Build aggregate with insertvalue chain
		// Previous agg name -- starts as "undef", then becomes "%v.ret.N.I"
		var prevIsUndef bool = true
		var prevRetSeq int = 0
		var prevRetIdx int = 0
		for i := 0; i < len(instr.Args); i++ {
			var curRetSeq int = retSeq
			retSeq++
			out = out.WriteByte(' ')
			out = out.WriteStr("%v.ret.")
			out = out.WriteInt(curRetSeq)
			out = out.WriteByte('.')
			out = out.WriteInt(i)
			out = out.WriteStr(" = insertvalue ")
			out = out.WriteStr(structTyp)
			out = out.WriteByte(' ')
			if prevIsUndef {
				out = out.WriteStr("undef")
			} else {
				out = out.WriteStr("%v.ret.")
				out = out.WriteInt(prevRetSeq)
				out = out.WriteByte('.')
				out = out.WriteInt(prevRetIdx)
			}
			out = out.WriteStr(", ")
			out = out.WriteStr(llvmType(instr.Args[i].Typ))
			out = out.WriteByte(' ')
			out = emitRef(out, instr.Args[i].ID)
			out = out.WriteStr(", ")
			out = out.WriteInt(i)
			out = out.WriteByte('\n')
			out = out.WriteStr("  ")
			prevIsUndef = false
			prevRetSeq = curRetSeq
			prevRetIdx = i
		}
		out = out.WriteStr("ret ")
		out = out.WriteStr(structTyp)
		out = out.WriteByte(' ')
		out = out.WriteStr("%v.ret.")
		out = out.WriteInt(prevRetSeq)
		out = out.WriteByte('.')
		out = out.WriteInt(prevRetIdx)
		out = out.WriteByte('\n')
	}
	return out
}

// emitExtract emits an extractvalue to unpack a field from a multi-return aggregate.
func emitExtract(out buf.CharBuf, instr @ir.Instr, funcRetTypes *[]FuncRetType) buf.CharBuf {
	out = emitRef(out, instr.ID)
	out = out.WriteStr(" = extractvalue ")
	// The aggregate is a call result -- look up its type from funcRetTypes
	var aggTyp @[]char
	var callInstr @ir.Instr = instr.Args[0]
	if callInstr.Op == ir.OP_CALL {
		aggTyp = lookupRetType(funcRetTypes, mangle.FuncName(modulePkgName,callInstr.StrVal).Bytes())
	}
	if len(aggTyp) == 0 {
		aggTyp = llvmType(instr.Args[0].Typ)
	}
	out = out.WriteStr(aggTyp)
	out = out.WriteByte(' ')
	out = emitRef(out, instr.Args[0].ID)
	out = out.WriteStr(", ")
	out = out.WriteInt(instr.Index)
	out = out.WriteByte('\n')
	return out
}

// emitManagedToRawInstr emits extractvalue/insertvalue to convert @[]T to *[]T.
func emitManagedToRawInstr(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	// @[]T -> *[]T: extract {data, len} prefix from %BnManagedSlice
	var srcID int = instr.Args[0].ID
	out = emitRef(out, instr.ID)
	out = out.WriteStr(".d = extractvalue %BnManagedSlice ")
	out = emitRef(out, srcID)
	out = out.WriteStr(", 0\n  ")
	out = emitRef(out, instr.ID)
	out = out.WriteStr(".l = extractvalue %BnManagedSlice ")
	out = emitRef(out, srcID)
	out = out.WriteStr(", 1\n  ")
	out = emitRef(out, instr.ID)
	out = out.WriteStr(".0 = insertvalue %BnSlice undef, i8* ")
	out = emitRef(out, instr.ID)
	out = out.WriteStr(".d, 0\n  ")
	out = emitRef(out, instr.ID)
	out = out.WriteStr(" = insertvalue %BnSlice ")
	out = emitRef(out, instr.ID)
	out = out.WriteStr(".0, i64 ")
	out = emitRef(out, instr.ID)
	out = out.WriteStr(".l, 1\n")
	return out
}

// emitMakeSliceInstr emits a call to bn_rt__MakeManagedSlice for
// make_slice. The `.p` alloca is hoisted to function entry by
// emitMakeSliceAllocDecl; here we only emit the call itself plus
// the store/bitcast/load that uses the (already-hoisted) `.p` slot.
func emitMakeSliceInstr(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	var elemSize int = elemSizeOf(instr.TypeArg)
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".raw = call %BnManagedSlice @bn_rt__MakeManagedSlice(i64 ")
	out = out.WriteInt(elemSize)
	out = out.WriteStr(", i64 ")
	out = emitRef(out, instr.Args[0].ID)
	out = out.WriteStr(")\n  ")
	out = out.WriteStr("store %BnManagedSlice %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".raw, %BnManagedSlice* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".p\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".bc = bitcast %BnManagedSlice* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".p to %BnManagedSlice*\n  ")
	out = emitRef(out, instr.ID)
	out = out.WriteStr(" = load %BnManagedSlice, %BnManagedSlice* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".bc\n")
	return out
}

// emitBoxInstr emits LLVM IR for OP_BOX: allocates a managed wrapper for
// a value, copies the value in, and returns a pointer to the payload.
// Branches on whether the source is an alloca (bitcast its address) or a
// scalar register (store-then-bitcast) to keep the generated IR direct.
func emitBoxInstr(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	var valTyp @types.Type = instr.Args[0].Typ
	if instr.Args[0].Op == ir.OP_ALLOC && instr.Args[0].TypeArg != nil {
		valTyp = instr.Args[0].TypeArg
	}
	var valLLVM @[]char = llvmType(valTyp)
	var sizeBytes int = typeSizeBytes(valTyp)

	if instr.Args[0].Op == ir.OP_ALLOC {
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".bc = bitcast ")
		out = out.WriteStr(valLLVM)
		out = out.WriteStr("* ")
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(" to i8*\n")
		out = out.WriteStr("  ")
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = call i8* @bn_rt__Box(i8* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".bc, i64 ")
		out = out.WriteInt(sizeBytes)
		out = out.WriteStr(")\n")
	} else {
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".tmp = alloca ")
		out = out.WriteStr(valLLVM)
		out = out.WriteStr("\n  store ")
		out = out.WriteStr(valLLVM)
		out = out.WriteByte(' ')
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(", ")
		out = out.WriteStr(valLLVM)
		out = out.WriteStr("* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".tmp\n  %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".bc = bitcast ")
		out = out.WriteStr(valLLVM)
		out = out.WriteStr("* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".tmp to i8*\n  ")
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = call i8* @bn_rt__Box(i8* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".bc, i64 ")
		out = out.WriteInt(sizeBytes)
		out = out.WriteStr(")\n")
	}
	return out
}

// emitRefIncInline emits inline LLVM IR for OP_REFINC: a nil-checked
// fast path that loads the refcount header at ptr-16, increments it,
// and stores it back — replacing the call to bn_rt__RefInc.
//
// Generates a control-flow diamond using per-emission unique labels
// (seeded from tmpSeq). The active LLVM block on entry becomes the
// "predecessor" terminating with the nil-check branch; on return the
// active block is ri.<seq>.skip, so subsequent emissions in the same
// IR block fall into it.
//
//   %ri.<seq>.null = icmp eq i8* <ptr>, null
//   br i1 %ri.<seq>.null, label %ri.<seq>.skip, label %ri.<seq>.do
// ri.<seq>.do:
//   %ri.<seq>.hdr8 = getelementptr i8, i8* <ptr>, i64 -16
//   %ri.<seq>.hdr  = bitcast i8* %ri.<seq>.hdr8 to i64*
//   %ri.<seq>.old  = load i64, i64* %ri.<seq>.hdr
//   %ri.<seq>.new  = add i64 %ri.<seq>.old, 1
//   store i64 %ri.<seq>.new, i64* %ri.<seq>.hdr
//   br label %ri.<seq>.skip
// ri.<seq>.skip:
func emitRefIncInline(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	var seq int = tmpSeq
	tmpSeq++
	// Nil check + branch (terminates the predecessor block).
	out = out.WriteStr("%ri.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".null = icmp eq i8* ")
	out = emitRef(out, instr.Args[0].ID)
	out = out.WriteStr(", null\n")
	out = out.WriteStr("  br i1 %ri.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".null, label %ri.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".skip, label %ri.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".do\n")
	// .do block: header arithmetic + load/add/store.
	out = out.WriteStr("ri.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".do:\n")
	out = out.WriteStr("  %ri.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".hdr8 = getelementptr i8, i8* ")
	out = emitRef(out, instr.Args[0].ID)
	out = out.WriteStr(", i64 -16\n")
	out = out.WriteStr("  %ri.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".hdr = bitcast i8* %ri.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".hdr8 to i64*\n")
	out = out.WriteStr("  %ri.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".old = load i64, i64* %ri.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".hdr\n")
	out = out.WriteStr("  %ri.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".new = add i64 %ri.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".old, 1\n")
	out = out.WriteStr("  store i64 %ri.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".new, i64* %ri.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".hdr\n")
	out = out.WriteStr("  br label %ri.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".skip\n")
	// .skip block: subsequent IR-instructions emit here.
	out = out.WriteStr("ri.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".skip:\n")
	return out
}

// emitRefDecInline emits inline LLVM IR for OP_REFDEC: a nil-checked
// fast path that decrements the refcount, with a slow-path call to
// bn_rt__ZeroRefDestroy(ptr, dtor) when the count hits zero.
//
//   %rd.<seq>.null = icmp eq i8* <ptr>, null
//   br i1 %rd.<seq>.null, label %rd.<seq>.skip, label %rd.<seq>.dec
// rd.<seq>.dec:
//   %rd.<seq>.hdr8 = getelementptr i8, i8* <ptr>, i64 -16
//   %rd.<seq>.hdr  = bitcast i8* %rd.<seq>.hdr8 to i64*
//   %rd.<seq>.old  = load i64, i64* %rd.<seq>.hdr
//   %rd.<seq>.new  = sub i64 %rd.<seq>.old, 1
//   store i64 %rd.<seq>.new, i64* %rd.<seq>.hdr
//   %rd.<seq>.zero = icmp eq i64 %rd.<seq>.new, 0
//   br i1 %rd.<seq>.zero, label %rd.<seq>.destroy, label %rd.<seq>.skip
// rd.<seq>.destroy:
//   call void @bn_rt__ZeroRefDestroy(i8* <ptr>, i8* <dtor>)
//   br label %rd.<seq>.skip
// rd.<seq>.skip:
//
// Args[1] is the optional destructor pointer; if absent, null is
// passed. On return the active LLVM block is rd.<seq>.skip.
func emitRefDecInline(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	var seq int = tmpSeq
	tmpSeq++
	// Nil check + branch.
	out = out.WriteStr("%rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".null = icmp eq i8* ")
	out = emitRef(out, instr.Args[0].ID)
	out = out.WriteStr(", null\n")
	out = out.WriteStr("  br i1 %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".null, label %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".skip, label %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".dec\n")
	// .dec block: decrement, then dispatch on zero.
	out = out.WriteStr("rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".dec:\n")
	out = out.WriteStr("  %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".hdr8 = getelementptr i8, i8* ")
	out = emitRef(out, instr.Args[0].ID)
	out = out.WriteStr(", i64 -16\n")
	out = out.WriteStr("  %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".hdr = bitcast i8* %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".hdr8 to i64*\n")
	out = out.WriteStr("  %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".old = load i64, i64* %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".hdr\n")
	out = out.WriteStr("  %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".new = sub i64 %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".old, 1\n")
	out = out.WriteStr("  store i64 %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".new, i64* %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".hdr\n")
	out = out.WriteStr("  %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".zero = icmp eq i64 %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".new, 0\n")
	out = out.WriteStr("  br i1 %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".zero, label %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".destroy, label %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".skip\n")
	// .destroy block: slow-path call to ZeroRefDestroy(ptr, dtor).
	out = out.WriteStr("rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".destroy:\n")
	out = out.WriteStr("  call void @bn_rt__ZeroRefDestroy(i8* ")
	out = emitRef(out, instr.Args[0].ID)
	out = out.WriteStr(", i8* ")
	if len(instr.Args) > 1 {
		out = emitRef(out, instr.Args[1].ID)
	} else {
		out = out.WriteStr("null")
	}
	out = out.WriteStr(")\n")
	out = out.WriteStr("  br label %rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".skip\n")
	// .skip block: subsequent IR-instructions emit here.
	out = out.WriteStr("rd.")
	out = out.WriteInt(seq)
	out = out.WriteStr(".skip:\n")
	return out
}

// emitDerefInstr emits a bitcast + load to dereference a managed pointer.
// funcSignatureLLVM formats the LLVM function-pointer type for a
// function-value type: `<ret>(<arg_types>)*`. fvTyp must be a
// TYP_FUNC_VALUE or TYP_MANAGED_FUNC_VALUE; its Params and Results
// drive the rendering.
func funcSignatureLLVM(fvTyp @types.Type) @[]char {
	var b buf.CharBuf = buf.New()
	if len(fvTyp.Results) == 0 {
		b = b.WriteStr("void")
	} else if len(fvTyp.Results) == 1 {
		b = b.WriteStr(llvmType(fvTyp.Results[0]))
	} else {
		// Multi-return: anonymous struct of result types.
		b = b.WriteStr("{")
		for i := 0; i < len(fvTyp.Results); i++ {
			if i > 0 { b = b.WriteStr(", ") }
			b = b.WriteStr(llvmType(fvTyp.Results[i]))
		}
		b = b.WriteStr("}")
	}
	b = b.WriteByte('(')
	for i := 0; i < len(fvTyp.Params); i++ {
		if i > 0 { b = b.WriteStr(", ") }
		b = b.WriteStr(llvmType(fvTyp.Params[i].Type))
	}
	b = b.WriteStr(")*")
	return b.Bytes()
}

// emitFuncValueVtables walks the module's instructions, collects
// unique function names referenced by OP_FUNC_VALUE, and emits one
// `@__vt.<mangled> = weak_odr constant %BnVtable {...}` global per
// name. Phase 1 leaves dtor as null (non-capturing has no captured
// ctx to clean up) and call as the function pointer (compiled-mode
// only — VM-mode population is Phase 3, see plan-function-values).
func emitFuncValueVtables(out buf.CharBuf, m @ir.Module) buf.CharBuf {
	var seen @[]@[]char
	var sigs @[]@types.Type
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if f.IsExtern { continue }
		for j := 0; j < len(f.Blocks); j++ {
			var blk @ir.Block = f.Blocks[j]
			for k := 0; k < len(blk.Instrs); k++ {
				var instr @ir.Instr = blk.Instrs[k]
				if instr.Op != ir.OP_FUNC_VALUE { continue }
				var dup bool = false
				for s := 0; s < len(seen); s++ {
					if charsEqual(seen[s], instr.StrVal) {
						dup = true
						break
					}
				}
				if dup { continue }
				seen = appendCharSliceLocal(seen, instr.StrVal)
				sigs = appendTypePtrLocal(sigs, instr.Typ)
			}
		}
	}
	if len(seen) == 0 { return out }
	for i := 0; i < len(seen); i++ {
		var mangled @[]char =
			mangle.FuncName(modulePkgName, seen[i]).Bytes()
		var sig @[]char = funcSignatureLLVM(sigs[i])
		out = out.WriteStr("@__vt.")
		out = out.WriteStr(mangled)
		out = out.WriteStr(
			" = weak_odr constant %BnVtable { i8* null, i8* bitcast (")
		out = out.WriteStr(sig)
		out = out.WriteStr(" @")
		out = out.WriteStr(mangled)
		out = out.WriteStr(" to i8*) }\n")
	}
	out = out.WriteByte('\n')
	return out
}

// appendCharSliceLocal appends a char-slice pointer to a managed
// slice. Local helper because pkg/codegen doesn't have a generic
// append for @[]@[]char yet.
func appendCharSliceLocal(s @[]@[]char, v @[]char) @[]@[]char {
	var n int = len(s)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendTypePtrLocal appends a types.Type pointer to a managed slice.
func appendTypePtrLocal(s @[]@types.Type, v @types.Type) @[]@types.Type {
	var n int = len(s)
	var ns @[]@types.Type = make_slice(@types.Type, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

func emitDerefInstr(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	var elemTyp @types.Type = instr.Typ
	var elemLLVM @[]char = llvmType(elemTyp)
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".bc = bitcast i8* ")
	out = emitRef(out, instr.Args[0].ID)
	out = out.WriteStr(" to ")
	out = out.WriteStr(elemLLVM)
	out = out.WriteStr("*\n  ")
	out = emitRef(out, instr.ID)
	out = out.WriteStr(" = load ")
	out = out.WriteStr(elemLLVM)
	out = out.WriteStr(", ")
	out = out.WriteStr(elemLLVM)
	out = out.WriteStr("* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".bc\n")
	return out
}
