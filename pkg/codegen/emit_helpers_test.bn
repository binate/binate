package "pkg/codegen"

import "pkg/ast"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/ir"
import "pkg/parser"

// Tests for extracted emitInstr helpers (nontrivial op handlers).

func TestEmitAllocStructZeroInit() testing.TestResult {
	var src *[]const char = "package \"main\"\ntype P struct { X int }\nfunc main() { var p P }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "alloca") {
		return fail("expected alloca for struct")
	}
	if !contains(out, "zeroinitializer") {
		return fail("expected zeroinitializer for struct")
	}
	var pass testing.TestResult
	return pass
}
func TestEmitGetFieldPtr() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type P struct { X int; Y int }\n")
	cb = cb.WriteStr("func main() { var p P; p.Y = 5 }\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if !contains(out, "getelementptr inbounds") {
		return fail("expected getelementptr for field access")
	}
	var pass testing.TestResult
	return pass
}
func TestEmitMultiReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func f() (int, int) { return 1, 2 }\n")
	cb = cb.WriteStr("func main() { a, b := f() }\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if !contains(out, "insertvalue") {
		return fail("expected insertvalue for multi-return packing")
	}
	var pass testing.TestResult
	return pass
}
func TestEmitMakeSlice() testing.TestResult {
	var src *[]const char = "package \"main\"\nfunc main() { var s @[]int = make_slice(int, 5) }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "bn_pkg__rt__MakeManagedSlice") {
		return fail("expected MakeManagedSlice call")
	}
	var pass testing.TestResult
	return pass
}
func TestEmitBoxInstr() testing.TestResult {
	var src *[]const char = "package \"main\"\nfunc main() { var p *int = box(42) }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "bn_pkg__rt__Box") {
		return fail("expected Box call")
	}
	var pass testing.TestResult
	return pass
}
func TestEmitManagedToRaw() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func f() *[]int {\n")
	cb = cb.WriteStr("\tvar s @[]int = make_slice(int, 3)\n")
	cb = cb.WriteStr("\treturn s\n")
	cb = cb.WriteStr("}\n")
	cb = cb.WriteStr("func main() { f() }\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if !contains(out, "extractvalue %BnManagedSlice") {
		return fail("expected extractvalue from managed slice")
	}
	var pass testing.TestResult
	return pass
}
// indexAfter returns the index of `needle` in `haystack` at or after
// `start`, or -1 if not found. Used to verify ordering in LLVM IR.
func indexAfter(haystack *[]const char, needle *[]const char, start int) int {
	if start < 0 { start = 0 }
	for i := start; i+len(needle) <= len(haystack); i++ {
		var match bool = true
		for j := 0; j < len(needle); j++ {
			if haystack[i+j] != needle[j] {
				match = false
				break
			}
		}
		if match { return i }
	}
	return -1
}
// `var` declarations inside a for-loop body must not emit an `alloca`
// instruction inside the loop-body block — otherwise the native stack
// leaks per iteration (LLVM allocas in non-entry blocks allocate
// fresh stack each time the block runs and aren't freed until the
// function returns). The fix hoists all allocas to the entry block.
//
// Assertion: every `alloca` substring in the function appears before
// the `for.body:` block label.
func TestAllocaHoistedOutOfLoopBody() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar sum int = 0\n")
	cb = cb.WriteStr("\tfor i := 0; i < 10; i++ {\n")
	cb = cb.WriteStr("\t\tvar local int = i * 2\n")
	cb = cb.WriteStr("\t\tsum = sum + local\n")
	cb = cb.WriteStr("\t}\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	var bodyIdx int = indexAfter(out, "for.body", 0)
	if bodyIdx < 0 { return fail("expected for.body block in output") }
	// No `alloca` must appear at or after for.body.
	var allocaAfter int = indexAfter(out, "alloca", bodyIdx)
	if allocaAfter >= 0 {
		return fail("found alloca inside/after for.body — should be hoisted to entry")
	}
	// Sanity: there must be at least one alloca somewhere (sum + i + local).
	var allocaAny int = indexAfter(out, "alloca", 0)
	if allocaAny < 0 { return fail("expected some alloca in output") }
	var pass testing.TestResult
	return pass
}
// Same check for struct allocas: the `alloca` line must be in entry,
// but the zero-init `store zeroinitializer` should remain at the
// declaration site so the slot is re-zeroed on each iteration.
func TestStructAllocaHoistedZeroInitStaysInBody() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type P struct { X int }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tfor i := 0; i < 3; i++ {\n")
	cb = cb.WriteStr("\t\tvar p P\n")
	cb = cb.WriteStr("\t\tp.X = i\n")
	cb = cb.WriteStr("\t}\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	var bodyIdx int = indexAfter(out, "for.body", 0)
	if bodyIdx < 0 { return fail("expected for.body block") }
	// alloca must not appear in/after for.body
	if indexAfter(out, "alloca", bodyIdx) >= 0 {
		return fail("struct alloca should be hoisted, not in for.body")
	}
	// zeroinitializer must appear in/after for.body (re-zeroed per iteration)
	if indexAfter(out, "zeroinitializer", bodyIdx) < 0 {
		return fail("expected zero-init store in for.body for re-zeroing per iteration")
	}
	var pass testing.TestResult
	return pass
}
