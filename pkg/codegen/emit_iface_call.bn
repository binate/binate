package "pkg/codegen"

import "pkg/buf"
import "pkg/ir"
import "pkg/types"

// ============================================================
// Interface-value dispatch — OP_CALL_IFACE_METHOD, OP_IFACE_DTOR
// ============================================================
//
// Split out of emit_impls.bn for file-size hygiene; emit_impls.bn
// keeps the vtable-emission side (impl vtable globals + slot wiring
// + writeFuncPtrType / writeFuncResultLLVM helpers).

// emitCallIfaceMethod lowers OP_CALL_IFACE_METHOD: dispatch through
// the vtable of an interface value. Args[0] is the iv value
// (TYP_INTERFACE_VALUE / TYP_INTERFACE_VALUE_MANAGED); Args[1..] are
// user args; Index is the method slot.
//
// LLVM shape:
//
//   %dt   = extractvalue %BnIfaceValue %iv, 0   ; data ptr
//   %vt8  = extractvalue %BnIfaceValue %iv, 1   ; vtable ptr (i8*)
//   %vt   = bitcast i8* %vt8 to i8**             ; -> array of slots
//   %sp   = getelementptr inbounds i8*, i8** %vt, i64 <Index>
//   %fp   = load i8*, i8** %sp                   ; function pointer
//   %fn   = bitcast i8* %fp to <ret>(i8*, <argTys>)*
//   %r    = call <ret> %fn(i8* %dt, <args>)
//
// Slice 2.3a-3 of plan-interface-syntax-revision.md.
func emitCallIfaceMethod(out buf.CharBuf,
		instr @ir.Instr) buf.CharBuf {
	var iv @ir.Instr = instr.Args[0]
	var nArgs int = len(instr.Args) - 1
	var isVoid bool = instr.Typ == nil ||
		instr.Typ.Kind == types.TYP_VOID
	// Post round-5: aggregate returns >16 bytes use sret universally
	// (see emit.bn:254 and emit_debug.bn).  The vtable-dispatched
	// thunk we're calling here is a regular Binate function emitted
	// by emitFuncDbg, so it also uses sret for big returns.  Bitcast
	// signature and call shape must match.
	var useSret bool = !isVoid && needsSret(instr.Typ)

	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".dt = extractvalue %BnIfaceValue ")
	out = emitRef(out, iv.ID)
	out = out.WriteStr(", 0\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8 = extractvalue %BnIfaceValue ")
	out = emitRef(out, iv.ID)
	out = out.WriteStr(", 1\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt = bitcast i8* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8 to i8**\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(
		".sp = getelementptr inbounds i8*, i8** %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt, i64 ")
	// instr.Index is the absolute vtable slot (Slice E.4 of
	// plan-interface-embedding.md).  For a non-extended interface
	// it equals method_position + 1 (since slot 0 is the dtor);
	// for an extended interface it accounts for the concat layout's
	// nested parent any-blocks.  findInterfaceMethod produces it.
	out = out.WriteInt(instr.Index)
	out = out.WriteStr("\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".fp = load i8*, i8** %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".sp\n  ")
	// Bitcast the function pointer to the thunk's actual signature:
	//   sret form: void(ptr sret(<ret>) align 8, i8*, args...)*
	//   direct:    <ret>(i8*, args...)*   or   void(i8*, args...)*
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".fn = bitcast i8* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".fp to ")
	if useSret {
		out = out.WriteStr("void")
	} else if isVoid {
		out = out.WriteStr("void")
	} else {
		out = out.WriteStr(llvmType(instr.Typ))
	}
	out = out.WriteByte('(')
	if useSret {
		out = out.WriteStr("ptr, ")
	}
	out = out.WriteStr("i8*")
	for i := 0; i < nArgs; i++ {
		var argInstr @ir.Instr = instr.Args[i+1]
		out = out.WriteStr(", ")
		out = out.WriteStr(llvmType(argInstr.Typ))
	}
	out = out.WriteStr(")*\n  ")

	if useSret {
		// Need an alloca for the sret buffer.  Emit inline (small —
		// per-call cost is one alloca; hoisting via emitDebug would
		// be cleaner but inline keeps emit_impls.bn self-contained).
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".rb = alloca ")
		out = out.WriteStr(llvmType(instr.Typ))
		out = out.WriteStr("\n  ")
		out = out.WriteStr("call void %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".fn(ptr sret(")
		out = out.WriteStr(llvmType(instr.Typ))
		out = out.WriteStr(") align 8 %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".rb, i8* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".dt")
	} else if isVoid {
		out = out.WriteStr("call void %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".fn(i8* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".dt")
	} else {
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = call ")
		out = out.WriteStr(llvmType(instr.Typ))
		out = out.WriteStr(" %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".fn(i8* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".dt")
	}
	for i := 0; i < nArgs; i++ {
		out = out.WriteStr(", ")
		var argInstr @ir.Instr = instr.Args[i+1]
		out = out.WriteStr(llvmType(argInstr.Typ))
		out = out.WriteByte(' ')
		out = emitRef(out, argInstr.ID)
	}
	out = out.WriteStr(")\n")
	if useSret {
		// Load the result from the sret alloca to produce the SSA value.
		out = out.WriteStr("  ")
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = load ")
		out = out.WriteStr(llvmType(instr.Typ))
		out = out.WriteStr(", ptr %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".rb\n")
	}
	return out
}

// emitIfaceDtor lowers OP_IFACE_DTOR: load slot 0 of an interface
// value's vtable as an i8* (matches OP_FUNC_HANDLE's shape, which
// is the type of the dtor operand of OP_REFDEC). Args[0] is the iv.
//
// LLVM shape:
//
//   %vt8 = extractvalue %BnIfaceValue %iv, 1   ; vtable ptr (i8*)
//   %vt  = bitcast i8* %vt8 to i8**             ; -> array of slots
//   %sp  = getelementptr inbounds i8*, i8** %vt, i64 0
//   %r   = load i8*, i8** %sp                   ; dtor i8*
//
// Slice 2.5b of plan-interface-syntax-revision.md.
func emitIfaceDtor(out buf.CharBuf,
		instr @ir.Instr) buf.CharBuf {
	var iv @ir.Instr = instr.Args[0]
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8 = extractvalue %BnIfaceValue ")
	out = emitRef(out, iv.ID)
	out = out.WriteStr(", 1\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt = bitcast i8* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8 to i8**\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(
		".sp = getelementptr inbounds i8*, i8** %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt, i64 0\n  ")
	out = emitRef(out, instr.ID)
	out = out.WriteStr(" = load i8*, i8** %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".sp\n")
	return out
}
