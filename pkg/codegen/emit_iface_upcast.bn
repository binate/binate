package "pkg/codegen"

import "pkg/binate/buf"
import "pkg/ir"

// OP_IFACE_UPCAST lowering: rebuild an interface value with the
// source's data pointer and a vtable pointer adjusted to point at
// the target ancestor's nested sub-vtable within the source's
// concat-laid-out vtable.  See plan-interface-embedding.md Slice
// E.4 part 2b.
//
// The slot offset is statically known per (srcIface, targetIface)
// pair: target's full vtable starts at
// `IfaceParentSlotOffset(srcIface, targetIface) * sizeof(i8*)`
// bytes into srcIface's vtable.  After the offset, the layout
// begins with target's any-block (matching `*Target`'s expected
// vtable shape), then target's parents, then target's own methods.
//
// LLVM shape:
//
//   %dt    = extractvalue %BnIfaceValue %src, 0   ; data ptr
//   %vt8   = extractvalue %BnIfaceValue %src, 1   ; vtable ptr (i8*)
//   %vt    = bitcast i8* %vt8 to i8**
//   %new   = getelementptr inbounds i8*, i8** %vt, i64 <offset>
//   %nvt8  = bitcast i8** %new to i8*
//   %iv.0  = insertvalue %BnIfaceValue undef, i8* %dt, 0
//   %iv    = insertvalue %BnIfaceValue %iv.0, i8* %nvt8, 1
func emitIfaceUpcast(out buf.CharBuf,
		instr @ir.Instr) buf.CharBuf {
	var src @ir.Instr = instr.Args[0]
	var offset int = 0
	if src.Typ != nil && src.Typ.Elem != nil &&
			instr.Typ != nil && instr.Typ.Elem != nil {
		offset = ir.IfaceParentSlotOffset(src.Typ.Elem.Pkg,
			src.Typ.Elem.Name, instr.Typ.Elem.Pkg,
			instr.Typ.Elem.Name)
	}
	// Extract data from source iv.
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".dt = extractvalue %BnIfaceValue ")
	out = emitRef(out, src.ID)
	out = out.WriteStr(", 0\n  ")
	// Extract vtable from source iv and adjust by offset.
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8 = extractvalue %BnIfaceValue ")
	out = emitRef(out, src.ID)
	out = out.WriteStr(", 1\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt = bitcast i8* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8 to i8**\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".new = getelementptr inbounds i8*, i8** %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt, i64 ")
	out = out.WriteInt(offset)
	out = out.WriteStr("\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".nvt8 = bitcast i8** %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".new to i8*\n  ")
	// Build new iv.
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".0 = insertvalue %BnIfaceValue undef, i8* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".dt, 0\n  ")
	out = emitRef(out, instr.ID)
	out = out.WriteStr(" = insertvalue %BnIfaceValue %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".0, i8* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".nvt8, 1\n")
	return out
}
