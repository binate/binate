package "pkg/codegen"

import "pkg/buf"
import "pkg/ir"
import "pkg/mangle"
import "pkg/types"

// ============================================================
// Interface vtable emission
// ============================================================

// currentModuleImpls holds the active module's Impls list during
// EmitModule. Set when emitImplVtables runs (effectively at the
// start of EmitModule); read by OP_IFACE_VALUE lowering in
// emit_instr.bn to spell the vtable bitcast's source array size.
// Cleared between modules to keep test runs isolated.
var currentModuleImpls @[]@ir.ImplInfo

// emitImplVtables walks m.Impls and emits one `@__ivt.<mangled>`
// global per (impl, interface) pair. The global is a `[N x i8*]`
// constant where N is the interface's method count; each slot is
// the address of the impl method that satisfies the corresponding
// interface method, bitcast through the impl method's actual LLVM
// type to i8*. Dispatch sites (Slice 2.3a-3) bitcast the slot back
// to a uniform shim signature when calling.
//
// Slice 2.3a-1 of plan-interface-syntax-revision.md.
func emitImplVtables(out buf.CharBuf, m @ir.Module) buf.CharBuf {
	currentModuleImpls = m.Impls
	if len(m.Impls) == 0 {
		return out
	}
	for i := 0; i < len(m.Impls); i++ {
		out = emitImplVtable(out, m, m.Impls[i])
	}
	out = out.WriteByte('\n')
	return out
}

// vtableSlotCount returns the total number of slots in the vtable
// global named `name` — len(MethodFuncs) + 1 to account for the
// dtor at slot 0 — or 0 if no impl matches. Read from the
// currentModuleImpls cache populated by emitImplVtables. Used by
// OP_IFACE_VALUE lowering to spell the bitcast source type.
func vtableSlotCount(name *[]const char) int {
	for i := 0; i < len(currentModuleImpls); i++ {
		var info @ir.ImplInfo = currentModuleImpls[i]
		if info == nil { continue }
		var built @[]char = implVtableName(info)
		if charsEqual(built, name) {
			return len(info.MethodFuncs) + 1
		}
	}
	return 0
}

// emitImplVtable emits one vtable global for the given (impl, iface)
// info. Slot 0 is the receiver type's struct dtor (or i8* null for
// types that don't need destruction); slots 1..N+1 hold the impl
// methods in interface declaration order. Slice 2.5 of plan-
// interface-syntax-revision.md.
func emitImplVtable(out buf.CharBuf, m @ir.Module,
		info @ir.ImplInfo) buf.CharBuf {
	var nMethods int = len(info.MethodFuncs)
	var nSlots int = nMethods + 1
	var vtName @[]char = implVtableName(info)
	out = out.WriteStr("@")
	out = out.WriteStr(vtName)
	out = out.WriteStr(" = weak_odr constant [")
	out = out.WriteInt(nSlots)
	out = out.WriteStr(" x i8*] [")
	out = emitImplVtableDtorSlot(out, m, info.DtorFuncName)
	for j := 0; j < nMethods; j++ {
		out = out.WriteStr(", ")
		out = emitImplVtableSlot(out, m, info.MethodFuncs[j])
	}
	out = out.WriteStr("]\n")
	return out
}

// emitImplVtableDtorSlot emits slot 0 of the vtable: the receiver
// type's dtor (or i8* null if no dtor was emitted for this type —
// the type doesn't have managed fields, so plain rt.Free suffices
// at refcount-zero).
func emitImplVtableDtorSlot(out buf.CharBuf, m @ir.Module,
		dtorName @[]char) buf.CharBuf {
	if len(dtorName) == 0 {
		return out.WriteStr("i8* null")
	}
	var f @ir.Func = lookupModuleFunc(m, dtorName)
	if f == nil {
		return out.WriteStr("i8* null")
	}
	out = out.WriteStr("i8* bitcast (")
	out = writeFuncPtrType(out, f)
	out = out.WriteStr(" @")
	out = writeBuf(out, mangle.FuncName(modulePkgName, dtorName))
	out = out.WriteStr(" to i8*)")
	return out
}

// implVtableName builds the LLVM symbol name for an impl vtable in
// the canonical form
// `__ivt.bn_<recv_pkg>__<recv_name>__<iface_pkg>__<iface_name>` (the
// (R, I)-canonical mangling adopted by Slice 2.6 of plan-cross-
// package-interfaces.md). The fields come from ImplInfo, populated
// at IR-gen collection time; the iface name is alias-resolved there.
// weak_odr linkage matches function-value vtables — duplicate
// emissions across translation units dedupe at link time, which is
// what makes the "any TU may declare the impl" rule sound.
func implVtableName(info @ir.ImplInfo) @[]char {
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("__ivt.bn_")
	b = b.WriteStr(info.RecvPkg)
	b = b.WriteStr("__")
	b = b.WriteStr(info.RecvTypeName)
	b = b.WriteStr("__")
	b = b.WriteStr(info.IfacePkg)
	b = b.WriteStr("__")
	b = b.WriteStr(info.IfaceName)
	return b.Bytes()
}

// emitImplVtableSlot emits a single `i8* bitcast (<sig>* @<func> to
// i8*)` slot. Looks up the impl method in m.Funcs to recover its
// signature; emits an `i8* null` slot if not found (defensive — the
// satisfaction check should have validated method presence).
func emitImplVtableSlot(out buf.CharBuf, m @ir.Module,
		funcName @[]char) buf.CharBuf {
	var f @ir.Func = lookupModuleFunc(m, funcName)
	if f == nil {
		return out.WriteStr("i8* null")
	}
	out = out.WriteStr("i8* bitcast (")
	out = writeFuncPtrType(out, f)
	out = out.WriteStr(" @")
	out = writeBuf(out, mangle.FuncName(modulePkgName, funcName))
	out = out.WriteStr(" to i8*)")
	return out
}

// lookupModuleFunc returns the ir.Func with the given canonical
// name, or nil if absent.
func lookupModuleFunc(m @ir.Module, name @[]char) @ir.Func {
	for i := 0; i < len(m.Funcs); i++ {
		if charsEqual(m.Funcs[i].Name, name) {
			return m.Funcs[i]
		}
	}
	return nil
}

// writeFuncPtrType writes the LLVM function-pointer type for an
// ir.Func — receiver and other params spelled out so the bitcast
// at the vtable slot is well-formed.
func writeFuncPtrType(out buf.CharBuf, f @ir.Func) buf.CharBuf {
	out = writeFuncResultLLVM(out, f)
	out = out.WriteByte('(')
	for i := 0; i < len(f.Params); i++ {
		if i > 0 { out = out.WriteStr(", ") }
		out = out.WriteStr(llvmType(f.Params[i].Typ))
	}
	out = out.WriteStr(")*")
	return out
}

// emitCallIfaceMethod lowers OP_CALL_IFACE_METHOD: dispatch through
// the vtable of an interface value. Args[0] is the iv value
// (TYP_INTERFACE_VALUE / TYP_INTERFACE_VALUE_MANAGED); Args[1..] are
// user args; Index is the method slot.
//
// LLVM shape:
//
//   %dt   = extractvalue %BnIfaceValue %iv, 0   ; data ptr
//   %vt8  = extractvalue %BnIfaceValue %iv, 1   ; vtable ptr (i8*)
//   %vt   = bitcast i8* %vt8 to i8**             ; -> array of slots
//   %sp   = getelementptr inbounds i8*, i8** %vt, i64 <Index>
//   %fp   = load i8*, i8** %sp                   ; function pointer
//   %fn   = bitcast i8* %fp to <ret>(i8*, <argTys>)*
//   %r    = call <ret> %fn(i8* %dt, <args>)
//
// Slice 2.3a-3 of plan-interface-syntax-revision.md.
func emitCallIfaceMethod(out buf.CharBuf,
		instr @ir.Instr) buf.CharBuf {
	var iv @ir.Instr = instr.Args[0]
	var nArgs int = len(instr.Args) - 1
	var isVoid bool = instr.Typ == nil ||
		instr.Typ.Kind == types.TYP_VOID

	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".dt = extractvalue %BnIfaceValue ")
	out = emitRef(out, iv.ID)
	out = out.WriteStr(", 0\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8 = extractvalue %BnIfaceValue ")
	out = emitRef(out, iv.ID)
	out = out.WriteStr(", 1\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt = bitcast i8* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8 to i8**\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(
		".sp = getelementptr inbounds i8*, i8** %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt, i64 ")
	// +1 to skip the dtor at slot 0 (Slice 2.5).
	out = out.WriteInt(instr.Index + 1)
	out = out.WriteStr("\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".fp = load i8*, i8** %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".sp\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".fn = bitcast i8* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".fp to ")
	if isVoid { out = out.WriteStr("void") } else {
		out = out.WriteStr(llvmType(instr.Typ))
	}
	out = out.WriteStr("(i8*")
	for i := 0; i < nArgs; i++ {
		var argInstr @ir.Instr = instr.Args[i+1]
		out = out.WriteStr(", ")
		out = out.WriteStr(llvmType(argInstr.Typ))
	}
	out = out.WriteStr(")*\n  ")

	if isVoid {
		out = out.WriteStr("call void %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".fn(i8* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".dt")
	} else {
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = call ")
		out = out.WriteStr(llvmType(instr.Typ))
		out = out.WriteStr(" %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".fn(i8* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".dt")
	}
	for i := 0; i < nArgs; i++ {
		out = out.WriteStr(", ")
		var argInstr @ir.Instr = instr.Args[i+1]
		out = out.WriteStr(llvmType(argInstr.Typ))
		out = out.WriteByte(' ')
		out = emitRef(out, argInstr.ID)
	}
	out = out.WriteStr(")\n")
	return out
}

// emitIfaceDtor lowers OP_IFACE_DTOR: load slot 0 of an interface
// value's vtable as an i8* (matches OP_FUNC_ADDR's shape, which is
// the type of the dtor operand of OP_REFDEC). Args[0] is the iv.
//
// LLVM shape:
//
//   %vt8 = extractvalue %BnIfaceValue %iv, 1   ; vtable ptr (i8*)
//   %vt  = bitcast i8* %vt8 to i8**             ; -> array of slots
//   %sp  = getelementptr inbounds i8*, i8** %vt, i64 0
//   %r   = load i8*, i8** %sp                   ; dtor i8*
//
// Slice 2.5b of plan-interface-syntax-revision.md.
func emitIfaceDtor(out buf.CharBuf,
		instr @ir.Instr) buf.CharBuf {
	var iv @ir.Instr = instr.Args[0]
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8 = extractvalue %BnIfaceValue ")
	out = emitRef(out, iv.ID)
	out = out.WriteStr(", 1\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt = bitcast i8* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8 to i8**\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(
		".sp = getelementptr inbounds i8*, i8** %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt, i64 0\n  ")
	out = emitRef(out, instr.ID)
	out = out.WriteStr(" = load i8*, i8** %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".sp\n")
	return out
}

// writeFuncResultLLVM writes an ir.Func's result-type form: void /
// single-type / multi-return-struct. Mirrors writeFuncResultsLLVM
// in emit_funcvals.bn but takes an ir.Func instead of a func-value
// types.Type.
func writeFuncResultLLVM(out buf.CharBuf, f @ir.Func) buf.CharBuf {
	if len(f.Results) == 0 {
		return out.WriteStr("void")
	}
	if len(f.Results) == 1 {
		return out.WriteStr(llvmType(f.Results[0]))
	}
	if f.MultiReturnType != nil {
		return out.WriteStr(llvmType(f.MultiReturnType))
	}
	out = out.WriteStr("{")
	for i := 0; i < len(f.Results); i++ {
		if i > 0 { out = out.WriteStr(", ") }
		out = out.WriteStr(llvmType(f.Results[i]))
	}
	return out.WriteStr("}")
}

