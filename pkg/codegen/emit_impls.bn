package "pkg/codegen"

import "pkg/buf"
import "pkg/ir"
import "pkg/mangle"
import "pkg/types"

// ============================================================
// Interface vtable emission
// ============================================================

// currentModuleImpls holds the active module's Impls list during
// EmitModule. Set when emitImplVtables runs (effectively at the
// start of EmitModule); read by OP_IFACE_VALUE lowering in
// emit_instr.bn to spell the vtable bitcast's source array size.
// Cleared between modules to keep test runs isolated.
var currentModuleImpls @[]@ir.ImplInfo

// currentModuleImportedImpls is the parallel cache for imports
// (Slice 2.8). vtableSlotCount walks both so cross-package
// OP_IFACE_VALUE sites get the correct array size for the bitcast.
var currentModuleImportedImpls @[]@ir.ImplInfo

// emitImplVtables walks m.Impls and emits one `@__ivt.<mangled>`
// global per (impl, interface) pair. The global is a `[N x i8*]`
// constant where N is the interface's method count; each slot is
// the address of the impl method that satisfies the corresponding
// interface method, bitcast through the impl method's actual LLVM
// type to i8*. Dispatch sites (Slice 2.3a-3) bitcast the slot back
// to a uniform shim signature when calling.
//
// Slice 2.3a-1 of plan-interface-syntax-revision.md.
func emitImplVtables(out buf.CharBuf, m @ir.Module) buf.CharBuf {
	currentModuleImpls = m.Impls
	currentModuleImportedImpls = m.ImportedImpls
	if len(m.Impls) == 0 && len(m.ImportedImpls) == 0 {
		return out
	}
	for i := 0; i < len(m.Impls); i++ {
		out = emitImplVtable(out, m, m.Impls[i])
	}
	// Slice 2.8: declare imported vtables as external so this TU's
	// references resolve at link time. The vtable's actual definition
	// is in the imported package's TU, with weak_odr linkage.
	// Slice 2.9: skip imported entries that duplicate a local entry
	// — the local definition (also weak_odr) already provides the
	// symbol, and emitting an `external constant` declaration on top
	// of a local definition is a redefinition error.
	for i := 0; i < len(m.ImportedImpls); i++ {
		if importedImplCoveredLocally(m.Impls, m.ImportedImpls[i]) {
			continue
		}
		out = emitImportedImplVtableDecl(out, m, m.ImportedImpls[i])
	}
	out = out.WriteByte('\n')
	return out
}

// importedImplCoveredLocally reports whether a local impl entry
// covers the same canonical (R, I) pair as `imp`. When true, the
// imported entry's external declaration would conflict with the
// local definition (both are weak_odr; LLVM treats two definitions
// of the same symbol — even weak_odr + extern — as a redefinition
// error). Slice 2.9.
func importedImplCoveredLocally(local @[]@ir.ImplInfo,
		imp @ir.ImplInfo) bool {
	if imp == nil { return false }
	for i := 0; i < len(local); i++ {
		var info @ir.ImplInfo = local[i]
		if info == nil { continue }
		if !charsEqual(info.RecvPkg, imp.RecvPkg) { continue }
		if !charsEqual(info.RecvTypeName, imp.RecvTypeName) {
			continue
		}
		if !charsEqual(info.IfacePkg, imp.IfacePkg) { continue }
		if !charsEqual(info.IfaceName, imp.IfaceName) { continue }
		return true
	}
	return false
}

// emitImportedImplVtableDecl emits an `external constant [N x i8*]`
// declaration for a vtable defined in an imported package's TU. The
// array size must match what the imported TU emitted: N+1 (dtor slot
// + N method slots), where N is the canonical interface's method
// count discoverable via vtableSlotCountForInfo. Slice 2.8.
func emitImportedImplVtableDecl(out buf.CharBuf, m @ir.Module,
		info @ir.ImplInfo) buf.CharBuf {
	var nSlots int = vtableSlotCountForInfo(info)
	if nSlots == 0 { return out }
	var vtName @[]char = implVtableName(info)
	out = out.WriteStr("@")
	out = out.WriteStr(vtName)
	out = out.WriteStr(" = external constant [")
	out = out.WriteInt(nSlots)
	out = out.WriteStr(" x i8*]\n")
	return out
}

// vtableSlotCount returns the total number of slots in the vtable
// global named `name`, computed under the concat layout (Slice E.3):
// dtor any-block + recursive parent vtables + own methods.  Returns
// 0 if no impl matches.  Slice 2.8 also walks the imported-impl
// list so cross-package OP_IFACE_VALUE sites can spell the bitcast
// source type with the right array size.
func vtableSlotCount(name *[]const char) int {
	for i := 0; i < len(currentModuleImpls); i++ {
		var info @ir.ImplInfo = currentModuleImpls[i]
		if info == nil { continue }
		var built @[]char = implVtableName(info)
		if charsEqual(built, name) {
			return vtableSlotCountForInfo(info)
		}
	}
	for i := 0; i < len(currentModuleImportedImpls); i++ {
		var info @ir.ImplInfo = currentModuleImportedImpls[i]
		if info == nil { continue }
		var built @[]char = implVtableName(info)
		if charsEqual(built, name) {
			return vtableSlotCountForInfo(info)
		}
	}
	return 0
}

// vtableSlotCountForInfo returns the full vtable slot count for an
// `(R, I)` pair under the concat layout from
// plan-interface-embedding.md:
//   size(I) = 1 (any-block: dtor) + sum(size(P) for P in I.Parents)
//                                 + len(I's own methods)
// For interfaces with no parents this reduces to N+1 — the original
// Slice 2.5 / 2.8 layout.  Used by both vtable emission (here) and
// imported-impl declarations (Slice 2.8) so both sides agree on
// the array size regardless of which TU defines the vtable.
func vtableSlotCountForInfo(info @ir.ImplInfo) int {
	return ir.IfaceFullVtableSize(info.IfacePkg, info.IfaceName)
}

// emitImplVtable emits one vtable global for the `(R, I)` pair on
// `info`, with the concat layout from
// plan-interface-embedding.md:
//   [any-block: R's dtor]
//   for each parent P (declaration order): full vtable of (R, P)
//                                          (recursive)
//   R's methods for I's own methods
// For non-extending interfaces this reduces to slot 0 = dtor +
// slots 1..N+1 = own methods — the original Slice 2.5 layout.
//
// The recursive structure is materialized inline: when emitting
// (R, Child), we re-emit the parent's slot values (same `i8*
// bitcast (... @method to i8*)` expressions) at the right offsets,
// rather than referencing the parent's symbol via GEP — this is
// what makes `*Child → *Parent` upcast work as a fixed pointer
// offset (Slice E.4).  The parent's symbol is still emitted
// separately for direct `*Parent` use.
func emitImplVtable(out buf.CharBuf, m @ir.Module,
		info @ir.ImplInfo) buf.CharBuf {
	var nSlots int = vtableSlotCountForInfo(info)
	var vtName @[]char = implVtableName(info)
	out = out.WriteStr("@")
	out = out.WriteStr(vtName)
	out = out.WriteStr(" = weak_odr constant [")
	out = out.WriteInt(nSlots)
	out = out.WriteStr(" x i8*] [")
	out = emitImplVtableLayout(out, m, info, info.IfacePkg,
		info.IfaceName, true)
	out = out.WriteStr("]\n")
	return out
}

// emitImplVtableLayout writes the slot values for a single
// `(R, X)` block (where X is identified by ifacePkg / ifaceName)
// into a vtable constant initializer.  `isFirst` indicates
// whether the caller has already written a leading comma — false
// means a leading ", " is emitted before the dtor slot.
//
// The layout written is: dtor, then for each parent P of X a
// nested layout (recursive), then X's own method slots.  The
// recursion bottoms out at interfaces with no parents — those
// emit just `[dtor, m1, m2, ...]`.
func emitImplVtableLayout(out buf.CharBuf, m @ir.Module,
		info @ir.ImplInfo, ifacePkg *[]const char,
		ifaceName *[]const char, isFirst bool) buf.CharBuf {
	if !isFirst {
		out = out.WriteStr(", ")
	}
	out = emitImplVtableDtorSlot(out, m, info.DtorFuncName)
	// Recurse into each parent's full vtable.
	var parentPkgs @[]@[]char = ir.IfaceParentPkgs(ifacePkg,
		ifaceName)
	var parentNames @[]@[]char = ir.IfaceParentNames(ifacePkg,
		ifaceName)
	for i := 0; i < len(parentPkgs); i++ {
		out = emitImplVtableLayout(out, m, info, parentPkgs[i],
			parentNames[i], false)
	}
	// Own methods of this level, in declaration order.
	var ownMethods @[]@[]char = ir.IfaceOwnMethodNames(ifacePkg,
		ifaceName)
	for i := 0; i < len(ownMethods); i++ {
		out = out.WriteStr(", ")
		var qualified @[]char = buildMethodFuncName(info.RecvPkg,
			info.RecvTypeName, ownMethods[i])
		// plan-primitives-impl-interfaces.md § "Interface-value
		// dispatch and value receivers": value-receiver methods get
		// their iv vtable slot pointed at a generated *const T-
		// receiver thunk (the dispatch path passes the iv data
		// pointer, which the thunk derefs before tail-calling the
		// underlying method).  Pointer-receiver methods need no
		// thunk; LookupVtableSlotName returns the original name.
		var slotName @[]char = ir.LookupVtableSlotName(m, qualified)
		out = emitImplVtableSlot(out, m, slotName)
	}
	return out
}

// buildMethodFuncName builds `<recvPkg>.<recvName>.<methodName>`
// — the IR-level qualified name a method registered on the
// receiver type would have under methodFuncName / methodQualName.
// Duplicated in codegen for the parent-slot emission path so we
// don't reach across into pkg/ir for what's purely a name format.
func buildMethodFuncName(recvPkg *[]const char,
		recvName *[]const char,
		methodName *[]const char) @[]char {
	// Short-name recvPkg so this matches the short IR method name
	// produced by buildMethodQualName (full-path migration — see
	// pkg/mangle).
	var b buf.CharBuf = buf.New()
	b = b.WriteStr(mangle.PkgShortName(recvPkg))
	b = b.WriteByte('.')
	b = b.WriteStr(recvName)
	b = b.WriteByte('.')
	b = b.WriteStr(methodName)
	return b.Bytes()
}

// emitImplVtableDtorSlot emits slot 0 of the vtable: the receiver
// type's dtor (or i8* null if no dtor was emitted for this type —
// the type doesn't have managed fields, so plain rt.Free suffices
// at refcount-zero).
func emitImplVtableDtorSlot(out buf.CharBuf, m @ir.Module,
		dtorName @[]char) buf.CharBuf {
	if len(dtorName) == 0 {
		return out.WriteStr("i8* null")
	}
	var f @ir.Func = lookupModuleFunc(m, dtorName)
	if f == nil {
		return out.WriteStr("i8* null")
	}
	out = out.WriteStr("i8* bitcast (")
	out = writeFuncPtrType(out, f)
	out = out.WriteStr(" @")
	out = writeBuf(out, mangle.FuncName(modulePkgName, dtorName))
	out = out.WriteStr(" to i8*)")
	return out
}

// implVtableName builds the LLVM symbol name for an impl vtable in
// the canonical form
// `__ivt.bn_<recv_pkg>__<recv_name>__<iface_pkg>__<iface_name>` (the
// (R, I)-canonical mangling adopted by Slice 2.6 of plan-cross-
// package-interfaces.md). The fields come from ImplInfo, populated
// at IR-gen collection time; the iface name is alias-resolved there.
// weak_odr linkage matches function-value vtables — duplicate
// emissions across translation units dedupe at link time, which is
// what makes the "any TU may declare the impl" rule sound.
func implVtableName(info @ir.ImplInfo) @[]char {
	// RecvPkg / IfacePkg may be full paths (full-path migration —
	// see pkg/mangle); short-name them so the symbol stays at the
	// current form and no slash leaks into the identifier.
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("__ivt.bn_")
	b = b.WriteStr(mangle.PkgShortName(info.RecvPkg))
	b = b.WriteStr("__")
	b = b.WriteStr(info.RecvTypeName)
	b = b.WriteStr("__")
	b = b.WriteStr(mangle.PkgShortName(info.IfacePkg))
	b = b.WriteStr("__")
	b = b.WriteStr(info.IfaceName)
	return b.Bytes()
}

// emitImplVtableSlot emits a single `i8* bitcast (<sig>* @<func> to
// i8*)` slot. Looks up the impl method in m.Funcs to recover its
// signature; emits an `i8* null` slot if not found (defensive — the
// satisfaction check should have validated method presence).
func emitImplVtableSlot(out buf.CharBuf, m @ir.Module,
		funcName @[]char) buf.CharBuf {
	var f @ir.Func = lookupModuleFunc(m, funcName)
	if f == nil {
		return out.WriteStr("i8* null")
	}
	out = out.WriteStr("i8* bitcast (")
	out = writeFuncPtrType(out, f)
	out = out.WriteStr(" @")
	out = writeBuf(out, mangle.FuncName(modulePkgName, funcName))
	out = out.WriteStr(" to i8*)")
	return out
}

// lookupModuleFunc returns the ir.Func with the given canonical
// name, or nil if absent.
func lookupModuleFunc(m @ir.Module, name @[]char) @ir.Func {
	for i := 0; i < len(m.Funcs); i++ {
		if charsEqual(m.Funcs[i].Name, name) {
			return m.Funcs[i]
		}
	}
	return nil
}

// writeFuncPtrType writes the LLVM function-pointer type for an
// ir.Func — receiver and other params spelled out so the bitcast
// at the vtable slot is well-formed.
func writeFuncPtrType(out buf.CharBuf, f @ir.Func) buf.CharBuf {
	out = writeFuncResultLLVM(out, f)
	out = out.WriteByte('(')
	for i := 0; i < len(f.Params); i++ {
		if i > 0 { out = out.WriteStr(", ") }
		out = out.WriteStr(llvmType(f.Params[i].Typ))
	}
	out = out.WriteStr(")*")
	return out
}

// emitCallIfaceMethod lowers OP_CALL_IFACE_METHOD: dispatch through
// the vtable of an interface value. Args[0] is the iv value
// (TYP_INTERFACE_VALUE / TYP_INTERFACE_VALUE_MANAGED); Args[1..] are
// user args; Index is the method slot.
//
// LLVM shape:
//
//   %dt   = extractvalue %BnIfaceValue %iv, 0   ; data ptr
//   %vt8  = extractvalue %BnIfaceValue %iv, 1   ; vtable ptr (i8*)
//   %vt   = bitcast i8* %vt8 to i8**             ; -> array of slots
//   %sp   = getelementptr inbounds i8*, i8** %vt, i64 <Index>
//   %fp   = load i8*, i8** %sp                   ; function pointer
//   %fn   = bitcast i8* %fp to <ret>(i8*, <argTys>)*
//   %r    = call <ret> %fn(i8* %dt, <args>)
//
// Slice 2.3a-3 of plan-interface-syntax-revision.md.
func emitCallIfaceMethod(out buf.CharBuf,
		instr @ir.Instr) buf.CharBuf {
	var iv @ir.Instr = instr.Args[0]
	var nArgs int = len(instr.Args) - 1
	var isVoid bool = instr.Typ == nil ||
		instr.Typ.Kind == types.TYP_VOID

	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".dt = extractvalue %BnIfaceValue ")
	out = emitRef(out, iv.ID)
	out = out.WriteStr(", 0\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8 = extractvalue %BnIfaceValue ")
	out = emitRef(out, iv.ID)
	out = out.WriteStr(", 1\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt = bitcast i8* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8 to i8**\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(
		".sp = getelementptr inbounds i8*, i8** %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt, i64 ")
	// instr.Index is the absolute vtable slot (Slice E.4 of
	// plan-interface-embedding.md).  For a non-extended interface
	// it equals method_position + 1 (since slot 0 is the dtor);
	// for an extended interface it accounts for the concat layout's
	// nested parent any-blocks.  findInterfaceMethod produces it.
	out = out.WriteInt(instr.Index)
	out = out.WriteStr("\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".fp = load i8*, i8** %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".sp\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".fn = bitcast i8* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".fp to ")
	if isVoid { out = out.WriteStr("void") } else {
		out = out.WriteStr(llvmType(instr.Typ))
	}
	out = out.WriteStr("(i8*")
	for i := 0; i < nArgs; i++ {
		var argInstr @ir.Instr = instr.Args[i+1]
		out = out.WriteStr(", ")
		out = out.WriteStr(llvmType(argInstr.Typ))
	}
	out = out.WriteStr(")*\n  ")

	if isVoid {
		out = out.WriteStr("call void %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".fn(i8* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".dt")
	} else {
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = call ")
		out = out.WriteStr(llvmType(instr.Typ))
		out = out.WriteStr(" %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".fn(i8* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".dt")
	}
	for i := 0; i < nArgs; i++ {
		out = out.WriteStr(", ")
		var argInstr @ir.Instr = instr.Args[i+1]
		out = out.WriteStr(llvmType(argInstr.Typ))
		out = out.WriteByte(' ')
		out = emitRef(out, argInstr.ID)
	}
	out = out.WriteStr(")\n")
	return out
}

// emitIfaceDtor lowers OP_IFACE_DTOR: load slot 0 of an interface
// value's vtable as an i8* (matches OP_FUNC_HANDLE's shape, which
// is the type of the dtor operand of OP_REFDEC). Args[0] is the iv.
//
// LLVM shape:
//
//   %vt8 = extractvalue %BnIfaceValue %iv, 1   ; vtable ptr (i8*)
//   %vt  = bitcast i8* %vt8 to i8**             ; -> array of slots
//   %sp  = getelementptr inbounds i8*, i8** %vt, i64 0
//   %r   = load i8*, i8** %sp                   ; dtor i8*
//
// Slice 2.5b of plan-interface-syntax-revision.md.
func emitIfaceDtor(out buf.CharBuf,
		instr @ir.Instr) buf.CharBuf {
	var iv @ir.Instr = instr.Args[0]
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8 = extractvalue %BnIfaceValue ")
	out = emitRef(out, iv.ID)
	out = out.WriteStr(", 1\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt = bitcast i8* %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt8 to i8**\n  ")
	out = out.WriteStr("%v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(
		".sp = getelementptr inbounds i8*, i8** %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".vt, i64 0\n  ")
	out = emitRef(out, instr.ID)
	out = out.WriteStr(" = load i8*, i8** %v")
	out = out.WriteInt(instr.ID)
	out = out.WriteStr(".sp\n")
	return out
}

// writeFuncResultLLVM writes an ir.Func's result-type form: void /
// single-type / multi-return-struct. Mirrors writeFuncResultsLLVM
// in emit_funcvals.bn but takes an ir.Func instead of a func-value
// types.Type.
func writeFuncResultLLVM(out buf.CharBuf, f @ir.Func) buf.CharBuf {
	if len(f.Results) == 0 {
		return out.WriteStr("void")
	}
	if len(f.Results) == 1 {
		return out.WriteStr(llvmType(f.Results[0]))
	}
	if f.MultiReturnType != nil {
		return out.WriteStr(llvmType(f.MultiReturnType))
	}
	out = out.WriteStr("{")
	for i := 0; i < len(f.Results); i++ {
		if i > 0 { out = out.WriteStr(", ") }
		out = out.WriteStr(llvmType(f.Results[i]))
	}
	return out.WriteStr("}")
}
