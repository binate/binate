package "pkg/codegen"

import "pkg/buf"
import "pkg/ir"
import "pkg/types"

// emitInstr dispatches a single IR instruction to the appropriate LLVM IR emitter.
func emitInstr(
	out buf.CharBuf, instr @ir.Instr,
	strings *[]ir.StringConst,
	funcRetTypes *[]FuncRetType,
) buf.CharBuf {
	out = out.WriteStr("  ")

	if instr.Op == ir.OP_CONST_INT {
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = add ")
		out = out.WriteStr(llvmType(instr.Typ))
		out = out.WriteByte(' ')
		out = out.WriteInt(instr.IntVal)
		out = out.WriteStr(", 0\n")
		return out
	}

	if instr.Op == ir.OP_CONST_FLOAT {
		// LLVM accepts decimal floats but is picky: "1." must be
		// written "1.0". We also fold the literal into a register via
		// `fadd <type> 0.0, literal` so the SSA shape matches
		// OP_CONST_INT's add-against-zero idiom.
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = fadd ")
		out = out.WriteStr(llvmType(instr.Typ))
		out = out.WriteStr(" 0.0, ")
		out = writeBuf(out, normalizeFloatLiteral(instr.StrVal))
		out = out.WriteByte('\n')
		return out
	}

	if instr.Op == ir.OP_CONST_BOOL {
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = add i1 ")
		if instr.BoolVal {
			out = out.WriteByte('1')
		} else {
			out = out.WriteByte('0')
		}
		out = out.WriteStr(", 0\n")
		return out
	}

	if instr.Op == ir.OP_CONST_STRING {
		var sid int = ir.FindStringID(strings, instr.StrVal)
		var slen int = len(instr.StrVal)
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = getelementptr inbounds [")
		out = out.WriteInt(slen)
		out = out.WriteStr(" x i8], [")
		out = out.WriteInt(slen)
		out = out.WriteStr(" x i8]* @.str.")
		out = out.WriteInt(sid)
		out = out.WriteStr(", i64 0, i64 0\n")
		return out
	}

	if instr.Op == ir.OP_CONST_NIL {
		return emitConstNil(out, instr)
	}

	if instr.Op >= ir.OP_ADD && instr.Op <= ir.OP_SHR {
		return emitBinop(out, instr)
	}
	if instr.Op >= ir.OP_EQ && instr.Op <= ir.OP_GE {
		return emitCmp(out, instr)
	}
	if instr.Op == ir.OP_LAND || instr.Op == ir.OP_LOR {
		return emitLogical(out, instr)
	}

	if instr.Op == ir.OP_NEG {
		out = emitRef(out, instr.ID)
		var isFloat bool = instr.Typ != nil &&
			(instr.Typ.Kind == types.TYP_FLOAT ||
				instr.Typ.Kind == types.TYP_UNTYPED_FLOAT)
		if isFloat {
			out = out.WriteStr(" = fneg ")
			out = out.WriteStr(llvmType(instr.Typ))
			out = out.WriteByte(' ')
			out = emitRef(out, instr.Args[0].ID)
		} else {
			out = out.WriteStr(" = sub ")
			out = out.WriteStr(llvmType(instr.Typ))
			out = out.WriteStr(" 0, ")
			out = emitRef(out, instr.Args[0].ID)
		}
		out = out.WriteByte('\n')
		return out
	}
	if instr.Op == ir.OP_NOT {
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = xor i1 ")
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(", 1\n")
		return out
	}
	if instr.Op == ir.OP_BITNOT {
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = xor ")
		out = out.WriteStr(llvmType(instr.Typ))
		out = out.WriteByte(' ')
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(", -1\n")
		return out
	}

	if instr.Op == ir.OP_ALLOC {
		return emitAlloc(out, instr)
	}
	if instr.Op == ir.OP_LOAD {
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = load ")
		out = out.WriteStr(llvmType(instr.Typ))
		out = out.WriteStr(", ")
		out = out.WriteStr(llvmType(instr.Typ))
		out = out.WriteStr("* ")
		out = emitPtrRef(out, instr.Args[0])
		out = out.WriteByte('\n')
		return out
	}
	if instr.Op == ir.OP_GET_FIELD_PTR {
		return emitGetFieldPtr(out, instr)
	}
	if instr.Op == ir.OP_GET_ELEM_PTR {
		return emitGetElemPtr(out, instr)
	}
	if instr.Op == ir.OP_STORE {
		var valTyp @[]char = llvmType(instr.Args[1].Typ)
		out = out.WriteStr("store ")
		out = out.WriteStr(valTyp)
		out = out.WriteByte(' ')
		out = emitRef(out, instr.Args[1].ID)
		out = out.WriteStr(", ")
		out = out.WriteStr(valTyp)
		out = out.WriteStr("* ")
		out = emitPtrRef(out, instr.Args[0])
		out = out.WriteByte('\n')
		return out
	}

	if instr.Op == ir.OP_JUMP {
		out = out.WriteStr("br label %")
		out = out.WriteStr(instr.Block1.Label)
		out = out.WriteByte('\n')
		return out
	}
	if instr.Op == ir.OP_BRANCH {
		out = out.WriteStr("br i1 ")
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(", label %")
		out = out.WriteStr(instr.Block1.Label)
		out = out.WriteStr(", label %")
		out = out.WriteStr(instr.Block2.Label)
		out = out.WriteByte('\n')
		return out
	}
	if instr.Op == ir.OP_RETURN {
		return emitReturn(out, instr)
	}
	if instr.Op == ir.OP_PANIC {
		out = out.WriteStr("call void @bn_rt__Exit(i64 1)\n")
		out = out.WriteStr("  unreachable\n")
		return out
	}
	if instr.Op == ir.OP_UNREACHABLE {
		out = out.WriteStr("unreachable\n")
		return out
	}

	if instr.Op == ir.OP_CALL {
		return emitCall(out, instr, funcRetTypes)
	}

	if instr.Op == ir.OP_CALL_INDIRECT {
		return emitCallIndirect(out, instr)
	}

	if instr.Op == ir.OP_EXTRACT {
		return emitExtract(out, instr, funcRetTypes)
	}

	if instr.Op == ir.OP_CAST {
		return emitCast(out, instr)
	}

	if instr.Op == ir.OP_BIT_CAST {
		return emitBitCast(out, instr)
	}

	if instr.Op == ir.OP_MANAGED_TO_RAW {
		return emitManagedToRawInstr(out, instr)
	}

	if instr.Op == ir.OP_MAKE {
		var sizeBytes int = typeSizeBytes(instr.TypeArg)
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = call i8* @bn_rt__Alloc(i64 ")
		out = out.WriteInt(sizeBytes)
		out = out.WriteStr(")\n")
		return out
	}

	if instr.Op == ir.OP_MAKE_SLICE {
		return emitMakeSliceInstr(out, instr)
	}

	if instr.Op == ir.OP_RODATA_ARRAY {
		out = emitStringToArrayInstr(out, instr, strings)
		return out
	}

	// Phase 3: rodata composite-literal ops alias the same static
	// `@.str.N.ms` global that string literals use. The byte sequence
	// is on `instr.StrVal`; FindStringID returns the matching ID.
	if instr.Op == ir.OP_RODATA_MSLICE_COPY {
		var sid int = ir.FindStringID(strings, instr.StrVal)
		var strLen int = len(instr.StrVal)
		out = emitStringToCharsCopy(out, instr, sid, strLen)
		return out
	}
	if instr.Op == ir.OP_RODATA_MSLICE {
		var sid int = ir.FindStringID(strings, instr.StrVal)
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = load %BnManagedSlice, %BnManagedSlice* @.str.")
		out = out.WriteInt(sid)
		out = out.WriteStr(".ms\n")
		return out
	}
	if instr.Op == ir.OP_RODATA_SLICE {
		var sid int = ir.FindStringID(strings, instr.StrVal)
		out = emitStringToRawSlice(out, instr, sid)
		return out
	}

	if instr.Op == ir.OP_BOX {
		return emitBoxInstr(out, instr)
	}

	if instr.Op == ir.OP_DEREF {
		return emitDerefInstr(out, instr)
	}

	if instr.Op == ir.OP_REFCOUNT_INC {
		out = out.WriteStr("call void @bn_rt__RefInc(i8* ")
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(")\n")
		return out
	}

	if instr.Op == ir.OP_REFCOUNT_DEC {
		out = out.WriteStr("call void @bn_rt__RefDec(i8* ")
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(", i8* ")
		if len(instr.Args) > 1 {
			out = emitRef(out, instr.Args[1].ID)
		} else {
			out = out.WriteStr("null")
		}
		out = out.WriteStr(")\n")
		return out
	}

	if instr.Op == ir.OP_FUNC_ADDR {
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = bitcast void(i8*)* @")
		out = writeBuf(out, mangle.FuncName(modulePkgName,instr.StrVal))
		out = out.WriteStr(" to i8*\n")
		return out
	}

	if instr.Op == ir.OP_FUNC_VALUE {
		// Build a 2-word {vtable, data} value:
		//   vtable = bitcast (%BnVtable* @__vt.<mangled> to i8*)
		//   data   = null
		// emitFuncValueVtables (called at module emit time) ensured
		// @__vt.<mangled> exists as a weak_odr constant.
		var mangled @[]char =
			mangle.FuncName(modulePkgName, instr.StrVal).Bytes()
		// %v.vt = bitcast %BnVtable* @__vt.<mangled> to i8*
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".vt = bitcast %BnVtable* @__vt.")
		out = out.WriteStr(mangled)
		out = out.WriteStr(" to i8*\n  ")
		// %v.0 = insertvalue %BnFuncValue undef, i8* %v.vt, 0
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".0 = insertvalue %BnFuncValue undef, i8* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".vt, 0\n  ")
		// %v = insertvalue %BnFuncValue %v.0, i8* null, 1
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = insertvalue %BnFuncValue %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".0, i8* null, 1\n")
		return out
	}

	if instr.Op == ir.OP_BOUNDS_CHECK {
		out = out.WriteStr("call void @bn_rt__BoundsCheck(i64 ")
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(", i64 ")
		out = emitRef(out, instr.Args[1].ID)
		out = out.WriteStr(")\n")
		return out
	}

	out = out.WriteStr("; unhandled op ")
	out = out.WriteInt(instr.Op)
	out = out.WriteByte('\n')
	return out
}

// --- Extracted helpers ---

