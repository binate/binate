package "pkg/codegen"

import "pkg/buf"
import "pkg/ir"
import "pkg/types"

// emitBinop emits an arithmetic or bitwise binary operation (add, sub, mul, etc.).
func emitBinop(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	out = emitRef(out, instr.ID)
	out = out.WriteStr(" = ")

	var isFloat bool = instr.Typ != nil &&
		(instr.Typ.Kind == types.TYP_FLOAT ||
			instr.Typ.Kind == types.TYP_UNTYPED_FLOAT)

	var opName *[]const char
	if instr.Op == ir.OP_ADD {
		if isFloat { opName = "fadd" } else { opName = "add" }
	}
	if instr.Op == ir.OP_SUB {
		if isFloat { opName = "fsub" } else { opName = "sub" }
	}
	if instr.Op == ir.OP_MUL {
		if isFloat { opName = "fmul" } else { opName = "mul" }
	}
	if instr.Op == ir.OP_DIV {
		if isFloat {
			opName = "fdiv"
		} else if instr.Typ != nil && !instr.Typ.Signed {
			opName = "udiv"
		} else {
			opName = "sdiv"
		}
	}
	if instr.Op == ir.OP_REM {
		// Rejected by the type checker for floats, so only integer
		// remainder reaches here.
		if instr.Typ != nil && !instr.Typ.Signed {
			opName = "urem"
		} else {
			opName = "srem"
		}
	}
	if instr.Op == ir.OP_AND { opName = "and" }
	if instr.Op == ir.OP_OR { opName = "or" }
	if instr.Op == ir.OP_XOR { opName = "xor" }
	if instr.Op == ir.OP_SHL { opName = "shl" }
	if instr.Op == ir.OP_SHR {
		if instr.Typ != nil && !instr.Typ.Signed {
			opName = "lshr"
		} else {
			opName = "ashr"
		}
	}

	out = out.WriteStr(opName)
	out = out.WriteByte(' ')
	out = out.WriteStr(llvmType(instr.Typ))
	out = out.WriteByte(' ')
	out = emitRef(out, instr.Args[0].ID)
	out = out.WriteStr(", ")
	out = emitRef(out, instr.Args[1].ID)
	out = out.WriteByte('\n')
	return out
}

// emitCmp emits an icmp or fcmp comparison, with special handling for
// slice-vs-nil. Floating-point comparisons use the ordered predicates
// (`oeq`, `olt`, ...), which return false when either operand is NaN.
func emitCmp(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	var isFloat bool = instr.Args[0].Typ != nil &&
		(instr.Args[0].Typ.Kind == types.TYP_FLOAT ||
			instr.Args[0].Typ.Kind == types.TYP_UNTYPED_FLOAT)

	// Use unsigned predicates if either operand is unsigned
	var useUnsigned bool = false
	if !isFloat && instr.Args[0].Typ != nil && !instr.Args[0].Typ.Signed {
		if types.IsInteger(instr.Args[0].Typ) {
			useUnsigned = true
		}
	}

	var pred *[]const char
	if instr.Op == ir.OP_EQ {
		if isFloat { pred = "oeq" } else { pred = "eq" }
	}
	if instr.Op == ir.OP_NE {
		if isFloat { pred = "one" } else { pred = "ne" }
	}
	if instr.Op == ir.OP_LT {
		if isFloat { pred = "olt" } else if useUnsigned { pred = "ult" } else { pred = "slt" }
	}
	if instr.Op == ir.OP_LE {
		if isFloat { pred = "ole" } else if useUnsigned { pred = "ule" } else { pred = "sle" }
	}
	if instr.Op == ir.OP_GT {
		if isFloat { pred = "ogt" } else if useUnsigned { pred = "ugt" } else { pred = "sgt" }
	}
	if instr.Op == ir.OP_GE {
		if isFloat { pred = "oge" } else if useUnsigned { pred = "uge" } else { pred = "sge" }
	}

	var lhsTyp @types.Type = instr.Args[0].Typ
	var rhsTyp @types.Type = instr.Args[1].Typ
	var lhsIsSlice bool = lhsTyp != nil &&
		(lhsTyp.Kind == types.TYP_SLICE ||
			lhsTyp.Kind == types.TYP_MANAGED_SLICE)
	var rhsIsNil bool = rhsTyp != nil && rhsTyp.Kind == types.TYP_NIL
	if lhsIsSlice && rhsIsNil {
		var sliceTypeName *[]const char = "%BnSlice"
		if lhsTyp.Kind == types.TYP_MANAGED_SLICE { sliceTypeName = "%BnManagedSlice" }
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".sptr = extractvalue ")
		out = out.WriteStr(sliceTypeName)
		out = out.WriteByte(' ')
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(", 0\n  ")
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = icmp ")
		out = out.WriteStr(pred)
		out = out.WriteStr(" i8* %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".sptr, null\n")
		return out
	}
	var rhsIsSlice bool = rhsTyp != nil &&
		(rhsTyp.Kind == types.TYP_SLICE ||
			rhsTyp.Kind == types.TYP_MANAGED_SLICE)
	var lhsIsNil bool = lhsTyp != nil && lhsTyp.Kind == types.TYP_NIL
	if rhsIsSlice && lhsIsNil {
		var sliceTypeName *[]const char = "%BnSlice"
		if rhsTyp.Kind == types.TYP_MANAGED_SLICE { sliceTypeName = "%BnManagedSlice" }
		out = out.WriteStr("%v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".sptr = extractvalue ")
		out = out.WriteStr(sliceTypeName)
		out = out.WriteByte(' ')
		out = emitRef(out, instr.Args[1].ID)
		out = out.WriteStr(", 0\n  ")
		out = emitRef(out, instr.ID)
		out = out.WriteStr(" = icmp ")
		out = out.WriteStr(pred)
		out = out.WriteStr(" i8* null, %v")
		out = out.WriteInt(instr.ID)
		out = out.WriteStr(".sptr\n")
		return out
	}

	out = emitRef(out, instr.ID)
	if isFloat {
		out = out.WriteStr(" = fcmp ")
	} else {
		out = out.WriteStr(" = icmp ")
	}
	out = out.WriteStr(pred)
	out = out.WriteByte(' ')
	out = out.WriteStr(llvmType(instr.Args[0].Typ))
	out = out.WriteByte(' ')
	out = emitRef(out, instr.Args[0].ID)
	out = out.WriteStr(", ")
	out = emitRef(out, instr.Args[1].ID)
	out = out.WriteByte('\n')
	return out
}

// emitLogical emits an i1 and/or for logical && and || operators.
func emitLogical(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	out = emitRef(out, instr.ID)
	out = out.WriteStr(" = ")
	if instr.Op == ir.OP_LAND {
		out = out.WriteStr("and")
	} else {
		out = out.WriteStr("or")
	}
	out = out.WriteStr(" i1 ")
	out = emitRef(out, instr.Args[0].ID)
	out = out.WriteStr(", ")
	out = emitRef(out, instr.Args[1].ID)
	out = out.WriteByte('\n')
	return out
}

// emitCast emits a type cast (sext/zext/trunc, ptrtoint/inttoptr, or identity).
func emitCast(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	var srcTyp @types.Type = instr.Args[0].Typ
	var dstTyp @types.Type = instr.TypeArg

	out = emitRef(out, instr.ID)

	var srcBits int = llvmTypeBits(instr.Args[0])
	var dstBits int = typeBits(dstTyp)

	// Check if source is a non-scalar type (slice, struct, etc.)
	// where "add X, 0" is not valid LLVM IR
	var srcIsAggregate bool = srcTyp != nil &&
		(srcTyp.Kind == types.TYP_SLICE ||
			srcTyp.Kind == types.TYP_MANAGED_SLICE ||
			srcTyp.Kind == types.TYP_STRUCT)

	var srcIsPtr bool = srcTyp != nil &&
		(srcTyp.Kind == types.TYP_POINTER || srcTyp.Kind == types.TYP_MANAGED_PTR)
	var dstIsPtr bool = dstTyp != nil &&
		(dstTyp.Kind == types.TYP_POINTER || dstTyp.Kind == types.TYP_MANAGED_PTR)

	var srcIsFloat bool = srcTyp != nil &&
		(srcTyp.Kind == types.TYP_FLOAT ||
			srcTyp.Kind == types.TYP_UNTYPED_FLOAT)
	var dstIsFloat bool = dstTyp != nil &&
		(dstTyp.Kind == types.TYP_FLOAT ||
			dstTyp.Kind == types.TYP_UNTYPED_FLOAT)

	// Float ↔ float: fpext (widen) or fptrunc (narrow).
	if srcIsFloat && dstIsFloat {
		var srcW int = 64
		var dstW int = 64
		if srcTyp.Kind == types.TYP_FLOAT && srcTyp.Width > 0 { srcW = srcTyp.Width }
		if dstTyp.Kind == types.TYP_FLOAT && dstTyp.Width > 0 { dstW = dstTyp.Width }
		if srcW == dstW {
			// Same-width float-to-float: emit a no-op fadd X, 0.0.
			out = out.WriteStr(" = fadd ")
			out = out.WriteStr(llvmType(dstTyp))
			out = out.WriteByte(' ')
			out = emitRef(out, instr.Args[0].ID)
			out = out.WriteStr(", 0.0\n")
			return out
		}
		if srcW < dstW {
			out = out.WriteStr(" = fpext ")
		} else {
			out = out.WriteStr(" = fptrunc ")
		}
		out = out.WriteStr(llvmType(srcTyp))
		out = out.WriteByte(' ')
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(" to ")
		out = out.WriteStr(llvmType(dstTyp))
		out = out.WriteByte('\n')
		return out
	}

	// Int → float: sitofp (signed) or uitofp (unsigned).
	if !srcIsFloat && dstIsFloat && !srcIsPtr {
		if isUnsigned(srcTyp) {
			out = out.WriteStr(" = uitofp ")
		} else {
			out = out.WriteStr(" = sitofp ")
		}
		out = out.WriteStr(llvmTypeForBits(srcBits))
		out = out.WriteByte(' ')
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(" to ")
		out = out.WriteStr(llvmType(dstTyp))
		out = out.WriteByte('\n')
		return out
	}

	// Float → int: fptosi (signed) or fptoui (unsigned). Truncates
	// towards zero (LLVM semantics).
	if srcIsFloat && !dstIsFloat && !dstIsPtr {
		if isUnsigned(dstTyp) {
			out = out.WriteStr(" = fptoui ")
		} else {
			out = out.WriteStr(" = fptosi ")
		}
		out = out.WriteStr(llvmType(srcTyp))
		out = out.WriteByte(' ')
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(" to ")
		out = out.WriteStr(llvmType(dstTyp))
		out = out.WriteByte('\n')
		return out
	}

	// Pointer ↔ pointer: bitcast
	if srcIsPtr && dstIsPtr {
		out = out.WriteStr(" = bitcast ")
		out = out.WriteStr(llvmType(srcTyp))
		out = out.WriteByte(' ')
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(" to ")
		out = out.WriteStr(llvmType(dstTyp))
		out = out.WriteByte('\n')
		return out
	}

	// Pointer → int: ptrtoint
	if srcIsPtr && !dstIsPtr {
		out = out.WriteStr(" = ptrtoint ")
		out = out.WriteStr(llvmType(srcTyp))
		out = out.WriteByte(' ')
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(" to ")
		out = out.WriteStr(llvmType(dstTyp))
		out = out.WriteByte('\n')
		return out
	}

	// Int → pointer: inttoptr
	if !srcIsPtr && dstIsPtr {
		out = out.WriteStr(" = inttoptr ")
		out = out.WriteStr(llvmTypeForBits(srcBits))
		out = out.WriteByte(' ')
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(" to ")
		out = out.WriteStr(llvmType(dstTyp))
		out = out.WriteByte('\n')
		return out
	}

	if srcBits == dstBits {
		if srcIsAggregate {
			// Non-scalar same-representation (e.g., *[]const char → *[]uint8):
			// both map to the same LLVM type — identity via select
			var tyLL @[]char = llvmType(srcTyp)
			out = out.WriteStr(" = select i1 true, ")
			out = out.WriteStr(tyLL)
			out = out.WriteByte(' ')
			out = emitRef(out, instr.Args[0].ID)
			out = out.WriteStr(", ")
			out = out.WriteStr(tyLL)
			out = out.WriteByte(' ')
			out = emitRef(out, instr.Args[0].ID)
			out = out.WriteByte('\n')
		} else {
			// Scalar same-size: identity via add 0
			out = out.WriteStr(" = add ")
			out = out.WriteStr(llvmType(dstTyp))
			out = out.WriteByte(' ')
			out = emitRef(out, instr.Args[0].ID)
			out = out.WriteStr(", 0\n")
		}
		return out
	}

	if srcBits < dstBits {
		if isUnsigned(srcTyp) {
			out = out.WriteStr(" = zext ")
		} else {
			out = out.WriteStr(" = sext ")
		}
	} else {
		out = out.WriteStr(" = trunc ")
	}

	var srcLLVM @[]char = llvmTypeForBits(srcBits)
	out = out.WriteStr(srcLLVM)
	out = out.WriteByte(' ')
	out = emitRef(out, instr.Args[0].ID)
	out = out.WriteStr(" to ")
	out = out.WriteStr(llvmType(dstTyp))
	out = out.WriteByte('\n')
	return out
}

// emitBitCast emits a bitcast, ptrtoint, inttoptr, or identity for bit_cast.
func emitBitCast(out buf.CharBuf, instr @ir.Instr) buf.CharBuf {
	var srcTyp @types.Type = instr.Args[0].Typ
	var dstTyp @types.Type = instr.TypeArg
	var srcLL @[]char = llvmType(srcTyp)
	var dstLL @[]char = llvmType(dstTyp)
	var srcIsPtr bool = isPointerType(srcTyp)
	var dstIsPtr bool = isPointerType(dstTyp)
	var srcIsFloat bool = srcTyp != nil &&
		(srcTyp.Kind == types.TYP_FLOAT ||
			srcTyp.Kind == types.TYP_UNTYPED_FLOAT)
	var dstIsFloat bool = dstTyp != nil &&
		(dstTyp.Kind == types.TYP_FLOAT ||
			dstTyp.Kind == types.TYP_UNTYPED_FLOAT)

	out = emitRef(out, instr.ID)

	if srcIsPtr && dstIsPtr {
		out = out.WriteStr(" = bitcast ")
		out = out.WriteStr(srcLL)
		out = out.WriteByte(' ')
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(" to ")
		out = out.WriteStr(dstLL)
		out = out.WriteByte('\n')
	} else if srcIsPtr && !dstIsPtr {
		out = out.WriteStr(" = ptrtoint ")
		out = out.WriteStr(srcLL)
		out = out.WriteByte(' ')
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(" to ")
		out = out.WriteStr(dstLL)
		out = out.WriteByte('\n')
	} else if !srcIsPtr && dstIsPtr {
		out = out.WriteStr(" = inttoptr ")
		out = out.WriteStr(srcLL)
		out = out.WriteByte(' ')
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(" to ")
		out = out.WriteStr(dstLL)
		out = out.WriteByte('\n')
	} else if srcIsFloat != dstIsFloat {
		// Int ↔ float same-size bit_cast: reinterprets bits, NOT a
		// numeric conversion. LLVM `bitcast` between scalars of the
		// same bit width handles this directly.
		out = out.WriteStr(" = bitcast ")
		out = out.WriteStr(srcLL)
		out = out.WriteByte(' ')
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(" to ")
		out = out.WriteStr(dstLL)
		out = out.WriteByte('\n')
	} else {
		out = out.WriteStr(" = add ")
		out = out.WriteStr(dstLL)
		out = out.WriteByte(' ')
		out = emitRef(out, instr.Args[0].ID)
		out = out.WriteStr(", 0\n")
	}
	return out
}

// isPointerType returns true if the type is a raw or managed pointer.
func isPointerType(t @types.Type) bool {
	if t == nil { return false }
	return t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR
}

