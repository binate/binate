package "pkg/codegen"

import "pkg/ast"
import "pkg/buf"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/parser"
import "pkg/types"

// Tests for emitBinop, emitCmp, emitLogical, emitCall, emitCast, emitBitCast.

func TestEmitBinopAdd() testing.TestResult {
	var src *[]const char = "package \"main\"\nfunc main() { println(1 + 2) }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "add i64") {
		return fail("expected add instruction")
	}
	var pass testing.TestResult
	return pass
}

func TestEmitCmpLTUnsigned() testing.TestResult {
	// Positive untyped int literals use unsigned comparison
	var src *[]const char = "package \"main\"\nfunc main() { var x bool = 1 < 2 }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "icmp ult") {
		return fail("expected icmp ult for positive untyped int less-than")
	}
	var pass testing.TestResult
	return pass
}

func TestEmitCmpLTSigned() testing.TestResult {
	// Negation produces signed int, so comparison is signed
	var src *[]const char = "package \"main\"\nfunc main() { var x bool = -1 < 2 }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "icmp slt") {
		return fail("expected icmp slt when operand is negated")
	}
	var pass testing.TestResult
	return pass
}

func TestEmitLogicalAnd() testing.TestResult {
	var src *[]const char = "package \"main\"\nfunc main() { var x bool = true && false }\n"
	var out @[]char = compileToLLVM(src)
	// Logical and uses short-circuit branching
	if !contains(out, "br i1") {
		return fail("expected branch for short-circuit and")
	}
	var pass testing.TestResult
	return pass
}

func TestEmitCallFunc() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func add(a int, b int) int {\n")
	cb = cb.WriteStr("\treturn a + b\n")
	cb = cb.WriteStr("}\n")
	cb = cb.WriteStr("func main() { println(add(1, 2)) }\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if !contains(out, "call i64 @bn_main__add") {
		return fail("expected call to mangled function name")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitCallIndirectVoid checks the LLVM lowering of OP_CALL_INDIRECT
// for a void-returning indirect call with one i64 argument. The
// expected shape is: bitcast i8* fn to void(i64)*, then call void
// through the bitcasted register.
func TestEmitCallIndirectVoid() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")

	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("caller", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var fnPtr @ir.Instr = ir.EmitConstNil(f, entry, rawPtrTyp)
	var arg @ir.Instr = ir.EmitConstInt(f, entry, 42, types.TypInt())
	var callArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	callArgs[0] = arg
	ir.EmitCallIndirect(f, entry, fnPtr, callArgs, types.TypVoid())

	var noRetArgs @[]@ir.Instr
	ir.EmitReturn(entry, noRetArgs)

	ir.AddFunc(m, f)

	var out @[]char = EmitModule(m)
	if !contains(out, "bitcast i8*") {
		return fail("expected bitcast i8* for fn_ptr")
	}
	if !contains(out, "to void(i64)*") {
		return fail("expected void(i64)* function-pointer type")
	}
	if !contains(out, "call void %") {
		return fail("expected indirect call through register")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitCallIndirectInt checks the lowering of an int-returning
// indirect call. The bitcast target uses the int return type and the
// call is assigned to a value register.
func TestEmitCallIndirectInt() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")

	var noParams @[]@ir.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var f @ir.Func = ir.NewFunc("caller", noParams, results)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var fnPtr @ir.Instr = ir.EmitConstNil(f, entry, rawPtrTyp)
	var arg @ir.Instr = ir.EmitConstInt(f, entry, 42, types.TypInt())
	var callArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	callArgs[0] = arg
	var result @ir.Instr = ir.EmitCallIndirect(f, entry, fnPtr, callArgs, types.TypInt())

	var retArgs @[]@ir.Instr = make_slice(@ir.Instr, 1)
	retArgs[0] = result
	ir.EmitReturn(entry, retArgs)

	ir.AddFunc(m, f)

	var out @[]char = EmitModule(m)
	if !contains(out, "bitcast i8*") {
		return fail("expected bitcast i8* for fn_ptr")
	}
	if !contains(out, "to i64(i64)*") {
		return fail("expected i64(i64)* function-pointer type")
	}
	if !contains(out, "= call i64 %") {
		return fail("expected indirect call returning i64")
	}
	var pass testing.TestResult
	return pass
}

// TestEmitCallIndirectNoArgs checks the lowering of a no-argument
// indirect call (e.g., a dtor accepting no args).
func TestEmitCallIndirectNoArgs() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")

	var noParams @[]@ir.Param
	var noResults @[]@types.Type
	var f @ir.Func = ir.NewFunc("caller", noParams, noResults)
	var entry @ir.Block = ir.AddBlock(f, "entry")

	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var fnPtr @ir.Instr = ir.EmitConstNil(f, entry, rawPtrTyp)
	var noCallArgs @[]@ir.Instr
	ir.EmitCallIndirect(f, entry, fnPtr, noCallArgs, types.TypVoid())

	var noRetArgs @[]@ir.Instr
	ir.EmitReturn(entry, noRetArgs)

	ir.AddFunc(m, f)

	var out @[]char = EmitModule(m)
	if !contains(out, "to void()*") {
		return fail("expected void()* function-pointer type for no-arg call")
	}
	if !contains(out, "call void %") {
		return fail("expected indirect call through register")
	}
	var pass testing.TestResult
	return pass
}

func TestEmitCastIntWidth() testing.TestResult {
	var src *[]const char = "package \"main\"\nfunc main() { var x int8 = cast(int8, 42) }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "trunc i64") {
		return fail("expected trunc for narrowing cast")
	}
	var pass testing.TestResult
	return pass
}

// ============================================================
// Float codegen tests
// ============================================================

// A float literal lowers to `fadd <type> 0.0, <literal>`.
func TestEmitFloatConst() testing.TestResult {
	var src *[]const char = "package \"main\"\nfunc main() { var x float64 = 3.14; _ = x }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "fadd double 0.0, 3.14") {
		return fail("expected 'fadd double 0.0, 3.14' for float literal")
	}
	var pass testing.TestResult
	return pass
}

// Float addition uses `fadd`, not `add`.
func TestEmitFloatAdd() testing.TestResult {
	var src *[]const char = "package \"main\"\nfunc main() { var x float64 = 1.0 + 2.0; _ = x }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "fadd double") {
		return fail("expected 'fadd double' for float +")
	}
	var pass testing.TestResult
	return pass
}

// Float division uses `fdiv`, never `sdiv`/`udiv`.
func TestEmitFloatDiv() testing.TestResult {
	var src *[]const char = "package \"main\"\nfunc main() { var x float64 = 6.0 / 2.0; _ = x }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "fdiv double") {
		return fail("expected 'fdiv double' for float /")
	}
	var pass testing.TestResult
	return pass
}

// Float comparison uses `fcmp` with ordered predicates.
func TestEmitFloatCmp() testing.TestResult {
	var src *[]const char = "package \"main\"\nfunc main() { var x bool = 1.0 < 2.0; _ = x }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "fcmp olt double") {
		return fail("expected 'fcmp olt double' for float <")
	}
	var pass testing.TestResult
	return pass
}

// Unary negation on floats uses `fneg`. Pipe the result through a
// function so nothing can be dead-stripped.
func TestEmitFloatNeg() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func use(x float64) float64 { return x }\n")
	cb = cb.WriteStr("func main() { use(-3.14) }\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	if !contains(out, "fneg double") {
		return fail("expected 'fneg double' for unary - on float")
	}
	var pass testing.TestResult
	return pass
}

// int → float64 cast uses `sitofp`.
func TestEmitCastIntToFloat() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func use(x float64) float64 { return x }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var i int = 5\n")
	cb = cb.WriteStr("  use(cast(float64, i))\n")
	cb = cb.WriteStr("}\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	if !contains(out, "sitofp i64") {
		return fail("expected 'sitofp i64' for int → float cast")
	}
	var pass testing.TestResult
	return pass
}

// float → int cast uses `fptosi`.
func TestEmitCastFloatToInt() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func use(x int) int { return x }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var f float64 = 3.7\n")
	cb = cb.WriteStr("  use(cast(int, f))\n")
	cb = cb.WriteStr("}\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	if !contains(out, "fptosi double") {
		return fail("expected 'fptosi double' for float → int cast")
	}
	var pass testing.TestResult
	return pass
}

// float64 → float32 cast uses `fptrunc`.
func TestEmitCastFloat64To32() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func use(x float32) float32 { return x }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var d float64 = 3.14\n")
	cb = cb.WriteStr("  use(cast(float32, d))\n")
	cb = cb.WriteStr("}\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	if !contains(out, "fptrunc double") {
		return fail("expected 'fptrunc double' for narrowing float cast")
	}
	var pass testing.TestResult
	return pass
}

// float32 → float64 cast uses `fpext`.
func TestEmitCastFloat32To64() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func use(x float64) float64 { return x }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var f float32 = cast(float32, 1.5)\n")
	cb = cb.WriteStr("  use(cast(float64, f))\n")
	cb = cb.WriteStr("}\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	if !contains(out, "fpext float") {
		return fail("expected 'fpext float' for widening float cast")
	}
	var pass testing.TestResult
	return pass
}

// float32 uses LLVM type 'float'.
func TestEmitFloat32Type() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("func use(x float32) float32 { return x }\n")
	cb = cb.WriteStr("func main() { use(cast(float32, 1.0)) }\n")
	var out @[]char = compileToLLVM(cb.Bytes())
	if !contains(out, "float ") {
		return fail("expected 'float' type in LLVM for float32")
	}
	var pass testing.TestResult
	return pass
}
