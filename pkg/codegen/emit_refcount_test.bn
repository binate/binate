package "pkg/codegen"

import "pkg/buf"
import "pkg/builtin/testing"

// Tests for the inline refcount lowering emitters
// (emitRefIncInline / emitRefDecInline in emit_refcount.bn).
// These exercise the OP_REFINC / OP_REFDEC nil-check + header-arith
// expansion that replaces the bn_pkg__rt__RefInc / bn_pkg__rt__RefDec call
// path. Helpers (compileToLLVM, contains, fail) live in emit_test.bn.

// TestEmitRefIncForManagedCopy checks that a managed-pointer copy in
// user code lowers to the inline RefInc form (no rt.RefInc call).
func TestEmitRefIncForManagedCopy() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("type N struct { V int }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar a @N = make(N)\n")
	cb = cb.WriteStr("\tvar b @N = a\n")
	cb = cb.WriteStr("\tprintln(b.V)\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var out @[]char = compileToLLVM(src)
	if contains(out, "@bn_pkg__rt__RefInc(") {
		return fail("RefInc should be inlined; no @bn_pkg__rt__RefInc call expected")
	}
	if !contains(out, "ri.") {
		return fail("expected inline RefInc labels (ri.<seq>.*)")
	}
	if !contains(out, "i64 -16") {
		return fail("expected inline header offset -16")
	}
	var pass testing.TestResult
	return pass
}
