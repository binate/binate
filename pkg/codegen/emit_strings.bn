package "pkg/codegen"

import "pkg/buf"
import "pkg/ir"
import "pkg/types"

// LLVM lowerings for string-related and rodata composite-literal IR ops.
// Extracted from emit_helpers.bn to keep that file under the 600-line cap.

// emitStringToArrayInstr emits the Stage 2c lowering for
// `var s [N]char = "..."`. Allocates a temp `[N x i8]` slot,
// zero-fills it, memcpys `min(strLen, N)` literal bytes from rodata
// into the head, and loads the result. The caller stores the
// %BnArray value into the destination array-typed alloca.
//
// strLen > N is rejected at IR-gen time, so we only ever copy
// `strLen` bytes here (≤ N).
func emitStringToArrayInstr(out buf.CharBuf, instr @ir.Instr,
		strings *[]ir.StringConst) buf.CharBuf {
	var sid int = ir.FindStringID(strings, instr.StrVal)
	var strLen int = len(instr.StrVal)
	var arrLen int = 0
	if instr.Typ != nil && instr.Typ.Kind == types.TYP_ARRAY {
		arrLen = instr.Typ.ArrayLen
	}
	if arrLen == 0 { arrLen = strLen }
	// %vID.tmp = alloca [arrLen x i8]
	out = buf.WriteStr(out, "%v")
	out = out.WriteInt(instr.ID)
	out = buf.WriteStr(out, ".tmp = alloca [")
	out = out.WriteInt(arrLen)
	out = buf.WriteStr(out, " x i8]\n  ")
	// Zero-fill (covers the tail when strLen < arrLen).
	out = buf.WriteStr(out, "store [")
	out = out.WriteInt(arrLen)
	out = buf.WriteStr(out, " x i8] zeroinitializer, [")
	out = out.WriteInt(arrLen)
	out = buf.WriteStr(out, " x i8]* %v")
	out = out.WriteInt(instr.ID)
	out = buf.WriteStr(out, ".tmp\n  ")
	if strLen > 0 {
		// %vID.dst = bitcast [arrLen x i8]* %vID.tmp to i8*
		out = buf.WriteStr(out, "%v")
		out = out.WriteInt(instr.ID)
		out = buf.WriteStr(out, ".dst = bitcast [")
		out = out.WriteInt(arrLen)
		out = buf.WriteStr(out, " x i8]* %v")
		out = out.WriteInt(instr.ID)
		out = buf.WriteStr(out, ".tmp to i8*\n  ")
		// %vID.src = getelementptr inbounds [strLen x i8], [strLen x i8]* @.str.sid, i64 0, i64 0
		out = buf.WriteStr(out, "%v")
		out = out.WriteInt(instr.ID)
		out = buf.WriteStr(out, ".src = getelementptr inbounds [")
		out = out.WriteInt(strLen)
		out = buf.WriteStr(out, " x i8], [")
		out = out.WriteInt(strLen)
		out = buf.WriteStr(out, " x i8]* @.str.")
		out = out.WriteInt(sid)
		out = buf.WriteStr(out, ", i64 0, i64 0\n  ")
		// memcpy strLen bytes
		out = buf.WriteStr(out, "call void @bn_rt__c_memcpy(i8* %v")
		out = out.WriteInt(instr.ID)
		out = buf.WriteStr(out, ".dst, i8* %v")
		out = out.WriteInt(instr.ID)
		out = buf.WriteStr(out, ".src, i64 ")
		out = out.WriteInt(strLen)
		out = buf.WriteStr(out, ")\n  ")
	}
	// %vID = load [arrLen x i8], [arrLen x i8]* %vID.tmp
	out = emitRef(out, instr.ID)
	out = buf.WriteStr(out, " = load [")
	out = out.WriteInt(arrLen)
	out = buf.WriteStr(out, " x i8], [")
	out = out.WriteInt(arrLen)
	out = buf.WriteStr(out, " x i8]* %v")
	out = out.WriteInt(instr.ID)
	out = buf.WriteStr(out, ".tmp\n")
	return out
}

// emitStringToRawSlice emits the raw-slice variant of a string→slice
// conversion: extract {data, len} from the static `%BnManagedSlice`
// global @.str.SID.ms and pack into a `%BnSlice`. Shared by
// OP_STRING_TO_CHARS (raw target) and OP_RODATA_SLICE.
func emitStringToRawSlice(out buf.CharBuf, instr @ir.Instr, sid int) buf.CharBuf {
	out = emitRef(out, instr.ID)
	out = buf.WriteStr(out, ".full = load %BnManagedSlice, %BnManagedSlice* @.str.")
	out = out.WriteInt(sid)
	out = buf.WriteStr(out, ".ms\n  ")
	out = emitRef(out, instr.ID)
	out = buf.WriteStr(out, ".d = extractvalue %BnManagedSlice ")
	out = emitRef(out, instr.ID)
	out = buf.WriteStr(out, ".full, 0\n  ")
	out = emitRef(out, instr.ID)
	out = buf.WriteStr(out, ".l = extractvalue %BnManagedSlice ")
	out = emitRef(out, instr.ID)
	out = buf.WriteStr(out, ".full, 1\n  ")
	out = emitRef(out, instr.ID)
	out = buf.WriteStr(out, ".s0 = insertvalue %BnSlice undef, i8* ")
	out = emitRef(out, instr.ID)
	out = buf.WriteStr(out, ".d, 0\n  ")
	out = emitRef(out, instr.ID)
	out = buf.WriteStr(out, " = insertvalue %BnSlice ")
	out = emitRef(out, instr.ID)
	out = buf.WriteStr(out, ".s0, i64 ")
	out = emitRef(out, instr.ID)
	out = buf.WriteStr(out, ".l, 1\n")
	return out
}

// emitStringToCharsCopy emits the Stage 2b implicit-copy lowering for
// `@[]char = "..."`. Allocates a fresh managed-slice via
// bn_rt__MakeManagedSlice, memcpys the literal bytes from the
// `@.str.N` rodata global into the backing, and leaves the result
// %BnManagedSlice in `%vID`. The caller owns the allocation; its
// refcount is already 1 (MakeManagedSlice sets it).
func emitStringToCharsCopy(out buf.CharBuf, instr @ir.Instr, sid int, strLen int) buf.CharBuf {
	// %vID.raw = call %BnManagedSlice @bn_rt__MakeManagedSlice(i64 1, i64 strLen)
	out = buf.WriteStr(out, "%v")
	out = out.WriteInt(instr.ID)
	out = buf.WriteStr(out, ".raw = call %BnManagedSlice @bn_rt__MakeManagedSlice(i64 1, i64 ")
	out = out.WriteInt(strLen)
	out = buf.WriteStr(out, ")\n  ")
	// %vID.dst = extractvalue %BnManagedSlice %vID.raw, 0
	out = buf.WriteStr(out, "%v")
	out = out.WriteInt(instr.ID)
	out = buf.WriteStr(out, ".dst = extractvalue %BnManagedSlice %v")
	out = out.WriteInt(instr.ID)
	out = buf.WriteStr(out, ".raw, 0\n  ")
	// %vID.src = getelementptr inbounds [N x i8], [N x i8]* @.str.sid, i64 0, i64 0
	out = buf.WriteStr(out, "%v")
	out = out.WriteInt(instr.ID)
	out = buf.WriteStr(out, ".src = getelementptr inbounds [")
	out = out.WriteInt(strLen)
	out = buf.WriteStr(out, " x i8], [")
	out = out.WriteInt(strLen)
	out = buf.WriteStr(out, " x i8]* @.str.")
	out = out.WriteInt(sid)
	out = buf.WriteStr(out, ", i64 0, i64 0\n  ")
	// call void @bn_rt__c_memcpy(i8* %vID.dst, i8* %vID.src, i64 strLen)
	out = buf.WriteStr(out, "call void @bn_rt__c_memcpy(i8* %v")
	out = out.WriteInt(instr.ID)
	out = buf.WriteStr(out, ".dst, i8* %v")
	out = out.WriteInt(instr.ID)
	out = buf.WriteStr(out, ".src, i64 ")
	out = out.WriteInt(strLen)
	out = buf.WriteStr(out, ")\n  ")
	// %vID = select i1 true, %BnManagedSlice %vID.raw, %BnManagedSlice %vID.raw
	// (passthrough — we need a single-SSA-value result named %vID)
	out = emitRef(out, instr.ID)
	out = buf.WriteStr(out, " = select i1 true, %BnManagedSlice %v")
	out = out.WriteInt(instr.ID)
	out = buf.WriteStr(out, ".raw, %BnManagedSlice %v")
	out = out.WriteInt(instr.ID)
	out = buf.WriteStr(out, ".raw\n")
	return out
}

