package "pkg/codegen"

import "pkg/builtins/testing"

// Smoke tests for the string / rodata composite-literal lowerings
// extracted into emit_strings.bn (Phase 3.2b refactor). Each test
// compiles a small program and checks the LLVM output for the
// expected shape.

// emitStringToArrayInstr (`var s [N]char = "..."` and OP_RODATA_ARRAY)
// allocates a temp `[N x i8]`, zero-fills, and memcpys from rodata.
func TestEmitStringToArray() testing.TestResult {
	var src *[]const char =
		"package \"main\"\nfunc main() { var s [5]char = \"abcde\"; _ = s }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "alloca [5 x i8]") {
		return fail("expected alloca [5 x i8]")
	}
	if !contains(out, "@bn_pkg__libc__Memcpy") {
		return fail("expected memcpy from rodata")
	}
	var pass testing.TestResult
	return pass
}

// emitStringToCharsCopy (Stage 2b copy via OP_RODATA_MSLICE_COPY) for
// `var s @[]char = "..."` allocates a fresh managed-slice and memcpys
// the literal bytes — must NOT alias the static @.str.N.ms global.
func TestEmitStringToCharsCopy() testing.TestResult {
	var src *[]const char =
		"package \"main\"\nfunc main() { var s @[]char = \"hello\"; _ = s }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "@bn_pkg__rt__MakeManagedSlice") {
		return fail("expected MakeManagedSlice for @[]char copy")
	}
	if !contains(out, "@bn_pkg__libc__Memcpy") {
		return fail("expected memcpy for @[]char copy")
	}
	var pass testing.TestResult
	return pass
}

// Empty-string lowering for @[]char must not emit a libc.Memcpy call:
// the size is statically zero so there's nothing to copy, and a
// stray `call @bn_pkg__libc__Memcpy(..., 0)` against an undeclared symbol
// breaks clang in modules that don't otherwise import pkg/libc.
// Regression test for the bnc test-runner `return ""` bug — see
// explorations/claude-todo.md.
func TestEmitStringToCharsCopyEmpty() testing.TestResult {
	var src *[]const char =
		"package \"main\"\nfunc f() @[]char { return \"\" }\nfunc main() { _ = f() }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "@bn_pkg__rt__MakeManagedSlice") {
		return fail("expected MakeManagedSlice for empty @[]char")
	}
	if contains(out, "@bn_pkg__libc__Memcpy") {
		return fail("expected NO libc.Memcpy call for size-zero copy")
	}
	var pass testing.TestResult
	return pass
}

// Non-empty @[]char literal in a module that doesn't import pkg/libc:
// codegen DOES emit `call @bn_pkg__libc__Memcpy(..., N)`, so the module
// must also include an implicit `declare @bn_pkg__libc__Memcpy(...)` so
// clang accepts the .ll. Without the declare, clang errors with
// "use of undefined value '@bn_pkg__libc__Memcpy'".
func TestEmitStringToCharsCopyImplicitMemcpyDecl() testing.TestResult {
	var src *[]const char =
		"package \"main\"\nfunc f() @[]char { return \"hi\" }\nfunc main() { _ = f() }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "call void @bn_pkg__libc__Memcpy") {
		return fail("expected libc.Memcpy call for non-empty @[]char copy")
	}
	if !contains(out, "declare void @bn_pkg__libc__Memcpy") {
		return fail("expected implicit declare for libc.Memcpy")
	}
	var pass testing.TestResult
	return pass
}

// emitStringToRawSlice (`var s *[]const char = "..."` via OP_RODATA_SLICE)
// extracts {data, len} from the static %BnManagedSlice global and packs
// them into a %BnSlice — no MakeManagedSlice call.
func TestEmitStringToRawSlice() testing.TestResult {
	var src *[]const char =
		"package \"main\"\nfunc main() { var s *[]const char = \"hi\"; _ = s }\n"
	var out @[]char = compileToLLVM(src)
	if !contains(out, "extractvalue %BnManagedSlice") {
		return fail("expected extractvalue from %BnManagedSlice global")
	}
	if !contains(out, "insertvalue %BnSlice") {
		return fail("expected insertvalue %BnSlice")
	}
	var pass testing.TestResult
	return pass
}
