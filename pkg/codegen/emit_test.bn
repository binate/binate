package "pkg/codegen"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/mangle"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/testing"

// ============================================================
// Helpers
// ============================================================

func fail(msg @[]char) testing.TestResult {
	return msg
}

func seq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

func strToBytes(s *[]const char) @[]uint8 {
	var r @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = cast(uint8, s[i])
	}
	return r
}

func contains(haystack *[]const char, needle *[]const char) bool {
	if len(needle) > len(haystack) { return false }
	for i := 0; i <= len(haystack) - len(needle); i++ {
		var match bool = true
		for j := 0; j < len(needle); j++ {
			if haystack[i + j] != needle[j] {
				match = false
				break
			}
		}
		if match { return true }
	}
	return false
}

// compileToLLVM compiles Binate source to LLVM IR text.  Runs the
// type-checker first and threads the populated Checker through
// SetChecker so IR-gen consults `Checker.ExprType(id)` for resolved
// types — needed by paths like capture analysis (B.1 / B.2 of
// plan-function-values-phase-2.md) that depend on the side-table.
func compileToLLVM(src *[]const char) @[]char {
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	ir.SetChecker(c)
	var m @ir.Module = ir.GenModule(file)
	var out @[]char = EmitModule(m)
	// Clear so subsequent tests in the same run don't inherit
	// this Checker's ExprTypes registry.
	ir.SetChecker(nil)
	return out
}

// ============================================================
// mangle tests (now in pkg/binate/mangle, tested via import)
// ============================================================

func TestMangleFuncNameMain() testing.TestResult {
	// `main` in pkg `main` mangles like any other free function
	// (no special case anymore — the C runtime calls `bn_entry`,
	// not the user's main directly).
	var r @[]char = mangle.FuncName("main", "main").Bytes()
	if !seq(r, "bn_main__main") { return fail("expected bn_main__main") }
	var pass testing.TestResult
	return pass
}

func TestMangleFuncNameLocal() testing.TestResult {
	var r @[]char = mangle.FuncName("parser", "New").Bytes()
	if !seq(r, "bn_parser__New") { return fail("expected bn_parser__New") }
	var pass testing.TestResult
	return pass
}

func TestMangleFuncNameQualified() testing.TestResult {
	var r @[]char = mangle.FuncName("main", "parser.New").Bytes()
	if !seq(r, "bn_parser__New") { return fail("expected bn_parser__New") }
	var pass testing.TestResult
	return pass
}

func TestMangleFuncNameBootstrap() testing.TestResult {
	var r @[]char = mangle.FuncName("main", "pkg/bootstrap.Open").Bytes()
	if !seq(r, "bn_pkg__bootstrap__Open") { return fail("expected bn_pkg__bootstrap__Open") }
	var pass testing.TestResult
	return pass
}

func TestMangleGlobalName() testing.TestResult {
	var r @[]char = mangle.GlobalName("main", "count").Bytes()
	if !seq(r, "bn_main__count") { return fail("expected bn_main__count") }
	var pass testing.TestResult
	return pass
}

func TestMangleStructNameLocal() testing.TestResult {
	var r @[]char = mangle.StructName("parser", "Parser").Bytes()
	if !seq(r, "bn_parser__Parser") { return fail("expected bn_parser__Parser") }
