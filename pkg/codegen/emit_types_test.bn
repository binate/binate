package "pkg/codegen"

import "pkg/ir"
import "pkg/ast"
import "pkg/buf"
import "pkg/parser"
import "pkg/builtin/testing"

func TestEmitPackedStruct() testing.TestResult {
	// Generate a module from source that uses a struct
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"main\"\n")
	cb = buf.WriteStr(cb, "type Mixed struct {\n")
	cb = buf.WriteStr(cb, "\tA int8\n")
	cb = buf.WriteStr(cb, "\tB int\n")
	cb = buf.WriteStr(cb, "}\n")
	cb = buf.WriteStr(cb, "func main() {\n")
	cb = buf.WriteStr(cb, "\tvar m Mixed\n")
	cb = buf.WriteStr(cb, "\tm.A = cast(int8, 1)\n")
	cb = buf.WriteStr(cb, "\tm.B = 42\n")
	cb = buf.WriteStr(cb, "}\n")
	var src *[]const char = buf.Bytes(cb)
	var p @parser.Parser = parser.New(strToBytes(src), "test")
	var file @ast.File = parser.ParseFile(p)
	var m @ir.Module = ir.GenModule(file)

	var out @[]char = EmitModule(m)
	// Should be a packed struct with padding
	if !contains(out, "%bn_main__Mixed = type <{") {
		return fail("expected packed struct type def")
	}
	var pass testing.TestResult
	return pass
}
