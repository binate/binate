package "pkg/codegen"

import "pkg/binate/types"
import "pkg/builtins/testing"

// setTarget64 pins types' live target to a 64-bit configuration.
// pkg/codegen tests emit LLVM IR strings that pin LP64-specific
// shapes (i64 for `int`, 16-byte slices, etc.); the lazy default
// would otherwise reflect the host on a 32-bit-host test runner.
func setTarget64() {
	var t types.TargetInfo
	t.PointerSize = 8
	t.IntSize = 8
	t.MaxAlign = 8
	types.SetTarget(t)
}

// Tests for llvmTypeBits, typeSizeBytes, elemSizeOf, charsEqual, etc.

func TestCharsEqual() testing.TestResult {
	if !charsEqual("hello", "hello") { return fail("same strings") }
	if charsEqual("hello", "world") { return fail("different strings") }
	if charsEqual("abc", "ab") { return fail("different lengths") }
	var pass testing.TestResult
	return pass
}

func TestTypeSizeBytes() testing.TestResult {
	if typeSizeBytes(types.TypInt()) != 8 { return fail("int should be 8 bytes") }
	if typeSizeBytes(types.TypBool()) != 1 { return fail("bool should be 1 byte") }
	if typeSizeBytes(types.TypInt8()) != 1 { return fail("int8 should be 1 byte") }
	var pass testing.TestResult
	return pass
}

func TestElemSizeOf() testing.TestResult {
	// elemSizeOf returns SizeOf(t).  Use fixed-width types so the
	// assertion doesn't depend on TypInt's locked singleton state
	// (which varies with whether any earlier test in this package
	// called setTarget64 before ensureInit fired).
	if elemSizeOf(types.TypInt64()) != 8 { return fail("int64 should be 8") }
	if elemSizeOf(types.TypUint8()) != 1 { return fail("uint8 should be 1") }
	var pass testing.TestResult
	return pass
}

func TestStripQuotes() testing.TestResult {
	var r *[]const char = stripQuotes("\"hello\"")
	if !seq(r, "hello") { return fail("expected hello") }
	var pass testing.TestResult
	return pass
}

func TestStripQuotesNoQuotes() testing.TestResult {
	var r *[]const char = stripQuotes("hello")
	if !seq(r, "hello") { return fail("expected hello unchanged") }
	var pass testing.TestResult
	return pass
}
