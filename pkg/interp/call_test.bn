func TestMakeSliceRaw() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar s @[]int = make_slice(int, 3)\n")
	b = buf.WriteStr(b, "\tprintln(len(s))\n")
	b = buf.WriteStr(b, "\tprintln(s[0])\n")
	b = buf.WriteStr(b, "\ts[1] = 42\n")
	b = buf.WriteStr(b, "\tprintln(s[1])\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "3\n0\n42\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

