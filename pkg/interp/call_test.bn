// ============================================================

func TestSelfReferentialType() testing.TestResult {
	// Node with self-referential @Node field — field access must work
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "type Node struct { Val int; Next @Node }\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar a @Node = make(Node)\n")
	b = buf.WriteStr(b, "\ta.Val = 1\n")
	b = buf.WriteStr(b, "\tvar b @Node = make(Node)\n")
	b = buf.WriteStr(b, "\tb.Val = 2\n")
	b = buf.WriteStr(b, "\ta.Next = b\n")
	b = buf.WriteStr(b, "\tprintln(a.Val)\n")
	b = buf.WriteStr(b, "\tprintln(a.Next.Val)\n")
	b = buf.WriteStr(b, "\tif a.Next.Next == nil { println(\"nil\") }\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "1\n2\nnil\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestSelfReferentialRecursive() testing.TestResult {
	// Recursive list construction and traversal
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "type Node struct { Val int; Next @Node }\n")
	b = buf.WriteStr(b, "func buildList(n int) @Node {\n")
	b = buf.WriteStr(b, "\tif n <= 0 { return nil }\n")
	b = buf.WriteStr(b, "\tvar node @Node = make(Node)\n")
	b = buf.WriteStr(b, "\tnode.Val = n\n")
	b = buf.WriteStr(b, "\tnode.Next = buildList(n - 1)\n")
	b = buf.WriteStr(b, "\treturn node\n")
	b = buf.WriteStr(b, "}\n")
	b = buf.WriteStr(b, "func sum(n @Node) int {\n")
	b = buf.WriteStr(b, "\tif n == nil { return 0 }\n")
	b = buf.WriteStr(b, "\treturn n.Val + sum(n.Next)\n")
	b = buf.WriteStr(b, "}\n")
	b = buf.WriteStr(b, "func main() { println(sum(buildList(5))) }\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "15\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

