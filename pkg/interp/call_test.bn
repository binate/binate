func TestArrayManagedSliceElemRefcount() testing.TestResult {
	// Storing @[]char in an array element should RefInc its backing.
	// Overwriting should RefDec the old backing.
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "import \"pkg/rt\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar a @[]char = make_slice(char, 1)\n")
	b = buf.WriteStr(b, "\tvar pa *int = bit_cast(*int, &a)\n")
	b = buf.WriteStr(b, "\tvar bp *uint8 = bit_cast(*uint8, pa[2])\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(bp))\n")
	b = buf.WriteStr(b, "\tvar arr [2]@[]char\n")
	b = buf.WriteStr(b, "\tarr[0] = a\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(bp))\n")
	b = buf.WriteStr(b, "\tvar b @[]char = make_slice(char, 1)\n")
	b = buf.WriteStr(b, "\tarr[0] = b\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(bp))\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "1\n2\n1\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

