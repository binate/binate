// ============================================================
// bit_cast tests
// ============================================================

func TestBitCastPtrToPtr() testing.TestResult {
	// bit_cast(*int, ptr) — reinterpret pointer type
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "import \"pkg/rt\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar p *uint8 = rt.c_malloc(8)\n")
	b = buf.WriteStr(b, "\tvar ip *int = bit_cast(*int, p)\n")
	b = buf.WriteStr(b, "\tip[0] = 42\n")
	b = buf.WriteStr(b, "\tprintln(ip[0])\n")
	b = buf.WriteStr(b, "\trt.c_free(p)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "42\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestBitCastPtrToInt() testing.TestResult {
	// bit_cast(int, ptr) — get address as integer
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "import \"pkg/rt\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar p *uint8 = rt.c_malloc(8)\n")
	b = buf.WriteStr(b, "\tvar addr int = bit_cast(int, p)\n")
	b = buf.WriteStr(b, "\tif addr != 0 { println(1) } else { println(0) }\n")
	b = buf.WriteStr(b, "\trt.c_free(p)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "1\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestBitCastIntToPtr() testing.TestResult {
	// bit_cast(*uint8, int) — create pointer from integer
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "import \"pkg/rt\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar p *uint8 = rt.c_malloc(8)\n")
	b = buf.WriteStr(b, "\tvar addr int = bit_cast(int, p)\n")
	b = buf.WriteStr(b, "\tvar q *uint8 = bit_cast(*uint8, addr)\n")
	b = buf.WriteStr(b, "\tvar ip *int = bit_cast(*int, q)\n")
	b = buf.WriteStr(b, "\tip[0] = 99\n")
	b = buf.WriteStr(b, "\tvar ip2 *int = bit_cast(*int, p)\n")
	b = buf.WriteStr(b, "\tprintln(ip2[0])\n")
	b = buf.WriteStr(b, "\trt.c_free(p)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "99\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

// ============================================================
// rt forwarding tests
// ============================================================

func TestRtAllocFree() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "import \"pkg/rt\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar p *uint8 = rt.Alloc(16)\n")
	b = buf.WriteStr(b, "\tif p != nil { println(1) } else { println(0) }\n")
	b = buf.WriteStr(b, "\trt.Free(p)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "1\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestRtRefcount() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "import \"pkg/rt\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar p *uint8 = rt.Alloc(8)\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(p))\n")
	b = buf.WriteStr(b, "\trt.RefInc(p)\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(p))\n")
	b = buf.WriteStr(b, "\trt.RefDec(p, nil)\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(p))\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "1\n2\n1\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

// ============================================================
// Pointer indexing tests
// ============================================================

func TestPointerIndexing() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar arr [3]int\n")
	b = buf.WriteStr(b, "\tarr[0] = 10\n")
	b = buf.WriteStr(b, "\tarr[1] = 20\n")
	b = buf.WriteStr(b, "\tarr[2] = 30\n")
	b = buf.WriteStr(b, "\tvar p *int = &arr[0]\n")
	b = buf.WriteStr(b, "\tprintln(p[0])\n")
	b = buf.WriteStr(b, "\tprintln(p[1])\n")
	b = buf.WriteStr(b, "\tp[2] = 99\n")
	b = buf.WriteStr(b, "\tprintln(arr[2])\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "10\n20\n99\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

// ============================================================
// Pointer comparison tests
// ============================================================

func TestPointerComparison() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "import \"pkg/rt\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar p *uint8 = rt.c_malloc(8)\n")
	b = buf.WriteStr(b, "\tvar q *uint8 = p\n")
	b = buf.WriteStr(b, "\tif p == q { println(1) } else { println(0) }\n")
	b = buf.WriteStr(b, "\tvar r *uint8 = rt.c_malloc(8)\n")
	b = buf.WriteStr(b, "\tif p == r { println(1) } else { println(0) }\n")
	b = buf.WriteStr(b, "\trt.c_free(p)\n")
	b = buf.WriteStr(b, "\trt.c_free(r)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "1\n0\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

