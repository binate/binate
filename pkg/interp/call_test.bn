// ============================================================

func TestIntOfRoundTrip() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar x int = 42\n")
	b = buf.WriteStr(b, "\tvar y int = x + 8\n")
	b = buf.WriteStr(b, "\tprintln(y)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "50\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestStringAsSlice() testing.TestResult {
	// String literals produce @[]char via MakeStringVal (now flat)
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func greet() *[]char { return \"hello\" }\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar s *[]char = greet()\n")
	b = buf.WriteStr(b, "\tprintln(s)\n")
	b = buf.WriteStr(b, "\tprintln(len(s))\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "hello\n5\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestMultiReturnFlatStruct() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func divmod(a int, b int) (int, int) { return a / b, a % b }\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar q int\n")
	b = buf.WriteStr(b, "\tvar r int\n")
	b = buf.WriteStr(b, "\tq, r = divmod(17, 5)\n")
	b = buf.WriteStr(b, "\tprintln(q)\n")
	b = buf.WriteStr(b, "\tprintln(r)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "3\n2\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestMultiReturnShortVar() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func swap(a int, b int) (int, int) { return b, a }\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tx, y := swap(10, 20)\n")
	b = buf.WriteStr(b, "\tprintln(x)\n")
	b = buf.WriteStr(b, "\tprintln(y)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "20\n10\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}
