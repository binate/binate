package "pkg/interp"

import "pkg/builtin/testing"
import "pkg/bootstrap"
import "pkg/buf"

// ============================================================
// Function Call and Builtin Tests
// ============================================================

func TestFuncCall() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func add(a int, b int) int { return a + b }\n")
	b = buf.WriteStr(b, "func main() { println(add(3, 4)) }\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "7\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestMakeSliceAndAssign() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar s @[]int = make_slice(int, 2)\n")
	b = buf.WriteStr(b, "\ts[0] = 1; s[1] = 2\n")
	b = buf.WriteStr(b, "\tprintln(len(s))\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "2\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

