func TestFlatStructCopyOutAndBack() testing.TestResult {
	// Copy a struct field out of @Outer, modify copy, write back — lazy struct paths
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "type Inner struct { X int; Y int }\n")
	b = buf.WriteStr(b, "type Outer struct { A int; Inner Inner }\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar o @Outer = make(Outer)\n")
	b = buf.WriteStr(b, "\to.Inner.X = 42\n")
	b = buf.WriteStr(b, "\to.Inner.Y = 99\n")
	b = buf.WriteStr(b, "\tvar inner Inner = o.Inner\n")
	b = buf.WriteStr(b, "\tprintln(inner.X)\n")
	b = buf.WriteStr(b, "\tinner.X = 0\n")
	b = buf.WriteStr(b, "\tprintln(o.Inner.X)\n")
	b = buf.WriteStr(b, "\tinner.X = 77\n")
	b = buf.WriteStr(b, "\to.Inner = inner\n")
	b = buf.WriteStr(b, "\tprintln(o.Inner.X)\n")
	b = buf.WriteStr(b, "\tprintln(o.Inner.Y)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "42\n42\n77\n99\n") {
		return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'")))
	}
	return ""
}

func TestScopeCleanupRefDec() testing.TestResult {
	// Function-local managed ptr should be RefDec'd on scope exit.
	// doWork copies n to a param and a local, then returns. Both copies
	// should be cleaned up, leaving rc at 1.
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "import \"pkg/rt\"\n")
	b = buf.WriteStr(b, "type Node struct { Val int }\n")
	b = buf.WriteStr(b, "func doWork(n @Node) int {\n")
	b = buf.WriteStr(b, "\tvar local @Node = n\n")
	b = buf.WriteStr(b, "\treturn local.Val\n")
	b = buf.WriteStr(b, "}\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar n @Node = make(Node)\n")
	b = buf.WriteStr(b, "\tn.Val = 42\n")
	b = buf.WriteStr(b, "\tvar ptr *uint8 = bit_cast(*uint8, n)\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(ptr))\n")
	b = buf.WriteStr(b, "\tvar v int = doWork(n)\n")
	b = buf.WriteStr(b, "\tprintln(v)\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(ptr))\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "1\n42\n1\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

