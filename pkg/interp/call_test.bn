	b = buf.WriteStr(b, "\tvar name @[]char = make_slice(char, 1)\n")
	b = buf.WriteStr(b, "\tvar pn *int = bit_cast(*int, &name)\n")
	b = buf.WriteStr(b, "\tvar bp *uint8 = bit_cast(*uint8, pn[2])\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(bp))\n")
	b = buf.WriteStr(b, "\tvar e Entry\n")
	b = buf.WriteStr(b, "\te.Name = name\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(bp))\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "1\n2\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

