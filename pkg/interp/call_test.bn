// ============================================================

func TestReturnManagedSlicePreservesElements() testing.TestResult {
	// Returning @[]@T from a function: elements must survive scope cleanup
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "import \"pkg/rt\"\n")
	b = buf.WriteStr(b, "type Item struct { Val int }\n")
	b = buf.WriteStr(b, "func makeItems() @[]@Item {\n")
	b = buf.WriteStr(b, "\tvar items @[]@Item = make_slice(@Item, 2)\n")
	b = buf.WriteStr(b, "\tvar a @Item = make(Item)\n")
	b = buf.WriteStr(b, "\ta.Val = 10\n")
	b = buf.WriteStr(b, "\titems[0] = a\n")
	b = buf.WriteStr(b, "\tvar b @Item = make(Item)\n")
	b = buf.WriteStr(b, "\tb.Val = 20\n")
	b = buf.WriteStr(b, "\titems[1] = b\n")
	b = buf.WriteStr(b, "\treturn items\n")
	b = buf.WriteStr(b, "}\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar items @[]@Item = makeItems()\n")
	b = buf.WriteStr(b, "\tprintln(items[0].Val)\n")
	b = buf.WriteStr(b, "\tprintln(items[1].Val)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "10\n20\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestReturnManagedSliceRefcountCorrect() testing.TestResult {
	// After returning @[]@T, elements should have correct refcount
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "import \"pkg/rt\"\n")
	b = buf.WriteStr(b, "type Item struct { Val int }\n")
	b = buf.WriteStr(b, "func makeOne() @[]@Item {\n")
	b = buf.WriteStr(b, "\tvar s @[]@Item = make_slice(@Item, 1)\n")
	b = buf.WriteStr(b, "\tvar it @Item = make(Item)\n")
	b = buf.WriteStr(b, "\tit.Val = 42\n")
	b = buf.WriteStr(b, "\ts[0] = it\n")
	b = buf.WriteStr(b, "\treturn s\n")
	b = buf.WriteStr(b, "}\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar s @[]@Item = makeOne()\n")
	b = buf.WriteStr(b, "\tvar ptr *uint8 = bit_cast(*uint8, s[0])\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(ptr))\n")
	b = buf.WriteStr(b, "\tprintln(s[0].Val)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	// rc=1: local `it` and param cleaned up, only s[0] holds reference
	if !seq(out, "1\n42\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

