// ============================================================
// Managed pointer refcount tests
// ============================================================

func TestManagedPtrRefcount() testing.TestResult {
	// make(T) should have rc=1, copy should RefInc to 2
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "import \"pkg/rt\"\n")
	b = buf.WriteStr(b, "type Node struct { Val int }\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar n @Node = make(Node)\n")
	b = buf.WriteStr(b, "\tvar ptr *uint8 = bit_cast(*uint8, n)\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(ptr))\n")
	b = buf.WriteStr(b, "\tvar m @Node = n\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(ptr))\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "1\n2\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestManagedPtrReassignRefcount() testing.TestResult {
	// Reassigning a managed var: old gets RefDec'd, new gets RefInc'd.
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "import \"pkg/rt\"\n")
	b = buf.WriteStr(b, "type Node struct { Val int }\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar a @Node = make(Node)\n")
	b = buf.WriteStr(b, "\tvar keep @Node = a\n")
	b = buf.WriteStr(b, "\tvar ptr *uint8 = bit_cast(*uint8, a)\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(ptr))\n")
	b = buf.WriteStr(b, "\tvar b @Node = make(Node)\n")
	b = buf.WriteStr(b, "\ta = b\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(ptr))\n")
	b = buf.WriteStr(b, "\tvar ptrB *uint8 = bit_cast(*uint8, b)\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(ptrB))\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "2\n1\n2\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestFieldAssignRefcount() testing.TestResult {
	// Assigning @T to struct field should RefInc
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "import \"pkg/rt\"\n")
	b = buf.WriteStr(b, "type Inner struct { Val int }\n")
	b = buf.WriteStr(b, "type Outer struct { Child @Inner }\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar inner @Inner = make(Inner)\n")
	b = buf.WriteStr(b, "\tvar ptr *uint8 = bit_cast(*uint8, inner)\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(ptr))\n")
	b = buf.WriteStr(b, "\tvar outer @Outer = make(Outer)\n")
	b = buf.WriteStr(b, "\touter.Child = inner\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(ptr))\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "1\n2\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestStructFieldDtorRefDec() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "import \"pkg/rt\"\n")
	b = buf.WriteStr(b, "type Inner struct { X int }\n")
	b = buf.WriteStr(b, "type Outer struct { Child @Inner }\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar inner @Inner = make(Inner)\n")
	b = buf.WriteStr(b, "\tvar ptr *uint8 = bit_cast(*uint8, inner)\n")
	b = buf.WriteStr(b, "\tvar outer @Outer = make(Outer)\n")
	b = buf.WriteStr(b, "\touter.Child = inner\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(ptr))\n")
	b = buf.WriteStr(b, "\touter = make(Outer)\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(ptr))\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "2\n1\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestFlatManagedPtrVariable() testing.TestResult {
	// Managed-ptr variables should use flat storage (8-byte pointer value)
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "import \"pkg/rt\"\n")
	b = buf.WriteStr(b, "type Node struct { Val int }\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar n @Node = make(Node)\n")
	b = buf.WriteStr(b, "\tn.Val = 42\n")
	b = buf.WriteStr(b, "\tprintln(n.Val)\n")
	b = buf.WriteStr(b, "\tvar ptr *uint8 = bit_cast(*uint8, n)\n")
	b = buf.WriteStr(b, "\tprintln(rt.Refcount(ptr))\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "42\n1\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestFlatManagedPtrBox() testing.TestResult {
	// box(Struct{...}) should produce a flat managed-ptr allocation
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "type Point struct { X int; Y int }\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar p @Point = box(Point{X: 10, Y: 20})\n")
	b = buf.WriteStr(b, "\tprintln(p.X)\n")
	b = buf.WriteStr(b, "\tprintln(p.Y)\n")
	b = buf.WriteStr(b, "\tp.X = 99\n")
	b = buf.WriteStr(b, "\tprintln(p.X)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "10\n20\n99\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestFlatStructValueType() testing.TestResult {
	// Struct value-type variables should use flat storage
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "type Pair struct { X int; Y int }\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar p Pair\n")
	b = buf.WriteStr(b, "\tp.X = 10\n")
	b = buf.WriteStr(b, "\tp.Y = 20\n")
	b = buf.WriteStr(b, "\tprintln(p.X + p.Y)\n")
	b = buf.WriteStr(b, "\tvar q Pair = p\n")
	b = buf.WriteStr(b, "\tq.X = 99\n")
	b = buf.WriteStr(b, "\tprintln(p.X)\n")
	b = buf.WriteStr(b, "\tprintln(q.X)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "30\n10\n99\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestStructFieldManagedSliceRefcount() testing.TestResult {
	// Setting a managed-slice field on a struct should RefInc
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "import \"pkg/rt\"\n")
	b = buf.WriteStr(b, "type Entry struct { Name @[]char; Val int }\n")
