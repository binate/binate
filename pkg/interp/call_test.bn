func TestRecursion() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func fib(n int) int { if n <= 1 { return n }; return fib(n-1) + fib(n-2) }\n")
	b = buf.WriteStr(b, "func main() { println(fib(10)) }\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
