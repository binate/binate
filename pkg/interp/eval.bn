package "pkg/interp"

import "pkg/token"
import "pkg/ast"
import "pkg/types"

// ============================================================
// Expression Evaluation
// ============================================================

// evalExpr dispatches expression evaluation by AST node kind.
func evalExpr(interp @Interpreter, e @ast.Expr, tl @TempList) @Value {
	if e == nil {
		return MakeNilVal()
	}

	if e.Kind == ast.EXPR_INT_LIT {
		return MakeIntVal(parseIntLiteral(e.Name), types.TypInt())
	}
	if e.Kind == ast.EXPR_STRING_LIT {
		return MakeStringVal(unescapeString(e.Name))
	}
	if e.Kind == ast.EXPR_CHAR_LIT {
		return MakeIntVal(evalCharLit(e.Name), types.TypUint8())
	}
	if e.Kind == ast.EXPR_BOOL_LIT {
		// BoolVal may not survive the bootstrap interpreter's struct handling.
		// Fall back to checking Name if set, otherwise use BoolVal.
		if len(e.Name) > 0 {
			return MakeBoolVal(streq(e.Name, "true"))
		}
		return MakeBoolVal(e.BoolVal)  // AST BoolVal, not Value.BoolVal
	}
	if e.Kind == ast.EXPR_NIL_LIT {
		return MakeNilVal()
	}
	if e.Kind == ast.EXPR_IDENT {
		return evalIdent(interp, e, tl)
	}
	if e.Kind == ast.EXPR_BINARY {
		return evalBinary(interp, e, tl)
	}
	if e.Kind == ast.EXPR_UNARY {
		return evalUnary(interp, e, tl)
	}
	if e.Kind == ast.EXPR_CALL {
		return evalCall(interp, e, tl)
	}
	if e.Kind == ast.EXPR_INDEX {
		return evalIndex(interp, e, tl)
	}
	if e.Kind == ast.EXPR_SLICE {
		return evalSlice(interp, e, tl)
	}
	if e.Kind == ast.EXPR_SELECTOR {
		return evalSelector(interp, e, tl)
	}
	if e.Kind == ast.EXPR_COMPOSITE {
		return evalCompositeLit(interp, e, tl)
	}
	if e.Kind == ast.EXPR_BUILTIN {
		return evalBuiltinCall(interp, e, tl)
	}

	return MakeNilVal()
}

// evalIdent resolves an identifier (variable, constant, or iota) from the environment.
func evalIdent(interp @Interpreter, e @ast.Expr, tl @TempList) @Value {
	if streq(e.Name, "iota") && interp.Iota >= 0 {
		return MakeIntVal(interp.Iota, types.TypInt())
	}
	var v @Value = envGet(interp.Env, e.Name)
	if v == nil {
		panic("undefined variable")
	}
	if v.Kind == VAL_MANAGED_PTR && v.RawAddr != nil {
		rt.RefInc(v.RawAddr)
		pushTemp(tl, v)
	}
	return v
}

// evalBinary evaluates a binary expression with short-circuit logic for && and ||.
func evalBinary(interp @Interpreter, e @ast.Expr, tl @TempList) @Value {
	var lhs @Value = evalExpr(interp, e.X, tl)
	// Short-circuit
	if e.Op == cast(int, token.LAND) {
		if !isTruthy(lhs) {
			return MakeBoolVal(false)
		}
		var rhs @Value = evalExpr(interp, e.Y, tl)
		return MakeBoolVal(isTruthy(rhs))
	}
	if e.Op == cast(int, token.LOR) {
		if isTruthy(lhs) {
			return MakeBoolVal(true)
		}
		var rhs @Value = evalExpr(interp, e.Y, tl)
		return MakeBoolVal(isTruthy(rhs))
	}
	var rhs @Value = evalExpr(interp, e.Y, tl)
	return evalBinaryOp(interp, e.Op, lhs, rhs, tl)
}

// evalBinaryOp applies a binary operator to two already-evaluated operands.
func evalBinaryOp(interp @Interpreter, op int, lhs @Value, rhs @Value, tl @TempList) @Value {
	// Int-Int operations
	if lhs.Kind == VAL_INT && rhs.Kind == VAL_INT {
		return evalIntBinaryOp(op, lhs, rhs)
	}

	// Nil comparisons
	if lhs.Kind == VAL_NIL {
		return evalNilCompare(op, rhs)
	}
	if rhs.Kind == VAL_NIL {
		return evalNilCompare(op, lhs)
	}

	// Bool comparisons
	if lhs.Kind == VAL_BOOL && rhs.Kind == VAL_BOOL {
		if op == cast(int, token.EQ) { return MakeBoolVal(lhs.RawAddr[0] == rhs.RawAddr[0]) }
		if op == cast(int, token.NEQ) { return MakeBoolVal(lhs.RawAddr[0] != rhs.RawAddr[0]) }
	}

	// String comparisons (no + operator — use Concat for concatenation)
	if IsString(lhs) && IsString(rhs) {
		if op == cast(int, token.EQ) { return MakeBoolVal(streq(StrOf(lhs), StrOf(rhs))) }
		if op == cast(int, token.NEQ) { return MakeBoolVal(!streq(StrOf(lhs), StrOf(rhs))) }
	}

	// Pointer comparison (by raw address)
	if (lhs.Kind == VAL_POINTER || lhs.Kind == VAL_MANAGED_PTR) &&
			(rhs.Kind == VAL_POINTER || rhs.Kind == VAL_MANAGED_PTR) {
		var lAddr int = bit_cast(int, lhs.RawAddr)
		var rAddr int = bit_cast(int, rhs.RawAddr)
		if op == cast(int, token.EQ) { return MakeBoolVal(lAddr == rAddr) }
		if op == cast(int, token.NEQ) { return MakeBoolVal(lAddr != rAddr) }
	}

	panic("unsupported binary operation")
	return MakeNilVal()
}

// evalIntBinaryOp evaluates arithmetic, bitwise, and comparison operators on two integer values.
func evalIntBinaryOp(op int, lv @Value, rv @Value) @Value {
	var l int = IntOf(lv)
	var r int = IntOf(rv)
	if op == cast(int, token.PLUS) { return MakeIntVal(l + r, lv.Typ) }
	if op == cast(int, token.MINUS) { return MakeIntVal(l - r, lv.Typ) }
	if op == cast(int, token.STAR) { return MakeIntVal(l * r, lv.Typ) }
	if op == cast(int, token.SLASH) {
		if r == 0 { panic("division by zero") }
		return MakeIntVal(l / r, lv.Typ)
	}
	if op == cast(int, token.PERCENT) {
		if r == 0 { panic("division by zero") }
		return MakeIntVal(l % r, lv.Typ)
	}
	if op == cast(int, token.AMP) { return MakeIntVal(l & r, lv.Typ) }
	if op == cast(int, token.PIPE) { return MakeIntVal(l | r, lv.Typ) }
	if op == cast(int, token.CARET) { return MakeIntVal(l ^ r, lv.Typ) }
	if op == cast(int, token.SHL) { return MakeIntVal(shiftLeft(l, r), lv.Typ) }
	if op == cast(int, token.SHR) { return MakeIntVal(shiftRight(l, r), lv.Typ) }
	if op == cast(int, token.EQ) { return MakeBoolVal(l == r) }
	if op == cast(int, token.NEQ) { return MakeBoolVal(l != r) }
	if op == cast(int, token.LT) { return MakeBoolVal(l < r) }
	if op == cast(int, token.GT) { return MakeBoolVal(l > r) }
	if op == cast(int, token.LEQ) { return MakeBoolVal(l <= r) }
	if op == cast(int, token.GEQ) { return MakeBoolVal(l >= r) }
	panic("unsupported int operator")
	return MakeNilVal()
}

// evalNilCompare compares a value against nil (supports pointers, slices, and nil values).
func evalNilCompare(op int, other @Value) @Value {
	var isNil bool = false
	if other.Kind == VAL_NIL {
		isNil = true
	}
	if other.Kind == VAL_POINTER || other.Kind == VAL_MANAGED_PTR {
		isNil = other.RawAddr == nil
	}
	if other.Kind == VAL_SLICE || other.Kind == VAL_MANAGED_SLICE {
		if other.RawAddr != nil {
			var dp int = readScalar(
				bit_cast(*uint8, bit_cast(int, other.RawAddr) + types.SliceDataOffset()),
				types.TypInt())
			isNil = dp == 0
		} else {
			isNil = true
		}
	}
	if op == cast(int, token.EQ) { return MakeBoolVal(isNil) }
	if op == cast(int, token.NEQ) { return MakeBoolVal(!isNil) }
	panic("invalid nil comparison operator")
	return MakeNilVal()
}

// evalUnary evaluates a unary expression: negation, not, bitwise
// complement, dereference, or address-of.
func evalUnary(interp @Interpreter, e @ast.Expr, tl @TempList) @Value {
	var x @Value = evalExpr(interp, e.X, tl)
	if e.Op == cast(int, token.MINUS) {
		return MakeIntVal(0 - IntOf(x), x.Typ)
	}
	if e.Op == cast(int, token.NOT) {
		return MakeBoolVal(!isTruthy(x))
	}
	if e.Op == cast(int, token.TILDE) {
		return MakeIntVal(~IntOf(x), x.Typ)
	}
	if e.Op == cast(int, token.STAR) {
		// Dereference
		if x.Kind == VAL_POINTER || x.Kind == VAL_MANAGED_PTR {
			if x.RawAddr != nil {
				var elemTyp @types.Type
				if x.Typ != nil { elemTyp = x.Typ.Elem }
				if elemTyp != nil {
					return readFlatValue(x.RawAddr, elemTyp)
				}
			}
			panic("nil pointer dereference")
		}
		panic("cannot dereference non-pointer")
	}
	if e.Op == cast(int, token.AMP) {
		// Address-of
		if e.X.Kind == ast.EXPR_IDENT {
			// For flat memory entries, create a pointer with the flat address
			var flatAddr *uint8 = envGetAddr(interp.Env, e.X.Name)
			if flatAddr != nil {
				var varTyp @types.Type = envGetTyp(interp.Env, e.X.Name)
				return MakePointerValRaw(flatAddr, types.MakePointerType(varTyp))
			}
			// Cell fallback (function values only)
			var cell @HeapObject = envGetCell(interp.Env, e.X.Name)
			if cell != nil && cell.Val != nil {
				var exprTyp @types.Type = valueType(cell.Val)
				if exprTyp == nil { exprTyp = types.TypInt() }
				var tmp *uint8 = allocFlat(exprTyp)
				writeFlatValue(tmp, cell.Val, exprTyp)
				return MakePointerValRaw(tmp, types.MakePointerType(exprTyp))
			}
		}
		// &arr[i] — address of array element
		if e.X.Kind == ast.EXPR_INDEX {
			var arr @Value = evalExpr(interp, e.X.X, tl)
			var idx @Value = evalExpr(interp, e.X.Y, tl)
			if arr.Kind == VAL_ARRAY && arr.RawAddr != nil {
				var elemTyp @types.Type
				if arr.Typ != nil { elemTyp = arr.Typ.Elem }
				if elemTyp != nil {
					var elemSize int = types.SizeOf(elemTyp)
					var elemAddr *uint8 = bit_cast(*uint8, bit_cast(int, arr.RawAddr) + IntOf(idx) * elemSize)
					return MakePointerValRaw(elemAddr, types.MakePointerType(elemTyp))
				}
			}
		}
		// General &expr: allocate a flat temp and store the value
		var exprTyp @types.Type = valueType(x)
		if exprTyp == nil { exprTyp = types.TypInt() }
		var tmp *uint8 = allocFlat(exprTyp)
		writeFlatValue(tmp, x, exprTyp)
		return MakePointerValRaw(tmp, types.MakePointerType(exprTyp))
	}
	panic("unsupported unary operator")
	return MakeNilVal()
}


// evalIndex evaluates an index expression (array, slice,
// managed-slice, string, or pointer indexing).
func evalIndex(interp @Interpreter, e @ast.Expr, tl @TempList) @Value {
	var x @Value = evalExpr(interp, e.X, tl)
	var idx @Value = evalExpr(interp, e.Y, tl)
	var i int = IntOf(idx)

	// Flat path: read element from flat memory
	if x.RawAddr != nil && x.Typ != nil {
		var elemTyp @types.Type = x.Typ.Elem
		if elemTyp != nil {
			var dataAddr int = 0
			var slen int = 0
			if x.Kind == VAL_ARRAY {
				dataAddr = bit_cast(int, x.RawAddr)
				slen = x.Typ.ArrayLen
			} else if x.Kind == VAL_SLICE || x.Kind == VAL_MANAGED_SLICE {
				var base int = bit_cast(int, x.RawAddr)
				dataAddr = readScalar(
					bit_cast(*uint8, base + types.SliceDataOffset()), types.TypInt())
				slen = readScalar(
					bit_cast(*uint8, base + types.SliceLenOffset()), types.TypInt())
			}
			if dataAddr != 0 {
				if i < 0 || i >= slen { panic("index out of bounds") }
				var elemSize int = types.SizeOf(elemTyp)
				var elemAddr *uint8 = bit_cast(*uint8, dataAddr + i * elemSize)
				var ev @Value = readFlatValue(elemAddr, elemTyp)
				if ev.Kind == VAL_MANAGED_PTR && ev.RawAddr != nil {
					rt.RefInc(ev.RawAddr)
					pushTemp(tl, ev)
				}
				return ev
			}
		}
	}
	if IsString(x) {
		var slen int = len(StrOf(x))
		if i < 0 || i >= slen {
			panic("index out of bounds")
		}
		return MakeIntVal(cast(int, StrOf(x)[i]), types.TypUint8())
	}
	// Pointer indexing: p[i] where p is *T
	if x.Kind == VAL_POINTER && x.RawAddr != nil {
		var elemTyp @types.Type
		if x.Typ != nil { elemTyp = x.Typ.Elem }
		if elemTyp != nil {
			var elemSize int = types.SizeOf(elemTyp)
			var addr *uint8 = bit_cast(*uint8, bit_cast(int, x.RawAddr) + i * elemSize)
			return readFlatValue(addr, elemTyp)
		}
	}
	panic("cannot index this type")
	return MakeNilVal()
}

// evalSlice evaluates a slice expression (x[lo:hi]) on arrays, raw slices, or managed-slices.
func evalSlice(interp @Interpreter, e @ast.Expr, tl @TempList) @Value {
	var x @Value = evalExpr(interp, e.X, tl)
	if IsString(x) && x.Kind != VAL_MANAGED_SLICE {
		x = stringToCharSlice(StrOf(x))
	}

	// Flat array slicing: produce a flat slice pointing into the array's memory
	if x.Kind == VAL_ARRAY && x.RawAddr != nil && x.Typ != nil {
		var elemTyp @types.Type = x.Typ.Elem
		if elemTyp != nil {
			var elemSize int = types.SizeOf(elemTyp)
			var arrLen int = x.Typ.ArrayLen

			var lo int = 0
			var hi int = arrLen
			if e.Z != nil { lo = IntOf(evalExpr(interp, e.Z, tl)) }
			if e.Y != nil { hi = IntOf(evalExpr(interp, e.Y, tl)) }

			// Create flat slice: {data = &arr[lo], len = hi-lo}
			var sliceTyp @types.Type = types.MakeSliceType(elemTyp)
			var sliceAddr *uint8 = allocFlat(sliceTyp)
			var dataAddr int = bit_cast(int, x.RawAddr) + lo * elemSize
			var p *uint8 = bit_cast(*uint8, bit_cast(int, sliceAddr) + types.SliceDataOffset())
			writeScalar(p, types.TypInt(), dataAddr)
			p = bit_cast(*uint8, bit_cast(int, sliceAddr) + types.SliceLenOffset())
			writeScalar(p, types.TypInt(), hi - lo)

			return readFlatValue(sliceAddr, sliceTyp)
		}
	}

	// Flat raw-slice subslicing: adjust data/len
	if x.Kind == VAL_SLICE && x.RawAddr != nil && x.Typ != nil &&
			x.Typ.Kind == types.TYP_SLICE {
		var elemTyp @types.Type = x.Typ.Elem
		if elemTyp != nil {
			var elemSize int = types.SizeOf(elemTyp)
			var srcData int = readScalar(
				bit_cast(*uint8, bit_cast(int, x.RawAddr) + types.SliceDataOffset()),
				types.TypInt())
			var srcLen int = readScalar(
				bit_cast(*uint8, bit_cast(int, x.RawAddr) + types.SliceLenOffset()),
				types.TypInt())
			var lo int = 0
			var hi int = srcLen
			if e.Z != nil { lo = IntOf(evalExpr(interp, e.Z, tl)) }
			if e.Y != nil { hi = IntOf(evalExpr(interp, e.Y, tl)) }
			var subAddr *uint8 = allocFlat(x.Typ)
			writeScalar(
				bit_cast(*uint8, bit_cast(int, subAddr) + types.SliceDataOffset()),
				types.TypInt(), srcData + lo * elemSize)
			writeScalar(
				bit_cast(*uint8, bit_cast(int, subAddr) + types.SliceLenOffset()),
				types.TypInt(), hi - lo)
			return readFlatValue(subAddr, x.Typ)
		}
	}

	// Flat managed-slice subslicing: share backing, adjust data/len
	if x.Kind == VAL_MANAGED_SLICE && x.RawAddr != nil && x.Typ != nil &&
			x.Typ.Kind == types.TYP_MANAGED_SLICE {
		var elemTyp @types.Type = x.Typ.Elem
		if elemTyp != nil {
			var elemSize int = types.SizeOf(elemTyp)
			var srcData int = readScalar(
				bit_cast(*uint8, bit_cast(int, x.RawAddr) + types.MSliceDataOffset()),
				types.TypInt())
			var srcLen int = readScalar(
				bit_cast(*uint8, bit_cast(int, x.RawAddr) + types.MSliceLenOffset()),
				types.TypInt())
			var backing int = readScalar(
				bit_cast(*uint8, bit_cast(int, x.RawAddr) + types.MSliceBackingOffset()),
				types.TypInt())
			var backingLen int = readScalar(
				bit_cast(*uint8, bit_cast(int, x.RawAddr) + types.MSliceBackingLenOffset()),
				types.TypInt())

			var lo int = 0
			var hi int = srcLen
			if e.Z != nil { lo = IntOf(evalExpr(interp, e.Z, tl)) }
			if e.Y != nil { hi = IntOf(evalExpr(interp, e.Y, tl)) }

			// Build new 4-word header: {data+lo*elem, hi-lo, backing, backingLen}
			var subAddr *uint8 = allocFlat(x.Typ)
			writeScalar(
				bit_cast(*uint8, bit_cast(int, subAddr) + types.MSliceDataOffset()),
				types.TypInt(), srcData + lo * elemSize)
			writeScalar(
				bit_cast(*uint8, bit_cast(int, subAddr) + types.MSliceLenOffset()),
				types.TypInt(), hi - lo)
			writeScalar(
				bit_cast(*uint8, bit_cast(int, subAddr) + types.MSliceBackingOffset()),
				types.TypInt(), backing)
			writeScalar(
				bit_cast(*uint8, bit_cast(int, subAddr) + types.MSliceBackingLenOffset()),
				types.TypInt(), backingLen)
			// Note: no RefInc here — envDefine handles it when
			// the subslice is stored in a variable.
			return readFlatValue(subAddr, x.Typ)
		}
	}

	panic("slice expression on non-flat value")
	return MakeNilVal()
}

// evalSelector evaluates a field access (x.Name), including
// package-qualified and auto-deref access.
func evalSelector(interp @Interpreter, e @ast.Expr, tl @TempList) @Value {
	// Package-qualified access
	if e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		var pkgPath @[]char = lookupAlias(interp.ImportAliases, e.X.Name)
		if len(pkgPath) > 0 {
			var pkg @PkgEnv = lookupPkgEnv(interp.Packages, pkgPath)
			if pkg != nil {
				var v @Value = envGet(pkg.Env, e.Name)
				if v != nil {
					if v.Kind == VAL_MANAGED_PTR &&
							v.RawAddr != nil {
						rt.RefInc(v.RawAddr)
						pushTemp(tl, v)
					}
					return v
				}
			}
		}
	}

	var x @Value = evalExpr(interp, e.X, tl)

	// Auto-deref: read field from managed allocation at RawAddr
	if x.Kind == VAL_POINTER || x.Kind == VAL_MANAGED_PTR {
		if x.RawAddr != nil && x.Typ != nil {
			var elemTyp @types.Type = x.Typ.Elem
			if elemTyp != nil && elemTyp.Kind == types.TYP_STRUCT && len(elemTyp.Fields) > 0 {
				for i := 0; i < len(elemTyp.Fields); i++ {
					if streq(elemTyp.Fields[i].Name, e.Name) {
						var offset int = types.FieldOffset(elemTyp, i)
						var fieldAddr *uint8 = bit_cast(*uint8, bit_cast(int, x.RawAddr) + offset)
						var fv @Value = readFlatValue(fieldAddr, elemTyp.Fields[i].Type)
						if fv.Kind == VAL_MANAGED_PTR && fv.RawAddr != nil {
							rt.RefInc(fv.RawAddr)
							pushTemp(tl, fv)
						}
						return fv
					}
				}
			}
		}
	}

	if x.Kind == VAL_STRUCT {
		// Flat embedded struct: read from RawAddr + FieldOffset
		if x.RawAddr != nil && x.Typ != nil {
			var st @types.Type = x.Typ
			for i := 0; i < len(st.Fields); i++ {
				if streq(st.Fields[i].Name, e.Name) {
					var offset int = types.FieldOffset(st, i)
					var fieldAddr *uint8 = bit_cast(*uint8, bit_cast(int, x.RawAddr) + offset)
					var fv @Value = readFlatValue(fieldAddr, st.Fields[i].Type)
					if fv.Kind == VAL_MANAGED_PTR && fv.RawAddr != nil {
						rt.RefInc(fv.RawAddr)
						pushTemp(tl, fv)
					}
					return fv
				}
			}
		}
		panic("struct without RawAddr")
	}

	panic("cannot access field on this type")
	return MakeNilVal()
}

// evalCompositeLit evaluates a composite literal (struct or array).
func evalCompositeLit(interp @Interpreter, e @ast.Expr, tl @TempList) @Value {
	var typ @types.Type = resolveType(interp, e.TypeRef, tl)
	var resolved @types.Type = types.ResolveAlias(typ)

	if resolved != nil && resolved.Kind == types.TYP_STRUCT {
		return evalStructLit(interp, e, resolved, tl)
	}
	if resolved != nil && resolved.Kind == types.TYP_ARRAY {
		return evalArrayLit(interp, e, resolved, tl)
	}
	if resolved != nil && resolved.Kind == types.TYP_NAMED && resolved.Underlying != nil {
		if resolved.Underlying.Kind == types.TYP_STRUCT {
			return evalStructLit(interp, e, resolved.Underlying, tl)
		}
	}

	panic("unsupported composite literal type")
	return MakeNilVal()
}

// evalStructLit allocates flat memory for a struct literal and writes keyed or positional fields.
func evalStructLit(interp @Interpreter, e @ast.Expr, st @types.Type, tl @TempList) @Value {
	// Allocate flat struct and write fields directly
	var addr *uint8 = allocFlat(st)
	if len(e.Elems) > 0 && e.Elems[0].Key != nil {
		// Keyed
		for i := 0; i < len(e.Elems); i++ {
			var key *[]char = e.Elems[i].Key.Name
			var val @Value = evalExpr(interp, e.Elems[i].Value, tl)
			for j := 0; j < len(st.Fields); j++ {
				if streq(st.Fields[j].Name, key) {
					var offset int = types.FieldOffset(st, j)
					var fieldAddr *uint8 = bit_cast(*uint8, bit_cast(int, addr) + offset)
					writeFlatValue(fieldAddr, val, st.Fields[j].Type)
					break
				}
			}
		}
	} else {
		for i := 0; i < len(e.Elems); i++ {
			if i < len(st.Fields) {
				var val @Value = evalExpr(interp, e.Elems[i].Value, tl)
				var offset int = types.FieldOffset(st, i)
				var fieldAddr *uint8 = bit_cast(*uint8, bit_cast(int, addr) + offset)
				writeFlatValue(fieldAddr, val, st.Fields[i].Type)
			}
		}
	}
	var v @Value = make(Value)
	v.Kind = VAL_STRUCT
	v.Typ = st
	v.RawAddr = addr
	return v
}

// evalArrayLit allocates flat memory for an array literal and writes elements by position.
func evalArrayLit(interp @Interpreter, e @ast.Expr, at @types.Type, tl @TempList) @Value {
	// Allocate flat array and write elements directly
	var addr *uint8 = allocFlat(at)
	var elemSize int = types.SizeOf(at.Elem)
	for i := 0; i < len(e.Elems); i++ {
		if i < at.ArrayLen {
			var elemAddr *uint8 = bit_cast(*uint8, bit_cast(int, addr) + i * elemSize)
			var val @Value = evalExpr(interp, e.Elems[i].Value, tl)
			writeFlatValue(elemAddr, val, at.Elem)
		}
	}
	var v @Value = make(Value)
	v.Kind = VAL_ARRAY
	v.Typ = at
	v.RawAddr = addr
	return v
}

