package "pkg/interp"

import "pkg/token"
import "pkg/ast"
import "pkg/types"

// ============================================================
// Statement Execution
// ============================================================

// execStmt dispatches statement execution by AST node kind. No-ops when a signal is active.
func execStmt(interp @Interpreter, s @ast.Stmt) {
	if interp.Signal != SIG_NONE {
		return
	}
	if s == nil {
		return
	}

	if s.Kind == ast.STMT_EXPR {
		evalExpr(interp, s.X)
		return
	}
	if s.Kind == ast.STMT_ASSIGN {
		execAssign(interp, s)
		return
	}
	if s.Kind == ast.STMT_SHORT_VAR {
		execShortVarDecl(interp, s)
		return
	}
	if s.Kind == ast.STMT_INC_DEC {
		execIncDec(interp, s)
		return
	}
	if s.Kind == ast.STMT_RETURN {
		var vals @[]@Value = make_slice(@Value, len(s.Exprs))
		for i := 0; i < len(s.Exprs); i++ {
			vals[i] = evalExpr(interp, s.Exprs[i])
			// For local-ident returns, mark as fresh so the caller's
			// envDefine doesn't RefInc (ownership transfers via cleanup skip).
			// For non-ident returns (field access, global, call), the Value
			// is a shared reference — not fresh, caller must RefInc.
			// Only check the CURRENT scope (not parents) to exclude globals.
			if s.Exprs[i].Kind == ast.EXPR_IDENT {
				if envGetLocalAddr(interp.Env, s.Exprs[i].Name) != nil {
					vals[i].IsFresh = true
				}
			}
			// Axiom 3: struct return → copy constructor.
			// RefInc managed fields so that cleanupEnvExcept's structRefDec
			// doesn't free them from under the caller.
			if vals[i] != nil && vals[i].RawAddr != nil && vals[i].Typ != nil {
				var rt @types.Type = resolveUnderlying(vals[i].Typ)
				if (rt.Kind == types.TYP_STRUCT || rt.Kind == types.TYP_ARRAY) &&
						types.NeedsDestruction(rt) {
					structRefInc(vals[i].RawAddr, rt)
				}
			}
		}
		interp.Signal = SIG_RETURN
		interp.ReturnVals = vals
		return
	}
	if s.Kind == ast.STMT_BREAK {
		interp.Signal = SIG_BREAK
		return
	}
	if s.Kind == ast.STMT_CONTINUE {
		interp.Signal = SIG_CONTINUE
		return
	}
	if s.Kind == ast.STMT_BLOCK {
		pushEnv(interp)
		execBlock(interp, s)
		popEnv(interp)
		return
	}
	if s.Kind == ast.STMT_IF {
		execIf(interp, s)
		return
	}
	if s.Kind == ast.STMT_FOR {
		execFor(interp, s)
		return
	}
	if s.Kind == ast.STMT_SWITCH {
		execSwitch(interp, s)
		return
	}
	if s.Kind == ast.STMT_DECL {
		if s.DeclRef != nil {
			if s.DeclRef.Kind == ast.DECL_VAR {
				execVarDecl(interp, s.DeclRef)
			}
			if s.DeclRef.Kind == ast.DECL_CONST {
				execConstDecl(interp, s.DeclRef)
			}
			if s.DeclRef.Kind == ast.DECL_TYPE {
				execTypeDecl(interp, s.DeclRef)
			}
		}
		return
	}
	// STMT_EMPTY — nothing
}

// execBlock executes each statement in a block, stopping early on break/continue/return.
func execBlock(interp @Interpreter, s @ast.Stmt) {
	if s == nil {
		return
	}
	for i := 0; i < len(s.Stmts); i++ {
		execStmt(interp, s.Stmts[i])
		if interp.Signal != SIG_NONE {
			return
		}
	}
}

// execAssign executes simple (=) or compound (+=, etc.) assignments, including multi-return unpacking.
func execAssign(interp @Interpreter, s @ast.Stmt) {
	if s.Op == cast(int, token.ASSIGN) {
		// Multi-return check: rhs is a flat struct with fields _0, _1, ...
		if len(s.Exprs2) == 1 && len(s.Exprs) > 1 {
			var rhs @Value = evalExpr(interp, s.Exprs2[0])
			if rhs.Kind == VAL_STRUCT && rhs.RawAddr != nil && rhs.Typ != nil &&
					len(rhs.Typ.Fields) == len(s.Exprs) {
				for i := 0; i < len(s.Exprs); i++ {
					var offset int = types.FieldOffset(rhs.Typ, i)
					var fieldAddr *uint8 = bit_cast(*uint8, bit_cast(int, rhs.RawAddr) + offset)
					var fieldVal @Value = readFlatValue(fieldAddr, rhs.Typ.Fields[i].Type)
					assignTo(interp, s.Exprs[i], fieldVal)
				}
				return
			}
		}
		for i := 0; i < len(s.Exprs); i++ {
			var val @Value = evalExpr(interp, s.Exprs2[i])
			assignTo(interp, s.Exprs[i], val)
		}
	} else {
		// Compound assignment
		var lhsVal @Value = evalExpr(interp, s.Exprs[0])
		var rhsVal @Value = evalExpr(interp, s.Exprs2[0])
		var baseOp int = compoundToBase(s.Op)
		var result @Value = evalBinaryOp(interp, baseOp, lhsVal, rhsVal)
		assignTo(interp, s.Exprs[0], result)
	}
}

// assignTo writes a value to an lvalue: ident, index, selector, or dereference (*p = val).
// Handles RefInc/RefDec for managed types on overwrite.
func assignTo(interp @Interpreter, lhs @ast.Expr, val @Value) {
	if lhs.Kind == ast.EXPR_IDENT {
		if val != nil && (val.Kind == VAL_STRUCT ||
				val.Kind == VAL_ARRAY) {
			var cv @Value = copyValue(val)
			if !envSet(interp.Env, lhs.Name, cv) {
				envDefine(interp.Env, lhs.Name, cv)
			}
		} else {
			if !envSet(interp.Env, lhs.Name, val) {
				envDefine(interp.Env, lhs.Name, val)
			}
			// Release readFlatValue's transient ref.
			if val != nil && val.Kind == VAL_MANAGED_PTR &&
					!val.IsFresh {
				cleanValue(val)
			}
		}
		return
	}
	if lhs.Kind == ast.EXPR_INDEX {
		var container @Value = evalExpr(interp, lhs.X)
		var idx @Value = evalExpr(interp, lhs.Y)
		var i int = IntOf(idx)
		var isSlice bool = container.Kind == VAL_SLICE ||
			container.Kind == VAL_MANAGED_SLICE
		if isSlice && container.RawAddr != nil && container.Typ != nil {
			// Flat slice: write to flat element address
			var elemTyp @types.Type = container.Typ.Elem
			if elemTyp != nil {
				var p *uint8 = bit_cast(*uint8, bit_cast(int, container.RawAddr) + types.SliceDataOffset())
				var dataAddr int = readScalar(p, types.TypInt())
				var elemSize int = types.SizeOf(elemTyp)
				var addr *uint8 = bit_cast(*uint8, dataAddr + i * elemSize)
				// RefDec old / RefInc new for managed elements
				if elemTyp.Kind == types.TYP_MANAGED_PTR {
					var oldPtr int = readScalar(addr, types.TypInt())
					if oldPtr != 0 {
						rt.RefDec(bit_cast(*uint8, oldPtr), nil)
					}
					if val != nil && val.Kind == VAL_MANAGED_PTR && val.RawAddr != nil {
						rt.RefInc(val.RawAddr)
					}
				}
				if elemTyp.Kind == types.TYP_MANAGED_SLICE {
					msliceRefDecBacking(addr)
				}
				if elemTyp.Kind == types.TYP_STRUCT {
					structElemRefcount(addr, val, elemTyp)
				}
				writeFlatValue(addr, val, elemTyp)
				if elemTyp.Kind == types.TYP_MANAGED_SLICE {
					msliceRefIncBacking(addr)
				}
			}
		} else if container.Kind == VAL_ARRAY && container.RawAddr != nil {
			// Flat array: write to flat memory
			var elemTyp @types.Type
			if container.Typ != nil { elemTyp = container.Typ.Elem }
			if elemTyp != nil {
				var elemSize int = types.SizeOf(elemTyp)
				var addr *uint8 = bit_cast(*uint8, bit_cast(int, container.RawAddr) + i * elemSize)
				// RefDec old / RefInc new for managed elements
				if elemTyp.Kind == types.TYP_MANAGED_PTR {
					var oldPtr int = readScalar(addr, types.TypInt())
					if oldPtr != 0 {
						rt.RefDec(bit_cast(*uint8, oldPtr), nil)
					}
					if val != nil && val.Kind == VAL_MANAGED_PTR && val.RawAddr != nil {
						rt.RefInc(val.RawAddr)
					}
				}
				if elemTyp.Kind == types.TYP_MANAGED_SLICE {
					msliceRefDecBacking(addr)
				}
				if elemTyp.Kind == types.TYP_STRUCT {
					structElemRefcount(addr, val, elemTyp)
				}
				writeFlatValue(addr, val, elemTyp)
				if elemTyp.Kind == types.TYP_MANAGED_SLICE {
					msliceRefIncBacking(addr)
				}
			}
			}
			// Pointer index assignment: p[i] = val
		if container.Kind == VAL_POINTER && container.RawAddr != nil {
			var elemTyp @types.Type
			if container.Typ != nil { elemTyp = container.Typ.Elem }
			if elemTyp != nil {
				var elemSize int = types.SizeOf(elemTyp)
				var addr *uint8 = bit_cast(*uint8, bit_cast(int, container.RawAddr) + i * elemSize)
				writeFlatValue(addr, val, elemTyp)
			}
		}
		return
	}
	if lhs.Kind == ast.EXPR_SELECTOR {
		var obj @Value = evalExpr(interp, lhs.X)
		// Flat auto-deref: write field at RawAddr + FieldOffset
		if (obj.Kind == VAL_POINTER || obj.Kind == VAL_MANAGED_PTR) &&
			obj.RawAddr != nil && obj.Typ != nil {
			var elemTyp @types.Type = obj.Typ.Elem
			if elemTyp != nil && elemTyp.Kind == types.TYP_STRUCT && len(elemTyp.Fields) > 0 {
				for i := 0; i < len(elemTyp.Fields); i++ {
					if streq(elemTyp.Fields[i].Name, lhs.Name) {
						var fieldTyp @types.Type = elemTyp.Fields[i].Type
						var offset int = types.FieldOffset(elemTyp, i)
						var fieldAddr *uint8 = bit_cast(*uint8, bit_cast(int, obj.RawAddr) + offset)
						var ft @types.Type = resolveUnderlying(fieldTyp)
						if ft.Kind == types.TYP_MANAGED_PTR {
							if val != nil && val.Kind == VAL_MANAGED_PTR && val.RawAddr != nil {
								rt.RefInc(val.RawAddr)
							}
							var oldPtr int = readScalar(fieldAddr, types.TypInt())
							if oldPtr != 0 { rt.RefDec(bit_cast(*uint8, oldPtr), nil) }
						}
						if ft.Kind == types.TYP_MANAGED_SLICE {
							if val != nil && val.RawAddr != nil {
								msliceRefIncBacking(val.RawAddr)
							}
							msliceRefDecBacking(fieldAddr)
						}
						if (ft.Kind == types.TYP_STRUCT || ft.Kind == types.TYP_ARRAY) &&
								types.NeedsDestruction(ft) {
							if val != nil && val.RawAddr != nil {
								structRefInc(val.RawAddr, ft)
							}
							structRefDec(fieldAddr, ft)
						}
						writeFlatValue(fieldAddr, val, fieldTyp)
						return
					}
				}
			}
		}
		if obj.Kind == VAL_STRUCT {
			if obj.RawAddr != nil && obj.Typ != nil {
				var st @types.Type = obj.Typ
				for i := 0; i < len(st.Fields); i++ {
					if streq(st.Fields[i].Name, lhs.Name) {
						var fieldTyp @types.Type = st.Fields[i].Type
						var offset int = types.FieldOffset(st, i)
						var fieldAddr *uint8 = bit_cast(*uint8, bit_cast(int, obj.RawAddr) + offset)
						var ft @types.Type = resolveUnderlying(fieldTyp)
						// RefInc new / RefDec old for managed fields
						if ft.Kind == types.TYP_MANAGED_PTR {
							if val != nil && val.Kind == VAL_MANAGED_PTR && val.RawAddr != nil {
								rt.RefInc(val.RawAddr)
							}
							var oldPtr int = readScalar(fieldAddr, types.TypInt())
							if oldPtr != 0 { rt.RefDec(bit_cast(*uint8, oldPtr), nil) }
						}
						if ft.Kind == types.TYP_MANAGED_SLICE {
							if val != nil && val.RawAddr != nil {
								msliceRefIncBacking(val.RawAddr)
							}
							msliceRefDecBacking(fieldAddr)
						}
						// Nested struct/array with managed fields:
						// RefInc new, RefDec old (axiom 5).
						if (ft.Kind == types.TYP_STRUCT || ft.Kind == types.TYP_ARRAY) &&
								types.NeedsDestruction(ft) {
							if val != nil && val.RawAddr != nil {
								structRefInc(val.RawAddr, ft)
							}
							structRefDec(fieldAddr, ft)
						}
						writeFlatValue(fieldAddr, val, fieldTyp)
						return
					}
				}
			}
		}
		return
	}
	if lhs.Kind == ast.EXPR_UNARY {
		if lhs.Op == cast(int, token.STAR) {
			// *p = val
			var ptr @Value = evalExpr(interp, lhs.X)
			if ptr.Kind == VAL_POINTER || ptr.Kind == VAL_MANAGED_PTR {
				if ptr.RawAddr != nil {
					var elemTyp @types.Type
					if ptr.Typ != nil { elemTyp = ptr.Typ.Elem }
					if elemTyp != nil {
						// RefInc new / RefDec old for managed types
						if elemTyp.Kind == types.TYP_MANAGED_PTR {
							if val != nil && val.Kind == VAL_MANAGED_PTR && val.RawAddr != nil {
								rt.RefInc(val.RawAddr)
							}
							var old @Value = readFlatValue(ptr.RawAddr, elemTyp)
							if old != nil && old.RawAddr != nil {
								interpRefDec(old)
							}
						}
						if elemTyp.Kind == types.TYP_MANAGED_SLICE {
							if val != nil && val.RawAddr != nil {
								msliceRefIncBacking(val.RawAddr)
							}
							msliceRefDecBacking(ptr.RawAddr)
						}
						writeFlatValue(ptr.RawAddr, val, elemTyp)
					}
				}
			}
			return
		}
	}
}

// execShortVarDecl executes a short variable declaration (:=), including multi-return unpacking.
func execShortVarDecl(interp @Interpreter, s @ast.Stmt) {
	if len(s.Exprs2) == 1 && len(s.Exprs) > 1 {
		var rhs @Value = evalExpr(interp, s.Exprs2[0])
		if rhs.Kind == VAL_STRUCT && rhs.RawAddr != nil && rhs.Typ != nil &&
				len(rhs.Typ.Fields) == len(s.Exprs) {
			for i := 0; i < len(s.Exprs); i++ {
				var offset int = types.FieldOffset(rhs.Typ, i)
				var fieldAddr *uint8 = bit_cast(*uint8, bit_cast(int, rhs.RawAddr) + offset)
				var fieldVal @Value = readFlatValue(
				fieldAddr, rhs.Typ.Fields[i].Type)
				if fieldVal != nil && (fieldVal.Kind == VAL_STRUCT ||
						fieldVal.Kind == VAL_ARRAY) {
					envDefine(interp.Env,
						s.Exprs[i].Name, copyValue(fieldVal))
				} else {
					envDefine(interp.Env,
						s.Exprs[i].Name, fieldVal)
					if fieldVal != nil &&
						fieldVal.Kind == VAL_MANAGED_PTR &&
						!fieldVal.IsFresh {
						cleanValue(fieldVal)
					}
				}
			}
			return
		}
	}
	for i := 0; i < len(s.Exprs); i++ {
		var val @Value = evalExpr(interp, s.Exprs2[i])
		if val != nil && (val.Kind == VAL_STRUCT ||
				val.Kind == VAL_ARRAY) {
			envDefine(interp.Env,
				s.Exprs[i].Name, copyValue(val))
		} else {
			envDefine(interp.Env,
				s.Exprs[i].Name, val)
			if val != nil && val.Kind == VAL_MANAGED_PTR &&
					!val.IsFresh {
				cleanValue(val)
			}
		}
	}
}

// execIncDec executes an increment (++) or decrement (--) statement.
func execIncDec(interp @Interpreter, s @ast.Stmt) {
	var val @Value = evalExpr(interp, s.X)
	var newVal int
	if s.Op == cast(int, token.INC) {
		newVal = IntOf(val) + 1
	} else {
		newVal = IntOf(val) - 1
	}
	assignTo(interp, s.X, MakeIntVal(newVal, val.Typ))
}

// execIf evaluates the condition and executes the then-branch or else-branch.
func execIf(interp @Interpreter, s @ast.Stmt) {
	var cond @Value = evalExpr(interp, s.X)
	if isTruthy(cond) {
		pushEnv(interp)
		execBlock(interp, s.Body)
		popEnv(interp)
	} else if s.Else != nil {
		execStmt(interp, s.Else)
	}
}

// execFor executes a for loop (C-style or for-in), handling init/cond/post and break/continue/return.
func execFor(interp @Interpreter, s @ast.Stmt) {
	pushEnv(interp)

	if s.ForVal != nil {
		// For-in
		execForIn(interp, s)
		popEnv(interp)
		return
	}

	// Init
	if s.Init != nil {
		execStmt(interp, s.Init)
	}

	for {
		// Condition
		if s.X != nil {
			var cond @Value = evalExpr(interp, s.X)
			if !isTruthy(cond) {
				break
			}
		}

		// Body
		execBlock(interp, s.Body)
		if interp.Signal == SIG_BREAK {
			interp.Signal = SIG_NONE
			break
		}
		if interp.Signal == SIG_CONTINUE {
			interp.Signal = SIG_NONE
		}
		if interp.Signal == SIG_RETURN {
			break
		}

		// Post
		if s.Post != nil {
			execStmt(interp, s.Post)
		}
	}

	popEnv(interp)
}

// execForIn iterates over an array, slice, or managed-slice, binding key/value per iteration.
func execForIn(interp @Interpreter, s @ast.Stmt) {
	var collection @Value = evalExpr(interp, s.X)

	// Determine length and element access method
	var slen int = 0
	var dataAddr int = 0
	var elemTyp @types.Type
	var elemSize int = 0

	if collection.RawAddr != nil && collection.Typ != nil {
		if collection.Typ.Kind == types.TYP_ARRAY {
			elemTyp = collection.Typ.Elem
			slen = collection.Typ.ArrayLen
			dataAddr = bit_cast(int, collection.RawAddr)
		} else if collection.Typ.Kind == types.TYP_SLICE ||
				collection.Typ.Kind == types.TYP_MANAGED_SLICE {
			elemTyp = collection.Typ.Elem
			slen = readScalar(
				bit_cast(*uint8, bit_cast(int, collection.RawAddr) + types.SliceLenOffset()),
				types.TypInt())
			dataAddr = readScalar(
				bit_cast(*uint8, bit_cast(int, collection.RawAddr) + types.SliceDataOffset()),
				types.TypInt())
		}
		if elemTyp != nil {
			elemSize = types.SizeOf(elemTyp)
		}
	}

	for i := 0; i < slen; i++ {
		if s.ForKey != nil {
			envDefine(interp.Env, s.ForKey.Name, MakeIntVal(i, types.TypInt()))
		}
		if s.ForVal != nil {
			if dataAddr != 0 && elemTyp != nil {
				var addr *uint8 = bit_cast(*uint8, dataAddr + i * elemSize)
				envDefine(interp.Env, s.ForVal.Name, readFlatValue(addr, elemTyp))
			}
		}

		execBlock(interp, s.Body)
		if interp.Signal == SIG_BREAK {
			interp.Signal = SIG_NONE
			break
		}
		if interp.Signal == SIG_CONTINUE {
			interp.Signal = SIG_NONE
		}
		if interp.Signal == SIG_RETURN {
			break
		}
	}
}

// execSwitch evaluates a switch statement, matching cases against the tag or falling through to default.
func execSwitch(interp @Interpreter, s @ast.Stmt) {
	var tag @Value = nil
	if s.X != nil {
		tag = evalExpr(interp, s.X)
	}

	// Try non-default cases first
	for i := 0; i < len(s.Cases); i++ {
		var cc @ast.CaseClause = s.Cases[i]
		if len(cc.Exprs) == 0 {
			continue // default
		}
		for j := 0; j < len(cc.Exprs); j++ {
			var val @Value = evalExpr(interp, cc.Exprs[j])
			if tag != nil && valuesEqual(tag, val) {
				pushEnv(interp)
				for k := 0; k < len(cc.Body); k++ {
					execStmt(interp, cc.Body[k])
					if interp.Signal != SIG_NONE {
						popEnv(interp)
						return
					}
				}
				popEnv(interp)
				return
			}
		}
	}

	// Default case
	for i := 0; i < len(s.Cases); i++ {
		var cc @ast.CaseClause = s.Cases[i]
		if len(cc.Exprs) == 0 {
			pushEnv(interp)
			for k := 0; k < len(cc.Body); k++ {
				execStmt(interp, cc.Body[k])
				if interp.Signal != SIG_NONE {
					popEnv(interp)
					return
				}
			}
			popEnv(interp)
			return
		}
	}
}
