func TestBreakLoop() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tfor i := 0; i < 10; i++ {\n")
	b = buf.WriteStr(b, "\t\tif i == 3 { break }\n")
	b = buf.WriteStr(b, "\t\tprintln(i)\n")
	b = buf.WriteStr(b, "\t}\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "0\n1\n2\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestContinueLoop() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tfor i := 0; i < 5; i++ {\n")
	b = buf.WriteStr(b, "\t\tif i == 2 { continue }\n")
	b = buf.WriteStr(b, "\t\tprintln(i)\n")
	b = buf.WriteStr(b, "\t}\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
