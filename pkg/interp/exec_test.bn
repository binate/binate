// ============================================================
// Scope shadowing
// ============================================================
func TestScopeShadowing() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar x int = 1\n")
	b = buf.WriteStr(b, "\t{\n")
	b = buf.WriteStr(b, "\t\tvar x int = 2\n")
	b = buf.WriteStr(b, "\t\tprintln(x)\n")
	b = buf.WriteStr(b, "\t}\n")
	b = buf.WriteStr(b, "\tprintln(x)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "2\n1\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

// ============================================================
// Early return in loop
// ============================================================
func TestReturnInLoop() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func find(target int) int {\n")
	b = buf.WriteStr(b, "\tfor i := 0; i < 10; i++ {\n")
	b = buf.WriteStr(b, "\t\tif i == target { return i }\n")
	b = buf.WriteStr(b, "\t}\n")
	b = buf.WriteStr(b, "\treturn -1\n")
	b = buf.WriteStr(b, "}\n")
	b = buf.WriteStr(b, "func main() { println(find(5)) }\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "5\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

// ============================================================
// Struct copy semantics in interpreter
// ============================================================
func TestStructCopyOnAssign() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "type Point struct { x int; y int }\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar a Point\n")
	b = buf.WriteStr(b, "\ta.x = 1\n")
	b = buf.WriteStr(b, "\ta.y = 2\n")
	b = buf.WriteStr(b, "\tvar b Point = a\n")
	b = buf.WriteStr(b, "\tb.x = 99\n")
	b = buf.WriteStr(b, "\tprintln(a.x)\n")
	b = buf.WriteStr(b, "\tprintln(b.x)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "1\n99\n") {
		return fail(bootstrap.Concat("expected '1\\n99\\n', got '", bootstrap.Concat(out, "'")))
	}
	return ""
}

func TestArrayCopyOnAssign() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar a [3]int\n")
	b = buf.WriteStr(b, "\ta[0] = 10\n")
	b = buf.WriteStr(b, "\ta[1] = 20\n")
	b = buf.WriteStr(b, "\ta[2] = 30\n")
	b = buf.WriteStr(b, "\tvar b [3]int = a\n")
	b = buf.WriteStr(b, "\tb[0] = 99\n")
	b = buf.WriteStr(b, "\tprintln(a[0])\n")
	b = buf.WriteStr(b, "\tprintln(b[0])\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "10\n99\n") {
		return fail(bootstrap.Concat("expected '10\\n99\\n', got '", bootstrap.Concat(out, "'")))
	}
	return ""
}

func TestStructCopyOnFuncArg() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "type Point struct { x int; y int }\n")
	b = buf.WriteStr(b, "func modify(p Point) { p.x = 99 }\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar a Point\n")
	b = buf.WriteStr(b, "\ta.x = 1\n")
	b = buf.WriteStr(b, "\tmodify(a)\n")
	b = buf.WriteStr(b, "\tprintln(a.x)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "1\n") {
		return fail(bootstrap.Concat("expected '1\\n', got '", bootstrap.Concat(out, "'")))
	}
	return ""
}

// Regression: execReturn must structRefInc before cleanupEnvExcept
// runs, otherwise the returned struct's managed fields get freed
// when the function scope is cleaned up (Axiom 3).
func TestReturnStructWithManagedField() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "type Inner struct { Val int }\n")
	b = buf.WriteStr(b, "type Outer struct { Ref @Inner }\n")
	b = buf.WriteStr(b, "func makeOuter() Outer {\n")
	b = buf.WriteStr(b, "\tvar o Outer\n")
	b = buf.WriteStr(b, "\to.Ref = make(Inner)\n")
	b = buf.WriteStr(b, "\to.Ref.Val = 42\n")
	b = buf.WriteStr(b, "\treturn o\n")
	b = buf.WriteStr(b, "}\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar o Outer = makeOuter()\n")
	b = buf.WriteStr(b, "\tprintln(o.Ref.Val)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "42\n") {
		return fail(bootstrap.Concat("got '",
			bootstrap.Concat(out, "'")))
	}
	return ""
}

// Regression: returning a scalar field from a @T param. The
// field Value's RawAddr aliases the param's managed allocation,
// which cleanupEnvExcept frees before callFunc returns. Scalars
// must be materialized in execReturn so they survive.
func TestReturnScalarFieldFromManagedParam() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "type Point struct { X int; Y int }\n")
	b = buf.WriteStr(b, "func makePoint(x int, y int) @Point {\n")
	b = buf.WriteStr(b, "\tvar p @Point = make(Point)\n")
	b = buf.WriteStr(b, "\tp.X = x\n")
	b = buf.WriteStr(b, "\tp.Y = y\n")
	b = buf.WriteStr(b, "\treturn p\n")
	b = buf.WriteStr(b, "}\n")
	b = buf.WriteStr(b, "func getX(p @Point) int { return p.X }\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tprintln(getX(makePoint(50, 60)))\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "50\n") {
		return fail(bootstrap.Concat("got '",
			bootstrap.Concat(out, "'")))
	}
	return ""
}

