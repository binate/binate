// ============================================================
// For-In Loop
// ============================================================
func TestForInSlice() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar s @[]int = make_slice(int, 3)\n")
	b = buf.WriteStr(b, "\ts[0] = 10\n")
	b = buf.WriteStr(b, "\ts[1] = 20\n")
	b = buf.WriteStr(b, "\ts[2] = 30\n")
	b = buf.WriteStr(b, "\tvar sum int = 0\n")
	b = buf.WriteStr(b, "\tfor v in s { sum = sum + v }\n")
	b = buf.WriteStr(b, "\tprintln(sum)\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "60\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

func TestForInWithIndex() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar s @[]int = make_slice(int, 3)\n")
	b = buf.WriteStr(b, "\ts[0] = 10\n")
	b = buf.WriteStr(b, "\ts[1] = 20\n")
	b = buf.WriteStr(b, "\ts[2] = 30\n")
	b = buf.WriteStr(b, "\tfor i, v in s { println(i, v) }\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "0 10\n1 20\n2 30\n") {
		return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'")))
	}
	return ""
}

