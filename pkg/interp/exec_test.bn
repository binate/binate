}

func TestSwitchStmt() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func main() {\n")
	b = buf.WriteStr(b, "\tvar x int = 2\n")
	b = buf.WriteStr(b, "\tswitch x {\n")
	b = buf.WriteStr(b, "\tcase 1: println(\"one\")\n")
	b = buf.WriteStr(b, "\tcase 2: println(\"two\")\n")
	b = buf.WriteStr(b, "\tdefault: println(\"other\")\n")
	b = buf.WriteStr(b, "\t}\n")
	b = buf.WriteStr(b, "}\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "two\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

