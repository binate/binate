package "pkg/interp"

import "pkg/builtin/testing"
import "pkg/bootstrap"
import "pkg/buf"

// ============================================================
// Statement Execution Tests
// ============================================================

func TestIfTrue() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "package \"test\"\n")
	b = buf.WriteStr(b, "func main() { if true { println(1) } else { println(2) } }\n")
	var src @[]char = buf.Bytes(b)
	var out @[]char = runAndGetOutput(src)
	if !seq(out, "1\n") { return fail(bootstrap.Concat("got '", bootstrap.Concat(out, "'"))) }
	return ""
}

