package "pkg/interp"

import "pkg/types"
import "pkg/buf"
import "pkg/rt"

// ============================================================
// Environment
// ============================================================

// newEnv creates a new environment scope with the given parent. Pass nil for a root scope.
func newEnv(parent @Env) @Env {
	var e @Env = make(Env)
	e.Parent = parent
	return e
}

// envGet looks up a variable by name in the scope chain, returning nil if not found.
func envGet(e @Env, name []char) @Value {
	for i := len(e.Entries) - 1; i >= 0; i-- {
		if streq(e.Entries[i].Name, name) {
			if e.Entries[i].Addr != nil {
				return readFlatValue(e.Entries[i].Addr, e.Entries[i].Typ)
			}
			return e.Entries[i].Cell.Val
		}
	}
	if e.Parent != nil {
		return envGet(e.Parent, name)
	}
	return nil
}

// envSet updates an existing variable in the scope chain. Returns false if not found.
// Handles RefInc/RefDec for managed types when overwriting the old value.
func envSet(e @Env, name []char, val @Value) bool {
	for i := len(e.Entries) - 1; i >= 0; i-- {
		if streq(e.Entries[i].Name, name) {
			if e.Entries[i].Addr != nil {
				if e.Entries[i].Typ != nil {
					var et @types.Type = resolveUnderlying(e.Entries[i].Typ)
					if et.Kind == types.TYP_MANAGED_SLICE {
						cleanupFlatMSliceElems(e.Entries[i].Addr, et)
						msliceRefDecBacking(e.Entries[i].Addr)
					}
					if et.Kind == types.TYP_MANAGED_PTR {
						// RefInc new before RefDec old (cascade-safe)
						// Skip for fresh allocations/returns (IsFresh)
						if val != nil && val.Kind == VAL_MANAGED_PTR && val.RawAddr != nil && !val.IsFresh {
							rt.RefInc(val.RawAddr)
						}
						var old @Value = readFlatValue(e.Entries[i].Addr, e.Entries[i].Typ)
						if old != nil && old.RawAddr != nil {
							interpRefDec(old)
						}
					}
					// Struct/array with managed fields: RefInc new, RefDec old
					if (et.Kind == types.TYP_STRUCT || et.Kind == types.TYP_ARRAY) && types.NeedsDestruction(et) {
						if val != nil && val.RawAddr != nil && !val.IsFresh {
							structRefInc(val.RawAddr, et)
						}
						structRefDec(e.Entries[i].Addr, et)
					}
				}
				writeFlatValue(e.Entries[i].Addr, val, e.Entries[i].Typ)
				if e.Entries[i].Typ != nil && val != nil && val.RawAddr != nil && !val.IsFresh {
					var et @types.Type = resolveUnderlying(e.Entries[i].Typ)
					if et.Kind == types.TYP_MANAGED_SLICE {
						msliceRefIncBacking(e.Entries[i].Addr)
					}
				}
				return true
			}
			e.Entries[i].Cell.Val = val
			return true
		}
	}
	if e.Parent != nil {
		return envSet(e.Parent, name, val)
	}
	return false
}

// envDefine creates a new variable binding in the current scope.
// Uses flat memory for ABI-compatible types. RefInc's managed values unless IsFresh.
func envDefine(e @Env, name @[]char, val @Value) {
	var entry EnvEntry
	entry.Name = name

	// Use flat memory for types that need real addresses
	var valTyp @types.Type = valueType(val)
	if valTyp != nil && useFlatType(valTyp) {
		entry.Addr = allocFlat(valTyp)
		entry.Typ = valTyp
		writeFlatValue(entry.Addr, val, valTyp)
		// RefInc only for shared copies. Fresh allocations (make, make_slice,
		// box) and return values (ownership transfer) have IsFresh=true.
		if val != nil && val.RawAddr != nil && !val.IsFresh {
			var ft @types.Type = resolveUnderlying(valTyp)
			if ft.Kind == types.TYP_MANAGED_SLICE {
				msliceRefIncBacking(entry.Addr)
			}
			if ft.Kind == types.TYP_MANAGED_PTR {
				rt.RefInc(val.RawAddr)
			}
			if (ft.Kind == types.TYP_STRUCT || ft.Kind == types.TYP_ARRAY) && types.NeedsDestruction(ft) {
				structRefInc(entry.Addr, ft)
			}
		}
	} else {
		var cell @HeapObject = make(HeapObject)
		cell.Val = val
		entry.Cell = cell
	}
	e.Entries = appendEnvEntry(e.Entries, entry)
}

// envHasAddr checks if any entry in the scope chain has the given flat address.
func envHasAddr(e @Env, addr *uint8) bool {
	if e == nil { return false }
	for i := 0; i < len(e.Entries); i++ {
		if e.Entries[i].Addr == addr { return true }
	}
	return envHasAddr(e.Parent, addr)
}

// envGetTyp returns the declared type of a variable in the scope chain, or nil if not found.
func envGetTyp(e @Env, name []char) @types.Type {
	for i := len(e.Entries) - 1; i >= 0; i-- {
		if streq(e.Entries[i].Name, name) {
			return e.Entries[i].Typ
		}
	}
	if e.Parent != nil {
		return envGetTyp(e.Parent, name)
	}
	return nil
}

// envGetLocalAddr searches only the current scope (not parents).
func envGetLocalAddr(e @Env, name []char) *uint8 {
	for i := len(e.Entries) - 1; i >= 0; i-- {
		if streq(e.Entries[i].Name, name) {
			return e.Entries[i].Addr
		}
	}
	return nil
}

// envGetAddr returns the flat memory address of a variable in the scope chain, or nil.
func envGetAddr(e @Env, name []char) *uint8 {
	for i := len(e.Entries) - 1; i >= 0; i-- {
		if streq(e.Entries[i].Name, name) {
			return e.Entries[i].Addr
		}
	}
	if e.Parent != nil {
		return envGetAddr(e.Parent, name)
	}
	return nil
}

// envGetCell returns the legacy heap cell for a variable (used for function values only).
func envGetCell(e @Env, name []char) @HeapObject {
	for i := len(e.Entries) - 1; i >= 0; i-- {
		if streq(e.Entries[i].Name, name) {
			return e.Entries[i].Cell
		}
	}
	if e.Parent != nil {
		return envGetCell(e.Parent, name)
	}
	return nil
}

// isReturnedValue checks whether a flat entry's value is in the
// except list (being returned from the function).
// useFlatType returns true if a type should use flat memory storage.
func useFlatType(t @types.Type) bool {
	if t == nil { return false }
	t = resolveUnderlying(t)
	if t.Kind == types.TYP_INT { return true }
	if t.Kind == types.TYP_UNTYPED_INT { return true }
	if t.Kind == types.TYP_BOOL { return true }
	if t.Kind == types.TYP_UNTYPED_BOOL { return true }
	// All arrays use flat memory (contiguous elements, &arr[i] works)
	if t.Kind == types.TYP_ARRAY { return true }
	// Raw slices use flat memory: {data *uint8, len int} = 16 bytes
	if t.Kind == types.TYP_SLICE { return true }
	// Managed-slices use flat memory: {data, len, backing, backingLen} = 32 bytes
	if t.Kind == types.TYP_MANAGED_SLICE { return true }
	// Managed pointers use flat memory: 8-byte pointer value
	if t.Kind == types.TYP_MANAGED_PTR { return true }
	// Raw pointers use flat memory: 8-byte pointer value
	if t.Kind == types.TYP_POINTER { return true }
	// Structs use flat memory: fields at FieldOffset with padding
	if t.Kind == types.TYP_STRUCT { return true }
	// Strings use flat memory: 8-byte i8* pointer to null-terminated data
	if t.Kind == types.TYP_STRING { return true }
	return false
}

// valueType extracts the type from a Value.
func valueType(v *Value) @types.Type {
	if v == nil { return nil }
	if v.Kind == VAL_INT { return v.Typ }
	if v.Kind == VAL_BOOL { return types.TypBool() }
	if v.Kind == VAL_STRUCT { return v.Typ }
	if v.Kind == VAL_SLICE || v.Kind == VAL_MANAGED_SLICE || v.Kind == VAL_ARRAY { return v.Typ }
	if v.Kind == VAL_POINTER || v.Kind == VAL_MANAGED_PTR { return v.Typ }
	return nil
}

// ============================================================
// String and Comparison Helpers
// ============================================================

// streq returns true if two character slices have identical contents.
func streq(a []char, b []char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// strConcat concatenates two null-terminated strings, producing a new
// null-terminated string. Only the content (up to the null) from each
// string is included.
func strConcat(a []char, b []char) @[]char {
	var alen int = len(a)
	var blen int = len(b)
	var cb buf.CharBuf = buf.New()
	for i := 0; i < alen; i++ {
		cb = buf.WriteByte(cb, a[i])
	}
	for i := 0; i < blen; i++ {
		cb = buf.WriteByte(cb, b[i])
	}
	cb = buf.WriteByte(cb, cast(char, 0))
	return buf.Bytes(cb)
}

// intToStr converts an integer to its decimal string representation.
func intToStr(v int) @[]char {
	if v == 0 {
		return "0"
	}
	var cb buf.CharBuf = buf.New()
	if v < 0 {
		cb = buf.WriteByte(cb, '-')
		v = 0 - v
	}
	// Write digits in reverse into a small array, then copy forward
	var digits [20]char
	var count int = 0
	for v > 0 {
		var d int = v % 10
		digits[count] = cast(char, d + cast(int, '0'))
		count = count + 1
		v = v / 10
	}
	for i := count - 1; i >= 0; i-- {
		cb = buf.WriteByte(cb, digits[i])
	}
	return buf.Bytes(cb)
}

// isTruthy returns whether a value is considered true in a boolean context.
func isTruthy(v *Value) bool {
	if v == nil {
		return false
	}
	if v.Kind == VAL_BOOL {
		return v.RawAddr != nil && v.RawAddr[0] != 0
	}
	if v.Kind == VAL_INT {
		return IntOf(v) != 0
	}
	if v.Kind == VAL_NIL {
		return false
	}
	if v.Kind == VAL_POINTER || v.Kind == VAL_MANAGED_PTR {
		return v.RawAddr != nil
	}
	return true
}

// valuesEqual compares two values for equality (ints, strings, or bools).
func valuesEqual(a *Value, b *Value) bool {
	if a.Kind == VAL_INT && b.Kind == VAL_INT {
		return IntOf(a) == IntOf(b)
	}
	if IsString(a) && IsString(b) {
		return streq(StrOf(a), StrOf(b))
	}
	if a.Kind == VAL_BOOL && b.Kind == VAL_BOOL {
		return a.RawAddr[0] == b.RawAddr[0]
	}
	return false
}

// ============================================================
// Lookups
// ============================================================

// lookupType finds a type by name in a type entry list.
func lookupType(entries []@TypeEntry, name []char) @types.Type {
	for i := 0; i < len(entries); i++ {
		if streq(entries[i].Name, name) {
			return entries[i].Type
		}
	}
	return nil
}

// lookupAlias finds a package path by alias name.
func lookupAlias(entries []@AliasEntry, name []char) @[]char {
	for i := 0; i < len(entries); i++ {
		if streq(entries[i].Name, name) {
			return entries[i].Path
		}
	}
	return ""
}

// lookupPkg finds a package env by path.
func lookupPkgEnv(pkgs []@PkgEnv, path []char) @PkgEnv {
	for i := 0; i < len(pkgs); i++ {
		if streq(pkgs[i].Path, path) {
			return pkgs[i]
		}
	}
	return nil
}

// defineTypeEntry adds or updates a named type in the type entry list.
func defineTypeEntry(entries @[]@TypeEntry, name @[]char, t @types.Type) @[]@TypeEntry {
	for i := 0; i < len(entries); i++ {
		if streq(entries[i].Name, name) {
			entries[i].Type = t
			return entries
		}
	}
	var e @TypeEntry = make(TypeEntry)
	e.Name = name
	e.Type = t
	return appendTypeEntryPtr(entries, e)
}

// ============================================================
// Append helpers for managed slices
// ============================================================

// appendEnvEntry appends an environment entry, returning a new managed-slice.
func appendEnvEntry(s @[]EnvEntry, v EnvEntry) @[]EnvEntry {
	var n int = len(s)
	var ns @[]EnvEntry = make_slice(EnvEntry, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendTypeEntryPtr appends a type entry, returning a new managed-slice.
func appendTypeEntryPtr(s @[]@TypeEntry, v @TypeEntry) @[]@TypeEntry {
	var n int = len(s)
	var ns @[]@TypeEntry = make_slice(@TypeEntry, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendValuePtr appends a value pointer, returning a new managed-slice.
func appendValuePtr(s @[]@Value, v @Value) @[]@Value {
	var n int = len(s)
	var ns @[]@Value = make_slice(@Value, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendPkgEnvPtr appends a package environment, returning a new managed-slice.
func appendPkgEnvPtr(s @[]@PkgEnv, v @PkgEnv) @[]@PkgEnv {
	var n int = len(s)
	var ns @[]@PkgEnv = make_slice(@PkgEnv, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendAliasEntryPtr appends an alias entry, returning a new managed-slice.
func appendAliasEntryPtr(s @[]@AliasEntry, v @AliasEntry) @[]@AliasEntry {
	var n int = len(s)
	var ns @[]@AliasEntry = make_slice(@AliasEntry, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}
