package "pkg/interp"

import "pkg/types"
import "pkg/rt"

// ============================================================
// Refcount Helpers
//
// These functions manage reference counts for managed fields
// inside flat memory (structs, arrays, managed-slices). They
// are the interpreter's equivalent of the compiler-generated
// __copy_X and __dtor_X functions.
// ============================================================

// msliceRefIncBacking reads the backing_refptr from a flat
// managed-slice header and RefIncs it.
func msliceRefIncBacking(addr *uint8) {
	var bp int = readScalar(
		bit_cast(*uint8, bit_cast(int, addr) + types.MSliceBackingOffset()),
		types.TypInt())
	if bp != 0 {
		rt.RefInc(bit_cast(*uint8, bp))
	}
}

// msliceRefDecBacking reads the backing_refptr from a flat
// managed-slice header and RefDecs it.
func msliceRefDecBacking(addr *uint8) {
	var bp int = readScalar(
		bit_cast(*uint8, bit_cast(int, addr) + types.MSliceBackingOffset()),
		types.TypInt())
	if bp != 0 {
		rt.RefDec(bit_cast(*uint8, bp), nil)
	}
}

// structElemRefcount RefIncs managed fields in a new struct value
// and RefDec's managed fields in the old struct value at the same
// address. Used when storing struct elements in slices/arrays.
func structElemRefcount(addr *uint8, newVal @Value,
		elemTyp @types.Type) {
	if elemTyp == nil { return }
	elemTyp = resolveUnderlying(elemTyp)
	if elemTyp.Kind != types.TYP_STRUCT { return }
	if !types.NeedsDestruction(elemTyp) { return }
	for i := 0; i < len(elemTyp.Fields); i++ {
		var ft @types.Type = resolveUnderlying(elemTyp.Fields[i].Type)
		var offset int = types.FieldOffset(elemTyp, i)
		if ft.Kind == types.TYP_MANAGED_PTR {
			// RefInc new field
			if newVal != nil && newVal.RawAddr != nil {
				var newPtr int = readScalar(
					bit_cast(*uint8, bit_cast(int, newVal.RawAddr) + offset),
					types.TypInt())
				if newPtr != 0 {
					rt.RefInc(bit_cast(*uint8, newPtr))
				}
			}
			// RefDec old field
			var oldPtr int = readScalar(
				bit_cast(*uint8, bit_cast(int, addr) + offset),
				types.TypInt())
			if oldPtr != 0 {
				rt.RefDec(bit_cast(*uint8, oldPtr), nil)
			}
		}
		if ft.Kind == types.TYP_MANAGED_SLICE {
			// RefInc new backing
			if newVal != nil && newVal.RawAddr != nil {
				msliceRefIncBacking(
					bit_cast(*uint8,
						bit_cast(int, newVal.RawAddr) + offset))
			}
			// RefDec old backing
			msliceRefDecBacking(
				bit_cast(*uint8, bit_cast(int, addr) + offset))
		}
	}
}

// structRefInc walks a struct's fields at the given flat address
// and RefInc's all managed fields. Recursively handles nested
// structs and arrays. This is the interpreter equivalent of the
// compiler's __copy_X functions.
func structRefInc(addr *uint8, typ @types.Type) {
	if addr == nil { return }
	typ = resolveUnderlying(typ)
	if typ.Kind == types.TYP_STRUCT {
		for i := 0; i < len(typ.Fields); i++ {
			var ft @types.Type = resolveUnderlying(typ.Fields[i].Type)
			if !types.NeedsDestruction(ft) { continue }
			var fieldAddr *uint8 = bit_cast(*uint8,
				bit_cast(int, addr) + types.FieldOffset(typ, i))
			if ft.Kind == types.TYP_MANAGED_PTR {
				var ptr int = readScalar(fieldAddr, types.TypInt())
				if ptr != 0 {
					rt.RefInc(bit_cast(*uint8, ptr))
				}
			} else if ft.Kind == types.TYP_MANAGED_SLICE {
				msliceRefIncBacking(fieldAddr)
			} else {
				structRefInc(fieldAddr, ft)
			}
		}
	} else if typ.Kind == types.TYP_ARRAY {
		var elemTyp @types.Type = typ.Elem
		if elemTyp == nil || !types.NeedsDestruction(elemTyp) {
			return
		}
		var elemSize int = types.SizeOf(elemTyp)
		for i := 0; i < typ.ArrayLen; i++ {
			var elemAddr *uint8 = bit_cast(*uint8,
				bit_cast(int, addr) + i * elemSize)
			if elemTyp.Kind == types.TYP_MANAGED_PTR {
				var ptr int = readScalar(elemAddr, types.TypInt())
				if ptr != 0 {
					rt.RefInc(bit_cast(*uint8, ptr))
				}
			} else if elemTyp.Kind == types.TYP_MANAGED_SLICE {
				msliceRefIncBacking(elemAddr)
			} else {
				structRefInc(elemAddr, elemTyp)
			}
		}
	}
}

// structRefDec walks a struct's fields at the given flat address
// and RefDec's all managed fields. Recursively handles nested
// structs and arrays. This is the interpreter equivalent of the
// compiler's __dtor_X functions.
func structRefDec(addr *uint8, typ @types.Type) {
	if addr == nil { return }
	typ = resolveUnderlying(typ)
	if typ.Kind == types.TYP_STRUCT {
		for i := 0; i < len(typ.Fields); i++ {
			var ft @types.Type = resolveUnderlying(typ.Fields[i].Type)
			if !types.NeedsDestruction(ft) { continue }
			var fieldAddr *uint8 = bit_cast(*uint8,
				bit_cast(int, addr) + types.FieldOffset(typ, i))
			if ft.Kind == types.TYP_MANAGED_PTR {
				var ptr int = readScalar(fieldAddr, types.TypInt())
				if ptr != 0 {
					rt.RefDec(bit_cast(*uint8, ptr), nil)
				}
			} else if ft.Kind == types.TYP_MANAGED_SLICE {
				msliceRefDecBacking(fieldAddr)
			} else {
				structRefDec(fieldAddr, ft)
			}
		}
	} else if typ.Kind == types.TYP_ARRAY {
		var elemTyp @types.Type = typ.Elem
		if elemTyp == nil || !types.NeedsDestruction(elemTyp) {
			return
		}
		var elemSize int = types.SizeOf(elemTyp)
		for i := 0; i < typ.ArrayLen; i++ {
			var elemAddr *uint8 = bit_cast(*uint8,
				bit_cast(int, addr) + i * elemSize)
			if elemTyp.Kind == types.TYP_MANAGED_PTR {
				var ptr int = readScalar(elemAddr, types.TypInt())
				if ptr != 0 {
					rt.RefDec(bit_cast(*uint8, ptr), nil)
				}
			} else if elemTyp.Kind == types.TYP_MANAGED_SLICE {
				msliceRefDecBacking(elemAddr)
			} else {
				structRefDec(elemAddr, elemTyp)
			}
		}
	}
}

// cleanupFlatMSliceElems RefDec's managed elements in a
// managed-slice's backing, but ONLY if the backing refcount is 1
// (last reference — about to be freed). For shared backings
// (rc > 1), elements are not cleaned up.
func cleanupFlatMSliceElems(addr *uint8, t @types.Type) {
	var elemTyp @types.Type = t.Elem
	if elemTyp == nil { return }
	elemTyp = resolveUnderlying(elemTyp)
	if !types.NeedsDestruction(elemTyp) { return }
	// Only clean up elements if this is the last reference
	var bp int = readScalar(
		bit_cast(*uint8,
			bit_cast(int, addr) + types.MSliceBackingOffset()),
		types.TypInt())
	if bp == 0 { return }
	if rt.Refcount(bit_cast(*uint8, bp)) != 1 { return }
	var dp int = readScalar(
		bit_cast(*uint8,
			bit_cast(int, addr) + types.MSliceDataOffset()),
		types.TypInt())
	if dp == 0 { return }
	var slen int = readScalar(
		bit_cast(*uint8,
			bit_cast(int, addr) + types.MSliceLenOffset()),
		types.TypInt())
	var elemSize int = types.SizeOf(elemTyp)
	for i := 0; i < slen; i++ {
		var ea *uint8 = bit_cast(*uint8, dp + i * elemSize)
		if elemTyp.Kind == types.TYP_MANAGED_PTR {
			var ep int = readScalar(ea, types.TypInt())
			if ep != 0 {
				rt.RefDec(bit_cast(*uint8, ep), nil)
			}
		}
		if elemTyp.Kind == types.TYP_MANAGED_SLICE {
			msliceRefDecBacking(ea)
		}
		if elemTyp.Kind == types.TYP_STRUCT {
			for j := 0; j < len(elemTyp.Fields); j++ {
				var ft @types.Type = resolveUnderlying(
					elemTyp.Fields[j].Type)
				var offset int = types.FieldOffset(elemTyp, j)
				var fieldAddr *uint8 = bit_cast(*uint8,
					bit_cast(int, ea) + offset)
				if ft.Kind == types.TYP_MANAGED_PTR {
					var fp int = readScalar(
						fieldAddr, types.TypInt())
					if fp != 0 {
						rt.RefDec(bit_cast(*uint8, fp), nil)
					}
				}
				if ft.Kind == types.TYP_MANAGED_SLICE {
					msliceRefDecBacking(fieldAddr)
				}
			}
		}
	}
}

// ============================================================
// Temp Tracking
//
// Mirrors the compiler's registerTemp/consumeTemp/emitTempCleanup.
// readFlatValue for @T RefIncs the managed pointer. The resulting
// @Value is registered as a temp. If the Value is consumed
// (stored via envDefine/envSet, or returned), it's deregistered.
// At statement end, all remaining temps are cleaned.
// ============================================================

// registerTemp adds a @T Value to the interpreter's temp list.
func registerTemp(interp @Interpreter, v @Value) {
	if v == nil { return }
	interp.Temps = appendValuePtr(interp.Temps, v)
}

// consumeTemp removes a Value from the temp list (ownership
// transferred to an env entry or return value).
func consumeTemp(interp @Interpreter, v @Value) {
	if v == nil || len(interp.Temps) == 0 { return }
	for i := 0; i < len(interp.Temps); i++ {
		if interp.Temps[i] == v {
			// Shift remaining elements
			for j := i; j < len(interp.Temps) - 1; j++ {
				interp.Temps[j] = interp.Temps[j + 1]
			}
			interp.Temps = interp.Temps[0:len(interp.Temps) - 1]
			return
		}
	}
}

// cleanTemps cleans all remaining temps at the end of a statement.
// Each temp's managed pointer is RefDec'd via cleanValue.
func cleanTemps(interp @Interpreter) {
	for i := 0; i < len(interp.Temps); i++ {
		var v @Value = interp.Temps[i]
		if v != nil && v.Kind == VAL_MANAGED_PTR &&
				v.RawAddr != nil && !v.IsClean {
			var rc int = rt.Refcount(v.RawAddr)
			if rc < 2 {
				print("BUG: cleanTemps rc=")
				println(rc)
				panic("cleanTemps: temp rc < 2")
			}
			cleanValue(v)
		}
	}
	if len(interp.Temps) > 0 {
		interp.Temps = interp.Temps[0:0]
	}
}

// ============================================================
// Scope Cleanup
// ============================================================

// isReturnedValue checks whether a flat entry's value is in the
// except list (being returned from the function).
func isReturnedValue(entry EnvEntry, cleanupTyp @types.Type,
		except @[]@Value) bool {
	if cleanupTyp.Kind == types.TYP_MANAGED_PTR {
		var ptrVal int = readScalar(entry.Addr, types.TypInt())
		for j := 0; j < len(except); j++ {
			if except[j] != nil &&
				except[j].Kind == VAL_MANAGED_PTR &&
				bit_cast(int, except[j].RawAddr) == ptrVal {
				return true
			}
		}
		return false
	}
	for j := 0; j < len(except); j++ {
		if except[j] != nil &&
			except[j].RawAddr == entry.Addr {
			return true
		}
	}
	return false
}

// cleanupEntry cleans up a single env entry's managed contents.
// Constructs a temporary Value and calls cleanValue, then zeroes
// the flat memory.
func cleanupEntry(entry EnvEntry, cleanupTyp @types.Type) {
	if cleanupTyp.Kind == types.TYP_MANAGED_PTR {
		var ptrVal int = readScalar(entry.Addr, types.TypInt())
		if ptrVal != 0 {
			var v @Value = make(Value)
			v.Kind = VAL_MANAGED_PTR
			v.RawAddr = bit_cast(*uint8, ptrVal)
			v.Typ = entry.Typ
			cleanValue(v)
		}
		rt.c_memset(entry.Addr, 0, types.SizeOf(cleanupTyp))
		return
	}
	if cleanupTyp.Kind == types.TYP_MANAGED_SLICE {
		var v @Value = make(Value)
		v.Kind = VAL_MANAGED_SLICE
		v.RawAddr = entry.Addr
		v.Typ = entry.Typ
		cleanValue(v)
		rt.c_memset(entry.Addr, 0, types.SizeOf(cleanupTyp))
		return
	}
	var isStructOrArray bool =
		cleanupTyp.Kind == types.TYP_STRUCT ||
			cleanupTyp.Kind == types.TYP_ARRAY
	if isStructOrArray && types.NeedsDestruction(cleanupTyp) {
		var v @Value = make(Value)
		if cleanupTyp.Kind == types.TYP_STRUCT {
			v.Kind = VAL_STRUCT
		} else {
			v.Kind = VAL_ARRAY
		}
		v.RawAddr = entry.Addr
		v.Typ = entry.Typ
		cleanValue(v)
	}
}

// cleanupEnvExcept cleans up all managed locals in the given
// environment scope, except those being returned (in the except
// list). Uses cleanValue for consistent destruction.
func cleanupEnvExcept(e @Env, except @[]@Value) {
	if e == nil { return }
	for i := 0; i < len(e.Entries); i++ {
		if e.Entries[i].Addr != nil && e.Entries[i].Typ != nil {
			var cleanupTyp @types.Type = e.Entries[i].Typ
			if cleanupTyp != nil {
				cleanupTyp = resolveUnderlying(cleanupTyp)
			}
			if cleanupTyp == nil { continue }
			if isReturnedValue(
				e.Entries[i], cleanupTyp, except) {
				continue
			}
			cleanupEntry(e.Entries[i], cleanupTyp)
		}
	}
}

// cleanValue explicitly cleans the managed data inside a Value.
// After this call, the Value's RawAddr is nil and IsClean is
// true. Must be called before releasing the @Value reference.
func cleanValue(v @Value) {
	if v == nil || v.IsClean { return }
	var t @types.Type = v.Typ
	if t != nil && v.RawAddr != nil {
		t = resolveUnderlying(t)
		if t.Kind == types.TYP_MANAGED_PTR {
			interpRefDec(v)
			v.RawAddr = nil
		}
		if t.Kind == types.TYP_MANAGED_SLICE {
			cleanupFlatMSliceElems(v.RawAddr, t)
			msliceRefDecBacking(v.RawAddr)
			v.RawAddr = nil
		}
		if (t.Kind == types.TYP_STRUCT ||
				t.Kind == types.TYP_ARRAY) &&
				types.NeedsDestruction(t) {
			structRefDec(v.RawAddr, t)
			v.RawAddr = nil
		}
	}
	v.IsClean = true
}

// interpRefDec decrements the refcount of a managed pointer.
// If this is the last reference and the pointed-to struct has
// managed fields, RefDec's them before freeing (manual dtor).
func interpRefDec(v @Value) {
	if v == nil || v.RawAddr == nil { return }
	var rc int = rt.Refcount(v.RawAddr)
	if rc == 1 && v.Typ != nil {
		var elemTyp @types.Type = v.Typ.Elem
		if elemTyp != nil &&
				elemTyp.Kind == types.TYP_STRUCT &&
				len(elemTyp.Fields) > 0 {
			for i := 0; i < len(elemTyp.Fields); i++ {
				var ft @types.Type = types.ResolveAlias(
					elemTyp.Fields[i].Type)
				if ft.Kind == types.TYP_MANAGED_PTR {
					var offset int = types.FieldOffset(
						elemTyp, i)
					var fieldAddr *uint8 = bit_cast(*uint8,
						bit_cast(int, v.RawAddr) + offset)
					var field @Value = readFlatValue(
						fieldAddr, elemTyp.Fields[i].Type)
					if field != nil && field.RawAddr != nil {
						interpRefDec(field)
					}
				}
			}
		}
	}
	rt.RefDec(v.RawAddr, nil)
}
