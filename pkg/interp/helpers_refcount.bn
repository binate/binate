package "pkg/interp"

import "pkg/types"
import "pkg/rt"

// ============================================================
// Refcount Helpers
//
// These functions manage reference counts for managed fields
// inside flat memory (structs, arrays, managed-slices). They
// are the interpreter's equivalent of the compiler-generated
// __copy_X and __dtor_X functions.
// ============================================================

// msliceRefIncBacking reads the backing_refptr from a flat
// managed-slice header and RefIncs it.
func msliceRefIncBacking(addr *uint8) {
	var bp int = readScalar(
		bit_cast(*uint8, bit_cast(int, addr) + types.MSliceBackingOffset()),
		types.TypInt())
	if bp != 0 {
		rt.RefInc(bit_cast(*uint8, bp))
	}
}

// msliceRefDecBacking reads the backing_refptr from a flat
// managed-slice header and RefDecs it.
func msliceRefDecBacking(addr *uint8) {
	var bp int = readScalar(
		bit_cast(*uint8, bit_cast(int, addr) + types.MSliceBackingOffset()),
		types.TypInt())
	if bp != 0 {
		rt.RefDec(bit_cast(*uint8, bp), nil)
	}
}

// structElemRefcount RefIncs managed fields in a new struct value
// and RefDec's managed fields in the old struct value at the same
// address. Used when storing struct elements in slices/arrays.
func structElemRefcount(addr *uint8, newVal @Value,
		elemTyp @types.Type) {
	if elemTyp == nil { return }
	elemTyp = resolveUnderlying(elemTyp)
	if elemTyp.Kind != types.TYP_STRUCT { return }
	if !types.NeedsDestruction(elemTyp) { return }
	for i := 0; i < len(elemTyp.Fields); i++ {
		var ft @types.Type = resolveUnderlying(elemTyp.Fields[i].Type)
		var offset int = types.FieldOffset(elemTyp, i)
		if ft.Kind == types.TYP_MANAGED_PTR {
			// RefInc new field
			if newVal != nil && newVal.RawAddr != nil {
				var newPtr int = readScalar(
					bit_cast(*uint8, bit_cast(int, newVal.RawAddr) + offset),
					types.TypInt())
				if newPtr != 0 {
					rt.RefInc(bit_cast(*uint8, newPtr))
				}
			}
			// RefDec old field
			var oldPtr int = readScalar(
				bit_cast(*uint8, bit_cast(int, addr) + offset),
				types.TypInt())
			if oldPtr != 0 {
				rt.RefDec(bit_cast(*uint8, oldPtr), nil)
			}
		}
		if ft.Kind == types.TYP_MANAGED_SLICE {
			// RefInc new backing
			if newVal != nil && newVal.RawAddr != nil {
				msliceRefIncBacking(
					bit_cast(*uint8,
						bit_cast(int, newVal.RawAddr) + offset))
			}
			// RefDec old backing
			msliceRefDecBacking(
				bit_cast(*uint8, bit_cast(int, addr) + offset))
		}
	}
}

// structRefInc walks a struct's fields at the given flat address
// and RefInc's all managed fields. Recursively handles nested
// structs and arrays. This is the interpreter equivalent of the
// compiler's __copy_X functions.
func structRefInc(addr *uint8, typ @types.Type) {
	if addr == nil { return }
	typ = resolveUnderlying(typ)
	if typ.Kind == types.TYP_STRUCT {
		for i := 0; i < len(typ.Fields); i++ {
			var ft @types.Type = resolveUnderlying(typ.Fields[i].Type)
			if !types.NeedsDestruction(ft) { continue }
			var fieldAddr *uint8 = bit_cast(*uint8,
				bit_cast(int, addr) + types.FieldOffset(typ, i))
			if ft.Kind == types.TYP_MANAGED_PTR {
				var ptr int = readScalar(fieldAddr, types.TypInt())
				if ptr != 0 {
					rt.RefInc(bit_cast(*uint8, ptr))
				}
			} else if ft.Kind == types.TYP_MANAGED_SLICE {
				msliceRefIncBacking(fieldAddr)
			} else {
				structRefInc(fieldAddr, ft)
			}
		}
	} else if typ.Kind == types.TYP_ARRAY {
		var elemTyp @types.Type = typ.Elem
		if elemTyp == nil || !types.NeedsDestruction(elemTyp) {
			return
		}
		var elemSize int = types.SizeOf(elemTyp)
		for i := 0; i < typ.ArrayLen; i++ {
			var elemAddr *uint8 = bit_cast(*uint8,
				bit_cast(int, addr) + i * elemSize)
			if elemTyp.Kind == types.TYP_MANAGED_PTR {
				var ptr int = readScalar(elemAddr, types.TypInt())
				if ptr != 0 {
					rt.RefInc(bit_cast(*uint8, ptr))
				}
			} else if elemTyp.Kind == types.TYP_MANAGED_SLICE {
				msliceRefIncBacking(elemAddr)
			} else {
				structRefInc(elemAddr, elemTyp)
			}
		}
	}
}

// structRefDec walks a struct's fields at the given flat address
// and RefDec's all managed fields. Recursively handles nested
// structs and arrays. This is the interpreter equivalent of the
// compiler's __dtor_X functions.
func structRefDec(addr *uint8, typ @types.Type) {
	if addr == nil { return }
	typ = resolveUnderlying(typ)
	if typ.Kind == types.TYP_STRUCT {
		for i := 0; i < len(typ.Fields); i++ {
			var ft @types.Type = resolveUnderlying(typ.Fields[i].Type)
			if !types.NeedsDestruction(ft) { continue }
			var fieldAddr *uint8 = bit_cast(*uint8,
				bit_cast(int, addr) + types.FieldOffset(typ, i))
			if ft.Kind == types.TYP_MANAGED_PTR {
				var ptr int = readScalar(fieldAddr, types.TypInt())
				if ptr != 0 {
					rt.RefDec(bit_cast(*uint8, ptr), nil)
				}
			} else if ft.Kind == types.TYP_MANAGED_SLICE {
				msliceRefDecBacking(fieldAddr)
			} else {
				structRefDec(fieldAddr, ft)
			}
		}
	} else if typ.Kind == types.TYP_ARRAY {
		var elemTyp @types.Type = typ.Elem
		if elemTyp == nil || !types.NeedsDestruction(elemTyp) {
			return
		}
		var elemSize int = types.SizeOf(elemTyp)
		for i := 0; i < typ.ArrayLen; i++ {
			var elemAddr *uint8 = bit_cast(*uint8,
				bit_cast(int, addr) + i * elemSize)
			if elemTyp.Kind == types.TYP_MANAGED_PTR {
				var ptr int = readScalar(elemAddr, types.TypInt())
				if ptr != 0 {
					rt.RefDec(bit_cast(*uint8, ptr), nil)
				}
			} else if elemTyp.Kind == types.TYP_MANAGED_SLICE {
				msliceRefDecBacking(elemAddr)
			} else {
				structRefDec(elemAddr, elemTyp)
			}
		}
	}
}

// cleanupFlatMSliceElems RefDec's managed elements in a
// managed-slice's backing, but ONLY if the backing refcount is 1
// (last reference — about to be freed). For shared backings
// (rc > 1), elements are not cleaned up.
func cleanupFlatMSliceElems(addr *uint8, t @types.Type) {
	var elemTyp @types.Type = t.Elem
	if elemTyp == nil { return }
	elemTyp = resolveUnderlying(elemTyp)
	if !types.NeedsDestruction(elemTyp) { return }
	// Only clean up elements if this is the last reference
	var bp int = readScalar(
		bit_cast(*uint8,
			bit_cast(int, addr) + types.MSliceBackingOffset()),
		types.TypInt())
	if bp == 0 { return }
	if rt.Refcount(bit_cast(*uint8, bp)) != 1 { return }
	var dp int = readScalar(
		bit_cast(*uint8,
			bit_cast(int, addr) + types.MSliceDataOffset()),
		types.TypInt())
	if dp == 0 { return }
	var slen int = readScalar(
		bit_cast(*uint8,
			bit_cast(int, addr) + types.MSliceLenOffset()),
		types.TypInt())
	var elemSize int = types.SizeOf(elemTyp)
	for i := 0; i < slen; i++ {
		var ea *uint8 = bit_cast(*uint8, dp + i * elemSize)
		if elemTyp.Kind == types.TYP_MANAGED_PTR {
			var ep int = readScalar(ea, types.TypInt())
			if ep != 0 {
				rt.RefDec(bit_cast(*uint8, ep), nil)
			}
		}
		if elemTyp.Kind == types.TYP_MANAGED_SLICE {
			msliceRefDecBacking(ea)
		}
		if elemTyp.Kind == types.TYP_STRUCT {
			for j := 0; j < len(elemTyp.Fields); j++ {
				var ft @types.Type = resolveUnderlying(
					elemTyp.Fields[j].Type)
				var offset int = types.FieldOffset(elemTyp, j)
				var fieldAddr *uint8 = bit_cast(*uint8,
					bit_cast(int, ea) + offset)
				if ft.Kind == types.TYP_MANAGED_PTR {
					var fp int = readScalar(
						fieldAddr, types.TypInt())
					if fp != 0 {
						rt.RefDec(bit_cast(*uint8, fp), nil)
					}
				}
				if ft.Kind == types.TYP_MANAGED_SLICE {
					msliceRefDecBacking(fieldAddr)
				}
			}
		}
	}
}
