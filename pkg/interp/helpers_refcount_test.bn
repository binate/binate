package "pkg/interp"

import "pkg/types"
import "pkg/rt"
import "pkg/builtin/testing"

// ============================================================
// Refcount Helper Tests
// ============================================================

func TestMsliceRefIncDecBacking() testing.TestResult {
	// Create a managed-slice, RefInc its backing, verify rc
	var ms @[]int = make_slice(int, 4)
	var addr *uint8 = allocFlat(types.MakeManagedSliceType(types.TypInt()))
	writeFlatValue(addr, readFlatValue(allocFlat(types.MakeManagedSliceType(types.TypInt())), types.MakeManagedSliceType(types.TypInt())), types.MakeManagedSliceType(types.TypInt()))

	// Simpler: just test that RefInc/RefDec on a known allocation works
	var backing *uint8 = rt.Alloc(32)
	var rc int = rt.Refcount(backing)
	if rc != 1 { return fail("initial rc should be 1") }
	rt.RefInc(backing)
	if rt.Refcount(backing) != 2 { return fail("rc should be 2") }
	rt.RefDec(backing, nil)
	if rt.Refcount(backing) != 1 { return fail("rc should be 1") }
	rt.Free(backing)
	return ""
}

func TestStructRefIncDecSimple() testing.TestResult {
	// Struct with one @T field
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var f0 @types.Field = make(types.Field)
	f0.Name = "Ref"
	f0.Type = types.MakeManagedPtrType(types.TypInt())
	fields[0] = f0
	var st @types.Type = types.MakeStructType("S", fields)

	// Allocate struct flat memory and set the managed ptr field
	var addr *uint8 = allocFlat(st)
	var inner *uint8 = rt.Alloc(8)
	writeScalar(addr, types.TypInt(), bit_cast(int, inner))

	var rc int = rt.Refcount(inner)
	if rc != 1 { return fail("initial inner rc should be 1") }

	structRefInc(addr, st)
	if rt.Refcount(inner) != 2 {
		return fail("after structRefInc, rc should be 2")
	}

	structRefDec(addr, st)
	if rt.Refcount(inner) != 1 {
		return fail("after structRefDec, rc should be 1")
	}

	rt.Free(inner)
	return ""
}
