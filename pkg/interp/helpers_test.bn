package "pkg/interp"

import "pkg/types"
import "pkg/builtin/testing"

// ============================================================
// Environment Tests
// ============================================================

func TestEnvDefineGet() testing.TestResult {
	var e @Env = newEnv(nil)
	envDefine(e, "x", MakeIntVal(42, types.TypInt()))
	var v @Value = envGet(e, "x")
	if v == nil { return fail("should find x") }
	if IntOf(v) != 42 { return fail("x should be 42") }
	return ""
}

func TestEnvSetExisting() testing.TestResult {
	var e @Env = newEnv(nil)
	envDefine(e, "x", MakeIntVal(1, types.TypInt()))
	envSet(e, "x", MakeIntVal(2, types.TypInt()))
	var v @Value = envGet(e, "x")
	if IntOf(v) != 2 { return fail("x should be 2") }
	return ""
}

func TestLookupAliasFound() testing.TestResult {
	var entries @[]@AliasEntry = make_slice(@AliasEntry, 2)
	var e0 @AliasEntry = make(AliasEntry)
	e0.Name = "fmt"
	e0.Path = "pkg/fmt"
	entries[0] = e0
	var e1 @AliasEntry = make(AliasEntry)
	e1.Name = "ast"
	e1.Path = "pkg/ast"
	entries[1] = e1
	var path @[]char = lookupAlias(entries, "ast")
	if len(path) == 0 { return fail("should find ast") }
	if !streq(path, "pkg/ast") { return fail("path wrong") }
	return ""
}

func TestLookupAliasNotFound() testing.TestResult {
	var entries @[]@AliasEntry = make_slice(@AliasEntry, 1)
	var e0 @AliasEntry = make(AliasEntry)
	e0.Name = "fmt"
	e0.Path = "pkg/fmt"
	entries[0] = e0
	var path @[]char = lookupAlias(entries, "xyz")
	if len(path) != 0 {
		return fail("should not find xyz")
	}
	return ""
}

func TestEnvParentLookup() testing.TestResult {
	var parent @Env = newEnv(nil)
	envDefine(parent, "x", MakeIntVal(10, types.TypInt()))
	var child @Env = newEnv(parent)
	var v @Value = envGet(child, "x")
	if v == nil { return fail("should find x from parent") }
	if IntOf(v) != 10 { return fail("x should be 10") }
	return ""
}
