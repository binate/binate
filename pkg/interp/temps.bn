package "pkg/interp"

// ============================================================
// Temp List
//
// A TempList owns @Value temporaries created during statement
// evaluation. readFlatValue registers Values here. At statement
// end, remaining temps are destroyed via cleanValue.
//
// Values can be moved off the temp list (ownership transfer to
// an env entry or return value). Borrows are *Value pointers
// into the temp list — valid as long as the temp list is alive.
// ============================================================

// newTempList creates an empty temp list.
func newTempList() @TempList {
	var tl @TempList = make(TempList)
	tl.Vals = make_slice(@Value, 16)
	tl.Len = 0
	return tl
}

// pushTemp adds a @Value to the temp list and returns *Value
// (a borrow). The temp list owns the @Value.
// pushTemp adds a @Value to the temp list. Returns the same
// @Value (conceptual borrow — the temp list is the true owner).
func pushTemp(tl @TempList, v @Value) @Value {
	if tl.Len >= len(tl.Vals) {
		var newCap int = len(tl.Vals) * 2
		var newVals @[]@Value = make_slice(@Value, newCap)
		for i := 0; i < tl.Len; i++ {
			newVals[i] = tl.Vals[i]
		}
		tl.Vals = newVals
	}
	tl.Vals[tl.Len] = v
	tl.Len = tl.Len + 1
	return v
}

// moveTemp removes a @Value from the temp list by matching
// a *Value borrow. Returns the @Value (caller now owns it).
// moveTemp removes a @Value from the temp list. Returns the
// @Value (caller now owns it). Must be called before storing
// a Value via envDefine/envSet/execReturn.
func moveTemp(tl @TempList, v @Value) @Value {
	if v == nil || tl.Len == 0 { return nil }
	for i := 0; i < tl.Len; i++ {
		if tl.Vals[i] == v {
			var owned @Value = tl.Vals[i]
			for j := i; j < tl.Len - 1; j++ {
				tl.Vals[j] = tl.Vals[j + 1]
			}
			tl.Len = tl.Len - 1
			tl.Vals[tl.Len] = nil
			// The temp list's RefInc (from evalIdent et al.)
			// transfers to the caller. Mark IsFresh so the next
			// envDefine/envSet won't double-RefInc.
			owned.IsFresh = true
			return owned
		}
	}
	return nil
}

// cleanTempList destroys all remaining temps via cleanValue.
func cleanTempList(tl @TempList) {
	for i := 0; i < tl.Len; i++ {
		var v @Value = tl.Vals[i]
		if v != nil {
			cleanValue(v)
			tl.Vals[i] = nil
		}
	}
	tl.Len = 0
}
