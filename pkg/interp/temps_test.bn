package "pkg/interp"

import "pkg/types"
import "pkg/builtin/testing"

func TestNewTempList() testing.TestResult {
	var tl @TempList = newTempList()
	if tl.Len != 0 { return fail("should be empty") }
	return ""
}

func TestPushTemp() testing.TestResult {
	var tl @TempList = newTempList()
	var v @Value = MakeIntVal(42, types.TypInt())
	var p @Value = pushTemp(tl, v)
	if tl.Len != 1 { return fail("should have 1 temp") }
	if p == nil { return fail("should return borrow") }
	if IntOf(p) != 42 { return fail("should be 42") }
	return ""
}

func TestMoveTemp() testing.TestResult {
	var tl @TempList = newTempList()
	var v @Value = MakeIntVal(99, types.TypInt())
	var p @Value = pushTemp(tl, v)
	var owned @Value = moveTemp(tl, p)
	if tl.Len != 0 {
		return fail("should be empty after move")
	}
	if owned == nil { return fail("should return owned") }
	if IntOf(owned) != 99 { return fail("should be 99") }
	return ""
}

func TestCleanTempList() testing.TestResult {
	var tl @TempList = newTempList()
	pushTemp(tl, MakeIntVal(1, types.TypInt()))
	pushTemp(tl, MakeIntVal(2, types.TypInt()))
	pushTemp(tl, MakeIntVal(3, types.TypInt()))
	if tl.Len != 3 { return fail("should have 3") }
	cleanTempList(tl)
	if tl.Len != 0 {
		return fail("should be 0 after clean")
	}
	return ""
}

// moveTemp should set IsFresh=true on the returned Value so
// downstream envDefine/envSet skips its RefInc (ownership transfer).
func TestMoveTempSetsIsFresh() testing.TestResult {
	var tl @TempList = newTempList()
	var v @Value = MakeIntVal(7, types.TypInt())
	if v.IsFresh { return fail("pre: IsFresh should be false") }
	pushTemp(tl, v)
	var owned @Value = moveTemp(tl, v)
	if owned == nil { return fail("moveTemp returned nil") }
	if !owned.IsFresh {
		return fail("moveTemp should set IsFresh")
	}
	return ""
}

// moveTemp for a Value not on the temp list should return nil
// without modifying the Value (it's not owned by the temp list).
func TestMoveTempNotFound() testing.TestResult {
	var tl @TempList = newTempList()
	var v @Value = MakeIntVal(5, types.TypInt())
	// Don't push v onto tl
	var owned @Value = moveTemp(tl, v)
	if owned != nil {
		return fail("should return nil for non-temp")
	}
	if v.IsFresh {
		return fail("should not modify IsFresh")
	}
	return ""
}
