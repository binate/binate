		return fail("arr[i] = v should emit OP_BOUNDS_CHECK")
	}
	return ""
}

// `unsafe_index(s, i)` is the documented opt-out and must NOT emit
// OP_BOUNDS_CHECK. Same lowering as s[i] except for the check.
func TestUnsafeIndexSkipsBoundsCheck() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func foo() int {\n")
	cb = buf.WriteStr(cb, "\tvar s *[]int = make_slice(int, 3)\n")
	cb = buf.WriteStr(cb, "\treturn unsafe_index(s, 1)\n}\n")
	var m @Module = genFromSource(cb.Bytes())
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], OP_BOUNDS_CHECK) != 0 {
		return fail("unsafe_index must not emit OP_BOUNDS_CHECK")
	}
	return ""
}

// Pointer indexing (`p[i]` for `var p *T`) has no length and is inherently
// unchecked. Must NOT emit OP_BOUNDS_CHECK.
func TestPointerIndexSkipsBoundsCheck() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func foo(p *int) int {\n")
	cb = buf.WriteStr(cb, "\treturn p[2]\n}\n")
	var m @Module = genFromSource(cb.Bytes())
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], OP_BOUNDS_CHECK) != 0 {
		return fail("pointer index must not emit OP_BOUNDS_CHECK")
	}
	return ""
}

// `s[lo:hi]` with both endpoints explicit emits two OP_BOUNDS_CHECK ops:
// one for `hi ≤ len` and one for `lo ≤ hi`.
func TestGenSliceExprEmitsBoundsChecks() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func foo() *[]int {\n")
	cb = buf.WriteStr(cb, "\tvar s *[]int = make_slice(int, 5)\n")
	cb = buf.WriteStr(cb, "\treturn s[1:3]\n}\n")
	var m @Module = genFromSource(cb.Bytes())
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], OP_BOUNDS_CHECK) != 2 {
		return fail("s[lo:hi] should emit 2 OP_BOUNDS_CHECK")
	}
	return ""
}

// `s[:hi]` with implicit lo (==0) skips the lo check.
func TestGenSliceExprImplicitLoSkipsLoCheck() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func foo() *[]int {\n")
	cb = buf.WriteStr(cb, "\tvar s *[]int = make_slice(int, 5)\n")
	cb = buf.WriteStr(cb, "\treturn s[:3]\n}\n")
	var m @Module = genFromSource(cb.Bytes())
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	// Only the hi-vs-len check runs when lo is implicit.
	if countOp(m.Funcs[0], OP_BOUNDS_CHECK) != 1 {
		return fail("s[:hi] should emit exactly 1 OP_BOUNDS_CHECK")
	}
	return ""
}

// `s[lo:]` with implicit hi (==len) skips the hi check.
func TestGenSliceExprImplicitHiSkipsHiCheck() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func foo() *[]int {\n")
	cb = buf.WriteStr(cb, "\tvar s *[]int = make_slice(int, 5)\n")
	cb = buf.WriteStr(cb, "\treturn s[2:]\n}\n")
	var m @Module = genFromSource(cb.Bytes())
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	// Only the lo-vs-hi check runs when hi is implicit.
	if countOp(m.Funcs[0], OP_BOUNDS_CHECK) != 1 {
		return fail("s[lo:] should emit exactly 1 OP_BOUNDS_CHECK")
	}
	return ""
}

// `s[:]` with both endpoints implicit needs no checks.
func TestGenSliceExprBothImplicitNoCheck() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func foo() *[]int {\n")
	cb = buf.WriteStr(cb, "\tvar s *[]int = make_slice(int, 5)\n")
	cb = buf.WriteStr(cb, "\treturn s[:]\n}\n")
	var m @Module = genFromSource(cb.Bytes())
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], OP_BOUNDS_CHECK) != 0 {
		return fail("s[:] should emit no OP_BOUNDS_CHECK")
	}
	return ""
}

func TestGenIndexPtrSliceOfStructs() testing.TestResult {
	// sliceOfStructs[i].field = value should produce
	// extract + GEP
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type Point struct {\n\tX int\n\tY int\n}\n")
	cb = buf.WriteStr(cb, "func foo() {\n")
	cb = buf.WriteStr(cb, "\tvar pts *[]Point = make_slice(Point, 1)\n")
	cb = buf.WriteStr(cb, "\tpts[0] = Point{1, 2}\n")
	cb = buf.WriteStr(cb, "\tpts[0].X = 99\n}\n")
	var src @[]char = cb.Bytes()
	var m @Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	var fn @Func = m.Funcs[0]
	var foundGEP bool = false
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == OP_GET_ELEM_PTR {
				foundGEP = true
			}
		}
	}
	if !foundGEP { return fail("slice-of-structs index assign should emit GEP") }
	return ""
}

// ============================================================
// Phase 3 rodata composite-literal fast path
// ============================================================

// genManagedSliceLit with all-const-byte elements + const-uint8 element
// type emits OP_RODATA_MSLICE directly (no MakeSlice + N stores).
func TestGenManagedSliceLitConstBytesEmitsRodataMSlice() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func foo() @[]const char {\n")
	cb = buf.WriteStr(cb, "\treturn @[]const char{'a', 'b', 'c'}\n}\n")
	var m @Module = genFromSource(cb.Bytes())
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], OP_RODATA_MSLICE) != 1 {
		return fail("expected exactly 1 OP_RODATA_MSLICE")
	}
	if countOp(m.Funcs[0], OP_MAKE_SLICE) != 0 {
		return fail("OP_MAKE_SLICE should NOT fire on the fast path")
	}
	return ""
}

// Same idea for raw-slice composite literals.
func TestGenRawSliceLitConstBytesEmitsRodataSlice() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func foo() *[]const char {\n")
	cb = buf.WriteStr(cb, "\treturn *[]const char{'X', 'Y'}\n}\n")
	var m @Module = genFromSource(cb.Bytes())
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], OP_RODATA_SLICE) != 1 {
		return fail("expected exactly 1 OP_RODATA_SLICE")
	}
	if countOp(m.Funcs[0], OP_MAKE_SLICE) != 0 {
		return fail("OP_MAKE_SLICE should NOT fire on the fast path")
	}
	return ""
}

// Mixed char + small-int literals also qualify (values 0..255, uint8 elem).
func TestGenManagedSliceLitMixedByteLiteralsTakesFastPath() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func foo() @[]const char {\n")
	cb = buf.WriteStr(cb, "\treturn @[]const char{72, 'i', 33}\n}\n")
	var m @Module = genFromSource(cb.Bytes())
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], OP_RODATA_MSLICE) != 1 {
		return fail("expected OP_RODATA_MSLICE for mixed byte literals")
	}
	return ""
}

// Negative: non-byte element type (e.g. @[]const int) does NOT take the
// fast path. Falls through to MakeSlice + N stores.
func TestGenManagedSliceLitNonByteElemNoFastPath() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func foo() @[]const int {\n")
	cb = buf.WriteStr(cb, "\treturn @[]const int{1, 2, 3}\n}\n")
	var m @Module = genFromSource(cb.Bytes())
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], OP_RODATA_MSLICE) != 0 {
		return fail("@[]const int should NOT take the fast path")
	}
	if countOp(m.Funcs[0], OP_MAKE_SLICE) < 1 {
		return fail("expected OP_MAKE_SLICE for the slow path")
	}
	return ""
}

// Negative: non-const elem type (`@[]char`, mutable) bypasses the fast
// path even with all-byte literals — aliasing rodata would let writes
// hit read-only memory.
func TestGenManagedSliceLitMutableNoFastPath() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func foo() @[]char {\n")
	cb = buf.WriteStr(cb, "\treturn @[]char{'a', 'b', 'c'}\n}\n")
	var m @Module = genFromSource(cb.Bytes())
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], OP_RODATA_MSLICE) != 0 {
		return fail("mutable @[]char should NOT take the fast path")
	}
	if countOp(m.Funcs[0], OP_MAKE_SLICE) < 1 {
		return fail("expected OP_MAKE_SLICE for mutable composite")
	}
	return ""
}

// Negative: runtime element (`y` is a parameter) blocks the fast path.
func TestGenManagedSliceLitRuntimeElemNoFastPath() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func foo(y char) @[]const char {\n")
	cb = buf.WriteStr(cb, "\treturn @[]const char{'a', y, 'c'}\n}\n")
	var m @Module = genFromSource(cb.Bytes())
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], OP_RODATA_MSLICE) != 0 {
		return fail("runtime-elem composite should NOT take fast path")
	}
	return ""
}

// ============================================================
// Phase 3.2 EmitStringToChars dispatch
// ============================================================

// `var s @[]const char = "hello"` lowers to OP_RODATA_MSLICE
// (zero-copy alias of the static %BnManagedSlice global).
func TestStringToManagedConstSliceEmitsRodataMSlice() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nfunc foo() @[]const char {\n\treturn \"hello\"\n}\n"
	var m @Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	if countOp(m.Funcs[0], OP_RODATA_MSLICE) != 1 {
		return fail("expected OP_RODATA_MSLICE for string→@[]const char")
	}
	return ""
}
