package "pkg/ir"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/bootstrap"
import "pkg/builtins/testing"

// Tests for genCall — the call dispatch and lowering logic in
// gen_call.bn. Function-value-call coverage lives in
// gen_func_value_test.bn; method-call coverage in gen_method_test.bn.

func TestNilSliceArgCoercion() testing.TestResult {
	// Passing nil to a function expecting a slice parameter
	// should produce a nil instruction with slice type (not
	// TYP_NIL), so codegen emits %BnSlice zeroinitializer
	// instead of i8* null.
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func take(s *[]int, n int) int {")
	cb = cb.WriteStr(" return n }\n")
	cb = cb.WriteStr("func main() { take(nil, 42) }\n")
	var src @[]char = cb.Bytes()
	var m @Module = genFromSource(src)
	if len(m.Funcs) < 2 {
		return fail(buf.Concat(
			"expected 2 funcs, got ",
			bootstrap.Itoa(len(m.Funcs))))
	}
	// Find main function
	var mainFunc @Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.main") { mainFunc = m.Funcs[i] }
	}
	if mainFunc == nil { return fail("no main func") }
	// Find the OP_CALL instruction to "take" in main
	var callInstr @Instr = nil
	for i := 0; i < len(mainFunc.Blocks); i++ {
		var blk @Block = mainFunc.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op == OP_CALL && seq(instr.StrVal, "test.take") {
				callInstr = instr
			}
		}
	}
	if callInstr == nil { return fail("no call to take()") }
	// First arg should be nil with slice type, not TYP_NIL
	if len(callInstr.Args) < 2 {
		return fail(buf.Concat(
			"expected 2 args, got ",
			bootstrap.Itoa(len(callInstr.Args))))
	}
	var nilArg @Instr = callInstr.Args[0]
	if nilArg.Op != OP_CONST_NIL { return fail("first arg should be OP_CONST_NIL") }
	if nilArg.Typ == nil { return fail("nil arg type is nil") }
	if nilArg.Typ.Kind == types.TYP_NIL {
		return fail("nil arg should have slice type, not TYP_NIL")
	}
	if nilArg.Typ.Kind != types.TYP_SLICE {
		return fail(buf.Concat(
			"nil arg should be TYP_SLICE, got kind ",
			bootstrap.Itoa(nilArg.Typ.Kind)))
	}
	return ""
}

// genCall recognizes the compiler-internal magic names `_call_dtor` /
// `rt._call_dtor` / `_call_free_fn` / `rt._call_free_fn` and lowers
// them to OP_CALL_INDIRECT — Args[0] becomes the function pointer,
// the rest become call args. RefDec (`pkg/rt/rt.bn`) and Free use
// these to dispatch through a function pointer stored in the
// managed-allocation header without introducing a real callable
// symbol. A regression here would silently turn the indirect call
// back into a direct call to a missing symbol — the pre-fix shape
// where rt.CallDtor was a real C trampoline.
func TestGenCallDtorLowersToCallHandle() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func _call_dtor(dtor *uint8, ptr *uint8) { }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var d *uint8 = nil\n")
	cb = cb.WriteStr("  var p *uint8 = nil\n")
	cb = cb.WriteStr("  _call_dtor(d, p)\n")
	cb = cb.WriteStr("}\n")
	var m @Module = genFromSource(cb.Bytes())
	var mainFunc @Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.main") { mainFunc = m.Funcs[i] }
	}
	if mainFunc == nil { return fail("no main func") }
	var foundCallInd bool = false
	var foundDirectCall bool = false
	for bi := 0; bi < len(mainFunc.Blocks); bi++ {
		var blk @Block = mainFunc.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op == OP_CALL_HANDLE { foundCallInd = true }
			if instr.Op == OP_CALL &&
				seq(instr.StrVal, "_call_dtor") {
				foundDirectCall = true
			}
		}
	}
	if !foundCallInd {
		return fail("_call_dtor(...) must lower to OP_CALL_HANDLE")
	}
	if foundDirectCall {
		return fail("_call_dtor(...) must NOT lower to OP_CALL — that's the bug shape")
	}
	return ""
}

// _call_free_fn dispatches through a function-value HANDLE (Phase 4
// of plan-uniform-native-fnptrs.md): Args[0] is a *uint8 pointing
// at a 16-byte {vtable, data} block (the result of _func_handle /
// the renamed _raw_func_addr).  Same shape as _call_dtor above; both
// lower to OP_CALL_HANDLE.  _call_shim_scalar / _call_shim_aggregate
// stay on OP_CALL_INDIRECT (raw shim+data shape).
func TestGenCallFreeFnLowersToCallHandle() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func _call_free_fn(freeFn *uint8, ptr *uint8) { }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var f *uint8 = nil\n")
	cb = cb.WriteStr("  var p *uint8 = nil\n")
	cb = cb.WriteStr("  _call_free_fn(f, p)\n")
	cb = cb.WriteStr("}\n")
	var m @Module = genFromSource(cb.Bytes())
	var mainFunc @Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.main") { mainFunc = m.Funcs[i] }
	}
	if mainFunc == nil { return fail("no main func") }
	var foundCallHandle bool = false
	var foundDirectCall bool = false
	for bi := 0; bi < len(mainFunc.Blocks); bi++ {
		var blk @Block = mainFunc.Blocks[bi]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op == OP_CALL_HANDLE { foundCallHandle = true }
			if instr.Op == OP_CALL &&
				seq(instr.StrVal, "_call_free_fn") {
				foundDirectCall = true
			}
		}
	}
	if !foundCallHandle {
		return fail("_call_free_fn(...) must lower to OP_CALL_HANDLE")
	}
	if foundDirectCall {
		return fail("_call_free_fn(...) must NOT lower to OP_CALL — that's the bug shape")
	}
	return ""
}
