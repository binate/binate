package "pkg/ir"

import "pkg/ast"
import "pkg/types"

// IR generation for struct composite literals — `T{...}` where T
// is a struct, with positional or keyed elements. Array / slice /
// managed-slice composite-lit forms are dispatched through here
// to genArrayLit / genRawSliceLit / genManagedSliceLit in
// gen_access.bn.

// genCompositeLit generates IR for a composite literal (struct or array).
func genCompositeLit(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	if e.TypeRef == nil {
		return EmitConstInt(ctx.Func, b, 0, types.TypInt())
	}

	// Array composite literal: [N]T{...}
	if e.TypeRef.Kind == ast.TEXPR_ARRAY {
		return genArrayLit(ctx, b, e)
	}

	// Managed-slice composite literal: @[]T{...}
	if e.TypeRef.Kind == ast.TEXPR_MANAGED_SLICE {
		return genManagedSliceLit(ctx, b, e)
	}

	// Raw-slice composite literal: *[]const T{...}
	if e.TypeRef.Kind == ast.TEXPR_SLICE {
		return genRawSliceLit(ctx, b, e)
	}

	var typeName @[]char = e.TypeRef.Name
	var si int = lookupStructIdx(typeName)
	if si < 0 {
		return EmitConstInt(ctx.Func, b, 0, types.TypInt())
	}

	var structPtr @Instr = EmitAlloc(ctx.Func, b, moduleStructs[si].Typ)

	// Initialize all fields: from keyed or positional elements, or zero
	var fields @[]@types.Field = moduleStructs[si].Fields
	var isKeyed bool = len(e.Elems) > 0 && e.Elems[0].Key != nil
	for i := 0; i < len(fields); i++ {
		var fieldPtr @Instr = EmitGetFieldPtr(ctx.Func, b, structPtr, i, fields[i].Type)
		var val @Instr = nil
		if isKeyed {
			// Keyed: find element by field name
			for j := 0; j < len(e.Elems); j++ {
				if e.Elems[j].Key != nil && streq(e.Elems[j].Key.Name, fields[i].Name) {
					val = genExprOrFuncRef(ctx, b,
						e.Elems[j].Value, fields[i].Type)
					b = ctx.CurBlock
				}
			}
		} else {
			// Positional: use element at index i if available
			if i < len(e.Elems) {
				val = genExprOrFuncRef(ctx, b,
					e.Elems[i].Value, fields[i].Type)
				b = ctx.CurBlock
			}
		}
		if val == nil {
			// Zero-initialize: use nil for slices/pointers, 0 for scalars
			if isNillableType(fields[i].Type) {
				val = EmitConstNil(ctx.Func, b, fields[i].Type)
			} else {
				val = EmitConstInt(ctx.Func, b, 0, fields[i].Type)
			}
		}
		// String literal assigned to *[]const char field: convert.
		// isCharSliceType peels const on the element (for *[]const char).
		var ft @types.Type = fields[i].Type
		if isCharSliceType(ft) && ft.Kind == types.TYP_SLICE {
			if val.Op == OP_CONST_STRING {
				val = EmitStringToChars(ctx.Func, b, val, fields[i].Type)
				noteSPGrowingResult(ctx, val)
			}
		}
		// String literal assigned to [N]char field: load rodata array.
		if isCharArrayType(ft) {
			if val.Op == OP_CONST_STRING {
				val = EmitRodataArray(ctx.Func, b, val.StrVal, fields[i].Type)
				noteSPGrowingResult(ctx, val)
			}
		}
		// @[]T → *[]T conversion for raw slice field
		if ft.Kind == types.TYP_SLICE && val.Typ != nil && val.Typ.Kind == types.TYP_MANAGED_SLICE {
			// Temp stays in cleanup — RefDec at end of statement
			val = EmitManagedToRaw(ctx.Func, b, val)
		}
		// If the value is a struct alloca (from nested composite lit), load it first
		if val.Op == OP_ALLOC && val.TypeArg != nil && val.TypeArg.Kind == types.TYP_STRUCT {
			val = EmitLoad(ctx.Func, b, val, val.TypeArg)
		}
		EmitStore(b, fieldPtr, val)
	}

	return structPtr
}
