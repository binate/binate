package "pkg/ir"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/token"
import "pkg/binate/types"
import "pkg/slices"

// resolveGlobalVarType returns the type for a top-level
// `var` declaration.  When `d.TypeRef` is set, it's the
// resolved declared type.  When it's nil (untyped — `var x =
// expr`), the type is inferred from the initializer literal:
//
//   var x = 42        → int
//   var x = 1.5       → float64
//   var x = true      → bool
//   var x = 'a'       → char
//   var x = "hello"   → @[]const char
//
// Returns nil for non-literal initializers (function calls,
// arithmetic, etc.) — caller surfaces a "type required" error.
// The type checker handles those for LOCAL vars via its full
// expression machinery; mirroring that for top-level vars
// would require threading the checker through IR-gen, which
// isn't worth the surface for the common-case literal init.
func resolveGlobalVarType(d @ast.Decl) @types.Type {
	if d.TypeRef != nil {
		return resolveTypeExpr(d.TypeRef)
	}
	if d.Value == nil { return nil }
	var e @ast.Expr = d.Value
	if e.Kind == ast.EXPR_INT_LIT { return types.TypInt() }
	if e.Kind == ast.EXPR_BOOL_LIT { return types.TypBool() }
	if e.Kind == ast.EXPR_CHAR_LIT { return types.TypChar() }
	if e.Kind == ast.EXPR_FLOAT_LIT { return types.TypFloat64() }
	if e.Kind == ast.EXPR_STRING_LIT {
		return types.MakeManagedSliceType(
			types.MakeConstType(types.TypUint8()))
	}
	return nil
}

// evalConstExpr evaluates a compile-time constant integer expression
// against the current iota counter and the already-registered entries
// in moduleConsts.  Returns (value, ok); ok=false signals that the
// expression can't be reduced (e.g. references a non-integer const, an
// unsupported AST kind, or a forward reference not yet in
// moduleConsts).  Callers fall back to `iotaVal` on !ok to preserve
// the pre-fix bare-iota behavior so a regression doesn't quietly
// produce a different wrong value than before.
//
// Supports the const-expression forms used by pkg/asm/aarch64 and
// pkg/binate/token's constant tables: literal ints, bare iota, references to
// previously-registered consts (bare or `pkg.Name`-qualified), unary
// minus, and the integer binary ops (+, -, *, /, %, |, ^, &, <<, >>).
// The reason this exists at all: `D0 int = iota + 32` and similar in
// pkg/asm/aarch64.bni were silently truncated to `iotaVal` (so D0=0
// instead of 32), which gave bnc the wrong values for `aarch64.D16` /
// `aarch64.D17`, which in turn made `FP_SCRATCH_A` / `FP_SCRATCH_B`
// both 0, so emitFloatBinop's two FMOVs targeted the same Dn —
// causing `1.5 + 2.5` to compute `2.5 + 2.5 = 5.0`.  The bug only
// became externally visible once the
// builder-comp_native_aa64-comp_native_aa64 mode ran tests through a
// self-hosted bnc binary; under bootstrap interp the Go-side const
// evaluator handles all of these forms directly.
func evalConstExpr(e @ast.Expr, iotaVal int) (int, bool) {
	if e == nil { return 0, false }
	if e.Kind == ast.EXPR_INT_LIT { return parseIntLit(e.Name), true }
	if e.Kind == ast.EXPR_CHAR_LIT { return parseCharLit(e.Name), true }
	if e.Kind == ast.EXPR_IDENT {
		if streq(e.Name, "iota") { return iotaVal, true }
		var v int
		var t @types.Type
		var ok bool
		v, t, ok = lookupConst(e.Name)
		// t is unused (we only care about the integer value); read it
		// to satisfy any unused-binding diagnostics.
		if t == nil { t = nil }
		if ok { return v, true }
		// While processing an imported package's .bni consts, sibling
		// references appear unqualified ("WORDS") but are registered
		// under the import-qualified name ("pkg/x.WORDS").  Retry with
		// the current import alias so e.g. `const SIZE int = WORDS * 8`
		// in pkg/x.bni evaluates correctly when consumed from pkg/y.
		if len(currentImportAlias) > 0 {
			var qn @[]char = buildQualName(currentImportAlias, e.Name)
			v, t, ok = lookupConst(qn)
			if t == nil { t = nil }
			if ok { return v, true }
		}
		return 0, false
	}
	if e.Kind == ast.EXPR_SELECTOR {
		if e.X == nil || e.X.Kind != ast.EXPR_IDENT { return 0, false }
		var qn @[]char = buildQualName(e.X.Name, e.Name)
		var v int
		var t @types.Type
		var ok bool
		v, t, ok = lookupConst(qn)
		if t == nil { t = nil }
		if ok { return v, true }
		return 0, false
	}
	if e.Kind == ast.EXPR_UNARY {
		var x int
		var ok bool
		x, ok = evalConstExpr(e.X, iotaVal)
		if !ok { return 0, false }
		if e.Op == cast(int, token.MINUS) { return -x, true }
		if e.Op == cast(int, token.PLUS) { return x, true }
		if e.Op == cast(int, token.TILDE) { return -x - 1, true }
		return 0, false
	}
	if e.Kind == ast.EXPR_BINARY {
		var lhs int
		var lok bool
		lhs, lok = evalConstExpr(e.X, iotaVal)
		if !lok { return 0, false }
		var rhs int
		var rok bool
		rhs, rok = evalConstExpr(e.Y, iotaVal)
		if !rok { return 0, false }
		if e.Op == cast(int, token.PLUS)    { return lhs + rhs, true }
		if e.Op == cast(int, token.MINUS)   { return lhs - rhs, true }
		if e.Op == cast(int, token.STAR)    { return lhs * rhs, true }
		if e.Op == cast(int, token.SLASH) {
			if rhs == 0 { return 0, false }
			return lhs / rhs, true
		}
		if e.Op == cast(int, token.PERCENT) {
			if rhs == 0 { return 0, false }
			return lhs - (lhs / rhs) * rhs, true
		}
		if e.Op == cast(int, token.AMP)     { return lhs & rhs, true }
		if e.Op == cast(int, token.PIPE)    { return lhs | rhs, true }
		if e.Op == cast(int, token.CARET)   { return lhs ^ rhs, true }
		if e.Op == cast(int, token.SHL)     { return lhs << rhs, true }
		if e.Op == cast(int, token.SHR)     { return lhs >> rhs, true }
		return 0, false
	}
	if e.Kind == ast.EXPR_BUILTIN {
		if e.Op == cast(int, token.SIZEOF) {
			var t @types.Type = resolveTypeExpr(e.TypeRef)
			if t == nil { return 0, false }
			return t.SizeOf(), true
		}
		if e.Op == cast(int, token.ALIGNOF) {
			var t @types.Type = resolveTypeExpr(e.TypeRef)
			if t == nil { return 0, false }
			return t.AlignOf(), true
		}
		if e.Op == cast(int, token.CAST) ||
				e.Op == cast(int, token.BIT_CAST) {
			// Integer-typed cast / bit_cast over a constant operand:
			// pass the value through unchanged.  Non-integer casts
			// (float → int etc.) aren't supported by the const evaluator
			// — the caller's `if !ok` branch will drop the const.
			if len(e.Args) == 0 { return 0, false }
			var v int
			var ok bool
			v, ok = evalConstExpr(e.Args[0], iotaVal)
			return v, ok
		}
		return 0, false
	}
	return 0, false
}

// genConst registers a single constant declaration in moduleConsts.
// For a bare top-level `const X int = <expr>`, iota is 0 (no group).
func genConst(d @ast.Decl) {
	if d.Value == nil { return }
	var val int
	var ok bool
	val, ok = evalConstExpr(d.Value, 0)
	if !ok { return }
	var mc ModuleConst
	mc.Name = buf.CopyStr(d.Name)
	mc.Val = val
	if d.TypeRef != nil {
		mc.Typ = resolveTypeExpr(d.TypeRef)
	}
	moduleConsts = slices.Append[ModuleConst](moduleConsts, mc)
}

// genConstGroup registers a group of iota constants in moduleConsts.
// Skips parked members (the REPL's Tier 3 forward-ref machinery
// marks individual const members as pending when their value
// expression references undefined names — see plan-repl-tier3-
// pending-types.md Stage 1 (c)).  iotaVal still increments
// across the parked positions so resolved members get the
// correct positional iota — the same value retry will give
// the parked member when it eventually lands via GenConstMember.
func genConstGroup(d @ast.Decl) {
	if len(d.Decls) == 0 { return }
	var iotaVal int = 0
	// Resolve the group's type (if any) — applies to all members
	var groupTyp @types.Type = nil
	if len(d.Decls) > 0 && d.Decls[0].TypeRef != nil {
		groupTyp = resolveTypeExpr(d.Decls[0].TypeRef)
	}
	for i := 0; i < len(d.Decls); i++ {
		var cd @ast.Decl = d.Decls[i]
		if cd.Kind == ast.DECL_CONST {
			if currentChecker != nil &&
					currentChecker.IsPendingDecl(cd.Name) {
				// Parked member.  Still increment iotaVal so
				// the next resolved member's iota reflects
				// source position.  retryPending's
				// GenConstMember path will register this
				// member when its dep arrives, using the same
				// iotaVal (preserved on the PendingDecl).
				iotaVal = iotaVal + 1
				continue
			}
			var mc ModuleConst
			mc.Name = buf.CopyStr(cd.Name)
			if cd.Value != nil {
				var v int
				var ok bool
				v, ok = evalConstExpr(cd.Value, iotaVal)
				if ok {
					mc.Val = v
				} else {
					mc.Val = iotaVal
				}
			} else {
				// Bare member (inherits previous expression's pattern).
				// IR-gen's model treats this as plain iota; the
				// "repeat-previous-expr" Go-style is not implemented
				// elsewhere either.  Use iotaVal here too.
				mc.Val = iotaVal
			}
			// Use the member's type if present, otherwise the group type
			if cd.TypeRef != nil {
				mc.Typ = resolveTypeExpr(cd.TypeRef)
			} else {
				mc.Typ = groupTyp
			}
			moduleConsts = slices.Append[ModuleConst](moduleConsts, mc)
			iotaVal = iotaVal + 1
		}
	}
}
