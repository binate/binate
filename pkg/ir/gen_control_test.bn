package "pkg/ir"

import "pkg/ast"
import "pkg/bootstrap"
import "pkg/buf"
import "pkg/builtin/testing"
import "pkg/parser"
import "pkg/types"

func TestGenCompoundAssign() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func main() {")
	cb = buf.WriteStr(cb, " var x int = 10; x += 5; println(x) }\n")
	var m @Module = genFromSource(cb.Bytes())
	var entry @Block = m.Funcs[0].Blocks[0]
	var addCount int = 0
	var storeCount int = 0
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == OP_ADD { addCount = addCount + 1 }
		if entry.Instrs[i].Op == OP_STORE { storeCount = storeCount + 1 }
	}
	if storeCount < 2 {
		return fail(bootstrap.Concat(
			"expected >=2 stores, got ",
			bootstrap.Itoa(storeCount)))
	}
	if addCount < 1 { return fail("expected at least 1 add for compound assign") }
	return ""
}

// Phase 3.2: read-only string→slice assignments lower to OP_RODATA_SLICE
// (raw target) or OP_RODATA_MSLICE (managed target), not OP_STRING_TO_CHARS.
func TestAssignStringToChars() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func foo() *[]const char {\n")
	cb = buf.WriteStr(cb, "\tvar s *[]const char\n\ts = \"hello\"\n")
	cb = buf.WriteStr(cb, "\treturn s\n}\n")
	var src @[]char = cb.Bytes()
	var m @Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	var fn @Func = m.Funcs[0]
	var found bool = false
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == OP_RODATA_SLICE {
				found = true
			}
		}
	}
	if !found {
		return fail(
			"no OP_RODATA_SLICE found for string-to-*[]const char")
	}
	return ""
}

func TestNilToSliceAssign() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc foo() {\n\tvar s *[]int\n\ts = nil\n}\n"
	var m @Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	var fn @Func = m.Funcs[0]
	var foundSliceNil bool = false
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op == OP_STORE && len(instr.Args) >= 2 {
				if instr.Args[1].Op == OP_CONST_NIL && instr.Args[1].Typ != nil {
					if instr.Args[1].Typ.Kind == types.TYP_SLICE {
						foundSliceNil = true
					}
				}
			}
		}
	}
	if !foundSliceNil {
		return fail(
			"nil assigned to slice should re-emit as TYP_SLICE")
	}
	return ""
}

func TestSliceElemRefcount() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type Node struct { Val int }\n")
	cb = buf.WriteStr(cb, "func foo() {\n")
	cb = buf.WriteStr(cb, "\tvar s @[]@Node = make_slice(@Node, 2)\n")
	cb = buf.WriteStr(cb, "\tvar n @Node = make(Node)\n")
	cb = buf.WriteStr(cb, "\ts[0] = n\n}\n")
	var src @[]char = cb.Bytes()
	var m @Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	var fn @Func = m.Funcs[0]
	// Slice get/set lower to OP_EXTRACT + OP_GET_ELEM_PTR +
	// OP_LOAD/STORE. Check that refcounting ops
	// (RefInc/RefDec) are still emitted for managed elements.
	var incCount int = 0
	var decCount int = 0
	var storeCount int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var op int = blk.Instrs[j].Op
			if op == OP_REFCOUNT_INC { incCount = incCount + 1 }
			if op == OP_REFCOUNT_DEC { decCount = decCount + 1 }
			if op == OP_STORE { storeCount = storeCount + 1 }
		}
	}
	if decCount < 1 {
		return fail(bootstrap.Concat(
			"expected >=1 OP_REFCOUNT_DEC, got ",
			bootstrap.Itoa(decCount)))
	}
	if incCount < 1 {
		return fail(bootstrap.Concat(
			"expected >=1 OP_REFCOUNT_INC, got ",
			bootstrap.Itoa(incCount)))
	}
	if storeCount < 1 {
		return fail(bootstrap.Concat(
			"expected >=1 OP_STORE, got ",
			bootstrap.Itoa(storeCount)))
	}
	return ""
}

func TestManagedPtrDeclNilInit() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\nimport \"pkg/ast\"\n")
	cb = buf.WriteStr(cb, "func foo() {\n")
	cb = buf.WriteStr(cb, "\tvar d @ast.Decl\n\td = nil\n}\n")
	var src @[]char = cb.Bytes()
	var m @Module = genFromSourcePkg(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	var fn @Func = m.Funcs[0]
	var foundNilStore bool = false
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op == OP_STORE && len(instr.Args) >= 2 {
				if instr.Args[1].Op == OP_CONST_NIL {
					foundNilStore = true
				}
			}
		}
	}
	if !foundNilStore {
		return fail(
			"managed ptr decl should init with nil store")
	}
	return ""
}

// Assigning &local into a raw-pointer slice element must store
// the alloca pointer directly. Previously the codegen unconditionally
// loaded the struct value from the alloca (correct only when the
// slot holds a struct), so &local was silently converted to *&local —
// storing the first word of the struct instead of the pointer.
func TestRawPtrSliceElemAssignAddrOf() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type Item struct { Val int }\n")
	cb = buf.WriteStr(cb, "func put(items *[]*Item) {\n")
	cb = buf.WriteStr(cb, "\tvar it Item\n")
	cb = buf.WriteStr(cb, "\tit.Val = 42\n")
	cb = buf.WriteStr(cb, "\titems[0] = &it\n")
	cb = buf.WriteStr(cb, "}\n")
	var src @[]char = cb.Bytes()
	var m @Module = genFromSource(src)
	var fn @Func = findFunc(m, "put")
	if fn == nil { return fail("expected put func") }
	// The alloca for `it` must not be followed by an OP_LOAD
	// that feeds the slice-set. Find the alloca for Item, then
	// scan instructions that consume it and make sure none are
	// an OP_LOAD.
	var itAlloc @Instr = nil
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @Instr = blk.Instrs[j]
			if ins.Op != OP_ALLOC { continue }
			if ins.TypeArg == nil { continue }
			if ins.TypeArg.Kind != types.TYP_STRUCT { continue }
			itAlloc = ins
		}
	}
	if itAlloc == nil { return fail("expected alloca for Item") }
	// No OP_LOAD in the function should take itAlloc as arg — the
	// &it expression should flow directly into the slice-set.
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @Instr = blk.Instrs[j]
			if ins.Op != OP_LOAD { continue }
			if len(ins.Args) > 0 && ins.Args[0].ID == itAlloc.ID {
				return fail("unexpected OP_LOAD of Item alloca in slice assign")
			}
		}
	}
	return ""
}

// Same as above but for an array (not a slice) of raw pointers.
// Exercises the array branch of genAssign's EXPR_INDEX path.
func TestRawPtrArrayElemAssignAddrOf() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type Item struct { Val int }\n")
	cb = buf.WriteStr(cb, "func put() {\n")
	cb = buf.WriteStr(cb, "\tvar arr [2]*Item\n")
	cb = buf.WriteStr(cb, "\tvar it Item\n")
	cb = buf.WriteStr(cb, "\tit.Val = 42\n")
	cb = buf.WriteStr(cb, "\tarr[0] = &it\n")
	cb = buf.WriteStr(cb, "}\n")
	var src @[]char = cb.Bytes()
	var m @Module = genFromSource(src)
	var fn @Func = findFunc(m, "put")
	if fn == nil { return fail("expected put func") }
	// Find the Item alloca (not the array alloca: Kind check).
	var itAlloc @Instr = nil
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @Instr = blk.Instrs[j]
			if ins.Op != OP_ALLOC { continue }
			if ins.TypeArg == nil { continue }
			if ins.TypeArg.Kind != types.TYP_STRUCT { continue }
			itAlloc = ins
		}
	}
	if itAlloc == nil { return fail("expected alloca for Item") }
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @Instr = blk.Instrs[j]
			if ins.Op != OP_LOAD { continue }
			if len(ins.Args) > 0 && ins.Args[0].ID == itAlloc.ID {
				return fail("unexpected OP_LOAD of Item alloca in array assign")
			}
		}
	}
	return ""
}
