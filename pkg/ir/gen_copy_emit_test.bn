package "pkg/ir"

import "pkg/builtin/testing"
import "pkg/types"

// ============================================================
// Copy function generation tests
// ============================================================

func TestGenerateCopiesForStructWithManagedPtr() testing.TestResult {
	// Struct with a @Inner field should get a copy function
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var f0 @types.Field = make(types.Field)
	f0.Name = "Ref"
	f0.Type = types.MakeManagedPtrType(
		types.MakeStructType("Inner", noFields))
	fields[0] = f0
	var st @types.Type = types.MakeStructType("Outer", fields)

	var m @Module = InitModule("test")
	var ms ModuleStruct
	ms.Name = "Outer"
	ms.Typ = st
	moduleStructs = appendModuleStruct(moduleStructs, ms)

	generateCopies(m)

	// Should have generated a __copy_Outer function
	var found bool = false
	for i := 0; i < len(m.Funcs); i++ {
		if charsEqual(m.Funcs[i].Name, "__copy_Outer") {
			found = true
		}
	}
	if !found {
		return fail("expected __copy_Outer function")
	}
	return ""
}
