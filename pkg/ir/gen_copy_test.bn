package "pkg/ir"

import "pkg/binate/types"
import "pkg/builtins/testing"

// ============================================================
// Copy function naming tests
// ============================================================

func TestCopyNameStruct() testing.TestResult {
	var t @types.Type = types.MakeStructType("Pos", noFields)
	var name @[]char = copyNameForType(t)
	if !charsEqual(name, "__copy_Pos") {
		return fail("expected __copy_Pos")
	}
	return ""
}

func TestCopyNameManagedPtr() testing.TestResult {
	var inner @types.Type = types.MakeStructType("Node", noFields)
	var t @types.Type = types.MakeManagedPtrType(inner)
	var name @[]char = copyNameForType(t)
	if !charsEqual(name, "__copy_mp_Node") {
		return fail("expected __copy_mp_Node")
	}
	return ""
}

func TestCopyNameArray() testing.TestResult {
	var inner @types.Type = types.MakeManagedPtrType(
		types.MakeStructType("Item", noFields))
	var t @types.Type = types.MakeArrayType(inner, 5)
	var name @[]char = copyNameForType(t)
	if !charsEqual(name, "__copy_arr5_mp_Item") {
		return fail("expected __copy_arr5_mp_Item")
	}
	return ""
}
