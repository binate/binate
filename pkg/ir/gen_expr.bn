package "pkg/ir"

import "pkg/ast"
import "pkg/buf"
import "pkg/token"
import "pkg/types"

// ============================================================
// Expression generation
// ============================================================

// genExpr generates IR for an expression, propagating source line info.
func genExpr(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	var result @Instr = genExprInner(ctx, b, e)
	if result != nil && e != nil && e.Pos.Line > 0 {
		result.Line = e.Pos.Line
	}
	return result
}

// genExprInner dispatches expression generation by AST node kind.
func genExprInner(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	ctx.CurBlock = b
	if e.Kind == ast.EXPR_INT_LIT {
		// Phase A3 of plan-ir-gen-typed-literals.md: prefer the
		// type checker's bignum value (LitMag/LitSign on the
		// resolved Type) over re-parsing the literal text via
		// parseIntLit.  Same result for all values parseIntLit
		// handles correctly; more robust at the int64-min /
		// uint64 boundary.  Falls back to parseIntLit when the
		// checker isn't available (e.g. genFromSource tests that
		// skip type-check, until A3-test-helper migration).
		var v int = exprIntLitValue(e)
		// TYP_UNTYPED_INT lowers to the target's `int` width via
		// llvmType(intLL()).  On 32-bit targets that's i32, which
		// LLVM silently truncates wide literals against
		// (e.g. `add i32 -9223372036854775808, 0` → 0).
		// Promote to int64 when the magnitude doesn't fit in i32 so
		// the literal's value survives into the LLVM IR.  Cheap on
		// 64-bit targets — `int` is already i64 there, and using
		// TypInt64 emits the same LLVM type.  Phase A5 will drop
		// this promotion once context propagation (Phase B) lands.
		if v < -2147483648 || v > 2147483647 {
			return b.EmitConstInt(v, types.TypInt64())
		}
		return b.EmitConstInt(v, types.TypUntypedInt())
	}

	if e.Kind == ast.EXPR_FLOAT_LIT {
		return b.EmitConstFloat(e.Name, types.TypUntypedFloat())
	}

	if e.Kind == ast.EXPR_STRING_LIT {
		return b.EmitConstString(unescapeStr(e.Name))
	}

	if e.Kind == ast.EXPR_CHAR_LIT {
		return b.EmitConstInt(parseCharLit(e.Name), types.TypUint8())
	}

	if e.Kind == ast.EXPR_BOOL_LIT {
		if len(e.Name) > 0 {
			return b.EmitConstBool(streq(e.Name, "true"))
		}
		return b.EmitConstBool(e.BoolVal)
	}

	if e.Kind == ast.EXPR_NIL_LIT {
		return b.EmitConstNil(types.TypNil())
	}

	if e.Kind == ast.EXPR_IDENT {
		var ptr @Instr = lookupVar(ctx, e.Name)
		if ptr != nil {
			var typ @types.Type = lookupVarType(ctx, e.Name)
			return b.EmitLoad(ptr, typ)
		}
		// Check module-level constants
		var cval int
		var ctyp @types.Type
		var cfound bool
		cval, ctyp, cfound = lookupConst(e.Name)
		if cfound {
			if ctyp == nil {
				ctyp = types.TypUntypedInt()
			}
			return b.EmitConstInt(cval, ctyp)
		}
		// Unknown ident — return a zero placeholder
		return b.EmitConstInt(0, types.TypInt())
	}

	if e.Kind == ast.EXPR_BINARY {
		return genBinary(ctx, b, e)
	}

	if e.Kind == ast.EXPR_UNARY {
		return genUnary(ctx, b, e)
	}

	if e.Kind == ast.EXPR_CALL {
		return genCall(ctx, b, e)
	}

	if e.Kind == ast.EXPR_BUILTIN {
		return genBuiltin(ctx, b, e)
	}

	if e.Kind == ast.EXPR_SELECTOR {
		return genSelector(ctx, b, e)
	}

	if e.Kind == ast.EXPR_COMPOSITE {
		return genCompositeLit(ctx, b, e)
	}

	if e.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
		return genIndex(ctx, b, e, true)  // checked
	}

	if e.Kind == ast.EXPR_SLICE {
		return genSliceExpr(ctx, b, e)
	}

	if e.Kind == ast.EXPR_FUNC_LIT {
		return genFuncLit(ctx, b, e)
	}

	// Unsupported expression
	return b.EmitConstInt(0, types.TypInt())
}

// genBinary generates IR for a binary expression, with short-circuit for && and ||.
func genBinary(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	// Phase A4 of plan-ir-gen-typed-literals.md: if BOTH operands
	// are EXPR_INT_LIT and the type checker folded this binop to
	// a literal value, emit a single OP_CONST_INT for the folded
	// value and skip the binop IR.  Restricted to direct
	// literals because the type checker's HasLitVal can land on
	// a binop whose operand is an EXPR_IDENT referencing a
	// typed-const (e.g. `keyword_start + 1` in pkg/token) — in
	// that case LitMag reflects only the untyped operand's value,
	// not the typed const's underlying iota.  Detecting that
	// upstream would require fixing the type-checker's const-
	// value tracking; restricting A4 to direct literals avoids
	// the issue while still folding the common cases (e.g.
	// `2147483648 * 2`).
	//
	// Mirrors genExprInner's `ctx.CurBlock = b` pre-amble so
	// callers landing `b = ctx.CurBlock` after the call see the
	// same block they passed in.
	if currentChecker != nil && e.ResolvedTypeID != 0 &&
			e.X != nil && e.X.Kind == ast.EXPR_INT_LIT &&
			e.Y != nil && e.Y.Kind == ast.EXPR_INT_LIT {
		var t @types.Type = currentChecker.ExprType(e.ResolvedTypeID)
		if t != nil && t.HasLitVal &&
				t.Kind == types.TYP_UNTYPED_INT {
			ctx.CurBlock = b
			var v int = bignumToInt(t.LitMag, t.LitSign)
			if v < -2147483648 || v > 2147483647 {
				return b.EmitConstInt(v, types.TypInt64())
			}
			return b.EmitConstInt(v, types.TypUntypedInt())
		}
	}

	var op int = tokenToOp(e.Op)

	// Short-circuit evaluation for && and ||
	if op == OP_LAND {
		return genShortCircuitAnd(ctx, b, e)
	}
	if op == OP_LOR {
		return genShortCircuitOr(ctx, b, e)
	}

	var lhs @Instr = genExpr(ctx, b, e.X)
	b = ctx.CurBlock
	// Phase B of plan-ir-gen-typed-literals.md: when one operand
	// is a typed integer and the other is an integer literal,
	// emit the literal directly at the typed operand's type so
	// the binop result stays in that type (instead of widening
	// up to int64 via the literal's magnitude-promoted TypInt64).
	// This is what flips `x & 0xFFFFFFFF` (x: uint32) from a
	// uint32-widened-to-int64 binop into a clean uint32 binop —
	// the original ror32-mask bug from claude-todo.md.
	var rhs @Instr = genIntLitWithHint(ctx, b, e.Y, lhs.Typ)
	if rhs == nil {
		rhs = genExpr(ctx, b, e.Y)
	}
	b = ctx.CurBlock
	// Symmetric: if the RHS we got was a typed int and the LHS
	// was an untyped literal we've already generated, redo the
	// LHS with the RHS's type as the hint.  The double-pass is
	// regrettable; the cleaner shape would pass hints through
	// genExpr itself, but that's a wider refactor.
	if e.X != nil && e.X.Kind == ast.EXPR_INT_LIT &&
			lhs.Typ != nil &&
			(lhs.Typ.Kind == types.TYP_UNTYPED_INT ||
				lhs.Typ == types.TypInt64()) {
		var narrowed @Instr = genIntLitWithHint(ctx, b, e.X, rhs.Typ)
		if narrowed != nil {
			lhs = narrowed
		}
	}

	// Determine the wider type for mixed-width arithmetic (e.g., char + int)
	var resultTyp @types.Type = widenType(lhs.Typ, rhs.Typ)
	lhs = ensureWidth(ctx, b, lhs, resultTyp)
	rhs = ensureWidth(ctx, b, rhs, resultTyp)

	// Comparison ops return bool
	if op >= OP_EQ {
		if op <= OP_GE {
			return b.EmitBinop(op, lhs, rhs, types.TypBool())
		}
	}

	return b.EmitBinop(op, lhs, rhs, resultTyp)
}

// genShortCircuitAnd implements short-circuit evaluation for a && b:
// Allocates a result bool (default false), evaluates LHS. If LHS is true,
// evaluates RHS and stores result. Otherwise skips RHS (result stays false).
func genShortCircuitAnd(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	// Alloca for result in current block, default false
	var resultPtr @Instr = b.EmitAlloc(types.TypBool())
	b.EmitStore(resultPtr, b.EmitConstBool(false))

	// Evaluate LHS — clean up any managed temps before branching
	var savedTemps int = len(ctx.Temps)
	var lhs @Instr = genExpr(ctx, b, e.X)
	b = ctx.CurBlock // LHS might have changed block (nested short-circuit)
	b = emitTempCleanupSince(ctx, b, savedTemps)

	// Create RHS and merge blocks
	var rhsBlk @Block = AddBlock(ctx.Func, "land.rhs")
	var mergeBlk @Block = AddBlock(ctx.Func, "land.merge")

	// Branch: if LHS true → evaluate RHS, else → merge (result is false)
	b.EmitBranch(lhs, rhsBlk, mergeBlk)

	// RHS block: evaluate RHS, clean up temps, store to result, jump to merge
	var savedTemps2 int = len(ctx.Temps)
	var rhs @Instr = genExpr(ctx, rhsBlk, e.Y)
	rhsBlk = ctx.CurBlock // RHS might have changed block
	rhsBlk = emitTempCleanupSince(ctx, rhsBlk, savedTemps2)
	rhsBlk.EmitStore(resultPtr, rhs)
	rhsBlk.EmitJump(mergeBlk)

	// Merge block: load result
	ctx.CurBlock = mergeBlk
	return mergeBlk.EmitLoad(resultPtr, types.TypBool())
}

// genShortCircuitOr implements short-circuit evaluation for a || b:
// Allocates a result bool (default true), evaluates LHS. If LHS is false,
// evaluates RHS and stores result. Otherwise skips RHS (result stays true).
func genShortCircuitOr(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	// Alloca for result in current block, default true
	var resultPtr @Instr = b.EmitAlloc(types.TypBool())
	b.EmitStore(resultPtr, b.EmitConstBool(true))

	// Evaluate LHS — clean up any managed temps before branching
	var savedTemps int = len(ctx.Temps)
	var lhs @Instr = genExpr(ctx, b, e.X)
	b = ctx.CurBlock
	b = emitTempCleanupSince(ctx, b, savedTemps)

	// Create RHS and merge blocks
	var rhsBlk @Block = AddBlock(ctx.Func, "lor.rhs")
	var mergeBlk @Block = AddBlock(ctx.Func, "lor.merge")

	// Branch: if LHS true → merge (result is true), else → evaluate RHS
	b.EmitBranch(lhs, mergeBlk, rhsBlk)

	// RHS block: evaluate RHS, clean up temps, store to result, jump to merge
	var savedTemps2 int = len(ctx.Temps)
	var rhs @Instr = genExpr(ctx, rhsBlk, e.Y)
	rhsBlk = ctx.CurBlock
	rhsBlk = emitTempCleanupSince(ctx, rhsBlk, savedTemps2)
	rhsBlk.EmitStore(resultPtr, rhs)
	rhsBlk.EmitJump(mergeBlk)

	// Merge block: load result
	ctx.CurBlock = mergeBlk
	return mergeBlk.EmitLoad(resultPtr, types.TypBool())
}

// widenType returns the wider of two integer types (or int as default)
func widenType(a @types.Type, b @types.Type) @types.Type {
	// If both are bool, keep bool
	if a != nil && a.Kind == types.TYP_BOOL && b != nil && b.Kind == types.TYP_BOOL {
		return types.TypBool()
	}
	// Untyped int adopts the other operand's type.
	// If both are untyped, default to int.
	var aUntyped bool = a != nil && a.Kind == types.TYP_UNTYPED_INT
	var bUntyped bool = b != nil && b.Kind == types.TYP_UNTYPED_INT
	if aUntyped && bUntyped {
		return types.TypUntypedInt()
	}
	if aUntyped && b != nil && b.IsInteger() {
		return b
	}
	if bUntyped && a != nil && a.IsInteger() {
		return a
	}
	var aw int = typeWidth(a)
	var bw int = typeWidth(b)
	if aw >= bw {
		if a != nil && a.Kind == types.TYP_INT { return a }
		if aw == bw && a != nil { return a }
		return types.TypInt()
	}
	if b != nil && b.Kind == types.TYP_INT { return b }
	if b != nil { return b }
	return types.TypInt()
}

// typeWidth returns the bit width of a type for IR-level width
// comparisons.  Must agree with codegen's llvmType for the same
// type — under --target arm32-linux or arm32-baremetal,
// `int` and untyped-int both lower to i32 (4 bytes), so they must
// report 32 here.  Earlier the fallback for nil / Width=0 was a
// hardcoded 64, which silently dropped ensureWidth casts when an
// untyped-int operand met a 32-bit `int` on arm32 — the resulting
// IR then had two operands of mismatched LLVM widths.
func typeWidth(t @types.Type) int {
	var targetIntBits int = types.GetTarget().IntSize * 8
	if t == nil { return targetIntBits }
	if t.Kind == types.TYP_BOOL || t.Kind == types.TYP_UNTYPED_BOOL { return 1 }
	if t.Kind == types.TYP_UNTYPED_FLOAT { return 64 }
	if t.Kind == types.TYP_FLOAT {
		if t.Width > 0 { return t.Width }
		return 64
	}
	if t.Width > 0 { return t.Width }
	return targetIntBits
}

// ensureWidth casts val to targetTyp if their widths differ
func ensureWidth(ctx @GenContext, b @Block, val @Instr, targetTyp @types.Type) @Instr {
	var valW int = typeWidth(val.Typ)
	var targetW int = typeWidth(targetTyp)
	if valW == targetW { return val }
	return b.EmitCast(val, targetTyp)
}

// genUnary generates IR for unary expressions (&, *, -, !, ~).
func genUnary(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	// Address-of: &x returns the alloca pointer directly
	if e.Op == cast(int, token.AMP) {
		if e.X.Kind == ast.EXPR_IDENT {
			var ptr @Instr = lookupVar(ctx, e.X.Name)
			if ptr != nil {
				return ptr
			}
		}
		// &arr[i]: return pointer to element (GEP, not loaded value)
		if e.X.Kind == ast.EXPR_INSTANTIATE_OR_INDEX {
			var ptr @Instr = genIndexPtr(ctx, b, e.X)
			if ptr != nil {
				return ptr
			}
		}
		// &s.field / &p.field / &globalStruct.field: delegate to
		// genSelectorPtr, which already covers value structs,
		// managed-ptr-to-struct, raw-ptr-to-struct, and indexed
		// element struct fields. Returns the field pointer (a
		// GEP), NOT the loaded field value.
		if e.X.Kind == ast.EXPR_SELECTOR {
			var ptr @Instr = genSelectorPtr(ctx, b, e.X)
			if ptr != nil {
				return ptr
			}
		}
		return genExpr(ctx, b, e.X)
	}
	// Dereference: *p loads the pointer value, then loads through it.
	// Handles raw and managed pointers identically at the IR-gen level
	// — the deref produces an rvalue of the pointed-to type either
	// way.  Refcount semantics for the @T case stay on the *operand*
	// (the @T variable still owns its ref); the deref is a value
	// load, not an ownership transfer.  Required so that iv-method
	// dispatch routes correctly through `(*p).Foo()` when p is
	// `@(*Iface)` / `@(@Iface)` — otherwise the load is sized as
	// `i64` and the receiver carries the wrong type, failing the
	// `iv.Typ.Elem == nil` guard in genInterfaceMethodCall.
	if e.Op == cast(int, token.STAR) {
		var ptrVal @Instr = genExpr(ctx, b, e.X)
		b = ctx.CurBlock
		// Determine pointed-to type from the pointer's type
		var elemTyp @types.Type = types.TypInt()
		if ptrVal.Typ != nil &&
				(ptrVal.Typ.Kind == types.TYP_POINTER ||
				 ptrVal.Typ.Kind == types.TYP_MANAGED_PTR) &&
				ptrVal.Typ.Elem != nil {
			elemTyp = ptrVal.Typ.Elem
		} else if e.X.Kind == ast.EXPR_IDENT {
			var varTyp @types.Type = lookupVarType(ctx, e.X.Name)
			if varTyp != nil &&
					(varTyp.Kind == types.TYP_POINTER ||
					 varTyp.Kind == types.TYP_MANAGED_PTR) &&
					varTyp.Elem != nil {
				elemTyp = varTyp.Elem
			}
		}
		return b.EmitLoad(ptrVal, elemTyp)
	}

	var arg @Instr = genExpr(ctx, b, e.X)
	b = ctx.CurBlock
	if e.Op == cast(int, token.MINUS) {
		// Preserve the operand's numeric type so the backend can pick
		// between integer and floating-point negation.  int64 also
		// passes through verbatim so 32-bit targets don't truncate
		// (e.g. -9223372036854775808 lowered against i32 silently
		// turns into 0 — see emitPrintInt and conformance 423).
		var negTyp @types.Type = types.TypInt()
		if arg.Typ != nil && arg.Typ.IsFloat() {
			negTyp = arg.Typ
		} else if arg.Typ != nil && arg.Typ.Kind == types.TYP_INT &&
				arg.Typ.Width == 64 {
			negTyp = arg.Typ
		}
		return b.EmitUnary(OP_NEG, arg, negTyp)
	}
	if e.Op == cast(int, token.NOT) {
		return b.EmitUnary(OP_NOT, arg, types.TypBool())
	}
	if e.Op == cast(int, token.TILDE) {
		return b.EmitUnary(OP_BITNOT, arg, types.TypInt())
	}
	return arg
}
// genBuiltin generates IR for builtin keyword expressions
// (cast, bit_cast, len, make, make_slice, box).
func genBuiltin(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	if e.Op == cast(int, token.CAST) || e.Op == cast(int, token.BIT_CAST) {
		if len(e.Args) >= 1 {
			var val @Instr = genExpr(ctx, b, e.Args[0])
			b = ctx.CurBlock
			var targetTyp @types.Type = resolveTypeExpr(e.TypeRef)
			if e.Op == cast(int, token.CAST) {
				return b.EmitCast(val, targetTyp)
			}
			return b.EmitBitCast(val, targetTyp)
		}
	}
	if e.Op == cast(int, token.LEN) {
		if len(e.Args) >= 1 {
			var arg @Instr = genExpr(ctx, b, e.Args[0])
			b = ctx.CurBlock
			// For arrays, len is a compile-time constant
			if arg.Typ != nil && arg.Typ.Kind == types.TYP_ARRAY {
				return b.EmitConstInt(arg.Typ.ArrayLen, types.TypInt())
			}
			return b.EmitSliceLen(arg)
		}
	}
	if e.Op == cast(int, token.UNSAFE_INDEX) {
		// unsafe_index(coll, idx): same lowering as coll[idx] but with
		// the bounds check skipped. Synthesize an EXPR_INSTANTIATE_OR_INDEX
		// node and call genIndex with checked=false.
		var proxy @ast.Expr = make(ast.Expr)
		proxy.Kind = ast.EXPR_INSTANTIATE_OR_INDEX
		proxy.Pos = e.Pos
		proxy.X = e.Args[0]
		var idxArgs @[]@ast.Expr = make_slice(@ast.Expr, 1)
		idxArgs[0] = e.Args[1]
		proxy.Args = idxArgs
		return genIndex(ctx, b, proxy, false)  // unchecked
	}
	if e.Op == cast(int, token.SIZEOF) {
		// Compile-time constant: the type's size in bytes. Returns
		// a uint-typed constant.
		var targetTyp @types.Type = resolveTypeExpr(e.TypeRef)
		return b.EmitConstInt(targetTyp.SizeOf(), types.TypUint())
	}
	if e.Op == cast(int, token.ALIGNOF) {
		// Compile-time constant: the type's alignment in bytes.
		var targetTyp @types.Type = resolveTypeExpr(e.TypeRef)
		return b.EmitConstInt(targetTyp.AlignOf(), types.TypUint())
	}
	if e.Op == cast(int, token.RAW_FUNC_ADDR) {
		// _raw_func_addr(F) (to be renamed _func_handle): emit
		// OP_FUNC_HANDLE.  Result is a *uint8 pointing at a
		// 16-byte {vtable_ptr, data_ptr} handle (the bnc-emitted
		// static `@__handle.F` natively, or a heap handle in
		// bytecode for vm-local functions).  Phase 4 of
		// plan-uniform-native-fnptrs.md.
		if len(e.Args) >= 1 {
			var arg @ast.Expr = e.Args[0]
			var name @[]char
			if arg.Kind == ast.EXPR_IDENT {
				name = arg.Name
			}
			if arg.Kind == ast.EXPR_SELECTOR &&
				arg.X != nil &&
				arg.X.Kind == ast.EXPR_IDENT {
				name = buildQualName(arg.X.Name, arg.Name)
			}
			return b.EmitFuncHandle(name)
		}
	}
	if e.Op == cast(int, token.MAKE) {
		// make(T) — allocate @T for any type T
		var targetTyp @types.Type = resolveTypeExpr(e.TypeRef)
		var result @Instr = b.EmitMake(targetTyp)
		registerTemp(ctx, result)
		return result
	}
	if e.Op == cast(int, token.MAKE_SLICE) {
		// make_slice(T, n) — T is element type, n is size. Returns @[]T (managed-slice).
		var elemTyp @types.Type = resolveTypeExpr(e.TypeRef)
		var length @Instr = genExpr(ctx, b, e.Args[0])
		b = ctx.CurBlock
		var result @Instr = b.EmitMakeSlice(elemTyp, length)
		registerTemp(ctx, result)
		noteSPGrowingResult(ctx, result)
		return result
	}
	if e.Op == cast(int, token.BOX) {
		if len(e.Args) >= 1 {
			var val @Instr = genExpr(ctx, b, e.Args[0])
			b = ctx.CurBlock
			// For alloca results, the elem type is in TypeArg (not the pointer type in Typ)
			var innerTyp @types.Type = val.Typ
			if val.Op == OP_ALLOC && val.TypeArg != nil {
				innerTyp = val.TypeArg
			}
			var ptrTyp @types.Type = types.MakeManagedPtrType(innerTyp)
			var result @Instr = b.EmitBox(val, ptrTyp)
			registerTemp(ctx, result)
			return result
		}
	}
	return b.EmitConstInt(0, types.TypInt())
}
