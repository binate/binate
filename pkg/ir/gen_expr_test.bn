package "pkg/ir"

import "pkg/ast"
import "pkg/bootstrap"
import "pkg/buf"
import "pkg/builtin/testing"
import "pkg/parser"
import "pkg/types"

func TestGenArithmetic() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func main() { println(2 + 3) }\n")
	var m @Module = genFromSource(cb.Bytes())
	var entry @Block = m.Funcs[0].Blocks[0]
	// Should have: const 2, const 3, add, then the
	// bootstrap.formatInt + bootstrap.Write scaffolding for the
	// int print, then bootstrap.Write of "\n", const_nil, return.
	// We only check that the add fires; surrounding shape is
	// validated by the conformance suite's println tests.
	var foundAdd bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == OP_ADD { foundAdd = true }
	}
	if !foundAdd { return fail("no add instruction found") }
	return ""
}

// A float literal lowers to OP_CONST_FLOAT with the raw literal text
// preserved in StrVal.
func TestGenFloatLit() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func main() { var x float64 = 3.14; _ = x }\n")
	var m @Module = genFromSource(cb.Bytes())
	var entry @Block = m.Funcs[0].Blocks[0]
	var foundFloat bool = false
	var txt @[]char
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == OP_CONST_FLOAT {
			foundFloat = true
			txt = entry.Instrs[i].StrVal
		}
	}
	if !foundFloat { return fail("no OP_CONST_FLOAT instruction found") }
	if !charEq(txt, "3.14") {
		return fail("OP_CONST_FLOAT StrVal should be the raw literal '3.14'")
	}
	return ""
}

// sizeof(T) lowers to OP_CONST_INT with T's byte size.
func TestGenSizeofInt() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func main() {\n")
	cb = buf.WriteStr(cb, "  var s uint = sizeof(int)\n")
	cb = buf.WriteStr(cb, "  _ = s\n")
	cb = buf.WriteStr(cb, "}\n")
	var m @Module = genFromSource(cb.Bytes())
	var entry @Block = m.Funcs[0].Blocks[0]
	// Expect an OP_CONST_INT 8 (int is 64-bit on the default target).
	var found bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @Instr = entry.Instrs[i]
		if ins.Op == OP_CONST_INT && ins.IntVal == 8 { found = true }
	}
	if !found { return fail("expected OP_CONST_INT 8 for sizeof(int)") }
	return ""
}

// alignof(bool) = 1 (bool is 1 byte, aligned to 1).
func TestGenAlignofBool() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func main() {\n")
	cb = buf.WriteStr(cb, "  var a uint = alignof(bool)\n")
	cb = buf.WriteStr(cb, "  _ = a\n")
	cb = buf.WriteStr(cb, "}\n")
	var m @Module = genFromSource(cb.Bytes())
	var entry @Block = m.Funcs[0].Blocks[0]
	var found bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @Instr = entry.Instrs[i]
		if ins.Op == OP_CONST_INT && ins.IntVal == 1 { found = true }
	}
	if !found { return fail("expected OP_CONST_INT 1 for alignof(bool)") }
	return ""
}

// sizeof of a raw slice = 2 words = 16 bytes on a 64-bit target.
func TestGenSizeofSlice() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func main() {\n")
	cb = buf.WriteStr(cb, "  var s uint = sizeof(*[]int)\n")
	cb = buf.WriteStr(cb, "  _ = s\n")
	cb = buf.WriteStr(cb, "}\n")
	var m @Module = genFromSource(cb.Bytes())
	var entry @Block = m.Funcs[0].Blocks[0]
	var found bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @Instr = entry.Instrs[i]
		if ins.Op == OP_CONST_INT && ins.IntVal == 16 { found = true }
	}
	if !found { return fail("expected OP_CONST_INT 16 for sizeof(*[]int)") }
	return ""
}

// println(floatExpr) dispatches through bootstrap.formatFloat
// (NOT through any bn_print_float — that shim is gone). Untyped
// float literals and float32 values are widened to float64 first
// (the callee takes a float64 directly).
func TestGenPrintFloat() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func main() { println(3.14) }\n")
	var m @Module = genFromSource(cb.Bytes())
	var entry @Block = m.Funcs[0].Blocks[0]
	var foundFormatFloat bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @Instr = entry.Instrs[i]
		if ins.Op == OP_CALL && charEq(ins.StrVal, "bootstrap.formatFloat") {
			foundFormatFloat = true
		}
	}
	if !foundFormatFloat {
		return fail("expected OP_CALL 'bootstrap.formatFloat'")
	}
	return ""
}

// Float arithmetic produces OP_ADD on float-typed operands. The
// existing OP_ADD dispatch is reused — backends look at the operand
// type to decide between integer and floating-point ops.
func TestGenFloatArith() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func main() {\n")
	cb = buf.WriteStr(cb, "  var x float64 = 1.5 + 2.5\n")
	cb = buf.WriteStr(cb, "  _ = x\n")
	cb = buf.WriteStr(cb, "}\n")
	var m @Module = genFromSource(cb.Bytes())
	var entry @Block = m.Funcs[0].Blocks[0]
	var foundFloatAdd bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		var ins @Instr = entry.Instrs[i]
		if ins.Op == OP_ADD && ins.Typ != nil &&
				(ins.Typ.Kind == types.TYP_FLOAT ||
				 ins.Typ.Kind == types.TYP_UNTYPED_FLOAT) {
			foundFloatAdd = true
		}
	}
	if !foundFloatAdd {
		return fail("no float-typed OP_ADD found")
	}
	return ""
}

func TestGenConstIota() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\nconst (\n")
	cb = buf.WriteStr(cb, "\tA int = iota\n\tB\n\tC\n)\n")
	cb = buf.WriteStr(cb, "func main() {")
	cb = buf.WriteStr(cb, " println(A); println(B); println(C) }\n")
	var m @Module = genFromSource(cb.Bytes())
	var entry @Block = m.Funcs[0].Blocks[0]
	// iota should emit A=0, B=1, C=2 as OP_CONST_INT. Check that
	// those three values each appear in the const-int stream.
	// Note: the print/println builtin's IR-gen lowering also emits
	// internal OP_CONST_INTs (stdout fd, buffer length) per call,
	// so we can't rely on positional indexing here — just verify
	// each iota value appears at least once.
	var saw0 bool = false
	var saw1 bool = false
	var saw2 bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op != OP_CONST_INT { continue }
		var v int = entry.Instrs[i].IntVal
		if v == 0 { saw0 = true }
		if v == 1 { saw1 = true }
		if v == 2 { saw2 = true }
	}
	if !saw0 { return fail("A=0 not emitted as const_int") }
	if !saw1 { return fail("B=1 not emitted as const_int") }
	if !saw2 { return fail("C=2 not emitted as const_int") }
	return ""
}

func TestSliceSetStringToChars() testing.TestResult {
	var src @[]char
	src = concatChars(src, "package \"main\"\nfunc main() {\n")
	src = concatChars(src, "  var ss @[]*[]const char = make_slice(*[]const char, 1)\n")
	src = concatChars(src, "  ss[0] = \"hello\"\n")
	src = concatChars(src, "  ss[0] = \"replaced\"\n")
	src = concatChars(src, "}\n")
	var m @Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("no funcs") }
	// The slice set of a string literal to a *[]const char element should emit string_to_chars
	// Slice set lowers to OP_STORE. Check that store exists.
	var found bool = false
	for i := 0; i < len(m.Funcs[0].Blocks); i++ {
		var b @Block = m.Funcs[0].Blocks[i]
		for j := 0; j < len(b.Instrs); j++ {
			if b.Instrs[j].Op == OP_STORE {
				found = true
			}
		}
	}
	if !found { return fail("no OP_STORE found for slice set") }
	// Phase 3.2: read-only string→*[]const char now lowers to
	// OP_RODATA_SLICE (not OP_STRING_TO_CHARS).
	var stcCount int = 0
	for i := 0; i < len(m.Funcs[0].Blocks); i++ {
		var b @Block = m.Funcs[0].Blocks[i]
		for j := 0; j < len(b.Instrs); j++ {
			if b.Instrs[j].Op == OP_RODATA_SLICE {
				stcCount = stcCount + 1
			}
		}
	}
	// Should have at least 2: one for ss[0] = "hello", one for ss[0] = "replaced"
	if stcCount < 2 { return fail("expected at least 2 OP_RODATA_SLICE") }
	return ""
}

func TestNilSliceArgCoercion() testing.TestResult {
	// Passing nil to a function expecting a slice parameter
	// should produce a nil instruction with slice type (not
	// TYP_NIL), so codegen emits %BnSlice zeroinitializer
	// instead of i8* null.
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func take(s *[]int, n int) int {")
	cb = buf.WriteStr(cb, " return n }\n")
	cb = buf.WriteStr(cb, "func main() { take(nil, 42) }\n")
	var src @[]char = cb.Bytes()
	var m @Module = genFromSource(src)
	if len(m.Funcs) < 2 {
		return fail(bootstrap.Concat(
			"expected 2 funcs, got ",
			bootstrap.Itoa(len(m.Funcs))))
	}
	// Find main function
	var mainFunc @Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "main") { mainFunc = m.Funcs[i] }
	}
	if mainFunc == nil { return fail("no main func") }
	// Find the OP_CALL instruction to "take" in main
	var callInstr @Instr = nil
	for i := 0; i < len(mainFunc.Blocks); i++ {
		var blk @Block = mainFunc.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op == OP_CALL && seq(instr.StrVal, "take") {
				callInstr = instr
			}
		}
	}
	if callInstr == nil { return fail("no call to take()") }
	// First arg should be nil with slice type, not TYP_NIL
	if len(callInstr.Args) < 2 {
		return fail(bootstrap.Concat(
			"expected 2 args, got ",
			bootstrap.Itoa(len(callInstr.Args))))
	}
	var nilArg @Instr = callInstr.Args[0]
	if nilArg.Op != OP_CONST_NIL { return fail("first arg should be OP_CONST_NIL") }
	if nilArg.Typ == nil { return fail("nil arg type is nil") }
	if nilArg.Typ.Kind == types.TYP_NIL {
		return fail("nil arg should have slice type, not TYP_NIL")
	}
	if nilArg.Typ.Kind != types.TYP_SLICE {
		return fail(bootstrap.Concat(
			"nil arg should be TYP_SLICE, got kind ",
			bootstrap.Itoa(nilArg.Typ.Kind)))
	}
	return ""
}
