package "pkg/ir"

import "pkg/ast"
import "pkg/buf"
import "pkg/types"

// IR generation for function literals (Slice A.7.b of
// plan-function-values.md). The literal is lifted to a synthetic
// top-level function in the current Module; the literal's expression
// position emits OP_FUNC_VALUE pointing at the lifted name.
//
// Phase 1 restriction: literals must NOT capture enclosing-scope
// locals — enforced at type-check time by checkFuncLit. Here we just
// generate code; if a capture slipped through (a type-checker bug)
// the lookup would fail at IR-gen producing a zero placeholder, but
// well-typed input never reaches that branch.

// resetFuncLitState resets the per-package function-literal state at
// the start of a GeneratePackage / GenModule call. The Module handle
// is captured so genFuncLit can register lifted functions, and the
// counter is reset so each package gets its own `__funclit_<n>` ids.
func resetFuncLitState(m @Module) {
	currentModule = m
	funcLitCounter = 0
}

// genFuncLit lifts a function literal to a synthetic top-level
// function and returns an OP_FUNC_VALUE pointing at it.
func genFuncLit(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	var d @ast.Decl = e.DeclRef
	if d == nil {
		// Type-checker should have rejected, but be defensive.
		return b.EmitConstInt(0, types.TypInt())
	}

	// Allocate a fresh synthetic name. Counter is per-package; the
	// `__funclit_` prefix makes lifted names easy to spot in IR /
	// disassembly. NewFunc qualifies it with the package short name
	// (e.g. `main.__funclit_0`).
	var n int = funcLitCounter
	funcLitCounter = funcLitCounter + 1
	d.Name = synthFuncLitName(n)

	// Register the FuncSig in moduleFuncs so any later call-site
	// lookups (lookupFuncExists / lookupFuncParams / lookupFuncResults)
	// resolve the synthetic name. Also pre-builds the qualified form
	// that EmitFuncValue will key off.
	registerLiftedFuncSig(d)

	// Generate the function and add it to the current Module.
	var f @Func = genFunc(d)
	if currentModule != nil {
		currentModule.AddFunc(f)
	}

	// Compute the function-value type. Phase 1 always raw form
	// (`*func(...)`) — managed-form literals would imply a heap
	// allocation we don't yet do. The user's binding site declares
	// the actual destination type; AssignableTo handles raw → managed
	// when needed, same as for plain function references.
	var fnValTyp @types.Type = funcValueTypeFromDecl(d)

	// EmitFuncValue calls qualifyForCurrentModule on the name, so
	// pass the bare synthetic form here.
	var fv @Instr = b.EmitFuncValue(d.Name, fnValTyp)
	noteSPGrowingResult(ctx, fv)
	return fv
}

// synthFuncLitName builds the bare synthetic name for the n-th
// function literal in the current package: `__funclit_<n>`.
func synthFuncLitName(n int) @[]char {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("__funclit_")
	cb = cb.WriteStr(intToChars(n))
	return cb.Bytes()
}

// intToChars is a tiny ad-hoc int → decimal-chars converter (good
// enough for the small counter values we use here; avoids pulling
// in bootstrap.Itoa whose return type isn't right).
func intToChars(n int) @[]char {
	if n == 0 {
		var z @[]char = make_slice(uint8, 1)
		z[0] = cast(uint8, '0')
		return z
	}
	var digits @[]uint8 = make_slice(uint8, 0)
	for n > 0 {
		var d uint8 = cast(uint8, '0') + cast(uint8, n - (n / 10) * 10)
		digits = appendU8(digits, d)
		n = n / 10
	}
	// Reverse.
	var out @[]char = make_slice(uint8, len(digits))
	for i := 0; i < len(digits); i++ {
		out[i] = digits[len(digits) - 1 - i]
	}
	return out
}

// appendU8 appends a byte to a managed slice.
func appendU8(s @[]uint8, v uint8) @[]uint8 {
	var n int = len(s)
	var out @[]uint8 = make_slice(uint8, n + 1)
	for i := 0; i < n; i++ { out[i] = s[i] }
	out[n] = v
	return out
}

// registerLiftedFuncSig adds a FuncSig entry to moduleFuncs for the
// synthetic function so that subsequent call-site lookups resolve
// it. The same shape gen_module.bn uses for top-level decls.
func registerLiftedFuncSig(d @ast.Decl) {
	var sig FuncSig
	sig.Name = qualifyForCurrentModule(d.Name)
	var sigParams @[]@types.Type
	for j := 0; j < len(d.Params); j++ {
		sigParams = appendTypePtr(sigParams,
			resolveTypeExpr(d.Params[j].Type))
	}
	sig.Params = sigParams
	var sigResults @[]@types.Type
	for j := 0; j < len(d.Results); j++ {
		sigResults = appendTypePtr(sigResults,
			resolveTypeExpr(d.Results[j]))
	}
	sig.Results = sigResults
	if len(sigResults) > 1 {
		sig.MultiReturnType = makeMultiReturnStructType(sigResults)
	}
	moduleFuncs = appendFuncSig(moduleFuncs, sig)
}

// funcValueTypeFromDecl builds the *func(...) function-value type
// matching the literal's signature.
func funcValueTypeFromDecl(d @ast.Decl) @types.Type {
	var params @[]@types.Param = make_slice(@types.Param, len(d.Params))
	for i := 0; i < len(d.Params); i++ {
		var p @types.Param = make(types.Param)
		p.Name = d.Params[i].Name
		p.Type = resolveTypeExpr(d.Params[i].Type)
		params[i] = p
	}
	var results @[]@types.Type
	for i := 0; i < len(d.Results); i++ {
		results = appendTypePtr(results, resolveTypeExpr(d.Results[i]))
	}
	return types.MakeFuncValueType(params, results)
}
