package "pkg/ir"

import "pkg/ast"
import "pkg/buf"
import "pkg/token"
import "pkg/types"

// Generic-instantiation IR generation — Slice 4a of
// plan-generics.md.  Monomorphizes each unique `f[T1, T2, ...]`
// call site to a specialized IR func with the type-params
// substituted for concrete @types.Type instances.  Constraint-
// method dispatch inside the body is Slice 4b territory; this
// slice covers unconstrained `[T any]` generics where the body
// uses T purely as a value carrier.

// instantiationMangledName returns the unique IR-level name for
// a specific (generic_decl, type_args) instantiation.  Mangling
// scheme (Q2-style placeholder; can be canonicalized later):
//   `<original-qualified-name>__bn_inst__<arg1>_<arg2>...`
// Each `arg_i` is `mangleTypeArg(t)` — primitives use their
// type name, pointers prepend `ptr_`, etc.  Stable across
// repeated calls so cache lookups work.
func instantiationMangledName(d @ast.Decl, args @[]@types.Type) @[]char {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(qualifyForCurrentModule(d.Name))
	cb = cb.WriteStr("__bn_inst")
	for i := 0; i < len(args); i++ {
		cb = cb.WriteStr("__")
		cb = cb.WriteStr(mangleTypeArg(args[i]))
	}
	return cb.Bytes()
}

// mangleTypeArg produces a stable per-type token for use in the
// instantiation mangled name.  Slice 4a handles primitives,
// named types, and raw pointers; broader shapes (managed, slice,
// nested instantiations) land later as the surface grows.
func mangleTypeArg(t @types.Type) @[]char {
	if t == nil { return buf.CopyStr("nil") }
	if t.Kind == types.TYP_POINTER {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteStr("ptr_")
		cb = cb.WriteStr(mangleTypeArg(t.Elem))
		return cb.Bytes()
	}
	if t.Kind == types.TYP_MANAGED_PTR {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteStr("mptr_")
		cb = cb.WriteStr(mangleTypeArg(t.Elem))
		return cb.Bytes()
	}
	if t.Kind == types.TYP_SLICE {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteStr("slc_")
		cb = cb.WriteStr(mangleTypeArg(t.Elem))
		return cb.Bytes()
	}
	if t.Kind == types.TYP_MANAGED_SLICE {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteStr("mslc_")
		cb = cb.WriteStr(mangleTypeArg(t.Elem))
		return cb.Bytes()
	}
	// Default: use the type's printable name (primitives,
	// named structs, etc.).
	return buf.CopyStr(t.TypeName())
}

// ensureInstantiated emits the specialized IR func for `(d,
// args)` if it isn't already registered on m.  Returns the
// mangled name (which the call site uses as the call target).
func ensureInstantiated(m @Module, d @ast.Decl,
		args @[]@types.Type) @[]char {
	var name @[]char = instantiationMangledName(d, args)
	if instantiationAlreadyEmitted(name) {
		return name
	}
	emittedInstantiations = appendCharSlicePtr(emittedInstantiations, name)

	// Push type-param substitution context: walk the AST decl's
	// type-param list, snapshotting names and concrete types in
	// parallel so resolveTypeExpr's TEXPR_NAMED branch can replace
	// them while genFunc emits the body.
	var savedNames @[]@[]char = currentTypeParamNames
	var savedTypes @[]@types.Type = currentTypeParamTypes
	var newNames @[]@[]char
	var newTypes @[]@types.Type
	for i := 0; i < len(d.TypeParams); i++ {
		newNames = appendCharSlicePtr(newNames, d.TypeParams[i].Name)
		if i < len(args) {
			newTypes = appendTypePtr(newTypes, args[i])
		} else {
			newTypes = appendTypePtr(newTypes, types.TypVoid())
		}
	}
	currentTypeParamNames = newNames
	currentTypeParamTypes = newTypes

	// genFunc consumes d.Name for the func's own Name.  We need
	// the mangled name on the IR func instead, so build the func
	// from a synthetic Decl that shares everything with d except
	// Name (and TypeParams, which the IR layer no longer needs).
	var synth @ast.Decl = make(ast.Decl)
	synth.Kind = d.Kind
	synth.Pos = d.Pos
	synth.Name = stripCurrentModuleQualifier(name)
	synth.Recv = d.Recv
	synth.Params = d.Params
	synth.Results = d.Results
	synth.Body = d.Body
	synth.TypeRef = d.TypeRef
	synth.Value = d.Value
	synth.IsAlias = d.IsAlias

	var f @Func = genFunc(synth)
	m.AddFunc(f)
	// Append the generated func to moduleFuncs (signature
	// registry) so subsequent call sites can resolve it like any
	// other top-level function.
	var sig FuncSig
	sig.Name = qualifyForCurrentModule(synth.Name)
	sig.Params = typesOfParams(f.Params)
	sig.Results = f.Results
	if len(sig.Results) > 1 {
		sig.MultiReturnType = makeMultiReturnStructType(sig.Results)
	}
	moduleFuncs = appendFuncSig(moduleFuncs, sig)

	currentTypeParamNames = savedNames
	currentTypeParamTypes = savedTypes
	return name
}

// instantiationAlreadyEmitted reports whether `name` is already in
// the emittedInstantiations cache for the current module.
func instantiationAlreadyEmitted(name *[]const char) bool {
	for i := 0; i < len(emittedInstantiations); i++ {
		if streq(emittedInstantiations[i], name) { return true }
	}
	return false
}

// stripCurrentModuleQualifier removes the leading `<pkg>.`
// prefix that qualifyForCurrentModule prepends.  genFunc and
// downstream re-qualify, so the synthetic decl's Name must be
// the bare identifier piece.
func stripCurrentModuleQualifier(qual *[]const char) @[]char {
	for i := 0; i < len(qual); i++ {
		if qual[i] == '.' {
			return buf.CopyStr(qual[i+1:])
		}
	}
	return buf.CopyStr(qual)
}

// typesOfParams projects an @[]@Param slice to @[]@types.Type
// for the FuncSig.Params shape used during sig registration.
func typesOfParams(ps @[]@Param) @[]@types.Type {
	var out @[]@types.Type
	for i := 0; i < len(ps); i++ {
		out = appendTypePtr(out, ps[i].Typ)
	}
	return out
}

// typeArgExprToType converts a parsed-as-Expr type argument to the
// IR-layer @types.Type.  Mirrors typeArgFromExpr in the type
// checker, which the IR gen can't share because it has no
// Checker — instead we synthesize an ast.TypeExpr matching the
// expression's shape and feed it through the IR-gen
// resolveTypeExpr.  Accepts the same forms as Slice 2b's
// type-arg parsing: EXPR_IDENT and EXPR_UNARY(STAR, X).
func typeArgExprToType(e @ast.Expr) @types.Type {
	if e == nil { return types.TypVoid() }
	var te @ast.TypeExpr = exprToTypeExpr(e)
	if te == nil { return types.TypVoid() }
	return resolveTypeExpr(te)
}

// exprToTypeExpr synthesizes an ast.TypeExpr from an ast.Expr
// in the type-arg shape.  Returns nil for shapes the IR gen
// doesn't know how to interpret (the type checker rejected
// these in Slice 2b already; we mirror the same set).
func exprToTypeExpr(e @ast.Expr) @ast.TypeExpr {
	if e == nil { return nil }
	if e.Kind == ast.EXPR_IDENT {
		var te @ast.TypeExpr = make(ast.TypeExpr)
		te.Kind = ast.TEXPR_NAMED
		te.Pos = e.Pos
		te.Name = e.Name
		return te
	}
	if e.Kind == ast.EXPR_UNARY && e.Op == cast(int, token.STAR) {
		var inner @ast.TypeExpr = exprToTypeExpr(e.X)
		if inner == nil { return nil }
		var te @ast.TypeExpr = make(ast.TypeExpr)
		te.Kind = ast.TEXPR_POINTER
		te.Pos = e.Pos
		te.Base = inner
		return te
	}
	return nil
}

// lookupGenericDecl returns the generic AST decl registered under
// `name` in the current module, or nil if no such decl exists.
// Callers use this to decide whether an EXPR_INSTANTIATE_OR_INDEX
// at a call site is generic instantiation (route to
// genCallInstantiate) or plain value indexing (the existing
// non-generic dispatch).
func lookupGenericDecl(name *[]const char) @ast.Decl {
	for i := 0; i < len(genericDecls); i++ {
		if streq(genericDecls[i].Name, name) {
			return genericDecls[i]
		}
	}
	return nil
}

// genCallInstantiate handles the IR-gen for an EXPR_CALL whose
// callee is an EXPR_INSTANTIATE_OR_INDEX with a generic head
// (the Slice 2b type-checker validated this; here we emit code).
// Steps: convert the bracketed exprs to concrete @types.Type,
// ensure the specialized IR func is emitted, then emit a regular
// call to the mangled name.  Returns the call's @Instr (the
// loaded return value if any).
func genCallInstantiate(ctx @GenContext, b @Block, e @ast.Expr,
		d @ast.Decl) @Instr {
	var head @ast.Expr = e.X  // EXPR_INSTANTIATE_OR_INDEX
	var args @[]@types.Type
	for i := 0; i < len(head.Args); i++ {
		args = appendTypePtr(args, typeArgExprToType(head.Args[i]))
	}
	if currentModule == nil { return nil }
	var name @[]char = ensureInstantiated(currentModule, d, args)
	// Emit the user-args call.  We piggyback on the regular
	// direct-call machinery by synthesizing a callee Expr that
	// looks like a plain identifier with the mangled name.
	var fakeCallee @ast.Expr = make(ast.Expr)
	fakeCallee.Kind = ast.EXPR_IDENT
	fakeCallee.Pos = head.Pos
	fakeCallee.Name = name
	var newCall @ast.Expr = make(ast.Expr)
	newCall.Kind = ast.EXPR_CALL
	newCall.Pos = e.Pos
	newCall.X = fakeCallee
	newCall.Args = e.Args
	return genExpr(ctx, b, newCall)
}
