package "pkg/ir"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Tests for gen_iface.bn — IR-gen use-site behavior for interface
// values: dispatch (`iv.method(args)`), `*X` / `@X` resolution to
// interface-value types, and lifting `*T` / `@T` source values into
// `*Iface`. The collection-side tests (build-time interface
// registry + impl walking) live in gen_impl_test.bn. Helpers
// (genFromSource, genFromSourcePkg, fail) live in ir_test.bn.

// Slice 2.3a-2 IR shape: `var iv *I = &t` produces an OP_IFACE_VALUE
// instruction wrapping the source pointer with the impl's vtable
// global. Without this op the slot would be filled with a bare i8*
// rather than the 2-word {data, vtable} interface value.
func TestGenImplWrapEmitsIfaceValue() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"interface I { foo() }\n"
		"type T struct { x int }\n"
		"func (t *T) foo() { }\n"
		"impl *T : I\n"
		"func main() {\n"
		"\tvar t T\n"
		"\tvar iv *I = &t\n"
		"\t_ = iv\n"
		"}\n")
	var m @Module = genFromSourcePkg(cb.Bytes())
	var mainFn @Func = findFunc(m, "test.main")
	if mainFn == nil { return fail("test.main not found") }
	if countOp(mainFn, OP_IFACE_VALUE) < 1 {
		return fail(
			"expected OP_IFACE_VALUE for *Iface construction")
	}
	return ""
}

// Slice 2.3a-2 IR shape: an interface-name in `*X` / `@X` position
// resolves to TYP_INTERFACE_VALUE / TYP_INTERFACE_VALUE_MANAGED, not
// TYP_POINTER / TYP_MANAGED_PTR. The slot's LLVM type then comes
// out as `%BnIfaceValue` (16 bytes) rather than a single i8*.
func TestGenImplResolveStarIfaceType() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"interface I { foo() }\n"
		"type T struct { x int }\n"
		"func (t *T) foo() { }\n"
		"impl *T : I\n"
		"func main() {\n"
		"\tvar t T\n"
		"\tvar iv *I = &t\n"
		"\t_ = iv\n"
		"}\n")
	var m @Module = genFromSourcePkg(cb.Bytes())
	var mainFn @Func = findFunc(m, "test.main")
	if mainFn == nil { return fail("test.main not found") }
	// At least one alloca with TypeArg == TYP_INTERFACE_VALUE
	// (the iv slot). If resolveTypeExpr produced TYP_POINTER, this
	// search would fail.
	for i := 0; i < len(mainFn.Blocks); i++ {
		var blk @Block = mainFn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op == OP_ALLOC && instr.TypeArg != nil &&
				instr.TypeArg.Kind == types.TYP_INTERFACE_VALUE {
				return ""
			}
		}
	}
	return fail("no alloca with TYP_INTERFACE_VALUE element")
}

// Slice 2.3a-3 IR shape: `iv.foo()` lowers to OP_CALL_IFACE_METHOD
// with the iv as Args[0] and the slot index as Index. Without this
// op the dispatch would fall through to the regular method-call
// path, which doesn't know how to route through a vtable.
func TestGenImplDispatchEmitsCallIface() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"interface I { foo() }\n"
		"type T struct { x int }\n"
		"func (t *T) foo() { }\n"
		"impl *T : I\n"
		"func main() {\n"
		"\tvar t T\n"
		"\tvar iv *I = &t\n"
		"\tiv.foo()\n"
		"}\n")
	var m @Module = genFromSourcePkg(cb.Bytes())
	var mainFn @Func = findFunc(m, "test.main")
	if mainFn == nil { return fail("test.main not found") }
	if countOp(mainFn, OP_CALL_IFACE_METHOD) < 1 {
		return fail("expected OP_CALL_IFACE_METHOD for iv.foo()")
	}
	return ""
}

// Multi-method interface: each method gets the correct absolute
// vtable slot — slot 0 is the dtor (any-block), methods start at
// slot 1.  plan-interface-embedding.md Slice E.4 made
// findInterfaceMethod return the absolute slot (post-dtor) so
// codegen / VM can drop their `+1` adjustments.
func TestGenImplDispatchSlotIndices() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"interface AB { a() int; b() int }\n"
		"type T struct { x int }\n"
		"func (t *T) a() int { return 1 }\n"
		"func (t *T) b() int { return 2 }\n"
		"impl *T : AB\n"
		"func main() {\n"
		"\tvar t T\n"
		"\tvar iv *AB = &t\n"
		"\tvar _ int = iv.a()\n"
		"\tvar _ int = iv.b()\n"
		"}\n")
	var m @Module = genFromSourcePkg(cb.Bytes())
	var mainFn @Func = findFunc(m, "test.main")
	if mainFn == nil { return fail("test.main not found") }
	var sawA bool = false
	var sawB bool = false
	for i := 0; i < len(mainFn.Blocks); i++ {
		var blk @Block = mainFn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op != OP_CALL_IFACE_METHOD { continue }
			if instr.Index == 1 { sawA = true }
			if instr.Index == 2 { sawB = true }
		}
	}
	if !sawA { return fail("expected dispatch with slot 1 (a)") }
	if !sawB { return fail("expected dispatch with slot 2 (b)") }
	return ""
}

// findInterfaceMethod returns absolute vtable slot indices for
// inherited methods.  For `interface RC : Closer { Read() int }`
// where `Closer { Close() }`, the RC vtable layout (Slice E.3
// concat) is:
//   slot 0 = dtor (RC's any-block)
//   slot 1 = dtor (Closer's nested any-block)
//   slot 2 = Close (Closer's own method)
//   slot 3 = Read  (RC's own method)
// plan-interface-embedding.md Slice E.4 part 1.
func TestFindInterfaceMethodInherited() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"interface Closer { Close() }\n"
		"interface RC : Closer { Read() int }\n"
		"type F struct { x int }\n"
		"func (f *F) Close() { }\n"
		"func (f *F) Read() int { return 0 }\n"
		"impl *F : RC\n")
	// IR-gen populates moduleInterfaces as a side effect.
	var m @Module = genFromSourcePkg(cb.Bytes())
	if m == nil { return fail("genFromSourcePkg returned nil") }
	// Closer's own method at slot 1 (post-dtor).
	var closerSlot int
	var rt @types.Type
	closerSlot, rt = findInterfaceMethod("test", "Closer", "Close")
	if closerSlot != 1 {
		return fail("Closer.Close should be at slot 1")
	}
	// RC's inherited method lands at slot 2 of RC's vtable
	// (RC's any-block + Closer's nested any-block + Close).
	var inheritedSlot int
	inheritedSlot, rt = findInterfaceMethod("test", "RC", "Close")
	if inheritedSlot != 2 {
		return fail("RC.Close (inherited) should be at slot 2")
	}
	// RC's own method follows the inlined Closer vtable.
	var ownSlot int
	ownSlot, rt = findInterfaceMethod("test", "RC", "Read")
	if ownSlot != 3 {
		return fail("RC.Read (own) should be at slot 3")
	}
	// Unknown method returns -1.
	var missSlot int
	missSlot, rt = findInterfaceMethod("test", "RC", "nope")
	if missSlot != -1 {
		return fail("nonexistent method should return -1")
	}
	if rt == nil { return "" }  // rt always reassigned; pin it as used
	return ""
}

// `*X` where X is a struct (not an interface) keeps the regular
// pointer kind — the interface-aware arm only fires for declared
// interface names. Guards against an over-broad match.
func TestGenImplResolveStarStructStaysPointer() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type T struct { x int }\n"
		"func main() {\n"
		"\tvar t T\n"
		"\tvar p *T = &t\n"
		"\t_ = p\n"
		"}\n")
	var m @Module = genFromSourcePkg(cb.Bytes())
	var mainFn @Func = findFunc(m, "test.main")
	if mainFn == nil { return fail("test.main not found") }
	for i := 0; i < len(mainFn.Blocks); i++ {
		var blk @Block = mainFn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op == OP_ALLOC && instr.TypeArg != nil &&
				instr.TypeArg.Kind == types.TYP_INTERFACE_VALUE {
				return fail(
					"*T over a struct should NOT be TYP_INTERFACE_VALUE")
			}
		}
	}
	return ""
}
