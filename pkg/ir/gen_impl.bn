package "pkg/ir"

import "pkg/ast"
import "pkg/buf"
import "pkg/types"

// IR-gen for impl declarations: walks DECL_INTERFACE entries to
// build a module-local interface registry (name → ordered method-
// name list), then walks DECL_IMPL entries to construct an
// ImplInfo per (impl, interface) pair. ImplInfos go on m.Impls;
// codegen later emits a vtable global per entry. Slice 2.3a-1 of
// plan-interface-syntax-revision.md.

// ModuleInterface caches an interface's method-name list (in
// declaration order) so collectImplVtables can populate vtable
// slots without re-walking the interface's AST. Module-local
// because Slice 2.3a-1 only handles same-package impls; cross-
// package interface refs are deferred. MethodResults stores each
// method's single return type (TypVoid for void methods); used by
// genInterfaceMethodCall to type the dispatch result. Multi-return
// interface methods are deferred — len(Results) > 1 currently
// stores nil, which the dispatch path treats as void (caller
// already type-checked the call so no value is ever read).
type ModuleInterface struct {
	// Pkg: short package name where the interface is declared
	// ("main" / "greeter" / etc.). Cross-package references match
	// on (Pkg, Name); same-package references use Pkg = current
	// module's pkgShort. Slice 2.7 of plan-cross-package-
	// interfaces.md.
	Pkg           @[]char
	Name          @[]char
	MethodNames   @[]@[]char
	MethodResults @[]@types.Type
	// AliasTarget (Slice 2.4): for `interface X = Y` aliases,
	// holds the target interface's name. Lookups follow the
	// chain on read so dispatch + vtable lookup work uniformly
	// through either name. Empty for non-alias entries. For
	// cross-package alias targets, AliasTargetPkg names the
	// target's package; both fields together identify the
	// canonical underlying interface.
	AliasTarget    @[]char
	AliasTargetPkg @[]char
	// ParentPkgs / ParentNames (plan-interface-embedding.md Slice
	// E.3): parallel arrays naming each parent interface this one
	// extends, in declaration order. ParentPkgs[i] / ParentNames[i]
	// identify a single parent under the same (Pkg, Name) keying
	// used elsewhere. Empty for interfaces that don't extend.
	ParentPkgs  @[]@[]char
	ParentNames @[]@[]char
}

// moduleInterfaces is the per-module interface registry built up
// during GeneratePackage / GenModule's first pass. Indexed by name
// via lookupModuleInterface; reset by resetImplState between
// modules so test runs stay isolated.
var moduleInterfaces @[]ModuleInterface

// currentModule (declared in gen.bn) references the Module being
// generated. setCurrentModule below is a paired setter that runs
// during GeneratePackage / GenModule init alongside the impl-state
// reset, so IR-gen helpers (wrapAsIfaceValue, findImplVtableName)
// can walk m.Impls from any context without threading m through.

// resetImplState clears the per-compile impl-state side data
// (currentModule). moduleInterfaces is cleared by InitModule (Slice
// 2.7) so import-registered entries aren't wiped between
// RegisterImports and GeneratePackage.
func resetImplState() {
	currentModule = nil
}

// setCurrentModule records the Module being generated so IR-gen
// helpers (wrapAsIfaceValue, findImplVtableName) can walk m.Impls
// from context-light call sites.
func setCurrentModule(m @Module) {
	currentModule = m
}

// collectInterfaceFromDecl records a DECL_INTERFACE's method names
// (in source order — matches the slot ordering codegen uses for
// the vtable global). Alias forms (`interface X = Y`) record the
// target name only; methods are read via alias-following lookups
// (lookupModuleInterface / findInterfaceMethod). pkgShort is the
// short package name where this interface is declared; same-package
// (Slice 2.3a-1) callers pass currentModulePkgShort, RegisterImport
// (Slice 2.7) passes the import's alias.
func collectInterfaceFromDecl(d @ast.Decl, pkgShort *[]const char) {
	if d == nil || d.Kind != ast.DECL_INTERFACE {
		return
	}
	var mi ModuleInterface
	mi.Pkg = buf.CopyStr(pkgShort)
	mi.Name = buf.CopyStr(d.Name)
	if d.IsAlias {
		// Slice 2.4: interface alias. Target is a TEXPR_NAMED
		// produced by parseInterfaceRef; copy its Name into
		// AliasTarget so lookups can follow. For cross-package
		// alias targets (Slice 2.7), also store the target's
		// package; otherwise default to this interface's own
		// package (alias to a same-package iface).
		if d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_NAMED {
			mi.AliasTarget = buf.CopyStr(d.TypeRef.Name)
			if len(d.TypeRef.Pkg) > 0 {
				mi.AliasTargetPkg = buf.CopyStr(d.TypeRef.Pkg)
			} else {
				mi.AliasTargetPkg = buf.CopyStr(pkgShort)
			}
		}
		moduleInterfaces = appendModuleInterface(
			moduleInterfaces, mi)
		return
	}
	for i := 0; i < len(d.Decls); i++ {
		var m @ast.Decl = d.Decls[i]
		if m == nil || m.Kind != ast.DECL_FUNC {
			continue
		}
		mi.MethodNames = appendCharSlicePtr(mi.MethodNames,
			buf.CopyStr(m.Name))
		var resultTyp @types.Type = nil
		if len(m.Results) == 1 {
			resultTyp = resolveTypeExpr(m.Results[0])
		}
		mi.MethodResults = appendTypePtr(mi.MethodResults,
			resultTyp)
	}
	// plan-interface-embedding.md Slice E.3: record this
	// interface's parents (in declaration order).  Each parent ref
	// is a TEXPR_NAMED produced by parseInterfaceRef; the Pkg
	// field is populated for cross-package refs (`pkg.Parent`),
	// empty for same-package — default empty to pkgShort.
	for i := 0; i < len(d.Interfaces); i++ {
		var ref @ast.TypeExpr = d.Interfaces[i]
		if ref == nil || ref.Kind != ast.TEXPR_NAMED {
			continue
		}
		var parentPkg @[]char
		if len(ref.Pkg) > 0 {
			parentPkg = buf.CopyStr(ref.Pkg)
		} else {
			parentPkg = buf.CopyStr(pkgShort)
		}
		mi.ParentPkgs = appendCharSlicePtr(mi.ParentPkgs, parentPkg)
		mi.ParentNames = appendCharSlicePtr(mi.ParentNames,
			buf.CopyStr(ref.Name))
	}
	moduleInterfaces = appendModuleInterface(
		moduleInterfaces, mi)
}

// resolveModuleInterface returns the index in moduleInterfaces of
// the entry for (pkg, name), following any alias chain. Returns -1
// on not-found or cycle (defensive cap at 32 hops). Slice 2.7
// keys lookup on (Pkg, Name) so cross-package interface refs
// resolve to the imported package's entry without colliding with
// a same-named local interface.
func resolveModuleInterface(pkg *[]const char,
		name *[]const char) int {
	var found int = lookupModuleInterfaceIndex(pkg, name)
	if found < 0 { return -1 }
	var curPkg @[]char = buf.CopyStr(pkg)
	var curName @[]char = buf.CopyStr(name)
	for hop := 0; hop < 32; hop++ {
		var alias @[]char = moduleInterfaces[found].AliasTarget
		if len(alias) == 0 { return found }
		curPkg = moduleInterfaces[found].AliasTargetPkg
		curName = alias
		found = lookupModuleInterfaceIndex(curPkg, curName)
		if found < 0 { return -1 }
	}
	return -1
}

// canonicalIfaceName resolves an interface (pkg, name) through the
// alias chain and returns the chain tail's name. If the input
// doesn't refer to a registered interface, returns a fresh copy of
// the input name — at worst the symbol mangles on the impl-site
// reference. Slice 2.6 / 2.7.
func canonicalIfaceName(pkg *[]const char,
		name *[]const char) @[]char {
	var idx int = resolveModuleInterface(pkg, name)
	if idx < 0 {
		return buf.CopyStr(name)
	}
	return buf.CopyStr(moduleInterfaces[idx].Name)
}

// canonicalIfacePkg returns the canonical package short-name for
// the chain-tail of (pkg, name). Used by Slice 2.6's vtable
// mangling (`__ivt.bn_<recv_pkg>__<recv>__<iface_pkg>__<iface>`)
// to ensure aliases collapse to the underlying interface's
// package. If lookup fails, returns the input pkg unchanged.
func canonicalIfacePkg(pkg *[]const char,
		name *[]const char) @[]char {
	var idx int = resolveModuleInterface(pkg, name)
	if idx < 0 {
		return buf.CopyStr(pkg)
	}
	return buf.CopyStr(moduleInterfaces[idx].Pkg)
}

// lookupModuleInterfaceIndex returns the index of the entry in
// moduleInterfaces matching (pkg, name), or -1 if absent. No alias
// resolution.
func lookupModuleInterfaceIndex(pkg *[]const char,
		name *[]const char) int {
	for i := 0; i < len(moduleInterfaces); i++ {
		if !charEq(moduleInterfaces[i].Pkg, pkg) { continue }
		if !charEq(moduleInterfaces[i].Name, name) { continue }
		return i
	}
	return -1
}

// lookupModuleInterface returns the cached method-name list for the
// interface (pkg, name), or an empty slice if not found. Follows
// alias chains. Slice 2.7 keys lookup on (Pkg, Name).
func lookupModuleInterface(pkg *[]const char,
		name *[]const char) @[]@[]char {
	var idx int = resolveModuleInterface(pkg, name)
	if idx < 0 {
		var empty @[]@[]char
		return empty
	}
	return moduleInterfaces[idx].MethodNames
}

// IfaceMethodCount returns the number of methods declared on the
// interface identified by canonical (pkg, name), following alias
// chains. Returns 0 if the interface isn't registered. Used by
// codegen (Slice 2.8) to size the array type when declaring an
// imported vtable as `external constant [N+1 x i8*]`.
func IfaceMethodCount(pkg *[]const char,
		name *[]const char) int {
	return len(lookupModuleInterface(pkg, name))
}

// IfaceOwnMethodNames returns the OWN method names of the
// interface (pkg, name), in declaration order — the same list
// IR-gen records during DECL_INTERFACE collection.  Inherited
// methods are not included; walk parents (via IfaceParentPkgs /
// IfaceParentNames) for the full set.
func IfaceOwnMethodNames(pkg *[]const char,
		name *[]const char) @[]@[]char {
	return lookupModuleInterface(pkg, name)
}

// IfaceParentPkgs returns the canonical-pkg list of the interface
// (pkg, name)'s declared parents, in declaration order.  Empty if
// not registered or no parents.  plan-interface-embedding.md
// Slice E.3.
func IfaceParentPkgs(pkg *[]const char,
		name *[]const char) @[]@[]char {
	var idx int = resolveModuleInterface(pkg, name)
	if idx < 0 {
		var empty @[]@[]char
		return empty
	}
	return moduleInterfaces[idx].ParentPkgs
}

// IfaceParentNames is the companion to IfaceParentPkgs.
func IfaceParentNames(pkg *[]const char,
		name *[]const char) @[]@[]char {
	var idx int = resolveModuleInterface(pkg, name)
	if idx < 0 {
		var empty @[]@[]char
		return empty
	}
	return moduleInterfaces[idx].ParentNames
}

// IfaceFullVtableSize returns the total number of slots in a
// `(R, X)` vtable for the interface (pkg, name) under the concat
// layout from plan-interface-embedding.md:
//   size(X) = 1 (any-block: dtor slot)
//           + sum(size(P) for P in X.Parents)
//           + len(X's own methods)
// Returns 0 if the interface isn't registered (caller falls back).
func IfaceFullVtableSize(pkg *[]const char,
		name *[]const char) int {
	var idx int = resolveModuleInterface(pkg, name)
	if idx < 0 { return 0 }
	var n int = 1
	for i := 0; i < len(moduleInterfaces[idx].ParentPkgs); i++ {
		n = n + IfaceFullVtableSize(moduleInterfaces[idx].ParentPkgs[i],
			moduleInterfaces[idx].ParentNames[i])
	}
	n = n + len(moduleInterfaces[idx].MethodNames)
	return n
}

// IfaceAncestorClosure returns the deduped (pkg, name) pairs for
// every interface reachable from (pkg, name) via the Parents
// relation, EXCLUDING the interface itself.  Order is DFS preorder
// of parents (matches vtable nesting order so callers iterating
// the closure get a stable, predictable shape).
//
// `outPkgs` and `outNames` are parallel arrays.  Used by
// `collectImplsFromDecl` to register `(T, ancestor)` entries when
// the user writes `impl T : Child` — Slice E.3.
func IfaceAncestorClosure(pkg *[]const char,
		name *[]const char) @[]@[]char {
	var pkgs @[]@[]char
	var names @[]@[]char
	pkgs, names = appendAncestors(pkgs, names, pkg, name)
	return names
}

// IfaceAncestorClosurePkgs returns the parallel `pkgs` slice for
// the names returned by IfaceAncestorClosure (called with the
// same args).  Two functions instead of a tuple keeps signatures
// uniform; callers walk both arrays in lockstep.
func IfaceAncestorClosurePkgs(pkg *[]const char,
		name *[]const char) @[]@[]char {
	var pkgs @[]@[]char
	var names @[]@[]char
	pkgs, names = appendAncestors(pkgs, names, pkg, name)
	return pkgs
}

// appendAncestors walks the parents of (pkg, name) in DFS preorder
// and appends each to (pkgs, names), deduping by (pkg, name).  The
// starting interface itself is NOT added — only its ancestors.
func appendAncestors(pkgs @[]@[]char, names @[]@[]char,
		pkg *[]const char,
		name *[]const char) (@[]@[]char, @[]@[]char) {
	var idx int = resolveModuleInterface(pkg, name)
	if idx < 0 { return pkgs, names }
	for i := 0; i < len(moduleInterfaces[idx].ParentPkgs); i++ {
		var pPkg @[]char = moduleInterfaces[idx].ParentPkgs[i]
		var pName @[]char = moduleInterfaces[idx].ParentNames[i]
		// Resolve through alias chains so we record canonical
		// identity (the same identity the impl-table downstream
		// uses for (R, I) mangling).
		var canonPkg @[]char = canonicalIfacePkg(pPkg, pName)
		var canonName @[]char = canonicalIfaceName(pPkg, pName)
		if !containsPkgName(pkgs, names, canonPkg, canonName) {
			pkgs = appendCharSlicePtr(pkgs, canonPkg)
			names = appendCharSlicePtr(names, canonName)
		}
		// Recurse: add this parent's own ancestors.
		pkgs, names = appendAncestors(pkgs, names, canonPkg,
			canonName)
	}
	return pkgs, names
}

// containsPkgName reports whether (pkg, name) already appears in
// the parallel arrays (pkgs, names) — string-compare lookup.
func containsPkgName(pkgs @[]@[]char, names @[]@[]char,
		pkg *[]const char, name *[]const char) bool {
	for i := 0; i < len(pkgs); i++ {
		if charEq(pkgs[i], pkg) && charEq(names[i], name) {
			return true
		}
	}
	return false
}

// collectImplsFromDecl appends an ImplInfo to m.Impls for each
// `impl R : I1, I2, ...` interface in d, plus one ImplInfo per
// distinct ancestor of those interfaces (transitive registration
// per plan-interface-embedding.md Slice E.3 — `impl T : Child`
// also satisfies `Closer` if `Child : Closer`).  Each emitted
// ImplInfo holds the qualified method-func names for the OWN
// methods of its target interface; the recursive concat layout
// is assembled at codegen time by walking the parent chain.
//
// Receiver type-name is extracted via recvTypeName (the same
// helper genMethod uses).  The impl declaration itself lives in
// the current package (`pkgShort`); either or both of the
// receiver and the interface may live in different packages
// (Slices 2.7 / 2.9), reflected in RecvPkg / IfacePkg on the
// resulting ImplInfo.  RecvPkg drives the canonical vtable
// mangling AND the qualified function names emitted into
// MethodFuncs (so dispatch resolves through the receiver's
// defining package's symbols regardless of where the impl was
// declared).
func collectImplsFromDecl(d @ast.Decl, pkgShort *[]const char,
		m @Module) {
	if d == nil || d.Kind != ast.DECL_IMPL {
		return
	}
	var recvName @[]char = recvTypeName(d.TypeRef)
	if len(recvName) == 0 {
		return
	}
	// Slice 2.9: derive the receiver's defining package. For a
	// qualified receiver (`impl *hello.Hello : ...`) the AST carries
	// ref.Pkg; for a same-package receiver (`impl *Hello : ...`)
	// default to the impl declaration's package.
	var recvPkg @[]char = recvTypePkg(d.TypeRef)
	if len(recvPkg) == 0 {
		recvPkg = buf.CopyStr(pkgShort)
	}
	var dtorName @[]char = implDtorFuncName(recvPkg, recvName)

	// Walk each listed interface plus its ancestor closure,
	// deduping by canonical (Pkg, Name) so an interface listed
	// twice (e.g. `impl T : Child, Parent` where Parent is
	// reachable from Child) is registered once.
	var seenPkgs @[]@[]char
	var seenNames @[]@[]char
	for i := 0; i < len(d.Interfaces); i++ {
		var ref @ast.TypeExpr = d.Interfaces[i]
		if ref == nil || ref.Kind != ast.TEXPR_NAMED {
			continue
		}
		// Slice 2.7: an `impl R : pkg.Iface` (cross-package
		// interface) carries ref.Pkg; impl declarations on a
		// same-package interface have ref.Pkg empty and default
		// to the impl's own package.
		var refIfacePkg @[]char
		if len(ref.Pkg) > 0 {
			refIfacePkg = buf.CopyStr(ref.Pkg)
		} else {
			refIfacePkg = buf.CopyStr(pkgShort)
		}
		// Resolve aliases to canonical identity before recording
		// or chasing parents — the impl-table is keyed on the
		// canonical form, and dispatch / codegen agree on that.
		var canonPkg @[]char = canonicalIfacePkg(refIfacePkg,
			ref.Name)
		var canonName @[]char = canonicalIfaceName(refIfacePkg,
			ref.Name)

		// The listed interface itself.
		if !containsPkgName(seenPkgs, seenNames, canonPkg, canonName) {
			seenPkgs = appendCharSlicePtr(seenPkgs, canonPkg)
			seenNames = appendCharSlicePtr(seenNames, canonName)
			m.Impls = appendImplInfo(m.Impls,
				makeOwnMethodsImplInfo(recvPkg, recvName, dtorName,
					canonPkg, canonName))
		}
		// Each ancestor of the listed interface.
		var aPkgs @[]@[]char = IfaceAncestorClosurePkgs(canonPkg,
			canonName)
		var aNames @[]@[]char = IfaceAncestorClosure(canonPkg,
			canonName)
		for j := 0; j < len(aPkgs); j++ {
			if containsPkgName(seenPkgs, seenNames, aPkgs[j],
					aNames[j]) {
				continue
			}
			seenPkgs = appendCharSlicePtr(seenPkgs, aPkgs[j])
			seenNames = appendCharSlicePtr(seenNames, aNames[j])
			m.Impls = appendImplInfo(m.Impls,
				makeOwnMethodsImplInfo(recvPkg, recvName, dtorName,
					aPkgs[j], aNames[j]))
		}
	}
}

// makeOwnMethodsImplInfo builds an ImplInfo for the (R, I) pair
// identified by (recvPkg, recvName) × (ifacePkg, ifaceName).  The
// ImplInfo's MethodFuncs entries correspond to I's OWN methods
// only (in declaration order) — inherited methods are emitted via
// the parent's own ImplInfo at codegen time, which is what makes
// the concat vtable layout work.  Slice E.3.
func makeOwnMethodsImplInfo(recvPkg @[]char, recvName @[]char,
		dtorName @[]char, ifacePkg @[]char,
		ifaceName @[]char) @ImplInfo {
	var info @ImplInfo = make(ImplInfo)
	info.RecvPkg = recvPkg
	info.RecvTypeName = buf.CopyStr(recvName)
	info.IfacePkg = ifacePkg
	info.IfaceName = ifaceName
	info.DtorFuncName = dtorName
	var methodNames @[]@[]char = lookupModuleInterface(ifacePkg,
		ifaceName)
	for j := 0; j < len(methodNames); j++ {
		var qualified @[]char = methodFuncName(recvPkg, recvName,
			methodNames[j])
		info.MethodFuncs = appendCharSlicePtr(info.MethodFuncs,
			qualified)
	}
	return info
}

// collectImportedImplsFromDecl is the cross-package counterpart of
// collectImplsFromDecl: it appends to m.ImportedImpls (not m.Impls)
// so codegen doesn't try to re-emit the vtable in this TU. The
// vtable global lives in the imported package's TU with weak_odr
// linkage; this entry exists only so findImplVtableName at use
// sites here in the importing TU can produce the canonical symbol
// name that the linker resolves to it. Slice 2.8 of plan-cross-
// package-interfaces.md.
//
// pkgShort is the import alias's pkg-short (e.g., "hello" for an
// `import "pkg/hello"`) — equals the impl declaration's package.
// MethodFuncs and DtorFuncName are deliberately left empty: those
// drive vtable emission, which is the imported TU's job.
func collectImportedImplsFromDecl(d @ast.Decl,
		pkgShort *[]const char, m @Module) {
	if d == nil || d.Kind != ast.DECL_IMPL {
		return
	}
	var recvName @[]char = recvTypeName(d.TypeRef)
	if len(recvName) == 0 {
		return
	}
	for i := 0; i < len(d.Interfaces); i++ {
		var ref @ast.TypeExpr = d.Interfaces[i]
		if ref == nil || ref.Kind != ast.TEXPR_NAMED {
			continue
		}
		var refIfacePkg @[]char
		if len(ref.Pkg) > 0 {
			refIfacePkg = buf.CopyStr(ref.Pkg)
		} else {
			refIfacePkg = buf.CopyStr(pkgShort)
		}
		var info @ImplInfo = make(ImplInfo)
		info.RecvPkg = buf.CopyStr(pkgShort)
		info.RecvTypeName = buf.CopyStr(recvName)
		info.IfacePkg = canonicalIfacePkg(refIfacePkg, ref.Name)
		info.IfaceName = canonicalIfaceName(refIfacePkg, ref.Name)
		m.ImportedImpls = appendImplInfo(m.ImportedImpls, info)
	}
}

// implDtorFuncName builds the qualified dtor name for an impl's
// receiver struct: `<pkgShort>.__dtor_<recvName>`. Same pattern as
// dtorNameForType for a TYP_STRUCT. The function may not exist
// for the receiver type (NeedsDestruction == false); codegen /
// VM lower handle the absence by emitting a null slot 0.
func implDtorFuncName(pkgShort *[]const char,
		recvName @[]char) @[]char {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(pkgShort)
	cb = cb.WriteStr(".__dtor_")
	cb = cb.WriteStr(recvName)
	return cb.Bytes()
}

// methodFuncName builds the IR-level qualified name for a method:
// `<pkgShort>.<recvTypeName>.<methodName>`. Mirrors methodQualName
// in gen_method.bn — kept separate to avoid coupling the impl
// codepath to the method-decl codepath.
func methodFuncName(pkgShort *[]const char, recvName @[]char,
		methodName @[]char) @[]char {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(pkgShort)
	cb = cb.WriteByte('.')
	cb = cb.WriteStr(recvName)
	cb = cb.WriteByte('.')
	cb = cb.WriteStr(methodName)
	return cb.Bytes()
}

// appendModuleInterface returns ms with v appended.
func appendModuleInterface(ms @[]ModuleInterface,
		v ModuleInterface) @[]ModuleInterface {
	var n int = len(ms)
	var out @[]ModuleInterface =
		make_slice(ModuleInterface, n+1)
	for i := 0; i < n; i++ {
		out[i] = ms[i]
	}
	out[n] = v
	return out
}

// appendImplInfo returns infos with v appended.
func appendImplInfo(infos @[]@ImplInfo,
		v @ImplInfo) @[]@ImplInfo {
	var n int = len(infos)
	var out @[]@ImplInfo = make_slice(@ImplInfo, n+1)
	for i := 0; i < n; i++ {
		out[i] = infos[i]
	}
	out[n] = v
	return out
}
