package "pkg/ir"

import "pkg/ast"
import "pkg/buf"
import "pkg/types"

// IR-gen for impl declarations: walks DECL_INTERFACE entries to
// build a module-local interface registry (name → ordered method-
// name list), then walks DECL_IMPL entries to construct an
// ImplInfo per (impl, interface) pair. ImplInfos go on m.Impls;
// codegen later emits a vtable global per entry. Slice 2.3a-1 of
// plan-interface-syntax-revision.md.

// ModuleInterface caches an interface's method-name list (in
// declaration order) so collectImplVtables can populate vtable
// slots without re-walking the interface's AST. Module-local
// because Slice 2.3a-1 only handles same-package impls; cross-
// package interface refs are deferred. MethodResults stores each
// method's single return type (TypVoid for void methods); used by
// genInterfaceMethodCall to type the dispatch result. Multi-return
// interface methods are deferred — len(Results) > 1 currently
// stores nil, which the dispatch path treats as void (caller
// already type-checked the call so no value is ever read).
type ModuleInterface struct {
	Name          @[]char
	MethodNames   @[]@[]char
	MethodResults @[]@types.Type
	// AliasTarget (Slice 2.4): for `interface X = Y` aliases,
	// holds the target interface's name. Lookups follow the
	// chain on read so dispatch + vtable lookup work uniformly
	// through either name. Empty for non-alias entries.
	AliasTarget @[]char
}

// moduleInterfaces is the per-module interface registry built up
// during GeneratePackage / GenModule's first pass. Indexed by name
// via lookupModuleInterface; reset by resetImplState between
// modules so test runs stay isolated.
var moduleInterfaces @[]ModuleInterface

// currentModule (declared in gen.bn) references the Module being
// generated. setCurrentModule below is a paired setter that runs
// during GeneratePackage / GenModule init alongside the impl-state
// reset, so IR-gen helpers (wrapAsIfaceValue, findImplVtableName)
// can walk m.Impls from any context without threading m through.

// resetImplState clears the module-local interface registry. Called
// from the GeneratePackage / GenModule entry points to keep tests
// isolated and avoid stale state from a prior compile.
func resetImplState() {
	var empty @[]ModuleInterface
	moduleInterfaces = empty
	currentModule = nil
}

// setCurrentModule records the Module being generated so IR-gen
// helpers (wrapAsIfaceValue, findImplVtableName) can walk m.Impls
// from context-light call sites.
func setCurrentModule(m @Module) {
	currentModule = m
}

// collectInterfaceFromDecl records a DECL_INTERFACE's method names
// (in source order — matches the slot ordering codegen uses for
// the vtable global). Alias forms (`interface X = Y`) record the
// target name only; methods are read via alias-following lookups
// (lookupModuleInterface / findInterfaceMethod).
func collectInterfaceFromDecl(d @ast.Decl) {
	if d == nil || d.Kind != ast.DECL_INTERFACE {
		return
	}
	var mi ModuleInterface
	mi.Name = buf.CopyStr(d.Name)
	if d.IsAlias {
		// Slice 2.4: interface alias. Target is a TEXPR_NAMED
		// produced by parseInterfaceRef; copy its Name into
		// AliasTarget so lookups can follow.
		if d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_NAMED {
			mi.AliasTarget = buf.CopyStr(d.TypeRef.Name)
		}
		moduleInterfaces = appendModuleInterface(
			moduleInterfaces, mi)
		return
	}
	for i := 0; i < len(d.Decls); i++ {
		var m @ast.Decl = d.Decls[i]
		if m == nil || m.Kind != ast.DECL_FUNC {
			continue
		}
		mi.MethodNames = appendCharSlicePtr(mi.MethodNames,
			buf.CopyStr(m.Name))
		var resultTyp @types.Type = nil
		if len(m.Results) == 1 {
			resultTyp = resolveTypeExpr(m.Results[0])
		}
		mi.MethodResults = appendTypePtr(mi.MethodResults,
			resultTyp)
	}
	moduleInterfaces = appendModuleInterface(
		moduleInterfaces, mi)
}

// resolveModuleInterface returns the index in moduleInterfaces of
// the entry for `name`, following any alias chain. Returns -1 on
// not-found or cycle (defensive cap at 32 hops).
func resolveModuleInterface(name *[]const char) int {
	// First lookup uses the *[]const char input directly. Each
	// follow-up hop resolves through an alias's AliasTarget,
	// which is an @[]char — once we've taken at least one hop,
	// store it in `aliasCur` and pass that to charEq (which
	// accepts both forms via *[]const char auto-conversion).
	var found int = lookupModuleInterfaceIndex(name)
	if found < 0 { return -1 }
	for hop := 0; hop < 32; hop++ {
		var alias @[]char = moduleInterfaces[found].AliasTarget
		if len(alias) == 0 { return found }
		found = lookupModuleInterfaceIndex(alias)
		if found < 0 { return -1 }
	}
	return -1
}

// canonicalIfaceName resolves an interface name through the alias
// chain in moduleInterfaces and returns the chain tail's name. If
// `name` doesn't refer to a registered interface (e.g., cross-
// package reference, not yet supported), returns a fresh copy of
// the input — at worst the symbol mangles on the impl-site name,
// matching the pre-Slice-2.6 behavior. Slice 2.6 of plan-cross-
// package-interfaces.md.
func canonicalIfaceName(name *[]const char) @[]char {
	var idx int = resolveModuleInterface(name)
	if idx < 0 {
		return buf.CopyStr(name)
	}
	return buf.CopyStr(moduleInterfaces[idx].Name)
}

// lookupModuleInterfaceIndex returns the index of the entry in
// moduleInterfaces whose Name equals `name`, or -1 if absent. No
// alias resolution.
func lookupModuleInterfaceIndex(name *[]const char) int {
	for i := 0; i < len(moduleInterfaces); i++ {
		if charEq(moduleInterfaces[i].Name, name) {
			return i
		}
	}
	return -1
}

// isInterfaceMethodCall reports whether sel.X resolves to an
// interface value at IR-gen time — peeks at the receiver
// expression's type via getSelectorType / lookupVarType without
// re-evaluating it. Used by genCall to route SELECTOR callees with
// interface-value receivers to the vtable-dispatch path. Slice
// 2.3a-3 of plan-interface-syntax-revision.md.
func isInterfaceMethodCall(ctx @GenContext, sel @ast.Expr) bool {
	if sel == nil || sel.X == nil { return false }
	var recvTyp @types.Type = nil
	if sel.X.Kind == ast.EXPR_IDENT {
		recvTyp = lookupVarType(ctx, sel.X.Name)
	} else if sel.X.Kind == ast.EXPR_SELECTOR ||
		sel.X.Kind == ast.EXPR_INDEX {
		recvTyp = getSelectorType(ctx, sel.X)
	}
	if recvTyp == nil { return false }
	return recvTyp.Kind == types.TYP_INTERFACE_VALUE ||
		recvTyp.Kind == types.TYP_INTERFACE_VALUE_MANAGED
}

// genInterfaceMethodCall lowers `iv.method(args)` where iv is a
// TYP_INTERFACE_VALUE / TYP_INTERFACE_VALUE_MANAGED to an
// OP_CALL_IFACE_METHOD instruction. Looks up the method's slot
// index + return type via the per-module interface registry.
// Slice 2.3a-3 of plan-interface-syntax-revision.md.
func genInterfaceMethodCall(ctx @GenContext, b @Block,
		e @ast.Expr) @Instr {
	var sel @ast.Expr = e.X
	var iv @Instr = genExpr(ctx, b, sel.X)
	b = ctx.CurBlock
	if iv == nil || iv.Typ == nil ||
		iv.Typ.Elem == nil {
		return EmitConstInt(ctx.Func, b, 0, types.TypInt())
	}
	var ifaceName @[]char = iv.Typ.Elem.Name
	var idx int
	var resultTyp @types.Type
	idx, resultTyp = findInterfaceMethod(ifaceName, sel.Name)
	if idx < 0 {
		return EmitConstInt(ctx.Func, b, 0, types.TypInt())
	}
	if resultTyp == nil { resultTyp = types.TypVoid() }
	var args @[]@Instr
	for i := 0; i < len(e.Args); i++ {
		var arg @Instr = genExpr(ctx, b, e.Args[i])
		b = ctx.CurBlock
		args = appendInstrPtr(args, arg)
	}
	return EmitCallIfaceMethod(ctx.Func, b, iv, args, idx,
		resultTyp)
}

// findInterfaceMethod returns the (slot index, return type) of the
// named method on ifaceName, or (-1, nil) if not found. Used by
// genInterfaceMethodCall to populate OP_CALL_IFACE_METHOD's Index
// and result Typ. Slice 2.3a-3 of plan-interface-syntax-revision.md.
// Follows alias chains (Slice 2.4) so lookup through an alias name
// finds the target's methods.
func findInterfaceMethod(ifaceName *[]const char,
		methodName *[]const char) (int, @types.Type) {
	var idx int = resolveModuleInterface(ifaceName)
	if idx < 0 { return -1, nil }
	var mi ModuleInterface = moduleInterfaces[idx]
	for j := 0; j < len(mi.MethodNames); j++ {
		if charEq(mi.MethodNames[j], methodName) {
			var rt @types.Type = nil
			if j < len(mi.MethodResults) {
				rt = mi.MethodResults[j]
			}
			return j, rt
		}
	}
	return -1, nil
}

// lookupModuleInterface returns the cached method-name list for an
// interface declared in this module, or an empty slice if not
// found (cross-package or undeclared). Follows alias chains.
func lookupModuleInterface(name *[]const char) @[]@[]char {
	var idx int = resolveModuleInterface(name)
	if idx < 0 {
		var empty @[]@[]char
		return empty
	}
	return moduleInterfaces[idx].MethodNames
}

// collectImplsFromDecl appends an ImplInfo to m.Impls for each
// `impl R : I1, I2, ...` interface in d. Receiver type-name is
// extracted via recvTypeName (the same helper genMethod uses); each
// interface entry comes from the per-module interface registry.
// Slice 2.3a-1 only handles same-package interface refs — cross-
// package impls are silently skipped here; they'll need a separate
// resolution path that has access to the importing package's
// AST/types.
func collectImplsFromDecl(d @ast.Decl, pkgShort *[]const char,
		m @Module) {
	if d == nil || d.Kind != ast.DECL_IMPL {
		return
	}
	var recvName @[]char = recvTypeName(d.TypeRef)
	if len(recvName) == 0 {
		return
	}
	for i := 0; i < len(d.Interfaces); i++ {
		var ref @ast.TypeExpr = d.Interfaces[i]
		if ref == nil || ref.Kind != ast.TEXPR_NAMED {
			continue
		}
		// Cross-package interface — skip in Slice 2.3a-1.
		if len(ref.Pkg) > 0 {
			continue
		}
		var methodNames @[]@[]char =
			lookupModuleInterface(ref.Name)
		// Empty method list is valid (zero-method interface — empty
		// vtable). Cross-package / undeclared cases still fall
		// through to ImplInfo emission with no slots.
		var info @ImplInfo = make(ImplInfo)
		// Slice 2.6: store canonical (R, I) identity. Today the
		// impl decl, the receiver type, and the interface all live
		// in the same package, so RecvPkg / IfacePkg both = pkgShort.
		// Cross-package work
		// (plan-cross-package-interfaces.md, Slice 2.7+) will source
		// these from the resolved type / interface refs instead.
		info.RecvPkg = buf.CopyStr(pkgShort)
		info.RecvTypeName = buf.CopyStr(recvName)
		info.IfacePkg = buf.CopyStr(pkgShort)
		// Resolve alias chain to canonical iface name. If the impl
		// declaration referenced an alias, IfaceName stores the
		// chain's tail so lookups and vtable-symbol formation agree
		// regardless of which alias the impl-site or use-site
		// happened to use.
		info.IfaceName = canonicalIfaceName(ref.Name)
		// Slice 2.5: dtor name for the receiver type. If the
		// type doesn't need destruction (no managed fields),
		// the lookup at vtable-emit time returns nil and the
		// slot is `i8* null`; ZeroRefDestroy then falls through
		// to plain rt.Free without invoking a dtor. Same pattern
		// as method slots' missing-function fallback.
		var dtorName @[]char = implDtorFuncName(pkgShort, recvName)
		info.DtorFuncName = dtorName
		for j := 0; j < len(methodNames); j++ {
			var qualified @[]char = methodFuncName(
				pkgShort, recvName, methodNames[j])
			info.MethodFuncs = appendCharSlicePtr(
				info.MethodFuncs, qualified)
		}
		m.Impls = appendImplInfo(m.Impls, info)
	}
}

// isInterfaceTypeExpr reports whether te is a TEXPR_NAMED naming a
// declared interface in this module. Used by resolveTypeExpr's
// `*X` / `@X` arms to choose between regular pointer and interface-
// value lowering. Cross-package interface refs are deferred — in
// this slice (2.3a-2) only same-package interfaces register on
// moduleInterfaces.
func isInterfaceTypeExpr(te @ast.TypeExpr) bool {
	if te == nil { return false }
	if te.Kind != ast.TEXPR_NAMED { return false }
	if len(te.Pkg) > 0 { return false }
	for i := 0; i < len(moduleInterfaces); i++ {
		if charEq(moduleInterfaces[i].Name, te.Name) {
			return true
		}
	}
	return false
}

// ifaceTypeForName builds a placeholder TYP_INTERFACE Type for the
// named interface, with no method-set populated (IR-gen doesn't
// need method signatures yet — only the kind-and-name surface for
// downstream type identity / comparison). The full types.Type
// graph for cross-module method-set lookup belongs to the type
// checker; this helper exists only to give resolveTypeExpr a
// well-shaped Elem for *Iface / @Iface forms.
func ifaceTypeForName(te @ast.TypeExpr) @types.Type {
	if te == nil { return nil }
	return types.MakeInterfaceType(buf.CopyStr(te.Name))
}

// wrapAsIfaceValue is the IR-gen helper that lifts a `*T` / `@T`
// source value into a `*Iface` interface value. Looks up the
// matching impl by (source's named type, interface's name) and
// emits OP_IFACE_VALUE pointing at its vtable. Returns nil if no
// matching impl is found in this module — caller falls through to
// the unwrapped value (the type-checker would have errored, but
// IR-gen stays defensive). Slice 2.3a-2 of plan-interface-syntax-
// revision.md.
func wrapAsIfaceValue(ctx @GenContext, b @Block, val @Instr,
		dstTyp @types.Type) @Instr {
	if val == nil || dstTyp == nil { return nil }
	if dstTyp.Kind != types.TYP_INTERFACE_VALUE &&
		dstTyp.Kind != types.TYP_INTERFACE_VALUE_MANAGED {
		return nil
	}
	if currentModule == nil { return nil }
	if val.Typ == nil { return nil }
	// Source must be pointer-shaped — interface values borrow (or
	// own, for the managed variant) a pointer in their data slot.
	// A value-typed source (e.g. a loaded struct) would bitcast to
	// i8* nonsensically; leave them to a clear type-checker error
	// rather than producing undef LLVM IR.
	if val.Typ.Kind != types.TYP_POINTER &&
		val.Typ.Kind != types.TYP_MANAGED_PTR {
		return nil
	}
	// @Iface (managed): only @T sources are admitted (type-checker
	// rejects *T → @Iface; defensive guard here).
	if dstTyp.Kind == types.TYP_INTERFACE_VALUE_MANAGED &&
		val.Typ.Kind != types.TYP_MANAGED_PTR {
		return nil
	}
	var iface @types.Type = dstTyp.Elem
	if iface == nil { return nil }
	var srcName @[]char = receiverBaseTypeName(val.Typ)
	if len(srcName) == 0 { return nil }
	var vtable @[]char = findImplVtableName(currentModule,
		srcName, iface.Name)
	if len(vtable) == 0 { return nil }
	// @Iface owns its data ref — RefInc the source pointer so the
	// iv's data slot has its own count; when the iv is dropped,
	// scope cleanup RefDecs it. Slice 2.3b of plan-interface-
	// syntax-revision.md.
	if dstTyp.Kind == types.TYP_INTERFACE_VALUE_MANAGED {
		EmitRefInc(b, val)
	}
	return EmitIfaceValue(ctx.Func, b, val, vtable, dstTyp)
}

// receiverBaseTypeName extracts the underlying named-type name
// from a pointer / managed-pointer / const-wrapped type expression
// resolved by IR-gen. Mirrors types.ReceiverBaseNamed but accepts
// IR-gen's representation where struct types may live as TYP_STRUCT
// directly (with Name populated) rather than wrapped in TYP_NAMED.
func receiverBaseTypeName(t @types.Type) @[]char {
	var empty @[]char
	if t == nil { return empty }
	if t.Kind == types.TYP_POINTER ||
		t.Kind == types.TYP_MANAGED_PTR ||
		t.Kind == types.TYP_CONST {
		return receiverBaseTypeName(t.Elem)
	}
	if t.Kind == types.TYP_NAMED || t.Kind == types.TYP_STRUCT {
		return t.Name
	}
	return empty
}

// findImplVtableName searches m.Impls for an entry matching
// (recvTypeName, canonical(ifaceName)) and returns the mangled
// `__ivt.<...>` global name codegen emits for that impl. The query
// iface name is canonicalized through the alias chain so a use-site
// referencing an alias matches an impl declared on the alias's
// target (or vice versa). Returns empty if no match — IR-gen's
// caller (genDecl interface-value path) treats that as "no impl" and
// falls back to a placeholder. Slice 2.3a-2 of plan-interface-
// syntax-revision.md; Slice 2.6 canonicalized the symbol form on
// (recv_pkg, recv_name, iface_pkg, iface_name).
func findImplVtableName(m @Module, recvTypeName *[]const char,
		ifaceName *[]const char) @[]char {
	var canonical @[]char = canonicalIfaceName(ifaceName)
	for i := 0; i < len(m.Impls); i++ {
		var info @ImplInfo = m.Impls[i]
		if info == nil { continue }
		if !charEq(info.RecvTypeName, recvTypeName) {
			continue
		}
		if !charEq(info.IfaceName, canonical) {
			continue
		}
		return buildImplVtableSymbol(info)
	}
	var empty @[]char
	return empty
}

// buildImplVtableSymbol formats the canonical vtable symbol for an
// ImplInfo: `__ivt.bn_<recv_pkg>__<recv_name>__<iface_pkg>__<iface_name>`.
// Single source of truth for the mangling — codegen's implVtableName
// (in pkg/codegen/emit_impls.bn) defers to the same shape via the
// ImplInfo fields. Slice 2.6.
func buildImplVtableSymbol(info @ImplInfo) @[]char {
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("__ivt.bn_")
	b = b.WriteStr(info.RecvPkg)
	b = b.WriteStr("__")
	b = b.WriteStr(info.RecvTypeName)
	b = b.WriteStr("__")
	b = b.WriteStr(info.IfacePkg)
	b = b.WriteStr("__")
	b = b.WriteStr(info.IfaceName)
	return b.Bytes()
}

// implDtorFuncName builds the qualified dtor name for an impl's
// receiver struct: `<pkgShort>.__dtor_<recvName>`. Same pattern as
// dtorNameForType for a TYP_STRUCT. The function may not exist
// for the receiver type (NeedsDestruction == false); codegen /
// VM lower handle the absence by emitting a null slot 0.
func implDtorFuncName(pkgShort *[]const char,
		recvName @[]char) @[]char {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(pkgShort)
	cb = cb.WriteStr(".__dtor_")
	cb = cb.WriteStr(recvName)
	return cb.Bytes()
}

// methodFuncName builds the IR-level qualified name for a method:
// `<pkgShort>.<recvTypeName>.<methodName>`. Mirrors methodQualName
// in gen_method.bn — kept separate to avoid coupling the impl
// codepath to the method-decl codepath.
func methodFuncName(pkgShort *[]const char, recvName @[]char,
		methodName @[]char) @[]char {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(pkgShort)
	cb = cb.WriteByte('.')
	cb = cb.WriteStr(recvName)
	cb = cb.WriteByte('.')
	cb = cb.WriteStr(methodName)
	return cb.Bytes()
}

// appendModuleInterface returns ms with v appended.
func appendModuleInterface(ms @[]ModuleInterface,
		v ModuleInterface) @[]ModuleInterface {
	var n int = len(ms)
	var out @[]ModuleInterface =
		make_slice(ModuleInterface, n+1)
	for i := 0; i < n; i++ {
		out[i] = ms[i]
	}
	out[n] = v
	return out
}

// appendImplInfo returns infos with v appended.
func appendImplInfo(infos @[]@ImplInfo,
		v @ImplInfo) @[]@ImplInfo {
	var n int = len(infos)
	var out @[]@ImplInfo = make_slice(@ImplInfo, n+1)
	for i := 0; i < n; i++ {
		out[i] = infos[i]
	}
	out[n] = v
	return out
}

