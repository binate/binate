package "pkg/ir"

import "pkg/buf"
import "pkg/builtin/testing"
import "pkg/types"

// Tests for gen_impl.bn — collects DECL_INTERFACE method names and
// then walks DECL_IMPL entries to populate m.Impls. Slice 2.3a-1 of
// plan-interface-syntax-revision.md. Helpers (genFromSource,
// genFromSourcePkg, fail) live in ir_test.bn.

// A single `impl T : I` produces one ImplInfo with one slot pointing
// at the impl's matching method.
func TestGenImplSingle() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) foo() { }\n")
	cb = cb.WriteStr("impl *T : I\n")
	var m @Module = genFromSourcePkg(cb.Bytes())
	if len(m.Impls) != 1 { return fail("expected 1 impl info") }
	var info @ImplInfo = m.Impls[0]
	if !charsEqualOpt(info.RecvTypeName, "T") {
		return fail("RecvTypeName should be T")
	}
	if !charsEqualOpt(info.IfaceName, "I") {
		return fail("IfaceName should be I")
	}
	if len(info.MethodFuncs) != 1 {
		return fail("expected 1 method slot")
	}
	if !charsEqualOpt(info.MethodFuncs[0], "test.T.foo") {
		return fail("MethodFuncs[0] should be `test.T.foo`")
	}
	return ""
}

// `impl T : I1, I2` produces one ImplInfo per interface.
func TestGenImplMultipleInterfaces() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface A { fa() }\n")
	cb = cb.WriteStr("interface B { fb() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) fa() { }\n")
	cb = cb.WriteStr("func (t *T) fb() { }\n")
	cb = cb.WriteStr("impl *T : A, B\n")
	var m @Module = genFromSourcePkg(cb.Bytes())
	if len(m.Impls) != 2 {
		return fail("expected 2 impl infos")
	}
	if !charsEqualOpt(m.Impls[0].IfaceName, "A") {
		return fail("first impl should be for A")
	}
	if !charsEqualOpt(m.Impls[1].IfaceName, "B") {
		return fail("second impl should be for B")
	}
	return ""
}

// A multi-method interface puts methods in the slot order they were
// declared in the interface.
func TestGenImplMethodOrder() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface RW { read() int; write() }\n")
	cb = cb.WriteStr("type Pipe struct { x int }\n")
	cb = cb.WriteStr("func (p *Pipe) read() int { return 0 }\n")
	cb = cb.WriteStr("func (p *Pipe) write() { }\n")
	cb = cb.WriteStr("impl *Pipe : RW\n")
	var m @Module = genFromSourcePkg(cb.Bytes())
	if len(m.Impls) != 1 { return fail("expected 1 impl") }
	var mfs @[]@[]char = m.Impls[0].MethodFuncs
	if len(mfs) != 2 { return fail("expected 2 method slots") }
	if !charsEqualOpt(mfs[0], "test.Pipe.read") {
		return fail("slot 0 should be read")
	}
	if !charsEqualOpt(mfs[1], "test.Pipe.write") {
		return fail("slot 1 should be write")
	}
	return ""
}

// A program with no impls leaves m.Impls empty.
func TestGenImplNone() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc main() { }\n"
	var m @Module = genFromSourcePkg(src)
	if len(m.Impls) != 0 {
		return fail("expected no impls")
	}
	return ""
}

// Slice 2.3a-2 IR shape: `var iv *I = &t` produces an OP_IFACE_VALUE
// instruction wrapping the source pointer with the impl's vtable
// global. Without this op the slot would be filled with a bare i8*
// rather than the 2-word {data, vtable} interface value.
func TestGenImplWrapEmitsIfaceValue() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) foo() { }\n")
	cb = cb.WriteStr("impl *T : I\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t T\n")
	cb = cb.WriteStr("\tvar iv *I = &t\n")
	cb = cb.WriteStr("\t_ = iv\n")
	cb = cb.WriteStr("}\n")
	var m @Module = genFromSourcePkg(cb.Bytes())
	var mainFn @Func = findFunc(m, "test.main")
	if mainFn == nil { return fail("test.main not found") }
	if countOp(mainFn, OP_IFACE_VALUE) < 1 {
		return fail(
			"expected OP_IFACE_VALUE for *Iface construction")
	}
	return ""
}

// Slice 2.3a-2 IR shape: an interface-name in `*X` / `@X` position
// resolves to TYP_INTERFACE_VALUE / TYP_INTERFACE_VALUE_MANAGED, not
// TYP_POINTER / TYP_MANAGED_PTR. The slot's LLVM type then comes
// out as `%BnIfaceValue` (16 bytes) rather than a single i8*.
func TestGenImplResolveStarIfaceType() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) foo() { }\n")
	cb = cb.WriteStr("impl *T : I\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t T\n")
	cb = cb.WriteStr("\tvar iv *I = &t\n")
	cb = cb.WriteStr("\t_ = iv\n")
	cb = cb.WriteStr("}\n")
	var m @Module = genFromSourcePkg(cb.Bytes())
	var mainFn @Func = findFunc(m, "test.main")
	if mainFn == nil { return fail("test.main not found") }
	// At least one alloca with TypeArg == TYP_INTERFACE_VALUE
	// (the iv slot). If resolveTypeExpr produced TYP_POINTER, this
	// search would fail.
	for i := 0; i < len(mainFn.Blocks); i++ {
		var blk @Block = mainFn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op == OP_ALLOC && instr.TypeArg != nil &&
				instr.TypeArg.Kind == types.TYP_INTERFACE_VALUE {
				return ""
			}
		}
	}
	return fail("no alloca with TYP_INTERFACE_VALUE element")
}

// Slice 2.3a-3 IR shape: `iv.foo()` lowers to OP_CALL_IFACE_METHOD
// with the iv as Args[0] and the slot index as Index. Without this
// op the dispatch would fall through to the regular method-call
// path, which doesn't know how to route through a vtable.
func TestGenImplDispatchEmitsCallIface() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) foo() { }\n")
	cb = cb.WriteStr("impl *T : I\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t T\n")
	cb = cb.WriteStr("\tvar iv *I = &t\n")
	cb = cb.WriteStr("\tiv.foo()\n")
	cb = cb.WriteStr("}\n")
	var m @Module = genFromSourcePkg(cb.Bytes())
	var mainFn @Func = findFunc(m, "test.main")
	if mainFn == nil { return fail("test.main not found") }
	if countOp(mainFn, OP_CALL_IFACE_METHOD) < 1 {
		return fail("expected OP_CALL_IFACE_METHOD for iv.foo()")
	}
	return ""
}

// Multi-method interface: each method gets the correct slot index,
// matching the interface's declaration order.
func TestGenImplDispatchSlotIndices() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface AB { a() int; b() int }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) a() int { return 1 }\n")
	cb = cb.WriteStr("func (t *T) b() int { return 2 }\n")
	cb = cb.WriteStr("impl *T : AB\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t T\n")
	cb = cb.WriteStr("\tvar iv *AB = &t\n")
	cb = cb.WriteStr("\tvar _ int = iv.a()\n")
	cb = cb.WriteStr("\tvar _ int = iv.b()\n")
	cb = cb.WriteStr("}\n")
	var m @Module = genFromSourcePkg(cb.Bytes())
	var mainFn @Func = findFunc(m, "test.main")
	if mainFn == nil { return fail("test.main not found") }
	var sawA bool = false
	var sawB bool = false
	for i := 0; i < len(mainFn.Blocks); i++ {
		var blk @Block = mainFn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op != OP_CALL_IFACE_METHOD { continue }
			if instr.Index == 0 { sawA = true }
			if instr.Index == 1 { sawB = true }
		}
	}
	if !sawA { return fail("expected dispatch with slot 0 (a)") }
	if !sawB { return fail("expected dispatch with slot 1 (b)") }
	return ""
}

// `*X` where X is a struct (not an interface) keeps the regular
// pointer kind — the interface-aware arm only fires for declared
// interface names. Guards against an over-broad match.
func TestGenImplResolveStarStructStaysPointer() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t T\n")
	cb = cb.WriteStr("\tvar p *T = &t\n")
	cb = cb.WriteStr("\t_ = p\n")
	cb = cb.WriteStr("}\n")
	var m @Module = genFromSourcePkg(cb.Bytes())
	var mainFn @Func = findFunc(m, "test.main")
	if mainFn == nil { return fail("test.main not found") }
	for i := 0; i < len(mainFn.Blocks); i++ {
		var blk @Block = mainFn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op == OP_ALLOC && instr.TypeArg != nil &&
				instr.TypeArg.Kind == types.TYP_INTERFACE_VALUE {
				return fail(
					"*T over a struct should NOT be TYP_INTERFACE_VALUE")
			}
		}
	}
	return ""
}
