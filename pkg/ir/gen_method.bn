package "pkg/ir"

import "pkg/ast"
import "pkg/buf"
import "pkg/types"

// ============================================================
// Method IR generation (Stage 5 of plan-receivers.md)
// ============================================================

// methodQualName builds a method's IR-level fully-qualified name,
// "<pkgShort>.<TypeName>.<MethodName>". The mangler converts every "."
// to "__" downstream (Stage 4), yielding e.g. bn_geom__Point__M.
func methodQualName(pkgShort *[]const char, d @ast.Decl) @[]char {
	var typeName @[]char = recvTypeName(d.Recv.Type)
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(pkgShort)
	cb = cb.WriteByte('.')
	cb = cb.WriteStr(typeName)
	cb = cb.WriteByte('.')
	cb = cb.WriteStr(d.Name)
	return cb.Bytes()
}

// recvTypeName walks a receiver TypeExpr to find the base named type's
// name. The type checker has already validated the shape (Stage 2), so
// we expect to find a TEXPR_NAMED at the bottom; an empty result means
// invalid input that slipped through.
func recvTypeName(te @ast.TypeExpr) @[]char {
	for te != nil {
		if te.Kind == ast.TEXPR_NAMED {
			return te.Name
		}
		if te.Kind == ast.TEXPR_POINTER ||
			te.Kind == ast.TEXPR_MANAGED ||
			te.Kind == ast.TEXPR_CONST ||
			te.Kind == ast.TEXPR_PAREN {
			te = te.Base
		} else {
			return ""
		}
	}
	return ""
}

// recvTypePkg drills through pointer/managed/const wrappers to find
// the receiver's qualifying package short-name (e.g. `hello` for
// `*hello.Hello`). Returns empty for unqualified (same-package)
// receivers. Slice 2.9 of plan-cross-package-interfaces.md.
func recvTypePkg(te @ast.TypeExpr) @[]char {
	var empty @[]char
	for te != nil {
		if te.Kind == ast.TEXPR_NAMED {
			return te.Pkg
		}
		if te.Kind == ast.TEXPR_POINTER ||
			te.Kind == ast.TEXPR_MANAGED ||
			te.Kind == ast.TEXPR_CONST ||
			te.Kind == ast.TEXPR_PAREN {
			te = te.Base
		} else {
			return empty
		}
	}
	return empty
}

// methodSig builds a FuncSig for a method declaration: name is the
// fully-qualified form, params have the receiver prepended at index 0.
func methodSig(pkgShort *[]const char, d @ast.Decl) FuncSig {
	var sig FuncSig
	sig.Name = methodQualName(pkgShort, d)
	var sigParams @[]@types.Type
	sigParams = appendTypePtr(sigParams, resolveTypeExpr(d.Recv.Type))
	for j := 0; j < len(d.Params); j++ {
		sigParams = appendTypePtr(sigParams, resolveTypeExpr(d.Params[j].Type))
	}
	sig.Params = sigParams
	var sigResults @[]@types.Type
	for j := 0; j < len(d.Results); j++ {
		sigResults = appendTypePtr(sigResults, resolveTypeExpr(d.Results[j]))
	}
	sig.Results = sigResults
	if len(sigResults) > 1 {
		sig.MultiReturnType = makeMultiReturnStructType(sigResults)
	}
	return sig
}

// genMethod lowers a method declaration to an IR Func. It synthesizes
// a free-function-shaped Decl with the receiver promoted to Params[0]
// and the qualified name, then defers to genFunc for body emission.
func genMethod(d @ast.Decl, pkgShort *[]const char) @Func {
	var nd @ast.Decl = make(ast.Decl)
	nd.Kind = ast.DECL_FUNC
	nd.Pos = d.Pos
	nd.Name = methodQualName(pkgShort, d)
	// Recv stays nil — the receiver lives in Params now.
	var prepended @[]@ast.ParamDecl = make_slice(@ast.ParamDecl, len(d.Params)+1)
	prepended[0] = d.Recv
	for i := 0; i < len(d.Params); i++ {
		prepended[i+1] = d.Params[i]
	}
	nd.Params = prepended
	nd.Results = d.Results
	nd.Body = d.Body
	return genFunc(nd)
}

// ============================================================
// Method call IR generation
// ============================================================

// isMethodCallSel reports whether a SELECTOR expression represents a
// method call (obj.M) rather than a package-qualified function call
// (pkg.Func). The disambiguation: if sel.X is an IDENT bound as a
// variable in scope, or any non-IDENT expression, it's a method call;
// if sel.X is an IDENT with no var binding, it's assumed to be a
// package alias.
func isMethodCallSel(ctx @GenContext, sel @ast.Expr) bool {
	if sel.X == nil {
		return false
	}
	if sel.X.Kind != ast.EXPR_IDENT {
		// Any non-ident receiver expression must evaluate to a value
		// (field access, function-call result, index, etc.) — that's
		// always a method call.
		return true
	}
	// IDENT receiver: a variable in scope means method call; otherwise
	// fall back to the existing pkg.Func path.
	return lookupVar(ctx, sel.X.Name) != nil
}

// genMethodCall generates IR for a method call obj.M(args). The
// receiver is evaluated and passed as Args[0]; user args follow.
// The method is looked up by qualified name. For local types the
// qualifier is the current module's short package name; for imported
// types the type's stored Name is already qualified (`pkg.Type`), so
// we use it as-is.
func genMethodCall(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	var sel @ast.Expr = e.X

	// Evaluate the receiver expression once.
	var recv @Instr = genExpr(ctx, b, sel.X)
	b = ctx.CurBlock

	// Determine the receiver's base named type — we look one level
	// through *T / @T to find the named type's name. The name may be
	// unqualified ("Point") for local types or already qualified
	// ("buf.CharBuf") for imported types.
	var recvBaseTypeName @[]char = baseNamedTypeName(recv.Typ)
	var qualName @[]char = buildMethodQualName(currentModulePkgShort,
		recvBaseTypeName, sel.Name)

	// Build args: receiver first, then user args.
	var paramTypes @[]@types.Type = lookupFuncParams(qualName)
	if len(paramTypes) > 0 {
		recv = applyReceiverConversion(ctx, b, recv, paramTypes[0], sel.X)
		b = ctx.CurBlock
		// For value-struct receivers with managed fields, RefInc the
		// fields before passing — same treatment as user args in
		// genCall. Without this, the callee's scope-cleanup RefDec
		// imbalances against the caller's, freeing the backing
		// prematurely.
		var rt @types.Type = paramTypes[0]
		if needsStructCopy(rt) {
			if isStructOrArrayAlloc(recv) {
				var tmpPtr @Instr = recv
				emitStructCopy(ctx.Func, b, tmpPtr, rt)
				recv = b.EmitLoad(tmpPtr, recv.TypeArg)
			} else {
				var tmpSlot @Instr = b.EmitAlloc(rt)
				b.EmitStore(tmpSlot, recv)
				emitStructCopy(ctx.Func, b, tmpSlot, rt)
				recv = b.EmitLoad(tmpSlot, rt)
			}
		}
	}
	var args @[]@Instr
	args = appendInstrPtr(args, recv)
	for i := 0; i < len(e.Args); i++ {
		var arg @Instr = genExpr(ctx, b, e.Args[i])
		b = ctx.CurBlock
		// User args are at offset 1 in paramTypes (Params[0] is the
		// receiver), so coercions index from there.
		var pIdx int = i + 1
		if arg.Op == OP_CONST_STRING && pIdx < len(paramTypes) {
			var pt @types.Type = paramTypes[pIdx]
			if pt != nil && (pt.Kind == types.TYP_SLICE || pt.Kind == types.TYP_MANAGED_SLICE) {
				arg = b.EmitStringToChars(arg, pt)
				noteSPGrowingResult(ctx, arg)
			}
		}
		if arg.Op == OP_CONST_NIL && pIdx < len(paramTypes) {
			var pt @types.Type = paramTypes[pIdx]
			if pt != nil && (pt.Kind == types.TYP_SLICE || pt.Kind == types.TYP_MANAGED_SLICE) {
				arg.Typ = pt
			}
		}
		if pIdx < len(paramTypes) {
			var pt @types.Type = paramTypes[pIdx]
			if pt != nil && pt.Kind == types.TYP_SLICE {
				if isManagedSliceType(arg.Typ) {
					arg = b.EmitManagedToRaw(arg)
				}
			}
		}
		// RefInc managed fields for struct/array args passed by value.
		// The callee's scope cleanup will dtor the parameter copy.
		// Mirrors genCall — without this, methods receiving a struct
		// arg with managed fields (e.g. p.addError(pos, msg) where
		// pos is token.Pos with @[]char File) double-RefDec the field
		// at end of callee's scope, freeing it under the caller and
		// eventually corrupting the heap.
		if pIdx < len(paramTypes) {
			var pt @types.Type = paramTypes[pIdx]
			if needsStructCopy(pt) {
				if isStructOrArrayAlloc(arg) {
					var tmpPtr @Instr = arg
					emitStructCopy(ctx.Func, b, tmpPtr, pt)
					arg = b.EmitLoad(tmpPtr, arg.TypeArg)
				} else {
					var tmpSlot @Instr = b.EmitAlloc(pt)
					b.EmitStore(tmpSlot, arg)
					emitStructCopy(ctx.Func, b, tmpSlot, pt)
					arg = b.EmitLoad(tmpSlot, pt)
				}
			}
		}
		args = appendInstrPtr(args, arg)
	}

	// Determine the result type from the method's signature.
	var resultTyp @types.Type = types.TypInt()
	var results @[]@types.Type = lookupFuncResults(qualName)
	var funcFound bool = lookupFuncExists(qualName)
	if funcFound && len(results) == 0 {
		resultTyp = types.TypVoid()
	} else if len(results) == 1 {
		resultTyp = results[0]
	} else if len(results) > 1 {
		var mrt @types.Type = lookupFuncMultiReturnType(qualName)
		if mrt != nil {
			resultTyp = mrt
		} else {
			resultTyp = makeMultiReturnStructType(results)
		}
	}

	var result @Instr = b.EmitCall(qualName, args, resultTyp)
	if isManagedPtrType(resultTyp) {
		registerTemp(ctx, result)
	}
	if isManagedSliceType(resultTyp) {
		registerTemp(ctx, result)
		// BC_RETURN copy-back grows caller vm.SP by 32 (slice header).
		// Mirror genCall — without this, method calls returning managed
		// slices leak vm.SP per call. Cumulative leaks across many calls
		// (e.g. parser methods called from a long-running test binary)
		// eventually corrupt the heap. See claude-todo "pkg/types
		// builder-comp regression" for the bisect that pointed here.
		ctx.StmtGrewSP = true
	}
	if needsStructCopy(resultTyp) {
		registerTemp(ctx, result)
		// BC_RETURN copy-back grows caller vm.SP by SizeOf(struct).
		ctx.StmtGrewSP = true
	}
	return result
}

// applyReceiverConversion converts the receiver Instr to match the
// method's declared receiver type when the type checker accepted a
// smoothing case (Decision 3 of plan-receivers.md). Conversions:
//
//   src *T or @T,  dst T (value)        → load (deref to value)
//   src T (value), dst *T               → take address: lookupVar slot
//                                         for ident receivers; else
//                                         materialize a temp slot.
//   src @T,        dst *T               → reinterpret (both i8*)
//   matching shapes                     → identity (no op)
//
// Other combinations either match exactly (no conversion needed) or
// were rejected by the type checker (e.g., `*T → @T` is never allowed).
func applyReceiverConversion(ctx @GenContext, b @Block,
	recv @Instr, dstTyp @types.Type, srcExpr @ast.Expr) @Instr {
	if recv == nil || recv.Typ == nil || dstTyp == nil {
		return recv
	}
	var srcTyp @types.Type = recv.Typ

	// Identity: same kind, same base name. (Const wrappers are
	// transparent at this layer.)
	if recvShapeMatches(srcTyp, dstTyp) {
		return recv
	}

	// src is a pointer/managed-pointer, dst is a value (or named-struct
	// value): load (deref) the pointed-to struct.
	if srcTyp.Kind == types.TYP_POINTER || srcTyp.Kind == types.TYP_MANAGED_PTR {
		if isNamedTypeKind(dstTyp) {
			return b.EmitLoad(recv, dstTyp)
		}
	}

	// src is a value (named struct), dst is a raw pointer: take the
	// address of the receiver's storage. For an ident receiver we can
	// reuse its alloca slot directly; for a non-ident receiver we
	// materialize a temp slot.
	if isNamedTypeKind(srcTyp) && dstTyp.Kind == types.TYP_POINTER {
		if srcExpr != nil && srcExpr.Kind == ast.EXPR_IDENT {
			var slot @Instr = lookupVar(ctx, srcExpr.Name)
			if slot != nil {
				return slot
			}
		}
		var tmp @Instr = b.EmitAlloc(srcTyp)
		b.EmitStore(tmp, recv)
		return tmp
	}

	// src is @T (managed pointer), dst is *T (raw pointer): both lower
	// to i8* in LLVM, so this is a reinterpret. Set the IR-level type
	// so downstream passes see the expected pointer kind.
	if srcTyp.Kind == types.TYP_MANAGED_PTR && dstTyp.Kind == types.TYP_POINTER {
		recv.Typ = dstTyp
		return recv
	}

	return recv
}

// recvShapeMatches reports whether two types have the same receiver
// shape — same kind (value/pointer/managed) on the same base named
// type. Used as the "no conversion needed" fast path.
func recvShapeMatches(a @types.Type, b @types.Type) bool {
	if a == nil || b == nil {
		return false
	}
	if a.Kind != b.Kind {
		return false
	}
	if isNamedTypeKind(a) {
		return charsEqualOpt(a.Name, b.Name)
	}
	if a.Kind == types.TYP_POINTER || a.Kind == types.TYP_MANAGED_PTR {
		if a.Elem == nil || b.Elem == nil {
			return false
		}
		return isNamedTypeKind(a.Elem) && isNamedTypeKind(b.Elem) &&
			charsEqualOpt(a.Elem.Name, b.Elem.Name)
	}
	return false
}

// charsEqualOpt is a byte-equality check that accepts empty as no-match
// (avoids matching two unnamed anonymous types).
func charsEqualOpt(a @[]char, b @[]char) bool {
	if len(a) == 0 || len(b) == 0 {
		return false
	}
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// baseNamedTypeName returns the name of the base named type, walking
// one level through *T / @T wrappers (matching the type checker's
// auto-deref rule). Note that IR-gen represents named structs as
// TYP_STRUCT with Name set, not TYP_NAMED — distinct from the type
// checker's representation. Returns empty string if the type isn't a
// named type (or a wrapper around one).
func baseNamedTypeName(t @types.Type) @[]char {
	if t == nil {
		return ""
	}
	if isNamedTypeKind(t) && len(t.Name) > 0 {
		return t.Name
	}
	if isUniversePrimitive(t) && len(t.Name) > 0 {
		return primitiveQualifiedName(t.Name)
	}
	if t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR {
		if t.Elem != nil && isNamedTypeKind(t.Elem) && len(t.Elem.Name) > 0 {
			return t.Elem.Name
		}
		if t.Elem != nil && isUniversePrimitive(t.Elem) &&
				len(t.Elem.Name) > 0 {
			return primitiveQualifiedName(t.Elem.Name)
		}
	}
	return ""
}

// isNamedTypeKind reports whether t.Kind is one that carries a name
// (TYP_NAMED for distinct named types, TYP_STRUCT for named structs in
// IR-gen).
func isNamedTypeKind(t @types.Type) bool {
	if t == nil {
		return false
	}
	return t.Kind == types.TYP_NAMED || t.Kind == types.TYP_STRUCT
}

// isUniversePrimitive reports whether t is a universe-scope
// primitive (int / float / bool family).  Used at call sites
// to recognize that the method's owning package is the
// stdlib carve-out (`pkg/std`) rather than a regular user
// package; mirrors the type-checker's predicate.
func isUniversePrimitive(t @types.Type) bool {
	if t == nil { return false }
	if t.Kind == types.TYP_INT { return true }
	if t.Kind == types.TYP_FLOAT { return true }
	if t.Kind == types.TYP_BOOL { return true }
	return false
}

// primitiveQualifiedName returns the call-site name of a
// primitive, qualified with the carve-out package's short
// prefix.  pkg/std owns the canonical impls for primitives
// (plan-primitives-impl-interfaces.md), so a method on `int`
// is mangled as `std.int.<Method>` everywhere — this is what
// the call-site qualifier produces for a method on a value of
// primitive type.
func primitiveQualifiedName(name @[]char) @[]char {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("std.")
	cb = cb.WriteStr(name)
	return cb.Bytes()
}

// buildMethodQualName constructs the IR-level qualified method name.
// If typeName is already qualified (contains a dot — e.g. "buf.CharBuf"
// for an imported type), use it as-is and just append the method name.
// Otherwise (local type, e.g. "Point"), prepend the current module's
// short package name.
func buildMethodQualName(pkgShort @[]char, typeName @[]char, methodName *[]const char) @[]char {
	var cb buf.CharBuf = buf.New()
	if typeNameIsQualified(typeName) {
		cb = cb.WriteStr(typeName)
	} else {
		cb = cb.WriteStr(pkgShort)
		cb = cb.WriteByte('.')
		cb = cb.WriteStr(typeName)
	}
	cb = cb.WriteByte('.')
	cb = cb.WriteStr(methodName)
	return cb.Bytes()
}

// typeNameIsQualified reports whether typeName contains a dot (i.e.,
// it's already qualified as "<pkg>.<Name>").
func typeNameIsQualified(typeName @[]char) bool {
	for i := 0; i < len(typeName); i++ {
		if typeName[i] == '.' {
			return true
		}
	}
	return false
}
