package "pkg/ir"

import "pkg/ast"
import "pkg/buf"
import "pkg/types"

// ============================================================
// Method IR generation (Stage 5 of plan-receivers.md)
// ============================================================

// methodQualName builds a method's IR-level fully-qualified name,
// "<pkgShort>.<TypeName>.<MethodName>". The mangler converts every "."
// to "__" downstream (Stage 4), yielding e.g. bn_geom__Point__M.
func methodQualName(pkgShort *[]const char, d @ast.Decl) @[]char {
	var typeName @[]char = recvTypeName(d.Recv.Type)
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, pkgShort)
	cb = buf.WriteByte(cb, '.')
	cb = buf.WriteStr(cb, typeName)
	cb = buf.WriteByte(cb, '.')
	cb = buf.WriteStr(cb, d.Name)
	return buf.Bytes(cb)
}

// recvTypeName walks a receiver TypeExpr to find the base named type's
// name. The type checker has already validated the shape (Stage 2), so
// we expect to find a TEXPR_NAMED at the bottom; an empty result means
// invalid input that slipped through.
func recvTypeName(te @ast.TypeExpr) @[]char {
	for te != nil {
		if te.Kind == ast.TEXPR_NAMED {
			return te.Name
		}
		if te.Kind == ast.TEXPR_POINTER ||
			te.Kind == ast.TEXPR_MANAGED ||
			te.Kind == ast.TEXPR_CONST ||
			te.Kind == ast.TEXPR_PAREN {
			te = te.Base
		} else {
			return ""
		}
	}
	return ""
}

// methodSig builds a FuncSig for a method declaration: name is the
// fully-qualified form, params have the receiver prepended at index 0.
func methodSig(pkgShort *[]const char, d @ast.Decl) FuncSig {
	var sig FuncSig
	sig.Name = methodQualName(pkgShort, d)
	var sigParams @[]@types.Type
	sigParams = appendTypePtr(sigParams, resolveTypeExpr(d.Recv.Type))
	for j := 0; j < len(d.Params); j++ {
		sigParams = appendTypePtr(sigParams, resolveTypeExpr(d.Params[j].Type))
	}
	sig.Params = sigParams
	var sigResults @[]@types.Type
	for j := 0; j < len(d.Results); j++ {
		sigResults = appendTypePtr(sigResults, resolveTypeExpr(d.Results[j]))
	}
	sig.Results = sigResults
	if len(sigResults) > 1 {
		sig.MultiReturnType = makeMultiReturnStructType(sigResults)
	}
	return sig
}

// genMethod lowers a method declaration to an IR Func. It synthesizes
// a free-function-shaped Decl with the receiver promoted to Params[0]
// and the qualified name, then defers to genFunc for body emission.
func genMethod(d @ast.Decl, pkgShort *[]const char) @Func {
	var nd @ast.Decl = make(ast.Decl)
	nd.Kind = ast.DECL_FUNC
	nd.Pos = d.Pos
	nd.Name = methodQualName(pkgShort, d)
	// Recv stays nil — the receiver lives in Params now.
	var prepended @[]@ast.ParamDecl = make_slice(@ast.ParamDecl, len(d.Params)+1)
	prepended[0] = d.Recv
	for i := 0; i < len(d.Params); i++ {
		prepended[i+1] = d.Params[i]
	}
	nd.Params = prepended
	nd.Results = d.Results
	nd.Body = d.Body
	return genFunc(nd)
}

// ============================================================
// Method call IR generation
// ============================================================

// isMethodCallSel reports whether a SELECTOR expression represents a
// method call (obj.M) rather than a package-qualified function call
// (pkg.Func). The disambiguation: if sel.X is an IDENT bound as a
// variable in scope, or any non-IDENT expression, it's a method call;
// if sel.X is an IDENT with no var binding, it's assumed to be a
// package alias.
func isMethodCallSel(ctx @GenContext, sel @ast.Expr) bool {
	if sel.X == nil {
		return false
	}
	if sel.X.Kind != ast.EXPR_IDENT {
		// Any non-ident receiver expression must evaluate to a value
		// (field access, function-call result, index, etc.) — that's
		// always a method call.
		return true
	}
	// IDENT receiver: a variable in scope means method call; otherwise
	// fall back to the existing pkg.Func path.
	return lookupVar(ctx, sel.X.Name) != nil
}

// genMethodCall generates IR for a method call obj.M(args). The
// receiver is evaluated and passed as Args[0]; user args follow.
// The method is looked up by qualified name (current pkg + receiver
// type's name + method name).
func genMethodCall(ctx @GenContext, b @Block, e @ast.Expr) @Instr {
	var sel @ast.Expr = e.X

	// Evaluate the receiver expression once.
	var recv @Instr = genExpr(ctx, b, sel.X)
	b = ctx.CurBlock

	// Determine the receiver's base named type — we look one level
	// through *T / @T to find the named type's name.
	var recvBaseTypeName @[]char = baseNamedTypeName(recv.Typ)

	// Build the fully-qualified method name. For intra-package methods
	// we always use the current module's short package name; cross-
	// package method calls (where the receiver type was imported) are
	// not yet supported in Stage 5.
	var qualName @[]char = buildMethodQualName(currentModulePkgShort,
		recvBaseTypeName, sel.Name)

	// Build args: receiver first, then user args.
	var paramTypes @[]@types.Type = lookupFuncParams(qualName)
	var args @[]@Instr
	args = appendInstrPtr(args, recv)
	for i := 0; i < len(e.Args); i++ {
		var arg @Instr = genExpr(ctx, b, e.Args[i])
		b = ctx.CurBlock
		// User args are at offset 1 in paramTypes (Params[0] is the
		// receiver), so coercions index from there.
		var pIdx int = i + 1
		if arg.Op == OP_CONST_STRING && pIdx < len(paramTypes) {
			var pt @types.Type = paramTypes[pIdx]
			if pt != nil && (pt.Kind == types.TYP_SLICE || pt.Kind == types.TYP_MANAGED_SLICE) {
				arg = EmitStringToChars(ctx.Func, b, arg, pt)
			}
		}
		if arg.Op == OP_CONST_NIL && pIdx < len(paramTypes) {
			var pt @types.Type = paramTypes[pIdx]
			if pt != nil && (pt.Kind == types.TYP_SLICE || pt.Kind == types.TYP_MANAGED_SLICE) {
				arg.Typ = pt
			}
		}
		if pIdx < len(paramTypes) {
			var pt @types.Type = paramTypes[pIdx]
			if pt != nil && pt.Kind == types.TYP_SLICE {
				if isManagedSliceType(arg.Typ) {
					arg = EmitManagedToRaw(ctx.Func, b, arg)
				}
			}
		}
		args = appendInstrPtr(args, arg)
	}

	// Determine the result type from the method's signature.
	var resultTyp @types.Type = types.TypInt()
	var results @[]@types.Type = lookupFuncResults(qualName)
	var funcFound bool = lookupFuncExists(qualName)
	if funcFound && len(results) == 0 {
		resultTyp = types.TypVoid()
	} else if len(results) == 1 {
		resultTyp = results[0]
	} else if len(results) > 1 {
		var mrt @types.Type = lookupFuncMultiReturnType(qualName)
		if mrt != nil {
			resultTyp = mrt
		} else {
			resultTyp = makeMultiReturnStructType(results)
		}
	}

	var result @Instr = EmitCall(ctx.Func, b, qualName, args, resultTyp)
	if isManagedPtrType(resultTyp) {
		registerTemp(ctx, result)
	}
	if isManagedSliceType(resultTyp) {
		registerTemp(ctx, result)
	}
	if needsStructCopy(resultTyp) {
		registerTemp(ctx, result)
	}
	return result
}

// baseNamedTypeName returns the name of the base named type, walking
// one level through *T / @T wrappers (matching the type checker's
// auto-deref rule). Note that IR-gen represents named structs as
// TYP_STRUCT with Name set, not TYP_NAMED — distinct from the type
// checker's representation. Returns empty string if the type isn't a
// named type (or a wrapper around one).
func baseNamedTypeName(t @types.Type) @[]char {
	if t == nil {
		return ""
	}
	if isNamedTypeKind(t) && len(t.Name) > 0 {
		return t.Name
	}
	if t.Kind == types.TYP_POINTER || t.Kind == types.TYP_MANAGED_PTR {
		if t.Elem != nil && isNamedTypeKind(t.Elem) && len(t.Elem.Name) > 0 {
			return t.Elem.Name
		}
	}
	return ""
}

// isNamedTypeKind reports whether t.Kind is one that carries a name
// (TYP_NAMED for distinct named types, TYP_STRUCT for named structs in
// IR-gen).
func isNamedTypeKind(t @types.Type) bool {
	if t == nil {
		return false
	}
	return t.Kind == types.TYP_NAMED || t.Kind == types.TYP_STRUCT
}

// buildMethodQualName constructs "<pkgShort>.<typeName>.<methodName>".
func buildMethodQualName(pkgShort @[]char, typeName @[]char, methodName *[]const char) @[]char {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, pkgShort)
	cb = buf.WriteByte(cb, '.')
	cb = buf.WriteStr(cb, typeName)
	cb = buf.WriteByte(cb, '.')
	cb = buf.WriteStr(cb, methodName)
	return buf.Bytes(cb)
}
