package "pkg/ir"

import "pkg/ast"
import "pkg/builtins/testing"
import "pkg/types"

// makeNamedTypeExpr is a tiny helper for building ast.TypeExpr in tests.
func makeNamedTypeExpr(name @[]char) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_NAMED
	te.Name = name
	return te
}

func makePointerTypeExpr(base @ast.TypeExpr) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_POINTER
	te.Base = base
	return te
}

func makeManagedTypeExpr(base @ast.TypeExpr) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_MANAGED
	te.Base = base
	return te
}

func makeConstTypeExpr(base @ast.TypeExpr) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_CONST
	te.Base = base
	return te
}

// charsEq compares two managed-char-slices for byte equality.
func charsEq(a @[]char, b *[]const char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

func TestRecvTypeNameValue() testing.TestResult {
	var te @ast.TypeExpr = makeNamedTypeExpr("Point")
	if !charsEq(recvTypeName(te), "Point") {
		return "expected 'Point' for value receiver"
	}
	return ""
}

func TestRecvTypeNamePointer() testing.TestResult {
	var te @ast.TypeExpr = makePointerTypeExpr(makeNamedTypeExpr("Point"))
	if !charsEq(recvTypeName(te), "Point") {
		return "expected 'Point' for *Point receiver"
	}
	return ""
}

func TestRecvTypeNameManaged() testing.TestResult {
	var te @ast.TypeExpr = makeManagedTypeExpr(makeNamedTypeExpr("Node"))
	if !charsEq(recvTypeName(te), "Node") {
		return "expected 'Node' for @Node receiver"
	}
	return ""
}

func TestRecvTypeNameConstPointer() testing.TestResult {
	// *const Point: TEXPR_POINTER → TEXPR_CONST → TEXPR_NAMED
	var te @ast.TypeExpr = makePointerTypeExpr(makeConstTypeExpr(makeNamedTypeExpr("Point")))
	if !charsEq(recvTypeName(te), "Point") {
		return "expected 'Point' for *const Point receiver"
	}
	return ""
}

func TestMethodQualNamePointer() testing.TestResult {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "Translate"
	var pd @ast.ParamDecl = make(ast.ParamDecl)
	pd.Name = "p"
	pd.Type = makePointerTypeExpr(makeNamedTypeExpr("Point"))
	d.Recv = pd
	if !charsEq(methodQualName("geom", d), "geom.Point.Translate") {
		return "expected 'geom.Point.Translate'"
	}
	return ""
}

func TestMethodQualNameValue() testing.TestResult {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "Get"
	var pd @ast.ParamDecl = make(ast.ParamDecl)
	pd.Name = "c"
	pd.Type = makeNamedTypeExpr("Counter")
	d.Recv = pd
	if !charsEq(methodQualName("util", d), "util.Counter.Get") {
		return "expected 'util.Counter.Get'"
	}
	return ""
}

func TestMethodQualNameManaged() testing.TestResult {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "Val"
	var pd @ast.ParamDecl = make(ast.ParamDecl)
	pd.Name = "n"
	pd.Type = makeManagedTypeExpr(makeNamedTypeExpr("Node"))
	d.Recv = pd
	if !charsEq(methodQualName("graph", d), "graph.Node.Val") {
		return "expected 'graph.Node.Val'"
	}
	return ""
}

func TestBuildMethodQualName() testing.TestResult {
	if !charsEq(buildMethodQualName("geom", "Point", "Translate"),
		"geom.Point.Translate") {
		return "expected 'geom.Point.Translate'"
	}
	return ""
}

// baseNamedTypeName must handle TYP_STRUCT (IR-gen's representation of
// named structs) as well as TYP_NAMED.
func TestBaseNamedTypeNameStruct() testing.TestResult {
	var emptyFields @[]@types.Field
	var t @types.Type = types.MakeStructType("Point", emptyFields)
	if !charsEq(baseNamedTypeName(t), "Point") {
		return "expected 'Point' for TYP_STRUCT receiver"
	}
	return ""
}

func TestBaseNamedTypeNameNamed() testing.TestResult {
	var t @types.Type = types.MakeNamedType("Celsius")
	if !charsEq(baseNamedTypeName(t), "Celsius") {
		return "expected 'Celsius' for TYP_NAMED receiver"
	}
	return ""
}

// One level of pointer / managed indirection — typical method-call
// receiver shape.
func TestBaseNamedTypeNamePointer() testing.TestResult {
	var emptyFieldsP @[]@types.Field
	var inner @types.Type = types.MakeStructType("Point", emptyFieldsP)
	var t @types.Type = types.MakePointerType(inner)
	if !charsEq(baseNamedTypeName(t), "Point") {
		return "expected 'Point' for *Point receiver"
	}
	return ""
}

func TestBaseNamedTypeNameManaged() testing.TestResult {
	var emptyFieldsM @[]@types.Field
	var inner @types.Type = types.MakeStructType("Node", emptyFieldsM)
	var t @types.Type = types.MakeManagedPtrType(inner)
	if !charsEq(baseNamedTypeName(t), "Node") {
		return "expected 'Node' for @Node receiver"
	}
	return ""
}

// Universe primitives ARE method-receiver bases (per the
// stdlib carve-out, plan-primitives-impl-interfaces.md), so
// baseNamedTypeName returns their qualified `pkg/std.<primitive>`
// form.  Other non-named kinds (slices, etc.) still yield
// empty.
func TestBaseNamedTypeNameNonNamed() testing.TestResult {
	var intName @[]char = baseNamedTypeName(types.TypInt())
	if !seq(intName, "pkg/std.int") {
		return "expected pkg/std.int qualifier for primitive int"
	}
	if len(baseNamedTypeName(types.MakeSliceType(types.TypInt()))) != 0 {
		return "expected empty for slice"
	}
	if len(baseNamedTypeName(nil)) != 0 {
		return "expected empty for nil"
	}
	return ""
}

// ============================================================
// recvShapeMatches and qualified-name detection
// ============================================================

// Two same-shape types — same kind, same name — match.
func TestRecvShapeMatchesIdentical() testing.TestResult {
	var emptyFs1 @[]@types.Field
	var a @types.Type = types.MakeStructType("Point", emptyFs1)
	var emptyFs2 @[]@types.Field
	var b @types.Type = types.MakeStructType("Point", emptyFs2)
	if !recvShapeMatches(a, b) {
		return "expected match for two TYP_STRUCT 'Point'"
	}
	return ""
}

// Pointer to the same named base — match.
func TestRecvShapeMatchesPointer() testing.TestResult {
	var emptyFs @[]@types.Field
	var inner1 @types.Type = types.MakeStructType("Point", emptyFs)
	var emptyFs2 @[]@types.Field
	var inner2 @types.Type = types.MakeStructType("Point", emptyFs2)
	var a @types.Type = types.MakePointerType(inner1)
	var b @types.Type = types.MakePointerType(inner2)
	if !recvShapeMatches(a, b) {
		return "expected match for two *Point"
	}
	return ""
}

// Different kinds (value vs pointer) on the same base — NOT a match;
// applyReceiverConversion will emit a load/take-address.
func TestRecvShapeMatchesDiffKind() testing.TestResult {
	var emptyFs @[]@types.Field
	var inner @types.Type = types.MakeStructType("Point", emptyFs)
	var a @types.Type = inner                       // T (value)
	var b @types.Type = types.MakePointerType(inner) // *T
	if recvShapeMatches(a, b) {
		return "expected no match for T vs *T"
	}
	return ""
}

// Same kind, different name — not a match (would be an error anyway,
// but the helper must be conservative).
func TestRecvShapeMatchesDiffName() testing.TestResult {
	var fs1 @[]@types.Field
	var fs2 @[]@types.Field
	var a @types.Type = types.MakeStructType("Point", fs1)
	var b @types.Type = types.MakeStructType("Counter", fs2)
	if recvShapeMatches(a, b) {
		return "expected no match for Point vs Counter"
	}
	return ""
}

// Empty names should not match each other (avoids matching anonymous
// types coincidentally).
func TestRecvShapeMatchesEmptyName() testing.TestResult {
	var fs @[]@types.Field
	var a @types.Type = types.MakeStructType("", fs)
	var b @types.Type = types.MakeStructType("", fs)
	if recvShapeMatches(a, b) {
		return "expected no match for two anonymous structs"
	}
	return ""
}

// typeNameIsQualified detects a dot in the name.
func TestTypeNameIsQualified() testing.TestResult {
	if !typeNameIsQualified("buf.CharBuf") {
		return "expected 'buf.CharBuf' to be qualified"
	}
	if typeNameIsQualified("CharBuf") {
		return "expected 'CharBuf' to be unqualified"
	}
	if typeNameIsQualified("") {
		return "expected '' to be unqualified"
	}
	return ""
}

// Unqualified type name — buildMethodQualName prepends pkgShort.
func TestBuildMethodQualNameLocal() testing.TestResult {
	if !charsEq(buildMethodQualName("main", "Point", "Translate"),
		"main.Point.Translate") {
		return "expected 'main.Point.Translate'"
	}
	return ""
}

// Already-qualified type name (imported) — buildMethodQualName uses it
// as-is and just appends the method name; the pkgShort arg is ignored.
func TestBuildMethodQualNameImported() testing.TestResult {
	if !charsEq(buildMethodQualName("main", "buf.CharBuf", "WriteByte"),
		"buf.CharBuf.WriteByte") {
		return "expected 'buf.CharBuf.WriteByte' (pkgShort ignored)"
	}
	return ""
}
