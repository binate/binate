package "pkg/ir"

import "pkg/ast"
import "pkg/builtin/testing"
import "pkg/types"

// makeNamedTypeExpr is a tiny helper for building ast.TypeExpr in tests.
func makeNamedTypeExpr(name @[]char) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_NAMED
	te.Name = name
	return te
}

func makePointerTypeExpr(base @ast.TypeExpr) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_POINTER
	te.Base = base
	return te
}

func makeManagedTypeExpr(base @ast.TypeExpr) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_MANAGED
	te.Base = base
	return te
}

func makeConstTypeExpr(base @ast.TypeExpr) @ast.TypeExpr {
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_CONST
	te.Base = base
	return te
}

// charsEq compares two managed-char-slices for byte equality.
func charsEq(a @[]char, b *[]const char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

func TestRecvTypeNameValue() testing.TestResult {
	var te @ast.TypeExpr = makeNamedTypeExpr("Point")
	if !charsEq(recvTypeName(te), "Point") {
		return "expected 'Point' for value receiver"
	}
	return ""
}

func TestRecvTypeNamePointer() testing.TestResult {
	var te @ast.TypeExpr = makePointerTypeExpr(makeNamedTypeExpr("Point"))
	if !charsEq(recvTypeName(te), "Point") {
		return "expected 'Point' for *Point receiver"
	}
	return ""
}

func TestRecvTypeNameManaged() testing.TestResult {
	var te @ast.TypeExpr = makeManagedTypeExpr(makeNamedTypeExpr("Node"))
	if !charsEq(recvTypeName(te), "Node") {
		return "expected 'Node' for @Node receiver"
	}
	return ""
}

func TestRecvTypeNameConstPointer() testing.TestResult {
	// *const Point: TEXPR_POINTER → TEXPR_CONST → TEXPR_NAMED
	var te @ast.TypeExpr = makePointerTypeExpr(makeConstTypeExpr(makeNamedTypeExpr("Point")))
	if !charsEq(recvTypeName(te), "Point") {
		return "expected 'Point' for *const Point receiver"
	}
	return ""
}

func TestMethodQualNamePointer() testing.TestResult {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "Translate"
	var pd @ast.ParamDecl = make(ast.ParamDecl)
	pd.Name = "p"
	pd.Type = makePointerTypeExpr(makeNamedTypeExpr("Point"))
	d.Recv = pd
	if !charsEq(methodQualName("geom", d), "geom.Point.Translate") {
		return "expected 'geom.Point.Translate'"
	}
	return ""
}

func TestMethodQualNameValue() testing.TestResult {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "Get"
	var pd @ast.ParamDecl = make(ast.ParamDecl)
	pd.Name = "c"
	pd.Type = makeNamedTypeExpr("Counter")
	d.Recv = pd
	if !charsEq(methodQualName("util", d), "util.Counter.Get") {
		return "expected 'util.Counter.Get'"
	}
	return ""
}

func TestMethodQualNameManaged() testing.TestResult {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = "Val"
	var pd @ast.ParamDecl = make(ast.ParamDecl)
	pd.Name = "n"
	pd.Type = makeManagedTypeExpr(makeNamedTypeExpr("Node"))
	d.Recv = pd
	if !charsEq(methodQualName("graph", d), "graph.Node.Val") {
		return "expected 'graph.Node.Val'"
	}
	return ""
}

func TestBuildMethodQualName() testing.TestResult {
	if !charsEq(buildMethodQualName("geom", "Point", "Translate"),
		"geom.Point.Translate") {
		return "expected 'geom.Point.Translate'"
	}
	return ""
}

// baseNamedTypeName must handle TYP_STRUCT (IR-gen's representation of
// named structs) as well as TYP_NAMED.
func TestBaseNamedTypeNameStruct() testing.TestResult {
	var emptyFields @[]@types.Field
	var t @types.Type = types.MakeStructType("Point", emptyFields)
	if !charsEq(baseNamedTypeName(t), "Point") {
		return "expected 'Point' for TYP_STRUCT receiver"
	}
	return ""
}

func TestBaseNamedTypeNameNamed() testing.TestResult {
	var t @types.Type = types.MakeNamedType("Celsius")
	if !charsEq(baseNamedTypeName(t), "Celsius") {
		return "expected 'Celsius' for TYP_NAMED receiver"
	}
	return ""
}

// One level of pointer / managed indirection — typical method-call
// receiver shape.
func TestBaseNamedTypeNamePointer() testing.TestResult {
	var emptyFieldsP @[]@types.Field
	var inner @types.Type = types.MakeStructType("Point", emptyFieldsP)
	var t @types.Type = types.MakePointerType(inner)
	if !charsEq(baseNamedTypeName(t), "Point") {
		return "expected 'Point' for *Point receiver"
	}
	return ""
}

func TestBaseNamedTypeNameManaged() testing.TestResult {
	var emptyFieldsM @[]@types.Field
	var inner @types.Type = types.MakeStructType("Node", emptyFieldsM)
	var t @types.Type = types.MakeManagedPtrType(inner)
	if !charsEq(baseNamedTypeName(t), "Node") {
		return "expected 'Node' for @Node receiver"
	}
	return ""
}

// Anything else (slice, primitive, etc.) is not a named-type receiver
// and should yield empty.
func TestBaseNamedTypeNameNonNamed() testing.TestResult {
	if len(baseNamedTypeName(types.TypInt())) != 0 {
		return "expected empty for primitive int"
	}
	if len(baseNamedTypeName(types.MakeSliceType(types.TypInt()))) != 0 {
		return "expected empty for slice"
	}
	if len(baseNamedTypeName(nil)) != 0 {
		return "expected empty for nil"
	}
	return ""
}
