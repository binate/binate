package "pkg/ir"

import "pkg/builtin/testing"
import "pkg/types"

// Tests for gen_method_value.bn (B.4 of plan-function-values-
// phase-2.md).  End-to-end behavior is covered by
// conformance/503_method_value; these pin the helper-level shape.

// isManagedReceiverType: managed pointer / slice → true; raw
// pointer / value types → false.
func TestIsManagedReceiverTypeManagedPtr() testing.TestResult {
	var s @types.Type =
		types.MakeStructType("T", make_slice(@types.Field, 0))
	var mt @types.Type = types.MakeManagedPtrType(s)
	if !isManagedReceiverType(mt) {
		return "expected @T to be CAP_MANAGED"
	}
	return ""
}

func TestIsManagedReceiverTypeManagedSlice() testing.TestResult {
	var mst @types.Type =
		types.MakeManagedSliceType(types.TypInt())
	if !isManagedReceiverType(mst) {
		return "expected @[]T to be CAP_MANAGED"
	}
	return ""
}

func TestIsManagedReceiverTypeRawPtr() testing.TestResult {
	var pt @types.Type =
		types.MakePointerType(types.TypInt())
	if isManagedReceiverType(pt) {
		return "expected *T not to be CAP_MANAGED"
	}
	return ""
}

func TestIsManagedReceiverTypeValue() testing.TestResult {
	if isManagedReceiverType(types.TypInt()) {
		return "expected int not to be CAP_MANAGED"
	}
	return ""
}

func TestIsManagedReceiverTypeNil() testing.TestResult {
	if isManagedReceiverType(nil) {
		return "expected nil not to be CAP_MANAGED"
	}
	return ""
}

// receiverShapeTag distinguishes value-receiver from pointer-
// receiver in the wrapper name so the same method backs distinct
// wrappers per shape.
func TestReceiverShapeTagPtr() testing.TestResult {
	var pt @types.Type =
		types.MakePointerType(types.TypInt())
	var tag @[]char = receiverShapeTag(pt)
	if len(tag) != 1 || tag[0] != 'p' {
		return "expected `p` for *T"
	}
	return ""
}

func TestReceiverShapeTagValue() testing.TestResult {
	var s @types.Type =
		types.MakeStructType("T", make_slice(@types.Field, 0))
	var tag @[]char = receiverShapeTag(s)
	if len(tag) != 1 || tag[0] != 'v' {
		return "expected `v` for T (value)"
	}
	return ""
}

func TestReceiverShapeTagNil() testing.TestResult {
	var tag @[]char = receiverShapeTag(nil)
	if len(tag) != 1 || tag[0] != 'v' {
		return "expected `v` for nil (default)"
	}
	return ""
}
